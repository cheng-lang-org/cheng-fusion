fn CompilerCsgRefreshMemoryLedger(csg: var CompilerCsg) =
    csg.nodesLiveBytes = CompilerCsgNodesLiveBytes(csg)
    csg.edgesLiveBytes = CompilerCsgEdgesLiveBytes(csg)
    csg.exprLayerLiveBytes = CompilerCsgExprLayerLiveBytes(csg.exprLayer)
    csg.typedFactsLiveBytes = Int64(0)
    csg.typedIrLiveBytes = CompilerCsgTypedIrCoreLiveBytes(csg.typedIr)
    csg.metadataLiveBytes = CompilerCsgTypedIrMetadataLiveBytes(csg.typedIr) +
                            Int64(csg.packageId.len) +
                            (CompilerCsgFixed32Bytes() * Int64(4)) +
                            CompilerCsgI32Bytes() +
                            Int64(sizeof(CompilerCsgFnPtrFieldCallTable)) +
                            compilerCsgFnPtrFieldCallDynamicSequenceBytes(
                                csg.fnPtrFieldCalls, false) +
                            Int64(sizeof(
                                CompilerCsgExternFfiHandleContractTable)) +
                            compilerCsgExternFfiHandleDynamicSequenceBytes(
                                csg.externFfiHandleContracts, false) +
                            Int64(sizeof(
                                CompilerCsgExternFfiHandleCallCapabilityTable)) +
                            compilerCsgExternFfiHandleCallCapabilityDynamicSequenceBytes(
                                csg.externFfiHandleCallCapabilities,
                                false) +
                            diagnostic_failure.DiagnosticFailureArtifactScalarBytes(
                                csg.diagnosticFailureArtifact) +
                            diagnostic_failure.DiagnosticFailureArtifactDynamicSequenceBytes(
                                csg.diagnosticFailureArtifact,
                                false) +
                            diagnostic_authority.ParserDiagnosticAuthorityScalarBytes(
                                csg.diagnosticFailureAuthority) +
                            diagnostic_authority.ParserDiagnosticAuthorityDynamicSequenceBytes(
                                csg.diagnosticFailureAuthority,
                                false) +
                            compilerCsgDiagnosticAuthorityProjectionBytes(
                                csg, false) +
                            CompilerCsgParserReceiptScalarLogicalBytes(
                                csg.parserNormalizedExprReceipt) +
                            CompilerCsgParserReceiptDynamicSequenceBytes(
                                csg.parserNormalizedExprReceipt,
                                false) +
                            CompilerCsgTypeDiagnosticScalarLogicalBytes(csg) +
                            CompilerCsgTypeDiagnosticDynamicSequenceBytes(
                                csg, false) +
                            CompilerCsgOwnershipDiagnosticScalarLogicalBytes(
                                csg) +
                            CompilerCsgOwnershipDiagnosticDynamicSequenceBytes(
                                csg, false) +
                            CompilerCsgLayoutDiagnosticScalarLogicalBytes(
                                csg) +
                            CompilerCsgLayoutDiagnosticDynamicSequenceBytes(
                                csg, false) +
                            CompilerCsgConcurrencyDiagnosticScalarLogicalBytes(
                                csg) +
                            CompilerCsgConcurrencyDiagnosticDynamicSequenceBytes(
                                csg, false)
    csg.sourceTextLiveBytes = Int64(0)
    # 固定标量常数 132 之外, 轮次文本 arena 报告新增 4*int32 + 1*int64 =
    # 24B; 同一改动锁步更新, 防止账本系统性低估 (lessons 2026-07-18)。
    csg.scalarLogicalPayloadBytes = Int64(csg.packageId.len) + Int64(132) +
                                    Int64(24) +
                                    CompilerCsgI32Bytes() +
                                    Int64(sizeof(
                                        CompilerCsgFnPtrFieldCallTable)) +
                                    Int64(sizeof(
                                        CompilerCsgExternFfiHandleContractTable)) +
                                    Int64(sizeof(
                                        CompilerCsgExternFfiHandleCallCapabilityTable)) +
                                    diagnostic_failure.DiagnosticFailureArtifactScalarBytes(
                                        csg.diagnosticFailureArtifact) +
                                    diagnostic_authority.ParserDiagnosticAuthorityScalarBytes(
                                        csg.diagnosticFailureAuthority) +
                                    Int64(CompilerCsgPortableSourceIdentityReceiptWireByteLength) +
                                    Int64(CompilerCsgTransitionReceiptWireByteLength) +
                                    CompilerCsgCompactProfileViewLifecycleScalarBytes() +
                                    Int64(csg.typedIrRoundBuildMsCsv.len) +
                                    Int64(csg.typedIrRoundNewReachableCountCsv.len) +
                                    Int64(csg.typedIrRoundBuildCountCsv.len) +
                                    Int64(csg.semanticGraph.builderName.len) +
                                    Int64(csg.semanticGraph.oracleMismatchReason.len) +
                                    Int64(csg.semanticGraph.exprSliceValidationReason.len) +
                                    CompilerCsgParserReceiptScalarLogicalBytes(
                                        csg.parserNormalizedExprReceipt) +
                                    CompilerCsgTypeDiagnosticScalarLogicalBytes(
                                        csg) +
                                    CompilerCsgOwnershipDiagnosticScalarLogicalBytes(
                                        csg) +
                                    CompilerCsgLayoutDiagnosticScalarLogicalBytes(
                                        csg) +
                                    CompilerCsgConcurrencyDiagnosticScalarLogicalBytes(
                                        csg)
    csg.scalarRetainedCapacityBytes = csg.scalarLogicalPayloadBytes

    csg.arenaLogicalPayloadBytes = Int64(csg.typedExprFacts.arena.usedBytes)
    csg.arenaRetainedCapacityBytes = Int64(csg.typedExprFacts.arena.capacityBytes)
    if csg.typedIr.arena.basePtr != csg.typedExprFacts.arena.basePtr:
        csg.arenaLogicalPayloadBytes = csg.arenaLogicalPayloadBytes +
                                       Int64(csg.typedIr.arena.usedBytes)
        csg.arenaRetainedCapacityBytes = csg.arenaRetainedCapacityBytes +
                                         Int64(csg.typedIr.arena.capacityBytes)
    if csg.typeArena != nil:
        csg.arenaLogicalPayloadBytes = csg.arenaLogicalPayloadBytes +
                                       Int64(csg.typeArena.arena.usedBytes)
        csg.arenaRetainedCapacityBytes = csg.arenaRetainedCapacityBytes +
                                         Int64(csg.typeArena.arena.capacityBytes)
    if csg.externFfiHandleCallCapabilities.arena.capacityBytes > 0:
        csg.arenaLogicalPayloadBytes = csg.arenaLogicalPayloadBytes +
            Int64(csg.externFfiHandleCallCapabilities.arena.usedBytes)
        csg.arenaRetainedCapacityBytes = csg.arenaRetainedCapacityBytes +
            Int64(csg.externFfiHandleCallCapabilities.arena.capacityBytes)

    csg.internLogicalPayloadBytes = CompilerCsgInternPoolBytesMode(csg.typedExprFacts.internPool,
                                                                   false)
    csg.internRetainedCapacityBytes = CompilerCsgInternPoolBytesMode(csg.typedExprFacts.internPool,
                                                                     true)
    if csg.typedIr.internPool != csg.typedExprFacts.internPool:
        csg.internLogicalPayloadBytes = csg.internLogicalPayloadBytes +
                                        CompilerCsgInternPoolBytesMode(csg.typedIr.internPool,
                                                                       false)
        csg.internRetainedCapacityBytes = csg.internRetainedCapacityBytes +
                                          CompilerCsgInternPoolBytesMode(csg.typedIr.internPool,
                                                                         true)
    if csg.typeArena != nil &&
       csg.typeArena.internPool != csg.typedExprFacts.internPool &&
       csg.typeArena.internPool != csg.typedIr.internPool:
        csg.internLogicalPayloadBytes = csg.internLogicalPayloadBytes +
                                        CompilerCsgInternPoolBytesMode(
                                            csg.typeArena.internPool, false)
        csg.internRetainedCapacityBytes =
            csg.internRetainedCapacityBytes +
                CompilerCsgInternPoolBytesMode(
                    csg.typeArena.internPool, true)
    let resolvedPool = csg.semanticGraph.resolvedCallTable.internPool
    if resolvedPool != csg.typedExprFacts.internPool &&
       resolvedPool != csg.typedIr.internPool:
        csg.internLogicalPayloadBytes = csg.internLogicalPayloadBytes +
                                        CompilerCsgInternPoolBytesMode(resolvedPool, false)
        csg.internRetainedCapacityBytes = csg.internRetainedCapacityBytes +
                                          CompilerCsgInternPoolBytesMode(resolvedPool, true)

    csg.dynamicSequenceLogicalPayloadBytes = CompilerCsgNodeSequenceBytes(csg, false) +
                                             CompilerCsgEdgeSequenceBytes(csg, false) +
                                             CompilerCsgExprLayerSequenceBytes(csg.exprLayer, false) +
                                             diagnostic_failure.DiagnosticFailureArtifactDynamicSequenceBytes(
                                                 csg.diagnosticFailureArtifact,
                                                 false) +
                                             diagnostic_authority.ParserDiagnosticAuthorityDynamicSequenceBytes(
                                                 csg.diagnosticFailureAuthority,
                                                 false) +
                                             compilerCsgDiagnosticAuthorityProjectionBytes(
                                                 csg, false) +
                                             CompilerCsgParserReceiptDynamicSequenceBytes(
                                                 csg.parserNormalizedExprReceipt,
                                                 false) +
                                             CompilerCsgTypeDiagnosticDynamicSequenceBytes(
                                                 csg, false) +
                                             CompilerCsgOwnershipDiagnosticDynamicSequenceBytes(
                                                 csg, false) +
                                             CompilerCsgLayoutDiagnosticDynamicSequenceBytes(
                                                 csg, false) +
                                             CompilerCsgConcurrencyDiagnosticDynamicSequenceBytes(
                                                 csg, false) +
                                             CompilerCsgTypedIrDynamicSequenceBytes(csg.typedIr, false) +
                                             compilerCsgFnPtrFieldCallDynamicSequenceBytes(
                                                 csg.fnPtrFieldCalls, false) +
                                             compilerCsgExternFfiHandleDynamicSequenceBytes(
                                                 csg.externFfiHandleContracts,
                                                 false) +
                                             compilerCsgExternFfiHandleCallCapabilityDynamicSequenceBytes(
                                                 csg.externFfiHandleCallCapabilities,
                                                 false) +
                                             CompilerCsgSemanticDynamicSequenceBytes(csg.semanticGraph, false)
    csg.dynamicSequenceRetainedCapacityBytes = CompilerCsgNodeSequenceBytes(csg, true) +
                                               CompilerCsgEdgeSequenceBytes(csg, true) +
                                               CompilerCsgExprLayerSequenceBytes(csg.exprLayer, true) +
                                               diagnostic_failure.DiagnosticFailureArtifactDynamicSequenceBytes(
                                                   csg.diagnosticFailureArtifact,
                                                   true) +
                                               diagnostic_authority.ParserDiagnosticAuthorityDynamicSequenceBytes(
                                                   csg.diagnosticFailureAuthority,
                                                   true) +
                                               compilerCsgDiagnosticAuthorityProjectionBytes(
                                                   csg, true) +
                                               CompilerCsgParserReceiptDynamicSequenceBytes(
                                                   csg.parserNormalizedExprReceipt,
                                                   true) +
                                               CompilerCsgTypeDiagnosticDynamicSequenceBytes(
                                                   csg, true) +
                                               CompilerCsgOwnershipDiagnosticDynamicSequenceBytes(
                                                   csg, true) +
                                               CompilerCsgLayoutDiagnosticDynamicSequenceBytes(
                                                   csg, true) +
                                               CompilerCsgConcurrencyDiagnosticDynamicSequenceBytes(
                                                   csg, true) +
                                               CompilerCsgTypedIrDynamicSequenceBytes(csg.typedIr, true) +
                                               compilerCsgFnPtrFieldCallDynamicSequenceBytes(
                                                   csg.fnPtrFieldCalls, true) +
                                               compilerCsgExternFfiHandleDynamicSequenceBytes(
                                                   csg.externFfiHandleContracts,
                                                   true) +
                                               compilerCsgExternFfiHandleCallCapabilityDynamicSequenceBytes(
                                                   csg.externFfiHandleCallCapabilities,
                                                   true) +
                                               CompilerCsgSemanticDynamicSequenceBytes(csg.semanticGraph, true)

    csg.buildIndexLogicalPayloadBytes =
        texpr.TypedExprIrBuildIndexLogicalLiveBytes(csg.typedIr)
    csg.buildIndexRetainedCapacityBytes =
        texpr.TypedExprIrBuildIndexStructuredLiveBytes(csg.typedIr)
    csg.logicalPayloadBytes = csg.scalarLogicalPayloadBytes +
                              csg.arenaLogicalPayloadBytes +
                              csg.internLogicalPayloadBytes +
                              csg.dynamicSequenceLogicalPayloadBytes +
                              csg.buildIndexLogicalPayloadBytes
    csg.retainedCapacityBytes = csg.scalarRetainedCapacityBytes +
                                csg.arenaRetainedCapacityBytes +
                                csg.internRetainedCapacityBytes +
                                csg.dynamicSequenceRetainedCapacityBytes +
                                csg.buildIndexRetainedCapacityBytes
    csg.semanticGraph.phaseLedger.compilerCsgLogicalPayloadBytes = csg.logicalPayloadBytes
    csg.semanticGraph.phaseLedger.compilerCsgRetainedCapacityBytes = csg.retainedCapacityBytes
    csg.semanticGraph.phaseLedger.memoryAccountingIsRss = false

fn CompilerCsgSemanticFinalize(semanticGraph: var CompilerCsgSemanticGraph,
                         csg: var CompilerCsg) =
    semanticGraph.worklist.roundCount = csg.typedIrRoundCount
    semanticGraph.worklist.processedSourceCount = csg.typedIrRebuildSourceCount
    semanticGraph.worklist.processedFunctionCount = csg.typedIrNewFunctionCount
    semanticGraph.worklist.sourceFrontierCount = 0
    semanticGraph.worklist.functionFrontierCount = 0
    semanticGraph.phaseLedger.sourceClosureStructuredBytes = csg.sourceTextCapturedBytes
    semanticGraph.phaseLedger.compilerCsgLogicalPayloadBytes =
        csg.logicalPayloadBytes
    semanticGraph.phaseLedger.exprSliceStructuredBytes = Int64(semanticGraph.exprSliceTable.exprCount.len) * Int64(36)
    semanticGraph.phaseLedger.typedFactStructuredBytes =
        CompilerCsgSemanticTypedFactDynamicSequenceBytes(semanticGraph.typedFactTable, false) +
                                              CompilerCsgSemanticResolvedCallStructuredLiveBytes(semanticGraph.resolvedCallTable)
    semanticGraph.phaseLedger.typedIrStructuredBytes =
        Int64(semanticGraph.typedIrTable.functionNames.len) * Int64(48)
    for functionIndex in 0..<semanticGraph.typedIrTable.functionNames.len:
        semanticGraph.phaseLedger.typedIrStructuredBytes =
            semanticGraph.phaseLedger.typedIrStructuredBytes +
                Int64(semanticGraph.typedIrTable.functionNames[functionIndex].len)
    semanticGraph.oracleCompared = true
    semanticGraph.oracleMatched = true
    semanticGraph.oracleMismatchReason = ""
    if semanticGraph.typedIrTable.functionNames.len != csg.typedIr.functions2_functionNameIds.len:
        semanticGraph.oracleMatched = false
        semanticGraph.oracleMismatchReason = "typed_ir_function_count"
    elif semanticGraph.typedFactTable.sourceIndexes.len != csg.typedExprFactCountSnapshot:
        semanticGraph.oracleMatched = false
        semanticGraph.oracleMismatchReason = "typed_fact_count"
    elif !semanticGraph.exprSliceTypedFactComplete:
        semanticGraph.oracleMatched = false
        semanticGraph.oracleMismatchReason = "expr_slice_typed_fact_incomplete"
    elif !semanticGraph.typedFactSemanticConservationProved:
        semanticGraph.oracleMatched = false
        semanticGraph.oracleMismatchReason = "typed_fact_semantic_conservation"
    elif semanticGraph.reachableFunctionTable.functionNames.len < csg.typedIr.functions2_functionNameIds.len:
        semanticGraph.oracleMatched = false
        semanticGraph.oracleMismatchReason = "reachable_function_count"

fn CompilerCsgBootstrapContractValidateFunction(csg: var CompilerCsg,
                                                typedFnIndex: int32,
                                                detailOut: var int32,
                                                reasonOut: var str): bool =
    return texpr.TypedExprBootstrapContractValidateFunction(csg.typedIr,
                                                           typedFnIndex,
                                                           detailOut,
                                                           reasonOut)

fn compilerReleaseStringArrayRetainedBufferCount(
        values: var str[]): int32 =
    if values.cap > 0:
        return 1
    return 0

fn compilerReleaseStringArrayRetainedBytes(
        values: var str[]): int64 =
    var retainedBytes =
        int64(values.cap) * int64(sizeof(str))
    for valueIndex in 0..<values.len:
        retainedBytes =
            retainedBytes + int64(values[valueIndex].len)
    return retainedBytes

fn compilerReleaseI32ArrayRetainedBufferCount(
        values: var int32[]): int32 =
    if values.cap > 0:
        return 1
    return 0

fn compilerReleaseI32ArrayRetainedBytes(
        values: var int32[]): int64 =
    return int64(values.cap) * int64(sizeof(int32))

fn CompilerExportSurfaceRetainedBufferCount(
        surface: var CsgExportSurface): int32 =
    return compilerReleaseStringArrayRetainedBufferCount(
               surface.exportedSymbols) +
           compilerReleaseStringArrayRetainedBufferCount(
               surface.exportedTargetNames) +
           compilerReleaseI32ArrayRetainedBufferCount(
               surface.exportedLayouts) +
           compilerReleaseI32ArrayRetainedBufferCount(
               surface.exportedEffects) +
           compilerReleaseI32ArrayRetainedBufferCount(
               surface.exportedCapabilities)

fn CompilerExportSurfaceRetainedBytes(
        surface: var CsgExportSurface): int64 =
    return int64(surface.packageId.len) +
           compilerReleaseStringArrayRetainedBytes(
               surface.exportedSymbols) +
           compilerReleaseStringArrayRetainedBytes(
               surface.exportedTargetNames) +
           compilerReleaseI32ArrayRetainedBytes(
               surface.exportedLayouts) +
           compilerReleaseI32ArrayRetainedBytes(
               surface.exportedEffects) +
           compilerReleaseI32ArrayRetainedBytes(
               surface.exportedCapabilities)

fn CompilerExportSurfaceStorageReleased(
        surface: var CsgExportSurface): bool =
    return surface.packageId == "" &&
           CompilerExportSurfaceRetainedBufferCount(surface) == 0

fn CompilerExportSurfaceReleaseOwned(
        surface: var CsgExportSurface) =
    surface.packageId = ""
    freeSeqStrRelease(surface.exportedSymbols)
    freeSeqStrRelease(surface.exportedTargetNames)
    chengSeqFreeTyped(surface.exportedLayouts)
    chengSeqFreeTyped(surface.exportedEffects)
    chengSeqFreeTyped(surface.exportedCapabilities)

fn CompileReceiptRetainedBufferCount(
        receipt: var CompileReceipt): int32 =
    return compilerReleaseStringArrayRetainedBufferCount(
        receipt.runtimeProviderSet)

fn CompileReceiptRetainedBytes(
        receipt: var CompileReceipt): int64 =
    return int64(receipt.targetTriple.len) +
           int64(receipt.bootstrapStage.len) +
           compilerReleaseStringArrayRetainedBytes(
               receipt.runtimeProviderSet)

fn CompileReceiptStorageReleased(
        receipt: var CompileReceipt): bool =
    return receipt.targetTriple == "" &&
           receipt.bootstrapStage == "" &&
           CompileReceiptRetainedBufferCount(receipt) == 0

fn CompileReceiptReleaseOwned(
        receipt: var CompileReceipt) =
    receipt.targetTriple = ""
    receipt.bootstrapStage = ""
    freeSeqStrRelease(receipt.runtimeProviderSet)

@borrows
fn CompilerExportSurfaceClone(surface: CsgExportSurface): CsgExportSurface =
    var out: CsgExportSurface
    out.packageId = parser.ParserOwnedText(surface.packageId)
    out.exportedSymbolCount = surface.exportedSymbolCount
    out.exportedSymbols = CompilerCsgCloneStrSeq(surface.exportedSymbols)
    out.exportedTargetNames = CompilerCsgCloneStrSeq(surface.exportedTargetNames)
    out.exportedLayouts = CompilerCsgCloneInt32Seq(surface.exportedLayouts)
    out.exportedEffects = CompilerCsgCloneInt32Seq(surface.exportedEffects)
    out.exportedCapabilities = CompilerCsgCloneInt32Seq(surface.exportedCapabilities)
    out.surfaceCid = surface.surfaceCid
    return out

@borrows
fn CompilerMigrationArtifactClone(
        artifact: CompilerMigrationArtifact): CompilerMigrationArtifact =
    var out: CompilerMigrationArtifact
    out.sourceIdentityReceipt = artifact.sourceIdentityReceipt
    out.canonicalCsgReport = CompilerCsgOwnText(artifact.canonicalCsgReport)
    out.canonicalGraphCid = artifact.canonicalGraphCid
    out.exportSurface = CompilerExportSurfaceClone(artifact.exportSurface)
    return out

@borrows
fn CompilerLegacyMigrationDeepCloneDiagnostic(migration: CompilerLegacyMigration): CompilerLegacyMigration =
    var out: CompilerLegacyMigration
    out.packageId = parser.ParserOwnedText(migration.packageId)
    out.entrySourcePath = parser.ParserOwnedText(migration.entrySourcePath)
    out.entryModulePath = parser.ParserOwnedText(migration.entryModulePath)
    out.unitCount = migration.unitCount
    out.units = CompilerLegacySourceUnitsClone(migration.units)
    out.appliedRuleCount = migration.appliedRuleCount
    out.appliedRules = CompilerCsgCloneStrSeq(migration.appliedRules)
    out.legacySourceBundleCid = migration.legacySourceBundleCid
    out.migratedSourceBundleCid = migration.migratedSourceBundleCid
    out.baselineArtifact = CompilerMigrationArtifactClone(
        migration.baselineArtifact)
    out.migratedArtifact = CompilerMigrationArtifactClone(
        migration.migratedArtifact)
    out.migrationCid = migration.migrationCid
    return out

# Diagnostic/test-only deep clone. The two migration smokes keep it as a
# clone-path control; the production migration path never clones, it uses
# BuildCompilerLegacyMigrationInto (out written directly, no Result temporary).
fn CompilerLegacyMigrationClone(migration: CompilerLegacyMigration): CompilerLegacyMigration =
    return CompilerLegacyMigrationDeepCloneDiagnostic(migration)

fn CompilerCsgAppendU32BE(buf: var layout.ByteBuf, value: int64) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn compilerCsgCheckedCapacityAdd(
        left: int32,
        right: int32,
        reason: str): int32 =
    if left < 0 || right < 0 || left > 2147483647 - right:
        panic(reason)
    return left + right

fn compilerCsgCheckedCapacityMul(
        left: int32,
        right: int32,
        reason: str): int32 =
    if left < 0 || right < 0 ||
       (right != 0 && left > 2147483647 / right):
        panic(reason)
    return left * right

@borrows
fn CompilerCsgAppendFixed32(buf: var layout.ByteBuf,
                            value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn CompilerCsgAppendText(buf: var layout.ByteBuf, text: str) =
    CompilerCsgAppendU32BE(buf, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, text[i])

fn CompilerCsgBufCid(buf: var layout.ByteBuf): layout.FixedBytes32 =
    let cid = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return cid

fn CompilerCsgOwnerResourceToken(
        csg: var CompilerCsg): layout.FixedBytes32 =
    if layout.FixedBytes32Equal(
           csg.sourceBundleCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           csg.sourceIdentityReceipt.receiptCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           csg.csgTransitionReceipt.receiptCid,
           layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(
           csg.canonicalGraphCid, layout.FixedBytes32()):
        panic("compiler csg: owner/resource identity incomplete")
    var buf = layout.ByteBufInit(192)
    CompilerCsgAppendText(
        buf,
        "cheng.compiler_csg.owner_resource_trace")
    CompilerCsgAppendFixed32(buf, csg.sourceBundleCid)
    CompilerCsgAppendFixed32(
        buf,
        csg.sourceIdentityReceipt.receiptCid)
    CompilerCsgAppendFixed32(
        buf,
        csg.csgTransitionReceipt.receiptCid)
    CompilerCsgAppendFixed32(buf, csg.canonicalGraphCid)
    return CompilerCsgBufCid(buf)

fn CompilerCsgOwnerResourceTracePointReadOnly(
        csg: var CompilerCsg,
        monotonicTimestampNs: int64,
        ownerToken: layout.FixedBytes32,
        allocCount: int64,
        allocatedBytes: int64,
        releaseCount: int64,
        releasedBytes: int64,
        released: bool,
        storageReleased: bool,
        out: var payloadlife.CompilerPayloadOwnerResourceTracePoint) =
    let retainedBytes =
        csg.arenaRetainedCapacityBytes +
        csg.internRetainedCapacityBytes +
        csg.dynamicSequenceRetainedCapacityBytes +
        csg.buildIndexRetainedCapacityBytes
    let physicalBufferCount =
        CompilerCsgLifecycleTrackedPhysicalBufferCount(csg)
    if allocatedBytes < releasedBytes ||
       retainedBytes != allocatedBytes - releasedBytes ||
       int64(physicalBufferCount) !=
           allocCount - releaseCount:
        panic("compiler csg: owner/resource counters diverged")
    var logicalBytes = csg.logicalPayloadBytes
    if released:
        if physicalBufferCount != 0 ||
           retainedBytes != int64(0) ||
           !storageReleased:
            panic("compiler csg: released owner/resource still retains storage")
        # Empty-shell scalar ledger (sizeof empty tables) is not live payload.
        # Terminal release already destroyed heap owners; the trace's released
        # point is live payload, not RefreshMemoryLedger's struct footprint.
        logicalBytes = int64(0)
    payloadlife.CompilerPayloadOwnerResourceTracePointInto(
        monotonicTimestampNs,
        ownerToken,
        logicalBytes,
        retainedBytes,
        physicalBufferCount,
        allocCount,
        allocatedBytes,
        releaseCount,
        releasedBytes,
        int64(physicalBufferCount),
        released,
        storageReleased,
        out)

@borrows
fn compilerCsgDiagnosticCompletionCid(
        domain: str,
        table: CompilerCsgTypeDiagnosticCompletionTable,
        row: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(192)
    CompilerCsgAppendText(buf, domain)
    CompilerCsgAppendU32BE(buf, table.sourceIds[row])
    CompilerCsgAppendFixed32(buf, table.sourceIdentityCids[row])
    CompilerCsgAppendFixed32(buf, table.inputArtifactCids[row])
    CompilerCsgAppendFixed32(buf, table.outputArtifactCids[row])
    CompilerCsgAppendU32BE(buf, table.rowStarts[row])
    CompilerCsgAppendU32BE(buf, table.rowCounts[row])
    let diagnosticStop =
        table.rowStarts[row] + table.rowCounts[row]
    for diagnosticRow in table.rowStarts[row]..<diagnosticStop:
        CompilerCsgAppendU32BE(
            buf, table.diagnosticSourceIds[diagnosticRow])
        CompilerCsgAppendU32BE(
            buf, table.diagnosticAnchorKinds[diagnosticRow])
        CompilerCsgAppendU32BE(
            buf, table.diagnosticAnchorNodeIds[diagnosticRow])
        CompilerCsgAppendU32BE(
            buf,
            table.diagnosticOwnerDeclarationSourceLocalRows[
                diagnosticRow])
        CompilerCsgAppendU32BE(
            buf, table.diagnosticSpanIds[diagnosticRow])
        CompilerCsgAppendU32BE(
            buf, table.diagnosticSeverities[diagnosticRow])
        CompilerCsgAppendText(
            buf, table.diagnosticCodeTexts[diagnosticRow])
        CompilerCsgAppendText(
            buf, table.diagnosticMessageTexts[diagnosticRow])
        CompilerCsgAppendFixed32(
            buf, table.diagnosticProofCids[diagnosticRow])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgDiagnosticTextValid(value: str): bool =
    if value == "":
        return false
    for index in 0..<value.len:
        let code = Int32(value[index])
        if code < 32 && value[index] != '\n' &&
           value[index] != '\r' && value[index] != '\t':
            return false
    return true

@borrows
fn compilerCsgDiagnosticRowsPayloadClone(
        source: CompilerCsgTypeDiagnosticCompletionTable): CompilerCsgTypeDiagnosticCompletionTable =
    var out: CompilerCsgTypeDiagnosticCompletionTable
    let diagnosticSourceIds =
        CompilerCsgCloneInt32Seq(source.diagnosticSourceIds)
    out.diagnosticSourceIds = diagnosticSourceIds
    let diagnosticAnchorKinds =
        CompilerCsgCloneInt32Seq(source.diagnosticAnchorKinds)
    out.diagnosticAnchorKinds = diagnosticAnchorKinds
    let diagnosticAnchorNodeIds =
        CompilerCsgCloneInt32Seq(source.diagnosticAnchorNodeIds)
    out.diagnosticAnchorNodeIds = diagnosticAnchorNodeIds
    let diagnosticOwnerDeclarationSourceLocalRows =
        CompilerCsgCloneInt32Seq(
            source.diagnosticOwnerDeclarationSourceLocalRows)
    out.diagnosticOwnerDeclarationSourceLocalRows =
        diagnosticOwnerDeclarationSourceLocalRows
    let diagnosticSpanIds =
        CompilerCsgCloneInt32Seq(source.diagnosticSpanIds)
    out.diagnosticSpanIds = diagnosticSpanIds
    let diagnosticSeverities =
        CompilerCsgCloneInt32Seq(source.diagnosticSeverities)
    out.diagnosticSeverities = diagnosticSeverities
    let diagnosticCodeTexts =
        CompilerCsgCloneStrSeq(source.diagnosticCodeTexts)
    out.diagnosticCodeTexts = diagnosticCodeTexts
    let diagnosticMessageTexts =
        CompilerCsgCloneStrSeq(source.diagnosticMessageTexts)
    out.diagnosticMessageTexts = diagnosticMessageTexts
    return out

fn CompilerCsgDiagnosticProducerRowAppendInto(
        table: var CompilerCsgTypeDiagnosticCompletionTable,
        sourceId: int32,
        anchorKind: int32,
        anchorNodeId: int32,
        ownerDeclarationSourceLocalRow: int32,
        spanId: int32,
        severity: int32,
        codeText: str,
        messageText: str,
        err: var str): bool =
    if table.sourceIds.len != 0 ||
       table.completionReceiptCids.len != 0 ||
       table.diagnosticProofCids.len != 0 ||
       sourceId < 0 || spanId < 0 ||
       anchorKind < CompilerCsgDiagnosticAnchorSpan ||
       anchorKind >
           CompilerCsgDiagnosticAnchorParserNodeOwnerDeclaration ||
       severity < CompilerCsgDiagnosticSeverityError ||
       severity > CompilerCsgDiagnosticSeverityHint ||
       !compilerCsgDiagnosticTextValid(codeText) ||
       !compilerCsgDiagnosticTextValid(messageText) ||
       (table.diagnosticSourceIds.len > 0 &&
        (sourceId <
             table.diagnosticSourceIds[
                 table.diagnosticSourceIds.len - 1] ||
         (sourceId ==
              table.diagnosticSourceIds[
                  table.diagnosticSourceIds.len - 1] &&
          spanId <=
              table.diagnosticSpanIds[
                  table.diagnosticSpanIds.len - 1]))):
        err = " compiler csg: diagnostic producer append invalid"
        return false
    add(table.diagnosticSourceIds, sourceId)
    add(table.diagnosticAnchorKinds, anchorKind)
    add(table.diagnosticAnchorNodeIds, anchorNodeId)
    add(table.diagnosticOwnerDeclarationSourceLocalRows,
        ownerDeclarationSourceLocalRow)
    add(table.diagnosticSpanIds, spanId)
    add(table.diagnosticSeverities, severity)
    add(table.diagnosticCodeTexts, codeText)
    add(table.diagnosticMessageTexts, messageText)
    err = ""
    return true

@borrows
fn compilerCsgDiagnosticRowsPayloadStrictValidateInto(
        table: CompilerCsgTypeDiagnosticCompletionTable,
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        err: var str): bool =
    let rowCount = table.diagnosticSourceIds.len
    if rowCount != table.diagnosticAnchorKinds.len ||
       rowCount != table.diagnosticAnchorNodeIds.len ||
       rowCount !=
           table.diagnosticOwnerDeclarationSourceLocalRows.len ||
       rowCount != table.diagnosticSpanIds.len ||
       rowCount != table.diagnosticSeverities.len ||
       rowCount != table.diagnosticCodeTexts.len ||
       rowCount != table.diagnosticMessageTexts.len:
        err = " compiler csg: diagnostic producer row columns split"
        return false
    for row in 0..<rowCount:
        let source = table.diagnosticSourceIds[row]
        if source < 0 || source >= parserReceipt.sourceSidecars.len:
            err = " compiler csg: diagnostic producer source invalid"
            return false
        let sidecar = parserReceipt.sourceSidecars[source]
        let anchorKind = table.diagnosticAnchorKinds[row]
        let anchorNode = table.diagnosticAnchorNodeIds[row]
        let owner =
            table.diagnosticOwnerDeclarationSourceLocalRows[row]
        let span = table.diagnosticSpanIds[row]
        let needsParser =
            anchorKind == CompilerCsgDiagnosticAnchorParserNode ||
            anchorKind ==
                CompilerCsgDiagnosticAnchorParserNodeOwnerDeclaration
        let needsOwner =
            anchorKind ==
                CompilerCsgDiagnosticAnchorOwnerDeclaration ||
            anchorKind ==
                CompilerCsgDiagnosticAnchorParserNodeOwnerDeclaration
        if anchorKind < CompilerCsgDiagnosticAnchorSpan ||
           anchorKind >
               CompilerCsgDiagnosticAnchorParserNodeOwnerDeclaration ||
           span < 0 || span >= sidecar.spanStartBytes.len ||
           (needsParser &&
            (anchorNode < 0 || anchorNode >= sidecar.nodeKinds.len ||
             sidecar.nodeSpanIds[anchorNode] != span)) ||
           (!needsParser && anchorNode != -1) ||
           (needsOwner &&
            (owner < 0 || owner >= sidecar.declarationKinds.len ||
             sidecar.declarationSourceLocalRows[owner] != owner ||
             sidecar.spanStartBytes[span] <
                 sidecar.spanStartBytes[
                     sidecar.declarationSpanIds[owner]] ||
             sidecar.spanEndBytes[span] >
                 sidecar.spanEndBytes[
                     sidecar.declarationSpanIds[owner]])) ||
           (!needsOwner && owner != -1) ||
           table.diagnosticSeverities[row] <
               CompilerCsgDiagnosticSeverityError ||
           table.diagnosticSeverities[row] >
               CompilerCsgDiagnosticSeverityHint ||
           !compilerCsgDiagnosticTextValid(
               table.diagnosticCodeTexts[row]) ||
           !compilerCsgDiagnosticTextValid(
               table.diagnosticMessageTexts[row]) ||
           (row > 0 &&
            (source < table.diagnosticSourceIds[row - 1] ||
             (source == table.diagnosticSourceIds[row - 1] &&
              span <= table.diagnosticSpanIds[row - 1]))):
            err = " compiler csg: diagnostic producer row invalid"
            return false
    err = ""
    return true

@borrows
fn compilerCsgDiagnosticRowProofCid(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        producerIdentity: str,
        table: CompilerCsgTypeDiagnosticCompletionTable,
        completionRow: int32,
        diagnosticRow: int32): layout.FixedBytes32 =
    let source = table.diagnosticSourceIds[diagnosticRow]
    let sidecar = parserReceipt.sourceSidecars[source]
    let span = table.diagnosticSpanIds[diagnosticRow]
    let anchorNode = table.diagnosticAnchorNodeIds[diagnosticRow]
    let owner =
        table.diagnosticOwnerDeclarationSourceLocalRows[diagnosticRow]
    let diagnosticCodeCapacity = compilerCsgCheckedCapacityAdd(
        320,
        table.diagnosticCodeTexts[diagnosticRow].len,
        "compiler csg: diagnostic row proof capacity overflow")
    let diagnosticCapacity = compilerCsgCheckedCapacityAdd(
        diagnosticCodeCapacity,
        table.diagnosticMessageTexts[diagnosticRow].len,
        "compiler csg: diagnostic row proof capacity overflow")
    var buf = layout.ByteBufInit(diagnosticCapacity)
    CompilerCsgAppendText(buf, CompilerCsgDiagnosticRowProofDomain)
    CompilerCsgAppendText(buf, producerIdentity)
    CompilerCsgAppendU32BE(buf, source)
    CompilerCsgAppendFixed32(buf, table.sourceIdentityCids[completionRow])
    CompilerCsgAppendFixed32(buf, table.inputArtifactCids[completionRow])
    CompilerCsgAppendFixed32(buf, table.outputArtifactCids[completionRow])
    CompilerCsgAppendU32BE(
        buf, table.diagnosticAnchorKinds[diagnosticRow])
    CompilerCsgAppendU32BE(buf, anchorNode)
    if anchorNode >= 0:
        CompilerCsgAppendU32BE(buf, sidecar.nodeProducerIds[anchorNode])
    CompilerCsgAppendU32BE(buf, owner)
    if owner >= 0:
        CompilerCsgAppendU32BE(buf, sidecar.declarationKinds[owner])
    CompilerCsgAppendU32BE(buf, span)
    CompilerCsgAppendU32BE(buf, sidecar.spanStartBytes[span])
    CompilerCsgAppendU32BE(buf, sidecar.spanEndBytes[span])
    CompilerCsgAppendU32BE(
        buf, table.diagnosticSeverities[diagnosticRow])
    CompilerCsgAppendText(buf, table.diagnosticCodeTexts[diagnosticRow])
    CompilerCsgAppendText(buf, table.diagnosticMessageTexts[diagnosticRow])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgDiagnosticRowProofRangeAppendInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        producerIdentity: str,
        table: var CompilerCsgTypeDiagnosticCompletionTable,
        completionRow: int32,
        err: var str): bool =
    let rowStart = table.rowStarts[completionRow]
    let rowCount = table.rowCounts[completionRow]
    if table.diagnosticProofCids.len != rowStart:
        err = " compiler csg: diagnostic proof CSR append split"
        return false
    for row in rowStart..<(rowStart + rowCount):
        add(table.diagnosticProofCids,
            compilerCsgDiagnosticRowProofCid(
                parserReceipt, producerIdentity,
                table, completionRow, row))
    err = ""
    return true

fn compilerCsgDiagnosticRowsStrictValidateInto(
        table: CompilerCsgTypeDiagnosticCompletionTable,
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        producerIdentity: str,
        err: var str): bool =
    if !compilerCsgDiagnosticRowsPayloadStrictValidateInto(
           table, parserReceipt, err) ||
       table.diagnosticProofCids.len !=
           table.diagnosticSourceIds.len:
        if err == "":
            err = " compiler csg: diagnostic proof columns split"
        return false
    for completionRow in 0..<table.sourceIds.len:
        let rowStart = table.rowStarts[completionRow]
        let rowCount = table.rowCounts[completionRow]
        for row in rowStart..<(rowStart + rowCount):
            if !layout.FixedBytes32Equal(
                   compilerCsgDiagnosticRowProofCid(
                       parserReceipt, producerIdentity,
                       table, completionRow, row),
                   table.diagnosticProofCids[row]):
                err = " compiler csg: diagnostic row proof mismatch"
                return false
    err = ""
    return true

@borrows
fn compilerCsgDiagnosticSourceRangeInto(
        table: var CompilerCsgTypeDiagnosticCompletionTable,
        sourceId: int32,
        cursor: var int32,
        rowStart: var int32,
        rowCount: var int32,
        err: var str): bool =
    if cursor < 0 || cursor > table.diagnosticSourceIds.len:
        err = " compiler csg: diagnostic producer cursor invalid"
        return false
    rowStart = cursor
    while cursor < table.diagnosticSourceIds.len &&
          table.diagnosticSourceIds[cursor] == sourceId:
        cursor = cursor + 1
    rowCount = cursor - rowStart
    if cursor < table.diagnosticSourceIds.len &&
       table.diagnosticSourceIds[cursor] < sourceId:
        err = " compiler csg: diagnostic producer source order invalid"
        return false
    err = ""
    return true

@borrows
fn compilerCsgSourceRowsStrictValidateInto(
        sourceIds: int32[],
        sourceCount: int32,
        rowStarts: var int32[],
        rowCounts: var int32[],
        rowIds: var int32[],
        err: var str): bool =
    if sourceCount < 0 ||
       rowStarts.len != sourceCount ||
       rowCounts.len != sourceCount ||
       rowIds.len != sourceIds.len:
        err = " compiler csg: source CSR columns split"
        return false
    var seenRows: bool[]
    setLen(seenRows, sourceIds.len)
    var cursor: int32
    for sourceId in 0..<sourceCount:
        let count = rowCounts[sourceId]
        if rowStarts[sourceId] != cursor ||
           count < 0 ||
           count > rowIds.len - cursor:
            err = " compiler csg: source CSR range invalid"
            return false
        let stop = cursor + count
        var previousRow: int32 = -1
        while cursor < stop:
            let rowId = rowIds[cursor]
            if rowId < 0 || rowId >= sourceIds.len ||
               seenRows[rowId] ||
               rowId <= previousRow ||
               sourceIds[rowId] != sourceId:
                err = " compiler csg: source CSR row invalid"
                return false
            seenRows[rowId] = true
            previousRow = rowId
            cursor = cursor + 1
    if cursor != sourceIds.len:
        err = " compiler csg: source CSR coverage incomplete"
        return false
    err = ""
    return true

@borrows
fn compilerCsgSourceRowsBuildInto(
        sourceIds: int32[],
        sourceCount: int32,
        rowStarts: var int32[],
        rowCounts: var int32[],
        rowIds: var int32[],
        err: var str): bool =
    if sourceCount < 0 ||
       rowStarts.len != 0 ||
       rowCounts.len != 0 ||
       rowIds.len != 0:
        err = " compiler csg: source CSR destination invalid"
        return false
    setLen(rowStarts, sourceCount)
    setLen(rowCounts, sourceCount)
    setLen(rowIds, sourceIds.len)
    for rowId in 0..<sourceIds.len:
        let sourceId = sourceIds[rowId]
        if sourceId < 0 || sourceId >= sourceCount ||
           rowCounts[sourceId] == 2147483647:
            err = " compiler csg: source CSR source invalid"
            return false
        rowCounts[sourceId] = rowCounts[sourceId] + 1
    for sourceId in 1..<sourceCount:
        if rowStarts[sourceId - 1] >
               2147483647 - rowCounts[sourceId - 1]:
            err = " compiler csg: source CSR range overflow"
            return false
        rowStarts[sourceId] =
            rowStarts[sourceId - 1] +
            rowCounts[sourceId - 1]
    var cursors: int32[]
    setLen(cursors, sourceCount)
    for sourceId in 0..<sourceCount:
        cursors[sourceId] = rowStarts[sourceId]
    for rowId in 0..<sourceIds.len:
        let sourceId = sourceIds[rowId]
        rowIds[cursors[sourceId]] = rowId
        cursors[sourceId] = cursors[sourceId] + 1
    return compilerCsgSourceRowsStrictValidateInto(
        sourceIds,
        sourceCount,
        rowStarts,
        rowCounts,
        rowIds,
        err)

@borrows
fn compilerCsgInt32SequenceEqual(left: int32[], right: int32[]): bool =
    if left.len != right.len:
        return false
    for row in 0..<left.len:
        if left[row] != right[row]:
            return false
    return true

@borrows
fn compilerCsgDiagnosticCompletionTableEqual(
        left: CompilerCsgTypeDiagnosticCompletionTable,
        right: CompilerCsgTypeDiagnosticCompletionTable): bool =
    let rowCount = left.sourceIds.len
    if rowCount != right.sourceIds.len ||
       left.sourceIdentityCids.len != rowCount ||
       right.sourceIdentityCids.len != rowCount ||
       left.inputArtifactCids.len != rowCount ||
       right.inputArtifactCids.len != rowCount ||
       left.outputArtifactCids.len != rowCount ||
       right.outputArtifactCids.len != rowCount ||
       left.rowStarts.len != rowCount ||
       right.rowStarts.len != rowCount ||
       left.rowCounts.len != rowCount ||
       right.rowCounts.len != rowCount ||
       left.completionReceiptCids.len != rowCount ||
       right.completionReceiptCids.len != rowCount ||
       left.diagnosticSourceIds.len !=
           right.diagnosticSourceIds.len ||
       left.diagnosticAnchorKinds.len !=
           left.diagnosticSourceIds.len ||
       right.diagnosticAnchorKinds.len !=
           right.diagnosticSourceIds.len ||
       left.diagnosticAnchorNodeIds.len !=
           left.diagnosticSourceIds.len ||
       right.diagnosticAnchorNodeIds.len !=
           right.diagnosticSourceIds.len ||
       left.diagnosticOwnerDeclarationSourceLocalRows.len !=
           left.diagnosticSourceIds.len ||
       right.diagnosticOwnerDeclarationSourceLocalRows.len !=
           right.diagnosticSourceIds.len ||
       left.diagnosticSpanIds.len !=
           left.diagnosticSourceIds.len ||
       right.diagnosticSpanIds.len !=
           right.diagnosticSourceIds.len ||
       left.diagnosticSeverities.len !=
           left.diagnosticSourceIds.len ||
       right.diagnosticSeverities.len !=
           right.diagnosticSourceIds.len ||
       left.diagnosticCodeTexts.len !=
           left.diagnosticSourceIds.len ||
       right.diagnosticCodeTexts.len !=
           right.diagnosticSourceIds.len ||
       left.diagnosticMessageTexts.len !=
           left.diagnosticSourceIds.len ||
       right.diagnosticMessageTexts.len !=
           right.diagnosticSourceIds.len ||
       left.diagnosticProofCids.len !=
           left.diagnosticSourceIds.len ||
       right.diagnosticProofCids.len !=
           right.diagnosticSourceIds.len ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutSourceIds,
           right.exactLayoutSourceIds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutProducerRowIds,
           right.exactLayoutProducerRowIds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutDeclarationSourceLocalRows,
           right.exactLayoutDeclarationSourceLocalRows) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutBuiltinKinds,
           right.exactLayoutBuiltinKinds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutTypeArenaIds,
           right.exactLayoutTypeArenaIds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutSizeBytes,
           right.exactLayoutSizeBytes) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutAlignBytes,
           right.exactLayoutAlignBytes) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldCounts,
           right.exactLayoutFieldCounts) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutSourceRowStarts,
           right.exactLayoutSourceRowStarts) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutSourceRowCounts,
           right.exactLayoutSourceRowCounts) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutSourceRowIndexes,
           right.exactLayoutSourceRowIndexes) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldSourceIds,
           right.exactLayoutFieldSourceIds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldProducerRowIds,
           right.exactLayoutFieldProducerRowIds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldOwnerDeclarationSourceLocalRows,
           right.exactLayoutFieldOwnerDeclarationSourceLocalRows) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldDeclarationSourceLocalRows,
           right.exactLayoutFieldDeclarationSourceLocalRows) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldBuiltinKinds,
           right.exactLayoutFieldBuiltinKinds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldMemberRows,
           right.exactLayoutFieldMemberRows) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldOwnerTypeArenaIds,
           right.exactLayoutFieldOwnerTypeArenaIds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldOrdinals,
           right.exactLayoutFieldOrdinals) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldTypeArenaIds,
           right.exactLayoutFieldTypeArenaIds) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldOffsetBytes,
           right.exactLayoutFieldOffsetBytes) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldSizeBytes,
           right.exactLayoutFieldSizeBytes) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldAlignBytes,
           right.exactLayoutFieldAlignBytes) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldSourceRowStarts,
           right.exactLayoutFieldSourceRowStarts) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldSourceRowCounts,
           right.exactLayoutFieldSourceRowCounts) ||
       !compilerCsgInt32SequenceEqual(
           left.exactLayoutFieldSourceRowIndexes,
           right.exactLayoutFieldSourceRowIndexes):
        return false
    for row in 0..<rowCount:
        if left.sourceIds[row] != right.sourceIds[row] ||
           left.rowStarts[row] != right.rowStarts[row] ||
           left.rowCounts[row] != right.rowCounts[row] ||
           !layout.FixedBytes32Equal(
               left.sourceIdentityCids[row],
               right.sourceIdentityCids[row]) ||
           !layout.FixedBytes32Equal(
               left.inputArtifactCids[row],
               right.inputArtifactCids[row]) ||
           !layout.FixedBytes32Equal(
               left.outputArtifactCids[row],
               right.outputArtifactCids[row]) ||
           !layout.FixedBytes32Equal(
               left.completionReceiptCids[row],
               right.completionReceiptCids[row]):
            return false
    for row in 0..<left.diagnosticSourceIds.len:
        if left.diagnosticSourceIds[row] !=
               right.diagnosticSourceIds[row] ||
           left.diagnosticAnchorKinds[row] !=
               right.diagnosticAnchorKinds[row] ||
           left.diagnosticAnchorNodeIds[row] !=
               right.diagnosticAnchorNodeIds[row] ||
           left.diagnosticOwnerDeclarationSourceLocalRows[row] !=
               right.diagnosticOwnerDeclarationSourceLocalRows[row] ||
           left.diagnosticSpanIds[row] !=
               right.diagnosticSpanIds[row] ||
           left.diagnosticSeverities[row] !=
               right.diagnosticSeverities[row] ||
           left.diagnosticCodeTexts[row] !=
               right.diagnosticCodeTexts[row] ||
           left.diagnosticMessageTexts[row] !=
               right.diagnosticMessageTexts[row] ||
           !layout.FixedBytes32Equal(
               left.diagnosticProofCids[row],
               right.diagnosticProofCids[row]):
            return false
    return true

@borrows
fn compilerCsgTypeDiagnosticCompletionCid(
        table: CompilerCsgTypeDiagnosticCompletionTable,
        row: int32): layout.FixedBytes32 =
    return compilerCsgDiagnosticCompletionCid(
        CompilerCsgTypeDiagnosticCompletionDomain, table, row)

@borrows
fn compilerCsgTypeAuthorityCidForSource(
        sourceId: int32,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        typeArena: typearena.TypedExprTypeArena,
        typeSyntaxRowStarts: int32[],
        typeSyntaxRowCounts: int32[],
        typeSyntaxRowIds: int32[],
        err: var str): layout.FixedBytes32 =
    if sourceId < 0 ||
       sourceId >= typeSyntaxRowStarts.len ||
       sourceId >= typeSyntaxRowCounts.len:
        err = " compiler csg: type diagnostic source CSR missing"
        return layout.FixedBytes32()
    let sourceTypeSyntaxCount =
        typeSyntaxRowCounts[sourceId]
    if sourceTypeSyntaxCount != sidecar.typeSyntaxKinds.len:
        err = " compiler csg: type diagnostic TypeSyntax source partition mismatch"
        return layout.FixedBytes32()
    let sourceTypeSyntaxBytes = compilerCsgCheckedCapacityMul(
        sourceTypeSyntaxCount,
        40,
        "compiler csg: type authority capacity overflow")
    let typeAuthorityCapacity = compilerCsgCheckedCapacityAdd(
        192,
        sourceTypeSyntaxBytes,
        "compiler csg: type authority capacity overflow")
    var buf = layout.ByteBufInit(typeAuthorityCapacity)
    CompilerCsgAppendText(
        buf, CompilerCsgTypeDiagnosticArtifactDomain)
    CompilerCsgAppendFixed32(buf, typeArena.artifactRaw32)
    CompilerCsgAppendU32BE(buf, sourceId)
    CompilerCsgAppendU32BE(buf, sourceTypeSyntaxCount)
    let sourceStart = typeSyntaxRowStarts[sourceId]
    for sourceLocalTypeSyntaxId in 0..<sourceTypeSyntaxCount:
        let typeSyntaxId =
            typeSyntaxRowIds[
                sourceStart + sourceLocalTypeSyntaxId]
        let typeId =
            typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                typeArena, typeSyntaxId)
        if sourceLocalTypeSyntaxId < 0 ||
           sourceLocalTypeSyntaxId >= sidecar.typeSyntaxKinds.len ||
           arenamod.ArenaArrayInt32Get(
               typeArena.arena,
               typeArena.typeSyntaxSourceLocalRows,
               typeSyntaxId) != sourceLocalTypeSyntaxId ||
           sidecar.typeSyntaxKinds[sourceLocalTypeSyntaxId] !=
               arenamod.ArenaArrayInt32Get(
                   typeArena.arena,
                   typeArena.typeSyntaxParserKinds,
                   typeSyntaxId) ||
           typeId < 0 || typeId >= typeArena.typeCount:
            layout.ByteBufFree(buf)
            err = " compiler csg: type diagnostic exact TypeArena row missing"
            return layout.FixedBytes32()
        CompilerCsgAppendU32BE(buf, sourceId)
        CompilerCsgAppendU32BE(buf, sourceLocalTypeSyntaxId)
        CompilerCsgAppendU32BE(buf, typeSyntaxId)
        CompilerCsgAppendU32BE(buf, typeId)
        CompilerCsgAppendU32BE(
            buf,
            Int32(typearena.TypedExprTypeArenaKindAt(
                typeArena, typeId)))
        CompilerCsgAppendU32BE(
            buf,
            typearena.TypedExprTypeArenaManagedAt(
                typeArena, typeId) ? 1 : 0)
        CompilerCsgAppendU32BE(
            buf,
            typearena.TypedExprTypeArenaSendAt(
                typeArena, typeId) ? 1 : 0)
        CompilerCsgAppendU32BE(
            buf,
            typearena.TypedExprTypeArenaSyncAt(
                typeArena, typeId) ? 1 : 0)
    err = ""
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgTypeDiagnosticArtifactCid(
        typeArenaArtifactCid: layout.FixedBytes32,
        table: CompilerCsgTypeDiagnosticCompletionTable): layout.FixedBytes32 =
    let sourceBytes = compilerCsgCheckedCapacityMul(
        table.sourceIds.len,
        192,
        "compiler csg: type diagnostic artifact capacity overflow")
    let capacity = compilerCsgCheckedCapacityAdd(
        128,
        sourceBytes,
        "compiler csg: type diagnostic artifact capacity overflow")
    var buf = layout.ByteBufInit(capacity)
    CompilerCsgAppendText(
        buf, CompilerCsgTypeDiagnosticArtifactDomain)
    CompilerCsgAppendFixed32(buf, typeArenaArtifactCid)
    CompilerCsgAppendU32BE(buf, table.sourceIds.len)
    for row in 0..<table.sourceIds.len:
        CompilerCsgAppendU32BE(buf, table.sourceIds[row])
        CompilerCsgAppendFixed32(buf, table.sourceIdentityCids[row])
        CompilerCsgAppendFixed32(buf, table.inputArtifactCids[row])
        CompilerCsgAppendFixed32(buf, table.outputArtifactCids[row])
        CompilerCsgAppendU32BE(buf, table.rowStarts[row])
        CompilerCsgAppendU32BE(buf, table.rowCounts[row])
        CompilerCsgAppendFixed32(
            buf, table.completionReceiptCids[row])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgTypeDiagnosticStageProduceInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        out: var CompilerCsgTypeDiagnosticCompletionTable,
        receipt: var stage_receipt.CompilerStageReceipt,
        err: var str): bool =
    let pendingRows = compilerCsgDiagnosticRowsPayloadClone(out)
    out = pendingRows
    receipt = stage_receipt.CompilerStageReceipt()
    let parserVerify =
        parser_receipt.ParserNormalizedExprReceiptVerify(parserReceipt)
    if IsErr(parserVerify):
        err = Error(parserVerify)
        return false
    if typeArena == nil ||
       typeArena.producerSourceCount != parserReceipt.sourceSidecars.len ||
       !typearena.TypedExprTypeArenaStrictValidateInto(typeArena, err):
        if err == "":
            err = " compiler csg: type diagnostic producer authority missing"
        return false
    if !compilerCsgDiagnosticRowsPayloadStrictValidateInto(
           out, parserReceipt, err):
        return false
    var typeSyntaxSourceIds: int32[]
    setLen(typeSyntaxSourceIds, typeArena.typeSyntaxCount)
    for typeSyntaxId in 0..<typeArena.typeSyntaxCount:
        typeSyntaxSourceIds[typeSyntaxId] =
            arenamod.ArenaArrayInt32Get(
                typeArena.arena,
                typeArena.typeSyntaxProducerSourceIndexes,
                typeSyntaxId)
    var typeSyntaxRowStarts: int32[]
    var typeSyntaxRowCounts: int32[]
    var typeSyntaxRowIds: int32[]
    if !compilerCsgSourceRowsBuildInto(
           typeSyntaxSourceIds,
           parserReceipt.sourceSidecars.len,
           typeSyntaxRowStarts,
           typeSyntaxRowCounts,
           typeSyntaxRowIds,
           err):
        return false
    var diagnosticCursor: int32
    for sourceId in 0..<parserReceipt.sourceSidecars.len:
        let sidecar = parserReceipt.sourceSidecars[sourceId]
        if sidecar.sourceIndex != sourceId ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err):
            if err == "":
                err = " compiler csg: type diagnostic parser input invalid"
            return false
        add(out.sourceIds, sourceId)
        add(out.sourceIdentityCids, sidecar.sourceContentRaw32)
        add(out.inputArtifactCids, sidecar.sidecarRaw32)
        let sourceTypeAuthorityCid =
            compilerCsgTypeAuthorityCidForSource(
                sourceId,
                sidecar,
                typeArena,
                typeSyntaxRowStarts,
                typeSyntaxRowCounts,
                typeSyntaxRowIds,
                err)
        if layout.FixedBytes32Equal(
               sourceTypeAuthorityCid, layout.FixedBytes32()):
            if err == "":
                err = " compiler csg: type diagnostic source authority missing"
            return false
        add(out.outputArtifactCids, sourceTypeAuthorityCid)
        var rowStart: int32
        var rowCount: int32
        if !compilerCsgDiagnosticSourceRangeInto(
               out,
               sourceId,
               diagnosticCursor,
               rowStart,
               rowCount,
               err):
            return false
        add(out.rowStarts, rowStart)
        add(out.rowCounts, rowCount)
        if !compilerCsgDiagnosticRowProofRangeAppendInto(
               parserReceipt,
               CompilerCsgTypeDiagnosticProducerIdentity,
               out,
               out.sourceIds.len - 1,
               err):
            return false
        let completionReceiptCid =
            compilerCsgTypeDiagnosticCompletionCid(
                out, out.sourceIds.len - 1)
        if layout.FixedBytes32Equal(
               completionReceiptCid, layout.FixedBytes32()):
            err = " compiler csg: type diagnostic completion receipt missing"
            return false
        add(out.completionReceiptCids, completionReceiptCid)
    if diagnosticCursor != out.diagnosticSourceIds.len:
        err = " compiler csg: type diagnostic source partition incomplete"
        return false
    let artifactCid =
        compilerCsgTypeDiagnosticArtifactCid(
            typeArena.artifactRaw32, out)
    var countKeys: str[]
    var countValues: int64[]
    add(countKeys, "diagnostic_completion_count")
    add(countValues, Int64(out.sourceIds.len))
    add(countKeys, "diagnostic_row_count")
    add(countValues, Int64(out.diagnosticSourceIds.len))
    add(countKeys, "producer_source_count")
    add(countValues, Int64(typeArena.producerSourceCount))
    add(countKeys, "type_count")
    add(countValues, Int64(typeArena.typeCount))
    let receiptResult = stage_receipt.CompilerStageReceiptMake(
        stage_receipt.CompilerStageReceiptStageTypedExpr,
        stage_receipt.CompilerStageReceiptLaneShared,
        CompilerCsgTypeDiagnosticProducerIdentity,
        parserReceipt.envelope.receiptRaw32,
        artifactCid,
        countKeys,
        countValues)
    if IsErr(receiptResult):
        err = Error(receiptResult)
        return false
    receipt = Value(receiptResult)
    err = ""
    return true

@borrows
fn compilerCsgStageReceiptEqual(
        left: stage_receipt.CompilerStageReceipt,
        right: stage_receipt.CompilerStageReceipt): bool =
    if left.stageKind != right.stageKind ||
       left.laneKind != right.laneKind ||
       left.producerIdentity != right.producerIdentity ||
       !layout.FixedBytes32Equal(
           left.predecessorRaw32, right.predecessorRaw32) ||
       !layout.FixedBytes32Equal(
           left.artifactRaw32, right.artifactRaw32) ||
       !layout.FixedBytes32Equal(
           left.receiptRaw32, right.receiptRaw32) ||
       left.countKeys.len != right.countKeys.len ||
       left.countValues.len != right.countValues.len:
        return false
    for row in 0..<left.countKeys.len:
        if left.countKeys[row] != right.countKeys[row] ||
           left.countValues[row] != right.countValues[row]:
            return false
    return true

@borrows
fn CompilerCsgTypeDiagnosticCompletionStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    var expected: CompilerCsgTypeDiagnosticCompletionTable
    expected = compilerCsgDiagnosticRowsPayloadClone(
        csg.typeDiagnosticCompletions)
    var expectedReceipt: stage_receipt.CompilerStageReceipt
    if !compilerCsgTypeDiagnosticStageProduceInto(
           csg.parserNormalizedExprReceipt,
           csg.typeArena,
           expected,
           expectedReceipt,
           err):
        return false
    if !compilerCsgDiagnosticCompletionTableEqual(
           csg.typeDiagnosticCompletions, expected):
        err = " compiler csg: type diagnostic completion replay mismatch"
        return false
    if !compilerCsgStageReceiptEqual(
           csg.typeDiagnosticStageReceipt, expectedReceipt):
        err = " compiler csg: type diagnostic stage receipt mismatch"
        return false
    let receiptVerify =
        stage_receipt.CompilerStageReceiptVerify(
            csg.typeDiagnosticStageReceipt)
    if IsErr(receiptVerify):
        err = Error(receiptVerify)
        return false
    err = ""
    return true

@borrows
fn compilerCsgOwnershipAuthorityValidateInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        semanticGraph: CompilerCsgSemanticGraph,
        err: var str): bool =
    var arenaErr: str
    if typeArena == nil ||
       !typearena.TypedExprTypeArenaStrictValidateInto(
           typeArena, arenaErr):
        err = arenaErr == "" ?
            " compiler csg: ownership TypeArena authority missing" :
            arenaErr
        return false
    if !layout.FixedBytes32Equal(
           ir.nodeAuthorityTypeArenaArtifactCid,
           typeArena.artifactRaw32) ||
       !texpr.TypedExprNodeAuthorityStrictValidateInto(
           ir, typeArena, err) ||
       !compilerCsgTypedNodeAuthorityReplayValidateInto(
           ir,
           parserReceipt,
           typeArena,
           semanticGraph,
           err) ||
       !compilerCsgResolvedCallOwnershipEffectsStrictValidateInto(
           parserReceipt, semanticGraph, ir, err):
        if err == "":
            err = " compiler csg: typed ownership authority incomplete"
        return false
    err = ""
    return true

@borrows
fn compilerCsgOwnershipAuthorityCidForSource(
        sourceId: int32,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        nodeRowStarts: var int32[],
        nodeRowCounts: var int32[],
        nodeRowIds: var int32[],
        definitionRowStarts: var int32[],
        definitionRowCounts: var int32[],
        definitionRowIds: var int32[],
        semanticGraph: CompilerCsgSemanticGraph,
        callRowStarts: var int32[],
        callRowCounts: var int32[],
        callRowIds: var int32[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    CompilerCsgAppendText(buf, CompilerCsgOwnershipAuthorityDomain)
    CompilerCsgAppendFixed32(buf, typeArena.artifactRaw32)
    CompilerCsgAppendU32BE(buf, sourceId)
    if sourceId < 0 ||
       sourceId >= nodeRowStarts.len ||
       sourceId >= nodeRowCounts.len ||
       sourceId >= definitionRowStarts.len ||
       sourceId >= definitionRowCounts.len:
        panic("compiler csg: ownership CID source CSR missing")
    let sourceNodeCount = nodeRowCounts[sourceId]
    CompilerCsgAppendU32BE(buf, sourceNodeCount)
    let nodeStart = nodeRowStarts[sourceId]
    for offset in 0..<sourceNodeCount:
        let nodeId = nodeRowIds[nodeStart + offset]
        let ownerSourceId = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_ownerProducerSourceIndexes,
            nodeId)
        CompilerCsgAppendU32BE(buf, nodeId)
        CompilerCsgAppendU32BE(buf, ownerSourceId)
        CompilerCsgAppendU32BE(
            buf,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_ownerDeclarationSourceLocalRows,
                nodeId))
        CompilerCsgAppendU32BE(
            buf,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_exactTypeArenaIds,
                nodeId))
        CompilerCsgAppendU32BE(buf, Int32(ir.nodes2_exprClasses[nodeId]))
        CompilerCsgAppendU32BE(
            buf,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_ownershipPremiseKinds,
                nodeId))
        CompilerCsgAppendU32BE(
            buf,
            ir.nodes2_resultTypeManagedFlags[nodeId] ? 1 : 0)
        CompilerCsgAppendU32BE(
            buf,
            ir.nodes2_paramMutableFlags[nodeId] ? 1 : 0)
    let sourceDefinitionCount =
        definitionRowCounts[sourceId]
    CompilerCsgAppendU32BE(buf, sourceDefinitionCount)
    let definitionStart = definitionRowStarts[sourceId]
    for offset in 0..<sourceDefinitionCount:
        let definitionId =
            definitionRowIds[definitionStart + offset]
        let definingNodeId =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                ir, definitionId)
        CompilerCsgAppendU32BE(buf, definitionId)
        CompilerCsgAppendU32BE(buf, definingNodeId)
        CompilerCsgAppendU32BE(
            buf,
            texpr.TypedExprValueDefinitionExactTypeIdAt(
                ir, definitionId))
        CompilerCsgAppendU32BE(
            buf,
            Int32(texpr.TypedExprValueDefinitionOwnershipAt(
                ir, definitionId)))
    if sourceId >= callRowStarts.len ||
       sourceId >= callRowCounts.len:
        panic("compiler csg: ownership CID call CSR missing")
    let resolved = semanticGraph.resolvedCallTable
    let sourceCallCount = callRowCounts[sourceId]
    CompilerCsgAppendU32BE(buf, sourceCallCount)
    let callStart = callRowStarts[sourceId]
    for offset in 0..<sourceCallCount:
        let callRow = callRowIds[callStart + offset]
        CompilerCsgAppendU32BE(buf, callRow)
        CompilerCsgAppendU32BE(
            buf, resolved.typedCallNodeIndexes[callRow])
        CompilerCsgAppendU32BE(
            buf, resolved.targetFunctionIndexes[callRow])
        CompilerCsgAppendU32BE(
            buf, resolved.targetFunctionAnnotationFlags[callRow])
        CompilerCsgAppendFixed32(
            buf, resolved.targetFunctionContractCids[callRow])
        let argumentStart =
            resolved.callArgumentStarts[callRow]
        let argumentCount = resolved.callArgCounts[callRow]
        CompilerCsgAppendU32BE(buf, argumentCount)
        for argumentIndex in
                argumentStart..<argumentStart + argumentCount:
            CompilerCsgAppendU32BE(
                buf,
                resolved.callArgumentBindingIds[argumentIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.callArgumentTargetParameterDeclarationRows[
                    argumentIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.callArgumentTargetParameterMutableFlags[
                    argumentIndex] ? Int32(1) : Int32(0))
            CompilerCsgAppendFixed32(
                buf,
                resolved.callArgumentBindingCids[argumentIndex])
        let effectStart =
            resolved.ownershipEffectStarts[callRow]
        let effectCount =
            resolved.ownershipEffectCounts[callRow]
        CompilerCsgAppendU32BE(buf, effectCount)
        for effectIndex in effectStart..<effectStart + effectCount:
            CompilerCsgAppendU32BE(
                buf, resolved.ownershipEffectIds[effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectCallArgumentRows[
                    effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionRows[
                    effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionOwnerships[
                        effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionOriginKinds[
                    effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionTypedFunctionIndexes[
                        effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionExactTypeIds[
                        effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionDefiningNodeIndexes[
                        effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionProducerSourceIndexes[
                        effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionSourceLocalNodeIndexes[
                        effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectValueDefinitionDeclarationSourceLocalRows[
                        effectIndex])
            CompilerCsgAppendU32BE(
                buf,
                resolved.ownershipEffectKinds[effectIndex])
            CompilerCsgAppendFixed32(
                buf,
                resolved.ownershipProjection.effectProjectionCids[
                    effectIndex])
            let projectionHopStart =
                resolved.ownershipProjection.effectStarts[
                    effectIndex]
            let projectionHopCount =
                resolved.ownershipProjection.effectCounts[
                    effectIndex]
            CompilerCsgAppendU32BE(buf, projectionHopCount)
            for hopRow in projectionHopStart..<
                    projectionHopStart + projectionHopCount:
                CompilerCsgAppendFixed32(
                    buf,
                    resolved.ownershipProjection.hopCids[
                        hopRow])
            CompilerCsgAppendFixed32(
                buf, resolved.ownershipEffectCids[effectIndex])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgOwnershipDiagnosticArtifactCid(
        typeStageReceiptCid: layout.FixedBytes32,
        table: CompilerCsgTypeDiagnosticCompletionTable): layout.FixedBytes32 =
    let sourceBytes = compilerCsgCheckedCapacityMul(
        table.sourceIds.len,
        192,
        "compiler csg: ownership diagnostic artifact capacity overflow")
    let capacity = compilerCsgCheckedCapacityAdd(
        128,
        sourceBytes,
        "compiler csg: ownership diagnostic artifact capacity overflow")
    var buf = layout.ByteBufInit(capacity)
    CompilerCsgAppendText(
        buf, CompilerCsgOwnershipDiagnosticArtifactDomain)
    CompilerCsgAppendFixed32(buf, typeStageReceiptCid)
    CompilerCsgAppendU32BE(buf, table.sourceIds.len)
    for row in 0..<table.sourceIds.len:
        CompilerCsgAppendU32BE(buf, table.sourceIds[row])
        CompilerCsgAppendFixed32(buf, table.sourceIdentityCids[row])
        CompilerCsgAppendFixed32(buf, table.inputArtifactCids[row])
        CompilerCsgAppendFixed32(buf, table.outputArtifactCids[row])
        CompilerCsgAppendU32BE(buf, table.rowStarts[row])
        CompilerCsgAppendU32BE(buf, table.rowCounts[row])
        CompilerCsgAppendFixed32(
            buf, table.completionReceiptCids[row])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgOwnershipDiagnosticStageProduceInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        semanticGraph: CompilerCsgSemanticGraph,
        typeStageReceipt: stage_receipt.CompilerStageReceipt,
        out: var CompilerCsgTypeDiagnosticCompletionTable,
        receipt: var stage_receipt.CompilerStageReceipt,
        err: var str): bool =
    let pendingRows = compilerCsgDiagnosticRowsPayloadClone(out)
    out = pendingRows
    receipt = stage_receipt.CompilerStageReceipt()
    let parserVerify =
        parser_receipt.ParserNormalizedExprReceiptVerify(parserReceipt)
    if IsErr(parserVerify):
        err = Error(parserVerify)
        return false
    let typeReceiptVerify =
        stage_receipt.CompilerStageReceiptVerify(typeStageReceipt)
    if IsErr(typeReceiptVerify) ||
       typeStageReceipt.stageKind !=
           stage_receipt.CompilerStageReceiptStageTypedExpr ||
       typeStageReceipt.producerIdentity !=
           CompilerCsgTypeDiagnosticProducerIdentity:
        err = IsErr(typeReceiptVerify) ?
            Error(typeReceiptVerify) :
            " compiler csg: ownership predecessor is not type authority"
        return false
    if !compilerCsgOwnershipAuthorityValidateInto(
           parserReceipt, typeArena, ir, semanticGraph, err):
        return false
    if !compilerCsgDiagnosticRowsPayloadStrictValidateInto(
           out, parserReceipt, err):
        return false
    let sourceCount = parserReceipt.sourceSidecars.len
    var nodeSourceIds: int32[]
    setLen(nodeSourceIds, ir.nodes2_nodeIndexs.len)
    for nodeId in 0..<nodeSourceIds.len:
        nodeSourceIds[nodeId] = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_ownerProducerSourceIndexes,
            nodeId)
    var nodeRowStarts: int32[]
    var nodeRowCounts: int32[]
    var nodeRowIds: int32[]
    if !compilerCsgSourceRowsBuildInto(
           nodeSourceIds,
           sourceCount,
           nodeRowStarts,
           nodeRowCounts,
           nodeRowIds,
           err):
        return false
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(ir)
    var definitionSourceIds: int32[]
    setLen(definitionSourceIds, definitionCount)
    for definitionId in 0..<definitionCount:
        let definingNodeId =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                ir, definitionId)
        let definitionSourceId =
            texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                ir, definitionId)
        if definingNodeId < 0 ||
           definingNodeId >= nodeSourceIds.len ||
           definitionSourceId != nodeSourceIds[definingNodeId]:
            err = " compiler csg: ownership definition source identity split"
            return false
        definitionSourceIds[definitionId] = definitionSourceId
    var definitionRowStarts: int32[]
    var definitionRowCounts: int32[]
    var definitionRowIds: int32[]
    if !compilerCsgSourceRowsBuildInto(
           definitionSourceIds,
           sourceCount,
           definitionRowStarts,
           definitionRowCounts,
           definitionRowIds,
           err):
        return false
    var callRowStarts: int32[]
    var callRowCounts: int32[]
    var callRowIds: int32[]
    if !compilerCsgSourceRowsBuildInto(
           semanticGraph.resolvedCallTable.sourceIndexes,
           sourceCount,
           callRowStarts,
           callRowCounts,
           callRowIds,
           err):
        return false
    var diagnosticCursor: int32
    for sourceId in 0..<parserReceipt.sourceSidecars.len:
        let sidecar = parserReceipt.sourceSidecars[sourceId]
        if sidecar.sourceIndex != sourceId ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err):
            if err == "":
                err = " compiler csg: ownership diagnostic source invalid"
            return false
        add(out.sourceIds, sourceId)
        add(out.sourceIdentityCids, sidecar.sourceContentRaw32)
        add(out.inputArtifactCids, typeStageReceipt.artifactRaw32)
        add(out.outputArtifactCids,
            compilerCsgOwnershipAuthorityCidForSource(
                sourceId,
                typeArena,
                ir,
                nodeRowStarts,
                nodeRowCounts,
                nodeRowIds,
                definitionRowStarts,
                definitionRowCounts,
                definitionRowIds,
                semanticGraph,
                callRowStarts,
                callRowCounts,
                callRowIds))
        var rowStart: int32
        var rowCount: int32
        if !compilerCsgDiagnosticSourceRangeInto(
               out,
               sourceId,
               diagnosticCursor,
               rowStart,
               rowCount,
               err):
            return false
        add(out.rowStarts, rowStart)
        add(out.rowCounts, rowCount)
        if !compilerCsgDiagnosticRowProofRangeAppendInto(
               parserReceipt,
               CompilerCsgOwnershipDiagnosticProducerIdentity,
               out,
               out.sourceIds.len - 1,
               err):
            return false
        let completionReceiptCid =
            compilerCsgDiagnosticCompletionCid(
                CompilerCsgOwnershipDiagnosticCompletionDomain,
                out,
                out.sourceIds.len - 1)
        if layout.FixedBytes32Equal(
               completionReceiptCid, layout.FixedBytes32()):
            err = " compiler csg: ownership completion receipt missing"
            return false
        add(out.completionReceiptCids, completionReceiptCid)
    if diagnosticCursor != out.diagnosticSourceIds.len:
        err = " compiler csg: ownership diagnostic source partition incomplete"
        return false
    let artifactCid =
        compilerCsgOwnershipDiagnosticArtifactCid(
            typeStageReceipt.receiptRaw32, out)
    var countKeys: str[]
    var countValues: int64[]
    add(countKeys, "diagnostic_completion_count")
    add(countValues, Int64(out.sourceIds.len))
    add(countKeys, "diagnostic_row_count")
    add(countValues, Int64(out.diagnosticSourceIds.len))
    add(countKeys, "ownership_node_count")
    add(countValues, Int64(ir.nodes2_nodeIndexs.len))
    add(countKeys, "producer_source_count")
    add(countValues, Int64(typeArena.producerSourceCount))
    add(countKeys, "value_definition_count")
    add(countValues,
        Int64(texpr.TypedExprValueDefinitionAuthorityCount(ir)))
    let receiptResult = stage_receipt.CompilerStageReceiptMake(
        stage_receipt.CompilerStageReceiptStageTypedExpr,
        stage_receipt.CompilerStageReceiptLaneShared,
        CompilerCsgOwnershipDiagnosticProducerIdentity,
        typeStageReceipt.receiptRaw32,
        artifactCid,
        countKeys,
        countValues)
    if IsErr(receiptResult):
        err = Error(receiptResult)
        return false
    receipt = Value(receiptResult)
    err = ""
    return true

@borrows
fn CompilerCsgOwnershipDiagnosticCompletionStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    if !CompilerCsgTypeDiagnosticCompletionStrictValidateInto(csg, err):
        return false
    var expected: CompilerCsgTypeDiagnosticCompletionTable
    expected = compilerCsgDiagnosticRowsPayloadClone(
        csg.ownershipDiagnosticCompletions)
    var expectedReceipt: stage_receipt.CompilerStageReceipt
    if !compilerCsgOwnershipDiagnosticStageProduceInto(
           csg.parserNormalizedExprReceipt,
           csg.typeArena,
           csg.typedIr,
           csg.semanticGraph,
           csg.typeDiagnosticStageReceipt,
           expected,
           expectedReceipt,
           err):
        return false
    if !compilerCsgDiagnosticCompletionTableEqual(
           csg.ownershipDiagnosticCompletions, expected) ||
       !compilerCsgStageReceiptEqual(
           csg.ownershipDiagnosticStageReceipt, expectedReceipt):
        err = " compiler csg: ownership diagnostic authority replay mismatch"
        return false
    let receiptVerify =
        stage_receipt.CompilerStageReceiptVerify(
            csg.ownershipDiagnosticStageReceipt)
    if IsErr(receiptVerify):
        err = Error(receiptVerify)
        return false
    err = ""
    return true

fn compilerCsgExactLayoutAlign(
        value: int32,
        alignment: int32,
        out: var int32): bool =
    if value < 0 || alignment <= 0:
        return false
    let aligned =
        ((Int64(value) + Int64(alignment) - Int64(1)) /
         Int64(alignment)) * Int64(alignment)
    if aligned < Int64(0) || aligned > Int64(2147483647):
        return false
    out = Int32(aligned)
    return true

fn compilerCsgExactLayoutAdd(
        left: int32,
        right: int32,
        out: var int32): bool =
    if left < 0 || right < 0:
        return false
    let value = Int64(left) + Int64(right)
    if value > Int64(2147483647):
        return false
    out = Int32(value)
    return true

fn compilerCsgExactScalarLayoutInto(
        scalarKind: typearena.TypedExprStructuralScalarKind,
        sizeBytes: var int32,
        alignBytes: var int32): bool =
    sizeBytes = 0
    alignBytes = 1
    if scalarKind ==
           typearena.TypedExprStructuralScalarVoid:
        return true
    if scalarKind ==
           typearena.TypedExprStructuralScalarBool ||
       scalarKind ==
           typearena.TypedExprStructuralScalarInt8 ||
       scalarKind ==
           typearena.TypedExprStructuralScalarUInt8:
        sizeBytes = 1
        alignBytes = 1
        return true
    if scalarKind ==
           typearena.TypedExprStructuralScalarInt16 ||
       scalarKind ==
           typearena.TypedExprStructuralScalarUInt16:
        sizeBytes = 2
        alignBytes = 2
        return true
    if scalarKind ==
           typearena.TypedExprStructuralScalarChar ||
       scalarKind ==
           typearena.TypedExprStructuralScalarInt ||
       scalarKind ==
           typearena.TypedExprStructuralScalarUInt ||
       scalarKind ==
           typearena.TypedExprStructuralScalarInt32 ||
       scalarKind ==
           typearena.TypedExprStructuralScalarUInt32:
        sizeBytes = 4
        alignBytes = 4
        return true
    if scalarKind ==
           typearena.TypedExprStructuralScalarInt64 ||
       scalarKind ==
           typearena.TypedExprStructuralScalarUInt64 ||
       scalarKind ==
           typearena.TypedExprStructuralScalarFloat32 ||
       scalarKind ==
           typearena.TypedExprStructuralScalarFloat64 ||
       scalarKind ==
           typearena.TypedExprStructuralScalarCString ||
       scalarKind ==
           typearena.TypedExprStructuralScalarPtr ||
       scalarKind ==
           typearena.TypedExprStructuralScalarSet:
        # `set[T]` is a 64-bit mask: std/system.cheng:2821 converts it with
        # `uint64(s)`.  That in-repo conversion is the ABI authority; the
        # cold chain has none (its `set[T]` exact TypeId falls through to
        # the 'i' default at bootstrap/cold_parser.c:5453, which is a
        # default-value leak and must not be read as semantics).
        sizeBytes = 8
        alignBytes = 8
        return true
    if scalarKind ==
           typearena.TypedExprStructuralScalarUtf8View ||
       scalarKind ==
           typearena.TypedExprStructuralScalarBytesView:
        # [sabi-view] A view is a `(ptr,len)` pair: 16 bytes, align 8.
        # This is the Cheng-side ABI authority
        # (typed_expr.cheng:44813-44816 gives the same 16/8).  The cold
        # chain's `SLOT_STR` mapping (bootstrap/cold_parser.c:5435-5437)
        # is a loose approximation and must not be read as the layout:
        # spec 9.x states `str`'s own 24-byte layout is NOT the bridge
        # layout (docs/cheng-formal-spec.md:630).
        sizeBytes = 16
        alignBytes = 8
        return true
    if scalarKind ==
           typearena.TypedExprStructuralScalarStr:
        sizeBytes = 24
        alignBytes = 8
        return true
    return false

@borrows
fn compilerCsgExactLayoutResolveInto(
        typeArena: typearena.TypedExprTypeArena,
        typeId: int32,
        states: var int32[],
        sizes: var int32[],
        aligns: var int32[],
        present: var bool[],
        err: var str): bool =
    if typeId < 0 || typeId >= typeArena.typeCount ||
       states.len != typeArena.typeCount ||
       sizes.len != typeArena.typeCount ||
       aligns.len != typeArena.typeCount ||
       present.len != typeArena.typeCount:
        err = " compiler csg: exact layout TypeArena domain invalid"
        return false
    if states[typeId] == 2:
        return true
    if states[typeId] == 1:
        err = " compiler csg: exact layout direct recursion"
        return false
    states[typeId] = 1
    let kind = typearena.TypedExprTypeArenaKindAt(
        typeArena, typeId)
    let childStart = arenamod.ArenaArrayInt32Get(
        typeArena.arena, typeArena.childStarts, typeId)
    let childCount = arenamod.ArenaArrayInt32Get(
        typeArena.arena, typeArena.childCounts, typeId)
    var sizeBytes: int32
    var alignBytes: int32 = 1
    var layoutPresent = true
    if kind == typearena.TypedExprStructuralTypeScalar:
        let scalarKind =
            typearena.TypedExprStructuralScalarKind(
                arenamod.ArenaArrayInt32Get(
                    typeArena.arena,
                    typeArena.scalarKinds,
                    typeId))
        if scalarKind ==
               typearena.TypedExprStructuralScalarTypedesc:
            # [builtin-ctor] A `typedesc` is a type witness: its value is
            # erased, so it has no layout at all.  That is the same state
            # `TypedExprStructuralTypeGenericParameter` already occupies
            # below (`layoutPresent = false`, size 0, align 1), and it is
            # safe because the snapshot projection skips such rows BY KIND
            # instead of counting them missing
            # (compiler_snapshot_builder.cheng:13932-13938).
            layoutPresent = false
            sizeBytes = 0
            alignBytes = 1
        elif !compilerCsgExactScalarLayoutInto(
               scalarKind, sizeBytes, alignBytes):
            err = " compiler csg: exact scalar layout unsupported"
            return false
    elif kind == typearena.TypedExprStructuralTypeBorrow ||
         kind == typearena.TypedExprStructuralTypeRefObject ||
         kind == typearena.TypedExprStructuralTypeFunction:
        sizeBytes = 8
        alignBytes = 8
    elif kind ==
             typearena.TypedExprStructuralTypeSequence:
        sizeBytes = 16
        alignBytes = 8
    elif kind ==
             typearena.TypedExprStructuralTypeGenericParameter:
        layoutPresent = false
        sizeBytes = 0
        alignBytes = 1
    elif kind ==
             typearena.TypedExprStructuralTypeAlias ||
         kind ==
             typearena.TypedExprStructuralTypeApply:
        if childCount <= 0:
            err = " compiler csg: exact forwarded layout child missing"
            return false
        let childTypeId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.childTypeIds,
            childStart)
        if !compilerCsgExactLayoutResolveInto(
               typeArena,
               childTypeId,
               states,
               sizes,
               aligns,
               present,
               err):
            return false
        layoutPresent = present[childTypeId]
        sizeBytes = sizes[childTypeId]
        alignBytes = aligns[childTypeId]
    elif kind ==
             typearena.TypedExprStructuralTypeFixedArray:
        if childCount != 1:
            err = " compiler csg: exact fixed-array layout child mismatch"
            return false
        let childTypeId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.childTypeIds,
            childStart)
        if !compilerCsgExactLayoutResolveInto(
               typeArena,
               childTypeId,
               states,
               sizes,
               aligns,
               present,
               err):
            return false
        let fixedLength =
            typearena.TypedExprTypeArenaFixedLengthAt(
                typeArena, typeId)
        let totalSize =
            Int64(sizes[childTypeId]) * Int64(fixedLength)
        if fixedLength <= 0 ||
           totalSize < Int64(0) ||
           totalSize > Int64(2147483647):
            err = " compiler csg: exact fixed-array layout invalid"
            return false
        if !present[childTypeId]:
            layoutPresent = false
        else:
            sizeBytes = Int32(totalSize)
            alignBytes = aligns[childTypeId]
    elif kind ==
             typearena.TypedExprStructuralTypeOptional:
        if childCount != 1:
            err = " compiler csg: exact optional layout child mismatch"
            return false
        let childTypeId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.childTypeIds,
            childStart)
        if !compilerCsgExactLayoutResolveInto(
               typeArena,
               childTypeId,
               states,
               sizes,
               aligns,
               present,
               err):
            return false
        if !present[childTypeId]:
            layoutPresent = false
        else:
            var valueOffset: int32
            var valueEnd: int32
            if !compilerCsgExactLayoutAlign(
                   1, aligns[childTypeId], valueOffset) ||
               !compilerCsgExactLayoutAdd(
                   valueOffset, sizes[childTypeId], valueEnd) ||
               !compilerCsgExactLayoutAlign(
                   valueEnd,
                   aligns[childTypeId],
                   sizeBytes):
                err = " compiler csg: exact optional layout overflow"
                return false
            alignBytes = aligns[childTypeId]
    elif kind ==
             typearena.TypedExprStructuralTypeTuple ||
         kind ==
             typearena.TypedExprStructuralTypeObject:
        var cursor: int32
        for childOffset in 0..<childCount:
            let childTypeId = arenamod.ArenaArrayInt32Get(
                typeArena.arena,
                typeArena.childTypeIds,
                childStart + childOffset)
            if !compilerCsgExactLayoutResolveInto(
                   typeArena,
                   childTypeId,
                   states,
                   sizes,
                   aligns,
                   present,
                   err):
                return false
            if !present[childTypeId]:
                layoutPresent = false
                continue
            if !layoutPresent:
                continue
            if !compilerCsgExactLayoutAlign(
                   cursor, aligns[childTypeId], cursor):
                err = " compiler csg: exact aggregate field alignment overflow"
                return false
            if !compilerCsgExactLayoutAdd(
                   cursor, sizes[childTypeId], cursor):
                err = " compiler csg: exact aggregate field offset overflow"
                return false
            if aligns[childTypeId] > alignBytes:
                alignBytes = aligns[childTypeId]
        if layoutPresent &&
           !compilerCsgExactLayoutAlign(
               cursor, alignBytes, sizeBytes):
            err = " compiler csg: exact aggregate layout overflow"
            return false
    elif kind ==
             typearena.TypedExprStructuralTypeEnum:
        var payloadSize: int32
        var payloadAlign: int32 = 1
        for childOffset in 0..<childCount:
            let childTypeId = arenamod.ArenaArrayInt32Get(
                typeArena.arena,
                typeArena.childTypeIds,
                childStart + childOffset)
            if !compilerCsgExactLayoutResolveInto(
                   typeArena,
                   childTypeId,
                   states,
                   sizes,
                   aligns,
                   present,
                   err):
                return false
            if !present[childTypeId]:
                layoutPresent = false
                continue
            if sizes[childTypeId] > payloadSize:
                payloadSize = sizes[childTypeId]
            if aligns[childTypeId] > payloadAlign:
                payloadAlign = aligns[childTypeId]
        if layoutPresent:
            var payloadOffset: int32
            var payloadEnd: int32
            if !compilerCsgExactLayoutAlign(
                   4, payloadAlign, payloadOffset):
                err = " compiler csg: exact enum payload offset overflow"
                return false
            alignBytes = payloadAlign
            if alignBytes < 4:
                alignBytes = 4
            if !compilerCsgExactLayoutAdd(
                   payloadOffset, payloadSize, payloadEnd) ||
               !compilerCsgExactLayoutAlign(
                   payloadEnd,
                   alignBytes,
                   sizeBytes):
                err = " compiler csg: exact enum layout overflow"
                return false
    else:
        err = " compiler csg: exact layout structural kind unsupported"
        return false
    sizes[typeId] = sizeBytes
    aligns[typeId] = alignBytes
    present[typeId] = layoutPresent
    states[typeId] = 2
    err = ""
    return true

fn CompilerCsgCanonicalTypeFactsInto(
        csg: var CompilerCsg,
        structuralKinds: var int32[],
        scalarKinds: var int32[],
        childTypeIds: var int32[],
        layoutChildStarts: var int32[],
        layoutChildCounts: var int32[],
        layoutChildTypeIds: var int32[],
        layoutChildIdentityKinds: var int32[],
        layoutChildMemberRows: var int32[],
        layoutChildSelectorOrdinals: var int32[],
        layoutChildOffsets: var int32[],
        layoutChildWidths: var int32[],
        fixedLengths: var int32[],
        variantCounts: var int32[],
        sizeBytes: var int32[],
        alignBytes: var int32[],
        layoutPresent: var int32[],
        err: var str): bool =
    structuralKinds = []
    scalarKinds = []
    childTypeIds = []
    layoutChildStarts = []
    layoutChildCounts = []
    layoutChildTypeIds = []
    layoutChildIdentityKinds = []
    layoutChildMemberRows = []
    layoutChildSelectorOrdinals = []
    layoutChildOffsets = []
    layoutChildWidths = []
    fixedLengths = []
    variantCounts = []
    sizeBytes = []
    alignBytes = []
    layoutPresent = []
    let typeArena = csg.typeArena
    var typeArenaErr: str
    if typeArena == nil ||
       !typearena.TypedExprTypeArenaComplete(typeArena) ||
       !typearena.TypedExprTypeArenaStrictValidateInto(
           typeArena, typeArenaErr) ||
       layout.FixedBytes32Equal(
           typeArena.artifactRaw32, layout.FixedBytes32()):
        err = Fmt" compiler csg: canonical TypeArena fact source invalid:{typeArenaErr}"
        return false
    let typeCount = typeArena.typeCount
    var states: int32[]
    var sizes: int32[]
    var aligns: int32[]
    var present: bool[]
    setLen(states, typeCount)
    setLen(sizes, typeCount)
    setLen(aligns, typeCount)
    setLen(present, typeCount)
    for typeId in 0..<typeCount:
        if !compilerCsgExactLayoutResolveInto(
               typeArena,
               typeId,
               states,
               sizes,
               aligns,
               present,
               err):
            return false
    for typeId in 0..<typeCount:
        let structuralKind =
            typearena.TypedExprTypeArenaKindAt(typeArena, typeId)
        let childStart = typearena.TypedExprTypeArenaInt32At(
            typeArena, typeArena.childStarts.offset, typeArena.childStarts.len, typeId)
        let childCount = typearena.TypedExprTypeArenaInt32At(
            typeArena, typeArena.childCounts.offset, typeArena.childCounts.len, typeId)
        var childTypeId: int32 = -1
        let unaryProjection =
            structuralKind ==
                typearena.TypedExprStructuralTypeAlias ||
            structuralKind ==
                typearena.TypedExprStructuralTypeBorrow ||
            structuralKind ==
                typearena.TypedExprStructuralTypeSequence ||
            structuralKind ==
                typearena.TypedExprStructuralTypeFixedArray ||
            structuralKind ==
                typearena.TypedExprStructuralTypeOptional
        let applyProjection =
            structuralKind ==
                typearena.TypedExprStructuralTypeApply
        if (unaryProjection && childCount != 1) ||
           (applyProjection && childCount < 2):
            err = Fmt" compiler csg: canonical projected child cardinality invalid type_id={typeId}"
            return false
        if unaryProjection || applyProjection:
            childTypeId = typearena.TypedExprTypeArenaInt32At(
                typeArena,
                typeArena.childTypeIds.offset,
                typeArena.childTypeIds.len,
                childStart)
        if (unaryProjection || applyProjection) &&
           (childTypeId < 0 || childTypeId >= typeCount):
            err = Fmt" compiler csg: canonical projected TypeArena child missing type_id={typeId}"
            return false
        let layoutChildStart = layoutChildTypeIds.len
        var layoutChildCount: int32
        if structuralKind ==
               typearena.TypedExprStructuralTypeAlias ||
           structuralKind ==
               typearena.TypedExprStructuralTypeApply ||
           structuralKind ==
               typearena.TypedExprStructuralTypeSequence ||
           structuralKind ==
               typearena.TypedExprStructuralTypeFixedArray ||
           structuralKind ==
               typearena.TypedExprStructuralTypeOptional:
            layoutChildCount = 1
        elif structuralKind ==
                 typearena.TypedExprStructuralTypeTuple ||
             structuralKind ==
                 typearena.TypedExprStructuralTypeObject ||
             structuralKind ==
                 typearena.TypedExprStructuralTypeRefObject ||
             structuralKind ==
                 typearena.TypedExprStructuralTypeEnum:
            # RefObject 行自身是 8/8 指针句柄 (wall47 exact-layout 权威),
            # 字段行与 Object 同构挂声明行 childCount、居 pointee 偏移
            # 空间 (compiler_snapshot_schema containment ref 豁免同款)。
            layoutChildCount = childCount
        var aggregateCursor: int32
        var enumPayloadAlign: int32 = 1
        if structuralKind ==
               typearena.TypedExprStructuralTypeEnum:
            for enumChildOffset in 0..<childCount:
                let enumChildTypeId = arenamod.ArenaArrayInt32Get(
                    typeArena.arena,
                    typeArena.childTypeIds,
                    childStart + enumChildOffset)
                if enumChildTypeId < 0 || enumChildTypeId >= typeCount ||
                   !present[enumChildTypeId]:
                    err = Fmt" compiler csg: canonical enum layout child invalid type_id={typeId} child={enumChildOffset}"
                    return false
                if aligns[enumChildTypeId] > enumPayloadAlign:
                    enumPayloadAlign = aligns[enumChildTypeId]
        var enumPayloadOffset: int32
        if structuralKind ==
               typearena.TypedExprStructuralTypeEnum &&
           !compilerCsgExactLayoutAlign(
               4, enumPayloadAlign, enumPayloadOffset):
            err = Fmt" compiler csg: canonical enum layout offset invalid type_id={typeId}"
            return false
        for layoutChildOffset in 0..<layoutChildCount:
            let layoutChildTypeId = arenamod.ArenaArrayInt32Get(
                typeArena.arena,
                typeArena.childTypeIds,
                childStart + layoutChildOffset)
            if layoutChildTypeId < 0 ||
               layoutChildTypeId >= typeCount ||
               !present[layoutChildTypeId]:
                err = Fmt" compiler csg: canonical layout child invalid type_id={typeId} child={layoutChildOffset}"
                return false
            var layoutChildByteOffset: int32
            if structuralKind ==
                   typearena.TypedExprStructuralTypeTuple ||
               structuralKind ==
                   typearena.TypedExprStructuralTypeObject ||
               structuralKind ==
                   typearena.TypedExprStructuralTypeRefObject:
                if !compilerCsgExactLayoutAlign(
                       aggregateCursor,
                       aligns[layoutChildTypeId],
                       aggregateCursor):
                    err = Fmt" compiler csg: canonical aggregate child offset invalid type_id={typeId} child={layoutChildOffset}"
                    return false
                layoutChildByteOffset = aggregateCursor
                if !compilerCsgExactLayoutAdd(
                       aggregateCursor,
                       sizes[layoutChildTypeId],
                       aggregateCursor):
                    err = Fmt" compiler csg: canonical aggregate child width invalid type_id={typeId} child={layoutChildOffset}"
                    return false
            elif structuralKind ==
                     typearena.TypedExprStructuralTypeOptional:
                if !compilerCsgExactLayoutAlign(
                       1,
                       aligns[layoutChildTypeId],
                       layoutChildByteOffset):
                    err = Fmt" compiler csg: canonical optional child offset invalid type_id={typeId}"
                    return false
            elif structuralKind ==
                     typearena.TypedExprStructuralTypeEnum:
                layoutChildByteOffset = enumPayloadOffset
            var layoutChildIdentityKind: int32 = 1
            var layoutChildIdentityRow = childStart + layoutChildOffset
            var layoutChildSelectorOrdinal = layoutChildOffset
            if structuralKind ==
                   typearena.TypedExprStructuralTypeObject ||
               structuralKind ==
                   typearena.TypedExprStructuralTypeRefObject ||
               structuralKind ==
                   typearena.TypedExprStructuralTypeEnum:
                let symbolId = arenamod.ArenaArrayInt32Get(
                    typeArena.arena, typeArena.symbolIds, typeId)
                if symbolId < 0 || symbolId >= typeArena.symbolCount:
                    err = Fmt" compiler csg: canonical layout member symbol invalid type_id={typeId} child={layoutChildOffset}"
                    return false
                let memberStart = arenamod.ArenaArrayInt32Get(
                    typeArena.arena,
                    typeArena.symbolMemberStarts,
                    symbolId)
                let memberCount = arenamod.ArenaArrayInt32Get(
                    typeArena.arena,
                    typeArena.symbolMemberCounts,
                    symbolId)
                var memberRow: int32 = -1
                if structuralKind ==
                       typearena.TypedExprStructuralTypeObject ||
                   structuralKind ==
                       typearena.TypedExprStructuralTypeRefObject:
                    if layoutChildOffset < memberCount:
                        memberRow = memberStart + layoutChildOffset
                else:
                    var payloadOrdinal: int32
                    for memberOffset in 0..<memberCount:
                        let candidateRow = memberStart + memberOffset
                        let candidateTypeId = arenamod.ArenaArrayInt32Get(
                            typeArena.arena,
                            typeArena.memberTypeIds,
                            candidateRow)
                        if candidateTypeId >= 0:
                            if payloadOrdinal == layoutChildOffset:
                                memberRow = candidateRow
                                break
                            payloadOrdinal = payloadOrdinal + 1
                if memberRow < memberStart ||
                   memberRow >= memberStart + memberCount ||
                   arenamod.ArenaArrayInt32Get(
                       typeArena.arena,
                       typeArena.memberTypeIds,
                       memberRow) != layoutChildTypeId:
                    err = Fmt" compiler csg: canonical layout exact member invalid type_id={typeId} child={layoutChildOffset}"
                    return false
                layoutChildIdentityKind = 2
                layoutChildIdentityRow = memberRow
                layoutChildSelectorOrdinal =
                    arenamod.ArenaArrayInt32Get(
                        typeArena.arena,
                        typeArena.memberOrdinals,
                        memberRow)
            add(layoutChildTypeIds, layoutChildTypeId)
            add(layoutChildIdentityKinds, layoutChildIdentityKind)
            add(layoutChildMemberRows, layoutChildIdentityRow)
            add(layoutChildSelectorOrdinals, layoutChildSelectorOrdinal)
            add(layoutChildOffsets, layoutChildByteOffset)
            add(layoutChildWidths, sizes[layoutChildTypeId])
        add(layoutChildStarts, layoutChildStart)
        add(layoutChildCounts, layoutChildCount)
        var scalarKind: int32
        if structuralKind ==
               typearena.TypedExprStructuralTypeScalar:
            scalarKind = typearena.TypedExprTypeArenaInt32At(
                typeArena,
                typeArena.scalarKinds.offset,
                typeArena.scalarKinds.len,
                typeId)
            if scalarKind <=
                   Int32(typearena.TypedExprStructuralScalarInvalid):
                err = Fmt" compiler csg: canonical scalar TypeArena fact missing type_id={typeId}"
                return false
        var fixedLength: int32
        if structuralKind ==
               typearena.TypedExprStructuralTypeFixedArray:
            fixedLength =
                typearena.TypedExprTypeArenaFixedLengthAt(
                    typeArena, typeId)
            if fixedLength <= 0:
                err = Fmt" compiler csg: canonical fixed-array length missing type_id={typeId}"
                return false
        var variantCount: int32
        if structuralKind ==
               typearena.TypedExprStructuralTypeEnum:
            let enumSymbolId = arenamod.ArenaArrayInt32Get(
                typeArena.arena, typeArena.symbolIds, typeId)
            if enumSymbolId < 0 || enumSymbolId >= typeArena.symbolCount:
                err = Fmt" compiler csg: canonical enum symbol missing type_id={typeId}"
                return false
            variantCount = arenamod.ArenaArrayInt32Get(
                typeArena.arena,
                typeArena.symbolMemberCounts,
                enumSymbolId)
            if variantCount <= 0:
                err = Fmt" compiler csg: canonical enum variant count missing type_id={typeId}"
                return false
        add(structuralKinds, Int32(structuralKind))
        add(scalarKinds, scalarKind)
        add(childTypeIds, childTypeId)
        add(fixedLengths, fixedLength)
        add(variantCounts, variantCount)
        add(sizeBytes, sizes[typeId])
        add(alignBytes, aligns[typeId])
        add(layoutPresent, present[typeId] ? 1 : 0)
    err = ""
    return true

@borrows
fn compilerCsgExactLayoutPhysicalTypeId(
        typeArena: typearena.TypedExprTypeArena,
        typeId: int32): int32 =
    var current = typeId
    var visited: int32
    while current >= 0 && current < typeArena.typeCount:
        let kind = typearena.TypedExprTypeArenaKindAt(
            typeArena, current)
        if kind != typearena.TypedExprStructuralTypeAlias &&
           kind != typearena.TypedExprStructuralTypeApply &&
           kind != typearena.TypedExprStructuralTypeBorrow:
            return current
        let childCount = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.childCounts,
            current)
        if childCount <= 0:
            return -1
        let childStart = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.childStarts,
            current)
        current = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.childTypeIds,
            childStart)
        visited = visited + 1
        if visited > typeArena.typeCount:
            return -1
    return -1

@borrows
fn compilerCsgExactDeclarationTypeIdFromSidecarsInto(
        sidecars: parser_receipt.ParserCanonicalSourceSidecar[],
        typeArena: typearena.TypedExprTypeArena,
        typeSyntaxSourceStarts: int32[],
        typeSyntaxRows: int32[],
        sourceId: int32,
        declarationSourceLocalRow: int32,
        typeSyntaxIdOut: var int32,
        typeIdOut: var int32,
        err: var str): bool =
    typeSyntaxIdOut = -1
    typeIdOut = -1
    if sourceId < 0 || sourceId >= sidecars.len ||
       sourceId >= typeArena.producerSourceCount ||
       typeSyntaxSourceStarts.len !=
           sidecars.len + 1 ||
       typeSyntaxRows.len != typeArena.typeSyntaxCount:
        err = " compiler csg: exact layout declaration source invalid"
        return false
    let sidecar = sidecars[sourceId]
    if declarationSourceLocalRow < 0 ||
       declarationSourceLocalRow >= sidecar.declarationSourceLocalRows.len ||
       sidecar.declarationSourceLocalRows[
           declarationSourceLocalRow] != declarationSourceLocalRow:
        err = " compiler csg: exact layout declaration row invalid"
        return false
    let sourceLocalTypeSyntaxId =
        sidecar.declarationTypeSyntaxRootIds[
            declarationSourceLocalRow]
    let sourceTypeSyntaxCount =
        typeSyntaxSourceStarts[sourceId + 1] -
        typeSyntaxSourceStarts[sourceId]
    if sourceLocalTypeSyntaxId < 0 ||
       sourceLocalTypeSyntaxId >= sourceTypeSyntaxCount:
        err = " compiler csg: exact layout source TypeSyntax row invalid"
        return false
    typeSyntaxIdOut = typeSyntaxRows[
        typeSyntaxSourceStarts[sourceId] +
        sourceLocalTypeSyntaxId]
    if typeSyntaxIdOut < 0 ||
       typeSyntaxIdOut >= typeArena.typeSyntaxCount ||
       sourceLocalTypeSyntaxId >= sidecar.typeSyntaxKinds.len ||
       sourceLocalTypeSyntaxId >=
           sidecar.typeSyntaxProducerSourceIds.len ||
       sidecar.typeSyntaxProducerSourceIds[
           sourceLocalTypeSyntaxId] != sourceId ||
       arenamod.ArenaArrayInt32Get(
           typeArena.arena,
           typeArena.typeSyntaxProducerSourceIndexes,
           typeSyntaxIdOut) != sourceId ||
       arenamod.ArenaArrayInt32Get(
           typeArena.arena,
           typeArena.typeSyntaxParserKinds,
           typeSyntaxIdOut) !=
               sidecar.typeSyntaxKinds[sourceLocalTypeSyntaxId]:
        err = " compiler csg: exact layout declaration TypeSyntax missing"
        return false
    typeIdOut =
        typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
            typeArena, typeSyntaxIdOut)
    if typeIdOut < 0 || typeIdOut >= typeArena.typeCount:
        err = " compiler csg: exact layout declaration TypeArenaId missing"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExactDeclarationTypeIdInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        typeSyntaxSourceStarts: int32[],
        typeSyntaxRows: int32[],
        sourceId: int32,
        declarationSourceLocalRow: int32,
        typeSyntaxIdOut: var int32,
        typeIdOut: var int32,
        err: var str): bool =
    return compilerCsgExactDeclarationTypeIdFromSidecarsInto(
        receipt.sourceSidecars,
        typeArena,
        typeSyntaxSourceStarts,
        typeSyntaxRows,
        sourceId,
        declarationSourceLocalRow,
        typeSyntaxIdOut,
        typeIdOut,
        err)

fn compilerCsgExternFfiHandlePortablePreamble(
        buf: var layout.ByteBuf,
        domain: str) =
    CompilerCsgAppendText(buf, domain)
    CompilerCsgAppendText(buf, CompilerCsgStandardIdentity)
    CompilerCsgAppendText(buf, CompilerCsgExternFfiHandleSchemaIdentity)
    CompilerCsgAppendText(buf, CompilerCsgNativeProfileIdentity)

fn compilerCsgExternFfiHandleAbiCarrierText(
        carrierKind: int32): str =
    if carrierKind == CompilerCsgExternFfiHandleAbiCarrierUInt32:
        return "csg.scalar.uint32"
    if carrierKind == CompilerCsgExternFfiHandleAbiCarrierUInt64:
        return "csg.scalar.uint64"
    return ""

@borrows
fn compilerCsgExternFfiHandleTypeCidInto(
        typeArena: typearena.TypedExprTypeArena,
        typeId: int32,
        carrierKindOut: var int32,
        typeCidOut: var layout.FixedBytes32,
        err: var str): bool =
    carrierKindOut = 0
    typeCidOut = layout.FixedBytes32()
    if typeArena == nil || !typeArena.complete ||
       typeId < 0 || typeId >= typeArena.typeCount:
        err = " compiler csg: ffi handle exact TypeId missing"
        return false
    let uint32TypeId =
        typearena.TypedExprTypeArenaReservedScalarTypeId(
            typeArena,
            typearena.TypedExprStructuralScalarUInt32)
    let uint64TypeId =
        typearena.TypedExprTypeArenaReservedScalarTypeId(
            typeArena,
            typearena.TypedExprStructuralScalarUInt64)
    var widthBits: int32
    if typeId == uint32TypeId:
        carrierKindOut = CompilerCsgExternFfiHandleAbiCarrierUInt32
        widthBits = 32
    elif typeId == uint64TypeId:
        carrierKindOut = CompilerCsgExternFfiHandleAbiCarrierUInt64
        widthBits = 64
    else:
        err = Fmt" compiler csg: ffi handle carrier must be exact uint32/uint64 TypeId type_id={typeId} uint32={uint32TypeId} uint64={uint64TypeId}"
        return false
    let carrierText =
        compilerCsgExternFfiHandleAbiCarrierText(carrierKindOut)
    var buf = layout.ByteBufInit(192)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleTypeDomain)
    CompilerCsgAppendU32BE(buf, widthBits)
    CompilerCsgAppendText(buf, carrierText)
    typeCidOut = CompilerCsgBufCid(buf)
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleFunctionSymbolCid(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        functionSourceLocalRow: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleFunctionSymbolDomain)
    CompilerCsgAppendFixed32(buf, sidecar.sourceContentRaw32)
    CompilerCsgAppendFixed32(
        buf,
        sidecar.functionDeclarationHeaderCids[functionSourceLocalRow])
    CompilerCsgAppendFixed32(
        buf,
        sidecar.functionDeclarationPathCids[functionSourceLocalRow])
    CompilerCsgAppendFixed32(
        buf, sidecar.functionNameProofCids[functionSourceLocalRow])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgExternFfiHandleParameterSymbolCid(
        functionSymbolCid: layout.FixedBytes32,
        ordinal: int32,
        typeCid: layout.FixedBytes32,
        carrierKind: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(224)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleParameterSymbolDomain)
    CompilerCsgAppendFixed32(buf, functionSymbolCid)
    CompilerCsgAppendU32BE(buf, ordinal)
    CompilerCsgAppendFixed32(buf, typeCid)
    CompilerCsgAppendText(
        buf, compilerCsgExternFfiHandleAbiCarrierText(carrierKind))
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgExternFfiHandleEffectCid(
        functionSymbolCid: layout.FixedBytes32,
        effectKind: int32,
        targetKind: int32,
        parameterOrdinal: int32,
        parameterSymbolCid: layout.FixedBytes32,
        typeCid: layout.FixedBytes32,
        carrierKind: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(288)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleEffectDomain)
    CompilerCsgAppendFixed32(buf, functionSymbolCid)
    CompilerCsgAppendU32BE(buf, effectKind)
    CompilerCsgAppendU32BE(buf, targetKind)
    CompilerCsgAppendU32BE(buf, parameterOrdinal + 1)
    CompilerCsgAppendFixed32(buf, parameterSymbolCid)
    CompilerCsgAppendFixed32(buf, typeCid)
    CompilerCsgAppendText(
        buf, compilerCsgExternFfiHandleAbiCarrierText(carrierKind))
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgExternFfiHandleContractCid(
        table: CompilerCsgExternFfiHandleContractTable,
        contractRow: int32): layout.FixedBytes32 =
    let effectStart = table.effectStarts[contractRow]
    let effectCount = table.effectCounts[contractRow]
    var buf = layout.ByteBufInit(224 + effectCount * 32)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleContractDomain)
    CompilerCsgAppendFixed32(buf, table.functionSymbolCids[contractRow])
    CompilerCsgAppendU32BE(buf, table.unwindKinds[contractRow])
    CompilerCsgAppendU32BE(buf, effectCount)
    for effectOffset in 0..<effectCount:
        CompilerCsgAppendFixed32(
            buf, table.effectCids[effectStart + effectOffset])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgExternFfiHandleInterfaceCid(
        functionSymbolCid: layout.FixedBytes32,
        contractCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(224)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleInterfaceDomain)
    CompilerCsgAppendFixed32(buf, functionSymbolCid)
    CompilerCsgAppendFixed32(buf, contractCid)
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgExternFfiHandleFixed32Less(
        left: layout.FixedBytes32,
        right: layout.FixedBytes32): bool =
    for byteIndex in 0..<layout.FixedBytes32Size:
        if left.data[byteIndex] != right.data[byteIndex]:
            return left.data[byteIndex] < right.data[byteIndex]
    return false

@borrows
fn compilerCsgExternFfiHandleCargoCid(
        table: CompilerCsgExternFfiHandleContractTable): layout.FixedBytes32 =
    var sortedInterfaces =
        CompilerCsgCloneFixed32Seq(table.interfaceCids)
    for row in 1..<sortedInterfaces.len:
        let current = sortedInterfaces[row]
        var prior = row - 1
        while prior >= 0 &&
              compilerCsgExternFfiHandleFixed32Less(
                  current, sortedInterfaces[prior]):
            sortedInterfaces[prior + 1] = sortedInterfaces[prior]
            prior = prior - 1
        sortedInterfaces[prior + 1] = current
    var buf = layout.ByteBufInit(192 + sortedInterfaces.len * 32)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleCargoDomain)
    CompilerCsgAppendU32BE(buf, sortedInterfaces.len)
    for row in 0..<sortedInterfaces.len:
        CompilerCsgAppendFixed32(buf, sortedInterfaces[row])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgExternFfiHandleTypeSyntaxDirectRowsBuildInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        sourceStarts: var int32[],
        directRows: var int32[],
        err: var str): bool =
    sourceStarts = []
    directRows = []
    if typeArena == nil || !typeArena.complete ||
       receipt.sourceSidecars.len != typeArena.producerSourceCount:
        err = " compiler csg: ffi handle parser/TypeArena source domain split"
        return false
    add(sourceStarts, 0)
    for sourceId in 0..<receipt.sourceSidecars.len:
        add(sourceStarts,
            sourceStarts[sourceId] +
                receipt.sourceSidecars[sourceId].typeSyntaxKinds.len)
    if sourceStarts[sourceStarts.len - 1] != typeArena.typeSyntaxCount:
        err = " compiler csg: ffi handle TypeSyntax coverage split"
        return false
    setLen(directRows, typeArena.typeSyntaxCount)
    for row in 0..<directRows.len:
        directRows[row] = -1
    for typeSyntaxId in 0..<typeArena.typeSyntaxCount:
        let sourceId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxProducerSourceIndexes,
            typeSyntaxId)
        let sourceLocalRow = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxSourceLocalRows,
            typeSyntaxId)
        if sourceId < 0 || sourceId >= receipt.sourceSidecars.len ||
           sourceLocalRow < 0 ||
           sourceLocalRow >=
               receipt.sourceSidecars[sourceId].typeSyntaxKinds.len:
            err = " compiler csg: ffi handle TypeSyntax coordinate invalid"
            return false
        let directRow = sourceStarts[sourceId] + sourceLocalRow
        if directRows[directRow] != -1:
            err = " compiler csg: ffi handle TypeSyntax coordinate duplicated"
            return false
        directRows[directRow] = typeSyntaxId
    for row in 0..<directRows.len:
        if directRows[row] < 0:
            err = " compiler csg: ffi handle TypeSyntax coordinate missing"
            return false
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleFunctionAuthorityInto(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        sourceId: int32,
        functionDeclarationSourceLocalRow: int32,
        functionSourceLocalRowOut: var int32,
        functionReturnTypeIdOut: var int32,
        err: var str): bool =
    functionSourceLocalRowOut = -1
    functionReturnTypeIdOut = -1
    if sourceId < 0 || sourceId >= typeArena.producerSourceCount ||
       sourceId >= semanticGraph.sourceTable.declStart.len ||
       sourceId >= semanticGraph.sourceTable.declCount.len ||
       functionDeclarationSourceLocalRow < 0 ||
       functionDeclarationSourceLocalRow >= sidecar.declarationKinds.len ||
       sidecar.declarationKinds[functionDeclarationSourceLocalRow] !=
           Int32(parser.ParserDeclarationFunction):
        err = " compiler csg: ffi handle function declaration authority invalid"
        return false
    let functionStart = arenamod.ArenaArrayInt32Get(
        typeArena.arena, typeArena.functionSourceStarts, sourceId)
    let functionCount = arenamod.ArenaArrayInt32Get(
        typeArena.arena, typeArena.functionSourceCounts, sourceId)
    for sourceLocalFunctionRow in 0..<functionCount:
        let functionRow = functionStart + sourceLocalFunctionRow
        if arenamod.ArenaArrayInt32Get(
               typeArena.arena,
               typeArena.functionDeclarationSourceLocalRows,
               functionRow) != functionDeclarationSourceLocalRow:
            continue
        if functionSourceLocalRowOut >= 0:
            err = " compiler csg: ffi handle function authority ambiguous"
            return false
        functionSourceLocalRowOut = sourceLocalFunctionRow
        functionReturnTypeIdOut = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.functionReturnTypeIds,
            functionRow)
    if functionSourceLocalRowOut < 0 ||
       functionReturnTypeIdOut < 0 ||
       functionReturnTypeIdOut >= typeArena.typeCount ||
       functionSourceLocalRowOut >= sidecar.functionIndexes.len ||
       functionSourceLocalRowOut >=
           sidecar.functionDeclarationOrdinals.len ||
       sidecar.functionDeclarationOrdinals[functionSourceLocalRowOut] !=
           functionSourceLocalRowOut ||
       sidecar.declarationFunctionRows[
           functionDeclarationSourceLocalRow] !=
           functionSourceLocalRowOut:
        err = " compiler csg: ffi handle function row join missing"
        return false
    let declarationStart = semanticGraph.sourceTable.declStart[sourceId]
    let declarationCount = semanticGraph.sourceTable.declCount[sourceId]
    if declarationCount != sidecar.functionIndexes.len ||
       functionSourceLocalRowOut >= declarationCount ||
       declarationStart < 0 ||
       declarationStart >
           semanticGraph.declTable.sourceIndex.len - declarationCount:
        err = " compiler csg: ffi handle semantic declaration CSR split"
        return false
    let semanticDeclarationRow =
        declarationStart + functionSourceLocalRowOut
    if semanticGraph.declTable.sourceIndex[semanticDeclarationRow] !=
           sourceId ||
       !semanticGraph.declTable.importc[semanticDeclarationRow]:
        err = " compiler csg: ffi handle contract target is not extern importc"
        return false
    err = ""
    return true

fn compilerCsgExternFfiHandleGraphEffectKind(
        parserEffectKind: int32): int32 =
    if parserEffectKind ==
           Int32(parser.NormalizedFfiHandleEffectProduce):
        return CompilerCsgEffectExternFfiHandleProduce
    if parserEffectKind ==
           Int32(parser.NormalizedFfiHandleEffectBorrow):
        return CompilerCsgEffectExternFfiHandleBorrow
    if parserEffectKind ==
           Int32(parser.NormalizedFfiHandleEffectConsume):
        return CompilerCsgEffectExternFfiHandleConsume
    return 0

fn compilerCsgExternFfiHandleGraphCarrierCapability(
        carrierKind: int32): int32 =
    if carrierKind == CompilerCsgExternFfiHandleAbiCarrierUInt32:
        return CompilerCsgCapabilityExternFfiHandleUInt32
    if carrierKind == CompilerCsgExternFfiHandleAbiCarrierUInt64:
        return CompilerCsgCapabilityExternFfiHandleUInt64
    return 0

@borrows
fn compilerCsgExternFfiHandleEffectRowStrictValidateInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        typeSyntaxSourceStarts: var int32[],
        typeSyntaxRows: var int32[],
        table: CompilerCsgExternFfiHandleContractTable,
        contractRow: int32,
        effectRow: int32,
        sourceId: int32,
        expectedKind: int32,
        expectedTargetKind: int32,
        expectedParameterOrdinal: int32,
        expectedParameterDeclarationSourceLocalRow: int32,
        functionReturnTypeId: int32,
        err: var str): bool =
    var expectedTypeId = functionReturnTypeId
    if expectedTargetKind ==
           CompilerCsgExternFfiHandleTargetParameter:
        var parameterTypeSyntaxId: int32
        if !compilerCsgExactDeclarationTypeIdInto(
               share(receipt),
               share(typeArena),
               typeSyntaxSourceStarts,
               typeSyntaxRows,
               sourceId,
               expectedParameterDeclarationSourceLocalRow,
               parameterTypeSyntaxId,
               expectedTypeId,
               err):
            return false
    var expectedCarrierKind: int32
    var expectedTypeCid: layout.FixedBytes32
    if !compilerCsgExternFfiHandleTypeCidInto(
           share(typeArena),
           expectedTypeId,
           expectedCarrierKind,
           expectedTypeCid,
           err):
        return false
    var expectedParameterSymbolCid: layout.FixedBytes32
    if expectedTargetKind ==
           CompilerCsgExternFfiHandleTargetParameter:
        expectedParameterSymbolCid =
            compilerCsgExternFfiHandleParameterSymbolCid(
                table.functionSymbolCids[contractRow],
                expectedParameterOrdinal,
                expectedTypeCid,
                expectedCarrierKind)
    let expectedEffectCid = compilerCsgExternFfiHandleEffectCid(
        table.functionSymbolCids[contractRow],
        expectedKind,
        expectedTargetKind,
        expectedParameterOrdinal,
        expectedParameterSymbolCid,
        expectedTypeCid,
        expectedCarrierKind)
    if effectRow < 0 || effectRow >= table.effectKinds.len ||
       table.effectContractRows[effectRow] != contractRow ||
       table.effectKinds[effectRow] != expectedKind ||
       table.effectTargetKinds[effectRow] != expectedTargetKind ||
       table.effectParameterOrdinals[effectRow] !=
           expectedParameterOrdinal ||
       table.effectParameterDeclarationSourceLocalRows[effectRow] !=
           expectedParameterDeclarationSourceLocalRow ||
       table.effectTypeIds[effectRow] != expectedTypeId ||
       table.effectAbiCarrierKinds[effectRow] !=
           expectedCarrierKind ||
       !layout.FixedBytes32Equal(
           table.effectTypeCids[effectRow], expectedTypeCid) ||
       !layout.FixedBytes32Equal(
           table.effectParameterSymbolCids[effectRow],
           expectedParameterSymbolCid) ||
       !layout.FixedBytes32Equal(
           table.effectCids[effectRow], expectedEffectCid) ||
       table.effectGraphNodeIds[effectRow] <= 0 ||
       (expectedTargetKind ==
            CompilerCsgExternFfiHandleTargetResult &&
        table.effectParameterSymbolIds[effectRow] != -1) ||
       (expectedTargetKind ==
            CompilerCsgExternFfiHandleTargetParameter &&
        table.effectParameterSymbolIds[effectRow] <= 0):
        err = Fmt" compiler csg: ffi handle effect row mismatch row={effectRow}"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleContractTableValidateContractsRec(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        table: CompilerCsgExternFfiHandleContractTable,
        typeSyntaxSourceStarts: var int32[],
        typeSyntaxRows: var int32[],
        sourceId: int32,
        sourceContractRow: int32,
        contractCursor: var int32,
        effectCursor: var int32,
        err: var str): bool =
    while true:
        if sourceId >= receipt.sourceSidecars.len:
            return true
        let sidecar = receipt.sourceSidecars[sourceId]
        if sourceContractRow >= sidecar.ffiHandleContractProducerSourceIds.len:
            sourceId = sourceId + 1
            sourceContractRow = 0
            continue
        let contractRow = contractCursor
        let functionDeclarationSourceLocalRow =
            sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows[
                sourceContractRow]
        var functionSourceLocalRow: int32
        var functionReturnTypeId: int32
        if !compilerCsgExternFfiHandleFunctionAuthorityInto(
               share(sidecar),
               share(typeArena),
               share(semanticGraph),
               sourceId,
               functionDeclarationSourceLocalRow,
               functionSourceLocalRow,
               functionReturnTypeId,
               err):
            return false
        let expectedFunctionSymbolCid =
            compilerCsgExternFfiHandleFunctionSymbolCid(
                sidecar, functionSourceLocalRow)
        let parameterStart =
            sidecar.ffiHandleContractParameterStarts[
                sourceContractRow]
        let parameterCount =
            sidecar.ffiHandleContractParameterCounts[
                sourceContractRow]
        let resultEffect =
            sidecar.ffiHandleContractResultEffects[sourceContractRow]
        var expectedEffectCount = parameterCount
        if resultEffect ==
               Int32(parser.NormalizedFfiHandleEffectProduce):
            expectedEffectCount = expectedEffectCount + 1
        if table.producerSourceIds[contractRow] != sourceId ||
           table.functionDeclarationSourceLocalRows[contractRow] !=
               functionDeclarationSourceLocalRow ||
           table.functionSourceLocalRows[contractRow] !=
               functionSourceLocalRow ||
           table.functionSymbolIds[contractRow] <= 0 ||
           table.contractGraphNodeIds[contractRow] <= 0 ||
           table.effectStarts[contractRow] != effectCursor ||
           table.effectCounts[contractRow] != expectedEffectCount ||
           !layout.FixedBytes32Equal(
               table.functionSymbolCids[contractRow],
               expectedFunctionSymbolCid) ||
           !layout.FixedBytes32Equal(
               table.parserContractCids[contractRow],
               sidecar.ffiHandleParserContractCids[
                   sourceContractRow]) ||
           table.unwindKinds[contractRow] !=
               CompilerCsgExternFfiHandleUnwindNoUnwind ||
           table.unwindKinds[contractRow] !=
               sidecar.ffiHandleContractUnwindKinds[sourceContractRow]:
            err = Fmt" compiler csg: ffi handle contract authority mismatch row={contractRow}"
            return false
        if resultEffect ==
               Int32(parser.NormalizedFfiHandleEffectProduce):
            if !compilerCsgExternFfiHandleEffectRowStrictValidateInto(
                   receipt,
                   typeArena,
                   typeSyntaxSourceStarts,
                   typeSyntaxRows,
                   table,
                   contractRow,
                   effectCursor,
                   sourceId,
                   resultEffect,
                   CompilerCsgExternFfiHandleTargetResult,
                   -1,
                   -1,
                   functionReturnTypeId,
                   err):
                return false
            effectCursor = effectCursor + 1
        for parameterOffset in 0..<parameterCount:
            let parserEffectRow = parameterStart + parameterOffset
            if !compilerCsgExternFfiHandleEffectRowStrictValidateInto(
                   receipt,
                   typeArena,
                   typeSyntaxSourceStarts,
                   typeSyntaxRows,
                   table,
                   contractRow,
                   effectCursor,
                   sourceId,
                   sidecar.ffiHandleParameterEffects[parserEffectRow],
                   CompilerCsgExternFfiHandleTargetParameter,
                   sidecar.ffiHandleParameterOrdinals[parserEffectRow],
                   sidecar.ffiHandleParameterDeclarationSourceLocalRows[
                       parserEffectRow],
                   functionReturnTypeId,
                   err):
                return false
            effectCursor = effectCursor + 1
        let expectedContractCid =
            compilerCsgExternFfiHandleContractCid(table, contractRow)
        let expectedInterfaceCid =
            compilerCsgExternFfiHandleInterfaceCid(
                expectedFunctionSymbolCid, expectedContractCid)
        if !layout.FixedBytes32Equal(
               table.contractCids[contractRow],
               expectedContractCid) ||
           !layout.FixedBytes32Equal(
               table.interfaceCids[contractRow],
               expectedInterfaceCid):
            err = Fmt" compiler csg: ffi handle contract/interface CID mismatch row={contractRow}"
            return false
        contractCursor = contractCursor + 1
        sourceContractRow = sourceContractRow + 1
        continue

@borrows
fn compilerCsgExternFfiHandleContractTableValidateSidecarsRec(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        sourceId: int32,
        expectedContractCount: var int32,
        err: var str): bool =
    while true:
        if sourceId >= receipt.sourceSidecars.len:
            return true
        var sidecarErr: str
        if !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               receipt.sourceSidecars[sourceId], sidecarErr):
            err = Fmt" compiler csg: ffi handle exact-tree sidecar invalid source={sourceId}: {sidecarErr}"
            return false
        expectedContractCount = expectedContractCount +
            receipt.sourceSidecars[sourceId].ffiHandleContractProducerSourceIds.len
        sourceId = sourceId + 1
        continue

@borrows
fn compilerCsgExternFfiHandleContractTableSemanticStrictValidateInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        table: CompilerCsgExternFfiHandleContractTable,
        err: var str): bool =
    let contractCount = table.producerSourceIds.len
    let effectCount = table.effectKinds.len
    if !table.complete ||
       contractCount !=
           table.functionDeclarationSourceLocalRows.len ||
       contractCount != table.functionSourceLocalRows.len ||
       contractCount != table.functionSymbolIds.len ||
       contractCount != table.functionSymbolCids.len ||
       contractCount != table.parserContractCids.len ||
       contractCount != table.unwindKinds.len ||
       contractCount != table.effectStarts.len ||
       contractCount != table.effectCounts.len ||
       contractCount != table.contractCids.len ||
       contractCount != table.interfaceCids.len ||
       contractCount != table.contractGraphNodeIds.len ||
       effectCount != table.effectContractRows.len ||
       effectCount != table.effectTargetKinds.len ||
       effectCount != table.effectParameterOrdinals.len ||
       effectCount !=
           table.effectParameterDeclarationSourceLocalRows.len ||
       effectCount != table.effectParameterSymbolIds.len ||
       effectCount != table.effectParameterSymbolCids.len ||
       effectCount != table.effectTypeIds.len ||
       effectCount != table.effectTypeCids.len ||
       effectCount != table.effectAbiCarrierKinds.len ||
       effectCount != table.effectCids.len ||
       effectCount != table.effectGraphNodeIds.len:
        err = " compiler csg: ffi handle snapshot table shape mismatch"
        return false
    var expectedContractCount: int32
    if !compilerCsgExternFfiHandleContractTableValidateSidecarsRec(
           receipt, 0, expectedContractCount, err):
        return false
    if expectedContractCount != contractCount:
        err = " compiler csg: ffi handle snapshot contract coverage mismatch"
        return false
    var typeSyntaxSourceStarts: int32[]
    var typeSyntaxRows: int32[]
    if !compilerCsgExternFfiHandleTypeSyntaxDirectRowsBuildInto(
           share(receipt),
           share(typeArena),
           typeSyntaxSourceStarts,
           typeSyntaxRows,
           err):
        return false
    var contractCursor: int32
    var effectCursor: int32
    if !compilerCsgExternFfiHandleContractTableValidateContractsRec(
           receipt,
           typeArena,
           semanticGraph,
           table,
           typeSyntaxSourceStarts,
           typeSyntaxRows,
           0,
           0,
           contractCursor,
           effectCursor,
           err):
        return false
    if contractCursor != contractCount || effectCursor != effectCount ||
       layout.FixedBytes32Equal(table.cargoCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           table.cargoCid,
           compilerCsgExternFfiHandleCargoCid(table)):
        err = " compiler csg: ffi handle contract cargo mismatch"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleModuleNodeId(
        nodes: CompilerCsgNode[],
        modulePath: str): int32 =
    var nodeId: int32 = -1
    for nodeIndex in 0..<nodes.len:
        if nodes[nodeIndex].nodeKind != CompilerCsgNodeKindModule ||
           nodes[nodeIndex].modulePath != modulePath:
            continue
        if nodeId >= 0:
            return -1
        nodeId = nodes[nodeIndex].nodeId
    return nodeId

@borrows
fn compilerCsgExternFfiHandleGraphNodeIndex(
        nodes: CompilerCsgNode[],
        nodeId: int32): int32 =
    for nodeIndex in 0..<nodes.len:
        if nodes[nodeIndex].nodeId == nodeId:
            return nodeIndex
    return -1

@borrows
fn compilerCsgExternFfiHandleGraphEdgeCount(
        edges: CompilerCsgEdge[],
        fromNodeId: int32,
        toNodeId: int32,
        edgeKind: int32): int32 =
    var count: int32
    for edgeIndex in 0..<edges.len:
        if edges[edgeIndex].fromNodeId == fromNodeId &&
           edges[edgeIndex].toNodeId == toNodeId &&
           edges[edgeIndex].edgeKind == edgeKind:
            count = count + 1
    return count

@borrows
fn compilerCsgExternFfiHandleNodeFieldsEqual(
        left: CompilerCsgNode,
        right: CompilerCsgNode): bool =
    return left.nodeId == right.nodeId &&
           left.nodeKind == right.nodeKind &&
           left.ownerNodeId == right.ownerNodeId &&
           left.modulePath == right.modulePath &&
           left.symbolText == right.symbolText &&
           left.factText == right.factText &&
           left.producerSourceIndex == right.producerSourceIndex &&
           left.producerDeclarationIndex ==
               right.producerDeclarationIndex &&
           left.functionNameSurfaceKind ==
               right.functionNameSurfaceKind &&
           layout.FixedBytes32Equal(
               left.nameProofCid, right.nameProofCid) &&
           left.semanticSource == right.semanticSource &&
           left.semanticDeclarationLineIndex ==
               right.semanticDeclarationLineIndex &&
           left.semanticParamTypeJoin == right.semanticParamTypeJoin &&
           left.semanticReturnType == right.semanticReturnType &&
           left.semanticSignatureComplete ==
               right.semanticSignatureComplete &&
           left.resultLayoutKind == right.resultLayoutKind &&
           left.effectKind == right.effectKind &&
           left.capabilityKind == right.capabilityKind &&
           left.callConv == right.callConv &&
           left.entryFlag == right.entryFlag &&
           left.exportedFlag == right.exportedFlag &&
           left.exportSymbolName == right.exportSymbolName &&
           left.exportNameExplicit == right.exportNameExplicit &&
           layout.FixedBytes32Equal(left.factCid, right.factCid)

@borrows
fn compilerCsgExternFfiHandleFunctionNode(
        nodeId: int32,
        moduleNodeId: int32,
        modulePath: str,
        producerSourceId: int32,
        functionDeclarationSourceLocalRow: int32,
        functionSymbolCid: layout.FixedBytes32,
        contractCid: layout.FixedBytes32,
        interfaceCid: layout.FixedBytes32): CompilerCsgNode =
    var node: CompilerCsgNode
    node.nodeId = nodeId
    # Extern declarations occupy the real Symbol domain. Reachable Cheng
    # functions and extern contract symbols are partitioned by exact nodeId
    # authority in the parser provenance validator.
    node.nodeKind = CompilerCsgNodeKindSymbol
    node.ownerNodeId = moduleNodeId
    node.modulePath = parser.ParserOwnedText(modulePath)
    node.symbolText = layout.FixedBytes32Hex(functionSymbolCid)
    node.factText = CompilerCsgExternFfiHandleSymbolFact
    node.producerSourceIndex = producerSourceId
    node.producerDeclarationIndex =
        functionDeclarationSourceLocalRow
    node.nameProofCid = functionSymbolCid
    node.semanticSource = CompilerCsgExternFfiHandleSchemaIdentity
    node.semanticDeclarationLineIndex = 0
    node.semanticParamTypeJoin = layout.FixedBytes32Hex(contractCid)
    node.semanticReturnType = layout.FixedBytes32Hex(interfaceCid)
    node.semanticSignatureComplete = 1
    node.resultLayoutKind = 0
    node.effectKind = 0
    node.capabilityKind = CompilerCsgCapabilityExternFfiHandleSymbol
    node.callConv = CompilerCsgExternFfiHandleCallConvImportc
    node.factCid = CompilerCsgHashNodeRecord(node)
    return node

@borrows
fn compilerCsgExternFfiHandleContractNode(
        nodeId: int32,
        functionNodeId: int32,
        modulePath: str,
        producerSourceId: int32,
        functionDeclarationSourceLocalRow: int32,
        functionSymbolCid: layout.FixedBytes32,
        contractCid: layout.FixedBytes32,
        interfaceCid: layout.FixedBytes32,
        effectCount: int32): CompilerCsgNode =
    var node: CompilerCsgNode
    node.nodeId = nodeId
    node.nodeKind = CompilerCsgNodeKindEffect
    node.ownerNodeId = functionNodeId
    node.modulePath = parser.ParserOwnedText(modulePath)
    node.symbolText = layout.FixedBytes32Hex(contractCid)
    node.factText = CompilerCsgExternFfiHandleContractFact
    node.producerSourceIndex = producerSourceId
    node.producerDeclarationIndex =
        functionDeclarationSourceLocalRow
    node.nameProofCid = contractCid
    node.semanticSource = CompilerCsgExternFfiHandleSchemaIdentity
    node.semanticDeclarationLineIndex = 0
    node.semanticParamTypeJoin =
        layout.FixedBytes32Hex(functionSymbolCid)
    node.semanticReturnType = layout.FixedBytes32Hex(interfaceCid)
    node.semanticSignatureComplete = 1
    node.resultLayoutKind = effectCount
    node.effectKind = CompilerCsgEffectExternFfiHandleContract
    node.capabilityKind = CompilerCsgCapabilityExternFfiHandleSymbol
    node.callConv = CompilerCsgExternFfiHandleCallConvImportc
    node.factCid = CompilerCsgHashNodeRecord(node)
    return node

@borrows
fn compilerCsgExternFfiHandleParameterNode(
        nodeId: int32,
        functionNodeId: int32,
        modulePath: str,
        producerSourceId: int32,
        parameterDeclarationSourceLocalRow: int32,
        ordinal: int32,
        functionSymbolCid: layout.FixedBytes32,
        parameterSymbolCid: layout.FixedBytes32,
        typeCid: layout.FixedBytes32,
        carrierKind: int32): CompilerCsgNode =
    var node: CompilerCsgNode
    node.nodeId = nodeId
    node.nodeKind = CompilerCsgNodeKindCapability
    node.ownerNodeId = functionNodeId
    node.modulePath = parser.ParserOwnedText(modulePath)
    node.symbolText = layout.FixedBytes32Hex(parameterSymbolCid)
    node.factText = CompilerCsgExternFfiHandleParameterFact
    node.producerSourceIndex = producerSourceId
    node.producerDeclarationIndex =
        parameterDeclarationSourceLocalRow
    node.nameProofCid = parameterSymbolCid
    node.semanticSource = CompilerCsgExternFfiHandleSchemaIdentity
    node.semanticDeclarationLineIndex = 0
    node.semanticParamTypeJoin = layout.FixedBytes32Hex(typeCid)
    node.semanticReturnType = layout.FixedBytes32Hex(functionSymbolCid)
    node.semanticSignatureComplete = 1
    node.resultLayoutKind = ordinal + 1
    node.effectKind = 0
    node.capabilityKind =
        compilerCsgExternFfiHandleGraphCarrierCapability(carrierKind)
    node.callConv = CompilerCsgExternFfiHandleCallConvImportc
    node.factCid = CompilerCsgHashNodeRecord(node)
    return node

@borrows
fn compilerCsgExternFfiHandleEffectNode(
        nodeId: int32,
        contractNodeId: int32,
        modulePath: str,
        producerSourceId: int32,
        producerDeclarationSourceLocalRow: int32,
        functionSymbolCid: layout.FixedBytes32,
        parameterSymbolCid: layout.FixedBytes32,
        typeCid: layout.FixedBytes32,
        effectCid: layout.FixedBytes32,
        effectKind: int32,
        targetKind: int32,
        parameterOrdinal: int32,
        carrierKind: int32): CompilerCsgNode =
    var node: CompilerCsgNode
    node.nodeId = nodeId
    node.nodeKind = CompilerCsgNodeKindEffect
    node.ownerNodeId = contractNodeId
    node.modulePath = parser.ParserOwnedText(modulePath)
    node.symbolText = layout.FixedBytes32Hex(effectCid)
    node.factText = CompilerCsgExternFfiHandleEffectFact
    node.producerSourceIndex = producerSourceId
    node.producerDeclarationIndex =
        producerDeclarationSourceLocalRow
    node.nameProofCid = effectCid
    node.semanticSource = CompilerCsgExternFfiHandleSchemaIdentity
    node.semanticDeclarationLineIndex = 0
    node.semanticParamTypeJoin = layout.FixedBytes32Hex(typeCid)
    if targetKind == CompilerCsgExternFfiHandleTargetResult:
        node.semanticReturnType = layout.FixedBytes32Hex(functionSymbolCid)
    else:
        node.semanticReturnType = layout.FixedBytes32Hex(parameterSymbolCid)
    node.semanticSignatureComplete = 1
    node.resultLayoutKind = targetKind
    node.effectKind =
        compilerCsgExternFfiHandleGraphEffectKind(effectKind)
    node.capabilityKind =
        compilerCsgExternFfiHandleGraphCarrierCapability(carrierKind)
    node.callConv = parameterOrdinal + 1
    node.factCid = CompilerCsgHashNodeRecord(node)
    return node

fn compilerCsgExternFfiHandleStagedEdgeAppend(
        stagedEdges: var CompilerCsgEdge[],
        firstEdgeId: int32,
        fromNodeId: int32,
        toNodeId: int32,
        edgeKind: int32) =
    var edge: CompilerCsgEdge
    edge.edgeId = firstEdgeId + stagedEdges.len
    edge.fromNodeId = fromNodeId
    edge.toNodeId = toNodeId
    edge.edgeKind = edgeKind
    edge.edgeCid = CompilerCsgHashEdge(
        fromNodeId, toNodeId, edgeKind)
    add(stagedEdges, edge)

@borrows
fn compilerCsgExternFfiHandleGraphStrictValidateInto(
        semanticGraph: CompilerCsgSemanticGraph,
        table: CompilerCsgExternFfiHandleContractTable,
        nodes: CompilerCsgNode[],
        edges: CompilerCsgEdge[],
        err: var str): bool =
    var expectedParameterNodeCount: int32
    for effectRow in 0..<table.effectKinds.len:
        if table.effectTargetKinds[effectRow] ==
               CompilerCsgExternFfiHandleTargetParameter:
            expectedParameterNodeCount = expectedParameterNodeCount + 1
    var observedFunctionNodeCount: int32
    var observedContractNodeCount: int32
    var observedParameterNodeCount: int32
    var observedEffectNodeCount: int32
    for nodeIndex in 0..<nodes.len:
        if nodes[nodeIndex].factText ==
               CompilerCsgExternFfiHandleSymbolFact:
            observedFunctionNodeCount = observedFunctionNodeCount + 1
        elif nodes[nodeIndex].factText ==
                 CompilerCsgExternFfiHandleContractFact:
            observedContractNodeCount = observedContractNodeCount + 1
        elif nodes[nodeIndex].factText ==
                 CompilerCsgExternFfiHandleParameterFact:
            observedParameterNodeCount = observedParameterNodeCount + 1
        elif nodes[nodeIndex].factText ==
                 CompilerCsgExternFfiHandleEffectFact:
            observedEffectNodeCount = observedEffectNodeCount + 1
    if observedFunctionNodeCount != table.producerSourceIds.len ||
       observedContractNodeCount != table.producerSourceIds.len ||
       observedParameterNodeCount != expectedParameterNodeCount ||
       observedEffectNodeCount != table.effectKinds.len:
        err = " compiler csg: ffi handle normalized graph carrier coverage mismatch"
        return false
    var expectedCarrierEdgeCount: int32
    for contractRow in 0..<table.producerSourceIds.len:
        let sourceId = table.producerSourceIds[contractRow]
        if sourceId < 0 ||
           sourceId >= semanticGraph.sourceTable.modulePaths.len:
            err = " compiler csg: ffi handle graph source module missing"
            return false
        let modulePath = semanticGraph.sourceTable.modulePaths[sourceId]
        let moduleNodeId = compilerCsgExternFfiHandleModuleNodeId(
            nodes, modulePath)
        if moduleNodeId <= 0:
            err = " compiler csg: ffi handle graph module node missing"
            return false
        let functionNodeId = table.functionSymbolIds[contractRow]
        let contractNodeId = table.contractGraphNodeIds[contractRow]
        let functionNodeIndex = compilerCsgExternFfiHandleGraphNodeIndex(
            nodes, functionNodeId)
        let contractNodeIndex = compilerCsgExternFfiHandleGraphNodeIndex(
            nodes, contractNodeId)
        if functionNodeIndex < 0 || contractNodeIndex < 0:
            err = " compiler csg: ffi handle graph function/contract node missing"
            return false
        let expectedFunctionNode =
            compilerCsgExternFfiHandleFunctionNode(
                functionNodeId,
                moduleNodeId,
                modulePath,
                sourceId,
                table.functionDeclarationSourceLocalRows[contractRow],
                table.functionSymbolCids[contractRow],
                table.contractCids[contractRow],
                table.interfaceCids[contractRow])
        let expectedContractNode =
            compilerCsgExternFfiHandleContractNode(
                contractNodeId,
                functionNodeId,
                modulePath,
                sourceId,
                table.functionDeclarationSourceLocalRows[contractRow],
                table.functionSymbolCids[contractRow],
                table.contractCids[contractRow],
                table.interfaceCids[contractRow],
                table.effectCounts[contractRow])
        if !compilerCsgExternFfiHandleNodeFieldsEqual(
               nodes[functionNodeIndex], expectedFunctionNode) ||
           !compilerCsgExternFfiHandleNodeFieldsEqual(
               nodes[contractNodeIndex], expectedContractNode) ||
           compilerCsgExternFfiHandleGraphEdgeCount(
               edges,
               moduleNodeId,
               functionNodeId,
               CompilerCsgEdgeKindHasCapability) != 1 ||
           compilerCsgExternFfiHandleGraphEdgeCount(
               edges,
               functionNodeId,
               contractNodeId,
               CompilerCsgEdgeKindHasEffect) != 1:
            err = Fmt" compiler csg: ffi handle graph contract carrier mismatch row={contractRow}"
            return false
        expectedCarrierEdgeCount = expectedCarrierEdgeCount + 2
        let effectStart = table.effectStarts[contractRow]
        let effectCount = table.effectCounts[contractRow]
        for effectOffset in 0..<effectCount:
            let effectRow = effectStart + effectOffset
            let effectNodeId = table.effectGraphNodeIds[effectRow]
            let effectNodeIndex =
                compilerCsgExternFfiHandleGraphNodeIndex(
                    nodes, effectNodeId)
            if effectNodeIndex < 0:
                err = " compiler csg: ffi handle graph effect node missing"
                return false
            var producerDeclarationSourceLocalRow =
                table.functionDeclarationSourceLocalRows[contractRow]
            if table.effectTargetKinds[effectRow] ==
                   CompilerCsgExternFfiHandleTargetParameter:
                producerDeclarationSourceLocalRow =
                    table.effectParameterDeclarationSourceLocalRows[
                        effectRow]
            let expectedEffectNode =
                compilerCsgExternFfiHandleEffectNode(
                    effectNodeId,
                    contractNodeId,
                    modulePath,
                    sourceId,
                    producerDeclarationSourceLocalRow,
                    table.functionSymbolCids[contractRow],
                    table.effectParameterSymbolCids[effectRow],
                    table.effectTypeCids[effectRow],
                    table.effectCids[effectRow],
                    table.effectKinds[effectRow],
                    table.effectTargetKinds[effectRow],
                    table.effectParameterOrdinals[effectRow],
                    table.effectAbiCarrierKinds[effectRow])
            if !compilerCsgExternFfiHandleNodeFieldsEqual(
                   nodes[effectNodeIndex], expectedEffectNode) ||
               compilerCsgExternFfiHandleGraphEdgeCount(
                   edges,
                   contractNodeId,
                   effectNodeId,
                   CompilerCsgEdgeKindHasEffect) != 1:
                err = Fmt" compiler csg: ffi handle graph effect carrier mismatch row={effectRow}"
                return false
            expectedCarrierEdgeCount = expectedCarrierEdgeCount + 1
            if table.effectTargetKinds[effectRow] !=
                   CompilerCsgExternFfiHandleTargetParameter:
                continue
            let parameterNodeId =
                table.effectParameterSymbolIds[effectRow]
            let parameterNodeIndex =
                compilerCsgExternFfiHandleGraphNodeIndex(
                    nodes, parameterNodeId)
            if parameterNodeIndex < 0:
                err = " compiler csg: ffi handle parameter Symbol node missing"
                return false
            let expectedParameterNode =
                compilerCsgExternFfiHandleParameterNode(
                    parameterNodeId,
                    functionNodeId,
                    modulePath,
                    sourceId,
                    table.effectParameterDeclarationSourceLocalRows[
                        effectRow],
                    table.effectParameterOrdinals[effectRow],
                    table.functionSymbolCids[contractRow],
                    table.effectParameterSymbolCids[effectRow],
                    table.effectTypeCids[effectRow],
                    table.effectAbiCarrierKinds[effectRow])
            if !compilerCsgExternFfiHandleNodeFieldsEqual(
                   nodes[parameterNodeIndex], expectedParameterNode) ||
               compilerCsgExternFfiHandleGraphEdgeCount(
                   edges,
                   functionNodeId,
                   parameterNodeId,
                   CompilerCsgEdgeKindHasCapability) != 1 ||
               compilerCsgExternFfiHandleGraphEdgeCount(
                   edges,
                   effectNodeId,
                   parameterNodeId,
                   CompilerCsgEdgeKindHasCapability) != 1:
                err = Fmt" compiler csg: ffi handle graph parameter Symbol carrier mismatch row={effectRow}"
                return false
            expectedCarrierEdgeCount = expectedCarrierEdgeCount + 2
    var observedCarrierEdgeCount: int32
    for edgeIndex in 0..<edges.len:
        let fromIndex = compilerCsgExternFfiHandleGraphNodeIndex(
            nodes, edges[edgeIndex].fromNodeId)
        let toIndex = compilerCsgExternFfiHandleGraphNodeIndex(
            nodes, edges[edgeIndex].toNodeId)
        if fromIndex < 0 || toIndex < 0:
            continue
        let fromFact = nodes[fromIndex].factText
        let toFact = nodes[toIndex].factText
        let fromCarrier =
            fromFact == CompilerCsgExternFfiHandleSymbolFact ||
            fromFact == CompilerCsgExternFfiHandleContractFact ||
            fromFact == CompilerCsgExternFfiHandleParameterFact ||
            fromFact == CompilerCsgExternFfiHandleEffectFact
        let toCarrier =
            toFact == CompilerCsgExternFfiHandleSymbolFact ||
            toFact == CompilerCsgExternFfiHandleContractFact ||
            toFact == CompilerCsgExternFfiHandleParameterFact ||
            toFact == CompilerCsgExternFfiHandleEffectFact
        if fromCarrier || toCarrier:
            observedCarrierEdgeCount = observedCarrierEdgeCount + 1
    if observedCarrierEdgeCount != expectedCarrierEdgeCount:
        err = " compiler csg: ffi handle graph carrier edge coverage mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgExternFfiHandleContractsStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    if !compilerCsgExternFfiHandleContractTableSemanticStrictValidateInto(
           share(csg.parserNormalizedExprReceipt),
           share(csg.typeArena),
           share(csg.semanticGraph),
           share(csg.externFfiHandleContracts),
           err):
        return false
    return compilerCsgExternFfiHandleGraphStrictValidateInto(
        share(csg.semanticGraph),
        share(csg.externFfiHandleContracts),
        csg.nodes,
        csg.edges,
        err)

@borrows
fn compilerCsgExternFfiHandleEffectAppendInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        typeSyntaxSourceStarts: var int32[],
        typeSyntaxRows: var int32[],
        table: var CompilerCsgExternFfiHandleContractTable,
        contractRow: int32,
        sourceId: int32,
        effectKind: int32,
        targetKind: int32,
        parameterOrdinal: int32,
        parameterDeclarationSourceLocalRow: int32,
        functionReturnTypeId: int32,
        err: var str): bool =
    var typeId = functionReturnTypeId
    if targetKind == CompilerCsgExternFfiHandleTargetParameter:
        var typeSyntaxId: int32
        if !compilerCsgExactDeclarationTypeIdInto(
               receipt,
               typeArena,
               typeSyntaxSourceStarts,
               typeSyntaxRows,
               sourceId,
               parameterDeclarationSourceLocalRow,
               typeSyntaxId,
               typeId,
               err):
            return false
    var carrierKind: int32
    var typeCid: layout.FixedBytes32
    if !compilerCsgExternFfiHandleTypeCidInto(
           typeArena, typeId, carrierKind, typeCid, err):
        return false
    var parameterSymbolCid: layout.FixedBytes32
    if targetKind == CompilerCsgExternFfiHandleTargetParameter:
        parameterSymbolCid =
            compilerCsgExternFfiHandleParameterSymbolCid(
                table.functionSymbolCids[contractRow],
                parameterOrdinal,
                typeCid,
                carrierKind)
    let effectCid = compilerCsgExternFfiHandleEffectCid(
        table.functionSymbolCids[contractRow],
        effectKind,
        targetKind,
        parameterOrdinal,
        parameterSymbolCid,
        typeCid,
        carrierKind)
    add(table.effectContractRows, contractRow)
    add(table.effectKinds, effectKind)
    add(table.effectTargetKinds, targetKind)
    add(table.effectParameterOrdinals, parameterOrdinal)
    add(table.effectParameterDeclarationSourceLocalRows,
        parameterDeclarationSourceLocalRow)
    add(table.effectParameterSymbolIds, -1)
    add(table.effectParameterSymbolCids, parameterSymbolCid)
    add(table.effectTypeIds, typeId)
    add(table.effectTypeCids, typeCid)
    add(table.effectAbiCarrierKinds, carrierKind)
    add(table.effectCids, effectCid)
    add(table.effectGraphNodeIds, -1)
    err = ""
    return true

type
    compilerCsgFfiBuildScratch = ref object
        typeSyntaxSourceStarts: int32[]
        typeSyntaxRows: int32[]
        nextNodeId: int32
        firstEdgeId: int32
        candidate: CompilerCsgExternFfiHandleContractTable
        stagedNodes: CompilerCsgNode[]
        stagedEdges: CompilerCsgEdge[]
        graphProjectionNodes: CompilerCsgNode[]

@borrows
fn compilerCsgExternFfiHandleContractTableBuildSourcesRec(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        nodes: var CompilerCsgNode[],
        scratch: compilerCsgFfiBuildScratch,
        sourceId: int32,
        sourceContractRow: int32,
        err: var str): bool =
    while true:
        if sourceId >= receipt.sourceSidecars.len:
            return true
        let sidecar = receipt.sourceSidecars[sourceId]
        if sidecar.ffiHandleContractProducerSourceIds.len == 0:
            sourceId = sourceId + 1
            sourceContractRow = 0
            continue
        if sourceId >= semanticGraph.sourceTable.modulePaths.len:
            err = " compiler csg: ffi handle source module authority missing"
            return false
        let modulePath = semanticGraph.sourceTable.modulePaths[sourceId]
        let moduleNodeId = compilerCsgExternFfiHandleModuleNodeId(
            nodes, modulePath)
        let moduleNodeIndex = compilerCsgExternFfiHandleGraphNodeIndex(
            nodes, moduleNodeId)
        if moduleNodeId <= 0 || moduleNodeIndex < 0:
            err = " compiler csg: ffi handle exact module node missing"
            return false
        if sourceContractRow == 0 &&
           compilerCsgExternFfiHandleGraphNodeIndex(
               scratch.graphProjectionNodes, moduleNodeId) < 0:
            add(scratch.graphProjectionNodes, share(nodes[moduleNodeIndex]))
        if sourceContractRow >= sidecar.ffiHandleContractProducerSourceIds.len:
            sourceId = sourceId + 1
            sourceContractRow = 0
            continue
        let contractRow = scratch.candidate.producerSourceIds.len
        let functionDeclarationSourceLocalRow =
            sidecar.ffiHandleContractFunctionDeclarationSourceLocalRows[
                sourceContractRow]
        var functionSourceLocalRow: int32
        var functionReturnTypeId: int32
        if !compilerCsgExternFfiHandleFunctionAuthorityInto(
               sidecar,
               typeArena,
               semanticGraph,
               sourceId,
               functionDeclarationSourceLocalRow,
               functionSourceLocalRow,
               functionReturnTypeId,
               err):
            return false
        add(scratch.candidate.producerSourceIds, sourceId)
        add(scratch.candidate.functionDeclarationSourceLocalRows,
            functionDeclarationSourceLocalRow)
        add(scratch.candidate.functionSourceLocalRows,
            functionSourceLocalRow)
        add(scratch.candidate.functionSymbolIds, -1)
        add(scratch.candidate.functionSymbolCids,
            compilerCsgExternFfiHandleFunctionSymbolCid(
                sidecar, functionSourceLocalRow))
        add(scratch.candidate.parserContractCids,
            sidecar.ffiHandleParserContractCids[sourceContractRow])
        let unwindKind =
            sidecar.ffiHandleContractUnwindKinds[sourceContractRow]
        if unwindKind != CompilerCsgExternFfiHandleUnwindNoUnwind:
            err = Fmt" compiler csg: ffi handle contract unwind mismatch row={sourceContractRow}"
            return false
        add(scratch.candidate.unwindKinds, unwindKind)
        add(scratch.candidate.effectStarts, scratch.candidate.effectKinds.len)
        add(scratch.candidate.effectCounts, 0)
        add(scratch.candidate.contractCids, layout.FixedBytes32())
        add(scratch.candidate.interfaceCids, layout.FixedBytes32())
        add(scratch.candidate.contractGraphNodeIds, -1)
        let resultEffect =
            sidecar.ffiHandleContractResultEffects[sourceContractRow]
        if resultEffect ==
               Int32(parser.NormalizedFfiHandleEffectProduce) &&
           !compilerCsgExternFfiHandleEffectAppendInto(
               receipt,
               typeArena,
               scratch.typeSyntaxSourceStarts,
               scratch.typeSyntaxRows,
               scratch.candidate,
               contractRow,
               sourceId,
               resultEffect,
               CompilerCsgExternFfiHandleTargetResult,
               -1,
               -1,
               functionReturnTypeId,
               err):
            return false
        let parameterStart =
            sidecar.ffiHandleContractParameterStarts[sourceContractRow]
        let parameterCount =
            sidecar.ffiHandleContractParameterCounts[sourceContractRow]
        for parameterOffset in 0..<parameterCount:
            let parserEffectRow = parameterStart + parameterOffset
            if !compilerCsgExternFfiHandleEffectAppendInto(
                   receipt,
                   typeArena,
                   scratch.typeSyntaxSourceStarts,
                   scratch.typeSyntaxRows,
                   scratch.candidate,
                   contractRow,
                   sourceId,
                   sidecar.ffiHandleParameterEffects[parserEffectRow],
                   CompilerCsgExternFfiHandleTargetParameter,
                   sidecar.ffiHandleParameterOrdinals[parserEffectRow],
                   sidecar.ffiHandleParameterDeclarationSourceLocalRows[
                       parserEffectRow],
                   functionReturnTypeId,
                   err):
                return false
        scratch.candidate.effectCounts[contractRow] =
            scratch.candidate.effectKinds.len -
                scratch.candidate.effectStarts[contractRow]
        scratch.candidate.contractCids[contractRow] =
            compilerCsgExternFfiHandleContractCid(
                scratch.candidate, contractRow)
        scratch.candidate.interfaceCids[contractRow] =
            compilerCsgExternFfiHandleInterfaceCid(
                scratch.candidate.functionSymbolCids[contractRow],
                scratch.candidate.contractCids[contractRow])
        let functionNodeId = scratch.nextNodeId
        scratch.nextNodeId = scratch.nextNodeId + 1
        scratch.candidate.functionSymbolIds[contractRow] = functionNodeId
        add(scratch.stagedNodes,
            compilerCsgExternFfiHandleFunctionNode(
                functionNodeId,
                moduleNodeId,
                modulePath,
                sourceId,
                functionDeclarationSourceLocalRow,
                scratch.candidate.functionSymbolCids[contractRow],
                scratch.candidate.contractCids[contractRow],
                scratch.candidate.interfaceCids[contractRow]))
        compilerCsgExternFfiHandleStagedEdgeAppend(
            scratch.stagedEdges,
            scratch.firstEdgeId,
            moduleNodeId,
            functionNodeId,
            CompilerCsgEdgeKindHasCapability)
        let contractNodeId = scratch.nextNodeId
        scratch.nextNodeId = scratch.nextNodeId + 1
        scratch.candidate.contractGraphNodeIds[contractRow] = contractNodeId
        add(scratch.stagedNodes,
            compilerCsgExternFfiHandleContractNode(
                contractNodeId,
                functionNodeId,
                modulePath,
                sourceId,
                functionDeclarationSourceLocalRow,
                scratch.candidate.functionSymbolCids[contractRow],
                scratch.candidate.contractCids[contractRow],
                scratch.candidate.interfaceCids[contractRow],
                scratch.candidate.effectCounts[contractRow]))
        compilerCsgExternFfiHandleStagedEdgeAppend(
            scratch.stagedEdges,
            scratch.firstEdgeId,
            functionNodeId,
            contractNodeId,
            CompilerCsgEdgeKindHasEffect)
        let effectStart = scratch.candidate.effectStarts[contractRow]
        let effectCount = scratch.candidate.effectCounts[contractRow]
        for effectOffset in 0..<effectCount:
            let effectRow = effectStart + effectOffset
            if scratch.candidate.effectTargetKinds[effectRow] ==
                   CompilerCsgExternFfiHandleTargetParameter:
                let parameterNodeId = scratch.nextNodeId
                scratch.nextNodeId = scratch.nextNodeId + 1
                scratch.candidate.effectParameterSymbolIds[effectRow] =
                    parameterNodeId
                add(scratch.stagedNodes,
                    compilerCsgExternFfiHandleParameterNode(
                        parameterNodeId,
                        functionNodeId,
                        modulePath,
                        sourceId,
                        scratch.candidate.effectParameterDeclarationSourceLocalRows[
                            effectRow],
                        scratch.candidate.effectParameterOrdinals[effectRow],
                        scratch.candidate.functionSymbolCids[contractRow],
                        scratch.candidate.effectParameterSymbolCids[effectRow],
                        scratch.candidate.effectTypeCids[effectRow],
                        scratch.candidate.effectAbiCarrierKinds[effectRow]))
                compilerCsgExternFfiHandleStagedEdgeAppend(
                    scratch.stagedEdges,
                    scratch.firstEdgeId,
                    functionNodeId,
                    parameterNodeId,
                    CompilerCsgEdgeKindHasCapability)
            let effectNodeId = scratch.nextNodeId
            scratch.nextNodeId = scratch.nextNodeId + 1
            scratch.candidate.effectGraphNodeIds[effectRow] = effectNodeId
            var producerDeclarationSourceLocalRow =
                functionDeclarationSourceLocalRow
            if scratch.candidate.effectTargetKinds[effectRow] ==
                   CompilerCsgExternFfiHandleTargetParameter:
                producerDeclarationSourceLocalRow =
                    scratch.candidate.effectParameterDeclarationSourceLocalRows[
                        effectRow]
            add(scratch.stagedNodes,
                compilerCsgExternFfiHandleEffectNode(
                    effectNodeId,
                    contractNodeId,
                    modulePath,
                    sourceId,
                    producerDeclarationSourceLocalRow,
                    scratch.candidate.functionSymbolCids[contractRow],
                    scratch.candidate.effectParameterSymbolCids[effectRow],
                    scratch.candidate.effectTypeCids[effectRow],
                    scratch.candidate.effectCids[effectRow],
                    scratch.candidate.effectKinds[effectRow],
                    scratch.candidate.effectTargetKinds[effectRow],
                    scratch.candidate.effectParameterOrdinals[effectRow],
                    scratch.candidate.effectAbiCarrierKinds[effectRow]))
            compilerCsgExternFfiHandleStagedEdgeAppend(
                scratch.stagedEdges,
                scratch.firstEdgeId,
                contractNodeId,
                effectNodeId,
                CompilerCsgEdgeKindHasEffect)
            if scratch.candidate.effectTargetKinds[effectRow] ==
                   CompilerCsgExternFfiHandleTargetParameter:
                compilerCsgExternFfiHandleStagedEdgeAppend(
                    scratch.stagedEdges,
                    scratch.firstEdgeId,
                    effectNodeId,
                    scratch.candidate.effectParameterSymbolIds[effectRow],
                    CompilerCsgEdgeKindHasCapability)
        sourceContractRow = sourceContractRow + 1
        continue

@borrows
fn compilerCsgExternFfiHandleContractTableBuildInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        nodes: var CompilerCsgNode[],
        edges: var CompilerCsgEdge[],
        out: var CompilerCsgExternFfiHandleContractTable,
        err: var str): bool =
    if out.complete || out.producerSourceIds.len != 0:
        err = " compiler csg: ffi handle snapshot destination is not empty"
        return false
    var scratch: compilerCsgFfiBuildScratch = new(compilerCsgFfiBuildScratch)
    if !compilerCsgExternFfiHandleTypeSyntaxDirectRowsBuildInto(
           receipt,
           typeArena,
           scratch.typeSyntaxSourceStarts,
           scratch.typeSyntaxRows,
           err):
        return false
    if nodes.len <= 0:
        err = " compiler csg: ffi handle graph has no package/module authority"
        return false
    scratch.nextNodeId = nodes[nodes.len - 1].nodeId + 1
    scratch.firstEdgeId = 1
    if edges.len > 0:
        scratch.firstEdgeId = edges[edges.len - 1].edgeId + 1
    if !compilerCsgExternFfiHandleContractTableBuildSourcesRec(
           receipt, typeArena, semanticGraph, nodes, scratch, 0, 0, err):
        return false
    var candidate = scratch.candidate
    var stagedNodes = scratch.stagedNodes
    var stagedEdges = scratch.stagedEdges
    var graphProjectionNodes = scratch.graphProjectionNodes
    var nextNodeId = scratch.nextNodeId
    var firstEdgeId = scratch.firstEdgeId
    candidate.complete = true
    candidate.cargoCid = compilerCsgExternFfiHandleCargoCid(candidate)
    for nodeIndex in 0..<stagedNodes.len:
        add(graphProjectionNodes, share(stagedNodes[nodeIndex]))
    if !compilerCsgExternFfiHandleContractTableSemanticStrictValidateInto(
           receipt,
           typeArena,
           semanticGraph,
           candidate,
           err) ||
       !compilerCsgExternFfiHandleGraphStrictValidateInto(
           semanticGraph,
           candidate,
           graphProjectionNodes,
           stagedEdges,
           err):
        return false
    for nodeIndex in 0..<stagedNodes.len:
        add(nodes, share(stagedNodes[nodeIndex]))
    for edgeIndex in 0..<stagedEdges.len:
        add(edges, stagedEdges[edgeIndex])
    out = candidate
    err = ""
    return true

fn compilerCsgExternFfiHandleCallCapabilityArenaInitInto(
        table: var CompilerCsgExternFfiHandleCallCapabilityTable,
        callCount: int32,
        effectCount: int32,
        err: var str): bool =
    if table.arena.capacityBytes != 0 || callCount < 0 || effectCount < 0:
        err = " compiler csg: ffi handle call capability arena state invalid"
        return false
    let wordCount = Int64(callCount) * Int64(7) +
                    Int64(effectCount) * Int64(10)
    let payloadBytes = wordCount * Int64(4)
    if payloadBytes > Int64(2147483391):
        err = " compiler csg: ffi handle call capability arena overflow"
        return false
    var capacityBytes = Int32(payloadBytes) + 256
    if capacityBytes < 4096:
        capacityBytes = 4096
    table.arena = arenamod.ArenaInitDefault(capacityBytes)
    if !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.callCoordinateKinds, callCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.resolvedCallRows, callCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.callerTypedFunctionIndexes, callCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.typedCallNodeIndexes, callCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.contractRows, callCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectStarts, callCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectCounts, callCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectRows, effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectKinds, effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectTargetKinds, effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectParameterOrdinals, effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectArgumentRows, effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena,
           table.effectArgumentValueNodeIndexes,
           effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectValueDefinitionRows, effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena,
           table.effectGenerationRootValueDefinitionRows,
           effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectExactTypeIds, effectCount) ||
       !arenamod.ArenaArrayInt32ReserveEmpty(
           table.arena, table.effectCarrierKinds, effectCount):
        CompilerCsgExternFfiHandleCallCapabilityTableRelease(table)
        err = " compiler csg: ffi handle call capability arena reserve failed"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleCallContractRowInto(
        contracts: CompilerCsgExternFfiHandleContractTable,
        resolved: CompilerCsgSemanticResolvedCallTable,
        callRow: int32,
        contractRowOut: var int32,
        err: var str): bool =
    contractRowOut = -1
    if callRow < 0 || callRow >= resolved.sourceIndexes.len ||
       !resolved.graphNodeProjectionComplete:
        err = " compiler csg: ffi handle call coordinate invalid"
        return false
    if !resolved.callTargetImportcFlags[callRow]:
        err = ""
        return true
    let producerSourceId =
        resolved.targetProducerSourceIndexes[callRow]
    let declarationRow =
        resolved.targetParserSourceLocalDeclarationRows[callRow]
    for contractRow in 0..<contracts.producerSourceIds.len:
        if contracts.producerSourceIds[contractRow] != producerSourceId ||
           contracts.functionDeclarationSourceLocalRows[contractRow] !=
               declarationRow:
            continue
        if contractRowOut >= 0:
            err = Fmt" compiler csg: ffi handle call contract mapping ambiguous call={callRow}"
            return false
        contractRowOut = contractRow
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleSourceContentCidInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        sourceIndex: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    if sourceIndex < 0 || sourceIndex >= receipt.sourceSidecars.len:
        err = " compiler csg: ffi handle source content coordinate invalid"
        return false
    let sidecar = receipt.sourceSidecars[sourceIndex]
    if sidecar.sourceIndex != sourceIndex ||
       layout.FixedBytes32Equal(
           sidecar.sourceContentRaw32, layout.FixedBytes32()):
        err = " compiler csg: ffi handle source content authority missing"
        return false
    out = layout.FixedBytes32Copy(sidecar.sourceContentRaw32)
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleDefinitionIdentityAppendInto(
        buf: var layout.ByteBuf,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typedIr: texpr.TypedExprIr,
        definitionRow: int32,
        err: var str): bool =
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(typedIr)
    if definitionRow < 0 || definitionRow >= definitionCount:
        err = " compiler csg: ffi handle definition coordinate invalid"
        return false
    let producerSourceIndex =
        texpr.TypedExprValueDefinitionProducerSourceIndexAt(
            typedIr, definitionRow)
    var sourceContentCid: layout.FixedBytes32
    if !compilerCsgExternFfiHandleSourceContentCidInto(
           receipt, producerSourceIndex, sourceContentCid, err):
        return false
    let definingNodeIndex =
        texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
            typedIr, definitionRow)
    if definingNodeIndex < 0 ||
       definingNodeIndex >= typedIr.nodes2_nodeIndexs.len:
        err = " compiler csg: ffi handle defining node coordinate invalid"
        return false
    CompilerCsgAppendFixed32(buf, sourceContentCid)
    CompilerCsgAppendU32BE(buf, definitionRow)
    CompilerCsgAppendU32BE(buf, producerSourceIndex)
    CompilerCsgAppendU32BE(
        buf,
        Int32(texpr.TypedExprValueDefinitionOriginKindAt(
            typedIr, definitionRow)))
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprValueDefinitionSourceLocalNodeIndexAt(
            typedIr, definitionRow))
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprValueDefinitionDeclarationSourceLocalRowAt(
            typedIr, definitionRow))
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprValueDefinitionPatternSourceLocalRowAt(
            typedIr, definitionRow))
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
            typedIr, definitionRow))
    CompilerCsgAppendU32BE(buf, definingNodeIndex)
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprValueDefinitionExactTypeIdAt(
            typedIr, definitionRow))
    CompilerCsgAppendU32BE(
        buf,
        Int32(texpr.TypedExprValueDefinitionOwnershipAt(
            typedIr, definitionRow)))
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprValueDefinitionProofKindAt(
            typedIr, definitionRow))
    CompilerCsgAppendU32BE(
        buf,
        arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_originParserNodeIds,
            definingNodeIndex))
    CompilerCsgAppendU32BE(
        buf, Int32(typedIr.nodes2_opKinds[definingNodeIndex]))
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprIrNodeStructuralTypeIdAt(
            typedIr, definingNodeIndex))
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
            typedIr, definingNodeIndex))
    CompilerCsgAppendU32BE(
        buf,
        texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
            typedIr, definingNodeIndex))
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleDefinitionLineageCidInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typedIr: texpr.TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        typeCid: layout.FixedBytes32,
        leafToRootRows: int32[],
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    if typeArena == nil || leafToRootRows.len <= 0 ||
       layout.FixedBytes32Equal(typeCid, layout.FixedBytes32()):
        err = " compiler csg: ffi handle definition lineage input invalid"
        return false
    var buf = layout.ByteBufInit(256 + leafToRootRows.len * 192)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleDefinitionLineageDomain)
    CompilerCsgAppendFixed32(buf, typeArena.artifactRaw32)
    CompilerCsgAppendFixed32(buf, typeCid)
    CompilerCsgAppendU32BE(buf, leafToRootRows.len)
    var lineageIndex = leafToRootRows.len - 1
    while lineageIndex >= 0:
        if !compilerCsgExternFfiHandleDefinitionIdentityAppendInto(
               buf,
               receipt,
               typedIr,
               leafToRootRows[lineageIndex],
               err):
            layout.ByteBufFree(buf)
            return false
        lineageIndex = lineageIndex - 1
    out = CompilerCsgBufCid(buf)
    if layout.FixedBytes32Equal(out, layout.FixedBytes32()):
        err = " compiler csg: ffi handle definition lineage CID missing"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleExactDefinitionInto(
        typedIr: texpr.TypedExprIr,
        typedFunctionIndex: int32,
        valueNodeIndex: int32,
        expectedTypeId: int32,
        requireProduced: bool,
        definitionRowOut: var int32,
        err: var str): bool =
    definitionRowOut = -1
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= typedIr.functions2_functionNameIds.len:
        err = " compiler csg: ffi handle capability function invalid"
        return false
    let nodeStart = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_nodeStarts,
        typedFunctionIndex)
    let nodeCount = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_nodeCounts,
        typedFunctionIndex)
    if nodeStart < 0 || nodeCount <= 0 ||
       nodeStart > typedIr.nodes2_nodeIndexs.len - nodeCount ||
       valueNodeIndex < nodeStart ||
       valueNodeIndex >= nodeStart + nodeCount:
        err = " compiler csg: ffi handle capability value node owner invalid"
        return false
    let bindingRow =
        texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
            typedIr, valueNodeIndex)
    let producedRow =
        texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
            typedIr, valueNodeIndex)
    if (requireProduced && producedRow < 0) ||
       (!requireProduced && bindingRow >= 0 && producedRow >= 0):
        err = Fmt" compiler csg: ffi handle capability value-definition ambiguous node={valueNodeIndex}"
        return false
    definitionRowOut = requireProduced ? producedRow : bindingRow
    if definitionRowOut < 0:
        definitionRowOut = producedRow
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(typedIr)
    if definitionRowOut < 0 || definitionRowOut >= definitionCount:
        err = Fmt" compiler csg: ffi handle capability value-definition missing node={valueNodeIndex}"
        return false
    let definingNodeIndex =
        texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
            typedIr, definitionRowOut)
    if texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
           typedIr, definitionRowOut) != typedFunctionIndex ||
       definingNodeIndex < nodeStart ||
       definingNodeIndex >= nodeStart + nodeCount ||
       texpr.TypedExprValueDefinitionExactTypeIdAt(
           typedIr, definitionRowOut) != expectedTypeId ||
       texpr.TypedExprIrNodeStructuralTypeIdAt(
           typedIr, valueNodeIndex) != expectedTypeId ||
       texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
           typedIr, definingNodeIndex) != definitionRowOut ||
       (requireProduced && definingNodeIndex != valueNodeIndex):
        err = Fmt" compiler csg: ffi handle capability definition authority mismatch definition={definitionRowOut}"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleGenerationRootIndexFind(
        roots: CompilerCsgExternFfiHandleGenerationRootIndex,
        definitionRow: int32): int32 =
    for rootIndex in 0..<roots.valueDefinitionRows.len:
        if roots.valueDefinitionRows[rootIndex] == definitionRow:
            return rootIndex
    return -1

@borrows
fn compilerCsgExternFfiHandleDefinitionGenerationCid(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typedIr: texpr.TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        contracts: CompilerCsgExternFfiHandleContractTable,
        resolved: CompilerCsgSemanticResolvedCallTable,
        resolvedCallRow: int32,
        typedFunctionIndex: int32,
        typedCallNodeIndex: int32,
        effectRow: int32,
        definitionRow: int32,
        typeCid: layout.FixedBytes32,
        definitionLineageCid: layout.FixedBytes32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    out = layout.FixedBytes32()
    if resolvedCallRow < 0 ||
       resolvedCallRow >= resolved.sourceIndexes.len ||
       effectRow < 0 || effectRow >= contracts.effectCids.len:
        err = " compiler csg: ffi handle generation producer coordinate invalid"
        return false
    var callerSourceContentCid: layout.FixedBytes32
    var targetSourceContentCid: layout.FixedBytes32
    if !compilerCsgExternFfiHandleSourceContentCidInto(
           receipt,
           resolved.sourceIndexes[resolvedCallRow],
           callerSourceContentCid,
           err) ||
       !compilerCsgExternFfiHandleSourceContentCidInto(
           receipt,
           resolved.targetProducerSourceIndexes[resolvedCallRow],
           targetSourceContentCid,
           err):
        return false
    var buf = layout.ByteBufInit(512)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleDefinitionGenerationDomain)
    CompilerCsgAppendFixed32(buf, typeArena.artifactRaw32)
    CompilerCsgAppendFixed32(buf, callerSourceContentCid)
    CompilerCsgAppendFixed32(buf, targetSourceContentCid)
    CompilerCsgAppendU32BE(buf, resolvedCallRow)
    CompilerCsgAppendU32BE(buf, resolved.sourceIndexes[resolvedCallRow])
    CompilerCsgAppendU32BE(
        buf, resolved.originParserNodeIds[resolvedCallRow])
    CompilerCsgAppendU32BE(buf, typedFunctionIndex)
    CompilerCsgAppendU32BE(buf, typedCallNodeIndex)
    CompilerCsgAppendU32BE(buf, effectRow)
    CompilerCsgAppendFixed32(buf, contracts.effectCids[effectRow])
    CompilerCsgAppendU32BE(buf, definitionRow)
    CompilerCsgAppendFixed32(buf, typeCid)
    CompilerCsgAppendFixed32(buf, definitionLineageCid)
    out = CompilerCsgBufCid(buf)
    if layout.FixedBytes32Equal(out, layout.FixedBytes32()):
        err = " compiler csg: ffi handle generation CID missing"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleDefinitionLineageInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typedIr: texpr.TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        roots: CompilerCsgExternFfiHandleGenerationRootIndex,
        typedFunctionIndex: int32,
        definitionRow: int32,
        expectedTypeId: int32,
        expectedTypeCid: layout.FixedBytes32,
        generationRootDefinitionRowOut: var int32,
        generationCidOut: var layout.FixedBytes32,
        definitionLineageCidOut: var layout.FixedBytes32,
        err: var str): bool =
    generationRootDefinitionRowOut = -1
    generationCidOut = layout.FixedBytes32()
    definitionLineageCidOut = layout.FixedBytes32()
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(typedIr)
    var lineageRows: int32[]
    var currentDefinitionRow = definitionRow
    var traversed: int32
    while currentDefinitionRow >= 0 && traversed <= definitionCount:
        if currentDefinitionRow >= definitionCount ||
           texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
               typedIr, currentDefinitionRow) != typedFunctionIndex ||
           texpr.TypedExprValueDefinitionExactTypeIdAt(
               typedIr, currentDefinitionRow) != expectedTypeId:
            freeSeq(lineageRows)
            err = " compiler csg: ffi handle definition lineage authority drift"
            return false
        let definingNodeIndex =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                typedIr, currentDefinitionRow)
        if definingNodeIndex < 0 ||
           definingNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
           texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
               typedIr, definingNodeIndex) != currentDefinitionRow:
            freeSeq(lineageRows)
            err = " compiler csg: ffi handle definition lineage producer drift"
            return false
        add(lineageRows, currentDefinitionRow)
        let rootIndex =
            compilerCsgExternFfiHandleGenerationRootIndexFind(
                roots, currentDefinitionRow)
        if rootIndex >= 0:
            generationRootDefinitionRowOut = currentDefinitionRow
            generationCidOut = layout.FixedBytes32Copy(
                roots.generationCids[rootIndex])
            if !compilerCsgExternFfiHandleDefinitionLineageCidInto(
                   receipt,
                   typedIr,
                   typeArena,
                   expectedTypeCid,
                   lineageRows,
                   definitionLineageCidOut,
                   err):
                freeSeq(lineageRows)
                return false
            if lineageRows.len == 1 &&
               !layout.FixedBytes32Equal(
                   definitionLineageCidOut,
                   roots.definitionLineageCids[rootIndex]):
                freeSeq(lineageRows)
                err = " compiler csg: ffi handle generation root lineage drift"
                return false
            freeSeq(lineageRows)
            err = ""
            return true
        let originKind =
            texpr.TypedExprValueDefinitionOriginKindAt(
                typedIr, currentDefinitionRow)
        if originKind ==
               texpr.TypedExprValueDefinitionOriginParameter:
            freeSeq(lineageRows)
            err = " compiler csg: ffi handle parameter requires exact capability summary"
            return false
        if originKind !=
               texpr.TypedExprValueDefinitionOriginBindingInitializer:
            freeSeq(lineageRows)
            err = " compiler csg: ffi handle definition has no produce generation root"
            return false
        let predecessorDefinitionRow =
            texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
                typedIr, definingNodeIndex)
        if predecessorDefinitionRow < 0 ||
           predecessorDefinitionRow >= currentDefinitionRow:
            freeSeq(lineageRows)
            err = " compiler csg: ffi handle binding initializer lineage missing"
            return false
        currentDefinitionRow = predecessorDefinitionRow
        traversed = traversed + 1
    freeSeq(lineageRows)
    err = " compiler csg: ffi handle definition lineage cycle"
    return false

@borrows
fn compilerCsgExternFfiHandleGenerationRootIndexBuildInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        typedIr: texpr.TypedExprIr,
        resolved: CompilerCsgSemanticResolvedCallTable,
        contracts: CompilerCsgExternFfiHandleContractTable,
        out: var CompilerCsgExternFfiHandleGenerationRootIndex,
        err: var str): bool =
    if out.valueDefinitionRows.len != 0 ||
       out.valueDefinitionRows.cap != 0 ||
       out.resolvedCallRows.len != 0 || out.resolvedCallRows.cap != 0 ||
       out.effectRows.len != 0 || out.effectRows.cap != 0 ||
       out.generationCids.len != 0 || out.generationCids.cap != 0 ||
       out.definitionLineageCids.len != 0 ||
       out.definitionLineageCids.cap != 0:
        err = " compiler csg: ffi handle generation root destination is not empty"
        return false
    var candidate: CompilerCsgExternFfiHandleGenerationRootIndex
    for resolvedCallRow in 0..<resolved.sourceIndexes.len:
        var contractRow: int32
        if !compilerCsgExternFfiHandleCallContractRowInto(
               contracts,
               resolved,
               resolvedCallRow,
               contractRow,
               err):
            compilerCsgExternFfiHandleGenerationRootIndexRelease(candidate)
            return false
        if contractRow < 0:
            continue
        let typedFunctionIndex = resolved.functionIndexes[resolvedCallRow]
        let typedCallNodeIndex =
            resolved.typedCallNodeIndexes[resolvedCallRow]
        let effectStart = contracts.effectStarts[contractRow]
        let effectCount = contracts.effectCounts[contractRow]
        if effectStart < 0 || effectCount <= 0 ||
           effectStart > contracts.effectCids.len - effectCount:
            compilerCsgExternFfiHandleGenerationRootIndexRelease(candidate)
            err = " compiler csg: ffi handle generation root effect range invalid"
            return false
        for effectRow in effectStart..<effectStart + effectCount:
            if contracts.effectTargetKinds[effectRow] !=
                   CompilerCsgExternFfiHandleTargetResult:
                continue
            if contracts.effectKinds[effectRow] !=
                   CompilerCsgEffectExternFfiHandleProduce ||
               contracts.effectParameterOrdinals[effectRow] != -1:
                compilerCsgExternFfiHandleGenerationRootIndexRelease(
                    candidate)
                err = " compiler csg: ffi handle generation root is not produce"
                return false
            var definitionRow: int32
            if !compilerCsgExternFfiHandleExactDefinitionInto(
                   typedIr,
                   typedFunctionIndex,
                   typedCallNodeIndex,
                   contracts.effectTypeIds[effectRow],
                   true,
                   definitionRow,
                   err):
                compilerCsgExternFfiHandleGenerationRootIndexRelease(
                    candidate)
                return false
            if compilerCsgExternFfiHandleGenerationRootIndexFind(
                   candidate, definitionRow) >= 0:
                compilerCsgExternFfiHandleGenerationRootIndexRelease(
                    candidate)
                err = " compiler csg: ffi handle produce definition duplicated"
                return false
            var rootRows: int32[]
            add(rootRows, definitionRow)
            var definitionLineageCid: layout.FixedBytes32
            if !compilerCsgExternFfiHandleDefinitionLineageCidInto(
                   receipt,
                   typedIr,
                   typeArena,
                   contracts.effectTypeCids[effectRow],
                   rootRows,
                   definitionLineageCid,
                   err):
                freeSeq(rootRows)
                compilerCsgExternFfiHandleGenerationRootIndexRelease(
                    candidate)
                return false
            freeSeq(rootRows)
            var generationCid: layout.FixedBytes32
            if !compilerCsgExternFfiHandleDefinitionGenerationCid(
                   receipt,
                   typedIr,
                   typeArena,
                   contracts,
                   resolved,
                   resolvedCallRow,
                   typedFunctionIndex,
                   typedCallNodeIndex,
                   effectRow,
                   definitionRow,
                   contracts.effectTypeCids[effectRow],
                   definitionLineageCid,
                   generationCid,
                   err):
                compilerCsgExternFfiHandleGenerationRootIndexRelease(
                    candidate)
                return false
            for priorRoot in 0..<candidate.generationCids.len:
                if layout.FixedBytes32Equal(
                       candidate.generationCids[priorRoot],
                       generationCid):
                    compilerCsgExternFfiHandleGenerationRootIndexRelease(
                        candidate)
                    err = " compiler csg: ffi handle generation CID collision"
                    return false
            add(candidate.valueDefinitionRows, definitionRow)
            add(candidate.resolvedCallRows, resolvedCallRow)
            add(candidate.effectRows, effectRow)
            add(candidate.generationCids, generationCid)
            add(candidate.definitionLineageCids, definitionLineageCid)
    let rootCount = candidate.valueDefinitionRows.len
    if candidate.resolvedCallRows.len != rootCount ||
       candidate.effectRows.len != rootCount ||
       candidate.generationCids.len != rootCount ||
       candidate.definitionLineageCids.len != rootCount:
        compilerCsgExternFfiHandleGenerationRootIndexRelease(candidate)
        err = " compiler csg: ffi handle generation root columns mismatch"
        return false
    out = candidate
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleCallArgumentBindingReplayInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typedIr: texpr.TypedExprIr,
        resolved: CompilerCsgSemanticResolvedCallTable,
        resolvedCallRow: int32,
        parameterOrdinal: int32,
        expectedParameterDeclarationRow: int32,
        argumentRowOut: var int32,
        valueNodeIndexOut: var int32,
        bindingCidOut: var layout.FixedBytes32,
        err: var str): bool =
    argumentRowOut = -1
    valueNodeIndexOut = -1
    bindingCidOut = layout.FixedBytes32()
    if resolvedCallRow < 0 ||
       resolvedCallRow >= resolved.sourceIndexes.len ||
       parameterOrdinal < 0 ||
       parameterOrdinal >= resolved.callArgCounts[resolvedCallRow]:
        err = " compiler csg: ffi handle argument replay coordinate invalid"
        return false
    let targetSourceIndex =
        resolved.targetProducerSourceIndexes[resolvedCallRow]
    let targetFunctionDeclarationRow =
        resolved.targetParserSourceLocalDeclarationRows[resolvedCallRow]
    if targetSourceIndex < 0 ||
       targetSourceIndex >= receipt.sourceSidecars.len:
        err = " compiler csg: ffi handle argument target source missing"
        return false
    let targetSidecar = receipt.sourceSidecars[targetSourceIndex]
    if expectedParameterDeclarationRow < 0 ||
       expectedParameterDeclarationRow >= targetSidecar.declarationKinds.len ||
       targetSidecar.declarationKinds[expectedParameterDeclarationRow] !=
           Int32(parser.ParserDeclarationParameter) ||
       targetSidecar.declarationOwnerIds[expectedParameterDeclarationRow] !=
           targetFunctionDeclarationRow:
        err = " compiler csg: ffi handle argument target parameter invalid"
        return false
    let argumentRow =
        resolved.callArgumentStarts[resolvedCallRow] + parameterOrdinal
    if argumentRow < 0 ||
       argumentRow >= resolved.callArgumentBindingIds.len:
        err = " compiler csg: ffi handle argument binding row missing"
        return false
    var expectedArgLinkNodeIndex = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.nodes2_operand0NodeIndexs,
        resolved.typedCallNodeIndexes[resolvedCallRow])
    var replayOrdinal: int32
    while replayOrdinal < parameterOrdinal:
        if expectedArgLinkNodeIndex < 0 ||
           expectedArgLinkNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
           typedIr.nodes2_opKinds[expectedArgLinkNodeIndex] !=
               texpr.TypedExprIrOpArgLink:
            err = " compiler csg: ffi handle argument chain truncated"
            return false
        expectedArgLinkNodeIndex = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_operand1NodeIndexs,
            expectedArgLinkNodeIndex)
        replayOrdinal = replayOrdinal + 1
    let argLinkNodeIndex =
        resolved.callArgumentArgLinkNodeIndexes[argumentRow]
    let valueNodeIndex =
        resolved.callArgumentValueNodeIndexes[argumentRow]
    if argLinkNodeIndex != expectedArgLinkNodeIndex ||
       argLinkNodeIndex < 0 ||
       argLinkNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       valueNodeIndex < 0 || valueNodeIndex >= argLinkNodeIndex ||
       typedIr.nodes2_opKinds[argLinkNodeIndex] !=
           texpr.TypedExprIrOpArgLink ||
       arenamod.ArenaArrayInt32Get(
           typedIr.arena,
           typedIr.nodes2_operand0NodeIndexs,
           argLinkNodeIndex) != valueNodeIndex:
        err = " compiler csg: ffi handle argument parser-origin link invalid"
        return false
    let parameterMutable =
        targetSidecar.declarationMutableFlags[
            expectedParameterDeclarationRow]
    let expectedBindingCid = CompilerCsgCallArgumentBindingCid(
        resolvedCallRow,
        resolved.sourceIndexes[resolvedCallRow],
        resolved.originParserNodeIds[resolvedCallRow],
        resolved.functionIndexes[resolvedCallRow],
        resolved.typedCallNodeIndexes[resolvedCallRow],
        targetSourceIndex,
        targetFunctionDeclarationRow,
        argumentRow,
        parameterOrdinal,
        argLinkNodeIndex,
        valueNodeIndex,
        expectedParameterDeclarationRow,
        parameterMutable)
    if resolved.callArgumentBindingIds[argumentRow] != argumentRow ||
       resolved.callArgumentCallRows[argumentRow] != resolvedCallRow ||
       resolved.callArgumentOrdinals[argumentRow] != parameterOrdinal ||
       resolved.callArgumentTargetParameterDeclarationRows[
           argumentRow] != expectedParameterDeclarationRow ||
       resolved.callArgumentTargetParameterMutableFlags[argumentRow] !=
           parameterMutable ||
       !layout.FixedBytes32Equal(
           resolved.callArgumentBindingCids[argumentRow],
           expectedBindingCid):
        err = " compiler csg: ffi handle argument binding replay mismatch"
        return false
    argumentRowOut = argumentRow
    valueNodeIndexOut = valueNodeIndex
    bindingCidOut = expectedBindingCid
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleCallEffectCapabilityCid(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        contracts: CompilerCsgExternFfiHandleContractTable,
        resolved: CompilerCsgSemanticResolvedCallTable,
        resolvedCallRow: int32,
        callerTypedFunctionIndex: int32,
        typedCallNodeIndex: int32,
        effectRow: int32,
        argumentRow: int32,
        argumentBindingCid: layout.FixedBytes32,
        argumentValueNodeIndex: int32,
        valueDefinitionRow: int32,
        generationRootValueDefinitionRow: int32,
        generationCid: layout.FixedBytes32,
        definitionLineageCid: layout.FixedBytes32): layout.FixedBytes32 =
    var callerSourceContentCid: layout.FixedBytes32
    var sourceErr: str
    if !compilerCsgExternFfiHandleSourceContentCidInto(
           receipt,
           resolved.sourceIndexes[resolvedCallRow],
           callerSourceContentCid,
           sourceErr):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(480)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleCallEffectCapabilityDomain)
    CompilerCsgAppendU32BE(
        buf, CompilerCsgExternFfiHandleCallCoordinateResolvedCallRow)
    CompilerCsgAppendU32BE(buf, resolvedCallRow)
    CompilerCsgAppendFixed32(buf, callerSourceContentCid)
    CompilerCsgAppendU32BE(buf, callerTypedFunctionIndex)
    CompilerCsgAppendU32BE(buf, typedCallNodeIndex)
    CompilerCsgAppendU32BE(buf, effectRow)
    CompilerCsgAppendU32BE(buf, contracts.effectKinds[effectRow])
    CompilerCsgAppendU32BE(buf, contracts.effectTargetKinds[effectRow])
    CompilerCsgAppendU32BE(
        buf, contracts.effectParameterOrdinals[effectRow])
    CompilerCsgAppendU32BE(buf, argumentRow)
    CompilerCsgAppendFixed32(buf, argumentBindingCid)
    CompilerCsgAppendU32BE(buf, argumentValueNodeIndex)
    CompilerCsgAppendU32BE(buf, valueDefinitionRow)
    CompilerCsgAppendU32BE(
        buf, generationRootValueDefinitionRow)
    CompilerCsgAppendU32BE(buf, contracts.effectTypeIds[effectRow])
    CompilerCsgAppendFixed32(buf, contracts.effectTypeCids[effectRow])
    CompilerCsgAppendU32BE(
        buf, contracts.effectAbiCarrierKinds[effectRow])
    CompilerCsgAppendFixed32(buf, contracts.effectCids[effectRow])
    CompilerCsgAppendFixed32(buf, generationCid)
    CompilerCsgAppendFixed32(buf, definitionLineageCid)
    CompilerCsgAppendU32BE(
        buf, resolved.originParserNodeIds[resolvedCallRow])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgExternFfiHandleCallCapabilityCid(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        contracts: CompilerCsgExternFfiHandleContractTable,
        resolved: CompilerCsgSemanticResolvedCallTable,
        table: CompilerCsgExternFfiHandleCallCapabilityTable,
        callRow: int32): layout.FixedBytes32 =
    let resolvedCallRow = arenamod.ArenaArrayInt32Get(
        table.arena, table.resolvedCallRows, callRow)
    let contractRow = arenamod.ArenaArrayInt32Get(
        table.arena, table.contractRows, callRow)
    let effectStart = arenamod.ArenaArrayInt32Get(
        table.arena, table.effectStarts, callRow)
    let effectCount = arenamod.ArenaArrayInt32Get(
        table.arena, table.effectCounts, callRow)
    var callerSourceContentCid: layout.FixedBytes32
    var targetSourceContentCid: layout.FixedBytes32
    var sourceErr: str
    if !compilerCsgExternFfiHandleSourceContentCidInto(
           receipt,
           resolved.sourceIndexes[resolvedCallRow],
           callerSourceContentCid,
           sourceErr) ||
       !compilerCsgExternFfiHandleSourceContentCidInto(
           receipt,
           resolved.targetProducerSourceIndexes[resolvedCallRow],
           targetSourceContentCid,
           sourceErr):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(416 + effectCount * 32)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleCallCapabilityDomain)
    CompilerCsgAppendU32BE(
        buf,
        arenamod.ArenaArrayInt32Get(
            table.arena, table.callCoordinateKinds, callRow))
    CompilerCsgAppendU32BE(buf, resolvedCallRow)
    CompilerCsgAppendFixed32(buf, callerSourceContentCid)
    CompilerCsgAppendFixed32(buf, targetSourceContentCid)
    CompilerCsgAppendU32BE(
        buf,
        arenamod.ArenaArrayInt32Get(
            table.arena, table.callerTypedFunctionIndexes, callRow))
    CompilerCsgAppendU32BE(
        buf,
        arenamod.ArenaArrayInt32Get(
            table.arena, table.typedCallNodeIndexes, callRow))
    CompilerCsgAppendU32BE(buf, resolved.originParserNodeIds[resolvedCallRow])
    CompilerCsgAppendU32BE(
        buf, resolved.targetProducerSourceIndexes[resolvedCallRow])
    CompilerCsgAppendU32BE(
        buf,
        resolved.targetParserSourceLocalDeclarationRows[resolvedCallRow])
    CompilerCsgAppendU32BE(buf, contractRow)
    CompilerCsgAppendFixed32(buf, contracts.contractCids[contractRow])
    CompilerCsgAppendFixed32(buf, contracts.interfaceCids[contractRow])
    CompilerCsgAppendFixed32(buf, contracts.cargoCid)
    CompilerCsgAppendU32BE(buf, effectCount)
    for effectIndex in effectStart..<effectStart + effectCount:
        CompilerCsgAppendFixed32(
            buf, table.effectCapabilityCids[effectIndex])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgExternFfiHandleCallCargoCid(
        table: CompilerCsgExternFfiHandleCallCapabilityTable):
            layout.FixedBytes32 =
    var sorted = CompilerCsgCloneFixed32Seq(table.callCapabilityCids)
    for row in 1..<sorted.len:
        let current = sorted[row]
        var prior = row - 1
        while prior >= 0 &&
              compilerCsgExternFfiHandleFixed32Less(
                  current, sorted[prior]):
            sorted[prior + 1] = sorted[prior]
            prior = prior - 1
        sorted[prior + 1] = current
    var buf = layout.ByteBufInit(192 + sorted.len * 32)
    compilerCsgExternFfiHandlePortablePreamble(
        buf, CompilerCsgExternFfiHandleCallCargoDomain)
    CompilerCsgAppendU32BE(buf, sorted.len)
    for row in 0..<sorted.len:
        CompilerCsgAppendFixed32(buf, sorted[row])
    return CompilerCsgBufCid(buf)

fn compilerCsgExternFfiHandleCallCapabilityBuildAbort(
        candidate: var CompilerCsgExternFfiHandleCallCapabilityTable,
        roots: var CompilerCsgExternFfiHandleGenerationRootIndex): bool =
    CompilerCsgExternFfiHandleCallCapabilityTableRelease(candidate)
    compilerCsgExternFfiHandleGenerationRootIndexRelease(roots)
    return false

@borrows
fn compilerCsgExternFfiHandleCallCapabilityBuildCandidateInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        typedIr: texpr.TypedExprIr,
        semanticGraph: CompilerCsgSemanticGraph,
        contracts: CompilerCsgExternFfiHandleContractTable,
        out: var CompilerCsgExternFfiHandleCallCapabilityTable,
        err: var str): bool =
    let resolved = semanticGraph.resolvedCallTable
    if typeArena == nil || !contracts.complete ||
       !resolved.graphNodeProjectionComplete ||
       !compilerCsgExternFfiHandleCallCapabilityTableEmpty(out):
        err = " compiler csg: ffi handle call capability build authority missing"
        return false
    let parserVerify =
        parser_receipt.ParserNormalizedExprReceiptVerify(receipt)
    if IsErr(parserVerify):
        err = Error(parserVerify)
        return false
    if !CompilerCsgSemanticResolvedCallTableValidate(
           resolved,
           typedIr.functions2_functionNameIds.len,
           err) ||
       !CompilerCsgSemanticResolvedCallParserOriginsStrictValidateInto(
           resolved, receipt, err) ||
       !texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
           typedIr, err) ||
       !compilerCsgExternFfiHandleContractTableSemanticStrictValidateInto(
           share(receipt),
           share(typeArena),
           share(semanticGraph),
           share(contracts),
           err):
        return false
    var roots: CompilerCsgExternFfiHandleGenerationRootIndex
    if !compilerCsgExternFfiHandleGenerationRootIndexBuildInto(
           receipt,
           typeArena,
           typedIr,
           resolved,
           contracts,
           roots,
           err):
        return false
    var callCount: int32
    var effectCount: int32
    for resolvedCallRow in 0..<resolved.sourceIndexes.len:
        var contractRow: int32
        if !compilerCsgExternFfiHandleCallContractRowInto(
               contracts,
               resolved,
               resolvedCallRow,
               contractRow,
               err):
            compilerCsgExternFfiHandleGenerationRootIndexRelease(roots)
            return false
        if contractRow < 0:
            continue
        let contractEffectCount = contracts.effectCounts[contractRow]
        if contractEffectCount <= 0 ||
           callCount >= 2147483647 ||
           effectCount > 2147483647 - contractEffectCount:
            err = Fmt" compiler csg: ffi handle call capability census invalid call={resolvedCallRow}"
            compilerCsgExternFfiHandleGenerationRootIndexRelease(roots)
            return false
        callCount = callCount + 1
        effectCount = effectCount + contractEffectCount
    var candidate: CompilerCsgExternFfiHandleCallCapabilityTable
    if !compilerCsgExternFfiHandleCallCapabilityArenaInitInto(
           candidate, callCount, effectCount, err):
        compilerCsgExternFfiHandleGenerationRootIndexRelease(roots)
        return false
    for resolvedCallRow in 0..<resolved.sourceIndexes.len:
        var contractRow: int32
        if !compilerCsgExternFfiHandleCallContractRowInto(
               contracts,
               resolved,
               resolvedCallRow,
               contractRow,
               err):
            return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                candidate, roots)
        if contractRow < 0:
            continue
        let callerTypedFunctionIndex =
            resolved.functionIndexes[resolvedCallRow]
        let typedCallNodeIndex =
            resolved.typedCallNodeIndexes[resolvedCallRow]
        let callEffectStart = candidate.effectRows.len
        let callEffectCount = contracts.effectCounts[contractRow]
        if callerTypedFunctionIndex < 0 ||
           callerTypedFunctionIndex >=
               typedIr.functions2_functionNameIds.len:
            err = Fmt" compiler csg: ffi handle call owner invalid call={resolvedCallRow}"
            return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                candidate, roots)
        let callerNodeStart = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.functions2_nodeStarts,
            callerTypedFunctionIndex)
        let callerNodeCount = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.functions2_nodeCounts,
            callerTypedFunctionIndex)
        if callerNodeStart < 0 || callerNodeCount <= 0 ||
           callerNodeStart >
               typedIr.nodes2_nodeIndexs.len - callerNodeCount ||
           typedCallNodeIndex < callerNodeStart ||
           typedCallNodeIndex >= callerNodeStart + callerNodeCount ||
           typedIr.nodes2_opKinds[typedCallNodeIndex] !=
               texpr.TypedExprIrOpCallExpr ||
           callEffectCount <= 0 ||
           contracts.unwindKinds[contractRow] !=
               CompilerCsgExternFfiHandleUnwindNoUnwind:
            err = Fmt" compiler csg: ffi handle call authority invalid call={resolvedCallRow}"
            return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                candidate, roots)
        arenamod.ArenaArrayInt32AddReserved(
            candidate.arena,
            candidate.callCoordinateKinds,
            CompilerCsgExternFfiHandleCallCoordinateResolvedCallRow)
        arenamod.ArenaArrayInt32AddReserved(
            candidate.arena,
            candidate.resolvedCallRows,
            resolvedCallRow)
        arenamod.ArenaArrayInt32AddReserved(
            candidate.arena,
            candidate.callerTypedFunctionIndexes,
            callerTypedFunctionIndex)
        arenamod.ArenaArrayInt32AddReserved(
            candidate.arena,
            candidate.typedCallNodeIndexes,
            typedCallNodeIndex)
        arenamod.ArenaArrayInt32AddReserved(
            candidate.arena, candidate.contractRows, contractRow)
        arenamod.ArenaArrayInt32AddReserved(
            candidate.arena,
            candidate.effectStarts,
            callEffectStart)
        arenamod.ArenaArrayInt32AddReserved(
            candidate.arena,
            candidate.effectCounts,
            callEffectCount)
        let contractEffectStart = contracts.effectStarts[contractRow]
        for effectOffset in 0..<callEffectCount:
            let effectRow = contractEffectStart + effectOffset
            let effectKind = contracts.effectKinds[effectRow]
            let targetKind = contracts.effectTargetKinds[effectRow]
            let parameterOrdinal =
                contracts.effectParameterOrdinals[effectRow]
            var argumentRow: int32 = -1
            var argumentValueNodeIndex = typedCallNodeIndex
            var argumentBindingCid: layout.FixedBytes32
            var requireProduced = true
            if targetKind ==
                   CompilerCsgExternFfiHandleTargetResult:
                if effectKind !=
                       CompilerCsgEffectExternFfiHandleProduce ||
                   parameterOrdinal != -1:
                    err = Fmt" compiler csg: ffi handle result effect invalid effect={effectRow}"
                    return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                        candidate, roots)
            elif targetKind ==
                     CompilerCsgExternFfiHandleTargetParameter:
                if (effectKind !=
                        CompilerCsgEffectExternFfiHandleBorrow &&
                    effectKind !=
                        CompilerCsgEffectExternFfiHandleConsume) ||
                   parameterOrdinal < 0 ||
                   parameterOrdinal >=
                       resolved.callArgCounts[resolvedCallRow]:
                    err = Fmt" compiler csg: ffi handle parameter effect invalid effect={effectRow}"
                    return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                        candidate, roots)
                if !compilerCsgExternFfiHandleCallArgumentBindingReplayInto(
                       receipt,
                       typedIr,
                       resolved,
                       resolvedCallRow,
                       parameterOrdinal,
                       contracts.
                           effectParameterDeclarationSourceLocalRows[
                               effectRow],
                       argumentRow,
                       argumentValueNodeIndex,
                       argumentBindingCid,
                       err):
                    return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                        candidate, roots)
                requireProduced = false
            else:
                err = Fmt" compiler csg: ffi handle effect target invalid effect={effectRow}"
                return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                    candidate, roots)
            var definitionRow: int32
            if !compilerCsgExternFfiHandleExactDefinitionInto(
                   typedIr,
                   callerTypedFunctionIndex,
                   argumentValueNodeIndex,
                   contracts.effectTypeIds[effectRow],
                   requireProduced,
                   definitionRow,
                   err):
                return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                    candidate, roots)
            var generationRootDefinitionRow: int32
            var generationCid: layout.FixedBytes32
            var definitionLineageCid: layout.FixedBytes32
            if !compilerCsgExternFfiHandleDefinitionLineageInto(
                   receipt,
                   typedIr,
                   typeArena,
                   roots,
                   callerTypedFunctionIndex,
                   definitionRow,
                   contracts.effectTypeIds[effectRow],
                   contracts.effectTypeCids[effectRow],
                   generationRootDefinitionRow,
                   generationCid,
                   definitionLineageCid,
                   err):
                return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                    candidate, roots)
            let capabilityCid =
                compilerCsgExternFfiHandleCallEffectCapabilityCid(
                    receipt,
                    contracts,
                    resolved,
                    resolvedCallRow,
                    callerTypedFunctionIndex,
                    typedCallNodeIndex,
                    effectRow,
                    argumentRow,
                    argumentBindingCid,
                    argumentValueNodeIndex,
                    definitionRow,
                    generationRootDefinitionRow,
                    generationCid,
                    definitionLineageCid)
            if generationRootDefinitionRow < 0 ||
               layout.FixedBytes32Equal(
                   capabilityCid, layout.FixedBytes32()):
                err = " compiler csg: ffi handle effect capability CID missing"
                return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                    candidate, roots)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena, candidate.effectRows, effectRow)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena, candidate.effectKinds, effectKind)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena,
                candidate.effectTargetKinds,
                targetKind)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena,
                candidate.effectParameterOrdinals,
                parameterOrdinal)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena,
                candidate.effectArgumentRows,
                argumentRow)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena,
                candidate.effectArgumentValueNodeIndexes,
                argumentValueNodeIndex)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena,
                candidate.effectValueDefinitionRows,
                definitionRow)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena,
                candidate.effectGenerationRootValueDefinitionRows,
                generationRootDefinitionRow)
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena,
                candidate.effectExactTypeIds,
                contracts.effectTypeIds[effectRow])
            arenamod.ArenaArrayInt32AddReserved(
                candidate.arena,
                candidate.effectCarrierKinds,
                contracts.effectAbiCarrierKinds[effectRow])
            add(candidate.effectArgumentBindingCids, argumentBindingCid)
            add(candidate.effectTypeCids, contracts.effectTypeCids[effectRow])
            add(candidate.effectGenerationCids, generationCid)
            add(candidate.effectDefinitionLineageCids,
                definitionLineageCid)
            add(candidate.effectCapabilityCids, capabilityCid)
        let callIndex = candidate.callCapabilityCids.len
        let callCapabilityCid =
            compilerCsgExternFfiHandleCallCapabilityCid(
                receipt,
                contracts,
                resolved,
                candidate,
                callIndex)
        if layout.FixedBytes32Equal(
               callCapabilityCid, layout.FixedBytes32()):
            err = " compiler csg: ffi handle call capability CID missing"
            return compilerCsgExternFfiHandleCallCapabilityBuildAbort(
                candidate, roots)
        add(candidate.callCapabilityCids, callCapabilityCid)
    candidate.complete = true
    candidate.cargoCid =
        compilerCsgExternFfiHandleCallCargoCid(candidate)
    compilerCsgExternFfiHandleGenerationRootIndexRelease(roots)
    if layout.FixedBytes32Equal(
           candidate.cargoCid, layout.FixedBytes32()):
        CompilerCsgExternFfiHandleCallCapabilityTableRelease(candidate)
        err = " compiler csg: ffi handle call capability cargo CID missing"
        return false
    out = candidate
    err = ""
    return true

@borrows
fn compilerCsgArenaInt32ColumnsEqual(
        leftArena: arenamod.Arena,
        left: arenamod.ArenaArrayInt32,
        rightArena: arenamod.Arena,
        right: arenamod.ArenaArrayInt32): bool =
    if left.len != right.len:
        return false
    for row in 0..<left.len:
        if arenamod.ArenaArrayInt32Get(leftArena, left, row) !=
           arenamod.ArenaArrayInt32Get(rightArena, right, row):
            return false
    return true

@borrows
fn compilerCsgFixed32ColumnsEqual(
        left: layout.FixedBytes32[],
        right: layout.FixedBytes32[]): bool =
    if left.len != right.len:
        return false
    for row in 0..<left.len:
        if !layout.FixedBytes32Equal(left[row], right[row]):
            return false
    return true

@borrows
fn compilerCsgExternFfiHandleCallCapabilityTableEqual(
        left: CompilerCsgExternFfiHandleCallCapabilityTable,
        right: CompilerCsgExternFfiHandleCallCapabilityTable): bool =
    if left.complete != right.complete ||
       !layout.FixedBytes32Equal(left.cargoCid, right.cargoCid):
        return false
    return compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.callCoordinateKinds,
               right.arena,
               right.callCoordinateKinds) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.resolvedCallRows,
               right.arena,
               right.resolvedCallRows) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.callerTypedFunctionIndexes,
               right.arena,
               right.callerTypedFunctionIndexes) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.typedCallNodeIndexes,
               right.arena,
               right.typedCallNodeIndexes) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.contractRows,
               right.arena,
               right.contractRows) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectStarts,
               right.arena,
               right.effectStarts) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectCounts,
               right.arena,
               right.effectCounts) &&
           compilerCsgFixed32ColumnsEqual(
               left.callCapabilityCids,
               right.callCapabilityCids) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectRows,
               right.arena,
               right.effectRows) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectKinds,
               right.arena,
               right.effectKinds) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectTargetKinds,
               right.arena,
               right.effectTargetKinds) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectParameterOrdinals,
               right.arena,
               right.effectParameterOrdinals) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectArgumentRows,
               right.arena,
               right.effectArgumentRows) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectArgumentValueNodeIndexes,
               right.arena,
               right.effectArgumentValueNodeIndexes) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectValueDefinitionRows,
               right.arena,
               right.effectValueDefinitionRows) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectGenerationRootValueDefinitionRows,
               right.arena,
               right.effectGenerationRootValueDefinitionRows) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectExactTypeIds,
               right.arena,
               right.effectExactTypeIds) &&
           compilerCsgArenaInt32ColumnsEqual(
               left.arena,
               left.effectCarrierKinds,
               right.arena,
               right.effectCarrierKinds) &&
           compilerCsgFixed32ColumnsEqual(
               left.effectArgumentBindingCids,
               right.effectArgumentBindingCids) &&
           compilerCsgFixed32ColumnsEqual(
               left.effectTypeCids,
               right.effectTypeCids) &&
           compilerCsgFixed32ColumnsEqual(
               left.effectGenerationCids,
               right.effectGenerationCids) &&
           compilerCsgFixed32ColumnsEqual(
               left.effectDefinitionLineageCids,
               right.effectDefinitionLineageCids) &&
           compilerCsgFixed32ColumnsEqual(
               left.effectCapabilityCids,
               right.effectCapabilityCids)

@borrows
fn compilerCsgArenaInt32ColumnShapeValid(
        arena: arenamod.Arena,
        column: arenamod.ArenaArrayInt32): bool =
    if column.capacity == 0:
        return column.offset == 0 && column.len == 0 &&
               column.generation == 0
    if column.offset < 0 || column.len < 0 ||
       column.len > column.capacity ||
       column.generation != arena.generation:
        return false
    let endOffset = Int64(column.offset) +
                    Int64(column.capacity) * Int64(4)
    return endOffset <= Int64(arena.usedBytes)

@borrows
fn compilerCsgArenaInt32ColumnCapacityExact(
        column: arenamod.ArenaArrayInt32,
        expectedLen: int32): bool =
    if expectedLen == 0:
        return column.len == 0 && column.capacity == 0
    return column.len == expectedLen &&
           column.capacity == expectedLen

@borrows
fn compilerCsgExternFfiHandleCallCapabilityTableShapeValid(
        table: CompilerCsgExternFfiHandleCallCapabilityTable): bool =
    if table.arena.capacityBytes <= 0 || !table.complete ||
       layout.FixedBytes32Equal(table.cargoCid, layout.FixedBytes32()):
        return false
    if !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.callCoordinateKinds) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.resolvedCallRows) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.callerTypedFunctionIndexes) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.typedCallNodeIndexes) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.contractRows) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectStarts) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectCounts) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectRows) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectKinds) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectTargetKinds) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectParameterOrdinals) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectArgumentRows) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectArgumentValueNodeIndexes) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectValueDefinitionRows) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena,
           table.effectGenerationRootValueDefinitionRows) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectExactTypeIds) ||
       !compilerCsgArenaInt32ColumnShapeValid(
           table.arena, table.effectCarrierKinds):
        return false
    let callCount = table.resolvedCallRows.len
    let effectCount = table.effectRows.len
    let expectedUsedBytes = Int64(callCount) * Int64(7 * 4) +
                            Int64(effectCount) * Int64(10 * 4)
    if expectedUsedBytes > Int64(2147483391):
        return false
    var expectedCapacityBytes = Int32(expectedUsedBytes) + 256
    if expectedCapacityBytes < 4096:
        expectedCapacityBytes = 4096
    if table.arena.usedBytes != Int32(expectedUsedBytes) ||
       table.arena.capacityBytes != expectedCapacityBytes ||
       table.arena.alignmentBytes != 8 ||
       table.arena.generation != 1 ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.callCoordinateKinds, callCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.resolvedCallRows, callCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.callerTypedFunctionIndexes, callCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.typedCallNodeIndexes, callCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.contractRows, callCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectStarts, callCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectCounts, callCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectRows, effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectKinds, effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectTargetKinds, effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectParameterOrdinals, effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectArgumentRows, effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectArgumentValueNodeIndexes, effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectValueDefinitionRows, effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectGenerationRootValueDefinitionRows,
           effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectExactTypeIds, effectCount) ||
       !compilerCsgArenaInt32ColumnCapacityExact(
           table.effectCarrierKinds, effectCount):
        return false
    return table.callCoordinateKinds.len == callCount &&
           table.callerTypedFunctionIndexes.len == callCount &&
           table.typedCallNodeIndexes.len == callCount &&
           table.contractRows.len == callCount &&
           table.effectStarts.len == callCount &&
           table.effectCounts.len == callCount &&
           table.callCapabilityCids.len == callCount &&
           table.effectKinds.len == effectCount &&
           table.effectTargetKinds.len == effectCount &&
           table.effectParameterOrdinals.len == effectCount &&
           table.effectArgumentRows.len == effectCount &&
           table.effectArgumentValueNodeIndexes.len == effectCount &&
           table.effectValueDefinitionRows.len == effectCount &&
           table.effectGenerationRootValueDefinitionRows.len ==
               effectCount &&
           table.effectExactTypeIds.len == effectCount &&
           table.effectCarrierKinds.len == effectCount &&
           table.effectArgumentBindingCids.len == effectCount &&
           table.effectTypeCids.len == effectCount &&
           table.effectGenerationCids.len == effectCount &&
           table.effectDefinitionLineageCids.len == effectCount &&
           table.effectCapabilityCids.len == effectCount

@borrows
fn CompilerCsgExternFfiHandleCallCapabilitiesStrictValidateInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        typedIr: texpr.TypedExprIr,
        contracts: CompilerCsgExternFfiHandleContractTable,
        table: CompilerCsgExternFfiHandleCallCapabilityTable,
        err: var str): bool =
    if !compilerCsgExternFfiHandleCallCapabilityTableShapeValid(table):
        err = " compiler csg: ffi handle call capability table shape mismatch"
        return false
    if !compilerCsgExternFfiHandleContractTableSemanticStrictValidateInto(
           share(receipt),
           share(typeArena),
           share(semanticGraph),
           share(contracts),
           err) ||
       !CompilerCsgSemanticResolvedCallTableValidate(
           semanticGraph.resolvedCallTable,
           typedIr.functions2_functionNameIds.len,
           err) ||
       !CompilerCsgSemanticResolvedCallParserOriginsStrictValidateInto(
           semanticGraph.resolvedCallTable,
           receipt,
           err) ||
       !texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
           typedIr, err):
        return false
    var expected: CompilerCsgExternFfiHandleCallCapabilityTable
    if !compilerCsgExternFfiHandleCallCapabilityBuildCandidateInto(
           receipt,
           typeArena,
           typedIr,
           semanticGraph,
           contracts,
           expected,
           err):
        return false
    let equal =
        compilerCsgExternFfiHandleCallCapabilityTableEqual(
            table, expected)
    CompilerCsgExternFfiHandleCallCapabilityTableRelease(expected)
    if !equal:
        err = " compiler csg: ffi handle call capability replay mismatch"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExternFfiHandleCallCapabilityTableBuildInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        typedIr: var texpr.TypedExprIr,
        contracts: CompilerCsgExternFfiHandleContractTable,
        out: var CompilerCsgExternFfiHandleCallCapabilityTable,
        err: var str): bool =
    if !compilerCsgExternFfiHandleCallCapabilityTableEmpty(out):
        err = " compiler csg: ffi handle call capability destination is not empty"
        return false
    var candidate: CompilerCsgExternFfiHandleCallCapabilityTable
    if !compilerCsgExternFfiHandleCallCapabilityBuildCandidateInto(
           receipt,
           typeArena,
           typedIr,
           semanticGraph,
           contracts,
           candidate,
           err):
        return false
    if !CompilerCsgExternFfiHandleCallCapabilitiesStrictValidateInto(
           receipt,
           typeArena,
           semanticGraph,
           typedIr,
           contracts,
           candidate,
           err):
        CompilerCsgExternFfiHandleCallCapabilityTableRelease(candidate)
        return false
    out = candidate
    err = ""
    return true

@borrows
fn compilerCsgExactFieldTypeIdInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        typeSyntaxSourceStarts: var int32[],
        typeSyntaxRows: var int32[],
        sourceId: int32,
        ownerDeclarationSourceLocalRow: int32,
        fieldDeclarationSourceLocalRow: int32,
        ordinal: int32,
        ownerTypeIdOut: var int32,
        fieldTypeIdOut: var int32,
        memberRowOut: var int32,
        err: var str): bool =
    memberRowOut = -1
    var ownerTypeSyntaxId: int32
    if !compilerCsgExactDeclarationTypeIdInto(
           share(receipt),
           share(typeArena),
           typeSyntaxSourceStarts,
           typeSyntaxRows,
           sourceId,
           ownerDeclarationSourceLocalRow,
           ownerTypeSyntaxId,
           ownerTypeIdOut,
           err):
        return false
    var fieldTypeSyntaxId: int32
    if !compilerCsgExactDeclarationTypeIdInto(
           share(receipt),
           share(typeArena),
           typeSyntaxSourceStarts,
           typeSyntaxRows,
           sourceId,
           fieldDeclarationSourceLocalRow,
           fieldTypeSyntaxId,
           fieldTypeIdOut,
           err):
        return false
    let sidecar = receipt.sourceSidecars[sourceId]
    if fieldDeclarationSourceLocalRow >=
           sidecar.declarationOwnerIds.len ||
       sidecar.declarationOwnerIds[
           fieldDeclarationSourceLocalRow] !=
           ownerDeclarationSourceLocalRow:
        err = " compiler csg: exact field declaration owner mismatch"
        return false
    let symbolId =
        typearena.TypedExprTypeArenaSymbolIdAt(
            typeArena, ownerTypeIdOut)
    if symbolId < 0 || symbolId >= typeArena.symbolCount:
        err = " compiler csg: exact field owner symbol missing"
        return false
    let memberStart = arenamod.ArenaArrayInt32Get(
        typeArena.arena, typeArena.symbolMemberStarts, symbolId)
    let memberCount = arenamod.ArenaArrayInt32Get(
        typeArena.arena, typeArena.symbolMemberCounts, symbolId)
    if ordinal < 0 || ordinal >= memberCount:
        err = " compiler csg: exact field member ordinal invalid"
        return false
    memberRowOut = memberStart + ordinal
    if arenamod.ArenaArrayInt32Get(
           typeArena.arena,
           typeArena.memberProducerSourceIndexes,
           memberRowOut) != sourceId ||
       arenamod.ArenaArrayInt32Get(
           typeArena.arena,
           typeArena.memberDeclarationSymbolIds,
           memberRowOut) != symbolId ||
       arenamod.ArenaArrayInt32Get(
           typeArena.arena,
           typeArena.memberOrdinals,
           memberRowOut) != ordinal ||
       arenamod.ArenaArrayInt32Get(
           typeArena.arena,
           typeArena.memberTypeSyntaxNodeIndexes,
           memberRowOut) != fieldTypeSyntaxId ||
       arenamod.ArenaArrayInt32Get(
           typeArena.arena,
           typeArena.memberTypeIds,
           memberRowOut) != fieldTypeIdOut:
        err = " compiler csg: exact field member coordinate missing"
        return false
    err = ""
    return true

@borrows
fn compilerCsgBindTypedIrExactDeclarationLayoutsInto(
        accumulator:
            var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        contexts: var texpr.TypedExprSourceContext[],
        ir: var texpr.TypedExprIr,
        err: var str): bool =
    let typeArena = share(ir.exactTypeArena)
    let sourceCount = accumulator.sourceSidecars.len
    if typeArena == nil ||
       sourceCount <= 0 ||
       sourceCount != contexts.len ||
       sourceCount != typeArena.producerSourceCount ||
       accumulator.sourceSidecarPresent.len != sourceCount:
        err = " compiler csg: exact declaration layout bind source domain invalid"
        return false
    for sourceId in 0..<sourceCount:
        if !accumulator.sourceSidecarPresent[sourceId]:
            err = Fmt" compiler csg: exact declaration layout parser source missing source={sourceId}"
            return false
    texpr.TypedExprIrPrepareExactLayoutParserAuthority(
        ir, contexts)
    var typeSyntaxSourceStarts: int32[]
    var typeSyntaxSourceCounts: int32[]
    var typeSyntaxRows: int32[]
    setLen(typeSyntaxSourceStarts, sourceCount + 1)
    setLen(typeSyntaxSourceCounts, sourceCount)
    setLen(typeSyntaxRows, typeArena.typeSyntaxCount)
    for typeSyntaxId in 0..<typeArena.typeSyntaxCount:
        let sourceId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxProducerSourceIndexes,
            typeSyntaxId)
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler csg: exact declaration layout TypeSyntax source invalid"
            return false
        typeSyntaxSourceCounts[sourceId] =
            typeSyntaxSourceCounts[sourceId] + 1
    for sourceId in 0..<sourceCount:
        typeSyntaxSourceStarts[sourceId + 1] =
            typeSyntaxSourceStarts[sourceId] +
            typeSyntaxSourceCounts[sourceId]
    var typeSyntaxCursors: int32[]
    setLen(typeSyntaxCursors, sourceCount)
    for sourceId in 0..<sourceCount:
        typeSyntaxCursors[sourceId] =
            typeSyntaxSourceStarts[sourceId]
    for typeSyntaxId in 0..<typeArena.typeSyntaxCount:
        let sourceId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxProducerSourceIndexes,
            typeSyntaxId)
        let sourceLocalRow = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxSourceLocalRows,
            typeSyntaxId)
        if sourceLocalRow < 0 ||
           sourceLocalRow >= typeSyntaxSourceCounts[sourceId]:
            err = " compiler csg: exact declaration layout TypeSyntax source-local row invalid"
            return false
        let row = typeSyntaxSourceStarts[sourceId] + sourceLocalRow
        if row < typeSyntaxSourceStarts[sourceId] ||
           row >= typeSyntaxSourceStarts[sourceId + 1]:
            err = " compiler csg: exact declaration layout TypeSyntax row overflow"
            return false
        typeSyntaxRows[row] = typeSyntaxId
        typeSyntaxCursors[sourceId] =
            typeSyntaxCursors[sourceId] + 1
    var layoutStates: int32[]
    var layoutSizes: int32[]
    var layoutAligns: int32[]
    var layoutPresent: bool[]
    setLen(layoutStates, typeArena.typeCount)
    setLen(layoutSizes, typeArena.typeCount)
    setLen(layoutAligns, typeArena.typeCount)
    setLen(layoutPresent, typeArena.typeCount)
    if !compilerCsgBindTypedIrExactDeclarationLayoutsRec(
           accumulator,
           typeArena,
           ir,
           typeSyntaxSourceStarts,
           typeSyntaxRows,
           layoutStates,
           layoutSizes,
           layoutAligns,
           layoutPresent,
           0,
           0,
           err):
        return false
    err = ""
    return true

@borrows
fn compilerCsgBindTypedIrExactDeclarationLayoutsRec(
        accumulator:
            var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        typeArena: typearena.TypedExprTypeArena,
        ir: var texpr.TypedExprIr,
        typeSyntaxSourceStarts: int32[],
        typeSyntaxRows: int32[],
        layoutStates: var int32[],
        layoutSizes: var int32[],
        layoutAligns: var int32[],
        layoutPresent: var bool[],
        sourceId: int32,
        declarationRow: int32,
        err: var str): bool =
    while true:
        if sourceId >= accumulator.sourceSidecars.len:
            return true
        let sidecar = accumulator.sourceSidecars[sourceId]
        if declarationRow >= sidecar.declarationKinds.len:
            sourceId = sourceId + 1
            declarationRow = 0
            continue
        if sidecar.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationType):
            declarationRow = declarationRow + 1
            continue
        var typeSyntaxId: int32
        var typeId: int32
        if !compilerCsgExactDeclarationTypeIdFromSidecarsInto(
               accumulator.sourceSidecars,
               typeArena,
               typeSyntaxSourceStarts,
               typeSyntaxRows,
               sourceId,
               declarationRow,
               typeSyntaxId,
               typeId,
               err) ||
           !compilerCsgExactLayoutResolveInto(
               typeArena,
               typeId,
               layoutStates,
               layoutSizes,
               layoutAligns,
               layoutPresent,
               err):
            return false
        let sourceLocalTypeSyntaxId =
            sidecar.declarationTypeSyntaxRootIds[declarationRow]
        if sourceLocalTypeSyntaxId < 0 ||
           sourceLocalTypeSyntaxId >=
               sidecar.typeSyntaxGenericSymbolCounts.len:
            err = " compiler csg: exact declaration layout generic identity missing"
            return false
        let genericSymbolCount =
            sidecar.typeSyntaxGenericSymbolCounts[sourceLocalTypeSyntaxId]
        if genericSymbolCount < 0 ||
           (genericSymbolCount > 0 && layoutPresent[typeId]):
            err = Fmt" compiler csg: uninstantiated generic declaration has concrete layout source={sourceId} declaration={declarationRow} type_id={typeId} generic_count={genericSymbolCount}"
            return false
        texpr.TypedExprIrBindExactDeclarationLayoutAuthority(
            ir,
            sourceId,
            declarationRow,
            typeId,
            genericSymbolCount,
            layoutPresent[typeId],
            layoutSizes[typeId],
            layoutAligns[typeId])
        declarationRow = declarationRow + 1

@borrows
fn compilerCsgExactLayoutTableBuildInto(
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        out: var CompilerCsgTypeDiagnosticCompletionTable,
        err: var str): bool =
    if receipt.sourceSidecars.len != typeArena.producerSourceCount ||
       out.exactLayoutSourceIds.len != 0 ||
       out.exactLayoutProducerRowIds.len != 0 ||
       out.exactLayoutDeclarationSourceLocalRows.len != 0 ||
       out.exactLayoutBuiltinKinds.len != 0 ||
       out.exactLayoutTypeArenaIds.len != 0 ||
       out.exactLayoutSizeBytes.len != 0 ||
       out.exactLayoutAlignBytes.len != 0 ||
       out.exactLayoutFieldCounts.len != 0 ||
       out.exactLayoutSourceRowStarts.len != 0 ||
       out.exactLayoutSourceRowCounts.len != 0 ||
       out.exactLayoutSourceRowIndexes.len != 0 ||
       out.exactLayoutFieldSourceIds.len != 0 ||
       out.exactLayoutFieldProducerRowIds.len != 0 ||
       out.exactLayoutFieldOwnerDeclarationSourceLocalRows.len != 0 ||
       out.exactLayoutFieldDeclarationSourceLocalRows.len != 0 ||
       out.exactLayoutFieldBuiltinKinds.len != 0 ||
       out.exactLayoutFieldMemberRows.len != 0 ||
       out.exactLayoutFieldOwnerTypeArenaIds.len != 0 ||
       out.exactLayoutFieldOrdinals.len != 0 ||
       out.exactLayoutFieldTypeArenaIds.len != 0 ||
       out.exactLayoutFieldOffsetBytes.len != 0 ||
       out.exactLayoutFieldSizeBytes.len != 0 ||
       out.exactLayoutFieldAlignBytes.len != 0 ||
       out.exactLayoutFieldSourceRowStarts.len != 0 ||
       out.exactLayoutFieldSourceRowCounts.len != 0 ||
       out.exactLayoutFieldSourceRowIndexes.len != 0:
        err = " compiler csg: exact layout producer destination invalid"
        return false
    if !texpr.TypedExprIrExactLayoutCoordinatesStrictValidateInto(
           ir, receipt.sourceSidecars.len, err):
        return false
    let sourceCount = receipt.sourceSidecars.len
    var typeSyntaxSourceStarts: int32[]
    var typeSyntaxSourceCounts: int32[]
    var typeSyntaxRows: int32[]
    setLen(typeSyntaxSourceStarts, sourceCount + 1)
    setLen(typeSyntaxSourceCounts, sourceCount)
    setLen(typeSyntaxRows, typeArena.typeSyntaxCount)
    for typeSyntaxId in 0..<typeArena.typeSyntaxCount:
        let sourceId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxProducerSourceIndexes,
            typeSyntaxId)
        if sourceId < 0 || sourceId >= sourceCount:
            err = " compiler csg: TypeSyntax producer source invalid"
            return false
        typeSyntaxSourceCounts[sourceId] =
            typeSyntaxSourceCounts[sourceId] + 1
    for sourceId in 0..<sourceCount:
        typeSyntaxSourceStarts[sourceId + 1] =
            typeSyntaxSourceStarts[sourceId] +
            typeSyntaxSourceCounts[sourceId]
    var typeSyntaxCursors: int32[]
    setLen(typeSyntaxCursors, sourceCount)
    for sourceId in 0..<sourceCount:
        typeSyntaxCursors[sourceId] =
            typeSyntaxSourceStarts[sourceId]
    for typeSyntaxId in 0..<typeArena.typeSyntaxCount:
        let sourceId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxProducerSourceIndexes,
            typeSyntaxId)
        typeSyntaxRows[typeSyntaxCursors[sourceId]] =
            typeSyntaxId
        typeSyntaxCursors[sourceId] =
            typeSyntaxCursors[sourceId] + 1
    for sourceId in 0..<sourceCount:
        for sourceLocalRow in 0..<typeSyntaxSourceCounts[sourceId]:
            let typeSyntaxId =
                typeSyntaxRows[
                    typeSyntaxSourceStarts[sourceId] +
                    sourceLocalRow]
            if arenamod.ArenaArrayInt32Get(
                   typeArena.arena,
                   typeArena.typeSyntaxSourceLocalRows,
                   typeSyntaxId) != sourceLocalRow:
                err = " compiler csg: exact layout TypeSyntax source-local coordinate drift"
                return false
    var layoutStates: int32[]
    var layoutSizes: int32[]
    var layoutAligns: int32[]
    var layoutPresent: bool[]
    var ownerFieldsProcessed: bool[]
    var memberOffsets: int32[]
    setLen(layoutStates, typeArena.typeCount)
    setLen(layoutSizes, typeArena.typeCount)
    setLen(layoutAligns, typeArena.typeCount)
    setLen(layoutPresent, typeArena.typeCount)
    setLen(ownerFieldsProcessed, typeArena.typeCount)
    setLen(memberOffsets, typeArena.memberCount)
    for memberRow in 0..<memberOffsets.len:
        memberOffsets[memberRow] = -1
    let typeRowCount = ir.typeLayoutNames.len
    if !texpr.TypedExprIrExactLayoutCoordinateShapeComplete(ir):
        err = " compiler csg: producer exact layout columns split"
        return false
    for producerRow in 0..<typeRowCount:
        let sourceId =
            ir.typeLayoutProducerSourceIndexes[producerRow]
        let builtinKind = texpr.TypedExprLayoutBuiltinKind(
            ir.typeLayoutBuiltinKinds[producerRow])
        var typeSyntaxId: int32
        var typeId: int32 = -1
        if builtinKind == texpr.TypedExprLayoutBuiltinNone:
            if !compilerCsgExactDeclarationTypeIdInto(
                   receipt,
                   typeArena,
                   typeSyntaxSourceStarts,
                   typeSyntaxRows,
                   sourceId,
                   ir.typeLayoutDeclarationSourceLocalRows[producerRow],
                   typeSyntaxId,
                   typeId,
                   err):
                return false
            if !compilerCsgExactLayoutResolveInto(
                   typeArena,
                   typeId,
                   layoutStates,
                   layoutSizes,
                   layoutAligns,
                   layoutPresent,
                   err) ||
               !layoutPresent[typeId] ||
               layoutSizes[typeId] !=
                   ir.typeLayoutSizeBytes[producerRow] ||
               layoutAligns[typeId] !=
                   ir.typeLayoutAlignBytes[producerRow]:
                if err == "":
                    err = Fmt" compiler csg: exact type layout numeric mismatch source={sourceId} producer_row={producerRow} type_name={ir.typeLayoutNames[producerRow]} declaration_row={ir.typeLayoutDeclarationSourceLocalRows[producerRow]} type_syntax_id={typeSyntaxId} type_id={typeId} structural_kind={Int32(typearena.TypedExprTypeArenaKindAt(typeArena, typeId))} present={layoutPresent[typeId] ? 1 : 0} arena_size={layoutSizes[typeId]} arena_align={layoutAligns[typeId]} ir_size={ir.typeLayoutSizeBytes[producerRow]} ir_align={ir.typeLayoutAlignBytes[producerRow]}"
                return false
        add(out.exactLayoutSourceIds, sourceId)
        add(out.exactLayoutProducerRowIds, producerRow)
        add(out.exactLayoutDeclarationSourceLocalRows,
            ir.typeLayoutDeclarationSourceLocalRows[producerRow])
        add(out.exactLayoutBuiltinKinds, Int32(builtinKind))
        add(out.exactLayoutTypeArenaIds, typeId)
        add(out.exactLayoutSizeBytes,
            ir.typeLayoutSizeBytes[producerRow])
        add(out.exactLayoutAlignBytes,
            ir.typeLayoutAlignBytes[producerRow])
        add(out.exactLayoutFieldCounts,
            ir.typeLayoutFieldCounts[producerRow])
    for producerRow in 0..<ir.typeFieldOwnerTypes.len:
        let sourceId =
            ir.typeFieldProducerSourceIndexes[producerRow]
        let builtinKind = texpr.TypedExprLayoutBuiltinKind(
            ir.typeFieldBuiltinKinds[producerRow])
        var ownerTypeId: int32 = -1
        var fieldTypeId: int32 = -1
        var memberRow: int32 = -1
        if builtinKind == texpr.TypedExprLayoutBuiltinNone:
            if !compilerCsgExactFieldTypeIdInto(
                   receipt,
                   typeArena,
                   typeSyntaxSourceStarts,
                   typeSyntaxRows,
                   sourceId,
                   ir.typeFieldOwnerDeclarationSourceLocalRows[producerRow],
                   ir.typeFieldDeclarationSourceLocalRows[producerRow],
                   ir.typeFieldOrdinals[producerRow],
                   ownerTypeId,
                   fieldTypeId,
                   memberRow,
                   err):
                return false
            if !compilerCsgExactLayoutResolveInto(
                   typeArena,
                   fieldTypeId,
                   layoutStates,
                   layoutSizes,
                   layoutAligns,
                   layoutPresent,
                   err) ||
               !layoutPresent[fieldTypeId]:
                if err == "":
                    err = " compiler csg: exact field type layout unavailable"
                return false
            if !ownerFieldsProcessed[ownerTypeId]:
                let ownerSymbolId =
                    typearena.TypedExprTypeArenaSymbolIdAt(
                        typeArena, ownerTypeId)
                if ownerSymbolId < 0 ||
                   ownerSymbolId >= typeArena.symbolCount:
                    err = " compiler csg: exact field owner symbol unavailable"
                    return false
                let memberStart = arenamod.ArenaArrayInt32Get(
                    typeArena.arena,
                    typeArena.symbolMemberStarts,
                    ownerSymbolId)
                let memberCount = arenamod.ArenaArrayInt32Get(
                    typeArena.arena,
                    typeArena.symbolMemberCounts,
                    ownerSymbolId)
                var cursor: int32
                for memberOffset in 0..<memberCount:
                    let exactMemberRow =
                        memberStart + memberOffset
                    let exactMemberTypeId =
                        arenamod.ArenaArrayInt32Get(
                            typeArena.arena,
                            typeArena.memberTypeIds,
                            exactMemberRow)
                    if arenamod.ArenaArrayInt32Get(
                           typeArena.arena,
                           typeArena.memberOrdinals,
                           exactMemberRow) != memberOffset ||
                       !compilerCsgExactLayoutResolveInto(
                           typeArena,
                           exactMemberTypeId,
                           layoutStates,
                           layoutSizes,
                           layoutAligns,
                           layoutPresent,
                           err) ||
                       !layoutPresent[exactMemberTypeId] ||
                       !compilerCsgExactLayoutAlign(
                           cursor,
                           layoutAligns[exactMemberTypeId],
                           cursor):
                        if err == "":
                            err = " compiler csg: exact owner field layout unavailable"
                        return false
                    memberOffsets[exactMemberRow] = cursor
                    if !compilerCsgExactLayoutAdd(
                           cursor,
                           layoutSizes[exactMemberTypeId],
                           cursor):
                        err = " compiler csg: exact owner field layout overflow"
                        return false
                ownerFieldsProcessed[ownerTypeId] = true
            if memberOffsets[memberRow] !=
                   ir.typeFieldOffsetBytes[producerRow] ||
               layoutSizes[fieldTypeId] !=
                   ir.typeFieldSizeBytes[producerRow] ||
               layoutAligns[fieldTypeId] !=
                   ir.typeFieldAlignBytes[producerRow]:
                err = " compiler csg: exact field numeric layout mismatch"
                return false
        add(out.exactLayoutFieldSourceIds, sourceId)
        add(out.exactLayoutFieldProducerRowIds, producerRow)
        add(out.exactLayoutFieldOwnerDeclarationSourceLocalRows,
            ir.typeFieldOwnerDeclarationSourceLocalRows[producerRow])
        add(out.exactLayoutFieldDeclarationSourceLocalRows,
            ir.typeFieldDeclarationSourceLocalRows[producerRow])
        add(out.exactLayoutFieldBuiltinKinds, Int32(builtinKind))
        add(out.exactLayoutFieldMemberRows, memberRow)
        add(out.exactLayoutFieldOwnerTypeArenaIds, ownerTypeId)
        add(out.exactLayoutFieldOrdinals,
            ir.typeFieldOrdinals[producerRow])
        add(out.exactLayoutFieldTypeArenaIds, fieldTypeId)
        add(out.exactLayoutFieldOffsetBytes,
            ir.typeFieldOffsetBytes[producerRow])
        add(out.exactLayoutFieldSizeBytes,
            ir.typeFieldSizeBytes[producerRow])
        add(out.exactLayoutFieldAlignBytes,
            ir.typeFieldAlignBytes[producerRow])
    # [fg-line] builtin 字段行物化：declared 字段经 ir.typeField* producer 行
    # seal（上方循环）；builtin 字段（str/Bytes/[]/Option 的 data/len/cap/...）
    # 没有 typeField producer 发布点，权威表 builtin 行恒缺 → FieldGet
    # missingRow（R7 十行定谳的单点缺口）。此处以 typed-ir 节点侧已冻结的
    # builtin 精确坐标列（nodes2_field*：builtin/ordinal/offset/size/align）
    # 为唯一坐标源补 seal；物理身份仍由 layout-authority 校验点的
    # compilerCsgExactLayoutBuiltinFieldMatches 对每个节点独立把关，本表
    # 不派生物理布局，读取侧零 fallback。
    let fgNodeCount = ir.nodes2_nodeIndexs.len
    if ir.nodes2_fieldOffsetBytes.len != fgNodeCount ||
       ir.nodes2_fieldSizeBytes.len != fgNodeCount ||
       ir.nodes2_fieldAlignBytes.len != fgNodeCount ||
       ir.nodes2_fieldProducerSourceIndexes.len != fgNodeCount ||
       ir.nodes2_fieldOwnerDeclarationSourceLocalRows.len != fgNodeCount ||
       ir.nodes2_fieldDeclarationSourceLocalRows.len != fgNodeCount ||
       ir.nodes2_fieldOrdinals.len != fgNodeCount ||
       ir.nodes2_fieldBuiltinKinds.len != fgNodeCount:
        err = " compiler csg: exact node layout seal columns split"
        return false
    var fgSealed: bool[]
    setLen(fgSealed, sourceCount * 16)
    for fgRow in 0..<out.exactLayoutFieldSourceIds.len:
        let fgRowBuiltin = out.exactLayoutFieldBuiltinKinds[fgRow]
        let fgRowOrdinal = out.exactLayoutFieldOrdinals[fgRow]
        let fgRowSource = out.exactLayoutFieldSourceIds[fgRow]
        if fgRowBuiltin == Int32(texpr.TypedExprLayoutBuiltinNone) ||
           fgRowBuiltin < Int32(texpr.TypedExprLayoutBuiltinStr) ||
           fgRowBuiltin > Int32(texpr.TypedExprLayoutBuiltinOptional) ||
           fgRowOrdinal < 0 || fgRowOrdinal >= 4 ||
           fgRowSource < 0 || fgRowSource >= sourceCount:
            continue
        fgSealed[fgRowSource * 16 + fgRowBuiltin * 4 + fgRowOrdinal] = true
    for fgNode in 0..<fgNodeCount:
        let fgOffset = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldOffsetBytes, fgNode)
        let fgSize = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldSizeBytes, fgNode)
        let fgAlign = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldAlignBytes, fgNode)
        if fgOffset == 0 && fgSize == 0 && fgAlign == 0:
            continue
        let fgBuiltin = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldBuiltinKinds, fgNode)
        if fgBuiltin == Int32(texpr.TypedExprLayoutBuiltinNone):
            continue
        let fgSourceId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldProducerSourceIndexes, fgNode)
        let fgOwnerRow = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldOwnerDeclarationSourceLocalRows,
            fgNode)
        let fgDeclRow = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldDeclarationSourceLocalRows, fgNode)
        let fgOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldOrdinals, fgNode)
        # 坐标域外的 builtin 节点列不在此处裁决（校验点以其精确判词
        # fail-closed），只保证 seal 索引安全后跳过。
        if fgBuiltin < Int32(texpr.TypedExprLayoutBuiltinStr) ||
           fgBuiltin > Int32(texpr.TypedExprLayoutBuiltinOptional) ||
           fgOrdinal < 0 || fgOrdinal >= 4 ||
           fgSourceId < 0 || fgSourceId >= sourceCount ||
           fgOwnerRow != -1 || fgDeclRow != -1 ||
           fgOffset < 0 || fgSize <= 0 || fgAlign <= 0:
            continue
        let fgSealIndex = fgSourceId * 16 + fgBuiltin * 4 + fgOrdinal
        if fgSealed[fgSealIndex]:
            continue
        fgSealed[fgSealIndex] = true
        add(out.exactLayoutFieldSourceIds, fgSourceId)
        add(out.exactLayoutFieldProducerRowIds,
            out.exactLayoutFieldSourceIds.len - 1)
        add(out.exactLayoutFieldOwnerDeclarationSourceLocalRows, -1)
        add(out.exactLayoutFieldDeclarationSourceLocalRows, -1)
        add(out.exactLayoutFieldBuiltinKinds, fgBuiltin)
        add(out.exactLayoutFieldMemberRows, -1)
        add(out.exactLayoutFieldOwnerTypeArenaIds, -1)
        add(out.exactLayoutFieldOrdinals, fgOrdinal)
        add(out.exactLayoutFieldTypeArenaIds, -1)
        add(out.exactLayoutFieldOffsetBytes, fgOffset)
        add(out.exactLayoutFieldSizeBytes, fgSize)
        add(out.exactLayoutFieldAlignBytes, fgAlign)
    setLen(out.exactLayoutSourceRowStarts, sourceCount)
    setLen(out.exactLayoutSourceRowCounts, sourceCount)
    setLen(out.exactLayoutFieldSourceRowStarts, sourceCount)
    setLen(out.exactLayoutFieldSourceRowCounts, sourceCount)
    for row in 0..<out.exactLayoutSourceIds.len:
        out.exactLayoutSourceRowCounts[
            out.exactLayoutSourceIds[row]] =
            out.exactLayoutSourceRowCounts[
                out.exactLayoutSourceIds[row]] + 1
    for row in 0..<out.exactLayoutFieldSourceIds.len:
        out.exactLayoutFieldSourceRowCounts[
            out.exactLayoutFieldSourceIds[row]] =
            out.exactLayoutFieldSourceRowCounts[
                out.exactLayoutFieldSourceIds[row]] + 1
    for sourceId in 1..<sourceCount:
        out.exactLayoutSourceRowStarts[sourceId] =
            out.exactLayoutSourceRowStarts[sourceId - 1] +
            out.exactLayoutSourceRowCounts[sourceId - 1]
        out.exactLayoutFieldSourceRowStarts[sourceId] =
            out.exactLayoutFieldSourceRowStarts[sourceId - 1] +
            out.exactLayoutFieldSourceRowCounts[sourceId - 1]
    setLen(
        out.exactLayoutSourceRowIndexes,
        out.exactLayoutSourceIds.len)
    setLen(
        out.exactLayoutFieldSourceRowIndexes,
        out.exactLayoutFieldSourceIds.len)
    var typeCursors: int32[]
    var fieldCursors: int32[]
    setLen(typeCursors, sourceCount)
    setLen(fieldCursors, sourceCount)
    for sourceId in 0..<sourceCount:
        typeCursors[sourceId] =
            out.exactLayoutSourceRowStarts[sourceId]
        fieldCursors[sourceId] =
            out.exactLayoutFieldSourceRowStarts[sourceId]
    for row in 0..<out.exactLayoutSourceIds.len:
        let sourceId = out.exactLayoutSourceIds[row]
        out.exactLayoutSourceRowIndexes[
            typeCursors[sourceId]] = row
        typeCursors[sourceId] = typeCursors[sourceId] + 1
    for row in 0..<out.exactLayoutFieldSourceIds.len:
        let sourceId = out.exactLayoutFieldSourceIds[row]
        out.exactLayoutFieldSourceRowIndexes[
            fieldCursors[sourceId]] = row
        fieldCursors[sourceId] = fieldCursors[sourceId] + 1
    err = ""
    return true

@borrows
fn compilerCsgExactLayoutTableStrictValidateInto(
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        sourceCount: int32,
        table: var CompilerCsgTypeDiagnosticCompletionTable,
        err: var str): bool =
    let typeRowCount = ir.typeLayoutNames.len
    let producerFieldRowCount = ir.typeFieldOwnerTypes.len
    let fieldRowCount = table.exactLayoutFieldSourceIds.len
    if fieldRowCount < producerFieldRowCount:
        err = " compiler csg: exact layout builtin field seal lost producer rows"
        return false
    if !texpr.TypedExprIrExactLayoutCoordinateShapeComplete(ir) ||
       typeRowCount != table.exactLayoutSourceIds.len ||
       typeRowCount != table.exactLayoutProducerRowIds.len ||
       typeRowCount !=
           table.exactLayoutDeclarationSourceLocalRows.len ||
       typeRowCount != table.exactLayoutBuiltinKinds.len ||
       typeRowCount != table.exactLayoutTypeArenaIds.len ||
       typeRowCount != table.exactLayoutSizeBytes.len ||
       typeRowCount != table.exactLayoutAlignBytes.len ||
       typeRowCount != table.exactLayoutFieldCounts.len ||
       sourceCount != table.exactLayoutSourceRowStarts.len ||
       sourceCount != table.exactLayoutSourceRowCounts.len ||
       typeRowCount != table.exactLayoutSourceRowIndexes.len ||
       fieldRowCount != table.exactLayoutFieldSourceIds.len ||
       fieldRowCount != table.exactLayoutFieldProducerRowIds.len ||
       fieldRowCount !=
           table.exactLayoutFieldOwnerDeclarationSourceLocalRows.len ||
       fieldRowCount !=
           table.exactLayoutFieldDeclarationSourceLocalRows.len ||
       fieldRowCount != table.exactLayoutFieldBuiltinKinds.len ||
       fieldRowCount != table.exactLayoutFieldMemberRows.len ||
       fieldRowCount != table.exactLayoutFieldOwnerTypeArenaIds.len ||
       fieldRowCount != table.exactLayoutFieldOrdinals.len ||
       fieldRowCount != table.exactLayoutFieldTypeArenaIds.len ||
       fieldRowCount != table.exactLayoutFieldOffsetBytes.len ||
       fieldRowCount != table.exactLayoutFieldSizeBytes.len ||
       fieldRowCount != table.exactLayoutFieldAlignBytes.len ||
       sourceCount != table.exactLayoutFieldSourceRowStarts.len ||
       sourceCount != table.exactLayoutFieldSourceRowCounts.len ||
       fieldRowCount != table.exactLayoutFieldSourceRowIndexes.len:
        err = " compiler csg: exact layout authority columns split"
        return false
    var layoutRowByTypeId: int32[]
    setLen(layoutRowByTypeId, typeArena.typeCount)
    for typeId in 0..<layoutRowByTypeId.len:
        layoutRowByTypeId[typeId] = -1
    var builtinLayoutRows: int32[]
    setLen(builtinLayoutRows, sourceCount * 4)
    for index in 0..<builtinLayoutRows.len:
        builtinLayoutRows[index] = -1
    for row in 0..<typeRowCount:
        let builtinRaw = table.exactLayoutBuiltinKinds[row]
        let builtin =
            builtinRaw != Int32(texpr.TypedExprLayoutBuiltinNone)
        if builtinRaw < Int32(texpr.TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(texpr.TypedExprLayoutBuiltinOptional) ||
           table.exactLayoutProducerRowIds[row] != row ||
           table.exactLayoutSourceIds[row] !=
               ir.typeLayoutProducerSourceIndexes[row] ||
           table.exactLayoutDeclarationSourceLocalRows[row] !=
               ir.typeLayoutDeclarationSourceLocalRows[row] ||
           builtinRaw != ir.typeLayoutBuiltinKinds[row] ||
           table.exactLayoutSourceIds[row] < 0 ||
           table.exactLayoutSourceIds[row] >= sourceCount ||
           (builtin &&
            (table.exactLayoutDeclarationSourceLocalRows[row] != -1 ||
             table.exactLayoutTypeArenaIds[row] != -1)) ||
           (!builtin &&
            (table.exactLayoutDeclarationSourceLocalRows[row] < 0 ||
             table.exactLayoutTypeArenaIds[row] < 0 ||
             table.exactLayoutTypeArenaIds[row] >=
                 typeArena.typeCount)) ||
           table.exactLayoutSizeBytes[row] !=
               ir.typeLayoutSizeBytes[row] ||
           table.exactLayoutAlignBytes[row] !=
               ir.typeLayoutAlignBytes[row] ||
           table.exactLayoutFieldCounts[row] !=
               ir.typeLayoutFieldCounts[row] ||
           table.exactLayoutSizeBytes[row] <= 0 ||
           table.exactLayoutAlignBytes[row] <= 0 ||
           table.exactLayoutFieldCounts[row] < 0:
            err = " compiler csg: exact layout type row invalid"
            return false
        if builtin:
            let builtinIndex =
                table.exactLayoutSourceIds[row] * 4 + builtinRaw
            if builtinLayoutRows[builtinIndex] >= 0:
                err = " compiler csg: duplicate builtin layout owner"
                return false
            builtinLayoutRows[builtinIndex] = row
        else:
            let typeId = table.exactLayoutTypeArenaIds[row]
            let symbolId =
                typearena.TypedExprTypeArenaSymbolIdAt(
                    typeArena, typeId)
            if symbolId < 0 ||
               symbolId >= typeArena.symbolCount ||
               arenamod.ArenaArrayInt32Get(
                   typeArena.arena,
                   typeArena.symbolProducerSourceIndexes,
                   symbolId) != table.exactLayoutSourceIds[row]:
                err = " compiler csg: exact layout TypeArena nominal source mismatch"
                return false
            if layoutRowByTypeId[typeId] >= 0:
                err = " compiler csg: duplicate exact layout TypeArena owner"
                return false
            layoutRowByTypeId[typeId] = row
    for row in 0..<producerFieldRowCount:
        let builtinRaw = table.exactLayoutFieldBuiltinKinds[row]
        let builtin =
            builtinRaw != Int32(texpr.TypedExprLayoutBuiltinNone)
        if builtinRaw < Int32(texpr.TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(texpr.TypedExprLayoutBuiltinOptional) ||
           table.exactLayoutFieldProducerRowIds[row] != row ||
           table.exactLayoutFieldSourceIds[row] !=
               ir.typeFieldProducerSourceIndexes[row] ||
           table.exactLayoutFieldOwnerDeclarationSourceLocalRows[row] !=
               ir.typeFieldOwnerDeclarationSourceLocalRows[row] ||
           table.exactLayoutFieldDeclarationSourceLocalRows[row] !=
               ir.typeFieldDeclarationSourceLocalRows[row] ||
           builtinRaw != ir.typeFieldBuiltinKinds[row] ||
           table.exactLayoutFieldSourceIds[row] < 0 ||
           table.exactLayoutFieldSourceIds[row] >= sourceCount ||
           table.exactLayoutFieldOrdinals[row] !=
               ir.typeFieldOrdinals[row] ||
           (builtin &&
            (table.exactLayoutFieldOwnerDeclarationSourceLocalRows[row] !=
                 -1 ||
             table.exactLayoutFieldDeclarationSourceLocalRows[row] != -1 ||
             table.exactLayoutFieldMemberRows[row] != -1 ||
             table.exactLayoutFieldOwnerTypeArenaIds[row] != -1 ||
             table.exactLayoutFieldTypeArenaIds[row] != -1)) ||
           (!builtin &&
            (table.exactLayoutFieldOwnerDeclarationSourceLocalRows[row] <
                 0 ||
             table.exactLayoutFieldDeclarationSourceLocalRows[row] < 0 ||
             table.exactLayoutFieldMemberRows[row] < 0 ||
             table.exactLayoutFieldMemberRows[row] >=
                 typeArena.memberCount ||
             table.exactLayoutFieldOwnerTypeArenaIds[row] < 0 ||
             table.exactLayoutFieldOwnerTypeArenaIds[row] >=
                 typeArena.typeCount ||
             table.exactLayoutFieldTypeArenaIds[row] < 0 ||
             table.exactLayoutFieldTypeArenaIds[row] >=
                 typeArena.typeCount)) ||
           table.exactLayoutFieldOffsetBytes[row] !=
               ir.typeFieldOffsetBytes[row] ||
           table.exactLayoutFieldSizeBytes[row] !=
               ir.typeFieldSizeBytes[row] ||
           table.exactLayoutFieldAlignBytes[row] !=
               ir.typeFieldAlignBytes[row] ||
           table.exactLayoutFieldOffsetBytes[row] < 0 ||
           table.exactLayoutFieldSizeBytes[row] <= 0 ||
           table.exactLayoutFieldAlignBytes[row] <= 0:
            err = " compiler csg: exact layout field row invalid"
            return false
        var ownerLayoutRow: int32
        if builtin:
            ownerLayoutRow = builtinLayoutRows[
                table.exactLayoutFieldSourceIds[row] * 4 +
                builtinRaw]
        else:
            let memberRow = table.exactLayoutFieldMemberRows[row]
            let ownerSymbolId =
                typearena.TypedExprTypeArenaSymbolIdAt(
                    typeArena,
                    table.exactLayoutFieldOwnerTypeArenaIds[row])
            if ownerSymbolId < 0 ||
               ownerSymbolId >= typeArena.symbolCount ||
               arenamod.ArenaArrayInt32Get(
                   typeArena.arena,
                   typeArena.memberProducerSourceIndexes,
                   memberRow) != table.exactLayoutFieldSourceIds[row] ||
               arenamod.ArenaArrayInt32Get(
                   typeArena.arena,
                   typeArena.memberDeclarationSymbolIds,
                   memberRow) != ownerSymbolId ||
               arenamod.ArenaArrayInt32Get(
                   typeArena.arena,
                   typeArena.memberOrdinals,
                   memberRow) != table.exactLayoutFieldOrdinals[row] ||
               arenamod.ArenaArrayInt32Get(
                   typeArena.arena,
                   typeArena.memberTypeIds,
                   memberRow) !=
                   table.exactLayoutFieldTypeArenaIds[row]:
                err = " compiler csg: exact field member identity mismatch"
                return false
            ownerLayoutRow = layoutRowByTypeId[
                table.exactLayoutFieldOwnerTypeArenaIds[row]]
        if ownerLayoutRow < 0 ||
           table.exactLayoutSourceIds[ownerLayoutRow] !=
               table.exactLayoutFieldSourceIds[row]:
            err = " compiler csg: exact layout field owner row missing"
            return false
    # [fg-line] builtin seal 段：producer 行之后的表行 = BuildInto 依节点侧
    # builtin 坐标列物化的 builtin 字段行。结构合同：builtin/ordinal 封闭域、
    # 无声明/成员/TypeArena 身份（恒 -1）、坐标在域内、字节为正、(source,
    # builtin, ordinal) 唯一、行号身份连续。物理对错不在此判——节点对表行的
    # 逐字节对账与 BuiltinFieldMatches 在 layout-authority 校验点执行。
    var seenSealRows: bool[]
    setLen(seenSealRows, sourceCount * 16)
    for sealRow in producerFieldRowCount..<fieldRowCount:
        let sealBuiltin = table.exactLayoutFieldBuiltinKinds[sealRow]
        if sealBuiltin < Int32(texpr.TypedExprLayoutBuiltinStr) ||
           sealBuiltin > Int32(texpr.TypedExprLayoutBuiltinOptional) ||
           table.exactLayoutFieldProducerRowIds[sealRow] != sealRow ||
           table.exactLayoutFieldSourceIds[sealRow] < 0 ||
           table.exactLayoutFieldSourceIds[sealRow] >= sourceCount ||
           table.exactLayoutFieldOwnerDeclarationSourceLocalRows[sealRow] != -1 ||
           table.exactLayoutFieldDeclarationSourceLocalRows[sealRow] != -1 ||
           table.exactLayoutFieldMemberRows[sealRow] != -1 ||
           table.exactLayoutFieldOwnerTypeArenaIds[sealRow] != -1 ||
           table.exactLayoutFieldTypeArenaIds[sealRow] != -1 ||
           table.exactLayoutFieldOrdinals[sealRow] < 0 ||
           table.exactLayoutFieldOrdinals[sealRow] >= 4 ||
           table.exactLayoutFieldOffsetBytes[sealRow] < 0 ||
           table.exactLayoutFieldSizeBytes[sealRow] <= 0 ||
           table.exactLayoutFieldAlignBytes[sealRow] <= 0:
            err = " compiler csg: exact layout builtin field seal row invalid"
            return false
        let sealIndex =
            table.exactLayoutFieldSourceIds[sealRow] * 16 +
            sealBuiltin * 4 +
            table.exactLayoutFieldOrdinals[sealRow]
        if seenSealRows[sealIndex]:
            err = " compiler csg: duplicate exact builtin field seal coordinate"
            return false
        seenSealRows[sealIndex] = true
    var seenTypeRows: bool[]
    var seenFieldRows: bool[]
    setLen(seenTypeRows, typeRowCount)
    setLen(seenFieldRows, fieldRowCount)
    var typeCursor: int32
    var fieldCursor: int32
    for sourceId in 0..<sourceCount:
        if table.exactLayoutSourceRowStarts[sourceId] !=
               typeCursor ||
           table.exactLayoutFieldSourceRowStarts[sourceId] !=
               fieldCursor ||
           table.exactLayoutSourceRowCounts[sourceId] < 0 ||
           table.exactLayoutFieldSourceRowCounts[sourceId] < 0 ||
           table.exactLayoutSourceRowCounts[sourceId] >
               typeRowCount - typeCursor ||
           table.exactLayoutFieldSourceRowCounts[sourceId] >
               fieldRowCount - fieldCursor:
            err = " compiler csg: exact layout source CSR invalid"
            return false
        let typeStop =
            typeCursor +
            table.exactLayoutSourceRowCounts[sourceId]
        while typeCursor < typeStop:
            let row =
                table.exactLayoutSourceRowIndexes[typeCursor]
            if row < 0 || row >= typeRowCount ||
               seenTypeRows[row] ||
               table.exactLayoutSourceIds[row] != sourceId:
                err = " compiler csg: exact layout source CSR row invalid"
                return false
            seenTypeRows[row] = true
            typeCursor = typeCursor + 1
        let fieldStop =
            fieldCursor +
            table.exactLayoutFieldSourceRowCounts[sourceId]
        while fieldCursor < fieldStop:
            let row =
                table.exactLayoutFieldSourceRowIndexes[fieldCursor]
            if row < 0 || row >= fieldRowCount ||
               seenFieldRows[row] ||
               table.exactLayoutFieldSourceIds[row] != sourceId:
                err = " compiler csg: exact layout field source CSR row invalid"
                return false
            seenFieldRows[row] = true
            fieldCursor = fieldCursor + 1
    if typeCursor != typeRowCount ||
       fieldCursor != fieldRowCount:
        err = " compiler csg: exact layout source CSR incomplete"
        return false
    err = ""
    return true

@borrows
fn compilerCsgExactLayoutBuiltinFieldMatches(
        typeArena: typearena.TypedExprTypeArena,
        builtinRaw: int32,
        ordinal: int32,
        ownerTypeId: int32,
        valueTypeId: int32,
        fieldOffset: int32,
        fieldSize: int32,
        fieldAlign: int32): bool =
    let physicalOwnerTypeId =
        compilerCsgExactLayoutPhysicalTypeId(
            typeArena, ownerTypeId)
    if physicalOwnerTypeId < 0 ||
       valueTypeId < 0 || valueTypeId >= typeArena.typeCount:
        return false
    let ownerKind = typearena.TypedExprTypeArenaKindAt(
        typeArena, physicalOwnerTypeId)
    let valueKind = typearena.TypedExprTypeArenaKindAt(
        typeArena, valueTypeId)
    if builtinRaw == Int32(texpr.TypedExprLayoutBuiltinOptional) &&
       ownerKind == typearena.TypedExprStructuralTypeOptional:
        if ordinal == 1:
            return true
        if ordinal != 0 || valueKind !=
               typearena.TypedExprStructuralTypeScalar:
            return false
        return fieldOffset == 0 && fieldSize == 1 &&
               fieldAlign == 1 &&
               typearena.TypedExprStructuralScalarKind(
                   arenamod.ArenaArrayInt32Get(
                       typeArena.arena,
                       typeArena.scalarKinds,
                       valueTypeId)) ==
                   typearena.TypedExprStructuralScalarBool
    if valueKind != typearena.TypedExprStructuralTypeScalar:
        return false
    let valueScalarKind =
        typearena.TypedExprStructuralScalarKind(
            arenamod.ArenaArrayInt32Get(
                typeArena.arena,
                typeArena.scalarKinds,
                valueTypeId))
    if builtinRaw == Int32(texpr.TypedExprLayoutBuiltinStr) &&
       ownerKind == typearena.TypedExprStructuralTypeScalar &&
       typearena.TypedExprStructuralScalarKind(
           arenamod.ArenaArrayInt32Get(
               typeArena.arena,
               typeArena.scalarKinds,
               physicalOwnerTypeId)) ==
           typearena.TypedExprStructuralScalarStr:
        if ordinal == 0 &&
           fieldOffset == 0 && fieldSize == 8 &&
           fieldAlign == 8 &&
           valueScalarKind ==
               typearena.TypedExprStructuralScalarCString:
            return true
        if ordinal < 1 || ordinal > 3 ||
           valueScalarKind !=
               typearena.TypedExprStructuralScalarInt32 ||
           fieldSize != 4 || fieldAlign != 4:
            return false
        if ordinal == 1:
            return fieldOffset == 8
        if ordinal == 2:
            return fieldOffset == 12
        return fieldOffset == 16
    if builtinRaw == Int32(texpr.TypedExprLayoutBuiltinSequence) &&
       ownerKind == typearena.TypedExprStructuralTypeSequence:
        if (ordinal == 0 || ordinal == 1) &&
           fieldOffset == ordinal * 4 &&
           fieldSize == 4 && fieldAlign == 4 &&
           valueScalarKind ==
               typearena.TypedExprStructuralScalarInt32:
            return true
        return ordinal == 2 &&
               fieldOffset == 8 && fieldSize == 8 &&
               fieldAlign == 8 &&
               valueScalarKind ==
                   typearena.TypedExprStructuralScalarCString
    return false

# [phaseB-csg][r7-line] FieldGet 判词载荷富化探针（诊断仪，零语义变更）：
# 仅在 CHENG_FIELDGET_TRACE=1 时由 layout-authority 判点调用；默认路径判词
# 逐字节不变。补 fn/line/surface/callTarget/节点侧与权威侧布局字节+首个失
# 配列，消除「双臂逐字同=零归因」。
@borrows
fn compilerCsgFieldGetTracePayloadInto(
        ir: texpr.TypedExprIr,
        exact: CompilerCsgTypeDiagnosticCompletionTable,
        fieldRow: int32,
        nodeId: int32,
        ownerNodeId: int32,
        fieldSourceId: int32,
        ownerDeclarationRow: int32,
        fieldDeclarationRow: int32,
        fieldOrdinal: int32,
        builtinRaw: int32,
        fieldOffset: int32,
        fieldSize: int32,
        fieldAlign: int32,
        ownerTypeId: int32,
        valueTypeId: int32): str =
    var traceReason = "missingRow"
    var traceDiffCol = ""
    var aOffset: int32 = -1
    var aSize: int32 = -1
    var aAlign: int32 = -1
    if fieldRow >= 0:
        traceReason = "byteDiff"
        aOffset = exact.exactLayoutFieldOffsetBytes[fieldRow]
        aSize = exact.exactLayoutFieldSizeBytes[fieldRow]
        aAlign = exact.exactLayoutFieldAlignBytes[fieldRow]
        if exact.exactLayoutFieldSourceIds[fieldRow] != fieldSourceId:
            traceDiffCol = "sourceId"
        elif exact.exactLayoutFieldOwnerDeclarationSourceLocalRows[
                 fieldRow] != ownerDeclarationRow:
            traceDiffCol = "ownerDeclRow"
        elif exact.exactLayoutFieldDeclarationSourceLocalRows[
                 fieldRow] != fieldDeclarationRow:
            traceDiffCol = "fieldDeclRow"
        elif exact.exactLayoutFieldOrdinals[fieldRow] != fieldOrdinal:
            traceDiffCol = "ordinal"
        elif exact.exactLayoutFieldBuiltinKinds[fieldRow] != builtinRaw:
            traceDiffCol = "builtinRaw"
        elif aOffset != fieldOffset:
            traceDiffCol = "offset"
        elif aSize != fieldSize:
            traceDiffCol = "size"
        elif aAlign != fieldAlign:
            traceDiffCol = "align"
    var traceFn = ""
    if nodeId >= 0 && nodeId < ir.nodes2_functionNameIds.len:
        let traceFnRes: Result[str] = langintern.LookupIntern(
            ir.internPool, ir.nodes2_functionNameIds[nodeId])
        if IsOk(traceFnRes):
            traceFn = Value(traceFnRes)
    var traceSurface = ""
    if nodeId >= 0 && nodeId < ir.nodes2_surfaceTextIds.len:
        let traceSurfaceRes: Result[str] = langintern.LookupIntern(
            ir.internPool, ir.nodes2_surfaceTextIds[nodeId])
        if IsOk(traceSurfaceRes):
            traceSurface = Value(traceSurfaceRes)
    var traceCallTarget = ""
    if nodeId >= 0 && nodeId < ir.nodes2_callTargetIds.len:
        let traceCallTargetRes: Result[str] = langintern.LookupIntern(
            ir.internPool, ir.nodes2_callTargetIds[nodeId])
        if IsOk(traceCallTargetRes):
            traceCallTarget = Value(traceCallTargetRes)
    var traceOwnerType = ""
    if ownerNodeId >= 0 && ownerNodeId < ir.nodes2_resultTypeIds.len:
        let traceOwnerTypeRes: Result[str] = langintern.LookupIntern(
            ir.internPool, ir.nodes2_resultTypeIds[ownerNodeId])
        if IsOk(traceOwnerTypeRes):
            traceOwnerType = Value(traceOwnerTypeRes)
    var traceValueType = ""
    if nodeId >= 0 && nodeId < ir.nodes2_resultTypeIds.len:
        let traceValueTypeRes: Result[str] = langintern.LookupIntern(
            ir.internPool, ir.nodes2_resultTypeIds[nodeId])
        if IsOk(traceValueTypeRes):
            traceValueType = Value(traceValueTypeRes)
    let traceLine = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.nodes2_lineNumbers, nodeId)
    return Fmt" compiler csg: FieldGet layout is not in exact authority node={nodeId} reason={traceReason} diff={traceDiffCol} fn={traceFn} line={traceLine} surface={traceSurface} callTarget={traceCallTarget} src={fieldSourceId} ownerNode={ownerNodeId} ownerRow={ownerDeclarationRow} declRow={fieldDeclarationRow} ord={fieldOrdinal} builtin={builtinRaw} off={fieldOffset} size={fieldSize} align={fieldAlign} aOff={aOffset} aSize={aSize} aAlign={aAlign} ownerTypeId={ownerTypeId} valueTypeId={valueTypeId} ownerType={traceOwnerType} valueType={traceValueType}"

@borrows
fn compilerCsgLayoutAuthorityValidateInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        semanticGraph: CompilerCsgSemanticGraph,
        err: var str): bool =
    if !compilerCsgOwnershipAuthorityValidateInto(
           parserReceipt, typeArena, ir, semanticGraph, err):
        return false
    # Seal every legacy producer row into exact source/TypeArena coordinates.
    # FieldGet is only a consumer cross-check and never defines coverage.
    var exact: CompilerCsgTypeDiagnosticCompletionTable
    if !compilerCsgExactLayoutTableBuildInto(
           parserReceipt,
           typeArena,
           ir,
           exact,
           err) ||
       !compilerCsgExactLayoutTableStrictValidateInto(
           typeArena,
           ir,
           parserReceipt.sourceSidecars.len,
           exact,
           err):
        return false
    var declarationStarts: int32[]
    setLen(
        declarationStarts,
        parserReceipt.sourceSidecars.len + 1)
    for sourceId in 0..<parserReceipt.sourceSidecars.len:
        let declarationCount =
            parserReceipt.sourceSidecars[sourceId].declarationSourceLocalRows.len
        if declarationCount < 0 ||
           declarationStarts[sourceId] >
               2147483647 - declarationCount:
            err = " compiler csg: exact field declaration domain overflow"
            return false
        declarationStarts[sourceId + 1] =
            declarationStarts[sourceId] + declarationCount
    var declaredFieldRows: int32[]
    setLen(
        declaredFieldRows,
        declarationStarts[
            parserReceipt.sourceSidecars.len])
    for index in 0..<declaredFieldRows.len:
        declaredFieldRows[index] = -1
    var builtinFieldRows: int32[]
    setLen(
        builtinFieldRows,
        parserReceipt.sourceSidecars.len * 16)
    for index in 0..<builtinFieldRows.len:
        builtinFieldRows[index] = -1
    for fieldRow in 0..<exact.exactLayoutFieldSourceIds.len:
        let sourceId = exact.exactLayoutFieldSourceIds[fieldRow]
        let builtinRaw =
            exact.exactLayoutFieldBuiltinKinds[fieldRow]
        let ordinal = exact.exactLayoutFieldOrdinals[fieldRow]
        var directIndex: int32
        if builtinRaw == Int32(texpr.TypedExprLayoutBuiltinNone):
            let fieldDeclarationRow =
                exact.exactLayoutFieldDeclarationSourceLocalRows[
                    fieldRow]
            if fieldDeclarationRow < 0 ||
               fieldDeclarationRow >=
                   declarationStarts[sourceId + 1] -
                       declarationStarts[sourceId]:
                err = " compiler csg: exact field declaration direct index invalid"
                return false
            directIndex =
                declarationStarts[sourceId] + fieldDeclarationRow
            if declaredFieldRows[directIndex] >= 0:
                err = " compiler csg: duplicate exact field declaration coordinate"
                return false
            declaredFieldRows[directIndex] = fieldRow
        else:
            if builtinRaw < Int32(texpr.TypedExprLayoutBuiltinStr) ||
               builtinRaw >
                   Int32(texpr.TypedExprLayoutBuiltinOptional) ||
               ordinal < 0 || ordinal >= 4:
                err = " compiler csg: builtin field direct index invalid"
                return false
            directIndex =
                sourceId * 16 + builtinRaw * 4 + ordinal
            if builtinFieldRows[directIndex] >= 0:
                err = " compiler csg: duplicate builtin field coordinate"
                return false
            builtinFieldRows[directIndex] = fieldRow
    let nodeCount = ir.nodes2_nodeIndexs.len
    if ir.nodes2_fieldOffsetBytes.len != nodeCount ||
       ir.nodes2_fieldSizeBytes.len != nodeCount ||
       ir.nodes2_fieldAlignBytes.len != nodeCount ||
       ir.nodes2_fieldProducerSourceIndexes.len != nodeCount ||
       ir.nodes2_fieldOwnerDeclarationSourceLocalRows.len !=
           nodeCount ||
       ir.nodes2_fieldDeclarationSourceLocalRows.len != nodeCount ||
       ir.nodes2_fieldOrdinals.len != nodeCount ||
       ir.nodes2_fieldBuiltinKinds.len != nodeCount ||
       ir.nodes2_operand0NodeIndexs.len != nodeCount ||
       ir.nodes2_ownerProducerSourceIndexes.len != nodeCount ||
       ir.nodes2_exactTypeArenaIds.len != nodeCount ||
       ir.nodes2_opKinds.len != nodeCount:
        err = " compiler csg: exact node layout authority columns split"
        return false
    for nodeId in 0..<nodeCount:
        let fieldOffset = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldOffsetBytes, nodeId)
        let fieldSize = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldSizeBytes, nodeId)
        let fieldAlign = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldAlignBytes, nodeId)
        let hasFieldLayout =
            fieldOffset != 0 || fieldSize != 0 || fieldAlign != 0
        if !hasFieldLayout:
            continue
        if ir.nodes2_opKinds[nodeId] !=
               texpr.TypedExprIrOpFieldGet:
            err = Fmt" compiler csg: layout columns on non-FieldGet node={nodeId}"
            return false
        let ownerNodeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand0NodeIndexs, nodeId)
        let valueTypeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_exactTypeArenaIds, nodeId)
        if fieldOffset < 0 || fieldSize <= 0 || fieldAlign <= 0 ||
           ownerNodeId < 0 || ownerNodeId >= nodeCount ||
           valueTypeId < 0 || valueTypeId >= typeArena.typeCount:
            err = Fmt" compiler csg: exact node layout row invalid node={nodeId}"
            return false
        let ownerTypeId = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_exactTypeArenaIds, ownerNodeId)
        if ownerTypeId < 0 || ownerTypeId >= typeArena.typeCount:
            err = Fmt" compiler csg: exact layout owner TypeArena row invalid node={nodeId}"
            return false
        let fieldSourceId = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_fieldProducerSourceIndexes,
            nodeId)
        let ownerDeclarationRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_fieldOwnerDeclarationSourceLocalRows,
            nodeId)
        let fieldDeclarationRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_fieldDeclarationSourceLocalRows,
            nodeId)
        let fieldOrdinal = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldOrdinals, nodeId)
        let builtinRaw = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_fieldBuiltinKinds, nodeId)
        if fieldSourceId < 0 ||
           fieldSourceId >= parserReceipt.sourceSidecars.len ||
           fieldOrdinal < 0 ||
           builtinRaw < Int32(texpr.TypedExprLayoutBuiltinNone) ||
           builtinRaw > Int32(texpr.TypedExprLayoutBuiltinOptional):
            err = Fmt" compiler csg: FieldGet exact coordinate invalid node={nodeId}"
            return false
        var fieldRow: int32 = -1
        if builtinRaw == Int32(texpr.TypedExprLayoutBuiltinNone):
            let sourceDeclarationCount =
                declarationStarts[fieldSourceId + 1] -
                declarationStarts[fieldSourceId]
            if ownerDeclarationRow < 0 ||
               fieldDeclarationRow < 0 ||
               fieldDeclarationRow >= sourceDeclarationCount:
                err = Fmt" compiler csg: FieldGet declaration coordinate invalid node={nodeId}"
                return false
            fieldRow = declaredFieldRows[
                declarationStarts[fieldSourceId] +
                fieldDeclarationRow]
        else:
            if ownerDeclarationRow != -1 ||
               fieldDeclarationRow != -1 ||
               fieldOrdinal >= 4:
                err = Fmt" compiler csg: FieldGet builtin coordinate invalid node={nodeId}"
                return false
            fieldRow = builtinFieldRows[
                fieldSourceId * 16 +
                builtinRaw * 4 +
                fieldOrdinal]
        if fieldRow < 0 ||
           exact.exactLayoutFieldSourceIds[fieldRow] !=
               fieldSourceId ||
           exact.exactLayoutFieldOwnerDeclarationSourceLocalRows[
               fieldRow] != ownerDeclarationRow ||
           exact.exactLayoutFieldDeclarationSourceLocalRows[
               fieldRow] != fieldDeclarationRow ||
           exact.exactLayoutFieldOrdinals[fieldRow] != fieldOrdinal ||
           exact.exactLayoutFieldBuiltinKinds[fieldRow] !=
               builtinRaw ||
           exact.exactLayoutFieldOffsetBytes[fieldRow] !=
               fieldOffset ||
           exact.exactLayoutFieldSizeBytes[fieldRow] != fieldSize ||
           exact.exactLayoutFieldAlignBytes[fieldRow] != fieldAlign:
            if os.GetEnv("CHENG_FIELDGET_TRACE") == "1":
                err = compilerCsgFieldGetTracePayloadInto(
                    ir, exact, fieldRow, nodeId, ownerNodeId,
                    fieldSourceId, ownerDeclarationRow,
                    fieldDeclarationRow, fieldOrdinal, builtinRaw,
                    fieldOffset, fieldSize, fieldAlign, ownerTypeId,
                    valueTypeId)
            else:
                err = Fmt" compiler csg: FieldGet layout is not in exact authority node={nodeId}"
            return false
        if builtinRaw == Int32(texpr.TypedExprLayoutBuiltinNone):
            # [phaseB-csg] owner TypeId 双精确表示对账：exact 权威表按声明
            # 行 TypeSyntax root 绑定，alias 包装声明（`type N = tuple[...]`）
            # 存声明 TypeId 原样；typed-ir 节点侧的 owner 可能是包装链节点，
            # 经 physical 归一后与声明 TypeId 同一。两种表示都精确，任一
            # 相等即对账通过；否则 fail-closed。
            if exact.exactLayoutFieldOwnerTypeArenaIds[fieldRow] !=
                   ownerTypeId &&
                   exact.exactLayoutFieldOwnerTypeArenaIds[fieldRow] !=
                       compilerCsgExactLayoutPhysicalTypeId(
                           typeArena, ownerTypeId):
                err = Fmt" compiler csg: FieldGet TypeArena identity mismatch node={nodeId}"
                return false
            if exact.exactLayoutFieldTypeArenaIds[fieldRow] !=
                   valueTypeId:
                err = Fmt" compiler csg: FieldGet TypeArena identity mismatch node={nodeId}"
                return false
        elif !compilerCsgExactLayoutBuiltinFieldMatches(
               typeArena,
               builtinRaw,
               fieldOrdinal,
               ownerTypeId,
               valueTypeId,
               fieldOffset,
               fieldSize,
               fieldAlign):
            err = Fmt" compiler csg: FieldGet builtin identity mismatch node={nodeId}"
            return false
    err = ""
    return true

@borrows
fn compilerCsgLayoutAuthorityCidForSource(
        sourceId: int32,
        typeArena: typearena.TypedExprTypeArena,
        table: var CompilerCsgTypeDiagnosticCompletionTable): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    CompilerCsgAppendText(buf, CompilerCsgLayoutAuthorityDomain)
    CompilerCsgAppendFixed32(buf, typeArena.artifactRaw32)
    CompilerCsgAppendU32BE(buf, sourceId)
    if sourceId < 0 ||
       sourceId >= table.exactLayoutSourceRowStarts.len ||
       sourceId >= table.exactLayoutSourceRowCounts.len ||
       sourceId >= table.exactLayoutFieldSourceRowStarts.len ||
       sourceId >= table.exactLayoutFieldSourceRowCounts.len:
        panic("compiler csg: layout CID source CSR missing")
    let sourceTypeRowCount =
        table.exactLayoutSourceRowCounts[sourceId]
    CompilerCsgAppendU32BE(buf, sourceTypeRowCount)
    let typeStart = table.exactLayoutSourceRowStarts[sourceId]
    for offset in 0..<sourceTypeRowCount:
        let row =
            table.exactLayoutSourceRowIndexes[
                typeStart + offset]
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutProducerRowIds[row])
        CompilerCsgAppendU32BE(
            buf,
            table.exactLayoutDeclarationSourceLocalRows[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutBuiltinKinds[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutTypeArenaIds[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutSizeBytes[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutAlignBytes[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldCounts[row])
    let sourceFieldRowCount =
        table.exactLayoutFieldSourceRowCounts[sourceId]
    CompilerCsgAppendU32BE(buf, sourceFieldRowCount)
    let fieldStart =
        table.exactLayoutFieldSourceRowStarts[sourceId]
    for offset in 0..<sourceFieldRowCount:
        let row =
            table.exactLayoutFieldSourceRowIndexes[
                fieldStart + offset]
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldProducerRowIds[row])
        CompilerCsgAppendU32BE(
            buf,
            table.exactLayoutFieldOwnerDeclarationSourceLocalRows[
                row])
        CompilerCsgAppendU32BE(
            buf,
            table.exactLayoutFieldDeclarationSourceLocalRows[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldBuiltinKinds[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldMemberRows[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldOwnerTypeArenaIds[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldOrdinals[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldTypeArenaIds[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldOffsetBytes[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldSizeBytes[row])
        CompilerCsgAppendU32BE(
            buf, table.exactLayoutFieldAlignBytes[row])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgLayoutDiagnosticArtifactCid(
        ownershipStageReceiptCid: layout.FixedBytes32,
        table: CompilerCsgTypeDiagnosticCompletionTable): layout.FixedBytes32 =
    let sourceBytes = compilerCsgCheckedCapacityMul(
        table.sourceIds.len,
        192,
        "compiler csg: layout diagnostic artifact capacity overflow")
    let capacity = compilerCsgCheckedCapacityAdd(
        128,
        sourceBytes,
        "compiler csg: layout diagnostic artifact capacity overflow")
    var buf = layout.ByteBufInit(capacity)
    CompilerCsgAppendText(
        buf, CompilerCsgLayoutDiagnosticArtifactDomain)
    CompilerCsgAppendFixed32(buf, ownershipStageReceiptCid)
    CompilerCsgAppendU32BE(buf, table.sourceIds.len)
    for row in 0..<table.sourceIds.len:
        CompilerCsgAppendU32BE(buf, table.sourceIds[row])
        CompilerCsgAppendFixed32(buf, table.sourceIdentityCids[row])
        CompilerCsgAppendFixed32(buf, table.inputArtifactCids[row])
        CompilerCsgAppendFixed32(buf, table.outputArtifactCids[row])
        CompilerCsgAppendU32BE(buf, table.rowStarts[row])
        CompilerCsgAppendU32BE(buf, table.rowCounts[row])
        CompilerCsgAppendFixed32(
            buf, table.completionReceiptCids[row])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgLayoutDiagnosticStageProduceInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        semanticGraph: CompilerCsgSemanticGraph,
        ownershipStageReceipt: stage_receipt.CompilerStageReceipt,
        out: var CompilerCsgTypeDiagnosticCompletionTable,
        receipt: var stage_receipt.CompilerStageReceipt,
        err: var str): bool =
    let pendingRows = compilerCsgDiagnosticRowsPayloadClone(out)
    out = pendingRows
    receipt = stage_receipt.CompilerStageReceipt()
    let parserVerify =
        parser_receipt.ParserNormalizedExprReceiptVerify(parserReceipt)
    if IsErr(parserVerify):
        err = Error(parserVerify)
        return false
    let ownershipReceiptVerify =
        stage_receipt.CompilerStageReceiptVerify(
            ownershipStageReceipt)
    if IsErr(ownershipReceiptVerify) ||
       ownershipStageReceipt.stageKind !=
           stage_receipt.CompilerStageReceiptStageTypedExpr ||
       ownershipStageReceipt.producerIdentity !=
           CompilerCsgOwnershipDiagnosticProducerIdentity:
        err = IsErr(ownershipReceiptVerify) ?
            Error(ownershipReceiptVerify) :
            " compiler csg: layout predecessor is not ownership authority"
        return false
    if !compilerCsgLayoutAuthorityValidateInto(
           parserReceipt, typeArena, ir, semanticGraph, err):
        return false
    if !compilerCsgDiagnosticRowsPayloadStrictValidateInto(
           out, parserReceipt, err):
        return false
    if !compilerCsgExactLayoutTableBuildInto(
           parserReceipt,
           typeArena,
           ir,
           out,
           err) ||
       !compilerCsgExactLayoutTableStrictValidateInto(
           typeArena,
           ir,
           parserReceipt.sourceSidecars.len,
           out,
           err):
        return false
    var diagnosticCursor: int32
    for sourceId in 0..<parserReceipt.sourceSidecars.len:
        let sidecar = parserReceipt.sourceSidecars[sourceId]
        if sidecar.sourceIndex != sourceId ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err):
            if err == "":
                err = " compiler csg: layout diagnostic source invalid"
            return false
        add(out.sourceIds, sourceId)
        add(out.sourceIdentityCids, sidecar.sourceContentRaw32)
        add(out.inputArtifactCids,
            ownershipStageReceipt.artifactRaw32)
        add(out.outputArtifactCids,
            compilerCsgLayoutAuthorityCidForSource(
                sourceId, typeArena, out))
        var rowStart: int32
        var rowCount: int32
        if !compilerCsgDiagnosticSourceRangeInto(
               out,
               sourceId,
               diagnosticCursor,
               rowStart,
               rowCount,
               err):
            return false
        add(out.rowStarts, rowStart)
        add(out.rowCounts, rowCount)
        if !compilerCsgDiagnosticRowProofRangeAppendInto(
               parserReceipt,
               CompilerCsgLayoutDiagnosticProducerIdentity,
               out,
               out.sourceIds.len - 1,
               err):
            return false
        let completionReceiptCid =
            compilerCsgDiagnosticCompletionCid(
                CompilerCsgLayoutDiagnosticCompletionDomain,
                out,
                out.sourceIds.len - 1)
        if layout.FixedBytes32Equal(
               completionReceiptCid, layout.FixedBytes32()):
            err = " compiler csg: layout completion receipt missing"
            return false
        add(out.completionReceiptCids, completionReceiptCid)
    if diagnosticCursor != out.diagnosticSourceIds.len:
        err = " compiler csg: layout diagnostic source partition incomplete"
        return false
    let artifactCid =
        compilerCsgLayoutDiagnosticArtifactCid(
            ownershipStageReceipt.receiptRaw32, out)
    let exactLayoutRowCount =
        out.exactLayoutSourceIds.len +
        out.exactLayoutFieldSourceIds.len
    var countKeys: str[]
    var countValues: int64[]
    add(countKeys, "diagnostic_completion_count")
    add(countValues, Int64(out.sourceIds.len))
    add(countKeys, "diagnostic_row_count")
    add(countValues, Int64(out.diagnosticSourceIds.len))
    add(countKeys, "exact_layout_field_row_count")
    add(countValues, Int64(out.exactLayoutFieldSourceIds.len))
    add(countKeys, "exact_layout_row_count")
    add(countValues, Int64(exactLayoutRowCount))
    add(countKeys, "exact_layout_type_row_count")
    add(countValues, Int64(out.exactLayoutSourceIds.len))
    add(countKeys, "producer_source_count")
    add(countValues, Int64(typeArena.producerSourceCount))
    add(countKeys, "structural_type_count")
    add(countValues, Int64(typeArena.typeCount))
    let receiptResult = stage_receipt.CompilerStageReceiptMake(
        stage_receipt.CompilerStageReceiptStageTypedExpr,
        stage_receipt.CompilerStageReceiptLaneShared,
        CompilerCsgLayoutDiagnosticProducerIdentity,
        ownershipStageReceipt.receiptRaw32,
        artifactCid,
        countKeys,
        countValues)
    if IsErr(receiptResult):
        err = Error(receiptResult)
        return false
    receipt = Value(receiptResult)
    err = ""
    return true

@borrows
fn CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    if !CompilerCsgOwnershipDiagnosticCompletionStrictValidateInto(
           csg, err):
        return false
    var expected: CompilerCsgTypeDiagnosticCompletionTable
    expected = compilerCsgDiagnosticRowsPayloadClone(
        csg.layoutDiagnosticCompletions)
    var expectedReceipt: stage_receipt.CompilerStageReceipt
    if !compilerCsgLayoutDiagnosticStageProduceInto(
           csg.parserNormalizedExprReceipt,
           csg.typeArena,
           csg.typedIr,
           csg.semanticGraph,
           csg.ownershipDiagnosticStageReceipt,
           expected,
           expectedReceipt,
           err):
        return false
    if !compilerCsgDiagnosticCompletionTableEqual(
           csg.layoutDiagnosticCompletions, expected) ||
       !compilerCsgStageReceiptEqual(
           csg.layoutDiagnosticStageReceipt, expectedReceipt):
        err = " compiler csg: layout diagnostic authority replay mismatch"
        return false
    let receiptVerify =
        stage_receipt.CompilerStageReceiptVerify(
            csg.layoutDiagnosticStageReceipt)
    if IsErr(receiptVerify):
        err = Error(receiptVerify)
        return false
    err = ""
    return true

@borrows
fn compilerCsgParserExecutableFunctionRowForReachableInto(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        producerSourceIndex: int32,
        producerDeclarationOrdinal: int32,
        reachableFunctionIndex: int32,
        functionRow: var int32,
        err: var str): bool =
    functionRow = -1
    let functionCount = sidecar.functionDeclarationOrdinals.len
    if producerSourceIndex < 0 ||
       sidecar.sourceIndex != producerSourceIndex ||
       producerDeclarationOrdinal < 0 ||
       reachableFunctionIndex < 0 ||
       sidecar.functionIndexes.len != functionCount ||
       sidecar.functionAnnotationFlags.len != functionCount:
        err = Fmt" compiler csg: thread-boundary executable function domain invalid source={producerSourceIndex} declaration_ordinal={producerDeclarationOrdinal} function={reachableFunctionIndex}"
        return false
    # The canonical sidecar validator proves this ordinal column is strictly
    # increasing.  It is the executable-function domain; declarationFunctionRows
    # instead maps source-local declaration rows into the wider function domain
    # that also contains importc declarations.  Never cross-index those arenas.
    var low: int32
    var high = functionCount
    while low < high:
        let middle = low + (high - low) / 2
        if sidecar.functionDeclarationOrdinals[middle] <
               producerDeclarationOrdinal:
            low = middle + 1
        else:
            high = middle
    if low < 0 || low >= functionCount ||
       sidecar.functionDeclarationOrdinals[low] !=
           producerDeclarationOrdinal ||
       sidecar.functionIndexes[low] != reachableFunctionIndex:
        err = Fmt" compiler csg: thread-boundary exact function join missing function={reachableFunctionIndex} source={producerSourceIndex} declaration_ordinal={producerDeclarationOrdinal} row={low}"
        return false
    functionRow = low
    err = ""
    return true

@borrows
fn compilerCsgConcurrencyAuthorityValidateInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        semanticGraph: CompilerCsgSemanticGraph,
        err: var str): bool =
    if !compilerCsgLayoutAuthorityValidateInto(
           parserReceipt, typeArena, ir, semanticGraph, err):
        return false
    let reachableCount =
        semanticGraph.reachableFunctionTable.graphNodeIds.len
    if semanticGraph.reachableFunctionTable.producerSourceIndexes.len !=
           reachableCount ||
       semanticGraph.reachableFunctionTable.producerDeclarationIndexes.len !=
           reachableCount:
        err = " compiler csg: concurrency reachable-function domain split"
        return false
    for sourceId in 0..<parserReceipt.sourceSidecars.len:
        let sidecar = parserReceipt.sourceSidecars[sourceId]
        if sidecar.functionAnnotationFlags.len !=
               sidecar.functionIndexes.len:
            err = Fmt" compiler csg: thread-boundary source column split source={sourceId}"
            return false
    for reachableId in 0..<reachableCount:
        let sourceId =
            semanticGraph.reachableFunctionTable.producerSourceIndexes[
                reachableId]
        let declarationId =
            semanticGraph.reachableFunctionTable.producerDeclarationIndexes[
                reachableId]
        if sourceId < 0 ||
           sourceId >= parserReceipt.sourceSidecars.len:
            err = Fmt" compiler csg: thread-boundary source invalid function={reachableId}"
            return false
        let sidecar = parserReceipt.sourceSidecars[sourceId]
        var localFunctionId: int32
        if !compilerCsgParserExecutableFunctionRowForReachableInto(
               sidecar,
               sourceId,
               declarationId,
               reachableId,
               localFunctionId,
               err):
            return false
    err = ""
    return true

@borrows
fn compilerCsgConcurrencyAuthorityCidForSource(
        sourceId: int32,
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        semanticGraph: CompilerCsgSemanticGraph,
        typeSyntaxRowStarts: var int32[],
        typeSyntaxRowCounts: var int32[],
        typeSyntaxRowIds: var int32[],
        nodeRowStarts: var int32[],
        nodeRowCounts: var int32[],
        nodeRowIds: var int32[],
        functionRowStarts: var int32[],
        functionRowCounts: var int32[],
        functionRowIds: var int32[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    CompilerCsgAppendText(buf, CompilerCsgConcurrencyAuthorityDomain)
    CompilerCsgAppendFixed32(buf, typeArena.artifactRaw32)
    CompilerCsgAppendU32BE(buf, sourceId)
    if sourceId < 0 ||
       sourceId >= typeSyntaxRowStarts.len ||
       sourceId >= typeSyntaxRowCounts.len ||
       sourceId >= nodeRowStarts.len ||
       sourceId >= nodeRowCounts.len ||
       sourceId >= functionRowStarts.len ||
       sourceId >= functionRowCounts.len:
        panic("compiler csg: concurrency CID source CSR missing")
    let sourceTypeSyntaxCount =
        typeSyntaxRowCounts[sourceId]
    CompilerCsgAppendU32BE(buf, sourceTypeSyntaxCount)
    let typeSyntaxStart = typeSyntaxRowStarts[sourceId]
    for sourceLocalTypeSyntaxId in 0..<sourceTypeSyntaxCount:
        let typeSyntaxId =
            typeSyntaxRowIds[
                typeSyntaxStart + sourceLocalTypeSyntaxId]
        let typeId =
            typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                typeArena, typeSyntaxId)
        CompilerCsgAppendU32BE(buf, sourceLocalTypeSyntaxId)
        CompilerCsgAppendU32BE(buf, typeSyntaxId)
        CompilerCsgAppendU32BE(buf, typeId)
        CompilerCsgAppendU32BE(
            buf,
            typearena.TypedExprTypeArenaSendAt(
                typeArena, typeId) ? 1 : 0)
        CompilerCsgAppendU32BE(
            buf,
            typearena.TypedExprTypeArenaSyncAt(
                typeArena, typeId) ? 1 : 0)
    let sourceNodeCount = nodeRowCounts[sourceId]
    CompilerCsgAppendU32BE(buf, sourceNodeCount)
    let nodeStart = nodeRowStarts[sourceId]
    for offset in 0..<sourceNodeCount:
        let nodeId = nodeRowIds[nodeStart + offset]
        CompilerCsgAppendU32BE(buf, nodeId)
        CompilerCsgAppendU32BE(
            buf,
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_exactTypeArenaIds,
                nodeId))
        CompilerCsgAppendU32BE(
            buf, ir.nodes2_resultTypeSendFlags[nodeId] ? 1 : 0)
        CompilerCsgAppendU32BE(
            buf, ir.nodes2_resultTypeSyncFlags[nodeId] ? 1 : 0)
    let sourceFunctionCount = functionRowCounts[sourceId]
    CompilerCsgAppendU32BE(buf, sourceFunctionCount)
    let sidecar = parserReceipt.sourceSidecars[sourceId]
    let functionStart = functionRowStarts[sourceId]
    for offset in 0..<sourceFunctionCount:
        let reachableId =
            functionRowIds[functionStart + offset]
        let declarationId =
            semanticGraph.reachableFunctionTable.producerDeclarationIndexes[
                reachableId]
        var localFunctionId: int32
        var joinErr: str
        if !compilerCsgParserExecutableFunctionRowForReachableInto(
               sidecar,
               sourceId,
               declarationId,
               reachableId,
               localFunctionId,
               joinErr):
            panic("compiler csg: concurrency CID exact function join drift")
        CompilerCsgAppendU32BE(buf, reachableId)
        CompilerCsgAppendU32BE(
            buf,
            semanticGraph.reachableFunctionTable.graphNodeIds[
                reachableId])
        CompilerCsgAppendU32BE(buf, declarationId)
        CompilerCsgAppendU32BE(buf, localFunctionId)
        let threadBoundary =
            (sidecar.functionAnnotationFlags[localFunctionId] &
                 parser.ParserFunctionAnnotationThreadBoundary) != 0
        CompilerCsgAppendU32BE(
            buf, threadBoundary ? 1 : 0)
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgConcurrencyDiagnosticArtifactCid(
        layoutStageReceiptCid: layout.FixedBytes32,
        table: CompilerCsgTypeDiagnosticCompletionTable): layout.FixedBytes32 =
    let sourceBytes = compilerCsgCheckedCapacityMul(
        table.sourceIds.len,
        192,
        "compiler csg: concurrency diagnostic artifact capacity overflow")
    let capacity = compilerCsgCheckedCapacityAdd(
        128,
        sourceBytes,
        "compiler csg: concurrency diagnostic artifact capacity overflow")
    var buf = layout.ByteBufInit(capacity)
    CompilerCsgAppendText(
        buf, CompilerCsgConcurrencyDiagnosticArtifactDomain)
    CompilerCsgAppendFixed32(buf, layoutStageReceiptCid)
    CompilerCsgAppendU32BE(buf, table.sourceIds.len)
    for row in 0..<table.sourceIds.len:
        CompilerCsgAppendU32BE(buf, table.sourceIds[row])
        CompilerCsgAppendFixed32(buf, table.sourceIdentityCids[row])
        CompilerCsgAppendFixed32(buf, table.inputArtifactCids[row])
        CompilerCsgAppendFixed32(buf, table.outputArtifactCids[row])
        CompilerCsgAppendU32BE(buf, table.rowStarts[row])
        CompilerCsgAppendU32BE(buf, table.rowCounts[row])
        CompilerCsgAppendFixed32(
            buf, table.completionReceiptCids[row])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgConcurrencyDiagnosticStageProduceInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        ir: texpr.TypedExprIr,
        semanticGraph: CompilerCsgSemanticGraph,
        layoutStageReceipt: stage_receipt.CompilerStageReceipt,
        out: var CompilerCsgTypeDiagnosticCompletionTable,
        receipt: var stage_receipt.CompilerStageReceipt,
        err: var str): bool =
    let pendingRows = compilerCsgDiagnosticRowsPayloadClone(out)
    out = pendingRows
    receipt = stage_receipt.CompilerStageReceipt()
    let parserVerify =
        parser_receipt.ParserNormalizedExprReceiptVerify(parserReceipt)
    if IsErr(parserVerify):
        err = Error(parserVerify)
        return false
    let layoutReceiptVerify =
        stage_receipt.CompilerStageReceiptVerify(layoutStageReceipt)
    if IsErr(layoutReceiptVerify) ||
       layoutStageReceipt.stageKind !=
           stage_receipt.CompilerStageReceiptStageTypedExpr ||
       layoutStageReceipt.producerIdentity !=
           CompilerCsgLayoutDiagnosticProducerIdentity:
        err = IsErr(layoutReceiptVerify) ?
            Error(layoutReceiptVerify) :
            " compiler csg: concurrency predecessor is not layout authority"
        return false
    if !compilerCsgConcurrencyAuthorityValidateInto(
           parserReceipt, typeArena, ir, semanticGraph, err):
        return false
    if !compilerCsgDiagnosticRowsPayloadStrictValidateInto(
           out, parserReceipt, err):
        return false
    let sourceCount = parserReceipt.sourceSidecars.len
    var typeSyntaxSourceIds: int32[]
    setLen(typeSyntaxSourceIds, typeArena.typeSyntaxCount)
    for typeSyntaxId in 0..<typeArena.typeSyntaxCount:
        typeSyntaxSourceIds[typeSyntaxId] =
            arenamod.ArenaArrayInt32Get(
                typeArena.arena,
                typeArena.typeSyntaxProducerSourceIndexes,
                typeSyntaxId)
    var typeSyntaxRowStarts: int32[]
    var typeSyntaxRowCounts: int32[]
    var typeSyntaxRowIds: int32[]
    if !compilerCsgSourceRowsBuildInto(
           typeSyntaxSourceIds,
           sourceCount,
           typeSyntaxRowStarts,
           typeSyntaxRowCounts,
           typeSyntaxRowIds,
           err):
        return false
    var nodeSourceIds: int32[]
    setLen(nodeSourceIds, ir.nodes2_nodeIndexs.len)
    for nodeId in 0..<nodeSourceIds.len:
        nodeSourceIds[nodeId] = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_ownerProducerSourceIndexes,
            nodeId)
    var nodeRowStarts: int32[]
    var nodeRowCounts: int32[]
    var nodeRowIds: int32[]
    if !compilerCsgSourceRowsBuildInto(
           nodeSourceIds,
           sourceCount,
           nodeRowStarts,
           nodeRowCounts,
           nodeRowIds,
           err):
        return false
    let reachableCount =
        semanticGraph.reachableFunctionTable.graphNodeIds.len
    var functionSourceIds: int32[]
    setLen(functionSourceIds, reachableCount)
    for reachableId in 0..<reachableCount:
        functionSourceIds[reachableId] =
            semanticGraph.reachableFunctionTable.producerSourceIndexes[
                reachableId]
    var functionRowStarts: int32[]
    var functionRowCounts: int32[]
    var functionRowIds: int32[]
    if !compilerCsgSourceRowsBuildInto(
           functionSourceIds,
           sourceCount,
           functionRowStarts,
           functionRowCounts,
           functionRowIds,
           err):
        return false
    var diagnosticCursor: int32
    for sourceId in 0..<parserReceipt.sourceSidecars.len:
        let sidecar = parserReceipt.sourceSidecars[sourceId]
        if sidecar.sourceIndex != sourceId ||
           !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err):
            if err == "":
                err = " compiler csg: concurrency diagnostic source invalid"
            return false
        add(out.sourceIds, sourceId)
        add(out.sourceIdentityCids, sidecar.sourceContentRaw32)
        add(out.inputArtifactCids, layoutStageReceipt.artifactRaw32)
        add(out.outputArtifactCids,
            compilerCsgConcurrencyAuthorityCidForSource(
                sourceId,
                parserReceipt,
                typeArena,
                ir,
                semanticGraph,
                typeSyntaxRowStarts,
                typeSyntaxRowCounts,
                typeSyntaxRowIds,
                nodeRowStarts,
                nodeRowCounts,
                nodeRowIds,
                functionRowStarts,
                functionRowCounts,
                functionRowIds))
        var rowStart: int32
        var rowCount: int32
        if !compilerCsgDiagnosticSourceRangeInto(
               out,
               sourceId,
               diagnosticCursor,
               rowStart,
               rowCount,
               err):
            return false
        add(out.rowStarts, rowStart)
        add(out.rowCounts, rowCount)
        if !compilerCsgDiagnosticRowProofRangeAppendInto(
               parserReceipt,
               CompilerCsgConcurrencyDiagnosticProducerIdentity,
               out,
               out.sourceIds.len - 1,
               err):
            return false
        let completionReceiptCid =
            compilerCsgDiagnosticCompletionCid(
                CompilerCsgConcurrencyDiagnosticCompletionDomain,
                out,
                out.sourceIds.len - 1)
        if layout.FixedBytes32Equal(
               completionReceiptCid, layout.FixedBytes32()):
            err = " compiler csg: concurrency completion receipt missing"
            return false
        add(out.completionReceiptCids, completionReceiptCid)
    if diagnosticCursor != out.diagnosticSourceIds.len:
        err = " compiler csg: concurrency diagnostic source partition incomplete"
        return false
    var sendTypeCount: int32
    var syncTypeCount: int32
    for typeId in 0..<typeArena.typeCount:
        if typearena.TypedExprTypeArenaSendAt(typeArena, typeId):
            sendTypeCount = sendTypeCount + 1
        if typearena.TypedExprTypeArenaSyncAt(typeArena, typeId):
            syncTypeCount = syncTypeCount + 1
    var threadBoundaryCount: int32
    for sourceId in 0..<parserReceipt.sourceSidecars.len:
        let flags =
            parserReceipt.sourceSidecars[
                sourceId].functionAnnotationFlags
        for functionId in 0..<flags.len:
            if (flags[functionId] &
                    parser.ParserFunctionAnnotationThreadBoundary) != 0:
                threadBoundaryCount = threadBoundaryCount + 1
    let artifactCid =
        compilerCsgConcurrencyDiagnosticArtifactCid(
            layoutStageReceipt.receiptRaw32, out)
    var countKeys: str[]
    var countValues: int64[]
    add(countKeys, "diagnostic_completion_count")
    add(countValues, Int64(out.sourceIds.len))
    add(countKeys, "diagnostic_row_count")
    add(countValues, Int64(out.diagnosticSourceIds.len))
    add(countKeys, "producer_source_count")
    add(countValues, Int64(typeArena.producerSourceCount))
    add(countKeys, "send_type_count")
    add(countValues, Int64(sendTypeCount))
    add(countKeys, "sync_type_count")
    add(countValues, Int64(syncTypeCount))
    add(countKeys, "thread_boundary_count")
    add(countValues, Int64(threadBoundaryCount))
    add(countKeys, "typed_node_count")
    add(countValues, Int64(ir.nodes2_nodeIndexs.len))
    let receiptResult = stage_receipt.CompilerStageReceiptMake(
        stage_receipt.CompilerStageReceiptStageTypedExpr,
        stage_receipt.CompilerStageReceiptLaneShared,
        CompilerCsgConcurrencyDiagnosticProducerIdentity,
        layoutStageReceipt.receiptRaw32,
        artifactCid,
        countKeys,
        countValues)
    if IsErr(receiptResult):
        err = Error(receiptResult)
        return false
    receipt = Value(receiptResult)
    err = ""
    return true

@borrows
fn CompilerCsgConcurrencyDiagnosticCompletionStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    if !CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(csg, err):
        return false
    var expected: CompilerCsgTypeDiagnosticCompletionTable
    expected = compilerCsgDiagnosticRowsPayloadClone(
        csg.concurrencyDiagnosticCompletions)
    var expectedReceipt: stage_receipt.CompilerStageReceipt
    if !compilerCsgConcurrencyDiagnosticStageProduceInto(
           csg.parserNormalizedExprReceipt,
           csg.typeArena,
           csg.typedIr,
           csg.semanticGraph,
           csg.layoutDiagnosticStageReceipt,
           expected,
           expectedReceipt,
           err):
        return false
    if !compilerCsgDiagnosticCompletionTableEqual(
           csg.concurrencyDiagnosticCompletions, expected) ||
       !compilerCsgStageReceiptEqual(
           csg.concurrencyDiagnosticStageReceipt, expectedReceipt):
        err = " compiler csg: concurrency diagnostic authority replay mismatch"
        return false
    let receiptVerify =
        stage_receipt.CompilerStageReceiptVerify(
            csg.concurrencyDiagnosticStageReceipt)
    if IsErr(receiptVerify):
        err = Error(receiptVerify)
        return false
    err = ""
    return true

@borrows
fn compilerCsgPortableAppendU32Field(buf: var layout.ByteBuf,
                                     value: int32) =
    CompilerCsgAppendU32BE(buf, 4)
    CompilerCsgAppendU32BE(buf, value)

@borrows
fn compilerCsgPortableAppendFixed32Field(
        buf: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    CompilerCsgAppendU32BE(buf, 32)
    CompilerCsgAppendFixed32(buf, value)

@borrows
fn compilerCsgPortableSemanticTextCid(domain: str,
                                      value: str): layout.FixedBytes32 =
    let domainCapacity = compilerCsgCheckedCapacityAdd(
        domain.len,
        value.len,
        "compiler csg: portable semantic text capacity overflow")
    let capacity = compilerCsgCheckedCapacityAdd(
        domainCapacity,
        8,
        "compiler csg: portable semantic text capacity overflow")
    var buf: layout.ByteBuf = layout.ByteBufInit(capacity)
    CompilerCsgAppendText(buf, domain)
    CompilerCsgAppendText(buf, value)
    return CompilerCsgBufCid(buf)

@borrows
fn CompilerCsgPortableSourcePackageIdCid(
        sourcePackageId: str): layout.FixedBytes32 =
    return compilerCsgPortableSemanticTextCid(
        "cheng.compiler.source_package_id",
        sourcePackageId)

@borrows
fn CompilerCsgPortableEntryModulePathCid(
        entryModulePath: str): layout.FixedBytes32 =
    return compilerCsgPortableSemanticTextCid(
        "cheng.compiler.entry_module_path",
        entryModulePath)

@borrows
fn compilerCsgPortableSourceIdentityReceiptCid(
        receipt: PortableSourceIdentityReceipt): layout.FixedBytes32 =
    let capacity = compilerCsgCheckedCapacityAdd(
        CompilerCsgPortableSourceIdentityReceiptWireByteLength,
        64,
        "compiler csg: portable source receipt capacity overflow")
    var buf: layout.ByteBuf = layout.ByteBufInit(capacity)
    CompilerCsgAppendText(
        buf,
        "cheng.compiler.portable_source_identity_receipt")
    compilerCsgPortableAppendU32Field(buf, receipt.sourceSnapshotCount)
    compilerCsgPortableAppendU32Field(buf, receipt.importEdgeCount)
    compilerCsgPortableAppendU32Field(buf, receipt.unresolvedImportCount)
    compilerCsgPortableAppendFixed32Field(buf, receipt.sourcePackageIdCid)
    compilerCsgPortableAppendFixed32Field(buf, receipt.entryModulePathCid)
    compilerCsgPortableAppendFixed32Field(buf, receipt.sourceBundleCid)
    compilerCsgPortableAppendFixed32Field(buf, receipt.entrySourceCid)
    compilerCsgPortableAppendFixed32Field(buf, receipt.importGraphCid)
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgPortableModulePathValid(modulePath: str): bool =
    if !parser.ParserSourceIdentityModuleTextValid(modulePath) ||
       modulePath == "" || modulePath[0] == '/' || modulePath[0] == '\\' ||
       modulePath[modulePath.len - 1] == '/':
        return false
    var segmentStart: int32
    for index in 0..<modulePath.len:
        let code = Int32(modulePath[index])
        if modulePath[index] == '\\' || modulePath[index] == ':' ||
           code <= 32 || code == 127:
            return false
        if modulePath[index] != '/':
            continue
        if index <= segmentStart:
            return false
        let segment = chengpath.TextSlice(modulePath,
                                          segmentStart,
                                          index - segmentStart)
        if segment == "." || segment == "..":
            return false
        segmentStart = index + 1
    let tail = chengpath.TextSlice(modulePath,
                                   segmentStart,
                                   modulePath.len - segmentStart)
    if tail == "." || tail == "..":
        return false
    return true

@borrows
fn PortableSourceIdentityReceiptStrictValidateInto(
        receipt: PortableSourceIdentityReceipt,
        err: var str): bool =
    if receipt.sourceSnapshotCount <= 0 || receipt.importEdgeCount < 0 ||
       receipt.unresolvedImportCount != 0:
        err = Fmt" compiler csg: portable source receipt counts invalid snapshots={receipt.sourceSnapshotCount} imports={receipt.importEdgeCount} unresolved={receipt.unresolvedImportCount}"
        return false
    if layout.FixedBytes32Equal(receipt.sourcePackageIdCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(receipt.entryModulePathCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(receipt.sourceBundleCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(receipt.entrySourceCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(receipt.importGraphCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(receipt.receiptCid,
                                layout.FixedBytes32()):
        err = " compiler csg: portable source receipt contains zero cid"
        return false
    let expectedReceiptCid =
        compilerCsgPortableSourceIdentityReceiptCid(receipt)
    if !layout.FixedBytes32Equal(receipt.receiptCid,
                                 expectedReceiptCid):
        err = " compiler csg: portable source receipt cid mismatch"
        return false
    err = ""
    return true

@borrows
fn PortableSourceIdentityReceiptMakeInto(
        sourceSnapshotCount: int32,
        importEdgeCount: int32,
        unresolvedImportCount: int32,
        sourcePackageId: str,
        entryModulePath: str,
        sourceBundleCid: layout.FixedBytes32,
        entrySourceCid: layout.FixedBytes32,
        importGraphCid: layout.FixedBytes32,
        outReceipt: var PortableSourceIdentityReceipt,
        err: var str): bool =
    if sourcePackageId == "" ||
       parser.ParserManifestNormalizePackageId(sourcePackageId) !=
           sourcePackageId:
        err = Fmt" compiler csg: portable source receipt package id is not canonical package={sourcePackageId}"
        return false
    # Entry identity is either an exact module path or, for root-out
    # sources, the canonical absolute source file path; the two domains can
    # never collide because module paths are never absolute.
    if !parser.ParserSourceIdentityPathAbsolute(entryModulePath) &&
       !compilerCsgPortableModulePathValid(entryModulePath):
        err = Fmt" compiler csg: portable source receipt entry module path invalid module={entryModulePath}"
        return false
    var next: PortableSourceIdentityReceipt
    next.sourceSnapshotCount = sourceSnapshotCount
    next.importEdgeCount = importEdgeCount
    next.unresolvedImportCount = unresolvedImportCount
    next.sourcePackageIdCid =
        CompilerCsgPortableSourcePackageIdCid(sourcePackageId)
    next.entryModulePathCid =
        CompilerCsgPortableEntryModulePathCid(entryModulePath)
    next.sourceBundleCid = sourceBundleCid
    next.entrySourceCid = entrySourceCid
    next.importGraphCid = importGraphCid
    next.receiptCid = compilerCsgPortableSourceIdentityReceiptCid(next)
    if !PortableSourceIdentityReceiptStrictValidateInto(next, err):
        return false
    outReceipt = next
    err = ""
    return true

fn PortableSourceIdentityReceiptMoveInto(
        target: var PortableSourceIdentityReceipt,
        source: var PortableSourceIdentityReceipt) =
    target = source
    source = PortableSourceIdentityReceipt()

fn PortableSourceIdentityReceiptClone(
        receipt: var PortableSourceIdentityReceipt):
        PortableSourceIdentityReceipt =
    var out: PortableSourceIdentityReceipt
    out.sourceSnapshotCount = receipt.sourceSnapshotCount
    out.importEdgeCount = receipt.importEdgeCount
    out.unresolvedImportCount = receipt.unresolvedImportCount
    out.sourcePackageIdCid =
        layout.FixedBytes32Copy(receipt.sourcePackageIdCid)
    out.entryModulePathCid =
        layout.FixedBytes32Copy(receipt.entryModulePathCid)
    out.sourceBundleCid =
        layout.FixedBytes32Copy(receipt.sourceBundleCid)
    out.entrySourceCid =
        layout.FixedBytes32Copy(receipt.entrySourceCid)
    out.importGraphCid =
        layout.FixedBytes32Copy(receipt.importGraphCid)
    out.receiptCid =
        layout.FixedBytes32Copy(receipt.receiptCid)
    return out

fn compilerCsgTransitionReceiptCid(
        receipt: var CompilerCsgTransitionReceipt): layout.FixedBytes32 =
    let capacity = compilerCsgCheckedCapacityAdd(
        CompilerCsgTransitionReceiptWireByteLength,
        64,
        "compiler csg: transition receipt capacity overflow")
    var buf: layout.ByteBuf = layout.ByteBufInit(capacity)
    CompilerCsgAppendText(buf,
                          "cheng.compiler.csg_transition_receipt")
    compilerCsgPortableAppendFixed32Field(
        buf,
        receipt.sourceIdentityReceiptCid)
    compilerCsgPortableAppendFixed32Field(buf, receipt.parserReceiptCid)
    compilerCsgPortableAppendFixed32Field(buf, receipt.compilerCsgCid)
    compilerCsgPortableAppendFixed32Field(
        buf,
        receipt.canonicalCompilerCsgCid)
    return CompilerCsgBufCid(buf)

fn CompilerCsgTransitionReceiptPortableFromEvidence(
        receipt: var CompilerCsgTransitionReceipt,
        portableParser: parser_receipt.PortableParserReceipt,
        sourceReceipt: var PortableSourceIdentityReceipt,
        err: var str): bool =
    if !parser_receipt.PortableParserReceiptStrictValidateInto(
           portableParser, err):
        return false
    if !PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt, err):
        return false
    if layout.FixedBytes32Equal(receipt.parserReceiptCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(receipt.receiptCid, layout.FixedBytes32()):
        err = " compiler csg: transition receipt missing predecessor cid"
        return false
    if !layout.FixedBytes32Equal(receipt.parserReceiptCid,
                                 portableParser.receiptCid):
        err = " compiler csg: transition still binds local parser receipt cid"
        return false
    err = " compiler csg: transition portable requires lowering authority recomputation"
    return false

fn CompilerCsgTransitionReceiptMakeInto(
        sourceReceipt: var PortableSourceIdentityReceipt,
        parserReceiptCid: layout.FixedBytes32,
        compilerCsgCid: layout.FixedBytes32,
        canonicalCompilerCsgCid: layout.FixedBytes32,
        outReceipt: var CompilerCsgTransitionReceipt,
        err: var str): bool =
    if !PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt, err):
        return false
    if layout.FixedBytes32Equal(parserReceiptCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(compilerCsgCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(canonicalCompilerCsgCid,
                                layout.FixedBytes32()):
        err = " compiler csg: transition receipt contains zero predecessor/artifact cid"
        return false
    var next: CompilerCsgTransitionReceipt
    next.sourceIdentityReceiptCid = sourceReceipt.receiptCid
    next.parserReceiptCid = parserReceiptCid
    next.compilerCsgCid = compilerCsgCid
    next.canonicalCompilerCsgCid = canonicalCompilerCsgCid
    next.receiptCid = compilerCsgTransitionReceiptCid(next)
    outReceipt = next
    err = ""
    return true

fn CompilerCsgTransitionReceiptClone(
        receipt: var CompilerCsgTransitionReceipt):
        CompilerCsgTransitionReceipt =
    var out: CompilerCsgTransitionReceipt
    out.sourceIdentityReceiptCid =
        layout.FixedBytes32Copy(receipt.sourceIdentityReceiptCid)
    out.parserReceiptCid =
        layout.FixedBytes32Copy(receipt.parserReceiptCid)
    out.compilerCsgCid =
        layout.FixedBytes32Copy(receipt.compilerCsgCid)
    out.canonicalCompilerCsgCid =
        layout.FixedBytes32Copy(receipt.canonicalCompilerCsgCid)
    out.receiptCid =
        layout.FixedBytes32Copy(receipt.receiptCid)
    return out

@borrows
fn compilerCsgPortableArtifactTypedIrStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    let functionCount = csg.typedIr.functions2_functionNameIds.len
    if !texpr.TypedExprIrFunctions2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrScopes2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrNodes2ShapeComplete(csg.typedIr) ||
       !texpr.TypedExprIrStatements2ShapeComplete(csg.typedIr) ||
       !CompilerCsgValidateTypedIrReachabilityFunctionColumns(csg.typedIr,
                                                               err) ||
       !CompilerCsgValidateTypedIrReachabilityStatementColumns(csg.typedIr,
                                                                err):
        if err == "":
            err = " compiler csg: portable artifact TypedIR is empty or structurally invalid"
        return false
    if !texpr.TypedExprIrOriginProofStrictValidateInto(csg.typedIr, err):
        return false
    let table = csg.semanticGraph.typedIrTable
    if table.functionSourceIndexes.len != functionCount ||
       table.functionGraphNodeIds.len != functionCount ||
       table.functionNames.len != functionCount ||
       table.functionNodeStart.len != functionCount ||
       table.functionNodeCount.len != functionCount ||
       table.functionStatementStart.len != functionCount ||
       table.functionStatementCount.len != functionCount:
        err = " compiler csg: portable artifact TypedIR projection columns mismatch"
        return false
    let reachableCount = csg.semanticGraph.reachableFunctionTable.functionNames.len
    if csg.semanticGraph.reachableFunctionTable.sourceIndex.len != reachableCount ||
       csg.semanticGraph.reachableFunctionTable.producerSourceIndexes.len !=
           reachableCount ||
       csg.semanticGraph.reachableFunctionTable.producerDeclarationIndexes.len !=
           reachableCount ||
       csg.semanticGraph.reachableFunctionTable.functionNameSurfaceKinds.len !=
           reachableCount ||
       csg.semanticGraph.reachableFunctionTable.functionNameProofCids.len !=
           reachableCount ||
       csg.semanticGraph.reachableFunctionTable.functionAnnotationFlags.len !=
           reachableCount ||
       csg.semanticGraph.reachableFunctionTable.functionDeclarationHeaderCids.len !=
           reachableCount ||
       csg.semanticGraph.reachableFunctionTable.functionDeclarationPathCids.len !=
           reachableCount ||
       csg.semanticGraph.reachableFunctionTable.keepExportBindingCids.len !=
           reachableCount ||
       csg.semanticGraph.reachableFunctionTable.sourcePaths.len != reachableCount ||
       csg.semanticGraph.reachableFunctionTable.symbolTexts.len != reachableCount ||
       csg.semanticGraph.reachableFunctionTable.startLines.len != reachableCount ||
       csg.semanticGraph.reachableFunctionTable.endLines.len != reachableCount ||
       csg.semanticGraph.reachableFunctionTable.reachable.len != reachableCount ||
       csg.semanticGraph.reachableFunctionTable.graphNodeIds.len != reachableCount:
        err = " compiler csg: portable artifact reachable-function columns mismatch"
        return false
    for functionIndex in 0..<functionCount:
        if functionIndex % 1024 == 0:
            os.ProcessResourceGuardCheck()
        let sourcePathRes = langintern.LookupIntern(
            csg.typedIr.internPool,
            csg.typedIr.functions2_sourcePathIds[functionIndex])
        let functionNameRes = langintern.LookupIntern(
            csg.typedIr.internPool,
            csg.typedIr.functions2_functionNameIds[functionIndex])
        if IsErr(sourcePathRes) || IsErr(functionNameRes):
            err = Fmt" compiler csg: portable artifact TypedIR intern identity missing function={functionIndex}"
            return false
        let sourceIndex = table.functionSourceIndexes[functionIndex]
        let graphNodeId = table.functionGraphNodeIds[functionIndex]
        let nodeStart = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_nodeStarts,
            functionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_nodeCounts,
            functionIndex)
        let statementStart = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_statementStarts,
            functionIndex)
        let statementCount = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_statementCounts,
            functionIndex)
        let signatureLine = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.functions2_signatureLineNumbers,
            functionIndex)
        let graphNodeIndex = compilerCsgCanonicalSidecarNodeIndexById(
            csg.nodes,
            graphNodeId)
        if sourceIndex < 0 ||
           sourceIndex >= csg.semanticGraph.sourceTable.sourcePaths.len ||
           sourceIndex >= csg.semanticGraph.sourceTable.modulePaths.len ||
           Value(sourcePathRes) != csg.semanticGraph.sourceTable.sourcePaths[sourceIndex] ||
           table.functionNames[functionIndex] != Value(functionNameRes) ||
           table.functionNodeStart[functionIndex] != nodeStart ||
           table.functionNodeCount[functionIndex] != nodeCount ||
           table.functionStatementStart[functionIndex] != statementStart ||
           table.functionStatementCount[functionIndex] != statementCount ||
           graphNodeIndex < 0:
            err = Fmt" compiler csg: portable artifact TypedIR projection binding mismatch function={functionIndex}"
            return false
        let graphNode = csg.nodes[graphNodeIndex]
        if graphNode.nodeId != graphNodeId ||
           graphNode.nodeKind != CompilerCsgNodeKindSymbol ||
           graphNode.producerSourceIndex < 0 ||
           graphNode.producerDeclarationIndex < 0 ||
           layout.FixedBytes32Equal(
               graphNode.nameProofCid, layout.FixedBytes32()) ||
           graphNode.factText != Value(functionNameRes) ||
           graphNode.semanticSource !=
               csg.semanticGraph.sourceTable.modulePaths[sourceIndex] ||
           graphNode.semanticDeclarationLineIndex != signatureLine:
            err = Fmt" compiler csg: portable artifact TypedIR/graph semantic join mismatch function={functionIndex}"
            return false
        var reachableMatchCount: int32
        var reachableMatchIndex: int32 = -1
        for reachableIndex in 0..<reachableCount:
            if csg.semanticGraph.reachableFunctionTable.graphNodeIds[reachableIndex] ==
                   graphNodeId:
                if csg.semanticGraph.reachableFunctionTable.sourceIndex[reachableIndex] !=
                       sourceIndex ||
                   csg.semanticGraph.reachableFunctionTable.producerSourceIndexes[
                       reachableIndex] != graphNode.producerSourceIndex ||
                   csg.semanticGraph.reachableFunctionTable.producerDeclarationIndexes[
                       reachableIndex] != graphNode.producerDeclarationIndex ||
                   csg.semanticGraph.reachableFunctionTable.functionNameSurfaceKinds[
                       reachableIndex] != graphNode.functionNameSurfaceKind ||
                   !layout.FixedBytes32Equal(
                       csg.semanticGraph.reachableFunctionTable.functionNameProofCids[
                           reachableIndex],
                       graphNode.nameProofCid) ||
                   csg.semanticGraph.reachableFunctionTable.functionNames[reachableIndex] !=
                       Value(functionNameRes) ||
                   csg.semanticGraph.reachableFunctionTable.startLines[reachableIndex] !=
                       signatureLine ||
                   !csg.semanticGraph.reachableFunctionTable.reachable[reachableIndex]:
                    err = Fmt" compiler csg: portable artifact TypedIR/reachability join mismatch function={functionIndex}"
                    return false
                reachableMatchCount = reachableMatchCount + 1
                reachableMatchIndex = reachableIndex
        if reachableMatchCount != 1:
            err = Fmt" compiler csg: portable artifact TypedIR graph identity cardinality mismatch function={functionIndex} matches={reachableMatchCount}"
            return false
        let resultExprClass =
            csg.typedIr.functions2_resultExprClasses[functionIndex]
        let borrowsArguments =
            csg.typedIr.functions2_borrowsArguments[functionIndex]
        let resultAnnotationFlags =
            csg.semanticGraph.reachableFunctionTable.functionAnnotationFlags[
                reachableMatchIndex]
        let expectedResultExprClass =
            (resultAnnotationFlags &
                parser.ParserFunctionAnnotationBorrowResult) != 0 ?
                texpr.TypedExprExprBorrowed :
                texpr.TypedExprExprOwned
        let expectedBorrowsArguments =
            (resultAnnotationFlags &
                parser.ParserFunctionAnnotationBorrows) != 0
        if !parser.ParserNormalizedFunctionAnnotationFlagsValid(
           resultAnnotationFlags) ||
           resultExprClass != expectedResultExprClass ||
           borrowsArguments != expectedBorrowsArguments:
            err = Fmt" compiler csg: portable Function result ownership contract drift function={functionIndex}"
            return false
        let producerSourceIndex = graphNode.producerSourceIndex
        let producerDeclarationIndex = graphNode.producerDeclarationIndex
        if producerSourceIndex < 0 ||
           producerSourceIndex >=
               csg.parserNormalizedExprReceipt.sourceSidecars.len:
            err = Fmt" compiler csg: portable artifact TypedIR/parser source join missing function={functionIndex}"
            return false
        let parserSidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[
                producerSourceIndex]
        var parserMatchCount: int32
        for parserFunctionIndex in 0..<
                parserSidecar.functionDeclarationOrdinals.len:
            if parserSidecar.functionDeclarationOrdinals[
                   parserFunctionIndex] == producerDeclarationIndex &&
               parserSidecar.functionIndexes[parserFunctionIndex] ==
                   reachableMatchIndex:
                if parserSidecar.functionNames[parserFunctionIndex] !=
                       Value(functionNameRes) ||
                   parserSidecar.functionAnnotationFlags[
                       parserFunctionIndex] != resultAnnotationFlags ||
                   parserSidecar.functionNameSurfaceKinds[
                       parserFunctionIndex] !=
                       graphNode.functionNameSurfaceKind ||
                   !layout.FixedBytes32Equal(
                       parserSidecar.functionNameProofCids[
                           parserFunctionIndex],
                       graphNode.nameProofCid):
                    err = Fmt" compiler csg: portable artifact TypedIR/parser provenance content mismatch function={functionIndex}"
                    return false
                parserMatchCount = parserMatchCount + 1
        if parserMatchCount != 1:
            err = Fmt" compiler csg: portable artifact TypedIR/parser semantic identity mismatch function={functionIndex} matches={parserMatchCount}"
            return false
    err = ""
    return true

@borrows
fn compilerCsgParserFunctionDeclarationCoordinateInto(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        producerSourceIndex: int32,
        producerDeclarationOrdinal: int32,
        importcDeclaration: bool,
        parserSourceLocalDeclarationRow: var int32,
        executableFunctionIndex: var int32,
        err: var str): bool =
    parserSourceLocalDeclarationRow = -1
    executableFunctionIndex = -1
    let declarationCount = sidecar.declarationKinds.len
    if producerSourceIndex < 0 ||
       sidecar.sourceIndex != producerSourceIndex ||
       producerDeclarationOrdinal < 0 ||
       sidecar.declarationProducerSourceIds.len != declarationCount ||
       sidecar.declarationSourceLocalRows.len != declarationCount ||
       sidecar.declarationFunctionRows.len != declarationCount ||
       sidecar.functionIndexes.len !=
           sidecar.functionDeclarationOrdinals.len:
        err = Fmt" compiler csg: parser Function declaration coordinate domain invalid source={producerSourceIndex} ordinal={producerDeclarationOrdinal}"
        return false
    var parserMatchCount: int32
    for declarationRow in 0..<declarationCount:
        if sidecar.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationFunction) ||
           sidecar.declarationFunctionRows[declarationRow] !=
               producerDeclarationOrdinal:
            continue
        if sidecar.declarationProducerSourceIds[declarationRow] !=
               producerSourceIndex ||
           sidecar.declarationSourceLocalRows[declarationRow] !=
               declarationRow:
            err = Fmt" compiler csg: parser Function declaration source-local identity drift source={producerSourceIndex} ordinal={producerDeclarationOrdinal} row={declarationRow}"
            return false
        parserMatchCount = parserMatchCount + 1
        parserSourceLocalDeclarationRow = declarationRow
    if parserMatchCount != 1:
        err = Fmt" compiler csg: parser Function declaration coordinate cardinality mismatch source={producerSourceIndex} ordinal={producerDeclarationOrdinal} matches={parserMatchCount}"
        return false
    var executableMatchCount: int32
    for functionRow in 0..<sidecar.functionDeclarationOrdinals.len:
        if sidecar.functionDeclarationOrdinals[functionRow] !=
               producerDeclarationOrdinal:
            continue
        executableMatchCount = executableMatchCount + 1
        executableFunctionIndex = sidecar.functionIndexes[functionRow]
    if (importcDeclaration && executableMatchCount != 0) ||
       (!importcDeclaration && executableMatchCount != 1):
        err = Fmt" compiler csg: parser Function executable-subset membership invalid source={producerSourceIndex} ordinal={producerDeclarationOrdinal} importc={importcDeclaration} matches={executableMatchCount}"
        return false
    err = ""
    return true

@borrows
fn compilerCsgCallDeclarationProducerStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    let index = csg.typedIr.buildIndex
    if index == nil || index.released || !index.callDeclarationSealed:
        err = " compiler csg: call declaration producer index unavailable"
        return false
    let rowCount = index.callDeclarationKinds.len
    if rowCount != index.callDeclarationProducerSourceIndexes.len ||
       rowCount !=
           index.callDeclarationProducerDeclarationOrdinals.len ||
       rowCount != index.callDeclarationProducerFunctionRows.len:
        err = Fmt" compiler csg: call declaration producer columns mismatch rows={rowCount} sources={index.callDeclarationProducerSourceIndexes.len} declaration_ordinals={index.callDeclarationProducerDeclarationOrdinals.len} function_rows={index.callDeclarationProducerFunctionRows.len}"
        return false
    var seenFunctions: bool[]
    let table = csg.semanticGraph.reachableFunctionTable
    setLen(seenFunctions, table.functionNames.len)
    var parserDeclarationSourceStarts: int32[]
    var parserDeclarationCount: int64
    for producerSourceIndex in 0..<
            csg.parserNormalizedExprReceipt.sourceSidecars.len:
        if parserDeclarationCount > 2147483647:
            err = " compiler csg: parser declaration identity domain overflow"
            return false
        add(parserDeclarationSourceStarts,
            Int32(parserDeclarationCount))
        parserDeclarationCount = parserDeclarationCount +
            Int64(csg.parserNormalizedExprReceipt.sourceSidecars[
                producerSourceIndex].declarationKinds.len)
    if parserDeclarationCount > 2147483647:
        err = " compiler csg: parser declaration identity domain overflow"
        return false
    var seenParserDeclarations: bool[]
    setLen(seenParserDeclarations, Int32(parserDeclarationCount))
    for rowIndex in 0..<rowCount:
        let producerSourceIndex =
            index.callDeclarationProducerSourceIndexes[rowIndex]
        let producerDeclarationOrdinal =
            index.callDeclarationProducerDeclarationOrdinals[rowIndex]
        let producerFunctionRow =
            index.callDeclarationProducerFunctionRows[rowIndex]
        if producerSourceIndex < 0 ||
           producerSourceIndex >=
               csg.parserNormalizedExprReceipt.sourceSidecars.len:
            err = Fmt" compiler csg: call declaration producer source out of range row={rowIndex} source={producerSourceIndex}"
            return false
        let sidecar = csg.parserNormalizedExprReceipt.sourceSidecars[
            producerSourceIndex]
        if sidecar.sourceIndex != producerSourceIndex:
            err = Fmt" compiler csg: call declaration producer source/sidecar drift row={rowIndex} source={producerSourceIndex} sidecar={sidecar.sourceIndex}"
            return false
        let declarationKind = index.callDeclarationKinds[rowIndex]
        if declarationKind != texpr.TypedExprCallDeclarationFunction &&
           declarationKind != texpr.TypedExprCallDeclarationImportc:
            err = Fmt" compiler csg: call declaration producer kind invalid row={rowIndex} kind={Int32(declarationKind)}"
            return false
        let importcDeclaration =
            declarationKind == texpr.TypedExprCallDeclarationImportc
        if (importcDeclaration && producerFunctionRow != -1) ||
           (!importcDeclaration && producerFunctionRow < 0):
            err = Fmt" compiler csg: call declaration Function row mismatch row={rowIndex} kind={Int32(declarationKind)} function_row={producerFunctionRow}"
            return false
        var parserSourceLocalDeclarationRow: int32
        var functionIndex: int32
        if !compilerCsgParserFunctionDeclarationCoordinateInto(
                sidecar,
                producerSourceIndex,
                producerDeclarationOrdinal,
                importcDeclaration,
                parserSourceLocalDeclarationRow,
                functionIndex,
                err):
            return false
        let parserDeclarationIdentityRow =
            parserDeclarationSourceStarts[producerSourceIndex] +
                parserSourceLocalDeclarationRow
        if parserDeclarationIdentityRow < 0 ||
           parserDeclarationIdentityRow >=
               seenParserDeclarations.len ||
           seenParserDeclarations[parserDeclarationIdentityRow]:
            err = Fmt" compiler csg: duplicate call declaration parser identity row={rowIndex} source={producerSourceIndex} ordinal={producerDeclarationOrdinal} parser_source_local_row={parserSourceLocalDeclarationRow}"
            return false
        seenParserDeclarations[parserDeclarationIdentityRow] = true
        if importcDeclaration:
            continue
        if producerFunctionRow >= sidecar.functionIndexes.len ||
           producerFunctionRow >=
               sidecar.functionDeclarationOrdinals.len ||
           sidecar.functionIndexes[producerFunctionRow] != functionIndex ||
           sidecar.functionDeclarationOrdinals[producerFunctionRow] !=
               producerDeclarationOrdinal ||
           functionIndex < 0 || functionIndex >= seenFunctions.len ||
           functionIndex >= table.producerSourceIndexes.len ||
           functionIndex >= table.producerDeclarationIndexes.len ||
           seenFunctions[functionIndex] ||
           table.producerSourceIndexes[functionIndex] !=
               producerSourceIndex ||
           table.producerDeclarationIndexes[functionIndex] !=
               producerDeclarationOrdinal:
            err = Fmt" compiler csg: call declaration producer join invalid row={rowIndex} source={producerSourceIndex} declaration_ordinal={producerDeclarationOrdinal} parser_source_local_row={parserSourceLocalDeclarationRow} function_index={functionIndex}"
            return false
        seenFunctions[functionIndex] = true
    err = ""
    return true

@borrows
fn compilerCsgResolvedCallTargetDeclarationStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    let resolved = csg.semanticGraph.resolvedCallTable
    if !CompilerCsgSemanticResolvedCallTableValidate(
            resolved,
            csg.typedIr.functions2_functionNameIds.len,
            err):
        return false
    if !resolved.graphNodeProjectionComplete:
        err = " compiler csg: resolved-call target declaration projection incomplete"
        return false
    let reachable = csg.semanticGraph.reachableFunctionTable
    for rowIndex in 0..<resolved.sourceIndexes.len:
        let producerSourceIndex =
            resolved.targetProducerSourceIndexes[rowIndex]
        let producerDeclarationOrdinal =
            resolved.targetProducerDeclarationOrdinals[rowIndex]
        if producerSourceIndex < 0 ||
           producerSourceIndex >=
               csg.parserNormalizedExprReceipt.sourceSidecars.len:
            err = Fmt" compiler csg: resolved-call target producer source invalid row={rowIndex} source={producerSourceIndex}"
            return false
        let importcDeclaration =
            resolved.callTargetImportcFlags[rowIndex]
        var parserSourceLocalDeclarationRow: int32
        var executableFunctionIndex: int32
        if !compilerCsgParserFunctionDeclarationCoordinateInto(
                csg.parserNormalizedExprReceipt.sourceSidecars[
                    producerSourceIndex],
                producerSourceIndex,
                producerDeclarationOrdinal,
                importcDeclaration,
                parserSourceLocalDeclarationRow,
                executableFunctionIndex,
                err):
            return false
        if parserSourceLocalDeclarationRow !=
               resolved.targetParserSourceLocalDeclarationRows[rowIndex]:
            err = Fmt" compiler csg: resolved-call target parser source-local row drift row={rowIndex} source={producerSourceIndex} ordinal={producerDeclarationOrdinal} actual={resolved.targetParserSourceLocalDeclarationRows[rowIndex]} expected={parserSourceLocalDeclarationRow}"
            return false
        if importcDeclaration:
            if resolved.targetGraphNodeIds[rowIndex] != -1:
                err = Fmt" compiler csg: resolved importc target has graph node row={rowIndex} node={resolved.targetGraphNodeIds[rowIndex]}"
                return false
            continue
        if executableFunctionIndex < 0 ||
           executableFunctionIndex >= reachable.graphNodeIds.len ||
           executableFunctionIndex >=
               reachable.producerSourceIndexes.len ||
           executableFunctionIndex >=
               reachable.producerDeclarationIndexes.len ||
           reachable.producerSourceIndexes[executableFunctionIndex] !=
               producerSourceIndex ||
           reachable.producerDeclarationIndexes[executableFunctionIndex] !=
               producerDeclarationOrdinal ||
           reachable.graphNodeIds[executableFunctionIndex] !=
               resolved.targetGraphNodeIds[rowIndex]:
            err = Fmt" compiler csg: resolved Cheng target declaration/graph join invalid row={rowIndex} source={producerSourceIndex} ordinal={producerDeclarationOrdinal} function_index={executableFunctionIndex} target_node={resolved.targetGraphNodeIds[rowIndex]}"
            return false
    err = ""
    return true

type
    compilerCsgResolvedCallOwnershipScratch = ref object
        expectedEffectIndex: int32
        replayedOwnershipProjection: CompilerCsgCallOwnershipProjectionTable

@borrows
fn compilerCsgResolvedCallOwnershipEffectsValidateRec(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        semanticGraph: CompilerCsgSemanticGraph,
        typedIr: texpr.TypedExprIr,
        scratch: compilerCsgResolvedCallOwnershipScratch,
        callRow: int32,
        err: var str): bool =
    while true:
        let resolved = semanticGraph.resolvedCallTable
        let reachable = semanticGraph.reachableFunctionTable
        if callRow >= resolved.sourceIndexes.len:
            return true
        let typedFunctionIndex =
            resolved.functionIndexes[callRow]
        let typedCallNodeIndex =
            resolved.typedCallNodeIndexes[callRow]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >=
               typedIr.functions2_functionNameIds.len ||
           typedCallNodeIndex < 0 ||
           typedCallNodeIndex >= typedIr.nodes2_nodeIndexs.len ||
           typedIr.nodes2_opKinds[typedCallNodeIndex] !=
               texpr.TypedExprIrOpCallExpr ||
           arenamod.ArenaArrayInt32Get(
               typedIr.arena,
               typedIr.nodes2_originParserNodeIds,
               typedCallNodeIndex) !=
               resolved.originParserNodeIds[callRow]:
            err = Fmt" compiler csg: call ownership TypedExpr identity drift row={callRow}"
            return false
        let nodeStart = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.functions2_nodeStarts,
            typedFunctionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.functions2_nodeCounts,
            typedFunctionIndex)
        if nodeStart < 0 || nodeCount < 0 ||
           nodeStart > typedIr.nodes2_nodeIndexs.len - nodeCount ||
           typedCallNodeIndex < nodeStart ||
           typedCallNodeIndex >= nodeStart + nodeCount:
            err = Fmt" compiler csg: call ownership TypedExpr owner drift row={callRow}"
            return false
        let importcTarget =
            resolved.callTargetImportcFlags[callRow]
        let targetFunctionIndex =
            resolved.targetFunctionIndexes[callRow]
        var annotationFlags: int32
        var contractCid: layout.FixedBytes32
        if importcTarget:
            if targetFunctionIndex != -1 ||
               resolved.targetFunctionAnnotationFlags[callRow] != 0 ||
               !layout.FixedBytes32Equal(
                   resolved.targetFunctionContractCids[callRow],
                   layout.FixedBytes32()):
                err = Fmt" compiler csg: importc call carries Cheng ownership contract row={callRow}"
                return false
        else:
            if targetFunctionIndex < 0 ||
               targetFunctionIndex >=
                   reachable.functionAnnotationFlags.len ||
               targetFunctionIndex >=
                   reachable.producerSourceIndexes.len ||
               targetFunctionIndex >=
                   reachable.producerDeclarationIndexes.len ||
               targetFunctionIndex >=
                   reachable.functionDeclarationHeaderCids.len ||
               targetFunctionIndex >=
                   reachable.functionDeclarationPathCids.len ||
               targetFunctionIndex >=
                   reachable.functionNameProofCids.len ||
               targetFunctionIndex >=
                   reachable.graphNodeIds.len ||
               reachable.graphNodeIds[targetFunctionIndex] !=
                   resolved.targetGraphNodeIds[callRow]:
                err = Fmt" compiler csg: call ownership target Function row drift row={callRow}"
                return false
            annotationFlags =
                reachable.functionAnnotationFlags[
                    targetFunctionIndex]
            contractCid =
                CompilerCsgFunctionAnnotationContractCid(
                    targetFunctionIndex,
                    reachable.producerSourceIndexes[
                        targetFunctionIndex],
                    reachable.producerDeclarationIndexes[
                        targetFunctionIndex],
                    annotationFlags,
                    reachable.functionDeclarationHeaderCids[
                        targetFunctionIndex],
                    reachable.functionDeclarationPathCids[
                        targetFunctionIndex],
                    reachable.functionNameProofCids[
                        targetFunctionIndex])
            if resolved.targetFunctionAnnotationFlags[callRow] !=
                   annotationFlags ||
               !layout.FixedBytes32Equal(
                   resolved.targetFunctionContractCids[callRow],
                   contractCid):
                err = Fmt" compiler csg: call ownership target Function CID drift row={callRow}"
                return false
        let borrows =
            (annotationFlags &
                parser.ParserFunctionAnnotationBorrows) != 0
        let escapes =
            (annotationFlags &
                parser.ParserFunctionAnnotationEscapes) != 0
        if borrows && escapes:
            err = Fmt" compiler csg: call ownership contract contradiction row={callRow}"
            return false
        let targetProducerSourceIndex =
            resolved.targetProducerSourceIndexes[callRow]
        let targetFunctionDeclarationRow =
            resolved.targetParserSourceLocalDeclarationRows[callRow]
        if targetProducerSourceIndex < 0 ||
           targetProducerSourceIndex >=
               parserReceipt.sourceSidecars.len:
            err = Fmt" compiler csg: call parameter source drift row={callRow}"
            return false
        let targetSidecar =
            parserReceipt.sourceSidecars[targetProducerSourceIndex]
        if targetFunctionDeclarationRow < 0 ||
           targetFunctionDeclarationRow >=
               targetSidecar.declarationKinds.len ||
           targetSidecar.declarationKinds[
               targetFunctionDeclarationRow] !=
               Int32(parser.ParserDeclarationFunction):
            err = Fmt" compiler csg: call parameter owner drift row={callRow}"
            return false
        var parameterRows: int32[]
        for declarationRow in 0..<targetSidecar.declarationKinds.len:
            if targetSidecar.declarationKinds[declarationRow] ==
                   Int32(parser.ParserDeclarationParameter) &&
               targetSidecar.declarationOwnerIds[declarationRow] ==
                   targetFunctionDeclarationRow:
                add(parameterRows, declarationRow)
        if parameterRows.len != resolved.callArgCounts[callRow]:
            err = Fmt" compiler csg: call parameter count drift row={callRow}"
            return false
        let expectedCallArgumentStart =
            resolved.callArgumentStarts[callRow]
        if resolved.ownershipEffectStarts[callRow] !=
               scratch.expectedEffectIndex:
            err = Fmt" compiler csg: call ownership effect start drift row={callRow}"
            return false
        let expectedCallEffectStart = scratch.expectedEffectIndex
        var argLinkNodeIndex = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_operand0NodeIndexs,
            typedCallNodeIndex)
        for argumentOrdinal in 0..<resolved.callArgCounts[callRow]:
            if argLinkNodeIndex < 0 ||
               argLinkNodeIndex >= typedCallNodeIndex ||
               typedIr.nodes2_opKinds[argLinkNodeIndex] !=
                   texpr.TypedExprIrOpArgLink:
                err = Fmt" compiler csg: call ownership argument link drift row={callRow} argument={argumentOrdinal}"
                return false
            let valueNodeIndex = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_operand0NodeIndexs,
                argLinkNodeIndex)
            if valueNodeIndex < 0 ||
               valueNodeIndex >= argLinkNodeIndex:
                err = Fmt" compiler csg: call ownership value node drift row={callRow} argument={argumentOrdinal}"
                return false
            let callArgumentRow =
                expectedCallArgumentStart + argumentOrdinal
            if callArgumentRow < 0 ||
               callArgumentRow >=
                   resolved.callArgumentBindingIds.len:
                err = Fmt" compiler csg: call argument binding deleted row={callRow} argument={argumentOrdinal}"
                return false
            let parameterDeclarationRow =
                parameterRows[argumentOrdinal]
            let parameterMutable =
                targetSidecar.declarationMutableFlags[
                    parameterDeclarationRow]
            let expectedArgumentBindingCid =
                CompilerCsgCallArgumentBindingCid(
                    callRow,
                    resolved.sourceIndexes[callRow],
                    resolved.originParserNodeIds[callRow],
                    typedFunctionIndex,
                    typedCallNodeIndex,
                    targetProducerSourceIndex,
                    targetFunctionDeclarationRow,
                    callArgumentRow,
                    argumentOrdinal,
                    argLinkNodeIndex,
                    valueNodeIndex,
                    parameterDeclarationRow,
                    parameterMutable)
            if resolved.callArgumentBindingIds[callArgumentRow] !=
                   callArgumentRow ||
               resolved.callArgumentCallRows[callArgumentRow] !=
                   callRow ||
               resolved.callArgumentOrdinals[callArgumentRow] !=
                   argumentOrdinal ||
               resolved.callArgumentArgLinkNodeIndexes[
                   callArgumentRow] != argLinkNodeIndex ||
               resolved.callArgumentValueNodeIndexes[
                   callArgumentRow] != valueNodeIndex ||
               resolved.callArgumentTargetParameterDeclarationRows[
                   callArgumentRow] != parameterDeclarationRow ||
               resolved.callArgumentTargetParameterMutableFlags[
                   callArgumentRow] != parameterMutable ||
               !layout.FixedBytes32Equal(
                   resolved.callArgumentBindingCids[callArgumentRow],
                   expectedArgumentBindingCid):
                err = Fmt" compiler csg: call argument parameter binding drift binding={callArgumentRow}"
                return false
            let bindingDefinitionRow =
                texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
                    typedIr, valueNodeIndex)
            let producedDefinitionRow =
                texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
                    typedIr, valueNodeIndex)
            if bindingDefinitionRow >= 0 &&
               producedDefinitionRow >= 0:
                err = Fmt" compiler csg: call ownership value-definition split row={callRow} argument={argumentOrdinal}"
                return false
            var definitionRow = bindingDefinitionRow
            if definitionRow < 0:
                definitionRow = producedDefinitionRow
            let valueOwnership =
                texpr.TypedExprIrNodeExprClassAt(
                    typedIr, valueNodeIndex)
            if valueOwnership == texpr.TypedExprExprUnknown:
                err = Fmt" compiler csg: call argument ownership replay is unknown row={callRow} argument={argumentOrdinal}"
                return false
            if valueOwnership == texpr.TypedExprExprBorrowed &&
               (escapes || (!borrows && !parameterMutable)):
                err = Fmt" compiler csg: borrowed call argument contract invalid row={callRow} argument={argumentOrdinal}"
                return false
            let managedValue =
                valueOwnership == texpr.TypedExprExprOwned ||
                valueOwnership == texpr.TypedExprExprBorrowed
            let ownershipEffectRequired =
                managedValue &&
                (borrows || escapes || parameterMutable)
            if ownershipEffectRequired:
                var projectedDefinitionRow: int32
                var ownershipProjectionCid: layout.FixedBytes32
                if !compilerCsgCallOwnershipProjectionAppendInto(
                       typedIr,
                       typedFunctionIndex,
                       arenamod.ArenaArrayInt32Get(
                           typedIr.arena,
                           typedIr.nodes2_ownerProducerSourceIndexes,
                           valueNodeIndex),
                       arenamod.ArenaArrayInt32Get(
                           typedIr.arena,
                           typedIr.
                               nodes2_ownerDeclarationSourceLocalRows,
                           valueNodeIndex),
                       scratch.expectedEffectIndex,
                       valueNodeIndex,
                       scratch.replayedOwnershipProjection,
                       projectedDefinitionRow,
                       ownershipProjectionCid,
                       err):
                    return false
                if definitionRow >= 0 &&
                   definitionRow != projectedDefinitionRow:
                    err = Fmt" compiler csg: call ownership replay root definition drift row={callRow} argument={argumentOrdinal}"
                    return false
                definitionRow = projectedDefinitionRow
                let definitionCount =
                    texpr.TypedExprValueDefinitionAuthorityCount(
                        typedIr)
                if definitionRow < 0 ||
                   definitionRow >= definitionCount:
                    err = Fmt" compiler csg: call ownership definition boundary invalid row={callRow} argument={argumentOrdinal} definition={definitionRow} count={definitionCount}"
                    return false
                if scratch.expectedEffectIndex >=
                       resolved.ownershipEffectIds.len:
                    err = Fmt" compiler csg: call ownership effect deleted row={callRow} argument={argumentOrdinal}"
                    return false
                let definitionOwnership =
                    texpr.TypedExprValueDefinitionOwnershipAt(
                        typedIr, definitionRow)
                if definitionOwnership !=
                       texpr.TypedExprExprOwned &&
                   definitionOwnership !=
                       texpr.TypedExprExprBorrowed:
                    err = Fmt" compiler csg: call ownership definition replay is unmanaged row={callRow} argument={argumentOrdinal}"
                    return false
                if valueOwnership == texpr.TypedExprExprOwned &&
                   definitionOwnership !=
                       texpr.TypedExprExprOwned:
                    err = Fmt" compiler csg: owned call view replays from non-owned definition row={callRow} argument={argumentOrdinal}"
                    return false
                let definitionOriginKind =
                    texpr.TypedExprValueDefinitionOriginKindAt(
                        typedIr, definitionRow)
                let definitionTypedFunctionIndex =
                    texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
                        typedIr, definitionRow)
                let definitionTypeId =
                    texpr.TypedExprValueDefinitionExactTypeIdAt(
                        typedIr, definitionRow)
                let definitionNodeIndex =
                    texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                        typedIr, definitionRow)
                let definitionProducerSourceIndex =
                    texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                        typedIr, definitionRow)
                let definitionSourceLocalNodeIndex =
                    texpr.
                        TypedExprValueDefinitionSourceLocalNodeIndexAt(
                            typedIr, definitionRow)
                let definitionDeclarationSourceLocalRow =
                    texpr.
                        TypedExprValueDefinitionDeclarationSourceLocalRowAt(
                            typedIr, definitionRow)
                let effectKind = (borrows || parameterMutable) ?
                    CompilerCsgCallOwnershipEffectBorrow :
                    CompilerCsgCallOwnershipEffectEscape
                let expectedCid =
                    CompilerCsgCallOwnershipEffectCid(
                        callRow,
                        resolved.sourceIndexes[callRow],
                        resolved.originParserNodeIds[callRow],
                        typedFunctionIndex,
                        typedCallNodeIndex,
                        targetFunctionIndex,
                        resolved.targetGraphNodeIds[callRow],
                        annotationFlags,
                        contractCid,
                        scratch.expectedEffectIndex,
                        callArgumentRow,
                        expectedArgumentBindingCid,
                        ownershipProjectionCid,
                        argumentOrdinal,
                        argLinkNodeIndex,
                        valueNodeIndex,
                        Int32(valueOwnership),
                        definitionRow,
                        Int32(definitionOwnership),
                        Int32(definitionOriginKind),
                        definitionTypedFunctionIndex,
                        definitionTypeId,
                        definitionNodeIndex,
                        definitionProducerSourceIndex,
                        definitionSourceLocalNodeIndex,
                        definitionDeclarationSourceLocalRow,
                        effectKind)
                if resolved.ownershipEffectIds[
                       scratch.expectedEffectIndex] !=
                       scratch.expectedEffectIndex ||
                   resolved.ownershipEffectCallRows[
                       scratch.expectedEffectIndex] != callRow ||
                   resolved.ownershipEffectCallArgumentRows[
                       scratch.expectedEffectIndex] != callArgumentRow ||
                   resolved.ownershipEffectArgumentOrdinals[
                       scratch.expectedEffectIndex] != argumentOrdinal ||
                   resolved.ownershipEffectArgLinkNodeIndexes[
                       scratch.expectedEffectIndex] != argLinkNodeIndex ||
                   resolved.ownershipEffectValueNodeIndexes[
                       scratch.expectedEffectIndex] != valueNodeIndex ||
                   resolved.ownershipEffectValueNodeOwnerships[
                       scratch.expectedEffectIndex] !=
                       Int32(valueOwnership) ||
                   resolved.ownershipEffectValueDefinitionRows[
                       scratch.expectedEffectIndex] != definitionRow ||
                   resolved.ownershipEffectValueDefinitionOwnerships[
                           scratch.expectedEffectIndex] !=
                       Int32(definitionOwnership) ||
                   resolved.ownershipEffectValueDefinitionOriginKinds[
                           scratch.expectedEffectIndex] !=
                       Int32(definitionOriginKind) ||
                   resolved.ownershipEffectValueDefinitionTypedFunctionIndexes[
                           scratch.expectedEffectIndex] !=
                       definitionTypedFunctionIndex ||
                   resolved.ownershipEffectValueDefinitionExactTypeIds[
                           scratch.expectedEffectIndex] !=
                       definitionTypeId ||
                   resolved.ownershipEffectValueDefinitionDefiningNodeIndexes[
                           scratch.expectedEffectIndex] !=
                       definitionNodeIndex ||
                   resolved.ownershipEffectValueDefinitionProducerSourceIndexes[
                           scratch.expectedEffectIndex] !=
                       definitionProducerSourceIndex ||
                   resolved.ownershipEffectValueDefinitionSourceLocalNodeIndexes[
                           scratch.expectedEffectIndex] !=
                       definitionSourceLocalNodeIndex ||
                   resolved.ownershipEffectValueDefinitionDeclarationSourceLocalRows[
                           scratch.expectedEffectIndex] !=
                       definitionDeclarationSourceLocalRow ||
                   resolved.ownershipEffectKinds[
                       scratch.expectedEffectIndex] != effectKind ||
                   !layout.FixedBytes32Equal(
                       resolved.ownershipEffectCids[
                           scratch.expectedEffectIndex],
                       expectedCid):
                    err = Fmt" compiler csg: call ownership effect identity drift effect={scratch.expectedEffectIndex}"
                    return false
                let replayHopStart =
                    scratch.replayedOwnershipProjection.effectStarts[
                        scratch.expectedEffectIndex]
                let replayHopCount =
                    scratch.replayedOwnershipProjection.effectCounts[
                        scratch.expectedEffectIndex]
                if resolved.ownershipProjection.effectStarts[
                       scratch.expectedEffectIndex] != replayHopStart ||
                   resolved.ownershipProjection.effectCounts[
                       scratch.expectedEffectIndex] != replayHopCount ||
                   !layout.FixedBytes32Equal(
                       resolved.ownershipProjection.effectProjectionCids[
                               scratch.expectedEffectIndex],
                       ownershipProjectionCid):
                    err = Fmt" compiler csg: call ownership projection range drift effect={scratch.expectedEffectIndex}"
                    return false
                for hopRow in replayHopStart..<
                        replayHopStart + replayHopCount:
                    if resolved.ownershipProjection.hopIds[hopRow] !=
                           scratch.replayedOwnershipProjection.hopIds[hopRow] ||
                       resolved.ownershipProjection.hopEffectRows[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopEffectRows[
                               hopRow] ||
                       resolved.ownershipProjection.hopOrdinals[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopOrdinals[
                               hopRow] ||
                       resolved.ownershipProjection.hopNodeIndexes[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopNodeIndexes[
                               hopRow] ||
                       resolved.ownershipProjection.hopOpKinds[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopOpKinds[
                               hopRow] ||
                       resolved.ownershipProjection.hopExactTypeIds[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopExactTypeIds[
                               hopRow] ||
                       resolved.ownershipProjection.hopOwnerProducerSourceIndexes[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopOwnerProducerSourceIndexes[
                               hopRow] ||
                       resolved.ownershipProjection.hopOwnerDeclarationSourceLocalRows[
                               hopRow] !=
                           scratch.replayedOwnershipProjection.hopOwnerDeclarationSourceLocalRows[
                                   hopRow] ||
                       resolved.ownershipProjection.hopOperand0NodeIndexes[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopOperand0NodeIndexes[
                               hopRow] ||
                       resolved.ownershipProjection.hopFieldProducerSourceIndexes[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopFieldProducerSourceIndexes[
                               hopRow] ||
                       resolved.ownershipProjection.hopFieldOwnerDeclarationSourceLocalRows[
                               hopRow] !=
                           scratch.replayedOwnershipProjection.hopFieldOwnerDeclarationSourceLocalRows[
                                   hopRow] ||
                       resolved.ownershipProjection.hopFieldDeclarationSourceLocalRows[
                               hopRow] !=
                           scratch.replayedOwnershipProjection.hopFieldDeclarationSourceLocalRows[
                                   hopRow] ||
                       resolved.ownershipProjection.hopFieldOrdinals[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopFieldOrdinals[
                               hopRow] ||
                       resolved.ownershipProjection.hopFieldBuiltinKinds[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopFieldBuiltinKinds[
                               hopRow] ||
                       resolved.ownershipProjection.hopIndexNodeIndexes[
                           hopRow] !=
                           scratch.replayedOwnershipProjection.hopIndexNodeIndexes[
                               hopRow] ||
                       !layout.FixedBytes32Equal(
                           resolved.ownershipProjection.hopCids[
                               hopRow],
                           scratch.replayedOwnershipProjection.hopCids[
                               hopRow]):
                        err = Fmt" compiler csg: call ownership projection hop drift hop={hopRow}"
                        return false
                scratch.expectedEffectIndex = scratch.expectedEffectIndex + 1
            argLinkNodeIndex = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_operand1NodeIndexs,
                argLinkNodeIndex)
        if argLinkNodeIndex != -1 ||
           resolved.ownershipEffectCounts[callRow] !=
               scratch.expectedEffectIndex - expectedCallEffectStart:
            err = Fmt" compiler csg: call ownership effect coverage drift row={callRow}"
            return false
        callRow = callRow + 1
        continue

@borrows
fn compilerCsgResolvedCallOwnershipEffectsStrictValidateInto(
        parserReceipt: parser_receipt.ParserNormalizedExprReceipt,
        semanticGraph: CompilerCsgSemanticGraph,
        typedIr: texpr.TypedExprIr,
        err: var str): bool =
    let resolved = semanticGraph.resolvedCallTable
    let reachable = semanticGraph.reachableFunctionTable
    if !CompilerCsgSemanticResolvedCallTableValidate(
           resolved,
           typedIr.functions2_functionNameIds.len,
           err) ||
       !resolved.graphNodeProjectionComplete:
        if err == "":
            err = " compiler csg: resolved-call ownership projection incomplete"
        return false
    var scratch: compilerCsgResolvedCallOwnershipScratch =
        new(compilerCsgResolvedCallOwnershipScratch)
    if !compilerCsgResolvedCallOwnershipEffectsValidateRec(
           parserReceipt, semanticGraph, typedIr, scratch, 0, err):
        return false
    let expectedEffectIndex = scratch.expectedEffectIndex
    let replayedOwnershipProjection = scratch.replayedOwnershipProjection
    if expectedEffectIndex !=
           resolved.ownershipEffectIds.len:
        err = " compiler csg: call ownership effect tail is unowned"
        return false
    if !compilerCsgCallOwnershipProjectionTableValidate(
           replayedOwnershipProjection,
           expectedEffectIndex,
           true,
           err) ||
       replayedOwnershipProjection.hopIds.len !=
           resolved.ownershipProjection.hopIds.len:
        if err == "":
            err = " compiler csg: call ownership projection replay coverage drift"
        return false
    err = ""
    return true

@borrows
fn compilerCsgKeepExportBindingCidMatches(
        keepExportBinding: bool,
        functionId: int32,
        producerSourceIndex: int32,
        producerDeclarationIndex: int32,
        annotationFlags: int32,
        declarationHeaderCid: layout.FixedBytes32,
        declarationPathCid: layout.FixedBytes32,
        nameProofCid: layout.FixedBytes32,
        actualCid: layout.FixedBytes32): bool =
    if keepExportBinding:
        let keepCid = CompilerCsgKeepExportBindingCid(
            functionId,
            producerSourceIndex,
            producerDeclarationIndex,
            annotationFlags,
            declarationHeaderCid,
            declarationPathCid,
            nameProofCid)
        return layout.FixedBytes32Equal(actualCid, keepCid)
    return layout.FixedBytes32Equal(actualCid, layout.FixedBytes32())

@borrows
fn CompilerCsgParserDeclarationProvenanceStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    if !compilerCsgCallDeclarationProducerStrictValidateInto(csg, err) ||
       !compilerCsgResolvedCallTargetDeclarationStrictValidateInto(
           csg, err) ||
       !compilerCsgResolvedCallOwnershipEffectsStrictValidateInto(
           csg.parserNormalizedExprReceipt,
           csg.semanticGraph,
           csg.typedIr,
           err):
        return false
    let table = csg.semanticGraph.reachableFunctionTable
    let functionCount = table.graphNodeIds.len
    if table.sourceIndex.len != functionCount ||
       table.producerSourceIndexes.len != functionCount ||
       table.producerDeclarationIndexes.len != functionCount ||
       table.functionNameSurfaceKinds.len != functionCount ||
       table.functionNameProofCids.len != functionCount ||
       table.functionAnnotationFlags.len != functionCount ||
       table.functionDeclarationHeaderCids.len != functionCount ||
       table.functionDeclarationPathCids.len != functionCount ||
       table.keepExportBindingCids.len != functionCount ||
       table.sourcePaths.len != functionCount ||
       table.functionNames.len != functionCount ||
       csg.semanticGraph.sourceTable.sourcePaths.len !=
           csg.semanticGraph.sourceTable.modulePaths.len ||
       csg.parserNormalizedExprReceipt.sourceSidecars.len <= 0:
        err = " compiler csg: parser declaration provenance columns mismatch"
        return false
    var ordinarySymbolNodeSeen: bool[]
    var externSymbolNodeSeen: bool[]
    var maxGraphNodeId: int32
    for nodeIndex in 0..<csg.nodes.len:
        if csg.nodes[nodeIndex].nodeId > maxGraphNodeId:
            maxGraphNodeId = csg.nodes[nodeIndex].nodeId
    setLen(ordinarySymbolNodeSeen, maxGraphNodeId + 1)
    setLen(externSymbolNodeSeen, maxGraphNodeId + 1)
    var producerToCanonical: int32[]
    var canonicalToProducer: int32[]
    setLen(producerToCanonical,
           csg.parserNormalizedExprReceipt.sourceSidecars.len)
    setLen(canonicalToProducer,
           csg.semanticGraph.sourceTable.sourcePaths.len)
    for sourceIndex in 0..<producerToCanonical.len:
        producerToCanonical[sourceIndex] = -1
    for sourceIndex in 0..<canonicalToProducer.len:
        canonicalToProducer[sourceIndex] = -1
    for producerSourceIndex in 0..<
            csg.parserNormalizedExprReceipt.sourceSidecars.len:
        var sidecarErr: str
        if !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
                csg.parserNormalizedExprReceipt.sourceSidecars[
                    producerSourceIndex],
                sidecarErr):
            err = Fmt" compiler csg: parser declaration provenance sidecar invalid source={producerSourceIndex}: {sidecarErr}"
            return false
    for functionIndex in 0..<functionCount:
        let canonicalSourceIndex = table.sourceIndex[functionIndex]
        let producerSourceIndex =
            table.producerSourceIndexes[functionIndex]
        let producerDeclarationIndex =
            table.producerDeclarationIndexes[functionIndex]
        let surfaceKind = table.functionNameSurfaceKinds[functionIndex]
        let proofCid = table.functionNameProofCids[functionIndex]
        let graphNodeId = table.graphNodeIds[functionIndex]
        if producerSourceIndex < 0 ||
           producerSourceIndex >=
               csg.parserNormalizedExprReceipt.sourceSidecars.len ||
           canonicalSourceIndex < 0 ||
           canonicalSourceIndex >=
               csg.semanticGraph.sourceTable.sourcePaths.len ||
           table.sourcePaths[functionIndex] !=
               csg.semanticGraph.sourceTable.sourcePaths[
                   canonicalSourceIndex] ||
           producerDeclarationIndex < 0 ||
           (surfaceKind !=
                parser_receipt.ParserFunctionNameSurfaceIdentifier &&
            surfaceKind !=
                parser_receipt.ParserFunctionNameSurfaceBacktick) ||
           layout.FixedBytes32Equal(proofCid, layout.FixedBytes32()) ||
           graphNodeId <= 0 ||
           graphNodeId >= ordinarySymbolNodeSeen.len ||
           ordinarySymbolNodeSeen[graphNodeId]:
            err = Fmt" compiler csg: parser declaration provenance row invalid function_index={functionIndex} producer_source={producerSourceIndex} canonical_source={canonicalSourceIndex} producer_decl={producerDeclarationIndex} surface={surfaceKind} proof_zero={layout.FixedBytes32Equal(proofCid, layout.FixedBytes32())} graph_node={graphNodeId} graph_domain={ordinarySymbolNodeSeen.len} source_rows={csg.semanticGraph.sourceTable.sourcePaths.len} producer_rows={csg.parserNormalizedExprReceipt.sourceSidecars.len}"
            return false
        if (producerToCanonical[producerSourceIndex] >= 0 &&
            producerToCanonical[producerSourceIndex] !=
                canonicalSourceIndex) ||
           (canonicalToProducer[canonicalSourceIndex] >= 0 &&
            canonicalToProducer[canonicalSourceIndex] !=
                producerSourceIndex):
            err = Fmt" compiler csg: parser declaration provenance source mapping is not bijective function_index={functionIndex} producer_source={producerSourceIndex} canonical_source={canonicalSourceIndex}"
            return false
        producerToCanonical[producerSourceIndex] = canonicalSourceIndex
        canonicalToProducer[canonicalSourceIndex] = producerSourceIndex
        let nodeIndex = compilerCsgCanonicalSidecarNodeIndexById(
            csg.nodes, graphNodeId)
        if nodeIndex < 0 ||
           csg.nodes[nodeIndex].nodeKind != CompilerCsgNodeKindSymbol ||
           csg.nodes[nodeIndex].producerSourceIndex != producerSourceIndex ||
           csg.nodes[nodeIndex].producerDeclarationIndex !=
               producerDeclarationIndex ||
           csg.nodes[nodeIndex].functionNameSurfaceKind != surfaceKind ||
           !layout.FixedBytes32Equal(
               csg.nodes[nodeIndex].nameProofCid, proofCid) ||
           csg.nodes[nodeIndex].semanticSource !=
               csg.semanticGraph.sourceTable.modulePaths[
                   canonicalSourceIndex]:
            var actualKind: int32 = -1
            var actualProducerSource: int32 = -1
            var actualProducerDeclaration: int32 = -1
            var actualSurface: int32 = -1
            var actualProofZero = true
            var actualSemanticSource = ""
            if nodeIndex >= 0:
                actualKind = csg.nodes[nodeIndex].nodeKind
                actualProducerSource =
                    csg.nodes[nodeIndex].producerSourceIndex
                actualProducerDeclaration =
                    csg.nodes[nodeIndex].producerDeclarationIndex
                actualSurface =
                    csg.nodes[nodeIndex].functionNameSurfaceKind
                actualProofZero = layout.FixedBytes32Equal(
                    csg.nodes[nodeIndex].nameProofCid,
                    layout.FixedBytes32())
                actualSemanticSource =
                    csg.nodes[nodeIndex].semanticSource
            err = Fmt" compiler csg: parser declaration provenance graph join invalid function_index={functionIndex} node={graphNodeId} node_index={nodeIndex} actual_kind={actualKind} actual_producer_source={actualProducerSource} actual_producer_decl={actualProducerDeclaration} actual_surface={actualSurface} actual_proof_zero={actualProofZero} actual_semantic_source={actualSemanticSource} expected_semantic_source={csg.semanticGraph.sourceTable.modulePaths[canonicalSourceIndex]}"
            return false
        let sidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[
                producerSourceIndex]
        var parserMatchCount: int32
        for sidecarRow in 0..<sidecar.functionDeclarationOrdinals.len:
            if sidecar.functionDeclarationOrdinals[sidecarRow] ==
                   producerDeclarationIndex &&
               sidecar.functionIndexes[sidecarRow] == functionIndex:
                if sidecar.functionNames[sidecarRow] !=
                       table.functionNames[functionIndex] ||
                   sidecar.functionNameSurfaceKinds[sidecarRow] !=
                       surfaceKind ||
                   !layout.FixedBytes32Equal(
                       sidecar.functionNameProofCids[sidecarRow],
                       proofCid) ||
                   sidecar.functionAnnotationFlags[sidecarRow] !=
                       table.functionAnnotationFlags[functionIndex] ||
                   !layout.FixedBytes32Equal(
                       sidecar.functionDeclarationHeaderCids[
                           sidecarRow],
                       table.functionDeclarationHeaderCids[
                           functionIndex]) ||
                   !layout.FixedBytes32Equal(
                       sidecar.functionDeclarationPathCids[
                           sidecarRow],
                       table.functionDeclarationPathCids[
                           functionIndex]):
                    err = Fmt" compiler csg: parser declaration provenance parser content mismatch function_index={functionIndex}"
                    return false
                parserMatchCount = parserMatchCount + 1
        if parserMatchCount != 1:
            err = Fmt" compiler csg: parser declaration provenance parser cardinality invalid function_index={functionIndex} matches={parserMatchCount}"
            return false
        let annotationFlags =
            table.functionAnnotationFlags[functionIndex]
        let keepExportBinding =
            (annotationFlags &
                parser.ParserFunctionAnnotationKeepExportBinding) != 0
        if !parser.ParserNormalizedFunctionAnnotationFlagsValid(
               annotationFlags) ||
           !compilerCsgKeepExportBindingCidMatches(
               keepExportBinding,
               functionIndex,
               producerSourceIndex,
               producerDeclarationIndex,
               annotationFlags,
               table.functionDeclarationHeaderCids[functionIndex],
               table.functionDeclarationPathCids[functionIndex],
               proofCid,
               table.keepExportBindingCids[functionIndex]) ||
           (keepExportBinding &&
            (!table.reachable[functionIndex] ||
             csg.nodes[nodeIndex].exportNameExplicit != 1)):
            err = Fmt" compiler csg: keep-export binding plan invalid function_id={functionIndex}"
            return false
        ordinarySymbolNodeSeen[graphNodeId] = true
    let externSymbolCount =
        csg.externFfiHandleContracts.functionSymbolIds.len
    for contractRow in 0..<externSymbolCount:
        let graphNodeId =
            csg.externFfiHandleContracts.functionSymbolIds[contractRow]
        if graphNodeId <= 0 ||
           graphNodeId >= externSymbolNodeSeen.len ||
           ordinarySymbolNodeSeen[graphNodeId] ||
           externSymbolNodeSeen[graphNodeId]:
            err = Fmt" compiler csg: parser declaration provenance extern Symbol partition invalid contract={contractRow} node={graphNodeId}"
            return false
        let nodeIndex = compilerCsgCanonicalSidecarNodeIndexById(
            csg.nodes, graphNodeId)
        if nodeIndex < 0 ||
           csg.nodes[nodeIndex].nodeKind != CompilerCsgNodeKindSymbol:
            err = Fmt" compiler csg: parser declaration provenance extern Symbol authority missing contract={contractRow} node={graphNodeId}"
            return false
        externSymbolNodeSeen[graphNodeId] = true
    var symbolCount: int32
    var ordinaryObservedCount: int32
    var externObservedCount: int32
    for nodeIndex in 0..<csg.nodes.len:
        if csg.nodes[nodeIndex].nodeKind == CompilerCsgNodeKindSymbol:
            symbolCount = symbolCount + 1
            let nodeId = csg.nodes[nodeIndex].nodeId
            if nodeId <= 0 ||
               nodeId >= ordinarySymbolNodeSeen.len ||
               (ordinarySymbolNodeSeen[nodeId] ==
                    externSymbolNodeSeen[nodeId]):
                err = Fmt" compiler csg: parser declaration provenance symbol unbound node={nodeId}"
                return false
            if ordinarySymbolNodeSeen[nodeId]:
                ordinaryObservedCount = ordinaryObservedCount + 1
            else:
                externObservedCount = externObservedCount + 1
    if ordinaryObservedCount != functionCount ||
       externObservedCount != externSymbolCount ||
       symbolCount != functionCount + externSymbolCount:
        err = Fmt" compiler csg: parser declaration provenance symbol partition coverage mismatch symbols={symbolCount} ordinary={ordinaryObservedCount}/{functionCount} extern={externObservedCount}/{externSymbolCount}"
        return false
    err = ""
    return true

# Build-side counterpart of the source-table contract enforced by
# CompilerCsgSemanticDependencyStrictValidateInto below: exprSummary.sourceCount
# is bound to the semantic source row count.  Every ordered source row carries
# snapshot bytes, decl rows, and metadata contexts regardless of functions,
# while the slice-consumption accumulation (:37805 exact path, :38074 input
# path, frontier rounds) only counts sources that own a consumed function
# slice, so declaration-only sources (pure module-level const modules) are
# exactly the rows the accumulation misses.  Each source is counted at most
# once on every path (per-source counted flags), so the accumulated value is
# a lower bound and this binding is monotone.
fn CompilerCsgSemanticBindExprSummarySourceRowCount(
        semanticGraph: var CompilerCsgSemanticGraph) =
    semanticGraph.exprSummary.sourceCount = semanticGraph.sourceTable.sourcePaths.len

# Single production authority for a source-bound portable CompilerCSG.  Every
# receipt validator must call this routine; accepting caller-provided graph
# hashes without revalidating their owned bytes is forbidden.
@borrows
fn CompilerCsgSemanticDependencyStrictValidateInto(
        semanticGraph: CompilerCsgSemanticGraph,
        sourceReceipt: PortableSourceIdentityReceipt,
        err: var str): bool =
    let sourceCount = semanticGraph.sourceTable.sourcePaths.len
    let declarationCount = semanticGraph.declTable.names.len
    let importEdgeCount =
        semanticGraph.importEdgeTable.ownerSourceIndex.len
    if sourceCount <= 0 ||
       semanticGraph.sourceTable.modulePaths.len != sourceCount ||
       semanticGraph.sourceTable.textBytes.len != sourceCount ||
       semanticGraph.sourceTable.declStart.len != sourceCount ||
       semanticGraph.sourceTable.declCount.len != sourceCount ||
       semanticGraph.sourceTable.importEdgeStart.len != sourceCount ||
       semanticGraph.sourceTable.importEdgeCount.len != sourceCount ||
       semanticGraph.exprSummary.sourceCount != sourceCount ||
       sourceReceipt.sourceSnapshotCount != sourceCount:
        err = " compiler csg: semantic dependency source table shape mismatch"
        return false
    if semanticGraph.declTable.sourceIndex.len != declarationCount ||
       semanticGraph.declTable.lineNumbers.len != declarationCount ||
       semanticGraph.declTable.importc.len != declarationCount ||
       semanticGraph.declTable.exported.len != declarationCount:
        err = " compiler csg: semantic dependency declaration table shape mismatch"
        return false
    if semanticGraph.importEdgeTable.targetSourceIndex.len != importEdgeCount ||
       semanticGraph.importEdgeTable.ownerModulePaths.len != importEdgeCount ||
       semanticGraph.importEdgeTable.targetModulePaths.len != importEdgeCount ||
       semanticGraph.importEdgeTable.targetSourcePaths.len != importEdgeCount ||
       semanticGraph.importEdgeTable.resolved.len != importEdgeCount ||
       sourceReceipt.importEdgeCount != importEdgeCount:
        err = " compiler csg: semantic dependency import table shape mismatch"
        return false
    var declarationCursor: int32
    var importEdgeCursor: int32
    for sourceIndex in 0..<sourceCount:
        let declarationStart =
            semanticGraph.sourceTable.declStart[sourceIndex]
        let sourceDeclarationCount =
            semanticGraph.sourceTable.declCount[sourceIndex]
        let importEdgeStart =
            semanticGraph.sourceTable.importEdgeStart[sourceIndex]
        let sourceImportEdgeCount =
            semanticGraph.sourceTable.importEdgeCount[sourceIndex]
        if semanticGraph.sourceTable.sourcePaths[sourceIndex] == "" ||
           semanticGraph.sourceTable.textBytes[sourceIndex] < 0 ||
           declarationStart != declarationCursor ||
           sourceDeclarationCount < 0 ||
           declarationStart > declarationCount - sourceDeclarationCount ||
           importEdgeStart != importEdgeCursor ||
           sourceImportEdgeCount < 0 ||
           importEdgeStart > importEdgeCount - sourceImportEdgeCount:
            err = Fmt" compiler csg: semantic dependency source range invalid source={sourceIndex}"
            return false
        for declarationIndex in declarationStart..<declarationStart + sourceDeclarationCount:
            if semanticGraph.declTable.sourceIndex[declarationIndex] !=
                   sourceIndex ||
               semanticGraph.declTable.names[declarationIndex] == "" ||
               semanticGraph.declTable.lineNumbers[declarationIndex] < 0:
                err = Fmt" compiler csg: semantic dependency declaration join invalid declaration={declarationIndex}"
                return false
        for importEdgeIndex in importEdgeStart..<importEdgeStart + sourceImportEdgeCount:
            let targetSourceIndex =
                semanticGraph.importEdgeTable.targetSourceIndex[
                    importEdgeIndex]
            if semanticGraph.importEdgeTable.ownerSourceIndex[
                   importEdgeIndex] != sourceIndex ||
               targetSourceIndex < 0 ||
               targetSourceIndex >= sourceCount ||
               !semanticGraph.importEdgeTable.resolved[importEdgeIndex] ||
               semanticGraph.importEdgeTable.ownerModulePaths[
                   importEdgeIndex] !=
                   semanticGraph.sourceTable.modulePaths[sourceIndex] ||
               semanticGraph.importEdgeTable.targetModulePaths[
                   importEdgeIndex] !=
                   semanticGraph.sourceTable.modulePaths[targetSourceIndex] ||
               semanticGraph.importEdgeTable.targetSourcePaths[
                   importEdgeIndex] !=
                   semanticGraph.sourceTable.sourcePaths[targetSourceIndex]:
                err = Fmt" compiler csg: semantic dependency import join invalid edge={importEdgeIndex}"
                return false
        declarationCursor = declarationCursor + sourceDeclarationCount
        importEdgeCursor = importEdgeCursor + sourceImportEdgeCount
    if declarationCursor != declarationCount ||
       importEdgeCursor != importEdgeCount:
        err = " compiler csg: semantic dependency coverage incomplete"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgPortableArtifactStrictValidateInto(
        csg: CompilerCsg,
        sourceReceipt: PortableSourceIdentityReceipt,
        err: var str): bool =
    if !PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt, err) ||
       !PortableSourceIdentityReceiptStrictValidateInto(
           csg.sourceIdentityReceipt, err):
        return false
    if !layout.FixedBytes32Equal(csg.sourceIdentityReceipt.receiptCid,
                                 sourceReceipt.receiptCid) ||
       parser.ParserManifestNormalizePackageId(csg.packageId) != csg.packageId ||
       !layout.FixedBytes32Equal(
           CompilerCsgPortableSourcePackageIdCid(csg.packageId),
           sourceReceipt.sourcePackageIdCid) ||
       !layout.FixedBytes32Equal(csg.sourceBundleCid,
                                 sourceReceipt.sourceBundleCid) ||
       !layout.FixedBytes32Equal(csg.entrySourceCid,
                                 sourceReceipt.entrySourceCid) ||
       csg.sourceSnapshotCount != sourceReceipt.sourceSnapshotCount:
        err = " compiler csg: portable artifact source identity binding mismatch"
        return false
    if csg.nodeCount <= 0 || csg.nodeCount != csg.nodes.len ||
       csg.edgeCount < 0 || csg.edgeCount != csg.edges.len:
        err = " compiler csg: portable artifact graph column/count mismatch"
        return false
    let parserVerifyRes = parser_receipt.ParserNormalizedExprReceiptVerify(
        csg.parserNormalizedExprReceipt)
    if IsErr(parserVerifyRes):
        err = Error(parserVerifyRes)
        return false
    if !CompilerCsgTypeDiagnosticCompletionStrictValidateInto(
           csg, err):
        return false
    if !CompilerCsgOwnershipDiagnosticCompletionStrictValidateInto(
           csg, err):
        return false
    if !CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
           csg, err):
        return false
    if !CompilerCsgConcurrencyDiagnosticCompletionStrictValidateInto(
           csg, err):
        return false
    if !CompilerCsgSemanticResolvedCallParserOriginsStrictValidateInto(
           csg.semanticGraph.resolvedCallTable,
           csg.parserNormalizedExprReceipt,
           err):
        return false
    if !CompilerCsgSemanticDependencyStrictValidateInto(
           csg.semanticGraph, sourceReceipt, err):
        return false
    if !CompilerCsgExternFfiHandleContractsStrictValidateInto(csg, err):
        return false
    if !CompilerCsgExternFfiHandleCallCapabilitiesStrictValidateInto(
           csg.parserNormalizedExprReceipt,
           csg.typeArena,
           csg.semanticGraph,
           csg.typedIr,
           csg.externFfiHandleContracts,
           csg.externFfiHandleCallCapabilities,
           err):
        return false
    if !layout.FixedBytes32Equal(
           csg.parserNormalizedExprReceipt.envelope.predecessorRaw32,
           sourceReceipt.sourceBundleCid) ||
       csg.parserNormalizedExprReceipt.sourceCount !=
           Int64(sourceReceipt.sourceSnapshotCount) ||
       csg.parserNormalizedExprReceipt.importEdgeCount !=
           Int64(sourceReceipt.importEdgeCount):
        err = " compiler csg: portable artifact parser/source binding mismatch"
        return false
    var canonicalEdges: CompilerCsgEdge[]
    for edgeIndex in 0..<csg.edges.len:
        add(canonicalEdges, csg.edges[edgeIndex])
    compilerCsgCanonicalSidecarSortEdges(canonicalEdges)
    let sidecarCid = compilerCsgCanonicalSidecarCid(csg.packageId,
                                                     csg.nodes,
                                                     canonicalEdges)
    if !CompilerCsgCanonicalSidecarStrictValidateInto(
           csg.packageId,
           csg.nodes,
           canonicalEdges,
           csg.canonicalGraphCid,
           sidecarCid,
           err):
        return false
    if !CompilerCsgParserDeclarationProvenanceStrictValidateInto(csg, err):
        return false
    if !compilerCsgPortableArtifactTypedIrStrictValidateInto(csg, err):
        return false
    var externalPackageRoots: parser.ParserExternalPackageRoot[]
    var overrides: CompilerCsgSourceText[]
    let recomputedGraphCid = CompilerCsgGraphCid(csg.packageId,
                                                  csg.sourceBundleCid,
                                                  "",
                                                  "",
                                                  externalPackageRoots,
                                                  overrides,
                                                  csg.semanticGraph,
                                                  csg.nodes,
                                                  csg.edges)
    if layout.FixedBytes32Equal(csg.graphCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(csg.graphCid, recomputedGraphCid):
        err = " compiler csg: portable artifact source-bound graph cid mismatch"
        return false
    err = ""
    return true

fn CompilerCsgOwnPortableArtifactStrictValidateInto(
        csg: var CompilerCsg,
        err: var str): bool =
    var sourceReceipt =
        PortableSourceIdentityReceiptClone(csg.sourceIdentityReceipt)
    return CompilerCsgPortableArtifactStrictValidateInto(
        csg, sourceReceipt, err)

fn CompilerCsgTransitionReceiptStrictValidateInto(
        receipt: var CompilerCsgTransitionReceipt,
        sourceReceipt: var PortableSourceIdentityReceipt,
        csg: var CompilerCsg,
        err: var str): bool =
    if !CompilerCsgPortableArtifactStrictValidateInto(csg,
                                                       sourceReceipt,
                                                       err):
        return false
    if !layout.FixedBytes32Equal(receipt.sourceIdentityReceiptCid,
                                 sourceReceipt.receiptCid) ||
       !layout.FixedBytes32Equal(receipt.parserReceiptCid,
                                 csg.parserNormalizedExprReceipt.envelope.receiptRaw32) ||
       !layout.FixedBytes32Equal(receipt.compilerCsgCid,
                                 csg.graphCid) ||
       !layout.FixedBytes32Equal(receipt.canonicalCompilerCsgCid,
                                 csg.canonicalGraphCid):
        err = " compiler csg: transition receipt predecessor/artifact binding mismatch"
        return false
    let expectedReceiptCid = compilerCsgTransitionReceiptCid(receipt)
    if layout.FixedBytes32Equal(receipt.receiptCid,
                                layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(receipt.receiptCid,
                                 expectedReceiptCid):
        err = " compiler csg: transition receipt cid mismatch"
        return false
    err = ""
    return true

fn CompilerCsgOwnTransitionReceiptStrictValidateInto(
        csg: var CompilerCsg,
        err: var str): bool =
    var receipt =
        CompilerCsgTransitionReceiptClone(csg.csgTransitionReceipt)
    var sourceReceipt =
        PortableSourceIdentityReceiptClone(csg.sourceIdentityReceipt)
    return CompilerCsgTransitionReceiptStrictValidateInto(
        receipt, sourceReceipt, csg, err)

# Read-only over `node`: every field is only appended to a local buffer.
@borrows
fn CompilerCsgHashNodeRecord(node: CompilerCsgNode): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerCsgAppendText(buf, "cheng.compiler.csg.node")
    CompilerCsgAppendU32BE(buf, node.nodeKind)
    CompilerCsgAppendU32BE(buf, node.ownerNodeId)
    CompilerCsgAppendText(buf, node.modulePath)
    CompilerCsgAppendText(buf, node.symbolText)
    CompilerCsgAppendText(buf, node.factText)
    CompilerCsgAppendFixed32(buf, node.nameProofCid)
    CompilerCsgAppendText(buf, node.semanticSource)
    CompilerCsgAppendU32BE(buf, node.semanticDeclarationLineIndex)
    CompilerCsgAppendU32BE(buf, node.semanticSignatureComplete)
    CompilerCsgAppendText(buf, node.semanticParamTypeJoin)
    CompilerCsgAppendText(buf, node.semanticReturnType)
    CompilerCsgAppendU32BE(buf, node.resultLayoutKind)
    CompilerCsgAppendU32BE(buf, node.effectKind)
    CompilerCsgAppendU32BE(buf, node.capabilityKind)
    CompilerCsgAppendU32BE(buf, node.callConv)
    CompilerCsgAppendU32BE(buf, node.entryFlag)
    CompilerCsgAppendU32BE(buf, node.exportedFlag)
    CompilerCsgAppendText(buf, node.exportSymbolName)
    return CompilerCsgBufCid(buf)

@borrows
fn CompilerCsgHashNode(nodeKind: int32,
                       ownerNodeId: int32,
                       modulePath: str,
                       symbolText: str,
                       factText: str,
                       resultLayoutKind: int32,
                       effectKind: int32,
                       capabilityKind: int32,
                       callConv: int32,
                       entryFlag: int32,
                       exportedFlag: int32,
                       exportSymbolName: str): layout.FixedBytes32 =
    var node: CompilerCsgNode
    node.nodeKind = nodeKind
    node.ownerNodeId = ownerNodeId
    node.modulePath = modulePath
    node.symbolText = symbolText
    node.factText = factText
    node.resultLayoutKind = resultLayoutKind
    node.effectKind = effectKind
    node.capabilityKind = capabilityKind
    node.callConv = callConv
    node.entryFlag = entryFlag
    node.exportedFlag = exportedFlag
    node.exportSymbolName = exportSymbolName
    return CompilerCsgHashNodeRecord(node)

fn CompilerCsgHashEdge(fromNodeId: int32,
                         toNodeId: int32,
                         edgeKind: int32): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(96)
    CompilerCsgAppendText(buf, "cheng.compiler.csg.edge")
    CompilerCsgAppendU32BE(buf, fromNodeId)
    CompilerCsgAppendU32BE(buf, toNodeId)
    CompilerCsgAppendU32BE(buf, edgeKind)
    return CompilerCsgBufCid(buf)

fn CompilerCsgClearExprLayerLookup(exprLayer: var parser.NormalizedExprLayer) =
    exprLayer.exprNext = []
    exprLayer.exprLookup = parser.NormalizedExprLookup()

fn CompilerCsgNormalizedExprLayerTerminalReleaseWithReceipt(
        exprLayer: var parser.NormalizedExprLayer,
        releasedBufferCount: var int32,
        releasedBytes: var int64) =
    var receipt: parser.NormalizedExprLayerTerminalReleaseReceipt
    parser.NormalizedExprLayerTerminalReleaseWithReceipt(
        exprLayer, receipt)
    releasedBufferCount = receipt.releasedBufferCount
    releasedBytes = receipt.releasedBytes
    if !receipt.storageReleased ||
       CompilerCsgNormalizedExprLayerPhysicalBufferCount(exprLayer) != 0 ||
       CompilerCsgExprLayerSequenceBytes(
           exprLayer, true) != int64(0):
        panic("compiler csg: normalized expression release incomplete")

fn CompilerCsgNormalizedExprLayerTerminalRelease(
        exprLayer: var parser.NormalizedExprLayer) =
    var releasedBufferCount: int32
    var releasedBytes: int64
    CompilerCsgNormalizedExprLayerTerminalReleaseWithReceipt(
        exprLayer, releasedBufferCount, releasedBytes)

fn CompilerCsgNormalizeTypedFactForCsg(fact: var TypedExprFact) =
    if fact.kind != parser.NormalizedExprCall:
        return
    let builtinType = texpr.TypedExprBuiltinCalleeReturnType(fact.callCallee,
                                                             fact.callArgsText,
                                                             fact.callArgCount)
    let crossSourceTarget = fact.callTargetSourcePath != "" &&
                            parser.ParserNormalizePath(fact.callTargetSourcePath) != parser.ParserNormalizePath(fact.sourcePath)
    if fact.callKind == texpr.TypedExprCallBuiltin &&
       builtinType != "" &&
       !fact.callTargetImportc &&
       !crossSourceTarget:
        fact.callTarget = ""
        fact.callTargetSourcePath = ""
    if fact.callQualifier == "":
        return
    if !fact.callResolved:
        return
    if fact.callTargetSourcePath != "":
        return
    fact.callResolved = false
    if fact.callReason == texpr.TypedExprCallReasonNone:
        fact.callReason = texpr.TypedExprCallReasonUnknownQualifiedTarget
    fact.callTarget = ""
    fact.callTargetImportc = false

fn CompilerCsgNormalizeTypedFactRangeForCsg(facts: var TypedExprFactTable,
                                            startIndex: int32,
                                            endIndexRaw: int32) =
    var endIndex = endIndexRaw
    if endIndex < 0 || endIndex > facts.count:
        endIndex = facts.count
    for i in startIndex..<endIndex:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        var fact = texpr.TypedExprFactAt(facts, i)
        CompilerCsgNormalizeTypedFactForCsg(fact)
        texpr.TypedExprFactTableSet(facts, i, fact)

fn CompilerCsgApplyTypedFactToPersistentExpr(expr: var parser.NormalizedExpr,
                                             fact: TypedExprFact) =
    if expr.kind == parser.NormalizedExprCall:
        expr.callResolved = fact.callResolved
        if fact.callResolved:
            expr.callReason = parser.NormalizedExprCallReasonNone
        else:
            var callReason = parser.NormalizedExprCallReasonNone
            if fact.callReason == texpr.TypedExprCallReasonUnknownQualifiedTarget:
                callReason = parser.NormalizedExprCallReasonUnknownQualifiedTarget
            elif fact.callReason == texpr.TypedExprCallReasonShadowedQualifiedTarget:
                callReason = parser.NormalizedExprCallReasonShadowedQualifiedTarget
            elif fact.callReason == texpr.TypedExprCallReasonAmbiguousExternalTarget:
                callReason = parser.NormalizedExprCallReasonAmbiguousExternalTarget
            elif fact.callReason == texpr.TypedExprCallReasonAmbiguousQualifiedTarget:
                callReason = parser.NormalizedExprCallReasonAmbiguousQualifiedTarget
            elif fact.callReason == texpr.TypedExprCallReasonUnknownExternalTarget:
                callReason = parser.NormalizedExprCallReasonUnknownExternalTarget
            elif fact.callReason == texpr.TypedExprCallReasonUnknownCallTarget:
                callReason = parser.NormalizedExprCallReasonUnknownCallTarget
            expr.callReason = callReason
        expr.callQualifier = fact.callQualifier
        expr.callCallee = fact.callCallee
        expr.callTarget = fact.callTarget
        expr.callTargetSourcePath = fact.callTargetSourcePath
        expr.callTargetImportc = fact.callTargetImportc
        expr.callPrefixStyle = fact.callPrefixStyle
        expr.callArgCount = fact.callArgCount
        expr.callArgsText = fact.callArgsText
        if expr.callQualifier != "" &&
           expr.callTargetSourcePath == "" &&
           expr.callResolved:
            expr.callResolved = false
            expr.callReason = parser.NormalizedExprCallReasonUnknownQualifiedTarget
            expr.callTarget = ""
            expr.callTargetImportc = false
    elif expr.kind == parser.NormalizedExprDefaultInit ||
         expr.kind == parser.NormalizedExprConstructor:
        expr.callPrefixStyle = fact.callPrefixStyle
        expr.callArgCount = fact.callArgCount
        expr.callArgsText = fact.callArgsText
    elif expr.kind == parser.NormalizedExprResultIntrinsic ||
         expr.kind == parser.NormalizedExprTry:
        expr.callPrefixStyle = fact.callPrefixStyle
        expr.callArgCount = fact.callArgCount
        expr.callArgsText = fact.callArgsText

fn CompilerCsgAppendPersistentFactExprLayer(total: var parser.NormalizedExprLayer,
                                             source: var parser.NormalizedExprLayer,
                                             facts: var TypedExprFactTable,
                                             factStartIndex: int32,
                                             factEndIndex: int32) =
    total.sourceCount = total.sourceCount + source.sourceCount
    total.questionResidualCount = total.questionResidualCount + source.questionResidualCount
    var factCursor = factStartIndex
    for i in 0..<source.exprs.len:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if !texpr.TypedExprExprRequiresPersistentFact(source.exprs[i]):
            continue
        if factCursor < 0 || factCursor >= factEndIndex || factCursor >= facts.count:
            continue
        var expr = source.exprs[i]
        CompilerCsgApplyTypedFactToPersistentExpr(expr, texpr.TypedExprFactAt(facts, factCursor))
        factCursor = factCursor + 1
        add(total.exprs, share(expr))

@borrows
fn CompilerCsgFrontierProfileRowCertificate(index: CompilerCsgFrontierIndex,
                                            profileIndex: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(profileIndex),
                                        Int64(index.profileFunctionHeads[profileIndex]))
    out = CompilerCsgCertificateMix(out,
                                    Int64(index.profileFunctionTails[profileIndex]))
    return CompilerCsgCertificateMix(out,
                                     index.profileSelected[profileIndex] ?
                                         Int64(1) : Int64(0))

@borrows
fn CompilerCsgFrontierFunctionRowCertificate(index: CompilerCsgFrontierIndex,
                                             functionIndex: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(functionIndex),
                                        Int64(index.functionNext[functionIndex]))
    out = CompilerCsgCertificateMix(out,
                                    index.functionSelected[functionIndex] ?
                                        Int64(1) : Int64(0))
    out = CompilerCsgCertificateMix(out, Int64(index.exprStarts[functionIndex]))
    out = CompilerCsgCertificateMix(out, Int64(index.exprEnds[functionIndex]))
    out = CompilerCsgCertificateMix(out, Int64(index.factStarts[functionIndex]))
    return CompilerCsgCertificateMix(out, Int64(index.factEnds[functionIndex]))

fn CompilerCsgFrontierSelectedProfileListCertificate(rowIndex: int32,
                                                      profileIndex: int32): int64 =
    return CompilerCsgCertificateMix(Int64(rowIndex), Int64(profileIndex))

fn CompilerCsgFrontierTouchedFunctionListCertificate(rowIndex: int32,
                                                      functionIndex: int32): int64 =
    return CompilerCsgCertificateMix(Int64(rowIndex), Int64(functionIndex))

fn CompilerCsgFrontierIndexCommitDomainVersion(index: var CompilerCsgFrontierIndex) =
    if index.domainVersion <= Int64(0):
        index.domainVersion = Int64(1)
    else:
        index.domainVersion = index.domainVersion + Int64(1)
    index.sealedDomainVersion = index.domainVersion

fn CompilerCsgFrontierIndexPrepare(index: var CompilerCsgFrontierIndex,
                                   profileCount: int32,
                                   functionCount: int32) =
    index.profileFunctionHeads = []
    index.profileFunctionTails = []
    index.profileSelected = []
    for profileIndex in 0..<profileCount:
        add(index.profileFunctionHeads, -1)
        add(index.profileFunctionTails, -1)
        add(index.profileSelected, false)
    index.functionNext = []
    index.functionSelected = []
    index.exprStarts = []
    index.exprEnds = []
    index.factStarts = []
    index.factEnds = []
    index.profileRowCertificates = []
    index.functionRowCertificates = []
    index.selectedProfileListCertificates = []
    index.touchedFunctionListCertificates = []
    for functionIndex in 0..<functionCount:
        add(index.functionNext, -1)
        add(index.functionSelected, false)
        add(index.exprStarts, -1)
        add(index.exprEnds, -1)
        add(index.factStarts, -1)
        add(index.factEnds, -1)
    index.selectedProfiles = []
    index.touchedFunctions = []
    for profileIndex in 0..<profileCount:
        add(index.profileRowCertificates,
            CompilerCsgFrontierProfileRowCertificate(index, profileIndex))
    for functionIndex in 0..<functionCount:
        add(index.functionRowCertificates,
            CompilerCsgFrontierFunctionRowCertificate(index, functionIndex))
    index.certificateBuildOperationCount =
        index.certificateBuildOperationCount + Int64(profileCount + functionCount)
    CompilerCsgFrontierIndexCommitDomainVersion(index)

fn CompilerCsgFrontierIndexResetTouched(index: var CompilerCsgFrontierIndex) =
    for selectedIndex in 0..<index.selectedProfiles.len:
        let profileIndex = index.selectedProfiles[selectedIndex]
        if selectedIndex >= index.selectedProfileListCertificates.len ||
           index.selectedProfileListCertificates[selectedIndex] !=
               CompilerCsgFrontierSelectedProfileListCertificate(selectedIndex,
                                                                  profileIndex) ||
           profileIndex < 0 || profileIndex >= index.profileRowCertificates.len ||
           index.profileRowCertificates[profileIndex] !=
               CompilerCsgFrontierProfileRowCertificate(index, profileIndex):
            panic("compiler csg: frontier selected profile certificate mismatch")
    for touchedIndex in 0..<index.touchedFunctions.len:
        let functionIndex = index.touchedFunctions[touchedIndex]
        if touchedIndex >= index.touchedFunctionListCertificates.len ||
           index.touchedFunctionListCertificates[touchedIndex] !=
               CompilerCsgFrontierTouchedFunctionListCertificate(touchedIndex,
                                                                  functionIndex) ||
           functionIndex < 0 || functionIndex >= index.functionRowCertificates.len ||
           index.functionRowCertificates[functionIndex] !=
               CompilerCsgFrontierFunctionRowCertificate(index, functionIndex):
            panic("compiler csg: frontier touched function certificate mismatch")
    for selectedIndex in 0..<index.selectedProfiles.len:
        let profileIndex = index.selectedProfiles[selectedIndex]
        if profileIndex < 0 || profileIndex >= index.profileSelected.len:
            panic("compiler csg: frontier selected profile corrupt")
        index.profileSelected[profileIndex] = false
        index.profileFunctionHeads[profileIndex] = -1
        index.profileFunctionTails[profileIndex] = -1
        index.profileRowCertificates[profileIndex] =
            CompilerCsgFrontierProfileRowCertificate(index, profileIndex)
    for touchedIndex in 0..<index.touchedFunctions.len:
        let functionIndex = index.touchedFunctions[touchedIndex]
        if functionIndex < 0 || functionIndex >= index.functionSelected.len:
            panic("compiler csg: frontier touched function corrupt")
        index.functionSelected[functionIndex] = false
        index.functionNext[functionIndex] = -1
        index.exprStarts[functionIndex] = -1
        index.exprEnds[functionIndex] = -1
        index.factStarts[functionIndex] = -1
        index.factEnds[functionIndex] = -1
        index.functionRowCertificates[functionIndex] =
            CompilerCsgFrontierFunctionRowCertificate(index, functionIndex)
    index.certificateBuildOperationCount =
        index.certificateBuildOperationCount +
            Int64(index.selectedProfiles.len + index.touchedFunctions.len)
    setLen(index.selectedProfiles, 0)
    setLen(index.touchedFunctions, 0)
    setLen(index.selectedProfileListCertificates, 0)
    setLen(index.touchedFunctionListCertificates, 0)
    CompilerCsgFrontierIndexCommitDomainVersion(index)

fn CompilerCsgFrontierIndexBegin(index: var CompilerCsgFrontierIndex,
                                 profileCount: int32,
                                 functionCount: int32) =
    if index.profileFunctionHeads.len != profileCount ||
       index.functionNext.len != functionCount:
        CompilerCsgFrontierIndexPrepare(index, profileCount, functionCount)
        return
    CompilerCsgFrontierIndexResetTouched(index)

@borrows
fn CompilerCsgFrontierIndexOperationCount(index: CompilerCsgFrontierIndex): int64 =
    # Certificate builds are committed row updates. Query counts are staged in
    # the transaction and become visible only with a successful commit.
    return index.certificateBuildOperationCount +
           index.certificateValidationOperationCount +
           index.queryOperationCount

@borrows
fn CompilerCsgFrontierIndexUninitialized(index: CompilerCsgFrontierIndex): bool =
    return index.profileFunctionHeads.len == 0 &&
           index.profileFunctionTails.len == 0 &&
           index.functionNext.len == 0 && index.functionSelected.len == 0 &&
           index.profileSelected.len == 0 && index.selectedProfiles.len == 0 &&
           index.touchedFunctions.len == 0 && index.exprStarts.len == 0 &&
           index.exprEnds.len == 0 && index.factStarts.len == 0 &&
           index.factEnds.len == 0 &&
           index.profileRowCertificates.len == 0 &&
           index.functionRowCertificates.len == 0 &&
           index.selectedProfileListCertificates.len == 0 &&
           index.touchedFunctionListCertificates.len == 0 &&
           index.domainVersion == Int64(0) &&
           index.sealedDomainVersion == Int64(0)

@borrows
fn CompilerCsgFrontierIndexOwnedCapacityBytes(index: CompilerCsgFrontierIndex): int64 =
    return CompilerCsgSequenceHeaderBytes() * Int64(15) +
           Int64(index.profileFunctionHeads.cap + index.profileFunctionTails.cap +
                 index.functionNext.cap + index.selectedProfiles.cap +
                 index.touchedFunctions.cap + index.exprStarts.cap +
                 index.exprEnds.cap + index.factStarts.cap + index.factEnds.cap) *
               CompilerCsgI32Bytes() +
           Int64(index.functionSelected.cap + index.profileSelected.cap) *
               CompilerCsgBoolBytes() +
           Int64(index.profileRowCertificates.cap +
                 index.functionRowCertificates.cap +
                 index.selectedProfileListCertificates.cap +
                 index.touchedFunctionListCertificates.cap) * Int64(8)

@borrows
fn CompilerCsgFrontierIndexCertificateCapacityBytes(index: CompilerCsgFrontierIndex): int64 =
    return CompilerCsgSequenceHeaderBytes() * Int64(4) +
           Int64(index.profileRowCertificates.cap +
                 index.functionRowCertificates.cap +
                 index.selectedProfileListCertificates.cap +
                 index.touchedFunctionListCertificates.cap) * Int64(8)

fn CompilerCsgFrontierIndexAuditAndSeal(index: var CompilerCsgFrontierIndex,
                                       reachableSet: var CompilerCsgReachableFunctionSet,
                                       stagedCapacity: var int64,
                                       err: var str): bool =
    stagedCapacity = Int64(0)
    let profileCount = reachableSet.profileFunctionStarts.len
    let functionCount = reachableSet.functionNames.len
    if index.profileFunctionHeads.len != profileCount ||
       index.profileFunctionTails.len != profileCount ||
       index.profileSelected.len != profileCount ||
       index.functionNext.len != functionCount ||
       index.functionSelected.len != functionCount ||
       index.exprStarts.len != functionCount ||
       index.exprEnds.len != functionCount ||
       index.factStarts.len != functionCount ||
       index.factEnds.len != functionCount:
        err = Fmt" compiler csg: frontier index columns mismatch profiles={profileCount} profile_heads={index.profileFunctionHeads.len} profile_tails={index.profileFunctionTails.len} profile_selected={index.profileSelected.len} functions={functionCount} next={index.functionNext.len} selected={index.functionSelected.len} expr_starts={index.exprStarts.len} expr_ends={index.exprEnds.len} fact_starts={index.factStarts.len} fact_ends={index.factEnds.len}"
        return false
    var selectedProfileCount: int32
    for profileIndex in 0..<profileCount:
        let head = index.profileFunctionHeads[profileIndex]
        let tail = index.profileFunctionTails[profileIndex]
        if head < -1 || head >= functionCount || tail < -1 || tail >= functionCount ||
           ((head < 0) != (tail < 0)):
            err = Fmt" compiler csg: frontier profile adjacency invalid profile={profileIndex} head={head} tail={tail} functions={functionCount}"
            return false
        if index.profileSelected[profileIndex]:
            if head < 0:
                err = Fmt" compiler csg: frontier selected profile has no function profile={profileIndex}"
                return false
            selectedProfileCount = selectedProfileCount + 1
        elif head >= 0:
            err = Fmt" compiler csg: frontier unselected profile has function adjacency profile={profileIndex} head={head}"
            return false
    if selectedProfileCount != index.selectedProfiles.len:
        err = Fmt" compiler csg: frontier selected-profile coverage mismatch flags={selectedProfileCount} rows={index.selectedProfiles.len}"
        return false
    var selectedProfileRows: CompilerCsgSparseIntIndex
    var chainedFunctionCount: int32
    for selectedIndex in 0..<index.selectedProfiles.len:
        let profileIndex = index.selectedProfiles[selectedIndex]
        if profileIndex < 0 || profileIndex >= profileCount ||
           !index.profileSelected[profileIndex]:
            err = Fmt" compiler csg: frontier selected-profile row invalid row={selectedIndex} profile={profileIndex} profiles={profileCount}"
            return false
        if CompilerCsgSparseIntIndexFind(selectedProfileRows, profileIndex) >= 0:
            err = Fmt" compiler csg: frontier selected-profile duplicate row={selectedIndex} profile={profileIndex}"
            return false
        let _ = CompilerCsgSparseIntIndexEnsure(selectedProfileRows, profileIndex)
        var functionIndex = index.profileFunctionHeads[profileIndex]
        var localFunctionCount: int32
        while functionIndex >= 0:
            if functionIndex >= functionCount ||
               !index.functionSelected[functionIndex] ||
               reachableSet.functionProfileIndexes[functionIndex] != profileIndex:
                err = Fmt" compiler csg: frontier profile/function owner mismatch profile={profileIndex} function={functionIndex}"
                return false
            localFunctionCount = localFunctionCount + 1
            if localFunctionCount > functionCount:
                err = Fmt" compiler csg: frontier function adjacency cycle profile={profileIndex}"
                return false
            if functionIndex == index.profileFunctionTails[profileIndex] &&
               index.functionNext[functionIndex] != -1:
                err = Fmt" compiler csg: frontier function tail has successor profile={profileIndex} function={functionIndex} next={index.functionNext[functionIndex]}"
                return false
            functionIndex = index.functionNext[functionIndex]
        chainedFunctionCount = chainedFunctionCount + localFunctionCount
    var selectedFunctionCount: int32
    for functionIndex in 0..<functionCount:
        if index.functionNext[functionIndex] < -1 ||
           index.functionNext[functionIndex] >= functionCount:
            err = Fmt" compiler csg: frontier function next invalid function={functionIndex} next={index.functionNext[functionIndex]} functions={functionCount}"
            return false
        let exprStart = index.exprStarts[functionIndex]
        let exprEnd = index.exprEnds[functionIndex]
        let factStart = index.factStarts[functionIndex]
        let factEnd = index.factEnds[functionIndex]
        if ((exprStart < 0) != (exprEnd < 0)) ||
           (exprStart >= 0 && exprEnd < exprStart) ||
           ((factStart < 0) != (factEnd < 0)) ||
           (factStart >= 0 && factEnd < factStart):
            err = Fmt" compiler csg: frontier function range invalid function={functionIndex} expr_start={exprStart} expr_end={exprEnd} fact_start={factStart} fact_end={factEnd}"
            return false
        if index.functionSelected[functionIndex]:
            selectedFunctionCount = selectedFunctionCount + 1
    if selectedFunctionCount != index.touchedFunctions.len:
        err = Fmt" compiler csg: frontier touched-function coverage mismatch flags={selectedFunctionCount} rows={index.touchedFunctions.len}"
        return false
    if selectedProfileCount > 0 &&
       chainedFunctionCount != selectedFunctionCount:
        err = Fmt" compiler csg: frontier profile/function coverage mismatch chained={chainedFunctionCount} selected={selectedFunctionCount}"
        return false
    if selectedProfileCount == 0:
        for functionIndex in 0..<functionCount:
            if index.functionNext[functionIndex] != -1:
                err = Fmt" compiler csg: direct frontier function has adjacency without profile owner function={functionIndex} next={index.functionNext[functionIndex]}"
                return false
    var touchedFunctionRows: CompilerCsgSparseIntIndex
    for touchedIndex in 0..<index.touchedFunctions.len:
        let functionIndex = index.touchedFunctions[touchedIndex]
        if functionIndex < 0 || functionIndex >= functionCount ||
           !index.functionSelected[functionIndex]:
            err = Fmt" compiler csg: frontier touched-function row invalid row={touchedIndex} function={functionIndex} functions={functionCount}"
            return false
        if CompilerCsgSparseIntIndexFind(touchedFunctionRows, functionIndex) >= 0:
            err = Fmt" compiler csg: frontier touched-function duplicate row={touchedIndex} function={functionIndex}"
            return false
        let _ = CompilerCsgSparseIntIndexEnsure(touchedFunctionRows, functionIndex)
    stagedCapacity = CompilerCsgSparseIntIndexCapacityBytes(selectedProfileRows) +
                     CompilerCsgSparseIntIndexCapacityBytes(touchedFunctionRows)
    index.profileRowCertificates = []
    for profileIndex in 0..<profileCount:
        add(index.profileRowCertificates,
            CompilerCsgFrontierProfileRowCertificate(index, profileIndex))
    index.functionRowCertificates = []
    for functionIndex in 0..<functionCount:
        add(index.functionRowCertificates,
            CompilerCsgFrontierFunctionRowCertificate(index, functionIndex))
    index.selectedProfileListCertificates = []
    for selectedIndex in 0..<index.selectedProfiles.len:
        add(index.selectedProfileListCertificates,
            CompilerCsgFrontierSelectedProfileListCertificate(selectedIndex,
                index.selectedProfiles[selectedIndex]))
    index.touchedFunctionListCertificates = []
    for touchedIndex in 0..<index.touchedFunctions.len:
        add(index.touchedFunctionListCertificates,
            CompilerCsgFrontierTouchedFunctionListCertificate(touchedIndex,
                index.touchedFunctions[touchedIndex]))
    index.certificateBuildOperationCount =
        index.certificateBuildOperationCount +
            Int64(profileCount + functionCount + index.selectedProfiles.len +
                  index.touchedFunctions.len)
    CompilerCsgFrontierIndexCommitDomainVersion(index)
    err = ""
    return true

fn CompilerCsgFrontierIndexValidate(index: var CompilerCsgFrontierIndex,
                                    reachableSet: var CompilerCsgReachableFunctionSet,
                                    stagedCapacity: var int64,
                                    err: var str): bool =
    stagedCapacity = Int64(0)
    let profileCount = reachableSet.profileFunctionStarts.len
    let functionCount = reachableSet.functionNames.len
    if index.profileFunctionHeads.len != profileCount ||
       index.profileFunctionTails.len != profileCount ||
       index.profileSelected.len != profileCount ||
       index.functionNext.len != functionCount ||
       index.functionSelected.len != functionCount ||
       index.exprStarts.len != functionCount ||
       index.exprEnds.len != functionCount ||
       index.factStarts.len != functionCount ||
       index.factEnds.len != functionCount:
        err = " compiler csg: frontier index sealed column contract mismatch"
        return false
    if index.domainVersion <= Int64(0) ||
       index.sealedDomainVersion != index.domainVersion:
        return CompilerCsgFrontierIndexAuditAndSeal(index,
                                                    reachableSet,
                                                    stagedCapacity,
                                                    err)
    if index.profileRowCertificates.len != profileCount ||
       index.functionRowCertificates.len != functionCount ||
       index.selectedProfileListCertificates.len != index.selectedProfiles.len ||
       index.touchedFunctionListCertificates.len != index.touchedFunctions.len:
        err = " compiler csg: frontier index certificate columns mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgFrontierProfileRowValidate(index: CompilerCsgFrontierIndex,
                                         profileIndex: int32,
                                         operationCount: var int64,
                                         err: var str): bool =
    operationCount = operationCount + Int64(1)
    if profileIndex < 0 || profileIndex >= index.profileRowCertificates.len ||
       index.profileRowCertificates[profileIndex] !=
           CompilerCsgFrontierProfileRowCertificate(index, profileIndex):
        err = Fmt" compiler csg: frontier profile content certificate mismatch profile={profileIndex}"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgFrontierFunctionRowValidate(index: CompilerCsgFrontierIndex,
                                          functionIndex: int32,
                                          operationCount: var int64,
                                          err: var str): bool =
    operationCount = operationCount + Int64(1)
    if functionIndex < 0 || functionIndex >= index.functionRowCertificates.len ||
       index.functionRowCertificates[functionIndex] !=
           CompilerCsgFrontierFunctionRowCertificate(index, functionIndex):
        err = Fmt" compiler csg: frontier function content certificate mismatch function={functionIndex}"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgFrontierTouchedDomainValidate(index: CompilerCsgFrontierIndex,
                                            operationCount: var int64,
                                            err: var str): bool =
    for selectedIndex in 0..<index.selectedProfiles.len:
        operationCount = operationCount + Int64(1)
        if selectedIndex >= index.selectedProfileListCertificates.len ||
           index.selectedProfileListCertificates[selectedIndex] !=
               CompilerCsgFrontierSelectedProfileListCertificate(selectedIndex,
                   index.selectedProfiles[selectedIndex]):
            err = Fmt" compiler csg: frontier selected-profile list certificate mismatch row={selectedIndex}"
            return false
        if !CompilerCsgFrontierProfileRowValidate(index,
                                                  index.selectedProfiles[selectedIndex],
                                                  operationCount,
                                                  err):
            return false
    for touchedIndex in 0..<index.touchedFunctions.len:
        operationCount = operationCount + Int64(1)
        if touchedIndex >= index.touchedFunctionListCertificates.len ||
           index.touchedFunctionListCertificates[touchedIndex] !=
               CompilerCsgFrontierTouchedFunctionListCertificate(touchedIndex,
                   index.touchedFunctions[touchedIndex]):
            err = Fmt" compiler csg: frontier touched-function list certificate mismatch row={touchedIndex}"
            return false
        if !CompilerCsgFrontierFunctionRowValidate(index,
                                                   index.touchedFunctions[touchedIndex],
                                                   operationCount,
                                                   err):
            return false
    err = ""
    return true

@borrows
fn CompilerCsgMergeInt32PassRec(source: var int32[],
                                destination: var int32[],
                                width: int32,
                                leftStart: int32) =
    while true:
        let count = source.len
        if leftStart >= count:
            return
        let midRaw = leftStart + width
        var mid = count
        if midRaw < count:
            mid = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = mid
        for outputIndex in leftStart..<rightEnd:
            if left < mid && (right >= rightEnd || source[left] <= source[right]):
                destination[outputIndex] = source[left]
                left = left + 1
            else:
                destination[outputIndex] = source[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

fn CompilerCsgMergeInt32Pass(source: var int32[],
                             destination: var int32[],
                             width: int32) =
    CompilerCsgMergeInt32PassRec(source, destination, width, 0)

@borrows
fn CompilerCsgSortedUniqueFunctionIndexesMeasured(items: int32[],
                                                  functionCount: int32,
                                                  sortingScratchBytes: var int64,
                                                  err: var str): int32[] =
    sortingScratchBytes = Int64(0)
    var out: int32[]
    for itemIndex in 0..<items.len:
        if items[itemIndex] < 0 || items[itemIndex] >= functionCount:
            err = Fmt" compiler csg: frontier function index out of range frontier_index={itemIndex} function_index={items[itemIndex]} function_count={functionCount}"
            return []
        add(out, items[itemIndex])
    if out.len > 1:
        var scratch: int32[]
        for itemIndex in 0..<out.len:
            add(scratch, out[itemIndex])
        var width: int32 = 1
        var readScratch = false
        while width < out.len:
            if readScratch:
                CompilerCsgMergeInt32Pass(scratch, out, width)
            else:
                CompilerCsgMergeInt32Pass(out, scratch, width)
            readScratch = !readScratch
            if width > out.len / 2:
                width = out.len
            else:
                width = width * 2
        if readScratch:
            for itemIndex in 0..<out.len:
                out[itemIndex] = scratch[itemIndex]
        sortingScratchBytes = Int64(scratch.cap) * CompilerCsgI32Bytes()
    for itemIndex in 1..<out.len:
        if out[itemIndex - 1] == out[itemIndex]:
            err = Fmt" compiler csg: frontier function index conflict function_index={out[itemIndex]}"
            return []
    err = ""
    return out

@borrows
fn CompilerCsgSortedUniqueFunctionIndexes(items: int32[],
                                          functionCount: int32,
                                          err: var str): int32[] =
    var sortingScratchBytes: int64
    return CompilerCsgSortedUniqueFunctionIndexesMeasured(items,
                                                           functionCount,
                                                           sortingScratchBytes,
                                                           err)

@borrows
fn CompilerCsgSortedFunctionIndexPosition(items: int32[],
                                          functionIndex: int32): int32 =
    var low: int32
    var high = items.len
    while low < high:
        let mid = low + (high - low) / 2
        if items[mid] < functionIndex:
            low = mid + 1
        else:
            high = mid
    if low < items.len && items[low] == functionIndex:
        return low
    return -1

@borrows
fn CompilerCsgFrontierTransactionPersistentPhase(transaction: CompilerCsgFrontierTransaction,
                                                 phase: var CompilerCsgStagingCapacityLedger) =
    phase = CompilerCsgStagingCapacityLedger()
    phase.sparseIndexBytes =
        CompilerCsgSparseIntIndexCapacityBytes(transaction.selectedFunctionIndex) +
        CompilerCsgSparseIntIndexCapacityBytes(transaction.selectedProfileIndex)
    phase.frontierSelectionBytes = CompilerCsgSequenceHeaderBytes() * Int64(5) +
        Int64(transaction.selectedFunctionNext.cap +
              transaction.selectedProfileHeads.cap +
              transaction.selectedProfileTails.cap +
              transaction.selectedFunctions.cap +
              transaction.selectedProfiles.cap) * CompilerCsgI32Bytes()
    phase.validationBytes = transaction.initialIndexBytes

fn CompilerCsgFrontierTransactionRefreshLedger(transaction: var CompilerCsgFrontierTransaction) =
    var phase: CompilerCsgStagingCapacityLedger
    CompilerCsgFrontierTransactionPersistentPhase(transaction, phase)
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger, phase)

fn CompilerCsgReachableFunctionSetInit(active: bool): CompilerCsgReachableFunctionSet =
    var out: CompilerCsgReachableFunctionSet
    out.active = active
    out.structureVersion = Int64(1)
    out.graphVersion = Int64(1)
    for edgeSlot in 0..<64:
        add(out.edgePairSlots, 0)
        add(out.edgePairSlotCertificates,
            CompilerCsgReachableEdgePairSlotCertificate(edgeSlot, 0))
    out.profileSourceIndex = CompilerCsgSourcePathIndexInit(16)
    out.scopedFunctionNames = CompilerCsgReachableNameIndexInit(32)
    out.globalFunctionNames = CompilerCsgReachableNameIndexInit(32)
    return out

fn CompilerCsgReachableFunctionSetReleaseIndexes(ruleSet: var CompilerCsgReachableFunctionSet) =
    ruleSet.edgePairSlots = []
    CompilerCsgSourcePathIndexClear(ruleSet.profileSourceIndex)
    ruleSet.scopedFunctionNames = CompilerCsgNameAdjacencyIndex()
    ruleSet.globalFunctionNames = CompilerCsgNameAdjacencyIndex()
    ruleSet.profileRowCertificates = []
    ruleSet.functionRowCertificates = []
    ruleSet.reachableRowCertificates = []
    ruleSet.reachableQueueCertificates = []
    ruleSet.edgeHeadCertificates = []
    ruleSet.edgeRowCertificates = []
    ruleSet.edgePairSlotCertificates = []
    ruleSet.structureContentCertificate = Int64(0)
    ruleSet.graphContentCertificate = Int64(0)
    ruleSet.structureVersion = ruleSet.structureVersion + Int64(1)
    ruleSet.structureSealedVersion = Int64(0)
    ruleSet.structureShapeSeal = Int64(0)
    ruleSet.graphVersion = ruleSet.graphVersion + Int64(1)
    ruleSet.graphSealedVersion = Int64(0)
    ruleSet.graphShapeSeal = Int64(0)

@borrows
fn CompilerCsgFunctionTailName(nameRaw: str): str =
    var name = chengpath.PathTrim(nameRaw)
    var sep = CompilerCsgFindText(name, "::")
    if sep >= 0:
        name = chengpath.TextSlice(name, sep + 2, name.len - sep - 2)
    var dot: int32 = -1
    for i in 0..<name.len:
        if name[i] == '.':
            dot = i
    if dot >= 0:
        name = chengpath.TextSlice(name, dot + 1, name.len - dot - 1)
    return name

@borrows
fn CompilerCsgSourcePathsEquivalent(leftRaw: str, rightRaw: str): bool =
    return texpr.TypedExprSourcePathsEquivalent(leftRaw, rightRaw)

@borrows
fn CompilerCsgSourcePathsEquivalentNormalized(left: str, right: str): bool =
    return texpr.TypedExprSourcePathsEquivalent(left, right)

fn CompilerCsgSourcePathIndexSlotCertificate(slotIndex: int32,
                                             bucketIndexPlus1: int32): int64 =
    return CompilerCsgCertificateMix(Int64(slotIndex), Int64(bucketIndexPlus1))

@borrows
fn CompilerCsgSourcePathIndexBucketCertificate(bucketIndex: int32,
                                               bucket: parser.ParserSourcePathIndexBucket): int64 =
    var out = CompilerCsgCertificateMix(Int64(bucketIndex), Int64(bucket.keyLen))
    out = CompilerCsgCertificateMix(out, Int64(bucket.firstCode))
    out = CompilerCsgCertificateMix(out, Int64(bucket.lastCode))
    out = CompilerCsgCertificateMix(out, Int64(bucket.dotCount))
    return CompilerCsgCertificateMix(out, Int64(bucket.sourcePathHash))

@borrows
fn CompilerCsgSourcePathIndexItemCertificate(bucketIndex: int32,
                                             itemIndex: int32,
                                             item: parser.ParserSourcePathIndexEntry): int64 =
    var out = CompilerCsgCertificateMix(Int64(bucketIndex), Int64(itemIndex))
    out = CompilerCsgCertificateMix(out,
                                    CompilerCsgTextContentCertificate(item.sourcePath))
    return CompilerCsgCertificateMix(out, Int64(item.profileIndex))

@borrows
fn CompilerCsgSourcePathIndexRootCertificate(rootIndex: int32,
                                             root: str): int64 =
    return CompilerCsgCertificateMix(Int64(rootIndex),
                                     CompilerCsgTextContentCertificate(root))

@borrows
fn CompilerCsgSourcePathIndexRelativeRootCertificate(root: str): int64 =
    return CompilerCsgCertificateMix(Int64(773),
                                     CompilerCsgTextContentCertificate(root))

fn CompilerCsgSourcePathIndexCommitDomain(index: var CompilerCsgSourcePathIndex) =
    if index.domainVersion <= Int64(0):
        index.domainVersion = Int64(1)
    else:
        index.domainVersion = index.domainVersion + Int64(1)
    index.sealedDomainVersion = index.domainVersion

fn CompilerCsgSourcePathIndexRebuildSlotCertificates(index: var CompilerCsgSourcePathIndex) =
    index.slotCertificates = []
    for slotIndex in 0..<index.lookup.slots.len:
        add(index.slotCertificates,
            CompilerCsgSourcePathIndexSlotCertificate(slotIndex,
                                                      index.lookup.slots[slotIndex]))

fn CompilerCsgSourcePathIndexDomainValidate(index: var CompilerCsgSourcePathIndex,
                                            err: var str): bool =
    if index.domainVersion <= Int64(0) ||
       index.sealedDomainVersion != index.domainVersion:
        err = Fmt" compiler csg: source path index domain unsealed version={index.domainVersion} sealed={index.sealedDomainVersion}"
        return false
    if index.slotCertificates.len != index.lookup.slots.len ||
       index.bucketCertificates.len != index.lookup.buckets.len ||
       index.rootCertificates.len != index.roots.len:
        err = Fmt" compiler csg: source path index certificate columns mismatch slots={index.lookup.slots.len}/{index.slotCertificates.len} buckets={index.lookup.buckets.len}/{index.bucketCertificates.len} roots={index.roots.len}/{index.rootCertificates.len}"
        return false
    for rootIndex in 0..<index.roots.len:
        if index.rootCertificates[rootIndex] !=
           CompilerCsgSourcePathIndexRootCertificate(rootIndex,
                                                     index.roots[rootIndex]):
            err = Fmt" compiler csg: source path index root certificate mismatch root={rootIndex}"
            return false
    if index.rootsConfigured:
        if index.relativeRoot == "" ||
           index.relativeRootCertificate !=
               CompilerCsgSourcePathIndexRelativeRootCertificate(
                   index.relativeRoot):
            err = " compiler csg: source path index relative root certificate mismatch"
            return false
        var relativeRootKnown = false
        for rootIndex in 0..<index.roots.len:
            if texpr.TypedExprSourcePathsEquivalent(index.roots[rootIndex],
                                                     index.relativeRoot):
                relativeRootKnown = true
        if !relativeRootKnown:
            err = Fmt" compiler csg: source path index relative root outside domain root={index.relativeRoot}"
            return false
    elif index.relativeRoot != "" || index.relativeRootCertificate != Int64(0):
        err = " compiler csg: unconfigured source path index carries relative root"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgSourcePathIndexFindCanonical(index: var CompilerCsgSourcePathIndex,
                                           sourcePath: str,
                                           sourceIndex: var int32,
                                           err: var str): bool =
    sourceIndex = -1
    if sourcePath == "":
        err = ""
        return true
    if !CompilerCsgSourcePathIndexDomainValidate(index, err):
        return false
    if index.lookup.slots.len <= 0 ||
       (index.lookup.slots.len & (index.lookup.slots.len - 1)) != 0:
        err = Fmt" compiler csg: source path index slot domain invalid slots={index.lookup.slots.len}"
        return false
    let keyLen = sourcePath.len
    let firstCode = Int32(sourcePath[0])
    let lastCode = Int32(sourcePath[keyLen - 1])
    let dotCount = parser.ParserTextLookupDotCount(sourcePath)
    let sourcePathHash = parser.ParserTextLookupContentHash(sourcePath)
    let mask = index.lookup.slots.len - 1
    var slot = Int32(parser.ParserTextLookupHash(keyLen,
                                                firstCode,
                                                lastCode,
                                                dotCount,
                                                sourcePathHash) & Int64(mask))
    var scanned: int32
    while scanned <= mask:
        let bucketIndexPlus1 = index.lookup.slots[slot]
        if index.slotCertificates[slot] !=
           CompilerCsgSourcePathIndexSlotCertificate(slot,
                                                     bucketIndexPlus1):
            err = Fmt" compiler csg: source path index slot certificate mismatch slot={slot}"
            return false
        if bucketIndexPlus1 == 0:
            err = ""
            return true
        let bucketIndex = bucketIndexPlus1 - 1
        if bucketIndex < 0 || bucketIndex >= index.lookup.buckets.len ||
           bucketIndex >= index.bucketCertificates.len:
            err = Fmt" compiler csg: source path index bucket missing slot={slot} bucket={bucketIndex}"
            return false
        if index.bucketCertificates[bucketIndex].keyCertificate !=
           CompilerCsgSourcePathIndexBucketCertificate(
               bucketIndex,
               index.lookup.buckets[bucketIndex]):
            err = Fmt" compiler csg: source path index bucket certificate mismatch bucket={bucketIndex}"
            return false
        if index.lookup.buckets[bucketIndex].keyLen == keyLen &&
           index.lookup.buckets[bucketIndex].firstCode == firstCode &&
           index.lookup.buckets[bucketIndex].lastCode == lastCode &&
           index.lookup.buckets[bucketIndex].dotCount == dotCount &&
           index.lookup.buckets[bucketIndex].sourcePathHash == sourcePathHash:
            if index.bucketCertificates[bucketIndex].itemCertificates.len !=
               index.lookup.buckets[bucketIndex].items.len:
                err = Fmt" compiler csg: source path index item certificate columns mismatch bucket={bucketIndex} items={index.lookup.buckets[bucketIndex].items.len} certificates={index.bucketCertificates[bucketIndex].itemCertificates.len}"
                return false
            for itemIndex in 0..<index.lookup.buckets[bucketIndex].items.len:
                if index.bucketCertificates[bucketIndex].itemCertificates[itemIndex] !=
                   CompilerCsgSourcePathIndexItemCertificate(bucketIndex,
                                                             itemIndex,
                                                             index.lookup.buckets[bucketIndex].items[itemIndex]):
                    err = Fmt" compiler csg: source path index item certificate mismatch bucket={bucketIndex} item={itemIndex}"
                    return false
                if parser.ParserTextEqualsExact(
                        index.lookup.buckets[bucketIndex].items[itemIndex].sourcePath,
                        sourcePath):
                    sourceIndex =
                        index.lookup.buckets[bucketIndex].items[itemIndex].profileIndex
                    err = ""
                    return true
            err = ""
            return true
        slot = (slot + 1) & mask
        scanned = scanned + 1
    err = " compiler csg: source path index probe exhausted"
    return false

fn CompilerCsgSourcePathIndexInit(minCap: int32): CompilerCsgSourcePathIndex =
    var cap = minCap
    if cap < 8:
        cap = 8
    var out: CompilerCsgSourcePathIndex
    out.lookup = parser.ParserSourcePathIndexLookupInit(cap)
    CompilerCsgSourcePathIndexRebuildSlotCertificates(out)
    CompilerCsgSourcePathIndexCommitDomain(out)
    return out

fn CompilerCsgSourcePathIndexClear(index: var CompilerCsgSourcePathIndex) =
    index = CompilerCsgSourcePathIndex()

@borrows
fn CompilerCsgSourcePathIndexConfigureRoots(index: var CompilerCsgSourcePathIndex,
                                            workspaceRoot: str,
                                            packageRoot: str,
                                            externalPackageRoots: parser.ParserExternalPackageRoot[],
                                            err: var str): bool =
    if !CompilerCsgSourcePathIndexDomainValidate(index, err):
        return false
    if index.lookup.buckets.len > 0:
        err = Fmt" compiler csg: source path index roots configured after insert entry_count={index.lookup.buckets.len}"
        return false
    var roots: str[]
    if !texpr.TypedExprSourceIdentityRoots(workspaceRoot,
                                           packageRoot,
                                           externalPackageRoots,
                                           roots,
                                           err):
        return false
    index.roots = roots
    index.relativeRoot = parser.ParserOwnedText(packageRoot)
    index.rootCertificates = []
    for rootIndex in 0..<index.roots.len:
        add(index.rootCertificates,
            CompilerCsgSourcePathIndexRootCertificate(rootIndex,
                                                      index.roots[rootIndex]))
    index.relativeRootCertificate =
        CompilerCsgSourcePathIndexRelativeRootCertificate(index.relativeRoot)
    index.rootsConfigured = true
    CompilerCsgSourcePathIndexCommitDomain(index)
    err = ""
    return true

fn CompilerCsgSourcePathIndexInitLike(source: var CompilerCsgSourcePathIndex,
                                      minCap: int32): CompilerCsgSourcePathIndex =
    var validationErr: str
    if !CompilerCsgSourcePathIndexDomainValidate(source, validationErr):
        panic(validationErr)
    var out = CompilerCsgSourcePathIndexInit(minCap)
    for rootIndex in 0..<source.roots.len:
        # Owned copies: sharing the element view (and moving relativeRoot out
        # of the var parameter) leaves the clone lifetime-coupled to `source`,
        # which trips the root certificate check once source is released.
        add(out.roots, parser.ParserOwnedText(source.roots[rootIndex]))
        add(out.rootCertificates,
            CompilerCsgSourcePathIndexRootCertificate(rootIndex,
                                                      source.roots[rootIndex]))
    out.relativeRoot = parser.ParserOwnedText(source.relativeRoot)
    out.relativeRootCertificate = source.relativeRootCertificate
    out.rootsConfigured = source.rootsConfigured
    # sealedClosurePaths 白名单随 index 复制 (CanonicalKey 的 root 外直通依据)。
    let sourceSealedClosure = source.sealedClosurePaths
    for cloI in 0..<sourceSealedClosure.len:
        add(out.sealedClosurePaths, share(sourceSealedClosure[cloI]))
    CompilerCsgSourcePathIndexCommitDomain(out)
    return out

@borrows
fn CompilerCsgSourcePathIndexSealClosure(index: var CompilerCsgSourcePathIndex,
                                         closurePaths: str[]) =
    # 裁定: 单一权威=plan 封缄身份。把 sealed closure 成员路径(plan.sourceClosurePaths)
    # 预存进 index 作白名单; root 外文件 CanonicalKey 先核对此白名单(精确路径匹配),
    # 在 closure 内即直通作身份键, 不再要 root 锚点。严禁任意路径放行。
    for cloI in 0..<closurePaths.len:
        add(index.sealedClosurePaths, parser.ParserNormalizePath(closurePaths[cloI]))

@borrows
fn CompilerCsgSourcePathIndexCanonicalKey(index: var CompilerCsgSourcePathIndex,
                                          sourcePathRaw: str,
                                          key: var str,
                                          err: var str): bool =
    if !CompilerCsgSourcePathIndexDomainValidate(index, err):
        return false
    if !index.rootsConfigured:
        err = " compiler csg: source path index roots missing"
        return false
    var rootsErr: str
    if texpr.TypedExprSourceIdentityKeyFromRoots(index.roots,
                                                 index.relativeRoot,
                                                 sourcePathRaw,
                                                 key,
                                                 rootsErr):
        err = ""
        return true
    # 裁定: root 外文件核对 sealed closure 成员白名单(plan.sourceClosurePaths 精确
    # 路径匹配), 在 closure 内即直通作身份键(绝对路径), 不再要 root 锚点。
    let reqPath = parser.ParserNormalizePath(sourcePathRaw)
    let sealedClosure = index.sealedClosurePaths
    for cloI in 0..<sealedClosure.len:
        if sealedClosure[cloI] == reqPath:
            key = reqPath
            err = ""
            return true
    err = rootsErr
    return false

@borrows
fn CompilerCsgSourcePathIndexCanonicalKeyUnderRoot(index: var CompilerCsgSourcePathIndex,
                                                   selectedRoot: str,
                                                   sourcePathRaw: str,
                                                   key: var str,
                                                   err: var str): bool =
    if !CompilerCsgSourcePathIndexDomainValidate(index, err):
        return false
    if !index.rootsConfigured:
        err = " compiler csg: source path index roots missing"
        return false
    return texpr.TypedExprSourceIdentityKeyUnderRoot(index.roots,
                                                     selectedRoot,
                                                     sourcePathRaw,
                                                     key,
                                                     err)

@borrows
fn CompilerCsgSourcePathIndexFind(index: var CompilerCsgSourcePathIndex,
                                  sourcePathRaw: str,
                                  sourceIndex: var int32,
                                  err: var str): bool =
    sourceIndex = -1
    var sourcePath: str
    if !CompilerCsgSourcePathIndexCanonicalKey(index,
                                                sourcePathRaw,
                                                sourcePath,
                                                err):
        return false
    return CompilerCsgSourcePathIndexFindCanonical(index,
                                                   sourcePath,
                                                   sourceIndex,
                                                   err)

@borrows
fn CompilerCsgSourcePathIndexEquivalentForInsert(index: var CompilerCsgSourcePathIndex,
                                                 sourcePathRaw: str,
                                                 sourceIndex: var int32,
                                                 err: var str): bool =
    sourceIndex = -1
    return CompilerCsgSourcePathIndexFind(index,
                                          sourcePathRaw,
                                          sourceIndex,
                                          err)

fn CompilerCsgSourcePathIndexRegisterCanonical(index: var CompilerCsgSourcePathIndex,
                                               sourcePath: str,
                                               sourceIndex: int32,
                                               err: var str): bool =
    if sourcePath == "" || sourceIndex < 0:
        err = Fmt" compiler csg: source path index register invalid path={sourcePath} index={sourceIndex}"
        return false
    var existingIndex: int32
    if !CompilerCsgSourcePathIndexFindCanonical(index,
                                                sourcePath,
                                                existingIndex,
                                                err):
        return false
    if existingIndex >= 0 && existingIndex != sourceIndex:
        err = Fmt" compiler csg: source path index identity conflict path={sourcePath} first_index={existingIndex} next_index={sourceIndex}"
        return false
    if existingIndex < 0:
        let oldSlotCount = index.lookup.slots.len
        let bucketIndex = parser.ParserSourcePathIndexEnsureBucket(index.lookup,
                                                                   sourcePath)
        if bucketIndex < 0:
            err = Fmt" compiler csg: source path index bucket allocation failed path={sourcePath}"
            return false
        if index.lookup.slots.len != oldSlotCount:
            CompilerCsgSourcePathIndexRebuildSlotCertificates(index)
        while index.bucketCertificates.len < index.lookup.buckets.len:
            let nextBucketIndex = index.bucketCertificates.len
            var certificates: CompilerCsgSourcePathIndexBucketCertificates
            certificates.keyCertificate = CompilerCsgSourcePathIndexBucketCertificate(
                nextBucketIndex,
                index.lookup.buckets[nextBucketIndex])
            add(index.bucketCertificates, certificates)
        if bucketIndex >= index.bucketCertificates.len:
            err = Fmt" compiler csg: source path index bucket certificate missing bucket={bucketIndex}"
            return false
        let keyLen = sourcePath.len
        let slot = parser.ParserSourcePathIndexLookupSlotForParts(index.lookup,
                                                                  keyLen,
                                                                  Int32(sourcePath[0]),
                                                                  Int32(sourcePath[keyLen - 1]),
                                                                  parser.ParserTextLookupDotCount(sourcePath),
                                                                  parser.ParserTextLookupContentHash(sourcePath))
        if slot < 0 || index.lookup.slots[slot] != bucketIndex + 1:
            err = Fmt" compiler csg: source path index inserted slot missing path={sourcePath} bucket={bucketIndex} slot={slot}"
            return false
        index.slotCertificates[slot] =
            CompilerCsgSourcePathIndexSlotCertificate(slot,
                                                      index.lookup.slots[slot])
        var item: parser.ParserSourcePathIndexEntry
        item.sourcePath = sourcePath
        item.profileIndex = sourceIndex
        add(index.lookup.buckets[bucketIndex].items, item)
        index.bucketCertificates[bucketIndex].keyCertificate =
            CompilerCsgSourcePathIndexBucketCertificate(
                bucketIndex,
                index.lookup.buckets[bucketIndex])
        add(index.bucketCertificates[bucketIndex].itemCertificates,
            CompilerCsgSourcePathIndexItemCertificate(bucketIndex,
                                                      index.lookup.buckets[bucketIndex].items.len - 1,
                                                      index.lookup.buckets[bucketIndex].items[
                                                          index.lookup.buckets[bucketIndex].items.len - 1]))
        CompilerCsgSourcePathIndexCommitDomain(index)
    err = ""
    return true

@borrows
fn CompilerCsgSourcePathIndexRegister(index: var CompilerCsgSourcePathIndex,
                                      sourcePathRaw: str,
                                      sourceIndex: int32,
                                      err: var str): bool =
    var sourcePath: str
    if !CompilerCsgSourcePathIndexCanonicalKey(index,
                                                sourcePathRaw,
                                                sourcePath,
                                                err):
        return false
    return CompilerCsgSourcePathIndexRegisterCanonical(index,
                                                       sourcePath,
                                                       sourceIndex,
                                                       err)

fn CompilerCsgSourcePathIndexRegisterUnderRoot(index: var CompilerCsgSourcePathIndex,
                                               selectedRoot: str,
                                               sourcePathRaw: str,
                                               sourceIndex: int32,
                                               err: var str): bool =
    var sourcePath: str
    if !CompilerCsgSourcePathIndexCanonicalKeyUnderRoot(index,
                                                        selectedRoot,
                                                        sourcePathRaw,
                                                        sourcePath,
                                                        err):
        return false
    return CompilerCsgSourcePathIndexRegisterCanonical(index,
                                                       sourcePath,
                                                       sourceIndex,
                                                       err)

@borrows
fn CompilerCsgCaptureImmutableSourceSnapshot(snapshots: var CompilerCsgSourceText[],
                                              snapshotIndex: var CompilerCsgSourcePathIndex,
                                              sourcePathRaw: str,
                                              modulePath: str,
                                              text: str,
                                              err: var str): bool =
    var sourcePath: str
    if !CompilerCsgSourcePathIndexCanonicalKey(snapshotIndex,
                                                sourcePathRaw,
                                                sourcePath,
                                                err):
        return false
    if modulePath == "":
        err = Fmt" compiler csg: immutable source snapshot module missing source={sourcePath}"
        return false
    var existingIndex: int32
    if !CompilerCsgSourcePathIndexEquivalentForInsert(snapshotIndex,
                                                      sourcePath,
                                                      existingIndex,
                                                      err):
        return false
    if existingIndex >= 0:
        if existingIndex >= snapshots.len:
            err = Fmt" compiler csg: immutable source snapshot index corrupt source={sourcePath} index={existingIndex} count={snapshots.len}"
            return false
        if snapshots[existingIndex].modulePath != modulePath:
            err = Fmt" compiler csg: immutable source snapshot module conflict source={sourcePath} indexed_source={snapshots[existingIndex].sourcePath} expected={snapshots[existingIndex].modulePath} actual={modulePath}"
            return false
        if snapshots[existingIndex].text != text:
            err = Fmt" compiler csg: immutable source snapshot body conflict source={sourcePath} indexed_source={snapshots[existingIndex].sourcePath}"
            return false
        if !CompilerCsgSourcePathIndexRegister(snapshotIndex,
                                               sourcePath,
                                               existingIndex,
                                               err):
            return false
        err = ""
        return true
    var snapshot: CompilerCsgSourceText
    snapshot.sourcePath = share(sourcePath)
    snapshot.modulePath = parser.ParserOwnedText(modulePath)
    snapshot.text = parser.ParserOwnedText(text)
    add(snapshots, snapshot)
    if !CompilerCsgSourcePathIndexRegister(snapshotIndex,
                                           sourcePath,
                                           snapshots.len - 1,
                                           err):
        setLen(snapshots, snapshots.len - 1)
        return false
    err = ""
    return true

@borrows
fn CompilerCsgVerifyImmutableSourceIdentity(packageId: str,
                                              entrySourcePath: str,
                                              sourceClosurePaths: str[],
                                              sourceBundleIdentityPaths: str[],
                                              ownerModulePaths: str[],
                                              expectedSourceBundleCid: layout.FixedBytes32,
                                              snapshots: var CompilerCsgSourceText[],
                                              snapshotIndex: var CompilerCsgSourcePathIndex,
                                              outEntrySourceCid: var layout.FixedBytes32,
                                              err: var str): bool =
    if sourceClosurePaths.len <= 0 ||
       sourceBundleIdentityPaths.len != sourceClosurePaths.len ||
       ownerModulePaths.len != sourceClosurePaths.len ||
       snapshots.len != sourceClosurePaths.len:
        err = Fmt" compiler csg: immutable source identity column mismatch closure={sourceClosurePaths.len} identity={sourceBundleIdentityPaths.len} owner={ownerModulePaths.len} snapshots={snapshots.len}"
        return false
    var sourceTexts: str[]
    var snapshotSeen: bool[]
    for snapshotIndexValue in 0..<snapshots.len:
        add(snapshotSeen, false)
    for sourceIndex in 0..<sourceClosurePaths.len:
        if sourceIndex % 16 == 0:
            os.ProcessResourceGuardCheck()
        if sourceBundleIdentityPaths[sourceIndex] == "":
            err = Fmt" compiler csg: immutable source identity path empty index={sourceIndex}"
            return false
        var matchedSnapshotIndex: int32
        if !CompilerCsgSourcePathIndexFind(snapshotIndex,
                                           sourceClosurePaths[sourceIndex],
                                           matchedSnapshotIndex,
                                           err):
            return false
        if matchedSnapshotIndex < 0 || matchedSnapshotIndex >= snapshots.len:
            err = Fmt" compiler csg: immutable source identity snapshot missing source={sourceClosurePaths[sourceIndex]} index={sourceIndex}"
            return false
        if snapshotSeen[matchedSnapshotIndex]:
            err = Fmt" compiler csg: immutable source identity closure duplicate source={sourceClosurePaths[sourceIndex]} index={sourceIndex}"
            return false
        snapshotSeen[matchedSnapshotIndex] = true
        let snapshot = snapshots[matchedSnapshotIndex]
        if snapshot.sourcePath == "" || snapshot.modulePath == "":
            err = Fmt" compiler csg: immutable source identity row incomplete index={matchedSnapshotIndex}"
            return false
        if snapshot.modulePath != ownerModulePaths[sourceIndex]:
            err = Fmt" compiler csg: immutable source owner mismatch source={sourceClosurePaths[sourceIndex]} expected={ownerModulePaths[sourceIndex]} actual={snapshot.modulePath}"
            return false
        add(sourceTexts, share(snapshot.text))
    for snapshotIndexValue in 0..<snapshotSeen.len:
        if !snapshotSeen[snapshotIndexValue]:
            err = Fmt" compiler csg: immutable source identity snapshot outside closure index={snapshotIndexValue} source={snapshots[snapshotIndexValue].sourcePath}"
            return false
    var hasSourcePathIdentity = false
    for identityIndex in 0..<sourceBundleIdentityPaths.len:
        if parser.ParserSourceIdentityPathAbsolute(
                sourceBundleIdentityPaths[identityIndex]):
            hasSourcePathIdentity = true
            break
    var actualSourceBundleCid: layout.FixedBytes32
    if hasSourcePathIdentity:
        if !slplan.SystemLinkPlanSourcePathBundleCidInto(
                packageId,
                sourceBundleIdentityPaths,
                sourceTexts,
                actualSourceBundleCid):
            err = " compiler csg: immutable source bundle identity build failed"
            return false
    else:
        let sourceBundleRes = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(packageId,
                                                                                   sourceBundleIdentityPaths,
                                                                                   sourceTexts)
        if IsErr(sourceBundleRes):
            err = " compiler csg: immutable source bundle identity build failed"
            return false
        actualSourceBundleCid = Value(sourceBundleRes)
    if !layout.FixedBytes32Equal(actualSourceBundleCid, expectedSourceBundleCid):
        err = Fmt" compiler csg: source bundle changed between plan and immutable snapshot expected={layout.FixedBytes32Hex(expectedSourceBundleCid)} actual={layout.FixedBytes32Hex(actualSourceBundleCid)}"
        return false
    var entrySourceIndex: int32
    if !CompilerCsgSourcePathIndexFind(snapshotIndex,
                                       entrySourcePath,
                                       entrySourceIndex,
                                       err):
        return false
    if entrySourceIndex < 0 || entrySourceIndex >= snapshots.len:
        err = Fmt" compiler csg: immutable entry source missing source={entrySourcePath}"
        return false
    let entrySourceText = snapshots[entrySourceIndex].text
    outEntrySourceCid =
        cworld.CompilerWorldSourceRawBytesCidBorrowed(entrySourceText)
    err = ""
    return true

@borrows
fn CompilerCsgImmutableSourceSnapshotText(snapshots: var CompilerCsgSourceText[],
                                           snapshotIndex: var CompilerCsgSourcePathIndex,
                                           sourcePathRaw: str,
                                           out: var str,
                                           err: var str): bool =
    var sourcePath: str
    if !CompilerCsgSourcePathIndexCanonicalKey(snapshotIndex,
                                                sourcePathRaw,
                                                sourcePath,
                                                err):
        return false
    var sourceIndex: int32
    if !CompilerCsgSourcePathIndexFind(snapshotIndex,
                                       sourcePath,
                                       sourceIndex,
                                       err):
        return false
    if sourceIndex < 0:
        err = Fmt" compiler csg: immutable source snapshot missing source={sourcePath}"
        return false
    if sourceIndex >= snapshots.len:
        err = Fmt" compiler csg: immutable source snapshot index corrupt source={sourcePath} index={sourceIndex} count={snapshots.len}"
        return false
    if snapshots[sourceIndex].sourcePath != sourcePath:
        err = Fmt" compiler csg: immutable source snapshot index conflict source={sourcePath} indexed_source={snapshots[sourceIndex].sourcePath}"
        return false
    out = snapshots[sourceIndex].text
    err = ""
    return true

fn CompilerCsgBuildTypedSourceTextIndex(snapshots: var CompilerCsgSourceText[],
                                         snapshotIndex: var CompilerCsgSourcePathIndex,
                                         sourceTexts: var TypedExprSourceText[],
                                         sourceTextIndex: var CompilerCsgSourcePathIndex,
                                         err: var str): bool =
    sourceTextIndex = CompilerCsgSourcePathIndexInitLike(snapshotIndex,
                                                        sourceTexts.len * 2 + 8)
    if sourceTexts.len != snapshots.len:
        err = Fmt" compiler csg: immutable snapshot/typed source count conflict snapshots={snapshots.len} typed_sources={sourceTexts.len}"
        return false
    for candidateIndex in 0..<sourceTexts.len:
        var sourcePath: str
        if !CompilerCsgSourcePathIndexCanonicalKey(sourceTextIndex,
                                                    sourceTexts[candidateIndex].sourcePath,
                                                    sourcePath,
                                                    err):
            err = Fmt" compiler csg: mutable typed source identity invalid index={candidateIndex}: {err}"
            return false
        sourceTexts[candidateIndex].sourcePath = share(sourcePath)
        var existingIndex: int32
        if !CompilerCsgSourcePathIndexEquivalentForInsert(sourceTextIndex,
                                                          sourcePath,
                                                          existingIndex,
                                                          err):
            return false
        if existingIndex >= 0:
            err = Fmt" compiler csg: mutable typed source path conflict source={sourcePath} index={candidateIndex}"
            return false
        var snapshotText: str
        if !CompilerCsgImmutableSourceSnapshotText(snapshots,
                                                    snapshotIndex,
                                                    sourcePath,
                                                    snapshotText,
                                                    err):
            return false
        if sourceTexts[candidateIndex].text != snapshotText:
            err = Fmt" compiler csg: immutable snapshot/typed source body conflict source={sourcePath} index={candidateIndex}"
            return false
        if !sourceTexts[candidateIndex].snapshotOnly:
            err = Fmt" compiler csg: mutable typed source is not snapshot-only source={sourcePath} index={candidateIndex}"
            return false
        if !CompilerCsgSourcePathIndexRegister(sourceTextIndex,
                                               sourcePath,
                                               candidateIndex,
                                               err):
            return false
    err = ""
    return true

@borrows
fn CompilerCsgRestoreTypedSourceTextBody(snapshots: var CompilerCsgSourceText[],
                                          snapshotIndex: var CompilerCsgSourcePathIndex,
                                          sourceTexts: var TypedExprSourceText[],
                                          sourceTextIndex: var CompilerCsgSourcePathIndex,
                                          sourcePathRaw: str,
                                          err: var str): bool =
    var snapshotText: str
    if !CompilerCsgImmutableSourceSnapshotText(snapshots,
                                                snapshotIndex,
                                                sourcePathRaw,
                                                snapshotText,
                                                err):
        return false
    var sourceIndex: int32
    if !CompilerCsgSourcePathIndexFind(sourceTextIndex,
                                       sourcePathRaw,
                                       sourceIndex,
                                       err):
        return false
    if sourceIndex < 0 || sourceIndex >= sourceTexts.len:
        err = Fmt" compiler csg: mutable typed source row missing source={sourcePathRaw}"
        return false
    if sourceTexts[sourceIndex].text != "" && sourceTexts[sourceIndex].text != snapshotText:
        err = Fmt" compiler csg: mutable typed source body conflict source={sourcePathRaw}"
        return false
    sourceTexts[sourceIndex].text = snapshotText
    sourceTexts[sourceIndex].textLoaded = true
    err = ""
    return true

fn CompilerCsgReleaseFrontierTypedSourceTexts(sourceTexts: var TypedExprSourceText[],
                                               sourceTextIndex: var CompilerCsgSourcePathIndex) =
    for sourceIndex in 0..<sourceTexts.len:
        texpr.TypedExprClearSourceTextAllFields(sourceTexts[sourceIndex])
    sourceTexts = []
    CompilerCsgSourcePathIndexClear(sourceTextIndex)

fn CompilerCsgBuildFrontierTypedSourceTexts(snapshots: var CompilerCsgSourceText[],
                                             snapshotIndex: var CompilerCsgSourcePathIndex,
                                             sourceTexts: var TypedExprSourceText[],
                                             sourceTextIndex: var CompilerCsgSourcePathIndex,
                                             frontierSourcePaths: var str[],
                                             frontierSourceTexts: var TypedExprSourceText[],
                                             frontierSourceTextIndex: var CompilerCsgSourcePathIndex,
                                             err: var str): bool =
    CompilerCsgReleaseFrontierTypedSourceTexts(frontierSourceTexts,
                                               frontierSourceTextIndex)
    frontierSourceTextIndex = CompilerCsgSourcePathIndexInitLike(sourceTextIndex,
                                                                frontierSourcePaths.len * 2 + 8)
    for frontierIndex in 0..<frontierSourcePaths.len:
        var sourcePath: str
        if !CompilerCsgSourcePathIndexCanonicalKey(frontierSourceTextIndex,
                                                    frontierSourcePaths[frontierIndex],
                                                    sourcePath,
                                                    err):
            err = Fmt" compiler csg: typed ir frontier source identity invalid index={frontierIndex}: {err}"
            return false
        var existingFrontierIndex: int32
        if !CompilerCsgSourcePathIndexEquivalentForInsert(frontierSourceTextIndex,
                                                          sourcePath,
                                                          existingFrontierIndex,
                                                          err):
            return false
        if existingFrontierIndex >= 0:
            err = Fmt" compiler csg: typed ir frontier source conflict source={sourcePath} index={frontierIndex}"
            return false
        var sourceIndex: int32
        if !CompilerCsgSourcePathIndexFind(sourceTextIndex,
                                           sourcePath,
                                           sourceIndex,
                                           err):
            return false
        if sourceIndex < 0 || sourceIndex >= sourceTexts.len:
            err = Fmt" compiler csg: typed ir frontier typed source missing source={sourcePath} index={frontierIndex}"
            return false
        if sourceTexts[sourceIndex].text != "":
            err = Fmt" compiler csg: non-frontier typed source body retained source={sourcePath} index={sourceIndex}"
            return false
        var snapshotText: str
        if !CompilerCsgImmutableSourceSnapshotText(snapshots,
                                                    snapshotIndex,
                                                    sourcePath,
                                                    snapshotText,
                                                    err):
            return false
        var frontierSource: TypedExprSourceText
        frontierSource.workspaceRoot = share(sourceTexts[sourceIndex].workspaceRoot)
        frontierSource.packageRoot = share(sourceTexts[sourceIndex].packageRoot)
        frontierSource.packageId = share(sourceTexts[sourceIndex].packageId)
        frontierSource.packageChannel = share(sourceTexts[sourceIndex].packageChannel)
        frontierSource.externalPackageRoots = share(sourceTexts[sourceIndex].externalPackageRoots)
        frontierSource.sourcePath = share(sourceTexts[sourceIndex].sourcePath)
        frontierSource.migrationSourceSyntax = sourceTexts[sourceIndex].migrationSourceSyntax
        frontierSource.text = snapshotText
        frontierSource.textLoaded = true
        frontierSource.snapshotOnly = true
        add(frontierSourceTexts, frontierSource)
        if !CompilerCsgSourcePathIndexRegister(frontierSourceTextIndex,
                                               sourcePath,
                                               frontierSourceTexts.len - 1,
                                               err):
            return false
    err = ""
    return true

fn CompilerCsgValidateFrontierExprLayerSources(frontierSourceTexts: var TypedExprSourceText[],
                                                frontierSourceTextIndex: var CompilerCsgSourcePathIndex,
                                                exprLayer: var parser.NormalizedExprLayer,
                                                err: var str): bool =
    for exprIndex in 0..<exprLayer.exprs.len:
        let sourcePath = parser.ParserNormalizePath(exprLayer.exprs[exprIndex].sourcePath)
        var sourceIndex: int32
        if !CompilerCsgSourcePathIndexFind(frontierSourceTextIndex,
                                           sourcePath,
                                           sourceIndex,
                                           err):
            return false
        if sourceIndex < 0 || sourceIndex >= frontierSourceTexts.len:
            err = Fmt" compiler csg: typed ir expr source outside frontier source={sourcePath} expr_index={exprIndex}"
            return false
        if !frontierSourceTexts[sourceIndex].textLoaded:
            err = Fmt" compiler csg: typed ir frontier source snapshot missing source={sourcePath} expr_index={exprIndex}"
            return false
    err = ""
    return true

fn CompilerCsgClearMutableSourceTextBodies(sourceTexts: var TypedExprSourceText[]) =
    for sourceTextIndex in 0..<sourceTexts.len:
        texpr.TypedExprClearSourceTextBody(sourceTexts[sourceTextIndex])

fn CompilerCsgReleaseImmutableSourceSnapshots(snapshots: var CompilerCsgSourceText[],
                                               snapshotIndex: var CompilerCsgSourcePathIndex) =
    CompilerCsgSourcePathIndexClear(snapshotIndex)
    for sourceIndex in 0..<snapshots.len:
        var snapshot = snapshots[sourceIndex]
        snapshot.sourcePath = ""
        snapshot.modulePath = ""
        snapshot.text = ""
        snapshots[sourceIndex] = snapshot
    snapshots = []

# Seq-header rebind (`entries = []`) in the kernel driver abandons the
# payload without ORC. Take each owned text onto a local so scope-end drop
# is the consume-window; otherwise an 8-line compile keeps the whole
# package source (measured 536.9MB src/*.cheng) through lowering.
fn CompilerCsgReleaseSourceTextLookupEntries(
        entries: var CompilerCsgSourceTextLookupEntry[]) =
    for entryIndex in 0..<entries.len:
        var entry = entries[entryIndex]
        var sourcePath = entry.sourcePath
        entry.sourcePath = ""
        var normalizedSourcePath = entry.normalizedSourcePath
        entry.normalizedSourcePath = ""
        var modulePath = entry.modulePath
        entry.modulePath = ""
        var text = entry.text
        entry.text = ""
        entries[entryIndex] = entry
    seqs.chengSeqFreeTyped(entries)

# wave-17 (current-source 定点修复): explicit teardown for the per-file
# call-profile working set. `work.exprCallProfiles = []` /
# `work.typedMetadataContexts = []` only rebind the seq headers — in
# pure-backend builds (no scope-exit ORC in the driver binary itself) that
# abandons every profile's lines/decls/callNames storage (the ~128MB line
# tables dominating the self-bake RSS). Ownership evidence: every element
# here is an owned deep copy (OwnText/OwnStrSeq, flags=1), and the profiles
# are dead after final_source_clear (all later phases read only
# typedIr/semanticGraph/pruned source texts), so releasing here is exact,
# never dangling. Idiom: hoist each field to a named local, clear the field,
# then let the local's natural scope-end drop release payloads and buffer.
fn CompilerCsgReleaseExprCallProfileFields(profile: var parser.NormalizedExprCallProfile) =
    # Release form: take each field into a local, reset the field, and let the
    # locals drop at scope end (zztmp_varparam_field_release_v3 green form).
    # Explicit frees on the taken locals are out: a var call (freeSeqStrRelease
    # / chengSeqFreeTyped) creates a MEMORY_VERSION definition whose scope-end
    # drop authority is unprovable under the exact drop-source proof, and the
    # raw typed free is the zztmp_varparam_field_release_v4 SIGSEGV family
    # (buffer freed under live managed payloads).
    var profileLines = profile.lines
    profile.lines = []
    var profileImportcCallNames = profile.importcCallNames
    profile.importcCallNames = []
    var profileLocalCallNames = profile.localCallNames
    profile.localCallNames = []
    var profileDecls = profile.decls
    profile.decls = []
    var profileTypeDecls = profile.typeDecls
    profile.typeDecls = []
    var profileImportEdges = profile.importEdges
    profile.importEdges = []
    profile.text = ""
    profile.sourcePath = ""
    profile.ownerModulePath = ""

fn CompilerCsgReleaseExprCallProfiles(profiles: var parser.NormalizedExprCallProfile[]) =
    for pi in 0..<profiles.len:
        CompilerCsgReleaseExprCallProfileFields(profiles[pi])
    seqs.chengSeqFreeTyped(profiles)

fn CompilerCsgReleaseMetadataContexts(contexts: var texpr.TypedExprSourceContext[]) =
    for ci in 0..<contexts.len:
        seqs.freeSeqStrRelease(contexts[ci].lines)
        seqs.chengSeqFreeTyped(contexts[ci].importedModules)
        contexts[ci].sourcePath = ""
        contexts[ci].normalizedSourcePath = ""
    seqs.chengSeqFreeTyped(contexts)

fn CompilerCsgReachableNameIndexInit(minCapacity: int32): CompilerCsgNameAdjacencyIndex =
    var capacity: int32 = 8
    while capacity < minCapacity:
        capacity = capacity * 2
    var out: CompilerCsgNameAdjacencyIndex
    for slotIndex in 0..<capacity:
        add(out.slots, 0)
        add(out.slotCertificates,
            CompilerCsgCertificateMix(Int64(slotIndex), Int64(0)))
    return out

fn CompilerCsgReachableNameSlotCertificate(slotIndex: int32,
                                           value: int32): int64 =
    return CompilerCsgCertificateMix(Int64(slotIndex), Int64(value))

@borrows
fn CompilerCsgReachableNameKeyCertificate(profileIndex: int32,
                                          functionName: str,
                                          head: int32,
                                          tail: int32,
                                          count: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(profileIndex),
                                        CompilerCsgTextContentCertificate(functionName))
    out = CompilerCsgCertificateMix(out, Int64(head))
    out = CompilerCsgCertificateMix(out, Int64(tail))
    return CompilerCsgCertificateMix(out, Int64(count))

fn CompilerCsgReachableNameNodeCertificate(functionIndex: int32,
                                           declared: bool,
                                           nextIndex: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(functionIndex),
                                        declared ? Int64(1) : Int64(0))
    return CompilerCsgCertificateMix(out, Int64(nextIndex))

@borrows
fn CompilerCsgReachableProfileRowCertificate(ruleSet: CompilerCsgReachableFunctionSet,
                                             profileIndex: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(profileIndex),
                                        Int64(ruleSet.profileFunctionStarts[profileIndex]))
    out = CompilerCsgCertificateMix(out,
                                    Int64(ruleSet.profileFunctionCounts[profileIndex]))
    return CompilerCsgCertificateMix(out,
                                     ruleSet.profileLineIndexProven[profileIndex] ?
                                         Int64(1) : Int64(0))

@borrows
fn CompilerCsgFixed32ContentCertificate(
        value: layout.FixedBytes32): int64 =
    var out = Int64(1469598103934665603)
    for byteIndex in 0..<layout.FixedBytes32Size:
        out = CompilerCsgCertificateMix(
            out, Int64(value.data[byteIndex]))
    return out

@borrows
fn CompilerCsgKeepExportBindingCid(
        functionId: int32,
        producerSourceIndex: int32,
        producerDeclarationIndex: int32,
        annotationFlags: int32,
        declarationHeaderCid: layout.FixedBytes32,
        declarationPathCid: layout.FixedBytes32,
        nameProofCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    CompilerCsgAppendText(
        buf, "cheng.compiler.csg.keep_export_binding")
    CompilerCsgAppendU32BE(buf, functionId)
    CompilerCsgAppendU32BE(buf, producerSourceIndex)
    CompilerCsgAppendU32BE(buf, producerDeclarationIndex)
    CompilerCsgAppendU32BE(buf, annotationFlags)
    CompilerCsgAppendFixed32(buf, declarationHeaderCid)
    CompilerCsgAppendFixed32(buf, declarationPathCid)
    CompilerCsgAppendFixed32(buf, nameProofCid)
    return CompilerCsgBufCid(buf)

@borrows
fn CompilerCsgReachableFunctionRowCertificate(ruleSet: CompilerCsgReachableFunctionSet,
                                              functionIndex: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(functionIndex),
        CompilerCsgTextContentCertificate(ruleSet.sourcePaths[functionIndex]))
    out = CompilerCsgCertificateMix(out,
        CompilerCsgTextContentCertificate(ruleSet.functionNames[functionIndex]))
    out = CompilerCsgCertificateMix(out,
        CompilerCsgTextContentCertificate(ruleSet.symbolTexts[functionIndex]))
    out = CompilerCsgCertificateMix(out,
        CompilerCsgTextContentCertificate(ruleSet.exportSymbolNames[functionIndex]))
    out = CompilerCsgCertificateMix(out,
                                    ruleSet.exportNameExplicitFlags[functionIndex] ?
                                        Int64(1) : Int64(0))
    out = CompilerCsgCertificateMix(
        out, Int64(ruleSet.producerSourceIndexes[functionIndex]))
    out = CompilerCsgCertificateMix(
        out, Int64(ruleSet.producerDeclarationIndexes[functionIndex]))
    out = CompilerCsgCertificateMix(
        out, Int64(ruleSet.functionNameSurfaceKinds[functionIndex]))
    out = CompilerCsgCertificateMix(
        out,
        CompilerCsgFixed32ContentCertificate(
            ruleSet.functionNameProofCids[functionIndex]))
    out = CompilerCsgCertificateMix(
        out, Int64(ruleSet.functionAnnotationFlags[functionIndex]))
    out = CompilerCsgCertificateMix(
        out,
        CompilerCsgFixed32ContentCertificate(
            ruleSet.functionDeclarationHeaderCids[functionIndex]))
    out = CompilerCsgCertificateMix(
        out,
        CompilerCsgFixed32ContentCertificate(
            ruleSet.functionDeclarationPathCids[functionIndex]))
    out = CompilerCsgCertificateMix(
        out,
        CompilerCsgFixed32ContentCertificate(
            ruleSet.keepExportBindingCids[functionIndex]))
    out = CompilerCsgCertificateMix(out, Int64(ruleSet.startLines[functionIndex]))
    out = CompilerCsgCertificateMix(out, Int64(ruleSet.endLines[functionIndex]))
    return CompilerCsgCertificateMix(out,
                                     Int64(ruleSet.functionProfileIndexes[functionIndex]))

fn CompilerCsgReachableRowCertificate(functionIndex: int32,
                                      reachable: bool): int64 =
    return CompilerCsgCertificateMix(Int64(functionIndex),
                                     reachable ? Int64(1) : Int64(0))

fn CompilerCsgReachableQueueCertificate(queueIndex: int32,
                                        functionIndex: int32): int64 =
    return CompilerCsgCertificateMix(Int64(queueIndex), Int64(functionIndex))

fn CompilerCsgReachableEdgeHeadCertificate(functionIndex: int32,
                                           edgeHead: int32): int64 =
    return CompilerCsgCertificateMix(Int64(functionIndex), Int64(edgeHead))

fn CompilerCsgReachableEdgeRowCertificate(edgeIndex: int32,
                                          fromIndex: int32,
                                          toIndex: int32,
                                          nextIndex: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(edgeIndex), Int64(fromIndex))
    out = CompilerCsgCertificateMix(out, Int64(toIndex))
    return CompilerCsgCertificateMix(out, Int64(nextIndex))

fn CompilerCsgReachableEdgePairSlotCertificate(slotIndex: int32,
                                               edgeIndexPlus1: int32): int64 =
    return CompilerCsgCertificateMix(Int64(slotIndex), Int64(edgeIndexPlus1))

fn CompilerCsgReachableCertificateAggregateRow(kind: int32,
                                                rowIndex: int32,
                                                certificate: int64): int64 =
    return CompilerCsgCertificateMix(Int64(kind),
        CompilerCsgCertificateMix(Int64(rowIndex), certificate))

fn CompilerCsgReachableCertificateAggregateReplace(aggregate: var int64,
                                                    kind: int32,
                                                    rowIndex: int32,
                                                    oldCertificate: int64,
                                                    newCertificate: int64) =
    aggregate = aggregate ^
        CompilerCsgReachableCertificateAggregateRow(kind,
                                                    rowIndex,
                                                    oldCertificate) ^
        CompilerCsgReachableCertificateAggregateRow(kind,
                                                    rowIndex,
                                                    newCertificate)

@borrows
fn CompilerCsgReachableStructureContentCertificate(ruleSet: CompilerCsgReachableFunctionSet): int64 =
    var out: int64
    for rowIndex in 0..<ruleSet.profileRowCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(1,
                                                                 rowIndex,
                                                                 ruleSet.profileRowCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.functionRowCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(2,
                                                                 rowIndex,
                                                                 ruleSet.functionRowCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.scopedFunctionNames.slotCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(3,
            rowIndex,
            ruleSet.scopedFunctionNames.slotCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.scopedFunctionNames.keyCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(4,
            rowIndex,
            ruleSet.scopedFunctionNames.keyCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.scopedFunctionNames.functionNodeCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(5,
            rowIndex,
            ruleSet.scopedFunctionNames.functionNodeCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.globalFunctionNames.slotCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(6,
            rowIndex,
            ruleSet.globalFunctionNames.slotCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.globalFunctionNames.keyCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(7,
            rowIndex,
            ruleSet.globalFunctionNames.keyCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.globalFunctionNames.functionNodeCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(8,
            rowIndex,
            ruleSet.globalFunctionNames.functionNodeCertificates[rowIndex])
    return out

@borrows
fn CompilerCsgReachableGraphContentCertificate(ruleSet: CompilerCsgReachableFunctionSet): int64 =
    var out: int64
    for rowIndex in 0..<ruleSet.reachableRowCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(1,
                                                                 rowIndex,
                                                                 ruleSet.reachableRowCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.reachableQueueCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(2,
                                                                 rowIndex,
                                                                 ruleSet.reachableQueueCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.edgeHeadCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(3,
                                                                 rowIndex,
                                                                 ruleSet.edgeHeadCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.edgeRowCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(4,
                                                                 rowIndex,
                                                                 ruleSet.edgeRowCertificates[rowIndex])
    for rowIndex in 0..<ruleSet.edgePairSlotCertificates.len:
        out = out ^ CompilerCsgReachableCertificateAggregateRow(5,
                                                                 rowIndex,
                                                                 ruleSet.edgePairSlotCertificates[rowIndex])
    return out

@borrows
fn CompilerCsgReachableNameHash(profileIndex: int32,
                                functionName: str): int32 =
    let nameHash = Int64(CompilerCsgTextHash(functionName))
    let profileHash = Int64(profileIndex) + Int64(2)
    return Int32((nameHash * Int64(2654435761) +
                  profileHash * Int64(1315423911)) & Int64(2147483647))

fn CompilerCsgReachableNameIndexRecordMaxProbe(index: var CompilerCsgNameAdjacencyIndex,
                                               probeCount: int32) =
    if probeCount > index.hashMaxProbeCount:
        index.hashMaxProbeCount = probeCount

@borrows
fn CompilerCsgReachableNameIndexSlot(index: var CompilerCsgNameAdjacencyIndex,
                                     profileIndex: int32,
                                     functionName: str,
                                     found: var bool): int32 =
    if index.slots.len <= 0:
        found = false
        return -1
    if index.slotCertificates.len != index.slots.len:
        panic("compiler csg: reachable function-name slot certificate columns corrupt")
    let mask = index.slots.len - 1
    var slot = CompilerCsgReachableNameHash(profileIndex, functionName) & mask
    var localProbeCount: int32
    index.hashOperationCount = index.hashOperationCount + Int64(1)
    while localProbeCount <= mask:
        localProbeCount = localProbeCount + 1
        index.hashProbeCount = index.hashProbeCount + Int64(1)
        let entryIndexPlus1 = index.slots[slot]
        if index.slotCertificates[slot] !=
           CompilerCsgReachableNameSlotCertificate(slot, entryIndexPlus1):
            panic("compiler csg: reachable function-name slot content certificate mismatch")
        if entryIndexPlus1 == 0:
            found = false
            CompilerCsgReachableNameIndexRecordMaxProbe(index, localProbeCount)
            return slot
        let entryIndex = entryIndexPlus1 - 1
        if entryIndex < 0 ||
           entryIndex >= index.profileIndexes.len ||
           entryIndex >= index.functionNames.len ||
           entryIndex >= index.heads.len || entryIndex >= index.tails.len ||
           entryIndex >= index.counts.len ||
           entryIndex >= index.keyCertificates.len:
            panic("compiler csg: reachable function-name hash slot corrupt")
        if index.keyCertificates[entryIndex] !=
           CompilerCsgReachableNameKeyCertificate(index.profileIndexes[entryIndex],
                                                  index.functionNames[entryIndex],
                                                  index.heads[entryIndex],
                                                  index.tails[entryIndex],
                                                  index.counts[entryIndex]):
            panic("compiler csg: reachable function-name key content certificate mismatch")
        if index.profileIndexes[entryIndex] == profileIndex &&
           index.functionNames[entryIndex] == functionName:
            found = true
            CompilerCsgReachableNameIndexRecordMaxProbe(index, localProbeCount)
            return slot
        slot = (slot + 1) & mask
    found = false
    CompilerCsgReachableNameIndexRecordMaxProbe(index, localProbeCount)
    return -1

fn CompilerCsgReachableNameIndexRehash(index: var CompilerCsgNameAdjacencyIndex,
                                       newCapacity: int32) =
    var capacity: int32 = 8
    while capacity < newCapacity:
        capacity = capacity * 2
    var slots: int32[]
    var slotCertificates: int64[]
    for slotIndex in 0..<capacity:
        add(slots, 0)
        add(slotCertificates,
            CompilerCsgReachableNameSlotCertificate(slotIndex, 0))
    index.slots = slots
    index.slotCertificates = slotCertificates
    for entryIndex in 0..<index.profileIndexes.len:
        var found = false
        let slot = CompilerCsgReachableNameIndexSlot(index,
                                                     index.profileIndexes[entryIndex],
                                                     index.functionNames[entryIndex],
                                                     found)
        if slot < 0 || found:
            panic("compiler csg: reachable function-name rehash failed")
        index.slots[slot] = entryIndex + 1
        index.slotCertificates[slot] =
            CompilerCsgReachableNameSlotCertificate(slot, entryIndex + 1)

@borrows
fn CompilerCsgReachableNameIndexAppend(index: var CompilerCsgNameAdjacencyIndex,
                                       nextIndexes: var int32[],
                                       profileIndex: int32,
                                       functionName: str,
                                       functionIndex: int32) =
    if functionIndex < 0 || functionName == "":
        panic("compiler csg: reachable function-name declaration invalid")
    if index.slots.len <= 0:
        index = CompilerCsgReachableNameIndexInit(8)
    while nextIndexes.len <= functionIndex:
        add(nextIndexes, -1)
    while index.functionDeclared.len <= functionIndex:
        add(index.functionDeclared, false)
        add(index.functionNodeCertificates,
            CompilerCsgReachableNameNodeCertificate(index.functionNodeCertificates.len,
                                                     false,
                                                     -1))
    if index.functionDeclared[functionIndex]:
        panic("compiler csg: reachable function-name declared more than once")
    index.functionDeclared[functionIndex] = true
    index.functionNodeCertificates[functionIndex] =
        CompilerCsgReachableNameNodeCertificate(functionIndex, true, -1)
    if (index.profileIndexes.len + 1) * 10 >= index.slots.len * 7:
        CompilerCsgReachableNameIndexRehash(index, index.slots.len * 2)
    var found = false
    let slot = CompilerCsgReachableNameIndexSlot(index,
                                                 profileIndex,
                                                 share(functionName),
                                                 found)
    if slot < 0:
        panic("compiler csg: reachable function-name hash index full")
    if !found:
        let nextKeyIndex = index.profileIndexes.len
        add(index.profileIndexes, profileIndex)
        add(index.functionNames, share(functionName))
        add(index.heads, functionIndex)
        add(index.tails, functionIndex)
        add(index.counts, 1)
        add(index.keyCertificates,
            CompilerCsgReachableNameKeyCertificate(profileIndex,
                                                   functionName,
                                                   functionIndex,
                                                   functionIndex,
                                                   1))
        index.slots[slot] = nextKeyIndex + 1
        index.slotCertificates[slot] =
            CompilerCsgReachableNameSlotCertificate(slot, nextKeyIndex + 1)
        return
    let keyIndex = index.slots[slot] - 1
    assert(keyIndex < index.tails.len && keyIndex < index.counts.len,
           "compiler csg: reachable function-name index columns corrupt")
    let tail = index.tails[keyIndex]
    assert(tail >= 0 && tail < nextIndexes.len,
           "compiler csg: reachable function-name tail corrupt")
    nextIndexes[tail] = functionIndex
    index.functionNodeCertificates[tail] =
        CompilerCsgReachableNameNodeCertificate(tail, true, functionIndex)
    index.tails[keyIndex] = functionIndex
    let count = index.counts[keyIndex]
    assert(count > 0,
           "compiler csg: reachable function-name count corrupt")
    index.counts[keyIndex] = count + 1
    index.keyCertificates[keyIndex] =
        CompilerCsgReachableNameKeyCertificate(index.profileIndexes[keyIndex],
                                               index.functionNames[keyIndex],
                                               index.heads[keyIndex],
                                               functionIndex,
                                               count + 1)

fn CompilerCsgReachableNameIndexLookup(index: var CompilerCsgNameAdjacencyIndex,
                                       profileIndex: int32,
                                       functionName: str,
                                       matchCount: var int32): int32 =
    var found = false
    let slot = CompilerCsgReachableNameIndexSlot(index,
                                                 profileIndex,
                                                 functionName,
                                                 found)
    if slot < 0 || !found:
        matchCount = 0
        return -1
    let keyIndex = index.slots[slot] - 1
    if keyIndex >= index.heads.len || keyIndex >= index.counts.len:
        panic("compiler csg: reachable function-name lookup columns corrupt")
    matchCount = index.counts[keyIndex]
    return index.heads[keyIndex]

@borrows
fn CompilerCsgReachableProfileIndex(ruleSet: var CompilerCsgReachableFunctionSet,
                                    sourcePathRaw: str): int32 =
    var profileIndex: int32
    var pathErr: str
    if !CompilerCsgSourcePathIndexFind(ruleSet.profileSourceIndex,
                                       sourcePathRaw,
                                       profileIndex,
                                       pathErr):
        panic(Fmt"compiler csg: reachable profile source identity invalid source={sourcePathRaw}: {pathErr}")
    return profileIndex

fn CompilerCsgReachableNameIndexHead(ruleSet: var CompilerCsgReachableFunctionSet,
                                     sourcePath: str,
                                     functionName: str,
                                     matchCount: var int32): int32 =
    if sourcePath == "":
        return CompilerCsgReachableNameIndexLookup(ruleSet.globalFunctionNames,
                                                   -1,
                                                   functionName,
                                                   matchCount)
    let profileIndex = CompilerCsgReachableProfileIndex(ruleSet, sourcePath)
    if profileIndex < 0:
        matchCount = 0
        return profileIndex
    return CompilerCsgReachableNameIndexLookup(ruleSet.scopedFunctionNames,
                                               profileIndex,
                                               functionName,
                                               matchCount)

@borrows
fn CompilerCsgReachableFunctionLineMatches(ruleSet: var CompilerCsgReachableFunctionSet,
                                           functionIndex: int32,
                                           sourcePath: str,
                                           lineNumber: int32): bool =
    if functionIndex < 0:
        return false
    if functionIndex >= ruleSet.functionNames.len ||
       functionIndex >= ruleSet.sourcePaths.len ||
       functionIndex >= ruleSet.startLines.len ||
       functionIndex >= ruleSet.endLines.len:
        panic(Fmt"compiler csg: reachable function line columns corrupt function_index={functionIndex} functions={ruleSet.functionNames.len} sources={ruleSet.sourcePaths.len} starts={ruleSet.startLines.len} ends={ruleSet.endLines.len}")
    if !CompilerCsgSourcePathsEquivalentNormalized(ruleSet.sourcePaths[functionIndex], sourcePath):
        return false
    if lineNumber < ruleSet.startLines[functionIndex]:
        return false
    if ruleSet.endLines[functionIndex] > 0 && lineNumber > ruleSet.endLines[functionIndex]:
        return false
    return true

@borrows
fn CompilerCsgReachableFunctionLineMatchesDelta(ruleSet: var CompilerCsgReachableFunctionSet,
                                                functionIndex: int32,
                                                sourcePath: str,
                                                lineNumber: int32,
                                                probes: var CompilerCsgReachabilityProbeDelta): bool =
    if functionIndex < 0 || functionIndex >= ruleSet.functionNames.len ||
       functionIndex >= ruleSet.functionRowCertificates.len:
        probes.contentCertificateViolation = true
        return false
    probes.certificateValidationOperationCount =
        probes.certificateValidationOperationCount + Int64(1)
    if ruleSet.functionRowCertificates[functionIndex] !=
       CompilerCsgReachableFunctionRowCertificate(ruleSet, functionIndex):
        probes.contentCertificateViolation = true
        return false
    return CompilerCsgSourcePathsEquivalentNormalized(ruleSet.sourcePaths[functionIndex],
                                                       sourcePath) &&
           lineNumber >= ruleSet.startLines[functionIndex] &&
           (ruleSet.endLines[functionIndex] <= 0 ||
            lineNumber <= ruleSet.endLines[functionIndex])

@borrows
fn CompilerCsgReachableFunctionRowValidateDelta(ruleSet: var CompilerCsgReachableFunctionSet,
                                                functionIndex: int32,
                                                probes: var CompilerCsgReachabilityProbeDelta): bool =
    if functionIndex < 0 || functionIndex >= ruleSet.functionNames.len ||
       functionIndex >= ruleSet.functionRowCertificates.len:
        probes.contentCertificateViolation = true
        return false
    probes.certificateValidationOperationCount =
        probes.certificateValidationOperationCount + Int64(1)
    if ruleSet.functionRowCertificates[functionIndex] !=
       CompilerCsgReachableFunctionRowCertificate(ruleSet, functionIndex):
        probes.contentCertificateViolation = true
        return false
    return true

@borrows
fn CompilerCsgReachableRootMatches(ruleSet: var CompilerCsgReachableFunctionSet,
                                    functionIndex: int32,
                                    rootRaw: str): bool =
    let root = chengpath.PathTrim(rootRaw)
    if root == "":
        return false
    if functionIndex < 0:
        return false
    if functionIndex >= ruleSet.functionNames.len:
        return false
    if functionIndex < ruleSet.exportSymbolNames.len:
        if CompilerCsgExportRootNameMatches(root, ruleSet.exportSymbolNames[functionIndex]):
            return true
    if functionIndex < ruleSet.symbolTexts.len:
        if CompilerCsgExportRootNameMatches(root, ruleSet.symbolTexts[functionIndex]):
            return true
    let functionName = ruleSet.functionNames[functionIndex]
    if CompilerCsgExportRootNameMatches(root, functionName):
        return true
    let functionTail = CompilerCsgFunctionTailName(functionName)
    let rootTail = CompilerCsgFunctionTailName(root)
    if CompilerCsgExportRootNameMatches(root, functionTail):
        return true
    if CompilerCsgExportRootNameMatches(rootTail, functionName):
        return true
    return CompilerCsgExportRootNameMatches(rootTail, functionTail)

@borrows
fn CompilerCsgReachableFindRoot(ruleSet: var CompilerCsgReachableFunctionSet,
                                 root: str,
                                 entryPathRaw: str): int32 =
    let entryPath = parser.ParserNormalizePath(entryPathRaw)
    var found: int32 = -1
    var foundCount: int32
    var foundExplicit: int32 = -1
    var foundExplicitCount: int32
    var foundEntry: int32 = -1
    var foundEntryCount: int32
    for i in 0..<ruleSet.functionNames.len:
        if !CompilerCsgReachableRootMatches(ruleSet, i, root):
            continue
        found = i
        foundCount = foundCount + 1
        if i < ruleSet.exportNameExplicitFlags.len &&
           i < ruleSet.exportSymbolNames.len &&
           ruleSet.exportNameExplicitFlags[i] &&
           CompilerCsgExportRootNameMatches(root, ruleSet.exportSymbolNames[i]):
            foundExplicit = i
            foundExplicitCount = foundExplicitCount + 1
        if entryPath != "" &&
           i < ruleSet.sourcePaths.len &&
           CompilerCsgSourcePathsEquivalent(ruleSet.sourcePaths[i], entryPath):
            foundEntry = i
            foundEntryCount = foundEntryCount + 1
    if foundExplicitCount == 1:
        return foundExplicit
    if foundExplicitCount > 1:
        return -2
    if foundEntryCount == 1:
        return foundEntry
    if foundEntryCount > 1:
        return -2
    if foundCount > 1:
        return -2
    return found

@borrows
fn CompilerCsgReachableFindEntry(ruleSet: var CompilerCsgReachableFunctionSet,
                                  entryPathRaw: str,
                                  entrySymbolRaw: str): int32 =
    let entryPath = parser.ParserNormalizePath(entryPathRaw)
    var entrySymbol = parser.ParserIdentPrefix(chengpath.PathTrim(entrySymbolRaw))
    if entrySymbol == "":
        entrySymbol = "main"
    var found: int32 = -1
    for i in 0..<ruleSet.functionNames.len:
        if i >= ruleSet.sourcePaths.len:
            continue
        if entryPath != "" && !CompilerCsgSourcePathsEquivalent(ruleSet.sourcePaths[i], entryPath):
            continue
        if ruleSet.functionNames[i] != entrySymbol:
            continue
        if found >= 0:
            return -2
        found = i
    if found >= 0:
        return found
    return CompilerCsgReachableFindRoot(ruleSet, entrySymbol, entryPath)

fn CompilerCsgSparseIntHash(key: int32): int32 =
    if key < 0:
        panic("compiler csg: sparse integer key negative")
    return Int32(((Int64(key) + Int64(1)) * Int64(2654435761)) &
                 Int64(2147483647))

@borrows
fn CompilerCsgSparseIntIndexSlot(index: CompilerCsgSparseIntIndex,
                                 key: int32,
                                 found: var bool): int32 =
    if index.slots.len <= 0:
        found = false
        return -1
    let mask = index.slots.len - 1
    var slot = CompilerCsgSparseIntHash(key) & mask
    var scanned: int32
    while scanned <= mask:
        let rowPlus1 = index.slots[slot]
        if rowPlus1 == 0:
            found = false
            return slot
        let row = rowPlus1 - 1
        if row < 0 || row >= index.keys.len:
            panic("compiler csg: sparse integer slot row corrupt")
        if index.keys[row] == key:
            found = true
            return slot
        slot = (slot + 1) & mask
        scanned = scanned + 1
    found = false
    return -1

fn CompilerCsgSparseIntIndexRehash(index: var CompilerCsgSparseIntIndex,
                                   minCapacity: int32) =
    var capacity: int32 = 8
    while capacity < minCapacity:
        capacity = capacity * 2
    var slots: int32[]
    for slotIndex in 0..<capacity:
        add(slots, 0)
    index.slots = slots
    for row in 0..<index.keys.len:
        var found = false
        let slot = CompilerCsgSparseIntIndexSlot(index, index.keys[row], found)
        if slot < 0 || found:
            panic("compiler csg: sparse integer rehash failed")
        index.slots[slot] = row + 1

@borrows
fn CompilerCsgSparseIntIndexFind(index: CompilerCsgSparseIntIndex,
                                 key: int32): int32 =
    if key < 0 || index.slots.len <= 0:
        return -1
    var found = false
    let slot = CompilerCsgSparseIntIndexSlot(index, key, found)
    if slot < 0 || !found:
        return -1
    return index.slots[slot] - 1

fn CompilerCsgSparseIntIndexEnsure(index: var CompilerCsgSparseIntIndex,
                                   key: int32): int32 =
    if key < 0:
        panic("compiler csg: sparse integer insert key negative")
    if index.slots.len <= 0:
        CompilerCsgSparseIntIndexRehash(index, 8)
    if (index.keys.len + 1) * 10 >= index.slots.len * 7:
        CompilerCsgSparseIntIndexRehash(index, index.slots.len * 2)
    var found = false
    let slot = CompilerCsgSparseIntIndexSlot(index, key, found)
    if slot < 0:
        panic("compiler csg: sparse integer index full")
    if found:
        return index.slots[slot] - 1
    let row = index.keys.len
    add(index.keys, key)
    index.slots[slot] = row + 1
    return row

@borrows
fn CompilerCsgSparseIntIndexValidate(index: CompilerCsgSparseIntIndex,
                                     err: var str): bool =
    if index.slots.len == 0:
        if index.keys.len != 0:
            err = " compiler csg: sparse integer keys exist without slots"
            return false
        err = ""
        return true
    if (index.slots.len & (index.slots.len - 1)) != 0:
        err = Fmt" compiler csg: sparse integer slot capacity is not power-of-two capacity={index.slots.len}"
        return false
    var occupied: int32
    for slotIndex in 0..<index.slots.len:
        let rowPlus1 = index.slots[slotIndex]
        if rowPlus1 == 0:
            continue
        let row = rowPlus1 - 1
        if row < 0 || row >= index.keys.len || index.keys[row] < 0:
            err = Fmt" compiler csg: sparse integer slot row invalid slot={slotIndex} row={row} rows={index.keys.len}"
            return false
        occupied = occupied + 1
    if occupied != index.keys.len:
        err = Fmt" compiler csg: sparse integer occupancy mismatch occupied={occupied} keys={index.keys.len}"
        return false
    for row in 0..<index.keys.len:
        let indexedRow = CompilerCsgSparseIntIndexFind(index, index.keys[row])
        if indexedRow != row:
            err = Fmt" compiler csg: sparse integer key ownership mismatch row={row} key={index.keys[row]} indexed_row={indexedRow}"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgSparseIntIndexCapacityBytes(index: CompilerCsgSparseIntIndex): int64 =
    return CompilerCsgSequenceHeaderBytes() * Int64(2) +
           Int64(index.slots.cap + index.keys.cap) * CompilerCsgI32Bytes()

fn CompilerCsgBoolJournalCapacityBytes(journal: CompilerCsgBoolJournal): int64 =
    return CompilerCsgSparseIntIndexCapacityBytes(journal.index) +
           CompilerCsgSequenceHeaderBytes() * Int64(2) +
           Int64(journal.oldValues.cap + journal.newValues.cap) *
               CompilerCsgBoolBytes()

fn CompilerCsgBoolJournalValidate(journal: CompilerCsgBoolJournal,
                                  domainCount: int32,
                                  err: var str): bool =
    if !CompilerCsgSparseIntIndexValidate(journal.index, err):
        return false
    if journal.oldValues.len != journal.index.keys.len ||
       journal.newValues.len != journal.index.keys.len:
        err = Fmt" compiler csg: bool journal columns mismatch keys={journal.index.keys.len} old={journal.oldValues.len} new={journal.newValues.len}"
        return false
    for row in 0..<journal.index.keys.len:
        if journal.index.keys[row] < 0 || journal.index.keys[row] >= domainCount:
            err = Fmt" compiler csg: bool journal index out of range row={row} index={journal.index.keys[row]} domain={domainCount}"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgBoolJournalGet(live: bool[],
                             journal: CompilerCsgBoolJournal,
                             index: int32): bool =
    if index < 0:
        return false
    let row = CompilerCsgSparseIntIndexFind(journal.index, index)
    if row >= 0:
        if row >= journal.newValues.len:
            panic("compiler csg: bool journal read columns corrupt")
        return journal.newValues[row]
    return index < live.len && live[index]

fn CompilerCsgBoolJournalSet(live: bool[],
                             journal: var CompilerCsgBoolJournal,
                             index: int32,
                             value: bool) =
    if index < 0:
        panic("compiler csg: bool journal write index negative")
    let oldCount = journal.index.keys.len
    let row = CompilerCsgSparseIntIndexEnsure(journal.index, index)
    if row == oldCount:
        add(journal.oldValues, index < live.len && live[index])
        add(journal.newValues, value)
    else:
        if row < 0 || row >= journal.newValues.len:
            panic("compiler csg: bool journal write columns corrupt")
        journal.newValues[row] = value

fn CompilerCsgBoolJournalCommit(live: var bool[],
                                journal: var CompilerCsgBoolJournal) =
    var requiredLen = live.len
    for row in 0..<journal.index.keys.len:
        let required = journal.index.keys[row] + 1
        if required > requiredLen:
            requiredLen = required
    CompilerCsgEnsureBoolLen(live, requiredLen)
    for row in 0..<journal.index.keys.len:
        let index = journal.index.keys[row]
        if live[index] != journal.oldValues[row]:
            panic("compiler csg: bool journal live value changed before commit")
        live[index] = journal.newValues[row]

fn CompilerCsgProfileCallLookupEntryBuilt(entry: var parser.ParserProfileCallLookupCacheEntry): bool =
    return entry.localLookup.slots.len > 0 || entry.importcLookup.slots.len > 0

fn CompilerCsgProfileCallLookupStoreCapacityBytes(store: var CompilerCsgProfileCallLookupStore): int64 =
    return CompilerCsgSparseIntIndexCapacityBytes(store.index) +
           CompilerCsgProfileCallLookupArrayCapacityBytes(store.entries)

fn CompilerCsgProfileCallLookupStoreRow(store: var CompilerCsgProfileCallLookupStore,
                                        profileIndex: int32,
                                        row: var int32,
                                        found: var bool,
                                        err: var str): bool =
    row = -1
    found = false
    if profileIndex < 0:
        err = Fmt" compiler csg: profile cache lookup index negative profile={profileIndex}"
        return false
    if store.entries.len != store.index.keys.len:
        err = Fmt" compiler csg: sparse profile cache columns mismatch keys={store.index.keys.len} entries={store.entries.len}"
        return false
    let indexedRow = CompilerCsgSparseIntIndexFind(store.index, profileIndex)
    if indexedRow < 0:
        err = ""
        return true
    if indexedRow >= store.entries.len || indexedRow >= store.index.keys.len ||
       store.index.keys[indexedRow] != profileIndex:
        err = Fmt" compiler csg: sparse profile cache row mismatch profile={profileIndex} row={indexedRow}"
        return false
    if !CompilerCsgProfileCallLookupEntryBuilt(store.entries[indexedRow]):
        err = Fmt" compiler csg: sparse profile cache row unbuilt profile={profileIndex} row={indexedRow}"
        return false
    row = indexedRow
    found = true
    err = ""
    return true

fn CompilerCsgProfileCallLookupOverlayValidate(profiles: var parser.NormalizedExprCallProfile[],
                                                overlay: var CompilerCsgProfileCallLookupOverlay,
                                                err: var str): bool =
    if !CompilerCsgSparseIntIndexValidate(overlay.index, err):
        return false
    if overlay.entries.len != overlay.index.keys.len:
        err = Fmt" compiler csg: profile cache overlay columns mismatch keys={overlay.index.keys.len} entries={overlay.entries.len}"
        return false
    for row in 0..<overlay.index.keys.len:
        let profileIndex = overlay.index.keys[row]
        if profileIndex < 0 || profileIndex >= profiles.len ||
           !CompilerCsgProfileCallLookupEntryBuilt(overlay.entries[row]):
            err = Fmt" compiler csg: profile cache overlay row invalid row={row} profile={profileIndex} profiles={profiles.len}"
            return false
    err = ""
    return true

fn CompilerCsgProfileCallLookupFlagsOverlay(profiles: var parser.NormalizedExprCallProfile[],
                                             live: var CompilerCsgProfileCallLookupStore,
                                             overlay: var CompilerCsgProfileCallLookupOverlay,
                                             profileIndex: int32,
                                             name: str,
                                             hasImportc: var bool,
                                             hasLocal: var bool,
                                             err: var str): bool =
    hasImportc = false
    hasLocal = false
    if name == "":
        err = ""
        return true
    if profileIndex < 0 || profileIndex >= profiles.len:
        err = Fmt" compiler csg: profile cache overlay index out of range profile={profileIndex} profiles={profiles.len}"
        return false
    var liveRow: int32
    var liveFound = false
    if !CompilerCsgProfileCallLookupStoreRow(live,
                                             profileIndex,
                                             liveRow,
                                             liveFound,
                                             err):
        return false
    if liveFound:
        hasImportc = parser.ParserTextLookupContainsExactBorrowed(
            live.entries[liveRow].importcLookup,
            name)
        hasLocal = parser.ParserTextLookupContainsExactBorrowed(
            live.entries[liveRow].localLookup,
            name)
        err = ""
        return true
    var overlayRow = CompilerCsgSparseIntIndexFind(overlay.index, profileIndex)
    if overlayRow < 0:
        let oldCount = overlay.index.keys.len
        overlayRow = CompilerCsgSparseIntIndexEnsure(overlay.index, profileIndex)
        if overlayRow != oldCount:
            err = " compiler csg: profile cache overlay insertion conflict"
            return false
        var built: parser.ParserProfileCallLookupCacheEntry
        built.localLookup = parser.ParserTextLookupBuildExact(profiles[profileIndex].localCallNames)
        built.importcLookup = parser.ParserTextLookupBuildExact(profiles[profileIndex].importcCallNames)
        add(overlay.entries, built)
    if overlayRow < 0 || overlayRow >= overlay.entries.len:
        err = " compiler csg: profile cache overlay entry missing"
        return false
    hasImportc = parser.ParserTextLookupContainsExactBorrowed(
        overlay.entries[overlayRow].importcLookup,
        name)
    hasLocal = parser.ParserTextLookupContainsExactBorrowed(
        overlay.entries[overlayRow].localLookup,
        name)
    err = ""
    return true

fn CompilerCsgProfileCallLookupOverlayCommitValidated(
        live: var CompilerCsgProfileCallLookupStore,
        overlay: var CompilerCsgProfileCallLookupOverlay) =
    var validationErr: str
    for row in 0..<overlay.index.keys.len:
        var liveRow: int32
        var liveFound = false
        if !CompilerCsgProfileCallLookupStoreRow(live,
                                                 overlay.index.keys[row],
                                                 liveRow,
                                                 liveFound,
                                                 validationErr):
            panic(validationErr)
        if liveFound:
            panic("compiler csg: sparse profile cache overlay live entry changed before commit")
    for row in 0..<overlay.index.keys.len:
        let profileIndex = overlay.index.keys[row]
        let liveRow = CompilerCsgSparseIntIndexEnsure(live.index, profileIndex)
        if liveRow != live.entries.len:
            panic("compiler csg: sparse profile cache append order conflict")
        add(live.entries, share(overlay.entries[row]))
        overlay.entries[row] = parser.ParserProfileCallLookupCacheEntry()
    overlay = CompilerCsgProfileCallLookupOverlay()

fn CompilerCsgProfileCallLookupOverlayCommit(live: var CompilerCsgProfileCallLookupStore,
                                              profiles: var parser.NormalizedExprCallProfile[],
                                              overlay: var CompilerCsgProfileCallLookupOverlay) =
    var validationErr: str
    if !CompilerCsgProfileCallLookupOverlayValidate(profiles, overlay, validationErr):
        panic(validationErr)
    CompilerCsgProfileCallLookupOverlayCommitValidated(live, overlay)

fn CompilerCsgReachabilityDeltaInit(): CompilerCsgReachabilityDelta =
    var out: CompilerCsgReachabilityDelta
    return out

fn CompilerCsgReachabilityDeltaEnsureFunctionRow(delta: var CompilerCsgReachabilityDelta,
                                                  functionIndex: int32): int32 =
    let oldCount = delta.functionIndex.keys.len
    let row = CompilerCsgSparseIntIndexEnsure(delta.functionIndex, functionIndex)
    if row == oldCount:
        add(delta.functionEdgeHeads, -1)
        add(delta.functionMarked, false)
        add(delta.functionMarkQueuePositions, -1)
    if row < 0 || row >= delta.functionEdgeHeads.len ||
       row >= delta.functionMarked.len ||
       row >= delta.functionMarkQueuePositions.len:
        panic("compiler csg: sparse reachability function columns corrupt")
    return row

fn CompilerCsgReachabilityDeltaIsReachable(ruleSet: var CompilerCsgReachableFunctionSet,
                                            delta: var CompilerCsgReachabilityDelta,
                                            functionIndex: int32): bool =
    if functionIndex < 0 || functionIndex >= ruleSet.reachable.len:
        return false
    if functionIndex >= ruleSet.reachableRowCertificates.len:
        delta.probes.contentCertificateViolation = true
        return false
    delta.probes.certificateValidationOperationCount =
        delta.probes.certificateValidationOperationCount + Int64(1)
    if ruleSet.reachableRowCertificates[functionIndex] !=
       CompilerCsgReachableRowCertificate(functionIndex,
                                          ruleSet.reachable[functionIndex]):
        delta.probes.contentCertificateViolation = true
        return false
    if ruleSet.reachable[functionIndex]:
        return true
    let row = CompilerCsgSparseIntIndexFind(delta.functionIndex, functionIndex)
    return row >= 0 && row < delta.functionMarked.len && delta.functionMarked[row]

fn CompilerCsgReachabilityDeltaMark(ruleSet: var CompilerCsgReachableFunctionSet,
                                     delta: var CompilerCsgReachabilityDelta,
                                     functionIndex: int32) =
    if functionIndex < 0 || functionIndex >= ruleSet.reachable.len:
        panic(Fmt"compiler csg: reachability delta mark out of range index={functionIndex} count={ruleSet.reachable.len}")
    if CompilerCsgReachabilityDeltaIsReachable(ruleSet, delta, functionIndex):
        return
    let row = CompilerCsgReachabilityDeltaEnsureFunctionRow(delta, functionIndex)
    delta.functionMarked[row] = true
    delta.functionMarkQueuePositions[row] = delta.markQueue.len
    add(delta.markQueue, functionIndex)

fn CompilerCsgReachabilityDeltaAddEdge(ruleSet: var CompilerCsgReachableFunctionSet,
                                        delta: var CompilerCsgReachabilityDelta,
                                        fromIndex: int32,
                                        toIndex: int32) =
    if fromIndex < 0 || toIndex < 0 ||
       fromIndex >= ruleSet.functionNames.len || toIndex >= ruleSet.functionNames.len:
        panic(Fmt"compiler csg: reachability delta edge endpoint out of range from={fromIndex} to={toIndex} functions={ruleSet.functionNames.len}")
    let fromRow = CompilerCsgReachabilityDeltaEnsureFunctionRow(delta, fromIndex)
    let edgeIndex = delta.edgeFrom.len
    add(delta.edgeFrom, fromIndex)
    add(delta.edgeTo, toIndex)
    add(delta.edgeNext, delta.functionEdgeHeads[fromRow])
    delta.functionEdgeHeads[fromRow] = edgeIndex
    if CompilerCsgReachabilityDeltaIsReachable(ruleSet, delta, fromIndex):
        CompilerCsgReachabilityDeltaMark(ruleSet, delta, toIndex)

@borrows
fn CompilerCsgReachabilityDeltaExpandRec(
        ruleSet: var CompilerCsgReachableFunctionSet,
        delta: var CompilerCsgReachabilityDelta) =
    while true:
        if delta.closureCursor >= delta.markQueue.len:
            return
        let functionIndex = delta.markQueue[delta.closureCursor]
        delta.closureCursor = delta.closureCursor + 1
        if functionIndex < 0 ||
           functionIndex >= ruleSet.edgeHeads.len:
            delta.probes.contentCertificateViolation = true
            return
        if functionIndex >= ruleSet.edgeHeadCertificates.len:
            delta.probes.contentCertificateViolation = true
            return
        delta.probes.certificateValidationOperationCount =
            delta.probes.certificateValidationOperationCount + Int64(1)
        if ruleSet.edgeHeadCertificates[functionIndex] !=
           CompilerCsgReachableEdgeHeadCertificate(functionIndex,
                                                   ruleSet.edgeHeads[functionIndex]):
            delta.probes.contentCertificateViolation = true
            return
        var edgeIndex = ruleSet.edgeHeads[functionIndex]
        while edgeIndex >= 0:
            if edgeIndex >= ruleSet.edgeFrom.len || edgeIndex >= ruleSet.edgeTo.len ||
               edgeIndex >= ruleSet.edgeNext.len || edgeIndex >= ruleSet.edgeRowCertificates.len:
                delta.probes.contentCertificateViolation = true
                return
            delta.probes.certificateValidationOperationCount =
                delta.probes.certificateValidationOperationCount + Int64(1)
            if ruleSet.edgeRowCertificates[edgeIndex] !=
               CompilerCsgReachableEdgeRowCertificate(edgeIndex,
                                                      ruleSet.edgeFrom[edgeIndex],
                                                      ruleSet.edgeTo[edgeIndex],
                                                      ruleSet.edgeNext[edgeIndex]) ||
               ruleSet.edgeFrom[edgeIndex] != functionIndex:
                delta.probes.contentCertificateViolation = true
                return
            CompilerCsgReachabilityDeltaMark(ruleSet, delta, ruleSet.edgeTo[edgeIndex])
            edgeIndex = ruleSet.edgeNext[edgeIndex]
        let functionRow = CompilerCsgSparseIntIndexFind(delta.functionIndex,
                                                        functionIndex)
        edgeIndex = functionRow >= 0 ? delta.functionEdgeHeads[functionRow] : -1
        while edgeIndex >= 0:
            if edgeIndex >= delta.edgeTo.len || edgeIndex >= delta.edgeNext.len:
                panic("compiler csg: tentative reachability adjacency corrupt")
            CompilerCsgReachabilityDeltaMark(ruleSet, delta, delta.edgeTo[edgeIndex])
            edgeIndex = delta.edgeNext[edgeIndex]
        continue

fn CompilerCsgReachabilityDeltaExpand(ruleSet: var CompilerCsgReachableFunctionSet,
                                       delta: var CompilerCsgReachabilityDelta) =
    CompilerCsgReachabilityDeltaExpandRec(ruleSet, delta)

fn CompilerCsgReachabilityProbeDeltaCommit(ruleSet: var CompilerCsgReachableFunctionSet,
                                            probes: var CompilerCsgReachabilityProbeDelta) =
    ruleSet.scopedFunctionNames.hashOperationCount =
        ruleSet.scopedFunctionNames.hashOperationCount + probes.scopedNameHashOperationCount
    ruleSet.scopedFunctionNames.hashProbeCount =
        ruleSet.scopedFunctionNames.hashProbeCount + probes.scopedNameHashProbeCount
    if probes.scopedNameHashMaxProbeCount > ruleSet.scopedFunctionNames.hashMaxProbeCount:
        ruleSet.scopedFunctionNames.hashMaxProbeCount = probes.scopedNameHashMaxProbeCount
    ruleSet.globalFunctionNames.hashOperationCount =
        ruleSet.globalFunctionNames.hashOperationCount + probes.globalNameHashOperationCount
    ruleSet.globalFunctionNames.hashProbeCount =
        ruleSet.globalFunctionNames.hashProbeCount + probes.globalNameHashProbeCount
    if probes.globalNameHashMaxProbeCount > ruleSet.globalFunctionNames.hashMaxProbeCount:
        ruleSet.globalFunctionNames.hashMaxProbeCount = probes.globalNameHashMaxProbeCount
    ruleSet.lineBinarySearchOperationCount =
        ruleSet.lineBinarySearchOperationCount + probes.lineBinarySearchOperationCount
    ruleSet.lineBinarySearchProbeCount =
        ruleSet.lineBinarySearchProbeCount + probes.lineBinarySearchProbeCount
    if probes.lineBinarySearchMaxProbeCount > ruleSet.lineBinarySearchMaxProbeCount:
        ruleSet.lineBinarySearchMaxProbeCount = probes.lineBinarySearchMaxProbeCount
    ruleSet.resolvedCallRowVisitCount =
        ruleSet.resolvedCallRowVisitCount + probes.resolvedCallRowVisitCount
    ruleSet.certificateValidationOperationCount =
        ruleSet.certificateValidationOperationCount +
            probes.certificateValidationOperationCount
    probes = CompilerCsgReachabilityProbeDelta()

@borrows
fn CompilerCsgReachableNameIndexValidate(index: CompilerCsgNameAdjacencyIndex,
                                         nextIndexes: int32[],
                                         ruleSet: var CompilerCsgReachableFunctionSet,
                                         globalIndex: bool,
                                         err: var str): bool =
    let functionCount = ruleSet.functionNames.len
    let keyCount = index.profileIndexes.len
    if index.functionNames.len != keyCount || index.heads.len != keyCount ||
       index.tails.len != keyCount || index.counts.len != keyCount ||
       index.keyCertificates.len != keyCount ||
       index.functionDeclared.len != functionCount ||
       index.functionNodeCertificates.len != functionCount ||
       index.slotCertificates.len != index.slots.len ||
       nextIndexes.len != functionCount:
        err = Fmt" compiler csg: reachable name index columns mismatch global={globalIndex} keys={keyCount} names={index.functionNames.len} heads={index.heads.len} tails={index.tails.len} counts={index.counts.len} declared={index.functionDeclared.len} next={nextIndexes.len} functions={functionCount}"
        return false
    if index.slots.len <= 0 ||
       (index.slots.len & (index.slots.len - 1)) != 0:
        err = Fmt" compiler csg: reachable name index slot domain invalid global={globalIndex} slots={index.slots.len}"
        return false
    var occupied: int32
    for slotIndex in 0..<index.slots.len:
        let keyPlus1 = index.slots[slotIndex]
        if index.slotCertificates[slotIndex] !=
           CompilerCsgReachableNameSlotCertificate(slotIndex, keyPlus1):
            err = Fmt" compiler csg: reachable name slot certificate mismatch global={globalIndex} slot={slotIndex}"
            return false
        if keyPlus1 == 0:
            continue
        let keyIndex = keyPlus1 - 1
        if keyIndex < 0 || keyIndex >= keyCount:
            err = Fmt" compiler csg: reachable name index slot row invalid global={globalIndex} slot={slotIndex} key={keyIndex} keys={keyCount}"
            return false
        occupied = occupied + 1
    if occupied != keyCount:
        err = Fmt" compiler csg: reachable name index occupancy mismatch global={globalIndex} occupied={occupied} keys={keyCount}"
        return false
    var chainedFunctionCount: int32
    for keyIndex in 0..<keyCount:
        let profileIndex = index.profileIndexes[keyIndex]
        if (globalIndex && profileIndex != -1) ||
           (!globalIndex &&
            (profileIndex < 0 || profileIndex >= ruleSet.profileFunctionStarts.len)):
            err = Fmt" compiler csg: reachable name index profile invalid global={globalIndex} key={keyIndex} profile={profileIndex} profiles={ruleSet.profileFunctionStarts.len}"
            return false
        if index.functionNames[keyIndex] == "" || index.counts[keyIndex] <= 0:
            err = Fmt" compiler csg: reachable name index key invalid global={globalIndex} key={keyIndex} count={index.counts[keyIndex]}"
            return false
        if index.keyCertificates[keyIndex] !=
           CompilerCsgReachableNameKeyCertificate(profileIndex,
                                                  index.functionNames[keyIndex],
                                                  index.heads[keyIndex],
                                                  index.tails[keyIndex],
                                                  index.counts[keyIndex]):
            err = Fmt" compiler csg: reachable name key certificate mismatch global={globalIndex} key={keyIndex}"
            return false
        var slot = CompilerCsgReachableNameHash(profileIndex,
                                                index.functionNames[keyIndex]) &
                   (index.slots.len - 1)
        var scanned: int32
        var keyFound = false
        while scanned < index.slots.len:
            let candidatePlus1 = index.slots[slot]
            if candidatePlus1 == 0:
                break
            if candidatePlus1 - 1 == keyIndex:
                keyFound = true
                break
            slot = (slot + 1) & (index.slots.len - 1)
            scanned = scanned + 1
        if !keyFound:
            err = Fmt" compiler csg: reachable name key is not reachable from hash global={globalIndex} key={keyIndex}"
            return false
        let head = index.heads[keyIndex]
        let tail = index.tails[keyIndex]
        if head < 0 || head >= functionCount || tail < 0 || tail >= functionCount:
            err = Fmt" compiler csg: reachable name adjacency endpoint invalid global={globalIndex} key={keyIndex} head={head} tail={tail} functions={functionCount}"
            return false
        var functionIndex = head
        var chainCount: int32
        while functionIndex >= 0:
            if functionIndex >= functionCount ||
               !index.functionDeclared[functionIndex] ||
               ruleSet.functionNames[functionIndex] != index.functionNames[keyIndex] ||
               (!globalIndex &&
                ruleSet.functionProfileIndexes[functionIndex] != profileIndex):
                err = Fmt" compiler csg: reachable name adjacency owner mismatch global={globalIndex} key={keyIndex} function={functionIndex}"
                return false
            chainCount = chainCount + 1
            if chainCount > functionCount:
                err = Fmt" compiler csg: reachable name adjacency cycle global={globalIndex} key={keyIndex}"
                return false
            if functionIndex == tail && nextIndexes[functionIndex] != -1:
                err = Fmt" compiler csg: reachable name adjacency tail has successor global={globalIndex} key={keyIndex} tail={tail} next={nextIndexes[functionIndex]}"
                return false
            functionIndex = nextIndexes[functionIndex]
        if chainCount != index.counts[keyIndex]:
            err = Fmt" compiler csg: reachable name adjacency count mismatch global={globalIndex} key={keyIndex} actual={chainCount} expected={index.counts[keyIndex]}"
            return false
        chainedFunctionCount = chainedFunctionCount + chainCount
    if chainedFunctionCount != functionCount:
        err = Fmt" compiler csg: reachable name adjacency coverage mismatch global={globalIndex} covered={chainedFunctionCount} functions={functionCount}"
        return false
    for functionIndex in 0..<functionCount:
        if !index.functionDeclared[functionIndex] ||
           nextIndexes[functionIndex] < -1 ||
           nextIndexes[functionIndex] >= functionCount:
            err = Fmt" compiler csg: reachable name function declaration invalid global={globalIndex} function={functionIndex} declared={index.functionDeclared[functionIndex]} next={nextIndexes[functionIndex]}"
            return false
        if index.functionNodeCertificates[functionIndex] !=
           CompilerCsgReachableNameNodeCertificate(functionIndex,
                                                   index.functionDeclared[functionIndex],
                                                   nextIndexes[functionIndex]):
            err = Fmt" compiler csg: reachable name node certificate mismatch global={globalIndex} function={functionIndex}"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgReachableStructureShapeSeal(ruleSet: CompilerCsgReachableFunctionSet): int64 =
    var seal: int64 = Int64(146959810)
    seal = seal * Int64(131) + Int64(ruleSet.exportNameExplicitFlags.len)
    seal = seal * Int64(131) + Int64(ruleSet.sourcePaths.len)
    seal = seal * Int64(131) + Int64(ruleSet.functionNames.len)
    seal = seal * Int64(131) + Int64(ruleSet.symbolTexts.len)
    seal = seal * Int64(131) + Int64(ruleSet.exportSymbolNames.len)
    seal = seal * Int64(131) + Int64(ruleSet.producerSourceIndexes.len)
    seal = seal * Int64(131) + Int64(ruleSet.producerDeclarationIndexes.len)
    seal = seal * Int64(131) + Int64(ruleSet.functionNameSurfaceKinds.len)
    seal = seal * Int64(131) + Int64(ruleSet.functionNameProofCids.len)
    seal = seal * Int64(131) + Int64(ruleSet.functionAnnotationFlags.len)
    seal = seal * Int64(131) +
           Int64(ruleSet.functionDeclarationHeaderCids.len)
    seal = seal * Int64(131) +
           Int64(ruleSet.functionDeclarationPathCids.len)
    seal = seal * Int64(131) + Int64(ruleSet.keepExportBindingCids.len)
    seal = seal * Int64(131) + Int64(ruleSet.startLines.len)
    seal = seal * Int64(131) + Int64(ruleSet.endLines.len)
    seal = seal * Int64(131) + Int64(ruleSet.functionProfileIndexes.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileFunctionStarts.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileFunctionCounts.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileLineIndexProven.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileSourceIndex.lookup.slots.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileSourceIndex.lookup.buckets.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileSourceIndex.roots.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileSourceIndex.slotCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileSourceIndex.bucketCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileSourceIndex.rootCertificates.len)
    seal = seal * Int64(131) +
           ruleSet.profileSourceIndex.relativeRootCertificate
    seal = seal * Int64(131) +
           (ruleSet.profileSourceIndex.rootsConfigured ? Int64(1) : Int64(0))
    seal = seal * Int64(131) + ruleSet.profileSourceIndex.domainVersion
    seal = seal * Int64(131) + ruleSet.profileSourceIndex.sealedDomainVersion
    seal = seal * Int64(131) + Int64(ruleSet.scopedFunctionNames.slots.len)
    seal = seal * Int64(131) + Int64(ruleSet.scopedFunctionNames.profileIndexes.len)
    seal = seal * Int64(131) + Int64(ruleSet.scopedFunctionNames.functionNames.len)
    seal = seal * Int64(131) + Int64(ruleSet.scopedFunctionNames.functionDeclared.len)
    seal = seal * Int64(131) + Int64(ruleSet.scopedFunctionNameNext.len)
    seal = seal * Int64(131) + Int64(ruleSet.globalFunctionNames.slots.len)
    seal = seal * Int64(131) + Int64(ruleSet.globalFunctionNames.profileIndexes.len)
    seal = seal * Int64(131) + Int64(ruleSet.globalFunctionNames.functionNames.len)
    seal = seal * Int64(131) + Int64(ruleSet.globalFunctionNames.functionDeclared.len)
    seal = seal * Int64(131) + Int64(ruleSet.globalFunctionNameNext.len)
    seal = seal * Int64(131) + Int64(ruleSet.profileRowCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.functionRowCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.scopedFunctionNames.slotCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.scopedFunctionNames.keyCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.scopedFunctionNames.functionNodeCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.globalFunctionNames.slotCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.globalFunctionNames.keyCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.globalFunctionNames.functionNodeCertificates.len)
    seal = seal * Int64(131) + ruleSet.structureContentCertificate
    return seal

@borrows
fn CompilerCsgReachableStructureSealValid(ruleSet: CompilerCsgReachableFunctionSet): bool =
    return ruleSet.structureVersion > Int64(0) &&
           ruleSet.structureSealedVersion == ruleSet.structureVersion &&
           ruleSet.structureShapeSeal == CompilerCsgReachableStructureShapeSeal(ruleSet)

@borrows
fn CompilerCsgReachableGraphShapeSeal(ruleSet: CompilerCsgReachableFunctionSet): int64 =
    # Reachability graph columns are module-owned. Every production mutation
    # goes through Mark/AddEdge or a validated delta commit and advances the
    # graph version; the shape seal catches incomplete column commits in O(1).
    var seal: int64 = Int64(216613626)
    seal = seal * Int64(131) + Int64(ruleSet.functionNames.len)
    seal = seal * Int64(131) + Int64(ruleSet.reachable.len)
    seal = seal * Int64(131) + Int64(ruleSet.reachableCount)
    seal = seal * Int64(131) + Int64(ruleSet.reachableQueue.len)
    seal = seal * Int64(131) + Int64(ruleSet.edgeFrom.len)
    seal = seal * Int64(131) + Int64(ruleSet.edgeTo.len)
    seal = seal * Int64(131) + Int64(ruleSet.edgeHeads.len)
    seal = seal * Int64(131) + Int64(ruleSet.edgeNext.len)
    seal = seal * Int64(131) + Int64(ruleSet.edgePairSlots.len)
    seal = seal * Int64(131) + Int64(ruleSet.reachableRowCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.reachableQueueCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.edgeHeadCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.edgeRowCertificates.len)
    seal = seal * Int64(131) + Int64(ruleSet.edgePairSlotCertificates.len)
    seal = seal * Int64(131) + ruleSet.graphContentCertificate
    return seal

@borrows
fn CompilerCsgReachableGraphSealValid(ruleSet: CompilerCsgReachableFunctionSet): bool =
    return ruleSet.graphVersion > Int64(0) &&
           ruleSet.graphSealedVersion == ruleSet.graphVersion &&
           ruleSet.graphShapeSeal == CompilerCsgReachableGraphShapeSeal(ruleSet)

# var formal (not @borrows): every caller reads the set mid-mutation, where
# its current definition is a loop CFG_MERGE unique borrow; the exact checker
# accepts unique->var pass-through but has no CFG_MERGE reborrow-as-shared.
fn CompilerCsgReachableGraphCertificateTrackingActive(ruleSet: var CompilerCsgReachableFunctionSet): bool =
    return CompilerCsgReachableGraphSealValid(ruleSet)

fn CompilerCsgReachableGraphCommitSeal(ruleSet: var CompilerCsgReachableFunctionSet) =
    if ruleSet.graphVersion <= Int64(0):
        ruleSet.graphVersion = Int64(1)
    ruleSet.graphSealedVersion = ruleSet.graphVersion
    ruleSet.graphShapeSeal = CompilerCsgReachableGraphShapeSeal(ruleSet)

fn CompilerCsgReachableGraphMutationCommit(ruleSet: var CompilerCsgReachableFunctionSet) =
    if ruleSet.graphVersion <= Int64(0):
        ruleSet.graphVersion = Int64(1)
    else:
        ruleSet.graphVersion = ruleSet.graphVersion + Int64(1)
    CompilerCsgReachableGraphCommitSeal(ruleSet)

fn CompilerCsgReachableCommittedGraphValidate(ruleSet: var CompilerCsgReachableFunctionSet,
                                               err: var str): bool =
    let functionCount = ruleSet.functionNames.len
    if ruleSet.reachable.len != functionCount || ruleSet.edgeHeads.len != functionCount:
        err = Fmt" compiler csg: committed reachability columns mismatch functions={functionCount} reachable={ruleSet.reachable.len} heads={ruleSet.edgeHeads.len}"
        return false
    var reachableCount: int32
    for functionIndex in 0..<functionCount:
        if ruleSet.reachable[functionIndex]:
            reachableCount = reachableCount + 1
    if reachableCount != ruleSet.reachableCount ||
       ruleSet.reachableQueue.len != ruleSet.reachableCount:
        err = Fmt" compiler csg: reachable queue count mismatch flags={reachableCount} count={ruleSet.reachableCount} queue={ruleSet.reachableQueue.len}"
        return false
    for queueIndex in 0..<ruleSet.reachableQueue.len:
        let functionIndex = ruleSet.reachableQueue[queueIndex]
        if functionIndex < 0 || functionIndex >= functionCount ||
           !ruleSet.reachable[functionIndex]:
            err = Fmt" compiler csg: reachable queue row invalid queue={queueIndex} function={functionIndex} functions={functionCount}"
            return false
    if ruleSet.scopedFunctionNames.hashOperationCount < Int64(0) ||
       ruleSet.scopedFunctionNames.hashProbeCount < ruleSet.scopedFunctionNames.hashOperationCount ||
       ruleSet.scopedFunctionNames.hashMaxProbeCount < 0 ||
       ruleSet.globalFunctionNames.hashOperationCount < Int64(0) ||
       ruleSet.globalFunctionNames.hashProbeCount < ruleSet.globalFunctionNames.hashOperationCount ||
       ruleSet.globalFunctionNames.hashMaxProbeCount < 0 ||
       ruleSet.lineBinarySearchOperationCount < Int64(0) ||
       ruleSet.lineBinarySearchProbeCount < ruleSet.lineBinarySearchOperationCount ||
       ruleSet.lineBinarySearchMaxProbeCount < 0 ||
       ruleSet.edgePairOperationCount < Int64(0) ||
       ruleSet.edgePairProbeCount < ruleSet.edgePairOperationCount ||
       ruleSet.edgePairMaxProbeCount < 0 ||
       ruleSet.resolvedCallRowVisitCount < Int64(0):
        err = " compiler csg: committed reachability counters invalid"
        return false
    let edgeCount = ruleSet.edgeFrom.len
    if ruleSet.edgeTo.len != edgeCount || ruleSet.edgeNext.len != edgeCount:
        err = Fmt" compiler csg: committed reachability edge columns mismatch edges={edgeCount} to={ruleSet.edgeTo.len} next={ruleSet.edgeNext.len}"
        return false
    for edgeIndex in 0..<edgeCount:
        if ruleSet.edgeFrom[edgeIndex] < 0 || ruleSet.edgeFrom[edgeIndex] >= functionCount ||
           ruleSet.edgeTo[edgeIndex] < 0 || ruleSet.edgeTo[edgeIndex] >= functionCount ||
           ruleSet.edgeNext[edgeIndex] < -1 || ruleSet.edgeNext[edgeIndex] >= edgeCount:
            err = Fmt" compiler csg: committed reachability edge invalid edge={edgeIndex} from={ruleSet.edgeFrom[edgeIndex]} to={ruleSet.edgeTo[edgeIndex]} next={ruleSet.edgeNext[edgeIndex]} functions={functionCount}"
            return false
    var chainedEdges: int32
    for functionIndex in 0..<functionCount:
        let head = ruleSet.edgeHeads[functionIndex]
        if head < -1 || head >= edgeCount:
            err = Fmt" compiler csg: committed reachability head invalid function={functionIndex} head={head} edges={edgeCount}"
            return false
        var edgeIndex = head
        var chainCount: int32
        while edgeIndex >= 0:
            if ruleSet.edgeFrom[edgeIndex] != functionIndex:
                err = Fmt" compiler csg: committed reachability edge owner mismatch function={functionIndex} edge={edgeIndex} actual={ruleSet.edgeFrom[edgeIndex]}"
                return false
            chainCount = chainCount + 1
            if chainCount > edgeCount:
                err = Fmt" compiler csg: committed reachability edge cycle function={functionIndex}"
                return false
            edgeIndex = ruleSet.edgeNext[edgeIndex]
        chainedEdges = chainedEdges + chainCount
    if chainedEdges != edgeCount:
        err = Fmt" compiler csg: committed reachability adjacency coverage mismatch chained={chainedEdges} edges={edgeCount}"
        return false
    if ruleSet.edgePairSlots.len <= 0 ||
       (ruleSet.edgePairSlots.len & (ruleSet.edgePairSlots.len - 1)) != 0:
        err = Fmt" compiler csg: committed edge-pair slot domain invalid slots={ruleSet.edgePairSlots.len}"
        return false
    var occupiedEdges: int32
    for slotIndex in 0..<ruleSet.edgePairSlots.len:
        let edgePlus1 = ruleSet.edgePairSlots[slotIndex]
        if edgePlus1 == 0:
            continue
        let edgeIndex = edgePlus1 - 1
        if edgeIndex < 0 || edgeIndex >= edgeCount:
            err = Fmt" compiler csg: committed edge-pair slot invalid slot={slotIndex} edge={edgeIndex} edges={edgeCount}"
            return false
        occupiedEdges = occupiedEdges + 1
    if occupiedEdges != edgeCount:
        err = Fmt" compiler csg: committed edge-pair occupancy mismatch occupied={occupiedEdges} edges={edgeCount}"
        return false
    let edgePairMask = ruleSet.edgePairSlots.len - 1
    for edgeIndex in 0..<edgeCount:
        let edgeHash = Int64(ruleSet.edgeFrom[edgeIndex]) * Int64(1315423911) +
                       Int64(ruleSet.edgeTo[edgeIndex]) * Int64(2654435761)
        var slot = Int32(edgeHash & Int64(edgePairMask))
        var scanned: int32
        var found = false
        while scanned < ruleSet.edgePairSlots.len:
            let candidatePlus1 = ruleSet.edgePairSlots[slot]
            if candidatePlus1 == 0:
                break
            if candidatePlus1 - 1 == edgeIndex:
                found = true
                break
            slot = (slot + 1) & edgePairMask
            scanned = scanned + 1
        if !found:
            err = Fmt" compiler csg: committed edge-pair row is not reachable from hash edge={edgeIndex} from={ruleSet.edgeFrom[edgeIndex]} to={ruleSet.edgeTo[edgeIndex]}"
            return false
    err = ""
    return true

fn CompilerCsgReachableFunctionSetValidate(ruleSet: var CompilerCsgReachableFunctionSet,
                                           err: var str): bool =
    let functionCount = ruleSet.functionNames.len
    if ruleSet.exportNameExplicitFlags.len != functionCount ||
       ruleSet.sourcePaths.len != functionCount ||
       ruleSet.symbolTexts.len != functionCount ||
       ruleSet.exportSymbolNames.len != functionCount ||
       ruleSet.producerSourceIndexes.len != functionCount ||
       ruleSet.producerDeclarationIndexes.len != functionCount ||
       ruleSet.functionNameSurfaceKinds.len != functionCount ||
       ruleSet.functionNameProofCids.len != functionCount ||
       ruleSet.functionAnnotationFlags.len != functionCount ||
       ruleSet.functionDeclarationHeaderCids.len != functionCount ||
       ruleSet.functionDeclarationPathCids.len != functionCount ||
       ruleSet.keepExportBindingCids.len != functionCount ||
       ruleSet.startLines.len != functionCount ||
       ruleSet.endLines.len != functionCount ||
       ruleSet.reachable.len != functionCount ||
       ruleSet.edgeHeads.len != functionCount ||
       ruleSet.functionProfileIndexes.len != functionCount:
        err = Fmt" compiler csg: reachable function columns mismatch functions={functionCount} exports={ruleSet.exportNameExplicitFlags.len} sources={ruleSet.sourcePaths.len} symbols={ruleSet.symbolTexts.len} export_symbols={ruleSet.exportSymbolNames.len} producer_sources={ruleSet.producerSourceIndexes.len} producer_decls={ruleSet.producerDeclarationIndexes.len} name_surfaces={ruleSet.functionNameSurfaceKinds.len} name_proofs={ruleSet.functionNameProofCids.len} annotation_flags={ruleSet.functionAnnotationFlags.len} declaration_headers={ruleSet.functionDeclarationHeaderCids.len} declaration_paths={ruleSet.functionDeclarationPathCids.len} keep_export_cids={ruleSet.keepExportBindingCids.len} starts={ruleSet.startLines.len} ends={ruleSet.endLines.len} reachable={ruleSet.reachable.len} heads={ruleSet.edgeHeads.len} profiles={ruleSet.functionProfileIndexes.len}"
        return false
    let profileCount = ruleSet.profileFunctionStarts.len
    if ruleSet.profileFunctionCounts.len != profileCount ||
       ruleSet.profileLineIndexProven.len != profileCount:
        err = Fmt" compiler csg: reachable profile columns mismatch profiles={profileCount} counts={ruleSet.profileFunctionCounts.len} proofs={ruleSet.profileLineIndexProven.len}"
        return false
    var coveredFunctions: int32
    for profileIndex in 0..<profileCount:
        let start = ruleSet.profileFunctionStarts[profileIndex]
        let count = ruleSet.profileFunctionCounts[profileIndex]
        if count < 0 ||
           (count == 0 && (start < -1 || start > functionCount)) ||
           (count > 0 && (start < 0 || start > functionCount - count)):
            err = Fmt" compiler csg: reachable profile range invalid profile={profileIndex} start={start} count={count} functions={functionCount}"
            return false
        if count > 0:
            for functionIndex in start..<start + count:
                if ruleSet.functionProfileIndexes[functionIndex] != profileIndex ||
                   ruleSet.producerSourceIndexes[functionIndex] != profileIndex ||
                   ruleSet.producerDeclarationIndexes[functionIndex] < 0 ||
                   (functionIndex > start &&
                    ruleSet.producerDeclarationIndexes[functionIndex] <=
                        ruleSet.producerDeclarationIndexes[functionIndex - 1]):
                    err = Fmt" compiler csg: reachable profile owner mismatch profile={profileIndex} function={functionIndex} actual={ruleSet.functionProfileIndexes[functionIndex]}"
                    return false
        coveredFunctions = coveredFunctions + count
    if coveredFunctions != functionCount:
        err = Fmt" compiler csg: reachable profile coverage mismatch covered={coveredFunctions} functions={functionCount}"
        return false
    var reachableCount: int32
    for functionIndex in 0..<functionCount:
        if ruleSet.functionProfileIndexes[functionIndex] < 0 ||
           ruleSet.functionProfileIndexes[functionIndex] >= profileCount ||
           ruleSet.producerSourceIndexes[functionIndex] !=
               ruleSet.functionProfileIndexes[functionIndex] ||
           ruleSet.producerDeclarationIndexes[functionIndex] < 0 ||
           (ruleSet.functionNameSurfaceKinds[functionIndex] != 0 &&
            ruleSet.functionNameSurfaceKinds[functionIndex] !=
                parser_receipt.ParserFunctionNameSurfaceIdentifier &&
            ruleSet.functionNameSurfaceKinds[functionIndex] !=
                parser_receipt.ParserFunctionNameSurfaceBacktick) ||
           ((ruleSet.functionNameSurfaceKinds[functionIndex] == 0) !=
            layout.FixedBytes32Equal(
                ruleSet.functionNameProofCids[functionIndex],
                layout.FixedBytes32())) ||
           ruleSet.functionAnnotationFlags[functionIndex] < -1 ||
           (ruleSet.functionAnnotationFlags[functionIndex] >= 0 &&
            !parser.ParserNormalizedFunctionAnnotationFlagsValid(
                ruleSet.functionAnnotationFlags[functionIndex])) ||
           ruleSet.startLines[functionIndex] <= 0 ||
           (ruleSet.endLines[functionIndex] > 0 &&
            ruleSet.endLines[functionIndex] < ruleSet.startLines[functionIndex]):
            err = Fmt" compiler csg: reachable function owner/range invalid function={functionIndex} profile={ruleSet.functionProfileIndexes[functionIndex]} start={ruleSet.startLines[functionIndex]} end={ruleSet.endLines[functionIndex]}"
            return false
        var indexedProfile: int32
        var sourceIndexErr: str
        if !CompilerCsgSourcePathIndexFind(ruleSet.profileSourceIndex,
                                           ruleSet.sourcePaths[functionIndex],
                                           indexedProfile,
                                           sourceIndexErr) ||
           indexedProfile != ruleSet.functionProfileIndexes[functionIndex]:
            err = Fmt" compiler csg: reachable function source/profile owner mismatch function={functionIndex} source={ruleSet.sourcePaths[functionIndex]} expected_profile={ruleSet.functionProfileIndexes[functionIndex]} indexed_profile={indexedProfile}: {sourceIndexErr}"
            return false
        if ruleSet.reachable[functionIndex]:
            reachableCount = reachableCount + 1
    if reachableCount != ruleSet.reachableCount ||
       ruleSet.reachableQueue.len != ruleSet.reachableCount:
        err = Fmt" compiler csg: reachable queue count mismatch flags={reachableCount} count={ruleSet.reachableCount} queue={ruleSet.reachableQueue.len}"
        return false
    for queueIndex in 0..<ruleSet.reachableQueue.len:
        let functionIndex = ruleSet.reachableQueue[queueIndex]
        if functionIndex < 0 || functionIndex >= functionCount ||
           !ruleSet.reachable[functionIndex]:
            err = Fmt" compiler csg: reachable queue row invalid queue={queueIndex} function={functionIndex} functions={functionCount}"
            return false
    if ruleSet.scopedFunctionNames.hashOperationCount < Int64(0) ||
       ruleSet.scopedFunctionNames.hashProbeCount < ruleSet.scopedFunctionNames.hashOperationCount ||
       ruleSet.scopedFunctionNames.hashMaxProbeCount < 0 ||
       ruleSet.globalFunctionNames.hashOperationCount < Int64(0) ||
       ruleSet.globalFunctionNames.hashProbeCount < ruleSet.globalFunctionNames.hashOperationCount ||
       ruleSet.globalFunctionNames.hashMaxProbeCount < 0 ||
       ruleSet.lineBinarySearchOperationCount < Int64(0) ||
       ruleSet.lineBinarySearchProbeCount < ruleSet.lineBinarySearchOperationCount ||
       ruleSet.lineBinarySearchMaxProbeCount < 0 ||
       ruleSet.edgePairOperationCount < Int64(0) ||
       ruleSet.edgePairProbeCount < ruleSet.edgePairOperationCount ||
       ruleSet.edgePairMaxProbeCount < 0 ||
       ruleSet.resolvedCallRowVisitCount < Int64(0):
        err = " compiler csg: committed reachability counters invalid"
        return false
    let edgeCount = ruleSet.edgeFrom.len
    if ruleSet.edgeTo.len != edgeCount || ruleSet.edgeNext.len != edgeCount:
        err = Fmt" compiler csg: committed reachability edge columns mismatch edges={edgeCount} to={ruleSet.edgeTo.len} next={ruleSet.edgeNext.len}"
        return false
    for edgeIndex in 0..<edgeCount:
        if ruleSet.edgeFrom[edgeIndex] < 0 || ruleSet.edgeFrom[edgeIndex] >= functionCount ||
           ruleSet.edgeTo[edgeIndex] < 0 || ruleSet.edgeTo[edgeIndex] >= functionCount ||
           ruleSet.edgeNext[edgeIndex] < -1 || ruleSet.edgeNext[edgeIndex] >= edgeCount:
            err = Fmt" compiler csg: committed reachability edge invalid edge={edgeIndex} from={ruleSet.edgeFrom[edgeIndex]} to={ruleSet.edgeTo[edgeIndex]} next={ruleSet.edgeNext[edgeIndex]} functions={functionCount}"
            return false
    var chainedEdges: int32
    for functionIndex in 0..<functionCount:
        let head = ruleSet.edgeHeads[functionIndex]
        if head < -1 || head >= edgeCount:
            err = Fmt" compiler csg: committed reachability head invalid function={functionIndex} head={head} edges={edgeCount}"
            return false
        var edgeIndex = head
        var chainCount: int32
        while edgeIndex >= 0:
            if ruleSet.edgeFrom[edgeIndex] != functionIndex:
                err = Fmt" compiler csg: committed reachability edge owner mismatch function={functionIndex} edge={edgeIndex} actual={ruleSet.edgeFrom[edgeIndex]}"
                return false
            chainCount = chainCount + 1
            if chainCount > edgeCount:
                err = Fmt" compiler csg: committed reachability edge cycle function={functionIndex}"
                return false
            edgeIndex = ruleSet.edgeNext[edgeIndex]
        chainedEdges = chainedEdges + chainCount
    if chainedEdges != edgeCount:
        err = Fmt" compiler csg: committed reachability adjacency coverage mismatch chained={chainedEdges} edges={edgeCount}"
        return false
    if ruleSet.edgePairSlots.len <= 0 ||
       (ruleSet.edgePairSlots.len & (ruleSet.edgePairSlots.len - 1)) != 0:
        err = Fmt" compiler csg: committed edge-pair slot domain invalid slots={ruleSet.edgePairSlots.len}"
        return false
    var occupiedEdges: int32
    for slotIndex in 0..<ruleSet.edgePairSlots.len:
        let edgePlus1 = ruleSet.edgePairSlots[slotIndex]
        if edgePlus1 == 0:
            continue
        let edgeIndex = edgePlus1 - 1
        if edgeIndex < 0 || edgeIndex >= edgeCount:
            err = Fmt" compiler csg: committed edge-pair slot invalid slot={slotIndex} edge={edgeIndex} edges={edgeCount}"
            return false
        occupiedEdges = occupiedEdges + 1
    if occupiedEdges != edgeCount:
        err = Fmt" compiler csg: committed edge-pair occupancy mismatch occupied={occupiedEdges} edges={edgeCount}"
        return false
    let edgePairMask = ruleSet.edgePairSlots.len - 1
    for edgeIndex in 0..<edgeCount:
        let edgeHash = Int64(ruleSet.edgeFrom[edgeIndex]) * Int64(1315423911) +
                       Int64(ruleSet.edgeTo[edgeIndex]) * Int64(2654435761)
        var slot = Int32(edgeHash & Int64(edgePairMask))
        var scanned: int32
        var found = false
        while scanned < ruleSet.edgePairSlots.len:
            let candidatePlus1 = ruleSet.edgePairSlots[slot]
            if candidatePlus1 == 0:
                break
            if candidatePlus1 - 1 == edgeIndex:
                found = true
                break
            slot = (slot + 1) & edgePairMask
            scanned = scanned + 1
        if !found:
            err = Fmt" compiler csg: committed edge-pair row is not reachable from hash edge={edgeIndex} from={ruleSet.edgeFrom[edgeIndex]} to={ruleSet.edgeTo[edgeIndex]}"
            return false
    if !CompilerCsgReachableNameIndexValidate(ruleSet.scopedFunctionNames,
                                              ruleSet.scopedFunctionNameNext,
                                              ruleSet,
                                              false,
                                              err):
        return false
    if !CompilerCsgReachableNameIndexValidate(ruleSet.globalFunctionNames,
                                              ruleSet.globalFunctionNameNext,
                                              ruleSet,
                                              true,
                                              err):
        return false
    err = ""
    return true

fn CompilerCsgReachableFunctionSetSealStructure(ruleSet: var CompilerCsgReachableFunctionSet,
                                                 err: var str): bool =
    if !CompilerCsgReachableFunctionSetValidate(ruleSet, err):
        return false
    ruleSet.profileRowCertificates = []
    for profileIndex in 0..<ruleSet.profileFunctionStarts.len:
        add(ruleSet.profileRowCertificates,
            CompilerCsgReachableProfileRowCertificate(ruleSet, profileIndex))
        ruleSet.certificateBuildOperationCount =
            ruleSet.certificateBuildOperationCount + Int64(1)
    ruleSet.functionRowCertificates = []
    ruleSet.reachableRowCertificates = []
    ruleSet.edgeHeadCertificates = []
    for functionIndex in 0..<ruleSet.functionNames.len:
        add(ruleSet.functionRowCertificates,
            CompilerCsgReachableFunctionRowCertificate(ruleSet, functionIndex))
        add(ruleSet.reachableRowCertificates,
            CompilerCsgReachableRowCertificate(functionIndex,
                                               ruleSet.reachable[functionIndex]))
        add(ruleSet.edgeHeadCertificates,
            CompilerCsgReachableEdgeHeadCertificate(functionIndex,
                                                    ruleSet.edgeHeads[functionIndex]))
        ruleSet.certificateBuildOperationCount =
            ruleSet.certificateBuildOperationCount + Int64(3)
    ruleSet.reachableQueueCertificates = []
    for queueIndex in 0..<ruleSet.reachableQueue.len:
        add(ruleSet.reachableQueueCertificates,
            CompilerCsgReachableQueueCertificate(queueIndex,
                                                 ruleSet.reachableQueue[queueIndex]))
        ruleSet.certificateBuildOperationCount =
            ruleSet.certificateBuildOperationCount + Int64(1)
    ruleSet.edgeRowCertificates = []
    for edgeIndex in 0..<ruleSet.edgeFrom.len:
        add(ruleSet.edgeRowCertificates,
            CompilerCsgReachableEdgeRowCertificate(edgeIndex,
                                                   ruleSet.edgeFrom[edgeIndex],
                                                   ruleSet.edgeTo[edgeIndex],
                                                   ruleSet.edgeNext[edgeIndex]))
        ruleSet.certificateBuildOperationCount =
            ruleSet.certificateBuildOperationCount + Int64(1)
    ruleSet.edgePairSlotCertificates = []
    for slotIndex in 0..<ruleSet.edgePairSlots.len:
        add(ruleSet.edgePairSlotCertificates,
            CompilerCsgReachableEdgePairSlotCertificate(slotIndex,
                                                        ruleSet.edgePairSlots[slotIndex]))
        ruleSet.certificateBuildOperationCount =
            ruleSet.certificateBuildOperationCount + Int64(1)
    ruleSet.structureContentCertificate =
        CompilerCsgReachableStructureContentCertificate(ruleSet)
    ruleSet.graphContentCertificate = CompilerCsgReachableGraphContentCertificate(ruleSet)
    if ruleSet.structureVersion <= Int64(0):
        ruleSet.structureVersion = Int64(1)
    ruleSet.structureSealedVersion = ruleSet.structureVersion
    ruleSet.structureShapeSeal = CompilerCsgReachableStructureShapeSeal(ruleSet)
    CompilerCsgReachableGraphCommitSeal(ruleSet)
    err = ""
    return true

fn CompilerCsgReachableFunctionSetValidateForTransaction(ruleSet: var CompilerCsgReachableFunctionSet,
                                                          needsSeal: var bool,
                                                          err: var str): bool =
    let structureValid = CompilerCsgReachableStructureSealValid(ruleSet)
    let graphValid = CompilerCsgReachableGraphSealValid(ruleSet)
    needsSeal = !structureValid || !graphValid
    if !structureValid:
        return CompilerCsgReachableFunctionSetValidate(ruleSet, err)
    if !graphValid:
        return CompilerCsgReachableCommittedGraphValidate(ruleSet, err)
    err = ""
    return true

fn CompilerCsgReachableFunctionSetCommitSeal(ruleSet: var CompilerCsgReachableFunctionSet) =
    if ruleSet.structureVersion <= Int64(0):
        ruleSet.structureVersion = Int64(1)
    ruleSet.structureSealedVersion = ruleSet.structureVersion
    ruleSet.structureShapeSeal = CompilerCsgReachableStructureShapeSeal(ruleSet)
    CompilerCsgReachableGraphCommitSeal(ruleSet)

fn CompilerCsgReachabilityDeltaValidate(ruleSet: var CompilerCsgReachableFunctionSet,
                                        delta: var CompilerCsgReachabilityDelta,
                                        err: var str): bool =
    if !CompilerCsgSparseIntIndexValidate(delta.functionIndex, err):
        return false
    let functionRowCount = delta.functionIndex.keys.len
    if delta.functionEdgeHeads.len != functionRowCount ||
       delta.functionMarked.len != functionRowCount ||
       delta.functionMarkQueuePositions.len != functionRowCount:
        err = Fmt" compiler csg: reachability delta function columns mismatch rows={functionRowCount} heads={delta.functionEdgeHeads.len} marked={delta.functionMarked.len} queue_positions={delta.functionMarkQueuePositions.len}"
        return false
    let functionCount = ruleSet.functionNames.len
    for row in 0..<functionRowCount:
        let functionIndex = delta.functionIndex.keys[row]
        if functionIndex < 0 || functionIndex >= functionCount:
            err = Fmt" compiler csg: reachability delta function key invalid row={row} function={functionIndex} functions={functionCount}"
            return false
        if functionIndex >= ruleSet.reachable.len ||
           functionIndex >= ruleSet.reachableRowCertificates.len ||
           ruleSet.reachableRowCertificates[functionIndex] !=
               CompilerCsgReachableRowCertificate(functionIndex,
                                                  ruleSet.reachable[functionIndex]):
            delta.probes.contentCertificateViolation = true
            err = Fmt" compiler csg: reachability delta touched reachable content certificate mismatch function={functionIndex}"
            return false
        if functionIndex >= ruleSet.edgeHeads.len ||
           functionIndex >= ruleSet.edgeHeadCertificates.len ||
           ruleSet.edgeHeadCertificates[functionIndex] !=
               CompilerCsgReachableEdgeHeadCertificate(functionIndex,
                                                       ruleSet.edgeHeads[functionIndex]):
            delta.probes.contentCertificateViolation = true
            err = Fmt" compiler csg: reachability delta touched edge-head content certificate mismatch function={functionIndex}"
            return false
        delta.probes.certificateValidationOperationCount =
            delta.probes.certificateValidationOperationCount + Int64(2)
        let queuePosition = delta.functionMarkQueuePositions[row]
        if delta.functionMarked[row]:
            if ruleSet.reachable[functionIndex] || queuePosition < 0 ||
               queuePosition >= delta.markQueue.len ||
               delta.markQueue[queuePosition] != functionIndex:
                err = Fmt" compiler csg: reachability delta mark owner invalid row={row} function={functionIndex} queue_position={queuePosition}"
                return false
        elif queuePosition != -1:
            err = Fmt" compiler csg: reachability delta unmarked row has queue position row={row} position={queuePosition}"
            return false
    if delta.closureCursor < 0 || delta.closureCursor > delta.markQueue.len:
        err = Fmt" compiler csg: reachability delta closure cursor invalid cursor={delta.closureCursor} queue={delta.markQueue.len}"
        return false
    for queuePosition in 0..<delta.markQueue.len:
        let functionIndex = delta.markQueue[queuePosition]
        let row = CompilerCsgSparseIntIndexFind(delta.functionIndex, functionIndex)
        if row < 0 || !delta.functionMarked[row] ||
           delta.functionMarkQueuePositions[row] != queuePosition:
            err = Fmt" compiler csg: reachability delta queue owner mismatch position={queuePosition} function={functionIndex} row={row}"
            return false
    if delta.probes.contentCertificateViolation:
        err = " compiler csg: reachability delta content certificate mismatch"
        return false
    if delta.probes.scopedNameHashOperationCount < Int64(0) ||
       delta.probes.scopedNameHashProbeCount < delta.probes.scopedNameHashOperationCount ||
       delta.probes.scopedNameHashMaxProbeCount < 0 ||
       delta.probes.globalNameHashOperationCount < Int64(0) ||
       delta.probes.globalNameHashProbeCount < delta.probes.globalNameHashOperationCount ||
       delta.probes.globalNameHashMaxProbeCount < 0 ||
       delta.probes.lineBinarySearchOperationCount < Int64(0) ||
       delta.probes.lineBinarySearchProbeCount < delta.probes.lineBinarySearchOperationCount ||
       delta.probes.lineBinarySearchMaxProbeCount < 0 ||
       delta.probes.resolvedCallRowVisitCount < Int64(0) ||
       delta.probes.certificateValidationOperationCount < Int64(0):
        err = " compiler csg: reachability delta counters invalid"
        return false
    let edgeCount = delta.edgeFrom.len
    if delta.edgeTo.len != edgeCount || delta.edgeNext.len != edgeCount:
        err = Fmt" compiler csg: reachability delta edge columns mismatch edges={edgeCount} to={delta.edgeTo.len} next={delta.edgeNext.len}"
        return false
    for edgeIndex in 0..<edgeCount:
        if delta.edgeFrom[edgeIndex] < 0 || delta.edgeFrom[edgeIndex] >= functionCount ||
           delta.edgeTo[edgeIndex] < 0 || delta.edgeTo[edgeIndex] >= functionCount ||
           delta.edgeNext[edgeIndex] < -1 || delta.edgeNext[edgeIndex] >= edgeCount:
            err = Fmt" compiler csg: reachability delta edge invalid edge={edgeIndex} from={delta.edgeFrom[edgeIndex]} to={delta.edgeTo[edgeIndex]} next={delta.edgeNext[edgeIndex]} functions={functionCount}"
            return false
        if !CompilerCsgReachableEdgePairValidateLookup(ruleSet,
                                                       delta.edgeFrom[edgeIndex],
                                                       delta.edgeTo[edgeIndex],
                                                       delta.probes,
                                                       err):
            return false
    var chainedEdges: int32
    for row in 0..<functionRowCount:
        let functionIndex = delta.functionIndex.keys[row]
        var edgeIndex = delta.functionEdgeHeads[row]
        if edgeIndex < -1 || edgeIndex >= edgeCount:
            err = Fmt" compiler csg: reachability delta edge head invalid row={row} head={edgeIndex} edges={edgeCount}"
            return false
        var chainCount: int32
        while edgeIndex >= 0:
            if delta.edgeFrom[edgeIndex] != functionIndex:
                err = Fmt" compiler csg: reachability delta edge owner mismatch row={row} function={functionIndex} edge={edgeIndex} actual={delta.edgeFrom[edgeIndex]}"
                return false
            chainCount = chainCount + 1
            if chainCount > edgeCount:
                err = Fmt" compiler csg: reachability delta edge cycle function={functionIndex}"
                return false
            edgeIndex = delta.edgeNext[edgeIndex]
        chainedEdges = chainedEdges + chainCount
    if chainedEdges != edgeCount:
        err = Fmt" compiler csg: reachability delta edge coverage mismatch chained={chainedEdges} edges={edgeCount}"
        return false
    err = ""
    return true

fn CompilerCsgReachabilityDeltaCapacityBytes(delta: CompilerCsgReachabilityDelta): int64 =
    return CompilerCsgSparseIntIndexCapacityBytes(delta.functionIndex) +
           CompilerCsgSequenceHeaderBytes() * Int64(7) +
           Int64(delta.functionEdgeHeads.cap +
                 delta.functionMarkQueuePositions.cap + delta.markQueue.cap +
                 delta.edgeFrom.cap + delta.edgeTo.cap + delta.edgeNext.cap) *
               CompilerCsgI32Bytes() +
           Int64(delta.functionMarked.cap) * CompilerCsgBoolBytes()

fn CompilerCsgReachabilityDeltaCommit(ruleSet: var CompilerCsgReachableFunctionSet,
                                       delta: var CompilerCsgReachabilityDelta,
                                       err: var str): bool =
    var needsSeal: bool
    if !CompilerCsgReachableFunctionSetValidateForTransaction(ruleSet,
                                                               needsSeal,
                                                               err):
        return false
    if !CompilerCsgReachabilityDeltaValidate(ruleSet, delta, err):
        return false
    # Every recoverable check ended above. The following deterministic appends
    # preserve the old edge and frontier order; allocation failure is fatal.
    for edgeIndex in 0..<delta.edgeFrom.len:
        CompilerCsgReachableAddEdge(ruleSet,
                                    delta.edgeFrom[edgeIndex],
                                    delta.edgeTo[edgeIndex])
    let trackMarkedContent = CompilerCsgReachableGraphCertificateTrackingActive(ruleSet)
    for queueIndex in 0..<delta.markQueue.len:
        let functionIndex = delta.markQueue[queueIndex]
        if ruleSet.reachable[functionIndex]:
            panic("compiler csg: validated reachability delta mark already committed")
        if functionIndex >= ruleSet.reachableRowCertificates.len ||
           ruleSet.reachableRowCertificates[functionIndex] !=
               CompilerCsgReachableRowCertificate(functionIndex,
                                                  ruleSet.reachable[functionIndex]):
            panic("compiler csg: validated reachability row changed before commit")
        let oldReachableCertificate = ruleSet.reachableRowCertificates[functionIndex]
        ruleSet.reachable[functionIndex] = true
        ruleSet.reachableCount = ruleSet.reachableCount + 1
        add(ruleSet.reachableQueue, functionIndex)
        ruleSet.reachableRowCertificates[functionIndex] =
            CompilerCsgReachableRowCertificate(functionIndex, true)
        add(ruleSet.reachableQueueCertificates,
            CompilerCsgReachableQueueCertificate(ruleSet.reachableQueue.len - 1,
                                                 functionIndex))
        if trackMarkedContent:
            CompilerCsgReachableCertificateAggregateReplace(
                ruleSet.graphContentCertificate,
                1,
                functionIndex,
                oldReachableCertificate,
                ruleSet.reachableRowCertificates[functionIndex])
            ruleSet.graphContentCertificate = ruleSet.graphContentCertificate ^
                CompilerCsgReachableCertificateAggregateRow(2,
                    ruleSet.reachableQueueCertificates.len - 1,
                    ruleSet.reachableQueueCertificates[
                        ruleSet.reachableQueueCertificates.len - 1])
        ruleSet.certificateBuildOperationCount =
            ruleSet.certificateBuildOperationCount + Int64(2)
    if delta.markQueue.len > 0:
        CompilerCsgReachableGraphMutationCommit(ruleSet)
    CompilerCsgReachabilityProbeDeltaCommit(ruleSet, delta.probes)
    CompilerCsgReachableFunctionSetCommitSeal(ruleSet)
    delta = CompilerCsgReachabilityDelta()
    err = ""
    return true

fn CompilerCsgReachableMark(ruleSet: var CompilerCsgReachableFunctionSet,
                             functionIndex: int32,
                             frontier: var int32[]) =
    if functionIndex < 0:
        return
    if functionIndex >= ruleSet.reachable.len:
        return
    if functionIndex >= ruleSet.reachableRowCertificates.len ||
       ruleSet.reachableRowCertificates[functionIndex] !=
           CompilerCsgReachableRowCertificate(functionIndex,
                                              ruleSet.reachable[functionIndex]):
        panic(Fmt"compiler csg: reachable mark certificate mismatch function={functionIndex}")
    if ruleSet.reachable[functionIndex]:
        return
    let trackContent = CompilerCsgReachableGraphCertificateTrackingActive(ruleSet)
    let oldReachableCertificate = ruleSet.reachableRowCertificates[functionIndex]
    ruleSet.reachable[functionIndex] = true
    ruleSet.reachableCount = ruleSet.reachableCount + 1
    add(ruleSet.reachableQueue, functionIndex)
    add(frontier, functionIndex)
    if functionIndex >= ruleSet.reachableRowCertificates.len:
        panic("compiler csg: reachable mark certificate row missing")
    ruleSet.reachableRowCertificates[functionIndex] =
        CompilerCsgReachableRowCertificate(functionIndex, true)
    add(ruleSet.reachableQueueCertificates,
        CompilerCsgReachableQueueCertificate(ruleSet.reachableQueue.len - 1,
                                             functionIndex))
    if trackContent:
        CompilerCsgReachableCertificateAggregateReplace(
            ruleSet.graphContentCertificate,
            1,
            functionIndex,
            oldReachableCertificate,
            ruleSet.reachableRowCertificates[functionIndex])
        ruleSet.graphContentCertificate = ruleSet.graphContentCertificate ^
            CompilerCsgReachableCertificateAggregateRow(2,
                ruleSet.reachableQueueCertificates.len - 1,
                ruleSet.reachableQueueCertificates[ruleSet.reachableQueueCertificates.len - 1])
    ruleSet.certificateBuildOperationCount =
        ruleSet.certificateBuildOperationCount + Int64(2)
    CompilerCsgReachableGraphMutationCommit(ruleSet)

@borrows
fn CompilerCsgReachableEdgePairValidateLookup(ruleSet: CompilerCsgReachableFunctionSet,
                                              fromIndex: int32,
                                              toIndex: int32,
                                              probes: var CompilerCsgReachabilityProbeDelta,
                                              err: var str): bool =
    if ruleSet.edgePairSlots.len <= 0 ||
       ruleSet.edgePairSlotCertificates.len != ruleSet.edgePairSlots.len:
        err = " compiler csg: reachable edge-pair certificate columns corrupt"
        probes.contentCertificateViolation = true
        return false
    let mask = ruleSet.edgePairSlots.len - 1
    let hash = Int64(fromIndex) * Int64(1315423911) +
               Int64(toIndex) * Int64(2654435761)
    var slot = Int32(hash & Int64(mask))
    var scanned: int32
    while scanned <= mask:
        let edgeIndexPlus1 = ruleSet.edgePairSlots[slot]
        probes.certificateValidationOperationCount =
            probes.certificateValidationOperationCount + Int64(1)
        if ruleSet.edgePairSlotCertificates[slot] !=
           CompilerCsgReachableEdgePairSlotCertificate(slot, edgeIndexPlus1):
            err = Fmt" compiler csg: reachable edge-pair slot certificate mismatch slot={slot}"
            probes.contentCertificateViolation = true
            return false
        if edgeIndexPlus1 == 0:
            err = ""
            return true
        let edgeIndex = edgeIndexPlus1 - 1
        if edgeIndex < 0 || edgeIndex >= ruleSet.edgeFrom.len ||
           edgeIndex >= ruleSet.edgeTo.len || edgeIndex >= ruleSet.edgeNext.len ||
           edgeIndex >= ruleSet.edgeRowCertificates.len:
            err = Fmt" compiler csg: reachable edge-pair row missing slot={slot} edge={edgeIndex}"
            probes.contentCertificateViolation = true
            return false
        probes.certificateValidationOperationCount =
            probes.certificateValidationOperationCount + Int64(1)
        if ruleSet.edgeRowCertificates[edgeIndex] !=
           CompilerCsgReachableEdgeRowCertificate(edgeIndex,
                                                  ruleSet.edgeFrom[edgeIndex],
                                                  ruleSet.edgeTo[edgeIndex],
                                                  ruleSet.edgeNext[edgeIndex]):
            err = Fmt" compiler csg: reachable edge row certificate mismatch edge={edgeIndex}"
            probes.contentCertificateViolation = true
            return false
        if ruleSet.edgeFrom[edgeIndex] == fromIndex && ruleSet.edgeTo[edgeIndex] == toIndex:
            err = ""
            return true
        slot = (slot + 1) & mask
        scanned = scanned + 1
    err = " compiler csg: reachable edge-pair lookup exhausted"
    return false

fn CompilerCsgReachableEdgePairSlot(ruleSet: var CompilerCsgReachableFunctionSet,
                                    fromIndex: int32,
                                    toIndex: int32): int32 =
    if ruleSet.edgePairSlots.len <= 0:
        return -1
    if ruleSet.edgePairSlotCertificates.len != ruleSet.edgePairSlots.len:
        panic("compiler csg: reachable edge pair certificate columns corrupt")
    let mask = ruleSet.edgePairSlots.len - 1
    let hash = Int64(fromIndex) * Int64(1315423911) + Int64(toIndex) * Int64(2654435761)
    var slot = Int32(hash & Int64(mask))
    var localProbeCount: int32
    ruleSet.edgePairOperationCount = ruleSet.edgePairOperationCount + Int64(1)
    while localProbeCount <= mask:
        localProbeCount = localProbeCount + 1
        ruleSet.edgePairProbeCount = ruleSet.edgePairProbeCount + Int64(1)
        let edgeIndexPlus1 = ruleSet.edgePairSlots[slot]
        if ruleSet.edgePairSlotCertificates[slot] !=
           CompilerCsgReachableEdgePairSlotCertificate(slot, edgeIndexPlus1):
            panic("compiler csg: reachable edge pair slot certificate mismatch")
        if edgeIndexPlus1 == 0:
            if localProbeCount > ruleSet.edgePairMaxProbeCount:
                ruleSet.edgePairMaxProbeCount = localProbeCount
            return slot
        let edgeIndex = edgeIndexPlus1 - 1
        if edgeIndex < 0 || edgeIndex >= ruleSet.edgeFrom.len || edgeIndex >= ruleSet.edgeTo.len:
            panic("compiler csg: reachable edge pair index corrupt")
        if edgeIndex >= ruleSet.edgeNext.len || edgeIndex >= ruleSet.edgeRowCertificates.len ||
           ruleSet.edgeRowCertificates[edgeIndex] !=
               CompilerCsgReachableEdgeRowCertificate(edgeIndex,
                                                      ruleSet.edgeFrom[edgeIndex],
                                                      ruleSet.edgeTo[edgeIndex],
                                                      ruleSet.edgeNext[edgeIndex]):
            panic("compiler csg: reachable edge row certificate mismatch")
        if ruleSet.edgeFrom[edgeIndex] == fromIndex && ruleSet.edgeTo[edgeIndex] == toIndex:
            if localProbeCount > ruleSet.edgePairMaxProbeCount:
                ruleSet.edgePairMaxProbeCount = localProbeCount
            return slot
        slot = (slot + 1) & mask
    if localProbeCount > ruleSet.edgePairMaxProbeCount:
        ruleSet.edgePairMaxProbeCount = localProbeCount
    return -1

fn CompilerCsgReachableEdgePairRehash(ruleSet: var CompilerCsgReachableFunctionSet,
                                      newCapacity: int32) =
    let trackContent = CompilerCsgReachableGraphCertificateTrackingActive(ruleSet)
    if trackContent:
        for slotIndex in 0..<ruleSet.edgePairSlotCertificates.len:
            ruleSet.graphContentCertificate = ruleSet.graphContentCertificate ^
                CompilerCsgReachableCertificateAggregateRow(5,
                    slotIndex,
                    ruleSet.edgePairSlotCertificates[slotIndex])
    var slots: int32[]
    var slotCertificates: int64[]
    for slotIndex in 0..<newCapacity:
        add(slots, 0)
        add(slotCertificates,
            CompilerCsgReachableEdgePairSlotCertificate(slotIndex, 0))
    ruleSet.edgePairSlots = slots
    ruleSet.edgePairSlotCertificates = slotCertificates
    for edgeIndex in 0..<ruleSet.edgeFrom.len:
        let slot = CompilerCsgReachableEdgePairSlot(ruleSet,
                                                    ruleSet.edgeFrom[edgeIndex],
                                                    ruleSet.edgeTo[edgeIndex])
        if slot < 0:
            panic("compiler csg: reachable edge pair rehash full")
        ruleSet.edgePairSlots[slot] = edgeIndex + 1
        ruleSet.edgePairSlotCertificates[slot] =
            CompilerCsgReachableEdgePairSlotCertificate(slot, edgeIndex + 1)
    if trackContent:
        for slotIndex in 0..<ruleSet.edgePairSlotCertificates.len:
            ruleSet.graphContentCertificate = ruleSet.graphContentCertificate ^
                CompilerCsgReachableCertificateAggregateRow(5,
                    slotIndex,
                    ruleSet.edgePairSlotCertificates[slotIndex])
    ruleSet.certificateBuildOperationCount =
        ruleSet.certificateBuildOperationCount +
            Int64(newCapacity + ruleSet.edgeFrom.len)

fn CompilerCsgReachableAddEdge(ruleSet: var CompilerCsgReachableFunctionSet,
                                fromIndex: int32,
                                toIndex: int32) =
    if fromIndex < 0 || toIndex < 0 ||
       fromIndex >= ruleSet.edgeHeads.len || toIndex >= ruleSet.functionNames.len:
        panic(Fmt"compiler csg: reachable edge endpoint out of range from={fromIndex} to={toIndex} function_count={ruleSet.functionNames.len} head_count={ruleSet.edgeHeads.len}")
    if fromIndex >= ruleSet.edgeHeadCertificates.len ||
       ruleSet.edgeHeadCertificates[fromIndex] !=
           CompilerCsgReachableEdgeHeadCertificate(fromIndex,
                                                   ruleSet.edgeHeads[fromIndex]):
        panic(Fmt"compiler csg: reachable edge-head certificate mismatch function={fromIndex}")
    let trackContent = CompilerCsgReachableGraphCertificateTrackingActive(ruleSet)
    var rehashed = false
    if ruleSet.edgePairSlots.len <= 0:
        CompilerCsgReachableEdgePairRehash(ruleSet, 64)
        rehashed = true
    if (ruleSet.edgeFrom.len + 1) * 10 >= ruleSet.edgePairSlots.len * 7:
        CompilerCsgReachableEdgePairRehash(ruleSet, ruleSet.edgePairSlots.len * 2)
        rehashed = true
    let slot = CompilerCsgReachableEdgePairSlot(ruleSet, fromIndex, toIndex)
    if slot < 0:
        panic("compiler csg: reachable edge pair index full")
    if ruleSet.edgePairSlots[slot] > 0:
        if rehashed && trackContent:
            CompilerCsgReachableGraphMutationCommit(ruleSet)
        return
    let edgeIndex = ruleSet.edgeFrom.len
    let oldHeadCertificate = ruleSet.edgeHeadCertificates[fromIndex]
    let oldSlotCertificate = ruleSet.edgePairSlotCertificates[slot]
    add(ruleSet.edgeFrom, fromIndex)
    add(ruleSet.edgeTo, toIndex)
    add(ruleSet.edgeNext, ruleSet.edgeHeads[fromIndex])
    ruleSet.edgeHeads[fromIndex] = edgeIndex
    ruleSet.edgePairSlots[slot] = edgeIndex + 1
    add(ruleSet.edgeRowCertificates,
        CompilerCsgReachableEdgeRowCertificate(edgeIndex,
                                               fromIndex,
                                               toIndex,
                                               ruleSet.edgeNext[edgeIndex]))
    if fromIndex >= ruleSet.edgeHeadCertificates.len ||
       slot >= ruleSet.edgePairSlotCertificates.len:
        panic("compiler csg: reachable edge certificate columns missing")
    ruleSet.edgeHeadCertificates[fromIndex] =
        CompilerCsgReachableEdgeHeadCertificate(fromIndex, edgeIndex)
    ruleSet.edgePairSlotCertificates[slot] =
        CompilerCsgReachableEdgePairSlotCertificate(slot, edgeIndex + 1)
    if trackContent:
        ruleSet.graphContentCertificate = ruleSet.graphContentCertificate ^
            CompilerCsgReachableCertificateAggregateRow(4,
                edgeIndex,
                ruleSet.edgeRowCertificates[edgeIndex])
        CompilerCsgReachableCertificateAggregateReplace(
            ruleSet.graphContentCertificate,
            3,
            fromIndex,
            oldHeadCertificate,
            ruleSet.edgeHeadCertificates[fromIndex])
        CompilerCsgReachableCertificateAggregateReplace(
            ruleSet.graphContentCertificate,
            5,
            slot,
            oldSlotCertificate,
            ruleSet.edgePairSlotCertificates[slot])
    ruleSet.certificateBuildOperationCount =
        ruleSet.certificateBuildOperationCount + Int64(3)
    CompilerCsgReachableGraphMutationCommit(ruleSet)

fn CompilerCsgReachableCount(ruleSet: var CompilerCsgReachableFunctionSet): int32 =
    return ruleSet.reachableCount

@borrows
fn CompilerCsgReachableTargetIsBuiltinCall(targetRaw: str): bool =
    let target = CompilerCsgFunctionTailName(targetRaw)
    if target == "Int32" || target == "int32":
        return true
    if target == "Int64" || target == "int64":
        return true
    if target == "UInt8" || target == "uint8":
        return true
    if target == "UInt32" || target == "uint32":
        return true
    if target == "UInt64" || target == "uint64":
        return true
    if target == "Bool" || target == "bool":
        return true
    if target == "Char" || target == "char":
        return true
    if target == "Str" || target == "str":
        return true
    if target == "Add" || target == "add":
        return true
    if target == "setLen" || target == "reserve" || target == "clear":
        return true
    if target == "len" || target == "Len":
        return true
    if target == "NewStringAlloc" || target == "NewStringCopy":
        return true
    if target == "StrDataPtr":
        return true
    if target == "RawmemAsVoid" || target == "RawmemCopy" || target == "RawmemSet":
        return true
    if target == "RawmemWriteI8" || target == "RawmemWriteChar":
        return true
    if target == "memRetain" || target == "memRelease":
        return true
    return false

fn CompilerCsgClearTypedIrForReachabilityPreservingTypeInfo(ir: var texpr.TypedExprIr) =
    # combo C Phase2: clear the 85 IR-data SoA columns (producers write only SoA;
    # the old AoS functions/nodes/statements arrays are removed in Phase2). This
    # restores the intended semantic — between reachability rounds the live SoA IR
    # data is reset while type-info metadata below is preserved.
    texpr.TypedExprIrClearSoAIRData(ir)
    ir.coldCsgTypeRows = []
    ir.coldCsgStatementRows = []
    ir.globalSourcePaths = []
    ir.globalNames = []
    ir.globalTypes = []
    ir.globalProducerSourceIndexes = []
    ir.globalDeclarationSourceLocalRows = []
    ir.globalInitValues = []
    ir.localBindingSourcePaths = []
    ir.localBindingFunctionNames = []
    ir.localBindingLineNumbers = []
    ir.localBindingNames = []
    ir.localBindingTypes = []
    # Keep importc, type layout, type field, alias, and enum metadata across reachability rounds.
    ir.sourceContextIndexSourcePaths = []
    ir.sourceContextIndexBucketHeads = []
    ir.sourceContextIndexEntryNext = []
    ir.sourceContextIndexEntryIndexes = []

fn CompilerCsgReachableFunctionIndexForProfileLine(ruleSet: var CompilerCsgReachableFunctionSet,
                                                    profileIndex: int32,
                                                    lineNumber: int32): int32 =
    if lineNumber <= 0:
        return -1
    if profileIndex < 0 ||
       profileIndex >= ruleSet.profileFunctionStarts.len ||
       profileIndex >= ruleSet.profileFunctionCounts.len ||
       profileIndex >= ruleSet.profileLineIndexProven.len:
        panic(Fmt"compiler csg: reachable function profile line index out of range profile_index={profileIndex} starts={ruleSet.profileFunctionStarts.len} counts={ruleSet.profileFunctionCounts.len} proofs={ruleSet.profileLineIndexProven.len}")
    if !ruleSet.profileLineIndexProven[profileIndex]:
        panic(Fmt"compiler csg: reachable function line index not proven profile_index={profileIndex}")
    let start = ruleSet.profileFunctionStarts[profileIndex]
    let count = ruleSet.profileFunctionCounts[profileIndex]
    if start < 0 || count <= 0:
        return -1
    if start > ruleSet.startLines.len - count ||
       start > ruleSet.endLines.len - count:
        panic(Fmt"compiler csg: reachable function line index columns corrupt profile_index={profileIndex} start={start} count={count} starts={ruleSet.startLines.len} ends={ruleSet.endLines.len}")
    ruleSet.lineBinarySearchOperationCount = ruleSet.lineBinarySearchOperationCount + Int64(1)
    var low = start
    var high = start + count
    var localProbeCount: int32
    while low < high:
        localProbeCount = localProbeCount + 1
        ruleSet.lineBinarySearchProbeCount = ruleSet.lineBinarySearchProbeCount + Int64(1)
        let mid = low + (high - low) / 2
        if mid >= ruleSet.startLines.len || ruleSet.startLines[mid] > lineNumber:
            high = mid
        else:
            low = mid + 1
    if localProbeCount > ruleSet.lineBinarySearchMaxProbeCount:
        ruleSet.lineBinarySearchMaxProbeCount = localProbeCount
    let candidate = low - 1
    if candidate >= start &&
       candidate < start + count &&
       candidate < ruleSet.startLines.len &&
       candidate < ruleSet.endLines.len &&
       lineNumber >= ruleSet.startLines[candidate] &&
       lineNumber <= ruleSet.endLines[candidate]:
        return candidate
    return -1

@borrows
fn CompilerCsgReachableFunctionIndexForLine(ruleSet: var CompilerCsgReachableFunctionSet,
                                             sourcePathRaw: str,
                                             lineNumber: int32): int32 =
    let profileIndex = CompilerCsgReachableProfileIndex(ruleSet, sourcePathRaw)
    if profileIndex < 0:
        return -1
    return CompilerCsgReachableFunctionIndexForProfileLine(ruleSet,
                                                           profileIndex,
                                                           lineNumber)

@borrows
fn CompilerCsgReachableFindFunction(ruleSet: var CompilerCsgReachableFunctionSet,
                                     sourcePathRaw: str,
                                     functionNameRaw: str): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = CompilerCsgFunctionTailName(functionNameRaw)
    if functionName == "":
        return -1
    var foundCount: int32
    let found = CompilerCsgReachableNameIndexHead(ruleSet,
                                                  sourcePath,
                                                  functionName,
                                                  foundCount)
    if foundCount > 1:
        return -2
    return found

@borrows
fn CompilerCsgReachableNameIndexLookupDelta(index: CompilerCsgNameAdjacencyIndex,
                                             profileIndex: int32,
                                             functionName: str,
                                             globalIndex: bool,
                                             delta: var CompilerCsgReachabilityProbeDelta,
                                             matchCount: var int32): int32 =
    if index.slots.len <= 0:
        matchCount = 0
        return -1
    if index.slotCertificates.len != index.slots.len:
        delta.contentCertificateViolation = true
        matchCount = 0
        return -1
    let mask = index.slots.len - 1
    var slot = CompilerCsgReachableNameHash(profileIndex, functionName) & mask
    var localProbeCount: int32
    if globalIndex:
        delta.globalNameHashOperationCount = delta.globalNameHashOperationCount + Int64(1)
    else:
        delta.scopedNameHashOperationCount = delta.scopedNameHashOperationCount + Int64(1)
    while localProbeCount <= mask:
        localProbeCount = localProbeCount + 1
        if globalIndex:
            delta.globalNameHashProbeCount = delta.globalNameHashProbeCount + Int64(1)
        else:
            delta.scopedNameHashProbeCount = delta.scopedNameHashProbeCount + Int64(1)
        let entryIndexPlus1 = index.slots[slot]
        delta.certificateValidationOperationCount =
            delta.certificateValidationOperationCount + Int64(1)
        if index.slotCertificates[slot] !=
           CompilerCsgReachableNameSlotCertificate(slot, entryIndexPlus1):
            delta.contentCertificateViolation = true
            matchCount = 0
            return -1
        if entryIndexPlus1 == 0:
            if globalIndex:
                if localProbeCount > delta.globalNameHashMaxProbeCount:
                    delta.globalNameHashMaxProbeCount = localProbeCount
            elif localProbeCount > delta.scopedNameHashMaxProbeCount:
                delta.scopedNameHashMaxProbeCount = localProbeCount
            matchCount = 0
            return -1
        let entryIndex = entryIndexPlus1 - 1
        if entryIndex < 0 ||
           entryIndex >= index.profileIndexes.len ||
           entryIndex >= index.functionNames.len ||
           entryIndex >= index.heads.len ||
           entryIndex >= index.tails.len || entryIndex >= index.counts.len ||
           entryIndex >= index.keyCertificates.len:
            delta.contentCertificateViolation = true
            matchCount = 0
            return -1
        delta.certificateValidationOperationCount =
            delta.certificateValidationOperationCount + Int64(1)
        if index.keyCertificates[entryIndex] !=
           CompilerCsgReachableNameKeyCertificate(index.profileIndexes[entryIndex],
                                                  index.functionNames[entryIndex],
                                                  index.heads[entryIndex],
                                                  index.tails[entryIndex],
                                                  index.counts[entryIndex]):
            delta.contentCertificateViolation = true
            matchCount = 0
            return -1
        if index.profileIndexes[entryIndex] == profileIndex &&
           index.functionNames[entryIndex] == functionName:
            if globalIndex:
                if localProbeCount > delta.globalNameHashMaxProbeCount:
                    delta.globalNameHashMaxProbeCount = localProbeCount
            elif localProbeCount > delta.scopedNameHashMaxProbeCount:
                delta.scopedNameHashMaxProbeCount = localProbeCount
            matchCount = index.counts[entryIndex]
            return index.heads[entryIndex]
        slot = (slot + 1) & mask
    if globalIndex:
        if localProbeCount > delta.globalNameHashMaxProbeCount:
            delta.globalNameHashMaxProbeCount = localProbeCount
    elif localProbeCount > delta.scopedNameHashMaxProbeCount:
        delta.scopedNameHashMaxProbeCount = localProbeCount
    matchCount = 0
    return -1

fn CompilerCsgReachableNameIndexHeadDelta(ruleSet: var CompilerCsgReachableFunctionSet,
                                          sourcePath: str,
                                          functionName: str,
                                          delta: var CompilerCsgReachabilityProbeDelta,
                                          matchCount: var int32): int32 =
    if sourcePath == "":
        return CompilerCsgReachableNameIndexLookupDelta(ruleSet.globalFunctionNames,
                                                        -1,
                                                        functionName,
                                                        true,
                                                        delta,
                                                        matchCount)
    let profileIndex = CompilerCsgReachableProfileIndex(ruleSet, sourcePath)
    if profileIndex < 0:
        matchCount = 0
        return profileIndex
    return CompilerCsgReachableNameIndexLookupDelta(ruleSet.scopedFunctionNames,
                                                    profileIndex,
                                                    functionName,
                                                    false,
                                                    delta,
                                                    matchCount)

fn CompilerCsgReachableFindFunctionDelta(ruleSet: var CompilerCsgReachableFunctionSet,
                                         sourcePathRaw: str,
                                         functionNameRaw: str,
                                         delta: var CompilerCsgReachabilityProbeDelta): int32 =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let functionName = CompilerCsgFunctionTailName(functionNameRaw)
    if functionName == "":
        return -1
    var foundCount: int32
    let found = CompilerCsgReachableNameIndexHeadDelta(ruleSet,
                                                       sourcePath,
                                                       functionName,
                                                       delta,
                                                       foundCount)
    if foundCount > 1:
        return -2
    if found >= 0:
        if found >= ruleSet.functionRowCertificates.len:
            delta.contentCertificateViolation = true
            return -1
        delta.certificateValidationOperationCount =
            delta.certificateValidationOperationCount + Int64(1)
        if ruleSet.functionRowCertificates[found] !=
           CompilerCsgReachableFunctionRowCertificate(ruleSet, found):
            delta.contentCertificateViolation = true
            return -1
    return found

fn CompilerCsgReachableFunctionIndexForProfileLineDelta(ruleSet: var CompilerCsgReachableFunctionSet,
                                                         profileIndex: int32,
                                                         lineNumber: int32,
                                                         delta: var CompilerCsgReachabilityProbeDelta): int32 =
    if lineNumber <= 0:
        return -1
    if profileIndex < 0 ||
       profileIndex >= ruleSet.profileFunctionStarts.len ||
       profileIndex >= ruleSet.profileFunctionCounts.len ||
       profileIndex >= ruleSet.profileLineIndexProven.len:
        panic(Fmt"compiler csg: reachable delta profile line index out of range profile_index={profileIndex}")
    if profileIndex >= ruleSet.profileRowCertificates.len:
        delta.contentCertificateViolation = true
        return -1
    delta.certificateValidationOperationCount =
        delta.certificateValidationOperationCount + Int64(1)
    if ruleSet.profileRowCertificates[profileIndex] !=
       CompilerCsgReachableProfileRowCertificate(ruleSet, profileIndex):
        delta.contentCertificateViolation = true
        return -1
    if !ruleSet.profileLineIndexProven[profileIndex]:
        panic(Fmt"compiler csg: reachable delta line index not proven profile_index={profileIndex}")
    let start = ruleSet.profileFunctionStarts[profileIndex]
    let count = ruleSet.profileFunctionCounts[profileIndex]
    if start < 0 || count <= 0:
        return -1
    if start > ruleSet.startLines.len - count || start > ruleSet.endLines.len - count:
        panic(Fmt"compiler csg: reachable delta line columns corrupt profile_index={profileIndex}")
    delta.lineBinarySearchOperationCount = delta.lineBinarySearchOperationCount + Int64(1)
    var low = start
    var high = start + count
    var localProbeCount: int32
    while low < high:
        localProbeCount = localProbeCount + 1
        delta.lineBinarySearchProbeCount = delta.lineBinarySearchProbeCount + Int64(1)
        let mid = low + (high - low) / 2
        if mid < 0 || mid >= ruleSet.functionRowCertificates.len:
            delta.contentCertificateViolation = true
            return -1
        delta.certificateValidationOperationCount =
            delta.certificateValidationOperationCount + Int64(1)
        if ruleSet.functionRowCertificates[mid] !=
           CompilerCsgReachableFunctionRowCertificate(ruleSet, mid):
            delta.contentCertificateViolation = true
            return -1
        if mid >= ruleSet.startLines.len || ruleSet.startLines[mid] > lineNumber:
            high = mid
        else:
            low = mid + 1
    if localProbeCount > delta.lineBinarySearchMaxProbeCount:
        delta.lineBinarySearchMaxProbeCount = localProbeCount
    let candidate = low - 1
    if candidate >= start && candidate < start + count:
        if candidate >= ruleSet.functionRowCertificates.len:
            delta.contentCertificateViolation = true
            return -1
        delta.certificateValidationOperationCount =
            delta.certificateValidationOperationCount + Int64(1)
        if ruleSet.functionRowCertificates[candidate] !=
           CompilerCsgReachableFunctionRowCertificate(ruleSet, candidate):
            delta.contentCertificateViolation = true
            return -1
    if candidate >= start &&
       candidate < start + count &&
       candidate < ruleSet.startLines.len &&
       candidate < ruleSet.endLines.len &&
       lineNumber >= ruleSet.startLines[candidate] &&
       lineNumber <= ruleSet.endLines[candidate]:
        return candidate
    return -1

@borrows
fn CompilerCsgReachableFunctionIndexForLineDelta(ruleSet: var CompilerCsgReachableFunctionSet,
                                                  sourcePathRaw: str,
                                                  lineNumber: int32,
                                                  delta: var CompilerCsgReachabilityProbeDelta): int32 =
    let profileIndex = CompilerCsgReachableProfileIndex(ruleSet, sourcePathRaw)
    if profileIndex < 0:
        return -1
    return CompilerCsgReachableFunctionIndexForProfileLineDelta(ruleSet,
                                                                profileIndex,
                                                                lineNumber,
                                                                delta)

@borrows
fn CompilerCsgReachableBuiltinNameMayShadowFunction(tailName: str): bool =
    if tailName == "Add" || tailName == "add":
        return true
    if tailName == "setLen" || tailName == "reserve" || tailName == "clear":
        return true
    if tailName == "len" || tailName == "Len":
        return true
    if tailName == "NewStringAlloc" || tailName == "NewStringCopy":
        return true
    if tailName == "StrDataPtr":
        return true
    if tailName == "RawmemAsVoid" || tailName == "RawmemCopy" || tailName == "RawmemSet":
        return true
    if tailName == "RawmemWriteI8" || tailName == "RawmemWriteChar":
        return true
    if tailName == "memRetain" || tailName == "memRelease":
        return true
    return false

# builtin 归类名遮蔽真函数时是真调用边：后端对 callee 体发真 bl。可达剪枝
# 无条件跳过会把 callee 体剪出 typed 闭包 → lowering 表无此函数 → bl 永不回填
# (bl-self, imm26=0, census 不可见死循环)。只有当该名在函数集中解析不到任何
# 定义 (真 always-inline builtin: len/add/casts …) 才跳过。跳过 ⇔ 站点自身的
# FindFunction 也必失败，un-skip 后必然标记成功，不引入静默 no-op。
fn CompilerCsgReachableBuiltinCallSkip(ruleSet: var CompilerCsgReachableFunctionSet,
                                       targetSourcePath: str,
                                       targetNameRaw: str): bool =
    let tailName = CompilerCsgFunctionTailName(targetNameRaw)
    if parser.ParserCallExprUsesDedicatedNormalization(tailName):
        return true
    if !CompilerCsgReachableTargetIsBuiltinCall(tailName):
        return false
    if !CompilerCsgReachableBuiltinNameMayShadowFunction(tailName):
        return true
    let idx = CompilerCsgReachableFindFunction(ruleSet, targetSourcePath, tailName)
    if idx >= 0 || idx == -2:
        return false
    return true

fn CompilerCsgReachableBuiltinCallSkipDelta(ruleSet: var CompilerCsgReachableFunctionSet,
                                            targetSourcePath: str,
                                            targetNameRaw: str,
                                            delta: var CompilerCsgReachabilityDelta): bool =
    let tailName = CompilerCsgFunctionTailName(targetNameRaw)
    if parser.ParserCallExprUsesDedicatedNormalization(tailName):
        return true
    if !CompilerCsgReachableTargetIsBuiltinCall(tailName):
        return false
    if !CompilerCsgReachableBuiltinNameMayShadowFunction(tailName):
        return true
    let idx = CompilerCsgReachableFindFunctionDelta(ruleSet,
                                                    targetSourcePath,
                                                    tailName,
                                                    delta.probes)
    return idx < 0 && idx != -2

# &fn / ptr(&fn) 作调用实参的函数取址是真实可达边 (实参位, 非调用位): 地址装进
# task/callback 后由运行时间接调用。call-edge 扫描只看 callTarget, export-roots
# 预剪枝闭包会把"只被取址"的函数整个裁掉 → lowering 符号表缺失 →
# PrimaryFunctionTargetIndex=-1 → addressPassKind=-8 → bail=2408 (provider
# runtime/program_support 的 cheng_thread_entry_runtime 案, findings wave-35;
# seed 六修 CALL_PTR 只覆盖调用位, 实参位取址在剪枝层漏边)。提取语法镜像
# lowering_plan.LoweringFunctionAddressArgName, 两处必须同步演进。
@borrows
fn CompilerCsgReachableExprSelected(expr: parser.NormalizedExpr,
                                     ruleSet: var CompilerCsgReachableFunctionSet): bool =
    if !ruleSet.active:
        return true
    let functionIndex = CompilerCsgReachableFunctionIndexForLine(ruleSet,
                                                                 expr.sourcePath,
                                                                 expr.lineNumber)
    if functionIndex < 0:
        return false
    if functionIndex >= ruleSet.reachable.len:
        return false
    return ruleSet.reachable[functionIndex]

@borrows
fn CompilerCsgReachableLineSelected(ruleSet: var CompilerCsgReachableFunctionSet,
                                    sourcePath: str,
                                    lineNumber: int32): bool =
    if !ruleSet.active:
        return true
    let functionIndex = CompilerCsgReachableFunctionIndexForLine(ruleSet, sourcePath, lineNumber)
    if functionIndex < 0:
        return false
    if functionIndex >= ruleSet.reachable.len:
        return false
    return ruleSet.reachable[functionIndex]

fn CompilerCsgReachableLineFilterForSourceInto(ruleSet: var CompilerCsgReachableFunctionSet,
                                               sourcePathRaw: str,
                                               out: var CompilerCsgReachableFunctionSet) =
    out = CompilerCsgReachableFunctionSet()
    out.active = ruleSet.active
    if !ruleSet.active:
        return
    let profileIndex = CompilerCsgReachableProfileIndex(ruleSet, sourcePathRaw)
    if profileIndex < 0 || profileIndex >= ruleSet.profileFunctionStarts.len ||
       profileIndex >= ruleSet.profileFunctionCounts.len:
        panic(Fmt"compiler csg: reachable line filter profile missing source={sourcePathRaw} profile_index={profileIndex}")
    let functionStart = ruleSet.profileFunctionStarts[profileIndex]
    let functionEnd = functionStart + ruleSet.profileFunctionCounts[profileIndex]
    out.profileSourceIndex = CompilerCsgSourcePathIndexInitLike(ruleSet.profileSourceIndex, 8)
    var filterIndexErr: str
    if !CompilerCsgSourcePathIndexRegister(out.profileSourceIndex,
                                           sourcePathRaw,
                                           0,
                                           filterIndexErr):
        panic(filterIndexErr)
    add(out.profileFunctionStarts, 0)
    add(out.profileFunctionCounts, functionEnd - functionStart)
    add(out.profileLineIndexProven, true)
    for i in functionStart..<functionEnd:
        if i >= ruleSet.sourcePaths.len ||
           i >= ruleSet.startLines.len ||
           i >= ruleSet.endLines.len ||
           i >= ruleSet.reachable.len:
            panic(Fmt"compiler csg: reachable line filter adjacency columns corrupt function_index={i}")
        add(out.sourcePaths, share(ruleSet.sourcePaths[i]))
        add(out.functionNames, share(ruleSet.functionNames[i]))
        add(out.startLines, ruleSet.startLines[i])
        add(out.endLines, ruleSet.endLines[i])
        add(out.reachable, ruleSet.reachable[i])

# Same shape as CompilerCsgReachableLineFilterForSourceInto, but a function's
# lines are selected only while it is reachable AND not yet edge-processed;
# `outSetIndexes` returns the reachable-set indexes of the selected functions so
# the caller can mark them processed after collecting their call edges once.
fn CompilerCsgReachableLineFilterUnprocessedForSourceInto(ruleSet: var CompilerCsgReachableFunctionSet,
                                                           sourcePathRaw: str,
                                                           processedFunctions: bool[],
                                                           processedJournal: CompilerCsgBoolJournal,
                                                           delta: var CompilerCsgReachabilityDelta,
                                                           out: var CompilerCsgReachableFunctionSet,
                                                           outSetIndexes: var int32[]) =
    out = CompilerCsgReachableFunctionSet()
    out.active = ruleSet.active
    outSetIndexes = []
    if !ruleSet.active:
        return
    let profileIndex = CompilerCsgReachableProfileIndex(ruleSet, sourcePathRaw)
    if profileIndex < 0 || profileIndex >= ruleSet.profileFunctionStarts.len ||
       profileIndex >= ruleSet.profileFunctionCounts.len:
        panic(Fmt"compiler csg: reachable unprocessed line filter profile missing source={sourcePathRaw} profile_index={profileIndex}")
    let functionStart = ruleSet.profileFunctionStarts[profileIndex]
    let functionEnd = functionStart + ruleSet.profileFunctionCounts[profileIndex]
    out.profileSourceIndex = CompilerCsgSourcePathIndexInitLike(ruleSet.profileSourceIndex, 8)
    var filterIndexErr: str
    if !CompilerCsgSourcePathIndexRegister(out.profileSourceIndex,
                                           sourcePathRaw,
                                           0,
                                           filterIndexErr):
        panic(filterIndexErr)
    add(out.profileFunctionStarts, 0)
    add(out.profileFunctionCounts, functionEnd - functionStart)
    add(out.profileLineIndexProven, true)
    for i in functionStart..<functionEnd:
        if i >= ruleSet.sourcePaths.len ||
           i >= ruleSet.startLines.len ||
           i >= ruleSet.endLines.len ||
           i >= ruleSet.reachable.len:
            panic(Fmt"compiler csg: reachable unprocessed line filter adjacency columns corrupt function_index={i}")
        var selected = CompilerCsgReachabilityDeltaIsReachable(ruleSet, delta, i)
        if selected && CompilerCsgBoolJournalGet(processedFunctions,
                                                  processedJournal,
                                                  i):
            selected = false
        add(out.sourcePaths, share(ruleSet.sourcePaths[i]))
        add(out.functionNames, share(ruleSet.functionNames[i]))
        add(out.startLines, ruleSet.startLines[i])
        add(out.endLines, ruleSet.endLines[i])
        add(out.reachable, selected)
        if selected:
            add(outSetIndexes, i)

fn CompilerCsgReachableSourceExprSelected(expr: parser.NormalizedExpr,
                                           ruleSet: var CompilerCsgReachableFunctionSet): bool =
    if !ruleSet.active:
        return true
    return CompilerCsgReachableHasSource(ruleSet, expr.sourcePath)

@borrows
fn CompilerCsgParsePositiveInt32Setting(raw: str,
                                         value: var int32): bool =
    value = 0
    let text = strutil.Strip(raw)
    if len(text) <= 0:
        return true
    var parsed: int64
    for i in 0..<len(text):
        let ch = text[i]
        if ch < '0' || ch > '9':
            return false
        parsed = parsed * int64(10) + int64(int32(ch) - int32('0'))
        if parsed > int64(2147483647):
            return false
    if parsed <= int64(0):
        return false
    value = int32(parsed)
    return true

fn CompilerCsgReadTypedIrBatchLimit(limit: var int32,
                                     err: var str): bool =
    limit = CompilerCsgTypedIrReachableBatchFunctionLimit
    let raw = os.GetEnv("CHENG_CSG_TYPED_IR_BATCH_LIMIT")
    var parsed: int32
    if !CompilerCsgParsePositiveInt32Setting(raw, parsed):
        err = Fmt" compiler csg: invalid CHENG_CSG_TYPED_IR_BATCH_LIMIT={strutil.Strip(raw)}"
        return false
    if parsed > 0:
        limit = parsed
    return true

fn CompilerCsgReachableSourceLookupInit(minCap: int32): CompilerCsgReachableSourceLookup =
    var lookup: CompilerCsgReachableSourceLookup
    var cap: int32 = 32
    while cap < minCap:
        cap = cap * 2
    for i in 0..<cap:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        add(lookup.slotHeads, 0)
    return lookup

fn CompilerCsgReachableSourceLookupInsert(lookup: var CompilerCsgReachableSourceLookup,
                                            sourcePath: str) =
    if sourcePath == "":
        lookup.emptySeen = true
        return
    if lookup.slotHeads.len <= 0:
        return
    let sourceHash = parser.ParserTextLookupContentHash(sourcePath)
    let slot = Int32(Int64(sourceHash) & Int64(lookup.slotHeads.len - 1))
    var itemIndex = lookup.slotHeads[slot] - 1
    while itemIndex >= 0:
        if itemIndex < lookup.sourcePaths.len &&
           itemIndex < lookup.sourceHashes.len &&
           lookup.sourceHashes[itemIndex] == sourceHash &&
           lookup.sourcePaths[itemIndex] == sourcePath:
            return
        if itemIndex >= lookup.nextIndexes.len:
            return
        itemIndex = lookup.nextIndexes[itemIndex] - 1
    add(lookup.sourcePaths, sourcePath)
    add(lookup.sourceHashes, sourceHash)
    add(lookup.nextIndexes, lookup.slotHeads[slot])
    lookup.slotHeads[slot] = lookup.sourcePaths.len

@borrows
fn CompilerCsgReachableSourceLookupExact(lookup: var CompilerCsgReachableSourceLookup,
                                          sourcePath: str): bool =
    if sourcePath == "":
        return lookup.emptySeen
    if lookup.slotHeads.len <= 0:
        return false
    let sourceHash = parser.ParserTextLookupContentHash(sourcePath)
    let slot = Int32(Int64(sourceHash) & Int64(lookup.slotHeads.len - 1))
    var itemIndex = lookup.slotHeads[slot] - 1
    while itemIndex >= 0:
        if itemIndex < lookup.sourcePaths.len &&
           itemIndex < lookup.sourceHashes.len &&
           lookup.sourceHashes[itemIndex] == sourceHash &&
           lookup.sourcePaths[itemIndex] == sourcePath:
            return true
        if itemIndex >= lookup.nextIndexes.len:
            return false
        itemIndex = lookup.nextIndexes[itemIndex] - 1
    return false

fn CompilerCsgReachableSourceLookupBuild(ruleSet: var CompilerCsgReachableFunctionSet): CompilerCsgReachableSourceLookup =
    var lookup = CompilerCsgReachableSourceLookupInit(ruleSet.sourcePaths.len * 2 + 8)
    for i in 0..<ruleSet.sourcePaths.len:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if i >= ruleSet.reachable.len:
            continue
        if !ruleSet.reachable[i]:
            continue
        let sourcePath = parser.ParserNormalizePath(ruleSet.sourcePaths[i])
        CompilerCsgReachableSourceLookupInsert(lookup, sourcePath)
    return lookup

@borrows
fn CompilerCsgReachableSourceLookupContains(ruleSet: var CompilerCsgReachableFunctionSet,
                                             reachableSources: var CompilerCsgReachableSourceLookup,
                                             equivalentHits: var CompilerCsgReachableSourceLookup,
                                             equivalentMisses: var CompilerCsgReachableSourceLookup,
                                             sourcePathRaw: str): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    if CompilerCsgReachableSourceLookupExact(reachableSources, sourcePath):
        return true
    if CompilerCsgReachableSourceLookupExact(equivalentHits, sourcePath):
        return true
    if CompilerCsgReachableSourceLookupExact(equivalentMisses, sourcePath):
        return false
    if CompilerCsgReachableHasSource(ruleSet, sourcePath):
        CompilerCsgReachableSourceLookupInsert(equivalentHits, sourcePath)
        return true
    CompilerCsgReachableSourceLookupInsert(equivalentMisses, sourcePath)
    return false

fn CompilerCsgRefreshExprLayerMetadata(
        exprLayer: var parser.NormalizedExprLayer,
        ruleSet: var CompilerCsgReachableFunctionSet) =
    # Resolve every row through the sealed profile source index and retain only
    # the exact int32 producer identity locally.  No borrowed path text enters
    # an owning lookup, and counting stays linear in rows plus source identities.
    var sourceSeen: bool[]
    setLen(sourceSeen, ruleSet.profileFunctionStarts.len)
    var sourceCount: int32
    for exprIndex in 0..<exprLayer.exprs.len:
        if exprIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let sourceIndex = CompilerCsgReachableProfileIndex(
            ruleSet, exprLayer.exprs[exprIndex].sourcePath)
        if sourceIndex < 0 || sourceIndex >= sourceSeen.len:
            panic(Fmt"compiler csg: expr layer producer source identity missing row={exprIndex} source={exprLayer.exprs[exprIndex].sourcePath} index={sourceIndex} count={sourceSeen.len}")
        if !sourceSeen[sourceIndex]:
            sourceSeen[sourceIndex] = true
            sourceCount = sourceCount + 1
    exprLayer.sourceCount = sourceCount
    if exprLayer.exprs.len <= 0:
        exprLayer.questionResidualCount = 0

fn CompilerCsgPruneExprLayerForReachableFunctions(exprLayer: var parser.NormalizedExprLayer,
                                                   ruleSet: var CompilerCsgReachableFunctionSet) =
    if !ruleSet.active:
        return
    var kept: parser.NormalizedExpr[]
    for i in 0..<exprLayer.exprs.len:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if CompilerCsgReachableExprSelected(exprLayer.exprs[i], ruleSet):
            add(kept, share(exprLayer.exprs[i]))
    exprLayer.exprs = kept
    CompilerCsgClearExprLayerLookup(exprLayer)
    CompilerCsgRefreshExprLayerMetadata(exprLayer, ruleSet)

fn CompilerCsgPruneExprLayerForReachableSources(exprLayer: var parser.NormalizedExprLayer,
                                                 ruleSet: var CompilerCsgReachableFunctionSet) =
    if !ruleSet.active:
        return
    var reachableSources = CompilerCsgReachableSourceLookupBuild(ruleSet)
    var equivalentHits = CompilerCsgReachableSourceLookupInit(32)
    var equivalentMisses = CompilerCsgReachableSourceLookupInit(32)
    # copy-on-first-prune: source-level selection deselects nothing for the
    # common per-source closure walk, so allocating a full kept duplicate per
    # source is pure churn — only materialize kept once a deselected expr shows.
    var kept: parser.NormalizedExpr[]
    var prunedAny = false
    for i in 0..<exprLayer.exprs.len:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if CompilerCsgReachableSourceLookupContains(ruleSet,
                                                     reachableSources,
                                                     equivalentHits,
                                                     equivalentMisses,
                                                     exprLayer.exprs[i].sourcePath):
            if prunedAny:
                add(kept, share(exprLayer.exprs[i]))
        elif !prunedAny:
            prunedAny = true
            for j in 0..<i:
                if j % 4096 == 0:
                    os.ProcessResourceGuardCheck()
                add(kept, share(exprLayer.exprs[j]))
    if prunedAny:
        exprLayer.exprs = kept
    CompilerCsgClearExprLayerLookup(exprLayer)
    CompilerCsgRefreshExprLayerMetadata(exprLayer, ruleSet)

fn CompilerCsgEnsureBoolLen(items: var bool[], targetLen: int32) =
    while items.len < targetLen:
        add(items, false)

fn CompilerCsgReachableFilterArraysUnprocessed(ruleSet: var CompilerCsgReachableFunctionSet,
                                               processedFunctions: var bool[],
                                               reachableCursor: var int32,
                                               maxFunctionCount: int32,
                                               sourcePaths: var str[],
                                               functionNames: var str[],
                                               startLines: var int32[],
                                               functionIndexes: var int32[],
                                               err: var str): bool =
    var nextReachableCursor = reachableCursor
    var nextSourcePaths: str[]
    var nextFunctionNames: str[]
    var nextStartLines: int32[]
    var nextFunctionIndexes: int32[]
    var limit = maxFunctionCount
    if limit <= 0:
        limit = 2147483647
    var candidateCount = ruleSet.functionNames.len
    if ruleSet.active:
        candidateCount = ruleSet.reachableQueue.len
    if nextReachableCursor < 0 || nextReachableCursor > candidateCount:
        err = Fmt" compiler csg: typed ir reachable cursor invalid cursor={nextReachableCursor} count={candidateCount}"
        return false
    while nextReachableCursor < candidateCount && nextFunctionIndexes.len < limit:
        if nextReachableCursor % 4096 == 0:
            os.ProcessResourceGuardCheck()
        var i = nextReachableCursor
        if ruleSet.active:
            i = ruleSet.reachableQueue[nextReachableCursor]
        if i < 0 || i >= ruleSet.functionNames.len:
            err = Fmt" compiler csg: typed ir reachable queue index out of range cursor={nextReachableCursor} index={i} function_count={ruleSet.functionNames.len}"
            return false
        if i >= ruleSet.sourcePaths.len || i >= ruleSet.startLines.len:
            err = Fmt" compiler csg: typed ir reachable function columns corrupt cursor={nextReachableCursor} index={i} function_count={ruleSet.functionNames.len} source_count={ruleSet.sourcePaths.len} start_line_count={ruleSet.startLines.len}"
            return false
        nextReachableCursor = nextReachableCursor + 1
        if i < processedFunctions.len && processedFunctions[i]:
            continue
        add(nextSourcePaths, share(ruleSet.sourcePaths[i]))
        add(nextFunctionNames, share(ruleSet.functionNames[i]))
        add(nextStartLines, ruleSet.startLines[i])
        add(nextFunctionIndexes, i)
    CompilerCsgEnsureBoolLen(processedFunctions, ruleSet.functionNames.len)
    reachableCursor = nextReachableCursor
    sourcePaths = nextSourcePaths
    functionNames = nextFunctionNames
    startLines = nextStartLines
    functionIndexes = nextFunctionIndexes
    err = ""
    return true

@borrows
fn CompilerCsgMarkProcessedFunctionIndexes(processedFunctions: var bool[],
                                           functionIndexes: int32[]) =
    for i in 0..<functionIndexes.len:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let index = functionIndexes[i]
        if index < 0:
            continue
        CompilerCsgEnsureBoolLen(processedFunctions, index + 1)
        processedFunctions[index] = true

@borrows
fn CompilerCsgUniqueSourcePathsFromFilter(ruleSet: var CompilerCsgReachableFunctionSet,
                                          filterSourcePaths: str[],
                                          outSourcePaths: var str[],
                                          err: var str): bool =
    outSourcePaths = []
    var seen = CompilerCsgSourcePathIndexInitLike(ruleSet.profileSourceIndex,
                                                  filterSourcePaths.len * 2 + 8)
    for i in 0..<filterSourcePaths.len:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let sourcePath = parser.ParserNormalizePath(filterSourcePaths[i])
        if sourcePath == "":
            CompilerCsgSourcePathIndexClear(seen)
            err = Fmt" compiler csg: typed ir frontier source path missing index={i}"
            return false
        var existingIndex: int32
        if !CompilerCsgSourcePathIndexEquivalentForInsert(seen,
                                                           sourcePath,
                                                           existingIndex,
                                                           err):
            CompilerCsgSourcePathIndexClear(seen)
            return false
        if existingIndex >= 0:
            continue
        if !CompilerCsgSourcePathIndexRegister(seen,
                                               sourcePath,
                                               outSourcePaths.len,
                                               err):
            CompilerCsgSourcePathIndexClear(seen)
            return false
        add(outSourcePaths, sourcePath)
    CompilerCsgSourcePathIndexClear(seen)
    err = ""
    return true

@borrows
fn CompilerCsgBuildFunctionSemanticIdentity(canonicalSource: str,
                                            physicalSourcePath: str,
                                            declarationLineIndex: int32,
                                            functionName: str,
                                            metadataContext: var texpr.TypedExprSourceContext,
                                            out: var CompilerCsgFunctionSemanticIdentity,
                                            err: var str): bool =
    out = CompilerCsgFunctionSemanticIdentity()
    if canonicalSource == "" ||
       chengpath.PathTrim(share(canonicalSource)) != canonicalSource ||
       declarationLineIndex <= 0 || functionName == "":
        err = Fmt" compiler csg: function semantic identity key invalid source={canonicalSource} line={declarationLineIndex} function={functionName}"
        return false
    if physicalSourcePath == "" ||
       parser.ParserNormalizePath(physicalSourcePath) != physicalSourcePath ||
       metadataContext.sourcePath == "" ||
       !CompilerCsgSourcePathsEquivalentNormalized(metadataContext.sourcePath,
                                                    physicalSourcePath):
        err = Fmt" compiler csg: function semantic identity metadata owner mismatch source={canonicalSource} physical_source={physicalSourcePath} metadata_source={metadataContext.sourcePath} line={declarationLineIndex} function={functionName}"
        return false
    out.canonicalSource = parser.ParserOwnedText(canonicalSource)
    out.declarationLineIndex = declarationLineIndex
    out.functionName = parser.ParserOwnedText(functionName)
    let scopeIndex = texpr.TypedExprScopeIndexForLine(metadataContext.scopes,
                                                      declarationLineIndex)
    if scopeIndex >= 0 &&
       scopeIndex < metadataContext.scopes.len &&
       metadataContext.scopes[scopeIndex].startLine == declarationLineIndex &&
       metadataContext.scopes[scopeIndex].name == functionName:
        out.paramTypeJoin = parser.ParserOwnedText(
            metadataContext.scopes[scopeIndex].paramTypeJoin)
        out.returnType = parser.ParserOwnedText(
            metadataContext.scopes[scopeIndex].returnType)
        out.signatureComplete = metadataContext.scopes[scopeIndex].paramTypesComplete
    # A complete signature with no return annotation is void. Canonicalize the
    # empty marker the same way call-declaration registration does, so the
    # cross-component semantic record never carries an ambiguous empty type.
    if out.signatureComplete && out.returnType == "":
        out.returnType = "void"
    err = ""
    return true

fn CompilerCsgPhaseArenaI32CapacityBytes(count: int32): int32 =
    # PhaseArenaStore 拒绝 0 容量; 空域仍开 1 行 (列 count 字段保持 0,
    # 读写下标永不触达)。
    if count < 0:
        panic("compiler csg: phase-arena i32 capacity negative domain")
    if count == 0:
        return 4
    if count > 2147483647 / 4:
        panic("compiler csg: phase-arena i32 capacity overflow")
    return count * 4

fn CompilerCsgPhaseArenaI32ReserveCount(count: int32): int32 =
    if count <= 0:
        return 1
    return count

fn CompilerCsgFunctionGraphNodeColumnInit(store: var phase.PhaseArenaStore,
                                          arena: phase.PhaseArenaHandle,
                                          functionCount: int32): CompilerCsgFunctionGraphNodeColumn =
    if functionCount < 0:
        panic("compiler csg: function graph-node column negative domain")
    var out: CompilerCsgFunctionGraphNodeColumn
    out.graphNodeIdColumn = phase.PhaseArenaStoreReserveI32Column(
        store, arena, CompilerCsgPhaseArenaI32ReserveCount(functionCount))
    out.graphNodeIdCount = functionCount
    for functionIndex in 0..<functionCount:
        phase.PhaseArenaStoreI32ColumnSet(store,
                                          arena,
                                          out.graphNodeIdColumn,
                                          functionIndex,
                                          -1)
    out.version = Int64(1)
    return out

@borrows
fn CompilerCsgPhaseArenaGraphNodeColumnGet(store: phase.PhaseArenaStore,
                                           arena: phase.PhaseArenaHandle,
                                           column: CompilerCsgFunctionGraphNodeColumn,
                                           functionIndex: int32): int32 =
    if functionIndex < 0 || functionIndex >= column.graphNodeIdCount:
        panic("compiler csg: function graph-node column index outside domain")
    return phase.PhaseArenaStoreI32ColumnGet(store,
                                             arena,
                                             column.graphNodeIdColumn,
                                             functionIndex)

@borrows
fn CompilerCsgPhaseArenaGraphNodeColumnSet(store: var phase.PhaseArenaStore,
                                           arena: phase.PhaseArenaHandle,
                                           column: CompilerCsgFunctionGraphNodeColumn,
                                           functionIndex: int32,
                                           value: int32) =
    if functionIndex < 0 || functionIndex >= column.graphNodeIdCount:
        panic("compiler csg: function graph-node column index outside domain")
    phase.PhaseArenaStoreI32ColumnSet(store,
                                      arena,
                                      column.graphNodeIdColumn,
                                      functionIndex,
                                      value)

# 阶段末整批释放 (七条②): ResetArena 一次清空整列 (代际 +1, 滞留句柄立即
# stale-generation hard-fail), 再 close+destroy 交还托管权威。替代原
# `work.functionGraphNodes = CompilerCsgFunctionGraphNodeColumn()` 的 ORC
# seq 遗弃。
fn CompilerCsgPhaseArenaGraphNodeStoreReset(work: var CompilerCsgBuildWorkingSet) =
    if !work.graphNodeStoreActive:
        panic("compiler csg: graph-node store reset without live authority")
    phase.PhaseArenaStoreResetArena(work.graphNodeStore, work.graphNodeArena)
    buildlife.CompilerCsgBuildFragmentLifetimePrepareStoreRelease(
        work.buildFragmentLifetime,
        work.graphNodeStoreLifetimeSlot)
    phase.PhaseArenaStoreCloseArena(work.graphNodeStore, work.graphNodeArena)
    let physicalRelease =
        phase.PhaseArenaStoreDestroyWithReceipt(work.graphNodeStore)
    buildlife.CompilerCsgBuildFragmentLifetimeCommitStoreRelease(
        work.buildFragmentLifetime,
        work.graphNodeStoreLifetimeSlot,
        physicalRelease)
    work.graphNodeStoreActive = false

# abort 路径幂等 teardown: 仅 close+destroy (相位未走完, 不做相位 reset)。
fn CompilerCsgPhaseArenaGraphNodeStoreTeardown(work: var CompilerCsgBuildWorkingSet) =
    if !work.graphNodeStoreActive:
        return
    buildlife.CompilerCsgBuildFragmentLifetimePrepareStoreRelease(
        work.buildFragmentLifetime,
        work.graphNodeStoreLifetimeSlot)
    phase.PhaseArenaStoreCloseArena(work.graphNodeStore, work.graphNodeArena)
    let physicalRelease =
        phase.PhaseArenaStoreDestroyWithReceipt(work.graphNodeStore)
    buildlife.CompilerCsgBuildFragmentLifetimeCommitStoreRelease(
        work.buildFragmentLifetime,
        work.graphNodeStoreLifetimeSlot,
        physicalRelease)
    work.graphNodeStoreActive = false

# ---------------------------------------------------------------------------
# PhaseArena CSG 文本族半片 (七条② intern-ID 列路线): exprCallProfiles.lines
# 的文本进 langintern pool (单一 owner), 行号→InternId 列进 lineStore。
# ---------------------------------------------------------------------------

@borrows
fn CompilerCsgLineArenaNewlineCount(text: str): int32 =
    var count: int32
    for i in 0..<text.len:
        if text[i] == '\n':
            count = count + 1
    return count

# store+pool 初始化。容量上界: 每 profile 行数 ≤ 其文本换行数+1 (parser 的
# multiline rewrite/continuation join 只减不增), 故列预算 =
# (Σ cache+lookup 换行数 + orderedSources.len)×4B —— 对任意输入精确安全,
# 无病理溢出路径 (越界即设施原生 hard-fail, 不兜底)。分配行 = profile 数+8。
fn CompilerCsgLineArenaInitInto(work: var CompilerCsgBuildWorkingSet) =
    var totalNewlines: int32
    for i in 0..<work.sourceTextCache.len:
        totalNewlines = totalNewlines +
            CompilerCsgLineArenaNewlineCount(work.sourceTextCache[i].text)
    for i in 0..<work.sourceTextLookup.len:
        totalNewlines = totalNewlines +
            CompilerCsgLineArenaNewlineCount(work.sourceTextLookup[i].text)
    totalNewlines = totalNewlines + work.orderedSources.len
    let payloadBytes = CompilerCsgPhaseArenaI32CapacityBytes(totalNewlines)
    let rowBudget = work.orderedSources.len + 8
    phase.PhaseArenaStoreInit(work.lineStore, 1, payloadBytes, rowBudget)
    buildlife.CompilerCsgBuildFragmentLifetimeStoreBegin(
        work.buildFragmentLifetime,
        work.lineStoreLifetimeSlot,
        buildlife.CompilerCsgBuildFragmentLineStore,
        phase.PhaseArenaStoreRetainedBytes(work.lineStore),
        phase.PhaseArenaStorePhysicalBufferCount(work.lineStore))
    work.lineArena = phase.PhaseArenaStoreOpenArena(work.lineStore,
                                                    1,
                                                    payloadBytes,
                                                    rowBudget)
    work.lineStoreActive = true
    work.lineInternPool = langintern.InternPoolNew()
    work.lineInternPoolActive = true

# append-move 后立即调用: profile 的各行 intern 进 pool (add retain, pool
# 成为文本 owner), 行号→InternId 写入该 profile 的 arena 列, 原 ORC 行表
# 当场 freeSeqStrRelease (profile.lines 即空; 不再等相位末逐对象释放)。
@borrows
fn compilerCsgClearProfileLinesRec(work: var CompilerCsgBuildWorkingSet,
                                    profileIndex: int32,
                                    i: int32) =
    # Iterative form: the recursive spelling burned one ~2KB frame per line
    # and overflowed even a 16MB stack on multi-thousand-line profiles.
    for lineIndex in i..<work.exprCallProfiles[profileIndex].lines.len:
        work.exprCallProfiles[profileIndex].lines[lineIndex] = ""
    work.exprCallProfiles[profileIndex].lines = []

@borrows
fn compilerCsgProfileLinesInternRec(work: var CompilerCsgBuildWorkingSet,
                                     profileIndex: int32,
                                     column: phase.PhaseArenaRef,
                                     li: int32,
                                     lineCount: int32) =
    # Iterative form: the recursive spelling burned one ~2KB frame per line
    # and overflowed even a 16MB stack on multi-thousand-line profiles.
    for lineIndex in li..<lineCount:
        # Intern() already clones into its owned text slot; the previous extra
        # strings.CloneStr here made every line a double copy (43.9MB stack in
        # the true-peak attribution) and left the first copy as pure churn.
        let internId = langintern.Intern(work.lineInternPool,
                                         work.exprCallProfiles[
                                             profileIndex].lines[lineIndex])
        phase.PhaseArenaStoreI32ColumnSet(work.lineStore,
                                          work.lineArena,
                                          column,
                                          lineIndex,
                                          internId)
    compilerCsgClearProfileLinesRec(work, profileIndex, 0)

fn CompilerCsgProfileLinesInternIntoArena(work: var CompilerCsgBuildWorkingSet,
                                          profileIndex: int32) =
    let lineCount = work.exprCallProfiles[profileIndex].lines.len
    if lineCount > 0:
        let reserved = phase.PhaseArenaStoreReserveI32Column(work.lineStore,
                                                             work.lineArena,
                                                             lineCount)
        compilerCsgProfileLinesInternRec(work, profileIndex, reserved, 0, lineCount)
        add(work.profileLineIdColumns, reserved)
        add(work.profileLineIdCounts, lineCount)
        return
    var emptyColumn: phase.PhaseArenaRef
    add(work.profileLineIdColumns, emptyColumn)
    add(work.profileLineIdCounts, lineCount)

# 消费侧物化: 行号列 → str[] (LookupIntern 共享 + add retain, 与
# CompilerCsgCloneStrSeq 完全同语义 —— 今天 CloneStrSeq 也是浅共享)。
# count==0 返回空 (调用方走既有 fallback, 与迁移前逐字一致)。
@borrows
fn CompilerCsgProfileLineSeqFromArena(store: var phase.PhaseArenaStore,
                                      arena: phase.PhaseArenaHandle,
                                      pool: langintern.InternPool,
                                      columns: phase.PhaseArenaRef[],
                                      counts: int32[],
                                      profileIndex: int32): str[] =
    var out: str[]
    if profileIndex < 0 || profileIndex >= counts.len:
        return out
    let lineCount = counts[profileIndex]
    if lineCount <= 0:
        return out
    let column = columns[profileIndex]
    for li in 0..<lineCount:
        let internId = phase.PhaseArenaStoreI32ColumnGet(store,
                                                         arena,
                                                         column,
                                                         li)
        let textRes = langintern.LookupIntern(pool, internId)
        if IsErr(textRes):
            panic("compiler csg: line intern id outside pool authority")
        add(out, Value(textRes))
    return out

# 相位末整批释放 (七条②): lineStore reset+close+destroy (代际 +1, 滞留列
# 句柄 stale-generation 即 hard-fail), lineInternPool InternPoolRelease
# (index 存储 + 全文本行整批灭)。替代原 CompactProfilesForFixedPoint 里
# `profiles[i].lines = []` 的 ORC 行表遗弃。
fn CompilerCsgPhaseArenaLineStoreReset(work: var CompilerCsgBuildWorkingSet) =
    if !work.lineStoreActive:
        panic("compiler csg: line store reset without live authority")
    phase.PhaseArenaStoreResetArena(work.lineStore, work.lineArena)
    buildlife.CompilerCsgBuildFragmentLifetimePrepareStoreRelease(
        work.buildFragmentLifetime,
        work.lineStoreLifetimeSlot)
    phase.PhaseArenaStoreCloseArena(work.lineStore, work.lineArena)
    let physicalRelease =
        phase.PhaseArenaStoreDestroyWithReceipt(work.lineStore)
    buildlife.CompilerCsgBuildFragmentLifetimeCommitStoreRelease(
        work.buildFragmentLifetime,
        work.lineStoreLifetimeSlot,
        physicalRelease)
    work.lineStoreActive = false
    if work.lineInternPoolActive:
        langintern.InternPoolRelease(work.lineInternPool)
        work.lineInternPoolActive = false

# abort 路径幂等 teardown: 仅 close+destroy + pool release (不做相位 reset)。
fn CompilerCsgPhaseArenaLineStoreTeardown(work: var CompilerCsgBuildWorkingSet) =
    if work.lineStoreActive:
        buildlife.CompilerCsgBuildFragmentLifetimePrepareStoreRelease(
            work.buildFragmentLifetime,
            work.lineStoreLifetimeSlot)
        phase.PhaseArenaStoreCloseArena(work.lineStore, work.lineArena)
        let physicalRelease =
            phase.PhaseArenaStoreDestroyWithReceipt(work.lineStore)
        buildlife.CompilerCsgBuildFragmentLifetimeCommitStoreRelease(
            work.buildFragmentLifetime,
            work.lineStoreLifetimeSlot,
            physicalRelease)
        work.lineStoreActive = false
    if work.lineInternPoolActive:
        langintern.InternPoolRelease(work.lineInternPool)
        work.lineInternPoolActive = false
# PhaseArena CSG 字符串半片: 轮次报告短文本的注册+计量 owner。
# ---------------------------------------------------------------------------

# 轮次硬上界 = functionCount + 2 (20181 行收敛门禁: 循环顶
# `typedIrReachRound > functionCount + 1` 即 fail, 追加发生在循环底, 故最多
# functionCount + 2 轮、每轮 3 段)。每段十进制文本 <= 20B (int64 最小值
# "-9223372036854775808" 恰好 20 字符)。容量零高估, 任何偏离即 spill
# hard-fail。
fn CompilerCsgPhaseArenaRoundTextMaxParts(functionCount: int32): int32 =
    if functionCount < 0:
        panic("compiler csg: round text arena negative function count")
    if functionCount > (2147483647 - 6) / 3:
        panic("compiler csg: round text arena part bound overflow")
    return (functionCount + 2) * 3

fn CompilerCsgPhaseArenaRoundTextStoreBegin(
        work: var CompilerCsgBuildWorkingSet,
        functionCount: int32) =
    if work.roundTextStoreActive:
        panic("compiler csg: round text store already active")
    let maxParts = CompilerCsgPhaseArenaRoundTextMaxParts(functionCount)
    if maxParts > 2147483647 / 20:
        panic("compiler csg: round text arena payload bound overflow")
    let payloadBytes = maxParts * 20
    phase.PhaseArenaStoreInit(work.roundTextStore, 1, payloadBytes, maxParts)
    buildlife.CompilerCsgBuildFragmentLifetimeStoreBegin(
        work.buildFragmentLifetime,
        work.roundTextStoreLifetimeSlot,
        buildlife.CompilerCsgBuildFragmentRoundTextStore,
        phase.PhaseArenaStoreRetainedBytes(work.roundTextStore),
        phase.PhaseArenaStorePhysicalBufferCount(work.roundTextStore))
    work.roundTextArena =
        phase.PhaseArenaStoreOpenArena(work.roundTextStore,
                                       1,
                                       payloadBytes,
                                       maxParts)
    work.roundTextStoreActive = true

fn CompilerCsgPhaseArenaRoundTextAppendMs(work: var CompilerCsgBuildWorkingSet,
                                          valueNs: int64) =
    if !work.roundTextStoreActive:
        panic("compiler csg: round text append without live authority")
    add(work.typedIrRoundBuildMsPartRefs,
        phase.PhaseArenaStoreStrPutInt64FixedWidthDecimal(
            work.roundTextStore,
            work.roundTextArena,
            valueNs / int64(1000000),
            20))

let CompilerCsgRoundTextPartBuildMs: int32 = 1
let CompilerCsgRoundTextPartNewReachable: int32 = 2
let CompilerCsgRoundTextPartBuildCount: int32 = 3

fn CompilerCsgPhaseArenaRoundTextAppendCount(
        work: var CompilerCsgBuildWorkingSet,
        partKind: int32,
        value: int32) =
    if !work.roundTextStoreActive:
        panic("compiler csg: round text append without live authority")
    let partRef =
        phase.PhaseArenaStoreStrPutInt64(work.roundTextStore,
                                         work.roundTextArena,
                                         Int64(value))
    if partKind == CompilerCsgRoundTextPartNewReachable:
        add(work.typedIrRoundNewReachableCountPartRefs, partRef)
    elif partKind == CompilerCsgRoundTextPartBuildCount:
        add(work.typedIrRoundBuildCountPartRefs, partRef)
    else:
        panic("compiler csg: unknown round text part identity")

# 精确幸存者转移: 最终 CSV 是离开 arena 的唯一 managed owner; parts 本体在
# 随后的整批 reset 中一次性回收。
fn CompilerCsgPhaseArenaRoundTextJoin(work: var CompilerCsgBuildWorkingSet,
                                      partKind: int32): str =
    if !work.roundTextStoreActive:
        panic("compiler csg: round text join without live authority")
    var parts: str[]
    if partKind == CompilerCsgRoundTextPartBuildMs:
        for refIndex in 0..<work.typedIrRoundBuildMsPartRefs.len:
            add(parts,
                phase.PhaseArenaStoreStrCopyOutOwned(
                    work.roundTextStore,
                    work.roundTextArena,
                    work.typedIrRoundBuildMsPartRefs[refIndex]))
    elif partKind == CompilerCsgRoundTextPartNewReachable:
        for refIndex in 0..<work.typedIrRoundNewReachableCountPartRefs.len:
            add(parts,
                phase.PhaseArenaStoreStrCopyOutOwned(
                    work.roundTextStore,
                    work.roundTextArena,
                    work.typedIrRoundNewReachableCountPartRefs[refIndex]))
    elif partKind == CompilerCsgRoundTextPartBuildCount:
        for refIndex in 0..<work.typedIrRoundBuildCountPartRefs.len:
            add(parts,
                phase.PhaseArenaStoreStrCopyOutOwned(
                    work.roundTextStore,
                    work.roundTextArena,
                    work.typedIrRoundBuildCountPartRefs[refIndex]))
    else:
        panic("compiler csg: unknown round text join identity")
    return strutil.Join(parts, ",")

# 阶段末整批释放 (同 GraphNodeStoreReset 范式): 先取内容报告 (供 out 标量
# 与内存账本: allocation/used/peak/spill 一律为 reset 前值), 有活动才
# reset (零追加相位合法, close+destroy 仍是唯一释放), reset 后补采
# resetCount 使返回报告的 resetCount 反映本相位真实整批 reset 次数, 最后
# close+destroy 交还托管权威。
fn CompilerCsgPhaseArenaRoundTextStoreReset(
        work: var CompilerCsgBuildWorkingSet): phase.PhaseArenaStoreArenaReport =
    if !work.roundTextStoreActive:
        panic("compiler csg: round text store reset without live authority")
    let report = phase.PhaseArenaStoreArenaReport(work.roundTextStore,
                                                  work.roundTextArena)
    if report.allocationCount > 0:
        phase.PhaseArenaStoreResetArena(work.roundTextStore,
                                        work.roundTextArena)
        let postReset = phase.PhaseArenaStoreArenaReport(work.roundTextStore,
                                                         work.roundTextArena)
        report.resetCount = postReset.resetCount
    buildlife.CompilerCsgBuildFragmentLifetimePrepareStoreRelease(
        work.buildFragmentLifetime,
        work.roundTextStoreLifetimeSlot)
    phase.PhaseArenaStoreCloseArena(work.roundTextStore, work.roundTextArena)
    let physicalRelease =
        phase.PhaseArenaStoreDestroyWithReceipt(work.roundTextStore)
    buildlife.CompilerCsgBuildFragmentLifetimeCommitStoreRelease(
        work.buildFragmentLifetime,
        work.roundTextStoreLifetimeSlot,
        physicalRelease)
    work.roundTextStoreActive = false
    return report

# abort 路径幂等 teardown: 仅 close+destroy (相位未走完, 不做相位 reset)。
fn CompilerCsgPhaseArenaRoundTextStoreTeardown(work: var CompilerCsgBuildWorkingSet) =
    if !work.roundTextStoreActive:
        return
    buildlife.CompilerCsgBuildFragmentLifetimePrepareStoreRelease(
        work.buildFragmentLifetime,
        work.roundTextStoreLifetimeSlot)
    phase.PhaseArenaStoreCloseArena(work.roundTextStore, work.roundTextArena)
    let physicalRelease =
        phase.PhaseArenaStoreDestroyWithReceipt(work.roundTextStore)
    buildlife.CompilerCsgBuildFragmentLifetimeCommitStoreRelease(
        work.buildFragmentLifetime,
        work.roundTextStoreLifetimeSlot,
        physicalRelease)
    work.roundTextStoreActive = false

@borrows
fn CompilerCsgFunctionGraphNodeRowCertificate(ruleSet: CompilerCsgReachableFunctionSet,
                                               functionIndex: int32,
                                               graphNodeId: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(functionIndex), Int64(graphNodeId))
    out = CompilerCsgCertificateMix(out,
                                    Int64(ruleSet.producerSourceIndexes[functionIndex]))
    out = CompilerCsgCertificateMix(out,
                                    Int64(ruleSet.producerDeclarationIndexes[functionIndex]))
    return CompilerCsgCertificateMix(
        out,
        CompilerCsgFixed32ContentCertificate(
            ruleSet.functionNameProofCids[functionIndex]))

@borrows
fn CompilerCsgFunctionGraphNodeColumnContentCertificate(store: phase.PhaseArenaStore,
                                                        arena: phase.PhaseArenaHandle,
                                                        column: CompilerCsgFunctionGraphNodeColumn,
                                                        ruleSet: CompilerCsgReachableFunctionSet): int64 =
    var out = CompilerCsgCertificateMix(Int64(146959810), Int64(column.graphNodeIdCount))
    for functionIndex in 0..<column.graphNodeIdCount:
        out = CompilerCsgCertificateMix(
            out,
            CompilerCsgFunctionGraphNodeRowCertificate(ruleSet,
                                                       functionIndex,
                                                       CompilerCsgPhaseArenaGraphNodeColumnGet(store,
                                                                                               arena,
                                                                                               column,
                                                                                               functionIndex)))
    return out

@borrows
fn CompilerCsgFunctionGraphNodeColumnBind(store: var phase.PhaseArenaStore,
                                          arena: phase.PhaseArenaHandle,
                                          column: var CompilerCsgFunctionGraphNodeColumn,
                                          ruleSet: CompilerCsgReachableFunctionSet,
                                          functionIndex: int32,
                                          producerSourceIndex: int32,
                                          producerDeclarationIndex: int32,
                                          nameProofCid: layout.FixedBytes32,
                                          graphNodeId: int32,
                                          err: var str): bool =
    if column.sealedVersion != Int64(0):
        err = " compiler csg: function graph-node column already sealed"
        return false
    let functionCount = ruleSet.functionNames.len
    if column.graphNodeIdCount != functionCount ||
       ruleSet.sourcePaths.len != functionCount ||
       ruleSet.producerSourceIndexes.len != functionCount ||
       ruleSet.producerDeclarationIndexes.len != functionCount ||
       ruleSet.functionNameProofCids.len != functionCount:
        err = Fmt" compiler csg: function graph-node bind domain mismatch column={column.graphNodeIdCount} functions={functionCount} sources={ruleSet.sourcePaths.len} producer_sources={ruleSet.producerSourceIndexes.len} producer_decls={ruleSet.producerDeclarationIndexes.len} name_proofs={ruleSet.functionNameProofCids.len}"
        return false
    if functionIndex < 0 || functionIndex >= functionCount:
        err = Fmt" compiler csg: function graph-node bind index out of range function={functionIndex} count={functionCount}"
        return false
    if ruleSet.producerSourceIndexes[functionIndex] != producerSourceIndex ||
       ruleSet.producerDeclarationIndexes[functionIndex] !=
           producerDeclarationIndex ||
       layout.FixedBytes32Equal(nameProofCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           ruleSet.functionNameProofCids[functionIndex], nameProofCid):
        err = Fmt" compiler csg: function graph-node producer identity mismatch function={functionIndex} producer_source={producerSourceIndex} producer_decl={producerDeclarationIndex}"
        return false
    if graphNodeId <= 0:
        err = Fmt" compiler csg: function graph-node bind nodeId invalid function={functionIndex} node={graphNodeId}"
        return false
    if CompilerCsgPhaseArenaGraphNodeColumnGet(store, arena, column, functionIndex) != -1:
        err = Fmt" compiler csg: function graph-node bind duplicate function={functionIndex} first_node={CompilerCsgPhaseArenaGraphNodeColumnGet(store, arena, column, functionIndex)} next_node={graphNodeId}"
        return false
    CompilerCsgPhaseArenaGraphNodeColumnSet(store, arena, column, functionIndex, graphNodeId)
    column.version = column.version + Int64(1)
    err = ""
    return true

fn CompilerCsgBuildNodeIndexByNodeId(nodes: var CompilerCsgNode[]): int32[] =
    var maxNodeId: int32
    for i in 0..<nodes.len:
        let nodeId = nodes[i].nodeId
        if nodeId < 1:
            panic("compiler csg: graph node has invalid nodeId")
        if nodeId > maxNodeId:
            maxNodeId = nodeId
    var out: int32[]
    setLen(out, maxNodeId + 1)
    for i in 0..<(maxNodeId + 1):
        out[i] = -1
    for i in 0..<nodes.len:
        let nodeId = nodes[i].nodeId
        if out[nodeId] != -1:
            panic("compiler csg: graph nodeId duplicate")
        out[nodeId] = i
    return out

fn CompilerCsgFunctionGraphNodeColumnValidateRows(store: var phase.PhaseArenaStore,
                                                  arena: phase.PhaseArenaHandle,
                                                  column: var CompilerCsgFunctionGraphNodeColumn,
                                                  ruleSet: var CompilerCsgReachableFunctionSet,
                                                  nodes: var CompilerCsgNode[],
                                                  err: var str): bool =
    let functionCount = ruleSet.functionNames.len
    if column.graphNodeIdCount != functionCount ||
       ruleSet.sourcePaths.len != functionCount ||
       ruleSet.producerSourceIndexes.len != functionCount ||
       ruleSet.producerDeclarationIndexes.len != functionCount ||
       ruleSet.functionNameProofCids.len != functionCount:
        err = Fmt" compiler csg: function graph-node column shape mismatch column={column.graphNodeIdCount} functions={functionCount} sources={ruleSet.sourcePaths.len} producer_sources={ruleSet.producerSourceIndexes.len} producer_decls={ruleSet.producerDeclarationIndexes.len} name_proofs={ruleSet.functionNameProofCids.len}"
        return false
    let idxByNodeId = CompilerCsgBuildNodeIndexByNodeId(nodes)
    var mappedByNodeId: bool[]
    setLen(mappedByNodeId, idxByNodeId.len)
    for functionIndex in 0..<functionCount:
        if functionIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let graphNodeId = CompilerCsgPhaseArenaGraphNodeColumnGet(store,
                                                                  arena,
                                                                  column,
                                                                  functionIndex)
        if graphNodeId <= 0 || graphNodeId >= idxByNodeId.len ||
           idxByNodeId[graphNodeId] < 0:
            err = Fmt" compiler csg: function graph-node binding missing function={functionIndex} node={graphNodeId}"
            return false
        let node = nodes[idxByNodeId[graphNodeId]]
        if node.nodeKind != CompilerCsgNodeKindSymbol ||
           node.producerSourceIndex !=
               ruleSet.producerSourceIndexes[functionIndex] ||
           node.producerDeclarationIndex !=
               ruleSet.producerDeclarationIndexes[functionIndex] ||
           !layout.FixedBytes32Equal(
               node.nameProofCid,
               ruleSet.functionNameProofCids[functionIndex]):
            err = Fmt" compiler csg: function graph-node binding targets non-symbol function={functionIndex} node={graphNodeId}"
            return false
        if mappedByNodeId[graphNodeId]:
            err = Fmt" compiler csg: graph symbol node bound to multiple functions node={graphNodeId}"
            return false
        mappedByNodeId[graphNodeId] = true
    var symbolNodeCount: int32
    for nodeIndex in 0..<nodes.len:
        if nodeIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if nodes[nodeIndex].nodeKind != CompilerCsgNodeKindSymbol:
            continue
        symbolNodeCount = symbolNodeCount + 1
        let graphNodeId = nodes[nodeIndex].nodeId
        if graphNodeId <= 0 || graphNodeId >= mappedByNodeId.len ||
           !mappedByNodeId[graphNodeId]:
            err = Fmt" compiler csg: graph symbol node has no function binding node={graphNodeId}"
            return false
    if symbolNodeCount != functionCount:
        err = Fmt" compiler csg: function graph-node coverage mismatch symbols={symbolNodeCount} functions={functionCount}"
        return false
    err = ""
    return true

fn CompilerCsgFunctionGraphNodeColumnSeal(store: var phase.PhaseArenaStore,
                                          arena: phase.PhaseArenaHandle,
                                          column: var CompilerCsgFunctionGraphNodeColumn,
                                          ruleSet: var CompilerCsgReachableFunctionSet,
                                          nodes: var CompilerCsgNode[],
                                          err: var str): bool =
    if column.sealedVersion != Int64(0):
        err = " compiler csg: function graph-node column double seal"
        return false
    if !CompilerCsgFunctionGraphNodeColumnValidateRows(store, arena, column, ruleSet, nodes, err):
        return false
    column.functionCountAtSeal = ruleSet.functionNames.len
    column.contentCertificate =
        CompilerCsgFunctionGraphNodeColumnContentCertificate(store, arena, column, ruleSet)
    column.sealedVersion = column.version
    err = ""
    return true

fn CompilerCsgFunctionGraphNodeColumnValidate(store: var phase.PhaseArenaStore,
                                              arena: phase.PhaseArenaHandle,
                                              column: var CompilerCsgFunctionGraphNodeColumn,
                                              ruleSet: var CompilerCsgReachableFunctionSet,
                                              nodes: var CompilerCsgNode[],
                                              err: var str): bool =
    if column.sealedVersion == Int64(0) ||
       column.sealedVersion != column.version ||
       column.functionCountAtSeal != ruleSet.functionNames.len:
        err = Fmt" compiler csg: function graph-node column seal invalid version={column.version} sealed={column.sealedVersion} functions={ruleSet.functionNames.len} sealed_functions={column.functionCountAtSeal}"
        return false
    if column.contentCertificate !=
       CompilerCsgFunctionGraphNodeColumnContentCertificate(store, arena, column, ruleSet):
        err = " compiler csg: function graph-node column certificate mismatch"
        return false
    return CompilerCsgFunctionGraphNodeColumnValidateRows(store, arena, column, ruleSet, nodes, err)

@borrows
fn CompilerCsgMarkNodeOwnerClosure(nodes: var CompilerCsgNode[],
                                    idxByNodeId: int32[],
                                    keepByNodeId: var bool[],
                                    nodeId: int32) =
    var current = nodeId
    var guard: int32
    while current != 0:
        if current < 1 || current >= idxByNodeId.len:
            panic("compiler csg: graph owner nodeId out of range during prune")
        let index = idxByNodeId[current]
        if index < 0:
            panic("compiler csg: graph owner nodeId missing during prune")
        if keepByNodeId[current]:
            return
        keepByNodeId[current] = true
        guard = guard + 1
        if guard > nodes.len:
            panic("compiler csg: graph owner cycle during prune")
        current = nodes[index].ownerNodeId

@borrows
fn CompilerCsgNearestOwningSymbolNodeId(nodes: var CompilerCsgNode[],
                                        idxByNodeId: int32[],
                                        nearestSymbolByNodeId: var int32[],
                                        nodeId: int32): int32 =
    if nodeId == 0:
        return -1
    if nodeId < 1 || nodeId >= idxByNodeId.len ||
       nodeId >= nearestSymbolByNodeId.len:
        panic("compiler csg: graph owner lookup nodeId out of range")
    if nearestSymbolByNodeId[nodeId] != -2:
        return nearestSymbolByNodeId[nodeId]
    var current = nodeId
    var guard: int32
    var searching = true
    while searching && current != 0:
        if current < 1 || current >= idxByNodeId.len:
            panic("compiler csg: graph owner lookup ancestor out of range")
        if nearestSymbolByNodeId[current] != -2:
            searching = false
            continue
        let index = idxByNodeId[current]
        if index < 0:
            panic("compiler csg: graph owner lookup ancestor missing")
        if nodes[index].nodeKind == CompilerCsgNodeKindSymbol:
            nearestSymbolByNodeId[current] = current
            break
        current = nodes[index].ownerNodeId
        guard = guard + 1
        if guard > nodes.len:
            panic("compiler csg: graph owner cycle during symbol lookup")
    var nearestSymbolNodeId: int32 = -1
    if current != 0:
        nearestSymbolNodeId = nearestSymbolByNodeId[current]
    current = nodeId
    guard = 0
    var caching = true
    while caching && current != 0:
        if current < 1 || current >= idxByNodeId.len:
            panic("compiler csg: graph owner cache ancestor out of range")
        if nearestSymbolByNodeId[current] != -2:
            caching = false
            continue
        let index = idxByNodeId[current]
        nearestSymbolByNodeId[current] = nearestSymbolNodeId
        current = nodes[index].ownerNodeId
        guard = guard + 1
        if guard > nodes.len:
            panic("compiler csg: graph owner cycle while caching symbol lookup")
    return nearestSymbolByNodeId[nodeId]

fn CompilerCsgPruneGraphForReachable(store: var phase.PhaseArenaStore,
                                      arena: phase.PhaseArenaHandle,
                                      nodes: var CompilerCsgNode[],
                                      edges: var CompilerCsgEdge[],
                                      ruleSet: var CompilerCsgReachableFunctionSet,
                                      functionGraphNodes: var CompilerCsgFunctionGraphNodeColumn) =
    if !ruleSet.active:
        return
    if ruleSet.functionNames.len != ruleSet.reachable.len:
        panic("compiler csg: graph prune reachable columns mismatch")
    var functionGraphErr: str
    if !CompilerCsgFunctionGraphNodeColumnValidate(store,
                                                    arena,
                                                    functionGraphNodes,
                                                    ruleSet,
                                                    nodes,
                                                    functionGraphErr):
        panic(functionGraphErr)
    let idxByNodeId = CompilerCsgBuildNodeIndexByNodeId(nodes)
    var retainedSymbolByNodeId: bool[]
    setLen(retainedSymbolByNodeId, idxByNodeId.len)
    var keepByNodeId: bool[]
    setLen(keepByNodeId, idxByNodeId.len)
    # Package and module identity belongs to the complete semantic graph, not
    # to the function emission worklist. A type/global-only package has no
    # Symbol node from which owner-closure could otherwise retain this base
    # domain.
    for i in 0..<nodes.len:
        let node = nodes[i]
        if node.nodeKind == CompilerCsgNodeKindPackage ||
           node.nodeKind == CompilerCsgNodeKindModule:
            keepByNodeId[node.nodeId] = true
    for i in 0..<nodes.len:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let node = nodes[i]
        if node.nodeKind != CompilerCsgNodeKindSymbol:
            continue
        # The canonical CSG is the complete semantic snapshot, not an object
        # emission worklist.  Dropping an unreachable declaration here leaves
        # parser provenance and LSP symbols with no graph identity.  TypedIR
        # and backend worklists retain their independent reachability filter;
        # every declaration Symbol remains in the semantic graph.
        retainedSymbolByNodeId[node.nodeId] = true
    for functionIndex in 0..<ruleSet.reachable.len:
        if functionIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if !ruleSet.reachable[functionIndex]:
            continue
        let nodeId = CompilerCsgPhaseArenaGraphNodeColumnGet(store,
                                                             arena,
                                                             functionGraphNodes,
                                                             functionIndex)
        retainedSymbolByNodeId[nodeId] = true
    for nodeId in 1..<retainedSymbolByNodeId.len:
        if retainedSymbolByNodeId[nodeId]:
            CompilerCsgMarkNodeOwnerClosure(nodes,
                                            idxByNodeId,
                                            keepByNodeId,
                                            nodeId)
    var nearestSymbolByNodeId: int32[]
    setLen(nearestSymbolByNodeId, idxByNodeId.len)
    for nodeId in 0..<nearestSymbolByNodeId.len:
        nearestSymbolByNodeId[nodeId] = -2
    if nearestSymbolByNodeId.len > 0:
        nearestSymbolByNodeId[0] = -1
    for nodeIndex in 0..<nodes.len:
        if nodes[nodeIndex].nodeKind == CompilerCsgNodeKindSymbol:
            nearestSymbolByNodeId[nodes[nodeIndex].nodeId] = nodes[nodeIndex].nodeId
    for nodeIndex in 0..<nodes.len:
        if nodeIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let node = nodes[nodeIndex]
        if node.nodeKind == CompilerCsgNodeKindSymbol:
            continue
        let owningSymbolNodeId =
            CompilerCsgNearestOwningSymbolNodeId(nodes,
                                                  idxByNodeId,
                                                  nearestSymbolByNodeId,
                                                  node.nodeId)
        if owningSymbolNodeId <= 0 ||
           !retainedSymbolByNodeId[owningSymbolNodeId]:
            continue
        CompilerCsgMarkNodeOwnerClosure(nodes,
                                        idxByNodeId,
                                        keepByNodeId,
                                        node.nodeId)
    var keptNodes: CompilerCsgNode[]
    for i in 0..<nodes.len:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let node = nodes[i]
        if node.nodeId >= 0 && node.nodeId < keepByNodeId.len && keepByNodeId[node.nodeId]:
            add(keptNodes, share(node))
    var keptEdges: CompilerCsgEdge[]
    for edgeIndex in 0..<edges.len:
        if edgeIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let edge = edges[edgeIndex]
        if edge.fromNodeId <= 0 || edge.fromNodeId >= idxByNodeId.len ||
           edge.toNodeId <= 0 || edge.toNodeId >= idxByNodeId.len ||
           idxByNodeId[edge.fromNodeId] < 0 || idxByNodeId[edge.toNodeId] < 0:
            panic("compiler csg: graph edge endpoint missing during prune")
        if keepByNodeId[edge.fromNodeId] && keepByNodeId[edge.toNodeId]:
            add(keptEdges, edge)
    nodes = keptNodes
    edges = keptEdges

@borrows
fn CompilerCsgReachableHasSource(ruleSet: var CompilerCsgReachableFunctionSet,
                                  sourcePathRaw: str): bool =
    let profileIndex = CompilerCsgReachableProfileIndex(ruleSet, sourcePathRaw)
    if profileIndex < 0 || profileIndex >= ruleSet.profileFunctionStarts.len ||
       profileIndex >= ruleSet.profileFunctionCounts.len:
        panic(Fmt"compiler csg: reachable source profile missing source={sourcePathRaw} profile_index={profileIndex}")
    let functionStart = ruleSet.profileFunctionStarts[profileIndex]
    let functionEnd = functionStart + ruleSet.profileFunctionCounts[profileIndex]
    for functionIndex in functionStart..<functionEnd:
        if functionIndex < 0 || functionIndex >= ruleSet.reachable.len:
            panic(Fmt"compiler csg: reachable source adjacency columns corrupt source={sourcePathRaw} function_index={functionIndex} reachable_count={ruleSet.reachable.len}")
        if ruleSet.reachable[functionIndex]:
            return true
    return false

fn CompilerCsgReachableHasSourceDelta(ruleSet: var CompilerCsgReachableFunctionSet,
                                      delta: var CompilerCsgReachabilityDelta,
                                      sourcePathRaw: str): bool =
    let profileIndex = CompilerCsgReachableProfileIndex(ruleSet, sourcePathRaw)
    if profileIndex < 0 || profileIndex >= ruleSet.profileFunctionStarts.len ||
       profileIndex >= ruleSet.profileFunctionCounts.len:
        panic(Fmt"compiler csg: reachable delta source profile missing source={sourcePathRaw} profile_index={profileIndex}")
    let functionStart = ruleSet.profileFunctionStarts[profileIndex]
    let functionEnd = functionStart + ruleSet.profileFunctionCounts[profileIndex]
    for functionIndex in functionStart..<functionEnd:
        if functionIndex < 0 || functionIndex >= ruleSet.reachable.len:
            panic(Fmt"compiler csg: reachable delta source columns corrupt source={sourcePathRaw} function_index={functionIndex}")
        if CompilerCsgReachabilityDeltaIsReachable(ruleSet, delta, functionIndex):
            return true
    return false

fn CompilerCsgPruneSourceTextsForReachable(sourceTexts: var TypedExprSourceText[],
                                            ruleSet: var CompilerCsgReachableFunctionSet) =
    if !ruleSet.active:
        return
    var kept: TypedExprSourceText[]
    for i in 0..<sourceTexts.len:
        if i % 64 == 0:
            os.ProcessResourceGuardCheck()
        if CompilerCsgReachableHasSource(ruleSet, sourceTexts[i].sourcePath):
            add(kept, share(sourceTexts[i]))
        else:
            texpr.TypedExprClearSourceTextAllFields(sourceTexts[i])
    sourceTexts = kept

@borrows
fn CompilerCsgDeclIndexLess(decls: parser.NormalizedFunctionDecl[],
                            leftIndex: int32,
                            rightIndex: int32): bool =
    if decls[leftIndex].lineIndex != decls[rightIndex].lineIndex:
        return decls[leftIndex].lineIndex < decls[rightIndex].lineIndex
    return CompilerCsgStrLess(decls[leftIndex].name, decls[rightIndex].name)

@borrows
fn CompilerCsgMergeDeclIndexPassRec(
        decls: parser.NormalizedFunctionDecl[],
        source: var int32[],
        destination: var int32[],
        width: int32,
        leftStart: int32) =
    while true:
        let count = source.len
        if leftStart >= count:
            return
        let midRaw = leftStart + width
        var mid = count
        if midRaw < count:
            mid = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = mid
        for outputIndex in leftStart..<rightEnd:
            if left < mid &&
               (right >= rightEnd ||
                !CompilerCsgDeclIndexLess(decls, source[right], source[left])):
                destination[outputIndex] = source[left]
                left = left + 1
            else:
                destination[outputIndex] = source[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

@borrows
fn CompilerCsgMergeDeclIndexPass(decls: parser.NormalizedFunctionDecl[],
                                 source: var int32[],
                                 destination: var int32[],
                                 width: int32) =
    CompilerCsgMergeDeclIndexPassRec(decls, source, destination, width, 0)

@borrows
fn CompilerCsgSortedExecutableDeclIndexes(profile: parser.NormalizedExprCallProfile): int32[] =
    var order: int32[]
    for declIndex in 0..<profile.decls.len:
        let decl = profile.decls[declIndex]
        if decl.importc:
            continue
        # decl.name can legitimately be a backtick operator-overload token
        # (`/`, `[]=`, `%`, ...) with no identifier-char prefix (see parser.cheng's
        # NormalizedFunctionDecl builder, which backtick-strips those and only
        # ever appends a decl once its computed name is non-empty). ParserIdentPrefix
        # is the wrong test for "well-formed decl name" here: only bare emptiness is
        # the actual invariant violation worth guarding.
        if decl.name == "":
            panic(Fmt"compiler csg: executable declaration name invalid decl_index={declIndex} line={decl.lineIndex} kind=function source={profile.sourcePath} name={decl.name}")
        add(order, declIndex)
    if order.len <= 1:
        return order
    var scratch: int32[]
    for orderIndex in 0..<order.len:
        add(scratch, order[orderIndex])
    var width: int32 = 1
    var readScratch = false
    while width < order.len:
        if readScratch:
            CompilerCsgMergeDeclIndexPass(profile.decls,
                                          scratch,
                                          order,
                                          width)
        else:
            CompilerCsgMergeDeclIndexPass(profile.decls,
                                          order,
                                          scratch,
                                          width)
        readScratch = !readScratch
        if width > order.len / 2:
            width = order.len
        else:
            width = width * 2
    if readScratch:
        for orderIndex in 0..<order.len:
            order[orderIndex] = scratch[orderIndex]
    return order

@borrows
fn CompilerCsgReachableAddFunctionsFromProfiles(ruleSet: var CompilerCsgReachableFunctionSet,
                                                 profiles: var parser.NormalizedExprCallProfile[],
                                                 orderedSourceModules: var str[],
                                                 profileLineCounts: var int32[],
                                                 lineStore: var phase.PhaseArenaStore,
                                                 lineArena: phase.PhaseArenaHandle,
                                                 linePool: langintern.InternPool,
                                                 lineIdColumns: phase.PhaseArenaRef[],
                                                 lineIdCounts: int32[],
                                                 sourceIdentityIndex: var CompilerCsgSourcePathIndex,
                                                 err: var str): bool =
    ruleSet.structureVersion = ruleSet.structureVersion + Int64(1)
    ruleSet.structureSealedVersion = Int64(0)
    ruleSet.structureShapeSeal = Int64(0)
    ruleSet.graphVersion = ruleSet.graphVersion + Int64(1)
    ruleSet.graphSealedVersion = Int64(0)
    ruleSet.graphShapeSeal = Int64(0)
    CompilerCsgSourcePathIndexClear(ruleSet.profileSourceIndex)
    ruleSet.profileSourceIndex = CompilerCsgSourcePathIndexInitLike(sourceIdentityIndex,
                                                               profiles.len * 2 + 8)
    for sourceIndex in 0..<profiles.len:
        if sourceIndex % 64 == 0:
            os.ProcessResourceGuardCheck()
        var sourcePath: str
        if !CompilerCsgSourcePathIndexCanonicalKey(ruleSet.profileSourceIndex,
                                                    profiles[sourceIndex].sourcePath,
                                                    sourcePath,
                                                    err):
            return false
        var existingProfileIndex: int32
        if !CompilerCsgSourcePathIndexEquivalentForInsert(ruleSet.profileSourceIndex,
                                                           sourcePath,
                                                           existingProfileIndex,
                                                           err):
            return false
        if existingProfileIndex >= 0:
            err = Fmt" compiler csg: reachable profile source conflict source={sourcePath} first_profile={existingProfileIndex} next_profile={sourceIndex}"
            return false
        if !CompilerCsgSourcePathIndexRegister(ruleSet.profileSourceIndex,
                                               share(sourcePath),
                                               sourceIndex,
                                               err):
            return false
        let functionStart = ruleSet.functionNames.len
        add(ruleSet.profileFunctionStarts, functionStart)
        var ownerModulePath = profiles[sourceIndex].ownerModulePath
        if ownerModulePath == "" && sourceIndex < orderedSourceModules.len:
            ownerModulePath = orderedSourceModules[sourceIndex]
        let declOrder = CompilerCsgSortedExecutableDeclIndexes(profiles[sourceIndex])
        # PhaseArena CSG 文本族半片: scope-end 消费的行表从 lineStore 物化
        # (共享+retain, 与原 profiles[sourceIndex].lines 逐字同内容),
        # 本 source 用完即平衡释放。
        var scopeLines = CompilerCsgProfileLineSeqFromArena(lineStore,
                                                            lineArena,
                                                            share(linePool),
                                                            share(lineIdColumns),
                                                            share(lineIdCounts),
                                                            sourceIndex)
        for orderIndex in 0..<declOrder.len:
            let declIndex = declOrder[orderIndex]
            let decl = profiles[sourceIndex].decls[declIndex]
            let functionName = decl.name
            if decl.lineIndex <= 0:
                err = Fmt" compiler csg: reachable function start line invalid source={sourcePath} function={functionName} line={decl.lineIndex}"
                return false
            if orderIndex > 0:
                let previousDecl = profiles[sourceIndex].decls[declOrder[orderIndex - 1]]
                if previousDecl.lineIndex >= decl.lineIndex:
                    err = Fmt" compiler csg: reachable function start lines not strictly monotonic source={sourcePath} previous_function={previousDecl.name} previous_line={previousDecl.lineIndex} function={functionName} line={decl.lineIndex}"
                    return false
            let symbolText = parser.ParserConcat3(ownerModulePath, "::", functionName)
            let exportSymbolName = CompilerCsgTargetExportName(symbolText,
                                                                decl.explicitExportName,
                                                                functionName)
            var nextDeclLine: int32
            if orderIndex + 1 < declOrder.len:
                nextDeclLine = profiles[sourceIndex].decls[
                    declOrder[orderIndex + 1]].lineIndex
            let endLine = texpr.TypedExprFunctionScopeEndLine(
                scopeLines,
                decl.lineIndex,
                nextDeclLine)
            if endLine < decl.lineIndex:
                err = Fmt" compiler csg: reachable function range overlaps or exceeds source source={sourcePath} function={functionName} start={decl.lineIndex} end={endLine}"
                return false
            let functionIndex = ruleSet.functionNames.len
            add(ruleSet.sourcePaths, share(sourcePath))
            add(ruleSet.functionNames, share(functionName))
            add(ruleSet.symbolTexts, symbolText)
            add(ruleSet.exportSymbolNames, exportSymbolName)
            add(ruleSet.exportNameExplicitFlags, decl.explicitExportName.len > 0)
            add(ruleSet.producerSourceIndexes, sourceIndex)
            add(ruleSet.producerDeclarationIndexes, declIndex)
            add(ruleSet.functionNameSurfaceKinds, 0)
            add(ruleSet.functionNameProofCids, layout.FixedBytes32())
            add(ruleSet.functionAnnotationFlags, -1)
            add(ruleSet.functionDeclarationHeaderCids,
                layout.FixedBytes32())
            add(ruleSet.functionDeclarationPathCids,
                layout.FixedBytes32())
            add(ruleSet.keepExportBindingCids, layout.FixedBytes32())
            add(ruleSet.startLines, decl.lineIndex)
            add(ruleSet.endLines, endLine)
            add(ruleSet.reachable, false)
            add(ruleSet.edgeHeads, -1)
            add(ruleSet.functionProfileIndexes, sourceIndex)
            CompilerCsgReachableNameIndexAppend(ruleSet.scopedFunctionNames,
                                                ruleSet.scopedFunctionNameNext,
                                                sourceIndex,
                                                functionName,
                                                functionIndex)
            CompilerCsgReachableNameIndexAppend(ruleSet.globalFunctionNames,
                                                ruleSet.globalFunctionNameNext,
                                                -1,
                                                functionName,
                                                functionIndex)
        let profileFunctionCount = ruleSet.functionNames.len - functionStart
        add(ruleSet.profileFunctionCounts, profileFunctionCount)
        add(ruleSet.profileLineIndexProven, true)
        seqs.freeSeqStrRelease(scopeLines)
    return CompilerCsgReachableFunctionSetSealStructure(ruleSet, err)

@borrows
fn CompilerCsgReachableExpandRec(ruleSet: var CompilerCsgReachableFunctionSet,
                                 frontier: var int32[],
                                 cursor: int32) =
    while true:
        if cursor >= frontier.len:
            frontier = []
            return
        let functionIndex = frontier[cursor]
        if functionIndex < 0 || functionIndex >= ruleSet.edgeHeads.len:
            panic(Fmt"compiler csg: reachable frontier function index out of range index={functionIndex} count={ruleSet.edgeHeads.len}")
        ruleSet.certificateValidationOperationCount =
            ruleSet.certificateValidationOperationCount + Int64(1)
        if functionIndex >= ruleSet.edgeHeadCertificates.len ||
           ruleSet.edgeHeadCertificates[functionIndex] !=
               CompilerCsgReachableEdgeHeadCertificate(functionIndex,
                                                       ruleSet.edgeHeads[functionIndex]):
            panic(Fmt"compiler csg: reachable frontier edge-head certificate mismatch function={functionIndex}")
        var edgeIndex = ruleSet.edgeHeads[functionIndex]
        while edgeIndex >= 0:
            if edgeIndex >= ruleSet.edgeFrom.len || edgeIndex >= ruleSet.edgeTo.len ||
               edgeIndex >= ruleSet.edgeNext.len ||
               edgeIndex >= ruleSet.edgeRowCertificates.len:
                panic("compiler csg: reachable edge adjacency corrupt")
            ruleSet.certificateValidationOperationCount =
                ruleSet.certificateValidationOperationCount + Int64(1)
            if ruleSet.edgeRowCertificates[edgeIndex] !=
               CompilerCsgReachableEdgeRowCertificate(edgeIndex,
                                                      ruleSet.edgeFrom[edgeIndex],
                                                      ruleSet.edgeTo[edgeIndex],
                                                      ruleSet.edgeNext[edgeIndex]) ||
               ruleSet.edgeFrom[edgeIndex] != functionIndex:
                panic(Fmt"compiler csg: reachable frontier edge certificate mismatch edge={edgeIndex}")
            CompilerCsgReachableMark(ruleSet, ruleSet.edgeTo[edgeIndex], frontier)
            edgeIndex = ruleSet.edgeNext[edgeIndex]
        cursor = cursor + 1
        continue

fn CompilerCsgReachableExpand(ruleSet: var CompilerCsgReachableFunctionSet,
                               frontier: var int32[]) =
    CompilerCsgReachableExpandRec(ruleSet, frontier, 0)

@borrows
fn CompilerCsgValidateTypedIrReachabilityFunctionColumns(typedIr: texpr.TypedExprIr,
                                                          err: var str): bool =
    let functionCount = typedIr.functions2_functionNameIds.len
    let sourcePathCount = typedIr.functions2_sourcePathIds.len
    let signatureLineCount = arenamod.ArenaArrayInt32Len(typedIr.arena,
                                                         typedIr.functions2_signatureLineNumbers)
    if sourcePathCount != functionCount || signatureLineCount != functionCount:
        err = Fmt" compiler csg: typed ir reachability function columns mismatch functions={functionCount} source_paths={sourcePathCount} signature_lines={signatureLineCount}"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgValidateTypedIrReachabilityStatementColumns(
        typedIr: texpr.TypedExprIr,
        err: var str): bool =
    let statementCount = arenamod.ArenaArrayInt32Len(
        typedIr.arena, typedIr.statements2_statementIndexs)
    let lineCount = arenamod.ArenaArrayInt32Len(
        typedIr.arena, typedIr.statements2_lineNumbers)
    if typedIr.statements2_kinds.len != statementCount ||
       typedIr.statements2_callKinds.len != statementCount ||
       typedIr.statements2_callSurfaceKinds.len != statementCount ||
       typedIr.statements2_callTargetImportcs.len != statementCount ||
       typedIr.statements2_callTargetIds.len != statementCount ||
       typedIr.statements2_callTargetSourcePathIds.len != statementCount ||
       arenamod.ArenaArrayInt32Len(
           typedIr.arena,
           typedIr.statements2_callTargetSignatureLineNumbers) !=
           statementCount ||
       typedIr.statements2_callCalleeIds.len != statementCount ||
       typedIr.statements2_sourcePathIds.len != statementCount ||
       lineCount != statementCount:
        err = Fmt" compiler csg: typed ir statement columns mismatch statements={statementCount} kinds={typedIr.statements2_kinds.len} call_kinds={typedIr.statements2_callKinds.len} call_surfaces={typedIr.statements2_callSurfaceKinds.len} target_importc={typedIr.statements2_callTargetImportcs.len} target_ids={typedIr.statements2_callTargetIds.len} target_source_ids={typedIr.statements2_callTargetSourcePathIds.len} callee_ids={typedIr.statements2_callCalleeIds.len} source_ids={typedIr.statements2_sourcePathIds.len} lines={lineCount}"
        return false
    err = ""
    return true

fn CompilerCsgTypedIrStatementFromSoA(typedIr: var texpr.TypedExprIr,
                                      stmtIndex: int32): texpr.TypedExprIrStatement =
    # Hoist nested Value(LookupIntern)/SoA gets out of mega-ctor field exprs
    # (AggregateConstructor failCode 60 / bail=801 on return-position nested form).
    let sourcePath: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_sourcePathIds[stmtIndex]))
    let functionName: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_functionNameIds[stmtIndex]))
    let statementIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_statementIndexs, stmtIndex)
    let lineNumber = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_lineNumbers, stmtIndex)
    let columnNumber = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_columnNumbers, stmtIndex)
    let lineIndent = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_lineIndents, stmtIndex)
    let enclosingIfLineNumber = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_enclosingIfLineNumbers, stmtIndex)
    let enclosingIfConditionText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_enclosingIfConditionTextIds[stmtIndex]))
    let exprId: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_exprIdIds[stmtIndex]))
    let kind = typedIr.statements2_kinds[stmtIndex]
    let callKind = typedIr.statements2_callKinds[stmtIndex]
    let detailKind = typedIr.statements2_detailKinds[stmtIndex]
    let surfaceText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_surfaceTextIds[stmtIndex]))
    let bindingName: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_bindingNameIds[stmtIndex]))
    let resultType: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_resultTypeIds[stmtIndex]))
    let conditionKind = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_conditionKinds, stmtIndex)
    let conditionLhsText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_conditionLhsTextIds[stmtIndex]))
    let conditionRhsText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_conditionRhsTextIds[stmtIndex]))
    let conditionLiteralText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_conditionLiteralTextIds[stmtIndex]))
    let assignRootName: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignRootNameIds[stmtIndex]))
    let assignRootType: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignRootTypeIds[stmtIndex]))
    let assignRootSourcePath: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignRootSourcePathIds[stmtIndex]))
    let assignRootGlobalFlag = typedIr.statements2_assignRootGlobalFlags[stmtIndex]
    let assignPlaceKind = typedIr.statements2_assignPlaceKinds[stmtIndex]
    let assignFieldName: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignFieldNameIds[stmtIndex]))
    let assignFieldType: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignFieldTypeIds[stmtIndex]))
    let assignFieldOffsetBytes = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_assignFieldOffsetBytes, stmtIndex)
    let assignFieldSizeBytes = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_assignFieldSizeBytes, stmtIndex)
    let assignFieldAlignBytes = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_assignFieldAlignBytes, stmtIndex)
    let assignValueRootName: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignValueRootNameIds[stmtIndex]))
    let assignValueRootType: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignValueRootTypeIds[stmtIndex]))
    let assignValueFieldName: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignValueFieldNameIds[stmtIndex]))
    let assignValueFieldType: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignValueFieldTypeIds[stmtIndex]))
    let assignValueFieldOffsetBytes = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_assignValueFieldOffsetBytes, stmtIndex)
    let assignValueFieldSizeBytes = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_assignValueFieldSizeBytes, stmtIndex)
    let assignValueFieldAlignBytes = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_assignValueFieldAlignBytes, stmtIndex)
    let assignValueOpKind = typedIr.statements2_assignValueOpKinds[stmtIndex]
    let assignValueLhsText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignValueLhsTextIds[stmtIndex]))
    let assignValueRhsText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_assignValueRhsTextIds[stmtIndex]))
    let assignValueRhsConst = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_assignValueRhsConsts, stmtIndex)
    let assignValueRhsHasConst = typedIr.statements2_assignValueRhsHasConsts[stmtIndex]
    let callQualifier: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_callQualifierIds[stmtIndex]))
    let callCallee: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_callCalleeIds[stmtIndex]))
    let callTarget: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_callTargetIds[stmtIndex]))
    let callTargetSourcePath: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_callTargetSourcePathIds[stmtIndex]))
    let callTargetSignatureLineNumber = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.statements2_callTargetSignatureLineNumbers,
        stmtIndex)
    let callTargetImportc = typedIr.statements2_callTargetImportcs[stmtIndex]
    let callArgCount = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_callArgCounts, stmtIndex)
    let callArgsText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_callArgsTextIds[stmtIndex]))
    let callArgTypesText: str = Value(langintern.LookupIntern(typedIr.internPool, typedIr.statements2_callArgTypesTextIds[stmtIndex]))
    let callArgNodeStart = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_callArgNodeStarts, stmtIndex)
    let callArgNodeCount = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_callArgNodeCounts, stmtIndex)
    let rhsNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_rhsNodeIndexs, stmtIndex)
    let rhsBailReason = typedIr.statements2_rhsBailReasons[stmtIndex]
    let callSurfaceKind = typedIr.statements2_callSurfaceKinds[stmtIndex]
    let forStartNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_forStartNodeIndexs, stmtIndex)
    let assignLvalueNodeIndex = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.statements2_assignLvalueNodeIndexs,
        stmtIndex)
    let assignIndexNodeIndex = arenamod.ArenaArrayInt32Get(typedIr.arena, typedIr.statements2_assignIndexNodeIndexs, stmtIndex)
    let loweringMode = typedIr.statements2_loweringModes[stmtIndex]
    let returnKind = typedIr.statements2_returnKinds[stmtIndex]
    let returnRoot = typedIr.statements2_returnRoots[stmtIndex]
    return texpr.TypedExprIrStatement(
        sourcePath: sourcePath,
        functionName: functionName,
        statementIndex: statementIndex,
        lineNumber: lineNumber,
        columnNumber: columnNumber,
        lineIndent: lineIndent,
        enclosingIfLineNumber: enclosingIfLineNumber,
        enclosingIfConditionText: enclosingIfConditionText,
        exprId: exprId,
        kind: kind,
        callKind: callKind,
        detailKind: detailKind,
        surfaceText: surfaceText,
        bindingName: bindingName,
        resultType: resultType,
        conditionKind: conditionKind,
        conditionLhsText: conditionLhsText,
        conditionRhsText: conditionRhsText,
        conditionLiteralText: conditionLiteralText,
        assignRootName: assignRootName,
        assignRootType: assignRootType,
        assignRootSourcePath: assignRootSourcePath,
        assignRootGlobalFlag: assignRootGlobalFlag,
        assignPlaceKind: assignPlaceKind,
        assignFieldName: assignFieldName,
        assignFieldType: assignFieldType,
        assignFieldOffsetBytes: assignFieldOffsetBytes,
        assignFieldSizeBytes: assignFieldSizeBytes,
        assignFieldAlignBytes: assignFieldAlignBytes,
        assignValueRootName: assignValueRootName,
        assignValueRootType: assignValueRootType,
        assignValueFieldName: assignValueFieldName,
        assignValueFieldType: assignValueFieldType,
        assignValueFieldOffsetBytes: assignValueFieldOffsetBytes,
        assignValueFieldSizeBytes: assignValueFieldSizeBytes,
        assignValueFieldAlignBytes: assignValueFieldAlignBytes,
        assignValueOpKind: assignValueOpKind,
        assignValueLhsText: assignValueLhsText,
        assignValueRhsText: assignValueRhsText,
        assignValueRhsConst: assignValueRhsConst,
        assignValueRhsHasConst: assignValueRhsHasConst,
        callQualifier: callQualifier,
        callCallee: callCallee,
        callTarget: callTarget,
        callTargetSourcePath: callTargetSourcePath,
        callTargetSignatureLineNumber: callTargetSignatureLineNumber,
        callTargetImportc: callTargetImportc,
        callArgCount: callArgCount,
        callArgsText: callArgsText,
        callArgTypesText: callArgTypesText,
        callArgNodeStart: callArgNodeStart,
        callArgNodeCount: callArgNodeCount,
        rhsNodeIndex: rhsNodeIndex,
        rhsBailReason: rhsBailReason,
        callSurfaceKind: callSurfaceKind,
        forStartNodeIndex: forStartNodeIndex,
        assignLvalueNodeIndex: assignLvalueNodeIndex,
        assignIndexNodeIndex: assignIndexNodeIndex,
        loweringMode: loweringMode,
        returnKind: returnKind,
        returnRoot: returnRoot
    )


fn CompilerCsgReachableTargetFromCallDeclaration(
        ruleSet: var CompilerCsgReachableFunctionSet,
        typedIr: var texpr.TypedExprIr,
        receipt: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        declarationRow: int32,
        nodeTarget: str,
        nodeTargetSourcePath: str,
        nodeTargetSignatureLineNumber: int32,
        targetFunctionIndex: var int32,
        importcTarget: var bool,
        targetProducerSourceIndex: var int32,
        targetProducerDeclarationOrdinal: var int32,
        targetParserSourceLocalDeclarationRow: var int32,
        err: var str): bool =
    targetFunctionIndex = -1
    importcTarget = false
    targetProducerSourceIndex = -1
    targetProducerDeclarationOrdinal = -1
    targetParserSourceLocalDeclarationRow = -1
    let buildIndex = texpr.TypedExprIrCallDeclarationBuildIndex(typedIr)
    if buildIndex == nil:
        err = " compiler csg: exact call declaration index is unavailable"
        return false
    let declarationCount = buildIndex.callDeclarationKinds.len
    if declarationCount !=
           buildIndex.callDeclarationProducerSourceIndexes.len ||
       declarationCount !=
           buildIndex.callDeclarationProducerFunctionRows.len ||
       declarationCount !=
           buildIndex.callDeclarationProducerDeclarationOrdinals.len ||
       declarationRow < 0 || declarationRow >= declarationCount:
        err = Fmt" compiler csg: exact call declaration structural domain mismatch row={declarationRow} kinds={declarationCount} producer_sources={buildIndex.callDeclarationProducerSourceIndexes.len} producer_declaration_ordinals={buildIndex.callDeclarationProducerDeclarationOrdinals.len}"
        return false
    let declarationContext =
        buildIndex.callDeclarationProducerSourceIndexes[declarationRow]
    let producerDeclarationOrdinal =
        buildIndex.callDeclarationProducerDeclarationOrdinals[
            declarationRow]
    let localFunctionRow =
        buildIndex.callDeclarationProducerFunctionRows[declarationRow]
    if declarationContext < 0 ||
       declarationContext >= receipt.sourcePaths.len ||
       declarationContext >= receipt.sourceSidecars.len ||
       receipt.sourceSidecars[declarationContext].sourceIndex !=
           declarationContext:
        err = Fmt" compiler csg: exact call declaration producer source invalid row={declarationRow} producer_source={declarationContext} receipt_sources={receipt.sourcePaths.len} sidecars={receipt.sourceSidecars.len}"
        return false
    let sidecar = receipt.sourceSidecars[declarationContext]
    let declarationKind = buildIndex.callDeclarationKinds[declarationRow]
    targetProducerSourceIndex = declarationContext
    targetProducerDeclarationOrdinal = producerDeclarationOrdinal
    if declarationKind == texpr.TypedExprCallDeclarationImportc:
        if localFunctionRow != -1:
            err = Fmt" compiler csg: importc call carried executable Function row row={declarationRow} function_row={localFunctionRow}"
            return false
        var importcFunctionIndex: int32
        if !compilerCsgParserFunctionDeclarationCoordinateInto(
                sidecar,
                declarationContext,
                producerDeclarationOrdinal,
                true,
                targetParserSourceLocalDeclarationRow,
                importcFunctionIndex,
                err) ||
           importcFunctionIndex != -1:
            if err == "":
                err = " compiler csg: importc parser declaration identity drift"
            return false
        importcTarget = true
        if nodeTarget == "" || nodeTargetSourcePath == "" ||
           nodeTargetSignatureLineNumber != 0:
            err = Fmt" compiler csg: exact importc call payload invalid row={declarationRow} producer_source={declarationContext} declaration_ordinal={producerDeclarationOrdinal} parser_source_local_row={targetParserSourceLocalDeclarationRow} target={nodeTarget} source={nodeTargetSourcePath} signature_line={nodeTargetSignatureLineNumber}"
            return false
        err = ""
        return true
    if declarationKind != texpr.TypedExprCallDeclarationFunction:
        err = Fmt" compiler csg: exact call declaration kind invalid row={declarationRow} kind={Int32(declarationKind)}"
        return false
    if localFunctionRow < 0 ||
       localFunctionRow >= sidecar.functionIndexes.len ||
       localFunctionRow >=
           sidecar.functionDeclarationOrdinals.len:
        err = Fmt" compiler csg: exact call parser Function row invalid row={declarationRow} function_row={localFunctionRow} function_rows={sidecar.functionIndexes.len}"
        return false
    let resolvedFunctionIndex =
        sidecar.functionIndexes[localFunctionRow]
    if sidecar.functionDeclarationOrdinals[localFunctionRow] !=
           producerDeclarationOrdinal:
        err = Fmt" compiler csg: exact call parser declaration ordinal drift row={declarationRow} function_row={localFunctionRow}"
        return false
    var parserResolvedFunctionIndex: int32
    if !compilerCsgParserFunctionDeclarationCoordinateInto(
            sidecar,
            declarationContext,
            producerDeclarationOrdinal,
            false,
            targetParserSourceLocalDeclarationRow,
            parserResolvedFunctionIndex,
            err) ||
       parserResolvedFunctionIndex != resolvedFunctionIndex:
        if err == "":
            err = " compiler csg: parser Function row/declaration identity split"
        return false
    if resolvedFunctionIndex < 0 ||
       resolvedFunctionIndex >= ruleSet.functionNames.len ||
       resolvedFunctionIndex >= ruleSet.sourcePaths.len ||
       resolvedFunctionIndex >= ruleSet.startLines.len ||
       resolvedFunctionIndex >= ruleSet.producerSourceIndexes.len ||
       resolvedFunctionIndex >= ruleSet.producerDeclarationIndexes.len:
        err = Fmt" compiler csg: exact call declaration target index invalid row={declarationRow} target_index={resolvedFunctionIndex} functions={ruleSet.functionNames.len}"
        return false
    if ruleSet.producerSourceIndexes[resolvedFunctionIndex] !=
           declarationContext ||
       ruleSet.producerDeclarationIndexes[resolvedFunctionIndex] !=
           sidecar.functionDeclarationOrdinals[localFunctionRow]:
        err = Fmt" compiler csg: exact call declaration producer coordinate drift row={declarationRow} target_index={resolvedFunctionIndex} producer_source={ruleSet.producerSourceIndexes[resolvedFunctionIndex]}/{declarationContext} producer_decl={ruleSet.producerDeclarationIndexes[resolvedFunctionIndex]}/{producerDeclarationOrdinal}"
        return false
    # Text and line fields are payload checks after the structural coordinate
    # join.  They never select identity.
    if !CompilerCsgSourcePathsEquivalent(
           ruleSet.sourcePaths[resolvedFunctionIndex],
           nodeTargetSourcePath) ||
       ruleSet.functionNames[resolvedFunctionIndex] != nodeTarget ||
       ruleSet.startLines[resolvedFunctionIndex] !=
           nodeTargetSignatureLineNumber:
        err = Fmt" compiler csg: exact call declaration payload drift row={declarationRow} target_index={resolvedFunctionIndex} expected={ruleSet.sourcePaths[resolvedFunctionIndex]}:{ruleSet.startLines[resolvedFunctionIndex]}:{ruleSet.functionNames[resolvedFunctionIndex]} actual={nodeTargetSourcePath}:{nodeTargetSignatureLineNumber}:{nodeTarget}"
        return false
    targetFunctionIndex = resolvedFunctionIndex
    err = ""
    return true

@borrows
fn CompilerCsgReachableTargetFromFuncRefDeclaration(
        ruleSet: var CompilerCsgReachableFunctionSet,
        typedIr: var texpr.TypedExprIr,
        receipt: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        declarationRow: int32,
        targetFunctionIndex: var int32,
        err: var str): bool =
    targetFunctionIndex = -1
    let buildIndex = texpr.TypedExprIrCallDeclarationBuildIndex(typedIr)
    if buildIndex == nil || buildIndex.released ||
       !buildIndex.callDeclarationSealed || declarationRow < 0 ||
       declarationRow >= buildIndex.callDeclarationKinds.len ||
       buildIndex.callDeclarationKinds[declarationRow] !=
           texpr.TypedExprCallDeclarationFunction:
        err = Fmt" compiler csg: FuncRef CallDeclaration row invalid row={declarationRow}"
        return false
    # These strings are payload projected from the already-selected immutable
    # row. They validate producer drift inside the common join and never select
    # the target identity.
    let target = share(texpr.typedExprBuildIndexCallTargetSymbol(
        buildIndex, declarationRow))
    let targetSource = share(texpr.typedExprBuildIndexCallSourcePath(
        buildIndex, declarationRow))
    let targetSignatureLine =
        texpr.typedExprBuildIndexCallSignatureLineNumber(
            buildIndex, declarationRow)
    var importcTarget: bool
    var targetProducerSourceIndex: int32
    var targetProducerDeclarationOrdinal: int32
    var targetParserSourceLocalDeclarationRow: int32
    if !CompilerCsgReachableTargetFromCallDeclaration(
            ruleSet,
            typedIr,
            receipt,
            declarationRow,
            target,
            targetSource,
            targetSignatureLine,
            targetFunctionIndex,
            importcTarget,
            targetProducerSourceIndex,
            targetProducerDeclarationOrdinal,
            targetParserSourceLocalDeclarationRow,
            err):
        return false
    if importcTarget || targetFunctionIndex < 0:
        err = Fmt" compiler csg: FuncRef target is not a Cheng Function row={declarationRow} target={targetFunctionIndex}"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgFuncRefTargetTypedFunctionIndexInto(
        reachable: CompilerCsgSemanticReachableFunctionTable,
        slices: CompilerCsgSemanticExprSliceTable,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typedIr: texpr.TypedExprIr,
        nodeIndex: int32,
        targetTypedFunctionIndex: var int32,
        err: var str): bool =
    targetTypedFunctionIndex = -1
    if nodeIndex < 0 || nodeIndex >= typedIr.nodes2_nodeIndexs.len ||
       typedIr.nodes2_opKinds[nodeIndex] !=
           texpr.TypedExprIrOpFuncRef:
        err = Fmt" compiler csg: FuncRef target query node invalid node={nodeIndex}"
        return false
    let domain = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.nodes2_funcRefTargetDomains,
        nodeIndex)
    let declarationRow = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.nodes2_funcRefCallDeclarationRows,
        nodeIndex)
    let buildIndex = texpr.TypedExprIrCallDeclarationBuildIndex(typedIr)
    if domain !=
           Int32(texpr.TypedExprFuncRefTargetDomainCallDeclaration) ||
       buildIndex == nil || buildIndex.released ||
       !buildIndex.callDeclarationSealed || declarationRow < 0 ||
       declarationRow >= buildIndex.callDeclarationKinds.len ||
       declarationRow >=
           buildIndex.callDeclarationProducerSourceIndexes.len ||
       declarationRow >=
           buildIndex.callDeclarationProducerDeclarationOrdinals.len ||
       declarationRow >=
           buildIndex.callDeclarationProducerFunctionRows.len ||
       buildIndex.callDeclarationKinds[declarationRow] !=
           texpr.TypedExprCallDeclarationFunction:
        err = Fmt" compiler csg: FuncRef exact declaration identity invalid node={nodeIndex} domain={domain} row={declarationRow}"
        return false
    let producerSourceIndex =
        buildIndex.callDeclarationProducerSourceIndexes[declarationRow]
    let producerDeclarationOrdinal =
        buildIndex.callDeclarationProducerDeclarationOrdinals[
            declarationRow]
    let producerFunctionRow =
        buildIndex.callDeclarationProducerFunctionRows[declarationRow]
    if producerSourceIndex < 0 ||
       producerSourceIndex >= receipt.sourceSidecars.len ||
       receipt.sourceSidecars[producerSourceIndex].sourceIndex !=
           producerSourceIndex:
        err = Fmt" compiler csg: FuncRef producer source invalid node={nodeIndex} row={declarationRow} source={producerSourceIndex}"
        return false
    let sidecar = receipt.sourceSidecars[producerSourceIndex]
    if producerFunctionRow < 0 ||
       producerFunctionRow >= sidecar.functionIndexes.len ||
       producerFunctionRow >=
           sidecar.functionDeclarationOrdinals.len ||
       sidecar.functionDeclarationOrdinals[producerFunctionRow] !=
           producerDeclarationOrdinal:
        err = Fmt" compiler csg: FuncRef producer Function row invalid node={nodeIndex} row={declarationRow} function_row={producerFunctionRow}"
        return false
    let reachableFunctionIndex =
        sidecar.functionIndexes[producerFunctionRow]
    if reachableFunctionIndex < 0 ||
       reachableFunctionIndex >= reachable.producerSourceIndexes.len ||
       reachableFunctionIndex >=
           reachable.producerDeclarationIndexes.len ||
       reachableFunctionIndex >= slices.functionSliceIndexes.len ||
       reachable.producerSourceIndexes[reachableFunctionIndex] !=
           producerSourceIndex ||
       reachable.producerDeclarationIndexes[reachableFunctionIndex] !=
           producerDeclarationOrdinal:
        err = Fmt" compiler csg: FuncRef reachable producer join invalid node={nodeIndex} row={declarationRow} function={reachableFunctionIndex}"
        return false
    let sliceIndex = slices.functionSliceIndexes[reachableFunctionIndex]
    if sliceIndex < 0 || sliceIndex >= slices.functionIndex.len ||
       sliceIndex >= slices.typedIrFunctionIndexes.len ||
       slices.functionIndex[sliceIndex] != reachableFunctionIndex:
        err = Fmt" compiler csg: FuncRef semantic slice join invalid node={nodeIndex} function={reachableFunctionIndex} slice={sliceIndex}"
        return false
    targetTypedFunctionIndex =
        slices.typedIrFunctionIndexes[sliceIndex]
    if targetTypedFunctionIndex < 0 ||
       targetTypedFunctionIndex >=
           typedIr.functions2_functionNameIds.len:
        err = Fmt" compiler csg: FuncRef target TypedExpr row invalid node={nodeIndex} target={targetTypedFunctionIndex}"
        targetTypedFunctionIndex = -1
        return false
    err = ""
    return true

@borrows
fn CompilerCsgReachableExpandFromExactTypedIrFrontierRec(
        ruleSet: var CompilerCsgReachableFunctionSet,
        typedIr: var texpr.TypedExprIr,
        receipt: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        typedIrFunctionStart: int32,
        frontierFunctionIndexes: int32[],
        delta: var CompilerCsgReachabilityDelta,
        frontierOffset: int32,
        err: var str): bool =
    while true:
        if frontierOffset >= frontierFunctionIndexes.len:
            return true
        if frontierOffset % 256 == 0:
            os.ProcessResourceGuardCheck()
        let typedFunctionIndex = typedIrFunctionStart + frontierOffset
        let fromIndex = frontierFunctionIndexes[frontierOffset]
        if fromIndex < 0 || fromIndex >= ruleSet.functionNames.len ||
           fromIndex >= ruleSet.sourcePaths.len ||
           fromIndex >= ruleSet.startLines.len ||
           !CompilerCsgReachabilityDeltaIsReachable(ruleSet, delta, fromIndex):
            err = Fmt" compiler csg: exact typed-ir caller coordinate invalid frontier={frontierOffset} typed_index={typedFunctionIndex} function_index={fromIndex}"
            return false
        let typedSourceResult: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.functions2_sourcePathIds[typedFunctionIndex])
        let typedNameResult: Result[str] = langintern.LookupIntern(
            typedIr.internPool,
            typedIr.functions2_functionNameIds[typedFunctionIndex])
        if !IsOk(typedSourceResult) || !IsOk(typedNameResult):
            err = Fmt" compiler csg: exact typed-ir caller payload intern missing typed_index={typedFunctionIndex}"
            return false
        let typedSignatureLine = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.functions2_signatureLineNumbers,
            typedFunctionIndex)
        if !CompilerCsgSourcePathsEquivalent(
               Value(typedSourceResult), ruleSet.sourcePaths[fromIndex]) ||
           Value(typedNameResult) != ruleSet.functionNames[fromIndex] ||
           typedSignatureLine != ruleSet.startLines[fromIndex]:
            err = Fmt" compiler csg: exact typed-ir caller payload drift typed_index={typedFunctionIndex} function_index={fromIndex}"
            return false
        let nodeStart = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.functions2_nodeStarts, typedFunctionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            typedIr.arena, typedIr.functions2_nodeCounts, typedFunctionIndex)
        if nodeStart < 0 || nodeCount < 0 ||
           nodeStart > typedIr.nodes2_nodeIndexs.len - nodeCount:
            err = Fmt" compiler csg: exact typed-ir caller node range corrupt typed_index={typedFunctionIndex} start={nodeStart} count={nodeCount} nodes={typedIr.nodes2_nodeIndexs.len}"
            return false
        for nodeIndex in nodeStart..<nodeStart + nodeCount:
            let opKind = typedIr.nodes2_opKinds[nodeIndex]
            if opKind == texpr.TypedExprIrOpFuncRef:
                let targetDomain = arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_funcRefTargetDomains,
                    nodeIndex)
                let declarationRow = arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_funcRefCallDeclarationRows,
                    nodeIndex)
                if targetDomain !=
                       Int32(
                           texpr.TypedExprFuncRefTargetDomainCallDeclaration):
                    err = Fmt" compiler csg: FuncRef target domain invalid function_index={fromIndex} typed_node={nodeIndex} domain={targetDomain}"
                    return false
                var toIndex: int32
                if !CompilerCsgReachableTargetFromFuncRefDeclaration(
                        ruleSet,
                        typedIr,
                        receipt,
                        declarationRow,
                        toIndex,
                        err):
                    return false
                CompilerCsgReachabilityDeltaAddEdge(
                    ruleSet, delta, fromIndex, toIndex)
                CompilerCsgReachabilityDeltaMark(ruleSet, delta, toIndex)
                continue
            if opKind != texpr.TypedExprIrOpCallExpr:
                continue
            let declarationRow = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_callDeclarationIndexes,
                nodeIndex)
            let callKind = typedIr.nodes2_callKinds[nodeIndex]
            let nodeTargetResult: Result[str] = langintern.LookupIntern(
                typedIr.internPool,
                typedIr.nodes2_callTargetIds[nodeIndex])
            let nodeTargetSourceResult: Result[str] = langintern.LookupIntern(
                typedIr.internPool,
                typedIr.nodes2_callTargetSourcePathIds[nodeIndex])
            if !IsOk(nodeTargetResult) || !IsOk(nodeTargetSourceResult):
                err = Fmt" compiler csg: exact typed-ir call payload intern missing node={nodeIndex}"
                return false
            let nodeTarget = Value(nodeTargetResult)
            let nodeTargetSourcePath = Value(nodeTargetSourceResult)
            let nodeTargetSignatureLineNumber =
                arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_callTargetSignatureLineNumbers,
                    nodeIndex)
            if declarationRow < 0:
                let calleeNodeIndex = arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_operand2NodeIndexs,
                    nodeIndex)
                if callKind == texpr.TypedExprCallNone &&
                   nodeTarget == "" &&
                   nodeTargetSourcePath == "" &&
                   nodeTargetSignatureLineNumber == 0 &&
                   !typedIr.nodes2_callTargetImportcs[nodeIndex] &&
                   calleeNodeIndex >= 0 &&
                   calleeNodeIndex < nodeIndex &&
                   typedIr.nodes2_opKinds[calleeNodeIndex] ==
                       texpr.TypedExprIrOpFieldGet:
                    continue
                # The TypedExpr authority permits row-less CallExpr only for a
                # proven intrinsic enum or constructor/type call. Text is not
                # an identity source here.
                if callKind == texpr.TypedExprCallBuiltin ||
                   callKind == texpr.TypedExprCallResultIntrinsic ||
                   callKind == texpr.TypedExprCallProjection:
                    if nodeTarget != "" || nodeTargetSourcePath != "" ||
                       nodeTargetSignatureLineNumber != 0 ||
                       typedIr.nodes2_callTargetImportcs[nodeIndex]:
                        err = Fmt" compiler csg: intrinsic call carries declaration identity function_index={fromIndex} typed_node={nodeIndex} kind={Int32(callKind)}"
                        return false
                    continue
                if nodeTarget != "" && nodeTargetSourcePath != "" &&
                   nodeTargetSignatureLineNumber == 0 &&
                   !typedIr.nodes2_callTargetImportcs[nodeIndex] &&
                   callKind == texpr.TypedExprCallNone:
                    continue
                let originParserNodeId = arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_originParserNodeIds,
                    nodeIndex)
                err = Fmt" compiler csg: executable call lacks exact call-declaration identity function_index={fromIndex} typed_node={nodeIndex} parser_node={originParserNodeId} target={nodeTarget} source={nodeTargetSourcePath} signature_line={nodeTargetSignatureLineNumber}"
                return false
            if callKind != texpr.TypedExprCallNone:
                err = Fmt" compiler csg: declaration call carries intrinsic identity function_index={fromIndex} typed_node={nodeIndex} row={declarationRow} kind={Int32(callKind)}"
                return false
            var toIndex: int32
            var importcTarget: bool
            var targetProducerSourceIndex: int32
            var targetProducerDeclarationOrdinal: int32
            var targetParserSourceLocalDeclarationRow: int32
            if !CompilerCsgReachableTargetFromCallDeclaration(
                    ruleSet,
                    typedIr,
                    receipt,
                    declarationRow,
                    nodeTarget,
                    nodeTargetSourcePath,
                    nodeTargetSignatureLineNumber,
                    toIndex,
                    importcTarget,
                    targetProducerSourceIndex,
                    targetProducerDeclarationOrdinal,
                    targetParserSourceLocalDeclarationRow,
                    err):
                return false
            if importcTarget:
                if !typedIr.nodes2_callTargetImportcs[nodeIndex]:
                    err = Fmt" compiler csg: exact importc declaration/node flag drift row={declarationRow} node={nodeIndex}"
                    return false
                continue
            if typedIr.nodes2_callTargetImportcs[nodeIndex] || toIndex < 0:
                err = Fmt" compiler csg: exact Cheng call declaration/node flag drift row={declarationRow} node={nodeIndex} target_index={toIndex}"
                return false
            CompilerCsgReachabilityDeltaAddEdge(ruleSet, delta, fromIndex, toIndex)
            CompilerCsgReachabilityDeltaMark(ruleSet, delta, toIndex)
        frontierOffset = frontierOffset + 1
        continue

@borrows
fn CompilerCsgReachableExpandFromExactTypedIr(
        ruleSet: var CompilerCsgReachableFunctionSet,
        typedIr: var texpr.TypedExprIr,
        receipt: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        typedIrFunctionStart: int32,
        frontierFunctionIndexes: int32[],
        statementCursor: var int32,
        functionCursor: var int32,
        err: var str): bool =
    if !ruleSet.active:
        statementCursor = typedIr.statements2_statementIndexs.len
        functionCursor = typedIr.functions2_functionNameIds.len
        err = ""
        return true
    var needsSeal: bool
    if !CompilerCsgReachableFunctionSetValidateForTransaction(ruleSet,
                                                               needsSeal,
                                                               err):
        return false
    if !CompilerCsgValidateTypedIrReachabilityFunctionColumns(typedIr, err):
        return false
    let typedFunctionEnd = typedIr.functions2_functionNameIds.len
    if typedIrFunctionStart < 0 ||
       typedIrFunctionStart > typedFunctionEnd ||
       typedFunctionEnd - typedIrFunctionStart !=
           frontierFunctionIndexes.len ||
       functionCursor != typedIrFunctionStart:
        err = Fmt" compiler csg: exact typed-ir frontier range drift start={typedIrFunctionStart} end={typedFunctionEnd} frontier={frontierFunctionIndexes.len} cursor={functionCursor}"
        return false
    var delta = CompilerCsgReachabilityDeltaInit()
    if !CompilerCsgReachableExpandFromExactTypedIrFrontierRec(
           ruleSet,
           typedIr,
           receipt,
           typedIrFunctionStart,
           frontierFunctionIndexes,
           delta,
           0,
           err):
        return false
    CompilerCsgReachabilityDeltaExpand(ruleSet, delta)
    if !CompilerCsgReachabilityDeltaCommit(ruleSet, delta, err):
        return false
    statementCursor = typedIr.statements2_statementIndexs.len
    functionCursor = typedFunctionEnd
    err = ""
    return true

@borrows
fn CompilerCsgIsJsonBracketApi(sourcePathRaw: str, functionName: str): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let suffix = "/src/std/json.cheng"
    if len(sourcePath) < len(suffix):
        return false
    if strings.SliceBytes(sourcePath, len(sourcePath) - len(suffix), len(suffix)) != suffix:
        return false
    return functionName == "[]" || functionName == "[]="

# A-minimal 融合:json.cheng 公共 API(bracket []=/[] 算子 + Json*/NewJ*/HasKey 等)
# 始终保留免可达性裁剪。bracket 是 NormalizedExprAssign(非 Call)、不发 typedExprFact,
# 被可达性传播整类跳过 → json 函数永不标可达 → 后端 chokepoint 解析不了 → bail=0/44
# (Group G bracket-assign + bracket-read)。强制保留使其进 typedIr.functions,chokepoint
# 经 any-source 臂命中 []/[]= 算子。排除 jsonParse* 内部解析器(其含 unsupported 语句,
# 深度走遍会硬 bail)。镜像 PrimaryBodyIrSourcePathIsStdSystem 的后缀匹配约定。
@borrows
fn CompilerCsgIsAlwaysRetainedJsonApi(sourcePathRaw: str, functionName: str): bool =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let suffix = "/src/std/json.cheng"
    if len(sourcePath) < len(suffix):
        return false
    if strings.SliceBytes(sourcePath, len(sourcePath) - len(suffix), len(suffix)) != suffix:
        return false
    # 仅保留 bracket 算子 []/[]= + Json* typed setter/getter。排除 json* 小写内部
    # helper(jsonWriteNodePretty/jsonPrettyStringifiedLen 等含自身 lowering bail,
    # 走遍会硬 bail 上浮)与 jsonParse* 解析器。
    if CompilerCsgIsJsonBracketApi(sourcePathRaw, functionName):
        return true
    if len(functionName) >= 4 &&
       strings.SliceBytes(functionName, 0, 4) == "Json":
        return true
    return false

# 同族: 后端在 bodyIR 合成阶段(远晚于本可达性扫描)直接向
# callSequence 追加对 std/system.cheng 内 Panic/assert/Assert 的 CallOp
# (见 PrimaryBodyIrAppendResultValuePanicGuard 等) — 这些调用从不以源码
# 文本形式出现在任何函数体内, 所以逐行 call-edge 扫描结构性地看不到它们,
# 与上面 json bracket 算子(NormalizedExprAssign 非 Call, 不发 typedExprFact)
# 是同一类"合成边不进可达性传播"问题, 修法同源: 强制保留, 不按调用边推导。
# 窄 export-root 闭包(如 obj + 少量 roots)下真实撞到: 无任何真实调用者引用
# Panic 时, 该行在此扫描后被裁掉, 之后 lowering_plan.cheng 的
# LoweringFunctionIsBackendSyntheticRoot(同名单, 第二道保险)已无行可留 —
# 必须在本层(CSG 闭包源头)就保留, 光靠下游第二道保险不够。
@borrows
fn CompilerCsgIsAlwaysRetainedBackendSyntheticRoot(sourcePathRaw: str, functionName: str): bool =
    if functionName != "Panic" && functionName != "assert" && functionName != "Assert":
        return false
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let suffix = "/src/std/system.cheng"
    if len(sourcePath) < len(suffix):
        return false
    return strings.SliceBytes(sourcePath, len(sourcePath) - len(suffix), len(suffix)) == suffix

# Scan every profile that still holds a reachable-but-unprocessed function and
# collect its call edges, to a fixed point. Function-level `processedFunctions`
# and per-profile `localScannedProfiles` persist across calls, so re-invoking
# after later reachability growth (typed facts / typed-IR rounds) only scans the
# newly reachable functions' lines — closing the exe-prune coverage gap where a
# function marked reachable late never had its external/qualified call edges
# collected (missing_call_target on strutil.Join / same-file leaf helpers).
@borrows
fn CompilerCsgBuildReachableFunctionSet(linkPlan: var slplan.SystemLinkPlanStub,
                                         stableEntryPath: str,
                                         sourceSnapshots: var CompilerCsgSourceText[],
                                         sourceSnapshotIndex: var CompilerCsgSourcePathIndex,
                                         exprCallProfiles: var parser.NormalizedExprCallProfile[],
                                         orderedSourceModules: var str[],
                                         profileLineCounts: var int32[],
                                         lineStore: var phase.PhaseArenaStore,
                                         lineArena: phase.PhaseArenaHandle,
                                         linePool: langintern.InternPool,
                                         lineIdColumns: phase.PhaseArenaRef[],
                                         lineIdCounts: int32[],
                                         profileIndexLookup: var parser.ParserSourcePathIndexLookup,
                                         profileCallLookupCache: var CompilerCsgProfileCallLookupStore,
                                         ruleSet: var CompilerCsgReachableFunctionSet,
                                         processedFunctions: var bool[],
                                         localScannedProfiles: var bool[],
                                         reachableCursor: var int32,
                                         queuedProfiles: var bool[],
                                         pendingProfiles: var int32[],
                                         err: var str): bool =
    var active = false
    if linkPlan.emitKind == creq.EmitExe:
        active = true
    elif linkPlan.emitKind == creq.EmitObj:
        active = true
    ruleSet = CompilerCsgReachableFunctionSetInit(active)
    if linkPlan.emitKind == creq.EmitObj:
        ruleSet.keepExportedSymbolNodes = true
    if !CompilerCsgReachableAddFunctionsFromProfiles(ruleSet,
                                                     exprCallProfiles,
                                                     orderedSourceModules,
                                                     profileLineCounts,
                                                     lineStore,
                                                     lineArena,
                                                     linePool,
                                                     lineIdColumns,
                                                     lineIdCounts,
                                                     sourceSnapshotIndex,
                                                     err):
        return false
    if !active:
        err = ""
        return true
    if linkPlan.emitKind == creq.EmitObj && linkPlan.exportRootSymbols.len <= 0:
        # 小编译单元(obj)未声明 export-roots 时保持全量构建：obj 发射需
        # 导出全集。显式 export-roots 是调用方给出的 ABI 根集合，必须
        # 走下面的 root 可达分支，否则大 FFI 单元会无条件吃完整闭包。
        var smallUnitFrontier: int32[]
        for smallUnitIndex in 0..<ruleSet.functionNames.len:
            CompilerCsgReachableMark(ruleSet, smallUnitIndex, smallUnitFrontier)
        # obj keeps every function: no call-edge discovery is needed.
        CompilerCsgEnsureBoolLen(processedFunctions, ruleSet.functionNames.len)
        for smallUnitIndex in 0..<processedFunctions.len:
            processedFunctions[smallUnitIndex] = true
        reachableCursor = ruleSet.reachableQueue.len
        err = ""
        return true
    var frontier: int32[]
    if linkPlan.emitKind == creq.EmitExe:
        let entryIndex = CompilerCsgReachableFindEntry(ruleSet,
                                                       stableEntryPath,
                                                       linkPlan.entrySymbol)
        if entryIndex == -2:
            err = Fmt" compiler csg: reachable entry ambiguous: {linkPlan.entrySymbol}"
            return false
        if entryIndex < 0:
            err = Fmt" compiler csg: reachable entry missing: {linkPlan.entrySymbol}"
            return false
        CompilerCsgReachableMark(ruleSet, entryIndex, frontier)
    elif linkPlan.emitKind == creq.EmitObj:
        if linkPlan.exportRootSymbols.len > 0:
            for rootIndex in 0..<linkPlan.exportRootSymbols.len:
                let root = linkPlan.exportRootSymbols[rootIndex]
                let functionIndex = CompilerCsgReachableFindRoot(ruleSet, root, stableEntryPath)
                if functionIndex == -2:
                    err = Fmt" compiler csg: reachable export root ambiguous: {root}"
                    return false
                if functionIndex < 0:
                    # Roots are a visibility request over the provider closure:
                    # absent roots are exported by whichever unit defines them;
                    # link-level unresolved checks own the closure contract.
                    continue
                CompilerCsgReachableMark(ruleSet, functionIndex, frontier)
        else:
            var entryRootCount: int32
            for functionIndex in 0..<ruleSet.functionNames.len:
                if functionIndex >= ruleSet.sourcePaths.len:
                    continue
                if !CompilerCsgSourcePathsEquivalent(ruleSet.sourcePaths[functionIndex], stableEntryPath):
                    continue
                CompilerCsgReachableMark(ruleSet, functionIndex, frontier)
                entryRootCount = entryRootCount + 1
            if entryRootCount <= 0:
                err = Fmt" compiler csg: reachable obj entry source has no functions: {stableEntryPath}"
                return false
    # A-minimal:强制保留 json.cheng 公共 API 函数。export-root obj 只强留
    # bracket API；Json* 若真实被 root 调到，会由调用边进入，不能在大 FFI
    # 裁剪模式下全局拉入无关 JSON helper。
    let exportRootObjPruneMode = linkPlan.emitKind == creq.EmitObj && linkPlan.exportRootSymbols.len > 0
    for retainIdx in 0..<ruleSet.functionNames.len:
        if retainIdx < ruleSet.sourcePaths.len &&
           CompilerCsgIsAlwaysRetainedJsonApi(ruleSet.sourcePaths[retainIdx], ruleSet.functionNames[retainIdx]):
            if exportRootObjPruneMode &&
               !CompilerCsgIsJsonBracketApi(ruleSet.sourcePaths[retainIdx], ruleSet.functionNames[retainIdx]):
                continue
            CompilerCsgReachableMark(ruleSet, retainIdx, frontier)
        elif retainIdx < ruleSet.sourcePaths.len &&
             CompilerCsgIsAlwaysRetainedBackendSyntheticRoot(ruleSet.sourcePaths[retainIdx], ruleSet.functionNames[retainIdx]):
            CompilerCsgReachableMark(ruleSet, retainIdx, frontier)
        elif retainIdx < ruleSet.exportNameExplicitFlags.len &&
             ruleSet.exportNameExplicitFlags[retainIdx]:
            # @exported 函数是 ABI 根: 符号按注解契约出现在产物里(见
            # CompilerCsgShouldExportSymbol), 与 main 同类, 不能按调用边推导 —
            # 源内可以没有任何调用者(如 system.cheng 的 panicPtrBridge 只被
            # 生成代码/运行库引用)。exe 导出全部显式注解; shared/obj 的导出域
            # 由 entry-source/显式 roots 限定, 那里不按注解强留。
            if exportRootObjPruneMode || linkPlan.emitKind != creq.EmitExe:
                continue
            CompilerCsgReachableMark(ruleSet, retainIdx, frontier)
    CompilerCsgReachableExpand(ruleSet, frontier)
    err = ""
    return true

@borrows
fn CompilerCsgGraphCid(packageId: str,
                         sourceBundleCid: layout.FixedBytes32,
                         workspaceRoot: str,
                         packageRoot: str,
                         externalPackageRoots: parser.ParserExternalPackageRoot[],
                         overrides: CompilerCsgSourceText[],
                         semanticGraph: CompilerCsgSemanticGraph,
                         nodes: CompilerCsgNode[],
                         edges: CompilerCsgEdge[]): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(512)
    CompilerCsgAppendText(buf, "cheng.compiler.csg.graph")
    CompilerCsgAppendText(buf, packageId)
    CompilerCsgAppendFixed32(buf, sourceBundleCid)
    let _ = workspaceRoot
    let _ = packageRoot
    CompilerCsgAppendU32BE(buf, semanticGraph.exprSummary.sourceCount)
    CompilerCsgAppendU32BE(buf, semanticGraph.exprSummary.exprCount)
    CompilerCsgAppendU32BE(buf, semanticGraph.exprSummary.questionResidualCount)
    CompilerCsgAppendU32BE(buf, CompilerCsgSemanticTypedFactCount(semanticGraph))
    CompilerCsgAppendU32BE(buf, semanticGraph.sourceTable.sourcePaths.len)
    for i in 0..<semanticGraph.sourceTable.sourcePaths.len:
        CompilerCsgAppendText(buf, semanticGraph.sourceTable.sourcePaths[i])
        CompilerCsgAppendText(buf, semanticGraph.sourceTable.modulePaths[i])
        CompilerCsgAppendU32BE(buf, semanticGraph.sourceTable.textBytes[i])
        CompilerCsgAppendU32BE(buf, semanticGraph.sourceTable.declStart[i])
        CompilerCsgAppendU32BE(buf, semanticGraph.sourceTable.declCount[i])
        CompilerCsgAppendU32BE(
            buf, semanticGraph.sourceTable.importEdgeStart[i])
        CompilerCsgAppendU32BE(
            buf, semanticGraph.sourceTable.importEdgeCount[i])
    CompilerCsgAppendU32BE(buf, semanticGraph.declTable.names.len)
    for i in 0..<semanticGraph.declTable.names.len:
        CompilerCsgAppendU32BE(buf, semanticGraph.declTable.sourceIndex[i])
        CompilerCsgAppendText(buf, semanticGraph.declTable.names[i])
        CompilerCsgAppendU32BE(buf, semanticGraph.declTable.lineNumbers[i])
        CompilerCsgAppendU32BE(
            buf,
            CompilerCsgSemanticBoolToInt(
                semanticGraph.declTable.importc[i]))
        CompilerCsgAppendU32BE(
            buf,
            CompilerCsgSemanticBoolToInt(
                semanticGraph.declTable.exported[i]))
    CompilerCsgAppendU32BE(
        buf, semanticGraph.importEdgeTable.ownerSourceIndex.len)
    for i in 0..<semanticGraph.importEdgeTable.ownerSourceIndex.len:
        CompilerCsgAppendU32BE(
            buf, semanticGraph.importEdgeTable.ownerSourceIndex[i])
        CompilerCsgAppendU32BE(
            buf, semanticGraph.importEdgeTable.targetSourceIndex[i])
        CompilerCsgAppendText(
            buf, semanticGraph.importEdgeTable.ownerModulePaths[i])
        CompilerCsgAppendText(
            buf, semanticGraph.importEdgeTable.targetModulePaths[i])
        CompilerCsgAppendText(
            buf, semanticGraph.importEdgeTable.targetSourcePaths[i])
        CompilerCsgAppendU32BE(
            buf,
            CompilerCsgSemanticBoolToInt(
                semanticGraph.importEdgeTable.resolved[i]))
    CompilerCsgAppendU32BE(buf, nodes.len)
    for i in 0..<nodes.len:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        CompilerCsgAppendU32BE(buf, nodes[i].nodeId)
        CompilerCsgAppendFixed32(buf, nodes[i].factCid)
    CompilerCsgAppendU32BE(buf, edges.len)
    for i in 0..<edges.len:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        CompilerCsgAppendU32BE(buf, edges[i].edgeId)
        CompilerCsgAppendFixed32(buf, edges[i].edgeCid)
    return CompilerCsgBufCid(buf)

@borrows
fn CompilerCsgCanonicalGraphCid(packageId: str,
                               nodes: var CompilerCsgNode[],
                               edges: var CompilerCsgEdge[]): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(512)
    CompilerCsgAppendText(buf, "cheng.compiler.csg.canonical_graph")
    CompilerCsgAppendText(buf, packageId)
    CompilerCsgAppendU32BE(buf, nodes.len)
    for i in 0..<nodes.len:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        CompilerCsgAppendU32BE(buf, nodes[i].nodeId)
        CompilerCsgAppendFixed32(buf, nodes[i].factCid)
    CompilerCsgAppendU32BE(buf, edges.len)
    for i in 0..<edges.len:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        CompilerCsgAppendU32BE(buf, edges[i].edgeId)
        CompilerCsgAppendFixed32(buf, edges[i].edgeCid)
    return CompilerCsgBufCid(buf)

@borrows
fn CompilerCsgAddUnique(items: var str[],
                          text: str) =
    for i in 0..<items.len:
        if items[i] == text:
            return
    add(items, parser.ParserOwnedText(text))

fn CompilerCsgDeclImportcMask(
        decls: var parser.NormalizedFunctionDecl[]): str =
    var parts: str[]
    for i in 0..<decls.len:
        if decls[i].importc:
            add(parts, "1")
        else:
            add(parts, "0")
    return strutil.Join(parts, "")

fn CompilerCsgDeclMaskIsImportc(mask: str,
                                  index: int32): bool =
    if index < 0 || index >= mask.len:
        return false
    return mask[index] == '1'

@borrows
fn CompilerCsgDeclNamesFromDeclsWithMask(decls: var parser.NormalizedFunctionDecl[],
                                           importcMask: str,
                                           importcFlag: int32): str[] =
    var out: str[]
    var seen = CompilerCsgTextSetInit(decls.len * 2 + 8)
    for i in 0..<decls.len:
        var declImportcFlag: int32
        if i >= 0 && i < importcMask.len && importcMask[i] == '1':
            declImportcFlag = 1
        if declImportcFlag != importcFlag:
            continue
        if decls[i].name == "":
            continue
        CompilerCsgAddUniqueFast(out, seen, decls[i].name)
    seen = CompilerCsgTextSet()
    return out

fn CompilerCsgTextSetInit(minCap: int32): CompilerCsgTextSet =
    var out: CompilerCsgTextSet
    out.lookup = parser.ParserTextLookupInit(minCap)
    return out

@borrows
fn CompilerCsgTextSetInsert(seen: var CompilerCsgTextSet,
                              text: str): bool =
    if text == "":
        if seen.emptySeen:
            return false
        seen.emptySeen = true
        return true
    return parser.ParserTextLookupInsertExact(seen.lookup, text)

@borrows
fn CompilerCsgTextSetContains(seen: CompilerCsgTextSet,
                              text: str): bool =
    if text == "":
        return seen.emptySeen
    return parser.ParserTextLookupContainsExact(seen.lookup, text)

@borrows
fn CompilerCsgSemanticIdentityHashAppend(hashValue: int64,
                                         text: str,
                                         byteVisitCount: var int64): int64 =
    var out = hashValue * Int64(131) + Int64(text.len)
    byteVisitCount = byteVisitCount + Int64(text.len)
    for byteIndex in 0..<text.len:
        out = out * Int64(131) + Int64(text[byteIndex])
    return out

@borrows
fn CompilerCsgSemanticIdentityNameHash(source: str,
                                       functionName: str,
                                       byteVisitCount: var int64): int64 =
    var out: int64 = Int64(1469598103934665603)
    out = CompilerCsgSemanticIdentityHashAppend(out, source, byteVisitCount)
    return CompilerCsgSemanticIdentityHashAppend(out,
                                                 functionName,
                                                 byteVisitCount)

@borrows
fn CompilerCsgSemanticIdentitySignatureHash(nameHash: int64,
                                            paramTypeJoin: str,
                                            returnType: str,
                                            byteVisitCount: var int64): int64 =
    var out = CompilerCsgSemanticIdentityHashAppend(nameHash,
                                                    paramTypeJoin,
                                                    byteVisitCount)
    return CompilerCsgSemanticIdentityHashAppend(out,
                                                 returnType,
                                                 byteVisitCount)

@borrows
fn CompilerCsgSemanticIdentityIndexCapacityBytes(
        index: CompilerCsgSemanticIdentityIndex): int64 =
    # Retained capacity is heap payload only. The twelve inline sequence
    # headers belong to the index value itself and remain after release.
    return (Int64(index.nameBucketHeads.cap) +
            Int64(index.signatureBucketHeads.cap) +
            Int64(index.nameNextIndexes.cap) +
            Int64(index.signatureNextIndexes.cap) +
            Int64(index.signatureCompleteFlags.cap)) * CompilerCsgI32Bytes() +
           Int64(index.nameIndexedFlags.cap) * CompilerCsgBoolBytes() +
           (Int64(index.nameHashes.cap) +
            Int64(index.signatureHashes.cap)) * Int64(8) +
           (Int64(index.borrowedSources.cap) +
            Int64(index.borrowedFunctionNames.cap) +
            Int64(index.borrowedParamTypeJoins.cap) +
            Int64(index.borrowedReturnTypes.cap)) * CompilerCsgStrHeaderBytes()

@borrows
fn CompilerCsgSemanticIdentityIndexEntryCount(
        index: CompilerCsgSemanticIdentityIndex): int32 =
    return index.borrowedSources.len

@borrows
fn CompilerCsgSemanticIdentityIndexProbeVisitCount(
        index: CompilerCsgSemanticIdentityIndex): int64 =
    return index.lookupProbeVisitCount

@borrows
fn CompilerCsgSemanticIdentityIndexHashInputByteVisitCount(
        index: CompilerCsgSemanticIdentityIndex): int64 =
    return index.hashInputByteVisitCount

@borrows
fn CompilerCsgSemanticIdentityIndexCompositeKeyPayloadBytes(
        index: CompilerCsgSemanticIdentityIndex): int64 =
    return index.compositeKeyPayloadBytes

@borrows
fn CompilerCsgSemanticIdentityIndexRetainedCapacityBytes(
        index: CompilerCsgSemanticIdentityIndex): int64 =
    return index.retainedCapacityBytes

@borrows
fn CompilerCsgSemanticIdentityIndexPeakRetainedCapacityBytes(
        index: CompilerCsgSemanticIdentityIndex): int64 =
    return index.peakRetainedCapacityBytes

fn CompilerCsgSemanticIdentityIndexRefreshCapacityLedger(index: var CompilerCsgSemanticIdentityIndex) =
    index.retainedCapacityBytes =
        CompilerCsgSemanticIdentityIndexCapacityBytes(index)
    if index.retainedCapacityBytes > index.peakRetainedCapacityBytes:
        index.peakRetainedCapacityBytes = index.retainedCapacityBytes

@borrows
fn CompilerCsgSemanticIdentityIndexColumnsValid(
        index: CompilerCsgSemanticIdentityIndex): bool =
    let rowCount = index.borrowedSources.len
    return index.borrowedFunctionNames.len == rowCount &&
           index.borrowedParamTypeJoins.len == rowCount &&
           index.borrowedReturnTypes.len == rowCount &&
           index.signatureCompleteFlags.len == rowCount &&
           index.nameIndexedFlags.len == rowCount &&
           index.nameNextIndexes.len == rowCount &&
           index.signatureNextIndexes.len == rowCount &&
           index.nameHashes.len == rowCount &&
           index.signatureHashes.len == rowCount

fn CompilerCsgSemanticIdentityIndexRehash(index: var CompilerCsgSemanticIdentityIndex,
                                          newBucketCount: int32) =
    if newBucketCount < 16 || (newBucketCount & (newBucketCount - 1)) != 0:
        panic("compiler csg: semantic identity bucket count must be power of two")
    if !CompilerCsgSemanticIdentityIndexColumnsValid(index):
        panic("compiler csg: semantic identity columns mismatch before rehash")
    var nameHeads: int32[]
    var signatureHeads: int32[]
    for bucketIndex in 0..<newBucketCount:
        if bucketIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        add(nameHeads, -1)
        add(signatureHeads, -1)
    let mask = newBucketCount - 1
    for rowIndex in 0..<index.borrowedSources.len:
        if rowIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        if index.nameIndexedFlags[rowIndex]:
            let nameBucket = Int32(index.nameHashes[rowIndex] & Int64(mask))
            index.nameNextIndexes[rowIndex] = nameHeads[nameBucket]
            nameHeads[nameBucket] = rowIndex
        else:
            index.nameNextIndexes[rowIndex] = -1
        if index.signatureCompleteFlags[rowIndex] != 0:
            let signatureBucket = Int32(index.signatureHashes[rowIndex] &
                                        Int64(mask))
            index.signatureNextIndexes[rowIndex] =
                signatureHeads[signatureBucket]
            signatureHeads[signatureBucket] = rowIndex
        else:
            index.signatureNextIndexes[rowIndex] = -1
    index.nameBucketHeads = nameHeads
    index.signatureBucketHeads = signatureHeads
    CompilerCsgSemanticIdentityIndexRefreshCapacityLedger(index)

fn CompilerCsgSemanticIdentityIndexEnsureInsertCapacity(index: var CompilerCsgSemanticIdentityIndex) =
    if index.nameBucketHeads.len <= 0:
        CompilerCsgSemanticIdentityIndexRehash(index, 16)
        return
    if (index.borrowedSources.len + 1) * 4 <
       index.nameBucketHeads.len * 3:
        return
    CompilerCsgSemanticIdentityIndexRehash(index,
                                           index.nameBucketHeads.len * 2)

fn CompilerCsgSemanticIdentityIndexInit(expectedRowCount: int32): CompilerCsgSemanticIdentityIndex =
    if expectedRowCount < 0 || expectedRowCount > 536870000:
        panic("compiler csg: semantic identity expected row count invalid")
    var out: CompilerCsgSemanticIdentityIndex
    reserve(out.nameNextIndexes, expectedRowCount)
    reserve(out.signatureNextIndexes, expectedRowCount)
    reserve(out.nameHashes, expectedRowCount)
    reserve(out.signatureHashes, expectedRowCount)
    reserve(out.borrowedSources, expectedRowCount)
    reserve(out.borrowedFunctionNames, expectedRowCount)
    reserve(out.borrowedParamTypeJoins, expectedRowCount)
    reserve(out.borrowedReturnTypes, expectedRowCount)
    reserve(out.signatureCompleteFlags, expectedRowCount)
    reserve(out.nameIndexedFlags, expectedRowCount)
    var bucketCount: int32 = 16
    let minimumBucketCount = expectedRowCount * 2 + 8
    while bucketCount < minimumBucketCount:
        bucketCount = bucketCount * 2
    CompilerCsgSemanticIdentityIndexRehash(out, bucketCount)
    return out

fn CompilerCsgSemanticIdentityIndexRelease(index: var CompilerCsgSemanticIdentityIndex) =
    index.nameBucketHeads = []
    index.signatureBucketHeads = []
    index.nameNextIndexes = []
    index.signatureNextIndexes = []
    index.nameHashes = []
    index.signatureHashes = []
    index.borrowedSources = []
    index.borrowedFunctionNames = []
    index.borrowedParamTypeJoins = []
    index.borrowedReturnTypes = []
    index.signatureCompleteFlags = []
    index.nameIndexedFlags = []
    index.retainedCapacityBytes = Int64(0)
    index.released = true

@borrows
fn CompilerCsgSemanticIdentityIndexValidateLedger(index: CompilerCsgSemanticIdentityIndex,
                                                   err: var str): bool =
    if !CompilerCsgSemanticIdentityIndexColumnsValid(index):
        err = " compiler csg: semantic identity index columns mismatch"
        return false
    let actualRetained = CompilerCsgSemanticIdentityIndexCapacityBytes(index)
    if index.retainedCapacityBytes != actualRetained ||
       index.peakRetainedCapacityBytes < actualRetained ||
       index.compositeKeyPayloadBytes != Int64(0):
        err = Fmt" compiler csg: semantic identity ledger mismatch retained={index.retainedCapacityBytes} actual={actualRetained} peak={index.peakRetainedCapacityBytes} composite={index.compositeKeyPayloadBytes}"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgSemanticIdentityIndexInsert(index: var CompilerCsgSemanticIdentityIndex,
                                          source: str,
                                          functionName: str,
                                          paramTypeJoin: str,
                                          returnType: str,
                                          signatureComplete: int32,
                                          err: var str): bool =
    if source == "" || functionName == "" ||
       (signatureComplete != 0 && signatureComplete != 1):
        err = Fmt" compiler csg: semantic identity row invalid source={source} function={functionName} complete={signatureComplete}"
        return false
    if index.released:
        err = " compiler csg: semantic identity index already released"
        return false
    if !CompilerCsgSemanticIdentityIndexColumnsValid(index) ||
       index.nameBucketHeads.len <= 0 ||
       index.nameBucketHeads.len != index.signatureBucketHeads.len:
        panic("compiler csg: semantic identity index corrupt before insert")
    var hashByteVisits: int64
    let nameHash = CompilerCsgSemanticIdentityNameHash(source,
                                                       functionName,
                                                       hashByteVisits)
    var signatureHash = nameHash
    if signatureComplete != 0:
        signatureHash = CompilerCsgSemanticIdentitySignatureHash(nameHash,
                                                                 paramTypeJoin,
                                                                 returnType,
                                                                 hashByteVisits)
    index.hashInputByteVisitCount = index.hashInputByteVisitCount +
                                    hashByteVisits
    let mask = index.nameBucketHeads.len - 1
    let nameBucket = Int32(nameHash & Int64(mask))
    var nameSeen = false
    var incompleteSeen = false
    var nameRow = index.nameBucketHeads[nameBucket]
    while nameRow >= 0:
        index.lookupProbeVisitCount = index.lookupProbeVisitCount + Int64(1)
        if index.nameHashes[nameRow] == nameHash &&
           index.borrowedSources[nameRow] == source &&
           index.borrowedFunctionNames[nameRow] == functionName:
            nameSeen = true
            if index.signatureCompleteFlags[nameRow] == 0:
                incompleteSeen = true
        nameRow = index.nameNextIndexes[nameRow]
    if signatureComplete == 0:
        if nameSeen:
            err = Fmt" compiler csg: incomplete semantic identity is ambiguous source={source} function={functionName}"
            return false
    elif incompleteSeen:
        err = Fmt" compiler csg: complete overload conflicts with incomplete semantic identity source={source} function={functionName}"
        return false
    else:
        let signatureBucket = Int32(signatureHash & Int64(mask))
        var signatureRow = index.signatureBucketHeads[signatureBucket]
        while signatureRow >= 0:
            index.lookupProbeVisitCount = index.lookupProbeVisitCount + Int64(1)
            if index.signatureHashes[signatureRow] == signatureHash &&
               index.borrowedSources[signatureRow] == source &&
               index.borrowedFunctionNames[signatureRow] == functionName &&
               index.borrowedParamTypeJoins[signatureRow] == paramTypeJoin &&
               index.borrowedReturnTypes[signatureRow] == returnType:
                err = Fmt" compiler csg: duplicate complete semantic signature source={source} function={functionName} params={paramTypeJoin} return={returnType}"
                return false
            signatureRow = index.signatureNextIndexes[signatureRow]

    CompilerCsgSemanticIdentityIndexEnsureInsertCapacity(index)
    let rowIndex = index.borrowedSources.len
    let commitMask = index.nameBucketHeads.len - 1
    let commitNameBucket = Int32(nameHash & Int64(commitMask))
    add(index.borrowedSources, parser.ParserOwnedText(source))
    add(index.borrowedFunctionNames, parser.ParserOwnedText(functionName))
    add(index.borrowedParamTypeJoins, parser.ParserOwnedText(paramTypeJoin))
    add(index.borrowedReturnTypes, parser.ParserOwnedText(returnType))
    add(index.signatureCompleteFlags, signatureComplete)
    add(index.nameIndexedFlags, !nameSeen)
    add(index.nameHashes, nameHash)
    add(index.signatureHashes, signatureHash)
    if !nameSeen:
        add(index.nameNextIndexes, index.nameBucketHeads[commitNameBucket])
        index.nameBucketHeads[commitNameBucket] = rowIndex
    else:
        add(index.nameNextIndexes, -1)
    if signatureComplete != 0:
        let commitSignatureBucket = Int32(signatureHash & Int64(commitMask))
        add(index.signatureNextIndexes,
            index.signatureBucketHeads[commitSignatureBucket])
        index.signatureBucketHeads[commitSignatureBucket] = rowIndex
    else:
        add(index.signatureNextIndexes, -1)
    CompilerCsgSemanticIdentityIndexRefreshCapacityLedger(index)
    err = ""
    return true

@borrows
fn CompilerCsgAddUniqueFast(items: var str[],
                              seen: var CompilerCsgTextSet,
                              text: str) =
    if CompilerCsgTextSetInsert(seen, text):
        add(items, parser.ParserOwnedText(text))

@borrows
fn CompilerCsgStrLess(left: str,
                        right: str): bool =
    if left == right:
        return false
    let leftLen = left.len
    let rightLen = right.len
    var sharedLen = rightLen
    if leftLen < rightLen:
        sharedLen = leftLen
    for i in 0..<sharedLen:
        if left[i] == right[i]:
            continue
        return left[i] < right[i]
    return leftLen < rightLen

fn CompilerCsgSortStrs(items: var str[]) =
    if items.len <= 1:
        return
    let count = items.len
    var scratch: str[]
    for i in 0..<count:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        add(scratch, share(items[i]))
    var width: int32 = 1
    var readScratch = false
    while width < count:
        if readScratch:
            CompilerCsgMergeSortStrsPass(scratch, items, width)
        else:
            CompilerCsgMergeSortStrsPass(items, scratch, width)
        readScratch = !readScratch
        if width > count / 2:
            width = count
        else:
            width = width * 2
    if readScratch:
        for i in 0..<count:
            if i % 4096 == 0:
                os.ProcessResourceGuardCheck()
            items[i] = scratch[i]

@borrows
fn CompilerCsgMergeSortStrsPassRec(src: var str[],
                                   dst: var str[],
                                   width: int32,
                                   leftStart: int32) =
    while true:
        let count = src.len
        if leftStart >= count:
            return
        if leftStart % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let midRaw = leftStart + width
        var mid = count
        if midRaw < count:
            mid = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = mid
        for outIndex in leftStart..<rightEnd:
            if outIndex % 4096 == 0:
                os.ProcessResourceGuardCheck()
            if left < mid && (right >= rightEnd || !CompilerCsgStrLess(src[right], src[left])):
                dst[outIndex] = src[left]
                left = left + 1
            else:
                dst[outIndex] = src[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

fn CompilerCsgMergeSortStrsPass(src: var str[],
                                  dst: var str[],
                                  width: int32) =
    CompilerCsgMergeSortStrsPassRec(src, dst, width, 0)

@borrows
fn CompilerCsgSourcePathModulePairLess(leftSource: str,
                                         leftModule: str,
                                         rightSource: str,
                                         rightModule: str): bool =
    if leftModule != rightModule:
        return CompilerCsgStrLess(leftModule, rightModule)
    return CompilerCsgStrLess(leftSource, rightSource)

fn CompilerCsgSortSourcePathModulePairs(sources: var str[],
                                         modules: var str[]) =
    if sources.len <= 1:
        return
    let count = sources.len
    var sourceScratch: str[]
    var moduleScratch: str[]
    for i in 0..<count:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        add(sourceScratch, share(sources[i]))
        add(moduleScratch, share(modules[i]))
    var width: int32 = 1
    var readScratch = false
    while width < count:
        if readScratch:
            CompilerCsgMergeSortSourcePathModulePairsPass(sourceScratch,
                                                           moduleScratch,
                                                           sources,
                                                           modules,
                                                           width)
        else:
            CompilerCsgMergeSortSourcePathModulePairsPass(sources,
                                                           modules,
                                                           sourceScratch,
                                                           moduleScratch,
                                                           width)
        readScratch = !readScratch
        if width > count / 2:
            width = count
        else:
            width = width * 2
    if readScratch:
        for i in 0..<count:
            if i % 4096 == 0:
                os.ProcessResourceGuardCheck()
            sources[i] = sourceScratch[i]
            modules[i] = moduleScratch[i]

@borrows
fn CompilerCsgAddUniqueSourceModulePair(sources: var str[],
                                         modules: var str[],
                                         sourceIndex: var CompilerCsgSourcePathIndex,
                                         sourcePath: str,
                                         modulePath: str,
                                         err: var str): bool =
    var normalizedSourcePath: str
    if !CompilerCsgSourcePathIndexCanonicalKey(sourceIndex,
                                                sourcePath,
                                                normalizedSourcePath,
                                                err):
        return false
    if modulePath == "":
        err = Fmt" compiler csg: ordered source module missing source={normalizedSourcePath}"
        return false
    var existingIndex: int32
    if !CompilerCsgSourcePathIndexEquivalentForInsert(sourceIndex,
                                                      share(normalizedSourcePath),
                                                      existingIndex,
                                                      err):
        return false
    if existingIndex >= 0:
        if existingIndex >= sources.len || existingIndex >= modules.len:
            err = Fmt" compiler csg: ordered source index corrupt source={normalizedSourcePath} index={existingIndex} source_count={sources.len} module_count={modules.len}"
            return false
        if modules[existingIndex] != modulePath:
            err = Fmt" compiler csg: ordered source module conflict source={normalizedSourcePath} indexed_source={sources[existingIndex]} expected={modules[existingIndex]} actual={modulePath}"
            return false
        return CompilerCsgSourcePathIndexRegister(sourceIndex,
                                                  normalizedSourcePath,
                                                  existingIndex,
                                                  err)
    add(sources, share(normalizedSourcePath))
    add(modules, parser.ParserOwnedText(modulePath))
    if !CompilerCsgSourcePathIndexRegister(sourceIndex,
                                           normalizedSourcePath,
                                           sources.len - 1,
                                           err):
        setLen(sources, sources.len - 1)
        setLen(modules, modules.len - 1)
        return false
    err = ""
    return true

@borrows
fn CompilerCsgEnsureModuleNode(nodes: var CompilerCsgNode[],
                               edges: var CompilerCsgEdge[],
                               packageNodeId: int32,
                               modulePath: str): int32 =
    if modulePath == "":
        return -1
    let existingNodeId = CompilerCsgModuleNodeId(nodes, modulePath)
    if existingNodeId > 0:
        return existingNodeId
    var moduleNode: CompilerCsgNode
    moduleNode.nodeId = nodes.len + 1
    moduleNode.nodeKind = CompilerCsgNodeKindModule
    moduleNode.ownerNodeId = packageNodeId
    let ownedModulePath = parser.ParserOwnedText(modulePath)
    moduleNode.modulePath = share(ownedModulePath)
    moduleNode.symbolText = ""
    moduleNode.factText = ownedModulePath
    moduleNode.resultLayoutKind = 0
    moduleNode.effectKind = 0
    moduleNode.capabilityKind = 0
    moduleNode.callConv = 0
    moduleNode.entryFlag = 0
    moduleNode.exportedFlag = 0
    moduleNode.exportSymbolName = ""
    moduleNode.factCid = CompilerCsgHashNodeRecord(moduleNode)
    let moduleNodeId = moduleNode.nodeId
    add(nodes, moduleNode)
    CompilerCsgAddEdge(edges, packageNodeId, moduleNodeId, CompilerCsgEdgeKindContains)
    return moduleNodeId

@borrows
fn CompilerCsgExpandSourceClosureImportsRec(
        workspaceRoot: str,
        packageRoot: str,
        externalPackageRoots: var parser.ParserExternalPackageRoot[],
        sourceTextLookup: var CompilerCsgSourceTextLookupEntry[],
        sourceTextLookupIndex: var CompilerCsgSourcePathIndex,
        sourceTextCache: var CompilerCsgSourceTextLookupEntry[],
        sourceTextCacheIndex: var CompilerCsgSourcePathIndex,
        sources: var str[],
        modules: var str[],
        orderedSourceIndex: var CompilerCsgSourcePathIndex,
        cursor: int32,
        err: var str): bool =
    while true:
        if cursor >= sources.len:
            return true
        if cursor % 16 == 0:
            os.ProcessResourceGuardCheck()
        let sourceIndex = cursor
        let sourcePath = parser.ParserNormalizePath(sources[sourceIndex])
        if sourcePath == "":
            err = Fmt" compiler csg: immutable source snapshot capture path missing source_index={sourceIndex}"
            return false
        var text: str
        if !CompilerCsgReadSourceTextCached(sourceTextCache,
                                            sourceTextCacheIndex,
                                            sourceTextLookup,
                                            sourceTextLookupIndex,
                                            sourcePath,
                                            text,
                                            err):
            if err != "":
                return false
            err = Fmt" compiler csg: immutable source snapshot capture missing source={sourcePath}"
            return false
        var ownerModulePath = ""
        if sourceIndex < modules.len:
            ownerModulePath = share(modules[sourceIndex])
        if ownerModulePath == "":
            var resolvedModulePath: str
            if !CompilerCsgSourceModulePathFast(workspaceRoot,
                                                packageRoot,
                                                externalPackageRoots,
                                                sourceTextLookup,
                                                sourceTextLookupIndex,
                                                sourcePath,
                                                resolvedModulePath,
                                                err):
                return false
            ownerModulePath = resolvedModulePath
        if ownerModulePath == "":
            err = Fmt" compiler csg: import parser owner module missing source={sourcePath} source_index={sourceIndex}"
            return false
        var importEdges: parser.ImportEdge[]
        var importErr = ""
        if !parser.ParserReadImportEdgesWithExternalPackageRoots(workspaceRoot,
                                                                  packageRoot,
                                                                  externalPackageRoots,
                                                                  ownerModulePath,
                                                                  text,
                                                                  importEdges,
                                                                  importErr):
            if importErr != "":
                err = Fmt" compiler csg: import parser failed source={sourcePath} module={ownerModulePath}: {importErr}"
            else:
                err = Fmt" compiler csg: import parser failed source={sourcePath} module={ownerModulePath}: empty diagnostic"
            return false
        for edgeIndex in 0..<importEdges.len:
            let importSourcePath = parser.ParserNormalizePath(importEdges[edgeIndex].targetSourcePath)
            if importSourcePath == "":
                err = Fmt" compiler csg: import parser target source missing owner_source={sourcePath} owner_module={ownerModulePath} edge_index={edgeIndex}"
                return false
            let importModulePath = importEdges[edgeIndex].targetModulePath
            if !CompilerCsgAddUniqueSourceModulePair(sources,
                                                     modules,
                                                     orderedSourceIndex,
                                                     importSourcePath,
                                                     importModulePath,
                                                     err):
                return false
        importEdges = []
        text = ""
        cursor = cursor + 1
        continue

fn CompilerCsgExpandSourceClosureImports(workspaceRoot: str,
                                          packageRoot: str,
                                          externalPackageRoots: var parser.ParserExternalPackageRoot[],
                                          sourceTextLookup: var CompilerCsgSourceTextLookupEntry[],
                                          sourceTextLookupIndex: var CompilerCsgSourcePathIndex,
                                          sourceTextCache: var CompilerCsgSourceTextLookupEntry[],
                                          sourceTextCacheIndex: var CompilerCsgSourcePathIndex,
                                          sources: var str[],
                                          modules: var str[],
                                          orderedSourceIndex: var CompilerCsgSourcePathIndex,
                                          err: var str): bool =
    if !CompilerCsgExpandSourceClosureImportsRec(
           workspaceRoot, packageRoot, externalPackageRoots,
           sourceTextLookup, sourceTextLookupIndex,
           sourceTextCache, sourceTextCacheIndex,
           sources, modules, orderedSourceIndex, 0, err):
        return false
    err = ""
    return true

@borrows
fn CompilerCsgResolveCollectedProfileImportEdgesRegisterRec(
        profiles: var parser.NormalizedExprCallProfile[],
        profileSourceIndex: var CompilerCsgSourcePathIndex,
        profileIndex: int32,
        err: var str): bool =
    while true:
        if profileIndex >= profiles.len:
            return true
        var sourcePath: str
        if !CompilerCsgSourcePathIndexCanonicalKey(profileSourceIndex,
                                                    profiles[profileIndex].sourcePath,
                                                    sourcePath,
                                                    err):
            return false
        var existingProfileIndex: int32
        if !CompilerCsgSourcePathIndexFind(profileSourceIndex,
                                           sourcePath,
                                           existingProfileIndex,
                                           err):
            return false
        if existingProfileIndex >= 0:
            err = Fmt" compiler csg: profile source identity conflict source={sourcePath} first_profile={existingProfileIndex} next_profile={profileIndex}"
            return false
        if !CompilerCsgSourcePathIndexRegister(profileSourceIndex,
                                               sourcePath,
                                               profileIndex,
                                               err):
            return false
        var profileForResolve = profiles[profileIndex]
        profileForResolve.sourcePath = sourcePath
        profiles[profileIndex] = profileForResolve
        profileIndex = profileIndex + 1
        continue

@borrows
fn CompilerCsgResolveCollectedProfileImportEdgesResolveRec(
        profiles: var parser.NormalizedExprCallProfile[],
        profileSourceIndex: var CompilerCsgSourcePathIndex,
        profileIndex: int32,
        err: var str): bool =
    while true:
        if profileIndex >= profiles.len:
            return true
        if profileIndex % 16 == 0:
            os.ProcessResourceGuardCheck()
        var profileForEdges = profiles[profileIndex]
        for edgeIndex in 0..<profileForEdges.importEdges.len:
            var edge = profileForEdges.importEdges[edgeIndex]
            var targetSourcePath: str
            if !CompilerCsgSourcePathIndexCanonicalKey(profileSourceIndex,
                                                        edge.targetSourcePath,
                                                        targetSourcePath,
                                                        err):
                err = Fmt" compiler csg: import edge target identity invalid owner_source={profileForEdges.sourcePath} edge_index={edgeIndex}: {err}"
                return false
            var targetIndex: int32
            if !CompilerCsgSourcePathIndexFind(profileSourceIndex,
                                               targetSourcePath,
                                               targetIndex,
                                               err):
                return false
            if targetIndex < 0 || targetIndex >= profiles.len:
                err = Fmt" compiler csg: unresolved import edge owner_source={profileForEdges.sourcePath} owner_module={edge.ownerModulePath} target_source={targetSourcePath} target_module={edge.targetModulePath} edge_index={edgeIndex}"
                return false
            if edge.ownerModulePath == "" || edge.targetModulePath == "":
                err = Fmt" compiler csg: import edge module identity missing owner_source={profileForEdges.sourcePath} target_source={targetSourcePath} edge_index={edgeIndex}"
                return false
            edge.targetSourcePath = targetSourcePath
            edge.resolved = true
            edge.targetProfileIndex = targetIndex
            profileForEdges.importEdges[edgeIndex] = edge
        profiles[profileIndex] = profileForEdges
        profileIndex = profileIndex + 1
        continue

fn CompilerCsgResolveCollectedProfileImportEdges(profiles: var parser.NormalizedExprCallProfile[],
                                                  sourceIdentityIndex: var CompilerCsgSourcePathIndex,
                                                  err: var str): bool =
    var profileSourceIndex = CompilerCsgSourcePathIndexInitLike(sourceIdentityIndex,
                                                               profiles.len * 2 + 8)
    if !CompilerCsgResolveCollectedProfileImportEdgesRegisterRec(
           profiles, profileSourceIndex, 0, err):
        return false
    if !CompilerCsgResolveCollectedProfileImportEdgesResolveRec(
           profiles, profileSourceIndex, 0, err):
        return false
    CompilerCsgSourcePathIndexClear(profileSourceIndex)
    err = ""
    return true

@borrows
fn CompilerCsgMergeSortSourcePathModulePairsPassRec(
        srcSources: var str[],
        srcModules: var str[],
        dstSources: var str[],
        dstModules: var str[],
        width: int32,
        leftStart: int32) =
    while true:
        let count = srcSources.len
        if leftStart >= count:
            return
        if leftStart % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let midRaw = leftStart + width
        var mid = count
        if midRaw < count:
            mid = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = mid
        for outIndex in leftStart..<rightEnd:
            if outIndex % 4096 == 0:
                os.ProcessResourceGuardCheck()
            if left < mid &&
               (right >= rightEnd ||
                !CompilerCsgSourcePathModulePairLess(srcSources[right],
                                                     srcModules[right],
                                                     srcSources[left],
                                                     srcModules[left])):
                dstSources[outIndex] = srcSources[left]
                dstModules[outIndex] = srcModules[left]
                left = left + 1
            else:
                dstSources[outIndex] = srcSources[right]
                dstModules[outIndex] = srcModules[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

fn CompilerCsgMergeSortSourcePathModulePairsPass(srcSources: var str[],
                                                   srcModules: var str[],
                                                   dstSources: var str[],
                                                   dstModules: var str[],
                                                   width: int32) =
    CompilerCsgMergeSortSourcePathModulePairsPassRec(
        srcSources, srcModules, dstSources, dstModules, width, 0)

fn CompilerCsgAddUniqueImportPair(pairs: var CompilerCsgImportPair[],
                                    ownerModulePath: str,
                                    targetModulePath: str) =
    for i in 0..<pairs.len:
        if pairs[i].ownerModulePath != ownerModulePath:
            continue
        if pairs[i].targetModulePath != targetModulePath:
            continue
        return
    add(pairs, CompilerCsgImportPair(ownerModulePath: ownerModulePath,
                                       targetModulePath: targetModulePath))

@borrows
fn CompilerCsgTextHash(text: str): int32 =
    var h: int32
    for i in 0..<text.len:
        h = h * 131 + Int32(text[i])
    if h < 0:
        h = -h
    return h

@borrows
fn CompilerCsgTextFirstCode(text: str): int32 =
    if text.len <= 0:
        return 0
    return Int32(text[0])

@borrows
fn CompilerCsgTextLastCode(text: str): int32 =
    if text.len <= 0:
        return 0
    return Int32(text[text.len - 1])

fn CompilerCsgImportPairLookupInit(minCap: int32): CompilerCsgImportPairLookup =
    var lookup: CompilerCsgImportPairLookup
    lookup.slots = []
    lookup.buckets = []
    var cap: int32 = 32
    while cap < minCap:
        cap = cap * 2
    for i in 0..<cap:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        add(lookup.slots, 0)
    return lookup

fn CompilerCsgImportPairLookupHash(ownerLen: int32,
                                     ownerFirstCode: int32,
                                     ownerLastCode: int32,
                                     ownerHash: int32,
                                     targetLen: int32,
                                     targetFirstCode: int32,
                                     targetLastCode: int32,
                                     targetHash: int32): int64 =
    var h: int64 = Int64(ownerHash)
    h = h * 131 + Int64(ownerLen)
    h = h * 131 + Int64(ownerFirstCode)
    h = h * 131 + Int64(ownerLastCode)
    h = h * 131 + Int64(targetHash)
    h = h * 131 + Int64(targetLen)
    h = h * 131 + Int64(targetFirstCode)
    h = h * 131 + Int64(targetLastCode)
    if h < 0:
        h = -h
    return h

@borrows
fn CompilerCsgImportPairLookupSlotForParts(lookup: CompilerCsgImportPairLookup,
                                             ownerLen: int32,
                                             ownerFirstCode: int32,
                                             ownerLastCode: int32,
                                             ownerHash: int32,
                                             targetLen: int32,
                                             targetFirstCode: int32,
                                             targetLastCode: int32,
                                             targetHash: int32): int32 =
    if lookup.slots.len <= 0:
        return -1
    let mask = lookup.slots.len - 1
    var probe: int32 = Int32(CompilerCsgImportPairLookupHash(ownerLen,
                                                               ownerFirstCode,
                                                               ownerLastCode,
                                                               ownerHash,
                                                               targetLen,
                                                               targetFirstCode,
                                                               targetLastCode,
                                                               targetHash) & Int64(mask))
    var scanned: int32
    while scanned <= mask:
        let bucketIndexPlus1 = lookup.slots[probe]
        if bucketIndexPlus1 == 0:
            return probe
        let bucketIndex = bucketIndexPlus1 - 1
        if lookup.buckets[bucketIndex].ownerLen == ownerLen &&
           lookup.buckets[bucketIndex].ownerFirstCode == ownerFirstCode &&
           lookup.buckets[bucketIndex].ownerLastCode == ownerLastCode &&
           lookup.buckets[bucketIndex].ownerHash == ownerHash &&
           lookup.buckets[bucketIndex].targetLen == targetLen &&
           lookup.buckets[bucketIndex].targetFirstCode == targetFirstCode &&
           lookup.buckets[bucketIndex].targetLastCode == targetLastCode &&
           lookup.buckets[bucketIndex].targetHash == targetHash:
            return probe
        probe = (probe + 1) & mask
        scanned = scanned + 1
    return -1

fn CompilerCsgImportPairLookupRehash(lookup: var CompilerCsgImportPairLookup,
                                       newCap: int32) =
    var slots: int32[]
    for i in 0..<newCap:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        add(slots, 0)
    lookup.slots = slots
    for bucketIndex in 0..<lookup.buckets.len:
        if bucketIndex % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let slot = CompilerCsgImportPairLookupSlotForParts(lookup,
                                                            lookup.buckets[bucketIndex].ownerLen,
                                                            lookup.buckets[bucketIndex].ownerFirstCode,
                                                            lookup.buckets[bucketIndex].ownerLastCode,
                                                            lookup.buckets[bucketIndex].ownerHash,
                                                            lookup.buckets[bucketIndex].targetLen,
                                                            lookup.buckets[bucketIndex].targetFirstCode,
                                                            lookup.buckets[bucketIndex].targetLastCode,
                                                            lookup.buckets[bucketIndex].targetHash)
        if slot >= 0:
            lookup.slots[slot] = bucketIndex + 1

fn CompilerCsgImportPairLookupGrow(lookup: var CompilerCsgImportPairLookup) =
    var nextCap: int32 = lookup.slots.len * 2
    if nextCap < 32:
        nextCap = 32
    CompilerCsgImportPairLookupRehash(lookup, nextCap)

@borrows
fn CompilerCsgImportPairLookupEnsureBucket(lookup: var CompilerCsgImportPairLookup,
                                             ownerModulePath: str,
                                             targetModulePath: str): int32 =
    if lookup.slots.len <= 0:
        lookup = CompilerCsgImportPairLookupInit(32)
    if (lookup.buckets.len + 1) * 10 >= lookup.slots.len * 7:
        CompilerCsgImportPairLookupGrow(lookup)
    let ownerLen = ownerModulePath.len
    let ownerFirstCode = CompilerCsgTextFirstCode(ownerModulePath)
    let ownerLastCode = CompilerCsgTextLastCode(ownerModulePath)
    let ownerHash = CompilerCsgTextHash(ownerModulePath)
    let targetLen = targetModulePath.len
    let targetFirstCode = CompilerCsgTextFirstCode(targetModulePath)
    let targetLastCode = CompilerCsgTextLastCode(targetModulePath)
    let targetHash = CompilerCsgTextHash(targetModulePath)
    let slot = CompilerCsgImportPairLookupSlotForParts(lookup,
                                                        ownerLen,
                                                        ownerFirstCode,
                                                        ownerLastCode,
                                                        ownerHash,
                                                        targetLen,
                                                        targetFirstCode,
                                                        targetLastCode,
                                                        targetHash)
    if slot < 0:
        return -1
    let existing = lookup.slots[slot]
    if existing > 0:
        return existing - 1
    var bucket: CompilerCsgImportPairLookupBucket
    bucket.ownerLen = ownerLen
    bucket.ownerFirstCode = ownerFirstCode
    bucket.ownerLastCode = ownerLastCode
    bucket.ownerHash = ownerHash
    bucket.targetLen = targetLen
    bucket.targetFirstCode = targetFirstCode
    bucket.targetLastCode = targetLastCode
    bucket.targetHash = targetHash
    bucket.items = []
    add(lookup.buckets, bucket)
    lookup.slots[slot] = lookup.buckets.len
    return lookup.buckets.len - 1

@borrows
fn compilerCsgImportPairLookupHasRec(lookup: var CompilerCsgImportPairLookup,
                                      bucketIndex: int32,
                                      ownerModulePath: str,
                                      targetModulePath: str,
                                      i: int32): bool =
    while true:
        if i >= lookup.buckets[bucketIndex].items.len:
            return false
        if lookup.buckets[bucketIndex].items[i].ownerModulePath ==
               ownerModulePath &&
           lookup.buckets[bucketIndex].items[i].targetModulePath ==
               targetModulePath:
            return true
        i = i + 1
        continue

@borrows
fn CompilerCsgImportPairLookupInsert(lookup: var CompilerCsgImportPairLookup,
                                       ownerModulePath: str,
                                       targetModulePath: str): bool =
    let bucketIndex = CompilerCsgImportPairLookupEnsureBucket(lookup,
                                                               ownerModulePath,
                                                               targetModulePath)
    if bucketIndex < 0:
        return false
    if compilerCsgImportPairLookupHasRec(lookup, bucketIndex,
                                          ownerModulePath,
                                          targetModulePath, 0):
        return false
    var pair: CompilerCsgImportPair
    pair.ownerModulePath = strings.CloneStr(ownerModulePath)
    pair.targetModulePath = strings.CloneStr(targetModulePath)
    add(lookup.buckets[bucketIndex].items, pair)
    return true

@borrows
fn CompilerCsgAddUniqueImportPairFast(pairs: var CompilerCsgImportPair[],
                                        seen: var CompilerCsgImportPairLookup,
                                        ownerModulePath: str,
                                        targetModulePath: str) =
    if CompilerCsgImportPairLookupInsert(seen,
                                          ownerModulePath,
                                          targetModulePath):
        add(pairs,
            CompilerCsgImportPair(
                ownerModulePath: parser.ParserOwnedText(ownerModulePath),
                targetModulePath: parser.ParserOwnedText(targetModulePath)))

@borrows
fn CompilerCsgImportPairLess(left: CompilerCsgImportPair,
                               right: CompilerCsgImportPair): bool =
    if left.ownerModulePath != right.ownerModulePath:
        return CompilerCsgStrLess(left.ownerModulePath, right.ownerModulePath)
    return CompilerCsgStrLess(left.targetModulePath, right.targetModulePath)

fn CompilerCsgSortImportPairs(pairs: var CompilerCsgImportPair[]) =
    if pairs.len <= 1:
        return
    let count = pairs.len
    var scratch: CompilerCsgImportPair[]
    for i in 0..<count:
        if i % 4096 == 0:
            os.ProcessResourceGuardCheck()
        add(scratch, share(pairs[i]))
    var width: int32 = 1
    var readScratch = false
    while width < count:
        if readScratch:
            CompilerCsgMergeSortImportPairsPass(scratch, pairs, width)
        else:
            CompilerCsgMergeSortImportPairsPass(pairs, scratch, width)
        readScratch = !readScratch
        if width > count / 2:
            width = count
        else:
            width = width * 2
    if readScratch:
        for i in 0..<count:
            if i % 4096 == 0:
                os.ProcessResourceGuardCheck()
            pairs[i] = scratch[i]

@borrows
fn CompilerCsgMergeSortImportPairsPassRec(
        src: var CompilerCsgImportPair[],
        dst: var CompilerCsgImportPair[],
        width: int32,
        leftStart: int32) =
    while true:
        let count = src.len
        if leftStart >= count:
            return
        if leftStart % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let midRaw = leftStart + width
        var mid = count
        if midRaw < count:
            mid = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = mid
        for outIndex in leftStart..<rightEnd:
            if outIndex % 4096 == 0:
                os.ProcessResourceGuardCheck()
            if left < mid && (right >= rightEnd || !CompilerCsgImportPairLess(src[right], src[left])):
                dst[outIndex] = src[left]
                left = left + 1
            else:
                dst[outIndex] = src[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

fn CompilerCsgMergeSortImportPairsPass(src: var CompilerCsgImportPair[],
                                         dst: var CompilerCsgImportPair[],
                                         width: int32) =
    CompilerCsgMergeSortImportPairsPassRec(src, dst, width, 0)

@borrows
fn CompilerCsgModuleNodeId(nodes: CompilerCsgNode[],
                             modulePath: str): int32 =
    for i in 0..<nodes.len:
        let node = nodes[i]
        if node.nodeKind != CompilerCsgNodeKindModule:
            continue
        if node.modulePath == modulePath:
            return node.nodeId
    return -1

@borrows
fn CompilerCsgModuleIndex(modules: str[],
                            modulePath: str): int32 =
    var lo: int32
    var hi = modules.len
    while lo < hi:
        let mid = lo + (hi - lo) / 2
        let item = modules[mid]
        if item == modulePath:
            return mid
        if CompilerCsgStrLess(item, modulePath):
            lo = mid + 1
        else:
            hi = mid
    return -1

@borrows
fn CompilerCsgModuleNodeIdIndexed(modules: str[],
                                    moduleNodeIds: int32[],
                                    modulePath: str): int32 =
    let index = CompilerCsgModuleIndex(modules, modulePath)
    if index < 0 || index >= moduleNodeIds.len:
        return -1
    return moduleNodeIds[index]

@borrows
fn CompilerCsgSymbolExported(functionName: str,
                               entryFlag: int32): bool =
    let _ = entryFlag
    if functionName.len <= 0:
        return false
    let ch = functionName[0]
    return ch >= 'A' && ch <= 'Z'

@borrows
fn CompilerCsgFindText(text: str,
                         needle: str): int32 =
    if needle.len <= 0:
        return 0
    if text.len < needle.len:
        return -1
    for i in 0..<(text.len - needle.len + 1):
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return i
    return -1

@borrows
fn CompilerCsgTargetExportName(symbolText: str,
                                 explicitExportName: str,
                                 functionName: str): str =
    if explicitExportName.len > 0:
        return explicitExportName
    if functionName.len > 0:
        return functionName
    let suffixPos = CompilerCsgFindText(symbolText, "::")
    if suffixPos < 0:
        return symbolText
    return chengpath.TextSlice(symbolText, suffixPos + 2, symbolText.len - (suffixPos + 2))

@borrows
fn CompilerCsgShouldExportSymbol(emitKind: creq.CompilerEmit,
                                   entrySourceFlag: bool,
                                   entryHasExplicitExports: bool,
                                   explicitExportName: str,
                                   functionName: str,
                                   entryFlag: int32): bool =
    if emitKind != creq.EmitShared && emitKind != creq.EmitObj:
        if explicitExportName.len > 0:
            return true
        return CompilerCsgSymbolExported(functionName, entryFlag)
    if !entrySourceFlag:
        return false
    if entryHasExplicitExports:
        return explicitExportName.len > 0
    return true

@borrows
fn CompilerCsgExportRootNameMatches(root: str,
                                      candidate: str): bool =
    if root == candidate:
        return true
    if len(root) > 1 && root[0] == '_':
        let strippedRoot = chengpath.TextSlice(root, 1, len(root) - 1)
        if strippedRoot == candidate:
            return true
    if len(candidate) > 1 && candidate[0] == '_':
        let strippedCandidate = chengpath.TextSlice(candidate, 1, len(candidate) - 1)
        if root == strippedCandidate:
            return true
    return false

@borrows
fn CompilerCsgExportRootSelected(roots: str[],
                                  symbolText: str,
                                  explicitExportName: str,
                                  functionName: str): bool =
    if roots.len <= 0:
        return true
    let targetName = CompilerCsgTargetExportName(symbolText,
                                                 explicitExportName,
                                                 functionName)
    for i in 0..<roots.len:
        let root = roots[i]
        if CompilerCsgExportRootNameMatches(root, targetName):
            return true
        if CompilerCsgExportRootNameMatches(root, functionName):
            return true
        if CompilerCsgExportRootNameMatches(root, symbolText):
            return true
    return false

@borrows
fn CompilerCsgSourceTextLookupAdd(entries: var CompilerCsgSourceTextLookupEntry[],
                                  index: var CompilerCsgSourcePathIndex,
                                  sourcePathRaw: str,
                                  modulePath: str,
                                  text: str,
                                  err: var str): bool =
    var sourcePath: str
    if !CompilerCsgSourcePathIndexCanonicalKey(index,
                                                sourcePathRaw,
                                                sourcePath,
                                                err):
        return false
    var existingIndex: int32
    if !CompilerCsgSourcePathIndexFind(index,
                                       sourcePath,
                                       existingIndex,
                                       err):
        return false
    if existingIndex >= 0:
        if existingIndex >= entries.len:
            err = Fmt" compiler csg: source text index corrupt source={sourcePath} index={existingIndex} count={entries.len}"
            return false
        err = Fmt" compiler csg: source text has multiple providers source={sourcePath} index={existingIndex}"
        return false
    var entry: CompilerCsgSourceTextLookupEntry
    entry.sourcePath = share(sourcePath)
    entry.normalizedSourcePath = share(sourcePath)
    entry.modulePath = modulePath
    entry.text = text
    add(entries, entry)
    if !CompilerCsgSourcePathIndexRegister(index,
                                           sourcePath,
                                           entries.len - 1,
                                           err):
        setLen(entries, entries.len - 1)
        return false
    err = ""
    return true

@borrows
fn CompilerCsgSourceTextLookupAddVerifiedSnapshots(
        externalPackageRoots: var parser.ParserExternalPackageRoot[],
        sourceClosurePaths: str[],
        ownerModulePaths: str[],
        index: var CompilerCsgSourcePathIndex,
        out: var CompilerCsgSourceTextLookupEntry[],
        err: var str): bool =
    for sourceIndex in 0..<sourceClosurePaths.len:
        var sourcePath: str
        if !CompilerCsgSourcePathIndexCanonicalKey(
                index,
                sourceClosurePaths[sourceIndex],
                sourcePath,
                err):
            return false
        var selectedPackageRoot: str
        var selectedPackageId: str
        if !parser.ParserExternalPackageRootBySourcePath(
                sourcePath,
                externalPackageRoots,
                selectedPackageRoot,
                selectedPackageId):
            continue
        var selectedRootFound: bool
        for rootIndex in 0..<externalPackageRoots.len:
            let root = externalPackageRoots[rootIndex]
            if parser.ParserNormalizePath(root.packageRoot) !=
                   selectedPackageRoot ||
               chengpath.PathTrim(root.packageId) != selectedPackageId:
                continue
            selectedRootFound = true
            if !root.verifiedSnapshotRequired:
                break
            if !parser.ParserExternalPackageRootSnapshotValidate(root):
                err = Fmt" compiler csg: verified external source snapshot invalid package={selectedPackageId}"
                return false
            var snapshotFound: bool
            for snapshotIndex in 0..<root.verifiedSourcePaths.len:
                if root.verifiedSourcePaths[snapshotIndex] != sourcePath:
                    continue
                if !CompilerCsgSourceTextLookupAdd(
                        out,
                        index,
                        sourcePath,
                        ownerModulePaths[sourceIndex],
                        root.verifiedSourceTexts[snapshotIndex],
                        err):
                    return false
                snapshotFound = true
                break
            if !snapshotFound:
                err = Fmt" compiler csg: verified external source missing from snapshot package={selectedPackageId} source={sourcePath}"
                return false
            break
        if !selectedRootFound:
            err = Fmt" compiler csg: selected external package root missing package={selectedPackageId} source={sourcePath}"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgSourceTextLookupBuild(overrides: var CompilerCsgSourceText[],
                                    entryPathOverride: str,
                                    entryTextOverride: str,
                                    externalPackageRoots: var parser.ParserExternalPackageRoot[],
                                    sourceClosurePaths: str[],
                                    ownerModulePaths: str[],
                                    index: var CompilerCsgSourcePathIndex,
                                    out: var CompilerCsgSourceTextLookupEntry[],
                                    err: var str): bool =
    out = []
    if sourceClosurePaths.len != ownerModulePaths.len:
        err = " compiler csg: source text provider identity columns disagree"
        return false
    if !CompilerCsgSourceTextLookupAddVerifiedSnapshots(
            externalPackageRoots,
            sourceClosurePaths,
            ownerModulePaths,
            index,
            out,
            err):
        return false
    if entryPathOverride != "" && entryTextOverride != "":
        let entrySourceIndex = slplan.SystemLinkPlanTextIndex(
            sourceClosurePaths,
            entryPathOverride)
        if entrySourceIndex < 0:
            err = Fmt" compiler csg: entry text provider outside sealed closure source={entryPathOverride}"
            return false
        if !CompilerCsgSourceTextLookupAdd(out,
                                           index,
                                           entryPathOverride,
                                           ownerModulePaths[entrySourceIndex],
                                           entryTextOverride,
                                           err):
            return false
    for i in 0..<overrides.len:
        if i % 64 == 0:
            os.ProcessResourceGuardCheck()
        var canonicalSourcePath: str
        if !CompilerCsgSourcePathIndexCanonicalKey(index,
                                                    overrides[i].sourcePath,
                                                    canonicalSourcePath,
                                                    err):
            return false
        let sourceIndex = slplan.SystemLinkPlanTextIndex(
            sourceClosurePaths,
            canonicalSourcePath)
        if sourceIndex < 0:
            err = Fmt" compiler csg: source text provider outside sealed closure source={canonicalSourcePath}"
            return false
        let ownerModulePath = ownerModulePaths[sourceIndex]
        if overrides[i].modulePath != "" &&
           overrides[i].modulePath != ownerModulePath:
            err = Fmt" compiler csg: source text provider module disagrees with sealed owner source={canonicalSourcePath} sealed={ownerModulePath} override={overrides[i].modulePath}"
            return false
        if !CompilerCsgSourceTextLookupAdd(out,
                                           index,
                                           canonicalSourcePath,
                                           ownerModulePath,
                                           overrides[i].text,
                                           err):
            return false
    err = ""
    return true

@borrows
fn CompilerCsgSourceTextLookupFast(entries: var CompilerCsgSourceTextLookupEntry[],
                                   index: var CompilerCsgSourcePathIndex,
                                   sourcePath: str,
                                   out: var str,
                                   found: var bool,
                                   err: var str): bool =
    found = false
    var entryIndex: int32
    if !CompilerCsgSourcePathIndexFind(index,
                                       sourcePath,
                                       entryIndex,
                                       err):
        return false
    if entryIndex < 0:
        err = ""
        return true
    if entryIndex >= entries.len:
        err = Fmt" compiler csg: source text lookup index corrupt source={sourcePath} index={entryIndex} count={entries.len}"
        return false
    out = share(entries[entryIndex].text)
    found = true
    err = ""
    return true

@borrows
fn CompilerCsgSourceTextSnapshotLookup(overrides: var CompilerCsgSourceTextLookupEntry[],
                                       overrideIndex: var CompilerCsgSourcePathIndex,
                                       captured: var CompilerCsgSourceTextLookupEntry[],
                                       capturedIndex: var CompilerCsgSourcePathIndex,
                                       sourcePath: str,
                                       out: var str,
                                       fromOverride: var bool,
                                       err: var str): bool =
    var found: bool
    if !CompilerCsgSourceTextLookupFast(overrides,
                                        overrideIndex,
                                        sourcePath,
                                        out,
                                        found,
                                        err):
        return false
    if found:
        fromOverride = true
        return true
    fromOverride = false
    if !CompilerCsgSourceTextLookupFast(captured,
                                        capturedIndex,
                                        sourcePath,
                                        out,
                                        found,
                                        err):
        return false
    return found

@borrows
fn CompilerCsgReadSourceTextCached(cache: var CompilerCsgSourceTextLookupEntry[],
                                    cacheIndex: var CompilerCsgSourcePathIndex,
                                    overrides: var CompilerCsgSourceTextLookupEntry[],
                                    overrideIndex: var CompilerCsgSourcePathIndex,
                                    sourcePath: str,
                                    out: var str,
                                    err: var str): bool =
    var found: bool
    if !CompilerCsgSourceTextLookupFast(overrides,
                                        overrideIndex,
                                        sourcePath,
                                        out,
                                        found,
                                        err):
        return false
    if found:
        return true
    if !CompilerCsgSourceTextLookupFast(cache,
                                        cacheIndex,
                                        sourcePath,
                                        out,
                                        found,
                                        err):
        return false
    if found:
        return true
    var capturedText: str
    if !os.ReadFileInto(sourcePath, capturedText):
        err = Fmt" compiler csg: exact source read failed source={sourcePath}"
        return false
    if !CompilerCsgSourceTextLookupAdd(cache,
                                       cacheIndex,
                                       sourcePath,
                                       "",
                                       capturedText,
                                       err):
        return false
    if !CompilerCsgSourceTextLookupFast(cache,
                                        cacheIndex,
                                        sourcePath,
                                        out,
                                        found,
                                        err):
        return false
    if !found:
        err = Fmt" compiler csg: exact source cache commit missing source={sourcePath}"
        return false
    err = ""
    return true

fn CompilerCsgSourceModulePath(workspaceRoot: str,
                                 packageRoot: str,
                                 externalPackageRoots: parser.ParserExternalPackageRoot[],
                                 overrides: CompilerCsgSourceText[],
                                 sourcePath: str): str =
    for i in 0..<overrides.len:
        if overrides[i].sourcePath != sourcePath:
            continue
        if overrides[i].modulePath.len > 0:
            return overrides[i].modulePath
    return parser.ParserSourcePathToModulePathWithExternalPackageRoots(workspaceRoot,
                                                                         packageRoot,
                                                                         externalPackageRoots,
                                                                         sourcePath)

@borrows
fn CompilerCsgSourceModulePathFast(workspaceRoot: str,
                                    packageRoot: str,
                                    externalPackageRoots: var parser.ParserExternalPackageRoot[],
                                    overrides: var CompilerCsgSourceTextLookupEntry[],
                                    overrideIndex: var CompilerCsgSourcePathIndex,
                                    sourcePath: str,
                                    modulePath: var str,
                                    err: var str): bool =
    var overrideEntryIndex: int32
    if !CompilerCsgSourcePathIndexFind(overrideIndex,
                                       sourcePath,
                                       overrideEntryIndex,
                                       err):
        return false
    if overrideEntryIndex >= 0:
        if overrideEntryIndex >= overrides.len:
            err = Fmt" compiler csg: source module override index corrupt source={sourcePath} index={overrideEntryIndex} count={overrides.len}"
            return false
        if overrides[overrideEntryIndex].modulePath != "":
            modulePath = overrides[overrideEntryIndex].modulePath
            err = ""
            return true
    modulePath = parser.ParserSourcePathToModulePathWithExternalPackageRoots(workspaceRoot,
                                                                              packageRoot,
                                                                              externalPackageRoots,
                                                                              sourcePath)
    err = ""
    return true

fn CompilerCsgIsBrowserAbiSupportModule(modulePath: str): bool =
    if modulePath == browsercodec.BrowserContentCodecModulePath():
        return true
    if modulePath == "cheng/libp2p/browser/browser_content_codec_codegen":
        return true
    if modulePath == "cheng/libp2p/browser/browser_content_codec_rule_schema":
        return true
    if modulePath == browserprobe.BrowserHostProbeModulePath():
        return true
    if modulePath == "cheng/libp2p/browser/browser_host_probe_codegen":
        return true
    if modulePath == "cheng/libp2p/browser/browser_host_probe_rule_schema":
        return true
    return modulePath == "cheng/core/lang/browser_abi_rule"

@borrows
fn CompilerCsgBrowserAbiSourceText(
        sourcePath: str,
        externalPackageRoots: parser.ParserExternalPackageRoot[]): str =
    var text: str
    var err: str
    if !parser.ParserSourceTextWithExternalPackageRootsInto(
            sourcePath,
            externalPackageRoots,
            text,
            err):
        system.Panic(Fmt"compiler csg: browser ABI sealed source unavailable source={sourcePath} err={err}")
    return text

@borrows
fn CompilerCsgAddBrowserAbiRulesForSource(rules: var BrowserAbiRule[],
                                            linkPlan: slplan.SystemLinkPlanStub,
                                            ownerModulePath: str,
                                            sourcePath: str) =
    let externalPackageRoots = linkPlan.externalPackageRoots
    let normalizedSourcePath = parser.ParserNormalizePath(sourcePath)
    let normalizedEntryPath = parser.ParserNormalizePath(linkPlan.entryPath)
    if normalizedSourcePath == normalizedEntryPath:
        if ownerModulePath == browsercodec.BrowserContentCodecModulePath():
            let codecRules = browsercodec.BrowserContentCodecRules(normalizedSourcePath)
            for i in 0..<codecRules.len:
                add(rules, barule.BrowserAbiRuleClone(codecRules[i]))
            return
        if ownerModulePath == browserprobe.BrowserHostProbeModulePath():
            let probeRules = browserprobe.BrowserHostProbeRules(normalizedSourcePath)
            for i in 0..<probeRules.len:
                add(rules, barule.BrowserAbiRuleClone(probeRules[i]))
            return
    if ownerModulePath == browsercodec.BrowserContentCodecModulePath():
        let codecRuleNames = browsercodec.BrowserContentCodecRuleNames()
        for i in 0..<codecRuleNames.len:
            let triggerNames = browsercodec.BrowserContentCodecRuleTriggerNames(codecRuleNames[i])
            var used = false
            for j in 0..<linkPlan.sourceClosurePaths.len:
                let currentSourcePath = parser.ParserNormalizePath(linkPlan.sourceClosurePaths[j])
                if currentSourcePath == normalizedSourcePath:
                    continue
                let currentModulePath = parser.ParserSourcePathToModulePathWithExternalPackageRoots(linkPlan.workspaceRoot,
                                                                                                       linkPlan.packageRoot,
                                                                                                       externalPackageRoots,
                                                                                                       currentSourcePath)
                if CompilerCsgIsBrowserAbiSupportModule(currentModulePath):
                    continue
                let text = CompilerCsgBrowserAbiSourceText(
                    currentSourcePath,
                    externalPackageRoots)
                for k in 0..<triggerNames.len:
                    let triggerCall = Fmt"{triggerNames[k]}("
                    if strutil.Contains(text, triggerCall):
                        used = true
                        break
                if used:
                    break
            if used:
                add(rules, browsercodec.BrowserContentCodecRuleByName(normalizedSourcePath,
                                                                        codecRuleNames[i]))
        return
    if ownerModulePath == browserprobe.BrowserHostProbeModulePath():
        let probeRuleNames = browserprobe.BrowserHostProbeRuleNames()
        for i in 0..<probeRuleNames.len:
            let triggerNames = browserprobe.BrowserHostProbeRuleTriggerNames(probeRuleNames[i])
            var used = false
            for j in 0..<linkPlan.sourceClosurePaths.len:
                let currentSourcePath = parser.ParserNormalizePath(linkPlan.sourceClosurePaths[j])
                if currentSourcePath == normalizedSourcePath:
                    continue
                let currentModulePath = parser.ParserSourcePathToModulePathWithExternalPackageRoots(linkPlan.workspaceRoot,
                                                                                                       linkPlan.packageRoot,
                                                                                                       externalPackageRoots,
                                                                                                       currentSourcePath)
                if CompilerCsgIsBrowserAbiSupportModule(currentModulePath):
                    continue
                let text = CompilerCsgBrowserAbiSourceText(
                    currentSourcePath,
                    externalPackageRoots)
                for k in 0..<triggerNames.len:
                    let triggerCall = Fmt"{triggerNames[k]}("
                    if strutil.Contains(text, triggerCall):
                        used = true
                        break
                if used:
                    break
            if used:
                add(rules, browserprobe.BrowserHostProbeRuleByName(normalizedSourcePath,
                                                                     probeRuleNames[i]))
        return

@borrows
fn CompilerBrowserAbiRulesForLinkPlan(linkPlan: slplan.SystemLinkPlanStub): BrowserAbiRule[] =
    var out: BrowserAbiRule[]
    var orderedSources: str[]
    var orderedModules: str[]
    let externalPackageRoots = linkPlan.externalPackageRoots
    for i in 0..<linkPlan.sourceClosurePaths.len:
        let sourcePath = linkPlan.sourceClosurePaths[i]
        add(orderedSources, share(sourcePath))
        add(orderedModules,
            parser.ParserSourcePathToModulePathWithExternalPackageRoots(linkPlan.workspaceRoot,
                                                                          linkPlan.packageRoot,
                                                                          externalPackageRoots,
                                                                          sourcePath))
    CompilerCsgSortSourcePathModulePairs(orderedSources, orderedModules)
    for i in 0..<orderedSources.len:
        let sourcePath = orderedSources[i]
        let ownerModulePath = parser.ParserSourcePathToModulePathWithExternalPackageRoots(linkPlan.workspaceRoot,
                                                                                             linkPlan.packageRoot,
                                                                                             externalPackageRoots,
                                                                                             sourcePath)
        CompilerCsgAddBrowserAbiRulesForSource(out, linkPlan, ownerModulePath, sourcePath)
    return out

@borrows
fn CompilerBrowserAbiBridgeSpecsForLinkPlan(linkPlan: slplan.SystemLinkPlanStub): BrowserAbiBridgeSpec[] =
    let rules = CompilerBrowserAbiRulesForLinkPlan(linkPlan)
    return barule.BrowserAbiBridgeSpecsFromRules(rules)

@borrows
fn CompilerBrowserAbiBridgeSpecsForSource(linkPlan: slplan.SystemLinkPlanStub,
                                            sourcePathRaw: str): BrowserAbiBridgeSpec[] =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let specs = CompilerBrowserAbiBridgeSpecsForLinkPlan(linkPlan)
    return barule.BrowserAbiBridgeSpecsForSource(specs, sourcePath)

@borrows
fn CompilerBrowserAbiBridgePlansForLinkPlan(linkPlan: slplan.SystemLinkPlanStub): BrowserAbiBridgePlan[] =
    let specs = CompilerBrowserAbiBridgeSpecsForLinkPlan(linkPlan)
    return barule.BrowserAbiBridgePlansFromSpecs(specs)

@borrows
fn CompilerBrowserAbiBridgePlansForSource(linkPlan: slplan.SystemLinkPlanStub,
                                            sourcePathRaw: str): BrowserAbiBridgePlan[] =
    let sourcePath = parser.ParserNormalizePath(sourcePathRaw)
    let plans = CompilerBrowserAbiBridgePlansForLinkPlan(linkPlan)
    return barule.BrowserAbiBridgePlansForSource(plans, sourcePath)

@borrows
fn CompilerLegacyLineIndentAt(rawLine: str,
                                stop: int32): str =
    let n = rawLine.len
    if stop >= n:
        return parser.ParserOwnedText(rawLine)
    for i in stop..<n:
        let code = Int32(rawLine[i])
        if code == 32 || code == 9:
            continue
        return parser.ParserOwnedText(chengpath.TextSlice(rawLine, 0, i))
    return parser.ParserOwnedText(rawLine)

@borrows
fn CompilerLegacyLineIndent(rawLine: str): str =
    return CompilerLegacyLineIndentAt(rawLine, 0)

@borrows
fn CompilerLegacyFindMatchingBracket(text: str,
                                       openIndex: int32): int32 =
    return CompilerLegacyFindMatchingBracketStep(text, openIndex, 0)

@borrows
fn CompilerLegacyFindMatchingBracketStep(text: str,
                                           index: int32,
                                           depth: int32): int32 =
    let n = text.len
    var currentDepth = depth
    for i in index..<n:
        let code = Int32(text[i])
        if code == 91:
            currentDepth = currentDepth + 1
            continue
        if code == 93:
            let nextDepth = currentDepth - 1
            if nextDepth == 0:
                return i
            currentDepth = nextDepth
    return -1

@borrows
fn CompilerLegacyTopLevelComma(text: str): int32 =
    return CompilerLegacyTopLevelCommaStep(text, 0, 0)

@borrows
fn CompilerLegacyTopLevelCommaStep(text: str,
                                     index: int32,
                                     depth: int32): int32 =
    let n = text.len
    var currentDepth = depth
    for i in index..<n:
        let code = Int32(text[i])
        if code == 91:
            currentDepth = currentDepth + 1
            continue
        if code == 93:
            currentDepth = currentDepth - 1
            continue
        if code == 44 && currentDepth == 0:
            return i
    return -1

@borrows
fn CompilerLegacyRewriteSeqTypes(textRaw: str,
                                   outAppliedCount: var int32): str =
    var text = parser.ParserOwnedText(textRaw)
    outAppliedCount = 0
    var i = 0
    while i < text.len:
        if i + 4 > text.len:
            break
        if !parser.ParserTextEqualsAt(text, i, "seq["):
            i = i + 1
            continue
        let closePos = CompilerLegacyFindMatchingBracket(text, i + 3)
        if closePos <= i + 3:
            i = i + 1
            continue
        let inner = parser.ParserOwnedTextRange(text, i + 4, closePos - (i + 4))
        let replacement = strutil.Join(
            [parser.ParserOwnedText(strutil.Strip(inner)), "[]"],
            "")
        let prefix = parser.ParserOwnedTextRange(text, 0, i)
        let suffix = parser.ParserOwnedTextRange(text, closePos + 1, text.len - (closePos + 1))
        let replacementLen = replacement.len
        var rewritten = strutil.Join([prefix, replacement], "")
        rewritten = strutil.Join([rewritten, suffix], "")
        text = rewritten
        outAppliedCount = outAppliedCount + 1
        i = i + replacementLen
    return text

@borrows
fn CompilerLegacyRewriteArrayTypes(textRaw: str,
                                     outAppliedCount: var int32): str =
    var text = parser.ParserOwnedText(textRaw)
    outAppliedCount = 0
    var i = 0
    while i < text.len:
        if i + 6 > text.len:
            break
        if !parser.ParserTextEqualsAt(text, i, "array["):
            i = i + 1
            continue
        let closePos = CompilerLegacyFindMatchingBracket(text, i + 5)
        if closePos <= i + 5:
            i = i + 1
            continue
        let inner = parser.ParserOwnedTextRange(text, i + 6, closePos - (i + 6))
        let commaPos = CompilerLegacyTopLevelComma(inner)
        if commaPos <= 0:
            i = i + 1
            continue
        let elemText = parser.ParserOwnedText(
            strutil.Strip(parser.ParserOwnedTextRange(inner, 0, commaPos)))
        let lenText = parser.ParserOwnedText(
            strutil.Strip(parser.ParserOwnedTextRange(
                inner,
                commaPos + 1,
                inner.len - (commaPos + 1))))
        let replacement = strutil.Join([elemText, "[", lenText, "]"], "")
        let prefix = parser.ParserOwnedTextRange(text, 0, i)
        let suffix = parser.ParserOwnedTextRange(text, closePos + 1, text.len - (closePos + 1))
        let replacementLen = replacement.len
        var rewritten = strutil.Join([prefix, replacement], "")
        rewritten = strutil.Join([rewritten, suffix], "")
        text = rewritten
        outAppliedCount = outAppliedCount + 1
        i = i + replacementLen
    return text

fn CompilerLegacyApplyMigrationElseIfSpansInto(
        textRaw: str,
        outText: var str,
        outAppliedCount: var int32,
        err: var str): bool =
    outText = ""
    outAppliedCount = 0
    var spanStarts: int32[]
    var spanEnds: int32[]
    if !parser.ParserMigrationElseIfRewriteSpansInto(
            textRaw,
            spanStarts,
            spanEnds,
            err) ||
       !parser.ParserMigrationElseIfRewriteSpansValidateInto(
            textRaw,
            spanStarts,
            spanEnds,
            err):
        return false
    var parts: str[]
    var cursor: int32
    for spanIndex in 0..<spanStarts.len:
        add(parts,
            chengpath.TextSlice(textRaw,
                                cursor,
                                spanStarts[spanIndex] - cursor))
        add(parts, "elif")
        cursor = spanEnds[spanIndex]
    add(parts,
        chengpath.TextSlice(textRaw,
                            cursor,
                            textRaw.len - cursor))
    outText = strutil.Join(parts, "")
    outAppliedCount = spanStarts.len
    err = ""
    return true

@borrows
fn CompilerLegacyNormalizeTextInto(
        textRaw: str,
        outAppliedRules: var str[],
        outAppliedCount: var int32,
        outText: var str,
        err: var str): bool =
    outAppliedRules = []
    outAppliedCount = 0
    var text = parser.ParserOwnedText(textRaw)
    let atListText = strutil.Replace(text, "@[]", "[]")
    if !parser.ParserTextEqualsExact(atListText, text):
        CompilerCsgAddUnique(outAppliedRules, "at_list_to_list")
        outAppliedCount = outAppliedCount + 1
        text = atListText
    var seqApplied = 0
    text = CompilerLegacyRewriteSeqTypes(text, seqApplied)
    if seqApplied > 0:
        CompilerCsgAddUnique(outAppliedRules, "seq_type_to_suffix")
        outAppliedCount = outAppliedCount + seqApplied
    var arrayApplied = 0
    text = CompilerLegacyRewriteArrayTypes(text, arrayApplied)
    if arrayApplied > 0:
        CompilerCsgAddUnique(outAppliedRules, "array_type_to_suffix")
        outAppliedCount = outAppliedCount + arrayApplied
    let lines = parser.ParserSplitChar(text, '\n')
    var out = ""
    for i in 0..<lines.len:
        var line = parser.ParserOwnedText(lines[i])
        let trimmed = parser.ParserOwnedText(chengpath.PathTrim(line))
        let indent = CompilerLegacyLineIndent(line)
        if parser.ParserTextEqualsAt(trimmed, 0, "proc "):
            CompilerCsgAddUnique(outAppliedRules, "proc_to_fn")
            outAppliedCount = outAppliedCount + 1
            line = parser.ParserConcat3(
                indent,
                "fn ",
                parser.ParserOwnedTextRange(trimmed, 5, trimmed.len - 5))
        elif parser.ParserTextEqualsAt(trimmed, 0, "method "):
            CompilerCsgAddUnique(outAppliedRules, "method_to_fn")
            outAppliedCount = outAppliedCount + 1
            line = parser.ParserConcat3(
                indent,
                "fn ",
                parser.ParserOwnedTextRange(trimmed, 7, trimmed.len - 7))
        elif parser.ParserTextEqualsAt(trimmed, 0, "converter "):
            CompilerCsgAddUnique(outAppliedRules, "converter_to_fn")
            outAppliedCount = outAppliedCount + 1
            line = parser.ParserConcat3(
                indent,
                "fn ",
                parser.ParserOwnedTextRange(trimmed, 10, trimmed.len - 10))
        if i > 0:
            out = parser.ParserConcat2(out, "\n")
        out = parser.ParserConcat2(out, line)
    var migratedElseIfText: str
    var elseIfAppliedCount: int32
    if !CompilerLegacyApplyMigrationElseIfSpansInto(
            out,
            migratedElseIfText,
            elseIfAppliedCount,
            err):
        return false
    if elseIfAppliedCount > 0:
        CompilerCsgAddUnique(outAppliedRules, "else_if_to_elif")
        outAppliedCount = outAppliedCount + elseIfAppliedCount
    outText = migratedElseIfText
    err = ""
    return true

@borrows
fn CompilerLegacyCollectClosure(workspaceRoot: str,
                                  packageRoot: str,
                                  packageId: str,
                                  sourcePathRaw: str,
                                  targetModulePathCertificate: str,
                                  units: var CompilerLegacySourceUnit[],
                                  outAppliedRules: var str[],
                                  outAppliedCount: var int32,
                                  err: var str): bool =
    var sourcePath: str
    if !parser.ParserSourceIdentityLexicalPathInto(
            chengpath.PathAbsolute(packageRoot, sourcePathRaw),
            sourcePath) ||
       !parser.ParserSourceIdentityPathAbsolute(sourcePath):
        err = " compiler migration: missing legacy source path"
        return false
    let targetModulePathRaw = parser.ParserOwnedText(
        chengpath.PathTrim(targetModulePathCertificate))
    if parser.ParserTextEqualsExact(targetModulePathRaw, ""):
        err = parser.ParserConcat2(
            " compiler migration: target module certificate missing origin=",
            sourcePath)
        return false
    var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var targetModulePath: str
    var targetSourcePath: str
    if !parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
            workspaceRoot,
            packageRoot,
            packageId,
            noExternalPackageRoots,
            targetModulePathRaw,
            targetModulePath,
            targetSourcePath):
        err = parser.ParserConcat4(
            " compiler migration: target module certificate invalid origin=",
            sourcePath,
            " target=",
            targetModulePathRaw)
        return false
    for i in 0..<units.len:
        if !parser.ParserTextEqualsExact(units[i].sourcePath, sourcePath):
            continue
        if !parser.ParserTextEqualsExact(units[i].modulePath, targetModulePath) ||
           !parser.ParserTextEqualsExact(units[i].targetSourcePath, targetSourcePath):
            err = parser.ParserConcat2(
                " compiler migration: origin has conflicting target certificates origin=",
                sourcePath)
            return false
        err = ""
        return true
    if !os.FileExists(sourcePath):
        err = parser.ParserConcat2(
            " compiler migration: missing legacy source: ",
            sourcePath)
        return false
    let legacyText = chengpath.ReadTextFile("", sourcePath)
    var localRules: str[]
    var localAppliedCount = 0
    var migratedText: str
    if !CompilerLegacyNormalizeTextInto(legacyText,
                                         localRules,
                                         localAppliedCount,
                                         migratedText,
                                         err):
        err = parser.ParserConcat4(
            " compiler migration: source normalization failed origin=",
            sourcePath,
            ": ",
            err)
        return false
    var unit: CompilerLegacySourceUnit
    unit.sourcePath = parser.ParserOwnedText(sourcePath)
    unit.targetSourcePath = parser.ParserOwnedText(targetSourcePath)
    unit.modulePath = parser.ParserOwnedText(targetModulePath)
    unit.legacyText = parser.ParserOwnedText(legacyText)
    unit.migratedText = parser.ParserOwnedText(migratedText)
    add(units, unit)
    for i in 0..<localRules.len:
        CompilerCsgAddUnique(outAppliedRules, localRules[i])
    outAppliedCount = outAppliedCount + localAppliedCount
    var importSpecs: parser.ParserImportSpec[]
    if !parser.ParserReadImportSpecs(targetModulePath,
                                     migratedText,
                                     importSpecs,
                                     err):
        return false
    for i in 0..<importSpecs.len:
        var importedTargetModulePath: str
        var importedTargetSourcePath: str
        let importedModulePathText = parser.ParserOwnedText(
            importSpecs[i].targetModulePath)
        if !parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                workspaceRoot,
                packageRoot,
                packageId,
                noExternalPackageRoots,
                importedModulePathText,
                importedTargetModulePath,
                importedTargetSourcePath):
            err = parser.ParserConcat4(
                " compiler migration: imported target identity unavailable owner=",
                targetModulePath,
                " target=",
                importedModulePathText)
            return false
        if !CompilerLegacyCollectClosure(workspaceRoot,
                                          packageRoot,
                                          packageId,
                                          importedTargetSourcePath,
                                          importedTargetModulePath,
                                          units,
                                          outAppliedRules,
                                          outAppliedCount,
                                          err):
            return false
    err = ""
    return true

@borrows
fn CompilerLegacyBuildPlan(workspaceRoot: str,
                             packageRoot: str,
                             packageId: str,
                             sourceBundleCid: layout.FixedBytes32,
                             units: CompilerLegacySourceUnit[],
                             targetSourcePaths: str[],
                             targetOwnerModulePaths: str[],
                             sourceTexts: str[],
                             importEdges: parser.ImportEdge[],
                             unresolvedImportCount: int32,
                             out: var slplan.SystemLinkPlanStub,
                             err: var str): bool =
    if units.len <= 0 ||
       targetSourcePaths.len != units.len ||
       targetOwnerModulePaths.len != units.len ||
       sourceTexts.len != units.len:
        err = " compiler migration: legacy plan source columns mismatch"
        return false
    if unresolvedImportCount != 0:
        err = Fmt" compiler migration: portable source receipt has unresolved imports count={unresolvedImportCount}"
        return false
    var portableBinding: slplan.SystemLinkPlanPortableSourceBinding
    if !slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
            share(packageId),
            targetOwnerModulePaths[0],
            share(targetOwnerModulePaths),
            share(sourceTexts),
            share(importEdges),
            portableBinding,
            err):
        return false
    if !layout.FixedBytes32Equal(portableBinding.sourceBundleCid,
                                 sourceBundleCid):
        err = " compiler migration: portable source bundle receipt disagrees with source texts"
        return false
    let entrySourcePath = targetSourcePaths[0]
    let entryModulePath = targetOwnerModulePaths[0]
    out.entryPath = entrySourcePath
    out.outputPath = ""
    out.targetTriple = tmat.TargetTripleDarwinA64()
    out.emitKind = creq.EmitExe
    out.packageRoot = packageRoot
    out.workspaceRoot = workspaceRoot
    out.packageId = packageId
    out.moduleStem = entryModulePath
    out.moduleKind = slplan.SystemOrdinaryProgram
    out.sourceBundleCid = Ok[layout.FixedBytes32](
        layout.FixedBytes32Copy(sourceBundleCid))
    out.sourceBundleCidValue = sourceBundleCid
    out.sourceBundleEntrySourceIndex = 0
    out.sourceBundleEntrySourceCid = portableBinding.entrySourceCid
    if entryModulePath == "cheng/core/tooling/compiler_main":
        out.moduleKind = slplan.SystemCompilerControlPlane
    out.sourceClosurePaths = share(targetSourcePaths)
    out.ownerModulePaths = share(targetOwnerModulePaths)
    out.sourceBundleIdentityPaths = out.ownerModulePaths
    out.importEdges = share(importEdges)
    out.importEdgeCount = importEdges.len
    out.unresolvedImportCount = unresolvedImportCount
    out.sourceBundleImportGraphCid = portableBinding.importGraphCid
    out.hasCompilerTopLevel = true
    out.mainFunctionPresent = parser.ParserMigrationSourceMainFunctionPresent(
        parser.ParserOwnedText(sourceTexts[0]))
    if out.moduleKind == slplan.SystemCompilerControlPlane:
        out.runtimeTargets = ["runtime/compiler.tooling_argv_entry"]
    else:
        out.runtimeTargets = ["runtime/compiler.program_argv_entry"]
    var providerModules: str[]
    add(providerModules, "runtime/compiler_runtime")
    add(providerModules, "runtime/core_runtime")
    add(providerModules, "runtime/debug_runtime")
    add(providerModules, "runtime/program_support")
    add(providerModules, "runtime/program_support_get_env_bridge")
    add(providerModules, "runtime/program_support_host_runtime")
    out.providerModules = providerModules
    out.entrySymbol = ""
    if out.mainFunctionPresent:
        out.entrySymbol = "main"
    out.missingReasons = []
    out.parserSyntaxTag = "cheng.migration_source"
    out.parserSourceKind = 1
    out.buildEntryPath = entrySourcePath
    out.buildSourceUnitCount = units.len
    out.linkMode = "system_link"
    out.pipelineStage = "migration_source_to_canonical_csg"
    out.sourceBundleBindingSeal =
        slplan.SystemLinkPlanComputeSourceBundleBindingSeal(
            out.packageId,
            out.workspaceRoot,
            out.packageRoot,
            out.externalPackageRoots,
            out.sourceBundleEntrySourceIndex,
            out.sourceBundleCidValue,
            out.sourceBundleEntrySourceCid,
            out.sourceBundleImportGraphCid,
            out.sourceBundleIdentityPaths,
            out.sourceClosurePaths,
            out.ownerModulePaths,
            out.importEdges,
            out.unresolvedImportCount)
    err = ""
    return true

@borrows
fn CompilerLegacyBuildCsgFromPlanTextsInto(
        plan: var slplan.SystemLinkPlanStub,
        sourceTexts: str[],
        targetSourcePaths: str[],
        targetOwnerModulePaths: str[],
        out: var CompilerCsg,
        err: var str): bool =
    if sourceTexts.len <= 0 ||
       sourceTexts.len != targetSourcePaths.len ||
       sourceTexts.len != targetOwnerModulePaths.len:
        err = " compiler migration: csg source columns mismatch"
        return false
    var overrides: CompilerCsgSourceText[]
    for index in 0..<sourceTexts.len:
        var override: CompilerCsgSourceText
        override.sourcePath = share(targetSourcePaths[index])
        override.modulePath = share(targetOwnerModulePaths[index])
        override.text = share(sourceTexts[index])
        add(overrides, override)
    var sourceReceipt: PortableSourceIdentityReceipt
    if !PortableSourceIdentityReceiptMakeInto(
            sourceTexts.len,
            plan.importEdges.len,
            plan.unresolvedImportCount,
            plan.packageId,
            targetOwnerModulePaths[0],
            plan.sourceBundleCidValue,
            plan.sourceBundleEntrySourceCid,
            plan.sourceBundleImportGraphCid,
            sourceReceipt,
            err):
        return false
    if !BuildCompilerCsgConsumePortableReceiptWithOverridesInto(
            out,
            err,
            plan,
            sourceReceipt,
            "",
            "",
            overrides):
        return false
    err = ""
    return true

fn CompilerMigrationArtifactFromCsgInto(
        csg: var CompilerCsg,
        out: var CompilerMigrationArtifact) =
    out.sourceIdentityReceipt = csg.sourceIdentityReceipt
    out.canonicalCsgReport = CompilerCsgCanonicalSidecarReport(csg)
    out.canonicalGraphCid = csg.canonicalGraphCid
    CompilerExportSurfaceFromCsgInto(csg, out.exportSurface)

# Production migration build: writes the migration directly into out, so no
# Result temporary and no whole-payload deep clone ever exists on this path.
# out must be a fresh (default-constructed) destination.
@borrows
fn BuildCompilerLegacyMigrationInto(workspaceRoot: str,
                                    packageRoot: str,
                                    entrySourcePath: str,
                                    packageIdHint: str,
                                    targetEntryModuleCertificate: str,
                                    out: var CompilerLegacyMigration): Result[bool] =
    if chengpath.PathTrim(targetEntryModuleCertificate) == "":
        return Err[bool](
            " compiler migration: canonical target entry module certificate required")
    let packageId = parser.ParserManifestNormalizePackageId(packageIdHint)
    if packageId == "" || packageId != packageIdHint:
        return Err[bool](
            " compiler migration: canonical package identity certificate required")
    var units: CompilerLegacySourceUnit[]
    var appliedRules: str[]
    var appliedCount = 0
    var err = ""
    if !CompilerLegacyCollectClosure(workspaceRoot,
                                       packageRoot,
                                       packageId,
                                       entrySourcePath,
                                       targetEntryModuleCertificate,
                                       units,
                                       appliedRules,
                                       appliedCount,
                                       err):
        return Err[bool](err)
    var legacyTexts: str[]
    var legacySourcePaths: str[]
    var migratedTexts: str[]
    for i in 0..<units.len:
        add(legacySourcePaths, share(units[i].sourcePath))
        add(legacyTexts, share(units[i].legacyText))
        add(migratedTexts, share(units[i].migratedText))
    var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var targetSourcePaths: str[]
    var targetOwnerModulePaths: str[]
    for i in 0..<units.len:
        var canonicalTargetModulePath: str
        var canonicalTargetSourcePath: str
        if !parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                workspaceRoot,
                packageRoot,
                packageId,
                noExternalPackageRoots,
                units[i].modulePath,
                canonicalTargetModulePath,
                canonicalTargetSourcePath):
            return Err[bool](
                Fmt" compiler migration: canonical target identity unavailable origin={legacySourcePaths[i]} module={units[i].modulePath}")
        if canonicalTargetModulePath != units[i].modulePath ||
           canonicalTargetSourcePath != units[i].targetSourcePath:
            return Err[bool](
                Fmt" compiler migration: target identity certificate drift origin={legacySourcePaths[i]}")
        if slplan.SystemLinkPlanTextIndex(targetSourcePaths,
                                          canonicalTargetSourcePath) >= 0:
            return Err[bool](
                Fmt" compiler migration: duplicate canonical target source={canonicalTargetSourcePath}")
        units[i].modulePath = share(canonicalTargetModulePath)
        add(targetSourcePaths, canonicalTargetSourcePath)
        add(targetOwnerModulePaths, canonicalTargetModulePath)
    var legacyImportEdges: parser.ImportEdge[]
    var legacyUnresolvedImportCount: int32
    if !slplan.SystemLinkPlanRebuildImportEdgesFromTextsInto(
            workspaceRoot,
            packageRoot,
            packageId,
            noExternalPackageRoots,
            targetSourcePaths,
            targetOwnerModulePaths,
            legacyTexts,
            0,
            legacyImportEdges,
            legacyUnresolvedImportCount,
            err):
        return Err[bool](err)
    let legacyBundleRes = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        packageId,
        targetOwnerModulePaths,
        legacyTexts)
    if IsErr(legacyBundleRes):
        return Err[bool](Error(legacyBundleRes))
    var legacyPlan: slplan.SystemLinkPlanStub
    if !CompilerLegacyBuildPlan(workspaceRoot,
                                  packageRoot,
                                  packageId,
                                  Value(legacyBundleRes),
                                  units,
                                  targetSourcePaths,
                                  targetOwnerModulePaths,
                                  legacyTexts,
                                  legacyImportEdges,
                                  legacyUnresolvedImportCount,
                                  legacyPlan,
                                  err):
        var legacyBuildReleaseReceipt: slplan.SystemLinkPlanReleaseReceipt
        slplan.SystemLinkPlanReleaseWithReceipt(
            legacyPlan, legacyBuildReleaseReceipt)
        var legacyBuildReleaseErr: str
        if !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
               legacyPlan,
               legacyBuildReleaseReceipt,
               legacyBuildReleaseErr):
            panic(legacyBuildReleaseErr)
        return Err[bool](err)
    legacyImportEdges = []
    var baselineCsg: CompilerCsg
    if !CompilerLegacyBuildCsgFromPlanTextsInto(
            legacyPlan,
            legacyTexts,
            targetSourcePaths,
            targetOwnerModulePaths,
            baselineCsg,
            err):
        CompilerCsgTerminalRelease(baselineCsg)
        var legacyCsgReleaseReceipt: slplan.SystemLinkPlanReleaseReceipt
        slplan.SystemLinkPlanReleaseWithReceipt(
            legacyPlan, legacyCsgReleaseReceipt)
        var legacyCsgReleaseErr: str
        if !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
               legacyPlan,
               legacyCsgReleaseReceipt,
               legacyCsgReleaseErr):
            panic(legacyCsgReleaseErr)
        return Err[bool](err)
    CompilerMigrationArtifactFromCsgInto(baselineCsg,
                                         out.baselineArtifact)
    CompilerCsgTerminalRelease(baselineCsg)
    var legacyReleaseReceipt: slplan.SystemLinkPlanReleaseReceipt
    slplan.SystemLinkPlanReleaseWithReceipt(
        legacyPlan, legacyReleaseReceipt)
    var legacyReleaseErr: str
    if !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
           legacyPlan,
           legacyReleaseReceipt,
           legacyReleaseErr):
        panic(legacyReleaseErr)
    if slplan.SystemLinkPlanExecutionPayloadRetainedItemCount(legacyPlan) != 0:
        return Err[bool](
            " compiler migration: baseline plan execution payload release incomplete")

    var migratedImportEdges: parser.ImportEdge[]
    var migratedUnresolvedImportCount: int32
    if !slplan.SystemLinkPlanRebuildImportEdgesFromTextsInto(
            workspaceRoot,
            packageRoot,
            packageId,
            noExternalPackageRoots,
            targetSourcePaths,
            targetOwnerModulePaths,
            migratedTexts,
            0,
            migratedImportEdges,
            migratedUnresolvedImportCount,
            err):
        return Err[bool](err)
    let migratedBundleRes = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        packageId,
        targetOwnerModulePaths,
        migratedTexts)
    if IsErr(migratedBundleRes):
        return Err[bool](Error(migratedBundleRes))
    var plan: slplan.SystemLinkPlanStub
    if !CompilerLegacyBuildPlan(workspaceRoot,
                                  packageRoot,
                                  packageId,
                                  Value(migratedBundleRes),
                                  units,
                                  targetSourcePaths,
                                  targetOwnerModulePaths,
                                  migratedTexts,
                                  migratedImportEdges,
                                  migratedUnresolvedImportCount,
                                  plan,
                                  err):
        var migratedBuildReleaseReceipt: slplan.SystemLinkPlanReleaseReceipt
        slplan.SystemLinkPlanReleaseWithReceipt(
            plan, migratedBuildReleaseReceipt)
        var migratedBuildReleaseErr: str
        if !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
               plan,
               migratedBuildReleaseReceipt,
               migratedBuildReleaseErr):
            panic(migratedBuildReleaseErr)
        return Err[bool](err)
    migratedImportEdges = []
    var migratedCsg: CompilerCsg
    if !CompilerLegacyBuildCsgFromPlanTextsInto(
            plan,
            migratedTexts,
            targetSourcePaths,
            targetOwnerModulePaths,
            migratedCsg,
            err):
        CompilerCsgTerminalRelease(migratedCsg)
        var migratedCsgReleaseReceipt: slplan.SystemLinkPlanReleaseReceipt
        slplan.SystemLinkPlanReleaseWithReceipt(
            plan, migratedCsgReleaseReceipt)
        var migratedCsgReleaseErr: str
        if !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
               plan,
               migratedCsgReleaseReceipt,
               migratedCsgReleaseErr):
            panic(migratedCsgReleaseErr)
        return Err[bool](err)
    CompilerMigrationArtifactFromCsgInto(migratedCsg,
                                         out.migratedArtifact)
    CompilerCsgTerminalRelease(migratedCsg)
    var migratedReleaseReceipt: slplan.SystemLinkPlanReleaseReceipt
    slplan.SystemLinkPlanReleaseWithReceipt(
        plan, migratedReleaseReceipt)
    var migratedReleaseErr: str
    if !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
           plan,
           migratedReleaseReceipt,
           migratedReleaseErr):
        panic(migratedReleaseErr)
    if slplan.SystemLinkPlanExecutionPayloadRetainedItemCount(plan) != 0:
        return Err[bool](
            " compiler migration: migrated plan execution payload release incomplete")
    var migBuf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerCsgAppendText(migBuf, "cheng.compiler.legacy_migration")
    CompilerCsgAppendText(migBuf, packageId)
    CompilerCsgAppendText(migBuf, targetOwnerModulePaths[0])
    compilerCsgPortableAppendU32Field(migBuf, units.len)
    for i in 0..<units.len:
        CompilerCsgAppendText(migBuf, targetOwnerModulePaths[i])
        compilerCsgPortableAppendFixed32Field(
            migBuf,
            cworld.CompilerWorldSourceRawBytesCid(legacyTexts[i]))
        compilerCsgPortableAppendFixed32Field(
            migBuf,
            cworld.CompilerWorldSourceRawBytesCid(migratedTexts[i]))
    compilerCsgPortableAppendFixed32Field(migBuf, Value(legacyBundleRes))
    compilerCsgPortableAppendFixed32Field(migBuf, Value(migratedBundleRes))
    compilerCsgPortableAppendFixed32Field(
        migBuf,
        out.baselineArtifact.sourceIdentityReceipt.receiptCid)
    compilerCsgPortableAppendFixed32Field(
        migBuf,
        out.baselineArtifact.canonicalGraphCid)
    compilerCsgPortableAppendFixed32Field(
        migBuf,
        out.baselineArtifact.exportSurface.surfaceCid)
    compilerCsgPortableAppendFixed32Field(
        migBuf,
        out.migratedArtifact.sourceIdentityReceipt.receiptCid)
    compilerCsgPortableAppendFixed32Field(
        migBuf,
        out.migratedArtifact.canonicalGraphCid)
    compilerCsgPortableAppendFixed32Field(
        migBuf,
        out.migratedArtifact.exportSurface.surfaceCid)
    compilerCsgPortableAppendU32Field(migBuf, appliedCount)
    compilerCsgPortableAppendU32Field(migBuf, appliedRules.len)
    for i in 0..<appliedRules.len:
        CompilerCsgAppendText(migBuf, appliedRules[i])
    out.packageId = packageId
    out.entrySourcePath = legacySourcePaths[0]
    out.entryModulePath = targetOwnerModulePaths[0]
    out.unitCount = units.len
    out.units = units
    units = []
    out.appliedRuleCount = appliedCount
    out.appliedRules = appliedRules
    appliedRules = []
    out.legacySourceBundleCid = Value(legacyBundleRes)
    out.migratedSourceBundleCid = Value(migratedBundleRes)
    out.migrationCid = CompilerCsgBufCid(migBuf)
    return Ok[bool](true)

# Value-returning wrapper for callers that do not own an output slot.
fn BuildCompilerLegacyMigration(workspaceRoot: str,
                                packageRoot: str,
                                entrySourcePath: str,
                                packageIdHint: str,
                                targetEntryModuleCertificate: str): Result[CompilerLegacyMigration] =
    var out: CompilerLegacyMigration
    let res = BuildCompilerLegacyMigrationInto(workspaceRoot,
                                               packageRoot,
                                               entrySourcePath,
                                               packageIdHint,
                                               targetEntryModuleCertificate,
                                               out)
    if IsErr(res):
        return Err[CompilerLegacyMigration](Error(res))
    out.packageId = parser.ParserOwnedText(out.packageId)
    out.entrySourcePath = parser.ParserOwnedText(out.entrySourcePath)
    out.entryModulePath = parser.ParserOwnedText(out.entryModulePath)
    out.units = CompilerLegacySourceUnitsClone(out.units)
    out.baselineArtifact = CompilerMigrationArtifactClone(out.baselineArtifact)
    out.migratedArtifact = CompilerMigrationArtifactClone(out.migratedArtifact)
    return Ok[CompilerLegacyMigration](out)

@borrows
fn CompilerLegacyMigrationReport(migration: CompilerLegacyMigration): str =
    var buf = layout.ByteBufInit(512)
    CompilerCsgReportBufAppendText(buf, "package_id=")
    CompilerCsgReportBufAppendText(buf, migration.packageId)
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "entry_source_path=")
    CompilerCsgReportBufAppendText(buf, migration.entrySourcePath)
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "entry_module_path=")
    CompilerCsgReportBufAppendText(buf, migration.entryModulePath)
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "unit_count=")
    CompilerCsgReportBufAppendText(buf, IntToStr(migration.unitCount))
    CompilerCsgReportBufAppendText(buf, "\n")
    for i in 0..<migration.units.len:
        let iText = IntToStr(i)
        CompilerCsgReportBufAppendText(buf, "unit[")
        CompilerCsgReportBufAppendText(buf, iText)
        CompilerCsgReportBufAppendText(buf, "].origin_source_path=")
        CompilerCsgReportBufAppendText(buf, migration.units[i].sourcePath)
        CompilerCsgReportBufAppendText(buf, "\nunit[")
        CompilerCsgReportBufAppendText(buf, iText)
        CompilerCsgReportBufAppendText(buf, "].target_source_path=")
        CompilerCsgReportBufAppendText(buf, migration.units[i].targetSourcePath)
        CompilerCsgReportBufAppendText(buf, "\nunit[")
        CompilerCsgReportBufAppendText(buf, iText)
        CompilerCsgReportBufAppendText(buf, "].target_module_path=")
        CompilerCsgReportBufAppendText(buf, migration.units[i].modulePath)
        CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "applied_rule_count=")
    CompilerCsgReportBufAppendText(buf, IntToStr(migration.appliedRuleCount))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "legacy_source_bundle_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.legacySourceBundleCid))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "migrated_source_bundle_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.migratedSourceBundleCid))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "legacy_source_identity_receipt_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.baselineArtifact.sourceIdentityReceipt.receiptCid))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "legacy_canonical_graph_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.baselineArtifact.canonicalGraphCid))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "legacy_surface_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.baselineArtifact.exportSurface.surfaceCid))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "migrated_source_identity_receipt_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.migratedArtifact.sourceIdentityReceipt.receiptCid))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "migrated_canonical_graph_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.migratedArtifact.canonicalGraphCid))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "migrated_surface_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.migratedArtifact.exportSurface.surfaceCid))
    CompilerCsgReportBufAppendText(buf, "\n")
    CompilerCsgReportBufAppendText(buf, "migration_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(migration.migrationCid))
    for i in 0..<migration.appliedRules.len:
        CompilerCsgReportBufAppendText(buf, "\n")
        CompilerCsgReportBufAppendText(buf, "applied_rule[")
        CompilerCsgReportBufAppendText(buf, IntToStr(i))
        CompilerCsgReportBufAppendText(buf, "]=")
        CompilerCsgReportBufAppendText(buf, migration.appliedRules[i])
    return CompilerCsgReportBufTakeText(buf)

fn CompilerCsgAddNode(nodes: var CompilerCsgNode[],
                        nodeKind: int32,
                        ownerNodeId: int32,
                        modulePath: str,
                        symbolText: str,
                        factText: str,
                        resultLayoutKind: int32,
                        effectKind: int32,
                        capabilityKind: int32,
                        callConv: int32,
                        entryFlag: int32,
                        exportedFlag: int32,
                        exportSymbolName: str): int32 =
    var node: CompilerCsgNode
    node.nodeId = nodes.len + 1
    node.nodeKind = nodeKind
    node.ownerNodeId = ownerNodeId
    node.modulePath = modulePath
    node.symbolText = symbolText
    node.factText = factText
    node.resultLayoutKind = resultLayoutKind
    node.effectKind = effectKind
    node.capabilityKind = capabilityKind
    node.callConv = callConv
    node.entryFlag = entryFlag
    node.exportedFlag = exportedFlag
    node.exportSymbolName = exportSymbolName
    node.factCid = CompilerCsgHashNodeRecord(node)
    let nodeId = node.nodeId
    add(nodes, node)
    return nodeId

fn CompilerCsgAddEdge(edges: var CompilerCsgEdge[],
                        fromNodeId: int32,
                        toNodeId: int32,
                        edgeKind: int32) =
    var edge: CompilerCsgEdge
    edge.edgeId = edges.len + 1
    edge.fromNodeId = fromNodeId
    edge.toNodeId = toNodeId
    edge.edgeKind = edgeKind
    edge.edgeCid = CompilerCsgHashEdge(fromNodeId, toNodeId, edgeKind)
    add(edges, edge)

fn CompilerCsgExprLayerForText(sourcePath: str,
                                 text: str,
                                 importcCallNames: var str[],
                                 localCallNames: var str[],
                                 externalCallNames: var str[],
                                 currentProfile: var parser.NormalizedExprCallProfile,
                                 profiles: var parser.NormalizedExprCallProfile[],
                                 profileIndexLookup: var parser.ParserSourcePathIndexLookup,
                                 layer: var parser.NormalizedExprLayer): Result[bool] =
    var err: str
    if !parser.ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfiles(sourcePath,
                                                                                text,
                                                                                importcCallNames,
                                                                                localCallNames,
                                                                                externalCallNames,
                                                                                currentProfile,
                                                                                profiles,
                                                                                profileIndexLookup,
                                                                                layer,
                                                                                err):
        if err != "":
            return Err[bool](err)
        return Err[bool](" compiler csg: expr layer read failed")
    return Ok[bool](true)

fn CompilerCsgTextRangeEquals(text: str,
                               start: int32,
                               stop: int32,
                               expected: str): bool =
    if start < 0 || stop < start || stop > text.len:
        return false
    if stop - start != expected.len:
        return false
    for i in 0..<expected.len:
        if text[start + i] != expected[i]:
            return false
    return true

fn CompilerCsgTrimmedLineEquals(line: str,
                                 expected: str): bool =
    var start: int32
    var stop: int32
    if !parser.ParserTrimmedLineRange(line, start, stop):
        return false
    return CompilerCsgTextRangeEquals(line, start, stop, expected)

fn CompilerCsgLineContainsChar(line: str,
                                target: char): bool =
    for i in 0..<line.len:
        if line[i] == target:
            return true
    return false

fn CompilerCsgLineMayContainEmptyParen(line: str): bool =
    var inString = false
    var inChar = false
    var i: int32
    while i < line.len:
        let ch = line[i]
        if !inChar && ch == '"' && !parser.ParserQuoteIsEscaped(line, i):
            inString = !inString
            i = i + 1
            continue
        if !inString && ch == '\'' && !parser.ParserQuoteIsEscaped(line, i):
            inChar = !inChar
            i = i + 1
            continue
        if inString || inChar:
            i = i + 1
            continue
        if ch != '(':
            i = i + 1
            continue
        var cursor = i + 1
        while cursor < line.len && parser.ParserIsInlineSpace(line[cursor]):
            cursor = cursor + 1
        if cursor < line.len && line[cursor] == ')':
            return true
        i = cursor
    return false

# Deep-owned profile copy. The source is a by-value row, never a live
# unique container plus profiles[i].* projection in the caller.
@borrows
fn CompilerCsgCloneNormalizedExprCallProfileOwned(
        profile: parser.NormalizedExprCallProfile): parser.NormalizedExprCallProfile =
    var out: parser.NormalizedExprCallProfile
    out.sourcePath = parser.ParserOwnedText(profile.sourcePath)
    out.ownerModulePath = parser.ParserOwnedText(profile.ownerModulePath)
    out.migrationSourceSyntax = profile.migrationSourceSyntax
    out.text = parser.ParserOwnedText(profile.text)
    out.lines = CompilerCsgCloneStrSeq(profile.lines)
    out.maxQualifiedCallDepth = profile.maxQualifiedCallDepth
    out.importcCallNames = CompilerCsgCloneStrSeq(profile.importcCallNames)
    out.localCallNames = CompilerCsgCloneStrSeq(profile.localCallNames)
    for declIndex in 0..<profile.decls.len:
        var decl: parser.NormalizedFunctionDecl
        decl.name = parser.ParserOwnedText(profile.decls[declIndex].name)
        decl.lineIndex = profile.decls[declIndex].lineIndex
        decl.signatureStartColumn = profile.decls[declIndex].signatureStartColumn
        decl.signatureEndLineIndex = profile.decls[declIndex].signatureEndLineIndex
        decl.signatureEndColumn = profile.decls[declIndex].signatureEndColumn
        decl.nameStartColumn = profile.decls[declIndex].nameStartColumn
        decl.nameEndColumn = profile.decls[declIndex].nameEndColumn
        decl.bodyStartLineIndex = profile.decls[declIndex].bodyStartLineIndex
        decl.bodyStartColumn = profile.decls[declIndex].bodyStartColumn
        decl.importc = profile.decls[declIndex].importc
        decl.importcAnnotationBound =
            profile.decls[declIndex].importcAnnotationBound
        decl.explicitExportName = parser.ParserOwnedText(
            profile.decls[declIndex].explicitExportName)
        decl.surfaceKeyword = parser.ParserOwnedText(
            profile.decls[declIndex].surfaceKeyword)
        decl.ffiMapPtrArg = profile.decls[declIndex].ffiMapPtrArg
        decl.ffiMapLenArg = profile.decls[declIndex].ffiMapLenArg
        decl.ffiOutPtrArgs = parser.ParserOwnedText(
            profile.decls[declIndex].ffiOutPtrArgs)
        decl.abiInternal = profile.decls[declIndex].abiInternal
        decl.ffiOwnedResultPresent = profile.decls[declIndex].ffiOwnedResultPresent
        decl.ffiOwnedResultFree = parser.ParserOwnedText(
            profile.decls[declIndex].ffiOwnedResultFree)
        decl.borrowResult = profile.decls[declIndex].borrowResult
        decl.threadBoundary = profile.decls[declIndex].threadBoundary
        decl.borrows = profile.decls[declIndex].borrows
        decl.escapes = profile.decls[declIndex].escapes
        decl.weak = profile.decls[declIndex].weak
        decl.trustedAbi = profile.decls[declIndex].trustedAbi
        decl.noAlloc = profile.decls[declIndex].noAlloc
        decl.interruptHandler = profile.decls[declIndex].interruptHandler
        decl.keepExportBinding = profile.decls[declIndex].keepExportBinding
        decl.manualConsumePresent = profile.decls[declIndex].manualConsumePresent
        decl.manualConsumeFunctionDeclarationRow =
            profile.decls[declIndex].manualConsumeFunctionDeclarationRow
        decl.manualConsumeTargetParameterOrdinal =
            profile.decls[declIndex].manualConsumeTargetParameterOrdinal
        decl.manualConsumeTargetParameterDeclarationRow =
            profile.decls[declIndex].manualConsumeTargetParameterDeclarationRow
        decl.manualConsumeSourceParameterOrdinal =
            profile.decls[declIndex].manualConsumeSourceParameterOrdinal
        decl.manualConsumeSourceParameterDeclarationRow =
            profile.decls[declIndex].manualConsumeSourceParameterDeclarationRow
        decl.manualConsumeIdentityDigest =
            profile.decls[declIndex].manualConsumeIdentityDigest
        add(out.decls, decl)
    for typeDeclIndex in 0..<profile.typeDecls.len:
        var typeDecl: parser.NormalizedTypeDecl
        typeDecl.name = parser.ParserOwnedText(
            profile.typeDecls[typeDeclIndex].name)
        typeDecl.refObject = profile.typeDecls[typeDeclIndex].refObject
        add(out.typeDecls, typeDecl)
    for edgeIndex in 0..<profile.importEdges.len:
        var edge: parser.ImportEdge
        edge.ownerProducerSourceIndex =
            profile.importEdges[edgeIndex].ownerProducerSourceIndex
        edge.importDeclarationSourceLocalRow =
            profile.importEdges[edgeIndex].importDeclarationSourceLocalRow
        edge.importItemSourceLocalRow =
            profile.importEdges[edgeIndex].importItemSourceLocalRow
        edge.importDeclarationRow =
            profile.importEdges[edgeIndex].importDeclarationRow
        edge.importItemRow = profile.importEdges[edgeIndex].importItemRow
        edge.ownerModulePath = parser.ParserOwnedText(
            profile.importEdges[edgeIndex].ownerModulePath)
        edge.targetModulePath = parser.ParserOwnedText(
            profile.importEdges[edgeIndex].targetModulePath)
        edge.targetSourcePath = parser.ParserOwnedText(
            profile.importEdges[edgeIndex].targetSourcePath)
        edge.targetSourcePathLen =
            profile.importEdges[edgeIndex].targetSourcePathLen
        edge.targetSourcePathFirstCode =
            profile.importEdges[edgeIndex].targetSourcePathFirstCode
        edge.targetSourcePathLastCode =
            profile.importEdges[edgeIndex].targetSourcePathLastCode
        edge.targetSourcePathDotCount =
            profile.importEdges[edgeIndex].targetSourcePathDotCount
        edge.targetSourcePathHash =
            profile.importEdges[edgeIndex].targetSourcePathHash
        edge.targetProfileIndex =
            profile.importEdges[edgeIndex].targetProfileIndex
        edge.importAlias = parser.ParserOwnedText(
            profile.importEdges[edgeIndex].importAlias)
        edge.qualifier = parser.ParserOwnedText(
            profile.importEdges[edgeIndex].qualifier)
        edge.allowsUnqualifiedCall =
            profile.importEdges[edgeIndex].allowsUnqualifiedCall
        edge.resolved = profile.importEdges[edgeIndex].resolved
        add(out.importEdges, edge)
    return out

# Shared-borrow the compact rows and write independent owned parser
# arguments into caller locals. The caller must not project view.profiles
# after this returns.
@borrows
fn CompilerCsgExactParseOwnedInputsFromProfiles(
        profiles: parser.NormalizedExprCallProfile[],
        currentProfileLines: str[],
        importcCallNames: var str[],
        localCallNames: var str[],
        currentProfile: var parser.NormalizedExprCallProfile,
        lines: var str[],
        parserProfiles: var parser.NormalizedExprCallProfile[]) =
    importcCallNames = CompilerCsgCloneStrSeq(profiles[0].importcCallNames)
    localCallNames = CompilerCsgCloneStrSeq(profiles[0].localCallNames)
    currentProfile = CompilerCsgCloneNormalizedExprCallProfileOwned(profiles[0])
    lines = CompilerCsgCloneStrSeq(currentProfileLines)
    parserProfiles = []
    for profileIndex in 0..<profiles.len:
        add(parserProfiles,
            CompilerCsgCloneNormalizedExprCallProfileOwned(profiles[profileIndex]))

# Parse one immutable source snapshot exactly once.  The returned layer owns
# the sole source-local ParserValueExprTree used by every function slice; call
# resolution consumes the compact import-closure cache but never scans source
# lines independently.
@borrows
fn CompilerCsgParseExactFullSourceLayer(
        sourcePath: str,
        sourceText: str,
        currentProfileLines: str[],
        view: var CompilerCsgCompactProfileView,
        layer: var parser.NormalizedExprLayer,
        err: var str): bool =
    if view.profiles.len <= 0 || view.originalIndexes.len <= 0 ||
       view.cache.len != view.profiles.len:
        err = " compiler csg: exact source parser compact view invalid"
        return false
    var importcCallNames: str[]
    var localCallNames: str[]
    var currentProfile: parser.NormalizedExprCallProfile
    var ownedLines: str[]
    var parserProfiles: parser.NormalizedExprCallProfile[]
    CompilerCsgExactParseOwnedInputsFromProfiles(
        view.profiles,
        currentProfileLines,
        importcCallNames,
        localCallNames,
        currentProfile,
        ownedLines,
        parserProfiles)
    var parserLookup = parser.ParserSourcePathIndexLookupBuild(parserProfiles)
    var externalCallNames: str[]
    parser.ParserCollectExternalCallNames(
        parserProfiles,
        parserLookup,
        0,
        externalCallNames)
    if !parser.ParserReadNormalizedExprLayerFromTextWithKnownCallsAndProfilesCachedWithCurrentLines(
            sourcePath,
            sourceText,
            importcCallNames,
            localCallNames,
            externalCallNames,
            currentProfile,
            ownedLines,
            parserProfiles,
            parserLookup,
            view.cache,
            layer,
            err):
        return false
    if layer.sourceCount != 1 || layer.valueExprTree == nil ||
       layer.valueExprTreeBorrowLease ||
       layer.valueExprTree.producerSourceCount != 1:
        err = Fmt" compiler csg: exact source parser owner invalid source={sourcePath} source_count={layer.sourceCount}"
        parser.NormalizedExprLayerReset(layer)
        return false
    err = ""
    return true

# Counting-sort parser rows by authoritative line while retaining the parser's
# stable row order within each line.  This is O(lines + exprs) once per source;
# sorted, non-overlapping function ranges then visit each selected row once.
fn CompilerCsgExactSourceExprRowIndexBuild(
        fullSourceLayer: var parser.NormalizedExprLayer,
        sourceLineCount: int32,
        lineStarts: var int32[],
        rowIndexes: var int32[],
        err: var str): bool =
    lineStarts = []
    rowIndexes = []
    if sourceLineCount < 0 || fullSourceLayer.valueExprTree == nil ||
       fullSourceLayer.valueExprTreeBorrowLease:
        err = " compiler csg: exact source row index owner invalid"
        return false
    setLen(lineStarts, sourceLineCount + 2)
    setLen(rowIndexes, fullSourceLayer.exprs.len)
    for exprIndex in 0..<fullSourceLayer.exprs.len:
        let lineNumber = fullSourceLayer.exprs[exprIndex].lineNumber
        if lineNumber <= 0 || lineNumber > sourceLineCount:
            err = Fmt" compiler csg: exact source expression line invalid row={exprIndex} line={lineNumber} lines={sourceLineCount} kind={parser.NormalizedExprKindCode(fullSourceLayer.exprs[exprIndex].kind)} col={fullSourceLayer.exprs[exprIndex].columnNumber} surface={fullSourceLayer.exprs[exprIndex].surfaceText} n={fullSourceLayer.exprs.len} call={fullSourceLayer.exprs[exprIndex].valueExprCallNodeIndex} root={fullSourceLayer.exprs[exprIndex].valueExprRootNodeIndex} k0={parser.NormalizedExprKindCode(fullSourceLayer.exprs[0].kind)} l0={fullSourceLayer.exprs[0].lineNumber}"
            return false
        lineStarts[lineNumber + 1] = lineStarts[lineNumber + 1] + 1
    for lineSlot in 1..<lineStarts.len:
        lineStarts[lineSlot] = lineStarts[lineSlot] + lineStarts[lineSlot - 1]
    var writeCursors: int32[]
    setLen(writeCursors, lineStarts.len)
    for lineSlot in 0..<lineStarts.len:
        writeCursors[lineSlot] = lineStarts[lineSlot]
    for exprIndex in 0..<fullSourceLayer.exprs.len:
        let lineNumber = fullSourceLayer.exprs[exprIndex].lineNumber
        let writeIndex = writeCursors[lineNumber]
        if writeIndex < 0 || writeIndex >= rowIndexes.len:
            err = " compiler csg: exact source expression row index overflow"
            return false
        rowIndexes[writeIndex] = exprIndex
        writeCursors[lineNumber] = writeIndex + 1
    err = ""
    return true

@borrows
fn CompilerCsgExactFunctionExprLayerBorrow(
        fullSourceLayer: var parser.NormalizedExprLayer,
        lineStarts: int32[],
        rowIndexes: int32[],
        lineStartNumber: int32,
        lineEndNumber: int32,
        functionLayer: var parser.NormalizedExprLayer,
        err: var str): bool =
    parser.NormalizedExprLayerReset(functionLayer)
    if fullSourceLayer.valueExprTree == nil ||
       fullSourceLayer.valueExprTreeBorrowLease ||
       lineStartNumber <= 0 || lineEndNumber < lineStartNumber ||
       lineEndNumber + 1 >= lineStarts.len ||
       rowIndexes.len != fullSourceLayer.exprs.len:
        err = Fmt" compiler csg: exact function parser slice invalid start={lineStartNumber} end={lineEndNumber}"
        return false
    functionLayer.sourceCount = 1
    functionLayer.valueExprTree = parser.ParserValueExprTreeBorrow(
        fullSourceLayer.valueExprTree)
    functionLayer.valueExprTreeBorrowLease = true
    let rowStart = lineStarts[lineStartNumber]
    let rowEnd = lineStarts[lineEndNumber + 1]
    if rowStart < 0 || rowEnd < rowStart || rowEnd > rowIndexes.len:
        err = " compiler csg: exact function parser row range invalid"
        parser.NormalizedExprLayerReset(functionLayer)
        return false
    for rowOffset in rowStart..<rowEnd:
        let exprIndex = rowIndexes[rowOffset]
        if exprIndex < 0 || exprIndex >= fullSourceLayer.exprs.len:
            err = " compiler csg: exact function parser row missing"
            parser.NormalizedExprLayerReset(functionLayer)
            return false
        var expr: NormalizedExpr
        parser.NormalizedExprCloneInto(
            fullSourceLayer.exprs[exprIndex], expr)
        let before = functionLayer.exprs.len
        parser.NormalizedExprLayerAppendExisting(functionLayer, expr)
        if functionLayer.exprs.len != before + 1:
            err = Fmt" compiler csg: duplicate exact parser row source={expr.sourcePath} line={expr.lineNumber}"
            parser.NormalizedExprLayerReset(functionLayer)
            return false
    err = ""
    return true

@borrows
fn CompilerCsgExactExprRowsMarkFunctionDomain(
        lineStarts: int32[],
        rowIndexes: int32[],
        lineStartNumber: int32,
        lineEndNumber: int32,
        domain: int32,
        rowDomains: var int32[],
        err: var str): bool =
    if domain <= 0 || rowDomains.len != rowIndexes.len ||
       lineStartNumber <= 0 || lineEndNumber < lineStartNumber ||
       lineEndNumber + 1 >= lineStarts.len:
        err = " compiler csg: exact parser row domain invalid"
        return false
    let rowStart = lineStarts[lineStartNumber]
    let rowEnd = lineStarts[lineEndNumber + 1]
    if rowStart < 0 || rowEnd < rowStart || rowEnd > rowIndexes.len:
        err = " compiler csg: exact parser row domain range invalid"
        return false
    for rowOffset in rowStart..<rowEnd:
        let exprIndex = rowIndexes[rowOffset]
        if exprIndex < 0 || exprIndex >= rowDomains.len ||
           rowDomains[exprIndex] != 0:
            err = Fmt" compiler csg: exact parser expression assigned more than once row={exprIndex}"
            return false
        rowDomains[exprIndex] = domain
    err = ""
    return true

fn CompilerCsgExactExprRowsRequireClosed(
        fullSourceLayer: var parser.NormalizedExprLayer,
        rowDomains: int32[],
        err: var str): bool =
    if rowDomains.len != fullSourceLayer.exprs.len:
        err = " compiler csg: exact parser row coverage shape invalid"
        return false
    for exprIndex in 0..<rowDomains.len:
        if rowDomains[exprIndex] == 0:
            let expr = fullSourceLayer.exprs[exprIndex]
            err = Fmt" compiler csg: exact parser expression has no function or reachability domain row={exprIndex} source={expr.sourcePath} line={expr.lineNumber} kind={parser.NormalizedExprKindCode(expr.kind)}"
            return false
        if rowDomains[exprIndex] !=
               CompilerCsgExactExprDomainReachableFunction &&
           rowDomains[exprIndex] !=
               CompilerCsgExactExprDomainUnreachableFunction &&
           rowDomains[exprIndex] !=
               CompilerCsgExactExprDomainNonFunctionDeclaration &&
           rowDomains[exprIndex] !=
               CompilerCsgExactExprDomainEntrySourceExpression:
            err = Fmt" compiler csg: exact parser expression domain corrupt row={exprIndex} domain={rowDomains[exprIndex]}"
            return false
    err = ""
    return true

fn CompilerCsgExactExprRowsMarkNonFunctionDeclarationDomain(
        fullSourceLayer: var parser.NormalizedExprLayer,
        rowDomains: var int32[],
        entrySource: bool,
        err: var str): bool =
    if fullSourceLayer.valueExprTree == nil ||
       fullSourceLayer.valueExprTreeBorrowLease ||
       rowDomains.len != fullSourceLayer.exprs.len:
        err = " compiler csg: exact parser declaration domain owner invalid"
        return false
    if !parser.ParserValueExprTreeDeclarationsStrictValidateInto(
           fullSourceLayer.valueExprTree, err):
        err = Fmt" compiler csg: exact parser declaration root join invalid: {err}"
        return false
    for exprIndex in 0..<rowDomains.len:
        if rowDomains[exprIndex] != 0:
            continue
        let expr = fullSourceLayer.exprs[exprIndex]
        var parserNodeId = expr.valueExprRootNodeIndex
        if parserNodeId < 0:
            parserNodeId = expr.originParserNodeId
        if parserNodeId < 0 ||
           parserNodeId >= fullSourceLayer.valueExprTree.nodeCount:
            err = Fmt" compiler csg: exact parser expression lacks declaration node row={exprIndex} source={expr.sourcePath} line={expr.lineNumber}"
            return false
        let statementRootEvent =
            parser.ParserValueExprNodeEnclosingStatementRootEventAt(
                fullSourceLayer.valueExprTree,
                parserNodeId)
        if statementRootEvent < 0:
            err = Fmt" compiler csg: exact parser expression is not owned by a non-function declaration row={exprIndex} source={expr.sourcePath} line={expr.lineNumber}"
            return false
        if parser.ParserValueExprStatementRootIsNonFunctionDeclarationValue(
               fullSourceLayer.valueExprTree,
               statementRootEvent):
            rowDomains[exprIndex] =
                CompilerCsgExactExprDomainNonFunctionDeclaration
        elif entrySource &&
             parser.ParserValueExprStatementRootIsSourceExpressionValue(
                 fullSourceLayer.valueExprTree,
                 statementRootEvent):
            rowDomains[exprIndex] =
                CompilerCsgExactExprDomainEntrySourceExpression
        else:
            err = Fmt" compiler csg: exact parser expression has no permitted non-function owner row={exprIndex} source={expr.sourcePath} line={expr.lineNumber} entry_source={entrySource ? 1 : 0}"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgFrontierTransactionStageProfileSelection(sortedFunctions: int32[],
                                                        frontierIndex: CompilerCsgFrontierIndex,
                                                        reachableSet: var CompilerCsgReachableFunctionSet,
                                                        profiles: var parser.NormalizedExprCallProfile[],
                                                        transaction: var CompilerCsgFrontierTransaction,
                                                        err: var str): bool =
    for frontierItemIndex in 0..<sortedFunctions.len:
        let functionIndex = sortedFunctions[frontierItemIndex]
        if !CompilerCsgFrontierFunctionRowValidate(frontierIndex,
                                                    functionIndex,
                                                    transaction.certificateValidationOperationCount,
                                                    err):
            return false
        if !CompilerCsgReachableFunctionRowValidateDelta(reachableSet,
                                                         functionIndex,
                                                         transaction.reachabilityProbes):
            err = Fmt" compiler csg: frontier reachable function certificate mismatch function={functionIndex}"
            return false
        if functionIndex < 0 || functionIndex >= reachableSet.functionNames.len ||
           functionIndex >= reachableSet.sourcePaths.len ||
           functionIndex >= reachableSet.startLines.len ||
           functionIndex >= reachableSet.endLines.len ||
           functionIndex >= reachableSet.functionProfileIndexes.len:
            err = Fmt" compiler csg: frontier function index out of range frontier_index={frontierItemIndex} function_index={functionIndex} function_count={reachableSet.functionNames.len}"
            return false
        let sourcePath = parser.ParserNormalizePath(reachableSet.sourcePaths[functionIndex])
        let profileIndex = reachableSet.functionProfileIndexes[functionIndex]
        if profileIndex < 0 || profileIndex >= profiles.len:
            err = Fmt" compiler csg: frontier profile missing source={sourcePath} function_index={functionIndex} profile_index={profileIndex}"
            return false
        if !CompilerCsgSourcePathsEquivalent(profiles[profileIndex].sourcePath,
                                             sourcePath):
            err = Fmt" compiler csg: frontier profile/source conflict source={sourcePath} profile_source={profiles[profileIndex].sourcePath} function_index={functionIndex}"
            return false
        let functionRow = CompilerCsgSparseIntIndexEnsure(transaction.selectedFunctionIndex,
                                                           functionIndex)
        if functionRow != transaction.selectedFunctions.len:
            err = Fmt" compiler csg: frontier duplicate function index={functionIndex}"
            return false
        add(transaction.selectedFunctions, functionIndex)
        add(transaction.selectedFunctionNext, -1)
        let oldProfileCount = transaction.selectedProfileIndex.keys.len
        let profileRow = CompilerCsgSparseIntIndexEnsure(transaction.selectedProfileIndex,
                                                          profileIndex)
        if profileRow == oldProfileCount:
            if !CompilerCsgFrontierProfileRowValidate(frontierIndex,
                                                      profileIndex,
                                                      transaction.certificateValidationOperationCount,
                                                      err):
                return false
            add(transaction.selectedProfiles, profileIndex)
            add(transaction.selectedProfileHeads, functionIndex)
            add(transaction.selectedProfileTails, functionIndex)
        else:
            if profileRow < 0 || profileRow >= transaction.selectedProfileTails.len:
                err = " compiler csg: frontier profile staging columns corrupt"
                return false
            let previousTail = transaction.selectedProfileTails[profileRow]
            let previousTailRow = CompilerCsgSparseIntIndexFind(transaction.selectedFunctionIndex,
                                                                 previousTail)
            if previousTailRow < 0 || previousTailRow >= transaction.selectedFunctionNext.len ||
               transaction.selectedFunctionNext[previousTailRow] != -1:
                err = Fmt" compiler csg: frontier profile tail staging invalid profile={profileIndex} tail={previousTail}"
                return false
            transaction.selectedFunctionNext[previousTailRow] = functionIndex
            transaction.selectedProfileTails[profileRow] = functionIndex
    if transaction.selectedFunctionNext.len != transaction.selectedFunctions.len ||
       transaction.selectedProfileHeads.len != transaction.selectedProfiles.len ||
       transaction.selectedProfileTails.len != transaction.selectedProfiles.len:
        err = " compiler csg: frontier selection transaction columns mismatch"
        return false
    CompilerCsgFrontierTransactionRefreshLedger(transaction)
    err = ""
    return true

fn CompilerCsgFrontierTransactionSelectedNext(transaction: var CompilerCsgFrontierTransaction,
                                               functionIndex: int32): int32 =
    transaction.queryOperationCount = transaction.queryOperationCount + Int64(1)
    let row = CompilerCsgSparseIntIndexFind(transaction.selectedFunctionIndex,
                                            functionIndex)
    if row < 0 || row >= transaction.selectedFunctionNext.len:
        return -2
    return transaction.selectedFunctionNext[row]

@borrows
fn CompilerCsgFrontierTransactionCommitSelection(index: var CompilerCsgFrontierIndex,
                                                  profileCount: int32,
                                                  functionCount: int32,
                                                  transaction: CompilerCsgFrontierTransaction) =
    CompilerCsgFrontierIndexBegin(index, profileCount, functionCount)
    for profileRow in 0..<transaction.selectedProfiles.len:
        let profileIndex = transaction.selectedProfiles[profileRow]
        index.profileSelected[profileIndex] = true
        add(index.selectedProfiles, profileIndex)
        add(index.selectedProfileListCertificates,
            CompilerCsgFrontierSelectedProfileListCertificate(
                index.selectedProfiles.len - 1,
                profileIndex))
        index.profileFunctionHeads[profileIndex] = transaction.selectedProfileHeads[profileRow]
        index.profileFunctionTails[profileIndex] = transaction.selectedProfileTails[profileRow]
        index.profileRowCertificates[profileIndex] =
            CompilerCsgFrontierProfileRowCertificate(index, profileIndex)
    for functionRow in 0..<transaction.selectedFunctions.len:
        let functionIndex = transaction.selectedFunctions[functionRow]
        index.functionSelected[functionIndex] = true
        add(index.touchedFunctions, functionIndex)
        add(index.touchedFunctionListCertificates,
            CompilerCsgFrontierTouchedFunctionListCertificate(
                index.touchedFunctions.len - 1,
                functionIndex))
        index.functionNext[functionIndex] = transaction.selectedFunctionNext[functionRow]
        index.functionRowCertificates[functionIndex] =
            CompilerCsgFrontierFunctionRowCertificate(index, functionIndex)
    index.certificateBuildOperationCount =
        index.certificateBuildOperationCount +
            Int64(transaction.selectedProfiles.len + transaction.selectedFunctions.len) *
                Int64(2)
    index.certificateValidationOperationCount =
        index.certificateValidationOperationCount +
            transaction.certificateValidationOperationCount
    index.queryOperationCount = index.queryOperationCount +
                                transaction.queryOperationCount
    CompilerCsgFrontierIndexCommitDomainVersion(index)

fn CompilerCsgCompactProfileViewBuild(profiles: var parser.NormalizedExprCallProfile[],
                                      profileIndexLookup: var parser.ParserSourcePathIndexLookup,
                                      liveCache: var CompilerCsgProfileCallLookupStore,
                                      currentOriginalProfileIndex: int32,
                                      view: var CompilerCsgCompactProfileView,
                                      err: var str): bool =
    view = CompilerCsgCompactProfileView()
    if currentOriginalProfileIndex < 0 ||
       currentOriginalProfileIndex >= profiles.len:
        err = Fmt" compiler csg: compact profile root invalid profile={currentOriginalProfileIndex} profiles={profiles.len}"
        return false
    let rootRow = CompilerCsgSparseIntIndexEnsure(view.originalIndex,
                                                  currentOriginalProfileIndex)
    if rootRow != 0:
        err = " compiler csg: compact profile root insertion failed"
        return false
    add(view.originalIndexes, currentOriginalProfileIndex)
    var cursor: int32
    while cursor < view.originalIndexes.len:
        let originalIndex = view.originalIndexes[cursor]
        cursor = cursor + 1
        for edgeIndex in 0..<profiles[originalIndex].importEdges.len:
            let edge = profiles[originalIndex].importEdges[edgeIndex]
            var targetIndex = edge.targetProfileIndex
            if targetIndex < 0 || targetIndex >= profiles.len:
                targetIndex = parser.ParserProfileIndexLookupForSourcePath(profileIndexLookup,
                                                                            edge.targetSourcePath)
            if targetIndex < 0 || targetIndex >= profiles.len:
                if edge.resolved:
                    err = Fmt" compiler csg: compact profile resolved import target missing profile={originalIndex} edge={edgeIndex} target={edge.targetSourcePath}"
                    return false
                continue
            if CompilerCsgSparseIntIndexFind(view.originalIndex, targetIndex) < 0:
                let expectedRow = view.originalIndexes.len
                let targetRow = CompilerCsgSparseIntIndexEnsure(view.originalIndex,
                                                                 targetIndex)
                if targetRow != expectedRow:
                    err = " compiler csg: compact profile target insertion conflict"
                    return false
                add(view.originalIndexes, targetIndex)
    for compactIndex in 0..<view.originalIndexes.len:
        let originalIndex = view.originalIndexes[compactIndex]
        var profile: parser.NormalizedExprCallProfile
        profile.sourcePath = profiles[originalIndex].sourcePath
        profile.ownerModulePath = profiles[originalIndex].ownerModulePath
        profile.migrationSourceSyntax =
            profiles[originalIndex].migrationSourceSyntax
        profile.maxQualifiedCallDepth = profiles[originalIndex].maxQualifiedCallDepth
        for declIndex in 0..<profiles[originalIndex].decls.len:
            add(profile.decls, share(profiles[originalIndex].decls[declIndex]))
        for typeDeclIndex in 0..<profiles[originalIndex].typeDecls.len:
            add(profile.typeDecls, share(profiles[originalIndex].typeDecls[typeDeclIndex]))
        for callIndex in 0..<profiles[originalIndex].importcCallNames.len:
            add(profile.importcCallNames,
                share(profiles[originalIndex].importcCallNames[callIndex]))
        for callIndex in 0..<profiles[originalIndex].localCallNames.len:
            add(profile.localCallNames,
                share(profiles[originalIndex].localCallNames[callIndex]))
        for edgeIndex in 0..<profiles[originalIndex].importEdges.len:
            var edge = share(profiles[originalIndex].importEdges[edgeIndex])
            var targetIndex = edge.targetProfileIndex
            if targetIndex < 0 || targetIndex >= profiles.len:
                targetIndex = parser.ParserProfileIndexLookupForSourcePath(profileIndexLookup,
                                                                            edge.targetSourcePath)
            let compactTarget = CompilerCsgSparseIntIndexFind(view.originalIndex,
                                                               targetIndex)
            if compactTarget < 0 && edge.resolved:
                err = Fmt" compiler csg: compact profile import closure incomplete profile={originalIndex} edge={edgeIndex} target={targetIndex}"
                return false
            edge.targetProfileIndex = compactTarget
            add(profile.importEdges, edge)
        add(view.profiles, profile)
        var liveRow: int32
        var liveFound = false
        if !CompilerCsgProfileCallLookupStoreRow(liveCache,
                                                 originalIndex,
                                                 liveRow,
                                                 liveFound,
                                                 err):
            return false
        if liveFound:
            add(view.cache, share(liveCache.entries[liveRow]))
            add(view.cacheOwned, false)
        else:
            add(view.cache, parser.ParserProfileCallLookupCacheEntry())
            add(view.cacheOwned, true)
    view.profileIndexLookup = parser.ParserSourcePathIndexLookupBuild(view.profiles)
    err = ""
    return true

fn CompilerCsgCompactProfileCacheToOverlay(live: var CompilerCsgProfileCallLookupStore,
                                           view: var CompilerCsgCompactProfileView,
                                           overlay: var CompilerCsgProfileCallLookupOverlay,
                                           err: var str): bool =
    if view.cache.len != view.originalIndexes.len ||
       view.cacheOwned.len != view.originalIndexes.len:
        panic("compiler csg: compact profile cache columns corrupt")
    for compactIndex in 0..<view.cache.len:
        let originalProfileIndex = view.originalIndexes[compactIndex]
        let built = CompilerCsgProfileCallLookupEntryBuilt(view.cache[compactIndex])
        var liveRow: int32
        var liveBuilt = false
        if !CompilerCsgProfileCallLookupStoreRow(live,
                                                 originalProfileIndex,
                                                 liveRow,
                                                 liveBuilt,
                                                 err):
            return false
        if !built:
            continue
        if liveBuilt:
            view.cache[compactIndex] = parser.ParserProfileCallLookupCacheEntry()
            continue
        let row = CompilerCsgSparseIntIndexEnsure(overlay.index,
                                                  originalProfileIndex)
        if row != overlay.entries.len:
            panic("compiler csg: parser cache scratch profile duplicate")
        add(overlay.entries, share(view.cache[compactIndex]))
        view.cache[compactIndex] = parser.ParserProfileCallLookupCacheEntry()
        view.cacheOwned[compactIndex] = false
    err = ""
    return true

fn CompilerCsgCompactProfileOwnedContainerCapacityBytes(
        profile: var parser.NormalizedExprCallProfile): int64 =
    # Compact rows own their sequence backing and row headers. Every string
    # payload aliases immutable production-profile storage and is not recounted.
    return CompilerCsgNormalizedFunctionDeclSequenceBackingCapacityBytes(
               profile.decls) +
           CompilerCsgNormalizedTypeDeclSequenceBackingCapacityBytes(
               profile.typeDecls) +
           CompilerCsgBorrowedStringSequenceBackingCapacityBytes(
               profile.importcCallNames) +
           CompilerCsgBorrowedStringSequenceBackingCapacityBytes(
               profile.localCallNames) +
           CompilerCsgImportEdgeSequenceBackingCapacityBytes(profile.importEdges)

fn CompilerCsgCompactProfileViewCapacityBytes(view: var CompilerCsgCompactProfileView): int64 =
    var total = CompilerCsgSequenceHeaderBytes() * Int64(4) +
                Int64(view.profiles.cap) * CompilerCsgNormalizedExprCallProfileRowBytes() +
                Int64(view.originalIndexes.cap) * CompilerCsgI32Bytes() +
                Int64(view.cache.cap) * CompilerCsgProfileCallLookupEntryRowBytes() +
                CompilerCsgBoolArrayBytesMode(view.cacheOwned, true) +
                CompilerCsgSparseIntIndexCapacityBytes(view.originalIndex)
    for compactIndex in 0..<view.profiles.len:
        total = total +
                CompilerCsgCompactProfileOwnedContainerCapacityBytes(
                    view.profiles[compactIndex])
        if compactIndex < view.cacheOwned.len && view.cacheOwned[compactIndex] &&
           CompilerCsgProfileCallLookupEntryBuilt(view.cache[compactIndex]):
            total = total +
                CompilerCsgProfileCallLookupEntryCapacityBytes(view.cache[compactIndex])
    total = total + CompilerCsgSequenceHeaderBytes() * Int64(2) +
            Int64(view.profileIndexLookup.slots.cap) * CompilerCsgI32Bytes() +
            Int64(view.profileIndexLookup.buckets.cap) *
                CompilerCsgParserSourcePathIndexBucketRowBytes()
    for bucketIndex in 0..<view.profileIndexLookup.buckets.len:
        total = total +
            Int64(view.profileIndexLookup.buckets[bucketIndex].items.cap) *
                CompilerCsgParserSourcePathIndexEntryRowBytes()
        # Source-path strings are borrowed from the production profile table;
        # neither compact descriptors nor lookup entries own that payload.
    return total

fn CompilerCsgBuildActiveCompactProfileViewRelease(
        work: var CompilerCsgBuildWorkingSet) =
    if !work.activeCompactProfileViewOwned:
        if work.compactProfileViewLifecycle.activeOwnerCount != Int64(0):
            panic("compiler csg: compact profile inactive owner count mismatch")
        work.activeCompactProfileView = CompilerCsgCompactProfileView()
        work.activeCompactProfileCacheOverlay =
            CompilerCsgProfileCallLookupOverlay()
        return
    if work.compactProfileViewLifecycle.activeOwnerCount != Int64(1):
        panic("compiler csg: compact profile active owner count mismatch")
    work.activeCompactProfileView = CompilerCsgCompactProfileView()
    work.activeCompactProfileCacheOverlay =
        CompilerCsgProfileCallLookupOverlay()
    work.activeCompactProfileViewOwned = false
    work.compactProfileViewLifecycle.viewReleaseCount =
        work.compactProfileViewLifecycle.viewReleaseCount + Int64(1)
    work.compactProfileViewLifecycle.activeOwnerCount =
        work.compactProfileViewLifecycle.activeOwnerCount - Int64(1)

fn CompilerCsgBuildActiveCompactProfileViewBegin(
        work: var CompilerCsgBuildWorkingSet,
        originalProfileIndex: int32,
        err: var str): bool =
    if work.activeCompactProfileViewOwned ||
       work.compactProfileViewLifecycle.activeOwnerCount != Int64(0):
        err = " compiler csg: compact profile source owner already active"
        return false
    work.activeCompactProfileView = CompilerCsgCompactProfileView()
    work.activeCompactProfileCacheOverlay =
        CompilerCsgProfileCallLookupOverlay()
    work.compactProfileViewLifecycle.eligibleSourceCount =
        work.compactProfileViewLifecycle.eligibleSourceCount + Int64(1)
    if !CompilerCsgCompactProfileViewBuild(work.exprCallProfiles,
                                           work.profileIndexLookup,
                                           work.profileCallLookupCache,
                                           originalProfileIndex,
                                           work.activeCompactProfileView,
                                           err):
        work.activeCompactProfileView = CompilerCsgCompactProfileView()
        return false
    if work.activeCompactProfileView.profiles.len <= 0 ||
       work.activeCompactProfileView.originalIndexes.len <= 0 ||
       work.activeCompactProfileView.originalIndexes[0] != originalProfileIndex:
        work.activeCompactProfileView = CompilerCsgCompactProfileView()
        err = " compiler csg: compact profile source root ownership mismatch"
        return false
    work.activeCompactProfileViewOwned = true
    work.compactProfileViewLifecycle.viewBuildCount =
        work.compactProfileViewLifecycle.viewBuildCount + Int64(1)
    work.compactProfileViewLifecycle.activeOwnerCount = Int64(1)
    if work.compactProfileViewLifecycle.activeOwnerCount >
       work.compactProfileViewLifecycle.activeOwnerPeakCount:
        work.compactProfileViewLifecycle.activeOwnerPeakCount =
            work.compactProfileViewLifecycle.activeOwnerCount
    err = ""
    return true

fn CompilerCsgBuildActiveCompactProfileViewClose(
        work: var CompilerCsgBuildWorkingSet,
        err: var str): bool =
    if !work.activeCompactProfileViewOwned ||
       work.compactProfileViewLifecycle.activeOwnerCount != Int64(1):
        err = " compiler csg: compact profile source close has no owner"
        return false
    if !CompilerCsgCompactProfileCacheToOverlay(
            work.profileCallLookupCache,
            work.activeCompactProfileView,
            work.activeCompactProfileCacheOverlay,
            err):
        return false
    if !CompilerCsgProfileCallLookupOverlayValidate(
            work.exprCallProfiles,
            work.activeCompactProfileCacheOverlay,
            err):
        return false
    work.compactProfileViewLifecycle.cacheOverlayValidateCount =
        work.compactProfileViewLifecycle.cacheOverlayValidateCount + Int64(1)
    work.compactProfileViewLifecycle.cacheOverlayOwnedMoveCount =
        work.compactProfileViewLifecycle.cacheOverlayOwnedMoveCount +
            Int64(work.activeCompactProfileCacheOverlay.entries.len)
    CompilerCsgProfileCallLookupOverlayCommitValidated(
        work.profileCallLookupCache,
        work.activeCompactProfileCacheOverlay)
    work.compactProfileViewLifecycle.cacheOverlayCommitCount =
        work.compactProfileViewLifecycle.cacheOverlayCommitCount + Int64(1)
    CompilerCsgBuildActiveCompactProfileViewRelease(work)
    err = ""
    return true

fn CompilerCsgCompactProfileViewLifecycleValidate(
        lifecycle: CompilerCsgCompactProfileViewLifecycle,
        err: var str): bool =
    if lifecycle.viewBuildCount != lifecycle.eligibleSourceCount:
        err = Fmt" compiler csg: compact profile source/build mismatch eligible={lifecycle.eligibleSourceCount} builds={lifecycle.viewBuildCount}"
        return false
    if lifecycle.functionLevelViewRebuildCount != Int64(0):
        err = Fmt" compiler csg: compact profile function-level rebuild detected count={lifecycle.functionLevelViewRebuildCount}"
        return false
    if lifecycle.viewReleaseCount != lifecycle.viewBuildCount ||
       lifecycle.activeOwnerCount != Int64(0):
        err = Fmt" compiler csg: compact profile owner lifecycle incomplete builds={lifecycle.viewBuildCount} releases={lifecycle.viewReleaseCount} active={lifecycle.activeOwnerCount}"
        return false
    if lifecycle.viewBuildCount > Int64(0) &&
       lifecycle.activeOwnerPeakCount != Int64(1):
        err = Fmt" compiler csg: compact profile borrow lifecycle invalid builds={lifecycle.viewBuildCount} peak={lifecycle.activeOwnerPeakCount} borrows={lifecycle.rangeBorrowCount}"
        return false
    if lifecycle.cacheOverlayValidateCount != lifecycle.viewBuildCount ||
       lifecycle.cacheOverlayCommitCount != lifecycle.viewBuildCount:
        err = Fmt" compiler csg: compact profile cache transaction incomplete builds={lifecycle.viewBuildCount} validates={lifecycle.cacheOverlayValidateCount} commits={lifecycle.cacheOverlayCommitCount}"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgFunctionSpanBefore(reachableSet: CompilerCsgReachableFunctionSet,
                                 lhs: int32,
                                 rhs: int32): bool =
    if reachableSet.startLines[lhs] != reachableSet.startLines[rhs]:
        return reachableSet.startLines[lhs] < reachableSet.startLines[rhs]
    if reachableSet.endLines[lhs] != reachableSet.endLines[rhs]:
        return reachableSet.endLines[lhs] < reachableSet.endLines[rhs]
    return lhs < rhs

@borrows
fn CompilerCsgFrontierSliceFunctionBefore(
        reachableSet: CompilerCsgReachableFunctionSet,
        lhs: int32,
        rhs: int32): bool =
    let lhsProfileIndex = reachableSet.functionProfileIndexes[lhs]
    let rhsProfileIndex = reachableSet.functionProfileIndexes[rhs]
    if lhsProfileIndex != rhsProfileIndex:
        return lhsProfileIndex < rhsProfileIndex
    return CompilerCsgFunctionSpanBefore(reachableSet, lhs, rhs)

@borrows
fn CompilerCsgMergeFrontierSliceFunctionPassRec(
        source: int32[],
        destination: var int32[],
        width: int32,
        reachableSet: CompilerCsgReachableFunctionSet,
        leftStart: int32) =
    while true:
        if leftStart >= source.len:
            return
        var mid = leftStart + width
        if mid > source.len:
            mid = source.len
        var rightEnd = leftStart + width * 2
        if rightEnd > source.len:
            rightEnd = source.len
        var left = leftStart
        var right = mid
        for outputIndex in leftStart..<rightEnd:
            if left < mid &&
               (right >= rightEnd ||
                CompilerCsgFrontierSliceFunctionBefore(reachableSet,
                                                       source[left],
                                                       source[right])):
                destination[outputIndex] = source[left]
                left = left + 1
            else:
                destination[outputIndex] = source[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

@borrows
fn CompilerCsgMergeFrontierSliceFunctionPass(
        source: int32[],
        destination: var int32[],
        width: int32,
        reachableSet: CompilerCsgReachableFunctionSet) =
    CompilerCsgMergeFrontierSliceFunctionPassRec(
        source, destination, width, reachableSet, 0)

fn CompilerCsgSortFrontierSliceFunctions(
        items: var int32[],
        reachableSet: var CompilerCsgReachableFunctionSet,
        scratchBytes: var int64,
        err: var str): bool =
    scratchBytes = Int64(0)
    for rowIndex in 0..<items.len:
        let functionIndex = items[rowIndex]
        if functionIndex < 0 ||
           functionIndex >= reachableSet.functionProfileIndexes.len ||
           functionIndex >= reachableSet.startLines.len ||
           functionIndex >= reachableSet.endLines.len:
            err = Fmt" compiler csg: frontier slice sort function row missing function_index={functionIndex}"
            return false
        let profileIndex = reachableSet.functionProfileIndexes[functionIndex]
        if profileIndex < 0 ||
           reachableSet.startLines[functionIndex] <= 0 ||
           reachableSet.endLines[functionIndex] <
               reachableSet.startLines[functionIndex]:
            err = Fmt" compiler csg: frontier slice sort key invalid function_index={functionIndex} profile_index={profileIndex}"
            return false
    if items.len > 1:
        var scratch: int32[]
        setLen(scratch, items.len)
        var width: int32 = 1
        var readScratch = false
        while width < items.len:
            if readScratch:
                CompilerCsgMergeFrontierSliceFunctionPass(scratch,
                                                          items,
                                                          width,
                                                          reachableSet)
            else:
                CompilerCsgMergeFrontierSliceFunctionPass(items,
                                                          scratch,
                                                          width,
                                                          reachableSet)
            readScratch = !readScratch
            if width > items.len / 2:
                width = items.len
            else:
                width = width * 2
        if readScratch:
            for itemIndex in 0..<items.len:
                items[itemIndex] = scratch[itemIndex]
        scratchBytes = Int64(scratch.cap) * CompilerCsgI32Bytes()
    for rowIndex in 1..<items.len:
        if CompilerCsgFrontierSliceFunctionBefore(reachableSet,
                                                  items[rowIndex],
                                                  items[rowIndex - 1]):
            err = " compiler csg: frontier slice canonical order failed"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgMergeFunctionSpanPassRec(
        source: int32[],
        destination: var int32[],
        width: int32,
        reachableSet: CompilerCsgReachableFunctionSet,
        leftStart: int32) =
    while true:
        if leftStart >= source.len:
            return
        var mid = leftStart + width
        if mid > source.len:
            mid = source.len
        var rightEnd = leftStart + width * 2
        if rightEnd > source.len:
            rightEnd = source.len
        var left = leftStart
        var right = mid
        for outputIndex in leftStart..<rightEnd:
            if left < mid &&
               (right >= rightEnd ||
                CompilerCsgFunctionSpanBefore(reachableSet,
                                              source[left],
                                              source[right])):
                destination[outputIndex] = source[left]
                left = left + 1
            else:
                destination[outputIndex] = source[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

@borrows
fn CompilerCsgMergeFunctionSpanPass(source: int32[],
                                     destination: var int32[],
                                     width: int32,
                                     reachableSet: CompilerCsgReachableFunctionSet) =
    CompilerCsgMergeFunctionSpanPassRec(
        source, destination, width, reachableSet, 0)

fn CompilerCsgSortedProfileFunctionIndexes(
        transaction: var CompilerCsgFrontierTransaction,
        reachableSet: var CompilerCsgReachableFunctionSet,
        profileIndex: int32,
        profileHead: int32,
        scratchBytes: var int64,
        err: var str): int32[] =
    scratchBytes = Int64(0)
    var out: int32[]
    var functionIndex = profileHead
    var chainVisitCount: int32
    while functionIndex >= 0:
        if functionIndex >= reachableSet.functionProfileIndexes.len ||
           reachableSet.functionProfileIndexes[functionIndex] != profileIndex:
            err = Fmt" compiler csg: selected profile function ownership mismatch profile={profileIndex} function={functionIndex}"
            return []
        add(out, functionIndex)
        chainVisitCount = chainVisitCount + 1
        if chainVisitCount > transaction.selectedFunctions.len:
            err = Fmt" compiler csg: selected profile function chain cycles profile={profileIndex}"
            return []
        functionIndex = CompilerCsgFrontierTransactionSelectedNext(transaction,
                                                                    functionIndex)
        if functionIndex == -2:
            err = Fmt" compiler csg: frontier selected adjacency missing profile={profileIndex}"
            return []
    if out.len <= 1:
        err = ""
        return out
    var scratch: int32[]
    setLen(scratch, out.len)
    var width: int32 = 1
    var readScratch = false
    while width < out.len:
        if readScratch:
            CompilerCsgMergeFunctionSpanPass(scratch, out, width, reachableSet)
        else:
            CompilerCsgMergeFunctionSpanPass(out, scratch, width, reachableSet)
        readScratch = !readScratch
        if width > out.len / 2:
            width = out.len
        else:
            width = width * 2
    if readScratch:
        for itemIndex in 0..<out.len:
            out[itemIndex] = scratch[itemIndex]
    scratchBytes = Int64(scratch.cap) * CompilerCsgI32Bytes()
    err = ""
    return out

fn CompilerCsgStructuredSourceDomainInit(
        facts: var parser.ParserStructuredSourceFacts,
        domain: var CompilerCsgStructuredSourceDomain) =
    domain = CompilerCsgStructuredSourceDomain()
    domain.sourcePath = facts.sourcePath
    setLen(domain.denseScopes, facts.scopes.len)
    setLen(domain.denseStatements, facts.seeds.len)
    setLen(domain.scopeChildCounts, facts.scopes.len)
    setLen(domain.statementLexicalCounts, facts.scopes.len)
    setLen(domain.seenStatements, facts.seeds.len)
    for scopeIndex in 0..<domain.denseScopes.len:
        domain.denseScopes[scopeIndex] = -1
    for statementIndex in 0..<domain.denseStatements.len:
        domain.denseStatements[statementIndex] = -1
    domain.lastSourceScopeId = -1
    domain.lastSourceStatementOrdinal = -1
    domain.targetScopeStart = -1
    domain.targetExprStart = -1
    domain.factsPayloadBytes = Int64(facts.sourcePath.len)
    for seedIndex in 0..<facts.seeds.len:
        domain.factsPayloadBytes = domain.factsPayloadBytes +
                                   Int64(facts.seeds[seedIndex].surfaceText.len)

fn CompilerCsgStructuredSourceDomainReset(
        domain: var CompilerCsgStructuredSourceDomain) =
    domain.sourcePath = ""
    domain = CompilerCsgStructuredSourceDomain()

fn CompilerCsgStructuredSourceDomainStageSlice(
        facts: var parser.ParserStructuredSourceFacts,
        slice: var parser.ParserStructuredSourceSlice,
        functionLayer: var parser.NormalizedExprLayer,
        lineStart: int32,
        lineEnd: int32,
        domain: var CompilerCsgStructuredSourceDomain,
        target: var parser.NormalizedExprLayer,
        err: var str): bool =
    return CompilerCsgStructuredSourceDomainStageSliceWithBorrow(
        facts,
        slice,
        functionLayer,
        lineStart,
        lineEnd,
        domain,
        false,
        target,
        err)

fn CompilerCsgStructuredSourceDomainStageSliceWithBorrow(
        facts: var parser.ParserStructuredSourceFacts,
        slice: var parser.ParserStructuredSourceSlice,
        functionLayer: var parser.NormalizedExprLayer,
        lineStart: int32,
        lineEnd: int32,
        domain: var CompilerCsgStructuredSourceDomain,
        borrowSourceForest: bool,
        target: var parser.NormalizedExprLayer,
        err: var str): bool =
    if !facts.built || !slice.built || facts.sourcePath != slice.sourcePath ||
       lineStart != slice.lineStartNumber || lineEnd != slice.lineEndNumber:
        err = " compiler csg: structured source slice identity mismatch"
        return false
    if domain.sourcePath != facts.sourcePath || domain.finalized:
        err = " compiler csg: structured source domain identity mismatch"
        return false
    if lineStart <= domain.previousFunctionEndLine:
        err = " compiler csg: structured source function ranges overlap"
        return false
    if functionLayer.sourceCount != 1 ||
       functionLayer.scopes.len != slice.sourceScopeIds.len ||
       slice.scopes.len != slice.sourceScopeIds.len ||
       slice.seeds.len != slice.sourceStatementOrdinals.len:
        err = " compiler csg: structured source slice columns mismatch"
        return false
    for localScopeId in 0..<slice.sourceScopeIds.len:
        let sourceScopeId = slice.sourceScopeIds[localScopeId]
        let functionScope = functionLayer.scopes[localScopeId]
        let sliceScope = slice.scopes[localScopeId]
        if sourceScopeId < 0 || sourceScopeId >= facts.scopes.len ||
           facts.scopes[sourceScopeId].scopeId != sourceScopeId ||
           facts.scopes[sourceScopeId].sourceScopeId != sourceScopeId ||
           functionScope.sourcePath != sliceScope.sourcePath ||
           functionScope.scopeId != sliceScope.scopeId ||
           functionScope.sourceScopeId != sourceScopeId ||
           functionScope.parentScopeId != sliceScope.parentScopeId ||
           functionScope.kind != sliceScope.kind ||
           functionScope.ownerStatementOrdinal !=
               sliceScope.ownerStatementOrdinal ||
           functionScope.ownerDeclarationRow !=
               sliceScope.ownerDeclarationRow ||
           functionScope.lexicalOrdinal != sliceScope.lexicalOrdinal ||
           functionScope.indentColumn != sliceScope.indentColumn ||
           functionScope.startLineNumber != sliceScope.startLineNumber ||
           functionScope.startColumnNumber != sliceScope.startColumnNumber ||
           functionScope.endLineNumber != sliceScope.endLineNumber ||
           functionScope.endColumnNumber != sliceScope.endColumnNumber:
            err = " compiler csg: structured source scope identity mismatch"
            return false
        if sliceScope.parentScopeId < -1 ||
           sliceScope.parentScopeId >= slice.sourceScopeIds.len ||
           sliceScope.ownerStatementOrdinal < -1 ||
           sliceScope.ownerStatementOrdinal >=
               slice.sourceStatementOrdinals.len:
            err = " compiler csg: structured source scope provenance out of range"
            return false
        var sourceParentScopeId: int32 = -1
        if sliceScope.parentScopeId >= 0:
            sourceParentScopeId =
                slice.sourceScopeIds[sliceScope.parentScopeId]
        var sourceOwnerStatementOrdinal: int32 = -1
        if sliceScope.ownerStatementOrdinal >= 0:
            sourceOwnerStatementOrdinal =
                slice.sourceStatementOrdinals[
                    sliceScope.ownerStatementOrdinal]
        if sourceParentScopeId != facts.scopes[sourceScopeId].parentScopeId ||
           sourceOwnerStatementOrdinal !=
               facts.scopes[sourceScopeId].ownerStatementOrdinal ||
           sliceScope.ownerDeclarationRow !=
               facts.scopes[sourceScopeId].ownerDeclarationRow:
            err = " compiler csg: structured source scope provenance mismatch"
            return false
    var nextSourceScopeId = domain.lastSourceScopeId
    for localScopeId in 0..<slice.sourceScopeIds.len:
        let sourceScopeId = slice.sourceScopeIds[localScopeId]
        if domain.denseScopes[sourceScopeId] < 0:
            if sourceScopeId <= nextSourceScopeId:
                err = " compiler csg: structured source scopes out of source order"
                return false
            nextSourceScopeId = sourceScopeId
        elif domain.denseScopes[sourceScopeId] >= domain.denseScopeCount:
            err = " compiler csg: structured source scope remap invalid"
            return false
    var nextSourceStatementOrdinal = domain.lastSourceStatementOrdinal
    for localStatementOrdinal in 0..<slice.sourceStatementOrdinals.len:
        let sourceStatementOrdinal =
            slice.sourceStatementOrdinals[localStatementOrdinal]
        if sourceStatementOrdinal < 0 ||
           sourceStatementOrdinal >= facts.seeds.len ||
           facts.seeds[sourceStatementOrdinal].statementOrdinal !=
               sourceStatementOrdinal:
            err = " compiler csg: structured source statement identity mismatch"
            return false
        if domain.denseStatements[sourceStatementOrdinal] >= 0:
            err = " compiler csg: structured source statement selected twice"
            return false
        if sourceStatementOrdinal <= nextSourceStatementOrdinal:
            err = " compiler csg: structured source statements out of source order"
            return false
        nextSourceStatementOrdinal = sourceStatementOrdinal
    var previousLine = domain.previousFunctionEndLine
    var localStructuredStatementCount: int32
    for exprIndex in 0..<functionLayer.exprs.len:
        let expr = functionLayer.exprs[exprIndex]
        if expr.sourcePath != facts.sourcePath ||
           expr.lineNumber < lineStart || expr.lineNumber > lineEnd ||
           expr.lineNumber < previousLine:
            err = " compiler csg: structured source expression order mismatch"
            return false
        if expr.lexicalScopeId < 0 ||
           expr.lexicalScopeId >= slice.sourceScopeIds.len ||
           expr.suiteScopeId < -1 ||
           expr.suiteScopeId >= slice.sourceScopeIds.len ||
           expr.statementOrdinal < -1 ||
           expr.statementOrdinal >= slice.sourceStatementOrdinals.len ||
           expr.deferOwnerStatementOrdinal < -1 ||
           expr.deferOwnerStatementOrdinal >=
               slice.sourceStatementOrdinals.len:
            err = " compiler csg: structured source expression identity out of range"
            return false
        if expr.valueExprCallNodeIndex >= 0:
            if functionLayer.valueExprTree == nil ||
               expr.valueExprCallNodeIndex >=
                   functionLayer.valueExprTree.nodeCount ||
               expr.originParserNodeId < 0 ||
               expr.originParserNodeId >=
                   functionLayer.valueExprTree.nodeCount ||
               expr.originParserNodeId !=
                   parser.ParserValueExprNodeSourceLocalIndexAt(
                       functionLayer.valueExprTree,
                       expr.valueExprCallNodeIndex):
                err = " compiler csg: structured source call origin out of range"
                return false
            let originKind = parser.ParserValueExprNodeKindAt(
                functionLayer.valueExprTree, expr.originParserNodeId)
            if originKind != parser.ParserValueExprCall &&
               originKind != parser.ParserValueExprSpaceCall:
                err = " compiler csg: structured source origin is not a parser call"
                return false
        elif expr.originParserNodeId >= 0:
            # No structural call on this row.  Sidecar structured rows and
            # stamped fmt rows carry their parser node identity (statement
            # root / fmt literal) here instead of a call origin; downstream
            # fallback consumers read this field as a plain in-tree node
            # index, so node-index validity is the contract.  Call rows keep
            # the exact call-identity proof above unchanged.
            if functionLayer.valueExprTree == nil ||
               expr.originParserNodeId >=
                   functionLayer.valueExprTree.nodeCount:
                err = " compiler csg: structured source origin out of range"
                return false
        if expr.kind == parser.NormalizedExprReturn &&
           (expr.valueExprRootNodeIndex < 0 ||
            expr.valueExprStatementRole ==
                parser.ParserValueExprStatementInvalid):
            err = Fmt" compiler csg: structured source return parser root missing source={expr.sourcePath} line={expr.lineNumber}"
            return false
        if parser.ParserNormalizedExprKindIsSidecarStructured(expr.kind):
            if expr.statementOrdinal != localStructuredStatementCount:
                err = " compiler csg: structured source header order mismatch"
                return false
            localStructuredStatementCount = localStructuredStatementCount + 1
        elif expr.statementOrdinal >= 0 || expr.suiteScopeId >= 0:
            err = " compiler csg: ordinary expression owns structured identity"
            return false
        if parser.NormalizedExprLayerContainsExpr(target, expr):
            err = " compiler csg: structured source expression duplicated"
            return false
        previousLine = expr.lineNumber
    if localStructuredStatementCount != slice.sourceStatementOrdinals.len:
        err = " compiler csg: structured source headers incomplete"
        return false
    if domain.started:
        if domain.targetScopeStart < 0 || domain.targetExprStart < 0 ||
           target.scopes.len != domain.targetScopeStart + domain.denseScopeCount ||
           target.exprs.len != domain.targetExprStart + domain.appendedExprCount:
            err = " compiler csg: structured source target changed during aggregation"
            return false
    else:
        if (target.scopes.len > 0 &&
            target.scopes[target.scopes.len - 1].sourcePath == facts.sourcePath) ||
           (target.exprs.len > 0 &&
            target.exprs[target.exprs.len - 1].sourcePath == facts.sourcePath):
            err = " compiler csg: structured source target already contains source"
            return false
        domain.targetScopeStart = target.scopes.len
        domain.targetExprStart = target.exprs.len
        if functionLayer.valueExprTree == nil ||
           !functionLayer.valueExprTreeBorrowLease ||
           functionLayer.valueExprTree.producerSourceCount != 1 ||
           (target.valueExprTree != nil &&
            target.valueExprTree.producerSourceCount != target.sourceCount):
            err = " compiler csg: structured source parser forest identity mismatch"
            return false
        if borrowSourceForest && target.valueExprTree == nil:
            # Single-profile frontier round: the per-function layer already
            # borrows the exact full-source parser forest. Borrow it once
            # into the round target instead of deep-copying the whole tree
            # through ParserValueExprTreeAppendFrom. Offsets stay zero
            # because the borrowed forest is already the whole source.
            target.valueExprTree = parser.ParserValueExprTreeBorrow(
                functionLayer.valueExprTree)
            target.valueExprTreeBorrowLease = true
            domain.parserNodeOffset = 0
            domain.parserRootOffset = 0
            domain.parserDeclarationOffset = 0
        else:
            if target.valueExprTree != nil:
                domain.parserNodeOffset = target.valueExprTree.nodeCount
                domain.parserRootOffset = target.valueExprTree.rootCount
                domain.parserDeclarationOffset =
                    target.valueExprTree.declarationCount
            parser.ParserValueExprTreeAppendFrom(
                target.valueExprTree, functionLayer.valueExprTree)
            parser.ParserValueExprTreeRequireSingleProductionCommitCopy(
                target.valueExprTree)
        if target.valueExprTree == nil ||
           target.valueExprTree.producerSourceCount != target.sourceCount + 1:
            panic("compiler csg: validated parser forest append disappeared")
        domain.parserTreeCommitted = true
        domain.started = true
    for localStatementOrdinal in 0..<slice.sourceStatementOrdinals.len:
        let sourceStatementOrdinal =
            slice.sourceStatementOrdinals[localStatementOrdinal]
        domain.denseStatements[sourceStatementOrdinal] =
            domain.denseStatementCount
        domain.denseStatementCount = domain.denseStatementCount + 1
        domain.lastSourceStatementOrdinal = sourceStatementOrdinal
    for localScopeId in 0..<slice.sourceScopeIds.len:
        let sourceScopeId = slice.sourceScopeIds[localScopeId]
        if domain.denseScopes[sourceScopeId] >= 0:
            continue
        var scope = parser.NormalizedScopeFactClone(facts.scopes[sourceScopeId])
        let denseScopeId = domain.denseScopeCount
        scope.scopeId = denseScopeId
        if scope.parentScopeId >= 0:
            if scope.parentScopeId >= domain.denseScopes.len ||
               domain.denseScopes[scope.parentScopeId] < 0:
                panic("compiler csg: validated structured scope parent disappeared")
            scope.parentScopeId = domain.denseScopes[scope.parentScopeId]
            scope.lexicalOrdinal = domain.scopeChildCounts[scope.parentScopeId]
            domain.scopeChildCounts[scope.parentScopeId] =
                scope.lexicalOrdinal + 1
        else:
            if denseScopeId != 0:
                panic("compiler csg: validated structured root is not dense zero")
            scope.lexicalOrdinal = 0
        if scope.ownerStatementOrdinal >= 0:
            if scope.ownerStatementOrdinal >= domain.denseStatements.len ||
               domain.denseStatements[scope.ownerStatementOrdinal] < 0:
                panic("compiler csg: validated structured scope owner disappeared")
            scope.ownerStatementOrdinal =
                domain.denseStatements[scope.ownerStatementOrdinal]
        if scope.ownerDeclarationRow >= 0:
            scope.ownerDeclarationRow =
                scope.ownerDeclarationRow +
                domain.parserDeclarationOffset
        domain.denseScopes[sourceScopeId] = denseScopeId
        domain.denseScopeCount = domain.denseScopeCount + 1
        domain.lastSourceScopeId = sourceScopeId
        add(target.scopes, scope)
    for exprIndex in 0..<functionLayer.exprs.len:
        var expr: NormalizedExpr
        parser.NormalizedExprCloneInto(functionLayer.exprs[exprIndex], expr)
        if expr.valueExprCallNodeIndex >= 0:
            expr.valueExprCallNodeIndex = expr.valueExprCallNodeIndex +
                                          domain.parserNodeOffset
        if expr.valueExprRootNodeIndex >= 0:
            expr.valueExprRootNodeIndex = expr.valueExprRootNodeIndex +
                                          domain.parserNodeOffset
        if expr.callArgValueRootStart >= 0:
            expr.callArgValueRootStart = expr.callArgValueRootStart +
                                         domain.parserRootOffset
        let sourceLexicalScopeId =
            slice.sourceScopeIds[expr.lexicalScopeId]
        if domain.denseScopes[sourceLexicalScopeId] < 0:
            panic("compiler csg: validated structured expression mapping disappeared")
        expr.lexicalScopeId = domain.denseScopes[sourceLexicalScopeId]
        if expr.suiteScopeId >= 0:
            let sourceSuiteScopeId =
                slice.sourceScopeIds[expr.suiteScopeId]
            if domain.denseScopes[sourceSuiteScopeId] < 0:
                panic("compiler csg: validated structured suite mapping disappeared")
            expr.suiteScopeId = domain.denseScopes[sourceSuiteScopeId]
        if expr.statementOrdinal >= 0:
            let sourceStatementOrdinal =
                slice.sourceStatementOrdinals[expr.statementOrdinal]
            if domain.denseStatements[sourceStatementOrdinal] < 0 ||
               domain.seenStatements[sourceStatementOrdinal]:
                panic("compiler csg: validated structured statement mapping disappeared")
            expr.statementOrdinal =
                domain.denseStatements[sourceStatementOrdinal]
            domain.seenStatements[sourceStatementOrdinal] = true
            expr.lexicalOrdinal =
                domain.statementLexicalCounts[expr.lexicalScopeId]
            domain.statementLexicalCounts[expr.lexicalScopeId] =
                expr.lexicalOrdinal + 1
        if expr.deferOwnerStatementOrdinal >= 0:
            let sourceDeferOwnerStatementOrdinal =
                slice.sourceStatementOrdinals[
                    expr.deferOwnerStatementOrdinal]
            if domain.denseStatements[sourceDeferOwnerStatementOrdinal] < 0:
                panic("compiler csg: validated structured defer owner disappeared")
            expr.deferOwnerStatementOrdinal =
                domain.denseStatements[sourceDeferOwnerStatementOrdinal]
        let exprCountBefore = target.exprs.len
        parser.NormalizedExprLayerAppendExisting(target, expr)
        if target.exprs.len != exprCountBefore + 1:
            panic("compiler csg: validated structured expression append failed")
        domain.appendedExprCount = domain.appendedExprCount + 1
    target.questionResidualCount = target.questionResidualCount +
                                   functionLayer.questionResidualCount
    domain.previousFunctionEndLine = lineEnd
    err = ""
    return true

fn CompilerCsgFunctionSourceSliceParentIds(
        domain: var CompilerCsgStructuredSourceDomain,
        target: var parser.NormalizedExprLayer,
        scopeStart: int32,
        scopeCount: int32,
        parentSourceScopeIds: var int32[],
        err: var str): bool =
    parentSourceScopeIds = []
    if scopeStart < 1 || scopeCount < 0 || domain.targetScopeStart < 0 ||
       scopeStart > domain.denseScopeCount ||
       scopeCount > domain.denseScopeCount - scopeStart:
        err = " compiler csg: function source slice scope range invalid"
        return false
    reserve(parentSourceScopeIds, scopeCount)
    for scopeOffset in 0..<scopeCount:
        let sourceScopeId = scopeStart + scopeOffset
        if domain.targetScopeStart > target.scopes.len ||
           sourceScopeId >= target.scopes.len - domain.targetScopeStart:
            err = " compiler csg: function source slice scope target missing"
            return false
        let targetScopeIndex = domain.targetScopeStart + sourceScopeId
        let scope = target.scopes[targetScopeIndex]
        if scope.scopeId != sourceScopeId || scope.parentScopeId < 0:
            err = " compiler csg: function source slice scope identity invalid"
            return false
        if scope.parentScopeId != 0 &&
           (scope.parentScopeId < scopeStart ||
            scope.parentScopeId >= sourceScopeId):
            err = " compiler csg: function source slice parent escapes function"
            return false
        add(parentSourceScopeIds, scope.parentScopeId)
    err = ""
    return true

fn CompilerCsgFunctionSourceSliceCommit(
        index: var fslice.FunctionSourceSliceIndex,
        sourceIndex: int32,
        functionIndex: int32,
        exprStart: int32,
        scopeCountBefore: int32,
        statementStart: int32,
        domain: var CompilerCsgStructuredSourceDomain,
        target: var parser.NormalizedExprLayer,
        err: var str): bool =
    if exprStart < 0 || scopeCountBefore < 0 || statementStart < 0 ||
       domain.appendedExprCount < exprStart ||
       domain.denseScopeCount < scopeCountBefore ||
       domain.denseStatementCount < statementStart:
        err = " compiler csg: function source slice commit counters regressed"
        return false
    var scopeStart = scopeCountBefore
    if scopeCountBefore == 0:
        if domain.denseScopeCount <= 0 || domain.targetScopeStart < 0 ||
           domain.targetScopeStart >= target.scopes.len ||
           target.scopes[domain.targetScopeStart].scopeId != 0 ||
           target.scopes[domain.targetScopeStart].parentScopeId != -1:
            err = " compiler csg: function source slice implicit root missing"
            return false
        scopeStart = 1
    var row: fslice.FunctionSourceSliceRow
    row.sourceIndex = sourceIndex
    row.functionIndex = functionIndex
    row.exprStart = exprStart
    row.exprCount = domain.appendedExprCount - exprStart
    row.scopeStart = scopeStart
    row.scopeCount = domain.denseScopeCount - scopeStart
    row.statementStart = statementStart
    row.statementCount = domain.denseStatementCount - statementStart
    var parentSourceScopeIds: int32[]
    if !CompilerCsgFunctionSourceSliceParentIds(domain,
                                                target,
                                                row.scopeStart,
                                                row.scopeCount,
                                                parentSourceScopeIds,
                                                err):
        return false
    fslice.FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index, row, parentSourceScopeIds)
    err = ""
    return true

fn CompilerCsgStructuredSourceDomainFinalize(
        facts: var parser.ParserStructuredSourceFacts,
        domain: var CompilerCsgStructuredSourceDomain,
        target: var parser.NormalizedExprLayer,
        err: var str): bool =
    if !facts.built || facts.sourcePath != domain.sourcePath ||
       facts.scopes.len <= 0 || !domain.started || domain.finalized ||
       !domain.parserTreeCommitted ||
       domain.denseScopes.len != facts.scopes.len ||
       domain.denseStatements.len != facts.seeds.len ||
       domain.denseScopes[0] != 0 || domain.denseScopeCount <= 0:
        err = " compiler csg: structured source selected domain is incomplete"
        return false
    if target.scopes.len != domain.targetScopeStart + domain.denseScopeCount ||
       target.exprs.len != domain.targetExprStart + domain.appendedExprCount:
        err = " compiler csg: structured source target size mismatch"
        return false
    if target.valueExprTree == nil ||
       target.valueExprTree.producerSourceCount != target.sourceCount + 1:
        err = " compiler csg: structured source parser forest coverage mismatch"
        return false
    let rootScope = target.scopes[domain.targetScopeStart]
    if rootScope.sourcePath != facts.sourcePath || rootScope.scopeId != 0 ||
       rootScope.sourceScopeId != 0 || rootScope.parentScopeId != -1:
        err = " compiler csg: structured source target root mismatch"
        return false
    var observedDenseStatementCount: int32
    for sourceStatementOrdinal in 0..<domain.denseStatements.len:
        let denseStatementOrdinal =
            domain.denseStatements[sourceStatementOrdinal]
        if denseStatementOrdinal < 0:
            if domain.seenStatements[sourceStatementOrdinal]:
                err = " compiler csg: unselected structured statement observed"
                return false
            continue
        if denseStatementOrdinal != observedDenseStatementCount ||
           !domain.seenStatements[sourceStatementOrdinal]:
            err = " compiler csg: structured source statement remap incomplete"
            return false
        observedDenseStatementCount = observedDenseStatementCount + 1
    if observedDenseStatementCount != domain.denseStatementCount:
        err = " compiler csg: structured source statement count mismatch"
        return false
    target.sourceCount = target.sourceCount + 1
    domain.finalized = true
    err = ""
    return true

fn CompilerCsgStructuredSourceScratchRelease(
        facts: var parser.ParserStructuredSourceFacts,
        slice: var parser.ParserStructuredSourceSlice,
        domain: var CompilerCsgStructuredSourceDomain,
        report: var CompilerCsgStructuredSidecarReport) =
    let sourceWasBuilt = facts.built
    if report.activeSliceCount < Int64(0) ||
       report.activeSliceCount > Int64(1):
        panic("compiler csg: structured source active slice count is invalid")
    parser.ParserStructuredSourceSliceReset(slice)
    parser.ParserStructuredSourceFactsReset(facts)
    CompilerCsgStructuredSourceDomainReset(domain)
    report.activeSliceCount = Int64(0)
    if sourceWasBuilt:
        report.sourceReleaseCount = report.sourceReleaseCount + Int64(1)
    report.finalScratchCapacityBytes =
        CompilerCsgStructuredSourceFactsBytes(facts, true) +
        CompilerCsgStructuredSourceSliceBytes(slice, true) +
        CompilerCsgStructuredSourceDomainBytes(domain, true)
    report.finalScratchLiveBytes =
        CompilerCsgStructuredSourceFactsBytes(facts, false) +
        CompilerCsgStructuredSourceSliceBytes(slice, false) +
        CompilerCsgStructuredSourceDomainBytes(domain, false)
    if report.finalScratchCapacityBytes != Int64(0) ||
       report.finalScratchLiveBytes != Int64(0):
        panic("compiler csg: structured source sidecar release retained storage")

fn CompilerCsgStructuredSourceSliceRelease(
        slice: var parser.ParserStructuredSourceSlice,
        report: var CompilerCsgStructuredSidecarReport) =
    if !slice.built || report.activeSliceCount != Int64(1):
        panic("compiler csg: structured source slice release ownership mismatch")
    parser.ParserStructuredSourceSliceReset(slice)
    report.activeSliceCount = report.activeSliceCount - Int64(1)

fn CompilerCsgFrontierParsedSourceStorePrepare(
        store: var CompilerCsgFrontierParsedSourceStore,
        profileCount: int32,
        err: var str): bool =
    if profileCount < 0:
        err = " compiler csg: frontier parsed source domain is negative"
        return false
    if store.prepared:
        if store.profileCount != profileCount ||
           store.present.len != profileCount ||
           store.sourceLineCounts.len != profileCount ||
           store.fullSourceLayers.len != profileCount ||
           store.exactExprLineStartOffsets.len != profileCount ||
           store.exactExprLineStartCounts.len != profileCount ||
           store.exactExprRowIndexOffsets.len != profileCount ||
           store.exactExprRowIndexCounts.len != profileCount ||
           store.structuredFacts.len != profileCount:
            err = " compiler csg: frontier parsed source domain changed"
            return false
        err = ""
        return true
    if store.profileCount != 0 || store.present.len != 0 ||
       store.sourceLineCounts.len != 0 ||
       store.fullSourceLayers.len != 0 ||
       store.exactExprLineStartOffsets.len != 0 ||
       store.exactExprLineStartCounts.len != 0 ||
       store.exactExprLineStarts.len != 0 ||
       store.exactExprRowIndexOffsets.len != 0 ||
       store.exactExprRowIndexCounts.len != 0 ||
       store.exactExprRowIndexes.len != 0 ||
       store.structuredFacts.len != 0 || store.buildCount != Int64(0) ||
       store.hitCount != Int64(0) || store.acquireCount != Int64(0):
        err = " compiler csg: frontier parsed source store is dirty"
        return false
    setLen(store.present, profileCount)
    setLen(store.sourceLineCounts, profileCount)
    setLen(store.fullSourceLayers, profileCount)
    setLen(store.exactExprLineStartOffsets, profileCount)
    setLen(store.exactExprLineStartCounts, profileCount)
    setLen(store.exactExprRowIndexOffsets, profileCount)
    setLen(store.exactExprRowIndexCounts, profileCount)
    setLen(store.structuredFacts, profileCount)
    store.profileCount = profileCount
    store.prepared = true
    err = ""
    return true

fn CompilerCsgStructuredSourceFactsMoveInto(
        out: var parser.ParserStructuredSourceFacts,
        source: var parser.ParserStructuredSourceFacts) =
    parser.ParserStructuredSourceFactsReset(out)
    out.built = source.built
    out.sourcePath = source.sourcePath
    out.sourceLineCount = source.sourceLineCount
    out.scopes = source.scopes
    out.seeds = source.seeds
    out.lineScopeIds = source.lineScopeIds
    out.lineInlineSuiteBodyColumns = source.lineInlineSuiteBodyColumns
    out.lineInlineSuiteScopeIds = source.lineInlineSuiteScopeIds
    out.lineDeferOwnerOrdinals = source.lineDeferOwnerOrdinals
    out.lineInlineDeferBodyColumns = source.lineInlineDeferBodyColumns
    out.lineInlineDeferSuiteScopeIds = source.lineInlineDeferSuiteScopeIds
    out.lineSeedStarts = source.lineSeedStarts
    out.lineSeedCounts = source.lineSeedCounts
    out.scopeBuildLineVisitCount = source.scopeBuildLineVisitCount
    out.structuredBuildLineVisitCount = source.structuredBuildLineVisitCount
    source = parser.ParserStructuredSourceFacts()

@borrows
fn CompilerCsgFrontierParsedSourceStoreEnsure(
        store: var CompilerCsgFrontierParsedSourceStore,
        profileIndex: int32,
        sourcePath: str,
        sourceText: str,
        compactView: var CompilerCsgCompactProfileView,
        parserScratchBytes: var int64,
        cacheBuilt: var bool,
        err: var str): bool =
    parserScratchBytes = Int64(0)
    cacheBuilt = false
    if !store.prepared || profileIndex < 0 ||
       profileIndex >= store.profileCount ||
       store.present.len != store.profileCount ||
       store.sourceLineCounts.len != store.profileCount ||
       store.fullSourceLayers.len != store.profileCount ||
       store.exactExprLineStartOffsets.len != store.profileCount ||
       store.exactExprLineStartCounts.len != store.profileCount ||
       store.exactExprRowIndexOffsets.len != store.profileCount ||
       store.exactExprRowIndexCounts.len != store.profileCount ||
       store.structuredFacts.len != store.profileCount:
        err = " compiler csg: frontier parsed source row unavailable"
        return false
    store.acquireCount = store.acquireCount + Int64(1)
    if store.present[profileIndex]:
        let sourceLineCount = store.sourceLineCounts[profileIndex]
        let lineStartOffset =
            store.exactExprLineStartOffsets[profileIndex]
        let lineStartCount =
            store.exactExprLineStartCounts[profileIndex]
        let rowIndexOffset =
            store.exactExprRowIndexOffsets[profileIndex]
        let rowIndexCount =
            store.exactExprRowIndexCounts[profileIndex]
        if sourceLineCount <= 0 ||
           lineStartOffset < 0 || lineStartCount != sourceLineCount + 2 ||
           lineStartOffset > store.exactExprLineStarts.len ||
           lineStartCount >
               store.exactExprLineStarts.len - lineStartOffset ||
           rowIndexOffset < 0 || rowIndexCount !=
               store.fullSourceLayers[profileIndex].exprs.len ||
           rowIndexOffset > store.exactExprRowIndexes.len ||
           rowIndexCount >
               store.exactExprRowIndexes.len - rowIndexOffset ||
           store.fullSourceLayers[profileIndex].sourceCount != 1 ||
           store.fullSourceLayers[profileIndex].valueExprTree == nil ||
           store.fullSourceLayers[profileIndex].valueExprTreeBorrowLease ||
           !store.structuredFacts[profileIndex].built ||
           store.structuredFacts[profileIndex].sourceLineCount !=
               sourceLineCount ||
           store.structuredFacts[profileIndex].sourcePath != sourcePath:
            err = Fmt" compiler csg: frontier parsed source cache row invalid profile={profileIndex}"
            return false
        store.hitCount = store.hitCount + Int64(1)
        err = ""
        return true
    var normalizedText = share(sourceText)
    if parser.ParserSourceHasMultilineString(sourceText):
        var multilineErr = ""
        if !parser.ParserRewriteMultilineStringSourceText(
                share(sourceText), normalizedText, multilineErr):
            err = Fmt" compiler csg: frontier multiline normalize failed source={sourcePath}: {multilineErr}"
            return false
    var textPayloadBytes: int64
    if normalizedText != sourceText:
        textPayloadBytes = Int64(normalizedText.len)
    var sourceLines = parser.ParserSplitChar(normalizedText, '\n')
    parser.ParserJoinContinuationLinesInPlace(sourceLines)
    var sourceExternalCallLookup: parser.ParserTextLookup
    var sourceLocalCallLookup = parser.ParserTextLookupBuildExact(
        compactView.profiles[0].localCallNames)
    var sourceImportcCallLookup = parser.ParserTextLookupBuildExact(
        compactView.profiles[0].importcCallNames)
    var fullSourceLayer: parser.NormalizedExprLayer
    if !CompilerCsgParseExactFullSourceLayer(sourcePath,
                                              sourceText,
                                              sourceLines,
                                              compactView,
                                              fullSourceLayer,
                                              err):
        return false
    var exactExprLineStarts: int32[]
    var exactExprRowIndexes: int32[]
    if !CompilerCsgExactSourceExprRowIndexBuild(fullSourceLayer,
                                                sourceLines.len,
                                                exactExprLineStarts,
                                                exactExprRowIndexes,
                                                err):
        parser.NormalizedExprLayerReset(fullSourceLayer)
        return false
    var structuredFacts: parser.ParserStructuredSourceFacts
    var structuredErr: str
    if !parser.ParserStructuredSourceFactsBuildFromLayer(fullSourceLayer,
                                                          sourceLines.len,
                                                          structuredFacts,
                                                          structuredErr):
        err = Fmt" compiler csg: structured source facts failed source={sourcePath}: {structuredErr}"
        parser.NormalizedExprLayerReset(fullSourceLayer)
        return false
    parserScratchBytes =
        CompilerCsgStringSequenceCapacityBytes(sourceLines) +
        textPayloadBytes +
        CompilerCsgParserTextLookupCapacityBytes(sourceExternalCallLookup) +
        CompilerCsgParserTextLookupCapacityBytes(sourceLocalCallLookup) +
        CompilerCsgParserTextLookupCapacityBytes(sourceImportcCallLookup)
    store.sourceLineCounts[profileIndex] = sourceLines.len
    parser.NormalizedExprLayerMoveInto(
        store.fullSourceLayers[profileIndex], fullSourceLayer)
    store.exactExprLineStartOffsets[profileIndex] =
        store.exactExprLineStarts.len
    store.exactExprLineStartCounts[profileIndex] =
        exactExprLineStarts.len
    for lineStartIndex in 0..<exactExprLineStarts.len:
        add(store.exactExprLineStarts,
            exactExprLineStarts[lineStartIndex])
    store.exactExprRowIndexOffsets[profileIndex] =
        store.exactExprRowIndexes.len
    store.exactExprRowIndexCounts[profileIndex] =
        exactExprRowIndexes.len
    for rowIndex in 0..<exactExprRowIndexes.len:
        add(store.exactExprRowIndexes, exactExprRowIndexes[rowIndex])
    CompilerCsgStructuredSourceFactsMoveInto(
        store.structuredFacts[profileIndex], structuredFacts)
    store.present[profileIndex] = true
    store.buildCount = store.buildCount + Int64(1)
    cacheBuilt = true
    err = ""
    return true

@borrows
fn CompilerCsgFrontierParsedSourceFunctionLayerBorrow(
        store: var CompilerCsgFrontierParsedSourceStore,
        profileIndex: int32,
        lineStartNumber: int32,
        lineEndNumber: int32,
        functionLayer: var parser.NormalizedExprLayer,
        err: var str): bool =
    parser.NormalizedExprLayerReset(functionLayer)
    if !store.prepared || profileIndex < 0 ||
       profileIndex >= store.profileCount ||
       !store.present[profileIndex]:
        err = " compiler csg: exact cached function source row missing"
        return false
    let lineOffset = store.exactExprLineStartOffsets[profileIndex]
    let lineCount = store.exactExprLineStartCounts[profileIndex]
    let rowOffset = store.exactExprRowIndexOffsets[profileIndex]
    let rowCount = store.exactExprRowIndexCounts[profileIndex]
    if lineOffset < 0 || lineCount <= 0 ||
       lineOffset > store.exactExprLineStarts.len ||
       lineCount > store.exactExprLineStarts.len - lineOffset ||
       rowOffset < 0 || rowCount < 0 ||
       rowOffset > store.exactExprRowIndexes.len ||
       rowCount > store.exactExprRowIndexes.len - rowOffset ||
       rowCount != store.fullSourceLayers[profileIndex].exprs.len ||
       store.fullSourceLayers[profileIndex].valueExprTree == nil ||
       store.fullSourceLayers[profileIndex].valueExprTreeBorrowLease ||
       lineStartNumber <= 0 || lineEndNumber < lineStartNumber ||
       lineEndNumber + 1 >= lineCount:
        err = Fmt" compiler csg: exact cached function parser slice invalid profile={profileIndex} start={lineStartNumber} end={lineEndNumber}"
        return false
    functionLayer.sourceCount = 1
    functionLayer.valueExprTree = parser.ParserValueExprTreeBorrow(
        store.fullSourceLayers[profileIndex].valueExprTree)
    functionLayer.valueExprTreeBorrowLease = true
    let localRowStart =
        store.exactExprLineStarts[lineOffset + lineStartNumber]
    let localRowEnd =
        store.exactExprLineStarts[lineOffset + lineEndNumber + 1]
    if localRowStart < 0 || localRowEnd < localRowStart ||
       localRowEnd > rowCount:
        err = " compiler csg: exact cached function parser row range invalid"
        parser.NormalizedExprLayerReset(functionLayer)
        return false
    for localRowOffset in localRowStart..<localRowEnd:
        let exprIndex =
            store.exactExprRowIndexes[rowOffset + localRowOffset]
        if exprIndex < 0 ||
           exprIndex >= store.fullSourceLayers[profileIndex].exprs.len:
            err = " compiler csg: exact cached function parser row missing"
            parser.NormalizedExprLayerReset(functionLayer)
            return false
        var expr: NormalizedExpr
        parser.NormalizedExprCloneInto(
            store.fullSourceLayers[profileIndex].exprs[exprIndex], expr)
        let before = functionLayer.exprs.len
        parser.NormalizedExprLayerAppendExisting(functionLayer, expr)
        if functionLayer.exprs.len != before + 1:
            err = Fmt" compiler csg: duplicate exact cached parser row profile={profileIndex} row={exprIndex}"
            parser.NormalizedExprLayerReset(functionLayer)
            return false
    err = ""
    return true

fn CompilerCsgFrontierParsedSourceStoreCapacityBytes(
        store: var CompilerCsgFrontierParsedSourceStore): int64 =
    if !store.prepared:
        return Int64(0)
    var total = Int64(store.present.cap) * CompilerCsgBoolBytes() +
                Int64(store.sourceLineCounts.cap) * CompilerCsgI32Bytes() +
                Int64(store.fullSourceLayers.cap) *
                    Int64(sizeof(parser.NormalizedExprLayer)) +
                Int64(store.exactExprLineStartOffsets.cap +
                      store.exactExprLineStartCounts.cap +
                      store.exactExprLineStarts.cap +
                      store.exactExprRowIndexOffsets.cap +
                      store.exactExprRowIndexCounts.cap +
                      store.exactExprRowIndexes.cap) *
                    CompilerCsgI32Bytes() +
                Int64(store.structuredFacts.cap) *
                    Int64(sizeof(parser.ParserStructuredSourceFacts))
    for profileIndex in 0..<store.profileCount:
        if !store.present[profileIndex]:
            continue
        total = total + CompilerCsgExprLayerSequenceBytes(
            store.fullSourceLayers[profileIndex], true)
        total = total + CompilerCsgStructuredSourceFactsBytes(
            store.structuredFacts[profileIndex], true)
    return total

fn CompilerCsgFrontierParsedSourceStoreRelease(
        store: var CompilerCsgFrontierParsedSourceStore) =
    if !store.prepared:
        if store.present.len != 0 || store.sourceLineCounts.len != 0 ||
           store.fullSourceLayers.len != 0 ||
           store.exactExprLineStartOffsets.len != 0 ||
           store.exactExprLineStartCounts.len != 0 ||
           store.exactExprLineStarts.len != 0 ||
           store.exactExprRowIndexOffsets.len != 0 ||
           store.exactExprRowIndexCounts.len != 0 ||
           store.exactExprRowIndexes.len != 0 ||
           store.structuredFacts.len != 0:
            panic("compiler csg: unprepared frontier parsed source store owns rows")
        return
    if store.profileCount != store.present.len ||
       store.profileCount != store.sourceLineCounts.len ||
       store.profileCount != store.fullSourceLayers.len ||
       store.profileCount != store.exactExprLineStartOffsets.len ||
       store.profileCount != store.exactExprLineStartCounts.len ||
       store.profileCount != store.exactExprRowIndexOffsets.len ||
       store.profileCount != store.exactExprRowIndexCounts.len ||
       store.profileCount != store.structuredFacts.len:
        panic("compiler csg: frontier parsed source release domain mismatch")
    for profileIndex in 0..<store.profileCount:
        CompilerCsgNormalizedExprLayerTerminalRelease(
            store.fullSourceLayers[profileIndex])
        parser.ParserStructuredSourceFactsReset(
            store.structuredFacts[profileIndex])
        store.present[profileIndex] = false
        store.sourceLineCounts[profileIndex] = 0
    store = CompilerCsgFrontierParsedSourceStore()

# [GEN2-P1] 波界增量释放：frontier 解析缓存是纯 memo —— Ensure 未命中
# 从 immutable snapshot 确定性重解析，命中/未命中产出逐字节同值
# （build/hit/acquire 计数仅进 trace 门控 stderr 与 staging ledger 审计，
# 均不进产物字节）。逐波整体释放把缓存活集从「全闭包已扫描源」降为
# 「单波 frontier 工作集」。调用点约束：上波 exprLayer Reset 与
# activeFunctionSourceSlices Release 之后（树租全部闭合）；若有未平
# 租约，TerminalRelease 租计数 panic 暴露，不静默。
fn CompilerCsgFrontierParsedSourceStoreEvictAll(
        store: var CompilerCsgFrontierParsedSourceStore) =
    if !store.prepared:
        return
    for profileIndex in 0..<store.profileCount:
        if !store.present[profileIndex]:
            continue
        CompilerCsgNormalizedExprLayerTerminalRelease(
            store.fullSourceLayers[profileIndex])
        parser.ParserStructuredSourceFactsReset(
            store.structuredFacts[profileIndex])
        store.present[profileIndex] = false
        store.sourceLineCounts[profileIndex] = 0
        store.exactExprLineStartOffsets[profileIndex] = 0
        store.exactExprLineStartCounts[profileIndex] = 0
        store.exactExprRowIndexOffsets[profileIndex] = 0
        store.exactExprRowIndexCounts[profileIndex] = 0
    store.exactExprLineStarts = []
    store.exactExprRowIndexes = []

fn CompilerCsgStructuredSourceRoundScratchRelease(
        facts: var parser.ParserStructuredSourceFacts,
        slice: var parser.ParserStructuredSourceSlice,
        domain: var CompilerCsgStructuredSourceDomain,
        report: var CompilerCsgStructuredSidecarReport) =
    if !facts.built:
        panic("compiler csg: structured source cache owner is unavailable")
    parser.ParserStructuredSourceSliceReset(slice)
    CompilerCsgStructuredSourceDomainReset(domain)
    report.activeSliceCount = Int64(0)
    report.sourceReleaseCount = report.sourceReleaseCount + Int64(1)
    report.finalScratchCapacityBytes =
        CompilerCsgStructuredSourceSliceBytes(slice, true) +
        CompilerCsgStructuredSourceDomainBytes(domain, true)
    report.finalScratchLiveBytes =
        CompilerCsgStructuredSourceSliceBytes(slice, false) +
        CompilerCsgStructuredSourceDomainBytes(domain, false)
    if report.finalScratchCapacityBytes != Int64(0) ||
       report.finalScratchLiveBytes != Int64(0):
        panic("compiler csg: structured source round release retained scratch")

@borrows
fn compilerCsgExprLayerForFrontierFunctionsImplRec(
        sourceSnapshots: var CompilerCsgSourceText[],
        sourceSnapshotIndex: var CompilerCsgSourcePathIndex,
        profiles: var parser.NormalizedExprCallProfile[],
        profileIndexLookup: var parser.ParserSourcePathIndexLookup,
        profileCallLookupCache: var CompilerCsgProfileCallLookupStore,
        parsedSourceStore: var CompilerCsgFrontierParsedSourceStore,
        reachableSet: var CompilerCsgReachableFunctionSet,
        sortedFrontierFunctions: var int32[],
        transaction: var CompilerCsgFrontierTransaction,
        nextLayer: var parser.NormalizedExprLayer,
        nextFunctionLayer: var parser.NormalizedExprLayer,
        nextFunctionSlices: var fslice.FunctionSourceSliceIndex,
        parserReceiptAccumulator: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        parserReceiptEnabled: bool,
        borrowCachedSourceForest: bool,
        sidecarReport: var CompilerCsgStructuredSidecarReport,
        cacheOverlay: var CompilerCsgProfileCallLookupOverlay,
        selectedProfileRow: int32,
        err: var str): bool =
    while true:
        if selectedProfileRow >= transaction.selectedProfiles.len:
            return true
        os.ProcessResourceGuardCheck()
        let profileIndex = transaction.selectedProfiles[selectedProfileRow]
        let sourcePath = parser.ParserNormalizePath(profiles[profileIndex].sourcePath)
        var compactView: CompilerCsgCompactProfileView
        if !CompilerCsgCompactProfileViewBuild(profiles,
                                               profileIndexLookup,
                                               profileCallLookupCache,
                                               profileIndex,
                                               compactView,
                                               err):
            return false
        var sourceText: str
        var snapshotErr: str
        if !CompilerCsgImmutableSourceSnapshotText(sourceSnapshots,
                                                    sourceSnapshotIndex,
                                                    sourcePath,
                                                    sourceText,
                                                    snapshotErr):
            err = snapshotErr
            return false
        var parserScratchBytes: int64
        var parsedSourceBuilt = false
        if !CompilerCsgFrontierParsedSourceStoreEnsure(
                parsedSourceStore,
                profileIndex,
                sourcePath,
                sourceText,
                compactView,
                parserScratchBytes,
                parsedSourceBuilt,
                err):
            return false
        var profileFunctionSortScratchBytes: int64
        var profileFunctionIndexes = CompilerCsgSortedProfileFunctionIndexes(
            transaction,
            reachableSet,
            profileIndex,
            transaction.selectedProfileHeads[selectedProfileRow],
            profileFunctionSortScratchBytes,
            err)
        if err != "" || profileFunctionIndexes.len <= 0:
            if err == "":
                err = Fmt" compiler csg: selected profile has no functions profile={profileIndex}"
            return false
        let profileFunctionOrderBytes = CompilerCsgSequenceHeaderBytes() +
            Int64(profileFunctionIndexes.cap) * CompilerCsgI32Bytes() +
            profileFunctionSortScratchBytes
        var structuredSlice: parser.ParserStructuredSourceSlice
        var structuredDomain: CompilerCsgStructuredSourceDomain
        var structuredErr: str
        sidecarReport.sourceBuildCount = sidecarReport.sourceBuildCount + Int64(1)
        if parsedSourceBuilt:
            sidecarReport.scopeBuildLineVisitCount =
                sidecarReport.scopeBuildLineVisitCount +
                    parsedSourceStore.structuredFacts[
                        profileIndex].scopeBuildLineVisitCount
            sidecarReport.structuredBuildLineVisitCount =
                sidecarReport.structuredBuildLineVisitCount +
                    parsedSourceStore.structuredFacts[
                        profileIndex].structuredBuildLineVisitCount
        CompilerCsgStructuredSourceDomainInit(
            parsedSourceStore.structuredFacts[profileIndex], structuredDomain)
        CompilerCsgStructuredSidecarReportSample(sidecarReport,
                                                  parsedSourceStore.structuredFacts[
                                                      profileIndex],
                                                  structuredSlice,
                                                  structuredDomain)
        for profileFunctionRow in 0..<profileFunctionIndexes.len:
            let functionIndex = profileFunctionIndexes[profileFunctionRow]
            let lineStart = reachableSet.startLines[functionIndex]
            let lineEnd = reachableSet.endLines[functionIndex]
            if lineStart <= 0 || lineEnd < lineStart:
                err = Fmt" compiler csg: frontier function line range invalid source={sourcePath} function_index={functionIndex} start={lineStart} end={lineEnd}"
                CompilerCsgStructuredSourceRoundScratchRelease(
                    parsedSourceStore.structuredFacts[profileIndex],
                    structuredSlice,
                    structuredDomain,
                    sidecarReport)
                return false
            parser.NormalizedExprLayerReset(nextFunctionLayer)
            if !CompilerCsgFrontierParsedSourceFunctionLayerBorrow(
                    parsedSourceStore,
                    profileIndex,
                    lineStart,
                    lineEnd,
                    nextFunctionLayer,
                    err):
                err = Fmt" compiler csg: frontier exact expr layer failed source={sourcePath} function_index={functionIndex}: {err}"
                CompilerCsgStructuredSourceRoundScratchRelease(
                    parsedSourceStore.structuredFacts[profileIndex],
                    structuredSlice,
                    structuredDomain,
                    sidecarReport)
                return false
            if !parser.ParserStructuredSourceFactsSliceBuildFromLayer(
                    parsedSourceStore.structuredFacts[profileIndex],
                    parsedSourceStore.fullSourceLayers[profileIndex],
                    lineStart,
                    lineEnd,
                    structuredSlice,
                    structuredErr):
                err = Fmt" compiler csg: structured source slice failed source={sourcePath} function_index={functionIndex}: {structuredErr}"
                CompilerCsgStructuredSourceRoundScratchRelease(
                    parsedSourceStore.structuredFacts[profileIndex],
                    structuredSlice,
                    structuredDomain,
                    sidecarReport)
                return false
            sidecarReport.sliceBuildCount = sidecarReport.sliceBuildCount + Int64(1)
            sidecarReport.activeSliceCount =
                sidecarReport.activeSliceCount + Int64(1)
            if sidecarReport.activeSliceCount >
               sidecarReport.activeSlicePeakCount:
                sidecarReport.activeSlicePeakCount =
                    sidecarReport.activeSliceCount
            if !parser.ParserStructuredSourceSliceRemapExistingLayer(
                    structuredSlice,
                    nextFunctionLayer,
                    structuredErr):
                err = Fmt" compiler csg: structured source slice append failed source={sourcePath} function_index={functionIndex}: {structuredErr}"
                CompilerCsgStructuredSourceRoundScratchRelease(
                    parsedSourceStore.structuredFacts[profileIndex],
                    structuredSlice,
                    structuredDomain,
                    sidecarReport)
                return false
            if parserReceiptEnabled &&
               !parserReceiptAccumulator.functionPresent[functionIndex]:
                if profileIndex < 0 ||
                   profileIndex >= parserReceiptAccumulator.sourcePaths.len ||
                   profileIndex >=
                       parserReceiptAccumulator.ownerModulePaths.len ||
                   parserReceiptAccumulator.sourcePaths[profileIndex] !=
                       sourcePath:
                    err = Fmt" compiler csg: frontier parser receipt source identity mismatch profile={profileIndex} source={sourcePath}"
                    CompilerCsgStructuredSourceRoundScratchRelease(
                        parsedSourceStore.structuredFacts[profileIndex],
                        structuredSlice,
                        structuredDomain,
                        sidecarReport)
                    return false
                let parserReceiptIdentity =
                    parser_receipt.ParserNormalizedExprFunctionIdentityMake(
                        profileIndex,
                        functionIndex,
                        sourcePath,
                        parserReceiptAccumulator.ownerModulePaths[profileIndex],
                        reachableSet.functionNames[functionIndex],
                        lineStart,
                        lineEnd)
                var parserReceiptIdentities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
                add(parserReceiptIdentities, parserReceiptIdentity)
                if !CompilerCsgParserReceiptObserveAndVerify(
                        parserReceiptAccumulator,
                        nextFunctionLayer,
                        parserReceiptIdentities,
                        err):
                    CompilerCsgStructuredSourceRoundScratchRelease(
                        parsedSourceStore.structuredFacts[profileIndex],
                        structuredSlice,
                        structuredDomain,
                        sidecarReport)
                    return false
            let functionExprStart = structuredDomain.appendedExprCount
            let functionScopeCountBefore = structuredDomain.denseScopeCount
            let functionStatementStart = structuredDomain.denseStatementCount
            if !CompilerCsgStructuredSourceDomainStageSliceWithBorrow(
                    parsedSourceStore.structuredFacts[profileIndex],
                    structuredSlice,
                    nextFunctionLayer,
                    lineStart,
                    lineEnd,
                    structuredDomain,
                    borrowCachedSourceForest &&
                        transaction.selectedProfiles.len == 1,
                    nextLayer,
                    structuredErr):
                err = Fmt" compiler csg: structured source domain stage failed source={sourcePath} function_index={functionIndex}: {structuredErr}"
                CompilerCsgStructuredSourceRoundScratchRelease(
                    parsedSourceStore.structuredFacts[profileIndex],
                    structuredSlice,
                    structuredDomain,
                    sidecarReport)
                return false
            if !CompilerCsgFunctionSourceSliceCommit(nextFunctionSlices,
                                                     profileIndex,
                                                     functionIndex,
                                                     functionExprStart,
                                                     functionScopeCountBefore,
                                                     functionStatementStart,
                                                     structuredDomain,
                                                     nextLayer,
                                                     structuredErr):
                err = Fmt" compiler csg: function source slice commit failed source={sourcePath} function_index={functionIndex}: {structuredErr}"
                CompilerCsgStructuredSourceRoundScratchRelease(
                    parsedSourceStore.structuredFacts[profileIndex],
                    structuredSlice,
                    structuredDomain,
                    sidecarReport)
                return false
            sidecarReport.sliceLineVisitCount = sidecarReport.sliceLineVisitCount +
                                                structuredSlice.lineVisitCount
            sidecarReport.sliceScopeVisitCount = sidecarReport.sliceScopeVisitCount +
                                                 structuredSlice.scopeVisitCount
            sidecarReport.sliceSeedVisitCount = sidecarReport.sliceSeedVisitCount +
                                                structuredSlice.seedVisitCount
            sidecarReport.sliceApplyExprVisitCount =
                sidecarReport.sliceApplyExprVisitCount +
                    structuredSlice.applyExprVisitCount
            CompilerCsgStructuredSidecarReportSample(sidecarReport,
                                                      parsedSourceStore.structuredFacts[
                                                          profileIndex],
                                                      structuredSlice,
                                                      structuredDomain)
            CompilerCsgStructuredSourceSliceRelease(structuredSlice,
                                                    sidecarReport)
            parser.NormalizedExprLayerReset(nextFunctionLayer)
            var parserPhase: CompilerCsgStagingCapacityLedger
            CompilerCsgFrontierTransactionPersistentPhase(transaction,
                                                          parserPhase)
            parserPhase.sortingBytes = CompilerCsgSequenceHeaderBytes() +
                                       Int64(sortedFrontierFunctions.cap) *
                                           CompilerCsgI32Bytes() +
                                       profileFunctionOrderBytes
            parserPhase.frontierOutputBytes =
                CompilerCsgExprLayerCapacityBytesMode(nextLayer, true) +
                CompilerCsgExprLayerCapacityBytesMode(nextFunctionLayer, false) +
                CompilerCsgFunctionSourceSliceIndexCapacityBytes(
                    nextFunctionSlices)
            parserPhase.frontierOutputPrimaryOwnsStringPayload = true
            parserPhase.frontierOutputScratchOwnsStringPayload = false
            parserPhase.frontierParserScratchBytes = parserScratchBytes +
                CompilerCsgStructuredSourceDomainBytes(structuredDomain, true)
            parserPhase.parserCacheScratchBytes =
                CompilerCsgCompactProfileViewCapacityBytes(compactView) +
                CompilerCsgFrontierParsedSourceStoreCapacityBytes(
                    parsedSourceStore)
            parserPhase.profileCacheOverlayBytes =
                CompilerCsgProfileCallLookupArrayCapacityBytes(cacheOverlay.entries)
            parserPhase.sparseIndexBytes = parserPhase.sparseIndexBytes +
                CompilerCsgSparseIntIndexCapacityBytes(cacheOverlay.index)
            CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger,
                                                        parserPhase)
        if !CompilerCsgStructuredSourceDomainFinalize(
                parsedSourceStore.structuredFacts[profileIndex],
                structuredDomain,
                nextLayer,
                structuredErr):
            err = Fmt" compiler csg: structured source domain finalize failed source={sourcePath}: {structuredErr}"
            CompilerCsgStructuredSourceRoundScratchRelease(
                parsedSourceStore.structuredFacts[profileIndex],
                structuredSlice,
                structuredDomain,
                sidecarReport)
            return false
        CompilerCsgStructuredSidecarReportSample(sidecarReport,
                                                  parsedSourceStore.structuredFacts[
                                                      profileIndex],
                                                  structuredSlice,
                                                  structuredDomain)
        CompilerCsgStructuredSourceRoundScratchRelease(
            parsedSourceStore.structuredFacts[profileIndex],
            structuredSlice,
            structuredDomain,
            sidecarReport)
        if !CompilerCsgCompactProfileCacheToOverlay(profileCallLookupCache,
                                                    compactView,
                                                    cacheOverlay,
                                                    err):
            return false
        var cacheMovePhase: CompilerCsgStagingCapacityLedger
        CompilerCsgFrontierTransactionPersistentPhase(transaction,
                                                      cacheMovePhase)
        cacheMovePhase.sortingBytes = CompilerCsgSequenceHeaderBytes() +
            Int64(sortedFrontierFunctions.cap) * CompilerCsgI32Bytes() +
            profileFunctionOrderBytes
        cacheMovePhase.frontierOutputBytes =
            CompilerCsgExprLayerCapacityBytesMode(nextLayer, true) +
            CompilerCsgExprLayerCapacityBytesMode(nextFunctionLayer, false) +
            CompilerCsgFunctionSourceSliceIndexCapacityBytes(
                nextFunctionSlices)
        cacheMovePhase.frontierOutputPrimaryOwnsStringPayload = true
        cacheMovePhase.frontierOutputScratchOwnsStringPayload = false
        cacheMovePhase.frontierParserScratchBytes = parserScratchBytes
        cacheMovePhase.parserCacheScratchBytes =
            CompilerCsgCompactProfileViewCapacityBytes(compactView) +
            CompilerCsgFrontierParsedSourceStoreCapacityBytes(
                parsedSourceStore)
        cacheMovePhase.profileCacheOverlayBytes =
            CompilerCsgProfileCallLookupArrayCapacityBytes(cacheOverlay.entries)
        cacheMovePhase.sparseIndexBytes = cacheMovePhase.sparseIndexBytes +
            CompilerCsgSparseIntIndexCapacityBytes(cacheOverlay.index)
        CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger,
                                                    cacheMovePhase)
        profileFunctionIndexes = []
        selectedProfileRow = selectedProfileRow + 1
        continue

fn CompilerCsgFrontierStagedOutputRelease(
        nextLayer: var parser.NormalizedExprLayer,
        nextFunctionLayer: var parser.NormalizedExprLayer,
        nextFunctionSlices: var fslice.FunctionSourceSliceIndex) =
    # Function slices borrow a cached source tree; the aggregate layer may
    # hold a second lease on the same tree. Close both before the cache owner.
    CompilerCsgNormalizedExprLayerTerminalRelease(nextFunctionLayer)
    CompilerCsgNormalizedExprLayerTerminalRelease(nextLayer)
    if !nextFunctionSlices.released:
        fslice.FunctionSourceSliceIndexRelease(nextFunctionSlices)

@borrows
fn compilerCsgExprLayerForFrontierFunctionsImpl(
        sourceSnapshots: var CompilerCsgSourceText[],
        sourceSnapshotIndex: var CompilerCsgSourcePathIndex,
        profiles: var parser.NormalizedExprCallProfile[],
        profileIndexLookup: var parser.ParserSourcePathIndexLookup,
        profileCallLookupCache: var CompilerCsgProfileCallLookupStore,
        parsedSourceStore: var CompilerCsgFrontierParsedSourceStore,
        reachableSet: var CompilerCsgReachableFunctionSet,
        frontierFunctionIndexes: int32[],
        frontierIndex: var CompilerCsgFrontierIndex,
        layer: var parser.NormalizedExprLayer,
        functionLayer: var parser.NormalizedExprLayer,
        functionSlices: var fslice.FunctionSourceSliceIndex,
        parserReceiptAccumulator: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        parserReceiptEnabled: bool,
        borrowCachedSourceForest: bool,
        err: var str): bool =
    if !CompilerCsgFrontierParsedSourceStorePrepare(
            parsedSourceStore, profiles.len, err):
        return false
    var baseIndex = frontierIndex
    var stagedInitialIndex = false
    var stagedAuditedIndex = false
    if CompilerCsgFrontierIndexUninitialized(frontierIndex):
        baseIndex = CompilerCsgFrontierIndex()
        CompilerCsgFrontierIndexPrepare(baseIndex,
                                        profiles.len,
                                        reachableSet.functionNames.len)
        stagedInitialIndex = true
    elif baseIndex.domainVersion <= Int64(0) ||
         baseIndex.sealedDomainVersion != baseIndex.domainVersion:
        stagedAuditedIndex = true
    var validationBytes: int64
    if !CompilerCsgFrontierIndexValidate(baseIndex,
                                         reachableSet,
                                         validationBytes,
                                         err):
        return false
    var transaction: CompilerCsgFrontierTransaction
    transaction.initialIndexBytes =
        stagedInitialIndex ? CompilerCsgFrontierIndexOwnedCapacityBytes(baseIndex) :
        (stagedAuditedIndex ?
            CompilerCsgFrontierIndexCertificateCapacityBytes(baseIndex) : Int64(0))
    var validationPhase: CompilerCsgStagingCapacityLedger
    validationPhase.validationBytes = validationBytes +
        transaction.initialIndexBytes
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger,
                                                validationPhase)
    if !CompilerCsgFrontierTouchedDomainValidate(baseIndex,
                                                 transaction.certificateValidationOperationCount,
                                                 err):
        return false
    var sortingScratchBytes: int64
    var sortedFrontierFunctions = CompilerCsgSortedUniqueFunctionIndexesMeasured(frontierFunctionIndexes,
                                                                                  reachableSet.functionNames.len,
                                                                                  sortingScratchBytes,
                                                                                  err)
    if err != "":
        return false
    var canonicalSortingScratchBytes: int64
    if !CompilerCsgSortFrontierSliceFunctions(sortedFrontierFunctions,
                                              reachableSet,
                                              canonicalSortingScratchBytes,
                                              err):
        return false
    var sortingPhase: CompilerCsgStagingCapacityLedger
    CompilerCsgFrontierTransactionPersistentPhase(transaction, sortingPhase)
    sortingPhase.sortingBytes = CompilerCsgSequenceHeaderBytes() * Int64(2) +
                                sortingScratchBytes +
                                canonicalSortingScratchBytes +
                                Int64(sortedFrontierFunctions.cap) *
                                    CompilerCsgI32Bytes()
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger, sortingPhase)
    if !CompilerCsgFrontierTransactionStageProfileSelection(sortedFrontierFunctions,
                                                             baseIndex,
                                                             reachableSet,
                                                             profiles,
                                                             transaction,
                                                             err):
        return false
    var nextLayer: parser.NormalizedExprLayer
    var nextFunctionLayer: parser.NormalizedExprLayer
    var nextFunctionSlices = fslice.FunctionSourceSliceIndexInit(
        profiles.len, sortedFrontierFunctions.len)
    var cacheOverlay: CompilerCsgProfileCallLookupOverlay
    var sidecarReport: CompilerCsgStructuredSidecarReport
    if !compilerCsgExprLayerForFrontierFunctionsImplRec(
           sourceSnapshots,
           sourceSnapshotIndex,
           profiles,
           profileIndexLookup,
           profileCallLookupCache,
           parsedSourceStore,
           reachableSet,
           sortedFrontierFunctions,
           transaction,
           nextLayer,
           nextFunctionLayer,
           nextFunctionSlices,
           parserReceiptAccumulator,
           parserReceiptEnabled,
           borrowCachedSourceForest,
           sidecarReport,
           cacheOverlay,
           0,
           err):
        CompilerCsgFrontierStagedOutputRelease(
            nextLayer, nextFunctionLayer, nextFunctionSlices)
        return false
    if sidecarReport.sourceReleaseCount != sidecarReport.sourceBuildCount ||
       sidecarReport.activeSliceCount != Int64(0) ||
       sidecarReport.finalScratchCapacityBytes != Int64(0) ||
       sidecarReport.finalScratchLiveBytes != Int64(0):
        err = " compiler csg: structured source scratch lifecycle incomplete"
        CompilerCsgFrontierStagedOutputRelease(
            nextLayer, nextFunctionLayer, nextFunctionSlices)
        return false
    fslice.FunctionSourceSliceIndexSeal(nextFunctionSlices)
    fslice.FunctionSourceSliceIndexRequireParentValidationComplete(
        nextFunctionSlices)
    if nextFunctionSlices.sourceIndices.len != sortedFrontierFunctions.len ||
       nextFunctionSlices.sourceStarts.len != profiles.len ||
       nextFunctionSlices.functionRowAppendVisitCount !=
           sortedFrontierFunctions.len ||
       nextFunctionSlices.exprCommitVisitCount != nextLayer.exprs.len ||
       nextFunctionSlices.scopeCommitVisitCount +
           transaction.selectedProfiles.len != nextLayer.scopes.len ||
       nextFunctionSlices.scopeParentValidationVisitCount !=
           nextFunctionSlices.scopeCommitVisitCount ||
       nextFunctionSlices.parentValidationRowCursor !=
           sortedFrontierFunctions.len:
        err = " compiler csg: function source slice visit/count closure failed"
        CompilerCsgFrontierStagedOutputRelease(
            nextLayer, nextFunctionLayer, nextFunctionSlices)
        return false
    CompilerCsgNormalizedExprLayerTerminalRelease(nextFunctionLayer)
    if !CompilerCsgProfileCallLookupOverlayValidate(profiles,
                                                     cacheOverlay,
                                                     err):
        CompilerCsgFrontierStagedOutputRelease(
            nextLayer, nextFunctionLayer, nextFunctionSlices)
        return false
    if transaction.reachabilityProbes.contentCertificateViolation:
        err = " compiler csg: frontier parser reachable certificate mismatch"
        CompilerCsgFrontierStagedOutputRelease(
            nextLayer, nextFunctionLayer, nextFunctionSlices)
        return false
    var commitPhase: CompilerCsgStagingCapacityLedger
    CompilerCsgFrontierTransactionPersistentPhase(transaction, commitPhase)
    commitPhase.sortingBytes = CompilerCsgSequenceHeaderBytes() +
                               Int64(sortedFrontierFunctions.cap) *
                                   CompilerCsgI32Bytes()
    commitPhase.frontierOutputBytes =
        CompilerCsgExprLayerCapacityBytesMode(nextLayer, true) +
        CompilerCsgExprLayerCapacityBytesMode(nextFunctionLayer, false) +
        CompilerCsgFunctionSourceSliceIndexCapacityBytes(nextFunctionSlices)
    commitPhase.frontierOutputPrimaryOwnsStringPayload = true
    commitPhase.frontierOutputScratchOwnsStringPayload = false
    commitPhase.profileCacheOverlayBytes =
        CompilerCsgProfileCallLookupArrayCapacityBytes(cacheOverlay.entries)
    commitPhase.sparseIndexBytes = commitPhase.sparseIndexBytes +
        CompilerCsgSparseIntIndexCapacityBytes(cacheOverlay.index)
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger, commitPhase)
    var ledgerErr: str
    if !CompilerCsgStagingCapacityLedgerValidate(transaction.ledger, ledgerErr):
        err = ledgerErr
        CompilerCsgFrontierStagedOutputRelease(
            nextLayer, nextFunctionLayer, nextFunctionSlices)
        return false
    if stagedInitialIndex || stagedAuditedIndex:
        frontierIndex = baseIndex
    CompilerCsgFrontierTransactionCommitSelection(frontierIndex,
                                                   profiles.len,
                                                   reachableSet.functionNames.len,
                                                   transaction)
    CompilerCsgReachabilityProbeDeltaCommit(reachableSet,
                                            transaction.reachabilityProbes)
    CompilerCsgProfileCallLookupOverlayCommitValidated(profileCallLookupCache,
                                                        cacheOverlay)
    frontierIndex.lastStagingCapacity = transaction.ledger
    frontierIndex.lastStructuredSidecar = sidecarReport
    if !functionSlices.released:
        fslice.FunctionSourceSliceIndexRelease(functionSlices)
    fslice.FunctionSourceSliceIndexMoveInto(
        functionSlices, nextFunctionSlices)
    parser.NormalizedExprLayerMoveInto(layer, nextLayer)
    parser.NormalizedExprLayerMoveInto(functionLayer, nextFunctionLayer)
    err = ""
    return true

fn CompilerCsgExprLayerForFrontierFunctions(
        sourceSnapshots: var CompilerCsgSourceText[],
        sourceSnapshotIndex: var CompilerCsgSourcePathIndex,
        profiles: var parser.NormalizedExprCallProfile[],
        profileIndexLookup: var parser.ParserSourcePathIndexLookup,
        profileCallLookupCache: var CompilerCsgProfileCallLookupStore,
        reachableSet: var CompilerCsgReachableFunctionSet,
        frontierFunctionIndexes: int32[],
        frontierIndex: var CompilerCsgFrontierIndex,
        layer: var parser.NormalizedExprLayer,
        functionLayer: var parser.NormalizedExprLayer,
        functionSlices: var fslice.FunctionSourceSliceIndex,
        err: var str): bool =
    var disabledParserReceiptAccumulator: parser_receipt.ParserNormalizedExprReceiptAccumulator
    var parsedSourceStore: CompilerCsgFrontierParsedSourceStore
    let ok = compilerCsgExprLayerForFrontierFunctionsImpl(
        sourceSnapshots,
        sourceSnapshotIndex,
        profiles,
        profileIndexLookup,
        profileCallLookupCache,
        parsedSourceStore,
        reachableSet,
        frontierFunctionIndexes,
        frontierIndex,
        layer,
        functionLayer,
        functionSlices,
        disabledParserReceiptAccumulator,
        false,
        false,
        err)
    CompilerCsgFrontierParsedSourceStoreRelease(parsedSourceStore)
    return ok

fn CompilerCsgSemanticInitProcessedFunctionAndSourceFlags(semanticGraph: var CompilerCsgSemanticGraph,
                                                     reachableSet: var CompilerCsgReachableFunctionSet,
                                                     functionProcessed: var bool[],
                                                     sourceCounted: var bool[]) =
    functionProcessed = []
    sourceCounted = []
    for functionIndex in 0..<reachableSet.functionNames.len:
        add(functionProcessed, false)
    for sourceIndex in 0..<semanticGraph.sourceTable.sourcePaths.len:
        add(sourceCounted, false)
    for sliceIndex in 0..<semanticGraph.exprSliceTable.sourceIndex.len:
        if sliceIndex < semanticGraph.exprSliceTable.functionIndex.len:
            let functionIndex = semanticGraph.exprSliceTable.functionIndex[sliceIndex]
            if functionIndex >= 0 && functionIndex < functionProcessed.len:
                functionProcessed[functionIndex] = true
        let sourceIndex = semanticGraph.exprSliceTable.sourceIndex[sliceIndex]
        if sourceIndex >= 0 && sourceIndex < sourceCounted.len &&
           sliceIndex < semanticGraph.exprSliceTable.exprCount.len &&
           semanticGraph.exprSliceTable.exprCount[sliceIndex] > 0:
            sourceCounted[sourceIndex] = true
    # The all-functions streaming path intentionally records one complete slice
    # per source. That slice already contains every function's facts, so bind its
    # coverage through the source table instead of appending each function again.
    if !reachableSet.active:
        for functionIndex in 0..<reachableSet.functionNames.len:
            if functionIndex >= reachableSet.sourcePaths.len:
                panic(Fmt"compiler csg: reachable function source adjacency missing function_index={functionIndex}")
            let sourceIndex = CompilerCsgSemanticFindSourceIndex(reachableSet.profileSourceIndex,
                                                           reachableSet.sourcePaths[functionIndex])
            if sourceIndex >= 0 && sourceIndex < sourceCounted.len && sourceCounted[sourceIndex]:
                functionProcessed[functionIndex] = true

@borrows
fn CompilerCsgFunctionSourceSliceRowsValidate(
        slices: var fslice.FunctionSourceSliceIndex,
        reachableSet: var CompilerCsgReachableFunctionSet,
        frontierFunctionIndexes: int32[],
        exprLayer: var parser.NormalizedExprLayer,
        report: var CompilerCsgStructuredSidecarReport,
        sourceScopeRootIndexes: var int32[],
        expectedFactCount: var int32,
        err: var str): bool =
    if !fslice.FunctionSourceSliceIndexContentCertificateMatches(slices):
        err = " compiler csg: function source slice sealed content certificate mismatch"
        return false
    fslice.FunctionSourceSliceIndexRequireParentValidationComplete(slices)
    if !slices.sealed || slices.released ||
       slices.sourceIndices.len != frontierFunctionIndexes.len ||
       slices.expectedFunctionCount != frontierFunctionIndexes.len:
        err = Fmt" compiler csg: function source slice consumer authority invalid sealed={slices.sealed} released={slices.released} rows={slices.sourceIndices.len} frontier={frontierFunctionIndexes.len} expected={slices.expectedFunctionCount}"
        return false
    var sortingScratchBytes: int64
    var sortedFunctions = CompilerCsgSortedUniqueFunctionIndexesMeasured(
        frontierFunctionIndexes,
        reachableSet.functionNames.len,
        sortingScratchBytes,
        err)
    if err != "" || sortedFunctions.len != frontierFunctionIndexes.len:
        if err == "":
            err = " compiler csg: function source slice consumer frontier is not unique"
        return false
    var canonicalSortingScratchBytes: int64
    if !CompilerCsgSortFrontierSliceFunctions(sortedFunctions,
                                               reachableSet,
                                               canonicalSortingScratchBytes,
                                               err):
        return false
    var seenFunctions: bool[]
    setLen(seenFunctions, sortedFunctions.len)
    var sourceScopeCounts: int32[]
    var expectedScopeStarts: int32[]
    var expectedStatementStarts: int32[]
    setLen(sourceScopeRootIndexes, slices.expectedSourceCount)
    setLen(sourceScopeCounts, slices.expectedSourceCount)
    setLen(expectedScopeStarts, slices.expectedSourceCount)
    setLen(expectedStatementStarts, slices.expectedSourceCount)
    for sourceIndex in 0..<sourceScopeRootIndexes.len:
        sourceScopeRootIndexes[sourceIndex] = -1
        expectedScopeStarts[sourceIndex] = 1
    for scopeIndex in 0..<exprLayer.scopes.len:
        let scope = exprLayer.scopes[scopeIndex]
        let sourceIndex = CompilerCsgSemanticFindSourceIndex(
            reachableSet.profileSourceIndex, scope.sourcePath)
        if sourceIndex < 0 || sourceIndex >= sourceScopeRootIndexes.len:
            err = Fmt" compiler csg: function source slice consumer scope source missing scope_index={scopeIndex} source={scope.sourcePath}"
            return false
        if scope.scopeId == 0:
            if sourceScopeRootIndexes[sourceIndex] >= 0 ||
               scope.parentScopeId != -1 || scope.sourceScopeId != 0:
                err = Fmt" compiler csg: function source slice consumer root identity invalid source_index={sourceIndex} scope_index={scopeIndex}"
                return false
            sourceScopeRootIndexes[sourceIndex] = scopeIndex
        else:
            let rootIndex = sourceScopeRootIndexes[sourceIndex]
            # Frontier slices project each source's scope set: the layer keeps
            # dense per-source local scopeIds (consumed below at
            # rootIndex+scopeId) while scope.sourceScopeId retains the original
            # facts-table id as provenance.  Identity of the two held only for
            # unprojected layers; the dense-local contract is what the row
            # consumer at :16876 indexes on.
            if rootIndex < 0 || scopeIndex != rootIndex + scope.scopeId:
                err = Fmt" compiler csg: function source slice consumer scope identity drift source_index={sourceIndex} scope_index={scopeIndex} scope_id={scope.scopeId} root={rootIndex}"
                return false
        sourceScopeCounts[sourceIndex] = sourceScopeCounts[sourceIndex] + 1
    var globalExprCursor: int32
    var currentExprSourceIndex: int32 = -1
    var sourceLocalExprCursor: int32
    var factCount64: int64
    for rowIndex in 0..<slices.sourceIndices.len:
        let row = fslice.FunctionSourceSliceIndexGetRow(slices, rowIndex)
        report.consumerIndexRowVisitCount =
            report.consumerIndexRowVisitCount + Int64(1)
        if row.functionIndex < 0 ||
           row.functionIndex >= reachableSet.functionNames.len ||
           row.functionIndex >= reachableSet.sourcePaths.len ||
           row.functionIndex >= reachableSet.startLines.len ||
           row.functionIndex >= reachableSet.endLines.len:
            err = Fmt" compiler csg: function source slice consumer function missing row={rowIndex} function_index={row.functionIndex}"
            return false
        if rowIndex >= sortedFunctions.len ||
           row.functionIndex != sortedFunctions[rowIndex]:
            err = Fmt" compiler csg: function source slice canonical frontier order mismatch row={rowIndex} observed={row.functionIndex} expected={rowIndex < sortedFunctions.len ? sortedFunctions[rowIndex] : -1}"
            return false
        let frontierPosition = CompilerCsgSortedFunctionIndexPosition(
            sortedFunctions, row.functionIndex)
        if frontierPosition < 0 || seenFunctions[frontierPosition]:
            err = Fmt" compiler csg: function source slice consumer function coverage invalid row={rowIndex} function_index={row.functionIndex}"
            return false
        seenFunctions[frontierPosition] = true
        let expectedSourceIndex = CompilerCsgSemanticFindSourceIndex(
            reachableSet.profileSourceIndex,
            reachableSet.sourcePaths[row.functionIndex])
        if row.sourceIndex != expectedSourceIndex || row.sourceIndex < 0 ||
           row.sourceIndex >= sourceScopeRootIndexes.len:
            err = Fmt" compiler csg: function source slice consumer source identity drift row={rowIndex} function_index={row.functionIndex} row_source={row.sourceIndex} expected_source={expectedSourceIndex}"
            return false
        if row.sourceIndex != currentExprSourceIndex:
            if row.sourceIndex <= currentExprSourceIndex:
                err = Fmt" compiler csg: function source slice consumer source order invalid row={rowIndex} source={row.sourceIndex} previous={currentExprSourceIndex}"
                return false
            currentExprSourceIndex = row.sourceIndex
            sourceLocalExprCursor = 0
        if row.exprStart != sourceLocalExprCursor || row.exprCount < 0 ||
           globalExprCursor > exprLayer.exprs.len ||
           row.exprCount > exprLayer.exprs.len - globalExprCursor:
            err = Fmt" compiler csg: function source slice consumer expr range invalid row={rowIndex} local_start={row.exprStart} count={row.exprCount} expected_local_start={sourceLocalExprCursor} global_start={globalExprCursor} exprs={exprLayer.exprs.len}"
            return false
        if row.scopeStart != expectedScopeStarts[row.sourceIndex] ||
           row.scopeCount < 0 || row.statementCount < 0 ||
           row.statementStart != expectedStatementStarts[row.sourceIndex]:
            err = Fmt" compiler csg: function source slice consumer source-local range drift row={rowIndex} scope_start={row.scopeStart} expected_scope={expectedScopeStarts[row.sourceIndex]} statement_start={row.statementStart} expected_statement={expectedStatementStarts[row.sourceIndex]}"
            return false
        let rootIndex = sourceScopeRootIndexes[row.sourceIndex]
        if rootIndex < 0 || row.scopeStart > sourceScopeCounts[row.sourceIndex] ||
           row.scopeCount > sourceScopeCounts[row.sourceIndex] - row.scopeStart:
            err = Fmt" compiler csg: function source slice consumer scope range invalid row={rowIndex} root={rootIndex} start={row.scopeStart} count={row.scopeCount} source_scopes={sourceScopeCounts[row.sourceIndex]}"
            return false
        for scopeOffset in 0..<row.scopeCount:
            let sourceScopeId = row.scopeStart + scopeOffset
            let scope = exprLayer.scopes[rootIndex + sourceScopeId]
            report.consumerScopeVisitCount =
                report.consumerScopeVisitCount + Int64(1)
            if scope.scopeId != sourceScopeId ||
               scope.sourcePath != reachableSet.sourcePaths[row.functionIndex] ||
               scope.parentScopeId < 0 ||
               (scope.parentScopeId != 0 &&
                (scope.parentScopeId < row.scopeStart ||
                 scope.parentScopeId >= sourceScopeId)):
                err = Fmt" compiler csg: function source slice consumer scope ownership invalid row={rowIndex} source_scope={sourceScopeId} parent={scope.parentScopeId}"
                return false
        var nextStatement = row.statementStart
        let globalExprEnd = globalExprCursor + row.exprCount
        for exprIndex in globalExprCursor..<globalExprEnd:
            let expr = exprLayer.exprs[exprIndex]
            report.consumerExprVisitCount =
                report.consumerExprVisitCount + Int64(1)
            if expr.sourcePath != reachableSet.sourcePaths[row.functionIndex] ||
               expr.lineNumber < reachableSet.startLines[row.functionIndex] ||
               expr.lineNumber > reachableSet.endLines[row.functionIndex] ||
               (expr.lexicalScopeId != 0 &&
                (expr.lexicalScopeId < row.scopeStart ||
                 expr.lexicalScopeId >= row.scopeStart + row.scopeCount)) ||
               (expr.suiteScopeId >= 0 &&
                (expr.suiteScopeId < row.scopeStart ||
                 expr.suiteScopeId >= row.scopeStart + row.scopeCount)):
                err = Fmt" compiler csg: function source slice consumer expr ownership invalid row={rowIndex} expr_index={exprIndex} line={expr.lineNumber} lexical_scope={expr.lexicalScopeId} suite_scope={expr.suiteScopeId}"
                return false
            if parser.ParserNormalizedExprKindIsSidecarStructured(expr.kind):
                if expr.statementOrdinal != nextStatement:
                    err = Fmt" compiler csg: function source slice consumer statement identity drift row={rowIndex} expr_index={exprIndex} statement={expr.statementOrdinal} expected={nextStatement}"
                    return false
                nextStatement = nextStatement + 1
                report.consumerStatementVisitCount =
                    report.consumerStatementVisitCount + Int64(1)
            elif expr.statementOrdinal >= 0 &&
                 (expr.statementOrdinal < row.statementStart ||
                  expr.statementOrdinal >= row.statementStart + row.statementCount):
                err = Fmt" compiler csg: function source slice consumer expr statement escapes row={rowIndex} expr_index={exprIndex} statement={expr.statementOrdinal}"
                return false
            if expr.deferOwnerStatementOrdinal >= 0 &&
               (expr.deferOwnerStatementOrdinal < row.statementStart ||
                expr.deferOwnerStatementOrdinal >=
                    row.statementStart + row.statementCount):
                err = Fmt" compiler csg: function source slice consumer defer owner escapes row={rowIndex} expr_index={exprIndex} owner={expr.deferOwnerStatementOrdinal}"
                return false
            if expr.kind == parser.NormalizedExprReturn &&
               (expr.valueExprRootNodeIndex < 0 ||
                expr.valueExprStatementRole ==
                    parser.ParserValueExprStatementInvalid):
                err = Fmt" compiler csg: function source slice return parser root missing row={rowIndex} expr_index={exprIndex} source={expr.sourcePath} line={expr.lineNumber}"
                return false
        if nextStatement != row.statementStart + row.statementCount:
            err = Fmt" compiler csg: function source slice consumer statement range incomplete row={rowIndex} visited={nextStatement - row.statementStart} expected={row.statementCount}"
            return false
        let rowFactCount = texpr.TypedExprPersistentFactCountForRange(
            exprLayer, globalExprCursor, globalExprEnd)
        factCount64 = factCount64 + Int64(rowFactCount)
        if factCount64 > Int64(2147483647):
            err = " compiler csg: function source slice consumer fact count overflow"
            return false
        globalExprCursor = globalExprEnd
        sourceLocalExprCursor = row.exprStart + row.exprCount
        expectedScopeStarts[row.sourceIndex] = row.scopeStart + row.scopeCount
        expectedStatementStarts[row.sourceIndex] =
            row.statementStart + row.statementCount
    if globalExprCursor != exprLayer.exprs.len:
        err = Fmt" compiler csg: function source slice consumer expr coverage incomplete visited={globalExprCursor} exprs={exprLayer.exprs.len}"
        return false
    for functionPosition in 0..<seenFunctions.len:
        if !seenFunctions[functionPosition]:
            err = Fmt" compiler csg: function source slice consumer frontier function missing position={functionPosition}"
            return false
    for sourceIndex in 0..<sourceScopeCounts.len:
        let sourceRowCount = fslice.FunctionSourceSliceIndexSourceCount(
            slices, sourceIndex)
        if sourceRowCount <= 0:
            if sourceScopeCounts[sourceIndex] != 0:
                err = Fmt" compiler csg: function source slice consumer unselected source retained scopes source_index={sourceIndex} scopes={sourceScopeCounts[sourceIndex]}"
                return false
            continue
        if sourceScopeCounts[sourceIndex] <= 0 ||
           expectedScopeStarts[sourceIndex] != sourceScopeCounts[sourceIndex]:
            err = Fmt" compiler csg: function source slice consumer scope coverage incomplete source_index={sourceIndex} visited={expectedScopeStarts[sourceIndex]} scopes={sourceScopeCounts[sourceIndex]}"
            return false
    expectedFactCount = Int32(factCount64)
    err = ""
    return true

fn CompilerCsgFunctionSourceSliceExprScratchBuild(
        slices: var fslice.FunctionSourceSliceIndex,
        rowIndex: int32,
        globalExprStart: int32,
        exprLayer: var parser.NormalizedExprLayer,
        scratch: var parser.NormalizedExprLayer,
        report: var CompilerCsgStructuredSidecarReport) =
    if report.consumerActiveSliceCount != Int64(0):
        panic("compiler csg: function source slice consumer scratch overlap")
    let row = fslice.FunctionSourceSliceIndexGetRow(slices, rowIndex)
    parser.NormalizedExprLayerReset(scratch)
    reserve(scratch.exprs, row.exprCount)
    if globalExprStart < 0 || globalExprStart > exprLayer.exprs.len ||
       row.exprCount > exprLayer.exprs.len - globalExprStart:
        panic("compiler csg: function source slice scratch global range invalid")
    for exprIndex in globalExprStart..<(globalExprStart + row.exprCount):
        add(scratch.exprs, share(exprLayer.exprs[exprIndex]))
    if row.exprCount > 0:
        scratch.sourceCount = 1
    report.consumerSliceBuildCount =
        report.consumerSliceBuildCount + Int64(1)
    report.consumerActiveSliceCount = Int64(1)
    if report.consumerActiveSlicePeakCount < Int64(1):
        report.consumerActiveSlicePeakCount = Int64(1)

fn CompilerCsgFunctionSourceSliceConsumerReleaseScratch(
        exprScratch: var parser.NormalizedExprLayer,
        factScratch: var TypedExprFactTable,
        report: var CompilerCsgStructuredSidecarReport) =
    let retainedBytes = CompilerCsgExprLayerCapacityBytesMode(
        exprScratch, true) + CompilerCsgTypedFactTableCapacityBytes(factScratch)
    if retainedBytes > report.consumerPeakCapacityBytes:
        report.consumerPeakCapacityBytes = retainedBytes
    parser.NormalizedExprLayerReset(exprScratch)
    texpr.TypedExprFactTableReset(factScratch)
    if report.consumerActiveSliceCount != Int64(1):
        panic("compiler csg: function source slice consumer scratch release mismatch")
    report.consumerActiveSliceCount = Int64(0)

@borrows
fn CompilerCsgBuildFactsForFunctionSourceSlices(
        sourceTexts: var TypedExprSourceText[],
        exprLayer: var parser.NormalizedExprLayer,
        contexts: var texpr.TypedExprSourceContext[],
        sealedIr: var texpr.TypedExprIr,
        sealedSessionMode: bool,
        reachableSet: var CompilerCsgReachableFunctionSet,
        frontierFunctionIndexes: int32[],
        slices: var fslice.FunctionSourceSliceIndex,
        exprScratch: var parser.NormalizedExprLayer,
        factScratch: var TypedExprFactTable,
        facts: var TypedExprFactTable,
        typedIrRanges: var texpr.TypedExprFunctionSourceRangeSet,
        typedIrRangeFunctionIndexes: var int32[],
        report: var CompilerCsgStructuredSidecarReport,
        sealedMetadataOperationCount: var int32,
        sealedMetadataContextCountExpected: var int32,
        sealedMetadataContextCountObserved: var int32,
        sealedMetadataRowsExpected: var int64,
        sealedMetadataRowsVisited: var int64,
        err: var str): bool =
    sealedMetadataOperationCount = 0
    sealedMetadataContextCountExpected = 0
    sealedMetadataContextCountObserved = 0
    sealedMetadataRowsExpected = Int64(0)
    sealedMetadataRowsVisited = Int64(0)
    var nextReport = report
    let rowVisitsBefore = nextReport.consumerIndexRowVisitCount
    let exprVisitsBefore = nextReport.consumerExprVisitCount
    let scopeVisitsBefore = nextReport.consumerScopeVisitCount
    let statementVisitsBefore = nextReport.consumerStatementVisitCount
    let factVisitsBefore = nextReport.consumerFactVisitCount
    let sliceBuildsBefore = nextReport.consumerSliceBuildCount
    var sourceScopeRootIndexes: int32[]
    var expectedFactCount: int32
    if !CompilerCsgFunctionSourceSliceRowsValidate(slices,
                                                   reachableSet,
                                                   frontierFunctionIndexes,
                                                   exprLayer,
                                                   nextReport,
                                                   sourceScopeRootIndexes,
                                                   expectedFactCount,
                                                   err):
        return false
    var nextFacts: TypedExprFactTable
    if !texpr.TypedExprFactTablePrepareEmptyRows(nextFacts,
                                                 expectedFactCount):
        err = " compiler csg: function source slice consumer fact reserve overflow"
        return false
    var sourceIdentityIndex: texpr.TypedExprSourceIdentityIndex
    var contextLookup: parser.ParserSourcePathIndexLookup
    if !sealedSessionMode:
        if !texpr.TypedExprBuildSourceIdentityIndex(sourceTexts,
                                                     sourceIdentityIndex,
                                                     err) ||
           !texpr.TypedExprBuildSourceContextExactIndexWithManualAuthority(
                contexts,
                exprLayer.valueExprTree,
                true,
                contextLookup,
                err):
            texpr.TypedExprFactTableRelease(nextFacts)
            return false
    var sealedFactsBatch: texpr.TypedExprSealedFactsBatch
    if sealedSessionMode:
        if !texpr.TypedExprSealedFactsBatchBegin(sourceTexts,
                                                 exprLayer,
                                                 slices.functionIndices,
                                                 reachableSet.sourcePaths,
                                                 reachableSet.startLines,
                                                 reachableSet.endLines,
                                                 reachableSet.reachable,
                                                 reachableSet.active,
                                                 sealedIr,
                                                 sealedFactsBatch,
                                                 err):
            texpr.TypedExprFactTableRelease(nextFacts)
            return false
    var reusableContext: texpr.TypedExprSourceContext
    var reusableSourceIndex: int32 = -1
    var globalExprCursor: int32
    var nextTypedIrRanges =
        texpr.TypedExprFunctionSourceRangeSetInit(slices.sourceIndices.len)
    var nextTypedIrRangeFunctionIndexes: int32[]
    reserve(nextTypedIrRangeFunctionIndexes,
            slices.sourceIndices.len)
    for rowIndex in 0..<slices.sourceIndices.len:
        let row = fslice.FunctionSourceSliceIndexGetRow(slices, rowIndex)
        let globalExprStart = globalExprCursor
        CompilerCsgFunctionSourceSliceExprScratchBuild(slices,
                                                       rowIndex,
                                                       globalExprStart,
                                                       exprLayer,
                                                       exprScratch,
                                                       nextReport)
        globalExprCursor = globalExprCursor + row.exprCount
        var rowOk = true
        if sealedSessionMode:
            rowOk = texpr.TypedExprSealedFactsBatchBuildSlice(
                sealedFactsBatch,
                share(reachableSet.sourcePaths[row.functionIndex]),
                exprScratch,
                factScratch,
                err)
        elif exprScratch.exprs.len > 0:
            if reusableSourceIndex != row.sourceIndex:
                if reusableSourceIndex >= 0:
                    texpr.TypedExprReleaseReusableFactsSourceContext(
                        reusableContext)
                    reusableSourceIndex = -1
                var sourceTextIndex: int32
                let sourcePath = reachableSet.sourcePaths[row.functionIndex]
                var functionRangeStart: int32 = -1
                var functionRangeEnd: int32 = -1
                if row.sourceIndex >= 0 &&
                   row.sourceIndex < slices.sourceStarts.len &&
                   row.sourceIndex < slices.sourceCounts.len:
                    functionRangeStart = slices.sourceStarts[row.sourceIndex]
                    functionRangeEnd = functionRangeStart +
                        slices.sourceCounts[row.sourceIndex]
                if functionRangeStart < 0 ||
                   functionRangeEnd <= functionRangeStart ||
                   functionRangeEnd > slices.functionIndices.len:
                    err = Fmt" compiler csg: function source slice union CSR missing source={sourcePath} source_index={row.sourceIndex} start={functionRangeStart} end={functionRangeEnd} rows={slices.functionIndices.len}"
                    rowOk = false
                elif !texpr.TypedExprSourceIdentityIndexFind(
                        sourceIdentityIndex,
                        sourcePath,
                        sourceTextIndex,
                        err) || sourceTextIndex < 0:
                    err = Fmt" compiler csg: function source slice consumer source text missing source={sourcePath}: {err}"
                    rowOk = false
                elif !texpr.TypedExprBuildReusableFactsSourceContext(
                        sourceTexts,
                        sourceTextIndex,
                        contexts,
                        contextLookup,
                        slices.functionIndices,
                        reachableSet.sourcePaths,
                        reachableSet.startLines,
                        reachableSet.endLines,
                        reachableSet.reachable,
                        reachableSet.active,
                        functionRangeStart,
                        functionRangeEnd,
                        reusableContext,
                        err):
                    rowOk = false
                else:
                    reusableSourceIndex = row.sourceIndex
            if rowOk:
                rowOk = texpr.TypedExprBuildFactsAppendSourceExprLayerWithContext(
                    sourceTexts,
                    contexts,
                    sourceIdentityIndex,
                    contextLookup,
                    exprScratch,
                    reusableContext,
                    factScratch,
                    err)
        else:
            texpr.TypedExprFactTableReset(factScratch)
        if !rowOk:
            if sealedSessionMode:
                texpr.TypedExprSealedFactsBatchAbort(sealedFactsBatch)
            if reusableSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(
                    reusableContext)
            CompilerCsgFunctionSourceSliceConsumerReleaseScratch(
                exprScratch, factScratch, nextReport)
            texpr.TypedExprFactTableRelease(nextFacts)
            return false
        let factPhysicalStart = nextFacts.count
        let functionIndex = row.functionIndex
        if row.sourceIndex < 0 ||
           row.sourceIndex >= sourceScopeRootIndexes.len ||
           functionIndex < 0 ||
           functionIndex >= reachableSet.sourcePaths.len ||
           functionIndex >= reachableSet.functionNames.len ||
           functionIndex >= reachableSet.startLines.len ||
           functionIndex >= reachableSet.endLines.len:
            if sealedSessionMode:
                texpr.TypedExprSealedFactsBatchAbort(sealedFactsBatch)
            if reusableSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(
                    reusableContext)
            CompilerCsgFunctionSourceSliceConsumerReleaseScratch(
                exprScratch, factScratch, nextReport)
            texpr.TypedExprFactTableRelease(nextFacts)
            err = Fmt" compiler csg: function source typed-ir range identity invalid row={rowIndex} source={row.sourceIndex} function={functionIndex}"
            return false
        texpr.TypedExprFunctionSourceRangeSetAppend(
            nextTypedIrRanges,
            reachableSet.sourcePaths[functionIndex],
            reachableSet.functionNames[functionIndex],
            reachableSet.startLines[functionIndex],
            reachableSet.endLines[functionIndex],
            0,
            0,
            sourceScopeRootIndexes[row.sourceIndex],
            globalExprStart,
            row.exprCount,
            factPhysicalStart,
            factScratch.count,
            row.scopeStart,
            row.scopeCount,
            row.statementStart,
            row.statementCount)
        add(nextTypedIrRangeFunctionIndexes, functionIndex)
        for factIndex in 0..<factScratch.count:
            texpr.TypedExprFactTableAppend(
                nextFacts, texpr.TypedExprFactAt(factScratch, factIndex))
            nextReport.consumerFactVisitCount =
                nextReport.consumerFactVisitCount + Int64(1)
        CompilerCsgFunctionSourceSliceConsumerReleaseScratch(
            exprScratch, factScratch, nextReport)
    if reusableSourceIndex >= 0:
        texpr.TypedExprReleaseReusableFactsSourceContext(reusableContext)
    texpr.TypedExprFunctionSourceRangeSetSeal(nextTypedIrRanges)
    if globalExprCursor != exprLayer.exprs.len ||
       nextTypedIrRangeFunctionIndexes.len !=
           slices.sourceIndices.len ||
       nextFacts.count != expectedFactCount ||
       texpr.TypedExprFactTablePreparedRowCapacity(nextFacts) !=
           expectedFactCount ||
       texpr.TypedExprFactTableCompactGrowCount(nextFacts) != 0 ||
       nextReport.consumerActiveSliceCount != Int64(0) ||
       nextReport.consumerActiveSlicePeakCount !=
           (slices.sourceIndices.len > 0 ? Int64(1) : Int64(0)):
        if sealedSessionMode:
            texpr.TypedExprSealedFactsBatchAbort(sealedFactsBatch)
        err = Fmt" compiler csg: function source slice consumer accounting mismatch rows={slices.sourceIndices.len} exprs={globalExprCursor}/{exprLayer.exprs.len} facts={nextFacts.count} expected_facts={expectedFactCount} active={nextReport.consumerActiveSliceCount} peak={nextReport.consumerActiveSlicePeakCount}"
        texpr.TypedExprFactTableRelease(nextFacts)
        return false
    if nextReport.consumerIndexRowVisitCount - rowVisitsBefore !=
           Int64(slices.sourceIndices.len) ||
       nextReport.consumerExprVisitCount - exprVisitsBefore !=
           Int64(slices.exprCommitVisitCount) ||
       nextReport.consumerScopeVisitCount - scopeVisitsBefore !=
           Int64(slices.scopeCommitVisitCount) ||
       nextReport.consumerStatementVisitCount - statementVisitsBefore !=
           Int64(slices.statementCommitVisitCount) ||
       nextReport.consumerFactVisitCount - factVisitsBefore !=
           Int64(expectedFactCount) ||
       nextReport.consumerSliceBuildCount - sliceBuildsBefore !=
           Int64(slices.sourceIndices.len):
        if sealedSessionMode:
            texpr.TypedExprSealedFactsBatchAbort(sealedFactsBatch)
        texpr.TypedExprFactTableRelease(nextFacts)
        err = Fmt" compiler csg: function source slice consumer linear visit contract failed row_delta={nextReport.consumerIndexRowVisitCount - rowVisitsBefore}/{slices.sourceIndices.len} expr_delta={nextReport.consumerExprVisitCount - exprVisitsBefore}/{slices.exprCommitVisitCount} scope_delta={nextReport.consumerScopeVisitCount - scopeVisitsBefore}/{slices.scopeCommitVisitCount} statement_delta={nextReport.consumerStatementVisitCount - statementVisitsBefore}/{slices.statementCommitVisitCount} fact_delta={nextReport.consumerFactVisitCount - factVisitsBefore}/{expectedFactCount} slice_delta={nextReport.consumerSliceBuildCount - sliceBuildsBefore}/{slices.sourceIndices.len}"
        return false
    if sealedSessionMode:
        let stagedMetadataContextCountExpected =
            texpr.TypedExprSealedFactsBatchMetadataContextCountExpected(
                sealedFactsBatch)
        let stagedMetadataContextCountObserved =
            texpr.TypedExprSealedFactsBatchMetadataContextCountObserved(
                sealedFactsBatch)
        let stagedMetadataRowsExpected =
            texpr.TypedExprSealedFactsBatchMetadataRowsExpected(
                sealedFactsBatch)
        let stagedMetadataRows =
            texpr.TypedExprSealedFactsBatchMetadataRowsVisited(
                sealedFactsBatch)
        let sealedFullSourceRescanCount =
            texpr.TypedExprSealedFactsBatchFullSourceRescanCount(
                sealedFactsBatch)
        let indexProducerFullTraversalCount =
            texpr.TypedExprSealedFactsBatchIndexProducerFullTraversalCount(
                sealedFactsBatch)
        let selectedLineVisitCount =
            texpr.TypedExprSealedFactsBatchSelectedLineVisitCount(
                sealedFactsBatch)
        let selectedLineBytes =
            texpr.TypedExprSealedFactsBatchSelectedLineBytes(
                sealedFactsBatch)
        let selectedScopeVisitCount =
            texpr.TypedExprSealedFactsBatchSelectedScopeVisitCount(
                sealedFactsBatch)
        let selectedBindingVisitCount =
            texpr.TypedExprSealedFactsBatchSelectedBindingVisitCount(
                sealedFactsBatch)
        let globalBindingVisitCount =
            texpr.TypedExprSealedFactsBatchGlobalBindingVisitCount(
                sealedFactsBatch)
        let peakPackedLineCount =
            texpr.TypedExprSealedFactsBatchPeakPackedLineCount(
                sealedFactsBatch)
        let peakPackedLineBytes =
            texpr.TypedExprSealedFactsBatchPeakPackedLineBytes(
                sealedFactsBatch)
        let sourceLineDomainPeak =
            texpr.TypedExprSealedFactsBatchSourceLineDomainPeak(
                sealedFactsBatch)
        let reusableContextOwnerPeak =
            texpr.TypedExprSealedFactsBatchReusableContextOwnerPeak(
                sealedFactsBatch)
        if !texpr.TypedExprMetadataVisitReceiptExact(
                stagedMetadataContextCountExpected,
                stagedMetadataContextCountObserved,
                stagedMetadataRowsExpected,
                stagedMetadataRows) ||
           stagedMetadataRowsExpected != Int64(0) ||
           stagedMetadataRows != Int64(0) ||
           indexProducerFullTraversalCount !=
               stagedMetadataContextCountObserved ||
           sealedFullSourceRescanCount != 0 ||
           selectedLineVisitCount <= Int64(0) ||
           selectedLineBytes <= Int64(0) ||
           selectedScopeVisitCount <= Int64(0) ||
           globalBindingVisitCount < Int64(0) ||
           globalBindingVisitCount > selectedBindingVisitCount ||
           peakPackedLineCount <= 0 ||
           peakPackedLineCount > selectedLineVisitCount ||
           peakPackedLineBytes <= Int64(0) ||
           peakPackedLineBytes > selectedLineBytes ||
           sourceLineDomainPeak < peakPackedLineCount ||
           reusableContextOwnerPeak != 1:
            texpr.TypedExprSealedFactsBatchAbort(sealedFactsBatch)
            texpr.TypedExprFactTableRelease(nextFacts)
            err = Fmt" compiler csg: function source slice sealed batch telemetry invalid metadata_rows_expected={stagedMetadataRowsExpected} metadata_rows={stagedMetadataRows} full_source_rescan_count={sealedFullSourceRescanCount}"
            return false
        nextReport.consumerReusableSelectedLineVisitCount =
            nextReport.consumerReusableSelectedLineVisitCount +
                selectedLineVisitCount
        nextReport.consumerReusableSelectedLineBytes =
            nextReport.consumerReusableSelectedLineBytes +
                selectedLineBytes
        nextReport.consumerReusableSelectedScopeVisitCount =
            nextReport.consumerReusableSelectedScopeVisitCount +
                selectedScopeVisitCount
        nextReport.consumerReusableSelectedBindingVisitCount =
            nextReport.consumerReusableSelectedBindingVisitCount +
                selectedBindingVisitCount
        nextReport.consumerReusableGlobalBindingVisitCount =
            nextReport.consumerReusableGlobalBindingVisitCount +
                globalBindingVisitCount
        nextReport.consumerReusableIndexProducerFullTraversalCount =
            nextReport.consumerReusableIndexProducerFullTraversalCount +
                Int64(indexProducerFullTraversalCount)
        if peakPackedLineCount >
           nextReport.consumerReusablePeakPackedLineCount:
            nextReport.consumerReusablePeakPackedLineCount =
                peakPackedLineCount
        if peakPackedLineBytes >
           nextReport.consumerReusablePeakPackedLineBytes:
            nextReport.consumerReusablePeakPackedLineBytes =
                peakPackedLineBytes
        if sourceLineDomainPeak >
           nextReport.consumerReusableSourceLineDomainPeak:
            nextReport.consumerReusableSourceLineDomainPeak =
                sourceLineDomainPeak
        if reusableContextOwnerPeak >
           nextReport.consumerReusableContextOwnerPeak:
            nextReport.consumerReusableContextOwnerPeak =
                reusableContextOwnerPeak
        texpr.TypedExprSealedFactsBatchFinish(sourceTexts,
                                              sealedFactsBatch,
                                              sealedMetadataRowsVisited)
        if sealedMetadataRowsVisited != stagedMetadataRows:
            panic("compiler csg: function source slice sealed batch telemetry drift")
        sealedMetadataContextCountExpected =
            stagedMetadataContextCountExpected
        sealedMetadataContextCountObserved =
            stagedMetadataContextCountObserved
        sealedMetadataRowsExpected = stagedMetadataRowsExpected
        sealedMetadataOperationCount = 1
    CompilerCsgNormalizedExprLayerTerminalRelease(exprScratch)
    CompilerCsgTypedFactTableTerminalRelease(factScratch)
    texpr.TypedExprFactTableRelease(facts)
    texpr.TypedExprFactTableMoveInto(facts, nextFacts)
    typedIrRanges = nextTypedIrRanges
    typedIrRangeFunctionIndexes =
        nextTypedIrRangeFunctionIndexes
    nextReport.consumerRoundCount = nextReport.consumerRoundCount + Int64(1)
    report = nextReport
    err = ""
    return true

@borrows
fn CompilerCsgSemanticAppendUnprocessedFrontierFacts(semanticGraph: var CompilerCsgSemanticGraph,
                                                accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                                sourceIndexCache: var CompilerCsgSourcePathIndex,
                                                reachableSet: var CompilerCsgReachableFunctionSet,
                                                frontierFunctionIndexes: int32[],
                                                frontierIndex: var CompilerCsgFrontierIndex,
                                                fullExprLayer: var parser.NormalizedExprLayer,
                                                functionSlices: var fslice.FunctionSourceSliceIndex,
                                                facts: var TypedExprFactTable,
                                                functionProcessed: var bool[],
                                                sourceCounted: var bool[],
                                                err: var str): bool =
    if functionProcessed.len != reachableSet.functionNames.len ||
       sourceCounted.len != semanticGraph.sourceTable.sourcePaths.len:
        err = Fmt" compiler csg: frontier ownership columns mismatch processed={functionProcessed.len} functions={reachableSet.functionNames.len} source_counted={sourceCounted.len} sources={semanticGraph.sourceTable.sourcePaths.len}"
        return false
    var initialValidationVisits: int64
    if !CompilerCsgSemanticTypedFactAccumulatorStateValidate(semanticGraph,
                                                       accumulator,
                                                       reachableSet,
                                                       initialValidationVisits,
                                                       err):
        return false
    var frontierValidationStagedCapacity: int64
    let frontierAuditNeeded = frontierIndex.domainVersion <= Int64(0) ||
                              frontierIndex.sealedDomainVersion !=
                                  frontierIndex.domainVersion
    if !CompilerCsgFrontierIndexValidate(frontierIndex,
                                         reachableSet,
                                         frontierValidationStagedCapacity,
                                         err):
        return false
    let frontierCertificateStagingBytes = frontierAuditNeeded ?
        CompilerCsgFrontierIndexCertificateCapacityBytes(frontierIndex) :
        Int64(0)
    var frontierCertificateValidationCount: int64
    if !CompilerCsgFrontierTouchedDomainValidate(frontierIndex,
                                                 frontierCertificateValidationCount,
                                                 err):
        return false
    var sortingScratchBytes: int64
    var sortedFrontierFunctionIndexes =
        CompilerCsgSortedUniqueFunctionIndexesMeasured(frontierFunctionIndexes,
                                                       functionProcessed.len,
                                                       sortingScratchBytes,
                                                       err)
    if err != "":
        return false
    var canonicalSortingScratchBytes: int64
    if !CompilerCsgSortFrontierSliceFunctions(sortedFrontierFunctionIndexes,
                                               reachableSet,
                                               canonicalSortingScratchBytes,
                                               err):
        return false
    var stagedExprStarts: int32[]
    var stagedExprEnds: int32[]
    var stagedFactStarts: int32[]
    var stagedFactEnds: int32[]
    var stagedSemanticDigestStates: int64[]
    var stagedSemanticFactCounts: int32[]
    for frontierItemIndex in 0..<sortedFrontierFunctionIndexes.len:
        add(stagedExprStarts, -1)
        add(stagedExprEnds, -1)
        add(stagedFactStarts, -1)
        add(stagedFactEnds, -1)
        add(stagedSemanticDigestStates,
            CompilerCsgTypedFactSemanticDigestSeed())
        add(stagedSemanticFactCounts, 0)
    var transaction = CompilerCsgSemanticTypedFactTransactionInit()
    transaction.stateValidated = true
    transaction.validationFullRowVisitCount = initialValidationVisits
    var frontierValidationPhase: CompilerCsgStagingCapacityLedger
    frontierValidationPhase.validationBytes = frontierValidationStagedCapacity +
                                              frontierCertificateStagingBytes
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger,
                                                frontierValidationPhase)
    var sortingPhase: CompilerCsgStagingCapacityLedger
    sortingPhase.sortingBytes = CompilerCsgSequenceHeaderBytes() * Int64(2) +
                                sortingScratchBytes +
                                canonicalSortingScratchBytes +
                                Int64(sortedFrontierFunctionIndexes.cap) *
                                    CompilerCsgI32Bytes()
    sortingPhase.validationBytes = frontierCertificateStagingBytes
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger, sortingPhase)
    var nextExprSummary = semanticGraph.exprSummary
    var plannedNewSourceIndex: CompilerCsgSparseIntIndex
    var plannedFunctionIndexes: int32[]
    var plannedSourceIndexes: int32[]
    var plannedSourcePaths: str[]
    var plannedExprStarts: int32[]
    var plannedExprCounts: int32[]
    var plannedTransactionStarts: int32[]
    var plannedTransactionEnds: int32[]
    var plannedSemanticDigests: int64[]
    var stagedFunctionLayerMaxCapacity: int32
    if !fslice.FunctionSourceSliceIndexContentCertificateMatches(
            functionSlices):
        err = " compiler csg: indexed frontier sealed content certificate mismatch"
        return false
    fslice.FunctionSourceSliceIndexRequireParentValidationComplete(functionSlices)
    if !functionSlices.sealed || functionSlices.released ||
       functionSlices.sourceIndices.len !=
           sortedFrontierFunctionIndexes.len:
        err = Fmt" compiler csg: indexed frontier slice authority invalid sealed={functionSlices.sealed} released={functionSlices.released} rows={functionSlices.sourceIndices.len} frontier={sortedFrontierFunctionIndexes.len}"
        return false
    var indexedFactCursor: int32
    var indexedExprCursor: int32
    var indexedSourceIndex: int32 = -1
    var indexedSourceExprCursor: int32
    var indexedRowsSeen: bool[]
    setLen(indexedRowsSeen, sortedFrontierFunctionIndexes.len)
    let semanticRowVisitsBefore =
        frontierIndex.lastStructuredSidecar.consumerSemanticIndexRowVisitCount
    let semanticExprVisitsBefore =
        frontierIndex.lastStructuredSidecar.consumerSemanticExprVisitCount
    let semanticFactVisitsBefore =
        frontierIndex.lastStructuredSidecar.consumerSemanticFactVisitCount
    for rowIndex in 0..<functionSlices.sourceIndices.len:
        let row = fslice.FunctionSourceSliceIndexGetRow(functionSlices,
                                                         rowIndex)
        if rowIndex >= sortedFrontierFunctionIndexes.len ||
           row.functionIndex != sortedFrontierFunctionIndexes[rowIndex]:
            err = Fmt" compiler csg: indexed frontier canonical order mismatch row={rowIndex} observed={row.functionIndex} expected={rowIndex < sortedFrontierFunctionIndexes.len ? sortedFrontierFunctionIndexes[rowIndex] : -1}"
            return false
        if row.sourceIndex != indexedSourceIndex:
            if row.sourceIndex <= indexedSourceIndex:
                err = Fmt" compiler csg: indexed frontier source order invalid row={rowIndex} source={row.sourceIndex} previous={indexedSourceIndex}"
                return false
            indexedSourceIndex = row.sourceIndex
            indexedSourceExprCursor = 0
        let frontierPosition = CompilerCsgSortedFunctionIndexPosition(
            sortedFrontierFunctionIndexes, row.functionIndex)
        if frontierPosition < 0 ||
           indexedRowsSeen[frontierPosition] ||
           row.exprStart != indexedSourceExprCursor || row.exprCount < 0 ||
           indexedExprCursor > fullExprLayer.exprs.len ||
           row.exprCount > fullExprLayer.exprs.len - indexedExprCursor:
            err = Fmt" compiler csg: indexed frontier expr row invalid row={rowIndex} function_index={row.functionIndex} local_start={row.exprStart} count={row.exprCount} expected_local_start={indexedSourceExprCursor} global_start={indexedExprCursor}"
            return false
        indexedRowsSeen[frontierPosition] = true
        if row.exprCount > 0:
            stagedExprStarts[frontierPosition] = indexedExprCursor
            stagedExprEnds[frontierPosition] =
                indexedExprCursor + row.exprCount
        frontierIndex.lastStructuredSidecar.consumerSemanticIndexRowVisitCount =
            frontierIndex.lastStructuredSidecar.consumerSemanticIndexRowVisitCount +
                Int64(1)
        frontierIndex.lastStructuredSidecar.consumerSemanticExprVisitCount =
            frontierIndex.lastStructuredSidecar.consumerSemanticExprVisitCount +
                Int64(row.exprCount)
        let rowFactCount = texpr.TypedExprPersistentFactCountForRange(
            fullExprLayer,
            indexedExprCursor,
            indexedExprCursor + row.exprCount)
        if rowFactCount < 0 || indexedFactCursor > facts.count ||
           rowFactCount > facts.count - indexedFactCursor:
            err = Fmt" compiler csg: indexed frontier fact row invalid row={rowIndex} fact_start={indexedFactCursor} fact_count={rowFactCount} facts={facts.count}"
            return false
        if rowFactCount > 0:
            stagedFactStarts[frontierPosition] = indexedFactCursor
            stagedFactEnds[frontierPosition] =
                indexedFactCursor + rowFactCount
        for factIndex in indexedFactCursor..<(indexedFactCursor + rowFactCount):
            let fact = texpr.TypedExprFactAt(facts, factIndex)
            if fact.sourcePath != reachableSet.sourcePaths[row.functionIndex] ||
               fact.lineNumber < reachableSet.startLines[row.functionIndex] ||
               fact.lineNumber > reachableSet.endLines[row.functionIndex]:
                err = Fmt" compiler csg: indexed frontier fact ownership invalid row={rowIndex} fact_index={factIndex} function_index={row.functionIndex} source={fact.sourcePath} line={fact.lineNumber}"
                return false
            stagedSemanticDigestStates[frontierPosition] =
                CompilerCsgTypedFactSemanticDigestUpdate(
                    stagedSemanticDigestStates[frontierPosition],
                    fact)
            stagedSemanticFactCounts[frontierPosition] =
                stagedSemanticFactCounts[frontierPosition] + 1
            frontierIndex.lastStructuredSidecar.consumerSemanticFactVisitCount =
                frontierIndex.lastStructuredSidecar.consumerSemanticFactVisitCount +
                    Int64(1)
        indexedFactCursor = indexedFactCursor + rowFactCount
        indexedExprCursor = indexedExprCursor + row.exprCount
        indexedSourceExprCursor = row.exprStart + row.exprCount
    if indexedExprCursor != fullExprLayer.exprs.len ||
       indexedFactCursor != facts.count:
        err = Fmt" compiler csg: indexed frontier coverage incomplete exprs={indexedExprCursor}/{fullExprLayer.exprs.len} facts={indexedFactCursor}/{facts.count}"
        return false
    if frontierIndex.lastStructuredSidecar.consumerSemanticIndexRowVisitCount -
           semanticRowVisitsBefore != Int64(functionSlices.sourceIndices.len) ||
       frontierIndex.lastStructuredSidecar.consumerSemanticExprVisitCount -
           semanticExprVisitsBefore != Int64(fullExprLayer.exprs.len) ||
       frontierIndex.lastStructuredSidecar.consumerSemanticFactVisitCount -
           semanticFactVisitsBefore != Int64(facts.count):
        err = Fmt" compiler csg: indexed frontier linear visit contract failed rows={frontierIndex.lastStructuredSidecar.consumerSemanticIndexRowVisitCount - semanticRowVisitsBefore}/{functionSlices.sourceIndices.len} exprs={frontierIndex.lastStructuredSidecar.consumerSemanticExprVisitCount - semanticExprVisitsBefore}/{fullExprLayer.exprs.len} facts={frontierIndex.lastStructuredSidecar.consumerSemanticFactVisitCount - semanticFactVisitsBefore}/{facts.count}"
        return false
    var stagedFunctionLayer: parser.NormalizedExprLayer
    for frontierItemIndex in 0..<functionSlices.functionIndices.len:
        let functionIndex = functionSlices.functionIndices[frontierItemIndex]
        if !CompilerCsgFrontierFunctionRowValidate(frontierIndex,
                                                    functionIndex,
                                                    frontierCertificateValidationCount,
                                                    err):
            return false
        let frontierPosition =
            CompilerCsgSortedFunctionIndexPosition(sortedFrontierFunctionIndexes,
                                                   functionIndex)
        if frontierPosition < 0:
            panic("compiler csg: staged frontier function disappeared")
        let exprRangeStart = stagedExprStarts[frontierPosition]
        let exprRangeEnd = stagedExprEnds[frontierPosition]
        if (exprRangeStart < 0 && exprRangeEnd >= 0) ||
           (exprRangeStart >= 0 &&
            (exprRangeEnd < exprRangeStart || exprRangeEnd > fullExprLayer.exprs.len)):
            err = Fmt" compiler csg: frontier expr adjacency range invalid function_index={functionIndex} start={exprRangeStart} end={exprRangeEnd} expr_count={fullExprLayer.exprs.len}"
            return false
        let factRangeStart = stagedFactStarts[frontierPosition]
        let factRangeEnd = stagedFactEnds[frontierPosition]
        if (factRangeStart < 0 && factRangeEnd >= 0) ||
           (factRangeStart >= 0 &&
            (factRangeEnd < factRangeStart || factRangeEnd > facts.count)):
            err = Fmt" compiler csg: frontier fact adjacency range invalid function_index={functionIndex} start={factRangeStart} end={factRangeEnd} fact_count={facts.count}"
            return false
        let roundSemanticDigest =
            CompilerCsgTypedFactSemanticDigestFinalize(
                stagedSemanticDigestStates[frontierPosition],
                stagedSemanticFactCounts[frontierPosition])
        if functionProcessed[functionIndex]:
            if functionIndex >= semanticGraph.exprSliceTable.functionSliceIndexes.len:
                err = Fmt" compiler csg: semantic slice map missing function_index={functionIndex}"
                return false
            let existingSliceIndex =
                semanticGraph.exprSliceTable.functionSliceIndexes[functionIndex]
            if existingSliceIndex < 0 ||
               existingSliceIndex >=
                   semanticGraph.exprSliceTable.typedFactSemanticDigests.len:
                err = Fmt" compiler csg: semantic slice missing function_index={functionIndex} slice_index={existingSliceIndex}"
                return false
            if semanticGraph.exprSliceTable.typedFactSemanticDigests[existingSliceIndex] !=
               roundSemanticDigest:
                err = Fmt" compiler csg: typed-fact semantic drift function_index={functionIndex} slice_index={existingSliceIndex}"
                return false
            continue
        if functionIndex >= reachableSet.sourcePaths.len:
            err = Fmt" compiler csg: frontier function source missing index={functionIndex}"
            return false
        let sourcePath = reachableSet.sourcePaths[functionIndex]
        let sourceIndex = CompilerCsgSemanticFindSourceIndex(sourceIndexCache,
                                                       sourcePath)
        if sourceIndex < 0 || sourceIndex >= sourceCounted.len:
            err = Fmt" compiler csg: frontier source missing source={sourcePath} function_index={functionIndex} source_index={sourceIndex} source_count={sourceCounted.len}"
            return false
        parser.NormalizedExprLayerReset(stagedFunctionLayer)
        if exprRangeStart >= 0:
            for exprIndex in exprRangeStart..<exprRangeEnd:
                add(stagedFunctionLayer.exprs,
                    share(fullExprLayer.exprs[exprIndex]))
        if stagedFunctionLayer.exprs.cap > stagedFunctionLayerMaxCapacity:
            stagedFunctionLayerMaxCapacity = stagedFunctionLayer.exprs.cap
        if stagedFunctionLayer.exprs.len > 0 && !sourceCounted[sourceIndex]:
            if CompilerCsgSparseIntIndexFind(plannedNewSourceIndex,
                                             sourceIndex) < 0:
                stagedFunctionLayer.sourceCount = 1
                let _ = CompilerCsgSparseIntIndexEnsure(plannedNewSourceIndex,
                                                        sourceIndex)
        let exprStart = nextExprSummary.exprCount
        CompilerCsgSemanticAccumulateExprSummary(nextExprSummary, stagedFunctionLayer)
        var factStart = factRangeStart
        var factEnd = factRangeEnd
        if factStart < 0:
            factStart = 0
            factEnd = 0
        let transactionStart = transaction.factIndexes.len
        var validatedSemanticDigest: int64
        if !CompilerCsgSemanticTypedFactTransactionValidateRange(semanticGraph,
                                                           accumulator,
                                                           sourceIndexCache,
                                                           reachableSet,
                                                           functionIndex,
                                                           facts,
                                                           factStart,
                                                           factEnd,
                                                           transaction,
                                                           validatedSemanticDigest,
                                                           err):
            parser.NormalizedExprLayerReset(stagedFunctionLayer)
            return false
        if validatedSemanticDigest != roundSemanticDigest:
            panic("compiler csg: staged semantic digest drift")
        add(plannedFunctionIndexes, functionIndex)
        add(plannedSourceIndexes, sourceIndex)
        add(plannedSourcePaths, share(sourcePath))
        add(plannedExprStarts, exprStart)
        add(plannedExprCounts, stagedFunctionLayer.exprs.len)
        add(plannedTransactionStarts, transactionStart)
        add(plannedTransactionEnds, transaction.factIndexes.len)
        add(plannedSemanticDigests, roundSemanticDigest)
    parser.NormalizedExprLayerReset(stagedFunctionLayer)

    var frontierPhase: CompilerCsgStagingCapacityLedger
    frontierPhase.validationBytes = frontierCertificateStagingBytes
    frontierPhase.sortingBytes = CompilerCsgSequenceHeaderBytes() +
        Int64(sortedFrontierFunctionIndexes.cap) * CompilerCsgI32Bytes()
    frontierPhase.sparseIndexBytes =
        CompilerCsgSparseIntIndexCapacityBytes(plannedNewSourceIndex)
    frontierPhase.frontierSelectionBytes =
        CompilerCsgSequenceHeaderBytes() * Int64(14) +
        Int64(stagedExprStarts.cap + stagedExprEnds.cap +
              stagedFactStarts.cap + stagedFactEnds.cap +
              stagedSemanticFactCounts.cap +
              plannedFunctionIndexes.cap + plannedSourceIndexes.cap +
              plannedExprStarts.cap + plannedExprCounts.cap +
              plannedTransactionStarts.cap + plannedTransactionEnds.cap) *
            CompilerCsgI32Bytes() +
        Int64(stagedSemanticDigestStates.cap +
              plannedSemanticDigests.cap) * Int64(8) +
        Int64(plannedSourcePaths.cap) * CompilerCsgStrHeaderBytes()
    frontierPhase.frontierOutputBytes =
        CompilerCsgExprLayerCapacityBytesMode(stagedFunctionLayer, false)
    frontierPhase.frontierOutputPrimaryOwnsStringPayload = false
    frontierPhase.frontierOutputScratchOwnsStringPayload = false
    if stagedFunctionLayerMaxCapacity > stagedFunctionLayer.exprs.cap:
        frontierPhase.frontierOutputBytes = frontierPhase.frontierOutputBytes +
            Int64(stagedFunctionLayerMaxCapacity - stagedFunctionLayer.exprs.cap) *
                CompilerCsgExprRowBytes()
    frontierPhase.typedFactTransactionBytes =
        CompilerCsgSemanticTypedFactTransactionCapacityBytes(transaction)
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger,
                                                frontierPhase)
    var stagingLedgerErr: str
    if !CompilerCsgStagingCapacityLedgerValidate(transaction.ledger,
                                                  stagingLedgerErr):
        err = stagingLedgerErr
        return false

    # All recoverable checks ended above. The commit section contains only
    # deterministic appends/assignments; allocation failure is process-fatal.
    semanticGraph.exprSummary = nextExprSummary
    for plannedIndex in 0..<plannedFunctionIndexes.len:
        let typedFactStart = CompilerCsgSemanticTypedFactCount(semanticGraph)
        CompilerCsgSemanticTypedFactTransactionCommitRange(semanticGraph,
                                                     accumulator,
                                                     facts,
                                                     transaction,
                                                     plannedTransactionStarts[plannedIndex],
                                                     plannedTransactionEnds[plannedIndex])
        let appendedFactCount = CompilerCsgSemanticTypedFactCount(semanticGraph) - typedFactStart
        CompilerCsgSemanticAppendExprSlice(semanticGraph,
                                     plannedSourceIndexes[plannedIndex],
                                     share(plannedSourcePaths[plannedIndex]),
                                     plannedFunctionIndexes[plannedIndex],
                                     plannedExprStarts[plannedIndex],
                                     plannedExprCounts[plannedIndex],
                                     typedFactStart,
                                     appendedFactCount,
                                     plannedSemanticDigests[plannedIndex])
    CompilerCsgReachabilityProbeDeltaCommit(reachableSet,
                                            transaction.reachabilityProbeDelta)
    CompilerCsgSemanticTypedFactTransactionCommitMetrics(accumulator,
                                                    transaction)
    for plannedIndex in 0..<plannedFunctionIndexes.len:
        functionProcessed[plannedFunctionIndexes[plannedIndex]] = true
    for plannedSourceIndex in 0..<plannedNewSourceIndex.keys.len:
        sourceCounted[plannedNewSourceIndex.keys[plannedSourceIndex]] = true
    CompilerCsgFrontierIndexBegin(frontierIndex,
                                  reachableSet.profileFunctionStarts.len,
                                  functionProcessed.len)
    for frontierItemIndex in 0..<functionSlices.functionIndices.len:
        let functionIndex = functionSlices.functionIndices[frontierItemIndex]
        let frontierPosition =
            CompilerCsgSortedFunctionIndexPosition(sortedFrontierFunctionIndexes,
                                                   functionIndex)
        if frontierPosition < 0:
            panic("compiler csg: committed frontier function disappeared")
        frontierIndex.functionSelected[functionIndex] = true
        add(frontierIndex.touchedFunctions, functionIndex)
        add(frontierIndex.touchedFunctionListCertificates,
            CompilerCsgFrontierTouchedFunctionListCertificate(
                frontierIndex.touchedFunctions.len - 1,
                functionIndex))
        frontierIndex.exprStarts[functionIndex] = stagedExprStarts[frontierPosition]
        frontierIndex.exprEnds[functionIndex] = stagedExprEnds[frontierPosition]
        frontierIndex.factStarts[functionIndex] = stagedFactStarts[frontierPosition]
        frontierIndex.factEnds[functionIndex] = stagedFactEnds[frontierPosition]
        frontierIndex.functionRowCertificates[functionIndex] =
            CompilerCsgFrontierFunctionRowCertificate(frontierIndex,
                                                      functionIndex)
    frontierIndex.certificateBuildOperationCount =
        frontierIndex.certificateBuildOperationCount +
            Int64(functionSlices.functionIndices.len) * Int64(2)
    frontierIndex.certificateValidationOperationCount =
        frontierIndex.certificateValidationOperationCount +
            frontierCertificateValidationCount
    CompilerCsgFrontierIndexCommitDomainVersion(frontierIndex)
    err = ""
    return true

@borrows
fn CompilerCsgParserReceiptFunctionIdentity(
        reachableSet: var CompilerCsgReachableFunctionSet,
        orderedSources: str[],
        orderedSourceModules: str[],
        functionIndex: int32,
        out: var parser_receipt.ParserNormalizedExprFunctionIdentity,
        err: var str): bool =
    if functionIndex < 0 || functionIndex >= reachableSet.functionNames.len ||
       functionIndex >= reachableSet.producerSourceIndexes.len ||
       functionIndex >= reachableSet.producerDeclarationIndexes.len ||
       functionIndex >= reachableSet.sourcePaths.len ||
       functionIndex >= reachableSet.startLines.len ||
       functionIndex >= reachableSet.endLines.len:
        err = Fmt" compiler csg: parser receipt function identity row missing function_index={functionIndex}"
        return false
    let sourceIndex = reachableSet.producerSourceIndexes[functionIndex]
    if sourceIndex < 0 || sourceIndex >= orderedSources.len ||
       sourceIndex >= orderedSourceModules.len ||
       reachableSet.producerDeclarationIndexes[functionIndex] < 0 ||
       reachableSet.functionProfileIndexes[functionIndex] != sourceIndex ||
       reachableSet.sourcePaths[functionIndex] != orderedSources[sourceIndex] ||
       orderedSourceModules[sourceIndex] == "":
        err = Fmt" compiler csg: parser receipt source identity mismatch function_index={functionIndex} source_index={sourceIndex}"
        return false
    out = parser_receipt.ParserNormalizedExprFunctionIdentityMake(
        sourceIndex,
        functionIndex,
        orderedSources[sourceIndex],
        orderedSourceModules[sourceIndex],
        reachableSet.functionNames[functionIndex],
        reachableSet.startLines[functionIndex],
        reachableSet.endLines[functionIndex])
    err = ""
    return true

fn CompilerCsgReachableFunctionIndexForProducer(
        reachableSet: var CompilerCsgReachableFunctionSet,
        producerSourceIndex: int32,
        producerDeclarationIndex: int32): int32 =
    if producerSourceIndex < 0 ||
       producerSourceIndex >= reachableSet.profileFunctionStarts.len ||
       producerSourceIndex >= reachableSet.profileFunctionCounts.len ||
       producerDeclarationIndex < 0:
        return -1
    let start = reachableSet.profileFunctionStarts[producerSourceIndex]
    let count = reachableSet.profileFunctionCounts[producerSourceIndex]
    if start < 0 || count <= 0 ||
       start > reachableSet.producerDeclarationIndexes.len - count ||
       start > reachableSet.producerSourceIndexes.len - count:
        return -1
    var low = start
    var high = start + count
    while low < high:
        let middle = low + (high - low) / 2
        if reachableSet.producerDeclarationIndexes[middle] <
               producerDeclarationIndex:
            low = middle + 1
        else:
            high = middle
    if low < start + count &&
       reachableSet.producerSourceIndexes[low] == producerSourceIndex &&
       reachableSet.producerDeclarationIndexes[low] ==
           producerDeclarationIndex:
        return low
    return -1

@borrows
fn CompilerCsgReachableBindParserSidecarProfile(
        reachableSet: var CompilerCsgReachableFunctionSet,
        producerSourceIndex: int32,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        err: var str): bool =
    var sidecarErr: str
    if !parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
           sidecar, sidecarErr):
        err = Fmt" compiler csg: parser provenance sidecar invalid source_index={producerSourceIndex}: {sidecarErr}"
        return false
    if producerSourceIndex < 0 ||
       producerSourceIndex >= reachableSet.profileFunctionStarts.len ||
       producerSourceIndex >= reachableSet.profileFunctionCounts.len ||
       sidecar.sourceIndex != producerSourceIndex:
        err = Fmt" compiler csg: parser provenance source mismatch expected={producerSourceIndex} actual={sidecar.sourceIndex}"
        return false
    let functionStart =
        reachableSet.profileFunctionStarts[producerSourceIndex]
    let functionCount =
        reachableSet.profileFunctionCounts[producerSourceIndex]
    if functionStart < 0 || functionCount < 0 ||
       sidecar.functionIndexes.len != functionCount ||
       sidecar.functionDeclarationOrdinals.len != functionCount ||
       sidecar.functionNameSurfaceKinds.len != functionCount ||
       sidecar.functionNameProofCids.len != functionCount ||
       sidecar.functionAnnotationFlags.len != functionCount ||
       sidecar.functionDeclarationHeaderCids.len != functionCount ||
       sidecar.functionDeclarationPathCids.len != functionCount:
        err = Fmt" compiler csg: parser provenance profile coverage mismatch source_index={producerSourceIndex} functions={functionCount} sidecar={sidecar.functionIndexes.len}"
        return false
    var stagedSurfaceKinds: int32[]
    var stagedProofCids: layout.FixedBytes32[]
    var stagedAnnotationFlags: int32[]
    var stagedDeclarationHeaderCids: layout.FixedBytes32[]
    var stagedDeclarationPathCids: layout.FixedBytes32[]
    var stagedKeepExportBindingCids: layout.FixedBytes32[]
    var seen: bool[]
    setLen(seen, functionCount)
    for sidecarRow in 0..<functionCount:
        let declarationIndex =
            sidecar.functionDeclarationOrdinals[sidecarRow]
        let functionIndex = CompilerCsgReachableFunctionIndexForProducer(
            reachableSet, producerSourceIndex, declarationIndex)
        let sidecarFunctionIndex = sidecar.functionIndexes[sidecarRow]
        let localFunctionIndex = functionIndex - functionStart
        let surfaceKind = sidecar.functionNameSurfaceKinds[sidecarRow]
        let proofCid = layout.FixedBytes32Copy(
            sidecar.functionNameProofCids[sidecarRow])
        let annotationFlags =
            sidecar.functionAnnotationFlags[sidecarRow]
        let declarationHeaderCid = layout.FixedBytes32Copy(
            sidecar.functionDeclarationHeaderCids[sidecarRow])
        let declarationPathCid = layout.FixedBytes32Copy(
            sidecar.functionDeclarationPathCids[sidecarRow])
        let keepExportBinding =
            (annotationFlags &
                parser.ParserFunctionAnnotationKeepExportBinding) != 0
        if functionIndex < functionStart ||
           functionIndex >= functionStart + functionCount ||
           sidecarFunctionIndex != functionIndex ||
           localFunctionIndex < 0 || localFunctionIndex >= seen.len ||
           seen[localFunctionIndex] ||
           reachableSet.producerSourceIndexes[functionIndex] !=
               producerSourceIndex ||
           reachableSet.producerDeclarationIndexes[functionIndex] !=
               declarationIndex ||
           reachableSet.functionNames[functionIndex] !=
               sidecar.functionNames[sidecarRow] ||
           reachableSet.startLines[functionIndex] !=
               sidecar.functionSignatureLineNumbers[sidecarRow] ||
           (surfaceKind !=
                parser_receipt.ParserFunctionNameSurfaceIdentifier &&
            surfaceKind !=
                parser_receipt.ParserFunctionNameSurfaceBacktick) ||
           layout.FixedBytes32Equal(proofCid, layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               declarationHeaderCid, layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               declarationPathCid, layout.FixedBytes32()) ||
           !parser.ParserNormalizedFunctionAnnotationFlagsValid(
               annotationFlags) ||
           (keepExportBinding &&
            !reachableSet.exportNameExplicitFlags[functionIndex]):
            err = Fmt" compiler csg: parser provenance row mismatch source_index={producerSourceIndex} sidecar_row={sidecarRow} declaration_index={declarationIndex} function_index={functionIndex} sidecar_function_index={sidecarFunctionIndex}"
            return false
        var keepExportBindingCid: layout.FixedBytes32
        if keepExportBinding:
            keepExportBindingCid = CompilerCsgKeepExportBindingCid(
                functionIndex,
                producerSourceIndex,
                declarationIndex,
                annotationFlags,
                declarationHeaderCid,
                declarationPathCid,
                proofCid)
        seen[localFunctionIndex] = true
        add(stagedSurfaceKinds, surfaceKind)
        add(stagedProofCids, proofCid)
        add(stagedAnnotationFlags, annotationFlags)
        add(stagedDeclarationHeaderCids, declarationHeaderCid)
        add(stagedDeclarationPathCids, declarationPathCid)
        add(stagedKeepExportBindingCids, keepExportBindingCid)
    for localFunctionIndex in 0..<seen.len:
        if !seen[localFunctionIndex]:
            err = Fmt" compiler csg: parser provenance function missing source_index={producerSourceIndex} local_function={localFunctionIndex}"
            return false
    for sidecarRow in 0..<functionCount:
        let functionIndex = sidecar.functionIndexes[sidecarRow]
        if functionIndex < 0 ||
           functionIndex >= reachableSet.functionRowCertificates.len ||
           reachableSet.functionRowCertificates[functionIndex] !=
               CompilerCsgReachableFunctionRowCertificate(
                   reachableSet, functionIndex):
            err = Fmt" compiler csg: parser provenance function certificate mismatch function_index={functionIndex}"
            return false
        let existingSurface =
            reachableSet.functionNameSurfaceKinds[functionIndex]
        let existingProof =
            reachableSet.functionNameProofCids[functionIndex]
        let existingAnnotationFlags =
            reachableSet.functionAnnotationFlags[functionIndex]
        if existingSurface != 0 &&
           (existingSurface != stagedSurfaceKinds[sidecarRow] ||
            !layout.FixedBytes32Equal(
                existingProof, stagedProofCids[sidecarRow]) ||
            existingAnnotationFlags !=
                stagedAnnotationFlags[sidecarRow] ||
            !layout.FixedBytes32Equal(
                reachableSet.functionDeclarationHeaderCids[
                    functionIndex],
                stagedDeclarationHeaderCids[sidecarRow]) ||
            !layout.FixedBytes32Equal(
                reachableSet.functionDeclarationPathCids[
                    functionIndex],
                stagedDeclarationPathCids[sidecarRow]) ||
            !layout.FixedBytes32Equal(
                reachableSet.keepExportBindingCids[functionIndex],
                stagedKeepExportBindingCids[sidecarRow])):
            err = Fmt" compiler csg: parser provenance rebind mismatch function_index={functionIndex}"
            return false
    var mutated = false
    for sidecarRow in 0..<functionCount:
        let functionIndex = sidecar.functionIndexes[sidecarRow]
        if reachableSet.functionNameSurfaceKinds[functionIndex] != 0:
            continue
        let oldCertificate =
            reachableSet.functionRowCertificates[functionIndex]
        reachableSet.functionNameSurfaceKinds[functionIndex] =
            stagedSurfaceKinds[sidecarRow]
        reachableSet.functionNameProofCids[functionIndex] =
            stagedProofCids[sidecarRow]
        reachableSet.functionAnnotationFlags[functionIndex] =
            stagedAnnotationFlags[sidecarRow]
        reachableSet.functionDeclarationHeaderCids[functionIndex] =
            stagedDeclarationHeaderCids[sidecarRow]
        reachableSet.functionDeclarationPathCids[functionIndex] =
            stagedDeclarationPathCids[sidecarRow]
        reachableSet.keepExportBindingCids[functionIndex] =
            stagedKeepExportBindingCids[sidecarRow]
        let newCertificate = CompilerCsgReachableFunctionRowCertificate(
            reachableSet, functionIndex)
        reachableSet.functionRowCertificates[functionIndex] = newCertificate
        CompilerCsgReachableCertificateAggregateReplace(
            reachableSet.structureContentCertificate,
            2,
            functionIndex,
            oldCertificate,
            newCertificate)
        reachableSet.certificateBuildOperationCount =
            reachableSet.certificateBuildOperationCount + Int64(1)
        mutated = true
    if mutated:
        reachableSet.structureVersion =
            reachableSet.structureVersion + Int64(1)
        CompilerCsgReachableFunctionSetCommitSeal(reachableSet)
    err = ""
    return true

fn CompilerCsgReachableParserProvenanceStrictValidateInto(
        reachableSet: var CompilerCsgReachableFunctionSet,
        accumulator: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        err: var str): bool =
    if accumulator.sourceSidecars.len !=
           reachableSet.profileFunctionStarts.len ||
       accumulator.sourceSidecarPresent.len !=
           accumulator.sourceSidecars.len:
        err = " compiler csg: parser provenance source coverage mismatch"
        return false
    for sourceIndex in 0..<accumulator.sourceSidecars.len:
        if !accumulator.sourceSidecarPresent[sourceIndex] ||
           !CompilerCsgReachableBindParserSidecarProfile(
               reachableSet,
               sourceIndex,
               accumulator.sourceSidecars[sourceIndex],
               err):
            if err == "":
                err = Fmt" compiler csg: parser provenance source missing source_index={sourceIndex}"
            return false
    for functionIndex in 0..<reachableSet.functionNames.len:
        let annotationFlags =
            reachableSet.functionAnnotationFlags[functionIndex]
        let keepExportBinding =
            (annotationFlags &
                parser.ParserFunctionAnnotationKeepExportBinding) != 0
        if reachableSet.functionNameSurfaceKinds[functionIndex] == 0 ||
           layout.FixedBytes32Equal(
               reachableSet.functionNameProofCids[functionIndex],
               layout.FixedBytes32()) ||
           annotationFlags < 0 ||
           layout.FixedBytes32Equal(
               reachableSet.functionDeclarationHeaderCids[
                   functionIndex],
               layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               reachableSet.functionDeclarationPathCids[
                   functionIndex],
               layout.FixedBytes32()) ||
           !compilerCsgKeepExportBindingCidMatches(
               keepExportBinding,
               functionIndex,
               reachableSet.producerSourceIndexes[functionIndex],
               reachableSet.producerDeclarationIndexes[functionIndex],
               annotationFlags,
               reachableSet.functionDeclarationHeaderCids[functionIndex],
               reachableSet.functionDeclarationPathCids[functionIndex],
               reachableSet.functionNameProofCids[functionIndex],
               reachableSet.keepExportBindingCids[functionIndex]):
            err = Fmt" compiler csg: parser provenance function unbound function_index={functionIndex}"
            return false
    err = ""
    return true

fn CompilerCsgReachableApplyKeepExportBindingPlan(
        reachableSet: var CompilerCsgReachableFunctionSet,
        err: var str): bool =
    var frontier: int32[]
    for functionId in 0..<reachableSet.functionNames.len:
        let annotationFlags =
            reachableSet.functionAnnotationFlags[functionId]
        let keepExportBinding =
            (annotationFlags &
                parser.ParserFunctionAnnotationKeepExportBinding) != 0
        let keepCid =
            reachableSet.keepExportBindingCids[functionId]
        if !keepExportBinding:
            if !layout.FixedBytes32Equal(
                   keepCid, layout.FixedBytes32()):
                err = Fmt" compiler csg: keep-export plan CID without annotation bit function_id={functionId}"
                return false
            continue
        let expectedCid = CompilerCsgKeepExportBindingCid(
            functionId,
            reachableSet.producerSourceIndexes[functionId],
            reachableSet.producerDeclarationIndexes[functionId],
            annotationFlags,
            reachableSet.functionDeclarationHeaderCids[functionId],
            reachableSet.functionDeclarationPathCids[functionId],
            reachableSet.functionNameProofCids[functionId])
        if !reachableSet.exportNameExplicitFlags[functionId] ||
           layout.FixedBytes32Equal(
               keepCid, layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(keepCid, expectedCid):
            err = Fmt" compiler csg: keep-export plan identity invalid function_id={functionId}"
            return false
        CompilerCsgReachableMark(
            reachableSet, functionId, frontier)
    CompilerCsgReachableExpand(reachableSet, frontier)
    err = ""
    return true

@borrows
fn CompilerCsgParserReceiptProfileIdentities(
        reachableSet: var CompilerCsgReachableFunctionSet,
        orderedSources: str[],
        orderedSourceModules: str[],
        sourceIndex: int32,
        out: var parser_receipt.ParserNormalizedExprFunctionIdentity[],
        err: var str): bool =
    out = []
    if sourceIndex < 0 || sourceIndex >= reachableSet.profileFunctionStarts.len ||
       sourceIndex >= reachableSet.profileFunctionCounts.len:
        err = Fmt" compiler csg: parser receipt profile adjacency missing source_index={sourceIndex}"
        return false
    let functionStart = reachableSet.profileFunctionStarts[sourceIndex]
    let functionEnd = functionStart +
                      reachableSet.profileFunctionCounts[sourceIndex]
    for functionIndex in functionStart..<functionEnd:
        var identity: parser_receipt.ParserNormalizedExprFunctionIdentity
        if !CompilerCsgParserReceiptFunctionIdentity(reachableSet,
                                                      orderedSources,
                                                      orderedSourceModules,
                                                      functionIndex,
                                                      identity,
                                                      err):
            return false
        add(out, identity)
    err = ""
    return true

@borrows
fn CompilerCsgParserReceiptAllIdentities(
        reachableSet: var CompilerCsgReachableFunctionSet,
        orderedSources: str[],
        orderedSourceModules: str[],
        out: var parser_receipt.ParserNormalizedExprFunctionIdentity[],
        err: var str): bool =
    out = []
    for functionIndex in 0..<reachableSet.functionNames.len:
        var identity: parser_receipt.ParserNormalizedExprFunctionIdentity
        if !CompilerCsgParserReceiptFunctionIdentity(reachableSet,
                                                      orderedSources,
                                                      orderedSourceModules,
                                                      functionIndex,
                                                      identity,
                                                      err):
            return false
        add(out, identity)
    err = ""
    return true

@borrows
fn CompilerCsgParserReceiptObserveAndVerify(
        accumulator: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        layer: var parser.NormalizedExprLayer,
        identities: parser_receipt.ParserNormalizedExprFunctionIdentity[],
        err: var str): bool =
    let observeRes =
        parser_receipt.ParserNormalizedExprReceiptObserveFunctions(
            accumulator, layer, identities)
    if IsErr(observeRes):
        err = Error(observeRes)
        return false
    let verifyRes =
        parser_receipt.ParserNormalizedExprReceiptVerifyObservedFunctions(
            accumulator, layer, identities)
    if IsErr(verifyRes):
        err = Error(verifyRes)
        return false
    err = ""
    return true

# Build the package parser forest before any TypedExpr context index can
# observe declaration effects.  The forest is the one canonical structural
# owner used by TypeArena and manual-consume admission; later receipt passes
# may parse source-local views, but must never append a second forest.
# TA-MEM exact-capacity merge helper: release every still-owned pending
# source tree on an error exit so a mid-merge failure cannot leak the
# already-parsed per-source arenas.
fn parserForestReleasePending(pendingTrees: var parser.ParserValueExprTree[]) =
    for pendingIndex in 0..<pendingTrees.len:
        if pendingTrees[pendingIndex] != nil:
            parser.ParserValueExprTreeRelease(pendingTrees[pendingIndex])
            pendingTrees[pendingIndex] = nil
    pendingTrees = []

# [M3-D6] Early per-source arena measurement pass.  Mounted right after the
# ordered source list is sorted, at the lowest floor the parse window can run
# at, so even a doubling-shaped parse of the largest closure source stays far
# under the RSS gate.  The per-source text comes from the pre-warmed source
# text cache -- the very bytes the profiles loop's immutable snapshot capture
# stores (the capture consumes this same lookup text), so the parse input is
# byte-identical to pass 0's, and the pass-0 determinism gate proves it in
# vivo for every source.  Each source is parsed through exactly the entry
# pass 0 uses (`migrationSourceSyntax` is a build-global flag derived from
# linkPlan.parserSyntaxTag, never per-source) and released immediately; only
# its exact ArenaUsed survives.  Pass 0 reserves that value up front, so its
# own parse never re-enters the arena doubling grow path.
fn CompilerCsgMeasureSourceArenaReservesInto(
        sourceTextLookup: var CompilerCsgSourceTextLookupEntry[],
        sourceTextLookupIndex: var CompilerCsgSourcePathIndex,
        sourceTextCache: var CompilerCsgSourceTextLookupEntry[],
        sourceTextCacheIndex: var CompilerCsgSourcePathIndex,
        sourcePaths: var str[],
        migrationSourceSyntax: bool,
        reserveMeasuresOut: var int32[],
        declarationIndexOut: var typearena.TypedExprTypeDeclarationIndex,
        sourceColumnCensusOut: var int32[],
        err: var str): bool =
    if sourcePaths.len <= 0 || reserveMeasuresOut.len != 0 ||
       sourceColumnCensusOut.len != 0 ||
       declarationIndexOut.sealed ||
       declarationIndexOut.producerSourceCount != 0:
        err = " compiler csg: parser forest reserve measure input invalid"
        return false
    # [D6v2] The measure channel is the only pass-0 parse: from the same
    # per-source tree it now also produces the column census and the
    # declaration projection (bases accumulate across the loop exactly as
    # ParserValueExprTreeAppendFromImpl assigned them), then seals the index
    # at the channel tail.  Determinism is pinned by the D6 hard gate
    # (ArenaUsed must reproduce byte for byte wherever the reserve is
    # re-consumed) and, in the diagnostic arm, by the post-pass-0
    # family-by-family harvest identity compare.
    var noColumnCensus: int32[]
    let measureReserve: int32 = 0
    var forestTypeSyntaxBase: int32
    var forestDeclarationBase: int32
    var forestGenericSymbolBase: int32
    var totalArenaBytes: int64
    var tcP0Ns: int64 = 0
    for sourceIndex in 0..<sourcePaths.len:
        if sourceIndex % 16 == 0:
            os.ProcessResourceGuardCheck()
        if compilerCsgForestSubTimeEnabled && !compilerCsgD6v2HarvestDiag:
            tcP0Ns = compilerCsgT4NowNs()
            compilerCsgForestSubSources = compilerCsgForestSubSources + 1
        var sourceText: str
        var textFromOverride: bool
        if !CompilerCsgSourceTextSnapshotLookup(
               sourceTextLookup,
               sourceTextLookupIndex,
               sourceTextCache,
               sourceTextCacheIndex,
               sourcePaths[sourceIndex],
               sourceText,
               textFromOverride,
               err):
            return false
        var parserInputText: str
        var coordinateMap: parser.ParserSourceRewriteCoordinateMap
        if !parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
               sourceText, parserInputText, coordinateMap, err):
            return false
        if compilerCsgForestSubTimeEnabled && !compilerCsgD6v2HarvestDiag:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP0RewriteNs =
                compilerCsgForestSubP0RewriteNs + (tcNow - tcP0Ns)
            tcP0Ns = tcNow
        let measureParseBeginNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        if compilerCsgMemTrace:
            # [D6v2] The former pass-0 per-source tags keep their names and
            # move here with the parse: reserve=0 is this channel's honest
            # reserve, and downstream greps keep counting one parse per
            # source per build.
            let parseBeginTag = Fmt"forest_parse_begin pass=0 src={sourceIndex} reserve={measureReserve}"
            compilerCsgMemTraceEmit(parseBeginTag)
            let measureBeginTag = Fmt"forest_measure_begin src={sourceIndex} bytes={sourceText.len}"
            compilerCsgMemTraceEmit(measureBeginTag)
        parser.ParserMemTraceSourceIndexSet(sourceIndex)
        var sourceTree: parser.ParserValueExprTree
        var treeRead = false
        if migrationSourceSyntax:
            treeRead =
                parser.ParserValueExprReadMigrationSourceTreeFromTextReserved(
                    parserInputText, measureReserve, noColumnCensus,
                    sourceTree, err)
        else:
            treeRead = parser.ParserValueExprReadTreeFromTextReserved(
                parserInputText, measureReserve, noColumnCensus,
                sourceTree, err)
        if !treeRead:
            parser.ParserValueExprTreeRelease(sourceTree)
            return false
        if sourceTree.producerSourceCount != 1:
            err = Fmt" compiler csg: parser forest reserve measure source authority invalid source_index={sourceIndex} producer_count={sourceTree.producerSourceCount}"
            parser.ParserValueExprTreeRelease(sourceTree)
            return false
        let measureUsed = Int32(arenamod.ArenaUsed(sourceTree.arena))
        add(reserveMeasuresOut, measureUsed)
        totalArenaBytes = totalArenaBytes + Int64(measureUsed)
        if compilerCsgMemTrace:
            let parseEndNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
            let parseMs = strings.Int64ToStr(
                (parseEndNs - measureParseBeginNs) / int64(1000000))
            let forestDoneTag = Fmt"forest_parse_end pass=0 src={sourceIndex} arena={measureUsed} parse_ms={parseMs}"
            compilerCsgMemTraceEmit(forestDoneTag)
            let forestPtrTag = Fmt"forest_parsed src={sourceIndex} arena={measureUsed}"
            compilerCsgMemTraceEmit(forestPtrTag)
            let measureDoneTag = Fmt"forest_measure_end src={sourceIndex} arena={measureUsed}"
            compilerCsgMemTraceEmit(measureDoneTag)
        # [D6v2] Column census + declaration projection from the same
        # resident tree the measure read, in the former pass-0 order
        # (census first, then the index slice, then the running bases).
        if !parser.ParserValueExprTreeArenaColumnCensusInto(
               sourceTree, sourceColumnCensusOut):
            parser.ParserValueExprTreeRelease(sourceTree)
            err = Fmt" compiler csg: parser forest measure column census failed source_index={sourceIndex}"
            return false
        if !typearena.TypedExprTypeDeclarationIndexBuildSourceInto(
               sourceTree,
               sourceIndex,
               forestTypeSyntaxBase,
               forestDeclarationBase,
               forestGenericSymbolBase,
               declarationIndexOut,
               err):
            parser.ParserValueExprTreeRelease(sourceTree)
            return false
        if compilerCsgForestSubTimeEnabled && !compilerCsgD6v2HarvestDiag:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP0IndexNs =
                compilerCsgForestSubP0IndexNs + (tcNow - tcP0Ns)
            tcP0Ns = tcNow
        forestTypeSyntaxBase =
            forestTypeSyntaxBase + sourceTree.typeSyntaxCount
        forestDeclarationBase =
            forestDeclarationBase + sourceTree.declarationCount
        forestGenericSymbolBase =
            forestGenericSymbolBase + sourceTree.typeGenericSymbolCount
        parser.ParserValueExprTreeRelease(sourceTree)
        if compilerCsgForestSubTimeEnabled && !compilerCsgD6v2HarvestDiag:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP0ReleaseNs =
                compilerCsgForestSubP0ReleaseNs + (tcNow - tcP0Ns)
            tcP0Ns = tcNow
        let _measureChurnRelief = os.ProcessMemoryPressureRelief()
    # [D6v2] Every source contributed its measure, census and declaration
    # projection from the same tree; the index is complete and seals here,
    # at the channel tail (the former pass-0 tail semantics, unchanged).
    declarationIndexOut.sealed = true
    if totalArenaBytes > Int64(arenamod.ArenaMaxInt32) - Int64(524288):
        err = " compiler csg: parser forest arena byte total overflow"
        return false
    err = ""
    return true

fn CompilerCsgBuildParserForestAuthorityInto(
        reusableTree: var parser.ParserValueExprTree,
        reuseTree: bool,
        sourceSnapshots: var CompilerCsgSourceText[],
        sourceSnapshotIndex: var CompilerCsgSourcePathIndex,
        sourcePaths: var str[],
        profiles: var parser.NormalizedExprCallProfile[],
        declarationIndex: var typearena.TypedExprTypeDeclarationIndex,
        sourceArenaBytesOut: var int32[],
        sourceColumnCensusOut: var int32[],
        sourceArenaReserveMeasures: var int32[],
        err: var str): bool =
    if sourcePaths.len <= 0 ||
       profiles.len != sourcePaths.len ||
       declarationIndex.sealed ||
       declarationIndex.producerSourceCount != 0 ||
       sourceArenaBytesOut.len != 0 ||
       sourceColumnCensusOut.len != 0:
        err = " compiler csg: parser forest authority input invalid"
        return false
    # [M3-D6] The reserve measures are the early measure pass's product.  A
    # short or misaligned array would read out of bounds or reserve a foreign
    # source's need; that is a hard defect, never a default reserve.
    if sourceArenaReserveMeasures.len != sourcePaths.len:
        err = Fmt" compiler csg: parser forest reserve measure coverage invalid expected={sourcePaths.len} measures={sourceArenaReserveMeasures.len}"
        return false
    if reuseTree:
        # [S1b-0 reuse-invariant] The reusable-forest path is structurally
        # unreachable and is pinned here as a hard failure rather than left as
        # a silent branch, because it carries no per-source arena measurement:
        # a reused forest would reach the streaming materialization pass with
        # an empty `sourceArenaBytesOut`, and "reserve from an empty array"
        # is exactly the read-stack-garbage shape the S1b red lines forbid.
        #
        # Why unreachable (both facts read, not inferred):
        #   1. `reuseTree` is exactly
        #      `linkPlan.exprLayer.sourceCount > 0 || linkPlan.exprLayer.exprs.len > 0`
        #      (compiler_csg.cheng:38611).
        #   2. The only writer of a non-empty `plan.exprLayer` is
        #      `parser.NormalizedExprLayerMoveInto(plan.exprLayer,
        #      parsed.normalizedExprLayer)` (system_link_plan.cheng:4899), and
        #      both producers of `parsed.normalizedExprLayer` assign the empty
        #      layer `NormalizedExprLayer()`: the request-fields builder
        #      (system_link_plan.cheng:4738 -> :4752) and the source header
        #      stub it falls back to (parser.cheng:39116 -> :39129).  The
        #      immutable-source-overlay builder never touches the field at all
        #      (system_link_plan.cheng:3621-3900, zero hits).
        #   Empirically: every recorded run emits `forest_build_start
        #   mode=reparse` and never `mode=clone`.
        #
        # If this path is ever revived it must produce `sourceArenaBytesOut`
        # itself during its own Init; the streaming driver must not adapt to
        # it, and no default/zero reserve may be substituted.
        let reusableSources =
            reusableTree == nil ? -1 : reusableTree.producerSourceCount
        err = Fmt" compiler csg: reusable parser forest path is structurally unreachable and has no per-source arena reserve reusable_sources={reusableSources} expected={sourcePaths.len}"
        return false
    if compilerCsgForestSubTimeEnabled:
        compilerCsgForestSubTimeReset()
    # [S1b step-3 (6)] Measurement-only pass.  The exact-capacity merge that
    # used to run here (reserve the summed arena once, re-parse every source
    # into one merged tree) is gone: the merged forest was the compile's RSS
    # peak, and every consumer of it now consumes one source at a time in
    # `CompilerCsgStreamTypeArenaFromDeclarationIndexInto`.  What remains is
    # the part that cannot be streamed -- the declaration index itself -- so
    # this pass parses each source, measures its exact arena bytes, extracts
    # its declaration projection and releases it immediately.  The running
    # bases below are exactly the global row bases
    # `ParserValueExprTreeAppendFromImpl` used to assign per source, so the
    # index's prefix sums are the same integers.
    var totalArenaBytes: int64
    var forestTypeSyntaxBase: int32
    var forestDeclarationBase: int32
    var forestGenericSymbolBase: int32
    # [U0-cut] Pass 0 is the measurement pass: it has no census yet, so both
    # reads below pass an empty one.  Pass 1 is the only pass that applies a
    # census, and it builds its own per-source slice; keeping the two explicit
    # is what makes the producer/consumer pair auditable by grep.
    var noColumnCensus: int32[]
    for sourceIndex in 0..<sourcePaths.len:
        if sourceIndex % 16 == 0:
            os.ProcessResourceGuardCheck()
        var tcP0Ns: int64 = 0
        if compilerCsgForestSubTimeEnabled:
            tcP0Ns = compilerCsgT4NowNs()
            compilerCsgForestSubSources = compilerCsgForestSubSources + 1
        var sourceText: str
        if !CompilerCsgImmutableSourceSnapshotText(
               sourceSnapshots,
               sourceSnapshotIndex,
               sourcePaths[sourceIndex],
               sourceText,
               err):
            return false
        if compilerCsgMemTrace:
            let forestTag = Fmt"forest src={sourceIndex} bytes={sourceText.len}"
            compilerCsgMemTraceEmit(forestTag)
        var parserInputText: str
        var coordinateMap: parser.ParserSourceRewriteCoordinateMap
        if !parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
               sourceText, parserInputText, coordinateMap, err):
            return false
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP0RewriteNs =
                compilerCsgForestSubP0RewriteNs + (tcNow - tcP0Ns)
            tcP0Ns = tcNow
        var sourceTree: parser.ParserValueExprTree
        var treeRead = false
        # [M3-D6] Reserve the exact measured need (+64KiB headroom) before the
        # first arena allocation; reserve=0 here re-entered the doubling grow
        # path whose old-block/new-block coexistence was the M3 RSS kill at
        # src=61 (.rebuild/m3attrib_line/M3_ATTRIB.md).
        let sourceArenaReserve: int32 =
            sourceArenaReserveMeasures[sourceIndex] + 65536
        # [S1b-0e / I1] Begin of the per-source parse window.  This is the
        # only place that can attribute the resident cost of parsing one
        # source, because `forest_parsed` below fires after the tree has
        # already been consumed and released.
        let parseBeginNs =
            monotimes.MonoTimeNs(monotimes.GetMonoTime())
        if compilerCsgMemTrace:
            let parseBeginTag = Fmt"forest_parse_begin pass=0 src={sourceIndex} reserve={sourceArenaReserve}"
            compilerCsgMemTraceEmit(parseBeginTag)
        parser.ParserMemTraceSourceIndexSet(sourceIndex)
        if profiles[sourceIndex].migrationSourceSyntax:
            treeRead =
                parser.ParserValueExprReadMigrationSourceTreeFromTextReserved(
                    parserInputText, sourceArenaReserve, noColumnCensus,
                    sourceTree, err)
        else:
            treeRead = parser.ParserValueExprReadTreeFromTextReserved(
                parserInputText, sourceArenaReserve, noColumnCensus,
                sourceTree, err)
        if !treeRead:
            parser.ParserValueExprTreeRelease(sourceTree)
            return false
        if sourceTree.producerSourceCount != 1:
            err = Fmt" compiler csg: parser forest source tree authority invalid source_index={sourceIndex} producer_count={sourceTree.producerSourceCount}"
            parser.ParserValueExprTreeRelease(sourceTree)
            return false
        let sourceArenaUsed = Int32(arenamod.ArenaUsed(sourceTree.arena))
        # [M3-D6] The early measure pass parsed the identical rewrite text
        # through the identical entry, so its ArenaUsed must reproduce here
        # byte for byte; a mismatch means the reserve was wrong, not merely
        # unlucky.  Fail loudly instead of trusting a stale measurement.
        if sourceArenaUsed != sourceArenaReserveMeasures[sourceIndex]:
            err = Fmt" compiler csg: parser forest reserve measure nondeterminism source_index={sourceIndex} measured={sourceArenaReserveMeasures[sourceIndex]} parsed={sourceArenaUsed}"
            parser.ParserValueExprTreeRelease(sourceTree)
            return false
        totalArenaBytes = totalArenaBytes + Int64(sourceArenaUsed)
        add(sourceArenaBytesOut, sourceArenaUsed)
        # [U0-cut] The per-column census for this source, taken from the same
        # resident tree that just produced `sourceArenaUsed`.  Pass 1
        # re-parses the same `parserInputText` with the same
        # `migrationSourceSyntax` flag, so these are its exact column lengths.
        if !parser.ParserValueExprTreeArenaColumnCensusInto(
               sourceTree, sourceColumnCensusOut):
            parser.ParserValueExprTreeRelease(sourceTree)
            err = Fmt" compiler csg: parser forest column census failed source_index={sourceIndex}"
            return false
        let parseEndNs =
            monotimes.MonoTimeNs(monotimes.GetMonoTime())
        if compilerCsgForestSubTimeEnabled:
            compilerCsgForestSubP0ParseNs =
                compilerCsgForestSubP0ParseNs + (parseEndNs - parseBeginNs)
        if compilerCsgMemTrace:
            let parseMs = strings.Int64ToStr(
                (parseEndNs - parseBeginNs) / int64(1000000))
            let forestDoneTag = Fmt"forest_parse_end pass=0 src={sourceIndex} arena={sourceArenaUsed} parse_ms={parseMs}"
            compilerCsgMemTraceEmit(forestDoneTag)
            let forestPtrTag = Fmt"forest_parsed src={sourceIndex} arena={sourceArenaUsed}"
            compilerCsgMemTraceEmit(forestPtrTag)
        # [orcd5-guard] HF in-phase sampling point (env-gated): one
        # source's arena spike can exceed the gate between the existing
        # check cadence; sample at every pass0 source boundary too.
        if compilerCsgRssGuardHf:
            os.ProcessResourceGuardCheck()
        # [S1a] Extract the source's cross-source declaration projection
        # while the single-source tree is still owned.  The completeness
        # proof for this slice runs in the streaming pass
        # (`TypedExprTypeDeclarationIndexVerifySourceAgainstInto`), because
        # the index can only be verified once it is sealed.
        if !typearena.TypedExprTypeDeclarationIndexBuildSourceInto(
               sourceTree,
               sourceIndex,
               forestTypeSyntaxBase,
               forestDeclarationBase,
               forestGenericSymbolBase,
               declarationIndex,
               err):
            parser.ParserValueExprTreeRelease(sourceTree)
            return false
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP0IndexNs =
                compilerCsgForestSubP0IndexNs + (tcNow - tcP0Ns)
            tcP0Ns = tcNow
        forestTypeSyntaxBase =
            forestTypeSyntaxBase + sourceTree.typeSyntaxCount
        forestDeclarationBase =
            forestDeclarationBase + sourceTree.declarationCount
        forestGenericSymbolBase =
            forestGenericSymbolBase + sourceTree.typeGenericSymbolCount
        parser.ParserMemTraceArenaStage(
            "p0_release_before",
            sourceIndex,
            arenamod.ArenaUsed(sourceTree.arena),
            arenamod.ArenaCapacity(sourceTree.arena),
            langintern.InternPoolLogicalPayloadBytes(sourceTree.internPool),
            langintern.InternPoolCount(sourceTree.internPool),
            sourceTree.tokenCount,
            sourceTree.nodeCount)
        parser.ParserValueExprTreeRelease(sourceTree)
        # The handle is dropped by the release, so this line carries only the
        # rss/live reading; the three arena columns are the structural zeros
        # `ArenaRelease` writes before the handle goes away (arena.cheng:153).
        parser.ParserMemTraceArenaStage(
            "p0_release_after",
            sourceIndex,
            0,
            0,
            Int64(0),
            0,
            0,
            0)
        # 每源归还 pass0 churn 死页 (0.5MB 级 phys 差口).
        let _forestPass0ChurnRelief = os.ProcessMemoryPressureRelief()
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP0ReleaseNs =
                compilerCsgForestSubP0ReleaseNs + (tcNow - tcP0Ns)
            tcP0Ns = tcNow
    # [S1a] Every source contributed its exact declaration
    # projection; the index is complete and may be verified.
    declarationIndex.sealed = true
    # [S1b step-3 (1)] Exact arena column totals, read from the sealed
    # index at the end of pass 0.  This is the only point in the run
    # where all sources have contributed and no forest has been merged
    # yet, so it is where the materialization phase's real column
    # budget can be read instead of extrapolated from a fixture.
    var columnLimits: typearena.TypedExprTypeArenaLimits
    if !typearena.TypedExprTypeArenaLimitsFromIndexInto(
           declarationIndex, columnLimits, err):
        return false
    if compilerCsgMemTrace:
        let limitsTag = Fmt"ta_limits tokens={columnLimits.tokenCount} type_syntax={columnLimits.typeSyntaxCount} type_syntax_children={columnLimits.typeSyntaxChildCount} enum_variants={columnLimits.enumVariantCount} declaration_symbols={columnLimits.declarationSymbolCount} functions={columnLimits.functionCount} bracket_args={columnLimits.bracketArgCount} generic_symbols={columnLimits.genericSymbolCount} generic_symbol_children={columnLimits.genericSymbolChildCount} column_rows={strings.Int64ToStr(columnLimits.columnRows)} column_bytes={strings.Int64ToStr(columnLimits.columnBytes)}"
        compilerCsgMemTraceEmit(limitsTag)
    if declarationIndex.producerSourceCount != sourcePaths.len:
        err = Fmt" compiler csg: parser forest authority coverage invalid expected={sourcePaths.len} observed={declarationIndex.producerSourceCount}"
        return false
    # [S1b-0] Post-condition of the per-source measurement.  Every source in
    # the driven range must own exactly one measured arena entry, and the
    # declaration index must cover the same range.  This is the precondition
    # the streaming materialization pass consumes: it reserves source i's
    # exact measured bytes, so a short or misaligned array is a hard defect,
    # never something to paper over with a default reserve.
    if sourceArenaBytesOut.len != sourcePaths.len ||
       sourceColumnCensusOut.len !=
           sourcePaths.len * parser.ParserValueExprTreeArenaColumnCount ||
       declarationIndex.producerSourceCount != sourcePaths.len ||
       declarationIndex.typeSyntaxBaseBySource.len != sourcePaths.len ||
       declarationIndex.declarationBaseBySource.len != sourcePaths.len:
        err = Fmt" compiler csg: parser forest per-source measurement coverage invalid expected={sourcePaths.len} arena_bytes={sourceArenaBytesOut.len} census={sourceColumnCensusOut.len} index_sources={declarationIndex.producerSourceCount}"
        return false
    if totalArenaBytes > Int64(arenamod.ArenaMaxInt32) - Int64(524288):
        err = " compiler csg: parser forest arena byte total overflow"
        return false
    compilerCsgForestSubTimeEmit("pass0")
    err = ""
    return true

# [D6v2] Harvest-identity helpers: one family per call, length gate first,
# then an elementwise walk that names the first diverging row.  Identity is
# compared, never assumed.
fn compilerCsgD6v2CompareInt32Family(diagCol: var int32[],
                                     liveCol: var int32[],
                                     family: str,
                                     err: var str): bool =
    if diagCol.len != liveCol.len:
        err = Fmt" compiler csg: d6v2 harvest identity {family} len mismatch diag={diagCol.len} live={liveCol.len}"
        return false
    for familyRow in 0..<diagCol.len:
        if diagCol[familyRow] != liveCol[familyRow]:
            err = Fmt" compiler csg: d6v2 harvest identity {family} row={familyRow} diag={diagCol[familyRow]} live={liveCol[familyRow]}"
            return false
    return true

fn compilerCsgD6v2CompareStrFamily(diagCol: var str[],
                                   liveCol: var str[],
                                   family: str,
                                   err: var str): bool =
    if diagCol.len != liveCol.len:
        err = Fmt" compiler csg: d6v2 harvest identity {family} len mismatch diag={diagCol.len} live={liveCol.len}"
        return false
    for familyRow in 0..<diagCol.len:
        if diagCol[familyRow] != liveCol[familyRow]:
            err = Fmt" compiler csg: d6v2 harvest identity {family} row={familyRow} diag_len={diagCol[familyRow].len} live_len={liveCol[familyRow].len}"
            return false
    return true

fn compilerCsgD6v2CompareBoolFamily(diagCol: var bool[],
                                    liveCol: var bool[],
                                    family: str,
                                    err: var str): bool =
    if diagCol.len != liveCol.len:
        err = Fmt" compiler csg: d6v2 harvest identity {family} len mismatch diag={diagCol.len} live={liveCol.len}"
        return false
    for familyRow in 0..<diagCol.len:
        if diagCol[familyRow] != liveCol[familyRow]:
            err = Fmt" compiler csg: d6v2 harvest identity {family} row={familyRow} diag={diagCol[familyRow]} live={liveCol[familyRow]}"
            return false
    return true

# [D6v2] pass-0 reader (default arm): the measure channel is the only parse,
# so this pass consumes its products instead of re-parsing.  Every former
# pass-0 product arrives from the channel: exact arena bytes (the measures),
# the per-column census and the sealed declaration index.  The gates below
# are harvest-integrity assertions (let-it-crash, never relaxed): a short or
# unsealed harvest is a hard defect, never a re-parse fallback.
fn CompilerCsgHarvestParserForestAuthorityFromMeasuresInto(
        sourcePaths: var str[],
        declarationIndex: var typearena.TypedExprTypeDeclarationIndex,
        sourceArenaBytesOut: var int32[],
        sourceColumnCensusOut: var int32[],
        sourceArenaReserveMeasures: var int32[],
        err: var str): bool =
    if sourcePaths.len <= 0 ||
       sourceArenaBytesOut.len != 0:
        err = " compiler csg: parser forest authority harvest input invalid"
        return false
    # [D6v2] The census arrives already filled by the measure channel's
    # harvest; the reader asserts its full length instead of emptiness.
    if sourceColumnCensusOut.len !=
       sourcePaths.len * parser.ParserValueExprTreeArenaColumnCount:
        err = Fmt" compiler csg: parser forest harvest census coverage invalid expected={sourcePaths.len * parser.ParserValueExprTreeArenaColumnCount} observed={sourceColumnCensusOut.len}"
        return false
    if sourceArenaReserveMeasures.len != sourcePaths.len:
        err = Fmt" compiler csg: parser forest reserve measure coverage invalid expected={sourcePaths.len} measures={sourceArenaReserveMeasures.len}"
        return false
    # Harvest completeness: the channel must have sealed a full-range index.
    if !declarationIndex.sealed ||
       declarationIndex.producerSourceCount != sourcePaths.len:
        err = Fmt" compiler csg: parser forest measure harvest coverage invalid expected={sourcePaths.len} index_sources={declarationIndex.producerSourceCount} sealed={declarationIndex.sealed}"
        return false
    var totalArenaBytes: int64
    for sourceIndex in 0..<sourcePaths.len:
        # The channel's ArenaUsed IS this source's exact arena bytes: the D6
        # determinism gate proved measure == parse byte for byte while pass 0
        # still parsed; the channel now IS the parse.
        let sourceArenaUsed = sourceArenaReserveMeasures[sourceIndex]
        totalArenaBytes = totalArenaBytes + Int64(sourceArenaUsed)
        add(sourceArenaBytesOut, sourceArenaUsed)
    # [S1b step-3 (1)] Exact arena column totals, read from the sealed index.
    var columnLimits: typearena.TypedExprTypeArenaLimits
    if !typearena.TypedExprTypeArenaLimitsFromIndexInto(
           declarationIndex, columnLimits, err):
        return false
    if compilerCsgMemTrace:
        let limitsTag = Fmt"ta_limits tokens={columnLimits.tokenCount} type_syntax={columnLimits.typeSyntaxCount} type_syntax_children={columnLimits.typeSyntaxChildCount} enum_variants={columnLimits.enumVariantCount} declaration_symbols={columnLimits.declarationSymbolCount} functions={columnLimits.functionCount} bracket_args={columnLimits.bracketArgCount} generic_symbols={columnLimits.genericSymbolCount} generic_symbol_children={columnLimits.genericSymbolChildCount} column_rows={strings.Int64ToStr(columnLimits.columnRows)} column_bytes={strings.Int64ToStr(columnLimits.columnBytes)}"
        compilerCsgMemTraceEmit(limitsTag)
    if declarationIndex.producerSourceCount != sourcePaths.len:
        err = Fmt" compiler csg: parser forest authority coverage invalid expected={sourcePaths.len} observed={declarationIndex.producerSourceCount}"
        return false
    if sourceArenaBytesOut.len != sourcePaths.len ||
       sourceColumnCensusOut.len !=
           sourcePaths.len * parser.ParserValueExprTreeArenaColumnCount ||
       declarationIndex.producerSourceCount != sourcePaths.len ||
       declarationIndex.typeSyntaxBaseBySource.len != sourcePaths.len ||
       declarationIndex.declarationBaseBySource.len != sourcePaths.len:
        err = Fmt" compiler csg: parser forest per-source measurement coverage invalid expected={sourcePaths.len} arena_bytes={sourceArenaBytesOut.len} census={sourceColumnCensusOut.len} index_sources={declarationIndex.producerSourceCount}"
        return false
    if totalArenaBytes > Int64(arenamod.ArenaMaxInt32) - Int64(524288):
        err = " compiler csg: parser forest arena byte total overflow"
        return false
    compilerCsgForestSubTimeEmit("pass0")
    err = ""
    return true

# [D6v2] Harvest-identity verdict (diagnostic arm): the measure channel's
# declaration index and column census against pass 0's parsed ones -- every
# column family byte for byte, all four scalars, and the flat census.
fn CompilerCsgD6v2HarvestIdentityInto(
        diagIndex: var typearena.TypedExprTypeDeclarationIndex,
        diagCensus: var int32[],
        liveIndex: var typearena.TypedExprTypeDeclarationIndex,
        liveCensus: var int32[],
        err: var str): bool =
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.producerSourceIndexes,
           liveIndex.producerSourceIndexes,
           "producerSourceIndexes",
           err):
        return false
    if !compilerCsgD6v2CompareStrFamily(
           diagIndex.declarationNameTexts,
           liveIndex.declarationNameTexts,
           "declarationNameTexts",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.declarationKinds,
           liveIndex.declarationKinds,
           "declarationKinds",
           err):
        return false
    if !compilerCsgD6v2CompareBoolFamily(
           diagIndex.declarationExportedFlags,
           liveIndex.declarationExportedFlags,
           "declarationExportedFlags",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.globalTypeSyntaxRoots,
           liveIndex.globalTypeSyntaxRoots,
           "globalTypeSyntaxRoots",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.globalDeclarationRows,
           liveIndex.globalDeclarationRows,
           "globalDeclarationRows",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.typeSyntaxBaseBySource,
           liveIndex.typeSyntaxBaseBySource,
           "typeSyntaxBaseBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.declarationBaseBySource,
           liveIndex.declarationBaseBySource,
           "declarationBaseBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.tokenCountBySource,
           liveIndex.tokenCountBySource,
           "tokenCountBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.typeSyntaxChildCountBySource,
           liveIndex.typeSyntaxChildCountBySource,
           "typeSyntaxChildCountBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.enumVariantCountBySource,
           liveIndex.enumVariantCountBySource,
           "enumVariantCountBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.declarationSymbolCountBySource,
           liveIndex.declarationSymbolCountBySource,
           "declarationSymbolCountBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.declarationSymbolGlobalRoots,
           liveIndex.declarationSymbolGlobalRoots,
           "declarationSymbolGlobalRoots",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.declarationGenericSymbolStarts,
           liveIndex.declarationGenericSymbolStarts,
           "declarationGenericSymbolStarts",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.declarationGenericSymbolCounts,
           liveIndex.declarationGenericSymbolCounts,
           "declarationGenericSymbolCounts",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.functionCountBySource,
           liveIndex.functionCountBySource,
           "functionCountBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.bracketArgCountBySource,
           liveIndex.bracketArgCountBySource,
           "bracketArgCountBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.genericSymbolCountBySource,
           liveIndex.genericSymbolCountBySource,
           "genericSymbolCountBySource",
           err):
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagIndex.genericSymbolChildCountBySource,
           liveIndex.genericSymbolChildCountBySource,
           "genericSymbolChildCountBySource",
           err):
        return false
    if diagIndex.sealed != liveIndex.sealed:
        err = Fmt" compiler csg: d6v2 harvest identity sealed mismatch diag={diagIndex.sealed} live={liveIndex.sealed}"
        return false
    if diagIndex.producerSourceCount != liveIndex.producerSourceCount:
        err = Fmt" compiler csg: d6v2 harvest identity producer_source_count mismatch diag={diagIndex.producerSourceCount} live={liveIndex.producerSourceCount}"
        return false
    if diagIndex.typeSyntaxCount != liveIndex.typeSyntaxCount:
        err = Fmt" compiler csg: d6v2 harvest identity type_syntax_count mismatch diag={diagIndex.typeSyntaxCount} live={liveIndex.typeSyntaxCount}"
        return false
    if diagIndex.declarationCount != liveIndex.declarationCount:
        err = Fmt" compiler csg: d6v2 harvest identity declaration_count mismatch diag={diagIndex.declarationCount} live={liveIndex.declarationCount}"
        return false
    if !compilerCsgD6v2CompareInt32Family(
           diagCensus,
           liveCensus,
           "column_census",
           err):
        return false
    err = ""
    return true

@borrows
fn CompilerCsgParserReceiptObserveSourceTree(
        accumulator: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        sourceSnapshots: var CompilerCsgSourceText[],
        sourceSnapshotIndex: var CompilerCsgSourcePathIndex,
        expectedSourceCount: int32,
        sourceIndex: int32,
        sourcePath: str,
        sourceModulePath: str,
        portableSourceIdentity: bool,
        sourceIdentityReceiptCid: layout.FixedBytes32,
        sourceSnapshotCount: int32,
        sourcePackageId: str,
        migrationSourceSyntax: bool,
        identities: parser_receipt.ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[],
        failureArtifact:
            var diagnostic_failure.DiagnosticFailureArtifact,
        failureAuthority:
            var diagnostic_authority.ParserDiagnosticAuthority,
        failureProducerProjectionCids: var layout.FixedBytes32[],
        err: var str): bool =
    var sourceText: str
    if !CompilerCsgImmutableSourceSnapshotText(sourceSnapshots,
                                                sourceSnapshotIndex,
                                                sourcePath,
                                                sourceText,
                                                err):
        return false
    var parserInputText: str
    var coordinateMap: parser.ParserSourceRewriteCoordinateMap
    if !parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
           sourceText, parserInputText, coordinateMap, err):
        return false
    var tree: parser.ParserValueExprTree
    var treeRead = false
    if migrationSourceSyntax:
        treeRead =
            parser.ParserValueExprReadMigrationSourceTreeFromText(
                parserInputText, tree, err)
    else:
        treeRead = parser.ParserValueExprReadTreeFromText(
            parserInputText, tree, err)
    if !treeRead:
        let parserErr = err
        var parserInputFailure: diagnostic_failure.DiagnosticFailureArtifact
        var failureMoveErr: str
        if !parser.ParserValueExprTreeFailureArtifactMoveInto(
               tree, parserInputFailure, failureMoveErr):
            panic(failureMoveErr)
        let parserInputFailureAnchor =
            parserInputFailure.anchorKinds[0]
        let hasStructuralAuthority =
            parserInputFailureAnchor ==
                diagnostic_failure.DiagnosticFailureAnchorParserNode ||
            parserInputFailureAnchor ==
                diagnostic_failure.DiagnosticFailureAnchorOwnerDeclaration ||
            parserInputFailureAnchor ==
                diagnostic_failure.DiagnosticFailureAnchorParserNodeOwnerDeclaration
        var failureAuthoritySidecar: parser_receipt.ParserCanonicalSourceSidecar
        if hasStructuralAuthority:
            var authorityErr: str
            if !parser_receipt.ParserDiagnosticFailureAuthorityBuildInto(
                   sourceIndex,
                   sourceText,
                   parserInputText,
                   tree,
                   identities,
                   declarations,
                   parserInputFailure,
                   failureAuthority,
                   failureProducerProjectionCids,
                   failureAuthoritySidecar,
                   authorityErr):
                panic(authorityErr)
        var sourceStartByte: int32
        var sourceEndByte: int32
        var coordinateErr: str
        if !parser.ParserDiagnosticFailureAnchorSpanToOriginalInto(
               parserInputFailureAnchor,
               coordinateMap,
               sourceText,
               parserInputText,
               parserInputFailure.spanStartBytes[0],
               parserInputFailure.spanEndBytes[0],
               sourceStartByte,
               sourceEndByte,
               coordinateErr):
            panic(coordinateErr)
        var producerDocumentCid: layout.FixedBytes32
        var producerIdentityErr: str
        if !cworld.CompilerWorldDocumentCidInto(
               sourcePackageId,
               sourceModulePath,
               producerDocumentCid,
               producerIdentityErr):
            panic(producerIdentityErr)
        let producerContentCid =
            diagnostic_failure.DiagnosticFailureSourceContentCid(
                sourceText)
        var producerSourceReceiptCid = sourceIdentityReceiptCid
        if !portableSourceIdentity:
            producerSourceReceiptCid =
                diagnostic_failure.DiagnosticFailureLocalSourceIdentityReceiptCid(
                    sourceIndex,
                    sourceSnapshotCount,
                    producerDocumentCid,
                    producerContentCid)
        var failureSealErr: str
        if !diagnostic_failure.DiagnosticFailureArtifactSealParserPortableInto(
               sourceText,
               sourceIndex,
               sourceSnapshotCount,
               producerSourceReceiptCid,
               producerDocumentCid,
               producerContentCid,
               parserInputFailure.anchorKinds[0],
               parserInputFailure.parserNodeIds[0],
               parserInputFailure.ownerDeclarationSourceLocalRows[0],
               sourceStartByte,
               sourceEndByte,
               parserInputFailure.messages[0],
               failureArtifact,
               failureSealErr):
            panic(failureSealErr)
        if hasStructuralAuthority &&
           !diagnostic_failure.DiagnosticFailureArtifactBindParserAuthorityInto(
               failureArtifact,
               failureAuthority.authorityRootCid,
               failureSealErr):
            panic(failureSealErr)
        if hasStructuralAuthority:
            CompilerCsgParserCanonicalSourceSidecarRelease(
                failureAuthoritySidecar)
        err = parser.ParserConcat4(
            " compiler csg: parser source tree failed source=",
            sourcePath,
            ": ",
            parserErr)
        parser.ParserValueExprTreeRelease(tree)
        return false
    if tree.producerSourceCount != 1:
        err = Fmt" compiler csg: TypeArena source tree producer count invalid source_index={sourceIndex} count={tree.producerSourceCount}"
        parser.ParserValueExprTreeRelease(tree)
        return false
    let observeRes =
        parser_receipt.ParserNormalizedExprReceiptObserveSourceTree(
            accumulator,
            sourceIndex,
            sourceText,
            parserInputText,
            tree,
            identities,
            declarations)
    if IsErr(observeRes):
        err = Error(observeRes)
        parser.ParserValueExprTreeRelease(tree)
        return false
    if expectedSourceCount != accumulator.sourcePaths.len:
        err = Fmt" compiler csg: TypeArena parser forest authority invalid source_index={sourceIndex} expected_sources={expectedSourceCount} accumulator_sources={accumulator.sourcePaths.len}"
        parser.ParserValueExprTreeRelease(tree)
        return false
    parser.ParserValueExprTreeRelease(tree)
    err = ""
    return true

@borrows
fn CompilerCsgParserReceiptObserveExactSourceTree(
        accumulator: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
        sourceSnapshots: var CompilerCsgSourceText[],
        sourceSnapshotIndex: var CompilerCsgSourcePathIndex,
        expectedSourceCount: int32,
        sourceIndex: int32,
        sourcePath: str,
        tree: var parser.ParserValueExprTree,
        identities: parser_receipt.ParserNormalizedExprFunctionIdentity[],
        declarations: parser.NormalizedFunctionDecl[],
        err: var str): bool =
    if tree == nil || tree.producerSourceCount != 1 ||
       expectedSourceCount != accumulator.sourcePaths.len:
        err = Fmt" compiler csg: exact parser tree/forest authority invalid source_index={sourceIndex} expected_sources={expectedSourceCount} accumulator_sources={accumulator.sourcePaths.len}"
        return false
    var sourceText: str
    if !CompilerCsgImmutableSourceSnapshotText(sourceSnapshots,
                                                sourceSnapshotIndex,
                                                sourcePath,
                                                sourceText,
                                                err):
        return false
    var parserInputText: str
    var coordinateMap: parser.ParserSourceRewriteCoordinateMap
    if !parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
           sourceText, parserInputText, coordinateMap, err):
        return false
    let observeRes =
        parser_receipt.ParserNormalizedExprReceiptObserveSourceTree(
            accumulator,
            sourceIndex,
            sourceText,
            parserInputText,
            tree,
            identities,
            declarations)
    if IsErr(observeRes):
        err = Error(observeRes)
        return false
    err = ""
    return true

@borrows
fn compilerCsgParserGlobalDeclaration(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        declarationRow: int32): bool =
    if declarationRow < 0 ||
       declarationRow >= sidecar.declarationKinds.len ||
       declarationRow >= sidecar.declarationFunctionRows.len ||
       declarationRow >= sidecar.declarationLexicalScopeIds.len:
        return false
    let scopeRow =
        sidecar.declarationLexicalScopeIds[declarationRow]
    return sidecar.declarationKinds[declarationRow] ==
               Int32(parser.ParserDeclarationLocal) &&
           sidecar.declarationFunctionRows[declarationRow] == -1 &&
           scopeRow >= 0 &&
           scopeRow < sidecar.declarationLexicalScopeKinds.len &&
           sidecar.declarationLexicalScopeKinds[scopeRow] ==
               Int32(parser.ParserDeclarationLexicalScopeSource)

@borrows
fn compilerCsgParserGlobalInitializerSpan(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        declarationRow: int32,
        startOut: var int32,
        endOut: var int32,
        err: var str): bool =
    startOut = -1
    endOut = -1
    var rootMatch: int32 = -1
    for rootRow in 0..<sidecar.statementRootNodeIds.len:
        if sidecar.statementRootRoles[rootRow] !=
               Int32(parser.ParserValueExprStatementBindingInitializer):
            continue
        let declarationStart =
            sidecar.statementRootBindingDeclarationStarts[rootRow]
        let declarationCount =
            sidecar.statementRootBindingDeclarationCounts[rootRow]
        if declarationRow < declarationStart ||
           declarationRow >= declarationStart + declarationCount:
            continue
        if rootMatch >= 0:
            err = " compiler csg: parser global declaration has multiple initializer roots"
            return false
        rootMatch = rootRow
    if rootMatch < 0:
        err = ""
        return true
    let nodeRow = sidecar.statementRootNodeIds[rootMatch]
    if nodeRow < 0 || nodeRow >= sidecar.nodeSpanIds.len:
        err = " compiler csg: parser global initializer node is invalid"
        return false
    let spanRow = sidecar.nodeSpanIds[nodeRow]
    if spanRow < 0 || spanRow >= sidecar.spanStartBytes.len ||
       spanRow >= sidecar.spanEndBytes.len:
        err = " compiler csg: parser global initializer span is invalid"
        return false
    startOut = sidecar.spanStartBytes[spanRow]
    endOut = sidecar.spanEndBytes[spanRow]
    err = ""
    return true

@borrows
fn CompilerCsgBindMetadataExactLayoutParserIdentities(
        ctx: var texpr.TypedExprSourceContext,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        sourceText: str,
        producerSourceIndex: int32,
        producerSourceCount: int32,
        err: var str): bool =
    let declarationCount = sidecar.declarationKinds.len
    if producerSourceIndex < 0 ||
       producerSourceIndex >= producerSourceCount ||
       producerSourceCount <= 0 ||
       sidecar.sourceIndex != producerSourceIndex ||
       declarationCount !=
           sidecar.declarationSourceLocalRows.len ||
       declarationCount != sidecar.declarationNameTokenIds.len ||
       declarationCount != sidecar.declarationOwnerIds.len ||
       declarationCount !=
           sidecar.declarationTypeSyntaxRootIds.len ||
       ctx.declaredTypes.len !=
           ctx.declaredTypeProducerSourceIndexes.len ||
       ctx.declaredTypes.len !=
           ctx.declaredTypeDeclarationSourceLocalRows.len ||
       ctx.declaredTypes.len != ctx.declaredTypeBuiltinKinds.len:
        err = " compiler csg: exact layout parser identity columns split"
        return false
    var ownerFieldCounts: int32[]
    setLen(ownerFieldCounts, declarationCount)
    var declaredTypeIndex: int32
    var fieldIndex: int32
    for declarationRow in 0..<declarationCount:
        if sidecar.declarationSourceLocalRows[declarationRow] !=
               declarationRow:
            err = " compiler csg: exact layout declaration row is not source-local"
            return false
        let kind = sidecar.declarationKinds[declarationRow]
        if kind != Int32(parser.ParserDeclarationType) &&
           kind != Int32(parser.ParserDeclarationField):
            continue
        let nameToken =
            sidecar.declarationNameTokenIds[declarationRow]
        if nameToken < 0 ||
           nameToken >= sidecar.tokenValues.len:
            err = " compiler csg: exact layout declaration name token invalid"
            return false
        let declarationName = sidecar.tokenValues[nameToken]
        let typeSyntaxRoot =
            sidecar.declarationTypeSyntaxRootIds[declarationRow]
        if typeSyntaxRoot < 0 ||
           typeSyntaxRoot >= sidecar.typeSyntaxRootKinds.len ||
           typeSyntaxRoot >=
               sidecar.typeSyntaxDeclarationOwnerIds.len ||
           typeSyntaxRoot >= sidecar.typeSyntaxSpanIds.len:
            err = " compiler csg: exact layout declaration TypeSyntax root invalid"
            return false
        if kind == Int32(parser.ParserDeclarationType):
            if declaredTypeIndex >= ctx.declaredTypes.len ||
               sidecar.typeSyntaxRootKinds[typeSyntaxRoot] !=
                   Int32(
                       parser.ParserTypeSyntaxRootTypeDeclarationRhs) ||
               sidecar.typeSyntaxDeclarationOwnerIds[
                   typeSyntaxRoot] != typeSyntaxRoot ||
               texpr.TypedExprNormalizeTypeText(
                   ctx.declaredTypes[declaredTypeIndex]) !=
                   texpr.TypedExprNormalizeTypeText(
                       declarationName):
                err = " compiler csg: exact type declaration payload conflict"
                return false
            if ctx.declaredTypeProducerSourceIndexes[
                   declaredTypeIndex] != -1 ||
               ctx.declaredTypeDeclarationSourceLocalRows[
                   declaredTypeIndex] != -1 ||
               ctx.declaredTypeBuiltinKinds[declaredTypeIndex] !=
                   Int32(texpr.TypedExprLayoutBuiltinNone):
                err = " compiler csg: exact type declaration coordinate rebound"
                return false
            texpr.TypedExprBindDeclaredTypeExactCoordinate(
                ctx,
                declaredTypeIndex,
                producerSourceIndex,
                declarationRow,
                texpr.TypedExprLayoutBuiltinNone)
            declaredTypeIndex = declaredTypeIndex + 1
            continue
        if fieldIndex >= ctx.typeFields.len ||
           sidecar.typeSyntaxRootKinds[typeSyntaxRoot] !=
               Int32(parser.ParserTypeSyntaxRootFieldDeclaration):
            err = " compiler csg: exact field declaration payload missing"
            return false
        let ownerDeclarationRow =
            sidecar.declarationOwnerIds[declarationRow]
        if ownerDeclarationRow < 0 ||
           ownerDeclarationRow >= declarationRow ||
           sidecar.declarationKinds[ownerDeclarationRow] !=
               Int32(parser.ParserDeclarationType):
            err = " compiler csg: exact field owner declaration invalid"
            return false
        let ownerNameToken =
            sidecar.declarationNameTokenIds[ownerDeclarationRow]
        let ownerTypeSyntaxRoot =
            sidecar.declarationTypeSyntaxRootIds[
                ownerDeclarationRow]
        let typeSpanId =
            sidecar.typeSyntaxSpanIds[typeSyntaxRoot]
        if ownerNameToken < 0 ||
           ownerNameToken >= sidecar.tokenValues.len ||
           ownerTypeSyntaxRoot < 0 ||
           ownerTypeSyntaxRoot >=
               sidecar.typeSyntaxRootKinds.len ||
           ownerTypeSyntaxRoot >=
               sidecar.typeSyntaxDeclarationOwnerIds.len ||
           ownerTypeSyntaxRoot >=
               sidecar.typeSyntaxSpanIds.len ||
           sidecar.typeSyntaxRootKinds[ownerTypeSyntaxRoot] !=
               Int32(
                   parser.ParserTypeSyntaxRootTypeDeclarationRhs) ||
           sidecar.typeSyntaxDeclarationOwnerIds[
               ownerTypeSyntaxRoot] != ownerTypeSyntaxRoot ||
           sidecar.typeSyntaxDeclarationOwnerIds[
               typeSyntaxRoot] != ownerTypeSyntaxRoot ||
           typeSpanId < 0 ||
           typeSpanId >= sidecar.spanStartBytes.len ||
           typeSpanId >= sidecar.spanEndBytes.len:
            err = " compiler csg: exact field structural edge invalid"
            return false
        let typeSpanStart =
            sidecar.spanStartBytes[typeSpanId]
        let typeSpanEnd =
            sidecar.spanEndBytes[typeSpanId]
        let field = ctx.typeFields[fieldIndex]
        if typeSpanStart < 0 ||
           typeSpanEnd <= typeSpanStart ||
           typeSpanEnd > sourceText.len ||
           texpr.TypedExprTypeLeafName(field.ownerType) !=
               texpr.TypedExprTypeLeafName(
                   sidecar.tokenValues[ownerNameToken]) ||
           parser.ParserIdentPrefix(
               chengpath.PathTrim(field.fieldName)) !=
               parser.ParserIdentPrefix(
                   chengpath.PathTrim(declarationName)) ||
           texpr.TypedExprNormalizeTypeText(field.fieldType) !=
               texpr.TypedExprNormalizeTypeText(
                   chengpath.TextSlice(
                       sourceText,
                       typeSpanStart,
                       typeSpanEnd - typeSpanStart)):
            err = " compiler csg: exact field declaration payload conflict"
            return false
        if field.producerSourceIndex != -1 ||
           field.ownerDeclarationSourceLocalRow != -1 ||
           field.fieldDeclarationSourceLocalRow != -1 ||
           field.ordinal != -1 ||
           field.builtinKind !=
               texpr.TypedExprLayoutBuiltinNone:
            err = " compiler csg: exact field declaration coordinate rebound"
            return false
        let ordinal =
            ownerFieldCounts[ownerDeclarationRow]
        texpr.TypedExprBindTypeFieldExactCoordinate(
            ctx,
            fieldIndex,
            producerSourceIndex,
            ownerDeclarationRow,
            declarationRow,
            ordinal,
            texpr.TypedExprLayoutBuiltinNone)
        ownerFieldCounts[ownerDeclarationRow] =
            ordinal + 1
        fieldIndex = fieldIndex + 1
    if declaredTypeIndex != ctx.declaredTypes.len ||
       fieldIndex != ctx.typeFields.len:
        err = Fmt" compiler csg: exact layout parser/context coverage split source={producerSourceIndex} parser_types={declaredTypeIndex} context_types={ctx.declaredTypes.len} parser_fields={fieldIndex} context_fields={ctx.typeFields.len}"
        return false
    texpr.TypedExprBindExactLayoutParserAuthority(
        ctx,
        producerSourceCount,
        declarationCount)
    err = ""
    return true

@borrows
fn CompilerCsgBindMetadataGlobalParserIdentities(
        ctx: var texpr.TypedExprSourceContext,
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        sourceText: str,
        producerSourceIndex: int32,
        producerSourceCount: int32,
        err: var str): bool =
    if producerSourceIndex < 0 ||
       sidecar.sourceIndex != producerSourceIndex ||
       ctx.sourcePath == "" ||
       sidecar.declarationSourceLocalRows.len !=
           sidecar.declarationKinds.len:
        err = " compiler csg: parser global identity source domain is invalid"
        return false
    if !CompilerCsgBindMetadataExactLayoutParserIdentities(
           ctx,
           sidecar,
           sourceText,
           producerSourceIndex,
           producerSourceCount,
           err):
        return false
    for bindingIndex in 0..<ctx.bindings.len:
        if !ctx.bindings[bindingIndex].globalFlag:
            err = " compiler csg: metadata global identity input contains a local binding"
            return false
    var candidate: texpr.TypedExprBinding[]
    for declarationRow in 0..<sidecar.declarationKinds.len:
        if !compilerCsgParserGlobalDeclaration(sidecar,
                                                declarationRow):
            continue
        if declarationRow >= sidecar.declarationSourceLocalRows.len ||
           declarationRow >= sidecar.declarationNameTokenIds.len ||
           declarationRow >= sidecar.declarationTypeSyntaxRootIds.len ||
           declarationRow >= sidecar.declarationMutableFlags.len:
            err = " compiler csg: parser global declaration columns mismatch"
            return false
        let sourceLocalDeclarationRow =
            sidecar.declarationSourceLocalRows[declarationRow]
        if sourceLocalDeclarationRow < 0:
            err = " compiler csg: parser global declaration identity is missing"
            return false
        let nameToken = sidecar.declarationNameTokenIds[declarationRow]
        if nameToken < 0 || nameToken >= sidecar.tokenValues.len ||
           nameToken >= sidecar.tokenSpanIds.len:
            err = " compiler csg: parser global declaration name token is invalid"
            return false
        let nameSpan = sidecar.tokenSpanIds[nameToken]
        if nameSpan < 0 || nameSpan >= sidecar.spanStartLines.len:
            err = " compiler csg: parser global declaration name span is invalid"
            return false
        var typeStart: int32 = -1
        var typeEnd: int32 = -1
        let typeSyntaxRow =
            sidecar.declarationTypeSyntaxRootIds[declarationRow]
        if typeSyntaxRow >= 0:
            if typeSyntaxRow >= sidecar.typeSyntaxSpanIds.len:
                err = " compiler csg: parser global type root is invalid"
                return false
            let typeSpan = sidecar.typeSyntaxSpanIds[typeSyntaxRow]
            if typeSpan < 0 ||
               typeSpan >= sidecar.spanStartBytes.len ||
               typeSpan >= sidecar.spanEndBytes.len:
                err = " compiler csg: parser global type span is invalid"
                return false
            typeStart = sidecar.spanStartBytes[typeSpan]
            typeEnd = sidecar.spanEndBytes[typeSpan]
        var initStart: int32
        var initEnd: int32
        if !compilerCsgParserGlobalInitializerSpan(
               sidecar,
               declarationRow,
               initStart,
               initEnd,
               err):
            return false
        var binding: texpr.TypedExprBinding
        var emitted: bool
        if !texpr.TypedExprParserOwnedGlobalBindingFromSpans(
               ctx.sourcePath,
               sourceText,
               producerSourceIndex,
               sourceLocalDeclarationRow,
               sidecar.declarationMutableFlags[declarationRow],
               sidecar.spanStartLines[nameSpan] + 1,
               sidecar.tokenValues[nameToken],
               typeStart,
               typeEnd,
               initStart,
               initEnd,
               binding,
               emitted,
               err):
            return false
        if emitted:
            add(candidate, binding)
    # This is only a coverage check against the already built metadata set. No
    # old row participates in identity selection or candidate ordering.
    if candidate.len != ctx.bindings.len:
        err = Fmt" compiler csg: parser-owned global coverage mismatch source={ctx.sourcePath} parser={candidate.len} metadata={ctx.bindings.len}"
        return false
    ctx.bindings = candidate
    ctx.bindingNameIndexBuiltCount = -1
    err = ""
    return true

@borrows
fn CompilerCsgTypedIrGlobalParserIdentityStrictValidateInto(
        ir: var texpr.TypedExprIr,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        err: var str): bool =
    if !texpr.TypedExprIrGlobalParserIdentityComplete(ir):
        err = " compiler csg: TypedIR global parser identity columns are incomplete"
        return false
    var seenSourceIndexes: int32[]
    var seenDeclarationRows: int32[]
    for globalRow in 0..<ir.globalNames.len:
        let producerSourceIndex =
            ir.globalProducerSourceIndexes[globalRow]
        let declarationSourceLocalRow =
            ir.globalDeclarationSourceLocalRows[globalRow]
        if producerSourceIndex < 0 ||
           producerSourceIndex >= receipt.sourceSidecars.len:
            err = Fmt" compiler csg: TypedIR global parser source is invalid row={globalRow} source={producerSourceIndex}"
            return false
        let sidecar = receipt.sourceSidecars[producerSourceIndex]
        if sidecar.sourceIndex != producerSourceIndex ||
           declarationSourceLocalRow < 0 ||
           declarationSourceLocalRow >=
               sidecar.declarationSourceLocalRows.len ||
           sidecar.declarationSourceLocalRows[
               declarationSourceLocalRow] !=
               declarationSourceLocalRow ||
           !compilerCsgParserGlobalDeclaration(
               sidecar, declarationSourceLocalRow):
            err = Fmt" compiler csg: TypedIR global parser declaration is invalid row={globalRow} source={producerSourceIndex} declaration={declarationSourceLocalRow}"
            return false
        for seenRow in 0..<seenSourceIndexes.len:
            if seenSourceIndexes[seenRow] == producerSourceIndex &&
               seenDeclarationRows[seenRow] ==
                   declarationSourceLocalRow:
                err = Fmt" compiler csg: TypedIR global parser identity is duplicated row={globalRow} source={producerSourceIndex} declaration={declarationSourceLocalRow}"
                return false
        add(seenSourceIndexes, producerSourceIndex)
        add(seenDeclarationRows, declarationSourceLocalRow)
    err = ""
    return true

fn compilerCsgTypedNodeScalarKind(
        opKind: texpr.TypedExprIrOpKind): typearena.TypedExprStructuralScalarKind =
    if opKind == texpr.TypedExprIrOpI32Const ||
       opKind == texpr.TypedExprIrOpI32Add ||
       opKind == texpr.TypedExprIrOpI32Sub ||
       opKind == texpr.TypedExprIrOpI32Mul ||
       opKind == texpr.TypedExprIrOpI32Asr ||
       opKind == texpr.TypedExprIrOpI32Madd ||
       opKind == texpr.TypedExprIrOpI32Sdiv ||
       opKind == texpr.TypedExprIrOpI32Udiv ||
       opKind == texpr.TypedExprIrOpI32Mod ||
       opKind == texpr.TypedExprIrOpI32Umod ||
       opKind == texpr.TypedExprIrOpI32BitAnd ||
       opKind == texpr.TypedExprIrOpI32BitOr ||
       opKind == texpr.TypedExprIrOpI32BitXor ||
       opKind == texpr.TypedExprIrOpI32Lsl ||
       opKind == texpr.TypedExprIrOpI32Lsr ||
       opKind == texpr.TypedExprIrOpI32Arg0GeZeroAndLeConst ||
       opKind == texpr.TypedExprIrOpI32Arg0XorConst ||
       opKind == texpr.TypedExprIrOpI32IfArg0LeZeroConstElseConst ||
       opKind == texpr.TypedExprIrOpStrLenFast ||
       opKind == texpr.TypedExprIrOpReturnSeqLenArg0 ||
       opKind == texpr.TypedExprIrOpReturnBytesLenArg0:
        return typearena.TypedExprStructuralScalarInt32
    if opKind == texpr.TypedExprIrOpI64Const ||
       opKind == texpr.TypedExprIrOpI64Add ||
       opKind == texpr.TypedExprIrOpI64Sub ||
       opKind == texpr.TypedExprIrOpI64Mul ||
       opKind == texpr.TypedExprIrOpI64Sdiv ||
       opKind == texpr.TypedExprIrOpI64Udiv ||
       opKind == texpr.TypedExprIrOpI64Mod ||
       opKind == texpr.TypedExprIrOpI64Umod ||
       opKind == texpr.TypedExprIrOpI64BitAnd ||
       opKind == texpr.TypedExprIrOpI64BitOr ||
       opKind == texpr.TypedExprIrOpI64BitXor ||
       opKind == texpr.TypedExprIrOpI64Lsl ||
       opKind == texpr.TypedExprIrOpI64Lsr ||
       opKind == texpr.TypedExprIrOpI64Asr ||
       opKind == texpr.TypedExprIrOpReturnI64FromI32Arg0:
        return typearena.TypedExprStructuralScalarInt64
    if opKind == texpr.TypedExprIrOpF64Const ||
       opKind == texpr.TypedExprIrOpF64Add ||
       opKind == texpr.TypedExprIrOpF64Sub ||
       opKind == texpr.TypedExprIrOpF64Mul ||
       opKind == texpr.TypedExprIrOpF64Div:
        return typearena.TypedExprStructuralScalarFloat64
    if opKind == texpr.TypedExprIrOpBoolLit ||
       opKind == texpr.TypedExprIrOpCmpEq ||
       opKind == texpr.TypedExprIrOpCmpNe ||
       opKind == texpr.TypedExprIrOpCmpLt ||
       opKind == texpr.TypedExprIrOpCmpLe ||
       opKind == texpr.TypedExprIrOpCmpGt ||
       opKind == texpr.TypedExprIrOpCmpGe ||
       opKind == texpr.TypedExprIrOpLogAnd ||
       opKind == texpr.TypedExprIrOpLogOr ||
       opKind == texpr.TypedExprIrOpLogNot ||
       opKind == texpr.TypedExprIrOpU64Arg0AndConst4NotZero ||
       opKind == texpr.TypedExprIrOpReturnBoolI32Arg0Range0To31:
        return typearena.TypedExprStructuralScalarBool
    if opKind == texpr.TypedExprIrOpCharLit ||
       opKind == texpr.TypedExprIrOpReturnCharArg0:
        return typearena.TypedExprStructuralScalarChar
    if opKind == texpr.TypedExprIrOpStrLit ||
       opKind == texpr.TypedExprIrOpReturnStrLiteral ||
       opKind == texpr.TypedExprIrOpStrEmptyReturn ||
       opKind == texpr.TypedExprIrOpStrAdd ||
       opKind == texpr.TypedExprIrOpFmt ||
       opKind == texpr.TypedExprIrOpCstringToStrCopy ||
       opKind == texpr.TypedExprIrOpReturnStrArg0:
        return typearena.TypedExprStructuralScalarStr
    return typearena.TypedExprStructuralScalarInvalid

@borrows
fn compilerCsgTypedNodeValidateBuiltinCallResultType(
        ir: texpr.TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        sourceId: int32,
        typeSyntaxSourceStarts: int32[],
        typeSyntaxRows: int32[],
        nodeIndex: int32,
        exactTypeId: int32,
        err: var str): bool =
    var callee = ""
    let calleeRes: Result[str] = langintern.LookupIntern(
        ir.internPool, ir.nodes2_literalTextIds[nodeIndex])
    if IsOk(calleeRes):
        callee = Value(calleeRes)
    var argCount: int32
    var link = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.nodes2_operand0NodeIndexs, nodeIndex)
    while link >= 0 && link < nodeIndex &&
          ir.nodes2_opKinds[link] == texpr.TypedExprIrOpArgLink:
        argCount = argCount + 1
        link = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_operand1NodeIndexs, link)
    # [w45] builtin `new` has no reserved-scalar result spelling, so the
    # empty-argsText resolver below can never name its result type.  The
    # producer (typed_expr value-expr new arm) freezes the exact ref{T}
    # TypeId from the unique ParserDeclarationType row for T and carries no
    # operand nodes; this gate cross-checks the frozen node TypeId against
    # the same declaration row's TypeSyntax entry in the frozen
    # typeSyntaxTypeIds authority column.  The csg side never derives a
    # TypeId here: every coordinate miss (result text shape, declaration
    # uniqueness, TypeSyntax root join, frozen row) stays fail-closed.
    if callee == "new":
        if argCount != 0:
            err = Fmt" compiler csg: typed-node builtin new operand unexpected node={nodeIndex} args={argCount}"
            return false
        var resultText = ""
        let resultRes: Result[str] = langintern.LookupIntern(
            ir.internPool, ir.nodes2_resultTypeIds[nodeIndex])
        if IsOk(resultRes):
            resultText = Value(resultRes)
        let newPrefix = "ref"
        if resultText.len <= newPrefix.len ||
           !strutil.StartsWith(resultText, newPrefix):
            # [w45] verdict carries the frozen result text so the producing
            # arm on the typed_expr side is identifiable without a rebake.
            # Producer spelling is `ref` + type name (Fmt brace interpolation),
            # never a braced `ref{...}` literal.
            err = Fmt" compiler csg: typed-node builtin new result text invalid node={nodeIndex} len={resultText.len} text={resultText} args={argCount}"
            return false
        let typeArgText = chengpath.TextSlice(
            resultText, newPrefix.len,
            resultText.len - newPrefix.len)
        if typeArgText == "":
            err = Fmt" compiler csg: typed-node builtin new result text invalid node={nodeIndex} len={resultText.len} text={resultText} args={argCount}"
            return false
        if sourceId < 0 || sourceId >= receipt.sourceSidecars.len:
            err = Fmt" compiler csg: typed-node builtin new source invalid node={nodeIndex}"
            return false
        let newSidecar = receipt.sourceSidecars[sourceId]
        var declarationHits: int32
        var matchedTypeSyntaxRoot: int32 = -1
        for declarationRow in 0..<newSidecar.declarationKinds.len:
            if newSidecar.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationType):
                continue
            let declarationNameToken =
                newSidecar.declarationNameTokenIds[declarationRow]
            if declarationNameToken < 0 ||
               declarationNameToken >= newSidecar.tokenValues.len:
                err = Fmt" compiler csg: typed-node builtin new declaration name invalid node={nodeIndex}"
                return false
            if texpr.TypedExprNormalizeTypeText(
                   newSidecar.tokenValues[declarationNameToken]) !=
                   texpr.TypedExprNormalizeTypeText(typeArgText):
                continue
            declarationHits = declarationHits + 1
            matchedTypeSyntaxRoot =
                newSidecar.declarationTypeSyntaxRootIds[declarationRow]
        if declarationHits != 1:
            err = Fmt" compiler csg: typed-node builtin new type declaration missing node={nodeIndex} hits={declarationHits} text={resultText}"
            return false
        if matchedTypeSyntaxRoot < 0 ||
           matchedTypeSyntaxRoot >= newSidecar.typeSyntaxRootKinds.len ||
           newSidecar.typeSyntaxRootKinds[matchedTypeSyntaxRoot] !=
               Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
            err = Fmt" compiler csg: typed-node builtin new TypeSyntax root invalid node={nodeIndex} text={resultText} root={matchedTypeSyntaxRoot}"
            return false
        let newDirectRow = typeSyntaxSourceStarts[sourceId] +
            matchedTypeSyntaxRoot
        if newDirectRow < 0 || newDirectRow >= typeSyntaxRows.len ||
           typeSyntaxRows[newDirectRow] < 0:
            err = Fmt" compiler csg: typed-node builtin new TypeSyntax row invalid node={nodeIndex} text={resultText} row={newDirectRow}"
            return false
        let expectedNewTypeId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxTypeIds,
            typeSyntaxRows[newDirectRow])
        if expectedNewTypeId < 0 ||
           expectedNewTypeId >= typeArena.typeCount:
            err = Fmt" compiler csg: typed-node builtin new TypeSyntax TypeId invalid node={nodeIndex} text={resultText} tid={expectedNewTypeId}"
            return false
        if exactTypeId != expectedNewTypeId:
            err = Fmt" compiler csg: typed-node builtin new result TypeId drift node={nodeIndex} text={resultText} exact={exactTypeId} expected={expectedNewTypeId}"
            return false
        err = ""
        return true
    let builtinReturnType = texpr.TypedExprBuiltinCalleeReturnType(
        callee, "", argCount)
    let expectedReturnTypeId =
        typearena.TypedExprTypeArenaReservedScalarTypeIdForText(
            typeArena, builtinReturnType)
    if builtinReturnType == "" || expectedReturnTypeId < 0:
        err = Fmt" compiler csg: typed-node builtin return TypeId missing node={nodeIndex}"
        return false
    if exactTypeId != expectedReturnTypeId:
        err = Fmt" compiler csg: typed-node builtin call result TypeId drift node={nodeIndex}"
        return false
    err = ""
    return true

# [phaseB-csg] 命名聚合构造占位 CallExpr 的 typed-node resolved-call 审计。
# 占位节点特征（[phaseB-parser] 五层密封链的产线契约）：callKind=None、
# callDeclarationIndex=-1、无 callee 节点、callTarget 与 resultType 同为
# 本源声明类型叶、structuralTypeId/Send/Sync/Proof 列已由 value-def 绑定
# 臂按声明行 TypeSyntax root 精确绑定。本臂不自行推导任何类型：节点文本
# 在 owner sidecar 唯一命中 ParserDeclarationType 声明行后，从
# typeSyntaxTypeIds 冻结权威列取 TypeId 与节点 exactTypeId 对账，Send/
# Sync/Proof 三列与 TypeArena 权威值对账；唯一性破坏或任一坐标 miss 均
# fail-closed。
@borrows
fn compilerCsgTypedNodeValidateNamedAggregateConstructorCall(
        ir: texpr.TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        sourceId: int32,
        typeSyntaxSourceStarts: int32[],
        typeSyntaxRows: int32[],
        nodeIndex: int32,
        exactTypeId: int32,
        err: var str): bool =
    var target = ""
    let targetRes: Result[str] = langintern.LookupIntern(
        ir.internPool, ir.nodes2_callTargetIds[nodeIndex])
    if IsOk(targetRes):
        target = Value(targetRes)
    var resultText = ""
    let resultRes: Result[str] = langintern.LookupIntern(
        ir.internPool, ir.nodes2_resultTypeIds[nodeIndex])
    if IsOk(resultRes):
        resultText = Value(resultRes)
    if target == "" ||
       resultText == "" ||
       texpr.TypedExprNormalizeTypeText(target) !=
           texpr.TypedExprNormalizeTypeText(resultText):
        err = Fmt" compiler csg: typed-node aggregate constructor target invalid node={nodeIndex} target={target} result={resultText}"
        return false
    if sourceId < 0 || sourceId >= receipt.sourceSidecars.len:
        err = Fmt" compiler csg: typed-node aggregate constructor source invalid node={nodeIndex}"
        return false
    let sidecar = receipt.sourceSidecars[sourceId]
    var declarationHits: int32
    var matchedTypeSyntaxRoot: int32 = -1
    for declarationRow in 0..<sidecar.declarationKinds.len:
        if sidecar.declarationKinds[declarationRow] !=
               Int32(parser.ParserDeclarationType):
            continue
        let declarationNameToken =
            sidecar.declarationNameTokenIds[declarationRow]
        if declarationNameToken < 0 ||
           declarationNameToken >= sidecar.tokenValues.len:
            err = Fmt" compiler csg: typed-node aggregate constructor declaration name invalid node={nodeIndex}"
            return false
        if texpr.TypedExprNormalizeTypeText(
               sidecar.tokenValues[declarationNameToken]) !=
               texpr.TypedExprNormalizeTypeText(resultText):
            continue
        declarationHits = declarationHits + 1
        matchedTypeSyntaxRoot =
            sidecar.declarationTypeSyntaxRootIds[declarationRow]
    if declarationHits != 1:
        err = Fmt" compiler csg: typed-node aggregate constructor type declaration missing node={nodeIndex} hits={declarationHits} text={resultText}"
        return false
    if matchedTypeSyntaxRoot < 0 ||
       matchedTypeSyntaxRoot >= sidecar.typeSyntaxRootKinds.len ||
       sidecar.typeSyntaxRootKinds[matchedTypeSyntaxRoot] !=
           Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
        err = Fmt" compiler csg: typed-node aggregate constructor TypeSyntax root invalid node={nodeIndex} text={resultText} root={matchedTypeSyntaxRoot}"
        return false
    let directRow = typeSyntaxSourceStarts[sourceId] +
        matchedTypeSyntaxRoot
    if directRow < 0 || directRow >= typeSyntaxRows.len ||
       typeSyntaxRows[directRow] < 0:
        err = Fmt" compiler csg: typed-node aggregate constructor TypeSyntax row invalid node={nodeIndex} text={resultText} row={directRow}"
        return false
    let expectedTypeId = arenamod.ArenaArrayInt32Get(
        typeArena.arena,
        typeArena.typeSyntaxTypeIds,
        typeSyntaxRows[directRow])
    if expectedTypeId < 0 ||
       expectedTypeId >= typeArena.typeCount:
        err = Fmt" compiler csg: typed-node aggregate constructor TypeSyntax TypeId invalid node={nodeIndex} text={resultText} tid={expectedTypeId}"
        return false
    if exactTypeId != expectedTypeId:
        err = Fmt" compiler csg: typed-node aggregate constructor result TypeId drift node={nodeIndex} text={resultText} exact={exactTypeId} expected={expectedTypeId}"
        return false
    if arenamod.ArenaArrayInt32Get(
               ir.arena, ir.nodes2_resultTypeProofKinds, nodeIndex) !=
           texpr.TypedExprSnapshotTypeProofKindForTypeArenaAt(
               typeArena, expectedTypeId) ||
       ir.nodes2_resultTypeSendFlags[nodeIndex] !=
           typearena.TypedExprTypeArenaSendAt(typeArena, expectedTypeId) ||
       ir.nodes2_resultTypeSyncFlags[nodeIndex] !=
           typearena.TypedExprTypeArenaSyncAt(typeArena, expectedTypeId):
        err = Fmt" compiler csg: typed-node aggregate constructor proof drift node={nodeIndex} text={resultText}"
        return false
    err = ""
    return true

@borrows
fn compilerCsgTypedNodeAuthorityCandidateBuildInto(
        ir: texpr.TypedExprIr,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        out: var CompilerCsgTypedNodeAuthorityCandidate,
        err: var str): bool =
    if out.exactTypeIds.len != 0 ||
       out.proofKinds.len != 0 ||
       out.valueKinds.len != 0 ||
       out.ownerSources.len != 0 ||
       out.ownerDeclarations.len != 0 ||
       out.ownershipPremises.len != 0 ||
       out.captureStarts.len != 0 ||
       out.captureCounts.len != 0 ||
       out.captureCompletions.len != 0:
        err = " compiler csg: typed-node authority candidate destination is not empty"
        return false
    if receipt.sourceSidecars.len != typeArena.producerSourceCount ||
       !texpr.TypedExprIrNodes2ShapeComplete(ir):
        err = " compiler csg: typed-node authority source/SoA domain split"
        return false
    let reachableCount =
        semanticGraph.reachableFunctionTable.graphNodeIds.len
    var maximumGraphNodeId: int32
    for reachableRow in 0..<reachableCount:
        let graphNodeId =
            semanticGraph.reachableFunctionTable.graphNodeIds[
                reachableRow]
        if graphNodeId <= 0:
            err = " compiler csg: typed-node reachable graph identity invalid"
            return false
        if graphNodeId > maximumGraphNodeId:
            maximumGraphNodeId = graphNodeId
    var reachableByGraphNodeId: int32[]
    setLen(reachableByGraphNodeId, maximumGraphNodeId + 1)
    for graphNodeId in 0..<reachableByGraphNodeId.len:
        reachableByGraphNodeId[graphNodeId] = -1
    for reachableRow in 0..<reachableCount:
        let graphNodeId =
            semanticGraph.reachableFunctionTable.graphNodeIds[
                reachableRow]
        if reachableByGraphNodeId[graphNodeId] >= 0:
            err = " compiler csg: typed-node reachable graph identity duplicated"
            return false
        reachableByGraphNodeId[graphNodeId] = reachableRow
    let typedFunctionCount = ir.functions2_functionNameIds.len
    if semanticGraph.typedIrTable.functionGraphNodeIds.len !=
           typedFunctionCount ||
       semanticGraph.typedIrTable.functionSourceIndexes.len !=
           typedFunctionCount:
        err = " compiler csg: typed-node typed-function domain split"
        return false
    var reachableByTypedFunction: int32[]
    setLen(reachableByTypedFunction, typedFunctionCount)
    for typedFunctionIndex in 0..<typedFunctionCount:
        let graphNodeId =
            semanticGraph.typedIrTable.functionGraphNodeIds[
                typedFunctionIndex]
        if graphNodeId <= 0 ||
           graphNodeId >= reachableByGraphNodeId.len ||
           reachableByGraphNodeId[graphNodeId] < 0:
            err = Fmt" compiler csg: typed-node function graph join missing function={typedFunctionIndex}"
            return false
        reachableByTypedFunction[typedFunctionIndex] =
            reachableByGraphNodeId[graphNodeId]
    var declarationStarts: int32[]
    setLen(declarationStarts, typeArena.producerSourceCount + 1)
    for sourceId in 0..<typeArena.producerSourceCount:
        declarationStarts[sourceId + 1] =
            declarationStarts[sourceId] +
            receipt.sourceSidecars[sourceId].declarationKinds.len
    var declarationRowsByFunctionRow: int32[]
    setLen(declarationRowsByFunctionRow,
           declarationStarts[typeArena.producerSourceCount])
    for row in 0..<declarationRowsByFunctionRow.len:
        declarationRowsByFunctionRow[row] = -1
    for sourceId in 0..<typeArena.producerSourceCount:
        let sidecar = receipt.sourceSidecars[sourceId]
        for declarationRow in 0..<sidecar.declarationKinds.len:
            if sidecar.declarationKinds[declarationRow] !=
                   Int32(parser.ParserDeclarationFunction):
                continue
            let functionRow =
                sidecar.declarationFunctionRows[declarationRow]
            let directRow =
                declarationStarts[sourceId] + functionRow
            if functionRow < 0 ||
               functionRow >= sidecar.declarationKinds.len ||
               directRow < 0 ||
               directRow >= declarationRowsByFunctionRow.len ||
               declarationRowsByFunctionRow[directRow] != -1:
                err = " compiler csg: typed-node function declaration direct index conflict"
                return false
            declarationRowsByFunctionRow[directRow] =
                declarationRow
    var parserNodeStarts: int32[]
    var parserNodeCounts: int32[]
    setLen(parserNodeStarts, receipt.sourceSidecars.len)
    setLen(parserNodeCounts, receipt.sourceSidecars.len)
    var parserNodeCursor: int32
    for sourceId in 0..<receipt.sourceSidecars.len:
        parserNodeStarts[sourceId] = parserNodeCursor
        parserNodeCounts[sourceId] =
            receipt.sourceSidecars[sourceId].nodeSpanIds.len
        parserNodeCursor =
            parserNodeCursor + parserNodeCounts[sourceId]
    var resolvedCallRowByParserNode: int32[]
    setLen(resolvedCallRowByParserNode, parserNodeCursor)
    for parserNodeSlot in 0..<resolvedCallRowByParserNode.len:
        resolvedCallRowByParserNode[parserNodeSlot] = -1
    for callRow in 0..<
            semanticGraph.resolvedCallTable.sourceIndexes.len:
        let sourceId =
            semanticGraph.resolvedCallTable.sourceIndexes[callRow]
        let parserNodeId =
            semanticGraph.resolvedCallTable.originParserNodeIds[
                callRow]
        if sourceId < 0 || sourceId >= parserNodeStarts.len ||
           parserNodeId < 0 ||
           parserNodeId >= parserNodeCounts[sourceId]:
            err = Fmt" compiler csg: typed-node call parser identity invalid call={callRow}"
            return false
        let parserNodeSlot =
            parserNodeStarts[sourceId] + parserNodeId
        if resolvedCallRowByParserNode[parserNodeSlot] >= 0:
            err = Fmt" compiler csg: typed-node call parser identity duplicated call={callRow}"
            return false
        resolvedCallRowByParserNode[parserNodeSlot] = callRow
    var typeSyntaxSourceStarts: int32[]
    setLen(typeSyntaxSourceStarts,
           typeArena.producerSourceCount + 1)
    for sourceId in 0..<typeArena.producerSourceCount:
        typeSyntaxSourceStarts[sourceId + 1] =
            typeSyntaxSourceStarts[sourceId] +
            receipt.sourceSidecars[sourceId].typeSyntaxKinds.len
    if typeSyntaxSourceStarts[typeArena.producerSourceCount] !=
           typeArena.typeSyntaxCount:
        err = " compiler csg: typed-node parser/TypeArena TypeSyntax domain split"
        return false
    var typeSyntaxRows: int32[]
    setLen(typeSyntaxRows, typeArena.typeSyntaxCount)
    for row in 0..<typeSyntaxRows.len:
        typeSyntaxRows[row] = -1
    for typeSyntaxId in 0..<typeArena.typeSyntaxCount:
        let sourceId = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxProducerSourceIndexes,
            typeSyntaxId)
        let sourceLocalRow = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxSourceLocalRows,
            typeSyntaxId)
        if sourceId < 0 ||
           sourceId >= receipt.sourceSidecars.len ||
           sourceLocalRow < 0 ||
           sourceLocalRow >=
               receipt.sourceSidecars[sourceId].typeSyntaxKinds.len ||
           receipt.sourceSidecars[sourceId].typeSyntaxKinds[
               sourceLocalRow] !=
               arenamod.ArenaArrayInt32Get(
                   typeArena.arena,
                   typeArena.typeSyntaxParserKinds,
                   typeSyntaxId):
            err = " compiler csg: typed-node TypeSyntax source-local identity drift"
            return false
        let directRow =
            typeSyntaxSourceStarts[sourceId] + sourceLocalRow
        if typeSyntaxRows[directRow] != -1:
            err = " compiler csg: typed-node TypeSyntax direct index conflict"
            return false
        typeSyntaxRows[directRow] = typeSyntaxId
    let typedNodeCount = ir.nodes2_nodeIndexs.len
    if !ir.valueDefinitionTypeArenaBound ||
       !layout.FixedBytes32Equal(
           ir.valueDefinitionTypeArenaArtifactCid,
           typeArena.artifactRaw32):
        err = " compiler csg: value-definition TypeArena artifact mismatch"
        return false
    var typedFunctionByNode: int32[]
    setLen(typedFunctionByNode, typedNodeCount)
    for nodeIndex in 0..<typedNodeCount:
        if arenamod.ArenaArrayInt32Get(
               ir.arena, ir.nodes2_nodeIndexs, nodeIndex) != nodeIndex:
            err = Fmt" compiler csg: typed-node dense identity drift node={nodeIndex}"
            return false
        typedFunctionByNode[nodeIndex] = -1
    for typedFunctionIndex in 0..<typedFunctionCount:
        let nodeStart = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_nodeStarts,
            typedFunctionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_nodeCounts,
            typedFunctionIndex)
        if nodeStart < 0 || nodeCount < 0 ||
           nodeStart + nodeCount > typedNodeCount:
            err = Fmt" compiler csg: typed-node function range invalid function={typedFunctionIndex}"
            return false
        for offset in 0..<nodeCount:
            let nodeIndex = nodeStart + offset
            if typedFunctionByNode[nodeIndex] >= 0:
                err = Fmt" compiler csg: typed-node function ranges overlap node={nodeIndex}"
                return false
            typedFunctionByNode[nodeIndex] = typedFunctionIndex
    var exactTypeIds: int32[]
    var proofKinds: int32[]
    var valueKinds: int32[]
    var ownerSources: int32[]
    var ownerDeclarations: int32[]
    var ownershipPremises: int32[]
    var captureStarts: int32[]
    var captureCounts: int32[]
    var captureCompletions: int32[]
    setLen(exactTypeIds, typedNodeCount)
    setLen(proofKinds, typedNodeCount)
    setLen(valueKinds, typedNodeCount)
    setLen(ownerSources, typedNodeCount)
    setLen(ownerDeclarations, typedNodeCount)
    setLen(ownershipPremises, typedNodeCount)
    setLen(captureStarts, typedNodeCount)
    setLen(captureCounts, typedNodeCount)
    setLen(captureCompletions, typedNodeCount)
    for nodeIndex in 0..<typedNodeCount:
        let typedFunctionIndex = typedFunctionByNode[nodeIndex]
        if typedFunctionIndex < 0:
            err = Fmt" compiler csg: typed-node owner missing node={nodeIndex}"
            return false
        let reachableRow =
            reachableByTypedFunction[typedFunctionIndex]
        ownerSources[nodeIndex] =
            semanticGraph.reachableFunctionTable.producerSourceIndexes[
                reachableRow]
        let functionRow =
            semanticGraph.reachableFunctionTable.producerDeclarationIndexes[
                reachableRow]
        if ownerSources[nodeIndex] < 0 ||
           ownerSources[nodeIndex] >= receipt.sourceSidecars.len ||
           functionRow < 0 ||
           functionRow >=
               receipt.sourceSidecars[
                   ownerSources[nodeIndex]].declarationKinds.len:
            err = Fmt" compiler csg: typed-node owner function invalid node={nodeIndex}"
            return false
        ownerDeclarations[nodeIndex] =
            declarationRowsByFunctionRow[
                declarationStarts[ownerSources[nodeIndex]] +
                functionRow]
        if ownerDeclarations[nodeIndex] < 0:
            err = Fmt" compiler csg: typed-node owner declaration invalid node={nodeIndex}"
            return false
        exactTypeIds[nodeIndex] =
            texpr.TypedExprIrNodeStructuralTypeIdAt(ir, nodeIndex)
        let opKind = ir.nodes2_opKinds[nodeIndex]
        # [nn2-nilptr] op=NilPtr 即生产者侧 nil-able 证明: typed_expr 只在
        # TypedExprIrTypeTextIsNilPtrInContext 通过后才铸造 NilPtr 节点, 而
        # TypeArena 对 nil-able 形没有生产侧发布路由(ptr 被保留标量权威显式
        # 排除, ref/alias 名无文本→TypeId 通道); 后端 NilPtr 发射
        # (primary_object_plan node-eval 两臂)由 opKind 单独定 LocalPtrTag,
        # 不消费 TypeId 列。故 -1 仅对此生产者已证类放行: 界内 id 照常采纳,
        # 越界仍 fail-closed, 其余 op 缺 TypeId 仍 hard-fail。
        if exactTypeIds[nodeIndex] < 0 &&
           opKind != texpr.TypedExprIrOpNilPtr:
            # [w40] verdict carries the node triple so the missing production
            # site on the typed_expr side is identifiable without a rebake.
            err = Fmt" compiler csg: typed-node exact producer TypeId missing node={nodeIndex} op={opKind} o0={arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand0NodeIndexs, nodeIndex)} o1={arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand1NodeIndexs, nodeIndex)}"
            return false
        if exactTypeIds[nodeIndex] >= typeArena.typeCount:
            err = Fmt" compiler csg: typed-node exact producer TypeId out of range node={nodeIndex} op={opKind} tid={exactTypeIds[nodeIndex]} types={typeArena.typeCount}"
            return false
        let funcRefDomain = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_funcRefTargetDomains,
            nodeIndex)
        let funcRefDeclarationRow = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_funcRefCallDeclarationRows,
            nodeIndex)
        if opKind == texpr.TypedExprIrOpFuncRef:
            let declarationIndex =
                texpr.TypedExprIrCallDeclarationBuildIndex(ir)
            if funcRefDomain !=
                   Int32(
                       texpr.TypedExprFuncRefTargetDomainCallDeclaration) ||
               declarationIndex == nil || declarationIndex.released ||
               !declarationIndex.callDeclarationSealed ||
               funcRefDeclarationRow < 0 ||
               funcRefDeclarationRow >=
                   declarationIndex.callDeclarationKinds.len ||
               declarationIndex.callDeclarationKinds[
                   funcRefDeclarationRow] !=
                   texpr.TypedExprCallDeclarationFunction:
                err = Fmt" compiler csg: typed-node FuncRef declaration authority invalid node={nodeIndex} domain={funcRefDomain} row={funcRefDeclarationRow}"
                return false
        elif funcRefDomain !=
                 Int32(texpr.TypedExprFuncRefTargetDomainNone) ||
             funcRefDeclarationRow != -1:
            err = Fmt" compiler csg: non-FuncRef typed node carries target authority node={nodeIndex} domain={funcRefDomain} row={funcRefDeclarationRow}"
            return false
        let scalarKind = compilerCsgTypedNodeScalarKind(opKind)
        if scalarKind !=
               typearena.TypedExprStructuralScalarInvalid:
            let expectedScalarTypeId =
                typearena.TypedExprTypeArenaReservedScalarTypeId(
                    typeArena, scalarKind)
            if exactTypeIds[nodeIndex] != expectedScalarTypeId:
                err = Fmt" compiler csg: typed-node scalar TypeId drift node={nodeIndex}"
                return false
        elif opKind == texpr.TypedExprIrOpArgLink ||
             opKind == texpr.TypedExprIrOpNeg:
            let operand = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_operand0NodeIndexs,
                nodeIndex)
            if operand < 0 || operand >= nodeIndex ||
               exactTypeIds[nodeIndex] != exactTypeIds[operand]:
                err = Fmt" compiler csg: typed-node operand TypeId drift node={nodeIndex}"
                return false
        elif opKind == texpr.TypedExprIrOpCallExpr:
            let originParserNodeId = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_originParserNodeIds,
                nodeIndex)
            if originParserNodeId < 0 ||
               originParserNodeId >=
                   parserNodeCounts[ownerSources[nodeIndex]]:
                err = Fmt" compiler csg: typed-node call origin missing node={nodeIndex}"
                return false
            let calleeNodeIndex = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_operand2NodeIndexs, nodeIndex)
            if calleeNodeIndex >= 0:
                if calleeNodeIndex >= nodeIndex ||
                   ir.nodes2_opKinds[calleeNodeIndex] !=
                       texpr.TypedExprIrOpFieldGet ||
                   arenamod.ArenaArrayInt32Get(
                       ir.arena,
                       ir.nodes2_callDeclarationIndexes,
                       nodeIndex) != -1 ||
                   ir.nodes2_callKinds[nodeIndex] !=
                       texpr.TypedExprCallNone:
                    err = Fmt" compiler csg: indirect field CallExpr coordinate invalid node={nodeIndex}"
                    return false
                var functionTypeId =
                    compilerCsgExactLayoutPhysicalTypeId(
                        typeArena, exactTypeIds[calleeNodeIndex])
                var visitedFunctionTypes: bool[]
                setLen(visitedFunctionTypes, typeArena.typeCount)
                while true:
                    if functionTypeId < 0 ||
                       functionTypeId >= typeArena.typeCount ||
                       visitedFunctionTypes[functionTypeId]:
                        err = Fmt" compiler csg: indirect field function TypeId chain invalid node={nodeIndex}"
                        return false
                    if typearena.TypedExprTypeArenaKindAt(
                           typeArena, functionTypeId) ==
                       typearena.TypedExprStructuralTypeFunction:
                        break
                    visitedFunctionTypes[functionTypeId] = true
                    let functionKind =
                        typearena.TypedExprTypeArenaKindAt(
                            typeArena, functionTypeId)
                    if functionKind !=
                           typearena.TypedExprStructuralTypeAlias &&
                       functionKind !=
                           typearena.TypedExprStructuralTypeBorrow &&
                       functionKind !=
                           typearena.TypedExprStructuralTypeApply:
                        err = Fmt" compiler csg: indirect field is not structural function node={nodeIndex} type_id={functionTypeId}"
                        return false
                    let functionChildStart =
                        arenamod.ArenaArrayInt32Get(
                            typeArena.arena,
                            typeArena.childStarts,
                            functionTypeId)
                    let functionChildCount =
                        arenamod.ArenaArrayInt32Get(
                            typeArena.arena,
                            typeArena.childCounts,
                            functionTypeId)
                    if functionChildCount <= 0:
                        err = Fmt" compiler csg: indirect field function child missing node={nodeIndex}"
                        return false
                    functionTypeId =
                        arenamod.ArenaArrayInt32Get(
                            typeArena.arena,
                            typeArena.childTypeIds,
                            functionChildStart)
                let functionChildStart =
                    arenamod.ArenaArrayInt32Get(
                        typeArena.arena,
                        typeArena.childStarts,
                        functionTypeId)
                let functionChildCount =
                    arenamod.ArenaArrayInt32Get(
                        typeArena.arena,
                        typeArena.childCounts,
                        functionTypeId)
                let functionParamCount =
                    arenamod.ArenaArrayInt32Get(
                        typeArena.arena,
                        typeArena.functionParamCounts,
                        functionTypeId)
                var expectedReturnTypeId =
                    typearena.TypedExprTypeArenaReservedScalarTypeId(
                        typeArena,
                        typearena.TypedExprStructuralScalarVoid)
                if functionChildCount == functionParamCount + 1:
                    expectedReturnTypeId =
                        arenamod.ArenaArrayInt32Get(
                            typeArena.arena,
                            typeArena.childTypeIds,
                            functionChildStart +
                                functionChildCount - 1)
                elif functionChildCount != functionParamCount:
                    err = Fmt" compiler csg: indirect field function signature invalid node={nodeIndex}"
                    return false
                if exactTypeIds[nodeIndex] !=
                   expectedReturnTypeId:
                    err = Fmt" compiler csg: indirect field call result TypeId drift node={nodeIndex}"
                    return false
            else:
                let callDeclarationIndex =
                    arenamod.ArenaArrayInt32Get(
                        ir.arena,
                        ir.nodes2_callDeclarationIndexes,
                        nodeIndex)
                let callKind = ir.nodes2_callKinds[nodeIndex]
                if callDeclarationIndex == -1 &&
                   callKind == texpr.TypedExprCallBuiltin:
                    if !compilerCsgTypedNodeValidateBuiltinCallResultType(
                           ir,
                           typeArena,
                           receipt,
                           ownerSources[nodeIndex],
                           typeSyntaxSourceStarts,
                           typeSyntaxRows,
                           nodeIndex,
                           exactTypeIds[nodeIndex],
                           err):
                        return false
                elif callDeclarationIndex == -1 &&
                     callKind == texpr.TypedExprCallNone:
                    # [phaseB-csg] 命名聚合构造占位类别：占位 CallExpr 无
                    # declaration row 可查（callDeclarationIndex=-1）且无
                    # callee 节点，typed-node 审计的 resolved-call 证明按
                    # builtin new 同一权威链取——节点 resultType/callTarget
                    # 指向的本源 ParserDeclarationType 声明行经 TypeSyntax
                    # root 冻结列核对其已绑 exactTypeId；坐标 miss 一律
                    # fail-closed。
                    if !compilerCsgTypedNodeValidateNamedAggregateConstructorCall(
                           ir,
                           typeArena,
                           receipt,
                           ownerSources[nodeIndex],
                           typeSyntaxSourceStarts,
                           typeSyntaxRows,
                           nodeIndex,
                           exactTypeIds[nodeIndex],
                           err):
                        return false
                elif callDeclarationIndex < 0:
                    err = Fmt" compiler csg: typed-node resolved call missing node={nodeIndex}"
                    return false
                else:
                    let callRow = resolvedCallRowByParserNode[
                        parserNodeStarts[ownerSources[nodeIndex]] +
                            originParserNodeId]
                    if callRow < 0:
                        err = Fmt" compiler csg: typed-node resolved call missing node={nodeIndex}"
                        return false
                    let targetGraphNodeId =
                        semanticGraph.resolvedCallTable.targetGraphNodeIds[
                            callRow]
                    if semanticGraph.resolvedCallTable.callTargetImportcFlags[
                           callRow]:
                        # [nn1-importc-arm] 合同对齐: importc 行 graph node 恒
                        # -1(表校验 importc 臂与 "resolved importc target has
                        # graph node" 即 fail 的 strict validate 同钉), 本审计
                        # 此前无条件要求 >0 与同文件合同自相矛盾——importc 直调
                        # (含非别名形)永远不可能通过。importc 臂按 resolved-call
                        # 事实行自带的 target producer 坐标(target declaration
                        # strict validate 已对 parser receipt 逐行核对)走
                        # TypeArena function 行取返回 TypeId, 与 Cheng 行同一
                        # 权威通道同源比对; graph node 必须恰 -1, 违之即合同
                        # 漂移 fail-closed。
                        if targetGraphNodeId != -1:
                            err = Fmt" compiler csg: typed-node importc target carries graph node node={nodeIndex} row={callRow} graph_node={targetGraphNodeId}"
                            return false
                        let importcProducerSourceIndex =
                            semanticGraph.resolvedCallTable.
                                targetProducerSourceIndexes[callRow]
                        let importcProducerDeclarationOrdinal =
                            semanticGraph.resolvedCallTable.
                                targetProducerDeclarationOrdinals[callRow]
                        if importcProducerSourceIndex < 0 ||
                           importcProducerSourceIndex >=
                               receipt.sourceSidecars.len ||
                           importcProducerDeclarationOrdinal < 0:
                            err = Fmt" compiler csg: typed-node importc target coordinate invalid node={nodeIndex} row={callRow} source={importcProducerSourceIndex} ordinal={importcProducerDeclarationOrdinal}"
                            return false
                        let importcExpectedReturnTypeId =
                            typearena.TypedExprTypeArenaFunctionReturnTypeId(
                                typeArena,
                                importcProducerSourceIndex,
                                importcProducerDeclarationOrdinal)
                        if exactTypeIds[nodeIndex] !=
                           importcExpectedReturnTypeId:
                            err = Fmt" compiler csg: typed-node importc call result TypeId drift node={nodeIndex}"
                            return false
                    else:
                        if targetGraphNodeId <= 0 ||
                           targetGraphNodeId >= reachableByGraphNodeId.len ||
                           reachableByGraphNodeId[targetGraphNodeId] < 0:
                            err = Fmt" compiler csg: typed-node call target missing node={nodeIndex}"
                            return false
                        let targetReachableRow =
                            reachableByGraphNodeId[targetGraphNodeId]
                        let expectedReturnTypeId =
                            typearena.TypedExprTypeArenaFunctionReturnTypeId(
                                typeArena,
                                semanticGraph.reachableFunctionTable.
                                    producerSourceIndexes[targetReachableRow],
                                semanticGraph.reachableFunctionTable.
                                    producerDeclarationIndexes[targetReachableRow])
                        if exactTypeIds[nodeIndex] !=
                           expectedReturnTypeId:
                            err = Fmt" compiler csg: typed-node call result TypeId drift node={nodeIndex}"
                            return false
        elif opKind == texpr.TypedExprIrOpFieldGet:
            let ownerNode = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_operand0NodeIndexs,
                nodeIndex)
            if ownerNode < 0 || ownerNode >= nodeIndex:
                err = Fmt" compiler csg: typed-node field owner missing node={nodeIndex}"
                return false
            let fieldSourceId = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_fieldProducerSourceIndexes,
                nodeIndex)
            let ownerDeclarationRow = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_fieldOwnerDeclarationSourceLocalRows,
                nodeIndex)
            let fieldDeclarationRow = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_fieldDeclarationSourceLocalRows,
                nodeIndex)
            let fieldOrdinal = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_fieldOrdinals, nodeIndex)
            let builtinRaw = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_fieldBuiltinKinds, nodeIndex)
            if fieldSourceId < 0 ||
               fieldSourceId >= receipt.sourceSidecars.len ||
               fieldOrdinal < 0:
                err = Fmt" compiler csg: typed-node field coordinate invalid node={nodeIndex}"
                return false
            if builtinRaw ==
                   Int32(texpr.TypedExprLayoutBuiltinNone):
                var exactOwnerTypeId: int32
                var exactFieldTypeId: int32
                var exactMemberRow: int32
                if !compilerCsgExactFieldTypeIdInto(
                       receipt,
                       typeArena,
                       typeSyntaxSourceStarts,
                       typeSyntaxRows,
                       fieldSourceId,
                       ownerDeclarationRow,
                       fieldDeclarationRow,
                       fieldOrdinal,
                       exactOwnerTypeId,
                       exactFieldTypeId,
                       exactMemberRow,
                       err):
                    return false
                if compilerCsgExactLayoutPhysicalTypeId(
                       typeArena, exactTypeIds[ownerNode]) !=
                       compilerCsgExactLayoutPhysicalTypeId(
                           typeArena, exactOwnerTypeId) ||
                   exactTypeIds[nodeIndex] != exactFieldTypeId:
                    err = Fmt" compiler csg: typed-node field TypeId drift node={nodeIndex}"
                    return false
            elif !compilerCsgExactLayoutBuiltinFieldMatches(
                     typeArena,
                     builtinRaw,
                     fieldOrdinal,
                     exactTypeIds[ownerNode],
                     exactTypeIds[nodeIndex],
                     arenamod.ArenaArrayInt32Get(
                         ir.arena,
                         ir.nodes2_fieldOffsetBytes,
                         nodeIndex),
                     arenamod.ArenaArrayInt32Get(
                         ir.arena,
                         ir.nodes2_fieldSizeBytes,
                         nodeIndex),
                     arenamod.ArenaArrayInt32Get(
                         ir.arena,
                         ir.nodes2_fieldAlignBytes,
                         nodeIndex)):
                err = Fmt" compiler csg: typed-node builtin field TypeId drift node={nodeIndex}"
                return false
        elif opKind == texpr.TypedExprIrOpIndexGet:
            let ownerNode = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_operand0NodeIndexs,
                nodeIndex)
            if ownerNode < 0 || ownerNode >= nodeIndex:
                err = Fmt" compiler csg: typed-node index owner missing node={nodeIndex}"
                return false
            let ownerTypeId =
                compilerCsgExactLayoutPhysicalTypeId(
                    typeArena, exactTypeIds[ownerNode])
            let ownerKind =
                typearena.TypedExprTypeArenaKindAt(
                    typeArena, ownerTypeId)
            if ownerKind ==
                   typearena.TypedExprStructuralTypeSequence ||
               ownerKind ==
                   typearena.TypedExprStructuralTypeFixedArray:
                let childStart = arenamod.ArenaArrayInt32Get(
                    typeArena.arena,
                    typeArena.childStarts,
                    ownerTypeId)
                let childCount = arenamod.ArenaArrayInt32Get(
                    typeArena.arena,
                    typeArena.childCounts,
                    ownerTypeId)
                if childCount != 1 ||
                   exactTypeIds[nodeIndex] !=
                       arenamod.ArenaArrayInt32Get(
                           typeArena.arena,
                           typeArena.childTypeIds,
                           childStart):
                    err = Fmt" compiler csg: typed-node index element TypeId drift node={nodeIndex}"
                    return false
        var managed: bool
        if exactTypeIds[nodeIndex] < 0:
            # [nn2-nilptr] 已放行类的尾段走生产者列权威: 无 TypeArena 行可
            # 派生, proof 镜像 retained 列(镜像恒等即零漂移可证), valueKind
            # 按 NilPtr 生产者拼写恒 Ordinary(typedExprSnapshotValueKindForOp
            # 默认臂), exprClass 必须具体——typed_expr 只在 nil-able 已证且
            # class 已定时铸造该类, Unknown/None 即生产者漏章 fail-closed。
            if opKind != texpr.TypedExprIrOpNilPtr:
                err = Fmt" compiler csg: typed-node exact producer TypeId missing node={nodeIndex} op={opKind} o0={arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand0NodeIndexs, nodeIndex)} o1={arenamod.ArenaArrayInt32Get(ir.arena, ir.nodes2_operand1NodeIndexs, nodeIndex)}"
                return false
            proofKinds[nodeIndex] = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_resultTypeProofKinds, nodeIndex)
            valueKinds[nodeIndex] =
                Int32(texpr.TypedExprSnapshotValueOrdinary)
            let nilExprClass = ir.nodes2_exprClasses[nodeIndex]
            if nilExprClass != texpr.TypedExprExprOwned &&
               nilExprClass != texpr.TypedExprExprBorrowed &&
               nilExprClass != texpr.TypedExprExprUnmanaged:
                err = Fmt" compiler csg: typed-node nil literal ownership premise missing node={nodeIndex} expr_class={Int32(nilExprClass)}"
                return false
        else:
            proofKinds[nodeIndex] =
                texpr.TypedExprSnapshotTypeProofKindForTypeArenaAt(
                    typeArena, exactTypeIds[nodeIndex])
            managed = typearena.TypedExprTypeArenaManagedAt(
                typeArena, exactTypeIds[nodeIndex])
            let retainedProofKind = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_resultTypeProofKinds, nodeIndex)
            if retainedProofKind !=
                   texpr.TypedExprSnapshotTypeProofNone &&
               retainedProofKind != proofKinds[nodeIndex]:
                err = Fmt" compiler csg: typed-node proof kind drift node={nodeIndex}"
                return false
            if (retainedProofKind !=
                    texpr.TypedExprSnapshotTypeProofNone ||
                ir.nodes2_resultTypeManagedFlags[nodeIndex] ||
                ir.nodes2_resultTypeSendFlags[nodeIndex] ||
                ir.nodes2_resultTypeSyncFlags[nodeIndex]) &&
               (ir.nodes2_resultTypeManagedFlags[nodeIndex] != managed ||
                ir.nodes2_resultTypeSendFlags[nodeIndex] !=
                    typearena.TypedExprTypeArenaSendAt(
                        typeArena, exactTypeIds[nodeIndex]) ||
                ir.nodes2_resultTypeSyncFlags[nodeIndex] !=
                    typearena.TypedExprTypeArenaSyncAt(
                        typeArena, exactTypeIds[nodeIndex])):
                err = Fmt" compiler csg: typed-node structural trait drift node={nodeIndex}"
                return false
            let exactTypeKind =
                typearena.TypedExprTypeArenaKindAt(
                    typeArena, exactTypeIds[nodeIndex])
            if opKind == texpr.TypedExprIrOpFuncRef:
                if exactTypeKind !=
                       typearena.TypedExprStructuralTypeScalar:
                    err = Fmt" compiler csg: typed-node function-address type invalid node={nodeIndex}"
                    return false
                valueKinds[nodeIndex] =
                    Int32(texpr.TypedExprSnapshotValueFunctionAddress)
            elif opKind == texpr.TypedExprIrOpClosure:
                if exactTypeKind !=
                       typearena.TypedExprStructuralTypeFunction:
                    err = Fmt" compiler csg: typed-node closure type invalid node={nodeIndex}"
                    return false
                valueKinds[nodeIndex] =
                    Int32(texpr.TypedExprSnapshotValueClosure)
            elif exactTypeKind ==
                     typearena.TypedExprStructuralTypeFunction:
                err = Fmt" compiler csg: typed-node closure completion missing node={nodeIndex}"
                return false
            else:
                valueKinds[nodeIndex] =
                    Int32(texpr.TypedExprSnapshotValueOrdinary)
        let exprClass = ir.nodes2_exprClasses[nodeIndex]
        # [w40] Ownership family follows the physical storage type. A `var T`
        # parameter publishes the exact TypeSyntax TypeId, which is the
        # StructuralTypeBorrow wrapper for `var T`; the arena stamps Borrow
        # rows with the BorrowedView rule whose managed/send/sync columns are
        # zero (they describe the wrapper, not the view target family). The
        # text-side expr-class authority strips `var` and classifies by the
        # target type (`var Box` -> Borrowed, `var int32` -> Unmanaged,
        # `var int32[]` -> Borrowed), so the raw ManagedAt used for the
        # structural trait equality above systematically disagrees with it
        # for every managed `var T` parameter. Peel Alias/Apply/Borrow to the
        # physical target (same helper already used for the field/index owner
        # identities in this walk); Alias/Apply propagate the target flags so
        # only Borrow-wrapped rows change family here.
        var ownershipManaged: bool
        if exactTypeIds[nodeIndex] < 0:
            # [nn2-nilptr] 类内物理剥离不可用(无 id): 生产者 exprClass 在尾段
            # 类分支已验具体, 直接当所有权前提——Owned/Borrowed 即托管族,
            # Unmanaged 即非托管, 与物理剥离在 NilPtr 两族上逐值同谱。
            ownershipManaged = exprClass != texpr.TypedExprExprUnmanaged
        else:
            let ownershipPhysicalTypeId =
                compilerCsgExactLayoutPhysicalTypeId(
                    typeArena, exactTypeIds[nodeIndex])
            if ownershipPhysicalTypeId < 0:
                err = Fmt" compiler csg: typed-node ownership physical TypeId invalid node={nodeIndex}"
                return false
            ownershipManaged =
                typearena.TypedExprTypeArenaManagedAt(
                    typeArena, ownershipPhysicalTypeId) ||
                opKind == texpr.TypedExprIrOpClosure
        if !ownershipManaged:
            if exprClass != texpr.TypedExprExprUnmanaged:
                err = Fmt" compiler csg: typed-node unmanaged ownership premise drift node={nodeIndex}"
                return false
        elif exprClass != texpr.TypedExprExprOwned &&
             exprClass != texpr.TypedExprExprBorrowed:
            err = Fmt" compiler csg: typed-node managed ownership premise missing node={nodeIndex}"
            return false
        if exprClass == texpr.TypedExprExprOwned:
            ownershipPremises[nodeIndex] =
                Int32(texpr.TypedExprNodeOwnershipPremiseOwned)
        elif exprClass == texpr.TypedExprExprBorrowed:
            ownershipPremises[nodeIndex] =
                Int32(texpr.TypedExprNodeOwnershipPremiseBorrowed)
        else:
            ownershipPremises[nodeIndex] =
                Int32(texpr.TypedExprNodeOwnershipPremiseUnmanaged)
        captureStarts[nodeIndex] =
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_captureStarts, nodeIndex)
        captureCounts[nodeIndex] =
            arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_captureCounts, nodeIndex)
        if captureStarts[nodeIndex] < 0 ||
           captureCounts[nodeIndex] < 0 ||
           captureStarts[nodeIndex] >
               ir.captures2_valueDefinitionRows.len -
                   captureCounts[nodeIndex] ||
           (opKind != texpr.TypedExprIrOpClosure &&
            captureCounts[nodeIndex] != 0) ||
           arenamod.ArenaArrayInt32Get(
               ir.arena, ir.nodes2_valueKinds, nodeIndex) !=
               valueKinds[nodeIndex]:
            err = Fmt" compiler csg: typed-node value/capture authority drift node={nodeIndex}"
            return false
        captureCompletions[nodeIndex] =
            captureCounts[nodeIndex] == 0 ?
                Int32(texpr.TypedExprNodeCaptureExactEmpty) :
                Int32(texpr.TypedExprNodeCaptureExactRows)
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(ir)
    for definitionRow in 0..<definitionCount:
        let definingNodeIndex =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                ir, definitionRow)
        if definingNodeIndex < 0 ||
           definingNodeIndex >= typedNodeCount:
            err = Fmt" compiler csg: value-definition node subprojection invalid row={definitionRow}"
            return false
        let storedTypeId =
            texpr.TypedExprValueDefinitionExactTypeIdAt(
                ir, definitionRow)
        let storedProofKind =
            arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.valueDefinitions_proofKinds,
                definitionRow)
        if storedTypeId != exactTypeIds[definingNodeIndex] ||
           storedProofKind !=
               proofKinds[definingNodeIndex] ||
           !texpr.TypedExprValueDefinitionOwnershipMatchesNodeAt(
               ir, definitionRow):
            err = Fmt" compiler csg: value-definition node subprojection mismatch row={definitionRow}"
            return false
    out.exactTypeIds = exactTypeIds
    out.proofKinds = proofKinds
    out.valueKinds = valueKinds
    out.ownerSources = ownerSources
    out.ownerDeclarations = ownerDeclarations
    out.ownershipPremises = ownershipPremises
    out.captureStarts = captureStarts
    out.captureCounts = captureCounts
    out.captureCompletions = captureCompletions
    err = ""
    return true

@borrows
fn compilerCsgTypedNodeAuthorityReplayValidateInto(
        ir: texpr.TypedExprIr,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: CompilerCsgSemanticGraph,
        err: var str): bool =
    var candidate: CompilerCsgTypedNodeAuthorityCandidate
    if !compilerCsgTypedNodeAuthorityCandidateBuildInto(
           ir, receipt, typeArena, semanticGraph, candidate, err):
        return false
    let typedNodeCount = ir.nodes2_nodeIndexs.len
    for nodeIndex in 0..<typedNodeCount:
        if arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_exactTypeArenaIds,
               nodeIndex) != candidate.exactTypeIds[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_valueKinds,
               nodeIndex) != candidate.valueKinds[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_ownerProducerSourceIndexes,
               nodeIndex) != candidate.ownerSources[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_ownerDeclarationSourceLocalRows,
               nodeIndex) != candidate.ownerDeclarations[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_ownershipPremiseKinds,
               nodeIndex) != candidate.ownershipPremises[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_captureStarts,
               nodeIndex) != candidate.captureStarts[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_captureCounts,
               nodeIndex) != candidate.captureCounts[nodeIndex] ||
           arenamod.ArenaArrayInt32Get(
               ir.arena,
               ir.nodes2_captureCompletionKinds,
               nodeIndex) != candidate.captureCompletions[nodeIndex]:
            err = Fmt" compiler csg: typed-node authority replay mismatch node={nodeIndex}"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgTypedNodeAuthorityBindInto(
        ir: var texpr.TypedExprIr,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        semanticGraph: var CompilerCsgSemanticGraph,
        err: var str): bool =
    var typeArenaErr: str
    if !typearena.TypedExprTypeArenaStrictValidateInto(
           typeArena, typeArenaErr):
        err = typeArenaErr
        return false
    var candidate: CompilerCsgTypedNodeAuthorityCandidate
    if !compilerCsgTypedNodeAuthorityCandidateBuildInto(
           share(ir),
           receipt,
           typeArena,
           share(semanticGraph),
           candidate,
           err):
        return false
    if ir.nodeAuthorityTypeArenaBound ||
       !layout.FixedBytes32Equal(
           ir.nodeAuthorityTypeArenaArtifactCid,
           layout.FixedBytes32()):
        err = " compiler csg: typed-node authority destination prebound"
        return false
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.nodes2_resultTypeProofKinds,
            nodeIndex,
            candidate.proofKinds[nodeIndex])
        var managedFlag: bool
        var sendFlag: bool
        var syncFlag: bool
        if candidate.exactTypeIds[nodeIndex] >= 0:
            managedFlag =
                typearena.TypedExprTypeArenaManagedAt(
                    typeArena, candidate.exactTypeIds[nodeIndex])
            sendFlag =
                typearena.TypedExprTypeArenaSendAt(
                    typeArena, candidate.exactTypeIds[nodeIndex])
            syncFlag =
                typearena.TypedExprTypeArenaSyncAt(
                    typeArena, candidate.exactTypeIds[nodeIndex])
        # [np-nilptr] 这里 -1 只能是 [nn2-nilptr] 已证 NilPtr 类(候选构建对
        # 非 NilPtr 的 <0 与一切 >=typeCount 都已 hard-fail)。NilPtr 无
        # TypeArena 行是合法态(生产者侧 nil-able 证明, 非数据缺失), 跳过
        # TypeArena 访问, 三旗按 NilPtr 生产者拼写恒 false: 后端 NilPtr
        # 发射由 opKind 单独定 LocalPtrTag 不消费旗列, nil 字面量自身无
        # RC 义务。fail-closed 零弱化: 访问器内部界检对其他全部调用点原样。
        ir.nodes2_resultTypeManagedFlags[nodeIndex] = managedFlag
        ir.nodes2_resultTypeSendFlags[nodeIndex] = sendFlag
        ir.nodes2_resultTypeSyncFlags[nodeIndex] = syncFlag
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.nodes2_exactTypeArenaIds,
            nodeIndex,
            candidate.exactTypeIds[nodeIndex])
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.nodes2_ownerProducerSourceIndexes,
            nodeIndex,
            candidate.ownerSources[nodeIndex])
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.nodes2_ownerDeclarationSourceLocalRows,
            nodeIndex,
            candidate.ownerDeclarations[nodeIndex])
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.nodes2_ownershipPremiseKinds,
            nodeIndex,
            candidate.ownershipPremises[nodeIndex])
        arenamod.ArenaArrayInt32Set(
            ir.arena,
            ir.nodes2_captureCompletionKinds,
            nodeIndex,
            candidate.captureCompletions[nodeIndex])
    ir.nodeAuthorityTypeArenaArtifactCid =
        typeArena.artifactRaw32
    ir.nodeAuthorityTypeArenaBound = true
    return texpr.TypedExprNodeAuthorityStrictValidateInto(
        ir, typeArena, err)

@borrows
fn compilerCsgFnPtrPhysicalFunctionTypeId(
        typeArena: typearena.TypedExprTypeArena,
        typeIdRaw: int32,
        err: var str): int32 =
    if typeArena == nil || !typeArena.complete ||
       typeIdRaw < 0 || typeIdRaw >= typeArena.typeCount:
        err = " compiler csg: fnptr field TypeId invalid"
        return -1
    var visited: bool[]
    setLen(visited, typeArena.typeCount)
    var typeId = typeIdRaw
    while true:
        if typeId < 0 || typeId >= typeArena.typeCount ||
           visited[typeId]:
            err = " compiler csg: fnptr field TypeId chain invalid"
            return -1
        if typearena.TypedExprTypeArenaKindAt(typeArena, typeId) ==
           typearena.TypedExprStructuralTypeFunction:
            err = ""
            return typeId
        visited[typeId] = true
        let kind = typearena.TypedExprTypeArenaKindAt(
            typeArena, typeId)
        if kind != typearena.TypedExprStructuralTypeAlias &&
           kind != typearena.TypedExprStructuralTypeBorrow &&
           kind != typearena.TypedExprStructuralTypeApply:
            err = " compiler csg: fnptr field TypeId is not callable"
            return -1
        let childStart = arenamod.ArenaArrayInt32Get(
            typeArena.arena, typeArena.childStarts, typeId)
        let childCount = arenamod.ArenaArrayInt32Get(
            typeArena.arena, typeArena.childCounts, typeId)
        if childCount <= 0:
            err = " compiler csg: fnptr field TypeId child missing"
            return -1
        typeId = arenamod.ArenaArrayInt32Get(
            typeArena.arena, typeArena.childTypeIds, childStart)

@borrows
fn compilerCsgFunctionInterfaceCid(
        typeArena: typearena.TypedExprTypeArena,
        fieldTypeId: int32,
        err: var str): layout.FixedBytes32 =
    let functionTypeId = compilerCsgFnPtrPhysicalFunctionTypeId(
        typeArena, fieldTypeId, err)
    if functionTypeId < 0:
        return layout.FixedBytes32()
    let childStart = arenamod.ArenaArrayInt32Get(
        typeArena.arena, typeArena.childStarts, functionTypeId)
    let childCount = arenamod.ArenaArrayInt32Get(
        typeArena.arena, typeArena.childCounts, functionTypeId)
    let paramCount = arenamod.ArenaArrayInt32Get(
        typeArena.arena,
        typeArena.functionParamCounts,
        functionTypeId)
    if paramCount < 0 || paramCount > childCount ||
       childCount - paramCount > 1:
        err = " compiler csg: fnptr field interface shape invalid"
        return layout.FixedBytes32()
    var buf: layout.ByteBuf = layout.ByteBufInit(
        96 + childCount * 4)
    CompilerCsgAppendText(
        buf, "cheng.compiler.csg.function_interface")
    CompilerCsgAppendFixed32(buf, typeArena.artifactRaw32)
    CompilerCsgAppendU32BE(buf, fieldTypeId)
    CompilerCsgAppendU32BE(buf, functionTypeId)
    CompilerCsgAppendU32BE(buf, paramCount)
    CompilerCsgAppendU32BE(buf, childCount)
    for childOffset in 0..<childCount:
        CompilerCsgAppendU32BE(
            buf,
            arenamod.ArenaArrayInt32Get(
                typeArena.arena,
                typeArena.childTypeIds,
                childStart + childOffset))
    err = ""
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgFnPtrFieldCallTableStrictValidateInto(
        typedIr: var texpr.TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        table: CompilerCsgFnPtrFieldCallTable,
        err: var str): bool =
    let count = table.callNodeIndexes.len
    if !table.complete ||
       !layout.FixedBytes32Equal(
           table.typeArenaArtifactCid,
           typeArena.artifactRaw32) ||
       count != table.fieldNodeIndexes.len ||
       count != table.fieldTypeIds.len ||
       count != table.fieldStructuralKinds.len ||
       count != table.functionInterfaceCids.len:
        err = " compiler csg: fnptr field call fact shape incomplete"
        return false
    var previousCallNode: int32 = -1
    for row in 0..<count:
        let callNode = table.callNodeIndexes[row]
        let fieldNode = table.fieldNodeIndexes[row]
        if callNode <= previousCallNode ||
           callNode < 0 ||
           callNode >= typedIr.nodes2_nodeIndexs.len ||
           fieldNode < 0 || fieldNode >= callNode ||
           typedIr.nodes2_opKinds[callNode] !=
               texpr.TypedExprIrOpCallExpr ||
           typedIr.nodes2_opKinds[fieldNode] !=
               texpr.TypedExprIrOpFieldGet ||
           arenamod.ArenaArrayInt32Get(
               typedIr.arena,
               typedIr.nodes2_operand2NodeIndexs,
               callNode) != fieldNode ||
           arenamod.ArenaArrayInt32Get(
               typedIr.arena,
               typedIr.nodes2_exactTypeArenaIds,
               fieldNode) != table.fieldTypeIds[row] ||
           Int32(typearena.TypedExprTypeArenaKindAt(
               typeArena, table.fieldTypeIds[row])) !=
               table.fieldStructuralKinds[row]:
            err = Fmt" compiler csg: fnptr field call fact coordinate drift row={row}"
            return false
        var cidErr = ""
        let expectedCid = compilerCsgFunctionInterfaceCid(
            typeArena, table.fieldTypeIds[row], cidErr)
        if cidErr != "" ||
           layout.FixedBytes32Equal(
               expectedCid, layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(
               expectedCid,
               table.functionInterfaceCids[row]):
            err = Fmt" compiler csg: fnptr field interface CID drift row={row}"
            return false
        previousCallNode = callNode
    err = ""
    return true

fn CompilerCsgFnPtrFieldCallTableStrictValidateInto(
        csg: var CompilerCsg,
        err: var str): bool =
    return compilerCsgFnPtrFieldCallTableStrictValidateInto(
        csg.typedIr, csg.typeArena, csg.fnPtrFieldCalls, err)

@borrows
fn compilerCsgBindFnPtrFieldCallFactsInto(
        typedIr: var texpr.TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        table: var CompilerCsgFnPtrFieldCallTable,
        err: var str): bool =
    if table.complete ||
       table.callNodeIndexes.len != 0:
        err = " compiler csg: fnptr field call fact destination prebound"
        return false
    table.typeArenaArtifactCid =
        typeArena.artifactRaw32
    for callNode in 0..<typedIr.nodes2_nodeIndexs.len:
        if typedIr.nodes2_opKinds[callNode] !=
           texpr.TypedExprIrOpCallExpr:
            continue
        let fieldNode = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_operand2NodeIndexs,
            callNode)
        if fieldNode < 0:
            continue
        if fieldNode >= callNode ||
           typedIr.nodes2_opKinds[fieldNode] !=
               texpr.TypedExprIrOpFieldGet:
            err = Fmt" compiler csg: fnptr field call callee invalid node={callNode}"
            return false
        let fieldTypeId = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_exactTypeArenaIds,
            fieldNode)
        var cidErr = ""
        let interfaceCid = compilerCsgFunctionInterfaceCid(
            typeArena, fieldTypeId, cidErr)
        if cidErr != "" ||
           layout.FixedBytes32Equal(
               interfaceCid, layout.FixedBytes32()):
            err = Fmt" compiler csg: fnptr field call interface missing node={callNode}:{cidErr}"
            return false
        add(table.callNodeIndexes, callNode)
        add(table.fieldNodeIndexes, fieldNode)
        add(table.fieldTypeIds, fieldTypeId)
        add(table.fieldStructuralKinds,
            Int32(typearena.TypedExprTypeArenaKindAt(
                typeArena, fieldTypeId)))
        add(table.functionInterfaceCids,
            interfaceCid)
    table.complete = true
    return compilerCsgFnPtrFieldCallTableStrictValidateInto(
        typedIr, typeArena, table, err)

fn CompilerCsgTypedNodeAuthorityStrictValidateInto(
        csg: var CompilerCsg,
        err: var str): bool =
    if !layout.FixedBytes32Equal(
           csg.typedIr.nodeAuthorityTypeArenaArtifactCid,
           csg.typeArena.artifactRaw32) ||
       !texpr.TypedExprNodeAuthorityStrictValidateInto(
           csg.typedIr, csg.typeArena, err):
        if err == "":
            err = " compiler csg: typed-node TypeArena artifact mismatch"
        return false
    return compilerCsgTypedNodeAuthorityReplayValidateInto(
        csg.typedIr,
        csg.parserNormalizedExprReceipt,
        csg.typeArena,
        csg.semanticGraph,
        err)

@borrows
fn compilerCsgTypedIrValueDefinitionTypeSyntaxRangesInto(
        typeArena: typearena.TypedExprTypeArena,
        starts: var int32[],
        counts: var int32[],
        err: var str): bool =
    starts = []
    counts = []
    if typeArena == nil || !typeArena.complete ||
       typeArena.producerSourceCount <= 0:
        err = " compiler csg: value-definition TypeArena is incomplete"
        return false
    setLen(starts, typeArena.producerSourceCount)
    setLen(counts, typeArena.producerSourceCount)
    for producerSourceIndex in 0..<starts.len:
        starts[producerSourceIndex] = -1
    var previousProducerSourceIndex: int32 = -1
    for typeSyntaxRow in 0..<typeArena.typeSyntaxCount:
        let producerSourceIndex = arenamod.ArenaArrayInt32Get(
            typeArena.arena,
            typeArena.typeSyntaxProducerSourceIndexes,
            typeSyntaxRow)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= typeArena.producerSourceCount ||
           producerSourceIndex < previousProducerSourceIndex ||
           arenamod.ArenaArrayInt32Get(
               typeArena.arena,
               typeArena.typeSyntaxSourceLocalRows,
               typeSyntaxRow) !=
               counts[producerSourceIndex]:
            err = " compiler csg: value-definition TypeSyntax producer order invalid"
            return false
        if starts[producerSourceIndex] < 0:
            starts[producerSourceIndex] = typeSyntaxRow
        elif typeSyntaxRow !=
                 starts[producerSourceIndex] +
                     counts[producerSourceIndex]:
            err = " compiler csg: value-definition TypeSyntax source range split"
            return false
        counts[producerSourceIndex] =
            counts[producerSourceIndex] + 1
        previousProducerSourceIndex = producerSourceIndex
    err = ""
    return true


# [phaseB-enum] enum 成员常量等价证明（供 value-definition TypeArena replay
# 核对使用）。`var s: Status = Status.Ok` 的注解 TypeId 是 Status enum 结构
# 类型，而成员常量定义值节点的物理表示是 int32 ordinal 保留标量。语义上成
# 员常量的类型就是所属 enum；物理上全链按 int32 标量走（比较/传参/case 判
# 别已证）。放行条件缺一即拒，全部精确身份证明：
#   1. 定义节点 op = I32Const（ordinal 物理表示）；
#   2. 定义行 TypeId = int32 保留标量行；
#   3. 注解行 = enum 结构类型行；
#   4. 节点 surface 恰为 `<EnumName>.<Member>` 两段限定名，且 EnumName 与注
#      解 enum 声明名、Member 与该 enum 成员名表分别 intern 精确匹配。
@borrows
fn compilerCsgEnumMemberConstEquivalence(
        ir: texpr.TypedExprIr,
        typeArena: typearena.TypedExprTypeArena,
        annotatedTypeId: int32,
        exactTypeId: int32,
        definingNodeIndex: int32): bool =
    if annotatedTypeId < 0 || exactTypeId < 0 ||
           definingNodeIndex < 0 ||
           definingNodeIndex >= ir.nodes2_nodeIndexs.len:
        return false
    if texpr.TypedExprIrNodeOpKindAt(ir, definingNodeIndex) !=
           texpr.TypedExprIrOpI32Const:
        return false
    if typearena.TypedExprTypeArenaKindAt(typeArena, exactTypeId) !=
           typearena.TypedExprStructuralTypeScalar:
        return false
    if typearena.TypedExprTypeArenaScalarKindAt(typeArena, exactTypeId) !=
           typearena.TypedExprStructuralScalarInt32:
        return false
    let surfaceResult: Result[str] = langintern.LookupIntern(
        ir.internPool, ir.nodes2_surfaceTextIds[definingNodeIndex])
    if !IsOk(surfaceResult):
        return false
    let surfaceText = Value(surfaceResult)
    let enumName = typearena.TypedExprTypeArenaEnumDeclarationName(
        typeArena, annotatedTypeId)
    if enumName == "":
        return false
    # surface 必须恰为 `<EnumName>.<Member>` 两段限定名（三段及以上、无点、
    # 尾段非标识符形状都会在这里被精确拒绝）。
    if texpr.TypedExprQualifiedCallQualifier(surfaceText) != enumName:
        return false
    let memberName = texpr.TypedExprQualifiedCallLeaf(surfaceText)
    if memberName == "" || memberName == surfaceText:
        return false
    return typearena.TypedExprTypeArenaEnumDeclaresMemberName(
        typeArena, annotatedTypeId, memberName)

@borrows
fn compilerCsgTypedIrValueDefinitionTypeArenaReplayInto(
        ir: texpr.TypedExprIr,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        typeArena: typearena.TypedExprTypeArena,
        err: var str): bool =
    if receipt.sourceSidecars.len != typeArena.producerSourceCount:
        err = " compiler csg: value-definition parser/TypeArena source domain split"
        return false
    var typeSyntaxStarts: int32[]
    var typeSyntaxCounts: int32[]
    if !compilerCsgTypedIrValueDefinitionTypeSyntaxRangesInto(
           typeArena, typeSyntaxStarts, typeSyntaxCounts, err):
        return false
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(ir)
    for definitionRow in 0..<definitionCount:
        let producerSourceIndex =
            texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                ir, definitionRow)
        let declarationSourceLocalRow =
            texpr.TypedExprValueDefinitionDeclarationSourceLocalRowAt(
                ir, definitionRow)
        let patternSourceLocalRow =
            texpr.TypedExprValueDefinitionPatternSourceLocalRowAt(
                ir, definitionRow)
        let definingTypedNodeIndex =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                ir, definitionRow)
        let exactTypeId =
            texpr.TypedExprValueDefinitionExactTypeIdAt(
                ir, definitionRow)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= receipt.sourceSidecars.len ||
           definingTypedNodeIndex < 0 ||
           definingTypedNodeIndex >= ir.nodes2_nodeIndexs.len ||
           exactTypeId < 0 || exactTypeId >= typeArena.typeCount ||
           exactTypeId != texpr.TypedExprIrNodeStructuralTypeIdAt(
               ir, definingTypedNodeIndex):
            err = Fmt" compiler csg: value-definition exact structural TypeId invalid row={definitionRow}"
            return false
        let originKind =
            texpr.TypedExprValueDefinitionOriginKindAt(
                ir, definitionRow)
        let callResultLike =
            originKind ==
                texpr.TypedExprValueDefinitionOriginCallResult ||
            originKind ==
                texpr.TypedExprValueDefinitionOriginManagedTemporary
        let parameterOrigin =
            originKind ==
                texpr.TypedExprValueDefinitionOriginParameter
        let bindingOrigin =
            originKind ==
                texpr.TypedExprValueDefinitionOriginBindingInitializer
        if !parameterOrigin && !bindingOrigin && !callResultLike:
            err = Fmt" compiler csg: value-definition origin kind invalid row={definitionRow}"
            return false
        let sourceLocalNodeIndex =
            texpr.TypedExprValueDefinitionSourceLocalNodeIndexAt(
                ir, definitionRow)
        let originParserNodeId = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.nodes2_originParserNodeIds,
            definingTypedNodeIndex)
        let sidecar = receipt.sourceSidecars[producerSourceIndex]
        var skipDeclarationTypeSyntax = false
        if callResultLike:
            if sidecar.sourceIndex != producerSourceIndex ||
               declarationSourceLocalRow != -1 ||
               patternSourceLocalRow != -1 ||
               sourceLocalNodeIndex < 0 ||
               sourceLocalNodeIndex >= sidecar.nodeProducerIds.len ||
               originParserNodeId != sourceLocalNodeIndex:
                err = Fmt" compiler csg: value-definition parser identity invalid row={definitionRow}"
                return false
            var canonicalProducerRow: int32 = -1
            for nodeRow in 0..<sidecar.nodeProducerIds.len:
                if sidecar.nodeProducerIds[nodeRow] ==
                       sourceLocalNodeIndex:
                    canonicalProducerRow = nodeRow
                    break
            if canonicalProducerRow < 0:
                err = Fmt" compiler csg: value-definition parser identity invalid row={definitionRow}"
                return false
            if originKind ==
                   texpr.TypedExprValueDefinitionOriginCallResult:
                var callEventMatched = false
                for eventIndex in 0..<sidecar.callEventNodeIds.len:
                    if sidecar.callEventNodeIds[eventIndex] ==
                           canonicalProducerRow:
                        callEventMatched = true
                        break
                if !callEventMatched ||
                   (sidecar.nodeKinds[canonicalProducerRow] !=
                        Int32(parser.ParserValueExprCall) &&
                    sidecar.nodeKinds[canonicalProducerRow] !=
                        Int32(parser.ParserValueExprSpaceCall)):
                    err = Fmt" compiler csg: value-definition parser identity invalid row={definitionRow}"
                    return false
            skipDeclarationTypeSyntax = true
        elif sidecar.sourceIndex != producerSourceIndex ||
             declarationSourceLocalRow < 0 ||
             declarationSourceLocalRow >=
                 sidecar.declarationSourceLocalRows.len ||
             declarationSourceLocalRow >=
                 sidecar.declarationTypeSyntaxRootIds.len ||
             sidecar.declarationSourceLocalRows[
                 declarationSourceLocalRow] !=
                 declarationSourceLocalRow:
            err = Fmt" compiler csg: value-definition parser identity invalid row={definitionRow}"
            return false
        elif parameterOrigin:
            if patternSourceLocalRow != -1:
                err = Fmt" compiler csg: value-definition parser identity invalid row={definitionRow}"
                return false
        elif patternSourceLocalRow < 0 ||
             patternSourceLocalRow >=
                 sidecar.patternSourceLocalRows.len ||
             patternSourceLocalRow >=
                 sidecar.patternBindingDeclarationIds.len ||
             sidecar.patternSourceLocalRows[
                 patternSourceLocalRow] != patternSourceLocalRow ||
             sidecar.patternBindingDeclarationIds[
                 patternSourceLocalRow] !=
                 declarationSourceLocalRow:
            err = Fmt" compiler csg: value-definition parser identity invalid row={definitionRow}"
            return false
        if typearena.TypedExprTypeArenaManagedAt(
               typeArena, exactTypeId) !=
               ir.nodes2_resultTypeManagedFlags[
                   definingTypedNodeIndex] ||
           typearena.TypedExprTypeArenaSendAt(
               typeArena, exactTypeId) !=
               ir.nodes2_resultTypeSendFlags[
                   definingTypedNodeIndex] ||
           typearena.TypedExprTypeArenaSyncAt(
               typeArena, exactTypeId) !=
               ir.nodes2_resultTypeSyncFlags[
                   definingTypedNodeIndex]:
            err = Fmt" compiler csg: value-definition structural type proof drift row={definitionRow} type_id={exactTypeId} managed={typearena.TypedExprTypeArenaManagedAt(typeArena, exactTypeId)} node_managed={ir.nodes2_resultTypeManagedFlags[definingTypedNodeIndex]} send={typearena.TypedExprTypeArenaSendAt(typeArena, exactTypeId)} node_send={ir.nodes2_resultTypeSendFlags[definingTypedNodeIndex]} sync={typearena.TypedExprTypeArenaSyncAt(typeArena, exactTypeId)} node_sync={ir.nodes2_resultTypeSyncFlags[definingTypedNodeIndex]}"
            return false
        if skipDeclarationTypeSyntax:
            continue
        let sourceLocalTypeSyntaxRow =
            sidecar.declarationTypeSyntaxRootIds[
                declarationSourceLocalRow]
        if sourceLocalTypeSyntaxRow == -1:
            continue
        if sourceLocalTypeSyntaxRow < 0 ||
           sourceLocalTypeSyntaxRow >=
               typeSyntaxCounts[producerSourceIndex] ||
           typeSyntaxStarts[producerSourceIndex] < 0:
            err = Fmt" compiler csg: value-definition declaration TypeSyntax invalid row={definitionRow}"
            return false
        let typeSyntaxRow =
            typeSyntaxStarts[producerSourceIndex] +
                sourceLocalTypeSyntaxRow
        if typeSyntaxRow < 0 ||
           typeSyntaxRow >= typeArena.typeSyntaxCount ||
           arenamod.ArenaArrayInt32Get(
               typeArena.arena,
               typeArena.typeSyntaxProducerSourceIndexes,
               typeSyntaxRow) != producerSourceIndex:
            err = Fmt" compiler csg: value-definition TypeSyntax join drift row={definitionRow}"
            return false
        let annotatedTypeId =
            typearena.TypedExprTypeArenaTypeIdForTypeSyntax(
                typeArena, typeSyntaxRow)
        if annotatedTypeId != exactTypeId:
            # [phaseB-enum] enum 成员常量等价：成员常量的注解类型是所属
            # enum，物理表示是 int32 ordinal。等价臂逐项精确证明（见
            # compilerCsgEnumMemberConstEquivalence），证明不过仍按漂移拒。
            if !compilerCsgEnumMemberConstEquivalence(
                   ir, typeArena, annotatedTypeId, exactTypeId,
                   definingTypedNodeIndex):
                err = Fmt" compiler csg: value-definition annotation TypeId mismatch row={definitionRow}"
                return false
    err = ""
    return true

@borrows
fn CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
        csg: CompilerCsg,
        err: var str): bool =
    var typeArenaErr: str
    if csg.typeArena == nil:
        err = " compiler csg: exact TypeArena missing"
        return false
    if !texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
           csg.typedIr, err):
        return false
    if !typearena.TypedExprTypeArenaStrictValidateInto(
           csg.typeArena, typeArenaErr):
        err = typeArenaErr
        return false
    let definitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr)
    if definitionCount == 0 &&
       !csg.typedIr.valueDefinitionTypeArenaBound:
        err = ""
        return true
    if !csg.typedIr.valueDefinitionTypeArenaBound:
        if err == "":
            err = " compiler csg: value-definition exact TypeArena binding missing"
        return false
    if !layout.FixedBytes32Equal(
           csg.typedIr.valueDefinitionTypeArenaArtifactCid,
           csg.typeArena.artifactRaw32):
        err = " compiler csg: value-definition TypeArena artifact mismatch"
        return false
    return compilerCsgTypedIrValueDefinitionTypeArenaReplayInto(
        csg.typedIr,
        csg.parserNormalizedExprReceipt,
        csg.typeArena,
        err)

@borrows
fn CompilerCsgTypeImportAuthorityBuildInto(
        profiles: parser.NormalizedExprCallProfile[],
        orderedSources: str[],
        out: var typearena.TypedExprTypeImportAuthority,
        err: var str): bool =
    if out.sealed || out.ownerSourceIndexes.len != 0 ||
       out.targetSourceIndexes.len != 0 || out.qualifiers.len != 0 ||
       out.allowsUnqualified.len != 0:
        err = " compiler csg: TypeArena import authority destination is not empty"
        return false
    if profiles.len != orderedSources.len:
        err = Fmt" compiler csg: TypeArena import authority source coverage invalid profiles={profiles.len} sources={orderedSources.len}"
        return false
    var candidate: typearena.TypedExprTypeImportAuthority
    for ownerSourceIndex in 0..<profiles.len:
        let profile = profiles[ownerSourceIndex]
        if profile.sourcePath == "" ||
           profile.sourcePath != orderedSources[ownerSourceIndex] ||
           profile.ownerModulePath == "":
            err = Fmt" compiler csg: TypeArena import owner identity mismatch source_index={ownerSourceIndex}"
            return false
        for edgeIndex in 0..<profile.importEdges.len:
            let edge = profile.importEdges[edgeIndex]
            let targetSourceIndex = edge.targetProfileIndex
            if !edge.resolved || targetSourceIndex < 0 ||
               targetSourceIndex >= profiles.len ||
               edge.ownerModulePath != profile.ownerModulePath ||
               edge.targetModulePath == "" || edge.qualifier == "" ||
               edge.targetSourcePath !=
                   profiles[targetSourceIndex].sourcePath ||
               edge.targetSourcePath !=
                   orderedSources[targetSourceIndex] ||
               edge.targetModulePath !=
                   profiles[targetSourceIndex].ownerModulePath ||
               (edge.importAlias != "" &&
                edge.qualifier != edge.importAlias):
                err = Fmt" compiler csg: TypeArena import authority edge invalid owner_source_index={ownerSourceIndex} edge_index={edgeIndex} target_source_index={targetSourceIndex}"
                return false
            add(candidate.ownerSourceIndexes, ownerSourceIndex)
            add(candidate.targetSourceIndexes, targetSourceIndex)
            add(candidate.qualifiers, share(edge.qualifier))
            add(candidate.allowsUnqualified,
                edge.allowsUnqualifiedCall)
    candidate.sealed = true
    out = candidate
    err = ""
    return true

# [S1b step-3 (6)] Streaming TypeArena driver.  Pass 0 has already measured
# every source and sealed the declaration index; this pass re-parses one source
# at a time and consumes it completely -- index proof, resolution authority,
# arena append, call-declaration append -- before releasing it.  The merged
# forest never exists.  The arithmetic is the merge's own:
# `ParserValueExprTreeAppendFromImpl` handed source k the prefix sums of the
# index's per-source counts, and every consumer below takes those bases as
# explicit view parameters, so every recorded row is the row the merged forest
# produced.
#
# `forest_appended` is emitted here, once per consumed source, with the same
# name and the same meaning it had in the merge loop ("source k has been
# appended into the arena"); `ta_stream` carries the same count.  Neither is a
# renamed or reinterpreted counter: ⑥ deleted the merge loop, so the streaming
# driver is now the only writer of the row it counted.
# [c2-line] The diagnostic arm of the forward replay: the original tree path
# (snapshot, rewrite, census, parse, ReplayForwardRowsInto) plus the
# row-for-row tree-vs-column equality proof.  Extracted verbatim from the
# replay loop so the borrow projection of the resident tree stays inside one
# frame; the hard-switched arm in the loop reads columns and never parses.
# Gate: CHENG_TA_REPLAY_COL_DIAG=1 arms this path; the default path skips it.
@borrows
fn compilerCsgReplayForwardRowsTreePathInto(
        work: var CompilerCsgBuildWorkingSet,
        declarationIndex: var typearena.TypedExprTypeDeclarationIndex,
        arenaValue: var typearena.TypedExprTypeArena,
        authority: typearena.TypedExprTypeResolutionAuthority,
        arenaState: var typearena.TypedExprTypeArenaBuildState,
        pending: typearena.TypedExprTypeArenaPendingGenericApply,
        replaySourceIndex: int32,
        replayTokenBase: int32,
        buildErr: var str,
        err: var str): bool =
    var replaySourceText: str
    if !CompilerCsgImmutableSourceSnapshotText(
           work.sourceSnapshots,
           work.sourceSnapshotIndex,
           work.orderedSources[replaySourceIndex],
           replaySourceText,
           buildErr):
        typearena.TypedExprTypeArenaRelease(arenaValue)
        err = buildErr
        return false
    var replayParserText: str
    var replayCoordinateMap: parser.ParserSourceRewriteCoordinateMap
    if !parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
           replaySourceText, replayParserText, replayCoordinateMap,
           buildErr):
        typearena.TypedExprTypeArenaRelease(arenaValue)
        err = buildErr
        return false
    # [replay-census] The same per-source column census the merge loop
    # hands the reader: the replay re-parses the source, so it appends the
    # same rows into the same columns and must reserve them at the same
    # exact lengths.  Leaving this empty (as it was) made every replayed
    # source grow every column geometrically -- measured 5.9 MB of arena
    # growth per replayed parse against 0.18 MB with the census.
    var replayColumnCensus: int32[]
    let replayCensusBase: int32 =
        replaySourceIndex * parser.ParserValueExprTreeArenaColumnCount
    let replayCensusEnd: int32 =
        replayCensusBase + parser.ParserValueExprTreeArenaColumnCount
    if replayCensusBase < 0 ||
       replayCensusEnd >
           work.typeArenaForestSourceColumnCensus.len:
        typearena.TypedExprTypeArenaRelease(arenaValue)
        err = Fmt" compiler csg: TypeArena forward replay column census missing source_index={replaySourceIndex} census={work.typeArenaForestSourceColumnCensus.len}"
        return false
    var replayCensusCursor: int32 = replayCensusBase
    while replayCensusCursor < replayCensusEnd:
        add(replayColumnCensus,
            work.typeArenaForestSourceColumnCensus[replayCensusCursor])
        replayCensusCursor = replayCensusCursor + 1
    # [c-line retain-ledger] One bracket per replayed source: the 222
    # re-parses pay the same per-source retention the merge pays, and this
    # is the A/B instrument for removing them.
    var replayTree: parser.ParserValueExprTree
    var replayTreeRead = false
    if work.exprCallProfiles[replaySourceIndex].migrationSourceSyntax:
        replayTreeRead =
            parser.ParserValueExprReadMigrationSourceTreeFromTextReserved(
                replayParserText,
                work.typeArenaForestSourceArenaBytes[replaySourceIndex] +
                    65536,
                replayColumnCensus,
                replayTree,
                buildErr)
    else:
        replayTreeRead =
            parser.ParserValueExprReadTreeFromTextReserved(
                replayParserText,
                work.typeArenaForestSourceArenaBytes[replaySourceIndex] +
                    65536,
                replayColumnCensus,
                replayTree,
                buildErr)
    if !replayTreeRead:
        parser.ParserValueExprTreeRelease(replayTree)
        typearena.TypedExprTypeArenaRelease(arenaValue)
        err = buildErr
        return false
    if !typearena.TypedExprTypeArenaReplayForwardRowsInto(
           arenaValue,
           replayTree,
           authority,
           arenaState,
           pending,
           replaySourceIndex,
           replayTokenBase,
           declarationIndex.typeSyntaxBaseBySource[replaySourceIndex],
           buildErr):
        err = Fmt" compiler csg: TypeArena forward replay failed source_index={replaySourceIndex}: {buildErr}"
        parser.ParserValueExprTreeRelease(replayTree)
        typearena.TypedExprTypeArenaRelease(arenaValue)
        return false
    # [c2-line] Row-for-row tree-vs-column equality proof.  Read-only over
    # the columns; the tree is still resident here, so every fact is
    # compared before it is released.  Gate: CHENG_TA_REPLAY_COL_DIAG=1.
    if compilerCsgReplayColDiag:
        var diagMismatch: int64
        var diagChecked: int64
        if !typearena.TypedExprTypeArenaReplayForwardRowsDiagnoseInto(
               arenaValue, replayTree, arenaState,
               declarationIndex.typeSyntaxBaseBySource[replaySourceIndex],
               diagMismatch, diagChecked, buildErr):
            err = Fmt" compiler csg: TypeArena forward replay diagnose failed source_index={replaySourceIndex}: {buildErr}"
            parser.ParserValueExprTreeRelease(replayTree)
            typearena.TypedExprTypeArenaRelease(arenaValue)
            return false
        compilerCsgReplayColDiagChecked =
            compilerCsgReplayColDiagChecked + diagChecked
        compilerCsgReplayColDiagMismatch =
            compilerCsgReplayColDiagMismatch + diagMismatch
    parser.ParserValueExprTreeRelease(replayTree)
    return true

fn CompilerCsgStreamTypeArenaFromDeclarationIndexInto(
        work: var CompilerCsgBuildWorkingSet,
        declarationIndex: var typearena.TypedExprTypeDeclarationIndex,
        outLookup: var parser.ParserSourcePathIndexLookup,
        err: var str): bool =
    if work.typeArena != nil:
        err = " compiler csg: TypeArena destination is not empty"
        return false
    if work.typeArenaMissingResolutionAuthorityCount != 0:
        err = " compiler csg: stale TypeArena missing-authority state"
        return false
    if !declarationIndex.sealed ||
       declarationIndex.producerSourceCount != work.orderedSources.len ||
       work.typeArenaForestSourceArenaBytes.len !=
           work.orderedSources.len:
        err = Fmt" compiler csg: TypeArena declaration index coverage invalid expected={work.orderedSources.len} index_sources={declarationIndex.producerSourceCount} arena_bytes={work.typeArenaForestSourceArenaBytes.len}"
        return false
    var buildErr: str
    var importAuthority: typearena.TypedExprTypeImportAuthority
    var tcPreNs: int64 = 0
    if compilerCsgForestSubTimeEnabled:
        tcPreNs = compilerCsgT4NowNs()
    if !CompilerCsgTypeImportAuthorityBuildInto(
           work.exprCallProfiles,
           work.orderedSources,
           importAuthority,
           buildErr):
        err = Fmt" compiler csg: TypeArena import authority failed: {buildErr}"
        return false
    if compilerCsgForestSubTimeEnabled:
        let tcNow = compilerCsgT4NowNs()
        compilerCsgForestSubImportNs =
            compilerCsgForestSubImportNs + (tcNow - tcPreNs)
        tcPreNs = tcNow
    var sortedEntryRows: int32[]
    if !typearena.TypedExprTypeDeclarationIndexSortedEntryRowsInto(
           declarationIndex, sortedEntryRows, buildErr):
        err = Fmt" compiler csg: TypeArena declaration index sorted view failed: {buildErr}"
        return false
    var sortedImportRows: int32[]
    if !typearena.TypedExprTypeImportAuthoritySortedRowsInto(
           importAuthority, sortedImportRows, buildErr):
        err = Fmt" compiler csg: TypeArena import authority sorted view failed: {buildErr}"
        return false
    if compilerCsgForestSubTimeEnabled:
        let tcNow = compilerCsgT4NowNs()
        compilerCsgForestSubSortedNs =
            compilerCsgForestSubSortedNs + (tcNow - tcPreNs)
        tcPreNs = tcNow
    # [nominal-sweep] Enumerate mode: the resolution authority phase run a
    # second time, one source at a time and ahead of the loop below, so every
    # unreachable cross-source name in the forest is collected in ONE run.
    #
    # Why not record-and-skip inside the loop below: the view bases it carries
    # are advanced only after a successful append, so skipping a failed source
    # there would leave every later source's view base short and MANUFACTURE
    # missing names; and that loop's authority is the one the arena consumes,
    # so a half-appended source cannot be taken back out of it.
    #
    # Why this pass manufactures nothing: a source's authority is a function of
    # the sealed index, the sorted entry and import views, that source's own
    # tree, its producer index and `viewGenericSymbolBase` -- which is the
    # index's own prefix sum of `genericSymbolCountBySource`, recomputed here.
    # It reads the accumulator only through `out.sealed`, so source k failing
    # cannot change source m > k: there is no cascade.
    #
    # Nothing below runs unless CHENG_NOMINAL_SWEEP=1.  The flag is the module
    # `var` armed once by `CompilerCsgTraceInit`, which has already run here --
    # it is the same init that arms `compilerCsgMemTrace`, read further down --
    # so the default path executes the statements it did before this block.
    if compilerNominalSweep:
        typearena.TypedExprTypeNominalSweepBegin()
        var sweepGenericSymbolBase: int32
        for sweepSourceIndex in 0..<work.orderedSources.len:
            if sweepSourceIndex % 16 == 0:
                os.ProcessResourceGuardCheck()
            var sweepSourceText: str
            if !CompilerCsgImmutableSourceSnapshotText(
                   work.sourceSnapshots,
                   work.sourceSnapshotIndex,
                   work.orderedSources[sweepSourceIndex],
                   sweepSourceText,
                   buildErr):
                err = Fmt" compiler csg: nominal sweep source snapshot failed source_index={sweepSourceIndex}: {buildErr}"
                return false
            var sweepParserText: str
            var sweepCoordinateMap: parser.ParserSourceRewriteCoordinateMap
            if !parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
                   sweepSourceText, sweepParserText, sweepCoordinateMap,
                   buildErr):
                err = Fmt" compiler csg: nominal sweep source rewrite failed source_index={sweepSourceIndex}: {buildErr}"
                return false
            let sweepArenaReserve: int32 =
                work.typeArenaForestSourceArenaBytes[sweepSourceIndex] + 65536
            var sweepSourceCensus: int32[]
            let sweepCensusBase: int32 =
                sweepSourceIndex * parser.ParserValueExprTreeArenaColumnCount
            let sweepCensusEnd: int32 =
                sweepCensusBase + parser.ParserValueExprTreeArenaColumnCount
            if sweepCensusBase < 0 ||
               sweepCensusEnd > work.typeArenaForestSourceColumnCensus.len:
                err = Fmt" compiler csg: nominal sweep source column census missing source_index={sweepSourceIndex} census={work.typeArenaForestSourceColumnCensus.len}"
                return false
            var sweepCensusCursor: int32 = sweepCensusBase
            while sweepCensusCursor < sweepCensusEnd:
                add(sweepSourceCensus,
                    work.typeArenaForestSourceColumnCensus[sweepCensusCursor])
                sweepCensusCursor = sweepCensusCursor + 1
            var sweepTree: parser.ParserValueExprTree
            var sweepTreeRead = false
            if work.exprCallProfiles[sweepSourceIndex].migrationSourceSyntax:
                sweepTreeRead =
                    parser.ParserValueExprReadMigrationSourceTreeFromTextReserved(
                        sweepParserText, sweepArenaReserve, sweepSourceCensus,
                        sweepTree, buildErr)
            else:
                sweepTreeRead = parser.ParserValueExprReadTreeFromTextReserved(
                    sweepParserText, sweepArenaReserve, sweepSourceCensus,
                    sweepTree, buildErr)
            if !sweepTreeRead:
                parser.ParserValueExprTreeRelease(sweepTree)
                err = Fmt" compiler csg: nominal sweep source parse failed source_index={sweepSourceIndex}: {buildErr}"
                return false
            if sweepTree.producerSourceCount != 1:
                parser.ParserValueExprTreeRelease(sweepTree)
                err = Fmt" compiler csg: nominal sweep source tree authority invalid source_index={sweepSourceIndex} producer_count={sweepTree.producerSourceCount}"
                return false
            if !typearena.TypedExprTypeDeclarationIndexVerifySourceAgainstInto(
                   sweepTree,
                   sweepSourceIndex,
                   declarationIndex.typeSyntaxBaseBySource[sweepSourceIndex],
                   declarationIndex.declarationBaseBySource[sweepSourceIndex],
                   declarationIndex,
                   buildErr):
                parser.ParserValueExprTreeRelease(sweepTree)
                err = Fmt" compiler csg: nominal sweep declaration index verification failed source_index={sweepSourceIndex}: {buildErr}"
                return false
            # One authority per source, thrown away with it: a failed source's
            # partial rows must never reach a later source, and this pass must
            # never touch the accumulating authority the loop below owns.
            var sweepAuthority =
                typearena.TypedExprTypeResolutionAuthorityStreamingBegin()
            let _ = typearena.TypedExprTypeResolutionAuthorityAppendSourceInto(
                sweepTree,
                sweepSourceIndex,
                declarationIndex.typeSyntaxBaseBySource[sweepSourceIndex],
                sweepGenericSymbolBase,
                declarationIndex,
                sortedEntryRows,
                importAuthority,
                sortedImportRows,
                sweepAuthority,
                buildErr)
            parser.ParserValueExprTreeRelease(sweepTree)
            # Same per-source churn relief the loop below takes: this pass runs
            # the same parse over the same sources under the same process
            # memory guard.
            let _sweepSourceChurnRelief = os.ProcessMemoryPressureRelief()
            sweepGenericSymbolBase =
                sweepGenericSymbolBase +
                    declarationIndex.genericSymbolCountBySource[sweepSourceIndex]
        let sweepCount = typearena.TypedExprTypeNominalSweepCount()
        var sweepRow: int32
        while sweepRow < sweepCount:
            let sweepRowSource =
                typearena.TypedExprTypeNominalSweepSourceIndexAt(sweepRow)
            let sweepPath = strings.CloneStr(work.orderedSources[sweepRowSource])
            let sweepName = typearena.TypedExprTypeNominalSweepNameAt(sweepRow)
            let sweepReason =
                typearena.TypedExprTypeNominalSweepReasonAt(sweepRow)
            let sweepLine = Fmt"nominal_sweep source={sweepRowSource} path={sweepPath} name={sweepName} type_syntax_row={typearena.TypedExprTypeNominalSweepTypeSyntaxRowAt(sweepRow)} root_row={typearena.TypedExprTypeNominalSweepRootRowAt(sweepRow)} reason={sweepReason}"
            compilerNominalSweepEmit(sweepLine)
            sweepRow = sweepRow + 1
        let sweepSummary = Fmt"nominal_sweep total={sweepCount} sources={work.orderedSources.len}"
        compilerNominalSweepEmit(sweepSummary)
        if sweepCount != 0:
            err = Fmt" compiler csg: nominal sweep enumerated {sweepCount} unreachable cross-source nominals"
            return false
    var columnLimits: typearena.TypedExprTypeArenaLimits
    if !typearena.TypedExprTypeArenaLimitsFromIndexInto(
           declarationIndex, columnLimits, buildErr):
        err = Fmt" compiler csg: TypeArena column limits failed: {buildErr}"
        return false
    if compilerCsgMemTrace:
        let limitsTag = Fmt"ta_limits tokens={columnLimits.tokenCount} type_syntax={columnLimits.typeSyntaxCount} type_syntax_children={columnLimits.typeSyntaxChildCount} enum_variants={columnLimits.enumVariantCount} declaration_symbols={columnLimits.declarationSymbolCount} functions={columnLimits.functionCount} bracket_args={columnLimits.bracketArgCount} generic_symbols={columnLimits.genericSymbolCount} generic_symbol_children={columnLimits.genericSymbolChildCount} column_rows={strings.Int64ToStr(columnLimits.columnRows)} column_bytes={strings.Int64ToStr(columnLimits.columnBytes)}"
        compilerCsgMemTraceEmit(limitsTag)
    var authority = typearena.TypedExprTypeResolutionAuthorityStreamingBegin()
    var arenaValue: typearena.TypedExprTypeArena
    var arenaState: typearena.TypedExprTypeArenaBuildState
    # [closure8] The sealed index's SymbolId space seeds the build state, so a
    # nominal in source k resolves against a declaration in source j > k with
    # no dependence on source j being resident or already appended.
    if !typearena.TypedExprTypeArenaAllocateFromLimitsInto(
           columnLimits, authority,
           declarationIndex.declarationSymbolGlobalRoots,
           declarationIndex.declarationGenericSymbolStarts,
           declarationIndex.declarationGenericSymbolCounts,
           arenaValue, arenaState, buildErr):
        err = Fmt" compiler csg: TypeArena allocation failed: {buildErr}"
        return false
    if compilerCsgMemTrace:
        compilerCsgMemTraceEmit("p1_arena_reserved")
    var pending: typearena.TypedExprTypeArenaPendingGenericApply
    pending = typearena.TypedExprTypeArenaPendingGenericApplyNew()
    if compilerCsgForestSubTimeEnabled:
        let tcNow = compilerCsgT4NowNs()
        compilerCsgForestSubAllocNs =
            compilerCsgForestSubAllocNs + (tcNow - tcPreNs)
        tcPreNs = tcNow
    # [c1-line] buildindex window decomposition probes (csg_mem gate only).
    compilerCsgMemTraceEmit("p1_pending_done")
    # [p1phase1] Deferred exact-index core: only core pass 1 (source
    # identity, module consts, content caches, domain counts) runs here, so
    # the metadata entry/visibility columns and their interned texts no
    # longer ride the merge-loop entry floor (m3fixd6 window: +30.1 MiB
    # entry step, index_live 35.8 MiB).  The metadata producer (core pass 2)
    # is re-run verbatim by TypedExprBuildIndexFinishDeferredCore after the
    # merge loop, right before the call-declaration seal; the loop appends
    # call declarations only (their own column families), so the sealed
    # index content is byte-identical to the core-first arm by construction.
    compilerCsgMemTraceEmit("p1_ctx_begin")
    if !texpr.TypedExprBuildSourceContextExactIndexDeferredCore(
           work.typedMetadataContexts,
           outLookup,
           buildErr):
        typearena.TypedExprTypeArenaRelease(arenaValue)
        err = Fmt" compiler csg: TypeArena typed context index failed: {buildErr}"
        return false
    if compilerCsgMemTrace:
        compilerCsgMemTraceEmit("p1_ctx_index_deferred")
    if compilerCsgForestSubTimeEnabled:
        let tcNow = compilerCsgT4NowNs()
        compilerCsgForestSubCtxNs =
            compilerCsgForestSubCtxNs + (tcNow - tcPreNs)
        tcPreNs = tcNow
    compilerCsgForestSubTimeEmit("ctx")
    # The index handle must be its own place: `sourceContexts[0].buildIndex`
    # and `sourceContexts` overlap, and one call may not bind two overlapping
    # places to two `var` formals.
    var buildIndex: texpr.TypedExprBuildIndex
    buildIndex = work.typedMetadataContexts[0].buildIndex
    var mergeFixedArenaReserve: int32
    mergeFixedArenaReserve = 0
    # [c1-line] The max-scan only feeds CHENG_MERGE_FIXED_ARENA_RESERVE mode;
    # with the flag off the merge loop uses the per-source measured+64KB
    # reserve and this scan was 234 dead iterations per build.  The loop_entry
    # lens trace moved out of the scan: one emission at loop entry instead of
    # 234 flood lines inside the scan (p0line handoff 3).
    if compilerCsgMergeFixedArenaReserve:
        for mergeReserveIndex in 0..<work.typeArenaForestSourceArenaBytes.len:
            if work.typeArenaForestSourceArenaBytes[mergeReserveIndex] + 65536 >
                   mergeFixedArenaReserve:
                mergeFixedArenaReserve =
                    work.typeArenaForestSourceArenaBytes[mergeReserveIndex] + 65536
    texpr.TypedExprBuildIndexColumnLensTrace(buildIndex, "loop_entry", -1, 0)
    # [c1-line] End of the ctx->loop-entry window: with d_live next to the
    # rss reading this splits the 849->863 gap into allocation vs page-in.
    compilerCsgMemTraceEmit("p1_merge_scan_done")
    var tokenBase: int32
    var bracketArgBase: int32
    var genericSymbolBase: int32
    var genericSymbolChildBase: int32
    var functionBase: int32
    # [c-line retain-ledger] Loop-entry reading and accumulator reset.  All of
    # this is gated by compilerCsgMemTrace like the merge_stage lines: an
    # unset environment takes no counter reads and writes nothing.
    var retainPrevBlocks: int64 = 0
    var retainPrevBytes: int64 = 0
    if compilerCsgMemTrace:
        compilerCsgRetainParseBlocks = 0
        compilerCsgRetainParseBytes = 0
        compilerCsgRetainAuthorityBlocks = 0
        compilerCsgRetainAuthorityBytes = 0
        compilerCsgRetainTaAppendBlocks = 0
        compilerCsgRetainTaAppendBytes = 0
        compilerCsgRetainBuildIndexBlocks = 0
        compilerCsgRetainBuildIndexBytes = 0
        compilerCsgRetainReleaseBlocks = 0
        compilerCsgRetainReleaseBytes = 0
        compilerCsgRetainRewriteBlocks = 0
        compilerCsgRetainRewriteBytes = 0
        compilerCsgRetainReplaySources = 0
        compilerCsgRetainReplayBlocks = 0
        compilerCsgRetainReplayBytes = 0
        compilerCsgRetainSources = 0
        retainPrevBlocks = system.MemLiveAllocations()
        retainPrevBytes = os.ProcessRssBytes()
    # [m1-line] Open the process-exclusive ledger owner and pin the loop
    # baseline so every segment delta below starts from the same zero line
    # the retain-ledger's retainPrevBlocks reading takes.
    compilerCsgAllocLedgerStart()
    if compilerCsgAllocLedgerArmed:
        compilerCsgAllocLedgerMark()
    for sourceIndex in 0..<work.orderedSources.len:
        if sourceIndex % 16 == 0:
            os.ProcessResourceGuardCheck()
        var tcLoopNs: int64 = 0
        if compilerCsgForestSubTimeEnabled:
            tcLoopNs = compilerCsgT4NowNs()
        var sourceText: str
        if !CompilerCsgImmutableSourceSnapshotText(
               work.sourceSnapshots,
               work.sourceSnapshotIndex,
               work.orderedSources[sourceIndex],
               sourceText,
               buildErr):
            typearena.TypedExprTypeArenaRelease(arenaValue)
            err = buildErr
            return false
        if compilerCsgMemTrace:
            let forestTag = Fmt"forest src={sourceIndex} bytes={sourceText.len}"
            compilerCsgMemTraceEmit(forestTag)
        var parserInputText: str
        var coordinateMap: parser.ParserSourceRewriteCoordinateMap
        if !parser.ParserRewriteMultilineStringSourceTextWithCoordinateMap(
               sourceText, parserInputText, coordinateMap, buildErr):
            typearena.TypedExprTypeArenaRelease(arenaValue)
            err = buildErr
            return false
        compilerCsgMergeStageEmit("post_rewrite", sourceIndex)
        # [c-line retain-ledger] Per-source iteration state.  The rewrite
        # bucket spans the previous source's release_post to this boundary,
        # the same residual segment the merge_stage deltas call
        # tail->post_rewrite.
        var retainSegBlocks: int64 = 0
        var retainSegBytes: int64 = 0
        var retainDParseBlocks: int64 = 0
        var retainDParseBytes: int64 = 0
        var retainDAuthBlocks: int64 = 0
        var retainDAuthBytes: int64 = 0
        var retainDTaBlocks: int64 = 0
        var retainDTaBytes: int64 = 0
        var retainDBuildBlocks: int64 = 0
        var retainDBuildBytes: int64 = 0
        if compilerCsgMemTrace:
            let retainRewriteBlocks: int64 =
                system.MemLiveAllocations() - retainPrevBlocks
            let retainRewriteBytes: int64 =
                os.ProcessRssBytes() - retainPrevBytes
            compilerCsgRetainRewriteBlocks =
                compilerCsgRetainRewriteBlocks + retainRewriteBlocks
            compilerCsgRetainRewriteBytes =
                compilerCsgRetainRewriteBytes + retainRewriteBytes
            retainPrevBlocks = system.MemLiveAllocations()
            retainPrevBytes = os.ProcessRssBytes()
        # [m1-line] Rewrite bucket: spans the previous source's release to
        # this iteration start, the same window the retain-ledger credits.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerCollectInto(
                compilerCsgAllocDRewriteBlocks,
                compilerCsgAllocDRewriteBytes)
            compilerCsgAllocRewriteBlocks =
                compilerCsgAllocRewriteBlocks + compilerCsgAllocDRewriteBlocks
            compilerCsgAllocRewriteBytes =
                compilerCsgAllocRewriteBytes + compilerCsgAllocDRewriteBytes
        let parseBeginNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
        # [merge-arena] One reserve size for every source: the per-source
        # exact size changes the arena's allocation size on every iteration, so
        # the allocator cannot reuse the block it just got back and RSS
        # ratchets by roughly twice the sum of all per-source capacities.
        # `mergeFixedArenaReserve` is the maximum over all sources, so a source
        # can never need to grow past it, and the per-source column census
        # below is unchanged.
        var sourceArenaReserve: int32
        if compilerCsgMergeFixedArenaReserve:
            sourceArenaReserve = mergeFixedArenaReserve
        else:
            sourceArenaReserve =
                work.typeArenaForestSourceArenaBytes[sourceIndex] + 65536
        # [U0-cut] Pass 0's per-column census for this source.  Handing it to
        # the reader reserves every tree arena column at its exact final
        # length before the first append, so no column abandons a block and
        # the in-loop transient is the live bytes instead of the geometric
        # block sum.
        var sourceColumnCensus: int32[]
        let sourceCensusBase: int32 =
            sourceIndex * parser.ParserValueExprTreeArenaColumnCount
        let sourceCensusEnd: int32 =
            sourceCensusBase + parser.ParserValueExprTreeArenaColumnCount
        if sourceCensusBase < 0 ||
           sourceCensusEnd >
               work.typeArenaForestSourceColumnCensus.len:
            err = Fmt" compiler csg: streaming source column census missing source_index={sourceIndex} census={work.typeArenaForestSourceColumnCensus.len}"
            typearena.TypedExprTypeArenaRelease(arenaValue)
            return false
        var censusCursor: int32 = sourceCensusBase
        while censusCursor < sourceCensusEnd:
            add(sourceColumnCensus,
                work.typeArenaForestSourceColumnCensus[censusCursor])
            censusCursor = censusCursor + 1
        if compilerCsgMemTrace:
            let parseBeginTag = Fmt"forest_parse_begin pass=1 src={sourceIndex} reserve={sourceArenaReserve}"
            compilerCsgMemTraceEmit(parseBeginTag)
        compilerCsgMergeStageEmit("pre_parse", sourceIndex)
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP1RewriteNs =
                compilerCsgForestSubP1RewriteNs + (tcNow - tcLoopNs)
            tcLoopNs = tcNow
        if compilerCsgMemTrace:
            retainSegBlocks = system.MemLiveAllocations()
            retainSegBytes = os.ProcessRssBytes()
        # [m1-line] Pin the parse bucket start: the column-census build above
        # stays in the rewrite window, exactly like the retain-ledger's
        # retainSegBlocks reading here.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerMark()
        var sourceTree: parser.ParserValueExprTree
        var treeRead = false
        if work.exprCallProfiles[sourceIndex].migrationSourceSyntax:
            treeRead =
                parser.ParserValueExprReadMigrationSourceTreeFromTextReserved(
                    parserInputText, sourceArenaReserve, sourceColumnCensus,
                    sourceTree, buildErr)
        else:
            treeRead = parser.ParserValueExprReadTreeFromTextReserved(
                parserInputText, sourceArenaReserve, sourceColumnCensus,
                sourceTree, buildErr)
        compilerCsgMergeStageEmit("post_parse", sourceIndex)
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP1ParseNs =
                compilerCsgForestSubP1ParseNs + (tcNow - tcLoopNs)
            tcLoopNs = tcNow
        if compilerCsgMemTrace:
            retainDParseBlocks =
                system.MemLiveAllocations() - retainSegBlocks
            retainDParseBytes =
                os.ProcessRssBytes() - retainSegBytes
            compilerCsgRetainParseBlocks =
                compilerCsgRetainParseBlocks + retainDParseBlocks
            compilerCsgRetainParseBytes =
                compilerCsgRetainParseBytes + retainDParseBytes
            retainSegBlocks = system.MemLiveAllocations()
            retainSegBytes = os.ProcessRssBytes()
        # [m1-line] Parse bucket: the allocator's own live delta across the
        # ReadTreeFromTextReserved call (lex + produce + consts), cross-check
        # key for the retain-ledger merge_parse bucket.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerCollectInto(
                compilerCsgAllocDParseBlocks, compilerCsgAllocDParseBytes)
            compilerCsgAllocParseBlocks =
                compilerCsgAllocParseBlocks + compilerCsgAllocDParseBlocks
            compilerCsgAllocParseBytes =
                compilerCsgAllocParseBytes + compilerCsgAllocDParseBytes
        if !treeRead:
            parser.ParserValueExprTreeRelease(sourceTree)
            typearena.TypedExprTypeArenaRelease(arenaValue)
            err = buildErr
            return false
        if sourceTree.producerSourceCount != 1:
            err = Fmt" compiler csg: streaming source tree authority invalid source_index={sourceIndex} producer_count={sourceTree.producerSourceCount}"
            parser.ParserValueExprTreeRelease(sourceTree)
            typearena.TypedExprTypeArenaRelease(arenaValue)
            return false
        # [S1b-0f] The whole-forest completeness gate is replaced by its
        # per-source slice, taken against the very tree the entries were
        # extracted from.  N passing slices plus the base reconciliation above
        # is the same statement as one passing whole-forest pass.
        if !typearena.TypedExprTypeDeclarationIndexVerifySourceAgainstInto(
               sourceTree,
               sourceIndex,
               declarationIndex.typeSyntaxBaseBySource[sourceIndex],
               declarationIndex.declarationBaseBySource[sourceIndex],
               declarationIndex,
               buildErr):
            err = Fmt" compiler csg: TypeArena declaration index verification failed source_index={sourceIndex}: {buildErr}"
            parser.ParserValueExprTreeRelease(sourceTree)
            typearena.TypedExprTypeArenaRelease(arenaValue)
            return false
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP1VerifyNs =
                compilerCsgForestSubP1VerifyNs + (tcNow - tcLoopNs)
            tcLoopNs = tcNow
        if !typearena.TypedExprTypeResolutionAuthorityAppendSourceInto(
               sourceTree,
               sourceIndex,
               declarationIndex.typeSyntaxBaseBySource[sourceIndex],
               genericSymbolBase,
               declarationIndex,
               sortedEntryRows,
               importAuthority,
               sortedImportRows,
               authority,
               buildErr):
            err = Fmt" compiler csg: TypeArena resolution authority failed source_index={sourceIndex}: {buildErr}"
            parser.ParserValueExprTreeRelease(sourceTree)
            typearena.TypedExprTypeArenaRelease(arenaValue)
            return false
        compilerCsgMergeStageEmit("post_authority", sourceIndex)
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubAuthorityNs =
                compilerCsgForestSubAuthorityNs + (tcNow - tcLoopNs)
            tcLoopNs = tcNow
        if compilerCsgMemTrace:
            retainDAuthBlocks =
                system.MemLiveAllocations() - retainSegBlocks
            retainDAuthBytes =
                os.ProcessRssBytes() - retainSegBytes
            compilerCsgRetainAuthorityBlocks =
                compilerCsgRetainAuthorityBlocks + retainDAuthBlocks
            compilerCsgRetainAuthorityBytes =
                compilerCsgRetainAuthorityBytes + retainDAuthBytes
            retainSegBlocks = system.MemLiveAllocations()
            retainSegBytes = os.ProcessRssBytes()
        # [m1-line] Authority bucket.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerCollectInto(
                compilerCsgAllocDAuthBlocks, compilerCsgAllocDAuthBytes)
            compilerCsgAllocAuthorityBlocks =
                compilerCsgAllocAuthorityBlocks + compilerCsgAllocDAuthBlocks
            compilerCsgAllocAuthorityBytes =
                compilerCsgAllocAuthorityBytes + compilerCsgAllocDAuthBytes
        if !typearena.TypedExprTypeArenaAppendSourceFromTreeInto(
               arenaValue,
               sourceTree,
               authority,
               arenaState,
               sourceIndex,
               sourceIndex,
               tokenBase,
               bracketArgBase,
               genericSymbolBase,
               genericSymbolChildBase,
               functionBase,
               sourceIndex,
               1,
               declarationIndex.typeSyntaxBaseBySource[sourceIndex],
               pending,
               buildErr):
            err = Fmt" compiler csg: TypeArena production failed source_index={sourceIndex}: {buildErr}"
            parser.ParserValueExprTreeRelease(sourceTree)
            typearena.TypedExprTypeArenaRelease(arenaValue)
            return false
        compilerCsgMergeStageEmit("post_ta", sourceIndex)
        if compilerCsgMemTrace:
            retainDTaBlocks =
                system.MemLiveAllocations() - retainSegBlocks
            retainDTaBytes =
                os.ProcessRssBytes() - retainSegBytes
            compilerCsgRetainTaAppendBlocks =
                compilerCsgRetainTaAppendBlocks + retainDTaBlocks
            compilerCsgRetainTaAppendBytes =
                compilerCsgRetainTaAppendBytes + retainDTaBytes
            retainSegBlocks = system.MemLiveAllocations()
            retainSegBytes = os.ProcessRssBytes()
        # [m1-line] TypeArena append bucket.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerCollectInto(
                compilerCsgAllocDTaBlocks, compilerCsgAllocDTaBytes)
            compilerCsgAllocTaAppendBlocks =
                compilerCsgAllocTaAppendBlocks + compilerCsgAllocDTaBlocks
            compilerCsgAllocTaAppendBytes =
                compilerCsgAllocTaAppendBytes + compilerCsgAllocDTaBytes
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubAppendNs =
                compilerCsgForestSubAppendNs + (tcNow - tcLoopNs)
            tcLoopNs = tcNow
        texpr.TypedExprBuildIndexColumnLensTrace(buildIndex, "pre_append", sourceIndex, sourceText.len)
        if !texpr.TypedExprBuildIndexAppendSourceCallDeclarationsDeferredCore(
               buildIndex,
               work.typedMetadataContexts,
               sourceIndex,
               sourceTree,
               functionBase):
            err = Fmt" compiler csg: call declaration index failed source_index={sourceIndex}"
            parser.ParserValueExprTreeRelease(sourceTree)
            typearena.TypedExprTypeArenaRelease(arenaValue)
            return false
        texpr.TypedExprBuildIndexColumnLensTrace(buildIndex, "post_append", sourceIndex, sourceText.len)
        if compilerCsgMemTrace:
            retainDBuildBlocks =
                system.MemLiveAllocations() - retainSegBlocks
            retainDBuildBytes =
                os.ProcessRssBytes() - retainSegBytes
            compilerCsgRetainBuildIndexBlocks =
                compilerCsgRetainBuildIndexBlocks + retainDBuildBlocks
            compilerCsgRetainBuildIndexBytes =
                compilerCsgRetainBuildIndexBytes + retainDBuildBytes
            retainSegBlocks = system.MemLiveAllocations()
            retainSegBytes = os.ProcessRssBytes()
        # [m1-line] Build-index bucket.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerCollectInto(
                compilerCsgAllocDBuildBlocks, compilerCsgAllocDBuildBytes)
            compilerCsgAllocBuildIndexBlocks =
                compilerCsgAllocBuildIndexBlocks + compilerCsgAllocDBuildBlocks
            compilerCsgAllocBuildIndexBytes =
                compilerCsgAllocBuildIndexBytes + compilerCsgAllocDBuildBytes
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubBuildNs =
                compilerCsgForestSubBuildNs + (tcNow - tcLoopNs)
            tcLoopNs = tcNow
        compilerCsgMergeReleaseEmit("pre", sourceIndex, sourceTree, arenaState.tree)
        if !compilerCsgMergeReleaseDetachOff:
            typearena.TypedExprTypeArenaBuildStateDetachSourceTree(arenaState)
        parser.ParserValueExprTreeRelease(sourceTree)
        compilerCsgMergeReleaseEmit("post", sourceIndex, sourceTree, arenaState.tree)
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubP1ReleaseNs =
                compilerCsgForestSubP1ReleaseNs + (tcNow - tcLoopNs)
            tcLoopNs = tcNow
            compilerCsgForestSubTimeEmit("p1")
        # [c-line retain-ledger] Release segment (negative), then the
        # per-source ledger line and the periodic top-contributor keys block.
        # Writing per source means a mid-merge resource-guard kill still
        # leaves the named readings on stderr; the report path is unreachable
        # in that case.
        if compilerCsgMemTrace:
            let retainDReleaseBlocks: int64 =
                system.MemLiveAllocations() - retainSegBlocks
            let retainDReleaseBytes: int64 =
                os.ProcessRssBytes() - retainSegBytes
            compilerCsgRetainReleaseBlocks =
                compilerCsgRetainReleaseBlocks + retainDReleaseBlocks
            compilerCsgRetainReleaseBytes =
                compilerCsgRetainReleaseBytes + retainDReleaseBytes
            retainPrevBlocks = system.MemLiveAllocations()
            retainPrevBytes = os.ProcessRssBytes()
            compilerCsgRetainSources = compilerCsgRetainSources + 1
            compilerCsgRetainLedgerEmitSource(sourceIndex,
                                              retainDParseBlocks,
                                              retainDParseBytes,
                                              retainDAuthBlocks,
                                              retainDAuthBytes,
                                              retainDTaBlocks,
                                              retainDTaBytes,
                                              retainDBuildBlocks,
                                              retainDBuildBytes,
                                              retainDReleaseBlocks,
                                              retainDReleaseBytes)
            if sourceIndex % 16 == 15:
                compilerCsgRetainLedgerEmitTopKeys()
        # [m1-line] Release bucket, then this source's alloc_ledger line and
        # the periodic per-owner top keys.  Emitted per source so a mid-merge
        # guard kill or panic still leaves the named readings on stderr.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerCollectInto(
                compilerCsgAllocDReleaseBlocks,
                compilerCsgAllocDReleaseBytes)
            compilerCsgAllocReleaseBlocks =
                compilerCsgAllocReleaseBlocks + compilerCsgAllocDReleaseBlocks
            compilerCsgAllocReleaseBytes =
                compilerCsgAllocReleaseBytes + compilerCsgAllocDReleaseBytes
            compilerCsgAllocSources = compilerCsgAllocSources + 1
            compilerCsgAllocTokens =
                compilerCsgAllocTokens +
                    int64(declarationIndex.tokenCountBySource[sourceIndex])
            os.WriteLine(os.Get_stderr(),
                Fmt"alloc_ledger src={sourceIndex} tokens={declarationIndex.tokenCountBySource[sourceIndex]} src_bytes={sourceText.len} parse={compilerCsgAllocDParseBlocks}/{compilerCsgAllocDParseBytes} auth={compilerCsgAllocDAuthBlocks}/{compilerCsgAllocDAuthBytes} ta={compilerCsgAllocDTaBlocks}/{compilerCsgAllocDTaBytes} build={compilerCsgAllocDBuildBlocks}/{compilerCsgAllocDBuildBytes} release={compilerCsgAllocDReleaseBlocks}/{compilerCsgAllocDReleaseBytes} tot_parse={compilerCsgAllocParseBlocks}/{compilerCsgAllocParseBytes} tot_auth={compilerCsgAllocAuthorityBlocks}/{compilerCsgAllocAuthorityBytes} tot_ta={compilerCsgAllocTaAppendBlocks}/{compilerCsgAllocTaAppendBytes} tot_build={compilerCsgAllocBuildIndexBlocks}/{compilerCsgAllocBuildIndexBytes} tot_release={compilerCsgAllocReleaseBlocks}/{compilerCsgAllocReleaseBytes} tot_rewrite={compilerCsgAllocRewriteBlocks}/{compilerCsgAllocRewriteBytes} sources={compilerCsgAllocSources}")
            if sourceIndex % 16 == 15:
                compilerCsgAllocLedgerTopEmit()
        # 每源归还 pass1 churn 死页.
        let _streamSourceChurnRelief = os.ProcessMemoryPressureRelief()
        tokenBase =
            tokenBase + declarationIndex.tokenCountBySource[sourceIndex]
        bracketArgBase =
            bracketArgBase +
                declarationIndex.bracketArgCountBySource[sourceIndex]
        genericSymbolBase =
            genericSymbolBase +
                declarationIndex.genericSymbolCountBySource[sourceIndex]
        genericSymbolChildBase =
            genericSymbolChildBase +
                declarationIndex.genericSymbolChildCountBySource[sourceIndex]
        functionBase =
            functionBase + declarationIndex.functionCountBySource[sourceIndex]
        if compilerCsgMemTrace:
            let streamArena = arenamod.ArenaUsed(arenaValue.arena)
            let forestAppendedTag = Fmt"forest_appended src={sourceIndex} forest_arena={streamArena}"
            compilerCsgMemTraceEmit(forestAppendedTag)
            let taStreamTag = Fmt"ta_stream src={sourceIndex} arena={streamArena}"
            compilerCsgMemTraceEmit(taStreamTag)
    # [forward-typeid] Replay pass.  Deterministic by construction: the queue is
    # in ascending global TypeSyntax order, so this walks consumer sources in
    # ascending order and `InternSyntaxRec` walks rows in ascending order inside
    # each.  Every declaration root is materialised by now, so no queued row can
    # still be unresolved; a failure here is a defect, never a retry.  The queue
    # is reached through the build state, so no existing call in this file
    # changes shape.
    # [forward-replay-fixpoint] Bounded fixpoint: a pass may skip a row whose
    # target is still deferred, in which case the cursor rewinds and the queue
    # is walked again.  The bound is the fail-closed guard -- past it, a still
    # flagged row is reported by the drained check below, never dropped.
    var replayPass: int32
    var replayCursor: int32
    while replayCursor < arenaState.forwardNominal.typeSyntaxNodeIndexes.len:
        let replaySourceIndex =
            arenaState.forwardNominal.producerSourceIndexes[replayCursor]
        # Skip a source whose queued rows are all bound already.
        var replayScanCursor: int32 = replayCursor
        var replayAnyFlagged: bool
        replayAnyFlagged = false
        while replayScanCursor <
                  arenaState.forwardNominal.typeSyntaxNodeIndexes.len &&
              arenaState.forwardNominal.producerSourceIndexes[
                  replayScanCursor] == replaySourceIndex:
            if arenaState.forwardNominal.blockedFlags[
                   arenaState.forwardNominal.typeSyntaxNodeIndexes[
                       replayScanCursor]]:
                replayAnyFlagged = true
            replayScanCursor = replayScanCursor + 1
        if !replayAnyFlagged:
            replayCursor = replayScanCursor
            continue
        if replaySourceIndex < 0 ||
           replaySourceIndex >= work.orderedSources.len:
            err = Fmt" compiler csg: TypeArena forward replay source invalid cursor={replayCursor} source_index={replaySourceIndex} sources={work.orderedSources.len}"
            typearena.TypedExprTypeArenaRelease(arenaValue)
            return false
        # The loop's bases are running accumulators and are totals by now, so
        # this source's token base is recomputed from the sealed index.
        var replayTokenBase: int32
        var replayBaseCursor: int32
        while replayBaseCursor < replaySourceIndex:
            replayTokenBase =
                replayTokenBase +
                    declarationIndex.tokenCountBySource[replayBaseCursor]
            replayBaseCursor = replayBaseCursor + 1
        var tcReplayNs: int64 = 0
        if compilerCsgForestSubTimeEnabled:
            tcReplayNs = compilerCsgT4NowNs()
        # [c2-line] Diagnostic arm: the original tree path plus the
        # row-for-row tree-vs-column equality proof, extracted verbatim into
        # its own function.  The default arm below reads columns only and
        # never parses a source.
        if compilerCsgReplayColDiag:
            if !compilerCsgReplayForwardRowsTreePathInto(
                   work, declarationIndex, arenaValue, authority, arenaState,
                   pending, replaySourceIndex, replayTokenBase, buildErr,
                   err):
                err = Fmt" compiler csg: TypeArena forward replay tree path failed source_index={replaySourceIndex}: {buildErr}"
                typearena.TypedExprTypeArenaRelease(arenaValue)
                return false
        else:
            # [c2-line] Hard-switched path: pure queue walk.  No source is
            # re-parsed; every parser fact the walk reads comes from the arena
            # columns the append pass materialised.  This source's row count
            # comes from the sealed declaration index.
            var replayRowCount: int32 = 0
            if replaySourceIndex + 1 <
                    declarationIndex.typeSyntaxBaseBySource.len:
                replayRowCount =
                    declarationIndex.typeSyntaxBaseBySource[
                        replaySourceIndex + 1] -
                        declarationIndex.typeSyntaxBaseBySource[
                            replaySourceIndex]
            else:
                replayRowCount =
                    declarationIndex.typeSyntaxCount -
                        declarationIndex.typeSyntaxBaseBySource[
                            replaySourceIndex]
            if !typearena.TypedExprTypeArenaReplayForwardRowsFromState(
                   arenaValue, authority, arenaState, pending,
                   replaySourceIndex, replayTokenBase,
                   declarationIndex.typeSyntaxBaseBySource[replaySourceIndex],
                   replayRowCount, buildErr):
                err = Fmt" compiler csg: TypeArena forward replay from state failed source_index={replaySourceIndex}: {buildErr}"
                typearena.TypedExprTypeArenaRelease(arenaValue)
                return false
        if compilerCsgForestSubTimeEnabled:
            let tcNow = compilerCsgT4NowNs()
            compilerCsgForestSubReplayNs =
                compilerCsgForestSubReplayNs + (tcNow - tcReplayNs)
            tcReplayNs = tcNow
        var retainReplayBeginBlocks: int64 = 0
        var retainReplayBeginBytes: int64 = 0
        if compilerCsgMemTrace:
            retainReplayBeginBlocks = system.MemLiveAllocations()
            retainReplayBeginBytes = os.ProcessRssBytes()
        # [m1-line] Same bracket positions as the retain-ledger replay pair
        # above/below, so the two replay buckets stay comparable 1:1.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerMark()
        # [c2-line] replay_tid snapshot: the rows this arm is about to bind,
        # taken BEFORE either arm touches them.  Shared by both arms.
        var replayTidProbeRows: int32[]
        if compilerCsgReplayTidTrace:
            var probeScan: int32 = replayCursor
            while probeScan <
                      arenaState.forwardNominal.typeSyntaxNodeIndexes.len &&
                  arenaState.forwardNominal.producerSourceIndexes[
                      probeScan] == replaySourceIndex:
                if arenaState.forwardNominal.blockedFlags[
                       arenaState.forwardNominal.typeSyntaxNodeIndexes[
                           probeScan]]:
                    add(replayTidProbeRows,
                        arenaState.forwardNominal.typeSyntaxNodeIndexes[
                            probeScan])
                probeScan = probeScan + 1
        if compilerCsgMemTrace:
            let retainDReplayBlocks: int64 =
                system.MemLiveAllocations() - retainReplayBeginBlocks
            let retainDReplayBytes: int64 =
                os.ProcessRssBytes() - retainReplayBeginBytes
            compilerCsgRetainReplaySources = compilerCsgRetainReplaySources + 1
            compilerCsgRetainReplayBlocks =
                compilerCsgRetainReplayBlocks + retainDReplayBlocks
            compilerCsgRetainReplayBytes =
                compilerCsgRetainReplayBytes + retainDReplayBytes
            os.WriteLine(os.Get_stderr(),
                Fmt"retain_ledger_replay src={replaySourceIndex} blocks={retainDReplayBlocks} bytes={retainDReplayBytes} tot_n={compilerCsgRetainReplaySources} tot_blocks={compilerCsgRetainReplayBlocks} tot_bytes={compilerCsgRetainReplayBytes}")
        # [m1-line] Replay bucket emit, same window as the retain-ledger's.
        if compilerCsgAllocLedgerArmed:
            compilerCsgAllocLedgerCollectInto(
                compilerCsgAllocDReplayBlocks,
                compilerCsgAllocDReplayBytes)
            compilerCsgAllocReplaySources =
                compilerCsgAllocReplaySources + 1
            compilerCsgAllocReplayBlocks =
                compilerCsgAllocReplayBlocks + compilerCsgAllocDReplayBlocks
            compilerCsgAllocReplayBytes =
                compilerCsgAllocReplayBytes + compilerCsgAllocDReplayBytes
        # [c2-line] replay_tid emit: the TypeId each probe row ended up with.
        # Both arms print the same keys in the same row order.
        if compilerCsgReplayTidTrace:
            var probeEmit: int32 = 0
            while probeEmit < replayTidProbeRows.len:
                let probeRow = replayTidProbeRows[probeEmit]
                os.WriteLine(os.Get_stderr(),
                    Fmt"replay_tid src={replaySourceIndex} row={probeRow} tid={typearena.TypedExprTypeArenaTypeSyntaxTypeIdAt(arenaValue, probeRow)}")
                probeEmit = probeEmit + 1
        while replayCursor < arenaState.forwardNominal.typeSyntaxNodeIndexes.len &&
              arenaState.forwardNominal.producerSourceIndexes[replayCursor] ==
                  replaySourceIndex:
            replayCursor = replayCursor + 1
        # [forward-replay-progress] Rewind while the pass made progress.  A
        # deferred row is only skipped because its target was still deferred at
        # the moment it was visited, and the walk is in ascending source order,
        # so a forward chain of depth N needs N passes -- the cap was a guess and
        # the r84 probe caught it one pass short.  Progress is now counted, not
        # assumed: `forwardReplayBoundCount` is the number of previously
        # deferred rows this pass materialised, and each such pass strictly
        # shrinks the flagged set.  A pass that binds nothing cannot change the
        # next pass, so it stops here and `RequireDrainedInto` reports whatever
        # is left.  Nothing is enqueued twice.
        # [forward-replay-walk] The rewind is the PASS boundary, and a pass is
        # one complete walk of the queue: `replayCursor` only reaches the end
        # here, after this source's group was consumed.  Rewinding inside the
        # per-source body (where this test used to sit) made every pass replay
        # exactly one source -- r85 measured 187 rewinds for 194 sources, with
        # each source re-parsed on the pass that followed its own replay.
        if replayCursor >=
               arenaState.forwardNominal.typeSyntaxNodeIndexes.len &&
           arenaState.forwardReplayBoundCount > 0:
            if compilerCsgMemTrace:
                let replayPassTag = Fmt"replay_pass pass={replayPass} deferred_this_pass={arenaState.forwardReplayDeferredCount} bound_this_pass={arenaState.forwardReplayBoundCount}"
                compilerCsgMemTraceEmit(replayPassTag)
            arenaState.forwardReplayDeferredCount = 0
            arenaState.forwardReplayBoundCount = 0
            replayPass = replayPass + 1
            replayCursor = 0
    var tcSealNs: int64 = 0
    if compilerCsgForestSubTimeEnabled:
        tcSealNs = compilerCsgT4NowNs()
    # [p1phase1] Deferred core finish, before the seal: the metadata producer
    # (core pass 2) runs verbatim here, after the merge loop's tree spike
    # window has closed.  Receipts: `p1_ctx_index_built` re-fires here (it
    # moved off the loop entry), and the `p1_ctx_census index_live_bytes`
    # line must equal the core-first arm's pinned 37,542,811 (exact-capacity
    # reserve + bucket rehash keeps capacity identical; only the hash chain
    # direction of the pass-1 families differs, which carries no content).
    if !texpr.TypedExprBuildIndexFinishDeferredCore(
           work.typedMetadataContexts,
           buildIndex,
           buildErr):
        typearena.TypedExprTypeArenaRelease(arenaValue)
        err = Fmt" compiler csg: TypeArena typed context deferred core failed: {buildErr}"
        return false
    if compilerCsgMemTrace:
        compilerCsgMemTraceEmit("p1_ctx_index_built")
        # [c1-line] Census of the finished shared index: structured live
        # bytes (column arrays incl. capacity) + the full column-lens line
        # (its own CHENG_BUILDINDEX_TRACE gate; arm both envs to get it).
        let c1CtxCensus = Fmt"csg_mem tag=p1_ctx_census index_live_bytes={texpr.TypedExprBuildIndexLiveBytes(buildIndex)}"
        os.WriteLine(os.Get_stderr(), c1CtxCensus)
        texpr.TypedExprBuildIndexColumnLensTrace(buildIndex, "c1_ctx_done", -1, 0)
    texpr.TypedExprBuildIndexSealCallDeclarations(buildIndex)
    if !typearena.TypedExprTypeResolutionAuthoritySealInto(
           authority,
           declarationIndex.typeSyntaxCount,
           columnLimits.genericSymbolCount,
           buildErr):
        err = Fmt" compiler csg: TypeArena resolution authority failed: {buildErr}"
        typearena.TypedExprTypeArenaRelease(arenaValue)
        return false
    if compilerCsgMemTrace:
        compilerCsgMemTraceEmit("typed_context_lookup_built")
        # [c-line retain-ledger] Compile-time egress before typed facts: the
        # full merge+replay totals and the exact ledger keys land on stderr
        # here even if the later phases die, and the guard cannot have killed
        # us before this line without the per-source lines already carrying
        # the partial totals.
        compilerCsgRetainLedgerEmitTotals("typed_context_lookup_built")
        compilerCsgRetainLedgerEmitTopKeys()
    # [m1-line] Compile-time egress for the ledger session: totals, per-owner
    # top keys and the finish snapshot land here even if a later phase dies;
    # the owner stays open (the arena and forest are intentionally live) and
    # the provider reclaims it at process exit.
    if compilerCsgAllocLedgerArmed:
        compilerCsgAllocLedgerTotalsEmit("typed_context_lookup_built")
        compilerCsgAllocLedgerTopEmit()
        compilerCsgAllocLedgerFinishEmit()
    # [c2-line] Whole-run equality verdict: the hard switch to
    # TypedExprTypeArenaReplayForwardRowsFromState is gated on mismatch=0.
    if compilerCsgReplayColDiag:
        os.WriteLine(os.Get_stderr(),
            Fmt"replay_col_diag_total checked={compilerCsgReplayColDiagChecked} mismatch={compilerCsgReplayColDiagMismatch}")
    # [forward-typeid] Seal consumes the TypeId column, so the queue must be
    # provably drained first: every enqueued row either cleared its flag in the
    # replay pass or is still flagged and aborts here with its row.
    if !typearena.TypedExprTypeArenaForwardNominalRequireDrainedInto(
           arenaState.forwardNominal, arenaValue, buildErr):
        err = Fmt" compiler csg: TypeArena forward nominal queue failed: {buildErr}"
        typearena.TypedExprTypeArenaRelease(arenaValue)
        return false
    if !typearena.TypedExprTypeArenaSealInto(
           arenaValue, arenaState, pending, work.typeArena, buildErr):
        err = Fmt" compiler csg: TypeArena production failed: {buildErr}"
        var ownedTypeArena: typearena.TypedExprTypeArena
        ownedTypeArena = arenaValue
        typearena.TypedExprTypeArenaReleaseOwned(ownedTypeArena)
        return false
    if work.typeArena == nil ||
       work.typeArena.producerSourceCount != work.orderedSources.len ||
       !typearena.TypedExprTypeArenaStrictValidateInto(
           work.typeArena, buildErr):
        if buildErr == "":
            buildErr = "producer source coverage mismatch"
        err = Fmt" compiler csg: TypeArena production receipt invalid: {buildErr}"
        var ownedReceiptArena: typearena.TypedExprTypeArena
        ownedReceiptArena = work.typeArena
        work.typeArena = nil
        typearena.TypedExprTypeArenaReleaseOwned(ownedReceiptArena)
        return false
    if compilerCsgForestSubTimeEnabled:
        let tcNow = compilerCsgT4NowNs()
        compilerCsgForestSubSealNs =
            compilerCsgForestSubSealNs + (tcNow - tcSealNs)
    compilerCsgForestSubTimeEmit("done")
    err = ""
    return true

fn CompilerCsgParserReceiptLayerHasSemanticRows(
        layer: var parser.NormalizedExprLayer): bool =
    return layer.exprs.len > 0 || layer.scopes.len > 0 ||
           layer.questionResidualCount > 0 ||
           (layer.valueExprTree != nil &&
            (layer.valueExprTree.nodeCount > 0 ||
             layer.valueExprTree.genericCount > 0 ||
             layer.valueExprTree.regionCount > 0 ||
             layer.valueExprTree.rootCount > 0 ||
             layer.valueExprTree.tokenCount > 0 ||
             layer.valueExprTree.callEventCount > 0 ||
             layer.valueExprTree.statementRootCount > 0))

@borrows
fn CompilerCsgConsumeExprSliceIntoTypedFacts(semanticGraph: var CompilerCsgSemanticGraph,
                                              accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                              sourceIndexCache: var CompilerCsgSourcePathIndex,
                                              typedSourceTexts: var TypedExprSourceText[],
                                              sourceIndex: int32,
                                              functionIndex: int32,
                                              typedMetadataContexts: var texpr.TypedExprSourceContext[],
                                              typedSourceIdentityIndex: var texpr.TypedExprSourceIdentityIndex,
                                              typedContextLookup: var parser.ParserSourcePathIndexLookup,
                                              sourceFactsContext: var texpr.TypedExprSourceContext,
                                              sourcePath: str,
                                              reachableSet: var CompilerCsgReachableFunctionSet,
                                              sourceExprLayer: var parser.NormalizedExprLayer,
                                              sourceTypedFacts: var TypedExprFactTable,
                                              typedIrExprCountCursor: var int32,
                                              sourceSummaryCounted: var bool,
                                              err: var str): bool =
    # [c1-line] Segment clock chain: prune -> summary -> typed facts ->
    # normalize -> digest.  All reads gated by compilerCsgDeclTimeEnabled.
    var c1SegNs: int64 = 0
    if compilerCsgDeclTimeEnabled:
        c1SegNs = compilerCsgT4NowNs()
    CompilerCsgPruneExprLayerForReachableSources(sourceExprLayer, reachableSet)
    if compilerCsgDeclTimeEnabled:
        let c1Now = compilerCsgT4NowNs()
        compilerCsgDeclTimePruneNs = compilerCsgDeclTimePruneNs + (c1Now - c1SegNs)
        c1SegNs = c1Now
    if sourceExprLayer.exprs.len > 0 && !sourceSummaryCounted:
        sourceExprLayer.sourceCount = 1
        sourceSummaryCounted = true
    else:
        sourceExprLayer.sourceCount = 0
    CompilerCsgSemanticAccumulateExprSummary(semanticGraph.exprSummary, sourceExprLayer)
    if compilerCsgDeclTimeEnabled:
        let c1Now = compilerCsgT4NowNs()
        compilerCsgDeclTimeSummaryNs = compilerCsgDeclTimeSummaryNs + (c1Now - c1SegNs)
        c1SegNs = c1Now
    let sourceExprStart = typedIrExprCountCursor
    let sourceExprCount = sourceExprLayer.exprs.len
    typedIrExprCountCursor = typedIrExprCountCursor + sourceExprCount
    var sourceFactsErr = ""
    CompilerCsgTraceStage("before_source_typed_facts")
    if !texpr.TypedExprBuildFactsAppendSourceExprLayerWithContext(typedSourceTexts,
                                                                  typedMetadataContexts,
                                                                  typedSourceIdentityIndex,
                                                                  typedContextLookup,
                                                                  sourceExprLayer,
                                                                  sourceFactsContext,
                                                                  sourceTypedFacts,
                                                                  sourceFactsErr):
        if sourceFactsErr != "":
            err = sourceFactsErr
        else:
            err = " compiler csg: source typed expr facts failed"
        return false
    if compilerCsgDeclTimeEnabled:
        let c1Now = compilerCsgT4NowNs()
        compilerCsgDeclTimeTypedFactsNs = compilerCsgDeclTimeTypedFactsNs + (c1Now - c1SegNs)
        c1SegNs = c1Now
        compilerCsgDeclTimeExprs = compilerCsgDeclTimeExprs + Int64(sourceExprCount)
        compilerCsgDeclTimeFacts = compilerCsgDeclTimeFacts + Int64(sourceTypedFacts.count)
    CompilerCsgNormalizeTypedFactRangeForCsg(sourceTypedFacts,
                                             0,
                                             sourceTypedFacts.count)
    if compilerCsgDeclTimeEnabled:
        let c1Now = compilerCsgT4NowNs()
        compilerCsgDeclTimeNormalizeNs = compilerCsgDeclTimeNormalizeNs + (c1Now - c1SegNs)
        c1SegNs = c1Now
    let sourceTypedFactStart = CompilerCsgSemanticTypedFactCount(semanticGraph)
    CompilerCsgTraceStage("r92_td_post_buildfacts")
    var sourceSemanticDigest: int64
    if !CompilerCsgSemanticTypedFactAccumulatorAppendWithDigest(semanticGraph,
                                                          accumulator,
                                                          sourceIndexCache,
                                                          reachableSet,
                                                          functionIndex,
                                                          sourceTypedFacts,
                                                          0,
                                                          sourceTypedFacts.count,
                                                          sourceSemanticDigest,
                                                          sourceFactsErr):
        err = sourceFactsErr
        return false
    let sourceTypedFactCount = CompilerCsgSemanticTypedFactCount(semanticGraph) - sourceTypedFactStart
    if compilerCsgDeclTimeEnabled:
        let c1Now = compilerCsgT4NowNs()
        compilerCsgDeclTimeDigestNs = compilerCsgDeclTimeDigestNs + (c1Now - c1SegNs)
        c1SegNs = c1Now
    CompilerCsgSemanticAppendExprSlice(semanticGraph,
                                  sourceIndex,
                                  sourcePath,
                                  functionIndex,
                                  sourceExprStart,
                                  sourceExprCount,
                                  sourceTypedFactStart,
                                  sourceTypedFactCount,
                                  sourceSemanticDigest)
    CompilerCsgTraceStage("r92_te_post_accumulate")
    texpr.TypedExprFactTableReset(sourceTypedFacts)
    CompilerCsgTraceStage("after_source_typed_facts")
    parser.NormalizedExprLayerReset(sourceExprLayer)
    let _sourceExprRelief = os.ProcessMemoryPressureRelief()
    err = ""
    return true

@borrows
fn CompilerCsgSemanticAppendSourceExprSlices(semanticGraph: var CompilerCsgSemanticGraph,
                                        accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                        sourceIndexCache: var CompilerCsgSourcePathIndex,
                                        sources: str[],
                                        typedSourceTexts: var TypedExprSourceText[],
                                        typedSourceTextIndex: var CompilerCsgSourcePathIndex,
                                        typedMetadataContexts: var texpr.TypedExprSourceContext[],
                                        typedSourceIdentityIndex: var texpr.TypedExprSourceIdentityIndex,
                                        typedContextLookup: var parser.ParserSourcePathIndexLookup,
                                        reachableSet: var CompilerCsgReachableFunctionSet,
                                        exprLayer: var parser.NormalizedExprLayer,
                                        sliceExprLayer: var parser.NormalizedExprLayer,
                                        sliceFacts: var TypedExprFactTable,
                                        exprStartBase: int32,
                                        selectedExprCount: var int32,
                                        err: var str): bool =
    selectedExprCount = 0
    parser.NormalizedExprLayerReset(sliceExprLayer)
    texpr.TypedExprFactTableReset(sliceFacts)
    var nextExprSummary = semanticGraph.exprSummary
    nextExprSummary.questionResidualCount =
        nextExprSummary.questionResidualCount + exprLayer.questionResidualCount
    var closedSources: bool[]
    var summarySourceCounted: bool[]
    for sourceIndex in 0..<sources.len:
        add(closedSources, false)
        add(summarySourceCounted, false)
    var selectedExprCountLocal: int32
    var exprIndex: int32
    var previousSourceIndex: int32 = -1
    var sourceFactsContextSourceIndex: int32 = -1
    var sourceFactsContext: texpr.TypedExprSourceContext
    while exprIndex < exprLayer.exprs.len:
        os.ProcessResourceGuardCheck()
        let sourcePathRaw = exprLayer.exprs[exprIndex].sourcePath
        var sourceIndex: int32
        if !CompilerCsgSourcePathIndexFind(typedSourceTextIndex,
                                           sourcePathRaw,
                                           sourceIndex,
                                           err):
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            texpr.TypedExprFactTableReset(sliceFacts)
            return false
        if sourceIndex < 0 || sourceIndex >= typedSourceTexts.len:
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            texpr.TypedExprFactTableReset(sliceFacts)
            err = Fmt" compiler csg: expr slice source missing source={sourcePathRaw} expr_index={exprIndex} source_index={sourceIndex} source_count={typedSourceTexts.len}"
            return false
        let sourcePath = typedSourceTexts[sourceIndex].sourcePath
        if sourcePathRaw != sourcePath:
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            texpr.TypedExprFactTableReset(sliceFacts)
            err = Fmt" compiler csg: expr slice source is not canonical source={sourcePathRaw} canonical={sourcePath} expr_index={exprIndex}"
            return false
        if sourceIndex != previousSourceIndex:
            if previousSourceIndex >= 0 && previousSourceIndex < closedSources.len:
                closedSources[previousSourceIndex] = true
            if sourceIndex >= closedSources.len || closedSources[sourceIndex]:
                if sourceFactsContextSourceIndex >= 0:
                    texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
                parser.NormalizedExprLayerReset(sliceExprLayer)
                texpr.TypedExprFactTableReset(sliceFacts)
                err = Fmt" compiler csg: expr slice source is not contiguous source={sourcePath} expr_index={exprIndex}"
                return false
            previousSourceIndex = sourceIndex
        if sourceFactsContextSourceIndex >= 0 &&
           sourceFactsContextSourceIndex != sourceIndex:
            texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            sourceFactsContextSourceIndex = -1
        let profileIndex = CompilerCsgReachableProfileIndex(reachableSet, sourcePath)
        if profileIndex < 0:
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            texpr.TypedExprFactTableReset(sliceFacts)
            err = Fmt" compiler csg: expr slice profile missing source={sourcePath} profile_index={profileIndex}"
            return false
        let functionIndex = CompilerCsgReachableFunctionIndexForProfileLine(reachableSet,
                                                                             profileIndex,
                                                                             exprLayer.exprs[exprIndex].lineNumber)
        if functionIndex < 0:
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            texpr.TypedExprFactTableReset(sliceFacts)
            err = Fmt" compiler csg: expr slice function missing source={sourcePath} line={exprLayer.exprs[exprIndex].lineNumber} expr_index={exprIndex}"
            return false
        if functionIndex >= reachableSet.reachable.len:
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            texpr.TypedExprFactTableReset(sliceFacts)
            err = Fmt" compiler csg: expr slice reachability row missing function_index={functionIndex} reachable_count={reachableSet.reachable.len}"
            return false
        var functionSelected = true
        if reachableSet.active:
            functionSelected = reachableSet.reachable[functionIndex]
        let rawExprStart = exprIndex
        parser.NormalizedExprLayerReset(sliceExprLayer)
        texpr.TypedExprFactTableReset(sliceFacts)
        while exprIndex < exprLayer.exprs.len:
            if exprLayer.exprs[exprIndex].sourcePath != sourcePath:
                break
            let candidateFunctionIndex =
                CompilerCsgReachableFunctionIndexForProfileLine(reachableSet,
                                                                 profileIndex,
                                                                 exprLayer.exprs[exprIndex].lineNumber)
            if candidateFunctionIndex < 0:
                if sourceFactsContextSourceIndex >= 0:
                    texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
                parser.NormalizedExprLayerReset(sliceExprLayer)
                texpr.TypedExprFactTableReset(sliceFacts)
                err = Fmt" compiler csg: expr slice adjacency function missing source={sourcePath} line={exprLayer.exprs[exprIndex].lineNumber} expr_index={exprIndex}"
                return false
            if candidateFunctionIndex != functionIndex:
                break
            if functionSelected:
                add(sliceExprLayer.exprs,
                    share(exprLayer.exprs[exprIndex]))
            exprIndex = exprIndex + 1
        if !functionSelected:
            parser.NormalizedExprLayerReset(sliceExprLayer)
            continue
        if sliceExprLayer.exprs.len != exprIndex - rawExprStart:
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            err = Fmt" compiler csg: selected expr slice cardinality drift function_index={functionIndex} selected={sliceExprLayer.exprs.len} raw={exprIndex - rawExprStart}"
            return false
        if sourceFactsContextSourceIndex < 0:
            var sourceFactsTextIndex: int32
            if !CompilerCsgSourcePathIndexFind(typedSourceTextIndex,
                                               sourcePath,
                                               sourceFactsTextIndex,
                                               err):
                parser.NormalizedExprLayerReset(sliceExprLayer)
                texpr.TypedExprFactTableReset(sliceFacts)
                return false
            if sourceFactsTextIndex < 0 ||
               sourceFactsTextIndex >= typedSourceTexts.len:
                parser.NormalizedExprLayerReset(sliceExprLayer)
                texpr.TypedExprFactTableReset(sliceFacts)
                err = Fmt" compiler csg: reusable facts source index invalid source={sourcePath} index={sourceFactsTextIndex} count={typedSourceTexts.len}"
                return false
            var sourceFactsContextErr = ""
            if profileIndex >= reachableSet.profileFunctionStarts.len ||
               profileIndex >= reachableSet.profileFunctionCounts.len:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
                parser.NormalizedExprLayerReset(sliceExprLayer)
                texpr.TypedExprFactTableReset(sliceFacts)
                err = Fmt" compiler csg: reusable facts function union missing source={sourcePath} profile={profileIndex}"
                return false
            let functionRangeStart =
                reachableSet.profileFunctionStarts[profileIndex]
            let functionRangeEnd = functionRangeStart +
                reachableSet.profileFunctionCounts[profileIndex]
            var functionRangeIndexes: int32[]
            for functionRangeIndex in functionRangeStart..<functionRangeEnd:
                add(functionRangeIndexes, functionRangeIndex)
            if !texpr.TypedExprBuildReusableFactsSourceContext(typedSourceTexts,
                                                                sourceFactsTextIndex,
                                                                typedMetadataContexts,
                                                                typedContextLookup,
                                                                functionRangeIndexes,
                                                                reachableSet.sourcePaths,
                                                                reachableSet.startLines,
                                                                reachableSet.endLines,
                                                                reachableSet.reachable,
                                                                reachableSet.active,
                                                                0,
                                                                functionRangeIndexes.len,
                                                                sourceFactsContext,
                                                                sourceFactsContextErr):
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
                parser.NormalizedExprLayerReset(sliceExprLayer)
                texpr.TypedExprFactTableReset(sliceFacts)
                if sourceFactsContextErr != "":
                    err = sourceFactsContextErr
                else:
                    err = Fmt" compiler csg: reusable facts source context failed source={sourcePath}"
                return false
            sourceFactsContextSourceIndex = sourceIndex
        let exprStart = selectedExprCountLocal
        selectedExprCountLocal = selectedExprCountLocal + sliceExprLayer.exprs.len
        sliceExprLayer.sourceCount = summarySourceCounted[sourceIndex] ? 0 : 1
        sliceExprLayer.questionResidualCount = 0
        CompilerCsgSemanticAccumulateExprSummary(nextExprSummary, sliceExprLayer)
        summarySourceCounted[sourceIndex] = true
        sliceExprLayer.sourceCount = 1
        var sliceFactsErr = ""
        if !texpr.TypedExprBuildFactsAppendSourceExprLayerWithContext(typedSourceTexts,
                                                                      typedMetadataContexts,
                                                                      typedSourceIdentityIndex,
                                                                      typedContextLookup,
                                                                      sliceExprLayer,
                                                                      sourceFactsContext,
                                                                      sliceFacts,
                                                                      sliceFactsErr):
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            texpr.TypedExprFactTableReset(sliceFacts)
            if sliceFactsErr != "":
                err = sliceFactsErr
            else:
                err = " compiler csg: reuse slice typed facts failed"
            return false
        CompilerCsgNormalizeTypedFactRangeForCsg(sliceFacts,
                                                 0,
                                                 sliceFacts.count)
        let factStart = CompilerCsgSemanticTypedFactCount(semanticGraph)
        var sliceSemanticDigest: int64
        if !CompilerCsgSemanticTypedFactAccumulatorAppendWithDigest(semanticGraph,
                                                              accumulator,
                                                              sourceIndexCache,
                                                              reachableSet,
                                                              functionIndex,
                                                              sliceFacts,
                                                              0,
                                                              sliceFacts.count,
                                                              sliceSemanticDigest,
                                                              sliceFactsErr):
            if sourceFactsContextSourceIndex >= 0:
                texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
            parser.NormalizedExprLayerReset(sliceExprLayer)
            texpr.TypedExprFactTableReset(sliceFacts)
            err = sliceFactsErr
            return false
        let factCount = CompilerCsgSemanticTypedFactCount(semanticGraph) - factStart
        CompilerCsgSemanticAppendExprSlice(semanticGraph,
                                      sourceIndex,
                                      sourcePath,
                                      functionIndex,
                                      exprStartBase + exprStart,
                                      sliceExprLayer.exprs.len,
                                      factStart,
                                      factCount,
                                      sliceSemanticDigest)
        parser.NormalizedExprLayerReset(sliceExprLayer)
        texpr.TypedExprFactTableReset(sliceFacts)
    if sourceFactsContextSourceIndex >= 0:
        texpr.TypedExprReleaseReusableFactsSourceContext(sourceFactsContext)
    CompilerCsgNormalizedExprLayerTerminalRelease(sliceExprLayer)
    CompilerCsgTypedFactTableTerminalRelease(sliceFacts)
    semanticGraph.exprSummary = nextExprSummary
    selectedExprCount = selectedExprCountLocal
    err = ""
    return true

fn CompilerCsgBuildSourceScratchRelease(work: var CompilerCsgBuildWorkingSet) =
    # [orcd9-inst] 逐语句步进标 SR1..SR19（崩前最后一条 SR 编号=已完成的
    # 释放语句，致命语句=其下一条）。S1/S2/S12/S13 为复合释放（内部多动作）。
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SR-IN")
    CompilerCsgBuildActiveCompactProfileViewRelease(work)
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR1")
    texpr.TypedExprReleaseReusableFactsSourceContext(work.activeFactsContext)
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR2")
    texpr.TypedExprClearSourceContextAllFields(work.activeMetadataContext)
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR3")
    work.activeText = ""
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR4")
    work.activeProfile = parser.NormalizedExprCallProfile()
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR5")
    work.activeDecls = []
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR6")
    work.activeDeclLines = []
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR7")
    work.activeDeclImportcMask = ""
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR8")
    work.activeMetadataContext = texpr.TypedExprSourceContext()
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR9")
    work.activeTypedSourceText = ""
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR10")
    work.activeExternalCallLookup = parser.ParserTextLookup()
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR11")
    # Release the per-function borrowed slice before its full-source owner:
    # activeFunctionExprLayer holds a borrow lease on activeExprLayer's
    # value tree, and an error-path teardown can arrive while that lease is
    # still live.
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR12")
    CompilerCsgNormalizedExprLayerTerminalRelease(
        work.activeFunctionExprLayer)
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR13")
    CompilerCsgNormalizedExprLayerTerminalRelease(work.activeExprLayer)
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR14")
    work.activeCurrentProfile = parser.NormalizedExprCallProfile()
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR15")
    work.activeCurrentProfileText = ""
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR16")
    work.activeCurrentProfileNormalizedText = ""
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR17")
    work.activeLocalCallLookup = parser.ParserTextLookup()
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR18")
    work.activeImportcCallLookup = parser.ParserTextLookup()
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "SR19")
    work.activeFactsContext = texpr.TypedExprSourceContext()
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8SR-OK")

fn CompilerCsgTypedFactTableTerminalRelease(table: var TypedExprFactTable) =
    texpr.TypedExprFactTableRelease(table)
    table = TypedExprFactTable()

fn CompilerCsgBuildWorkingSetReleaseSemanticIdentityIndex(
        work: var CompilerCsgBuildWorkingSet) =
    if !work.functionSemanticIdentityIndexOwned:
        return
    CompilerCsgSemanticIdentityIndexRelease(work.functionSemanticIdentityIndex)
    work.functionSemanticIdentityIndexOwned = false

fn CompilerCsgBuildWorkingSetReleaseActiveFunctionSourceSlices(
        work: var CompilerCsgBuildWorkingSet) =
    if work.activeFunctionSourceSlicesOwned:
        if work.activeFunctionSourceSlices.released:
            panic("compiler csg: owned function source slices already released")
        fslice.FunctionSourceSliceIndexRelease(
            work.activeFunctionSourceSlices)
        work.activeFunctionSourceSlicesOwned = false
        return
    if !work.activeFunctionSourceSlices.released:
        if work.activeFunctionSourceSlices.sealed ||
           work.activeFunctionSourceSlices.sourceIndices.len > 0 ||
           work.activeFunctionSourceSlices.sourceStarts.len > 0 ||
           work.activeFunctionSourceSlices.expectedFunctionCount > 0 ||
           work.activeFunctionSourceSlices.expectedSourceCount > 0:
            panic("compiler csg: unowned live function source slices")
        fslice.FunctionSourceSliceIndexRelease(
            work.activeFunctionSourceSlices)

fn CompilerCsgBuildWorkingSetReleaseWithOutcome(
        work: var CompilerCsgBuildWorkingSet,
        outcome: int32,
        buildFragmentLifetimeReceipt:
            var buildlife.CompilerCsgBuildFragmentLifetimeReceipt) =
    if work.buildFragmentLifetime.active &&
       !payloadlife.CompilerPayloadOutcomeValid(outcome):
        panic("compiler csg: invalid build fragment lifetime outcome")
    # PhaseArena CSG 半片: abort/收尾统一幂等 teardown (相位中途死亡不走
    # 相位 reset, 仅 close+destroy 交还托管权威)。
    CompilerCsgPhaseArenaGraphNodeStoreTeardown(work)
    # 两个字符串半片各自持有独立 arena，abort/收尾必须逐一释放。
    CompilerCsgPhaseArenaLineStoreTeardown(work)
    CompilerCsgPhaseArenaRoundTextStoreTeardown(work)
    CompilerCsgBuildWorkingSetReleaseSemanticIdentityIndex(work)
    CompilerCsgBuildWorkingSetReleaseActiveFunctionSourceSlices(work)
    if work.semanticTypedFactAccumulator.active:
        assert(!work.payloadMovedToOut,
               "compiler csg: active typed-fact accumulator after output move")
        CompilerCsgSemanticTypedFactAccumulatorFinish(work.semanticGraph,
                                                work.semanticTypedFactAccumulator)
    CompilerCsgTypedFactTableTerminalRelease(work.typedIrRoundFacts)
    texpr.TypedExprIrReleasePayload(work.typedIr)
    CompilerCsgFnPtrFieldCallTableRelease(
        work.fnPtrFieldCalls)
    CompilerCsgExternFfiHandleContractTableRelease(
        work.externFfiHandleContracts)
    CompilerCsgExternFfiHandleCallCapabilityTableRelease(
        work.externFfiHandleCallCapabilities)
    var ownedTypeArena: typearena.TypedExprTypeArena
    ownedTypeArena = work.typeArena
    work.typeArena = nil
    typearena.TypedExprTypeArenaReleaseOwned(ownedTypeArena)
    CompilerCsgSemanticResolvedCallTableRelease(work.semanticGraph.resolvedCallTable)
    CompilerCsgNormalizedExprLayerTerminalRelease(work.activeSliceExprLayer)
    CompilerCsgTypedFactTableTerminalRelease(work.activeSliceTypedFacts)
    # Frontier rebuild owns work.exprLayer and may still hold a borrow/owner
    # tree when abort arrives before the fixed-point TerminalRelease. Drop it
    # after IR/slice leases and before the per-source owner in scratch.
    CompilerCsgNormalizedExprLayerTerminalRelease(work.exprLayer)
    CompilerCsgFrontierParsedSourceStoreRelease(
        work.frontierParsedSources)
    CompilerCsgBuildSourceScratchRelease(work)
    for sourceIndex in 0..<work.typedSourceTexts.len:
        texpr.TypedExprClearSourceTextAllFields(work.typedSourceTexts[sourceIndex])
    CompilerCsgReleaseFrontierTypedSourceTexts(work.frontierTypedSourceTexts,
                                               work.frontierTypedSourceTextIndex)
    CompilerCsgSourcePathIndexClear(work.sourceTextLookupIndex)
    CompilerCsgSourcePathIndexClear(work.sourceTextCacheIndex)
    CompilerCsgSourcePathIndexClear(work.typedSourceTextIndex)
    CompilerCsgSourcePathIndexClear(work.orderedSourceIndex)
    CompilerCsgReleaseImmutableSourceSnapshots(work.sourceSnapshots,
                                               work.sourceSnapshotIndex)
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8TCLOOP")
    for contextIndex in 0..<work.typedMetadataContexts.len:
        texpr.TypedExprClearSourceContextAllFields(work.typedMetadataContexts[contextIndex])
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8DONE")
    CompilerCsgReachableFunctionSetReleaseIndexes(work.reachableSet)
    if work.payloadMovedToOut:
        assert(work.nodes.len == 0 && work.edges.len == 0 &&
               parser.NormalizedExprLayerExprCount(work.exprLayer) == 0 &&
               work.typeArena == nil &&
               work.externFfiHandleContracts.producerSourceIds.len == 0 &&
               work.externFfiHandleCallCapabilities.arena.capacityBytes == 0 &&
               work.typedIr.functions2_functionNameIds.len == 0 &&
               work.semanticGraph.builderName == "" &&
               work.semanticGraph.sourceTable.sourcePaths.len == 0 &&
               work.semanticGraph.resolvedCallTable.internPool == nil,
               "compiler csg: output move left owned build payload")
    if work.buildFragmentLifetime.active:
        buildlife.CompilerCsgBuildFragmentLifetimeEnd(
            work.buildFragmentLifetime,
            outcome,
            buildFragmentLifetimeReceipt)
        if !buildlife.CompilerCsgBuildFragmentLifetimeReceiptClosed(
               buildFragmentLifetimeReceipt):
            panic("compiler csg: build fragment lifetime receipt not closed")
    if compilerCsgOrcd9TraceEnabled():
        os.WriteLine(os.Get_stderr(), "O8WS")
    work = CompilerCsgBuildWorkingSet()

fn CompilerCsgBuildWorkingSetRelease(work: var CompilerCsgBuildWorkingSet) =
    var buildFragmentLifetimeReceipt: buildlife.CompilerCsgBuildFragmentLifetimeReceipt
    CompilerCsgBuildWorkingSetReleaseWithOutcome(
        work,
        payloadlife.CompilerPayloadOutcomeDiagnostic,
        buildFragmentLifetimeReceipt)

fn CompilerCsgBuildAbort(work: var CompilerCsgBuildWorkingSet): bool =
    if !work.buildFragmentLifetime.active:
        CompilerCsgBuildWorkingSetRelease(work)
    return false

fn CompilerCsgBuildSnapshotAbort(work: var CompilerCsgBuildWorkingSet,
                                 err: var str,
                                 snapshotErr: str): bool =
    if snapshotErr != "":
        err = snapshotErr
    else:
        err = " compiler csg: immutable source snapshot failure"
    return CompilerCsgBuildAbort(work)

fn CompilerCsgLinkPlanOwnershipShapeValidInto(
        linkPlan: var slplan.SystemLinkPlanStub,
        err: var str): bool =
    if IsErr(linkPlan.sourceBundleCid) ||
       !layout.FixedBytes32Equal(Value(linkPlan.sourceBundleCid),
                                 linkPlan.sourceBundleCidValue):
        err = " compiler csg: link-plan source bundle result/scalar mismatch"
        return false
    if linkPlan.sourceClosurePaths.len <= 0 ||
       linkPlan.sourceBundleIdentityPaths.len !=
           linkPlan.sourceClosurePaths.len ||
       linkPlan.ownerModulePaths.len != linkPlan.sourceClosurePaths.len ||
       linkPlan.buildSourceUnitCount != linkPlan.sourceClosurePaths.len ||
       linkPlan.importEdgeCount != linkPlan.importEdges.len ||
       linkPlan.unresolvedImportCount < 0:
        err = Fmt" compiler csg: link-plan source identity shape invalid closure={linkPlan.sourceClosurePaths.len} identity={linkPlan.sourceBundleIdentityPaths.len} owners={linkPlan.ownerModulePaths.len} build_sources={linkPlan.buildSourceUnitCount} imports={linkPlan.importEdgeCount}/{linkPlan.importEdges.len} unresolved={linkPlan.unresolvedImportCount}"
        return false
    let entrySourceIndex = linkPlan.sourceBundleEntrySourceIndex
    if entrySourceIndex < 0 ||
       entrySourceIndex >= linkPlan.sourceClosurePaths.len ||
       linkPlan.entryPath != linkPlan.sourceClosurePaths[entrySourceIndex] ||
       linkPlan.buildEntryPath !=
           linkPlan.sourceClosurePaths[entrySourceIndex] ||
       linkPlan.moduleStem != linkPlan.ownerModulePaths[entrySourceIndex]:
        err = Fmt" compiler csg: link-plan entry identity invalid index={entrySourceIndex}"
        return false
    if layout.FixedBytes32Equal(linkPlan.sourceBundleBindingSeal,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(linkPlan.sourceBundleCidValue,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(linkPlan.sourceBundleEntrySourceCid,
                                layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(linkPlan.sourceBundleImportGraphCid,
                                layout.FixedBytes32()):
        err = " compiler csg: link-plan portable source identity contains zero cid"
        return false
    let dependencyReceipt = linkPlan.managedDependencyReceipt
    if slplan.SystemLinkPlanManagedDependencyReceiptPresent(
           dependencyReceipt) &&
       !slplan.SystemLinkPlanManagedDependencyReceiptVerifyInto(
            dependencyReceipt,
            err):
        return false
    err = ""
    return true

fn CompilerCsgPortableOverrideBindingValidateInto(
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceTexts: var str[],
        rebuiltImportEdges: var parser.ImportEdge[],
        err: var str): bool =
    if linkPlan.unresolvedImportCount != 0:
        err = " compiler csg: portable override binding requires resolved module-path identity"
        return false
    for sourceIndex in 0..<linkPlan.ownerModulePaths.len:
        if linkPlan.sourceBundleIdentityPaths[sourceIndex] !=
           linkPlan.ownerModulePaths[sourceIndex]:
            err = Fmt" compiler csg: portable override module identity mismatch index={sourceIndex}"
            return false
    let entrySourceIndex = linkPlan.sourceBundleEntrySourceIndex
    var binding: slplan.SystemLinkPlanPortableSourceBinding
    binding.packageId = linkPlan.packageId
    binding.entryModulePath = linkPlan.ownerModulePaths[entrySourceIndex]
    binding.sourceCount = linkPlan.ownerModulePaths.len
    binding.importEdgeCount = rebuiltImportEdges.len
    binding.sourceBundleCid = linkPlan.sourceBundleCidValue
    binding.entrySourceCid = linkPlan.sourceBundleEntrySourceCid
    binding.importGraphCid = linkPlan.sourceBundleImportGraphCid
    binding.bindingSeal =
        slplan.SystemLinkPlanPortableSourceBindingSeal(binding)
    if !slplan.SystemLinkPlanPortableSourceBindingValidateRebuiltTextsInto(
            binding,
            linkPlan.ownerModulePaths,
            sourceTexts,
            rebuiltImportEdges,
            err):
        return false
    err = ""
    return true

fn CompilerCsgLinkPlanOwnershipLeaseBegin(linkPlan: var slplan.SystemLinkPlanStub,
                                          portableSourceBindingValidated: bool,
                                          lease: var CompilerCsgLinkPlanOwnershipLease,
                                          err: var str): bool =
    if lease.active:
        err = " compiler csg: link-plan ownership lease already active"
        return false
    if linkPlan.exprLayer.sourceCount < 0 ||
       linkPlan.exprLayer.questionResidualCount < 0:
        err = " compiler csg: link-plan expr layer counters invalid"
        return false
    if !CompilerCsgLinkPlanOwnershipShapeValidInto(linkPlan, err):
        return false
    if !portableSourceBindingValidated &&
       !slplan.SystemLinkPlanSourceBundleBindingValidInto(linkPlan, err):
        if err == "":
            err = " compiler csg: link-plan source bundle binding invalid"
        return false
    lease.active = true
    lease.portableSourceBinding = portableSourceBindingValidated
    lease.sourceBundleBindingSeal = linkPlan.sourceBundleBindingSeal
    lease.externalPackageRootCount = linkPlan.externalPackageRoots.len
    lease.sourceClosureCount = linkPlan.sourceClosurePaths.len
    lease.sourceBundleIdentityCount = linkPlan.sourceBundleIdentityPaths.len
    lease.ownerModuleCount = linkPlan.ownerModulePaths.len
    lease.importEdgeCount = linkPlan.importEdges.len
    lease.runtimeTargetCount = linkPlan.runtimeTargets.len
    lease.exprCount = linkPlan.exprLayer.exprs.len
    lease.exprNextCount = linkPlan.exprLayer.exprNext.len
    lease.exprSourceCount = linkPlan.exprLayer.sourceCount
    lease.exprQuestionResidualCount = linkPlan.exprLayer.questionResidualCount
    lease.exprLookupSlotCount = linkPlan.exprLayer.exprLookup.slots.len
    lease.exprLookupBucketCount = linkPlan.exprLayer.exprLookup.buckets.len
    err = ""
    return true

fn CompilerCsgLinkPlanOwnershipLeaseCommit(
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceBundleOwner: var slplan.SystemLinkPlanSourceBundleOwner,
        lease: var CompilerCsgLinkPlanOwnershipLease) =
    assert(lease.active,
           "compiler csg: link-plan ownership lease commit without active lease")
    var sourceBindingValid = true
    if !lease.portableSourceBinding:
        sourceBindingValid =
            slplan.SystemLinkPlanSourceBundleBindingValid(linkPlan)
    assert(sourceBindingValid &&
           layout.FixedBytes32Equal(linkPlan.sourceBundleBindingSeal,
                                    lease.sourceBundleBindingSeal) &&
           linkPlan.externalPackageRoots.len == lease.externalPackageRootCount &&
           linkPlan.sourceClosurePaths.len == lease.sourceClosureCount &&
           linkPlan.sourceBundleIdentityPaths.len == lease.sourceBundleIdentityCount &&
           linkPlan.ownerModulePaths.len == lease.ownerModuleCount &&
           linkPlan.importEdges.len == lease.importEdgeCount &&
           linkPlan.runtimeTargets.len == lease.runtimeTargetCount &&
           linkPlan.exprLayer.exprs.len == lease.exprCount &&
           linkPlan.exprLayer.exprNext.len == lease.exprNextCount &&
           linkPlan.exprLayer.sourceCount == lease.exprSourceCount &&
           linkPlan.exprLayer.questionResidualCount == lease.exprQuestionResidualCount &&
           linkPlan.exprLayer.exprLookup.slots.len == lease.exprLookupSlotCount &&
           linkPlan.exprLayer.exprLookup.buckets.len == lease.exprLookupBucketCount,
           "compiler csg: consumed link-plan changed before ownership commit")
    var sourceBundleMoveErr: str
    if !slplan.SystemLinkPlanSourceBundleOwnerMoveFromPlanInto(
           linkPlan,
           sourceBundleOwner,
           sourceBundleMoveErr):
        panic(sourceBundleMoveErr)
    var compilerInputReleaseReceipt: slplan.SystemLinkPlanCompilerInputReleaseReceipt
    slplan.SystemLinkPlanCompilerResidualReleaseAfterSourceBundleMoveWithReceipt(
        linkPlan,
        sourceBundleOwner,
        compilerInputReleaseReceipt)
    var compilerInputReleaseErr: str
    if !slplan.SystemLinkPlanCompilerInputReleaseReceiptConsumeStrictInto(
           linkPlan,
           compilerInputReleaseReceipt,
           compilerInputReleaseErr):
        panic(compilerInputReleaseErr)
    lease.active = false

@borrows
fn compilerCsgBuildBindingSourceTextsRec(
        work: var CompilerCsgBuildWorkingSet,
        linkPlan: var slplan.SystemLinkPlanStub,
        bindingSourceTexts: var str[],
        sourceIndex: int32,
        err: var str): bool =
    while true:
        if sourceIndex >= linkPlan.sourceClosurePaths.len:
            return true
        var bindingSourceText: str
        if !CompilerCsgReadSourceTextCached(
                work.sourceTextCache,
                work.sourceTextCacheIndex,
                work.sourceTextLookup,
                work.sourceTextLookupIndex,
                linkPlan.sourceClosurePaths[sourceIndex],
                bindingSourceText,
                err):
            if err == "":
                err = Fmt" compiler csg: sealed import graph source unavailable index={sourceIndex}"
            return false
        add(bindingSourceTexts, bindingSourceText)
        sourceIndex = sourceIndex + 1
        continue

@borrows
fn compilerCsgBuildBindingImportEdgesEqualRec(
        rebuiltBindingImportEdges: parser.ImportEdge[],
        linkPlan: slplan.SystemLinkPlanStub,
        edgeIndex: int32,
        err: var str): bool =
    while true:
        if edgeIndex >= rebuiltBindingImportEdges.len:
            return true
        if !slplan.SystemLinkPlanImportEdgeEqual(
                rebuiltBindingImportEdges[edgeIndex],
                linkPlan.importEdges[edgeIndex]):
            err = Fmt" compiler csg: sealed import graph source provenance mismatch index={edgeIndex}"
            return false
        edgeIndex = edgeIndex + 1
        continue

@borrows
fn compilerCsgBuildCanonicalImportEdgesRec(
        linkPlan: var slplan.SystemLinkPlanStub,
        linkPlanImportTargetIndex: var CompilerCsgSourcePathIndex,
        canonicalImportEdges: var parser.ImportEdge[],
        edgeIndex: int32,
        err: var str): bool =
    while true:
        if edgeIndex >= linkPlan.importEdges.len:
            return true
        var edge = slplan.SystemLinkPlanCloneImportEdgeAt(
            linkPlan.importEdges, edgeIndex)
        if !edge.resolved:
            err = Fmt" compiler csg: unresolved link-plan import edge owner_module={edge.ownerModulePath} target_module={edge.targetModulePath} target_source={edge.targetSourcePath} edge_index={edgeIndex}"
            return false
        if edge.ownerModulePath == "" || edge.targetModulePath == "" || edge.targetSourcePath == "":
            err = Fmt" compiler csg: link-plan import edge identity missing owner_module={edge.ownerModulePath} target_module={edge.targetModulePath} target_source={edge.targetSourcePath} edge_index={edgeIndex}"
            return false
        var targetSourcePath: str
        if !CompilerCsgSourcePathIndexCanonicalKey(linkPlanImportTargetIndex,
                                                    edge.targetSourcePath,
                                                    targetSourcePath,
                                                    err):
            return false
        var existingEdgeIndex: int32
        if !CompilerCsgSourcePathIndexFind(linkPlanImportTargetIndex,
                                           targetSourcePath,
                                           existingEdgeIndex,
                                           err):
            return false
        if existingEdgeIndex >= 0:
            if existingEdgeIndex >= canonicalImportEdges.len ||
               canonicalImportEdges[existingEdgeIndex].targetModulePath != edge.targetModulePath:
                err = Fmt" compiler csg: link-plan import target identity conflict target_source={targetSourcePath} first_edge={existingEdgeIndex} next_edge={edgeIndex}"
                return false
        elif !CompilerCsgSourcePathIndexRegister(linkPlanImportTargetIndex,
                                                 targetSourcePath,
                                                 edgeIndex,
                                                 err):
            return false
        edge.targetSourcePath = strings.CloneStr(targetSourcePath)
        add(canonicalImportEdges, share(edge))
        edgeIndex = edgeIndex + 1
        continue

@borrows
fn compilerCsgBuildCollectOwnerModulesRec(
        work: var CompilerCsgBuildWorkingSet,
        linkPlan: slplan.SystemLinkPlanStub,
        i: int32) =
    while true:
        if i >= linkPlan.ownerModulePaths.len:
            return
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        CompilerCsgAddUniqueFast(work.modules, work.moduleSeen,
                                 linkPlan.ownerModulePaths[i])
        i = i + 1

@borrows
fn compilerCsgBuildCollectImportEdgeModulesRec(
        work: var CompilerCsgBuildWorkingSet,
        canonicalImportEdges: parser.ImportEdge[],
        i: int32) =
    while true:
        if i >= canonicalImportEdges.len:
            return
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        CompilerCsgAddUniqueFast(work.modules, work.moduleSeen,
                                 canonicalImportEdges[i].ownerModulePath)
        if canonicalImportEdges[i].resolved:
            CompilerCsgAddUniqueFast(work.modules, work.moduleSeen,
                                     canonicalImportEdges[i].targetModulePath)
            CompilerCsgAddUniqueImportPairFast(work.importPairs,
                                                work.importPairSeen,
                                                canonicalImportEdges[i].ownerModulePath,
                                                canonicalImportEdges[i].targetModulePath)
        i = i + 1

@borrows
fn compilerCsgBuildCollectClosureModulesRec(
        work: var CompilerCsgBuildWorkingSet,
        linkPlan: slplan.SystemLinkPlanStub,
        i: int32) =
    while true:
        if i >= linkPlan.sourceClosurePaths.len:
            return
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        CompilerCsgAddUniqueFast(work.modules, work.moduleSeen,
                                 linkPlan.ownerModulePaths[i])
        i = i + 1

@borrows
fn compilerCsgBuildCollectModulesRec(
        work: var CompilerCsgBuildWorkingSet,
        linkPlan: slplan.SystemLinkPlanStub,
        canonicalImportEdges: parser.ImportEdge[],
        ownerI: int32,
        importI: int32,
        closureI: int32,
        err: var str): bool =
    compilerCsgBuildCollectOwnerModulesRec(work, linkPlan, ownerI)
    compilerCsgBuildCollectImportEdgeModulesRec(
        work, canonicalImportEdges, importI)
    compilerCsgBuildCollectClosureModulesRec(work, linkPlan, closureI)
    return true

@borrows
fn compilerCsgBuildModuleNodesRec(
        work: var CompilerCsgBuildWorkingSet,
        packageNodeId: int32,
        i: int32) =
    while true:
        if i >= work.modules.len:
            return
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        var moduleNode: CompilerCsgNode
        moduleNode.nodeId = work.nodes.len + 1
        moduleNode.nodeKind = CompilerCsgNodeKindModule
        moduleNode.ownerNodeId = packageNodeId
        let ownedModulePath = parser.ParserOwnedText(work.modules[i])
        moduleNode.modulePath = share(ownedModulePath)
        moduleNode.symbolText = ""
        moduleNode.factText = ownedModulePath
        moduleNode.resultLayoutKind = 0
        moduleNode.effectKind = 0
        moduleNode.capabilityKind = 0
        moduleNode.callConv = 0
        moduleNode.entryFlag = 0
        moduleNode.exportedFlag = 0
        moduleNode.exportSymbolName = ""
        let moduleFactCid = CompilerCsgHashNodeRecord(moduleNode)
        moduleNode.factCid = moduleFactCid
        let moduleNodeId = moduleNode.nodeId
        add(work.nodes, moduleNode)
        add(work.moduleNodeIds, moduleNodeId)
        CompilerCsgAddEdge(work.edges, packageNodeId, moduleNodeId,
                           CompilerCsgEdgeKindContains)
        i = i + 1

@borrows
fn compilerCsgBuildImportPairEdgesRec(
        work: var CompilerCsgBuildWorkingSet,
        i: int32,
        err: var str): bool =
    while true:
        if i >= work.importPairs.len:
            return true
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        let pair = work.importPairs[i]
        let fromNodeId = CompilerCsgModuleNodeIdIndexed(work.modules,
                                                        work.moduleNodeIds,
                                                        pair.ownerModulePath)
        let toNodeId = CompilerCsgModuleNodeIdIndexed(work.modules,
                                                      work.moduleNodeIds,
                                                      pair.targetModulePath)
        if fromNodeId <= 0:
            err = Fmt" compiler csg: import pair owner node missing owner_module={pair.ownerModulePath} target_module={pair.targetModulePath} pair_index={i}"
            return false
        if toNodeId <= 0:
            err = Fmt" compiler csg: import pair target node missing owner_module={pair.ownerModulePath} target_module={pair.targetModulePath} pair_index={i}"
            return false
        CompilerCsgAddEdge(work.edges, fromNodeId, toNodeId,
                           CompilerCsgEdgeKindImports)
        i = i + 1

@borrows
fn compilerCsgBuildOrderedSourcesRec(
        work: var CompilerCsgBuildWorkingSet,
        linkPlan: slplan.SystemLinkPlanStub,
        i: int32,
        err: var str): bool =
    while true:
        if i >= linkPlan.sourceClosurePaths.len:
            return true
        if i % 64 == 0:
            os.ProcessResourceGuardCheck()
        if !CompilerCsgAddUniqueSourceModulePair(work.orderedSources,
                                                 work.orderedSourceModules,
                                                 work.orderedSourceIndex,
                                                 linkPlan.sourceClosurePaths[i],
                                                 linkPlan.ownerModulePaths[i],
                                                 err):
            return false
        i = i + 1

@borrows
fn compilerCsgBuildRegisterOrderedSourcesRec(
        work: var CompilerCsgBuildWorkingSet,
        orderedSourceIndex: int32,
        err: var str): bool =
    while true:
        if orderedSourceIndex >= work.orderedSources.len:
            return true
        if !CompilerCsgSourcePathIndexRegister(work.orderedSourceIndex,
                                               work.orderedSources[orderedSourceIndex],
                                               orderedSourceIndex,
                                               err):
            return false
        orderedSourceIndex = orderedSourceIndex + 1

@borrows
fn compilerCsgBuildOrderedSourceProfilesRec(
        work: var CompilerCsgBuildWorkingSet,
        linkPlan: var slplan.SystemLinkPlanStub,
        packageNodeId: int32,
        sourceIndex: int32,
        requirePortableReceipt: bool,
        migrationSourceSyntax: bool,
        stableWorkspaceRoot: str,
        stablePackageRoot: str,
        stableEntryPath: str,
        sourceTextCapturedBytes: var int64,
        err: var str): bool =
    while true:
        if sourceIndex >= work.orderedSources.len:
            return true
        CompilerCsgBuildSourceScratchRelease(work)
        if sourceIndex % 16 == 0:
            os.ProcessResourceGuardCheck()
        let sourcePath = work.orderedSources[sourceIndex]
        let ownerModulePath = work.orderedSourceModules[sourceIndex]
        var ownerModuleNodeId = CompilerCsgModuleNodeIdIndexed(work.modules,
                                                               work.moduleNodeIds,
                                                               ownerModulePath)
        if ownerModuleNodeId <= 0:
            ownerModuleNodeId = CompilerCsgEnsureModuleNode(work.nodes,
                                                           work.edges,
                                                           packageNodeId,
                                                           ownerModulePath)
        if ownerModuleNodeId <= 0:
            err = Fmt" compiler csg: ordered source owner module/node unresolved source={sourcePath} module={ownerModulePath}"
            return false
        work.activeText = ""
        var textFromOverride: bool
        if !CompilerCsgSourceTextSnapshotLookup(work.sourceTextLookup,
                                                work.sourceTextLookupIndex,
                                                work.sourceTextCache,
                                                work.sourceTextCacheIndex,
                                                sourcePath,
                                                work.activeText,
                                                textFromOverride,
                                                err):
            if err != "":
                return false
            err = Fmt" compiler csg: immutable source snapshot missing after capture source={sourcePath}"
            return false
        if !CompilerCsgCaptureImmutableSourceSnapshot(work.sourceSnapshots,
                                                       work.sourceSnapshotIndex,
                                                       sourcePath,
                                                       ownerModulePath,
                                                       work.activeText,
                                                       err):
            return false
        # Typed source texts must borrow the immutable snapshot copy, not the
        # short-lived source-text-cache copy. The cache/lookup entries are
        # released after this loop, so borrowing the cache text would keep a
        # second full copy of every source alive through metadata/typed IR.
        var snapshotText: str
        if !CompilerCsgImmutableSourceSnapshotText(work.sourceSnapshots,
                                                   work.sourceSnapshotIndex,
                                                   sourcePath,
                                                   snapshotText,
                                                   err):
            return false
        sourceTextCapturedBytes = sourceTextCapturedBytes + CompilerCsgSourceTextPayloadLiveBytes(sourcePath,
                                                                                                  ownerModulePath,
                                                                                                  work.activeText)
        var profileErr = ""
        var profileBuilt: bool
        if requirePortableReceipt:
            profileBuilt = parser.ParserBuildExprCallProfileExactInto(
                stableWorkspaceRoot,
                stablePackageRoot,
                linkPlan.packageId,
                work.externalPackageRoots,
                sourcePath,
                ownerModulePath,
                work.activeText,
                linkPlan.sourceClosurePaths,
                linkPlan.ownerModulePaths,
                linkPlan.importEdges,
                migrationSourceSyntax,
                work.activeProfile,
                profileErr)
        else:
            profileBuilt =
                parser.ParserBuildExprCallProfileWithExternalPackageRoots(
                    stableWorkspaceRoot,
                    stablePackageRoot,
                    work.externalPackageRoots,
                    sourcePath,
                    work.activeText,
                    work.activeProfile,
                    profileErr)
        if !profileBuilt:
            if profileErr != "":
                err = parser.ParserConcat4(" compiler csg: normalized decl read failed: ",
                                           sourcePath,
                                           ": ",
                                           profileErr)
            else:
                err = parser.ParserConcat3(" compiler csg: normalized decl read failed: ",
                                           sourcePath,
                                           ": empty diagnostic")
            return false
        work.activeProfile.migrationSourceSyntax = migrationSourceSyntax
        let activeDeclImportcMask = CompilerCsgDeclImportcMask(
            work.activeProfile.decls)
        work.activeDeclImportcMask = activeDeclImportcMask
        if linkPlan.emitKind == creq.EmitExe &&
           sourcePath == stableEntryPath &&
           work.activeProfile.decls.len <= 0:
            err = Fmt" compiler csg: entry declaration profile empty: {sourcePath} text_len={work.activeText.len} profile_line_count={work.activeProfile.lines.len} repair_line_count={work.activeProfile.lines.len} text_from_override={textFromOverride}"
            return false
        let importcCallNames = CompilerCsgDeclNamesFromDeclsWithMask(
            work.activeProfile.decls,
            work.activeDeclImportcMask,
            1)
        work.activeProfile.importcCallNames = importcCallNames
        let localCallNames = CompilerCsgDeclNamesFromDeclsWithMask(
            work.activeProfile.decls,
            work.activeDeclImportcMask,
            0)
        work.activeProfile.localCallNames = localCallNames
        work.activeProfile.text = ""
        work.activeTypedSourceText = ""
        work.activeTypedSourceText = snapshotText
        var typedSource = texpr.TypedExprSourceTextBorrowPackageFacts(stableWorkspaceRoot,
                                                                      stablePackageRoot,
                                                                      linkPlan.packageId,
                                                                      "",
                                                                      work.externalPackageRoots,
                                                                      sourcePath,
                                                                      work.activeTypedSourceText)
        typedSource.snapshotOnly = true
        typedSource.migrationSourceSyntax = migrationSourceSyntax
        add(work.typedSourceTexts, typedSource)
        let activeProfileLineCount = work.activeProfile.lines.len
        CompilerCsgProfileAppendMove(work.exprCallProfiles, share(work.activeProfile))
        work.activeProfile = parser.NormalizedExprCallProfile()
        # PhaseArena CSG 文本族半片: 行文本进 intern 池, 行号→InternId 列进
        # lineStore, 原 ORC 行表当场释放 (②: 相位临时文本不再持有 ORC 行表)。
        CompilerCsgProfileLinesInternIntoArena(work,
                                               work.exprCallProfiles.len - 1)
        add(work.profileLineCounts, activeProfileLineCount)
        add(work.profileImportcMasks, share(work.activeDeclImportcMask))
        CompilerCsgBuildSourceScratchRelease(work)
        sourceIndex = sourceIndex + 1

fn CompilerCsgLineTextRefCountsBuild(work: var CompilerCsgBuildWorkingSet,
                                     counts: var int32[]) =
    let textCount = langintern.InternPoolCount(work.lineInternPool)
    seqs.setLen(counts, textCount)
    for profileIndex in 0..<work.profileLineIdCounts.len:
        let lineCount = work.profileLineIdCounts[profileIndex]
        if lineCount <= 0:
            continue
        let column = work.profileLineIdColumns[profileIndex]
        for li in 0..<lineCount:
            let internId = phase.PhaseArenaStoreI32ColumnGet(work.lineStore,
                                                             work.lineArena,
                                                             column,
                                                             li)
            if internId >= 0 && internId < textCount:
                counts[internId] = counts[internId] + 1

fn CompilerCsgProfileLineTextsRelease(work: var CompilerCsgBuildWorkingSet,
                                      counts: var int32[],
                                      profileIndex: int32) =
    if !work.lineInternPoolActive:
        return
    if profileIndex < 0 || profileIndex >= work.profileLineIdCounts.len:
        return
    let lineCount = work.profileLineIdCounts[profileIndex]
    if lineCount <= 0:
        return
    let column = work.profileLineIdColumns[profileIndex]
    for li in 0..<lineCount:
        let internId = phase.PhaseArenaStoreI32ColumnGet(work.lineStore,
                                                         work.lineArena,
                                                         column,
                                                         li)
        if internId < 0 || internId >= counts.len:
            continue
        counts[internId] = counts[internId] - 1
        if counts[internId] <= 0:
            langintern.InternPoolClearTextAt(work.lineInternPool, internId)

fn compilerCsgBuildMetadataContextsRec(
        work: var CompilerCsgBuildWorkingSet,
        metadataProfileIndex: int32,
        lineTextRefCounts: var int32[],
        err: var str): bool =
    while true:
        if metadataProfileIndex >= work.exprCallProfiles.len:
            if compilerCsgT4TimeTrace:
                compilerCsgT4MetaTotalsEmit()
            return true
        var t4MarkNs: int64 = 0
        if compilerCsgT4TimeTrace:
            t4MarkNs = compilerCsgT4NowNs()
        CompilerCsgBuildSourceScratchRelease(work)
        if compilerCsgT4TimeTrace:
            compilerCsgT4MetaScratchNs = compilerCsgT4MetaScratchNs + (compilerCsgT4NowNs() - t4MarkNs)
            t4MarkNs = compilerCsgT4NowNs()
        if metadataProfileIndex % 16 == 0:
            os.ProcessResourceGuardCheck()
        var metadataErr = ""
        if metadataProfileIndex >= work.typedSourceTexts.len ||
           work.typedSourceTexts[metadataProfileIndex].sourcePath !=
               work.exprCallProfiles[metadataProfileIndex].sourcePath:
            err = Fmt" compiler csg: typed metadata source snapshot order mismatch index={metadataProfileIndex} profiles={work.exprCallProfiles.len} snapshots={work.typedSourceTexts.len}"
            return false
        # PhaseArena CSG 文本族半片: profile 行表已 intern 进 lineStore, 消费
        # 前按既有物化范式取回 (共享+retain), 本 profile 用完即平衡释放。
        var metadataLines = CompilerCsgProfileLineSeqFromArena(
            work.lineStore,
            work.lineArena,
            work.lineInternPool,
            work.profileLineIdColumns,
            work.profileLineIdCounts,
            metadataProfileIndex)
        if metadataLines.len <= 0:
            metadataLines = CompilerCsgCloneBorrowedStrSeq(
                work.exprCallProfiles[metadataProfileIndex].lines)
        let sharedMetadataLines = share(metadataLines)
        work.exprCallProfiles[metadataProfileIndex].lines =
            sharedMetadataLines
        if compilerCsgT4TimeTrace:
            compilerCsgT4MetaLinesNs = compilerCsgT4MetaLinesNs + (compilerCsgT4NowNs() - t4MarkNs)
            t4MarkNs = compilerCsgT4NowNs()
        let metadataContextBuilt =
            texpr.TypedExprBuildMetadataContextFromProfile(work.exprCallProfiles[metadataProfileIndex],
                                                           work.typedSourceTexts[metadataProfileIndex],
                                                           work.activeMetadataContext,
                                                           metadataErr)
        if compilerCsgOrcd9TraceEnabled():
            os.WriteLine(os.Get_stderr(), "LSDANCE-PRE")
        work.exprCallProfiles[metadataProfileIndex].lines = []
        seqs.freeSeqStrRelease(metadataLines)
        if compilerCsgOrcd9TraceEnabled():
            os.WriteLine(os.Get_stderr(), "LSDANCE-POST")
        if compilerCsgT4TimeTrace:
            compilerCsgT4MetaBuildNs = compilerCsgT4MetaBuildNs + (compilerCsgT4NowNs() - t4MarkNs)
            t4MarkNs = compilerCsgT4NowNs()
        # [REGRESSION-FIX] 不做逐 internId 文本清空: metadata 之后
        # CompilerCsgBuildReachableFunctionSet / parser receipt 仍经
        # LookupIntern 读取行文本, 提前清空会导致
        # `compiler parser receipt: function source span invalid`.
        # 行池文本统一由 B2 相位末 lineStore/pool reset 释放.
        if compilerCsgT4TimeTrace:
            t4MarkNs = compilerCsgT4NowNs()
        let _metadataSourceRelief = os.ProcessMemoryPressureRelief()
        if compilerCsgT4TimeTrace:
            compilerCsgT4MetaReliefNs = compilerCsgT4MetaReliefNs + (compilerCsgT4NowNs() - t4MarkNs)
            compilerCsgT4MetaReliefCalls = compilerCsgT4MetaReliefCalls + Int64(1)
            t4MarkNs = compilerCsgT4NowNs()
        if !metadataContextBuilt:
            if metadataErr != "":
                err = parser.ParserConcat4(" compiler csg: typed metadata context failed after import resolution: ",
                                           work.exprCallProfiles[metadataProfileIndex].sourcePath,
                                           ": ",
                                           metadataErr)
            else:
                err = parser.ParserConcat3(" compiler csg: typed metadata context failed after import resolution: ",
                                           work.exprCallProfiles[metadataProfileIndex].sourcePath,
                                           ": empty diagnostic")
            return false
        work.activeMetadataContext.snapshotOnly = true
        texpr.TypedExprClearMetadataContextScopeSourcePaths(work.activeMetadataContext)
        var preMoveSharedColumnId: int32
        var preMoveSharedColumnName: str
        var preMoveSharedRefCount: int32
        if texpr.TypedExprSourceContextSharedMetadataBufferInto(
               work.activeMetadataContext,
               preMoveSharedColumnId,
               preMoveSharedColumnName,
               preMoveSharedRefCount):
            err = Fmt" compiler csg: metadata context storage shared before append move source={metadataProfileIndex} column_id={preMoveSharedColumnId} column={preMoveSharedColumnName} ref_count={preMoveSharedRefCount}"
            return false
        var movedMetadataContext: texpr.TypedExprSourceContext
        texpr.TypedExprSourceContextMoveInto(
            movedMetadataContext, work.activeMetadataContext)
        var sharedMetadataColumnId: int32
        var sharedMetadataColumnName: str
        var sharedMetadataRefCount: int32
        if texpr.TypedExprSourceContextSharedMetadataBufferInto(
               movedMetadataContext,
               sharedMetadataColumnId,
               sharedMetadataColumnName,
               sharedMetadataRefCount):
            var sourceSharedColumnId: int32
            var sourceSharedColumnName: str
            var sourceSharedRefCount: int32
            let sourceStillShared =
                texpr.TypedExprSourceContextSharedMetadataBufferInto(
                    work.activeMetadataContext,
                    sourceSharedColumnId,
                    sourceSharedColumnName,
                    sourceSharedRefCount)
            err = Fmt" compiler csg: metadata context storage shared after profile build source={metadataProfileIndex} column_id={sharedMetadataColumnId} column={sharedMetadataColumnName} ref_count={sharedMetadataRefCount} move_source_shared={sourceStillShared ? 1 : 0} move_source_column_id={sourceSharedColumnId} move_source_column={sourceSharedColumnName} move_source_ref_count={sourceSharedRefCount} move_source_line_starts={work.activeMetadataContext.sourceLineByteStarts.len}"
            return false
        if compilerCsgT4TimeTrace:
            compilerCsgT4MetaAppendNs = compilerCsgT4MetaAppendNs + (compilerCsgT4NowNs() - t4MarkNs)
            t4MarkNs = compilerCsgT4NowNs()
        texpr.TypedExprSourceContextAppendMove(
            work.typedMetadataContexts, movedMetadataContext)
        CompilerCsgProfileLineTextsRelease(work,
                                           lineTextRefCounts,
                                           metadataProfileIndex)
        if compilerCsgT4TimeTrace:
            compilerCsgT4MetaReleaseNs = compilerCsgT4MetaReleaseNs + (compilerCsgT4NowNs() - t4MarkNs)
            compilerCsgT4MetaSources = compilerCsgT4MetaSources + Int64(1)
        metadataProfileIndex = metadataProfileIndex + 1

fn compilerCsgBuildSourceFunctionIndexListRec(
        sourceFunctionIndexes: var int32[],
        sourceFunctionIndex: int32,
        sourceFunctionEnd: int32) =
    while true:
        if sourceFunctionIndex >= sourceFunctionEnd:
            return
        add(sourceFunctionIndexes, sourceFunctionIndex)
        sourceFunctionIndex = sourceFunctionIndex + 1

fn compilerCsgBuildEntryExportScanRec(
        work: var CompilerCsgBuildWorkingSet,
        sourceIndex: int32,
        scanIndex: int32,
        entryHasExplicitExports: var bool) =
    while true:
        if scanIndex >= work.exprCallProfiles[sourceIndex].decls.len:
            return
        if scanIndex % 256 == 0:
            os.ProcessResourceGuardCheck()
        if work.exprCallProfiles[sourceIndex].decls[scanIndex].explicitExportName.len > 0:
            entryHasExplicitExports = true
            return
        scanIndex = scanIndex + 1

@borrows
fn compilerCsgBuildExactFunctionSlicesRec(
        work: var CompilerCsgBuildWorkingSet,
        sourcePath: str,
        sourceIndex: int32,
        functionIndex: int32,
        sourceFunctionEnd: int32,
        previousExactFunctionEndLine: var int32,
        exactExprLineStarts: var int32[],
        exactExprRowIndexes: var int32[],
        exactExprRowDomains: var int32[],
        exactStructuredFacts: var parser.ParserStructuredSourceFacts,
        exactStructuredSlice: var parser.ParserStructuredSourceSlice,
        sourceExprTotal: var int32,
        sourceSliceCount: var int32,
        sourceSummaryCounted: var bool,
        typedContextLookup: var parser.ParserSourcePathIndexLookup,
        typedSourceIdentityIndex: var texpr.TypedExprSourceIdentityIndex,
        typedIrExprCountCursor: var int32,
        compilerCsgDebugStderr: bool,
        err: var str): bool =
    while true:
        if functionIndex >= sourceFunctionEnd:
            return true
        var exactStructuredErr: str
        # [c1-line] Per-slice clock: shell segments here, consume core inside
        # CompilerCsgConsumeExprSliceIntoTypedFacts above.
        var c1SliceBeginNs: int64 = 0
        var c1SliceSegNs: int64 = 0
        if compilerCsgDeclTimeEnabled:
            c1SliceBeginNs = compilerCsgT4NowNs()
        if functionIndex % 256 == 0:
            os.ProcessResourceGuardCheck()
        if functionIndex >= work.reachableSet.sourcePaths.len ||
           functionIndex >= work.reachableSet.startLines.len ||
           functionIndex >= work.reachableSet.endLines.len ||
           functionIndex >= work.reachableSet.reachable.len:
            err = Fmt" compiler csg: exact function row missing source={sourcePath} function_index={functionIndex}"
            return false
        let lineStart = work.reachableSet.startLines[functionIndex]
        let lineEnd = work.reachableSet.endLines[functionIndex]
        if lineStart <= 0 || lineEnd < lineStart ||
           lineStart <= previousExactFunctionEndLine:
            err = Fmt" compiler csg: function slice missing start line source={sourcePath} function={work.reachableSet.functionNames[functionIndex]}"
            return false
        previousExactFunctionEndLine = lineEnd
        let exactExprDomain =
            if work.reachableSet.active &&
               !work.reachableSet.reachable[functionIndex]:
                CompilerCsgExactExprDomainUnreachableFunction
            else:
                CompilerCsgExactExprDomainReachableFunction
        if !CompilerCsgExactExprRowsMarkFunctionDomain(
                exactExprLineStarts,
                exactExprRowIndexes,
                lineStart,
                lineEnd,
                exactExprDomain,
                exactExprRowDomains,
                err):
            return false
        if compilerCsgDeclTimeEnabled:
            c1SliceSegNs = compilerCsgT4NowNs()
            compilerCsgDeclTimeMarkNs = compilerCsgDeclTimeMarkNs + (c1SliceSegNs - c1SliceBeginNs)
        if exactExprDomain ==
               CompilerCsgExactExprDomainUnreachableFunction:
            if compilerCsgDeclTimeEnabled:
                compilerCsgDeclTimeSliceNs = compilerCsgDeclTimeSliceNs + (c1SliceSegNs - c1SliceBeginNs)
            functionIndex = functionIndex + 1
            continue
        CompilerCsgDebugSliceMemory(compilerCsgDebugStderr,
                                    "before_expr_layer",
                                    sourcePath,
                                    functionIndex,
                                    0)
        # Per-function layer reset (same discipline as the
        # frontier path): the append below hard-fails when the
        # layer still carries the previous function's
        # structured headers.
        CompilerCsgTraceStage("r92_t8_post_markdomain")
        parser.NormalizedExprLayerReset(
            work.activeFunctionExprLayer)
        work.compactProfileViewLifecycle.rangeBorrowCount =
            work.compactProfileViewLifecycle.rangeBorrowCount +
                Int64(1)
        if !CompilerCsgExactFunctionExprLayerBorrow(
                work.activeExprLayer,
                exactExprLineStarts,
                exactExprRowIndexes,
                lineStart,
                lineEnd,
                work.activeFunctionExprLayer,
                err):
            return false
        if compilerCsgDeclTimeEnabled:
            let c1Now = compilerCsgT4NowNs()
            compilerCsgDeclTimeBorrowNs = compilerCsgDeclTimeBorrowNs + (c1Now - c1SliceSegNs)
            c1SliceSegNs = c1Now
        CompilerCsgTraceStage("r92_t9_post_layer_borrow")
        if !parser.ParserStructuredSourceFactsSliceBuildFromLayer(
                exactStructuredFacts,
                work.activeExprLayer,
                lineStart,
                lineEnd,
                exactStructuredSlice,
                exactStructuredErr) ||
           !parser.ParserStructuredSourceSliceRemapExistingLayer(
                exactStructuredSlice,
                work.activeFunctionExprLayer,
                exactStructuredErr):
            err = Fmt" compiler csg: exact function structured slice failed source={sourcePath} function={work.reachableSet.functionNames[functionIndex]}: {exactStructuredErr}"
            return false
        CompilerCsgDebugSliceMemory(compilerCsgDebugStderr,
                                    "after_expr_layer",
                                    sourcePath,
                                    functionIndex,
                                    work.activeFunctionExprLayer.exprs.len)
        # Per-function reset: the exact structured slice is
        # consumed into the layer above; rebuilding it for the
        # next function without a reset hard-fails as
        # "already built" (frontier path releases per function
        # the same way).
        parser.ParserStructuredSourceSliceReset(
            exactStructuredSlice)
        if compilerCsgDeclTimeEnabled:
            let c1Now = compilerCsgT4NowNs()
            compilerCsgDeclTimeStructNs = compilerCsgDeclTimeStructNs + (c1Now - c1SliceSegNs)
            c1SliceSegNs = c1Now
        CompilerCsgTraceStage("r92_ta_post_structured_slice")
        var parserReceiptIdentity: parser_receipt.ParserNormalizedExprFunctionIdentity
        if !CompilerCsgParserReceiptFunctionIdentity(
                work.reachableSet,
                work.orderedSources,
                work.orderedSourceModules,
                functionIndex,
                parserReceiptIdentity,
                err):
            return false
        var parserReceiptIdentities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
        add(parserReceiptIdentities, parserReceiptIdentity)
        if !CompilerCsgParserReceiptObserveAndVerify(
                work.parserNormalizedExprReceiptAccumulator,
                work.activeFunctionExprLayer,
                parserReceiptIdentities,
                err):
            return false
        if compilerCsgDeclTimeEnabled:
            let c1Now = compilerCsgT4NowNs()
            compilerCsgDeclTimeReceiptNs = compilerCsgDeclTimeReceiptNs + (c1Now - c1SliceSegNs)
            c1SliceSegNs = c1Now
        sourceExprTotal = sourceExprTotal +
            work.activeFunctionExprLayer.exprs.len
        sourceSliceCount = sourceSliceCount + 1
        CompilerCsgTraceStage("r92_tb_post_observe_verify")
        if !CompilerCsgConsumeExprSliceIntoTypedFacts(work.semanticGraph,
                                                      work.semanticTypedFactAccumulator,
                                                      work.orderedSourceIndex,
                                                      work.typedSourceTexts,
                                                      sourceIndex,
                                                      functionIndex,
                                                      work.typedMetadataContexts,
                                                      typedSourceIdentityIndex,
                                                      typedContextLookup,
                                                      work.activeFactsContext,
                                                      sourcePath,
                                                      work.reachableSet,
                                                      work.activeFunctionExprLayer,
                                                      work.activeSliceTypedFacts,
                                                      typedIrExprCountCursor,
                                                      sourceSummaryCounted,
                                                      err):
            return false
        if compilerCsgDeclTimeEnabled:
            let c1SliceEnd = compilerCsgT4NowNs()
            compilerCsgDeclTimeSliceNs = compilerCsgDeclTimeSliceNs + (c1SliceEnd - c1SliceBeginNs)
            compilerCsgDeclTimeSlices = compilerCsgDeclTimeSlices + 1
            if c1SliceEnd - c1SliceBeginNs > compilerCsgDeclTimeHeaviestNs:
                compilerCsgDeclTimeHeaviestNs = c1SliceEnd - c1SliceBeginNs
                compilerCsgDeclTimeHeaviestLine = lineStart
        CompilerCsgDebugSliceMemory(compilerCsgDebugStderr,
                                    "after_typed_facts",
                                    sourcePath,
                                    functionIndex,
                                    0)
        CompilerCsgTraceStage("r92_tc_post_consume")
        functionIndex = functionIndex + 1

@borrows
fn compilerCsgBuildProfileDeclSymbolsRec(
        work: var CompilerCsgBuildWorkingSet,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceIndex: int32,
        declIndex: int32,
        sourcePath: str,
        ownerModulePath: str,
        ownerModuleNodeId: int32,
        entrySourceFlag: bool,
        entryHasExplicitExports: bool,
        stableEntryPath: str,
        err: var str): bool =
    while true:
        if declIndex >= work.exprCallProfiles[sourceIndex].decls.len:
            return true
        if declIndex % 64 == 0:
            os.ProcessResourceGuardCheck()
        if work.exprCallProfiles[sourceIndex].decls[declIndex].importc:
            declIndex = declIndex + 1
            continue
        let functionName =
            work.exprCallProfiles[sourceIndex].decls[declIndex].name
        let declarationLineIndex =
            work.exprCallProfiles[sourceIndex].decls[declIndex].lineIndex
        let functionIndex =
            CompilerCsgReachableFunctionIndexForProducer(
                work.reachableSet, sourceIndex, declIndex)
        if functionIndex < 0:
            err = Fmt" compiler csg: graph symbol has no producer row producer_source={sourceIndex} producer_decl={declIndex}"
            return false
        if sourceIndex < 0 || sourceIndex >= work.typedMetadataContexts.len:
            err = Fmt" compiler csg: graph symbol metadata context missing source={sourcePath} profile={sourceIndex} function={functionName}"
            return false
        var semanticIdentity: CompilerCsgFunctionSemanticIdentity
        if !CompilerCsgBuildFunctionSemanticIdentity(
                ownerModulePath,
                work.reachableSet.sourcePaths[functionIndex],
                declarationLineIndex,
                functionName,
                work.typedMetadataContexts[sourceIndex],
                semanticIdentity,
                err):
            return false
        if !CompilerCsgSemanticIdentityIndexInsert(
                work.functionSemanticIdentityIndex,
                semanticIdentity.canonicalSource,
                semanticIdentity.functionName,
                semanticIdentity.paramTypeJoin,
                semanticIdentity.returnType,
                semanticIdentity.signatureComplete ? 1 : 0,
                err):
            return false
        let pendingExportName =
            work.exprCallProfiles[sourceIndex].decls[declIndex].explicitExportName
        var entryFlag = 0
        if sourcePath == stableEntryPath && functionName == linkPlan.entrySymbol:
            entryFlag = 1
        var resultLayoutKind = 0
        if functionName == "main":
            resultLayoutKind = 5
        var effectKind = CompilerCsgEffectPure
        if entryFlag != 0:
            effectKind = CompilerCsgEffectProgramEntry
        var capabilityKind = CompilerCsgCapabilityInternal
        if entryFlag != 0:
            capabilityKind = CompilerCsgCapabilityEntrypoint
        let callConv = 1
        let symbolText = parser.ParserConcat3(ownerModulePath, "::", functionName)
        var exportedFlag = 0
        if CompilerCsgShouldExportSymbol(linkPlan.emitKind,
                                           entrySourceFlag,
                                           entryHasExplicitExports,
                                           pendingExportName,
                                           functionName,
                                           entryFlag):
            exportedFlag = 1
        if exportedFlag != 0 &&
           !CompilerCsgExportRootSelected(linkPlan.exportRootSymbols,
                                           symbolText,
                                           pendingExportName,
                                           functionName):
            exportedFlag = 0
        var exportSymbolName = ""
        if exportedFlag != 0:
            exportSymbolName = CompilerCsgTargetExportName(symbolText,
                                                             pendingExportName,
                                                             functionName)
        if os.GetEnv("CHENG_EXP_DBG") != "" && len(pendingExportName) > 0:
            os.WriteLine(os.Get_stderr(), Fmt"expdbg csg fn={functionName} pending={pendingExportName} exported={IntToStr(exportedFlag)} alias={exportSymbolName} roots={IntToStr(linkPlan.exportRootSymbols.len)}")
        var symbolNode: CompilerCsgNode
        symbolNode.nodeId = work.nodes.len + 1
        symbolNode.nodeKind = CompilerCsgNodeKindSymbol
        symbolNode.ownerNodeId = ownerModuleNodeId
        # One source module owns many symbol rows. Each row needs its own
        # retained string owner; the loop-local source owner remains live
        # until the source iteration closes.
        symbolNode.modulePath = parser.ParserOwnedText(ownerModulePath)
        symbolNode.symbolText = symbolText
        # factText is the lowering/backend function-name ABI. Overload
        # identity is carried by independent structured fields below.
        symbolNode.factText = functionName
        symbolNode.producerSourceIndex = sourceIndex
        symbolNode.producerDeclarationIndex = declIndex
        symbolNode.functionNameSurfaceKind =
            work.reachableSet.functionNameSurfaceKinds[functionIndex]
        symbolNode.nameProofCid =
            work.reachableSet.functionNameProofCids[functionIndex]
        symbolNode.semanticSource =
            parser.ParserOwnedText(semanticIdentity.canonicalSource)
        symbolNode.semanticDeclarationLineIndex =
            semanticIdentity.declarationLineIndex
        symbolNode.semanticParamTypeJoin = semanticIdentity.paramTypeJoin
        symbolNode.semanticReturnType = semanticIdentity.returnType
        symbolNode.semanticSignatureComplete =
            semanticIdentity.signatureComplete ? 1 : 0
        symbolNode.resultLayoutKind = resultLayoutKind
        symbolNode.effectKind = effectKind
        symbolNode.capabilityKind = capabilityKind
        symbolNode.callConv = callConv
        symbolNode.entryFlag = entryFlag
        symbolNode.exportedFlag = exportedFlag
        symbolNode.exportSymbolName = exportSymbolName
        if pendingExportName.len > 0:
            symbolNode.exportNameExplicit = 1
        let symbolFactCid = CompilerCsgHashNodeRecord(symbolNode)
        symbolNode.factCid = symbolFactCid
        let sharedSymbolNode = share(symbolNode)
        add(work.nodes, sharedSymbolNode)
        let symbolNodeId = symbolNode.nodeId
        if !CompilerCsgFunctionGraphNodeColumnBind(work.graphNodeStore,
                                                   work.graphNodeArena,
                                                   work.functionGraphNodes,
                                                   work.reachableSet,
                                                   functionIndex,
                                                   sourceIndex,
                                                   declIndex,
                                                   work.reachableSet.functionNameProofCids[
                                                       functionIndex],
                                                   symbolNodeId,
                                                   err):
            return false
        CompilerCsgAddEdge(work.edges, ownerModuleNodeId, symbolNodeId, CompilerCsgEdgeKindContains)
        declIndex = declIndex + 1

fn compilerCsgBuildExprCallProfileSourcesRec(
        work: var CompilerCsgBuildWorkingSet,
        out: var CompilerCsg,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceIndex: int32,
        packageNodeId: int32,
        requirePortableReceipt: bool,
        migrationSourceSyntax: bool,
        reuseLinkPlanExprLayer: bool,
        stableEntryPath: str,
        sourceReceiptCid: layout.FixedBytes32,
        sourceReceiptSnapshotCount: int32,
        typedContextLookup: var parser.ParserSourcePathIndexLookup,
        typedSourceIdentityIndex: var texpr.TypedExprSourceIdentityIndex,
        typedIrExprCountCursor: var int32,
        compilerCsgDebugStderr: bool,
        err: var str): bool =
    while true:
        if sourceIndex >= work.exprCallProfiles.len:
            return true
        var debugOwnerMissingCount: int32
        var debugProfileDeclTotal: int32
        var debugProfileNonImportDeclTotal: int32
        var debugFirstProfileDeclCount: int32 = -1
        var debugFirstOwnerNodeId: int32 = -1
        CompilerCsgBuildSourceScratchRelease(work)
        CompilerCsgTraceStage("profile_loop_top")
        CompilerCsgTraceProfileSource(sourceIndex, work.exprCallProfiles[sourceIndex].sourcePath)
        if sourceIndex % 16 == 0:
            os.ProcessResourceGuardCheck()
        if debugFirstProfileDeclCount < 0:
            debugFirstProfileDeclCount = work.exprCallProfiles[sourceIndex].decls.len
        debugProfileDeclTotal = debugProfileDeclTotal +
                                work.exprCallProfiles[sourceIndex].decls.len
        let sourcePath = work.exprCallProfiles[sourceIndex].sourcePath
        let ownerModulePath = work.orderedSourceModules[sourceIndex]
        if compilerCsgMemTrace:
            let memTag = Fmt"src={sourceIndex} decls={work.exprCallProfiles[sourceIndex].decls.len} path={sourcePath}"
            compilerCsgMemTraceEmit(memTag)
        var parserSourceIdentities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
        if !CompilerCsgParserReceiptProfileIdentities(
               work.reachableSet,
               work.orderedSources,
               work.orderedSourceModules,
               sourceIndex,
               parserSourceIdentities,
               err):
            return false
        if reuseLinkPlanExprLayer:
            var parserFailure: diagnostic_failure.DiagnosticFailureArtifact
            var parserFailureAuthority: diagnostic_authority.ParserDiagnosticAuthority
            var parserFailureProducerProjectionCids: layout.FixedBytes32[]
            if !CompilerCsgParserReceiptObserveSourceTree(
                   work.parserNormalizedExprReceiptAccumulator,
                   work.sourceSnapshots,
                   work.sourceSnapshotIndex,
                   work.orderedSources.len,
                   sourceIndex,
                   sourcePath,
                   ownerModulePath,
                   requirePortableReceipt,
                   sourceReceiptCid,
                   requirePortableReceipt ?
                       sourceReceiptSnapshotCount :
                       work.exprCallProfiles.len,
                   linkPlan.packageId,
                   work.exprCallProfiles[sourceIndex].migrationSourceSyntax,
                   parserSourceIdentities,
                   work.exprCallProfiles[sourceIndex].decls,
                   parserFailure,
                   parserFailureAuthority,
                   parserFailureProducerProjectionCids,
                   err):
                if parserFailure.producerKinds.len > 0:
                    diagnostic_failure.DiagnosticFailureArtifactMoveInto(
                        out.diagnosticFailureArtifact,
                        parserFailure)
                    if parserFailureAuthority.authorityKinds.len > 0:
                        if !diagnostic_authority.ParserDiagnosticAuthorityMoveInto(
                               out.diagnosticFailureAuthority,
                               parserFailureAuthority,
                               parserFailureProducerProjectionCids,
                               err):
                            panic(strings.CloneStr(err))
                        out.diagnosticFailureProducerProjectionCids =
                            parserFailureProducerProjectionCids
                    CompilerCsgRefreshMemoryLedger(out)
                return false
        if reuseLinkPlanExprLayer:
            var parserGlobalSourceText: str
            if !CompilerCsgImmutableSourceSnapshotText(
                   work.sourceSnapshots,
                   work.sourceSnapshotIndex,
                   sourcePath,
                   parserGlobalSourceText,
                   err):
                return false
            if sourceIndex >= work.typedMetadataContexts.len ||
               !CompilerCsgBindMetadataGlobalParserIdentities(
                   work.typedMetadataContexts[sourceIndex],
                   work.parserNormalizedExprReceiptAccumulator.sourceSidecars[
                       sourceIndex],
                   parserGlobalSourceText,
                   sourceIndex,
                   work.typedMetadataContexts.len,
                   err):
                return false
            # (作用域退出即释放, 删除冗余手动清空 — 该赋值触发 old-owner
            # replace-state 分析在条件块内的缺口)
        if reuseLinkPlanExprLayer &&
           !CompilerCsgReachableBindParserSidecarProfile(
                work.reachableSet,
                sourceIndex,
                work.parserNormalizedExprReceiptAccumulator.sourceSidecars[
                    sourceIndex],
                err):
            return false
        CompilerCsgTraceStage("after_profile_borrow")
        var ownerModuleNodeId = CompilerCsgModuleNodeIdIndexed(work.modules,
                                                               work.moduleNodeIds,
                                                               ownerModulePath)
        if ownerModuleNodeId <= 0:
            ownerModuleNodeId = CompilerCsgEnsureModuleNode(work.nodes,
                                                           work.edges,
                                                           packageNodeId,
                                                           ownerModulePath)
        if sourceIndex == 0:
            debugFirstOwnerNodeId = ownerModuleNodeId
        if ownerModuleNodeId <= 0:
            debugOwnerMissingCount = debugOwnerMissingCount + 1
            err = Fmt" compiler csg: profile owner module/node unresolved source={sourcePath} module={ownerModulePath} source_index={sourceIndex}"
            return false
        let sourceReachableForCsg =
            !work.reachableSet.active ||
            CompilerCsgReachableHasSource(work.reachableSet, sourcePath)
        if !reuseLinkPlanExprLayer:
            let emptyExternalCallLookup = parser.ParserTextLookup()
            work.activeExternalCallLookup = emptyExternalCallLookup
            parser.NormalizedExprLayerReset(work.activeExprLayer)
            let emptyCurrentProfile =
                parser.NormalizedExprCallProfile()
            work.activeCurrentProfile = emptyCurrentProfile
            work.activeCurrentProfile.migrationSourceSyntax =
                migrationSourceSyntax
            work.activeCurrentProfileText = ""
            work.activeCurrentProfileNormalizedText = ""
            var currentProfileErr: str
            if !CompilerCsgImmutableSourceSnapshotText(work.sourceSnapshots,
                                                        work.sourceSnapshotIndex,
                                                        sourcePath,
                                                        work.activeCurrentProfileText,
                                                        currentProfileErr):
                if currentProfileErr != "":
                    err = currentProfileErr
                else:
                    err = " compiler csg: immutable source snapshot failure"
                return false
            work.activeCurrentProfileNormalizedText =
                work.activeCurrentProfileText
            if parser.ParserSourceHasMultilineString(
                    work.activeCurrentProfileText):
                if !parser.ParserRewriteMultilineStringSourceText(
                        work.activeCurrentProfileText,
                        work.activeCurrentProfileNormalizedText,
                        currentProfileErr):
                    if currentProfileErr != "":
                        err = parser.ParserConcat4(" compiler csg: normalized expr lines restore failed: ",
                                                   sourcePath,
                                                   ": ",
                                                   currentProfileErr)
                    else:
                        err = parser.ParserConcat3(" compiler csg: normalized expr lines restore failed: ",
                                                   sourcePath,
                                                   ": empty diagnostic")
                    return false
            if work.exprCallProfiles[sourceIndex].lines.len > 0:
                let clonedCurrentProfileLines =
                    CompilerCsgCloneBorrowedStrSeq(
                        work.exprCallProfiles[sourceIndex].lines)
                work.activeCurrentProfile.lines =
                    clonedCurrentProfileLines
            else:
                let splitCurrentProfileLines =
                    parser.ParserSplitChar(
                        work.activeCurrentProfileNormalizedText, '\n')
                work.activeCurrentProfile.lines =
                    splitCurrentProfileLines
            let activeLocalCallLookup =
                parser.ParserTextLookupBuildExact(
                work.exprCallProfiles[sourceIndex].localCallNames)
            work.activeLocalCallLookup = activeLocalCallLookup
            let activeImportcCallLookup =
                parser.ParserTextLookupBuildExact(
                work.exprCallProfiles[sourceIndex].importcCallNames)
            work.activeImportcCallLookup = activeImportcCallLookup
            parser.ParserJoinContinuationLinesInPlace(work.activeCurrentProfile.lines)
            CompilerCsgTraceStage("r92_t1_pre_view_begin")
            if !CompilerCsgBuildActiveCompactProfileViewBegin(work,
                                                               sourceIndex,
                                                               err):
                return false
            if !CompilerCsgParseExactFullSourceLayer(
                    sourcePath,
                    work.activeCurrentProfileText,
                    work.activeCurrentProfile.lines,
                    work.activeCompactProfileView,
                    work.activeExprLayer,
                    err):
                return false
            CompilerCsgTraceStage("r92_t2_pre_observe")
            if !CompilerCsgParserReceiptObserveExactSourceTree(
                    work.parserNormalizedExprReceiptAccumulator,
                    work.sourceSnapshots,
                    work.sourceSnapshotIndex,
                    work.orderedSources.len,
                    sourceIndex,
                    sourcePath,
                    work.activeExprLayer.valueExprTree,
                    parserSourceIdentities,
                    work.exprCallProfiles[sourceIndex].decls,
                    err):
                return false
            if sourceIndex >= work.typedMetadataContexts.len ||
               !CompilerCsgBindMetadataGlobalParserIdentities(
                   work.typedMetadataContexts[sourceIndex],
                   work.parserNormalizedExprReceiptAccumulator.sourceSidecars[
                       sourceIndex],
                   work.activeCurrentProfileText,
                   sourceIndex,
                   work.typedMetadataContexts.len,
                   err):
                return false
            if !CompilerCsgReachableBindParserSidecarProfile(
                    work.reachableSet,
                    sourceIndex,
                    work.parserNormalizedExprReceiptAccumulator.sourceSidecars[
                        sourceIndex],
                    err):
                return false
            CompilerCsgTraceStage("r92_t3_post_observe_meta")
            var exactExprLineStarts: int32[]
            var exactExprRowIndexes: int32[]
            if !CompilerCsgExactSourceExprRowIndexBuild(
                    work.activeExprLayer,
                    work.activeCurrentProfile.lines.len,
                    exactExprLineStarts,
                    exactExprRowIndexes,
                    err):
                return false
            var exactExprRowDomains: int32[]
            setLen(exactExprRowDomains, work.activeExprLayer.exprs.len)
            CompilerCsgTraceStage("r92_t4_post_rowindex")
            var exactStructuredFacts: parser.ParserStructuredSourceFacts
            var exactStructuredSlice: parser.ParserStructuredSourceSlice
            var exactStructuredErr: str
            if !parser.ParserStructuredSourceFactsBuildFromLayer(
                    work.activeExprLayer,
                    work.activeCurrentProfile.lines.len,
                    exactStructuredFacts,
                    exactStructuredErr):
                err = Fmt" compiler csg: exact structured source failed source={sourcePath}: {exactStructuredErr}"
                return false
            var sourceFunctionStart: int32 = -1
            var sourceFunctionEnd: int32 = -1
            if sourceIndex >= work.reachableSet.profileFunctionStarts.len ||
               sourceIndex >= work.reachableSet.profileFunctionCounts.len:
                err = Fmt" compiler csg: function adjacency missing source={sourcePath} profile_index={sourceIndex}"
                return false
            sourceFunctionStart =
                work.reachableSet.profileFunctionStarts[sourceIndex]
            sourceFunctionEnd = sourceFunctionStart +
                work.reachableSet.profileFunctionCounts[sourceIndex]
            if sourceFunctionStart < 0 || sourceFunctionEnd < sourceFunctionStart ||
               sourceFunctionEnd > work.reachableSet.functionNames.len:
                err = Fmt" compiler csg: function adjacency range invalid source={sourcePath} start={sourceFunctionStart} end={sourceFunctionEnd}"
                return false
            var sourceFunctionIndexes: int32[]
            compilerCsgBuildSourceFunctionIndexListRec(
                sourceFunctionIndexes, sourceFunctionStart, sourceFunctionEnd)
            var sourceFactsTextIndex: int32
            if !CompilerCsgSourcePathIndexFind(work.typedSourceTextIndex,
                                               sourcePath,
                                               sourceFactsTextIndex,
                                               err):
                return false
            if sourceFactsTextIndex < 0 ||
               sourceFactsTextIndex >= work.typedSourceTexts.len:
                err = Fmt" compiler csg: reusable facts source text missing source={sourcePath}"
                return false
            var sourceFactsContextErr: str
            CompilerCsgTraceStage("r92_t5_post_structured")
            if sourceReachableForCsg &&
               !texpr.TypedExprBuildReusableFactsSourceContext(
                    work.typedSourceTexts,
                    sourceFactsTextIndex,
                    work.typedMetadataContexts,
                    typedContextLookup,
                    sourceFunctionIndexes,
                    work.reachableSet.sourcePaths,
                    work.reachableSet.startLines,
                    work.reachableSet.endLines,
                    work.reachableSet.reachable,
                    work.reachableSet.active,
                    0,
                    sourceFunctionIndexes.len,
                    work.activeFactsContext,
                    sourceFactsContextErr):
                if sourceFactsContextErr != "":
                    err = sourceFactsContextErr
                else:
                    err = Fmt" compiler csg: reusable facts source context failed source={sourcePath}"
                return false
            var sourceSummaryCounted = false
            var sourceExprTotal: int32
            var sourceSliceCount: int32
            let sourceTypedFactStart = CompilerCsgSemanticTypedFactCount(work.semanticGraph)
            CompilerCsgTraceStage("before_expr_layer_for_profile")
            CompilerCsgTraceStage("r92_t6_post_factsctx")
            if sourceFunctionStart >= 0:
                var previousExactFunctionEndLine: int32
                if !compilerCsgBuildExactFunctionSlicesRec(
                        work,
                        sourcePath,
                        sourceIndex,
                        sourceFunctionStart,
                        sourceFunctionEnd,
                        previousExactFunctionEndLine,
                        exactExprLineStarts,
                        exactExprRowIndexes,
                        exactExprRowDomains,
                        exactStructuredFacts,
                        exactStructuredSlice,
                        sourceExprTotal,
                        sourceSliceCount,
                        sourceSummaryCounted,
                        typedContextLookup,
                        typedSourceIdentityIndex,
                        typedIrExprCountCursor,
                        compilerCsgDebugStderr,
                        err):
                    return false
            else:
                err = Fmt" compiler csg: exact source has no valid function adjacency source={sourcePath}"
                return false
            if !CompilerCsgExactExprRowsMarkNonFunctionDeclarationDomain(
                    work.activeExprLayer,
                    exactExprRowDomains,
                    sourcePath == stableEntryPath,
                    err) ||
               !CompilerCsgExactExprRowsRequireClosed(
                    work.activeExprLayer,
                    exactExprRowDomains,
                    err):
                return false
            CompilerCsgTraceStage("r92_t7_post_slices")
            texpr.TypedExprReleaseReusableFactsSourceContext(
                work.activeFactsContext)
            let sourceTypedFactAddedCount = CompilerCsgSemanticTypedFactCount(work.semanticGraph) - sourceTypedFactStart
            if sourceExprTotal > 0 && sourceSliceCount <= 0:
                err = Fmt" compiler csg: source expressions have no function slice source={sourcePath} expr_count={sourceExprTotal}"
                return false
            if sourceExprTotal <= 0 && sourceTypedFactAddedCount != 0:
                err = Fmt" compiler csg: declaration-only source produced typed facts source={sourcePath} fact_count={sourceTypedFactAddedCount}"
                return false
            if !CompilerCsgBuildActiveCompactProfileViewClose(work, err):
                return false
            parser.ParserStructuredSourceSliceReset(exactStructuredSlice)
            parser.ParserStructuredSourceFactsReset(exactStructuredFacts)
            parser.NormalizedExprLayerReset(work.activeFunctionExprLayer)
            parser.NormalizedExprLayerReset(work.activeExprLayer)
            let releasedExternalCallLookup =
                parser.ParserTextLookup()
            work.activeExternalCallLookup =
                releasedExternalCallLookup
            let releasedLocalCallLookup = parser.ParserTextLookup()
            work.activeLocalCallLookup = releasedLocalCallLookup
            let releasedImportcCallLookup =
                parser.ParserTextLookup()
            work.activeImportcCallLookup =
                releasedImportcCallLookup
            work.activeCurrentProfile.text = ""
            work.activeCurrentProfile.lines = []
            work.activeCurrentProfileText = ""
            work.activeCurrentProfileNormalizedText = ""
            # The reusable facts context owns full-source lines, bindings and
            # indexes. Release every source-scoped owner and return its free
            # pages before declaration lowering can allocate the next phase.
            let _sourceFactsContextRelief = os.ProcessMemoryPressureRelief()
            if compilerCsgDebugStderr:
                CompilerCsgDebugLine(Fmt"compiler_csg_source_expr_slices_done source={sourcePath} slice_count={sourceSliceCount} expr_count={sourceExprTotal} facts_added={sourceTypedFactAddedCount} rss_bytes={os.ProcessRssBytes()}")
            # [c1-line] One flush per source at the t7 boundary (print+reset),
            # so a mid-run abort keeps every processed source's distribution.
            compilerCsgDeclTimeFlushSource(sourceIndex)
            CompilerCsgTraceStage("after_expr_layer_for_profile_call")
        let entrySourceFlag = sourcePath == stableEntryPath
        var entryHasExplicitExports = false
        if entrySourceFlag && (linkPlan.emitKind == creq.EmitShared || linkPlan.emitKind == creq.EmitObj):
            compilerCsgBuildEntryExportScanRec(
                work, sourceIndex, 0, entryHasExplicitExports)
        CompilerCsgTraceStage("after_entry_export_scan")
        CompilerCsgTraceStage("before_decl_loop")
        if !compilerCsgBuildProfileDeclSymbolsRec(
                work,
                linkPlan,
                sourceIndex,
                0,
                sourcePath,
                ownerModulePath,
                ownerModuleNodeId,
                entrySourceFlag,
                entryHasExplicitExports,
                stableEntryPath,
                err):
            return false
        CompilerCsgTraceStage("after_decl_loop")
        CompilerCsgTraceStage("before_profile_clear")
        CompilerCsgBuildSourceScratchRelease(work)
        CompilerCsgTraceStage("after_profile_store")
        if compilerCsgMemTrace:
            let memDoneTag = Fmt"src_done={sourceIndex}"
            compilerCsgMemTraceEmit(memDoneTag)
        sourceIndex = sourceIndex + 1
        continue

fn compilerCsgBuildParserReceiptCoverageRec(
        work: var CompilerCsgBuildWorkingSet,
        parserReceiptCoverage: var bool[],
        parserReceiptCoversAllFunctions: bool,
        functionIndex: int32): bool =
    while true:
        if functionIndex >= work.reachableSet.functionNames.len:
            return true
        var covered = parserReceiptCoversAllFunctions
        if !covered && functionIndex < work.reachableSet.reachable.len:
            covered = work.reachableSet.reachable[functionIndex]
        add(parserReceiptCoverage, covered)
        functionIndex = functionIndex + 1
        continue

@borrows
fn compilerCsgBuildDebugMaskCharTotalsRec(
        mask: str,
        charIndex: int32,
        oneTotal: var int32,
        zeroTotal: var int32) =
    while true:
        if charIndex >= mask.len:
            return
        if mask[charIndex] == '1':
            oneTotal = oneTotal + 1
        elif mask[charIndex] == '0':
            zeroTotal = zeroTotal + 1
        charIndex = charIndex + 1
        continue

@borrows
fn compilerCsgBuildDebugMaskTotalsRec(
        masks: str[],
        maskIndex: int32,
        oneTotal: var int32,
        zeroTotal: var int32) =
    while true:
        if maskIndex >= masks.len:
            return
        compilerCsgBuildDebugMaskCharTotalsRec(masks[maskIndex], 0, oneTotal, zeroTotal)
        maskIndex = maskIndex + 1
        continue

fn compilerCsgBuildFinalSymbolCountRec(
        work: var CompilerCsgBuildWorkingSet,
        i: int32,
        finalSymbolCount: var int32) =
    while true:
        if i >= work.nodes.len:
            return
        if work.nodes[i].nodeKind == CompilerCsgNodeKindSymbol:
            finalSymbolCount = finalSymbolCount + 1
        i = i + 1

@borrows
fn compilerCsgBuildReachDebugSetRec(
        work: var CompilerCsgBuildWorkingSet,
        target: str,
        reachRound: int32,
        i: int32,
        matches: var int32) =
    while true:
        if i >= work.reachableSet.functionNames.len:
            return
        if work.reachableSet.functionNames[i] != target:
            i = i + 1
            continue
            return
        matches = matches + 1
        var dbgReachable = false
        if i < work.reachableSet.reachable.len:
            dbgReachable = work.reachableSet.reachable[i]
        var dbgProcessed = false
        if i < work.typedIrProcessedFunctions.len:
            dbgProcessed = work.typedIrProcessedFunctions[i]
        var dbgSource = ""
        if i < work.reachableSet.sourcePaths.len:
            dbgSource = work.reachableSet.sourcePaths[i]
        var dbgLine: int32
        if i < work.reachableSet.startLines.len:
            dbgLine = work.reachableSet.startLines[i]
        os.WriteLine(os.GetStderr(),
                     Fmt"csg_reach_debug set round={reachRound} index={i} source={dbgSource} line={dbgLine} reachable={dbgReachable} processed={dbgProcessed}")
        i = i + 1
        continue

@borrows
fn compilerCsgBuildReachDebugFilterRec(
        work: var CompilerCsgBuildWorkingSet,
        target: str,
        reachRound: int32,
        i: int32,
        matches: var int32) =
    while true:
        if i >= work.reachableFilterFunctionNames.len:
            return
        if work.reachableFilterFunctionNames[i] != target:
            i = i + 1
            continue
            return
        matches = matches + 1
        var dbgFilterSource = ""
        if i < work.reachableFilterSourcePaths.len:
            dbgFilterSource = work.reachableFilterSourcePaths[i]
        var dbgFilterLine: int32
        if i < work.reachableFilterStartLines.len:
            dbgFilterLine = work.reachableFilterStartLines[i]
        os.WriteLine(os.GetStderr(),
                     Fmt"csg_reach_debug filter round={reachRound} index={i} source={dbgFilterSource} line={dbgFilterLine}")
        i = i + 1
        continue

@borrows
fn compilerCsgBuildReachDebugTypedRec(
        work: var CompilerCsgBuildWorkingSet,
        target: str,
        reachRound: int32,
        i: int32,
        matches: var int32) =
    while true:
        if i >= work.typedIr.functions2_functionNameIds.len:
            return
        let dbgFunctionNameRes: Result[str] = langintern.LookupIntern(work.typedIr.internPool, work.typedIr.functions2_functionNameIds[i])
        if !IsOk(dbgFunctionNameRes) || Value(dbgFunctionNameRes) != target:
            i = i + 1
            continue
            return
        matches = matches + 1
        let dbgSourcePathRes: Result[str] = langintern.LookupIntern(work.typedIr.internPool, work.typedIr.functions2_sourcePathIds[i])
        let dbgSourcePath = if IsOk(dbgSourcePathRes): Value(dbgSourcePathRes) else: ""
        os.WriteLine(os.GetStderr(),
                     Fmt"csg_reach_debug typed round={reachRound} index={i} source={dbgSourcePath} line={arenamod.ArenaArrayInt32Get(work.typedIr.arena, work.typedIr.functions2_signatureLineNumbers, i)} statements={arenamod.ArenaArrayInt32Get(work.typedIr.arena, work.typedIr.functions2_statementCounts, i)}")
        i = i + 1
        continue

type
    compilerCsgTypedIrReachState = ref object
        reachStable: bool
        reachRound: int32
        rebuildSourceCount: int32
        newFunctionCount: int32
        roundFactsMaxCount: int32
        roundExprMaxCount: int32
        roundFactsResetCount: int32
        reachabilityScannedStatementCount: int32
        reachabilityScannedFunctionCount: int32
        reachabilityNewReachableFunctionCount: int32
        buildIndexGeneration: int32
        buildIndexValidationEpochAtSeal: int32
        buildIndexMetadataRowCountAtSeal: int32
        buildIndexMetadataRowCountExpectedAtSeal: int32
        buildIndexFullValidationCount: int32
        buildIndexSealedFactsCount: int32
        buildIndexSealedAppendCount: int32
        buildIndexSessionGeneration: int32
        buildIndexContextCountAtSeal: int32
        buildIndexExpectedContextCountAtSeal: int32
        buildIndexMetadataContextCountExpectedAfterSeal: int32
        buildIndexMetadataContextCountObservedAfterSeal: int32
        buildIndexMetadataRowsExpectedAfterSeal: int64
        buildIndexSealedFactsMetadataRows: int64
        buildIndexSealedAppendMetadataRows: int64
        reachableFilterActive: bool
        typedIrErr: str
        typedIrBatchFunctionLimit: int32

    compilerCsgTypedIrReachRoundState =
        csgReachDebugTarget: str
        reachableBeforeRound: int32
        typedIrFunctionRanges: texpr.TypedExprFunctionSourceRangeSet
        typedIrRangeFunctionIndexes: int32[]
        typedIrFunctionRangesActive: bool

@borrows
fn compilerCsgBuildTypedIrReachRoundPrepare(
        work: var CompilerCsgBuildWorkingSet,
        st: var compilerCsgTypedIrReachState,
        round: var compilerCsgTypedIrReachRoundState,
        err: var str): bool =
    if st.reachStable:
        return true
    var typedIrErr = st.typedIrErr
    texpr.TypedExprFactTableReset(work.typedIrRoundFacts)
    work.frontierSourcePaths = []
    if st.reachRound > work.reachableSet.functionNames.len + 1:
        err = Fmt" compiler csg: typed ir reachable fixed point did not converge rounds={st.reachRound} function_count={work.reachableSet.functionNames.len}"
        st.typedIrErr = typedIrErr
        return false
    CompilerCsgTraceStage("before_typed_ir_expr_layer_rebuild")
    parser.NormalizedExprLayerReset(work.exprLayer)
    if st.reachRound <= 0:
        CompilerCsgClearTypedIrForReachabilityPreservingTypeInfo(work.typedIr)
    if work.typedIrReachStatementCursor != work.typedIr.statements2_statementIndexs.len ||
       work.typedIrReachFunctionCursor != work.typedIr.functions2_functionNameIds.len:
        err = Fmt" compiler csg: typed ir reach cursor does not match committed rows round={st.reachRound} statement_cursor={work.typedIrReachStatementCursor} statement_count={work.typedIr.statements2_statementIndexs.len} function_cursor={work.typedIrReachFunctionCursor} function_count={work.typedIr.functions2_functionNameIds.len}"
        st.typedIrErr = typedIrErr
        return false
    work.reachableFilterSourcePaths = []
    work.reachableFilterFunctionNames = []
    work.reachableFilterStartLines = []
    work.reachableFilterFunctionIndexes = []
    var reachableFilterErr: str
    if !CompilerCsgReachableFilterArraysUnprocessed(work.reachableSet,
                                                    work.typedIrProcessedFunctions,
                                                    work.typedIrReachableCursor,
                                                    st.typedIrBatchFunctionLimit,
                                                    work.reachableFilterSourcePaths,
                                                    work.reachableFilterFunctionNames,
                                                    work.reachableFilterStartLines,
                                                    work.reachableFilterFunctionIndexes,
                                                    reachableFilterErr):
        err = reachableFilterErr
        st.typedIrErr = typedIrErr
        return false
    let csgReachDebugTarget = os.GetEnv("CHENG_CSG_REACH_DEBUG")
    if csgReachDebugTarget != "":
        var reachDebugSetMatches: int32
        var reachDebugFilterMatches: int32
        compilerCsgBuildReachDebugSetRec(
            work, csgReachDebugTarget, st.reachRound, 0, reachDebugSetMatches)
        compilerCsgBuildReachDebugFilterRec(
            work, csgReachDebugTarget, st.reachRound, 0, reachDebugFilterMatches)
        os.WriteLine(os.GetStderr(),
                     Fmt"csg_reach_debug summary round={st.reachRound} target={csgReachDebugTarget} set_matches={reachDebugSetMatches} filter_matches={reachDebugFilterMatches} filter_count={work.reachableFilterFunctionNames.len}")
    if work.reachableFilterFunctionNames.len <= 0:
        st.reachStable = true
        st.typedIrErr = typedIrErr
        return true
    var frontierSourceErr: str
    if !CompilerCsgUniqueSourcePathsFromFilter(work.reachableSet,
                                               work.reachableFilterSourcePaths,
                                               work.frontierSourcePaths,
                                               frontierSourceErr):
        if frontierSourceErr != "":
            err = frontierSourceErr
        else:
            err = " compiler csg: immutable source snapshot failure"
        st.typedIrErr = typedIrErr
        return false
    st.rebuildSourceCount = st.rebuildSourceCount + work.frontierSourcePaths.len
    var typedSourceRestoreErr: str
    if !CompilerCsgBuildFrontierTypedSourceTexts(work.sourceSnapshots,
                                                  work.sourceSnapshotIndex,
                                                  work.typedSourceTexts,
                                                  work.typedSourceTextIndex,
                                                  work.frontierSourcePaths,
                                                  work.frontierTypedSourceTexts,
                                                  work.frontierTypedSourceTextIndex,
                                                  typedSourceRestoreErr):
        if typedSourceRestoreErr != "":
            err = typedSourceRestoreErr
        else:
            err = " compiler csg: immutable source snapshot failure"
        st.typedIrErr = typedIrErr
        return false
    let reachableBeforeRound = CompilerCsgReachableCount(work.reachableSet)
    var exprLayerReloadErr = ""
    CompilerCsgBuildWorkingSetReleaseActiveFunctionSourceSlices(work)
    # [GEN2-P1] 波界增量释放：上波 slices/exprLayer 树租已闭合，整体释放
    # frontier 解析缓存；下一行 rebuild 按需从 immutable snapshot 重解析
    # （逐字节同值，见 EvictAll 注记）。缓存由跨波单调累积降为单波工作集。
    CompilerCsgFrontierParsedSourceStoreEvictAll(work.frontierParsedSources)
    if !compilerCsgExprLayerForFrontierFunctionsImpl(
            work.sourceSnapshots,
            work.sourceSnapshotIndex,
            work.exprCallProfiles,
            work.profileIndexLookup,
            work.profileCallLookupCache,
            work.frontierParsedSources,
            work.reachableSet,
            work.reachableFilterFunctionIndexes,
            work.frontierIndex,
            work.exprLayer,
            work.activeSliceExprLayer,
            work.activeFunctionSourceSlices,
            work.parserNormalizedExprReceiptAccumulator,
            true,
            true,
            exprLayerReloadErr):
        if exprLayerReloadErr != "":
            err = Fmt" compiler csg: typed ir expr layer rebuild failed: {exprLayerReloadErr}"
            st.typedIrErr = typedIrErr
            return false
        err = " compiler csg: typed ir expr layer rebuild failed"
        st.typedIrErr = typedIrErr
        return false
    work.activeFunctionSourceSlicesOwned = true
    if !CompilerCsgValidateFrontierExprLayerSources(work.frontierTypedSourceTexts,
                                                    work.frontierTypedSourceTextIndex,
                                                    work.exprLayer,
                                                    typedSourceRestoreErr):
        if typedSourceRestoreErr != "":
            err = typedSourceRestoreErr
        else:
            err = " compiler csg: immutable source snapshot failure"
        st.typedIrErr = typedIrErr
        return false
    CompilerCsgDebugLine(Fmt"compiler_csg_typed_ir_expr_layer_rebuild expr_count={work.exprLayer.exprs.len} source_count={work.exprLayer.sourceCount} reachable_active={work.reachableSet.active}")
    CompilerCsgClearExprLayerLookup(work.exprLayer)
    CompilerCsgTraceStage("after_typed_ir_expr_layer_rebuild")
    CompilerCsgDebugLine(Fmt"compiler_csg_typed_ir_before_reachable_filter reachable_functions={work.reachableSet.functionNames.len}")
    CompilerCsgDebugLine(Fmt"compiler_csg_typed_ir_after_reachable_filter source_count={work.frontierSourcePaths.len} function_count={work.reachableFilterFunctionNames.len}")
    st.reachableFilterActive = work.reachableSet.active
    if !st.reachableFilterActive && work.reachableFilterFunctionNames.len > 0:
        st.reachableFilterActive = true
    var typedIrFunctionRanges: texpr.TypedExprFunctionSourceRangeSet
    var typedIrRangeFunctionIndexes: int32[]
    var typedIrFunctionRangesActive = false
    if work.activeFunctionSourceSlicesOwned:
        var typedIrRoundFactsErr = ""
        CompilerCsgDebugLine(Fmt"compiler_csg_typed_ir_before_round_facts expr_count={work.exprLayer.exprs.len} metadata_count={work.typedMetadataContexts.len}")
        var typedIrRoundFactsOk = false
        var indexedSealedFactsOperationCount: int32
        var indexedSealedFactsMetadataContextCountExpected: int32
        var indexedSealedFactsMetadataContextCountObserved: int32
        var indexedSealedFactsMetadataRowsExpected: int64
        var indexedSealedFactsMetadataRows: int64
        var validationEpochBeforeFacts: int32
        var sealedValidationCountBeforeFacts: int32
        var metadataRowsBeforeFacts: int64
        if st.reachRound > 0:
            if !texpr.TypedExprSealedBuildIndexActive(work.typedIr):
                err = " compiler csg: typed ir frozen metadata session missing before facts"
                st.typedIrErr = typedIrErr
                return false
            validationEpochBeforeFacts =
                texpr.TypedExprSealedBuildIndexValidationEpoch(work.typedIr)
            sealedValidationCountBeforeFacts =
                texpr.TypedExprSealedBuildIndexValidationCount(work.typedIr)
            metadataRowsBeforeFacts =
                texpr.TypedExprSealedBuildIndexMetadataRowsVisited(work.typedIr)
        if !work.activeFunctionSourceSlicesOwned:
            err = " compiler csg: bounded typed-ir function slices missing"
            st.typedIrErr = typedIrErr
            return false
        typedIrRoundFactsOk =
            CompilerCsgBuildFactsForFunctionSourceSlices(
                work.frontierTypedSourceTexts,
                work.exprLayer,
                work.typedMetadataContexts,
                work.typedIr,
                st.reachRound > 0,
                work.reachableSet,
                work.reachableFilterFunctionIndexes,
                work.activeFunctionSourceSlices,
                work.activeSliceExprLayer,
                work.activeSliceTypedFacts,
                work.typedIrRoundFacts,
                typedIrFunctionRanges,
                typedIrRangeFunctionIndexes,
                work.frontierIndex.lastStructuredSidecar,
                indexedSealedFactsOperationCount,
                indexedSealedFactsMetadataContextCountExpected,
                indexedSealedFactsMetadataContextCountObserved,
                indexedSealedFactsMetadataRowsExpected,
                indexedSealedFactsMetadataRows,
                typedIrRoundFactsErr)
        typedIrFunctionRangesActive = typedIrRoundFactsOk
        if !typedIrRoundFactsOk:
            if typedIrRoundFactsErr != "":
                err = typedIrRoundFactsErr
                st.typedIrErr = typedIrErr
                return false
            err = " compiler csg: typed expr round build failed"
            st.typedIrErr = typedIrErr
            return false
        if st.reachRound > 0:
            let validationEpochAfterFacts =
                texpr.TypedExprSealedBuildIndexValidationEpoch(work.typedIr)
            let sealedValidationCountAfterFacts =
                texpr.TypedExprSealedBuildIndexValidationCount(work.typedIr)
            let metadataRowsAfterFacts =
                texpr.TypedExprSealedBuildIndexMetadataRowsVisited(work.typedIr)
            let expectedSealedFactOperations =
                indexedSealedFactsOperationCount
            let metadataRowsMatch =
                texpr.TypedExprMetadataVisitReceiptExact(
                    indexedSealedFactsMetadataContextCountExpected,
                    indexedSealedFactsMetadataContextCountObserved,
                    indexedSealedFactsMetadataRowsExpected,
                    indexedSealedFactsMetadataRows) &&
                indexedSealedFactsMetadataRowsExpected == Int64(0) &&
                indexedSealedFactsMetadataRows == Int64(0) &&
                metadataRowsAfterFacts == metadataRowsBeforeFacts +
                    indexedSealedFactsMetadataRows
            if expectedSealedFactOperations <= 0 ||
               validationEpochAfterFacts != validationEpochBeforeFacts ||
               sealedValidationCountAfterFacts !=
                   sealedValidationCountBeforeFacts +
                       expectedSealedFactOperations ||
               !metadataRowsMatch:
                err = Fmt" compiler csg: typed ir frozen facts accounting mismatch round={st.reachRound} epoch_before={validationEpochBeforeFacts} epoch_after={validationEpochAfterFacts} validations_before={sealedValidationCountBeforeFacts} validations_after={sealedValidationCountAfterFacts} expected_operations={expectedSealedFactOperations} expected_rows={indexedSealedFactsMetadataRows} rows_before={metadataRowsBeforeFacts} rows_after={metadataRowsAfterFacts}"
                st.typedIrErr = typedIrErr
                return false
            st.buildIndexSealedFactsCount =
                st.buildIndexSealedFactsCount +
                    expectedSealedFactOperations
            st.buildIndexSealedFactsMetadataRows =
                st.buildIndexSealedFactsMetadataRows +
                    indexedSealedFactsMetadataRows
            st.buildIndexMetadataContextCountExpectedAfterSeal =
                st.buildIndexMetadataContextCountExpectedAfterSeal +
                    indexedSealedFactsMetadataContextCountExpected
            st.buildIndexMetadataContextCountObservedAfterSeal =
                st.buildIndexMetadataContextCountObservedAfterSeal +
                    indexedSealedFactsMetadataContextCountObserved
            st.buildIndexMetadataRowsExpectedAfterSeal =
                st.buildIndexMetadataRowsExpectedAfterSeal +
                    indexedSealedFactsMetadataRowsExpected
        CompilerCsgNormalizeTypedFactRangeForCsg(work.typedIrRoundFacts,
                                                 0,
                                                 work.typedIrRoundFacts.count)
        CompilerCsgDebugLine(Fmt"compiler_csg_typed_ir_after_round_facts facts={work.typedIrRoundFacts.count}")
        if work.typedIrRoundFacts.count > st.roundFactsMaxCount:
            st.roundFactsMaxCount = work.typedIrRoundFacts.count
        if work.exprLayer.exprs.len > st.roundExprMaxCount:
            st.roundExprMaxCount = work.exprLayer.exprs.len
        if !CompilerCsgSemanticAppendUnprocessedFrontierFacts(work.semanticGraph,
                                                        work.semanticTypedFactAccumulator,
                                                        work.orderedSourceIndex,
                                                        work.reachableSet,
                                                        work.reachableFilterFunctionIndexes,
                                                        work.frontierIndex,
                                                        work.exprLayer,
                                                        work.activeFunctionSourceSlices,
                                                        work.typedIrRoundFacts,
                                                        work.semanticFactProcessedFunctions,
                                                        work.semanticExprSummarySourceCounted,
                                                        typedIrRoundFactsErr):
            err = typedIrRoundFactsErr
            st.typedIrErr = typedIrErr
            return false
    round.csgReachDebugTarget = csgReachDebugTarget
    round.reachableBeforeRound = reachableBeforeRound
    round.typedIrFunctionRanges = typedIrFunctionRanges
    round.typedIrRangeFunctionIndexes = typedIrRangeFunctionIndexes
    round.typedIrFunctionRangesActive = typedIrFunctionRangesActive
    st.typedIrErr = typedIrErr
    return true

@borrows
fn compilerCsgBuildTypedIrReachRoundCommit(
        work: var CompilerCsgBuildWorkingSet,
        st: var compilerCsgTypedIrReachState,
        round: var compilerCsgTypedIrReachRoundState,
        err: var str): bool =
    var typedIrErr = strings.CloneStr(st.typedIrErr)
    typedIrErr = ""
    var frontierRestoreErr: str
    for frontierRestoreIndex in 0..<work.frontierSourcePaths.len:
        if !CompilerCsgRestoreTypedSourceTextBody(
                work.sourceSnapshots,
                work.sourceSnapshotIndex,
                work.frontierTypedSourceTexts,
                work.frontierTypedSourceTextIndex,
                work.frontierSourcePaths[frontierRestoreIndex],
                frontierRestoreErr):
            if frontierRestoreErr != "":
                err = frontierRestoreErr
            else:
                err = " compiler csg: immutable source snapshot failure"
            st.typedIrErr = typedIrErr
            return false
    CompilerCsgTraceStage("before_typed_ir")
    if compilerCsgMemTrace:
        let irRoundTag = Fmt"typed_ir_round round={st.reachRound} funcs={work.typedIr.functions2_functionNameIds.len}"
        compilerCsgMemTraceEmit(irRoundTag)
    let typedIrBuildStartNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let typedIrFunctionCountBeforeBuild = work.typedIr.functions2_functionNameIds.len
    let typedIrStatementCountBeforeBuild = work.typedIr.statements2_statementIndexs.len
    var typedIrRangeReport: texpr.TypedExprFunctionSourceRangeBuildReport
    if st.reachRound <= 0:
        if !round.typedIrFunctionRangesActive:
            err = " compiler csg: bounded typed-ir ranges missing before first build"
            st.typedIrErr = typedIrErr
            return false
        let typedIrBuildOk =
            texpr.TypedExprBuildIrForFunctionSourceRangesFromMetadata(
                work.frontierTypedSourceTexts,
                work.typedIrRoundFacts,
                work.exprLayer,
                work.typedMetadataContexts,
                round.typedIrFunctionRanges,
                work.typedIr,
                typedIrRangeReport,
                typedIrErr)
        if !typedIrBuildOk:
            if typedIrErr != "":
                err = share(typedIrErr)
                st.typedIrErr = typedIrErr
                return false
            err = " compiler csg: typed ir build failed"
            st.typedIrErr = typedIrErr
            return false
        st.buildIndexExpectedContextCountAtSeal =
            work.typedMetadataContexts.len
        st.buildIndexMetadataRowCountExpectedAtSeal =
            texpr.TypedExprSourceContextsMetadataRowCount(
                work.typedMetadataContexts)
        if st.buildIndexExpectedContextCountAtSeal <= 0:
            err = Fmt" compiler csg: typed ir build index context cardinality invalid expected={st.buildIndexExpectedContextCountAtSeal}"
            st.typedIrErr = typedIrErr
            return false
        if !texpr.TypedExprSealBuildSourceContextIndex(work.typedIr,
                                                       work.typedMetadataContexts,
                                                       typedIrErr):
            if typedIrErr != "":
                err = share(typedIrErr)
            else:
                err = " compiler csg: typed ir build index seal failed"
            st.typedIrErr = typedIrErr
            return false
        if !texpr.TypedExprSealedBuildIndexActive(work.typedIr) ||
           work.typedMetadataContexts.len != 0:
            err = Fmt" compiler csg: typed ir frozen metadata ownership transfer failed active={texpr.TypedExprSealedBuildIndexActive(work.typedIr)} caller_contexts={work.typedMetadataContexts.len}"
            st.typedIrErr = typedIrErr
            return false
        let sealedBuildIndex = work.typedIr.buildIndex
        st.buildIndexGeneration =
            texpr.TypedExprBuildIndexBuildGeneration(sealedBuildIndex)
        st.buildIndexSessionGeneration =
            texpr.TypedExprSealedBuildIndexSessionGeneration(work.typedIr)
        st.buildIndexContextCountAtSeal =
            texpr.TypedExprBuildIndexContextCount(sealedBuildIndex)
        st.buildIndexValidationEpochAtSeal =
            texpr.TypedExprSealedBuildIndexValidationEpoch(work.typedIr)
        st.buildIndexMetadataRowCountAtSeal =
            texpr.TypedExprSealedBuildIndexMetadataRowCount(work.typedIr)
        st.buildIndexFullValidationCount =
            texpr.TypedExprSealedBuildIndexFullValidationCount(work.typedIr)
        if st.buildIndexGeneration <= 0 ||
           st.buildIndexSessionGeneration <= 0 ||
           st.buildIndexContextCountAtSeal !=
               st.buildIndexExpectedContextCountAtSeal ||
           st.buildIndexValidationEpochAtSeal <= 0 ||
           st.buildIndexMetadataRowCountAtSeal <= 0 ||
           st.buildIndexMetadataRowCountAtSeal !=
               st.buildIndexMetadataRowCountExpectedAtSeal ||
           st.buildIndexFullValidationCount != 1 ||
           texpr.TypedExprSealedBuildIndexValidationCount(work.typedIr) != 0 ||
           texpr.TypedExprSealedBuildIndexMetadataRowsVisited(work.typedIr) != 0:
            err = Fmt" compiler csg: typed ir build index seal telemetry invalid generation={st.buildIndexGeneration} session_generation={st.buildIndexSessionGeneration} contexts={st.buildIndexContextCountAtSeal} validation_epoch={st.buildIndexValidationEpochAtSeal} metadata_rows={st.buildIndexMetadataRowCountAtSeal} full_validations={st.buildIndexFullValidationCount}"
            st.typedIrErr = typedIrErr
            return false
    else:
        if !texpr.TypedExprSealedBuildIndexActive(work.typedIr):
            err = " compiler csg: typed ir frozen metadata session missing before append"
            st.typedIrErr = typedIrErr
            return false
        let validationEpochBeforeAppend =
            texpr.TypedExprSealedBuildIndexValidationEpoch(work.typedIr)
        let sealedValidationCountBeforeAppend =
            texpr.TypedExprSealedBuildIndexValidationCount(work.typedIr)
        let metadataRowsBeforeAppend =
            texpr.TypedExprSealedBuildIndexMetadataRowsVisited(work.typedIr)
        if !round.typedIrFunctionRangesActive:
            err = Fmt" compiler csg: bounded typed-ir ranges missing round={st.reachRound}"
            st.typedIrErr = typedIrErr
            return false
        let typedIrAppendOk =
            texpr.TypedExprAppendIrFunctionsForFunctionSourceRangesSealed(
                work.frontierTypedSourceTexts,
                work.typedIrRoundFacts,
                work.exprLayer,
                round.typedIrFunctionRanges,
                work.typedIr,
                typedIrRangeReport,
                typedIrErr)
        if !typedIrAppendOk:
            if typedIrErr != "":
                err = share(typedIrErr)
                st.typedIrErr = typedIrErr
                return false
            err = " compiler csg: typed ir sealed append failed"
            st.typedIrErr = typedIrErr
            return false
        let validationEpochAfterAppend =
            texpr.TypedExprSealedBuildIndexValidationEpoch(work.typedIr)
        let sealedValidationCountAfterAppend =
            texpr.TypedExprSealedBuildIndexValidationCount(work.typedIr)
        let metadataRowsAfterAppend =
            texpr.TypedExprSealedBuildIndexMetadataRowsVisited(work.typedIr)
        if validationEpochAfterAppend != validationEpochBeforeAppend:
            err = Fmt" compiler csg: typed ir sealed append repeated full metadata validation round={st.reachRound} before={validationEpochBeforeAppend} after={validationEpochAfterAppend}"
            st.typedIrErr = typedIrErr
            return false
        if sealedValidationCountAfterAppend != sealedValidationCountBeforeAppend + 1:
            err = Fmt" compiler csg: typed ir sealed append validation count mismatch round={st.reachRound} before={sealedValidationCountBeforeAppend} after={sealedValidationCountAfterAppend}"
            st.typedIrErr = typedIrErr
            return false
        if !texpr.TypedExprMetadataVisitReceiptExact(
                typedIrRangeReport.sealedMetadataContextCountExpected,
                typedIrRangeReport.sealedMetadataContextCountObserved,
                typedIrRangeReport.sealedMetadataRowsExpected,
                typedIrRangeReport.sealedMetadataRowsVisited) ||
           typedIrRangeReport.sealedMetadataRowsExpected != Int64(0) ||
           typedIrRangeReport.sealedMetadataRowsVisited != Int64(0) ||
           metadataRowsAfterAppend != metadataRowsBeforeAppend +
               typedIrRangeReport.sealedMetadataRowsVisited:
            err = Fmt" compiler csg: typed ir sealed append metadata visit count mismatch round={st.reachRound} expected={typedIrRangeReport.sealedMetadataRowsVisited} before={metadataRowsBeforeAppend} after={metadataRowsAfterAppend}"
            st.typedIrErr = typedIrErr
            return false
        st.buildIndexSealedAppendCount = st.buildIndexSealedAppendCount + 1
        st.buildIndexSealedAppendMetadataRows =
            st.buildIndexSealedAppendMetadataRows +
                typedIrRangeReport.sealedMetadataRowsVisited
        st.buildIndexMetadataContextCountExpectedAfterSeal =
            st.buildIndexMetadataContextCountExpectedAfterSeal +
                typedIrRangeReport.sealedMetadataContextCountExpected
        st.buildIndexMetadataContextCountObservedAfterSeal =
            st.buildIndexMetadataContextCountObservedAfterSeal +
                typedIrRangeReport.sealedMetadataContextCountObserved
        st.buildIndexMetadataRowsExpectedAfterSeal =
            st.buildIndexMetadataRowsExpectedAfterSeal +
                typedIrRangeReport.sealedMetadataRowsExpected
    let typedIrAppendedFunctionCount =
        work.typedIr.functions2_functionNameIds.len - typedIrFunctionCountBeforeBuild
    let typedIrAppendedStatementCount =
        work.typedIr.statements2_statementIndexs.len - typedIrStatementCountBeforeBuild
    if typedIrAppendedFunctionCount < 0 || typedIrAppendedStatementCount < 0:
        err = Fmt" compiler csg: typed ir append rows regressed round={st.reachRound} appended_functions={typedIrAppendedFunctionCount} appended_statements={typedIrAppendedStatementCount}"
        st.typedIrErr = typedIrErr
        return false
    if typedIrAppendedFunctionCount !=
           round.typedIrRangeFunctionIndexes.len:
        err = Fmt" compiler csg: typed ir append function cardinality mismatch round={st.reachRound} expected={round.typedIrRangeFunctionIndexes.len} actual={typedIrAppendedFunctionCount}"
        st.typedIrErr = typedIrErr
        return false
    # Each frontier transaction commits a fresh sidecar report, so this
    # receipt is per-round rather than cumulative across reachability.
    work.frontierIndex.lastStructuredSidecar.consumerTypedIrBoundedRangeRoundCount =
        work.frontierIndex.lastStructuredSidecar.consumerTypedIrBoundedRangeRoundCount +
            Int64(1)
    let expectedRangeRows = round.typedIrFunctionRanges.sourcePaths.len
    if expectedRangeRows !=
           round.typedIrRangeFunctionIndexes.len ||
       expectedRangeRows !=
           work.reachableFilterFunctionIndexes.len ||
       typedIrRangeReport.rowCount != expectedRangeRows ||
       typedIrRangeReport.commitRowVisitCount != Int64(expectedRangeRows) ||
       typedIrRangeReport.activeRangeCount != 0 ||
       typedIrRangeReport.activeRangePeak != 1 ||
       typedIrRangeReport.contextIndexLookupCount !=
           Int64(expectedRangeRows) ||
       typedIrRangeReport.contextIndexBuildVisitCount <= Int64(0) ||
       typedIrRangeReport.fullSourceScopeRescanCount != 0 ||
       typedIrRangeReport.fullSourceLineRescanCount != 0 ||
       typedIrRangeReport.perRowFullSourceBindingRescanCount != 0 ||
       work.frontierIndex.lastStructuredSidecar.consumerTypedIrBoundedRangeRoundCount !=
           Int64(1) ||
       (st.reachRound <= 0 &&
        (typedIrRangeReport.sealedRoundViewUsed ||
         typedIrRangeReport.contextIndexBuildVisitCount !=
             Int64(st.buildIndexContextCountAtSeal))) ||
       (st.reachRound > 0 &&
        (!typedIrRangeReport.sealedRoundViewUsed ||
         typedIrRangeReport.sealedRoundContextCount <= 0 ||
         typedIrRangeReport.sealedRoundDependencyCount < 0 ||
         typedIrRangeReport.contextIndexBuildVisitCount !=
             Int64(typedIrRangeReport.sealedRoundContextCount) +
                 Int64(typedIrRangeReport.sealedRoundDependencyCount))):
        err = Fmt" compiler csg: bounded typed-ir range accounting mismatch round={st.reachRound} rows={typedIrRangeReport.rowCount}/{expectedRangeRows} committed={typedIrRangeReport.commitRowVisitCount} active={typedIrRangeReport.activeRangeCount} peak={typedIrRangeReport.activeRangePeak} context_build={typedIrRangeReport.contextIndexBuildVisitCount} context_lookup={typedIrRangeReport.contextIndexLookupCount} scope_rescans={typedIrRangeReport.fullSourceScopeRescanCount} line_rescans={typedIrRangeReport.fullSourceLineRescanCount} binding_rescans={typedIrRangeReport.perRowFullSourceBindingRescanCount} sealed={typedIrRangeReport.sealedRoundViewUsed} sealed_contexts={typedIrRangeReport.sealedRoundContextCount} sealed_dependencies={typedIrRangeReport.sealedRoundDependencyCount}"
        st.typedIrErr = typedIrErr
        return false
    let typedIrRoundFactCountForDebug = work.typedIrRoundFacts.count
    let typedIrRoundExprCountForDebug = work.exprLayer.exprs.len
    texpr.TypedExprFactTableReset(work.typedIrRoundFacts)
    st.roundFactsResetCount = st.roundFactsResetCount + 1
    parser.NormalizedExprLayerReset(work.exprLayer)
    CompilerCsgBuildWorkingSetReleaseActiveFunctionSourceSlices(work)
    CompilerCsgReleaseFrontierTypedSourceTexts(
        work.frontierTypedSourceTexts,
        work.frontierTypedSourceTextIndex)
    let _boundedTypedIrRoundRelief = os.ProcessMemoryPressureRelief()
    if !CompilerCsgSemanticCommitTypedIrRoundSemanticConservation(
            work.semanticGraph,
            work.reachableSet,
            round.typedIrRangeFunctionIndexes,
            typedIrFunctionCountBeforeBuild,
            work.typedIr,
            typedIrErr):
        err = share(typedIrErr)
        st.typedIrErr = typedIrErr
        return false
    st.newFunctionCount = st.newFunctionCount + typedIrAppendedFunctionCount
    let typedIrBuildElapsedNs = monotimes.MonoTimeNs(monotimes.GetMonoTime()) - typedIrBuildStartNs
    CompilerCsgDebugLine(Fmt"compiler_csg_typed_ir_after_build functions={work.typedIr.functions2_functionNameIds.len} facts={typedIrRoundFactCountForDebug} expr_count={typedIrRoundExprCountForDebug} reachable_active={st.reachableFilterActive}")
    let _typedIrRoundFactsRelief = os.ProcessMemoryPressureRelief()
    if round.csgReachDebugTarget != "":
        var dbgTypedMatches: int32
        compilerCsgBuildReachDebugTypedRec(
            work, round.csgReachDebugTarget, st.reachRound, 0, dbgTypedMatches)
        os.WriteLine(os.GetStderr(),
                     Fmt"csg_reach_debug typed_summary round={st.reachRound} matches={dbgTypedMatches} functions={work.typedIr.functions2_functionNameIds.len}")
    CompilerCsgTraceStage("after_typed_ir")
    if compilerCsgMemTrace:
        if work.typedIr.arena.capacityBytes > 0:
            let irAfterTag = Fmt"typed_ir_done round={st.reachRound} cap={arenamod.ArenaCapacity(work.typedIr.arena)} used={arenamod.ArenaUsed(work.typedIr.arena)}"
            compilerCsgMemTraceEmit(irAfterTag)
        else:
            compilerCsgMemTraceEmit(Fmt"typed_ir_done round={st.reachRound} cap=0")
        # [S1b-0e / I2] The frontier parsed-source store is released in one
        # batch only after the fixed point, so its capacity is the second
        # long-lived forest candidate.  It must be a measured series per
        # round, otherwise "the wall just moved" cannot be distinguished from
        # "the wall is gone".
        let frontierCapTag = Fmt"frontier_store round={st.reachRound} cap_bytes={CompilerCsgFrontierParsedSourceStoreCapacityBytes(work.frontierParsedSources)} sources={work.frontierParsedSources.fullSourceLayers.len} builds={work.frontierParsedSources.buildCount} hits={work.frontierParsedSources.hitCount}"
        compilerCsgMemTraceEmit(frontierCapTag)
    CompilerCsgMarkProcessedFunctionIndexes(
        work.typedIrProcessedFunctions,
        round.typedIrRangeFunctionIndexes)
    var typedIrRoundNewReachableCount: int32
    if work.reachableSet.active:
        var typedIrReachErr = ""
        CompilerCsgTraceStage("before_typed_ir_reachable_expand")
        let statementCursorBefore = work.typedIrReachStatementCursor
        let functionCursorBefore = work.typedIrReachFunctionCursor
        let reachableBeforeTypedIrExpand = CompilerCsgReachableCount(work.reachableSet)
        if !CompilerCsgReachableExpandFromExactTypedIr(
                work.reachableSet,
                work.typedIr,
                work.parserNormalizedExprReceiptAccumulator,
                typedIrFunctionCountBeforeBuild,
                round.typedIrRangeFunctionIndexes,
                work.typedIrReachStatementCursor,
                work.typedIrReachFunctionCursor,
                typedIrReachErr):
            if typedIrReachErr != "":
                err = typedIrReachErr
                st.typedIrErr = typedIrErr
                return false
            err = " compiler csg: typed ir reachable expand failed"
            st.typedIrErr = typedIrErr
            return false
        let reachableAfterTypedIrExpand = CompilerCsgReachableCount(work.reachableSet)
        if reachableAfterTypedIrExpand < reachableBeforeTypedIrExpand:
            err = " compiler csg: typed ir reachable count regressed"
            st.typedIrErr = typedIrErr
            return false
        st.reachabilityNewReachableFunctionCount =
            st.reachabilityNewReachableFunctionCount +
            (reachableAfterTypedIrExpand - reachableBeforeTypedIrExpand)
        st.reachabilityScannedStatementCount =
            st.reachabilityScannedStatementCount +
            (work.typedIrReachStatementCursor - statementCursorBefore)
        st.reachabilityScannedFunctionCount =
            st.reachabilityScannedFunctionCount +
            (work.typedIrReachFunctionCursor - functionCursorBefore)
        CompilerCsgTraceStage("after_typed_ir_reachable_expand")
    let reachableAfterRound = CompilerCsgReachableCount(work.reachableSet)
    typedIrRoundNewReachableCount =
        reachableAfterRound - round.reachableBeforeRound
    if typedIrRoundNewReachableCount < 0:
        typedIrRoundNewReachableCount = 0
    var typedIrCandidateCount = work.reachableSet.functionNames.len
    if work.reachableSet.active:
        typedIrCandidateCount = work.reachableSet.reachableQueue.len
    st.reachStable = work.typedIrReachableCursor >= typedIrCandidateCount
    # PhaseArena CSG 字符串半片: 数字直接格式化进轮次文本 arena,
    # 不再产生逐轮注册的 managed 临时字符串。
    CompilerCsgPhaseArenaRoundTextAppendMs(work, typedIrBuildElapsedNs)
    CompilerCsgPhaseArenaRoundTextAppendCount(work,
                                              CompilerCsgRoundTextPartNewReachable,
                                              typedIrRoundNewReachableCount)
    CompilerCsgPhaseArenaRoundTextAppendCount(work,
                                              CompilerCsgRoundTextPartBuildCount,
                                              typedIrAppendedFunctionCount)
    st.reachRound = st.reachRound + 1
    st.typedIrErr = typedIrErr
    return true

@borrows
fn compilerCsgBuildTypedIrReachRound(
        work: var CompilerCsgBuildWorkingSet,
        st: var compilerCsgTypedIrReachState,
        err: var str): bool =
    var round: compilerCsgTypedIrReachRoundState
    if !compilerCsgBuildTypedIrReachRoundPrepare(
            work, st, round, err):
        return false
    if st.reachStable:
        return true
    return compilerCsgBuildTypedIrReachRoundCommit(
        work, st, round, err)

fn compilerCsgBuildTypedIrReach(
        work: var CompilerCsgBuildWorkingSet,
        st: var compilerCsgTypedIrReachState,
        err: var str): bool =
    while !st.reachStable:
        if !compilerCsgBuildTypedIrReachRound(work, st, err):
            return false
    return true

fn compilerCsgBuildConsumeWithOverridesCoreInto(
        out: var CompilerCsg,
        err: var str,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceBundleOwner: var slplan.SystemLinkPlanSourceBundleOwner,
        sourceBundleCid: layout.FixedBytes32,
        sourceReceipt: var PortableSourceIdentityReceipt,
        requirePortableReceipt: bool,
        entryPathOverride: str,
        entryTextOverride: str,
        sourceTextOverrides: var CompilerCsgSourceText[],
        buildFragmentLifetimeReceipt:
            var buildlife.CompilerCsgBuildFragmentLifetimeReceipt): bool =
    err = ""
    var priorDiagnosticFailureReleaseReceipt: diagnostic_failure.DiagnosticFailureArtifactReleaseReceipt
    diagnostic_failure.DiagnosticFailureArtifactReleaseInto(
        out.diagnosticFailureArtifact,
        priorDiagnosticFailureReleaseReceipt)
    var priorDiagnosticAuthorityReleaseReceipt: diagnostic_authority.ParserDiagnosticAuthorityReleaseReceipt
    diagnostic_authority.ParserDiagnosticAuthorityReleaseInto(
        out.diagnosticFailureAuthority,
        priorDiagnosticAuthorityReleaseReceipt)
    freeSeq(out.diagnosticFailureProducerProjectionCids)
    CompilerCsgRefreshMemoryLedger(out)
    CompilerCsgTraceStage("enter")
    var work: CompilerCsgBuildWorkingSet
    buildlife.CompilerCsgBuildFragmentLifetimeBegin(
        work.buildFragmentLifetime)
    let emptyPendingTransitionReceipt =
        CompilerCsgTransitionReceipt()
    var pendingTransitionReceipt =
        emptyPendingTransitionReceipt
    defer:
        if work.buildFragmentLifetime.active:
            CompilerCsgBuildWorkingSetReleaseWithOutcome(
                work,
                payloadlife.CompilerPayloadOutcomeDiagnostic,
                buildFragmentLifetimeReceipt)
        if !buildlife.CompilerCsgBuildFragmentLifetimeReceiptClosed(
               buildFragmentLifetimeReceipt):
            panic("compiler csg: deferred build fragment lifetime receipt unavailable")
    var ownershipLease: CompilerCsgLinkPlanOwnershipLease
    if requirePortableReceipt &&
       !PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt, err):
        return CompilerCsgBuildAbort(work)
    var migrationSourceSyntax = false
    if linkPlan.parserSyntaxTag == "cheng.migration_source":
        migrationSourceSyntax = true
    elif linkPlan.parserSyntaxTag != "cheng_normalized_source":
        err = Fmt" compiler csg: unsupported sealed parser syntax tag={linkPlan.parserSyntaxTag}"
        return CompilerCsgBuildAbort(work)
    if slplan.SystemLinkPlanSourceBundleOwnerMoved(sourceBundleOwner):
        err = " compiler csg: source bundle destination already owns payload"
        return CompilerCsgBuildAbort(work)
    let portableOverrideBinding = requirePortableReceipt &&
        (sourceTextOverrides.len > 0 || entryTextOverride != "")
    if !CompilerCsgLinkPlanOwnershipLeaseBegin(
            linkPlan,
            portableOverrideBinding,
            ownershipLease,
            err):
        return CompilerCsgBuildAbort(work)
    if !layout.FixedBytes32Equal(sourceBundleCid,
                                 linkPlan.sourceBundleCidValue):
        err = " compiler csg: independent source bundle cid disagrees with sealed link-plan binding"
        return CompilerCsgBuildAbort(work)
    let typedExprMode = os.GetEnv("CHENG_TYPED_EXPR_MODE")
    if typedExprMode == "fast":
        err = " compiler csg: CHENG_TYPED_EXPR_MODE=fast cannot satisfy frozen metadata session authority"
        return CompilerCsgBuildAbort(work)
    if typedExprMode == "skip_build":
        err = " compiler csg: CHENG_TYPED_EXPR_MODE=skip_build cannot produce certified TypedIR"
        return CompilerCsgBuildAbort(work)
    if typedExprMode != "":
        err = Fmt" compiler csg: unsupported CHENG_TYPED_EXPR_MODE mode={typedExprMode}"
        return CompilerCsgBuildAbort(work)
    var typedIrBatchFunctionLimit: int32
    if !CompilerCsgReadTypedIrBatchLimit(typedIrBatchFunctionLimit, err):
        return CompilerCsgBuildAbort(work)
    let csgPhaseEnterNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let compilerCsgDebugStderr = CompilerCsgDebugStderr()
    work.externalPackageRoots = linkPlan.externalPackageRoots
    CompilerCsgTraceStage("after_external_package_roots")
    let stableWorkspaceRoot = linkPlan.workspaceRoot
    let stablePackageRoot = linkPlan.packageRoot
    let orderedSourceIndex =
        CompilerCsgSourcePathIndexInit(
            linkPlan.sourceClosurePaths.len * 2 + 8)
    work.orderedSourceIndex = orderedSourceIndex
    CompilerCsgSourcePathIndexSealClosure(work.orderedSourceIndex, linkPlan.sourceClosurePaths)
    if !CompilerCsgSourcePathIndexConfigureRoots(work.orderedSourceIndex,
                                                 stableWorkspaceRoot,
                                                 stablePackageRoot,
                                                 work.externalPackageRoots,
                                                 err):
        return CompilerCsgBuildAbort(work)
    let sourceTextLookupIndex =
        CompilerCsgSourcePathIndexInitLike(
            work.orderedSourceIndex,
            sourceTextOverrides.len * 2 + 8)
    work.sourceTextLookupIndex = sourceTextLookupIndex
    let sourceTextCacheIndex =
        CompilerCsgSourcePathIndexInitLike(
            work.orderedSourceIndex,
            linkPlan.sourceClosurePaths.len * 2 + 8)
    work.sourceTextCacheIndex = sourceTextCacheIndex
    let sealedEntrySourceIndex = linkPlan.sourceBundleEntrySourceIndex
    # str[] element reads are Borrowed views (spec 0.2.1); this value flows
    # into non-var formals below, so materialize an owned copy.  Without the
    # clone the let stays a reborrow and the downstream call is rejected as
    # [borrowed actual cannot bind non-var non-@borrows formal].
    let stableEntryPath = strings.CloneStr(
        linkPlan.sourceClosurePaths[sealedEntrySourceIndex])
    let stableEntryModulePath = linkPlan.ownerModulePaths[sealedEntrySourceIndex]
    if requirePortableReceipt:
        var planImportGraphCid: layout.FixedBytes32
        if sourceReceipt.sourceSnapshotCount !=
               linkPlan.sourceClosurePaths.len ||
           sourceReceipt.importEdgeCount != linkPlan.importEdges.len ||
           sourceReceipt.importEdgeCount != linkPlan.importEdgeCount ||
           sourceReceipt.unresolvedImportCount !=
               linkPlan.unresolvedImportCount ||
           !layout.FixedBytes32Equal(
               sourceReceipt.sourcePackageIdCid,
               CompilerCsgPortableSourcePackageIdCid(linkPlan.packageId)) ||
           !layout.FixedBytes32Equal(
               sourceReceipt.entryModulePathCid,
               CompilerCsgPortableEntryModulePathCid(
                   stableEntryModulePath)) ||
           !layout.FixedBytes32Equal(sourceReceipt.sourceBundleCid,
                                     sourceBundleCid):
            err = " compiler csg: portable source receipt disagrees with sealed link-plan identity"
            return CompilerCsgBuildAbort(work)
        if !cworld.CompilerWorldPortableImportGraphCidInto(
                linkPlan.packageId,
                linkPlan.importEdges,
                linkPlan.unresolvedImportCount,
                planImportGraphCid,
                err):
            return CompilerCsgBuildAbort(work)
        if !layout.FixedBytes32Equal(sourceReceipt.importGraphCid,
                                     planImportGraphCid):
            err = " compiler csg: portable source receipt import graph cid disagrees with sealed link-plan"
            return CompilerCsgBuildAbort(work)
    if entryTextOverride != "" && entryPathOverride == "":
        err = " compiler csg: entry text override requires the sealed entry path"
        return CompilerCsgBuildAbort(work)
    if entryPathOverride != "":
        var canonicalEntryPath: str
        if !CompilerCsgSourcePathIndexCanonicalKey(work.orderedSourceIndex,
                                                    entryPathOverride,
                                                    canonicalEntryPath,
                                                    err):
            return CompilerCsgBuildAbort(work)
        if canonicalEntryPath != stableEntryPath:
            err = Fmt" compiler csg: entry override disagrees with sealed entry identity sealed={stableEntryPath} override={canonicalEntryPath}"
            return CompilerCsgBuildAbort(work)
    if !CompilerCsgSourceTextLookupBuild(sourceTextOverrides,
                                         stableEntryPath,
                                         entryTextOverride,
                                         work.externalPackageRoots,
                                         linkPlan.sourceClosurePaths,
                                         linkPlan.ownerModulePaths,
                                         work.sourceTextLookupIndex,
                                         work.sourceTextLookup,
                                         err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgTraceStage("after_source_text_lookup")
    var bindingSourceTexts: str[]
    if !compilerCsgBuildBindingSourceTextsRec(
           work,
           linkPlan,
           bindingSourceTexts,
           0,
           err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgTraceStage("after_binding_source_texts")
    var rebuiltBindingImportEdges: parser.ImportEdge[]
    var rebuiltBindingUnresolvedImportCount: int32
    if !slplan.SystemLinkPlanRebuildImportEdgesFromTextsInto(
            stableWorkspaceRoot,
            stablePackageRoot,
            linkPlan.packageId,
            work.externalPackageRoots,
            linkPlan.sourceClosurePaths,
            linkPlan.ownerModulePaths,
            bindingSourceTexts,
            linkPlan.sourceBundleEntrySourceIndex,
            rebuiltBindingImportEdges,
            rebuiltBindingUnresolvedImportCount,
            err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgTraceStage("after_binding_import_rebuild")
    if rebuiltBindingUnresolvedImportCount !=
       linkPlan.unresolvedImportCount ||
       rebuiltBindingImportEdges.len != linkPlan.importEdges.len:
        err = Fmt" compiler csg: sealed import graph differs from immutable source snapshot edges={linkPlan.importEdges.len}/{rebuiltBindingImportEdges.len} unresolved={linkPlan.unresolvedImportCount}/{rebuiltBindingUnresolvedImportCount}"
        return CompilerCsgBuildAbort(work)
    if !compilerCsgBuildBindingImportEdgesEqualRec(
           rebuiltBindingImportEdges, linkPlan, 0, err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgTraceStage("after_binding_import_compare")
    if portableOverrideBinding:
        if !CompilerCsgPortableOverrideBindingValidateInto(
                linkPlan,
                bindingSourceTexts,
                rebuiltBindingImportEdges,
                err) ||
           !CompilerCsgLinkPlanOwnershipLeaseBegin(
                linkPlan,
                true,
                ownershipLease,
                err):
            return CompilerCsgBuildAbort(work)
    CompilerCsgTraceStage("after_portable_binding_validation")
    clear(bindingSourceTexts)
    CompilerCsgTraceStage("after_binding_source_text_release")
    var canonicalImportEdges: parser.ImportEdge[]
    var linkPlanImportTargetIndex = CompilerCsgSourcePathIndexInitLike(work.orderedSourceIndex,
                                                                      linkPlan.importEdges.len * 2 + 8)
    if !compilerCsgBuildCanonicalImportEdgesRec(
           linkPlan,
           linkPlanImportTargetIndex,
           canonicalImportEdges,
           0,
           err):
        return CompilerCsgBuildAbort(work)
    let moduleSeen = CompilerCsgTextSetInit(
        linkPlan.ownerModulePaths.len +
        canonicalImportEdges.len * 2 + 8)
    work.moduleSeen = moduleSeen
    let importPairSeen = CompilerCsgImportPairLookupInit(
        canonicalImportEdges.len * 2 + 8)
    work.importPairSeen = importPairSeen
    if !compilerCsgBuildCollectModulesRec(
           work, linkPlan, canonicalImportEdges, 0, 0, 0, err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgAddUniqueFast(work.modules,
                             work.moduleSeen,
                             stableEntryModulePath)
    CompilerCsgTraceStage("before_sort_modules")
    CompilerCsgSortStrs(work.modules)
    CompilerCsgSortImportPairs(work.importPairs)
    CompilerCsgTraceStage("after_sort_modules")
    var sourceTextCapturedBytes: int64
    let reuseLinkPlanExprLayer = linkPlan.exprLayer.sourceCount > 0 || linkPlan.exprLayer.exprs.len > 0
    let emptyExprLayer = parser.NormalizedExprLayer()
    work.exprLayer = emptyExprLayer
    work.packageNode.nodeId = work.nodes.len + 1
    work.packageNode.nodeKind = CompilerCsgNodeKindPackage
    work.packageNode.ownerNodeId = 0
    work.packageNode.modulePath = ""
    work.packageNode.symbolText = ""
    work.packageNode.factText = linkPlan.packageId
    work.packageNode.resultLayoutKind = 0
    work.packageNode.effectKind = 0
    work.packageNode.capabilityKind = 0
    work.packageNode.callConv = 0
    work.packageNode.entryFlag = 0
    work.packageNode.exportedFlag = 0
    work.packageNode.exportSymbolName = ""
    let packageFactCid =
        CompilerCsgHashNodeRecord(work.packageNode)
    work.packageNode.factCid = packageFactCid
    add(work.nodes, share(work.packageNode))
    let packageNodeId = work.packageNode.nodeId
    CompilerCsgTraceStage("after_package_node")
    compilerCsgBuildModuleNodesRec(work, packageNodeId, 0)
    CompilerCsgTraceStage("after_module_nodes")
    if !compilerCsgBuildImportPairEdgesRec(work, 0, err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgTraceStage("after_import_edges")
    let semanticGraph = CompilerCsgSemanticInit()
    work.semanticGraph = semanticGraph
    var typedIrExprCountCursor: int32
    var sourceSnapshotCaptureErr: str
    # The sealed closure/owner columns are the sole source-identity authority.
    # Text overrides can replace bytes only; they cannot select sources or owners.
    if !compilerCsgBuildOrderedSourcesRec(
           work, linkPlan, 0, sourceSnapshotCaptureErr):
        return CompilerCsgBuildSnapshotAbort(work, err, sourceSnapshotCaptureErr)
    CompilerCsgTraceStage("before_sort_sources")
    CompilerCsgSortSourcePathModulePairs(work.orderedSources, work.orderedSourceModules)
    CompilerCsgSourcePathIndexClear(work.orderedSourceIndex)
    let canonicalOrderedSourceIndex =
        CompilerCsgSourcePathIndexInitLike(
            work.sourceTextLookupIndex,
            work.orderedSources.len * 2 + 8)
    work.orderedSourceIndex = canonicalOrderedSourceIndex
    if !compilerCsgBuildRegisterOrderedSourcesRec(
           work, 0, sourceSnapshotCaptureErr):
        return CompilerCsgBuildSnapshotAbort(work, err, sourceSnapshotCaptureErr)
    CompilerCsgTraceStage("after_sort_sources")
    let sourceSnapshotIndex =
        CompilerCsgSourcePathIndexInitLike(
            work.orderedSourceIndex,
            work.orderedSources.len * 2 + 8)
    work.sourceSnapshotIndex = sourceSnapshotIndex
    # [M3-D6] Measure every source's exact arena need while the floor is at
    # its post-sort minimum, before any other phase grows it.  The text comes
    # from the pre-warmed source text cache (the binding loop filled it; the
    # profiles loop's snapshot capture consumes the same bytes), and pass 0
    # consumes the measures as its reserve, reproducing them byte for byte
    # (the determinism gate there proves the reserve in vivo).
    var typeDeclarationIndex: typearena.TypedExprTypeDeclarationIndex
    # [D6v2] The measure channel is the only parse: it now also produces the
    # sealed declaration index and the per-column census from the same
    # per-source tree.  Diagnostic arm: its products go to scratch and pass
    # 0 parses as before into the live structures; the driver compares the
    # two family by family after the pass-0 seal (harvest identity verdict).
    var d6v2DiagIndex: typearena.TypedExprTypeDeclarationIndex
    var d6v2DiagCensus: int32[]
    if compilerCsgD6v2HarvestDiag:
        if !CompilerCsgMeasureSourceArenaReservesInto(
               work.sourceTextLookup,
               work.sourceTextLookupIndex,
               work.sourceTextCache,
               work.sourceTextCacheIndex,
               work.orderedSources,
               migrationSourceSyntax,
               work.typeArenaForestSourceArenaReserveMeasures,
               d6v2DiagIndex,
               d6v2DiagCensus,
               err):
            return CompilerCsgBuildAbort(work)
    else:
        if !CompilerCsgMeasureSourceArenaReservesInto(
               work.sourceTextLookup,
               work.sourceTextLookupIndex,
               work.sourceTextCache,
               work.sourceTextCacheIndex,
               work.orderedSources,
               migrationSourceSyntax,
               work.typeArenaForestSourceArenaReserveMeasures,
               typeDeclarationIndex,
               work.typeArenaForestSourceColumnCensus,
               err):
            return CompilerCsgBuildAbort(work)
    # PhaseArena CSG 文本族半片 (七条②): 行表 intern 池 + ID 列 store 随
    # profile 相位开启 (此时 sourceTextCache 已被 binding loop 全量预热,
    # 换行计数可得)。
    CompilerCsgLineArenaInitInto(work)
    if !compilerCsgBuildOrderedSourceProfilesRec(
           work,
           linkPlan,
           packageNodeId,
           0,
           requirePortableReceipt,
           migrationSourceSyntax,
           stableWorkspaceRoot,
           stablePackageRoot,
           stableEntryPath,
           sourceTextCapturedBytes,
           sourceSnapshotCaptureErr):
        return CompilerCsgBuildSnapshotAbort(work, err, sourceSnapshotCaptureErr)
    var entrySourceCid: layout.FixedBytes32
    if !CompilerCsgVerifyImmutableSourceIdentity(linkPlan.packageId,
                                                  stableEntryPath,
                                                  linkPlan.sourceClosurePaths,
                                                  linkPlan.sourceBundleIdentityPaths,
                                                  linkPlan.ownerModulePaths,
                                                  sourceBundleCid,
                                                  work.sourceSnapshots,
                                                  work.sourceSnapshotIndex,
                                                  entrySourceCid,
                                                  sourceSnapshotCaptureErr):
        return CompilerCsgBuildSnapshotAbort(work, err, sourceSnapshotCaptureErr)
    let sourceSnapshotCount = work.sourceSnapshots.len
    if requirePortableReceipt &&
       (sourceReceipt.sourceSnapshotCount != sourceSnapshotCount ||
        !layout.FixedBytes32Equal(sourceReceipt.entrySourceCid,
                                  entrySourceCid)):
        err = Fmt" compiler csg: portable source receipt snapshot binding mismatch snapshots={sourceReceipt.sourceSnapshotCount}/{sourceSnapshotCount}"
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgBuildTypedSourceTextIndex(work.sourceSnapshots,
                                             work.sourceSnapshotIndex,
                                             work.typedSourceTexts,
                                             work.typedSourceTextIndex,
                                             sourceSnapshotCaptureErr):
        return CompilerCsgBuildSnapshotAbort(work, err, sourceSnapshotCaptureErr)
    CompilerCsgReleaseSourceTextLookupEntries(work.sourceTextCache)
    CompilerCsgReleaseSourceTextLookupEntries(work.sourceTextLookup)
    CompilerCsgSourcePathIndexClear(work.sourceTextCacheIndex)
    CompilerCsgSourcePathIndexClear(work.sourceTextLookupIndex)
    let _sourceTextCacheRelief = os.ProcessMemoryPressureRelief()
    CompilerCsgTraceStage("after_profiles")
    let csgPhaseAfterA1Ns = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    var debugFirstOrderedSource = ""
    var debugFirstOrderedModule = ""
    if work.orderedSources.len > 0:
        debugFirstOrderedSource = work.orderedSources[0]
        debugFirstOrderedModule = work.orderedSourceModules[0]
    var debugFirstModule = ""
    if work.modules.len > 0:
        debugFirstModule = work.modules[0]
    var debugMaskOneTotal: int32
    var debugMaskZeroTotal: int32
    compilerCsgBuildDebugMaskTotalsRec(
        work.profileImportcMasks, 0, debugMaskOneTotal, debugMaskZeroTotal)
    work.profileImportcMasks = []
    let _profileRelief = os.ProcessMemoryPressureRelief()
    if !CompilerCsgResolveCollectedProfileImportEdges(work.exprCallProfiles,
                                                      work.sourceSnapshotIndex,
                                                      err):
        return CompilerCsgBuildAbort(work)
    if compilerCsgMemTrace:
        compilerCsgMemTraceEmit("import_edges_resolved")
    let profileIndexLookup =
        parser.ParserSourcePathIndexLookupBuild(work.exprCallProfiles)
    work.profileIndexLookup = profileIndexLookup
    # Import resolution changes the authoritative profile graph. Build metadata
    # exactly once from that graph so pre-resolution contexts never raise RSS.
    # [MEM-EXACT] 行池哈希索引在 profiles 相后再无 Intern/FindInternId 读者
    # (metadata/reachable 只按 InternId 直查 texts); 提前归还索引存储.
    # texts 槽数组同步压到唯一行数精确容量, 避免 add() 几何增长的余量
    # 在整个 metadata 相滞留.
    if work.lineInternPoolActive:
        langintern.InternPoolShrinkTextStorage(work.lineInternPool)
        langintern.InternPoolReleaseIndexStorage(work.lineInternPool)
        let _linePoolShrinkRelief = os.ProcessMemoryPressureRelief()
    var reachableErr = ""
    # Function-level edge-scan bookkeeping persists across the typed facts /
    # typed-IR reachability rounds below, so profiles are re-scanned only for
    # functions that became reachable after their file's earlier scan.
    CompilerCsgTraceStage("before_reachable_function_set")
    if !CompilerCsgBuildReachableFunctionSet(linkPlan,
                                             stableEntryPath,
                                             work.sourceSnapshots,
                                             work.sourceSnapshotIndex,
                                             work.exprCallProfiles,
                                             work.orderedSourceModules,
                                             work.profileLineCounts,
                                             work.lineStore,
                                             work.lineArena,
                                             work.lineInternPool,
                                             work.profileLineIdColumns,
                                             work.profileLineIdCounts,
                                             work.profileIndexLookup,
                                             work.profileCallLookupCache,
                                             work.reachableSet,
                                             work.reachScanProcessedFunctions,
                                             work.reachScanLocalScannedProfiles,
                                             work.reachScanReachableCursor,
                                             work.reachScanQueuedProfiles,
                                             work.reachScanPendingProfiles,
                                             reachableErr):
        if reachableErr != "":
            err = reachableErr
            return CompilerCsgBuildAbort(work)
        err = " compiler csg: reachable function set failed"
        return CompilerCsgBuildAbort(work)
    # PhaseArena CSG 半片 (七条②): graphNodeId 列的托管权威随 reachable-set
    # 相位开启 —— 精确容量 functionCount*4B (零高估零遗弃), 阶段末
    # (prune 后) 整批 reset。
    phase.PhaseArenaStoreInit(work.graphNodeStore,
                              1,
                              CompilerCsgPhaseArenaI32CapacityBytes(
                                  work.reachableSet.functionNames.len),
                              1)
    buildlife.CompilerCsgBuildFragmentLifetimeStoreBegin(
        work.buildFragmentLifetime,
        work.graphNodeStoreLifetimeSlot,
        buildlife.CompilerCsgBuildFragmentGraphNodeStore,
        phase.PhaseArenaStoreRetainedBytes(work.graphNodeStore),
        phase.PhaseArenaStorePhysicalBufferCount(work.graphNodeStore))
    let graphNodeArena =
        phase.PhaseArenaStoreOpenArena(
            work.graphNodeStore,
            1,
            CompilerCsgPhaseArenaI32CapacityBytes(
                work.reachableSet.functionNames.len),
            1)
    work.graphNodeArena = graphNodeArena
    work.graphNodeStoreActive = true
    let functionGraphNodes =
        CompilerCsgFunctionGraphNodeColumnInit(
            work.graphNodeStore,
            work.graphNodeArena,
            work.reachableSet.functionNames.len)
    work.functionGraphNodes = functionGraphNodes
    let functionSemanticIdentityIndex =
        CompilerCsgSemanticIdentityIndexInit(
            work.reachableSet.functionNames.len)
    work.functionSemanticIdentityIndex =
        functionSemanticIdentityIndex
    work.functionSemanticIdentityIndexOwned = true
    # Reachability keeps only the compact function/edge set. Its profile scans
    # allocate large transient line and lookup buffers, so return those pages at
    # the phase boundary before source-slice facts start.
    let _reachableSetRelief = os.ProcessMemoryPressureRelief()
    # r91 queue-seeding: the typed-IR fixed point discovers callees only from
    # freshly built IR (about one hop per round), so deep call chains converge
    # in O(N) rounds. Seed the work queue with the full function table in
    # index order through the standard certificate path before the fixed point
    # starts. Seeding marks every row reachable exactly like the obj
    # no-export-roots full-build path (CompilerCsgReachableMark), so the
    # committed-graph queue invariants (queue.len == reachableCount, every
    # queued row flagged) and the sealed facts batch selection gate stay
    # intact; expand still derives every call edge from exact IR.
    if work.reachableSet.active:
        var seedFrontier: int32[]
        for seedIndex in 0..<work.reachableSet.functionNames.len:
            CompilerCsgReachableMark(work.reachableSet, seedIndex, seedFrontier)
    if compilerCsgDebugStderr:
        CompilerCsgDebugLine(Fmt"compiler_csg_reachable_live function_count={work.reachableSet.functionNames.len} edge_count={work.reachableSet.edgeFrom.len} profile_count={work.reachableSet.profileFunctionStarts.len} queued_function_count={work.reachableSet.reachableQueue.len} profile_call_cache_count={work.profileCallLookupCache.entries.len} processed_function_count={work.reachScanProcessedFunctions.len} local_scanned_profile_count={work.reachScanLocalScannedProfiles.len} rss_bytes={os.ProcessRssBytes()}")
    CompilerCsgTraceStage("after_reachable_function_set")
    # [t4-line] Segment clock: sub-step timing for the profile payload release
    # segment; armed only by CHENG_CSG_T4_TIME=1.
    var t4StepNs: int64
    var t4SegNs: int64
    if compilerCsgT4TimeTrace:
        t4SegNs = compilerCsgT4NowNs()
        t4StepNs = t4SegNs
    if !CompilerCsgSemanticBuildSourceDeclImportTables(work.semanticGraph,
                                                 work.orderedSources,
                                                 work.orderedSourceModules,
                                                 work.exprCallProfiles,
                                                 work.orderedSourceIndex,
                                                 err):
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgSemanticBuildReachableTable(work.semanticGraph,
                                         work.orderedSources,
                                         work.reachableSet,
                                         work.orderedSourceIndex,
                                         err):
        return CompilerCsgBuildAbort(work)
    # [M3-E] The metadata-context section moved below, to sit between the
    # forest measurement pass (pass 0) and the streaming pass.  Pass 0 reads
    # none of this section's outputs and this section reads none of pass 0's,
    # so the swap is order-only; the metadata-context residency no longer
    # rides the pass-0 window, whose per-source arena spike is the M3 kill
    # point (.rebuild/m3attrib_line/M3_ATTRIB.md).
    if compilerCsgMemTrace:
        if compilerCsgD6v2HarvestDiag:
            if reuseLinkPlanExprLayer:
                compilerCsgMemTraceEmit("forest_build_start mode=clone")
            else:
                compilerCsgMemTraceEmit("forest_build_start mode=reparse")
        else:
            # [D6v2] The default arm re-parses nothing here: the measure
            # channel was the parse.  The section marker stays greppable
            # with an honest mode name.
            compilerCsgMemTraceEmit("forest_build_start mode=harvest")
    # [D6v2] Default arm: pass 0 is a pure reader over the measure channel's
    # harvest (the former parse block lives on as the diagnostic arm below,
    # which is the identity instrument).  Both arms feed the same
    # downstream contract: sealed index + per-source bytes + per-column
    # census.
    if compilerCsgD6v2HarvestDiag:
        if !CompilerCsgBuildParserForestAuthorityInto(
                linkPlan.exprLayer.valueExprTree,
                reuseLinkPlanExprLayer,
                work.sourceSnapshots,
                work.sourceSnapshotIndex,
                work.orderedSources,
                work.exprCallProfiles,
                typeDeclarationIndex,
                work.typeArenaForestSourceArenaBytes,
                work.typeArenaForestSourceColumnCensus,
                work.typeArenaForestSourceArenaReserveMeasures,
                err):
            return CompilerCsgBuildAbort(work)
        if !CompilerCsgD6v2HarvestIdentityInto(
               d6v2DiagIndex,
               d6v2DiagCensus,
               typeDeclarationIndex,
               work.typeArenaForestSourceColumnCensus,
               err):
            return CompilerCsgBuildAbort(work)
        if compilerCsgMemTrace:
            compilerCsgMemTraceEmit("d6v2_harvest_identity_ok")
    else:
        if !CompilerCsgHarvestParserForestAuthorityFromMeasuresInto(
               work.orderedSources,
               typeDeclarationIndex,
               work.typeArenaForestSourceArenaBytes,
               work.typeArenaForestSourceColumnCensus,
               work.typeArenaForestSourceArenaReserveMeasures,
               err):
            return CompilerCsgBuildAbort(work)
