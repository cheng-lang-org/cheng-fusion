var compilerCsgTraceInitialized: bool
var compilerCsgTraceStderr: bool
var compilerCsgTraceOutPath: str
var compilerCsgTraceSinglePath: str
var compilerCsgMemTrace: bool
var compilerNominalSweep: bool
# [D6v2] Harvest-identity diagnostic arm: the measure channel builds the
# declaration index and column census into scratch, pass 0 parses as before
# into the live structures, and the driver compares the two family by family
# after the pass-0 seal.  Unset environment -> default arm (pass 0 is a pure
# reader over the measure channel's harvest).
var compilerCsgD6v2HarvestDiag: bool
# [merge-release] Pass-1 release readback and its gated detach.  Both are armed
# once by CompilerCsgTraceInit, the same latch idiom as compilerCsgMemTrace, so
# an unset environment leaves the default path byte-for-byte what it was.
var compilerCsgMergeReleaseTrace: bool
var compilerCsgMergeReleaseDetachOff: bool
# [merge-arena] Arm the single-size per-source arena reserve (see the fix note
# in the merge loop).  Off by default until the A/B in one window says it wins.
var compilerCsgMergeFixedArenaReserve: bool
# [c-line retain-ledger] Streaming-merge retention accumulators, one pair per
# segment boundary the merge loop already walks (parse / authority / ta append
# / build index / release / rewrite) plus the forward-replay segment.  Filled
# only while compilerCsgMemTrace is armed (same one-time GetEnv latch as every
# other trace here): the reads are the same two counters the gated
# merge_stage lines print, so an unset environment stays zero-output and
# counter-free.  The driver's phase memory ledger reads the totals through
# CompilerCsgPhaseMemoryRetainTopContributors.
var compilerCsgRetainParseBlocks: int64
var compilerCsgRetainParseBytes: int64
var compilerCsgRetainAuthorityBlocks: int64
var compilerCsgRetainAuthorityBytes: int64
var compilerCsgRetainTaAppendBlocks: int64
var compilerCsgRetainTaAppendBytes: int64
var compilerCsgRetainBuildIndexBlocks: int64
var compilerCsgRetainBuildIndexBytes: int64
var compilerCsgRetainReleaseBlocks: int64
var compilerCsgRetainReleaseBytes: int64
var compilerCsgRetainRewriteBlocks: int64
var compilerCsgRetainRewriteBytes: int64
var compilerCsgRetainReplaySources: int32
var compilerCsgRetainReplayBlocks: int64
var compilerCsgRetainReplayBytes: int64
# [c2-line] Tree-read vs column-read equality diagnosis for the forward
# replay.  Armed by CHENG_TA_REPLAY_COL_DIAG=1; unset stays zero-output and
# zero-count, and the default replay path keeps reading the tree.
var compilerCsgReplayColDiag: bool
var compilerCsgReplayColDiagChecked: int64
var compilerCsgReplayColDiagMismatch: int64
# [c2-line] Two-arm replay_tid probe (CHENG_TA_REPLAY_TID_TRACE=1): every
# replayed source prints one replay_tid line per originally-flagged row, from
# BOTH arms.  The two runs' streams must be identical line for line; the first
# diverging row names where the tree walk and the column walk disagree.
var compilerCsgReplayTidTrace: bool
var compilerCsgRetainSources: int32
# [rss-guard-hf] High-frequency guard sampling latch (47d0412a3 uses it at
# TraceInit :1660/:1662 and the merge loop :34191); declaration was missing
# from that commit, which broke bootstrap for every driver lane.
var compilerCsgRssGuardHf: bool

# [orcd9-inst] ORCM@13 悬挂块定谳轮窗标门（env=CHENG_ORCD8_TRACE，默认零输出零行为差）
var compilerCsgOrcd9TraceArmed: bool
var compilerCsgOrcd9TraceChecked: bool

fn compilerCsgOrcd9TraceEnabled(): bool =
    if !compilerCsgOrcd9TraceChecked:
        compilerCsgOrcd9TraceChecked = true
        compilerCsgOrcd9TraceArmed = os.GetEnv("CHENG_ORCD8_TRACE") != ""
    return compilerCsgOrcd9TraceArmed

fn CompilerCsgTraceInit() =
    if compilerCsgTraceInitialized:
        return
    compilerCsgTraceInitialized = true
    compilerCsgTraceStderr = os.GetEnv("CHENG_COMPILER_CSG_STDERR") == "1"
    compilerCsgTraceOutPath = strutil.Strip(os.GetEnv("CHENG_COMPILER_CSG_TRACE_OUT"))
    compilerCsgTraceSinglePath = strutil.Strip(os.GetEnv("CHENG_COMPILER_CSG_TRACE"))
    compilerCsgRssGuardHf = false
    compilerCsgMemTrace = os.GetEnv("CHENG_CSG_MEM_TRACE") == "1"
    compilerCsgRssGuardHf = os.GetEnv("CHENG_RSS_GUARD_HF") == "1"
    compilerCsgReplayColDiag = os.GetEnv("CHENG_TA_REPLAY_COL_DIAG") == "1"
    compilerCsgReplayTidTrace = os.GetEnv("CHENG_TA_REPLAY_TID_TRACE") == "1"
    # [nominal-sweep] One-time read, the same shape as `compilerCsgMemTrace`
    # above: the flag is the module `var` every consumer tests, never a fresh
    # `GetEnv` at a call site.
    compilerNominalSweep = os.GetEnv("CHENG_NOMINAL_SWEEP") == "1"
    # [D6v2] One-time read, the same latch idiom as every probe flag above.
    compilerCsgD6v2HarvestDiag = os.GetEnv("CHENG_D6V2_HARVEST_DIAG") == "1"
    compilerCsgMergeReleaseTrace = os.GetEnv("CHENG_MERGE_RELEASE_TRACE") == "1"
    compilerCsgMergeFixedArenaReserve =
        os.GetEnv("CHENG_MERGE_FIXED_ARENA_RESERVE") == "1"
    # Kill switch only.  The detach is the default path; the environment can
    # turn it back off so the pre-fix behaviour stays reproducible in the same
    # process window instead of across two drivers.
    compilerCsgMergeReleaseDetachOff =
        os.GetEnv("CHENG_MERGE_DETACH_STATE_TREE") == "0"
    compilerCsgT4TimeTrace = os.GetEnv("CHENG_CSG_T4_TIME") == "1"
    # [m1-line] One-time read, the same latch idiom as every probe flag above:
    # the flag is the module `var` every consumer tests, never a fresh
    # `GetEnv` at a call site.
    compilerCsgAllocLedgerArmed = os.GetEnv("CHENG_CSG_ALLOC_LEDGER") == "1"
    # [c1-line] Decl-loop sub-timing probe flag (same one-time latch idiom:
    # the flag is the module var every timing site tests, never a fresh
    # GetEnv at a call site).  Unset environment -> default path untouched.
    compilerCsgDeclTimeEnabled = os.GetEnv("CHENG_CSG_DECLTIME") == "1"
    # [tc-line] Forest-window sub-timing probe flag (same one-time latch
    # idiom as every probe flag above: the flag is the module var every
    # timing site tests, never a fresh GetEnv at a call site).
    compilerCsgForestSubTimeEnabled = os.GetEnv("CHENG_FOREST_SUBTIME") == "1"

@borrows
fn compilerCsgMemTraceEmit(tag: str) =
    if !compilerCsgMemTrace:
        return
    let line = Fmt"csg_mem tag={tag} rss={os.ProcessRssBytes()} live={system.MemLiveAllocations()}"
    os.WriteLine(os.Get_stderr(), line)

# [merge-release] What the tree slot the append parks in the build state holds
# at the driver's release point, and whether that release gave the parse arena
# back.  `cap` is the arena capacity the release sees; `state_cap` reads the
# same arena back through the shared slot afterwards -- ArenaRelease zeroes it,
# so a non-zero readback means the release skipped the arena because a borrow
# lease was still outstanding or the owner was already detached.
# [merge-release] Step-level readback of the parse half.  The r59 lens showed
# the append costs ~0.1 MB and the release returns the tree arena, while live
# blocks still climb per source; these two points say which parse step owns
# them.  Read-only; silent unless the same one-time latch is armed.
@borrows
fn compilerCsgMergeStageEmit(stage: str, sourceIndex: int32) =
    if !compilerCsgMergeReleaseTrace:
        return
    os.WriteLine(os.Get_stderr(),
        Fmt"merge_stage stage={stage} src={sourceIndex} live={system.MemLiveAllocations()} rss={os.ProcessRssBytes()}")

# [t4-line] Env-gated timing probes for the profile payload release segment
# (after_reachable_function_set -> after_profile_source_payload_release).
# Armed by CHENG_CSG_T4_TIME=1; unset leaves every call site a single boolean
# check with zero I/O and zero behavior change.
var compilerCsgT4TimeTrace: bool
var compilerCsgT4MetaBuildNs: int64
var compilerCsgT4MetaLinesNs: int64
var compilerCsgT4MetaScratchNs: int64
var compilerCsgT4MetaReliefNs: int64
var compilerCsgT4MetaAppendNs: int64
var compilerCsgT4MetaReleaseNs: int64
var compilerCsgT4MetaReliefCalls: int64
var compilerCsgT4MetaSources: int64

fn compilerCsgT4NowNs(): int64 =
    return monotimes.MonoTimeNs(monotimes.GetMonoTime())

@borrows
fn compilerCsgT4Emit(tag: str, elapsedNs: int64) =
    if !compilerCsgT4TimeTrace:
        return
    let elapsedMs = elapsedNs / int64(1000000)
    let line = Fmt"t4_time tag={tag} ms={elapsedMs} rss={os.ProcessRssBytes()} live={system.MemLiveAllocations()}"
    os.WriteLine(os.Get_stderr(), line)

fn compilerCsgT4MetaTotalsEmit() =
    if !compilerCsgT4TimeTrace:
        return
    let buildMs = compilerCsgT4MetaBuildNs / int64(1000000)
    let linesMs = compilerCsgT4MetaLinesNs / int64(1000000)
    let scratchMs = compilerCsgT4MetaScratchNs / int64(1000000)
    let reliefMs = compilerCsgT4MetaReliefNs / int64(1000000)
    let appendMs = compilerCsgT4MetaAppendNs / int64(1000000)
    let releaseMs = compilerCsgT4MetaReleaseNs / int64(1000000)
    let line = Fmt"t4_time tag=meta_totals sources={compilerCsgT4MetaSources} build_ms={buildMs} lines_ms={linesMs} scratch_ms={scratchMs} relief_ms={reliefMs} relief_calls={compilerCsgT4MetaReliefCalls} append_ms={appendMs} line_release_ms={releaseMs} rss={os.ProcessRssBytes()} live={system.MemLiveAllocations()}"
    os.WriteLine(os.Get_stderr(), line)

# [c1-line] Decl-loop sub-timing probe (CHENG_CSG_DECLTIME=1).  Segment
# accumulators for the r92 per-decl consumption path: mark/borrow/struct/
# receipt (slice shell) + prune/summary/typedfacts/normalize/digest (consume
# core), plus slice totals, expr/fact counts and the heaviest-slice marker.
# Module-level SoA int64s, flushed and reset once per source at the r92 t7
# boundary, so a mid-run guard abort keeps every processed source's data.
# Unset environment: every timing site is one boolean read, zero output.
var compilerCsgDeclTimeEnabled: bool
var compilerCsgDeclTimeSlices: int64
var compilerCsgDeclTimeExprs: int64
var compilerCsgDeclTimeFacts: int64
var compilerCsgDeclTimeSliceNs: int64
var compilerCsgDeclTimeMarkNs: int64
var compilerCsgDeclTimeBorrowNs: int64
var compilerCsgDeclTimeStructNs: int64
var compilerCsgDeclTimeReceiptNs: int64
var compilerCsgDeclTimePruneNs: int64
var compilerCsgDeclTimeSummaryNs: int64
var compilerCsgDeclTimeTypedFactsNs: int64
var compilerCsgDeclTimeNormalizeNs: int64
var compilerCsgDeclTimeDigestNs: int64
var compilerCsgDeclTimeHeaviestNs: int64
var compilerCsgDeclTimeHeaviestLine: int32

@borrows
fn compilerCsgDeclTimeFlushSource(sourceIndex: int32) =
    if !compilerCsgDeclTimeEnabled:
        return
    let sliceMs = compilerCsgDeclTimeSliceNs / int64(1000000)
    let markMs = compilerCsgDeclTimeMarkNs / int64(1000000)
    let borrowMs = compilerCsgDeclTimeBorrowNs / int64(1000000)
    let structMs = compilerCsgDeclTimeStructNs / int64(1000000)
    let receiptMs = compilerCsgDeclTimeReceiptNs / int64(1000000)
    let pruneMs = compilerCsgDeclTimePruneNs / int64(1000000)
    let summaryMs = compilerCsgDeclTimeSummaryNs / int64(1000000)
    let typedFactsMs = compilerCsgDeclTimeTypedFactsNs / int64(1000000)
    let normalizeMs = compilerCsgDeclTimeNormalizeNs / int64(1000000)
    let digestMs = compilerCsgDeclTimeDigestNs / int64(1000000)
    let heaviestMs = compilerCsgDeclTimeHeaviestNs / int64(1000000)
    let line = Fmt"csg_decltime src={sourceIndex} slices={compilerCsgDeclTimeSlices} exprs={compilerCsgDeclTimeExprs} facts={compilerCsgDeclTimeFacts} slice_ms={sliceMs} mark_ms={markMs} borrow_ms={borrowMs} struct_ms={structMs} receipt_ms={receiptMs} prune_ms={pruneMs} summary_ms={summaryMs} typedfacts_ms={typedFactsMs} normalize_ms={normalizeMs} digest_ms={digestMs} heaviest_ms={heaviestMs} heaviest_line={compilerCsgDeclTimeHeaviestLine} rss={os.ProcessRssBytes()} live={system.MemLiveAllocations()}"
    os.WriteLine(os.Get_stderr(), line)
    compilerCsgDeclTimeSlices = 0
    compilerCsgDeclTimeExprs = 0
    compilerCsgDeclTimeFacts = 0
    compilerCsgDeclTimeSliceNs = 0
    compilerCsgDeclTimeMarkNs = 0
    compilerCsgDeclTimeBorrowNs = 0
    compilerCsgDeclTimeStructNs = 0
    compilerCsgDeclTimeReceiptNs = 0
    compilerCsgDeclTimePruneNs = 0
    compilerCsgDeclTimeSummaryNs = 0
    compilerCsgDeclTimeTypedFactsNs = 0
    compilerCsgDeclTimeNormalizeNs = 0
    compilerCsgDeclTimeDigestNs = 0
    compilerCsgDeclTimeHeaviestNs = 0
    compilerCsgDeclTimeHeaviestLine = 0

# [tc-line] Forest-window sub-timing probe (CHENG_FOREST_SUBTIME=1).  Segment
# accumulators for the forest window (after_profile_source_payload_release ->
# after_profile_lookup), the M4 "285s with no internal segmentation" blind
# spot: the pass0 measurement parse splits into rewrite(snapshot+rewrite+
# census)/parse/index/release, the streaming pre-loop into
# import-authority/sorted/alloc/ctx-index, the pass1 loop into
# rewrite/parse/verify/authority/append/buildindex/release, plus the forward
# replay and the seal tail.  Module-level SoA int64s, emitted cumulatively at
# three checkpoints (ck=pass0 after the measurement pass, ck=ctx after the
# context index, ck=done at window end) so a mid-window guard abort keeps
# every completed segment's reading; take checkpoint deltas when reading.
# Unset environment: every timing site is one boolean read plus one gated
# MonoTimeNs pair, zero output, zero behavior change.
var compilerCsgForestSubTimeEnabled: bool
var compilerCsgForestSubSources: int64
var compilerCsgForestSubP0RewriteNs: int64
var compilerCsgForestSubP0ParseNs: int64
var compilerCsgForestSubP0IndexNs: int64
var compilerCsgForestSubP0ReleaseNs: int64
var compilerCsgForestSubImportNs: int64
var compilerCsgForestSubSortedNs: int64
var compilerCsgForestSubAllocNs: int64
var compilerCsgForestSubCtxNs: int64
var compilerCsgForestSubP1RewriteNs: int64
var compilerCsgForestSubP1ParseNs: int64
var compilerCsgForestSubP1VerifyNs: int64
var compilerCsgForestSubAuthorityNs: int64
var compilerCsgForestSubAppendNs: int64
var compilerCsgForestSubBuildNs: int64
var compilerCsgForestSubP1ReleaseNs: int64
var compilerCsgForestSubReplayNs: int64
var compilerCsgForestSubSealNs: int64

fn compilerCsgForestSubTimeReset() =
    compilerCsgForestSubSources = 0
    compilerCsgForestSubP0RewriteNs = 0
    compilerCsgForestSubP0ParseNs = 0
    compilerCsgForestSubP0IndexNs = 0
    compilerCsgForestSubP0ReleaseNs = 0
    compilerCsgForestSubImportNs = 0
    compilerCsgForestSubSortedNs = 0
    compilerCsgForestSubAllocNs = 0
    compilerCsgForestSubCtxNs = 0
    compilerCsgForestSubP1RewriteNs = 0
    compilerCsgForestSubP1ParseNs = 0
    compilerCsgForestSubP1VerifyNs = 0
    compilerCsgForestSubAuthorityNs = 0
    compilerCsgForestSubAppendNs = 0
    compilerCsgForestSubBuildNs = 0
    compilerCsgForestSubP1ReleaseNs = 0
    compilerCsgForestSubReplayNs = 0
    compilerCsgForestSubSealNs = 0

@borrows
fn compilerCsgForestSubTimeEmit(ck: str) =
    if !compilerCsgForestSubTimeEnabled:
        return
    let p0RewriteMs = compilerCsgForestSubP0RewriteNs / int64(1000000)
    let p0ParseMs = compilerCsgForestSubP0ParseNs / int64(1000000)
    let p0IndexMs = compilerCsgForestSubP0IndexNs / int64(1000000)
    let p0ReleaseMs = compilerCsgForestSubP0ReleaseNs / int64(1000000)
    let importMs = compilerCsgForestSubImportNs / int64(1000000)
    let sortedMs = compilerCsgForestSubSortedNs / int64(1000000)
    let allocMs = compilerCsgForestSubAllocNs / int64(1000000)
    let ctxMs = compilerCsgForestSubCtxNs / int64(1000000)
    let p1RewriteMs = compilerCsgForestSubP1RewriteNs / int64(1000000)
    let p1ParseMs = compilerCsgForestSubP1ParseNs / int64(1000000)
    let p1VerifyMs = compilerCsgForestSubP1VerifyNs / int64(1000000)
    let p1AuthorityMs = compilerCsgForestSubAuthorityNs / int64(1000000)
    let p1AppendMs = compilerCsgForestSubAppendNs / int64(1000000)
    let p1BuildMs = compilerCsgForestSubBuildNs / int64(1000000)
    let p1ReleaseMs = compilerCsgForestSubP1ReleaseNs / int64(1000000)
    let replayMs = compilerCsgForestSubReplayNs / int64(1000000)
    let sealMs = compilerCsgForestSubSealNs / int64(1000000)
    let line = Fmt"forest_subtime ck={ck} sources={compilerCsgForestSubSources} p0_rewrite_ms={p0RewriteMs} p0_parse_ms={p0ParseMs} p0_index_ms={p0IndexMs} p0_release_ms={p0ReleaseMs} import_auth_ms={importMs} sorted_ms={sortedMs} alloc_ms={allocMs} ctx_ms={ctxMs} p1_rewrite_ms={p1RewriteMs} p1_parse_ms={p1ParseMs} p1_verify_ms={p1VerifyMs} p1_authority_ms={p1AuthorityMs} p1_append_ms={p1AppendMs} p1_buildidx_ms={p1BuildMs} p1_release_ms={p1ReleaseMs} replay_ms={replayMs} seal_ms={sealMs} rss={os.ProcessRssBytes()} live={system.MemLiveAllocations()}"
    os.WriteLine(os.Get_stderr(), line)

# [c-line retain-ledger] Segment kind codes shared with the driver's phase
# memory ledger: 1=merge_parse 2=merge_authority 3=merge_ta_append
# 4=merge_build_index 5=merge_replay 6=merge_rewrite.  The release segment is
# accumulated but never named: it only gives blocks back.
fn CompilerCsgPhaseMemoryRetainKindName(kindCode: int32): str =
    if kindCode == 1:
        return "merge_parse"
    if kindCode == 2:
        return "merge_authority"
    if kindCode == 3:
        return "merge_ta_append"
    if kindCode == 4:
        return "merge_build_index"
    if kindCode == 5:
        return "merge_replay"
    if kindCode == 6:
        return "merge_rewrite"
    return "none"

fn compilerCsgRetainSegmentTotals(kindCode: int32,
                                  blocks: var int64,
                                  totalBytes: var int64) =
    blocks = 0
    totalBytes = 0
    if kindCode == 1:
        blocks = compilerCsgRetainParseBlocks
        totalBytes = compilerCsgRetainParseBytes
    if kindCode == 2:
        blocks = compilerCsgRetainAuthorityBlocks
        totalBytes = compilerCsgRetainAuthorityBytes
    if kindCode == 3:
        blocks = compilerCsgRetainTaAppendBlocks
        totalBytes = compilerCsgRetainTaAppendBytes
    if kindCode == 4:
        blocks = compilerCsgRetainBuildIndexBlocks
        totalBytes = compilerCsgRetainBuildIndexBytes
    if kindCode == 5:
        blocks = compilerCsgRetainReplayBlocks
        totalBytes = compilerCsgRetainReplayBytes
    if kindCode == 6:
        blocks = compilerCsgRetainRewriteBlocks
        totalBytes = compilerCsgRetainRewriteBytes

fn compilerCsgRetainLedgerTop3Into(kind0: var int32,
                                   blocks0: var int64,
                                   bytes0: var int64,
                                   kind1: var int32,
                                   blocks1: var int64,
                                   bytes1: var int64,
                                   kind2: var int32,
                                   blocks2: var int64,
                                   bytes2: var int64) =
    kind0 = 0
    blocks0 = 0
    bytes0 = 0
    kind1 = 0
    blocks1 = 0
    bytes1 = 0
    kind2 = 0
    blocks2 = 0
    bytes2 = 0
    var candKind: int32 = 1
    while candKind <= 6:
        var candBlocks: int64
        var candBytes: int64
        compilerCsgRetainSegmentTotals(candKind, candBlocks, candBytes)
        if candBytes > bytes0:
            kind2 = kind1
            blocks2 = blocks1
            bytes2 = bytes1
            kind1 = kind0
            blocks1 = blocks0
            bytes1 = bytes0
            kind0 = candKind
            blocks0 = candBlocks
            bytes0 = candBytes
        else:
            if candBytes > bytes1:
                kind2 = kind1
                blocks2 = blocks1
                bytes2 = bytes1
                kind1 = candKind
                blocks1 = candBlocks
                bytes1 = candBytes
            else:
                if candBytes > bytes2:
                    kind2 = candKind
                    blocks2 = candBlocks
                    bytes2 = candBytes
        candKind = candKind + 1

fn CompilerCsgPhaseMemoryRetainTopContributors(kind0: var int32,
                                               blocks0: var int64,
                                               bytes0: var int64,
                                               kind1: var int32,
                                               blocks1: var int64,
                                               bytes1: var int64,
                                               kind2: var int32,
                                               blocks2: var int64,
                                               bytes2: var int64) =
    compilerCsgRetainLedgerTop3Into(kind0, blocks0, bytes0,
                                    kind1, blocks1, bytes1,
                                    kind2, blocks2, bytes2)

fn compilerCsgRetainLedgerEmitSource(sourceIndex: int32,
                                     dParseBlocks: int64,
                                     dParseBytes: int64,
                                     dAuthBlocks: int64,
                                     dAuthBytes: int64,
                                     dTaBlocks: int64,
                                     dTaBytes: int64,
                                     dBuildBlocks: int64,
                                     dBuildBytes: int64,
                                     dReleaseBlocks: int64,
                                     dReleaseBytes: int64) =
    if !compilerCsgMemTrace:
        return
    os.WriteLine(os.Get_stderr(),
        Fmt"retain_ledger src={sourceIndex} parse={dParseBlocks}/{dParseBytes} auth={dAuthBlocks}/{dAuthBytes} ta={dTaBlocks}/{dTaBytes} build={dBuildBlocks}/{dBuildBytes} release={dReleaseBlocks}/{dReleaseBytes} tot_parse={compilerCsgRetainParseBlocks}/{compilerCsgRetainParseBytes} tot_auth={compilerCsgRetainAuthorityBlocks}/{compilerCsgRetainAuthorityBytes} tot_ta={compilerCsgRetainTaAppendBlocks}/{compilerCsgRetainTaAppendBytes} tot_build={compilerCsgRetainBuildIndexBlocks}/{compilerCsgRetainBuildIndexBytes} tot_release={compilerCsgRetainReleaseBlocks}/{compilerCsgRetainReleaseBytes} tot_rewrite={compilerCsgRetainRewriteBlocks}/{compilerCsgRetainRewriteBytes} sources={compilerCsgRetainSources}")

fn compilerCsgRetainLedgerEmitTotals(tag: str) =
    if !compilerCsgMemTrace:
        return
    os.WriteLine(os.Get_stderr(),
        Fmt"retain_ledger_totals tag={tag} parse={compilerCsgRetainParseBlocks}/{compilerCsgRetainParseBytes} auth={compilerCsgRetainAuthorityBlocks}/{compilerCsgRetainAuthorityBytes} ta={compilerCsgRetainTaAppendBlocks}/{compilerCsgRetainTaAppendBytes} build={compilerCsgRetainBuildIndexBlocks}/{compilerCsgRetainBuildIndexBytes} release={compilerCsgRetainReleaseBlocks}/{compilerCsgRetainReleaseBytes} rewrite={compilerCsgRetainRewriteBlocks}/{compilerCsgRetainRewriteBytes} replay_n={compilerCsgRetainReplaySources} replay={compilerCsgRetainReplayBlocks}/{compilerCsgRetainReplayBytes} sources={compilerCsgRetainSources}")

fn compilerCsgRetainLedgerEmitTopKeys() =
    if !compilerCsgMemTrace:
        return
    var kind0: int32
    var blocks0: int64
    var bytes0: int64
    var kind1: int32
    var blocks1: int64
    var bytes1: int64
    var kind2: int32
    var blocks2: int64
    var bytes2: int64
    compilerCsgRetainLedgerTop3Into(kind0, blocks0, bytes0,
                                    kind1, blocks1, bytes1,
                                    kind2, blocks2, bytes2)
    let kind0Name = CompilerCsgPhaseMemoryRetainKindName(kind0)
    let kind1Name = CompilerCsgPhaseMemoryRetainKindName(kind1)
    let kind2Name = CompilerCsgPhaseMemoryRetainKindName(kind2)
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_0_kind={kind0Name}")
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_0_count={blocks0}")
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_0_bytes={bytes0}")
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_1_kind={kind1Name}")
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_1_count={blocks1}")
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_1_bytes={bytes1}")
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_2_kind={kind2Name}")
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_2_count={blocks2}")
    os.WriteLine(os.Get_stderr(),
        Fmt"phase_memory_ledger_compiler_csg_top_contributor_2_bytes={bytes2}")

# [m1-line] Runtime allocation ledger owner for the diagnostic gate round,
# armed by CHENG_CSG_ALLOC_LEDGER=1 inside CompilerCsgTraceInit.  The provider
# owner is process-exclusive, so the session brackets exactly the streaming
# merge loop: Begin before the first source, one snapshot per retain-ledger
# segment boundary, totals + finish snapshot at the typed_context_lookup_built
# egress.  Blocks come from liveAllocationCount and bytes from liveBackingBytes
# -- the allocator's own live numbers, which the retain-ledger RSS column
# cannot separate.  Per-source stderr emission means a mid-merge guard kill or
# panic still leaves the named readings, the same shape as the retain-ledger.
# With the env unset every boundary is a single boolean check: no provider
# call, no counter read, no output.
var compilerCsgAllocLedgerArmed: bool
var compilerCsgAllocLedgerActive: bool
var compilerCsgAllocLedgerOwner: system.RuntimeAllocationLedgerOwner
var compilerCsgAllocPrevBlocks: int64
var compilerCsgAllocPrevBytes: int64
var compilerCsgAllocPeakBlocks: int64
var compilerCsgAllocPeakBytes: int64
var compilerCsgAllocSources: int32
var compilerCsgAllocTokens: int64
var compilerCsgAllocDParseBlocks: int64
var compilerCsgAllocDParseBytes: int64
var compilerCsgAllocDAuthBlocks: int64
var compilerCsgAllocDAuthBytes: int64
var compilerCsgAllocDTaBlocks: int64
var compilerCsgAllocDTaBytes: int64
var compilerCsgAllocDBuildBlocks: int64
var compilerCsgAllocDBuildBytes: int64
var compilerCsgAllocDReleaseBlocks: int64
var compilerCsgAllocDReleaseBytes: int64
var compilerCsgAllocDReplayBlocks: int64
var compilerCsgAllocDReplayBytes: int64
var compilerCsgAllocDRewriteBlocks: int64
var compilerCsgAllocDRewriteBytes: int64
var compilerCsgAllocParseBlocks: int64
var compilerCsgAllocParseBytes: int64
var compilerCsgAllocAuthorityBlocks: int64
var compilerCsgAllocAuthorityBytes: int64
var compilerCsgAllocTaAppendBlocks: int64
var compilerCsgAllocTaAppendBytes: int64
var compilerCsgAllocBuildIndexBlocks: int64
var compilerCsgAllocBuildIndexBytes: int64
var compilerCsgAllocReleaseBlocks: int64
var compilerCsgAllocReleaseBytes: int64
var compilerCsgAllocReplaySources: int32
var compilerCsgAllocReplayBlocks: int64
var compilerCsgAllocReplayBytes: int64
var compilerCsgAllocRewriteBlocks: int64
var compilerCsgAllocRewriteBytes: int64

fn compilerCsgAllocLedgerReadInto(blocks: var int64,
                                  totalBytes: var int64): bool =
    if !compilerCsgAllocLedgerActive:
        return false
    let snap = system.RuntimeAllocationLedgerSnapshot(
        compilerCsgAllocLedgerOwner)
    if !snap.ok:
        return false
    blocks = int64(snap.receipt.liveAllocationCount)
    totalBytes = int64(snap.receipt.liveBackingBytes)
    if blocks > compilerCsgAllocPeakBlocks:
        compilerCsgAllocPeakBlocks = blocks
    if totalBytes > compilerCsgAllocPeakBytes:
        compilerCsgAllocPeakBytes = totalBytes
    return true

fn CompilerCsgAllocLedgerEntryBegin() =
    # The provider only arms on an empty process heap (its begin validation
    # rejects a nonempty baseline), so when CHENG_CSG_ALLOC_LEDGER=1 this
    # must run as the FIRST source-level operation of the driver process,
    # before argv capture allocates.  Unset env makes it two boolean checks.
    # The merge-loop entry call below then only pins the loop baseline.
    compilerCsgAllocLedgerStart()

fn compilerCsgAllocLedgerStart() =
    # Arm ordering: the env latch lives in CompilerCsgTraceInit, so init must
    # run before the flag is tested.  Without the driver-entry hook this
    # attempt reports the provider's nonempty-heap verdict once and the round
    # runs data-free; with the hook the owner is already active here and this
    # is a no-op.
    CompilerCsgTraceInit()
    if !compilerCsgAllocLedgerArmed || compilerCsgAllocLedgerActive:
        return
    # The backing limit is the diagnostic ceiling only; the provider caps it
    # at 1 GiB (the same constant csg_core's production owner uses) and the
    # gate stays armed for the whole 234-source forest.
    let opened = system.RuntimeAllocationLedgerBegin(
        "cheng.compiler_csg.alloc_ledger.m1",
        uint64(1073741824))
    if !opened.ok:
        os.WriteLine(os.Get_stderr(),
            Fmt"alloc_ledger begin_failed error={opened.error}")
        return
    compilerCsgAllocLedgerOwner = opened.owner
    compilerCsgAllocLedgerActive = true
    var beginBlocks: int64
    var beginBytes: int64
    if compilerCsgAllocLedgerReadInto(beginBlocks, beginBytes):
        os.WriteLine(os.Get_stderr(),
            Fmt"alloc_ledger begin blocks={beginBlocks} bytes={beginBytes}")

fn compilerCsgAllocLedgerMark() =
    if !compilerCsgAllocLedgerActive:
        return
    var markBlocks: int64
    var markBytes: int64
    if compilerCsgAllocLedgerReadInto(markBlocks, markBytes):
        compilerCsgAllocPrevBlocks = markBlocks
        compilerCsgAllocPrevBytes = markBytes

fn compilerCsgAllocLedgerCollectInto(segBlocks: var int64,
                                     segBytes: var int64) =
    segBlocks = 0
    segBytes = 0
    if !compilerCsgAllocLedgerActive:
        return
    var nowBlocks: int64
    var nowBytes: int64
    if compilerCsgAllocLedgerReadInto(nowBlocks, nowBytes):
        segBlocks = nowBlocks - compilerCsgAllocPrevBlocks
        segBytes = nowBytes - compilerCsgAllocPrevBytes
        compilerCsgAllocPrevBlocks = nowBlocks
        compilerCsgAllocPrevBytes = nowBytes

fn compilerCsgAllocLedgerKindName(kindCode: int32): str =
    if kindCode == 1:
        return "parse"
    if kindCode == 2:
        return "auth"
    if kindCode == 3:
        return "ta_append"
    if kindCode == 4:
        return "build_index"
    if kindCode == 5:
        return "replay"
    if kindCode == 6:
        return "rewrite"
    return "none"

fn compilerCsgAllocLedgerSegmentTotals(kindCode: int32,
                                       blocks: var int64,
                                       totalBytes: var int64) =
    blocks = 0
    totalBytes = 0
    if kindCode == 1:
        blocks = compilerCsgAllocParseBlocks
        totalBytes = compilerCsgAllocParseBytes
    if kindCode == 2:
        blocks = compilerCsgAllocAuthorityBlocks
        totalBytes = compilerCsgAllocAuthorityBytes
    if kindCode == 3:
        blocks = compilerCsgAllocTaAppendBlocks
        totalBytes = compilerCsgAllocTaAppendBytes
    if kindCode == 4:
        blocks = compilerCsgAllocBuildIndexBlocks
        totalBytes = compilerCsgAllocBuildIndexBytes
    if kindCode == 5:
        blocks = compilerCsgAllocReplayBlocks
        totalBytes = compilerCsgAllocReplayBytes
    if kindCode == 6:
        blocks = compilerCsgAllocRewriteBlocks
        totalBytes = compilerCsgAllocRewriteBytes

fn compilerCsgAllocLedgerTop3Into(kind0: var int32,
                                  blocks0: var int64,
                                  bytes0: var int64,
                                  kind1: var int32,
                                  blocks1: var int64,
                                  bytes1: var int64,
                                  kind2: var int32,
                                  blocks2: var int64,
                                  bytes2: var int64) =
    kind0 = 0
    blocks0 = 0
    bytes0 = 0
    kind1 = 0
    blocks1 = 0
    bytes1 = 0
    kind2 = 0
    blocks2 = 0
    bytes2 = 0
    var candKind: int32 = 1
    while candKind <= 6:
        var candBlocks: int64
        var candBytes: int64
        compilerCsgAllocLedgerSegmentTotals(candKind, candBlocks, candBytes)
        if candBytes > bytes0:
            kind2 = kind1
            blocks2 = blocks1
            bytes2 = bytes1
            kind1 = kind0
            blocks1 = blocks0
            bytes1 = bytes0
            kind0 = candKind
            blocks0 = candBlocks
            bytes0 = candBytes
        else:
            if candBytes > bytes1:
                kind2 = kind1
                blocks2 = blocks1
                bytes2 = bytes1
                kind1 = candKind
                blocks1 = candBlocks
                bytes1 = candBytes
            else:
                if candBytes > bytes2:
                    kind2 = candKind
                    blocks2 = candBlocks
                    bytes2 = candBytes
        candKind = candKind + 1

fn compilerCsgAllocLedgerTopEmit() =
    if !compilerCsgAllocLedgerArmed:
        return
    var kind0: int32
    var blocks0: int64
    var bytes0: int64
    var kind1: int32
    var blocks1: int64
    var bytes1: int64
    var kind2: int32
    var blocks2: int64
    var bytes2: int64
    compilerCsgAllocLedgerTop3Into(kind0, blocks0, bytes0,
                                   kind1, blocks1, bytes1,
                                   kind2, blocks2, bytes2)
    os.WriteLine(os.Get_stderr(),
        Fmt"alloc_ledger_top rank=0 key={compilerCsgAllocLedgerKindName(kind0)} blocks={blocks0} bytes={bytes0}")
    os.WriteLine(os.Get_stderr(),
        Fmt"alloc_ledger_top rank=1 key={compilerCsgAllocLedgerKindName(kind1)} blocks={blocks1} bytes={bytes1}")
    os.WriteLine(os.Get_stderr(),
        Fmt"alloc_ledger_top rank=2 key={compilerCsgAllocLedgerKindName(kind2)} blocks={blocks2} bytes={bytes2}")

fn compilerCsgAllocLedgerTotalsEmit(tag: str) =
    if !compilerCsgAllocLedgerArmed:
        return
    os.WriteLine(os.Get_stderr(),
        Fmt"alloc_ledger_totals tag={tag} parse={compilerCsgAllocParseBlocks}/{compilerCsgAllocParseBytes} auth={compilerCsgAllocAuthorityBlocks}/{compilerCsgAllocAuthorityBytes} ta={compilerCsgAllocTaAppendBlocks}/{compilerCsgAllocTaAppendBytes} build={compilerCsgAllocBuildIndexBlocks}/{compilerCsgAllocBuildIndexBytes} release={compilerCsgAllocReleaseBlocks}/{compilerCsgAllocReleaseBytes} rewrite={compilerCsgAllocRewriteBlocks}/{compilerCsgAllocRewriteBytes} replay_n={compilerCsgAllocReplaySources} replay={compilerCsgAllocReplayBlocks}/{compilerCsgAllocReplayBytes} sources={compilerCsgAllocSources} tokens={compilerCsgAllocTokens} peak_blocks={compilerCsgAllocPeakBlocks} peak_bytes={compilerCsgAllocPeakBytes}")

fn compilerCsgAllocLedgerFinishEmit() =
    if !compilerCsgAllocLedgerActive:
        return
    var finishBlocks: int64
    var finishBytes: int64
    if compilerCsgAllocLedgerReadInto(finishBlocks, finishBytes):
        os.WriteLine(os.Get_stderr(),
            Fmt"alloc_ledger finish blocks={finishBlocks} bytes={finishBytes} peak_blocks={compilerCsgAllocPeakBlocks} peak_bytes={compilerCsgAllocPeakBytes}")

@borrows
fn compilerCsgMergeStateTreeCapacity(
        stateTree: parser.ParserValueExprTree): int32 =
    if stateTree == nil:
        return int32(-1)
    return arenamod.ArenaCapacity(stateTree.arena)

@borrows
fn compilerCsgMergeReleaseEmit(stage: str,
                               sourceIndex: int32,
                               tree: parser.ParserValueExprTree,
                               stateTree: parser.ParserValueExprTree) =
    if !compilerCsgMergeReleaseTrace:
        return
    if stage == "pre":
        if tree == nil:
            return
        let ownerFlag: int32 = if tree.ownerAttached: 1 else: 0
        let stateSameFlag: int32 = if stateTree == tree: 1 else: 0
        os.WriteLine(os.Get_stderr(),
            Fmt"merge_release stage=pre src={sourceIndex} cap={arenamod.ArenaCapacity(tree.arena)} retained={parser.ParserValueExprTreeRetainedBytes(tree)} lease={parser.ParserValueExprTreeBorrowLeaseCount(tree)} owner={ownerFlag} life={tree.lifecycleState} state_same={stateSameFlag} state_cap={compilerCsgMergeStateTreeCapacity(stateTree)} state_lease={parser.ParserValueExprTreeBorrowLeaseCount(stateTree)} state_retained={parser.ParserValueExprTreeRetainedBytes(stateTree)} tokens={tree.tokenCount} nodes={tree.nodeCount} intern_count={langintern.InternPoolCount(tree.internPool)} intern_payload={langintern.InternPoolLogicalPayloadBytes(tree.internPool)} live={system.MemLiveAllocations()} rss={os.ProcessRssBytes()}")
        return
    os.WriteLine(os.Get_stderr(),
        Fmt"merge_release stage=post src={sourceIndex} state_cap={compilerCsgMergeStateTreeCapacity(stateTree)} state_retained={parser.ParserValueExprTreeRetainedBytes(stateTree)} live={system.MemLiveAllocations()} rss={os.ProcessRssBytes()}")

# [nominal-sweep] The enumeration writes its list to stderr, the same stream
# `compilerCsgMemTraceEmit` uses, and is silent unless the flag is set.
@borrows
fn compilerNominalSweepEmit(line: str) =
    if !compilerNominalSweep:
        return
    os.WriteLine(os.Get_stderr(), line)

fn CompilerCsgTraceActive(): bool =
    CompilerCsgTraceInit()
    if len(compilerCsgTraceOutPath) > 0:
        return true
    if len(compilerCsgTraceSinglePath) > 0:
        return true
    return false

fn CompilerCsgDebugStderr(): bool =
    CompilerCsgTraceInit()
    return compilerCsgTraceStderr

fn CompilerCsgSetTraceStderr(enabled: bool) =
    CompilerCsgTraceInit()
    compilerCsgTraceStderr = enabled

fn CompilerCsgDebugLine(line: str) =
    CompilerCsgTraceInit()
    if compilerCsgTraceStderr:
        os.WriteLine(os.Get_stderr(), line)

@borrows
fn CompilerCsgDebugSliceMemory(enabled: bool,
                                stage: str,
                                sourcePath: str,
                                functionIndex: int32,
                                exprCount: int32) =
    if !enabled || functionIndex % 64 != 0:
        return
    CompilerCsgDebugLine(Fmt"compiler_csg_slice_memory stage={stage} source={sourcePath} function_index={functionIndex} expr_count={exprCount} live_allocations={system.MemLiveAllocations()} rss_bytes={os.ProcessRssBytes()}")

fn CompilerCsgTraceHasFileSink(): bool =
    CompilerCsgTraceInit()
    if len(compilerCsgTraceOutPath) > 0:
        return true
    if len(compilerCsgTraceSinglePath) > 0:
        return true
    return false

@borrows
fn CompilerCsgTraceStderrStageAllowed(stage: str): bool =
    if stage == "enter":
        return true
    if strutil.StartsWith(stage, "r92_t"):
        return true
    if stage == "after_external_package_roots":
        return true
    if stage == "after_source_text_lookup":
        return true
    if stage == "after_binding_source_texts":
        return true
    if stage == "after_binding_import_rebuild":
        return true
    if stage == "after_binding_import_compare":
        return true
    if stage == "after_portable_binding_validation":
        return true
    if stage == "after_binding_source_text_release":
        return true
    if stage == "before_sort_modules":
        return true
    if stage == "after_sort_modules":
        return true
    if stage == "after_package_node":
        return true
    if stage == "after_module_nodes":
        return true
    if stage == "after_import_edges":
        return true
    if stage == "before_sort_sources":
        return true
    if stage == "after_sort_sources":
        return true
    if stage == "after_profiles":
        return true
    if stage == "after_profile_lookup":
        return true
    if stage == "before_reachable_function_set":
        return true
    if stage == "after_reachable_function_set":
        return true
    if stage == "after_profile_source_payload_release":
        return true
    if stage == "after_immutable_source_snapshot_release":
        return true
    if stage == "after_expr_layer_and_symbols":
        return true
    if stage == "before_typed_facts":
        return true
    if stage == "after_typed_facts":
        return true
    if stage == "before_typed_reachable_expand":
        return true
    if stage == "after_typed_reachable_expand":
        return true
    if stage == "before_typed_ir_expr_layer_rebuild":
        return true
    if stage == "after_typed_ir_expr_layer_rebuild":
        return true
    if stage == "before_typed_ir":
        return true
    if stage == "after_typed_ir":
        return true
    if stage == "before_typed_ir_reachable_expand":
        return true
    if stage == "after_typed_ir_reachable_expand":
        return true
    if stage == "before_canonical_graph_cid":
        return true
    if stage == "before_graph_cid":
        return true
    if stage == "before_return_true":
        return true
    if stage == "done":
        return true
    return false

var compilerCsgTraceLastNs: int64

@borrows
fn compilerCsgTraceAppendStageFile(path: str, stage: str) =
    if os.FileExists(path):
        let existing = chengpath.ReadTextFile("", path)
        let next = strutil.Join([existing, share(stage), "\n"], "")
        let _ = chengpath.WriteTextFile("", path, next)
        return
    let next = strutil.Join(["", share(stage), "\n"], "")
    let _ = chengpath.WriteTextFile("", path, next)

@borrows
fn compilerCsgTraceWriteStderr(stage: str) =
    let nowNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let sinceMs = (nowNs - compilerCsgTraceLastNs) / int64(1000000)
    compilerCsgTraceLastNs = nowNs
    let sinceText = strings.Int64ToStr(sinceMs)
    let rss = os.ProcessRssBytes()
    let line = Fmt"csg_stage={stage} since_ms={sinceText} rss_bytes={rss} live_allocations={system.MemLiveAllocations()}"
    let stderr = os.Get_stderr()
    os.WriteLine(stderr, line)

fn CompilerCsgTraceStage(stage: str) =
    CompilerCsgTraceInit()
    if compilerCsgTraceStderr && CompilerCsgTraceStderrStageAllowed(stage):
        compilerCsgTraceWriteStderr(stage)
    if !CompilerCsgTraceActive():
        return
    let outPath = strings.CloneStr(compilerCsgTraceOutPath)
    if outPath != "":
        compilerCsgTraceAppendStageFile(outPath, stage)
    let singlePath = strings.CloneStr(compilerCsgTraceSinglePath)
    if singlePath.len > 0:
        let _ = chengpath.WriteTextFile("", singlePath, stage)

@borrows
fn CompilerCsgTraceSourceLine(sourcePath: str,
                               lineNumber: int32) =
    if !CompilerCsgTraceActive():
        return
    CompilerCsgTraceStage(Fmt"expr_profile_source_path={sourcePath} line={lineNumber}")

@borrows
fn CompilerCsgTraceProfileSource(sourceIndex: int32,
                                  sourcePath: str) =
    if !CompilerCsgTraceActive():
        return
    CompilerCsgTraceStage(Fmt"profile_source_index={sourceIndex} path={sourcePath}")

@borrows
fn CompilerCsgOwnText(text: str): str =
    if text == "":
        return ""
    return system.SystemToStringStr(text)

fn CompilerCsgProfileAppendMove(profiles: var parser.NormalizedExprCallProfile[],
                                profile: parser.NormalizedExprCallProfile) =
    add(profiles, profile)

fn CompilerCsgCompactExprCallProfilePayload(
        profile: var parser.NormalizedExprCallProfile) =
    # Kernel driver has no scope-exit ORC on seq-header rebind. Take the
    # compact-dead payloads onto locals so iteration-end drop is the
    # consume-window. Keep decls/importEdges/call names: those stay live
    # through the TypedIR fixed point.
    var profileText = profile.text
    profile.text = ""
    var profileLines = profile.lines
    profile.lines = []
    var profileTypeDecls = profile.typeDecls
    profile.typeDecls = []

fn CompilerCsgCompactProfilesForFixedPoint(work: var CompilerCsgBuildWorkingSet) =
    for profileIndex in 0..<work.exprCallProfiles.len:
        CompilerCsgCompactExprCallProfilePayload(
            work.exprCallProfiles[profileIndex])
        # PhaseArena CSG 文本族半片: 同步切断行号列可达性 —— compact 后消费
        # 侧走 immutable snapshot 重建 (与迁移前 lines=[] 后逐字同路径),
        # 列本体在 lineStore 相位末整批 reset, 此处仅清平行句柄数组。
        work.profileLineIdColumns[profileIndex] = phase.PhaseArenaRef()
        work.profileLineIdCounts[profileIndex] = 0

@borrows
fn CompilerCsgCloneInt32Seq(items: int32[]): int32[] =
    var out: int32[]
    for i in 0..<items.len:
        add(out, items[i])
    return out

