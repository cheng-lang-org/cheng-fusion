    compilerCsgCallOwnershipProjectionTableRelease(table.projection)
    table = CompilerCsgManualConsumeCallTokenTable()

# Read-only over `table`: every field is deep-copied into the fresh `out`;
# a clone must never consume its source.
@borrows
fn CompilerCsgSemanticResolvedCallTableClone(table: CompilerCsgSemanticResolvedCallTable): CompilerCsgSemanticResolvedCallTable =
    var out: CompilerCsgSemanticResolvedCallTable
    out.internPool = langintern.InternPoolClone(table.internPool)
    out.sourceIndexes = CompilerCsgCloneInt32Seq(table.sourceIndexes)
    out.originParserNodeIds =
        CompilerCsgCloneInt32Seq(table.originParserNodeIds)
    out.functionIndexes = CompilerCsgCloneInt32Seq(table.functionIndexes)
    out.functionRowHeads = CompilerCsgCloneInt32Seq(table.functionRowHeads)
    out.functionRowNext = CompilerCsgCloneInt32Seq(table.functionRowNext)
    out.sourcePathIds = CompilerCsgCloneInternIdSeq(table.sourcePathIds)
    out.lineNumbers = CompilerCsgCloneInt32Seq(table.lineNumbers)
    out.columnNumbers = CompilerCsgCloneInt32Seq(table.columnNumbers)
    out.callQualifierIds = CompilerCsgCloneInternIdSeq(table.callQualifierIds)
    out.callCalleeIds = CompilerCsgCloneInternIdSeq(table.callCalleeIds)
    out.callTargetIds = CompilerCsgCloneInternIdSeq(table.callTargetIds)
    out.callTargetSourcePathIds =
        CompilerCsgCloneInternIdSeq(table.callTargetSourcePathIds)
    out.callTargetSignatureLineNumbers =
        CompilerCsgCloneInt32Seq(table.callTargetSignatureLineNumbers)
    for i in 0..<table.callTargetImportcFlags.len:
        add(out.callTargetImportcFlags, table.callTargetImportcFlags[i])
    out.callArgCounts = CompilerCsgCloneInt32Seq(table.callArgCounts)
    out.callArgsTextIds = CompilerCsgCloneInternIdSeq(table.callArgsTextIds)
    for i in 0..<table.returnRootFlags.len:
        add(out.returnRootFlags, table.returnRootFlags[i])
    out.targetProducerSourceIndexes =
        CompilerCsgCloneInt32Seq(table.targetProducerSourceIndexes)
    out.targetProducerDeclarationOrdinals =
        CompilerCsgCloneInt32Seq(
            table.targetProducerDeclarationOrdinals)
    out.targetParserSourceLocalDeclarationRows =
        CompilerCsgCloneInt32Seq(
            table.targetParserSourceLocalDeclarationRows)
    out.callerGraphNodeIds =
        CompilerCsgCloneInt32Seq(table.callerGraphNodeIds)
    out.targetGraphNodeIds =
        CompilerCsgCloneInt32Seq(table.targetGraphNodeIds)
    out.typedCallNodeIndexes =
        CompilerCsgCloneInt32Seq(table.typedCallNodeIndexes)
    out.targetFunctionIndexes =
        CompilerCsgCloneInt32Seq(table.targetFunctionIndexes)
    out.targetFunctionAnnotationFlags =
        CompilerCsgCloneInt32Seq(table.targetFunctionAnnotationFlags)
    out.targetFunctionContractCids =
        CompilerCsgCloneFixed32Seq(table.targetFunctionContractCids)
    out.callArgumentStarts =
        CompilerCsgCloneInt32Seq(table.callArgumentStarts)
    out.callArgumentBindingIds =
        CompilerCsgCloneInt32Seq(table.callArgumentBindingIds)
    out.callArgumentCallRows =
        CompilerCsgCloneInt32Seq(table.callArgumentCallRows)
    out.callArgumentOrdinals =
        CompilerCsgCloneInt32Seq(table.callArgumentOrdinals)
    out.callArgumentArgLinkNodeIndexes =
        CompilerCsgCloneInt32Seq(
            table.callArgumentArgLinkNodeIndexes)
    out.callArgumentValueNodeIndexes =
        CompilerCsgCloneInt32Seq(
            table.callArgumentValueNodeIndexes)
    out.callArgumentTargetParameterDeclarationRows =
        CompilerCsgCloneInt32Seq(
            table.callArgumentTargetParameterDeclarationRows)
    for i in 0..<table.callArgumentTargetParameterMutableFlags.len:
        add(out.callArgumentTargetParameterMutableFlags,
            table.callArgumentTargetParameterMutableFlags[i])
    out.callArgumentBindingCids =
        CompilerCsgCloneFixed32Seq(table.callArgumentBindingCids)
    out.ownershipEffectStarts =
        CompilerCsgCloneInt32Seq(table.ownershipEffectStarts)
    out.ownershipEffectCounts =
        CompilerCsgCloneInt32Seq(table.ownershipEffectCounts)
    out.ownershipEffectIds =
        CompilerCsgCloneInt32Seq(table.ownershipEffectIds)
    out.ownershipEffectCallRows =
        CompilerCsgCloneInt32Seq(table.ownershipEffectCallRows)
    out.ownershipEffectCallArgumentRows =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectCallArgumentRows)
    out.ownershipEffectArgumentOrdinals =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectArgumentOrdinals)
    out.ownershipEffectArgLinkNodeIndexes =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectArgLinkNodeIndexes)
    out.ownershipEffectValueNodeIndexes =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueNodeIndexes)
    out.ownershipEffectValueNodeOwnerships =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueNodeOwnerships)
    out.ownershipEffectValueDefinitionRows =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionRows)
    out.ownershipEffectValueDefinitionOwnerships =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionOwnerships)
    out.ownershipEffectValueDefinitionOriginKinds =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionOriginKinds)
    out.ownershipEffectValueDefinitionTypedFunctionIndexes =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionTypedFunctionIndexes)
    out.ownershipEffectValueDefinitionExactTypeIds =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionExactTypeIds)
    out.ownershipEffectValueDefinitionDefiningNodeIndexes =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionDefiningNodeIndexes)
    out.ownershipEffectValueDefinitionProducerSourceIndexes =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionProducerSourceIndexes)
    out.ownershipEffectValueDefinitionSourceLocalNodeIndexes =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionSourceLocalNodeIndexes)
    out.ownershipEffectValueDefinitionDeclarationSourceLocalRows =
        CompilerCsgCloneInt32Seq(
            table.ownershipEffectValueDefinitionDeclarationSourceLocalRows)
    out.ownershipEffectKinds =
        CompilerCsgCloneInt32Seq(table.ownershipEffectKinds)
    out.ownershipEffectCids =
        CompilerCsgCloneFixed32Seq(table.ownershipEffectCids)
    out.ownershipProjection =
        compilerCsgCallOwnershipProjectionTableClone(
            table.ownershipProjection)
    out.graphNodeProjectionComplete = table.graphNodeProjectionComplete
    return out

fn CompilerCsgSemanticResolvedCallTableRelease(table: var CompilerCsgSemanticResolvedCallTable) =
    langintern.InternPoolRelease(table.internPool)
    freeSeq(table.sourceIndexes)
    freeSeq(table.originParserNodeIds)
    freeSeq(table.functionIndexes)
    freeSeq(table.functionRowHeads)
    freeSeq(table.functionRowNext)
    chengSeqFreeTyped(table.sourcePathIds)
    freeSeq(table.lineNumbers)
    freeSeq(table.columnNumbers)
    chengSeqFreeTyped(table.callQualifierIds)
    chengSeqFreeTyped(table.callCalleeIds)
    chengSeqFreeTyped(table.callTargetIds)
    chengSeqFreeTyped(table.callTargetSourcePathIds)
    freeSeq(table.callTargetSignatureLineNumbers)
    freeSeq(table.callTargetImportcFlags)
    freeSeq(table.callArgCounts)
    chengSeqFreeTyped(table.callArgsTextIds)
    freeSeq(table.returnRootFlags)
    freeSeq(table.targetProducerSourceIndexes)
    freeSeq(table.targetProducerDeclarationOrdinals)
    freeSeq(table.targetParserSourceLocalDeclarationRows)
    freeSeq(table.callerGraphNodeIds)
    freeSeq(table.targetGraphNodeIds)
    freeSeq(table.typedCallNodeIndexes)
    freeSeq(table.targetFunctionIndexes)
    freeSeq(table.targetFunctionAnnotationFlags)
    freeSeq(table.targetFunctionContractCids)
    freeSeq(table.callArgumentStarts)
    freeSeq(table.callArgumentBindingIds)
    freeSeq(table.callArgumentCallRows)
    freeSeq(table.callArgumentOrdinals)
    freeSeq(table.callArgumentArgLinkNodeIndexes)
    freeSeq(table.callArgumentValueNodeIndexes)
    freeSeq(table.callArgumentTargetParameterDeclarationRows)
    freeSeq(table.callArgumentTargetParameterMutableFlags)
    freeSeq(table.callArgumentBindingCids)
    freeSeq(table.ownershipEffectStarts)
    freeSeq(table.ownershipEffectCounts)
    freeSeq(table.ownershipEffectIds)
    freeSeq(table.ownershipEffectCallRows)
    freeSeq(table.ownershipEffectCallArgumentRows)
    freeSeq(table.ownershipEffectArgumentOrdinals)
    freeSeq(table.ownershipEffectArgLinkNodeIndexes)
    freeSeq(table.ownershipEffectValueNodeIndexes)
    freeSeq(table.ownershipEffectValueNodeOwnerships)
    freeSeq(table.ownershipEffectValueDefinitionRows)
    freeSeq(table.ownershipEffectValueDefinitionOwnerships)
    freeSeq(table.ownershipEffectValueDefinitionOriginKinds)
    freeSeq(table.ownershipEffectValueDefinitionTypedFunctionIndexes)
    freeSeq(table.ownershipEffectValueDefinitionExactTypeIds)
    freeSeq(table.ownershipEffectValueDefinitionDefiningNodeIndexes)
    freeSeq(table.ownershipEffectValueDefinitionProducerSourceIndexes)
    freeSeq(table.ownershipEffectValueDefinitionSourceLocalNodeIndexes)
    freeSeq(
        table.ownershipEffectValueDefinitionDeclarationSourceLocalRows)
    freeSeq(table.ownershipEffectKinds)
    freeSeq(table.ownershipEffectCids)
    compilerCsgCallOwnershipProjectionTableRelease(
        table.ownershipProjection)
    table = CompilerCsgSemanticResolvedCallTable()

fn CompilerCsgSemanticGraphTerminalRelease(
        graph: var CompilerCsgSemanticGraph) =
    freeSeqStrRelease(graph.sourceTable.sourcePaths)
    freeSeqStrRelease(graph.sourceTable.modulePaths)
    freeSeq(graph.sourceTable.textBytes)
    freeSeq(graph.sourceTable.declStart)
    freeSeq(graph.sourceTable.declCount)
    freeSeq(graph.sourceTable.importEdgeStart)
    freeSeq(graph.sourceTable.importEdgeCount)

    freeSeq(graph.declTable.sourceIndex)
    freeSeqStrRelease(graph.declTable.names)
    freeSeq(graph.declTable.lineNumbers)
    freeSeq(graph.declTable.importc)
    freeSeq(graph.declTable.exported)

    freeSeq(graph.importEdgeTable.ownerSourceIndex)
    freeSeq(graph.importEdgeTable.targetSourceIndex)
    freeSeqStrRelease(graph.importEdgeTable.ownerModulePaths)
    freeSeqStrRelease(graph.importEdgeTable.targetModulePaths)
    freeSeqStrRelease(graph.importEdgeTable.targetSourcePaths)
    freeSeq(graph.importEdgeTable.resolved)

    freeSeq(graph.reachableFunctionTable.sourceIndex)
    freeSeq(graph.reachableFunctionTable.producerSourceIndexes)
    freeSeq(graph.reachableFunctionTable.producerDeclarationIndexes)
    freeSeq(graph.reachableFunctionTable.functionNameSurfaceKinds)
    freeSeq(graph.reachableFunctionTable.functionNameProofCids)
    freeSeq(graph.reachableFunctionTable.functionAnnotationFlags)
    freeSeq(graph.reachableFunctionTable.functionDeclarationHeaderCids)
    freeSeq(graph.reachableFunctionTable.functionDeclarationPathCids)
    freeSeq(graph.reachableFunctionTable.keepExportBindingCids)
    freeSeqStrRelease(graph.reachableFunctionTable.sourcePaths)
    freeSeqStrRelease(graph.reachableFunctionTable.functionNames)
    freeSeqStrRelease(graph.reachableFunctionTable.symbolTexts)
    freeSeq(graph.reachableFunctionTable.startLines)
    freeSeq(graph.reachableFunctionTable.endLines)
    freeSeq(graph.reachableFunctionTable.reachable)
    freeSeq(graph.reachableFunctionTable.graphNodeIds)

    freeSeq(graph.exprSliceTable.sourceIndex)
    freeSeqStrRelease(graph.exprSliceTable.sourcePaths)
    freeSeq(graph.exprSliceTable.functionIndex)
    freeSeq(graph.exprSliceTable.exprStart)
    freeSeq(graph.exprSliceTable.exprCount)
    freeSeq(graph.exprSliceTable.typedFactStart)
    freeSeq(graph.exprSliceTable.typedFactCount)
    freeSeq(graph.exprSliceTable.typedFactSemanticDigests)
    freeSeq(graph.exprSliceTable.typedIrSemanticDigests)
    freeSeq(graph.exprSliceTable.typedIrFunctionIndexes)
    freeSeq(graph.exprSliceTable.semanticValidated)
    freeSeq(graph.exprSliceTable.functionSliceIndexes)

    var typedFactReleasedBufferCount: int32
    var typedFactReleasedBytes: int64
    CompilerCsgSemanticTypedFactTableTerminalReleaseWithReceipt(
        graph.typedFactTable,
        typedFactReleasedBufferCount,
        typedFactReleasedBytes)

    CompilerCsgSemanticResolvedCallTableRelease(
        graph.resolvedCallTable)

    freeSeq(graph.typedIrTable.functionSourceIndexes)
    freeSeq(graph.typedIrTable.functionGraphNodeIds)
    freeSeqStrRelease(graph.typedIrTable.functionNames)
    freeSeq(graph.typedIrTable.functionNodeStart)
    freeSeq(graph.typedIrTable.functionNodeCount)
    freeSeq(graph.typedIrTable.functionStatementStart)
    freeSeq(graph.typedIrTable.functionStatementCount)
    graph = CompilerCsgSemanticGraph()

# Clone contract: every mutable semantic sequence and intern owner is independent;
# callers may mutate or release either graph without invalidating the other.
@borrows
fn CompilerCsgSemanticGraphClone(semanticGraph: CompilerCsgSemanticGraph): CompilerCsgSemanticGraph =
    var out: CompilerCsgSemanticGraph
    out.builderName = parser.ParserOwnedText(semanticGraph.builderName)
    out.sourceTable.sourcePaths = CompilerCsgCloneStrSeq(semanticGraph.sourceTable.sourcePaths)
    out.sourceTable.modulePaths = CompilerCsgCloneStrSeq(semanticGraph.sourceTable.modulePaths)
    out.sourceTable.textBytes = CompilerCsgCloneInt32Seq(semanticGraph.sourceTable.textBytes)
    out.sourceTable.declStart = CompilerCsgCloneInt32Seq(semanticGraph.sourceTable.declStart)
    out.sourceTable.declCount = CompilerCsgCloneInt32Seq(semanticGraph.sourceTable.declCount)
    out.sourceTable.importEdgeStart = CompilerCsgCloneInt32Seq(semanticGraph.sourceTable.importEdgeStart)
    out.sourceTable.importEdgeCount = CompilerCsgCloneInt32Seq(semanticGraph.sourceTable.importEdgeCount)
    out.declTable.sourceIndex = CompilerCsgCloneInt32Seq(semanticGraph.declTable.sourceIndex)
    out.declTable.names = CompilerCsgCloneStrSeq(semanticGraph.declTable.names)
    out.declTable.lineNumbers = CompilerCsgCloneInt32Seq(semanticGraph.declTable.lineNumbers)
    out.declTable.importc = CompilerCsgCloneBoolSeq(semanticGraph.declTable.importc)
    out.declTable.exported = CompilerCsgCloneBoolSeq(semanticGraph.declTable.exported)
    out.importEdgeTable.ownerSourceIndex = CompilerCsgCloneInt32Seq(semanticGraph.importEdgeTable.ownerSourceIndex)
    out.importEdgeTable.targetSourceIndex = CompilerCsgCloneInt32Seq(semanticGraph.importEdgeTable.targetSourceIndex)
    out.importEdgeTable.ownerModulePaths = CompilerCsgCloneStrSeq(semanticGraph.importEdgeTable.ownerModulePaths)
    out.importEdgeTable.targetModulePaths = CompilerCsgCloneStrSeq(semanticGraph.importEdgeTable.targetModulePaths)
    out.importEdgeTable.targetSourcePaths = CompilerCsgCloneStrSeq(semanticGraph.importEdgeTable.targetSourcePaths)
    out.importEdgeTable.resolved = CompilerCsgCloneBoolSeq(semanticGraph.importEdgeTable.resolved)
    out.reachableFunctionTable.sourceIndex = CompilerCsgCloneInt32Seq(semanticGraph.reachableFunctionTable.sourceIndex)
    out.reachableFunctionTable.producerSourceIndexes =
        CompilerCsgCloneInt32Seq(
            semanticGraph.reachableFunctionTable.producerSourceIndexes)
    out.reachableFunctionTable.producerDeclarationIndexes =
        CompilerCsgCloneInt32Seq(
            semanticGraph.reachableFunctionTable.producerDeclarationIndexes)
    out.reachableFunctionTable.functionNameSurfaceKinds =
        CompilerCsgCloneInt32Seq(
            semanticGraph.reachableFunctionTable.functionNameSurfaceKinds)
    out.reachableFunctionTable.functionNameProofCids = []
    for row in 0..<semanticGraph.reachableFunctionTable.functionNameProofCids.len:
        add(out.reachableFunctionTable.functionNameProofCids,
            semanticGraph.reachableFunctionTable.functionNameProofCids[row])
    out.reachableFunctionTable.functionAnnotationFlags =
        CompilerCsgCloneInt32Seq(
            semanticGraph.reachableFunctionTable.functionAnnotationFlags)
    out.reachableFunctionTable.functionDeclarationHeaderCids = []
    for row in 0..<
            semanticGraph.reachableFunctionTable.functionDeclarationHeaderCids.len:
        add(out.reachableFunctionTable.functionDeclarationHeaderCids,
            semanticGraph.reachableFunctionTable.
                functionDeclarationHeaderCids[row])
    out.reachableFunctionTable.functionDeclarationPathCids = []
    for row in 0..<
            semanticGraph.reachableFunctionTable.functionDeclarationPathCids.len:
        add(out.reachableFunctionTable.functionDeclarationPathCids,
            semanticGraph.reachableFunctionTable.
                functionDeclarationPathCids[row])
    out.reachableFunctionTable.keepExportBindingCids = []
    for row in 0..<
            semanticGraph.reachableFunctionTable.keepExportBindingCids.len:
        add(out.reachableFunctionTable.keepExportBindingCids,
            semanticGraph.reachableFunctionTable.keepExportBindingCids[row])
    out.reachableFunctionTable.sourcePaths = CompilerCsgCloneStrSeq(semanticGraph.reachableFunctionTable.sourcePaths)
    out.reachableFunctionTable.functionNames = CompilerCsgCloneStrSeq(semanticGraph.reachableFunctionTable.functionNames)
    out.reachableFunctionTable.symbolTexts = CompilerCsgCloneStrSeq(semanticGraph.reachableFunctionTable.symbolTexts)
    out.reachableFunctionTable.startLines = CompilerCsgCloneInt32Seq(semanticGraph.reachableFunctionTable.startLines)
    out.reachableFunctionTable.endLines = CompilerCsgCloneInt32Seq(semanticGraph.reachableFunctionTable.endLines)
    out.reachableFunctionTable.reachable = CompilerCsgCloneBoolSeq(semanticGraph.reachableFunctionTable.reachable)
    out.reachableFunctionTable.graphNodeIds =
        CompilerCsgCloneInt32Seq(semanticGraph.reachableFunctionTable.graphNodeIds)
    out.exprSliceTable.sourceIndex = CompilerCsgCloneInt32Seq(semanticGraph.exprSliceTable.sourceIndex)
    out.exprSliceTable.sourcePaths = CompilerCsgCloneStrSeq(semanticGraph.exprSliceTable.sourcePaths)
    out.exprSliceTable.functionIndex = CompilerCsgCloneInt32Seq(semanticGraph.exprSliceTable.functionIndex)
    out.exprSliceTable.exprStart = CompilerCsgCloneInt32Seq(semanticGraph.exprSliceTable.exprStart)
    out.exprSliceTable.exprCount = CompilerCsgCloneInt32Seq(semanticGraph.exprSliceTable.exprCount)
    out.exprSliceTable.typedFactStart = CompilerCsgCloneInt32Seq(semanticGraph.exprSliceTable.typedFactStart)
    out.exprSliceTable.typedFactCount = CompilerCsgCloneInt32Seq(semanticGraph.exprSliceTable.typedFactCount)
    out.exprSliceTable.typedFactSemanticDigests = CompilerCsgCloneInt64Seq(semanticGraph.exprSliceTable.typedFactSemanticDigests)
    out.exprSliceTable.typedIrSemanticDigests = CompilerCsgCloneInt64Seq(semanticGraph.exprSliceTable.typedIrSemanticDigests)
    out.exprSliceTable.typedIrFunctionIndexes = CompilerCsgCloneInt32Seq(semanticGraph.exprSliceTable.typedIrFunctionIndexes)
    out.exprSliceTable.semanticValidated = CompilerCsgCloneBoolSeq(semanticGraph.exprSliceTable.semanticValidated)
    out.exprSliceTable.functionSliceIndexes = CompilerCsgCloneInt32Seq(semanticGraph.exprSliceTable.functionSliceIndexes)
    out.exprSummary = semanticGraph.exprSummary
    out.typedFactTable.sourceIndexes = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.sourceIndexes)
    out.typedFactTable.functionIndexes = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.functionIndexes)
    out.typedFactTable.semanticIdentityCertificates = CompilerCsgCloneInt64Seq(semanticGraph.typedFactTable.semanticIdentityCertificates)
    out.typedFactTable.valueKinds = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.valueKinds)
    out.typedFactTable.placeKinds = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.placeKinds)
    out.typedFactTable.hasSinks = CompilerCsgCloneBoolSeq(semanticGraph.typedFactTable.hasSinks)
    out.typedFactTable.sinkPlaceKinds = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.sinkPlaceKinds)
    out.typedFactTable.loweringModes = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.loweringModes)
    out.typedFactTable.callKinds = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.callKinds)
    out.typedFactTable.typeCallKinds = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.typeCallKinds)
    out.typedFactTable.returnKinds = CompilerCsgCloneInt32Seq(semanticGraph.typedFactTable.returnKinds)
    out.typedFactTable.returnRoots = CompilerCsgCloneBoolSeq(semanticGraph.typedFactTable.returnRoots)
    out.typedFactTable.typeCallDefaultInitCount = semanticGraph.typedFactTable.typeCallDefaultInitCount
    out.typedFactTable.typeCallConstructorCount = semanticGraph.typedFactTable.typeCallConstructorCount
    out.typedFactTable.summary = semanticGraph.typedFactTable.summary
    out.resolvedCallTable = CompilerCsgSemanticResolvedCallTableClone(semanticGraph.resolvedCallTable)
    out.typedIrTable.functionSourceIndexes = CompilerCsgCloneInt32Seq(semanticGraph.typedIrTable.functionSourceIndexes)
    out.typedIrTable.functionGraphNodeIds = CompilerCsgCloneInt32Seq(semanticGraph.typedIrTable.functionGraphNodeIds)
    out.typedIrTable.functionNames = CompilerCsgCloneStrSeq(semanticGraph.typedIrTable.functionNames)
    out.typedIrTable.functionNodeStart = CompilerCsgCloneInt32Seq(semanticGraph.typedIrTable.functionNodeStart)
    out.typedIrTable.functionNodeCount = CompilerCsgCloneInt32Seq(semanticGraph.typedIrTable.functionNodeCount)
    out.typedIrTable.functionStatementStart = CompilerCsgCloneInt32Seq(semanticGraph.typedIrTable.functionStatementStart)
    out.typedIrTable.functionStatementCount = CompilerCsgCloneInt32Seq(semanticGraph.typedIrTable.functionStatementCount)
    out.worklist = semanticGraph.worklist
    out.phaseLedger = semanticGraph.phaseLedger
    out.oracleCompared = semanticGraph.oracleCompared
    out.oracleMatched = semanticGraph.oracleMatched
    out.oracleMismatchReason = parser.ParserOwnedText(semanticGraph.oracleMismatchReason)
    out.exprSliceTypedFactComplete = semanticGraph.exprSliceTypedFactComplete
    out.exprSliceTypedFactCoveredCount = semanticGraph.exprSliceTypedFactCoveredCount
    out.exprSliceTypedFactGapCount = semanticGraph.exprSliceTypedFactGapCount
    out.exprSliceTypedFactOverlapCount = semanticGraph.exprSliceTypedFactOverlapCount
    out.exprSliceTypedFactInvalidSliceCount = semanticGraph.exprSliceTypedFactInvalidSliceCount
    out.exprSliceSyntheticCount = semanticGraph.exprSliceSyntheticCount
    out.exprSliceFunctionBoundCount = semanticGraph.exprSliceFunctionBoundCount
    out.exprSliceMaxExprCount = semanticGraph.exprSliceMaxExprCount
    out.exprSliceMaxTypedFactCount = semanticGraph.exprSliceMaxTypedFactCount
    out.exprSliceValidationReason = parser.ParserOwnedText(semanticGraph.exprSliceValidationReason)
    out.typedFactSemanticSliceCount = semanticGraph.typedFactSemanticSliceCount
    out.typedFactSemanticValidatedSliceCount =
        semanticGraph.typedFactSemanticValidatedSliceCount
    out.typedFactSemanticConservationProved =
        semanticGraph.typedFactSemanticConservationProved
    return out

# Explicit deep clone for diagnostics and compatibility callers. Production
# Into builders transfer ownership directly and do not clone CompilerCSG.
fn CompilerCsgDeepCloneDiagnostic(sourceCsg: CompilerCsg): CompilerCsg =
    var csg = sourceCsg
    var out: CompilerCsg
    out.packageId = csg.packageId
    out.sourceBundleCid = csg.sourceBundleCid
    out.sourceSnapshotCount = csg.sourceSnapshotCount
    out.entrySourceCid = csg.entrySourceCid
    if csg.diagnosticFailureArtifact.producerKinds.len > 0:
        var failureCloneErr: str
        if !diagnostic_failure.DiagnosticFailureArtifactCloneInto(
               csg.diagnosticFailureArtifact,
               out.diagnosticFailureArtifact,
               failureCloneErr):
            panic(failureCloneErr)
    if csg.diagnosticFailureAuthority.authorityKinds.len > 0:
        var authorityCloneErr: str
        if !diagnostic_authority.ParserDiagnosticAuthorityCloneInto(
               csg.diagnosticFailureAuthority,
               csg.diagnosticFailureProducerProjectionCids,
               out.diagnosticFailureAuthority,
               authorityCloneErr):
            panic(authorityCloneErr)
        out.diagnosticFailureProducerProjectionCids =
            CompilerCsgCloneFixed32Seq(
                csg.diagnosticFailureProducerProjectionCids)
    out.sourceIdentityReceipt = csg.sourceIdentityReceipt
    out.csgTransitionReceipt = csg.csgTransitionReceipt
    var ownedParserReceipt: parser_receipt.ParserNormalizedExprReceipt
    parser_receipt.ParserNormalizedExprReceiptMoveInto(
        ownedParserReceipt,
        csg.parserNormalizedExprReceipt)
    out.parserNormalizedExprReceipt =
        parser_receipt.ParserNormalizedExprReceiptClone(ownedParserReceipt)
    out.exprLayer = parser.NormalizedExprLayerClone(csg.exprLayer)
    out.typeArena = typearena.TypedExprTypeArenaClone(csg.typeArena)
    out.typeArenaMissingResolutionAuthorityCount =
        csg.typeArenaMissingResolutionAuthorityCount
    out.typeDiagnosticCompletions =
        compilerCsgTypeDiagnosticCompletionTableClone(
            csg.typeDiagnosticCompletions)
    out.typeDiagnosticStageReceipt =
        compilerCsgStageReceiptClone(
            csg.typeDiagnosticStageReceipt)
    out.ownershipDiagnosticCompletions =
        compilerCsgTypeDiagnosticCompletionTableClone(
            csg.ownershipDiagnosticCompletions)
    out.ownershipDiagnosticStageReceipt =
        compilerCsgStageReceiptClone(
            csg.ownershipDiagnosticStageReceipt)
    out.layoutDiagnosticCompletions =
        compilerCsgTypeDiagnosticCompletionTableClone(
            csg.layoutDiagnosticCompletions)
    out.layoutDiagnosticStageReceipt =
        compilerCsgStageReceiptClone(
            csg.layoutDiagnosticStageReceipt)
    out.concurrencyDiagnosticCompletions =
        compilerCsgTypeDiagnosticCompletionTableClone(
            csg.concurrencyDiagnosticCompletions)
    out.concurrencyDiagnosticStageReceipt =
        compilerCsgStageReceiptClone(
            csg.concurrencyDiagnosticStageReceipt)
    out.typedExprFacts = texpr.TypedExprFactTableClone(csg.typedExprFacts)
    out.typedExprFactCountSnapshot = csg.typedExprFactCountSnapshot
    out.typedIr = texpr.TypedExprIrClone(csg.typedIr)
    out.fnPtrFieldCalls =
        compilerCsgFnPtrFieldCallTableClone(
            csg.fnPtrFieldCalls)
    out.externFfiHandleContracts =
        compilerCsgExternFfiHandleContractTableClone(
            csg.externFfiHandleContracts)
    out.externFfiHandleCallCapabilities =
        compilerCsgExternFfiHandleCallCapabilityTableClone(
            csg.externFfiHandleCallCapabilities)
    out.nodeCount = csg.nodeCount
    out.edgeCount = csg.edgeCount
    out.nodes = CompilerCsgCloneNodes(csg.nodes)
    out.edges = CompilerCsgCloneEdges(csg.edges)
    out.canonicalGraphCid = csg.canonicalGraphCid
    out.graphCid = csg.graphCid
    out.logicalPayloadBytes = csg.logicalPayloadBytes
    out.retainedCapacityBytes = csg.retainedCapacityBytes
    out.scalarLogicalPayloadBytes = csg.scalarLogicalPayloadBytes
    out.scalarRetainedCapacityBytes = csg.scalarRetainedCapacityBytes
    out.arenaLogicalPayloadBytes = csg.arenaLogicalPayloadBytes
    out.arenaRetainedCapacityBytes = csg.arenaRetainedCapacityBytes
    out.internLogicalPayloadBytes = csg.internLogicalPayloadBytes
    out.internRetainedCapacityBytes = csg.internRetainedCapacityBytes
    out.dynamicSequenceLogicalPayloadBytes = csg.dynamicSequenceLogicalPayloadBytes
    out.dynamicSequenceRetainedCapacityBytes = csg.dynamicSequenceRetainedCapacityBytes
    out.buildIndexLogicalPayloadBytes = csg.buildIndexLogicalPayloadBytes
    out.buildIndexRetainedCapacityBytes = csg.buildIndexRetainedCapacityBytes
    out.nodesLiveBytes = csg.nodesLiveBytes
    out.edgesLiveBytes = csg.edgesLiveBytes
    out.exprLayerLiveBytes = csg.exprLayerLiveBytes
    out.typedFactsLiveBytes = csg.typedFactsLiveBytes
    out.typedIrLiveBytes = csg.typedIrLiveBytes
    out.metadataLiveBytes = csg.metadataLiveBytes
    out.sourceTextLiveBytes = csg.sourceTextLiveBytes
    out.sourceTextCapturedBytes = csg.sourceTextCapturedBytes
    out.compactProfileViewLifecycle = csg.compactProfileViewLifecycle
    out.typedIrRoundCount = csg.typedIrRoundCount
    out.typedIrBatchLimit = csg.typedIrBatchLimit
    out.typedIrRebuildSourceCount = csg.typedIrRebuildSourceCount
    out.typedIrNewFunctionCount = csg.typedIrNewFunctionCount
    out.typedFactsReleasedBeforeTypedIr = csg.typedFactsReleasedBeforeTypedIr
    out.typedIrRoundFactsMaxCount = csg.typedIrRoundFactsMaxCount
    out.typedIrRoundExprMaxCount = csg.typedIrRoundExprMaxCount
    out.typedIrReusablePeakPackedLineCount =
        csg.typedIrReusablePeakPackedLineCount
    out.typedIrReusablePeakPackedLineBytes =
        csg.typedIrReusablePeakPackedLineBytes
    out.typedIrReusableContextOwnerPeak =
        csg.typedIrReusableContextOwnerPeak
    out.typedIrRoundFactsReleaseCount = csg.typedIrRoundFactsReleaseCount
    out.typedIrRoundFactsResetCount = csg.typedIrRoundFactsResetCount
    out.roundTextArenaPeakBytes = csg.roundTextArenaPeakBytes
    out.roundTextArenaUsedBytes = csg.roundTextArenaUsedBytes
    out.roundTextArenaResetCount = csg.roundTextArenaResetCount
    out.roundTextArenaSpillCount = csg.roundTextArenaSpillCount
    out.roundTextArenaRetainedStoreBytes = csg.roundTextArenaRetainedStoreBytes
    out.typedIrBuildIndexGeneration = csg.typedIrBuildIndexGeneration
    out.typedIrBuildIndexSessionGeneration = csg.typedIrBuildIndexSessionGeneration
    out.typedIrBuildIndexContextCountAtSeal = csg.typedIrBuildIndexContextCountAtSeal
    out.typedIrBuildIndexValidationEpochAtSeal = csg.typedIrBuildIndexValidationEpochAtSeal
    out.typedIrBuildIndexValidationEpochAfterFixedPoint = csg.typedIrBuildIndexValidationEpochAfterFixedPoint
    out.typedIrBuildIndexValidationEpochAfterClose = csg.typedIrBuildIndexValidationEpochAfterClose
    out.typedIrBuildIndexMetadataRowCountAtSeal = csg.typedIrBuildIndexMetadataRowCountAtSeal
    out.typedIrBuildIndexMetadataRowCountExpectedAtSeal =
        csg.typedIrBuildIndexMetadataRowCountExpectedAtSeal
    out.typedIrBuildIndexMetadataContextCountExpectedAfterSeal =
        csg.typedIrBuildIndexMetadataContextCountExpectedAfterSeal
    out.typedIrBuildIndexMetadataContextCountObservedAfterSeal =
        csg.typedIrBuildIndexMetadataContextCountObservedAfterSeal
    out.typedIrBuildIndexMetadataRowsExpectedAfterSeal =
        csg.typedIrBuildIndexMetadataRowsExpectedAfterSeal
    out.typedIrBuildIndexMetadataRowsVisitedAfterSeal = csg.typedIrBuildIndexMetadataRowsVisitedAfterSeal
    out.typedIrBuildIndexFullValidationCount = csg.typedIrBuildIndexFullValidationCount
    out.typedIrBuildIndexSealedFactsCount = csg.typedIrBuildIndexSealedFactsCount
    out.typedIrBuildIndexSealedAppendCount = csg.typedIrBuildIndexSealedAppendCount
    out.typedIrBuildIndexSealedValidationCount = csg.typedIrBuildIndexSealedValidationCount
    out.typedIrRoundBuildMsCsv = CompilerCsgOwnText(csg.typedIrRoundBuildMsCsv)
    out.typedIrRoundNewReachableCountCsv = CompilerCsgOwnText(csg.typedIrRoundNewReachableCountCsv)
    out.typedIrRoundBuildCountCsv = CompilerCsgOwnText(csg.typedIrRoundBuildCountCsv)
    out.typedIrReachabilityScannedStatementCount = csg.typedIrReachabilityScannedStatementCount
    out.typedIrReachabilityScannedFunctionCount = csg.typedIrReachabilityScannedFunctionCount
    out.typedIrReachabilityResolvedCallRowVisitCount = csg.typedIrReachabilityResolvedCallRowVisitCount
    out.typedIrReachabilityNewReachableFunctionCount = csg.typedIrReachabilityNewReachableFunctionCount
    out.typedIrFinalStatementCount = csg.typedIrFinalStatementCount
    out.typedIrFinalFunctionCount = csg.typedIrFinalFunctionCount
    out.reachabilityNameHashOperationCount = csg.reachabilityNameHashOperationCount
    out.reachabilityNameHashProbeCount = csg.reachabilityNameHashProbeCount
    out.reachabilityNameHashMaxProbeCount = csg.reachabilityNameHashMaxProbeCount
    out.reachabilityNameIndexEntryCount = csg.reachabilityNameIndexEntryCount
    out.reachabilityLineBinarySearchOperationCount = csg.reachabilityLineBinarySearchOperationCount
    out.reachabilityLineBinarySearchProbeCount = csg.reachabilityLineBinarySearchProbeCount
    out.reachabilityLineBinarySearchMaxProbeCount = csg.reachabilityLineBinarySearchMaxProbeCount
    out.reachabilityEdgePairOperationCount = csg.reachabilityEdgePairOperationCount
    out.reachabilityEdgePairProbeCount = csg.reachabilityEdgePairProbeCount
    out.reachabilityEdgePairMaxProbeCount = csg.reachabilityEdgePairMaxProbeCount
    out.reachabilityFinalEdgeCount = csg.reachabilityFinalEdgeCount
    out.semanticGraph = CompilerCsgSemanticGraphClone(csg.semanticGraph)
    out.csgPhaseA1Ns = csg.csgPhaseA1Ns
    out.csgPhaseBNs = csg.csgPhaseBNs
    out.csgPhaseENs = csg.csgPhaseENs
    out.csgPhaseFNs = csg.csgPhaseFNs
    CompilerCsgRefreshMemoryLedger(out)
    return out

# Diagnostic/test-only compatibility name for Value(Result) callers.
# CompilerCsg contains explicitly released Arena/intern owners, so an ordinary
# value return cannot serve as a move contract. Production paths never clone:
# Into builders transfer ownership directly through out-parameters, and the
# legacy-migration production path uses BuildCompilerLegacyMigrationInto,
# which writes the caller's out without a Result temporary.
fn CompilerCsgClone(csg: CompilerCsg): CompilerCsg =
    return CompilerCsgDeepCloneDiagnostic(csg)

fn CompilerCsgReleaseBackendInputPayload(csg: var CompilerCsg) =
    CompilerCsgNormalizedExprLayerTerminalRelease(csg.exprLayer)
    var ownedTypeArena: typearena.TypedExprTypeArena
    ownedTypeArena = csg.typeArena
    csg.typeArena = nil
    typearena.TypedExprTypeArenaReleaseOwned(ownedTypeArena)
    csg.typeArenaMissingResolutionAuthorityCount = 0
    CompilerCsgFnPtrFieldCallTableRelease(
        csg.fnPtrFieldCalls)
    CompilerCsgExternFfiHandleContractTableRelease(
        csg.externFfiHandleContracts)
    CompilerCsgExternFfiHandleCallCapabilityTableRelease(
        csg.externFfiHandleCallCapabilities)
    freeSeqStrRelease(
        csg.typeDiagnosticCompletions.diagnosticCodeTexts)
    freeSeqStrRelease(
        csg.typeDiagnosticCompletions.diagnosticMessageTexts)
    csg.typeDiagnosticCompletions =
        CompilerCsgTypeDiagnosticCompletionTable()
    csg.typeDiagnosticStageReceipt.countKeys = []
    csg.typeDiagnosticStageReceipt.countValues = []
    csg.typeDiagnosticStageReceipt =
        stage_receipt.CompilerStageReceipt()
    freeSeqStrRelease(
        csg.ownershipDiagnosticCompletions.diagnosticCodeTexts)
    freeSeqStrRelease(
        csg.ownershipDiagnosticCompletions.diagnosticMessageTexts)
    csg.ownershipDiagnosticCompletions =
        CompilerCsgTypeDiagnosticCompletionTable()
    csg.ownershipDiagnosticStageReceipt.countKeys = []
    csg.ownershipDiagnosticStageReceipt.countValues = []
    csg.ownershipDiagnosticStageReceipt =
        stage_receipt.CompilerStageReceipt()
    freeSeqStrRelease(
        csg.layoutDiagnosticCompletions.diagnosticCodeTexts)
    freeSeqStrRelease(
        csg.layoutDiagnosticCompletions.diagnosticMessageTexts)
    csg.layoutDiagnosticCompletions =
        CompilerCsgTypeDiagnosticCompletionTable()
    csg.layoutDiagnosticStageReceipt.countKeys = []
    csg.layoutDiagnosticStageReceipt.countValues = []
    csg.layoutDiagnosticStageReceipt =
        stage_receipt.CompilerStageReceipt()
    freeSeqStrRelease(
        csg.concurrencyDiagnosticCompletions.diagnosticCodeTexts)
    freeSeqStrRelease(
        csg.concurrencyDiagnosticCompletions.diagnosticMessageTexts)
    csg.concurrencyDiagnosticCompletions =
        CompilerCsgTypeDiagnosticCompletionTable()
    csg.concurrencyDiagnosticStageReceipt.countKeys = []
    csg.concurrencyDiagnosticStageReceipt.countValues = []
    csg.concurrencyDiagnosticStageReceipt =
        stage_receipt.CompilerStageReceipt()
    texpr.TypedExprFactTableRelease(csg.typedExprFacts)
    csg.typedExprFactCountSnapshot = 0
    texpr.TypedExprIrReleasePayload(csg.typedIr)
    for nodeIndex in 0..<csg.nodes.len:
        csg.nodes[nodeIndex].modulePath = ""
        csg.nodes[nodeIndex].symbolText = ""
        csg.nodes[nodeIndex].factText = ""
        csg.nodes[nodeIndex].semanticSource = ""
        csg.nodes[nodeIndex].semanticParamTypeJoin = ""
        csg.nodes[nodeIndex].semanticReturnType = ""
        csg.nodes[nodeIndex].exportSymbolName = ""
    freeSeq(csg.nodes)
    freeSeq(csg.edges)
    csg.nodeCount = 0
    csg.edgeCount = 0
    CompilerCsgSemanticGraphTerminalRelease(csg.semanticGraph)
    CompilerCsgRefreshMemoryLedger(csg)

fn CompilerCsgParserCanonicalSourceSidecarRelease(
        sidecar: var parser_receipt.ParserCanonicalSourceSidecar) =
        freeSeq(sidecar.diagnosticAnchorKinds)
        freeSeq(sidecar.diagnosticAnchorNodeIds)
        freeSeq(sidecar.diagnosticOwnerDeclarationSourceLocalRows)
        freeSeq(sidecar.diagnosticSpanIds)
        freeSeq(sidecar.diagnosticSeverities)
        freeSeqStrRelease(sidecar.diagnosticCodeTexts)
        freeSeqStrRelease(sidecar.diagnosticMessageTexts)
        freeSeq(sidecar.diagnosticProofRaw32s)
        freeSeq(sidecar.spanStartBytes)
        freeSeq(sidecar.spanEndBytes)
        freeSeq(sidecar.spanStartLines)
        freeSeq(sidecar.spanStartColumns)
        freeSeq(sidecar.spanEndLines)
        freeSeq(sidecar.spanEndColumns)
        freeSeq(sidecar.nodeProducerIds)
        freeSeq(sidecar.nodeParentIds)
        freeSeq(sidecar.nodeKinds)
        freeSeq(sidecar.nodeSpanIds)
        freeSeq(sidecar.nodeChildStarts)
        freeSeq(sidecar.nodeChildCounts)
        freeSeq(sidecar.nodeChildIds)
        freeSeq(sidecar.nodeGenericStarts)
        freeSeq(sidecar.nodeGenericCounts)
        freeSeq(sidecar.nodeBindingResolutionKinds)
        freeSeq(sidecar.nodeBindingDeclarationSourceLocalRows)
        freeSeq(sidecar.nodeBindingPatternSourceLocalRows)
        freeSeq(sidecar.tokenProducerSourceIds)
        freeSeq(sidecar.tokenSourceLocalRows)
        freeSeq(sidecar.tokenLexicalParentIds)
        freeSeq(sidecar.tokenKinds)
        freeSeq(sidecar.tokenSpanIds)
