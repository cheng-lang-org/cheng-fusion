        sourceTextLookup: CompilerCsgSourceTextLookupEntry[]
        sourceTextLookupIndex: CompilerCsgSourcePathIndex
        sourceTextCache: CompilerCsgSourceTextLookupEntry[]
        sourceTextCacheIndex: CompilerCsgSourcePathIndex
        activeText: str
        activeProfile: parser.NormalizedExprCallProfile
        activeDecls: parser.NormalizedFunctionDecl[]
        activeDeclLines: str[]
        activeDeclImportcMask: str
        activeMetadataContext: texpr.TypedExprSourceContext
        activeTypedSourceText: str
