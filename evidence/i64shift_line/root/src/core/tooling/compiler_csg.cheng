# Per-round typedIr build batch size (RSS control only). The typedIr
# reachability loop keeps appending batches until the unprocessed frontier
# is empty, so this limit never truncates coverage — smaller values only
# trade rounds for peak memory (640 single-batch peak ~3GB on zc lane).
# CHENG_CSG_TYPED_IR_BATCH_LIMIT may raise this for explicitly provisioned
# mobile builds; invalid or zero values are hard errors.
const CompilerCsgTypedIrReachableBatchFunctionLimit: int32 = 128
const CompilerCsgPortableSourceIdentityReceiptWireByteLength: int32 = 204
const CompilerCsgTransitionReceiptWireByteLength: int32 = 160
# Honest published flag. True only when
# CompilerCsgTransitionReceiptPortableFromEvidence returns true: every
# local coordinate on the transition receipt has been replaced by portable
# evidence AND lowering authority has been recomputed from that evidence.
# First slice wires PortableParserReceipt only; parserReceiptCid still
# binds the local envelope, so this stays false.
const CompilerCsgTransitionReceiptPortable: bool = false
