@borrows
fn compilerExportSurfaceRowLess(surface: var CsgExportSurface,
                                left: int32,
                                right: int32): bool =
    if surface.exportedSymbols[left] != surface.exportedSymbols[right]:
        return CompilerCsgStrLess(surface.exportedSymbols[left],
                                  surface.exportedSymbols[right])
    if surface.exportedTargetNames[left] != surface.exportedTargetNames[right]:
        return CompilerCsgStrLess(surface.exportedTargetNames[left],
                                  surface.exportedTargetNames[right])
    if surface.exportedLayouts[left] != surface.exportedLayouts[right]:
        return surface.exportedLayouts[left] < surface.exportedLayouts[right]
    if surface.exportedEffects[left] != surface.exportedEffects[right]:
        return surface.exportedEffects[left] < surface.exportedEffects[right]
    return surface.exportedCapabilities[left] <
           surface.exportedCapabilities[right]

@borrows
fn compilerExportSurfaceRowClone(row: CompilerExportSurfaceRow): CompilerExportSurfaceRow =
    var out: CompilerExportSurfaceRow
    out.symbol = parser.ParserOwnedText(row.symbol)
    out.targetName = parser.ParserOwnedText(row.targetName)
    out.layoutKind = row.layoutKind
    out.effectKind = row.effectKind
    out.capabilityKind = row.capabilityKind
    return out

@borrows
fn compilerExportSurfaceOwnedRowLess(left: CompilerExportSurfaceRow,
                                     right: CompilerExportSurfaceRow): bool =
    if left.symbol != right.symbol:
        return CompilerCsgStrLess(left.symbol, right.symbol)
    if left.targetName != right.targetName:
        return CompilerCsgStrLess(left.targetName, right.targetName)
    if left.layoutKind != right.layoutKind:
        return left.layoutKind < right.layoutKind
    if left.effectKind != right.effectKind:
        return left.effectKind < right.effectKind
    return left.capabilityKind < right.capabilityKind

@borrows
fn compilerExportSurfaceMergePassRec(src: var CompilerExportSurfaceRow[],
                                     dst: var CompilerExportSurfaceRow[],
                                     width: int32,
                                     leftStart: int32) =
    while true:
        let count = src.len
        if leftStart >= count:
            return
        if leftStart % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let midRaw = leftStart + width
        var middle = count
        if midRaw < count:
            middle = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = middle
        for outIndex in leftStart..<rightEnd:
            if left < middle &&
               (right >= rightEnd ||
                !compilerExportSurfaceOwnedRowLess(src[right], src[left])):
                dst[outIndex] = src[left]
                left = left + 1
            else:
                dst[outIndex] = src[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

fn compilerExportSurfaceMergePass(src: var CompilerExportSurfaceRow[],
                                  dst: var CompilerExportSurfaceRow[],
                                  width: int32) =
    compilerExportSurfaceMergePassRec(src, dst, width, 0)

@borrows
fn compilerExportSurfaceCopyRowsRec(dst: var CompilerExportSurfaceRow[],
                                    src: var CompilerExportSurfaceRow[],
                                    index: int32,
                                    count: int32) =
    while true:
        if index >= count:
            return
        dst[index] = src[index]
        index = index + 1
        continue

@borrows
fn compilerExportSurfaceCloneRowsRec(dst: var CompilerExportSurfaceRow[],
                                     src: var CompilerExportSurfaceRow[],
                                     index: int32,
                                     count: int32) =
    while true:
        if index >= count:
            return
        add(dst, compilerExportSurfaceRowClone(src[index]))
        index = index + 1
        continue

@borrows
fn compilerExportSurfaceSortRowsWidthRec(
        rows: var CompilerExportSurfaceRow[],
        scratch: var CompilerExportSurfaceRow[],
        count: int32,
        width: int32,
        readScratch: bool): bool =
    while true:
        if width >= count:
            return readScratch
        if readScratch:
            compilerExportSurfaceMergePass(scratch, rows, width)
        else:
            compilerExportSurfaceMergePass(rows, scratch, width)
        var nextWidth = width * 2
        if width > count / 2:
            nextWidth = count
        width = nextWidth
        readScratch = !readScratch
        continue

fn compilerExportSurfaceSortRows(rows: var CompilerExportSurfaceRow[]) =
    if rows.len <= 1:
        return
    let count = rows.len
    var scratch: CompilerExportSurfaceRow[]
    compilerExportSurfaceCloneRowsRec(scratch, rows, 0, count)
    let readScratch = compilerExportSurfaceSortRowsWidthRec(
        rows, scratch, count, 1, false)
    if readScratch:
        compilerExportSurfaceCopyRowsRec(rows, scratch, 0, count)

@borrows
fn compilerExportSurfaceCollectRowsRec(
        surface: CsgExportSurface,
        rows: var CompilerExportSurfaceRow[],
        index: int32) =
    while true:
        if index >= surface.exportedSymbols.len:
            return
        var row: CompilerExportSurfaceRow
        row.symbol = strings.CloneStr(surface.exportedSymbols[index])
        row.targetName = strings.CloneStr(surface.exportedTargetNames[index])
        row.layoutKind = surface.exportedLayouts[index]
        row.effectKind = surface.exportedEffects[index]
        row.capabilityKind = surface.exportedCapabilities[index]
        add(rows, row)
        index = index + 1
        continue

@borrows
fn compilerExportSurfaceWriteRowsRec(
        surface: var CsgExportSurface,
        rows: var CompilerExportSurfaceRow[],
        index: int32) =
    while true:
        if index >= rows.len:
            return
        let symbol = parser.ParserOwnedText(rows[index].symbol)
        let targetName = parser.ParserOwnedText(rows[index].targetName)
        add(surface.exportedSymbols, symbol)
        add(surface.exportedTargetNames, targetName)
        add(surface.exportedLayouts, rows[index].layoutKind)
        add(surface.exportedEffects, rows[index].effectKind)
        add(surface.exportedCapabilities, rows[index].capabilityKind)
        index = index + 1
        continue

fn compilerExportSurfaceSort(surface: var CsgExportSurface) =
    var rows: CompilerExportSurfaceRow[]
    compilerExportSurfaceCollectRowsRec(surface, rows, 0)
    compilerExportSurfaceSortRows(rows)
    surface.exportedSymbols = []
    surface.exportedTargetNames = []
    surface.exportedLayouts = []
    surface.exportedEffects = []
    surface.exportedCapabilities = []
    compilerExportSurfaceWriteRowsRec(surface, rows, 0)

fn compilerExportSurfaceCid(surface: var CsgExportSurface): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerCsgAppendText(buf, "cheng.compiler.export_surface")
    CompilerCsgAppendText(buf, surface.packageId)
    compilerCsgPortableAppendU32Field(buf, surface.exportedSymbolCount)
    for i in 0..<surface.exportedSymbols.len:
        CompilerCsgAppendText(buf, surface.exportedSymbols[i])
        CompilerCsgAppendText(buf, surface.exportedTargetNames[i])
        compilerCsgPortableAppendU32Field(buf, surface.exportedLayouts[i])
        compilerCsgPortableAppendU32Field(buf, surface.exportedEffects[i])
        compilerCsgPortableAppendU32Field(buf, surface.exportedCapabilities[i])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerExportSurfaceTextSafe(value: str): bool =
    if value == "":
        return false
    for index in 0..<value.len:
        if value[index] == '|' || value[index] == '\n' ||
           value[index] == '\r' || value[index] == '=':
            return false
    return true

fn CompilerExportSurfaceStrictValidateInto(surface: var CsgExportSurface,
                                           err: var str): bool =
    if !compilerExportSurfaceTextSafe(surface.packageId) ||
       parser.ParserManifestNormalizePackageId(surface.packageId) !=
           surface.packageId:
        err = " compiler csg: export surface package identity invalid"
        return false
    let count = surface.exportedSymbolCount
    if count < 0 || surface.exportedSymbols.len != count ||
       surface.exportedTargetNames.len != count ||
       surface.exportedLayouts.len != count ||
       surface.exportedEffects.len != count ||
       surface.exportedCapabilities.len != count:
        err = " compiler csg: export surface column shape mismatch"
        return false
    for index in 0..<count:
        if !compilerExportSurfaceTextSafe(surface.exportedSymbols[index]) ||
           !compilerExportSurfaceTextSafe(surface.exportedTargetNames[index]):
            err = Fmt" compiler csg: export surface row text invalid index={index}"
            return false
        if index > 0 &&
           !compilerExportSurfaceRowLess(surface, index - 1, index):
            err = Fmt" compiler csg: export surface rows are not strictly canonical index={index}"
            return false
    let expectedCid = compilerExportSurfaceCid(surface)
    if layout.FixedBytes32Equal(surface.surfaceCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(surface.surfaceCid, expectedCid):
        err = " compiler csg: export surface cid mismatch"
        return false
    err = ""
    return true

fn CompilerExportSurfaceFromCsgInto(csg: var CompilerCsg,
                                    out: var CsgExportSurface) =
    out.packageId = csg.packageId
    out.exportedSymbols = []
    out.exportedTargetNames = []
    out.exportedLayouts = []
    out.exportedEffects = []
    out.exportedCapabilities = []
    for i in 0..<csg.nodes.len:
        let node = csg.nodes[i]
        if node.nodeKind != CompilerCsgNodeKindSymbol:
            continue
        if node.exportedFlag == 0:
            continue
        add(out.exportedSymbols, parser.ParserOwnedText(node.symbolText))
        add(out.exportedTargetNames, parser.ParserOwnedText(node.exportSymbolName))
        add(out.exportedLayouts, node.resultLayoutKind)
        add(out.exportedEffects, node.effectKind)
        add(out.exportedCapabilities, node.capabilityKind)
    out.exportedSymbolCount = out.exportedSymbols.len
    compilerExportSurfaceSort(out)
    out.surfaceCid = compilerExportSurfaceCid(out)
 
fn CompilerExportSurfaceFromCsg(csg: CompilerCsg): CsgExportSurface =
    var borrowed = csg
    var out: CsgExportSurface
    CompilerExportSurfaceFromCsgInto(borrowed, out)
    return out

@borrows
fn CompilerExportSurfaceCompatible(base: CsgExportSurface,
                                     next: CsgExportSurface): bool =
    if base.packageId != next.packageId:
        return false
    if base.exportedSymbolCount != next.exportedSymbolCount:
        return false
    for i in 0..<base.exportedSymbolCount:
        if base.exportedSymbols[i] != next.exportedSymbols[i]:
            return false
        if base.exportedTargetNames[i] != next.exportedTargetNames[i]:
            return false
        if base.exportedLayouts[i] != next.exportedLayouts[i]:
            return false
        if base.exportedEffects[i] != next.exportedEffects[i]:
            return false
        if base.exportedCapabilities[i] != next.exportedCapabilities[i]:
            return false
    return true

@borrows
fn compileReceiptCid(receipt: CompileReceipt): layout.FixedBytes32 =
    return receipt_codec.CompileReceiptCodecCid(receipt)

@borrows
fn CompileReceiptStrictValidateInto(receipt: CompileReceipt,
                                    err: var str): bool =
    return receipt_codec.CompileReceiptCodecStrictValidateInto(receipt, err)

@borrows
fn CompileReceiptMakeInto(
        worldHeadCid: layout.FixedBytes32,
        sourceIdentityReceiptCid: layout.FixedBytes32,
        semanticReceiptCid: layout.FixedBytes32,
        targetTriple: str,
        outputRawSha256: layout.FixedBytes32,
        canonicalOutputDigest: layout.FixedBytes32,
        bootstrapStage: str,
        runtimeProviderSet: str[],
        outReceipt: var CompileReceipt,
        err: var str): bool =
    var next: CompileReceipt
    next.worldHeadCid = worldHeadCid
    next.sourceIdentityReceiptCid = sourceIdentityReceiptCid
    next.semanticReceiptCid = semanticReceiptCid
    next.targetTriple = share(targetTriple)
    next.outputDigest = outputRawSha256
    next.canonicalOutputDigest = canonicalOutputDigest
    next.bootstrapStage = share(bootstrapStage)
    next.runtimeProviderSet = CompilerCsgCloneStrSeq(runtimeProviderSet)
    next.receiptCid = compileReceiptCid(next)
    if !CompileReceiptStrictValidateInto(next, err):
        return false
    outReceipt = next
    err = ""
    return true

@borrows
fn CompileOutputReceiptCid(compileReceiptCid: layout.FixedBytes32,
                            outputSha256: layout.FixedBytes32,
                            backend2VersionManifestSha256: layout.FixedBytes32,
                            targetTriple: str): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerCsgAppendText(buf, "cheng.compiler.output_receipt")
    compilerCsgPortableAppendFixed32Field(buf, compileReceiptCid)
    compilerCsgPortableAppendFixed32Field(buf, outputSha256)
    compilerCsgPortableAppendFixed32Field(
        buf,
        backend2VersionManifestSha256)
    CompilerCsgAppendText(buf, targetTriple)
    CompilerCsgAppendText(buf, "unelaborated")
    CompilerCsgAppendText(buf, "full_backend_codegen=1")
    CompilerCsgAppendText(buf, "cold_system_link_exec=0")
    CompilerCsgAppendText(buf, "system_link_exec_scope=selfhost_direct")
    return CompilerCsgBufCid(buf)

@borrows
fn CompileOutputDigest(outputPath: str,
                         targetTriple: str,
                         providerModules: str[],
                         csgCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(256)
    CompilerCsgAppendText(buf, "cheng.compiler.output_digest")
    let _ = outputPath
    CompilerCsgAppendText(buf, targetTriple)
    CompilerCsgAppendFixed32(buf, csgCid)
    CompilerCsgAppendU32BE(buf, providerModules.len)
    let providerModuleCount = providerModules.len
    var providerModuleIndex: int32
    while providerModuleIndex < providerModuleCount:
        CompilerCsgAppendText(buf, providerModules[providerModuleIndex])
        providerModuleIndex = providerModuleIndex + 1
    return CompilerCsgBufCid(buf)

