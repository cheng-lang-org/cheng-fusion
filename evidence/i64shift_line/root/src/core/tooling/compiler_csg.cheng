    if compilerCsgMemTrace:
        if work.typeArena != nil:
            let arenaTag = Fmt"type_arena cap={arenamod.ArenaCapacity(work.typeArena.arena)} used={arenamod.ArenaUsed(work.typeArena.arena)} types={work.typeArena.typeCount} tokens={work.typeArena.tokenCount}"
            compilerCsgMemTraceEmit(arenaTag)
        if work.typedIr.arena.capacityBytes > 0:
            let irTag = Fmt"typed_ir cap={arenamod.ArenaCapacity(work.typedIr.arena)} used={arenamod.ArenaUsed(work.typedIr.arena)}"
            compilerCsgMemTraceEmit(irTag)
        let factsTag = Fmt"facts count={CompilerCsgSemanticTypedFactCount(work.semanticGraph)}"
        compilerCsgMemTraceEmit(factsTag)
    if !texpr.TypedExprIrBindExactTypeArena(
           work.typedIr, work.typeArena, err):
        return CompilerCsgBuildAbort(work)
    if !compilerCsgBindTypedIrExactDeclarationLayoutsInto(
           work.parserNormalizedExprReceiptAccumulator,
           work.typedMetadataContexts,
           work.typedIr,
           err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgTraceStage("after_type_arena_production")
    if !CompilerCsgCompactProfileViewLifecycleValidate(
            work.compactProfileViewLifecycle,
            err):
        return CompilerCsgBuildAbort(work)
    var finalSymbolCount: int32
    compilerCsgBuildFinalSymbolCountRec(work, 0, finalSymbolCount)
    if finalSymbolCount != work.reachableSet.functionNames.len:
        err = Fmt" compiler csg: symbol/function coverage mismatch symbols={finalSymbolCount} functions={work.reachableSet.functionNames.len}"
        return CompilerCsgBuildAbort(work)
