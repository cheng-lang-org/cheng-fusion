    out.exactLayoutFieldMemberRows =
        CompilerCsgCloneInt32Seq(source.exactLayoutFieldMemberRows)
    out.exactLayoutFieldOwnerTypeArenaIds =
        CompilerCsgCloneInt32Seq(
            source.exactLayoutFieldOwnerTypeArenaIds)
    out.exactLayoutFieldOrdinals =
        CompilerCsgCloneInt32Seq(source.exactLayoutFieldOrdinals)
    out.exactLayoutFieldTypeArenaIds =
        CompilerCsgCloneInt32Seq(source.exactLayoutFieldTypeArenaIds)
    out.exactLayoutFieldOffsetBytes =
        CompilerCsgCloneInt32Seq(source.exactLayoutFieldOffsetBytes)
    out.exactLayoutFieldSizeBytes =
        CompilerCsgCloneInt32Seq(source.exactLayoutFieldSizeBytes)
    out.exactLayoutFieldAlignBytes =
        CompilerCsgCloneInt32Seq(source.exactLayoutFieldAlignBytes)
    out.exactLayoutFieldSourceRowStarts =
        CompilerCsgCloneInt32Seq(
            source.exactLayoutFieldSourceRowStarts)
    out.exactLayoutFieldSourceRowCounts =
        CompilerCsgCloneInt32Seq(
            source.exactLayoutFieldSourceRowCounts)
    out.exactLayoutFieldSourceRowIndexes =
        CompilerCsgCloneInt32Seq(
            source.exactLayoutFieldSourceRowIndexes)
    return out

@borrows
fn compilerCsgStageReceiptClone(
        source: stage_receipt.CompilerStageReceipt): stage_receipt.CompilerStageReceipt =
    var out: stage_receipt.CompilerStageReceipt
    out.stageKind = parser.ParserOwnedText(source.stageKind)
    out.laneKind = parser.ParserOwnedText(source.laneKind)
    out.producerIdentity = parser.ParserOwnedText(source.producerIdentity)
    out.predecessorRaw32 = source.predecessorRaw32
    out.artifactRaw32 = source.artifactRaw32
    out.countKeys = CompilerCsgCloneStrSeq(source.countKeys)
    out.countValues = CompilerCsgCloneInt64Seq(source.countValues)
    out.receiptRaw32 = source.receiptRaw32
    return out

@borrows
