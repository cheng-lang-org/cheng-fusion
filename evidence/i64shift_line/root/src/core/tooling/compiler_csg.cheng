    total = total + CompilerCsgIntArrayBytesMode(
        table.effectCounts, retainedCapacity)
    total = total + CompilerCsgFixed32ArrayBytesMode(
        table.effectProjectionCids, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopEffectRows, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopOrdinals, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopNodeIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopOpKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopExactTypeIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopOwnerProducerSourceIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopOwnerDeclarationSourceLocalRows,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopOperand0NodeIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopFieldProducerSourceIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopFieldOwnerDeclarationSourceLocalRows,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopFieldDeclarationSourceLocalRows,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopFieldOrdinals, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopFieldBuiltinKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.hopIndexNodeIndexes, retainedCapacity)
    total = total + CompilerCsgFixed32ArrayBytesMode(
        table.hopCids, retainedCapacity)
    return total

