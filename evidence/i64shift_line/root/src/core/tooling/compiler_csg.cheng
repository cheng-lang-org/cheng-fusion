        t4StepNs = compilerCsgT4NowNs()
    if compilerCsgMemTrace:
        compilerCsgMemTraceEmit("metadata_contexts_built")
        compilerCsgMemTraceEmit(
            Fmt"pool_probe line_intern={langintern.InternPoolCount(work.lineInternPool)} line_payload={langintern.InternPoolLogicalPayloadBytes(work.lineInternPool)}")
        # [ctx-column-probe] Diagnostic only: element counts per metadata
        # context column, plus byte sums for the two dense text columns.
        var ctxProbeIndex: int32
        var ctxProbeSkip: int32
        while ctxProbeIndex < work.typedMetadataContexts.len:
            if ctxProbeSkip == 0:
                let ctxProbe = work.typedMetadataContexts[ctxProbeIndex]
                var ctxProbeBuildRows: int32 = -1
                if ctxProbe.buildIndex != nil:
                    ctxProbeBuildRows = ctxProbe.buildIndex.entryKindIds.len
                var ctxProbeLineBytes: int64
                var ctxProbeLineIndex: int32
                while ctxProbeLineIndex < ctxProbe.lines.len:
                    ctxProbeLineBytes =
                        ctxProbeLineBytes +
                            Int64(ctxProbe.lines[ctxProbeLineIndex].len)
                    ctxProbeLineIndex = ctxProbeLineIndex + 1
                var ctxProbeTypeBytes: int64
                var ctxProbeTypeIndex: int32
                while ctxProbeTypeIndex < ctxProbe.declaredTypes.len:
