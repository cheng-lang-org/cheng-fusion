        packageId: str
        sourceBundleCid: layout.FixedBytes32
        sourceSnapshotCount: int32
        entrySourceCid: layout.FixedBytes32
        # Set only when the unique build outcome is a structured parser
        # failure. It is independent from every accepted snapshot root.
        diagnosticFailureArtifact: diagnostic_failure.DiagnosticFailureArtifact
        diagnosticFailureAuthority: diagnostic_authority.ParserDiagnosticAuthority
