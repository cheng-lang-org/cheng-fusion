        exprLayer: parser.NormalizedExprLayer
        # Exact structural type producer retained for semantic snapshot
        # admission. nil is valid only when the sealed parser forest proves
        # that nominal resolution authority is still missing; the exact
        # missing edge count below makes that state non-publishable.
        typeArena: typearena.TypedExprTypeArena
        typeArenaMissingResolutionAuthorityCount: int32
        typeDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
        typeDiagnosticStageReceipt: stage_receipt.CompilerStageReceipt
        ownershipDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
        ownershipDiagnosticStageReceipt: stage_receipt.CompilerStageReceipt
        layoutDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
        layoutDiagnosticStageReceipt: stage_receipt.CompilerStageReceipt
        concurrencyDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
        concurrencyDiagnosticStageReceipt: stage_receipt.CompilerStageReceipt
        typedExprFacts: TypedExprFactTable
        typedExprFactCountSnapshot: int32
        typedIr: texpr.TypedExprIr
