    total = total + Int64(arenamod.ArenaArrayInt32Len(
        ir.arena,
        ir.valueDefinitionGroups_patternSourceLocalRows) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(
        ir.arena, ir.valueDefinitionGroups_definitionRows) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(
        ir.arena, ir.valueDefinitionGroups_consumedFlags) * 4)
    total = total + Int64(ir.statements2_statementIndexs.len) * CompilerCsgTypedIrStatementRowBytes()
