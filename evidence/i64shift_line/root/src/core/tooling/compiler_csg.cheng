    # 轮次上界由循环顶收敛门禁硬证明 (round > functionCount+1 即 fail),
    # 容量按 3*(functionCount+2) 段 * 20B 精确预留。
    CompilerCsgPhaseArenaRoundTextStoreBegin(work,
                                             work.reachableSet.functionNames.len)
    var typedIrReachState: compilerCsgTypedIrReachState = new(compilerCsgTypedIrReachState)
    typedIrReachState.reachableFilterActive = work.reachableSet.active
    typedIrReachState.typedIrBatchFunctionLimit = typedIrBatchFunctionLimit
    if !compilerCsgBuildTypedIrReach(work, typedIrReachState, err):
