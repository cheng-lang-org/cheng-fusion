fn CompilerCsgTypedIrMetadataLiveBytes(ir: var texpr.TypedExprIr): int64 =
    var total: int64
    total = total + Int64(ir.coldCsgTypeRows.len) * CompilerCsgColdTypeRowBytes()
    for i in 0..<ir.coldCsgTypeRows.len:
        total = total + Int64(len(ir.coldCsgTypeRows[i].sourcePath))
        total = total + Int64(len(ir.coldCsgTypeRows[i].typeName))
        total = total + Int64(len(ir.coldCsgTypeRows[i].specs))
        total = total + Int64(len(ir.coldCsgTypeRows[i].typeParams))
    total = total + Int64(ir.coldCsgStatementRows.len) * CompilerCsgColdStatementRowBytes()
    for i in 0..<ir.coldCsgStatementRows.len:
        total = total + Int64(len(ir.coldCsgStatementRows[i].sourcePath))
        total = total + Int64(len(ir.coldCsgStatementRows[i].functionName))
        total = total + Int64(len(ir.coldCsgStatementRows[i].kind))
        total = total + Int64(len(ir.coldCsgStatementRows[i].payloadText))
    total = total + CompilerCsgStringArrayLiveBytes(ir.globalSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.globalNames)
    total = total + CompilerCsgStringArrayLiveBytes(ir.globalTypes)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.globalProducerSourceIndexes)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.globalDeclarationSourceLocalRows)
    total = total + CompilerCsgStringArrayLiveBytes(ir.localBindingSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.localBindingFunctionNames)
    total = total + CompilerCsgIntArrayLiveBytes(ir.localBindingLineNumbers)
    total = total + CompilerCsgStringArrayLiveBytes(ir.localBindingNames)
    total = total + CompilerCsgStringArrayLiveBytes(ir.localBindingTypes)
    total = total + CompilerCsgStringArrayLiveBytes(ir.importcSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.importcNames)
    total = total + CompilerCsgStringArrayLiveBytes(ir.importcReturnTypes)
    total = total + CompilerCsgStringArrayLiveBytes(ir.importcTargetSymbols)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeLayoutSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeLayoutNames)
    total = total + CompilerCsgIntArrayLiveBytes(ir.typeLayoutSizeBytes)
    total = total + CompilerCsgIntArrayLiveBytes(ir.typeLayoutAlignBytes)
    total = total + CompilerCsgIntArrayLiveBytes(ir.typeLayoutFieldCounts)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.typeLayoutProducerSourceIndexes)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.typeLayoutDeclarationSourceLocalRows)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.typeLayoutBuiltinKinds)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeFieldSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeFieldOwnerTypes)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeFieldNames)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeFieldTypes)
    total = total + CompilerCsgIntArrayLiveBytes(ir.typeFieldOffsetBytes)
    total = total + CompilerCsgIntArrayLiveBytes(ir.typeFieldSizeBytes)
    total = total + CompilerCsgIntArrayLiveBytes(ir.typeFieldAlignBytes)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.typeFieldProducerSourceIndexes)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.typeFieldOwnerDeclarationSourceLocalRows)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.typeFieldDeclarationSourceLocalRows)
    total = total + CompilerCsgIntArrayLiveBytes(ir.typeFieldOrdinals)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.typeFieldBuiltinKinds)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.exactLayoutIndexSourceStarts)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.exactLayoutTypeDeclarationRows)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.exactLayoutTypeBuiltinRows)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.exactLayoutFieldDeclarationRows)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.exactLayoutFieldBuiltinRows)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.exactLayoutOwnerDeclarationFieldCounts)
    total = total + CompilerCsgIntArrayLiveBytes(
        ir.exactLayoutOwnerBuiltinFieldCounts)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeDefAliasSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeDefAliasNames)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeDefAliasTargetTypes)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeAliasSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeAliasQualifiers)
    total = total + CompilerCsgStringArrayLiveBytes(ir.typeAliasTargetSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.enumValueSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.enumValueNames)
    total = total + CompilerCsgStringArrayLiveBytes(ir.enumValueTypes)
    total = total + CompilerCsgIntArrayLiveBytes(ir.enumValueOrdinals)
    total = total + CompilerCsgStringArrayLiveBytes(ir.refObjectSourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(ir.refObjectTypeNames)
    total = total + CompilerCsgStringArrayLiveBytes(ir.sourceContextIndexSourcePaths)
    total = total + CompilerCsgIntArrayLiveBytes(ir.sourceContextIndexBucketHeads)
    total = total + CompilerCsgIntArrayLiveBytes(ir.sourceContextIndexEntryNext)
    total = total + CompilerCsgIntArrayLiveBytes(ir.sourceContextIndexEntryIndexes)
    total = total + texpr.TypedExprBuildIndexLiveBytes(ir.buildIndex)
    return total

fn CompilerCsgMetadataContextsLiveBytes(contexts: var texpr.TypedExprSourceContext[]): int64 =
    var total: int64 = Int64(contexts.len) * CompilerCsgMetadataContextRowBytes()
    for i in 0..<contexts.len:
        total = total + Int64(len(contexts[i].sourcePath))
        total = total + Int64(len(contexts[i].normalizedSourcePath))
        total = total + CompilerCsgStringArrayLiveBytes(contexts[i].lines)
        total = total + Int64(contexts[i].scopes.len) * CompilerCsgFunctionScopeRowBytes()
        for scopeIndex in 0..<contexts[i].scopes.len:
            total = total + Int64(len(contexts[i].scopes[scopeIndex].sourcePath))
            total = total + Int64(len(contexts[i].scopes[scopeIndex].name))
            total = total + Int64(len(contexts[i].scopes[scopeIndex].returnType))
        total = total + Int64(contexts[i].bindings.len) * CompilerCsgBindingRowBytes()
        for bindingIndex in 0..<contexts[i].bindings.len:
            total = total + Int64(len(contexts[i].bindings[bindingIndex].sourcePath))
            total = total + Int64(len(contexts[i].bindings[bindingIndex].functionName))
            total = total + Int64(len(contexts[i].bindings[bindingIndex].name))
            total = total + Int64(len(contexts[i].bindings[bindingIndex].typeText))
        total = total + Int64(contexts[i].importcFunctions.len) * CompilerCsgImportcFunctionRowBytes()
        for importcIndex in 0..<contexts[i].importcFunctions.len:
            total = total + Int64(len(contexts[i].importcFunctions[importcIndex].sourcePath))
            total = total + Int64(len(contexts[i].importcFunctions[importcIndex].name))
            total = total + Int64(len(contexts[i].importcFunctions[importcIndex].importName))
            total = total + Int64(len(contexts[i].importcFunctions[importcIndex].returnType))
            total = total + Int64(len(contexts[i].importcFunctions[importcIndex].ffiOutPtrArgs))
            total = total + Int64(len(contexts[i].importcFunctions[importcIndex].ffiOwnedResultFree))
        total = total + Int64(contexts[i].importedModules.len) * CompilerCsgImportedModuleRowBytes()
        for moduleIndex in 0..<contexts[i].importedModules.len:
            total = total + Int64(len(contexts[i].importedModules[moduleIndex].qualifier))
            total = total + Int64(len(contexts[i].importedModules[moduleIndex].targetSourcePath))
        total = total + CompilerCsgStringArrayLiveBytes(contexts[i].declaredTypes)
        total = total + CompilerCsgStringArrayLiveBytes(contexts[i].refTypes)
        total = total + CompilerCsgStringArrayLiveBytes(contexts[i].typeDefAliasNames)
        total = total + CompilerCsgStringArrayLiveBytes(contexts[i].typeDefAliasTargetTypes)
        total = total + Int64(contexts[i].typeFields.len) * CompilerCsgTypeFieldRowBytes()
        for fieldIndex in 0..<contexts[i].typeFields.len:
            total = total + Int64(len(contexts[i].typeFields[fieldIndex].ownerType))
            total = total + Int64(len(contexts[i].typeFields[fieldIndex].fieldName))
            total = total + Int64(len(contexts[i].typeFields[fieldIndex].fieldType))
        total = total + Int64(contexts[i].coldCsgTypeRows.len) * CompilerCsgColdTypeRowBytes()
        total = total + Int64(contexts[i].coldCsgStatementRows.len) * CompilerCsgColdStatementRowBytes()
        total = total + CompilerCsgStringArrayLiveBytes(contexts[i].enumValueNames)
        total = total + CompilerCsgStringArrayLiveBytes(contexts[i].enumValueTypes)
        total = total + CompilerCsgIntArrayLiveBytes(contexts[i].enumValueOrdinals)
        total = total + CompilerCsgIntArrayLiveBytes(contexts[i].exprLineColumnHeads)
        total = total + CompilerCsgIntArrayLiveBytes(contexts[i].exprLineColumnValues)
        total = total + CompilerCsgIntArrayLiveBytes(contexts[i].exprLineColumnNext)
    return total

fn CompilerCsgLogicalPayloadBytes(csg: var CompilerCsg): int64 =
    CompilerCsgRefreshMemoryLedger(csg)
    return csg.logicalPayloadBytes

fn CompilerCsgRetainedCapacityBytes(csg: var CompilerCsg): int64 =
    CompilerCsgRefreshMemoryLedger(csg)
    return csg.retainedCapacityBytes

@borrows
fn CompilerCsgSemanticFindSourceIndex(cache: var CompilerCsgSourcePathIndex,
                                sourcePathRaw: str): int32 =
    var sourceIndex: int32
    var pathErr: str
    if !CompilerCsgSourcePathIndexFind(cache,
                                       sourcePathRaw,
                                       sourceIndex,
                                       pathErr):
        panic(pathErr)
    return sourceIndex

fn CompilerCsgSemanticBoolToInt(value: bool): int32 =
    if value:
        return 1
    return 0

fn CompilerCsgSemanticInit(): CompilerCsgSemanticGraph =
    var out: CompilerCsgSemanticGraph
    out.builderName = "BuildCompilerCsgSemanticConsumeEntryTextInto"
    return out

@borrows
fn CompilerCsgSemanticBuildSourceDeclImportTablesRec(
        semanticGraph: var CompilerCsgSemanticGraph,
        sources: var str[],
        modules: var str[],
        profiles: var parser.NormalizedExprCallProfile[],
        sourceIndexCache: var CompilerCsgSourcePathIndex,
        sourceIndex: int32,
        err: var str): bool =
    while true:
        if sourceIndex >= sources.len:
            return true
        if sourceIndex % 64 == 0:
            os.ProcessResourceGuardCheck()
        let sourcePath = sources[sourceIndex]
        var modulePath: str
        if sourceIndex < modules.len:
            modulePath = modules[sourceIndex]
        var textBytes: int32
        var declStart = semanticGraph.declTable.names.len
        var importStart = semanticGraph.importEdgeTable.ownerModulePaths.len
        if sourceIndex < profiles.len:
            textBytes = len(profiles[sourceIndex].text)
            for declIndex in 0..<profiles[sourceIndex].decls.len:
                let decl = profiles[sourceIndex].decls[declIndex]
                add(semanticGraph.declTable.sourceIndex, sourceIndex)
                add(semanticGraph.declTable.names, share(decl.name))
                add(semanticGraph.declTable.lineNumbers, decl.lineIndex)
                add(semanticGraph.declTable.importc, decl.importc)
                add(semanticGraph.declTable.exported,
                    parser.ParserIdentifierLanguageExported(decl.name))
            for edgeIndex in 0..<profiles[sourceIndex].importEdges.len:
                let edge = profiles[sourceIndex].importEdges[edgeIndex]
                if !edge.resolved:
                    err = Fmt" compiler csg: unresolved import edge owner_source={sourcePath} edge_index={edgeIndex}"
                    return false
                let targetSourceIndex = CompilerCsgSemanticFindSourceIndex(
                    sourceIndexCache, edge.targetSourcePath)
                if targetSourceIndex < 0 || targetSourceIndex >= sources.len:
                    err = Fmt" compiler csg: import edge target source missing owner_source={sourcePath} target_source={edge.targetSourcePath} edge_index={edgeIndex}"
                    return false
                add(semanticGraph.importEdgeTable.ownerSourceIndex, sourceIndex)
                add(semanticGraph.importEdgeTable.targetSourceIndex,
                    targetSourceIndex)
                add(semanticGraph.importEdgeTable.ownerModulePaths,
                    share(edge.ownerModulePath))
                add(semanticGraph.importEdgeTable.targetModulePaths,
                    share(edge.targetModulePath))
                add(semanticGraph.importEdgeTable.targetSourcePaths,
                    share(edge.targetSourcePath))
                add(semanticGraph.importEdgeTable.resolved, edge.resolved)
        let ownedSourcePath = parser.ParserOwnedText(sourcePath)
        let ownedModulePath = parser.ParserOwnedText(modulePath)
        add(semanticGraph.sourceTable.sourcePaths, ownedSourcePath)
        add(semanticGraph.sourceTable.modulePaths, ownedModulePath)
        add(semanticGraph.sourceTable.textBytes, textBytes)
        add(semanticGraph.sourceTable.declStart, declStart)
        let sourceDeclCount = semanticGraph.declTable.names.len - declStart
        add(semanticGraph.sourceTable.declCount, sourceDeclCount)
        add(semanticGraph.sourceTable.importEdgeStart, importStart)
        let sourceImportEdgeCount =
            semanticGraph.importEdgeTable.ownerModulePaths.len - importStart
        add(semanticGraph.sourceTable.importEdgeCount, sourceImportEdgeCount)
        sourceIndex = sourceIndex + 1
        continue

fn CompilerCsgSemanticBuildSourceDeclImportTables(semanticGraph: var CompilerCsgSemanticGraph,
                                            sources: var str[],
                                            modules: var str[],
                                            profiles: var parser.NormalizedExprCallProfile[],
                                            sourceIndexCache: var CompilerCsgSourcePathIndex,
                                            err: var str): bool =
    semanticGraph.sourceTable = CompilerCsgSemanticSourceTable()
    semanticGraph.declTable = CompilerCsgSemanticDeclTable()
    semanticGraph.importEdgeTable = CompilerCsgSemanticImportEdgeTable()
    if !CompilerCsgSemanticBuildSourceDeclImportTablesRec(
           semanticGraph, sources, modules, profiles, sourceIndexCache,
           0, err):
        return false
    err = ""
    return true

fn CompilerCsgSemanticBuildReachableTable(semanticGraph: var CompilerCsgSemanticGraph,
                                    sources: var str[],
                                    reachableSet: var CompilerCsgReachableFunctionSet,
                                    sourceIndexCache: var CompilerCsgSourcePathIndex,
                                    err: var str): bool =
    semanticGraph.reachableFunctionTable = CompilerCsgSemanticReachableFunctionTable()
    let functionCount = reachableSet.functionNames.len
    if reachableSet.sourcePaths.len != functionCount ||
       reachableSet.symbolTexts.len != functionCount ||
       reachableSet.producerSourceIndexes.len != functionCount ||
       reachableSet.producerDeclarationIndexes.len != functionCount ||
       reachableSet.functionNameSurfaceKinds.len != functionCount ||
       reachableSet.functionNameProofCids.len != functionCount ||
       reachableSet.functionAnnotationFlags.len != functionCount ||
       reachableSet.functionDeclarationHeaderCids.len != functionCount ||
       reachableSet.functionDeclarationPathCids.len != functionCount ||
       reachableSet.keepExportBindingCids.len != functionCount ||
       reachableSet.startLines.len != functionCount ||
       reachableSet.endLines.len != functionCount ||
       reachableSet.reachable.len != functionCount:
        err = Fmt" compiler csg: reachable function columns corrupt functions={functionCount} sources={reachableSet.sourcePaths.len} symbols={reachableSet.symbolTexts.len} starts={reachableSet.startLines.len} ends={reachableSet.endLines.len} reachable={reachableSet.reachable.len}"
        return false
    for i in 0..<reachableSet.functionNames.len:
        if i % 256 == 0:
            os.ProcessResourceGuardCheck()
        let sourcePath = reachableSet.sourcePaths[i]
        let producerSourceIndex =
            reachableSet.producerSourceIndexes[i]
        let canonicalSourceIndex = CompilerCsgSemanticFindSourceIndex(
            sourceIndexCache, sourcePath)
        if producerSourceIndex < 0 ||
           producerSourceIndex >= sources.len ||
           sources[producerSourceIndex] != sourcePath ||
           canonicalSourceIndex < 0 ||
           canonicalSourceIndex >=
               semanticGraph.sourceTable.sourcePaths.len ||
           semanticGraph.sourceTable.sourcePaths[canonicalSourceIndex] !=
               sourcePath:
            err = Fmt" compiler csg: reachable function producer/canonical source mapping missing function_index={i} producer_source={producerSourceIndex} canonical_source={canonicalSourceIndex} source={sourcePath}"
            return false
        # sourceIndex is the canonical semantic-source row.  The parser row is
        # an independent producer coordinate and must never be inferred by
        # assuming both arenas happen to share an ordering.
        add(semanticGraph.reachableFunctionTable.sourceIndex,
            canonicalSourceIndex)
        add(semanticGraph.reachableFunctionTable.producerSourceIndexes,
            producerSourceIndex)
        add(semanticGraph.reachableFunctionTable.producerDeclarationIndexes,
            reachableSet.producerDeclarationIndexes[i])
        add(semanticGraph.reachableFunctionTable.functionNameSurfaceKinds,
            reachableSet.functionNameSurfaceKinds[i])
        add(semanticGraph.reachableFunctionTable.functionNameProofCids,
            reachableSet.functionNameProofCids[i])
        add(semanticGraph.reachableFunctionTable.functionAnnotationFlags,
            reachableSet.functionAnnotationFlags[i])
        add(semanticGraph.reachableFunctionTable.functionDeclarationHeaderCids,
            reachableSet.functionDeclarationHeaderCids[i])
        add(semanticGraph.reachableFunctionTable.functionDeclarationPathCids,
            reachableSet.functionDeclarationPathCids[i])
        add(semanticGraph.reachableFunctionTable.keepExportBindingCids,
            reachableSet.keepExportBindingCids[i])
        add(semanticGraph.reachableFunctionTable.sourcePaths, share(sourcePath))
        add(semanticGraph.reachableFunctionTable.functionNames, share(reachableSet.functionNames[i]))
        add(semanticGraph.reachableFunctionTable.symbolTexts, share(reachableSet.symbolTexts[i]))
        add(semanticGraph.reachableFunctionTable.startLines, reachableSet.startLines[i])
        add(semanticGraph.reachableFunctionTable.endLines, reachableSet.endLines[i])
        add(semanticGraph.reachableFunctionTable.reachable, reachableSet.reachable[i])
    err = ""
    return true

fn CompilerCsgSemanticBindReachableGraphNodeIds(
        semanticGraph: var CompilerCsgSemanticGraph,
        store: var phase.PhaseArenaStore,
        arena: phase.PhaseArenaHandle,
        column: var CompilerCsgFunctionGraphNodeColumn,
        reachableSet: var CompilerCsgReachableFunctionSet,
        nodes: var CompilerCsgNode[],
        err: var str): bool =
    if !CompilerCsgFunctionGraphNodeColumnValidate(
            store, arena, column, reachableSet, nodes, err):
        return false
    let functionCount = reachableSet.functionNames.len
    if semanticGraph.reachableFunctionTable.sourceIndex.len != functionCount ||
       semanticGraph.reachableFunctionTable.producerSourceIndexes.len !=
           functionCount ||
       semanticGraph.reachableFunctionTable.producerDeclarationIndexes.len !=
           functionCount ||
       semanticGraph.reachableFunctionTable.functionNameSurfaceKinds.len !=
           functionCount ||
       semanticGraph.reachableFunctionTable.functionNameProofCids.len !=
           functionCount ||
       semanticGraph.reachableFunctionTable.functionAnnotationFlags.len !=
           functionCount ||
       semanticGraph.reachableFunctionTable.functionDeclarationHeaderCids.len !=
           functionCount ||
       semanticGraph.reachableFunctionTable.functionDeclarationPathCids.len !=
           functionCount ||
       semanticGraph.reachableFunctionTable.keepExportBindingCids.len !=
           functionCount ||
       semanticGraph.reachableFunctionTable.sourcePaths.len != functionCount ||
       semanticGraph.reachableFunctionTable.functionNames.len != functionCount ||
       semanticGraph.reachableFunctionTable.symbolTexts.len != functionCount ||
       semanticGraph.reachableFunctionTable.startLines.len != functionCount ||
       semanticGraph.reachableFunctionTable.endLines.len != functionCount ||
       semanticGraph.reachableFunctionTable.reachable.len != functionCount:
        err = " compiler csg: reachable graph-node projection shape mismatch"
        return false
    let nodeIndexById = CompilerCsgBuildNodeIndexByNodeId(nodes)
    var seen: bool[]
    setLen(seen, nodeIndexById.len)
    semanticGraph.reachableFunctionTable.graphNodeIds = []
    for functionIndex in 0..<functionCount:
        let nodeId = CompilerCsgPhaseArenaGraphNodeColumnGet(
            store, arena, column, functionIndex)
        if nodeId <= 0 || nodeId >= nodeIndexById.len ||
           nodeIndexById[nodeId] < 0 || seen[nodeId]:
            err = Fmt" compiler csg: reachable graph-node identity invalid function={functionIndex} node={nodeId}"
            return false
        let node = nodes[nodeIndexById[nodeId]]
        let sourceIndex = semanticGraph.reachableFunctionTable.sourceIndex[functionIndex]
        if sourceIndex < 0 || sourceIndex >= semanticGraph.sourceTable.modulePaths.len:
            err = Fmt" compiler csg: reachable graph-node source identity index invalid function={functionIndex} source_index={sourceIndex} modules={semanticGraph.sourceTable.modulePaths.len}"
            return false
        let semanticSource = semanticGraph.sourceTable.modulePaths[sourceIndex]
        if semanticSource == "":
            err = Fmt" compiler csg: reachable graph-node portable source identity missing function={functionIndex} source_index={sourceIndex}"
            return false
        if node.nodeKind != CompilerCsgNodeKindSymbol ||
           node.producerSourceIndex !=
               reachableSet.producerSourceIndexes[functionIndex] ||
           node.producerDeclarationIndex !=
               reachableSet.producerDeclarationIndexes[functionIndex] ||
           node.functionNameSurfaceKind !=
               reachableSet.functionNameSurfaceKinds[functionIndex] ||
           !layout.FixedBytes32Equal(
               node.nameProofCid,
               reachableSet.functionNameProofCids[functionIndex]) ||
           semanticGraph.reachableFunctionTable.producerSourceIndexes[
               functionIndex] != node.producerSourceIndex ||
           semanticGraph.reachableFunctionTable.producerDeclarationIndexes[
               functionIndex] != node.producerDeclarationIndex ||
           semanticGraph.reachableFunctionTable.functionNameSurfaceKinds[
               functionIndex] != node.functionNameSurfaceKind ||
           !layout.FixedBytes32Equal(
               semanticGraph.reachableFunctionTable.functionNameProofCids[
                   functionIndex],
               node.nameProofCid) ||
           node.factText != reachableSet.functionNames[functionIndex] ||
           node.semanticSource != semanticSource ||
           node.semanticDeclarationLineIndex !=
               reachableSet.startLines[functionIndex]:
            err = Fmt" compiler csg: reachable graph-node semantic join mismatch function={functionIndex} node={nodeId} actual_kind={node.nodeKind} expected_kind={CompilerCsgNodeKindSymbol} actual_name={node.factText} expected_name={reachableSet.functionNames[functionIndex]} actual_source={node.semanticSource} expected_source={semanticSource} actual_line={node.semanticDeclarationLineIndex} expected_line={reachableSet.startLines[functionIndex]}"
            return false
        seen[nodeId] = true
        add(semanticGraph.reachableFunctionTable.graphNodeIds, nodeId)
    err = ""
    return true

fn CompilerCsgTypedFactSemanticDigestSeed(): int64 =
    return CompilerCsgTextContentCertificate(
        "cheng.compiler.csg.typed_fact.slice")

@borrows
fn CompilerCsgTypedFactSemanticDigestText(digest: int64,
                                          text: str): int64 =
    return CompilerCsgCertificateMix(digest,
                                     CompilerCsgTextContentCertificate(text))

@borrows
fn CompilerCsgTypedFactSemanticIdentityCertificate(fact: TypedExprFact): int64 =
    var digest = CompilerCsgTextContentCertificate(
        "cheng.compiler.csg.typed_fact.identity")
    digest = CompilerCsgTypedFactSemanticDigestText(digest, fact.exprId)
    digest = CompilerCsgTypedFactSemanticDigestText(digest, fact.sourcePath)
    digest = CompilerCsgCertificateMix(digest, Int64(fact.lineNumber))
    digest = CompilerCsgCertificateMix(digest, Int64(fact.columnNumber))
    digest = CompilerCsgCertificateMix(digest, Int64(fact.endLineNumber))
    digest = CompilerCsgCertificateMix(digest, Int64(fact.endColumnNumber))
    digest = CompilerCsgCertificateMix(digest, Int64(fact.kind))
    digest = CompilerCsgCertificateMix(digest, Int64(fact.surfaceCallKind))
    digest = CompilerCsgCertificateMix(digest, fact.callResolved ? Int64(1) : Int64(0))
    digest = CompilerCsgCertificateMix(digest, Int64(fact.callReason))
    digest = CompilerCsgTypedFactSemanticDigestText(digest, fact.callQualifier)
    digest = CompilerCsgTypedFactSemanticDigestText(digest, fact.callCallee)
    digest = CompilerCsgTypedFactSemanticDigestText(digest, fact.callTarget)
    digest = CompilerCsgTypedFactSemanticDigestText(digest,
                                                    fact.callTargetSourcePath)
    digest = CompilerCsgCertificateMix(digest,
                                       fact.callTargetImportc ? Int64(1) : Int64(0))
    digest = CompilerCsgCertificateMix(digest,
                                       fact.callPrefixStyle ? Int64(1) : Int64(0))
    digest = CompilerCsgCertificateMix(digest, Int64(fact.callArgCount))
    digest = CompilerCsgTypedFactSemanticDigestText(digest, fact.callArgsText)
    digest = CompilerCsgTypedFactSemanticDigestText(digest, fact.typeText)
    return CompilerCsgCertificateMix(digest, Int64(fact.abiClass))

fn CompilerCsgTypedFactSemanticDigestUpdateFields(digestRaw: int64,
                                                  identityCertificate: int64,
                                                  valueKind: int32,
                                                  placeKind: int32,
                                                  hasSink: bool,
                                                  sinkPlaceKind: int32,
                                                  loweringMode: int32,
                                                  callKind: int32,
                                                  typeCallKind: int32,
                                                  returnKind: int32,
                                                  returnRoot: bool): int64 =
    var digest = CompilerCsgCertificateMix(digestRaw, identityCertificate)
    digest = CompilerCsgCertificateMix(digest, Int64(valueKind))
    digest = CompilerCsgCertificateMix(digest, Int64(placeKind))
    digest = CompilerCsgCertificateMix(digest, hasSink ? Int64(1) : Int64(0))
    digest = CompilerCsgCertificateMix(digest, Int64(sinkPlaceKind))
    digest = CompilerCsgCertificateMix(digest, Int64(loweringMode))
    digest = CompilerCsgCertificateMix(digest, Int64(callKind))
    digest = CompilerCsgCertificateMix(digest, Int64(typeCallKind))
    digest = CompilerCsgCertificateMix(digest, Int64(returnKind))
    return CompilerCsgCertificateMix(digest,
                                     returnRoot ? Int64(1) : Int64(0))

@borrows
fn CompilerCsgTypedFactSemanticDigestUpdate(digestRaw: int64,
                                            fact: TypedExprFact): int64 =
    return CompilerCsgTypedFactSemanticDigestUpdateFields(
        digestRaw,
        CompilerCsgTypedFactSemanticIdentityCertificate(fact),
        Int32(fact.valueKind),
        Int32(fact.placeKind),
        fact.hasSink,
        Int32(fact.sinkPlaceKind),
        Int32(fact.loweringMode),
        Int32(fact.callKind),
        Int32(fact.typeCallKind),
        Int32(fact.returnKind),
        fact.returnRoot)

fn CompilerCsgTypedFactSemanticDigestFinalize(digest: int64,
                                              factCount: int32): int64 =
    return CompilerCsgCertificateMix(digest, Int64(factCount))

fn CompilerCsgTypedFactSemanticDigestRange(facts: var TypedExprFactTable,
                                           factStart: int32,
                                           factEnd: int32,
                                           err: var str): int64 =
    if factStart < 0 || factEnd < factStart || factEnd > facts.count:
        err = Fmt" compiler csg: typed-fact semantic digest range invalid start={factStart} end={factEnd} facts={facts.count}"
        return Int64(0)
    var digest = CompilerCsgTypedFactSemanticDigestSeed()
    for factIndex in factStart..<factEnd:
        if factIndex % 1024 == 0:
            os.ProcessResourceGuardCheck()
        digest = CompilerCsgTypedFactSemanticDigestUpdate(
            digest,
            texpr.TypedExprFactAt(facts, factIndex))
    err = ""
    return CompilerCsgTypedFactSemanticDigestFinalize(digest,
                                                      factEnd - factStart)

@borrows
fn CompilerCsgSemanticTypedFactSemanticColumnsValid(table: CompilerCsgSemanticTypedFactTable): bool =
    let rowCount = table.sourceIndexes.len
    return table.functionIndexes.len == rowCount &&
           table.semanticIdentityCertificates.len == rowCount &&
           table.valueKinds.len == rowCount &&
           table.placeKinds.len == rowCount &&
           table.hasSinks.len == rowCount &&
           table.sinkPlaceKinds.len == rowCount &&
           table.loweringModes.len == rowCount &&
           table.callKinds.len == rowCount &&
           table.typeCallKinds.len == rowCount &&
           table.returnKinds.len == rowCount &&
           table.returnRoots.len == rowCount

@borrows
fn CompilerCsgSemanticAppendTypedFactSemanticSnapshotRow(table: var CompilerCsgSemanticTypedFactTable,
                                                   sourceIndex: int32,
                                                   functionIndex: int32,
                                                   fact: TypedExprFact) =
    if !CompilerCsgSemanticTypedFactSemanticColumnsValid(table):
        panic("compiler csg: typed-fact semantic snapshot columns corrupt")
    add(table.sourceIndexes, sourceIndex)
    add(table.functionIndexes, functionIndex)
    add(table.semanticIdentityCertificates,
        CompilerCsgTypedFactSemanticIdentityCertificate(fact))
    add(table.valueKinds, Int32(fact.valueKind))
    add(table.placeKinds, Int32(fact.placeKind))
    add(table.hasSinks, fact.hasSink)
    add(table.sinkPlaceKinds, Int32(fact.sinkPlaceKind))
    add(table.loweringModes, Int32(fact.loweringMode))
    add(table.callKinds, Int32(fact.callKind))
    add(table.typeCallKinds, Int32(fact.typeCallKind))
    add(table.returnKinds, Int32(fact.returnKind))
    add(table.returnRoots, fact.returnRoot)

@borrows
fn CompilerCsgSemanticTypedFactSemanticSnapshotDigestRange(table: CompilerCsgSemanticTypedFactTable,
                                                     factStart: int32,
                                                     factEnd: int32,
                                                     expectedSourceIndex: int32,
                                                     expectedFunctionIndex: int32,
                                                     err: var str): int64 =
    if !CompilerCsgSemanticTypedFactSemanticColumnsValid(table) ||
       factStart < 0 || factEnd < factStart ||
       factEnd > table.sourceIndexes.len:
        err = Fmt" compiler csg: typed-fact semantic snapshot range invalid start={factStart} end={factEnd} rows={table.sourceIndexes.len}"
        return Int64(0)
    var digest = CompilerCsgTypedFactSemanticDigestSeed()
    for factIndex in factStart..<factEnd:
        if factIndex % 1024 == 0:
            os.ProcessResourceGuardCheck()
        if table.sourceIndexes[factIndex] != expectedSourceIndex ||
           table.functionIndexes[factIndex] != expectedFunctionIndex:
            err = Fmt" compiler csg: typed-fact semantic snapshot owner drift row={factIndex} expected_source={expectedSourceIndex} actual_source={table.sourceIndexes[factIndex]} expected_function={expectedFunctionIndex} actual_function={table.functionIndexes[factIndex]}"
            return Int64(0)
        digest = CompilerCsgTypedFactSemanticDigestUpdateFields(
            digest,
            table.semanticIdentityCertificates[factIndex],
            table.valueKinds[factIndex],
            table.placeKinds[factIndex],
            table.hasSinks[factIndex],
            table.sinkPlaceKinds[factIndex],
            table.loweringModes[factIndex],
            table.callKinds[factIndex],
            table.typeCallKinds[factIndex],
            table.returnKinds[factIndex],
            table.returnRoots[factIndex])
    err = ""
    return CompilerCsgTypedFactSemanticDigestFinalize(digest,
                                                      factEnd - factStart)

@borrows
fn CompilerCsgSemanticAppendExprSlice(semanticGraph: var CompilerCsgSemanticGraph,
                                 sourceIndex: int32,
                                 sourcePath: str,
                                 functionIndex: int32,
                                 exprStart: int32,
                                 exprCount: int32,
                                 typedFactStart: int32,
                                 typedFactCount: int32,
                                 typedFactSemanticDigest: int64) =
    if functionIndex < 0 ||
       functionIndex >= semanticGraph.exprSliceTable.functionSliceIndexes.len:
        panic(Fmt"compiler csg: expr slice function index invalid function_index={functionIndex} function_count={semanticGraph.exprSliceTable.functionSliceIndexes.len}")
    if semanticGraph.exprSliceTable.functionSliceIndexes[functionIndex] >= 0:
        panic(Fmt"compiler csg: duplicate expr slice function_index={functionIndex}")
    let sliceIndex = semanticGraph.exprSliceTable.sourceIndex.len
    add(semanticGraph.exprSliceTable.sourceIndex, sourceIndex)
    add(semanticGraph.exprSliceTable.sourcePaths, share(sourcePath))
    add(semanticGraph.exprSliceTable.functionIndex, functionIndex)
    add(semanticGraph.exprSliceTable.exprStart, exprStart)
    add(semanticGraph.exprSliceTable.exprCount, exprCount)
    add(semanticGraph.exprSliceTable.typedFactStart, typedFactStart)
    add(semanticGraph.exprSliceTable.typedFactCount, typedFactCount)
    add(semanticGraph.exprSliceTable.typedFactSemanticDigests,
        typedFactSemanticDigest)
    add(semanticGraph.exprSliceTable.typedIrSemanticDigests, Int64(0))
    add(semanticGraph.exprSliceTable.typedIrFunctionIndexes, -1)
    add(semanticGraph.exprSliceTable.semanticValidated, false)
    semanticGraph.exprSliceTable.functionSliceIndexes[functionIndex] = sliceIndex
    if functionIndex >= 0:
        semanticGraph.exprSliceFunctionBoundCount = semanticGraph.exprSliceFunctionBoundCount + 1
    if exprCount > semanticGraph.exprSliceMaxExprCount:
        semanticGraph.exprSliceMaxExprCount = exprCount
    if typedFactCount > semanticGraph.exprSliceMaxTypedFactCount:
        semanticGraph.exprSliceMaxTypedFactCount = typedFactCount

@borrows
fn CompilerCsgSemanticTypedFactCount(semanticGraph: CompilerCsgSemanticGraph): int32 =
    return semanticGraph.typedFactTable.sourceIndexes.len

fn CompilerCsgSemanticAccumulateExprSummary(summary: var CompilerCsgSemanticExprSummary,
                                       layer: var parser.NormalizedExprLayer) =
    summary.sourceCount = summary.sourceCount + layer.sourceCount
    summary.exprCount = summary.exprCount + layer.exprs.len
    for exprIndex in 0..<layer.exprs.len:
        let kind = layer.exprs[exprIndex].kind
        if kind == parser.NormalizedExprIf:
            summary.ifCount = summary.ifCount + 1
        elif kind == parser.NormalizedExprRange:
            summary.rangeCount = summary.rangeCount + 1
        elif kind == parser.NormalizedExprComprehension:
            summary.comprehensionCount = summary.comprehensionCount + 1
        elif kind == parser.NormalizedExprStrFormat:
            summary.strFormatCount = summary.strFormatCount + 1
        elif kind == parser.NormalizedExprResultIntrinsic:
            summary.resultIntrinsicCount = summary.resultIntrinsicCount + 1
        elif kind == parser.NormalizedExprCall:
            summary.callCount = summary.callCount + 1
        elif kind == parser.NormalizedExprTry:
            summary.tryCount = summary.tryCount + 1
        elif kind == parser.NormalizedExprDefaultInit:
            summary.defaultInitCount = summary.defaultInitCount + 1
        elif kind == parser.NormalizedExprConstructor:
            summary.constructorCount = summary.constructorCount + 1
        elif kind == parser.NormalizedExprReturn:
            summary.returnCount = summary.returnCount + 1
        elif kind == parser.NormalizedExprAssign:
            summary.assignCount = summary.assignCount + 1
        elif kind == parser.NormalizedExprIfStmt:
            summary.ifStmtCount = summary.ifStmtCount + 1
        elif kind == parser.NormalizedExprElifStmt:
            summary.elifStmtCount = summary.elifStmtCount + 1
        elif kind == parser.NormalizedExprElseStmt:
            summary.elseStmtCount = summary.elseStmtCount + 1
        elif kind == parser.NormalizedExprForStmt:
            summary.forStmtCount = summary.forStmtCount + 1
        elif kind == parser.NormalizedExprMatchStmt:
            summary.matchStmtCount = summary.matchStmtCount + 1
        elif kind == parser.NormalizedExprCaseStmt:
            summary.caseStmtCount = summary.caseStmtCount + 1
        elif kind == parser.NormalizedExprWhileStmt:
            summary.whileStmtCount = summary.whileStmtCount + 1
    summary.questionResidualCount = summary.questionResidualCount + layer.questionResidualCount

fn CompilerCsgSemanticValidateExprSliceTypedFactCoverage(semanticGraph: var CompilerCsgSemanticGraph,
                                                   factCount: int32,
                                                   exprCount: int32) =
    var uniqueCovered: int32
    var overlapCount: int32
    var invalidSliceCount: int32
    var expectedExprStart: int32
    var expectedFactStart: int32
    let sliceCount = semanticGraph.exprSliceTable.typedFactStart.len
    if semanticGraph.exprSliceTable.sourceIndex.len != sliceCount ||
       semanticGraph.exprSliceTable.sourcePaths.len != sliceCount ||
       semanticGraph.exprSliceTable.functionIndex.len != sliceCount ||
       semanticGraph.exprSliceTable.exprStart.len != sliceCount ||
       semanticGraph.exprSliceTable.exprCount.len != sliceCount ||
       semanticGraph.exprSliceTable.typedFactCount.len != sliceCount ||
       semanticGraph.exprSliceTable.typedFactSemanticDigests.len != sliceCount ||
       semanticGraph.exprSliceTable.typedIrSemanticDigests.len != sliceCount ||
       semanticGraph.exprSliceTable.typedIrFunctionIndexes.len != sliceCount ||
       semanticGraph.exprSliceTable.semanticValidated.len != sliceCount ||
       semanticGraph.exprSliceTable.functionSliceIndexes.len !=
           semanticGraph.reachableFunctionTable.sourceIndex.len ||
       !CompilerCsgSemanticTypedFactSemanticColumnsValid(semanticGraph.typedFactTable):
        semanticGraph.exprSliceTypedFactCoveredCount = 0
        semanticGraph.exprSliceTypedFactOverlapCount = 0
        semanticGraph.exprSliceTypedFactInvalidSliceCount = 1
        semanticGraph.exprSliceTypedFactGapCount = factCount
        semanticGraph.exprSliceTypedFactComplete = false
        semanticGraph.exprSliceValidationReason = "column_mismatch"
        return
    for sliceIndex in 0..<semanticGraph.exprSliceTable.typedFactStart.len:
        if sliceIndex % 256 == 0:
            os.ProcessResourceGuardCheck()
        if sliceIndex >= semanticGraph.exprSliceTable.sourceIndex.len ||
           sliceIndex >= semanticGraph.exprSliceTable.sourcePaths.len ||
           sliceIndex >= semanticGraph.exprSliceTable.functionIndex.len ||
           sliceIndex >= semanticGraph.exprSliceTable.exprStart.len ||
           sliceIndex >= semanticGraph.exprSliceTable.exprCount.len ||
           sliceIndex >= semanticGraph.exprSliceTable.typedFactCount.len:
            invalidSliceCount = invalidSliceCount + 1
            continue
        let functionIndex = semanticGraph.exprSliceTable.functionIndex[sliceIndex]
        if functionIndex < 0 ||
           functionIndex >= semanticGraph.reachableFunctionTable.sourceIndex.len ||
           semanticGraph.exprSliceTable.functionSliceIndexes[functionIndex] != sliceIndex:
            invalidSliceCount = invalidSliceCount + 1
            continue
        if functionIndex >= 0 &&
           semanticGraph.reachableFunctionTable.sourceIndex[functionIndex] != semanticGraph.exprSliceTable.sourceIndex[sliceIndex]:
            invalidSliceCount = invalidSliceCount + 1
            continue
        let exprStart = semanticGraph.exprSliceTable.exprStart[sliceIndex]
        let sliceExprCount = semanticGraph.exprSliceTable.exprCount[sliceIndex]
        if exprStart != expectedExprStart || sliceExprCount < 0 || exprStart + sliceExprCount > exprCount:
            invalidSliceCount = invalidSliceCount + 1
            continue
        expectedExprStart = expectedExprStart + sliceExprCount
        let start = semanticGraph.exprSliceTable.typedFactStart[sliceIndex]
        let count = semanticGraph.exprSliceTable.typedFactCount[sliceIndex]
        if start != expectedFactStart || count < 0 || start + count > factCount:
            if start < expectedFactStart && start >= 0:
                overlapCount = overlapCount + (expectedFactStart - start)
            invalidSliceCount = invalidSliceCount + 1
            continue
        expectedFactStart = expectedFactStart + count
        var sourceMatches = true
        for localIndex in 0..<count:
            let factIndex = start + localIndex
            if factIndex >= semanticGraph.typedFactTable.sourceIndexes.len ||
               semanticGraph.typedFactTable.sourceIndexes[factIndex] !=
                   semanticGraph.exprSliceTable.sourceIndex[sliceIndex] ||
               semanticGraph.typedFactTable.functionIndexes[factIndex] != functionIndex:
                sourceMatches = false
                break
        if !sourceMatches:
            invalidSliceCount = invalidSliceCount + 1
            continue
        uniqueCovered = uniqueCovered + count
    semanticGraph.exprSliceTypedFactCoveredCount = uniqueCovered
    semanticGraph.exprSliceTypedFactOverlapCount = overlapCount
    semanticGraph.exprSliceTypedFactInvalidSliceCount = invalidSliceCount
    semanticGraph.exprSliceTypedFactGapCount = factCount - uniqueCovered
    semanticGraph.exprSliceTypedFactComplete = invalidSliceCount == 0 &&
                                    overlapCount == 0 &&
                                    uniqueCovered == factCount &&
                                    expectedExprStart == exprCount &&
                                    expectedFactStart == factCount
    if semanticGraph.exprSliceTypedFactComplete:
        if semanticGraph.exprSliceValidationReason == "":
            semanticGraph.exprSliceValidationReason = "complete"
    elif invalidSliceCount > 0:
        semanticGraph.exprSliceValidationReason = "invalid_slice"
    elif overlapCount > 0:
        semanticGraph.exprSliceValidationReason = "overlap"
    else:
        semanticGraph.exprSliceValidationReason = "gap"

fn CompilerCsgSemanticEnsureExprSliceTypedFactCoverage(semanticGraph: var CompilerCsgSemanticGraph) =
    let factCount = semanticGraph.typedFactTable.sourceIndexes.len
    CompilerCsgSemanticValidateExprSliceTypedFactCoverage(semanticGraph,
                                                     factCount,
                                                     semanticGraph.exprSummary.exprCount)

fn CompilerCsgSemanticLoweringRuleSetInit(): CompilerCsgSemanticLoweringRuleSet =
    var out: CompilerCsgSemanticLoweringRuleSet
    out.bucketHeads = hashmaps.HashMapPtrIntInit(64)
    return out

fn CompilerCsgSemanticLoweringRuleHashMix(hashValue: int32,
                                     fieldValue: int32): int32 =
    return Int32((Int64(hashValue) * Int64(131) + Int64(fieldValue)) &
                 Int64(2147483647))

fn CompilerCsgSemanticLoweringRuleHash(rule: texpr.TypedExprLoweringRule,
                                  keyMode: bool): int32 =
    var hashValue = CompilerCsgTextHash(rule.typeText)
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.abiClass))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.valueKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.placeKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.loweringMode))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.callKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.typeCallKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.returnKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, rule.returnRoot ? 1 : 0)
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.argPassKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.resultPassKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.materializeKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.copyKind))
    hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue, Int32(rule.importKind))
    if keyMode && rule.callKind == texpr.TypedExprCallResultIntrinsic:
        hashValue = CompilerCsgSemanticLoweringRuleHashMix(hashValue,
                                                     CompilerCsgTextHash(rule.callCallee))
    return hashValue

fn CompilerCsgSemanticLoweringRuleSetInsert(ruleSet: var CompilerCsgSemanticLoweringRuleSet,
                                       ruleRaw: texpr.TypedExprLoweringRule,
                                       keyMode: bool): bool =
    var rule = ruleRaw
    if keyMode:
        rule.typeText = texpr.TypedExprNormalizeTypeText(rule.typeText)
    let hashValue =
        CompilerCsgSemanticLoweringRuleHash(share(rule), keyMode)
    var bucketKey = Int64(hashValue)
    if bucketKey == Int64(0):
        bucketKey = Int64(1)
    var found = false
    var ruleIndex = hashmaps.HashMapPtrIntGetEx(ruleSet.bucketHeads,
                                                bucketKey,
                                                found)
    if !found:
        ruleIndex = -1
    let existingHead = ruleIndex
    while ruleIndex >= 0:
        if ruleIndex >= ruleSet.rules.len || ruleIndex >= ruleSet.nextIndexes.len:
            panic("compiler csg lowering-rule set index mismatch")
        if texpr.TypedExprLoweringRuleShapeEqual(
                share(ruleSet.rules[ruleIndex]), share(rule)):
            if !keyMode ||
               rule.callKind != texpr.TypedExprCallResultIntrinsic ||
               ruleSet.rules[ruleIndex].callCallee == rule.callCallee:
                return false
        ruleIndex = ruleSet.nextIndexes[ruleIndex]
    let newIndex = ruleSet.rules.len
    add(ruleSet.rules, texpr.TypedExprLoweringRuleClone(rule))
    add(ruleSet.nextIndexes, existingHead)
    hashmaps.HashMapPtrIntPut(ruleSet.bucketHeads, bucketKey, newIndex)
    return true

fn CompilerCsgSemanticLoweringRuleSetClear(ruleSet: var CompilerCsgSemanticLoweringRuleSet) =
    hashmaps.HashMapPtrIntClear(ruleSet.bucketHeads)
    ruleSet.rules = []
    ruleSet.nextIndexes = []

@borrows
fn CompilerCsgSemanticAccumulateTypedFactSummary(summary: var CompilerCsgSemanticTypedFactSummary,
                                            loweringRuleShapes: var CompilerCsgSemanticLoweringRuleSet,
                                            loweringRuleKeys: var CompilerCsgSemanticLoweringRuleSet,
                                            fact: TypedExprFact) =
    if fact.kind == parser.NormalizedExprCall:
        summary.surfaceCallCount = summary.surfaceCallCount + 1
        if fact.callResolved:
            summary.callResolvedCount = summary.callResolvedCount + 1
        else:
            summary.callUnresolvedCount = summary.callUnresolvedCount + 1
    if fact.surfaceCallKind == texpr.TypedExprSurfaceCallLocal:
        summary.surfaceCallLocalCount = summary.surfaceCallLocalCount + 1
    elif fact.surfaceCallKind == texpr.TypedExprSurfaceCallExternal:
        summary.surfaceCallExternalCount = summary.surfaceCallExternalCount + 1
    elif fact.surfaceCallKind == texpr.TypedExprSurfaceCallImportc:
        summary.surfaceCallImportcCount = summary.surfaceCallImportcCount + 1
    elif fact.surfaceCallKind == texpr.TypedExprSurfaceCallMember:
        summary.surfaceCallMemberCount = summary.surfaceCallMemberCount + 1
    if fact.callTargetImportc:
        summary.callTargetImportcCount = summary.callTargetImportcCount + 1
    if fact.callReason == texpr.TypedExprCallReasonUnknownQualifiedTarget:
        summary.callReasonUnknownQualifiedTargetCount = summary.callReasonUnknownQualifiedTargetCount + 1
    elif fact.callReason == texpr.TypedExprCallReasonShadowedQualifiedTarget:
        summary.callReasonShadowedQualifiedTargetCount = summary.callReasonShadowedQualifiedTargetCount + 1
    elif fact.callReason == texpr.TypedExprCallReasonAmbiguousExternalTarget:
        summary.callReasonAmbiguousExternalTargetCount = summary.callReasonAmbiguousExternalTargetCount + 1
    elif fact.callReason == texpr.TypedExprCallReasonAmbiguousQualifiedTarget:
        summary.callReasonAmbiguousQualifiedTargetCount = summary.callReasonAmbiguousQualifiedTargetCount + 1
    elif fact.callReason == texpr.TypedExprCallReasonUnknownExternalTarget:
        summary.callReasonUnknownExternalTargetCount = summary.callReasonUnknownExternalTargetCount + 1
    elif fact.callReason == texpr.TypedExprCallReasonUnknownCallTarget:
        summary.callReasonUnknownCallTargetCount = summary.callReasonUnknownCallTargetCount + 1
    if fact.abiClass == texpr.TypedExprAbiScalar:
        summary.abiScalarCount = summary.abiScalarCount + 1
    elif fact.abiClass == texpr.TypedExprAbiComposite:
        summary.abiCompositeCount = summary.abiCompositeCount + 1
    elif fact.abiClass == texpr.TypedExprAbiPointerLike:
        summary.abiPointerLikeCount = summary.abiPointerLikeCount + 1
    else:
        summary.abiPolymorphicCount = summary.abiPolymorphicCount + 1
    if fact.valueKind == texpr.TypedExprValueScalar:
        summary.valueScalarCount = summary.valueScalarCount + 1
    elif fact.valueKind == texpr.TypedExprValueComposite:
        summary.valueCompositeCount = summary.valueCompositeCount + 1
    elif fact.valueKind == texpr.TypedExprValuePointerLike:
        summary.valuePointerLikeCount = summary.valuePointerLikeCount + 1
    else:
        summary.valuePolymorphicCount = summary.valuePolymorphicCount + 1
    if fact.placeKind == texpr.TypedExprPlaceLocal:
        summary.placeLocalCount = summary.placeLocalCount + 1
    elif fact.placeKind == texpr.TypedExprPlaceGlobal:
        summary.placeGlobalCount = summary.placeGlobalCount + 1
    elif fact.placeKind == texpr.TypedExprPlaceField:
        summary.placeFieldCount = summary.placeFieldCount + 1
    elif fact.placeKind == texpr.TypedExprPlaceCallResult:
        summary.placeCallResultCount = summary.placeCallResultCount + 1
    else:
        summary.placeTemporaryCount = summary.placeTemporaryCount + 1
    if fact.loweringMode == texpr.TypedExprLowerReg:
        summary.lowerRegCount = summary.lowerRegCount + 1
    elif fact.loweringMode == texpr.TypedExprLowerLocalAddress:
        summary.lowerLocalAddressCount = summary.lowerLocalAddressCount + 1
    elif fact.loweringMode == texpr.TypedExprLowerSret:
        summary.lowerSretCount = summary.lowerSretCount + 1
    elif fact.loweringMode == texpr.TypedExprLowerImportBuffer:
        summary.lowerImportBufferCount = summary.lowerImportBufferCount + 1
    else:
        summary.lowerDeferredCount = summary.lowerDeferredCount + 1
    if fact.callKind == texpr.TypedExprCallBuiltin:
        summary.callBuiltinCount = summary.callBuiltinCount + 1
    elif fact.callKind == texpr.TypedExprCallResultIntrinsic:
        summary.callResultIntrinsicCount = summary.callResultIntrinsicCount + 1
    elif fact.callKind == texpr.TypedExprCallProjection:
        summary.callProjectionCount = summary.callProjectionCount + 1
    else:
        summary.callNoneCount = summary.callNoneCount + 1
    if fact.typeCallKind == texpr.TypedExprTypeCallDefaultInit:
        summary.typeCallDefaultInitCount = summary.typeCallDefaultInitCount + 1
    elif fact.typeCallKind == texpr.TypedExprTypeCallConstructor:
        summary.typeCallConstructorCount = summary.typeCallConstructorCount + 1
    else:
        summary.typeCallNoneCount = summary.typeCallNoneCount + 1
    if fact.returnKind == texpr.TypedExprReturnReg:
        summary.returnRegCount = summary.returnRegCount + 1
    elif fact.returnKind == texpr.TypedExprReturnCompositeLocal:
        summary.returnCompositeLocalCount = summary.returnCompositeLocalCount + 1
    elif fact.returnKind == texpr.TypedExprReturnSret:
        summary.returnSretCount = summary.returnSretCount + 1
    elif fact.returnKind == texpr.TypedExprReturnImportBuffer:
        summary.returnImportBufferCount = summary.returnImportBufferCount + 1
    else:
        summary.returnDeferredCount = summary.returnDeferredCount + 1
    if fact.returnRoot:
        summary.returnRootCount = summary.returnRootCount + 1
    var rule: texpr.TypedExprLoweringRule
    texpr.TypedExprLoweringRuleFillFromFact(fact, rule)
    if CompilerCsgSemanticLoweringRuleSetInsert(loweringRuleShapes, share(rule), false):
        summary.loweringRuleUniqueShapeCount = summary.loweringRuleUniqueShapeCount + 1
    if CompilerCsgSemanticLoweringRuleSetInsert(loweringRuleKeys, share(rule), true):
        summary.loweringRuleUniqueKeyCount = summary.loweringRuleUniqueKeyCount + 1
    if rule.argPassKind == texpr.TypedExprArgPassValue:
        summary.loweringRuleArgValueCount = summary.loweringRuleArgValueCount + 1
    elif rule.argPassKind == texpr.TypedExprArgPassAddress:
        summary.loweringRuleArgAddressCount = summary.loweringRuleArgAddressCount + 1
    elif rule.argPassKind == texpr.TypedExprArgPassCallResultAddress:
        summary.loweringRuleArgCallResultAddressCount = summary.loweringRuleArgCallResultAddressCount + 1
    if rule.resultPassKind == texpr.TypedExprResultPassReg:
        summary.loweringRuleResultRegCount = summary.loweringRuleResultRegCount + 1
    elif rule.resultPassKind == texpr.TypedExprResultPassLocalAddress:
        summary.loweringRuleResultLocalAddressCount = summary.loweringRuleResultLocalAddressCount + 1
    elif rule.resultPassKind == texpr.TypedExprResultPassSret:
        summary.loweringRuleResultSretCount = summary.loweringRuleResultSretCount + 1
    if rule.materializeKind == texpr.TypedExprMaterializeRegister:
        summary.loweringRuleMaterializeRegisterCount = summary.loweringRuleMaterializeRegisterCount + 1
    elif rule.materializeKind == texpr.TypedExprMaterializeLocalSlot:
        summary.loweringRuleMaterializeLocalSlotCount = summary.loweringRuleMaterializeLocalSlotCount + 1
    elif rule.materializeKind == texpr.TypedExprMaterializeCallResultLocal:
        summary.loweringRuleMaterializeCallResultLocalCount = summary.loweringRuleMaterializeCallResultLocalCount + 1
    elif rule.materializeKind == texpr.TypedExprMaterializeDestAddress:
        summary.loweringRuleMaterializeDestAddressCount = summary.loweringRuleMaterializeDestAddressCount + 1
    if rule.copyKind == texpr.TypedExprCopyScalarStore:
        summary.loweringRuleCopyScalarStoreCount = summary.loweringRuleCopyScalarStoreCount + 1
    elif rule.copyKind == texpr.TypedExprCopyRegionCopy:
        summary.loweringRuleCopyRegionCopyCount = summary.loweringRuleCopyRegionCopyCount + 1
    if rule.importKind == texpr.TypedExprImportImportBuffer:
        summary.loweringRuleImportImportBufferCount = summary.loweringRuleImportImportBufferCount + 1
    elif rule.importKind == texpr.TypedExprImportBuiltinAddressSlot:
        summary.loweringRuleImportBuiltinAddressSlotCount = summary.loweringRuleImportBuiltinAddressSlotCount + 1
    elif rule.importKind == texpr.TypedExprImportI32ValueSlot:
        summary.loweringRuleImportI32ValueSlotCount = summary.loweringRuleImportI32ValueSlotCount + 1
    elif rule.importKind == texpr.TypedExprImportI32AddressSlot:
        summary.loweringRuleImportI32AddressSlotCount = summary.loweringRuleImportI32AddressSlotCount + 1

fn CompilerCsgSemanticResolvedCallSetInit(): CompilerCsgSemanticResolvedCallSet =
    var out: CompilerCsgSemanticResolvedCallSet
    out.version = Int64(1)
    out.sealedVersion = Int64(1)
    return out

fn CompilerCsgSemanticResolvedCallHash(sourceIndex: int32,
                                 originParserNodeId: int32): int32 =
    return CompilerCsgSemanticLoweringRuleHashMix(sourceIndex,
                                                   originParserNodeId)

@borrows
fn CompilerCsgSemanticResolvedCallRowCertificate(table: CompilerCsgSemanticResolvedCallTable,
                                           rowIndex: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(rowIndex),
                                        Int64(table.sourceIndexes[rowIndex]))
    out = CompilerCsgCertificateMix(out,
                                    Int64(table.originParserNodeIds[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.functionIndexes[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.functionRowNext[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.sourcePathIds[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.lineNumbers[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.columnNumbers[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.callQualifierIds[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.callCalleeIds[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.callTargetIds[rowIndex]))
    out = CompilerCsgCertificateMix(out,
                                    Int64(table.callTargetSourcePathIds[rowIndex]))
    out = CompilerCsgCertificateMix(
        out,
        Int64(table.callTargetSignatureLineNumbers[rowIndex]))
    out = CompilerCsgCertificateMix(out,
                                    table.callTargetImportcFlags[rowIndex] ?
                                        Int64(1) : Int64(0))
    out = CompilerCsgCertificateMix(out, Int64(table.callArgCounts[rowIndex]))
    out = CompilerCsgCertificateMix(out, Int64(table.callArgsTextIds[rowIndex]))
    return CompilerCsgCertificateMix(out,
                                     table.returnRootFlags[rowIndex] ?
                                         Int64(1) : Int64(0))

fn CompilerCsgSemanticResolvedFunctionHeadCertificate(functionIndex: int32,
                                                 head: int32): int64 =
    return CompilerCsgCertificateMix(Int64(functionIndex), Int64(head))

fn CompilerCsgSemanticResolvedBucketHeadCertificate(hashValue: int32,
                                              head: int32): int64 =
    return CompilerCsgCertificateMix(Int64(hashValue), Int64(head))

fn CompilerCsgSemanticResolvedNextCertificate(rowIndex: int32,
                                        nextIndex: int32): int64 =
    return CompilerCsgCertificateMix(Int64(rowIndex), Int64(nextIndex))

fn CompilerCsgSemanticResolvedHashSlotCertificate(slotIndex: int32,
                                            rowIndexPlus1: int32): int64 =
    return CompilerCsgCertificateMix(Int64(slotIndex), Int64(rowIndexPlus1))

fn CompilerCsgSemanticResolvedHashRebuildCertificates(callSet: var CompilerCsgSemanticResolvedCallSet) =
    callSet.hashSlotCertificates = []
    for slotIndex in 0..<callSet.hashIndex.slots.len:
        add(callSet.hashSlotCertificates,
            CompilerCsgSemanticResolvedHashSlotCertificate(slotIndex,
                                                     callSet.hashIndex.slots[slotIndex]))

fn CompilerCsgSemanticResolvedHashEnsure(callSet: var CompilerCsgSemanticResolvedCallSet,
                                  hashValue: int32): int32 =
    let oldRowCount = callSet.hashIndex.keys.len
    let oldSlotCount = callSet.hashIndex.slots.len
    let row = CompilerCsgSparseIntIndexEnsure(callSet.hashIndex, hashValue)
    if callSet.hashIndex.slots.len != oldSlotCount ||
       callSet.hashSlotCertificates.len != callSet.hashIndex.slots.len:
        CompilerCsgSemanticResolvedHashRebuildCertificates(callSet)
    elif row == oldRowCount:
        var found = false
        let slot = CompilerCsgSparseIntIndexSlot(callSet.hashIndex, hashValue, found)
        if slot < 0 || !found:
            panic("compiler csg: resolved hash inserted row not found")
        callSet.hashSlotCertificates[slot] =
            CompilerCsgSemanticResolvedHashSlotCertificate(slot,
                                                     callSet.hashIndex.slots[slot])
    return row

@borrows
fn CompilerCsgSemanticResolvedHashFindCertified(callSet: CompilerCsgSemanticResolvedCallSet,
                                         hashValue: int32,
                                         touchedCounter: var int64,
                                         err: var str): int32 =
    if callSet.hashIndex.slots.len <= 0:
        err = ""
        return -1
    if callSet.hashSlotCertificates.len != callSet.hashIndex.slots.len:
        err = " compiler csg: resolved hash slot certificate columns mismatch"
        return -2
    let mask = callSet.hashIndex.slots.len - 1
    var slot = CompilerCsgSparseIntHash(hashValue) & mask
    var scanned: int32
    while scanned <= mask:
        let rowPlus1 = callSet.hashIndex.slots[slot]
        touchedCounter = touchedCounter + Int64(1)
        if callSet.hashSlotCertificates[slot] !=
           CompilerCsgSemanticResolvedHashSlotCertificate(slot, rowPlus1):
            err = Fmt" compiler csg: resolved hash slot certificate mismatch slot={slot}"
            return -2
        if rowPlus1 == 0:
            err = ""
            return -1
        let row = rowPlus1 - 1
        if row < 0 || row >= callSet.hashIndex.keys.len ||
           row >= callSet.bucketHeads.len || row >= callSet.bucketHeadCertificates.len:
            err = Fmt" compiler csg: resolved hash row invalid slot={slot} row={row}"
            return -2
        touchedCounter = touchedCounter + Int64(1)
        if callSet.bucketHeadCertificates[row] !=
           CompilerCsgSemanticResolvedBucketHeadCertificate(callSet.hashIndex.keys[row],
                                                      callSet.bucketHeads[row]):
            err = Fmt" compiler csg: resolved hash bucket certificate mismatch row={row}"
            return -2
        if callSet.hashIndex.keys[row] == hashValue:
            err = ""
            return row
        slot = (slot + 1) & mask
        scanned = scanned + 1
    err = " compiler csg: resolved hash probe exhausted"
    return -2

@borrows
fn CompilerCsgSemanticAppendResolvedCallFactCommitted(table: var CompilerCsgSemanticResolvedCallTable,
                                                accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                                sourceIndex: int32,
                                                functionIndex: int32,
                                                fact: TypedExprFact,
                                                sourcePathId: int32,
                                                callQualifierId: int32,
                                                callCalleeId: int32,
                                                callTargetId: int32,
                                                callTargetSourcePathId: int32,
                                                callArgsTextId: int32,
                                                hashValue: int32) =
    if functionIndex < 0 || functionIndex >= table.functionRowHeads.len ||
       functionIndex >= accumulator.resolvedFunctionHeadCertificates.len:
        panic("compiler csg: committed resolved-call owner invalid")
    let bucketRowBefore = CompilerCsgSparseIntIndexFind(accumulator.resolvedCallSet.hashIndex, hashValue)
    var existingHead: int32 = -1
    var bucketRow = bucketRowBefore
    if bucketRowBefore >= 0:
        existingHead = accumulator.resolvedCallSet.bucketHeads[bucketRowBefore]
    else:
        bucketRow = CompilerCsgSemanticResolvedHashEnsure(accumulator.resolvedCallSet, hashValue)
        if bucketRow != accumulator.resolvedCallSet.bucketHeads.len:
            panic("compiler csg: committed resolved-call hash insertion conflict")
        add(accumulator.resolvedCallSet.bucketHeads, -1)
        add(accumulator.resolvedCallSet.bucketHeadCertificates,
            CompilerCsgSemanticResolvedBucketHeadCertificate(hashValue, -1))
    let newIndex = table.sourceIndexes.len
    add(table.sourceIndexes, sourceIndex)
    add(table.originParserNodeIds, fact.originParserNodeId)
    add(table.functionIndexes, functionIndex)
    let previousFunctionRow = table.functionRowHeads[functionIndex]
    table.functionRowHeads[functionIndex] = newIndex
    add(table.functionRowNext, previousFunctionRow)
    add(table.sourcePathIds, sourcePathId)
    add(table.lineNumbers, fact.lineNumber)
    add(table.columnNumbers, fact.columnNumber)
    add(table.callQualifierIds, callQualifierId)
    add(table.callCalleeIds, callCalleeId)
    add(table.callTargetIds, callTargetId)
    add(table.callTargetSourcePathIds, callTargetSourcePathId)
    add(table.callTargetSignatureLineNumbers,
        fact.callTargetSignatureLineNumber)
    add(table.callTargetImportcFlags, fact.callTargetImportc)
    add(table.callArgCounts, fact.callArgCount)
    add(table.callArgsTextIds, callArgsTextId)
    add(table.returnRootFlags, fact.returnRoot)
    add(table.targetProducerSourceIndexes, -1)
    add(table.targetProducerDeclarationOrdinals, -1)
    add(table.targetParserSourceLocalDeclarationRows, -1)
    add(table.callerGraphNodeIds, -1)
    add(table.targetGraphNodeIds, -1)
    add(table.typedCallNodeIndexes, -1)
    add(table.targetFunctionIndexes, -1)
    add(table.targetFunctionAnnotationFlags, 0)
    add(table.targetFunctionContractCids, layout.FixedBytes32())
    add(table.callArgumentStarts, -1)
    add(table.ownershipEffectStarts, -1)
    add(table.ownershipEffectCounts, 0)
    add(accumulator.resolvedCallSet.nextIndexes, existingHead)
    add(accumulator.resolvedCallSet.nextCertificates,
        CompilerCsgSemanticResolvedNextCertificate(newIndex, existingHead))
    accumulator.resolvedCallSet.bucketHeads[bucketRow] = newIndex
    accumulator.resolvedCallSet.bucketHeadCertificates[bucketRow] =
        CompilerCsgSemanticResolvedBucketHeadCertificate(hashValue, newIndex)
    add(accumulator.resolvedCallRowCertificates,
        CompilerCsgSemanticResolvedCallRowCertificate(table, newIndex))
    accumulator.resolvedFunctionHeadCertificates[functionIndex] =
        CompilerCsgSemanticResolvedFunctionHeadCertificate(functionIndex, newIndex)
    accumulator.resolvedCallSet.version = accumulator.resolvedCallSet.version + Int64(1)
    accumulator.resolvedCallSet.sealedVersion = accumulator.resolvedCallSet.version
    accumulator.stateVersion = accumulator.stateVersion + Int64(1)

fn CompilerCsgSemanticResolvedCallSetClear(callSet: var CompilerCsgSemanticResolvedCallSet) =
    callSet = CompilerCsgSemanticResolvedCallSet()

@borrows
fn compilerCsgCallOwnershipProjectionTableValidate(
        table: CompilerCsgCallOwnershipProjectionTable,
        effectCount: int32,
        complete: bool,
        err: var str): bool =
    if effectCount < 0 ||
       table.effectStarts.len != effectCount ||
       table.effectCounts.len != effectCount ||
       table.effectProjectionCids.len != effectCount:
        err = " compiler csg: call ownership projection effect columns mismatch"
        return false
    let hopCount = table.hopIds.len
    if table.hopEffectRows.len != hopCount ||
       table.hopOrdinals.len != hopCount ||
       table.hopNodeIndexes.len != hopCount ||
       table.hopOpKinds.len != hopCount ||
       table.hopExactTypeIds.len != hopCount ||
       table.hopOwnerProducerSourceIndexes.len != hopCount ||
       table.hopOwnerDeclarationSourceLocalRows.len != hopCount ||
       table.hopOperand0NodeIndexes.len != hopCount ||
       table.hopFieldProducerSourceIndexes.len != hopCount ||
       table.hopFieldOwnerDeclarationSourceLocalRows.len != hopCount ||
       table.hopFieldDeclarationSourceLocalRows.len != hopCount ||
       table.hopFieldOrdinals.len != hopCount ||
       table.hopFieldBuiltinKinds.len != hopCount ||
       table.hopIndexNodeIndexes.len != hopCount ||
       table.hopCids.len != hopCount:
        err = " compiler csg: call ownership projection hop columns mismatch"
        return false
    if !complete && (effectCount != 0 || hopCount != 0):
        err = " compiler csg: unresolved call carries ownership projection"
        return false
    var coveredHopCount: int32
    for effectRow in 0..<effectCount:
        let hopStart = table.effectStarts[effectRow]
        let effectHopCount = table.effectCounts[effectRow]
        if hopStart != coveredHopCount ||
           effectHopCount < 0 ||
           hopStart > hopCount - effectHopCount ||
           layout.FixedBytes32Equal(
               table.effectProjectionCids[effectRow],
               layout.FixedBytes32()):
            err = Fmt" compiler csg: call ownership projection effect range invalid effect={effectRow}"
            return false
        for hopRow in hopStart..<hopStart + effectHopCount:
            let opKind = table.hopOpKinds[hopRow]
            let fieldHop =
                opKind == Int32(texpr.TypedExprIrOpFieldGet)
            let indexHop =
                opKind == Int32(texpr.TypedExprIrOpIndexGet)
            if table.hopIds[hopRow] != hopRow ||
               table.hopEffectRows[hopRow] != effectRow ||
               table.hopOrdinals[hopRow] != hopRow - hopStart ||
               table.hopNodeIndexes[hopRow] < 0 ||
               table.hopExactTypeIds[hopRow] < 0 ||
               table.hopOwnerProducerSourceIndexes[hopRow] < 0 ||
               table.hopOwnerDeclarationSourceLocalRows[hopRow] < 0 ||
               table.hopOperand0NodeIndexes[hopRow] < 0 ||
               (!fieldHop && !indexHop) ||
               (fieldHop &&
                (table.hopFieldProducerSourceIndexes[hopRow] < 0 ||
                 table.hopFieldOrdinals[hopRow] < 0 ||
                 table.hopFieldBuiltinKinds[hopRow] <
                     Int32(texpr.TypedExprLayoutBuiltinNone) ||
                 table.hopFieldBuiltinKinds[hopRow] >
                     Int32(texpr.TypedExprLayoutBuiltinOptional) ||
                 (table.hopFieldBuiltinKinds[hopRow] ==
                      Int32(texpr.TypedExprLayoutBuiltinNone) &&
                  (table.hopFieldOwnerDeclarationSourceLocalRows[
                       hopRow] < 0 ||
                   table.hopFieldDeclarationSourceLocalRows[
                       hopRow] < 0)) ||
                 (table.hopFieldBuiltinKinds[hopRow] !=
                      Int32(texpr.TypedExprLayoutBuiltinNone) &&
                  (table.hopFieldOwnerDeclarationSourceLocalRows[
                       hopRow] != -1 ||
                   table.hopFieldDeclarationSourceLocalRows[
                       hopRow] != -1)) ||
                 table.hopIndexNodeIndexes[hopRow] != -1)) ||
               (indexHop &&
                (table.hopFieldProducerSourceIndexes[hopRow] != -1 ||
                 table.hopFieldOwnerDeclarationSourceLocalRows[
                     hopRow] != -1 ||
                 table.hopFieldDeclarationSourceLocalRows[
                     hopRow] != -1 ||
                 table.hopFieldOrdinals[hopRow] != -1 ||
                 table.hopFieldBuiltinKinds[hopRow] != -1 ||
                 table.hopIndexNodeIndexes[hopRow] < 0)) ||
               layout.FixedBytes32Equal(
                   table.hopCids[hopRow],
                   layout.FixedBytes32()):
                err = Fmt" compiler csg: call ownership projection hop identity invalid hop={hopRow}"
                return false
        coveredHopCount = coveredHopCount + effectHopCount
    if coveredHopCount != hopCount:
        err = " compiler csg: call ownership projection hop coverage incomplete"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgManualConsumeCallTokenCid(
        tokenId: int32,
        callRow: int32,
        callerTypedFunctionIndex: int32,
        callExprNodeIndex: int32,
        calleeFunctionIndex: int32,
        targetArgumentRow: int32,
        sourceArgumentRow: int32,
        targetArgumentOrdinal: int32,
        sourceArgumentOrdinal: int32,
        targetArgLinkNodeIndex: int32,
        sourceArgLinkNodeIndex: int32,
        targetValueNodeIndex: int32,
        sourceValueNodeIndex: int32,
        targetParameterDeclarationRow: int32,
        sourceParameterDeclarationRow: int32,
        targetTypeId: int32,
        sourceTypeId: int32,
        targetBindingCid: layout.FixedBytes32,
        sourceBindingCid: layout.FixedBytes32,
        targetRootValueDefinitionRow: int32,
        sourceValueDefinitionRow: int32,
        targetProjectionCid: layout.FixedBytes32,
        sourceProjectionCid: layout.FixedBytes32,
        typedEffectCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(320)
    CompilerCsgAppendText(
        buf, "cheng.compiler.csg.manual_consume_call_token")
    CompilerCsgAppendU32BE(buf, tokenId)
    CompilerCsgAppendU32BE(buf, callRow)
    CompilerCsgAppendU32BE(buf, callerTypedFunctionIndex)
    CompilerCsgAppendU32BE(buf, callExprNodeIndex)
    CompilerCsgAppendU32BE(buf, calleeFunctionIndex)
    CompilerCsgAppendU32BE(buf, targetArgumentRow)
    CompilerCsgAppendU32BE(buf, sourceArgumentRow)
    CompilerCsgAppendU32BE(buf, targetArgumentOrdinal)
    CompilerCsgAppendU32BE(buf, sourceArgumentOrdinal)
    CompilerCsgAppendU32BE(buf, targetArgLinkNodeIndex)
    CompilerCsgAppendU32BE(buf, sourceArgLinkNodeIndex)
    CompilerCsgAppendU32BE(buf, targetValueNodeIndex)
    CompilerCsgAppendU32BE(buf, sourceValueNodeIndex)
    CompilerCsgAppendU32BE(buf, targetParameterDeclarationRow)
    CompilerCsgAppendU32BE(buf, sourceParameterDeclarationRow)
    CompilerCsgAppendU32BE(buf, targetTypeId)
    CompilerCsgAppendU32BE(buf, sourceTypeId)
    CompilerCsgAppendFixed32(buf, targetBindingCid)
    CompilerCsgAppendFixed32(buf, sourceBindingCid)
    CompilerCsgAppendU32BE(buf, targetRootValueDefinitionRow)
    CompilerCsgAppendU32BE(buf, sourceValueDefinitionRow)
    CompilerCsgAppendFixed32(buf, targetProjectionCid)
    CompilerCsgAppendFixed32(buf, sourceProjectionCid)
    CompilerCsgAppendFixed32(buf, typedEffectCid)
    return CompilerCsgBufCid(buf)

@borrows
fn CompilerCsgManualConsumeCallTokenTableStrictValidateInto(
        table: CompilerCsgManualConsumeCallTokenTable,
        err: var str): bool =
    let count = table.tokenIds.len
    if table.callRows.len != count ||
       table.callerTypedFunctionIndexes.len != count ||
       table.callExprNodeIndexes.len != count ||
       table.calleeFunctionIndexes.len != count ||
       table.targetArgumentRows.len != count ||
       table.sourceArgumentRows.len != count ||
       table.targetArgumentOrdinals.len != count ||
       table.sourceArgumentOrdinals.len != count ||
       table.targetArgLinkNodeIndexes.len != count ||
       table.sourceArgLinkNodeIndexes.len != count ||
       table.targetValueNodeIndexes.len != count ||
       table.sourceValueNodeIndexes.len != count ||
       table.targetParameterDeclarationRows.len != count ||
       table.sourceParameterDeclarationRows.len != count ||
       table.targetTypeIds.len != count ||
       table.sourceTypeIds.len != count ||
       table.targetBindingCids.len != count ||
       table.sourceBindingCids.len != count ||
       table.targetPlaceRootValueDefinitionRows.len != count ||
       table.sourceValueDefinitionRows.len != count ||
       table.targetProjectionCids.len != count ||
       table.sourceProjectionCids.len != count ||
       table.typedEffectCids.len != count ||
       table.tokenCids.len != count:
        err = " compiler csg: manual-consume call token columns mismatch"
        return false
    if !table.complete:
        if count != 0 ||
           !compilerCsgCallOwnershipProjectionTableValidate(
                table.projection, 0, false, err):
            if err == "":
                err = " compiler csg: incomplete manual-consume token table is non-empty"
            return false
        err = ""
        return true
    if count > 1073741823 ||
       !compilerCsgCallOwnershipProjectionTableValidate(
            table.projection, count * 2, true, err):
        return false
    var previousCallRow: int32 = -1
    for tokenRow in 0..<count:
        let targetProjectionRow = tokenRow * 2
        let sourceProjectionRow = targetProjectionRow + 1
        let expectedCid = CompilerCsgManualConsumeCallTokenCid(
            table.tokenIds[tokenRow],
            table.callRows[tokenRow],
            table.callerTypedFunctionIndexes[tokenRow],
            table.callExprNodeIndexes[tokenRow],
            table.calleeFunctionIndexes[tokenRow],
            table.targetArgumentRows[tokenRow],
            table.sourceArgumentRows[tokenRow],
            table.targetArgumentOrdinals[tokenRow],
            table.sourceArgumentOrdinals[tokenRow],
            table.targetArgLinkNodeIndexes[tokenRow],
            table.sourceArgLinkNodeIndexes[tokenRow],
            table.targetValueNodeIndexes[tokenRow],
            table.sourceValueNodeIndexes[tokenRow],
            table.targetParameterDeclarationRows[tokenRow],
            table.sourceParameterDeclarationRows[tokenRow],
            table.targetTypeIds[tokenRow],
            table.sourceTypeIds[tokenRow],
            table.targetBindingCids[tokenRow],
            table.sourceBindingCids[tokenRow],
            table.targetPlaceRootValueDefinitionRows[tokenRow],
            table.sourceValueDefinitionRows[tokenRow],
            table.targetProjectionCids[tokenRow],
            table.sourceProjectionCids[tokenRow],
            table.typedEffectCids[tokenRow])
        if table.tokenIds[tokenRow] != tokenRow ||
           table.callRows[tokenRow] <= previousCallRow ||
           table.callerTypedFunctionIndexes[tokenRow] < 0 ||
           table.callExprNodeIndexes[tokenRow] < 0 ||
           table.calleeFunctionIndexes[tokenRow] < 0 ||
           table.targetArgumentRows[tokenRow] < 0 ||
           table.sourceArgumentRows[tokenRow] < 0 ||
           table.targetArgumentRows[tokenRow] ==
               table.sourceArgumentRows[tokenRow] ||
           table.targetArgumentOrdinals[tokenRow] < 0 ||
           table.sourceArgumentOrdinals[tokenRow] < 0 ||
           table.targetArgumentOrdinals[tokenRow] ==
               table.sourceArgumentOrdinals[tokenRow] ||
           table.targetArgLinkNodeIndexes[tokenRow] < 0 ||
           table.sourceArgLinkNodeIndexes[tokenRow] < 0 ||
           table.targetValueNodeIndexes[tokenRow] < 0 ||
           table.sourceValueNodeIndexes[tokenRow] < 0 ||
           table.targetParameterDeclarationRows[tokenRow] < 0 ||
           table.sourceParameterDeclarationRows[tokenRow] < 0 ||
           table.targetParameterDeclarationRows[tokenRow] ==
               table.sourceParameterDeclarationRows[tokenRow] ||
           table.targetTypeIds[tokenRow] < 0 ||
           table.sourceTypeIds[tokenRow] < 0 ||
           table.targetTypeIds[tokenRow] == table.sourceTypeIds[tokenRow] ||
           table.targetPlaceRootValueDefinitionRows[tokenRow] < 0 ||
           table.sourceValueDefinitionRows[tokenRow] < 0 ||
           !layout.FixedBytes32Equal(
               table.targetProjectionCids[tokenRow],
               table.projection.effectProjectionCids[
                   targetProjectionRow]) ||
           !layout.FixedBytes32Equal(
               table.sourceProjectionCids[tokenRow],
               table.projection.effectProjectionCids[
                   sourceProjectionRow]) ||
           layout.FixedBytes32Equal(
               table.targetBindingCids[tokenRow],
               layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               table.sourceBindingCids[tokenRow],
               layout.FixedBytes32()) ||
           layout.FixedBytes32Equal(
               table.typedEffectCids[tokenRow],
               layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(
               table.tokenCids[tokenRow], expectedCid):
            err = Fmt" compiler csg: manual-consume call token identity invalid token={tokenRow}"
            return false
        previousCallRow = table.callRows[tokenRow]
    err = ""
    return true

# Read-only over `table`: a validator only inspects rows.
@borrows
fn CompilerCsgSemanticResolvedCallTableValidate(table: CompilerCsgSemanticResolvedCallTable,
                                           functionCount: int32,
                                           err: var str): bool =
    if functionCount < 0:
        err = Fmt" compiler csg: resolved-call function count invalid count={functionCount}"
        return false
    if table.internPool == nil:
        err = " compiler csg: resolved-call intern pool missing"
        return false
    if table.functionRowHeads.len != functionCount:
        err = Fmt" compiler csg: resolved-call function heads mismatch heads={table.functionRowHeads.len} functions={functionCount}"
        return false
    let rowCount = table.sourceIndexes.len
    if table.originParserNodeIds.len != rowCount ||
       table.functionIndexes.len != rowCount ||
       table.functionRowNext.len != rowCount ||
       table.sourcePathIds.len != rowCount ||
       table.lineNumbers.len != rowCount ||
       table.columnNumbers.len != rowCount ||
       table.callQualifierIds.len != rowCount ||
       table.callCalleeIds.len != rowCount ||
       table.callTargetIds.len != rowCount ||
       table.callTargetSourcePathIds.len != rowCount ||
       table.callTargetSignatureLineNumbers.len != rowCount ||
       table.callTargetImportcFlags.len != rowCount ||
       table.callArgCounts.len != rowCount ||
       table.callArgsTextIds.len != rowCount ||
       table.returnRootFlags.len != rowCount ||
       table.targetProducerSourceIndexes.len != rowCount ||
       table.targetProducerDeclarationOrdinals.len != rowCount ||
       table.targetParserSourceLocalDeclarationRows.len != rowCount ||
       table.callerGraphNodeIds.len != rowCount ||
       table.targetGraphNodeIds.len != rowCount ||
       table.typedCallNodeIndexes.len != rowCount ||
       table.targetFunctionIndexes.len != rowCount ||
       table.targetFunctionAnnotationFlags.len != rowCount ||
       table.targetFunctionContractCids.len != rowCount ||
       table.callArgumentStarts.len != rowCount ||
       table.ownershipEffectStarts.len != rowCount ||
       table.ownershipEffectCounts.len != rowCount:
        err = Fmt" compiler csg: resolved-call row columns mismatch rows={rowCount} origins={table.originParserNodeIds.len} functions={table.functionIndexes.len} next={table.functionRowNext.len} source_paths={table.sourcePathIds.len} lines={table.lineNumbers.len} columns={table.columnNumbers.len} qualifiers={table.callQualifierIds.len} callees={table.callCalleeIds.len} targets={table.callTargetIds.len} target_sources={table.callTargetSourcePathIds.len} target_signature_lines={table.callTargetSignatureLineNumbers.len} importc={table.callTargetImportcFlags.len} args={table.callArgCounts.len} args_text={table.callArgsTextIds.len} returns={table.returnRootFlags.len} target_producer_sources={table.targetProducerSourceIndexes.len} target_declaration_ordinals={table.targetProducerDeclarationOrdinals.len} target_parser_source_local_rows={table.targetParserSourceLocalDeclarationRows.len}"
        return false
    for rowIndex in 0..<rowCount:
        if table.originParserNodeIds[rowIndex] < 0:
            err = Fmt" compiler csg: resolved-call parser origin invalid row={rowIndex} origin={table.originParserNodeIds[rowIndex]}"
            return false
        if table.functionIndexes[rowIndex] < 0 ||
           table.functionIndexes[rowIndex] >= functionCount:
            err = Fmt" compiler csg: resolved-call owner index invalid row={rowIndex} function_index={table.functionIndexes[rowIndex]} function_count={functionCount}"
            return false
        if table.functionRowNext[rowIndex] < -1 ||
           table.functionRowNext[rowIndex] >= rowCount:
            err = Fmt" compiler csg: resolved-call adjacency next out of range row={rowIndex} next={table.functionRowNext[rowIndex]} rows={rowCount}"
            return false
        if table.callArgCounts[rowIndex] < 0:
            err = Fmt" compiler csg: resolved-call argument count invalid row={rowIndex}"
            return false
        if (table.callTargetImportcFlags[rowIndex] &&
            table.callTargetSignatureLineNumbers[rowIndex] != 0) ||
           (!table.callTargetImportcFlags[rowIndex] &&
            table.callTargetSignatureLineNumbers[rowIndex] <= 0):
            err = Fmt" compiler csg: resolved-call declaration identity invalid row={rowIndex} signature_line={table.callTargetSignatureLineNumbers[rowIndex]}"
            return false
        if table.graphNodeProjectionComplete:
            if table.targetProducerSourceIndexes[rowIndex] < 0 ||
               table.targetProducerDeclarationOrdinals[rowIndex] < 0 ||
               table.targetParserSourceLocalDeclarationRows[rowIndex] < 0 ||
               table.callerGraphNodeIds[rowIndex] <= 0 ||
               table.typedCallNodeIndexes[rowIndex] < 0 ||
               table.callArgumentStarts[rowIndex] < 0 ||
               table.ownershipEffectStarts[rowIndex] < 0 ||
               table.ownershipEffectCounts[rowIndex] < 0 ||
               (table.callTargetImportcFlags[rowIndex] &&
                (table.targetGraphNodeIds[rowIndex] != -1 ||
                 table.targetFunctionIndexes[rowIndex] != -1 ||
                 table.targetFunctionAnnotationFlags[rowIndex] != 0 ||
                 !layout.FixedBytes32Equal(
                     table.targetFunctionContractCids[rowIndex],
                     layout.FixedBytes32()))) ||
               (!table.callTargetImportcFlags[rowIndex] &&
                (table.targetGraphNodeIds[rowIndex] <= 0 ||
                 table.targetFunctionIndexes[rowIndex] < 0 ||
                 !parser.ParserNormalizedFunctionAnnotationFlagsValid(
                     table.targetFunctionAnnotationFlags[rowIndex]) ||
                 layout.FixedBytes32Equal(
                     table.targetFunctionContractCids[rowIndex],
                     layout.FixedBytes32()))):
                err = Fmt" compiler csg: resolved-call graph-node identity invalid row={rowIndex} caller_node={table.callerGraphNodeIds[rowIndex]} target_node={table.targetGraphNodeIds[rowIndex]}"
                return false
        elif table.targetProducerSourceIndexes[rowIndex] != -1 ||
             table.targetProducerDeclarationOrdinals[rowIndex] != -1 ||
             table.targetParserSourceLocalDeclarationRows[rowIndex] != -1 ||
             table.callerGraphNodeIds[rowIndex] != -1 ||
             table.targetGraphNodeIds[rowIndex] != -1 ||
             table.typedCallNodeIndexes[rowIndex] != -1 ||
             table.targetFunctionIndexes[rowIndex] != -1 ||
             table.targetFunctionAnnotationFlags[rowIndex] != 0 ||
             !layout.FixedBytes32Equal(
                 table.targetFunctionContractCids[rowIndex],
                 layout.FixedBytes32()) ||
             table.callArgumentStarts[rowIndex] != -1 ||
             table.ownershipEffectStarts[rowIndex] != -1 ||
             table.ownershipEffectCounts[rowIndex] != 0:
            err = Fmt" compiler csg: partial resolved-call target identity projection row={rowIndex}"
            return false
    let argumentBindingCount = table.callArgumentBindingIds.len
    if table.callArgumentCallRows.len != argumentBindingCount ||
       table.callArgumentOrdinals.len != argumentBindingCount ||
       table.callArgumentArgLinkNodeIndexes.len != argumentBindingCount ||
       table.callArgumentValueNodeIndexes.len != argumentBindingCount ||
       table.callArgumentTargetParameterDeclarationRows.len !=
           argumentBindingCount ||
       table.callArgumentTargetParameterMutableFlags.len !=
           argumentBindingCount ||
       table.callArgumentBindingCids.len != argumentBindingCount:
        err = " compiler csg: resolved-call argument binding columns mismatch"
        return false
    if !table.graphNodeProjectionComplete &&
       argumentBindingCount != 0:
        err = " compiler csg: unresolved call carries argument bindings"
        return false
    var coveredArgumentBindingCount: int32
    for rowIndex in 0..<rowCount:
        if !table.graphNodeProjectionComplete:
            continue
        let argumentStart = table.callArgumentStarts[rowIndex]
        let argumentCount = table.callArgCounts[rowIndex]
        if argumentStart != coveredArgumentBindingCount ||
           argumentStart > argumentBindingCount - argumentCount:
            err = Fmt" compiler csg: call argument binding range invalid row={rowIndex}"
            return false
        for bindingIndex in argumentStart..<argumentStart + argumentCount:
            if table.callArgumentBindingIds[bindingIndex] !=
                   bindingIndex ||
               table.callArgumentCallRows[bindingIndex] != rowIndex ||
               table.callArgumentOrdinals[bindingIndex] !=
                   bindingIndex - argumentStart ||
               table.callArgumentArgLinkNodeIndexes[bindingIndex] < 0 ||
               table.callArgumentValueNodeIndexes[bindingIndex] < 0 ||
               table.callArgumentTargetParameterDeclarationRows[
                   bindingIndex] < 0 ||
               layout.FixedBytes32Equal(
                   table.callArgumentBindingCids[bindingIndex],
                   layout.FixedBytes32()):
                err = Fmt" compiler csg: call argument binding identity invalid binding={bindingIndex}"
                return false
        coveredArgumentBindingCount =
            coveredArgumentBindingCount + argumentCount
    if table.graphNodeProjectionComplete &&
       coveredArgumentBindingCount != argumentBindingCount:
        err = " compiler csg: call argument binding coverage incomplete"
        return false
    let effectCount = table.ownershipEffectIds.len
    if table.ownershipEffectCallRows.len != effectCount ||
       table.ownershipEffectCallArgumentRows.len != effectCount ||
       table.ownershipEffectArgumentOrdinals.len != effectCount ||
       table.ownershipEffectArgLinkNodeIndexes.len != effectCount ||
       table.ownershipEffectValueNodeIndexes.len != effectCount ||
       table.ownershipEffectValueNodeOwnerships.len != effectCount ||
       table.ownershipEffectValueDefinitionRows.len != effectCount ||
       table.ownershipEffectValueDefinitionOwnerships.len !=
           effectCount ||
       table.ownershipEffectValueDefinitionOriginKinds.len !=
           effectCount ||
       table.ownershipEffectValueDefinitionTypedFunctionIndexes.len !=
           effectCount ||
       table.ownershipEffectValueDefinitionExactTypeIds.len !=
           effectCount ||
       table.ownershipEffectValueDefinitionDefiningNodeIndexes.len !=
           effectCount ||
       table.ownershipEffectValueDefinitionProducerSourceIndexes.len !=
           effectCount ||
       table.ownershipEffectValueDefinitionSourceLocalNodeIndexes.len !=
           effectCount ||
       table.ownershipEffectValueDefinitionDeclarationSourceLocalRows.len !=
           effectCount ||
       table.ownershipEffectKinds.len != effectCount ||
       table.ownershipEffectCids.len != effectCount:
        err = " compiler csg: resolved-call ownership effect columns mismatch"
        return false
    if !table.graphNodeProjectionComplete && effectCount != 0:
        err = " compiler csg: unresolved call carries ownership effects"
        return false
    var coveredEffectCount: int32
    for rowIndex in 0..<rowCount:
        if !table.graphNodeProjectionComplete:
            continue
        let effectStart = table.ownershipEffectStarts[rowIndex]
        let rowEffectCount = table.ownershipEffectCounts[rowIndex]
        if effectStart != coveredEffectCount ||
           effectStart > effectCount - rowEffectCount:
            err = Fmt" compiler csg: call ownership effect range invalid row={rowIndex}"
            return false
        for effectIndex in effectStart..<effectStart + rowEffectCount:
            if table.ownershipEffectIds[effectIndex] != effectIndex ||
               table.ownershipEffectCallRows[effectIndex] != rowIndex ||
               table.ownershipEffectCallArgumentRows[effectIndex] <
                   table.callArgumentStarts[rowIndex] ||
               table.ownershipEffectCallArgumentRows[effectIndex] >=
                   table.callArgumentStarts[rowIndex] +
                       table.callArgCounts[rowIndex] ||
               table.ownershipEffectArgumentOrdinals[effectIndex] < 0 ||
               table.ownershipEffectArgumentOrdinals[effectIndex] >=
                   table.callArgCounts[rowIndex] ||
               table.ownershipEffectArgLinkNodeIndexes[effectIndex] < 0 ||
               table.ownershipEffectValueNodeIndexes[effectIndex] < 0 ||
               (table.ownershipEffectValueNodeOwnerships[
                    effectIndex] !=
                    Int32(texpr.TypedExprExprOwned) &&
                table.ownershipEffectValueNodeOwnerships[
                    effectIndex] !=
                    Int32(texpr.TypedExprExprBorrowed)) ||
               table.ownershipEffectValueDefinitionRows[effectIndex] < 0 ||
               (table.ownershipEffectValueDefinitionOwnerships[
                    effectIndex] !=
                    Int32(texpr.TypedExprExprOwned) &&
                table.ownershipEffectValueDefinitionOwnerships[
                    effectIndex] !=
                    Int32(texpr.TypedExprExprBorrowed)) ||
               table.ownershipEffectValueDefinitionOriginKinds[
                   effectIndex] <=
                   Int32(
                       texpr.TypedExprValueDefinitionOriginInvalid) ||
               table.ownershipEffectValueDefinitionOriginKinds[
                   effectIndex] >
                   Int32(
                       texpr.TypedExprValueDefinitionOriginManagedTemporary) ||
               table.ownershipEffectValueDefinitionTypedFunctionIndexes[
                       effectIndex] < 0 ||
               table.ownershipEffectValueDefinitionExactTypeIds[
                   effectIndex] < 0 ||
               table.ownershipEffectValueDefinitionDefiningNodeIndexes[
                       effectIndex] < 0 ||
               table.ownershipEffectValueDefinitionProducerSourceIndexes[
                       effectIndex] < 0 ||
               ((table.ownershipEffectValueDefinitionOriginKinds[
                     effectIndex] ==
                     Int32(
                         texpr.TypedExprValueDefinitionOriginParameter)) &&
                (table.ownershipEffectValueDefinitionSourceLocalNodeIndexes[
                         effectIndex] != -1 ||
                 table.ownershipEffectValueDefinitionDeclarationSourceLocalRows[
                         effectIndex] < 0)) ||
               ((table.ownershipEffectValueDefinitionOriginKinds[
                     effectIndex] ==
                     Int32(
                         texpr.TypedExprValueDefinitionOriginBindingInitializer)) &&
                (table.ownershipEffectValueDefinitionSourceLocalNodeIndexes[
                         effectIndex] < 0 ||
                 table.ownershipEffectValueDefinitionDeclarationSourceLocalRows[
                         effectIndex] < 0)) ||
               ((table.ownershipEffectValueDefinitionOriginKinds[
                     effectIndex] ==
                     Int32(
                         texpr.TypedExprValueDefinitionOriginCallResult) ||
                 table.ownershipEffectValueDefinitionOriginKinds[
                     effectIndex] ==
                     Int32(
                         texpr.TypedExprValueDefinitionOriginManagedTemporary)) &&
                (table.ownershipEffectValueDefinitionSourceLocalNodeIndexes[
                         effectIndex] < 0 ||
                 table.ownershipEffectValueDefinitionDeclarationSourceLocalRows[
                         effectIndex] != -1)) ||
               (table.ownershipEffectKinds[effectIndex] !=
                    CompilerCsgCallOwnershipEffectBorrow &&
                table.ownershipEffectKinds[effectIndex] !=
                    CompilerCsgCallOwnershipEffectEscape) ||
               layout.FixedBytes32Equal(
                   table.ownershipEffectCids[effectIndex],
                   layout.FixedBytes32()):
                err = Fmt" compiler csg: call ownership effect identity invalid effect={effectIndex}"
                return false
        coveredEffectCount = coveredEffectCount + rowEffectCount
    if table.graphNodeProjectionComplete &&
       coveredEffectCount != effectCount:
        err = " compiler csg: call ownership effect coverage incomplete"
        return false
    if !compilerCsgCallOwnershipProjectionTableValidate(
           table.ownershipProjection,
           effectCount,
           table.graphNodeProjectionComplete,
           err):
        return false
    var chainedRowCount: int32
    for functionIndex in 0..<functionCount:
        var rowIndex = table.functionRowHeads[functionIndex]
        if rowIndex < -1 || rowIndex >= rowCount:
            err = Fmt" compiler csg: resolved-call adjacency head out of range function_index={functionIndex} row={rowIndex} rows={rowCount}"
            return false
        var localRowCount: int32
        while rowIndex >= 0:
            if table.functionIndexes[rowIndex] != functionIndex:
                err = Fmt" compiler csg: resolved-call adjacency owner mismatch function_index={functionIndex} row={rowIndex} actual={table.functionIndexes[rowIndex]}"
                return false
            localRowCount = localRowCount + 1
            if localRowCount > rowCount:
                err = Fmt" compiler csg: resolved-call adjacency cycle function_index={functionIndex} row={rowIndex}"
                return false
            rowIndex = table.functionRowNext[rowIndex]
        chainedRowCount = chainedRowCount + localRowCount
    if chainedRowCount != rowCount:
        err = Fmt" compiler csg: resolved-call adjacency coverage mismatch chained={chainedRowCount} rows={rowCount}"
        return false
    err = ""
    return true

# Bind every retained resolved call to the exact parser-owned call event. The
# parser receipt must already have passed ParserNormalizedExprReceiptVerify;
# this join consumes only source-local producer ids and canonical call-event
# rows, never text, position, name, or arity.
@borrows
fn CompilerCsgSemanticResolvedCallParserOriginsStrictValidateInto(
        table: CompilerCsgSemanticResolvedCallTable,
        receipt: parser_receipt.ParserNormalizedExprReceipt,
        err: var str): bool =
    let rowCount = table.sourceIndexes.len
    if table.originParserNodeIds.len != rowCount ||
       receipt.sourceSidecars.len <= 0 ||
       Int64(receipt.sourceSidecars.len) != receipt.sourceCount:
        err = " compiler csg: resolved-call parser origin binding shape mismatch"
        return false
    var sourceNodeStarts: int32[]
    setLen(sourceNodeStarts, receipt.sourceSidecars.len)
    var producerCallEventFlags: bool[]
    for sourceIndex in 0..<receipt.sourceSidecars.len:
        let sidecar = receipt.sourceSidecars[sourceIndex]
        let nodeCount = sidecar.nodeProducerIds.len
        if sidecar.sourceIndex != sourceIndex ||
           sidecar.nodeKinds.len != nodeCount:
            err = Fmt" compiler csg: resolved-call parser source domain invalid source_index={sourceIndex}"
            return false
        let sourceNodeStart = producerCallEventFlags.len
        sourceNodeStarts[sourceIndex] = sourceNodeStart
        for nodeIndex in 0..<nodeCount:
            add(producerCallEventFlags, false)
        for eventIndex in 0..<sidecar.callEventNodeIds.len:
            let canonicalNodeId = sidecar.callEventNodeIds[eventIndex]
            if canonicalNodeId < 0 || canonicalNodeId >= nodeCount:
                err = Fmt" compiler csg: resolved-call canonical call event invalid source_index={sourceIndex} event_index={eventIndex} node={canonicalNodeId}"
                return false
            let producerNodeId = sidecar.nodeProducerIds[canonicalNodeId]
            if producerNodeId < 0 || producerNodeId >= nodeCount:
                err = Fmt" compiler csg: resolved-call producer call event invalid source_index={sourceIndex} event_index={eventIndex} node={producerNodeId}"
                return false
            let producerSlot = sourceNodeStart + producerNodeId
            if producerCallEventFlags[producerSlot]:
                err = Fmt" compiler csg: resolved-call parser call event duplicated source_index={sourceIndex} origin={producerNodeId}"
                return false
            producerCallEventFlags[producerSlot] = true
    for rowIndex in 0..<rowCount:
        let sourceIndex = table.sourceIndexes[rowIndex]
        if sourceIndex < 0 || sourceIndex >= receipt.sourceSidecars.len:
            err = Fmt" compiler csg: resolved-call parser source missing row={rowIndex} source_index={sourceIndex}"
            return false
        let originParserNodeId = table.originParserNodeIds[rowIndex]
        let nodeCount =
            receipt.sourceSidecars[sourceIndex].nodeProducerIds.len
        if originParserNodeId < 0 || originParserNodeId >= nodeCount ||
           !producerCallEventFlags[
               sourceNodeStarts[sourceIndex] + originParserNodeId]:
            err = Fmt" compiler csg: resolved-call origin is not an exact parser call event row={rowIndex} source_index={sourceIndex} origin={originParserNodeId}"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgSemanticResolvedCallStoredHash(table: CompilerCsgSemanticResolvedCallTable,
                                       rowIndex: int32): int32 =
    return CompilerCsgSemanticResolvedCallHash(
        table.sourceIndexes[rowIndex], table.originParserNodeIds[rowIndex])

@borrows
fn CompilerCsgSemanticResolvedCallSetValidate(table: CompilerCsgSemanticResolvedCallTable,
                                        callSet: CompilerCsgSemanticResolvedCallSet,
                                        err: var str): bool =
    let rowCount = table.sourceIndexes.len
    if !CompilerCsgSparseIntIndexValidate(callSet.hashIndex, err):
        return false
    if callSet.hashSlotCertificates.len != callSet.hashIndex.slots.len ||
       callSet.bucketHeads.len != callSet.hashIndex.keys.len ||
       callSet.bucketHeadCertificates.len != callSet.hashIndex.keys.len ||
       callSet.nextIndexes.len != rowCount || callSet.nextCertificates.len != rowCount:
        err = Fmt" compiler csg: resolved-call set columns mismatch keys={callSet.hashIndex.keys.len} heads={callSet.bucketHeads.len} head_certificates={callSet.bucketHeadCertificates.len} next={callSet.nextIndexes.len} next_certificates={callSet.nextCertificates.len} rows={rowCount}"
        return false
    for slotIndex in 0..<callSet.hashIndex.slots.len:
        if callSet.hashSlotCertificates[slotIndex] !=
           CompilerCsgSemanticResolvedHashSlotCertificate(slotIndex,
                                                    callSet.hashIndex.slots[slotIndex]):
            err = Fmt" compiler csg: resolved hash slot certificate mismatch slot={slotIndex}"
            return false
    var chainedRows: int32
    for bucketRow in 0..<callSet.hashIndex.keys.len:
        let bucketKey = callSet.hashIndex.keys[bucketRow]
        var rowIndex = callSet.bucketHeads[bucketRow]
        if callSet.bucketHeadCertificates[bucketRow] !=
           CompilerCsgSemanticResolvedBucketHeadCertificate(bucketKey, rowIndex):
            err = Fmt" compiler csg: resolved-call bucket certificate mismatch row={bucketRow} key={bucketKey}"
            return false
        if rowIndex < 0 || rowIndex >= rowCount:
            err = Fmt" compiler csg: resolved-call bucket head invalid bucket={bucketRow} row={rowIndex} rows={rowCount}"
            return false
        var localRows: int32
        while rowIndex >= 0:
            if rowIndex >= rowCount || callSet.nextIndexes[rowIndex] < -1 ||
               callSet.nextIndexes[rowIndex] >= rowCount:
                err = Fmt" compiler csg: resolved-call bucket chain invalid bucket={bucketRow} row={rowIndex} rows={rowCount}"
                return false
            if callSet.nextCertificates[rowIndex] !=
               CompilerCsgSemanticResolvedNextCertificate(rowIndex,
                                                    callSet.nextIndexes[rowIndex]):
                err = Fmt" compiler csg: resolved-call next certificate mismatch row={rowIndex}"
                return false
            let expectedKey = CompilerCsgSemanticResolvedCallStoredHash(table, rowIndex)
            if expectedKey != bucketKey:
                err = Fmt" compiler csg: resolved-call bucket owner mismatch bucket={bucketRow} row={rowIndex} key={bucketKey} expected={expectedKey}"
                return false
            localRows = localRows + 1
            if localRows > rowCount:
                err = Fmt" compiler csg: resolved-call bucket cycle slot={bucketRow} row={rowIndex}"
                return false
            rowIndex = callSet.nextIndexes[rowIndex]
        chainedRows = chainedRows + localRows
    if chainedRows != rowCount:
        err = Fmt" compiler csg: resolved-call bucket coverage mismatch chained={chainedRows} rows={rowCount}"
        return false
    for expectedRow in 0..<rowCount:
        let bucketKey = CompilerCsgSemanticResolvedCallStoredHash(table, expectedRow)
        let bucketRow = CompilerCsgSparseIntIndexFind(callSet.hashIndex, bucketKey)
        var rowIndex = bucketRow >= 0 ? callSet.bucketHeads[bucketRow] : -1
        var scanned: int32
        var foundRow = false
        while rowIndex >= 0 && scanned <= rowCount:
            if rowIndex == expectedRow:
                foundRow = true
                break
            rowIndex = callSet.nextIndexes[rowIndex]
            scanned = scanned + 1
        if !foundRow:
            err = Fmt" compiler csg: resolved-call row missing from hash bucket row={expectedRow} key={bucketKey}"
            return false
    err = ""
    return true

@borrows
fn CompilerCsgFunctionAnnotationContractCid(
        functionId: int32,
        producerSourceIndex: int32,
        producerDeclarationIndex: int32,
        annotationFlags: int32,
        declarationHeaderCid: layout.FixedBytes32,
        declarationPathCid: layout.FixedBytes32,
        nameProofCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(160)
    CompilerCsgAppendText(
        buf, "cheng.compiler.csg.function_annotation_contract")
    CompilerCsgAppendU32BE(buf, functionId)
    CompilerCsgAppendU32BE(buf, producerSourceIndex)
    CompilerCsgAppendU32BE(buf, producerDeclarationIndex)
    CompilerCsgAppendU32BE(buf, annotationFlags)
    CompilerCsgAppendFixed32(buf, declarationHeaderCid)
    CompilerCsgAppendFixed32(buf, declarationPathCid)
    CompilerCsgAppendFixed32(buf, nameProofCid)
    return CompilerCsgBufCid(buf)

fn CompilerCsgCallArgumentBindingCid(
        callRow: int32,
        sourceIndex: int32,
        originParserNodeId: int32,
        callerTypedFunctionIndex: int32,
        typedCallNodeIndex: int32,
        targetProducerSourceIndex: int32,
        targetFunctionDeclarationRow: int32,
        bindingId: int32,
        argumentOrdinal: int32,
        argLinkNodeIndex: int32,
        valueNodeIndex: int32,
        parameterDeclarationRow: int32,
        parameterMutable: bool): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128)
    CompilerCsgAppendText(
        buf, "cheng.compiler.csg.call_argument_parameter_binding")
    CompilerCsgAppendU32BE(buf, callRow)
    CompilerCsgAppendU32BE(buf, sourceIndex)
    CompilerCsgAppendU32BE(buf, originParserNodeId)
    CompilerCsgAppendU32BE(buf, callerTypedFunctionIndex)
    CompilerCsgAppendU32BE(buf, typedCallNodeIndex)
    CompilerCsgAppendU32BE(buf, targetProducerSourceIndex)
    CompilerCsgAppendU32BE(buf, targetFunctionDeclarationRow)
    CompilerCsgAppendU32BE(buf, bindingId)
    CompilerCsgAppendU32BE(buf, argumentOrdinal)
    CompilerCsgAppendU32BE(buf, argLinkNodeIndex)
    CompilerCsgAppendU32BE(buf, valueNodeIndex)
    CompilerCsgAppendU32BE(buf, parameterDeclarationRow)
    CompilerCsgAppendU32BE(
        buf, parameterMutable ? Int32(1) : Int32(0))
    return CompilerCsgBufCid(buf)

fn compilerCsgCallOwnershipProjectionHopCid(
        effectRow: int32,
        hopId: int32,
        hopOrdinal: int32,
        nodeIndex: int32,
        opKind: int32,
        exactTypeId: int32,
        ownerProducerSourceIndex: int32,
        ownerDeclarationSourceLocalRow: int32,
        operand0NodeIndex: int32,
        fieldProducerSourceIndex: int32,
        fieldOwnerDeclarationSourceLocalRow: int32,
        fieldDeclarationSourceLocalRow: int32,
        fieldOrdinal: int32,
        fieldBuiltinKind: int32,
        indexNodeIndex: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(144)
    CompilerCsgAppendText(
        buf, "cheng.compiler.csg.call_ownership_projection_hop")
    CompilerCsgAppendU32BE(buf, effectRow)
    CompilerCsgAppendU32BE(buf, hopId)
    CompilerCsgAppendU32BE(buf, hopOrdinal)
    CompilerCsgAppendU32BE(buf, nodeIndex)
    CompilerCsgAppendU32BE(buf, opKind)
    CompilerCsgAppendU32BE(buf, exactTypeId)
    CompilerCsgAppendU32BE(buf, ownerProducerSourceIndex)
    CompilerCsgAppendU32BE(
        buf, ownerDeclarationSourceLocalRow)
    CompilerCsgAppendU32BE(buf, operand0NodeIndex)
    CompilerCsgAppendU32BE(buf, fieldProducerSourceIndex)
    CompilerCsgAppendU32BE(
        buf, fieldOwnerDeclarationSourceLocalRow)
    CompilerCsgAppendU32BE(
        buf, fieldDeclarationSourceLocalRow)
    CompilerCsgAppendU32BE(buf, fieldOrdinal)
    CompilerCsgAppendU32BE(buf, fieldBuiltinKind)
    CompilerCsgAppendU32BE(buf, indexNodeIndex)
    return CompilerCsgBufCid(buf)

fn compilerCsgCallOwnershipProjectionCid(
        effectRow: int32,
        valueNodeIndex: int32,
        rootNodeIndex: int32,
        rootValueDefinitionRow: int32,
        hopStart: int32,
        hopCount: int32,
        table: var CompilerCsgCallOwnershipProjectionTable): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128 + hopCount * 32)
    CompilerCsgAppendText(
        buf, "cheng.compiler.csg.call_ownership_projection")
    CompilerCsgAppendU32BE(buf, effectRow)
    CompilerCsgAppendU32BE(buf, valueNodeIndex)
    CompilerCsgAppendU32BE(buf, rootNodeIndex)
    CompilerCsgAppendU32BE(buf, rootValueDefinitionRow)
    CompilerCsgAppendU32BE(buf, hopCount)
    for hopRow in hopStart..<hopStart + hopCount:
        CompilerCsgAppendFixed32(buf, table.hopCids[hopRow])
    return CompilerCsgBufCid(buf)

@borrows
fn compilerCsgCallOwnershipProjectionAppendInto(
        typedIr: texpr.TypedExprIr,
        typedFunctionIndex: int32,
        ownerProducerSourceIndex: int32,
        ownerDeclarationSourceLocalRow: int32,
        effectRow: int32,
        valueNodeIndex: int32,
        table: var CompilerCsgCallOwnershipProjectionTable,
        rootValueDefinitionRow: var int32,
        projectionCid: var layout.FixedBytes32,
        err: var str): bool =
    rootValueDefinitionRow = -1
    projectionCid = layout.FixedBytes32()
    if typedFunctionIndex < 0 ||
       typedFunctionIndex >= typedIr.functions2_functionNameIds.len:
        err = " compiler csg: call ownership projection function invalid"
        return false
    let functionNodeStart = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_nodeStarts,
        typedFunctionIndex)
    let functionNodeCount = arenamod.ArenaArrayInt32Get(
        typedIr.arena,
        typedIr.functions2_nodeCounts,
        typedFunctionIndex)
    if functionNodeStart < 0 || functionNodeCount < 0 ||
       functionNodeStart >
           typedIr.nodes2_nodeIndexs.len - functionNodeCount ||
       valueNodeIndex < functionNodeStart ||
       valueNodeIndex >= functionNodeStart + functionNodeCount:
        err = " compiler csg: call ownership projection leaf owner invalid"
        return false
    let hopStart = table.hopIds.len
    var currentNodeIndex = valueNodeIndex
    while currentNodeIndex >= functionNodeStart &&
          currentNodeIndex < functionNodeStart + functionNodeCount:
        let opKind = typedIr.nodes2_opKinds[currentNodeIndex]
        if opKind != texpr.TypedExprIrOpFieldGet &&
           opKind != texpr.TypedExprIrOpIndexGet:
            break
        let operand0NodeIndex = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_operand0NodeIndexs,
            currentNodeIndex)
        let exactTypeId =
            texpr.TypedExprIrNodeStructuralTypeIdAt(
                typedIr, currentNodeIndex)
        var hopOwnerProducerSourceIndex =
            ownerProducerSourceIndex
        var hopOwnerDeclarationSourceLocalRow =
            ownerDeclarationSourceLocalRow
        if typedIr.nodeAuthorityTypeArenaBound:
            hopOwnerProducerSourceIndex =
                arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_ownerProducerSourceIndexes,
                    currentNodeIndex)
            hopOwnerDeclarationSourceLocalRow =
                arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.
                        nodes2_ownerDeclarationSourceLocalRows,
                    currentNodeIndex)
        if operand0NodeIndex < functionNodeStart ||
           operand0NodeIndex >= currentNodeIndex ||
           exactTypeId < 0 ||
           hopOwnerProducerSourceIndex < 0 ||
           hopOwnerDeclarationSourceLocalRow < 0:
            err = Fmt" compiler csg: call ownership projection hop authority invalid node={currentNodeIndex}"
            return false
        var fieldProducerSourceIndex: int32 = -1
        var fieldOwnerDeclarationSourceLocalRow: int32 = -1
        var fieldDeclarationSourceLocalRow: int32 = -1
        var fieldOrdinal: int32 = -1
        var fieldBuiltinKind: int32 = -1
        var indexNodeIndex: int32 = -1
        if opKind == texpr.TypedExprIrOpFieldGet:
            fieldProducerSourceIndex = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_fieldProducerSourceIndexes,
                currentNodeIndex)
            fieldOwnerDeclarationSourceLocalRow =
                arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_fieldOwnerDeclarationSourceLocalRows,
                    currentNodeIndex)
            fieldDeclarationSourceLocalRow =
                arenamod.ArenaArrayInt32Get(
                    typedIr.arena,
                    typedIr.nodes2_fieldDeclarationSourceLocalRows,
                    currentNodeIndex)
            fieldOrdinal = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_fieldOrdinals,
                currentNodeIndex)
            fieldBuiltinKind = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_fieldBuiltinKinds,
                currentNodeIndex)
            if fieldProducerSourceIndex < 0 ||
               fieldOrdinal < 0 ||
               fieldBuiltinKind <
                   Int32(texpr.TypedExprLayoutBuiltinNone) ||
               fieldBuiltinKind >
                   Int32(texpr.TypedExprLayoutBuiltinOptional) ||
               (fieldBuiltinKind ==
                    Int32(texpr.TypedExprLayoutBuiltinNone) &&
                (fieldOwnerDeclarationSourceLocalRow < 0 ||
                 fieldDeclarationSourceLocalRow < 0)) ||
               (fieldBuiltinKind !=
                    Int32(texpr.TypedExprLayoutBuiltinNone) &&
                (fieldOwnerDeclarationSourceLocalRow != -1 ||
                 fieldDeclarationSourceLocalRow != -1)):
                err = Fmt" compiler csg: call ownership field projection identity invalid node={currentNodeIndex}"
                return false
        else:
            indexNodeIndex = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_operand1NodeIndexs,
                currentNodeIndex)
            if indexNodeIndex < functionNodeStart ||
               indexNodeIndex >= currentNodeIndex:
                err = Fmt" compiler csg: call ownership index projection identity invalid node={currentNodeIndex}"
                return false
        let hopId = table.hopIds.len
        let hopOrdinal = hopId - hopStart
        let hopCid = compilerCsgCallOwnershipProjectionHopCid(
            effectRow,
            hopId,
            hopOrdinal,
            currentNodeIndex,
            Int32(opKind),
            exactTypeId,
            hopOwnerProducerSourceIndex,
            hopOwnerDeclarationSourceLocalRow,
            operand0NodeIndex,
            fieldProducerSourceIndex,
            fieldOwnerDeclarationSourceLocalRow,
            fieldDeclarationSourceLocalRow,
            fieldOrdinal,
            fieldBuiltinKind,
            indexNodeIndex)
        if layout.FixedBytes32Equal(
               hopCid, layout.FixedBytes32()):
            err = Fmt" compiler csg: call ownership projection hop CID missing node={currentNodeIndex}"
            return false
        add(table.hopIds, hopId)
        add(table.hopEffectRows, effectRow)
        add(table.hopOrdinals, hopOrdinal)
        add(table.hopNodeIndexes, currentNodeIndex)
        add(table.hopOpKinds, Int32(opKind))
        add(table.hopExactTypeIds, exactTypeId)
        add(table.hopOwnerProducerSourceIndexes,
            hopOwnerProducerSourceIndex)
        add(table.hopOwnerDeclarationSourceLocalRows,
            hopOwnerDeclarationSourceLocalRow)
        add(table.hopOperand0NodeIndexes, operand0NodeIndex)
        add(table.hopFieldProducerSourceIndexes,
            fieldProducerSourceIndex)
        add(table.hopFieldOwnerDeclarationSourceLocalRows,
            fieldOwnerDeclarationSourceLocalRow)
        add(table.hopFieldDeclarationSourceLocalRows,
            fieldDeclarationSourceLocalRow)
        add(table.hopFieldOrdinals, fieldOrdinal)
        add(table.hopFieldBuiltinKinds, fieldBuiltinKind)
        add(table.hopIndexNodeIndexes, indexNodeIndex)
        add(table.hopCids, hopCid)
        currentNodeIndex = operand0NodeIndex
    if currentNodeIndex < functionNodeStart ||
       currentNodeIndex >= functionNodeStart + functionNodeCount:
        err = " compiler csg: call ownership projection root node invalid"
        return false
    let bindingDefinitionRow =
        texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
            typedIr, currentNodeIndex)
    let producedDefinitionRow =
        texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
            typedIr, currentNodeIndex)
    if bindingDefinitionRow >= 0 && producedDefinitionRow >= 0:
        err = Fmt" compiler csg: call ownership projection root definition split node={currentNodeIndex}"
        return false
    rootValueDefinitionRow = bindingDefinitionRow
    if rootValueDefinitionRow < 0:
        rootValueDefinitionRow = producedDefinitionRow
    if rootValueDefinitionRow < 0:
        err = Fmt" compiler csg: managed call argument lacks exact root value-definition node={currentNodeIndex}"
        return false
    let hopCount = table.hopIds.len - hopStart
    projectionCid = compilerCsgCallOwnershipProjectionCid(
        effectRow,
        valueNodeIndex,
        currentNodeIndex,
        rootValueDefinitionRow,
        hopStart,
        hopCount,
        table)
    if layout.FixedBytes32Equal(
           projectionCid, layout.FixedBytes32()):
        err = " compiler csg: call ownership projection CID missing"
        return false
    add(table.effectStarts, hopStart)
    add(table.effectCounts, hopCount)
    let projectionCidValue = projectionCid
    add(table.effectProjectionCids, projectionCidValue)
    err = ""
    return true

@borrows
fn CompilerCsgBuildManualConsumeCallTokensInto(
        resolved: var CompilerCsgSemanticResolvedCallTable,
        typedIr: var texpr.TypedExprIr,
        targetTypedFunctionIndexes: int32[],
        out: var CompilerCsgManualConsumeCallTokenTable,
        err: var str): bool =
    CompilerCsgManualConsumeCallTokenTableRelease(out)
    if !resolved.graphNodeProjectionComplete ||
       !typedIr.nodeAuthorityTypeArenaBound ||
       targetTypedFunctionIndexes.len != resolved.sourceIndexes.len:
        err = " compiler csg: manual-consume call authority is not sealed"
        return false
    for callRow in 0..<resolved.sourceIndexes.len:
        let callExprNodeIndex = resolved.typedCallNodeIndexes[callRow]
        var targetOrdinal: int32
        var sourceOrdinal: int32
        var targetParameterDeclarationRow: int32
        var sourceParameterDeclarationRow: int32
        var targetTypeId: int32
        var sourceTypeId: int32
        var typedEffectCid: layout.FixedBytes32
        let present = texpr.TypedExprIrCallManualConsumeEffectInto(
            typedIr,
            callExprNodeIndex,
            targetOrdinal,
            sourceOrdinal,
            targetParameterDeclarationRow,
            sourceParameterDeclarationRow,
            targetTypeId,
            sourceTypeId,
            typedEffectCid)
        if !present:
            continue
        let annotationFlags =
            resolved.targetFunctionAnnotationFlags[callRow]
        if resolved.callTargetImportcFlags[callRow] ||
           resolved.targetFunctionIndexes[callRow] < 0 ||
           (annotationFlags &
                parser.ParserFunctionAnnotationManualConsume) == 0 ||
           (annotationFlags &
                parser.ParserFunctionAnnotationTrustedAbi) != 0 ||
           arenamod.ArenaArrayInt32Get(
               typedIr.arena,
               typedIr.nodes2_syntheticOriginKinds,
               callExprNodeIndex) !=
               texpr.TypedExprSyntheticOriginNone:
            err = Fmt" compiler csg: manual-consume call is not a real language CallExpr row={callRow}"
            CompilerCsgManualConsumeCallTokenTableRelease(out)
            return false
        let argumentStart = resolved.callArgumentStarts[callRow]
        let argumentCount = resolved.callArgCounts[callRow]
        if targetOrdinal < 0 || sourceOrdinal < 0 ||
           targetOrdinal == sourceOrdinal ||
           targetOrdinal >= argumentCount ||
           sourceOrdinal >= argumentCount ||
           argumentStart < 0 ||
           argumentStart > resolved.callArgumentBindingIds.len -
               argumentCount:
            err = Fmt" compiler csg: manual-consume argument range invalid row={callRow}"
            CompilerCsgManualConsumeCallTokenTableRelease(out)
            return false
        let targetArgumentRow = argumentStart + targetOrdinal
        let sourceArgumentRow = argumentStart + sourceOrdinal
        if resolved.callArgumentCallRows[targetArgumentRow] != callRow ||
           resolved.callArgumentCallRows[sourceArgumentRow] != callRow ||
           resolved.callArgumentOrdinals[targetArgumentRow] !=
               targetOrdinal ||
           resolved.callArgumentOrdinals[sourceArgumentRow] !=
               sourceOrdinal ||
           resolved.callArgumentTargetParameterDeclarationRows[
               targetArgumentRow] != targetParameterDeclarationRow ||
           resolved.callArgumentTargetParameterDeclarationRows[
               sourceArgumentRow] != sourceParameterDeclarationRow ||
           !resolved.callArgumentTargetParameterMutableFlags[
               targetArgumentRow] ||
           resolved.callArgumentTargetParameterMutableFlags[
               sourceArgumentRow]:
            err = Fmt" compiler csg: manual-consume ArgLink/parameter authority drift row={callRow}"
            CompilerCsgManualConsumeCallTokenTableRelease(out)
            return false
        let callerTypedFunctionIndex =
            resolved.functionIndexes[callRow]
        let calleeTypedFunctionIndex =
            targetTypedFunctionIndexes[callRow]
        let targetValueNodeIndex =
            resolved.callArgumentValueNodeIndexes[targetArgumentRow]
        let sourceValueNodeIndex =
            resolved.callArgumentValueNodeIndexes[sourceArgumentRow]
        if texpr.TypedExprIrNodeExprClassAt(
               typedIr, targetValueNodeIndex) !=
               texpr.TypedExprExprBorrowed ||
           texpr.TypedExprIrNodeExprClassAt(
               typedIr, sourceValueNodeIndex) !=
               texpr.TypedExprExprOwned ||
           calleeTypedFunctionIndex < 0:
            err = Fmt" compiler csg: manual-consume target/source ownership class invalid row={callRow}"
            CompilerCsgManualConsumeCallTokenTableRelease(out)
            return false
        let tokenId = out.tokenIds.len
        var targetRootValueDefinitionRow: int32
        var sourceValueDefinitionRow: int32
        var targetProjectionCid: layout.FixedBytes32
        var sourceProjectionCid: layout.FixedBytes32
        if !compilerCsgCallOwnershipProjectionAppendInto(
               typedIr,
               callerTypedFunctionIndex,
               resolved.sourceIndexes[callRow],
               0,
               tokenId * 2,
               targetValueNodeIndex,
               out.projection,
               targetRootValueDefinitionRow,
               targetProjectionCid,
               err) ||
           !compilerCsgCallOwnershipProjectionAppendInto(
               typedIr,
               callerTypedFunctionIndex,
               resolved.sourceIndexes[callRow],
               0,
               tokenId * 2 + 1,
               sourceValueNodeIndex,
               out.projection,
               sourceValueDefinitionRow,
               sourceProjectionCid,
               err):
            CompilerCsgManualConsumeCallTokenTableRelease(out)
            return false
        if texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
               typedIr, targetRootValueDefinitionRow) !=
               callerTypedFunctionIndex ||
           texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
               typedIr, sourceValueDefinitionRow) !=
               callerTypedFunctionIndex ||
           texpr.TypedExprValueDefinitionOwnershipAt(
               typedIr, targetRootValueDefinitionRow) !=
               texpr.TypedExprExprOwned ||
           texpr.TypedExprValueDefinitionOwnershipAt(
               typedIr, sourceValueDefinitionRow) !=
               texpr.TypedExprExprOwned:
            err = Fmt" compiler csg: manual-consume root value-definition authority invalid row={callRow}"
            CompilerCsgManualConsumeCallTokenTableRelease(out)
            return false
        let tokenCid = CompilerCsgManualConsumeCallTokenCid(
            tokenId,
            callRow,
            callerTypedFunctionIndex,
            callExprNodeIndex,
            calleeTypedFunctionIndex,
            targetArgumentRow,
            sourceArgumentRow,
            targetOrdinal,
            sourceOrdinal,
            resolved.callArgumentArgLinkNodeIndexes[targetArgumentRow],
            resolved.callArgumentArgLinkNodeIndexes[sourceArgumentRow],
            targetValueNodeIndex,
            sourceValueNodeIndex,
            targetParameterDeclarationRow,
            sourceParameterDeclarationRow,
            targetTypeId,
            sourceTypeId,
            resolved.callArgumentBindingCids[targetArgumentRow],
            resolved.callArgumentBindingCids[sourceArgumentRow],
            targetRootValueDefinitionRow,
            sourceValueDefinitionRow,
            targetProjectionCid,
            sourceProjectionCid,
            typedEffectCid)
        add(out.tokenIds, tokenId)
        add(out.callRows, callRow)
        add(out.callerTypedFunctionIndexes, callerTypedFunctionIndex)
        add(out.callExprNodeIndexes, callExprNodeIndex)
        add(out.calleeFunctionIndexes,
            calleeTypedFunctionIndex)
        add(out.targetArgumentRows, targetArgumentRow)
        add(out.sourceArgumentRows, sourceArgumentRow)
        add(out.targetArgumentOrdinals, targetOrdinal)
        add(out.sourceArgumentOrdinals, sourceOrdinal)
        add(out.targetArgLinkNodeIndexes,
            resolved.callArgumentArgLinkNodeIndexes[targetArgumentRow])
        add(out.sourceArgLinkNodeIndexes,
            resolved.callArgumentArgLinkNodeIndexes[sourceArgumentRow])
        add(out.targetValueNodeIndexes, targetValueNodeIndex)
        add(out.sourceValueNodeIndexes, sourceValueNodeIndex)
        add(out.targetParameterDeclarationRows,
            targetParameterDeclarationRow)
        add(out.sourceParameterDeclarationRows,
            sourceParameterDeclarationRow)
        add(out.targetTypeIds, targetTypeId)
        add(out.sourceTypeIds, sourceTypeId)
        add(out.targetBindingCids,
            layout.FixedBytes32Copy(
                resolved.callArgumentBindingCids[targetArgumentRow]))
        add(out.sourceBindingCids,
            layout.FixedBytes32Copy(
                resolved.callArgumentBindingCids[sourceArgumentRow]))
        add(out.targetPlaceRootValueDefinitionRows,
            targetRootValueDefinitionRow)
        add(out.sourceValueDefinitionRows, sourceValueDefinitionRow)
        add(out.targetProjectionCids, targetProjectionCid)
        add(out.sourceProjectionCids, sourceProjectionCid)
        add(out.typedEffectCids, typedEffectCid)
        add(out.tokenCids, tokenCid)
    var manualCallExprCount: int32
    for nodeIndex in 0..<typedIr.nodes2_nodeIndexs.len:
        if typedIr.nodes2_opKinds[nodeIndex] !=
               texpr.TypedExprIrOpCallExpr:
            continue
        var targetOrdinal: int32
        var sourceOrdinal: int32
        var targetDeclarationRow: int32
        var sourceDeclarationRow: int32
        var targetTypeId: int32
        var sourceTypeId: int32
        var effectCid: layout.FixedBytes32
        if !texpr.TypedExprIrCallManualConsumeEffectInto(
               typedIr,
               nodeIndex,
               targetOrdinal,
               sourceOrdinal,
               targetDeclarationRow,
               sourceDeclarationRow,
               targetTypeId,
               sourceTypeId,
               effectCid):
            continue
        var tokenMatchCount: int32
        for tokenRow in 0..<out.callExprNodeIndexes.len:
            if out.callExprNodeIndexes[tokenRow] == nodeIndex:
                tokenMatchCount = tokenMatchCount + 1
        if tokenMatchCount != 1:
            err = Fmt" compiler csg: manual-consume CallExpr token cardinality invalid node={nodeIndex} matches={tokenMatchCount}"
            CompilerCsgManualConsumeCallTokenTableRelease(out)
            return false
        manualCallExprCount = manualCallExprCount + 1
    if manualCallExprCount != out.tokenIds.len:
        err = Fmt" compiler csg: manual-consume CallExpr token coverage invalid calls={manualCallExprCount} tokens={out.tokenIds.len}"
        CompilerCsgManualConsumeCallTokenTableRelease(out)
        return false
    out.complete = true
    if !CompilerCsgManualConsumeCallTokenTableStrictValidateInto(
           out, err):
        CompilerCsgManualConsumeCallTokenTableRelease(out)
        return false
    err = ""
    return true

@borrows
fn compilerCsgFixedBytes32SequenceEqual(
        left: layout.FixedBytes32[],
        right: layout.FixedBytes32[]): bool =
    if left.len != right.len:
        return false
    for row in 0..<left.len:
        if !layout.FixedBytes32Equal(left[row], right[row]):
            return false
    return true

@borrows
fn compilerCsgCallOwnershipProjectionTableEqual(
        left: CompilerCsgCallOwnershipProjectionTable,
        right: CompilerCsgCallOwnershipProjectionTable): bool =
    return compilerCsgInt32SequenceEqual(
               left.effectStarts, right.effectStarts) &&
           compilerCsgInt32SequenceEqual(
               left.effectCounts, right.effectCounts) &&
           compilerCsgFixedBytes32SequenceEqual(
               left.effectProjectionCids,
               right.effectProjectionCids) &&
           compilerCsgInt32SequenceEqual(
               left.hopIds, right.hopIds) &&
           compilerCsgInt32SequenceEqual(
               left.hopEffectRows, right.hopEffectRows) &&
           compilerCsgInt32SequenceEqual(
               left.hopOrdinals, right.hopOrdinals) &&
           compilerCsgInt32SequenceEqual(
               left.hopNodeIndexes, right.hopNodeIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.hopOpKinds, right.hopOpKinds) &&
           compilerCsgInt32SequenceEqual(
               left.hopExactTypeIds, right.hopExactTypeIds) &&
           compilerCsgInt32SequenceEqual(
               left.hopOwnerProducerSourceIndexes,
               right.hopOwnerProducerSourceIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.hopOwnerDeclarationSourceLocalRows,
               right.hopOwnerDeclarationSourceLocalRows) &&
           compilerCsgInt32SequenceEqual(
               left.hopOperand0NodeIndexes,
               right.hopOperand0NodeIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.hopFieldProducerSourceIndexes,
               right.hopFieldProducerSourceIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.hopFieldOwnerDeclarationSourceLocalRows,
               right.hopFieldOwnerDeclarationSourceLocalRows) &&
           compilerCsgInt32SequenceEqual(
               left.hopFieldDeclarationSourceLocalRows,
               right.hopFieldDeclarationSourceLocalRows) &&
           compilerCsgInt32SequenceEqual(
               left.hopFieldOrdinals, right.hopFieldOrdinals) &&
           compilerCsgInt32SequenceEqual(
               left.hopFieldBuiltinKinds,
               right.hopFieldBuiltinKinds) &&
           compilerCsgInt32SequenceEqual(
               left.hopIndexNodeIndexes,
               right.hopIndexNodeIndexes) &&
           compilerCsgFixedBytes32SequenceEqual(
               left.hopCids, right.hopCids)

@borrows
fn compilerCsgManualConsumeCallTokenTableEqual(
        left: CompilerCsgManualConsumeCallTokenTable,
        right: CompilerCsgManualConsumeCallTokenTable): bool =
    return left.complete == right.complete &&
           compilerCsgInt32SequenceEqual(
               left.tokenIds, right.tokenIds) &&
           compilerCsgInt32SequenceEqual(
               left.callRows, right.callRows) &&
           compilerCsgInt32SequenceEqual(
               left.callerTypedFunctionIndexes,
               right.callerTypedFunctionIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.callExprNodeIndexes,
               right.callExprNodeIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.calleeFunctionIndexes,
               right.calleeFunctionIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.targetArgumentRows,
               right.targetArgumentRows) &&
           compilerCsgInt32SequenceEqual(
               left.sourceArgumentRows,
               right.sourceArgumentRows) &&
           compilerCsgInt32SequenceEqual(
               left.targetArgumentOrdinals,
               right.targetArgumentOrdinals) &&
           compilerCsgInt32SequenceEqual(
               left.sourceArgumentOrdinals,
               right.sourceArgumentOrdinals) &&
           compilerCsgInt32SequenceEqual(
               left.targetArgLinkNodeIndexes,
               right.targetArgLinkNodeIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.sourceArgLinkNodeIndexes,
               right.sourceArgLinkNodeIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.targetValueNodeIndexes,
               right.targetValueNodeIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.sourceValueNodeIndexes,
               right.sourceValueNodeIndexes) &&
           compilerCsgInt32SequenceEqual(
               left.targetParameterDeclarationRows,
               right.targetParameterDeclarationRows) &&
           compilerCsgInt32SequenceEqual(
               left.sourceParameterDeclarationRows,
               right.sourceParameterDeclarationRows) &&
           compilerCsgInt32SequenceEqual(
               left.targetTypeIds, right.targetTypeIds) &&
           compilerCsgInt32SequenceEqual(
               left.sourceTypeIds, right.sourceTypeIds) &&
           compilerCsgFixedBytes32SequenceEqual(
               left.targetBindingCids,
               right.targetBindingCids) &&
           compilerCsgFixedBytes32SequenceEqual(
               left.sourceBindingCids,
               right.sourceBindingCids) &&
           compilerCsgInt32SequenceEqual(
               left.targetPlaceRootValueDefinitionRows,
               right.targetPlaceRootValueDefinitionRows) &&
           compilerCsgInt32SequenceEqual(
               left.sourceValueDefinitionRows,
               right.sourceValueDefinitionRows) &&
           compilerCsgFixedBytes32SequenceEqual(
               left.targetProjectionCids,
               right.targetProjectionCids) &&
           compilerCsgFixedBytes32SequenceEqual(
               left.sourceProjectionCids,
               right.sourceProjectionCids) &&
           compilerCsgFixedBytes32SequenceEqual(
               left.typedEffectCids,
               right.typedEffectCids) &&
           compilerCsgFixedBytes32SequenceEqual(
               left.tokenCids, right.tokenCids) &&
           compilerCsgCallOwnershipProjectionTableEqual(
               left.projection, right.projection)

# Rebuilds the unique canonical token/projection table from the pinned
# resolved-call rows and the moved TypedIR, then requires byte-equivalent SoA
# columns.  A self-consistent replacement table with recomputed CIDs therefore
# cannot become a Lowering authority.
@borrows
fn CompilerCsgManualConsumeCallTokenTableExactValidateAgainstInto(
        resolved: var CompilerCsgSemanticResolvedCallTable,
        typedIr: var texpr.TypedExprIr,
        targetTypedFunctionIndexes: int32[],
        table: CompilerCsgManualConsumeCallTokenTable,
        err: var str): bool =
    if !CompilerCsgManualConsumeCallTokenTableStrictValidateInto(
           table, err):
        return false
    var expected: CompilerCsgManualConsumeCallTokenTable
    if !CompilerCsgBuildManualConsumeCallTokensInto(
           resolved,
           typedIr,
           targetTypedFunctionIndexes,
           expected,
           err):
        CompilerCsgManualConsumeCallTokenTableRelease(expected)
        return false
    if !compilerCsgManualConsumeCallTokenTableEqual(
           table, expected):
        CompilerCsgManualConsumeCallTokenTableRelease(expected)
        err =
            " compiler csg: manual-consume call token exact authority drift"
        return false
    CompilerCsgManualConsumeCallTokenTableRelease(expected)
    err = ""
    return true

fn CompilerCsgCallOwnershipEffectCid(
        callRow: int32,
        sourceIndex: int32,
        originParserNodeId: int32,
        callerTypedFunctionIndex: int32,
        typedCallNodeIndex: int32,
        targetFunctionIndex: int32,
        targetGraphNodeId: int32,
        targetAnnotationFlags: int32,
        targetContractCid: layout.FixedBytes32,
        effectId: int32,
        callArgumentRow: int32,
        callArgumentBindingCid: layout.FixedBytes32,
        ownershipProjectionCid: layout.FixedBytes32,
        argumentOrdinal: int32,
        argLinkNodeIndex: int32,
        valueNodeIndex: int32,
        valueNodeOwnership: int32,
        valueDefinitionRow: int32,
        valueDefinitionOwnership: int32,
        valueDefinitionOriginKind: int32,
        valueDefinitionTypedFunctionIndex: int32,
        valueDefinitionTypeId: int32,
        valueDefinitionDefiningNodeIndex: int32,
        valueDefinitionProducerSourceIndex: int32,
        valueDefinitionSourceLocalNodeIndex: int32,
        valueDefinitionDeclarationSourceLocalRow: int32,
        effectKind: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    CompilerCsgAppendText(
        buf, "cheng.compiler.csg.call_ownership_effect")
    CompilerCsgAppendU32BE(buf, callRow)
    CompilerCsgAppendU32BE(buf, sourceIndex)
    CompilerCsgAppendU32BE(buf, originParserNodeId)
    CompilerCsgAppendU32BE(buf, callerTypedFunctionIndex)
    CompilerCsgAppendU32BE(buf, typedCallNodeIndex)
    CompilerCsgAppendU32BE(buf, targetFunctionIndex)
    CompilerCsgAppendU32BE(buf, targetGraphNodeId)
    CompilerCsgAppendU32BE(buf, targetAnnotationFlags)
    CompilerCsgAppendFixed32(buf, targetContractCid)
    CompilerCsgAppendU32BE(buf, effectId)
    CompilerCsgAppendU32BE(buf, callArgumentRow)
    CompilerCsgAppendFixed32(buf, callArgumentBindingCid)
    CompilerCsgAppendFixed32(buf, ownershipProjectionCid)
    CompilerCsgAppendU32BE(buf, argumentOrdinal)
    CompilerCsgAppendU32BE(buf, argLinkNodeIndex)
    CompilerCsgAppendU32BE(buf, valueNodeIndex)
    CompilerCsgAppendU32BE(buf, valueNodeOwnership)
    CompilerCsgAppendU32BE(buf, valueDefinitionRow)
    CompilerCsgAppendU32BE(buf, valueDefinitionOwnership)
    CompilerCsgAppendU32BE(buf, valueDefinitionOriginKind)
    CompilerCsgAppendU32BE(
        buf, valueDefinitionTypedFunctionIndex)
    CompilerCsgAppendU32BE(buf, valueDefinitionTypeId)
    CompilerCsgAppendU32BE(buf, valueDefinitionDefiningNodeIndex)
    CompilerCsgAppendU32BE(
        buf, valueDefinitionProducerSourceIndex)
    CompilerCsgAppendU32BE(
        buf, valueDefinitionSourceLocalNodeIndex)
    CompilerCsgAppendU32BE(
        buf, valueDefinitionDeclarationSourceLocalRow)
    CompilerCsgAppendU32BE(buf, effectKind)
    return CompilerCsgBufCid(buf)

@borrows
fn CompilerCsgSemanticFinalizeResolvedCallFunctionAdjacency(table: var CompilerCsgSemanticResolvedCallTable,
                                                       reachableSet: var CompilerCsgReachableFunctionSet,
                                                       reachableGraphNodeIds: int32[],
                                                       typedIr: var texpr.TypedExprIr,
                                                       exprSlices: var CompilerCsgSemanticExprSliceTable,
                                                       receipt: var parser_receipt.ParserNormalizedExprReceiptAccumulator,
                                                       err: var str): bool =
    if !CompilerCsgSemanticResolvedCallTableValidate(table,
                                               reachableSet.functionNames.len,
                                               err):
        return false
    if !CompilerCsgValidateTypedIrReachabilityFunctionColumns(typedIr, err):
        return false
    if reachableGraphNodeIds.len != reachableSet.functionNames.len:
        err = " compiler csg: resolved-call graph-node domain mismatch"
        return false
    let typedFunctionCount = typedIr.functions2_functionNameIds.len
    if exprSlices.functionSliceIndexes.len != reachableSet.functionNames.len ||
       exprSlices.functionIndex.len != exprSlices.typedIrFunctionIndexes.len:
        err = " compiler csg: resolved-call exact function projection columns mismatch"
        return false
    var reachableToTyped: int32[]
    for functionIndex in 0..<reachableSet.functionNames.len:
        add(reachableToTyped, -1)
    for reachableFunctionIndex in 0..<reachableSet.functionNames.len:
        let sliceIndex = exprSlices.functionSliceIndexes[
            reachableFunctionIndex]
        if sliceIndex < 0:
            if reachableSet.active &&
               reachableFunctionIndex < reachableSet.reachable.len &&
               reachableSet.reachable[reachableFunctionIndex]:
                err = Fmt" compiler csg: reachable function has no exact TypedIR slice function_index={reachableFunctionIndex}"
                return false
            continue
        if sliceIndex >= exprSlices.functionIndex.len ||
           sliceIndex >= exprSlices.typedIrFunctionIndexes.len ||
           exprSlices.functionIndex[sliceIndex] != reachableFunctionIndex:
            err = Fmt" compiler csg: resolved-call exact function slice identity corrupt function_index={reachableFunctionIndex} slice_index={sliceIndex}"
            return false
        let typedFunctionIndex =
            exprSlices.typedIrFunctionIndexes[sliceIndex]
        if typedFunctionIndex < 0 ||
           typedFunctionIndex >= typedFunctionCount ||
           reachableToTyped[reachableFunctionIndex] >= 0:
            err = Fmt" compiler csg: resolved-call exact TypedIR projection invalid function_index={reachableFunctionIndex} typed_index={typedFunctionIndex}"
            return false
        reachableToTyped[reachableFunctionIndex] = typedFunctionIndex
        let sourcePathRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                                 typedIr.functions2_sourcePathIds[typedFunctionIndex])
        let functionNameRes: Result[str] = langintern.LookupIntern(typedIr.internPool,
                                                                   typedIr.functions2_functionNameIds[typedFunctionIndex])
        if !IsOk(sourcePathRes) || !IsOk(functionNameRes):
            err = Fmt" compiler csg: resolved-call typed owner intern missing function_index={typedFunctionIndex}"
            return false
        let sourcePath = Value(sourcePathRes)
        let functionName = Value(functionNameRes)
        let signatureLine = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                        typedIr.functions2_signatureLineNumbers,
                                                        typedFunctionIndex)
        if !CompilerCsgSourcePathsEquivalent(
               reachableSet.sourcePaths[reachableFunctionIndex],
               sourcePath) ||
           reachableSet.functionNames[reachableFunctionIndex] !=
               functionName ||
           reachableSet.startLines[reachableFunctionIndex] != signatureLine:
            err = Fmt" compiler csg: resolved-call exact typed owner payload drift function={functionName} source={sourcePath}:{signatureLine} typed_index={typedFunctionIndex} reachable_index={reachableFunctionIndex}"
            return false
    var finalHeads: int32[]
    for typedFunctionIndex in 0..<typedFunctionCount:
        add(finalHeads, -1)
    var finalNext: int32[]
    for rowIndex in 0..<table.functionIndexes.len:
        add(finalNext, -1)
    var finalFunctionIndexes: int32[]
    var finalTargetProducerSourceIndexes: int32[]
    var finalTargetProducerDeclarationOrdinals: int32[]
    var finalTargetParserSourceLocalDeclarationRows: int32[]
    var finalCallerGraphNodeIds: int32[]
    var finalTargetGraphNodeIds: int32[]
    var finalTypedCallNodeIndexes: int32[]
    var finalTargetFunctionIndexes: int32[]
    var finalTargetFunctionAnnotationFlags: int32[]
    var finalTargetFunctionContractCids: layout.FixedBytes32[]
    var finalCallArgumentStarts: int32[]
    var finalCallArgumentBindingIds: int32[]
    var finalCallArgumentCallRows: int32[]
    var finalCallArgumentOrdinals: int32[]
    var finalCallArgumentArgLinkNodeIndexes: int32[]
    var finalCallArgumentValueNodeIndexes: int32[]
    var finalCallArgumentTargetParameterDeclarationRows: int32[]
    var finalCallArgumentTargetParameterMutableFlags: bool[]
    var finalCallArgumentBindingCids: layout.FixedBytes32[]
    var finalOwnershipEffectStarts: int32[]
    var finalOwnershipEffectCounts: int32[]
    var finalOwnershipEffectIds: int32[]
    var finalOwnershipEffectCallRows: int32[]
    var finalOwnershipEffectCallArgumentRows: int32[]
    var finalOwnershipEffectArgumentOrdinals: int32[]
    var finalOwnershipEffectArgLinkNodeIndexes: int32[]
    var finalOwnershipEffectValueNodeIndexes: int32[]
    var finalOwnershipEffectValueNodeOwnerships: int32[]
    var finalOwnershipEffectValueDefinitionRows: int32[]
    var finalOwnershipEffectValueDefinitionOwnerships: int32[]
    var finalOwnershipEffectValueDefinitionOriginKinds: int32[]
    var finalOwnershipEffectValueDefinitionTypedFunctionIndexes: int32[]
    var finalOwnershipEffectValueDefinitionExactTypeIds: int32[]
    var finalOwnershipEffectValueDefinitionDefiningNodeIndexes: int32[]
    var finalOwnershipEffectValueDefinitionProducerSourceIndexes: int32[]
    var finalOwnershipEffectValueDefinitionSourceLocalNodeIndexes: int32[]
    var finalOwnershipEffectValueDefinitionDeclarationSourceLocalRows: int32[]
    var finalOwnershipEffectKinds: int32[]
    var finalOwnershipEffectCids: layout.FixedBytes32[]
    var finalOwnershipProjection: CompilerCsgCallOwnershipProjectionTable
    for rowIndex in 0..<table.functionIndexes.len:
        let reachableFunctionIndex = table.functionIndexes[rowIndex]
        if reachableFunctionIndex < 0 || reachableFunctionIndex >= reachableToTyped.len:
            err = Fmt" compiler csg: resolved-call row owner invalid row={rowIndex} reachable_index={reachableFunctionIndex} reachable_count={reachableToTyped.len}"
            return false
        let typedFunctionIndex = reachableToTyped[reachableFunctionIndex]
        if typedFunctionIndex < 0 || typedFunctionIndex >= typedFunctionCount:
            err = Fmt" compiler csg: resolved-call row owner absent from final TypedIR row={rowIndex} reachable_index={reachableFunctionIndex} typed_index={typedFunctionIndex}"
            return false
        let callerGraphNodeId =
            reachableGraphNodeIds[reachableFunctionIndex]
        if callerGraphNodeId <= 0:
            err = Fmt" compiler csg: resolved-call caller graph node missing row={rowIndex} reachable_index={reachableFunctionIndex}"
            return false
        if reachableFunctionIndex >=
               reachableSet.producerSourceIndexes.len ||
           reachableFunctionIndex >=
               reachableSet.producerDeclarationIndexes.len:
            err = Fmt" compiler csg: resolved-call caller parser owner missing row={rowIndex}"
            return false
        let callerProducerSourceIndex =
            reachableSet.producerSourceIndexes[
                reachableFunctionIndex]
        let callerProducerDeclarationOrdinal =
            reachableSet.producerDeclarationIndexes[
                reachableFunctionIndex]
        if callerProducerSourceIndex < 0 ||
           callerProducerSourceIndex >= receipt.sourceSidecars.len:
            err = Fmt" compiler csg: resolved-call caller producer source invalid row={rowIndex}"
            return false
        var callerParserDeclarationRow: int32
        var callerParserDeclarationMatchCount: int32
        for declarationRow in 0..<
                receipt.sourceSidecars[
                    callerProducerSourceIndex].declarationKinds.len:
            if receipt.sourceSidecars[
                   callerProducerSourceIndex].declarationKinds[
                       declarationRow] ==
                   Int32(parser.ParserDeclarationFunction) &&
               receipt.sourceSidecars[
                   callerProducerSourceIndex].declarationFunctionRows[
                       declarationRow] ==
                   callerProducerDeclarationOrdinal:
                callerParserDeclarationRow = declarationRow
                callerParserDeclarationMatchCount =
                    callerParserDeclarationMatchCount + 1
        var callerExecutableMatchCount: int32
        for functionRow in 0..<
                receipt.sourceSidecars[
                    callerProducerSourceIndex].functionDeclarationOrdinals.len:
            if receipt.sourceSidecars[
                   callerProducerSourceIndex].functionDeclarationOrdinals[
                       functionRow] ==
                   callerProducerDeclarationOrdinal &&
               receipt.sourceSidecars[
                   callerProducerSourceIndex].functionIndexes[
                       functionRow] == reachableFunctionIndex:
                callerExecutableMatchCount =
                    callerExecutableMatchCount + 1
        if callerParserDeclarationMatchCount != 1 ||
           callerExecutableMatchCount != 1:
            err = Fmt" compiler csg: resolved-call caller executable Function row drift row={rowIndex} declaration_matches={callerParserDeclarationMatchCount} executable_matches={callerExecutableMatchCount}"
            return false
        var targetGraphNodeId: int32 = -1
        let originParserNodeId = table.originParserNodeIds[rowIndex]
        let nodeStart = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.functions2_nodeStarts,
            typedFunctionIndex)
        let nodeCount = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.functions2_nodeCounts,
            typedFunctionIndex)
        if originParserNodeId < 0 || nodeStart < 0 || nodeCount < 0 ||
           nodeStart > typedIr.nodes2_nodeIndexs.len - nodeCount:
            err = Fmt" compiler csg: resolved-call exact TypedIR node domain invalid row={rowIndex} parser_node={originParserNodeId} start={nodeStart} count={nodeCount}"
            return false
        var resolvedNodeIndex: int32 = -1
        for nodeIndex in nodeStart..<nodeStart + nodeCount:
            if typedIr.nodes2_opKinds[nodeIndex] !=
                   texpr.TypedExprIrOpCallExpr ||
               arenamod.ArenaArrayInt32Get(
                   typedIr.arena,
                   typedIr.nodes2_originParserNodeIds,
                   nodeIndex) != originParserNodeId:
                continue
            if resolvedNodeIndex >= 0:
                err = Fmt" compiler csg: resolved-call parser origin maps to multiple TypedIR calls row={rowIndex} parser_node={originParserNodeId} first={resolvedNodeIndex} second={nodeIndex}"
                return false
            resolvedNodeIndex = nodeIndex
        if resolvedNodeIndex < 0:
            var typedCallCount: int32
            var firstTypedCallOrigin: int32 = -1
            var secondTypedCallOrigin: int32 = -1
            var firstTypedCallTarget: str
            var secondTypedCallTarget: str
            for nodeIndex in nodeStart..<nodeStart + nodeCount:
                if typedIr.nodes2_opKinds[nodeIndex] !=
                       texpr.TypedExprIrOpCallExpr:
                    continue
                typedCallCount = typedCallCount + 1
                if firstTypedCallOrigin < 0:
                    firstTypedCallOrigin = arenamod.ArenaArrayInt32Get(
                        typedIr.arena,
                        typedIr.nodes2_originParserNodeIds,
                        nodeIndex)
                    let targetResult = langintern.LookupIntern(
                        typedIr.internPool,
                        typedIr.nodes2_callTargetIds[nodeIndex])
                    if IsOk(targetResult):
                        firstTypedCallTarget = Value(targetResult)
                elif secondTypedCallOrigin < 0:
                    secondTypedCallOrigin = arenamod.ArenaArrayInt32Get(
                        typedIr.arena,
                        typedIr.nodes2_originParserNodeIds,
                        nodeIndex)
                    let targetResult = langintern.LookupIntern(
                        typedIr.internPool,
                        typedIr.nodes2_callTargetIds[nodeIndex])
                    if IsOk(targetResult):
                        secondTypedCallTarget = Value(targetResult)
            var factCallee: str
            var factTarget: str
            let factCalleeResult = langintern.LookupIntern(
                table.internPool,
                table.callCalleeIds[rowIndex])
            if IsOk(factCalleeResult):
                factCallee = Value(factCalleeResult)
            let factTargetResult = langintern.LookupIntern(
                table.internPool,
                table.callTargetIds[rowIndex])
            if IsOk(factTargetResult):
                factTarget = Value(factTargetResult)
            err = Fmt" compiler csg: resolved-call parser origin has no exact TypedIR call row={rowIndex} parser_node={originParserNodeId} source_index={table.sourceIndexes[rowIndex]} line={table.lineNumbers[rowIndex]} column={table.columnNumbers[rowIndex]} reachable_function={reachableFunctionIndex} reachable_name={reachableSet.functionNames[reachableFunctionIndex]} fact_callee={factCallee} fact_target={factTarget} typed_function={typedFunctionIndex} node_start={nodeStart} node_count={nodeCount} typed_call_count={typedCallCount} first_typed_call_origin={firstTypedCallOrigin} first_typed_call_target={firstTypedCallTarget} second_typed_call_origin={secondTypedCallOrigin} second_typed_call_target={secondTypedCallTarget}"
            return false
        let targetSourceResult = langintern.LookupIntern(
            table.internPool,
            table.callTargetSourcePathIds[rowIndex])
        let targetNameResult = langintern.LookupIntern(
            table.internPool,
            table.callTargetIds[rowIndex])
        let nodeTargetSourceResult = langintern.LookupInternOwnedCopy(
            typedIr.internPool,
            typedIr.nodes2_callTargetSourcePathIds[resolvedNodeIndex])
        let nodeTargetNameResult = langintern.LookupInternOwnedCopy(
            typedIr.internPool,
            typedIr.nodes2_callTargetIds[resolvedNodeIndex])
        if !IsOk(targetSourceResult) || !IsOk(targetNameResult) ||
           !IsOk(nodeTargetSourceResult) || !IsOk(nodeTargetNameResult):
            err = Fmt" compiler csg: resolved-call exact target payload intern missing row={rowIndex} node={resolvedNodeIndex}"
            return false
        let nodeTargetSignatureLine = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_callTargetSignatureLineNumbers,
            resolvedNodeIndex)
        if !CompilerCsgSourcePathsEquivalent(
               Value(targetSourceResult),
               Value(nodeTargetSourceResult)) ||
           Value(targetNameResult) != Value(nodeTargetNameResult) ||
           table.callTargetSignatureLineNumbers[rowIndex] !=
               nodeTargetSignatureLine ||
           table.callTargetImportcFlags[rowIndex] !=
               typedIr.nodes2_callTargetImportcs[resolvedNodeIndex]:
            err = Fmt" compiler csg: resolved-call fact/TypedIR target payload drift row={rowIndex} node={resolvedNodeIndex} fact_source={Value(targetSourceResult)} typed_source={Value(nodeTargetSourceResult)} fact_name={Value(targetNameResult)} typed_name={Value(nodeTargetNameResult)} fact_signature_line={table.callTargetSignatureLineNumbers[rowIndex]} typed_signature_line={nodeTargetSignatureLine} fact_importc={table.callTargetImportcFlags[rowIndex]} typed_importc={typedIr.nodes2_callTargetImportcs[resolvedNodeIndex]}"
            return false
        let declarationRow = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_callDeclarationIndexes,
            resolvedNodeIndex)
        if declarationRow < 0:
            err = Fmt" compiler csg: resolved-call TypedIR target lacks exact declaration row={rowIndex} node={resolvedNodeIndex}"
            return false
        var targetReachableFunctionIndex: int32 = -1
        var importcTarget: bool
        var targetProducerSourceIndex: int32
        var targetProducerDeclarationOrdinal: int32
        var targetParserSourceLocalDeclarationRow: int32
        if !CompilerCsgReachableTargetFromCallDeclaration(
                reachableSet,
                typedIr,
                receipt,
                declarationRow,
                Value(nodeTargetNameResult),
                Value(nodeTargetSourceResult),
                nodeTargetSignatureLine,
                targetReachableFunctionIndex,
                importcTarget,
                targetProducerSourceIndex,
                targetProducerDeclarationOrdinal,
                targetParserSourceLocalDeclarationRow,
                err):
            return false
        if importcTarget != table.callTargetImportcFlags[rowIndex]:
            err = Fmt" compiler csg: resolved-call exact importc class drift row={rowIndex} declaration_row={declarationRow}"
            return false
        if !importcTarget:
            if targetReachableFunctionIndex < 0 ||
               targetReachableFunctionIndex >= reachableToTyped.len ||
               reachableToTyped[targetReachableFunctionIndex] < 0:
                err = Fmt" compiler csg: resolved-call exact target graph identity missing row={rowIndex} declaration_row={declarationRow} target_index={targetReachableFunctionIndex}"
                return false
            targetGraphNodeId =
                reachableGraphNodeIds[targetReachableFunctionIndex]
            if targetGraphNodeId <= 0:
                err = Fmt" compiler csg: resolved-call exact target graph node missing row={rowIndex} target_index={targetReachableFunctionIndex}"
                return false
        var targetAnnotationFlags: int32
        var targetContractCid: layout.FixedBytes32
        if !importcTarget:
            if targetReachableFunctionIndex < 0 ||
               targetReachableFunctionIndex >=
                   reachableSet.functionAnnotationFlags.len ||
               targetReachableFunctionIndex >=
                   reachableSet.functionDeclarationHeaderCids.len ||
               targetReachableFunctionIndex >=
                   reachableSet.functionDeclarationPathCids.len ||
               targetReachableFunctionIndex >=
                   reachableSet.functionNameProofCids.len ||
               targetReachableFunctionIndex >=
                   reachableSet.producerSourceIndexes.len ||
               targetReachableFunctionIndex >=
                   reachableSet.producerDeclarationIndexes.len:
                err = Fmt" compiler csg: resolved-call annotation target row invalid row={rowIndex} target_function={targetReachableFunctionIndex}"
                return false
            targetAnnotationFlags =
                reachableSet.functionAnnotationFlags[
                    targetReachableFunctionIndex]
            if !parser.ParserNormalizedFunctionAnnotationFlagsValid(
                   targetAnnotationFlags):
                err = Fmt" compiler csg: resolved-call annotation flags invalid row={rowIndex} target_function={targetReachableFunctionIndex}"
                return false
            targetContractCid =
                CompilerCsgFunctionAnnotationContractCid(
                    targetReachableFunctionIndex,
                    reachableSet.producerSourceIndexes[
                        targetReachableFunctionIndex],
                    reachableSet.producerDeclarationIndexes[
                        targetReachableFunctionIndex],
                    targetAnnotationFlags,
                    reachableSet.functionDeclarationHeaderCids[
                        targetReachableFunctionIndex],
                    reachableSet.functionDeclarationPathCids[
                        targetReachableFunctionIndex],
                    reachableSet.functionNameProofCids[
                        targetReachableFunctionIndex])
            if layout.FixedBytes32Equal(
                   targetContractCid, layout.FixedBytes32()):
                err = Fmt" compiler csg: resolved-call annotation contract CID missing row={rowIndex}"
                return false
        let borrows =
            (targetAnnotationFlags &
                parser.ParserFunctionAnnotationBorrows) != 0
        let escapes =
            (targetAnnotationFlags &
                parser.ParserFunctionAnnotationEscapes) != 0
        if borrows && escapes:
            err = Fmt" compiler csg: resolved-call borrows/escapes contract is contradictory row={rowIndex}"
            return false
        if targetProducerSourceIndex < 0 ||
           targetProducerSourceIndex >= receipt.sourceSidecars.len:
            err = Fmt" compiler csg: resolved-call target parameter source invalid row={rowIndex} source={targetProducerSourceIndex}"
            return false
        let targetSidecar =
            receipt.sourceSidecars[targetProducerSourceIndex]
        if targetParserSourceLocalDeclarationRow < 0 ||
           targetParserSourceLocalDeclarationRow >=
               targetSidecar.declarationKinds.len ||
           targetSidecar.declarationKinds[
               targetParserSourceLocalDeclarationRow] !=
               Int32(parser.ParserDeclarationFunction):
            err = Fmt" compiler csg: resolved-call target parameter owner invalid row={rowIndex} declaration={targetParserSourceLocalDeclarationRow}"
            return false
        var targetParameterRows: int32[]
        for declarationRow in 0..<targetSidecar.declarationKinds.len:
            if targetSidecar.declarationKinds[declarationRow] ==
                   Int32(parser.ParserDeclarationParameter) &&
               targetSidecar.declarationOwnerIds[declarationRow] ==
                   targetParserSourceLocalDeclarationRow:
                add(targetParameterRows, declarationRow)
        if targetParameterRows.len != table.callArgCounts[rowIndex]:
            err = Fmt" compiler csg: resolved-call exact parameter/argument count mismatch row={rowIndex} parameters={targetParameterRows.len} arguments={table.callArgCounts[rowIndex]}"
            return false
        let argumentBindingStart =
            finalCallArgumentBindingIds.len
        let effectStart = finalOwnershipEffectIds.len
        var argLinkNodeIndex = arenamod.ArenaArrayInt32Get(
            typedIr.arena,
            typedIr.nodes2_operand0NodeIndexs,
            resolvedNodeIndex)
        var argumentOrdinal: int32
        while argumentOrdinal < table.callArgCounts[rowIndex]:
            if argLinkNodeIndex < 0 ||
               argLinkNodeIndex >= resolvedNodeIndex ||
               typedIr.nodes2_opKinds[argLinkNodeIndex] !=
                   texpr.TypedExprIrOpArgLink:
                err = Fmt" compiler csg: resolved-call exact argument link invalid row={rowIndex} argument={argumentOrdinal} link={argLinkNodeIndex}"
                return false
            let valueNodeIndex = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_operand0NodeIndexs,
                argLinkNodeIndex)
            if valueNodeIndex < 0 ||
               valueNodeIndex >= argLinkNodeIndex:
                err = Fmt" compiler csg: resolved-call exact argument value node invalid row={rowIndex} argument={argumentOrdinal} value_node={valueNodeIndex}"
                return false
            let parameterDeclarationRow =
                targetParameterRows[argumentOrdinal]
            let parameterMutable =
                targetSidecar.declarationMutableFlags[
                    parameterDeclarationRow]
            let argumentBindingId =
                finalCallArgumentBindingIds.len
            let argumentBindingCid =
                CompilerCsgCallArgumentBindingCid(
                    rowIndex,
                    table.sourceIndexes[rowIndex],
                    originParserNodeId,
                    typedFunctionIndex,
                    resolvedNodeIndex,
                    targetProducerSourceIndex,
                    targetParserSourceLocalDeclarationRow,
                    argumentBindingId,
                    argumentOrdinal,
                    argLinkNodeIndex,
                    valueNodeIndex,
                    parameterDeclarationRow,
                    parameterMutable)
            if layout.FixedBytes32Equal(
                   argumentBindingCid, layout.FixedBytes32()):
                err = Fmt" compiler csg: call argument binding CID missing row={rowIndex} argument={argumentOrdinal}"
                return false
            add(finalCallArgumentBindingIds, argumentBindingId)
            add(finalCallArgumentCallRows, rowIndex)
            add(finalCallArgumentOrdinals, argumentOrdinal)
            add(finalCallArgumentArgLinkNodeIndexes,
                argLinkNodeIndex)
            add(finalCallArgumentValueNodeIndexes, valueNodeIndex)
            add(finalCallArgumentTargetParameterDeclarationRows,
                parameterDeclarationRow)
            add(finalCallArgumentTargetParameterMutableFlags,
                parameterMutable)
            add(finalCallArgumentBindingCids, argumentBindingCid)
            let bindingDefinitionRow =
                texpr.TypedExprIrNodeBindingValueDefinitionRowAt(
                    typedIr, valueNodeIndex)
            let producedDefinitionRow =
                texpr.TypedExprIrNodeProducedValueDefinitionRowAt(
                    typedIr, valueNodeIndex)
            if bindingDefinitionRow >= 0 &&
               producedDefinitionRow >= 0:
                err = Fmt" compiler csg: resolved-call argument has split value-definition identity row={rowIndex} argument={argumentOrdinal}"
                return false
            var valueDefinitionRow = bindingDefinitionRow
            if valueDefinitionRow < 0:
                valueDefinitionRow = producedDefinitionRow
            let valueExprClass =
                texpr.TypedExprIrNodeExprClassAt(
                    typedIr, valueNodeIndex)
            if valueExprClass == texpr.TypedExprExprUnknown:
                err = Fmt" compiler csg: call argument ownership is unknown row={rowIndex} argument={argumentOrdinal} value_node={valueNodeIndex}"
                return false
            if valueExprClass == texpr.TypedExprExprBorrowed &&
               escapes:
                err = Fmt" compiler csg: borrowed value passed to @escapes target row={rowIndex} argument={argumentOrdinal} value_definition={valueDefinitionRow}"
                return false
            if valueExprClass == texpr.TypedExprExprBorrowed &&
               !borrows && !parameterMutable:
                err = escapes ?
                    Fmt" compiler csg: borrowed value passed to @escapes target row={rowIndex} argument={argumentOrdinal} value_definition={valueDefinitionRow}" :
                    Fmt" compiler csg: borrowed value passed to non-var parameter without @borrows target row={rowIndex} argument={argumentOrdinal} value_definition={valueDefinitionRow}"
                return false
            let managedValue =
                valueExprClass == texpr.TypedExprExprOwned ||
                valueExprClass == texpr.TypedExprExprBorrowed
            let ownershipEffectRequired =
                managedValue &&
                (borrows || escapes || parameterMutable)
            if ownershipEffectRequired:
                let effectId = finalOwnershipEffectIds.len
                var projectedValueDefinitionRow: int32
                var ownershipProjectionCid: layout.FixedBytes32
                if !compilerCsgCallOwnershipProjectionAppendInto(
                       typedIr,
                       typedFunctionIndex,
                       callerProducerSourceIndex,
                       callerParserDeclarationRow,
                       effectId,
                       valueNodeIndex,
                       finalOwnershipProjection,
                       projectedValueDefinitionRow,
                       ownershipProjectionCid,
                       err):
                    return false
                if valueDefinitionRow >= 0 &&
                   valueDefinitionRow !=
                       projectedValueDefinitionRow:
                    err = Fmt" compiler csg: call ownership direct/projection root definition drift row={rowIndex} argument={argumentOrdinal}"
                    return false
                valueDefinitionRow = projectedValueDefinitionRow
                let definitionCount =
                    texpr.TypedExprValueDefinitionAuthorityCount(
                        typedIr)
                if valueDefinitionRow >= definitionCount:
                    err = Fmt" compiler csg: call ownership effect value-definition out of range row={rowIndex} argument={argumentOrdinal} value_definition={valueDefinitionRow}"
                    return false
                let definitionOwnership =
                    texpr.TypedExprValueDefinitionOwnershipAt(
                        typedIr, valueDefinitionRow)
                if definitionOwnership !=
                       texpr.TypedExprExprOwned &&
                   definitionOwnership !=
                       texpr.TypedExprExprBorrowed:
                    err = Fmt" compiler csg: call ownership effect definition is not managed row={rowIndex} argument={argumentOrdinal} value_definition={valueDefinitionRow}"
                    return false
                if valueExprClass == texpr.TypedExprExprOwned &&
                   definitionOwnership !=
                       texpr.TypedExprExprOwned:
                    err = Fmt" compiler csg: owned call argument definition is not owned row={rowIndex} argument={argumentOrdinal} value_definition={valueDefinitionRow}"
                    return false
                let definitionTypedFunctionIndex =
                    texpr.TypedExprValueDefinitionTypedFunctionIndexAt(
                        typedIr, valueDefinitionRow)
                if definitionTypedFunctionIndex !=
                       typedFunctionIndex:
                    err = Fmt" compiler csg: call ownership effect definition owner drift row={rowIndex} argument={argumentOrdinal} value_definition={valueDefinitionRow}"
                    return false
                let effectKind = (borrows || parameterMutable) ?
                    CompilerCsgCallOwnershipEffectBorrow :
                    CompilerCsgCallOwnershipEffectEscape
                let definitionTypeId =
                    texpr.TypedExprValueDefinitionExactTypeIdAt(
                        typedIr, valueDefinitionRow)
                let definitionOriginKind =
                    texpr.TypedExprValueDefinitionOriginKindAt(
                        typedIr, valueDefinitionRow)
                let definitionNodeIndex =
                    texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                        typedIr, valueDefinitionRow)
                let definitionProducerSourceIndex =
                    texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                        typedIr, valueDefinitionRow)
                let definitionSourceLocalNodeIndex =
                    texpr.
                        TypedExprValueDefinitionSourceLocalNodeIndexAt(
                            typedIr, valueDefinitionRow)
                let definitionDeclarationSourceLocalRow =
                    texpr.
                        TypedExprValueDefinitionDeclarationSourceLocalRowAt(
                            typedIr, valueDefinitionRow)
                let effectCid = CompilerCsgCallOwnershipEffectCid(
                    rowIndex,
                    table.sourceIndexes[rowIndex],
                    originParserNodeId,
                    typedFunctionIndex,
                    resolvedNodeIndex,
                    targetReachableFunctionIndex,
                    targetGraphNodeId,
                    targetAnnotationFlags,
                    targetContractCid,
                    effectId,
                    argumentBindingId,
                    argumentBindingCid,
                    ownershipProjectionCid,
                    argumentOrdinal,
                    argLinkNodeIndex,
                    valueNodeIndex,
                    Int32(valueExprClass),
                    valueDefinitionRow,
                    Int32(definitionOwnership),
                    Int32(definitionOriginKind),
                    definitionTypedFunctionIndex,
                    definitionTypeId,
                    definitionNodeIndex,
                    definitionProducerSourceIndex,
                    definitionSourceLocalNodeIndex,
                    definitionDeclarationSourceLocalRow,
                    effectKind)
                if layout.FixedBytes32Equal(
                       effectCid, layout.FixedBytes32()):
                    err = Fmt" compiler csg: call ownership effect CID missing row={rowIndex} argument={argumentOrdinal}"
                    return false
                add(finalOwnershipEffectIds, effectId)
                add(finalOwnershipEffectCallRows, rowIndex)
                add(finalOwnershipEffectCallArgumentRows,
                    argumentBindingId)
                add(finalOwnershipEffectArgumentOrdinals,
                    argumentOrdinal)
                add(finalOwnershipEffectArgLinkNodeIndexes,
                    argLinkNodeIndex)
                add(finalOwnershipEffectValueNodeIndexes,
                    valueNodeIndex)
                add(finalOwnershipEffectValueNodeOwnerships,
                    Int32(valueExprClass))
                add(finalOwnershipEffectValueDefinitionRows,
                    valueDefinitionRow)
                add(finalOwnershipEffectValueDefinitionOwnerships,
                    Int32(definitionOwnership))
                add(finalOwnershipEffectValueDefinitionOriginKinds,
                    Int32(definitionOriginKind))
                add(
                    finalOwnershipEffectValueDefinitionTypedFunctionIndexes,
                    definitionTypedFunctionIndex)
                add(finalOwnershipEffectValueDefinitionExactTypeIds,
                    definitionTypeId)
                add(
                    finalOwnershipEffectValueDefinitionDefiningNodeIndexes,
                    definitionNodeIndex)
                add(
                    finalOwnershipEffectValueDefinitionProducerSourceIndexes,
                    definitionProducerSourceIndex)
                add(
                    finalOwnershipEffectValueDefinitionSourceLocalNodeIndexes,
                    definitionSourceLocalNodeIndex)
                add(
                    finalOwnershipEffectValueDefinitionDeclarationSourceLocalRows,
                    definitionDeclarationSourceLocalRow)
                add(finalOwnershipEffectKinds, effectKind)
                add(finalOwnershipEffectCids, effectCid)
            argLinkNodeIndex = arenamod.ArenaArrayInt32Get(
                typedIr.arena,
                typedIr.nodes2_operand1NodeIndexs,
                argLinkNodeIndex)
            argumentOrdinal = argumentOrdinal + 1
        if argLinkNodeIndex != -1:
            err = Fmt" compiler csg: resolved-call exact argument chain terminator invalid row={rowIndex} link={argLinkNodeIndex}"
            return false
        add(finalFunctionIndexes, typedFunctionIndex)
        add(finalTargetProducerSourceIndexes,
            targetProducerSourceIndex)
        add(finalTargetProducerDeclarationOrdinals,
            targetProducerDeclarationOrdinal)
        add(finalTargetParserSourceLocalDeclarationRows,
            targetParserSourceLocalDeclarationRow)
        add(finalCallerGraphNodeIds, callerGraphNodeId)
        add(finalTargetGraphNodeIds, targetGraphNodeId)
        add(finalTypedCallNodeIndexes, resolvedNodeIndex)
        add(finalTargetFunctionIndexes,
            targetReachableFunctionIndex)
        add(finalTargetFunctionAnnotationFlags,
            targetAnnotationFlags)
        add(finalTargetFunctionContractCids,
            targetContractCid)
        add(finalCallArgumentStarts, argumentBindingStart)
        add(finalOwnershipEffectStarts, effectStart)
        add(finalOwnershipEffectCounts,
            finalOwnershipEffectIds.len - effectStart)
        finalNext[rowIndex] = finalHeads[typedFunctionIndex]
        finalHeads[typedFunctionIndex] = rowIndex
    var validatedTable: CompilerCsgSemanticResolvedCallTable
    # Whole-assign `var validatedTable = table` aliases table's managed
    # columns without transferring ORC owner. Overwriting functionRowHeads
    # then releases table's heads as the wrong owner (indentfn: 0 call
    # rows, 1 function head). Build a fresh table and share each column.
    # Validation still consumes the transient table value; share keeps
    # the original owners available for the atomic commit below.
    validatedTable.internPool = share(table.internPool)
    validatedTable.sourceIndexes = share(table.sourceIndexes)
    validatedTable.originParserNodeIds = share(table.originParserNodeIds)
    validatedTable.sourcePathIds = share(table.sourcePathIds)
    validatedTable.lineNumbers = share(table.lineNumbers)
    validatedTable.columnNumbers = share(table.columnNumbers)
    validatedTable.callQualifierIds = share(table.callQualifierIds)
    validatedTable.callCalleeIds = share(table.callCalleeIds)
    validatedTable.callTargetIds = share(table.callTargetIds)
    validatedTable.callTargetSourcePathIds =
        share(table.callTargetSourcePathIds)
    validatedTable.callTargetSignatureLineNumbers =
        share(table.callTargetSignatureLineNumbers)
    validatedTable.callTargetImportcFlags =
        share(table.callTargetImportcFlags)
    validatedTable.callArgCounts = share(table.callArgCounts)
    validatedTable.callArgsTextIds = share(table.callArgsTextIds)
    validatedTable.returnRootFlags = share(table.returnRootFlags)
    validatedTable.functionIndexes = share(finalFunctionIndexes)
    validatedTable.functionRowHeads = share(finalHeads)
    validatedTable.functionRowNext = share(finalNext)
    validatedTable.targetProducerSourceIndexes =
        share(finalTargetProducerSourceIndexes)
    validatedTable.targetProducerDeclarationOrdinals =
        share(finalTargetProducerDeclarationOrdinals)
    validatedTable.targetParserSourceLocalDeclarationRows =
        share(finalTargetParserSourceLocalDeclarationRows)
    validatedTable.callerGraphNodeIds =
        share(finalCallerGraphNodeIds)
    validatedTable.targetGraphNodeIds =
        share(finalTargetGraphNodeIds)
    validatedTable.typedCallNodeIndexes =
        share(finalTypedCallNodeIndexes)
    validatedTable.targetFunctionIndexes =
        share(finalTargetFunctionIndexes)
    validatedTable.targetFunctionAnnotationFlags =
        share(finalTargetFunctionAnnotationFlags)
    validatedTable.targetFunctionContractCids =
        share(finalTargetFunctionContractCids)
    validatedTable.callArgumentStarts =
        share(finalCallArgumentStarts)
    validatedTable.callArgumentBindingIds =
        share(finalCallArgumentBindingIds)
    validatedTable.callArgumentCallRows =
        share(finalCallArgumentCallRows)
    validatedTable.callArgumentOrdinals =
        share(finalCallArgumentOrdinals)
    validatedTable.callArgumentArgLinkNodeIndexes =
        share(finalCallArgumentArgLinkNodeIndexes)
    validatedTable.callArgumentValueNodeIndexes =
        share(finalCallArgumentValueNodeIndexes)
    validatedTable.callArgumentTargetParameterDeclarationRows =
        share(finalCallArgumentTargetParameterDeclarationRows)
    validatedTable.callArgumentTargetParameterMutableFlags =
        share(finalCallArgumentTargetParameterMutableFlags)
    validatedTable.callArgumentBindingCids =
        share(finalCallArgumentBindingCids)
    validatedTable.ownershipEffectStarts =
        share(finalOwnershipEffectStarts)
    validatedTable.ownershipEffectCounts =
        share(finalOwnershipEffectCounts)
    validatedTable.ownershipEffectIds =
        share(finalOwnershipEffectIds)
    validatedTable.ownershipEffectCallRows =
        share(finalOwnershipEffectCallRows)
    validatedTable.ownershipEffectCallArgumentRows =
        share(finalOwnershipEffectCallArgumentRows)
    validatedTable.ownershipEffectArgumentOrdinals =
        share(finalOwnershipEffectArgumentOrdinals)
    validatedTable.ownershipEffectArgLinkNodeIndexes =
        share(finalOwnershipEffectArgLinkNodeIndexes)
    validatedTable.ownershipEffectValueNodeIndexes =
        share(finalOwnershipEffectValueNodeIndexes)
    validatedTable.ownershipEffectValueNodeOwnerships =
        share(finalOwnershipEffectValueNodeOwnerships)
    validatedTable.ownershipEffectValueDefinitionRows =
        share(finalOwnershipEffectValueDefinitionRows)
    validatedTable.ownershipEffectValueDefinitionOwnerships =
        share(finalOwnershipEffectValueDefinitionOwnerships)
    validatedTable.ownershipEffectValueDefinitionOriginKinds =
        share(finalOwnershipEffectValueDefinitionOriginKinds)
    validatedTable.ownershipEffectValueDefinitionTypedFunctionIndexes =
        share(
            finalOwnershipEffectValueDefinitionTypedFunctionIndexes)
    validatedTable.ownershipEffectValueDefinitionExactTypeIds =
        share(finalOwnershipEffectValueDefinitionExactTypeIds)
    validatedTable.ownershipEffectValueDefinitionDefiningNodeIndexes =
        share(finalOwnershipEffectValueDefinitionDefiningNodeIndexes)
    validatedTable.ownershipEffectValueDefinitionProducerSourceIndexes =
        share(
            finalOwnershipEffectValueDefinitionProducerSourceIndexes)
    validatedTable.ownershipEffectValueDefinitionSourceLocalNodeIndexes =
        share(
            finalOwnershipEffectValueDefinitionSourceLocalNodeIndexes)
    validatedTable.ownershipEffectValueDefinitionDeclarationSourceLocalRows =
        share(
            finalOwnershipEffectValueDefinitionDeclarationSourceLocalRows)
    validatedTable.ownershipEffectKinds =
        share(finalOwnershipEffectKinds)
    validatedTable.ownershipEffectCids =
        share(finalOwnershipEffectCids)
    validatedTable.ownershipProjection =
        compilerCsgCallOwnershipProjectionTableClone(
            finalOwnershipProjection)
    validatedTable.graphNodeProjectionComplete = true
    if !CompilerCsgSemanticResolvedCallTableValidate(validatedTable,
                                               typedFunctionCount,
                                               err):
        return false
    table.functionIndexes = finalFunctionIndexes
    table.functionRowHeads = finalHeads
    table.functionRowNext = finalNext
    table.targetProducerSourceIndexes =
        finalTargetProducerSourceIndexes
    table.targetProducerDeclarationOrdinals =
        finalTargetProducerDeclarationOrdinals
    table.targetParserSourceLocalDeclarationRows =
        finalTargetParserSourceLocalDeclarationRows
    table.callerGraphNodeIds = finalCallerGraphNodeIds
    table.targetGraphNodeIds = finalTargetGraphNodeIds
    table.typedCallNodeIndexes = finalTypedCallNodeIndexes
    table.targetFunctionIndexes = finalTargetFunctionIndexes
    table.targetFunctionAnnotationFlags =
        finalTargetFunctionAnnotationFlags
    table.targetFunctionContractCids =
        finalTargetFunctionContractCids
    table.callArgumentStarts = finalCallArgumentStarts
    table.callArgumentBindingIds =
        finalCallArgumentBindingIds
    table.callArgumentCallRows = finalCallArgumentCallRows
    table.callArgumentOrdinals = finalCallArgumentOrdinals
    table.callArgumentArgLinkNodeIndexes =
        finalCallArgumentArgLinkNodeIndexes
    table.callArgumentValueNodeIndexes =
        finalCallArgumentValueNodeIndexes
    table.callArgumentTargetParameterDeclarationRows =
        finalCallArgumentTargetParameterDeclarationRows
    table.callArgumentTargetParameterMutableFlags =
        finalCallArgumentTargetParameterMutableFlags
    table.callArgumentBindingCids =
        finalCallArgumentBindingCids
    table.ownershipEffectStarts = finalOwnershipEffectStarts
    table.ownershipEffectCounts = finalOwnershipEffectCounts
    table.ownershipEffectIds = finalOwnershipEffectIds
    table.ownershipEffectCallRows = finalOwnershipEffectCallRows
    table.ownershipEffectCallArgumentRows =
        finalOwnershipEffectCallArgumentRows
    table.ownershipEffectArgumentOrdinals =
        finalOwnershipEffectArgumentOrdinals
    table.ownershipEffectArgLinkNodeIndexes =
        finalOwnershipEffectArgLinkNodeIndexes
    table.ownershipEffectValueNodeIndexes =
        finalOwnershipEffectValueNodeIndexes
    table.ownershipEffectValueNodeOwnerships =
        finalOwnershipEffectValueNodeOwnerships
    table.ownershipEffectValueDefinitionRows =
        finalOwnershipEffectValueDefinitionRows
    table.ownershipEffectValueDefinitionOwnerships =
        finalOwnershipEffectValueDefinitionOwnerships
    table.ownershipEffectValueDefinitionOriginKinds =
        finalOwnershipEffectValueDefinitionOriginKinds
    table.ownershipEffectValueDefinitionTypedFunctionIndexes =
        finalOwnershipEffectValueDefinitionTypedFunctionIndexes
    table.ownershipEffectValueDefinitionExactTypeIds =
        finalOwnershipEffectValueDefinitionExactTypeIds
    table.ownershipEffectValueDefinitionDefiningNodeIndexes =
        finalOwnershipEffectValueDefinitionDefiningNodeIndexes
    table.ownershipEffectValueDefinitionProducerSourceIndexes =
        finalOwnershipEffectValueDefinitionProducerSourceIndexes
    table.ownershipEffectValueDefinitionSourceLocalNodeIndexes =
        finalOwnershipEffectValueDefinitionSourceLocalNodeIndexes
    table.ownershipEffectValueDefinitionDeclarationSourceLocalRows =
        finalOwnershipEffectValueDefinitionDeclarationSourceLocalRows
    table.ownershipEffectKinds = finalOwnershipEffectKinds
    table.ownershipEffectCids = finalOwnershipEffectCids
    table.ownershipProjection = finalOwnershipProjection
    table.graphNodeProjectionComplete = true
    err = ""
    return true

fn CompilerCsgSemanticTypedFactAccumulatorInit(semanticGraph: var CompilerCsgSemanticGraph,
                                         functionCount: int32): CompilerCsgSemanticTypedFactAccumulator =
    if functionCount < 0:
        panic(Fmt"compiler csg: resolved-call function count invalid count={functionCount}")
    var releasedBufferCount: int32
    var releasedBytes: int64
    CompilerCsgSemanticTypedFactTableTerminalReleaseWithReceipt(
        semanticGraph.typedFactTable,
        releasedBufferCount,
        releasedBytes)
    freeSeq(semanticGraph.exprSliceTable.functionSliceIndexes)
    for functionIndex in 0..<functionCount:
        add(semanticGraph.exprSliceTable.functionSliceIndexes, -1)
    CompilerCsgSemanticResolvedCallTableRelease(semanticGraph.resolvedCallTable)
    semanticGraph.resolvedCallTable.internPool = langintern.InternPoolNew()
    for functionIndex in 0..<functionCount:
        add(semanticGraph.resolvedCallTable.functionRowHeads, -1)
    var out: CompilerCsgSemanticTypedFactAccumulator
    out.loweringRuleShapes = CompilerCsgSemanticLoweringRuleSetInit()
    out.loweringRuleKeys = CompilerCsgSemanticLoweringRuleSetInit()
    out.resolvedCallSet = CompilerCsgSemanticResolvedCallSetInit()
    for functionIndex in 0..<functionCount:
        add(out.resolvedFunctionHeadCertificates,
            CompilerCsgSemanticResolvedFunctionHeadCertificate(functionIndex, -1))
    out.stateVersion = Int64(1)
    out.validatedVersion = Int64(0)
    out.validatedTypedFactPrefix = 0
    out.validatedResolvedCallPrefix = 0
    out.active = true
    return out

@borrows
fn CompilerCsgTypedFactIsReachabilityExecutableCall(fact: TypedExprFact): bool =
    if fact.typeCallKind != texpr.TypedExprTypeCallNone:
        return false
    if fact.callKind == texpr.TypedExprCallBuiltin ||
       fact.callKind == texpr.TypedExprCallResultIntrinsic ||
       fact.callKind == texpr.TypedExprCallProjection:
        return false
    if fact.callTargetImportc ||
       fact.surfaceCallKind == texpr.TypedExprSurfaceCallImportc ||
       fact.surfaceCallKind == texpr.TypedExprSurfaceCallMember:
        return false
    return fact.surfaceCallKind == texpr.TypedExprSurfaceCallLocal ||
           fact.surfaceCallKind == texpr.TypedExprSurfaceCallExternal

@borrows
fn CompilerCsgTypedFactIsResolvedCallSnapshot(fact: TypedExprFact): bool =
    if fact.typeCallKind != texpr.TypedExprTypeCallNone:
        return false
    if fact.callKind == texpr.TypedExprCallBuiltin ||
       fact.callKind == texpr.TypedExprCallResultIntrinsic ||
       fact.callKind == texpr.TypedExprCallProjection:
        return false
    if fact.callTargetImportc ||
       fact.surfaceCallKind == texpr.TypedExprSurfaceCallImportc:
        return true
    return fact.surfaceCallKind == texpr.TypedExprSurfaceCallLocal ||
           fact.surfaceCallKind == texpr.TypedExprSurfaceCallExternal ||
           fact.surfaceCallKind == texpr.TypedExprSurfaceCallMember

@borrows
fn CompilerCsgValidateTypedFactExecutableTarget(ruleSet: var CompilerCsgReachableFunctionSet,
                                                 sourceIndexCache: var CompilerCsgSourcePathIndex,
                                                 fact: TypedExprFact,
                                                 validateFunction: bool,
                                                 probes: var CompilerCsgReachabilityProbeDelta,
                                                 err: var str): bool =
    if fact.callCallee == "":
        err = Fmt" compiler csg: executable call callee empty source={fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.lineNumber <= 0:
        err = Fmt" compiler csg: executable call line invalid callee={fact.callCallee} source={fact.sourcePath}:{fact.lineNumber}"
        return false
    if !fact.callResolved:
        if TypedExprStripVarType(fact.callCallee) == "range":
            # range(...) 是内建区间构造 (for 头 `a..<b` 的脱糖形),
            # 无用户函数目标 —— 不参与可达性/解析检查。
            return true
        if TypedExprStripVarType(fact.callCallee) == "share":
            # share(...) 是内建所有权惯用面 (spec: 增引用计数并返回
            # 同型可共享引用), 无用户函数目标 —— 同 range 先例,
            # 不参与可达性/解析检查; 若未来出现用户态 fn share 声明,
            # 调用会正常解析 (callResolved=true), 不进入本臂。
            return true
        err = Fmt" compiler csg: executable call unresolved callee={fact.callCallee} source={fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.callReason != texpr.TypedExprCallReasonNone:
        err = Fmt" compiler csg: executable call resolution reason is not none callee={fact.callCallee} reason={fact.callReason} source={fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.callTarget == "":
        err = Fmt" compiler csg: executable call target empty callee={fact.callCallee} source={fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.callTargetSourcePath == "":
        err = Fmt" compiler csg: executable call target source empty target={fact.callTarget} source={fact.sourcePath}:{fact.lineNumber}"
        return false
    if fact.callTargetSignatureLineNumber <= 0:
        err = Fmt" compiler csg: executable call target signature line invalid target={fact.callTarget} target_source={fact.callTargetSourcePath} target_signature_line={fact.callTargetSignatureLineNumber} source={fact.sourcePath}:{fact.lineNumber}"
        return false
    let targetSourceIndex = CompilerCsgSemanticFindSourceIndex(sourceIndexCache,
                                                         fact.callTargetSourcePath)
    if targetSourceIndex < 0:
        err = Fmt" compiler csg: executable call target source missing target={fact.callTarget} target_source={fact.callTargetSourcePath} source={fact.sourcePath}:{fact.lineNumber}"
        return false
    # Facts retain the compiler-produced target payload, but they do not carry
    # the declaration row.  Exact target existence is proved later by joining
    # the same parser origin to TypedIR.callDeclarationIndex; selecting a
    # function here by source/name/line would create a second identity system.
    err = ""
    return true

fn CompilerCsgSemanticTypedFactTransactionInit(): CompilerCsgSemanticTypedFactTransaction =
    var out: CompilerCsgSemanticTypedFactTransaction
    out.predictedInternIndex = hashmaps.HashMapStrIntInit(16)
    out.predictedEmptyInternId = -1
    return out

@borrows
fn CompilerCsgSemanticTypedFactRowCertificate(table: CompilerCsgSemanticTypedFactTable,
                                        rowIndex: int32): int64 =
    var out = CompilerCsgCertificateMix(Int64(rowIndex),
                                        Int64(table.sourceIndexes[rowIndex]))
    out = CompilerCsgCertificateMix(out,
                                    Int64(table.functionIndexes[rowIndex]))
    return CompilerCsgTypedFactSemanticDigestUpdateFields(
        out,
        table.semanticIdentityCertificates[rowIndex],
        table.valueKinds[rowIndex],
        table.placeKinds[rowIndex],
        table.hasSinks[rowIndex],
        table.sinkPlaceKinds[rowIndex],
        table.loweringModes[rowIndex],
        table.callKinds[rowIndex],
        table.typeCallKinds[rowIndex],
        table.returnKinds[rowIndex],
        table.returnRoots[rowIndex])

@borrows
fn CompilerCsgSemanticPredictInternId(table: CompilerCsgSemanticResolvedCallTable,
                               transaction: var CompilerCsgSemanticTypedFactTransaction,
                               text: str): int32 =
    if text == "":
        if table.internPool.emptyId >= 0:
            return table.internPool.emptyId
        if transaction.predictedEmptyInternPresent:
            return transaction.predictedEmptyInternId
        transaction.predictedEmptyInternPresent = true
        transaction.predictedEmptyInternId =
            table.internPool.texts.len + transaction.predictedInternTexts.len
        add(transaction.predictedInternTexts, share(text))
        return transaction.predictedEmptyInternId
    var found = false
    let liveId = langintern.FindInternId(table.internPool, text)
    if liveId >= 0:
        return liveId
    let stagedId = hashmaps.HashMapStrIntGetExValue(transaction.predictedInternIndex,
                                                    share(text),
                                                    found)
    if found:
        return stagedId
    let predictedId = table.internPool.texts.len + transaction.predictedInternTexts.len
    add(transaction.predictedInternTexts, share(text))
    hashmaps.HashMapStrIntPut(
        transaction.predictedInternIndex,
        share(text),
        predictedId)
    return predictedId

@borrows
fn CompilerCsgSemanticResolvedCallRowMatchesFact(table: CompilerCsgSemanticResolvedCallTable,
                                           rowIndex: int32,
                                           sourceIndex: int32,
                                           functionIndex: int32,
                                           fact: TypedExprFact,
                                           sourcePathId: int32,
                                           callQualifierId: int32,
                                           callCalleeId: int32,
                                           callTargetId: int32,
                                           callTargetSourcePathId: int32,
                                           callArgsTextId: int32): bool =
    return table.sourceIndexes[rowIndex] == sourceIndex &&
           table.originParserNodeIds[rowIndex] == fact.originParserNodeId &&
           table.functionIndexes[rowIndex] == functionIndex &&
           table.sourcePathIds[rowIndex] == sourcePathId &&
           table.lineNumbers[rowIndex] == fact.lineNumber &&
           table.columnNumbers[rowIndex] == fact.columnNumber &&
           table.callQualifierIds[rowIndex] == callQualifierId &&
           table.callCalleeIds[rowIndex] == callCalleeId &&
           table.callTargetIds[rowIndex] == callTargetId &&
           table.callTargetSourcePathIds[rowIndex] == callTargetSourcePathId &&
           table.callTargetSignatureLineNumbers[rowIndex] ==
               fact.callTargetSignatureLineNumber &&
           table.callTargetImportcFlags[rowIndex] == fact.callTargetImportc &&
           table.callArgCounts[rowIndex] == fact.callArgCount &&
           table.callArgsTextIds[rowIndex] == callArgsTextId &&
           table.returnRootFlags[rowIndex] == fact.returnRoot

@borrows
fn CompilerCsgSemanticResolvedFactContentCertificate(sourceIndex: int32,
                                               functionIndex: int32,
                                               fact: TypedExprFact): int64 =
    var out = CompilerCsgCertificateMix(Int64(sourceIndex), Int64(functionIndex))
    out = CompilerCsgCertificateMix(out,
                                    Int64(fact.originParserNodeId))
    out = CompilerCsgCertificateMix(out,
                                    CompilerCsgTextContentCertificate(fact.sourcePath))
    out = CompilerCsgCertificateMix(out, Int64(fact.lineNumber))
    out = CompilerCsgCertificateMix(out, Int64(fact.columnNumber))
    out = CompilerCsgCertificateMix(out,
                                    CompilerCsgTextContentCertificate(fact.callQualifier))
    out = CompilerCsgCertificateMix(out,
                                    CompilerCsgTextContentCertificate(fact.callCallee))
    out = CompilerCsgCertificateMix(out,
                                    CompilerCsgTextContentCertificate(fact.callTarget))
    out = CompilerCsgCertificateMix(out,
        CompilerCsgTextContentCertificate(fact.callTargetSourcePath))
    out = CompilerCsgCertificateMix(
        out, Int64(fact.callTargetSignatureLineNumber))
    out = CompilerCsgCertificateMix(out,
                                    fact.callTargetImportc ? Int64(1) : Int64(0))
    out = CompilerCsgCertificateMix(out, Int64(fact.callArgCount))
    out = CompilerCsgCertificateMix(out,
                                    CompilerCsgTextContentCertificate(fact.callArgsText))
    return CompilerCsgCertificateMix(out,
                                     fact.returnRoot ? Int64(1) : Int64(0))

@borrows
fn CompilerCsgSemanticResolvedStagedRowMatchesFact(transaction: CompilerCsgSemanticTypedFactTransaction,
                                             stagedRow: int32,
                                             fact: TypedExprFact,
                                             sourceIndex: int32,
                                             functionIndex: int32,
                                             sourcePathId: int32,
                                             callQualifierId: int32,
                                             callCalleeId: int32,
                                             callTargetId: int32,
                                             callTargetSourcePathId: int32,
                                             callArgsTextId: int32): bool =
    if stagedRow < 0 || stagedRow >= transaction.resolvedAppendTransactionIndexes.len:
        return false
    let transactionIndex = transaction.resolvedAppendTransactionIndexes[stagedRow]
    if transactionIndex < 0 || transactionIndex >= transaction.factIndexes.len:
        return false
    return transaction.sourceIndexes[transactionIndex] == sourceIndex &&
           transaction.resolvedOriginParserNodeIds[transactionIndex] ==
               fact.originParserNodeId &&
           transaction.functionIndexes[transactionIndex] == functionIndex &&
           transaction.resolvedSourcePathIds[transactionIndex] == sourcePathId &&
           transaction.resolvedCallQualifierIds[transactionIndex] == callQualifierId &&
           transaction.resolvedCallCalleeIds[transactionIndex] == callCalleeId &&
           transaction.resolvedCallTargetIds[transactionIndex] == callTargetId &&
           transaction.resolvedCallTargetSourcePathIds[transactionIndex] ==
               callTargetSourcePathId &&
           transaction.resolvedCallArgsTextIds[transactionIndex] == callArgsTextId &&
           transaction.resolvedContentCertificates[transactionIndex] ==
               CompilerCsgSemanticResolvedFactContentCertificate(sourceIndex,
                                                           functionIndex,
                                                           fact)

fn CompilerCsgSemanticTypedFactAccumulatorStateValidate(semanticGraph: var CompilerCsgSemanticGraph,
                                                   accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                                   reachableSet: var CompilerCsgReachableFunctionSet,
                                                   fullRowVisitCount: var int64,
                                                   err: var str): bool =
    fullRowVisitCount = Int64(0)
    var needsSeal: bool
    if !CompilerCsgReachableFunctionSetValidateForTransaction(reachableSet,
                                                               needsSeal,
                                                               err):
        return false
    let resolvedRowCount = semanticGraph.resolvedCallTable.sourceIndexes.len
    let typedFactRowCount = semanticGraph.typedFactTable.sourceIndexes.len
    if !CompilerCsgSemanticTypedFactSemanticColumnsValid(semanticGraph.typedFactTable):
        err = " compiler csg: typed-fact semantic snapshot columns mismatch"
        return false
    let certificateColumnsValid =
        accumulator.resolvedFunctionHeadCertificates.len ==
            semanticGraph.resolvedCallTable.functionRowHeads.len &&
        accumulator.resolvedCallRowCertificates.len == resolvedRowCount &&
        accumulator.typedFactRowCertificates.len == typedFactRowCount &&
        accumulator.resolvedCallSet.nextCertificates.len == resolvedRowCount &&
        accumulator.resolvedCallSet.nextIndexes.len == resolvedRowCount &&
        accumulator.resolvedCallSet.hashSlotCertificates.len ==
            accumulator.resolvedCallSet.hashIndex.slots.len &&
        accumulator.resolvedCallSet.bucketHeads.len ==
            accumulator.resolvedCallSet.hashIndex.keys.len &&
        accumulator.resolvedCallSet.bucketHeadCertificates.len ==
            accumulator.resolvedCallSet.hashIndex.keys.len
    if accumulator.validatedVersion != Int64(0) && !certificateColumnsValid:
        err = " compiler csg: accumulator certificate columns mismatch"
        return false
    if accumulator.validatedVersion != Int64(0) &&
       accumulator.validatedVersion == accumulator.stateVersion &&
       accumulator.validatedTypedFactPrefix == typedFactRowCount &&
       accumulator.validatedResolvedCallPrefix == resolvedRowCount &&
       accumulator.resolvedCallSet.sealedVersion ==
           accumulator.resolvedCallSet.version:
        err = ""
        return true
    if accumulator.validatedVersion != Int64(0):
        err = Fmt" compiler csg: accumulator version changed outside mutator validated={accumulator.validatedVersion} state={accumulator.stateVersion} typed_prefix={accumulator.validatedTypedFactPrefix} typed_rows={typedFactRowCount} resolved_prefix={accumulator.validatedResolvedCallPrefix} resolved_rows={resolvedRowCount}"
        return false
    if !CompilerCsgSemanticResolvedCallTableValidate(semanticGraph.resolvedCallTable,
                                               reachableSet.functionNames.len,
                                               err) ||
       !CompilerCsgSemanticResolvedCallSetValidate(semanticGraph.resolvedCallTable,
                                             accumulator.resolvedCallSet,
                                             err):
        return false
    if !certificateColumnsValid:
        err = " compiler csg: accumulator certificate columns mismatch"
        return false
    for functionIndex in 0..<semanticGraph.resolvedCallTable.functionRowHeads.len:
        if accumulator.resolvedFunctionHeadCertificates[functionIndex] !=
           CompilerCsgSemanticResolvedFunctionHeadCertificate(functionIndex,
               semanticGraph.resolvedCallTable.functionRowHeads[functionIndex]):
            err = Fmt" compiler csg: resolved-call function head certificate mismatch function={functionIndex}"
            return false
        fullRowVisitCount = fullRowVisitCount + Int64(1)
    for rowIndex in 0..<resolvedRowCount:
        if accumulator.resolvedCallRowCertificates[rowIndex] !=
           CompilerCsgSemanticResolvedCallRowCertificate(semanticGraph.resolvedCallTable, rowIndex):
            err = Fmt" compiler csg: resolved-call row certificate mismatch row={rowIndex}"
            return false
        fullRowVisitCount = fullRowVisitCount + Int64(1)
    for factRow in 0..<typedFactRowCount:
        let sourceIndex = semanticGraph.typedFactTable.sourceIndexes[factRow]
        let functionIndex = semanticGraph.typedFactTable.functionIndexes[factRow]
        if sourceIndex < 0 || sourceIndex >= semanticGraph.sourceTable.sourcePaths.len ||
           functionIndex < 0 ||
           functionIndex >= reachableSet.functionNames.len ||
           accumulator.typedFactRowCertificates[factRow] !=
               CompilerCsgSemanticTypedFactRowCertificate(semanticGraph.typedFactTable,
                                                    factRow):
            err = Fmt" compiler csg: typed-fact committed row invalid row={factRow} source_index={sourceIndex} function_index={functionIndex} sources={semanticGraph.sourceTable.sourcePaths.len} functions={reachableSet.functionNames.len}"
            return false
        fullRowVisitCount = fullRowVisitCount + Int64(1)
    err = ""
    return true

fn CompilerCsgSemanticTypedFactTransactionStageResolvedCall(semanticGraph: var CompilerCsgSemanticGraph,
                                                       accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                                       sourceIndex: int32,
                                                       functionIndex: int32,
                                                       fact: TypedExprFact,
                                                       transactionIndex: int32,
                                                       transaction: var CompilerCsgSemanticTypedFactTransaction,
                                                       err: var str): bool =
    if fact.originParserNodeId < 0:
        err = Fmt" compiler csg: resolved-call parser origin missing source={fact.sourcePath}:{fact.lineNumber}"
        return false
    if functionIndex < 0 ||
       functionIndex >= semanticGraph.resolvedCallTable.functionRowHeads.len ||
       functionIndex >= accumulator.resolvedFunctionHeadCertificates.len:
        err = Fmt" compiler csg: resolved-call staged owner invalid function={functionIndex}"
        return false
    transaction.validationTouchedRowVisitCount =
        transaction.validationTouchedRowVisitCount + Int64(1)
    if accumulator.resolvedFunctionHeadCertificates[functionIndex] !=
       CompilerCsgSemanticResolvedFunctionHeadCertificate(functionIndex,
           semanticGraph.resolvedCallTable.functionRowHeads[functionIndex]):
        err = Fmt" compiler csg: resolved-call function head certificate mismatch function={functionIndex}"
        return false
    let sourcePathId = CompilerCsgSemanticPredictInternId(semanticGraph.resolvedCallTable,
                                                    transaction,
                                                    fact.sourcePath)
    let callQualifierId = CompilerCsgSemanticPredictInternId(semanticGraph.resolvedCallTable,
                                                       transaction,
                                                       fact.callQualifier)
    let callCalleeId = CompilerCsgSemanticPredictInternId(semanticGraph.resolvedCallTable,
                                                    transaction,
                                                    fact.callCallee)
    let callTargetId = CompilerCsgSemanticPredictInternId(semanticGraph.resolvedCallTable,
                                                    transaction,
                                                    fact.callTarget)
    let callTargetSourcePathId = CompilerCsgSemanticPredictInternId(semanticGraph.resolvedCallTable,
                                                             transaction,
                                                             fact.callTargetSourcePath)
    let callArgsTextId = CompilerCsgSemanticPredictInternId(semanticGraph.resolvedCallTable,
                                                      transaction,
                                                      fact.callArgsText)
    let hashValue = CompilerCsgSemanticResolvedCallHash(
        sourceIndex, fact.originParserNodeId)
    transaction.resolvedOriginParserNodeIds[transactionIndex] =
        fact.originParserNodeId
    transaction.resolvedSourcePathIds[transactionIndex] = sourcePathId
    transaction.resolvedCallQualifierIds[transactionIndex] = callQualifierId
    transaction.resolvedCallCalleeIds[transactionIndex] = callCalleeId
    transaction.resolvedCallTargetIds[transactionIndex] = callTargetId
    transaction.resolvedCallTargetSourcePathIds[transactionIndex] =
        callTargetSourcePathId
    transaction.resolvedCallArgsTextIds[transactionIndex] = callArgsTextId
    transaction.resolvedHashValues[transactionIndex] = hashValue
    transaction.resolvedContentCertificates[transactionIndex] =
        CompilerCsgSemanticResolvedFactContentCertificate(sourceIndex,
                                                    functionIndex,
                                                    fact)
    var overlayRow = CompilerCsgSparseIntIndexFind(transaction.resolvedOverlayHashIndex,
                                                   hashValue)
    if overlayRow < 0:
        var touchedCounter: int64
        let liveBucketRow = CompilerCsgSemanticResolvedHashFindCertified(accumulator.resolvedCallSet,
                                                                  hashValue,
                                                                  touchedCounter,
                                                                  err)
        transaction.validationTouchedRowVisitCount =
            transaction.validationTouchedRowVisitCount + touchedCounter
        if liveBucketRow == -2:
            return false
        let oldCount = transaction.resolvedOverlayHashIndex.keys.len
        overlayRow = CompilerCsgSparseIntIndexEnsure(transaction.resolvedOverlayHashIndex,
                                                     hashValue)
        if overlayRow != oldCount:
            err = " compiler csg: resolved-call overlay insertion conflict"
            return false
        add(transaction.resolvedOverlayHeads,
            liveBucketRow >= 0 ? accumulator.resolvedCallSet.bucketHeads[liveBucketRow] : -1)
    if overlayRow < 0 || overlayRow >= transaction.resolvedOverlayHeads.len:
        err = " compiler csg: resolved-call overlay row missing"
        return false
    let liveRowCount = semanticGraph.resolvedCallTable.sourceIndexes.len
    var rowIndex = transaction.resolvedOverlayHeads[overlayRow]
    var visited: int32
    while rowIndex >= 0:
        if rowIndex < liveRowCount:
            if rowIndex >= accumulator.resolvedCallRowCertificates.len ||
               rowIndex >= accumulator.resolvedCallSet.nextIndexes.len ||
               rowIndex >= accumulator.resolvedCallSet.nextCertificates.len:
                err = Fmt" compiler csg: resolved-call touched row missing row={rowIndex}"
                return false
            transaction.validationTouchedRowVisitCount =
                transaction.validationTouchedRowVisitCount + Int64(2)
            if accumulator.resolvedCallRowCertificates[rowIndex] !=
               CompilerCsgSemanticResolvedCallRowCertificate(semanticGraph.resolvedCallTable, rowIndex) ||
               accumulator.resolvedCallSet.nextCertificates[rowIndex] !=
               CompilerCsgSemanticResolvedNextCertificate(rowIndex,
                   accumulator.resolvedCallSet.nextIndexes[rowIndex]):
                err = Fmt" compiler csg: resolved-call touched row certificate mismatch row={rowIndex}"
                return false
            let identityMatches =
                semanticGraph.resolvedCallTable.sourceIndexes[rowIndex] ==
                    sourceIndex &&
                semanticGraph.resolvedCallTable.originParserNodeIds[rowIndex] ==
                    fact.originParserNodeId
            if CompilerCsgSemanticResolvedCallRowMatchesFact(semanticGraph.resolvedCallTable,
                                                       rowIndex,
                                                       sourceIndex,
                                                       functionIndex,
                                                       fact,
                                                       sourcePathId,
                                                       callQualifierId,
                                                       callCalleeId,
                                                       callTargetId,
                                                       callTargetSourcePathId,
                                                       callArgsTextId):
                err = ""
                return true
            if identityMatches:
                err = Fmt" compiler csg: resolved-call exact parser origin content conflict source_index={sourceIndex} origin={fact.originParserNodeId}"
                return false
            rowIndex = accumulator.resolvedCallSet.nextIndexes[rowIndex]
        else:
            let stagedRow = rowIndex - liveRowCount
            if stagedRow < 0 ||
               stagedRow >= transaction.resolvedAppendTransactionIndexes.len:
                err = Fmt" compiler csg: resolved-call staged chain missing row={stagedRow}"
                return false
            let stagedTransactionIndex =
                transaction.resolvedAppendTransactionIndexes[stagedRow]
            if stagedTransactionIndex < 0 ||
               stagedTransactionIndex >= transaction.factIndexes.len:
                err = Fmt" compiler csg: resolved-call staged transaction missing row={stagedRow}"
                return false
            let identityMatches =
                transaction.sourceIndexes[stagedTransactionIndex] ==
                    sourceIndex &&
                transaction.resolvedOriginParserNodeIds[
                    stagedTransactionIndex] == fact.originParserNodeId
            if CompilerCsgSemanticResolvedStagedRowMatchesFact(transaction,
                                                         stagedRow,
                                                         fact,
                                                         sourceIndex,
                                                         functionIndex,
                                                         sourcePathId,
                                                         callQualifierId,
                                                         callCalleeId,
                                                         callTargetId,
                                                         callTargetSourcePathId,
                                                         callArgsTextId):
                err = ""
                return true
            if identityMatches:
                err = Fmt" compiler csg: staged resolved-call exact parser origin content conflict source_index={sourceIndex} origin={fact.originParserNodeId}"
                return false
            if stagedRow >= transaction.resolvedOverlayNext.len:
                err = Fmt" compiler csg: resolved-call staged chain missing row={stagedRow}"
                return false
            rowIndex = transaction.resolvedOverlayNext[stagedRow]
        visited = visited + 1
        if visited > liveRowCount + transaction.resolvedAppendTransactionIndexes.len:
            err = " compiler csg: resolved-call staged chain cycle"
            return false
    let stagedRow = transaction.resolvedAppendTransactionIndexes.len
    add(transaction.resolvedAppendTransactionIndexes, transactionIndex)
    add(transaction.resolvedOverlayNext, transaction.resolvedOverlayHeads[overlayRow])
    transaction.resolvedOverlayHeads[overlayRow] = liveRowCount + stagedRow
    transaction.resolvedAppendFlags[transactionIndex] = true
    err = ""
    return true

fn CompilerCsgSemanticTypedFactTransactionValidateRange(semanticGraph: var CompilerCsgSemanticGraph,
                                                   accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                                   sourceIndexCache: var CompilerCsgSourcePathIndex,
                                                   reachableSet: var CompilerCsgReachableFunctionSet,
                                                   functionIndex: int32,
                                                   facts: var TypedExprFactTable,
                                                   factStartRaw: int32,
                                                   factEndRaw: int32,
                                                   transaction: var CompilerCsgSemanticTypedFactTransaction,
                                                   semanticDigest: var int64,
                                                   err: var str): bool =
    if !accumulator.active || semanticGraph.resolvedCallTable.internPool == nil:
        err = " compiler csg: typed-fact accumulator inactive"
        return false
    if transaction.factIndexes.len != transaction.sourceIndexes.len ||
       transaction.factIndexes.len != transaction.functionIndexes.len ||
       transaction.factIndexes.len != transaction.resolvedAppendFlags.len ||
       transaction.factIndexes.len != transaction.resolvedOriginParserNodeIds.len ||
       transaction.factIndexes.len != transaction.resolvedSourcePathIds.len ||
       transaction.factIndexes.len != transaction.resolvedCallQualifierIds.len ||
       transaction.factIndexes.len != transaction.resolvedCallCalleeIds.len ||
       transaction.factIndexes.len != transaction.resolvedCallTargetIds.len ||
       transaction.factIndexes.len != transaction.resolvedCallTargetSourcePathIds.len ||
       transaction.factIndexes.len != transaction.resolvedCallArgsTextIds.len ||
       transaction.factIndexes.len != transaction.resolvedHashValues.len ||
       transaction.factIndexes.len != transaction.resolvedContentCertificates.len:
        err = Fmt" compiler csg: typed-fact staging columns mismatch facts={transaction.factIndexes.len} sources={transaction.sourceIndexes.len} functions={transaction.functionIndexes.len}"
        return false
    if !transaction.stateValidated:
        if !CompilerCsgSemanticTypedFactAccumulatorStateValidate(semanticGraph,
                                                           accumulator,
                                                           reachableSet,
                                                           transaction.validationFullRowVisitCount,
                                                           err):
            return false
        transaction.stateValidated = true
    if factStartRaw < 0 || factEndRaw < factStartRaw || factEndRaw > facts.count:
        err = Fmt" compiler csg: typed-fact range invalid start={factStartRaw} end={factEndRaw} fact_count={facts.count}"
        return false
    let factStart = factStartRaw
    let factEnd = factEndRaw
    if !CompilerCsgSemanticTypedFactTransactionValidateRangeRec(
           semanticGraph,
           accumulator,
           sourceIndexCache,
           reachableSet,
           functionIndex,
           facts,
           factStart,
           factEnd,
           factStart,
           CompilerCsgTypedFactSemanticDigestSeed(),
           transaction,
           semanticDigest,
           err):
        return false
    err = ""
    return true

@borrows
fn CompilerCsgSemanticTypedFactTransactionValidateRangeRec(
        semanticGraph: var CompilerCsgSemanticGraph,
        accumulator: var CompilerCsgSemanticTypedFactAccumulator,
        sourceIndexCache: var CompilerCsgSourcePathIndex,
        reachableSet: var CompilerCsgReachableFunctionSet,
        functionIndex: int32,
        facts: var TypedExprFactTable,
        factStart: int32,
        factEnd: int32,
        i: int32,
        digest: int64,
        transaction: var CompilerCsgSemanticTypedFactTransaction,
        semanticDigest: var int64,
        err: var str): bool =
    while true:
        if i >= factEnd:
            semanticDigest = CompilerCsgTypedFactSemanticDigestFinalize(
                digest, factEnd - factStart)
            return true
        let factRowI = texpr.TypedExprFactAt(facts, i)
        let nextSemanticDigest = CompilerCsgTypedFactSemanticDigestUpdate(
            digest, factRowI)
        if i % 1024 == 0:
            os.ProcessResourceGuardCheck()
        let sourceIndex = CompilerCsgSemanticFindSourceIndex(
            sourceIndexCache, factRowI.sourcePath)
        if sourceIndex < 0:
            err = Fmt" compiler csg: typed-fact source missing index={i} source={factRowI.sourcePath}"
            return false
        let resolvedCallSnapshot = CompilerCsgTypedFactIsResolvedCallSnapshot(factRowI)
        let resolvedImportcCall = resolvedCallSnapshot &&
                                  (factRowI.callTargetImportc ||
                                   factRowI.surfaceCallKind == texpr.TypedExprSurfaceCallImportc)
        if resolvedCallSnapshot && functionIndex < 0:
            err = Fmt" compiler csg: resolved call owner function missing source={factRowI.sourcePath}:{factRowI.lineNumber}"
            return false
        if resolvedCallSnapshot &&
           functionIndex >= reachableSet.functionNames.len:
            err = Fmt" compiler csg: resolved call owner function out of range function_index={functionIndex} function_count={reachableSet.functionNames.len} source={factRowI.sourcePath}:{factRowI.lineNumber}"
            return false
        if resolvedCallSnapshot:
            let ownerMatches =
                CompilerCsgReachableFunctionLineMatchesDelta(reachableSet,
                                                              functionIndex,
                                                              factRowI.sourcePath,
                                                              factRowI.lineNumber,
                                                              transaction.reachabilityProbeDelta)
            if transaction.reachabilityProbeDelta.contentCertificateViolation:
                err = Fmt" compiler csg: resolved call owner content certificate mismatch function_index={functionIndex} source={factRowI.sourcePath}:{factRowI.lineNumber}"
                return false
            if !ownerMatches:
                err = Fmt" compiler csg: resolved call owner function mismatch function_index={functionIndex} source={factRowI.sourcePath}:{factRowI.lineNumber}"
                return false
        if CompilerCsgTypedFactIsReachabilityExecutableCall(factRowI) &&
           !resolvedImportcCall &&
           !CompilerCsgValidateTypedFactExecutableTarget(reachableSet,
                                                          sourceIndexCache,
                                                          factRowI,
                                                          true,
                                                          transaction.reachabilityProbeDelta,
                                                          err):
            return false
        if resolvedImportcCall:
            if factRowI.surfaceCallKind == texpr.TypedExprSurfaceCallImportc &&
               !factRowI.callTargetImportc:
                err = Fmt" compiler csg: importc surface/target flag mismatch source={factRowI.sourcePath}:{factRowI.lineNumber}"
                return false
            if !factRowI.callResolved:
                err = Fmt" compiler csg: importc call unresolved source={factRowI.sourcePath}:{factRowI.lineNumber}"
                return false
            if factRowI.lineNumber <= 0:
                err = Fmt" compiler csg: resolved importc call line invalid source={factRowI.sourcePath}:{factRowI.lineNumber}"
                return false
            if factRowI.callReason != texpr.TypedExprCallReasonNone:
                err = Fmt" compiler csg: resolved importc call reason is not none reason={factRowI.callReason} source={factRowI.sourcePath}:{factRowI.lineNumber}"
                return false
            if factRowI.callCallee == "" || factRowI.callTarget == "":
                err = Fmt" compiler csg: resolved importc call target empty source={factRowI.sourcePath}:{factRowI.lineNumber}"
                return false
            if factRowI.callTargetSourcePath == "" ||
               CompilerCsgSemanticFindSourceIndex(sourceIndexCache,
                                            factRowI.callTargetSourcePath) < 0:
                err = Fmt" compiler csg: resolved importc call target source missing target={factRowI.callTarget} target_source={factRowI.callTargetSourcePath} source={factRowI.sourcePath}:{factRowI.lineNumber}"
                return false
        let transactionIndex = transaction.factIndexes.len
        add(transaction.factIndexes, i)
        add(transaction.sourceIndexes, sourceIndex)
        add(transaction.functionIndexes, functionIndex)
        add(transaction.resolvedAppendFlags, false)
        add(transaction.resolvedOriginParserNodeIds, -1)
        add(transaction.resolvedSourcePathIds, -1)
        add(transaction.resolvedCallQualifierIds, -1)
        add(transaction.resolvedCallCalleeIds, -1)
        add(transaction.resolvedCallTargetIds, -1)
        add(transaction.resolvedCallTargetSourcePathIds, -1)
        add(transaction.resolvedCallArgsTextIds, -1)
        add(transaction.resolvedHashValues, -1)
        add(transaction.resolvedContentCertificates, Int64(0))
        if resolvedCallSnapshot && factRowI.lineNumber > 0 && factRowI.callResolved:
            if !CompilerCsgSemanticTypedFactTransactionStageResolvedCall(semanticGraph,
                                                                   accumulator,
                                                                   sourceIndex,
                                                                   functionIndex,
                                                                   factRowI,
                                                                   transactionIndex,
                                                                   transaction,
                                                                   err):
                return false
        if transaction.reachabilityProbeDelta.contentCertificateViolation:
            err = " compiler csg: typed-fact touched reachable certificate mismatch"
            return false
        digest = nextSemanticDigest
        i = i + 1
        continue

@borrows
fn CompilerCsgSemanticTypedFactTransactionCommitRangeRec(
        semanticGraph: var CompilerCsgSemanticGraph,
        accumulator: var CompilerCsgSemanticTypedFactAccumulator,
        facts: var TypedExprFactTable,
        transaction: var CompilerCsgSemanticTypedFactTransaction,
        transactionIndex: int32,
        transactionEnd: int32) =
    while true:
        if transactionIndex >= transactionEnd:
            return
        if transactionIndex % 1024 == 0:
            os.ProcessResourceGuardCheck()
        let factIndex = transaction.factIndexes[transactionIndex]
        if factIndex < 0 || factIndex >= facts.count:
            panic("compiler csg: typed-fact transaction fact index invalid")
        let sourceIndex = transaction.sourceIndexes[transactionIndex]
        let functionIndex = transaction.functionIndexes[transactionIndex]
        let factRowI = texpr.TypedExprFactAt(facts, factIndex)
        let typedFactRow = semanticGraph.typedFactTable.sourceIndexes.len
        CompilerCsgSemanticAppendTypedFactSemanticSnapshotRow(
            semanticGraph.typedFactTable,
            sourceIndex,
            functionIndex,
            factRowI)
        add(accumulator.typedFactRowCertificates,
            CompilerCsgSemanticTypedFactRowCertificate(
                semanticGraph.typedFactTable, typedFactRow))
        accumulator.validationAppendedRowVisitCount =
            accumulator.validationAppendedRowVisitCount + Int64(1)
        accumulator.stateVersion = accumulator.stateVersion + Int64(1)
        CompilerCsgSemanticAccumulateTypedFactSummary(
            semanticGraph.typedFactTable.summary,
            accumulator.loweringRuleShapes,
            accumulator.loweringRuleKeys,
            factRowI)
        if transaction.resolvedAppendFlags[transactionIndex]:
            let sourcePathId = langintern.Intern(
                semanticGraph.resolvedCallTable.internPool,
                strings.CloneStr(factRowI.sourcePath))
            let callQualifierId = langintern.Intern(
                semanticGraph.resolvedCallTable.internPool,
                strings.CloneStr(factRowI.callQualifier))
            let callCalleeId = langintern.Intern(
                semanticGraph.resolvedCallTable.internPool,
                strings.CloneStr(factRowI.callCallee))
            let callTargetId = langintern.Intern(
                semanticGraph.resolvedCallTable.internPool,
                strings.CloneStr(factRowI.callTarget))
            let callTargetSourcePathId = langintern.Intern(
                semanticGraph.resolvedCallTable.internPool,
                strings.CloneStr(factRowI.callTargetSourcePath))
            let callArgsTextId = langintern.Intern(
                semanticGraph.resolvedCallTable.internPool,
                strings.CloneStr(factRowI.callArgsText))
            if sourcePathId != transaction.resolvedSourcePathIds[transactionIndex] ||
               factRowI.originParserNodeId !=
                   transaction.resolvedOriginParserNodeIds[transactionIndex] ||
               callQualifierId !=
                   transaction.resolvedCallQualifierIds[transactionIndex] ||
               callCalleeId !=
                   transaction.resolvedCallCalleeIds[transactionIndex] ||
               callTargetId !=
                   transaction.resolvedCallTargetIds[transactionIndex] ||
               callTargetSourcePathId !=
                   transaction.resolvedCallTargetSourcePathIds[transactionIndex] ||
               callArgsTextId !=
                   transaction.resolvedCallArgsTextIds[transactionIndex]:
                panic("compiler csg: resolved-call predicted intern id drift")
            CompilerCsgSemanticAppendResolvedCallFactCommitted(
                semanticGraph.resolvedCallTable,
                accumulator,
                sourceIndex,
                functionIndex,
                factRowI,
                sourcePathId,
                callQualifierId,
                callCalleeId,
                callTargetId,
                callTargetSourcePathId,
                callArgsTextId,
                transaction.resolvedHashValues[transactionIndex])
            accumulator.validationAppendedRowVisitCount =
                accumulator.validationAppendedRowVisitCount + Int64(1)
        if factRowI.typeCallKind == texpr.TypedExprTypeCallDefaultInit:
            semanticGraph.typedFactTable.typeCallDefaultInitCount =
                semanticGraph.typedFactTable.typeCallDefaultInitCount + 1
        elif factRowI.typeCallKind == texpr.TypedExprTypeCallConstructor:
            semanticGraph.typedFactTable.typeCallConstructorCount =
                semanticGraph.typedFactTable.typeCallConstructorCount + 1
        transactionIndex = transactionIndex + 1
        continue

fn CompilerCsgSemanticTypedFactTransactionCommitRange(semanticGraph: var CompilerCsgSemanticGraph,
                                                  accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                                  facts: var TypedExprFactTable,
                                                  transaction: var CompilerCsgSemanticTypedFactTransaction,
                                                  transactionStart: int32,
                                                  transactionEnd: int32) =
    if transaction.factIndexes.len != transaction.sourceIndexes.len ||
       transaction.factIndexes.len != transaction.functionIndexes.len ||
       transactionStart < 0 || transactionEnd < transactionStart ||
       transactionEnd > transaction.factIndexes.len:
        panic("compiler csg: typed-fact transaction columns corrupt")
    CompilerCsgSemanticTypedFactTransactionCommitRangeRec(
        semanticGraph, accumulator, facts, transaction,
        transactionStart, transactionEnd)

@borrows
fn CompilerCsgSemanticTypedFactTransactionCapacityBytes(transaction: CompilerCsgSemanticTypedFactTransaction): int64 =
    return CompilerCsgSequenceHeaderBytes() * Int64(16) +
           Int64(transaction.factIndexes.cap + transaction.sourceIndexes.cap +
                 transaction.functionIndexes.cap +
                 transaction.resolvedOriginParserNodeIds.cap +
                 transaction.resolvedSourcePathIds.cap +
                 transaction.resolvedCallQualifierIds.cap +
                 transaction.resolvedCallCalleeIds.cap +
                 transaction.resolvedCallTargetIds.cap +
                 transaction.resolvedCallTargetSourcePathIds.cap +
                 transaction.resolvedCallArgsTextIds.cap +
                 transaction.resolvedHashValues.cap +
                 transaction.resolvedOverlayHeads.cap +
                 transaction.resolvedOverlayNext.cap +
                 transaction.resolvedAppendTransactionIndexes.cap) *
               CompilerCsgI32Bytes() +
           Int64(transaction.resolvedAppendFlags.cap) * CompilerCsgBoolBytes() +
           Int64(transaction.resolvedContentCertificates.cap) * Int64(8) +
           CompilerCsgStringSequenceCapacityBytesShallow(transaction.predictedInternTexts) +
           CompilerCsgHashMapStrIntCapacityBytesShallow(share(transaction.predictedInternIndex)) +
           CompilerCsgSparseIntIndexCapacityBytes(share(transaction.resolvedOverlayHashIndex))

fn CompilerCsgSemanticTypedFactTransactionCommitMetrics(accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                                    transaction: var CompilerCsgSemanticTypedFactTransaction) =
    let stagedFactCount = transaction.factIndexes.len
    var phase: CompilerCsgStagingCapacityLedger
    phase.typedFactTransactionBytes =
        CompilerCsgSemanticTypedFactTransactionCapacityBytes(transaction)
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger, phase)
    var ledgerErr: str
    if !CompilerCsgStagingCapacityLedgerValidate(transaction.ledger, ledgerErr):
        panic(ledgerErr)
    accumulator.transactionCommittedBatchCount =
        accumulator.transactionCommittedBatchCount + Int64(1)
    accumulator.transactionCommittedFactCount =
        accumulator.transactionCommittedFactCount + Int64(stagedFactCount)
    accumulator.validationFullRowVisitCount =
        accumulator.validationFullRowVisitCount +
            transaction.validationFullRowVisitCount
    accumulator.validationTouchedRowVisitCount =
        accumulator.validationTouchedRowVisitCount +
            transaction.validationTouchedRowVisitCount
    accumulator.validatedTypedFactPrefix =
        accumulator.typedFactRowCertificates.len
    accumulator.validatedResolvedCallPrefix =
        accumulator.resolvedCallRowCertificates.len
    accumulator.validatedVersion = accumulator.stateVersion
    accumulator.resolvedCallSet.sealedVersion =
        accumulator.resolvedCallSet.version
    if stagedFactCount > accumulator.transactionMaxStagedFactCount:
        accumulator.transactionMaxStagedFactCount = stagedFactCount
    if transaction.ledger.phasePeakBytes > accumulator.transactionMaxStagedCapacity:
        accumulator.transactionMaxStagedCapacity = transaction.ledger.phasePeakBytes
    accumulator.transactionLastStagingCapacityLedger = transaction.ledger

fn CompilerCsgSemanticTypedFactAccumulatorAppendWithDigest(semanticGraph: var CompilerCsgSemanticGraph,
                                                     accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                                     sourceIndexCache: var CompilerCsgSourcePathIndex,
                                                     reachableSet: var CompilerCsgReachableFunctionSet,
                                                     functionIndex: int32,
                                                     facts: var TypedExprFactTable,
                                                     factStartRaw: int32,
                                                     factEndRaw: int32,
                                                     semanticDigest: var int64,
                                                     err: var str): bool =
    var transaction = CompilerCsgSemanticTypedFactTransactionInit()
    var nextSemanticDigest: int64
    if !CompilerCsgSemanticTypedFactTransactionValidateRange(semanticGraph,
                                                       accumulator,
                                                       sourceIndexCache,
                                                       reachableSet,
                                                       functionIndex,
                                                       facts,
                                                       factStartRaw,
                                                       factEndRaw,
                                                       transaction,
                                                       nextSemanticDigest,
                                                       err):
        return false
    var phase: CompilerCsgStagingCapacityLedger
    phase.typedFactTransactionBytes =
        CompilerCsgSemanticTypedFactTransactionCapacityBytes(transaction)
    CompilerCsgStagingCapacityLedgerRecordPhase(transaction.ledger, phase)
    var ledgerErr: str
    if !CompilerCsgStagingCapacityLedgerValidate(transaction.ledger, ledgerErr):
        err = ledgerErr
        return false
    CompilerCsgSemanticTypedFactTransactionCommitRange(semanticGraph,
                                                 accumulator,
                                                 facts,
                                                 transaction,
                                                 0,
                                                 transaction.factIndexes.len)
    CompilerCsgReachabilityProbeDeltaCommit(reachableSet,
                                            transaction.reachabilityProbeDelta)
    CompilerCsgSemanticTypedFactTransactionCommitMetrics(accumulator,
                                                    transaction)
    semanticDigest = nextSemanticDigest
    err = ""
    return true

fn CompilerCsgSemanticTypedFactAccumulatorAppend(semanticGraph: var CompilerCsgSemanticGraph,
                                           accumulator: var CompilerCsgSemanticTypedFactAccumulator,
                                           sourceIndexCache: var CompilerCsgSourcePathIndex,
                                           reachableSet: var CompilerCsgReachableFunctionSet,
                                           functionIndex: int32,
                                           facts: var TypedExprFactTable,
                                           factStartRaw: int32,
                                           factEndRaw: int32,
                                           err: var str): bool =
    var semanticDigest: int64
    return CompilerCsgSemanticTypedFactAccumulatorAppendWithDigest(semanticGraph,
                                                             accumulator,
                                                             sourceIndexCache,
                                                             reachableSet,
                                                             functionIndex,
                                                             facts,
                                                             factStartRaw,
                                                             factEndRaw,
                                                             semanticDigest,
                                                             err)

fn CompilerCsgSemanticTypedFactAccumulatorFinish(semanticGraph: var CompilerCsgSemanticGraph,
                                           accumulator: var CompilerCsgSemanticTypedFactAccumulator) =
    if !accumulator.active:
        return
    langintern.InternPoolReleaseIndex(semanticGraph.resolvedCallTable.internPool)
    CompilerCsgSemanticResolvedCallSetClear(accumulator.resolvedCallSet)
    CompilerCsgSemanticLoweringRuleSetClear(accumulator.loweringRuleShapes)
    CompilerCsgSemanticLoweringRuleSetClear(accumulator.loweringRuleKeys)
    accumulator.active = false

@borrows
fn CompilerCsgSemanticCommitTypedIrRoundSemanticConservation(semanticGraph: var CompilerCsgSemanticGraph,
                                                       reachableSet: var CompilerCsgReachableFunctionSet,
                                                       frontierFunctionIndexes: int32[],
                                                       typedIrFunctionStart: int32,
                                                       ir: var texpr.TypedExprIr,
                                                       err: var str): bool =
    if typedIrFunctionStart < 0 ||
       typedIrFunctionStart + frontierFunctionIndexes.len >
           ir.functions2_functionNameIds.len ||
       ir.functions2_sourcePathIds.len != ir.functions2_functionNameIds.len ||
       arenamod.ArenaArrayInt32Len(ir.arena,
                                   ir.functions2_signatureLineNumbers) !=
           ir.functions2_functionNameIds.len:
        err = Fmt" compiler csg: typed-ir semantic round range invalid start={typedIrFunctionStart} count={frontierFunctionIndexes.len} functions={ir.functions2_functionNameIds.len}"
        return false
    if !CompilerCsgSemanticTypedFactSemanticColumnsValid(semanticGraph.typedFactTable) ||
       semanticGraph.resolvedCallTable.functionRowHeads.len !=
           reachableSet.functionNames.len:
        err = Fmt" compiler csg: semantic retained snapshot shape invalid typed_rows={semanticGraph.typedFactTable.sourceIndexes.len} resolved_heads={semanticGraph.resolvedCallTable.functionRowHeads.len} functions={reachableSet.functionNames.len}"
        return false
    var frontierMembership: CompilerCsgSparseIntIndex
    var frontierSeen: bool[]
    setLen(frontierSeen, frontierFunctionIndexes.len)
    for frontierPosition in 0..<frontierFunctionIndexes.len:
        let functionIndex = frontierFunctionIndexes[frontierPosition]
        if functionIndex < 0 ||
           functionIndex >= reachableSet.functionNames.len ||
           functionIndex >= reachableSet.sourcePaths.len ||
           functionIndex >= reachableSet.startLines.len ||
           functionIndex >= semanticGraph.exprSliceTable.functionSliceIndexes.len ||
           CompilerCsgSparseIntIndexFind(frontierMembership,
                                          functionIndex) >= 0:
            err = Fmt" compiler csg: semantic frontier identity invalid position={frontierPosition} function_index={functionIndex}"
            return false
        let insertedPosition =
            CompilerCsgSparseIntIndexEnsure(frontierMembership,
                                             functionIndex)
        if insertedPosition != frontierPosition:
            panic("compiler csg: semantic frontier index insertion drift")
    var stagedSliceIndexes: int32[]
    var stagedSemanticDigests: int64[]
    # Preflight every identity and digest before committing any validation bit.
    for typedIrOffset in 0..<frontierFunctionIndexes.len:
        let typedIrFunctionIndex = typedIrFunctionStart + typedIrOffset
        let sourcePathRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.functions2_sourcePathIds[typedIrFunctionIndex])
        let functionNameRes: Result[str] = langintern.LookupIntern(
            ir.internPool,
            ir.functions2_functionNameIds[typedIrFunctionIndex])
        if !IsOk(sourcePathRes) || !IsOk(functionNameRes):
            err = Fmt" compiler csg: typed-ir semantic identity intern miss typed_ir_index={typedIrFunctionIndex}"
            return false
        let signatureLine = arenamod.ArenaArrayInt32Get(
            ir.arena,
            ir.functions2_signatureLineNumbers,
            typedIrFunctionIndex)
        # The range builder appends one TypedIR function for each frontier row
        # in the same committed order.  That row coordinate is the identity;
        # source/name/line below only validate its payload.
        let functionIndex = frontierFunctionIndexes[typedIrOffset]
        let frontierPosition =
            CompilerCsgSparseIntIndexFind(frontierMembership,
                                           functionIndex)
        if functionIndex < 0 || frontierPosition < 0 ||
           frontierPosition != typedIrOffset ||
           frontierPosition >= frontierSeen.len ||
           frontierSeen[frontierPosition]:
            err = Fmt" compiler csg: typed-ir semantic function is outside frontier typed_ir_index={typedIrFunctionIndex} source={Value(sourcePathRes)} function={Value(functionNameRes)} line={signatureLine} resolved={functionIndex}"
            return false
        frontierSeen[frontierPosition] = true
        if Value(sourcePathRes) != reachableSet.sourcePaths[functionIndex] ||
           Value(functionNameRes) != reachableSet.functionNames[functionIndex] ||
           signatureLine != reachableSet.startLines[functionIndex]:
            err = Fmt" compiler csg: typed-ir semantic identity drift function_index={functionIndex} typed_ir_index={typedIrFunctionIndex} source={Value(sourcePathRes)} function={Value(functionNameRes)} line={signatureLine}"
            return false
        let sliceIndex =
            semanticGraph.exprSliceTable.functionSliceIndexes[functionIndex]
        if sliceIndex < 0 ||
           sliceIndex >= semanticGraph.exprSliceTable.sourceIndex.len ||
           sliceIndex >= semanticGraph.exprSliceTable.functionIndex.len ||
           sliceIndex >= semanticGraph.exprSliceTable.typedFactStart.len ||
           sliceIndex >= semanticGraph.exprSliceTable.typedFactCount.len ||
           sliceIndex >= semanticGraph.exprSliceTable.typedFactSemanticDigests.len ||
           sliceIndex >= semanticGraph.exprSliceTable.typedIrSemanticDigests.len ||
           sliceIndex >= semanticGraph.exprSliceTable.typedIrFunctionIndexes.len ||
           sliceIndex >= semanticGraph.exprSliceTable.semanticValidated.len:
            err = Fmt" compiler csg: typed-ir semantic slice columns corrupt slice_index={sliceIndex}"
            return false
        if semanticGraph.exprSliceTable.functionIndex[sliceIndex] != functionIndex:
            err = Fmt" compiler csg: typed-ir semantic slice owner mismatch slice_index={sliceIndex} expected_function={functionIndex} actual_function={semanticGraph.exprSliceTable.functionIndex[sliceIndex]}"
            return false
        let factStart = semanticGraph.exprSliceTable.typedFactStart[sliceIndex]
        let factEnd = factStart +
                      semanticGraph.exprSliceTable.typedFactCount[sliceIndex]
        var digestErr: str
        let retainedDigest =
            CompilerCsgSemanticTypedFactSemanticSnapshotDigestRange(
                semanticGraph.typedFactTable,
                factStart,
                factEnd,
                semanticGraph.exprSliceTable.sourceIndex[sliceIndex],
                functionIndex,
                digestErr)
        if digestErr != "":
            err = digestErr
            return false
        if semanticGraph.exprSliceTable.typedFactSemanticDigests[sliceIndex] !=
           retainedDigest:
            err = Fmt" compiler csg: typed-ir semantic digest mismatch function_index={functionIndex} slice_index={sliceIndex}"
            return false
        if semanticGraph.exprSliceTable.typedIrFunctionIndexes[sliceIndex] >= 0 ||
           semanticGraph.exprSliceTable.semanticValidated[sliceIndex]:
            err = Fmt" compiler csg: typed-ir semantic slice committed twice function_index={functionIndex} slice_index={sliceIndex}"
            return false
        add(stagedSliceIndexes, sliceIndex)
        add(stagedSemanticDigests, retainedDigest)
    for frontierPosition in 0..<frontierSeen.len:
        if !frontierSeen[frontierPosition]:
            err = Fmt" compiler csg: typed-ir semantic frontier function missing position={frontierPosition} function_index={frontierFunctionIndexes[frontierPosition]}"
            return false
    for stagedIndex in 0..<stagedSliceIndexes.len:
        let sliceIndex = stagedSliceIndexes[stagedIndex]
        semanticGraph.exprSliceTable.typedIrSemanticDigests[sliceIndex] =
            stagedSemanticDigests[stagedIndex]
        semanticGraph.exprSliceTable.typedIrFunctionIndexes[sliceIndex] =
            typedIrFunctionStart + stagedIndex
        semanticGraph.exprSliceTable.semanticValidated[sliceIndex] = true
    err = ""
    return true

fn CompilerCsgSemanticValidateTypedFactSemanticConservation(semanticGraph: var CompilerCsgSemanticGraph,
                                                       ir: var texpr.TypedExprIr,
                                                       err: var str): bool =
    semanticGraph.typedFactSemanticConservationProved = false
    semanticGraph.typedFactSemanticSliceCount = semanticGraph.exprSliceTable.sourceIndex.len
    semanticGraph.typedFactSemanticValidatedSliceCount = 0
    let sliceCount = semanticGraph.exprSliceTable.sourceIndex.len
    if !CompilerCsgSemanticTypedFactSemanticColumnsValid(semanticGraph.typedFactTable) ||
       semanticGraph.exprSliceTable.sourcePaths.len != sliceCount ||
       semanticGraph.exprSliceTable.functionIndex.len != sliceCount ||
       semanticGraph.exprSliceTable.exprStart.len != sliceCount ||
       semanticGraph.exprSliceTable.exprCount.len != sliceCount ||
       semanticGraph.exprSliceTable.typedFactStart.len != sliceCount ||
       semanticGraph.exprSliceTable.typedFactCount.len != sliceCount ||
       semanticGraph.exprSliceTable.typedFactSemanticDigests.len != sliceCount ||
       semanticGraph.exprSliceTable.typedIrSemanticDigests.len != sliceCount ||
       semanticGraph.exprSliceTable.typedIrFunctionIndexes.len != sliceCount ||
       semanticGraph.exprSliceTable.semanticValidated.len != sliceCount:
        err = Fmt" compiler csg: semantic slice columns mismatch slices={sliceCount} expected_digests={semanticGraph.exprSliceTable.typedFactSemanticDigests.len} observed_digests={semanticGraph.exprSliceTable.typedIrSemanticDigests.len} typed_ir_indexes={semanticGraph.exprSliceTable.typedIrFunctionIndexes.len} validated={semanticGraph.exprSliceTable.semanticValidated.len}"
        return false
    for sliceIndex in 0..<sliceCount:
        if sliceIndex % 1024 == 0:
            os.ProcessResourceGuardCheck()
        let functionIndex = semanticGraph.exprSliceTable.functionIndex[sliceIndex]
        let typedIrFunctionIndex =
            semanticGraph.exprSliceTable.typedIrFunctionIndexes[sliceIndex]
        if functionIndex < 0 ||
           functionIndex >= semanticGraph.reachableFunctionTable.functionNames.len ||
           functionIndex >= semanticGraph.reachableFunctionTable.sourceIndex.len ||
           functionIndex >= semanticGraph.exprSliceTable.functionSliceIndexes.len ||
           semanticGraph.exprSliceTable.functionSliceIndexes[functionIndex] != sliceIndex ||
           typedIrFunctionIndex < 0 ||
           typedIrFunctionIndex >= semanticGraph.typedIrTable.functionNames.len ||
           typedIrFunctionIndex >= semanticGraph.typedIrTable.functionSourceIndexes.len ||
           typedIrFunctionIndex >= ir.functions2_functionNameIds.len:
            err = Fmt" compiler csg: semantic slice identity invalid slice_index={sliceIndex} function_index={functionIndex} typed_ir_index={typedIrFunctionIndex}"
            return false
        let factStart = semanticGraph.exprSliceTable.typedFactStart[sliceIndex]
        let factEnd = factStart +
                      semanticGraph.exprSliceTable.typedFactCount[sliceIndex]
        var digestErr: str
        let retainedDigest =
            CompilerCsgSemanticTypedFactSemanticSnapshotDigestRange(
                semanticGraph.typedFactTable,
                factStart,
                factEnd,
                semanticGraph.exprSliceTable.sourceIndex[sliceIndex],
                functionIndex,
                digestErr)
        if digestErr != "":
            err = digestErr
            return false
        if !semanticGraph.exprSliceTable.semanticValidated[sliceIndex] ||
           semanticGraph.exprSliceTable.typedFactSemanticDigests[sliceIndex] !=
               retainedDigest ||
           semanticGraph.exprSliceTable.typedIrSemanticDigests[sliceIndex] !=
               retainedDigest ||
           semanticGraph.typedIrTable.functionSourceIndexes[typedIrFunctionIndex] !=
               semanticGraph.reachableFunctionTable.sourceIndex[functionIndex] ||
           semanticGraph.typedIrTable.functionNames[typedIrFunctionIndex] !=
               semanticGraph.reachableFunctionTable.functionNames[functionIndex]:
            err = Fmt" compiler csg: semantic conservation failed slice_index={sliceIndex} function_index={functionIndex} typed_ir_index={typedIrFunctionIndex}"
            return false
        semanticGraph.typedFactSemanticValidatedSliceCount =
            semanticGraph.typedFactSemanticValidatedSliceCount + 1
    semanticGraph.typedFactSemanticConservationProved =
        semanticGraph.typedFactSemanticValidatedSliceCount ==
            semanticGraph.typedFactSemanticSliceCount
    if !semanticGraph.typedFactSemanticConservationProved:
        err = Fmt" compiler csg: semantic conservation incomplete slices={semanticGraph.typedFactSemanticSliceCount} validated={semanticGraph.typedFactSemanticValidatedSliceCount}"
        return false
    err = ""
    return true

fn CompilerCsgSemanticBuildTypedIrTable(semanticGraph: var CompilerCsgSemanticGraph,
                                  sources: var str[],
                                  sourceIndexCache: var CompilerCsgSourcePathIndex,
                                  ir: var texpr.TypedExprIr,
                                  err: var str): bool =
    semanticGraph.typedIrTable = CompilerCsgSemanticTypedIrTable()
    let functionCount = ir.functions2_functionNameIds.len
    let nodeStartCount = arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_nodeStarts)
    let nodeCountCount = arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_nodeCounts)
    let statementStartCount = arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_statementStarts)
    let statementCountCount = arenamod.ArenaArrayInt32Len(ir.arena, ir.functions2_statementCounts)
    if ir.functions2_sourcePathIds.len != functionCount ||
       nodeStartCount != functionCount ||
       nodeCountCount != functionCount ||
       statementStartCount != functionCount ||
       statementCountCount != functionCount:
        err = Fmt" compiler csg: typed-ir function columns corrupt functions={functionCount} sources={ir.functions2_sourcePathIds.len} node_starts={nodeStartCount} node_counts={nodeCountCount} statement_starts={statementStartCount} statement_counts={statementCountCount}"
        return false
    let totalNodeCount = arenamod.ArenaArrayInt32Len(ir.arena, ir.nodes2_nodeIndexs)
    let totalStatementCount = arenamod.ArenaArrayInt32Len(ir.arena, ir.statements2_statementIndexs)
    var reachableForTyped: int32[]
    setLen(reachableForTyped, functionCount)
    for typedFunctionIndex in 0..<functionCount:
        reachableForTyped[typedFunctionIndex] = -1
    for sliceIndex in 0..<semanticGraph.exprSliceTable.functionIndex.len:
        if sliceIndex >= semanticGraph.exprSliceTable.typedIrFunctionIndexes.len:
            err = " compiler csg: typed-ir graph identity slice is missing"
            return false
        let typedFunctionIndex =
            semanticGraph.exprSliceTable.typedIrFunctionIndexes[sliceIndex]
        let reachableFunctionIndex =
            semanticGraph.exprSliceTable.functionIndex[sliceIndex]
        if typedFunctionIndex < 0 || typedFunctionIndex >= functionCount ||
           reachableFunctionIndex < 0 ||
           reachableFunctionIndex >=
               semanticGraph.reachableFunctionTable.functionNames.len ||
           reachableForTyped[typedFunctionIndex] >= 0:
            err = " compiler csg: typed-ir graph identity is not bijective"
            return false
        reachableForTyped[typedFunctionIndex] = reachableFunctionIndex
    var graphNodeSeen: bool[]
    setLen(graphNodeSeen, semanticGraph.reachableFunctionTable.functionNames.len)
    for i in 0..<functionCount:
        if i % 1024 == 0:
            os.ProcessResourceGuardCheck()
        let sourcePathRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_sourcePathIds[i])
        let functionNameRes: Result[str] = langintern.LookupIntern(ir.internPool, ir.functions2_functionNameIds[i])
        if !IsOk(sourcePathRes) || !IsOk(functionNameRes):
            err = Fmt" compiler csg: typed-ir identity lookup failed index={i}"
            return false
        let semanticSourcePathText = Value(sourcePathRes)
        let sourceIndex = CompilerCsgSemanticFindSourceIndex(sourceIndexCache, semanticSourcePathText)
        if sourceIndex < 0:
            err = Fmt" compiler csg: typed-ir source missing index={i} source={semanticSourcePathText}"
            return false
        let nodeStart = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeStarts, i)
        let nodeCount = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_nodeCounts, i)
        let statementStart = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementStarts, i)
        let statementCount = arenamod.ArenaArrayInt32Get(ir.arena, ir.functions2_statementCounts, i)
        let signatureLine = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.functions2_signatureLineNumbers, i)
        let reachableFunctionIndex = reachableForTyped[i]
        let resultExprClass = ir.functions2_resultExprClasses[i]
        let borrowsArguments = ir.functions2_borrowsArguments[i]
        let resultAnnotationFlags =
            reachableFunctionIndex < 0 ||
            reachableFunctionIndex >=
                semanticGraph.reachableFunctionTable.functionAnnotationFlags.len ?
                -1 :
                semanticGraph.reachableFunctionTable.functionAnnotationFlags[
                    reachableFunctionIndex]
        let expectedResultExprClass =
            (resultAnnotationFlags &
                parser.ParserFunctionAnnotationBorrowResult) != 0 ?
                texpr.TypedExprExprBorrowed :
                texpr.TypedExprExprOwned
        let expectedBorrowsArguments =
            (resultAnnotationFlags &
                parser.ParserFunctionAnnotationBorrows) != 0
        if nodeStart < 0 || nodeCount < 0 || nodeStart > totalNodeCount - nodeCount ||
           statementStart < 0 || statementCount < 0 ||
           statementStart > totalStatementCount - statementCount ||
           reachableFunctionIndex < 0 ||
           reachableFunctionIndex >=
               semanticGraph.reachableFunctionTable.functionNames.len ||
           graphNodeSeen[reachableFunctionIndex] ||
           semanticGraph.reachableFunctionTable.functionNames[reachableFunctionIndex] !=
               Value(functionNameRes) ||
           semanticGraph.reachableFunctionTable.sourceIndex[reachableFunctionIndex] !=
               sourceIndex ||
           semanticGraph.reachableFunctionTable.startLines[reachableFunctionIndex] !=
               signatureLine ||
           !parser.ParserNormalizedFunctionAnnotationFlagsValid(
               resultAnnotationFlags) ||
           resultExprClass != expectedResultExprClass ||
           borrowsArguments != expectedBorrowsArguments ||
           semanticGraph.reachableFunctionTable.graphNodeIds[reachableFunctionIndex] <= 0:
            err = Fmt" compiler csg: typed-ir function graph/range identity invalid index={i} reachable_index={reachableFunctionIndex} signature_line={signatureLine} node_start={nodeStart} node_count={nodeCount} node_total={totalNodeCount} statement_start={statementStart} statement_count={statementCount} statement_total={totalStatementCount}"
            return false
        add(semanticGraph.typedIrTable.functionSourceIndexes, sourceIndex)
        add(semanticGraph.typedIrTable.functionGraphNodeIds,
            semanticGraph.reachableFunctionTable.graphNodeIds[reachableFunctionIndex])
        add(semanticGraph.typedIrTable.functionNames, Value(functionNameRes))
        add(semanticGraph.typedIrTable.functionNodeStart, nodeStart)
        add(semanticGraph.typedIrTable.functionNodeCount, nodeCount)
        add(semanticGraph.typedIrTable.functionStatementStart, statementStart)
        add(semanticGraph.typedIrTable.functionStatementCount, statementCount)
        graphNodeSeen[reachableFunctionIndex] = true
    err = ""
    return true

@borrows
fn CompilerCsgSemanticTypedFactDynamicSequenceBytes(table: CompilerCsgSemanticTypedFactTable,
                                              retainedCapacity: bool): int64 =
    var total: int64
    total = total + CompilerCsgIntArrayBytesMode(table.sourceIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(table.functionIndexes, retainedCapacity)
    total = total + CompilerCsgInt64ArrayBytesMode(table.semanticIdentityCertificates, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(table.valueKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(table.placeKinds, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(table.hasSinks, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(table.sinkPlaceKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(table.loweringModes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(table.callKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(table.typeCallKinds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(table.returnKinds, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(table.returnRoots, retainedCapacity)
    return total

@borrows
fn CompilerCsgSemanticTypedFactPhysicalBufferCount(
        table: CompilerCsgSemanticTypedFactTable): int32 =
    var count: int32
    if table.sourceIndexes.cap > 0: count = count + 1
    if table.functionIndexes.cap > 0: count = count + 1
    if table.semanticIdentityCertificates.cap > 0: count = count + 1
    if table.valueKinds.cap > 0: count = count + 1
    if table.placeKinds.cap > 0: count = count + 1
    if table.hasSinks.cap > 0: count = count + 1
    if table.sinkPlaceKinds.cap > 0: count = count + 1
    if table.loweringModes.cap > 0: count = count + 1
    if table.callKinds.cap > 0: count = count + 1
    if table.typeCallKinds.cap > 0: count = count + 1
    if table.returnKinds.cap > 0: count = count + 1
    if table.returnRoots.cap > 0: count = count + 1
    return count

fn CompilerCsgSemanticTypedFactTableTerminalReleaseWithReceipt(
        table: var CompilerCsgSemanticTypedFactTable,
        releasedBufferCount: var int32,
        releasedBytes: var int64) =
    releasedBufferCount =
        CompilerCsgSemanticTypedFactPhysicalBufferCount(table)
    releasedBytes =
        CompilerCsgSemanticTypedFactDynamicSequenceBytes(table, true)
    freeSeq(table.sourceIndexes)
    freeSeq(table.functionIndexes)
    freeSeq(table.semanticIdentityCertificates)
    freeSeq(table.valueKinds)
    freeSeq(table.placeKinds)
    freeSeq(table.hasSinks)
    freeSeq(table.sinkPlaceKinds)
    freeSeq(table.loweringModes)
    freeSeq(table.callKinds)
    freeSeq(table.typeCallKinds)
    freeSeq(table.returnKinds)
    freeSeq(table.returnRoots)
    table = CompilerCsgSemanticTypedFactTable()
    if CompilerCsgSemanticTypedFactPhysicalBufferCount(table) != 0 ||
       CompilerCsgSemanticTypedFactDynamicSequenceBytes(
           table, true) != int64(0):
        panic("compiler csg: semantic typed-fact release incomplete")

@borrows
fn compilerCsgCallOwnershipProjectionDynamicSequenceBytes(
        table: CompilerCsgCallOwnershipProjectionTable,
        retainedCapacity: bool): int64 =
    var total: int64
    total = total + CompilerCsgIntArrayBytesMode(
