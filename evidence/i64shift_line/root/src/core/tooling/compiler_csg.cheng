@borrows
fn CompilerCsgNodeReportLine(index: int32,
                               node: CompilerCsgNode): str =
    var buf = layout.ByteBufInit(256)
    CompilerCsgReportBufAppendText(buf, "node[")
    CompilerCsgReportBufAppendText(buf, IntToStr(index))
    CompilerCsgReportBufAppendText(buf, "]=")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.nodeKind))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.ownerNodeId))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, node.modulePath)
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, node.symbolText)
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, node.factText)
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "producer_source=")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.producerSourceIndex))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "producer_decl=")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.producerDeclarationIndex))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "name_surface=")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.functionNameSurfaceKind))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "name_proof=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(node.nameProofCid))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "semantic_source=")
    CompilerCsgReportBufAppendText(buf, node.semanticSource)
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "semantic_decl_line=")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.semanticDeclarationLineIndex))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "semantic_params=")
    CompilerCsgReportBufAppendText(buf, node.semanticParamTypeJoin)
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "semantic_return=")
    CompilerCsgReportBufAppendText(buf, node.semanticReturnType)
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, "semantic_signature_complete=")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.semanticSignatureComplete))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.resultLayoutKind))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.effectKind))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.capabilityKind))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.callConv))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.entryFlag))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(node.exportedFlag))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, node.exportSymbolName)
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(node.factCid))
    return CompilerCsgReportBufTakeText(buf)

@borrows
fn CompilerCsgEdgeReportLine(index: int32,
                               edge: CompilerCsgEdge): str =
    var buf = layout.ByteBufInit(128)
    CompilerCsgReportBufAppendText(buf, "edge[")
    CompilerCsgReportBufAppendText(buf, IntToStr(index))
    CompilerCsgReportBufAppendText(buf, "]=")
    CompilerCsgReportBufAppendText(buf, IntToStr(edge.edgeKind))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(edge.fromNodeId))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(edge.toNodeId))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(edge.edgeCid))
    return CompilerCsgReportBufTakeText(buf)

@borrows
fn CompilerCsgTextHex(value: str): str =
    return rawbytes.BytesToHex(rawbytes.BytesFromString(value))

@borrows
fn CompilerCsgReportBufAppendText(buf: var layout.ByteBuf,
                                  value: str) =
    layout.ByteBufAppendBytes(buf, rawbytes.BytesFromString(value))

fn CompilerCsgReportBufTakeText(buf: var layout.ByteBuf): str =
    let out = rawbytes.BytesToString(layout.ByteBufView(buf).data)
    layout.ByteBufFree(buf)
    return out

@borrows
fn CompilerCsgTextFromHexInto(value: str,
                              out: var str,
                              err: var str): bool =
    if value.len % 2 != 0:
        err = " compiler csg: hex text has odd byte count"
        return false
    for index in 0..<value.len:
        let ch = value[index]
        if !((ch >= '0' && ch <= '9') || (ch >= 'a' && ch <= 'f')):
            err = " compiler csg: hex text is not canonical lowercase hex"
            return false
    if value == "":
        out = ""
        err = ""
        return true
    var bytes = rawbytes.BytesFromHex(value)
    if rawbytes.BytesLen(bytes) * 2 != value.len:
        rawbytes.BytesFree(bytes)
        err = " compiler csg: hex text decode failed"
        return false
    out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    err = ""
    return true

@borrows
fn CompilerExportSurfaceReport(surface: CsgExportSurface): str =
    var buf = layout.ByteBufInit(512)
    CompilerCsgReportBufAppendText(buf, "package_id_hex=")
    CompilerCsgReportBufAppendText(buf,
                                   CompilerCsgTextHex(surface.packageId))
    CompilerCsgReportBufAppendText(buf, "\nexported_count=")
    CompilerCsgReportBufAppendText(
        buf, IntToStr(surface.exportedSymbolCount))
    CompilerCsgReportBufAppendText(buf, "\nsurface_cid=")
    CompilerCsgReportBufAppendText(
        buf, layout.FixedBytes32Hex(surface.surfaceCid))
    for rowIndex in 0..<surface.exportedSymbolCount:
        CompilerCsgReportBufAppendText(buf, "\n")
        CompilerCsgReportBufAppendText(
            buf, CompilerExportSurfaceReportLine(surface, rowIndex))
    return CompilerCsgReportBufTakeText(buf)

@borrows
fn CompilerExportSurfaceReportLine(surface: CsgExportSurface,
                                     index: int32): str =
    var buf = layout.ByteBufInit(128)
    CompilerCsgReportBufAppendText(buf, "export[")
    CompilerCsgReportBufAppendText(buf, IntToStr(index))
    CompilerCsgReportBufAppendText(buf, "]=")
    CompilerCsgReportBufAppendText(buf, CompilerCsgTextHex(surface.exportedSymbols[index]))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, CompilerCsgTextHex(surface.exportedTargetNames[index]))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(surface.exportedLayouts[index]))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(surface.exportedEffects[index]))
    CompilerCsgReportBufAppendText(buf, "|")
    CompilerCsgReportBufAppendText(buf, IntToStr(surface.exportedCapabilities[index]))
    return CompilerCsgReportBufTakeText(buf)

@borrows
fn CompilerCsgTextStartsWith(text: str,
                               prefix: str): bool =
    if prefix.len <= 0:
        return true
    if text.len < prefix.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

@borrows
fn CompilerCsgCanonicalFileTextEqual(text: str,
                                     canonical: str): bool =
    return text == canonical || text == parser.ParserConcat2(canonical, "\n")

@borrows
fn CompilerCsgParseUintText(text: str,
                              outOk: var bool): int32 =
    outOk = false
    if text.len <= 0:
        return 0
    var value = Int32(0)
    for i in 0..<text.len:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return 0
        value = value * 10 + (Int32(ch) - Int32('0'))
    outOk = true
    return value

@borrows
fn CompilerExportSurfaceFromReportText(text: str,
                                       out: var CsgExportSurface): Result[bool] =
    var next: CsgExportSurface
    var decodeErr = ""
    if !CompilerCsgTextFromHexInto(
            compilerCsgLineValue(text, "package_id_hex"),
            next.packageId,
            decodeErr):
        return Err[bool](decodeErr)
    let countRaw = compilerCsgLineValue(text, "exported_count")
    var countOk = false
    next.exportedSymbolCount = CompilerCsgParseUintText(countRaw, countOk)
    if !countOk:
        return Err[bool](" compiler csg: export surface count invalid")
    let surfaceCidRes = layout.FixedBytes32FromHex(
        compilerCsgLineValue(text, "surface_cid"))
    if IsErr(surfaceCidRes):
        return Err[bool](" compiler csg: export surface cid text invalid")
    next.surfaceCid = Value(surfaceCidRes)
    next.exportedSymbols = []
    next.exportedTargetNames = []
    next.exportedLayouts = []
    next.exportedEffects = []
    next.exportedCapabilities = []
    let lines = strutil.Split(text, '\n')
    for lineIndex in 0..<lines.len:
        let line = strutil.Strip(lines[lineIndex])
        if !CompilerCsgTextStartsWith(line, "export["):
            continue
        var equalIndex = -1
        for charIndex in 0..<line.len:
            if line[charIndex] == '=':
                equalIndex = charIndex
                break
        let expectedKey = parser.ParserConcat3(
            "export[",
            IntToStr(next.exportedSymbols.len),
            "]")
        if equalIndex <= parser.ParserStrLenAt("export[") ||
           strutil.SliceStr(line, 0, equalIndex - 1) != expectedKey ||
           equalIndex >= line.len - 1:
            return Err[bool](" compiler csg: export surface row index/order invalid")
        let payload = strutil.SliceStr(line, equalIndex + 1, line.len - 1)
        let parts = strutil.Split(payload, '|')
        if parts.len != 5:
            return Err[bool](" compiler csg: export surface row shape invalid")
        var symbol = ""
        var target = ""
        if !CompilerCsgTextFromHexInto(parts[0], symbol, decodeErr) ||
           !CompilerCsgTextFromHexInto(parts[1], target, decodeErr):
            return Err[bool](decodeErr)
        var rowLayoutOk = false
        var rowEffectOk = false
        var rowCapabilityOk = false
        let rowLayout = CompilerCsgParseUintText(parts[2], rowLayoutOk)
        let rowEffect = CompilerCsgParseUintText(parts[3], rowEffectOk)
        let rowCapability = CompilerCsgParseUintText(parts[4],
                                                      rowCapabilityOk)
        if !rowLayoutOk || !rowEffectOk || !rowCapabilityOk:
            return Err[bool](" compiler csg: export surface numeric row invalid")
        add(next.exportedSymbols, symbol)
        add(next.exportedTargetNames, target)
        add(next.exportedLayouts, rowLayout)
        add(next.exportedEffects, rowEffect)
        add(next.exportedCapabilities, rowCapability)
    if next.exportedSymbols.len != next.exportedSymbolCount:
        return Err[bool](" compiler csg: export surface row count mismatch")
    var validateErr = ""
    if !CompilerExportSurfaceStrictValidateInto(next, validateErr):
        return Err[bool](validateErr)
    if !CompilerCsgCanonicalFileTextEqual(text,
                                           CompilerExportSurfaceReport(next)):
        return Err[bool](" compiler csg: export surface report is not canonical")
    out = next
    return Ok[bool](true)

@borrows
fn compilerCsgCanonicalSidecarEdgeLess(left: CompilerCsgEdge,
                                       right: CompilerCsgEdge): bool =
    if left.edgeKind != right.edgeKind:
        return left.edgeKind < right.edgeKind
    if left.fromNodeId != right.fromNodeId:
        return left.fromNodeId < right.fromNodeId
    return left.toNodeId < right.toNodeId

@borrows
fn compilerCsgCanonicalSidecarMergeEdgesPassRec(
        src: var CompilerCsgEdge[],
        dst: var CompilerCsgEdge[],
        width: int32,
        leftStart: int32) =
    while true:
        let count = src.len
        if leftStart >= count:
            return
        if leftStart % 4096 == 0:
            os.ProcessResourceGuardCheck()
        let midRaw = leftStart + width
        var middle = count
        if midRaw < count:
            middle = midRaw
        let rightEndRaw = leftStart + width * 2
        var rightEnd = count
        if rightEndRaw < count:
            rightEnd = rightEndRaw
        var left = leftStart
        var right = middle
        for outIndex in leftStart..<rightEnd:
            if left < middle &&
               (right >= rightEnd ||
                !compilerCsgCanonicalSidecarEdgeLess(src[right], src[left])):
                dst[outIndex] = src[left]
                left = left + 1
            else:
                dst[outIndex] = src[right]
                right = right + 1
        leftStart = leftStart + width * 2
        continue

fn compilerCsgCanonicalSidecarMergeEdgesPass(
        src: var CompilerCsgEdge[],
        dst: var CompilerCsgEdge[],
        width: int32) =
    compilerCsgCanonicalSidecarMergeEdgesPassRec(src, dst, width, 0)

@borrows
fn compilerCsgCanonicalSidecarCopyEdgesRec(
        dst: var CompilerCsgEdge[],
        src: var CompilerCsgEdge[],
        index: int32,
        count: int32) =
    while true:
        if index >= count:
            return
        dst[index] = src[index]
        index = index + 1
        continue

@borrows
fn compilerCsgCanonicalSidecarCloneEdgesRec(
        dst: var CompilerCsgEdge[],
        src: var CompilerCsgEdge[],
        index: int32,
        count: int32) =
    while true:
        if index >= count:
            return
        add(dst, src[index])
        index = index + 1
        continue

@borrows
fn compilerCsgCanonicalSidecarSortEdgesWidthRec(
        edges: var CompilerCsgEdge[],
        scratch: var CompilerCsgEdge[],
        count: int32,
        width: int32,
        readScratch: bool): bool =
    while true:
        if width >= count:
            return readScratch
        if readScratch:
            compilerCsgCanonicalSidecarMergeEdgesPass(scratch, edges, width)
        else:
            compilerCsgCanonicalSidecarMergeEdgesPass(edges, scratch, width)
        var nextWidth = width * 2
        if width > count / 2:
            nextWidth = count
        width = nextWidth
        readScratch = !readScratch
        continue

fn compilerCsgCanonicalSidecarSortEdges(edges: var CompilerCsgEdge[]) =
    let count = edges.len
    if count > 1:
        var scratch: CompilerCsgEdge[]
        compilerCsgCanonicalSidecarCloneEdgesRec(scratch, edges, 0, count)
        let readScratch = compilerCsgCanonicalSidecarSortEdgesWidthRec(
            edges, scratch, count, 1, false)
        if readScratch:
            compilerCsgCanonicalSidecarCopyEdgesRec(edges, scratch, 0, count)
    for index in 0..<edges.len:
        edges[index].edgeId = index + 1

@borrows
fn compilerCsgCanonicalSidecarCid(
        packageId: str,
        nodes: CompilerCsgNode[],
        edges: CompilerCsgEdge[]): layout.FixedBytes32 =
    var buf: layout.ByteBuf = layout.ByteBufInit(1024)
    CompilerCsgAppendText(buf, "cheng.compiler.csg.canonical_sidecar")
    CompilerCsgAppendText(buf, packageId)
    compilerCsgPortableAppendU32Field(buf, nodes.len)
    for index in 0..<nodes.len:
        let node = nodes[index]
        compilerCsgPortableAppendU32Field(buf, node.nodeId)
        compilerCsgPortableAppendU32Field(buf, node.nodeKind)
        compilerCsgPortableAppendU32Field(buf, node.ownerNodeId)
        CompilerCsgAppendText(buf, node.modulePath)
        CompilerCsgAppendText(buf, node.symbolText)
        CompilerCsgAppendText(buf, node.factText)
        compilerCsgPortableAppendU32Field(buf, node.producerSourceIndex)
        compilerCsgPortableAppendU32Field(
            buf, node.producerDeclarationIndex)
        compilerCsgPortableAppendU32Field(
            buf, node.functionNameSurfaceKind)
        compilerCsgPortableAppendFixed32Field(buf, node.nameProofCid)
        CompilerCsgAppendText(buf, node.semanticSource)
        compilerCsgPortableAppendU32Field(
            buf, node.semanticDeclarationLineIndex)
        CompilerCsgAppendText(buf, node.semanticParamTypeJoin)
        CompilerCsgAppendText(buf, node.semanticReturnType)
        compilerCsgPortableAppendU32Field(
            buf, node.semanticSignatureComplete)
        compilerCsgPortableAppendU32Field(buf, node.resultLayoutKind)
        compilerCsgPortableAppendU32Field(buf, node.effectKind)
        compilerCsgPortableAppendU32Field(buf, node.capabilityKind)
        compilerCsgPortableAppendU32Field(buf, node.callConv)
        compilerCsgPortableAppendU32Field(buf, node.entryFlag)
        compilerCsgPortableAppendU32Field(buf, node.exportedFlag)
        CompilerCsgAppendText(buf, node.exportSymbolName)
        compilerCsgPortableAppendU32Field(buf, node.exportNameExplicit)
        compilerCsgPortableAppendFixed32Field(buf, node.factCid)
    compilerCsgPortableAppendU32Field(buf, edges.len)
    for index in 0..<edges.len:
        let edge = edges[index]
        compilerCsgPortableAppendU32Field(buf, edge.edgeId)
        compilerCsgPortableAppendU32Field(buf, edge.edgeKind)
        compilerCsgPortableAppendU32Field(buf, edge.fromNodeId)
        compilerCsgPortableAppendU32Field(buf, edge.toNodeId)
        compilerCsgPortableAppendFixed32Field(buf, edge.edgeCid)
    return CompilerCsgBufCid(buf)

fn compilerCsgCanonicalSidecarNodeKindKnown(kind: int32): bool =
    return kind == CompilerCsgNodeKindPackage ||
           kind == CompilerCsgNodeKindModule ||
           kind == CompilerCsgNodeKindSymbol ||
           kind == CompilerCsgNodeKindLayout ||
           kind == CompilerCsgNodeKindEffect ||
           kind == CompilerCsgNodeKindCapability

fn compilerCsgCanonicalSidecarEdgeKindKnown(kind: int32): bool =
    return kind == CompilerCsgEdgeKindContains ||
           kind == CompilerCsgEdgeKindImports ||
           kind == CompilerCsgEdgeKindHasLayout ||
           kind == CompilerCsgEdgeKindHasEffect ||
           kind == CompilerCsgEdgeKindHasCapability

@borrows
fn compilerCsgCanonicalSidecarNodeIndexById(
        nodes: CompilerCsgNode[],
        nodeId: int32): int32 =
    var low: int32
    var high = nodes.len
    while low < high:
        let middle = low + (high - low) / 2
        if nodes[middle].nodeId < nodeId:
            low = middle + 1
        else:
            high = middle
    if low < nodes.len && nodes[low].nodeId == nodeId:
        return low
    return -1

@borrows
fn CompilerCsgCanonicalSidecarStrictValidateInto(
        packageId: str,
        nodes: CompilerCsgNode[],
        edges: CompilerCsgEdge[],
        canonicalGraphCid: layout.FixedBytes32,
        sidecarCid: layout.FixedBytes32,
        err: var str): bool =
    if !compilerExportSurfaceTextSafe(packageId) || nodes.len <= 0:
        err = " compiler csg: canonical sidecar package/nodes invalid"
        return false
    var packageNodeCount = 0
    for index in 0..<nodes.len:
        let node = nodes[index]
        if node.nodeId <= 0 ||
           (index > 0 && nodes[index - 1].nodeId >= node.nodeId) ||
           !compilerCsgCanonicalSidecarNodeKindKnown(node.nodeKind) ||
           node.ownerNodeId < 0 || node.ownerNodeId >= node.nodeId ||
           node.semanticDeclarationLineIndex < 0 ||
           node.semanticSignatureComplete < 0 ||
           node.semanticSignatureComplete > 1 ||
           node.entryFlag < 0 || node.entryFlag > 1 ||
           node.exportedFlag < 0 || node.exportedFlag > 1 ||
           node.exportNameExplicit < 0 || node.exportNameExplicit > 1:
            err = Fmt" compiler csg: canonical sidecar node shape/order invalid index={index}"
            return false
        if node.nodeKind == CompilerCsgNodeKindPackage:
            packageNodeCount = packageNodeCount + 1
            if node.ownerNodeId != 0:
                err = " compiler csg: canonical sidecar package node has owner"
                return false
        elif node.ownerNodeId <= 0 ||
             compilerCsgCanonicalSidecarNodeIndexById(
                 nodes, node.ownerNodeId) < 0:
            err = Fmt" compiler csg: canonical sidecar non-root owner missing index={index}"
            return false
        if !layout.FixedBytes32Equal(node.factCid,
                                     CompilerCsgHashNodeRecord(node)):
            err = Fmt" compiler csg: canonical sidecar node fact cid mismatch index={index}"
            return false
    if packageNodeCount != 1:
        err = " compiler csg: canonical sidecar package root count invalid"
        return false
    var identityErr = ""
    if !csgnorm.CsgNormValidateSemanticIdentity(nodes, identityErr):
        err = identityErr
        return false
    for index in 0..<edges.len:
        let edge = edges[index]
        if edge.edgeId <= 0 ||
           !compilerCsgCanonicalSidecarEdgeKindKnown(edge.edgeKind) ||
           compilerCsgCanonicalSidecarNodeIndexById(
               nodes, edge.fromNodeId) < 0 ||
           compilerCsgCanonicalSidecarNodeIndexById(
               nodes, edge.toNodeId) < 0:
            err = Fmt" compiler csg: canonical sidecar edge shape/order invalid index={index}"
            return false
        if index > 0 &&
           !compilerCsgCanonicalSidecarEdgeLess(edges[index - 1], edge):
            err = Fmt" compiler csg: canonical sidecar edges not strictly canonical index={index}"
            return false
        if !layout.FixedBytes32Equal(
                edge.edgeCid,
                CompilerCsgHashEdge(edge.fromNodeId,
                                    edge.toNodeId,
                                    edge.edgeKind)):
            err = Fmt" compiler csg: canonical sidecar edge cid mismatch index={index}"
            return false
    let recomputedCanonical = csgnorm.CsgNormalizedGraphCid(packageId,
                                                            nodes,
                                                            edges)
    if layout.FixedBytes32Equal(canonicalGraphCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(canonicalGraphCid, recomputedCanonical):
        err = " compiler csg: canonical sidecar canonical graph cid mismatch"
        return false
    let recomputedSidecar = compilerCsgCanonicalSidecarCid(packageId,
                                                           nodes,
                                                           edges)
    if layout.FixedBytes32Equal(sidecarCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(sidecarCid, recomputedSidecar):
        err = " compiler csg: canonical sidecar sidecar cid mismatch"
        return false
    err = ""
    return true

@borrows
fn CompilerCsgCanonicalSidecarNodeLine(index: int32,
                                       node: CompilerCsgNode): str =
    let parts = [IntToStr(node.nodeId),
                 IntToStr(node.nodeKind),
                 IntToStr(node.ownerNodeId),
                 CompilerCsgTextHex(node.modulePath),
                 CompilerCsgTextHex(node.symbolText),
                 CompilerCsgTextHex(node.factText),
                 IntToStr(node.producerSourceIndex),
                 IntToStr(node.producerDeclarationIndex),
                 IntToStr(node.functionNameSurfaceKind),
                 layout.FixedBytes32Hex(node.nameProofCid),
                 CompilerCsgTextHex(node.semanticSource),
                 IntToStr(node.semanticDeclarationLineIndex),
                 CompilerCsgTextHex(node.semanticParamTypeJoin),
                 CompilerCsgTextHex(node.semanticReturnType),
                 IntToStr(node.semanticSignatureComplete),
                 IntToStr(node.resultLayoutKind),
                 IntToStr(node.effectKind),
                 IntToStr(node.capabilityKind),
                 IntToStr(node.callConv),
                 IntToStr(node.entryFlag),
                 IntToStr(node.exportedFlag),
                 CompilerCsgTextHex(node.exportSymbolName),
                 IntToStr(node.exportNameExplicit),
                 layout.FixedBytes32Hex(node.factCid)]
    return strutil.Join(
        ["node[", IntToStr(index), "]=", strutil.Join(parts, "|")], "")

@borrows
fn CompilerCsgCanonicalSidecarEdgeLine(index: int32,
                                       edge: CompilerCsgEdge): str =
    return strutil.Join(
        ["edge[", IntToStr(index), "]=", IntToStr(edge.edgeId), "|",
         IntToStr(edge.edgeKind), "|", IntToStr(edge.fromNodeId), "|",
         IntToStr(edge.toNodeId), "|", layout.FixedBytes32Hex(edge.edgeCid)],
        "")

@borrows
fn CompilerCsgCanonicalSidecarReport(csg: CompilerCsg): str =
    var edges: CompilerCsgEdge[]
    for index in 0..<csg.edges.len:
        add(edges, csg.edges[index])
    compilerCsgCanonicalSidecarSortEdges(edges)
    let sidecarCid = compilerCsgCanonicalSidecarCid(csg.packageId,
                                                    csg.nodes,
                                                    edges)
    var validateErr = ""
    if !CompilerCsgCanonicalSidecarStrictValidateInto(
            csg.packageId, csg.nodes, edges, csg.canonicalGraphCid,
            sidecarCid, validateErr):
        panic(validateErr)
    var buf = layout.ByteBufInit(4096)
    CompilerCsgReportBufAppendText(buf, "package_id_hex=")
    CompilerCsgReportBufAppendText(buf, CompilerCsgTextHex(csg.packageId))
    CompilerCsgReportBufAppendText(buf, "\nnode_count=")
    CompilerCsgReportBufAppendText(buf, IntToStr(csg.nodes.len))
    CompilerCsgReportBufAppendText(buf, "\nedge_count=")
    CompilerCsgReportBufAppendText(buf, IntToStr(edges.len))
    CompilerCsgReportBufAppendText(buf, "\ncanonical_graph_cid=")
    CompilerCsgReportBufAppendText(
        buf, layout.FixedBytes32Hex(csg.canonicalGraphCid))
    CompilerCsgReportBufAppendText(buf, "\nsidecar_cid=")
    CompilerCsgReportBufAppendText(buf, layout.FixedBytes32Hex(sidecarCid))
    for index in 0..<csg.nodes.len:
        CompilerCsgReportBufAppendText(buf, "\n")
        CompilerCsgReportBufAppendText(
            buf, CompilerCsgCanonicalSidecarNodeLine(
                index, csg.nodes[index]))
    for index in 0..<edges.len:
        CompilerCsgReportBufAppendText(buf, "\n")
        CompilerCsgReportBufAppendText(
            buf, CompilerCsgCanonicalSidecarEdgeLine(index, edges[index]))
    return CompilerCsgReportBufTakeText(buf)

@borrows
fn compilerCsgCanonicalSidecarUintInto(raw: str,
                                       out: var int32,
                                       err: var str): bool =
    var ok = false
    let value = CompilerCsgParseUintText(raw, ok)
    if !ok || value < 0 || IntToStr(value) != raw:
        err = " compiler csg: canonical sidecar integer is not canonical"
        return false
    out = value
    err = ""
    return true

fn compilerCsgCanonicalSidecarNodeFromPartsInto(
        parts: str[],
        out: var CompilerCsgNode,
        err: var str): bool =
    if parts.len != 24:
        err = " compiler csg: canonical sidecar node row shape invalid"
        return false
    if !compilerCsgCanonicalSidecarUintInto(parts[0], out.nodeId, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[1], out.nodeKind, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[2], out.ownerNodeId, err) ||
       !CompilerCsgTextFromHexInto(parts[3], out.modulePath, err) ||
       !CompilerCsgTextFromHexInto(parts[4], out.symbolText, err) ||
       !CompilerCsgTextFromHexInto(parts[5], out.factText, err) ||
       !compilerCsgCanonicalSidecarUintInto(
           parts[6], out.producerSourceIndex, err) ||
       !compilerCsgCanonicalSidecarUintInto(
           parts[7], out.producerDeclarationIndex, err) ||
       !compilerCsgCanonicalSidecarUintInto(
           parts[8], out.functionNameSurfaceKind, err):
        return false
    let nameProofCidRes = layout.FixedBytes32FromHex(parts[9])
    if IsErr(nameProofCidRes):
        err = " compiler csg: canonical sidecar node name proof cid text invalid"
        return false
    out.nameProofCid = Value(nameProofCidRes)
    if !CompilerCsgTextFromHexInto(parts[10], out.semanticSource, err) ||
       !compilerCsgCanonicalSidecarUintInto(
           parts[11], out.semanticDeclarationLineIndex, err) ||
       !CompilerCsgTextFromHexInto(parts[12], out.semanticParamTypeJoin, err) ||
       !CompilerCsgTextFromHexInto(parts[13], out.semanticReturnType, err) ||
       !compilerCsgCanonicalSidecarUintInto(
           parts[14], out.semanticSignatureComplete, err) ||
       !compilerCsgCanonicalSidecarUintInto(
           parts[15], out.resultLayoutKind, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[16], out.effectKind, err) ||
       !compilerCsgCanonicalSidecarUintInto(
           parts[17], out.capabilityKind, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[18], out.callConv, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[19], out.entryFlag, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[20], out.exportedFlag, err) ||
       !CompilerCsgTextFromHexInto(parts[21], out.exportSymbolName, err) ||
       !compilerCsgCanonicalSidecarUintInto(
           parts[22], out.exportNameExplicit, err):
        return false
    let factCidRes = layout.FixedBytes32FromHex(parts[23])
    if IsErr(factCidRes):
        err = " compiler csg: canonical sidecar node fact cid text invalid"
        return false
    out.factCid = Value(factCidRes)
    err = ""
    return true

fn compilerCsgCanonicalSidecarEdgeFromPartsInto(
        parts: str[],
        out: var CompilerCsgEdge,
        err: var str): bool =
    if parts.len != 5:
        err = " compiler csg: canonical sidecar edge row shape invalid"
        return false
    if !compilerCsgCanonicalSidecarUintInto(parts[0], out.edgeId, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[1], out.edgeKind, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[2], out.fromNodeId, err) ||
       !compilerCsgCanonicalSidecarUintInto(parts[3], out.toNodeId, err):
        return false
    let edgeCidRes = layout.FixedBytes32FromHex(parts[4])
    if IsErr(edgeCidRes):
        err = " compiler csg: canonical sidecar edge cid text invalid"
        return false
    out.edgeCid = Value(edgeCidRes)
    err = ""
    return true

@borrows
fn CompilerCsgCanonicalGraphCidFromReportTextInto(
        text: str,
        outCid: var layout.FixedBytes32,
        err: var str): bool =
    var csg: CompilerCsg
    if !CompilerCsgTextFromHexInto(
            compilerCsgLineValue(text, "package_id_hex"),
            csg.packageId,
            err):
        return false
    var nodeCount = 0
    var edgeCount = 0
    if !compilerCsgCanonicalSidecarUintInto(
            compilerCsgLineValue(text, "node_count"), nodeCount, err) ||
       !compilerCsgCanonicalSidecarUintInto(
            compilerCsgLineValue(text, "edge_count"), edgeCount, err):
        return false
    let canonicalCidRes = layout.FixedBytes32FromHex(
        compilerCsgLineValue(text, "canonical_graph_cid"))
    let sidecarCidRes = layout.FixedBytes32FromHex(
        compilerCsgLineValue(text, "sidecar_cid"))
    if IsErr(canonicalCidRes) || IsErr(sidecarCidRes):
        err = " compiler csg: canonical sidecar header cid text invalid"
        return false
    csg.canonicalGraphCid = Value(canonicalCidRes)
    let sidecarCid = Value(sidecarCidRes)
    let lines = strutil.Split(text, '\n')
    for lineIndex in 0..<lines.len:
        let line = strutil.Strip(lines[lineIndex])
        var rowKind = 0
        var rowIndex = 0
        if CompilerCsgTextStartsWith(line, "node["):
            rowKind = 1
            rowIndex = csg.nodes.len
        elif CompilerCsgTextStartsWith(line, "edge["):
            rowKind = 2
            rowIndex = csg.edges.len
        else:
            continue
        var equalIndex = -1
        for charIndex in 0..<line.len:
            if line[charIndex] == '=':
                equalIndex = charIndex
                break
        let prefix = rowKind == 1 ? "node[" : "edge["
        let prefixLen = prefix.len
        let expectedKey = parser.ParserConcat3(
            prefix,
            IntToStr(rowIndex),
            "]")
        if equalIndex <= prefixLen ||
           strutil.SliceStr(line, 0, equalIndex - 1) != expectedKey ||
           equalIndex >= line.len - 1:
            err = " compiler csg: canonical sidecar row index/order invalid"
            return false
        let payload = strutil.SliceStr(line, equalIndex + 1, line.len - 1)
        let parts = strutil.Split(payload, '|')
        if rowKind == 1:
            if csg.edges.len != 0:
                err = " compiler csg: canonical sidecar node follows edge"
                return false
            var node: CompilerCsgNode
            if !compilerCsgCanonicalSidecarNodeFromPartsInto(parts, node, err):
                return false
            add(csg.nodes, node)
        else:
            var edge: CompilerCsgEdge
            if !compilerCsgCanonicalSidecarEdgeFromPartsInto(parts, edge, err):
                return false
            add(csg.edges, edge)
    if csg.nodes.len != nodeCount || csg.edges.len != edgeCount:
        err = " compiler csg: canonical sidecar row count mismatch"
        return false
    csg.nodeCount = nodeCount
    csg.edgeCount = edgeCount
    if !CompilerCsgCanonicalSidecarStrictValidateInto(
            csg.packageId, csg.nodes, csg.edges, csg.canonicalGraphCid,
            sidecarCid, err):
        return false
    if !CompilerCsgCanonicalFileTextEqual(
            text, CompilerCsgCanonicalSidecarReport(csg)):
        err = " compiler csg: canonical sidecar text is not canonical"
        return false
    outCid = csg.canonicalGraphCid
    err = ""
    return true

@borrows
fn CompilerCsgGraphCidFromReportText(text: str): Result[layout.FixedBytes32] =
    let raw = compilerCsgLineValue(text, "graph_cid")
    if raw.len <= 0:
        return Err[layout.FixedBytes32](" compiler csg: graph_cid missing")
    return layout.FixedBytes32FromHex(raw)

@borrows
fn CompilerCsgCanonicalGraphCidFromReportText(
        text: str): Result[layout.FixedBytes32] =
    var out: layout.FixedBytes32
    var err = ""
    if !CompilerCsgCanonicalGraphCidFromReportTextInto(text, out, err):
        return Err[layout.FixedBytes32](err)
    return Ok[layout.FixedBytes32](out)

@borrows
fn CompileReceiptReport(receipt: CompileReceipt): str =
    return receipt_codec.CompileReceiptCodecReport(receipt)

@borrows
fn CompileReceiptProviderReportLine(provider: str,
                                      index: int32): str =
    return receipt_codec.CompileReceiptCodecProviderReportLine(
        provider, index)

@borrows
fn CompileReceiptFromReportText(text: str,
                                  out: var CompileReceipt): Result[bool] =
    var err: str
    if !receipt_codec.CompileReceiptCodecDecodeStrictInto(text, out, err):
        return Err[bool](err)
    return Ok[bool](true)

@borrows
fn CompileReceiptRuntimeProviderSetEqual(left: str[],
                                           right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn CompileReceiptEquivalent(base: CompileReceipt,
                              next: CompileReceipt): bool =
    if !layout.FixedBytes32Equal(base.worldHeadCid,
                                 next.worldHeadCid) ||
       !layout.FixedBytes32Equal(base.sourceIdentityReceiptCid,
                                 next.sourceIdentityReceiptCid) ||
       !layout.FixedBytes32Equal(base.semanticReceiptCid,
                                 next.semanticReceiptCid) ||
       !layout.FixedBytes32Equal(base.outputDigest,
                                 next.outputDigest) ||
       !layout.FixedBytes32Equal(base.canonicalOutputDigest,
                                 next.canonicalOutputDigest) ||
       !layout.FixedBytes32Equal(base.receiptCid,
                                 next.receiptCid):
        return false
    if base.targetTriple != next.targetTriple:
        return false
    if base.bootstrapStage != next.bootstrapStage:
        return false
    if !CompileReceiptRuntimeProviderSetEqual(base.runtimeProviderSet, next.runtimeProviderSet):
        return false
    return true

@borrows
fn compilerCsgLineValue(text: str, key: str): str =
    let lines = strutil.Split(text, '\n')
    for i in 0..<lines.len:
        let lineRaw = lines[i]
        let line = strutil.Strip(lineRaw)
        var matchedPrefix = false
        if line.len > key.len:
            if Int32(line[key.len]) == 61:
                matchedPrefix = true
        if !matchedPrefix:
            continue
        var matched = true
        for j in 0..<key.len:
            if line[j] != key[j]:
                matched = false
                break
        if !matched:
            continue
        let valueRaw = strutil.SliceStr(line, key.len + 1, line.len - 1)
        let value = strutil.Strip(valueRaw)
        return value
    return ""

# ---- ExactDef 程序契约生产 seal 接线 (批 5 交接项; 规格
#      docs/cheng-exact-def-batch5-authority-spec.md §4.5) ----
#
# 键车道裁定 (先取证后裁, 跨节点身份必须 int32 索引精确键, 严禁
# name+arity/文本近似键): CallOp 无 callee int32 行键
# (core_types.cheng:523-563; targetSymbol/targetSourcePath 是文本,
# 注释 525-528 明令禁止符号重建)。既有精确冻结键车道直读, 零扩列:
#   TypedExpr build index: nodes2_callDeclarationIndexes[callNode]
#     → callDeclarationProducerFunctionRows[decl] = callee TypedExpr
#     函数行 (typed_expr.cheng:579 填充 29374; typed_expr.cheng:23759+
#     与本文件 18554-18583 双重冻结校验);
#   lowering 封印面: PrimaryObjectIrFunction.callTargetTypedFunctionIndexes
#     (lowering_plan.cheng:606-609, LoweringSealPrimaryObjectIrCallIdentities
#     接口 CID 绑定; importc/synthetic=-1);
#   BodyIR.controlFunctionRow == TypedExpr 函数行
#     (primary_object_plan.cheng:118 / backend2_pipeline.cheng:123)。
# 生产送达: 契约表按 TypedExpr 函数行索引; 每 callSequence 行经
# semanticCallExprNodeIndex (core_types.cheng:551, 合成调用 -1) →
# nodes2_callDeclarationIndexes → callDeclarationProducerFunctionRows
# 在 primary/backend2 验证点投影为 int32[] 窗送入 (core_types 零扩列,
# frag codec 零同步)。
#
# 死点纪律探明记录 (2026-08-26, 钉死种子死点 fn=11464=
# texpr.TypedExprBuildFactsAppendPreparedSourceRangeFacts,
# typed_expr.cheng 内): 函数行按可达标记轮次指派, 新增可达函数只有
# 经深位调用点 (primary/backend2 validate 域, 批 5 实证死点后) 拉入才
# 不移动死点。探针实证: compiler_csg 全程序门宿主
# (CompilerCsgSemanticBuildTypedIrTable) 直调 call_authority 新函数 +
# 新增 import 边, 死亡形态改变 (row 移位 +253, 死点由 managed CFG merge
# 11464 变为 body-store-freeze row=12791) — compiler_csg 浅位门严禁
# 新增对后序模块的 import 边与调用。因此本节行为函数只从
# primary/backend2 validate 深位调用点拉入可达, compiler_csg 不 import
# exact_def_call_authority/exactdef; 契约值域常量按
# body_ir_exact_def.cheng:375-381 / exact_def_call_authority.cheng:121-130
# 逐值对齐复制 (常量声明不产生函数行; 推导器域校验即时捕获错位)。
#
# 推导窗逐条 (规格 §4.5, 输入=TypedExpr 冻结列):
#   resultExprClasses  — functions2_resultExprClasses 序数直读
#                        (TypedExprExprClass 0..3 与推导器窗值域同序)。
#   formalCounts       — valueDefinitions CSR 内 Parameter-origin 计数。
#   returnExactTypeIds — Borrowed 时 return 节点结构 TypeId
#                        (nodes2_structuralTypeIds), 否则 -1。
#   globalTypeIds      — 空窗: texpr value-definition 表是函数内表,
#                        GLOBAL 根在 texpr 层无物化 owner 行 (普查全闭包
#                        @borrow_result 皆形参根/静态根); GLOBAL 域尝试
#                        按真空锚 hard-fail, 不 Mock。
#   retStarts/Counts   — functions2_returnNodeIndexs 每函数 0/1 CSR。
#   retRoot*           — 逐 RET owner 域窗: 物化 owner 行
#                        (typedExprIrBorrowOwnerForNodeExact 单实现直调)
#                        Parameter-origin→FORMAL/Owned-local→Other/
#                        聚合构造返回→赋值语句扫描 (≈C MAKE mutation
#                        scan, 借用贡献根须同一形参)/非托管→STATIC/
#                        托管借用无 owner→Sentinel。
#   formalRootsReadOnly— §2.3 四拒绝集 TypedExpr 侧重述 (每函数一
#                        bool, REPORT §6 末条口径): manualConsume*
#                        投影 (target/source ordinal 触根即拒) + 语句扫
#                        (assign lvalue 链根=根形参→rebind/别名 mutation
#                        拒; 调用实参 canonical owner=根 且 callee 该位
#                        var 形参 (nodes2_paramMutableFlags) → 递归契约
#                        要求, 环 hard-fail)。非 var 位按表面语言纪律
#                        (借用实参只能绑 @borrows/var; @borrows 只读)。
#   expect*            — 顺序无关化恒等校验窗 (§4.2-7 的 Cheng 直读
#                        重述): 同源机械聚合的函数级五元组; 推导器自
#                        RET-CSR 证据窗独立聚合后逐字段比对
#                        (推导列==TypedExpr 冻结列直读结果)。

const
    # 契约 root kind / read-only 值域 (body_ir_exact_def.cheng:375-381 逐值对齐)。
    compilerCsgExactDefContractRootUnknownTag = 0
    compilerCsgExactDefContractRootFormalTag = 1
    compilerCsgExactDefContractRootGlobalTag = 2
    compilerCsgExactDefContractRootStaticTag = 3
    compilerCsgExactDefContractReadOnlyUnknownTag = 0
    compilerCsgExactDefContractReadOnlyProvenTag = 1
    # RET owner 域 (exact_def_call_authority.cheng:126-130 逐值对齐)。
    compilerCsgExactDefRetRootStatic = 0
    compilerCsgExactDefRetRootFormal = 1
    compilerCsgExactDefRetRootGlobal = 2
    compilerCsgExactDefRetRootOther = 3
    compilerCsgExactDefRetRootSentinel = -1
    # TypedExprExprClass 序数 (typed_expr.cheng:35-39)。
    compilerCsgExactDefExprClassOwned = 1
    compilerCsgExactDefExprClassBorrowed = 2
    compilerCsgExactDefExprClassUnmanaged = 3

@borrows
fn compilerCsgExactDefContractCallDeclarationRows(
        ir: texpr.TypedExprIr): texpr.TypedExprBuildIndex =
    let declarationOwner = texpr.TypedExprIrCallDeclarationBuildIndex(ir)
    if declarationOwner == nil || declarationOwner.released ||
       !declarationOwner.callDeclarationSealed:
        panic("compiler csg exact def contract: call declaration index unavailable")
    return declarationOwner

@borrows
fn compilerCsgExactDefContractParamOrdinalForDefinition(
        ir: texpr.TypedExprIr,
        definitionRow: int32): int32 =
    let defNode =
        texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
            ir, definitionRow)
    if defNode < 0 || defNode >= ir.nodes2_nodeIndexs.len ||
       ir.nodes2_opKinds[defNode] != texpr.TypedExprIrOpParamRef:
        panic("compiler csg exact def contract: parameter owner node invalid")
    let ordinal = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.nodes2_paramSlots, defNode)
    if ordinal < 0:
        panic("compiler csg exact def contract: parameter ordinal missing")
    return ordinal

# 逐 RET owner 域分析 (规格 §4.5 rootKind 行的窗填充)。输出四槽:
# domain/row/typeId/formalTypeId; 不可证形状 panic hard-fail (不 Mock)。
@borrows
fn compilerCsgExactDefContractRetRootAnalyze(
        ir: texpr.TypedExprIr,
        functionIndex: int32,
        returnNodeIndex: int32,
        domain: var int32,
        rootRow: var int32,
        rootTypeId: var int32,
        formalTypeId: var int32) =
    domain = compilerCsgExactDefRetRootSentinel
    rootRow = -1
    rootTypeId = -1
    formalTypeId = -1
    if returnNodeIndex < 0 ||
       returnNodeIndex >= ir.nodes2_nodeIndexs.len:
        panic("compiler csg exact def contract: return node coordinate invalid")
    let managed = ir.nodes2_resultTypeManagedFlags[returnNodeIndex]
    let exprClass = Int32(ir.nodes2_exprClasses[returnNodeIndex])
    if !managed || exprClass == compilerCsgExactDefExprClassUnmanaged:
        # 非托管返回 (nil/静态串/标量): C saw_static 同构。
        domain = compilerCsgExactDefRetRootStatic
        return
    if exprClass == compilerCsgExactDefExprClassBorrowed:
        let ownerRow = texpr.typedExprIrBorrowOwnerForNodeExact(
            ir, returnNodeIndex, functionIndex)
        if ownerRow < 0:
            # 托管借用无 owner (C term def=-1 同构; 非 exact-nil 即拒)。
            domain = compilerCsgExactDefRetRootSentinel
            return
        if texpr.TypedExprValueDefinitionOriginKindAt(ir, ownerRow) !=
               texpr.TypedExprValueDefinitionOriginParameter:
            # Owned 本地根 (C canonical root 非 PARAM/GLOBAL 同构)。
            domain = compilerCsgExactDefRetRootOther
            return
        let ordinal =
            compilerCsgExactDefContractParamOrdinalForDefinition(
                ir, ownerRow)
        let ownerNode =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                ir, ownerRow)
        domain = compilerCsgExactDefRetRootFormal
        rootRow = ordinal
        rootTypeId = texpr.TypedExprValueDefinitionExactTypeIdAt(
            ir, ownerRow)
        formalTypeId = texpr.TypedExprIrNodeStructuralTypeIdAt(
            ir, ownerNode)
        return
    if exprClass == compilerCsgExactDefExprClassOwned:
        # 聚合构造返回 (≈C MAKE mutation scan): 返回绑定定义 → 函数内
        # 赋值语句扫描; 借用贡献根须同一形参, owned/标量贡献不计根
        # (C 55878-56020: r4<0 或 ==def 跳过, 不一致即 -1)。
        var returnDef = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.nodes2_bindingValueDefinitionRows, returnNodeIndex)
        if returnDef < 0:
            returnDef = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.nodes2_producedValueDefinitionRows,
                returnNodeIndex)
        if returnDef < 0:
            panic("compiler csg exact def contract: aggregate return binding missing")
        if texpr.TypedExprValueDefinitionOriginKindAt(ir, returnDef) ==
               texpr.TypedExprValueDefinitionOriginParameter:
            # 直接返回形参 (owned 形参直返, C root place==PARAM 同构)。
            let ordinalDirect =
                compilerCsgExactDefContractParamOrdinalForDefinition(
                    ir, returnDef)
            let defNodeDirect =
                texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                    ir, returnDef)
            domain = compilerCsgExactDefRetRootFormal
            rootRow = ordinalDirect
            rootTypeId = texpr.TypedExprValueDefinitionExactTypeIdAt(
                ir, returnDef)
            formalTypeId = texpr.TypedExprIrNodeStructuralTypeIdAt(
                ir, defNodeDirect)
            return
        let stmtStart = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.functions2_statementStarts, functionIndex)
        let stmtCount = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.functions2_statementCounts, functionIndex)
        if stmtStart < 0 || stmtCount < 0 ||
           stmtStart > ir.statements2_statementIndexs.len - stmtCount:
            panic("compiler csg exact def contract: statement CSR invalid")
        var rootFormal: int32 = -1
        var rootFormalDef: int32 = -1
        var sawBorrowContribution = false
        var rootConflict = false
        for stmtOffset in 0..<stmtCount:
            let stmtIndex = stmtStart + stmtOffset
            if ir.statements2_kinds[stmtIndex] !=
                   texpr.TypedExprIrStmtAssign:
                continue
            let lvalueNode = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_assignLvalueNodeIndexs,
                stmtIndex)
            # lvalue 基座归约到返回绑定定义 (FieldGet/IndexGet/AddrOf 链)。
            var baseNode = lvalueNode
            var hop: int32
            while baseNode >= 0 &&
                  baseNode < ir.nodes2_nodeIndexs.len &&
                  hop <= ir.nodes2_nodeIndexs.len:
                let baseOp = ir.nodes2_opKinds[baseNode]
                if baseOp != texpr.TypedExprIrOpFieldGet &&
                   baseOp != texpr.TypedExprIrOpIndexGet &&
                   baseOp != texpr.TypedExprIrOpAddrOf:
                    break
                baseNode = arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.nodes2_operand0NodeIndexs, baseNode)
                hop = hop + 1
            if baseNode < 0 || baseNode >= ir.nodes2_nodeIndexs.len:
                continue
            if arenamod.ArenaArrayInt32Get(
                   ir.arena,
                   ir.nodes2_bindingValueDefinitionRows,
                   baseNode) != returnDef:
                continue
            let rhsNode = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.statements2_rhsNodeIndexs, stmtIndex)
            if rhsNode < 0 || rhsNode >= ir.nodes2_nodeIndexs.len ||
               !ir.nodes2_resultTypeManagedFlags[rhsNode] ||
               ir.nodes2_exprClasses[rhsNode] !=
                   texpr.TypedExprExprBorrowed:
                continue
            let contributionOwner =
                texpr.typedExprIrBorrowOwnerForNodeExact(
                    ir, rhsNode, functionIndex)
            if contributionOwner < 0 || contributionOwner == returnDef:
                continue
            if texpr.TypedExprValueDefinitionOriginKindAt(
                   ir, contributionOwner) !=
                   texpr.TypedExprValueDefinitionOriginParameter:
                rootConflict = true
                continue
            let contributionOrdinal =
                compilerCsgExactDefContractParamOrdinalForDefinition(
                    ir, contributionOwner)
            if !sawBorrowContribution:
                sawBorrowContribution = true
                rootFormal = contributionOrdinal
                rootFormalDef = contributionOwner
            elif rootFormal != contributionOrdinal:
                rootConflict = true
        if rootConflict:
            domain = compilerCsgExactDefRetRootOther
            return
        if !sawBorrowContribution:
            domain = compilerCsgExactDefRetRootOther
            return
        let rootFormalNode =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                ir, rootFormalDef)
        domain = compilerCsgExactDefRetRootFormal
        rootRow = rootFormal
        rootTypeId = texpr.TypedExprValueDefinitionExactTypeIdAt(
            ir, rootFormalDef)
        formalTypeId = texpr.TypedExprIrNodeStructuralTypeIdAt(
            ir, rootFormalNode)
        return
    panic("compiler csg exact def contract: return ownership summary unproven")

# §2.3 四拒绝集的 TypedExpr 侧重述 (每函数一 bool; REPORT §6 末条)。
# memo: 每函数 0 未算/1 在栈/2 true/3 false; 在栈重入=环, C 判词真空
# 锚定 (owner 行单调结构性排除), hard-fail。
@borrows
fn compilerCsgExactDefContractFormalReadOnlyScan(
        ir: texpr.TypedExprIr,
        functionIndex: int32,
        rootFormalOrdinal: int32,
        rootDefRow: int32,
        rootParamNode: int32,
        memo: var int32[]): bool =
    if functionIndex < 0 || functionIndex >= memo.len:
        panic("compiler csg exact def contract: read-only memo row invalid")
    if memo[functionIndex] == 2:
        return true
    if memo[functionIndex] == 3:
        return false
    if memo[functionIndex] == 1:
        panic("compiler csg exact def contract: read-only callee graph cycle")
    memo[functionIndex] = 1
    var proven = true
    # 拒绝集 1 (dependent consume): manualConsume* 投影, target/source
    # ordinal 触根即拒。
    if ir.functions2_manualConsumePresents[functionIndex] &&
       (ir.functions2_manualConsumeTargetParameterOrdinals[functionIndex] ==
            rootFormalOrdinal ||
        ir.functions2_manualConsumeSourceParameterOrdinals[functionIndex] ==
            rootFormalOrdinal):
        proven = false
    if proven:
        let stmtStart = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.functions2_statementStarts, functionIndex)
        let stmtCount = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.functions2_statementCounts, functionIndex)
        if stmtStart < 0 || stmtCount < 0 ||
           stmtStart > ir.statements2_statementIndexs.len - stmtCount:
            panic("compiler csg exact def contract: read-only statement CSR invalid")
        let declarationOwner =
            compilerCsgExactDefContractCallDeclarationRows(ir)
        for stmtOffset in 0..<stmtCount:
            if !proven:
                break
            let stmtIndex = stmtStart + stmtOffset
            let stmtKind = ir.statements2_kinds[stmtIndex]
            if stmtKind == texpr.TypedExprIrStmtAssign:
                # 拒绝集 2/3 (根槽 rebind / 别名 mutation): lvalue 链根=
                # 根形参节点即拒。
                let lvalueNode = arenamod.ArenaArrayInt32Get(
                    ir.arena,
                    ir.statements2_assignLvalueNodeIndexs,
                    stmtIndex)
                var baseNode = lvalueNode
                var hop: int32
                while baseNode >= 0 &&
                      baseNode < ir.nodes2_nodeIndexs.len &&
                      hop <= ir.nodes2_nodeIndexs.len:
                    let baseOp = ir.nodes2_opKinds[baseNode]
                    if baseOp != texpr.TypedExprIrOpFieldGet &&
                       baseOp != texpr.TypedExprIrOpIndexGet &&
                       baseOp != texpr.TypedExprIrOpAddrOf:
                        break
                    baseNode = arenamod.ArenaArrayInt32Get(
                        ir.arena, ir.nodes2_operand0NodeIndexs, baseNode)
                    hop = hop + 1
                if baseNode == rootParamNode:
                    proven = false
                    break
                continue
            if stmtKind != texpr.TypedExprIrStmtCall &&
               stmtKind != texpr.TypedExprIrStmtLetCall &&
               stmtKind != texpr.TypedExprIrStmtIfCall:
                continue
            # 拒绝集 4 (未证可变调用): 调用实参 canonical owner=根 且
            # callee 该位 var 形参 → 递归契约要求。
            var callNode = arenamod.ArenaArrayInt32Get(
                ir.arena,
                ir.statements2_valueExprCallNodeIndexes,
                stmtIndex)
            if stmtKind != texpr.TypedExprIrStmtCall:
                let rhsNode = arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.statements2_rhsNodeIndexs, stmtIndex)
                if rhsNode < 0 || rhsNode >= ir.nodes2_nodeIndexs.len ||
                   ir.nodes2_opKinds[rhsNode] !=
                       texpr.TypedExprIrOpCallExpr:
                    continue
                callNode = rhsNode
            if callNode < 0 || callNode >= ir.nodes2_nodeIndexs.len:
                continue
            let declarationIndex = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_callDeclarationIndexes, callNode)
            if declarationIndex < 0 ||
               declarationIndex >=
                   declarationOwner.callDeclarationProducerFunctionRows.len:
                continue
            let calleeRow =
                declarationOwner.callDeclarationProducerFunctionRows[
                    declarationIndex]
            var linkNode = arenamod.ArenaArrayInt32Get(
                ir.arena, ir.nodes2_operand0NodeIndexs, callNode)
            var argIndex: int32
            var argHop: int32
            while linkNode >= 0 && proven &&
                  argHop <= ir.nodes2_nodeIndexs.len:
                if linkNode >= ir.nodes2_nodeIndexs.len ||
                   ir.nodes2_opKinds[linkNode] !=
                       texpr.TypedExprIrOpArgLink:
                    break
                let argNode = arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.nodes2_operand0NodeIndexs, linkNode)
                if argNode >= 0 &&
                   argNode < ir.nodes2_nodeIndexs.len &&
                   ir.nodes2_resultTypeManagedFlags[argNode] &&
                   ir.nodes2_exprClasses[argNode] ==
                       texpr.TypedExprExprBorrowed:
                    let argOwner =
                        texpr.typedExprIrBorrowOwnerForNodeExact(
                            ir, argNode, functionIndex)
                    if argOwner == rootDefRow:
                        if calleeRow < 0:
                            # importc/合成调用 var 位证据不可用即拒
                            # (C unproved mutable/borrowed value call)。
                            proven = false
                            break
                        # callee 第 argIndex 位形参的 var 性: Parameter-
                        # origin 定义 CSR 序扫描。
                        let calleeDefStart = arenamod.ArenaArrayInt32Get(
                            ir.arena,
                            ir.functions2_valueDefinitionStarts,
                            calleeRow)
                        let calleeDefCount = arenamod.ArenaArrayInt32Get(
                            ir.arena,
                            ir.functions2_valueDefinitionCounts,
                            calleeRow)
                        if calleeDefStart < 0 || calleeDefCount < 0 ||
                           calleeDefStart >
                               texpr.TypedExprValueDefinitionAuthorityCount(
                                   ir) - calleeDefCount:
                            panic("compiler csg exact def contract: callee definition CSR invalid")
                        var calleeParamDef: int32 = -1
                        var paramCursor: int32
                        for defOffset in 0..<calleeDefCount:
                            let defRow = calleeDefStart + defOffset
                            if texpr.TypedExprValueDefinitionOriginKindAt(
                                   ir, defRow) !=
                                   texpr.TypedExprValueDefinitionOriginParameter:
                                continue
                            if paramCursor == argIndex:
                                calleeParamDef = defRow
                                break
                            paramCursor = paramCursor + 1
                        if calleeParamDef < 0:
                            proven = false
                            break
                        let calleeParamNode =
                            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                                ir, calleeParamDef)
                        if calleeParamNode < 0 ||
                           calleeParamNode >=
                               ir.nodes2_paramMutableFlags.len:
                            panic("compiler csg exact def contract: callee parameter node invalid")
                        if ir.nodes2_paramMutableFlags[calleeParamNode]:
                            # var 形参: callee 必须自身五槽全证 (递归,
                            # 环 hard-fail)。
                            if !compilerCsgExactDefContractFormalReadOnlyScan(
                                   ir,
                                   calleeRow,
                                   argIndex,
                                   calleeParamDef,
                                   calleeParamNode,
                                   memo):
                                proven = false
                                break
                linkNode = arenamod.ArenaArrayInt32Get(
                    ir.arena, ir.nodes2_operand1NodeIndexs, linkNode)
                argIndex = argIndex + 1
                argHop = argHop + 1
    memo[functionIndex] = proven ? 2 : 3
    return proven

# 推导窗填充主入口 (规格 §4.5 逐条)。生产调用点: primary/backend2
# validate 深位 (死点纪律, 见本节头注释)。
@borrows
fn CompilerCsgExactDefContractWindowsBuildInto(
        ir: texpr.TypedExprIr,
        resultExprClasses: var int32[],
        formalCounts: var int32[],
        returnExactTypeIds: var int32[],
        globalTypeIds: var int32[],
        retStarts: var int32[],
        retCounts: var int32[],
        retRootDomains: var int32[],
        retRootRows: var int32[],
        retRootTypeIds: var int32[],
        retFormalTypeIds: var int32[],
        formalRootsReadOnly: var bool[],
        expectRootKinds: var int32[],
        expectFormalIndexs: var int32[],
        expectFormalMasks: var int32[],
        expectGlobalRows: var int32[],
        expectReadOnlyProofs: var int32[]) =
    resultExprClasses = []
    formalCounts = []
    returnExactTypeIds = []
    globalTypeIds = []
    retStarts = []
    retCounts = []
    retRootDomains = []
    retRootRows = []
    retRootTypeIds = []
    retFormalTypeIds = []
    formalRootsReadOnly = []
    expectRootKinds = []
    expectFormalIndexs = []
    expectFormalMasks = []
    expectGlobalRows = []
    expectReadOnlyProofs = []
    let functionCount = ir.functions2_functionNameIds.len
    if ir.functions2_resultExprClasses.len != functionCount ||
       ir.functions2_borrowsArguments.len != functionCount ||
       ir.functions2_manualConsumePresents.len != functionCount ||
       ir.functions2_manualConsumeTargetParameterOrdinals.len !=
           functionCount ||
       ir.functions2_manualConsumeSourceParameterOrdinals.len !=
           functionCount:
        panic("compiler csg exact def contract: function columns shape invalid")
    var retTotal: int32
    var readOnlyMemo: int32[]
    for row in 0..<functionCount:
        add(readOnlyMemo, 0)
    for functionIndex in 0..<functionCount:
        let exprClass = Int32(ir.functions2_resultExprClasses[functionIndex])
        add(resultExprClasses, exprClass)
        # formalCounts: valueDefinitions CSR 内 Parameter-origin 计数。
        let defStart = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.functions2_valueDefinitionStarts, functionIndex)
        let defCount = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.functions2_valueDefinitionCounts, functionIndex)
        if defStart < 0 || defCount < 0 ||
           defStart >
               texpr.TypedExprValueDefinitionAuthorityCount(ir) - defCount:
            panic("compiler csg exact def contract: definition CSR invalid")
        var formalCount: int32
        for defOffset in 0..<defCount:
            if texpr.TypedExprValueDefinitionOriginKindAt(
                   ir, defStart + defOffset) ==
                   texpr.TypedExprValueDefinitionOriginParameter:
                formalCount = formalCount + 1
        add(formalCounts, formalCount)
        # RET CSR (每函数 0/1)。
        let returnNodeIndex = arenamod.ArenaArrayInt32Get(
            ir.arena, ir.functions2_returnNodeIndexs, functionIndex)
        add(retStarts, retTotal)
        var retCount: int32
        if exprClass == compilerCsgExactDefExprClassBorrowed &&
           returnNodeIndex >= 0:
            retCount = 1
        add(retCounts, retCount)
        var returnExactTypeId: int32 = -1
        if exprClass == compilerCsgExactDefExprClassBorrowed &&
           returnNodeIndex >= 0:
            returnExactTypeId =
                texpr.TypedExprIrNodeStructuralTypeIdAt(
                    ir, returnNodeIndex)
        add(returnExactTypeIds, returnExactTypeId)
        var domain = compilerCsgExactDefRetRootOther
        var rootRow: int32 = -1
        var rootTypeId: int32 = -1
        var formalTypeId: int32 = -1
        if retCount > 0:
            compilerCsgExactDefContractRetRootAnalyze(
                ir, functionIndex, returnNodeIndex,
                domain, rootRow, rootTypeId, formalTypeId)
            add(retRootDomains, domain)
            add(retRootRows, rootRow)
            add(retRootTypeIds, rootTypeId)
            add(retFormalTypeIds, formalTypeId)
            retTotal = retTotal + 1
        # 函数级直读五元组 (expect 快照窗) + read-only 证据窗。
        var rootKind = compilerCsgExactDefContractRootUnknownTag
        var formalIndex: int32 = -1
        var formalMask: int32
        var globalRow: int32 = -1
        var readOnlyProof = compilerCsgExactDefContractReadOnlyUnknownTag
        var rootReadOnly = false
        if exprClass == compilerCsgExactDefExprClassBorrowed && retCount > 0:
            if domain == compilerCsgExactDefRetRootFormal:
                let rootDefRow =
                    compilerCsgExactDefContractParamDefinitionForOrdinal(
                        ir, functionIndex, rootRow)
                if rootDefRow < 0:
                    panic("compiler csg exact def contract: formal root definition missing")
                let rootParamNode =
                    texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                        ir, rootDefRow)
                rootReadOnly =
                    compilerCsgExactDefContractFormalReadOnlyScan(
                        ir, functionIndex, rootRow, rootDefRow,
                        rootParamNode, readOnlyMemo)
                rootKind = compilerCsgExactDefContractRootFormalTag
                formalIndex = rootRow
                formalMask = 1 << rootRow
                if rootReadOnly:
                    readOnlyProof =
                        compilerCsgExactDefContractReadOnlyProvenTag
            elif domain == compilerCsgExactDefRetRootStatic:
                rootKind = compilerCsgExactDefContractRootStaticTag
        add(formalRootsReadOnly, rootReadOnly)
        add(expectRootKinds, rootKind)
        add(expectFormalIndexs, formalIndex)
        add(expectFormalMasks, formalMask)
        add(expectGlobalRows, globalRow)
        add(expectReadOnlyProofs, readOnlyProof)

@borrows
fn compilerCsgExactDefContractParamDefinitionForOrdinal(
        ir: texpr.TypedExprIr,
        functionIndex: int32,
        ordinal: int32): int32 =
    let defStart = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_valueDefinitionStarts, functionIndex)
    let defCount = arenamod.ArenaArrayInt32Get(
        ir.arena, ir.functions2_valueDefinitionCounts, functionIndex)
    if defStart < 0 || defCount < 0 ||
       defStart >
           texpr.TypedExprValueDefinitionAuthorityCount(ir) - defCount:
        panic("compiler csg exact def contract: definition CSR invalid")
    var paramCursor: int32
    for defOffset in 0..<defCount:
        let defRow = defStart + defOffset
        if texpr.TypedExprValueDefinitionOriginKindAt(ir, defRow) !=
               texpr.TypedExprValueDefinitionOriginParameter:
            continue
        if paramCursor == ordinal:
            return defRow
        paramCursor = paramCursor + 1
    return -1
