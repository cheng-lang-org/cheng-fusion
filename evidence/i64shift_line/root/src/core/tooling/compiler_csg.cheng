        activeCurrentProfileNormalizedText: str
        activeLocalCallLookup: parser.ParserTextLookup
        activeImportcCallLookup: parser.ParserTextLookup
        activeCompactProfileView: CompilerCsgCompactProfileView
        activeCompactProfileCacheOverlay: CompilerCsgProfileCallLookupOverlay
        activeCompactProfileViewOwned: bool
        compactProfileViewLifecycle: CompilerCsgCompactProfileViewLifecycle
        activeFactsContext: texpr.TypedExprSourceContext
        activeSliceExprLayer: parser.NormalizedExprLayer
        activeSliceTypedFacts: TypedExprFactTable
        modules: str[]
        importPairs: CompilerCsgImportPair[]
        moduleSeen: CompilerCsgTextSet
        functionSemanticIdentityIndex: CompilerCsgSemanticIdentityIndex
        functionSemanticIdentityIndexOwned: bool
        importPairSeen: CompilerCsgImportPairLookup
        nodes: CompilerCsgNode[]
        edges: CompilerCsgEdge[]
        exprLayer: parser.NormalizedExprLayer
        # [S1b step-3 (6)] The merged parser forest no longer exists.  Pass 0
        # measures every source and seals the declaration index; pass 1
        # re-parses one source at a time and consumes it before releasing it,
        # so no consumer ever needs a forest-resident tree.
        # [S1b-0a] Exact per-source arena bytes measured by the declaration
        # index pass (pass 0).  Indexed by producerSourceIndex; entry i is the
        # ArenaUsed of source i's own single-source tree.  This is the only
        # admissible reserve value for the materialization pass: it is a
        # per-source measured fact, never a byte-count heuristic.
        typeArenaForestSourceArenaBytes: int32[]
        # [U0-cut] Flat per-source census of every parser tree arena column's
        # final length, measured by the same pass-0 parse that produced
        # `typeArenaForestSourceArenaBytes`.  Entry `i * ParserValueExprTreeArenaColumnCount + j`
        # is source i's column j.  Pass 1 reserves each column at that length
        # so `ArenaArrayInt32Add` never abandons a block, which removes
        # `U0/2 - 16*C` resident bytes per source.
        typeArenaForestSourceColumnCensus: int32[]
        # [M3-D6] Per-source arena bytes measured by the early reserve-measure
        # pass (mounted right after the ordered source list is sorted, at the
        # lowest floor the parse window can run at).  Entry i is the exact
        # ArenaUsed of source i's tree parsed through the same entry pass 0
        # uses, so pass 0 reserves that value (+64KiB) before its first arena
        # allocation and never enters the doubling grow path whose
        # old-block/new-block coexistence was the M3 RSS kill at src=61
        # (.rebuild/m3attrib_line/M3_ATTRIB.md).  Pass 0's own readback must
        # reproduce entry i byte for byte; any mismatch is a hard defect.
        typeArenaForestSourceArenaReserveMeasures: int32[]
        typeArena: typearena.TypedExprTypeArena
        typeArenaMissingResolutionAuthorityCount: int32
        typeDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
        ownershipDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
        layoutDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
        concurrencyDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
        packageNode: CompilerCsgNode
        moduleNodeIds: int32[]
        orderedSources: str[]
        orderedSourceModules: str[]
        orderedSourceIndex: CompilerCsgSourcePathIndex
        sourceSnapshots: CompilerCsgSourceText[]
        sourceSnapshotIndex: CompilerCsgSourcePathIndex
        typedSourceTexts: TypedExprSourceText[]
        typedSourceTextIndex: CompilerCsgSourcePathIndex
        frontierTypedSourceTexts: TypedExprSourceText[]
        frontierTypedSourceTextIndex: CompilerCsgSourcePathIndex
        typedMetadataContexts: texpr.TypedExprSourceContext[]
        exprCallProfiles: parser.NormalizedExprCallProfile[]
        profileLineCounts: int32[]
        profileImportcMasks: str[]
        semanticGraph: CompilerCsgSemanticGraph
        semanticTypedFactAccumulator: CompilerCsgSemanticTypedFactAccumulator
        profileIndexLookup: parser.ParserSourcePathIndexLookup
        profileCallLookupCache: CompilerCsgProfileCallLookupStore
        frontierParsedSources: CompilerCsgFrontierParsedSourceStore
        reachableSet: CompilerCsgReachableFunctionSet
        functionGraphNodes: CompilerCsgFunctionGraphNodeColumn
        # PhaseArena CSG 半片: graphNodeId 列的单一托管权威。生命周期 =
        # reachable-set 相位 (195xx init → 209xx 整批 reset), 与
        # functionGraphNodes 句柄列同生共死; active 标志供 abort 路径
        # (CompilerCsgBuildWorkingSetRelease) 幂等 teardown。
        graphNodeStore: phase.PhaseArenaStore
        graphNodeStoreActive: bool
        graphNodeArena: phase.PhaseArenaHandle
        # PhaseArena CSG 文本族半片 (七条② intern-ID 列路线): exprCallProfiles
        # 各行文本由 lineInternPool 单一持有 (相位域, 相位末 InternPoolRelease
        # 整批灭), 每 profile 的行号→InternId 列进真实 PhaseArenaStore
        # (lineStore), 相位末整批 reset。profile.lines 本体在 append-move 后
        # 即空 (原 ORC 行表当场 freeSeqStrRelease), 消费侧经
        # CompilerCsgProfileLineSeqFromArena 物化共享拷贝 (add retain,
        # 与 CompilerCsgCloneStrSeq 同语义)。
        lineInternPool: langintern.InternPool
        lineInternPoolActive: bool
        lineStore: phase.PhaseArenaStore
        lineStoreActive: bool
        lineArena: phase.PhaseArenaHandle
        profileLineIdColumns: phase.PhaseArenaRef[]
        profileLineIdCounts: int32[]
        # PhaseArena CSG 字符串半片: TypedIR 轮次报告短文本 (ms/new/build
        # 三段 CSV parts) 的单一托管权威。数字直接格式化进定容 payload,
        # 全程不注册全局字符串; 精确幸存者 (最终三条 CSV) 在阶段末经
        # StrCopyOutOwned 显式转移, 随后整批 reset+close+destroy; abort 路径
        # 经 WorkingSetRelease 幂等 teardown。轮次上界已有硬门禁
        # (typedIrReachRound > functionCount+1 即 fail), 容量按 3*(N+2)
        # 段、每段 20B 精确预留, 溢出即 spill hard-fail, 无静默扩容。
        roundTextStore: phase.PhaseArenaStore
        roundTextStoreActive: bool
        roundTextArena: phase.PhaseArenaHandle
        typedIrRoundBuildMsPartRefs: phase.PhaseArenaRef[]
        typedIrRoundNewReachableCountPartRefs: phase.PhaseArenaRef[]
        typedIrRoundBuildCountPartRefs: phase.PhaseArenaRef[]
        reachScanProcessedFunctions: bool[]
        reachScanLocalScannedProfiles: bool[]
        reachScanReachableCursor: int32
        reachScanQueuedProfiles: bool[]
        reachScanPendingProfiles: int32[]
        activeFunctionSourceSlices: fslice.FunctionSourceSliceIndex
        activeFunctionSourceSlicesOwned: bool
        semanticFactProcessedFunctions: bool[]
        semanticExprSummarySourceCounted: bool[]
        reachableFilterSourcePaths: str[]
        reachableFilterFunctionNames: str[]
        reachableFilterStartLines: int32[]
        reachableFilterFunctionIndexes: int32[]
        frontierSourcePaths: str[]
        typedIr: texpr.TypedExprIr
        fnPtrFieldCalls: CompilerCsgFnPtrFieldCallTable
        externFfiHandleContracts: CompilerCsgExternFfiHandleContractTable
        externFfiHandleCallCapabilities:
            CompilerCsgExternFfiHandleCallCapabilityTable
        typedIrRoundFacts: TypedExprFactTable
        typedIrProcessedFunctions: bool[]
        typedIrReachableCursor: int32
        typedIrReachStatementCursor: int32
        typedIrReachFunctionCursor: int32
        frontierIndex: CompilerCsgFrontierIndex

    CompilerLegacySourceUnit =
        sourcePath: str
        targetSourcePath: str
        modulePath: str
        legacyText: str
        migratedText: str

    CompilerMigrationArtifact =
        sourceIdentityReceipt: PortableSourceIdentityReceipt
        canonicalCsgReport: str
        canonicalGraphCid: layout.FixedBytes32
        exportSurface: CsgExportSurface

    CompilerLegacyMigration =
        packageId: str
        entrySourcePath: str
        entryModulePath: str
        unitCount: int32
        units: CompilerLegacySourceUnit[]
        appliedRuleCount: int32
        appliedRules: str[]
        legacySourceBundleCid: layout.FixedBytes32
        migratedSourceBundleCid: layout.FixedBytes32
        baselineArtifact: CompilerMigrationArtifact
