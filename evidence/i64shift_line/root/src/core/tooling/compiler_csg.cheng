        CompilerCsgCloneFixed32Seq(source.callCapabilityCids)
    out.effectRows = source.effectRows
    out.effectKinds = source.effectKinds
    out.effectTargetKinds = source.effectTargetKinds
    out.effectParameterOrdinals = source.effectParameterOrdinals
    out.effectArgumentRows = source.effectArgumentRows
    out.effectArgumentValueNodeIndexes =
        source.effectArgumentValueNodeIndexes
    out.effectValueDefinitionRows = source.effectValueDefinitionRows
    out.effectGenerationRootValueDefinitionRows =
        source.effectGenerationRootValueDefinitionRows
    out.effectExactTypeIds = source.effectExactTypeIds
    out.effectCarrierKinds = source.effectCarrierKinds
    out.effectArgumentBindingCids =
        CompilerCsgCloneFixed32Seq(source.effectArgumentBindingCids)
    out.effectTypeCids =
        CompilerCsgCloneFixed32Seq(source.effectTypeCids)
    out.effectGenerationCids =
        CompilerCsgCloneFixed32Seq(source.effectGenerationCids)
    out.effectDefinitionLineageCids =
        CompilerCsgCloneFixed32Seq(source.effectDefinitionLineageCids)
    out.effectCapabilityCids =
        CompilerCsgCloneFixed32Seq(source.effectCapabilityCids)
    out.cargoCid = source.cargoCid
    out.complete = source.complete
    return out

