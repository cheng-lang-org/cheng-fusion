        compilerCsgMemTraceEmit("forest_build_done")
    if compilerCsgMemTrace && typeDeclarationIndex.sealed:
        let declarationIndexTag = Fmt"decl_index entries={typeDeclarationIndex.producerSourceIndexes.len} sources={typeDeclarationIndex.producerSourceCount} type_syntax={typeDeclarationIndex.typeSyntaxCount} declarations={typeDeclarationIndex.declarationCount} verified=0"
