        freeSeq(sidecar.typeGenericSymbolChildCounts)
        freeSeq(sidecar.typeGenericSymbolChildTypeSyntaxIds)
        freeSeq(sidecar.declarationProducerSourceIds)
        freeSeq(sidecar.declarationSourceLocalRows)
