        return CompilerCsgBuildAbort(work)
    if typedIrBuildIndexSealedValidationCount !=
           typedIrBuildIndexSealedFactsCount + typedIrBuildIndexSealedAppendCount:
        err = Fmt" compiler csg: typed ir sealed validation count mismatch validations={typedIrBuildIndexSealedValidationCount} facts={typedIrBuildIndexSealedFactsCount} appends={typedIrBuildIndexSealedAppendCount}"
        return CompilerCsgBuildAbort(work)
    if typedIrBuildIndexMetadataRowsVisitedAfterSeal !=
           typedIrBuildIndexSealedFactsMetadataRows +
               typedIrBuildIndexSealedAppendMetadataRows:
        err = Fmt" compiler csg: typed ir sealed metadata row receipt mismatch visited={typedIrBuildIndexMetadataRowsVisitedAfterSeal} facts={typedIrBuildIndexSealedFactsMetadataRows} appends={typedIrBuildIndexSealedAppendMetadataRows}"
        return CompilerCsgBuildAbort(work)
    if !texpr.TypedExprMetadataVisitReceiptExact(
            typedIrBuildIndexMetadataContextCountExpectedAfterSeal,
            typedIrBuildIndexMetadataContextCountObservedAfterSeal,
            typedIrBuildIndexMetadataRowsExpectedAfterSeal,
            typedIrBuildIndexMetadataRowsVisitedAfterSeal):
        err = Fmt" compiler csg: typed ir sealed metadata conservation mismatch contexts_expected={typedIrBuildIndexMetadataContextCountExpectedAfterSeal} contexts_observed={typedIrBuildIndexMetadataContextCountObservedAfterSeal} rows_expected={typedIrBuildIndexMetadataRowsExpectedAfterSeal} rows_observed={typedIrBuildIndexMetadataRowsVisitedAfterSeal}"
        return CompilerCsgBuildAbort(work)
    if typedIrBuildIndexFullValidationCount != 1 ||
       typedIrBuildIndexMetadataRowsExpectedAfterSeal != Int64(0) ||
       typedIrBuildIndexMetadataRowsVisitedAfterSeal != Int64(0):
        err = Fmt" compiler csg: typed ir frozen metadata fixed-point telemetry invalid full_validations={typedIrBuildIndexFullValidationCount} rows_visited={typedIrBuildIndexMetadataRowsVisitedAfterSeal}"
        return CompilerCsgBuildAbort(work)
    let finalAuditReuseCountBefore = texpr.TypedExprBuildIndexReuseCount(fixedPointBuildIndex)
    let finalAuditContextCount =
        texpr.TypedExprBuildIndexContextCount(fixedPointBuildIndex)
    if finalAuditContextCount <= 0 || work.typedMetadataContexts.len != 0:
        err = Fmt" compiler csg: typed ir final metadata audit ownership mismatch index={finalAuditContextCount} caller_contexts={work.typedMetadataContexts.len}"
        return CompilerCsgBuildAbort(work)
    if !texpr.TypedExprCloseSealedBuildSourceContextIndex(work.typedIr,
                                                          typedIrErr):
        if typedIrErr != "":
            err = typedIrErr
        else:
            err = " compiler csg: typed ir frozen metadata close failed"
        return CompilerCsgBuildAbort(work)
    if !texpr.TypedExprSealedBuildIndexClosed(work.typedIr) ||
       texpr.TypedExprSealedBuildIndexActive(work.typedIr):
        err = " compiler csg: typed ir frozen metadata session did not close"
        return CompilerCsgBuildAbort(work)
    let finalAuditBuildIndex = work.typedIr.buildIndex
    let finalAuditValidationEpoch =
        texpr.TypedExprSealedBuildIndexValidationEpoch(work.typedIr)
    typedIrBuildIndexValidationEpochAfterClose = finalAuditValidationEpoch
    let finalAuditReuseCount =
        texpr.TypedExprBuildIndexReuseCount(finalAuditBuildIndex)
    typedIrBuildIndexFullValidationCount =
        texpr.TypedExprSealedBuildIndexFullValidationCount(work.typedIr)
    if texpr.TypedExprBuildIndexBuildGeneration(finalAuditBuildIndex) !=
           typedIrBuildIndexGeneration ||
       texpr.TypedExprSealedBuildIndexSessionGeneration(work.typedIr) !=
           typedIrBuildIndexSessionGeneration ||
       texpr.TypedExprBuildIndexContextCount(finalAuditBuildIndex) !=
           typedIrBuildIndexContextCountAtSeal ||
       finalAuditValidationEpoch !=
           typedIrBuildIndexValidationEpochAfterFixedPoint + finalAuditContextCount ||
       finalAuditReuseCount != finalAuditReuseCountBefore + 1 ||
       typedIrBuildIndexFullValidationCount != 2 ||
       texpr.TypedExprSealedBuildIndexValidationCount(work.typedIr) !=
           typedIrBuildIndexSealedValidationCount ||
       texpr.TypedExprSealedBuildIndexMetadataRowsVisited(work.typedIr) !=
           typedIrBuildIndexMetadataRowsVisitedAfterSeal:
        err = Fmt" compiler csg: typed ir final metadata audit accounting mismatch generation={texpr.TypedExprBuildIndexBuildGeneration(finalAuditBuildIndex)} expected_generation={typedIrBuildIndexGeneration} epoch={finalAuditValidationEpoch} expected_epoch={typedIrBuildIndexValidationEpochAfterFixedPoint + finalAuditContextCount} reuse={finalAuditReuseCount} expected_reuse={finalAuditReuseCountBefore + 1} full_validations={typedIrBuildIndexFullValidationCount}"
        return CompilerCsgBuildAbort(work)
    let csgPhaseAfterENs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    # The fixed point above contains the last late-reachability and TypedIR
    # consumers. Drop mutable body references first, then the sole immutable
    # source owner; no later phase may reload source text.
    CompilerCsgReleaseFrontierTypedSourceTexts(work.frontierTypedSourceTexts,
                                               work.frontierTypedSourceTextIndex)
    CompilerCsgClearMutableSourceTextBodies(work.typedSourceTexts)
    CompilerCsgSourcePathIndexClear(work.typedSourceTextIndex)
    CompilerCsgReleaseImmutableSourceSnapshots(work.sourceSnapshots,
                                               work.sourceSnapshotIndex)
    let _immutableSourceSnapshotRelief = os.ProcessMemoryPressureRelief()
    CompilerCsgTraceStage("after_immutable_source_snapshot_release")
    let releasedProfileIndexLookup =
        parser.ParserSourcePathIndexLookup()
    work.profileIndexLookup = releasedProfileIndexLookup
    let releasedProfileCallLookupCache =
        CompilerCsgProfileCallLookupStore()
    work.profileCallLookupCache = releasedProfileCallLookupCache
    # wave-17 定点修复: release the per-file profile working set (owned line
    # tables) instead of abandoning it — see
    # CompilerCsgReleaseExprCallProfiles for the ownership evidence.
    CompilerCsgReleaseExprCallProfiles(work.exprCallProfiles)
    work.reachableFilterSourcePaths = []
    work.reachableFilterFunctionNames = []
    work.reachableFilterStartLines = []
    work.reachableFilterFunctionIndexes = []
    work.typedIrProcessedFunctions = []
    if !CompilerCsgSemanticBuildReachableTable(work.semanticGraph,
                                         work.orderedSources,
                                         work.reachableSet,
                                         work.orderedSourceIndex,
                                         err):
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgSemanticBindReachableGraphNodeIds(
            work.semanticGraph,
            work.graphNodeStore,
            work.graphNodeArena,
            work.functionGraphNodes,
            work.reachableSet,
            work.nodes,
            err):
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgSemanticFinalizeResolvedCallFunctionAdjacency(work.semanticGraph.resolvedCallTable,
                                                           work.reachableSet,
                                                           work.semanticGraph.reachableFunctionTable.graphNodeIds,
                                                           work.typedIr,
                                                           work.semanticGraph.exprSliceTable,
                                                           work.parserNormalizedExprReceiptAccumulator,
                                                           err):
        return CompilerCsgBuildAbort(work)
    # The adjacency finalizer consumes the active accumulator's exact parser
    # declaration sidecars. Finalization moves those sidecars into the immutable
    # receipt, so it must happen only after this last accumulator consumer.
    var parserReceiptCoverage: bool[]
    let parserReceiptCoversAllFunctions =
        reuseLinkPlanExprLayer || !work.reachableSet.active
    if !compilerCsgBuildParserReceiptCoverageRec(
           work, parserReceiptCoverage, parserReceiptCoversAllFunctions, 0):
        return CompilerCsgBuildAbort(work)
    let parserReceiptRes =
        parser_receipt.ParserNormalizedExprReceiptFinalize(
            work.parserNormalizedExprReceiptAccumulator,
            parserReceiptCoverage)
    if IsErr(parserReceiptRes):
        err = Error(parserReceiptRes)
        return CompilerCsgBuildAbort(work)
    let parserNormalizedExprReceipt = Value(parserReceiptRes)
    work.parserNormalizedExprReceipt =
        parserNormalizedExprReceipt
    let parserReceiptVerifyRes =
        parser_receipt.ParserNormalizedExprReceiptVerify(
            work.parserNormalizedExprReceipt)
    if IsErr(parserReceiptVerifyRes):
        err = Error(parserReceiptVerifyRes)
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgTypedIrGlobalParserIdentityStrictValidateInto(
           work.typedIr,
           work.parserNormalizedExprReceipt,
           err):
        return CompilerCsgBuildAbort(work)
    if !texpr.TypedExprIrSealExactTypeArena(
           work.typedIr, work.typeArena, err):
        return CompilerCsgBuildAbort(work)
    if !compilerCsgTypedIrValueDefinitionTypeArenaReplayInto(
           work.typedIr,
           work.parserNormalizedExprReceipt,
           work.typeArena,
           err):
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgSemanticResolvedCallParserOriginsStrictValidateInto(
           work.semanticGraph.resolvedCallTable,
           work.parserNormalizedExprReceipt,
           err):
        return CompilerCsgBuildAbort(work)
    let typedIrReachabilityResolvedCallRowVisitCount =
        work.reachableSet.resolvedCallRowVisitCount
    let reachabilityNameHashOperationCount =
        work.reachableSet.scopedFunctionNames.hashOperationCount +
        work.reachableSet.globalFunctionNames.hashOperationCount
    let reachabilityNameHashProbeCount =
        work.reachableSet.scopedFunctionNames.hashProbeCount +
        work.reachableSet.globalFunctionNames.hashProbeCount
    var reachabilityNameHashMaxProbeCount =
        work.reachableSet.scopedFunctionNames.hashMaxProbeCount
    if work.reachableSet.globalFunctionNames.hashMaxProbeCount >
       reachabilityNameHashMaxProbeCount:
        reachabilityNameHashMaxProbeCount =
            work.reachableSet.globalFunctionNames.hashMaxProbeCount
    let reachabilityNameIndexEntryCount =
        work.reachableSet.scopedFunctionNames.profileIndexes.len +
        work.reachableSet.globalFunctionNames.profileIndexes.len
    let reachabilityLineBinarySearchOperationCount =
        work.reachableSet.lineBinarySearchOperationCount
    let reachabilityLineBinarySearchProbeCount =
        work.reachableSet.lineBinarySearchProbeCount
    let reachabilityLineBinarySearchMaxProbeCount =
        work.reachableSet.lineBinarySearchMaxProbeCount
    let reachabilityEdgePairOperationCount =
        work.reachableSet.edgePairOperationCount
    let reachabilityEdgePairProbeCount =
        work.reachableSet.edgePairProbeCount
    let reachabilityEdgePairMaxProbeCount =
        work.reachableSet.edgePairMaxProbeCount
    let reachabilityFinalEdgeCount = work.reachableSet.edgeFrom.len
    CompilerCsgDebugLine("compiler_csg_before_prune_graph")
    CompilerCsgPruneGraphForReachable(work.graphNodeStore,
                                      work.graphNodeArena,
                                      work.nodes,
                                      work.edges,
                                      work.reachableSet,
                                      work.functionGraphNodes)
    CompilerCsgDebugLine(Fmt"compiler_csg_after_prune_graph nodes={work.nodes.len} edges={work.edges.len}")
    CompilerCsgPruneSourceTextsForReachable(work.typedSourceTexts, work.reachableSet)
    CompilerCsgDebugLine(Fmt"compiler_csg_after_prune_source_texts sources={work.typedSourceTexts.len}")
    # PhaseArena CSG 半片 (七条②): reachable-set 相位结束, graphNodeId 列
    # 整批 reset (代际 +1, 滞留句柄 stale-generation 立即 hard-fail) 并交还
    # 托管权威 —— 替代原 ORC seq 的整体遗弃。
    CompilerCsgPhaseArenaGraphNodeStoreReset(work)
    let releasedFunctionGraphNodes =
        CompilerCsgFunctionGraphNodeColumn()
    work.functionGraphNodes = releasedFunctionGraphNodes
    CompilerCsgReachableFunctionSetReleaseIndexes(work.reachableSet)
    let releasedReachableSet =
        CompilerCsgReachableFunctionSet()
    work.reachableSet = releasedReachableSet
    CompilerCsgDebugLine("compiler_csg_after_reachable_reset")
    # wave-17 定点修复: release accumulated metadata contexts (owned line
    # tables + seq buffers) instead of abandoning them.
    CompilerCsgReleaseMetadataContexts(work.typedMetadataContexts)
    let _metadataRelief = os.ProcessMemoryPressureRelief()
    CompilerCsgDebugLine("compiler_csg_after_metadata_clear")
    let zeroFunctionTypedIr =
        work.parserNormalizedExprReceipt.functionCount == Int64(0) &&
        work.semanticGraph.reachableFunctionTable.functionNames.len == 0 &&
        typedIrReachRound == 0 &&
        typedIrRebuildSourceCount == 0 &&
        typedIrNewFunctionCount == 0 &&
        texpr.TypedExprIrZeroFunctionDomainStrictValidate(work.typedIr)
    if work.typedIr.functions2_functionNameIds.len <= 0 &&
       !zeroFunctionTypedIr:
        err = Fmt" compiler csg: typed ir empty after build source_count={work.typedSourceTexts.len} fact_count={typedExprFactCountForCid} expr_count={streamedExprCountAfterFixedPoint} working_expr_count={workingExprCountAfterFixedPoint}"
        return CompilerCsgBuildAbort(work)
    CompilerCsgDebugLine("compiler_csg_before_typed_ir_compact")
    texpr.TypedExprIrCompactForBackend(work.typedIr)
    CompilerCsgDebugLine("compiler_csg_after_typed_ir_compact")
    CompilerCsgSemanticTypedFactAccumulatorFinish(work.semanticGraph, work.semanticTypedFactAccumulator)
    if !CompilerCsgSemanticResolvedCallTableValidate(work.semanticGraph.resolvedCallTable,
                                               work.typedIr.functions2_functionNameIds.len,
                                               err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgSemanticEnsureExprSliceTypedFactCoverage(work.semanticGraph)
    if !work.semanticGraph.exprSliceTypedFactComplete:
        err = Fmt" compiler csg: final typed-fact slice validation failed reason={work.semanticGraph.exprSliceValidationReason} covered={work.semanticGraph.exprSliceTypedFactCoveredCount} gaps={work.semanticGraph.exprSliceTypedFactGapCount} overlaps={work.semanticGraph.exprSliceTypedFactOverlapCount} invalid={work.semanticGraph.exprSliceTypedFactInvalidSliceCount}"
        return CompilerCsgBuildAbort(work)
    typedExprFactCountForCid = CompilerCsgSemanticTypedFactCount(work.semanticGraph)
    if !CompilerCsgSemanticBuildTypedIrTable(work.semanticGraph,
                                       work.orderedSources,
                                       work.orderedSourceIndex,
                                       work.typedIr,
                                       semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgTypedNodeAuthorityBindInto(
           work.typedIr,
           work.parserNormalizedExprReceipt,
           work.typeArena,
           work.semanticGraph,
           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    if !compilerCsgBindFnPtrFieldCallFactsInto(
           work.typedIr,
           work.typeArena,
           work.fnPtrFieldCalls,
           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgSemanticValidateTypedFactSemanticConservation(work.semanticGraph,
                                                           work.typedIr,
                                                           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    # The typed stage owns these source completions. They are sealed before
    # CompilerCSG commits its output; downstream snapshot code may only replay.
    var pendingTypeDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
    pendingTypeDiagnosticCompletions =
        compilerCsgDiagnosticRowsPayloadClone(
            work.typeDiagnosticCompletions)
    var pendingTypeDiagnosticStageReceipt: stage_receipt.CompilerStageReceipt
    if !compilerCsgTypeDiagnosticStageProduceInto(
           work.parserNormalizedExprReceipt,
           work.typeArena,
           pendingTypeDiagnosticCompletions,
           pendingTypeDiagnosticStageReceipt,
           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    # Ownership completion is sealed only after TypedExpr node/value-definition
    # ownership has been bound and strictly replayed against the TypeArena.
    var pendingOwnershipDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
    pendingOwnershipDiagnosticCompletions =
        compilerCsgDiagnosticRowsPayloadClone(
            work.ownershipDiagnosticCompletions)
    var pendingOwnershipDiagnosticStageReceipt: stage_receipt.CompilerStageReceipt
    if !compilerCsgOwnershipDiagnosticStageProduceInto(
           work.parserNormalizedExprReceipt,
           work.typeArena,
           work.typedIr,
           work.semanticGraph,
           pendingTypeDiagnosticStageReceipt,
           pendingOwnershipDiagnosticCompletions,
           pendingOwnershipDiagnosticStageReceipt,
           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    # Exact layout rows and the structural TypeArena are frozen before this
    # point; layout completion owns their numeric row-coordinate digest.
    var pendingLayoutDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
    pendingLayoutDiagnosticCompletions =
        compilerCsgDiagnosticRowsPayloadClone(
            work.layoutDiagnosticCompletions)
    var pendingLayoutDiagnosticStageReceipt: stage_receipt.CompilerStageReceipt
    if !compilerCsgLayoutDiagnosticStageProduceInto(
           work.parserNormalizedExprReceipt,
           work.typeArena,
           work.typedIr,
           work.semanticGraph,
           pendingOwnershipDiagnosticStageReceipt,
           pendingLayoutDiagnosticCompletions,
           pendingLayoutDiagnosticStageReceipt,
           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    # Send/Sync traits, typed-node trait projections, and exact parser
    # thread-boundary rows have all passed their authority joins here.
    var pendingConcurrencyDiagnosticCompletions: CompilerCsgTypeDiagnosticCompletionTable
    pendingConcurrencyDiagnosticCompletions =
        compilerCsgDiagnosticRowsPayloadClone(
            work.concurrencyDiagnosticCompletions)
    var pendingConcurrencyDiagnosticStageReceipt: stage_receipt.CompilerStageReceipt
    if !compilerCsgConcurrencyDiagnosticStageProduceInto(
           work.parserNormalizedExprReceipt,
           work.typeArena,
           work.typedIr,
           work.semanticGraph,
           pendingLayoutDiagnosticStageReceipt,
           pendingConcurrencyDiagnosticCompletions,
           pendingConcurrencyDiagnosticStageReceipt,
           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    # Consume only the immutable exact-tree parser receipt. The builder stages
    # every table row and normalized graph carrier, validates the whole
    # projection, then commits once; no source reparse or TypedExpr copy exists.
    if !compilerCsgExternFfiHandleContractTableBuildInto(
           work.parserNormalizedExprReceipt,
           work.typeArena,
           work.semanticGraph,
           work.nodes,
           work.edges,
           work.externFfiHandleContracts,
           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    if !compilerCsgExternFfiHandleCallCapabilityTableBuildInto(
           work.parserNormalizedExprReceipt,
           work.typeArena,
           work.semanticGraph,
           work.typedIr,
           work.externFfiHandleContracts,
           work.externFfiHandleCallCapabilities,
           semanticGraphTableErr):
        err = semanticGraphTableErr
        return CompilerCsgBuildAbort(work)
    # NormalizedExprLayer is build scratch only. All production consumers below
    # read canonical semantic graph/TypedIR facts, so clear row strings and drop every backing
    # buffer before CID generation and output commit.
    CompilerCsgDebugLine("compiler_csg_before_canonical_graph_cid")
    if os.GetEnv("CHENG_COMPILER_CSG_LEGACY_CANONICAL_CID_DIAGNOSTIC") == "1":
        let canonicalGraphCidLegacy = CompilerCsgCanonicalGraphCid(linkPlan.packageId,
                                                                  work.nodes,
                                                                  work.edges)
        os.WriteLine(os.Get_stderr(),
                     Fmt"compiler_csg_legacy_canonical_graph_cid={layout.FixedBytes32Hex(canonicalGraphCidLegacy)}")
    # content-addressed normalized cid (csg_normalize.cheng): 消位置性 nodeId +
    # ownerNodeId 污染 + 插入序敏感, 使 def 重排后 cid 稳定。旧算法仅由上方
    # 显式诊断开关执行，生产真值 = 此 normalize 结果。
    let canonicalGraphCid = csgnorm.CsgNormalizedGraphCid(linkPlan.packageId,
                                                            work.nodes,
                                                            work.edges)
    CompilerCsgDebugLine("compiler_csg_after_canonical_graph_cid")
    let graphCid = CompilerCsgGraphCid(linkPlan.packageId,
                                        sourceBundleCid,
                                        linkPlan.workspaceRoot,
                                        linkPlan.packageRoot,
                                        work.externalPackageRoots,
                                        sourceTextOverrides,
                                        work.semanticGraph,
                                        work.nodes,
                                        work.edges)
    CompilerCsgDebugLine("compiler_csg_after_graph_cid")
    if requirePortableReceipt &&
       !CompilerCsgTransitionReceiptMakeInto(
           sourceReceipt,
           work.parserNormalizedExprReceipt.envelope.receiptRaw32,
           graphCid,
           canonicalGraphCid,
           pendingTransitionReceipt,
           err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgNormalizedExprLayerTerminalRelease(out.exprLayer)
    let _finalExprLayerRelief = os.ProcessMemoryPressureRelief()
    CompilerCsgDebugLine("compiler_csg_before_out_scalars")
    out.packageId = linkPlan.packageId
    out.sourceBundleCid = sourceBundleCid
    out.sourceSnapshotCount = sourceSnapshotCount
    out.entrySourceCid = entrySourceCid
    parser_receipt.ParserNormalizedExprReceiptMoveInto(
        out.parserNormalizedExprReceipt,
        work.parserNormalizedExprReceipt)
    CompilerCsgDebugLine("compiler_csg_before_out_expr_layer")
    CompilerCsgDebugLine("compiler_csg_after_out_expr_layer")
    var ownedOutTypeArena: typearena.TypedExprTypeArena
    ownedOutTypeArena = out.typeArena
    out.typeArena = nil
    typearena.TypedExprTypeArenaReleaseOwned(ownedOutTypeArena)
    out.typeArena = work.typeArena
    work.typeArena = nil
    out.typeArenaMissingResolutionAuthorityCount =
        work.typeArenaMissingResolutionAuthorityCount
    work.typeArenaMissingResolutionAuthorityCount = 0
    out.typeDiagnosticCompletions =
        pendingTypeDiagnosticCompletions
    pendingTypeDiagnosticCompletions =
        CompilerCsgTypeDiagnosticCompletionTable()
    out.typeDiagnosticStageReceipt =
        pendingTypeDiagnosticStageReceipt
    pendingTypeDiagnosticStageReceipt =
        stage_receipt.CompilerStageReceipt()
    out.ownershipDiagnosticCompletions =
        pendingOwnershipDiagnosticCompletions
    pendingOwnershipDiagnosticCompletions =
        CompilerCsgTypeDiagnosticCompletionTable()
    out.ownershipDiagnosticStageReceipt =
        pendingOwnershipDiagnosticStageReceipt
    pendingOwnershipDiagnosticStageReceipt =
        stage_receipt.CompilerStageReceipt()
    out.layoutDiagnosticCompletions =
        pendingLayoutDiagnosticCompletions
    pendingLayoutDiagnosticCompletions =
        CompilerCsgTypeDiagnosticCompletionTable()
    out.layoutDiagnosticStageReceipt =
        pendingLayoutDiagnosticStageReceipt
    pendingLayoutDiagnosticStageReceipt =
        stage_receipt.CompilerStageReceipt()
    out.concurrencyDiagnosticCompletions =
        pendingConcurrencyDiagnosticCompletions
    pendingConcurrencyDiagnosticCompletions =
        CompilerCsgTypeDiagnosticCompletionTable()
    out.concurrencyDiagnosticStageReceipt =
        pendingConcurrencyDiagnosticStageReceipt
    pendingConcurrencyDiagnosticStageReceipt =
        stage_receipt.CompilerStageReceipt()
    out.typedExprFactCountSnapshot = typedExprFactCountForCid
    texpr.TypedExprFactTableRelease(out.typedExprFacts)
    let _typedFactsRelief = os.ProcessMemoryPressureRelief()
    CompilerCsgDebugLine("compiler_csg_after_out_facts")
    texpr.TypedExprIrMoveInto(out.typedIr, work.typedIr)
    CompilerCsgFnPtrFieldCallTableRelease(
        out.fnPtrFieldCalls)
    out.fnPtrFieldCalls = work.fnPtrFieldCalls
    let releasedFnPtrFieldCalls =
        CompilerCsgFnPtrFieldCallTable()
    work.fnPtrFieldCalls = releasedFnPtrFieldCalls
    CompilerCsgExternFfiHandleContractTableRelease(
        out.externFfiHandleContracts)
    out.externFfiHandleContracts = work.externFfiHandleContracts
    let releasedExternFfiHandleContracts =
        CompilerCsgExternFfiHandleContractTable()
    work.externFfiHandleContracts = releasedExternFfiHandleContracts
    CompilerCsgExternFfiHandleCallCapabilityTableRelease(
        out.externFfiHandleCallCapabilities)
    out.externFfiHandleCallCapabilities =
        work.externFfiHandleCallCapabilities
    let releasedExternFfiHandleCallCapabilities =
        CompilerCsgExternFfiHandleCallCapabilityTable()
    work.externFfiHandleCallCapabilities =
        releasedExternFfiHandleCallCapabilities
    CompilerCsgDebugLine("compiler_csg_after_out_typed_ir")
    if os.GetEnv("CHENG_EXP_DBG") != "":
        os.WriteLine(os.Get_stderr(), Fmt"expdbg csgpre localnodes={IntToStr(work.nodes.len)}")
    out.nodes = work.nodes
    work.nodes = []
    CompilerCsgDebugLine("compiler_csg_after_out_nodes")
    if os.GetEnv("CHENG_EXP_DBG") != "":
        os.WriteLine(os.Get_stderr(), Fmt"expdbg csgout nodes={IntToStr(out.nodes.len)}")
    out.edges = work.edges
    work.edges = []
    CompilerCsgDebugLine("compiler_csg_after_out_edges")
    out.sourceTextCapturedBytes = sourceTextCapturedBytes
    out.compactProfileViewLifecycle = work.compactProfileViewLifecycle
    out.typedIrRoundCount = typedIrReachRound
    out.typedIrBatchLimit = typedIrBatchFunctionLimit
    out.typedIrRebuildSourceCount = typedIrRebuildSourceCount
    out.typedIrNewFunctionCount = typedIrNewFunctionCount
    out.typedFactsReleasedBeforeTypedIr = typedFactsReleasedBeforeTypedIr
    out.typedIrRoundFactsMaxCount = typedIrRoundFactsMaxCount
    out.typedIrRoundExprMaxCount = typedIrRoundExprMaxCount
    out.typedIrReusablePeakPackedLineCount =
        work.frontierIndex.lastStructuredSidecar.consumerReusablePeakPackedLineCount
    out.typedIrReusablePeakPackedLineBytes =
        work.frontierIndex.lastStructuredSidecar.consumerReusablePeakPackedLineBytes
    out.typedIrReusableContextOwnerPeak =
        work.frontierIndex.lastStructuredSidecar.consumerReusableContextOwnerPeak
    out.typedIrRoundFactsReleaseCount = 1
    out.typedIrRoundFactsResetCount = typedIrRoundFactsResetCount
    out.typedIrBuildIndexGeneration = typedIrBuildIndexGeneration
    out.typedIrBuildIndexSessionGeneration = typedIrBuildIndexSessionGeneration
    out.typedIrBuildIndexContextCountAtSeal = typedIrBuildIndexContextCountAtSeal
    out.typedIrBuildIndexValidationEpochAtSeal = typedIrBuildIndexValidationEpochAtSeal
    out.typedIrBuildIndexValidationEpochAfterFixedPoint =
        typedIrBuildIndexValidationEpochAfterFixedPoint
    out.typedIrBuildIndexValidationEpochAfterClose =
        typedIrBuildIndexValidationEpochAfterClose
    out.typedIrBuildIndexMetadataRowCountAtSeal =
        typedIrBuildIndexMetadataRowCountAtSeal
    out.typedIrBuildIndexMetadataRowCountExpectedAtSeal =
        typedIrBuildIndexMetadataRowCountExpectedAtSeal
    out.typedIrBuildIndexMetadataContextCountExpectedAfterSeal =
        typedIrBuildIndexMetadataContextCountExpectedAfterSeal
    out.typedIrBuildIndexMetadataContextCountObservedAfterSeal =
        typedIrBuildIndexMetadataContextCountObservedAfterSeal
    out.typedIrBuildIndexMetadataRowsExpectedAfterSeal =
        typedIrBuildIndexMetadataRowsExpectedAfterSeal
    out.typedIrBuildIndexMetadataRowsVisitedAfterSeal =
        typedIrBuildIndexMetadataRowsVisitedAfterSeal
    out.typedIrBuildIndexFullValidationCount = typedIrBuildIndexFullValidationCount
    out.typedIrBuildIndexSealedFactsCount = typedIrBuildIndexSealedFactsCount
    out.typedIrBuildIndexSealedAppendCount = typedIrBuildIndexSealedAppendCount
    out.typedIrBuildIndexSealedValidationCount = typedIrBuildIndexSealedValidationCount
    # PhaseArena CSG 字符串半片: 最终三条 CSV 是离开轮次文本 arena 的唯一
    # managed 幸存者, 经 StrCopyOutOwned 精确转移; 随后阶段边界整批
    # reset+close+destroy, 并把 reset 前的 arena 报告落入 out 标量供内存账本
    # 与 smoke 核对 (spill 必须恒 0, reset 恰 1 次当有追加)。
    let typedIrRoundBuildMsCsv =
        CompilerCsgPhaseArenaRoundTextJoin(
            work, CompilerCsgRoundTextPartBuildMs)
    out.typedIrRoundBuildMsCsv = typedIrRoundBuildMsCsv
    let typedIrRoundNewReachableCountCsv =
        CompilerCsgPhaseArenaRoundTextJoin(
            work, CompilerCsgRoundTextPartNewReachable)
    out.typedIrRoundNewReachableCountCsv =
        typedIrRoundNewReachableCountCsv
    let typedIrRoundBuildCountCsv =
        CompilerCsgPhaseArenaRoundTextJoin(
            work, CompilerCsgRoundTextPartBuildCount)
    out.typedIrRoundBuildCountCsv = typedIrRoundBuildCountCsv
    let roundTextArenaReport =
        CompilerCsgPhaseArenaRoundTextStoreReset(work)
    out.roundTextArenaPeakBytes = roundTextArenaReport.peakBytes
    out.roundTextArenaUsedBytes = roundTextArenaReport.usedBytes
    out.roundTextArenaResetCount = roundTextArenaReport.resetCount
    out.roundTextArenaSpillCount = roundTextArenaReport.spillCount
    out.roundTextArenaRetainedStoreBytes =
        roundTextArenaReport.retainedStoreBytes
    out.typedIrReachabilityScannedStatementCount = typedIrReachabilityScannedStatementCount
    out.typedIrReachabilityScannedFunctionCount = typedIrReachabilityScannedFunctionCount
    out.typedIrReachabilityResolvedCallRowVisitCount = typedIrReachabilityResolvedCallRowVisitCount
    out.typedIrReachabilityNewReachableFunctionCount = typedIrReachabilityNewReachableFunctionCount
    out.typedIrFinalStatementCount = out.typedIr.statements2_statementIndexs.len
    out.typedIrFinalFunctionCount = out.typedIr.functions2_functionNameIds.len
    out.reachabilityNameHashOperationCount = reachabilityNameHashOperationCount
    out.reachabilityNameHashProbeCount = reachabilityNameHashProbeCount
    out.reachabilityNameHashMaxProbeCount = reachabilityNameHashMaxProbeCount
    out.reachabilityNameIndexEntryCount = reachabilityNameIndexEntryCount
    out.reachabilityLineBinarySearchOperationCount = reachabilityLineBinarySearchOperationCount
    out.reachabilityLineBinarySearchProbeCount = reachabilityLineBinarySearchProbeCount
    out.reachabilityLineBinarySearchMaxProbeCount = reachabilityLineBinarySearchMaxProbeCount
    out.reachabilityEdgePairOperationCount = reachabilityEdgePairOperationCount
    out.reachabilityEdgePairProbeCount = reachabilityEdgePairProbeCount
    out.reachabilityEdgePairMaxProbeCount = reachabilityEdgePairMaxProbeCount
    out.reachabilityFinalEdgeCount = reachabilityFinalEdgeCount
    CompilerCsgSemanticFinalize(work.semanticGraph, out)
    CompilerCsgSemanticResolvedCallTableRelease(out.semanticGraph.resolvedCallTable)
    out.semanticGraph = work.semanticGraph
    let releasedSemanticGraph = CompilerCsgSemanticGraph()
    work.semanticGraph = releasedSemanticGraph
    out.nodeCount = out.nodes.len
    CompilerCsgDebugLine("compiler_csg_after_node_count")
    out.edgeCount = out.edges.len
    CompilerCsgDebugLine("compiler_csg_after_edge_count")
    out.canonicalGraphCid = canonicalGraphCid
    CompilerCsgDebugLine("compiler_csg_after_canonical_cid_assign")
    out.graphCid = graphCid
    CompilerCsgDebugLine("compiler_csg_after_graph_cid_assign")
    CompilerCsgDebugLine("compiler_csg_before_final_source_clear")
    work.payloadMovedToOut = true
    CompilerCsgBuildWorkingSetReleaseWithOutcome(
        work,
        payloadlife.CompilerPayloadOutcomeSuccess,
        buildFragmentLifetimeReceipt)
    CompilerCsgDebugLine("compiler_csg_after_final_source_clear")
    let csgPhaseAfterFNs = monotimes.MonoTimeNs(monotimes.GetMonoTime())
    out.csgPhaseA1Ns = csgPhaseAfterA1Ns - csgPhaseEnterNs
    out.csgPhaseBNs = csgPhaseAfterBNs - csgPhaseAfterA1Ns
    out.csgPhaseENs = csgPhaseAfterENs - csgPhaseAfterBNs
    out.csgPhaseFNs = csgPhaseAfterFNs - csgPhaseAfterENs
    CompilerCsgRefreshMemoryLedger(out)
    CompilerCsgDebugLine("compiler_csg_after_structured_live_bytes")
    if requirePortableReceipt:
        out.csgTransitionReceipt = pendingTransitionReceipt
        PortableSourceIdentityReceiptMoveInto(
            out.sourceIdentityReceipt,
            sourceReceipt)
    else:
        let emptySourceIdentityReceipt =
            PortableSourceIdentityReceipt()
        out.sourceIdentityReceipt = emptySourceIdentityReceipt
        let emptyCsgTransitionReceipt =
            CompilerCsgTransitionReceipt()
        out.csgTransitionReceipt = emptyCsgTransitionReceipt
    CompilerCsgLinkPlanOwnershipLeaseCommit(
        linkPlan, sourceBundleOwner, ownershipLease)
    return true

fn compilerCsgSourceBundleOwnerReleaseUnused(
        owner: var slplan.SystemLinkPlanSourceBundleOwner) =
    if !slplan.SystemLinkPlanSourceBundleOwnerMoved(owner):
        return
    var receipt: slplan.SystemLinkPlanSourceBundleReleaseReceipt
    slplan.SystemLinkPlanSourceBundleOwnerReleaseWithReceipt(
        owner, receipt)
    if !slplan.SystemLinkPlanSourceBundleReleaseReceiptConsumeStrict(
           owner, receipt):
        panic("compiler csg: unused source bundle receipt mismatch")

fn BuildCompilerCsgConsumeWithOverridesAndFragmentLifetimeReceiptInto(
        out: var CompilerCsg,
        err: var str,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceBundleCid: layout.FixedBytes32,
        entryPathOverride: str,
        entryTextOverride: str,
        sourceTextOverrides: var CompilerCsgSourceText[],
        buildFragmentLifetimeReceipt:
            var buildlife.CompilerCsgBuildFragmentLifetimeReceipt): bool =
    var noSourceReceipt: PortableSourceIdentityReceipt
    var sourceBundleOwner: slplan.SystemLinkPlanSourceBundleOwner
    let ok = compilerCsgBuildConsumeWithOverridesCoreInto(
        out,
        err,
        linkPlan,
        sourceBundleOwner,
        sourceBundleCid,
        noSourceReceipt,
        false,
        entryPathOverride,
        entryTextOverride,
        sourceTextOverrides,
        buildFragmentLifetimeReceipt)
    if !buildlife.CompilerCsgBuildFragmentLifetimeReceiptClosed(
           buildFragmentLifetimeReceipt):
        panic("compiler csg: build fragment lifetime receipt unavailable")
    compilerCsgSourceBundleOwnerReleaseUnused(sourceBundleOwner)
    return ok

fn BuildCompilerCsgConsumeWithOverridesInto(
        out: var CompilerCsg,
        err: var str,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceBundleCid: layout.FixedBytes32,
        entryPathOverride: str,
        entryTextOverride: str,
        sourceTextOverrides: var CompilerCsgSourceText[]): bool =
    var buildFragmentLifetimeReceipt: buildlife.CompilerCsgBuildFragmentLifetimeReceipt
    return BuildCompilerCsgConsumeWithOverridesAndFragmentLifetimeReceiptInto(
        out,
        err,
        linkPlan,
        sourceBundleCid,
        entryPathOverride,
        entryTextOverride,
        sourceTextOverrides,
        buildFragmentLifetimeReceipt)

fn BuildCompilerCsgConsumePortableReceiptWithSourceBundleOwnerInto(
        out: var CompilerCsg,
        err: var str,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceBundleOwner: var slplan.SystemLinkPlanSourceBundleOwner,
        sourceReceipt: var PortableSourceIdentityReceipt,
        entryPathOverride: str,
        entryTextOverride: str,
        sourceTextOverrides: var CompilerCsgSourceText[]): bool =
    let sourceBundleCid = sourceReceipt.sourceBundleCid
    var buildFragmentLifetimeReceipt: buildlife.CompilerCsgBuildFragmentLifetimeReceipt
    let ok = compilerCsgBuildConsumeWithOverridesCoreInto(
        out,
        err,
        linkPlan,
        sourceBundleOwner,
        sourceBundleCid,
        sourceReceipt,
        true,
        entryPathOverride,
        entryTextOverride,
        sourceTextOverrides,
        buildFragmentLifetimeReceipt)
    if !buildlife.CompilerCsgBuildFragmentLifetimeReceiptClosed(
           buildFragmentLifetimeReceipt):
        panic("compiler csg: portable build fragment lifetime receipt unavailable")
    return ok

fn BuildCompilerCsgConsumePortableReceiptWithOverridesInto(
        out: var CompilerCsg,
        err: var str,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceReceipt: var PortableSourceIdentityReceipt,
        entryPathOverride: str,
        entryTextOverride: str,
        sourceTextOverrides: var CompilerCsgSourceText[]): bool =
    var sourceBundleOwner: slplan.SystemLinkPlanSourceBundleOwner
    let ok =
        BuildCompilerCsgConsumePortableReceiptWithSourceBundleOwnerInto(
            out,
            err,
            linkPlan,
            sourceBundleOwner,
            sourceReceipt,
            entryPathOverride,
            entryTextOverride,
            sourceTextOverrides)
    compilerCsgSourceBundleOwnerReleaseUnused(sourceBundleOwner)
    return ok

fn BuildCompilerCsgConsumePortableReceiptInto(
        out: var CompilerCsg,
        err: var str,
        linkPlan: var slplan.SystemLinkPlanStub,
        sourceReceipt: var PortableSourceIdentityReceipt): bool =
    var sourceTextOverrides: CompilerCsgSourceText[]
    sourceTextOverrides = []
    return BuildCompilerCsgConsumePortableReceiptWithOverridesInto(
        out,
        err,
        linkPlan,
        sourceReceipt,
        "",
        "",
        sourceTextOverrides)

fn BuildCompilerCsgWithOverridesInto(linkPlan: slplan.SystemLinkPlanStub,
                                      sourceBundleCid: layout.FixedBytes32,
                                      sourceTextOverrides: var CompilerCsgSourceText[],
                                      out: var CompilerCsg,
                                      err: var str): bool =
    var consumedPlan = linkPlan
    let ok = BuildCompilerCsgConsumeWithOverridesInto(out,
                                                      err,
                                                      consumedPlan,
                                                      sourceBundleCid,
                                                      "",
                                                      "",
                                                      sourceTextOverrides)
    CompilerCsgDebugLine("compiler_csg_with_overrides_into_after_consume")
    return ok

fn BuildCompilerCsgWithOverrides(linkPlan: slplan.SystemLinkPlanStub,
                                   sourceBundleCid: layout.FixedBytes32,
                                   sourceTextOverrides: var CompilerCsgSourceText[]): Result[CompilerCsg] =
    var out: CompilerCsg
    var err = ""
    if !BuildCompilerCsgWithOverridesInto(linkPlan,
                                          sourceBundleCid,
                                          sourceTextOverrides,
                                          out,
                                          err):
        return Err[CompilerCsg](err)
    return Ok[CompilerCsg](out)

fn BuildCompilerCsgInto(linkPlan: slplan.SystemLinkPlanStub,
                         sourceBundleCid: layout.FixedBytes32,
                         out: var CompilerCsg,
                         err: var str): bool =
    var sourceTextOverrides: CompilerCsgSourceText[]
    sourceTextOverrides = []
    let ok = BuildCompilerCsgWithOverridesInto(linkPlan,
                                               sourceBundleCid,
                                               sourceTextOverrides,
                                               out,
                                               err)
    sourceTextOverrides = []
    CompilerCsgDebugLine("compiler_csg_into_after_with_overrides")
    return ok

fn BuildCompilerCsgConsumeInto(linkPlan: var slplan.SystemLinkPlanStub,
                               sourceBundleCid: layout.FixedBytes32,
                               out: var CompilerCsg,
                               err: var str): bool =
    var sourceTextOverrides: CompilerCsgSourceText[]
    sourceTextOverrides = []
    let ok = BuildCompilerCsgConsumeWithOverridesInto(out,
                                                      err,
                                                      linkPlan,
                                                      sourceBundleCid,
                                                      "",
                                                      "",
                                                      sourceTextOverrides)
    sourceTextOverrides = []
    CompilerCsgDebugLine("compiler_csg_consume_into_after_consume")
    return ok

fn BuildCompilerCsgConsumeEntryInto(linkPlan: var slplan.SystemLinkPlanStub,
                                    entryPathOverride: str,
                                    sourceBundleCid: layout.FixedBytes32,
                                    out: var CompilerCsg,
