    work.moduleSeen = releasedModuleSeen
    let releasedImportPairSeen = CompilerCsgImportPairLookup()
    work.importPairSeen = releasedImportPairSeen
    work.importPairs = []
    work.modules = []
    work.moduleNodeIds = []
    work.profileImportcMasks = []
    work.profileLineCounts = []
