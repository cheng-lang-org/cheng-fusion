    add(parts, Fmt"lowering_rule_type_call_none_count={summary.typeCallNoneCount}\n")
    add(parts, Fmt"lowering_rule_type_call_default_init_count={summary.typeCallDefaultInitCount}\n")
    add(parts, Fmt"lowering_rule_type_call_constructor_count={summary.typeCallConstructorCount}\n")
    add(parts, Fmt"lowering_rule_return_root_count={summary.returnRootCount}\n")
    add(parts, "lowering_rule_report_mode=summary\n")
    add(parts, "lowering_rule_entries_materialized=0\n")
    return strutil.Join(parts, "")

@borrows
fn CompilerCsgParserNormalizedExprReceiptReport(
        receipt: parser_receipt.ParserNormalizedExprReceipt): str =
    let verifyRes = parser_receipt.ParserNormalizedExprReceiptVerify(receipt)
    var parts: str[]
    add(parts, Fmt"parser_receipt_stage={receipt.envelope.stageKind}\n")
    add(parts, Fmt"parser_receipt_lane={receipt.envelope.laneKind}\n")
    add(parts, Fmt"parser_receipt_producer_identity={receipt.envelope.producerIdentity}\n")
    add(parts, Fmt"parser_receipt_predecessor_sha256={layout.FixedBytes32Hex(receipt.envelope.predecessorRaw32)}\n")
    add(parts, Fmt"parser_receipt_artifact_sha256={layout.FixedBytes32Hex(receipt.envelope.artifactRaw32)}\n")
    add(parts, Fmt"parser_receipt_sha256={layout.FixedBytes32Hex(receipt.envelope.receiptRaw32)}\n")
    add(parts, Fmt"portable_parser_receipt_cid={layout.FixedBytes32Hex(receipt.portableReceipt.receiptCid)}\n")
    add(parts, Fmt"compiler_csg_transition_receipt_portable=0\n")
    add(parts, Fmt"parser_receipt_source_count={receipt.sourceCount}\n")
    add(parts, Fmt"parser_receipt_function_count={receipt.functionCount}\n")
    add(parts, Fmt"parser_receipt_import_edge_count={receipt.importEdgeCount}\n")
    add(parts, Fmt"parser_receipt_verified_function_count={receipt.verifiedFunctionCount}\n")
    add(parts, Fmt"parser_receipt_expr_count={receipt.counts.exprCount}\n")
    add(parts, Fmt"parser_receipt_scope_count={receipt.counts.scopeCount}\n")
    add(parts, Fmt"parser_receipt_node_count={receipt.counts.nodeCount}\n")
    add(parts, Fmt"parser_receipt_generic_count={receipt.counts.genericCount}\n")
    add(parts, Fmt"parser_receipt_root_count={receipt.counts.rootCount}\n")
    add(parts, Fmt"parser_receipt_token_count={receipt.counts.tokenCount}\n")
    add(parts, Fmt"parser_receipt_call_event_count={receipt.counts.callEventCount}\n")
    add(parts, Fmt"parser_receipt_statement_root_count={receipt.counts.statementRootCount}\n")
    add(parts, Fmt"parser_receipt_question_residual_count={receipt.counts.questionResidualCount}\n")
    add(parts, IsOk(verifyRes) ? "parser_receipt_verified=1\n" :
                                     "parser_receipt_verified=0\n")
    return strutil.Join(parts, "")

@borrows
fn CompilerCsgReport(csg: CompilerCsg): str =
    # str[] + 末尾单次 Join, 避免 out = strutil.Join([out, ...]) 在 N=nodes+edges 上
    # O(N^2) 复制累积串 (实测 dispatch_min census csg-phase RSS +2.58GB, nodes 784494
    # edges 1684528 时该循环每次 Join 复制整个累积串, 同 gSortDumpBuf 同模式 churn)。
    let exprSummary = csg.semanticGraph.exprSummary
    var parts: str[]
    add(parts, "package_id=")
    add(parts, share(csg.packageId))
    add(parts, "\n")
    add(parts, "source_bundle_cid=")
    add(parts, layout.FixedBytes32Hex(csg.sourceBundleCid))
    add(parts, "\n")
    add(parts, "source_snapshot_count=")
    add(parts, IntToStr(csg.sourceSnapshotCount))
    add(parts, "\nentry_source_cid=")
    add(parts, layout.FixedBytes32Hex(csg.entrySourceCid))
    add(parts, "\n")
    add(parts, CompilerCsgParserNormalizedExprReceiptReport(
        csg.parserNormalizedExprReceipt))
    add(parts, "expr_surface_source_count=")
    add(parts, IntToStr(exprSummary.sourceCount))
    add(parts, "\n")
    add(parts, "expr_surface_expr_count=")
    add(parts, IntToStr(exprSummary.exprCount))
    add(parts, "\n")
    add(parts, "expr_surface_if_count=")
    add(parts, IntToStr(exprSummary.ifCount))
    add(parts, "\n")
    add(parts, "expr_surface_range_count=")
    add(parts, IntToStr(exprSummary.rangeCount))
    add(parts, "\n")
    add(parts, "expr_surface_comprehension_count=")
    add(parts, IntToStr(exprSummary.comprehensionCount))
    add(parts, "\n")
    add(parts, "expr_surface_fmt_count=")
    add(parts, IntToStr(exprSummary.strFormatCount))
    add(parts, "\n")
    add(parts, "expr_surface_result_intrinsic_count=")
    add(parts, IntToStr(exprSummary.resultIntrinsicCount))
    add(parts, "\n")
    add(parts, "expr_surface_try_count=")
    add(parts, IntToStr(exprSummary.tryCount))
    add(parts, "\n")
    add(parts, "expr_surface_default_init_count=")
    add(parts, IntToStr(exprSummary.defaultInitCount))
    add(parts, "\n")
    add(parts, "expr_surface_constructor_count=")
    add(parts, IntToStr(exprSummary.constructorCount))
    add(parts, "\n")
    add(parts, "expr_surface_return_count=")
    add(parts, IntToStr(exprSummary.returnCount))
    add(parts, "\n")
    add(parts, "expr_surface_assign_count=")
    add(parts, IntToStr(exprSummary.assignCount))
    add(parts, "\n")
    add(parts, "expr_surface_if_stmt_count=")
    add(parts, IntToStr(exprSummary.ifStmtCount))
    add(parts, "\n")
    add(parts, "expr_surface_elif_stmt_count=")
    add(parts, IntToStr(exprSummary.elifStmtCount))
    add(parts, "\n")
    add(parts, "expr_surface_else_stmt_count=")
    add(parts, IntToStr(exprSummary.elseStmtCount))
    add(parts, "\n")
    add(parts, "expr_surface_for_stmt_count=")
    add(parts, IntToStr(exprSummary.forStmtCount))
    add(parts, "\n")
    add(parts, "expr_surface_match_stmt_count=")
    add(parts, IntToStr(exprSummary.matchStmtCount))
    add(parts, "\n")
    add(parts, "expr_surface_case_stmt_count=")
    add(parts, IntToStr(exprSummary.caseStmtCount))
    add(parts, "\n")
    add(parts, "expr_surface_question_residual_count=")
    add(parts, IntToStr(exprSummary.questionResidualCount))
    add(parts, "\n")
    add(parts, CompilerCsgSemanticTypedFactSummaryReportText(csg.semanticGraph.typedFactTable.summary,
                                                       csg.typedExprFactCountSnapshot))
    add(parts, "typed_fact_semantic_slice_count=")
    add(parts, IntToStr(csg.semanticGraph.typedFactSemanticSliceCount))
    add(parts, "\n")
    add(parts, "typed_fact_semantic_validated_slice_count=")
    add(parts, IntToStr(csg.semanticGraph.typedFactSemanticValidatedSliceCount))
    add(parts, "\n")
    add(parts, "typed_fact_semantic_conservation_proved=")
    add(parts, csg.semanticGraph.typedFactSemanticConservationProved ? "1" : "0")
    add(parts, "\n")
    add(parts, CompilerCsgEgraphActiveContractReport())
    add(parts, "\n")
    add(parts, "canonical_graph_cid=")
    add(parts, layout.FixedBytes32Hex(csg.canonicalGraphCid))
    add(parts, "\n")
    add(parts, "graph_cid=")
    add(parts, layout.FixedBytes32Hex(csg.graphCid))
