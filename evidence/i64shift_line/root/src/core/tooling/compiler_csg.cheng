            work.typedIr.buildIndex
        typedIrBuildIndexGeneration =
            texpr.TypedExprBuildIndexBuildGeneration(
                zeroFunctionBuildIndex)
        typedIrBuildIndexSessionGeneration =
            texpr.TypedExprSealedBuildIndexSessionGeneration(
                work.typedIr)
        typedIrBuildIndexContextCountAtSeal =
            texpr.TypedExprBuildIndexContextCount(
                zeroFunctionBuildIndex)
        typedIrBuildIndexValidationEpochAtSeal =
            texpr.TypedExprSealedBuildIndexValidationEpoch(
                work.typedIr)
        typedIrBuildIndexMetadataRowCountAtSeal =
            texpr.TypedExprSealedBuildIndexMetadataRowCount(
                work.typedIr)
        typedIrBuildIndexFullValidationCount =
            texpr.TypedExprSealedBuildIndexFullValidationCount(
                work.typedIr)
