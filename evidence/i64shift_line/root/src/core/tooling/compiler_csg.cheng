    var buf = layout.ByteBufInit(2048)
    CompilerCsgReportBufAppendText(buf, "package_id=")
    CompilerCsgReportBufAppendText(buf, csg.packageId)
    CompilerCsgReportBufAppendText(buf, "\n")
