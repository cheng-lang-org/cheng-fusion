    total = total + CompilerCsgIntArrayBytesMode(
        table.effectStarts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.effectCounts, retainedCapacity)
    total = total + CompilerCsgFixed32ArrayBytesMode(
        table.contractCids, retainedCapacity)
    total = total + CompilerCsgFixed32ArrayBytesMode(
        table.interfaceCids, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        table.contractGraphNodeIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
