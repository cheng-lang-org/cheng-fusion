           typedIrBuildIndexSessionGeneration <= 0 ||
           typedIrBuildIndexContextCountAtSeal !=
               typedIrBuildIndexExpectedContextCountAtSeal ||
           typedIrBuildIndexValidationEpochAtSeal <= 0 ||
           typedIrBuildIndexMetadataRowCountAtSeal <= 0 ||
           typedIrBuildIndexMetadataRowCountAtSeal !=
               typedIrBuildIndexMetadataRowCountExpectedAtSeal ||
           typedIrBuildIndexFullValidationCount != 1 ||
           texpr.TypedExprSealedBuildIndexValidationCount(
               work.typedIr) != 0 ||
