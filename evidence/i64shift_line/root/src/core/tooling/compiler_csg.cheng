    if compilerCsgT4TimeTrace:
        compilerCsgT4Emit("semantic_tables", compilerCsgT4NowNs() - t4StepNs)
        t4StepNs = compilerCsgT4NowNs()
    var lineTextRefCounts: int32[]
    if compilerCsgT4TimeTrace:
        t4StepNs = compilerCsgT4NowNs()
