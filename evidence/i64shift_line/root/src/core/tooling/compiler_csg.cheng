    CompilerCsgTraceStage("after_expr_layer_and_symbols")
    if compilerCsgMemTrace:
        compilerCsgMemTraceEmit("expr_layer_symbols_done")
    if !CompilerCsgReachableParserProvenanceStrictValidateInto(
            work.reachableSet,
            work.parserNormalizedExprReceiptAccumulator,
            err):
        return CompilerCsgBuildAbort(work)
    if !CompilerCsgReachableApplyKeepExportBindingPlan(
            work.reachableSet, err):
        return CompilerCsgBuildAbort(work)
