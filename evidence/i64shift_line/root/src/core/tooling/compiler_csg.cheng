    let _lineTextRefCountsRelief = os.ProcessMemoryPressureRelief()
    if compilerCsgT4TimeTrace:
        compilerCsgT4Emit("refcounts_drop_relief", compilerCsgT4NowNs() - t4StepNs)
        t4StepNs = compilerCsgT4NowNs()
