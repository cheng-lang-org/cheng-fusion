    # const modules) never enter any function-slice consumption path, so the
    # accumulated sourceCount undercounts exactly those rows.  Bind the field
    # to the authoritative row count here, before the graph CID and artifact
    # validators read it (contract: see the binder below the strict validator).
    CompilerCsgSemanticBindExprSummarySourceRowCount(work.semanticGraph)
