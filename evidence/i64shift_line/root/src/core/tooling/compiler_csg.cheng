        out.arena = arenamod.ArenaClone(source.arena)
    out.callCoordinateKinds = source.callCoordinateKinds
    out.resolvedCallRows = source.resolvedCallRows
    out.callerTypedFunctionIndexes = source.callerTypedFunctionIndexes
    out.typedCallNodeIndexes = source.typedCallNodeIndexes
