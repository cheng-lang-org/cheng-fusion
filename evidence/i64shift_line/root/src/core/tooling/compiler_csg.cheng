    add(parts, "\ncompact_profile_view_active_owner_peak_count=")
    add(parts, strings.Int64ToStr(csg.compactProfileViewLifecycle.activeOwnerPeakCount))
    add(parts, "\ncompact_profile_view_range_borrow_count=")
    add(parts, strings.Int64ToStr(csg.compactProfileViewLifecycle.rangeBorrowCount))
    add(parts, "\ncompact_profile_view_cache_overlay_validate_count=")
    add(parts, strings.Int64ToStr(csg.compactProfileViewLifecycle.cacheOverlayValidateCount))
    add(parts, "\ncompact_profile_view_cache_overlay_commit_count=")
    add(parts, strings.Int64ToStr(csg.compactProfileViewLifecycle.cacheOverlayCommitCount))
    add(parts, "\ncompact_profile_view_cache_overlay_owned_move_count=")
    add(parts, strings.Int64ToStr(csg.compactProfileViewLifecycle.cacheOverlayOwnedMoveCount))
    add(parts, "\nlogical_payload_bytes=")
    add(parts, strings.Int64ToStr(csg.logicalPayloadBytes))
    add(parts, "\nretained_capacity_bytes=")
    add(parts, strings.Int64ToStr(csg.retainedCapacityBytes))
    add(parts, "\nscalar_logical_payload_bytes=")
    add(parts, strings.Int64ToStr(csg.scalarLogicalPayloadBytes))
    add(parts, "\nscalar_retained_capacity_bytes=")
    add(parts, strings.Int64ToStr(csg.scalarRetainedCapacityBytes))
    add(parts, "\narena_logical_payload_bytes=")
    add(parts, strings.Int64ToStr(csg.arenaLogicalPayloadBytes))
    add(parts, "\narena_retained_capacity_bytes=")
    add(parts, strings.Int64ToStr(csg.arenaRetainedCapacityBytes))
    add(parts, "\nintern_logical_payload_bytes=")
    add(parts, strings.Int64ToStr(csg.internLogicalPayloadBytes))
    add(parts, "\nintern_retained_capacity_bytes=")
    add(parts, strings.Int64ToStr(csg.internRetainedCapacityBytes))
    add(parts, "\ndynamic_sequence_logical_payload_bytes=")
    add(parts, strings.Int64ToStr(csg.dynamicSequenceLogicalPayloadBytes))
    add(parts, "\ndynamic_sequence_retained_capacity_bytes=")
    add(parts, strings.Int64ToStr(csg.dynamicSequenceRetainedCapacityBytes))
    add(parts, "\nbuild_index_logical_payload_bytes=")
    add(parts, strings.Int64ToStr(csg.buildIndexLogicalPayloadBytes))
    add(parts, "\nbuild_index_retained_capacity_bytes=")
    add(parts, strings.Int64ToStr(csg.buildIndexRetainedCapacityBytes))
    add(parts, "\nmemory_accounting_is_rss=0")
    add(parts, "\nmemory_accounting_is_physical_release=0")
    for i in 0..<csg.nodes.len:
        add(parts, "\n")
        add(parts, CompilerCsgNodeReportLine(i, csg.nodes[i]))
    for i in 0..<csg.edges.len:
        add(parts, "\n")
        add(parts, CompilerCsgEdgeReportLine(i, csg.edges[i]))
    return strutil.Join(parts, "")

fn CompilerCsgCallReasonReportKey(reason: parser.NormalizedExprCallReason): str =
    if reason == parser.NormalizedExprCallReasonUnknownQualifiedTarget:
        return "expr_surface_call_reason_unknown_qualified_target_count"
    if reason == parser.NormalizedExprCallReasonShadowedQualifiedTarget:
        return "expr_surface_call_reason_shadowed_qualified_target_count"
    if reason == parser.NormalizedExprCallReasonAmbiguousExternalTarget:
        return "expr_surface_call_reason_ambiguous_external_target_count"
    if reason == parser.NormalizedExprCallReasonAmbiguousQualifiedTarget:
        return "expr_surface_call_reason_ambiguous_qualified_target_count"
    if reason == parser.NormalizedExprCallReasonUnknownExternalTarget:
        return "expr_surface_call_reason_unknown_external_target_count"
    if reason == parser.NormalizedExprCallReasonUnknownCallTarget:
        return "expr_surface_call_reason_unknown_call_target_count"
    return ""

