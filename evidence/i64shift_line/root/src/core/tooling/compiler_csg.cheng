    # only diagnostic counts, clear row strings, then drop every backing
    # sequence before sealed-index validation, graph pruning, and CID work.
    let streamedExprCountAfterFixedPoint = work.semanticGraph.exprSummary.exprCount
    let workingExprCountAfterFixedPoint = work.exprLayer.exprs.len
