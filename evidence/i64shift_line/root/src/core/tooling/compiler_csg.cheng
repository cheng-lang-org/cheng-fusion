type
    CompilerCsgImportPair =
        ownerModulePath: str
        targetModulePath: str

    CompilerCsgTextSet =
        lookup: parser.ParserTextLookup
        emptySeen: bool

    CompilerCsgTypedNodeAuthorityCandidate =
        exactTypeIds: int32[]
        proofKinds: int32[]
        valueKinds: int32[]
        ownerSources: int32[]
        ownerDeclarations: int32[]
        ownershipPremises: int32[]
        captureStarts: int32[]
        captureCounts: int32[]
        captureCompletions: int32[]

    CompilerCsgSemanticIdentityIndex =
        # Two hash views share one borrowed row store. No composite key text is
        # materialized; hashes select a bucket and every hit is field-checked.
        nameBucketHeads: int32[]
        signatureBucketHeads: int32[]
        nameNextIndexes: int32[]
        signatureNextIndexes: int32[]
        nameHashes: int64[]
        signatureHashes: int64[]
        borrowedSources: str[]
        borrowedFunctionNames: str[]
        borrowedParamTypeJoins: str[]
        borrowedReturnTypes: str[]
        signatureCompleteFlags: int32[]
        nameIndexedFlags: bool[]
        lookupProbeVisitCount: int64
        hashInputByteVisitCount: int64
        compositeKeyPayloadBytes: int64
        retainedCapacityBytes: int64
        peakRetainedCapacityBytes: int64
        released: bool

    CompilerCsgFunctionGraphNodeColumn =
        # PhaseArena CSG 半片 (七条②): graphNodeIds 的 int32 列迁入真实
        # PhaseArenaStore (POD 句柄, 精确容量 functionCount*4B), 阶段末
        # (prune 后) 整批 reset —— 不再 setLen 一根 ORC seq 逐段遗弃。
        # 句柄代际随 reset 失效, 任何滞留访问立即 hard-fail (④)。
        graphNodeIdColumn: phase.PhaseArenaRef
        graphNodeIdCount: int32
        version: int64
        sealedVersion: int64
        functionCountAtSeal: int32
        contentCertificate: int64

    CompilerCsgFunctionSemanticIdentity =
        canonicalSource: str
        declarationLineIndex: int32
        functionName: str
        paramTypeJoin: str
        returnType: str
        signatureComplete: bool

    CompilerCsgLinkPlanOwnershipLease =
        active: bool
        portableSourceBinding: bool
        sourceBundleBindingSeal: layout.FixedBytes32
        externalPackageRootCount: int32
        sourceClosureCount: int32
        sourceBundleIdentityCount: int32
        ownerModuleCount: int32
        importEdgeCount: int32
        runtimeTargetCount: int32
        exprCount: int32
        exprNextCount: int32
        exprSourceCount: int32
        exprQuestionResidualCount: int32
        exprLookupSlotCount: int32
        exprLookupBucketCount: int32

    CompilerCsgReachableSourceLookup =
        slotHeads: int32[]
        nextIndexes: int32[]
        sourceHashes: int32[]
        sourcePaths: str[]
        emptySeen: bool

    CompilerCsgImportPairLookupBucket =
        ownerLen: int32
        ownerFirstCode: int32
        ownerLastCode: int32
        ownerHash: int32
        targetLen: int32
        targetFirstCode: int32
        targetLastCode: int32
        targetHash: int32
        items: CompilerCsgImportPair[]

    CompilerCsgImportPairLookup =
        slots: int32[]
        buckets: CompilerCsgImportPairLookupBucket[]

    CompilerCsgSourcePathIndex =
        lookup: parser.ParserSourcePathIndexLookup
        roots: str[]
        relativeRoot: str
        rootsConfigured: bool
        slotCertificates: int64[]
        bucketCertificates: CompilerCsgSourcePathIndexBucketCertificates[]
        rootCertificates: int64[]
        relativeRootCertificate: int64
        domainVersion: int64
        sealedDomainVersion: int64
        sealedClosurePaths: str[]

    CompilerCsgSourcePathIndexBucketCertificates =
        keyCertificate: int64
        itemCertificates: int64[]

    CompilerCsgStructuredSidecarReport =
        sourceBuildCount: int64
        sourceReleaseCount: int64
        sliceBuildCount: int64
        activeSliceCount: int64
        activeSlicePeakCount: int64
        phasePeakCapacityBytes: int64
        phasePeakLiveBytes: int64
        finalScratchCapacityBytes: int64
        finalScratchLiveBytes: int64
        scopeBuildLineVisitCount: int64
        structuredBuildLineVisitCount: int64
        sliceLineVisitCount: int64
        sliceScopeVisitCount: int64
        sliceSeedVisitCount: int64
        sliceApplyExprVisitCount: int64
        consumerRoundCount: int64
        consumerIndexRowVisitCount: int64
        consumerExprVisitCount: int64
        consumerScopeVisitCount: int64
        consumerStatementVisitCount: int64
        consumerFactVisitCount: int64
        consumerSliceBuildCount: int64
        consumerActiveSliceCount: int64
        consumerActiveSlicePeakCount: int64
        consumerPeakCapacityBytes: int64
        consumerReusableSelectedLineVisitCount: int64
        consumerReusableSelectedLineBytes: int64
        consumerReusableSelectedScopeVisitCount: int64
        consumerReusableSelectedBindingVisitCount: int64
        consumerReusableGlobalBindingVisitCount: int64
        consumerReusableIndexProducerFullTraversalCount: int64
        consumerReusablePeakPackedLineCount: int32
        consumerReusablePeakPackedLineBytes: int64
        consumerReusableSourceLineDomainPeak: int32
        consumerReusableContextOwnerPeak: int32
        consumerSemanticIndexRowVisitCount: int64
        consumerSemanticExprVisitCount: int64
        consumerSemanticFactVisitCount: int64
        consumerSemanticFullScanRoundCount: int64
        consumerTypedIrBoundedRangeRoundCount: int64

    CompilerCsgStructuredSourceDomain =
        sourcePath: str
        # Stable source-wide identity maps. Function slices may arrive in any
        # frontier order; only TypedExpr materialization projects these ids local.
        denseScopes: int32[]
        denseStatements: int32[]
        scopeChildCounts: int32[]
        statementLexicalCounts: int32[]
        seenStatements: bool[]
        factsPayloadBytes: int64
        denseScopeCount: int32
        denseStatementCount: int32
        appendedExprCount: int32
        previousFunctionEndLine: int32
        lastSourceScopeId: int32
        lastSourceStatementOrdinal: int32
        targetScopeStart: int32
        targetExprStart: int32
        parserNodeOffset: int32
        parserRootOffset: int32
        parserDeclarationOffset: int32
        parserTreeCommitted: bool
        started: bool
        finalized: bool

    # Capacity accounting is explicit per scratch owner. Values are retained
    # sequence payload bytes, not RSS estimates; totalBytes is always the exact
    # sum of the owner fields and phasePeakBytes is the maximum committed phase.
    CompilerCsgStagingCapacityLedger =
        sortingBytes: int64
        sparseIndexBytes: int64
        reachabilityDeltaBytes: int64
        frontierAdjacencyBytes: int64
        frontierSelectionBytes: int64
        frontierOutputBytes: int64
        profileStateJournalBytes: int64
        profilePendingBytes: int64
        profileCacheOverlayBytes: int64
        profileLineScratchBytes: int64
        profileResolverScratchBytes: int64
        parserCacheScratchBytes: int64
        frontierParserScratchBytes: int64
        typedFactTransactionBytes: int64
        validationBytes: int64
        frontierOutputPrimaryOwnsStringPayload: bool
        frontierOutputScratchOwnsStringPayload: bool
        totalBytes: int64
        phasePeakBytes: int64
        phaseSnapshotCount: int64

    CompilerCsgFrontierIndex =
        profileFunctionHeads: int32[]
        profileFunctionTails: int32[]
        functionNext: int32[]
        functionSelected: bool[]
        profileSelected: bool[]
        selectedProfiles: int32[]
        touchedFunctions: int32[]
        exprStarts: int32[]
        exprEnds: int32[]
        factStarts: int32[]
        factEnds: int32[]
        profileRowCertificates: int64[]
        functionRowCertificates: int64[]
        selectedProfileListCertificates: int64[]
        touchedFunctionListCertificates: int64[]
        domainVersion: int64
        sealedDomainVersion: int64
        certificateBuildOperationCount: int64
        certificateValidationOperationCount: int64
        queryOperationCount: int64
        lastStagingCapacity: CompilerCsgStagingCapacityLedger
        lastStructuredSidecar: CompilerCsgStructuredSidecarReport

    CompilerCsgNameAdjacencyIndex =
        slots: int32[]
        slotCertificates: int64[]
        profileIndexes: int32[]
        functionNames: str[]
        heads: int32[]
        tails: int32[]
        counts: int32[]
        keyCertificates: int64[]
        functionDeclared: bool[]
        functionNodeCertificates: int64[]
        hashOperationCount: int64
        hashProbeCount: int64
        hashMaxProbeCount: int32

    TypedExprFact = texpr.TypedExprFact
    TypedExprFactTable = texpr.TypedExprFactTable
    TypedExprLoweringRule = texpr.TypedExprLoweringRule
    TypedExprSourceText = texpr.TypedExprSourceText
    BrowserAbiInputKind = barule.BrowserAbiInputKind
    BrowserAbiOutputKind = barule.BrowserAbiOutputKind
    BrowserAbiErrorKind = barule.BrowserAbiErrorKind
    BrowserAbiResultKind = barule.BrowserAbiResultKind
    BrowserAbiOutBufferKind = barule.BrowserAbiOutBufferKind
    BrowserAbiBridgeStage = barule.BrowserAbiBridgeStage
    BrowserAbiOutputSchemaKind = barule.BrowserAbiOutputSchemaKind
    BrowserAbiRule = barule.BrowserAbiRule
    BrowserAbiBridgeSpec = barule.BrowserAbiBridgeSpec
    BrowserAbiBridgePlan = barule.BrowserAbiBridgePlan

    CompilerCsgNode =
        nodeId: int32
        nodeKind: int32
        ownerNodeId: int32
        modulePath: str
        symbolText: str
        factText: str
        # Snapshot-local parser producer coordinate.  These columns are exact
        # provenance only and are deliberately excluded from portable SymbolId
        # hashing; portable declaration identity is owned by DeclId.
        producerSourceIndex: int32
        producerDeclarationIndex: int32
        functionNameSurfaceKind: int32
        nameProofCid: layout.FixedBytes32
        semanticSource: str
        semanticDeclarationLineIndex: int32
        semanticParamTypeJoin: str
        semanticReturnType: str
        semanticSignatureComplete: int32
        resultLayoutKind: int32
        effectKind: int32
        capabilityKind: int32
        callConv: int32
        entryFlag: int32
        exportedFlag: int32
        exportSymbolName: str
        exportNameExplicit: int32
        factCid: layout.FixedBytes32

    CompilerCsgEdge =
        edgeId: int32
        fromNodeId: int32
        toNodeId: int32
        edgeKind: int32
        edgeCid: layout.FixedBytes32

    CompilerCsgReachableFunctionSet =
        keepExportedSymbolNodes: bool
        exportNameExplicitFlags: bool[]
        functionAnnotationFlags: int32[]
        functionDeclarationHeaderCids: layout.FixedBytes32[]
        functionDeclarationPathCids: layout.FixedBytes32[]
        keepExportBindingCids: layout.FixedBytes32[]
        active: bool
        sourcePaths: str[]
        functionNames: str[]
        symbolTexts: str[]
        exportSymbolNames: str[]
        producerSourceIndexes: int32[]
        producerDeclarationIndexes: int32[]
        functionNameSurfaceKinds: int32[]
        functionNameProofCids: layout.FixedBytes32[]
        startLines: int32[]
        endLines: int32[]
        reachable: bool[]
        reachableCount: int32
        reachableQueue: int32[]
        edgeFrom: int32[]
        edgeTo: int32[]
        edgeHeads: int32[]
        edgeNext: int32[]
        edgePairSlots: int32[]
        profileSourceIndex: CompilerCsgSourcePathIndex
        profileFunctionStarts: int32[]
        profileFunctionCounts: int32[]
        profileLineIndexProven: bool[]
        functionProfileIndexes: int32[]
        scopedFunctionNames: CompilerCsgNameAdjacencyIndex
        scopedFunctionNameNext: int32[]
        globalFunctionNames: CompilerCsgNameAdjacencyIndex
        globalFunctionNameNext: int32[]
        lineBinarySearchOperationCount: int64
        lineBinarySearchProbeCount: int64
        lineBinarySearchMaxProbeCount: int32
        edgePairOperationCount: int64
        edgePairProbeCount: int64
        edgePairMaxProbeCount: int32
        resolvedCallRowVisitCount: int64
        structureVersion: int64
        structureSealedVersion: int64
        structureShapeSeal: int64
        structureContentCertificate: int64
        graphVersion: int64
        graphSealedVersion: int64
        graphShapeSeal: int64
        graphContentCertificate: int64
        profileRowCertificates: int64[]
        functionRowCertificates: int64[]
        reachableRowCertificates: int64[]
        reachableQueueCertificates: int64[]
        edgeHeadCertificates: int64[]
        edgeRowCertificates: int64[]
        edgePairSlotCertificates: int64[]
        certificateBuildOperationCount: int64
        certificateValidationOperationCount: int64
        lastProfileScanStaging: CompilerCsgStagingCapacityLedger

    # Probe counters are a bounded scalar journal. Fact-range validation uses
    # this without allocating graph columns proportional to the full function
    # set, then commits it only after the complete caller-visible batch passes.
    CompilerCsgReachabilityProbeDelta =
        scopedNameHashOperationCount: int64
        scopedNameHashProbeCount: int64
        scopedNameHashMaxProbeCount: int32
        globalNameHashOperationCount: int64
        globalNameHashProbeCount: int64
        globalNameHashMaxProbeCount: int32
        lineBinarySearchOperationCount: int64
        lineBinarySearchProbeCount: int64
        lineBinarySearchMaxProbeCount: int32
        resolvedCallRowVisitCount: int64
        certificateValidationOperationCount: int64
        contentCertificateViolation: bool

    # Open-addressed staging index. Keys retain first-seen order while slots
    # provide bounded expected-time lookup without allocating by domain size.
    CompilerCsgSparseIntIndex =
        slots: int32[]
        keys: int32[]

    CompilerCsgBoolJournal =
