    var typedIrErr = ""
    var typedIrReachRound: int32
    var typedIrRebuildSourceCount: int32
    var typedIrNewFunctionCount: int32
    var typedIrRoundFactsMaxCount: int32
    var typedIrRoundExprMaxCount: int32
    var typedIrRoundFactsResetCount: int32
    var typedIrReachabilityScannedStatementCount: int32
    var typedIrReachabilityScannedFunctionCount: int32
    var typedIrReachabilityNewReachableFunctionCount: int32
    var typedIrReachStable = false
    var typedIrBuildIndexGeneration: int32
    var typedIrBuildIndexValidationEpochAtSeal: int32
    var typedIrBuildIndexValidationEpochAfterFixedPoint: int32
    var typedIrBuildIndexMetadataRowCountAtSeal: int32
    var typedIrBuildIndexMetadataRowCountExpectedAtSeal: int32
    var typedIrBuildIndexMetadataRowsVisitedAfterSeal: int64
    var typedIrBuildIndexFullValidationCount: int32
    var typedIrBuildIndexSealedFactsCount: int32
    var typedIrBuildIndexSealedAppendCount: int32
    var typedIrBuildIndexSealedValidationCount: int32
    var typedIrBuildIndexSessionGeneration: int32
    var typedIrBuildIndexContextCountAtSeal: int32
    var typedIrBuildIndexExpectedContextCountAtSeal: int32
    var typedIrBuildIndexMetadataContextCountExpectedAfterSeal: int32
    var typedIrBuildIndexMetadataContextCountObservedAfterSeal: int32
    var typedIrBuildIndexMetadataRowsExpectedAfterSeal: int64
    var typedIrBuildIndexSealedFactsMetadataRows: int64
    var typedIrBuildIndexSealedAppendMetadataRows: int64
    var typedIrBuildIndexValidationEpochAfterClose: int32
