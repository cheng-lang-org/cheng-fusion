@borrows
fn compilerCsgArenaInt32ColumnEmpty(
        column: arenamod.ArenaArrayInt32): bool =
    return column.offset == 0 && column.len == 0 &&
           column.capacity == 0 && column.generation == 0

@borrows
fn compilerCsgExternFfiHandleCallCapabilityTableEmpty(
        table: CompilerCsgExternFfiHandleCallCapabilityTable): bool =
    return compilerCsgExternFfiHandleCallCapabilityPhysicalBufferCount(
               table) == 0 &&
           table.arena.capacityBytes == 0 &&
           table.arena.usedBytes == 0 &&
           compilerCsgArenaInt32ColumnEmpty(
               table.callCoordinateKinds) &&
           compilerCsgArenaInt32ColumnEmpty(table.resolvedCallRows) &&
           compilerCsgArenaInt32ColumnEmpty(
               table.callerTypedFunctionIndexes) &&
           compilerCsgArenaInt32ColumnEmpty(table.typedCallNodeIndexes) &&
           compilerCsgArenaInt32ColumnEmpty(table.contractRows) &&
           compilerCsgArenaInt32ColumnEmpty(table.effectStarts) &&
           compilerCsgArenaInt32ColumnEmpty(table.effectCounts) &&
           compilerCsgArenaInt32ColumnEmpty(table.effectRows) &&
           compilerCsgArenaInt32ColumnEmpty(table.effectKinds) &&
           compilerCsgArenaInt32ColumnEmpty(table.effectTargetKinds) &&
           compilerCsgArenaInt32ColumnEmpty(
               table.effectParameterOrdinals) &&
           compilerCsgArenaInt32ColumnEmpty(table.effectArgumentRows) &&
           compilerCsgArenaInt32ColumnEmpty(
               table.effectArgumentValueNodeIndexes) &&
           compilerCsgArenaInt32ColumnEmpty(
               table.effectValueDefinitionRows) &&
           compilerCsgArenaInt32ColumnEmpty(
               table.effectGenerationRootValueDefinitionRows) &&
           compilerCsgArenaInt32ColumnEmpty(table.effectExactTypeIds) &&
           compilerCsgArenaInt32ColumnEmpty(table.effectCarrierKinds) &&
           table.callCapabilityCids.len == 0 &&
           table.callCapabilityCids.cap == 0 &&
           table.effectArgumentBindingCids.len == 0 &&
           table.effectArgumentBindingCids.cap == 0 &&
           table.effectTypeCids.len == 0 &&
           table.effectTypeCids.cap == 0 &&
           table.effectGenerationCids.len == 0 &&
           table.effectGenerationCids.cap == 0 &&
           table.effectDefinitionLineageCids.len == 0 &&
           table.effectDefinitionLineageCids.cap == 0 &&
           table.effectCapabilityCids.len == 0 &&
           table.effectCapabilityCids.cap == 0 &&
           layout.FixedBytes32Equal(
               table.cargoCid, layout.FixedBytes32()) &&
           !table.complete

@borrows
fn CompilerCsgExternFfiHandleCallCapabilityTableReleasedEmpty(
        table: CompilerCsgExternFfiHandleCallCapabilityTable): bool =
    return compilerCsgExternFfiHandleCallCapabilityTableEmpty(table)

