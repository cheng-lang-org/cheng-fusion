    typedIrErr = typedIrReachState.typedIrErr
    typedIrReachRound = typedIrReachState.reachRound
    typedIrRebuildSourceCount = typedIrReachState.rebuildSourceCount
    typedIrNewFunctionCount = typedIrReachState.newFunctionCount
    typedIrRoundFactsMaxCount = typedIrReachState.roundFactsMaxCount
    typedIrRoundExprMaxCount = typedIrReachState.roundExprMaxCount
    typedIrRoundFactsResetCount = typedIrReachState.roundFactsResetCount
    typedIrReachabilityScannedStatementCount = typedIrReachState.reachabilityScannedStatementCount
    typedIrReachabilityScannedFunctionCount = typedIrReachState.reachabilityScannedFunctionCount
    typedIrReachabilityNewReachableFunctionCount = typedIrReachState.reachabilityNewReachableFunctionCount
    typedIrReachStable = typedIrReachState.reachStable
    typedIrBuildIndexGeneration = typedIrReachState.buildIndexGeneration
    typedIrBuildIndexValidationEpochAtSeal = typedIrReachState.buildIndexValidationEpochAtSeal
    typedIrBuildIndexMetadataRowCountAtSeal = typedIrReachState.buildIndexMetadataRowCountAtSeal
    typedIrBuildIndexMetadataRowCountExpectedAtSeal = typedIrReachState.buildIndexMetadataRowCountExpectedAtSeal
    typedIrBuildIndexFullValidationCount = typedIrReachState.buildIndexFullValidationCount
    typedIrBuildIndexSealedFactsCount = typedIrReachState.buildIndexSealedFactsCount
    typedIrBuildIndexSealedAppendCount = typedIrReachState.buildIndexSealedAppendCount
    typedIrBuildIndexSessionGeneration = typedIrReachState.buildIndexSessionGeneration
    typedIrBuildIndexContextCountAtSeal = typedIrReachState.buildIndexContextCountAtSeal
    typedIrBuildIndexExpectedContextCountAtSeal = typedIrReachState.buildIndexExpectedContextCountAtSeal
    typedIrBuildIndexMetadataContextCountExpectedAfterSeal = typedIrReachState.buildIndexMetadataContextCountExpectedAfterSeal
    typedIrBuildIndexMetadataContextCountObservedAfterSeal = typedIrReachState.buildIndexMetadataContextCountObservedAfterSeal
    typedIrBuildIndexMetadataRowsExpectedAfterSeal = typedIrReachState.buildIndexMetadataRowsExpectedAfterSeal
    typedIrBuildIndexSealedFactsMetadataRows = typedIrReachState.buildIndexSealedFactsMetadataRows
    typedIrBuildIndexSealedAppendMetadataRows = typedIrReachState.buildIndexSealedAppendMetadataRows
    # [fsw-line] The fixed point above is the last exprSummary commit site.
