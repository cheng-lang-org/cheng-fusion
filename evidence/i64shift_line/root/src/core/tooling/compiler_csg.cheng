@borrows
fn CompilerCsgSemanticResolvedCallStructuredLiveBytes(table: CompilerCsgSemanticResolvedCallTable): int64 =
    var total: int64
    total = total + CompilerCsgSemanticResolvedCallDynamicSequenceBytes(table, false)
    total = total + CompilerCsgInternPoolBytesMode(table.internPool, false)
    return total

fn CompilerCsgSemanticDynamicSequenceBytes(semanticGraph: var CompilerCsgSemanticGraph,
                                      retainedCapacity: bool): int64 =
    var total: int64
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.sourceTable.sourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.sourceTable.modulePaths, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.sourceTable.textBytes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.sourceTable.declStart, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.sourceTable.declCount, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.sourceTable.importEdgeStart, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.sourceTable.importEdgeCount, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.declTable.sourceIndex, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.declTable.names, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.declTable.lineNumbers, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(semanticGraph.declTable.importc, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(semanticGraph.declTable.exported, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.importEdgeTable.ownerSourceIndex, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.importEdgeTable.targetSourceIndex, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.importEdgeTable.ownerModulePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.importEdgeTable.targetModulePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.importEdgeTable.targetSourcePaths, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(semanticGraph.importEdgeTable.resolved, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.reachableFunctionTable.sourceIndex, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        semanticGraph.reachableFunctionTable.producerSourceIndexes,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        semanticGraph.reachableFunctionTable.producerDeclarationIndexes,
        retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        semanticGraph.reachableFunctionTable.functionNameSurfaceKinds,
        retainedCapacity)
    total = total + Int64(CompilerCsgSequenceSlots(
        semanticGraph.reachableFunctionTable.functionNameProofCids.len,
        semanticGraph.reachableFunctionTable.functionNameProofCids.cap,
        retainedCapacity)) * CompilerCsgFixed32Bytes()
    total = total + CompilerCsgIntArrayBytesMode(
        semanticGraph.reachableFunctionTable.functionAnnotationFlags,
        retainedCapacity)
    total = total + Int64(CompilerCsgSequenceSlots(
        semanticGraph.reachableFunctionTable.functionDeclarationHeaderCids.len,
        semanticGraph.reachableFunctionTable.functionDeclarationHeaderCids.cap,
        retainedCapacity)) * CompilerCsgFixed32Bytes()
    total = total + Int64(CompilerCsgSequenceSlots(
        semanticGraph.reachableFunctionTable.functionDeclarationPathCids.len,
        semanticGraph.reachableFunctionTable.functionDeclarationPathCids.cap,
        retainedCapacity)) * CompilerCsgFixed32Bytes()
    total = total + Int64(CompilerCsgSequenceSlots(
        semanticGraph.reachableFunctionTable.keepExportBindingCids.len,
        semanticGraph.reachableFunctionTable.keepExportBindingCids.cap,
        retainedCapacity)) * CompilerCsgFixed32Bytes()
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.reachableFunctionTable.sourcePaths, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.reachableFunctionTable.functionNames, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.reachableFunctionTable.symbolTexts, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.reachableFunctionTable.startLines, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.reachableFunctionTable.endLines, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(semanticGraph.reachableFunctionTable.reachable, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(
        semanticGraph.reachableFunctionTable.graphNodeIds, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.exprSliceTable.sourceIndex, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.exprSliceTable.sourcePaths, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.exprSliceTable.functionIndex, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.exprSliceTable.exprStart, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.exprSliceTable.exprCount, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.exprSliceTable.typedFactStart, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.exprSliceTable.typedFactCount, retainedCapacity)
    total = total + CompilerCsgInt64ArrayBytesMode(semanticGraph.exprSliceTable.typedFactSemanticDigests, retainedCapacity)
    total = total + CompilerCsgInt64ArrayBytesMode(semanticGraph.exprSliceTable.typedIrSemanticDigests, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.exprSliceTable.typedIrFunctionIndexes, retainedCapacity)
    total = total + CompilerCsgBoolArrayBytesMode(semanticGraph.exprSliceTable.semanticValidated, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.exprSliceTable.functionSliceIndexes, retainedCapacity)
    total = total + CompilerCsgSemanticTypedFactDynamicSequenceBytes(semanticGraph.typedFactTable,
                                                               retainedCapacity)
    total = total + CompilerCsgSemanticResolvedCallDynamicSequenceBytes(semanticGraph.resolvedCallTable, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.typedIrTable.functionSourceIndexes, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.typedIrTable.functionGraphNodeIds, retainedCapacity)
    total = total + CompilerCsgStrArrayBytesMode(semanticGraph.typedIrTable.functionNames, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.typedIrTable.functionNodeStart, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.typedIrTable.functionNodeCount, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.typedIrTable.functionStatementStart, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(semanticGraph.typedIrTable.functionStatementCount, retainedCapacity)
    return total

fn CompilerCsgSemanticStructuredLiveBytes(semanticGraph: var CompilerCsgSemanticGraph): int64 =
    var total: int64
    total = total + Int64(semanticGraph.sourceTable.sourcePaths.len) * Int64(64)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.sourceTable.sourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.sourceTable.modulePaths)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.sourceTable.textBytes)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.sourceTable.declStart)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.sourceTable.declCount)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.sourceTable.importEdgeStart)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.sourceTable.importEdgeCount)
    total = total + Int64(semanticGraph.declTable.names.len) * Int64(40)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.declTable.sourceIndex)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.declTable.names)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.declTable.lineNumbers)
    total = total + Int64(semanticGraph.declTable.importc.len) * CompilerCsgBoolBytes()
    total = total + Int64(semanticGraph.declTable.exported.len) * CompilerCsgBoolBytes()
    total = total + Int64(semanticGraph.importEdgeTable.ownerModulePaths.len) * Int64(48)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.importEdgeTable.ownerSourceIndex)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.importEdgeTable.targetSourceIndex)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.importEdgeTable.ownerModulePaths)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.importEdgeTable.targetModulePaths)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.importEdgeTable.targetSourcePaths)
    total = total + Int64(semanticGraph.importEdgeTable.resolved.len) * CompilerCsgBoolBytes()
    total = total + Int64(semanticGraph.reachableFunctionTable.functionNames.len) * Int64(56)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.reachableFunctionTable.sourceIndex)
    total = total + CompilerCsgIntArrayLiveBytes(
        semanticGraph.reachableFunctionTable.producerSourceIndexes)
    total = total + CompilerCsgIntArrayLiveBytes(
        semanticGraph.reachableFunctionTable.producerDeclarationIndexes)
    total = total + CompilerCsgIntArrayLiveBytes(
        semanticGraph.reachableFunctionTable.functionNameSurfaceKinds)
    total = total + Int64(
        semanticGraph.reachableFunctionTable.functionNameProofCids.len) *
            CompilerCsgFixed32Bytes()
    total = total + CompilerCsgIntArrayLiveBytes(
        semanticGraph.reachableFunctionTable.functionAnnotationFlags)
    total = total + Int64(
        semanticGraph.reachableFunctionTable.
            functionDeclarationHeaderCids.len) *
            CompilerCsgFixed32Bytes()
    total = total + Int64(
        semanticGraph.reachableFunctionTable.
            functionDeclarationPathCids.len) *
            CompilerCsgFixed32Bytes()
    total = total + Int64(
        semanticGraph.reachableFunctionTable.keepExportBindingCids.len) *
            CompilerCsgFixed32Bytes()
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.reachableFunctionTable.sourcePaths)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.reachableFunctionTable.functionNames)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.reachableFunctionTable.symbolTexts)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.reachableFunctionTable.startLines)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.reachableFunctionTable.endLines)
    total = total + Int64(semanticGraph.reachableFunctionTable.reachable.len) * CompilerCsgBoolBytes()
    total = total + CompilerCsgIntArrayLiveBytes(
        semanticGraph.reachableFunctionTable.graphNodeIds)
    total = total + Int64(semanticGraph.exprSliceTable.sourceIndex.len) * Int64(36)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.exprSliceTable.sourceIndex)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.exprSliceTable.sourcePaths)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.exprSliceTable.functionIndex)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.exprSliceTable.exprStart)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.exprSliceTable.exprCount)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.exprSliceTable.typedFactStart)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.exprSliceTable.typedFactCount)
    total = total + CompilerCsgInt64ArrayLiveBytes(semanticGraph.exprSliceTable.typedFactSemanticDigests)
    total = total + CompilerCsgInt64ArrayLiveBytes(semanticGraph.exprSliceTable.typedIrSemanticDigests)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.exprSliceTable.typedIrFunctionIndexes)
    total = total + Int64(semanticGraph.exprSliceTable.semanticValidated.len) * CompilerCsgBoolBytes()
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.exprSliceTable.functionSliceIndexes)
    total = total + CompilerCsgSemanticTypedFactDynamicSequenceBytes(semanticGraph.typedFactTable,
                                                               false)
    total = total + CompilerCsgSemanticResolvedCallStructuredLiveBytes(semanticGraph.resolvedCallTable)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.typedIrTable.functionSourceIndexes)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.typedIrTable.functionGraphNodeIds)
    total = total + CompilerCsgStringArrayLiveBytes(semanticGraph.typedIrTable.functionNames)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.typedIrTable.functionNodeStart)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.typedIrTable.functionNodeCount)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.typedIrTable.functionStatementStart)
    total = total + CompilerCsgIntArrayLiveBytes(semanticGraph.typedIrTable.functionStatementCount)
    return total

fn CompilerCsgNodeSequenceBytes(csg: var CompilerCsg,
                                retainedCapacity: bool): int64 =
    var total = Int64(CompilerCsgSequenceSlots(csg.nodes.len,
                                               csg.nodes.cap,
                                               retainedCapacity)) * CompilerCsgNodeRowBytes()
    for nodeIndex in 0..<csg.nodes.len:
        total = total + CompilerCsgNodePayloadBytes(csg.nodes[nodeIndex])
    return total

fn CompilerCsgEdgeSequenceBytes(csg: var CompilerCsg,
                                retainedCapacity: bool): int64 =
    return Int64(CompilerCsgSequenceSlots(csg.edges.len,
                                          csg.edges.cap,
                                          retainedCapacity)) * CompilerCsgEdgeRowBytes()

fn CompilerCsgExprLayerSequenceBytes(layer: var parser.NormalizedExprLayer,
                                     retainedCapacity: bool): int64 =
    if retainedCapacity:
        return parser.NormalizedExprLayerRetainedBytes(layer)
    var total = Int64(CompilerCsgSequenceSlots(layer.exprs.len,
                                               layer.exprs.cap,
                                               retainedCapacity)) * CompilerCsgExprRowBytes()
    total = total + Int64(CompilerCsgSequenceSlots(layer.scopes.len,
                                                   layer.scopes.cap,
                                                   retainedCapacity)) *
                    CompilerCsgNormalizedScopeFactRowBytes()
    total = total + CompilerCsgIntArrayBytesMode(layer.exprNext, retainedCapacity)
    total = total + CompilerCsgIntArrayBytesMode(layer.exprLookup.slots, retainedCapacity)
    total = total + Int64(CompilerCsgSequenceSlots(layer.exprLookup.buckets.len,
                                                   layer.exprLookup.buckets.cap,
                                                   retainedCapacity)) * CompilerCsgExprLookupBucketRowBytes()
    for exprIndex in 0..<layer.exprs.len:
        total = total + Int64(layer.exprs[exprIndex].exprId.len)
        total = total + Int64(layer.exprs[exprIndex].sourcePath.len)
        total = total + Int64(layer.exprs[exprIndex].surfaceText.len)
        total = total + Int64(layer.exprs[exprIndex].callQualifier.len)
        total = total + Int64(layer.exprs[exprIndex].callCallee.len)
        total = total + Int64(layer.exprs[exprIndex].callTarget.len)
        total = total + Int64(layer.exprs[exprIndex].callTargetSourcePath.len)
        total = total + Int64(layer.exprs[exprIndex].callArgsText.len)
    for scopeIndex in 0..<layer.scopes.len:
        total = total + Int64(layer.scopes[scopeIndex].sourcePath.len)
    # A function-slice layer may only hold a borrow lease. Its Arena/Intern
    # buffers remain owned by the full-source layer and must not be charged to
    # this layer's physical-release receipt.
    if !layer.valueExprTreeBorrowLease:
        total = total +
            parser.ParserValueExprTreeLogicalBytes(
                layer.valueExprTree)
    return total

fn CompilerCsgNormalizedExprLayerPhysicalBufferCount(
        layer: var parser.NormalizedExprLayer): int32 =
    return parser.NormalizedExprLayerPhysicalBufferCount(layer)

fn CompilerCsgParserReceiptScalarLogicalBytes(
        receipt: var parser_receipt.ParserNormalizedExprReceipt): int64 =
    return Int64(sizeof(parser_receipt.ParserNormalizedExprReceipt)) +
           Int64(receipt.envelope.stageKind.len) +
           Int64(receipt.envelope.laneKind.len) +
           Int64(receipt.envelope.producerIdentity.len)

fn CompilerCsgParserReceiptDynamicSequenceBytes(
        receipt: var parser_receipt.ParserNormalizedExprReceipt,
        retainedCapacity: bool): int64 =
    var total = Int64(CompilerCsgSequenceSlots(
                          receipt.envelope.countKeys.len,
                          receipt.envelope.countKeys.cap,
                          retainedCapacity)) * CompilerCsgStrHeaderBytes()
    total = total + Int64(CompilerCsgSequenceSlots(
                              receipt.envelope.countValues.len,
                              receipt.envelope.countValues.cap,
                              retainedCapacity)) * Int64(8)
    for index in 0..<receipt.envelope.countKeys.len:
        total = total + Int64(receipt.envelope.countKeys[index].len)
    total = total + Int64(CompilerCsgSequenceSlots(
                              receipt.sourceSidecars.len,
                              receipt.sourceSidecars.cap,
                              retainedCapacity)) *
                    Int64(sizeof(parser_receipt.ParserCanonicalSourceSidecar))
    for sourceIndex in 0..<receipt.sourceSidecars.len:
        let sidecar = receipt.sourceSidecars[sourceIndex]
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.diagnosticAnchorKinds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.diagnosticAnchorNodeIds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.diagnosticOwnerDeclarationSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.diagnosticSpanIds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.diagnosticSeverities,
                            retainedCapacity)
        total = total + CompilerCsgStrArrayBytesMode(
                            sidecar.diagnosticCodeTexts,
                            retainedCapacity)
        total = total + CompilerCsgStrArrayBytesMode(
                            sidecar.diagnosticMessageTexts,
                            retainedCapacity)
        total = total + Int64(CompilerCsgSequenceSlots(
                                  sidecar.diagnosticProofRaw32s.len,
                                  sidecar.diagnosticProofRaw32s.cap,
                                  retainedCapacity)) *
                        CompilerCsgFixed32Bytes()
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.spanStartBytes, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.spanEndBytes, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.spanStartLines, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.spanStartColumns, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.spanEndLines, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.spanEndColumns, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeProducerIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeParentIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeKinds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeSpanIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeChildStarts, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeChildCounts, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeChildIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeGenericStarts, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeGenericCounts, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeBindingResolutionKinds,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeBindingDeclarationSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.nodeBindingPatternSourceLocalRows,
                            retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.tokenProducerSourceIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.tokenSourceLocalRows, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.tokenLexicalParentIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.tokenKinds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.tokenSpanIds, retainedCapacity)
        total = total + Int64(CompilerCsgSequenceSlots(
                                  sidecar.tokenValues.len,
                                  sidecar.tokenValues.cap,
                                  retainedCapacity)) * CompilerCsgStrHeaderBytes()
        for tokenIndex in 0..<sidecar.tokenValues.len:
            total = total + Int64(sidecar.tokenValues[tokenIndex].len)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.genericSpanIds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
                            sidecar.regionKinds, retainedCapacity)
        total = total + CompilerCsgIntArrayBytesMode(
