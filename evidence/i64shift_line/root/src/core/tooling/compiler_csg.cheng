                        ctxProbeTypeBytes +
                            Int64(ctxProbe.declaredTypes[ctxProbeTypeIndex].len)
                    ctxProbeTypeIndex = ctxProbeTypeIndex + 1
                compilerCsgMemTraceEmit(
                    Fmt"ctx_probe src={ctxProbeIndex} lines={ctxProbe.lines.len} line_bytes={ctxProbeLineBytes} declared_types={ctxProbe.declaredTypes.len} type_bytes={ctxProbeTypeBytes} scopes={ctxProbe.scopes.len} sig_scopes={ctxProbe.signatureScopes.len} bindings={ctxProbe.bindings.len} importc={ctxProbe.importcFunctions.len} imported_mods={ctxProbe.importedModules.len} ref_types={ctxProbe.refTypes.len} alias_names={ctxProbe.typeDefAliasNames.len} fields={ctxProbe.typeFields.len} cold_type_rows={ctxProbe.coldCsgTypeRows.len} cold_stmt_rows={ctxProbe.coldCsgStatementRows.len} enum_names={ctxProbe.enumValueNames.len} line_starts={ctxProbe.sourceLineByteStarts.len} line_lens={ctxProbe.sourceLineByteLengths.len} line_numbers={ctxProbe.lineNumbers.len} override_idx={ctxProbe.sourceLineOverrideIndexes.len} override_texts={ctxProbe.sourceLineOverrideTexts.len} src_bytes={ctxProbe.sourceByteLength} owned={ctxProbe.buildIndexOwned ? 1 : 0} proj_ctx={ctxProbe.frozenMetadataContextIndex} build_rows={ctxProbeBuildRows}")
                ctxProbeSkip = 20
            ctxProbeSkip = ctxProbeSkip - 1
            ctxProbeIndex = ctxProbeIndex + 1
    if compilerCsgT4TimeTrace:
        compilerCsgT4Emit("source_identity_index", compilerCsgT4NowNs() - t4StepNs)
        t4StepNs = compilerCsgT4NowNs()
    var typedSourceIdentityIndex: texpr.TypedExprSourceIdentityIndex
    if !texpr.TypedExprBuildSourceIdentityIndex(work.typedSourceTexts,
                                                typedSourceIdentityIndex,
                                                err):
        return CompilerCsgBuildAbort(work)
    # [TA-MEM B2a] The forest merge and the typed source-context index used
    # to run before the reachable set; they read none of the reachable
    # outputs, and deferring them to after the line-store release means the
    # forest window no longer carries the interned line payload.  The only
    # consumer before the expr loop is typedContextLookup, which is produced
    # together with the forest at the deferred site below.
    let parserReceiptAccumulatorRes =
        parser_receipt.ParserNormalizedExprReceiptAccumulatorInit(
            sourceBundleCid,
            work.orderedSources,
            work.orderedSourceModules,
            canonicalImportEdges,
            work.reachableSet.functionNames.len)
    if IsErr(parserReceiptAccumulatorRes):
        err = Error(parserReceiptAccumulatorRes)
        return CompilerCsgBuildAbort(work)
    let parserNormalizedExprReceiptAccumulator =
        Value(parserReceiptAccumulatorRes)
    work.parserNormalizedExprReceiptAccumulator =
        parserNormalizedExprReceiptAccumulator
    # Metadata, declaration/import tables and initial reachability are the last
    # consumers of the full profile lines. Later function slices rebuild lines
    # from the immutable source snapshot and retain only compact profile metadata.
    if compilerCsgT4TimeTrace:
        compilerCsgT4Emit("receipt_accumulator_init", compilerCsgT4NowNs() - t4StepNs)
        t4StepNs = compilerCsgT4NowNs()
    CompilerCsgCompactProfilesForFixedPoint(work)
    if compilerCsgT4TimeTrace:
        compilerCsgT4Emit("compact_profiles", compilerCsgT4NowNs() - t4StepNs)
        t4StepNs = compilerCsgT4NowNs()
    let _profileSourcePayloadRelief = os.ProcessMemoryPressureRelief()
    if compilerCsgT4TimeTrace:
        compilerCsgT4Emit("relief_final", compilerCsgT4NowNs() - t4StepNs)
        compilerCsgT4Emit("segment_total", compilerCsgT4NowNs() - t4SegNs)
    CompilerCsgTraceStage("after_profile_source_payload_release")
    # [S1b step-3 (6)] One streaming pass replaces both the merge forest and
    # the separate TypeArena finalize: index proof, resolution authority,
    # arena append and call-declaration append all run on one resident source
    # tree and then seal.  `typedContextLookup` is produced here, which is why
    # this sits where the forest's context index used to sit.
    var typedContextLookup: parser.ParserSourcePathIndexLookup
    if !CompilerCsgStreamTypeArenaFromDeclarationIndexInto(
            work,
            typeDeclarationIndex,
            typedContextLookup,
            err):
        return CompilerCsgBuildAbort(work)
    CompilerCsgTraceStage("after_profile_lookup")
    let semanticTypedFactAccumulator =
        CompilerCsgSemanticTypedFactAccumulatorInit(
        work.semanticGraph,
        work.reachableSet.functionNames.len)
    work.semanticTypedFactAccumulator =
        semanticTypedFactAccumulator
    if !compilerCsgBuildExprCallProfileSourcesRec(
            work,
            out,
            linkPlan,
            0,
            packageNodeId,
            requirePortableReceipt,
            migrationSourceSyntax,
            reuseLinkPlanExprLayer,
            stableEntryPath,
            sourceReceipt.receiptCid,
            sourceReceipt.sourceSnapshotCount,
            typedContextLookup,
            typedSourceIdentityIndex,
            typedIrExprCountCursor,
            compilerCsgDebugStderr,
            err):
