                                                work.orderedSourceIndex,
                                                work.orderedSources,
                                                work.typedSourceTexts,
                                                work.typedSourceTextIndex,
                                                work.typedMetadataContexts,
                                                typedSourceIdentityIndex,
                                                typedContextLookup,
                                                work.reachableSet,
                                                linkPlan.exprLayer,
                                                work.activeSliceExprLayer,
                                                work.activeSliceTypedFacts,
                                                0,
                                                selectedInputExprCount,
                                                typedErr):
            err = typedErr
            return CompilerCsgBuildAbort(work)
    else:
        CompilerCsgTraceStage("after_streamed_typed_facts")
    CompilerCsgTraceStage("after_typed_facts")
    var semanticGraphTableErr = ""
    var typedExprFactCountForCid = CompilerCsgSemanticTypedFactCount(work.semanticGraph)
    CompilerCsgSemanticEnsureExprSliceTypedFactCoverage(work.semanticGraph)
    if !work.semanticGraph.exprSliceTypedFactComplete:
        err = Fmt" compiler csg: typed-fact slice validation failed reason={work.semanticGraph.exprSliceValidationReason} covered={work.semanticGraph.exprSliceTypedFactCoveredCount} gaps={work.semanticGraph.exprSliceTypedFactGapCount} overlaps={work.semanticGraph.exprSliceTypedFactOverlapCount} invalid={work.semanticGraph.exprSliceTypedFactInvalidSliceCount}"
        return CompilerCsgBuildAbort(work)
