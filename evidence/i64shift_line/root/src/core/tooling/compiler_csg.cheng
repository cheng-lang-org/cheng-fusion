    total = total + CompilerCsgInternIdArrayLiveBytes(ir.statements2_callCalleeIds)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.statements2_callTargetIds)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.statements2_callTargetSourcePathIds)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.statements2_callTargetSignatureLineNumbers) * 4)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.statements2_callArgsTextIds)
    total = total + CompilerCsgInternIdArrayLiveBytes(ir.statements2_callArgTypesTextIds)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.statements2_statementIndexs) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.statements2_lineNumbers) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.statements2_columnNumbers) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.statements2_lineIndents) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.statements2_enclosingIfLineNumbers) * 4)
    total = total + Int64(arenamod.ArenaArrayInt32Len(ir.arena, ir.statements2_conditionKinds) * 4)
