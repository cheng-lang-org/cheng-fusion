            return CompilerCsgBuildAbort(work)
        if !texpr.TypedExprSealedBuildIndexActive(work.typedIr) ||
           work.typedMetadataContexts.len != 0:
            err = " compiler csg: zero-function typed ir metadata ownership transfer failed"
            return CompilerCsgBuildAbort(work)
