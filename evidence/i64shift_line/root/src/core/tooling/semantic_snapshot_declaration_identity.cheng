import std/rawbytes
import std/seqs
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/lang/parser
import cheng/core/tooling/compiler_world

const
    SemanticSnapshotDeclarationKeyDomain: str = "cheng.semantic_snapshot.declaration_key"
    SemanticSnapshotDeclarationTableDomain: str = "cheng.semantic_snapshot.declaration_table"
    SemanticSnapshotDeclarationMappingDomain: str = "cheng.semantic_snapshot.declaration_mapping"

    SemanticSnapshotDeclarationNameSurfaceIdentifier: int32 = 1
    SemanticSnapshotDeclarationNameSurfaceBacktickOperator: int32 = 2
    SemanticSnapshotDeclarationNameSurfaceModulePath: int32 = 3

    SemanticSnapshotDeclarationKindModule: int32 = 1
    SemanticSnapshotDeclarationKindImportAlias: int32 = 2
    SemanticSnapshotDeclarationKindFunction: int32 = 3
    SemanticSnapshotDeclarationKindIterator: int32 = 4
    SemanticSnapshotDeclarationKindMacro: int32 = 5
    SemanticSnapshotDeclarationKindTemplate: int32 = 6
    SemanticSnapshotDeclarationKindType: int32 = 7
    SemanticSnapshotDeclarationKindConcept: int32 = 8
    SemanticSnapshotDeclarationKindTrait: int32 = 9
    SemanticSnapshotDeclarationKindField: int32 = 10
    SemanticSnapshotDeclarationKindEnumVariant: int32 = 11
    SemanticSnapshotDeclarationKindConst: int32 = 12
    SemanticSnapshotDeclarationKindGlobal: int32 = 13
    SemanticSnapshotDeclarationKindLocal: int32 = 14
    SemanticSnapshotDeclarationKindParameter: int32 = 15
    SemanticSnapshotDeclarationKindGenericParameter: int32 = 16
    SemanticSnapshotDeclarationKindLambda: int32 = 17
    SemanticSnapshotDeclarationKindLabel: int32 = 18

type
    # Producer-local rows are appended owner-first.  The portable signature /
    # type-expression CID must not contain this declaration's DeclKeyCid,
    # snapshot-local dense TypeId, raw type text, path, line, or row ordinal.
    SemanticSnapshotDeclarationCandidateStore =
        sealed: bool
        portableDocumentPackageIds: str[]
        portableDocumentModulePaths: str[]
        portableDocumentIdentityCids: layout.FixedBytes32[]
        ownerCandidateIndexes: int32[]
        declarationKinds: int32[]
        nameSurfaceKinds: int32[]
        canonicalNames: str[]
        # Parser admission evidence.  This module only checks observed + table
        # binding: the builder must match it to the exact parser receipt.  It
        # never enters portable DeclKey identity or carries content/span/order.
        parserValidatedNameProofCids: layout.FixedBytes32[]
        portableSignatureTypeExpressionCids: layout.FixedBytes32[]
        lexicalScopeCids: layout.FixedBytes32[]
        spanStartBytes: int32[]
        spanEndBytes: int32[]

    # DeclId is exactly the dense row index.  This is the published table and
    # is self-validating without retaining producer order or candidate state.
    SemanticSnapshotDeclarationTable =
        declIds: int32[]
        portableDocumentPackageIds: str[]
        portableDocumentModulePaths: str[]
        portableDocumentIdentityCids: layout.FixedBytes32[]
        ownerDeclIds: int32[]
        declarationKinds: int32[]
        nameSurfaceKinds: int32[]
        canonicalNames: str[]
        parserValidatedNameProofCids: layout.FixedBytes32[]
        portableSignatureTypeExpressionCids: layout.FixedBytes32[]
        lexicalScopeCids: layout.FixedBytes32[]
        declKeyCids: layout.FixedBytes32[]
        ownerDepths: int32[]
        spanStartBytes: int32[]
        spanEndBytes: int32[]
        maxOwnerDepth: int32
        canonicalBytes: Bytes
        tableCid: layout.FixedBytes32

    # Producer order is isolated in this seal receipt.  It is not a column of
    # the published declaration table and may differ for the same table CID.
    SemanticSnapshotDeclarationMappingReceipt =
        tableCid: layout.FixedBytes32
        producerCandidateToDeclIds: int32[]
        producerCandidateDeclKeyCids: layout.FixedBytes32[]
        maxOwnerDepth: int32
        receiptCid: layout.FixedBytes32

fn semanticSnapshotDeclarationAppendU32(
        out: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(out, (value >> 24) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, value & 255)

fn semanticSnapshotDeclarationAppendI32(
        out: var layout.ByteBuf,
        value: int32) =
    semanticSnapshotDeclarationAppendU32(out, 4)
    semanticSnapshotDeclarationAppendU32(out, value)

@borrows
fn semanticSnapshotDeclarationAppendText(
        out: var layout.ByteBuf,
        value: str) =
    semanticSnapshotDeclarationAppendU32(out, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(out, Int32(value[index]) & 255)

@borrows
fn semanticSnapshotDeclarationAppendCid(
        out: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    semanticSnapshotDeclarationAppendU32(out, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(out, value)

@borrows
fn semanticSnapshotDeclarationCidObserved(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

fn semanticSnapshotDeclarationKindValid(kind: int32): bool =
    return kind >= SemanticSnapshotDeclarationKindModule &&
           kind <= SemanticSnapshotDeclarationKindLabel

fn semanticSnapshotDeclarationRoutineKind(kind: int32): bool =
    return kind == SemanticSnapshotDeclarationKindFunction ||
           kind == SemanticSnapshotDeclarationKindIterator ||
           kind == SemanticSnapshotDeclarationKindMacro ||
           kind == SemanticSnapshotDeclarationKindTemplate

fn semanticSnapshotDeclarationCallableKind(kind: int32): bool =
    return semanticSnapshotDeclarationRoutineKind(kind) ||
           kind == SemanticSnapshotDeclarationKindLambda

@borrows
fn semanticSnapshotDeclarationIdentifierNameValid(name: str): bool =
    if name.len <= 0:
        return false
    if !parser.ParserValueExprIsIdentStart(name[0]):
        return false
    for index in 1..<name.len:
        if !parser.ParserValueExprIsIdentContinue(name[index]):
            return false
    return parser.ParserValueExprKeywordKind(name, 0, name.len) ==
           parser.ParserValueTokenIdentifier

@borrows
fn semanticSnapshotDeclarationNameValid(
        declarationKind: int32,
        nameSurfaceKind: int32,
        name: str,
        parserValidatedNameProofCid: layout.FixedBytes32): bool =
    if name.len <= 0 ||
       !semanticSnapshotDeclarationCidObserved(
            parserValidatedNameProofCid):
        return false
    if nameSurfaceKind ==
           SemanticSnapshotDeclarationNameSurfaceIdentifier:
        return semanticSnapshotDeclarationIdentifierNameValid(name)
    if nameSurfaceKind ==
           SemanticSnapshotDeclarationNameSurfaceBacktickOperator:
        # Parser owns the exact backtick grammar.  The producer supplies its
        # validated proof CID; this layer only constrains the legal declaration
        # role and binds proof, surface kind, and text cryptographically.
        return semanticSnapshotDeclarationRoutineKind(declarationKind)
    if nameSurfaceKind ==
           SemanticSnapshotDeclarationNameSurfaceModulePath:
        return declarationKind == SemanticSnapshotDeclarationKindModule &&
               parser.ParserSourceIdentityModuleTextValid(name)
    return false

@borrows
fn semanticSnapshotDeclarationDocumentIdentityValidInto(
        packageId: str,
        modulePath: str,
        portableDocumentIdentityCid: layout.FixedBytes32,
        err: var str): bool =
    var expected: layout.FixedBytes32
    if !compiler_world.CompilerWorldDocumentCidInto(
            packageId, modulePath, expected, err):
        return false
    if !layout.FixedBytes32Equal(
            expected, portableDocumentIdentityCid):
        err = " semantic snapshot declaration: document identity CID drift"
        return false
    return true

@borrows
fn semanticSnapshotDeclarationCidLess(
        left: layout.FixedBytes32,
        right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] < right.data[index]:
            return true
        if left.data[index] > right.data[index]:
            return false
    return false

fn semanticSnapshotDeclarationNestedOwnerKind(ownerKind: int32): bool =
    return semanticSnapshotDeclarationCallableKind(ownerKind)

fn semanticSnapshotDeclarationGenericOwnerKind(ownerKind: int32): bool =
    return semanticSnapshotDeclarationCallableKind(ownerKind) ||
           ownerKind == SemanticSnapshotDeclarationKindType ||
           ownerKind == SemanticSnapshotDeclarationKindConcept ||
           ownerKind == SemanticSnapshotDeclarationKindTrait

@borrows
fn semanticSnapshotDeclarationOwnerScopeValid(
        declarationKind: int32,
        ownerIndex: int32,
        ownerKind: int32,
        lexicalScopeCid: layout.FixedBytes32): bool =
    let scopeObserved =
        semanticSnapshotDeclarationCidObserved(lexicalScopeCid)
    if declarationKind == SemanticSnapshotDeclarationKindModule:
        return ownerIndex < 0 && !scopeObserved
    if ownerIndex < 0:
        return false
    if declarationKind == SemanticSnapshotDeclarationKindImportAlias ||
       declarationKind == SemanticSnapshotDeclarationKindGlobal:
        return ownerKind == SemanticSnapshotDeclarationKindModule &&
               !scopeObserved
    if declarationKind == SemanticSnapshotDeclarationKindField ||
       declarationKind == SemanticSnapshotDeclarationKindEnumVariant:
        return ownerIndex >= 0 &&
               ownerKind == SemanticSnapshotDeclarationKindType &&
               !scopeObserved
    if declarationKind == SemanticSnapshotDeclarationKindLocal ||
       declarationKind == SemanticSnapshotDeclarationKindLabel:
        return semanticSnapshotDeclarationCallableKind(ownerKind) &&
               scopeObserved
    if declarationKind == SemanticSnapshotDeclarationKindParameter:
        return semanticSnapshotDeclarationCallableKind(ownerKind) &&
               !scopeObserved
    if declarationKind ==
           SemanticSnapshotDeclarationKindGenericParameter:
        return semanticSnapshotDeclarationGenericOwnerKind(ownerKind) &&
               !scopeObserved
    if declarationKind == SemanticSnapshotDeclarationKindLambda:
        return semanticSnapshotDeclarationNestedOwnerKind(ownerKind) &&
               scopeObserved
    if ownerKind == SemanticSnapshotDeclarationKindModule:
        return !scopeObserved
    return semanticSnapshotDeclarationNestedOwnerKind(ownerKind) &&
           scopeObserved

@borrows
fn semanticSnapshotDeclarationCandidateShapeValid(
        store: SemanticSnapshotDeclarationCandidateStore): bool =
    let count = store.portableDocumentIdentityCids.len
    return store.portableDocumentPackageIds.len == count &&
           store.portableDocumentModulePaths.len == count &&
           store.ownerCandidateIndexes.len == count &&
           store.declarationKinds.len == count &&
           store.nameSurfaceKinds.len == count &&
           store.canonicalNames.len == count &&
           store.parserValidatedNameProofCids.len == count &&
           store.portableSignatureTypeExpressionCids.len == count &&
           store.lexicalScopeCids.len == count &&
           store.spanStartBytes.len == count &&
           store.spanEndBytes.len == count

@borrows
fn semanticSnapshotDeclarationCandidateRowValidInto(
        store: SemanticSnapshotDeclarationCandidateStore,
        row: int32,
        err: var str): bool =
    if row < 0 || row >= store.portableDocumentIdentityCids.len:
        err = " semantic snapshot declaration: candidate row out of range"
        return false
    let owner = store.ownerCandidateIndexes[row]
    let kind = store.declarationKinds[row]
    if !semanticSnapshotDeclarationDocumentIdentityValidInto(
            store.portableDocumentPackageIds[row],
            store.portableDocumentModulePaths[row],
            store.portableDocumentIdentityCids[row], err) ||
       !semanticSnapshotDeclarationCidObserved(
           store.portableSignatureTypeExpressionCids[row]):
        if err == "":
            err = " semantic snapshot declaration: unobserved portable identity"
        return false
    if !semanticSnapshotDeclarationKindValid(kind) ||
       !semanticSnapshotDeclarationNameValid(
           kind, store.nameSurfaceKinds[row],
           store.canonicalNames[row],
           store.parserValidatedNameProofCids[row]):
        err = " semantic snapshot declaration: invalid kind or canonical name"
        return false
    if kind == SemanticSnapshotDeclarationKindModule &&
       (!layout.FixedBytes32Equal(
            store.parserValidatedNameProofCids[row],
            store.portableDocumentIdentityCids[row]) ||
        !layout.FixedBytes32Equal(
            store.portableSignatureTypeExpressionCids[row],
            store.portableDocumentIdentityCids[row]) ||
        store.canonicalNames[row] !=
            store.portableDocumentModulePaths[row]):
        err = " semantic snapshot declaration: module authority drift"
        return false
    if owner < -1 || owner >= row:
        err = " semantic snapshot declaration: forward owner or owner cycle"
        return false
    var ownerKind: int32
    if owner >= 0:
        ownerKind = store.declarationKinds[owner]
        if !layout.FixedBytes32Equal(
                store.portableDocumentIdentityCids[row],
                store.portableDocumentIdentityCids[owner]):
            err = " semantic snapshot declaration: owner document identity split"
            return false
        if store.portableDocumentPackageIds[row] !=
               store.portableDocumentPackageIds[owner] ||
           store.portableDocumentModulePaths[row] !=
               store.portableDocumentModulePaths[owner]:
            err = " semantic snapshot declaration: owner document proof split"
            return false
    if !semanticSnapshotDeclarationOwnerScopeValid(
            kind, owner, ownerKind, store.lexicalScopeCids[row]):
        err = " semantic snapshot declaration: owner/scope kind mismatch"
        return false
    if store.spanStartBytes[row] < 0 ||
       store.spanEndBytes[row] < store.spanStartBytes[row]:
        err = " semantic snapshot declaration: invalid source span payload"
        return false
    return true

fn SemanticSnapshotDeclarationCandidateStoreInitInto(
        out: var SemanticSnapshotDeclarationCandidateStore) =
    var store: SemanticSnapshotDeclarationCandidateStore
    out = store

@borrows
fn SemanticSnapshotDeclarationCandidateStoreStrictValidateInto(
        store: SemanticSnapshotDeclarationCandidateStore,
        err: var str): bool =
    err = ""
    if !semanticSnapshotDeclarationCandidateShapeValid(store):
        err = " semantic snapshot declaration: candidate SoA shape mismatch"
        return false
    for row in 0..<store.portableDocumentIdentityCids.len:
        if !semanticSnapshotDeclarationCandidateRowValidInto(
                store, row, err):
            return false
    return true

# sourcePhysicalPath is an ingress poison field, never retained or hashed.
# portableDocumentIdentityCid must be exactly the compiler authority's stable
# H(canonical package id, canonical module path); source content is excluded.
@borrows
fn SemanticSnapshotDeclarationCandidateAppendInto(
        store: var SemanticSnapshotDeclarationCandidateStore,
        portableDocumentPackageId: str,
        portableDocumentModulePath: str,
        portableDocumentIdentityCid: layout.FixedBytes32,
        sourcePhysicalPath: str,
        ownerCandidateIndex: int32,
        declarationKind: int32,
        nameSurfaceKind: int32,
        canonicalName: str,
        parserValidatedNameProofCid: layout.FixedBytes32,
        portableSignatureTypeExpressionCid: layout.FixedBytes32,
        lexicalScopeCid: layout.FixedBytes32,
        spanStartByte: int32,
        spanEndByte: int32,
        candidateIndexOut: var int32,
        err: var str): bool =
    err = ""
    candidateIndexOut = -1
    if store.sealed:
        err = " semantic snapshot declaration: append after seal"
        return false
    if sourcePhysicalPath.len != 0:
        err = " semantic snapshot declaration: physical source path forbidden"
        return false
    if !semanticSnapshotDeclarationCandidateShapeValid(store):
        err = " semantic snapshot declaration: candidate SoA shape mismatch"
        return false
    if store.portableDocumentIdentityCids.len == 2147483647:
        err = " semantic snapshot declaration: candidate index overflow"
        return false
    let row = store.portableDocumentIdentityCids.len
    if ownerCandidateIndex < -1 || ownerCandidateIndex >= row:
        err = " semantic snapshot declaration: forward owner forbidden"
        return false
    add(store.portableDocumentPackageIds, share(portableDocumentPackageId))
    add(store.portableDocumentModulePaths, share(portableDocumentModulePath))
    add(store.portableDocumentIdentityCids, portableDocumentIdentityCid)
    add(store.ownerCandidateIndexes, ownerCandidateIndex)
    add(store.declarationKinds, declarationKind)
    add(store.nameSurfaceKinds, nameSurfaceKind)
    add(store.canonicalNames, share(canonicalName))
    add(store.parserValidatedNameProofCids,
        parserValidatedNameProofCid)
    add(store.portableSignatureTypeExpressionCids,
        portableSignatureTypeExpressionCid)
    add(store.lexicalScopeCids, lexicalScopeCid)
    add(store.spanStartBytes, spanStartByte)
    add(store.spanEndBytes, spanEndByte)
    if !semanticSnapshotDeclarationCandidateRowValidInto(store, row, err):
        setLen(store.portableDocumentPackageIds, row)
        setLen(store.portableDocumentModulePaths, row)
        setLen(store.portableDocumentIdentityCids, row)
        setLen(store.ownerCandidateIndexes, row)
        setLen(store.declarationKinds, row)
        setLen(store.nameSurfaceKinds, row)
        setLen(store.canonicalNames, row)
        setLen(store.parserValidatedNameProofCids, row)
        setLen(store.portableSignatureTypeExpressionCids, row)
        setLen(store.lexicalScopeCids, row)
        setLen(store.spanStartBytes, row)
        setLen(store.spanEndBytes, row)
        return false
    candidateIndexOut = row
    return true

@borrows
fn semanticSnapshotDeclarationKeyCid(
        portableDocumentIdentityCid: layout.FixedBytes32,
        ownerDeclKeyCid: layout.FixedBytes32,
        declarationKind: int32,
        nameSurfaceKind: int32,
        canonicalName: str,
        portableSignatureTypeExpressionCid: layout.FixedBytes32,
        lexicalScopeCid: layout.FixedBytes32): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(256 + canonicalName.len)
    semanticSnapshotDeclarationAppendText(
        bytes, SemanticSnapshotDeclarationKeyDomain)
    semanticSnapshotDeclarationAppendCid(bytes, portableDocumentIdentityCid)
    semanticSnapshotDeclarationAppendCid(bytes, ownerDeclKeyCid)
    semanticSnapshotDeclarationAppendI32(bytes, declarationKind)
    semanticSnapshotDeclarationAppendI32(bytes, nameSurfaceKind)
    semanticSnapshotDeclarationAppendText(bytes, canonicalName)
    semanticSnapshotDeclarationAppendCid(
        bytes, portableSignatureTypeExpressionCid)
    semanticSnapshotDeclarationAppendCid(bytes, lexicalScopeCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn semanticSnapshotDeclarationCandidateKeysInto(
        store: SemanticSnapshotDeclarationCandidateStore,
        keysOut: var layout.FixedBytes32[],
        depthsOut: var int32[],
        maxDepthOut: var int32) =
    keysOut = []
    depthsOut = []
    maxDepthOut = 0
    setLen(keysOut, store.portableDocumentIdentityCids.len)
    setLen(depthsOut, store.portableDocumentIdentityCids.len)
    for row in 0..<store.portableDocumentIdentityCids.len:
        let owner = store.ownerCandidateIndexes[row]
        var ownerKey: layout.FixedBytes32
        var depth: int32
        if owner >= 0:
            ownerKey =
                layout.FixedBytes32Copy(keysOut[owner])
            depth = depthsOut[owner] + 1
        keysOut[row] = semanticSnapshotDeclarationKeyCid(
            store.portableDocumentIdentityCids[row], ownerKey,
            store.declarationKinds[row], store.nameSurfaceKinds[row],
            store.canonicalNames[row],
            store.portableSignatureTypeExpressionCids[row],
            store.lexicalScopeCids[row])
        depthsOut[row] = depth
        if depth > maxDepthOut:
            maxDepthOut = depth

@borrows
fn semanticSnapshotDeclarationRadixOrderInto(
        keys: layout.FixedBytes32[],
        orderOut: var int32[],
        err: var str): bool =
    orderOut = []
    setLen(orderOut, keys.len)
    for row in 0..<keys.len:
        orderOut[row] = row
    # Stable least-significant-byte radix sort over exactly 32 key bytes.
    for passIndex in 0..<layout.FixedBytes32Size:
        let byteIndex = layout.FixedBytes32Size - 1 - passIndex
        var counts: int32[]
        var offsets: int32[]
        setLen(counts, 256)
        setLen(offsets, 256)
        for rowIndex in 0..<orderOut.len:
            let bucket = Int32(keys[orderOut[rowIndex]].data[byteIndex])
            counts[bucket] = counts[bucket] + 1
        var cursor: int32
        for bucket in 0..<256:
            offsets[bucket] = cursor
            cursor = cursor + counts[bucket]
        var sorted: int32[]
        setLen(sorted, orderOut.len)
        for rowIndex in 0..<orderOut.len:
            let row = orderOut[rowIndex]
            let bucket = Int32(keys[row].data[byteIndex])
            sorted[offsets[bucket]] = row
            offsets[bucket] = offsets[bucket] + 1
        orderOut = sorted
    for row in 1..<orderOut.len:
        if layout.FixedBytes32Equal(
                keys[orderOut[row - 1]], keys[orderOut[row]]):
            err = " semantic snapshot declaration: duplicate declaration key"
            return false
    return true

@borrows
fn semanticSnapshotDeclarationCanonicalBytesInto(
        table: SemanticSnapshotDeclarationTable): Bytes =
    var bytes = layout.ByteBufInit(512)
    semanticSnapshotDeclarationAppendText(
        bytes, SemanticSnapshotDeclarationTableDomain)
    semanticSnapshotDeclarationAppendI32(bytes, table.declIds.len)
    semanticSnapshotDeclarationAppendI32(bytes, table.maxOwnerDepth)
    for declId in 0..<table.declIds.len:
        semanticSnapshotDeclarationAppendI32(bytes, table.declIds[declId])
        semanticSnapshotDeclarationAppendCid(
            bytes, table.declKeyCids[declId])
        semanticSnapshotDeclarationAppendText(
            bytes, table.portableDocumentPackageIds[declId])
        semanticSnapshotDeclarationAppendText(
            bytes, table.portableDocumentModulePaths[declId])
        semanticSnapshotDeclarationAppendCid(
            bytes, table.portableDocumentIdentityCids[declId])
        semanticSnapshotDeclarationAppendI32(
            bytes, table.ownerDeclIds[declId])
        semanticSnapshotDeclarationAppendI32(
            bytes, table.declarationKinds[declId])
        semanticSnapshotDeclarationAppendI32(
            bytes, table.nameSurfaceKinds[declId])
        semanticSnapshotDeclarationAppendText(
            bytes, table.canonicalNames[declId])
        semanticSnapshotDeclarationAppendCid(
            bytes, table.parserValidatedNameProofCids[declId])
        semanticSnapshotDeclarationAppendCid(
            bytes, table.portableSignatureTypeExpressionCids[declId])
        semanticSnapshotDeclarationAppendCid(
            bytes, table.lexicalScopeCids[declId])
        semanticSnapshotDeclarationAppendI32(
            bytes, table.ownerDepths[declId])
        semanticSnapshotDeclarationAppendI32(
            bytes, table.spanStartBytes[declId])
        semanticSnapshotDeclarationAppendI32(
            bytes, table.spanEndBytes[declId])
    let canonicalBytes = layout.ByteBufToBytes(bytes)
    layout.ByteBufFree(bytes)
    return canonicalBytes

@borrows
fn semanticSnapshotDeclarationMappingReceiptCid(
        receipt: SemanticSnapshotDeclarationMappingReceipt):
        layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(512)
    semanticSnapshotDeclarationAppendText(
        bytes, SemanticSnapshotDeclarationMappingDomain)
    semanticSnapshotDeclarationAppendCid(bytes, receipt.tableCid)
    semanticSnapshotDeclarationAppendI32(
        bytes, receipt.producerCandidateToDeclIds.len)
    semanticSnapshotDeclarationAppendI32(bytes, receipt.maxOwnerDepth)
    for candidateIndex in 0..<receipt.producerCandidateToDeclIds.len:
        semanticSnapshotDeclarationAppendI32(bytes, candidateIndex)
        semanticSnapshotDeclarationAppendCid(
            bytes, receipt.producerCandidateDeclKeyCids[candidateIndex])
        semanticSnapshotDeclarationAppendI32(
            bytes, receipt.producerCandidateToDeclIds[candidateIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

@borrows
fn semanticSnapshotDeclarationTableShapeValid(
        table: SemanticSnapshotDeclarationTable): bool =
    let count = table.declIds.len
    return table.portableDocumentPackageIds.len == count &&
           table.portableDocumentModulePaths.len == count &&
           table.portableDocumentIdentityCids.len == count &&
           table.ownerDeclIds.len == count &&
           table.declarationKinds.len == count &&
           table.nameSurfaceKinds.len == count &&
           table.canonicalNames.len == count &&
           table.parserValidatedNameProofCids.len == count &&
           table.portableSignatureTypeExpressionCids.len == count &&
           table.lexicalScopeCids.len == count &&
           table.declKeyCids.len == count &&
           table.ownerDepths.len == count &&
           table.spanStartBytes.len == count &&
           table.spanEndBytes.len == count

@borrows
fn SemanticSnapshotDeclarationTableStrictValidateInto(
        table: SemanticSnapshotDeclarationTable,
        err: var str): bool =
    err = ""
    if !semanticSnapshotDeclarationTableShapeValid(table) ||
       rawbytes.BytesLen(table.canonicalBytes) <= 0 ||
       !semanticSnapshotDeclarationCidObserved(table.tableCid):
        err = " semantic snapshot declaration: invalid published table shape"
        return false
    var observedMaxDepth: int32
    for declId in 0..<table.declIds.len:
        if table.declIds[declId] != declId:
            err = " semantic snapshot declaration: non-dense DeclId"
            return false
        if declId > 0 &&
           !semanticSnapshotDeclarationCidLess(
               table.declKeyCids[declId - 1], table.declKeyCids[declId]):
            err = " semantic snapshot declaration: non-canonical key order"
            return false
        let ownerDeclId = table.ownerDeclIds[declId]
        if ownerDeclId < -1 || ownerDeclId >= table.declIds.len ||
           ownerDeclId == declId:
            err = " semantic snapshot declaration: invalid owner DeclId"
            return false
        var ownerKey: layout.FixedBytes32
        var ownerKind: int32
        var expectedDepth: int32
        if ownerDeclId >= 0:
            ownerKey =
                layout.FixedBytes32Copy(
                    table.declKeyCids[ownerDeclId])
            ownerKind = table.declarationKinds[ownerDeclId]
            expectedDepth = table.ownerDepths[ownerDeclId] + 1
            if !layout.FixedBytes32Equal(
                    table.portableDocumentIdentityCids[declId],
                    table.portableDocumentIdentityCids[ownerDeclId]):
                err = " semantic snapshot declaration: owner document remap drift"
                return false
            if table.portableDocumentPackageIds[declId] !=
                   table.portableDocumentPackageIds[ownerDeclId] ||
               table.portableDocumentModulePaths[declId] !=
                   table.portableDocumentModulePaths[ownerDeclId]:
                err = " semantic snapshot declaration: owner document proof drift"
                return false
        if expectedDepth != table.ownerDepths[declId] ||
           expectedDepth < 0 || expectedDepth > table.declIds.len:
            err = " semantic snapshot declaration: owner depth drift or cycle"
            return false
        if expectedDepth > observedMaxDepth:
            observedMaxDepth = expectedDepth
        let kind = table.declarationKinds[declId]
        if !semanticSnapshotDeclarationKindValid(kind) ||
           !semanticSnapshotDeclarationNameValid(
               kind, table.nameSurfaceKinds[declId],
               table.canonicalNames[declId],
               table.parserValidatedNameProofCids[declId]) ||
           !semanticSnapshotDeclarationDocumentIdentityValidInto(
               table.portableDocumentPackageIds[declId],
               table.portableDocumentModulePaths[declId],
               table.portableDocumentIdentityCids[declId], err) ||
           !semanticSnapshotDeclarationCidObserved(
               table.portableSignatureTypeExpressionCids[declId]) ||
           !semanticSnapshotDeclarationOwnerScopeValid(
               kind, ownerDeclId, ownerKind,
               table.lexicalScopeCids[declId]) ||
           table.spanStartBytes[declId] < 0 ||
           table.spanEndBytes[declId] < table.spanStartBytes[declId]:
            err = " semantic snapshot declaration: invalid canonical row"
            return false
        if kind == SemanticSnapshotDeclarationKindModule &&
           (!layout.FixedBytes32Equal(
                table.parserValidatedNameProofCids[declId],
                table.portableDocumentIdentityCids[declId]) ||
            !layout.FixedBytes32Equal(
                table.portableSignatureTypeExpressionCids[declId],
                table.portableDocumentIdentityCids[declId]) ||
            table.canonicalNames[declId] !=
                table.portableDocumentModulePaths[declId]):
            err = " semantic snapshot declaration: module authority drift"
            return false
        let expectedKey = semanticSnapshotDeclarationKeyCid(
            table.portableDocumentIdentityCids[declId], ownerKey, kind,
            table.nameSurfaceKinds[declId],
            table.canonicalNames[declId],
            table.portableSignatureTypeExpressionCids[declId],
            table.lexicalScopeCids[declId])
        if !layout.FixedBytes32Equal(
                expectedKey, table.declKeyCids[declId]):
            err = " semantic snapshot declaration: DeclKeyCid drift"
            return false
    if observedMaxDepth != table.maxOwnerDepth:
        err = " semantic snapshot declaration: maximum owner depth drift"
        return false
    var expectedBytes =
        semanticSnapshotDeclarationCanonicalBytesInto(table)
    let expectedTableCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(expectedBytes))
    let bytesMatch = rawbytes.BytesEqual(
        expectedBytes, table.canonicalBytes)
    rawbytes.BytesFree(expectedBytes)
    if !bytesMatch ||
       !layout.FixedBytes32Equal(expectedTableCid, table.tableCid):
        err = " semantic snapshot declaration: canonical table bytes drift"
        return false
    return true

@borrows
fn SemanticSnapshotDeclarationMappingReceiptStrictValidateInto(
        store: SemanticSnapshotDeclarationCandidateStore,
        table: SemanticSnapshotDeclarationTable,
        receipt: SemanticSnapshotDeclarationMappingReceipt,
        err: var str): bool =
    err = ""
    if !store.sealed:
        err = " semantic snapshot declaration: candidate store not sealed"
        return false
    if !SemanticSnapshotDeclarationCandidateStoreStrictValidateInto(
            store, err) ||
       !SemanticSnapshotDeclarationTableStrictValidateInto(table, err):
        return false
    let count = store.portableDocumentIdentityCids.len
    if receipt.producerCandidateToDeclIds.len != count ||
       receipt.producerCandidateDeclKeyCids.len != count ||
       table.declIds.len != count ||
       !layout.FixedBytes32Equal(receipt.tableCid, table.tableCid) ||
       receipt.maxOwnerDepth != table.maxOwnerDepth ||
       !semanticSnapshotDeclarationCidObserved(receipt.receiptCid):
        err = " semantic snapshot declaration: invalid mapping receipt shape"
        return false
    var candidateKeys: layout.FixedBytes32[]
    var candidateDepths: int32[]
    var maxDepth: int32
    semanticSnapshotDeclarationCandidateKeysInto(
        store, candidateKeys, candidateDepths, maxDepth)
    if maxDepth != receipt.maxOwnerDepth:
        err = " semantic snapshot declaration: mapping owner depth drift"
        return false
    var seenDeclIds: bool[]
    setLen(seenDeclIds, count)
    for candidateIndex in 0..<count:
        let declId = receipt.producerCandidateToDeclIds[candidateIndex]
        if declId < 0 || declId >= count || seenDeclIds[declId] ||
           !layout.FixedBytes32Equal(
               candidateKeys[candidateIndex],
               receipt.producerCandidateDeclKeyCids[candidateIndex]) ||
           !layout.FixedBytes32Equal(
               candidateKeys[candidateIndex], table.declKeyCids[declId]):
            err = " semantic snapshot declaration: candidate mapping drift"
            return false
        seenDeclIds[declId] = true
        let ownerCandidate = store.ownerCandidateIndexes[candidateIndex]
        let expectedOwnerDeclId = ownerCandidate < 0 ? -1 :
            receipt.producerCandidateToDeclIds[ownerCandidate]
        if expectedOwnerDeclId != table.ownerDeclIds[declId] ||
           candidateDepths[candidateIndex] != table.ownerDepths[declId] ||
           !layout.FixedBytes32Equal(
               store.portableDocumentIdentityCids[candidateIndex],
               table.portableDocumentIdentityCids[declId]) ||
           store.portableDocumentPackageIds[candidateIndex] !=
               table.portableDocumentPackageIds[declId] ||
           store.portableDocumentModulePaths[candidateIndex] !=
               table.portableDocumentModulePaths[declId] ||
           store.declarationKinds[candidateIndex] !=
               table.declarationKinds[declId] ||
           store.nameSurfaceKinds[candidateIndex] !=
               table.nameSurfaceKinds[declId] ||
           store.canonicalNames[candidateIndex] !=
               table.canonicalNames[declId] ||
           !layout.FixedBytes32Equal(
               store.parserValidatedNameProofCids[candidateIndex],
               table.parserValidatedNameProofCids[declId]) ||
           !layout.FixedBytes32Equal(
               store.portableSignatureTypeExpressionCids[candidateIndex],
               table.portableSignatureTypeExpressionCids[declId]) ||
           !layout.FixedBytes32Equal(
               store.lexicalScopeCids[candidateIndex],
               table.lexicalScopeCids[declId]) ||
           store.spanStartBytes[candidateIndex] !=
               table.spanStartBytes[declId] ||
           store.spanEndBytes[candidateIndex] !=
               table.spanEndBytes[declId]:
            err = " semantic snapshot declaration: producer/table row split"
            return false
    for declId in 0..<seenDeclIds.len:
        if !seenDeclIds[declId]:
            err = " semantic snapshot declaration: unmapped DeclId"
            return false
    if !layout.FixedBytes32Equal(
            semanticSnapshotDeclarationMappingReceiptCid(receipt),
            receipt.receiptCid):
        err = " semantic snapshot declaration: mapping receipt CID drift"
        return false
    return true

fn SemanticSnapshotDeclarationTableSealInto(
        store: var SemanticSnapshotDeclarationCandidateStore,
        tableOut: var SemanticSnapshotDeclarationTable,
        receiptOut: var SemanticSnapshotDeclarationMappingReceipt,
        err: var str): bool =
    err = ""
    if store.sealed:
        err = " semantic snapshot declaration: duplicate seal"
        return false
    if !SemanticSnapshotDeclarationCandidateStoreStrictValidateInto(
            store, err):
        return false
    var candidateKeys: layout.FixedBytes32[]
    var candidateDepths: int32[]
    var maxDepth: int32
    semanticSnapshotDeclarationCandidateKeysInto(
        store, candidateKeys, candidateDepths, maxDepth)
    var order: int32[]
    if !semanticSnapshotDeclarationRadixOrderInto(
            candidateKeys, order, err):
        return false
    var receipt: SemanticSnapshotDeclarationMappingReceipt
    let emptyTableCid = layout.FixedBytes32()
    receipt.tableCid = emptyTableCid
    receipt.maxOwnerDepth = maxDepth
    setLen(receipt.producerCandidateToDeclIds, order.len)
    setLen(receipt.producerCandidateDeclKeyCids, order.len)
    for candidateIndex in 0..<order.len:
        receipt.producerCandidateToDeclIds[candidateIndex] = -1
        receipt.producerCandidateDeclKeyCids[candidateIndex] =
            candidateKeys[candidateIndex]
    for declId in 0..<order.len:
        receipt.producerCandidateToDeclIds[order[declId]] = declId
    var table: SemanticSnapshotDeclarationTable
    for declId in 0..<order.len:
        let candidateIndex = order[declId]
        let ownerCandidate = store.ownerCandidateIndexes[candidateIndex]
        add(table.declIds, declId)
        add(table.portableDocumentPackageIds,
            share(store.portableDocumentPackageIds[candidateIndex]))
        add(table.portableDocumentModulePaths,
            share(store.portableDocumentModulePaths[candidateIndex]))
        add(table.portableDocumentIdentityCids,
            store.portableDocumentIdentityCids[candidateIndex])
        add(table.ownerDeclIds,
            ownerCandidate < 0 ? -1 :
                receipt.producerCandidateToDeclIds[ownerCandidate])
        add(table.declarationKinds,
            store.declarationKinds[candidateIndex])
        add(table.nameSurfaceKinds,
            store.nameSurfaceKinds[candidateIndex])
        add(table.canonicalNames,
            share(store.canonicalNames[candidateIndex]))
        add(table.parserValidatedNameProofCids,
            store.parserValidatedNameProofCids[candidateIndex])
        add(table.portableSignatureTypeExpressionCids,
            store.portableSignatureTypeExpressionCids[candidateIndex])
        add(table.lexicalScopeCids,
            store.lexicalScopeCids[candidateIndex])
        add(table.declKeyCids, candidateKeys[candidateIndex])
        add(table.ownerDepths, candidateDepths[candidateIndex])
        add(table.spanStartBytes, store.spanStartBytes[candidateIndex])
        add(table.spanEndBytes, store.spanEndBytes[candidateIndex])
    table.maxOwnerDepth = maxDepth
    let canonicalBytes =
        semanticSnapshotDeclarationCanonicalBytesInto(table)
    let tableCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(canonicalBytes))
    table.canonicalBytes = canonicalBytes
    table.tableCid = tableCid
    var receiptCanonicalBytes =
        semanticSnapshotDeclarationCanonicalBytesInto(table)
    let receiptTableCid = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(receiptCanonicalBytes))
    rawbytes.BytesFree(receiptCanonicalBytes)
    receipt.tableCid = receiptTableCid
    let receiptCid =
        semanticSnapshotDeclarationMappingReceiptCid(receipt)
    receipt.receiptCid = receiptCid
    store.sealed = true
    if !SemanticSnapshotDeclarationTableStrictValidateInto(table, err) ||
       !SemanticSnapshotDeclarationMappingReceiptStrictValidateInto(
           store, table, receipt, err):
        rawbytes.BytesFree(table.canonicalBytes)
        panic("semantic_snapshot_declaration_generated_seal_invalid")
    tableOut = table
    receiptOut = receipt
    err = ""
    return true

fn SemanticSnapshotDeclarationTableReleaseInto(
        table: var SemanticSnapshotDeclarationTable) =
    if table.declIds.cap > 0 &&
       (table.declIds.buffer == nil ||
        system.memRefCount(table.declIds.buffer) != 1):
        panic("semantic_snapshot_declaration_decl_ids_storage_shared")
    if table.portableDocumentPackageIds.cap > 0 &&
       (table.portableDocumentPackageIds.buffer == nil ||
        system.memRefCount(
            table.portableDocumentPackageIds.buffer) != 1):
        panic("semantic_snapshot_declaration_package_ids_storage_shared")
    if table.portableDocumentModulePaths.cap > 0 &&
       (table.portableDocumentModulePaths.buffer == nil ||
        system.memRefCount(
            table.portableDocumentModulePaths.buffer) != 1):
        panic("semantic_snapshot_declaration_module_paths_storage_shared")
    if table.portableDocumentIdentityCids.cap > 0 &&
       (table.portableDocumentIdentityCids.buffer == nil ||
        system.memRefCount(
            table.portableDocumentIdentityCids.buffer) != 1):
        panic("semantic_snapshot_declaration_document_cids_storage_shared")
    if table.ownerDeclIds.cap > 0 &&
       (table.ownerDeclIds.buffer == nil ||
        system.memRefCount(table.ownerDeclIds.buffer) != 1):
        panic("semantic_snapshot_declaration_owner_ids_storage_shared")
    if table.declarationKinds.cap > 0 &&
       (table.declarationKinds.buffer == nil ||
        system.memRefCount(table.declarationKinds.buffer) != 1):
        panic("semantic_snapshot_declaration_kinds_storage_shared")
    if table.nameSurfaceKinds.cap > 0 &&
       (table.nameSurfaceKinds.buffer == nil ||
        system.memRefCount(table.nameSurfaceKinds.buffer) != 1):
        panic("semantic_snapshot_declaration_name_kinds_storage_shared")
    if table.canonicalNames.cap > 0 &&
       (table.canonicalNames.buffer == nil ||
        system.memRefCount(table.canonicalNames.buffer) != 1):
        panic("semantic_snapshot_declaration_names_storage_shared")
    if table.parserValidatedNameProofCids.cap > 0 &&
       (table.parserValidatedNameProofCids.buffer == nil ||
        system.memRefCount(
            table.parserValidatedNameProofCids.buffer) != 1):
        panic("semantic_snapshot_declaration_name_proofs_storage_shared")
    if table.portableSignatureTypeExpressionCids.cap > 0 &&
       (table.portableSignatureTypeExpressionCids.buffer == nil ||
        system.memRefCount(
            table.portableSignatureTypeExpressionCids.buffer) != 1):
        panic("semantic_snapshot_declaration_type_cids_storage_shared")
    if table.lexicalScopeCids.cap > 0 &&
       (table.lexicalScopeCids.buffer == nil ||
        system.memRefCount(table.lexicalScopeCids.buffer) != 1):
        panic("semantic_snapshot_declaration_scope_cids_storage_shared")
    if table.declKeyCids.cap > 0 &&
       (table.declKeyCids.buffer == nil ||
        system.memRefCount(table.declKeyCids.buffer) != 1):
        panic("semantic_snapshot_declaration_key_cids_storage_shared")
    if table.ownerDepths.cap > 0 &&
       (table.ownerDepths.buffer == nil ||
        system.memRefCount(table.ownerDepths.buffer) != 1):
        panic("semantic_snapshot_declaration_depths_storage_shared")
    if table.spanStartBytes.cap > 0 &&
       (table.spanStartBytes.buffer == nil ||
        system.memRefCount(table.spanStartBytes.buffer) != 1):
        panic("semantic_snapshot_declaration_span_starts_storage_shared")
    if table.spanEndBytes.cap > 0 &&
       (table.spanEndBytes.buffer == nil ||
        system.memRefCount(table.spanEndBytes.buffer) != 1):
        panic("semantic_snapshot_declaration_span_ends_storage_shared")
    rawbytes.BytesFree(table.canonicalBytes)
    seqs.chengSeqFreeTyped(table.declIds)
    seqs.freeSeqStrRelease(table.portableDocumentPackageIds)
    seqs.freeSeqStrRelease(table.portableDocumentModulePaths)
    seqs.chengSeqFreeTyped(table.portableDocumentIdentityCids)
    seqs.chengSeqFreeTyped(table.ownerDeclIds)
    seqs.chengSeqFreeTyped(table.declarationKinds)
    seqs.chengSeqFreeTyped(table.nameSurfaceKinds)
    seqs.freeSeqStrRelease(table.canonicalNames)
    seqs.chengSeqFreeTyped(table.parserValidatedNameProofCids)
    seqs.chengSeqFreeTyped(table.portableSignatureTypeExpressionCids)
    seqs.chengSeqFreeTyped(table.lexicalScopeCids)
    seqs.chengSeqFreeTyped(table.declKeyCids)
    seqs.chengSeqFreeTyped(table.ownerDepths)
    seqs.chengSeqFreeTyped(table.spanStartBytes)
    seqs.chengSeqFreeTyped(table.spanEndBytes)
    table.maxOwnerDepth = 0
    table.tableCid = layout.FixedBytes32()
    if !SemanticSnapshotDeclarationTableStorageReleased(table):
        panic("semantic_snapshot_declaration_physical_release_incomplete")

fn SemanticSnapshotDeclarationTableStorageReleased(
        table: var SemanticSnapshotDeclarationTable): bool =
    return rawbytes.BytesLen(table.canonicalBytes) == 0 &&
           table.declIds.len == 0 && table.declIds.cap == 0 &&
           table.portableDocumentPackageIds.len == 0 &&
           table.portableDocumentPackageIds.cap == 0 &&
           table.portableDocumentModulePaths.len == 0 &&
           table.portableDocumentModulePaths.cap == 0 &&
           table.portableDocumentIdentityCids.len == 0 &&
           table.portableDocumentIdentityCids.cap == 0 &&
           table.ownerDeclIds.len == 0 && table.ownerDeclIds.cap == 0 &&
           table.declarationKinds.len == 0 &&
           table.declarationKinds.cap == 0 &&
           table.nameSurfaceKinds.len == 0 &&
           table.nameSurfaceKinds.cap == 0 &&
           table.canonicalNames.len == 0 &&
           table.canonicalNames.cap == 0 &&
           table.parserValidatedNameProofCids.len == 0 &&
           table.parserValidatedNameProofCids.cap == 0 &&
           table.portableSignatureTypeExpressionCids.len == 0 &&
           table.portableSignatureTypeExpressionCids.cap == 0 &&
           table.lexicalScopeCids.len == 0 &&
           table.lexicalScopeCids.cap == 0 &&
           table.declKeyCids.len == 0 &&
           table.declKeyCids.cap == 0 &&
           table.ownerDepths.len == 0 &&
           table.ownerDepths.cap == 0 &&
           table.spanStartBytes.len == 0 &&
           table.spanStartBytes.cap == 0 &&
           table.spanEndBytes.len == 0 &&
           table.spanEndBytes.cap == 0 &&
           table.maxOwnerDepth == 0 &&
           layout.FixedBytes32Equal(
               table.tableCid, layout.FixedBytes32())

@borrows
fn SemanticSnapshotDeclarationTableClone(
        table: SemanticSnapshotDeclarationTable):
        SemanticSnapshotDeclarationTable =
    var out: SemanticSnapshotDeclarationTable
    for row in 0..<table.declIds.len:
        add(out.declIds, table.declIds[row])
        add(out.portableDocumentPackageIds,
            system.SystemToStringStr(
                table.portableDocumentPackageIds[row]))
        add(out.portableDocumentModulePaths,
            system.SystemToStringStr(
                table.portableDocumentModulePaths[row]))
        add(out.portableDocumentIdentityCids,
            layout.FixedBytes32Copy(
                table.portableDocumentIdentityCids[row]))
        add(out.ownerDeclIds, table.ownerDeclIds[row])
        add(out.declarationKinds, table.declarationKinds[row])
        add(out.nameSurfaceKinds, table.nameSurfaceKinds[row])
        add(out.canonicalNames,
            system.SystemToStringStr(table.canonicalNames[row]))
        add(out.parserValidatedNameProofCids,
            layout.FixedBytes32Copy(
                table.parserValidatedNameProofCids[row]))
        add(out.portableSignatureTypeExpressionCids,
            layout.FixedBytes32Copy(
                table.portableSignatureTypeExpressionCids[row]))
        add(out.lexicalScopeCids,
            layout.FixedBytes32Copy(table.lexicalScopeCids[row]))
        add(out.declKeyCids,
            layout.FixedBytes32Copy(table.declKeyCids[row]))
        add(out.ownerDepths, table.ownerDepths[row])
        add(out.spanStartBytes, table.spanStartBytes[row])
        add(out.spanEndBytes, table.spanEndBytes[row])
    out.maxOwnerDepth = table.maxOwnerDepth
    let canonicalBytes = rawbytes.BytesSlice(
        table.canonicalBytes, 0, rawbytes.BytesLen(table.canonicalBytes))
    out.canonicalBytes = canonicalBytes
    out.tableCid = layout.FixedBytes32Copy(table.tableCid)
    return out
