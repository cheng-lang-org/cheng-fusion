import cheng/core/backend/lowering_plan as lower
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_payload_lifecycle as payload
import cheng/core/tooling/lifetime_ledger as lifetime

type
    CompilerCsgProductionLifetime =
        lifecycle: payload.CompilerPayloadLifecycle
        receipt: payload.CompilerPayloadLifecycleReceipt
        receiptReady: bool
        active: bool

fn compilerCsgProductionLifetimeFail(message: str) =
    panic(message)

fn CompilerCsgProductionLifetimeControllerRetainedBufferCount(
        state: var CompilerCsgProductionLifetime): int32 =
    var count: int32
    if state.lifecycle.ledger.categoryNames.cap > 0:
        count = count + 1
    if state.lifecycle.ledger.ownerNames.cap > 0:
        count = count + 1
    if state.lifecycle.ledger.ownerClosed.cap > 0:
        count = count + 1
    if state.lifecycle.ledger.objects.cap > 0:
        count = count + 1
    if state.lifecycle.ledger.borrows.cap > 0:
        count = count + 1
    if state.lifecycle.ledger.categoryMetrics.cap > 0:
        count = count + 1
    return count

fn CompilerCsgProductionLifetimeControllerRetainedBytes(
        state: var CompilerCsgProductionLifetime): int64 =
    return int64(state.lifecycle.ledger.categoryNames.cap) *
               int64(sizeof(str)) +
           int64(state.lifecycle.ledger.ownerNames.cap) *
               int64(sizeof(str)) +
           int64(state.lifecycle.ledger.ownerClosed.cap) *
               int64(sizeof(bool)) +
           int64(state.lifecycle.ledger.objects.cap) *
               int64(sizeof(lifetime.LifetimeLedgerObject)) +
           int64(state.lifecycle.ledger.borrows.cap) *
               int64(sizeof(lifetime.LifetimeLedgerBorrow)) +
           int64(state.lifecycle.ledger.categoryMetrics.cap) *
               int64(sizeof(lifetime.LifetimeLedgerMetrics))

fn CompilerCsgProductionLifetimeBegin(
        csg: var ccsg.CompilerCsg,
        state: var CompilerCsgProductionLifetime) =
    if state.active || state.receiptReady:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: duplicate begin")
    payload.CompilerPayloadLifecycleBegin(
        state.lifecycle,
        payload.CompilerPayloadKindCompilerCsg,
        ccsg.CompilerCsgLifecycleRetainedBytes(csg),
        ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(csg))
    state.receiptReady = false
    state.active = true

fn CompilerCsgProductionLifetimeBorrowForLowering(
        csg: var ccsg.CompilerCsg,
        state: var CompilerCsgProductionLifetime) =
    if !state.active ||
       ccsg.CompilerCsgLifecycleRetainedBytes(csg) !=
           state.lifecycle.byteCount:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: lowering borrow drift")
    payload.CompilerPayloadLifecycleBorrowForConsumer(
        state.lifecycle)
    payload.CompilerPayloadLifecyclePrepareTerminal(
        state.lifecycle)

fn CompilerCsgProductionLifetimeReturnFromLowering(
        state: var CompilerCsgProductionLifetime) =
    if !state.active:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: lowering return without begin")
    payload.CompilerPayloadLifecycleReturnConsumerBorrow(
        state.lifecycle)

fn CompilerCsgProductionLifetimeCommitLoweringMove(
        csg: var ccsg.CompilerCsg,
        state: var CompilerCsgProductionLifetime) =
    if !state.active:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: move without begin")
    payload.CompilerPayloadLifecycleMoveToConsumer(
        state.lifecycle)
    if ccsg.CompilerCsgLifecycleRetainedBytes(csg) >
           state.lifecycle.byteCount ||
       ccsg.CompilerCsgLifecycleTrackedPhysicalBufferCount(csg) >
           state.lifecycle.physicalBufferCount:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: moved source grew")

fn CompilerCsgProductionLifetimeTransferInto(
        state: var CompilerCsgProductionLifetime,
        destination: var CompilerCsgProductionLifetime) =
    if !state.active || state.receiptReady ||
       destination.active || destination.receiptReady:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: invalid state transfer")
    destination = state
    state = CompilerCsgProductionLifetime()

fn CompilerCsgProductionLifetimeBorrowForObjectPlan(
        state: var CompilerCsgProductionLifetime) =
    if !state.active || !state.lifecycle.movedToConsumer:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: object borrow before move")
    payload.CompilerPayloadLifecycleBorrowForTerminalConsumer(
        state.lifecycle)

fn CompilerCsgProductionLifetimeReturnFromObjectPlan(
        state: var CompilerCsgProductionLifetime) =
    if !state.active:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: object return without begin")
    payload.CompilerPayloadLifecycleReturnTerminalConsumerBorrow(
        state.lifecycle)

fn compilerCsgProductionLifetimeFinish(
        csg: var ccsg.CompilerCsg,
        state: var CompilerCsgProductionLifetime,
        outcome: int32,
        loweringReleasedBufferCount: int32,
        loweringReleasedBytes: int64,
        transferredStorageReleased: bool) =
    if !state.active ||
       !payload.CompilerPayloadOutcomeValid(outcome) ||
       state.lifecycle.consumerBorrowActive ||
       state.lifecycle.terminalConsumerBorrowActive:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: invalid finish state")
    if !state.lifecycle.terminalPrepared:
        payload.CompilerPayloadLifecyclePrepareTerminal(
            state.lifecycle)
    var terminalReleasedBufferCount: int32
    var terminalReleasedBytes: int64
    ccsg.CompilerCsgTerminalReleaseWithReceipt(
        csg,
        terminalReleasedBufferCount,
        terminalReleasedBytes)
    if !ccsg.CompilerCsgLifecycleStorageReleased(csg) ||
       loweringReleasedBufferCount < 0 ||
       loweringReleasedBytes < int64(0) ||
       (state.lifecycle.movedToConsumer &&
        !transferredStorageReleased):
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: storage release incomplete")
    if terminalReleasedBufferCount < 0 ||
       terminalReleasedBufferCount >
           state.lifecycle.physicalBufferCount ||
       loweringReleasedBufferCount >
           state.lifecycle.physicalBufferCount -
               terminalReleasedBufferCount ||
       terminalReleasedBytes < int64(0) ||
       terminalReleasedBytes > state.lifecycle.byteCount ||
       loweringReleasedBytes >
           state.lifecycle.byteCount -
               terminalReleasedBytes:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: release partition invalid")
    var physicalRelease: payload.CompilerPayloadPhysicalReleaseReceipt
    physicalRelease.releasedBufferCount =
        terminalReleasedBufferCount +
        loweringReleasedBufferCount
    physicalRelease.releasedBytes =
        terminalReleasedBytes + loweringReleasedBytes
    physicalRelease.storageReleased =
        ccsg.CompilerCsgLifecycleStorageReleased(csg) &&
        transferredStorageReleased
    var receipt: payload.CompilerPayloadLifecycleReceipt
    payload.CompilerPayloadLifecycleEnd(
        state.lifecycle,
        outcome,
        physicalRelease,
        receipt)
    state.receipt = receipt
    state.receiptReady = true
    state.active = false

fn CompilerCsgProductionLifetimeEndUnmoved(
        csg: var ccsg.CompilerCsg,
        state: var CompilerCsgProductionLifetime,
        outcome: int32) =
    if state.lifecycle.movedToConsumer:
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: moved payload needs lowering receipt")
    compilerCsgProductionLifetimeFinish(
        csg, state, outcome, 0, int64(0), true)

fn CompilerCsgProductionLifetimeEndFromLowering(
        csg: var ccsg.CompilerCsg,
        loweringPlan: var lower.LoweringPlanStub,
        state: var CompilerCsgProductionLifetime,
        outcome: int32) =
    if !lower.LoweringPlanCompilerCsgReleaseReceiptComplete(
            loweringPlan):
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: lowering receipt incomplete")
    compilerCsgProductionLifetimeFinish(
        csg,
        state,
        outcome,
        lower.LoweringPlanCompilerCsgReleasedBufferCount(
            loweringPlan),
        lower.LoweringPlanCompilerCsgReleasedBytes(
            loweringPlan),
        lower.LoweringPlanCompilerCsgTransferredStorageReleased(
            loweringPlan))

@borrows
fn CompilerCsgProductionLifetimeReceiptClosed(
        receipt: payload.CompilerPayloadLifecycleReceipt): bool =
    return payload.CompilerPayloadLifecycleReceiptClosed(receipt)

fn CompilerCsgProductionLifetimeReceiptInto(
        state: var CompilerCsgProductionLifetime,
        receipt: var payload.CompilerPayloadLifecycleReceipt) =
    if state.active || !state.receiptReady ||
       !CompilerCsgProductionLifetimeReceiptClosed(
           state.receipt):
        compilerCsgProductionLifetimeFail(
            "compiler_csg_production_lifetime: receipt unavailable")
    receipt = state.receipt
