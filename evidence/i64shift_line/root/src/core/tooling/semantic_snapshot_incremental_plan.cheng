import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/rawbytes
import std/system
import cheng/core/lang/typed_expr_frag_codec as fragment_codec
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema
import cheng/core/csg_core/compiler_snapshot_cargo as snapshot_cargo
import cheng/core/tooling/semantic_snapshot as snapshot_core

const
    SemanticSnapshotIncrementalPartitionReusable: int32 = 1
    SemanticSnapshotIncrementalPartitionRebuildRequired: int32 = 2

    SemanticSnapshotIncrementalReasonNewFunction: int32 = 1
    SemanticSnapshotIncrementalReasonCompiler: int32 = 2
    SemanticSnapshotIncrementalReasonBodyContent: int32 = 4
    SemanticSnapshotIncrementalReasonInterface: int32 = 8
    SemanticSnapshotIncrementalReasonDependency: int32 = 16

    SemanticSnapshotIncrementalProducerFactResolvedCall: int32 = 1
    SemanticSnapshotIncrementalProducerFactSourceInterface: int32 = 2
    SemanticSnapshotIncrementalProducerFactSymbolInterface: int32 = 3
    SemanticSnapshotIncrementalProducerFactTypeIdentity: int32 = 4
    SemanticSnapshotIncrementalProducerFactLayout: int32 = 5

    # Open-addressed indexes use at most the next int32 power of two above
    # twice the row count. This bound prevents arithmetic/capacity overflow.
    SemanticSnapshotIncrementalMaxIndexedRows: int32 = 536870911

    SemanticSnapshotFunctionFragmentAdmissionUnknown: int32 = 0
    SemanticSnapshotFunctionFragmentAdmissionCacheHit: int32 = 1
    SemanticSnapshotFunctionFragmentAdmissionWholeRebuild: int32 = 2

type
    # Produced by the parser/type/dependency front end before a current CSG
    # snapshot exists. IDs are exact indexes in the current canonical pools.
    SemanticSnapshotIncrementalPrebuildInput =
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        frontEndReceiptCid: layout.FixedBytes32
        documentCids: layout.FixedBytes32[]
        sourceProducerIndexes: int32[]
        sourceTexts: str[]
        sourceInterfaceCids: layout.FixedBytes32[]
        symbolCids: layout.FixedBytes32[]
        symbolInterfaceCids: layout.FixedBytes32[]
        functionSymbolIds: int32[]
        functionSourceIds: int32[]
        bodyStartBytes: int32[]
        bodyEndBytes: int32[]
        functionInterfaceCids: layout.FixedBytes32[]

    # Source text is retained so every admission can recompute exact source
    # and body preimages. A caller cannot replace a CID and its receipt while
    # hiding different bytes.
    SemanticSnapshotIncrementalPrebuildFacts =
        workspaceSessionCid: layout.FixedBytes32
        sourceVersion: int64
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        frontEndReceiptCid: layout.FixedBytes32
        documentCids: layout.FixedBytes32[]
        sourceProducerIndexes: int32[]
        clientVersions: int64[]
        documentOpenStates: int32[]
        sourceLastEventVersions: int64[]
        sourceLastEventKinds: int32[]
        sourceTexts: str[]
        sourceContentCids: layout.FixedBytes32[]
        sourceInterfaceCids: layout.FixedBytes32[]
        symbolCids: layout.FixedBytes32[]
        symbolInterfaceCids: layout.FixedBytes32[]
        readTargetDomainKinds: int32[]
        readTargetPortableKeyCids: layout.FixedBytes32[]
        readTargetObservedValueCids: layout.FixedBytes32[]
        functionSymbolIds: int32[]
        functionSourceIds: int32[]
        bodyStartBytes: int32[]
        bodyEndBytes: int32[]
        bodyContentCids: layout.FixedBytes32[]
        functionInterfaceCids: layout.FixedBytes32[]
        factsCid: layout.FixedBytes32

    # Built before the current full CSG. Every current FunctionId is either
    # reusable from an exact previous Symbol CID row or must be rebuilt.
    SemanticSnapshotIncrementalPrebuildPlan =
        previousSourceVersion: int64
        sourceVersion: int64
        previousBindingReceiptCid: layout.FixedBytes32
        previousSemanticSnapshotCid: layout.FixedBytes32
        previousCsgRootCid: layout.FixedBytes32
        previousReadSetReverseIndexCid: layout.FixedBytes32
        workspaceSessionCid: layout.FixedBytes32
        worldHeadCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        frontEndReceiptCid: layout.FixedBytes32
        factsCid: layout.FixedBytes32
        symbolCount: int32
        previousFunctionCount: int32
        functionIds: int32[]
        previousFunctionIds: int32[]
        functionSymbolIds: int32[]
        partitionKinds: int32[]
        reasonMasks: int32[]
        bodyContentCids: layout.FixedBytes32[]
        interfaceCids: layout.FixedBytes32[]
        previousBodyContentCids: layout.FixedBytes32[]
        previousInterfaceCids: layout.FixedBytes32[]
        previousReadSetPreimageCids: layout.FixedBytes32[]
        previousFragmentCids: layout.FixedBytes32[]
        reuseProofCids: layout.FixedBytes32[]
        reusableFunctionIds: int32[]
        rebuildFunctionIds: int32[]
        planCid: layout.FixedBytes32
        receiptCid: layout.FixedBytes32

    # Postbuild read facts exist only for functions selected for rebuilding.
    # Every row is a portable semantic target tuple. Snapshot-local SymbolId,
    # source line and text-derived approximate identities are forbidden.
    SemanticSnapshotIncrementalRebuildReadInput =
        producerWorkspaceSessionCid: layout.FixedBytes32
        producerSourceVersion: int64
        producerFactsCid: layout.FixedBytes32
        producerPlanCid: layout.FixedBytes32
        producerFrontEndReceiptCid: layout.FixedBytes32
        producerFactsRootCid: layout.FixedBytes32
        expectedProducerFactCount: int32
        functionIds: int32[]
        readStarts: int32[]
        readCounts: int32[]
        factStarts: int32[]
        factCounts: int32[]
        expectedFunctionFactCounts: int32[]
        invocationReceiptCids: layout.FixedBytes32[]
        targetDomainKinds: int32[]
        targetPortableKeyCids: layout.FixedBytes32[]
        observedValueCids: layout.FixedBytes32[]
        producerFactFunctionIds: int32[]
        producerFactReadRowIds: int32[]
        producerFactKinds: int32[]
        producerSourceIds: int32[]
        producerCanonicalSourceIds: int32[]
        producerFactRowIds: int32[]
        producerOriginNodeIds: int32[]
        producerFactTraceCids: layout.FixedBytes32[]
        producerReceiptCid: layout.FixedBytes32

    # Published finalized reads retain only the producer receipt preimage.
    # Rebuilt target tuples already live in finalized.readSet; retaining them
    # here again would add 68 logical bytes per rebuilt read indefinitely.
    SemanticSnapshotIncrementalRebuildReadProducerReceipt =
        producerWorkspaceSessionCid: layout.FixedBytes32
        producerSourceVersion: int64
        producerFactsCid: layout.FixedBytes32
        producerPlanCid: layout.FixedBytes32
        producerFrontEndReceiptCid: layout.FixedBytes32
        producerFactsRootCid: layout.FixedBytes32
        expectedProducerFactCount: int32
        functionIds: int32[]
        readStarts: int32[]
        readCounts: int32[]
        factStarts: int32[]
        factCounts: int32[]
        expectedFunctionFactCounts: int32[]
        invocationReceiptCids: layout.FixedBytes32[]
        producerFactFunctionIds: int32[]
        producerFactReadRowIds: int32[]
        producerFactKinds: int32[]
        producerSourceIds: int32[]
        producerCanonicalSourceIds: int32[]
        producerFactRowIds: int32[]
        producerOriginNodeIds: int32[]
        producerFactTraceCids: layout.FixedBytes32[]
        producerReceiptCid: layout.FixedBytes32

    # The reverse CSR is derived exactly once from the finalized forward
    # read-set. Validation replays its canonical shape and hashes the retained
    # columns; it never sorts/builds the reverse index again.
    SemanticSnapshotIncrementalFinalizedReverseIndexOwner =
        valid: bool
        factsCid: layout.FixedBytes32
        planCid: layout.FixedBytes32
        forwardReadCount: int32
        reverseTargetCount: int32
        buildCount: int32
        reverseIndexCid: layout.FixedBytes32
        receiptCid: layout.FixedBytes32

    # Single immutable current read-set authority. Reusable rows are exact
    # previous rows remapped by SymbolCid; rebuilt rows are the only rows that
    # may come from the current read producer.
    SemanticSnapshotIncrementalFinalizedReadSet =
        # Initial construction is an explicit state of the one current
        # schema.  It has no predecessor root and every function is rebuilt.
        # Incremental updates must keep this false and bind a real previous
        # snapshot root.
        initialBuild: bool
        previousCsgRootCid: layout.FixedBytes32
        sourceVersion: int64
        factsCid: layout.FixedBytes32
        planCid: layout.FixedBytes32
        rebuildFunctionIds: int32[]
        rebuildReadProducer: SemanticSnapshotIncrementalRebuildReadProducerReceipt
        readStarts: int32[]
        readCounts: int32[]
        readSetPreimageCids: layout.FixedBytes32[]
        readSet: snapshot_schema.CsgCompilerReadSetTable
        reverseIndexOwner: SemanticSnapshotIncrementalFinalizedReverseIndexOwner
        receiptCid: layout.FixedBytes32

    # Persistent cache rows are canonical and sorted by keyCid.  Payload bytes
    # are whole-function fragments; there is no partial-fragment admission.
    SemanticSnapshotFunctionFragmentCache =
        functionSymbolCids: layout.FixedBytes32[]
        keyCids: layout.FixedBytes32[]
        fragmentCids: layout.FixedBytes32[]
        bodyContentCids: layout.FixedBytes32[]
        functionInterfaceCids: layout.FixedBytes32[]
        exactReadSetCids: layout.FixedBytes32[]
        schemaCids: layout.FixedBytes32[]
        compilerCids: layout.FixedBytes32[]
        targetCids: layout.FixedBytes32[]
        payloadByteLengths: int32[]
        payloads: str[]
        cacheCid: layout.FixedBytes32

    SemanticSnapshotFunctionFragmentAdmission =
        functionId: int32 = -1
        kind: int32
        cacheRowId: int32 = -1
        decodedRowId: int32 = -1
        keyCid: layout.FixedBytes32
        fragmentCid: layout.FixedBytes32

    # One candidate-local, independently replayable cache-admission proof.
    # Exact read rows are transient and never copied into the registry.
    SemanticSnapshotFunctionFragmentAdmissionInput =
        sourceVersion: int64
        factsCid: layout.FixedBytes32
        finalizedReadSetReceiptCid: layout.FixedBytes32
        functionId: int32 = -1
        functionSymbolCid: layout.FixedBytes32
        bodyContentCid: layout.FixedBytes32
        functionInterfaceCid: layout.FixedBytes32
        exactReadSetCid: layout.FixedBytes32
        receiptCid: layout.FixedBytes32

    # One workspace session owns the validated persistent cache and every
    # decoded immutable fragment. Candidate registries retain only exact row
    # indexes into this owner, so repeated candidates cannot decode the same
    # FragmentCid twice.
    SemanticSnapshotWorkspaceFunctionFragmentOwner =
        valid: bool
        workspaceSessionCid: layout.FixedBytes32
        ownerCid: layout.FixedBytes32
        schemaCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        targetCid: layout.FixedBytes32
        cache: SemanticSnapshotFunctionFragmentCache
        validatedCacheCid: layout.FixedBytes32
        validationCount: int32
        decodeCount: int32
        decodedFragmentCids: layout.FixedBytes32[]
        decodedCacheRowIds: int32[]
        decodedFragments: fragment_codec.TypedExprIrFunctionFragment[]
        decodedCanonicalPayloads: str[]
        decodedIndexSlots: int32[]

    # One candidate owns one monotonic function frontier. Cache-hit decoded
    # row IDs always name the workspace owner above; fragments are never
    # copied into the candidate.
    SemanticSnapshotDecodedFunctionFragmentRegistry =
        valid: bool
        candidateCid: layout.FixedBytes32
        workspaceOwnerCid: layout.FixedBytes32
        sourceVersion: int64
        factsCid: layout.FixedBytes32
        finalizedReadSetReceiptCid: layout.FixedBytes32
        schemaCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        targetCid: layout.FixedBytes32
        cacheCid: layout.FixedBytes32
        functionCount: int32
        nextFunctionId: int32
        visitCount: int32
        lowerCount: int32
        decodeCount: int32
        reuseCount: int32
        cacheHitCount: int32
        rebuildCount: int32
        functionSymbolCids: layout.FixedBytes32[]
        functionKeyCids: layout.FixedBytes32[]
        admissionKinds: int32[]
        cacheRowIds: int32[]
        decodedRowIds: int32[]
        lowerCounts: int32[]
        rebuiltFragmentCids: layout.FixedBytes32[]
        rebuiltFragments: fragment_codec.TypedExprIrFunctionFragment[]
        rebuiltCanonicalPayloads: str[]
        decodedFragmentCids: layout.FixedBytes32[]
        decodedIndexSlots: int32[]

    SemanticSnapshotFunctionFragmentCandidateReceipt =
        valid: bool
        candidateCid: layout.FixedBytes32
        workspaceOwnerCid: layout.FixedBytes32
        sourceVersion: int64
        factsCid: layout.FixedBytes32
        finalizedReadSetReceiptCid: layout.FixedBytes32
        cacheCid: layout.FixedBytes32
        schemaCid: layout.FixedBytes32
        compilerCid: layout.FixedBytes32
        targetCid: layout.FixedBytes32
        functionCount: int32
        visitCount: int32
        lowerCount: int32
        cacheHitCount: int32
        rebuildCount: int32
        decodeCount: int32
        reuseCount: int32
        uniqueDecodedFragmentCount: int32
        receiptCid: layout.FixedBytes32

fn incrementalAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn incrementalAppendI64(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn incrementalAppendText(buf: var layout.ByteBuf, value: str) =
    incrementalAppendU32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn incrementalAppendCid(buf: var layout.ByteBuf,
                        value: layout.FixedBytes32) =
    layout.ByteBufAppendFixed32(buf, value)

@borrows
fn incrementalCidObserved(value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn incrementalCidLess(left: layout.FixedBytes32,
                      right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] < right.data[index]:
            return true
        if left.data[index] > right.data[index]:
            return false
    return false

@borrows
fn incrementalCurrentFindSymbol(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        symbolCid: layout.FixedBytes32): int32 =
    var low: int32
    var high = current.symbolCids.len
    while low < high:
        let middle = low + (high - low) / 2
        if incrementalCidLess(current.symbolCids[middle], symbolCid):
            low = middle + 1
        else:
            high = middle
    if low < current.symbolCids.len &&
       layout.FixedBytes32Equal(current.symbolCids[low], symbolCid):
        return low
    return -1

@borrows
fn incrementalReadTargetLess(domainLeft: int32,
                             keyLeft: layout.FixedBytes32,
                             domainRight: int32,
                             keyRight: layout.FixedBytes32): bool =
    if domainLeft != domainRight:
        return domainLeft < domainRight
    return incrementalCidLess(keyLeft, keyRight)

@borrows
fn incrementalCurrentFindReadTarget(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        domainKind: int32,
        portableKeyCid: layout.FixedBytes32): int32 =
    var low: int32
    var high = current.readTargetDomainKinds.len
    while low < high:
        let middle = low + (high - low) / 2
        if incrementalReadTargetLess(
               current.readTargetDomainKinds[middle],
               current.readTargetPortableKeyCids[middle],
               domainKind, portableKeyCid):
            low = middle + 1
        else:
            high = middle
    if low < current.readTargetDomainKinds.len &&
       current.readTargetDomainKinds[low] == domainKind &&
       layout.FixedBytes32Equal(
           current.readTargetPortableKeyCids[low], portableKeyCid):
        return low
    return -1

@borrows
fn incrementalCanonicalSourceOrderInto(
        documentCids: layout.FixedBytes32[],
        orderOut: var int32[],
        oldToCanonicalOut: var int32[],
        err: var str): bool =
    orderOut = []
    oldToCanonicalOut = []
    for sourceId in 0..<documentCids.len:
        if !incrementalCidObserved(documentCids[sourceId]):
            err = " semantic snapshot incremental prebuild: invalid document identity"
            return false
        add(orderOut, sourceId)
        add(oldToCanonicalOut, -1)
    # Stable LSD radix sort keeps source canonicalization O(32*n), avoiding
    # quadratic candidate cost when didOpen order differs from CID order.
    var byteIndex: int32 = layout.FixedBytes32Size - 1
    while byteIndex >= 0:
        var counts: int32[]
        var offsets: int32[]
        setLen(counts, 256)
        setLen(offsets, 256)
        for index in 0..<orderOut.len:
            let bucket = Int32(
                documentCids[orderOut[index]].data[byteIndex])
            counts[bucket] = counts[bucket] + 1
        var cursor: int32
        for bucket in 0..<256:
            offsets[bucket] = cursor
            cursor = cursor + counts[bucket]
        var sorted: int32[]
        setLen(sorted, orderOut.len)
        for index in 0..<orderOut.len:
            let sourceId = orderOut[index]
            let bucket = Int32(documentCids[sourceId].data[byteIndex])
            sorted[offsets[bucket]] = sourceId
            offsets[bucket] = offsets[bucket] + 1
        orderOut = sorted
        byteIndex = byteIndex - 1
    for canonicalSourceId in 0..<orderOut.len:
        let oldSourceId = orderOut[canonicalSourceId]
        if canonicalSourceId > 0 &&
           layout.FixedBytes32Equal(
               documentCids[orderOut[canonicalSourceId - 1]],
               documentCids[oldSourceId]):
            err = " semantic snapshot incremental prebuild: duplicate document identity"
            return false
        oldToCanonicalOut[oldSourceId] = canonicalSourceId
    return true

@borrows
fn incrementalPreviousFindFunction(
        previous: snapshot_schema.CsgCompilerSnapshotTables,
        symbolCid: layout.FixedBytes32): int32 =
    var low: int32
    var high = previous.functions.symbolIds.len
    while low < high:
        let middle = low + (high - low) / 2
        let symbolId = previous.functions.symbolIds[middle]
        if incrementalCidLess(previous.symbols.symbolCids[symbolId],
                              symbolCid):
            low = middle + 1
        else:
            high = middle
    if low < previous.functions.symbolIds.len:
        let symbolId = previous.functions.symbolIds[low]
        if layout.FixedBytes32Equal(previous.symbols.symbolCids[symbolId],
                                    symbolCid):
            return low
    return -1

@borrows
fn incrementalCurrentFindFunctionBySymbolId(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        symbolId: int32): int32 =
    var low: int32
    var high = current.functionSymbolIds.len
    while low < high:
        let middle = low + (high - low) / 2
        if current.functionSymbolIds[middle] < symbolId:
            low = middle + 1
        else:
            high = middle
    if low < current.functionSymbolIds.len &&
       current.functionSymbolIds[low] == symbolId:
        return low
    return -1

@borrows
fn incrementalPrebuildFactsCid(
        facts: SemanticSnapshotIncrementalPrebuildFacts):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(1024)
    incrementalAppendText(buf, "cheng.semantic_snapshot.incremental.prebuild_facts")
    incrementalAppendCid(buf, facts.workspaceSessionCid)
    incrementalAppendI64(buf, facts.sourceVersion)
    incrementalAppendCid(buf, facts.worldHeadCid)
    incrementalAppendCid(buf, facts.compilerCid)
    incrementalAppendCid(buf, facts.sourceBundleCid)
    incrementalAppendCid(buf, facts.frontEndReceiptCid)
    incrementalAppendU32(buf, facts.documentCids.len)
    for sourceId in 0..<facts.documentCids.len:
        incrementalAppendCid(buf, facts.documentCids[sourceId])
        incrementalAppendU32(buf, facts.sourceProducerIndexes[sourceId])
        incrementalAppendI64(buf, facts.clientVersions[sourceId])
        incrementalAppendU32(buf, facts.documentOpenStates[sourceId])
        incrementalAppendI64(buf, facts.sourceLastEventVersions[sourceId])
        incrementalAppendU32(buf, facts.sourceLastEventKinds[sourceId])
        incrementalAppendCid(buf, facts.sourceContentCids[sourceId])
        incrementalAppendCid(buf, facts.sourceInterfaceCids[sourceId])
    incrementalAppendU32(buf, facts.symbolCids.len)
    for symbolId in 0..<facts.symbolCids.len:
        incrementalAppendCid(buf, facts.symbolCids[symbolId])
        incrementalAppendCid(buf, facts.symbolInterfaceCids[symbolId])
    incrementalAppendU32(buf, facts.readTargetDomainKinds.len)
    for targetId in 0..<facts.readTargetDomainKinds.len:
        incrementalAppendU32(buf, facts.readTargetDomainKinds[targetId])
        incrementalAppendCid(buf, facts.readTargetPortableKeyCids[targetId])
        incrementalAppendCid(buf, facts.readTargetObservedValueCids[targetId])
    incrementalAppendU32(buf, facts.functionSymbolIds.len)
    for functionId in 0..<facts.functionSymbolIds.len:
        incrementalAppendU32(buf, facts.functionSymbolIds[functionId])
        incrementalAppendU32(buf, facts.functionSourceIds[functionId])
        incrementalAppendU32(buf, facts.bodyStartBytes[functionId])
        incrementalAppendU32(buf, facts.bodyEndBytes[functionId])
        incrementalAppendCid(buf, facts.bodyContentCids[functionId])
        incrementalAppendCid(buf, facts.functionInterfaceCids[functionId])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
        facts: SemanticSnapshotIncrementalPrebuildFacts,
        err: var str): bool =
    err = ""
    let sourceCount = facts.documentCids.len
    let symbolCount = facts.symbolCids.len
    let functionCount = facts.functionSymbolIds.len
    let readTargetCount = facts.readTargetDomainKinds.len
    if facts.sourceVersion <= 0 || sourceCount <= 0 ||
       !incrementalCidObserved(facts.workspaceSessionCid) ||
       !incrementalCidObserved(facts.worldHeadCid) ||
       !incrementalCidObserved(facts.compilerCid) ||
       !incrementalCidObserved(facts.sourceBundleCid) ||
       !incrementalCidObserved(facts.frontEndReceiptCid) ||
       sourceCount != facts.sourceProducerIndexes.len ||
       sourceCount != facts.clientVersions.len ||
       sourceCount != facts.documentOpenStates.len ||
       sourceCount != facts.sourceLastEventVersions.len ||
       sourceCount != facts.sourceLastEventKinds.len ||
       sourceCount != facts.sourceTexts.len ||
       sourceCount != facts.sourceContentCids.len ||
       sourceCount != facts.sourceInterfaceCids.len ||
       symbolCount != facts.symbolInterfaceCids.len ||
       readTargetCount != facts.readTargetPortableKeyCids.len ||
       readTargetCount != facts.readTargetObservedValueCids.len ||
       functionCount != facts.functionSourceIds.len ||
       functionCount != facts.bodyStartBytes.len ||
       functionCount != facts.bodyEndBytes.len ||
       functionCount != facts.bodyContentCids.len ||
       functionCount != facts.functionInterfaceCids.len ||
       !incrementalCidObserved(facts.factsCid):
        err = " semantic snapshot incremental prebuild: invalid facts shape"
        return false
    var producerSeen: bool[]
    setLen(producerSeen, sourceCount)
    for sourceId in 0..<sourceCount:
        let producerSourceId = facts.sourceProducerIndexes[sourceId]
        if !incrementalCidObserved(facts.documentCids[sourceId]) ||
           producerSourceId < 0 || producerSourceId >= sourceCount ||
           producerSeen[producerSourceId] ||
           facts.clientVersions[sourceId] < 0 ||
           (facts.documentOpenStates[sourceId] != 0 &&
            facts.documentOpenStates[sourceId] != 1) ||
           facts.sourceLastEventVersions[sourceId] < 0 ||
           facts.sourceLastEventVersions[sourceId] > facts.sourceVersion ||
           (facts.sourceLastEventKinds[sourceId] !=
                snapshot_core.SemanticSourceEventOpen &&
            facts.sourceLastEventKinds[sourceId] !=
                snapshot_core.SemanticSourceEventChange &&
            facts.sourceLastEventKinds[sourceId] !=
                snapshot_core.SemanticSourceEventClose &&
            facts.sourceLastEventKinds[sourceId] !=
                snapshot_core.SemanticSourceEventAdd &&
            facts.sourceLastEventKinds[sourceId] !=
                snapshot_core.SemanticSourceEventRename) ||
           (facts.sourceLastEventVersions[sourceId] == 0 &&
            facts.sourceLastEventKinds[sourceId] !=
                snapshot_core.SemanticSourceEventAdd) ||
           ((facts.sourceLastEventKinds[sourceId] ==
                 snapshot_core.SemanticSourceEventOpen ||
             facts.sourceLastEventKinds[sourceId] ==
                 snapshot_core.SemanticSourceEventChange) &&
            facts.documentOpenStates[sourceId] != 1) ||
           ((facts.sourceLastEventKinds[sourceId] ==
                 snapshot_core.SemanticSourceEventClose ||
             facts.sourceLastEventKinds[sourceId] ==
                 snapshot_core.SemanticSourceEventAdd) &&
            facts.documentOpenStates[sourceId] != 0) ||
           !layout.FixedBytes32Equal(
               snapshot_schema.CsgCompilerSourceContentCid(
                   facts.sourceTexts[sourceId]),
               facts.sourceContentCids[sourceId]) ||
           !incrementalCidObserved(facts.sourceInterfaceCids[sourceId]) ||
           (sourceId > 0 &&
            !incrementalCidLess(facts.documentCids[sourceId - 1],
                                facts.documentCids[sourceId])):
            err = " semantic snapshot incremental prebuild: invalid source row"
            return false
        producerSeen[producerSourceId] = true
    for symbolId in 0..<symbolCount:
        if !incrementalCidObserved(facts.symbolCids[symbolId]) ||
           !incrementalCidObserved(facts.symbolInterfaceCids[symbolId]) ||
           (symbolId > 0 &&
            !incrementalCidLess(facts.symbolCids[symbolId - 1],
                                facts.symbolCids[symbolId])):
            err = " semantic snapshot incremental prebuild: invalid symbol row"
            return false
    if readTargetCount != sourceCount + symbolCount:
        err = " semantic snapshot incremental prebuild: incomplete read target authority"
        return false
    for targetId in 0..<readTargetCount:
        let domainKind = facts.readTargetDomainKinds[targetId]
        let keyCid = facts.readTargetPortableKeyCids[targetId]
        let valueCid = facts.readTargetObservedValueCids[targetId]
        if !incrementalCidObserved(keyCid) || !incrementalCidObserved(valueCid) ||
           (targetId > 0 && !incrementalReadTargetLess(
               facts.readTargetDomainKinds[targetId - 1],
               facts.readTargetPortableKeyCids[targetId - 1],
               domainKind, keyCid)):
            err = " semantic snapshot incremental prebuild: invalid read target authority"
            return false
        if domainKind == snapshot_schema.CsgCompilerReadDomainSourceInterface:
            if targetId >= sourceCount ||
               !layout.FixedBytes32Equal(keyCid, facts.documentCids[targetId]) ||
               !layout.FixedBytes32Equal(
                   valueCid, facts.sourceInterfaceCids[targetId]):
                err = " semantic snapshot incremental prebuild: source read target mismatch"
                return false
        elif domainKind == snapshot_schema.CsgCompilerReadDomainSymbolInterface:
            let symbolId = targetId - sourceCount
            if symbolId < 0 || symbolId >= symbolCount ||
               !layout.FixedBytes32Equal(keyCid, facts.symbolCids[symbolId]) ||
               !layout.FixedBytes32Equal(
                   valueCid, facts.symbolInterfaceCids[symbolId]):
                err = " semantic snapshot incremental prebuild: symbol read target mismatch"
                return false
        else:
            err = " semantic snapshot incremental prebuild: unproved read target domain"
            return false
    for functionId in 0..<functionCount:
        let symbolId = facts.functionSymbolIds[functionId]
        let sourceId = facts.functionSourceIds[functionId]
        if symbolId < 0 || symbolId >= symbolCount ||
           sourceId < 0 || sourceId >= sourceCount ||
           (functionId > 0 && symbolId <=
               facts.functionSymbolIds[functionId - 1]) ||
           !layout.FixedBytes32Equal(
               facts.functionInterfaceCids[functionId],
               facts.symbolInterfaceCids[symbolId]):
            err = " semantic snapshot incremental prebuild: invalid function row"
            return false
        var expectedBodyCid: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerFunctionBodyContentCidInto(
                facts.documentCids[sourceId], facts.sourceTexts[sourceId],
                facts.bodyStartBytes[functionId],
                facts.bodyEndBytes[functionId], expectedBodyCid, err) ||
           !layout.FixedBytes32Equal(expectedBodyCid,
                                     facts.bodyContentCids[functionId]):
            if err == "":
                err = " semantic snapshot incremental prebuild: body CID mismatch"
            return false
    if !layout.FixedBytes32Equal(incrementalPrebuildFactsCid(facts),
                                 facts.factsCid):
        err = " semantic snapshot incremental prebuild: facts receipt mismatch"
        return false
    return true

@borrows
fn SemanticSnapshotIncrementalPrebuildFactsMakeInto(
        eventState: snapshot_core.WorkspaceSourceEventState,
        input: SemanticSnapshotIncrementalPrebuildInput,
        out: var SemanticSnapshotIncrementalPrebuildFacts,
        err: var str): bool =
    err = ""
    if eventState.lastAcceptedSourceVersion <= 0 ||
       eventState.nextSourceVersion !=
           eventState.lastAcceptedSourceVersion + int64(1) ||
       !incrementalCidObserved(eventState.workspaceSessionCid) ||
       input.documentCids.len != input.sourceProducerIndexes.len ||
       input.documentCids.len != input.sourceTexts.len ||
       input.documentCids.len != input.sourceInterfaceCids.len ||
       input.symbolCids.len != input.symbolInterfaceCids.len ||
       input.functionSymbolIds.len != input.functionSourceIds.len ||
       input.functionSymbolIds.len != input.bodyStartBytes.len ||
       input.functionSymbolIds.len != input.bodyEndBytes.len ||
       input.functionSymbolIds.len != input.functionInterfaceCids.len:
        err = " semantic snapshot incremental prebuild: event/input mismatch"
        return false
    var activeStableRows: int32[]
    if !snapshot_core.WorkspaceSourceEventActiveSourceRowsInto(
            eventState, activeStableRows, err):
        return false
    if input.documentCids.len != activeStableRows.len:
        err = " semantic snapshot incremental prebuild: active source count split"
        return false
    var facts: SemanticSnapshotIncrementalPrebuildFacts
    facts.workspaceSessionCid = eventState.workspaceSessionCid
    facts.sourceVersion = eventState.lastAcceptedSourceVersion
    facts.worldHeadCid = input.worldHeadCid
    facts.compilerCid = input.compilerCid
    facts.sourceBundleCid = input.sourceBundleCid
    facts.frontEndReceiptCid = input.frontEndReceiptCid
    var sourceOrder: int32[]
    var sourceOldToCanonical: int32[]
    if !incrementalCanonicalSourceOrderInto(
            input.documentCids, sourceOrder,
            sourceOldToCanonical, err):
        return false
    for canonicalSourceId in 0..<sourceOrder.len:
        let sourceId = sourceOrder[canonicalSourceId]
        let stableRow = activeStableRows[sourceId]
        if !layout.FixedBytes32Equal(input.documentCids[sourceId],
                                     eventState.documentCids[stableRow]):
            err = " semantic snapshot incremental prebuild: document event mismatch"
            return false
        add(facts.documentCids,
            layout.FixedBytes32Copy(input.documentCids[sourceId]))
        add(facts.sourceProducerIndexes,
            input.sourceProducerIndexes[sourceId])
        add(facts.clientVersions, eventState.clientVersions[stableRow])
        add(facts.documentOpenStates,
            eventState.documentOpenStates[stableRow])
        add(facts.sourceLastEventVersions,
            eventState.documentLastEventSourceVersions[stableRow])
        add(facts.sourceLastEventKinds,
            eventState.documentLastEventKinds[stableRow])
        # W2 源文本 share 化（wall101）：facts 借 RC 与 input/canonical 池共享
        # 同一文本缓冲，Validation 逐行重哈希得到逐字节相同的 CID；禁止回退
        # SystemToStringStr 深拷贝（三拷贝峰值 +87MB 根因）。
        add(facts.sourceTexts, share(input.sourceTexts[sourceId]))
        let sourceContentCid = snapshot_schema.CsgCompilerSourceContentCid(
            input.sourceTexts[sourceId])
        add(facts.sourceContentCids, sourceContentCid)
        add(facts.sourceInterfaceCids,
            layout.FixedBytes32Copy(input.sourceInterfaceCids[sourceId]))
    for symbolId in 0..<input.symbolCids.len:
        add(facts.symbolCids,
            layout.FixedBytes32Copy(input.symbolCids[symbolId]))
    for symbolId in 0..<input.symbolInterfaceCids.len:
        add(facts.symbolInterfaceCids,
            layout.FixedBytes32Copy(input.symbolInterfaceCids[symbolId]))
    for sourceId in 0..<facts.documentCids.len:
        add(facts.readTargetDomainKinds,
            snapshot_schema.CsgCompilerReadDomainSourceInterface)
        add(facts.readTargetPortableKeyCids,
            layout.FixedBytes32Copy(facts.documentCids[sourceId]))
        add(facts.readTargetObservedValueCids,
            layout.FixedBytes32Copy(facts.sourceInterfaceCids[sourceId]))
    for symbolId in 0..<facts.symbolCids.len:
        add(facts.readTargetDomainKinds,
            snapshot_schema.CsgCompilerReadDomainSymbolInterface)
        add(facts.readTargetPortableKeyCids,
            layout.FixedBytes32Copy(facts.symbolCids[symbolId]))
        add(facts.readTargetObservedValueCids,
            layout.FixedBytes32Copy(facts.symbolInterfaceCids[symbolId]))
    for functionId in 0..<input.functionSymbolIds.len:
        add(facts.functionSymbolIds,
            input.functionSymbolIds[functionId])
        let inputSourceId = input.functionSourceIds[functionId]
        if inputSourceId < 0 || inputSourceId >= sourceOldToCanonical.len ||
           sourceOldToCanonical[inputSourceId] < 0:
            err = " semantic snapshot incremental prebuild: invalid function source"
            return false
        add(facts.functionSourceIds,
            sourceOldToCanonical[inputSourceId])
        add(facts.bodyStartBytes, input.bodyStartBytes[functionId])
        add(facts.bodyEndBytes, input.bodyEndBytes[functionId])
        add(facts.functionInterfaceCids,
            layout.FixedBytes32Copy(
                input.functionInterfaceCids[functionId]))
        var bodyCid: layout.FixedBytes32
        let sourceId = inputSourceId
        if sourceId < 0 || sourceId >= input.documentCids.len ||
           !snapshot_schema.CsgCompilerFunctionBodyContentCidInto(
               input.documentCids[sourceId], input.sourceTexts[sourceId],
               input.bodyStartBytes[functionId],
               input.bodyEndBytes[functionId], bodyCid, err):
            if err == "":
                err = " semantic snapshot incremental prebuild: invalid body source"
            return false
        add(facts.bodyContentCids, bodyCid)
    let factsCid = incrementalPrebuildFactsCid(facts)
    facts.factsCid = factsCid
    if !SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
            facts, err):
        return false
    out = facts
    return true

@borrows
fn incrementalPreviousSnapshotValidateInto(
        previous: snapshot_schema.CsgCompilerSnapshotTables,
        identity: snapshot_core.PortableSemanticSnapshotIdentity,
        binding: snapshot_core.LocalSourceVersionBinding,
        validation: snapshot_core.SemanticSnapshotValidationReceipt,
        err: var str): bool =
    if !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
            previous, err) ||
       !snapshot_core.SemanticSnapshotValidationReceiptStrictValidateInto(
            validation, binding, identity, err):
        return false
    var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(previous)
    let valid = cargo.ok &&
        layout.FixedBytes32Equal(cargo.factsRootCid, identity.csgRootCid)
    if !valid:
        err = " semantic snapshot incremental prebuild: previous root mismatch"
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
    return valid

@borrows
fn incrementalReuseProofCid(
        plan: SemanticSnapshotIncrementalPrebuildPlan,
        functionId: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    incrementalAppendText(buf, "cheng.semantic_snapshot.incremental.reuse_proof")
    incrementalAppendCid(buf, plan.previousCsgRootCid)
    incrementalAppendCid(buf, plan.factsCid)
    incrementalAppendU32(buf, functionId)
    incrementalAppendU32(buf, plan.previousFunctionIds[functionId])
    incrementalAppendU32(buf, plan.functionSymbolIds[functionId])
    incrementalAppendCid(buf, plan.bodyContentCids[functionId])
    incrementalAppendCid(buf, plan.interfaceCids[functionId])
    incrementalAppendCid(buf, plan.previousBodyContentCids[functionId])
    incrementalAppendCid(buf, plan.previousInterfaceCids[functionId])
    incrementalAppendCid(buf,
                         plan.previousReadSetPreimageCids[functionId])
    incrementalAppendCid(buf, plan.previousFragmentCids[functionId])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalPrebuildPlanCid(
        plan: SemanticSnapshotIncrementalPrebuildPlan):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(1024)
    incrementalAppendText(buf, "cheng.semantic_snapshot.incremental.prebuild_plan")
    incrementalAppendI64(buf, plan.previousSourceVersion)
    incrementalAppendI64(buf, plan.sourceVersion)
    incrementalAppendCid(buf, plan.previousBindingReceiptCid)
    incrementalAppendCid(buf, plan.previousSemanticSnapshotCid)
    incrementalAppendCid(buf, plan.previousCsgRootCid)
    incrementalAppendCid(buf, plan.previousReadSetReverseIndexCid)
    incrementalAppendCid(buf, plan.workspaceSessionCid)
    incrementalAppendCid(buf, plan.worldHeadCid)
    incrementalAppendCid(buf, plan.compilerCid)
    incrementalAppendCid(buf, plan.sourceBundleCid)
    incrementalAppendCid(buf, plan.frontEndReceiptCid)
    incrementalAppendCid(buf, plan.factsCid)
    incrementalAppendU32(buf, plan.symbolCount)
    incrementalAppendU32(buf, plan.previousFunctionCount)
    incrementalAppendU32(buf, plan.functionIds.len)
    for functionId in 0..<plan.functionIds.len:
        incrementalAppendU32(buf, plan.functionIds[functionId])
        incrementalAppendU32(buf, plan.previousFunctionIds[functionId])
        incrementalAppendU32(buf, plan.functionSymbolIds[functionId])
        incrementalAppendU32(buf, plan.partitionKinds[functionId])
        incrementalAppendU32(buf, plan.reasonMasks[functionId])
        incrementalAppendCid(buf, plan.bodyContentCids[functionId])
        incrementalAppendCid(buf, plan.interfaceCids[functionId])
        incrementalAppendCid(buf, plan.previousBodyContentCids[functionId])
        incrementalAppendCid(buf, plan.previousInterfaceCids[functionId])
        incrementalAppendCid(
            buf, plan.previousReadSetPreimageCids[functionId])
        incrementalAppendCid(buf, plan.previousFragmentCids[functionId])
        incrementalAppendCid(buf, plan.reuseProofCids[functionId])
    incrementalAppendU32(buf, plan.reusableFunctionIds.len)
    for index in 0..<plan.reusableFunctionIds.len:
        incrementalAppendU32(buf, plan.reusableFunctionIds[index])
    incrementalAppendU32(buf, plan.rebuildFunctionIds.len)
    for index in 0..<plan.rebuildFunctionIds.len:
        incrementalAppendU32(buf, plan.rebuildFunctionIds[index])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalPrebuildReceiptCid(
        plan: SemanticSnapshotIncrementalPrebuildPlan):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(320)
    incrementalAppendText(buf, "cheng.semantic_snapshot.incremental.prebuild_receipt")
    incrementalAppendCid(buf, plan.previousBindingReceiptCid)
    incrementalAppendCid(buf, plan.previousSemanticSnapshotCid)
    incrementalAppendCid(buf, plan.previousCsgRootCid)
    incrementalAppendCid(buf, plan.factsCid)
    incrementalAppendCid(buf, plan.planCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn SemanticSnapshotIncrementalPrebuildPlanStrictValidateInto(
        plan: SemanticSnapshotIncrementalPrebuildPlan,
        err: var str): bool =
    err = ""
    let count = plan.functionIds.len
    let initialBuild = plan.previousSourceVersion == 0
    if plan.previousSourceVersion < 0 ||
       plan.previousSourceVersion == int64(9223372036854775807) ||
       plan.sourceVersion <= plan.previousSourceVersion ||
       plan.symbolCount < 0 || plan.previousFunctionCount < 0 ||
       count != plan.previousFunctionIds.len ||
       count != plan.functionSymbolIds.len ||
       count != plan.partitionKinds.len ||
       count != plan.reasonMasks.len ||
       count != plan.bodyContentCids.len ||
       count != plan.interfaceCids.len ||
       count != plan.previousBodyContentCids.len ||
       count != plan.previousInterfaceCids.len ||
       count != plan.previousReadSetPreimageCids.len ||
       count != plan.previousFragmentCids.len ||
       count != plan.reuseProofCids.len ||
       plan.reusableFunctionIds.len + plan.rebuildFunctionIds.len != count ||
       (initialBuild &&
        (plan.previousFunctionCount != 0 ||
         incrementalCidObserved(plan.previousBindingReceiptCid) ||
         incrementalCidObserved(plan.previousSemanticSnapshotCid) ||
         incrementalCidObserved(plan.previousCsgRootCid) ||
         incrementalCidObserved(plan.previousReadSetReverseIndexCid) ||
         plan.reusableFunctionIds.len != 0)) ||
       (!initialBuild &&
        (!incrementalCidObserved(plan.previousBindingReceiptCid) ||
         !incrementalCidObserved(plan.previousSemanticSnapshotCid) ||
         !incrementalCidObserved(plan.previousCsgRootCid) ||
         !incrementalCidObserved(
             plan.previousReadSetReverseIndexCid))) ||
       !incrementalCidObserved(plan.workspaceSessionCid) ||
       !incrementalCidObserved(plan.worldHeadCid) ||
       !incrementalCidObserved(plan.compilerCid) ||
       !incrementalCidObserved(plan.sourceBundleCid) ||
       !incrementalCidObserved(plan.frontEndReceiptCid) ||
       !incrementalCidObserved(plan.factsCid) ||
       !incrementalCidObserved(plan.planCid) ||
       !incrementalCidObserved(plan.receiptCid):
        err = " semantic snapshot incremental prebuild: invalid plan shape"
        return false
    var reuseCursor: int32
    var rebuildCursor: int32
    for functionId in 0..<count:
        if plan.functionIds[functionId] != functionId ||
           plan.previousFunctionIds[functionId] < -1 ||
           plan.previousFunctionIds[functionId] >=
               plan.previousFunctionCount ||
           plan.functionSymbolIds[functionId] < 0 ||
           plan.functionSymbolIds[functionId] >= plan.symbolCount ||
           (functionId > 0 && plan.functionSymbolIds[functionId] <=
               plan.functionSymbolIds[functionId - 1]) ||
           !incrementalCidObserved(plan.bodyContentCids[functionId]) ||
           !incrementalCidObserved(plan.interfaceCids[functionId]):
            err = " semantic snapshot incremental prebuild: invalid plan row"
            return false
        if initialBuild &&
           (plan.previousFunctionIds[functionId] != -1 ||
            plan.partitionKinds[functionId] !=
                SemanticSnapshotIncrementalPartitionRebuildRequired ||
            plan.reasonMasks[functionId] !=
                SemanticSnapshotIncrementalReasonNewFunction ||
            incrementalCidObserved(
                plan.previousBodyContentCids[functionId]) ||
            incrementalCidObserved(
                plan.previousInterfaceCids[functionId]) ||
            incrementalCidObserved(
                plan.previousReadSetPreimageCids[functionId]) ||
            incrementalCidObserved(
                plan.previousFragmentCids[functionId])):
            err = " semantic snapshot incremental prebuild: initial plan claimed previous authority"
            return false
        if plan.partitionKinds[functionId] ==
               SemanticSnapshotIncrementalPartitionReusable:
            if plan.reasonMasks[functionId] != 0 ||
               plan.previousFunctionIds[functionId] < 0 ||
               reuseCursor >= plan.reusableFunctionIds.len ||
               plan.reusableFunctionIds[reuseCursor] != functionId ||
               !layout.FixedBytes32Equal(
                   plan.bodyContentCids[functionId],
                   plan.previousBodyContentCids[functionId]) ||
               !layout.FixedBytes32Equal(
                   plan.interfaceCids[functionId],
                   plan.previousInterfaceCids[functionId]) ||
               !incrementalCidObserved(
                   plan.previousFragmentCids[functionId]) ||
               !layout.FixedBytes32Equal(
                   incrementalReuseProofCid(plan, functionId),
                   plan.reuseProofCids[functionId]):
                err = " semantic snapshot incremental prebuild: invalid reuse proof"
                return false
            reuseCursor = reuseCursor + 1
        elif plan.partitionKinds[functionId] ==
                 SemanticSnapshotIncrementalPartitionRebuildRequired:
            if plan.reasonMasks[functionId] <= 0 ||
               rebuildCursor >= plan.rebuildFunctionIds.len ||
               plan.rebuildFunctionIds[rebuildCursor] != functionId ||
               !layout.FixedBytes32Equal(plan.reuseProofCids[functionId],
                                         layout.FixedBytes32()):
                err = " semantic snapshot incremental prebuild: invalid rebuild row"
                return false
            rebuildCursor = rebuildCursor + 1
        else:
            err = " semantic snapshot incremental prebuild: unknown partition"
            return false
    if reuseCursor != plan.reusableFunctionIds.len ||
       rebuildCursor != plan.rebuildFunctionIds.len ||
       !layout.FixedBytes32Equal(incrementalPrebuildPlanCid(plan),
                                 plan.planCid) ||
       !layout.FixedBytes32Equal(incrementalPrebuildReceiptCid(plan),
                                 plan.receiptCid):
        err = " semantic snapshot incremental prebuild: plan receipt mismatch"
        return false
    return true

# First publication has no previous snapshot to validate or reuse.  This is
# the strict initial state of the single plan schema, not a parallel schema:
# previousSourceVersion=0, every previous proof is zero, and every current
# function is rebuilt exactly once.
fn SemanticSnapshotIncrementalInitialPrebuildPlanBuildInto(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        out: var SemanticSnapshotIncrementalPrebuildPlan,
        err: var str): bool =
    let emptyPlan = SemanticSnapshotIncrementalPrebuildPlan()
    out = emptyPlan
    if !SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
            current, err):
        return false
    var plan: SemanticSnapshotIncrementalPrebuildPlan
    plan.previousSourceVersion = 0
    plan.sourceVersion = current.sourceVersion
    plan.workspaceSessionCid = current.workspaceSessionCid
    plan.worldHeadCid = current.worldHeadCid
    plan.compilerCid = current.compilerCid
    plan.sourceBundleCid = current.sourceBundleCid
    plan.frontEndReceiptCid = current.frontEndReceiptCid
    plan.factsCid = current.factsCid
    plan.symbolCount = current.symbolCids.len
    plan.previousFunctionCount = 0
    for functionId in 0..<current.functionSymbolIds.len:
        add(plan.functionIds, functionId)
        add(plan.previousFunctionIds, -1)
        add(plan.functionSymbolIds,
            current.functionSymbolIds[functionId])
        add(plan.partitionKinds,
            SemanticSnapshotIncrementalPartitionRebuildRequired)
        add(plan.reasonMasks,
            SemanticSnapshotIncrementalReasonNewFunction)
        add(plan.bodyContentCids,
            current.bodyContentCids[functionId])
        add(plan.interfaceCids,
            current.functionInterfaceCids[functionId])
        let emptyPreviousBodyContentCid = layout.FixedBytes32()
        add(plan.previousBodyContentCids, emptyPreviousBodyContentCid)
        let emptyPreviousInterfaceCid = layout.FixedBytes32()
        add(plan.previousInterfaceCids, emptyPreviousInterfaceCid)
        let emptyPreviousReadSetPreimageCid = layout.FixedBytes32()
        add(plan.previousReadSetPreimageCids,
            emptyPreviousReadSetPreimageCid)
        let emptyPreviousFragmentCid = layout.FixedBytes32()
        add(plan.previousFragmentCids, emptyPreviousFragmentCid)
        let emptyReuseProofCid = layout.FixedBytes32()
        add(plan.reuseProofCids, emptyReuseProofCid)
        add(plan.rebuildFunctionIds, functionId)
    let planCid = incrementalPrebuildPlanCid(plan)
    plan.planCid = planCid
    let receiptCid = incrementalPrebuildReceiptCid(plan)
    plan.receiptCid = receiptCid
    if !SemanticSnapshotIncrementalPrebuildPlanStrictValidateInto(
            plan, err):
        return false
    out = plan
    err = ""
    return true

fn SemanticSnapshotIncrementalPrebuildPlanBuildInto(
        previous: var snapshot_schema.CsgCompilerSnapshotTables,
        previousIdentity: snapshot_core.PortableSemanticSnapshotIdentity,
        previousBinding: snapshot_core.LocalSourceVersionBinding,
        previousValidation: snapshot_core.SemanticSnapshotValidationReceipt,
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        out: var SemanticSnapshotIncrementalPrebuildPlan,
        err: var str): bool =
    err = ""
    if !incrementalPreviousSnapshotValidateInto(
            previous, previousIdentity, previousBinding,
            previousValidation, err) ||
       !SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
            current, err):
        return false
    if previousBinding.sourceVersion <= 0 ||
       previousBinding.sourceVersion == int64(9223372036854775807) ||
       current.sourceVersion <= previousBinding.sourceVersion ||
       !layout.FixedBytes32Equal(previousBinding.workspaceSessionCid,
                                 current.workspaceSessionCid):
        err = " semantic snapshot incremental prebuild: version/session mismatch"
        return false
    var plan: SemanticSnapshotIncrementalPrebuildPlan
    plan.previousSourceVersion = previousBinding.sourceVersion
    plan.sourceVersion = current.sourceVersion
    plan.previousBindingReceiptCid = previousBinding.bindingReceiptCid
    plan.previousSemanticSnapshotCid = previousIdentity.semanticSnapshotCid
    plan.previousCsgRootCid = previousIdentity.csgRootCid
    plan.previousReadSetReverseIndexCid =
        previous.readSet.reverseIndexCid
    plan.workspaceSessionCid = current.workspaceSessionCid
    plan.worldHeadCid = current.worldHeadCid
    plan.compilerCid = current.compilerCid
    plan.sourceBundleCid = current.sourceBundleCid
    plan.frontEndReceiptCid = current.frontEndReceiptCid
    plan.factsCid = current.factsCid
    plan.symbolCount = current.symbolCids.len
    plan.previousFunctionCount = previous.functions.symbolIds.len
    let compilerChanged = !layout.FixedBytes32Equal(
        previousIdentity.compilerCid, current.compilerCid)
    # Build the exact invalid reader frontier from the previous snapshot's
    # canonical target->reader CSR. Removed targets are changed facts too.
    # This is O(previous portable targets + true dependents), never a whole
    # graph reachability rescan.
    var dependencyInvalid: bool[]
    setLen(dependencyInvalid, current.functionSymbolIds.len)
    for previousTargetId in 0..<
            previous.readSet.reverseTargetDomainKinds.len:
        let domainKind =
            previous.readSet.reverseTargetDomainKinds[previousTargetId]
        let portableKeyCid =
            previous.readSet.reverseTargetPortableKeyCids[previousTargetId]
        let currentTargetId = incrementalCurrentFindReadTarget(
            current, domainKind, portableKeyCid)
        let reverseStart = previous.readSet.reverseStarts[previousTargetId]
        let reverseCount = previous.readSet.reverseCounts[previousTargetId]
        if reverseCount <= 0:
            err = " semantic snapshot incremental prebuild: empty reverse target"
            return false
        let previousObserved =
            previous.readSet.reverseObservedValueCids[reverseStart]
        let targetChanged = currentTargetId < 0 ||
            !layout.FixedBytes32Equal(
                previousObserved,
                current.readTargetObservedValueCids[currentTargetId])
        if !targetChanged:
            continue
        for offset in 0..<reverseCount:
            let reverseRow = reverseStart + offset
            let previousReaderFunctionId =
                previous.readSet.reverseReaderFunctionIds[reverseRow]
            let previousReaderSymbolId =
                previous.functions.symbolIds[previousReaderFunctionId]
            let currentReaderSymbolId = incrementalCurrentFindSymbol(
                current,
                previous.symbols.symbolCids[previousReaderSymbolId])
            if currentReaderSymbolId >= 0:
                let currentReaderFunctionId =
                    incrementalCurrentFindFunctionBySymbolId(
                        current, currentReaderSymbolId)
                if currentReaderFunctionId >= 0:
                    dependencyInvalid[currentReaderFunctionId] = true
    for functionId in 0..<current.functionSymbolIds.len:
        let symbolId = current.functionSymbolIds[functionId]
        let symbolCid = current.symbolCids[symbolId]
        let previousFunctionId = incrementalPreviousFindFunction(
            previous, symbolCid)
        add(plan.functionIds, functionId)
        add(plan.previousFunctionIds, previousFunctionId)
        add(plan.functionSymbolIds, symbolId)
        add(plan.bodyContentCids, current.bodyContentCids[functionId])
        add(plan.interfaceCids,
            current.functionInterfaceCids[functionId])
        var previousBody: layout.FixedBytes32
        var previousInterface: layout.FixedBytes32
        var previousReadSet: layout.FixedBytes32
        var previousFragment: layout.FixedBytes32
        var reason: int32
        if previousFunctionId < 0:
            reason = reason | SemanticSnapshotIncrementalReasonNewFunction
        else:
            previousBody =
                previous.functions.bodyContentCids[previousFunctionId]
            previousInterface =
                previous.functions.interfaceCids[previousFunctionId]
            previousReadSet =
                previous.functions.readSetPreimageCids[previousFunctionId]
            previousFragment =
                previous.functions.fragmentCids[previousFunctionId]
            if !layout.FixedBytes32Equal(
                    previousBody, current.bodyContentCids[functionId]):
                reason = reason |
                    SemanticSnapshotIncrementalReasonBodyContent
            if !layout.FixedBytes32Equal(
                    previousInterface,
                    current.functionInterfaceCids[functionId]):
                reason = reason |
                    SemanticSnapshotIncrementalReasonInterface
        if compilerChanged:
            reason = reason | SemanticSnapshotIncrementalReasonCompiler
        if dependencyInvalid[functionId]:
            reason = reason | SemanticSnapshotIncrementalReasonDependency
        add(plan.previousBodyContentCids, previousBody)
        add(plan.previousInterfaceCids, previousInterface)
        add(plan.previousReadSetPreimageCids, previousReadSet)
        add(plan.previousFragmentCids, previousFragment)
        add(plan.reasonMasks, reason)
        if reason == 0:
            add(plan.partitionKinds,
                SemanticSnapshotIncrementalPartitionReusable)
            add(plan.reuseProofCids,
                incrementalReuseProofCid(plan, functionId))
            add(plan.reusableFunctionIds, functionId)
        else:
            add(plan.partitionKinds,
                SemanticSnapshotIncrementalPartitionRebuildRequired)
            add(plan.reuseProofCids, layout.FixedBytes32())
            add(plan.rebuildFunctionIds, functionId)
    plan.planCid = incrementalPrebuildPlanCid(plan)
    plan.receiptCid = incrementalPrebuildReceiptCid(plan)
    if !SemanticSnapshotIncrementalPrebuildPlanStrictValidateInto(plan, err):
        return false
    out = plan
    return true

fn incrementalRebuildReadProducerColumnsAligned(
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput): bool =
    let functionCount = rebuilt.functionIds.len
    let readCount = rebuilt.targetDomainKinds.len
    let factCount = rebuilt.producerFactRowIds.len
    return functionCount == rebuilt.readStarts.len &&
        functionCount == rebuilt.readCounts.len &&
        functionCount == rebuilt.factStarts.len &&
        functionCount == rebuilt.factCounts.len &&
        functionCount == rebuilt.expectedFunctionFactCounts.len &&
        functionCount == rebuilt.invocationReceiptCids.len &&
        readCount == rebuilt.targetPortableKeyCids.len &&
        readCount == rebuilt.observedValueCids.len &&
        factCount == rebuilt.producerFactFunctionIds.len &&
        factCount == rebuilt.producerFactReadRowIds.len &&
        factCount == rebuilt.producerFactKinds.len &&
        factCount == rebuilt.producerSourceIds.len &&
        factCount == rebuilt.producerCanonicalSourceIds.len &&
        factCount == rebuilt.producerOriginNodeIds.len &&
        factCount == rebuilt.producerFactTraceCids.len

fn incrementalRebuildReadProducerFactDomain(
        factKind: int32): int32 =
    if factKind == SemanticSnapshotIncrementalProducerFactResolvedCall ||
       factKind == SemanticSnapshotIncrementalProducerFactSymbolInterface:
        return snapshot_schema.CsgCompilerReadDomainSymbolInterface
    if factKind == SemanticSnapshotIncrementalProducerFactSourceInterface:
        return snapshot_schema.CsgCompilerReadDomainSourceInterface
    if factKind == SemanticSnapshotIncrementalProducerFactTypeIdentity:
        return snapshot_schema.CsgCompilerReadDomainTypeIdentity
    if factKind == SemanticSnapshotIncrementalProducerFactLayout:
        return snapshot_schema.CsgCompilerReadDomainLayout
    return -1

fn incrementalRebuildReadProducerFactLess(
        leftKind: int32,
        leftRowId: int32,
        leftReadRowId: int32,
        rightKind: int32,
        rightRowId: int32,
        rightReadRowId: int32): bool =
    if leftKind != rightKind:
        return leftKind < rightKind
    if leftRowId != rightRowId:
        return leftRowId < rightRowId
    return leftReadRowId < rightReadRowId

fn incrementalRebuildReadProducerBindingValid(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput): bool =
    return incrementalRebuildReadProducerColumnsAligned(rebuilt) &&
        rebuilt.producerSourceVersion == current.sourceVersion &&
        layout.FixedBytes32Equal(
            rebuilt.producerWorkspaceSessionCid,
            current.workspaceSessionCid) &&
        layout.FixedBytes32Equal(
            rebuilt.producerFactsCid, current.factsCid) &&
        layout.FixedBytes32Equal(
            rebuilt.producerPlanCid, plan.planCid) &&
        layout.FixedBytes32Equal(
            rebuilt.producerFrontEndReceiptCid,
            current.frontEndReceiptCid) &&
        incrementalCidObserved(rebuilt.producerFactsRootCid) &&
        rebuilt.expectedProducerFactCount >= 0 &&
        rebuilt.expectedProducerFactCount <=
            SemanticSnapshotIncrementalMaxIndexedRows

@borrows
fn incrementalRebuildReadFactTraceCid(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        rebuilt: SemanticSnapshotIncrementalRebuildReadInput,
        factIndex: int32): layout.FixedBytes32 =
    let functionId = rebuilt.producerFactFunctionIds[factIndex]
    let readRow = rebuilt.producerFactReadRowIds[factIndex]
    var buf = layout.ByteBufInit(448)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.incremental.compiler_fact_read_trace")
    incrementalAppendCid(buf, rebuilt.producerWorkspaceSessionCid)
    incrementalAppendI64(buf, rebuilt.producerSourceVersion)
    incrementalAppendCid(buf, rebuilt.producerFactsCid)
    incrementalAppendCid(buf, rebuilt.producerPlanCid)
    incrementalAppendCid(buf, rebuilt.producerFrontEndReceiptCid)
    incrementalAppendCid(buf, rebuilt.producerFactsRootCid)
    incrementalAppendU32(buf, functionId)
    incrementalAppendCid(
        buf, current.symbolCids[current.functionSymbolIds[functionId]])
    incrementalAppendCid(buf, current.bodyContentCids[functionId])
    incrementalAppendU32(buf, rebuilt.producerFactKinds[factIndex])
    incrementalAppendU32(buf, rebuilt.producerSourceIds[factIndex])
    incrementalAppendU32(
        buf, rebuilt.producerCanonicalSourceIds[factIndex])
    incrementalAppendCid(
        buf, current.documentCids[
            rebuilt.producerCanonicalSourceIds[factIndex]])
    incrementalAppendU32(buf, rebuilt.producerFactRowIds[factIndex])
    incrementalAppendU32(buf, rebuilt.producerOriginNodeIds[factIndex])
    incrementalAppendU32(buf, readRow)
    incrementalAppendU32(buf, rebuilt.targetDomainKinds[readRow])
    incrementalAppendCid(buf, rebuilt.targetPortableKeyCids[readRow])
    incrementalAppendCid(buf, rebuilt.observedValueCids[readRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalRebuildReadInvocationReceiptCid(
        rebuilt: SemanticSnapshotIncrementalRebuildReadInput,
        invocationIndex: int32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.incremental.read_producer_invocation")
    incrementalAppendCid(buf, rebuilt.producerWorkspaceSessionCid)
    incrementalAppendI64(buf, rebuilt.producerSourceVersion)
    incrementalAppendCid(buf, rebuilt.producerFactsCid)
    incrementalAppendCid(buf, rebuilt.producerPlanCid)
    incrementalAppendCid(buf, rebuilt.producerFrontEndReceiptCid)
    incrementalAppendCid(buf, rebuilt.producerFactsRootCid)
    incrementalAppendU32(buf, rebuilt.functionIds[invocationIndex])
    incrementalAppendU32(
        buf, rebuilt.expectedFunctionFactCounts[invocationIndex])
    let readStart = rebuilt.readStarts[invocationIndex]
    let readCount = rebuilt.readCounts[invocationIndex]
    incrementalAppendU32(buf, readCount)
    for offset in 0..<readCount:
        let row = readStart + offset
        incrementalAppendU32(buf, rebuilt.targetDomainKinds[row])
        incrementalAppendCid(buf, rebuilt.targetPortableKeyCids[row])
        incrementalAppendCid(buf, rebuilt.observedValueCids[row])
    let factStart = rebuilt.factStarts[invocationIndex]
    let factCount = rebuilt.factCounts[invocationIndex]
    incrementalAppendU32(buf, factCount)
    for offset in 0..<factCount:
        let row = factStart + offset
        incrementalAppendCid(buf, rebuilt.producerFactTraceCids[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalRebuildReadProducerReceiptCid(
        rebuilt: SemanticSnapshotIncrementalRebuildReadInput):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        384 + rebuilt.invocationReceiptCids.len * 36)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.incremental.read_producer_receipt")
    incrementalAppendCid(buf, rebuilt.producerWorkspaceSessionCid)
    incrementalAppendI64(buf, rebuilt.producerSourceVersion)
    incrementalAppendCid(buf, rebuilt.producerFactsCid)
    incrementalAppendCid(buf, rebuilt.producerPlanCid)
    incrementalAppendCid(buf, rebuilt.producerFrontEndReceiptCid)
    incrementalAppendCid(buf, rebuilt.producerFactsRootCid)
    incrementalAppendU32(buf, rebuilt.expectedProducerFactCount)
    incrementalAppendU32(buf, rebuilt.invocationReceiptCids.len)
    for index in 0..<rebuilt.invocationReceiptCids.len:
        incrementalAppendU32(buf, rebuilt.functionIds[index])
        incrementalAppendCid(buf, rebuilt.invocationReceiptCids[index])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn incrementalRebuildReadProducerReceiptFromInput(
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput):
        SemanticSnapshotIncrementalRebuildReadProducerReceipt =
    var out: SemanticSnapshotIncrementalRebuildReadProducerReceipt
    out.producerWorkspaceSessionCid = rebuilt.producerWorkspaceSessionCid
    out.producerSourceVersion = rebuilt.producerSourceVersion
    out.producerFactsCid = rebuilt.producerFactsCid
    out.producerPlanCid = rebuilt.producerPlanCid
    out.producerFrontEndReceiptCid = rebuilt.producerFrontEndReceiptCid
    out.producerFactsRootCid = rebuilt.producerFactsRootCid
    out.expectedProducerFactCount = rebuilt.expectedProducerFactCount
    out.functionIds = rebuilt.functionIds
    out.readStarts = rebuilt.readStarts
    out.readCounts = rebuilt.readCounts
    out.factStarts = rebuilt.factStarts
    out.factCounts = rebuilt.factCounts
    out.expectedFunctionFactCounts = rebuilt.expectedFunctionFactCounts
    out.invocationReceiptCids = rebuilt.invocationReceiptCids
    out.producerFactFunctionIds = rebuilt.producerFactFunctionIds
    # Compact receipts store function-local read offsets. They must not retain
    # producer-global or finalized-global row IDs because reusable rows can be
    # interleaved when the finalized forward table is assembled.
    for invocationIndex in 0..<rebuilt.functionIds.len:
        let readStart = rebuilt.readStarts[invocationIndex]
        let factStart = rebuilt.factStarts[invocationIndex]
        let factCount = rebuilt.factCounts[invocationIndex]
        for offset in 0..<factCount:
            add(out.producerFactReadRowIds,
                rebuilt.producerFactReadRowIds[factStart + offset] -
                    readStart)
    out.producerFactKinds = rebuilt.producerFactKinds
    out.producerSourceIds = rebuilt.producerSourceIds
    out.producerCanonicalSourceIds = rebuilt.producerCanonicalSourceIds
    out.producerFactRowIds = rebuilt.producerFactRowIds
    out.producerOriginNodeIds = rebuilt.producerOriginNodeIds
    out.producerFactTraceCids = rebuilt.producerFactTraceCids
    out.producerReceiptCid = rebuilt.producerReceiptCid
    return out

fn SemanticSnapshotIncrementalRebuildReadProducerRetainedLogicalBytes(
        finalized: SemanticSnapshotIncrementalFinalizedReadSet): int64 =
    let receipt = finalized.rebuildReadProducer
    # Five input roots + sealed receipt root + sourceVersion + expected count.
    let scalarBytes = int64(6 * layout.FixedBytes32Size + 8 + 4)
    # Six int32 invocation columns plus one invocation CID.
    let invocationBytes = int64(receipt.functionIds.len) *
        int64(6 * 4 + layout.FixedBytes32Size)
    # Seven int32 fact columns plus one fact-trace CID.
    let factBytes = int64(receipt.producerFactRowIds.len) *
        int64(7 * 4 + layout.FixedBytes32Size)
    return scalarBytes + invocationBytes + factBytes

fn SemanticSnapshotIncrementalRebuildReadProducerValidationScratchLogicalBytes(
        finalized: SemanticSnapshotIncrementalFinalizedReadSet): int64 =
    var rebuiltReadCount: int64
    for index in 0..<finalized.rebuildReadProducer.readCounts.len:
        rebuiltReadCount = rebuiltReadCount +
            int64(finalized.rebuildReadProducer.readCounts[index])
    # Validation reconstructs domain:int32 + key CID + observed CID once.
    return rebuiltReadCount *
        int64(4 + layout.FixedBytes32Size * 2)

@borrows
fn incrementalRebuildReadProducerInputFromFinalizedInto(
        finalized: SemanticSnapshotIncrementalFinalizedReadSet,
        out: var SemanticSnapshotIncrementalRebuildReadInput,
        err: var str): bool =
    out = SemanticSnapshotIncrementalRebuildReadInput()
    let receipt = finalized.rebuildReadProducer
    let functionCount = receipt.functionIds.len
    if functionCount != receipt.readStarts.len ||
       functionCount != receipt.readCounts.len ||
       functionCount != finalized.rebuildFunctionIds.len:
        err = " semantic snapshot incremental read producer: compact receipt shape drift"
        return false
    var rebuilt: SemanticSnapshotIncrementalRebuildReadInput
    rebuilt.producerWorkspaceSessionCid =
        receipt.producerWorkspaceSessionCid
    rebuilt.producerSourceVersion = receipt.producerSourceVersion
    rebuilt.producerFactsCid = receipt.producerFactsCid
    rebuilt.producerPlanCid = receipt.producerPlanCid
    rebuilt.producerFrontEndReceiptCid =
        receipt.producerFrontEndReceiptCid
    rebuilt.producerFactsRootCid = receipt.producerFactsRootCid
    rebuilt.expectedProducerFactCount = receipt.expectedProducerFactCount
    rebuilt.functionIds = share(receipt.functionIds)
    rebuilt.readStarts = share(receipt.readStarts)
    rebuilt.readCounts = share(receipt.readCounts)
    rebuilt.factStarts = share(receipt.factStarts)
    rebuilt.factCounts = share(receipt.factCounts)
    rebuilt.expectedFunctionFactCounts =
        share(receipt.expectedFunctionFactCounts)
    rebuilt.invocationReceiptCids = share(receipt.invocationReceiptCids)
    rebuilt.producerFactFunctionIds = share(receipt.producerFactFunctionIds)
    rebuilt.producerFactKinds = share(receipt.producerFactKinds)
    rebuilt.producerSourceIds = share(receipt.producerSourceIds)
    rebuilt.producerCanonicalSourceIds =
        share(receipt.producerCanonicalSourceIds)
    rebuilt.producerFactRowIds = share(receipt.producerFactRowIds)
    rebuilt.producerOriginNodeIds = share(receipt.producerOriginNodeIds)
    rebuilt.producerFactTraceCids = share(receipt.producerFactTraceCids)
    rebuilt.producerReceiptCid = receipt.producerReceiptCid
    var rebuiltReadCursor: int32
    for invocationIndex in 0..<functionCount:
        let functionId = receipt.functionIds[invocationIndex]
        let count = receipt.readCounts[invocationIndex]
        if functionId != finalized.rebuildFunctionIds[invocationIndex] ||
           functionId < 0 || functionId >= finalized.readStarts.len ||
           functionId >= finalized.readCounts.len || count < 0 ||
           receipt.readStarts[invocationIndex] != rebuiltReadCursor ||
           invocationIndex >= receipt.factStarts.len ||
           invocationIndex >= receipt.factCounts.len ||
           finalized.readCounts[functionId] != count:
            err = " semantic snapshot incremental read producer: compact receipt function drift"
            return false
        let start = finalized.readStarts[functionId]
        if start < 0 || start > finalized.readSet.targetDomainKinds.len ||
           count > finalized.readSet.targetDomainKinds.len - start:
            err = " semantic snapshot incremental read producer: compact receipt range drift"
            return false
        for offset in 0..<count:
            let row = start + offset
            add(rebuilt.targetDomainKinds,
                finalized.readSet.targetDomainKinds[row])
            add(rebuilt.targetPortableKeyCids,
                finalized.readSet.targetPortableKeyCids[row])
            add(rebuilt.observedValueCids,
                finalized.readSet.observedValueCids[row])
        let factStart = receipt.factStarts[invocationIndex]
        let factCount = receipt.factCounts[invocationIndex]
        if factStart != rebuilt.producerFactReadRowIds.len ||
           factCount < 0 ||
           factStart > receipt.producerFactReadRowIds.len ||
           factCount > receipt.producerFactReadRowIds.len - factStart:
            err = " semantic snapshot incremental read producer: compact fact range drift"
            return false
        for offset in 0..<factCount:
            let localReadOffset =
                receipt.producerFactReadRowIds[factStart + offset]
            if localReadOffset < 0 || localReadOffset >= count:
                err = " semantic snapshot incremental read producer: compact fact read offset drift"
                return false
            add(rebuilt.producerFactReadRowIds,
                rebuiltReadCursor + localReadOffset)
        rebuiltReadCursor = rebuiltReadCursor + count
    out = rebuilt
    err = ""
    return true

fn incrementalRebuildReadProducerFactIdentityUnique(
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        err: var str): bool =
    let count = rebuilt.producerFactRowIds.len
    if count < 0 || count > SemanticSnapshotIncrementalMaxIndexedRows:
        err = " semantic snapshot incremental read producer: compiler fact index overflow"
        return false
    var capacity: int32 = 1
    while capacity < count * 2 + 1:
        capacity = capacity * 2
    var factSlots: int32[]
    setLen(factSlots, capacity)
    for slot in 0..<capacity:
        factSlots[slot] = -1
    for factIndex in 0..<count:
        let factHash = UInt64(rebuilt.producerFactKinds[factIndex]) *
                UInt64(1099511628211) +
            UInt64(rebuilt.producerSourceIds[factIndex]) * UInt64(65537) +
            UInt64(rebuilt.producerFactRowIds[factIndex])
        let factStart = Int32(factHash % UInt64(capacity))
        var factInserted = false
        for probe in 0..<capacity:
            let slot = (factStart + probe) % capacity
            let previous = factSlots[slot]
            if previous < 0:
                factSlots[slot] = factIndex
                factInserted = true
                break
            if rebuilt.producerFactKinds[previous] ==
                   rebuilt.producerFactKinds[factIndex] &&
               rebuilt.producerSourceIds[previous] ==
                   rebuilt.producerSourceIds[factIndex] &&
               rebuilt.producerFactRowIds[previous] ==
                   rebuilt.producerFactRowIds[factIndex]:
                err = " semantic snapshot incremental read producer: duplicate compiler fact"
                return false
        if !factInserted:
            err = " semantic snapshot incremental read producer: compiler fact index full"
            return false
    return true

@borrows
fn incrementalRebuildReadProducerCurrentStrictValidateInto(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        expectedPlanCid: layout.FixedBytes32,
        expectedRebuildFunctionIds: int32[],
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        expectedProducerReceiptCid: layout.FixedBytes32,
        err: var str): bool =
    if !SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(
            current, err) ||
       !incrementalRebuildReadProducerColumnsAligned(rebuilt) ||
       rebuilt.producerSourceVersion != current.sourceVersion ||
       !layout.FixedBytes32Equal(
           rebuilt.producerWorkspaceSessionCid,
           current.workspaceSessionCid) ||
       !layout.FixedBytes32Equal(
           rebuilt.producerFactsCid, current.factsCid) ||
       !layout.FixedBytes32Equal(
           rebuilt.producerPlanCid, expectedPlanCid) ||
       !layout.FixedBytes32Equal(
           rebuilt.producerFrontEndReceiptCid,
           current.frontEndReceiptCid) ||
       !incrementalCidObserved(rebuilt.producerFactsRootCid) ||
       rebuilt.expectedProducerFactCount < 0 ||
       rebuilt.expectedProducerFactCount >
           SemanticSnapshotIncrementalMaxIndexedRows ||
       rebuilt.expectedProducerFactCount !=
           rebuilt.producerFactRowIds.len ||
       rebuilt.functionIds.len != expectedRebuildFunctionIds.len ||
       !incrementalCidObserved(expectedProducerReceiptCid):
        err = " semantic snapshot incremental read producer: invalid sealed shape"
        return false
    var readCursor: int32
    var factCursor: int32
    for invocationIndex in 0..<rebuilt.functionIds.len:
        let functionId = rebuilt.functionIds[invocationIndex]
        if functionId != expectedRebuildFunctionIds[invocationIndex] ||
           functionId < 0 ||
           functionId >= current.functionSymbolIds.len ||
           rebuilt.readStarts[invocationIndex] != readCursor ||
           rebuilt.readCounts[invocationIndex] < 0 ||
           rebuilt.factStarts[invocationIndex] != factCursor ||
           rebuilt.factCounts[invocationIndex] < 0 ||
           rebuilt.factCounts[invocationIndex] !=
               rebuilt.expectedFunctionFactCounts[invocationIndex] ||
           rebuilt.readCounts[invocationIndex] >
               rebuilt.targetDomainKinds.len - readCursor ||
           rebuilt.factCounts[invocationIndex] >
               rebuilt.producerFactRowIds.len - factCursor:
            err = " semantic snapshot incremental read producer: invocation coverage drift"
            return false
        let readCount = rebuilt.readCounts[invocationIndex]
        let factCount = rebuilt.factCounts[invocationIndex]
        var readObserved: bool[]
        setLen(readObserved, readCount)
        for offset in 0..<readCount:
            let readRow = readCursor + offset
            let domainKind = rebuilt.targetDomainKinds[readRow]
            let targetId = incrementalCurrentFindReadTarget(
                current, domainKind,
                rebuilt.targetPortableKeyCids[readRow])
            if targetId < 0 ||
               !layout.FixedBytes32Equal(
                   rebuilt.observedValueCids[readRow],
                   current.readTargetObservedValueCids[targetId]):
                err = " semantic snapshot incremental read producer: target authority drift"
                return false
            if offset > 0 &&
               !incrementalReadTargetLess(
                   rebuilt.targetDomainKinds[readRow - 1],
                   rebuilt.targetPortableKeyCids[readRow - 1],
                   domainKind,
                   rebuilt.targetPortableKeyCids[readRow]):
                err = " semantic snapshot incremental read producer: read rows out of order"
                return false
        for offset in 0..<factCount:
            let factIndex = factCursor + offset
            let readRow = rebuilt.producerFactReadRowIds[factIndex]
            if rebuilt.producerFactFunctionIds[factIndex] != functionId:
                err = " semantic snapshot incremental read producer: fact function drift"
                return false
            if readRow < readCursor || readRow >= readCursor + readCount:
                err = " semantic snapshot incremental read producer: fact read row drift"
                return false
            if rebuilt.producerCanonicalSourceIds[factIndex] !=
                   current.functionSourceIds[functionId]:
                err = " semantic snapshot incremental read producer: canonical source drift"
                return false
            let canonicalSourceId =
                rebuilt.producerCanonicalSourceIds[factIndex]
            if canonicalSourceId < 0 ||
               canonicalSourceId >= current.sourceProducerIndexes.len ||
               rebuilt.producerSourceIds[factIndex] !=
                   current.sourceProducerIndexes[canonicalSourceId]:
                err = " semantic snapshot incremental read producer: producer source drift"
                return false
            if rebuilt.producerFactRowIds[factIndex] < 0:
                err = " semantic snapshot incremental read producer: fact row missing"
                return false
            if rebuilt.producerOriginNodeIds[factIndex] < 0:
                err = " semantic snapshot incremental read producer: parser origin missing"
                return false
            if incrementalRebuildReadProducerFactDomain(
                    rebuilt.producerFactKinds[factIndex]) !=
                   rebuilt.targetDomainKinds[readRow]:
                err = " semantic snapshot incremental read producer: fact domain drift"
                return false
            if offset > 0 &&
               !incrementalRebuildReadProducerFactLess(
                   rebuilt.producerFactKinds[factIndex - 1],
                   rebuilt.producerFactRowIds[factIndex - 1],
                   rebuilt.producerFactReadRowIds[factIndex - 1],
                   rebuilt.producerFactKinds[factIndex],
                   rebuilt.producerFactRowIds[factIndex],
                   readRow):
                err = " semantic snapshot incremental read producer: compiler facts out of order"
                return false
            if !layout.FixedBytes32Equal(
                    incrementalRebuildReadFactTraceCid(
                        current, rebuilt, factIndex),
                    rebuilt.producerFactTraceCids[factIndex]):
                err = " semantic snapshot incremental read producer: compiler fact trace mismatch"
                return false
            readObserved[readRow - readCursor] = true
        for offset in 0..<readCount:
            if !readObserved[offset]:
                err = " semantic snapshot incremental read producer: unproved read row"
                return false
        if !layout.FixedBytes32Equal(
                incrementalRebuildReadInvocationReceiptCid(
                    rebuilt, invocationIndex),
                rebuilt.invocationReceiptCids[invocationIndex]):
            err = " semantic snapshot incremental read producer: invocation receipt mismatch"
            return false
        readCursor = readCursor + readCount
        factCursor = factCursor + factCount
    if readCursor != rebuilt.targetDomainKinds.len ||
       factCursor != rebuilt.producerFactRowIds.len ||
       !incrementalRebuildReadProducerFactIdentityUnique(rebuilt, err) ||
       !layout.FixedBytes32Equal(
           incrementalRebuildReadProducerReceiptCid(rebuilt),
           expectedProducerReceiptCid):
        if err == "":
            err = " semantic snapshot incremental read producer: receipt mismatch"
        return false
    err = ""
    return true

fn SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        err: var str): bool =
    if !incrementalFinalizedPlanCurrentValidateInto(current, plan, err):
        return false
    return incrementalRebuildReadProducerCurrentStrictValidateInto(
        current, plan.planCid, plan.rebuildFunctionIds, rebuilt,
        rebuilt.producerReceiptCid, err)

fn SemanticSnapshotIncrementalRebuildReadProducerInitInto(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        producerFactsRootCid: layout.FixedBytes32,
        expectedProducerFactCount: int32,
        out: var SemanticSnapshotIncrementalRebuildReadInput,
        err: var str): bool =
    out = SemanticSnapshotIncrementalRebuildReadInput()
    if !incrementalFinalizedPlanCurrentValidateInto(current, plan, err) ||
       !incrementalCidObserved(producerFactsRootCid) ||
       expectedProducerFactCount < 0 ||
       expectedProducerFactCount >
           SemanticSnapshotIncrementalMaxIndexedRows:
        if err == "":
            err = " semantic snapshot incremental read producer: invalid init"
        return false
    var rebuilt: SemanticSnapshotIncrementalRebuildReadInput
    rebuilt.producerWorkspaceSessionCid = current.workspaceSessionCid
    rebuilt.producerSourceVersion = current.sourceVersion
    rebuilt.producerFactsCid = current.factsCid
    rebuilt.producerPlanCid = plan.planCid
    rebuilt.producerFrontEndReceiptCid = current.frontEndReceiptCid
    rebuilt.producerFactsRootCid = producerFactsRootCid
    rebuilt.expectedProducerFactCount = expectedProducerFactCount
    out = rebuilt
    err = ""
    return true

fn SemanticSnapshotIncrementalRebuildReadProducerBeginFunctionInto(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        functionId: int32,
        expectedFunctionFactCount: int32,
        err: var str): bool =
    if !incrementalRebuildReadProducerBindingValid(
            current, plan, rebuilt) ||
       incrementalCidObserved(rebuilt.producerReceiptCid) ||
       expectedFunctionFactCount < 0 ||
       expectedFunctionFactCount >
           rebuilt.expectedProducerFactCount -
               rebuilt.producerFactRowIds.len ||
       rebuilt.functionIds.len >= plan.rebuildFunctionIds.len ||
       functionId != plan.rebuildFunctionIds[rebuilt.functionIds.len] ||
       (rebuilt.invocationReceiptCids.len > 0 &&
        !incrementalCidObserved(
            rebuilt.invocationReceiptCids[
                rebuilt.invocationReceiptCids.len - 1])):
        err = " semantic snapshot incremental read producer: invalid or duplicate begin"
        return false
    add(rebuilt.functionIds, functionId)
    add(rebuilt.readStarts, rebuilt.targetDomainKinds.len)
    add(rebuilt.readCounts, 0)
    add(rebuilt.factStarts, rebuilt.producerFactRowIds.len)
    add(rebuilt.factCounts, 0)
    add(rebuilt.expectedFunctionFactCounts,
        expectedFunctionFactCount)
    add(rebuilt.invocationReceiptCids, layout.FixedBytes32())
    err = ""
    return true

@borrows
fn SemanticSnapshotIncrementalRebuildReadProducerAppendReadInto(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        functionId: int32,
        targetDomainKind: int32,
        targetPortableKeyCid: layout.FixedBytes32,
        observedValueCid: layout.FixedBytes32,
        readRowOut: var int32,
        err: var str): bool =
    readRowOut = -1
    let invocationIndex = rebuilt.functionIds.len - 1
    if !incrementalRebuildReadProducerBindingValid(
            current, plan, rebuilt) ||
       invocationIndex < 0 ||
       rebuilt.functionIds[invocationIndex] != functionId ||
       incrementalCidObserved(
           rebuilt.invocationReceiptCids[invocationIndex]) ||
       incrementalCidObserved(rebuilt.producerReceiptCid):
        err = " semantic snapshot incremental read producer: no active invocation"
        return false
    let targetId = incrementalCurrentFindReadTarget(
        current, targetDomainKind, targetPortableKeyCid)
    if targetId < 0 ||
       !layout.FixedBytes32Equal(
           current.readTargetObservedValueCids[targetId],
           observedValueCid):
        err = " semantic snapshot incremental read producer: target drift"
        return false
    let readStart = rebuilt.readStarts[invocationIndex]
    let readCount = rebuilt.readCounts[invocationIndex]
    if readCount > 0:
        let previousRow = readStart + readCount - 1
        if !incrementalReadTargetLess(
                rebuilt.targetDomainKinds[previousRow],
                rebuilt.targetPortableKeyCids[previousRow],
                targetDomainKind, targetPortableKeyCid):
            err = " semantic snapshot incremental read producer: duplicate or unordered read"
            return false
    readRowOut = rebuilt.targetDomainKinds.len
    add(rebuilt.targetDomainKinds, targetDomainKind)
    add(rebuilt.targetPortableKeyCids, targetPortableKeyCid)
    add(rebuilt.observedValueCids, observedValueCid)
    rebuilt.readCounts[invocationIndex] = readCount + 1
    err = ""
    return true

fn SemanticSnapshotIncrementalRebuildReadProducerAppendCompilerFactInto(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        functionId: int32,
        readRowId: int32,
        producerFactKind: int32,
        producerSourceId: int32,
        producerCanonicalSourceId: int32,
        producerFactRowId: int32,
        producerOriginNodeId: int32,
        err: var str): bool =
    let invocationIndex = rebuilt.functionIds.len - 1
    if !incrementalRebuildReadProducerBindingValid(
            current, plan, rebuilt) ||
       invocationIndex < 0 ||
       rebuilt.functionIds[invocationIndex] != functionId ||
       incrementalCidObserved(
           rebuilt.invocationReceiptCids[invocationIndex]) ||
       incrementalCidObserved(rebuilt.producerReceiptCid) ||
       rebuilt.producerFactRowIds.len >=
           rebuilt.expectedProducerFactCount ||
       rebuilt.factCounts[invocationIndex] >=
           rebuilt.expectedFunctionFactCounts[invocationIndex]:
        err = " semantic snapshot incremental read producer: no active compiler fact invocation"
        return false
    let readStart = rebuilt.readStarts[invocationIndex]
    let readCount = rebuilt.readCounts[invocationIndex]
    let factCount = rebuilt.factCounts[invocationIndex]
    if readRowId < readStart || readRowId >= readStart + readCount ||
       producerCanonicalSourceId !=
           current.functionSourceIds[functionId] ||
       producerSourceId != current.sourceProducerIndexes[
           producerCanonicalSourceId] ||
       producerFactRowId < 0 || producerOriginNodeId < 0 ||
       incrementalRebuildReadProducerFactDomain(producerFactKind) !=
           rebuilt.targetDomainKinds[readRowId] ||
       (factCount > 0 &&
        !incrementalRebuildReadProducerFactLess(
            rebuilt.producerFactKinds[
                rebuilt.producerFactKinds.len - 1],
            rebuilt.producerFactRowIds[
                rebuilt.producerFactRowIds.len - 1],
            rebuilt.producerFactReadRowIds[
                rebuilt.producerFactReadRowIds.len - 1],
            producerFactKind, producerFactRowId, readRowId)):
        err = " semantic snapshot incremental read producer: invalid unordered or cross-function fact"
        return false
    add(rebuilt.producerFactFunctionIds, functionId)
    add(rebuilt.producerFactReadRowIds, readRowId)
    add(rebuilt.producerFactKinds, producerFactKind)
    add(rebuilt.producerSourceIds, producerSourceId)
    add(rebuilt.producerCanonicalSourceIds, producerCanonicalSourceId)
    add(rebuilt.producerFactRowIds, producerFactRowId)
    add(rebuilt.producerOriginNodeIds, producerOriginNodeId)
    add(rebuilt.producerFactTraceCids,
        incrementalRebuildReadFactTraceCid(
            current, rebuilt, rebuilt.producerFactRowIds.len - 1))
    rebuilt.factCounts[invocationIndex] = factCount + 1
    err = ""
    return true

fn SemanticSnapshotIncrementalRebuildReadProducerEndFunctionInto(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        functionId: int32,
        err: var str): bool =
    let invocationIndex = rebuilt.functionIds.len - 1
    if !incrementalRebuildReadProducerBindingValid(
            current, plan, rebuilt) ||
       invocationIndex < 0 ||
       rebuilt.functionIds[invocationIndex] != functionId ||
       incrementalCidObserved(
           rebuilt.invocationReceiptCids[invocationIndex]) ||
       rebuilt.factCounts[invocationIndex] !=
           rebuilt.expectedFunctionFactCounts[invocationIndex]:
        err = " semantic snapshot incremental read producer: invalid or incomplete end"
        return false
    let readStart = rebuilt.readStarts[invocationIndex]
    let readCount = rebuilt.readCounts[invocationIndex]
    let factStart = rebuilt.factStarts[invocationIndex]
    let factCount = rebuilt.factCounts[invocationIndex]
    var readObserved: bool[]
    setLen(readObserved, readCount)
    for offset in 0..<factCount:
        let readRow = rebuilt.producerFactReadRowIds[factStart + offset]
        if readRow < readStart || readRow >= readStart + readCount:
            err = " semantic snapshot incremental read producer: fact escaped invocation"
            return false
        readObserved[readRow - readStart] = true
    for offset in 0..<readCount:
        if !readObserved[offset]:
            err = " semantic snapshot incremental read producer: unconsumed read row"
            return false
    rebuilt.invocationReceiptCids[invocationIndex] =
        incrementalRebuildReadInvocationReceiptCid(
            rebuilt, invocationIndex)
    err = ""
    return true

fn SemanticSnapshotIncrementalRebuildReadProducerSealInto(
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        err: var str): bool =
    if !incrementalRebuildReadProducerBindingValid(
            current, plan, rebuilt) ||
       incrementalCidObserved(rebuilt.producerReceiptCid) ||
       rebuilt.functionIds.len != plan.rebuildFunctionIds.len ||
       rebuilt.producerFactRowIds.len !=
           rebuilt.expectedProducerFactCount ||
       (rebuilt.invocationReceiptCids.len > 0 &&
        !incrementalCidObserved(
            rebuilt.invocationReceiptCids[
                rebuilt.invocationReceiptCids.len - 1])):
        err = " semantic snapshot incremental read producer: incomplete seal"
        return false
    let producerReceiptCid =
        incrementalRebuildReadProducerReceiptCid(rebuilt)
    if !incrementalFinalizedPlanCurrentValidateInto(current, plan, err) ||
       !incrementalRebuildReadProducerCurrentStrictValidateInto(
            current, plan.planCid, plan.rebuildFunctionIds, rebuilt,
            producerReceiptCid, err):
        return false
    rebuilt.producerReceiptCid = producerReceiptCid
    err = ""
    return true

@borrows
fn incrementalFinalizedReverseIndexCid(
        readSet: snapshot_schema.CsgCompilerReadSetTable):
        layout.FixedBytes32 =
    let targetCount = readSet.reverseTargetDomainKinds.len
    let readCount = readSet.reverseReaderFunctionIds.len
    var buf = layout.ByteBufInit(
        128 + targetCount * 40 + readCount * 40)
    incrementalAppendText(buf, "cheng.csg_compiler.read_set_reverse")
    incrementalAppendU32(buf, targetCount)
    for targetId in 0..<targetCount:
        incrementalAppendU32(
            buf, readSet.reverseTargetDomainKinds[targetId])
        incrementalAppendCid(
            buf, readSet.reverseTargetPortableKeyCids[targetId])
        incrementalAppendU32(buf, readSet.reverseStarts[targetId])
        incrementalAppendU32(buf, readSet.reverseCounts[targetId])
    incrementalAppendU32(buf, readCount)
    for row in 0..<readCount:
        incrementalAppendU32(buf, readSet.reverseReaderFunctionIds[row])
        incrementalAppendCid(buf, readSet.reverseObservedValueCids[row])
        incrementalAppendU32(buf, readSet.reverseForwardRowIds[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalFinalizedReverseIndexOwnerReceiptCid(
        owner: SemanticSnapshotIncrementalFinalizedReverseIndexOwner):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(224)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.incremental.reverse_index_owner")
    incrementalAppendCid(buf, owner.factsCid)
    incrementalAppendCid(buf, owner.planCid)
    incrementalAppendU32(buf, owner.forwardReadCount)
    incrementalAppendU32(buf, owner.reverseTargetCount)
    incrementalAppendU32(buf, owner.buildCount)
    incrementalAppendCid(buf, owner.reverseIndexCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn incrementalFinalizedReverseIndexOwnerMakeInto(
        finalized: var SemanticSnapshotIncrementalFinalizedReadSet,
        err: var str): bool =
    var owner: SemanticSnapshotIncrementalFinalizedReverseIndexOwner
    owner.valid = true
    owner.factsCid = finalized.factsCid
    owner.planCid = finalized.planCid
    owner.forwardReadCount = finalized.readSet.readerFunctionIds.len
    owner.reverseTargetCount =
        finalized.readSet.reverseTargetDomainKinds.len
    owner.buildCount = 1
    owner.reverseIndexCid = finalized.readSet.reverseIndexCid
    if !incrementalCidObserved(owner.factsCid) ||
       !incrementalCidObserved(owner.planCid) ||
       !incrementalCidObserved(owner.reverseIndexCid):
        err = " semantic snapshot incremental reverse index: invalid owner source"
        return false
    let receiptCid =
        incrementalFinalizedReverseIndexOwnerReceiptCid(owner)
    owner.receiptCid = receiptCid
    finalized.reverseIndexOwner = owner
    err = ""
    return true

@borrows
fn incrementalFinalizedReverseIndexOwnerStrictValidateInto(
        finalized: SemanticSnapshotIncrementalFinalizedReadSet,
        err: var str): bool =
    let owner = finalized.reverseIndexOwner
    let readCount = finalized.readSet.readerFunctionIds.len
    let targetCount =
        finalized.readSet.reverseTargetDomainKinds.len
    if !owner.valid || owner.buildCount != 1 ||
       owner.forwardReadCount != readCount ||
       owner.reverseTargetCount != targetCount ||
       !layout.FixedBytes32Equal(owner.factsCid, finalized.factsCid) ||
       !layout.FixedBytes32Equal(owner.planCid, finalized.planCid) ||
       !layout.FixedBytes32Equal(
           owner.reverseIndexCid, finalized.readSet.reverseIndexCid) ||
       !layout.FixedBytes32Equal(
           incrementalFinalizedReverseIndexOwnerReceiptCid(owner),
           owner.receiptCid) ||
       targetCount !=
           finalized.readSet.reverseTargetPortableKeyCids.len ||
       targetCount != finalized.readSet.reverseStarts.len ||
       targetCount != finalized.readSet.reverseCounts.len ||
       readCount != finalized.readSet.targetDomainKinds.len ||
       readCount != finalized.readSet.targetPortableKeyCids.len ||
       readCount != finalized.readSet.observedValueCids.len ||
       readCount != finalized.readSet.reverseReaderFunctionIds.len ||
       readCount != finalized.readSet.reverseObservedValueCids.len ||
       readCount != finalized.readSet.reverseForwardRowIds.len:
        err = " semantic snapshot incremental reverse index: invalid owner shape"
        return false
    var seenForwardRows: bool[]
    setLen(seenForwardRows, readCount)
    var reverseCursor: int32
    for targetId in 0..<targetCount:
        let start = finalized.readSet.reverseStarts[targetId]
        let count = finalized.readSet.reverseCounts[targetId]
        if start != reverseCursor || count <= 0 ||
           count > readCount - reverseCursor ||
           (targetId > 0 &&
            !incrementalReadTargetLess(
                finalized.readSet.reverseTargetDomainKinds[targetId - 1],
                finalized.readSet.reverseTargetPortableKeyCids[targetId - 1],
                finalized.readSet.reverseTargetDomainKinds[targetId],
                finalized.readSet.reverseTargetPortableKeyCids[targetId])):
            err = " semantic snapshot incremental reverse index: non-canonical target csr"
            return false
        for offset in 0..<count:
            let reverseRow = start + offset
            let forwardRow =
                finalized.readSet.reverseForwardRowIds[reverseRow]
            if forwardRow < 0 || forwardRow >= readCount ||
               seenForwardRows[forwardRow] ||
               finalized.readSet.targetDomainKinds[forwardRow] !=
                   finalized.readSet.reverseTargetDomainKinds[targetId] ||
               !layout.FixedBytes32Equal(
                   finalized.readSet.targetPortableKeyCids[forwardRow],
                   finalized.readSet.reverseTargetPortableKeyCids[targetId]) ||
               finalized.readSet.readerFunctionIds[forwardRow] !=
                   finalized.readSet.reverseReaderFunctionIds[reverseRow] ||
               !layout.FixedBytes32Equal(
                   finalized.readSet.observedValueCids[forwardRow],
                   finalized.readSet.reverseObservedValueCids[reverseRow]) ||
               (offset > 0 && forwardRow <=
                   finalized.readSet.reverseForwardRowIds[reverseRow - 1]):
                err = " semantic snapshot incremental reverse index: reverse row mismatch"
                return false
            seenForwardRows[forwardRow] = true
        reverseCursor = reverseCursor + count
    if reverseCursor != readCount:
        err = " semantic snapshot incremental reverse index: reverse coverage mismatch"
        return false
    for forwardRow in 0..<readCount:
        if !seenForwardRows[forwardRow]:
            err = " semantic snapshot incremental reverse index: missing forward row"
            return false
    if !layout.FixedBytes32Equal(
            incrementalFinalizedReverseIndexCid(finalized.readSet),
            finalized.readSet.reverseIndexCid):
        err = " semantic snapshot incremental reverse index: cid mismatch"
        return false
    err = ""
    return true

fn SemanticSnapshotIncrementalFinalizedReverseIndexBuildCount(
        finalized: SemanticSnapshotIncrementalFinalizedReadSet): int32 =
    return finalized.reverseIndexOwner.buildCount

@borrows
fn SemanticSnapshotIncrementalFinalizedReadSetReceiptCid(
        facts: SemanticSnapshotIncrementalFinalizedReadSet):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512 + facts.readSet.readerFunctionIds.len * 80)
    incrementalAppendText(buf, "cheng.semantic_snapshot.incremental.finalized_read_set")
    incrementalAppendU32(buf, facts.initialBuild ? 1 : 0)
    incrementalAppendCid(buf, facts.previousCsgRootCid)
    incrementalAppendI64(buf, facts.sourceVersion)
    incrementalAppendCid(buf, facts.factsCid)
    incrementalAppendCid(buf, facts.planCid)
    incrementalAppendU32(buf, facts.rebuildFunctionIds.len)
    for row in 0..<facts.rebuildFunctionIds.len:
        incrementalAppendU32(buf, facts.rebuildFunctionIds[row])
    incrementalAppendCid(
        buf, facts.rebuildReadProducer.producerReceiptCid)
    incrementalAppendU32(buf, facts.readStarts.len)
    for functionId in 0..<facts.readStarts.len:
        incrementalAppendU32(buf, facts.readStarts[functionId])
        incrementalAppendU32(buf, facts.readCounts[functionId])
        incrementalAppendCid(buf, facts.readSetPreimageCids[functionId])
    incrementalAppendU32(buf, facts.readSet.readerFunctionIds.len)
    for row in 0..<facts.readSet.readerFunctionIds.len:
        incrementalAppendU32(buf, facts.readSet.readerFunctionIds[row])
        incrementalAppendU32(buf, facts.readSet.targetDomainKinds[row])
        incrementalAppendCid(buf, facts.readSet.targetPortableKeyCids[row])
        incrementalAppendCid(buf, facts.readSet.observedValueCids[row])
    incrementalAppendCid(buf, facts.readSet.reverseIndexCid)
    incrementalAppendCid(buf, facts.reverseIndexOwner.receiptCid)
    incrementalAppendU32(buf, facts.readSet.reverseStarts.len)
    for targetId in 0..<facts.readSet.reverseStarts.len:
        incrementalAppendU32(
            buf, facts.readSet.reverseTargetDomainKinds[targetId])
        incrementalAppendCid(
            buf, facts.readSet.reverseTargetPortableKeyCids[targetId])
        incrementalAppendU32(buf, facts.readSet.reverseStarts[targetId])
        incrementalAppendU32(buf, facts.readSet.reverseCounts[targetId])
    incrementalAppendU32(buf, facts.readSet.reverseReaderFunctionIds.len)
    for row in 0..<facts.readSet.reverseReaderFunctionIds.len:
        incrementalAppendU32(buf, facts.readSet.reverseReaderFunctionIds[row])
        incrementalAppendCid(buf, facts.readSet.reverseObservedValueCids[row])
        incrementalAppendU32(buf, facts.readSet.reverseForwardRowIds[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalFinalizedPlanCurrentValidateInto(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        plan: SemanticSnapshotIncrementalPrebuildPlan,
        err: var str): bool =
    if !SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(current, err) ||
       !SemanticSnapshotIncrementalPrebuildPlanStrictValidateInto(plan, err):
        return false
    if !layout.FixedBytes32Equal(plan.factsCid, current.factsCid) ||
       !layout.FixedBytes32Equal(plan.workspaceSessionCid,
                                 current.workspaceSessionCid) ||
       !layout.FixedBytes32Equal(plan.worldHeadCid, current.worldHeadCid) ||
       !layout.FixedBytes32Equal(plan.compilerCid, current.compilerCid) ||
       !layout.FixedBytes32Equal(plan.sourceBundleCid,
                                 current.sourceBundleCid) ||
       !layout.FixedBytes32Equal(plan.frontEndReceiptCid,
                                 current.frontEndReceiptCid) ||
       plan.symbolCount != current.symbolCids.len ||
       plan.functionIds.len != current.functionSymbolIds.len:
        err = " semantic snapshot incremental finalized read-set: plan facts mismatch"
        return false
    for functionId in 0..<plan.functionIds.len:
        if plan.functionSymbolIds[functionId] !=
               current.functionSymbolIds[functionId] ||
           !layout.FixedBytes32Equal(plan.bodyContentCids[functionId],
                                     current.bodyContentCids[functionId]) ||
           !layout.FixedBytes32Equal(plan.interfaceCids[functionId],
                                     current.functionInterfaceCids[functionId]):
            err = " semantic snapshot incremental finalized read-set: plan function mismatch"
            return false
    return true

@borrows
fn SemanticSnapshotIncrementalFinalizedReadSetCurrentStrictValidateInto(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        finalized: SemanticSnapshotIncrementalFinalizedReadSet,
        err: var str): bool =
    err = ""
    if !SemanticSnapshotIncrementalPrebuildFactsStrictValidateInto(current, err):
        return false
    let functionCount = current.functionSymbolIds.len
    let readCount = finalized.readSet.readerFunctionIds.len
    if finalized.sourceVersion != current.sourceVersion ||
       !layout.FixedBytes32Equal(finalized.factsCid, current.factsCid) ||
       (finalized.initialBuild &&
        incrementalCidObserved(finalized.previousCsgRootCid)) ||
       (!finalized.initialBuild &&
        !incrementalCidObserved(finalized.previousCsgRootCid)) ||
       !incrementalCidObserved(finalized.planCid) ||
       finalized.readStarts.len != functionCount ||
       finalized.readCounts.len != functionCount ||
       finalized.readSetPreimageCids.len != functionCount ||
       finalized.readSet.targetDomainKinds.len != readCount ||
       finalized.readSet.targetPortableKeyCids.len != readCount ||
       finalized.readSet.observedValueCids.len != readCount ||
       finalized.readSet.reverseTargetDomainKinds.len !=
           finalized.readSet.reverseStarts.len ||
       finalized.readSet.reverseTargetPortableKeyCids.len !=
           finalized.readSet.reverseStarts.len ||
       finalized.readSet.reverseCounts.len !=
           finalized.readSet.reverseStarts.len ||
       finalized.readSet.reverseReaderFunctionIds.len != readCount ||
       finalized.readSet.reverseObservedValueCids.len != readCount ||
       finalized.readSet.reverseForwardRowIds.len != readCount:
        err = " semantic snapshot incremental finalized read-set: invalid shape"
        return false
    for index in 0..<finalized.rebuildFunctionIds.len:
        if finalized.rebuildFunctionIds[index] < 0 ||
           finalized.rebuildFunctionIds[index] >= functionCount ||
           (index > 0 && finalized.rebuildFunctionIds[index] <=
               finalized.rebuildFunctionIds[index - 1]):
            err = " semantic snapshot incremental finalized read-set: invalid rebuild ledger"
            return false
    var rebuiltProducer: SemanticSnapshotIncrementalRebuildReadInput
    if !incrementalRebuildReadProducerInputFromFinalizedInto(
            finalized, rebuiltProducer, err) ||
       !incrementalRebuildReadProducerCurrentStrictValidateInto(
            current, finalized.planCid, finalized.rebuildFunctionIds,
            rebuiltProducer, rebuiltProducer.producerReceiptCid, err):
        return false
    var cursor: int32
    for functionId in 0..<functionCount:
        let start = finalized.readStarts[functionId]
        let count = finalized.readCounts[functionId]
        if start != cursor || count < 0 || start > readCount ||
           count > readCount - start:
            err = " semantic snapshot incremental finalized read-set: invalid function csr"
            return false
        for offset in 0..<count:
            let row = start + offset
            let domainKind = finalized.readSet.targetDomainKinds[row]
            let portableKeyCid =
                finalized.readSet.targetPortableKeyCids[row]
            let targetId = incrementalCurrentFindReadTarget(
                current, domainKind, portableKeyCid)
            if finalized.readSet.readerFunctionIds[row] != functionId ||
               targetId < 0 ||
               !layout.FixedBytes32Equal(
                   finalized.readSet.observedValueCids[row],
                   current.readTargetObservedValueCids[targetId]):
                err = " semantic snapshot incremental finalized read-set: invalid forward row"
                return false
            if offset > 0:
                let previousRow = row - 1
                if !incrementalReadTargetLess(
                       finalized.readSet.targetDomainKinds[previousRow],
                       finalized.readSet.targetPortableKeyCids[previousRow],
                       domainKind, portableKeyCid):
                    err = " semantic snapshot incremental finalized read-set: non-canonical function reads"
                    return false
        var preimage: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerReadSetPreimageCidInto(
                current.symbolCids[current.functionSymbolIds[functionId]],
                finalized.readSet.targetDomainKinds,
                finalized.readSet.targetPortableKeyCids,
                finalized.readSet.observedValueCids,
                start, count, preimage, err) ||
           !layout.FixedBytes32Equal(
               preimage, finalized.readSetPreimageCids[functionId]):
            err = " semantic snapshot incremental finalized read-set: preimage mismatch"
            return false
        cursor = start + count
    if cursor != readCount:
        err = " semantic snapshot incremental finalized read-set: read coverage mismatch"
        return false
    if !incrementalFinalizedReverseIndexOwnerStrictValidateInto(
            finalized, err) ||
       !layout.FixedBytes32Equal(
            SemanticSnapshotIncrementalFinalizedReadSetReceiptCid(finalized),
            finalized.receiptCid):
        if err == "":
            err = " semantic snapshot incremental finalized read-set: receipt mismatch"
        return false
    return true

fn SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
        previous: var snapshot_schema.CsgCompilerSnapshotTables,
        current: var SemanticSnapshotIncrementalPrebuildFacts,
        plan: var SemanticSnapshotIncrementalPrebuildPlan,
        rebuilt: var SemanticSnapshotIncrementalRebuildReadInput,
        out: var SemanticSnapshotIncrementalFinalizedReadSet,
    err: var str): bool =
    err = ""
    let initialBuild = plan.previousSourceVersion == 0
    if !incrementalFinalizedPlanCurrentValidateInto(current, plan, err) ||
       !SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
           current, plan, rebuilt, err):
        return false
    if initialBuild:
        if previous.texts.len != 0 ||
           previous.sources.documentCids.len != 0 ||
           previous.symbols.symbolCids.len != 0 ||
           previous.functions.symbolIds.len != 0 ||
           previous.readSet.readerFunctionIds.len != 0 ||
           incrementalCidObserved(previous.predecessorReceiptCid):
            err = " semantic snapshot incremental finalized read-set: initial build received previous snapshot"
            return false
    else:
        if !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
                previous, err):
            return false
        var cargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(previous)
        let previousValid = cargo.ok &&
            layout.FixedBytes32Equal(
                cargo.factsRootCid, plan.previousCsgRootCid) &&
            layout.FixedBytes32Equal(
                previous.readSet.reverseIndexCid,
                plan.previousReadSetReverseIndexCid)
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(cargo)
        if !previousValid:
            err = " semantic snapshot incremental finalized read-set: previous snapshot mismatch"
            return false
        if plan.previousFunctionCount !=
               previous.functions.symbolIds.len:
            err = " semantic snapshot incremental finalized read-set: previous function count mismatch"
            return false
    for functionId in 0..<plan.functionIds.len:
        let previousFunctionId = plan.previousFunctionIds[functionId]
        if previousFunctionId < 0:
            continue
        let previousSymbolId =
            previous.functions.symbolIds[previousFunctionId]
        if previousSymbolId < 0 ||
           previousSymbolId >= previous.symbols.symbolCids.len ||
           !layout.FixedBytes32Equal(
               previous.symbols.symbolCids[previousSymbolId],
               current.symbolCids[current.functionSymbolIds[functionId]]) ||
           !layout.FixedBytes32Equal(
               previous.functions.bodyContentCids[previousFunctionId],
               plan.previousBodyContentCids[functionId]) ||
           !layout.FixedBytes32Equal(
               previous.functions.interfaceCids[previousFunctionId],
               plan.previousInterfaceCids[functionId]) ||
           !layout.FixedBytes32Equal(
               previous.functions.readSetPreimageCids[previousFunctionId],
               plan.previousReadSetPreimageCids[functionId]) ||
           !layout.FixedBytes32Equal(
               previous.functions.fragmentCids[previousFunctionId],
               plan.previousFragmentCids[functionId]):
            err = " semantic snapshot incremental finalized read-set: previous/current SymbolCid mismatch"
            return false
    let rebuildCount = plan.rebuildFunctionIds.len
    let rebuiltReadCount = rebuilt.targetDomainKinds.len
    if rebuilt.functionIds.len != rebuildCount ||
       rebuilt.readStarts.len != rebuildCount ||
       rebuilt.readCounts.len != rebuildCount ||
       rebuilt.targetPortableKeyCids.len != rebuiltReadCount ||
       rebuilt.observedValueCids.len != rebuiltReadCount:
        err = " semantic snapshot incremental finalized read-set: invalid rebuild shape"
        return false
    var rebuiltCursor: int32
    for index in 0..<rebuildCount:
        if rebuilt.functionIds[index] != plan.rebuildFunctionIds[index] ||
           rebuilt.readStarts[index] != rebuiltCursor ||
           rebuilt.readCounts[index] < 0 ||
           rebuilt.readStarts[index] > rebuiltReadCount ||
           rebuilt.readCounts[index] >
               rebuiltReadCount - rebuilt.readStarts[index]:
            err = " semantic snapshot incremental finalized read-set: missing extra or duplicate rebuild row"
            return false
        rebuiltCursor = rebuilt.readStarts[index] + rebuilt.readCounts[index]
    if rebuiltCursor != rebuiltReadCount:
        err = " semantic snapshot incremental finalized read-set: rebuild coverage mismatch"
        return false
    var finalized: SemanticSnapshotIncrementalFinalizedReadSet
    finalized.initialBuild = initialBuild
    finalized.previousCsgRootCid = plan.previousCsgRootCid
    finalized.sourceVersion = current.sourceVersion
    finalized.factsCid = current.factsCid
    finalized.planCid = plan.planCid
    let rebuildReadProducer =
        incrementalRebuildReadProducerReceiptFromInput(rebuilt)
    finalized.rebuildReadProducer = rebuildReadProducer
    var rebuildIndex: int32
    for functionId in 0..<plan.functionIds.len:
        add(finalized.readStarts,
            finalized.readSet.readerFunctionIds.len)
        if plan.partitionKinds[functionId] ==
               SemanticSnapshotIncrementalPartitionReusable:
            let previousFunctionId = plan.previousFunctionIds[functionId]
            let start = previous.functions.readStarts[previousFunctionId]
            let count = previous.functions.readCounts[previousFunctionId]
            for offset in 0..<count:
                let previousRow = start + offset
                let domainKind =
                    previous.readSet.targetDomainKinds[previousRow]
                let portableKeyCid =
                    previous.readSet.targetPortableKeyCids[previousRow]
                let currentTarget = incrementalCurrentFindReadTarget(
                    current, domainKind, portableKeyCid)
                if currentTarget < 0 ||
                   !layout.FixedBytes32Equal(
                       previous.readSet.observedValueCids[previousRow],
                       current.readTargetObservedValueCids[currentTarget]):
                    err = " semantic snapshot incremental finalized read-set: reusable target removed or changed"
                    return false
                add(finalized.readSet.readerFunctionIds, functionId)
                add(finalized.readSet.targetDomainKinds, domainKind)
                add(finalized.readSet.targetPortableKeyCids, portableKeyCid)
                add(finalized.readSet.observedValueCids,
                    previous.readSet.observedValueCids[previousRow])
            add(finalized.readCounts, count)
        else:
            if rebuildIndex >= rebuildCount ||
               rebuilt.functionIds[rebuildIndex] != functionId:
                err = " semantic snapshot incremental finalized read-set: rebuild partition drift"
                return false
            let start = rebuilt.readStarts[rebuildIndex]
            let count = rebuilt.readCounts[rebuildIndex]
            for offset in 0..<count:
                let row = start + offset
                let domainKind = rebuilt.targetDomainKinds[row]
                let portableKeyCid = rebuilt.targetPortableKeyCids[row]
                let targetId = incrementalCurrentFindReadTarget(
                    current, domainKind, portableKeyCid)
                if targetId < 0 ||
                   !layout.FixedBytes32Equal(
                       rebuilt.observedValueCids[row],
                       current.readTargetObservedValueCids[targetId]):
                    err = " semantic snapshot incremental finalized read-set: invalid rebuilt read"
                    return false
                if offset > 0:
                    let previousRow = row - 1
                    if !incrementalReadTargetLess(
                           rebuilt.targetDomainKinds[previousRow],
                           rebuilt.targetPortableKeyCids[previousRow],
                           domainKind, portableKeyCid):
                        err = " semantic snapshot incremental finalized read-set: non-canonical rebuilt reads"
                        return false
                add(finalized.readSet.readerFunctionIds, functionId)
                add(finalized.readSet.targetDomainKinds, domainKind)
                add(finalized.readSet.targetPortableKeyCids, portableKeyCid)
                add(finalized.readSet.observedValueCids,
                    rebuilt.observedValueCids[row])
            add(finalized.readCounts, count)
            add(finalized.rebuildFunctionIds, functionId)
            rebuildIndex = rebuildIndex + 1
        var preimage: layout.FixedBytes32
        if !snapshot_schema.CsgCompilerReadSetPreimageCidInto(
                current.symbolCids[current.functionSymbolIds[functionId]],
                finalized.readSet.targetDomainKinds,
                finalized.readSet.targetPortableKeyCids,
                finalized.readSet.observedValueCids,
                finalized.readStarts[functionId],
                finalized.readCounts[functionId], preimage, err):
            return false
        add(finalized.readSetPreimageCids, preimage)
    if rebuildIndex != rebuildCount:
        err = " semantic snapshot incremental finalized read-set: rebuild partition coverage mismatch"
        return false
    var reverseSource: snapshot_schema.CsgCompilerSnapshotTables
    reverseSource.sources.documentCids = current.documentCids
    reverseSource.sources.interfaceCids = current.sourceInterfaceCids
    reverseSource.symbols.symbolCids = current.symbolCids
    reverseSource.symbols.interfaceCids = current.symbolInterfaceCids
    reverseSource.functions.symbolIds = current.functionSymbolIds
    reverseSource.readSet = finalized.readSet
    if !snapshot_schema.CsgCompilerReadSetReverseBuildInto(reverseSource, err):
        return false
    finalized.readSet = reverseSource.readSet
    if !incrementalFinalizedReverseIndexOwnerMakeInto(finalized, err):
        return false
    let receiptCid =
        SemanticSnapshotIncrementalFinalizedReadSetReceiptCid(finalized)
    finalized.receiptCid = receiptCid
    if !SemanticSnapshotIncrementalFinalizedReadSetCurrentStrictValidateInto(
            current, finalized, err):
        return false
    out = finalized
    return true

@borrows
fn SemanticSnapshotIncrementalFinalizedReadSetStrictValidateInto(
        previous: snapshot_schema.CsgCompilerSnapshotTables,
        current: SemanticSnapshotIncrementalPrebuildFacts,
        plan: SemanticSnapshotIncrementalPrebuildPlan,
        finalized: SemanticSnapshotIncrementalFinalizedReadSet,
        err: var str): bool =
    if !incrementalFinalizedPlanCurrentValidateInto(current, plan, err) ||
       !SemanticSnapshotIncrementalFinalizedReadSetCurrentStrictValidateInto(
            current, finalized, err) ||
       finalized.initialBuild != (plan.previousSourceVersion == 0) ||
       !layout.FixedBytes32Equal(finalized.previousCsgRootCid,
                                 plan.previousCsgRootCid) ||
       !layout.FixedBytes32Equal(finalized.planCid, plan.planCid) ||
       finalized.rebuildFunctionIds.len != plan.rebuildFunctionIds.len:
        err = " semantic snapshot incremental finalized read-set: plan binding mismatch"
        return false
    for index in 0..<plan.rebuildFunctionIds.len:
        if finalized.rebuildFunctionIds[index] !=
               plan.rebuildFunctionIds[index]:
            err = " semantic snapshot incremental finalized read-set: rebuild ledger mismatch"
            return false
    if finalized.initialBuild:
        if previous.texts.len != 0 ||
           previous.sources.documentCids.len != 0 ||
           previous.symbols.symbolCids.len != 0 ||
           previous.functions.symbolIds.len != 0 ||
           previous.readSet.readerFunctionIds.len != 0 ||
           incrementalCidObserved(previous.predecessorReceiptCid):
            err = " semantic snapshot incremental finalized read-set: initial previous snapshot drift"
            return false
    else:
        if !snapshot_schema.CsgCompilerSnapshotTablesStrictValidateInto(
                previous, err):
            return false
        var previousCargo =
            snapshot_cargo.CsgCompilerSnapshotCargoBuild(previous)
        let previousValid = previousCargo.ok &&
            layout.FixedBytes32Equal(
                previousCargo.factsRootCid,
                plan.previousCsgRootCid) &&
            layout.FixedBytes32Equal(
                previous.readSet.reverseIndexCid,
                plan.previousReadSetReverseIndexCid)
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(previousCargo)
        if !previousValid ||
           plan.previousFunctionCount !=
               previous.functions.symbolIds.len:
            err = " semantic snapshot incremental finalized read-set: previous snapshot mismatch"
            return false
    for functionId in 0..<plan.functionIds.len:
        let previousFunctionId = plan.previousFunctionIds[functionId]
        if previousFunctionId >= 0:
            let previousSymbolId =
                previous.functions.symbolIds[previousFunctionId]
            if previousSymbolId < 0 ||
               previousSymbolId >= previous.symbols.symbolCids.len ||
               !layout.FixedBytes32Equal(
                   previous.symbols.symbolCids[previousSymbolId],
                   current.symbolCids[
                       current.functionSymbolIds[functionId]]) ||
               !layout.FixedBytes32Equal(
                   previous.functions.bodyContentCids[previousFunctionId],
                   plan.previousBodyContentCids[functionId]) ||
               !layout.FixedBytes32Equal(
                   previous.functions.interfaceCids[previousFunctionId],
                   plan.previousInterfaceCids[functionId]) ||
               !layout.FixedBytes32Equal(
                   previous.functions.readSetPreimageCids[
                       previousFunctionId],
                   plan.previousReadSetPreimageCids[functionId]) ||
               !layout.FixedBytes32Equal(
                   previous.functions.fragmentCids[previousFunctionId],
                   plan.previousFragmentCids[functionId]):
                err = " semantic snapshot incremental finalized read-set: previous function mismatch"
                return false
        if plan.partitionKinds[functionId] !=
               SemanticSnapshotIncrementalPartitionReusable:
            continue
        if previousFunctionId < 0 ||
           previousFunctionId >= previous.functions.readStarts.len ||
           finalized.readCounts[functionId] !=
               previous.functions.readCounts[previousFunctionId]:
            err = " semantic snapshot incremental finalized read-set: reusable range mismatch"
            return false
        let currentStart = finalized.readStarts[functionId]
        let previousStart =
            previous.functions.readStarts[previousFunctionId]
        let count = finalized.readCounts[functionId]
        for offset in 0..<count:
            let currentRow = currentStart + offset
            let previousRow = previousStart + offset
            if finalized.readSet.targetDomainKinds[currentRow] !=
                   previous.readSet.targetDomainKinds[previousRow] ||
               !layout.FixedBytes32Equal(
                   finalized.readSet.targetPortableKeyCids[currentRow],
                   previous.readSet.targetPortableKeyCids[previousRow]) ||
               !layout.FixedBytes32Equal(
                   finalized.readSet.observedValueCids[currentRow],
                   previous.readSet.observedValueCids[previousRow]):
                err = " semantic snapshot incremental finalized read-set: reusable row mismatch"
                return false
    return true

fn SemanticSnapshotExactReadSetCidInto(
        readerSymbolCid: layout.FixedBytes32,
        targetDomainKinds: int32[],
        targetPortableKeyCids: layout.FixedBytes32[],
        observedValueCids: layout.FixedBytes32[],
        out: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    out = layout.FixedBytes32()
    if !incrementalCidObserved(readerSymbolCid) ||
       targetDomainKinds.len != targetPortableKeyCids.len ||
       targetDomainKinds.len != observedValueCids.len:
        err = " semantic snapshot fragment cache: invalid external read-set shape"
        return false
    for row in 0..<targetDomainKinds.len:
        if targetDomainKinds[row] <
               snapshot_schema.CsgCompilerReadDomainSourceInterface ||
           targetDomainKinds[row] >
               snapshot_schema.CsgCompilerReadDomainLayout ||
           !incrementalCidObserved(targetPortableKeyCids[row]) ||
           !incrementalCidObserved(observedValueCids[row]):
            err = " semantic snapshot fragment cache: invalid external read-set row"
            return false
        if row > 0:
            let previous = row - 1
            if !incrementalReadTargetLess(
                   targetDomainKinds[previous],
                   targetPortableKeyCids[previous],
                   targetDomainKinds[row], targetPortableKeyCids[row]):
                err = " semantic snapshot fragment cache: non-canonical external read set"
                return false
    return snapshot_schema.CsgCompilerReadSetPreimageCidInto(
        readerSymbolCid, targetDomainKinds, targetPortableKeyCids,
        observedValueCids, 0, targetDomainKinds.len, out, err)

fn incrementalFunctionFragmentAdmissionInputReceiptCid(
        input: SemanticSnapshotFunctionFragmentAdmissionInput):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(384)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.function_fragment_admission_input")
    incrementalAppendI64(buf, input.sourceVersion)
    incrementalAppendCid(buf, input.factsCid)
    incrementalAppendCid(buf, input.finalizedReadSetReceiptCid)
    incrementalAppendU32(buf, input.functionId)
    incrementalAppendCid(buf, input.functionSymbolCid)
    incrementalAppendCid(buf, input.bodyContentCid)
    incrementalAppendCid(buf, input.functionInterfaceCid)
    incrementalAppendCid(buf, input.exactReadSetCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalFunctionFragmentAdmissionAuthorityInto(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        finalized: SemanticSnapshotIncrementalFinalizedReadSet,
        functionId: int32,
        exactReadSetCidOut: var layout.FixedBytes32,
        err: var str): bool =
    exactReadSetCidOut = layout.FixedBytes32()
    if current.sourceVersion <= 0 ||
       !incrementalCidObserved(current.factsCid) ||
       functionId < 0 || functionId >= current.functionSymbolIds.len ||
       current.functionSymbolIds.len != current.bodyContentCids.len ||
       current.functionSymbolIds.len != current.functionInterfaceCids.len ||
       functionId >= finalized.readStarts.len ||
       functionId >= finalized.readCounts.len ||
       functionId >= finalized.readSetPreimageCids.len ||
       finalized.sourceVersion != current.sourceVersion ||
       !layout.FixedBytes32Equal(finalized.factsCid, current.factsCid) ||
       !incrementalCidObserved(finalized.receiptCid) ||
       !layout.FixedBytes32Equal(
           SemanticSnapshotIncrementalFinalizedReadSetReceiptCid(finalized),
           finalized.receiptCid):
        err = " semantic snapshot fragment admission: invalid finalized authority"
        return false
    let symbolId = current.functionSymbolIds[functionId]
    let start = finalized.readStarts[functionId]
    let count = finalized.readCounts[functionId]
    if symbolId < 0 || symbolId >= current.symbolCids.len ||
       start < 0 || count < 0 ||
       start > finalized.readSet.targetDomainKinds.len ||
       count > finalized.readSet.targetDomainKinds.len - start ||
       finalized.readSet.targetDomainKinds.len !=
           finalized.readSet.targetPortableKeyCids.len ||
       finalized.readSet.targetDomainKinds.len !=
           finalized.readSet.observedValueCids.len:
        err = " semantic snapshot fragment admission: invalid finalized function range"
        return false
    var exactReadSetCid: layout.FixedBytes32
    if !snapshot_schema.CsgCompilerReadSetPreimageCidInto(
            current.symbolCids[symbolId],
            finalized.readSet.targetDomainKinds,
            finalized.readSet.targetPortableKeyCids,
            finalized.readSet.observedValueCids,
            start, count, exactReadSetCid, err) ||
       !layout.FixedBytes32Equal(
           exactReadSetCid,
           finalized.readSetPreimageCids[functionId]):
        if err == "":
            err = " semantic snapshot fragment admission: finalized read preimage mismatch"
        return false
    exactReadSetCidOut = exactReadSetCid
    err = ""
    return true

@borrows
fn SemanticSnapshotFunctionFragmentAdmissionInputStrictValidateInto(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        finalized: SemanticSnapshotIncrementalFinalizedReadSet,
        input: SemanticSnapshotFunctionFragmentAdmissionInput,
        err: var str): bool =
    err = ""
    if input.sourceVersion <= 0 || input.functionId < 0 ||
       !incrementalCidObserved(input.factsCid) ||
       !incrementalCidObserved(input.finalizedReadSetReceiptCid) ||
       !incrementalCidObserved(input.functionSymbolCid) ||
       !incrementalCidObserved(input.bodyContentCid) ||
       !incrementalCidObserved(input.functionInterfaceCid) ||
       !incrementalCidObserved(input.exactReadSetCid) ||
       !incrementalCidObserved(input.receiptCid):
        err = " semantic snapshot fragment admission: invalid input identity"
        return false
    var expectedReadSetCid: layout.FixedBytes32
    if !incrementalFunctionFragmentAdmissionAuthorityInto(
            current, finalized, input.functionId,
            expectedReadSetCid, err) ||
       input.sourceVersion != current.sourceVersion ||
       !layout.FixedBytes32Equal(input.factsCid, current.factsCid) ||
       !layout.FixedBytes32Equal(
           input.finalizedReadSetReceiptCid, finalized.receiptCid) ||
       !layout.FixedBytes32Equal(
           input.functionSymbolCid,
           current.symbolCids[
               current.functionSymbolIds[input.functionId]]) ||
       !layout.FixedBytes32Equal(
           input.bodyContentCid,
           current.bodyContentCids[input.functionId]) ||
       !layout.FixedBytes32Equal(
           input.functionInterfaceCid,
           current.functionInterfaceCids[input.functionId]) ||
       !layout.FixedBytes32Equal(
           expectedReadSetCid, input.exactReadSetCid) ||
       !layout.FixedBytes32Equal(
           incrementalFunctionFragmentAdmissionInputReceiptCid(input),
           input.receiptCid):
        if err == "":
            err = " semantic snapshot fragment admission: input receipt mismatch"
        return false
    return true

@borrows
fn SemanticSnapshotFunctionFragmentAdmissionInputMakeInto(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        finalized: SemanticSnapshotIncrementalFinalizedReadSet,
        functionId: int32,
        out: var SemanticSnapshotFunctionFragmentAdmissionInput,
        err: var str): bool =
    out = SemanticSnapshotFunctionFragmentAdmissionInput()
    var exactReadSetCid: layout.FixedBytes32
    if !incrementalFunctionFragmentAdmissionAuthorityInto(
            current, finalized, functionId, exactReadSetCid, err):
        return false
    var input: SemanticSnapshotFunctionFragmentAdmissionInput
    input.sourceVersion = current.sourceVersion
    input.factsCid = current.factsCid
    input.finalizedReadSetReceiptCid = finalized.receiptCid
    input.functionId = functionId
    input.functionSymbolCid =
        current.symbolCids[current.functionSymbolIds[functionId]]
    input.bodyContentCid = current.bodyContentCids[functionId]
    input.functionInterfaceCid =
        current.functionInterfaceCids[functionId]
    input.exactReadSetCid = exactReadSetCid
    input.receiptCid =
        incrementalFunctionFragmentAdmissionInputReceiptCid(input)
    if !SemanticSnapshotFunctionFragmentAdmissionInputStrictValidateInto(
            current, finalized, input, err):
        return false
    out = input
    return true

fn SemanticSnapshotFunctionFragmentCacheKey(
        functionSymbolCid: layout.FixedBytes32,
        bodyContentCid: layout.FixedBytes32,
        functionInterfaceCid: layout.FixedBytes32,
        exactReadSetCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        compilerCid: layout.FixedBytes32,
        targetCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.function_fragment_cache_key")
    incrementalAppendCid(buf, functionSymbolCid)
    incrementalAppendCid(buf, bodyContentCid)
    incrementalAppendCid(buf, functionInterfaceCid)
    incrementalAppendCid(buf, exactReadSetCid)
    incrementalAppendCid(buf, schemaCid)
    incrementalAppendCid(buf, compilerCid)
    incrementalAppendCid(buf, targetCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn SemanticSnapshotFunctionFragmentCid(
        wholeFunctionPayload: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(128 + wholeFunctionPayload.len)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.whole_function_fragment")
    incrementalAppendText(buf, wholeFunctionPayload)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalFunctionFragmentCacheCid(
        cache: SemanticSnapshotFunctionFragmentCache):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256 + cache.keyCids.len * 320)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.function_fragment_cache")
    incrementalAppendU32(buf, cache.keyCids.len)
    for row in 0..<cache.keyCids.len:
        incrementalAppendCid(buf, cache.functionSymbolCids[row])
        incrementalAppendCid(buf, cache.keyCids[row])
        incrementalAppendCid(buf, cache.fragmentCids[row])
        incrementalAppendCid(buf, cache.bodyContentCids[row])
        incrementalAppendCid(buf, cache.functionInterfaceCids[row])
        incrementalAppendCid(
            buf, cache.exactReadSetCids[row])
        incrementalAppendCid(buf, cache.schemaCids[row])
        incrementalAppendCid(buf, cache.compilerCids[row])
        incrementalAppendCid(buf, cache.targetCids[row])
        incrementalAppendU32(buf, cache.payloadByteLengths[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn incrementalFunctionFragmentCacheColumnsAligned(
        cache: SemanticSnapshotFunctionFragmentCache): bool =
    let count = cache.keyCids.len
    return count == cache.functionSymbolCids.len &&
        count == cache.fragmentCids.len &&
        count == cache.bodyContentCids.len &&
        count == cache.functionInterfaceCids.len &&
        count == cache.exactReadSetCids.len &&
        count == cache.schemaCids.len &&
        count == cache.compilerCids.len &&
        count == cache.targetCids.len &&
        count == cache.payloadByteLengths.len &&
        count == cache.payloads.len

@borrows
fn incrementalFunctionFragmentCacheRowStrictValidateInto(
        cache: SemanticSnapshotFunctionFragmentCache,
        row: int32,
        err: var str): bool =
    if !incrementalFunctionFragmentCacheColumnsAligned(cache) ||
       row < 0 || row >= cache.keyCids.len ||
       !incrementalCidObserved(cache.functionSymbolCids[row]) ||
       !incrementalCidObserved(cache.keyCids[row]) ||
       !incrementalCidObserved(cache.fragmentCids[row]) ||
       !incrementalCidObserved(cache.bodyContentCids[row]) ||
       !incrementalCidObserved(cache.functionInterfaceCids[row]) ||
       !incrementalCidObserved(cache.exactReadSetCids[row]) ||
       !incrementalCidObserved(cache.schemaCids[row]) ||
       !incrementalCidObserved(cache.compilerCids[row]) ||
       !incrementalCidObserved(cache.targetCids[row]):
        err = " semantic snapshot fragment cache: invalid row identity"
        return false
    if cache.payloadByteLengths[row] <= 0 ||
       cache.payloadByteLengths[row] != cache.payloads[row].len:
        err = " semantic snapshot fragment cache: payload length or trailing bytes"
        return false
    let expectedFragmentCid = SemanticSnapshotFunctionFragmentCid(
        cache.payloads[row])
    if !layout.FixedBytes32Equal(
            expectedFragmentCid, cache.fragmentCids[row]):
        err = " semantic snapshot fragment cache: fragment CID mismatch"
        return false
    let expectedKeyCid = SemanticSnapshotFunctionFragmentCacheKey(
        cache.functionSymbolCids[row], cache.bodyContentCids[row],
        cache.functionInterfaceCids[row],
        cache.exactReadSetCids[row], cache.schemaCids[row],
        cache.compilerCids[row], cache.targetCids[row])
    if !layout.FixedBytes32Equal(expectedKeyCid, cache.keyCids[row]):
        err = " semantic snapshot fragment cache: key mismatch"
        return false
    return true

@borrows
fn SemanticSnapshotFunctionFragmentCacheStrictValidateInto(
        cache: SemanticSnapshotFunctionFragmentCache,
        err: var str): bool =
    err = ""
    let count = cache.keyCids.len
    if !incrementalFunctionFragmentCacheColumnsAligned(cache) ||
       !incrementalCidObserved(cache.cacheCid):
        err = " semantic snapshot fragment cache: invalid cache shape"
        return false
    for row in 0..<count:
        if !incrementalFunctionFragmentCacheRowStrictValidateInto(
                cache, row, err):
            return false
        if row > 0 &&
           !incrementalCidLess(cache.keyCids[row - 1],
                               cache.keyCids[row]):
            err = " semantic snapshot fragment cache: keys are not canonical"
            return false
        if row > 0 &&
           (!layout.FixedBytes32Equal(cache.schemaCids[row],
                                      cache.schemaCids[0]) ||
            !layout.FixedBytes32Equal(cache.compilerCids[row],
                                      cache.compilerCids[0]) ||
            !layout.FixedBytes32Equal(cache.targetCids[row],
                                      cache.targetCids[0])):
            err = " semantic snapshot fragment cache: mixed build identity"
            return false
    if !layout.FixedBytes32Equal(
            incrementalFunctionFragmentCacheCid(cache), cache.cacheCid):
        err = " semantic snapshot fragment cache: cache receipt mismatch"
        return false
    return true

fn SemanticSnapshotFunctionFragmentCacheAppendInto(
        cache: var SemanticSnapshotFunctionFragmentCache,
        functionSymbolCid: layout.FixedBytes32,
        bodyContentCid: layout.FixedBytes32,
        functionInterfaceCid: layout.FixedBytes32,
        exactReadSetCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        compilerCid: layout.FixedBytes32,
        targetCid: layout.FixedBytes32,
        wholeFunctionPayload: str,
        err: var str): bool =
    err = ""
    if incrementalCidObserved(cache.cacheCid):
        err = " semantic snapshot fragment cache: append after seal"
        return false
    if !incrementalFunctionFragmentCacheColumnsAligned(cache):
        err = " semantic snapshot fragment cache: append shape mismatch"
        return false
    if !incrementalCidObserved(functionSymbolCid) ||
       !incrementalCidObserved(bodyContentCid) ||
       !incrementalCidObserved(functionInterfaceCid) ||
       !incrementalCidObserved(exactReadSetCid) ||
       !incrementalCidObserved(schemaCid) ||
       !incrementalCidObserved(compilerCid) ||
       !incrementalCidObserved(targetCid) ||
       wholeFunctionPayload.len <= 0:
        err = " semantic snapshot fragment cache: invalid append input"
        return false
    let keyCid = SemanticSnapshotFunctionFragmentCacheKey(
        functionSymbolCid, bodyContentCid,
        functionInterfaceCid,
        exactReadSetCid, schemaCid, compilerCid, targetCid)
    if cache.keyCids.len > 0 &&
       !incrementalCidLess(cache.keyCids[cache.keyCids.len - 1], keyCid):
        err = " semantic snapshot fragment cache: append key order mismatch"
        return false
    add(cache.functionSymbolCids, functionSymbolCid)
    add(cache.keyCids, keyCid)
    add(cache.fragmentCids,
        SemanticSnapshotFunctionFragmentCid(wholeFunctionPayload))
    add(cache.bodyContentCids, bodyContentCid)
    add(cache.functionInterfaceCids, functionInterfaceCid)
    add(cache.exactReadSetCids, exactReadSetCid)
    add(cache.schemaCids, schemaCid)
    add(cache.compilerCids, compilerCid)
    add(cache.targetCids, targetCid)
    add(cache.payloadByteLengths, wholeFunctionPayload.len)
    add(cache.payloads, wholeFunctionPayload)
    return true

fn SemanticSnapshotFunctionFragmentCacheSealInto(
        cache: var SemanticSnapshotFunctionFragmentCache,
        err: var str): bool =
    err = ""
    if incrementalCidObserved(cache.cacheCid):
        err = " semantic snapshot fragment cache: duplicate seal"
        return false
    if !incrementalFunctionFragmentCacheColumnsAligned(cache):
        err = " semantic snapshot fragment cache: seal shape mismatch"
        return false
    cache.cacheCid = incrementalFunctionFragmentCacheCid(cache)
    return SemanticSnapshotFunctionFragmentCacheStrictValidateInto(
        cache, err)

fn incrementalFunctionFragmentCacheClone(
        cache: SemanticSnapshotFunctionFragmentCache):
        SemanticSnapshotFunctionFragmentCache =
    var out: SemanticSnapshotFunctionFragmentCache
    for row in 0..<cache.keyCids.len:
        add(out.functionSymbolCids, cache.functionSymbolCids[row])
        add(out.keyCids, cache.keyCids[row])
        add(out.fragmentCids, cache.fragmentCids[row])
        add(out.bodyContentCids, cache.bodyContentCids[row])
        add(out.functionInterfaceCids, cache.functionInterfaceCids[row])
        add(out.exactReadSetCids, cache.exactReadSetCids[row])
        add(out.schemaCids, cache.schemaCids[row])
        add(out.compilerCids, cache.compilerCids[row])
        add(out.targetCids, cache.targetCids[row])
        add(out.payloadByteLengths, cache.payloadByteLengths[row])
        add(out.payloads, cache.payloads[row])
    out.cacheCid = cache.cacheCid
    return out

fn incrementalFunctionFragmentDecodedIndexCapacity(
        functionCount: int32): int32 =
    var capacity: int32 = 1
    while capacity < functionCount * 2:
        capacity = capacity * 2
    return capacity

fn incrementalFunctionFragmentDecodedBucket(
        fragmentCid: layout.FixedBytes32,
        capacity: int32): int32 =
    let prefix = Int32(fragmentCid.data[0]) * 65536 +
        Int32(fragmentCid.data[1]) * 256 +
        Int32(fragmentCid.data[2])
    return prefix % capacity

fn incrementalFunctionFragmentDecodedIndexFindInto(
        registry: SemanticSnapshotDecodedFunctionFragmentRegistry,
        fragmentCid: layout.FixedBytes32,
        slotOut: var int32,
        rowOut: var int32,
        err: var str): bool =
    slotOut = -1
    rowOut = -1
    let capacity = registry.decodedIndexSlots.len
    if capacity <= 0 || !incrementalCidObserved(fragmentCid):
        err = " semantic snapshot fragment registry: invalid decoded lookup"
        return false
    let start = incrementalFunctionFragmentDecodedBucket(
        fragmentCid, capacity)
    for probe in 0..<capacity:
        let slot = (start + probe) % capacity
        let row = registry.decodedIndexSlots[slot]
        if row < 0:
            slotOut = slot
            return true
        if row >= registry.decodedFragmentCids.len:
            err = " semantic snapshot fragment registry: decoded index corrupt"
            return false
        if layout.FixedBytes32Equal(
                registry.decodedFragmentCids[row], fragmentCid):
            slotOut = slot
            rowOut = row
            return true
    err = " semantic snapshot fragment registry: decoded index full"
    return false

fn incrementalFunctionFragmentCacheFind(
        cache: SemanticSnapshotFunctionFragmentCache,
        keyCid: layout.FixedBytes32): int32 =
    var low: int32
    var high = cache.keyCids.len
    while low < high:
        let middle = low + (high - low) / 2
        if incrementalCidLess(cache.keyCids[middle], keyCid):
            low = middle + 1
        else:
            high = middle
    if low < cache.keyCids.len &&
       layout.FixedBytes32Equal(cache.keyCids[low], keyCid):
        return low
    return -1

fn incrementalFunctionFragmentCanonicalPayload(
        decoded: fragment_codec.TypedExprIrFunctionFragment): str =
    var canonical =
        fragment_codec.TypedExprIrFunctionFragmentEncode(decoded)
    let out = rawbytes.BytesToString(canonical)
    rawbytes.BytesFree(canonical)
    return out

fn incrementalFunctionFragmentStrictDecodeInto(
        payload: str,
        decodedOut: var fragment_codec.TypedExprIrFunctionFragment,
        canonicalPayloadOut: var str) =
    # BytesFromString is a borrowed view into payload and must not be freed.
    let encoded = rawbytes.BytesFromString(payload)
    var cursor: int32
    let decoded = fragment_codec.TypedExprIrFunctionFragmentDecode(
        encoded, cursor)
    if cursor != rawbytes.BytesLen(encoded):
        panic("semantic_snapshot_fragment_registry_trailing_bytes")
    let canonicalPayload =
        incrementalFunctionFragmentCanonicalPayload(decoded)
    let canonical = rawbytes.BytesFromString(canonicalPayload)
    if !rawbytes.BytesEqual(encoded, canonical):
        panic("semantic_snapshot_fragment_registry_noncanonical_payload")
    decodedOut = decoded
    canonicalPayloadOut = canonicalPayload

fn incrementalWorkspaceFunctionFragmentOwnerCid(
        workspaceSessionCid: layout.FixedBytes32,
        cacheCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        compilerCid: layout.FixedBytes32,
        targetCid: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.workspace_fragment_owner")
    incrementalAppendCid(buf, workspaceSessionCid)
    incrementalAppendCid(buf, cacheCid)
    incrementalAppendCid(buf, schemaCid)
    incrementalAppendCid(buf, compilerCid)
    incrementalAppendCid(buf, targetCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn incrementalWorkspaceFunctionFragmentOwnerShapeValid(
        owner: SemanticSnapshotWorkspaceFunctionFragmentOwner): bool =
    return owner.valid && owner.validationCount == 1 &&
        owner.decodeCount >= 0 &&
        owner.decodeCount == owner.decodedFragmentCids.len &&
        owner.decodeCount == owner.decodedCacheRowIds.len &&
        owner.decodeCount == owner.decodedFragments.len &&
        owner.decodeCount == owner.decodedCanonicalPayloads.len &&
        incrementalCidObserved(owner.workspaceSessionCid) &&
        incrementalCidObserved(owner.ownerCid) &&
        incrementalCidObserved(owner.schemaCid) &&
        incrementalCidObserved(owner.compilerCid) &&
        incrementalCidObserved(owner.targetCid) &&
        incrementalCidObserved(owner.validatedCacheCid) &&
        incrementalFunctionFragmentCacheColumnsAligned(owner.cache) &&
        layout.FixedBytes32Equal(owner.cache.cacheCid,
                                 owner.validatedCacheCid) &&
        owner.decodedIndexSlots.len > owner.decodeCount

fn incrementalWorkspaceFunctionFragmentDecodedIndexFindInto(
        owner: SemanticSnapshotWorkspaceFunctionFragmentOwner,
        fragmentCid: layout.FixedBytes32,
        slotOut: var int32,
        rowOut: var int32,
        err: var str): bool =
    slotOut = -1
    rowOut = -1
    let capacity = owner.decodedIndexSlots.len
    if capacity <= 0 || !incrementalCidObserved(fragmentCid):
        err = " semantic snapshot workspace fragment owner: invalid decoded lookup"
        return false
    let start = incrementalFunctionFragmentDecodedBucket(
        fragmentCid, capacity)
    for probe in 0..<capacity:
        let slot = (start + probe) % capacity
        let row = owner.decodedIndexSlots[slot]
        if row < 0:
            slotOut = slot
            return true
        if row >= owner.decodedFragmentCids.len:
            err = " semantic snapshot workspace fragment owner: decoded index corrupt"
            return false
        if layout.FixedBytes32Equal(
                owner.decodedFragmentCids[row], fragmentCid):
            slotOut = slot
            rowOut = row
            return true
    err = " semantic snapshot workspace fragment owner: decoded index full"
    return false

fn SemanticSnapshotWorkspaceFunctionFragmentOwnerInitInto(
        workspaceSessionCid: layout.FixedBytes32,
        schemaCid: layout.FixedBytes32,
        compilerCid: layout.FixedBytes32,
        targetCid: layout.FixedBytes32,
        expectedCacheCid: layout.FixedBytes32,
        cache: SemanticSnapshotFunctionFragmentCache,
        out: var SemanticSnapshotWorkspaceFunctionFragmentOwner,
        err: var str): bool =
    out = SemanticSnapshotWorkspaceFunctionFragmentOwner()
    err = ""
    if !incrementalCidObserved(workspaceSessionCid) ||
       !incrementalCidObserved(schemaCid) ||
       !incrementalCidObserved(compilerCid) ||
       !incrementalCidObserved(targetCid) ||
       !incrementalCidObserved(expectedCacheCid) ||
       !layout.FixedBytes32Equal(cache.cacheCid, expectedCacheCid) ||
       !SemanticSnapshotFunctionFragmentCacheStrictValidateInto(
           cache, err):
        if err == "":
            err = " semantic snapshot workspace fragment owner: invalid init"
        return false
    for cacheRow in 0..<cache.keyCids.len:
        if !layout.FixedBytes32Equal(
                cache.schemaCids[cacheRow], schemaCid) ||
           !layout.FixedBytes32Equal(
                cache.compilerCids[cacheRow], compilerCid) ||
           !layout.FixedBytes32Equal(
                cache.targetCids[cacheRow], targetCid):
            err = " semantic snapshot workspace fragment owner: build identity mismatch"
            return false
    var owner: SemanticSnapshotWorkspaceFunctionFragmentOwner
    owner.valid = true
    owner.workspaceSessionCid = workspaceSessionCid
    owner.schemaCid = schemaCid
    owner.compilerCid = compilerCid
    owner.targetCid = targetCid
    owner.cache = incrementalFunctionFragmentCacheClone(cache)
    owner.validatedCacheCid = expectedCacheCid
    owner.validationCount = 1
    owner.ownerCid = incrementalWorkspaceFunctionFragmentOwnerCid(
        workspaceSessionCid, expectedCacheCid,
        schemaCid, compilerCid, targetCid)
    let capacity = incrementalFunctionFragmentDecodedIndexCapacity(
        cache.keyCids.len + 1)
    for slot in 0..<capacity:
        add(owner.decodedIndexSlots, -1)
    if !incrementalWorkspaceFunctionFragmentOwnerShapeValid(owner):
        err = " semantic snapshot workspace fragment owner: init shape drift"
        return false
    out = owner
    return true

fn SemanticSnapshotWorkspaceFunctionFragmentOwnerStrictValidateInto(
        owner: SemanticSnapshotWorkspaceFunctionFragmentOwner,
        err: var str): bool =
    err = ""
    if !incrementalWorkspaceFunctionFragmentOwnerShapeValid(owner) ||
       !SemanticSnapshotFunctionFragmentCacheStrictValidateInto(
           owner.cache, err) ||
       !layout.FixedBytes32Equal(
           incrementalWorkspaceFunctionFragmentOwnerCid(
               owner.workspaceSessionCid, owner.validatedCacheCid,
               owner.schemaCid, owner.compilerCid, owner.targetCid),
           owner.ownerCid):
        if err == "":
            err = " semantic snapshot workspace fragment owner: identity drift"
        return false
    for decodedRow in 0..<owner.decodedFragmentCids.len:
        let cacheRow = owner.decodedCacheRowIds[decodedRow]
        if !incrementalFunctionFragmentCacheRowStrictValidateInto(
                owner.cache, cacheRow, err) ||
           !layout.FixedBytes32Equal(
               owner.cache.fragmentCids[cacheRow],
               owner.decodedFragmentCids[decodedRow]) ||
           owner.cache.payloads[cacheRow] !=
               owner.decodedCanonicalPayloads[decodedRow]:
            if err == "":
                err = " semantic snapshot workspace fragment owner: decoded cache row drift"
            return false
        let canonicalPayload =
            incrementalFunctionFragmentCanonicalPayload(
                owner.decodedFragments[decodedRow])
        if canonicalPayload != owner.decodedCanonicalPayloads[decodedRow] ||
           !layout.FixedBytes32Equal(
               SemanticSnapshotFunctionFragmentCid(canonicalPayload),
               owner.decodedFragmentCids[decodedRow]):
            err = " semantic snapshot workspace fragment owner: decoded payload drift"
            return false
        var slot: int32
        var foundRow: int32
        if !incrementalWorkspaceFunctionFragmentDecodedIndexFindInto(
                owner, owner.decodedFragmentCids[decodedRow],
                slot, foundRow, err) || foundRow != decodedRow:
            if err == "":
                err = " semantic snapshot workspace fragment owner: decoded index mismatch"
            return false
    return true

fn incrementalWorkspaceFunctionFragmentDecodedRowInto(
        owner: var SemanticSnapshotWorkspaceFunctionFragmentOwner,
        cacheRow: int32,
        decodedRowOut: var int32,
        newlyDecodedOut: var bool,
        err: var str): bool =
    decodedRowOut = -1
    newlyDecodedOut = false
    if !incrementalWorkspaceFunctionFragmentOwnerShapeValid(owner) ||
       !incrementalFunctionFragmentCacheRowStrictValidateInto(
           owner.cache, cacheRow, err):
        if err == "":
            err = " semantic snapshot workspace fragment owner: invalid cache row"
        return false
    let fragmentCid = owner.cache.fragmentCids[cacheRow]
    var slot: int32
    var decodedRow: int32
    if !incrementalWorkspaceFunctionFragmentDecodedIndexFindInto(
            owner, fragmentCid, slot, decodedRow, err):
        return false
    if decodedRow < 0:
        var decoded: fragment_codec.TypedExprIrFunctionFragment
        var canonicalPayload: str
        incrementalFunctionFragmentStrictDecodeInto(
            owner.cache.payloads[cacheRow], decoded, canonicalPayload)
        decodedRow = owner.decodedFragmentCids.len
        add(owner.decodedFragmentCids, fragmentCid)
        add(owner.decodedCacheRowIds, cacheRow)
        add(owner.decodedFragments, decoded)
        add(owner.decodedCanonicalPayloads, canonicalPayload)
        owner.decodedIndexSlots[slot] = decodedRow
        owner.decodeCount = owner.decodeCount + 1
        newlyDecodedOut = true
    decodedRowOut = decodedRow
    return true

fn incrementalFunctionFragmentRegistryShapeValid(
        registry: SemanticSnapshotDecodedFunctionFragmentRegistry): bool =
    return registry.valid && registry.functionCount > 0 &&
        registry.nextFunctionId >= 0 &&
        registry.nextFunctionId <= registry.functionCount &&
        registry.visitCount == registry.nextFunctionId &&
        registry.visitCount >= 0 && registry.lowerCount >= 0 &&
        registry.decodeCount >= 0 && registry.reuseCount >= 0 &&
        registry.cacheHitCount >= 0 &&
        registry.rebuildCount >= 0 &&
        registry.cacheHitCount + registry.rebuildCount ==
            registry.visitCount &&
        registry.decodeCount + registry.reuseCount ==
            registry.cacheHitCount &&
        registry.lowerCount <= registry.rebuildCount &&
        registry.functionCount == registry.functionSymbolCids.len &&
        registry.functionCount == registry.functionKeyCids.len &&
        registry.functionCount == registry.admissionKinds.len &&
        registry.functionCount == registry.cacheRowIds.len &&
        registry.functionCount == registry.decodedRowIds.len &&
        registry.functionCount == registry.lowerCounts.len &&
        registry.functionCount == registry.rebuiltFragmentCids.len &&
        registry.functionCount == registry.rebuiltFragments.len &&
        registry.functionCount == registry.rebuiltCanonicalPayloads.len &&
        incrementalCidObserved(registry.candidateCid) &&
        incrementalCidObserved(registry.workspaceOwnerCid) &&
        registry.sourceVersion > 0 &&
        incrementalCidObserved(registry.factsCid) &&
        incrementalCidObserved(registry.finalizedReadSetReceiptCid) &&
        incrementalCidObserved(registry.schemaCid) &&
        incrementalCidObserved(registry.compilerCid) &&
        incrementalCidObserved(registry.targetCid) &&
        incrementalCidObserved(registry.cacheCid) &&
        registry.decodeCount <= registry.decodedFragmentCids.len &&
        registry.decodedFragmentCids.len <= registry.cacheHitCount &&
        registry.decodedIndexSlots.len >
            registry.decodedFragmentCids.len

@borrows
fn SemanticSnapshotDecodedFunctionFragmentRegistryInitInto(
        candidateCid: layout.FixedBytes32,
        functionCount: int32,
        sourceVersion: int64,
        factsCid: layout.FixedBytes32,
        finalizedReadSetReceiptCid: layout.FixedBytes32,
        workspaceOwner: SemanticSnapshotWorkspaceFunctionFragmentOwner,
        out: var SemanticSnapshotDecodedFunctionFragmentRegistry,
        err: var str): bool =
    err = ""
    out = SemanticSnapshotDecodedFunctionFragmentRegistry()
    if !incrementalCidObserved(candidateCid) ||
       functionCount <= 0 || functionCount > 536870911 ||
       sourceVersion <= 0 ||
       !incrementalCidObserved(factsCid) ||
       !incrementalCidObserved(finalizedReadSetReceiptCid) ||
       !incrementalWorkspaceFunctionFragmentOwnerShapeValid(
           workspaceOwner):
        if err == "":
            err = " semantic snapshot fragment registry: invalid init"
        return false
    var registry: SemanticSnapshotDecodedFunctionFragmentRegistry
    registry.valid = true
    registry.candidateCid = candidateCid
    registry.workspaceOwnerCid = workspaceOwner.ownerCid
    registry.sourceVersion = sourceVersion
    registry.factsCid = factsCid
    registry.finalizedReadSetReceiptCid =
        finalizedReadSetReceiptCid
    registry.schemaCid = workspaceOwner.schemaCid
    registry.compilerCid = workspaceOwner.compilerCid
    registry.targetCid = workspaceOwner.targetCid
    registry.cacheCid = workspaceOwner.validatedCacheCid
    registry.functionCount = functionCount
    for functionId in 0..<functionCount:
        add(registry.functionSymbolCids, layout.FixedBytes32())
        add(registry.functionKeyCids, layout.FixedBytes32())
        add(registry.admissionKinds,
            SemanticSnapshotFunctionFragmentAdmissionUnknown)
        add(registry.cacheRowIds, -1)
        add(registry.decodedRowIds, -1)
        add(registry.lowerCounts, 0)
        add(registry.rebuiltFragmentCids, layout.FixedBytes32())
        add(registry.rebuiltFragments,
            fragment_codec.TypedExprIrFunctionFragment())
        add(registry.rebuiltCanonicalPayloads, "")
    let capacity = incrementalFunctionFragmentDecodedIndexCapacity(
        functionCount)
    for slot in 0..<capacity:
        add(registry.decodedIndexSlots, -1)
    if !incrementalFunctionFragmentRegistryShapeValid(registry):
        err = " semantic snapshot fragment registry: init shape drift"
        return false
    out = registry
    return true

@borrows
fn SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
        current: SemanticSnapshotIncrementalPrebuildFacts,
        finalized: SemanticSnapshotIncrementalFinalizedReadSet,
        workspaceOwner: var SemanticSnapshotWorkspaceFunctionFragmentOwner,
        registry: var SemanticSnapshotDecodedFunctionFragmentRegistry,
        input: SemanticSnapshotFunctionFragmentAdmissionInput,
        out: var SemanticSnapshotFunctionFragmentAdmission,
        err: var str): bool =
    err = ""
    out = SemanticSnapshotFunctionFragmentAdmission()
    let functionId = input.functionId
    let functionSymbolCid = input.functionSymbolCid
    let bodyContentCid = input.bodyContentCid
    let functionInterfaceCid = input.functionInterfaceCid
    let exactReadSetCid = input.exactReadSetCid
    if !incrementalFunctionFragmentRegistryShapeValid(registry) ||
       !incrementalWorkspaceFunctionFragmentOwnerShapeValid(
           workspaceOwner) ||
       !SemanticSnapshotFunctionFragmentAdmissionInputStrictValidateInto(
           current, finalized, input, err) ||
       input.sourceVersion != registry.sourceVersion ||
       !layout.FixedBytes32Equal(input.factsCid, registry.factsCid) ||
       !layout.FixedBytes32Equal(
           input.finalizedReadSetReceiptCid,
           registry.finalizedReadSetReceiptCid) ||
       !layout.FixedBytes32Equal(
           registry.workspaceOwnerCid, workspaceOwner.ownerCid) ||
       !layout.FixedBytes32Equal(
           registry.cacheCid, workspaceOwner.validatedCacheCid) ||
       !layout.FixedBytes32Equal(
           registry.schemaCid, workspaceOwner.schemaCid) ||
       !layout.FixedBytes32Equal(
           registry.compilerCid, workspaceOwner.compilerCid) ||
       !layout.FixedBytes32Equal(
           registry.targetCid, workspaceOwner.targetCid) ||
       functionId != registry.nextFunctionId ||
       !incrementalCidObserved(functionSymbolCid) ||
       !incrementalCidObserved(bodyContentCid) ||
       !incrementalCidObserved(functionInterfaceCid) ||
       !incrementalCidObserved(exactReadSetCid):
        err = " semantic snapshot fragment registry: non-monotonic or invalid visit"
        return false
    if functionId > 0 &&
       !incrementalCidLess(
           registry.functionSymbolCids[functionId - 1],
           functionSymbolCid):
        err = " semantic snapshot fragment registry: function identity order mismatch"
        return false
    let keyCid = SemanticSnapshotFunctionFragmentCacheKey(
        functionSymbolCid, bodyContentCid,
        functionInterfaceCid,
        exactReadSetCid, registry.schemaCid,
        registry.compilerCid, registry.targetCid)
    let cacheRow = incrementalFunctionFragmentCacheFind(
        workspaceOwner.cache, keyCid)
    var kind = SemanticSnapshotFunctionFragmentAdmissionWholeRebuild
    var fragmentCid: layout.FixedBytes32
    var decodedRow = -1
    var newlyDecoded = false
    if cacheRow >= 0:
        if !incrementalFunctionFragmentCacheRowStrictValidateInto(
                workspaceOwner.cache, cacheRow, err) ||
           !layout.FixedBytes32Equal(
               workspaceOwner.cache.functionSymbolCids[cacheRow],
               functionSymbolCid) ||
           !layout.FixedBytes32Equal(
               workspaceOwner.cache.bodyContentCids[cacheRow],
               bodyContentCid) ||
           !layout.FixedBytes32Equal(
               workspaceOwner.cache.functionInterfaceCids[cacheRow],
               functionInterfaceCid) ||
           !layout.FixedBytes32Equal(
               workspaceOwner.cache.exactReadSetCids[cacheRow],
               exactReadSetCid) ||
           !layout.FixedBytes32Equal(
               workspaceOwner.cache.schemaCids[cacheRow],
               registry.schemaCid) ||
           !layout.FixedBytes32Equal(
               workspaceOwner.cache.compilerCids[cacheRow],
               registry.compilerCid) ||
           !layout.FixedBytes32Equal(
               workspaceOwner.cache.targetCids[cacheRow],
               registry.targetCid):
            if err == "":
                err = " semantic snapshot fragment registry: cache admission identity mismatch"
            return false
        fragmentCid = workspaceOwner.cache.fragmentCids[cacheRow]
        var candidateSlot: int32
        var candidateDecodedRow: int32
        if !incrementalFunctionFragmentDecodedIndexFindInto(
                registry, fragmentCid, candidateSlot,
                candidateDecodedRow, err):
            return false
        if !incrementalWorkspaceFunctionFragmentDecodedRowInto(
                workspaceOwner, cacheRow, decodedRow,
                newlyDecoded, err):
            return false
        if candidateDecodedRow < 0:
            candidateDecodedRow = registry.decodedFragmentCids.len
            add(registry.decodedFragmentCids, fragmentCid)
            registry.decodedIndexSlots[candidateSlot] =
                candidateDecodedRow
        kind = SemanticSnapshotFunctionFragmentAdmissionCacheHit
    if newlyDecoded:
        registry.decodeCount = registry.decodeCount + 1
    registry.functionSymbolCids[functionId] = functionSymbolCid
    registry.functionKeyCids[functionId] = keyCid
    registry.admissionKinds[functionId] = kind
    registry.cacheRowIds[functionId] = cacheRow
    registry.decodedRowIds[functionId] = decodedRow
    registry.nextFunctionId = registry.nextFunctionId + 1
    registry.visitCount = registry.visitCount + 1
    if kind == SemanticSnapshotFunctionFragmentAdmissionCacheHit:
        registry.cacheHitCount = registry.cacheHitCount + 1
        if !newlyDecoded:
            registry.reuseCount = registry.reuseCount + 1
    else:
        registry.rebuildCount = registry.rebuildCount + 1
    out.functionId = functionId
    out.kind = kind
    out.cacheRowId = cacheRow
    out.decodedRowId = decodedRow
    out.keyCid = keyCid
    out.fragmentCid = fragmentCid
    return true

@borrows
fn SemanticSnapshotFunctionFragmentWholeRebuildInto(
        registry: var SemanticSnapshotDecodedFunctionFragmentRegistry,
        functionId: int32,
        wholeFunctionPayload: str,
        fragmentCidOut: var layout.FixedBytes32,
        err: var str): bool =
    err = ""
    fragmentCidOut = layout.FixedBytes32()
    if !incrementalFunctionFragmentRegistryShapeValid(registry) ||
       functionId < 0 || functionId >= registry.nextFunctionId ||
       registry.admissionKinds[functionId] !=
           SemanticSnapshotFunctionFragmentAdmissionWholeRebuild ||
       registry.lowerCounts[functionId] != 0 ||
       incrementalCidObserved(
           registry.rebuiltFragmentCids[functionId]) ||
       wholeFunctionPayload.len <= 0:
        err = " semantic snapshot fragment registry: whole-function rebuild required exactly once"
        return false
    var decoded: fragment_codec.TypedExprIrFunctionFragment
    var canonicalPayload: str
    incrementalFunctionFragmentStrictDecodeInto(
        wholeFunctionPayload, decoded, canonicalPayload)
    let fragmentCid = SemanticSnapshotFunctionFragmentCid(
        canonicalPayload)
    registry.lowerCounts[functionId] = 1
    registry.rebuiltFragmentCids[functionId] = fragmentCid
    registry.rebuiltFragments[functionId] = decoded
    registry.rebuiltCanonicalPayloads[functionId] = canonicalPayload
    registry.lowerCount = registry.lowerCount + 1
    fragmentCidOut = fragmentCid
    return true

fn incrementalFunctionFragmentRegistryCompleteStrictValidateInto(
        workspaceOwner: SemanticSnapshotWorkspaceFunctionFragmentOwner,
        registry: SemanticSnapshotDecodedFunctionFragmentRegistry,
        err: var str): bool =
    err = ""
    if !incrementalFunctionFragmentRegistryShapeValid(registry) ||
       !SemanticSnapshotWorkspaceFunctionFragmentOwnerStrictValidateInto(
           workspaceOwner, err) ||
       !layout.FixedBytes32Equal(
           registry.workspaceOwnerCid, workspaceOwner.ownerCid) ||
       !layout.FixedBytes32Equal(
           registry.cacheCid, workspaceOwner.validatedCacheCid) ||
       !layout.FixedBytes32Equal(
           registry.schemaCid, workspaceOwner.schemaCid) ||
       !layout.FixedBytes32Equal(
           registry.compilerCid, workspaceOwner.compilerCid) ||
       !layout.FixedBytes32Equal(
           registry.targetCid, workspaceOwner.targetCid) ||
       registry.nextFunctionId != registry.functionCount ||
       registry.visitCount != registry.functionCount ||
       registry.cacheHitCount + registry.rebuildCount !=
           registry.functionCount ||
       registry.lowerCount != registry.rebuildCount ||
       registry.decodeCount + registry.reuseCount !=
           registry.cacheHitCount:
        err = " semantic snapshot fragment registry: incomplete candidate"
        return false
    var hitCount: int32
    var rebuildCount: int32
    var lowerCount: int32
    for functionId in 0..<registry.functionCount:
        if !incrementalCidObserved(
                registry.functionSymbolCids[functionId]) ||
           !incrementalCidObserved(
                registry.functionKeyCids[functionId]):
            err = " semantic snapshot fragment registry: missing function evidence"
            return false
        if functionId > 0 &&
           !incrementalCidLess(
               registry.functionSymbolCids[functionId - 1],
               registry.functionSymbolCids[functionId]):
            err = " semantic snapshot fragment registry: function evidence order mismatch"
            return false
        if registry.admissionKinds[functionId] ==
               SemanticSnapshotFunctionFragmentAdmissionCacheHit:
            let cacheRow = registry.cacheRowIds[functionId]
            let decodedRow = registry.decodedRowIds[functionId]
            if cacheRow < 0 ||
               cacheRow >= workspaceOwner.cache.keyCids.len ||
               decodedRow < 0 ||
               decodedRow >= workspaceOwner.decodedFragmentCids.len ||
               registry.lowerCounts[functionId] != 0 ||
               incrementalCidObserved(
                   registry.rebuiltFragmentCids[functionId]) ||
               registry.rebuiltCanonicalPayloads[functionId] != "" ||
               !layout.FixedBytes32Equal(
                   registry.functionKeyCids[functionId],
                   workspaceOwner.cache.keyCids[cacheRow]) ||
               !layout.FixedBytes32Equal(
                   workspaceOwner.cache.fragmentCids[cacheRow],
                   workspaceOwner.decodedFragmentCids[decodedRow]) ||
               workspaceOwner.cache.payloads[cacheRow] !=
                   workspaceOwner.decodedCanonicalPayloads[decodedRow]:
                err = " semantic snapshot fragment registry: invalid cache-hit evidence"
                return false
            hitCount = hitCount + 1
        elif registry.admissionKinds[functionId] ==
                 SemanticSnapshotFunctionFragmentAdmissionWholeRebuild:
            if registry.cacheRowIds[functionId] != -1 ||
               registry.decodedRowIds[functionId] != -1 ||
               registry.lowerCounts[functionId] != 1 ||
               !incrementalCidObserved(
                   registry.rebuiltFragmentCids[functionId]) ||
               registry.rebuiltCanonicalPayloads[functionId] == "":
                err = " semantic snapshot fragment registry: invalid whole rebuild evidence"
                return false
            let rebuiltCanonicalPayload =
                incrementalFunctionFragmentCanonicalPayload(
                    registry.rebuiltFragments[functionId])
            if rebuiltCanonicalPayload !=
                   registry.rebuiltCanonicalPayloads[functionId] ||
               !layout.FixedBytes32Equal(
                   SemanticSnapshotFunctionFragmentCid(
                       rebuiltCanonicalPayload),
                   registry.rebuiltFragmentCids[functionId]):
                err = " semantic snapshot fragment registry: rebuilt owner drift"
                return false
            rebuildCount = rebuildCount + 1
            lowerCount = lowerCount + 1
        else:
            err = " semantic snapshot fragment registry: unknown admission evidence"
            return false
    for decodedRow in 0..<registry.decodedFragmentCids.len:
        var slot: int32
        var foundRow: int32
        if !incrementalFunctionFragmentDecodedIndexFindInto(
                registry, registry.decodedFragmentCids[decodedRow],
                slot, foundRow, err) || foundRow != decodedRow:
            if err == "":
                err = " semantic snapshot fragment registry: decoded index mismatch"
            return false
        var ownerSlot: int32
        var ownerRow: int32
        if !incrementalWorkspaceFunctionFragmentDecodedIndexFindInto(
                workspaceOwner,
                registry.decodedFragmentCids[decodedRow],
                ownerSlot, ownerRow, err) || ownerRow < 0:
            if err == "":
                err = " semantic snapshot fragment registry: workspace decoded row missing"
            return false
    if hitCount != registry.cacheHitCount ||
       rebuildCount != registry.rebuildCount ||
       lowerCount != registry.lowerCount ||
       registry.decodeCount + registry.reuseCount !=
           registry.cacheHitCount:
        err = " semantic snapshot fragment registry: candidate counters drift"
        return false
    return true

fn incrementalFunctionFragmentCandidateReceiptCid(
        registry: SemanticSnapshotDecodedFunctionFragmentRegistry,
        receipt: SemanticSnapshotFunctionFragmentCandidateReceipt):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(512 + registry.functionCount * 160)
    incrementalAppendText(
        buf, "cheng.semantic_snapshot.function_fragment_candidate_receipt")
    incrementalAppendCid(buf, receipt.candidateCid)
    incrementalAppendCid(buf, receipt.workspaceOwnerCid)
    incrementalAppendI64(buf, receipt.sourceVersion)
    incrementalAppendCid(buf, receipt.factsCid)
    incrementalAppendCid(buf, receipt.finalizedReadSetReceiptCid)
    incrementalAppendCid(buf, receipt.cacheCid)
    incrementalAppendCid(buf, receipt.schemaCid)
    incrementalAppendCid(buf, receipt.compilerCid)
    incrementalAppendCid(buf, receipt.targetCid)
    incrementalAppendU32(buf, receipt.functionCount)
    incrementalAppendU32(buf, receipt.visitCount)
    incrementalAppendU32(buf, receipt.lowerCount)
    incrementalAppendU32(buf, receipt.cacheHitCount)
    incrementalAppendU32(buf, receipt.rebuildCount)
    incrementalAppendU32(buf, receipt.decodeCount)
    incrementalAppendU32(buf, receipt.reuseCount)
    incrementalAppendU32(buf, receipt.uniqueDecodedFragmentCount)
    for functionId in 0..<registry.functionCount:
        incrementalAppendU32(buf, functionId)
        incrementalAppendCid(buf, registry.functionSymbolCids[functionId])
        incrementalAppendCid(buf, registry.functionKeyCids[functionId])
        incrementalAppendU32(buf, registry.admissionKinds[functionId])
        incrementalAppendU32(buf, registry.cacheRowIds[functionId])
        incrementalAppendU32(buf, registry.decodedRowIds[functionId])
        incrementalAppendU32(buf, registry.lowerCounts[functionId])
        incrementalAppendCid(
            buf, registry.rebuiltFragmentCids[functionId])
    incrementalAppendU32(buf, registry.decodedFragmentCids.len)
    for decodedRow in 0..<registry.decodedFragmentCids.len:
        incrementalAppendCid(
            buf, registry.decodedFragmentCids[decodedRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn SemanticSnapshotFunctionFragmentCandidateReceiptStrictValidateInto(
        workspaceOwner: SemanticSnapshotWorkspaceFunctionFragmentOwner,
        registry: SemanticSnapshotDecodedFunctionFragmentRegistry,
        receipt: SemanticSnapshotFunctionFragmentCandidateReceipt,
        err: var str): bool =
    if !incrementalFunctionFragmentRegistryCompleteStrictValidateInto(
            workspaceOwner, registry, err):
        return false
    if !receipt.valid ||
       !layout.FixedBytes32Equal(receipt.candidateCid,
                                 registry.candidateCid) ||
       !layout.FixedBytes32Equal(receipt.workspaceOwnerCid,
                                 registry.workspaceOwnerCid) ||
       receipt.sourceVersion != registry.sourceVersion ||
       !layout.FixedBytes32Equal(receipt.factsCid,
                                 registry.factsCid) ||
       !layout.FixedBytes32Equal(
           receipt.finalizedReadSetReceiptCid,
           registry.finalizedReadSetReceiptCid) ||
       !layout.FixedBytes32Equal(receipt.cacheCid,
                                 registry.cacheCid) ||
       !layout.FixedBytes32Equal(receipt.schemaCid,
                                 registry.schemaCid) ||
       !layout.FixedBytes32Equal(receipt.compilerCid,
                                 registry.compilerCid) ||
       !layout.FixedBytes32Equal(receipt.targetCid,
                                 registry.targetCid) ||
       receipt.functionCount != registry.functionCount ||
       receipt.visitCount != registry.visitCount ||
       receipt.lowerCount != registry.lowerCount ||
       receipt.cacheHitCount != registry.cacheHitCount ||
       receipt.rebuildCount != registry.rebuildCount ||
       receipt.decodeCount != registry.decodeCount ||
       receipt.reuseCount != registry.reuseCount ||
       receipt.uniqueDecodedFragmentCount !=
           registry.decodedFragmentCids.len ||
       !layout.FixedBytes32Equal(
           incrementalFunctionFragmentCandidateReceiptCid(
               registry, receipt), receipt.receiptCid):
        err = " semantic snapshot fragment registry: candidate receipt mismatch"
        return false
    err = ""
    return true

@borrows
fn SemanticSnapshotFunctionFragmentCandidateFinalizeInto(
        workspaceOwner: SemanticSnapshotWorkspaceFunctionFragmentOwner,
        registry: SemanticSnapshotDecodedFunctionFragmentRegistry,
        out: var SemanticSnapshotFunctionFragmentCandidateReceipt,
        err: var str): bool =
    out = SemanticSnapshotFunctionFragmentCandidateReceipt()
    if !incrementalFunctionFragmentRegistryCompleteStrictValidateInto(
            workspaceOwner, registry, err):
        return false
    var receipt: SemanticSnapshotFunctionFragmentCandidateReceipt
    receipt.valid = true
    receipt.candidateCid = registry.candidateCid
    receipt.workspaceOwnerCid = registry.workspaceOwnerCid
    receipt.sourceVersion = registry.sourceVersion
    receipt.factsCid = registry.factsCid
    receipt.finalizedReadSetReceiptCid =
        registry.finalizedReadSetReceiptCid
    receipt.cacheCid = registry.cacheCid
    receipt.schemaCid = registry.schemaCid
    receipt.compilerCid = registry.compilerCid
    receipt.targetCid = registry.targetCid
    receipt.functionCount = registry.functionCount
    receipt.visitCount = registry.visitCount
    receipt.lowerCount = registry.lowerCount
    receipt.cacheHitCount = registry.cacheHitCount
    receipt.rebuildCount = registry.rebuildCount
    receipt.decodeCount = registry.decodeCount
    receipt.reuseCount = registry.reuseCount
    receipt.uniqueDecodedFragmentCount =
        registry.decodedFragmentCids.len
    receipt.receiptCid = incrementalFunctionFragmentCandidateReceiptCid(
        registry, receipt)
    if !SemanticSnapshotFunctionFragmentCandidateReceiptStrictValidateInto(
            workspaceOwner, registry, receipt, err):
        return false
    out = receipt
    return true
