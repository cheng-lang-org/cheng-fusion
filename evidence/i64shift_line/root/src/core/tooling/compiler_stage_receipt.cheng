import std/rawbytes
import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const
    CompilerStageReceiptDomain: str = "cheng.compiler.stage_receipt"

    # Parser is an independent prerequisite receipt.  The source-bound compiler
    # protocol remains the seven stages that start at typed_expr.
    CompilerStageReceiptStageParser: str = "parser"
    CompilerStageReceiptStageTypedExpr: str = "typed_expr"
    CompilerStageReceiptStageCsg: str = "csg"
    CompilerStageReceiptStageLowering: str = "lowering"
    CompilerStageReceiptStagePrimary: str = "primary"
    CompilerStageReceiptStagePrimaryRegalloc: str = "primary_regalloc"
    CompilerStageReceiptStageBackend2: str = "backend2"
    CompilerStageReceiptStageBackend2Regalloc: str = "backend2_regalloc"

    CompilerStageReceiptLaneShared: str = "shared"
    CompilerStageReceiptLanePrimary: str = "primary"
    CompilerStageReceiptLaneBackend2: str = "backend2"

type
    # Canonical preimage order is domain, stage, lane, producer identity,
    # predecessor,
    # artifact, count cardinality, then sorted (key, value) rows.  Every item is
    # u32be(payload length) || payload; cardinality payload is u32be and count
    # payload is u64be.  Producers own their stage-specific required key set.
    # Count columns stay SoA: keys and exact signed-domain values have the same
    # row count.  Negative values are rejected before canonicalization.
    CompilerStageReceipt =
        stageKind: str
        laneKind: str
        producerIdentity: str
        predecessorRaw32: layout.FixedBytes32
        artifactRaw32: layout.FixedBytes32
        countKeys: str[]
        countValues: int64[]
        receiptRaw32: layout.FixedBytes32

@borrows
fn CompilerStageReceiptStageKindValid(stageKind: str): bool =
    return stageKind == CompilerStageReceiptStageParser ||
           stageKind == CompilerStageReceiptStageTypedExpr ||
           stageKind == CompilerStageReceiptStageCsg ||
           stageKind == CompilerStageReceiptStageLowering ||
           stageKind == CompilerStageReceiptStagePrimary ||
           stageKind == CompilerStageReceiptStagePrimaryRegalloc ||
           stageKind == CompilerStageReceiptStageBackend2 ||
           stageKind == CompilerStageReceiptStageBackend2Regalloc

@borrows
fn CompilerStageReceiptLaneKindValid(laneKind: str): bool =
    return laneKind == CompilerStageReceiptLaneShared ||
           laneKind == CompilerStageReceiptLanePrimary ||
           laneKind == CompilerStageReceiptLaneBackend2

@borrows
fn CompilerStageReceiptStageLaneValid(stageKind: str,
                                          laneKind: str): bool =
    if stageKind == CompilerStageReceiptStageParser ||
       stageKind == CompilerStageReceiptStageTypedExpr ||
       stageKind == CompilerStageReceiptStageCsg ||
       stageKind == CompilerStageReceiptStageLowering:
        return laneKind == CompilerStageReceiptLaneShared
    if stageKind == CompilerStageReceiptStagePrimary ||
       stageKind == CompilerStageReceiptStagePrimaryRegalloc:
        return laneKind == CompilerStageReceiptLanePrimary
    if stageKind == CompilerStageReceiptStageBackend2 ||
       stageKind == CompilerStageReceiptStageBackend2Regalloc:
        return laneKind == CompilerStageReceiptLaneBackend2
    return false

@borrows
fn compilerStageReceiptCountKeyValid(key: str): bool =
    if len(key) <= 0:
        return false
    let first = Int32(key[0])
    if first < Int32('a') || first > Int32('z'):
        return false
    var previousUnderscore: bool
    for index in 1..<len(key):
        let current = Int32(key[index])
        if current == Int32('_'):
            if previousUnderscore:
                return false
            previousUnderscore = true
        elif (current >= Int32('a') && current <= Int32('z')) ||
             (current >= Int32('0') && current <= Int32('9')):
            previousUnderscore = false
        else:
            return false
    return !previousUnderscore

@borrows
fn compilerStageReceiptCountKeyLess(left: str, right: str): bool =
    let sharedLen = left.len < right.len ? left.len : right.len
    for index in 0..<sharedLen:
        let leftByte = Int32(left[index])
        let rightByte = Int32(right[index])
        if leftByte != rightByte:
            return leftByte < rightByte
    return left.len < right.len

@borrows
fn compilerStageReceiptValidateFields(stageKind: str,
                                        laneKind: str,
                                        producerIdentity: str,
                                        predecessorRaw32: layout.FixedBytes32,
                                        artifactRaw32: layout.FixedBytes32,
                                        countKeys: str[],
                                        countValues: int64[]): Result[bool] =
    if len(stageKind) <= 0:
        return Err[bool](" compiler stage receipt: empty stage kind")
    if !CompilerStageReceiptStageKindValid(stageKind):
        return Err[bool](" compiler stage receipt: invalid stage kind")
    if !CompilerStageReceiptLaneKindValid(laneKind):
        return Err[bool](" compiler stage receipt: invalid lane kind")
    if !CompilerStageReceiptStageLaneValid(stageKind, laneKind):
        return Err[bool](" compiler stage receipt: stage lane mismatch")
    if len(producerIdentity) <= 0 ||
       strutil.Strip(producerIdentity) != producerIdentity:
        return Err[bool](" compiler stage receipt: invalid producer identity")
    for index in 0..<producerIdentity.len:
        let code = Int32(producerIdentity[index]) & 255
        if code < 32 || code == 127:
            return Err[bool](
                " compiler stage receipt: invalid producer identity")
    let zeroRaw32 = layout.FixedBytes32()
    if layout.FixedBytes32Equal(predecessorRaw32, zeroRaw32):
        return Err[bool](" compiler stage receipt: zero predecessor")
    if layout.FixedBytes32Equal(artifactRaw32, zeroRaw32):
        return Err[bool](" compiler stage receipt: zero artifact")
    if countKeys.len <= 0 || countValues.len <= 0:
        return Err[bool](" compiler stage receipt: counts are required")
    if countKeys.len != countValues.len:
        return Err[bool](" compiler stage receipt: count column length mismatch")
    for index in 0..<countKeys.len:
        if !compilerStageReceiptCountKeyValid(countKeys[index]):
            return Err[bool](" compiler stage receipt: invalid count key")
        if countValues[index] < Int64(0):
            return Err[bool](" compiler stage receipt: negative count")
        if index > 0:
            if countKeys[index - 1] == countKeys[index]:
                return Err[bool](" compiler stage receipt: duplicate count key")
            if !compilerStageReceiptCountKeyLess(countKeys[index - 1],
                                                  countKeys[index]):
                return Err[bool](" compiler stage receipt: non-canonical count order")
    return Ok[bool](true)

fn compilerStageReceiptAppendU32BE(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn compilerStageReceiptAppendU64BE(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn compilerStageReceiptAppendTextFrame(buf: var layout.ByteBuf, text: str) =
    compilerStageReceiptAppendU32BE(buf, len(text))
    for index in 0..<len(text):
        layout.ByteBufAppendByte(buf, Int32(text[index]) & 255)

@borrows
fn compilerStageReceiptAppendFixed32Frame(buf: var layout.ByteBuf,
                                           value: layout.FixedBytes32) =
    compilerStageReceiptAppendU32BE(buf, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(buf, value)

fn compilerStageReceiptAppendU32Frame(buf: var layout.ByteBuf, value: int32) =
    compilerStageReceiptAppendU32BE(buf, 4)
    compilerStageReceiptAppendU32BE(buf, value)

fn compilerStageReceiptAppendU64Frame(buf: var layout.ByteBuf, value: int64) =
    compilerStageReceiptAppendU32BE(buf, 8)
    compilerStageReceiptAppendU64BE(buf, value)

@borrows
fn compilerStageReceiptCid(stageKind: str,
                            laneKind: str,
                            producerIdentity: str,
                            predecessorRaw32: layout.FixedBytes32,
                            artifactRaw32: layout.FixedBytes32,
                            countKeys: str[],
                            countValues: int64[]): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    compilerStageReceiptAppendTextFrame(buf, CompilerStageReceiptDomain)
    compilerStageReceiptAppendTextFrame(buf, stageKind)
    compilerStageReceiptAppendTextFrame(buf, laneKind)
    compilerStageReceiptAppendTextFrame(buf, producerIdentity)
    compilerStageReceiptAppendFixed32Frame(buf, predecessorRaw32)
    compilerStageReceiptAppendFixed32Frame(buf, artifactRaw32)
    compilerStageReceiptAppendU32Frame(buf, countKeys.len)
    for index in 0..<countKeys.len:
        compilerStageReceiptAppendTextFrame(buf, countKeys[index])
        compilerStageReceiptAppendU64Frame(buf, countValues[index])
    let digest = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return digest

fn CompilerStageReceiptMake(stageKind: str,
                               laneKind: str,
                               producerIdentity: str,
                               predecessorRaw32: layout.FixedBytes32,
                               artifactRaw32: layout.FixedBytes32,
                               countKeys: str[],
                               countValues: int64[]): Result[CompilerStageReceipt] =
    let validRes = compilerStageReceiptValidateFields(stageKind,
                                                       laneKind,
                                                       producerIdentity,
                                                       predecessorRaw32,
                                                       artifactRaw32,
                                                       countKeys,
                                                       countValues)
    if IsErr(validRes):
        return Err[CompilerStageReceipt](Error(validRes))
    let receiptRaw32 = compilerStageReceiptCid(stageKind,
                                                laneKind,
                                                producerIdentity,
                                                predecessorRaw32,
                                                artifactRaw32,
                                                countKeys,
                                                countValues)
    var out: CompilerStageReceipt
    out.stageKind = stageKind
    out.laneKind = laneKind
    out.producerIdentity = producerIdentity
    out.predecessorRaw32 = predecessorRaw32
    out.artifactRaw32 = artifactRaw32
    setLen(out.countKeys, countKeys.len)
    setLen(out.countValues, countValues.len)
    for index in 0..<countKeys.len:
        out.countKeys[index] = share(countKeys[index])
        out.countValues[index] = countValues[index]
    out.receiptRaw32 = receiptRaw32
    return Ok[CompilerStageReceipt](out)

fn CompilerStageReceiptMakeRaw(stageKind: str,
                                  laneKind: str,
                                  producerIdentity: str,
                                  predecessorRaw32: rawbytes.Bytes,
                                  artifactRaw32: rawbytes.Bytes,
                                  countKeys: str[],
                                  countValues: int64[]): Result[CompilerStageReceipt] =
    if rawbytes.BytesLen(predecessorRaw32) != layout.FixedBytes32Size:
        return Err[CompilerStageReceipt](" compiler stage receipt: predecessor is not raw32")
    if rawbytes.BytesLen(artifactRaw32) != layout.FixedBytes32Size:
        return Err[CompilerStageReceipt](" compiler stage receipt: artifact is not raw32")
    let predecessorRes = layout.FixedBytes32FromBytes(predecessorRaw32)
    if IsErr(predecessorRes):
        return Err[CompilerStageReceipt](" compiler stage receipt: predecessor is not raw32")
    let artifactRes = layout.FixedBytes32FromBytes(artifactRaw32)
    if IsErr(artifactRes):
        return Err[CompilerStageReceipt](" compiler stage receipt: artifact is not raw32")
    return CompilerStageReceiptMake(stageKind,
                                       laneKind,
                                       producerIdentity,
                                       Value(predecessorRes),
                                       Value(artifactRes),
                                       countKeys,
                                       countValues)

@borrows
fn CompilerStageReceiptVerify(receipt: CompilerStageReceipt): Result[bool] =
    let validRes = compilerStageReceiptValidateFields(receipt.stageKind,
                                                       receipt.laneKind,
                                                       receipt.producerIdentity,
                                                       receipt.predecessorRaw32,
                                                       receipt.artifactRaw32,
                                                       receipt.countKeys,
                                                       receipt.countValues)
    if IsErr(validRes):
        return Err[bool](Error(validRes))
    let expected = compilerStageReceiptCid(receipt.stageKind,
                                            receipt.laneKind,
                                            receipt.producerIdentity,
                                            receipt.predecessorRaw32,
                                            receipt.artifactRaw32,
                                            receipt.countKeys,
                                            receipt.countValues)
    if !layout.FixedBytes32Equal(expected, receipt.receiptRaw32):
        return Err[bool](" compiler stage receipt: receipt raw32 mismatch")
    return Ok[bool](true)

fn CompilerStageReceiptVerifyEnvelopeRaw(stageKind: str,
                                            laneKind: str,
                                            producerIdentity: str,
                                            predecessorRaw32: rawbytes.Bytes,
                                            artifactRaw32: rawbytes.Bytes,
                                            countKeys: str[],
                                            countValues: int64[],
                                            receiptRaw32: rawbytes.Bytes): Result[bool] =
    if rawbytes.BytesLen(receiptRaw32) != layout.FixedBytes32Size:
        return Err[bool](" compiler stage receipt: receipt is not raw32")
    let expectedRes = CompilerStageReceiptMakeRaw(stageKind,
                                                     laneKind,
                                                     producerIdentity,
                                                     predecessorRaw32,
                                                     artifactRaw32,
                                                     countKeys,
                                                     countValues)
    if IsErr(expectedRes):
        return Err[bool](Error(expectedRes))
    let observedRes = layout.FixedBytes32FromBytes(receiptRaw32)
    if IsErr(observedRes):
        return Err[bool](" compiler stage receipt: receipt is not raw32")
    if !layout.FixedBytes32Equal(Value(expectedRes).receiptRaw32,
                                 Value(observedRes)):
        return Err[bool](" compiler stage receipt: receipt raw32 mismatch")
    return Ok[bool](true)
