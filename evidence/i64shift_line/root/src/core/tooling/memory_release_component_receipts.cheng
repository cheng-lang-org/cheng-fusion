# Exact adapters from production-owned terminal receipts to the canonical
# memory-release ledger row. This module deliberately sits outside the JSON
# serializer so the lightweight workload wrapper does not import the compiler.

import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/system_link_exec as sexec
import cheng/core/tooling/compiler_payload_lifecycle as compilerlife
import cheng/core/tooling/memory_release_receipt as receipt

fn memoryReleaseComponentFail(message: str) =
    panic(message)

fn memoryReleaseEnteredRowFromCompilerPayload(
        pathKind: str,
        component: str,
        value: compilerlife.CompilerPayloadLifecycleReceipt):
        receipt.MemoryReleaseLedgerRow =
    var row: receipt.MemoryReleaseLedgerRow
    row.pathKind = pathKind
    row.entered = true
    row.receiptKind =
        receipt.MemoryReleaseComponentReceiptKind(component)
    row.producerOperation =
        receipt.MemoryReleaseComponentProducerOperation(component)
    row.component = component
    row.allocated = value.allocated
    row.released = value.released
    row.live = value.live
    row.allocatedBytes = value.allocatedBytes
    row.releasedBytes = value.releasedBytes
    row.liveBytes = value.liveBytes
    row.physicalBufferCount =
        int64(value.physicalBufferCount)
    row.physicalFreeCount = value.physicalFreeCount
    row.storageReleased = value.storageReleased
    row.ledgerStorageReleased =
        value.ledgerStorageReleased
    row.ledgerStorageReleasedSequenceCount =
        int64(value.ledgerStorageReleasedSequenceCount)
    row.ledgerStorageReleasedBufferCount =
        int64(value.ledgerStorageReleasedBufferCount)
    row.ledgerStorageReleasedBytes =
        value.ledgerStorageReleasedBytes
    return row

fn MemoryReleaseUnenteredLedgerRow(
        pathKind: str,
        component: str): receipt.MemoryReleaseLedgerRow =
    var row: receipt.MemoryReleaseLedgerRow
    row.pathKind = pathKind
    row.component = component
    return row

fn MemoryReleaseProductionEntryLedgerRow(
        pathKind: str,
        value: sexec.SystemLinkExecPayloadFinalizeReceipt):
        receipt.MemoryReleaseLedgerRow =
    if value.completed == value.aborted ||
       !value.ownerTableStorageReleased:
        memoryReleaseComponentFail(
            "memory release component: production entry receipt is not terminal")
    return memoryReleaseEnteredRowFromCompilerPayload(
        pathKind,
        receipt.MemoryReleaseComponentProductionEntry(),
        value.ownerTableLifetimeReceipt)

fn MemoryReleaseCompilerCsgLedgerRow(
        pathKind: str,
        value: compilerlife.CompilerPayloadLifecycleReceipt):
        receipt.MemoryReleaseLedgerRow =
    return memoryReleaseEnteredRowFromCompilerPayload(
        pathKind,
        receipt.MemoryReleaseComponentCompilerCsg(),
        value)

fn MemoryReleaseLoweringLedgerRow(
        pathKind: str,
        value: compilerlife.CompilerPayloadLifecycleReceipt):
        receipt.MemoryReleaseLedgerRow =
    return memoryReleaseEnteredRowFromCompilerPayload(
        pathKind,
        receipt.MemoryReleaseComponentLowering(),
        value)

fn MemoryReleaseBodyIrLedgerRow(
        pathKind: str,
        plan: var pobj.PrimaryObjectPlan):
        receipt.MemoryReleaseLedgerRow =
    var row: receipt.MemoryReleaseLedgerRow
    row.pathKind = pathKind
    row.component = receipt.MemoryReleaseComponentBodyIr()
    row.entered = true
    row.receiptKind =
        receipt.MemoryReleaseComponentReceiptKind(row.component)
    row.producerOperation =
        receipt.MemoryReleaseComponentProducerOperation(row.component)
    row.allocated = plan.bodyIrLifecycleAllocated
    row.released = plan.bodyIrLifecycleReleased
    row.live = plan.bodyIrLifecycleLive
    row.allocatedBytes =
        plan.bodyIrLifecycleAllocatedBytes
    row.releasedBytes =
        plan.bodyIrLifecycleReleasedBytes
    row.liveBytes = plan.bodyIrLifecycleLiveBytes
    row.physicalBufferCount =
        plan.bodyIrLifecyclePhysicalBufferCount
    row.physicalFreeCount =
        plan.bodyIrLifecyclePhysicalFreeCount
    row.storageReleased = plan.bodyIrLifecycleAllClosed
    row.ledgerStorageReleased =
        plan.bodyIrLifecycleAllClosed
    row.ledgerStorageReleasedSequenceCount =
        plan.bodyIrLifecycleLedgerStorageReleasedSequenceCount
    row.ledgerStorageReleasedBufferCount =
        plan.bodyIrLifecycleLedgerStorageReleasedBufferCount
    row.ledgerStorageReleasedBytes =
        plan.bodyIrLifecycleLedgerStorageReleasedBytes
    return row

fn MemoryReleasePrimaryLedgerRow(
        pathKind: str,
        value: pobj.PrimaryObjectPlanReleaseReceipt):
        receipt.MemoryReleaseLedgerRow =
    var row: receipt.MemoryReleaseLedgerRow
    row.pathKind = pathKind
    row.component = "primary"
    row.entered = true
    row.receiptKind =
        receipt.MemoryReleaseComponentReceiptKind(row.component)
    row.producerOperation =
        receipt.MemoryReleaseComponentProducerOperation(row.component)
    row.allocated = int64(value.releasedBufferCount)
    row.released = int64(value.releasedBufferCount)
    row.allocatedBytes = value.releasedBytes
    row.releasedBytes = value.releasedBytes
    row.physicalBufferCount =
        int64(value.releasedBufferCount)
    row.physicalFreeCount =
        int64(value.releasedBufferCount)
    row.storageReleased = value.storageReleased
    return row

fn MemoryReleaseBackend2LedgerRow(
        pathKind: str,
        plan: var pobj.PrimaryObjectPlan):
        receipt.MemoryReleaseLedgerRow =
    if !plan.backend2AssemblerTempReceiptReady:
        memoryReleaseComponentFail(
            "memory release component: backend2 assembler receipt unavailable")
    var row: receipt.MemoryReleaseLedgerRow
    row.pathKind = pathKind
    row.component = "backend2"
    row.entered = true
    row.receiptKind =
        receipt.MemoryReleaseComponentReceiptKind(row.component)
    row.producerOperation =
        receipt.MemoryReleaseComponentProducerOperation(row.component)
    row.allocated = plan.backend2AssemblerTempAllocated
    row.released = plan.backend2AssemblerTempReleased
    row.live = plan.backend2AssemblerTempLive
    row.allocatedBytes =
        plan.backend2AssemblerTempAllocatedBytes
    row.releasedBytes =
        plan.backend2AssemblerTempReleasedBytes
    row.liveBytes = plan.backend2AssemblerTempLiveBytes
    row.physicalBufferCount =
        plan.backend2AssemblerTempPhysicalBufferCount
    row.physicalFreeCount =
        plan.backend2AssemblerTempPhysicalFreeCount
    row.storageReleased =
        plan.backend2AssemblerTempRowStorageReleased &&
        plan.backend2AssemblerTempAggregateStorageReleased &&
        plan.backend2AssemblerTempAllSymbolStorageReleased &&
        plan.backend2AssemblerTempWorkerStorageReleased &&
        plan.backend2AssemblerTempWorkerEndpointsClosedAndReaped
    row.ledgerStorageReleased =
        plan.backend2AssemblerTempLedgerStorageReleased
    row.ledgerStorageReleasedSequenceCount =
        plan.backend2AssemblerTempLedgerStorageReleasedSequenceCount
    row.ledgerStorageReleasedBufferCount =
        plan.backend2AssemblerTempLedgerStorageReleasedBufferCount
    row.ledgerStorageReleasedBytes =
        plan.backend2AssemblerTempLedgerStorageReleasedBytes
    return row
