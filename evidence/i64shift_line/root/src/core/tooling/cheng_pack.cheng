import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/cheng_lock as clock
import cheng/core/tooling/package_resolve as presolve
import cheng/core/tooling/toml_parse as toml
import cheng/core/tooling/host_ops as hostops
import cheng/core/tooling/registry as reg
import cheng/core/tooling/world_resolver as wresolver
import cheng/std/bytes_layout as layout

// Scaffold a new project directory with cheng-package.toml + src/ + tests/
fn ChengPackNew(name: str, dir: str): Result[str] =
    if !chengpath.PathCreateDirAll(dir):
        return Err[str](strutil.Join([" cheng pack new: failed to create dir: ", dir], ""))

    let srcDir = os.JoinPath(dir, "src")
    if !chengpath.PathCreateDirAll(srcDir):
        return Err[str](strutil.Join([" cheng pack new: failed to create src dir: ", srcDir], ""))

    let testDir = os.JoinPath(dir, "tests")
    if !chengpath.PathCreateDirAll(testDir):
        return Err[str](strutil.Join([" cheng pack new: failed to create tests dir: ", testDir], ""))

    // Write cheng-package.toml manifest
    var manifest = ""
    manifest = strutil.Join([manifest, "[package]\n"], "")
    manifest = strutil.Join([manifest, "name = \"", name, "\"\n"], "")
    manifest = strutil.Join([manifest, "version = \"0.1.0\"\n"], "")
    manifest = strutil.Join([manifest, "\n[dependencies]\n"], "")

    let manifestPath = os.JoinPath(dir, "cheng-package.toml")
    if !chengpath.WriteTextFile("", manifestPath, manifest):
        return Err[str](" cheng pack new: failed to write manifest")

    // Write src/main.cheng
    var mainSrc = strutil.Join(["module ", name, "\n"], "")
    mainSrc = strutil.Join([mainSrc, "\nfn main(): int32 =\n"], "")
    mainSrc = strutil.Join([mainSrc, "    echo(\"Hello from \", name, \"!\")\n"], "")
    mainSrc = strutil.Join([mainSrc, "    return 0\n"], "")

    let mainPath = os.JoinPath(srcDir, "main.cheng")
    if !chengpath.WriteTextFile("", mainPath, mainSrc):
        return Err[str](" cheng pack new: failed to write src/main.cheng")

    return Ok[str](strutil.Join([" cheng pack new: created package ", name, " at ", dir], ""))

// Build: resolve dependencies -> lock -> compile all modules
fn ChengPackBuild(rootDir: str): Result[clock.ChengLock] =
    // Read manifest to verify the project exists
    let manifestPath = os.JoinPath(rootDir, "cheng-package.toml")
    if !chengpath.PathFileExists(manifestPath):
        return Err[clock.ChengLock](" cheng pack build: no cheng-package.toml found")

    // Resolve dependencies and create lock
    let lockRes = presolve.PackageResolve(rootDir)
    if IsErr(lockRes):
        return Err[clock.ChengLock](strutil.Join([" cheng pack build: resolve failed: ", Error(lockRes)], ""))

    let lock = Value(lockRes)
    if !presolve.PackageResolveWrite(rootDir, lock):
        return Err[clock.ChengLock](" cheng pack build: failed to write lock")

    return Ok[clock.ChengLock](lock)

// Build + run main module. Invokes the compiler as a subprocess.
fn ChengPackRun(rootDir: str, compilerPath: str): Result[str] =
    let buildRes = ChengPackBuild(rootDir)
    if IsErr(buildRes):
        return Err[str](strutil.Join([" cheng pack run: build failed: ", Error(buildRes)], ""))

    let srcPath = os.JoinPath(rootDir, "src/main.cheng")
    if !chengpath.PathFileExists(srcPath):
        return Err[str](" cheng pack run: no src/main.cheng found")

    let outDir = os.JoinPath(rootDir, "_build")
    if !chengpath.PathCreateDirAll(outDir):
        return Err[str](" cheng pack run: failed to create build dir")

    let outBin = os.JoinPath(outDir, "main")
    let compileLog = strutil.Join([outBin, ".compile.log"], "")
    let runLog = strutil.Join([outBin, ".run.log"], "")

    // Compile
    var compileArgs: str[]
    add(compileArgs, "system-link-exec")
    add(compileArgs, strutil.Join(["--root:", rootDir], ""))
    add(compileArgs, strutil.Join(["--in:", srcPath], ""))
    add(compileArgs, "--emit:exe")
    add(compileArgs, "--target:arm64-apple-darwin")
    add(compileArgs, strutil.Join(["--out:", outBin], ""))

    var emptyEnv: str[]
    let compileRun = hostops.RunFileLogged(rootDir,
                                             "cheng_pack_compile",
                                             compilerPath,
                                             compileArgs,
                                             emptyEnv,
                                             rootDir,
                                             120,
                                             compileLog)
    if !hostops.LoggedRunOk(compileRun):
        return Err[str](strutil.Join([" cheng pack run: compile failed, exit=", IntToStr(compileRun.exitCode)], ""))

    if !chengpath.FileExistsNonEmpty(rootDir, outBin):
        return Err[str](" cheng pack run: compile produced no output")

    // Run
    var noArgs: str[]
    let run = hostops.RunFileLogged(rootDir,
                                      "cheng_pack_run",
                                      outBin,
                                      noArgs,
                                      emptyEnv,
                                      rootDir,
                                      30,
                                      runLog)
    if !hostops.LoggedRunOk(run):
        return Err[str](strutil.Join([" cheng pack run: execution failed, exit=", IntToStr(run.exitCode)], ""))

    return Ok[str](run.output)

// Build + run tests. Compiles and runs each .cheng file in tests/.
fn ChengPackTest(rootDir: str, compilerPath: str): Result[str] =
    let buildRes = ChengPackBuild(rootDir)
    if IsErr(buildRes):
        return Err[str](strutil.Join([" cheng pack test: build failed: ", Error(buildRes)], ""))

    let testDir = os.JoinPath(rootDir, "tests")
    if !chengpath.PathDirExists(testDir):
        return Ok[str](" cheng pack test: no tests directory")

    let outDir = os.JoinPath(rootDir, "_build")
    if !chengpath.PathCreateDirAll(outDir):
        return Err[str](" cheng pack test: failed to create build dir")

    var results = ""
    var allPass = true
    let testFiles = os.ListDir(testDir)
    var emptyEnv: str[]
    for i in 0..<testFiles.len:
        let testFile = testFiles[i]
        // Only compile .cheng files
        if !strings.HasSuffix(testFile, ".cheng"):
            continue

        let testName = chengpath.TextSlice(testFile, 0, testFile.len - 6)
        let srcPath = os.JoinPath(testDir, testFile)
        let outBin = os.JoinPath(outDir, strutil.Join([testName, "_test"], ""))
        let compileLog = strutil.Join([outBin, ".compile.log"], "")
        let runLog = strutil.Join([outBin, ".run.log"], "")

        // Compile test
        var compileArgs: str[]
        add(compileArgs, "system-link-exec")
        add(compileArgs, strutil.Join(["--root:", rootDir], ""))
        add(compileArgs, strutil.Join(["--in:", srcPath], ""))
        add(compileArgs, "--emit:exe")
        add(compileArgs, "--target:arm64-apple-darwin")
        add(compileArgs, strutil.Join(["--out:", outBin], ""))

        let compileRun = hostops.RunFileLogged(rootDir,
                                                 strutil.Join(["cheng_pack_test_compile_", testName], ""),
                                                 compilerPath,
                                                 compileArgs,
                                                 emptyEnv,
                                                 rootDir,
                                                 120,
                                                 compileLog)
        if !hostops.LoggedRunOk(compileRun):
            results = strutil.Join([results, "FAIL compile ", testName, " (", IntToStr(compileRun.exitCode), ")\n"], "")
            allPass = false
            continue

        // Run test
        var noArgs: str[]
        let run = hostops.RunFileLogged(rootDir,
                                          strutil.Join(["cheng_pack_test_run_", testName], ""),
                                          outBin,
                                          noArgs,
                                          emptyEnv,
                                          rootDir,
                                          30,
                                          runLog)
        if !hostops.LoggedRunOk(run):
            results = strutil.Join([results, "FAIL run ", testName, " (", IntToStr(run.exitCode), ")\n"], "")
            allPass = false
        else:
            results = strutil.Join([results, "PASS ", testName, "\n"], "")

    if allPass:
        return Ok[str](results)
    return Err[str](strutil.Join([" cheng pack test: some tests failed\n", results], ""))

fn ChengPackPublish(rootDir: str, endpoint: str): Result[str] =
    // Resolve dependencies and create lock
    let lockRes = presolve.PackageResolve(rootDir)
    if IsErr(lockRes):
        return Err[str](strutil.Join([" cheng pack publish: resolve failed: ", Error(lockRes)], ""))
    let lock = Value(lockRes)
    // Write local lock file
    if !presolve.PackageResolveWrite(rootDir, lock):
        return Err[str](" cheng pack publish: failed to write lock file")
    // Publish to registry
    let verRes = reg.RegistryPublishPackage(rootDir, endpoint)
    if IsErr(verRes):
        return Err[str](strutil.Join([" cheng pack publish: ", Error(verRes)], ""))
    let version = Value(verRes)
    // Write full resolved lock to the published package directory
    let manifest = presolve.PackageManifestRead(rootDir)
    let epRes = reg.RegistryEndpointParse(endpoint)
    if !IsErr(epRes):
        let ep = Value(epRes)
        if ep.scheme == "file" && manifest.packageId.len > 0:
            let pubDir = os.JoinPath(os.JoinPath(ep.path, manifest.packageId), manifest.version)
            if chengpath.PathDirExists(pubDir):
                let lockText = clock.ChengLockSerialize(lock)
                let _ = chengpath.WriteTextFile("", os.JoinPath(pubDir, "cheng.lock.toml"), lockText)
    return Ok[str](version)

fn ChengPackFetch(packageName: str, version: str, endpoint: str): Result[str] =
    // Fetch receipt from registry
    let receiptRes = reg.RegistryFetch(packageName, version, endpoint)
    if IsErr(receiptRes):
        return Err[str](strutil.Join([" cheng pack fetch: fetch failed: ", Error(receiptRes)], ""))
    let receipt = Value(receiptRes)
    // Verify receipt integrity
    if !wresolver.WorldVerify(receipt):
        return Err[str](" cheng pack fetch: receipt verification failed")
    // Install to local cache directory
    let cacheRoot = strutil.Join(["/tmp/cheng-cache/", packageName, "/", version], "")
    if !chengpath.PathCreateDirAll(cacheRoot):
        return Err[str](" cheng pack fetch: failed to create cache directory")
    // Write package manifest
    let pkgId = receipt.entries[0].packageId
    let pkgVersion = receipt.entries[0].version
    var pkgToml = strutil.Join(["package_id = \"", pkgId, "\"\n"], "")
    pkgToml = strutil.Join([pkgToml, "version = \"", pkgVersion, "\"\n"], "")
    if !chengpath.WriteTextFile("", os.JoinPath(cacheRoot, "cheng-package.toml"), pkgToml):
        return Err[str](" cheng pack fetch: failed to write package manifest")
    // Copy source files from registry to cache
    let epRes = reg.RegistryEndpointParse(endpoint)
    if !IsErr(epRes):
        let ep = Value(epRes)
        if ep.scheme == "file":
            let regPkgDir = os.JoinPath(os.JoinPath(ep.path, packageName), version)
            let regSrcDir = os.JoinPath(regPkgDir, "src")
            if chengpath.PathDirExists(regSrcDir):
                let srcFiles = os.ListDir(regSrcDir)
                for i in 0..<srcFiles.len:
                    let fileName = srcFiles[i]
                    let fullPath = os.JoinPath(regSrcDir, fileName)
                    if chengpath.PathFileExists(fullPath):
                        let fileText = chengpath.ReadTextFile("", fullPath)
                        let cacheSrcDir = os.JoinPath(cacheRoot, "src")
                        if !chengpath.PathCreateDirAll(cacheSrcDir):
                            continue
                        let _ = chengpath.WriteTextFile("", os.JoinPath(cacheSrcDir, fileName), fileText)
    return Ok[str](cacheRoot)
