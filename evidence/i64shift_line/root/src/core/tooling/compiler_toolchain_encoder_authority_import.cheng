import std/cmdline
import std/rawbytes
import std/result
import cheng/core/tooling/compiler_execution_stage_receipt as stage_receipt
import cheng/core/tooling/path as chengpath
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

const
    CompilerToolchainEncoderOfficialReceiptV2Schema: str =
        "cheng.backend2.current_source_official_build_receipt.v3"
    CompilerToolchainEncoderBuildProjectionSchema: str =
        "cheng.compiler.toolchain_encoder_authority_build_projection_receipt"
    CompilerToolchainEncoderRuntimeAuthorityDomain: str =
        "cheng.compiler.toolchain_encoder_runtime_authority.v2"
    # v3 (2026-08-29 runtime walls): the build projection gained the
    # compiler-csg cargo-object-receipt column (row 22).  Without it the
    # projection verify demands an observed cargo-object receipt CID that no
    # v2 receipt can carry, which made every riscv64 encoder-authority
    # import fail closed regardless of launch context.
    CompilerToolchainEncoderOfficialReceiptV2FieldCount: int32 = 34
    CompilerToolchainEncoderCompilerBytesLimit: int32 = 268435456
    CompilerToolchainEncoderOfficialReceiptBytesLimit: int32 = 65536
    CompilerToolchainEncoderOfficialReceiptSuffix: str =
        ".current-build-receipt.kv"
    # Workspace-level official compiler authority (2026-08-29 runtime walls):
    # the published backend-driver binary adjacent to which the official
    # build receipt lives.  Combined kernel/plugin drivers embed the compile
    # pipeline but are not themselves receipted publications, so the primary
    # riscv64 encoder-authority gate may anchor on this workspace authority
    # when the ambient process vector cannot name a receipted binary.
    CompilerToolchainEncoderWorkspaceCompilerRelPath: str =
        "artifacts/backend_driver/cheng"

type
    # This is the outer runtime authority imported from an official receipt
    # adjacent to the exact compiler named by argv[0].  The inner receipt CID
    # binds every build-projection field; the two raw32 values bind the stable
    # compiler and complete official-receipt bytes actually consumed here.
    CompilerToolchainEncoderRuntimeAuthority =
        canonicalRow: int32
        projectionReceiptCid: layout.FixedBytes32
        compilerBytesRaw32: layout.FixedBytes32
        officialReceiptRaw32: layout.FixedBytes32
        runtimeAuthorityCid: layout.FixedBytes32

    # Transient parser state is fixed-width SoA.  Text is never an identity:
    # values remain byte ranges in the one owned receipt buffer.
    compilerToolchainEncoderOfficialReceiptRanges =
        valueStarts: int32[CompilerToolchainEncoderOfficialReceiptV2FieldCount]
        valueLengths: int32[CompilerToolchainEncoderOfficialReceiptV2FieldCount]
        terminalLineStart: int32

@borrows
fn compilerToolchainEncoderTextCat(left: str, right: str): str =
    return left + right

@borrows
fn compilerToolchainEncoderOfficialReceiptExpectedKey(row: int32): str =
    if row == 0:
        return "schema"
    if row == 1:
        return "status"
    if row == 2:
        return "driver_role"
    if row == 3:
        return "source_manifest_sha256"
    if row == 4:
        return "source_manifest_before_path_fshex"
    if row == 5:
        return "source_manifest_after_path_fshex"
    if row == 6:
        return "official_sha256"
    if row == 7:
        return "cold_scratch_execution_receipt_path_fshex"
    if row == 8:
        return "cold_scratch_execution_receipt_sha256"
    if row == 9:
        return "install_receipt_path_fshex"
    if row == 10:
        return "install_receipt_sha256"
    if row == 11:
        return "publisher_receipt_path_fshex"
    if row == 12:
        return "publisher_receipt_sha256"
    if row == 13:
        return "source_postflight_status"
    if row == 14:
        return "raw_bytes_fixed_point"
    if row == 15:
        return "cold_system_link_exec"
    if row == 16:
        return "system_link_exec_scope"
    if row == 17:
        return "encoder_build_projection_build_authority_cid"
    if row == 18:
        return "encoder_build_projection_canonical_row"
    if row == 19:
        return "encoder_build_projection_compiler_csg_artifact_cid"
    if row == 20:
        return "encoder_build_projection_compiler_csg_canonical_graph_cid"
    if row == 21:
        return "encoder_build_projection_compiler_csg_cargo_cid"
    if row == 22:
        return "encoder_build_projection_compiler_csg_cargo_object_receipt_cid"
    if row == 23:
        return "encoder_build_projection_compiler_csg_facts_root_cid"
    if row == 24:
        return "encoder_build_projection_compiler_csg_graph_cid"
    if row == 25:
        return "encoder_build_projection_compiler_csg_source_bundle_cid"
    if row == 26:
        return "encoder_build_projection_content_cid"
    if row == 27:
        return "encoder_build_projection_document_cid"
    if row == 28:
        return "encoder_build_projection_module_path_text_id"
    if row == 29:
        return "encoder_build_projection_producer_row"
    if row == 30:
        return "encoder_build_projection_projection_cid"
    if row == 31:
        return "encoder_build_projection_receipt_cid"
    if row == 32:
        return "encoder_build_projection_schema"
    if row == 33:
        return "receipt_payload_sha256"
    return ""

@borrows
fn compilerToolchainEncoderBytesRangeEqualsText(
        bytes: rawbytes.Bytes,
        start: int32,
        count: int32,
        text: str): bool =
    if start < 0 || count < 0 || count != text.len ||
       start > bytes.len || count > bytes.len - start:
        return false
    for index in 0..<count:
        if rawbytes.BytesGet(bytes, start + index) !=
           (Int32(text[index]) % 256):
            return false
    return true

@borrows
fn compilerToolchainEncoderReceiptValueEquals(
        bytes: rawbytes.Bytes,
        ranges: compilerToolchainEncoderOfficialReceiptRanges,
        row: int32,
        expected: str): bool =
    if row < 0 || row >= CompilerToolchainEncoderOfficialReceiptV2FieldCount:
        return false
    return compilerToolchainEncoderBytesRangeEqualsText(
        bytes,
        ranges.valueStarts[row],
        ranges.valueLengths[row],
        expected)

@borrows
fn compilerToolchainEncoderOfficialReceiptParseRanges(
        bytes: rawbytes.Bytes,
        out: var compilerToolchainEncoderOfficialReceiptRanges):
        Result[bool] =
    if bytes.len <= 0 ||
       bytes.len > CompilerToolchainEncoderOfficialReceiptBytesLimit:
        return Err[bool](
            " compiler encoder runtime authority: official receipt size")
    var row: int32
    var lineStart: int32
    for cursor in 0..<bytes.len:
        let current = rawbytes.BytesGet(bytes, cursor)
        if current == 0 || current == 13:
            return Err[bool](
                " compiler encoder runtime authority: forbidden receipt byte")
        if current != 10:
            continue
        if row >= CompilerToolchainEncoderOfficialReceiptV2FieldCount ||
           cursor <= lineStart:
            return Err[bool](
                " compiler encoder runtime authority: receipt row count")
        var equalsIndex: int32 = -1
        for index in lineStart..<cursor:
            if rawbytes.BytesGet(bytes, index) == 61:
                if equalsIndex >= 0:
                    return Err[bool](
                        " compiler encoder runtime authority: receipt delimiter")
                equalsIndex = index
        if equalsIndex <= lineStart:
            return Err[bool](
                " compiler encoder runtime authority: receipt delimiter")
        let expectedKey =
            compilerToolchainEncoderOfficialReceiptExpectedKey(row)
        if !compilerToolchainEncoderBytesRangeEqualsText(
                bytes,
                lineStart,
                equalsIndex - lineStart,
                expectedKey):
            return Err[bool](
                " compiler encoder runtime authority: receipt field order")
        out.valueStarts[row] = equalsIndex + 1
        out.valueLengths[row] = cursor - equalsIndex - 1
        if out.valueLengths[row] <= 0:
            return Err[bool](
                " compiler encoder runtime authority: empty receipt field")
        if row == CompilerToolchainEncoderOfficialReceiptV2FieldCount - 1:
            out.terminalLineStart = lineStart
        row = row + 1
        lineStart = cursor + 1
    if lineStart != bytes.len ||
       row != CompilerToolchainEncoderOfficialReceiptV2FieldCount ||
       out.terminalLineStart <= 0:
        return Err[bool](
            " compiler encoder runtime authority: receipt terminal shape")
    return Ok[bool](true)

fn compilerToolchainEncoderHexNibble(value: int32): int32 =
    if value >= 48 && value <= 57:
        return value - 48
    if value >= 97 && value <= 102:
        return value - 97 + 10
    return -1

@borrows
fn compilerToolchainEncoderReceiptParseFixed32(
        bytes: rawbytes.Bytes,
        ranges: compilerToolchainEncoderOfficialReceiptRanges,
        row: int32,
        out: var layout.FixedBytes32): bool =
    if row < 0 || row >= CompilerToolchainEncoderOfficialReceiptV2FieldCount ||
       ranges.valueLengths[row] != 64:
        return false
    let start = ranges.valueStarts[row]
    for index in 0..<layout.FixedBytes32Size:
        let high = compilerToolchainEncoderHexNibble(
            rawbytes.BytesGet(bytes, start + index * 2))
        let low = compilerToolchainEncoderHexNibble(
            rawbytes.BytesGet(bytes, start + index * 2 + 1))
        if high < 0 || low < 0:
            return false
        out.data[index] = uint8((high << 4) | low)
    return true

@borrows
fn compilerToolchainEncoderReceiptParseI32(
        bytes: rawbytes.Bytes,
        ranges: compilerToolchainEncoderOfficialReceiptRanges,
        row: int32,
        out: var int32): bool =
    if row < 0 || row >= CompilerToolchainEncoderOfficialReceiptV2FieldCount:
        return false
    let count = ranges.valueLengths[row]
    if count <= 0 || count > 10:
        return false
    let start = ranges.valueStarts[row]
    if count > 1 && rawbytes.BytesGet(bytes, start) == 48:
        return false
    var value: int64
    for index in 0..<count:
        let digit = rawbytes.BytesGet(bytes, start + index) - 48
        if digit < 0 || digit > 9:
            return false
        value = value * Int64(10) + Int64(digit)
        if value > Int64(2147483647):
            return false
    out = int32(value)
    return true

@borrows
fn compilerToolchainEncoderReceiptLowerHexEven(
        bytes: rawbytes.Bytes,
        ranges: compilerToolchainEncoderOfficialReceiptRanges,
        row: int32): bool =
    if row < 0 || row >= CompilerToolchainEncoderOfficialReceiptV2FieldCount:
        return false
    let count = ranges.valueLengths[row]
    if count <= 0 || (count % 2) != 0:
        return false
    let start = ranges.valueStarts[row]
    for index in 0..<count:
        if compilerToolchainEncoderHexNibble(
               rawbytes.BytesGet(bytes, start + index)) < 0:
            return false
    return true

@borrows
fn compilerToolchainEncoderObservedFixed32(
        value: layout.FixedBytes32,
        emptyRaw32: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(value, emptyRaw32)

@borrows
fn compilerToolchainEncoderReceiptObservedSha(
        bytes: rawbytes.Bytes,
        ranges: compilerToolchainEncoderOfficialReceiptRanges,
        row: int32,
        emptyRaw32: layout.FixedBytes32): bool =
    var value: layout.FixedBytes32
    if !compilerToolchainEncoderReceiptParseFixed32(
            bytes, ranges, row, value):
        return false
    return compilerToolchainEncoderObservedFixed32(value, emptyRaw32)

@borrows
fn compilerToolchainEncoderAbsoluteCompilerPath(path: str): bool =
    if path.len <= 0:
        return false
    if path[0] == '/':
        return true
    if path.len < 3 || path[1] != ':' ||
       (path[2] != '/' && path[2] != '\\'):
        return false
    return (path[0] >= 'A' && path[0] <= 'Z') ||
           (path[0] >= 'a' && path[0] <= 'z')

@borrows
fn compilerToolchainEncoderOfficialReceiptEnvelopeValid(
        bytes: rawbytes.Bytes,
        ranges: compilerToolchainEncoderOfficialReceiptRanges,
        emptyRaw32: layout.FixedBytes32): bool =
    if !compilerToolchainEncoderReceiptValueEquals(
           bytes, ranges, 0, CompilerToolchainEncoderOfficialReceiptV2Schema) ||
       !compilerToolchainEncoderReceiptValueEquals(bytes, ranges, 1, "PASS") ||
       !compilerToolchainEncoderReceiptValueEquals(
           bytes, ranges, 2, "production") ||
       !compilerToolchainEncoderReceiptValueEquals(
           bytes, ranges, 13, "stable") ||
       !compilerToolchainEncoderReceiptValueEquals(bytes, ranges, 14, "true") ||
       !compilerToolchainEncoderReceiptValueEquals(bytes, ranges, 15, "0") ||
       !compilerToolchainEncoderReceiptValueEquals(
           bytes, ranges, 16, "selfhost_direct") ||
       !compilerToolchainEncoderReceiptValueEquals(
           bytes,
           ranges,
           32,
           CompilerToolchainEncoderBuildProjectionSchema):
        return false
    if !compilerToolchainEncoderReceiptObservedSha(
           bytes, ranges, 3, emptyRaw32) ||
       !compilerToolchainEncoderReceiptObservedSha(
           bytes, ranges, 6, emptyRaw32) ||
       !compilerToolchainEncoderReceiptObservedSha(
           bytes, ranges, 8, emptyRaw32) ||
       !compilerToolchainEncoderReceiptObservedSha(
           bytes, ranges, 10, emptyRaw32) ||
       !compilerToolchainEncoderReceiptObservedSha(
           bytes, ranges, 12, emptyRaw32) ||
       !compilerToolchainEncoderReceiptObservedSha(
           bytes, ranges, 33, emptyRaw32):
        return false
    if !compilerToolchainEncoderReceiptLowerHexEven(bytes, ranges, 4) ||
       !compilerToolchainEncoderReceiptLowerHexEven(bytes, ranges, 5) ||
       !compilerToolchainEncoderReceiptLowerHexEven(bytes, ranges, 7) ||
       !compilerToolchainEncoderReceiptLowerHexEven(bytes, ranges, 9) ||
       !compilerToolchainEncoderReceiptLowerHexEven(bytes, ranges, 11):
        return false
    return true

fn compilerToolchainEncoderAppendU32BE(
        bytes: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(bytes, (value >> 24) % 256)
    layout.ByteBufAppendByte(bytes, (value >> 16) % 256)
    layout.ByteBufAppendByte(bytes, (value >> 8) % 256)
    layout.ByteBufAppendByte(bytes, value % 256)

@borrows
fn compilerToolchainEncoderAppendText(
        bytes: var layout.ByteBuf,
        value: str) =
    compilerToolchainEncoderAppendU32BE(bytes, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(bytes, Int32(value[index]) % 256)

fn compilerToolchainEncoderAppendI32(
        bytes: var layout.ByteBuf,
        value: int32) =
    compilerToolchainEncoderAppendU32BE(bytes, 4)
    compilerToolchainEncoderAppendU32BE(bytes, value)

@borrows
fn compilerToolchainEncoderAppendFixed32(
        bytes: var layout.ByteBuf,
        value: layout.FixedBytes32) =
    compilerToolchainEncoderAppendU32BE(bytes, layout.FixedBytes32Size)
    layout.ByteBufAppendFixed32(bytes, value)

@borrows
fn compilerToolchainEncoderRuntimeAuthorityCid(
        canonicalRow: int32,
        projectionReceiptCid: layout.FixedBytes32,
        compilerBytesRaw32: layout.FixedBytes32,
        officialReceiptRaw32: layout.FixedBytes32): layout.FixedBytes32 =
    var payload = layout.ByteBufInit(192)
    compilerToolchainEncoderAppendText(
        payload, CompilerToolchainEncoderRuntimeAuthorityDomain)
    compilerToolchainEncoderAppendI32(payload, canonicalRow)
    compilerToolchainEncoderAppendFixed32(payload, projectionReceiptCid)
    compilerToolchainEncoderAppendFixed32(payload, compilerBytesRaw32)
    compilerToolchainEncoderAppendFixed32(payload, officialReceiptRaw32)
    let out = hash256.Sha256Fixed(layout.ByteBufView(payload))
    layout.ByteBufFree(payload)
    return out

@borrows
fn compilerToolchainEncoderBuildProjectionRead(
        bytes: rawbytes.Bytes,
        ranges: compilerToolchainEncoderOfficialReceiptRanges,
        emptyRaw32: layout.FixedBytes32,
        out: var stage_receipt.CompilerToolchainEncoderAuthorityBuildProjectionReceipt):
        bool =
    if !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 17, out.buildAuthorityCid) ||
       !compilerToolchainEncoderReceiptParseI32(
           bytes, ranges, 18, out.canonicalRow) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 19, out.compilerCsgArtifactCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 20, out.compilerCsgCanonicalGraphCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 21, out.compilerCsgCargoCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 22, out.compilerCsgCargoObjectReceiptCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 23, out.compilerCsgFactsRootCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 24, out.compilerCsgGraphCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 25, out.compilerCsgSourceBundleCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 26, out.contentCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 27, out.documentCid) ||
       !compilerToolchainEncoderReceiptParseI32(
           bytes, ranges, 28, out.modulePathTextId) ||
       !compilerToolchainEncoderReceiptParseI32(
           bytes, ranges, 29, out.producerRow) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 30, out.projectionCid) ||
       !compilerToolchainEncoderReceiptParseFixed32(
           bytes, ranges, 31, out.receiptCid):
        return false
    return compilerToolchainEncoderObservedFixed32(
               out.buildAuthorityCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.compilerCsgArtifactCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.compilerCsgCanonicalGraphCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.compilerCsgCargoCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.compilerCsgCargoObjectReceiptCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.compilerCsgFactsRootCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.compilerCsgGraphCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.compilerCsgSourceBundleCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.contentCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.documentCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.projectionCid, emptyRaw32) &&
           compilerToolchainEncoderObservedFixed32(
               out.receiptCid, emptyRaw32)

fn compilerToolchainEncoderRuntimeAuthorityImportOwnedPath(
        compilerPath: str):
        Result[CompilerToolchainEncoderRuntimeAuthority] =
    if compilerPath.len <= 0 ||
       compilerPath.len > 32768 ||
       !compilerToolchainEncoderAbsoluteCompilerPath(compilerPath):
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: absolute argv0 required")
    var compilerRead = chengpath.PathStableReadBytes(compilerPath)
    if !compilerRead.ok:
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            compilerToolchainEncoderTextCat(
                " compiler encoder runtime authority: compiler stable read ",
                compilerRead.error))
    defer:
        rawbytes.BytesFree(compilerRead.bytes)
    if compilerRead.bytes.len <= 0 ||
       compilerRead.bytes.len > CompilerToolchainEncoderCompilerBytesLimit:
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: compiler byte size")

    let compilerPathLength = compilerPath.len
    let receiptPath = compilerToolchainEncoderTextCat(
        compilerPath, CompilerToolchainEncoderOfficialReceiptSuffix)
    if receiptPath.len <= compilerPathLength || receiptPath.len > 32768:
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: adjacent receipt path")

    var receiptRead = chengpath.PathStableReadBytes(receiptPath)
    if !receiptRead.ok:
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            compilerToolchainEncoderTextCat(
                " compiler encoder runtime authority: receipt stable read ",
                receiptRead.error))
    defer:
        rawbytes.BytesFree(receiptRead.bytes)

    var ranges: compilerToolchainEncoderOfficialReceiptRanges
    let parseRes = compilerToolchainEncoderOfficialReceiptParseRanges(
        receiptRead.bytes, ranges)
    if IsErr(parseRes):
        return Err[CompilerToolchainEncoderRuntimeAuthority](Error(parseRes))
    let emptyRaw32 = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(rawbytes.EmptyBytes()))
    if !compilerToolchainEncoderOfficialReceiptEnvelopeValid(
           receiptRead.bytes, ranges, emptyRaw32):
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: official envelope")

    let compilerBytesRaw32 = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(compilerRead.bytes))
    var officialCompilerRaw32: layout.FixedBytes32
    if !compilerToolchainEncoderReceiptParseFixed32(
           receiptRead.bytes, ranges, 6, officialCompilerRaw32) ||
       !layout.FixedBytes32Equal(
           compilerBytesRaw32, officialCompilerRaw32):
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: compiler bytes mismatch")

    let payloadView = rawbytes.BytesSliceView(
        receiptRead.bytes, 0, ranges.terminalLineStart)
    let payloadRaw32 = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(payloadView))
    var terminalRaw32: layout.FixedBytes32
    if !compilerToolchainEncoderReceiptParseFixed32(
           receiptRead.bytes, ranges, 33, terminalRaw32) ||
       !layout.FixedBytes32Equal(payloadRaw32, terminalRaw32):
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: terminal payload hash")

    var inner: stage_receipt.CompilerToolchainEncoderAuthorityBuildProjectionReceipt
    if !compilerToolchainEncoderBuildProjectionRead(
           receiptRead.bytes, ranges, emptyRaw32, inner):
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: build projection encoding")
    let innerVerify =
        stage_receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
            inner)
    if IsErr(innerVerify):
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            compilerToolchainEncoderTextCat(
                " compiler encoder runtime authority: build projection ",
                Error(innerVerify)))

    let officialReceiptRaw32 = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(receiptRead.bytes))
    var out: CompilerToolchainEncoderRuntimeAuthority
    out.canonicalRow = inner.canonicalRow
    out.projectionReceiptCid = layout.FixedBytes32Copy(inner.receiptCid)
    out.compilerBytesRaw32 = layout.FixedBytes32Copy(compilerBytesRaw32)
    out.officialReceiptRaw32 = layout.FixedBytes32Copy(officialReceiptRaw32)
    out.runtimeAuthorityCid = compilerToolchainEncoderRuntimeAuthorityCid(
        out.canonicalRow,
        out.projectionReceiptCid,
        out.compilerBytesRaw32,
        out.officialReceiptRaw32)
    return Ok[CompilerToolchainEncoderRuntimeAuthority](out)

fn CompilerToolchainEncoderRuntimeAuthorityImportCurrent():
        Result[CompilerToolchainEncoderRuntimeAuthority] =
    let compilerPath = cmdline.ParamStr(0)
    return compilerToolchainEncoderRuntimeAuthorityImportOwnedPath(
        compilerPath)

fn CompilerToolchainEncoderRuntimeAuthorityImportForWorkspace(
        rootDir: str):
        Result[CompilerToolchainEncoderRuntimeAuthority] =
    # Driver-context default correction (2026-08-29 runtime walls): combined
    # drivers run the same primary object plan without an ambient argv naming
    # a receipted binary (empirically param_count=0 at fixture-compile time),
    # and the combined image itself is neither receipt-adjacent nor inside
    # the compiler-bytes envelope.  Anchor the authority on the workspace's
    # official published compiler instead.  The full validation chain
    # (absolute path, stable read, adjacent official receipt, byte-size
    # envelope, sha match, envelope fields, terminal payload hash, build
    # projection verify) is the exact argv[0] path and every rejection is
    # preserved.
    if rootDir.len <= 0:
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: workspace root unavailable")
    let compilerPath = chengpath.PathAbsolute(
        rootDir,
        CompilerToolchainEncoderWorkspaceCompilerRelPath)
    if len(compilerPath) <= 0:
        return Err[CompilerToolchainEncoderRuntimeAuthority](
            " compiler encoder runtime authority: workspace compiler path")
    return compilerToolchainEncoderRuntimeAuthorityImportOwnedPath(
        compilerPath)
