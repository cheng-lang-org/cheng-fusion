import std/os
import std/rawbytes
import std/result
import std/strutils as strutil
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/tooling/compiler_execution_stage_receipt as execution
import cheng/core/tooling/compiler_snapshot_lowering_bridge as bridge
import cheng/core/tooling/path as chengpath

const CompilerToolchainEncoderProjectionValidatorSchema: str =
    "cheng.compiler.toolchain_encoder_projection_validator.v1"

@borrows
fn compilerToolchainEncoderProjectionReportFieldInto(
        lines: str[],
        key: str,
        out: var str,
        err: var str): bool =
    let prefix = strings.ConcatStr(key, "=")
    var found: int32 = -1
    for lineIndex in 0..<lines.len:
        let line = lines[lineIndex]
        if line.len >= prefix.len &&
           strings.SliceBytes(line, 0, prefix.len) == prefix:
            if found >= 0:
                err = strings.ConcatStr(
                    "encoder_projection_validator_duplicate_field:", key)
                return false
            found = lineIndex
    if found < 0 || lines[found].len <= prefix.len:
        err = strings.ConcatStr(
            "encoder_projection_validator_missing_field:", key)
        return false
    out = strings.CloneStr(
        strings.SliceBytes(
            lines[found], prefix.len, lines[found].len - prefix.len))
    return true

@borrows
fn compilerToolchainEncoderProjectionReportFixed32Into(
        lines: str[],
        key: str,
        out: var layout.FixedBytes32,
        err: var str): bool =
    var value: str
    if !compilerToolchainEncoderProjectionReportFieldInto(
           lines, key, value, err):
        return false
    let parsed = layout.FixedBytes32FromHex(value)
    if IsErr(parsed):
        err = strings.ConcatStr(
            "encoder_projection_validator_invalid_fixed32:", key)
        return false
    out = Value(parsed)
    return true

@borrows
fn compilerToolchainEncoderProjectionReportUint64Into(
        lines: str[],
        key: str,
        out: var int64,
        err: var str): bool =
    var value: str
    if !compilerToolchainEncoderProjectionReportFieldInto(
           lines, key, value, err):
        return false
    if value.len <= 0 ||
       (value.len > 1 && value[0] == '0'):
        err = strings.ConcatStr(
            "encoder_projection_validator_invalid_uint:", key)
        return false
    var parsed: int64
    for index in 0..<value.len:
        if value[index] < '0' || value[index] > '9':
            err = strings.ConcatStr(
                "encoder_projection_validator_invalid_uint:", key)
            return false
        let digit = int64(int32(value[index]) - int32('0'))
        if parsed > (int64(9223372036854775807) - digit) / int64(10):
            err = strings.ConcatStr(
                "encoder_projection_validator_uint_overflow:", key)
            return false
        parsed = parsed * int64(10) + digit
    out = parsed
    return true

@borrows
fn compilerToolchainEncoderProjectionReportI32Into(
        lines: str[],
        key: str,
        out: var int32,
        err: var str): bool =
    var parsed: int64
    if !compilerToolchainEncoderProjectionReportUint64Into(
           lines, key, parsed, err) || parsed > int64(2147483647):
        if err.len == 0:
            err = strings.ConcatStr(
                "encoder_projection_validator_i32_overflow:", key)
        return false
    out = int32(parsed)
    return true

@borrows
fn compilerToolchainEncoderProjectionReportParseInto(
        reportText: str,
        projection: var
            execution.CompilerToolchainEncoderAuthorityBuildProjectionReceipt,
        cargo: var
            bridge.CompilerSnapshotLoweringAuthorityCargoObjectReceipt,
        cargoAbsolutePath: var str,
        err: var str): bool =
    projection =
        execution.CompilerToolchainEncoderAuthorityBuildProjectionReceipt()
    cargo = bridge.CompilerSnapshotLoweringAuthorityCargoObjectReceipt()
    cargoAbsolutePath = ""
    let lines = strutil.Split(reportText, '\n')
    var schema: str
    if !compilerToolchainEncoderProjectionReportFieldInto(
           lines, "encoder_build_projection_schema", schema, err) ||
       schema !=
           execution.CompilerToolchainEncoderAuthorityBuildProjectionReceiptDomain:
        if err.len == 0:
            err = "encoder_projection_validator_schema_mismatch"
        return false
    if !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_build_authority_cid",
           projection.buildAuthorityCid, err) ||
       !compilerToolchainEncoderProjectionReportI32Into(
           lines, "encoder_build_projection_canonical_row",
           projection.canonicalRow, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_compiler_csg_artifact_cid",
           projection.compilerCsgArtifactCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines,
           "encoder_build_projection_compiler_csg_canonical_graph_cid",
           projection.compilerCsgCanonicalGraphCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_compiler_csg_cargo_cid",
           projection.compilerCsgCargoCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines,
           "encoder_build_projection_compiler_csg_cargo_object_receipt_cid",
           projection.compilerCsgCargoObjectReceiptCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_compiler_csg_facts_root_cid",
           projection.compilerCsgFactsRootCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_compiler_csg_graph_cid",
           projection.compilerCsgGraphCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_compiler_csg_source_bundle_cid",
           projection.compilerCsgSourceBundleCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_content_cid",
           projection.contentCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_document_cid",
           projection.documentCid, err) ||
       !compilerToolchainEncoderProjectionReportI32Into(
           lines, "encoder_build_projection_module_path_text_id",
           projection.modulePathTextId, err) ||
       !compilerToolchainEncoderProjectionReportI32Into(
           lines, "encoder_build_projection_producer_row",
           projection.producerRow, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_projection_cid",
           projection.projectionCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_receipt_cid",
           projection.receiptCid, err):
        return false
    if !compilerToolchainEncoderProjectionReportI32Into(
           lines,
           "encoder_build_projection_cargo_object_authority_slot",
           cargo.authoritySlot, err) ||
       !compilerToolchainEncoderProjectionReportI32Into(
           lines,
           "encoder_build_projection_cargo_object_authority_generation",
           cargo.authorityGeneration, err) ||
       !compilerToolchainEncoderProjectionReportI32Into(
           lines, "encoder_build_projection_cargo_object_row",
           cargo.cargoObjectRow, err) ||
       !compilerToolchainEncoderProjectionReportUint64Into(
           lines, "encoder_build_projection_cargo_store_generation",
           cargo.storeGeneration, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_cargo_store_identity_cid",
           cargo.cargoStoreIdentityCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines,
           "encoder_build_projection_cargo_before_store_identity_cid",
           cargo.beforeStoreIdentityCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_cargo_head_cid",
           cargo.cargoHeadCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_cargo_manifest_cid",
           cargo.cargoManifestCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_cargo_store_receipt_cid",
           cargo.cargoStoreReceiptCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_cargo_csgc_object_cid",
           cargo.cargoCsgcObjectCid, err) ||
       !compilerToolchainEncoderProjectionReportFieldInto(
           lines, "encoder_build_projection_cargo_absolute_path",
           cargoAbsolutePath, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines, "encoder_build_projection_cargo_absolute_path_cid",
           cargo.cargoAbsolutePathCid, err) ||
       !compilerToolchainEncoderProjectionReportI32Into(
           lines, "encoder_build_projection_cargo_byte_count",
           cargo.cargoByteCount, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines,
           "encoder_build_projection_cargo_before_read_observation_cid",
           cargo.beforeReadObservationCid, err) ||
       !compilerToolchainEncoderProjectionReportFixed32Into(
           lines,
           "encoder_build_projection_cargo_after_read_observation_cid",
           cargo.afterReadObservationCid, err):
        return false
    cargo.cargoCid = projection.compilerCsgCargoCid
    cargo.factsRootCid = projection.compilerCsgFactsRootCid
    cargo.contentCid = projection.contentCid
    cargo.receiptCid = projection.compilerCsgCargoObjectReceiptCid
    return true

@borrows
fn compilerToolchainEncoderProjectionValidatorFail(
        err: str): int32 =
    os.WriteLine(
        os.Get_stderr(),
        strings.ConcatStr("encoder_projection_validator_error=", err))
    return 97

fn main(): int32 =
    let workspaceRoot = os.GetEnv(
        "CHENG_ENCODER_PROJECTION_WORKSPACE_ROOT")
    let reportPath = os.GetEnv(
        "CHENG_ENCODER_PROJECTION_REPORT_PATH")
    if workspaceRoot.len == 0 || reportPath.len == 0:
        return compilerToolchainEncoderProjectionValidatorFail(
            "required_environment_missing")
    var reportRead = chengpath.PathStableReadBytes(reportPath)
    defer:
        rawbytes.BytesFree(reportRead.bytes)
    if !reportRead.ok || reportRead.error.len != 0:
        return compilerToolchainEncoderProjectionValidatorFail(
            "report_stable_read_failed")
    let reportText = rawbytes.BytesToString(reportRead.bytes)
    var projection: execution.CompilerToolchainEncoderAuthorityBuildProjectionReceipt
    var cargo: bridge.CompilerSnapshotLoweringAuthorityCargoObjectReceipt
    var cargoAbsolutePath: str
    var err: str
    if !compilerToolchainEncoderProjectionReportParseInto(
           reportText, projection, cargo, cargoAbsolutePath, err) ||
       !bridge.CompilerSnapshotLoweringAuthorityCargoObjectProjectionReopenStrictInto(
           workspaceRoot, cargoAbsolutePath, cargo, projection, err):
        return compilerToolchainEncoderProjectionValidatorFail(err)
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "encoder_projection_validator_schema=",
            CompilerToolchainEncoderProjectionValidatorSchema))
    os.WriteLine(
        os.Get_stdout(),
        "encoder_projection_validator_status=pass")
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "encoder_projection_validator_build_projection_receipt_cid=",
            layout.FixedBytes32Hex(projection.receiptCid)))
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "encoder_projection_validator_cargo_object_receipt_cid=",
            layout.FixedBytes32Hex(cargo.receiptCid)))
    return 0
