import cheng/core/tooling/compiler_payload_lifecycle as payload
import cheng/core/tooling/lifetime_ledger as lifetime
import cheng/core/ir/phase_arena as phase

const
    CompilerCsgBuildFragmentGraphNodeStore: int32 = 1
    CompilerCsgBuildFragmentLineStore: int32 = 2
    CompilerCsgBuildFragmentRoundTextStore: int32 = 3

type
    CompilerCsgBuildFragmentLifetimeSlot =
        storeKind: int32
        objectId: int32
        borrowId: int32
        retainedBytes: int64
        physicalBufferCount: int32
        active: bool
        releasePrepared: bool

    CompilerCsgBuildFragmentLifetimeReceipt =
        outcome: int32
        allocated: int64
        released: int64
        live: int64
        allocatedBytes: int64
        releasedBytes: int64
        liveBytes: int64
        retained: int64
        ownerTransferCount: int64
        borrowReturnCount: int64
        physicalStoreCount: int32
        physicalStoreFreeCount: int32
        physicalBufferCount: int32
        physicalBufferFreeCount: int32
        physicalReleasedBytes: int64
        storageReleased: bool
        ledgerStorageReleased: bool
        ledgerStorageReleasedSequenceCount: int32
        ledgerStorageReleasedBufferCount: int32
        ledgerStorageReleasedBytes: int64

    CompilerCsgBuildFragmentLifetime =
        ledger: lifetime.LifetimeLedger
        categoryId: int32
        producerOwnerId: int32
        consumerOwnerId: int32
        registeredStoreMask: int32
        registeredStoreCount: int32
        physicalBufferCount: int32
        retainedBytes: int64
        releasedStoreCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        active: bool

fn compilerCsgBuildFragmentLifetimeFail(message: str) =
    panic(message)

fn compilerCsgBuildFragmentStoreBit(storeKind: int32): int32 =
    if storeKind == CompilerCsgBuildFragmentGraphNodeStore:
        return 1
    if storeKind == CompilerCsgBuildFragmentLineStore:
        return 2
    if storeKind == CompilerCsgBuildFragmentRoundTextStore:
        return 4
    compilerCsgBuildFragmentLifetimeFail(
        "compiler csg build fragment lifetime: invalid store kind")
    return 0

fn CompilerCsgBuildFragmentLifetimeBegin(
        state: var CompilerCsgBuildFragmentLifetime) =
    if state.active || state.registeredStoreCount != 0 ||
       state.releasedStoreCount != 0:
        compilerCsgBuildFragmentLifetimeFail(
            "compiler csg build fragment lifetime: duplicate begin")
    lifetime.LifetimeLedgerInit(state.ledger)
    state.categoryId = lifetime.LifetimeLedgerRegisterCategory(
        state.ledger, "compiler_csg_phase_arena_store")
    state.producerOwnerId = lifetime.LifetimeLedgerRegisterOwner(
        state.ledger, "compiler_csg_build_working_set")
    state.consumerOwnerId = lifetime.LifetimeLedgerRegisterOwner(
        state.ledger, "compiler_csg_phase_consumer")
    state.active = true

fn CompilerCsgBuildFragmentLifetimeStoreBegin(
        state: var CompilerCsgBuildFragmentLifetime,
        slot: var CompilerCsgBuildFragmentLifetimeSlot,
        storeKind: int32,
        retainedBytes: int64,
        physicalBufferCount: int32) =
    if !state.active || slot.active || slot.objectId != 0 ||
       retainedBytes <= int64(0) || physicalBufferCount <= 0:
        compilerCsgBuildFragmentLifetimeFail(
            "compiler csg build fragment lifetime: invalid store begin")
    let storeBit = compilerCsgBuildFragmentStoreBit(storeKind)
    if (state.registeredStoreMask & storeBit) != 0:
        compilerCsgBuildFragmentLifetimeFail(
            "compiler csg build fragment lifetime: duplicate store kind")
    slot.storeKind = storeKind
    slot.retainedBytes = retainedBytes
    slot.physicalBufferCount = physicalBufferCount
    slot.objectId = lifetime.LifetimeLedgerReserveObject(
        state.ledger, state.categoryId, retainedBytes)
    lifetime.LifetimeLedgerOwn(
        state.ledger, slot.objectId, state.producerOwnerId)
    slot.borrowId = lifetime.LifetimeLedgerBorrow(
        state.ledger, slot.objectId, state.consumerOwnerId)
    let _ = lifetime.LifetimeLedgerRead(
        state.ledger, slot.objectId, state.consumerOwnerId)
    slot.active = true
    state.registeredStoreMask = state.registeredStoreMask | storeBit
    state.registeredStoreCount = state.registeredStoreCount + 1
    state.physicalBufferCount =
        state.physicalBufferCount + physicalBufferCount
    state.retainedBytes = state.retainedBytes + retainedBytes

fn CompilerCsgBuildFragmentLifetimePrepareStoreRelease(
        state: var CompilerCsgBuildFragmentLifetime,
        slot: var CompilerCsgBuildFragmentLifetimeSlot) =
    if !state.active || !slot.active || slot.releasePrepared ||
       slot.objectId <= 0 || slot.borrowId <= 0:
        compilerCsgBuildFragmentLifetimeFail(
            "compiler csg build fragment lifetime: invalid release prepare")
    lifetime.LifetimeLedgerReturnBorrow(
        state.ledger,
        slot.objectId,
        slot.borrowId,
        state.consumerOwnerId)
    let _ = lifetime.LifetimeLedgerRead(
        state.ledger, slot.objectId, state.producerOwnerId)
    slot.releasePrepared = true

fn CompilerCsgBuildFragmentLifetimeCommitStoreRelease(
        state: var CompilerCsgBuildFragmentLifetime,
        slot: var CompilerCsgBuildFragmentLifetimeSlot,
        physicalRelease: phase.PhaseArenaStoreDestroyReceipt) =
    if !state.active || !slot.active || !slot.releasePrepared ||
       !physicalRelease.storageReleased ||
       physicalRelease.releasedBufferCount !=
           slot.physicalBufferCount ||
       physicalRelease.releasedBytes != slot.retainedBytes:
        compilerCsgBuildFragmentLifetimeFail(
            "compiler csg build fragment lifetime: physical release mismatch")
    lifetime.LifetimeLedgerRelease(
        state.ledger, slot.objectId, state.producerOwnerId)
    state.releasedStoreCount = state.releasedStoreCount + 1
    state.releasedBufferCount =
        state.releasedBufferCount +
        physicalRelease.releasedBufferCount
    state.releasedBytes =
        state.releasedBytes + physicalRelease.releasedBytes
    slot.active = false

fn CompilerCsgBuildFragmentLifetimeEnd(
        state: var CompilerCsgBuildFragmentLifetime,
        outcome: int32,
        receipt: var CompilerCsgBuildFragmentLifetimeReceipt) =
    if !state.active || !payload.CompilerPayloadOutcomeValid(outcome) ||
       state.registeredStoreCount != state.releasedStoreCount ||
       state.physicalBufferCount != state.releasedBufferCount ||
       state.retainedBytes != state.releasedBytes:
        compilerCsgBuildFragmentLifetimeFail(
            "compiler csg build fragment lifetime: incomplete terminal release")
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.producerOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.consumerOwnerId)
    lifetime.LifetimeLedgerAssertClosed(state.ledger)
    var metrics: lifetime.LifetimeLedgerMetrics
    lifetime.LifetimeLedgerReadTotalMetrics(state.ledger, metrics)
    let expectedStoreCount = Int64(state.registeredStoreCount)
    if metrics.allocated != expectedStoreCount ||
       metrics.released != expectedStoreCount ||
       metrics.live != int64(0) ||
       metrics.allocatedBytes != state.retainedBytes ||
       metrics.releasedBytes != state.retainedBytes ||
       metrics.liveBytes != int64(0) ||
       metrics.retained != expectedStoreCount ||
       metrics.borrowReturnCount != expectedStoreCount ||
       metrics.ownerTransferCount != int64(0):
        compilerCsgBuildFragmentLifetimeFail(
            "compiler csg build fragment lifetime: terminal ledger mismatch")

    receipt.outcome = outcome
    receipt.allocated = metrics.allocated
    receipt.released = metrics.released
    receipt.live = metrics.live
    receipt.allocatedBytes = metrics.allocatedBytes
    receipt.releasedBytes = metrics.releasedBytes
    receipt.liveBytes = metrics.liveBytes
    receipt.retained = metrics.retained
    receipt.ownerTransferCount = metrics.ownerTransferCount
    receipt.borrowReturnCount = metrics.borrowReturnCount
    receipt.physicalStoreCount = state.registeredStoreCount
    receipt.physicalStoreFreeCount = state.releasedStoreCount
    receipt.physicalBufferCount = state.physicalBufferCount
    receipt.physicalBufferFreeCount = state.releasedBufferCount
    receipt.physicalReleasedBytes = state.releasedBytes
    receipt.storageReleased =
        state.registeredStoreCount == state.releasedStoreCount &&
        state.physicalBufferCount == state.releasedBufferCount &&
        state.retainedBytes == state.releasedBytes

    let ledgerStorageRelease =
        lifetime.LifetimeLedgerReleaseStorage(state.ledger)
    receipt.ledgerStorageReleased =
        ledgerStorageRelease.storageReleased
    receipt.ledgerStorageReleasedSequenceCount =
        ledgerStorageRelease.releasedSequenceCount
    receipt.ledgerStorageReleasedBufferCount =
        ledgerStorageRelease.releasedSequenceBufferCount
    receipt.ledgerStorageReleasedBytes =
        ledgerStorageRelease.releasedSequenceCapacityBytes
    if !receipt.ledgerStorageReleased ||
       receipt.ledgerStorageReleasedSequenceCount != 6 ||
       receipt.ledgerStorageReleasedBufferCount <= 0 ||
       receipt.ledgerStorageReleasedBytes <= int64(0):
        compilerCsgBuildFragmentLifetimeFail(
            "compiler csg build fragment lifetime: ledger storage release failed")
    state.active = false

@borrows
fn CompilerCsgBuildFragmentLifetimeReceiptClosed(
        receipt: CompilerCsgBuildFragmentLifetimeReceipt): bool =
    return payload.CompilerPayloadOutcomeValid(receipt.outcome) &&
           receipt.allocated >= int64(0) &&
           receipt.allocated <= int64(3) &&
           receipt.allocated == receipt.released &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes >= int64(0) &&
           receipt.allocatedBytes == receipt.releasedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.retained == receipt.allocated &&
           receipt.borrowReturnCount == receipt.retained &&
           receipt.ownerTransferCount == int64(0) &&
           receipt.physicalStoreCount >= 0 &&
           receipt.physicalStoreCount <= 3 &&
           receipt.physicalStoreFreeCount ==
               receipt.physicalStoreCount &&
           Int64(receipt.physicalStoreCount) ==
               receipt.allocated &&
           receipt.physicalBufferCount >= 0 &&
           receipt.physicalBufferFreeCount ==
               receipt.physicalBufferCount &&
           receipt.physicalReleasedBytes ==
               receipt.releasedBytes &&
           receipt.storageReleased &&
           receipt.ledgerStorageReleased &&
           receipt.ledgerStorageReleasedSequenceCount == 6 &&
           receipt.ledgerStorageReleasedBufferCount > 0 &&
           receipt.ledgerStorageReleasedBytes > int64(0)
