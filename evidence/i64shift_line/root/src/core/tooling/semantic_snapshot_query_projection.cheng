import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/rawbytes
import std/hashsets
import std/system
import cheng/core/csg_core/compiler_snapshot_schema as snapshot_schema
import cheng/core/tooling/semantic_snapshot as snapshot
import cheng/core/tooling/semantic_snapshot_declaration_identity as declaration

type
    SemanticSnapshotSourceDocument =
        uri: str
        documentCid: layout.FixedBytes32
        contentCid: layout.FixedBytes32
        text: str
        clientVersion: int64
        open: bool

    SemanticSnapshotQueryIndex =
        sourceVersion: int64
        csgRootCid: layout.FixedBytes32
        declarationTableCid: layout.FixedBytes32
        rootCid: layout.FixedBytes32
        indexCid: layout.FixedBytes32
        referenceStartsBySource: int32[]
        referenceCountsBySource: int32[]
        referenceRowIdsBySource: int32[]
        symbolStartsBySource: int32[]
        symbolCountsBySource: int32[]
        symbolRowIdsBySource: int32[]
        symbolNameSpanIds: int32[]
        symbolNameTokenIds: int32[]
        symbolDeclIds: int32[]
        symbolDeclKeyCids: layout.FixedBytes32[]
        symbolDeclarationRowCids: layout.FixedBytes32[]
        sourceLeafCids: layout.FixedBytes32[]
        merkleLevelStarts: int32[]
        merkleLevelCounts: int32[]
        merkleNodeCids: layout.FixedBytes32[]

    SemanticSnapshotQueryProjection =
        workspaceSessionCid: layout.FixedBytes32
        sourceVersion: int64
        bindingReceiptCid: layout.FixedBytes32
        sourceBundleCid: layout.FixedBytes32
        csgRootCid: layout.FixedBytes32
        openDocumentUniverseCid: layout.FixedBytes32
        openDocumentSourceIds: int32[]
        activeSourceStableRows: int32[]
        projectionCid: layout.FixedBytes32
        documents: SemanticSnapshotSourceDocument[]
        queryIndex: SemanticSnapshotQueryIndex

@borrows
fn projectionCidLess(
        left: layout.FixedBytes32,
        right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] != right.data[index]:
            return left.data[index] < right.data[index]
    return false

fn projectionAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, value & 255)

fn projectionAppendI64(buf: var layout.ByteBuf, value: int64) =
    let raw = UInt64(value)
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(56)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(48)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(40)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(32)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(24)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(16)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32((raw >> UInt64(8)) & UInt64(255)))
    layout.ByteBufAppendByte(buf, Int32(raw & UInt64(255)))

@borrows
fn projectionAppendText(buf: var layout.ByteBuf, value: str) =
    projectionAppendU32(buf, value.len)
    for index in 0..<value.len:
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn projectionI32SequencesEqual(left: int32[], right: int32[]): bool =
    if left.len != right.len:
        return false
    for index in 0..<left.len:
        if left[index] != right[index]:
            return false
    return true

@borrows
fn projectionCidSequencesEqual(
        left: layout.FixedBytes32[],
        right: layout.FixedBytes32[]): bool =
    if left.len != right.len:
        return false
    for index in 0..<left.len:
        if !layout.FixedBytes32Equal(left[index], right[index]):
            return false
    return true

@borrows
fn SemanticSnapshotQueryDeclarationRowCid(
        table: declaration.SemanticSnapshotDeclarationTable,
        declId: int32): layout.FixedBytes32 =
    if declId < 0 ||
       declId >= table.declIds.len ||
       declId >= table.portableDocumentPackageIds.len ||
       declId >= table.portableDocumentModulePaths.len ||
       declId >= table.portableDocumentIdentityCids.len ||
       declId >= table.ownerDeclIds.len ||
       declId >= table.declarationKinds.len ||
       declId >= table.nameSurfaceKinds.len ||
       declId >= table.canonicalNames.len ||
       declId >= table.parserValidatedNameProofCids.len ||
       declId >= table.portableSignatureTypeExpressionCids.len ||
       declId >= table.lexicalScopeCids.len ||
       declId >= table.declKeyCids.len ||
       declId >= table.ownerDepths.len ||
       declId >= table.spanStartBytes.len ||
       declId >= table.spanEndBytes.len:
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(
        320 + table.portableDocumentPackageIds[declId].len +
        table.portableDocumentModulePaths[declId].len +
        table.canonicalNames[declId].len)
    projectionAppendText(
        buf, "cheng.semantic_snapshot.query_declaration_row")
    layout.ByteBufAppendFixed32(buf, table.tableCid)
    projectionAppendU32(buf, table.maxOwnerDepth)
    projectionAppendU32(buf, table.declIds[declId])
    layout.ByteBufAppendFixed32(buf, table.declKeyCids[declId])
    projectionAppendText(
        buf, table.portableDocumentPackageIds[declId])
    projectionAppendText(
        buf, table.portableDocumentModulePaths[declId])
    layout.ByteBufAppendFixed32(
        buf, table.portableDocumentIdentityCids[declId])
    projectionAppendU32(buf, table.ownerDeclIds[declId])
    projectionAppendU32(buf, table.declarationKinds[declId])
    projectionAppendU32(buf, table.nameSurfaceKinds[declId])
    projectionAppendText(buf, table.canonicalNames[declId])
    layout.ByteBufAppendFixed32(
        buf, table.parserValidatedNameProofCids[declId])
    layout.ByteBufAppendFixed32(
        buf, table.portableSignatureTypeExpressionCids[declId])
    layout.ByteBufAppendFixed32(buf, table.lexicalScopeCids[declId])
    projectionAppendU32(buf, table.ownerDepths[declId])
    projectionAppendU32(buf, table.spanStartBytes[declId])
    projectionAppendU32(buf, table.spanEndBytes[declId])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSnapshotQueryIndexCid(
        index: SemanticSnapshotQueryIndex): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(224)
    projectionAppendText(buf, "cheng.semantic_snapshot.query_index")
    projectionAppendI64(buf, index.sourceVersion)
    layout.ByteBufAppendFixed32(buf, index.csgRootCid)
    layout.ByteBufAppendFixed32(buf, index.declarationTableCid)
    layout.ByteBufAppendFixed32(buf, index.rootCid)
    projectionAppendU32(buf, index.sourceLeafCids.len)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSnapshotQueryIndexesEqual(
        left: SemanticSnapshotQueryIndex,
        right: SemanticSnapshotQueryIndex): bool =
    return left.sourceVersion == right.sourceVersion &&
        layout.FixedBytes32Equal(left.csgRootCid, right.csgRootCid) &&
        layout.FixedBytes32Equal(
            left.declarationTableCid, right.declarationTableCid) &&
        layout.FixedBytes32Equal(left.rootCid, right.rootCid) &&
        layout.FixedBytes32Equal(left.indexCid, right.indexCid) &&
        projectionI32SequencesEqual(
            left.referenceStartsBySource, right.referenceStartsBySource) &&
        projectionI32SequencesEqual(
            left.referenceCountsBySource, right.referenceCountsBySource) &&
        projectionI32SequencesEqual(
            left.referenceRowIdsBySource, right.referenceRowIdsBySource) &&
        projectionI32SequencesEqual(
            left.symbolStartsBySource, right.symbolStartsBySource) &&
        projectionI32SequencesEqual(
            left.symbolCountsBySource, right.symbolCountsBySource) &&
        projectionI32SequencesEqual(
            left.symbolRowIdsBySource, right.symbolRowIdsBySource) &&
        projectionI32SequencesEqual(
            left.symbolNameSpanIds, right.symbolNameSpanIds) &&
        projectionI32SequencesEqual(
            left.symbolNameTokenIds, right.symbolNameTokenIds) &&
        projectionI32SequencesEqual(
            left.symbolDeclIds, right.symbolDeclIds) &&
        projectionCidSequencesEqual(
            left.symbolDeclKeyCids, right.symbolDeclKeyCids) &&
        projectionCidSequencesEqual(
            left.symbolDeclarationRowCids,
            right.symbolDeclarationRowCids) &&
        projectionCidSequencesEqual(
            left.sourceLeafCids, right.sourceLeafCids) &&
        projectionI32SequencesEqual(
            left.merkleLevelStarts, right.merkleLevelStarts) &&
        projectionI32SequencesEqual(
            left.merkleLevelCounts, right.merkleLevelCounts) &&
        projectionCidSequencesEqual(
            left.merkleNodeCids, right.merkleNodeCids)

@borrows
fn semanticSnapshotQueryDeclarationRowsStrictValidateInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        err: var str): bool =
    let symbolCount = tables.symbols.symbolCids.len
    if symbolCount == 0:
        if tables.symbols.declIds.len != 0 ||
           tables.symbols.declKeyCids.len != 0:
            err = " semantic snapshot query index: empty declaration mapping drift"
            return false
        err = ""
        return true
    if tables.symbols.declIds.len != symbolCount ||
       tables.symbols.declKeyCids.len != symbolCount ||
       tables.symbols.ownerSymbolIds.len != symbolCount ||
       tables.symbols.symbolKinds.len != symbolCount ||
       tables.symbols.typeIds.len != symbolCount ||
       !declaration.SemanticSnapshotDeclarationTableStrictValidateInto(
           tables.declarations, err) ||
       layout.FixedBytes32Equal(
           tables.declarations.tableCid, layout.FixedBytes32()) ||
       tables.declarations.portableSignatureTypeExpressionCids.len !=
           tables.declarations.declIds.len ||
       tables.declarations.parserValidatedNameProofCids.len !=
           tables.declarations.declIds.len:
        err = " semantic snapshot query index: declaration authority unavailable"
        return false
    for symbolId in 0..<symbolCount:
        let declId = tables.symbols.declIds[symbolId]
        let ownerSymbolId = tables.symbols.ownerSymbolIds[symbolId]
        let symbolKind = tables.symbols.symbolKinds[symbolId]
        let typeId = tables.symbols.typeIds[symbolId]
        if declId < 0 || declId >= tables.declarations.declIds.len ||
           tables.declarations.declIds[declId] != declId ||
           !layout.FixedBytes32Equal(
               tables.symbols.declKeyCids[symbolId],
               tables.declarations.declKeyCids[declId]) ||
           !snapshot_schema.CsgCompilerDeclarationKindMatchesSymbolKind(
               symbolKind,
               tables.declarations.declarationKinds[declId]) ||
           (symbolKind == snapshot_schema.CsgCompilerSymbolModule &&
            typeId != -1) ||
           (symbolKind != snapshot_schema.CsgCompilerSymbolModule &&
            (typeId < 0 || typeId >= tables.types.typeCids.len ||
             !layout.FixedBytes32Equal(
                 tables.types.typeCids[typeId],
                 tables.declarations.portableSignatureTypeExpressionCids[
                     declId]))) ||
           layout.FixedBytes32Equal(
               tables.declarations.parserValidatedNameProofCids[declId],
               layout.FixedBytes32()):
            err = " semantic snapshot query index: declaration row drift"
            return false
        let ownerDeclId = tables.declarations.ownerDeclIds[declId]
        if (symbolKind == snapshot_schema.CsgCompilerSymbolModule &&
            (ownerDeclId != -1 || ownerSymbolId != -1)) ||
           (symbolKind != snapshot_schema.CsgCompilerSymbolModule &&
            (ownerDeclId < 0 || ownerSymbolId < 0 ||
             ownerSymbolId >= tables.symbols.declIds.len ||
             tables.symbols.declIds[ownerSymbolId] != ownerDeclId)):
            err = " semantic snapshot query index: declaration owner drift"
            return false
    err = ""
    return true

@borrows
fn semanticSnapshotQuerySymbolColumnsShapeValid(
        tables: snapshot_schema.CsgCompilerSnapshotTables): bool =
    let count = tables.symbols.symbolCids.len
    return count == tables.symbols.interfaceCids.len &&
        count == tables.symbols.declIds.len &&
        count == tables.symbols.declKeyCids.len &&
        count == tables.symbols.declarationHeaderCids.len &&
        count == tables.symbols.declarationPathCids.len &&
        count == tables.symbols.sourceIds.len &&
        count == tables.symbols.nameTextIds.len &&
        count == tables.symbols.nameSpanIds.len &&
        count == tables.symbols.nameTokenIds.len &&
        count == tables.symbols.qualifiedNameTextIds.len &&
        count == tables.symbols.symbolKinds.len &&
        count == tables.symbols.typeIds.len &&
        count == tables.symbols.declarationSpanIds.len &&
        count == tables.symbols.ownerSymbolIds.len &&
        count == tables.symbols.functionIds.len &&
        count == tables.symbols.exportedFlags.len &&
        count == tables.symbols.genericConstraintStarts.len &&
        count == tables.symbols.genericConstraintCounts.len

@borrows
fn semanticSnapshotQueryReferenceColumnsShapeValid(
        tables: snapshot_schema.CsgCompilerSnapshotTables): bool =
    let count = tables.references.sourceIds.len
    return count == tables.references.spanIds.len &&
        count == tables.references.ownerFunctionIds.len &&
        count == tables.references.ownerSymbolIds.len &&
        count == tables.references.targetSymbolIds.len &&
        count == tables.references.referenceKinds.len &&
        count == tables.references.bindingTypedNodeIds.len

@borrows
fn semanticSnapshotQueryAppendSymbolRowInto(
        buf: var layout.ByteBuf,
        index: SemanticSnapshotQueryIndex,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        symbolId: int32,
        sourceId: int32,
        err: var str): bool =
    let symbolCount = tables.symbols.symbolCids.len
    if symbolId < 0 || symbolId >= symbolCount ||
       tables.symbols.sourceIds[symbolId] != sourceId ||
       symbolId >= index.symbolNameSpanIds.len ||
       symbolId >= index.symbolNameTokenIds.len ||
       symbolId >= index.symbolDeclIds.len ||
       symbolId >= index.symbolDeclKeyCids.len ||
       symbolId >= index.symbolDeclarationRowCids.len:
        err = " semantic snapshot query index: source Symbol row invalid"
        return false
    let typeId = tables.symbols.typeIds[symbolId]
    let constraintStart =
        tables.symbols.genericConstraintStarts[symbolId]
    let constraintCount =
        tables.symbols.genericConstraintCounts[symbolId]
    if typeId < -1 || typeId >= tables.types.typeCids.len ||
       constraintStart < 0 || constraintCount < 0 ||
       constraintStart > tables.symbols.genericConstraintTypeIds.len ||
       constraintCount >
           tables.symbols.genericConstraintTypeIds.len - constraintStart:
        err = " semantic snapshot query index: source Symbol type row invalid"
        return false
    let declId = tables.symbols.declIds[symbolId]
    let declarationRowCid =
        SemanticSnapshotQueryDeclarationRowCid(
            tables.declarations, declId)
    if layout.FixedBytes32Equal(declarationRowCid, layout.FixedBytes32()) ||
       index.symbolNameSpanIds[symbolId] !=
           tables.symbols.nameSpanIds[symbolId] ||
       index.symbolNameTokenIds[symbolId] !=
           tables.symbols.nameTokenIds[symbolId] ||
       index.symbolDeclIds[symbolId] != declId ||
       !layout.FixedBytes32Equal(
           index.symbolDeclKeyCids[symbolId],
           tables.symbols.declKeyCids[symbolId]) ||
       !layout.FixedBytes32Equal(
           index.symbolDeclarationRowCids[symbolId],
           declarationRowCid):
        err = " semantic snapshot query index: cached Symbol row drift"
        return false
    projectionAppendU32(buf, symbolId)
    layout.ByteBufAppendFixed32(buf, tables.symbols.symbolCids[symbolId])
    layout.ByteBufAppendFixed32(buf, tables.symbols.interfaceCids[symbolId])
    projectionAppendU32(buf, declId)
    layout.ByteBufAppendFixed32(buf, tables.symbols.declKeyCids[symbolId])
    layout.ByteBufAppendFixed32(
        buf, tables.symbols.declarationHeaderCids[symbolId])
    layout.ByteBufAppendFixed32(
        buf, tables.symbols.declarationPathCids[symbolId])
    projectionAppendU32(buf, sourceId)
    projectionAppendU32(buf, tables.symbols.nameTextIds[symbolId])
    projectionAppendU32(buf, tables.symbols.nameSpanIds[symbolId])
    projectionAppendU32(buf, tables.symbols.nameTokenIds[symbolId])
    projectionAppendU32(
        buf, tables.symbols.qualifiedNameTextIds[symbolId])
    projectionAppendU32(buf, tables.symbols.symbolKinds[symbolId])
    projectionAppendU32(buf, typeId)
    if typeId >= 0:
        layout.ByteBufAppendFixed32(buf, tables.types.typeCids[typeId])
    else:
        layout.ByteBufAppendFixed32(buf, layout.FixedBytes32())
    projectionAppendU32(
        buf, tables.symbols.declarationSpanIds[symbolId])
    projectionAppendU32(buf, tables.symbols.ownerSymbolIds[symbolId])
    projectionAppendU32(buf, tables.symbols.functionIds[symbolId])
    projectionAppendU32(
        buf, tables.symbols.exportedFlags[symbolId] ? 1 : 0)
    projectionAppendU32(buf, constraintStart)
    projectionAppendU32(buf, constraintCount)
    for offset in 0..<constraintCount:
        let constraintTypeId =
            tables.symbols.genericConstraintTypeIds[
                constraintStart + offset]
        if constraintTypeId < 0 ||
           constraintTypeId >= tables.types.typeCids.len:
            err = " semantic snapshot query index: generic TypeId invalid"
            return false
        projectionAppendU32(buf, constraintTypeId)
        layout.ByteBufAppendFixed32(
            buf, tables.types.typeCids[constraintTypeId])
    layout.ByteBufAppendFixed32(buf, declarationRowCid)
    return true

@borrows
fn semanticSnapshotQueryAppendReferenceRowInto(
        buf: var layout.ByteBuf,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        referenceRow: int32,
        sourceId: int32,
        err: var str): bool =
    let referenceCount = tables.references.sourceIds.len
    if referenceRow < 0 || referenceRow >= referenceCount ||
       tables.references.sourceIds[referenceRow] != sourceId:
        err = " semantic snapshot query index: source Reference row invalid"
        return false
    let spanId = tables.references.spanIds[referenceRow]
    let ownerSymbolId = tables.references.ownerSymbolIds[referenceRow]
    let targetSymbolId = tables.references.targetSymbolIds[referenceRow]
    let symbolCount = tables.symbols.symbolCids.len
    if spanId < 0 || spanId >= tables.spans.sourceIds.len ||
       spanId >= tables.spans.startBytes.len ||
       spanId >= tables.spans.endBytes.len ||
       spanId >= tables.spans.startLines.len ||
       spanId >= tables.spans.startColumns.len ||
       spanId >= tables.spans.endLines.len ||
       spanId >= tables.spans.endColumns.len ||
       tables.spans.sourceIds[spanId] != sourceId ||
       ownerSymbolId < 0 || ownerSymbolId >= symbolCount ||
       targetSymbolId < 0 || targetSymbolId >= symbolCount:
        err = " semantic snapshot query index: Reference authority invalid"
        return false
    projectionAppendU32(buf, referenceRow)
    projectionAppendU32(buf, sourceId)
    projectionAppendU32(buf, spanId)
    projectionAppendU32(
        buf, tables.references.ownerFunctionIds[referenceRow])
    projectionAppendU32(buf, ownerSymbolId)
    layout.ByteBufAppendFixed32(
        buf, tables.symbols.symbolCids[ownerSymbolId])
    layout.ByteBufAppendFixed32(
        buf, tables.symbols.declKeyCids[ownerSymbolId])
    projectionAppendU32(
        buf, tables.symbols.symbolKinds[ownerSymbolId])
    projectionAppendU32(buf, targetSymbolId)
    layout.ByteBufAppendFixed32(
        buf, tables.symbols.symbolCids[targetSymbolId])
    layout.ByteBufAppendFixed32(
        buf, tables.symbols.declKeyCids[targetSymbolId])
    projectionAppendU32(
        buf, tables.symbols.symbolKinds[targetSymbolId])
    projectionAppendU32(
        buf, tables.references.referenceKinds[referenceRow])
    projectionAppendU32(
        buf, tables.references.bindingTypedNodeIds[referenceRow])
    projectionAppendU32(buf, tables.spans.startBytes[spanId])
    projectionAppendU32(buf, tables.spans.endBytes[spanId])
    projectionAppendU32(buf, tables.spans.startLines[spanId])
    projectionAppendU32(buf, tables.spans.startColumns[spanId])
    projectionAppendU32(buf, tables.spans.endLines[spanId])
    projectionAppendU32(buf, tables.spans.endColumns[spanId])
    return true

@borrows
fn semanticSnapshotQuerySourceLeafCidInto(
        index: SemanticSnapshotQueryIndex,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        out: var layout.FixedBytes32,
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    if sourceId < 0 || sourceId >= sourceCount ||
       index.referenceStartsBySource.len != sourceCount ||
       index.referenceCountsBySource.len != sourceCount ||
       index.symbolStartsBySource.len != sourceCount ||
       index.symbolCountsBySource.len != sourceCount:
        err = " semantic snapshot query index: source leaf shape invalid"
        return false
    let referenceStart = index.referenceStartsBySource[sourceId]
    let referenceCount = index.referenceCountsBySource[sourceId]
    let symbolStart = index.symbolStartsBySource[sourceId]
    let symbolCount = index.symbolCountsBySource[sourceId]
    if referenceStart < 0 || referenceCount < 0 ||
       referenceStart > index.referenceRowIdsBySource.len ||
       referenceCount >
           index.referenceRowIdsBySource.len - referenceStart ||
       symbolStart < 0 || symbolCount < 0 ||
       symbolStart > index.symbolRowIdsBySource.len ||
       symbolCount > index.symbolRowIdsBySource.len - symbolStart:
        err = " semantic snapshot query index: source leaf range invalid"
        return false
    # Avoid attacker-controlled int32 capacity arithmetic; ByteBuf growth is
    # checked and the source slice itself remains the only linear work.
    var buf = layout.ByteBufInit(512)
    projectionAppendText(
        buf, "cheng.semantic_snapshot.query_index.source_leaf")
    projectionAppendI64(buf, index.sourceVersion)
    layout.ByteBufAppendFixed32(buf, index.csgRootCid)
    layout.ByteBufAppendFixed32(buf, index.declarationTableCid)
    projectionAppendU32(buf, sourceId)
    layout.ByteBufAppendFixed32(
        buf, tables.sources.documentCids[sourceId])
    projectionAppendU32(buf, referenceCount)
    for offset in 0..<referenceCount:
        let rowIndex = referenceStart + offset
        let referenceRow = index.referenceRowIdsBySource[rowIndex]
        if offset > 0 &&
           referenceRow <=
               index.referenceRowIdsBySource[rowIndex - 1]:
            layout.ByteBufFree(buf)
            err = " semantic snapshot query index: Reference slice not canonical"
            return false
        if !semanticSnapshotQueryAppendReferenceRowInto(
                buf, tables, referenceRow, sourceId, err):
            layout.ByteBufFree(buf)
            return false
    projectionAppendU32(buf, symbolCount)
    for offset in 0..<symbolCount:
        let rowIndex = symbolStart + offset
        let symbolId = index.symbolRowIdsBySource[rowIndex]
        if offset > 0 &&
           symbolId <= index.symbolRowIdsBySource[rowIndex - 1]:
            layout.ByteBufFree(buf)
            err = " semantic snapshot query index: Symbol slice not canonical"
            return false
        if !semanticSnapshotQueryAppendSymbolRowInto(
                buf, index, tables, symbolId, sourceId, err):
            layout.ByteBufFree(buf)
            return false
    out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    err = ""
    return true

@borrows
fn semanticSnapshotQueryMerklePairCid(
        index: SemanticSnapshotQueryIndex,
        parentLevel: int32,
        parentIndex: int32,
        left: layout.FixedBytes32,
        right: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(256)
    projectionAppendText(
        buf, "cheng.semantic_snapshot.query_index.merkle_pair")
    projectionAppendI64(buf, index.sourceVersion)
    layout.ByteBufAppendFixed32(buf, index.csgRootCid)
    layout.ByteBufAppendFixed32(buf, index.declarationTableCid)
    projectionAppendU32(buf, parentLevel)
    projectionAppendU32(buf, parentIndex)
    layout.ByteBufAppendFixed32(buf, left)
    layout.ByteBufAppendFixed32(buf, right)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSnapshotQueryMerkleCarryCid(
        index: SemanticSnapshotQueryIndex,
        parentLevel: int32,
        parentIndex: int32,
        child: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(224)
    projectionAppendText(
        buf, "cheng.semantic_snapshot.query_index.merkle_carry")
    projectionAppendI64(buf, index.sourceVersion)
    layout.ByteBufAppendFixed32(buf, index.csgRootCid)
    layout.ByteBufAppendFixed32(buf, index.declarationTableCid)
    projectionAppendU32(buf, parentLevel)
    projectionAppendU32(buf, parentIndex)
    layout.ByteBufAppendFixed32(buf, child)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn semanticSnapshotQueryMerkleRootCid(
        index: SemanticSnapshotQueryIndex,
        sourceCount: int32,
        top: layout.FixedBytes32): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(224)
    projectionAppendText(
        buf, "cheng.semantic_snapshot.query_index.merkle_root")
    projectionAppendI64(buf, index.sourceVersion)
    layout.ByteBufAppendFixed32(buf, index.csgRootCid)
    layout.ByteBufAppendFixed32(buf, index.declarationTableCid)
    projectionAppendU32(buf, sourceCount)
    projectionAppendU32(buf, index.merkleLevelStarts.len)
    layout.ByteBufAppendFixed32(buf, top)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn semanticSnapshotQueryMerkleBuildInto(
        input: SemanticSnapshotQueryIndex,
        out: var SemanticSnapshotQueryIndex,
        err: var str): bool =
    var index = input
    let sourceCount = index.sourceLeafCids.len
    if sourceCount <= 0:
        err = " semantic snapshot query index: empty Merkle tree"
        return false
    index.merkleLevelStarts = [0]
    index.merkleLevelCounts = [sourceCount]
    for sourceId in 0..<sourceCount:
        add(index.merkleNodeCids, index.sourceLeafCids[sourceId])
    var childLevel: int32
    var childStart: int32
    var childCount = sourceCount
    while childCount > 1:
        let parentLevel = childLevel + 1
        let parentStart = index.merkleNodeCids.len
        let parentCount = (childCount + 1) / 2
        add(index.merkleLevelStarts, parentStart)
        add(index.merkleLevelCounts, parentCount)
        for parentIndex in 0..<parentCount:
            let leftIndex = childStart + parentIndex * 2
            let rightOffset = parentIndex * 2 + 1
            if rightOffset < childCount:
                add(index.merkleNodeCids,
                    semanticSnapshotQueryMerklePairCid(
                        index, parentLevel, parentIndex,
                        index.merkleNodeCids[leftIndex],
                        index.merkleNodeCids[childStart + rightOffset]))
            else:
                add(index.merkleNodeCids,
                    semanticSnapshotQueryMerkleCarryCid(
                        index, parentLevel, parentIndex,
                        index.merkleNodeCids[leftIndex]))
        childLevel = parentLevel
        childStart = parentStart
        childCount = parentCount
    index.rootCid = semanticSnapshotQueryMerkleRootCid(
        index, sourceCount,
        index.merkleNodeCids[
            index.merkleLevelStarts[
                index.merkleLevelStarts.len - 1]])
    if layout.FixedBytes32Equal(index.rootCid, layout.FixedBytes32()):
        err = " semantic snapshot query index: Merkle root unavailable"
        return false
    out = index
    err = ""
    return true

@borrows
fn SemanticSnapshotQueryIndexBuildInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sourceVersion: int64,
        csgRootCid: layout.FixedBytes32,
        out: var SemanticSnapshotQueryIndex,
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    if sourceVersion <= 0 || sourceCount <= 0 ||
       layout.FixedBytes32Equal(csgRootCid, layout.FixedBytes32()):
        err = " semantic snapshot query index: invalid identity"
        return false
    if !semanticSnapshotQueryDeclarationRowsStrictValidateInto(tables, err):
        return false
    if !semanticSnapshotQueryReferenceColumnsShapeValid(tables) ||
       !semanticSnapshotQuerySymbolColumnsShapeValid(tables):
        err = " semantic snapshot query index: exact query columns unavailable"
        return false
    var moduleDeclarationRows: int32[]
    if !snapshot_schema.CsgCompilerModuleParserDeclarationRowsBySourceInto(
            tables, moduleDeclarationRows, err):
        return false
    var index: SemanticSnapshotQueryIndex
    index.sourceVersion = sourceVersion
    index.csgRootCid = layout.FixedBytes32Copy(csgRootCid)
    index.declarationTableCid =
        layout.FixedBytes32Copy(tables.declarations.tableCid)
    setLen(index.referenceStartsBySource, sourceCount)
    setLen(index.referenceCountsBySource, sourceCount)
    for referenceRow in 0..<tables.references.sourceIds.len:
        let sourceId = tables.references.sourceIds[referenceRow]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " semantic snapshot query index: reference source out of range"
            return false
        index.referenceCountsBySource[sourceId] =
            index.referenceCountsBySource[sourceId] + 1
    var referenceCursor: int32
    for sourceId in 0..<sourceCount:
        index.referenceStartsBySource[sourceId] = referenceCursor
        referenceCursor = referenceCursor +
            index.referenceCountsBySource[sourceId]
    setLen(index.referenceRowIdsBySource, referenceCursor)
    var sourceCursors: int32[]
    setLen(sourceCursors, sourceCount)
    for sourceId in 0..<sourceCount:
        sourceCursors[sourceId] = index.referenceStartsBySource[sourceId]
    for referenceRow in 0..<tables.references.sourceIds.len:
        let sourceId = tables.references.sourceIds[referenceRow]
        index.referenceRowIdsBySource[sourceCursors[sourceId]] = referenceRow
        sourceCursors[sourceId] = sourceCursors[sourceId] + 1

    let symbolCount = tables.symbols.symbolCids.len
    setLen(index.symbolStartsBySource, sourceCount)
    setLen(index.symbolCountsBySource, sourceCount)
    for symbolId in 0..<symbolCount:
        let sourceId = tables.symbols.sourceIds[symbolId]
        if sourceId < 0 || sourceId >= sourceCount:
            err = " semantic snapshot query index: symbol source out of range"
            return false
        index.symbolCountsBySource[sourceId] =
            index.symbolCountsBySource[sourceId] + 1
    var symbolCursor: int32
    for sourceId in 0..<sourceCount:
        index.symbolStartsBySource[sourceId] = symbolCursor
        symbolCursor = symbolCursor + index.symbolCountsBySource[sourceId]
        sourceCursors[sourceId] = index.symbolStartsBySource[sourceId]
    setLen(index.symbolRowIdsBySource, symbolCursor)
    for symbolId in 0..<symbolCount:
        let sourceId = tables.symbols.sourceIds[symbolId]
        index.symbolRowIdsBySource[sourceCursors[sourceId]] = symbolId
        sourceCursors[sourceId] = sourceCursors[sourceId] + 1

    setLen(index.symbolNameSpanIds, symbolCount)
    setLen(index.symbolNameTokenIds, symbolCount)
    setLen(index.symbolDeclIds, symbolCount)
    setLen(index.symbolDeclKeyCids, symbolCount)
    setLen(index.symbolDeclarationRowCids, symbolCount)
    for symbolId in 0..<symbolCount:
        if !snapshot_schema.CsgCompilerSymbolSourceCoordinateAuthorityWithModuleRowsStrictValidateInto(
                tables, symbolId, moduleDeclarationRows, err):
            return false
        index.symbolNameSpanIds[symbolId] =
            tables.symbols.nameSpanIds[symbolId]
        index.symbolNameTokenIds[symbolId] =
            tables.symbols.nameTokenIds[symbolId]
        index.symbolDeclIds[symbolId] = tables.symbols.declIds[symbolId]
        index.symbolDeclKeyCids[symbolId] =
            layout.FixedBytes32Copy(
                tables.symbols.declKeyCids[symbolId])
        index.symbolDeclarationRowCids[symbolId] =
            SemanticSnapshotQueryDeclarationRowCid(
                tables.declarations, tables.symbols.declIds[symbolId])
        if layout.FixedBytes32Equal(
                index.symbolDeclarationRowCids[symbolId],
                layout.FixedBytes32()):
            err = " semantic snapshot query index: declaration row unavailable"
            return false
    setLen(index.sourceLeafCids, sourceCount)
    for sourceId in 0..<sourceCount:
        var sourceLeafCid: layout.FixedBytes32
        if !semanticSnapshotQuerySourceLeafCidInto(
                index, tables, sourceId,
                sourceLeafCid, err):
            return false
        index.sourceLeafCids[sourceId] = sourceLeafCid
    var merkleIndex: SemanticSnapshotQueryIndex
    if !semanticSnapshotQueryMerkleBuildInto(
            index, merkleIndex, err):
        return false
    index = merkleIndex
    index.indexCid = semanticSnapshotQueryIndexCid(index)
    out = index
    err = ""
    return true

@borrows
fn SemanticSnapshotQueryIndexStrictValidateInto(
        index: SemanticSnapshotQueryIndex,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sourceVersion: int64,
        csgRootCid: layout.FixedBytes32,
        err: var str): bool =
    if index.sourceVersion != sourceVersion ||
       !layout.FixedBytes32Equal(index.csgRootCid, csgRootCid) ||
       !layout.FixedBytes32Equal(
           index.declarationTableCid, tables.declarations.tableCid) ||
       layout.FixedBytes32Equal(index.rootCid, layout.FixedBytes32()) ||
       layout.FixedBytes32Equal(index.indexCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           semanticSnapshotQueryIndexCid(index), index.indexCid):
        err = " semantic snapshot query index: receipt mismatch"
        return false
    var expected: SemanticSnapshotQueryIndex
    if !SemanticSnapshotQueryIndexBuildInto(
            tables, sourceVersion, csgRootCid, expected, err):
        return false
    if !semanticSnapshotQueryIndexesEqual(index, expected):
        err = " semantic snapshot query index: canonical projection mismatch"
        return false
    err = ""
    return true

@borrows
fn semanticSnapshotQueryMerkleShapeStrictValidateInto(
        index: SemanticSnapshotQueryIndex,
        sourceCount: int32,
        err: var str): bool =
    let levelCount = index.merkleLevelStarts.len
    if sourceCount <= 0 ||
       index.sourceLeafCids.len != sourceCount ||
       levelCount <= 0 ||
       index.merkleLevelCounts.len != levelCount:
        err = " semantic snapshot query index: Merkle shape invalid"
        return false
    var expectedCount = sourceCount
    var expectedStart: int32
    for level in 0..<levelCount:
        if index.merkleLevelStarts[level] != expectedStart ||
           index.merkleLevelCounts[level] != expectedCount ||
           expectedCount <= 0 ||
           expectedStart > index.merkleNodeCids.len ||
           expectedCount >
               index.merkleNodeCids.len - expectedStart:
            err = " semantic snapshot query index: Merkle level drift"
            return false
        expectedStart = expectedStart + expectedCount
        if expectedCount > 1:
            expectedCount = (expectedCount + 1) / 2
        elif level != levelCount - 1:
            err = " semantic snapshot query index: trailing Merkle level"
            return false
    if expectedCount != 1 ||
       expectedStart != index.merkleNodeCids.len ||
       index.merkleLevelCounts[levelCount - 1] != 1:
        err = " semantic snapshot query index: incomplete Merkle tree"
        return false
    err = ""
    return true

# Current-source query validation visits only the selected source rows and one
# Merkle authentication path. Full StrictValidate remains the cold rebuild
# oracle for the complete derived index.
@borrows
fn SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
        index: SemanticSnapshotQueryIndex,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        sourceVersion: int64,
        csgRootCid: layout.FixedBytes32,
        sourceId: int32,
        expectedDocumentCid: layout.FixedBytes32,
        expectedQueryIndexRootCid: layout.FixedBytes32,
        err: var str): bool =
    let sourceCount = tables.sources.documentCids.len
    if index.sourceVersion != sourceVersion ||
       !layout.FixedBytes32Equal(index.csgRootCid, csgRootCid) ||
       !layout.FixedBytes32Equal(
           index.declarationTableCid, tables.declarations.tableCid) ||
       sourceId < 0 || sourceId >= sourceCount ||
       layout.FixedBytes32Equal(expectedDocumentCid,
                                layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           tables.sources.documentCids[sourceId], expectedDocumentCid) ||
       layout.FixedBytes32Equal(expectedQueryIndexRootCid,
                                layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           index.rootCid, expectedQueryIndexRootCid) ||
       layout.FixedBytes32Equal(index.indexCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           semanticSnapshotQueryIndexCid(index), index.indexCid) ||
       !semanticSnapshotQueryReferenceColumnsShapeValid(tables) ||
       !semanticSnapshotQuerySymbolColumnsShapeValid(tables):
        err = " semantic snapshot query index: current source identity mismatch"
        return false
    if !semanticSnapshotQueryMerkleShapeStrictValidateInto(
            index, sourceCount, err):
        return false
    var leafCid: layout.FixedBytes32
    if !semanticSnapshotQuerySourceLeafCidInto(
            index, tables, sourceId, leafCid, err):
        return false
    if !layout.FixedBytes32Equal(
           leafCid, index.sourceLeafCids[sourceId]) ||
       !layout.FixedBytes32Equal(
           leafCid,
           index.merkleNodeCids[
               index.merkleLevelStarts[0] + sourceId]):
        err = " semantic snapshot query index: source leaf mismatch"
        return false
    var nodeCid = leafCid
    var nodeInLevel = sourceId
    for parentLevel in 1..<index.merkleLevelStarts.len:
        let childLevel = parentLevel - 1
        let childStart = index.merkleLevelStarts[childLevel]
        let childCount = index.merkleLevelCounts[childLevel]
        let parentIndex = nodeInLevel / 2
        var parentCid: layout.FixedBytes32
        if nodeInLevel % 2 == 1:
            parentCid = semanticSnapshotQueryMerklePairCid(
                index, parentLevel, parentIndex,
                index.merkleNodeCids[
                    childStart + nodeInLevel - 1],
                nodeCid)
        elif nodeInLevel + 1 < childCount:
            parentCid = semanticSnapshotQueryMerklePairCid(
                index, parentLevel, parentIndex,
                nodeCid,
                index.merkleNodeCids[
                    childStart + nodeInLevel + 1])
        else:
            parentCid = semanticSnapshotQueryMerkleCarryCid(
                index, parentLevel, parentIndex, nodeCid)
        if !layout.FixedBytes32Equal(
               parentCid,
               index.merkleNodeCids[
                   index.merkleLevelStarts[parentLevel] +
                   parentIndex]):
            err = " semantic snapshot query index: Merkle sibling mismatch"
            return false
        nodeCid = parentCid
        nodeInLevel = parentIndex
    let rootCid = semanticSnapshotQueryMerkleRootCid(
        index, sourceCount, nodeCid)
    if !layout.FixedBytes32Equal(rootCid, index.rootCid) ||
       !layout.FixedBytes32Equal(
           rootCid, expectedQueryIndexRootCid):
        err = " semantic snapshot query index: validation root mismatch"
        return false
    err = ""
    return true

@borrows
fn semanticSnapshotQueryProjectionCanonicalEncodeInto(
        buf: var layout.ByteBuf,
        projection: SemanticSnapshotQueryProjection) =
    projectionAppendText(buf, "cheng.semantic_snapshot.query_projection")
    layout.ByteBufAppendFixed32(buf, projection.workspaceSessionCid)
    projectionAppendI64(buf, projection.sourceVersion)
    layout.ByteBufAppendFixed32(buf, projection.bindingReceiptCid)
    layout.ByteBufAppendFixed32(buf, projection.sourceBundleCid)
    layout.ByteBufAppendFixed32(buf, projection.csgRootCid)
    layout.ByteBufAppendFixed32(
        buf, projection.queryIndex.declarationTableCid)
    layout.ByteBufAppendFixed32(buf, projection.queryIndex.rootCid)
    layout.ByteBufAppendFixed32(buf, projection.queryIndex.indexCid)
    layout.ByteBufAppendFixed32(
        buf, projection.openDocumentUniverseCid)
    projectionAppendU32(buf, projection.openDocumentSourceIds.len)
    for openRow in 0..<projection.openDocumentSourceIds.len:
        projectionAppendU32(
            buf, projection.openDocumentSourceIds[openRow])
    projectionAppendU32(buf, projection.activeSourceStableRows.len)
    for sourceId in 0..<projection.activeSourceStableRows.len:
        projectionAppendU32(
            buf, projection.activeSourceStableRows[sourceId])
    projectionAppendU32(buf, projection.documents.len)
    for documentIndex in 0..<projection.documents.len:
        let document = projection.documents[documentIndex]
        projectionAppendText(buf, document.uri)
        layout.ByteBufAppendFixed32(buf, document.documentCid)
        layout.ByteBufAppendFixed32(buf, document.contentCid)
        projectionAppendI64(buf, document.clientVersion)
        projectionAppendU32(buf, document.open ? 1 : 0)

@borrows
fn semanticSnapshotQueryProjectionCid(
        projection: SemanticSnapshotQueryProjection): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(1024)
    semanticSnapshotQueryProjectionCanonicalEncodeInto(buf, projection)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn SemanticSnapshotQueryProjectionCanonicalRawInto(
        projection: SemanticSnapshotQueryProjection,
        out: var rawbytes.Bytes) =
    out = rawbytes.EmptyBytes()
    var buf = layout.ByteBufInit(1024)
    semanticSnapshotQueryProjectionCanonicalEncodeInto(buf, projection)
    out = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)

@borrows
fn semanticSnapshotOpenDocumentUniverseCanonicalEncodeInto(
        buf: var layout.ByteBuf,
        projection: SemanticSnapshotQueryProjection): bool =
    projectionAppendText(
        buf, "cheng.semantic_snapshot.open_document_universe")
    layout.ByteBufAppendFixed32(buf, projection.workspaceSessionCid)
    projectionAppendI64(buf, projection.sourceVersion)
    layout.ByteBufAppendFixed32(buf, projection.bindingReceiptCid)
    layout.ByteBufAppendFixed32(buf, projection.sourceBundleCid)
    layout.ByteBufAppendFixed32(buf, projection.csgRootCid)
    projectionAppendU32(buf, projection.documents.len)
    projectionAppendU32(buf, projection.openDocumentSourceIds.len)
    for openRow in 0..<projection.openDocumentSourceIds.len:
        let sourceId = projection.openDocumentSourceIds[openRow]
        if sourceId < 0 || sourceId >= projection.documents.len:
            return false
        let document = projection.documents[sourceId]
        projectionAppendU32(buf, sourceId)
        layout.ByteBufAppendFixed32(buf, document.documentCid)
        layout.ByteBufAppendFixed32(buf, document.contentCid)
        projectionAppendI64(buf, document.clientVersion)
    return true

@borrows
fn semanticSnapshotOpenDocumentUniverseCid(
        projection: SemanticSnapshotQueryProjection): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(
        320 + projection.openDocumentSourceIds.len * 72)
    if !semanticSnapshotOpenDocumentUniverseCanonicalEncodeInto(
            buf, projection):
        layout.ByteBufFree(buf)
        return layout.FixedBytes32()
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn SemanticSnapshotOpenDocumentUniverseCanonicalRawInto(
        projection: SemanticSnapshotQueryProjection,
        out: var rawbytes.Bytes): bool =
    out = rawbytes.EmptyBytes()
    var buf = layout.ByteBufInit(
        320 + projection.openDocumentSourceIds.len * 72)
    if !semanticSnapshotOpenDocumentUniverseCanonicalEncodeInto(
            buf, projection):
        layout.ByteBufFree(buf)
        return false
    out = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    return true

@borrows
fn projectionUrisStrictUniqueInto(
        documents: SemanticSnapshotSourceDocument[],
        err: var str): bool =
    var seen = hashsets.HashSetStrInit(documents.len)
    for row in 0..<documents.len:
        let uri = documents[row].uri
        if hashsets.HashSetStrHas(seen, uri):
            hashsets.HashSetStrClear(seen)
            err = " semantic snapshot query projection: duplicate URI"
            return false
        let ownedUri = system.SystemToStringStr(uri)
        hashsets.HashSetStrAdd(seen, ownedUri)
    hashsets.HashSetStrClear(seen)
    return true

@borrows
fn SemanticSnapshotQueryProjectionStrictValidateInto(
        projection: SemanticSnapshotQueryProjection,
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        binding: snapshot.LocalSourceVersionBinding,
        identity: snapshot.PortableSemanticSnapshotIdentity,
        err: var str): bool =
    if !snapshot.LocalSourceVersionBindingStrictValidateInto(
            binding, identity, err):
        return false
    if projection.sourceVersion != binding.sourceVersion ||
       projection.documents.len <= 0 ||
       !layout.FixedBytes32Equal(
           projection.workspaceSessionCid, binding.workspaceSessionCid) ||
       !layout.FixedBytes32Equal(
           projection.bindingReceiptCid, binding.bindingReceiptCid) ||
       !layout.FixedBytes32Equal(
           projection.sourceBundleCid, identity.sourceBundleCid) ||
       !layout.FixedBytes32Equal(
           projection.csgRootCid, identity.csgRootCid) ||
       binding.documentCids.len != projection.documents.len ||
       binding.activeSourceStableRows.len != projection.documents.len ||
       projection.activeSourceStableRows.len !=
           projection.documents.len ||
       tables.sources.documentCids.len != projection.documents.len ||
       tables.sources.contentCids.len != projection.documents.len:
        err = " semantic snapshot query projection: identity mismatch"
        return false
    var bindingRows: int32[]
    if !snapshot.SemanticSnapshotDocumentCidRowsCanonicalInto(
            binding.documentCids, bindingRows):
        err = " semantic snapshot query projection: duplicate binding"
        return false
    if !projectionUrisStrictUniqueInto(projection.documents, err):
        return false
    for openRow in 0..<projection.openDocumentSourceIds.len:
        let sourceId = projection.openDocumentSourceIds[openRow]
        if sourceId < 0 || sourceId >= projection.documents.len ||
           (openRow > 0 &&
            projection.openDocumentSourceIds[openRow - 1] >= sourceId):
            err = " semantic snapshot query projection: invalid open document source row"
            return false
    for sourceId in 0..<projection.activeSourceStableRows.len:
        if projection.activeSourceStableRows[sourceId] < 0 ||
           projection.activeSourceStableRows[sourceId] !=
               binding.activeSourceStableRows[sourceId]:
            err = " semantic snapshot query projection: active source stable row mismatch"
            return false
        for previousSourceId in 0..<sourceId:
            if projection.activeSourceStableRows[previousSourceId] ==
                   projection.activeSourceStableRows[sourceId]:
                err = " semantic snapshot query projection: duplicate active source stable row"
                return false
    var openRow: int32
    for documentIndex in 0..<projection.documents.len:
        let document = projection.documents[documentIndex]
        if document.uri == "" || document.clientVersion < 0 ||
           layout.FixedBytes32Equal(document.documentCid,
                                    layout.FixedBytes32()) ||
           !layout.FixedBytes32Equal(
               snapshot_schema.CsgCompilerSourceContentCid(document.text),
               document.contentCid) ||
           (documentIndex > 0 && !projectionCidLess(
               projection.documents[documentIndex - 1].documentCid,
               document.documentCid)):
            err = " semantic snapshot query projection: invalid document row"
            return false
        let bindingRow = bindingRows[documentIndex]
        if !layout.FixedBytes32Equal(
                binding.documentCids[bindingRow], document.documentCid) ||
           binding.clientVersions[bindingRow] != document.clientVersion ||
           binding.documentOpenStates[bindingRow] !=
               (document.open ? 1 : 0):
            err = " semantic snapshot query projection: binding mismatch"
            return false
        if !layout.FixedBytes32Equal(
                tables.sources.documentCids[documentIndex],
                document.documentCid) ||
           !layout.FixedBytes32Equal(
                tables.sources.contentCids[documentIndex],
                document.contentCid):
            err = " semantic snapshot query projection: source mismatch"
            return false
        if document.open:
            if openRow >= projection.openDocumentSourceIds.len ||
               projection.openDocumentSourceIds[openRow] !=
                   documentIndex:
                err = " semantic snapshot query projection: open document source coverage mismatch"
                return false
            openRow = openRow + 1
    if !SemanticSnapshotQueryIndexStrictValidateInto(
            projection.queryIndex, tables, projection.sourceVersion,
            projection.csgRootCid, err):
        return false
    if openRow != projection.openDocumentSourceIds.len ||
       layout.FixedBytes32Equal(
           projection.openDocumentUniverseCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           semanticSnapshotOpenDocumentUniverseCid(
               projection),
           projection.openDocumentUniverseCid) ||
       layout.FixedBytes32Equal(
            projection.projectionCid, layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           semanticSnapshotQueryProjectionCid(projection),
           projection.projectionCid):
        err = " semantic snapshot query projection: receipt mismatch"
        return false
    err = ""
    return true

@borrows
fn SemanticSnapshotSourceDocumentOwnedClone(
        document: SemanticSnapshotSourceDocument):
        SemanticSnapshotSourceDocument =
    var out: SemanticSnapshotSourceDocument
    out.uri = system.SystemToStringStr(document.uri)
    out.documentCid = layout.FixedBytes32Copy(document.documentCid)
    out.contentCid = layout.FixedBytes32Copy(document.contentCid)
    out.text = system.SystemToStringStr(document.text)
    out.clientVersion = document.clientVersion
    out.open = document.open
    return out

@borrows
fn SemanticSnapshotQueryProjectionBuildInto(
        tables: snapshot_schema.CsgCompilerSnapshotTables,
        binding: snapshot.LocalSourceVersionBinding,
        identity: snapshot.PortableSemanticSnapshotIdentity,
        documents: SemanticSnapshotSourceDocument[],
        out: var SemanticSnapshotQueryProjection,
        err: var str): bool =
    var queryIndex: SemanticSnapshotQueryIndex
    if !SemanticSnapshotQueryIndexBuildInto(
            tables, binding.sourceVersion, identity.csgRootCid,
            queryIndex, err):
        return false
    var projection: SemanticSnapshotQueryProjection
    projection.workspaceSessionCid =
        layout.FixedBytes32Copy(binding.workspaceSessionCid)
    projection.sourceVersion = binding.sourceVersion
    projection.bindingReceiptCid =
        layout.FixedBytes32Copy(binding.bindingReceiptCid)
    projection.sourceBundleCid =
        layout.FixedBytes32Copy(identity.sourceBundleCid)
    projection.csgRootCid = layout.FixedBytes32Copy(identity.csgRootCid)
    for sourceId in 0..<binding.activeSourceStableRows.len:
        add(projection.activeSourceStableRows,
            binding.activeSourceStableRows[sourceId])
    for documentIndex in 0..<documents.len:
        add(projection.documents,
            SemanticSnapshotSourceDocumentOwnedClone(
                documents[documentIndex]))
        if documents[documentIndex].open:
            add(projection.openDocumentSourceIds, documentIndex)
    projection.queryIndex = queryIndex
    projection.openDocumentUniverseCid =
        semanticSnapshotOpenDocumentUniverseCid(projection)
    projection.projectionCid =
        semanticSnapshotQueryProjectionCid(projection)
    if !SemanticSnapshotQueryProjectionStrictValidateInto(
            projection, tables, binding, identity, err):
        return false
    out = projection
    err = ""
    return true

@borrows
fn semanticSnapshotQueryIndexClone(
        index: SemanticSnapshotQueryIndex): SemanticSnapshotQueryIndex =
    var out: SemanticSnapshotQueryIndex
    out.sourceVersion = index.sourceVersion
    out.csgRootCid = layout.FixedBytes32Copy(index.csgRootCid)
    out.declarationTableCid =
        layout.FixedBytes32Copy(index.declarationTableCid)
    out.rootCid = layout.FixedBytes32Copy(index.rootCid)
    out.indexCid = layout.FixedBytes32Copy(index.indexCid)
    for row in 0..<index.referenceStartsBySource.len:
        add(out.referenceStartsBySource,
            index.referenceStartsBySource[row])
    for row in 0..<index.referenceCountsBySource.len:
        add(out.referenceCountsBySource,
            index.referenceCountsBySource[row])
    for row in 0..<index.referenceRowIdsBySource.len:
        add(out.referenceRowIdsBySource,
            index.referenceRowIdsBySource[row])
    for row in 0..<index.symbolStartsBySource.len:
        add(out.symbolStartsBySource, index.symbolStartsBySource[row])
    for row in 0..<index.symbolCountsBySource.len:
        add(out.symbolCountsBySource, index.symbolCountsBySource[row])
    for row in 0..<index.symbolRowIdsBySource.len:
        add(out.symbolRowIdsBySource, index.symbolRowIdsBySource[row])
    for row in 0..<index.symbolNameSpanIds.len:
        add(out.symbolNameSpanIds, index.symbolNameSpanIds[row])
    for row in 0..<index.symbolNameTokenIds.len:
        add(out.symbolNameTokenIds, index.symbolNameTokenIds[row])
    for row in 0..<index.symbolDeclIds.len:
        add(out.symbolDeclIds, index.symbolDeclIds[row])
    for row in 0..<index.symbolDeclKeyCids.len:
        add(out.symbolDeclKeyCids,
            layout.FixedBytes32Copy(index.symbolDeclKeyCids[row]))
    for row in 0..<index.symbolDeclarationRowCids.len:
        add(out.symbolDeclarationRowCids,
            layout.FixedBytes32Copy(
                index.symbolDeclarationRowCids[row]))
    for row in 0..<index.sourceLeafCids.len:
        add(out.sourceLeafCids,
            layout.FixedBytes32Copy(index.sourceLeafCids[row]))
    for row in 0..<index.merkleLevelStarts.len:
        add(out.merkleLevelStarts, index.merkleLevelStarts[row])
    for row in 0..<index.merkleLevelCounts.len:
        add(out.merkleLevelCounts, index.merkleLevelCounts[row])
    for row in 0..<index.merkleNodeCids.len:
        add(out.merkleNodeCids,
            layout.FixedBytes32Copy(index.merkleNodeCids[row]))
    return out

@borrows
fn SemanticSnapshotQueryProjectionClone(
        projection: SemanticSnapshotQueryProjection):
        SemanticSnapshotQueryProjection =
    var out: SemanticSnapshotQueryProjection
    out.workspaceSessionCid =
        layout.FixedBytes32Copy(projection.workspaceSessionCid)
    out.sourceVersion = projection.sourceVersion
    out.bindingReceiptCid =
        layout.FixedBytes32Copy(projection.bindingReceiptCid)
    out.sourceBundleCid =
        layout.FixedBytes32Copy(projection.sourceBundleCid)
    out.csgRootCid = layout.FixedBytes32Copy(projection.csgRootCid)
    out.openDocumentUniverseCid =
        layout.FixedBytes32Copy(projection.openDocumentUniverseCid)
    for sourceId in 0..<projection.activeSourceStableRows.len:
        add(out.activeSourceStableRows,
            projection.activeSourceStableRows[sourceId])
    out.projectionCid = layout.FixedBytes32Copy(projection.projectionCid)
    for documentIndex in 0..<projection.documents.len:
        add(out.documents,
            SemanticSnapshotSourceDocumentOwnedClone(
                projection.documents[documentIndex]))
    for openRow in 0..<projection.openDocumentSourceIds.len:
        add(out.openDocumentSourceIds,
            projection.openDocumentSourceIds[openRow])
    out.queryIndex = semanticSnapshotQueryIndexClone(
        projection.queryIndex)
    return out
