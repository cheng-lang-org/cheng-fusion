import std/cmdline
import std/os
import std/result
import std/strings
import std/strformat
import std/system
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_exec as sexec
import cheng/core/backend/system_link_exec_runtime as runtime
import cheng/core/runtime/production_system_link_capability as production_launcher
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/path as chengpath

@borrows
fn csgCoreNativePrintHardRed(message: str) =
    os.WriteLine(os.Get_stderr(), Fmt"HARD_RED:{message}")

fn csgCoreNativeArgs(): str[] =
    var out: str[]
    let count = cmdline.ParamCount()
    if count < 2:
        return out
    for index in 2..count:
        let value = cmdline.ParamStr(index)
        if value.len > 0:
            add(out, strings.CloneStr(value))
    return out

fn csgCoreNativeRunSystemLinkExec(): int32 =
    let rootDir = cmdline.ReadFlagOrDefault("--root", "")
    if rootDir.len <= 0:
        csgCoreNativePrintHardRed("csg_core_native_root_missing")
        return 2
    let args = csgCoreNativeArgs()
    let requestResult = creq.CompilerRequestFromArgsForCommand(
        strings.CloneStr(rootDir), args, true)
    if result.IsErr(requestResult):
        csgCoreNativePrintHardRed(result.Error(requestResult))
        return 2
    var request = result.Value(requestResult)
    if request.reportPath.len <= 0:
        csgCoreNativePrintHardRed("csg_core_native_report_path_missing")
        return 2
    var plan: sexec.SystemLinkExecPlan
    var planError: str
    if !sexec.BuildSystemLinkExecPlanWithWorldAndChannelInto(
           rootDir,
           request,
           cmdline.ReadFlagOrDefault("--world-head", ""),
           cmdline.ReadFlagOrDefault("--lock", ""),
           cmdline.ReadFlagOrDefault("--baseline-surface", ""),
           cmdline.ReadFlagOrDefault("--channel", "stable"),
           plan,
           planError):
        csgCoreNativePrintHardRed(planError)
        return 2
    if !sexec.SystemLinkExecPlanReady(plan):
        csgCoreNativePrintHardRed("csg_core_native_plan_not_ready")
        return 2
    var execution: runtime.SystemLinkExecRuntimeResult
    var executionError: str
    if !runtime.SystemLinkExecRuntimeExecutePlanWithCompilerInto(
           execution,
           executionError,
           rootDir,
           plan,
           ""):
        csgCoreNativePrintHardRed(executionError)
        return 2
    if !chengpath.FileExistsNonEmpty(rootDir, request.outputPath):
        csgCoreNativePrintHardRed("csg_core_native_output_missing")
        return 2
    if request.emitKind == creq.EmitExe:
        let mapPath = Fmt"{request.outputPath}.map"
        if !chengpath.FileExistsNonEmpty(rootDir, mapPath):
            csgCoreNativePrintHardRed("csg_core_native_map_missing")
            return 2
    let reportText = Fmt"{sexec.SystemLinkExecPlanReport(plan)}{runtime.SystemLinkExecRuntimeResultReport(execution)}"
    if !chengpath.WriteTextFile(
           rootDir, request.reportPath, reportText) ||
       !chengpath.FileExistsNonEmpty(rootDir, request.reportPath):
        csgCoreNativePrintHardRed("csg_core_native_report_missing")
        return 2
    let outputCid =
        Fmt"sha256:{layout.FixedBytes32Hex(execution.outputSha256)}"
    let compileReceiptCid =
        Fmt"sha256:{layout.FixedBytes32Hex(execution.compileReceiptCid)}"
    let compileReceiptCanonical =
        ccsg.CompileReceiptReport(plan.compileReceipt)
    var verifiedCompileReceipt: ccsg.CompileReceipt
    let compileReceiptParse = ccsg.CompileReceiptFromReportText(
        compileReceiptCanonical, verifiedCompileReceipt)
    if IsErr(compileReceiptParse) ||
       !layout.FixedBytes32Equal(
           verifiedCompileReceipt.receiptCid,
           execution.compileReceiptCid):
        csgCoreNativePrintHardRed(
            "csg_core_native_compile_receipt_canonical_invalid")
        return 2
    let outputAbsolutePath =
        chengpath.PathAbsolute(rootDir, request.outputPath)
    let outputHostPath =
        chengpath.PathHostFilePath(outputAbsolutePath)
    if outputHostPath.len <= 0:
        csgCoreNativePrintHardRed("csg_core_native_output_path_invalid")
        return 2
    var publishError: str
    if !production_launcher.CsgCoreProductionLauncherPublishSystemLinkExecOutputInto(
           outputCid,
           compileReceiptCid,
           compileReceiptCanonical,
           outputHostPath,
           publishError):
        csgCoreNativePrintHardRed(publishError)
        return 2
    return 0

fn main(): int32 =
    let heldImport =
        production_launcher.CsgCoreProductionLauncherChildImportAtEntry()
    if heldImport != 1:
        csgCoreNativePrintHardRed("csg_core_native_ticket_required")
        return 2
    var childCapsuleOwner: int32 = -1
    var childCapsuleError: str
    if !production_launcher.CsgCoreProductionLauncherChildTerminalCapsuleImportInto(
           childCapsuleOwner, childCapsuleError):
        csgCoreNativePrintHardRed(childCapsuleError)
        return 2
    if !cmdline.RawParamEquals(1, "system-link-exec"):
        csgCoreNativePrintHardRed("csg_core_native_command_rejected")
        return 2
    # The authenticated ticket import is the entry admission.  It binds the
    # exact argv/environment and both immutable executable identities before
    # any source input is read.  The real source/plan value-defs are bound by
    # BuildSystemLinkExecPlanWithWorldAndChannelInto before execution.
    var session: system.RuntimeAllocationLedgerSessionCapability
    if !production_launcher.CsgCoreProductionLauncherBeginHeldSystemLinkSessionInto(
           session) || session.handle == uint64(0):
        csgCoreNativePrintHardRed("csg_core_native_session_begin_failed")
        return 2
    let runCode = csgCoreNativeRunSystemLinkExec()
    var allocationReceipt: system.RuntimeAllocationLedgerReceipt
    var terminalReceiptCid: str
    var terminalError: str
    if !production_launcher.CsgCoreProductionLauncherCloseHeldSystemLinkSessionReceiptInto(
           session,
           allocationReceipt,
           terminalError):
        csgCoreNativePrintHardRed("csg_core_native_session_close_failed")
        return 2
    if !production_launcher.CsgCoreProductionLauncherFinishSystemLinkExecChildInto(
           childCapsuleOwner,
           runCode,
           allocationReceipt,
           terminalReceiptCid,
           terminalError):
        csgCoreNativePrintHardRed(terminalError)
        return 2
    return runCode
