# Step 3 P2 — arena allocation plan from escape classification (ghost scaffold).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (lesson e4550c1b5 applied).
# Env gate CHENG_ESCAPE_ARENA_PLAN_TRACE=1 default off.
#
# Design source: docs/beat-c.md §1.4.3 Step 3 P2.
#
# Companion to escape_arena_route.cheng (P1 escape classification).
# This module consumes EscapeArenaRouteResult and emits per-slot arena
# allocation decisions: arena ID for arena-safe slots, -1 for heap.
#
# Algorithm:
# 1. For each slot in route.slotEscapes:
#    a. kind == EscapeKindNone → arena_main (id=0): cheap arena alloc
#    b. kind == EscapeKindLocal → arena_main (id=0): still arena-safe
#    c. kind == EscapeKindReturn → heap (-1): escapes via return value
#    d. kind == EscapeKindGlobal → heap (-1): escapes to global scope
#    e. kind == EscapeKindUnknown → heap (-1): conservative
# 2. Aggregate counts (arena_count vs heap_count) for measurement.
#
# Real wire (Step 3 P3 cross-session): consume plan + mutate PObjP
# slot allocator routing decision → arena vs heap. Codegen output
# affected (RSS profile changes); bootstrap fp may drift slightly,
# functional output identical.

import cheng/core/ir/escape_arena_route as ear
import std/os
import std/strings

const
    ArenaIdHeap = -1
    ArenaIdMain = 0

type
    EscapeArenaPlanEntry =
        slotIndex: int32
        arenaId: int32

    EscapeArenaPlan =
        entries: EscapeArenaPlanEntry[]
        totalSlots: int32
        arenaCount: int32
        heapCount: int32

fn EscapeArenaPlanKindToArena(kind: int32): int32 =
    if kind == ear.EscapeKindNone:
        return ArenaIdMain
    if kind == ear.EscapeKindLocal:
        return ArenaIdMain
    return ArenaIdHeap

fn EscapeArenaPlanBuild(route: ear.EscapeArenaRouteResult): EscapeArenaPlan =
    var plan: EscapeArenaPlan
    plan.totalSlots = route.totalSlots
    plan.arenaCount = 0
    plan.heapCount = 0

    for i in 0..<route.slotEscapes.len:
        let kind = route.slotEscapes[i]
        let arenaId = EscapeArenaPlanKindToArena(kind)
        var entry: EscapeArenaPlanEntry
        entry.slotIndex = i
        entry.arenaId = arenaId
        add(plan.entries, entry)
        if arenaId == ArenaIdHeap:
            plan.heapCount = plan.heapCount + 1
        else:
            plan.arenaCount = plan.arenaCount + 1

    let _gate = os.GetEnv("CHENG_ESCAPE_ARENA_PLAN_TRACE")
    if _gate == "1":
        var _line: str = "[escape-arena-plan] total="
        _line = _line + strings.IntToStr(plan.totalSlots)
        _line = _line + " arena="
        _line = _line + strings.IntToStr(plan.arenaCount)
        _line = _line + " heap="
        _line = _line + strings.IntToStr(plan.heapCount)
        os.WriteLine(os.GetStderr(), _line)

    return plan

fn EscapeArenaPlanSlotArena(plan: EscapeArenaPlan, slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= plan.entries.len:
        return ArenaIdHeap
    return plan.entries[slotIndex].arenaId
