# FunctionSourceSliceIndex promotes the existing function expr-slice columns with
# source-local scope/statement ranges. Rows are grouped by dense source index;
# root scope 0 is implicit and is never stored in a function range.

import std/system

type
    FunctionSourceSliceRow =
        sourceIndex: int32
        functionIndex: int32
        exprStart: int32
        exprCount: int32
        scopeStart: int32
        scopeCount: int32
        statementStart: int32
        statementCount: int32

    FunctionSourceSliceIndexByteLedger =
        functionRowCount: int32
        sourceCount: int32
        baseLiveBytes: int64
        incrementalLiveBytes: int64
        totalLiveBytes: int64
        baseRetainedBytes: int64
        incrementalRetainedBytes: int64
        totalRetainedBytes: int64

    FunctionSourceSliceIndex =
        sourceIndices: int32[]
        functionIndices: int32[]
        exprStarts: int32[]
        exprCounts: int32[]
        scopeStarts: int32[]
        scopeCounts: int32[]
        statementStarts: int32[]
        statementCounts: int32[]
        sourceStarts: int32[]
        sourceCounts: int32[]
        expectedFunctionCount: int32
        expectedSourceCount: int32
        functionRowAppendVisitCount: int32
        exprCommitVisitCount: int32
        scopeCommitVisitCount: int32
        statementCommitVisitCount: int32
        scopeParentValidationVisitCount: int32
        parentValidationRowCursor: int32
        lastAppendedSourceIndex: int32
        contentCertificate: int64
        sealed: bool
        released: bool

@borrows
fn functionSourceSliceIndexFail(message: str) =
    panic(message)

@borrows
fn functionSourceSliceIndexRequireNonNegative(value: int32,
                                               message: str) =
    if value < 0:
        functionSourceSliceIndexFail(message)

@borrows
fn functionSourceSliceIndexRequireNonNegative64(value: int64,
                                                 message: str) =
    if value < int64(0):
        functionSourceSliceIndexFail(message)

@borrows
fn functionSourceSliceIndexCheckedAdd(left: int32,
                                       right: int32,
                                       message: str): int32 =
    functionSourceSliceIndexRequireNonNegative(left, message)
    functionSourceSliceIndexRequireNonNegative(right, message)
    let value = int64(left) + int64(right)
    if value > int64(2147483647):
        functionSourceSliceIndexFail(message)
    return int32(value)

@borrows
fn functionSourceSliceIndexCheckedAdd64(left: int64,
                                         right: int64,
                                         message: str): int64 =
    functionSourceSliceIndexRequireNonNegative64(left, message)
    functionSourceSliceIndexRequireNonNegative64(right, message)
    if left > int64(9223372036854775807) - right:
        functionSourceSliceIndexFail(message)
    return left + right

@borrows
fn functionSourceSliceIndexCheckedMul64(left: int64,
                                         right: int64,
                                         message: str): int64 =
    functionSourceSliceIndexRequireNonNegative64(left, message)
    functionSourceSliceIndexRequireNonNegative64(right, message)
    if left != int64(0) &&
       right > int64(9223372036854775807) / left:
        functionSourceSliceIndexFail(message)
    return left * right

fn functionSourceSliceIndexCertificateMix(seed: int64,
                                           value: int64): int64 =
    return (seed * int64(1315423911) + value * int64(2654435761) +
            int64(97)) & int64(9223372036854775807)

fn functionSourceSliceIndexContentCertificate(
        index: var FunctionSourceSliceIndex): int64 =
    functionSourceSliceIndexRequireShape(index)
    var out = functionSourceSliceIndexCertificateMix(
        int64(146959810), int64(index.expectedFunctionCount))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.expectedSourceCount))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.functionRowAppendVisitCount))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.exprCommitVisitCount))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.scopeCommitVisitCount))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.statementCommitVisitCount))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.scopeParentValidationVisitCount))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.parentValidationRowCursor))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.lastAppendedSourceIndex))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.sourceIndices.len))
    for rowIndex in 0..<index.sourceIndices.len:
        out = functionSourceSliceIndexCertificateMix(out, int64(rowIndex))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.sourceIndices[rowIndex]))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.functionIndices[rowIndex]))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.exprStarts[rowIndex]))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.exprCounts[rowIndex]))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.scopeStarts[rowIndex]))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.scopeCounts[rowIndex]))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.statementStarts[rowIndex]))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.statementCounts[rowIndex]))
    out = functionSourceSliceIndexCertificateMix(
        out, int64(index.sourceStarts.len))
    for sourceIndex in 0..<index.sourceStarts.len:
        out = functionSourceSliceIndexCertificateMix(out, int64(sourceIndex))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.sourceStarts[sourceIndex]))
        out = functionSourceSliceIndexCertificateMix(
            out, int64(index.sourceCounts[sourceIndex]))
    return out

fn functionSourceSliceIndexRangeEnd(start: int32,
                                    count: int32,
                                    message: str): int32 =
    return functionSourceSliceIndexCheckedAdd(start, count, message)

fn functionSourceSliceIndexRequireShape(index: var FunctionSourceSliceIndex) =
    let functionCount = index.sourceIndices.len
    if index.functionIndices.len != functionCount ||
       index.exprStarts.len != functionCount ||
       index.exprCounts.len != functionCount ||
       index.scopeStarts.len != functionCount ||
       index.scopeCounts.len != functionCount ||
       index.statementStarts.len != functionCount ||
       index.statementCounts.len != functionCount:
        functionSourceSliceIndexFail(
            "function source slice index: function SoA length drift")
    if index.sourceStarts.len != index.sourceCounts.len:
        functionSourceSliceIndexFail(
            "function source slice index: source SoA length drift")
    if functionCount > index.expectedFunctionCount ||
       index.sourceStarts.len > index.expectedSourceCount:
        functionSourceSliceIndexFail(
            "function source slice index: expected capacity exceeded")

fn functionSourceSliceIndexRequireReservedAppendCapacity(
        index: var FunctionSourceSliceIndex,
        nextFunctionCount: int32,
        nextSourceCount: int32) =
    if index.sourceIndices.cap < nextFunctionCount ||
       index.functionIndices.cap < nextFunctionCount ||
       index.exprStarts.cap < nextFunctionCount ||
       index.exprCounts.cap < nextFunctionCount ||
       index.scopeStarts.cap < nextFunctionCount ||
       index.scopeCounts.cap < nextFunctionCount ||
       index.statementStarts.cap < nextFunctionCount ||
       index.statementCounts.cap < nextFunctionCount:
        functionSourceSliceIndexFail(
            "function source slice index: function append exceeds reserve")
    if index.sourceStarts.cap < nextSourceCount ||
       index.sourceCounts.cap < nextSourceCount:
        functionSourceSliceIndexFail(
            "function source slice index: source append exceeds reserve")

fn functionSourceSliceIndexRequireAppendTail(
        index: var FunctionSourceSliceIndex) =
    let functionCount = index.sourceIndices.len
    let sourceCount = index.sourceStarts.len
    if index.functionRowAppendVisitCount != functionCount:
        functionSourceSliceIndexFail(
            "function source slice index: append visit tail drift")
    if functionCount == 0:
        if index.lastAppendedSourceIndex != -1:
            functionSourceSliceIndexFail(
                "function source slice index: empty append tail identity drift")
        return
    if index.lastAppendedSourceIndex < 0 ||
       index.lastAppendedSourceIndex >= sourceCount:
        functionSourceSliceIndexFail(
            "function source slice index: append tail source is invalid")
    let lastSourceIndex = index.lastAppendedSourceIndex
    let tailEnd = functionSourceSliceIndexRangeEnd(
        index.sourceStarts[lastSourceIndex],
        index.sourceCounts[lastSourceIndex],
        "function source slice index: append tail range overflow")
    if tailEnd != functionCount ||
       index.sourceIndices[functionCount - 1] != lastSourceIndex:
        functionSourceSliceIndexFail(
            "function source slice index: append tail coverage drift")

fn FunctionSourceSliceIndexInit(expectedSourceCount: int32,
                                expectedFunctionCount: int32): FunctionSourceSliceIndex =
    functionSourceSliceIndexRequireNonNegative(
        expectedSourceCount,
        "function source slice index: negative expected source count")
    functionSourceSliceIndexRequireNonNegative(
        expectedFunctionCount,
        "function source slice index: negative expected function count")
    var out: FunctionSourceSliceIndex
    out.expectedSourceCount = expectedSourceCount
    out.expectedFunctionCount = expectedFunctionCount
    out.lastAppendedSourceIndex = -1
    reserve(out.sourceIndices, expectedFunctionCount)
    reserve(out.functionIndices, expectedFunctionCount)
    reserve(out.exprStarts, expectedFunctionCount)
    reserve(out.exprCounts, expectedFunctionCount)
    reserve(out.scopeStarts, expectedFunctionCount)
    reserve(out.scopeCounts, expectedFunctionCount)
    reserve(out.statementStarts, expectedFunctionCount)
    reserve(out.statementCounts, expectedFunctionCount)
    reserve(out.sourceStarts, expectedSourceCount)
    reserve(out.sourceCounts, expectedSourceCount)
    return out

fn functionSourceSliceIndexAppendFunctionRow(
        index: var FunctionSourceSliceIndex,
        row: FunctionSourceSliceRow) =
    functionSourceSliceIndexRequireShape(index)
    functionSourceSliceIndexRequireAppendTail(index)
    if index.released:
        functionSourceSliceIndexFail(
            "function source slice index: append after release")
    if index.sealed:
        functionSourceSliceIndexFail(
            "function source slice index: append after seal")
    functionSourceSliceIndexRequireNonNegative(
        row.sourceIndex,
        "function source slice index: negative source index")
    functionSourceSliceIndexRequireNonNegative(
        row.functionIndex,
        "function source slice index: negative function index")
    functionSourceSliceIndexRequireNonNegative(
        row.exprStart,
        "function source slice index: negative expr start")
    functionSourceSliceIndexRequireNonNegative(
        row.exprCount,
        "function source slice index: negative expr count")
    functionSourceSliceIndexRequireNonNegative(
        row.scopeStart,
        "function source slice index: negative scope start")
    functionSourceSliceIndexRequireNonNegative(
        row.scopeCount,
        "function source slice index: negative scope count")
    functionSourceSliceIndexRequireNonNegative(
        row.statementStart,
        "function source slice index: negative statement start")
    functionSourceSliceIndexRequireNonNegative(
        row.statementCount,
        "function source slice index: negative statement count")

    let exprEnd = functionSourceSliceIndexRangeEnd(
        row.exprStart, row.exprCount,
        "function source slice index: expr range overflow")
    let scopeEnd = functionSourceSliceIndexRangeEnd(
        row.scopeStart, row.scopeCount,
        "function source slice index: scope range overflow")
    let statementEnd = functionSourceSliceIndexRangeEnd(
        row.statementStart, row.statementCount,
        "function source slice index: statement range overflow")
    let functionCount = index.sourceIndices.len
    let sourceCount = index.sourceStarts.len
    let nextFunctionCount = functionSourceSliceIndexCheckedAdd(
        functionCount, 1,
        "function source slice index: function row count overflow")
    if nextFunctionCount > index.expectedFunctionCount:
        functionSourceSliceIndexFail(
            "function source slice index: unexpected extra function row")

    if row.sourceIndex >= index.expectedSourceCount:
        functionSourceSliceIndexFail(
            "function source slice index: source index exceeds expected domain")
    let sourceHasRows = functionCount > 0 &&
                        row.sourceIndex == index.lastAppendedSourceIndex
    if functionCount > 0 && row.sourceIndex < index.lastAppendedSourceIndex:
        functionSourceSliceIndexFail(
            "function source slice index: sources must be dense and grouped")
    var nextSourceCount = sourceCount
    let requiredSourceCount = functionSourceSliceIndexCheckedAdd(
        row.sourceIndex, 1,
        "function source slice index: source count overflow")
    if requiredSourceCount > nextSourceCount:
        nextSourceCount = requiredSourceCount
    if nextSourceCount > index.expectedSourceCount:
        functionSourceSliceIndexFail(
            "function source slice index: unexpected extra source row")

    if !sourceHasRows:
        if row.exprStart != 0 || row.scopeStart != 1 ||
           row.statementStart != 0:
            functionSourceSliceIndexFail(
                "function source slice index: source-local ranges must start at 0/1/0")
    else:
        if functionCount <= 0:
            functionSourceSliceIndexFail(
                "function source slice index: existing source without function")
        let previous = functionCount - 1
        let previousExprEnd = functionSourceSliceIndexRangeEnd(
            index.exprStarts[previous], index.exprCounts[previous],
            "function source slice index: previous expr range overflow")
        let previousScopeEnd = functionSourceSliceIndexRangeEnd(
            index.scopeStarts[previous], index.scopeCounts[previous],
            "function source slice index: previous scope range overflow")
        let previousStatementEnd = functionSourceSliceIndexRangeEnd(
            index.statementStarts[previous], index.statementCounts[previous],
            "function source slice index: previous statement range overflow")
        if row.exprStart != previousExprEnd ||
           row.scopeStart != previousScopeEnd ||
           row.statementStart != previousStatementEnd:
            functionSourceSliceIndexFail(
                "function source slice index: source-local range overlap or gap")

    if exprEnd < row.exprStart || scopeEnd < row.scopeStart ||
       statementEnd < row.statementStart:
        functionSourceSliceIndexFail(
            "function source slice index: preflight range drift")

    let nextFunctionVisits = functionSourceSliceIndexCheckedAdd(
        index.functionRowAppendVisitCount, 1,
        "function source slice index: function visit overflow")
    let nextExprVisits = functionSourceSliceIndexCheckedAdd(
        index.exprCommitVisitCount, row.exprCount,
        "function source slice index: expr visit overflow")
    let nextScopeVisits = functionSourceSliceIndexCheckedAdd(
        index.scopeCommitVisitCount, row.scopeCount,
        "function source slice index: scope visit overflow")
    let nextStatementVisits = functionSourceSliceIndexCheckedAdd(
        index.statementCommitVisitCount, row.statementCount,
        "function source slice index: statement visit overflow")
    var nextSourceFunctionCount: int32 = 1
    if sourceHasRows:
        nextSourceFunctionCount = functionSourceSliceIndexCheckedAdd(
            index.sourceCounts[row.sourceIndex], 1,
            "function source slice index: source function count overflow")
    functionSourceSliceIndexRequireReservedAppendCapacity(
        index, nextFunctionCount, nextSourceCount)

    for missingSourceIndex in sourceCount..<nextSourceCount:
        add(index.sourceStarts, functionCount)
        add(index.sourceCounts, 0)
    add(index.sourceIndices, row.sourceIndex)
    add(index.functionIndices, row.functionIndex)
    add(index.exprStarts, row.exprStart)
    add(index.exprCounts, row.exprCount)
    add(index.scopeStarts, row.scopeStart)
    add(index.scopeCounts, row.scopeCount)
    add(index.statementStarts, row.statementStart)
    add(index.statementCounts, row.statementCount)
    index.sourceCounts[row.sourceIndex] = nextSourceFunctionCount
    index.functionRowAppendVisitCount = nextFunctionVisits
    index.exprCommitVisitCount = nextExprVisits
    index.scopeCommitVisitCount = nextScopeVisits
    index.statementCommitVisitCount = nextStatementVisits
    index.lastAppendedSourceIndex = row.sourceIndex

fn functionSourceSliceIndexRequireParentIds(
        row: FunctionSourceSliceRow,
        parentSourceScopeIds: int32[]) =
    if parentSourceScopeIds.len != row.scopeCount:
        functionSourceSliceIndexFail(
            "function source slice index: parent row count drift")
    for offset in 0..<row.scopeCount:
        let childScopeId = functionSourceSliceIndexCheckedAdd(
            row.scopeStart, offset,
            "function source slice index: child scope id overflow")
        let parentScopeId = parentSourceScopeIds[offset]
        if parentScopeId != 0 &&
           (parentScopeId < row.scopeStart || parentScopeId >= childScopeId):
            functionSourceSliceIndexFail(
                "function source slice index: parent must precede child in slice")

fn FunctionSourceSliceIndexAppendValidatedFunctionRow(
        index: var FunctionSourceSliceIndex,
        row: FunctionSourceSliceRow,
        parentSourceScopeIds: int32[]) =
    let rowIndex = index.sourceIndices.len
    if index.parentValidationRowCursor != rowIndex:
        functionSourceSliceIndexFail(
            "function source slice index: prior parent validation is incomplete")
    functionSourceSliceIndexRequireParentIds(row, parentSourceScopeIds)
    let nextParentVisits = functionSourceSliceIndexCheckedAdd(
        index.scopeParentValidationVisitCount, row.scopeCount,
        "function source slice index: parent validation visit overflow")
    let nextParentRowCursor = functionSourceSliceIndexCheckedAdd(
        index.parentValidationRowCursor, 1,
        "function source slice index: parent validation row overflow")
    functionSourceSliceIndexAppendFunctionRow(index, row)
    index.scopeParentValidationVisitCount = nextParentVisits
    index.parentValidationRowCursor = nextParentRowCursor

fn FunctionSourceSliceIndexRequireValid(index: var FunctionSourceSliceIndex) =
    functionSourceSliceIndexRequireShape(index)
    if index.released:
        if index.sourceIndices.len != 0 || index.sourceStarts.len != 0 ||
           index.functionRowAppendVisitCount != 0 ||
           index.exprCommitVisitCount != 0 ||
           index.scopeCommitVisitCount != 0 ||
           index.statementCommitVisitCount != 0 ||
           index.scopeParentValidationVisitCount != 0 ||
           index.parentValidationRowCursor != 0 ||
           index.lastAppendedSourceIndex != -1:
            functionSourceSliceIndexFail(
                "function source slice index: released state retains live rows")
        return

    let functionCount = index.sourceIndices.len
    let sourceCount = index.sourceStarts.len
    var expectedFunctionStart: int32
    var observedExprVisits: int32
    var observedScopeVisits: int32
    var observedStatementVisits: int32
    for sourceIndex in 0..<sourceCount:
        let sourceStart = index.sourceStarts[sourceIndex]
        let sourceFunctionCount = index.sourceCounts[sourceIndex]
        if sourceStart != expectedFunctionStart || sourceFunctionCount < 0:
            functionSourceSliceIndexFail(
                "function source slice index: source function range gap")
        let sourceEnd = functionSourceSliceIndexRangeEnd(
            sourceStart, sourceFunctionCount,
            "function source slice index: source function range overflow")
        if sourceEnd > functionCount:
            functionSourceSliceIndexFail(
                "function source slice index: source function range out of bounds")
        var expectedExprStart: int32
        var expectedScopeStart: int32 = 1
        var expectedStatementStart: int32
        for rowIndex in sourceStart..<sourceEnd:
            if index.sourceIndices[rowIndex] != sourceIndex ||
               index.functionIndices[rowIndex] < 0:
                functionSourceSliceIndexFail(
                    "function source slice index: source/function identity drift")
            if index.exprStarts[rowIndex] != expectedExprStart ||
               index.scopeStarts[rowIndex] != expectedScopeStart ||
               index.statementStarts[rowIndex] != expectedStatementStart:
                functionSourceSliceIndexFail(
                    "function source slice index: source-local range drift")
            expectedExprStart = functionSourceSliceIndexRangeEnd(
                expectedExprStart, index.exprCounts[rowIndex],
                "function source slice index: expr validation overflow")
            expectedScopeStart = functionSourceSliceIndexRangeEnd(
                expectedScopeStart, index.scopeCounts[rowIndex],
                "function source slice index: scope validation overflow")
            expectedStatementStart = functionSourceSliceIndexRangeEnd(
                expectedStatementStart, index.statementCounts[rowIndex],
                "function source slice index: statement validation overflow")
            observedExprVisits = functionSourceSliceIndexCheckedAdd(
                observedExprVisits, index.exprCounts[rowIndex],
                "function source slice index: observed expr visit overflow")
            observedScopeVisits = functionSourceSliceIndexCheckedAdd(
                observedScopeVisits, index.scopeCounts[rowIndex],
                "function source slice index: observed scope visit overflow")
            observedStatementVisits = functionSourceSliceIndexCheckedAdd(
                observedStatementVisits, index.statementCounts[rowIndex],
                "function source slice index: observed statement visit overflow")
        expectedFunctionStart = sourceEnd
    if expectedFunctionStart != functionCount:
        functionSourceSliceIndexFail(
            "function source slice index: function row coverage gap")
    if index.functionRowAppendVisitCount != functionCount ||
       index.exprCommitVisitCount != observedExprVisits ||
       index.scopeCommitVisitCount != observedScopeVisits ||
       index.statementCommitVisitCount != observedStatementVisits:
        functionSourceSliceIndexFail(
            "function source slice index: visit counter drift")
    if functionCount == 0:
        if index.lastAppendedSourceIndex != -1:
            functionSourceSliceIndexFail(
                "function source slice index: empty function identity drift")
    elif index.lastAppendedSourceIndex < 0 ||
         index.lastAppendedSourceIndex >= sourceCount ||
         index.sourceIndices[functionCount - 1] !=
             index.lastAppendedSourceIndex:
        functionSourceSliceIndexFail(
            "function source slice index: last function source drift")

fn FunctionSourceSliceIndexSeal(index: var FunctionSourceSliceIndex) =
    if index.released:
        functionSourceSliceIndexFail(
            "function source slice index: seal after release")
    if index.sealed:
        functionSourceSliceIndexFail(
            "function source slice index: duplicate seal")
    FunctionSourceSliceIndexRequireValid(index)
    if index.sourceIndices.len != index.expectedFunctionCount:
        functionSourceSliceIndexFail(
            "function source slice index: incomplete seal")
    if index.parentValidationRowCursor != index.sourceIndices.len ||
       index.scopeParentValidationVisitCount != index.scopeCommitVisitCount:
        functionSourceSliceIndexFail(
            "function source slice index: parent validation is incomplete")
    functionSourceSliceIndexRequireReservedAppendCapacity(
        index, index.sourceIndices.len, index.expectedSourceCount)
    for sourceIndex in index.sourceStarts.len..<index.expectedSourceCount:
        add(index.sourceStarts, index.sourceIndices.len)
        add(index.sourceCounts, 0)
    index.sealed = true
    index.contentCertificate =
        functionSourceSliceIndexContentCertificate(index)

fn FunctionSourceSliceIndexContentCertificateMatches(
        index: var FunctionSourceSliceIndex): bool =
    if index.released || !index.sealed || index.contentCertificate <= int64(0):
        return false
    return index.contentCertificate ==
           functionSourceSliceIndexContentCertificate(index)

fn functionSourceSliceIndexRequireSealed(index: var FunctionSourceSliceIndex) =
    if index.released || !index.sealed:
        functionSourceSliceIndexFail(
            "function source slice index: query requires sealed index")
    functionSourceSliceIndexRequireShape(index)

fn FunctionSourceSliceIndexSourceStart(
        index: var FunctionSourceSliceIndex,
        sourceIndex: int32): int32 =
    functionSourceSliceIndexRequireSealed(index)
    if sourceIndex < 0 || sourceIndex >= index.sourceStarts.len:
        functionSourceSliceIndexFail(
            "function source slice index: source lookup out of bounds")
    return index.sourceStarts[sourceIndex]

fn FunctionSourceSliceIndexSourceCount(
        index: var FunctionSourceSliceIndex,
        sourceIndex: int32): int32 =
    functionSourceSliceIndexRequireSealed(index)
    if sourceIndex < 0 || sourceIndex >= index.sourceCounts.len:
        functionSourceSliceIndexFail(
            "function source slice index: source count lookup out of bounds")
    return index.sourceCounts[sourceIndex]

fn FunctionSourceSliceIndexRowForSourceFunctionOrdinal(
        index: var FunctionSourceSliceIndex,
        sourceIndex: int32,
        sourceFunctionOrdinal: int32): int32 =
    let sourceStart = FunctionSourceSliceIndexSourceStart(index, sourceIndex)
    let sourceCount = FunctionSourceSliceIndexSourceCount(index, sourceIndex)
    if sourceFunctionOrdinal < 0 || sourceFunctionOrdinal >= sourceCount:
        functionSourceSliceIndexFail(
            "function source slice index: source function lookup out of bounds")
    return functionSourceSliceIndexCheckedAdd(
        sourceStart, sourceFunctionOrdinal,
        "function source slice index: source function row overflow")

fn FunctionSourceSliceIndexGetRow(
        index: var FunctionSourceSliceIndex,
        rowIndex: int32): FunctionSourceSliceRow =
    functionSourceSliceIndexRequireSealed(index)
    if rowIndex < 0 || rowIndex >= index.sourceIndices.len:
        functionSourceSliceIndexFail(
            "function source slice index: row lookup out of bounds")
    var out: FunctionSourceSliceRow
    out.sourceIndex = index.sourceIndices[rowIndex]
    out.functionIndex = index.functionIndices[rowIndex]
    out.exprStart = index.exprStarts[rowIndex]
    out.exprCount = index.exprCounts[rowIndex]
    out.scopeStart = index.scopeStarts[rowIndex]
    out.scopeCount = index.scopeCounts[rowIndex]
    out.statementStart = index.statementStarts[rowIndex]
    out.statementCount = index.statementCounts[rowIndex]
    return out

fn FunctionSourceSliceIndexRequireParentValidationComplete(
        index: var FunctionSourceSliceIndex) =
    functionSourceSliceIndexRequireSealed(index)
    if index.parentValidationRowCursor != index.sourceIndices.len ||
       index.scopeParentValidationVisitCount != index.scopeCommitVisitCount:
        functionSourceSliceIndexFail(
            "function source slice index: parent validation is incomplete")

fn FunctionSourceSliceIndexExpectedIncrementalLiveBytes(
        functionCount: int32,
        sourceCount: int32): int64 =
    let functionBytes = functionSourceSliceIndexCheckedMul64(
        int64(functionCount), int64(16),
        "function source slice index: incremental function byte overflow")
    let sourceBytes = functionSourceSliceIndexCheckedMul64(
        int64(sourceCount), int64(8),
        "function source slice index: incremental source byte overflow")
    return functionSourceSliceIndexCheckedAdd64(
        functionBytes, sourceBytes,
        "function source slice index: incremental live byte overflow")

fn functionSourceSliceIndexFourColumnBytes(capacity: int32,
                                            message: str): int64 =
    return functionSourceSliceIndexCheckedMul64(
        int64(capacity), int64(16), message)

fn FunctionSourceSliceIndexByteLedgerBuild(
        index: var FunctionSourceSliceIndex): FunctionSourceSliceIndexByteLedger =
    functionSourceSliceIndexRequireShape(index)
    var out: FunctionSourceSliceIndexByteLedger
    out.functionRowCount = index.sourceIndices.len
    out.sourceCount = index.sourceStarts.len
    out.baseLiveBytes = functionSourceSliceIndexFourColumnBytes(
        out.functionRowCount,
        "function source slice index: base live byte overflow")
    out.incrementalLiveBytes =
        FunctionSourceSliceIndexExpectedIncrementalLiveBytes(
            out.functionRowCount, out.sourceCount)
    out.totalLiveBytes = functionSourceSliceIndexCheckedAdd64(
        out.baseLiveBytes, out.incrementalLiveBytes,
        "function source slice index: total live byte overflow")

    var baseRetained: int64
    baseRetained = functionSourceSliceIndexCheckedAdd64(
        baseRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.sourceIndices.cap), int64(4),
            "function source slice index: retained source index overflow"),
        "function source slice index: base retained overflow")
    baseRetained = functionSourceSliceIndexCheckedAdd64(
        baseRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.functionIndices.cap), int64(4),
            "function source slice index: retained function index overflow"),
        "function source slice index: base retained overflow")
    baseRetained = functionSourceSliceIndexCheckedAdd64(
        baseRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.exprStarts.cap), int64(4),
            "function source slice index: retained expr start overflow"),
        "function source slice index: base retained overflow")
    baseRetained = functionSourceSliceIndexCheckedAdd64(
        baseRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.exprCounts.cap), int64(4),
            "function source slice index: retained expr count overflow"),
        "function source slice index: base retained overflow")

    var incrementalRetained: int64
    incrementalRetained = functionSourceSliceIndexCheckedAdd64(
        incrementalRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.scopeStarts.cap), int64(4),
            "function source slice index: retained scope start overflow"),
        "function source slice index: incremental retained overflow")
    incrementalRetained = functionSourceSliceIndexCheckedAdd64(
        incrementalRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.scopeCounts.cap), int64(4),
            "function source slice index: retained scope count overflow"),
        "function source slice index: incremental retained overflow")
    incrementalRetained = functionSourceSliceIndexCheckedAdd64(
        incrementalRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.statementStarts.cap), int64(4),
            "function source slice index: retained statement start overflow"),
        "function source slice index: incremental retained overflow")
    incrementalRetained = functionSourceSliceIndexCheckedAdd64(
        incrementalRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.statementCounts.cap), int64(4),
            "function source slice index: retained statement count overflow"),
        "function source slice index: incremental retained overflow")
    incrementalRetained = functionSourceSliceIndexCheckedAdd64(
        incrementalRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.sourceStarts.cap), int64(4),
            "function source slice index: retained source start overflow"),
        "function source slice index: incremental retained overflow")
    incrementalRetained = functionSourceSliceIndexCheckedAdd64(
        incrementalRetained,
        functionSourceSliceIndexCheckedMul64(
            int64(index.sourceCounts.cap), int64(4),
            "function source slice index: retained source count overflow"),
        "function source slice index: incremental retained overflow")
    out.baseRetainedBytes = baseRetained
    out.incrementalRetainedBytes = incrementalRetained
    out.totalRetainedBytes = functionSourceSliceIndexCheckedAdd64(
        baseRetained, incrementalRetained,
        "function source slice index: total retained overflow")
    return out

fn FunctionSourceSliceIndexReset(index: var FunctionSourceSliceIndex) =
    if index.released:
        functionSourceSliceIndexFail(
            "function source slice index: reset after release")
    setLen(index.sourceIndices, 0)
    setLen(index.functionIndices, 0)
    setLen(index.exprStarts, 0)
    setLen(index.exprCounts, 0)
    setLen(index.scopeStarts, 0)
    setLen(index.scopeCounts, 0)
    setLen(index.statementStarts, 0)
    setLen(index.statementCounts, 0)
    setLen(index.sourceStarts, 0)
    setLen(index.sourceCounts, 0)
    index.functionRowAppendVisitCount = 0
    index.exprCommitVisitCount = 0
    index.scopeCommitVisitCount = 0
    index.statementCommitVisitCount = 0
    index.scopeParentValidationVisitCount = 0
    index.parentValidationRowCursor = 0
    index.lastAppendedSourceIndex = -1
    index.contentCertificate = int64(0)
    index.sealed = false

fn FunctionSourceSliceIndexRelease(index: var FunctionSourceSliceIndex) =
    if index.released:
        functionSourceSliceIndexFail(
            "function source slice index: duplicate release")
    index.sourceIndices = []
    index.functionIndices = []
    index.exprStarts = []
    index.exprCounts = []
    index.scopeStarts = []
    index.scopeCounts = []
    index.statementStarts = []
    index.statementCounts = []
    index.sourceStarts = []
    index.sourceCounts = []
    index.functionRowAppendVisitCount = 0
    index.exprCommitVisitCount = 0
    index.scopeCommitVisitCount = 0
    index.statementCommitVisitCount = 0
    index.scopeParentValidationVisitCount = 0
    index.parentValidationRowCursor = 0
    index.lastAppendedSourceIndex = -1
    index.contentCertificate = int64(0)
    index.sealed = false
    index.released = true

fn FunctionSourceSliceIndexMoveInto(out: var FunctionSourceSliceIndex,
                                      source: var FunctionSourceSliceIndex) =
    if source.released:
        functionSourceSliceIndexFail(
            "function source slice index: move from released source")
    # Temporarily poison a non-negative shape field to distinguish actual
    # var-parameter aliasing from two independent descriptors with equal rows.
    let sourceExpectedSourceCount = source.expectedSourceCount
    source.expectedSourceCount = -1
    let descriptorsAlias = out.expectedSourceCount == -1
    source.expectedSourceCount = sourceExpectedSourceCount
    if descriptorsAlias:
        functionSourceSliceIndexFail(
            "function source slice index: move source aliases destination")
    if !out.released:
        FunctionSourceSliceIndexRelease(out)
    out = source
    source = FunctionSourceSliceIndex()
    source.released = true
