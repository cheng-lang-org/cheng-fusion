import cheng/core/ir/core_types as coreir

type
    BodyIrNoAliasFinalizeReport =
        bodyIR: coreir.BodyIR
        applied: bool
        localCount: int32
        forwardRewriteCount: int32
        dodSoAContractOk: bool
    BodyIrNoAliasFinalizeStats =
        applied: bool
        localCount: int32
        forwardRewriteCount: int32
        dodSoAContractOk: bool

@borrows
fn BodyIrNoAliasIntSeqInit(count: int32,
                            value: int32): int32[] =
    var out: int32[]
    for _ in 0..<count:
        add(out, value)
    return out

@borrows
fn BodyIrNoAliasLocalValid(bodyIR: coreir.BodyIR,
                            slot: int32): bool =
    if slot < 0:
        return false
    if slot >= bodyIR.localSlots.len:
        return false
    return true

@borrows
fn BodyIrNoAliasLocalProof(bodyIR: coreir.BodyIR,
                            slot: int32): bool =
    if !BodyIrNoAliasLocalValid(bodyIR, slot):
        return false
    let local = bodyIR.localSlots[slot]
    if local.noAlias:
        return true
    if coreir.IsOwnershipNoAlias(local.ownership, local.aliasClass):
        return true
    return false

@borrows
fn BodyIrNoAliasInvalidateAll(knownSource: var int32[]) =
    for i in 0..<knownSource.len:
        knownSource[i] = -1

@borrows
fn BodyIrNoAliasInvalidateAliasesOf(slot: int32,
                                     knownSource: var int32[]) =
    if slot < 0 || slot >= knownSource.len:
        return
    for i in 0..<knownSource.len:
        if knownSource[i] == slot:
            knownSource[i] = -1

@borrows
fn BodyIrNoAliasSetKnownSource(target: int32,
                                source: int32,
                                knownSource: var int32[]) =
    if target < 0 || target >= knownSource.len:
        return
    if target != source:
        BodyIrNoAliasInvalidateAliasesOf(target, knownSource)
        knownSource[target] = source

@borrows
fn BodyIrNoAliasResolveSource(knownSource: int32[],
                               slot: int32): int32 =
    if slot < 0 || slot >= knownSource.len:
        return slot
    if knownSource[slot] >= 0 && knownSource[slot] < knownSource.len:
        return knownSource[slot]
    return slot

@borrows
fn BodyIrNoAliasIsPtrDerefLoad(op: coreir.BodyOp): bool =
    if op.kind != coreir.BodyOpLoadLocalTag:
        return false
    if op.operands.len < 3:
        return false
    if op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag:
        return true
    if op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag:
        return true
    return false

@borrows
fn BodyIrNoAliasLocalCount(bodyIR: coreir.BodyIR): int32 =
    var count: int32
    for i in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[i].noAlias:
            count = count + 1
    return count

fn BodyIrAnalyzeOwnership(bodyIR: var coreir.BodyIR) =
    if bodyIR.localSlots.len <= 0:
        return
    var refCount: int32[]
    for _ in 0..<bodyIR.localSlots.len:
        add(refCount, 0)
    for opIndex in 0..<bodyIR.ops.len:
        let opTarget = bodyIR.ops[opIndex].target
        let opKind = bodyIR.ops[opIndex].kind
        if BodyIrNoAliasLocalValid(bodyIR, opTarget):
            refCount[opTarget] = refCount[opTarget] + 1
        if opKind == coreir.BodyOpCallTag:
            var callOrdinal = 0
            for ci in 0..<bodyIR.callSequence.len:
                if bodyIR.callSequence[ci].resultSlot == opTarget:
                    callOrdinal = ci
                    break
            if callOrdinal < bodyIR.callSequence.len:
                let args = bodyIR.callSequence[callOrdinal].argSlots
                for ai in 0..<args.len:
                    if BodyIrNoAliasLocalValid(bodyIR, args[ai]):
                        refCount[args[ai]] = refCount[args[ai]] + 1
        elif opKind == coreir.BodyOpCopyLocalTag ||
             opKind == coreir.BodyOpStoreLocalTag:
            if bodyIR.ops[opIndex].operands.len > 0 &&
               !BodyIrNoAliasIsPtrDerefLoad(bodyIR.ops[opIndex]):
                let srcSlot = bodyIR.ops[opIndex].operands[0]
                if BodyIrNoAliasLocalValid(bodyIR, srcSlot):
                    refCount[srcSlot] = refCount[srcSlot] + 1
        elif opKind == coreir.BodyOpLoadLocalTag:
            if bodyIR.ops[opIndex].operands.len > 0 &&
               !BodyIrNoAliasIsPtrDerefLoad(bodyIR.ops[opIndex]):
                let srcSlot = bodyIR.ops[opIndex].operands[0]
                if BodyIrNoAliasLocalValid(bodyIR, srcSlot):
                    refCount[srcSlot] = refCount[srcSlot] + 1
        elif opKind == coreir.BodyOpBranchTag:
            if bodyIR.ops[opIndex].operands.len >= 2 &&
               BodyIrNoAliasLocalValid(bodyIR,
                                      bodyIR.ops[opIndex].operands[1]):
                refCount[bodyIR.ops[opIndex].operands[1]] =
                    refCount[bodyIR.ops[opIndex].operands[1]] + 1
        elif opKind == coreir.BodyOpBinOpTag:
            for oi in 2..<bodyIR.ops[opIndex].operands.len:
                if BodyIrNoAliasLocalValid(bodyIR,
                                          bodyIR.ops[opIndex].operands[oi]):
                    refCount[bodyIR.ops[opIndex].operands[oi]] =
                        refCount[bodyIR.ops[opIndex].operands[oi]] + 1
        elif opKind == coreir.BodyOpCmpTag:
            for oi in 1..<bodyIR.ops[opIndex].operands.len:
                if BodyIrNoAliasLocalValid(bodyIR,
                                          bodyIR.ops[opIndex].operands[oi]):
                    refCount[bodyIR.ops[opIndex].operands[oi]] =
                        refCount[bodyIR.ops[opIndex].operands[oi]] + 1
        elif opKind == coreir.BodyOpResultProjectTag:
            if bodyIR.ops[opIndex].operands.len >= 2 &&
               BodyIrNoAliasLocalValid(bodyIR,
                                      bodyIR.ops[opIndex].operands[1]):
                refCount[bodyIR.ops[opIndex].operands[1]] =
                    refCount[bodyIR.ops[opIndex].operands[1]] + 1
        elif opKind == coreir.BodyOpStrEqLiteralTag:
            if bodyIR.ops[opIndex].operands.len >= 1 &&
               BodyIrNoAliasLocalValid(bodyIR,
                                      bodyIR.ops[opIndex].operands[0]):
                refCount[bodyIR.ops[opIndex].operands[0]] =
                    refCount[bodyIR.ops[opIndex].operands[0]] + 1
    for si in 0..<bodyIR.localSlots.len:
        let proofBacked = BodyIrNoAliasLocalProof(bodyIR, si)
        bodyIR.localSlots[si].noAlias = proofBacked && refCount[si] <= 1

@borrows
fn BodyIrNoAliasRewriteOperand(op: var coreir.BodyOp,
                                operandIndex: int32,
                                knownSource: int32[]) =
    if operandIndex < 0 || operandIndex >= op.operands.len:
        return
    op.operands[operandIndex] = BodyIrNoAliasResolveSource(knownSource,
                                                           op.operands[operandIndex])

@borrows
fn BodyIrNoAliasInvalidateTarget(op: coreir.BodyOp,
                                  knownSource: var int32[]) =
    if op.target >= 0 && op.target < knownSource.len:
        BodyIrNoAliasInvalidateAliasesOf(op.target, knownSource)
        knownSource[op.target] = -1

@borrows
fn BodyIrNoAliasForwardOp(bodyIR: coreir.BodyIR,
                           op: var coreir.BodyOp,
                           knownSource: var int32[],
                           allowDropSelfCopy: bool,
                           dropOp: var bool) =
    dropOp = false
    if op.kind == coreir.BodyOpCallTag:
        BodyIrNoAliasInvalidateAll(knownSource)
        BodyIrNoAliasInvalidateTarget(op, knownSource)
        return
    if op.kind == coreir.BodyOpCopyLocalTag:
        if op.operands.len > 0:
            let sourceSlot = BodyIrNoAliasResolveSource(knownSource, op.operands[0])
            op.operands[0] = sourceSlot
            if BodyIrNoAliasLocalProof(bodyIR, sourceSlot):
                BodyIrNoAliasSetKnownSource(op.target, sourceSlot, knownSource)
            else:
                BodyIrNoAliasInvalidateTarget(op, knownSource)
            if allowDropSelfCopy && op.target == sourceSlot:
                dropOp = true
        else:
            BodyIrNoAliasInvalidateTarget(op, knownSource)
        return
    if op.kind == coreir.BodyOpLoadLocalTag &&
       !BodyIrNoAliasIsPtrDerefLoad(op):
        if op.operands.len > 0:
            let sourceSlot = BodyIrNoAliasResolveSource(knownSource, op.operands[0])
            op.operands[0] = sourceSlot
            if BodyIrNoAliasLocalProof(bodyIR, sourceSlot):
                BodyIrNoAliasSetKnownSource(op.target, sourceSlot, knownSource)
            else:
                BodyIrNoAliasInvalidateTarget(op, knownSource)
        else:
            BodyIrNoAliasInvalidateTarget(op, knownSource)
        return
    if op.kind == coreir.BodyOpStoreLocalTag:
        BodyIrNoAliasRewriteOperand(op, 0, knownSource)
        BodyIrNoAliasInvalidateTarget(op, knownSource)
        return
    if op.kind == coreir.BodyOpReturnTag:
        if op.target >= 0 && op.target < knownSource.len:
            op.target = BodyIrNoAliasResolveSource(knownSource, op.target)
        return
    if op.kind == coreir.BodyOpBranchTag:
        BodyIrNoAliasRewriteOperand(op, 1, knownSource)
        return
    if op.kind == coreir.BodyOpBinOpTag:
        for operandIndex in 2..<op.operands.len:
            BodyIrNoAliasRewriteOperand(op, operandIndex, knownSource)
        BodyIrNoAliasInvalidateTarget(op, knownSource)
        return
    if op.kind == coreir.BodyOpCmpTag:
        for operandIndex in 1..<op.operands.len:
            BodyIrNoAliasRewriteOperand(op, operandIndex, knownSource)
        BodyIrNoAliasInvalidateTarget(op, knownSource)
        return
    if op.kind == coreir.BodyOpResultProjectTag:
        BodyIrNoAliasRewriteOperand(op, 1, knownSource)
        BodyIrNoAliasInvalidateTarget(op, knownSource)
        return
    if op.kind == coreir.BodyOpResultPanicGuardTag:
        # F14b: embeds a real (conditionally executed) call — treat exactly
        # like BodyOpCallTag for alias-forwarding purposes (conservative
        # invalidation of all tracked known-sources). No target to rewrite
        # (op.target == -1, no def).
        BodyIrNoAliasInvalidateAll(knownSource)
        return
    if op.kind == coreir.BodyOpStrEqLiteralTag:
        BodyIrNoAliasRewriteOperand(op, 0, knownSource)
        BodyIrNoAliasInvalidateTarget(op, knownSource)
        return
    if op.kind == coreir.BodyOpLoadConstTag:
        BodyIrNoAliasInvalidateTarget(op, knownSource)

@borrows
fn BodyIrNoAliasForwardTerm(term: coreir.BodyTerm,
                             knownSource: int32[]): coreir.BodyTerm =
    var out = term
    if out.resultSlot >= 0:
        out.resultSlot = BodyIrNoAliasResolveSource(knownSource, out.resultSlot)
    if out.lhsSlot >= 0:
        out.lhsSlot = BodyIrNoAliasResolveSource(knownSource, out.lhsSlot)
    if out.rhsSlot >= 0:
        out.rhsSlot = BodyIrNoAliasResolveSource(knownSource, out.rhsSlot)
    return out

@borrows
fn BodyIrNoAliasCloneOp(op: coreir.BodyOp): coreir.BodyOp =
    var out: coreir.BodyOp
    out.kind = op.kind
    out.target = op.target
    out.operands = []
    for operandIndex in 0..<op.operands.len:
        add(out.operands, op.operands[operandIndex])
    return out

fn BodyIrNoAliasForwardLocalsInBlocks(bodyIR: coreir.BodyIR): coreir.BodyIR =
    if bodyIR.blocks.len <= 0 || bodyIR.terms.len <= 0:
        return bodyIR
    # Validate every block before any field leaves bodyIR: the old code
    # moved fields into `out` first and returned the gutted body on invalid
    # input; it also kept reading bodyIR after the move (use-after-move).
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.opStart < 0 ||
           block.opCount < 0 ||
           block.opStart + block.opCount > bodyIR.ops.len ||
           block.termIndex < 0 ||
           block.termIndex >= bodyIR.terms.len:
            return bodyIR
    var newOps: coreir.BodyOp[]
    for opIndex in 0..<bodyIR.ops.len:
        add(newOps, BodyIrNoAliasCloneOp(bodyIR.ops[opIndex]))
    var newTerms: coreir.BodyTerm[]
    for termIndex in 0..<bodyIR.terms.len:
        add(newTerms, share(bodyIR.terms[termIndex]))
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        var knownSource = BodyIrNoAliasIntSeqInit(bodyIR.localSlots.len, -1)
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            var op = newOps[opIndex]
            var dropOp = false
            BodyIrNoAliasForwardOp(bodyIR, op, knownSource, false, dropOp)
            newOps[opIndex] = op
        newTerms[block.termIndex] = BodyIrNoAliasForwardTerm(newTerms[block.termIndex],
                                                             knownSource)
    var out: coreir.BodyIR
    out.callSequence = bodyIR.callSequence
    out.localSlots = bodyIR.localSlots
    out.localBindingValueDefinitionDomainStart =
        bodyIR.localBindingValueDefinitionDomainStart
    out.localBindingValueDefinitionDomainCount =
        bodyIR.localBindingValueDefinitionDomainCount
    out.localBindingValueDefinitionRows =
        bodyIR.localBindingValueDefinitionRows
    out.blocks = bodyIR.blocks
    out.cstringLiterals = bodyIR.cstringLiterals
    out.entryIsCAbi = bodyIR.entryIsCAbi
    out.ops = newOps
    out.terms = newTerms
    return out

fn BodyIrNoAliasForwardLocalsLinear(bodyIR: coreir.BodyIR): coreir.BodyIR =
    if bodyIR.blocks.len > 0 || bodyIR.terms.len > 0:
        return bodyIR
    if bodyIR.localSlots.len <= 0 || bodyIR.ops.len <= 0:
        return bodyIR
    # Read phase first (borrowed views only), move the body afterwards:
    # reading bodyIR after `var out = bodyIR` is use-after-move.
    var newOps: coreir.BodyOp[]
    var knownSource = BodyIrNoAliasIntSeqInit(bodyIR.localSlots.len, -1)
    for opIndex in 0..<bodyIR.ops.len:
        var op = BodyIrNoAliasCloneOp(bodyIR.ops[opIndex])
        var dropOp = false
        BodyIrNoAliasForwardOp(bodyIR, op, knownSource, true, dropOp)
        if dropOp:
            continue
        add(newOps, op)
    var out = bodyIR
    coreir.BodyIRClearFrameLayoutCache(out)
    out.ops = newOps
    return out

fn BodyIrNoAliasForwardLocals(bodyIR: coreir.BodyIR): coreir.BodyIR =
    if bodyIR.blocks.len > 0 || bodyIR.terms.len > 0:
        return BodyIrNoAliasForwardLocalsInBlocks(bodyIR)
    return BodyIrNoAliasForwardLocalsLinear(bodyIR)

fn bodyIrNoAliasForwardLocalsInPlace(bodyIR: var coreir.BodyIR) =
    if bodyIR.blocks.len > 0 || bodyIR.terms.len > 0:
        if bodyIR.blocks.len <= 0 || bodyIR.terms.len <= 0:
            return
        for blockIndex in 0..<bodyIR.blocks.len:
            let block = bodyIR.blocks[blockIndex]
            if block.opStart < 0 ||
               block.opCount < 0 ||
               block.opStart + block.opCount > bodyIR.ops.len ||
               block.termIndex < 0 ||
               block.termIndex >= bodyIR.terms.len:
                return
            var knownSource = BodyIrNoAliasIntSeqInit(
                bodyIR.localSlots.len, -1)
            for opIndex in block.opStart..<(block.opStart + block.opCount):
                var op = BodyIrNoAliasCloneOp(bodyIR.ops[opIndex])
                var dropOp = false
                BodyIrNoAliasForwardOp(
                    bodyIR, op, knownSource, false, dropOp)
                bodyIR.ops[opIndex] = op
            var term = BodyIrNoAliasCloneTerm(
                bodyIR.terms[block.termIndex])
            if term.resultSlot >= 0:
                term.resultSlot = BodyIrNoAliasResolveSource(
                    knownSource, term.resultSlot)
            if term.lhsSlot >= 0:
                term.lhsSlot = BodyIrNoAliasResolveSource(
                    knownSource, term.lhsSlot)
            if term.rhsSlot >= 0:
                term.rhsSlot = BodyIrNoAliasResolveSource(
                    knownSource, term.rhsSlot)
            bodyIR.terms[block.termIndex] = term
        return
    if bodyIR.localSlots.len <= 0 || bodyIR.ops.len <= 0:
        return
    var forwardedOps: coreir.BodyOp[]
    var knownSource = BodyIrNoAliasIntSeqInit(bodyIR.localSlots.len, -1)
    for opIndex in 0..<bodyIR.ops.len:
        var op = BodyIrNoAliasCloneOp(bodyIR.ops[opIndex])
        var dropOp = false
        BodyIrNoAliasForwardOp(bodyIR, op, knownSource, true, dropOp)
        if !dropOp:
            add(forwardedOps, op)
    bodyIR.ops = forwardedOps
    coreir.BodyIRClearFrameLayoutCache(bodyIR)

@borrows
fn BodyIrNoAliasOpRewriteCount(before: coreir.BodyOp,
                                after: coreir.BodyOp): int32 =
    var count: int32
    if before.target != after.target:
        count = count + 1
    if before.operands.len != after.operands.len:
        count = count + 1
    var operandLimit = before.operands.len
    if after.operands.len < operandLimit:
        operandLimit = after.operands.len
    for operandIndex in 0..<operandLimit:
        if before.operands[operandIndex] != after.operands[operandIndex]:
            count = count + 1
    return count

@borrows
fn BodyIrNoAliasTermRewriteCount(before: coreir.BodyTerm,
                                  after: coreir.BodyTerm): int32 =
    var count: int32
    if before.resultSlot != after.resultSlot:
        count = count + 1
    if before.lhsSlot != after.lhsSlot:
        count = count + 1
    if before.rhsSlot != after.rhsSlot:
        count = count + 1
    return count

@borrows
fn BodyIrNoAliasRewriteCount(before: coreir.BodyIR,
                              after: coreir.BodyIR): int32 =
    var count: int32
    if before.ops.len != after.ops.len:
        count = count + 1
    var opLimit = before.ops.len
    if after.ops.len < opLimit:
        opLimit = after.ops.len
    for opIndex in 0..<opLimit:
        count = count + BodyIrNoAliasOpRewriteCount(before.ops[opIndex],
                                                    after.ops[opIndex])
    var termLimit = before.terms.len
    if after.terms.len < termLimit:
        termLimit = after.terms.len
    for termIndex in 0..<termLimit:
        count = count + BodyIrNoAliasTermRewriteCount(before.terms[termIndex],
                                                      after.terms[termIndex])
    return count

@borrows
fn BodyIrNoAliasHasSurface(bodyIR: coreir.BodyIR): bool =
    if bodyIR.localSlots.len > 0:
        return true
    if bodyIR.ops.len > 0:
        return true
    if bodyIR.blocks.len > 0:
        return true
    if bodyIR.terms.len > 0:
        return true
    if bodyIR.callSequence.len > 0:
        return true
    return false

fn BodyIrNoAliasFinalizeInto(bodyIR: var coreir.BodyIR,
                             report: var BodyIrNoAliasFinalizeReport) =
    report.bodyIR = bodyIR
    bodyIR = coreir.BodyIRNew()
    var stats: BodyIrNoAliasFinalizeStats
    BodyIrNoAliasFinalizeInPlace(report.bodyIR, stats)
    report.applied = stats.applied
    report.localCount = stats.localCount
    report.forwardRewriteCount = stats.forwardRewriteCount
    report.dodSoAContractOk = stats.dodSoAContractOk
    return

@borrows
fn BodyIrNoAliasCloneTerm(term: coreir.BodyTerm): coreir.BodyTerm =
    var out: coreir.BodyTerm
    out.kind = term.kind
    out.conditionKind = term.conditionKind
    out.resultSlot = term.resultSlot
    out.sourceDefinitionDomain = term.sourceDefinitionDomain
    out.sourceDefinitionRow = term.sourceDefinitionRow
    out.lhsSlot = term.lhsSlot
    out.rhsSlot = term.rhsSlot
    out.trueBlock = term.trueBlock
    out.falseBlock = term.falseBlock
    out.operands = []
    for operandIndex in 0..<term.operands.len:
        add(out.operands, term.operands[operandIndex])
    return out

fn BodyIrNoAliasFinalizeInPlace(bodyIR: var coreir.BodyIR,
                                stats: var BodyIrNoAliasFinalizeStats) =
    let inputDodReport = coreir.BodyIRDodSoAContractCheck(bodyIR)
    stats.dodSoAContractOk = inputDodReport.ok
    if !inputDodReport.ok || !BodyIrNoAliasHasSurface(bodyIR):
        return

    BodyIrAnalyzeOwnership(bodyIR)
    var beforeOps = bodyIR.ops
    bodyIR.ops = []
    for opIndex in 0..<beforeOps.len:
        add(bodyIR.ops, BodyIrNoAliasCloneOp(beforeOps[opIndex]))
    var beforeTerms = bodyIR.terms
    bodyIR.terms = []
    for termIndex in 0..<beforeTerms.len:
        add(bodyIR.terms, BodyIrNoAliasCloneTerm(beforeTerms[termIndex]))
    bodyIrNoAliasForwardLocalsInPlace(bodyIR)
    let outputDodReport = coreir.BodyIRDodSoAContractCheck(bodyIR)
    stats.dodSoAContractOk = outputDodReport.ok
    if !outputDodReport.ok:
        return

    stats.applied = true
    stats.localCount = BodyIrNoAliasLocalCount(bodyIR)
    var rewriteCount: int32
    if beforeOps.len != bodyIR.ops.len:
        rewriteCount = rewriteCount + 1
    var opLimit = beforeOps.len
    if bodyIR.ops.len < opLimit:
        opLimit = bodyIR.ops.len
    for opIndex in 0..<opLimit:
        rewriteCount = rewriteCount + BodyIrNoAliasOpRewriteCount(
            beforeOps[opIndex], bodyIR.ops[opIndex])
    var termLimit = beforeTerms.len
    if bodyIR.terms.len < termLimit:
        termLimit = bodyIR.terms.len
    for termIndex in 0..<termLimit:
        rewriteCount = rewriteCount + BodyIrNoAliasTermRewriteCount(
            beforeTerms[termIndex], bodyIR.terms[termIndex])
    stats.forwardRewriteCount = rewriteCount
    coreir.BodyIRClearFrameLayoutCache(bodyIR)
    return

fn BodyIrNoAliasFinalize(bodyIR: var coreir.BodyIR): BodyIrNoAliasFinalizeReport =
    var report: BodyIrNoAliasFinalizeReport
    BodyIrNoAliasFinalizeInto(bodyIR, report)
    return report
