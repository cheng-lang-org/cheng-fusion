    bodyIrSequenceAppendBool(buf, sidecar.sealed)
    layout.ByteBufAppendFixed32(buf, sidecar.rootCid)
    layout.ByteBufAppendFixed32(buf, sidecar.sourceControlCid)
    layout.ByteBufAppendFixed32(buf, sidecar.ownershipIrCid)
    layout.ByteBufAppendFixed32(buf, sidecar.ownershipAnalysisCid)
    bodyIrSequenceAppendI32(buf, sidecar.originalLocalCount)
    bodyIrSequenceAppendI32(buf, sidecar.originalOpCount)
    bodyIrSequenceAppendI32(buf, sidecar.originalCallCount)
    bodyIrSequenceAppendI32(buf, sidecar.originalBlockCount)
    bodyIrSequenceAppendI32(buf, sidecar.originalTermCount)
    bodyIrSequenceAppendInt32s(buf, sidecar.sourceBlockIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.sourceTermRows)
    bodyIrSequenceAppendFixed32s(buf, sidecar.sourceTermCids)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.sourceSuccessorOrdinals)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.originalSuccessorCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.sourceExitKinds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.originalTargetBlockIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.originalEdgeKinds)
    bodyIrSequenceAppendInt32s(buf, sidecar.sourceScopeIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.targetScopeIds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.exitOwnershipEdgeIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.selectedDeferStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.selectedDeferCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.exitUnitStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.exitUnitCounts)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.siteOriginalBlockIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.siteAfterOpOrdinals)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.siteOwnershipOpStarts)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.siteOwnershipOpCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.siteUnitStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.siteUnitCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.ownershipOpRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.selectedDeferIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitKinds)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitSemanticDomains)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitSemanticStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitSemanticCounts)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.unitSnapshotSourceSlotStarts)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.unitSnapshotSourceSlotCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitConditionStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitConditionCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitClearStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitClearCounts)
    bodyIrSequenceAppendFixed32s(buf, sidecar.unitAuthorityCids)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.snapshotSourceSlotIds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.snapshotProjectionPolicies)
    bodyIrSequenceAppendInt32s(buf, sidecar.snapshotSemanticRows)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.snapshotTypeArenaTypeIds)
    bodyIrSequenceAppendFixed32s(
        buf, sidecar.snapshotInterfaceCids)
    bodyIrSequenceAppendInt32s(buf, sidecar.conditionKinds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.conditionInputSourceSlotIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.conditionSemanticRows)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.conditionSemanticOrdinals)
    bodyIrSequenceAppendInt32s(buf, sidecar.clearKinds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.clearTargetSourceSlotIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.clearSemanticRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.clearSemanticOrdinals)

@borrows
fn bodyIrSequenceAppendCleanupScheduleSidecar(
        buf: var layout.ByteBuf,
        sidecar: coreir.BodyIRCleanupScheduleSidecar) =
    bodyIrSequenceAppendBool(buf, sidecar.building)
    bodyIrSequenceAppendBool(buf, sidecar.sealed)
    layout.ByteBufAppendFixed32(buf, sidecar.rootCid)
    layout.ByteBufAppendFixed32(buf, sidecar.finalControlCid)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.ownerPhysicalSourceBlockIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.ownerSourceTermRows)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.ownerSourceSuccessorOrdinals)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.ownerFinalContinuationBlockIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.ownerFinalEdgeKinds)
    bodyIrSequenceAppendFixed32s(
        buf, sidecar.ownerContinuationCids)
    bodyIrSequenceAppendInt32s(buf, sidecar.opStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.opCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.callStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.callCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.blockStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.blockCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.termStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.termCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitLocalStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitLocalCounts)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.unitProjectedSnapshotSlotStarts)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.unitProjectedSnapshotSlotCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitEffectStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.unitEffectCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.effectSemanticRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.effectPhysicalDomains)
    bodyIrSequenceAppendInt32s(buf, sidecar.effectPhysicalRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.effectRoles)
    bodyIrSequenceAppendFixed32s(buf, sidecar.payloadCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.placementCids)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.projectedSnapshotSlotIds)

@borrows
fn bodyIrSequenceAppendDeferReplaySidecar(
        buf: var layout.ByteBuf,
        sidecar: coreir.BodyIRDeferReplaySidecar) =
    bodyIrSequenceAppendBool(buf, sidecar.building)
    bodyIrSequenceAppendBool(buf, sidecar.sealed)
