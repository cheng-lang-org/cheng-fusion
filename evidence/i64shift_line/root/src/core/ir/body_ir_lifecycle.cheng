import std/seqs
import std/hashmaps
import cheng/core/ir/core_types as coreir
import cheng/core/ir/phase_arena as phase
import cheng/core/tooling/lifetime_ledger as lifetime
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

# BodyIR owns nested sequence buffers and managed strings. Assigning a fresh
# BodyIR only clears headers; it does not prove that those buffers were
# physically released. This module is the single release boundary shared by
# production backends.

const
    BodyIrFunctionLifecyclePhaseEmpty = 0
    BodyIrFunctionLifecyclePhaseLowered = 1
    BodyIrFunctionLifecyclePhaseFrozenFragment = 2
    BodyIrFunctionLifecyclePhaseEmitter = 3
    BodyIrFunctionLifecyclePhaseReleased = 4

    BodyIrFunctionOutcomeEmitSuccess = 1
    BodyIrFunctionOutcomeDiagnostic = 2
    BodyIrFunctionOutcomeEmitFailure = 3
    BodyIrFunctionOutcomeEarlyReturn = 4
    BodyIrFunctionOutcomeCacheReuse = 5
    BodyIrFunctionOutcomeFragmentFrozen = 6

    BodyIrFunctionIdentitySource = 1
    BodyIrFunctionIdentitySyntheticEntryBridge = 2
    BodyIrSyntheticEntryBridgeIndex = 0

type
    BodyIrPayloadRetainedReport =
        retainedBytes: int64
        physicalBufferCount: int32
        managedStringValueCount: int32
        managedStringBytes: int64

    # Minted only by BodyIrPayloadRelease after the exact BodyIR owner has
    # physically released every nested and top-level sequence.  Global runtime
    # allocator counters are diagnostic-only and cannot satisfy this receipt.
    BodyIrPayloadReleaseReceipt =
        releasedBytes: int64
        releasedBufferCount: int32
        releasedManagedStringValueCount: int32
        releasedManagedStringBytes: int64
        storageReleased: bool

    BodyIrPayloadReleaseSequenceReceipt =
        ownerToken: layout.FixedBytes32
        releasedFunctionCount: int32
        releasedPayloadFunctionCount: int32
        releasedBufferCount: int32
        releasedBytes: int64
        releasedManagedStringValueCount: int32
        releasedManagedStringBytes: int64
        storageReleased: bool

    BodyIrPayloadReleaseSequenceState =
        terminalOwnerToken: layout.FixedBytes32
        terminalReleasedFunctionCount: int32
        terminalReleasedPayloadFunctionCount: int32
        terminalReleasedBufferCount: int32
        terminalReleasedBytes: int64
        terminalReleasedManagedStringValueCount: int32
        terminalReleasedManagedStringBytes: int64
        terminalStorageReleased: bool
        terminalReceiptConsumed: bool

    BodyIrFunctionLifecycle =
        ledger: lifetime.LifetimeLedger
        phaseArena: phase.PhaseArenaStore
        phaseArenaHandle: phase.PhaseArenaHandle
        phaseMetadataColumn: phase.PhaseArenaRef
        functionIrIndex: int32 = -1
        functionIdentityKind: int32
        functionIdentityIndex: int32 = -1
        categoryId: int32
        loweringOwnerId: int32
        frozenFragmentOwnerId: int32
        emitterOwnerId: int32
        primaryPreRegallocOwnerId: int32
        regallocConsumerOwnerId: int32
        primaryPostRegallocOwnerId: int32
        objectId: int32
        primaryPreRegallocBorrowId: int32
        regallocBorrowId: int32
        primaryPostRegallocBorrowId: int32
        phase: int32
        primaryPreRegallocBorrowStarted: bool
        primaryPreRegallocBorrowActive: bool
        regallocBorrowStarted: bool
        regallocBorrowActive: bool
        primaryPostRegallocBorrowStarted: bool
        primaryPostRegallocBorrowActive: bool
        retained: BodyIrPayloadRetainedReport

    BodyIrFunctionLifecycleReceipt =
        functionIrIndex: int32 = -1
        functionIdentityKind: int32
        functionIdentityIndex: int32 = -1
        outcome: int32
        allocated: int64
        released: int64
        live: int64
        allocatedBytes: int64
        releasedBytes: int64
        liveBytes: int64
        retained: int64
        borrowReturnCount: int64
        ownerTransferCount: int64
        retainedBytes: int64
        physicalBufferCount: int32
        bodyPhysicalFreeCount: int64
        ledgerStorageReleased: bool
        ledgerStorageReleasedSequenceCount: int32
        ledgerStorageReleasedBufferCount: int32
        ledgerStorageReleasedBytes: int64
        phaseArenaStorageReleased: bool
        phaseArenaReleasedBufferCount: int32
        phaseArenaReleasedBytes: int64
        payloadReleased: bool


fn bodyIrLifecycleFail(message: str) =
    panic(message)

fn bodyIrPayloadRecordSequence(report: var BodyIrPayloadRetainedReport,
                               capacity: int32,
                               elementBytes: int64) =
    if capacity < 0 || elementBytes <= int64(0):
        bodyIrLifecycleFail("body ir lifecycle: invalid sequence shape")
    if capacity == 0:
        return
    report.physicalBufferCount = report.physicalBufferCount + 1
    report.retainedBytes =
        report.retainedBytes + int64(capacity) * elementBytes

@borrows
fn bodyIrPayloadRecordString(report: var BodyIrPayloadRetainedReport,
                             value: str) =
    if len(value) <= 0:
        return
    report.managedStringValueCount =
        report.managedStringValueCount + 1
    report.managedStringBytes =
        report.managedStringBytes + int64(len(value))
    report.retainedBytes =
        report.retainedBytes + int64(len(value))

@borrows
fn bodyIrPayloadRecordI32Rows(
        report: var BodyIrPayloadRetainedReport,
        rows: int32[]) =
    bodyIrPayloadRecordSequence(
        report, rows.cap, int64(sizeof(int32)))

@borrows
fn bodyIrPayloadRecordFixed32Rows(
        report: var BodyIrPayloadRetainedReport,
        rows: layout.FixedBytes32[]) =
    bodyIrPayloadRecordSequence(
        report, rows.cap, int64(sizeof(layout.FixedBytes32)))

@borrows
fn bodyIrPayloadRecordCleanupIntentSidecar(
        report: var BodyIrPayloadRetainedReport,
        sidecar: coreir.BodyIRCleanupIntentSidecar) =
    bodyIrPayloadRecordI32Rows(report, sidecar.sourceBlockIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.sourceTermRows)
    bodyIrPayloadRecordFixed32Rows(report, sidecar.sourceTermCids)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.sourceSuccessorOrdinals)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.originalSuccessorCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.sourceExitKinds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.originalTargetBlockIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.originalEdgeKinds)
    bodyIrPayloadRecordI32Rows(report, sidecar.sourceScopeIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.targetScopeIds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.exitOwnershipEdgeIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.selectedDeferStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.selectedDeferCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.exitUnitStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.exitUnitCounts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.siteOriginalBlockIds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.siteAfterOpOrdinals)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.siteOwnershipOpStarts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.siteOwnershipOpCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.siteUnitStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.siteUnitCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.ownershipOpRows)
    bodyIrPayloadRecordI32Rows(report, sidecar.selectedDeferIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.unitKinds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitSemanticDomains)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitSemanticStarts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitSemanticCounts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitSnapshotSourceSlotStarts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitSnapshotSourceSlotCounts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitConditionStarts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitConditionCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.unitClearStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.unitClearCounts)
    bodyIrPayloadRecordFixed32Rows(
        report, sidecar.unitAuthorityCids)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.snapshotSourceSlotIds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.snapshotProjectionPolicies)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.snapshotSemanticRows)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.snapshotTypeArenaTypeIds)
    bodyIrPayloadRecordFixed32Rows(
        report, sidecar.snapshotInterfaceCids)
    bodyIrPayloadRecordI32Rows(report, sidecar.conditionKinds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.conditionInputSourceSlotIds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.conditionSemanticRows)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.conditionSemanticOrdinals)
    bodyIrPayloadRecordI32Rows(report, sidecar.clearKinds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.clearTargetSourceSlotIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.clearSemanticRows)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.clearSemanticOrdinals)

@borrows
fn bodyIrPayloadRecordCleanupScheduleSidecar(
        report: var BodyIrPayloadRetainedReport,
        sidecar: coreir.BodyIRCleanupScheduleSidecar) =
    bodyIrPayloadRecordI32Rows(
        report, sidecar.ownerPhysicalSourceBlockIds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.ownerSourceTermRows)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.ownerSourceSuccessorOrdinals)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.ownerFinalContinuationBlockIds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.ownerFinalEdgeKinds)
    bodyIrPayloadRecordFixed32Rows(
        report, sidecar.ownerContinuationCids)
    bodyIrPayloadRecordI32Rows(report, sidecar.opStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.opCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.callStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.callCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.blockStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.blockCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.termStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.termCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.unitLocalStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.unitLocalCounts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitProjectedSnapshotSlotStarts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.unitProjectedSnapshotSlotCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.unitEffectStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.unitEffectCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.effectSemanticRows)
    bodyIrPayloadRecordI32Rows(report, sidecar.effectPhysicalDomains)
    bodyIrPayloadRecordI32Rows(report, sidecar.effectPhysicalRows)
    bodyIrPayloadRecordI32Rows(report, sidecar.effectRoles)
    bodyIrPayloadRecordFixed32Rows(report, sidecar.payloadCids)
    bodyIrPayloadRecordFixed32Rows(report, sidecar.placementCids)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.projectedSnapshotSlotIds)

@borrows
fn bodyIrPayloadRecordDeferReplaySidecar(
        report: var BodyIrPayloadRetainedReport,
        sidecar: coreir.BodyIRDeferReplaySidecar) =
    bodyIrPayloadRecordI32Rows(
        report, sidecar.templateOpMapStarts)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.templateOpMapCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.templateOpRows)

@borrows
fn bodyIrPayloadRecordManagedLvalueReplaceSidecar(
        report: var BodyIrPayloadRetainedReport,
        sidecar: coreir.BodyIRManagedLvalueReplaceSidecar) =
    bodyIrPayloadRecordI32Rows(report, sidecar.callOrdinals)
    bodyIrPayloadRecordI32Rows(report, sidecar.replaceOpRows)
    bodyIrPayloadRecordI32Rows(report, sidecar.targetKinds)
    bodyIrPayloadRecordI32Rows(report, sidecar.replaceModes)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.targetLvalueNodeIndexes)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.sourceValueNodeIndexes)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.targetRootDefinitionDomains)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.targetRootDefinitionRows)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.targetAddressSlotIds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.targetAddressDefinitionRows)
    bodyIrPayloadRecordI32Rows(report, sidecar.targetTypeIds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.sourceDefinitionDomains)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.sourceDefinitionRows)
    bodyIrPayloadRecordI32Rows(report, sidecar.sourceSlotIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.sourceSemanticRows)
    bodyIrPayloadRecordI32Rows(report, sidecar.consumeActionRows)
    bodyIrPayloadRecordFixed32Rows(
        report, sidecar.runtimeSemanticCids)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathStarts)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathCounts)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathKinds)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.pathProjectionNodeIndexes)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathParentTypeIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathIdentityKinds)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathIdentityRows)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathSelectorOrdinals)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathResultTypeIds)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathByteOffsets)
    bodyIrPayloadRecordI32Rows(report, sidecar.pathByteWidths)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.pathIndexNodeIndexes)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.pathIndexDefinitionDomains)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.pathIndexDefinitionRows)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.dropGlueDescriptorRows)
    bodyIrPayloadRecordI32Rows(
        report, sidecar.descriptorRootTypeIds)
    bodyIrPayloadRecordSequence(
        report, sidecar.descriptorPayloads.cap,
        int64(sizeof(str)))
    for descriptorRow in 0..<sidecar.descriptorPayloads.len:
        bodyIrPayloadRecordString(
            report, sidecar.descriptorPayloads[descriptorRow])
    bodyIrPayloadRecordFixed32Rows(
        report, sidecar.descriptorDigests)

