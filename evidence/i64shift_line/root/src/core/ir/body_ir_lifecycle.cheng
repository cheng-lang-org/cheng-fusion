@borrows
fn bodyIrSequenceAppendManagedLvalueReplaceSidecar(
        buf: var layout.ByteBuf,
        sidecar: coreir.BodyIRManagedLvalueReplaceSidecar) =
    bodyIrSequenceAppendBool(buf, sidecar.building)
    bodyIrSequenceAppendBool(buf, sidecar.sealed)
    bodyIrSequenceAppendI32(buf, sidecar.functionRow)
    layout.ByteBufAppendFixed32(buf, sidecar.typeArenaArtifactCid)
    bodyIrSequenceAppendInt32s(buf, sidecar.callOrdinals)
    bodyIrSequenceAppendInt32s(buf, sidecar.replaceOpRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.targetKinds)
    bodyIrSequenceAppendInt32s(buf, sidecar.replaceModes)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.targetLvalueNodeIndexes)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.sourceValueNodeIndexes)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.targetRootDefinitionDomains)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.targetRootDefinitionRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.targetAddressSlotIds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.targetAddressDefinitionRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.targetTypeIds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.sourceDefinitionDomains)
    bodyIrSequenceAppendInt32s(buf, sidecar.sourceDefinitionRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.sourceSlotIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.sourceSemanticRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.consumeActionRows)
    bodyIrSequenceAppendFixed32s(buf, sidecar.runtimeSemanticCids)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathCounts)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathKinds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.pathProjectionNodeIndexes)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathParentTypeIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathIdentityKinds)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathIdentityRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathSelectorOrdinals)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathResultTypeIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathByteOffsets)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathByteWidths)
    bodyIrSequenceAppendInt32s(buf, sidecar.pathIndexNodeIndexes)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.pathIndexDefinitionDomains)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.pathIndexDefinitionRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.dropGlueDescriptorRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.descriptorRootTypeIds)
    bodyIrSequenceAppendTexts(buf, sidecar.descriptorPayloads)
    bodyIrSequenceAppendFixed32s(buf, sidecar.descriptorDigests)
    layout.ByteBufAppendFixed32(buf, sidecar.rootCid)

fn bodyIrSequenceAppendBody(
        buf: var layout.ByteBuf,
        bodyIR: var coreir.BodyIR) =
    layout.ByteBufAppendFixed32(buf, bodyIR.typeArenaArtifactCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupSourceProjectionCid)
    bodyIrSequenceAppendInt32s(buf, bodyIR.typeFactTypeIds)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.typeFactStructuralKinds)
    bodyIrSequenceAppendInt32s(buf, bodyIR.typeFactScalarKinds)
    bodyIrSequenceAppendInt32s(buf, bodyIR.typeFactChildTypeIds)
    bodyIrSequenceAppendInt32s(buf, bodyIR.typeFactFixedLengths)
    bodyIrSequenceAppendInt32s(buf, bodyIR.typeFactSizeBytes)
    bodyIrSequenceAppendInt32s(buf, bodyIR.typeFactAlignBytes)

    bodyIrSequenceAppendI32(buf, bodyIR.ops.len)
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        bodyIrSequenceAppendI32(buf, op.kind)
        bodyIrSequenceAppendInt32s(buf, op.operands)
        bodyIrSequenceAppendI32(buf, op.target)
        bodyIrSequenceAppendI32(buf, op.valueDefSlot)
        bodyIrSequenceAppendI32(buf, op.valueDefExprNodeIndex)
        bodyIrSequenceAppendI32(buf, op.valueDefSemanticRow)
        bodyIrSequenceAppendI32(buf, Int32(op.valueDefOwnership))
        bodyIrSequenceAppendI32(
            buf, op.valueDefConsumeOpIndexPlusOne)
        bodyIrSequenceAppendI32(buf, op.valueDefOriginKind)
        bodyIrSequenceAppendI32(buf, op.valueDefOriginId)
        bodyIrSequenceAppendI32(buf, op.sourceDefinitionDomain)
        bodyIrSequenceAppendI32(buf, op.sourceDefinitionRow)
        bodyIrSequenceAppendI32(buf, op.consumeActionRow)

    bodyIrSequenceAppendI32(buf, bodyIR.callSequence.len)
    for callIndex in 0..<bodyIR.callSequence.len:
        let call = bodyIR.callSequence[callIndex]
        bodyIrSequenceAppendText(buf, call.targetSymbol)
        bodyIrSequenceAppendText(buf, call.targetSourcePath)
        bodyIrSequenceAppendInt32s(buf, call.argSlots)
        bodyIrSequenceAppendInt32s(buf, call.argPassKinds)
        bodyIrSequenceAppendInt32s(buf, call.argAbiSizes)
        bodyIrSequenceAppendI32(buf, call.resultSlot)
        bodyIrSequenceAppendI32(buf, call.resultPassKind)
        bodyIrSequenceAppendI32(buf, Int32(call.resultOwnership))
        bodyIrSequenceAppendI32(buf, call.resultExprNodeIndex)
        bodyIrSequenceAppendI32(
            buf, call.resultValueDefinitionRow)
        bodyIrSequenceAppendI32(
            buf, call.resultDefinitionOriginKind)
        bodyIrSequenceAppendI32(
            buf, call.resultDefinitionOriginId)
        bodyIrSequenceAppendI32(buf, call.sourceDefinitionDomain)
        bodyIrSequenceAppendI32(buf, call.sourceDefinitionRow)
        bodyIrSequenceAppendI32(
            buf, call.semanticCallExprNodeIndex)
        bodyIrSequenceAppendI32(buf, call.consumeActionRow)
        bodyIrSequenceAppendI32(buf, call.managedStoreKind)
        bodyIrSequenceAppendI32(
            buf, call.managedReplaceReceiptRow)
        bodyIrSequenceAppendI32(
            buf, call.managedDropGlueDescriptorRow)
        bodyIrSequenceAppendI32(buf, call.relocWordOffset)
        bodyIrSequenceAppendBool(buf, call.targetIsImportc)
        bodyIrSequenceAppendI32(buf, call.inlineF64FromIntKind)
        bodyIrSequenceAppendBool(
            buf, call.wholeCallF64FromIntRescue)
        bodyIrSequenceAppendBool(
            buf, call.inlineF64FromIntUnsigned)

    bodyIrSequenceAppendI32(buf, bodyIR.localSlots.len)
    for slotIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotIndex]
        bodyIrSequenceAppendI32(buf, slot.id)
        bodyIrSequenceAppendText(buf, slot.name)
        bodyIrSequenceAppendI32(buf, slot.typeKind)
        bodyIrSequenceAppendI32(buf, slot.typeArenaTypeId)
        bodyIrSequenceAppendI32(buf, slot.managedStorageKind)
        bodyIrSequenceAppendI32(buf, slot.placeKind)
        bodyIrSequenceAppendI32(buf, slot.stackOffset)
        bodyIrSequenceAppendI32(buf, slot.sizeBytes)
        bodyIrSequenceAppendI32(buf, slot.alignBytes)
        bodyIrSequenceAppendI32(buf, slot.auxValue)
        bodyIrSequenceAppendI32(buf, Int32(slot.ownership))
        bodyIrSequenceAppendI32(buf, Int32(slot.aliasClass))
        bodyIrSequenceAppendI32(buf, Int32(slot.escapeKind))
        bodyIrSequenceAppendBool(buf, slot.noAlias)

    bodyIrSequenceAppendBool(
        buf, bodyIR.entryDefinitionOwnershipSealed)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.entryDefinitionOwnershipKinds)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.entryDefinitionSemanticRows)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.entryParameterSlotIds)
    bodyIrSequenceAppendI32(
        buf, bodyIR.localBindingValueDefinitionDomainStart)
    bodyIrSequenceAppendI32(
        buf, bodyIR.localBindingValueDefinitionDomainCount)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.localBindingValueDefinitionRows)
    bodyIrSequenceAppendBool(
        buf, bodyIR.dataRelocationIdentitySealed)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.localAddressTargetDomainKinds)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.localAddressTargetRows)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.localAddressTargetCids)

    bodyIrSequenceAppendI32(buf, bodyIR.slotNameIndex.keys.len)
    for keyIndex in 0..<bodyIR.slotNameIndex.keys.len:
        bodyIrSequenceAppendText(
            buf, bodyIR.slotNameIndex.keys[keyIndex])
    bodyIrSequenceAppendInt32s(buf, bodyIR.slotNameIndex.vals)

    bodyIrSequenceAppendI32(buf, bodyIR.blocks.len)
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        bodyIrSequenceAppendI32(buf, block.id)
        bodyIrSequenceAppendI32(buf, block.opStart)
        bodyIrSequenceAppendI32(buf, block.opCount)
        bodyIrSequenceAppendI32(buf, block.termIndex)

    bodyIrSequenceAppendI32(buf, bodyIR.terms.len)
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        bodyIrSequenceAppendI32(buf, term.kind)
        bodyIrSequenceAppendI32(buf, term.conditionKind)
        bodyIrSequenceAppendI32(buf, term.resultSlot)
        bodyIrSequenceAppendI32(buf, term.sourceDefinitionDomain)
        bodyIrSequenceAppendI32(buf, term.sourceDefinitionRow)
        bodyIrSequenceAppendI32(buf, term.lhsSlot)
        bodyIrSequenceAppendI32(buf, term.rhsSlot)
        bodyIrSequenceAppendI32(buf, term.trueBlock)
        bodyIrSequenceAppendI32(buf, term.falseBlock)
        bodyIrSequenceAppendInt32s(buf, term.operands)

    bodyIrSequenceAppendI32(buf, bodyIR.cstringLiterals.len)
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        let literal = bodyIR.cstringLiterals[literalIndex]
        bodyIrSequenceAppendI32(buf, literal.id)
        bodyIrSequenceAppendText(buf, literal.text)
        bodyIrSequenceAppendText(buf, literal.dataLabel)
    bodyIrSequenceAppendInt32s(buf, bodyIR.cstringTargetRows)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.cstringOwnerFunctionFragmentCids)

    bodyIrSequenceAppendBool(buf, bodyIR.debugProvenanceRequired)
    bodyIrSequenceAppendBool(buf, bodyIR.debugProvenanceComplete)
    bodyIrSequenceAppendI32(buf, bodyIR.debugFunctionId)
    bodyIrSequenceAppendInt32s(buf, bodyIR.debugOpIdsByOpIndex)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.debugSyntheticKindsByOpIndex)
    bodyIrSequenceAppendInt32s(buf, bodyIR.debugOpIdsByTermIndex)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.debugSyntheticKindsByTermIndex)
    bodyIrSequenceAppendI32(buf, bodyIR.debugCurrentOpId)
    bodyIrSequenceAppendI32(buf, bodyIR.debugCurrentSyntheticKind)
    bodyIrSequenceAppendBool(buf, bodyIR.entryIsCAbi)
    bodyIrSequenceAppendBool(buf, bodyIR.frameMetricsReady)
    bodyIrSequenceAppendI32(buf, bodyIR.frameStackByteCount)
    bodyIrSequenceAppendI32(buf, bodyIR.frameParamSaveCount)
    bodyIrSequenceAppendI32(buf, bodyIR.frameParamSaveOffset)
    bodyIrSequenceAppendI32(
        buf, bodyIR.frameReturnBufferSaveOffset)
    bodyIrSequenceAppendI32(buf, bodyIR.frameBytes)
    bodyIrSequenceAppendI32(buf, bodyIR.framePrologueWordCount)
    bodyIrSequenceAppendI32(buf, bodyIR.frameRestoreWordCount)
    bodyIrSequenceAppendInt32s(buf, bodyIR.layoutCmpFuse)
    bodyIrSequenceAppendInt32s(buf, bodyIR.layoutCbrFuse)
    bodyIrSequenceAppendBools(buf, bodyIR.layoutLhsElide)
    bodyIrSequenceAppendBools(buf, bodyIR.layoutStoreElide)
    bodyIrSequenceAppendBools(buf, bodyIR.layoutCopySrcElide)
    bodyIrSequenceAppendBool(buf, bodyIR.x64StackLayoutReady)
    bodyIrSequenceAppendInt32s(buf, bodyIR.x64SlotReadCnt)
    bodyIrSequenceAppendBool(buf, bodyIR.x64BlockStartReady)
    bodyIrSequenceAppendInt32s(buf, bodyIR.x64BlockByteStart)
    bodyIrSequenceAppendManagedLvalueReplaceSidecar(
        buf, bodyIR.managedLvalueReplace)
    bodyIrSequenceAppendBool(buf, bodyIR.manualConsume.sealed)
    bodyIrSequenceAppendBool(
        buf, bodyIR.manualConsume.functionPresent)
    bodyIrSequenceAppendI32(buf, bodyIR.manualConsume.functionRow)
    bodyIrSequenceAppendI32(
        buf,
        bodyIR.manualConsume.functionTargetParameterOrdinal)
    bodyIrSequenceAppendI32(
        buf,
        bodyIR.manualConsume.functionSourceParameterOrdinal)
    bodyIrSequenceAppendI32(
        buf, bodyIR.manualConsume.functionTargetSlotId)
    bodyIrSequenceAppendI32(
        buf, bodyIR.manualConsume.functionSourceSlotId)
    bodyIrSequenceAppendI32(
        buf,
        bodyIR.manualConsume.functionTargetTypeArenaTypeId)
    bodyIrSequenceAppendI32(
        buf,
        bodyIR.manualConsume.functionSourceTypeArenaTypeId)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.manualConsume.functionEffectCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.manualConsume.functionBodyProofCid)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.callOrdinals)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.snapshotCallIds)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.targetArgumentOrdinals)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.sourceArgumentOrdinals)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.targetPlaceSlotIds)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.targetOwnerSlotIds)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.sourcePlaceSlotIds)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.manualConsume.targetArgumentBindingCids)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.manualConsume.sourceArgumentBindingCids)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.manualConsume.targetProjectionCids)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.manualConsume.sourceProjectionCids)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.targetDefinitionDomains)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.targetDefinitionRows)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.sourceDefinitionDomains)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.sourceDefinitionRows)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.targetTypeArenaTypeIds)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.sourceTypeArenaTypeIds)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.postDefinitionDomains)
    bodyIrSequenceAppendInt32s(
        buf, bodyIR.manualConsume.postDefinitionRows)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.manualConsume.effectCids)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.manualConsume.linearTokenCids)
    bodyIrSequenceAppendFixed32s(
        buf, bodyIR.manualConsume.bridgeCids)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.manualConsume.rootCid)
    bodyIrSequenceAppendCleanupIntentSidecar(
        buf, bodyIR.cleanupIntent)
    bodyIrSequenceAppendCleanupScheduleSidecar(
        buf, bodyIR.cleanupSchedule)
    bodyIrSequenceAppendDeferReplaySidecar(buf, bodyIR.deferReplay)
    bodyIrSequenceAppendExternFfiHandleCapabilities(
        buf, bodyIR.externFfiHandleCapabilities)

fn BodyIrPayloadRetainedSequence(
        bodyIRs: var coreir.BodyIR[]):
        BodyIrPayloadRetainedReport =
    var out: BodyIrPayloadRetainedReport
    bodyIrPayloadRecordSequence(
        out, bodyIRs.cap, int64(sizeof(coreir.BodyIR)))
    for bodyIndex in 0..<bodyIRs.len:
        let retained = BodyIrPayloadRetained(bodyIRs[bodyIndex])
        out.retainedBytes = out.retainedBytes + retained.retainedBytes
        out.physicalBufferCount =
            out.physicalBufferCount + retained.physicalBufferCount
        out.managedStringValueCount =
            out.managedStringValueCount +
            retained.managedStringValueCount
        out.managedStringBytes =
            out.managedStringBytes + retained.managedStringBytes
    return out

fn bodyIrPayloadReleaseSequenceOwnerToken(
        bodyIRs: var coreir.BodyIR[],
        retained: BodyIrPayloadRetainedReport):
        layout.FixedBytes32 =
    var buf = layout.ByteBufInit(4096)
    bodyIrSequenceAppendText(
        buf, "cheng.compiler.body_ir_payload_sequence.release")
    bodyIrSequenceAppendI32(buf, bodyIRs.len)
    bodyIrSequenceAppendI32(buf, retained.physicalBufferCount)
    bodyIrSequenceAppendU32BE(buf, retained.retainedBytes >> 32)
    bodyIrSequenceAppendU32BE(buf, retained.retainedBytes)
    bodyIrSequenceAppendI32(
        buf, retained.managedStringValueCount)
    bodyIrSequenceAppendU32BE(
        buf, retained.managedStringBytes >> 32)
    bodyIrSequenceAppendU32BE(buf, retained.managedStringBytes)
    for bodyIndex in 0..<bodyIRs.len:
        bodyIrSequenceAppendI32(buf, bodyIndex)
        bodyIrSequenceAppendBody(buf, bodyIRs[bodyIndex])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn BodyIrPayloadReleaseSequenceStorageReleased(
        bodyIRs: var coreir.BodyIR[]): bool =
    return bodyIRs.len == 0 && bodyIRs.cap == 0 &&
           BodyIrPayloadRetainedSequence(bodyIRs).retainedBytes ==
               int64(0) &&
           BodyIrPayloadRetainedSequence(bodyIRs).physicalBufferCount == 0

fn BodyIrPayloadReleaseSequenceWithReceipt(
        bodyIRs: var coreir.BodyIR[],
        state: var BodyIrPayloadReleaseSequenceState,
        receipt: var BodyIrPayloadReleaseSequenceReceipt) =
    if state.terminalStorageReleased ||
       state.terminalReceiptConsumed ||
       !layout.FixedBytes32Equal(
           state.terminalOwnerToken, layout.FixedBytes32()) ||
       state.terminalReleasedFunctionCount != 0 ||
       state.terminalReleasedPayloadFunctionCount != 0 ||
       state.terminalReleasedBufferCount != 0 ||
       state.terminalReleasedBytes != int64(0) ||
       state.terminalReleasedManagedStringValueCount != 0 ||
       state.terminalReleasedManagedStringBytes != int64(0) ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken, layout.FixedBytes32()) ||
       receipt.releasedFunctionCount != 0 ||
       receipt.releasedPayloadFunctionCount != 0 ||
       receipt.releasedBufferCount != 0 ||
       receipt.releasedBytes != int64(0) ||
       receipt.releasedManagedStringValueCount != 0 ||
       receipt.releasedManagedStringBytes != int64(0) ||
       receipt.storageReleased:
        bodyIrLifecycleFail(
            "body ir lifecycle: duplicate or corrupt sequence release")
    let retained = BodyIrPayloadRetainedSequence(bodyIRs)
    let functionCount = bodyIRs.len
    let ownerToken =
        bodyIrPayloadReleaseSequenceOwnerToken(bodyIRs, retained)
    if layout.FixedBytes32Equal(
           ownerToken, layout.FixedBytes32()) ||
       retained.physicalBufferCount < 0 ||
       retained.retainedBytes < int64(0) ||
       retained.managedStringValueCount < 0 ||
       retained.managedStringBytes < int64(0):
        bodyIrLifecycleFail(
            "body ir lifecycle: invalid sequence release preimage")
    var releasedPayloadFunctionCount: int32
    var releasedNestedBufferCount: int32
    var releasedNestedBytes: int64
    var releasedManagedStringValueCount: int32
    var releasedManagedStringBytes: int64
    for bodyIndex in 0..<bodyIRs.len:
        let bodyRetained = BodyIrPayloadRetained(bodyIRs[bodyIndex])
        if bodyRetained.physicalBufferCount > 0:
            releasedPayloadFunctionCount =
                releasedPayloadFunctionCount + 1
        let bodyReceipt =
            BodyIrPayloadRelease(bodyIRs[bodyIndex])
        releasedNestedBufferCount =
            releasedNestedBufferCount +
            bodyReceipt.releasedBufferCount
        releasedNestedBytes =
            releasedNestedBytes + bodyReceipt.releasedBytes
        releasedManagedStringValueCount =
            releasedManagedStringValueCount +
            bodyReceipt.releasedManagedStringValueCount
        releasedManagedStringBytes =
            releasedManagedStringBytes +
            bodyReceipt.releasedManagedStringBytes
    let outerBufferCount = bodyIRs.cap > 0 ? 1 : 0
    let outerBytes =
        int64(bodyIRs.cap) * int64(sizeof(coreir.BodyIR))
    freeSeq(bodyIRs)
    let storageReleased =
        BodyIrPayloadReleaseSequenceStorageReleased(bodyIRs)
    if !storageReleased ||
       releasedNestedBufferCount + outerBufferCount !=
           retained.physicalBufferCount ||
       releasedNestedBytes + outerBytes != retained.retainedBytes ||
       releasedManagedStringValueCount !=
           retained.managedStringValueCount ||
       releasedManagedStringBytes != retained.managedStringBytes:
        bodyIrLifecycleFail(
            "body ir lifecycle: sequence physical release incomplete")

    state.terminalOwnerToken = ownerToken
    state.terminalReleasedFunctionCount = functionCount
    state.terminalReleasedPayloadFunctionCount =
        releasedPayloadFunctionCount
    state.terminalReleasedBufferCount = retained.physicalBufferCount
    state.terminalReleasedBytes = retained.retainedBytes
    state.terminalReleasedManagedStringValueCount =
        retained.managedStringValueCount
    state.terminalReleasedManagedStringBytes =
        retained.managedStringBytes
    state.terminalStorageReleased = storageReleased

    receipt.ownerToken = ownerToken
    receipt.releasedFunctionCount = functionCount
    receipt.releasedPayloadFunctionCount =
        releasedPayloadFunctionCount
    receipt.releasedBufferCount = retained.physicalBufferCount
    receipt.releasedBytes = retained.retainedBytes
    receipt.releasedManagedStringValueCount =
        retained.managedStringValueCount
    receipt.releasedManagedStringBytes =
        retained.managedStringBytes
    receipt.storageReleased = storageReleased

fn BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
        bodyIRs: var coreir.BodyIR[],
        state: var BodyIrPayloadReleaseSequenceState,
        receipt: var BodyIrPayloadReleaseSequenceReceipt,
        err: var str): bool =
    err = ""
    if !state.terminalStorageReleased ||
       state.terminalReceiptConsumed ||
       !receipt.storageReleased ||
       !layout.FixedBytes32Equal(
           receipt.ownerToken, state.terminalOwnerToken) ||
       receipt.releasedFunctionCount !=
           state.terminalReleasedFunctionCount ||
       receipt.releasedPayloadFunctionCount !=
           state.terminalReleasedPayloadFunctionCount ||
       receipt.releasedBufferCount !=
           state.terminalReleasedBufferCount ||
       receipt.releasedBytes != state.terminalReleasedBytes ||
       receipt.releasedManagedStringValueCount !=
           state.terminalReleasedManagedStringValueCount ||
       receipt.releasedManagedStringBytes !=
           state.terminalReleasedManagedStringBytes ||
       !BodyIrPayloadReleaseSequenceStorageReleased(bodyIRs):
        err = "body ir lifecycle: sequence release receipt mismatch"
        return false
    state.terminalReceiptConsumed = true
    return true

fn BodyIrPayloadReleaseSequence(bodyIRs: var coreir.BodyIR[]): int32 =
    var state: BodyIrPayloadReleaseSequenceState
    var receipt: BodyIrPayloadReleaseSequenceReceipt
    BodyIrPayloadReleaseSequenceWithReceipt(bodyIRs, state, receipt)
    var err: str
    if !BodyIrPayloadReleaseSequenceReceiptConsumeStrictInto(
           bodyIRs, state, receipt, err):
        bodyIrLifecycleFail(err)
    return receipt.releasedPayloadFunctionCount

fn bodyIrFunctionLifecyclePhaseMetadataBegin(
        state: var BodyIrFunctionLifecycle,
        functionIrIndex: int32,
        functionIdentityKind: int32,
        functionIdentityIndex: int32,
        retained: BodyIrPayloadRetainedReport) =
    if retained.retainedBytes > int64(2147483647):
        bodyIrLifecycleFail(
            "body ir lifecycle: retained payload exceeds exact phase arena range")
    phase.PhaseArenaStoreInit(state.phaseArena, 1, 20, 1)
    state.phaseArenaHandle =
        phase.PhaseArenaStoreOpenArena(state.phaseArena, 1, 20, 1)
    state.phaseMetadataColumn =
        phase.PhaseArenaStoreReserveI32Column(
            state.phaseArena, state.phaseArenaHandle, 5)
    phase.PhaseArenaStoreI32ColumnSet(
        state.phaseArena,
        state.phaseArenaHandle,
        state.phaseMetadataColumn,
        0,
        functionIrIndex)
    phase.PhaseArenaStoreI32ColumnSet(
        state.phaseArena,
        state.phaseArenaHandle,
        state.phaseMetadataColumn,
        1,
        int32(retained.retainedBytes))
    phase.PhaseArenaStoreI32ColumnSet(
        state.phaseArena,
        state.phaseArenaHandle,
        state.phaseMetadataColumn,
        2,
        retained.physicalBufferCount)
    phase.PhaseArenaStoreI32ColumnSet(
        state.phaseArena,
        state.phaseArenaHandle,
        state.phaseMetadataColumn,
        3,
        functionIdentityKind)
    phase.PhaseArenaStoreI32ColumnSet(
        state.phaseArena,
        state.phaseArenaHandle,
        state.phaseMetadataColumn,
        4,
        functionIdentityIndex)

fn bodyIrFunctionLifecyclePhaseMetadataExact(
        state: var BodyIrFunctionLifecycle): bool =
    return phase.PhaseArenaStoreI32ColumnGet(
               state.phaseArena,
               state.phaseArenaHandle,
               state.phaseMetadataColumn,
               0) == state.functionIrIndex &&
           phase.PhaseArenaStoreI32ColumnGet(
               state.phaseArena,
               state.phaseArenaHandle,
               state.phaseMetadataColumn,
               1) == int32(state.retained.retainedBytes) &&
           phase.PhaseArenaStoreI32ColumnGet(
               state.phaseArena,
               state.phaseArenaHandle,
               state.phaseMetadataColumn,
               2) == state.retained.physicalBufferCount &&
           phase.PhaseArenaStoreI32ColumnGet(
               state.phaseArena,
               state.phaseArenaHandle,
               state.phaseMetadataColumn,
               3) == state.functionIdentityKind &&
           phase.PhaseArenaStoreI32ColumnGet(
               state.phaseArena,
               state.phaseArenaHandle,
               state.phaseMetadataColumn,
               4) == state.functionIdentityIndex

fn bodyIrFunctionLifecycleIdentityExact(
        functionIrIndex: int32,
        functionIdentityKind: int32,
        functionIdentityIndex: int32): bool =
    if functionIdentityKind == BodyIrFunctionIdentitySource:
        return functionIrIndex >= 0 &&
               functionIdentityIndex == functionIrIndex
    if functionIdentityKind ==
           BodyIrFunctionIdentitySyntheticEntryBridge:
        return functionIrIndex == -1 &&
               functionIdentityIndex ==
                   BodyIrSyntheticEntryBridgeIndex
    return false

fn bodyIrFunctionLifecycleBeginExact(
        state: var BodyIrFunctionLifecycle,
        bodyIR: var coreir.BodyIR,
        functionIrIndex: int32,
        functionIdentityKind: int32,
        functionIdentityIndex: int32) =
    if state.phase != BodyIrFunctionLifecyclePhaseEmpty ||
       !bodyIrFunctionLifecycleIdentityExact(
           functionIrIndex,
           functionIdentityKind,
           functionIdentityIndex):
        bodyIrLifecycleFail("body ir lifecycle: invalid begin identity")
    let retained = BodyIrPayloadRetained(bodyIR)
    if retained.retainedBytes <= int64(0) ||
       retained.physicalBufferCount <= 0:
        bodyIrLifecycleFail(
            "body ir lifecycle: begin requires physical BodyIR payload")
    bodyIrFunctionLifecyclePhaseMetadataBegin(
        state,
        functionIrIndex,
        functionIdentityKind,
        functionIdentityIndex,
        retained)
    lifetime.LifetimeLedgerInit(state.ledger)
    lifetime.LifetimeLedgerReserveExact(state.ledger, 1, 6, 1, 3)
    state.categoryId = lifetime.LifetimeLedgerRegisterCategory(
        state.ledger, "body_ir_payload")
    state.loweringOwnerId = lifetime.LifetimeLedgerRegisterOwner(
        state.ledger, "lowering")
    state.frozenFragmentOwnerId = lifetime.LifetimeLedgerRegisterOwner(
        state.ledger, "frozen_fragment")
    state.emitterOwnerId = lifetime.LifetimeLedgerRegisterOwner(
        state.ledger, "emitter")
    state.primaryPreRegallocOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "primary_pre_regalloc_reader")
    state.regallocConsumerOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "canonical_regalloc")
    state.primaryPostRegallocOwnerId =
        lifetime.LifetimeLedgerRegisterOwner(
            state.ledger, "primary_post_regalloc_reader")
    state.objectId = lifetime.LifetimeLedgerReserveObject(
        state.ledger, state.categoryId, retained.retainedBytes)
    lifetime.LifetimeLedgerOwn(
        state.ledger, state.objectId, state.loweringOwnerId)
    state.functionIrIndex = functionIrIndex
    state.functionIdentityKind = functionIdentityKind
    state.functionIdentityIndex = functionIdentityIndex
    state.retained = retained
    state.phase = BodyIrFunctionLifecyclePhaseLowered

fn BodyIrFunctionLifecycleBegin(
        state: var BodyIrFunctionLifecycle,
        bodyIR: var coreir.BodyIR,
        functionIrIndex: int32) =
    bodyIrFunctionLifecycleBeginExact(
        state,
        bodyIR,
        functionIrIndex,
        BodyIrFunctionIdentitySource,
        functionIrIndex)

fn BodyIrFunctionLifecycleBeginSyntheticEntryBridge(
        state: var BodyIrFunctionLifecycle,
        bodyIR: var coreir.BodyIR) =
    bodyIrFunctionLifecycleBeginExact(
        state,
        bodyIR,
        -1,
        BodyIrFunctionIdentitySyntheticEntryBridge,
        BodyIrSyntheticEntryBridgeIndex)

fn BodyIrFunctionLifecycleMoveToFrozenFragment(
        state: var BodyIrFunctionLifecycle) =
    if state.phase != BodyIrFunctionLifecyclePhaseLowered:
        bodyIrLifecycleFail(
            "body ir lifecycle: fragment handoff requires lowered owner")
    lifetime.LifetimeLedgerMove(state.ledger,
                                state.objectId,
                                state.loweringOwnerId,
                                state.frozenFragmentOwnerId)
    state.phase = BodyIrFunctionLifecyclePhaseFrozenFragment

fn BodyIrFunctionLifecycleMoveToEmitter(
        state: var BodyIrFunctionLifecycle) =
    if state.phase != BodyIrFunctionLifecyclePhaseLowered:
        bodyIrLifecycleFail(
            "body ir lifecycle: emitter handoff requires lowered owner")
    lifetime.LifetimeLedgerMove(state.ledger,
                                state.objectId,
                                state.loweringOwnerId,
                                state.emitterOwnerId)
    state.phase = BodyIrFunctionLifecyclePhaseEmitter

fn BodyIrFunctionLifecycleBorrowForPrimaryPreRegalloc(
        state: var BodyIrFunctionLifecycle) =
    if state.phase != BodyIrFunctionLifecyclePhaseEmitter ||
       state.primaryPreRegallocBorrowStarted ||
       state.primaryPreRegallocBorrowActive:
        bodyIrLifecycleFail(
            "body ir lifecycle: invalid primary pre-regalloc borrow")
    state.primaryPreRegallocBorrowId =
        lifetime.LifetimeLedgerBorrow(
            state.ledger,
            state.objectId,
            state.primaryPreRegallocOwnerId)
    let _ = lifetime.LifetimeLedgerRead(
        state.ledger,
        state.objectId,
        state.primaryPreRegallocOwnerId)
    state.primaryPreRegallocBorrowStarted = true
    state.primaryPreRegallocBorrowActive = true

fn BodyIrFunctionLifecycleReturnPrimaryPreRegallocBorrow(
        state: var BodyIrFunctionLifecycle) =
    if state.phase != BodyIrFunctionLifecyclePhaseEmitter ||
       !state.primaryPreRegallocBorrowStarted ||
       !state.primaryPreRegallocBorrowActive ||
       state.primaryPreRegallocBorrowId <= 0:
        bodyIrLifecycleFail(
            "body ir lifecycle: invalid primary pre-regalloc borrow return")
    lifetime.LifetimeLedgerReturnBorrow(
        state.ledger,
        state.objectId,
        state.primaryPreRegallocBorrowId,
        state.primaryPreRegallocOwnerId)
    state.primaryPreRegallocBorrowActive = false

fn BodyIrFunctionLifecycleBorrowForRegalloc(
        state: var BodyIrFunctionLifecycle) =
    if state.phase != BodyIrFunctionLifecyclePhaseEmitter ||
       state.regallocBorrowStarted ||
       state.regallocBorrowActive:
        bodyIrLifecycleFail(
            "body ir lifecycle: invalid canonical regalloc borrow")
    state.regallocBorrowId = lifetime.LifetimeLedgerBorrow(
        state.ledger,
        state.objectId,
        state.regallocConsumerOwnerId)
    let _ = lifetime.LifetimeLedgerRead(
        state.ledger,
        state.objectId,
        state.regallocConsumerOwnerId)
    state.regallocBorrowStarted = true
    state.regallocBorrowActive = true

fn BodyIrFunctionLifecycleReturnRegallocBorrow(
        state: var BodyIrFunctionLifecycle) =
    if state.phase != BodyIrFunctionLifecyclePhaseEmitter ||
       !state.regallocBorrowStarted ||
       !state.regallocBorrowActive ||
       state.regallocBorrowId <= 0:
        bodyIrLifecycleFail(
            "body ir lifecycle: invalid canonical regalloc borrow return")
    lifetime.LifetimeLedgerReturnBorrow(
        state.ledger,
        state.objectId,
        state.regallocBorrowId,
        state.regallocConsumerOwnerId)
    state.regallocBorrowActive = false

fn BodyIrFunctionLifecycleBorrowForPrimaryPostRegalloc(
        state: var BodyIrFunctionLifecycle) =
    if state.phase != BodyIrFunctionLifecyclePhaseEmitter ||
       state.primaryPostRegallocBorrowStarted ||
       state.primaryPostRegallocBorrowActive:
        bodyIrLifecycleFail(
            "body ir lifecycle: invalid primary post-regalloc borrow")
    state.primaryPostRegallocBorrowId =
        lifetime.LifetimeLedgerBorrow(
            state.ledger,
            state.objectId,
            state.primaryPostRegallocOwnerId)
    let _ = lifetime.LifetimeLedgerRead(
        state.ledger,
        state.objectId,
        state.primaryPostRegallocOwnerId)
    state.primaryPostRegallocBorrowStarted = true
    state.primaryPostRegallocBorrowActive = true

fn BodyIrFunctionLifecycleReturnPrimaryPostRegallocBorrow(
        state: var BodyIrFunctionLifecycle) =
    if state.phase != BodyIrFunctionLifecyclePhaseEmitter ||
       !state.primaryPostRegallocBorrowStarted ||
       !state.primaryPostRegallocBorrowActive ||
       state.primaryPostRegallocBorrowId <= 0:
        bodyIrLifecycleFail(
            "body ir lifecycle: invalid primary post-regalloc borrow return")
    lifetime.LifetimeLedgerReturnBorrow(
        state.ledger,
        state.objectId,
        state.primaryPostRegallocBorrowId,
        state.primaryPostRegallocOwnerId)
    state.primaryPostRegallocBorrowActive = false

fn bodyIrFunctionOutcomeValidForPhase(outcome: int32,
                                      phase: int32): bool =
    if phase == BodyIrFunctionLifecyclePhaseLowered:
        return outcome == BodyIrFunctionOutcomeDiagnostic ||
               outcome == BodyIrFunctionOutcomeEarlyReturn
    if phase == BodyIrFunctionLifecyclePhaseFrozenFragment:
        return outcome == BodyIrFunctionOutcomeFragmentFrozen ||
               outcome == BodyIrFunctionOutcomeCacheReuse
    if phase == BodyIrFunctionLifecyclePhaseEmitter:
        return outcome == BodyIrFunctionOutcomeEmitSuccess ||
               outcome == BodyIrFunctionOutcomeEmitFailure
    return false

fn BodyIrFunctionLifecycleRelease(
        state: var BodyIrFunctionLifecycle,
        bodyIR: var coreir.BodyIR,
        outcome: int32,
        receipt: var BodyIrFunctionLifecycleReceipt) =
    if !bodyIrFunctionOutcomeValidForPhase(outcome, state.phase):
        bodyIrLifecycleFail("body ir lifecycle: outcome/phase mismatch")
    if state.primaryPreRegallocBorrowActive ||
       state.regallocBorrowActive ||
       state.primaryPostRegallocBorrowActive:
        bodyIrLifecycleFail(
            "body ir lifecycle: release while consumer borrowed")
    let retainedNow = BodyIrPayloadRetained(bodyIR)
    if retainedNow.retainedBytes != state.retained.retainedBytes ||
       retainedNow.physicalBufferCount !=
           state.retained.physicalBufferCount ||
       !bodyIrFunctionLifecyclePhaseMetadataExact(state):
        bodyIrLifecycleFail(
            "body ir lifecycle: payload identity changed before release")

    let releasedPayload = BodyIrPayloadRelease(bodyIR)
    if releasedPayload.releasedBufferCount !=
           state.retained.physicalBufferCount ||
       releasedPayload.releasedBytes != state.retained.retainedBytes ||
       releasedPayload.releasedManagedStringValueCount !=
           state.retained.managedStringValueCount ||
       releasedPayload.releasedManagedStringBytes !=
           state.retained.managedStringBytes ||
       !releasedPayload.storageReleased:
        bodyIrLifecycleFail(
            "body ir lifecycle: payload-local physical release receipt incomplete")

    var releasingOwnerId = state.loweringOwnerId
    if state.phase == BodyIrFunctionLifecyclePhaseFrozenFragment:
        releasingOwnerId = state.frozenFragmentOwnerId
    elif state.phase == BodyIrFunctionLifecyclePhaseEmitter:
        releasingOwnerId = state.emitterOwnerId
    lifetime.LifetimeLedgerRelease(
        state.ledger, state.objectId, releasingOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.loweringOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.frozenFragmentOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.emitterOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.primaryPreRegallocOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.regallocConsumerOwnerId)
    lifetime.LifetimeLedgerAssertOwnerClosed(
        state.ledger, state.primaryPostRegallocOwnerId)
    lifetime.LifetimeLedgerAssertClosed(state.ledger)
    var metrics: lifetime.LifetimeLedgerMetrics
    lifetime.LifetimeLedgerReadTotalMetrics(state.ledger, metrics)

    receipt.functionIrIndex = state.functionIrIndex
    receipt.functionIdentityKind = state.functionIdentityKind
    receipt.functionIdentityIndex = state.functionIdentityIndex
    receipt.outcome = outcome
    receipt.allocated = metrics.allocated
    receipt.released = metrics.released
    receipt.live = metrics.live
    receipt.allocatedBytes = metrics.allocatedBytes
    receipt.releasedBytes = metrics.releasedBytes
    receipt.liveBytes = metrics.liveBytes
    receipt.retained = metrics.retained
    receipt.borrowReturnCount = metrics.borrowReturnCount
    receipt.ownerTransferCount = metrics.ownerTransferCount
    receipt.retainedBytes = state.retained.retainedBytes
    receipt.physicalBufferCount = state.retained.physicalBufferCount
    receipt.bodyPhysicalFreeCount =
        int64(releasedPayload.releasedBufferCount)
    receipt.payloadReleased = BodyIrPayloadIsReleased(bodyIR)

    let ledgerStorageRelease =
        lifetime.LifetimeLedgerReleaseStorage(state.ledger)
    receipt.ledgerStorageReleased = ledgerStorageRelease.storageReleased
    receipt.ledgerStorageReleasedSequenceCount =
        ledgerStorageRelease.releasedSequenceCount
    receipt.ledgerStorageReleasedBufferCount =
        ledgerStorageRelease.releasedSequenceBufferCount
    receipt.ledgerStorageReleasedBytes =
        ledgerStorageRelease.releasedSequenceCapacityBytes
    phase.PhaseArenaStoreCloseArena(
        state.phaseArena, state.phaseArenaHandle)
    let phaseArenaRelease =
        phase.PhaseArenaStoreDestroyWithReceipt(state.phaseArena)
    receipt.phaseArenaStorageReleased =
        phaseArenaRelease.storageReleased
    receipt.phaseArenaReleasedBufferCount =
        phaseArenaRelease.releasedBufferCount
    receipt.phaseArenaReleasedBytes =
        phaseArenaRelease.releasedBytes
    if metrics.allocated != int64(1) ||
       metrics.released != int64(1) ||
       metrics.live != int64(0) ||
       metrics.allocatedBytes != metrics.releasedBytes ||
       metrics.liveBytes != int64(0) ||
       metrics.retained != metrics.borrowReturnCount ||
       metrics.retained !=
           (state.primaryPreRegallocBorrowStarted ? int64(1) : int64(0)) +
           (state.regallocBorrowStarted ? int64(1) : int64(0)) +
           (state.primaryPostRegallocBorrowStarted ? int64(1) : int64(0)) ||
       !receipt.payloadReleased ||
       !receipt.ledgerStorageReleased ||
       receipt.ledgerStorageReleasedSequenceCount != 6 ||
       receipt.ledgerStorageReleasedBufferCount <= 0 ||
       receipt.ledgerStorageReleasedBytes <= int64(0) ||
       !receipt.phaseArenaStorageReleased ||
       receipt.phaseArenaReleasedBufferCount <= 0 ||
       receipt.phaseArenaReleasedBytes <= int64(0):
        bodyIrLifecycleFail("body ir lifecycle: terminal receipt unbalanced")
    state.phase = BodyIrFunctionLifecyclePhaseReleased
