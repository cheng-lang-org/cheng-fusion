    bodyIrPayloadRecordSequence(
        report, sidecar.callBodyOpRows.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.semanticCapabilityCallRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.resolvedCallRows.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.snapshotCallIds.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.semanticContractRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.snapshotContractRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.semanticEffectStarts.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.effectStarts.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.effectCounts.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.callCapabilityCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.contractCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.interfaceCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.callBridgeCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.semanticCapabilityEffectRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.contractEffectRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.snapshotEffectRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.snapshotEffectContractRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.effectKinds.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.targetKinds.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.parameterOrdinals.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.argumentRows.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.argumentSlotIds.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.argumentValueNodeIndexes.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.valueDefinitionRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.generationRootValueDefinitionRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.exactTypeIds.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.carrierKinds.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.argumentBindingCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.typeCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.generationCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.definitionLineageCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.effectCapabilityCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.contractEffectCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        report, sidecar.effectBridgeCids.cap,
        int64(sizeof(layout.FixedBytes32)))

fn BodyIrPayloadRetained(bodyIR: var coreir.BodyIR):
        BodyIrPayloadRetainedReport =
    var out: BodyIrPayloadRetainedReport
    bodyIrPayloadRecordSequence(out, bodyIR.ops.cap,
                                int64(sizeof(coreir.BodyOp)))
    for opIndex in 0..<bodyIR.ops.len:
        bodyIrPayloadRecordSequence(out, bodyIR.ops[opIndex].operands.cap,
                                    int64(sizeof(int32)))

    bodyIrPayloadRecordSequence(out, bodyIR.callSequence.cap,
                                int64(sizeof(coreir.CallOp)))
    for callIndex in 0..<bodyIR.callSequence.len:
        let call = bodyIR.callSequence[callIndex]
        bodyIrPayloadRecordString(out, call.targetSymbol)
        bodyIrPayloadRecordString(out, call.targetSourcePath)
        bodyIrPayloadRecordSequence(out, call.argSlots.cap,
                                    int64(sizeof(int32)))
        bodyIrPayloadRecordSequence(out, call.argPassKinds.cap,
                                    int64(sizeof(int32)))
        bodyIrPayloadRecordSequence(out, call.argAbiSizes.cap,
                                    int64(sizeof(int32)))

    bodyIrPayloadRecordSequence(out, bodyIR.localSlots.cap,
                                int64(sizeof(coreir.LocalSlot)))
    for slotIndex in 0..<bodyIR.localSlots.len:
        bodyIrPayloadRecordString(out, bodyIR.localSlots[slotIndex].name)
    bodyIrPayloadRecordSequence(
        out, bodyIR.entryDefinitionOwnershipKinds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.entryDefinitionSemanticRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.entryParameterSlotIds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.localBindingValueDefinitionRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.localAddressTargetDomainKinds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.localAddressTargetRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.localAddressTargetCids.cap,
        int64(sizeof(layout.FixedBytes32)))

    bodyIrPayloadRecordSequence(out, bodyIR.typeFactTypeIds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.typeFactStructuralKinds.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.typeFactScalarKinds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.typeFactChildTypeIds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.typeFactFixedLengths.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.typeFactSizeBytes.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.typeFactAlignBytes.cap,
                                int64(sizeof(int32)))

    bodyIrPayloadRecordSequence(out, bodyIR.slotNameIndex.keys.cap,
                                int64(sizeof(str)))
    bodyIrPayloadRecordSequence(out, bodyIR.slotNameIndex.vals.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.slotNameIndex.hashes.cap,
                                int64(sizeof(uint64)))
    bodyIrPayloadRecordSequence(out, bodyIR.slotNameIndex.states.cap,
                                int64(sizeof(uint8)))
    for keyIndex in 0..<bodyIR.slotNameIndex.keys.len:
        bodyIrPayloadRecordString(out, bodyIR.slotNameIndex.keys[keyIndex])

    bodyIrPayloadRecordSequence(out, bodyIR.blocks.cap,
                                int64(sizeof(coreir.BodyBlock)))
    bodyIrPayloadRecordSequence(out, bodyIR.terms.cap,
                                int64(sizeof(coreir.BodyTerm)))
    for termIndex in 0..<bodyIR.terms.len:
        bodyIrPayloadRecordSequence(out,
                                    bodyIR.terms[termIndex].operands.cap,
                                    int64(sizeof(int32)))

    bodyIrPayloadRecordSequence(out, bodyIR.cstringLiterals.cap,
                                int64(sizeof(coreir.CStringLiteralEntry)))
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        bodyIrPayloadRecordString(
            out, bodyIR.cstringLiterals[literalIndex].text)
        bodyIrPayloadRecordString(
            out, bodyIR.cstringLiterals[literalIndex].dataLabel)
    bodyIrPayloadRecordSequence(
        out, bodyIR.cstringTargetRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.cstringOwnerFunctionFragmentCids.cap,
        int64(sizeof(layout.FixedBytes32)))

    bodyIrPayloadRecordSequence(out, bodyIR.controlScopeParentIds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.blockScopeIds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.termSuccessorStarts.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.termSuccessorCounts.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.successorBlockIds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.successorEdgeKinds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.callTargetDomainKinds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.callTargetRows.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.callTargetInterfaceCids.cap,
                                int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferDeclarationScopeIds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferSuiteScopeIds.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferLexicalOrdinals.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferFunctionRows.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferStatementRows.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferActionCids.cap,
                                int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.deferActivationSiteBlockIds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.deferActivationSiteAfterOpOrdinals.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferActivationSiteStarts.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferActivationSiteCounts.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.deferActivationRows.cap,
                                int64(sizeof(int32)))

    bodyIrPayloadRecordCleanupIntentSidecar(
        out, bodyIR.cleanupIntent)
    bodyIrPayloadRecordCleanupScheduleSidecar(
        out, bodyIR.cleanupSchedule)
    bodyIrPayloadRecordDeferReplaySidecar(
        out, bodyIR.deferReplay)
    bodyIrPayloadRecordManagedLvalueReplaceSidecar(
        out, bodyIR.managedLvalueReplace)

    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.callOrdinals.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.snapshotCallIds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.targetArgumentOrdinals.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.sourceArgumentOrdinals.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.targetPlaceSlotIds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.targetOwnerSlotIds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.sourcePlaceSlotIds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.targetArgumentBindingCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.sourceArgumentBindingCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.targetProjectionCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.sourceProjectionCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.targetDefinitionDomains.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.targetDefinitionRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.sourceDefinitionDomains.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.sourceDefinitionRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.targetTypeArenaTypeIds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.sourceTypeArenaTypeIds.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.postDefinitionDomains.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.postDefinitionRows.cap,
        int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.effectCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.linearTokenCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.manualConsume.bridgeCids.cap,
        int64(sizeof(layout.FixedBytes32)))
    bodyIrPayloadRecordExternFfiHandleCapabilities(
        out, bodyIR.externFfiHandleCapabilities)

    bodyIrPayloadRecordSequence(out, bodyIR.debugOpIdsByOpIndex.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.debugSyntheticKindsByOpIndex.cap, int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.debugOpIdsByTermIndex.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(
        out, bodyIR.debugSyntheticKindsByTermIndex.cap, int64(sizeof(int32)))

    bodyIrPayloadRecordSequence(out, bodyIR.layoutLhsElide.cap,
                                int64(sizeof(bool)))
    bodyIrPayloadRecordSequence(out, bodyIR.layoutStoreElide.cap,
                                int64(sizeof(bool)))
    bodyIrPayloadRecordSequence(out, bodyIR.layoutCopySrcElide.cap,
                                int64(sizeof(bool)))
    bodyIrPayloadRecordSequence(out, bodyIR.layoutCmpFuse.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.layoutCbrFuse.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.x64SlotReadCnt.cap,
                                int64(sizeof(int32)))
    bodyIrPayloadRecordSequence(out, bodyIR.x64BlockByteStart.cap,
                                int64(sizeof(int32)))
    return out

@borrows
fn bodyIrPayloadManagedLvalueReplaceSidecarIsReleased(
        sidecar: coreir.BodyIRManagedLvalueReplaceSidecar): bool =
    var retained: BodyIrPayloadRetainedReport
    bodyIrPayloadRecordManagedLvalueReplaceSidecar(retained, sidecar)
    return coreir.BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
               sidecar) &&
           retained.retainedBytes == int64(0) &&
           retained.physicalBufferCount == 0 &&
           retained.managedStringValueCount == 0 &&
           retained.managedStringBytes == int64(0)

fn BodyIrPayloadHasPhysicalStorage(bodyIR: var coreir.BodyIR): bool =
    return BodyIrPayloadRetained(bodyIR).physicalBufferCount > 0

fn BodyIrPayloadIsReleased(bodyIR: var coreir.BodyIR): bool =
    return !coreir.BodyIRTypeArenaArtifactCidValid(
               bodyIR.cleanupSourceProjectionCid) &&
           bodyIR.ops.len == 0 && bodyIR.ops.cap == 0 &&
           bodyIR.callSequence.len == 0 &&
           bodyIR.callSequence.cap == 0 &&
           bodyIR.localSlots.len == 0 && bodyIR.localSlots.cap == 0 &&
           !bodyIR.entryDefinitionOwnershipSealed &&
           bodyIR.entryDefinitionOwnershipKinds.len == 0 &&
           bodyIR.entryDefinitionOwnershipKinds.cap == 0 &&
           bodyIR.entryDefinitionSemanticRows.len == 0 &&
           bodyIR.entryDefinitionSemanticRows.cap == 0 &&
           bodyIR.entryParameterSlotIds.len == 0 &&
           bodyIR.entryParameterSlotIds.cap == 0 &&
           bodyIR.localBindingValueDefinitionDomainStart == 0 &&
           bodyIR.localBindingValueDefinitionDomainCount == 0 &&
           bodyIR.localBindingValueDefinitionRows.len == 0 &&
           bodyIR.localBindingValueDefinitionRows.cap == 0 &&
           !bodyIR.dataRelocationIdentitySealed &&
           bodyIR.localAddressTargetDomainKinds.len == 0 &&
           bodyIR.localAddressTargetDomainKinds.cap == 0 &&
           bodyIR.localAddressTargetRows.len == 0 &&
           bodyIR.localAddressTargetRows.cap == 0 &&
           bodyIR.localAddressTargetCids.len == 0 &&
           bodyIR.localAddressTargetCids.cap == 0 &&
           bodyIR.cstringTargetRows.len == 0 &&
           bodyIR.cstringTargetRows.cap == 0 &&
           bodyIR.cstringOwnerFunctionFragmentCids.len == 0 &&
           bodyIR.cstringOwnerFunctionFragmentCids.cap == 0 &&
           bodyIR.typeFactTypeIds.len == 0 &&
           bodyIR.typeFactTypeIds.cap == 0 &&
           bodyIR.typeFactStructuralKinds.len == 0 &&
           bodyIR.typeFactStructuralKinds.cap == 0 &&
           bodyIR.typeFactScalarKinds.len == 0 &&
           bodyIR.typeFactScalarKinds.cap == 0 &&
           bodyIR.typeFactChildTypeIds.len == 0 &&
           bodyIR.typeFactChildTypeIds.cap == 0 &&
           bodyIR.typeFactFixedLengths.len == 0 &&
           bodyIR.typeFactFixedLengths.cap == 0 &&
           bodyIR.typeFactSizeBytes.len == 0 &&
           bodyIR.typeFactSizeBytes.cap == 0 &&
           bodyIR.typeFactAlignBytes.len == 0 &&
           bodyIR.typeFactAlignBytes.cap == 0 &&
           bodyIR.slotNameIndex.keys.len == 0 &&
           bodyIR.slotNameIndex.keys.cap == 0 &&
           bodyIR.slotNameIndex.vals.len == 0 &&
           bodyIR.slotNameIndex.vals.cap == 0 &&
           bodyIR.slotNameIndex.hashes.len == 0 &&
           bodyIR.slotNameIndex.hashes.cap == 0 &&
           bodyIR.slotNameIndex.states.len == 0 &&
           bodyIR.slotNameIndex.states.cap == 0 &&
           bodyIR.blocks.len == 0 && bodyIR.blocks.cap == 0 &&
           bodyIR.terms.len == 0 && bodyIR.terms.cap == 0 &&
           bodyIR.cstringLiterals.len == 0 &&
           bodyIR.cstringLiterals.cap == 0 &&
           bodyIR.controlScopeParentIds.len == 0 &&
           bodyIR.controlScopeParentIds.cap == 0 &&
           bodyIR.blockScopeIds.len == 0 &&
           bodyIR.blockScopeIds.cap == 0 &&
           bodyIR.termSuccessorStarts.len == 0 &&
           bodyIR.termSuccessorStarts.cap == 0 &&
           bodyIR.termSuccessorCounts.len == 0 &&
           bodyIR.termSuccessorCounts.cap == 0 &&
           bodyIR.successorBlockIds.len == 0 &&
           bodyIR.successorBlockIds.cap == 0 &&
           bodyIR.successorEdgeKinds.len == 0 &&
           bodyIR.successorEdgeKinds.cap == 0 &&
           bodyIR.callTargetDomainKinds.len == 0 &&
           bodyIR.callTargetDomainKinds.cap == 0 &&
           bodyIR.callTargetRows.len == 0 &&
           bodyIR.callTargetRows.cap == 0 &&
           bodyIR.callTargetInterfaceCids.len == 0 &&
           bodyIR.callTargetInterfaceCids.cap == 0 &&
           bodyIR.deferDeclarationScopeIds.len == 0 &&
           bodyIR.deferDeclarationScopeIds.cap == 0 &&
           bodyIR.deferSuiteScopeIds.len == 0 &&
           bodyIR.deferSuiteScopeIds.cap == 0 &&
           bodyIR.deferLexicalOrdinals.len == 0 &&
           bodyIR.deferLexicalOrdinals.cap == 0 &&
           bodyIR.deferFunctionRows.len == 0 &&
           bodyIR.deferFunctionRows.cap == 0 &&
           bodyIR.deferStatementRows.len == 0 &&
           bodyIR.deferStatementRows.cap == 0 &&
           bodyIR.deferActionCids.len == 0 &&
           bodyIR.deferActionCids.cap == 0 &&
           bodyIR.deferActivationSiteBlockIds.len == 0 &&
           bodyIR.deferActivationSiteBlockIds.cap == 0 &&
           bodyIR.deferActivationSiteAfterOpOrdinals.len == 0 &&
           bodyIR.deferActivationSiteAfterOpOrdinals.cap == 0 &&
           bodyIR.deferActivationSiteStarts.len == 0 &&
           bodyIR.deferActivationSiteStarts.cap == 0 &&
           bodyIR.deferActivationSiteCounts.len == 0 &&
           bodyIR.deferActivationSiteCounts.cap == 0 &&
           bodyIR.deferActivationRows.len == 0 &&
           bodyIR.deferActivationRows.cap == 0 &&
           coreir.BodyIRCleanupIntentSidecarIsCanonicalEmpty(
               bodyIR.cleanupIntent) &&
           coreir.BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
               bodyIR.cleanupSchedule) &&
           coreir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
               bodyIR.deferReplay) &&
           bodyIrPayloadManagedLvalueReplaceSidecarIsReleased(
               bodyIR.managedLvalueReplace) &&
           bodyIR.manualConsume.callOrdinals.len == 0 &&
           bodyIR.manualConsume.callOrdinals.cap == 0 &&
           bodyIR.manualConsume.snapshotCallIds.len == 0 &&
           bodyIR.manualConsume.snapshotCallIds.cap == 0 &&
           bodyIR.manualConsume.targetArgumentOrdinals.len == 0 &&
           bodyIR.manualConsume.targetArgumentOrdinals.cap == 0 &&
           bodyIR.manualConsume.sourceArgumentOrdinals.len == 0 &&
           bodyIR.manualConsume.sourceArgumentOrdinals.cap == 0 &&
           bodyIR.manualConsume.targetPlaceSlotIds.len == 0 &&
           bodyIR.manualConsume.targetPlaceSlotIds.cap == 0 &&
           bodyIR.manualConsume.targetOwnerSlotIds.len == 0 &&
           bodyIR.manualConsume.targetOwnerSlotIds.cap == 0 &&
           bodyIR.manualConsume.sourcePlaceSlotIds.len == 0 &&
           bodyIR.manualConsume.sourcePlaceSlotIds.cap == 0 &&
           bodyIR.manualConsume.targetArgumentBindingCids.len == 0 &&
           bodyIR.manualConsume.targetArgumentBindingCids.cap == 0 &&
           bodyIR.manualConsume.sourceArgumentBindingCids.len == 0 &&
           bodyIR.manualConsume.sourceArgumentBindingCids.cap == 0 &&
           bodyIR.manualConsume.targetProjectionCids.len == 0 &&
           bodyIR.manualConsume.targetProjectionCids.cap == 0 &&
           bodyIR.manualConsume.sourceProjectionCids.len == 0 &&
           bodyIR.manualConsume.sourceProjectionCids.cap == 0 &&
           bodyIR.manualConsume.targetDefinitionDomains.len == 0 &&
           bodyIR.manualConsume.targetDefinitionDomains.cap == 0 &&
           bodyIR.manualConsume.targetDefinitionRows.len == 0 &&
           bodyIR.manualConsume.targetDefinitionRows.cap == 0 &&
           bodyIR.manualConsume.sourceDefinitionDomains.len == 0 &&
           bodyIR.manualConsume.sourceDefinitionDomains.cap == 0 &&
           bodyIR.manualConsume.sourceDefinitionRows.len == 0 &&
           bodyIR.manualConsume.sourceDefinitionRows.cap == 0 &&
           bodyIR.manualConsume.targetTypeArenaTypeIds.len == 0 &&
           bodyIR.manualConsume.targetTypeArenaTypeIds.cap == 0 &&
           bodyIR.manualConsume.sourceTypeArenaTypeIds.len == 0 &&
           bodyIR.manualConsume.sourceTypeArenaTypeIds.cap == 0 &&
           bodyIR.manualConsume.postDefinitionDomains.len == 0 &&
           bodyIR.manualConsume.postDefinitionDomains.cap == 0 &&
           bodyIR.manualConsume.postDefinitionRows.len == 0 &&
           bodyIR.manualConsume.postDefinitionRows.cap == 0 &&
           bodyIR.manualConsume.effectCids.len == 0 &&
           bodyIR.manualConsume.effectCids.cap == 0 &&
           bodyIR.manualConsume.linearTokenCids.len == 0 &&
           bodyIR.manualConsume.linearTokenCids.cap == 0 &&
           bodyIR.manualConsume.bridgeCids.len == 0 &&
           bodyIR.manualConsume.bridgeCids.cap == 0 &&
           coreir.BodyIRExternFfiHandleCapabilitySidecarIsCanonicalEmpty(
               bodyIR.externFfiHandleCapabilities) &&
           bodyIR.debugOpIdsByOpIndex.len == 0 &&
           bodyIR.debugOpIdsByOpIndex.cap == 0 &&
           bodyIR.debugSyntheticKindsByOpIndex.len == 0 &&
           bodyIR.debugSyntheticKindsByOpIndex.cap == 0 &&
           bodyIR.debugOpIdsByTermIndex.len == 0 &&
           bodyIR.debugOpIdsByTermIndex.cap == 0 &&
           bodyIR.debugSyntheticKindsByTermIndex.len == 0 &&
           bodyIR.debugSyntheticKindsByTermIndex.cap == 0 &&
           bodyIR.layoutLhsElide.len == 0 &&
           bodyIR.layoutLhsElide.cap == 0 &&
           bodyIR.layoutStoreElide.len == 0 &&
           bodyIR.layoutStoreElide.cap == 0 &&
           bodyIR.layoutCopySrcElide.len == 0 &&
           bodyIR.layoutCopySrcElide.cap == 0 &&
           bodyIR.layoutCmpFuse.len == 0 &&
           bodyIR.layoutCmpFuse.cap == 0 &&
           bodyIR.layoutCbrFuse.len == 0 &&
           bodyIR.layoutCbrFuse.cap == 0 &&
           bodyIR.x64SlotReadCnt.len == 0 &&
           bodyIR.x64SlotReadCnt.cap == 0 &&
           bodyIR.x64BlockByteStart.len == 0 &&
           bodyIR.x64BlockByteStart.cap == 0

fn bodyIrPayloadReleaseExternFfiHandleCapabilities(
        sidecar: var coreir.BodyIRExternFfiHandleCapabilitySidecar) =
    freeSeq(sidecar.callOrdinals)
    freeSeq(sidecar.callBodyOpRows)
    freeSeq(sidecar.semanticCapabilityCallRows)
    freeSeq(sidecar.resolvedCallRows)
    freeSeq(sidecar.snapshotCallIds)
    freeSeq(sidecar.semanticContractRows)
    freeSeq(sidecar.snapshotContractRows)
    freeSeq(sidecar.semanticEffectStarts)
    freeSeq(sidecar.effectStarts)
    freeSeq(sidecar.effectCounts)
    freeSeq(sidecar.callCapabilityCids)
    freeSeq(sidecar.contractCids)
    freeSeq(sidecar.interfaceCids)
    freeSeq(sidecar.callBridgeCids)
    freeSeq(sidecar.semanticCapabilityEffectRows)
    freeSeq(sidecar.contractEffectRows)
    freeSeq(sidecar.snapshotEffectRows)
    freeSeq(sidecar.snapshotEffectContractRows)
    freeSeq(sidecar.effectKinds)
    freeSeq(sidecar.targetKinds)
    freeSeq(sidecar.parameterOrdinals)
    freeSeq(sidecar.argumentRows)
    freeSeq(sidecar.argumentSlotIds)
    freeSeq(sidecar.argumentValueNodeIndexes)
    freeSeq(sidecar.valueDefinitionRows)
    freeSeq(sidecar.generationRootValueDefinitionRows)
    freeSeq(sidecar.exactTypeIds)
    freeSeq(sidecar.carrierKinds)
    freeSeq(sidecar.argumentBindingCids)
    freeSeq(sidecar.typeCids)
    freeSeq(sidecar.generationCids)
    freeSeq(sidecar.definitionLineageCids)
    freeSeq(sidecar.effectCapabilityCids)
    freeSeq(sidecar.contractEffectCids)
    freeSeq(sidecar.effectBridgeCids)
    sidecar = coreir.BodyIRExternFfiHandleCapabilitySidecarNew()

fn bodyIrPayloadReleaseCleanupIntentSidecar(
        sidecar: var coreir.BodyIRCleanupIntentSidecar) =
    freeSeq(sidecar.sourceBlockIds)
    freeSeq(sidecar.sourceTermRows)
    freeSeq(sidecar.sourceTermCids)
    freeSeq(sidecar.sourceSuccessorOrdinals)
    freeSeq(sidecar.originalSuccessorCounts)
    freeSeq(sidecar.sourceExitKinds)
    freeSeq(sidecar.originalTargetBlockIds)
    freeSeq(sidecar.originalEdgeKinds)
    freeSeq(sidecar.sourceScopeIds)
    freeSeq(sidecar.targetScopeIds)
    freeSeq(sidecar.exitOwnershipEdgeIds)
    freeSeq(sidecar.selectedDeferStarts)
    freeSeq(sidecar.selectedDeferCounts)
    freeSeq(sidecar.exitUnitStarts)
    freeSeq(sidecar.exitUnitCounts)
    freeSeq(sidecar.siteOriginalBlockIds)
    freeSeq(sidecar.siteAfterOpOrdinals)
    freeSeq(sidecar.siteOwnershipOpStarts)
    freeSeq(sidecar.siteOwnershipOpCounts)
    freeSeq(sidecar.siteUnitStarts)
    freeSeq(sidecar.siteUnitCounts)
    freeSeq(sidecar.ownershipOpRows)
    freeSeq(sidecar.selectedDeferIds)
    freeSeq(sidecar.unitKinds)
    freeSeq(sidecar.unitSemanticDomains)
    freeSeq(sidecar.unitSemanticStarts)
    freeSeq(sidecar.unitSemanticCounts)
    freeSeq(sidecar.unitSnapshotSourceSlotStarts)
    freeSeq(sidecar.unitSnapshotSourceSlotCounts)
    freeSeq(sidecar.unitConditionStarts)
    freeSeq(sidecar.unitConditionCounts)
    freeSeq(sidecar.unitClearStarts)
    freeSeq(sidecar.unitClearCounts)
    freeSeq(sidecar.unitAuthorityCids)
    freeSeq(sidecar.snapshotSourceSlotIds)
    freeSeq(sidecar.snapshotProjectionPolicies)
    freeSeq(sidecar.snapshotSemanticRows)
    freeSeq(sidecar.snapshotTypeArenaTypeIds)
    freeSeq(sidecar.snapshotInterfaceCids)
    freeSeq(sidecar.conditionKinds)
    freeSeq(sidecar.conditionInputSourceSlotIds)
    freeSeq(sidecar.conditionSemanticRows)
    freeSeq(sidecar.conditionSemanticOrdinals)
    freeSeq(sidecar.clearKinds)
    freeSeq(sidecar.clearTargetSourceSlotIds)
    freeSeq(sidecar.clearSemanticRows)
    freeSeq(sidecar.clearSemanticOrdinals)
    sidecar = coreir.BodyIRCleanupIntentSidecarNew()

fn bodyIrPayloadReleaseCleanupScheduleSidecar(
        sidecar: var coreir.BodyIRCleanupScheduleSidecar) =
    freeSeq(sidecar.ownerPhysicalSourceBlockIds)
    freeSeq(sidecar.ownerSourceTermRows)
    freeSeq(sidecar.ownerSourceSuccessorOrdinals)
    freeSeq(sidecar.ownerFinalContinuationBlockIds)
    freeSeq(sidecar.ownerFinalEdgeKinds)
    freeSeq(sidecar.ownerContinuationCids)
    freeSeq(sidecar.opStarts)
    freeSeq(sidecar.opCounts)
    freeSeq(sidecar.callStarts)
    freeSeq(sidecar.callCounts)
    freeSeq(sidecar.blockStarts)
    freeSeq(sidecar.blockCounts)
    freeSeq(sidecar.termStarts)
    freeSeq(sidecar.termCounts)
    freeSeq(sidecar.unitLocalStarts)
    freeSeq(sidecar.unitLocalCounts)
    freeSeq(sidecar.unitProjectedSnapshotSlotStarts)
    freeSeq(sidecar.unitProjectedSnapshotSlotCounts)
    freeSeq(sidecar.unitEffectStarts)
    freeSeq(sidecar.unitEffectCounts)
    freeSeq(sidecar.effectSemanticRows)
    freeSeq(sidecar.effectPhysicalDomains)
    freeSeq(sidecar.effectPhysicalRows)
    freeSeq(sidecar.effectRoles)
    freeSeq(sidecar.payloadCids)
    freeSeq(sidecar.placementCids)
    freeSeq(sidecar.projectedSnapshotSlotIds)
    sidecar = coreir.BodyIRCleanupScheduleSidecarNew()

fn bodyIrPayloadReleaseDeferReplaySidecar(
        sidecar: var coreir.BodyIRDeferReplaySidecar) =
    freeSeq(sidecar.templateOpMapStarts)
    freeSeq(sidecar.templateOpMapCounts)
    freeSeq(sidecar.templateOpRows)
    sidecar = coreir.BodyIRDeferReplaySidecarNew()

fn bodyIrPayloadReleaseManagedLvalueReplaceSidecar(
        sidecar: var coreir.BodyIRManagedLvalueReplaceSidecar) =
    freeSeq(sidecar.callOrdinals)
    freeSeq(sidecar.replaceOpRows)
    freeSeq(sidecar.targetKinds)
    freeSeq(sidecar.replaceModes)
    freeSeq(sidecar.targetLvalueNodeIndexes)
    freeSeq(sidecar.sourceValueNodeIndexes)
    freeSeq(sidecar.targetRootDefinitionDomains)
    freeSeq(sidecar.targetRootDefinitionRows)
    freeSeq(sidecar.targetAddressSlotIds)
    freeSeq(sidecar.targetAddressDefinitionRows)
    freeSeq(sidecar.targetTypeIds)
    freeSeq(sidecar.sourceDefinitionDomains)
    freeSeq(sidecar.sourceDefinitionRows)
    freeSeq(sidecar.sourceSlotIds)
    freeSeq(sidecar.sourceSemanticRows)
    freeSeq(sidecar.consumeActionRows)
    freeSeq(sidecar.runtimeSemanticCids)
    freeSeq(sidecar.pathStarts)
    freeSeq(sidecar.pathCounts)
    freeSeq(sidecar.pathKinds)
    freeSeq(sidecar.pathProjectionNodeIndexes)
    freeSeq(sidecar.pathParentTypeIds)
    freeSeq(sidecar.pathIdentityKinds)
    freeSeq(sidecar.pathIdentityRows)
    freeSeq(sidecar.pathSelectorOrdinals)
    freeSeq(sidecar.pathResultTypeIds)
    freeSeq(sidecar.pathByteOffsets)
    freeSeq(sidecar.pathByteWidths)
    freeSeq(sidecar.pathIndexNodeIndexes)
    freeSeq(sidecar.pathIndexDefinitionDomains)
    freeSeq(sidecar.pathIndexDefinitionRows)
    freeSeq(sidecar.dropGlueDescriptorRows)
    freeSeq(sidecar.descriptorRootTypeIds)
    seqs.freeSeqStrRelease(sidecar.descriptorPayloads)
    freeSeq(sidecar.descriptorDigests)
    sidecar = coreir.BodyIRManagedLvalueReplaceSidecarNew()

fn BodyIrPayloadRelease(
        bodyIR: var coreir.BodyIR): BodyIrPayloadReleaseReceipt =
    let retained = BodyIrPayloadRetained(bodyIR)

    for opIndex in 0..<bodyIR.ops.len:
        freeSeq(bodyIR.ops[opIndex].operands)
    for callIndex in 0..<bodyIR.callSequence.len:
        bodyIR.callSequence[callIndex].targetSymbol = ""
        bodyIR.callSequence[callIndex].targetSourcePath = ""
        freeSeq(bodyIR.callSequence[callIndex].argSlots)
        freeSeq(bodyIR.callSequence[callIndex].argPassKinds)
        freeSeq(bodyIR.callSequence[callIndex].argAbiSizes)
    for slotIndex in 0..<bodyIR.localSlots.len:
        bodyIR.localSlots[slotIndex].name = ""
    for termIndex in 0..<bodyIR.terms.len:
        freeSeq(bodyIR.terms[termIndex].operands)
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        bodyIR.cstringLiterals[literalIndex].text = ""
        bodyIR.cstringLiterals[literalIndex].dataLabel = ""

    freeSeq(bodyIR.ops)
    freeSeq(bodyIR.callSequence)
    freeSeq(bodyIR.localSlots)
    freeSeq(bodyIR.entryDefinitionOwnershipKinds)
    freeSeq(bodyIR.entryDefinitionSemanticRows)
    freeSeq(bodyIR.entryParameterSlotIds)
    freeSeq(bodyIR.localBindingValueDefinitionRows)
    freeSeq(bodyIR.localAddressTargetDomainKinds)
    freeSeq(bodyIR.localAddressTargetRows)
    freeSeq(bodyIR.localAddressTargetCids)
    freeSeq(bodyIR.typeFactTypeIds)
    freeSeq(bodyIR.typeFactStructuralKinds)
    freeSeq(bodyIR.typeFactScalarKinds)
    freeSeq(bodyIR.typeFactChildTypeIds)
    freeSeq(bodyIR.typeFactFixedLengths)
    freeSeq(bodyIR.typeFactSizeBytes)
    freeSeq(bodyIR.typeFactAlignBytes)
    seqs.freeSeqStrRelease(bodyIR.slotNameIndex.keys)
    freeSeq(bodyIR.slotNameIndex.vals)
    freeSeq(bodyIR.slotNameIndex.hashes)
    freeSeq(bodyIR.slotNameIndex.states)
    bodyIR.slotNameIndex = hashmaps.HashMapStrInt()
    freeSeq(bodyIR.blocks)
    freeSeq(bodyIR.terms)
    freeSeq(bodyIR.cstringLiterals)
    freeSeq(bodyIR.cstringTargetRows)
    freeSeq(bodyIR.cstringOwnerFunctionFragmentCids)

    freeSeq(bodyIR.controlScopeParentIds)
    freeSeq(bodyIR.blockScopeIds)
    freeSeq(bodyIR.termSuccessorStarts)
    freeSeq(bodyIR.termSuccessorCounts)
    freeSeq(bodyIR.successorBlockIds)
    freeSeq(bodyIR.successorEdgeKinds)
    freeSeq(bodyIR.callTargetDomainKinds)
    freeSeq(bodyIR.callTargetRows)
    freeSeq(bodyIR.callTargetInterfaceCids)
    freeSeq(bodyIR.deferDeclarationScopeIds)
    freeSeq(bodyIR.deferSuiteScopeIds)
    freeSeq(bodyIR.deferLexicalOrdinals)
    freeSeq(bodyIR.deferFunctionRows)
    freeSeq(bodyIR.deferStatementRows)
    freeSeq(bodyIR.deferActionCids)
    freeSeq(bodyIR.deferActivationSiteBlockIds)
    freeSeq(bodyIR.deferActivationSiteAfterOpOrdinals)
    freeSeq(bodyIR.deferActivationSiteStarts)
    freeSeq(bodyIR.deferActivationSiteCounts)
    freeSeq(bodyIR.deferActivationRows)
    bodyIrPayloadReleaseCleanupIntentSidecar(
        bodyIR.cleanupIntent)
    bodyIrPayloadReleaseCleanupScheduleSidecar(
        bodyIR.cleanupSchedule)
    bodyIrPayloadReleaseDeferReplaySidecar(bodyIR.deferReplay)
    bodyIrPayloadReleaseManagedLvalueReplaceSidecar(
        bodyIR.managedLvalueReplace)

    freeSeq(bodyIR.manualConsume.callOrdinals)
    freeSeq(bodyIR.manualConsume.snapshotCallIds)
    freeSeq(bodyIR.manualConsume.targetArgumentOrdinals)
    freeSeq(bodyIR.manualConsume.sourceArgumentOrdinals)
    freeSeq(bodyIR.manualConsume.targetPlaceSlotIds)
    freeSeq(bodyIR.manualConsume.targetOwnerSlotIds)
    freeSeq(bodyIR.manualConsume.sourcePlaceSlotIds)
    freeSeq(
        bodyIR.manualConsume.targetArgumentBindingCids)
    freeSeq(
        bodyIR.manualConsume.sourceArgumentBindingCids)
    freeSeq(bodyIR.manualConsume.targetProjectionCids)
    freeSeq(bodyIR.manualConsume.sourceProjectionCids)
    freeSeq(bodyIR.manualConsume.targetDefinitionDomains)
    freeSeq(bodyIR.manualConsume.targetDefinitionRows)
    freeSeq(bodyIR.manualConsume.sourceDefinitionDomains)
    freeSeq(bodyIR.manualConsume.sourceDefinitionRows)
    freeSeq(bodyIR.manualConsume.targetTypeArenaTypeIds)
    freeSeq(bodyIR.manualConsume.sourceTypeArenaTypeIds)
    freeSeq(bodyIR.manualConsume.postDefinitionDomains)
    freeSeq(bodyIR.manualConsume.postDefinitionRows)
    freeSeq(bodyIR.manualConsume.effectCids)
    freeSeq(bodyIR.manualConsume.linearTokenCids)
    freeSeq(bodyIR.manualConsume.bridgeCids)
    bodyIrPayloadReleaseExternFfiHandleCapabilities(
        bodyIR.externFfiHandleCapabilities)

    freeSeq(bodyIR.debugOpIdsByOpIndex)
    freeSeq(bodyIR.debugSyntheticKindsByOpIndex)
    freeSeq(bodyIR.debugOpIdsByTermIndex)
    freeSeq(bodyIR.debugSyntheticKindsByTermIndex)

    freeSeq(bodyIR.layoutLhsElide)
    freeSeq(bodyIR.layoutStoreElide)
    freeSeq(bodyIR.layoutCopySrcElide)
    freeSeq(bodyIR.layoutCmpFuse)
    freeSeq(bodyIR.layoutCbrFuse)
    freeSeq(bodyIR.x64SlotReadCnt)
    freeSeq(bodyIR.x64BlockByteStart)

    bodyIR = coreir.BodyIRNew()
    var receipt: BodyIrPayloadReleaseReceipt
    receipt.releasedBytes = retained.retainedBytes
    receipt.releasedBufferCount = retained.physicalBufferCount
    receipt.releasedManagedStringValueCount =
        retained.managedStringValueCount
    receipt.releasedManagedStringBytes = retained.managedStringBytes
    receipt.storageReleased = BodyIrPayloadIsReleased(bodyIR)
    if !receipt.storageReleased ||
       BodyIrPayloadRetained(bodyIR).retainedBytes != int64(0) ||
       BodyIrPayloadRetained(bodyIR).physicalBufferCount != 0:
        bodyIrLifecycleFail("body ir lifecycle: physical payload release failed")
    return receipt

fn bodyIrSequenceAppendU32BE(
        buf: var layout.ByteBuf,
        value: int64) =
    layout.ByteBufAppendByte(buf, Int32((value >> 24) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 16) & 255))
    layout.ByteBufAppendByte(buf, Int32((value >> 8) & 255))
    layout.ByteBufAppendByte(buf, Int32(value & 255))

fn bodyIrSequenceAppendI32(
        buf: var layout.ByteBuf,
        value: int32) =
    bodyIrSequenceAppendU32BE(buf, int64(value))

fn bodyIrSequenceAppendBool(
        buf: var layout.ByteBuf,
        value: bool) =
    bodyIrSequenceAppendI32(buf, value ? 1 : 0)

@borrows
fn bodyIrSequenceAppendText(
        buf: var layout.ByteBuf,
        value: str) =
    bodyIrSequenceAppendI32(buf, value.len)
    for byteIndex in 0..<value.len:
        layout.ByteBufAppendByte(buf, value[byteIndex])

@borrows
fn bodyIrSequenceAppendTexts(
        buf: var layout.ByteBuf,
        values: str[]) =
    bodyIrSequenceAppendI32(buf, values.len)
    for valueIndex in 0..<values.len:
        bodyIrSequenceAppendText(buf, values[valueIndex])

@borrows
fn bodyIrSequenceAppendInt32s(
        buf: var layout.ByteBuf,
        values: int32[]) =
    bodyIrSequenceAppendI32(buf, values.len)
    for valueIndex in 0..<values.len:
        bodyIrSequenceAppendI32(buf, values[valueIndex])

@borrows
fn bodyIrSequenceAppendBools(
        buf: var layout.ByteBuf,
        values: bool[]) =
    bodyIrSequenceAppendI32(buf, values.len)
    for valueIndex in 0..<values.len:
        bodyIrSequenceAppendBool(buf, values[valueIndex])

@borrows
fn bodyIrSequenceAppendFixed32s(
        buf: var layout.ByteBuf,
        values: layout.FixedBytes32[]) =
    bodyIrSequenceAppendI32(buf, values.len)
    for valueIndex in 0..<values.len:
        layout.ByteBufAppendFixed32(buf, values[valueIndex])

@borrows
fn bodyIrSequenceAppendExternFfiHandleCapabilities(
        buf: var layout.ByteBuf,
        sidecar: coreir.BodyIRExternFfiHandleCapabilitySidecar) =
    bodyIrSequenceAppendBool(buf, sidecar.sealed)
    bodyIrSequenceAppendI32(buf, sidecar.functionRow)
    layout.ByteBufAppendFixed32(
        buf, sidecar.snapshotProjectionAuthorityCid)
    layout.ByteBufAppendFixed32(buf, sidecar.semanticCargoCid)
    layout.ByteBufAppendFixed32(buf, sidecar.loweringBridgeCid)
    bodyIrSequenceAppendInt32s(buf, sidecar.callOrdinals)
    bodyIrSequenceAppendInt32s(buf, sidecar.callBodyOpRows)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.semanticCapabilityCallRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.resolvedCallRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.snapshotCallIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.semanticContractRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.snapshotContractRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.semanticEffectStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.effectStarts)
    bodyIrSequenceAppendInt32s(buf, sidecar.effectCounts)
    bodyIrSequenceAppendFixed32s(buf, sidecar.callCapabilityCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.contractCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.interfaceCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.callBridgeCids)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.semanticCapabilityEffectRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.contractEffectRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.snapshotEffectRows)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.snapshotEffectContractRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.effectKinds)
    bodyIrSequenceAppendInt32s(buf, sidecar.targetKinds)
    bodyIrSequenceAppendInt32s(buf, sidecar.parameterOrdinals)
    bodyIrSequenceAppendInt32s(buf, sidecar.argumentRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.argumentSlotIds)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.argumentValueNodeIndexes)
    bodyIrSequenceAppendInt32s(buf, sidecar.valueDefinitionRows)
    bodyIrSequenceAppendInt32s(
        buf, sidecar.generationRootValueDefinitionRows)
    bodyIrSequenceAppendInt32s(buf, sidecar.exactTypeIds)
    bodyIrSequenceAppendInt32s(buf, sidecar.carrierKinds)
    bodyIrSequenceAppendFixed32s(buf, sidecar.argumentBindingCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.typeCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.generationCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.definitionLineageCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.effectCapabilityCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.contractEffectCids)
    bodyIrSequenceAppendFixed32s(buf, sidecar.effectBridgeCids)
    layout.ByteBufAppendFixed32(buf, sidecar.rootCid)

