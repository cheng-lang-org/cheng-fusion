    LirFunction = ref object
        id: FuncId
        nameId: NameId
        stackSlots: MirStackSlot[]
        insns: LirInsn[]

fn InvalidTypeId(): TypeId =
    return -1

fn InvalidValueId(): ValueId =
    return -1

fn InvalidStackSlotId(): StackSlotId =
    return -1

fn CallArgSlotMissing(): int32 =
    return 0 - 2147483647

fn CallArgSlotConstTrue(): int32 =
    return 0 - 2147483646

fn CallArgSlotConstFalse(): int32 =
    return 0 - 2147483645

fn CallArgSlotConstPtrNil(): int32 =
    return 0 - 2147483644

fn CallArgSlotConstOrdinal(slot: int32): int32 =
    if slot >= 0:
        return -1
    let delta = slot - CallArgSlotMissing()
    if delta < 1:
        return -1
    if delta > 3:
        return -1
    return delta

fn CallArgSlotCStringBase(): int32 =
    return 0 - 2147483000

fn CallArgSlotAddressBase(): int32 =
    return 0 - 2147482000

fn CallArgSlotCString(literalId: int32): int32 =
    return CallArgSlotCStringBase() + literalId

fn CallArgSlotAddress(slotId: int32): int32 =
    return CallArgSlotAddressBase() + slotId

fn CallArgSlotIsConst(slot: int32): bool =
    return CallArgSlotConstOrdinal(slot) > 0

fn CallArgSlotIsCString(slot: int32): bool =
    if slot >= 0:
        return false
    let delta = slot - CallArgSlotCStringBase()
    if delta < 0:
        return false
    if delta >= (CallArgSlotAddressBase() - CallArgSlotCStringBase()):
        return false
    return true

fn CallArgSlotIsAddress(slot: int32): bool =
    if slot >= 0:
        return false
    let delta = slot - CallArgSlotAddressBase()
    return delta >= 0

fn CallArgSlotCStringId(slot: int32): int32 =
    if !CallArgSlotIsCString(slot):
        return -1
    return slot - CallArgSlotCStringBase()

fn CallArgSlotAddressId(slot: int32): int32 =
    if !CallArgSlotIsAddress(slot):
        return -1
    return slot - CallArgSlotAddressBase()

fn CallArgSlotConstI32Value(slot: int32): int32 =
    let ordinal = CallArgSlotConstOrdinal(slot)
    if ordinal == 1:
        return 1
    return 0

fn TypeLayoutInvalid(): TypeLayout =
    var out: TypeLayout
    return out

fn TypeLayoutScalar(kind: int32, size: int32, align: int32): TypeLayout =
    var out: TypeLayout
    out.kind = kind
    out.abiClass = AbiScalarTag
    out.size = size
    out.align = align
    out.isTriviallyMoveable = true
    out.isTriviallyDrop = true
    return out

fn TypeLayoutFixedBytes(size: int32, align: int32): TypeLayout =
    var out: TypeLayout
    out.kind = LayoutFixedBytesTag
    out.abiClass = AbiAggregateTag
    out.size = size
    out.align = align
    out.fixedCount = size
    out.isTriviallyMoveable = true
    out.isTriviallyDrop = true
    return out

fn PlaceRoot(baseValue: ValueId, typeId: TypeId): Place =
    var out: Place
    out.baseValue = baseValue
    out.typeId = typeId
    out.fieldOrdinal = -1
    out.ownership = OwnPlainTag
    out.aliasClass = AliasUnknownTag
    out.escapeKind = EscapeInvalidTag
    return out

fn IsOwnershipNoAlias(ownership: OwnershipKind, alias: AliasClass): bool =
    var ownershipNoAlias: bool
    if ownership == OwnBorrowUnique:
        ownershipNoAlias = true
    elif ownership == OwnMove:
        ownershipNoAlias = true
    elif ownership == OwnPlain:
        ownershipNoAlias = true
    if !ownershipNoAlias:
        return false
    if alias == AliasNoAlias:
        return true
    if alias == AliasUnique:
        return true
    return false

fn MirFunctionNew(nameId: NameId): MirFunction =
    var out: MirFunction
    out.id = -1
    out.nameId = nameId
    out.paramCount = 0
    out.resultTypeId = InvalidTypeId()
    out.stackSlots = []
    out.values = []
    out.borrowFacts = []
    out.ops = []
    out.blocks = []
    return out

fn LirFunctionNew(nameId: NameId): LirFunction =
    var out: LirFunction
    out.id = -1
    out.nameId = nameId
    out.stackSlots = []
    out.insns = []
    return out

fn BodyIrExactDefSidecarNew(): BodyIrExactDefSidecar =
    var out: BodyIrExactDefSidecar
    # wall69: 大结构构造器逐字段显式落定。seq 用描述符直写
    # (len=0/cap=0/buffer=nil, 纯 store 无 rc 语义)——「= []」空列赋值带
    # release 旧值语义, 对未初始化槽=release 垃圾描述符, 与栈复用残留叠加
    # 即误释放真实堆块 (cold_nested 编译期 use-after-free 实证)。
    out.opPlaceKinds.len = 0
    out.opPlaceKinds.cap = 0
    out.opPlaceKinds.buffer = nil
    out.opExactTypeIds.len = 0
    out.opExactTypeIds.cap = 0
    out.opExactTypeIds.buffer = nil
