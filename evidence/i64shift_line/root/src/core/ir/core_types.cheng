    out.opReadADefOpRows.cap = 0
    out.opReadADefOpRows.buffer = nil
    out.slotPlaceKinds.len = 0
    out.slotPlaceKinds.cap = 0
    out.slotPlaceKinds.buffer = nil
    out.slotOriginIds.len = 0
    out.slotOriginIds.cap = 0
    out.slotOriginIds.buffer = nil
    out.slotStorageKinds.len = 0
    out.slotStorageKinds.cap = 0
    out.slotStorageKinds.buffer = nil
    out.callArgStarts.len = 0
    out.callArgStarts.cap = 0
    out.callArgStarts.buffer = nil
    out.callArgCounts.len = 0
    out.callArgCounts.cap = 0
    out.callArgCounts.buffer = nil
    out.argDefOpRows.len = 0
    out.argDefOpRows.cap = 0
