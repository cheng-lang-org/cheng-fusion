import std/strformat
import std/hashmaps
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/ir/phase_arena as phase
import std/strings

type
    NameId = int32

    ModuleId = int32

    FuncId = int32

    BlockId = int32

    TypeId = int32

    ValueId = int32

    StackSlotId = int32

type
    AbiClass = enum
        AbiNone
        AbiScalar
        AbiPointer
        AbiAggregate
        AbiVector

type
    LayoutKind = enum
        LayoutInvalid
        LayoutVoid
        LayoutI1
        LayoutI8
        LayoutI16
        LayoutI32
        LayoutI64
        LayoutFixedBytes
        LayoutArray
        LayoutRecord
        LayoutPointer

type
    OwnershipKind = enum
        OwnInvalid
        OwnPlain
        OwnMove
        OwnBorrowShared
        OwnBorrowUnique

type
    AliasClass = enum
        AliasUnknown
        AliasUnique
        AliasNoAlias
        AliasMayAlias

type
    EscapeKind = enum
        EscapeInvalid
        EscapeNone
        EscapeArg
        EscapeReturn
        EscapeGlobal

type
    ValueKind = enum
        ValueInvalid
        ValueImmediate
        ValueStack
        ValueAddress
        ValueBorrow
        ValuePhi
        ValueCallResult

type
    HirExprKind = enum
        HirInvalid
        HirIntLiteral
        HirBytesLiteral
        HirNameRef
        HirCall
        HirField
        HirIndex
        HirBorrow
        HirMove

type
    MirOpKind = enum
        MirInvalid
        MirConst
        MirMove
        MirBorrow
        MirLoad
        MirStore
        MirAddrOf
        MirCall
        MirPhi
        MirRet
        MirTrap

type
    CallConv = enum
        CallInvalid
        CallInternal
        CallC

type
    LirInsnKind = enum
        LirInvalid
        LirMove
        LirLoad
        LirStore
        LirCall
        LirRet
        LirTrap

type
    BodyOpKind = enum
        BodyOpInvalid
        BodyOpLoadConst
        BodyOpCall
        BodyOpBinOp
        BodyOpCmp
        BodyOpBranch
        BodyOpReturn
        BodyOpLoadLocal
        BodyOpStoreLocal
        BodyOpCopyLocal
        BodyOpResultProject
        BodyOpStrEqLiteral
        BodyOpIndexedLoad
        BodyOpIndexedStore
        BodyOpFieldLoad
        BodyOpFieldStore
        BodyOpGlobalLoad
        BodyOpGlobalStore
        BodyOpStrEq
        BodyOpResultPanicGuard

type
    LocalType = enum
        LocalInvalid
        LocalI32
        LocalF64
        LocalStr
        LocalPtr
        LocalAggregate
        LocalI64

const
    BodyOpInvalidTag = 0
    BodyOpLoadConstTag = 1
    BodyOpCallTag = 2
    BodyOpBinOpTag = 3
    BodyOpCmpTag = 4
    BodyOpBranchTag = 5
    BodyOpReturnTag = 6
    BodyOpLoadLocalTag = 7
    BodyOpStoreLocalTag = 8
    BodyOpCopyLocalTag = 9
    BodyOpResultProjectTag = 10
    BodyOpStrEqLiteralTag = 11
    BodyOpIndexedLoadTag = 12
    BodyOpIndexedStoreTag = 13
    BodyOpFieldLoadTag = 14
    BodyOpFieldStoreTag = 15
    BodyOpGlobalLoadTag = 16
    BodyOpGlobalStoreTag = 17
    BodyOpStrEqTag = 18
    # F14b: Result.Value() ok-check panic guard. Self-contained (no block/term
    # participation): emit reads operands[0] (i32 cond slot, nonzero=ok) and,
    # only when zero, invokes the registered call at operands[1] (an ordinal
    # into bodyIR.callSequence, built exactly like any other synthesized call)
    # before falling through to the following ops unconditionally. No result
    # slot (target=-1) — mirrors result.cheng:80-83 source-level panic guard
    # without requiring CFG block/term machinery at expression-eval depth.
    BodyOpResultPanicGuardTag = 19
    # One closed public BodyOp tag interval.  Every serializer, decoder and
    # admission check consumes these bounds instead of naming the formerly
    # last opcode independently.
    BodyOpFirstTag = BodyOpLoadConstTag
    BodyOpLastTag = BodyOpResultPanicGuardTag
    BodyOpTagCount = BodyOpLastTag + 1
    AbiScalarTag = 1
    AbiAggregateTag = 3
    LayoutFixedBytesTag = 7
    OwnPlainTag = 1
    AliasUnknownTag = 0
    EscapeInvalidTag = 0
    EscapeNoneTag = 1
    LocalInvalidTag = 0
    LocalI32Tag = 1
    LocalF64Tag = 2
    LocalStrTag = 3
    LocalPtrTag = 4
    LocalAggregateTag = 5
    LocalI64Tag = 6
    # Immutable semantic storage proof carried from the typed type identity.
    # Unknown is not an unmanaged default: aggregate global stores must have
    # one of the two proven states and an exact non-negative TypeArena TypeId.
    BodyManagedStorageUnknownTag = 0
    BodyManagedStorageUnmanagedTag = 1
    BodyManagedStorageManagedTag = 2
    BodyPlaceStackValueTag = 0
    BodyPlaceParamAddressTag = 1
    BodyPlaceBorrowAddressTag = 2
    BodyPlaceGlobalAddressTag = 3
    BodyCallPassStackValueTag = 0
    BodyCallPassParamAddressTag = 1
    BodyCallPassBorrowAddressTag = 2
    BodyCallPassSretResultTag = 3
    BodyCallPassByAddressAggregateTag = 4
    BodyCallPassGlobalAddressTag = 5
    BodyCallPassPtrNilTag = 6
    # Compiler-private C-ABI bridge contract: the call consumes the entry
    # function's hidden AAPCS64 x8 sret buffer unchanged.  This is a result
    # channel fact, not an ordinary positional argument and not a synthetic
    # result slot.
    BodyCallPassForwardEntrySretTag = 7
    # Exact call-target partition. A row is meaningful only in its declared
    # domain; interface CID remains the portable semantic identity.
    BodyCallTargetDomainInvalidTag = 0
    BodyCallTargetDomainFunctionTag = 1
    BodyCallTargetDomainExternFunctionTag = 2
    BodyCallTargetDomainRuntimeIntrinsicTag = 3
    # Exact data-relocation target partition.  The row is meaningful only in
    # this declared semantic domain; the CID is the portable identity.
    BodyDataRelocTargetDomainInvalidTag = 0
    BodyDataRelocTargetDomainTypedGlobalTag = 1
    BodyDataRelocTargetDomainFunctionTag = 2
    BodyExternFfiHandleEffectProduceTag = 1
    BodyExternFfiHandleEffectBorrowTag = 2
    BodyExternFfiHandleEffectConsumeTag = 3
    BodyExternFfiHandleTargetResultTag = 1
    BodyExternFfiHandleTargetParameterTag = 2
    BodyExternFfiHandleCarrierUInt32Tag = 1
    BodyExternFfiHandleCarrierUInt64Tag = 2
    BodyBranchIfLocalNilReturnI32ConstTag = 1
    BodyBranchIfLocalLeZeroReturnI32ConstTag = 2
    BodyBranchIfLocalLeZeroReturnCallNoargTag = 3
    BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag = 4
    BodyLoadLocalPtrDerefI32Tag = 1
    BodyLoadLocalPtrDerefU8Tag = 2
    BodyLoadLocalStrIndexU8Tag = 3
    BodyLoadLocalAddressTag = 4
    BodyLoadLocalCStringTag = 5
    BodyLoadLocalPtrDerefU64Tag = 6
    # Compiler-private address projection. Operands are
    # [tag, rootSlot, indexSlot, elementSizeBytes, dynamicSequenceFlag].
    # The target LocalPtr is a BorrowAddress value-definition whose exact
    # TypedExpr/TypeArena path is frozen in managedLvalueReplace.
    BodyLoadLocalIndexedAddressTag = 7
    # Compiler-private exact field-address projection. Operands are
    # [tag, rootSlot, byteOffset, byteWidth]. The root is a real value-
    # definition and the TypeArena member row is frozen in the managed
    # lvalue-replace path; no aggregate bytes are copied.
    BodyLoadLocalFieldAddressTag = 8
    BodyStoreLocalPtrDerefU8Tag = 2
    BodyTermInvalidTag = 0
    BodyTermReturnTag = 1
    BodyTermBrTag = 2
    BodyTermCbrTag = 3
    # Canonical structured control-edge kinds. These are serialized BodyIR
    # facts produced by lowering; cleanup must not infer them from terminators.
    BodyControlEdgeUnknown = 0
    BodyControlEdgeNormal = 1
    BodyControlEdgeReturn = 2
    BodyControlEdgeBreak = 3
    BodyControlEdgeContinue = 4
    BodyControlEdgeLoopBack = 5
    BodyDeferReplaySourceSuccessorTag = 1
    BodyDeferReplaySourceReturnExitTag = 2
    BodyCleanupUnitReturnSnapshotTag = 1
    BodyCleanupUnitGuardSnapshotTag = 2
    BodyCleanupUnitDeferTag = 3
    BodyCleanupUnitOwnershipActionTag = 4
    BodyCleanupUnitTransitionTag = 5
    BodyCleanupClearLocalZeroTag = 1
    BodyCleanupProjectionNoneTag = 0
    BodyCleanupProjectionIdentityTag = 1
    BodyCleanupProjectionSnapshotTag = 2
    BodyCleanupUnitOwnerExitTag = 1
    BodyCleanupUnitOwnerOpSiteTag = 2
    BodyCleanupSemanticDeferTag = 1
    BodyCleanupSemanticOwnershipActionTag = 2
    BodyCleanupSemanticReturnSnapshotTag = 3
    BodyCleanupSemanticGuardSnapshotTag = 4
    BodyCleanupSemanticOwnershipTransitionTag = 5
    BodyCleanupEffectDomainBodyOpTag = 1
    BodyCleanupEffectDomainCallOpTag = 2
    BodyCleanupEffectDomainBodyTermTag = 3
    BodyCleanupEffectRoleDefinitionTag = 1
    BodyCleanupEffectRoleConsumeTag = 2
    BodyCleanupEffectRoleClearTag = 3
    BodyCleanupEffectRoleTransitionTag = 4
    BodyCleanupEffectRoleExecuteTag = 5
    BodyCleanupEffectRolePredicateTag = 6
    # Immutable semantic provenance carried beside BodyOp/BodyTerm in SoA
    # columns.  A machine fragment is either joined to one exact DebugOpId or
    # explicitly compiler-generated with one of the non-zero kinds below.
    BodyDebugSyntheticNone = 0
    BodyDebugSyntheticCleanup = 1
    BodyDebugSyntheticControlFlow = 2
    BodyDebugSyntheticAbi = 3
    BodyDebugSyntheticRuntime = 4
    BodyCondInvalidTag = 0
    BodyCondLocalNonZeroTag = 1
    BodyCondLocalZeroTag = 2
    BodyCondI32EqTag = 3
    BodyCondI32NeTag = 4
    BodyCondI32LtTag = 5
    BodyCondI32LeTag = 6
    BodyCondI32GtTag = 7
    BodyCondI32GeTag = 8
    BodyCondI64EqTag = 9
    BodyCondI64NeTag = 10
    BodyCondI64LtTag = 11
    BodyCondI64LeTag = 12
    BodyCondI64GtTag = 13
    BodyCondI64GeTag = 14
    # Unsigned relational condition tags. Eq/Ne are sign-agnostic so they have no
    # unsigned variant; only ordering (lt/le/gt/ge) differs between signed and
    # unsigned. These select the ARM64 lo/ls/hi/hs (x86 b/be/a/ae) condition
    # codes instead of the signed lt/le/gt/ge, so a high-bit-set unsigned operand
    # compares as a large positive value rather than a negative one.
    BodyCondU32LtTag = 15
    BodyCondU32LeTag = 16
    BodyCondU32GtTag = 17
    BodyCondU32GeTag = 18
    BodyCondU64LtTag = 19
    BodyCondU64LeTag = 20
    BodyCondU64GtTag = 21
    BodyCondU64GeTag = 22
    BodyCondF64EqTag = 23
    BodyCondF64NeTag = 24
    BodyCondF64LtTag = 25
    BodyCondF64LeTag = 26
    BodyCondF64GtTag = 27
    BodyCondF64GeTag = 28
    ManagedStoreNoneTag = 0
    ManagedStoreStrRetainTag = 1
    ManagedStoreStrMoveTag = 2
    ManagedStoreSeqRetainTag = 3
    ManagedStoreSeqMoveTag = 4
    ManagedStoreSnapshotRetainTag = 5
    ManagedStoreSnapshotCloneTag = 6
    ManagedStoreCleanupRetainTag = 7
    ManagedStoreAggregateRetainTag = 8
    ManagedStoreAggregateMoveTag = 9
    BodyResultProjectInvalidTag = 0
    BodyResultProjectIsErrTag = 1
    BodyResultProjectErrorStrTag = 2
    BodyResultProjectValueStrTag = 3
    BodyResultProjectErrInfoTag = 4
    BodyResultProjectIsOkTag = 5
    BodyDefinitionOriginUnknownTag = 0
    BodyDefinitionOriginTypedExprTag = 1
    BodyDefinitionOriginCanonicalCleanupActionTag = 2
    # A definition row is meaningful only together with its domain.  BodyOp
    # rows and manual-consume post-call rows are independent dense index
    # spaces; callers must never compare or transport a bare row.
    BodyDefinitionDomainInvalidTag = 0
    BodyDefinitionDomainEntrySlotTag = 1
    BodyDefinitionDomainBodyOpTag = 2
    BodyDefinitionDomainManualConsumePostCallTag = 3
    ResultStrOkOffset = 0
    ResultStrValueOffset = 8
    ResultStrErrCodeOffset = 32
    ResultStrErrMsgOffset = 40
    ResultStrSizeBytes = 64
    ResultStrAlignBytes = 16

type
    TypeLayout =
        kind: LayoutKind
        abiClass: AbiClass
        size: int32
        align: int32
        fixedCount: int32
        fieldCount: int32
        isTriviallyMoveable: bool
        isTriviallyDrop: bool

    Place =
        baseValue: ValueId
        typeId: TypeId
        offset: int32
        fieldOrdinal: int32
        ownership: OwnershipKind
        aliasClass: AliasClass
        escapeKind: EscapeKind

    BorrowFact =
        ownerValue: ValueId
        place: Place
        borrowKind: OwnershipKind
        aliasClass: AliasClass
        escapeKind: EscapeKind
        scopeDepth: int32

    MirValue =
        id: ValueId
        typeId: TypeId
        kind: ValueKind
        ownership: OwnershipKind
        aliasClass: AliasClass
        escapeKind: EscapeKind
        stackSlot: StackSlotId
        immLo: int64
        immHi: int64

    MirOp =
        kind: MirOpKind
        result: ValueId
        src0: ValueId
        src1: ValueId
        src2: ValueId
        place: Place
        callConv: CallConv
        calleeNameId: NameId
        trapTextId: NameId

    MirStackSlot =
        id: StackSlotId
        typeId: TypeId
        offset: int32
        size: int32
        align: int32
        noAlias: bool

    MirBlock =
        id: BlockId
        opStart: int32
        opCount: int32

    MirFunction = ref object
        id: FuncId
        nameId: NameId
        paramCount: int32
        resultTypeId: TypeId
        stackSlots: MirStackSlot[]
        values: MirValue[]
        borrowFacts: BorrowFact[]
        ops: MirOp[]
        blocks: MirBlock[]

    LirInsn =
        kind: LirInsnKind
        dstReg: int32
        srcReg0: int32
        srcReg1: int32
        stackSlot: StackSlotId
        callConv: CallConv
        calleeNameId: NameId

    BodyOp =
        kind: int32
        operands: int32[]
        target: int32
        # Immutable semantic value-definition authority.  Zero ownership means
        # this op does not define a managed value. Managed replacement consumes
        # it through a later append-only CallOp/BodyOp event that cites this
        # exact definition domain/row; the producer is never rewritten.
        valueDefSlot: int32 = -1
        valueDefExprNodeIndex: int32 = -1
        valueDefSemanticRow: int32 = -1
        valueDefOwnership: OwnershipKind
        # Immutable exact lifetime root for OwnBorrowShared. Semantic row is
        # the TypedExpr value-definition identity; domain/row is its frozen
        # physical BodyIR definition. All other ownership kinds carry invalid
        # sentinels.
        valueDefBorrowOwnerSemanticRow: int32 = -1
        valueDefBorrowOwnerDefinitionDomain: int32
        valueDefBorrowOwnerDefinitionRow: int32 = -1
        valueDefConsumeOpIndexPlusOne: int32
        valueDefOriginKind: int32
        valueDefOriginId: int32 = -1
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1
        consumeActionRow: int32 = -1

    BodyBlock =
        id: int32
        opStart: int32
        opCount: int32
        termIndex: int32

    BodyTerm =
        kind: int32
        conditionKind: int32
        resultSlot: int32
        # Exact managed value-definition transferred by a return terminator.
        # Non-return and unmanaged return terms keep the invalid domain/-1 row.
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1
        lhsSlot: int32
        rhsSlot: int32
        trueBlock: int32
        falseBlock: int32
        operands: int32[]

    LocalSlot =
        id: int32
        name: str
        typeKind: int32
        # Exact upstream semantic TypeId.  This is never reconstructed from
        # name, typeKind, size, ownership, or layout.  -1 means unproven.
        typeArenaTypeId: int32 = -1
        managedStorageKind: int32
        placeKind: int32
        stackOffset: int32
        sizeBytes: int32
        alignBytes: int32
        auxValue: int32
        ownership: OwnershipKind
        aliasClass: AliasClass
        escapeKind: EscapeKind
        noAlias: bool

    CallOp =
        targetSymbol: str
        # Exact Cheng declaration owner selected by TypedExpr. Empty only for
        # synthetic runtime/indirect calls that have no Cheng function body.
        # Realizer and reloc planning must never reconstruct this from a
        # source-agnostic symbol search.
        targetSourcePath: str
        argSlots: int32[]
        argPassKinds: int32[]
        # [wall131] Per-arg callee formal-parameter ownership authority
        # (OwnershipKind encoding), filled once at user-call construction
        # time (PrimaryBodyIrFillCallArgFormalOwnerships): var/borrow formals
        # -> OwnBorrowUnique, value/owned formals -> OwnMove. Empty for
        # importc targets and synthetic calls; when non-empty the length
        # must equal argSlots. Sentinel contract: consumers treat an empty
        # column (and OwnInvalid rows) as "no formal authority" and keep
        # their pre-existing behavior byte-for-byte.
        argFormalOwnerships: int32[]
        # Per-arg ABI storage size (1=bool, 4=int32-class, 8=64-bit/address).
        # Empty for legacy builders that never produce stack args; when present
        # length matches argSlots. Drives Darwin AArch64 packed stack layout.
        argAbiSizes: int32[]
        resultSlot: int32
        resultPassKind: int32
        # Exact TypedExpr CallExpr authority for a managed result.  Synthetic
        # and unmanaged calls may leave resultOwnership=OwnInvalid.
        resultOwnership: OwnershipKind
        resultExprNodeIndex: int32 = -1
        resultValueDefinitionRow: int32 = -1
        resultBorrowOwnerValueDefinitionRow: int32 = -1
        resultBorrowOwnerDefinitionDomain: int32
        resultBorrowOwnerDefinitionRow: int32 = -1
        resultDefinitionOriginKind: int32
        resultDefinitionOriginId: int32 = -1
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1
        # Exact semantic call-expression identity. Synthetic calls keep -1.
        semanticCallExprNodeIndex: int32 = -1
        consumeActionRow: int32 = -1
        # Synthetic runtime semantic opcode.  This is the authority used by
        # ownership verification; targetSymbol is only the linker spelling.
        managedStoreKind: int32
        # Dense immutable row in BodyIR.managedLvalueReplace.  Managed stores
        # may not reconstruct projection or drop-glue identity from symbols.
        managedReplaceReceiptRow: int32 = -1
        managedDropGlueDescriptorRow: int32 = -1
        relocWordOffset: int32
        # #73: true when targetSymbol crosses the real AAPCS64 C ABI boundary
        # (an @importc/provider symbol). Cheng-to-Cheng calls keep f64 args as
        # raw bits in X registers (see PrimaryBodyIRLoadSlotToRegBiased); only a
        # true C-ABI target needs the fmov d{n},x{n} bit-preserving move onto the
        # float register file before the call. Defaults false (Cheng-internal).
        targetIsImportc: bool
        # 0 = normal call. 1/2 = this call resolves to the never-compiled
        # generic template std/system.cheng:544 `fn float64(x: T): float64` with
        # an int32(1)/int64(2)-typed argument -- set ONCE at BodyIR construction
        # time (PrimaryBodyIrAppendCallOp), consumed identically by both the birc
        # validation pass and the real fill pass (both call that same construction
        # path, so a construction-time field survives where a later mutation of
        # targetSymbol against a re-derived BodyIR would not). targetSymbol is
        # deliberately left untouched so the normal birc symbol-resolution walk
        # (which matches call.targetSymbol against the lowering-plan's expected
        # call-target list) proceeds unaffected; only the later BL-reloc
        # registration step and the fill-time emitter branch on this field.
        inlineF64FromIntKind: int32
        # #95 wave5: provenance tag, true ONLY for CallOps synthesized by
        # PrimaryBodyIrAppendWholeCallExprToSlot's int->float64 SCVTF/UCVTF
        # inline rescue branch (gen1 primary_object_plan.cheng and its gen2
        # backend2_lower_slots.cheng mirror). inlineF64FromIntKind alone is
        # ambiguous -- the unrelated, pre-existing PrimaryBodyIrAppendCallOp
        # generic call constructor also sets it for any call whose target
        # tail is literally "float64", regardless of provenance (wave4
        # REFUTED finding 1: this let a silent unresolved-`bl` CallOp built
        # by that unrelated path be misidentified as "safe to skip symbol
        # registration"). Symbol-registration exemption sites must gate on
        # THIS field, never on inlineF64FromIntKind alone.
        wholeCallF64FromIntRescue: bool
        # #95 wave5: true when the rescue's source int argument's declared
        # type (resolved at construction time via
        # PrimaryBodyIrBindingTypeForName) is unsigned -- selects UCVTF
        # instead of SCVTF at fill time. Only meaningful when
        # wholeCallF64FromIntRescue is true (wave4 REFUTED finding 2: SCVTF
        # unconditionally on a uint32/uint64 value with the high bit set
        # silently produces a negative float64).
        inlineF64FromIntUnsigned: bool

    CStringLiteralEntry =
        id: int32
        text: str
        dataLabel: str

    BodyIRManualConsumeCallEffect =
        callOrdinal: int32 = -1
        snapshotCallId: int32 = -1
        targetArgumentOrdinal: int32 = -1
        sourceArgumentOrdinal: int32 = -1
        targetPlaceSlotId: int32 = -1
        targetOwnerSlotId: int32 = -1
        sourcePlaceSlotId: int32 = -1
        targetArgumentBindingCid: layout.FixedBytes32
        sourceArgumentBindingCid: layout.FixedBytes32
        targetProjectionCid: layout.FixedBytes32
        sourceProjectionCid: layout.FixedBytes32
        targetDefinitionDomain: int32
        targetDefinitionRow: int32 = -1
        sourceDefinitionDomain: int32
        sourceDefinitionRow: int32 = -1
        targetTypeArenaTypeId: int32 = -1
        sourceTypeArenaTypeId: int32 = -1
        postDefinitionDomain: int32
        postDefinitionRow: int32 = -1
        effectCid: layout.FixedBytes32
        linearTokenCid: layout.FixedBytes32
        bridgeCid: layout.FixedBytes32

    # Immutable pre-materialization cleanup authority. Exit and op-site rows
    # are independent canonical owner domains; unit ownership is derived from
    # their CSR ranges and is never duplicated on unit rows.
    BodyIRCleanupIntentSidecar =
        building: bool
        sealed: bool
        rootCid: layout.FixedBytes32
        sourceControlCid: layout.FixedBytes32
        ownershipIrCid: layout.FixedBytes32
        ownershipAnalysisCid: layout.FixedBytes32
        originalLocalCount: int32
        originalOpCount: int32
        originalCallCount: int32
        originalBlockCount: int32
        originalTermCount: int32
        sourceBlockIds: int32[]
        sourceTermRows: int32[]
        sourceTermCids: layout.FixedBytes32[]
        sourceSuccessorOrdinals: int32[]
        originalSuccessorCounts: int32[]
        sourceExitKinds: int32[]
        originalTargetBlockIds: int32[]
        originalEdgeKinds: int32[]
        sourceScopeIds: int32[]
        targetScopeIds: int32[]
        exitOwnershipEdgeIds: int32[]
        selectedDeferStarts: int32[]
        selectedDeferCounts: int32[]
        exitUnitStarts: int32[]
        exitUnitCounts: int32[]
        siteOriginalBlockIds: int32[]
        siteAfterOpOrdinals: int32[]
        siteOwnershipOpStarts: int32[]
        siteOwnershipOpCounts: int32[]
        siteUnitStarts: int32[]
        siteUnitCounts: int32[]
        ownershipOpRows: int32[]
        selectedDeferIds: int32[]
        unitKinds: int32[]
        unitSemanticDomains: int32[]
        unitSemanticStarts: int32[]
        unitSemanticCounts: int32[]
        unitSnapshotSourceSlotStarts: int32[]
        unitSnapshotSourceSlotCounts: int32[]
        unitConditionStarts: int32[]
        unitConditionCounts: int32[]
        unitClearStarts: int32[]
        unitClearCounts: int32[]
        unitAuthorityCids: layout.FixedBytes32[]
        snapshotSourceSlotIds: int32[]
        snapshotProjectionPolicies: int32[]
        snapshotSemanticRows: int32[]
        snapshotTypeArenaTypeIds: int32[]
        snapshotInterfaceCids: layout.FixedBytes32[]
        conditionKinds: int32[]
        conditionInputSourceSlotIds: int32[]
        conditionSemanticRows: int32[]
        conditionSemanticOrdinals: int32[]
        clearKinds: int32[]
        clearTargetSourceSlotIds: int32[]
        clearSemanticRows: int32[]
        clearSemanticOrdinals: int32[]

    # Post-materialization physical schedule. Owner and unit order is exactly
    # the immutable Intent order, so no intent-unit mapping column is stored.
    BodyIRCleanupScheduleSidecar =
        building: bool
        sealed: bool
        rootCid: layout.FixedBytes32
        finalControlCid: layout.FixedBytes32
        ownerPhysicalSourceBlockIds: int32[]
        ownerSourceTermRows: int32[]
        ownerSourceSuccessorOrdinals: int32[]
        ownerFinalContinuationBlockIds: int32[]
        ownerFinalEdgeKinds: int32[]
        ownerContinuationCids: layout.FixedBytes32[]
        opStarts: int32[]
        opCounts: int32[]
        callStarts: int32[]
        callCounts: int32[]
        blockStarts: int32[]
        blockCounts: int32[]
        termStarts: int32[]
        termCounts: int32[]
        unitLocalStarts: int32[]
        unitLocalCounts: int32[]
        unitProjectedSnapshotSlotStarts: int32[]
        unitProjectedSnapshotSlotCounts: int32[]
        unitEffectStarts: int32[]
        unitEffectCounts: int32[]
        effectSemanticRows: int32[]
        effectPhysicalDomains: int32[]
        effectPhysicalRows: int32[]
        effectRoles: int32[]
        payloadCids: layout.FixedBytes32[]
        placementCids: layout.FixedBytes32[]
        projectedSnapshotSlotIds: int32[]

    # Defer relation stores only value-definition correspondence. Defer unit
    # rows are derived by scanning Intent unitKinds in canonical order; the
    # materialized payload CID is owned exclusively by Schedule.
    BodyIRDeferReplaySidecar =
        building: bool
        sealed: bool
        rootCid: layout.FixedBytes32
        templateOpMapStarts: int32[]
        templateOpMapCounts: int32[]
        templateOpRows: int32[]

    # Canonical ownership-effect sidecar for @manual_consume.  The callee
    # header proves its capture/replace contract; each call row binds exact
    # call/argument/place/value-definition coordinates and a single linear
    # token.  All repeated columns are SoA arrays in one dense call-row domain.
    BodyIRManualConsumeSidecar =
        sealed: bool
        functionPresent: bool
        functionRow: int32 = -1
        functionTargetParameterOrdinal: int32 = -1
        functionSourceParameterOrdinal: int32 = -1
        functionTargetSlotId: int32 = -1
        functionSourceSlotId: int32 = -1
        functionTargetTypeArenaTypeId: int32 = -1
        functionSourceTypeArenaTypeId: int32 = -1
        functionEffectCid: layout.FixedBytes32
        functionBodyProofCid: layout.FixedBytes32
        callOrdinals: int32[]
        snapshotCallIds: int32[]
        targetArgumentOrdinals: int32[]
        sourceArgumentOrdinals: int32[]
        targetPlaceSlotIds: int32[]
        targetOwnerSlotIds: int32[]
        sourcePlaceSlotIds: int32[]
        targetArgumentBindingCids: layout.FixedBytes32[]
        sourceArgumentBindingCids: layout.FixedBytes32[]
        targetProjectionCids: layout.FixedBytes32[]
        sourceProjectionCids: layout.FixedBytes32[]
        targetDefinitionDomains: int32[]
        targetDefinitionRows: int32[]
        sourceDefinitionDomains: int32[]
        sourceDefinitionRows: int32[]
        targetTypeArenaTypeIds: int32[]
        sourceTypeArenaTypeIds: int32[]
        postDefinitionDomains: int32[]
        postDefinitionRows: int32[]
        effectCids: layout.FixedBytes32[]
        linearTokenCids: layout.FixedBytes32[]
        bridgeCids: layout.FixedBytes32[]
        rootCid: layout.FixedBytes32

    # Exact managed Field/Indexed replacement authority.  Target/source value
    # identities are TypedExpr/BodyOp int32 rows; paths and descriptors are
    # frozen CSR projections of the canonical TypeArena artifact.
    BodyIRManagedLvalueReplaceSidecar =
        building: bool
        sealed: bool
        functionRow: int32 = -1
        typeArenaArtifactCid: layout.FixedBytes32
        callOrdinals: int32[]
        replaceOpRows: int32[]
        targetKinds: int32[]
        replaceModes: int32[]
        targetLvalueNodeIndexes: int32[]
        sourceValueNodeIndexes: int32[]
        targetRootDefinitionDomains: int32[]
        targetRootDefinitionRows: int32[]
        targetAddressSlotIds: int32[]
        targetAddressDefinitionRows: int32[]
        targetTypeIds: int32[]
        sourceDefinitionDomains: int32[]
        sourceDefinitionRows: int32[]
        sourceSlotIds: int32[]
        sourceSemanticRows: int32[]
        consumeActionRows: int32[]
        runtimeSemanticCids: layout.FixedBytes32[]
        pathStarts: int32[]
        pathCounts: int32[]
        pathKinds: int32[]
        pathProjectionNodeIndexes: int32[]
        pathParentTypeIds: int32[]
        pathIdentityKinds: int32[]
        pathIdentityRows: int32[]
        pathSelectorOrdinals: int32[]
        pathResultTypeIds: int32[]
        pathByteOffsets: int32[]
        pathByteWidths: int32[]
        pathIndexNodeIndexes: int32[]
        pathIndexDefinitionDomains: int32[]
        pathIndexDefinitionRows: int32[]
        dropGlueDescriptorRows: int32[]
        descriptorRootTypeIds: int32[]
        descriptorPayloads: str[]
        descriptorDigests: layout.FixedBytes32[]
        rootCid: layout.FixedBytes32

    BodyIRExternFfiHandleCallCapability =
        callOrdinal: int32 = -1
        semanticCapabilityCallRow: int32 = -1
        resolvedCallRow: int32 = -1
        snapshotCallId: int32 = -1
        semanticContractRow: int32 = -1
        snapshotContractRow: int32 = -1
        semanticEffectStart: int32 = -1
        effectCount: int32
        callCapabilityCid: layout.FixedBytes32
        contractCid: layout.FixedBytes32
        interfaceCid: layout.FixedBytes32
        callBridgeCid: layout.FixedBytes32

    BodyIRExternFfiHandleEffectCapability =
        semanticCapabilityEffectRow: int32 = -1
        contractEffectRow: int32 = -1
        snapshotEffectRow: int32 = -1
        snapshotEffectContractRow: int32 = -1
        effectKind: int32
        targetKind: int32
        parameterOrdinal: int32 = -1
        argumentRow: int32 = -1
        argumentSlotId: int32 = -1
        argumentValueNodeIndex: int32 = -1
        valueDefinitionRow: int32 = -1
        generationRootValueDefinitionRow: int32 = -1
        exactTypeId: int32 = -1
        carrierKind: int32
        argumentBindingCid: layout.FixedBytes32
        typeCid: layout.FixedBytes32
        generationCid: layout.FixedBytes32
        definitionLineageCid: layout.FixedBytes32
        effectCapabilityCid: layout.FixedBytes32
        contractEffectCid: layout.FixedBytes32
        effectBridgeCid: layout.FixedBytes32

    # Function-local immutable projection of the CompilerCSG/lowering
    # @ffi_handle capability bridge. Calls and effects are independent SoA
    # domains joined by effectStarts/effectCounts; every cross-node reference
    # is an exact int32 coordinate and every portable identity is a CID.
    BodyIRExternFfiHandleCapabilitySidecar =
        sealed: bool
        functionRow: int32 = -1
        snapshotProjectionAuthorityCid: layout.FixedBytes32
        semanticCargoCid: layout.FixedBytes32
        loweringBridgeCid: layout.FixedBytes32
        callOrdinals: int32[]
        callBodyOpRows: int32[]
        semanticCapabilityCallRows: int32[]
        resolvedCallRows: int32[]
        snapshotCallIds: int32[]
        semanticContractRows: int32[]
        snapshotContractRows: int32[]
        semanticEffectStarts: int32[]
        effectStarts: int32[]
        effectCounts: int32[]
        callCapabilityCids: layout.FixedBytes32[]
        contractCids: layout.FixedBytes32[]
        interfaceCids: layout.FixedBytes32[]
        callBridgeCids: layout.FixedBytes32[]
        semanticCapabilityEffectRows: int32[]
        contractEffectRows: int32[]
        snapshotEffectRows: int32[]
        snapshotEffectContractRows: int32[]
        effectKinds: int32[]
        targetKinds: int32[]
        parameterOrdinals: int32[]
        argumentRows: int32[]
        argumentSlotIds: int32[]
        argumentValueNodeIndexes: int32[]
        valueDefinitionRows: int32[]
        generationRootValueDefinitionRows: int32[]
        exactTypeIds: int32[]
        carrierKinds: int32[]
        argumentBindingCids: layout.FixedBytes32[]
        typeCids: layout.FixedBytes32[]
        generationCids: layout.FixedBytes32[]
        definitionLineageCids: layout.FixedBytes32[]
        effectCapabilityCids: layout.FixedBytes32[]
        contractEffectCids: layout.FixedBytes32[]
        effectBridgeCids: layout.FixedBytes32[]
        rootCid: layout.FixedBytes32

    # ExactDef 侧车列 (值域常量见 body_ir_exact_def.cheng; 列定义冻结于
    # docs/cheng-exact-def-rewrite-design.md §3.2)。全列一次落全。
    BodyIrExactDefSidecar =
        opPlaceKinds: int32[]              # C 9 值 place 域, dense op 行
        opExactTypeIds: int32[]            # TypeArena TypeId, -1 未证
        opOriginIds: int32[]               # 行域由 place 选定 (同 C 裁定)
        opProducerFunctionRows: int32[]
        opSourceDefOpRows: int32[]         # C op_source_value_def_op_id
        opReadADefOpRows: int32[]          # C op_exact_source_a_value_def_op_id
        slotPlaceKinds: int32[]            # dense 槽行
        slotOriginIds: int32[]
        slotStorageKinds: int32[]          # C 5 值 storage 域
        callArgStarts: int32[]             # call-arg CSR
        callArgCounts: int32[]
        argDefOpRows: int32[]
        argPlaceKinds: int32[]
        argOwnerships: int32[]
        argOriginIds: int32[]
        sealed: bool
        exactDefCid: layout.FixedBytes32

    BodyIR =
        ops: BodyOp[]
        callSequence: CallOp[]
        localSlots: LocalSlot[]
        # Immutable entry value-definition ownership, indexed by exact
        # LocalSlot row.  This is frozen once by lowering from semantic
        # ownership facts; LocalSlot.ownership remains mutable allocation
        # state and is never an authority for definition identity.
        entryDefinitionOwnershipSealed: bool
        entryDefinitionOwnershipKinds: int32[]
        entryDefinitionSemanticRows: int32[]
        # Immutable TypedExpr binding value-definition identity, indexed by
        # exact LocalSlot row. Lowering binds a row once before entry
        # definition ownership is frozen. Synthetic slots retain -1; no name,
        # source text, stack offset or object address participates in lookup.
        localBindingValueDefinitionDomainStart: int32
        localBindingValueDefinitionDomainCount: int32
        localBindingValueDefinitionRows: int32[]
        # Dense parameter-ordinal -> LocalSlot row authority. Lowering binds
        # each ordinal once while seeding entry slots; managed projections
        # never recover this identity by scanning stack offsets.
        entryParameterSlotIds: int32[]
        # Canonical TypedExprTypeArena artifact CID.  A numeric TypeId is
        # meaningful only inside this immutable receipt domain.
        typeArenaArtifactCid: layout.FixedBytes32
        # Function-used canonical TypeArena rows.  `typeFactTypeIds` is the
        # exact dense TypeArena coordinate; all remaining arrays are parallel
        # immutable facts copied from the CompilerCSG-sealed TypeArena domain.
        typeFactTypeIds: int32[]
        typeFactStructuralKinds: int32[]
        typeFactScalarKinds: int32[]
        typeFactChildTypeIds: int32[]
        typeFactFixedLengths: int32[]
        typeFactSizeBytes: int32[]
        typeFactAlignBytes: int32[]
        # b2: name->slot-index accelerator for PrimaryBodyIrFindOrCreate*/FindSlotIndex.
        # Byte-neutral: returned index is ALWAYS append-time slotNames.len (create) or a
        # position verified by slotNames[idx]==name (lookup) — the hash only accelerates the
        # find, never selects the index. The verify-on-hit is load-bearing: it replicates
        # first-match/shadowing (a renamed stale entry fails verify => treated as miss). Do
        # NOT drop that guard. Empty zero-value is a valid empty map (Put auto-inits).
        slotNameIndex: hashmaps.HashMapStrInt
        blocks: BodyBlock[]
        terms: BodyTerm[]
        cstringLiterals: CStringLiteralEntry[]
        # Immutable data-relocation identity. Local columns are indexed by
        # exact LocalSlot row; only BodyPlaceGlobalAddressTag rows may bind a
        # target. CString columns are indexed by exact literal row and bind
        # that row to the owning function-fragment CID. Text/dataLabel never
        # participate in identity.
        dataRelocationIdentitySealed: bool
        localAddressTargetDomainKinds: int32[]
        localAddressTargetRows: int32[]
        localAddressTargetCids: layout.FixedBytes32[]
        cstringTargetRows: int32[]
        cstringOwnerFunctionFragmentCids: layout.FixedBytes32[]
        # Sealed lowering-owned structured-control sidecar. All identities are
        # exact int32 rows in this BodyIR/function domain. Successors and defer
        # activations are CSR so one site can carry multiple transitions.
        controlFlowSealed: bool
        controlFunctionRow: int32 = -1
        controlScopeParentIds: int32[]
        blockScopeIds: int32[]
        termSuccessorStarts: int32[]
        termSuccessorCounts: int32[]
        successorBlockIds: int32[]
        successorEdgeKinds: int32[]
        # Exact semantic target identity for every CallOp while structured
        # control is sealed. Domain + row is the canonical local coordinate;
        # the CID is the portable interface identity. Linker spelling, source
        # path and object address never participate in target identity.
        callTargetDomainKinds: int32[]
        callTargetRows: int32[]
        callTargetInterfaceCids: layout.FixedBytes32[]
        deferDeclarationScopeIds: int32[]
        deferSuiteScopeIds: int32[]
        deferLexicalOrdinals: int32[]
        deferFunctionRows: int32[]
        deferStatementRows: int32[]
        deferActionCids: layout.FixedBytes32[]
        deferActivationSiteBlockIds: int32[]
        deferActivationSiteAfterOpOrdinals: int32[]
        deferActivationSiteStarts: int32[]
        deferActivationSiteCounts: int32[]
        deferActivationRows: int32[]
        # Externally supplied immutable projection over the exact TypeArena
        # and entry-definition ownership facts consumed by cleanup. It is
        # never derived from this BodyIR; zero means cleanup is not admitted.
        cleanupSourceProjectionCid: layout.FixedBytes32
        cleanupIntent: BodyIRCleanupIntentSidecar
        cleanupSchedule: BodyIRCleanupScheduleSidecar
        deferReplay: BodyIRDeferReplaySidecar
        manualConsume: BodyIRManualConsumeSidecar
        managedLvalueReplace: BodyIRManagedLvalueReplaceSidecar
        externFfiHandleCapabilities: BodyIRExternFfiHandleCapabilitySidecar
        # Function-local immutable debug provenance.  Cross-layer identities
        # are int32 indexes; no source text, line, or object address is an
        # identity key.  The four per-site columns are DOD/SoA sidecars and
        # must be complete whenever debugProvenanceRequired is true.
        debugProvenanceRequired: bool
        debugProvenanceComplete: bool
        debugFunctionId: int32 = -1
        debugOpIdsByOpIndex: int32[]
        debugSyntheticKindsByOpIndex: int32[]
        debugOpIdsByTermIndex: int32[]
        debugSyntheticKindsByTermIndex: int32[]
        debugCurrentOpId: int32 = -1
        debugCurrentSyntheticKind: int32
        # True only for a function whose entry symbol crosses an @exportc C ABI
        # boundary.  Backends use this semantic bit to admit a proven incoming
        # register-class bridge or reject the function before emission.
        entryIsCAbi: bool
        frameMetricsReady: bool
        frameStackByteCount: int32
        frameParamSaveCount: int32
        frameParamSaveOffset: int32
        frameReturnBufferSaveOffset: int32
        frameBytes: int32
        framePrologueWordCount: int32
        frameRestoreWordCount: int32
        # arm64 EmitObj size predictor REMOVED (single-pass收口): the op/term/block/call-reloc/
        # data-reloc/wordCount layout tables and the layoutMetricsReady flag are deleted. Production
        # arm64 layout/branch/reloc/buffer sizing are sourced emit-first from the real serial fill;
        # every former metricsReady fast-path now recomputes on demand via the *Raw size functions.
        # Only the peephole decision bitmaps below survive (frozen once in the arm64 prepare step,
        # read identically by the *Raw size cases AND the fillers => no two-pass desync possible).
        # Stage-0 register peephole: per-op bool, true => op[i] is a scalar-I64 BinOp
        # whose lhs slot == op[i-1]'s target slot (producer left it in X9), so the lhs
        # reload is redundant. Computed once with block context in
        # PrimaryBodyIrPrepareA64LayoutMetricsInPlace and read IDENTICALLY by both the
        # size predictor (PrimaryBodyIROpSizeAtRaw) and the filler (PrimaryBodyIRFillBinOp)
        # so the strict two-pass word counts can never desync.
        layoutLhsElide: bool[]
        # Stage-1 register peephole: per-op bool, true => op[i] is a scalar-I64 BinOp whose
        # target slot is a single-use temp whose ONLY reader is op[i+1]'s lhs (itself made
        # X9-resident via layoutLhsElide[i+1]). The store of op[i].target is therefore dead and
        # is dropped in the filler. Computed once alongside layoutLhsElide and read IDENTICALLY
        # by the size predictor and the filler — same two-pass-symmetry contract.
        layoutStoreElide: bool[]
        # Stage-1 register peephole (copy-consumer variant): per-op bool, true => op[i] is a
        # plain I64->I64 CopyLocal/StoreLocal whose source is a single-use temp produced by the
        # immediately preceding op[i-1] (a BinOp whose store was store-elided, leaving the value
        # in X9). The copy's source reload is therefore redundant — it reads straight from X9 —
        # and is dropped. Same two-pass-symmetry contract as layoutLhsElide/layoutStoreElide.
        layoutCopySrcElide: bool[]
        # Stage10 Cmp->Cbr fusion: per-op (op index space) arm64 true cond code when op[i] is a
        # Cmp whose materialized bool is single-use and consumed ONLY by the block's terminating
        # Cbr (conditionKind LocalNonZero, lhsSlot == op[i].target, rhsSlot < 0), AND op[i] is the
        # block's LAST op (adjacent to the term => NZCV still live). Then the cset+bool-store are
        # dropped (Cmp size 5->3, just lhs/rhs load + cmp) and the Cbr branches straight from the
        # compare flags. -1 = not fused (current cset+store behavior). The companion per-term flag
        # layoutCbrFuse holds the SAME cond code for the consuming Cbr; both are computed ONCE in
        # PrimaryBodyIrPrepareA64LayoutMetricsInPlace and read IDENTICALLY by the Cmp *Raw size case,
        # the Cbr *Raw size case, and both fillers — so the on-demand recomputed sizes and the fill
        # stay in lockstep with no predictor cache between them.
        layoutCmpFuse: int32[]
        # Stage10 Cmp->Cbr fusion (terminator side): per-term arm64 true cond code when the term
        # is the fused Cbr; -1 otherwise. Fused Cbr size drops to 2 (b.<cond>; b) with no bool
        # ldr/cmp#0 round-trip. Mirrors layoutCmpFuse on the term-index space.
        layoutCbrFuse: int32[]
        # Frozen x86-64 stack-layout carrier. Production preparation computes
        # slot-read counts and block prefix offsets once, then publishes the
        # ready flags. Readers hard-fail unless the exact frozen tables are
        # ready; no query-side planning or recomputation exists.
        x64StackLayoutReady: bool
        x64SlotReadCnt: int32[]
        x64BlockStartReady: bool
        x64BlockByteStart: int32[]
        # ExactDef 侧车 (批 1): C 冷链 exact-authority 九值 place / 五值 storage
        # 域在物理 BodyIR 上的 SoA 投影。op/slot 列按 dense 行索引, call-arg
        # 列是 CSR; 身份一律 int32 行 (op 行/槽行/TypeArena TypeId/函数行),
        # 无文本/名字/裸指针键。规范推导器 exact_def_derive 单遍落戳,
        # BodyIrExactDefSidecarSealInto 冻结 CID。sealed=false 且全列空 =
        # canonical empty (旧 BodyIR 合法态)。
        exactDef: BodyIrExactDefSidecar

    BodyIRFlatSoA =
        typeArenaArtifactCid: layout.FixedBytes32
        managedReplaceBuilding: bool
        managedReplaceSealed: bool
        managedReplaceFunctionRow: int32 = -1
        managedReplaceTypeArenaArtifactCid: layout.FixedBytes32
        managedReplaceRootCid: layout.FixedBytes32
        managedReplaceCallOrdinals: int32[]
        managedReplaceOpRows: int32[]
        managedReplaceTargetKinds: int32[]
        managedReplaceModes: int32[]
        managedReplaceTargetLvalueNodeIndexes: int32[]
        managedReplaceSourceValueNodeIndexes: int32[]
        managedReplaceTargetRootDefinitionDomains: int32[]
        managedReplaceTargetRootDefinitionRows: int32[]
        managedReplaceTargetAddressSlotIds: int32[]
        managedReplaceTargetAddressDefinitionRows: int32[]
        managedReplaceTargetTypeIds: int32[]
        managedReplaceSourceDefinitionDomains: int32[]
        managedReplaceSourceDefinitionRows: int32[]
        managedReplaceSourceSlotIds: int32[]
        managedReplaceSourceSemanticRows: int32[]
        managedReplaceConsumeActionRows: int32[]
        managedReplaceRuntimeSemanticCids: layout.FixedBytes32[]
        managedReplacePathStarts: int32[]
        managedReplacePathCounts: int32[]
        managedReplacePathKinds: int32[]
        managedReplacePathProjectionNodeIndexes: int32[]
        managedReplacePathParentTypeIds: int32[]
        managedReplacePathIdentityKinds: int32[]
        managedReplacePathIdentityRows: int32[]
        managedReplacePathSelectorOrdinals: int32[]
        managedReplacePathResultTypeIds: int32[]
        managedReplacePathByteOffsets: int32[]
        managedReplacePathByteWidths: int32[]
        managedReplacePathIndexNodeIndexes: int32[]
        managedReplacePathIndexDefinitionDomains: int32[]
        managedReplacePathIndexDefinitionRows: int32[]
        managedReplaceDropGlueDescriptorRows: int32[]
        managedReplaceDescriptorRootTypeIds: int32[]
        managedReplaceDescriptorPayloads: str[]
        managedReplaceDescriptorDigests: layout.FixedBytes32[]
        entryDefinitionOwnershipSealed: bool
        entryDefinitionOwnershipKinds: int32[]
        entryDefinitionSemanticRows: int32[]
        localBindingValueDefinitionDomainStart: int32
        localBindingValueDefinitionDomainCount: int32
        localBindingValueDefinitionRows: int32[]
        entryParameterSlotIds: int32[]
        typeFactTypeIds: int32[]
        typeFactStructuralKinds: int32[]
        typeFactScalarKinds: int32[]
        typeFactChildTypeIds: int32[]
        typeFactFixedLengths: int32[]
        typeFactSizeBytes: int32[]
        typeFactAlignBytes: int32[]
        opKinds: int32[]
        opTargets: int32[]
        opOperandStarts: int32[]
        opOperandCounts: int32[]
        opValueDefSlots: int32[]
        opValueDefExprNodeIndexes: int32[]
        opValueDefSemanticRows: int32[]
        opValueDefOwnershipKinds: int32[]
        opValueDefBorrowOwnerSemanticRows: int32[]
        opValueDefBorrowOwnerDefinitionDomains: int32[]
        opValueDefBorrowOwnerDefinitionRows: int32[]
        opValueDefConsumeOpIndexPlusOnes: int32[]
        opValueDefOriginKinds: int32[]
        opValueDefOriginIds: int32[]
        opSourceDefinitionDomains: int32[]
        opSourceDefinitionRows: int32[]
        opConsumeActionRows: int32[]
        operands: int32[]
        callTargetSymbols: str[]
        callResultSlots: int32[]
        callResultPassKinds: int32[]
        callResultOwnershipKinds: int32[]
        callResultExprNodeIndexes: int32[]
        callResultValueDefinitionRows: int32[]
        callResultBorrowOwnerValueDefinitionRows: int32[]
        callResultBorrowOwnerDefinitionDomains: int32[]
        callResultBorrowOwnerDefinitionRows: int32[]
        callResultDefinitionOriginKinds: int32[]
        callResultDefinitionOriginIds: int32[]
        callSourceDefinitionDomains: int32[]
        callSourceDefinitionRows: int32[]
        callSemanticCallExprNodeIndexes: int32[]
        callConsumeActionRows: int32[]
        callManagedStoreKinds: int32[]
        callManagedReplaceReceiptRows: int32[]
        callManagedDropGlueDescriptorRows: int32[]
        callRelocWordOffsets: int32[]
        callArgStarts: int32[]
        callArgCounts: int32[]
        callArgSlots: int32[]
        callArgPassKinds: int32[]
        localIds: int32[]
        localTypeKinds: int32[]
        localTypeArenaTypeIds: int32[]
        localManagedStorageKinds: int32[]
        localPlaceKinds: int32[]
        localStackOffsets: int32[]
        localSizeBytes: int32[]
        localAlignBytes: int32[]
        localAuxValues: int32[]
        localOwnershipKinds: int32[]
        localAliasClasses: int32[]
        localEscapeKinds: int32[]
        localNoAliasFlags: int32[]
        blockIds: int32[]
        blockOpStarts: int32[]
        blockOpCounts: int32[]
        blockTermIndices: int32[]
        termKinds: int32[]
        termCondKinds: int32[]
        termResultSlots: int32[]
        termSourceDefinitionDomains: int32[]
        termSourceDefinitionRows: int32[]
        termLhsSlots: int32[]
        termRhsSlots: int32[]
        termTrueBlocks: int32[]
        termFalseBlocks: int32[]
        termOperandStarts: int32[]
        termOperandCounts: int32[]
        termOperands: int32[]
        cstringIds: int32[]
        cstringTexts: str[]
        cstringDataLabels: str[]

    # Function-lifetime reverse projection of the immutable BodyIR binding
    # column. It is never encoded or retained by BodyIR. Each LocalSlot row is
    # consumed at most once, so construction and validation are O(D + L) and
    # every indexed-place lookup is O(1).
    BodyIRLocalBindingValueDefinitionProjection =
        definitionRowStart: int32
        definitionRowCount: int32
        projectedSlotCount: int32
        slotIdsByDefinitionRows: int32[]

    BodyIRPhaseArena =
        generation: int32
        resetCount: int32
        reserveCount: int32
        capacityBytes: int64
        usedBytes: int64
