@borrows
fn bodyIRDataRelocationTargetCidValid(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

fn bodyIRDataRelocationTargetDomainValid(domainKind: int32): bool =
    return domainKind == BodyDataRelocTargetDomainTypedGlobalTag ||
           domainKind == BodyDataRelocTargetDomainFunctionTag

@borrows
fn bodyIRDataRelocationIdentityRowsValid(bodyIR: BodyIR): bool =
    if bodyIR.localAddressTargetDomainKinds.len !=
           bodyIR.localSlots.len ||
       bodyIR.localAddressTargetRows.len != bodyIR.localSlots.len ||
       bodyIR.localAddressTargetCids.len != bodyIR.localSlots.len ||
       bodyIR.cstringTargetRows.len != bodyIR.cstringLiterals.len ||
       bodyIR.cstringOwnerFunctionFragmentCids.len !=
           bodyIR.cstringLiterals.len:
        return false
    for slotId in 0..<bodyIR.localSlots.len:
        let domainKind = bodyIR.localAddressTargetDomainKinds[slotId]
        let targetRow = bodyIR.localAddressTargetRows[slotId]
        let targetCid = bodyIR.localAddressTargetCids[slotId]
        if bodyIR.localSlots[slotId].placeKind ==
               BodyPlaceGlobalAddressTag:
            if !bodyIRDataRelocationTargetDomainValid(domainKind) ||
               targetRow < 0 ||
               !bodyIRDataRelocationTargetCidValid(targetCid):
                return false
        elif domainKind != BodyDataRelocTargetDomainInvalidTag ||
             targetRow != -1 ||
             bodyIRDataRelocationTargetCidValid(targetCid):
            return false
    for literalRow in 0..<bodyIR.cstringLiterals.len:
        if bodyIR.cstringLiterals[literalRow].id != literalRow ||
           bodyIR.cstringTargetRows[literalRow] != literalRow ||
           !bodyIRDataRelocationTargetCidValid(
               bodyIR.cstringOwnerFunctionFragmentCids[literalRow]):
            return false
    return true

@borrows
fn BodyIRDataRelocationIdentityStrictValidate(
        bodyIR: BodyIR): bool =
    if !bodyIR.dataRelocationIdentitySealed:
        if bodyIR.localAddressTargetDomainKinds.len != 0 ||
           bodyIR.localAddressTargetRows.len != 0 ||
           bodyIR.localAddressTargetCids.len != 0 ||
           bodyIR.cstringTargetRows.len != 0 ||
           bodyIR.cstringOwnerFunctionFragmentCids.len != 0 ||
           bodyIR.cstringLiterals.len != 0:
            return false
        for slotId in 0..<bodyIR.localSlots.len:
            if bodyIR.localSlots[slotId].placeKind ==
                   BodyPlaceGlobalAddressTag:
                return false
        return true
    return bodyIRDataRelocationIdentityRowsValid(bodyIR)

fn BodyIRDataRelocationIdentitySync(bodyIR: var BodyIR) =
    if bodyIR.dataRelocationIdentitySealed ||
       bodyIR.localAddressTargetDomainKinds.len !=
           bodyIR.localAddressTargetRows.len ||
       bodyIR.localAddressTargetDomainKinds.len !=
           bodyIR.localAddressTargetCids.len ||
       bodyIR.localAddressTargetDomainKinds.len >
           bodyIR.localSlots.len ||
       bodyIR.cstringTargetRows.len !=
           bodyIR.cstringOwnerFunctionFragmentCids.len ||
       bodyIR.cstringTargetRows.len > bodyIR.cstringLiterals.len:
        panic("body ir data relocation identity: sync state invalid")
    for _ in bodyIR.localAddressTargetDomainKinds.len..<
            bodyIR.localSlots.len:
        add(bodyIR.localAddressTargetDomainKinds,
            BodyDataRelocTargetDomainInvalidTag)
        add(bodyIR.localAddressTargetRows, -1)
        add(bodyIR.localAddressTargetCids, layout.FixedBytes32())
    for _ in bodyIR.cstringTargetRows.len..<
            bodyIR.cstringLiterals.len:
        add(bodyIR.cstringTargetRows, -1)
        add(bodyIR.cstringOwnerFunctionFragmentCids,
            layout.FixedBytes32())

fn BodyIRBindLocalAddressTarget(
        bodyIR: var BodyIR,
        slotId: int32,
        targetDomainKind: int32,
        targetRow: int32,
        targetCid: layout.FixedBytes32) =
    if bodyIR.dataRelocationIdentitySealed ||
       slotId < 0 || slotId >= bodyIR.localSlots.len ||
       bodyIR.localSlots[slotId].placeKind !=
           BodyPlaceGlobalAddressTag ||
       !bodyIRDataRelocationTargetDomainValid(targetDomainKind) ||
       targetRow < 0 ||
       !bodyIRDataRelocationTargetCidValid(targetCid):
        panic("body ir data relocation identity: local bind invalid")
    BodyIRDataRelocationIdentitySync(bodyIR)
    let currentDomain =
        bodyIR.localAddressTargetDomainKinds[slotId]
    let currentRow = bodyIR.localAddressTargetRows[slotId]
    let currentCid = bodyIR.localAddressTargetCids[slotId]
    if currentDomain == targetDomainKind && currentRow == targetRow &&
       layout.FixedBytes32Equal(currentCid, targetCid):
        return
    if currentDomain != BodyDataRelocTargetDomainInvalidTag ||
       currentRow != -1 ||
       bodyIRDataRelocationTargetCidValid(currentCid):
        panic("body ir data relocation identity: local target rebound")
    bodyIR.localAddressTargetDomainKinds[slotId] = targetDomainKind
    bodyIR.localAddressTargetRows[slotId] = targetRow
    bodyIR.localAddressTargetCids[slotId] =
        layout.FixedBytes32Copy(targetCid)

fn BodyIRBindCStringTarget(
        bodyIR: var BodyIR,
        literalRow: int32,
        ownerFunctionFragmentCid: layout.FixedBytes32) =
    if bodyIR.dataRelocationIdentitySealed ||
       literalRow < 0 || literalRow >= bodyIR.cstringLiterals.len ||
       bodyIR.cstringLiterals[literalRow].id != literalRow ||
       !bodyIRDataRelocationTargetCidValid(ownerFunctionFragmentCid):
        panic("body ir data relocation identity: cstring bind invalid")
    BodyIRDataRelocationIdentitySync(bodyIR)
    let currentRow = bodyIR.cstringTargetRows[literalRow]
    let currentCid =
        bodyIR.cstringOwnerFunctionFragmentCids[literalRow]
    if currentRow == literalRow &&
       layout.FixedBytes32Equal(currentCid, ownerFunctionFragmentCid):
        return
    if currentRow != -1 ||
       bodyIRDataRelocationTargetCidValid(currentCid):
        panic("body ir data relocation identity: cstring target rebound")
    bodyIR.cstringTargetRows[literalRow] = literalRow
    bodyIR.cstringOwnerFunctionFragmentCids[literalRow] =
        layout.FixedBytes32Copy(ownerFunctionFragmentCid)

fn BodyIRSealDataRelocationIdentity(bodyIR: var BodyIR) =
    if bodyIR.dataRelocationIdentitySealed:
        panic("body ir data relocation identity: already sealed")
    BodyIRDataRelocationIdentitySync(bodyIR)
    if !bodyIRDataRelocationIdentityRowsValid(bodyIR):
        panic("body ir data relocation identity: incomplete")
    bodyIR.dataRelocationIdentitySealed = true
    if !BodyIRDataRelocationIdentityStrictValidate(bodyIR):
        panic("body ir data relocation identity: sealed shape invalid")

@borrows
fn BodyIRLocalBindingValueDefinitionRowsShapeValid(
        bodyIR: BodyIR): bool =
    if bodyIR.localBindingValueDefinitionDomainStart < 0 ||
       bodyIR.localBindingValueDefinitionDomainCount < 0 ||
       bodyIR.localBindingValueDefinitionDomainStart >
           2147483647 -
               bodyIR.localBindingValueDefinitionDomainCount:
        return false
    let rowCount = bodyIR.localBindingValueDefinitionRows.len
    if bodyIR.entryDefinitionOwnershipSealed:
        if rowCount != bodyIR.localSlots.len:
            return false
    elif rowCount != 0 && rowCount != bodyIR.localSlots.len:
        return false
    var slotIdsByDefinitionRows: int32[]
    setLen(slotIdsByDefinitionRows,
           bodyIR.localBindingValueDefinitionDomainCount)
    for definitionRow in 0..<slotIdsByDefinitionRows.len:
        slotIdsByDefinitionRows[definitionRow] = -1
    for slotId in 0..<rowCount:
        let definitionRow =
            bodyIR.localBindingValueDefinitionRows[slotId]
        if definitionRow < -1 ||
           (definitionRow >= 0 &&
            (definitionRow <
                 bodyIR.localBindingValueDefinitionDomainStart ||
             definitionRow -
                 bodyIR.localBindingValueDefinitionDomainStart >=
                 bodyIR.localBindingValueDefinitionDomainCount)):
            return false
        if definitionRow < 0:
            continue
        let domainRow = definitionRow -
            bodyIR.localBindingValueDefinitionDomainStart
        if slotIdsByDefinitionRows[domainRow] >= 0:
            return false
        slotIdsByDefinitionRows[domainRow] = slotId
    return true

fn BodyIRBindLocalBindingValueDefinitionDomain(
        bodyIR: var BodyIR,
        definitionRowStart: int32,
        definitionRowCount: int32) =
    if definitionRowStart < 0 || definitionRowCount < 0 ||
       definitionRowStart > 2147483647 - definitionRowCount ||
       bodyIR.localSlots.len != 0 ||
       bodyIR.localBindingValueDefinitionRows.len != 0 ||
       bodyIR.entryDefinitionOwnershipSealed ||
       bodyIR.controlFlowSealed ||
       ((bodyIR.localBindingValueDefinitionDomainStart != 0 ||
         bodyIR.localBindingValueDefinitionDomainCount != 0) &&
        (bodyIR.localBindingValueDefinitionDomainStart !=
             definitionRowStart ||
         bodyIR.localBindingValueDefinitionDomainCount !=
             definitionRowCount)):
        panic("body ir local binding definition: domain bind invalid")
    bodyIR.localBindingValueDefinitionDomainStart = definitionRowStart
    bodyIR.localBindingValueDefinitionDomainCount = definitionRowCount

@borrows
fn BodyIRLocalBindingValueDefinitionProjectionNew(
        bodyIR: BodyIR): BodyIRLocalBindingValueDefinitionProjection =
    if bodyIR.localBindingValueDefinitionDomainStart < 0 ||
       bodyIR.localBindingValueDefinitionDomainCount < 0 ||
       bodyIR.localBindingValueDefinitionDomainStart >
           2147483647 -
               bodyIR.localBindingValueDefinitionDomainCount:
        panic("body ir local binding definition: projection domain invalid")
    var out: BodyIRLocalBindingValueDefinitionProjection
    out.definitionRowStart =
        bodyIR.localBindingValueDefinitionDomainStart
    out.definitionRowCount =
        bodyIR.localBindingValueDefinitionDomainCount
    setLen(out.slotIdsByDefinitionRows, out.definitionRowCount)
    for definitionRow in 0..<out.definitionRowCount:
        out.slotIdsByDefinitionRows[definitionRow] = -1
    return out

@borrows
fn BodyIRLocalBindingValueDefinitionProjectionSync(
        bodyIR: BodyIR,
        projection: var BodyIRLocalBindingValueDefinitionProjection) =
    if projection.definitionRowStart !=
           bodyIR.localBindingValueDefinitionDomainStart ||
       projection.definitionRowCount !=
           bodyIR.localBindingValueDefinitionDomainCount ||
       projection.slotIdsByDefinitionRows.len !=
           projection.definitionRowCount ||
       projection.projectedSlotCount < 0 ||
       projection.projectedSlotCount > bodyIR.localSlots.len ||
       bodyIR.localBindingValueDefinitionRows.len !=
           bodyIR.localSlots.len:
        panic("body ir local binding definition: projection shape invalid")
    for slotId in projection.projectedSlotCount..<bodyIR.localSlots.len:
        let definitionRow =
            bodyIR.localBindingValueDefinitionRows[slotId]
        if definitionRow < -1 ||
           (definitionRow >= 0 &&
            (definitionRow < projection.definitionRowStart ||
             definitionRow - projection.definitionRowStart >=
                 projection.definitionRowCount)):
            panic("body ir local binding definition: projected row invalid")
        if definitionRow >= 0:
            let domainRow =
                definitionRow - projection.definitionRowStart
            if projection.slotIdsByDefinitionRows[domainRow] >= 0:
                panic("body ir local binding definition: projected row duplicate")
            projection.slotIdsByDefinitionRows[domainRow] = slotId
    projection.projectedSlotCount = bodyIR.localSlots.len

fn BodyIRAppendUnboundLocalBindingValueDefinitionRow(
        bodyIR: var BodyIR,
        slotId: int32) =
    if bodyIR.entryDefinitionOwnershipSealed ||
       bodyIR.controlFlowSealed || slotId < 0 ||
       slotId != bodyIR.localSlots.len - 1 ||
       bodyIR.localBindingValueDefinitionRows.len != slotId:
        panic("body ir local binding definition: append state invalid")
    add(bodyIR.localBindingValueDefinitionRows, -1)

fn BodyIRBindLocalBindingValueDefinitionRow(
        bodyIR: var BodyIR,
        projection: var BodyIRLocalBindingValueDefinitionProjection,
        slotId: int32,
        definitionRow: int32) =
    if bodyIR.entryDefinitionOwnershipSealed ||
       bodyIR.controlFlowSealed || definitionRow < 0 ||
       slotId < 0 || slotId >= bodyIR.localSlots.len ||
       bodyIR.localBindingValueDefinitionRows.len !=
           bodyIR.localSlots.len ||
       definitionRow <
           bodyIR.localBindingValueDefinitionDomainStart ||
       definitionRow -
           bodyIR.localBindingValueDefinitionDomainStart >=
           bodyIR.localBindingValueDefinitionDomainCount:
        panic("body ir local binding definition: bind state invalid")
    BodyIRLocalBindingValueDefinitionProjectionSync(
        bodyIR, projection)
    if bodyIR.localBindingValueDefinitionRows[slotId] == definitionRow:
        let domainRow = definitionRow - projection.definitionRowStart
        if projection.slotIdsByDefinitionRows[domainRow] != slotId:
            panic("body ir local binding definition: idempotent projection drift")
        return
    if bodyIR.localBindingValueDefinitionRows[slotId] != -1:
        panic("body ir local binding definition: slot rebound")
    let domainRow = definitionRow - projection.definitionRowStart
    if projection.slotIdsByDefinitionRows[domainRow] >= 0:
        panic("body ir local binding definition: duplicate definition row")
    bodyIR.localBindingValueDefinitionRows[slotId] = definitionRow
    projection.slotIdsByDefinitionRows[domainRow] = slotId

@borrows
fn BodyIRLocalSlotForBindingValueDefinitionRow(
        bodyIR: BodyIR,
        projection: BodyIRLocalBindingValueDefinitionProjection,
        definitionRow: int32): int32 =
    if definitionRow < projection.definitionRowStart ||
       definitionRow - projection.definitionRowStart >=
           projection.definitionRowCount ||
       projection.definitionRowStart !=
           bodyIR.localBindingValueDefinitionDomainStart ||
       projection.definitionRowCount !=
           bodyIR.localBindingValueDefinitionDomainCount ||
       projection.slotIdsByDefinitionRows.len !=
           projection.definitionRowCount ||
       projection.projectedSlotCount != bodyIR.localSlots.len:
        return -1
    let slotId = projection.slotIdsByDefinitionRows[
        definitionRow - projection.definitionRowStart]
    if slotId < 0 || slotId >= bodyIR.localSlots.len ||
       bodyIR.localBindingValueDefinitionRows[slotId] != definitionRow:
        return -1
    return slotId

@borrows
fn BodyIREntryDefinitionOwnershipShapeValid(
        bodyIR: BodyIR): bool =
    if !bodyIR.entryDefinitionOwnershipSealed:
        return bodyIR.entryDefinitionOwnershipKinds.len == 0 &&
               bodyIR.entryDefinitionSemanticRows.len == 0
    if bodyIR.entryDefinitionOwnershipKinds.len !=
           bodyIR.localSlots.len ||
       bodyIR.entryDefinitionSemanticRows.len !=
           bodyIR.localSlots.len:
        return false
    for row in 0..<bodyIR.entryDefinitionOwnershipKinds.len:
        let kind = bodyIR.entryDefinitionOwnershipKinds[row]
        if kind < int32(OwnInvalid) ||
           kind > int32(OwnBorrowUnique):
            return false
        if (kind == int32(OwnInvalid) ||
            kind == int32(OwnPlain)) &&
           bodyIR.entryDefinitionSemanticRows[row] != -1:
            return false
        if kind != int32(OwnInvalid) &&
           kind != int32(OwnPlain) &&
           bodyIR.entryDefinitionSemanticRows[row] < -1:
            return false
    return true

fn BodyIRFreezeEntryDefinitionOwnershipKinds(
        bodyIR: var BodyIR,
        ownershipKinds: var int32[]) =
    if bodyIR.entryDefinitionOwnershipSealed ||
       bodyIR.entryDefinitionOwnershipKinds.len != 0 ||
       bodyIR.entryDefinitionOwnershipKinds.cap != 0 ||
       bodyIR.entryDefinitionSemanticRows.len != 0 ||
       bodyIR.entryDefinitionSemanticRows.cap != 0 ||
       bodyIR.manualConsume.sealed ||
       ownershipKinds.len != bodyIR.localSlots.len:
        panic("body ir entry definition ownership: freeze state invalid")
    if bodyIR.localBindingValueDefinitionRows.len == 0:
        for _ in 0..<bodyIR.localSlots.len:
            add(bodyIR.localBindingValueDefinitionRows, -1)
    if !BodyIRLocalBindingValueDefinitionRowsShapeValid(bodyIR) ||
       bodyIR.localBindingValueDefinitionRows.len !=
           bodyIR.localSlots.len:
        panic("body ir local binding definition: freeze shape invalid")
    if bodyIR.controlFlowSealed &&
       !BodyIRControlFlowShapeValid(bodyIR):
        panic("body ir entry definition ownership: sealed control flow invalid")
    for row in 0..<ownershipKinds.len:
        if ownershipKinds[row] < int32(OwnInvalid) ||
           ownershipKinds[row] > int32(OwnBorrowUnique):
            panic("body ir entry definition ownership: kind invalid")
    for row in 0..<ownershipKinds.len:
        add(bodyIR.entryDefinitionOwnershipKinds,
            ownershipKinds[row])
        add(bodyIR.entryDefinitionSemanticRows, -1)
    bodyIR.entryDefinitionOwnershipSealed = true
    if !BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        panic("body ir entry definition ownership: frozen shape invalid")

fn BodyIRFreezeEntryDefinitionAuthority(
        bodyIR: var BodyIR,
        ownershipKinds: var int32[],
        semanticRows: var int32[]) =
    if semanticRows.len != ownershipKinds.len:
        panic("body ir entry definition authority: shape invalid")
    BodyIRFreezeEntryDefinitionOwnershipKinds(
        bodyIR, ownershipKinds)
    for row in 0..<semanticRows.len:
        let kind = bodyIR.entryDefinitionOwnershipKinds[row]
        if kind == int32(OwnInvalid) || kind == int32(OwnPlain):
            if semanticRows[row] != -1:
                panic("body ir entry definition authority: unmanaged semantic row")
        elif semanticRows[row] < 0:
            panic("body ir entry definition authority: managed semantic row missing")
        bodyIR.entryDefinitionSemanticRows[row] = semanticRows[row]
    if !BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        panic("body ir entry definition authority: frozen shape invalid")

fn BodyIREntryDefinitionOwnershipAppendSyntheticSlot(
        bodyIR: var BodyIR,
        slotId: int32) =
    if !bodyIR.entryDefinitionOwnershipSealed ||
       slotId < 0 || slotId != bodyIR.localSlots.len - 1 ||
       bodyIR.entryDefinitionOwnershipKinds.len != slotId ||
       bodyIR.entryDefinitionSemanticRows.len != slotId ||
       bodyIR.localBindingValueDefinitionRows.len != slotId:
        panic(
            "body ir entry definition ownership: synthetic slot row invalid")
    add(bodyIR.entryDefinitionOwnershipKinds, int32(OwnInvalid))
    add(bodyIR.entryDefinitionSemanticRows, -1)
    add(bodyIR.localBindingValueDefinitionRows, -1)
    if !BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        panic(
            "body ir entry definition ownership: synthetic slot shape invalid")

fn BodyIRBindEntryParameterSlot(
        bodyIR: var BodyIR,
        parameterOrdinal: int32,
        slotId: int32) =
    if bodyIR.controlFlowSealed || parameterOrdinal < 0 ||
       slotId < 0 || slotId >= bodyIR.localSlots.len ||
       bodyIR.localSlots[slotId].stackOffset !=
           0 - 1 - parameterOrdinal:
        panic("body ir entry parameter: authority invalid")
    while bodyIR.entryParameterSlotIds.len <= parameterOrdinal:
        add(bodyIR.entryParameterSlotIds, -1)
    if bodyIR.entryParameterSlotIds[parameterOrdinal] >= 0:
        panic("body ir entry parameter: duplicate ordinal")
    bodyIR.entryParameterSlotIds[parameterOrdinal] = slotId

@borrows
fn BodyIREntryParameterSlotsShapeValid(bodyIR: BodyIR): bool =
    var mappedCount: int32
    for parameterOrdinal in 0..<bodyIR.entryParameterSlotIds.len:
        let slotId = bodyIR.entryParameterSlotIds[parameterOrdinal]
        if slotId < 0 || slotId >= bodyIR.localSlots.len ||
           bodyIR.localSlots[slotId].stackOffset !=
               0 - 1 - parameterOrdinal:
            return false
        mappedCount = mappedCount + 1
    var physicalCount: int32
    for slotId in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[slotId].stackOffset >= 0:
            continue
        let parameterOrdinal =
            0 - 1 - bodyIR.localSlots[slotId].stackOffset
        if parameterOrdinal < 0 ||
           parameterOrdinal >= bodyIR.entryParameterSlotIds.len ||
           bodyIR.entryParameterSlotIds[parameterOrdinal] != slotId:
            return false
        physicalCount = physicalCount + 1
    return mappedCount == physicalCount

fn BodyIRControlEdgeKindValid(kind: int32): bool =
    return kind >= BodyControlEdgeNormal &&
           kind <= BodyControlEdgeLoopBack

@borrows
fn bodyIRControlActionAppendI32(buf: var layout.ByteBuf,
                               value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn bodyIRControlActionAppendText(buf: var layout.ByteBuf,
                                value: str) =
    bodyIRControlActionAppendI32(buf, len(value))
    for index in 0..<len(value):
        layout.ByteBufAppendByte(buf, Int32(value[index]) & 255)

@borrows
fn bodyIRControlScopeDescendsFrom(bodyIR: BodyIR,
                                  scopeId: int32,
                                  ancestorScopeId: int32): bool =
    if scopeId < 0 || scopeId >= bodyIR.controlScopeParentIds.len ||
       ancestorScopeId < 0 ||
       ancestorScopeId >= bodyIR.controlScopeParentIds.len:
        return false
    var current = scopeId
    while current >= 0:
        if current == ancestorScopeId:
            return true
        current = bodyIR.controlScopeParentIds[current]
    return false

@borrows
fn bodyIRControlActionBlockOrdinal(bodyIR: BodyIR,
                                   suiteScopeId: int32,
                                   blockId: int32): int32 =
    var ordinal: int32
    for candidateBlockId in 0..<bodyIR.blocks.len:
        if bodyIRControlScopeDescendsFrom(
               bodyIR, bodyIR.blockScopeIds[candidateBlockId],
               suiteScopeId):
            if candidateBlockId == blockId:
                return ordinal
            ordinal = ordinal + 1
    return -1

@borrows
fn BodyIRControlFlowBlockInDeferAction(
        bodyIR: BodyIR,
        deferId: int32,
        blockId: int32): bool =
    return deferId >= 0 &&
           deferId < bodyIR.deferSuiteScopeIds.len &&
           blockId >= 0 && blockId < bodyIR.blocks.len &&
           bodyIR.blockScopeIds.len == bodyIR.blocks.len &&
           bodyIRControlScopeDescendsFrom(
               bodyIR, bodyIR.blockScopeIds[blockId],
               bodyIR.deferSuiteScopeIds[deferId])

@borrows
fn BodyIRControlFlowDeferActionCid(
        bodyIR: BodyIR,
        deferId: int32): layout.FixedBytes32 =
    if deferId < 0 ||
       deferId >= bodyIR.deferDeclarationScopeIds.len ||
       deferId >= bodyIR.deferSuiteScopeIds.len ||
       deferId >= bodyIR.deferLexicalOrdinals.len ||
       deferId >= bodyIR.deferFunctionRows.len ||
       deferId >= bodyIR.deferStatementRows.len ||
       bodyIR.blockScopeIds.len != bodyIR.blocks.len ||
       bodyIR.termSuccessorStarts.len != bodyIR.terms.len ||
       bodyIR.termSuccessorCounts.len != bodyIR.terms.len ||
       bodyIR.callTargetDomainKinds.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetRows.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetInterfaceCids.len !=
           bodyIR.callSequence.len ||
       !BodyIRTypeArenaProofDomainValid(bodyIR):
        return layout.FixedBytes32()
    let suiteScopeId = bodyIR.deferSuiteScopeIds[deferId]
    var actionBlockCount: int32
    var localSeen: bool[]
    var callSeen: bool[]
    var cstringSeen: bool[]
    var typeFactSeen: bool[]
    for _ in 0..<bodyIR.localSlots.len:
        add(localSeen, false)
    for _ in 0..<bodyIR.callSequence.len:
        add(callSeen, false)
    for _ in 0..<bodyIR.cstringLiterals.len:
        add(cstringSeen, false)
    for _ in 0..<bodyIR.typeFactTypeIds.len:
        add(typeFactSeen, false)
    for blockId in 0..<bodyIR.blocks.len:
        if bodyIRControlScopeDescendsFrom(
               bodyIR, bodyIR.blockScopeIds[blockId],
               suiteScopeId):
            actionBlockCount = actionBlockCount + 1
    if actionBlockCount <= 0:
        return layout.FixedBytes32()
    for blockId in 0..<bodyIR.blocks.len:
        if !bodyIRControlScopeDescendsFrom(
               bodyIR, bodyIR.blockScopeIds[blockId],
               suiteScopeId):
            continue
        let block = bodyIR.blocks[blockId]
        if block.opStart < 0 || block.opCount < 0 ||
           block.opStart > bodyIR.ops.len - block.opCount ||
           block.termIndex < 0 ||
           block.termIndex >= bodyIR.terms.len:
            return layout.FixedBytes32()
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            let op = bodyIR.ops[opIndex]
            if op.target >= 0:
                if op.target >= localSeen.len:
                    return layout.FixedBytes32()
                localSeen[op.target] = true
            if op.kind == BodyOpCallTag:
                if op.operands.len != 1 ||
                   op.operands[0] < 0 ||
                   op.operands[0] >= callSeen.len:
                    return layout.FixedBytes32()
                callSeen[op.operands[0]] = true
            elif op.kind == BodyOpResultPanicGuardTag:
                if op.operands.len < 2 ||
                   op.operands[1] < 0 ||
                   op.operands[1] >= callSeen.len:
                    return layout.FixedBytes32()
                callSeen[op.operands[1]] = true
                let localId = op.operands[0]
                if localId < 0 || localId >= localSeen.len:
                    return layout.FixedBytes32()
                localSeen[localId] = true
            elif op.kind == BodyOpStrEqLiteralTag:
                if op.operands.len < 2 ||
                   op.operands[1] < 0 ||
                   op.operands[1] >= cstringSeen.len:
                    return layout.FixedBytes32()
                cstringSeen[op.operands[1]] = true
                let localId = op.operands[0]
                if localId < 0 || localId >= localSeen.len:
                    return layout.FixedBytes32()
                localSeen[localId] = true
            elif op.kind == BodyOpLoadLocalTag:
                if op.operands.len == 5 &&
                   op.operands[0] ==
                       BodyLoadLocalIndexedAddressTag:
                    for operandIndex in 1..<3:
                        let localId = op.operands[operandIndex]
                        if localId < 0 || localId >= localSeen.len:
                            return layout.FixedBytes32()
                        localSeen[localId] = true
                elif op.operands.len == 4 &&
                     op.operands[0] ==
                         BodyLoadLocalFieldAddressTag:
                    let localId = op.operands[1]
                    if localId < 0 || localId >= localSeen.len:
                        return layout.FixedBytes32()
                    localSeen[localId] = true
                elif op.operands.len >= 3 &&
                   op.operands[0] == BodyLoadLocalStrIndexU8Tag:
                    for operandIndex in 1..<3:
                        let localId = op.operands[operandIndex]
                        if localId < 0 || localId >= localSeen.len:
                            return layout.FixedBytes32()
                        localSeen[localId] = true
                elif op.operands.len >= 2 &&
                     (op.operands[0] ==
                          BodyLoadLocalPtrDerefI32Tag ||
                      op.operands[0] ==
                          BodyLoadLocalPtrDerefU8Tag ||
                      op.operands[0] ==
                          BodyLoadLocalPtrDerefU64Tag):
                    let localId = op.operands[1]
                    if localId < 0 || localId >= localSeen.len:
                        return layout.FixedBytes32()
                    localSeen[localId] = true
                elif op.operands.len >= 1:
                    let localId = op.operands[0]
                    if localId < 0 || localId >= localSeen.len:
                        return layout.FixedBytes32()
                    localSeen[localId] = true
                else:
                    return layout.FixedBytes32()
            elif op.kind == BodyOpStoreLocalTag ||
                 op.kind == BodyOpCopyLocalTag:
                if op.operands.len < 1 ||
                   op.operands[0] < 0 ||
                   op.operands[0] >= localSeen.len:
                    return layout.FixedBytes32()
                localSeen[op.operands[0]] = true
            elif op.kind == BodyOpBinOpTag:
                if op.operands.len < 4:
                    return layout.FixedBytes32()
                for operandIndex in 2..<op.operands.len:
                    let localId = op.operands[operandIndex]
                    if localId < 0 || localId >= localSeen.len:
                        return layout.FixedBytes32()
                    localSeen[localId] = true
            elif op.kind == BodyOpCmpTag:
                if op.operands.len < 3:
                    return layout.FixedBytes32()
                for operandIndex in 1..<op.operands.len:
                    let localId = op.operands[operandIndex]
                    if localId < 0 || localId >= localSeen.len:
                        return layout.FixedBytes32()
                    localSeen[localId] = true
            elif op.kind == BodyOpBranchTag:
                if op.operands.len >= 2:
                    let localId = op.operands[1]
                    if localId < 0 || localId >= localSeen.len:
                        return layout.FixedBytes32()
                    localSeen[localId] = true
                if op.operands.len >= 3 &&
                   op.operands[0] ==
                       BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
                    let localId = op.operands[2]
                    if localId < 0 || localId >= localSeen.len:
                        return layout.FixedBytes32()
                    localSeen[localId] = true
            elif op.kind == BodyOpResultProjectTag:
                if op.operands.len < 2 ||
                   op.operands[1] < 0 ||
                   op.operands[1] >= localSeen.len:
                    return layout.FixedBytes32()
                localSeen[op.operands[1]] = true
            elif op.kind == BodyOpStrEqTag ||
                 op.kind == BodyOpIndexedLoadTag ||
                 op.kind == BodyOpIndexedStoreTag ||
                 op.kind == BodyOpFieldLoadTag ||
                 op.kind == BodyOpFieldStoreTag:
                if op.operands.len < 2:
                    return layout.FixedBytes32()
                for operandIndex in 0..<2:
                    let localId = op.operands[operandIndex]
                    if localId < 0 || localId >= localSeen.len:
                        return layout.FixedBytes32()
                    localSeen[localId] = true
            elif op.kind == BodyOpGlobalLoadTag ||
                 op.kind == BodyOpGlobalStoreTag:
                if op.operands.len < 1 ||
                   op.operands[0] < 0 ||
                   op.operands[0] >= localSeen.len:
                    return layout.FixedBytes32()
                localSeen[op.operands[0]] = true
        let term = bodyIR.terms[block.termIndex]
        if term.resultSlot >= 0:
            if term.resultSlot >= localSeen.len:
                return layout.FixedBytes32()
            localSeen[term.resultSlot] = true
        if term.lhsSlot >= 0:
            if term.lhsSlot >= localSeen.len:
                return layout.FixedBytes32()
            localSeen[term.lhsSlot] = true
        if term.rhsSlot >= 0:
            if term.rhsSlot >= localSeen.len:
                return layout.FixedBytes32()
            localSeen[term.rhsSlot] = true
    for callId in 0..<callSeen.len:
        if !callSeen[callId]:
            continue
        if !BodyIRCallTargetIdentityValid(
               bodyIR.callTargetDomainKinds[callId],
               bodyIR.callTargetRows[callId]) ||
           !BodyIRTypeArenaArtifactCidValid(
               bodyIR.callTargetInterfaceCids[callId]):
            return layout.FixedBytes32()
        let callOp = bodyIR.callSequence[callId]
        if callOp.argSlots.len != callOp.argPassKinds.len:
            return layout.FixedBytes32()
        if callOp.resultSlot >= 0:
            if callOp.resultSlot >= localSeen.len:
                return layout.FixedBytes32()
            localSeen[callOp.resultSlot] = true
        for argIndex in 0..<callOp.argSlots.len:
            let arg = callOp.argSlots[argIndex]
            if arg >= 0:
                if arg >= localSeen.len:
                    return layout.FixedBytes32()
                localSeen[arg] = true
            elif CallArgSlotIsCString(arg):
                let literalId = CallArgSlotCStringId(arg)
                if literalId < 0 || literalId >= cstringSeen.len:
                    return layout.FixedBytes32()
                cstringSeen[literalId] = true
            elif CallArgSlotIsAddress(arg):
                let slotId = CallArgSlotAddressId(arg)
                if slotId < 0 || slotId >= localSeen.len:
                    return layout.FixedBytes32()
                localSeen[slotId] = true
            elif arg != CallArgSlotMissing() &&
                 !CallArgSlotIsConst(arg):
                return layout.FixedBytes32()
    for localId in 0..<localSeen.len:
        if !localSeen[localId]:
            continue
        let slot = bodyIR.localSlots[localId]
        if slot.id != localId || slot.typeArenaTypeId < 0:
            return layout.FixedBytes32()
        var matchCount: int32
        for typeFactRow in 0..<bodyIR.typeFactTypeIds.len:
            if bodyIR.typeFactTypeIds[typeFactRow] ==
                   slot.typeArenaTypeId:
                typeFactSeen[typeFactRow] = true
                matchCount = matchCount + 1
        if matchCount != 1:
            return layout.FixedBytes32()
    var typeClosureChanged = true
    while typeClosureChanged:
        typeClosureChanged = false
        for typeFactRow in 0..<typeFactSeen.len:
            if !typeFactSeen[typeFactRow]:
                continue
            let childTypeId =
                bodyIR.typeFactChildTypeIds[typeFactRow]
            if childTypeId < 0:
                continue
            var matchCount: int32
            for childRow in 0..<bodyIR.typeFactTypeIds.len:
                if bodyIR.typeFactTypeIds[childRow] == childTypeId:
                    matchCount = matchCount + 1
                    if !typeFactSeen[childRow]:
                        typeFactSeen[childRow] = true
                        typeClosureChanged = true
            if matchCount != 1:
                return layout.FixedBytes32()
    var buf = layout.ByteBufInit(1024)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_defer_semantic")
    bodyIRControlActionAppendI32(
        buf, bodyIR.deferFunctionRows[deferId])
    bodyIRControlActionAppendI32(
        buf, bodyIR.deferStatementRows[deferId])
    bodyIRControlActionAppendI32(
        buf, bodyIR.deferDeclarationScopeIds[deferId])
    bodyIRControlActionAppendI32(
        buf, bodyIR.deferLexicalOrdinals[deferId])
    layout.ByteBufAppendFixed32(buf, bodyIR.typeArenaArtifactCid)
    var localCount: int32
    for localId in 0..<localSeen.len:
        if localSeen[localId]:
            localCount = localCount + 1
    bodyIRControlActionAppendI32(buf, localCount)
    for localId in 0..<localSeen.len:
        if !localSeen[localId]:
            continue
        let slot = bodyIR.localSlots[localId]
        bodyIRControlActionAppendI32(buf, localId)
        bodyIRControlActionAppendI32(buf, slot.typeKind)
        bodyIRControlActionAppendI32(buf, slot.typeArenaTypeId)
        bodyIRControlActionAppendI32(buf, slot.managedStorageKind)
        bodyIRControlActionAppendI32(buf, slot.sizeBytes)
        bodyIRControlActionAppendI32(buf, slot.alignBytes)
    var callCount: int32
    for callId in 0..<callSeen.len:
        if callSeen[callId]:
            callCount = callCount + 1
    bodyIRControlActionAppendI32(buf, callCount)
    for callId in 0..<callSeen.len:
        if !callSeen[callId]:
            continue
        let callOp = bodyIR.callSequence[callId]
        bodyIRControlActionAppendI32(buf, callId)
        bodyIRControlActionAppendI32(
            buf, bodyIR.callTargetDomainKinds[callId])
        bodyIRControlActionAppendI32(
            buf, bodyIR.callTargetRows[callId])
        layout.ByteBufAppendFixed32(
            buf, bodyIR.callTargetInterfaceCids[callId])
        bodyIRControlActionAppendI32(buf, callOp.argSlots.len)
        for argIndex in 0..<callOp.argSlots.len:
            bodyIRControlActionAppendI32(
                buf, callOp.argSlots[argIndex])
            bodyIRControlActionAppendI32(
                buf, callOp.argPassKinds[argIndex])
        bodyIRControlActionAppendI32(buf, callOp.resultSlot)
        bodyIRControlActionAppendI32(
            buf, callOp.resultPassKind)
        bodyIRControlActionAppendI32(
            buf, int32(callOp.resultOwnership))
        bodyIRControlActionAppendI32(
            buf, callOp.resultExprNodeIndex)
        bodyIRControlActionAppendI32(
            buf, callOp.resultValueDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, callOp.resultBorrowOwnerValueDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, callOp.resultBorrowOwnerDefinitionDomain)
        bodyIRControlActionAppendI32(
            buf, callOp.resultBorrowOwnerDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, callOp.resultDefinitionOriginKind)
        bodyIRControlActionAppendI32(
            buf, callOp.resultDefinitionOriginId)
        bodyIRControlActionAppendI32(
            buf, callOp.sourceDefinitionDomain)
        bodyIRControlActionAppendI32(
            buf, callOp.sourceDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, callOp.semanticCallExprNodeIndex)
        bodyIRControlActionAppendI32(
            buf, callOp.consumeActionRow)
        bodyIRControlActionAppendI32(
            buf, callOp.managedStoreKind)
        bodyIRControlActionAppendI32(
            buf, callOp.managedReplaceReceiptRow)
        bodyIRControlActionAppendI32(
            buf, callOp.managedDropGlueDescriptorRow)
    var cstringCount: int32
    for literalId in 0..<cstringSeen.len:
        if cstringSeen[literalId]:
            cstringCount = cstringCount + 1
    bodyIRControlActionAppendI32(buf, cstringCount)
    for literalId in 0..<cstringSeen.len:
        if !cstringSeen[literalId]:
            continue
        let literal = bodyIR.cstringLiterals[literalId]
        if literal.id != literalId:
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        bodyIRControlActionAppendI32(buf, literalId)
        bodyIRControlActionAppendText(buf, literal.text)
    var typeFactCount: int32
    for typeFactRow in 0..<typeFactSeen.len:
        if typeFactSeen[typeFactRow]:
            typeFactCount = typeFactCount + 1
    bodyIRControlActionAppendI32(buf, typeFactCount)
    for typeFactRow in 0..<typeFactSeen.len:
        if !typeFactSeen[typeFactRow]:
            continue
        bodyIRControlActionAppendI32(buf, typeFactRow)
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactTypeIds[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactStructuralKinds[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactScalarKinds[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactChildTypeIds[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactFixedLengths[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactSizeBytes[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactAlignBytes[typeFactRow])
    bodyIRControlActionAppendI32(buf, actionBlockCount)
    for blockId in 0..<bodyIR.blocks.len:
        if !bodyIRControlScopeDescendsFrom(
               bodyIR, bodyIR.blockScopeIds[blockId],
               suiteScopeId):
            continue
        let block = bodyIR.blocks[blockId]
        if block.opStart < 0 || block.opCount < 0 ||
           block.opStart > bodyIR.ops.len - block.opCount ||
           block.termIndex < 0 ||
           block.termIndex >= bodyIR.terms.len:
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        bodyIRControlActionAppendI32(
            buf, bodyIRControlActionBlockOrdinal(
                bodyIR, suiteScopeId, blockId))
        bodyIRControlActionAppendI32(buf, block.opCount)
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            let op = bodyIR.ops[opIndex]
            bodyIRControlActionAppendI32(buf, op.kind)
            bodyIRControlActionAppendI32(buf, op.operands.len)
            for operandIndex in 0..<op.operands.len:
                bodyIRControlActionAppendI32(
                    buf, op.operands[operandIndex])
            bodyIRControlActionAppendI32(buf, op.target)
            bodyIRControlActionAppendI32(buf, op.valueDefSlot)
            bodyIRControlActionAppendI32(
                buf, op.valueDefExprNodeIndex)
            bodyIRControlActionAppendI32(
                buf, op.valueDefSemanticRow)
            bodyIRControlActionAppendI32(
                buf, int32(op.valueDefOwnership))
            bodyIRControlActionAppendI32(
                buf, op.valueDefBorrowOwnerSemanticRow)
            bodyIRControlActionAppendI32(
                buf, op.valueDefBorrowOwnerDefinitionDomain)
            bodyIRControlActionAppendI32(
                buf, op.valueDefBorrowOwnerDefinitionRow)
            bodyIRControlActionAppendI32(
                buf, op.valueDefConsumeOpIndexPlusOne)
            bodyIRControlActionAppendI32(
                buf, op.valueDefOriginKind)
            bodyIRControlActionAppendI32(
                buf, op.valueDefOriginId)
            bodyIRControlActionAppendI32(
                buf, op.sourceDefinitionDomain)
            bodyIRControlActionAppendI32(
                buf, op.sourceDefinitionRow)
            bodyIRControlActionAppendI32(
                buf, op.consumeActionRow)
        let term = bodyIR.terms[block.termIndex]
        bodyIRControlActionAppendI32(buf, term.kind)
        bodyIRControlActionAppendI32(buf, term.conditionKind)
        bodyIRControlActionAppendI32(buf, term.resultSlot)
        bodyIRControlActionAppendI32(
            buf, term.sourceDefinitionDomain)
        bodyIRControlActionAppendI32(
            buf, term.sourceDefinitionRow)
        bodyIRControlActionAppendI32(buf, term.lhsSlot)
        bodyIRControlActionAppendI32(buf, term.rhsSlot)
        if term.trueBlock >= 0:
            let targetOrdinal = bodyIRControlActionBlockOrdinal(
                bodyIR, suiteScopeId, term.trueBlock)
            if targetOrdinal < 0:
                layout.ByteBufFree(buf)
                return layout.FixedBytes32()
            bodyIRControlActionAppendI32(buf, targetOrdinal)
        else:
            bodyIRControlActionAppendI32(buf, -1)
        if term.falseBlock >= 0:
            let targetOrdinal = bodyIRControlActionBlockOrdinal(
                bodyIR, suiteScopeId, term.falseBlock)
            if targetOrdinal < 0:
                layout.ByteBufFree(buf)
                return layout.FixedBytes32()
            bodyIRControlActionAppendI32(buf, targetOrdinal)
        else:
            bodyIRControlActionAppendI32(buf, -1)
        bodyIRControlActionAppendI32(buf, term.operands.len)
        for operandIndex in 0..<term.operands.len:
            bodyIRControlActionAppendI32(
                buf, term.operands[operandIndex])
        let successorStart =
            bodyIR.termSuccessorStarts[block.termIndex]
        let successorCount =
            bodyIR.termSuccessorCounts[block.termIndex]
        if successorStart < 0 || successorCount < 0 ||
           successorStart >
               bodyIR.successorBlockIds.len - successorCount ||
           bodyIR.successorEdgeKinds.len !=
               bodyIR.successorBlockIds.len:
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        bodyIRControlActionAppendI32(buf, successorCount)
        for successorOrdinal in 0..<successorCount:
            let successorRow = successorStart + successorOrdinal
            let targetOrdinal = bodyIRControlActionBlockOrdinal(
                bodyIR, suiteScopeId,
                bodyIR.successorBlockIds[successorRow])
            if targetOrdinal < 0:
                layout.ByteBufFree(buf)
                return layout.FixedBytes32()
            bodyIRControlActionAppendI32(buf, targetOrdinal)
            bodyIRControlActionAppendI32(
                buf, bodyIR.successorEdgeKinds[successorRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRCleanupDeferSemanticCid(
        bodyIR: BodyIR,
        deferId: int32): layout.FixedBytes32 =
    return BodyIRControlFlowDeferActionCid(bodyIR, deferId)

@borrows
fn BodyIRControlFlowShapeValid(bodyIR: BodyIR): bool =
    if !bodyIR.controlFlowSealed:
        return bodyIR.controlFunctionRow == -1 &&
               bodyIR.controlScopeParentIds.len == 0 &&
               bodyIR.blockScopeIds.len == 0 &&
               bodyIR.termSuccessorStarts.len == 0 &&
               bodyIR.termSuccessorCounts.len == 0 &&
               bodyIR.successorBlockIds.len == 0 &&
               bodyIR.successorEdgeKinds.len == 0 &&
               bodyIR.callTargetDomainKinds.len == 0 &&
               bodyIR.callTargetRows.len == 0 &&
               bodyIR.callTargetInterfaceCids.len == 0 &&
               bodyIR.deferDeclarationScopeIds.len == 0 &&
               bodyIR.deferSuiteScopeIds.len == 0 &&
               bodyIR.deferLexicalOrdinals.len == 0 &&
               bodyIR.deferFunctionRows.len == 0 &&
               bodyIR.deferStatementRows.len == 0 &&
               bodyIR.deferActionCids.len == 0 &&
               bodyIR.deferActivationSiteBlockIds.len == 0 &&
               bodyIR.deferActivationSiteAfterOpOrdinals.len == 0 &&
               bodyIR.deferActivationSiteStarts.len == 0 &&
               bodyIR.deferActivationSiteCounts.len == 0 &&
               bodyIR.deferActivationRows.len == 0
    if bodyIR.controlFunctionRow < 0 ||
       bodyIR.controlScopeParentIds.len <= 0 ||
       bodyIR.controlScopeParentIds[0] != -1 ||
       bodyIR.blockScopeIds.len != bodyIR.blocks.len ||
       bodyIR.termSuccessorStarts.len != bodyIR.terms.len ||
       bodyIR.termSuccessorCounts.len != bodyIR.terms.len ||
       bodyIR.successorBlockIds.len != bodyIR.successorEdgeKinds.len:
        return false
    if bodyIR.callTargetDomainKinds.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetRows.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetInterfaceCids.len !=
           bodyIR.callSequence.len:
        return false
    for callId in 0..<bodyIR.callSequence.len:
        if !BodyIRCallTargetIdentityValid(
               bodyIR.callTargetDomainKinds[callId],
               bodyIR.callTargetRows[callId]) ||
           !BodyIRTypeArenaArtifactCidValid(
               bodyIR.callTargetInterfaceCids[callId]):
            return false
        if bodyIR.callTargetDomainKinds[callId] ==
               BodyCallTargetDomainRuntimeIntrinsicTag &&
           bodyIR.callTargetRows[callId] !=
               BodyIRRuntimeIntrinsicCanonicalRow(
                   bodyIR,
                   bodyIR.callTargetInterfaceCids[callId]):
            return false
        if !bodyIRCallTargetAbiDomainValid(
               bodyIR.callSequence[callId],
               bodyIR.callTargetDomainKinds[callId]):
            return false
        for priorCallId in 0..<callId:
            if bodyIR.callTargetDomainKinds[priorCallId] !=
                   bodyIR.callTargetDomainKinds[callId]:
                continue
            let sameRow =
                bodyIR.callTargetRows[priorCallId] ==
                    bodyIR.callTargetRows[callId]
            let sameCid = layout.FixedBytes32Equal(
                bodyIR.callTargetInterfaceCids[priorCallId],
                bodyIR.callTargetInterfaceCids[callId])
            if sameRow != sameCid:
                return false
    for scopeId in 1..<bodyIR.controlScopeParentIds.len:
        let parentScopeId = bodyIR.controlScopeParentIds[scopeId]
        if parentScopeId < 0 || parentScopeId >= scopeId:
            return false
    for blockId in 0..<bodyIR.blockScopeIds.len:
        let scopeId = bodyIR.blockScopeIds[blockId]
        if scopeId < 0 || scopeId >= bodyIR.controlScopeParentIds.len:
            return false
    var successorCursor: int32
    for termIndex in 0..<bodyIR.terms.len:
        let start = bodyIR.termSuccessorStarts[termIndex]
        let count = bodyIR.termSuccessorCounts[termIndex]
        if start != successorCursor ||
           !bodyIRControlFlowTermSuccessorSliceValid(
               bodyIR.terms[termIndex],
               bodyIR.successorBlockIds,
               bodyIR.successorEdgeKinds,
               start,
               count,
               bodyIR.blocks.len,
               false):
            return false
        successorCursor = successorCursor + count
    if successorCursor != bodyIR.successorBlockIds.len:
        return false
    let deferCount = bodyIR.deferDeclarationScopeIds.len
    if bodyIR.deferSuiteScopeIds.len != deferCount ||
       bodyIR.deferLexicalOrdinals.len != deferCount ||
       bodyIR.deferFunctionRows.len != deferCount ||
       bodyIR.deferStatementRows.len != deferCount ||
       bodyIR.deferActionCids.len != deferCount ||
       bodyIR.deferActivationSiteBlockIds.len !=
           bodyIR.deferActivationSiteAfterOpOrdinals.len ||
       bodyIR.deferActivationSiteBlockIds.len !=
           bodyIR.deferActivationSiteStarts.len ||
       bodyIR.deferActivationSiteBlockIds.len !=
           bodyIR.deferActivationSiteCounts.len:
        return false
    var deferSeen: bool[]
    for _ in 0..<deferCount:
        add(deferSeen, false)
    for deferId in 0..<deferCount:
        let declarationScopeId =
            bodyIR.deferDeclarationScopeIds[deferId]
        let suiteScopeId = bodyIR.deferSuiteScopeIds[deferId]
        if declarationScopeId < 0 ||
           declarationScopeId >= bodyIR.controlScopeParentIds.len ||
           suiteScopeId < 0 ||
           suiteScopeId >= bodyIR.controlScopeParentIds.len ||
           bodyIR.controlScopeParentIds[suiteScopeId] !=
               declarationScopeId ||
           bodyIR.deferLexicalOrdinals[deferId] < 0 ||
           bodyIR.deferFunctionRows[deferId] !=
               bodyIR.controlFunctionRow ||
           bodyIR.deferStatementRows[deferId] < 0 ||
           !BodyIRTypeArenaArtifactCidValid(
               bodyIR.deferActionCids[deferId]) ||
           !layout.FixedBytes32Equal(
               bodyIR.deferActionCids[deferId],
               BodyIRControlFlowDeferActionCid(
                   bodyIR, deferId)):
            return false
        for priorDeferId in 0..<deferId:
            if bodyIR.deferFunctionRows[priorDeferId] ==
                   bodyIR.deferFunctionRows[deferId] &&
               bodyIR.deferStatementRows[priorDeferId] ==
                   bodyIR.deferStatementRows[deferId]:
                return false
    var activationCursor: int32
    for siteId in 0..<bodyIR.deferActivationSiteBlockIds.len:
        let blockId = bodyIR.deferActivationSiteBlockIds[siteId]
        let afterOpOrdinal =
            bodyIR.deferActivationSiteAfterOpOrdinals[siteId]
        let start = bodyIR.deferActivationSiteStarts[siteId]
        let count = bodyIR.deferActivationSiteCounts[siteId]
        if blockId < 0 || blockId >= bodyIR.blocks.len ||
           afterOpOrdinal < 0 ||
           afterOpOrdinal > bodyIR.blocks[blockId].opCount ||
           start != activationCursor || count <= 0 ||
           count > bodyIR.deferActivationRows.len - start:
            return false
        for priorSiteId in 0..<siteId:
            if bodyIR.deferActivationSiteBlockIds[priorSiteId] ==
                   blockId &&
               bodyIR.deferActivationSiteAfterOpOrdinals[priorSiteId] ==
                   afterOpOrdinal:
                return false
        for rowOffset in 0..<count:
            let deferId =
                bodyIR.deferActivationRows[start + rowOffset]
            if deferId < 0 || deferId >= deferCount ||
               deferSeen[deferId] ||
               bodyIR.blockScopeIds[blockId] !=
                   bodyIR.deferDeclarationScopeIds[deferId]:
                return false
            deferSeen[deferId] = true
        activationCursor = activationCursor + count
    if activationCursor != bodyIR.deferActivationRows.len:
        return false
    for deferId in 0..<deferCount:
        if !deferSeen[deferId]:
            return false
    return true

fn BodyIRControlFlowBegin(bodyIR: var BodyIR,
                          functionRow: int32) =
    if functionRow < 0 || bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR):
        panic("body ir control flow: begin state invalid")
    bodyIR.controlFunctionRow = functionRow
    add(bodyIR.controlScopeParentIds, -1)

fn BodyIRControlFlowAddScope(bodyIR: var BodyIR,
                             parentScopeId: int32): int32 =
    if bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow < 0 ||
       parentScopeId < 0 ||
       parentScopeId >= bodyIR.controlScopeParentIds.len:
        panic("body ir control flow: scope parent invalid")
    let scopeId = bodyIR.controlScopeParentIds.len
    add(bodyIR.controlScopeParentIds, parentScopeId)
    return scopeId

fn BodyIRControlFlowBindBlockScope(bodyIR: var BodyIR,
                                   blockId: int32,
                                   scopeId: int32) =
    if bodyIR.controlFlowSealed ||
       blockId != bodyIR.blockScopeIds.len ||
       blockId < 0 || blockId >= bodyIR.blocks.len ||
       scopeId < 0 ||
       scopeId >= bodyIR.controlScopeParentIds.len:
        panic("body ir control flow: block scope binding invalid")
    add(bodyIR.blockScopeIds, scopeId)

@borrows
fn bodyIRControlFlowTermSuccessorSliceValid(
        term: BodyTerm,
        successorBlockIds: int32[],
        edgeKinds: int32[],
        start: int32,
        count: int32,
        blockCount: int32,
        allowPending: bool): bool =
    if start < 0 || count < 0 || blockCount < 0 ||
       count > successorBlockIds.len - start ||
       edgeKinds.len != successorBlockIds.len:
        return false
    if term.kind == BodyTermReturnTag:
        return count == 0
    var expectedCount: int32
    if term.kind == BodyTermBrTag:
        expectedCount = 1
    elif term.kind == BodyTermCbrTag:
        expectedCount = 2
    else:
        return false
    if count != expectedCount:
        return false
    for successorOrdinal in 0..<count:
        let successorBlockId =
            successorBlockIds[start + successorOrdinal]
        let expectedBlockId =
            if successorOrdinal == 0:
                term.trueBlock
            else:
                term.falseBlock
        if successorBlockId != expectedBlockId ||
           successorBlockId < (if allowPending: -1 else: 0) ||
           (!allowPending && successorBlockId >= blockCount) ||
           !BodyIRControlEdgeKindValid(
               edgeKinds[start + successorOrdinal]) ||
           edgeKinds[start + successorOrdinal] ==
               BodyControlEdgeReturn:
            return false
    return true

@borrows
fn BodyIRControlFlowBindTermSuccessors(
        bodyIR: var BodyIR,
        termIndex: int32,
        successorBlockIds: int32[],
        edgeKinds: int32[]) =
    if bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow < 0 ||
       termIndex != bodyIR.termSuccessorStarts.len ||
       termIndex < 0 || termIndex >= bodyIR.terms.len ||
       successorBlockIds.len != edgeKinds.len ||
       !bodyIRControlFlowTermSuccessorSliceValid(
           bodyIR.terms[termIndex],
           successorBlockIds,
           edgeKinds,
           0,
           successorBlockIds.len,
           bodyIR.blocks.len,
           true):
        panic("body ir control flow: term successor binding invalid")
    add(bodyIR.termSuccessorStarts, bodyIR.successorBlockIds.len)
    add(bodyIR.termSuccessorCounts, successorBlockIds.len)
    for successorOrdinal in 0..<successorBlockIds.len:
        add(bodyIR.successorBlockIds,
            successorBlockIds[successorOrdinal])
        add(bodyIR.successorEdgeKinds,
            edgeKinds[successorOrdinal])

fn BodyIRCallTargetIdentityValid(
        targetDomainKind: int32,
        targetRow: int32): bool =
    return targetRow >= 0 &&
           (targetDomainKind == BodyCallTargetDomainFunctionTag ||
            targetDomainKind == BodyCallTargetDomainExternFunctionTag ||
            targetDomainKind == BodyCallTargetDomainRuntimeIntrinsicTag)

@borrows
fn bodyIRCallTargetAbiDomainValid(
        call: CallOp,
        targetDomainKind: int32): bool =
    if targetDomainKind == BodyCallTargetDomainExternFunctionTag:
        return call.targetIsImportc
    if targetDomainKind == BodyCallTargetDomainFunctionTag:
        return !call.targetIsImportc
    return targetDomainKind == BodyCallTargetDomainRuntimeIntrinsicTag

@borrows
fn bodyIRFixedBytes32Less(left: layout.FixedBytes32,
                          right: layout.FixedBytes32): bool =
    for byteIndex in 0..<layout.FixedBytes32Size:
        if left.data[byteIndex] < right.data[byteIndex]:
            return true
        if left.data[byteIndex] > right.data[byteIndex]:
            return false
    return false

@borrows
fn BodyIRRuntimeIntrinsicCanonicalRow(
        bodyIR: BodyIR,
        interfaceCid: layout.FixedBytes32): int32 =
    if !BodyIRTypeArenaArtifactCidValid(interfaceCid) ||
       bodyIR.callTargetDomainKinds.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetInterfaceCids.len !=
           bodyIR.callSequence.len:
        return -1
    var found: bool
    var canonicalRow: int32
    for callId in 0..<bodyIR.callSequence.len:
        if bodyIR.callTargetDomainKinds[callId] !=
               BodyCallTargetDomainRuntimeIntrinsicTag:
            continue
        let candidateCid =
            bodyIR.callTargetInterfaceCids[callId]
        if !BodyIRTypeArenaArtifactCidValid(candidateCid):
            return -1
        if layout.FixedBytes32Equal(candidateCid, interfaceCid):
            found = true
            continue
        if !bodyIRFixedBytes32Less(candidateCid, interfaceCid):
            continue
        var firstOccurrence: bool = true
        for priorCallId in 0..<callId:
            if bodyIR.callTargetDomainKinds[priorCallId] ==
                   BodyCallTargetDomainRuntimeIntrinsicTag &&
               layout.FixedBytes32Equal(
                   bodyIR.callTargetInterfaceCids[priorCallId],
                   candidateCid):
                firstOccurrence = false
        if firstOccurrence:
            canonicalRow = canonicalRow + 1
    if !found:
        return -1
    return canonicalRow

fn bodyIRCanonicalizeRuntimeIntrinsicTargetRows(
        bodyIR: var BodyIR) =
    if bodyIR.callTargetDomainKinds.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetRows.len !=
           bodyIR.callSequence.len ||
       bodyIR.callTargetInterfaceCids.len !=
           bodyIR.callSequence.len:
        panic("body ir control flow: call target columns drift")
    for callId in 0..<bodyIR.callSequence.len:
        if bodyIR.callTargetDomainKinds[callId] !=
               BodyCallTargetDomainRuntimeIntrinsicTag:
            continue
        let canonicalRow =
            BodyIRRuntimeIntrinsicCanonicalRow(
                bodyIR,
                bodyIR.callTargetInterfaceCids[callId])
        if canonicalRow < 0:
            panic("body ir control flow: runtime target identity invalid")
        bodyIR.callTargetRows[callId] = canonicalRow

@borrows
fn BodyIRControlFlowBindCallTarget(
        bodyIR: var BodyIR,
        callId: int32,
        targetDomainKind: int32,
        targetRow: int32,
        targetInterfaceCid: layout.FixedBytes32) =
    if bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow < 0 ||
       callId != bodyIR.callTargetDomainKinds.len ||
       callId != bodyIR.callTargetRows.len ||
       callId != bodyIR.callTargetInterfaceCids.len ||
       callId < 0 || callId >= bodyIR.callSequence.len ||
       !BodyIRCallTargetIdentityValid(
           targetDomainKind, targetRow) ||
       !bodyIRCallTargetAbiDomainValid(
           bodyIR.callSequence[callId], targetDomainKind) ||
       !BodyIRTypeArenaArtifactCidValid(targetInterfaceCid):
        panic("body ir control flow: call target identity invalid")
    add(bodyIR.callTargetDomainKinds, targetDomainKind)
    add(bodyIR.callTargetRows, targetRow)
    add(bodyIR.callTargetInterfaceCids, layout.FixedBytes32Copy(targetInterfaceCid))

# Exact mutation 的合法 source 集由生产状态机
# (cleanupCfgStageMaterialize 双 open 序列) 定义:
# 第一次 open 在 BuildAndSealIntent 之前 (插 flag initializers),
# 此刻 intent 必须仍是 canonical empty; 第二次 open 时 intent 必须
# 已 sealed。canonical empty 是经全字段审的规范零态, 不是未审态。
# BodyIRCleanupIntentSidecarShapeValid 覆盖全部非法形态: building
# (build 半途)、unsealed-but-nonempty、rootCid 伪造 (与
# CandidateRootCid 失配)、行列漂移, 一律判死。
fn BodyIRControlFlowOpenExactMutation(bodyIR: var BodyIR) =
    if !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       !BodyIRCleanupIntentSidecarShapeValid(bodyIR) ||
       !BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
           bodyIR.cleanupSchedule) ||
       !BodyIRDeferReplaySidecarIsCanonicalEmpty(
           bodyIR.deferReplay):
        panic("body ir control flow: exact mutation source invalid")
    bodyIR.controlFlowSealed = false

@borrows
fn bodyIRControlFlowReplacementSuccessorsValid(
        term: BodyTerm,
        successorBlockIds: var int32[],
        edgeKinds: var int32[],
        blockCount: int32): bool =
    return bodyIRControlFlowTermSuccessorSliceValid(
        term,
        successorBlockIds,
        edgeKinds,
        0,
        successorBlockIds.len,
        blockCount,
        false)

fn BodyIRControlFlowReplaceTermExact(
        bodyIR: var BodyIR,
        termIndex: int32,
        replacement: BodyTerm,
        successorBlockIds: var int32[],
        edgeKinds: var int32[]) =
    if bodyIR.controlFlowSealed ||
       bodyIR.controlFunctionRow < 0 ||
       termIndex < 0 || termIndex >= bodyIR.terms.len ||
       bodyIR.termSuccessorStarts.len != bodyIR.terms.len ||
       bodyIR.termSuccessorCounts.len != bodyIR.terms.len ||
       bodyIR.successorBlockIds.len !=
           bodyIR.successorEdgeKinds.len ||
       !bodyIRControlFlowReplacementSuccessorsValid(
           replacement,
           successorBlockIds,
           edgeKinds,
           bodyIR.blocks.len):
        panic("body ir control flow: exact term replacement invalid")
    var newStarts: int32[]
    var newCounts: int32[]
    var newSuccessorBlockIds: int32[]
    var newEdgeKinds: int32[]
    var oldCursor: int32
    for candidateTermIndex in 0..<bodyIR.terms.len:
        let oldStart =
            bodyIR.termSuccessorStarts[candidateTermIndex]
        let oldCount =
            bodyIR.termSuccessorCounts[candidateTermIndex]
        if oldStart != oldCursor || oldCount < 0 ||
           oldCount > bodyIR.successorBlockIds.len - oldStart ||
           !bodyIRControlFlowTermSuccessorSliceValid(
               bodyIR.terms[candidateTermIndex],
               bodyIR.successorBlockIds,
               bodyIR.successorEdgeKinds,
               oldStart,
               oldCount,
               bodyIR.blocks.len,
               true):
            panic("body ir control flow: exact term source CSR invalid")
        add(newStarts, newSuccessorBlockIds.len)
        if candidateTermIndex == termIndex:
            add(newCounts, successorBlockIds.len)
            for successorOrdinal in 0..<successorBlockIds.len:
                add(newSuccessorBlockIds,
                    successorBlockIds[successorOrdinal])
                add(newEdgeKinds, edgeKinds[successorOrdinal])
        else:
            add(newCounts, oldCount)
            for successorOrdinal in 0..<oldCount:
                add(newSuccessorBlockIds,
                    bodyIR.successorBlockIds[
                        oldStart + successorOrdinal])
                add(newEdgeKinds,
                    bodyIR.successorEdgeKinds[
                        oldStart + successorOrdinal])
        oldCursor = oldCursor + oldCount
    if oldCursor != bodyIR.successorBlockIds.len:
        panic("body ir control flow: exact term source cursor drift")
    bodyIR.terms[termIndex] = replacement
    bodyIR.termSuccessorStarts = newStarts
    bodyIR.termSuccessorCounts = newCounts
    bodyIR.successorBlockIds = newSuccessorBlockIds
    bodyIR.successorEdgeKinds = newEdgeKinds
    BodyIRClearFrameLayoutCache(bodyIR)

fn BodyIRControlFlowAddDefer(
        bodyIR: var BodyIR,
        declarationScopeId: int32,
        suiteScopeId: int32,
        lexicalOrdinal: int32,
        functionRow: int32,
        statementRow: int32): int32 =
    if bodyIR.controlFlowSealed ||
       declarationScopeId < 0 ||
       declarationScopeId >= bodyIR.controlScopeParentIds.len ||
       suiteScopeId < 0 ||
       suiteScopeId >= bodyIR.controlScopeParentIds.len ||
       lexicalOrdinal < 0 ||
       functionRow != bodyIR.controlFunctionRow ||
       statementRow < 0:
        panic("body ir control flow: defer binding invalid")
    let deferId = bodyIR.deferDeclarationScopeIds.len
    add(bodyIR.deferDeclarationScopeIds, declarationScopeId)
    add(bodyIR.deferSuiteScopeIds, suiteScopeId)
    add(bodyIR.deferLexicalOrdinals, lexicalOrdinal)
    add(bodyIR.deferFunctionRows, functionRow)
    add(bodyIR.deferStatementRows, statementRow)
    add(bodyIR.deferActionCids, layout.FixedBytes32())
    return deferId

fn BodyIRControlFlowAddDeferActivationSite(
        bodyIR: var BodyIR,
        blockId: int32,
        afterOpOrdinal: int32,
        deferIds: var int32[]) =
    if bodyIR.controlFlowSealed ||
       blockId < 0 || blockId >= bodyIR.blocks.len ||
       afterOpOrdinal < 0 ||
       afterOpOrdinal > bodyIR.blocks[blockId].opCount ||
       deferIds.len <= 0:
        panic("body ir control flow: defer activation site invalid")
    add(bodyIR.deferActivationSiteBlockIds, blockId)
    add(bodyIR.deferActivationSiteAfterOpOrdinals,
        afterOpOrdinal)
    add(bodyIR.deferActivationSiteStarts,
        bodyIR.deferActivationRows.len)
    add(bodyIR.deferActivationSiteCounts, deferIds.len)
    for rowOffset in 0..<deferIds.len:
        add(bodyIR.deferActivationRows, deferIds[rowOffset])

fn BodyIRControlFlowSeal(bodyIR: var BodyIR) =
    if bodyIR.controlFlowSealed:
        panic("body ir control flow: duplicate seal")
    bodyIRCanonicalizeRuntimeIntrinsicTargetRows(bodyIR)
    for deferId in 0..<bodyIR.deferActionCids.len:
        let actionCid =
            BodyIRControlFlowDeferActionCid(bodyIR, deferId)
        if !BodyIRTypeArenaArtifactCidValid(actionCid):
            panic("body ir control flow: defer action bytes invalid")
        bodyIR.deferActionCids[deferId] = actionCid
    bodyIR.controlFlowSealed = true
    if !BodyIRControlFlowShapeValid(bodyIR):
        panic("body ir control flow: sealed shape invalid")

fn bodyIRCleanupRangeValid(start: int32,
                           count: int32,
                           limit: int32,
                           allowEmpty: bool): bool =
    if limit < 0 || count < 0 || count > limit:
        return false
    if count == 0:
        return allowEmpty && start >= 0 && start <= limit
    return start >= 0 && start <= limit - count

fn bodyIRCleanupRangesOverlap(leftStart: int32,
                              leftCount: int32,
                              rightStart: int32,
                              rightCount: int32): bool =
    if leftCount <= 0 || rightCount <= 0:
        return false
    return leftStart < rightStart + rightCount &&
           rightStart < leftStart + leftCount

fn BodyIRCleanupUnitKindValid(kind: int32): bool =
    return kind >= BodyCleanupUnitReturnSnapshotTag &&
           kind <= BodyCleanupUnitTransitionTag

fn BodyIRCleanupProjectionPolicyValid(policy: int32): bool =
    return policy == BodyCleanupProjectionIdentityTag ||
           policy == BodyCleanupProjectionSnapshotTag

fn BodyIRCleanupUnitOwnerDomainValid(domain: int32): bool =
    return domain == BodyCleanupUnitOwnerExitTag ||
           domain == BodyCleanupUnitOwnerOpSiteTag

fn BodyIRCleanupSemanticDomainValid(domain: int32): bool =
    return domain >= BodyCleanupSemanticDeferTag &&
           domain <= BodyCleanupSemanticOwnershipTransitionTag

@borrows
fn bodyIRCleanupTermSuccessorSliceValid(bodyIR: BodyIR,
                                        termRow: int32): bool =
    if termRow < 0 || termRow >= bodyIR.terms.len ||
       bodyIR.termSuccessorStarts.len != bodyIR.terms.len ||
       bodyIR.termSuccessorCounts.len != bodyIR.terms.len ||
       bodyIR.successorBlockIds.len !=
           bodyIR.successorEdgeKinds.len:
        return false
    let start = bodyIR.termSuccessorStarts[termRow]
    let count = bodyIR.termSuccessorCounts[termRow]
    return start >= 0 && count >= 0 &&
           count <= bodyIR.successorBlockIds.len - start

@borrows
fn bodyIRCleanupTermSemanticCid(
        bodyIR: BodyIR,
        termRow: int32,
        overrideSuccessorOrdinal: int32,
        overrideTargetBlockId: int32,
        overrideEdgeKind: int32): layout.FixedBytes32 =
    if !bodyIRCleanupTermSuccessorSliceValid(bodyIR, termRow):
        return layout.FixedBytes32()
    let term = bodyIR.terms[termRow]
    let successorStart = bodyIR.termSuccessorStarts[termRow]
    let successorCount = bodyIR.termSuccessorCounts[termRow]
    if overrideSuccessorOrdinal < -1 ||
       overrideSuccessorOrdinal >= successorCount ||
       (overrideSuccessorOrdinal >= 0 &&
        (!BodyIRControlEdgeKindValid(overrideEdgeKind) ||
         overrideEdgeKind == BodyControlEdgeReturn ||
         overrideTargetBlockId < 0 ||
         overrideTargetBlockId >= bodyIR.blocks.len)):
        return layout.FixedBytes32()
    var trueBlock = term.trueBlock
    var falseBlock = term.falseBlock
    if overrideSuccessorOrdinal == 0:
        trueBlock = overrideTargetBlockId
    elif overrideSuccessorOrdinal == 1:
        falseBlock = overrideTargetBlockId
    var buf = layout.ByteBufInit(192)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_intent.source_term")
    bodyIRControlActionAppendI32(buf, term.kind)
    bodyIRControlActionAppendI32(buf, term.conditionKind)
    bodyIRControlActionAppendI32(buf, term.resultSlot)
    bodyIRControlActionAppendI32(
        buf, term.sourceDefinitionDomain)
    bodyIRControlActionAppendI32(buf, term.sourceDefinitionRow)
    bodyIRControlActionAppendI32(buf, term.lhsSlot)
    bodyIRControlActionAppendI32(buf, term.rhsSlot)
    bodyIRControlActionAppendI32(buf, trueBlock)
    bodyIRControlActionAppendI32(buf, falseBlock)
    bodyIRControlActionAppendI32(buf, term.operands.len)
    for operandIndex in 0..<term.operands.len:
        bodyIRControlActionAppendI32(
            buf, term.operands[operandIndex])
    bodyIRControlActionAppendI32(buf, successorCount)
    for successorOrdinal in 0..<successorCount:
        let successorRow = successorStart + successorOrdinal
        if successorOrdinal == overrideSuccessorOrdinal:
            bodyIRControlActionAppendI32(
                buf, overrideTargetBlockId)
            bodyIRControlActionAppendI32(buf, overrideEdgeKind)
        else:
            bodyIRControlActionAppendI32(
                buf, bodyIR.successorBlockIds[successorRow])
            bodyIRControlActionAppendI32(
                buf, bodyIR.successorEdgeKinds[successorRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn bodyIRCleanupReferencedTypeFacts(
        bodyIR: BodyIR,
        seen: var bool[]): bool =
    if !BodyIRTypeArenaProofDomainValid(bodyIR) || seen.len != 0:
        return false
    for _ in 0..<bodyIR.typeFactTypeIds.len:
        add(seen, false)
    for slotRow in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotRow]
        if slot.id != slotRow:
            return false
        if slot.typeArenaTypeId < 0:
            # wall62 契约修正（wall62.VERIFY 定性：域级谓词
            # BodyIRLocalSlotTypeArenaProofValid 明文规定
            # typeId==-1 ⟺ managedStorageKind==Unknown 为合法无证明
            # slot 态，BodyIRTypeArenaProofDomainValid 对全 slot 放行
            # 该态）。此处精确镜像域谓词：仅放行保持默认 proof 形的
            # slot 跳过 fact 闭合审计；-1 但 managedStorageKind 非
            # Unknown 的漂移形态仍 fail-closed。有 proof slot 的精确
            # 事实闭合审计不变；无 proof slot 的类型身份仍经
            # typeKind/managedStorageKind/size/align 全量进 control cid。
            if slot.managedStorageKind != BodyManagedStorageUnknownTag:
                return false
            continue
        # [wall135] unmanaged 纯标量 proof 槽镜像放行（wall127 exact_def_freeze
        # 审计镜像 decode 权威先例同构）。定性：本审计域对此形要求 fact 恰一，
        # 但 decode 权威（body_ir_access 全域）对 slot 合法性唯一经
        # BodyIRLocalSlotTypeArenaProofValid 域谓词，明文放行
        # typeId>=0 ∧ storage==Unmanaged 且零 fact 义务；slot proof bind 契约
        # （BodyIRBindLocalSlotTypeArenaProof）同域放行；fact 生产 bind 面
        # （managed store closure/field chain/field hop/new alloc）义务域=
        # 托管 drop-glue 与布局 hop 权威，从不覆盖纯标量槽。三域中唯本审计
        # 滞后（v6 main slot9=int32 unmanaged proof typeId=7 实锤死点）。
        # cleanup control cid 本体已将 slot typeKind/typeArenaTypeId/
        # managedStorageKind/size/align 全量编入，标量槽类型身份不依赖 fact
        # 行。放行谓词精确复用同文件 BodyIRLocalTypePlainNoAliasProof 权威
        # 三族（I32/I64/F64，slot 默认 proof 同源判定），托管族
        # （Str/Ptr/Aggregate）proof 槽的 fact 恰一审计零弱化。放行前仍对
        # 在册匹配 fact 行打 seen（shape 谓词保证 typeId 严格递增 ⇒ 至多一
        # 行），fact 表闭包审计（104/105）语义不变。
        if slot.managedStorageKind == BodyManagedStorageUnmanagedTag &&
           BodyIRLocalTypePlainNoAliasProof(slot.typeKind):
            for typeFactRow in 0..<bodyIR.typeFactTypeIds.len:
                if bodyIR.typeFactTypeIds[typeFactRow] ==
                       slot.typeArenaTypeId:
                    seen[typeFactRow] = true
            continue
        var matchCount: int32
        for typeFactRow in 0..<bodyIR.typeFactTypeIds.len:
            if bodyIR.typeFactTypeIds[typeFactRow] ==
                   slot.typeArenaTypeId:
                seen[typeFactRow] = true
                matchCount = matchCount + 1
        if matchCount != 1:
            return false
    var changed = true
    while changed:
        changed = false
        for typeFactRow in 0..<seen.len:
            if !seen[typeFactRow]:
                continue
            let childTypeId =
                bodyIR.typeFactChildTypeIds[typeFactRow]
            if childTypeId < 0:
                continue
            var childMatchCount: int32
            for childRow in 0..<bodyIR.typeFactTypeIds.len:
                if bodyIR.typeFactTypeIds[childRow] == childTypeId:
                    childMatchCount = childMatchCount + 1
                    if !seen[childRow]:
                        seen[childRow] = true
                        changed = true
            if childMatchCount != 1:
                return false
    for typeFactRow in 0..<seen.len:
        if !seen[typeFactRow]:
            return false
    return true

# wall62 判词富化（w57 九前置逐项诊断先例续）：BodyIRCleanupSourceControlCid
# 零值返回的投影后审计层分支定位。只读复刻，分支序与失败点同源对齐
# （bodyIRCleanupReferencedTypeFacts / slot.id / block.id / term cid /
# cstring id / defer cid），不参与任何守卫判定，仅 cleanup_cfg 失败臂取数。
# 返回 0 = 全部分支通过（与 cid 非零对应）；否则返回首个失败分支：
#   1..9  = 九结构前置（sealed/cf/pd/ed/lb/mc/mr/ef/proj，w57 判词同序）
#   101   = referenced facts: slot.id 行错位（offender=slotRow）
#   102   = referenced facts: slot proof 域谓词漂移（typeId<0 但
#           managedStorageKind != Unknown；offender=slotRow）
#   103   = referenced facts: slot 类型 fact 匹配数 != 1（offender=slotRow）
#   104   = referenced facts: 子类型闭包 fact 匹配数 != 1（offender=factRow）
#   105   = referenced facts: fact 未被 slot 根闭包可达（offender=factRow）
#   20    = slot.id 行错位（buffer 段，offender=slotRow）
#   30    = block.id 行错位（offender=blockRow）
#   40    = term 语义 cid 无效（offender=termRow）
#   50    = cstring literal id 行错位（offender=literalRow）
#   60    = defer 语义 cid 无效（offender=deferId）
@borrows
fn BodyIRCleanupSourceControlFailureStage(
        bodyIR: BodyIR,
        offender: var int32): int32 =
    offender = -1
    if !bodyIR.controlFlowSealed:
        return 1
    if !BodyIRControlFlowShapeValid(bodyIR):
        return 2
    if !BodyIRTypeArenaProofDomainValid(bodyIR):
        return 3
    if !BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        return 4
    if !BodyIRLocalBindingValueDefinitionRowsShapeValid(bodyIR):
        return 5
    if !BodyIRManualConsumeSidecarShapeValid(bodyIR):
        return 6
    if !BodyIRManagedLvalueReplaceSidecarShapeValid(bodyIR):
        return 7
    if !BodyIRExternFfiHandleCapabilitySidecarShapeValid(bodyIR):
        return 8
    if !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSourceProjectionCid):
        return 9
    for slotRow in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotRow]
        if slot.id != slotRow:
            offender = slotRow
            return 101
        if slot.typeArenaTypeId < 0:
            # wall62 起 102 语义 = 域谓词漂移形态（typeId<0 但
            # managedStorageKind != Unknown）；默认 proof 形
            # （-1 ⟺ Unknown）与 bodyIRCleanupReferencedTypeFacts
            # 同步放行。
            if slot.managedStorageKind != BodyManagedStorageUnknownTag:
                offender = slotRow
                return 102
            continue
        # [wall135] 与 bodyIRCleanupReferencedTypeFacts 放行臂同源镜像
        # （wall62 只读复刻同源对齐纪律）：unmanaged 纯标量 proof 槽跳过
        # fact 恰一判定。下方 seen 构造已含标量槽×fact 打标，闭包审计不变。
        if slot.managedStorageKind == BodyManagedStorageUnmanagedTag &&
           BodyIRLocalTypePlainNoAliasProof(slot.typeKind):
            continue
        var matchCount: int32
        for typeFactRow in 0..<bodyIR.typeFactTypeIds.len:
            if bodyIR.typeFactTypeIds[typeFactRow] ==
                   slot.typeArenaTypeId:
                matchCount = matchCount + 1
        if matchCount != 1:
            offender = slotRow
            return 103
    var seen: bool[]
    for _ in 0..<bodyIR.typeFactTypeIds.len:
        add(seen, false)
    for slotRow in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotRow]
        for typeFactRow in 0..<bodyIR.typeFactTypeIds.len:
            if bodyIR.typeFactTypeIds[typeFactRow] ==
                   slot.typeArenaTypeId:
                seen[typeFactRow] = true
    var changed = true
    while changed:
        changed = false
        for typeFactRow in 0..<seen.len:
            if !seen[typeFactRow]:
                continue
            let childTypeId =
                bodyIR.typeFactChildTypeIds[typeFactRow]
            if childTypeId < 0:
                continue
            var childMatchCount: int32
            for childRow in 0..<bodyIR.typeFactTypeIds.len:
                if bodyIR.typeFactTypeIds[childRow] == childTypeId:
                    childMatchCount = childMatchCount + 1
                    if !seen[childRow]:
                        seen[childRow] = true
                        changed = true
            if childMatchCount != 1:
                offender = typeFactRow
                return 104
    for typeFactRow in 0..<seen.len:
        if !seen[typeFactRow]:
            offender = typeFactRow
            return 105
    for slotRow in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[slotRow].id != slotRow:
            offender = slotRow
            return 20
    for blockRow in 0..<bodyIR.blocks.len:
        if bodyIR.blocks[blockRow].id != blockRow:
            offender = blockRow
            return 30
    for termRow in 0..<bodyIR.terms.len:
        let termCid = bodyIRCleanupTermSemanticCid(
            bodyIR, termRow, -1, -1, BodyControlEdgeUnknown)
        if !BodyIRTypeArenaArtifactCidValid(termCid):
            offender = termRow
            return 40
    for literalRow in 0..<bodyIR.cstringLiterals.len:
        if bodyIR.cstringLiterals[literalRow].id != literalRow:
            offender = literalRow
            return 50
    for deferId in 0..<bodyIR.deferDeclarationScopeIds.len:
        let deferSemanticCid =
            BodyIRCleanupDeferSemanticCid(bodyIR, deferId)
        if !BodyIRTypeArenaArtifactCidValid(deferSemanticCid):
            offender = deferId
            return 60
    return 0

@borrows
fn BodyIRBindCleanupSourceProjectionCid(
        bodyIR: var BodyIR,
        projectionCid: layout.FixedBytes32) =
    if !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       !bodyIR.entryDefinitionOwnershipSealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSourceProjectionCid) ||
       !BodyIRTypeArenaArtifactCidValid(projectionCid):
        panic("body ir cleanup source projection: bind invalid")
    bodyIR.cleanupSourceProjectionCid =
        layout.FixedBytes32Copy(projectionCid)

@borrows
fn BodyIRCleanupSourceControlCid(bodyIR: BodyIR): layout.FixedBytes32 =
    if !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       !BodyIRTypeArenaProofDomainValid(bodyIR) ||
       !BodyIREntryDefinitionOwnershipShapeValid(bodyIR) ||
       !BodyIRLocalBindingValueDefinitionRowsShapeValid(bodyIR) ||
       !BodyIRManualConsumeSidecarShapeValid(bodyIR) ||
       !BodyIRManagedLvalueReplaceSidecarShapeValid(bodyIR) ||
       !BodyIRExternFfiHandleCapabilitySidecarShapeValid(bodyIR) ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSourceProjectionCid):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(1024)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_source_control")
    bodyIRControlActionAppendI32(buf, bodyIR.controlFunctionRow)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupSourceProjectionCid)
    layout.ByteBufAppendFixed32(buf, bodyIR.typeArenaArtifactCid)
    layout.ByteBufAppendFixed32(buf, bodyIR.manualConsume.rootCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.managedLvalueReplace.rootCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.externFfiHandleCapabilities.rootCid)
    bodyIRControlActionAppendI32(
        buf, if bodyIR.entryDefinitionOwnershipSealed: 1 else: 0)
    bodyIRControlActionAppendI32(
        buf, bodyIR.entryDefinitionOwnershipKinds.len)
    for ownershipRow in 0..<bodyIR.entryDefinitionOwnershipKinds.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.entryDefinitionOwnershipKinds[ownershipRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.entryDefinitionSemanticRows[ownershipRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.entryParameterSlotIds.len)
    for parameterOrdinal in 0..<bodyIR.entryParameterSlotIds.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.entryParameterSlotIds[parameterOrdinal])
    bodyIRControlActionAppendI32(
        buf, bodyIR.localBindingValueDefinitionDomainStart)
    bodyIRControlActionAppendI32(
        buf, bodyIR.localBindingValueDefinitionDomainCount)
    bodyIRControlActionAppendI32(
        buf, bodyIR.localBindingValueDefinitionRows.len)
    for slotId in 0..<bodyIR.localBindingValueDefinitionRows.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.localBindingValueDefinitionRows[slotId])
    var referencedTypeFacts: bool[]
    if !bodyIRCleanupReferencedTypeFacts(
           bodyIR, referencedTypeFacts):
        layout.ByteBufFree(buf)
        return layout.FixedBytes32()
    var referencedTypeFactCount: int32
    for typeFactRow in 0..<referencedTypeFacts.len:
        if referencedTypeFacts[typeFactRow]:
            referencedTypeFactCount = referencedTypeFactCount + 1
    bodyIRControlActionAppendI32(buf, referencedTypeFactCount)
    for typeFactRow in 0..<bodyIR.typeFactTypeIds.len:
        if !referencedTypeFacts[typeFactRow]:
            continue
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactTypeIds[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactStructuralKinds[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactScalarKinds[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactChildTypeIds[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactFixedLengths[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactSizeBytes[typeFactRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.typeFactAlignBytes[typeFactRow])
    bodyIRControlActionAppendI32(buf, bodyIR.localSlots.len)
    bodyIRControlActionAppendI32(buf, bodyIR.ops.len)
    bodyIRControlActionAppendI32(buf, bodyIR.callSequence.len)
    bodyIRControlActionAppendI32(buf, bodyIR.blocks.len)
    bodyIRControlActionAppendI32(buf, bodyIR.terms.len)
    bodyIRControlActionAppendI32(
        buf, bodyIR.controlScopeParentIds.len)
    for scopeId in 0..<bodyIR.controlScopeParentIds.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.controlScopeParentIds[scopeId])
    for slotRow in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[slotRow]
        if slot.id != slotRow:
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        bodyIRControlActionAppendI32(buf, slotRow)
        bodyIRControlActionAppendI32(buf, slot.typeKind)
        bodyIRControlActionAppendI32(buf, slot.typeArenaTypeId)
        bodyIRControlActionAppendI32(buf, slot.managedStorageKind)
        bodyIRControlActionAppendI32(buf, slot.sizeBytes)
        bodyIRControlActionAppendI32(buf, slot.alignBytes)
    for opRow in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opRow]
        bodyIRControlActionAppendI32(buf, opRow)
        bodyIRControlActionAppendI32(buf, op.kind)
        bodyIRControlActionAppendI32(buf, op.operands.len)
        for operandIndex in 0..<op.operands.len:
            bodyIRControlActionAppendI32(
                buf, op.operands[operandIndex])
        bodyIRControlActionAppendI32(buf, op.target)
        bodyIRControlActionAppendI32(buf, op.valueDefSlot)
        bodyIRControlActionAppendI32(buf, op.valueDefExprNodeIndex)
        bodyIRControlActionAppendI32(buf, op.valueDefSemanticRow)
        bodyIRControlActionAppendI32(
            buf, int32(op.valueDefOwnership))
        bodyIRControlActionAppendI32(
            buf, op.valueDefBorrowOwnerSemanticRow)
        bodyIRControlActionAppendI32(
            buf, op.valueDefBorrowOwnerDefinitionDomain)
        bodyIRControlActionAppendI32(
            buf, op.valueDefBorrowOwnerDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, op.valueDefConsumeOpIndexPlusOne)
        bodyIRControlActionAppendI32(buf, op.valueDefOriginKind)
        bodyIRControlActionAppendI32(buf, op.valueDefOriginId)
        bodyIRControlActionAppendI32(
            buf, op.sourceDefinitionDomain)
        bodyIRControlActionAppendI32(buf, op.sourceDefinitionRow)
        bodyIRControlActionAppendI32(buf, op.consumeActionRow)
    for callRow in 0..<bodyIR.callSequence.len:
        let call = bodyIR.callSequence[callRow]
        bodyIRControlActionAppendI32(buf, callRow)
        bodyIRControlActionAppendI32(
            buf, bodyIR.callTargetDomainKinds[callRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.callTargetRows[callRow])
        layout.ByteBufAppendFixed32(
            buf, bodyIR.callTargetInterfaceCids[callRow])
        bodyIRControlActionAppendI32(buf, call.argSlots.len)
        for argumentIndex in 0..<call.argSlots.len:
            bodyIRControlActionAppendI32(
                buf, call.argSlots[argumentIndex])
            bodyIRControlActionAppendI32(
                buf, call.argPassKinds[argumentIndex])
        bodyIRControlActionAppendI32(buf, call.resultSlot)
        bodyIRControlActionAppendI32(buf, call.resultPassKind)
        bodyIRControlActionAppendI32(
            buf, int32(call.resultOwnership))
        bodyIRControlActionAppendI32(buf, call.resultExprNodeIndex)
        bodyIRControlActionAppendI32(
            buf, call.resultValueDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, call.resultBorrowOwnerValueDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, call.resultBorrowOwnerDefinitionDomain)
        bodyIRControlActionAppendI32(
            buf, call.resultBorrowOwnerDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, call.resultDefinitionOriginKind)
        bodyIRControlActionAppendI32(
            buf, call.resultDefinitionOriginId)
        bodyIRControlActionAppendI32(
            buf, call.sourceDefinitionDomain)
        bodyIRControlActionAppendI32(buf, call.sourceDefinitionRow)
        bodyIRControlActionAppendI32(
            buf, call.semanticCallExprNodeIndex)
        bodyIRControlActionAppendI32(buf, call.consumeActionRow)
        bodyIRControlActionAppendI32(buf, call.managedStoreKind)
        bodyIRControlActionAppendI32(
            buf, call.managedReplaceReceiptRow)
        bodyIRControlActionAppendI32(
            buf, call.managedDropGlueDescriptorRow)
    for blockRow in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockRow]
        if block.id != blockRow:
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        bodyIRControlActionAppendI32(buf, blockRow)
        bodyIRControlActionAppendI32(buf, block.opStart)
        bodyIRControlActionAppendI32(buf, block.opCount)
        bodyIRControlActionAppendI32(buf, block.termIndex)
        bodyIRControlActionAppendI32(
            buf, bodyIR.blockScopeIds[blockRow])
    for termRow in 0..<bodyIR.terms.len:
        let termCid = bodyIRCleanupTermSemanticCid(
            bodyIR, termRow, -1, -1, BodyControlEdgeUnknown)
        if !BodyIRTypeArenaArtifactCidValid(termCid):
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        bodyIRControlActionAppendI32(buf, termRow)
        layout.ByteBufAppendFixed32(buf, termCid)
    bodyIRControlActionAppendI32(buf, bodyIR.cstringLiterals.len)
    for literalRow in 0..<bodyIR.cstringLiterals.len:
        let literal = bodyIR.cstringLiterals[literalRow]
        if literal.id != literalRow:
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        bodyIRControlActionAppendI32(buf, literalRow)
        bodyIRControlActionAppendText(buf, literal.text)
    bodyIRControlActionAppendI32(
        buf, bodyIR.deferDeclarationScopeIds.len)
    for deferId in 0..<bodyIR.deferDeclarationScopeIds.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferDeclarationScopeIds[deferId])
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferSuiteScopeIds[deferId])
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferLexicalOrdinals[deferId])
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferFunctionRows[deferId])
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferStatementRows[deferId])
        let deferSemanticCid =
            BodyIRCleanupDeferSemanticCid(bodyIR, deferId)
        if !BodyIRTypeArenaArtifactCidValid(deferSemanticCid):
            layout.ByteBufFree(buf)
            return layout.FixedBytes32()
        layout.ByteBufAppendFixed32(buf, deferSemanticCid)
    bodyIRControlActionAppendI32(
        buf, bodyIR.deferActivationSiteBlockIds.len)
    for siteId in 0..<bodyIR.deferActivationSiteBlockIds.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferActivationSiteBlockIds[siteId])
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferActivationSiteAfterOpOrdinals[siteId])
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferActivationSiteStarts[siteId])
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferActivationSiteCounts[siteId])
    bodyIRControlActionAppendI32(buf, bodyIR.deferActivationRows.len)
    for activationRow in 0..<bodyIR.deferActivationRows.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.deferActivationRows[activationRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn bodyIRCleanupDeferActivationSlot(bodyIR: BodyIR,
                                    deferId: int32): int32 =
    if deferId < 0 || deferId >= bodyIR.deferActionCids.len:
        return -1
    var foundSlot: int32 = -1
    for siteId in 0..<bodyIR.deferActivationSiteBlockIds.len:
        let blockId = bodyIR.deferActivationSiteBlockIds[siteId]
        let start = bodyIR.deferActivationSiteStarts[siteId]
        let count = bodyIR.deferActivationSiteCounts[siteId]
        let afterOpOrdinal =
            bodyIR.deferActivationSiteAfterOpOrdinals[siteId]
        if blockId < 0 || blockId >= bodyIR.blocks.len ||
           start < 0 || count <= 0 ||
           count > bodyIR.deferActivationRows.len - start ||
           afterOpOrdinal < count ||
           afterOpOrdinal > bodyIR.blocks[blockId].opCount:
            return -1
        for rowOffset in 0..<count:
            if bodyIR.deferActivationRows[start + rowOffset] !=
                   deferId:
                continue
            if foundSlot >= 0:
                return -1
            let opRow = bodyIR.blocks[blockId].opStart +
                        afterOpOrdinal - count + rowOffset
            if opRow < 0 || opRow >= bodyIR.ops.len:
                return -1
            let op = bodyIR.ops[opRow]
            if op.kind != BodyOpLoadConstTag ||
               op.target < 0 || op.target >= bodyIR.localSlots.len ||
               bodyIR.localSlots[op.target].typeKind != LocalI32Tag ||
               op.operands.len != 2 ||
               op.operands[0] != LocalI32Tag ||
               op.operands[1] != 1 ||
               op.valueDefSlot != -1 ||
               op.valueDefExprNodeIndex != -1 ||
               op.valueDefSemanticRow != -1 ||
               op.valueDefOwnership != OwnInvalid ||
               op.valueDefBorrowOwnerSemanticRow != -1 ||
               op.valueDefBorrowOwnerDefinitionDomain !=
                   BodyDefinitionDomainInvalidTag ||
               op.valueDefBorrowOwnerDefinitionRow != -1 ||
               op.valueDefConsumeOpIndexPlusOne != 0 ||
               op.valueDefOriginKind !=
                   BodyDefinitionOriginUnknownTag ||
               op.valueDefOriginId != -1 ||
               op.sourceDefinitionDomain !=
                   BodyDefinitionDomainInvalidTag ||
               op.sourceDefinitionRow != -1 ||
               op.consumeActionRow != -1:
                return -1
            foundSlot = op.target
    return foundSlot

@borrows
fn bodyIRCleanupCommonScope(bodyIR: BodyIR,
                            sourceScopeId: int32,
                            targetScopeId: int32): int32 =
    if sourceScopeId < 0 ||
       sourceScopeId >= bodyIR.controlScopeParentIds.len ||
       targetScopeId < 0 ||
       targetScopeId >= bodyIR.controlScopeParentIds.len:
        return -1
    var sourceAncestors: bool[]
    for _ in 0..<bodyIR.controlScopeParentIds.len:
        add(sourceAncestors, false)
    var current = sourceScopeId
    while current >= 0:
        sourceAncestors[current] = true
        current = bodyIR.controlScopeParentIds[current]
    current = targetScopeId
    while current >= 0:
        if sourceAncestors[current]:
            return current
        current = bodyIR.controlScopeParentIds[current]
    return -1

@borrows
fn bodyIRCleanupAppendI32Rows(
        buf: var layout.ByteBuf,
        rows: int32[]) =
    bodyIRControlActionAppendI32(buf, rows.len)
    for row in 0..<rows.len:
        bodyIRControlActionAppendI32(buf, rows[row])

@borrows
fn bodyIRCleanupAppendFixed32Rows(
        buf: var layout.ByteBuf,
        rows: layout.FixedBytes32[]) =
    bodyIRControlActionAppendI32(buf, rows.len)
    for row in 0..<rows.len:
        layout.ByteBufAppendFixed32(buf, rows[row])

fn BodyIRCleanupConditionKindValid(kind: int32): bool =
    return kind == BodyCondLocalNonZeroTag ||
           kind == BodyCondLocalZeroTag

fn BodyIRCleanupClearKindValid(kind: int32): bool =
    return kind == BodyCleanupClearLocalZeroTag

fn BodyIRCleanupIntentSidecarNew(): BodyIRCleanupIntentSidecar =
    var out: BodyIRCleanupIntentSidecar
    # wall69: 大结构构造器逐字段显式落定。seq 用描述符直写
    # (len=0/cap=0/buffer=nil, 纯 store 无 rc 语义)——「= []」空列赋值带
    # release 旧值语义, 对未初始化槽=release 垃圾描述符, 与栈复用残留叠加
    # 即误释放真实堆块 (cold_nested 编译期 use-after-free 实证)。
    out.building = false
    out.sealed = false
    out.rootCid = layout.FixedBytes32()
    out.sourceControlCid = layout.FixedBytes32()
    out.ownershipIrCid = layout.FixedBytes32()
    out.ownershipAnalysisCid = layout.FixedBytes32()
    out.originalLocalCount = 0
    out.originalOpCount = 0
    out.originalCallCount = 0
    out.originalBlockCount = 0
    out.originalTermCount = 0
    out.sourceBlockIds.len = 0
    out.sourceBlockIds.cap = 0
    out.sourceBlockIds.buffer = nil
    out.sourceTermRows.len = 0
    out.sourceTermRows.cap = 0
    out.sourceTermRows.buffer = nil
    out.sourceTermCids.len = 0
    out.sourceTermCids.cap = 0
    out.sourceTermCids.buffer = nil
    out.sourceSuccessorOrdinals.len = 0
    out.sourceSuccessorOrdinals.cap = 0
    out.sourceSuccessorOrdinals.buffer = nil
    out.originalSuccessorCounts.len = 0
    out.originalSuccessorCounts.cap = 0
    out.originalSuccessorCounts.buffer = nil
    out.sourceExitKinds.len = 0
    out.sourceExitKinds.cap = 0
    out.sourceExitKinds.buffer = nil
    out.originalTargetBlockIds.len = 0
    out.originalTargetBlockIds.cap = 0
    out.originalTargetBlockIds.buffer = nil
    out.originalEdgeKinds.len = 0
    out.originalEdgeKinds.cap = 0
    out.originalEdgeKinds.buffer = nil
    out.sourceScopeIds.len = 0
    out.sourceScopeIds.cap = 0
    out.sourceScopeIds.buffer = nil
    out.targetScopeIds.len = 0
    out.targetScopeIds.cap = 0
    out.targetScopeIds.buffer = nil
    out.exitOwnershipEdgeIds.len = 0
    out.exitOwnershipEdgeIds.cap = 0
    out.exitOwnershipEdgeIds.buffer = nil
    out.selectedDeferStarts.len = 0
    out.selectedDeferStarts.cap = 0
    out.selectedDeferStarts.buffer = nil
    out.selectedDeferCounts.len = 0
    out.selectedDeferCounts.cap = 0
    out.selectedDeferCounts.buffer = nil
    out.exitUnitStarts.len = 0
    out.exitUnitStarts.cap = 0
    out.exitUnitStarts.buffer = nil
    out.exitUnitCounts.len = 0
    out.exitUnitCounts.cap = 0
    out.exitUnitCounts.buffer = nil
    out.siteOriginalBlockIds.len = 0
    out.siteOriginalBlockIds.cap = 0
    out.siteOriginalBlockIds.buffer = nil
    out.siteAfterOpOrdinals.len = 0
    out.siteAfterOpOrdinals.cap = 0
    out.siteAfterOpOrdinals.buffer = nil
    out.siteOwnershipOpStarts.len = 0
    out.siteOwnershipOpStarts.cap = 0
    out.siteOwnershipOpStarts.buffer = nil
    out.siteOwnershipOpCounts.len = 0
    out.siteOwnershipOpCounts.cap = 0
    out.siteOwnershipOpCounts.buffer = nil
    out.siteUnitStarts.len = 0
    out.siteUnitStarts.cap = 0
    out.siteUnitStarts.buffer = nil
    out.siteUnitCounts.len = 0
    out.siteUnitCounts.cap = 0
    out.siteUnitCounts.buffer = nil
    out.ownershipOpRows.len = 0
    out.ownershipOpRows.cap = 0
    out.ownershipOpRows.buffer = nil
    out.selectedDeferIds.len = 0
    out.selectedDeferIds.cap = 0
    out.selectedDeferIds.buffer = nil
    out.unitKinds.len = 0
    out.unitKinds.cap = 0
    out.unitKinds.buffer = nil
    out.unitSemanticDomains.len = 0
    out.unitSemanticDomains.cap = 0
    out.unitSemanticDomains.buffer = nil
    out.unitSemanticStarts.len = 0
    out.unitSemanticStarts.cap = 0
    out.unitSemanticStarts.buffer = nil
    out.unitSemanticCounts.len = 0
    out.unitSemanticCounts.cap = 0
    out.unitSemanticCounts.buffer = nil
    out.unitSnapshotSourceSlotStarts.len = 0
    out.unitSnapshotSourceSlotStarts.cap = 0
    out.unitSnapshotSourceSlotStarts.buffer = nil
    out.unitSnapshotSourceSlotCounts.len = 0
    out.unitSnapshotSourceSlotCounts.cap = 0
    out.unitSnapshotSourceSlotCounts.buffer = nil
    out.unitConditionStarts.len = 0
    out.unitConditionStarts.cap = 0
    out.unitConditionStarts.buffer = nil
    out.unitConditionCounts.len = 0
    out.unitConditionCounts.cap = 0
    out.unitConditionCounts.buffer = nil
    out.unitClearStarts.len = 0
    out.unitClearStarts.cap = 0
    out.unitClearStarts.buffer = nil
    out.unitClearCounts.len = 0
    out.unitClearCounts.cap = 0
