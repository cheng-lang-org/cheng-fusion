    BodyIRDodSoAContractReport =
        ok: bool
        indexWidthBits: int32
        independentArrayCount: int32
        flatScalarArrayCount: int32
        flatStringArrayCount: int32
        flatFixedBytes32ArrayCount: int32
        nestedPayloadArrayCount: int32
        phaseArenaResetCount: int32
        phaseArenaGeneration: int32
        phaseArenaLive: bool
        phaseArenaReserveCount: int32
        phaseArenaCapacityBytes: int64
        phaseArenaUsedBytes: int64
        phaseArenaPeakBytes: int64
        phaseArenaSpillCount: int32
        opCount: int32
        callCount: int32
        localCount: int32
        blockCount: int32
