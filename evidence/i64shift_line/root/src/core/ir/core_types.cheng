@borrows
fn BodyIRCleanupIntentSidecarRowsAligned(
        sidecar: BodyIRCleanupIntentSidecar): bool =
    let exitCount = sidecar.sourceBlockIds.len
    let siteCount = sidecar.siteOriginalBlockIds.len
    let unitCount = sidecar.unitKinds.len
    let snapshotCount = sidecar.snapshotSourceSlotIds.len
    let conditionCount = sidecar.conditionKinds.len
    let clearCount = sidecar.clearKinds.len
    return sidecar.sourceTermRows.len == exitCount &&
           sidecar.sourceTermCids.len == exitCount &&
           sidecar.sourceSuccessorOrdinals.len == exitCount &&
           sidecar.originalSuccessorCounts.len == exitCount &&
           sidecar.sourceExitKinds.len == exitCount &&
           sidecar.originalTargetBlockIds.len == exitCount &&
           sidecar.originalEdgeKinds.len == exitCount &&
           sidecar.sourceScopeIds.len == exitCount &&
           sidecar.targetScopeIds.len == exitCount &&
           sidecar.exitOwnershipEdgeIds.len == exitCount &&
           sidecar.selectedDeferStarts.len == exitCount &&
           sidecar.selectedDeferCounts.len == exitCount &&
           sidecar.exitUnitStarts.len == exitCount &&
           sidecar.exitUnitCounts.len == exitCount &&
           sidecar.siteAfterOpOrdinals.len == siteCount &&
           sidecar.siteOwnershipOpStarts.len == siteCount &&
           sidecar.siteOwnershipOpCounts.len == siteCount &&
           sidecar.siteUnitStarts.len == siteCount &&
           sidecar.siteUnitCounts.len == siteCount &&
           sidecar.unitSemanticDomains.len == unitCount &&
           sidecar.unitSemanticStarts.len == unitCount &&
           sidecar.unitSemanticCounts.len == unitCount &&
           sidecar.unitSnapshotSourceSlotStarts.len == unitCount &&
           sidecar.unitSnapshotSourceSlotCounts.len == unitCount &&
           sidecar.unitConditionStarts.len == unitCount &&
           sidecar.unitConditionCounts.len == unitCount &&
           sidecar.unitClearStarts.len == unitCount &&
           sidecar.unitClearCounts.len == unitCount &&
           sidecar.unitAuthorityCids.len == unitCount &&
           sidecar.snapshotProjectionPolicies.len == snapshotCount &&
           sidecar.snapshotSemanticRows.len == snapshotCount &&
           sidecar.snapshotTypeArenaTypeIds.len == snapshotCount &&
           sidecar.snapshotInterfaceCids.len == snapshotCount &&
           sidecar.conditionInputSourceSlotIds.len == conditionCount &&
           sidecar.conditionSemanticRows.len == conditionCount &&
           sidecar.conditionSemanticOrdinals.len == conditionCount &&
           sidecar.clearTargetSourceSlotIds.len == clearCount &&
           sidecar.clearSemanticRows.len == clearCount &&
           sidecar.clearSemanticOrdinals.len == clearCount

@borrows
fn BodyIRCleanupIntentSidecarHasPhysicalStorage(
        sidecar: BodyIRCleanupIntentSidecar): bool =
    return sidecar.sourceBlockIds.cap > 0 ||
           sidecar.sourceTermRows.cap > 0 ||
           sidecar.sourceTermCids.cap > 0 ||
           sidecar.sourceSuccessorOrdinals.cap > 0 ||
           sidecar.originalSuccessorCounts.cap > 0 ||
           sidecar.sourceExitKinds.cap > 0 ||
           sidecar.originalTargetBlockIds.cap > 0 ||
           sidecar.originalEdgeKinds.cap > 0 ||
           sidecar.sourceScopeIds.cap > 0 ||
           sidecar.targetScopeIds.cap > 0 ||
           sidecar.exitOwnershipEdgeIds.cap > 0 ||
           sidecar.selectedDeferStarts.cap > 0 ||
           sidecar.selectedDeferCounts.cap > 0 ||
           sidecar.exitUnitStarts.cap > 0 ||
           sidecar.exitUnitCounts.cap > 0 ||
           sidecar.siteOriginalBlockIds.cap > 0 ||
           sidecar.siteAfterOpOrdinals.cap > 0 ||
           sidecar.siteOwnershipOpStarts.cap > 0 ||
           sidecar.siteOwnershipOpCounts.cap > 0 ||
           sidecar.siteUnitStarts.cap > 0 ||
           sidecar.siteUnitCounts.cap > 0 ||
           sidecar.ownershipOpRows.cap > 0 ||
           sidecar.selectedDeferIds.cap > 0 ||
           sidecar.unitKinds.cap > 0 ||
           sidecar.unitSemanticDomains.cap > 0 ||
           sidecar.unitSemanticStarts.cap > 0 ||
           sidecar.unitSemanticCounts.cap > 0 ||
           sidecar.unitSnapshotSourceSlotStarts.cap > 0 ||
           sidecar.unitSnapshotSourceSlotCounts.cap > 0 ||
           sidecar.unitConditionStarts.cap > 0 ||
           sidecar.unitConditionCounts.cap > 0 ||
           sidecar.unitClearStarts.cap > 0 ||
           sidecar.unitClearCounts.cap > 0 ||
           sidecar.unitAuthorityCids.cap > 0 ||
           sidecar.snapshotSourceSlotIds.cap > 0 ||
           sidecar.snapshotProjectionPolicies.cap > 0 ||
           sidecar.snapshotSemanticRows.cap > 0 ||
           sidecar.snapshotTypeArenaTypeIds.cap > 0 ||
           sidecar.snapshotInterfaceCids.cap > 0 ||
           sidecar.conditionKinds.cap > 0 ||
           sidecar.conditionInputSourceSlotIds.cap > 0 ||
           sidecar.conditionSemanticRows.cap > 0 ||
           sidecar.conditionSemanticOrdinals.cap > 0 ||
           sidecar.clearKinds.cap > 0 ||
           sidecar.clearTargetSourceSlotIds.cap > 0 ||
           sidecar.clearSemanticRows.cap > 0 ||
           sidecar.clearSemanticOrdinals.cap > 0

@borrows
fn BodyIRCleanupIntentSidecarIsCanonicalEmpty(
        sidecar: BodyIRCleanupIntentSidecar): bool =
    return !sidecar.building && !sidecar.sealed &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.rootCid) &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.sourceControlCid) &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.ownershipIrCid) &&
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.ownershipAnalysisCid) &&
           sidecar.originalLocalCount == 0 &&
           sidecar.originalOpCount == 0 &&
           sidecar.originalCallCount == 0 &&
           sidecar.originalBlockCount == 0 &&
           sidecar.originalTermCount == 0 &&
           sidecar.sourceBlockIds.len == 0 &&
           sidecar.siteOriginalBlockIds.len == 0 &&
           sidecar.ownershipOpRows.len == 0 &&
           sidecar.selectedDeferIds.len == 0 &&
           sidecar.unitKinds.len == 0 &&
           sidecar.snapshotSourceSlotIds.len == 0 &&
           sidecar.conditionKinds.len == 0 &&
           sidecar.clearKinds.len == 0 &&
           BodyIRCleanupIntentSidecarRowsAligned(sidecar) &&
           !BodyIRCleanupIntentSidecarHasPhysicalStorage(sidecar)

@borrows
fn bodyIRCleanupIntentMoveSourceValid(
        sidecar: BodyIRCleanupIntentSidecar): bool =
    return BodyIRCleanupIntentSidecarIsCanonicalEmpty(sidecar) ||
           ((sidecar.building || sidecar.sealed) &&
            !(sidecar.building && sidecar.sealed) &&
            BodyIRCleanupIntentSidecarRowsAligned(sidecar))

fn BodyIRCleanupIntentSidecarMoveInto(
        destination: var BodyIRCleanupIntentSidecar,
        source: var BodyIRCleanupIntentSidecar) =
    if !BodyIRCleanupIntentSidecarIsCanonicalEmpty(destination) ||
       BodyIRCleanupIntentSidecarHasPhysicalStorage(destination) ||
       !bodyIRCleanupIntentMoveSourceValid(source):
        panic("body ir cleanup intent: move state invalid")
    destination = source
    source = BodyIRCleanupIntentSidecarNew()
    if !BodyIRCleanupIntentSidecarIsCanonicalEmpty(source) ||
       !bodyIRCleanupIntentMoveSourceValid(destination):
        panic("body ir cleanup intent: move receipt invalid")

@borrows
fn bodyIRCleanupIntentOwnerRange(
        sidecar: BodyIRCleanupIntentSidecar,
        ownerDomain: int32,
        ownerRow: int32,
        startOut: var int32,
        countOut: var int32): bool =
    startOut = -1
    countOut = -1
    if ownerDomain == BodyCleanupUnitOwnerExitTag:
        if ownerRow < 0 || ownerRow >= sidecar.exitUnitStarts.len:
            return false
        startOut = sidecar.exitUnitStarts[ownerRow]
        countOut = sidecar.exitUnitCounts[ownerRow]
        return true
    if ownerDomain == BodyCleanupUnitOwnerOpSiteTag:
        if ownerRow < 0 || ownerRow >= sidecar.siteUnitStarts.len:
            return false
        startOut = sidecar.siteUnitStarts[ownerRow]
        countOut = sidecar.siteUnitCounts[ownerRow]
        return true
    return false

@borrows
fn bodyIRCleanupIntentUnitOwner(
        sidecar: BodyIRCleanupIntentSidecar,
        unitRow: int32,
        ownerDomainOut: var int32,
        ownerRowOut: var int32,
        ownerOrdinalOut: var int32): bool =
    ownerDomainOut = 0
    ownerRowOut = -1
    ownerOrdinalOut = -1
    if unitRow < 0 || unitRow >= sidecar.unitKinds.len:
        return false
    for exitRow in 0..<sidecar.exitUnitStarts.len:
        let start = sidecar.exitUnitStarts[exitRow]
        let count = sidecar.exitUnitCounts[exitRow]
        if unitRow >= start && unitRow < start + count:
            ownerDomainOut = BodyCleanupUnitOwnerExitTag
            ownerRowOut = exitRow
            ownerOrdinalOut = unitRow - start
            return true
    for siteRow in 0..<sidecar.siteUnitStarts.len:
        let start = sidecar.siteUnitStarts[siteRow]
        let count = sidecar.siteUnitCounts[siteRow]
        if unitRow >= start && unitRow < start + count:
            ownerDomainOut = BodyCleanupUnitOwnerOpSiteTag
            ownerRowOut = siteRow
            ownerOrdinalOut = unitRow - start
            return true
    return false

@borrows
fn bodyIRCleanupIntentLastOwnerComplete(
        sidecar: BodyIRCleanupIntentSidecar): bool =
    if sidecar.siteOriginalBlockIds.len > 0:
        let ownerRow = sidecar.siteOriginalBlockIds.len - 1
        let count = sidecar.siteUnitCounts[ownerRow]
        if count <= 0:
            return false
        return BodyIRTypeArenaArtifactCidValid(
            sidecar.unitAuthorityCids[
                sidecar.siteUnitStarts[ownerRow] + count - 1])
    if sidecar.sourceBlockIds.len > 0:
        let ownerRow = sidecar.sourceBlockIds.len - 1
        let count = sidecar.exitUnitCounts[ownerRow]
        if count <= 0:
            return false
        return BodyIRTypeArenaArtifactCidValid(
            sidecar.unitAuthorityCids[
                sidecar.exitUnitStarts[ownerRow] + count - 1])
    return true

@borrows
fn bodyIRCleanupIntentOwnerIsLatest(
        sidecar: BodyIRCleanupIntentSidecar,
        ownerDomain: int32,
        ownerRow: int32): bool =
    if sidecar.siteOriginalBlockIds.len > 0:
        return ownerDomain == BodyCleanupUnitOwnerOpSiteTag &&
               ownerRow == sidecar.siteOriginalBlockIds.len - 1
    return ownerDomain == BodyCleanupUnitOwnerExitTag &&
           ownerRow == sidecar.sourceBlockIds.len - 1

fn BodyIRCleanupIntentBegin(
        bodyIR: var BodyIR,
        sourceControlCid: layout.FixedBytes32,
        ownershipIrCid: layout.FixedBytes32,
        ownershipAnalysisCid: layout.FixedBytes32) =
    if !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       !BodyIRCleanupIntentSidecarIsCanonicalEmpty(
           bodyIR.cleanupIntent) ||
       !BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
           bodyIR.cleanupSchedule) ||
       !BodyIRDeferReplaySidecarIsCanonicalEmpty(
           bodyIR.deferReplay) ||
       !BodyIRTypeArenaArtifactCidValid(sourceControlCid) ||
       !BodyIRTypeArenaArtifactCidValid(ownershipIrCid) ||
       !BodyIRTypeArenaArtifactCidValid(ownershipAnalysisCid) ||
       !layout.FixedBytes32Equal(
           sourceControlCid, BodyIRCleanupSourceControlCid(bodyIR)):
        panic("body ir cleanup intent: external authority invalid")
    bodyIR.cleanupIntent.building = true
    bodyIR.cleanupIntent.sourceControlCid =
        layout.FixedBytes32Copy(sourceControlCid)
    bodyIR.cleanupIntent.ownershipIrCid =
        layout.FixedBytes32Copy(ownershipIrCid)
    bodyIR.cleanupIntent.ownershipAnalysisCid =
        layout.FixedBytes32Copy(ownershipAnalysisCid)
    bodyIR.cleanupIntent.originalLocalCount = bodyIR.localSlots.len
    bodyIR.cleanupIntent.originalOpCount = bodyIR.ops.len
    bodyIR.cleanupIntent.originalCallCount =
        bodyIR.callSequence.len
    bodyIR.cleanupIntent.originalBlockCount = bodyIR.blocks.len
    bodyIR.cleanupIntent.originalTermCount = bodyIR.terms.len

@borrows
fn bodyIRCleanupIntentDeferAlreadySelected(
        sidecar: BodyIRCleanupIntentSidecar,
        selectedStart: int32,
        selectedCount: int32,
        deferId: int32): bool =
    for offset in 0..<selectedCount:
        if sidecar.selectedDeferIds[selectedStart + offset] == deferId:
            return true
    return false

fn bodyIRCleanupIntentAppendSelectedDefers(
        bodyIR: var BodyIR,
        sourceScopeId: int32,
        targetScopeId: int32,
        sourceExitKind: int32): int32 =
    let selectedStart = bodyIR.cleanupIntent.selectedDeferIds.len
    var stopScopeId: int32 = -1
    if sourceExitKind == BodyDeferReplaySourceSuccessorTag:
        stopScopeId = bodyIRCleanupCommonScope(
            bodyIR, sourceScopeId, targetScopeId)
        if stopScopeId < 0:
            panic("body ir cleanup intent: common scope missing")
    var selectedCount: int32
    var currentScopeId = sourceScopeId
    while currentScopeId != stopScopeId:
        var scopeDeferCount: int32
        for deferId in 0..<bodyIR.deferDeclarationScopeIds.len:
            if bodyIR.deferDeclarationScopeIds[deferId] ==
                   currentScopeId:
                scopeDeferCount = scopeDeferCount + 1
        var emittedInScope: int32
        while emittedInScope < scopeDeferCount:
            var selectedDeferId: int32 = -1
            var selectedLexicalOrdinal: int32 = -1
            for deferId in 0..<bodyIR.deferDeclarationScopeIds.len:
                if bodyIR.deferDeclarationScopeIds[deferId] !=
                       currentScopeId ||
                   bodyIRCleanupIntentDeferAlreadySelected(
                       bodyIR.cleanupIntent,
                       selectedStart,
                       selectedCount,
                       deferId):
                    continue
                if selectedDeferId < 0 ||
                   bodyIR.deferLexicalOrdinals[deferId] >
                       selectedLexicalOrdinal:
                    selectedDeferId = deferId
                    selectedLexicalOrdinal =
                        bodyIR.deferLexicalOrdinals[deferId]
            if selectedDeferId < 0 ||
               bodyIRCleanupDeferActivationSlot(
                   bodyIR, selectedDeferId) < 0:
                panic(
                    "body ir cleanup intent: defer activation missing")
            add(bodyIR.cleanupIntent.selectedDeferIds,
                selectedDeferId)
            selectedCount = selectedCount + 1
            emittedInScope = emittedInScope + 1
        if currentScopeId < 0 ||
           currentScopeId >= bodyIR.controlScopeParentIds.len:
            panic("body ir cleanup intent: scope chain invalid")
        currentScopeId =
            bodyIR.controlScopeParentIds[currentScopeId]
    return selectedCount

fn BodyIRCleanupIntentAppendExit(
        bodyIR: var BodyIR,
        sourceBlockId: int32,
        sourceSuccessorOrdinal: int32,
        ownershipEdgeId: int32): int32 =
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.rootCid) ||
       !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.cleanupIntent.siteOriginalBlockIds.len != 0 ||
       !bodyIRCleanupIntentLastOwnerComplete(
           bodyIR.cleanupIntent) ||
       sourceBlockId < 0 ||
       sourceBlockId >= bodyIR.cleanupIntent.originalBlockCount ||
       ownershipEdgeId < -1:
        panic("body ir cleanup intent: exit append state invalid")
    let exitRow = bodyIR.cleanupIntent.sourceBlockIds.len
    if exitRow > 0:
        let priorRow = exitRow - 1
        if sourceBlockId <
               bodyIR.cleanupIntent.sourceBlockIds[priorRow] ||
           (sourceBlockId ==
                bodyIR.cleanupIntent.sourceBlockIds[priorRow] &&
            sourceSuccessorOrdinal <=
                bodyIR.cleanupIntent.sourceSuccessorOrdinals[priorRow]):
            panic("body ir cleanup intent: exit order invalid")
    if ownershipEdgeId >= 0:
        for priorRow in 0..<bodyIR.cleanupIntent.exitOwnershipEdgeIds.len:
            if bodyIR.cleanupIntent.exitOwnershipEdgeIds[priorRow] ==
                   ownershipEdgeId:
                panic("body ir cleanup intent: ownership edge duplicate")
    let sourceTermRow = bodyIR.blocks[sourceBlockId].termIndex
    if !bodyIRCleanupTermSuccessorSliceValid(bodyIR, sourceTermRow):
        panic("body ir cleanup intent: source term invalid")
    let sourceTerm = bodyIR.terms[sourceTermRow]
    let successorStart = bodyIR.termSuccessorStarts[sourceTermRow]
    let successorCount = bodyIR.termSuccessorCounts[sourceTermRow]
    var sourceExitKind: int32
    var originalTargetBlockId: int32 = -1
    var originalEdgeKind = BodyControlEdgeReturn
    var targetScopeId: int32 = -1
    if sourceTerm.kind == BodyTermReturnTag:
        if sourceSuccessorOrdinal != 0 || successorCount != 0:
            panic("body ir cleanup intent: return exit invalid")
        sourceExitKind = BodyDeferReplaySourceReturnExitTag
    else:
        if sourceSuccessorOrdinal < 0 ||
           sourceSuccessorOrdinal >= successorCount:
            panic("body ir cleanup intent: successor invalid")
        sourceExitKind = BodyDeferReplaySourceSuccessorTag
        let successorRow = successorStart + sourceSuccessorOrdinal
        originalTargetBlockId =
            bodyIR.successorBlockIds[successorRow]
        originalEdgeKind = bodyIR.successorEdgeKinds[successorRow]
        if originalTargetBlockId < 0 ||
           originalTargetBlockId >=
               bodyIR.cleanupIntent.originalBlockCount ||
           !BodyIRControlEdgeKindValid(originalEdgeKind) ||
           originalEdgeKind == BodyControlEdgeReturn:
            panic("body ir cleanup intent: original edge invalid")
        targetScopeId =
            bodyIR.blockScopeIds[originalTargetBlockId]
    let sourceScopeId = bodyIR.blockScopeIds[sourceBlockId]
    let sourceTermCid = bodyIRCleanupTermSemanticCid(
        bodyIR, sourceTermRow, -1, -1, BodyControlEdgeUnknown)
    if !BodyIRTypeArenaArtifactCidValid(sourceTermCid):
        panic("body ir cleanup intent: source term cid invalid")
    add(bodyIR.cleanupIntent.sourceBlockIds, sourceBlockId)
    add(bodyIR.cleanupIntent.sourceTermRows, sourceTermRow)
    add(bodyIR.cleanupIntent.sourceTermCids, sourceTermCid)
    add(bodyIR.cleanupIntent.sourceSuccessorOrdinals,
        sourceSuccessorOrdinal)
    add(bodyIR.cleanupIntent.originalSuccessorCounts,
        successorCount)
    add(bodyIR.cleanupIntent.sourceExitKinds, sourceExitKind)
    add(bodyIR.cleanupIntent.originalTargetBlockIds,
        originalTargetBlockId)
    add(bodyIR.cleanupIntent.originalEdgeKinds, originalEdgeKind)
    add(bodyIR.cleanupIntent.sourceScopeIds, sourceScopeId)
    add(bodyIR.cleanupIntent.targetScopeIds, targetScopeId)
    add(bodyIR.cleanupIntent.exitOwnershipEdgeIds, ownershipEdgeId)
    add(bodyIR.cleanupIntent.selectedDeferStarts,
        bodyIR.cleanupIntent.selectedDeferIds.len)
    let selectedCount = bodyIRCleanupIntentAppendSelectedDefers(
        bodyIR, sourceScopeId, targetScopeId, sourceExitKind)
    add(bodyIR.cleanupIntent.selectedDeferCounts, selectedCount)
    add(bodyIR.cleanupIntent.exitUnitStarts,
        bodyIR.cleanupIntent.unitKinds.len)
    add(bodyIR.cleanupIntent.exitUnitCounts, 0)
    return exitRow

fn BodyIRCleanupIntentAppendOpSite(
        bodyIR: var BodyIR,
        originalBlockId: int32,
        afterOpOrdinal: int32,
        ownershipOpRows: var int32[]): int32 =
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.rootCid) ||
       !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       !bodyIRCleanupIntentLastOwnerComplete(
           bodyIR.cleanupIntent) ||
       originalBlockId < 0 ||
       originalBlockId >= bodyIR.cleanupIntent.originalBlockCount ||
       afterOpOrdinal < 0 ||
       afterOpOrdinal > bodyIR.blocks[originalBlockId].opCount ||
       ownershipOpRows.len <= 0:
        panic("body ir cleanup intent: op-site append state invalid")
    let siteRow = bodyIR.cleanupIntent.siteOriginalBlockIds.len
    if siteRow > 0:
        let priorRow = siteRow - 1
        let priorBlock =
            bodyIR.cleanupIntent.siteOriginalBlockIds[priorRow]
        let priorOrdinal =
            bodyIR.cleanupIntent.siteAfterOpOrdinals[priorRow]
        if originalBlockId < priorBlock ||
           (originalBlockId == priorBlock &&
            afterOpOrdinal <= priorOrdinal):
            panic("body ir cleanup intent: op-site order invalid")
    for offset in 0..<ownershipOpRows.len:
        let ownershipOpRow = ownershipOpRows[offset]
        if ownershipOpRow < 0 ||
           (offset > 0 &&
            ownershipOpRow <= ownershipOpRows[offset - 1]):
            panic("body ir cleanup intent: ownership op order invalid")
        for priorRow in 0..<bodyIR.cleanupIntent.ownershipOpRows.len:
            if bodyIR.cleanupIntent.ownershipOpRows[priorRow] ==
                   ownershipOpRow:
                panic("body ir cleanup intent: ownership op duplicate")
    add(bodyIR.cleanupIntent.siteOriginalBlockIds, originalBlockId)
    add(bodyIR.cleanupIntent.siteAfterOpOrdinals, afterOpOrdinal)
    add(bodyIR.cleanupIntent.siteOwnershipOpStarts,
        bodyIR.cleanupIntent.ownershipOpRows.len)
    add(bodyIR.cleanupIntent.siteOwnershipOpCounts,
        ownershipOpRows.len)
    for offset in 0..<ownershipOpRows.len:
        add(bodyIR.cleanupIntent.ownershipOpRows,
            ownershipOpRows[offset])
    add(bodyIR.cleanupIntent.siteUnitStarts,
        bodyIR.cleanupIntent.unitKinds.len)
    add(bodyIR.cleanupIntent.siteUnitCounts, 0)
    return siteRow

fn BodyIRCleanupIntentAppendUnit(
        bodyIR: var BodyIR,
        ownerDomain: int32,
        ownerRow: int32,
        unitKind: int32,
        semanticDomain: int32,
        semanticStart: int32,
        semanticCount: int32): int32 =
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.rootCid) ||
       !BodyIRCleanupUnitOwnerDomainValid(ownerDomain) ||
       !bodyIRCleanupIntentOwnerIsLatest(
           bodyIR.cleanupIntent, ownerDomain, ownerRow) ||
       !BodyIRCleanupUnitKindValid(unitKind) ||
       !BodyIRCleanupSemanticDomainValid(semanticDomain) ||
       semanticStart < 0 || semanticCount <= 0 ||
       semanticStart > 2147483647 - semanticCount:
        panic("body ir cleanup intent: unit append invalid")
    var unitStart: int32
    var unitCount: int32
    if !bodyIRCleanupIntentOwnerRange(
           bodyIR.cleanupIntent, ownerDomain, ownerRow,
           unitStart, unitCount) ||
       unitStart + unitCount != bodyIR.cleanupIntent.unitKinds.len:
        panic("body ir cleanup intent: owner csr drift")
    if unitCount > 0:
        let priorUnit = unitStart + unitCount - 1
        if bodyIR.cleanupIntent.unitKinds[priorUnit] ==
               BodyCleanupUnitTransitionTag ||
           !BodyIRTypeArenaArtifactCidValid(
               bodyIR.cleanupIntent.unitAuthorityCids[priorUnit]):
            panic("body ir cleanup intent: prior unit unbound")
    if unitKind == BodyCleanupUnitReturnSnapshotTag:
        if ownerDomain != BodyCleanupUnitOwnerExitTag ||
           unitCount != 0 ||
           semanticDomain != BodyCleanupSemanticReturnSnapshotTag ||
           semanticCount != 1:
            panic("body ir cleanup intent: return snapshot invalid")
    elif unitKind == BodyCleanupUnitGuardSnapshotTag:
        if semanticDomain != BodyCleanupSemanticGuardSnapshotTag ||
           unitCount > 1 ||
           (unitCount == 1 &&
            bodyIR.cleanupIntent.unitKinds[unitStart] !=
                BodyCleanupUnitReturnSnapshotTag):
            panic("body ir cleanup intent: guard snapshot invalid")
    elif unitKind == BodyCleanupUnitDeferTag:
        if ownerDomain != BodyCleanupUnitOwnerExitTag ||
           semanticDomain != BodyCleanupSemanticDeferTag ||
           semanticCount != 1:
            panic("body ir cleanup intent: defer unit invalid")
        var deferOrdinal: int32
        for offset in 0..<unitCount:
            if bodyIR.cleanupIntent.unitKinds[unitStart + offset] ==
                   BodyCleanupUnitDeferTag:
                deferOrdinal = deferOrdinal + 1
        let selectedStart =
            bodyIR.cleanupIntent.selectedDeferStarts[ownerRow]
        let selectedCount =
            bodyIR.cleanupIntent.selectedDeferCounts[ownerRow]
        if deferOrdinal >= selectedCount ||
           semanticStart != bodyIR.cleanupIntent.selectedDeferIds[
               selectedStart + deferOrdinal]:
            panic("body ir cleanup intent: defer order invalid")
    elif unitKind == BodyCleanupUnitOwnershipActionTag:
        if semanticDomain != BodyCleanupSemanticOwnershipActionTag:
            panic("body ir cleanup intent: ownership action invalid")
    elif semanticDomain !=
             BodyCleanupSemanticOwnershipTransitionTag:
        panic("body ir cleanup intent: transition invalid")
    let unitRow = bodyIR.cleanupIntent.unitKinds.len
    add(bodyIR.cleanupIntent.unitKinds, unitKind)
    add(bodyIR.cleanupIntent.unitSemanticDomains, semanticDomain)
    add(bodyIR.cleanupIntent.unitSemanticStarts, semanticStart)
    add(bodyIR.cleanupIntent.unitSemanticCounts, semanticCount)
    add(bodyIR.cleanupIntent.unitSnapshotSourceSlotStarts,
        bodyIR.cleanupIntent.snapshotSourceSlotIds.len)
    add(bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts, 0)
    add(bodyIR.cleanupIntent.unitConditionStarts,
        bodyIR.cleanupIntent.conditionKinds.len)
    add(bodyIR.cleanupIntent.unitConditionCounts, 0)
    add(bodyIR.cleanupIntent.unitClearStarts,
        bodyIR.cleanupIntent.clearKinds.len)
    add(bodyIR.cleanupIntent.unitClearCounts, 0)
    add(bodyIR.cleanupIntent.unitAuthorityCids,
        layout.FixedBytes32())
    if ownerDomain == BodyCleanupUnitOwnerExitTag:
        bodyIR.cleanupIntent.exitUnitCounts[ownerRow] =
            unitCount + 1
    else:
        bodyIR.cleanupIntent.siteUnitCounts[ownerRow] =
            unitCount + 1
    return unitRow

fn BodyIRCleanupIntentAppendSnapshotSource(
        bodyIR: var BodyIR,
        unitRow: int32,
        sourceSlotId: int32,
        projectionPolicy: int32,
        semanticRow: int32,
        typeArenaTypeId: int32,
        interfaceCid: layout.FixedBytes32) =
    # [wall139] 无 proof 纯标量域镜像放行： typeId<0 的拒绝收窄为
    # 「!NoProofAdmitted」——def-less Unknown 纯标量槽由
    # BodyIRCleanupIntentSnapshotSourceNoProofAdmitted 精确放行（decode
    # 权威 BodyIRLocalSlotTypeArenaProofValid 同域先认），行内仍逐字存
    # 实际 typeId（-1），codec 列为纯 I32 透传。其余判据零弱化。
    var wall139NoProofAdmitted = false
    if sourceSlotId >= 0 &&
       sourceSlotId < bodyIR.localSlots.len:
        wall139NoProofAdmitted =
            BodyIRCleanupIntentSnapshotSourceNoProofAdmitted(
                bodyIR.localSlots[sourceSlotId])
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       unitRow < 0 ||
       unitRow != bodyIR.cleanupIntent.unitKinds.len - 1 ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.unitAuthorityCids[unitRow]) ||
       (bodyIR.cleanupIntent.unitKinds[unitRow] !=
            BodyCleanupUnitReturnSnapshotTag &&
        bodyIR.cleanupIntent.unitKinds[unitRow] !=
            BodyCleanupUnitGuardSnapshotTag) ||
       sourceSlotId < 0 ||
       sourceSlotId >= bodyIR.cleanupIntent.originalLocalCount ||
       !BodyIRCleanupProjectionPolicyValid(projectionPolicy) ||
       semanticRow < 0 ||
       (typeArenaTypeId < 0 && !wall139NoProofAdmitted) ||
       !BodyIRTypeArenaArtifactCidValid(interfaceCid) ||
       bodyIR.localSlots[sourceSlotId].typeArenaTypeId !=
           typeArenaTypeId:
        panic("body ir cleanup intent: snapshot source invalid")
    let start =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotStarts[unitRow]
    let count =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts[unitRow]
    if start + count !=
           bodyIR.cleanupIntent.snapshotSourceSlotIds.len:
        panic("body ir cleanup intent: snapshot csr drift")
    for offset in 0..<count:
        if bodyIR.cleanupIntent.snapshotSourceSlotIds[
               start + offset] == sourceSlotId:
            panic("body ir cleanup intent: snapshot source duplicate")
    add(bodyIR.cleanupIntent.snapshotSourceSlotIds, sourceSlotId)
    add(bodyIR.cleanupIntent.snapshotProjectionPolicies,
        projectionPolicy)
    add(bodyIR.cleanupIntent.snapshotSemanticRows, semanticRow)
    add(bodyIR.cleanupIntent.snapshotTypeArenaTypeIds,
        typeArenaTypeId)
    add(bodyIR.cleanupIntent.snapshotInterfaceCids,
        layout.FixedBytes32Copy(interfaceCid))
    bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts[unitRow] =
        count + 1

fn BodyIRCleanupIntentAppendCondition(
        bodyIR: var BodyIR,
        unitRow: int32,
        conditionKind: int32,
        inputSourceSlotId: int32,
        semanticRow: int32,
        semanticOrdinal: int32) =
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       unitRow < 0 ||
       unitRow != bodyIR.cleanupIntent.unitKinds.len - 1 ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.unitAuthorityCids[unitRow]) ||
       (bodyIR.cleanupIntent.unitKinds[unitRow] !=
            BodyCleanupUnitDeferTag &&
        bodyIR.cleanupIntent.unitKinds[unitRow] !=
            BodyCleanupUnitOwnershipActionTag) ||
       !BodyIRCleanupConditionKindValid(conditionKind) ||
       inputSourceSlotId < 0 ||
       inputSourceSlotId >=
           bodyIR.cleanupIntent.originalLocalCount ||
       semanticRow < bodyIR.cleanupIntent.unitSemanticStarts[unitRow] ||
       semanticRow >=
           bodyIR.cleanupIntent.unitSemanticStarts[unitRow] +
               bodyIR.cleanupIntent.unitSemanticCounts[unitRow] ||
       semanticOrdinal < 0:
        panic("body ir cleanup intent: condition invalid")
    let start = bodyIR.cleanupIntent.unitConditionStarts[unitRow]
    let count = bodyIR.cleanupIntent.unitConditionCounts[unitRow]
    if start + count != bodyIR.cleanupIntent.conditionKinds.len:
        panic("body ir cleanup intent: condition csr drift")
    add(bodyIR.cleanupIntent.conditionKinds, conditionKind)
    add(bodyIR.cleanupIntent.conditionInputSourceSlotIds,
        inputSourceSlotId)
    add(bodyIR.cleanupIntent.conditionSemanticRows, semanticRow)
    add(bodyIR.cleanupIntent.conditionSemanticOrdinals,
        semanticOrdinal)
    bodyIR.cleanupIntent.unitConditionCounts[unitRow] = count + 1

fn BodyIRCleanupIntentAppendClear(
        bodyIR: var BodyIR,
        unitRow: int32,
        clearKind: int32,
        targetSourceSlotId: int32,
        semanticRow: int32,
        semanticOrdinal: int32) =
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       unitRow < 0 ||
       unitRow != bodyIR.cleanupIntent.unitKinds.len - 1 ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.unitAuthorityCids[unitRow]) ||
       (bodyIR.cleanupIntent.unitKinds[unitRow] !=
            BodyCleanupUnitDeferTag &&
        bodyIR.cleanupIntent.unitKinds[unitRow] !=
            BodyCleanupUnitOwnershipActionTag &&
        bodyIR.cleanupIntent.unitKinds[unitRow] !=
            BodyCleanupUnitTransitionTag) ||
       !BodyIRCleanupClearKindValid(clearKind) ||
       targetSourceSlotId < 0 ||
       targetSourceSlotId >=
           bodyIR.cleanupIntent.originalLocalCount ||
       semanticRow < bodyIR.cleanupIntent.unitSemanticStarts[unitRow] ||
       semanticRow >=
           bodyIR.cleanupIntent.unitSemanticStarts[unitRow] +
               bodyIR.cleanupIntent.unitSemanticCounts[unitRow] ||
       semanticOrdinal < 0:
        panic("body ir cleanup intent: clear invalid")
    let start = bodyIR.cleanupIntent.unitClearStarts[unitRow]
    let count = bodyIR.cleanupIntent.unitClearCounts[unitRow]
    if start + count != bodyIR.cleanupIntent.clearKinds.len:
        panic("body ir cleanup intent: clear csr drift")
    add(bodyIR.cleanupIntent.clearKinds, clearKind)
    add(bodyIR.cleanupIntent.clearTargetSourceSlotIds,
        targetSourceSlotId)
    add(bodyIR.cleanupIntent.clearSemanticRows, semanticRow)
    add(bodyIR.cleanupIntent.clearSemanticOrdinals,
        semanticOrdinal)
    bodyIR.cleanupIntent.unitClearCounts[unitRow] = count + 1

@borrows
fn bodyIRCleanupIntentUnitAuthorityCidExact(
        bodyIR: BodyIR,
        sidecar: BodyIRCleanupIntentSidecar,
        unitRow: int32): layout.FixedBytes32 =
    if !BodyIRCleanupIntentSidecarRowsAligned(sidecar) ||
       unitRow < 0 || unitRow >= sidecar.unitKinds.len ||
       !BodyIRTypeArenaArtifactCidValid(sidecar.sourceControlCid) ||
       !BodyIRTypeArenaArtifactCidValid(sidecar.ownershipIrCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           sidecar.ownershipAnalysisCid):
        return layout.FixedBytes32()
    var ownerDomain: int32
    var ownerRow: int32
    var ownerOrdinal: int32
    if !bodyIRCleanupIntentUnitOwner(
           sidecar, unitRow,
           ownerDomain, ownerRow, ownerOrdinal):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(512)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_intent.unit_authority")
    layout.ByteBufAppendFixed32(buf, sidecar.sourceControlCid)
    layout.ByteBufAppendFixed32(buf, sidecar.ownershipIrCid)
    layout.ByteBufAppendFixed32(buf, sidecar.ownershipAnalysisCid)
    bodyIRControlActionAppendI32(buf, ownerDomain)
    bodyIRControlActionAppendI32(buf, ownerRow)
    bodyIRControlActionAppendI32(buf, ownerOrdinal)
    if ownerDomain == BodyCleanupUnitOwnerExitTag:
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceBlockIds[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceTermRows[ownerRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.sourceTermCids[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceSuccessorOrdinals[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.originalSuccessorCounts[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceExitKinds[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.originalTargetBlockIds[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.originalEdgeKinds[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceScopeIds[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetScopeIds[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.exitOwnershipEdgeIds[ownerRow])
        let selectedStart = sidecar.selectedDeferStarts[ownerRow]
        let selectedCount = sidecar.selectedDeferCounts[ownerRow]
        bodyIRControlActionAppendI32(buf, selectedCount)
        for offset in 0..<selectedCount:
            let deferId =
                sidecar.selectedDeferIds[selectedStart + offset]
            bodyIRControlActionAppendI32(buf, deferId)
            if deferId < 0 || deferId >= bodyIR.deferActionCids.len:
                layout.ByteBufFree(buf)
                return layout.FixedBytes32()
            let semanticCid =
                BodyIRCleanupDeferSemanticCid(bodyIR, deferId)
            if !BodyIRTypeArenaArtifactCidValid(semanticCid):
                layout.ByteBufFree(buf)
                return layout.FixedBytes32()
            layout.ByteBufAppendFixed32(buf, semanticCid)
    else:
        bodyIRControlActionAppendI32(
            buf, sidecar.siteOriginalBlockIds[ownerRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.siteAfterOpOrdinals[ownerRow])
        let ownershipStart =
            sidecar.siteOwnershipOpStarts[ownerRow]
        let ownershipCount =
            sidecar.siteOwnershipOpCounts[ownerRow]
        bodyIRControlActionAppendI32(buf, ownershipCount)
        for offset in 0..<ownershipCount:
            bodyIRControlActionAppendI32(
                buf, sidecar.ownershipOpRows[
                    ownershipStart + offset])
    bodyIRControlActionAppendI32(buf, sidecar.unitKinds[unitRow])
    bodyIRControlActionAppendI32(
        buf, sidecar.unitSemanticDomains[unitRow])
    bodyIRControlActionAppendI32(
        buf, sidecar.unitSemanticStarts[unitRow])
    bodyIRControlActionAppendI32(
        buf, sidecar.unitSemanticCounts[unitRow])
    let snapshotStart =
        sidecar.unitSnapshotSourceSlotStarts[unitRow]
    let snapshotCount =
        sidecar.unitSnapshotSourceSlotCounts[unitRow]
    bodyIRControlActionAppendI32(buf, snapshotCount)
    for offset in 0..<snapshotCount:
        let row = snapshotStart + offset
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotSourceSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotProjectionPolicies[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotSemanticRows[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotTypeArenaTypeIds[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.snapshotInterfaceCids[row])
    let conditionStart = sidecar.unitConditionStarts[unitRow]
    let conditionCount = sidecar.unitConditionCounts[unitRow]
    bodyIRControlActionAppendI32(buf, conditionCount)
    for offset in 0..<conditionCount:
        let row = conditionStart + offset
        bodyIRControlActionAppendI32(buf, sidecar.conditionKinds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.conditionInputSourceSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.conditionSemanticRows[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.conditionSemanticOrdinals[row])
    let clearStart = sidecar.unitClearStarts[unitRow]
    let clearCount = sidecar.unitClearCounts[unitRow]
    bodyIRControlActionAppendI32(buf, clearCount)
    for offset in 0..<clearCount:
        let row = clearStart + offset
        bodyIRControlActionAppendI32(buf, sidecar.clearKinds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.clearTargetSourceSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.clearSemanticRows[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.clearSemanticOrdinals[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRCleanupIntentUnitAuthorityCandidateCid(
        bodyIR: BodyIR,
        unitRow: int32): layout.FixedBytes32 =
    return bodyIRCleanupIntentUnitAuthorityCidExact(
        bodyIR, bodyIR.cleanupIntent, unitRow)

fn BodyIRCleanupIntentBindUnitAuthorityCid(
        bodyIR: var BodyIR,
        unitRow: int32,
        authorityCid: layout.FixedBytes32) =
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       unitRow < 0 ||
       unitRow != bodyIR.cleanupIntent.unitKinds.len - 1 ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.unitAuthorityCids[unitRow]) ||
       !BodyIRTypeArenaArtifactCidValid(authorityCid):
        panic("body ir cleanup intent: authority bind invalid")
    let candidate =
        BodyIRCleanupIntentUnitAuthorityCandidateCid(bodyIR, unitRow)
    if !BodyIRTypeArenaArtifactCidValid(candidate) ||
       !layout.FixedBytes32Equal(candidate, authorityCid):
        panic("body ir cleanup intent: authority mismatch")
    bodyIR.cleanupIntent.unitAuthorityCids[unitRow] =
        layout.FixedBytes32Copy(authorityCid)

@borrows
fn bodyIRCleanupIntentRowsValid(
        bodyIR: BodyIR,
        sidecar: BodyIRCleanupIntentSidecar): bool =
    if !BodyIRCleanupIntentSidecarRowsAligned(sidecar) ||
       !BodyIRTypeArenaArtifactCidValid(sidecar.sourceControlCid) ||
       !BodyIRTypeArenaArtifactCidValid(sidecar.ownershipIrCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           sidecar.ownershipAnalysisCid) ||
       sidecar.originalLocalCount < 0 ||
       sidecar.originalLocalCount > bodyIR.localSlots.len ||
       sidecar.originalOpCount < 0 ||
       sidecar.originalOpCount > bodyIR.ops.len ||
       sidecar.originalCallCount < 0 ||
       sidecar.originalCallCount > bodyIR.callSequence.len ||
       sidecar.originalBlockCount <= 0 ||
       sidecar.originalBlockCount > bodyIR.blocks.len ||
       sidecar.originalTermCount <= 0 ||
       sidecar.originalTermCount > bodyIR.terms.len ||
       sidecar.unitKinds.len <= 0 ||
       (sidecar.sourceBlockIds.len == 0 &&
        sidecar.siteOriginalBlockIds.len == 0):
        return false
    var selectedCursor: int32
    var ownershipOpCursor: int32
    var unitCursor: int32
    for exitRow in 0..<sidecar.sourceBlockIds.len:
        if sidecar.selectedDeferStarts[exitRow] != selectedCursor ||
           sidecar.exitUnitStarts[exitRow] != unitCursor ||
           sidecar.selectedDeferCounts[exitRow] < 0 ||
           sidecar.exitUnitCounts[exitRow] <= 0 ||
           sidecar.selectedDeferCounts[exitRow] >
               sidecar.selectedDeferIds.len - selectedCursor ||
           sidecar.exitUnitCounts[exitRow] >
               sidecar.unitKinds.len - unitCursor ||
           sidecar.sourceBlockIds[exitRow] < 0 ||
           sidecar.sourceBlockIds[exitRow] >=
               sidecar.originalBlockCount ||
           sidecar.sourceTermRows[exitRow] < 0 ||
           sidecar.sourceTermRows[exitRow] >=
               sidecar.originalTermCount ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.sourceTermCids[exitRow]) ||
           sidecar.sourceScopeIds[exitRow] < 0 ||
           sidecar.sourceScopeIds[exitRow] >=
               bodyIR.controlScopeParentIds.len ||
           sidecar.exitOwnershipEdgeIds[exitRow] < -1:
            return false
        if exitRow > 0 &&
           (sidecar.sourceBlockIds[exitRow] <
                sidecar.sourceBlockIds[exitRow - 1] ||
            (sidecar.sourceBlockIds[exitRow] ==
                 sidecar.sourceBlockIds[exitRow - 1] &&
             sidecar.sourceSuccessorOrdinals[exitRow] <=
                 sidecar.sourceSuccessorOrdinals[exitRow - 1])):
            return false
        if sidecar.sourceExitKinds[exitRow] ==
               BodyDeferReplaySourceReturnExitTag:
            if sidecar.sourceSuccessorOrdinals[exitRow] != 0 ||
               sidecar.originalSuccessorCounts[exitRow] != 0 ||
               sidecar.originalTargetBlockIds[exitRow] != -1 ||
               sidecar.originalEdgeKinds[exitRow] !=
                   BodyControlEdgeReturn ||
               sidecar.targetScopeIds[exitRow] != -1:
                return false
        elif sidecar.sourceExitKinds[exitRow] ==
                 BodyDeferReplaySourceSuccessorTag:
            if sidecar.originalSuccessorCounts[exitRow] <= 0 ||
               sidecar.sourceSuccessorOrdinals[exitRow] < 0 ||
               sidecar.sourceSuccessorOrdinals[exitRow] >=
                   sidecar.originalSuccessorCounts[exitRow] ||
               sidecar.originalTargetBlockIds[exitRow] < 0 ||
               sidecar.originalTargetBlockIds[exitRow] >=
                   sidecar.originalBlockCount ||
               !BodyIRControlEdgeKindValid(
                   sidecar.originalEdgeKinds[exitRow]) ||
               sidecar.originalEdgeKinds[exitRow] ==
                   BodyControlEdgeReturn ||
               sidecar.targetScopeIds[exitRow] < 0 ||
               sidecar.targetScopeIds[exitRow] >=
                   bodyIR.controlScopeParentIds.len:
                return false
        else:
            return false
        if sidecar.exitOwnershipEdgeIds[exitRow] >= 0:
            for priorRow in 0..<exitRow:
                if sidecar.exitOwnershipEdgeIds[priorRow] ==
                       sidecar.exitOwnershipEdgeIds[exitRow]:
                    return false
        selectedCursor = selectedCursor +
            sidecar.selectedDeferCounts[exitRow]
        unitCursor = unitCursor + sidecar.exitUnitCounts[exitRow]
    for siteRow in 0..<sidecar.siteOriginalBlockIds.len:
        let ownershipCount =
            sidecar.siteOwnershipOpCounts[siteRow]
        let siteUnitCount = sidecar.siteUnitCounts[siteRow]
        if sidecar.siteOwnershipOpStarts[siteRow] !=
               ownershipOpCursor ||
           sidecar.siteUnitStarts[siteRow] != unitCursor ||
           ownershipCount <= 0 || siteUnitCount <= 0 ||
           ownershipCount >
               sidecar.ownershipOpRows.len - ownershipOpCursor ||
           siteUnitCount > sidecar.unitKinds.len - unitCursor ||
           sidecar.siteOriginalBlockIds[siteRow] < 0 ||
           sidecar.siteOriginalBlockIds[siteRow] >=
               sidecar.originalBlockCount ||
           sidecar.siteAfterOpOrdinals[siteRow] < 0 ||
           sidecar.siteAfterOpOrdinals[siteRow] >
               bodyIR.blocks[
                   sidecar.siteOriginalBlockIds[siteRow]].opCount:
            return false
        if siteRow > 0 &&
           (sidecar.siteOriginalBlockIds[siteRow] <
                sidecar.siteOriginalBlockIds[siteRow - 1] ||
            (sidecar.siteOriginalBlockIds[siteRow] ==
                 sidecar.siteOriginalBlockIds[siteRow - 1] &&
             sidecar.siteAfterOpOrdinals[siteRow] <=
                 sidecar.siteAfterOpOrdinals[siteRow - 1])):
            return false
        for offset in 0..<ownershipCount:
            let row = ownershipOpCursor + offset
            if sidecar.ownershipOpRows[row] < 0 ||
               (offset > 0 &&
                sidecar.ownershipOpRows[row] <=
                    sidecar.ownershipOpRows[row - 1]):
                return false
            for priorRow in 0..<row:
                if sidecar.ownershipOpRows[priorRow] ==
                       sidecar.ownershipOpRows[row]:
                    return false
        ownershipOpCursor = ownershipOpCursor + ownershipCount
        unitCursor = unitCursor + siteUnitCount
    if selectedCursor != sidecar.selectedDeferIds.len ||
       ownershipOpCursor != sidecar.ownershipOpRows.len ||
       unitCursor != sidecar.unitKinds.len:
        return false
    for exitRow in 0..<sidecar.exitUnitStarts.len:
        let unitStart = sidecar.exitUnitStarts[exitRow]
        let unitCount = sidecar.exitUnitCounts[exitRow]
        let selectedStart = sidecar.selectedDeferStarts[exitRow]
        let selectedCount = sidecar.selectedDeferCounts[exitRow]
        var deferOrdinal: int32
        var transitionSeen: bool
        for offset in 0..<unitCount:
            let unitRow = unitStart + offset
            let unitKind = sidecar.unitKinds[unitRow]
            if transitionSeen:
                return false
            if unitKind == BodyCleanupUnitDeferTag:
                if deferOrdinal >= selectedCount ||
                   sidecar.unitSemanticStarts[unitRow] !=
                       sidecar.selectedDeferIds[
                           selectedStart + deferOrdinal]:
                    return false
                deferOrdinal = deferOrdinal + 1
            elif unitKind == BodyCleanupUnitTransitionTag:
                transitionSeen = true
                if offset != unitCount - 1:
                    return false
        if deferOrdinal != selectedCount:
            return false
    for siteRow in 0..<sidecar.siteUnitStarts.len:
        let unitStart = sidecar.siteUnitStarts[siteRow]
        let unitCount = sidecar.siteUnitCounts[siteRow]
        var transitionSeen: bool
        for offset in 0..<unitCount:
            let unitKind = sidecar.unitKinds[unitStart + offset]
            if transitionSeen ||
               unitKind == BodyCleanupUnitReturnSnapshotTag ||
               unitKind == BodyCleanupUnitDeferTag:
                return false
            if unitKind == BodyCleanupUnitTransitionTag:
                transitionSeen = true
                if offset != unitCount - 1:
                    return false
    var snapshotCursor: int32
    var conditionCursor: int32
    var clearCursor: int32
    for unitRow in 0..<sidecar.unitKinds.len:
        if sidecar.unitSnapshotSourceSlotStarts[unitRow] !=
               snapshotCursor ||
           sidecar.unitConditionStarts[unitRow] != conditionCursor ||
           sidecar.unitClearStarts[unitRow] != clearCursor ||
           sidecar.unitSnapshotSourceSlotCounts[unitRow] < 0 ||
           sidecar.unitConditionCounts[unitRow] < 0 ||
           sidecar.unitClearCounts[unitRow] < 0 ||
           sidecar.unitSnapshotSourceSlotCounts[unitRow] >
               sidecar.snapshotSourceSlotIds.len - snapshotCursor ||
           sidecar.unitConditionCounts[unitRow] >
               sidecar.conditionKinds.len - conditionCursor ||
           sidecar.unitClearCounts[unitRow] >
               sidecar.clearKinds.len - clearCursor ||
           !BodyIRCleanupUnitKindValid(sidecar.unitKinds[unitRow]) ||
           !BodyIRCleanupSemanticDomainValid(
               sidecar.unitSemanticDomains[unitRow]) ||
           sidecar.unitSemanticStarts[unitRow] < 0 ||
           sidecar.unitSemanticCounts[unitRow] <= 0 ||
           sidecar.unitSemanticStarts[unitRow] >
               2147483647 - sidecar.unitSemanticCounts[unitRow] ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.unitAuthorityCids[unitRow]) ||
           !layout.FixedBytes32Equal(
               sidecar.unitAuthorityCids[unitRow],
               bodyIRCleanupIntentUnitAuthorityCidExact(
                   bodyIR, sidecar, unitRow)):
            return false
        var ownerDomain: int32
        var ownerRow: int32
        var ownerOrdinal: int32
        if !bodyIRCleanupIntentUnitOwner(
               sidecar, unitRow,
               ownerDomain, ownerRow, ownerOrdinal):
            return false
        let unitKind = sidecar.unitKinds[unitRow]
        let semanticDomain = sidecar.unitSemanticDomains[unitRow]
        if unitKind == BodyCleanupUnitReturnSnapshotTag:
            if ownerDomain != BodyCleanupUnitOwnerExitTag ||
               ownerOrdinal != 0 ||
               semanticDomain != BodyCleanupSemanticReturnSnapshotTag ||
               sidecar.unitSemanticCounts[unitRow] != 1:
                return false
        elif unitKind == BodyCleanupUnitGuardSnapshotTag:
            if semanticDomain != BodyCleanupSemanticGuardSnapshotTag ||
               ownerOrdinal > 1 ||
               (ownerOrdinal == 1 &&
                sidecar.unitKinds[unitRow - 1] !=
                    BodyCleanupUnitReturnSnapshotTag):
                return false
        elif unitKind == BodyCleanupUnitDeferTag:
            if ownerDomain != BodyCleanupUnitOwnerExitTag ||
               semanticDomain != BodyCleanupSemanticDeferTag ||
               sidecar.unitSemanticCounts[unitRow] != 1:
                return false
        elif unitKind == BodyCleanupUnitOwnershipActionTag:
            if semanticDomain !=
                   BodyCleanupSemanticOwnershipActionTag:
                return false
        elif semanticDomain !=
                 BodyCleanupSemanticOwnershipTransitionTag:
            return false
        let snapshotCount =
            sidecar.unitSnapshotSourceSlotCounts[unitRow]
        if (unitKind == BodyCleanupUnitReturnSnapshotTag ||
            unitKind == BodyCleanupUnitGuardSnapshotTag) !=
               (snapshotCount > 0):
            return false
        for offset in 0..<snapshotCount:
            let row = snapshotCursor + offset
            # [wall139] 无 proof 纯标量域镜像放行（与 SnapshotSource append
            # 同谓词同域）：typeId<0 拒绝收窄为 !NoProofAdmitted。
            var wall139NoProofAdmitted = false
            if sidecar.snapshotSourceSlotIds[row] >= 0 &&
               sidecar.snapshotSourceSlotIds[row] < bodyIR.localSlots.len:
                wall139NoProofAdmitted =
                    BodyIRCleanupIntentSnapshotSourceNoProofAdmitted(
                        bodyIR.localSlots[
                            sidecar.snapshotSourceSlotIds[row]])
            if sidecar.snapshotSourceSlotIds[row] < 0 ||
               sidecar.snapshotSourceSlotIds[row] >=
                   sidecar.originalLocalCount ||
               !BodyIRCleanupProjectionPolicyValid(
                   sidecar.snapshotProjectionPolicies[row]) ||
               sidecar.snapshotSemanticRows[row] < 0 ||
               (sidecar.snapshotTypeArenaTypeIds[row] < 0 &&
                !wall139NoProofAdmitted) ||
               bodyIR.localSlots[
                   sidecar.snapshotSourceSlotIds[row]].typeArenaTypeId !=
                   sidecar.snapshotTypeArenaTypeIds[row] ||
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.snapshotInterfaceCids[row]):
                return false
            for priorOffset in 0..<offset:
                if sidecar.snapshotSourceSlotIds[
                       snapshotCursor + priorOffset] ==
                       sidecar.snapshotSourceSlotIds[row]:
                    return false
        for offset in 0..<sidecar.unitConditionCounts[unitRow]:
            let row = conditionCursor + offset
            if (unitKind != BodyCleanupUnitDeferTag &&
                unitKind != BodyCleanupUnitOwnershipActionTag) ||
               !BodyIRCleanupConditionKindValid(
                   sidecar.conditionKinds[row]) ||
               sidecar.conditionInputSourceSlotIds[row] < 0 ||
               sidecar.conditionInputSourceSlotIds[row] >=
                   sidecar.originalLocalCount ||
               sidecar.conditionSemanticRows[row] <
                   sidecar.unitSemanticStarts[unitRow] ||
               sidecar.conditionSemanticRows[row] >=
                   sidecar.unitSemanticStarts[unitRow] +
                       sidecar.unitSemanticCounts[unitRow] ||
               sidecar.conditionSemanticOrdinals[row] < 0:
                return false
        for offset in 0..<sidecar.unitClearCounts[unitRow]:
            let row = clearCursor + offset
            if (unitKind != BodyCleanupUnitDeferTag &&
                unitKind != BodyCleanupUnitOwnershipActionTag &&
                unitKind != BodyCleanupUnitTransitionTag) ||
               !BodyIRCleanupClearKindValid(sidecar.clearKinds[row]) ||
               sidecar.clearTargetSourceSlotIds[row] < 0 ||
               sidecar.clearTargetSourceSlotIds[row] >=
                   sidecar.originalLocalCount ||
               sidecar.clearSemanticRows[row] <
                   sidecar.unitSemanticStarts[unitRow] ||
               sidecar.clearSemanticRows[row] >=
                   sidecar.unitSemanticStarts[unitRow] +
                       sidecar.unitSemanticCounts[unitRow] ||
               sidecar.clearSemanticOrdinals[row] < 0:
                return false
        snapshotCursor = snapshotCursor + snapshotCount
        conditionCursor = conditionCursor +
            sidecar.unitConditionCounts[unitRow]
        clearCursor = clearCursor +
            sidecar.unitClearCounts[unitRow]
    return snapshotCursor == sidecar.snapshotSourceSlotIds.len &&
           conditionCursor == sidecar.conditionKinds.len &&
           clearCursor == sidecar.clearKinds.len

@borrows
fn bodyIRCleanupIntentOriginalSourcesValid(
        bodyIR: BodyIR,
        sidecar: BodyIRCleanupIntentSidecar): bool =
    if bodyIR.localSlots.len != sidecar.originalLocalCount ||
       bodyIR.ops.len != sidecar.originalOpCount ||
       bodyIR.callSequence.len != sidecar.originalCallCount ||
       bodyIR.blocks.len != sidecar.originalBlockCount ||
       bodyIR.terms.len != sidecar.originalTermCount ||
       !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       !layout.FixedBytes32Equal(
           sidecar.sourceControlCid,
           BodyIRCleanupSourceControlCid(bodyIR)):
        return false
    for exitRow in 0..<sidecar.sourceBlockIds.len:
        let sourceBlockId = sidecar.sourceBlockIds[exitRow]
        let sourceTermRow = sidecar.sourceTermRows[exitRow]
        if bodyIR.blocks[sourceBlockId].termIndex != sourceTermRow ||
           bodyIR.blockScopeIds[sourceBlockId] !=
               sidecar.sourceScopeIds[exitRow] ||
           !layout.FixedBytes32Equal(
               sidecar.sourceTermCids[exitRow],
               bodyIRCleanupTermSemanticCid(
                   bodyIR, sourceTermRow, -1, -1,
                   BodyControlEdgeUnknown)) ||
           bodyIR.termSuccessorCounts[sourceTermRow] !=
               sidecar.originalSuccessorCounts[exitRow]:
            return false
        if sidecar.sourceExitKinds[exitRow] ==
               BodyDeferReplaySourceSuccessorTag:
            let successorRow =
                bodyIR.termSuccessorStarts[sourceTermRow] +
                    sidecar.sourceSuccessorOrdinals[exitRow]
            if bodyIR.successorBlockIds[successorRow] !=
                   sidecar.originalTargetBlockIds[exitRow] ||
               bodyIR.successorEdgeKinds[successorRow] !=
                   sidecar.originalEdgeKinds[exitRow] ||
               bodyIR.blockScopeIds[
                   sidecar.originalTargetBlockIds[exitRow]] !=
                   sidecar.targetScopeIds[exitRow]:
                return false
        elif bodyIR.terms[sourceTermRow].kind != BodyTermReturnTag:
            return false
    return bodyIRCleanupIntentRowsValid(bodyIR, sidecar)

@borrows
fn bodyIRCleanupIntentRootCidExact(
        bodyIR: BodyIR,
        sidecar: BodyIRCleanupIntentSidecar): layout.FixedBytes32 =
    if !bodyIRCleanupIntentRowsValid(bodyIR, sidecar):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(2048)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_intent")
    layout.ByteBufAppendFixed32(buf, sidecar.sourceControlCid)
    layout.ByteBufAppendFixed32(buf, sidecar.ownershipIrCid)
    layout.ByteBufAppendFixed32(buf, sidecar.ownershipAnalysisCid)
    bodyIRControlActionAppendI32(buf, sidecar.originalLocalCount)
    bodyIRControlActionAppendI32(buf, sidecar.originalOpCount)
    bodyIRControlActionAppendI32(buf, sidecar.originalCallCount)
    bodyIRControlActionAppendI32(buf, sidecar.originalBlockCount)
    bodyIRControlActionAppendI32(buf, sidecar.originalTermCount)
    bodyIRCleanupAppendI32Rows(buf, sidecar.sourceBlockIds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.sourceTermRows)
    bodyIRCleanupAppendFixed32Rows(buf, sidecar.sourceTermCids)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.sourceSuccessorOrdinals)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.originalSuccessorCounts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.sourceExitKinds)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.originalTargetBlockIds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.originalEdgeKinds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.sourceScopeIds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.targetScopeIds)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.exitOwnershipEdgeIds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.selectedDeferStarts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.selectedDeferCounts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.exitUnitStarts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.exitUnitCounts)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.siteOriginalBlockIds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.siteAfterOpOrdinals)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.siteOwnershipOpStarts)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.siteOwnershipOpCounts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.siteUnitStarts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.siteUnitCounts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.ownershipOpRows)
    bodyIRCleanupAppendI32Rows(buf, sidecar.selectedDeferIds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.unitKinds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.unitSemanticDomains)
    bodyIRCleanupAppendI32Rows(buf, sidecar.unitSemanticStarts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.unitSemanticCounts)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.unitSnapshotSourceSlotStarts)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.unitSnapshotSourceSlotCounts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.unitConditionStarts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.unitConditionCounts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.unitClearStarts)
    bodyIRCleanupAppendI32Rows(buf, sidecar.unitClearCounts)
    bodyIRCleanupAppendFixed32Rows(buf, sidecar.unitAuthorityCids)
    bodyIRCleanupAppendI32Rows(buf, sidecar.snapshotSourceSlotIds)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.snapshotProjectionPolicies)
    bodyIRCleanupAppendI32Rows(buf, sidecar.snapshotSemanticRows)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.snapshotTypeArenaTypeIds)
    bodyIRCleanupAppendFixed32Rows(
        buf, sidecar.snapshotInterfaceCids)
    bodyIRCleanupAppendI32Rows(buf, sidecar.conditionKinds)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.conditionInputSourceSlotIds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.conditionSemanticRows)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.conditionSemanticOrdinals)
    bodyIRCleanupAppendI32Rows(buf, sidecar.clearKinds)
    bodyIRCleanupAppendI32Rows(
        buf, sidecar.clearTargetSourceSlotIds)
    bodyIRCleanupAppendI32Rows(buf, sidecar.clearSemanticRows)
    bodyIRCleanupAppendI32Rows(buf, sidecar.clearSemanticOrdinals)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRCleanupIntentCandidateRootCid(
        bodyIR: BodyIR): layout.FixedBytes32 =
    return bodyIRCleanupIntentRootCidExact(
        bodyIR, bodyIR.cleanupIntent)

fn BodyIRCleanupIntentBindRootCid(
        bodyIR: var BodyIR,
        rootCid: layout.FixedBytes32) =
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.rootCid) ||
       !BodyIRTypeArenaArtifactCidValid(rootCid) ||
       !bodyIRCleanupIntentOriginalSourcesValid(
           bodyIR, bodyIR.cleanupIntent):
        panic("body ir cleanup intent: root bind invalid")
    let candidate = BodyIRCleanupIntentCandidateRootCid(bodyIR)
    if !BodyIRTypeArenaArtifactCidValid(candidate) ||
       !layout.FixedBytes32Equal(candidate, rootCid):
        panic("body ir cleanup intent: root mismatch")
    bodyIR.cleanupIntent.rootCid = layout.FixedBytes32Copy(rootCid)

fn BodyIRCleanupIntentSeal(
        bodyIR: var BodyIR,
        expectedRootCid: layout.FixedBytes32) =
    if !bodyIR.cleanupIntent.building ||
       bodyIR.cleanupIntent.sealed ||
       !BodyIRTypeArenaArtifactCidValid(expectedRootCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.rootCid) ||
       !layout.FixedBytes32Equal(
           bodyIR.cleanupIntent.rootCid, expectedRootCid) ||
       !bodyIRCleanupIntentOriginalSourcesValid(
           bodyIR, bodyIR.cleanupIntent) ||
       !layout.FixedBytes32Equal(
           BodyIRCleanupIntentCandidateRootCid(bodyIR),
           expectedRootCid):
        panic("body ir cleanup intent: seal admission failed")
    bodyIR.cleanupIntent.building = false
    bodyIR.cleanupIntent.sealed = true
    if !BodyIRCleanupIntentSidecarShapeValid(bodyIR):
        panic("body ir cleanup intent: sealed shape invalid")

@borrows
fn BodyIRCleanupIntentSidecarShapeValid(bodyIR: BodyIR): bool =
    if BodyIRCleanupIntentSidecarIsCanonicalEmpty(
           bodyIR.cleanupIntent):
        return true
    if bodyIR.cleanupIntent.building ||
       !bodyIR.cleanupIntent.sealed ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.rootCid) ||
       !bodyIRCleanupIntentRowsValid(
           bodyIR, bodyIR.cleanupIntent):
        return false
    return layout.FixedBytes32Equal(
        bodyIR.cleanupIntent.rootCid,
        BodyIRCleanupIntentCandidateRootCid(bodyIR))

@borrows
fn BodyIRCleanupIntentAdmissionValid(
        bodyIR: BodyIR,
        expectedRootCid: layout.FixedBytes32): bool =
    return BodyIRTypeArenaArtifactCidValid(expectedRootCid) &&
           !BodyIRCleanupIntentSidecarIsCanonicalEmpty(
               bodyIR.cleanupIntent) &&
           BodyIRCleanupIntentSidecarShapeValid(bodyIR) &&
           layout.FixedBytes32Equal(
               bodyIR.cleanupIntent.rootCid, expectedRootCid)

fn BodyIRCleanupScheduleSidecarNew(): BodyIRCleanupScheduleSidecar =
    var out: BodyIRCleanupScheduleSidecar
    # wall69: 大结构构造器逐字段显式落定。seq 用描述符直写
    # (len=0/cap=0/buffer=nil, 纯 store 无 rc 语义)——「= []」空列赋值带
    # release 旧值语义, 对未初始化槽=release 垃圾描述符, 与栈复用残留叠加
    # 即误释放真实堆块 (cold_nested 编译期 use-after-free 实证)。
    out.building = false
    out.sealed = false
    out.rootCid = layout.FixedBytes32()
    out.finalControlCid = layout.FixedBytes32()
    out.ownerPhysicalSourceBlockIds.len = 0
    out.ownerPhysicalSourceBlockIds.cap = 0
    out.ownerPhysicalSourceBlockIds.buffer = nil
    out.ownerSourceTermRows.len = 0
    out.ownerSourceTermRows.cap = 0
    out.ownerSourceTermRows.buffer = nil
    out.ownerSourceSuccessorOrdinals.len = 0
    out.ownerSourceSuccessorOrdinals.cap = 0
    out.ownerSourceSuccessorOrdinals.buffer = nil
    out.ownerFinalContinuationBlockIds.len = 0
    out.ownerFinalContinuationBlockIds.cap = 0
    out.ownerFinalContinuationBlockIds.buffer = nil
    out.ownerFinalEdgeKinds.len = 0
    out.ownerFinalEdgeKinds.cap = 0
    out.ownerFinalEdgeKinds.buffer = nil
    out.ownerContinuationCids.len = 0
    out.ownerContinuationCids.cap = 0
    out.ownerContinuationCids.buffer = nil
    out.opStarts.len = 0
    out.opStarts.cap = 0
    out.opStarts.buffer = nil
    out.opCounts.len = 0
    out.opCounts.cap = 0
    out.opCounts.buffer = nil
    out.callStarts.len = 0
    out.callStarts.cap = 0
    out.callStarts.buffer = nil
    out.callCounts.len = 0
    out.callCounts.cap = 0
    out.callCounts.buffer = nil
    out.blockStarts.len = 0
    out.blockStarts.cap = 0
    out.blockStarts.buffer = nil
    out.blockCounts.len = 0
    out.blockCounts.cap = 0
    out.blockCounts.buffer = nil
    out.termStarts.len = 0
    out.termStarts.cap = 0
    out.termStarts.buffer = nil
    out.termCounts.len = 0
    out.termCounts.cap = 0
    out.termCounts.buffer = nil
    out.unitLocalStarts.len = 0
    out.unitLocalStarts.cap = 0
    out.unitLocalStarts.buffer = nil
    out.unitLocalCounts.len = 0
    out.unitLocalCounts.cap = 0
    out.unitLocalCounts.buffer = nil
    out.unitProjectedSnapshotSlotStarts.len = 0
    out.unitProjectedSnapshotSlotStarts.cap = 0
    out.unitProjectedSnapshotSlotStarts.buffer = nil
    out.unitProjectedSnapshotSlotCounts.len = 0
    out.unitProjectedSnapshotSlotCounts.cap = 0
    out.unitProjectedSnapshotSlotCounts.buffer = nil
    out.unitEffectStarts.len = 0
    out.unitEffectStarts.cap = 0
    out.unitEffectStarts.buffer = nil
    out.unitEffectCounts.len = 0
    out.unitEffectCounts.cap = 0
    out.unitEffectCounts.buffer = nil
    out.effectSemanticRows.len = 0
    out.effectSemanticRows.cap = 0
    out.effectSemanticRows.buffer = nil
    out.effectPhysicalDomains.len = 0
    out.effectPhysicalDomains.cap = 0
    out.effectPhysicalDomains.buffer = nil
    out.effectPhysicalRows.len = 0
    out.effectPhysicalRows.cap = 0
    out.effectPhysicalRows.buffer = nil
    out.effectRoles.len = 0
    out.effectRoles.cap = 0
    out.effectRoles.buffer = nil
    out.payloadCids.len = 0
    out.payloadCids.cap = 0
    out.payloadCids.buffer = nil
    out.placementCids.len = 0
    out.placementCids.cap = 0
    out.placementCids.buffer = nil
    out.projectedSnapshotSlotIds.len = 0
    out.projectedSnapshotSlotIds.cap = 0
    out.projectedSnapshotSlotIds.buffer = nil
    return out
@borrows
fn BodyIRCleanupScheduleSidecarRowsAligned(
        sidecar: BodyIRCleanupScheduleSidecar): bool =
    let ownerCount = sidecar.ownerPhysicalSourceBlockIds.len
    let unitCount = sidecar.opStarts.len
    return sidecar.ownerSourceTermRows.len == ownerCount &&
           sidecar.ownerSourceSuccessorOrdinals.len == ownerCount &&
           sidecar.ownerFinalContinuationBlockIds.len == ownerCount &&
           sidecar.ownerFinalEdgeKinds.len == ownerCount &&
           sidecar.ownerContinuationCids.len == ownerCount &&
           sidecar.opCounts.len == unitCount &&
           sidecar.callStarts.len == unitCount &&
           sidecar.callCounts.len == unitCount &&
           sidecar.blockStarts.len == unitCount &&
           sidecar.blockCounts.len == unitCount &&
           sidecar.termStarts.len == unitCount &&
           sidecar.termCounts.len == unitCount &&
           sidecar.unitLocalStarts.len == unitCount &&
           sidecar.unitLocalCounts.len == unitCount &&
           sidecar.unitProjectedSnapshotSlotStarts.len == unitCount &&
           sidecar.unitProjectedSnapshotSlotCounts.len == unitCount &&
           sidecar.payloadCids.len == unitCount &&
           sidecar.placementCids.len == unitCount &&
           sidecar.unitEffectStarts.len == unitCount &&
           sidecar.unitEffectCounts.len == unitCount &&
           sidecar.effectSemanticRows.len ==
               sidecar.effectPhysicalDomains.len &&
           sidecar.effectSemanticRows.len ==
               sidecar.effectPhysicalRows.len &&
           sidecar.effectSemanticRows.len == sidecar.effectRoles.len

@borrows
fn BodyIRCleanupScheduleSidecarHasPhysicalStorage(
        sidecar: BodyIRCleanupScheduleSidecar): bool =
    return sidecar.ownerPhysicalSourceBlockIds.cap > 0 ||
           sidecar.ownerSourceTermRows.cap > 0 ||
           sidecar.ownerSourceSuccessorOrdinals.cap > 0 ||
           sidecar.ownerFinalContinuationBlockIds.cap > 0 ||
           sidecar.ownerFinalEdgeKinds.cap > 0 ||
           sidecar.ownerContinuationCids.cap > 0 ||
           sidecar.opStarts.cap > 0 ||
           sidecar.opCounts.cap > 0 ||
           sidecar.callStarts.cap > 0 ||
           sidecar.callCounts.cap > 0 ||
           sidecar.blockStarts.cap > 0 ||
           sidecar.blockCounts.cap > 0 ||
           sidecar.termStarts.cap > 0 ||
           sidecar.termCounts.cap > 0 ||
           sidecar.unitLocalStarts.cap > 0 ||
           sidecar.unitLocalCounts.cap > 0 ||
           sidecar.unitProjectedSnapshotSlotStarts.cap > 0 ||
           sidecar.unitProjectedSnapshotSlotCounts.cap > 0 ||
           sidecar.payloadCids.cap > 0 ||
           sidecar.placementCids.cap > 0 ||
           sidecar.projectedSnapshotSlotIds.cap > 0 ||
           sidecar.unitEffectStarts.cap > 0 ||
           sidecar.unitEffectCounts.cap > 0 ||
           sidecar.effectSemanticRows.cap > 0 ||
           sidecar.effectPhysicalDomains.cap > 0 ||
           sidecar.effectPhysicalRows.cap > 0 ||
           sidecar.effectRoles.cap > 0

@borrows
fn BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
        sidecar: BodyIRCleanupScheduleSidecar): bool =
    return !sidecar.building && !sidecar.sealed &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.rootCid) &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.finalControlCid) &&
           sidecar.ownerPhysicalSourceBlockIds.len == 0 &&
           sidecar.opStarts.len == 0 &&
           sidecar.projectedSnapshotSlotIds.len == 0 &&
           sidecar.effectSemanticRows.len == 0 &&
           BodyIRCleanupScheduleSidecarRowsAligned(sidecar) &&
           !BodyIRCleanupScheduleSidecarHasPhysicalStorage(sidecar)

@borrows
fn bodyIRCleanupScheduleMoveSourceValid(
        sidecar: BodyIRCleanupScheduleSidecar): bool =
    return BodyIRCleanupScheduleSidecarIsCanonicalEmpty(sidecar) ||
           ((sidecar.building || sidecar.sealed) &&
            !(sidecar.building && sidecar.sealed) &&
            BodyIRCleanupScheduleSidecarRowsAligned(sidecar))

fn BodyIRCleanupScheduleSidecarMoveInto(
        destination: var BodyIRCleanupScheduleSidecar,
        source: var BodyIRCleanupScheduleSidecar) =
    if !BodyIRCleanupScheduleSidecarIsCanonicalEmpty(destination) ||
       BodyIRCleanupScheduleSidecarHasPhysicalStorage(destination) ||
       !bodyIRCleanupScheduleMoveSourceValid(source):
        panic("body ir cleanup schedule: move state invalid")
    destination = source
    source = BodyIRCleanupScheduleSidecarNew()
    if !BodyIRCleanupScheduleSidecarIsCanonicalEmpty(source) ||
       !bodyIRCleanupScheduleMoveSourceValid(destination):
        panic("body ir cleanup schedule: move receipt invalid")

fn BodyIRCleanupEffectPhysicalDomainValid(domain: int32): bool =
    return domain == BodyCleanupEffectDomainBodyOpTag ||
           domain == BodyCleanupEffectDomainCallOpTag ||
           domain == BodyCleanupEffectDomainBodyTermTag

fn BodyIRCleanupEffectRoleValid(role: int32): bool =
    return role >= BodyCleanupEffectRoleDefinitionTag &&
           role <= BodyCleanupEffectRolePredicateTag

@borrows
fn bodyIRCleanupScheduleExpectedOwnerCount(bodyIR: BodyIR): int32 =
    return bodyIR.cleanupIntent.sourceBlockIds.len +
           bodyIR.cleanupIntent.siteOriginalBlockIds.len

@borrows
fn bodyIRCleanupScheduleGlobalOwnerIndex(
        bodyIR: BodyIR,
        ownerDomain: int32,
        ownerRow: int32): int32 =
    if ownerDomain == BodyCleanupUnitOwnerExitTag:
        if ownerRow < 0 ||
           ownerRow >= bodyIR.cleanupIntent.sourceBlockIds.len:
            return -1
        return ownerRow
    if ownerDomain == BodyCleanupUnitOwnerOpSiteTag:
        if ownerRow < 0 ||
           ownerRow >= bodyIR.cleanupIntent.siteOriginalBlockIds.len:
            return -1
        return bodyIR.cleanupIntent.sourceBlockIds.len + ownerRow
    return -1

@borrows
fn bodyIRCleanupScheduleOwnerUnitRange(
        bodyIR: BodyIR,
        ownerIndex: int32,
        unitStartOut: var int32,
        unitCountOut: var int32): bool =
    let exitCount = bodyIR.cleanupIntent.sourceBlockIds.len
    if ownerIndex < 0 ||
       ownerIndex >= bodyIRCleanupScheduleExpectedOwnerCount(bodyIR):
        return false
    if ownerIndex < exitCount:
        unitStartOut = bodyIR.cleanupIntent.exitUnitStarts[ownerIndex]
        unitCountOut = bodyIR.cleanupIntent.exitUnitCounts[ownerIndex]
    else:
        let siteRow = ownerIndex - exitCount
        unitStartOut = bodyIR.cleanupIntent.siteUnitStarts[siteRow]
        unitCountOut = bodyIR.cleanupIntent.siteUnitCounts[siteRow]
    return unitStartOut >= 0 && unitCountOut > 0 &&
           unitStartOut <=
               bodyIR.cleanupIntent.unitKinds.len - unitCountOut

@borrows
fn bodyIRCleanupScheduleOwnerForUnit(
        bodyIR: BodyIR,
        unitRow: int32,
        ownerIndexOut: var int32,
        ownerOrdinalOut: var int32): bool =
    var ownerDomain: int32
    var ownerRow: int32
    if !bodyIRCleanupIntentUnitOwner(
           bodyIR.cleanupIntent,
           unitRow,
           ownerDomain,
           ownerRow,
           ownerOrdinalOut):
        return false
    ownerIndexOut = bodyIRCleanupScheduleGlobalOwnerIndex(
        bodyIR, ownerDomain, ownerRow)
    return ownerIndexOut >= 0

@borrows
fn bodyIRCleanupScheduleOwnerContinuationCidExact(
        bodyIR: BodyIR,
        ownerIndex: int32,
        physicalSourceBlockId: int32,
        sourceTermRow: int32,
        sourceSuccessorOrdinal: int32,
        finalContinuationBlockId: int32,
        finalEdgeKind: int32): layout.FixedBytes32 =
    if ownerIndex < 0 ||
       ownerIndex >= bodyIRCleanupScheduleExpectedOwnerCount(bodyIR) ||
       physicalSourceBlockId < 0 ||
       physicalSourceBlockId >= bodyIR.blocks.len ||
       sourceTermRow < 0 || sourceTermRow >= bodyIR.terms.len ||
       bodyIR.blocks[physicalSourceBlockId].termIndex != sourceTermRow ||
       !bodyIRCleanupTermSuccessorSliceValid(bodyIR, sourceTermRow) ||
       sourceSuccessorOrdinal < 0 ||
       sourceSuccessorOrdinal >=
           bodyIR.termSuccessorCounts[sourceTermRow] ||
       finalContinuationBlockId < 0 ||
       finalContinuationBlockId >= bodyIR.blocks.len ||
       !BodyIRControlEdgeKindValid(finalEdgeKind) ||
       finalEdgeKind == BodyControlEdgeReturn:
        return layout.FixedBytes32()
    let finalBlock = bodyIR.blocks[finalContinuationBlockId]
    if finalBlock.id != finalContinuationBlockId ||
       finalBlock.termIndex < 0 ||
       finalBlock.termIndex >= bodyIR.terms.len:
        return layout.FixedBytes32()
    let sourceTermCid = bodyIRCleanupTermSemanticCid(
        bodyIR, sourceTermRow, -1, -1, BodyControlEdgeUnknown)
    let continuationTermCid = bodyIRCleanupTermSemanticCid(
        bodyIR, finalBlock.termIndex, -1, -1, BodyControlEdgeUnknown)
    if !BodyIRTypeArenaArtifactCidValid(sourceTermCid) ||
       !BodyIRTypeArenaArtifactCidValid(continuationTermCid):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(192)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_schedule.owner_continuation")
    bodyIRControlActionAppendI32(buf, ownerIndex)
    bodyIRControlActionAppendI32(buf, physicalSourceBlockId)
    bodyIRControlActionAppendI32(buf, sourceTermRow)
    bodyIRControlActionAppendI32(buf, sourceSuccessorOrdinal)
    layout.ByteBufAppendFixed32(buf, sourceTermCid)
    bodyIRControlActionAppendI32(buf, finalContinuationBlockId)
    bodyIRControlActionAppendI32(buf, finalBlock.opStart)
    bodyIRControlActionAppendI32(buf, finalBlock.opCount)
    bodyIRControlActionAppendI32(buf, finalBlock.termIndex)
    bodyIRControlActionAppendI32(
        buf, bodyIR.blockScopeIds[finalContinuationBlockId])
    bodyIRControlActionAppendI32(buf, finalEdgeKind)
    layout.ByteBufAppendFixed32(buf, continuationTermCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn BodyIRCleanupScheduleBegin(bodyIR: var BodyIR) =
    let finalControlCid = BodyIRCleanupFinalControlCid(bodyIR)
    if !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       !BodyIRCleanupIntentSidecarShapeValid(bodyIR) ||
       BodyIRCleanupIntentSidecarIsCanonicalEmpty(
           bodyIR.cleanupIntent) ||
       !BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
           bodyIR.cleanupSchedule) ||
       !BodyIRDeferReplaySidecarIsCanonicalEmpty(
           bodyIR.deferReplay) ||
       bodyIRCleanupScheduleExpectedOwnerCount(bodyIR) <= 0 ||
       bodyIR.cleanupIntent.unitKinds.len <= 0 ||
       !BodyIRTypeArenaArtifactCidValid(finalControlCid):
        panic("body ir cleanup schedule: begin state invalid")
    bodyIR.cleanupSchedule.building = true
    bodyIR.cleanupSchedule.finalControlCid =
        layout.FixedBytes32Copy(finalControlCid)

fn BodyIRCleanupScheduleAppendOwner(
        bodyIR: var BodyIR,
        physicalSourceBlockId: int32,
        sourceTermRow: int32,
        sourceSuccessorOrdinal: int32,
        finalContinuationBlockId: int32,
        finalEdgeKind: int32): int32 =
    let ownerIndex =
        bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds.len
    if !bodyIR.cleanupSchedule.building ||
       bodyIR.cleanupSchedule.sealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.rootCid) ||
       ownerIndex < 0 ||
       ownerIndex >= bodyIRCleanupScheduleExpectedOwnerCount(bodyIR) ||
       bodyIR.cleanupSchedule.opStarts.len != 0:
        panic("body ir cleanup schedule: owner append state invalid")
    let continuationCid =
        bodyIRCleanupScheduleOwnerContinuationCidExact(
            bodyIR,
            ownerIndex,
            physicalSourceBlockId,
            sourceTermRow,
            sourceSuccessorOrdinal,
            finalContinuationBlockId,
            finalEdgeKind)
    if !BodyIRTypeArenaArtifactCidValid(continuationCid) ||
       physicalSourceBlockId == finalContinuationBlockId:
        panic("body ir cleanup schedule: owner placement invalid")
    add(bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds,
        physicalSourceBlockId)
    add(bodyIR.cleanupSchedule.ownerSourceTermRows, sourceTermRow)
    add(bodyIR.cleanupSchedule.ownerSourceSuccessorOrdinals,
        sourceSuccessorOrdinal)
    add(bodyIR.cleanupSchedule.ownerFinalContinuationBlockIds,
        finalContinuationBlockId)
    add(bodyIR.cleanupSchedule.ownerFinalEdgeKinds, finalEdgeKind)
    add(bodyIR.cleanupSchedule.ownerContinuationCids,
        continuationCid)
    return ownerIndex

@borrows
fn bodyIRCleanupScheduleSnapshotProjectionValid(
        bodyIR: BodyIR,
        unitRow: int32,
        localStart: int32,
        localCount: int32,
        snapshotOffset: int32,
        projectedSlotId: int32): bool =
    let snapshotStart =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotStarts[unitRow]
    let snapshotCount =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts[unitRow]
    if snapshotOffset < 0 || snapshotOffset >= snapshotCount:
        return false
    let snapshotRow = snapshotStart + snapshotOffset
    let sourceSlotId =
        bodyIR.cleanupIntent.snapshotSourceSlotIds[snapshotRow]
    if projectedSlotId < 0 ||
       projectedSlotId >= bodyIR.localSlots.len ||
       sourceSlotId < 0 || sourceSlotId >= bodyIR.localSlots.len ||
       bodyIR.localSlots[projectedSlotId].id != projectedSlotId ||
       bodyIR.localSlots[projectedSlotId].typeArenaTypeId !=
           bodyIR.cleanupIntent.snapshotTypeArenaTypeIds[snapshotRow] ||
       bodyIR.localSlots[sourceSlotId].typeArenaTypeId !=
           bodyIR.localSlots[projectedSlotId].typeArenaTypeId:
        return false
    let policy =
        bodyIR.cleanupIntent.snapshotProjectionPolicies[snapshotRow]
    if policy == BodyCleanupProjectionIdentityTag:
        return projectedSlotId == sourceSlotId
    if policy != BodyCleanupProjectionSnapshotTag ||
       projectedSlotId == sourceSlotId:
        return false
    for sourceOffset in 0..<snapshotCount:
        if bodyIR.cleanupIntent.snapshotSourceSlotIds[
               snapshotStart + sourceOffset] == projectedSlotId:
            return false
    let materializedInUnit =
        projectedSlotId >= localStart &&
        projectedSlotId < localStart + localCount
    let preallocatedInSource =
        projectedSlotId < bodyIR.cleanupIntent.originalLocalCount
    return materializedInUnit || preallocatedInSource

fn BodyIRCleanupScheduleAppendUnit(
        bodyIR: var BodyIR,
        localStart: int32,
        localCount: int32,
        opStart: int32,
        opCount: int32,
        callStart: int32,
        callCount: int32,
        blockStart: int32,
        blockCount: int32,
        termStart: int32,
        termCount: int32,
        projectedSnapshotSlotIds: var int32[]): int32 =
    let unitRow = bodyIR.cleanupSchedule.opStarts.len
    # wall76: 构建序 = 全部 unit 先行（AppendUnit 要求 effects 尚空），
    # 再按 unit 行序补齐 effects。unitEffectStarts 在本函数仅作占位，
    # 真实区间起点由 AppendEffect 在该 unit 首条 effect 时绑定
    # （见 BodyIRCleanupScheduleAppendEffect）。
    if !bodyIR.cleanupSchedule.building ||
       bodyIR.cleanupSchedule.sealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.rootCid) ||
       bodyIR.cleanupSchedule.effectSemanticRows.len != 0 ||
       unitRow < 0 ||
       unitRow >= bodyIR.cleanupIntent.unitKinds.len ||
       bodyIR.cleanupSchedule.sealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.rootCid) ||
       unitRow < 0 ||
       unitRow >= bodyIR.cleanupIntent.unitKinds.len ||
       !bodyIRCleanupRangeValid(
           localStart, localCount, bodyIR.localSlots.len, true) ||
       !bodyIRCleanupRangeValid(
           opStart, opCount, bodyIR.ops.len, true) ||
       !bodyIRCleanupRangeValid(
           callStart, callCount, bodyIR.callSequence.len, true) ||
       !bodyIRCleanupRangeValid(
           blockStart, blockCount, bodyIR.blocks.len, false) ||
       !bodyIRCleanupRangeValid(
           termStart, termCount, bodyIR.terms.len, false) ||
       localStart < bodyIR.cleanupIntent.originalLocalCount ||
       opStart < bodyIR.cleanupIntent.originalOpCount ||
       callStart < bodyIR.cleanupIntent.originalCallCount ||
       blockStart < bodyIR.cleanupIntent.originalBlockCount ||
       termStart < bodyIR.cleanupIntent.originalTermCount ||
       blockCount <= 0 || termCount <= 0:
        panic("body ir cleanup schedule: unit range invalid")
    var ownerIndex: int32
    var ownerOrdinal: int32
    if !bodyIRCleanupScheduleOwnerForUnit(
           bodyIR, unitRow, ownerIndex, ownerOrdinal) ||
       ownerIndex >=
           bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds.len:
        panic("body ir cleanup schedule: unit owner missing")
    if unitRow > 0:
        let priorRow = unitRow - 1
        if localStart < bodyIR.cleanupSchedule.unitLocalStarts[priorRow] +
                          bodyIR.cleanupSchedule.unitLocalCounts[priorRow] ||
           opStart < bodyIR.cleanupSchedule.opStarts[priorRow] +
                     bodyIR.cleanupSchedule.opCounts[priorRow] ||
           callStart < bodyIR.cleanupSchedule.callStarts[priorRow] +
                       bodyIR.cleanupSchedule.callCounts[priorRow] ||
           blockStart < bodyIR.cleanupSchedule.blockStarts[priorRow] +
                        bodyIR.cleanupSchedule.blockCounts[priorRow] ||
           termStart < bodyIR.cleanupSchedule.termStarts[priorRow] +
                       bodyIR.cleanupSchedule.termCounts[priorRow]:
            panic("body ir cleanup schedule: unit range order invalid")
    let snapshotStart =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotStarts[unitRow]
    let snapshotCount =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts[unitRow]
    if projectedSnapshotSlotIds.len != snapshotCount:
        panic("body ir cleanup schedule: snapshot projection count invalid")
    for offset in 0..<projectedSnapshotSlotIds.len:
        let projectedSlotId = projectedSnapshotSlotIds[offset]
        if !bodyIRCleanupScheduleSnapshotProjectionValid(
               bodyIR,
               unitRow,
               localStart,
               localCount,
               offset,
               projectedSlotId):
            panic("body ir cleanup schedule: snapshot projection invalid")
        for priorOffset in 0..<offset:
            if projectedSnapshotSlotIds[priorOffset] == projectedSlotId:
                panic(
                    "body ir cleanup schedule: snapshot projection duplicate")
    add(bodyIR.cleanupSchedule.opStarts, opStart)
    add(bodyIR.cleanupSchedule.opCounts, opCount)
    add(bodyIR.cleanupSchedule.callStarts, callStart)
    add(bodyIR.cleanupSchedule.callCounts, callCount)
    add(bodyIR.cleanupSchedule.blockStarts, blockStart)
    add(bodyIR.cleanupSchedule.blockCounts, blockCount)
    add(bodyIR.cleanupSchedule.termStarts, termStart)
    add(bodyIR.cleanupSchedule.termCounts, termCount)
    add(bodyIR.cleanupSchedule.unitLocalStarts, localStart)
    add(bodyIR.cleanupSchedule.unitLocalCounts, localCount)
    add(bodyIR.cleanupSchedule.unitProjectedSnapshotSlotStarts,
        bodyIR.cleanupSchedule.projectedSnapshotSlotIds.len)
    add(bodyIR.cleanupSchedule.unitProjectedSnapshotSlotCounts,
        projectedSnapshotSlotIds.len)
    for offset in 0..<projectedSnapshotSlotIds.len:
        add(bodyIR.cleanupSchedule.projectedSnapshotSlotIds,
            projectedSnapshotSlotIds[offset])
    add(bodyIR.cleanupSchedule.payloadCids, layout.FixedBytes32())
    add(bodyIR.cleanupSchedule.placementCids, layout.FixedBytes32())
    add(bodyIR.cleanupSchedule.unitEffectStarts,
        bodyIR.cleanupSchedule.effectSemanticRows.len)
    add(bodyIR.cleanupSchedule.unitEffectCounts, 0)
    return unitRow

@borrows
fn bodyIRCleanupScheduleUnitContainsPhysicalRow(
        bodyIR: BodyIR,
        unitRow: int32,
        physicalDomain: int32,
        physicalRow: int32): bool =
    if unitRow < 0 ||
       unitRow >= bodyIR.cleanupSchedule.opStarts.len:
        return false
    if physicalDomain == BodyCleanupEffectDomainBodyOpTag:
        return physicalRow >= bodyIR.cleanupSchedule.opStarts[unitRow] &&
               physicalRow < bodyIR.cleanupSchedule.opStarts[unitRow] +
                   bodyIR.cleanupSchedule.opCounts[unitRow]
    if physicalDomain == BodyCleanupEffectDomainCallOpTag:
        return physicalRow >= bodyIR.cleanupSchedule.callStarts[unitRow] &&
               physicalRow < bodyIR.cleanupSchedule.callStarts[unitRow] +
                   bodyIR.cleanupSchedule.callCounts[unitRow]
    if physicalDomain == BodyCleanupEffectDomainBodyTermTag:
        return physicalRow >= bodyIR.cleanupSchedule.termStarts[unitRow] &&
               physicalRow < bodyIR.cleanupSchedule.termStarts[unitRow] +
                   bodyIR.cleanupSchedule.termCounts[unitRow]
    return false

fn bodyIRCleanupScheduleExpectedEffectAppend(
        semanticRows: var int32[],
        physicalDomains: var int32[],
        physicalRows: var int32[],
        roles: var int32[],
        semanticRow: int32,
        physicalDomain: int32,
        physicalRow: int32,
        role: int32): bool =
    if semanticRow < 0 ||
       !BodyIRCleanupEffectPhysicalDomainValid(physicalDomain) ||
       physicalRow < 0 || !BodyIRCleanupEffectRoleValid(role):
        return false
    for row in 0..<semanticRows.len:
        if semanticRows[row] == semanticRow &&
           physicalDomains[row] == physicalDomain &&
           physicalRows[row] == physicalRow && roles[row] == role:
            return false
    add(semanticRows, semanticRow)
    add(physicalDomains, physicalDomain)
    add(physicalRows, physicalRow)
    add(roles, role)
    return true

@borrows
fn bodyIRCleanupScheduleSemanticRowInUnit(
        bodyIR: BodyIR,
        unitRow: int32,
        semanticRow: int32): bool =
    if unitRow < 0 || unitRow >= bodyIR.cleanupIntent.unitKinds.len:
        return false
    let start = bodyIR.cleanupIntent.unitSemanticStarts[unitRow]
    let count = bodyIR.cleanupIntent.unitSemanticCounts[unitRow]
    return semanticRow >= start && semanticRow < start + count

@borrows
fn bodyIRCleanupScheduleExecutionSemanticRow(
        bodyIR: BodyIR,
        unitRow: int32,
        semanticRowOut: var int32): bool =
    if unitRow < 0 ||
       unitRow >= bodyIR.cleanupIntent.unitKinds.len ||
       bodyIR.cleanupIntent.unitSemanticCounts[unitRow] != 1:
        return false
    let unitKind = bodyIR.cleanupIntent.unitKinds[unitRow]
    if unitKind != BodyCleanupUnitDeferTag &&
       unitKind != BodyCleanupUnitOwnershipActionTag:
        return false
    semanticRowOut =
        bodyIR.cleanupIntent.unitSemanticStarts[unitRow]
    return semanticRowOut >= 0

@borrows
fn bodyIRCleanupScheduleSnapshotSemanticForOp(
        bodyIR: BodyIR,
        unitRow: int32,
        opRow: int32,
        semanticRowOut: var int32): bool =
    let op = bodyIR.ops[opRow]
    let snapshotStart =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotStarts[unitRow]
    let snapshotCount =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts[unitRow]
    let projectedStart =
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotStarts[unitRow]
    let projectedCount =
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotCounts[unitRow]
    if snapshotCount != projectedCount:
        return false
    var matchCount: int32
    for offset in 0..<snapshotCount:
        let sourceSlotId = bodyIR.cleanupIntent.snapshotSourceSlotIds[
            snapshotStart + offset]
        let projectedSlotId =
            bodyIR.cleanupSchedule.projectedSnapshotSlotIds[
                projectedStart + offset]
        if op.target != projectedSlotId:
            continue
        var matches = false
        if op.kind == BodyOpCopyLocalTag && op.operands.len == 1 &&
           op.operands[0] == sourceSlotId:
            matches = true
        elif op.kind == BodyOpCallTag && op.operands.len == 1:
            let callRow = op.operands[0]
            matches = callRow >= 0 &&
                      callRow < bodyIR.callSequence.len &&
                      bodyIR.callSequence[callRow].resultSlot ==
                          projectedSlotId
        if matches:
            let semanticRow =
                bodyIR.cleanupIntent.snapshotSemanticRows[
                    snapshotStart + offset]
            if !bodyIRCleanupScheduleSemanticRowInUnit(
                   bodyIR, unitRow, semanticRow):
                return false
            semanticRowOut = semanticRow
            matchCount = matchCount + 1
    return matchCount == 1

@borrows
fn bodyIRCleanupScheduleClearSemanticForOp(
        bodyIR: BodyIR,
        unitRow: int32,
        opRow: int32,
        semanticRowOut: var int32): bool =
    let op = bodyIR.ops[opRow]
    if op.kind != BodyOpLoadConstTag || op.operands.len != 2 ||
       op.operands[0] != LocalI32Tag || op.operands[1] != 0:
        return false
    let clearStart = bodyIR.cleanupIntent.unitClearStarts[unitRow]
    let clearCount = bodyIR.cleanupIntent.unitClearCounts[unitRow]
    var matchCount: int32
    for offset in 0..<clearCount:
        let row = clearStart + offset
        if bodyIR.cleanupIntent.clearKinds[row] ==
               BodyCleanupClearLocalZeroTag &&
           bodyIR.cleanupIntent.clearTargetSourceSlotIds[row] == op.target:
            let semanticRow =
                bodyIR.cleanupIntent.clearSemanticRows[row]
            if !bodyIRCleanupScheduleSemanticRowInUnit(
                   bodyIR, unitRow, semanticRow):
                return false
            semanticRowOut = semanticRow
            matchCount = matchCount + 1
    return matchCount == 1

@borrows
fn bodyIRCleanupScheduleTransitionSemanticForOp(
        bodyIR: BodyIR,
        unitRow: int32,
        opRow: int32,
        semanticRowOut: var int32): bool =
    if bodyIR.cleanupIntent.unitKinds[unitRow] !=
           BodyCleanupUnitTransitionTag:
        return false
    let opStart = bodyIR.cleanupSchedule.opStarts[unitRow]
    let semanticStart =
        bodyIR.cleanupIntent.unitSemanticStarts[unitRow]
    let semanticCount =
        bodyIR.cleanupIntent.unitSemanticCounts[unitRow]
    let op = bodyIR.ops[opRow]
    if bodyIR.cleanupSchedule.opCounts[unitRow] != semanticCount ||
       opRow < opStart || opRow >= opStart + semanticCount ||
       op.kind != BodyOpLoadConstTag || op.target < 0 ||
       op.target >= bodyIR.localSlots.len || op.operands.len != 2 ||
       op.operands[0] != LocalI32Tag ||
       (op.operands[1] != 0 && op.operands[1] != 1) ||
       bodyIR.localSlots[op.target].typeKind != LocalI32Tag:
        return false
    semanticRowOut = semanticStart + opRow - opStart
    return true

@borrows
fn bodyIRCleanupScheduleOpSemanticRow(
        bodyIR: BodyIR,
        unitRow: int32,
        opRow: int32,
        semanticRowOut: var int32): bool =
    let op = bodyIR.ops[opRow]
    var candidate: int32 = -1
    var snapshotSemantic: int32
    if bodyIRCleanupScheduleSnapshotSemanticForOp(
           bodyIR, unitRow, opRow, snapshotSemantic):
        candidate = snapshotSemantic
    var clearSemantic: int32
    if bodyIRCleanupScheduleClearSemanticForOp(
           bodyIR, unitRow, opRow, clearSemantic):
        if candidate >= 0 && candidate != clearSemantic:
            return false
        candidate = clearSemantic
    var transitionSemantic: int32
    if bodyIRCleanupScheduleTransitionSemanticForOp(
           bodyIR, unitRow, opRow, transitionSemantic):
        if candidate >= 0 && candidate != transitionSemantic:
            return false
        candidate = transitionSemantic
    if op.valueDefOriginKind ==
           BodyDefinitionOriginCanonicalCleanupActionTag &&
       bodyIRCleanupScheduleSemanticRowInUnit(
           bodyIR, unitRow, op.valueDefOriginId):
        if candidate >= 0 && candidate != op.valueDefOriginId:
            return false
        candidate = op.valueDefOriginId
    if bodyIRCleanupScheduleSemanticRowInUnit(
           bodyIR, unitRow, op.consumeActionRow):
        if candidate >= 0 && candidate != op.consumeActionRow:
            return false
        candidate = op.consumeActionRow
    if candidate < 0 &&
       !bodyIRCleanupScheduleExecutionSemanticRow(
           bodyIR, unitRow, candidate):
        return false
    if !bodyIRCleanupScheduleSemanticRowInUnit(
           bodyIR, unitRow, candidate):
        return false
    semanticRowOut = candidate
    return true

@borrows
fn bodyIRCleanupScheduleCallSemanticRow(
        bodyIR: BodyIR,
        unitRow: int32,
        callRow: int32,
        semanticRowOut: var int32): bool =
    let call = bodyIR.callSequence[callRow]
    var candidate: int32 = -1
    if call.resultDefinitionOriginKind ==
           BodyDefinitionOriginCanonicalCleanupActionTag &&
       bodyIRCleanupScheduleSemanticRowInUnit(
           bodyIR, unitRow, call.resultDefinitionOriginId):
        candidate = call.resultDefinitionOriginId
    if bodyIRCleanupScheduleSemanticRowInUnit(
           bodyIR, unitRow, call.consumeActionRow):
        if candidate >= 0 && candidate != call.consumeActionRow:
            return false
        candidate = call.consumeActionRow
    if candidate < 0 &&
       !bodyIRCleanupScheduleExecutionSemanticRow(
           bodyIR, unitRow, candidate):
        return false
    if !bodyIRCleanupScheduleSemanticRowInUnit(
           bodyIR, unitRow, candidate):
        return false
    semanticRowOut = candidate
    return true

@borrows
fn bodyIRCleanupScheduleProjectedConditionSlot(
        bodyIR: BodyIR,
        unitRow: int32,
        sourceSlotId: int32,
        projectedSlotOut: var int32): bool =
    var ownerIndex: int32
    var ownerOrdinal: int32
    if !bodyIRCleanupScheduleOwnerForUnit(
           bodyIR, unitRow, ownerIndex, ownerOrdinal):
        return false
    var unitStart: int32
    var unitCount: int32
    if !bodyIRCleanupScheduleOwnerUnitRange(
           bodyIR, ownerIndex, unitStart, unitCount):
        return false
    var matchCount: int32
    for priorUnitRow in unitStart..<unitRow:
        let sourceStart =
            bodyIR.cleanupIntent.unitSnapshotSourceSlotStarts[
                priorUnitRow]
        let sourceCount =
            bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts[
                priorUnitRow]
        let projectedStart =
            bodyIR.cleanupSchedule.unitProjectedSnapshotSlotStarts[
                priorUnitRow]
        let projectedCount =
            bodyIR.cleanupSchedule.unitProjectedSnapshotSlotCounts[
                priorUnitRow]
        if sourceCount != projectedCount:
            return false
        for offset in 0..<sourceCount:
            if bodyIR.cleanupIntent.snapshotSourceSlotIds[
                   sourceStart + offset] == sourceSlotId:
                projectedSlotOut =
                    bodyIR.cleanupSchedule.projectedSnapshotSlotIds[
                        projectedStart + offset]
                matchCount = matchCount + 1
    return matchCount == 1

@borrows
fn bodyIRCleanupSchedulePredicateSemanticForTerm(
        bodyIR: BodyIR,
        unitRow: int32,
        termRow: int32,
        semanticRowOut: var int32): bool =
    let term = bodyIR.terms[termRow]
    if term.kind != BodyTermCbrTag:
        return false
    let conditionStart =
        bodyIR.cleanupIntent.unitConditionStarts[unitRow]
    let conditionCount =
        bodyIR.cleanupIntent.unitConditionCounts[unitRow]
    var matchCount: int32
    for offset in 0..<conditionCount:
        let row = conditionStart + offset
        let conditionKind = bodyIR.cleanupIntent.conditionKinds[row]
        let sourceSlotId =
            bodyIR.cleanupIntent.conditionInputSourceSlotIds[row]
        var slotMatches = term.lhsSlot == sourceSlotId
        var projectedSlotId: int32
        if bodyIRCleanupScheduleProjectedConditionSlot(
               bodyIR, unitRow, sourceSlotId, projectedSlotId) &&
           term.lhsSlot == projectedSlotId:
            slotMatches = true
        if term.conditionKind == conditionKind && slotMatches:
            let semanticRow =
                bodyIR.cleanupIntent.conditionSemanticRows[row]
            if !bodyIRCleanupScheduleSemanticRowInUnit(
                   bodyIR, unitRow, semanticRow):
                return false
            semanticRowOut = semanticRow
            matchCount = matchCount + 1
    return matchCount == 1

@borrows
fn bodyIRCleanupScheduleExpectedEffectsInto(
        bodyIR: BodyIR,
        unitRow: int32,
        semanticRows: var int32[],
        physicalDomains: var int32[],
        physicalRows: var int32[],
        roles: var int32[]): bool =
    if semanticRows.len != 0 || physicalDomains.len != 0 ||
       physicalRows.len != 0 || roles.len != 0 ||
       unitRow < 0 ||
       unitRow >= bodyIR.cleanupSchedule.opStarts.len:
        return false
    let opStart = bodyIR.cleanupSchedule.opStarts[unitRow]
    let opCount = bodyIR.cleanupSchedule.opCounts[unitRow]
    for offset in 0..<opCount:
        let opRow = opStart + offset
        let op = bodyIR.ops[opRow]
        var semanticRow: int32
        if !bodyIRCleanupScheduleOpSemanticRow(
               bodyIR, unitRow, opRow, semanticRow):
            return false
        let snapshotDefinition =
            bodyIR.cleanupIntent.unitKinds[unitRow] ==
                BodyCleanupUnitReturnSnapshotTag ||
            bodyIR.cleanupIntent.unitKinds[unitRow] ==
                BodyCleanupUnitGuardSnapshotTag
        let semanticDefinition =
            op.valueDefOriginKind ==
                BodyDefinitionOriginCanonicalCleanupActionTag ||
            (bodyIR.cleanupIntent.unitKinds[unitRow] ==
                 BodyCleanupUnitDeferTag &&
             op.valueDefSemanticRow >= 0) ||
            snapshotDefinition
        if semanticDefinition &&
           !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               semanticRow, BodyCleanupEffectDomainBodyOpTag,
               opRow, BodyCleanupEffectRoleDefinitionTag):
            return false
        if bodyIRCleanupScheduleSemanticRowInUnit(
               bodyIR, unitRow, op.consumeActionRow) &&
           !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               op.consumeActionRow,
               BodyCleanupEffectDomainBodyOpTag,
               opRow, BodyCleanupEffectRoleConsumeTag):
            return false
        var clearSemantic: int32
        if bodyIRCleanupScheduleClearSemanticForOp(
               bodyIR, unitRow, opRow, clearSemantic) &&
           !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               clearSemantic, BodyCleanupEffectDomainBodyOpTag,
               opRow, BodyCleanupEffectRoleClearTag):
            return false
        var transitionSemantic: int32
        if bodyIRCleanupScheduleTransitionSemanticForOp(
               bodyIR, unitRow, opRow, transitionSemantic) &&
           !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               transitionSemantic,
               BodyCleanupEffectDomainBodyOpTag,
               opRow, BodyCleanupEffectRoleTransitionTag):
            return false
        if !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               semanticRow, BodyCleanupEffectDomainBodyOpTag,
               opRow, BodyCleanupEffectRoleExecuteTag):
            return false
    let callStart = bodyIR.cleanupSchedule.callStarts[unitRow]
    let callCount = bodyIR.cleanupSchedule.callCounts[unitRow]
    for offset in 0..<callCount:
        let callRow = callStart + offset
        let call = bodyIR.callSequence[callRow]
        var semanticRow: int32
        if !bodyIRCleanupScheduleCallSemanticRow(
               bodyIR, unitRow, callRow, semanticRow):
            return false
        if call.resultDefinitionOriginKind ==
               BodyDefinitionOriginCanonicalCleanupActionTag &&
           !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               semanticRow, BodyCleanupEffectDomainCallOpTag,
               callRow, BodyCleanupEffectRoleDefinitionTag):
            return false
        if bodyIRCleanupScheduleSemanticRowInUnit(
               bodyIR, unitRow, call.consumeActionRow) &&
           !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               call.consumeActionRow,
               BodyCleanupEffectDomainCallOpTag,
               callRow, BodyCleanupEffectRoleConsumeTag):
            return false
        if !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               semanticRow, BodyCleanupEffectDomainCallOpTag,
               callRow, BodyCleanupEffectRoleExecuteTag):
            return false
    let termStart = bodyIR.cleanupSchedule.termStarts[unitRow]
    let termCount = bodyIR.cleanupSchedule.termCounts[unitRow]
    for offset in 0..<termCount:
        let termRow = termStart + offset
        var semanticRow: int32
        if bodyIRCleanupSchedulePredicateSemanticForTerm(
               bodyIR, unitRow, termRow, semanticRow) &&
           !bodyIRCleanupScheduleExpectedEffectAppend(
               semanticRows, physicalDomains, physicalRows, roles,
               semanticRow, BodyCleanupEffectDomainBodyTermTag,
               termRow, BodyCleanupEffectRolePredicateTag):
            return false
    for clearOffset in 0..<
            bodyIR.cleanupIntent.unitClearCounts[unitRow]:
        let clearRow = bodyIR.cleanupIntent.unitClearStarts[unitRow] +
                       clearOffset
        var foundCount: int32
        for effectRow in 0..<semanticRows.len:
            if semanticRows[effectRow] ==
                   bodyIR.cleanupIntent.clearSemanticRows[clearRow] &&
               roles[effectRow] == BodyCleanupEffectRoleClearTag:
                foundCount = foundCount + 1
        if foundCount != 1:
            return false
    for conditionOffset in 0..<
            bodyIR.cleanupIntent.unitConditionCounts[unitRow]:
        let conditionRow =
            bodyIR.cleanupIntent.unitConditionStarts[unitRow] +
            conditionOffset
        var foundCount: int32
        for effectRow in 0..<semanticRows.len:
            if semanticRows[effectRow] ==
                   bodyIR.cleanupIntent.conditionSemanticRows[
                       conditionRow] &&
               roles[effectRow] ==
                   BodyCleanupEffectRolePredicateTag:
                foundCount = foundCount + 1
        if foundCount != 1:
            return false
    if bodyIR.cleanupIntent.unitKinds[unitRow] ==
           BodyCleanupUnitTransitionTag:
        for semanticOffset in 0..<
                bodyIR.cleanupIntent.unitSemanticCounts[unitRow]:
            let semanticRow =
                bodyIR.cleanupIntent.unitSemanticStarts[unitRow] +
                semanticOffset
            var foundCount: int32
            for effectRow in 0..<semanticRows.len:
                if semanticRows[effectRow] == semanticRow &&
                   roles[effectRow] ==
                       BodyCleanupEffectRoleTransitionTag:
                    foundCount = foundCount + 1
            if foundCount != 1:
                return false
    return semanticRows.len > 0 &&
           semanticRows.len == physicalDomains.len &&
           semanticRows.len == physicalRows.len &&
           semanticRows.len == roles.len

fn BodyIRCleanupScheduleAppendEffect(
        bodyIR: var BodyIR,
        unitRow: int32,
        semanticRow: int32,
        physicalDomain: int32,
        physicalRow: int32,
        role: int32) =
    if !bodyIR.cleanupSchedule.building ||
       bodyIR.cleanupSchedule.sealed ||
       bodyIR.cleanupSchedule.opStarts.len !=
           bodyIR.cleanupIntent.unitKinds.len ||
       unitRow < 0 ||
       unitRow >= bodyIR.cleanupSchedule.unitEffectStarts.len ||
       !bodyIRCleanupScheduleSemanticRowInUnit(
           bodyIR, unitRow, semanticRow) ||
       !BodyIRCleanupEffectPhysicalDomainValid(physicalDomain) ||
       !BodyIRCleanupEffectRoleValid(role) ||
       !bodyIRCleanupScheduleUnitContainsPhysicalRow(
           bodyIR, unitRow, physicalDomain, physicalRow):
        panic("body ir cleanup schedule: effect append invalid")
    for priorUnit in 0..<unitRow:
        var priorSemanticRows: int32[]
        var priorPhysicalDomains: int32[]
        var priorPhysicalRows: int32[]
        var priorRoles: int32[]
        if !bodyIRCleanupScheduleExpectedEffectsInto(
               bodyIR,
               priorUnit,
               priorSemanticRows,
               priorPhysicalDomains,
               priorPhysicalRows,
               priorRoles) ||
           bodyIR.cleanupSchedule.unitEffectCounts[priorUnit] !=
               priorSemanticRows.len:
            panic("body ir cleanup schedule: prior effect unit incomplete")
    for laterUnit in (unitRow + 1)..<
            bodyIR.cleanupSchedule.unitEffectCounts.len:
        if bodyIR.cleanupSchedule.unitEffectCounts[laterUnit] != 0:
            panic("body ir cleanup schedule: effect unit order invalid")
    # wall76: unitEffectStarts 在 AppendUnit 阶段只是占位（全 unit 先行
    # 构建序下恒 0）。本 unit 首条 effect 在此绑定真实区间起点 = 当时的
    # 全局 effects 行数；后续条目沿用绑定值，start+count==全局行数的 CSR
    # 紧凑审计逐条保持。乱序（前面 unit 的 effects 未补齐）由上方
    # prior-unit 审计拦死，重复/缺漏由下方 expected/duplicate 审计拦死。
    var start = bodyIR.cleanupSchedule.unitEffectStarts[unitRow]
    let count = bodyIR.cleanupSchedule.unitEffectCounts[unitRow]
    if count == 0:
        start = bodyIR.cleanupSchedule.effectSemanticRows.len
        bodyIR.cleanupSchedule.unitEffectStarts[unitRow] = start
    if start + count != bodyIR.cleanupSchedule.effectSemanticRows.len:
        panic("body ir cleanup schedule: effect csr drift")
    var expectedSemanticRows: int32[]
    var expectedPhysicalDomains: int32[]
    var expectedPhysicalRows: int32[]
    var expectedRoles: int32[]
    if !bodyIRCleanupScheduleExpectedEffectsInto(
           bodyIR,
           unitRow,
           expectedSemanticRows,
           expectedPhysicalDomains,
           expectedPhysicalRows,
           expectedRoles) ||
       count >= expectedSemanticRows.len ||
       expectedSemanticRows[count] != semanticRow ||
       expectedPhysicalDomains[count] != physicalDomain ||
       expectedPhysicalRows[count] != physicalRow ||
       expectedRoles[count] != role:
        panic("body ir cleanup schedule: effect relation mismatch")
    for priorRow in 0..<bodyIR.cleanupSchedule.effectSemanticRows.len:
        if bodyIR.cleanupSchedule.effectSemanticRows[priorRow] ==
               semanticRow &&
           bodyIR.cleanupSchedule.effectPhysicalDomains[priorRow] ==
               physicalDomain &&
           bodyIR.cleanupSchedule.effectPhysicalRows[priorRow] ==
               physicalRow &&
           bodyIR.cleanupSchedule.effectRoles[priorRow] == role:
            panic("body ir cleanup schedule: effect duplicate")
    add(bodyIR.cleanupSchedule.effectSemanticRows, semanticRow)
    add(bodyIR.cleanupSchedule.effectPhysicalDomains, physicalDomain)
    add(bodyIR.cleanupSchedule.effectPhysicalRows, physicalRow)
    add(bodyIR.cleanupSchedule.effectRoles, role)
    bodyIR.cleanupSchedule.unitEffectCounts[unitRow] = count + 1

fn BodyIRCleanupScheduleAppendExpectedEffectsForUnit(
        bodyIR: var BodyIR,
        unitRow: int32) =
    var semanticRows: int32[]
    var physicalDomains: int32[]
    var physicalRows: int32[]
    var roles: int32[]
    if !bodyIRCleanupScheduleExpectedEffectsInto(
           bodyIR,
           unitRow,
           semanticRows,
           physicalDomains,
           physicalRows,
           roles):
        panic("body ir cleanup schedule: expected effects invalid")
    for offset in 0..<semanticRows.len:
        BodyIRCleanupScheduleAppendEffect(
            bodyIR,
            unitRow,
            semanticRows[offset],
            physicalDomains[offset],
            physicalRows[offset],
            roles[offset])

@borrows
fn bodyIRCleanupScheduleBlockInUnit(
        bodyIR: BodyIR,
        unitRow: int32,
        blockId: int32): bool =
    if unitRow < 0 ||
       unitRow >= bodyIR.cleanupSchedule.blockStarts.len:
        return false
    return blockId >= bodyIR.cleanupSchedule.blockStarts[unitRow] &&
           blockId < bodyIR.cleanupSchedule.blockStarts[unitRow] +
               bodyIR.cleanupSchedule.blockCounts[unitRow]

@borrows
fn bodyIRCleanupScheduleUnitRangesValid(
        bodyIR: BodyIR,
        unitRow: int32): bool =
    if unitRow < 0 ||
       unitRow >= bodyIR.cleanupIntent.unitKinds.len ||
       unitRow >= bodyIR.cleanupSchedule.opStarts.len ||
       !bodyIRCleanupRangeValid(
           bodyIR.cleanupSchedule.unitLocalStarts[unitRow],
           bodyIR.cleanupSchedule.unitLocalCounts[unitRow],
           bodyIR.localSlots.len,
           true) ||
       !bodyIRCleanupRangeValid(
           bodyIR.cleanupSchedule.opStarts[unitRow],
           bodyIR.cleanupSchedule.opCounts[unitRow],
           bodyIR.ops.len,
           true) ||
       !bodyIRCleanupRangeValid(
           bodyIR.cleanupSchedule.callStarts[unitRow],
           bodyIR.cleanupSchedule.callCounts[unitRow],
           bodyIR.callSequence.len,
           true) ||
       !bodyIRCleanupRangeValid(
           bodyIR.cleanupSchedule.blockStarts[unitRow],
           bodyIR.cleanupSchedule.blockCounts[unitRow],
           bodyIR.blocks.len,
           false) ||
       !bodyIRCleanupRangeValid(
           bodyIR.cleanupSchedule.termStarts[unitRow],
           bodyIR.cleanupSchedule.termCounts[unitRow],
           bodyIR.terms.len,
           false) ||
       bodyIR.cleanupSchedule.unitLocalStarts[unitRow] <
           bodyIR.cleanupIntent.originalLocalCount ||
       bodyIR.cleanupSchedule.opStarts[unitRow] <
           bodyIR.cleanupIntent.originalOpCount ||
       bodyIR.cleanupSchedule.callStarts[unitRow] <
           bodyIR.cleanupIntent.originalCallCount ||
       bodyIR.cleanupSchedule.blockStarts[unitRow] <
           bodyIR.cleanupIntent.originalBlockCount ||
       bodyIR.cleanupSchedule.termStarts[unitRow] <
           bodyIR.cleanupIntent.originalTermCount:
        return false
    if unitRow > 0:
        let priorRow = unitRow - 1
        if bodyIR.cleanupSchedule.unitLocalStarts[unitRow] <
               bodyIR.cleanupSchedule.unitLocalStarts[priorRow] +
                   bodyIR.cleanupSchedule.unitLocalCounts[priorRow] ||
           bodyIR.cleanupSchedule.opStarts[unitRow] <
               bodyIR.cleanupSchedule.opStarts[priorRow] +
                   bodyIR.cleanupSchedule.opCounts[priorRow] ||
           bodyIR.cleanupSchedule.callStarts[unitRow] <
               bodyIR.cleanupSchedule.callStarts[priorRow] +
                   bodyIR.cleanupSchedule.callCounts[priorRow] ||
           bodyIR.cleanupSchedule.blockStarts[unitRow] <
               bodyIR.cleanupSchedule.blockStarts[priorRow] +
                   bodyIR.cleanupSchedule.blockCounts[priorRow] ||
           bodyIR.cleanupSchedule.termStarts[unitRow] <
               bodyIR.cleanupSchedule.termStarts[priorRow] +
                   bodyIR.cleanupSchedule.termCounts[priorRow]:
            return false
    let projectedStart =
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotStarts[unitRow]
    let projectedCount =
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotCounts[unitRow]
    let expectedProjectedCount =
        bodyIR.cleanupIntent.unitSnapshotSourceSlotCounts[unitRow]
    if projectedStart < 0 || projectedCount < 0 ||
       projectedStart >
           bodyIR.cleanupSchedule.projectedSnapshotSlotIds.len -
               projectedCount ||
       projectedCount != expectedProjectedCount:
        return false
    let localStart = bodyIR.cleanupSchedule.unitLocalStarts[unitRow]
    let localCount = bodyIR.cleanupSchedule.unitLocalCounts[unitRow]
    for offset in 0..<projectedCount:
        let projectedSlotId =
            bodyIR.cleanupSchedule.projectedSnapshotSlotIds[
                projectedStart + offset]
        if !bodyIRCleanupScheduleSnapshotProjectionValid(
               bodyIR,
               unitRow,
               localStart,
               localCount,
               offset,
               projectedSlotId):
            return false
        for priorOffset in 0..<offset:
            if bodyIR.cleanupSchedule.projectedSnapshotSlotIds[
                   projectedStart + priorOffset] == projectedSlotId:
                return false
    let opStart = bodyIR.cleanupSchedule.opStarts[unitRow]
    let opCount = bodyIR.cleanupSchedule.opCounts[unitRow]
    let callStart = bodyIR.cleanupSchedule.callStarts[unitRow]
    let callCount = bodyIR.cleanupSchedule.callCounts[unitRow]
    let blockStart = bodyIR.cleanupSchedule.blockStarts[unitRow]
    let blockCount = bodyIR.cleanupSchedule.blockCounts[unitRow]
    let termStart = bodyIR.cleanupSchedule.termStarts[unitRow]
    let termCount = bodyIR.cleanupSchedule.termCounts[unitRow]
    for blockOffset in 0..<blockCount:
        let blockId = blockStart + blockOffset
        let block = bodyIR.blocks[blockId]
        if block.id != blockId || block.opStart < opStart ||
           block.opCount < 0 ||
           block.opStart > opStart + opCount - block.opCount ||
           block.termIndex < termStart ||
           block.termIndex >= termStart + termCount:
            return false
    for opOffset in 0..<opCount:
        let opRow = opStart + opOffset
        var ownerCount: int32
        for blockOffset in 0..<blockCount:
            let block = bodyIR.blocks[blockStart + blockOffset]
            if opRow >= block.opStart &&
               opRow < block.opStart + block.opCount:
                ownerCount = ownerCount + 1
        if ownerCount != 1:
            return false
    for termOffset in 0..<termCount:
        let termRow = termStart + termOffset
        var ownerCount: int32
        for blockOffset in 0..<blockCount:
            if bodyIR.blocks[blockStart + blockOffset].termIndex ==
                   termRow:
                ownerCount = ownerCount + 1
        if ownerCount != 1:
            return false
    for callOffset in 0..<callCount:
        let callRow = callStart + callOffset
        var ownerCount: int32
        for opOffset in 0..<opCount:
            let op = bodyIR.ops[opStart + opOffset]
            if op.kind == BodyOpCallTag && op.operands.len == 1 &&
               op.operands[0] == callRow:
                ownerCount = ownerCount + 1
        if ownerCount != 1:
            return false
    return true

@borrows
fn bodyIRCleanupScheduleExpectedFinalEdgeKind(
        bodyIR: BodyIR,
        ownerIndex: int32): int32 =
    let exitCount = bodyIR.cleanupIntent.sourceBlockIds.len
    if ownerIndex < 0 ||
       ownerIndex >= bodyIRCleanupScheduleExpectedOwnerCount(bodyIR):
        return BodyControlEdgeUnknown
    if ownerIndex >= exitCount:
        return BodyControlEdgeNormal
    if bodyIR.cleanupIntent.sourceExitKinds[ownerIndex] ==
           BodyDeferReplaySourceReturnExitTag:
        return BodyControlEdgeNormal
    return bodyIR.cleanupIntent.originalEdgeKinds[ownerIndex]

@borrows
fn bodyIRCleanupScheduleOwnerGraphValid(
        bodyIR: BodyIR,
        ownerIndex: int32): bool =
    var unitStart: int32
    var unitCount: int32
    if !bodyIRCleanupScheduleOwnerUnitRange(
           bodyIR, ownerIndex, unitStart, unitCount) ||
       unitStart < 0 || unitCount <= 0 ||
       unitStart > bodyIR.cleanupSchedule.blockStarts.len - unitCount:
        return false
    let sourceBlockId =
        bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds[ownerIndex]
    let sourceTermRow =
        bodyIR.cleanupSchedule.ownerSourceTermRows[ownerIndex]
    let sourceSuccessorOrdinal =
        bodyIR.cleanupSchedule.ownerSourceSuccessorOrdinals[ownerIndex]
    let sourceSuccessorStart =
        bodyIR.termSuccessorStarts[sourceTermRow]
    let firstEntryBlock =
        bodyIR.cleanupSchedule.blockStarts[unitStart]
    if sourceSuccessorOrdinal < 0 ||
       sourceSuccessorOrdinal >=
           bodyIR.termSuccessorCounts[sourceTermRow] ||
       bodyIR.successorBlockIds[
           sourceSuccessorStart + sourceSuccessorOrdinal] !=
               firstEntryBlock ||
       bodyIR.successorEdgeKinds[
           sourceSuccessorStart + sourceSuccessorOrdinal] !=
               BodyControlEdgeNormal ||
       bodyIR.cleanupSchedule.ownerFinalEdgeKinds[ownerIndex] !=
           bodyIRCleanupScheduleExpectedFinalEdgeKind(
               bodyIR, ownerIndex):
        return false
    for unitOffset in 0..<unitCount:
        let unitRow = unitStart + unitOffset
        if !bodyIRCleanupScheduleUnitRangesValid(bodyIR, unitRow):
            return false
        let blockStart = bodyIR.cleanupSchedule.blockStarts[unitRow]
        let blockCount = bodyIR.cleanupSchedule.blockCounts[unitRow]
        var targetBlockId =
            bodyIR.cleanupSchedule.ownerFinalContinuationBlockIds[
                ownerIndex]
        var targetEdgeKind =
            bodyIR.cleanupSchedule.ownerFinalEdgeKinds[ownerIndex]
        if unitOffset + 1 < unitCount:
            targetBlockId = bodyIR.cleanupSchedule.blockStarts[
                unitRow + 1]
            targetEdgeKind = BodyControlEdgeNormal
        if targetBlockId < 0 ||
           targetBlockId >= bodyIR.blocks.len ||
           bodyIRCleanupScheduleBlockInUnit(
               bodyIR, unitRow, targetBlockId):
            return false
        var outgoingToTarget: int32
        for blockOffset in 0..<blockCount:
            let blockId = blockStart + blockOffset
            let termRow = bodyIR.blocks[blockId].termIndex
            let successorStart = bodyIR.termSuccessorStarts[termRow]
            let successorCount = bodyIR.termSuccessorCounts[termRow]
            for successorOrdinal in 0..<successorCount:
                let successorRow = successorStart + successorOrdinal
                let target = bodyIR.successorBlockIds[successorRow]
                if bodyIRCleanupScheduleBlockInUnit(
                       bodyIR, unitRow, target):
                    continue
                if target != targetBlockId ||
                   bodyIR.successorEdgeKinds[successorRow] !=
                       targetEdgeKind:
                    return false
                outgoingToTarget = outgoingToTarget + 1
        if outgoingToTarget <= 0:
            return false
        for targetOffset in 0..<blockCount:
            let target = blockStart + targetOffset
            var externalPredecessorCount: int32
            for predecessorId in 0..<bodyIR.blocks.len:
                let predecessorTerm =
                    bodyIR.blocks[predecessorId].termIndex
                let predecessorSuccessorStart =
                    bodyIR.termSuccessorStarts[predecessorTerm]
                let predecessorSuccessorCount =
                    bodyIR.termSuccessorCounts[predecessorTerm]
                for successorOrdinal in 0..<predecessorSuccessorCount:
                    if bodyIR.successorBlockIds[
                           predecessorSuccessorStart +
                               successorOrdinal] != target ||
                       bodyIRCleanupScheduleBlockInUnit(
                           bodyIR, unitRow, predecessorId):
                        continue
                    if targetOffset != 0:
                        return false
                    if unitOffset == 0:
                        if predecessorId != sourceBlockId ||
                           predecessorTerm != sourceTermRow ||
                           successorOrdinal != sourceSuccessorOrdinal:
                            return false
                    elif !bodyIRCleanupScheduleBlockInUnit(
                               bodyIR, unitRow - 1,
                               predecessorId):
                        return false
                    externalPredecessorCount =
                        externalPredecessorCount + 1
            if targetOffset == 0 && externalPredecessorCount <= 0:
                return false
            if targetOffset != 0 && externalPredecessorCount != 0:
                return false
        var reached: bool[]
        var reachesTarget: bool[]
        for _ in 0..<blockCount:
            add(reached, false)
            add(reachesTarget, false)
        reached[0] = true
        var changed = true
        while changed:
            changed = false
            for blockOffset in 0..<blockCount:
                if !reached[blockOffset]:
                    continue
                let termRow =
                    bodyIR.blocks[blockStart + blockOffset].termIndex
                let successorStart =
                    bodyIR.termSuccessorStarts[termRow]
                let successorCount =
                    bodyIR.termSuccessorCounts[termRow]
                for successorOrdinal in 0..<successorCount:
                    let target = bodyIR.successorBlockIds[
                        successorStart + successorOrdinal]
                    if target >= blockStart &&
                       target < blockStart + blockCount &&
                       !reached[target - blockStart]:
                        reached[target - blockStart] = true
                        changed = true
        for blockOffset in 0..<blockCount:
            if !reached[blockOffset]:
                return false
            let termRow =
                bodyIR.blocks[blockStart + blockOffset].termIndex
            let successorStart = bodyIR.termSuccessorStarts[termRow]
            let successorCount = bodyIR.termSuccessorCounts[termRow]
            for successorOrdinal in 0..<successorCount:
                if bodyIR.successorBlockIds[
                       successorStart + successorOrdinal] ==
                       targetBlockId:
                    reachesTarget[blockOffset] = true
        changed = true
        while changed:
            changed = false
            for blockOffset in 0..<blockCount:
                if reachesTarget[blockOffset]:
                    continue
                let termRow =
                    bodyIR.blocks[blockStart + blockOffset].termIndex
                let successorStart =
                    bodyIR.termSuccessorStarts[termRow]
                let successorCount =
                    bodyIR.termSuccessorCounts[termRow]
                for successorOrdinal in 0..<successorCount:
                    let target = bodyIR.successorBlockIds[
                        successorStart + successorOrdinal]
                    if target >= blockStart &&
                       target < blockStart + blockCount &&
                       reachesTarget[target - blockStart]:
                        reachesTarget[blockOffset] = true
                        changed = true
        for blockOffset in 0..<blockCount:
            if !reachesTarget[blockOffset]:
                return false
    return true

@borrows
fn bodyIRCleanupScheduleEffectsValid(bodyIR: BodyIR): bool =
    var effectCursor: int32
    for unitRow in 0..<bodyIR.cleanupSchedule.opStarts.len:
        if bodyIR.cleanupSchedule.unitEffectStarts[unitRow] !=
               effectCursor ||
           bodyIR.cleanupSchedule.unitEffectCounts[unitRow] <= 0 ||
           bodyIR.cleanupSchedule.unitEffectCounts[unitRow] >
               bodyIR.cleanupSchedule.effectSemanticRows.len -
                   effectCursor:
            return false
        var expectedSemanticRows: int32[]
        var expectedPhysicalDomains: int32[]
        var expectedPhysicalRows: int32[]
        var expectedRoles: int32[]
        if !bodyIRCleanupScheduleExpectedEffectsInto(
               bodyIR,
               unitRow,
               expectedSemanticRows,
               expectedPhysicalDomains,
               expectedPhysicalRows,
               expectedRoles) ||
           expectedSemanticRows.len !=
               bodyIR.cleanupSchedule.unitEffectCounts[unitRow]:
            return false
        for offset in 0..<expectedSemanticRows.len:
            let effectRow = effectCursor + offset
            if bodyIR.cleanupSchedule.effectSemanticRows[effectRow] !=
                   expectedSemanticRows[offset] ||
               bodyIR.cleanupSchedule.effectPhysicalDomains[effectRow] !=
                   expectedPhysicalDomains[offset] ||
               bodyIR.cleanupSchedule.effectPhysicalRows[effectRow] !=
                   expectedPhysicalRows[offset] ||
               bodyIR.cleanupSchedule.effectRoles[effectRow] !=
                   expectedRoles[offset]:
                return false
        effectCursor = effectCursor + expectedSemanticRows.len
    return effectCursor ==
           bodyIR.cleanupSchedule.effectSemanticRows.len

@borrows
fn bodyIRCleanupScheduleCoverageValid(bodyIR: BodyIR): bool =
    for localRow in bodyIR.cleanupIntent.originalLocalCount..<
            bodyIR.localSlots.len:
        var unitOwnerCount: int32
        for unitRow in 0..<bodyIR.cleanupSchedule.unitLocalStarts.len:
            if localRow >=
                   bodyIR.cleanupSchedule.unitLocalStarts[unitRow] &&
               localRow <
                   bodyIR.cleanupSchedule.unitLocalStarts[unitRow] +
                       bodyIR.cleanupSchedule.unitLocalCounts[unitRow]:
                unitOwnerCount = unitOwnerCount + 1
        if unitOwnerCount != 1:
            return false
    for opRow in bodyIR.cleanupIntent.originalOpCount..<bodyIR.ops.len:
        var unitOwnerCount: int32
        for unitRow in 0..<bodyIR.cleanupSchedule.opStarts.len:
            if opRow >= bodyIR.cleanupSchedule.opStarts[unitRow] &&
               opRow < bodyIR.cleanupSchedule.opStarts[unitRow] +
                   bodyIR.cleanupSchedule.opCounts[unitRow]:
                unitOwnerCount = unitOwnerCount + 1
        if unitOwnerCount != 1:
            return false
    for callRow in bodyIR.cleanupIntent.originalCallCount..<
            bodyIR.callSequence.len:
        var unitOwnerCount: int32
        for unitRow in 0..<bodyIR.cleanupSchedule.callStarts.len:
            if callRow >= bodyIR.cleanupSchedule.callStarts[unitRow] &&
               callRow < bodyIR.cleanupSchedule.callStarts[unitRow] +
                   bodyIR.cleanupSchedule.callCounts[unitRow]:
                unitOwnerCount = unitOwnerCount + 1
        if unitOwnerCount != 1:
            return false
    for blockId in bodyIR.cleanupIntent.originalBlockCount..<
            bodyIR.blocks.len:
        var unitOwnerCount: int32
        var anchor = false
        for unitRow in 0..<bodyIR.cleanupSchedule.blockStarts.len:
            if bodyIRCleanupScheduleBlockInUnit(
                   bodyIR, unitRow, blockId):
                unitOwnerCount = unitOwnerCount + 1
        for ownerIndex in 0..<
                bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds.len:
            if bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds[
                   ownerIndex] == blockId ||
               bodyIR.cleanupSchedule.ownerFinalContinuationBlockIds[
                   ownerIndex] == blockId:
                anchor = true
        if (unitOwnerCount == 1 && anchor) ||
           (unitOwnerCount == 0 && !anchor) ||
           unitOwnerCount > 1:
            return false
    for termRow in bodyIR.cleanupIntent.originalTermCount..<
            bodyIR.terms.len:
        var unitOwnerCount: int32
        var anchor = false
        for unitRow in 0..<bodyIR.cleanupSchedule.termStarts.len:
            if termRow >= bodyIR.cleanupSchedule.termStarts[unitRow] &&
               termRow < bodyIR.cleanupSchedule.termStarts[unitRow] +
                   bodyIR.cleanupSchedule.termCounts[unitRow]:
                unitOwnerCount = unitOwnerCount + 1
        for ownerIndex in 0..<
                bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds.len:
            let sourceBlockId =
                bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds[
                    ownerIndex]
            let finalBlockId =
                bodyIR.cleanupSchedule.ownerFinalContinuationBlockIds[
                    ownerIndex]
            if bodyIR.cleanupSchedule.ownerSourceTermRows[ownerIndex] ==
                   termRow ||
               bodyIR.blocks[finalBlockId].termIndex == termRow ||
               bodyIR.blocks[sourceBlockId].termIndex == termRow:
                anchor = true
        if (unitOwnerCount == 1 && anchor) ||
           (unitOwnerCount == 0 && !anchor) ||
           unitOwnerCount > 1:
            return false
    return true

@borrows
fn bodyIRCleanupScheduleUnitPayloadCidExact(
        bodyIR: BodyIR,
        unitRow: int32): layout.FixedBytes32 =
    if !bodyIRCleanupScheduleUnitRangesValid(bodyIR, unitRow) ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupIntent.rootCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.finalControlCid):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(256)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_schedule.unit_payload")
    layout.ByteBufAppendFixed32(buf, bodyIR.cleanupIntent.rootCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupIntent.unitAuthorityCids[unitRow])
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupSchedule.finalControlCid)
    bodyIRControlActionAppendI32(buf, unitRow)
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.unitLocalStarts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.unitLocalCounts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.opStarts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.opCounts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.callStarts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.callCounts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.blockStarts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.blockCounts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.termStarts[unitRow])
    bodyIRControlActionAppendI32(
        buf, bodyIR.cleanupSchedule.termCounts[unitRow])
    let projectedStart =
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotStarts[unitRow]
    let projectedCount =
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotCounts[unitRow]
    bodyIRControlActionAppendI32(buf, projectedCount)
    for offset in 0..<projectedCount:
        bodyIRControlActionAppendI32(
            buf,
            bodyIR.cleanupSchedule.projectedSnapshotSlotIds[
                projectedStart + offset])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRCleanupScheduleUnitPayloadCandidateCid(
        bodyIR: BodyIR,
        unitRow: int32): layout.FixedBytes32 =
    return bodyIRCleanupScheduleUnitPayloadCidExact(bodyIR, unitRow)

@borrows
fn bodyIRCleanupScheduleUnitPlacementCidExact(
        bodyIR: BodyIR,
        unitRow: int32): layout.FixedBytes32 =
    var ownerIndex: int32
    var ownerOrdinal: int32
    if !bodyIRCleanupScheduleOwnerForUnit(
           bodyIR, unitRow, ownerIndex, ownerOrdinal) ||
       ownerIndex < 0 ||
       ownerIndex >=
           bodyIR.cleanupSchedule.ownerContinuationCids.len ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.ownerContinuationCids[
               ownerIndex]):
        return layout.FixedBytes32()
    let effectStart =
        bodyIR.cleanupSchedule.unitEffectStarts[unitRow]
    let effectCount =
        bodyIR.cleanupSchedule.unitEffectCounts[unitRow]
    if effectStart < 0 || effectCount <= 0 ||
       effectStart >
           bodyIR.cleanupSchedule.effectSemanticRows.len - effectCount:
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(256)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_schedule.unit_placement")
    layout.ByteBufAppendFixed32(buf, bodyIR.cleanupIntent.rootCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupIntent.unitAuthorityCids[unitRow])
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupSchedule.finalControlCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupSchedule.ownerContinuationCids[ownerIndex])
    bodyIRControlActionAppendI32(buf, unitRow)
    bodyIRControlActionAppendI32(buf, ownerIndex)
    bodyIRControlActionAppendI32(buf, ownerOrdinal)
    bodyIRControlActionAppendI32(buf, effectCount)
    for offset in 0..<effectCount:
        let effectRow = effectStart + offset
        bodyIRControlActionAppendI32(
            buf, bodyIR.cleanupSchedule.effectSemanticRows[effectRow])
        bodyIRControlActionAppendI32(
            buf,
            bodyIR.cleanupSchedule.effectPhysicalDomains[effectRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.cleanupSchedule.effectPhysicalRows[effectRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.cleanupSchedule.effectRoles[effectRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRCleanupScheduleUnitPlacementCandidateCid(
        bodyIR: BodyIR,
        unitRow: int32): layout.FixedBytes32 =
    return bodyIRCleanupScheduleUnitPlacementCidExact(bodyIR, unitRow)

fn BodyIRCleanupScheduleBindUnitCids(
        bodyIR: var BodyIR,
        unitRow: int32,
        payloadCid: layout.FixedBytes32,
        placementCid: layout.FixedBytes32) =
    if !bodyIR.cleanupSchedule.building ||
       bodyIR.cleanupSchedule.sealed || unitRow < 0 ||
       unitRow >= bodyIR.cleanupSchedule.payloadCids.len ||
       !BodyIRTypeArenaArtifactCidValid(payloadCid) ||
       !BodyIRTypeArenaArtifactCidValid(placementCid) ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.payloadCids[unitRow]) ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.placementCids[unitRow]):
        panic("body ir cleanup schedule: unit cid bind invalid")
    for priorRow in 0..<unitRow:
        if !BodyIRTypeArenaArtifactCidValid(
               bodyIR.cleanupSchedule.payloadCids[priorRow]) ||
           !BodyIRTypeArenaArtifactCidValid(
               bodyIR.cleanupSchedule.placementCids[priorRow]):
            panic("body ir cleanup schedule: unit cid order invalid")
    for laterRow in (unitRow + 1)..<
            bodyIR.cleanupSchedule.payloadCids.len:
        if BodyIRTypeArenaArtifactCidValid(
               bodyIR.cleanupSchedule.payloadCids[laterRow]) ||
           BodyIRTypeArenaArtifactCidValid(
               bodyIR.cleanupSchedule.placementCids[laterRow]):
            panic("body ir cleanup schedule: unit cid order drift")
    let payloadCandidate =
        BodyIRCleanupScheduleUnitPayloadCandidateCid(bodyIR, unitRow)
    let placementCandidate =
        BodyIRCleanupScheduleUnitPlacementCandidateCid(bodyIR, unitRow)
    if !layout.FixedBytes32Equal(payloadCandidate, payloadCid) ||
       !layout.FixedBytes32Equal(placementCandidate, placementCid):
        panic("body ir cleanup schedule: unit cid mismatch")
    bodyIR.cleanupSchedule.payloadCids[unitRow] =
        layout.FixedBytes32Copy(payloadCid)
    bodyIR.cleanupSchedule.placementCids[unitRow] =
        layout.FixedBytes32Copy(placementCid)

@borrows
fn bodyIRCleanupScheduleRowsValid(bodyIR: BodyIR): bool =
    if !BodyIRCleanupScheduleSidecarRowsAligned(
           bodyIR.cleanupSchedule) ||
       !BodyIRCleanupIntentSidecarShapeValid(bodyIR) ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds.len !=
           bodyIRCleanupScheduleExpectedOwnerCount(bodyIR) ||
       bodyIR.cleanupSchedule.opStarts.len !=
           bodyIR.cleanupIntent.unitKinds.len ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.finalControlCid) ||
       !layout.FixedBytes32Equal(
           bodyIR.cleanupSchedule.finalControlCid,
           BodyIRCleanupFinalControlCid(bodyIR)):
        return false
    var projectedCursor: int32
    for unitRow in 0..<bodyIR.cleanupSchedule.opStarts.len:
        if bodyIR.cleanupSchedule.unitProjectedSnapshotSlotStarts[
               unitRow] != projectedCursor ||
           !bodyIRCleanupScheduleUnitRangesValid(bodyIR, unitRow):
            return false
        projectedCursor = projectedCursor +
            bodyIR.cleanupSchedule.unitProjectedSnapshotSlotCounts[
                unitRow]
    if projectedCursor !=
           bodyIR.cleanupSchedule.projectedSnapshotSlotIds.len ||
       !bodyIRCleanupScheduleEffectsValid(bodyIR):
        return false
    for ownerIndex in 0..<
            bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds.len:
        let candidate =
            bodyIRCleanupScheduleOwnerContinuationCidExact(
                bodyIR,
                ownerIndex,
                bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds[
                    ownerIndex],
                bodyIR.cleanupSchedule.ownerSourceTermRows[ownerIndex],
                bodyIR.cleanupSchedule.ownerSourceSuccessorOrdinals[
                    ownerIndex],
                bodyIR.cleanupSchedule.ownerFinalContinuationBlockIds[
                    ownerIndex],
                bodyIR.cleanupSchedule.ownerFinalEdgeKinds[ownerIndex])
        if !layout.FixedBytes32Equal(
               candidate,
               bodyIR.cleanupSchedule.ownerContinuationCids[
                   ownerIndex]) ||
           !bodyIRCleanupScheduleOwnerGraphValid(bodyIR, ownerIndex):
            return false
    for unitRow in 0..<bodyIR.cleanupSchedule.opStarts.len:
        if !layout.FixedBytes32Equal(
               bodyIR.cleanupSchedule.payloadCids[unitRow],
               bodyIRCleanupScheduleUnitPayloadCidExact(
                   bodyIR, unitRow)) ||
           !layout.FixedBytes32Equal(
               bodyIR.cleanupSchedule.placementCids[unitRow],
               bodyIRCleanupScheduleUnitPlacementCidExact(
                   bodyIR, unitRow)):
            return false
    return bodyIRCleanupScheduleCoverageValid(bodyIR)

@borrows
fn bodyIRCleanupScheduleRootCidExact(
        bodyIR: BodyIR): layout.FixedBytes32 =
    if !bodyIRCleanupScheduleRowsValid(bodyIR):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(2048)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_schedule")
    layout.ByteBufAppendFixed32(buf, bodyIR.cleanupIntent.rootCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupSchedule.finalControlCid)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.ownerPhysicalSourceBlockIds)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.ownerSourceTermRows)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.ownerSourceSuccessorOrdinals)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.ownerFinalContinuationBlockIds)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.ownerFinalEdgeKinds)
    bodyIRCleanupAppendFixed32Rows(
        buf, bodyIR.cleanupSchedule.ownerContinuationCids)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.cleanupSchedule.opStarts)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.cleanupSchedule.opCounts)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.cleanupSchedule.callStarts)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.cleanupSchedule.callCounts)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.cleanupSchedule.blockStarts)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.cleanupSchedule.blockCounts)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.cleanupSchedule.termStarts)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.cleanupSchedule.termCounts)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.unitLocalStarts)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.unitLocalCounts)
    bodyIRCleanupAppendI32Rows(
        buf,
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotStarts)
    bodyIRCleanupAppendI32Rows(
        buf,
        bodyIR.cleanupSchedule.unitProjectedSnapshotSlotCounts)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.unitEffectStarts)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.unitEffectCounts)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.effectSemanticRows)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.effectPhysicalDomains)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.effectPhysicalRows)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.effectRoles)
    bodyIRCleanupAppendFixed32Rows(
        buf, bodyIR.cleanupSchedule.payloadCids)
    bodyIRCleanupAppendFixed32Rows(
        buf, bodyIR.cleanupSchedule.placementCids)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.cleanupSchedule.projectedSnapshotSlotIds)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRCleanupScheduleCandidateRootCid(
        bodyIR: BodyIR): layout.FixedBytes32 =
    return bodyIRCleanupScheduleRootCidExact(bodyIR)

fn BodyIRCleanupScheduleBindRootCid(
        bodyIR: var BodyIR,
        rootCid: layout.FixedBytes32) =
    if !bodyIR.cleanupSchedule.building ||
       bodyIR.cleanupSchedule.sealed ||
       BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.rootCid) ||
       !BodyIRTypeArenaArtifactCidValid(rootCid) ||
       !bodyIRCleanupScheduleRowsValid(bodyIR):
        panic("body ir cleanup schedule: root bind invalid")
    let candidate = BodyIRCleanupScheduleCandidateRootCid(bodyIR)
    if !layout.FixedBytes32Equal(candidate, rootCid):
        panic("body ir cleanup schedule: root mismatch")
    bodyIR.cleanupSchedule.rootCid =
        layout.FixedBytes32Copy(rootCid)

@borrows
fn BodyIRCleanupScheduleSidecarShapeValid(bodyIR: BodyIR): bool =
    if BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
           bodyIR.cleanupSchedule):
        return true
    return !bodyIR.cleanupSchedule.building &&
           bodyIR.cleanupSchedule.sealed &&
           BodyIRTypeArenaArtifactCidValid(
               bodyIR.cleanupSchedule.rootCid) &&
           bodyIRCleanupScheduleRowsValid(bodyIR) &&
           layout.FixedBytes32Equal(
               bodyIR.cleanupSchedule.rootCid,
               BodyIRCleanupScheduleCandidateRootCid(bodyIR))

fn BodyIRCleanupScheduleSeal(
        bodyIR: var BodyIR,
        expectedRootCid: layout.FixedBytes32) =
    if !bodyIR.cleanupSchedule.building ||
       bodyIR.cleanupSchedule.sealed ||
       !BodyIRTypeArenaArtifactCidValid(expectedRootCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.cleanupSchedule.rootCid) ||
       !layout.FixedBytes32Equal(
           bodyIR.cleanupSchedule.rootCid, expectedRootCid) ||
       !bodyIRCleanupScheduleRowsValid(bodyIR) ||
       !layout.FixedBytes32Equal(
           BodyIRCleanupScheduleCandidateRootCid(bodyIR),
           expectedRootCid):
        panic("body ir cleanup schedule: seal admission failed")
    bodyIR.cleanupSchedule.building = false
    bodyIR.cleanupSchedule.sealed = true
    if !BodyIRCleanupScheduleSidecarShapeValid(bodyIR):
        panic("body ir cleanup schedule: sealed shape invalid")

fn BodyIRDeferReplaySidecarNew(): BodyIRDeferReplaySidecar =
    var out: BodyIRDeferReplaySidecar
    # wall69: 大结构构造器逐字段显式落定。seq 用描述符直写
    # (len=0/cap=0/buffer=nil, 纯 store 无 rc 语义)——「= []」空列赋值带
    # release 旧值语义, 对未初始化槽=release 垃圾描述符, 与栈复用残留叠加
    # 即误释放真实堆块 (cold_nested 编译期 use-after-free 实证)。
    out.building = false
    out.sealed = false
    out.rootCid = layout.FixedBytes32()
    out.templateOpMapStarts.len = 0
    out.templateOpMapStarts.cap = 0
    out.templateOpMapStarts.buffer = nil
    out.templateOpMapCounts.len = 0
    out.templateOpMapCounts.cap = 0
    out.templateOpMapCounts.buffer = nil
    out.templateOpRows.len = 0
    out.templateOpRows.cap = 0
    out.templateOpRows.buffer = nil
    return out
@borrows
fn BodyIRDeferReplaySidecarRowsAligned(
        sidecar: BodyIRDeferReplaySidecar): bool =
    return sidecar.templateOpMapStarts.len ==
               sidecar.templateOpMapCounts.len

@borrows
fn BodyIRDeferReplaySidecarHasPhysicalStorage(
        sidecar: BodyIRDeferReplaySidecar): bool =
    return sidecar.templateOpMapStarts.cap > 0 ||
           sidecar.templateOpMapCounts.cap > 0 ||
           sidecar.templateOpRows.cap > 0

@borrows
fn BodyIRDeferReplaySidecarIsCanonicalEmpty(
        sidecar: BodyIRDeferReplaySidecar): bool =
    return !sidecar.building && !sidecar.sealed &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.rootCid) &&
           sidecar.templateOpMapStarts.len == 0 &&
           sidecar.templateOpRows.len == 0 &&
           BodyIRDeferReplaySidecarRowsAligned(sidecar) &&
           !BodyIRDeferReplaySidecarHasPhysicalStorage(sidecar)

@borrows
fn bodyIRDeferReplayMoveSourceValid(
        sidecar: BodyIRDeferReplaySidecar): bool =
    return BodyIRDeferReplaySidecarIsCanonicalEmpty(sidecar) ||
           ((sidecar.building || sidecar.sealed) &&
            !(sidecar.building && sidecar.sealed) &&
            BodyIRDeferReplaySidecarRowsAligned(sidecar))

fn BodyIRDeferReplaySidecarMoveInto(
        destination: var BodyIRDeferReplaySidecar,
        source: var BodyIRDeferReplaySidecar) =
    if !BodyIRDeferReplaySidecarIsCanonicalEmpty(destination) ||
       BodyIRDeferReplaySidecarHasPhysicalStorage(destination) ||
       !bodyIRDeferReplayMoveSourceValid(source):
        panic("body ir defer replay: move state invalid")
    destination = source
    source = BodyIRDeferReplaySidecarNew()
    if !BodyIRDeferReplaySidecarIsCanonicalEmpty(source) ||
       !bodyIRDeferReplayMoveSourceValid(destination):
        panic("body ir defer replay: move receipt invalid")

@borrows
fn bodyIRDeferReplayExpectedMapCount(bodyIR: BodyIR): int32 =
    var out: int32
    for unitRow in 0..<bodyIR.cleanupIntent.unitKinds.len:
        if bodyIR.cleanupIntent.unitKinds[unitRow] ==
               BodyCleanupUnitDeferTag:
            out = out + 1
    return out

@borrows
fn bodyIRDeferReplayExpectedUnitRow(
        bodyIR: BodyIR,
        mapRow: int32): int32 =
    if mapRow < 0:
        return -1
    var currentMapRow: int32
    for unitRow in 0..<bodyIR.cleanupIntent.unitKinds.len:
        if bodyIR.cleanupIntent.unitKinds[unitRow] !=
               BodyCleanupUnitDeferTag:
            continue
        if currentMapRow == mapRow:
            return unitRow
        currentMapRow = currentMapRow + 1
    return -1

@borrows
fn bodyIRDeferReplayTemplateBlockCount(
        bodyIR: BodyIR,
        deferId: int32): int32 =
    var out: int32
    for blockId in 0..<bodyIR.blocks.len:
        if BodyIRControlFlowBlockInDeferAction(
               bodyIR, deferId, blockId):
            out = out + 1
    return out

@borrows
fn bodyIRDeferReplayTemplateBlockAt(
        bodyIR: BodyIR,
        deferId: int32,
        blockOrdinal: int32): int32 =
    if blockOrdinal < 0:
        return -1
    var currentOrdinal: int32
    for blockId in 0..<bodyIR.blocks.len:
        if !BodyIRControlFlowBlockInDeferAction(
               bodyIR, deferId, blockId):
            continue
        if currentOrdinal == blockOrdinal:
            return blockId
        currentOrdinal = currentOrdinal + 1
    return -1

@borrows
fn bodyIRDeferReplayTemplateOpCount(
        bodyIR: BodyIR,
        deferId: int32): int32 =
    var out: int32
    for blockId in 0..<bodyIR.blocks.len:
        if BodyIRControlFlowBlockInDeferAction(
               bodyIR, deferId, blockId):
            out = out + bodyIR.blocks[blockId].opCount
    return out

@borrows
fn bodyIRDeferReplayTemplateOpAt(
        bodyIR: BodyIR,
        deferId: int32,
        opOrdinal: int32): int32 =
    if opOrdinal < 0:
        return -1
    var currentOrdinal: int32
    for blockId in 0..<bodyIR.blocks.len:
        if !BodyIRControlFlowBlockInDeferAction(
               bodyIR, deferId, blockId):
            continue
        let block = bodyIR.blocks[blockId]
        for opOffset in 0..<block.opCount:
            if currentOrdinal == opOrdinal:
                return block.opStart + opOffset
            currentOrdinal = currentOrdinal + 1
    return -1

@borrows
fn bodyIRDeferReplayTemplateCallCount(
        bodyIR: BodyIR,
        deferId: int32): int32 =
    var out: int32
    let opCount = bodyIRDeferReplayTemplateOpCount(bodyIR, deferId)
    for opOrdinal in 0..<opCount:
        let opRow = bodyIRDeferReplayTemplateOpAt(
            bodyIR, deferId, opOrdinal)
        if opRow >= 0 && bodyIR.ops[opRow].kind == BodyOpCallTag:
            out = out + 1
    return out

@borrows
fn bodyIRDeferReplayTemplateCallOrdinal(
        bodyIR: BodyIR,
        deferId: int32,
        templateCallRow: int32): int32 =
    if templateCallRow < 0 ||
       templateCallRow >= bodyIR.callSequence.len:
        return -1
    var callOrdinal: int32
    var matchOrdinal: int32 = -1
    let opCount = bodyIRDeferReplayTemplateOpCount(bodyIR, deferId)
    for opOrdinal in 0..<opCount:
        let opRow = bodyIRDeferReplayTemplateOpAt(
            bodyIR, deferId, opOrdinal)
        let op = bodyIR.ops[opRow]
        if op.kind != BodyOpCallTag:
            continue
        if op.operands.len != 1 ||
           op.operands[0] < 0 ||
           op.operands[0] >= bodyIR.callSequence.len:
            return -1
        if op.operands[0] == templateCallRow:
            if matchOrdinal >= 0:
                return -1
            matchOrdinal = callOrdinal
        callOrdinal = callOrdinal + 1
    return matchOrdinal

@borrows
fn bodyIRDeferReplayMappedPhysicalOpRow(
        bodyIR: BodyIR,
        mapRow: int32,
        templateOpRow: int32): int32 =
    if mapRow < 0 ||
       mapRow >= bodyIR.deferReplay.templateOpMapStarts.len:
        return -1
    let unitRow = bodyIRDeferReplayExpectedUnitRow(bodyIR, mapRow)
    if unitRow < 0:
        return -1
    let mapStart = bodyIR.deferReplay.templateOpMapStarts[mapRow]
    let mapCount = bodyIR.deferReplay.templateOpMapCounts[mapRow]
    for offset in 0..<mapCount:
        if bodyIR.deferReplay.templateOpRows[mapStart + offset] ==
               templateOpRow:
            return bodyIR.cleanupSchedule.opStarts[unitRow] + offset
    return templateOpRow

@borrows
fn bodyIRDeferReplayCStringEqual(
        bodyIR: BodyIR,
        leftArg: int32,
        rightArg: int32): bool =
    if !CallArgSlotIsCString(leftArg) ||
       !CallArgSlotIsCString(rightArg):
        return leftArg == rightArg
    let leftId = CallArgSlotCStringId(leftArg)
    let rightId = CallArgSlotCStringId(rightArg)
    return leftId >= 0 && leftId < bodyIR.cstringLiterals.len &&
           rightId >= 0 && rightId < bodyIR.cstringLiterals.len &&
           bodyIR.cstringLiterals[leftId].text ==
               bodyIR.cstringLiterals[rightId].text

@borrows
fn bodyIRDeferReplayCallEquivalent(
        bodyIR: BodyIR,
        mapRow: int32,
        deferId: int32,
        templateCallRow: int32,
        replayCallRow: int32): bool =
    if templateCallRow < 0 ||
       templateCallRow >= bodyIR.callSequence.len ||
       replayCallRow < 0 || replayCallRow >= bodyIR.callSequence.len:
        return false
    let templateCall = bodyIR.callSequence[templateCallRow]
    let replayCall = bodyIR.callSequence[replayCallRow]
    if bodyIR.callTargetDomainKinds[templateCallRow] !=
           bodyIR.callTargetDomainKinds[replayCallRow] ||
       bodyIR.callTargetRows[templateCallRow] !=
           bodyIR.callTargetRows[replayCallRow] ||
       !layout.FixedBytes32Equal(
           bodyIR.callTargetInterfaceCids[templateCallRow],
           bodyIR.callTargetInterfaceCids[replayCallRow]) ||
       templateCall.argSlots.len != replayCall.argSlots.len ||
       templateCall.argPassKinds.len !=
           replayCall.argPassKinds.len ||
       templateCall.argAbiSizes.len != replayCall.argAbiSizes.len ||
       templateCall.resultSlot != replayCall.resultSlot ||
       templateCall.resultPassKind != replayCall.resultPassKind ||
       templateCall.resultOwnership != replayCall.resultOwnership ||
       templateCall.resultExprNodeIndex !=
           replayCall.resultExprNodeIndex ||
       templateCall.resultValueDefinitionRow !=
           replayCall.resultValueDefinitionRow ||
       templateCall.resultBorrowOwnerValueDefinitionRow !=
           replayCall.resultBorrowOwnerValueDefinitionRow ||
       templateCall.resultBorrowOwnerDefinitionDomain !=
           replayCall.resultBorrowOwnerDefinitionDomain ||
       templateCall.resultDefinitionOriginKind !=
           replayCall.resultDefinitionOriginKind ||
       templateCall.resultDefinitionOriginId !=
           replayCall.resultDefinitionOriginId ||
       templateCall.sourceDefinitionDomain !=
           replayCall.sourceDefinitionDomain ||
       templateCall.semanticCallExprNodeIndex !=
           replayCall.semanticCallExprNodeIndex ||
       templateCall.managedStoreKind != replayCall.managedStoreKind ||
       templateCall.managedReplaceReceiptRow !=
           replayCall.managedReplaceReceiptRow ||
       templateCall.managedDropGlueDescriptorRow !=
           replayCall.managedDropGlueDescriptorRow ||
       templateCall.targetIsImportc != replayCall.targetIsImportc ||
       templateCall.inlineF64FromIntKind !=
           replayCall.inlineF64FromIntKind ||
       templateCall.wholeCallF64FromIntRescue !=
           replayCall.wholeCallF64FromIntRescue ||
       templateCall.inlineF64FromIntUnsigned !=
           replayCall.inlineF64FromIntUnsigned:
        return false
    var expectedSourceDefinitionRow =
        templateCall.sourceDefinitionRow
    if templateCall.sourceDefinitionDomain ==
           BodyDefinitionDomainBodyOpTag:
        expectedSourceDefinitionRow =
            bodyIRDeferReplayMappedPhysicalOpRow(
                bodyIR, mapRow, templateCall.sourceDefinitionRow)
    var expectedBorrowOwnerDefinitionRow =
        templateCall.resultBorrowOwnerDefinitionRow
    if templateCall.resultBorrowOwnerDefinitionDomain ==
           BodyDefinitionDomainBodyOpTag:
        expectedBorrowOwnerDefinitionRow =
            bodyIRDeferReplayMappedPhysicalOpRow(
                bodyIR,
                mapRow,
                templateCall.resultBorrowOwnerDefinitionRow)
    var expectedConsumeActionRow = templateCall.consumeActionRow
    if expectedConsumeActionRow >= 0:
        expectedConsumeActionRow =
            bodyIRDeferReplayMappedPhysicalOpRow(
                bodyIR, mapRow, expectedConsumeActionRow)
    if replayCall.sourceDefinitionRow !=
           expectedSourceDefinitionRow ||
       replayCall.resultBorrowOwnerDefinitionRow !=
           expectedBorrowOwnerDefinitionRow ||
       replayCall.consumeActionRow != expectedConsumeActionRow:
        return false
    for argumentIndex in 0..<templateCall.argSlots.len:
        if !bodyIRDeferReplayCStringEqual(
               bodyIR,
               templateCall.argSlots[argumentIndex],
               replayCall.argSlots[argumentIndex]) ||
           templateCall.argPassKinds[argumentIndex] !=
               replayCall.argPassKinds[argumentIndex]:
            return false
    for argumentIndex in 0..<templateCall.argAbiSizes.len:
        if templateCall.argAbiSizes[argumentIndex] !=
               replayCall.argAbiSizes[argumentIndex]:
            return false
    return bodyIRDeferReplayTemplateCallOrdinal(
               bodyIR, deferId, templateCallRow) >= 0

@borrows
fn bodyIRDeferReplayOpEquivalent(
        bodyIR: BodyIR,
        mapRow: int32,
        deferId: int32,
        templateOpRow: int32,
        replayOpRow: int32): bool =
    if templateOpRow < 0 || templateOpRow >= bodyIR.ops.len ||
       replayOpRow < 0 || replayOpRow >= bodyIR.ops.len:
        return false
    let templateOp = bodyIR.ops[templateOpRow]
    let replayOp = bodyIR.ops[replayOpRow]
    if templateOp.kind != replayOp.kind ||
       templateOp.operands.len != replayOp.operands.len ||
       templateOp.target != replayOp.target ||
       templateOp.valueDefSlot != replayOp.valueDefSlot ||
       templateOp.valueDefExprNodeIndex !=
           replayOp.valueDefExprNodeIndex ||
       templateOp.valueDefSemanticRow !=
           replayOp.valueDefSemanticRow ||
       templateOp.valueDefOwnership != replayOp.valueDefOwnership ||
       templateOp.valueDefBorrowOwnerSemanticRow !=
           replayOp.valueDefBorrowOwnerSemanticRow ||
       templateOp.valueDefBorrowOwnerDefinitionDomain !=
           replayOp.valueDefBorrowOwnerDefinitionDomain ||
       templateOp.valueDefOriginKind != replayOp.valueDefOriginKind ||
       templateOp.valueDefOriginId != replayOp.valueDefOriginId ||
       templateOp.sourceDefinitionDomain !=
           replayOp.sourceDefinitionDomain:
        return false
    var expectedSourceDefinitionRow =
        templateOp.sourceDefinitionRow
    if templateOp.sourceDefinitionDomain ==
           BodyDefinitionDomainBodyOpTag:
        expectedSourceDefinitionRow =
            bodyIRDeferReplayMappedPhysicalOpRow(
                bodyIR, mapRow, templateOp.sourceDefinitionRow)
    var expectedBorrowOwnerDefinitionRow =
        templateOp.valueDefBorrowOwnerDefinitionRow
    if templateOp.valueDefBorrowOwnerDefinitionDomain ==
           BodyDefinitionDomainBodyOpTag:
        expectedBorrowOwnerDefinitionRow =
            bodyIRDeferReplayMappedPhysicalOpRow(
                bodyIR,
                mapRow,
                templateOp.valueDefBorrowOwnerDefinitionRow)
    var expectedConsumeActionRow = templateOp.consumeActionRow
    if expectedConsumeActionRow >= 0:
        expectedConsumeActionRow =
            bodyIRDeferReplayMappedPhysicalOpRow(
                bodyIR, mapRow, expectedConsumeActionRow)
    var expectedConsumePlusOne =
        templateOp.valueDefConsumeOpIndexPlusOne
    if expectedConsumePlusOne > 0:
        expectedConsumePlusOne =
            bodyIRDeferReplayMappedPhysicalOpRow(
                bodyIR, mapRow, expectedConsumePlusOne - 1) + 1
    if replayOp.sourceDefinitionRow != expectedSourceDefinitionRow ||
       replayOp.valueDefBorrowOwnerDefinitionRow !=
           expectedBorrowOwnerDefinitionRow ||
       replayOp.consumeActionRow != expectedConsumeActionRow ||
       replayOp.valueDefConsumeOpIndexPlusOne !=
           expectedConsumePlusOne:
        return false
    for operandIndex in 0..<templateOp.operands.len:
        let templateOperand = templateOp.operands[operandIndex]
        let replayOperand = replayOp.operands[operandIndex]
        if templateOp.kind == BodyOpCallTag && operandIndex == 0:
            let callOrdinal =
                bodyIRDeferReplayTemplateCallOrdinal(
                    bodyIR, deferId, templateOperand)
            let unitRow =
                bodyIRDeferReplayExpectedUnitRow(bodyIR, mapRow)
            if callOrdinal < 0 || unitRow < 0 ||
               replayOperand !=
                   bodyIR.cleanupSchedule.callStarts[unitRow] +
                       callOrdinal ||
               !bodyIRDeferReplayCallEquivalent(
                   bodyIR,
                   mapRow,
                   deferId,
                   templateOperand,
                   replayOperand):
                return false
        elif templateOp.kind == BodyOpResultPanicGuardTag &&
             operandIndex == 1:
            let callOrdinal =
                bodyIRDeferReplayTemplateCallOrdinal(
                    bodyIR, deferId, templateOperand)
            let unitRow =
                bodyIRDeferReplayExpectedUnitRow(bodyIR, mapRow)
            if callOrdinal < 0 || unitRow < 0 ||
               replayOperand !=
                   bodyIR.cleanupSchedule.callStarts[unitRow] +
                       callOrdinal ||
               !bodyIRDeferReplayCallEquivalent(
                   bodyIR,
                   mapRow,
                   deferId,
                   templateOperand,
                   replayOperand):
                return false
        elif templateOp.kind == BodyOpStrEqLiteralTag &&
             operandIndex == 1:
            if templateOperand < 0 || replayOperand < 0 ||
               templateOperand >= bodyIR.cstringLiterals.len ||
               replayOperand >= bodyIR.cstringLiterals.len ||
               bodyIR.cstringLiterals[templateOperand].text !=
                   bodyIR.cstringLiterals[replayOperand].text:
                return false
        elif templateOperand != replayOperand:
            return false
    return true

@borrows
fn bodyIRDeferReplayMappedTemplateBlock(
        bodyIR: BodyIR,
        deferId: int32,
        unitRow: int32,
        templateBlockId: int32): int32 =
    let blockOrdinal = bodyIRControlActionBlockOrdinal(
        bodyIR, bodyIR.deferSuiteScopeIds[deferId], templateBlockId)
    if blockOrdinal < 0:
        return -1
    return bodyIR.cleanupSchedule.blockStarts[unitRow] +
           1 + blockOrdinal

@borrows
fn bodyIRDeferReplayTemplateEntryOrdinal(
        bodyIR: BodyIR,
        deferId: int32): int32 =
    let blockCount =
        bodyIRDeferReplayTemplateBlockCount(bodyIR, deferId)
    if blockCount <= 0:
        return -1
    # Defer fragments are canonically numbered from their exact entry block;
    # a loop back to ordinal zero must not make the entry ambiguous.
    return 0

@borrows
fn bodyIRDeferReplayTermEquivalent(
        bodyIR: BodyIR,
        mapRow: int32,
        deferId: int32,
        unitRow: int32,
        templateTermRow: int32,
        replayTermRow: int32,
        clearBlockId: int32): bool =
    if templateTermRow < 0 || templateTermRow >= bodyIR.terms.len ||
       replayTermRow < 0 || replayTermRow >= bodyIR.terms.len:
        return false
    let templateTerm = bodyIR.terms[templateTermRow]
    let replayTerm = bodyIR.terms[replayTermRow]
    if templateTerm.kind == BodyTermReturnTag:
        return replayTerm.kind == BodyTermBrTag &&
               replayTerm.trueBlock == clearBlockId &&
               replayTerm.falseBlock == -1 &&
               replayTerm.operands.len == 0 &&
               bodyIR.termSuccessorCounts[replayTermRow] == 1
    if templateTerm.kind != replayTerm.kind ||
       templateTerm.conditionKind != replayTerm.conditionKind ||
       templateTerm.resultSlot != replayTerm.resultSlot ||
       templateTerm.sourceDefinitionDomain !=
           replayTerm.sourceDefinitionDomain ||
       templateTerm.lhsSlot != replayTerm.lhsSlot ||
       templateTerm.rhsSlot != replayTerm.rhsSlot ||
       templateTerm.operands.len != replayTerm.operands.len:
        return false
    var expectedSourceDefinitionRow =
        templateTerm.sourceDefinitionRow
    if templateTerm.sourceDefinitionDomain ==
           BodyDefinitionDomainBodyOpTag:
        expectedSourceDefinitionRow =
            bodyIRDeferReplayMappedPhysicalOpRow(
                bodyIR, mapRow, templateTerm.sourceDefinitionRow)
    var expectedTrueBlock = templateTerm.trueBlock
    var expectedFalseBlock = templateTerm.falseBlock
    if expectedTrueBlock >= 0:
        expectedTrueBlock = bodyIRDeferReplayMappedTemplateBlock(
            bodyIR, deferId, unitRow, expectedTrueBlock)
    if expectedFalseBlock >= 0:
        expectedFalseBlock = bodyIRDeferReplayMappedTemplateBlock(
            bodyIR, deferId, unitRow, expectedFalseBlock)
    if replayTerm.sourceDefinitionRow !=
           expectedSourceDefinitionRow ||
       replayTerm.trueBlock != expectedTrueBlock ||
       replayTerm.falseBlock != expectedFalseBlock:
        return false
    for operandIndex in 0..<templateTerm.operands.len:
        if templateTerm.operands[operandIndex] !=
               replayTerm.operands[operandIndex]:
            return false
    return bodyIR.termSuccessorCounts[templateTermRow] ==
           bodyIR.termSuccessorCounts[replayTermRow]

@borrows
fn bodyIRDeferReplayMapRowValid(
        bodyIR: BodyIR,
        mapRow: int32): bool =
    let unitRow = bodyIRDeferReplayExpectedUnitRow(bodyIR, mapRow)
    if unitRow < 0 ||
       bodyIR.cleanupIntent.unitSemanticCounts[unitRow] != 1:
        return false
    let deferId =
        bodyIR.cleanupIntent.unitSemanticStarts[unitRow]
    if deferId < 0 || deferId >= bodyIR.deferSuiteScopeIds.len:
        return false
    let mapStart = bodyIR.deferReplay.templateOpMapStarts[mapRow]
    let mapCount = bodyIR.deferReplay.templateOpMapCounts[mapRow]
    let templateOpCount =
        bodyIRDeferReplayTemplateOpCount(bodyIR, deferId)
    let templateBlockCount =
        bodyIRDeferReplayTemplateBlockCount(bodyIR, deferId)
    let templateCallCount =
        bodyIRDeferReplayTemplateCallCount(bodyIR, deferId)
    let clearCount =
        bodyIR.cleanupIntent.unitClearCounts[unitRow]
    if mapStart < 0 || mapCount < 0 ||
       mapStart > bodyIR.deferReplay.templateOpRows.len - mapCount ||
       mapCount != templateOpCount || templateBlockCount <= 0 ||
       clearCount < 0 || clearCount > 1 ||
       bodyIR.cleanupSchedule.opCounts[unitRow] !=
           templateOpCount + clearCount ||
       bodyIR.cleanupSchedule.callCounts[unitRow] !=
           templateCallCount ||
       bodyIR.cleanupSchedule.blockCounts[unitRow] !=
           templateBlockCount + 2 ||
       bodyIR.cleanupSchedule.termCounts[unitRow] !=
           templateBlockCount + 2:
        return false
    let replayOpStart = bodyIR.cleanupSchedule.opStarts[unitRow]
    for offset in 0..<mapCount:
        let templateOpRow = bodyIRDeferReplayTemplateOpAt(
            bodyIR, deferId, offset)
        if templateOpRow < 0 ||
           bodyIR.deferReplay.templateOpRows[mapStart + offset] !=
               templateOpRow ||
           !bodyIRDeferReplayOpEquivalent(
               bodyIR,
               mapRow,
               deferId,
               templateOpRow,
               replayOpStart + offset):
            return false
    let replayBlockStart =
        bodyIR.cleanupSchedule.blockStarts[unitRow]
    let replayTermStart = bodyIR.cleanupSchedule.termStarts[unitRow]
    let clearBlockId = replayBlockStart + templateBlockCount + 1
    let conditionBlock = bodyIR.blocks[replayBlockStart]
    let conditionTerm = bodyIR.terms[conditionBlock.termIndex]
    let entryOrdinal =
        bodyIRDeferReplayTemplateEntryOrdinal(bodyIR, deferId)
    if conditionBlock.opCount != 0 ||
       conditionBlock.termIndex != replayTermStart ||
       conditionTerm.kind != BodyTermCbrTag ||
       conditionTerm.trueBlock !=
           replayBlockStart + 1 + entryOrdinal ||
       entryOrdinal < 0:
        return false
    var opCursor: int32
    for blockOrdinal in 0..<templateBlockCount:
        let templateBlockId = bodyIRDeferReplayTemplateBlockAt(
            bodyIR, deferId, blockOrdinal)
        let templateBlock = bodyIR.blocks[templateBlockId]
        let replayBlock =
            bodyIR.blocks[replayBlockStart + 1 + blockOrdinal]
        if replayBlock.opStart != replayOpStart + opCursor ||
           replayBlock.opCount != templateBlock.opCount ||
           replayBlock.termIndex != replayTermStart + 1 +
               blockOrdinal ||
           bodyIR.blockScopeIds[
               replayBlockStart + 1 + blockOrdinal] !=
               bodyIR.deferDeclarationScopeIds[deferId] ||
           !bodyIRDeferReplayTermEquivalent(
               bodyIR,
               mapRow,
               deferId,
               unitRow,
               templateBlock.termIndex,
               replayBlock.termIndex,
               clearBlockId):
            return false
        opCursor = opCursor + templateBlock.opCount
    let clearBlock = bodyIR.blocks[clearBlockId]
    let clearTerm = bodyIR.terms[clearBlock.termIndex]
    return opCursor == templateOpCount &&
           clearBlock.opStart == replayOpStart + templateOpCount &&
           clearBlock.opCount == clearCount &&
           clearBlock.termIndex == replayTermStart +
               templateBlockCount + 1 &&
           clearTerm.kind == BodyTermBrTag &&
           clearTerm.falseBlock == -1

@borrows
fn bodyIRDeferReplayRowsValid(bodyIR: BodyIR): bool =
    let expectedMapCount =
        bodyIRDeferReplayExpectedMapCount(bodyIR)
    if expectedMapCount <= 0 ||
       !BodyIRCleanupScheduleSidecarShapeValid(bodyIR) ||
       !BodyIRDeferReplaySidecarRowsAligned(bodyIR.deferReplay) ||
       bodyIR.deferReplay.templateOpMapStarts.len !=
           expectedMapCount:
        return false
    var mapCursor: int32
    for mapRow in 0..<expectedMapCount:
        if bodyIR.deferReplay.templateOpMapStarts[mapRow] !=
               mapCursor ||
           !bodyIRDeferReplayMapRowValid(bodyIR, mapRow):
            return false
        mapCursor = mapCursor +
            bodyIR.deferReplay.templateOpMapCounts[mapRow]
    return mapCursor == bodyIR.deferReplay.templateOpRows.len

fn BodyIRDeferReplayBegin(bodyIR: var BodyIR) =
    if !BodyIRCleanupScheduleSidecarShapeValid(bodyIR) ||
       bodyIRDeferReplayExpectedMapCount(bodyIR) <= 0 ||
       !BodyIRDeferReplaySidecarIsCanonicalEmpty(
           bodyIR.deferReplay):
        panic("body ir defer replay: begin state invalid")
    bodyIR.deferReplay.building = true

fn BodyIRDeferReplayAppendMap(
        bodyIR: var BodyIR,
        unitRow: int32): int32 =
    let mapRow = bodyIR.deferReplay.templateOpMapStarts.len
    let expectedUnitRow =
        bodyIRDeferReplayExpectedUnitRow(bodyIR, mapRow)
    if !bodyIR.deferReplay.building || bodyIR.deferReplay.sealed ||
       unitRow != expectedUnitRow || unitRow < 0:
        panic("body ir defer replay: map append order invalid")
    let deferId =
        bodyIR.cleanupIntent.unitSemanticStarts[unitRow]
    let templateOpCount =
        bodyIRDeferReplayTemplateOpCount(bodyIR, deferId)
    if templateOpCount < 0:
        panic("body ir defer replay: template op count invalid")
    add(bodyIR.deferReplay.templateOpMapStarts,
        bodyIR.deferReplay.templateOpRows.len)
    add(bodyIR.deferReplay.templateOpMapCounts, templateOpCount)
    for opOrdinal in 0..<templateOpCount:
        let templateOpRow = bodyIRDeferReplayTemplateOpAt(
            bodyIR, deferId, opOrdinal)
        if templateOpRow < 0:
            panic("body ir defer replay: template op missing")
        add(bodyIR.deferReplay.templateOpRows, templateOpRow)
    if !bodyIRDeferReplayMapRowValid(bodyIR, mapRow):
        panic("body ir defer replay: normalized map mismatch")
    return mapRow

@borrows
fn bodyIRDeferReplayRootCidExact(
        bodyIR: BodyIR): layout.FixedBytes32 =
    if !bodyIRDeferReplayRowsValid(bodyIR):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(256)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.defer_replay")
    layout.ByteBufAppendFixed32(buf, bodyIR.cleanupIntent.rootCid)
    layout.ByteBufAppendFixed32(buf, bodyIR.cleanupSchedule.rootCid)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.deferReplay.templateOpMapStarts)
    bodyIRCleanupAppendI32Rows(
        buf, bodyIR.deferReplay.templateOpMapCounts)
    bodyIRCleanupAppendI32Rows(buf, bodyIR.deferReplay.templateOpRows)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRDeferReplayCandidateRootCid(
        bodyIR: BodyIR): layout.FixedBytes32 =
    return bodyIRDeferReplayRootCidExact(bodyIR)

fn BodyIRDeferReplayBindRootCid(
        bodyIR: var BodyIR,
        rootCid: layout.FixedBytes32) =
    if !bodyIR.deferReplay.building ||
       bodyIR.deferReplay.sealed ||
       BodyIRTypeArenaArtifactCidValid(bodyIR.deferReplay.rootCid) ||
       !BodyIRTypeArenaArtifactCidValid(rootCid) ||
       !bodyIRDeferReplayRowsValid(bodyIR):
        panic("body ir defer replay: root bind invalid")
    let candidate = BodyIRDeferReplayCandidateRootCid(bodyIR)
    if !layout.FixedBytes32Equal(candidate, rootCid):
        panic("body ir defer replay: root mismatch")
    bodyIR.deferReplay.rootCid = layout.FixedBytes32Copy(rootCid)

@borrows
fn BodyIRDeferReplaySidecarShapeValid(bodyIR: BodyIR): bool =
    if BodyIRDeferReplaySidecarIsCanonicalEmpty(bodyIR.deferReplay):
        return bodyIRDeferReplayExpectedMapCount(bodyIR) == 0
    return !bodyIR.deferReplay.building &&
           bodyIR.deferReplay.sealed &&
           BodyIRTypeArenaArtifactCidValid(
               bodyIR.deferReplay.rootCid) &&
           bodyIRDeferReplayRowsValid(bodyIR) &&
           layout.FixedBytes32Equal(
               bodyIR.deferReplay.rootCid,
               BodyIRDeferReplayCandidateRootCid(bodyIR))

fn BodyIRDeferReplaySeal(
        bodyIR: var BodyIR,
        expectedRootCid: layout.FixedBytes32) =
    if !bodyIR.deferReplay.building ||
       bodyIR.deferReplay.sealed ||
       !BodyIRTypeArenaArtifactCidValid(expectedRootCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.deferReplay.rootCid) ||
       !layout.FixedBytes32Equal(
           bodyIR.deferReplay.rootCid, expectedRootCid) ||
       !bodyIRDeferReplayRowsValid(bodyIR) ||
       !layout.FixedBytes32Equal(
           BodyIRDeferReplayCandidateRootCid(bodyIR),
           expectedRootCid):
        panic("body ir defer replay: seal admission failed")
    bodyIR.deferReplay.building = false
    bodyIR.deferReplay.sealed = true
    if !BodyIRDeferReplaySidecarShapeValid(bodyIR):
        panic("body ir defer replay: sealed shape invalid")

@borrows
fn BodyIRCleanupFinalControlCid(
        bodyIR: BodyIR): layout.FixedBytes32 =
    let controlCid = BodyIRCleanupSourceControlCid(bodyIR)
    if !BodyIRTypeArenaArtifactCidValid(controlCid):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(64)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_final_control")
    layout.ByteBufAppendFixed32(buf, controlCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRCleanupAuthorityCandidateRootCid(
        bodyIR: BodyIR): layout.FixedBytes32 =
    if BodyIRCleanupIntentSidecarIsCanonicalEmpty(
           bodyIR.cleanupIntent) ||
       BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
           bodyIR.cleanupSchedule) ||
       !BodyIRCleanupIntentSidecarShapeValid(bodyIR) ||
       !BodyIRCleanupScheduleSidecarShapeValid(bodyIR) ||
       !BodyIRDeferReplaySidecarShapeValid(bodyIR) ||
       !layout.FixedBytes32Equal(
           bodyIR.cleanupSchedule.finalControlCid,
           BodyIRCleanupFinalControlCid(bodyIR)):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(256)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.cleanup_authority")
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupIntent.sourceControlCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupIntent.ownershipIrCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupIntent.ownershipAnalysisCid)
    layout.ByteBufAppendFixed32(buf, bodyIR.cleanupIntent.rootCid)
    layout.ByteBufAppendFixed32(buf, bodyIR.cleanupSchedule.rootCid)
    layout.ByteBufAppendFixed32(buf, bodyIR.deferReplay.rootCid)
    layout.ByteBufAppendFixed32(
        buf, bodyIR.cleanupSchedule.finalControlCid)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRCleanupAuthorityAdmissionValid(
        bodyIR: BodyIR,
        expectedRootCid: layout.FixedBytes32): bool =
    if !BodyIRTypeArenaArtifactCidValid(expectedRootCid):
        return false
    let candidate = BodyIRCleanupAuthorityCandidateRootCid(bodyIR)
    return BodyIRTypeArenaArtifactCidValid(candidate) &&
           layout.FixedBytes32Equal(candidate, expectedRootCid)

@borrows
fn BodyIRCleanupProofShapeValid(bodyIR: BodyIR): bool =
    let intentEmpty =
        BodyIRCleanupIntentSidecarIsCanonicalEmpty(
            bodyIR.cleanupIntent)
    let scheduleEmpty =
        BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
            bodyIR.cleanupSchedule)
    let replayEmpty =
        BodyIRDeferReplaySidecarIsCanonicalEmpty(
            bodyIR.deferReplay)
    if intentEmpty && scheduleEmpty && replayEmpty:
        return true
    if intentEmpty || scheduleEmpty:
        return false
    return BodyIRCleanupIntentSidecarShapeValid(bodyIR) &&
           BodyIRCleanupScheduleSidecarShapeValid(bodyIR) &&
           BodyIRDeferReplaySidecarShapeValid(bodyIR)

fn BodyIRDebugSyntheticKindValid(kind: int32): bool =
    return kind >= BodyDebugSyntheticCleanup &&
           kind <= BodyDebugSyntheticRuntime

fn BodyIRDebugProvenanceBegin(bodyIR: var BodyIR,
                              functionId: int32): bool =
    bodyIR.debugProvenanceRequired = true
    bodyIR.debugProvenanceComplete = functionId >= 0 &&
                                     bodyIR.ops.len == 0 &&
                                     bodyIR.terms.len == 0
    bodyIR.debugFunctionId = functionId
    bodyIR.debugOpIdsByOpIndex = []
    bodyIR.debugSyntheticKindsByOpIndex = []
    bodyIR.debugOpIdsByTermIndex = []
    bodyIR.debugSyntheticKindsByTermIndex = []
    bodyIR.debugCurrentOpId = -1
    bodyIR.debugCurrentSyntheticKind = BodyDebugSyntheticAbi
    return bodyIR.debugProvenanceComplete

fn BodyIRDebugProvenanceMarkIncomplete(bodyIR: var BodyIR) =
    if bodyIR.debugProvenanceRequired:
        bodyIR.debugProvenanceComplete = false

fn BodyIRDebugProvenanceSetExact(bodyIR: var BodyIR,
                                 debugOpId: int32): bool =
    if !bodyIR.debugProvenanceRequired || debugOpId < 0:
        BodyIRDebugProvenanceMarkIncomplete(bodyIR)
        return false
    bodyIR.debugCurrentOpId = debugOpId
    bodyIR.debugCurrentSyntheticKind = BodyDebugSyntheticNone
    return true

fn BodyIRDebugProvenanceSetSynthetic(bodyIR: var BodyIR,
                                     syntheticKind: int32): bool =
    if !bodyIR.debugProvenanceRequired ||
       !BodyIRDebugSyntheticKindValid(syntheticKind):
        BodyIRDebugProvenanceMarkIncomplete(bodyIR)
        return false
    bodyIR.debugCurrentOpId = -1
    bodyIR.debugCurrentSyntheticKind = syntheticKind
    return true

@borrows
fn BodyIRDebugProvenanceShapeValid(bodyIR: BodyIR): bool =
    if !bodyIR.debugProvenanceRequired:
        return !bodyIR.debugProvenanceComplete &&
               bodyIR.debugOpIdsByOpIndex.len == 0 &&
               bodyIR.debugSyntheticKindsByOpIndex.len == 0 &&
               bodyIR.debugOpIdsByTermIndex.len == 0 &&
               bodyIR.debugSyntheticKindsByTermIndex.len == 0
    if !bodyIR.debugProvenanceComplete || bodyIR.debugFunctionId < 0 ||
       bodyIR.debugOpIdsByOpIndex.len != bodyIR.ops.len ||
       bodyIR.debugSyntheticKindsByOpIndex.len != bodyIR.ops.len ||
       bodyIR.debugOpIdsByTermIndex.len != bodyIR.terms.len ||
       bodyIR.debugSyntheticKindsByTermIndex.len != bodyIR.terms.len:
        return false
    for index in 0..<bodyIR.ops.len:
        let debugOpId = bodyIR.debugOpIdsByOpIndex[index]
        let syntheticKind = bodyIR.debugSyntheticKindsByOpIndex[index]
        if (debugOpId >= 0 && syntheticKind != BodyDebugSyntheticNone) ||
           (debugOpId < 0 &&
            !BodyIRDebugSyntheticKindValid(syntheticKind)):
            return false
    for index in 0..<bodyIR.terms.len:
        let debugOpId = bodyIR.debugOpIdsByTermIndex[index]
        let syntheticKind = bodyIR.debugSyntheticKindsByTermIndex[index]
        if (debugOpId >= 0 && syntheticKind != BodyDebugSyntheticNone) ||
           (debugOpId < 0 &&
            !BodyIRDebugSyntheticKindValid(syntheticKind)):
            return false
    return true

@borrows
fn BodyIRDebugOpProvenanceAt(bodyIR: BodyIR,
                             opIndex: int32,
                             debugOpIdOut: var int32,
                             syntheticKindOut: var int32): bool =
    if !BodyIRDebugProvenanceShapeValid(bodyIR) || opIndex < 0 ||
       opIndex >= bodyIR.ops.len:
        return false
    debugOpIdOut = bodyIR.debugOpIdsByOpIndex[opIndex]
    syntheticKindOut = bodyIR.debugSyntheticKindsByOpIndex[opIndex]
    return true

@borrows
fn BodyIRDebugTermProvenanceAt(bodyIR: BodyIR,
                               termIndex: int32,
                               debugOpIdOut: var int32,
                               syntheticKindOut: var int32): bool =
    if !BodyIRDebugProvenanceShapeValid(bodyIR) || termIndex < 0 ||
       termIndex >= bodyIR.terms.len:
        return false
    debugOpIdOut = bodyIR.debugOpIdsByTermIndex[termIndex]
    syntheticKindOut = bodyIR.debugSyntheticKindsByTermIndex[termIndex]
    return true

fn BodyIRAppendOp(bodyIR: var BodyIR, op: BodyOp): int32 =
    if bodyIR.controlFlowSealed:
        panic("body ir: sealed control flow rejects op append")
    let opIndex = bodyIR.ops.len
    add(bodyIR.ops, op)
    if bodyIR.debugProvenanceRequired:
        add(bodyIR.debugOpIdsByOpIndex, bodyIR.debugCurrentOpId)
        add(bodyIR.debugSyntheticKindsByOpIndex,
            bodyIR.debugCurrentSyntheticKind)
        if (bodyIR.debugCurrentOpId >= 0 &&
            bodyIR.debugCurrentSyntheticKind != BodyDebugSyntheticNone) ||
           (bodyIR.debugCurrentOpId < 0 &&
            !BodyIRDebugSyntheticKindValid(
                bodyIR.debugCurrentSyntheticKind)):
            bodyIR.debugProvenanceComplete = false
    BodyIRClearFrameLayoutCache(bodyIR)
    return opIndex

fn BodyIRClearFrameLayoutCache(bodyIR: var BodyIR) =
    bodyIR.frameMetricsReady = false
    bodyIR.frameStackByteCount = 0
    bodyIR.frameParamSaveCount = 0
    bodyIR.frameParamSaveOffset = 0
    bodyIR.frameReturnBufferSaveOffset = 0
    bodyIR.frameBytes = 0
    bodyIR.framePrologueWordCount = 0
    bodyIR.frameRestoreWordCount = 0
    bodyIR.layoutLhsElide = []
    bodyIR.layoutStoreElide = []
    bodyIR.layoutCopySrcElide = []
    bodyIR.layoutCmpFuse = []
    bodyIR.layoutCbrFuse = []
    bodyIR.x64StackLayoutReady = false
    bodyIR.x64SlotReadCnt = []
    bodyIR.x64BlockStartReady = false
    bodyIR.x64BlockByteStart = []

@borrows
fn BodyIRAppendCStringLiteral(bodyIR: var BodyIR,
                               text: str,
                               dataLabel: str): int32 =
    if dataLabel == "":
        for i in 0..<bodyIR.cstringLiterals.len:
            let existing = bodyIR.cstringLiterals[i]
            if existing.dataLabel == "" && existing.text == text:
                return existing.id
    let entryId = bodyIR.cstringLiterals.len
    var entry: CStringLiteralEntry
    entry.id = entryId
    entry.text = strings.CloneStr(text)
    entry.dataLabel = strings.CloneStr(dataLabel)
    BodyIRClearFrameLayoutCache(bodyIR)
    add(bodyIR.cstringLiterals, entry)
    return entryId

fn BodyIRAppendBlock(bodyIR: var BodyIR,
                     opStart: int32,
                     opCount: int32,
                     termIndex: int32): int32 =
    if bodyIR.controlFlowSealed:
        panic("body ir: sealed control flow rejects block append")
    let blockId = bodyIR.blocks.len
    var block: BodyBlock
    block.id = blockId
    block.opStart = opStart
    block.opCount = opCount
    block.termIndex = termIndex
    BodyIRClearFrameLayoutCache(bodyIR)
    add(bodyIR.blocks, block)
    return blockId

fn BodyIRAppendTerm(bodyIR: var BodyIR, term: BodyTerm): int32 =
    if bodyIR.controlFlowSealed:
        panic("body ir: sealed control flow rejects term append")
    let termIndex = bodyIR.terms.len
    BodyIRClearFrameLayoutCache(bodyIR)
    add(bodyIR.terms, term)
    if bodyIR.debugProvenanceRequired:
        add(bodyIR.debugOpIdsByTermIndex, bodyIR.debugCurrentOpId)
        add(bodyIR.debugSyntheticKindsByTermIndex,
            bodyIR.debugCurrentSyntheticKind)
        if (bodyIR.debugCurrentOpId >= 0 &&
            bodyIR.debugCurrentSyntheticKind != BodyDebugSyntheticNone) ||
           (bodyIR.debugCurrentOpId < 0 &&
            !BodyIRDebugSyntheticKindValid(
                bodyIR.debugCurrentSyntheticKind)):
            bodyIR.debugProvenanceComplete = false
    return termIndex

fn BodyIRLocalTypePlainNoAliasProof(typeKind: int32): bool =
    if typeKind == LocalI32Tag:
        return true
    if typeKind == LocalI64Tag:
        return true
    if typeKind == LocalF64Tag:
        return true
    return false

fn BodyIRApplyBodyOpDefaultProof(op: var BodyOp) =
    # Cross-module constructors must state every invalid identity sentinel.
    # Call immediately after `var op: BodyOp`, before binding a real value-def.
    op.target = -1
    op.valueDefSlot = -1
    op.valueDefExprNodeIndex = -1
    op.valueDefSemanticRow = -1
    op.valueDefOwnership = OwnInvalid
    op.valueDefBorrowOwnerSemanticRow = -1
    op.valueDefBorrowOwnerDefinitionDomain =
        BodyDefinitionDomainInvalidTag
    op.valueDefBorrowOwnerDefinitionRow = -1
    op.valueDefConsumeOpIndexPlusOne = 0
    op.valueDefOriginKind = BodyDefinitionOriginUnknownTag
    op.valueDefOriginId = -1
    op.sourceDefinitionDomain = BodyDefinitionDomainInvalidTag
    op.sourceDefinitionRow = -1
    op.consumeActionRow = -1

fn BodyIRApplyCallOpDefaultProof(call: var CallOp) =
    # `= -1` field initializers are not a cross-module ABI. Producers use this
    # initializer, then overwrite the exact result-definition authority.
    call.resultSlot = -1
    call.resultPassKind = BodyCallPassStackValueTag
    call.resultOwnership = OwnInvalid
    call.resultExprNodeIndex = -1
    call.resultValueDefinitionRow = -1
    call.resultBorrowOwnerValueDefinitionRow = -1
    call.resultBorrowOwnerDefinitionDomain =
        BodyDefinitionDomainInvalidTag
    call.resultBorrowOwnerDefinitionRow = -1
    call.resultDefinitionOriginKind =
        BodyDefinitionOriginUnknownTag
    call.resultDefinitionOriginId = -1
    call.sourceDefinitionDomain = BodyDefinitionDomainInvalidTag
    call.sourceDefinitionRow = -1
    call.semanticCallExprNodeIndex = -1
    call.consumeActionRow = -1
    call.managedStoreKind = ManagedStoreNoneTag
    call.managedReplaceReceiptRow = -1
    call.managedDropGlueDescriptorRow = -1
    call.relocWordOffset = -1

fn BodyIRApplyBodyTermDefaultProof(term: var BodyTerm) =
    term.resultSlot = -1
    term.sourceDefinitionDomain = BodyDefinitionDomainInvalidTag
    term.sourceDefinitionRow = -1
    term.lhsSlot = -1
    term.rhsSlot = -1
    term.trueBlock = -1
    term.falseBlock = -1

fn BodyIRApplyLocalSlotDefaultProof(slot: var LocalSlot) =
    slot.typeArenaTypeId = -1
    slot.managedStorageKind = BodyManagedStorageUnknownTag
    slot.placeKind = BodyPlaceStackValueTag
    slot.auxValue = 0
    slot.ownership = OwnPlain
    slot.aliasClass = AliasUnknown
    slot.escapeKind = EscapeNone
    slot.noAlias = false
    if BodyIRLocalTypePlainNoAliasProof(slot.typeKind):
        slot.aliasClass = AliasNoAlias
        slot.noAlias = true

fn BodyIRBindLocalSlotTypeArenaProof(bodyIR: var BodyIR,
                                     slotId: int32,
                                     typeArenaArtifactCid: layout.FixedBytes32,
                                     typeArenaTypeId: int32,
                                     managedStorageKind: int32): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len ||
       !BodyIRTypeArenaArtifactCidValid(typeArenaArtifactCid) ||
       !layout.FixedBytes32Equal(
           bodyIR.typeArenaArtifactCid, typeArenaArtifactCid) ||
       typeArenaTypeId < 0 ||
       (managedStorageKind != BodyManagedStorageUnmanagedTag &&
        managedStorageKind != BodyManagedStorageManagedTag):
        return false
    let slot = bodyIR.localSlots[slotId]
    if slot.typeArenaTypeId >= 0 ||
       slot.managedStorageKind != BodyManagedStorageUnknownTag:
        return slot.typeArenaTypeId == typeArenaTypeId &&
               slot.managedStorageKind == managedStorageKind
    bodyIR.localSlots[slotId].typeArenaTypeId = typeArenaTypeId
    bodyIR.localSlots[slotId].managedStorageKind = managedStorageKind
    return true

@borrows
fn BodyIRTypeArenaArtifactCidValid(
        value: layout.FixedBytes32): bool =
    return !layout.FixedBytes32Equal(value, layout.FixedBytes32())

@borrows
fn BodyIRBindTypeArenaArtifactCid(bodyIR: var BodyIR,
                                  value: layout.FixedBytes32): bool =
    if !BodyIRTypeArenaArtifactCidValid(value):
        return false
    if !BodyIRTypeArenaArtifactCidValid(bodyIR.typeArenaArtifactCid):
        bodyIR.typeArenaArtifactCid = layout.FixedBytes32Copy(value)
        return true
    return layout.FixedBytes32Equal(bodyIR.typeArenaArtifactCid, value)

@borrows
fn BodyIRCanonicalTypeFactShapeValid(bodyIR: BodyIR): bool =
    let count = bodyIR.typeFactTypeIds.len
    if count != bodyIR.typeFactStructuralKinds.len ||
       count != bodyIR.typeFactScalarKinds.len ||
       count != bodyIR.typeFactChildTypeIds.len ||
       count != bodyIR.typeFactFixedLengths.len ||
       count != bodyIR.typeFactSizeBytes.len ||
       count != bodyIR.typeFactAlignBytes.len:
        return false
    var previousTypeId: int32 = -1
    for row in 0..<count:
        let typeId = bodyIR.typeFactTypeIds[row]
        if typeId <= previousTypeId ||
           bodyIR.typeFactStructuralKinds[row] <= 0 ||
           bodyIR.typeFactSizeBytes[row] < 0 ||
           bodyIR.typeFactAlignBytes[row] <= 0:
            return false
        previousTypeId = typeId
    return count == 0 ||
           BodyIRTypeArenaArtifactCidValid(
               bodyIR.typeArenaArtifactCid)

@borrows
fn BodyIRBindCanonicalTypeFact(
        bodyIR: var BodyIR,
        typeArenaArtifactCid: layout.FixedBytes32,
        typeId: int32,
        structuralKind: int32,
        scalarKind: int32,
        childTypeId: int32,
        fixedLength: int32,
        sizeBytes: int32,
        alignBytes: int32): bool =
    if !BodyIRBindTypeArenaArtifactCid(
           bodyIR, typeArenaArtifactCid) ||
       typeId < 0 || structuralKind <= 0 ||
       scalarKind < 0 || childTypeId < -1 ||
       fixedLength < 0 || sizeBytes < 0 ||
       alignBytes <= 0 ||
       !BodyIRCanonicalTypeFactShapeValid(bodyIR):
        return false
    var insertRow = bodyIR.typeFactTypeIds.len
    for row in 0..<bodyIR.typeFactTypeIds.len:
        if bodyIR.typeFactTypeIds[row] == typeId:
            return bodyIR.typeFactStructuralKinds[row] ==
                       structuralKind &&
                   bodyIR.typeFactScalarKinds[row] == scalarKind &&
                   bodyIR.typeFactChildTypeIds[row] == childTypeId &&
                   bodyIR.typeFactFixedLengths[row] == fixedLength &&
                   bodyIR.typeFactSizeBytes[row] == sizeBytes &&
                   bodyIR.typeFactAlignBytes[row] == alignBytes
        if bodyIR.typeFactTypeIds[row] > typeId:
            insertRow = row
            break
    add(bodyIR.typeFactTypeIds, typeId)
    add(bodyIR.typeFactStructuralKinds, structuralKind)
    add(bodyIR.typeFactScalarKinds, scalarKind)
    add(bodyIR.typeFactChildTypeIds, childTypeId)
    add(bodyIR.typeFactFixedLengths, fixedLength)
    add(bodyIR.typeFactSizeBytes, sizeBytes)
    add(bodyIR.typeFactAlignBytes, alignBytes)
    var row = bodyIR.typeFactTypeIds.len - 1
    while row > insertRow:
        bodyIR.typeFactTypeIds[row] =
            bodyIR.typeFactTypeIds[row - 1]
        bodyIR.typeFactStructuralKinds[row] =
            bodyIR.typeFactStructuralKinds[row - 1]
        bodyIR.typeFactScalarKinds[row] =
            bodyIR.typeFactScalarKinds[row - 1]
        bodyIR.typeFactChildTypeIds[row] =
            bodyIR.typeFactChildTypeIds[row - 1]
        bodyIR.typeFactFixedLengths[row] =
            bodyIR.typeFactFixedLengths[row - 1]
        bodyIR.typeFactSizeBytes[row] =
            bodyIR.typeFactSizeBytes[row - 1]
        bodyIR.typeFactAlignBytes[row] =
            bodyIR.typeFactAlignBytes[row - 1]
        row = row - 1
    bodyIR.typeFactTypeIds[insertRow] = typeId
    bodyIR.typeFactStructuralKinds[insertRow] = structuralKind
    bodyIR.typeFactScalarKinds[insertRow] = scalarKind
    bodyIR.typeFactChildTypeIds[insertRow] = childTypeId
    bodyIR.typeFactFixedLengths[insertRow] = fixedLength
    bodyIR.typeFactSizeBytes[insertRow] = sizeBytes
    bodyIR.typeFactAlignBytes[insertRow] = alignBytes
    return BodyIRCanonicalTypeFactShapeValid(bodyIR)

@borrows
fn BodyIRCanonicalTypeFactRow(
        bodyIR: BodyIR,
        typeId: int32): int32 =
    if !BodyIRCanonicalTypeFactShapeValid(bodyIR):
        return -1
    for row in 0..<bodyIR.typeFactTypeIds.len:
        if bodyIR.typeFactTypeIds[row] == typeId:
            return row
        if bodyIR.typeFactTypeIds[row] > typeId:
            return -1
    return -1

@borrows
fn BodyIRLocalSlotTypeArenaProofValid(slot: LocalSlot): bool =
    if slot.typeArenaTypeId == -1:
        return slot.managedStorageKind == BodyManagedStorageUnknownTag
    return slot.typeArenaTypeId >= 0 &&
           (slot.managedStorageKind == BodyManagedStorageUnmanagedTag ||
            slot.managedStorageKind == BodyManagedStorageManagedTag)

# [wall139] 无 proof unmanaged 纯标量槽 = decode 权威既有首类合法域：
# BodyIRLocalSlotTypeArenaProofValid 明文承认 typeId==-1 ∧ storage==Unknown
# （freeze schema 同域：def-less 槽 expected_storage=0，带 proof 反被
# exact-def freeze 以 partial authority 拒收——r3 实证）。cleanup intent
# 域（SnapshotSource append 的 typeId<0 panic + cleanup_cfg 快照接口
# 三联判 c2）为此域的滞后镜像，本谓词 = 两域共用的唯一精确判据，禁止
# 各自拼写漂移。纯标量限定复用 BodyIRLocalTypePlainNoAliasProof（wall135
# 同源三族），托管/聚合槽不适用——它们必须持完整 proof + 定义权威。
@borrows
fn BodyIRCleanupIntentSnapshotSourceNoProofAdmitted(slot: LocalSlot): bool =
    return slot.typeArenaTypeId < 0 &&
           slot.managedStorageKind == BodyManagedStorageUnknownTag &&
           BodyIRLocalTypePlainNoAliasProof(slot.typeKind)

@borrows
fn BodyIRTypeArenaProofDomainValid(bodyIR: BodyIR): bool =
    if !BodyIRCanonicalTypeFactShapeValid(bodyIR):
        return false
    var hasProof = false
    for index in 0..<bodyIR.localSlots.len:
        if !BodyIRLocalSlotTypeArenaProofValid(
               bodyIR.localSlots[index]):
            return false
        if bodyIR.localSlots[index].typeArenaTypeId >= 0:
            hasProof = true
    if !BodyIRTypeArenaArtifactCidValid(bodyIR.typeArenaArtifactCid):
        return !hasProof
    return true

fn BodyIRManualConsumeSidecarNew(): BodyIRManualConsumeSidecar =
    var out: BodyIRManualConsumeSidecar
    # wall69: 大结构构造器逐字段显式落定。seq 用描述符直写
    # (len=0/cap=0/buffer=nil, 纯 store 无 rc 语义)——「= []」空列赋值带
    # release 旧值语义, 对未初始化槽=release 垃圾描述符, 与栈复用残留叠加
    # 即误释放真实堆块 (cold_nested 编译期 use-after-free 实证)。
    out.sealed = false
    out.functionPresent = false
    out.functionEffectCid = layout.FixedBytes32()
    out.functionBodyProofCid = layout.FixedBytes32()
    out.callOrdinals.len = 0
    out.callOrdinals.cap = 0
    out.callOrdinals.buffer = nil
    out.snapshotCallIds.len = 0
    out.snapshotCallIds.cap = 0
    out.snapshotCallIds.buffer = nil
    out.targetArgumentOrdinals.len = 0
    out.targetArgumentOrdinals.cap = 0
    out.targetArgumentOrdinals.buffer = nil
    out.sourceArgumentOrdinals.len = 0
    out.sourceArgumentOrdinals.cap = 0
    out.sourceArgumentOrdinals.buffer = nil
    out.targetPlaceSlotIds.len = 0
    out.targetPlaceSlotIds.cap = 0
    out.targetPlaceSlotIds.buffer = nil
    out.targetOwnerSlotIds.len = 0
    out.targetOwnerSlotIds.cap = 0
    out.targetOwnerSlotIds.buffer = nil
    out.sourcePlaceSlotIds.len = 0
    out.sourcePlaceSlotIds.cap = 0
    out.sourcePlaceSlotIds.buffer = nil
    out.targetArgumentBindingCids.len = 0
    out.targetArgumentBindingCids.cap = 0
    out.targetArgumentBindingCids.buffer = nil
    out.sourceArgumentBindingCids.len = 0
    out.sourceArgumentBindingCids.cap = 0
    out.sourceArgumentBindingCids.buffer = nil
    out.targetProjectionCids.len = 0
    out.targetProjectionCids.cap = 0
    out.targetProjectionCids.buffer = nil
    out.sourceProjectionCids.len = 0
    out.sourceProjectionCids.cap = 0
    out.sourceProjectionCids.buffer = nil
    out.targetDefinitionDomains.len = 0
    out.targetDefinitionDomains.cap = 0
    out.targetDefinitionDomains.buffer = nil
    out.targetDefinitionRows.len = 0
    out.targetDefinitionRows.cap = 0
    out.targetDefinitionRows.buffer = nil
    out.sourceDefinitionDomains.len = 0
    out.sourceDefinitionDomains.cap = 0
    out.sourceDefinitionDomains.buffer = nil
    out.sourceDefinitionRows.len = 0
    out.sourceDefinitionRows.cap = 0
    out.sourceDefinitionRows.buffer = nil
    out.targetTypeArenaTypeIds.len = 0
    out.targetTypeArenaTypeIds.cap = 0
    out.targetTypeArenaTypeIds.buffer = nil
    out.sourceTypeArenaTypeIds.len = 0
    out.sourceTypeArenaTypeIds.cap = 0
    out.sourceTypeArenaTypeIds.buffer = nil
    out.postDefinitionDomains.len = 0
    out.postDefinitionDomains.cap = 0
    out.postDefinitionDomains.buffer = nil
    out.postDefinitionRows.len = 0
    out.postDefinitionRows.cap = 0
    out.postDefinitionRows.buffer = nil
    out.effectCids.len = 0
    out.effectCids.cap = 0
    out.effectCids.buffer = nil
    out.linearTokenCids.len = 0
    out.linearTokenCids.cap = 0
    out.linearTokenCids.buffer = nil
    out.bridgeCids.len = 0
    out.bridgeCids.cap = 0
    out.bridgeCids.buffer = nil
    out.rootCid = layout.FixedBytes32()
    return out
fn BodyIRManagedLvalueReplaceSidecarNew(): BodyIRManagedLvalueReplaceSidecar =
    var out: BodyIRManagedLvalueReplaceSidecar
    # wall69: 大结构构造器逐字段显式落定。seq 用描述符直写
    # (len=0/cap=0/buffer=nil, 纯 store 无 rc 语义)——「= []」空列赋值带
    # release 旧值语义, 对未初始化槽=release 垃圾描述符, 与栈复用残留叠加
    # 即误释放真实堆块 (cold_nested 编译期 use-after-free 实证)。
    out.building = false
    out.sealed = false
    out.typeArenaArtifactCid = layout.FixedBytes32()
    out.callOrdinals.len = 0
    out.callOrdinals.cap = 0
    out.callOrdinals.buffer = nil
    out.replaceOpRows.len = 0
    out.replaceOpRows.cap = 0
    out.replaceOpRows.buffer = nil
    out.targetKinds.len = 0
    out.targetKinds.cap = 0
    out.targetKinds.buffer = nil
    out.replaceModes.len = 0
    out.replaceModes.cap = 0
    out.replaceModes.buffer = nil
    out.targetLvalueNodeIndexes.len = 0
    out.targetLvalueNodeIndexes.cap = 0
    out.targetLvalueNodeIndexes.buffer = nil
    out.sourceValueNodeIndexes.len = 0
    out.sourceValueNodeIndexes.cap = 0
    out.sourceValueNodeIndexes.buffer = nil
    out.targetRootDefinitionDomains.len = 0
    out.targetRootDefinitionDomains.cap = 0
    out.targetRootDefinitionDomains.buffer = nil
    out.targetRootDefinitionRows.len = 0
    out.targetRootDefinitionRows.cap = 0
    out.targetRootDefinitionRows.buffer = nil
    out.targetAddressSlotIds.len = 0
    out.targetAddressSlotIds.cap = 0
    out.targetAddressSlotIds.buffer = nil
    out.targetAddressDefinitionRows.len = 0
    out.targetAddressDefinitionRows.cap = 0
    out.targetAddressDefinitionRows.buffer = nil
    out.targetTypeIds.len = 0
    out.targetTypeIds.cap = 0
    out.targetTypeIds.buffer = nil
    out.sourceDefinitionDomains.len = 0
    out.sourceDefinitionDomains.cap = 0
    out.sourceDefinitionDomains.buffer = nil
    out.sourceDefinitionRows.len = 0
    out.sourceDefinitionRows.cap = 0
    out.sourceDefinitionRows.buffer = nil
    out.sourceSlotIds.len = 0
    out.sourceSlotIds.cap = 0
    out.sourceSlotIds.buffer = nil
    out.sourceSemanticRows.len = 0
    out.sourceSemanticRows.cap = 0
    out.sourceSemanticRows.buffer = nil
    out.consumeActionRows.len = 0
    out.consumeActionRows.cap = 0
    out.consumeActionRows.buffer = nil
    out.runtimeSemanticCids.len = 0
    out.runtimeSemanticCids.cap = 0
    out.runtimeSemanticCids.buffer = nil
    out.pathStarts.len = 0
    out.pathStarts.cap = 0
    out.pathStarts.buffer = nil
    out.pathCounts.len = 0
    out.pathCounts.cap = 0
    out.pathCounts.buffer = nil
    out.pathKinds.len = 0
    out.pathKinds.cap = 0
    out.pathKinds.buffer = nil
    out.pathProjectionNodeIndexes.len = 0
    out.pathProjectionNodeIndexes.cap = 0
    out.pathProjectionNodeIndexes.buffer = nil
    out.pathParentTypeIds.len = 0
    out.pathParentTypeIds.cap = 0
    out.pathParentTypeIds.buffer = nil
    out.pathIdentityKinds.len = 0
    out.pathIdentityKinds.cap = 0
    out.pathIdentityKinds.buffer = nil
    out.pathIdentityRows.len = 0
    out.pathIdentityRows.cap = 0
    out.pathIdentityRows.buffer = nil
    out.pathSelectorOrdinals.len = 0
    out.pathSelectorOrdinals.cap = 0
    out.pathSelectorOrdinals.buffer = nil
    out.pathResultTypeIds.len = 0
    out.pathResultTypeIds.cap = 0
    out.pathResultTypeIds.buffer = nil
    out.pathByteOffsets.len = 0
    out.pathByteOffsets.cap = 0
    out.pathByteOffsets.buffer = nil
    out.pathByteWidths.len = 0
    out.pathByteWidths.cap = 0
    out.pathByteWidths.buffer = nil
    out.pathIndexNodeIndexes.len = 0
    out.pathIndexNodeIndexes.cap = 0
    out.pathIndexNodeIndexes.buffer = nil
    out.pathIndexDefinitionDomains.len = 0
    out.pathIndexDefinitionDomains.cap = 0
    out.pathIndexDefinitionDomains.buffer = nil
    out.pathIndexDefinitionRows.len = 0
    out.pathIndexDefinitionRows.cap = 0
    out.pathIndexDefinitionRows.buffer = nil
    out.dropGlueDescriptorRows.len = 0
    out.dropGlueDescriptorRows.cap = 0
    out.dropGlueDescriptorRows.buffer = nil
    out.descriptorRootTypeIds.len = 0
    out.descriptorRootTypeIds.cap = 0
    out.descriptorRootTypeIds.buffer = nil
    out.descriptorPayloads.len = 0
    out.descriptorPayloads.cap = 0
    out.descriptorPayloads.buffer = nil
    out.descriptorDigests.len = 0
    out.descriptorDigests.cap = 0
    out.descriptorDigests.buffer = nil
    out.rootCid = layout.FixedBytes32()
    return out
@borrows
fn bodyIRManagedLvalueReplaceRowsAligned(
        sidecar: BodyIRManagedLvalueReplaceSidecar): bool =
    let rowCount = sidecar.callOrdinals.len
    return sidecar.replaceOpRows.len == rowCount &&
           sidecar.targetKinds.len == rowCount &&
           sidecar.replaceModes.len == rowCount &&
           sidecar.targetLvalueNodeIndexes.len == rowCount &&
           sidecar.sourceValueNodeIndexes.len == rowCount &&
           sidecar.targetRootDefinitionDomains.len == rowCount &&
           sidecar.targetRootDefinitionRows.len == rowCount &&
           sidecar.targetAddressSlotIds.len == rowCount &&
           sidecar.targetAddressDefinitionRows.len == rowCount &&
           sidecar.targetTypeIds.len == rowCount &&
           sidecar.sourceDefinitionDomains.len == rowCount &&
           sidecar.sourceDefinitionRows.len == rowCount &&
           sidecar.sourceSlotIds.len == rowCount &&
           sidecar.sourceSemanticRows.len == rowCount &&
           sidecar.consumeActionRows.len == rowCount &&
           sidecar.runtimeSemanticCids.len == rowCount &&
           sidecar.pathStarts.len == rowCount &&
           sidecar.pathCounts.len == rowCount &&
           sidecar.dropGlueDescriptorRows.len == rowCount

@borrows
fn bodyIRManagedLvalueReplacePathsAligned(
        sidecar: BodyIRManagedLvalueReplaceSidecar): bool =
    let pathCount = sidecar.pathKinds.len
    return sidecar.pathProjectionNodeIndexes.len == pathCount &&
           sidecar.pathParentTypeIds.len == pathCount &&
           sidecar.pathIdentityKinds.len == pathCount &&
           sidecar.pathIdentityRows.len == pathCount &&
           sidecar.pathSelectorOrdinals.len == pathCount &&
           sidecar.pathResultTypeIds.len == pathCount &&
           sidecar.pathByteOffsets.len == pathCount &&
           sidecar.pathByteWidths.len == pathCount &&
           sidecar.pathIndexNodeIndexes.len == pathCount &&
           sidecar.pathIndexDefinitionDomains.len == pathCount &&
           sidecar.pathIndexDefinitionRows.len == pathCount

@borrows
fn bodyIRManagedLvalueReplaceDescriptorsAligned(
        sidecar: BodyIRManagedLvalueReplaceSidecar): bool =
    return sidecar.descriptorPayloads.len ==
               sidecar.descriptorRootTypeIds.len &&
           sidecar.descriptorDigests.len ==
               sidecar.descriptorRootTypeIds.len

@borrows
fn BodyIRManagedLvalueReplaceSidecarHasPhysicalStorage(
        sidecar: BodyIRManagedLvalueReplaceSidecar): bool =
    return sidecar.callOrdinals.cap > 0 ||
           sidecar.replaceOpRows.cap > 0 ||
           sidecar.targetKinds.cap > 0 ||
           sidecar.replaceModes.cap > 0 ||
           sidecar.targetLvalueNodeIndexes.cap > 0 ||
           sidecar.sourceValueNodeIndexes.cap > 0 ||
           sidecar.targetRootDefinitionDomains.cap > 0 ||
           sidecar.targetRootDefinitionRows.cap > 0 ||
           sidecar.targetAddressSlotIds.cap > 0 ||
           sidecar.targetAddressDefinitionRows.cap > 0 ||
           sidecar.targetTypeIds.cap > 0 ||
           sidecar.sourceDefinitionDomains.cap > 0 ||
           sidecar.sourceDefinitionRows.cap > 0 ||
           sidecar.sourceSlotIds.cap > 0 ||
           sidecar.sourceSemanticRows.cap > 0 ||
           sidecar.consumeActionRows.cap > 0 ||
           sidecar.runtimeSemanticCids.cap > 0 ||
           sidecar.pathStarts.cap > 0 ||
           sidecar.pathCounts.cap > 0 ||
           sidecar.pathKinds.cap > 0 ||
           sidecar.pathProjectionNodeIndexes.cap > 0 ||
           sidecar.pathParentTypeIds.cap > 0 ||
           sidecar.pathIdentityKinds.cap > 0 ||
           sidecar.pathIdentityRows.cap > 0 ||
           sidecar.pathSelectorOrdinals.cap > 0 ||
           sidecar.pathResultTypeIds.cap > 0 ||
           sidecar.pathByteOffsets.cap > 0 ||
           sidecar.pathByteWidths.cap > 0 ||
           sidecar.pathIndexNodeIndexes.cap > 0 ||
           sidecar.pathIndexDefinitionDomains.cap > 0 ||
           sidecar.pathIndexDefinitionRows.cap > 0 ||
           sidecar.dropGlueDescriptorRows.cap > 0 ||
           sidecar.descriptorRootTypeIds.cap > 0 ||
           sidecar.descriptorPayloads.cap > 0 ||
           sidecar.descriptorDigests.cap > 0

@borrows
fn BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
        sidecar: BodyIRManagedLvalueReplaceSidecar): bool =
    return !sidecar.building && !sidecar.sealed &&
           sidecar.functionRow == -1 &&
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.typeArenaArtifactCid) &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.rootCid) &&
           sidecar.callOrdinals.len == 0 &&
           sidecar.replaceOpRows.len == 0 &&
           sidecar.targetKinds.len == 0 &&
           sidecar.replaceModes.len == 0 &&
           sidecar.targetLvalueNodeIndexes.len == 0 &&
           sidecar.sourceValueNodeIndexes.len == 0 &&
           sidecar.targetRootDefinitionDomains.len == 0 &&
           sidecar.targetRootDefinitionRows.len == 0 &&
           sidecar.targetAddressSlotIds.len == 0 &&
           sidecar.targetAddressDefinitionRows.len == 0 &&
           sidecar.targetTypeIds.len == 0 &&
           sidecar.sourceDefinitionDomains.len == 0 &&
           sidecar.sourceDefinitionRows.len == 0 &&
           sidecar.sourceSlotIds.len == 0 &&
           sidecar.sourceSemanticRows.len == 0 &&
           sidecar.consumeActionRows.len == 0 &&
           sidecar.runtimeSemanticCids.len == 0 &&
           sidecar.pathStarts.len == 0 &&
           sidecar.pathCounts.len == 0 &&
           sidecar.pathKinds.len == 0 &&
           sidecar.pathProjectionNodeIndexes.len == 0 &&
           sidecar.pathParentTypeIds.len == 0 &&
           sidecar.pathIdentityKinds.len == 0 &&
           sidecar.pathIdentityRows.len == 0 &&
           sidecar.pathSelectorOrdinals.len == 0 &&
           sidecar.pathResultTypeIds.len == 0 &&
           sidecar.pathByteOffsets.len == 0 &&
           sidecar.pathByteWidths.len == 0 &&
           sidecar.pathIndexNodeIndexes.len == 0 &&
           sidecar.pathIndexDefinitionDomains.len == 0 &&
           sidecar.pathIndexDefinitionRows.len == 0 &&
           sidecar.dropGlueDescriptorRows.len == 0 &&
           sidecar.descriptorRootTypeIds.len == 0 &&
           sidecar.descriptorPayloads.len == 0 &&
           sidecar.descriptorDigests.len == 0 &&
           !BodyIRManagedLvalueReplaceSidecarHasPhysicalStorage(
               sidecar)

@borrows
fn bodyIRManagedLvalueReplaceMoveSourceValid(
        sidecar: BodyIRManagedLvalueReplaceSidecar): bool =
    return BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(sidecar) ||
           ((sidecar.building || sidecar.sealed) &&
            !(sidecar.building && sidecar.sealed) &&
            sidecar.functionRow >= 0 &&
            BodyIRTypeArenaArtifactCidValid(
                sidecar.typeArenaArtifactCid) &&
            bodyIRManagedLvalueReplaceRowsAligned(sidecar) &&
            bodyIRManagedLvalueReplacePathsAligned(sidecar) &&
            bodyIRManagedLvalueReplaceDescriptorsAligned(sidecar))

@borrows
fn BodyIRManagedLvalueReplaceSidecarClone(
        sidecar: BodyIRManagedLvalueReplaceSidecar): BodyIRManagedLvalueReplaceSidecar =
    if !bodyIRManagedLvalueReplaceMoveSourceValid(sidecar):
        panic("body ir managed replace: clone source invalid")
    var out = BodyIRManagedLvalueReplaceSidecarNew()
    out.building = sidecar.building
    out.sealed = sidecar.sealed
    out.functionRow = sidecar.functionRow
    out.typeArenaArtifactCid =
        layout.FixedBytes32Copy(sidecar.typeArenaArtifactCid)
    for row in 0..<sidecar.callOrdinals.len:
        add(out.callOrdinals, sidecar.callOrdinals[row])
        add(out.replaceOpRows, sidecar.replaceOpRows[row])
        add(out.targetKinds, sidecar.targetKinds[row])
        add(out.replaceModes, sidecar.replaceModes[row])
        add(out.targetLvalueNodeIndexes,
            sidecar.targetLvalueNodeIndexes[row])
        add(out.sourceValueNodeIndexes,
            sidecar.sourceValueNodeIndexes[row])
        add(out.targetRootDefinitionDomains,
            sidecar.targetRootDefinitionDomains[row])
        add(out.targetRootDefinitionRows,
            sidecar.targetRootDefinitionRows[row])
        add(out.targetAddressSlotIds,
            sidecar.targetAddressSlotIds[row])
        add(out.targetAddressDefinitionRows,
            sidecar.targetAddressDefinitionRows[row])
        add(out.targetTypeIds, sidecar.targetTypeIds[row])
        add(out.sourceDefinitionDomains,
            sidecar.sourceDefinitionDomains[row])
        add(out.sourceDefinitionRows,
            sidecar.sourceDefinitionRows[row])
        add(out.sourceSlotIds, sidecar.sourceSlotIds[row])
        add(out.sourceSemanticRows,
            sidecar.sourceSemanticRows[row])
        add(out.consumeActionRows, sidecar.consumeActionRows[row])
        add(out.runtimeSemanticCids,
            layout.FixedBytes32Copy(
                sidecar.runtimeSemanticCids[row]))
        add(out.pathStarts, sidecar.pathStarts[row])
        add(out.pathCounts, sidecar.pathCounts[row])
        add(out.dropGlueDescriptorRows,
            sidecar.dropGlueDescriptorRows[row])
    for row in 0..<sidecar.pathKinds.len:
        add(out.pathKinds, sidecar.pathKinds[row])
        add(out.pathProjectionNodeIndexes,
            sidecar.pathProjectionNodeIndexes[row])
        add(out.pathParentTypeIds, sidecar.pathParentTypeIds[row])
        add(out.pathIdentityKinds, sidecar.pathIdentityKinds[row])
        add(out.pathIdentityRows, sidecar.pathIdentityRows[row])
        add(out.pathSelectorOrdinals,
            sidecar.pathSelectorOrdinals[row])
        add(out.pathResultTypeIds, sidecar.pathResultTypeIds[row])
        add(out.pathByteOffsets, sidecar.pathByteOffsets[row])
        add(out.pathByteWidths, sidecar.pathByteWidths[row])
        add(out.pathIndexNodeIndexes,
            sidecar.pathIndexNodeIndexes[row])
        add(out.pathIndexDefinitionDomains,
            sidecar.pathIndexDefinitionDomains[row])
        add(out.pathIndexDefinitionRows,
            sidecar.pathIndexDefinitionRows[row])
    for row in 0..<sidecar.descriptorRootTypeIds.len:
        add(out.descriptorRootTypeIds,
            sidecar.descriptorRootTypeIds[row])
        add(out.descriptorPayloads,
            strings.CloneStr(sidecar.descriptorPayloads[row]))
        add(out.descriptorDigests,
            layout.FixedBytes32Copy(
                sidecar.descriptorDigests[row]))
    out.rootCid = layout.FixedBytes32Copy(sidecar.rootCid)
    if !bodyIRManagedLvalueReplaceMoveSourceValid(out):
        panic("body ir managed replace: clone receipt invalid")
    return out

fn BodyIRManagedLvalueReplaceSidecarMoveInto(
        destination: var BodyIRManagedLvalueReplaceSidecar,
        source: var BodyIRManagedLvalueReplaceSidecar) =
    if !BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
           destination) ||
       BodyIRManagedLvalueReplaceSidecarHasPhysicalStorage(
           destination) ||
       !bodyIRManagedLvalueReplaceMoveSourceValid(source):
        panic("body ir managed replace: move state invalid")
    destination.building = source.building
    destination.sealed = source.sealed
    destination.functionRow = source.functionRow
    destination.typeArenaArtifactCid = source.typeArenaArtifactCid
    destination.callOrdinals = source.callOrdinals
    destination.replaceOpRows = source.replaceOpRows
    destination.targetKinds = source.targetKinds
    destination.replaceModes = source.replaceModes
    destination.targetLvalueNodeIndexes =
        source.targetLvalueNodeIndexes
    destination.sourceValueNodeIndexes =
        source.sourceValueNodeIndexes
    destination.targetRootDefinitionDomains =
        source.targetRootDefinitionDomains
    destination.targetRootDefinitionRows =
        source.targetRootDefinitionRows
    destination.targetAddressSlotIds = source.targetAddressSlotIds
    destination.targetAddressDefinitionRows =
        source.targetAddressDefinitionRows
    destination.targetTypeIds = source.targetTypeIds
    destination.sourceDefinitionDomains =
        source.sourceDefinitionDomains
    destination.sourceDefinitionRows = source.sourceDefinitionRows
    destination.sourceSlotIds = source.sourceSlotIds
    destination.sourceSemanticRows = source.sourceSemanticRows
    destination.consumeActionRows = source.consumeActionRows
    destination.runtimeSemanticCids = source.runtimeSemanticCids
    destination.pathStarts = source.pathStarts
    destination.pathCounts = source.pathCounts
    destination.pathKinds = source.pathKinds
    destination.pathProjectionNodeIndexes =
        source.pathProjectionNodeIndexes
    destination.pathParentTypeIds = source.pathParentTypeIds
    destination.pathIdentityKinds = source.pathIdentityKinds
    destination.pathIdentityRows = source.pathIdentityRows
    destination.pathSelectorOrdinals = source.pathSelectorOrdinals
    destination.pathResultTypeIds = source.pathResultTypeIds
    destination.pathByteOffsets = source.pathByteOffsets
    destination.pathByteWidths = source.pathByteWidths
    destination.pathIndexNodeIndexes = source.pathIndexNodeIndexes
    destination.pathIndexDefinitionDomains =
        source.pathIndexDefinitionDomains
    destination.pathIndexDefinitionRows =
        source.pathIndexDefinitionRows
    destination.dropGlueDescriptorRows =
        source.dropGlueDescriptorRows
    destination.descriptorRootTypeIds =
        source.descriptorRootTypeIds
    destination.descriptorPayloads = source.descriptorPayloads
    destination.descriptorDigests = source.descriptorDigests
    destination.rootCid = source.rootCid
    source = BodyIRManagedLvalueReplaceSidecarNew()
    if !BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(source) ||
       !bodyIRManagedLvalueReplaceMoveSourceValid(destination):
        panic("body ir managed replace: move receipt invalid")

@borrows
fn bodyIRManagedLvalueReplaceDescriptorDigest(
        payload: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(len(payload))
    for index in 0..<len(payload):
        layout.ByteBufAppendByte(buf, Int32(payload[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn bodyIRManagedLvalueReplacePathTupleValid(
        pathKind: int32,
        projectionNodeIndex: int32,
        parentTypeId: int32,
        identityKind: int32,
        identityRow: int32,
        selectorOrdinal: int32,
        resultTypeId: int32,
        byteOffset: int32,
        byteWidth: int32,
        indexNodeIndex: int32,
        indexDefinitionDomain: int32,
        indexDefinitionRow: int32): bool =
    if projectionNodeIndex < 0 || parentTypeId < 0 ||
       identityRow < 0 || selectorOrdinal < 0 ||
       resultTypeId < 0 || byteOffset < 0 || byteWidth <= 0:
        return false
    # Path kind 1 is an exact TypeArena member row.  It never carries an
    # index value-definition.  Path kind 2 is an exact TypeArena child-edge
    # row and must carry all three coordinates of the immutable index value.
    if pathKind == 1:
        return identityKind == 2 &&
               indexNodeIndex == -1 &&
               indexDefinitionDomain ==
                   BodyDefinitionDomainInvalidTag &&
               indexDefinitionRow == -1
    if pathKind == 2:
        return identityKind == 1 &&
               indexNodeIndex >= 0 &&
               indexDefinitionDomain !=
                   BodyDefinitionDomainInvalidTag &&
               indexDefinitionRow >= 0
    return false

@borrows
fn bodyIRManagedLvalueReplaceDefinitionTargetsSlotExact(
        bodyIR: BodyIR,
        definitionDomain: int32,
        definitionRow: int32,
        slotId: int32): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return false
    if definitionDomain == BodyDefinitionDomainEntrySlotTag:
        return definitionRow == slotId
    if definitionDomain == BodyDefinitionDomainBodyOpTag:
        return definitionRow >= 0 &&
               definitionRow < bodyIR.ops.len &&
               bodyIR.ops[definitionRow].valueDefSlot == slotId
    return false

@borrows
fn bodyIRManagedLvalueReplaceDefinitionSemanticRowExact(
        bodyIR: BodyIR,
        definitionDomain: int32,
        definitionRow: int32,
        slotId: int32): int32 =
    if !bodyIRManagedLvalueReplaceDefinitionTargetsSlotExact(
           bodyIR, definitionDomain, definitionRow, slotId):
        return -1
    if definitionDomain == BodyDefinitionDomainEntrySlotTag:
        if !bodyIR.entryDefinitionOwnershipSealed ||
           definitionRow >=
               bodyIR.entryDefinitionSemanticRows.len:
            return -1
        return bodyIR.entryDefinitionSemanticRows[definitionRow]
    return bodyIR.ops[definitionRow].valueDefSemanticRow

@borrows
fn bodyIRManagedLvalueReplaceIndexedAddressExact(
        bodyIR: BodyIR,
        receiptRow: int32,
        terminalPathRow: int32): bool =
    let sidecar = bodyIR.managedLvalueReplace
    let addressDefinitionRow =
        sidecar.targetAddressDefinitionRows[receiptRow]
    let replaceOpRow = sidecar.replaceOpRows[receiptRow]
    if sidecar.targetKinds[receiptRow] != 3 ||
       addressDefinitionRow < 0 ||
       addressDefinitionRow >= replaceOpRow ||
       addressDefinitionRow >= bodyIR.ops.len:
        return false
    let addressOp = bodyIR.ops[addressDefinitionRow]
    var rootSlot: int32 = -1
    if addressOp.operands.len == 5:
        rootSlot = addressOp.operands[1]
    let fieldDefinitionDomain =
        sidecar.targetRootDefinitionDomains[receiptRow]
    let fieldDefinitionRow =
        sidecar.targetRootDefinitionRows[receiptRow]
    if fieldDefinitionDomain != BodyDefinitionDomainBodyOpTag ||
       fieldDefinitionRow < 0 ||
       fieldDefinitionRow >= addressDefinitionRow ||
       fieldDefinitionRow >= bodyIR.ops.len ||
       terminalPathRow <= sidecar.pathStarts[receiptRow]:
        return false
    let fieldPathRow = terminalPathRow - 1
    let fieldOp = bodyIR.ops[fieldDefinitionRow]
    var fieldRootSlot: int32 = -1
    if fieldOp.operands.len == 4:
        fieldRootSlot = fieldOp.operands[1]
    let fieldRootSemanticRow =
        bodyIRManagedLvalueReplaceDefinitionSemanticRowExact(
            bodyIR,
            fieldOp.sourceDefinitionDomain,
            fieldOp.sourceDefinitionRow,
            fieldRootSlot)
    let rootSemanticRow =
        bodyIRManagedLvalueReplaceDefinitionSemanticRowExact(
            bodyIR,
            fieldDefinitionDomain,
            fieldDefinitionRow,
            rootSlot)
    if fieldOp.kind != BodyOpLoadLocalTag ||
       fieldOp.operands.len != 4 ||
       fieldOp.operands[0] != BodyLoadLocalFieldAddressTag ||
       fieldRootSemanticRow < 0 ||
       fieldOp.target != rootSlot ||
       fieldOp.valueDefSlot != rootSlot ||
       fieldOp.valueDefExprNodeIndex !=
           sidecar.pathProjectionNodeIndexes[fieldPathRow] ||
       fieldOp.valueDefSemanticRow != fieldRootSemanticRow ||
       fieldOp.valueDefOwnership != OwnBorrowShared ||
       fieldOp.valueDefBorrowOwnerSemanticRow !=
           fieldRootSemanticRow ||
       fieldOp.valueDefBorrowOwnerDefinitionDomain !=
           fieldOp.sourceDefinitionDomain ||
       fieldOp.valueDefBorrowOwnerDefinitionRow !=
           fieldOp.sourceDefinitionRow ||
       fieldOp.valueDefConsumeOpIndexPlusOne != 0 ||
       fieldOp.valueDefOriginKind !=
           BodyDefinitionOriginTypedExprTag ||
       fieldOp.valueDefOriginId != fieldRootSemanticRow ||
       fieldOp.consumeActionRow != -1 ||
       fieldOp.operands[2] !=
           sidecar.pathByteOffsets[fieldPathRow] ||
       fieldOp.operands[3] !=
           sidecar.pathByteWidths[fieldPathRow] ||
       sidecar.pathKinds[fieldPathRow] != 1 ||
       sidecar.pathResultTypeIds[fieldPathRow] !=
           sidecar.pathParentTypeIds[terminalPathRow] ||
       addressOp.kind != BodyOpLoadLocalTag ||
       addressOp.operands.len != 5 ||
       addressOp.operands[0] != BodyLoadLocalIndexedAddressTag ||
       rootSemanticRow < 0 ||
       addressOp.target != sidecar.targetAddressSlotIds[receiptRow] ||
       addressOp.valueDefSlot !=
           sidecar.targetAddressSlotIds[receiptRow] ||
       addressOp.valueDefExprNodeIndex !=
           sidecar.targetLvalueNodeIndexes[receiptRow] ||
       addressOp.valueDefSemanticRow != rootSemanticRow ||
       addressOp.valueDefOwnership != OwnBorrowShared ||
       addressOp.valueDefBorrowOwnerSemanticRow !=
           rootSemanticRow ||
       addressOp.valueDefBorrowOwnerDefinitionDomain !=
           fieldDefinitionDomain ||
       addressOp.valueDefBorrowOwnerDefinitionRow !=
           fieldDefinitionRow ||
       addressOp.valueDefConsumeOpIndexPlusOne != 0 ||
       addressOp.valueDefOriginKind !=
           BodyDefinitionOriginTypedExprTag ||
       addressOp.valueDefOriginId !=
           addressOp.valueDefSemanticRow ||
       addressOp.sourceDefinitionDomain !=
           fieldDefinitionDomain ||
       addressOp.sourceDefinitionRow !=
           fieldDefinitionRow ||
       addressOp.consumeActionRow != -1 ||
       addressOp.operands[3] !=
           sidecar.pathByteWidths[terminalPathRow] ||
       (addressOp.operands[4] != 0 && addressOp.operands[4] != 1) ||
       !bodyIRManagedLvalueReplaceDefinitionTargetsSlotExact(
           bodyIR,
           sidecar.pathIndexDefinitionDomains[terminalPathRow],
           sidecar.pathIndexDefinitionRows[terminalPathRow],
           addressOp.operands[2]):
        return false
    return true

@borrows
fn bodyIRManagedLvalueReplaceRuntimeArgsExact(
        bodyIR: BodyIR,
        receiptRow: int32): bool =
    let sidecar = bodyIR.managedLvalueReplace
    if receiptRow < 0 ||
       receiptRow >= sidecar.callOrdinals.len:
        return false
    let callOrdinal = sidecar.callOrdinals[receiptRow]
    let descriptorRow = sidecar.dropGlueDescriptorRows[receiptRow]
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len ||
       descriptorRow < 0 ||
       descriptorRow >= sidecar.descriptorPayloads.len:
        return false
    let call = bodyIR.callSequence[callOrdinal]
    if call.argSlots.len != 6 ||
       call.argPassKinds.len != 6 ||
       call.argAbiSizes.len != 6 ||
       call.argPassKinds[0] != BodyCallPassBorrowAddressTag ||
       call.argPassKinds[2] != BodyCallPassStackValueTag ||
       call.argPassKinds[3] != BodyCallPassStackValueTag ||
       call.argPassKinds[4] != BodyCallPassStackValueTag ||
       call.argPassKinds[5] != BodyCallPassStackValueTag ||
       call.argAbiSizes[0] != 8 || call.argAbiSizes[1] != 8 ||
       call.argAbiSizes[2] != 8 || call.argAbiSizes[3] != 4 ||
       call.argAbiSizes[4] != 4 || call.argAbiSizes[5] != 4 ||
       !CallArgSlotIsAddress(call.argSlots[0]) ||
       CallArgSlotAddressId(call.argSlots[0]) !=
           sidecar.targetAddressSlotIds[receiptRow] ||
       !CallArgSlotIsCString(call.argSlots[2]):
        return false
    let literalId = CallArgSlotCStringId(call.argSlots[2])
    if literalId < 0 || literalId >= bodyIR.cstringLiterals.len ||
       bodyIR.cstringLiterals[literalId].text !=
           sidecar.descriptorPayloads[descriptorRow]:
        return false
    for argOrdinal in 3..<6:
        let slotId = call.argSlots[argOrdinal]
        if slotId < 0 || slotId >= bodyIR.localSlots.len ||
           bodyIR.localSlots[slotId].typeKind != LocalI32Tag ||
           bodyIR.localSlots[slotId].placeKind !=
               BodyPlaceStackValueTag:
            return false
    return true

@borrows
fn bodyIRManagedLvalueReplaceRowsShapeValid(
        bodyIR: BodyIR): bool =
    let sidecar = bodyIR.managedLvalueReplace
    if !bodyIRManagedLvalueReplaceRowsAligned(sidecar) ||
       !bodyIRManagedLvalueReplacePathsAligned(sidecar) ||
       !bodyIRManagedLvalueReplaceDescriptorsAligned(sidecar) ||
       sidecar.callOrdinals.len == 0 ||
       sidecar.descriptorRootTypeIds.len == 0:
        return false
    var expectedPathStart: int32
    var previousCallOrdinal: int32 = -1
    for row in 0..<sidecar.callOrdinals.len:
        let callOrdinal = sidecar.callOrdinals[row]
        let replaceOpRow = sidecar.replaceOpRows[row]
        let descriptorRow = sidecar.dropGlueDescriptorRows[row]
        if callOrdinal <= previousCallOrdinal ||
           callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len ||
           replaceOpRow < 0 || replaceOpRow >= bodyIR.ops.len ||
           bodyIR.ops[replaceOpRow].kind != BodyOpCallTag ||
           bodyIR.ops[replaceOpRow].operands.len != 1 ||
           bodyIR.ops[replaceOpRow].operands[0] != callOrdinal ||
           (sidecar.targetKinds[row] != 2 &&
            sidecar.targetKinds[row] != 3) ||
           (sidecar.replaceModes[row] != 1 &&
            sidecar.replaceModes[row] != 2) ||
           sidecar.targetLvalueNodeIndexes[row] < 0 ||
           sidecar.sourceValueNodeIndexes[row] < 0 ||
           sidecar.targetRootDefinitionDomains[row] ==
               BodyDefinitionDomainInvalidTag ||
           sidecar.targetRootDefinitionRows[row] < 0 ||
           sidecar.targetAddressSlotIds[row] < 0 ||
           sidecar.targetAddressSlotIds[row] >= bodyIR.localSlots.len ||
           sidecar.targetAddressDefinitionRows[row] < 0 ||
           sidecar.targetAddressDefinitionRows[row] >= replaceOpRow ||
           bodyIR.localSlots[
               sidecar.targetAddressSlotIds[row]].typeKind != LocalPtrTag ||
           bodyIR.localSlots[
               sidecar.targetAddressSlotIds[row]].placeKind !=
                   BodyPlaceBorrowAddressTag ||
           bodyIR.localSlots[
               sidecar.targetAddressSlotIds[row]].managedStorageKind !=
                   BodyManagedStorageManagedTag ||
           sidecar.targetTypeIds[row] < 0 ||
           bodyIR.localSlots[
               sidecar.targetAddressSlotIds[row]].typeArenaTypeId !=
                   sidecar.targetTypeIds[row] ||
           sidecar.sourceDefinitionDomains[row] ==
               BodyDefinitionDomainInvalidTag ||
           sidecar.sourceDefinitionRows[row] < 0 ||
           sidecar.sourceSlotIds[row] < 0 ||
           sidecar.sourceSlotIds[row] >= bodyIR.localSlots.len ||
           sidecar.sourceSemanticRows[row] < 0 ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.runtimeSemanticCids[row]) ||
           sidecar.pathStarts[row] != expectedPathStart ||
           sidecar.pathCounts[row] <= 0 ||
           descriptorRow < 0 ||
           descriptorRow >= sidecar.descriptorRootTypeIds.len ||
           sidecar.descriptorRootTypeIds[descriptorRow] !=
               sidecar.targetTypeIds[row] ||
           bodyIR.callSequence[callOrdinal].managedReplaceReceiptRow != row ||
           bodyIR.callSequence[callOrdinal].managedDropGlueDescriptorRow !=
               descriptorRow ||
           bodyIR.callSequence[callOrdinal].sourceDefinitionDomain !=
               sidecar.sourceDefinitionDomains[row] ||
           bodyIR.callSequence[callOrdinal].sourceDefinitionRow !=
               sidecar.sourceDefinitionRows[row] ||
           bodyIR.callSequence[callOrdinal].consumeActionRow !=
               sidecar.consumeActionRows[row] ||
           (bodyIR.callSequence[callOrdinal].managedStoreKind !=
                ManagedStoreAggregateRetainTag &&
           bodyIR.callSequence[callOrdinal].managedStoreKind !=
                ManagedStoreAggregateMoveTag):
            return false
        if sidecar.sourceDefinitionDomains[row] ==
               BodyDefinitionDomainBodyOpTag:
            let sourceDefinitionRow =
                sidecar.sourceDefinitionRows[row]
            if sourceDefinitionRow < 0 ||
               sourceDefinitionRow >= replaceOpRow ||
               bodyIR.ops[sourceDefinitionRow].valueDefConsumeOpIndexPlusOne != 0 ||
               bodyIR.ops[sourceDefinitionRow].consumeActionRow != -1:
                return false
        if sidecar.replaceModes[row] == 1:
            if sidecar.consumeActionRows[row] != replaceOpRow ||
               bodyIR.callSequence[callOrdinal].managedStoreKind !=
                   ManagedStoreAggregateMoveTag:
                return false
        else:
            if sidecar.consumeActionRows[row] != -1 ||
               bodyIR.callSequence[callOrdinal].managedStoreKind !=
                   ManagedStoreAggregateRetainTag:
                return false
        let pathStart = sidecar.pathStarts[row]
        let pathCount = sidecar.pathCounts[row]
        let terminalPathRow = pathStart + pathCount - 1
        if (sidecar.targetKinds[row] == 2 &&
            sidecar.pathKinds[terminalPathRow] != 1) ||
           (sidecar.targetKinds[row] == 3 &&
            sidecar.pathKinds[terminalPathRow] != 2) ||
           sidecar.pathResultTypeIds[terminalPathRow] !=
               sidecar.targetTypeIds[row]:
            return false
        if !bodyIRManagedLvalueReplaceIndexedAddressExact(
               bodyIR, row, terminalPathRow):
            return false
        if !bodyIRManagedLvalueReplaceRuntimeArgsExact(
               bodyIR, row):
            return false
        for pathOffset in 1..<pathCount:
            let previousPathRow = pathStart + pathOffset - 1
            let pathRow = pathStart + pathOffset
            if sidecar.pathResultTypeIds[previousPathRow] !=
                   sidecar.pathParentTypeIds[pathRow]:
                return false
        expectedPathStart = expectedPathStart +
            sidecar.pathCounts[row]
        previousCallOrdinal = callOrdinal
    if expectedPathStart != sidecar.pathKinds.len:
        return false
    for pathRow in 0..<sidecar.pathKinds.len:
        if !bodyIRManagedLvalueReplacePathTupleValid(
               sidecar.pathKinds[pathRow],
               sidecar.pathProjectionNodeIndexes[pathRow],
               sidecar.pathParentTypeIds[pathRow],
               sidecar.pathIdentityKinds[pathRow],
               sidecar.pathIdentityRows[pathRow],
               sidecar.pathSelectorOrdinals[pathRow],
               sidecar.pathResultTypeIds[pathRow],
               sidecar.pathByteOffsets[pathRow],
               sidecar.pathByteWidths[pathRow],
               sidecar.pathIndexNodeIndexes[pathRow],
               sidecar.pathIndexDefinitionDomains[pathRow],
               sidecar.pathIndexDefinitionRows[pathRow]):
            return false
    for descriptorRow in 0..<sidecar.descriptorRootTypeIds.len:
        if sidecar.descriptorRootTypeIds[descriptorRow] < 0 ||
           len(sidecar.descriptorPayloads[descriptorRow]) == 0 ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.descriptorDigests[descriptorRow]) ||
           !layout.FixedBytes32Equal(
               sidecar.descriptorDigests[descriptorRow],
               bodyIRManagedLvalueReplaceDescriptorDigest(
                   sidecar.descriptorPayloads[descriptorRow])):
            return false
    return true

@borrows
fn bodyIRManagedLvalueReplaceSidecarCidExact(
        bodyIR: BodyIR): layout.FixedBytes32 =
    let sidecar = bodyIR.managedLvalueReplace
    if !sidecar.sealed || sidecar.building ||
       !bodyIRManagedLvalueReplaceRowsShapeValid(bodyIR):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(1024)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.managed_lvalue_replace.v1")
    bodyIRControlActionAppendI32(buf, sidecar.functionRow)
    layout.ByteBufAppendFixed32(buf, sidecar.typeArenaArtifactCid)
    bodyIRControlActionAppendI32(buf, sidecar.callOrdinals.len)
    for row in 0..<sidecar.callOrdinals.len:
        bodyIRControlActionAppendI32(buf, sidecar.callOrdinals[row])
        bodyIRControlActionAppendI32(buf, sidecar.replaceOpRows[row])
        bodyIRControlActionAppendI32(buf, sidecar.targetKinds[row])
        bodyIRControlActionAppendI32(buf, sidecar.replaceModes[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetLvalueNodeIndexes[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceValueNodeIndexes[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetRootDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetRootDefinitionRows[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetAddressSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetAddressDefinitionRows[row])
        bodyIRControlActionAppendI32(buf, sidecar.targetTypeIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceDefinitionRows[row])
        bodyIRControlActionAppendI32(buf, sidecar.sourceSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceSemanticRows[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.consumeActionRows[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.runtimeSemanticCids[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathStarts[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathCounts[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.dropGlueDescriptorRows[row])
    bodyIRControlActionAppendI32(buf, sidecar.pathKinds.len)
    for row in 0..<sidecar.pathKinds.len:
        bodyIRControlActionAppendI32(buf, sidecar.pathKinds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.pathProjectionNodeIndexes[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathParentTypeIds[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathIdentityKinds[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathIdentityRows[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.pathSelectorOrdinals[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathResultTypeIds[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathByteOffsets[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathByteWidths[row])
        bodyIRControlActionAppendI32(buf, sidecar.pathIndexNodeIndexes[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.pathIndexDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.pathIndexDefinitionRows[row])
    bodyIRControlActionAppendI32(
        buf, sidecar.descriptorRootTypeIds.len)
    for row in 0..<sidecar.descriptorRootTypeIds.len:
        bodyIRControlActionAppendI32(
            buf, sidecar.descriptorRootTypeIds[row])
        bodyIRControlActionAppendText(
            buf, sidecar.descriptorPayloads[row])
        layout.ByteBufAppendFixed32(buf, sidecar.descriptorDigests[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRManagedLvalueReplaceSidecarShapeValid(
        bodyIR: BodyIR): bool =
    if BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
           bodyIR.managedLvalueReplace):
        return true
    if bodyIR.managedLvalueReplace.building ||
       !bodyIR.managedLvalueReplace.sealed ||
       bodyIR.managedLvalueReplace.functionRow < 0 ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.managedLvalueReplace.typeArenaArtifactCid) ||
       !layout.FixedBytes32Equal(
           bodyIR.managedLvalueReplace.typeArenaArtifactCid,
           bodyIR.typeArenaArtifactCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.managedLvalueReplace.rootCid) ||
       !bodyIRManagedLvalueReplaceRowsShapeValid(bodyIR):
        return false
    return layout.FixedBytes32Equal(
        bodyIR.managedLvalueReplace.rootCid,
        bodyIRManagedLvalueReplaceSidecarCidExact(bodyIR))

fn BodyIRManagedLvalueReplaceSeal(bodyIR: var BodyIR) =
    if !bodyIR.managedLvalueReplace.building ||
       bodyIR.managedLvalueReplace.sealed ||
       !bodyIRManagedLvalueReplaceRowsShapeValid(bodyIR):
        panic("body ir managed replace: seal state invalid")
    bodyIR.managedLvalueReplace.building = false
    bodyIR.managedLvalueReplace.sealed = true
    let rootCid = bodyIRManagedLvalueReplaceSidecarCidExact(bodyIR)
    if !BodyIRTypeArenaArtifactCidValid(rootCid):
        panic("body ir managed replace: root cid invalid")
    bodyIR.managedLvalueReplace.rootCid = rootCid
    if !BodyIRManagedLvalueReplaceSidecarShapeValid(bodyIR):
        panic("body ir managed replace: sealed shape invalid")

fn BodyIRManagedLvalueReplaceBegin(
        bodyIR: var BodyIR,
        functionRow: int32,
        typeArenaArtifactCid: layout.FixedBytes32) =
    if bodyIR.controlFlowSealed ||
       functionRow < 0 ||
       functionRow != bodyIR.controlFunctionRow ||
       !BodyIRManagedLvalueReplaceSidecarIsCanonicalEmpty(
           bodyIR.managedLvalueReplace) ||
       !BodyIRTypeArenaArtifactCidValid(typeArenaArtifactCid) ||
       !layout.FixedBytes32Equal(
           typeArenaArtifactCid, bodyIR.typeArenaArtifactCid):
        panic("body ir managed replace: begin authority invalid")
    bodyIR.managedLvalueReplace.building = true
    bodyIR.managedLvalueReplace.functionRow = functionRow
    bodyIR.managedLvalueReplace.typeArenaArtifactCid =
        layout.FixedBytes32Copy(typeArenaArtifactCid)

@borrows
fn BodyIRManagedLvalueReplaceDescriptorIntern(
        bodyIR: var BodyIR,
        rootTypeId: int32,
        payload: str,
        digest: layout.FixedBytes32): int32 =
    if !bodyIR.managedLvalueReplace.building ||
       bodyIR.managedLvalueReplace.sealed ||
       rootTypeId < 0 || len(payload) == 0 ||
       !bodyIRManagedLvalueReplaceDescriptorsAligned(
           bodyIR.managedLvalueReplace) ||
       !BodyIRTypeArenaArtifactCidValid(digest) ||
       !layout.FixedBytes32Equal(
           digest,
           bodyIRManagedLvalueReplaceDescriptorDigest(payload)):
        panic("body ir managed replace: descriptor authority invalid")
    for row in 0..<bodyIR.managedLvalueReplace.descriptorRootTypeIds.len:
        if layout.FixedBytes32Equal(
               bodyIR.managedLvalueReplace.descriptorDigests[row],
               digest):
            if bodyIR.managedLvalueReplace.descriptorRootTypeIds[row] !=
                   rootTypeId ||
               bodyIR.managedLvalueReplace.descriptorPayloads[row] !=
                   payload:
                panic("body ir managed replace: descriptor digest collision")
            return row
    let row =
        bodyIR.managedLvalueReplace.descriptorRootTypeIds.len
    add(bodyIR.managedLvalueReplace.descriptorRootTypeIds, rootTypeId)
    add(bodyIR.managedLvalueReplace.descriptorPayloads,
        strings.CloneStr(payload))
    add(bodyIR.managedLvalueReplace.descriptorDigests,
        layout.FixedBytes32Copy(digest))
    return row

@borrows
fn BodyIRManagedLvalueReplaceAppendExact(
        bodyIR: var BodyIR,
        callOrdinal: int32,
        replaceOpRow: int32,
        targetKind: int32,
        replaceMode: int32,
        targetLvalueNodeIndex: int32,
        sourceValueNodeIndex: int32,
        targetRootDefinitionDomain: int32,
        targetRootDefinitionRow: int32,
        targetAddressSlotId: int32,
        targetAddressDefinitionRow: int32,
        targetTypeId: int32,
        sourceDefinitionDomain: int32,
        sourceDefinitionRow: int32,
        sourceSlotId: int32,
        sourceSemanticRow: int32,
        consumeActionRow: int32,
        runtimeSemanticCid: layout.FixedBytes32,
        descriptorRow: int32,
        pathKinds: int32[],
        pathProjectionNodeIndexes: int32[],
        pathParentTypeIds: int32[],
        pathIdentityKinds: int32[],
        pathIdentityRows: int32[],
        pathSelectorOrdinals: int32[],
        pathResultTypeIds: int32[],
        pathByteOffsets: int32[],
        pathByteWidths: int32[],
        pathIndexNodeIndexes: int32[],
        pathIndexDefinitionDomains: int32[],
        pathIndexDefinitionRows: int32[]): int32 =
    let pathCount = pathKinds.len
    let receiptRow = bodyIR.managedLvalueReplace.callOrdinals.len
    if !bodyIR.managedLvalueReplace.building ||
       bodyIR.managedLvalueReplace.sealed ||
       !bodyIRManagedLvalueReplaceRowsAligned(
           bodyIR.managedLvalueReplace) ||
       !bodyIRManagedLvalueReplacePathsAligned(
           bodyIR.managedLvalueReplace) ||
       !bodyIRManagedLvalueReplaceDescriptorsAligned(
           bodyIR.managedLvalueReplace) ||
       callOrdinal != bodyIR.callSequence.len ||
       replaceOpRow != bodyIR.ops.len ||
       targetKind <= 0 ||
       (replaceMode != 1 && replaceMode != 2) ||
       targetLvalueNodeIndex < 0 || sourceValueNodeIndex < 0 ||
       targetRootDefinitionDomain ==
           BodyDefinitionDomainInvalidTag ||
       targetRootDefinitionRow < 0 ||
       targetAddressSlotId < 0 ||
       targetAddressSlotId >= bodyIR.localSlots.len ||
       targetAddressDefinitionRow < 0 ||
       targetAddressDefinitionRow >= replaceOpRow ||
       targetTypeId < 0 ||
       sourceDefinitionDomain == BodyDefinitionDomainInvalidTag ||
       sourceDefinitionRow < 0 ||
       sourceSlotId < 0 || sourceSlotId >= bodyIR.localSlots.len ||
       sourceSemanticRow < 0 ||
       !BodyIRTypeArenaArtifactCidValid(runtimeSemanticCid) ||
       descriptorRow < 0 ||
       descriptorRow >=
           bodyIR.managedLvalueReplace.descriptorRootTypeIds.len ||
       bodyIR.managedLvalueReplace.descriptorRootTypeIds[
           descriptorRow] != targetTypeId ||
       pathCount <= 0 ||
       pathProjectionNodeIndexes.len != pathCount ||
       pathParentTypeIds.len != pathCount ||
       pathIdentityKinds.len != pathCount ||
       pathIdentityRows.len != pathCount ||
       pathSelectorOrdinals.len != pathCount ||
       pathResultTypeIds.len != pathCount ||
       pathByteOffsets.len != pathCount ||
       pathByteWidths.len != pathCount ||
       pathIndexNodeIndexes.len != pathCount ||
       pathIndexDefinitionDomains.len != pathCount ||
       pathIndexDefinitionRows.len != pathCount ||
       (replaceMode == 1 && consumeActionRow != replaceOpRow) ||
       (replaceMode == 2 && consumeActionRow != -1):
        panic("body ir managed replace: immutable receipt invalid")
    for pathRow in 0..<pathCount:
        if !bodyIRManagedLvalueReplacePathTupleValid(
               pathKinds[pathRow],
               pathProjectionNodeIndexes[pathRow],
               pathParentTypeIds[pathRow],
               pathIdentityKinds[pathRow],
               pathIdentityRows[pathRow],
               pathSelectorOrdinals[pathRow],
               pathResultTypeIds[pathRow],
               pathByteOffsets[pathRow],
               pathByteWidths[pathRow],
               pathIndexNodeIndexes[pathRow],
               pathIndexDefinitionDomains[pathRow],
               pathIndexDefinitionRows[pathRow]):
            panic("body ir managed replace: path receipt invalid")
    add(bodyIR.managedLvalueReplace.callOrdinals, callOrdinal)
    add(bodyIR.managedLvalueReplace.replaceOpRows, replaceOpRow)
    add(bodyIR.managedLvalueReplace.targetKinds, targetKind)
    add(bodyIR.managedLvalueReplace.replaceModes, replaceMode)
    add(bodyIR.managedLvalueReplace.targetLvalueNodeIndexes,
        targetLvalueNodeIndex)
    add(bodyIR.managedLvalueReplace.sourceValueNodeIndexes,
        sourceValueNodeIndex)
    add(bodyIR.managedLvalueReplace.targetRootDefinitionDomains,
        targetRootDefinitionDomain)
    add(bodyIR.managedLvalueReplace.targetRootDefinitionRows,
        targetRootDefinitionRow)
    add(bodyIR.managedLvalueReplace.targetAddressSlotIds,
        targetAddressSlotId)
    add(bodyIR.managedLvalueReplace.targetAddressDefinitionRows,
        targetAddressDefinitionRow)
    add(bodyIR.managedLvalueReplace.targetTypeIds, targetTypeId)
    add(bodyIR.managedLvalueReplace.sourceDefinitionDomains,
        sourceDefinitionDomain)
    add(bodyIR.managedLvalueReplace.sourceDefinitionRows,
        sourceDefinitionRow)
    add(bodyIR.managedLvalueReplace.sourceSlotIds, sourceSlotId)
    add(bodyIR.managedLvalueReplace.sourceSemanticRows,
        sourceSemanticRow)
    add(bodyIR.managedLvalueReplace.consumeActionRows,
        consumeActionRow)
    add(bodyIR.managedLvalueReplace.runtimeSemanticCids,
        layout.FixedBytes32Copy(runtimeSemanticCid))
    add(bodyIR.managedLvalueReplace.pathStarts,
        bodyIR.managedLvalueReplace.pathKinds.len)
    add(bodyIR.managedLvalueReplace.pathCounts, pathCount)
    for pathRow in 0..<pathCount:
        add(bodyIR.managedLvalueReplace.pathKinds,
            pathKinds[pathRow])
        add(bodyIR.managedLvalueReplace.pathProjectionNodeIndexes,
            pathProjectionNodeIndexes[pathRow])
        add(bodyIR.managedLvalueReplace.pathParentTypeIds,
            pathParentTypeIds[pathRow])
        add(bodyIR.managedLvalueReplace.pathIdentityKinds,
            pathIdentityKinds[pathRow])
        add(bodyIR.managedLvalueReplace.pathIdentityRows,
            pathIdentityRows[pathRow])
        add(bodyIR.managedLvalueReplace.pathSelectorOrdinals,
            pathSelectorOrdinals[pathRow])
        add(bodyIR.managedLvalueReplace.pathResultTypeIds,
            pathResultTypeIds[pathRow])
        add(bodyIR.managedLvalueReplace.pathByteOffsets,
            pathByteOffsets[pathRow])
        add(bodyIR.managedLvalueReplace.pathByteWidths,
            pathByteWidths[pathRow])
        add(bodyIR.managedLvalueReplace.pathIndexNodeIndexes,
            pathIndexNodeIndexes[pathRow])
        add(bodyIR.managedLvalueReplace.pathIndexDefinitionDomains,
            pathIndexDefinitionDomains[pathRow])
        add(bodyIR.managedLvalueReplace.pathIndexDefinitionRows,
            pathIndexDefinitionRows[pathRow])
    add(bodyIR.managedLvalueReplace.dropGlueDescriptorRows,
        descriptorRow)
    return receiptRow

@borrows
fn bodyIRManualConsumeSidecarRowsAligned(
        sidecar: BodyIRManualConsumeSidecar): bool =
    let rowCount = sidecar.callOrdinals.len
    return sidecar.snapshotCallIds.len == rowCount &&
           sidecar.targetArgumentOrdinals.len == rowCount &&
           sidecar.sourceArgumentOrdinals.len == rowCount &&
           sidecar.targetPlaceSlotIds.len == rowCount &&
           sidecar.targetOwnerSlotIds.len == rowCount &&
           sidecar.sourcePlaceSlotIds.len == rowCount &&
           sidecar.targetArgumentBindingCids.len == rowCount &&
           sidecar.sourceArgumentBindingCids.len == rowCount &&
           sidecar.targetProjectionCids.len == rowCount &&
           sidecar.sourceProjectionCids.len == rowCount &&
           sidecar.targetDefinitionDomains.len == rowCount &&
           sidecar.targetDefinitionRows.len == rowCount &&
           sidecar.sourceDefinitionDomains.len == rowCount &&
           sidecar.sourceDefinitionRows.len == rowCount &&
           sidecar.targetTypeArenaTypeIds.len == rowCount &&
           sidecar.sourceTypeArenaTypeIds.len == rowCount &&
           sidecar.postDefinitionDomains.len == rowCount &&
           sidecar.postDefinitionRows.len == rowCount &&
           sidecar.effectCids.len == rowCount &&
           sidecar.linearTokenCids.len == rowCount &&
           sidecar.bridgeCids.len == rowCount

@borrows
fn BodyIRManualConsumeSidecarIsCanonicalEmpty(
        sidecar: BodyIRManualConsumeSidecar): bool =
    return !sidecar.sealed && !sidecar.functionPresent &&
           sidecar.functionRow == -1 &&
           sidecar.functionTargetParameterOrdinal == -1 &&
           sidecar.functionSourceParameterOrdinal == -1 &&
           sidecar.functionTargetSlotId == -1 &&
           sidecar.functionSourceSlotId == -1 &&
           sidecar.functionTargetTypeArenaTypeId == -1 &&
           sidecar.functionSourceTypeArenaTypeId == -1 &&
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.functionEffectCid) &&
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.functionBodyProofCid) &&
           sidecar.callOrdinals.len == 0 &&
           bodyIRManualConsumeSidecarRowsAligned(sidecar) &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.rootCid)

@borrows
fn BodyIRManualConsumeSidecarHasPhysicalStorage(
        sidecar: BodyIRManualConsumeSidecar): bool =
    return sidecar.callOrdinals.cap > 0 ||
           sidecar.snapshotCallIds.cap > 0 ||
           sidecar.targetArgumentOrdinals.cap > 0 ||
           sidecar.sourceArgumentOrdinals.cap > 0 ||
           sidecar.targetPlaceSlotIds.cap > 0 ||
           sidecar.targetOwnerSlotIds.cap > 0 ||
           sidecar.sourcePlaceSlotIds.cap > 0 ||
           sidecar.targetArgumentBindingCids.cap > 0 ||
           sidecar.sourceArgumentBindingCids.cap > 0 ||
           sidecar.targetProjectionCids.cap > 0 ||
           sidecar.sourceProjectionCids.cap > 0 ||
           sidecar.targetDefinitionDomains.cap > 0 ||
           sidecar.targetDefinitionRows.cap > 0 ||
           sidecar.sourceDefinitionDomains.cap > 0 ||
           sidecar.sourceDefinitionRows.cap > 0 ||
           sidecar.targetTypeArenaTypeIds.cap > 0 ||
           sidecar.sourceTypeArenaTypeIds.cap > 0 ||
           sidecar.postDefinitionDomains.cap > 0 ||
           sidecar.postDefinitionRows.cap > 0 ||
           sidecar.effectCids.cap > 0 ||
           sidecar.linearTokenCids.cap > 0 ||
           sidecar.bridgeCids.cap > 0

@borrows
fn BodyIRManualConsumeSidecarClone(
        sidecar: BodyIRManualConsumeSidecar): BodyIRManualConsumeSidecar =
    if !bodyIRManualConsumeSidecarRowsAligned(sidecar):
        panic("body ir manual consume: clone source shape invalid")
    var out = BodyIRManualConsumeSidecarNew()
    out.sealed = sidecar.sealed
    out.functionPresent = sidecar.functionPresent
    out.functionRow = sidecar.functionRow
    out.functionTargetParameterOrdinal =
        sidecar.functionTargetParameterOrdinal
    out.functionSourceParameterOrdinal =
        sidecar.functionSourceParameterOrdinal
    out.functionTargetSlotId = sidecar.functionTargetSlotId
    out.functionSourceSlotId = sidecar.functionSourceSlotId
    out.functionTargetTypeArenaTypeId =
        sidecar.functionTargetTypeArenaTypeId
    out.functionSourceTypeArenaTypeId =
        sidecar.functionSourceTypeArenaTypeId
    out.functionEffectCid =
        layout.FixedBytes32Copy(sidecar.functionEffectCid)
    out.functionBodyProofCid =
        layout.FixedBytes32Copy(sidecar.functionBodyProofCid)
    for row in 0..<sidecar.callOrdinals.len:
        add(out.callOrdinals, sidecar.callOrdinals[row])
        add(out.snapshotCallIds, sidecar.snapshotCallIds[row])
        add(out.targetArgumentOrdinals,
            sidecar.targetArgumentOrdinals[row])
        add(out.sourceArgumentOrdinals,
            sidecar.sourceArgumentOrdinals[row])
        add(out.targetPlaceSlotIds,
            sidecar.targetPlaceSlotIds[row])
        add(out.targetOwnerSlotIds,
            sidecar.targetOwnerSlotIds[row])
        add(out.sourcePlaceSlotIds,
            sidecar.sourcePlaceSlotIds[row])
        add(out.targetArgumentBindingCids,
            layout.FixedBytes32Copy(
                sidecar.targetArgumentBindingCids[row]))
        add(out.sourceArgumentBindingCids,
            layout.FixedBytes32Copy(
                sidecar.sourceArgumentBindingCids[row]))
        add(out.targetProjectionCids,
            layout.FixedBytes32Copy(
                sidecar.targetProjectionCids[row]))
        add(out.sourceProjectionCids,
            layout.FixedBytes32Copy(
                sidecar.sourceProjectionCids[row]))
        add(out.targetDefinitionDomains,
            sidecar.targetDefinitionDomains[row])
        add(out.targetDefinitionRows,
            sidecar.targetDefinitionRows[row])
        add(out.sourceDefinitionDomains,
            sidecar.sourceDefinitionDomains[row])
        add(out.sourceDefinitionRows,
            sidecar.sourceDefinitionRows[row])
        add(out.targetTypeArenaTypeIds,
            sidecar.targetTypeArenaTypeIds[row])
        add(out.sourceTypeArenaTypeIds,
            sidecar.sourceTypeArenaTypeIds[row])
        add(out.postDefinitionDomains,
            sidecar.postDefinitionDomains[row])
        add(out.postDefinitionRows,
            sidecar.postDefinitionRows[row])
        add(out.effectCids,
            layout.FixedBytes32Copy(sidecar.effectCids[row]))
        add(out.linearTokenCids,
            layout.FixedBytes32Copy(sidecar.linearTokenCids[row]))
        add(out.bridgeCids,
            layout.FixedBytes32Copy(sidecar.bridgeCids[row]))
    out.rootCid = layout.FixedBytes32Copy(sidecar.rootCid)
    return out

fn BodyIRManualConsumeSidecarMoveInto(
        out: var BodyIRManualConsumeSidecar,
        sidecar: var BodyIRManualConsumeSidecar) =
    if !BodyIRManualConsumeSidecarIsCanonicalEmpty(out) ||
       BodyIRManualConsumeSidecarHasPhysicalStorage(out) ||
       !bodyIRManualConsumeSidecarRowsAligned(sidecar):
        panic("body ir manual consume: move destination owns payload")
    out.sealed = sidecar.sealed
    out.functionPresent = sidecar.functionPresent
    out.functionRow = sidecar.functionRow
    out.functionTargetParameterOrdinal =
        sidecar.functionTargetParameterOrdinal
    out.functionSourceParameterOrdinal =
        sidecar.functionSourceParameterOrdinal
    out.functionTargetSlotId = sidecar.functionTargetSlotId
    out.functionSourceSlotId = sidecar.functionSourceSlotId
    out.functionTargetTypeArenaTypeId =
        sidecar.functionTargetTypeArenaTypeId
    out.functionSourceTypeArenaTypeId =
        sidecar.functionSourceTypeArenaTypeId
    out.functionEffectCid = sidecar.functionEffectCid
    out.functionBodyProofCid = sidecar.functionBodyProofCid
    out.callOrdinals = sidecar.callOrdinals
    out.snapshotCallIds = sidecar.snapshotCallIds
    out.targetArgumentOrdinals = sidecar.targetArgumentOrdinals
    out.sourceArgumentOrdinals = sidecar.sourceArgumentOrdinals
    out.targetPlaceSlotIds = sidecar.targetPlaceSlotIds
    out.targetOwnerSlotIds = sidecar.targetOwnerSlotIds
    out.sourcePlaceSlotIds = sidecar.sourcePlaceSlotIds
    out.targetArgumentBindingCids =
        sidecar.targetArgumentBindingCids
    out.sourceArgumentBindingCids =
        sidecar.sourceArgumentBindingCids
    out.targetProjectionCids = sidecar.targetProjectionCids
    out.sourceProjectionCids = sidecar.sourceProjectionCids
    out.targetDefinitionDomains =
        sidecar.targetDefinitionDomains
    out.targetDefinitionRows = sidecar.targetDefinitionRows
    out.sourceDefinitionDomains =
        sidecar.sourceDefinitionDomains
    out.sourceDefinitionRows = sidecar.sourceDefinitionRows
    out.targetTypeArenaTypeIds =
        sidecar.targetTypeArenaTypeIds
    out.sourceTypeArenaTypeIds =
        sidecar.sourceTypeArenaTypeIds
    out.postDefinitionDomains =
        sidecar.postDefinitionDomains
    out.postDefinitionRows = sidecar.postDefinitionRows
    out.effectCids = sidecar.effectCids
    out.linearTokenCids = sidecar.linearTokenCids
    out.bridgeCids = sidecar.bridgeCids
    out.rootCid = sidecar.rootCid
    sidecar = BodyIRManualConsumeSidecarNew()

fn BodyIRManualConsumeBindFunction(
        bodyIR: var BodyIR,
        functionRow: int32,
        targetParameterOrdinal: int32,
        sourceParameterOrdinal: int32,
        targetSlotId: int32,
        sourceSlotId: int32,
        targetTypeArenaTypeId: int32,
        sourceTypeArenaTypeId: int32,
        effectCid: layout.FixedBytes32,
        bodyProofCid: layout.FixedBytes32) =
    if bodyIR.manualConsume.sealed ||
       bodyIR.manualConsume.functionPresent ||
       !bodyIR.entryDefinitionOwnershipSealed ||
       !BodyIREntryDefinitionOwnershipShapeValid(bodyIR) ||
       functionRow < 0 || targetParameterOrdinal < 0 ||
       sourceParameterOrdinal < 0 ||
       targetParameterOrdinal == sourceParameterOrdinal ||
       targetSlotId < 0 || sourceSlotId < 0 ||
       targetSlotId == sourceSlotId ||
       targetTypeArenaTypeId < 0 ||
       sourceTypeArenaTypeId < 0 ||
       !BodyIRTypeArenaArtifactCidValid(effectCid) ||
       !BodyIRTypeArenaArtifactCidValid(bodyProofCid):
        panic("body ir manual consume: function binding invalid")
    bodyIR.manualConsume.functionPresent = true
    bodyIR.manualConsume.functionRow = functionRow
    bodyIR.manualConsume.functionTargetParameterOrdinal =
        targetParameterOrdinal
    bodyIR.manualConsume.functionSourceParameterOrdinal =
        sourceParameterOrdinal
    bodyIR.manualConsume.functionTargetSlotId = targetSlotId
    bodyIR.manualConsume.functionSourceSlotId = sourceSlotId
    bodyIR.manualConsume.functionTargetTypeArenaTypeId =
        targetTypeArenaTypeId
    bodyIR.manualConsume.functionSourceTypeArenaTypeId =
        sourceTypeArenaTypeId
    bodyIR.manualConsume.functionEffectCid =
        layout.FixedBytes32Copy(effectCid)
    bodyIR.manualConsume.functionBodyProofCid =
        layout.FixedBytes32Copy(bodyProofCid)

fn BodyIRManualConsumeAppendCall(
        bodyIR: var BodyIR,
        effect: BodyIRManualConsumeCallEffect) =
    let row = bodyIR.manualConsume.callOrdinals.len
    if bodyIR.manualConsume.sealed ||
       !bodyIRManualConsumeSidecarRowsAligned(
           bodyIR.manualConsume) ||
       effect.callOrdinal < 0 ||
       effect.snapshotCallId < 0 ||
       effect.targetArgumentOrdinal < 0 ||
       effect.sourceArgumentOrdinal < 0 ||
       effect.targetArgumentOrdinal ==
           effect.sourceArgumentOrdinal ||
       effect.targetPlaceSlotId < 0 ||
       effect.targetOwnerSlotId < 0 ||
       effect.sourcePlaceSlotId < 0 ||
       effect.targetOwnerSlotId == effect.sourcePlaceSlotId ||
       effect.targetDefinitionDomain ==
           BodyDefinitionDomainInvalidTag ||
       effect.sourceDefinitionDomain ==
           BodyDefinitionDomainInvalidTag ||
       effect.targetDefinitionRow < 0 ||
       effect.sourceDefinitionRow < 0 ||
       effect.targetTypeArenaTypeId < 0 ||
       effect.sourceTypeArenaTypeId < 0 ||
       effect.postDefinitionDomain !=
           BodyDefinitionDomainManualConsumePostCallTag ||
       effect.postDefinitionRow != row ||
       !BodyIRTypeArenaArtifactCidValid(
           effect.targetArgumentBindingCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           effect.sourceArgumentBindingCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           effect.targetProjectionCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           effect.sourceProjectionCid) ||
       !BodyIRTypeArenaArtifactCidValid(effect.effectCid) ||
       !BodyIRTypeArenaArtifactCidValid(effect.linearTokenCid) ||
       !BodyIRTypeArenaArtifactCidValid(effect.bridgeCid) ||
       (bodyIR.manualConsume.callOrdinals.len > 0 &&
        effect.callOrdinal <=
            bodyIR.manualConsume.callOrdinals[
                bodyIR.manualConsume.callOrdinals.len - 1]):
        panic("body ir manual consume: call order invalid")
    add(bodyIR.manualConsume.callOrdinals, effect.callOrdinal)
    add(bodyIR.manualConsume.snapshotCallIds, effect.snapshotCallId)
    add(bodyIR.manualConsume.targetArgumentOrdinals,
        effect.targetArgumentOrdinal)
    add(bodyIR.manualConsume.sourceArgumentOrdinals,
        effect.sourceArgumentOrdinal)
    add(bodyIR.manualConsume.targetPlaceSlotIds,
        effect.targetPlaceSlotId)
    add(bodyIR.manualConsume.targetOwnerSlotIds,
        effect.targetOwnerSlotId)
    add(bodyIR.manualConsume.sourcePlaceSlotIds,
        effect.sourcePlaceSlotId)
    add(bodyIR.manualConsume.targetArgumentBindingCids,
        layout.FixedBytes32Copy(effect.targetArgumentBindingCid))
    add(bodyIR.manualConsume.sourceArgumentBindingCids,
        layout.FixedBytes32Copy(effect.sourceArgumentBindingCid))
    add(bodyIR.manualConsume.targetProjectionCids,
        layout.FixedBytes32Copy(effect.targetProjectionCid))
    add(bodyIR.manualConsume.sourceProjectionCids,
        layout.FixedBytes32Copy(effect.sourceProjectionCid))
    add(bodyIR.manualConsume.targetDefinitionDomains,
        effect.targetDefinitionDomain)
    add(bodyIR.manualConsume.targetDefinitionRows,
        effect.targetDefinitionRow)
    add(bodyIR.manualConsume.sourceDefinitionDomains,
        effect.sourceDefinitionDomain)
    add(bodyIR.manualConsume.sourceDefinitionRows,
        effect.sourceDefinitionRow)
    add(bodyIR.manualConsume.targetTypeArenaTypeIds,
        effect.targetTypeArenaTypeId)
    add(bodyIR.manualConsume.sourceTypeArenaTypeIds,
        effect.sourceTypeArenaTypeId)
    add(bodyIR.manualConsume.postDefinitionDomains,
        effect.postDefinitionDomain)
    add(bodyIR.manualConsume.postDefinitionRows,
        effect.postDefinitionRow)
    add(bodyIR.manualConsume.effectCids,
        layout.FixedBytes32Copy(effect.effectCid))
    add(bodyIR.manualConsume.linearTokenCids,
        layout.FixedBytes32Copy(effect.linearTokenCid))
    add(bodyIR.manualConsume.bridgeCids,
        layout.FixedBytes32Copy(effect.bridgeCid))

@borrows
fn BodyIRUniqueCallBodyOpRow(
        bodyIR: BodyIR,
        callOrdinal: int32): int32 =
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
        return -1
    var found: int32 = -1
    for opIndex in 0..<bodyIR.ops.len:
        if bodyIR.ops[opIndex].kind == BodyOpCallTag &&
           bodyIR.ops[opIndex].operands.len == 1 &&
           bodyIR.ops[opIndex].operands[0] == callOrdinal:
            if found >= 0:
                return -1
            found = opIndex
    return found

@borrows
fn bodyIRManualConsumeDefinitionRefValid(
        bodyIR: BodyIR,
        sidecarRow: int32,
        expectedSlotId: int32,
        domain: int32,
        row: int32,
        requireOwnedSource: bool): bool =
    if domain == BodyDefinitionDomainEntrySlotTag:
        return row == expectedSlotId &&
               row >= 0 && row < bodyIR.localSlots.len &&
               bodyIR.entryDefinitionOwnershipSealed &&
               row <
                   bodyIR.entryDefinitionOwnershipKinds.len &&
               bodyIR.localSlots[row].stackOffset < 0 &&
               (!requireOwnedSource ||
                bodyIR.entryDefinitionOwnershipKinds[row] ==
                    int32(OwnMove))
    if domain == BodyDefinitionDomainBodyOpTag:
        return row >= 0 && row < bodyIR.ops.len &&
               bodyIR.ops[row].valueDefSlot == expectedSlotId &&
               bodyIR.ops[row].valueDefOwnership == OwnMove
    if domain == BodyDefinitionDomainManualConsumePostCallTag:
        return row >= 0 && row < sidecarRow &&
               row < bodyIR.manualConsume.postDefinitionRows.len &&
               bodyIR.manualConsume.postDefinitionDomains[row] ==
                   BodyDefinitionDomainManualConsumePostCallTag &&
               bodyIR.manualConsume.postDefinitionRows[row] == row &&
               bodyIR.manualConsume.targetOwnerSlotIds[row] ==
                   expectedSlotId
    return false

@borrows
fn bodyIRManualConsumeSourceArgumentExact(
        call: CallOp,
        ordinal: int32,
        slotId: int32): bool =
    if ordinal < 0 || ordinal >= call.argSlots.len ||
       ordinal >= call.argPassKinds.len:
        return false
    let passKind = call.argPassKinds[ordinal]
    if passKind == BodyCallPassStackValueTag:
        return call.argSlots[ordinal] == slotId
    if passKind == BodyCallPassParamAddressTag ||
       passKind == BodyCallPassByAddressAggregateTag:
        return CallArgSlotIsAddress(call.argSlots[ordinal]) &&
               CallArgSlotAddressId(call.argSlots[ordinal]) == slotId
    return false

@borrows
fn bodyIRManualConsumeFunctionShapeValid(
        bodyIR: BodyIR,
        sidecar: BodyIRManualConsumeSidecar): bool =
    if !sidecar.functionPresent:
        return sidecar.functionRow == -1 &&
               sidecar.functionTargetParameterOrdinal == -1 &&
               sidecar.functionSourceParameterOrdinal == -1 &&
               sidecar.functionTargetSlotId == -1 &&
               sidecar.functionSourceSlotId == -1 &&
               sidecar.functionTargetTypeArenaTypeId == -1 &&
               sidecar.functionSourceTypeArenaTypeId == -1 &&
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.functionEffectCid) &&
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.functionBodyProofCid)
    let targetTypeFactRow = BodyIRCanonicalTypeFactRow(
        bodyIR, sidecar.functionTargetTypeArenaTypeId)
    let sourceTypeFactRow = BodyIRCanonicalTypeFactRow(
        bodyIR, sidecar.functionSourceTypeArenaTypeId)
    if !bodyIR.controlFlowSealed ||
       !bodyIR.entryDefinitionOwnershipSealed ||
       !BodyIREntryDefinitionOwnershipShapeValid(bodyIR) ||
       sidecar.functionRow != bodyIR.controlFunctionRow ||
       sidecar.functionTargetParameterOrdinal < 0 ||
       sidecar.functionSourceParameterOrdinal < 0 ||
       sidecar.functionTargetParameterOrdinal ==
           sidecar.functionSourceParameterOrdinal ||
       sidecar.functionTargetSlotId < 0 ||
       sidecar.functionTargetSlotId >= bodyIR.localSlots.len ||
       sidecar.functionSourceSlotId < 0 ||
       sidecar.functionSourceSlotId >= bodyIR.localSlots.len ||
       sidecar.functionTargetSlotId == sidecar.functionSourceSlotId ||
       sidecar.functionTargetTypeArenaTypeId < 0 ||
       sidecar.functionSourceTypeArenaTypeId < 0 ||
       targetTypeFactRow < 0 ||
       sourceTypeFactRow < 0 ||
       !BodyIRTypeArenaArtifactCidValid(
           sidecar.functionEffectCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           sidecar.functionBodyProofCid):
        return false
    return bodyIR.localSlots[
               sidecar.functionTargetSlotId].stackOffset < 0 &&
           bodyIR.localSlots[
               sidecar.functionSourceSlotId].stackOffset < 0 &&
           bodyIR.localSlots[
               sidecar.functionTargetSlotId].placeKind ==
               BodyPlaceParamAddressTag &&
           bodyIR.localSlots[
               sidecar.functionTargetSlotId].managedStorageKind ==
               BodyManagedStorageManagedTag &&
           bodyIR.localSlots[
               sidecar.functionSourceSlotId].managedStorageKind ==
               BodyManagedStorageManagedTag &&
           bodyIR.entryDefinitionOwnershipKinds[
               sidecar.functionTargetSlotId] ==
               int32(OwnBorrowUnique) &&
           bodyIR.entryDefinitionOwnershipKinds[
               sidecar.functionSourceSlotId] ==
               int32(OwnMove) &&
           bodyIR.localSlots[
               sidecar.functionTargetSlotId].typeArenaTypeId ==
               sidecar.functionSourceTypeArenaTypeId &&
           bodyIR.localSlots[
               sidecar.functionSourceSlotId].typeArenaTypeId ==
               sidecar.functionSourceTypeArenaTypeId &&
           bodyIR.typeFactChildTypeIds[targetTypeFactRow] ==
               sidecar.functionSourceTypeArenaTypeId

@borrows
fn bodyIRManualConsumeCallArgumentsValid(
        call: CallOp,
        targetOrdinal: int32,
        sourceOrdinal: int32,
        targetSlotId: int32,
        sourceSlotId: int32): bool =
    return targetOrdinal >= 0 &&
           targetOrdinal < call.argSlots.len &&
           targetOrdinal < call.argPassKinds.len &&
           sourceOrdinal >= 0 &&
           sourceOrdinal < call.argSlots.len &&
           sourceOrdinal < call.argPassKinds.len &&
           targetOrdinal != sourceOrdinal &&
           call.argPassKinds[targetOrdinal] ==
               BodyCallPassBorrowAddressTag &&
           CallArgSlotIsAddress(call.argSlots[targetOrdinal]) &&
           CallArgSlotAddressId(call.argSlots[targetOrdinal]) ==
               targetSlotId &&
           bodyIRManualConsumeSourceArgumentExact(
               call, sourceOrdinal, sourceSlotId)

@borrows
fn bodyIRManualConsumeRowsShapeValid(
        bodyIR: BodyIR,
        sidecar: BodyIRManualConsumeSidecar): bool =
    if !bodyIRManualConsumeSidecarRowsAligned(sidecar) ||
       !bodyIR.entryDefinitionOwnershipSealed ||
       !BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        return false
    var previousCallOrdinal: int32 = -1
    for row in 0..<sidecar.callOrdinals.len:
        let callOrdinal = sidecar.callOrdinals[row]
        if callOrdinal <= previousCallOrdinal ||
           callOrdinal >= bodyIR.callSequence.len ||
           callOrdinal >= bodyIR.callTargetDomainKinds.len ||
           callOrdinal >= bodyIR.callTargetRows.len ||
           callOrdinal >= bodyIR.callTargetInterfaceCids.len ||
           bodyIR.callTargetDomainKinds[callOrdinal] !=
               BodyCallTargetDomainFunctionTag ||
           bodyIR.callTargetRows[callOrdinal] < 0 ||
           sidecar.snapshotCallIds[row] < 0 ||
           bodyIR.callSequence[
               callOrdinal].semanticCallExprNodeIndex < 0 ||
           !BodyIRTypeArenaArtifactCidValid(
               bodyIR.callTargetInterfaceCids[callOrdinal]):
            return false
        let callOpIndex =
            BodyIRUniqueCallBodyOpRow(bodyIR, callOrdinal)
        if callOpIndex < 0:
            return false
        previousCallOrdinal = callOrdinal
        let targetOrdinal = sidecar.targetArgumentOrdinals[row]
        let sourceOrdinal = sidecar.sourceArgumentOrdinals[row]
        let targetSlotId = sidecar.targetPlaceSlotIds[row]
        let targetOwnerSlotId =
            sidecar.targetOwnerSlotIds[row]
        let sourceSlotId = sidecar.sourcePlaceSlotIds[row]
        if targetSlotId < 0 ||
           targetSlotId >= bodyIR.localSlots.len ||
           targetOwnerSlotId < 0 ||
           targetOwnerSlotId >= bodyIR.localSlots.len ||
           sourceSlotId < 0 ||
           sourceSlotId >= bodyIR.localSlots.len ||
           targetOwnerSlotId == sourceSlotId ||
           !bodyIRManualConsumeCallArgumentsValid(
               bodyIR.callSequence[callOrdinal],
               targetOrdinal, sourceOrdinal,
               targetSlotId, sourceSlotId):
            return false
        if targetSlotId == targetOwnerSlotId:
            if bodyIR.localSlots[targetSlotId].placeKind !=
                   BodyPlaceStackValueTag &&
               bodyIR.localSlots[targetSlotId].placeKind !=
                   BodyPlaceParamAddressTag:
                return false
        elif bodyIR.localSlots[targetSlotId].placeKind !=
                 BodyPlaceBorrowAddressTag ||
             bodyIR.localSlots[targetSlotId].auxValue !=
                 targetOwnerSlotId:
            return false
        let targetTypeId =
            sidecar.targetTypeArenaTypeIds[row]
        let sourceTypeId =
            sidecar.sourceTypeArenaTypeIds[row]
        let targetTypeFactRow =
            BodyIRCanonicalTypeFactRow(bodyIR, targetTypeId)
        let sourceTypeFactRow =
            BodyIRCanonicalTypeFactRow(bodyIR, sourceTypeId)
        if targetTypeId < 0 || sourceTypeId < 0 ||
           targetTypeFactRow < 0 ||
           sourceTypeFactRow < 0 ||
           bodyIR.typeFactChildTypeIds[targetTypeFactRow] !=
               sourceTypeId ||
           bodyIR.localSlots[targetOwnerSlotId].typeArenaTypeId !=
               sourceTypeId ||
           bodyIR.localSlots[targetSlotId].typeArenaTypeId !=
               sourceTypeId ||
           bodyIR.localSlots[sourceSlotId].typeArenaTypeId !=
               sourceTypeId ||
           bodyIR.localSlots[targetOwnerSlotId].managedStorageKind !=
               BodyManagedStorageManagedTag ||
           bodyIR.localSlots[targetSlotId].managedStorageKind !=
               BodyManagedStorageManagedTag ||
           bodyIR.localSlots[sourceSlotId].managedStorageKind !=
               BodyManagedStorageManagedTag ||
           (bodyIR.entryDefinitionOwnershipKinds[
                targetOwnerSlotId] != int32(OwnMove) &&
            bodyIR.entryDefinitionOwnershipKinds[
                targetOwnerSlotId] != int32(OwnBorrowUnique)) ||
           !bodyIRManualConsumeDefinitionRefValid(
               bodyIR, row, targetOwnerSlotId,
               sidecar.targetDefinitionDomains[row],
               sidecar.targetDefinitionRows[row],
               false) ||
           !bodyIRManualConsumeDefinitionRefValid(
               bodyIR, row, sourceSlotId,
               sidecar.sourceDefinitionDomains[row],
               sidecar.sourceDefinitionRows[row],
               true) ||
           (sidecar.targetDefinitionDomains[row] ==
                sidecar.sourceDefinitionDomains[row] &&
            sidecar.targetDefinitionRows[row] ==
                sidecar.sourceDefinitionRows[row]) ||
           sidecar.postDefinitionDomains[row] !=
               BodyDefinitionDomainManualConsumePostCallTag ||
           sidecar.postDefinitionRows[row] != row ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.targetArgumentBindingCids[row]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.sourceArgumentBindingCids[row]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.targetProjectionCids[row]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.sourceProjectionCids[row]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.effectCids[row]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.linearTokenCids[row]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.bridgeCids[row]):
            return false
        for priorRow in 0..<row:
            if sidecar.callOrdinals[priorRow] == callOrdinal ||
               sidecar.snapshotCallIds[priorRow] ==
                   sidecar.snapshotCallIds[row] ||
               bodyIR.callSequence[
                   sidecar.callOrdinals[
                       priorRow]].semanticCallExprNodeIndex ==
                   bodyIR.callSequence[
                       callOrdinal].semanticCallExprNodeIndex ||
               (sidecar.targetDefinitionDomains[priorRow] ==
                    sidecar.targetDefinitionDomains[row] &&
                sidecar.targetDefinitionRows[priorRow] ==
                    sidecar.targetDefinitionRows[row]) ||
               (sidecar.sourceDefinitionDomains[priorRow] ==
                    sidecar.targetDefinitionDomains[row] &&
                sidecar.sourceDefinitionRows[priorRow] ==
                    sidecar.targetDefinitionRows[row]) ||
               (sidecar.targetDefinitionDomains[priorRow] ==
                    sidecar.sourceDefinitionDomains[row] &&
                sidecar.targetDefinitionRows[priorRow] ==
                    sidecar.sourceDefinitionRows[row]) ||
               (sidecar.sourceDefinitionDomains[priorRow] ==
                    sidecar.sourceDefinitionDomains[row] &&
                sidecar.sourceDefinitionRows[priorRow] ==
                    sidecar.sourceDefinitionRows[row]) ||
               layout.FixedBytes32Equal(
                   sidecar.linearTokenCids[priorRow],
                   sidecar.linearTokenCids[row]) ||
               layout.FixedBytes32Equal(
                   sidecar.bridgeCids[priorRow],
                   sidecar.bridgeCids[row]):
                return false
    return true

@borrows
fn bodyIRManualConsumeSidecarCidExact(
        bodyIR: BodyIR,
        sidecar: BodyIRManualConsumeSidecar): layout.FixedBytes32 =
    if !sidecar.sealed ||
       (!sidecar.functionPresent &&
        sidecar.callOrdinals.len == 0) ||
       !BodyIRLocalBindingValueDefinitionRowsShapeValid(bodyIR) ||
       !bodyIRManualConsumeFunctionShapeValid(bodyIR, sidecar) ||
       !bodyIRManualConsumeRowsShapeValid(bodyIR, sidecar):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(512)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.manual_consume.sidecar.current")
    layout.ByteBufAppendFixed32(buf, bodyIR.typeArenaArtifactCid)
    bodyIRControlActionAppendI32(
        buf,
        if bodyIR.entryDefinitionOwnershipSealed: 1 else: 0)
    bodyIRControlActionAppendI32(
        buf, bodyIR.entryDefinitionOwnershipKinds.len)
    for row in 0..<bodyIR.entryDefinitionOwnershipKinds.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.entryDefinitionOwnershipKinds[row])
        bodyIRControlActionAppendI32(
            buf, bodyIR.entryDefinitionSemanticRows[row])
    bodyIRControlActionAppendI32(
        buf, bodyIR.entryParameterSlotIds.len)
    for row in 0..<bodyIR.entryParameterSlotIds.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.entryParameterSlotIds[row])
    bodyIRControlActionAppendI32(
        buf, bodyIR.localBindingValueDefinitionDomainStart)
    bodyIRControlActionAppendI32(
        buf, bodyIR.localBindingValueDefinitionDomainCount)
    bodyIRControlActionAppendI32(
        buf, bodyIR.localBindingValueDefinitionRows.len)
    for slotId in 0..<bodyIR.localBindingValueDefinitionRows.len:
        bodyIRControlActionAppendI32(
            buf, bodyIR.localBindingValueDefinitionRows[slotId])
    bodyIRControlActionAppendI32(buf, bodyIR.controlFunctionRow)
    bodyIRControlActionAppendI32(
        buf, if sidecar.functionPresent: 1 else: 0)
    bodyIRControlActionAppendI32(buf, sidecar.functionRow)
    bodyIRControlActionAppendI32(
        buf, sidecar.functionTargetParameterOrdinal)
    bodyIRControlActionAppendI32(
        buf, sidecar.functionSourceParameterOrdinal)
    bodyIRControlActionAppendI32(
        buf, sidecar.functionTargetSlotId)
    bodyIRControlActionAppendI32(
        buf, sidecar.functionSourceSlotId)
    bodyIRControlActionAppendI32(
        buf, sidecar.functionTargetTypeArenaTypeId)
    bodyIRControlActionAppendI32(
        buf, sidecar.functionSourceTypeArenaTypeId)
    layout.ByteBufAppendFixed32(buf, sidecar.functionEffectCid)
    layout.ByteBufAppendFixed32(
        buf, sidecar.functionBodyProofCid)
    bodyIRControlActionAppendI32(buf, sidecar.callOrdinals.len)
    for row in 0..<sidecar.callOrdinals.len:
        let callOrdinal = sidecar.callOrdinals[row]
        bodyIRControlActionAppendI32(buf, callOrdinal)
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotCallIds[row])
        bodyIRControlActionAppendI32(
            buf,
            bodyIR.callSequence[
                callOrdinal].semanticCallExprNodeIndex)
        bodyIRControlActionAppendI32(
            buf, bodyIR.callTargetDomainKinds[callOrdinal])
        bodyIRControlActionAppendI32(
            buf, bodyIR.callTargetRows[callOrdinal])
        layout.ByteBufAppendFixed32(
            buf, bodyIR.callTargetInterfaceCids[callOrdinal])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetArgumentOrdinals[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceArgumentOrdinals[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetPlaceSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetOwnerSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourcePlaceSlotIds[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.targetArgumentBindingCids[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.sourceArgumentBindingCids[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.targetProjectionCids[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.sourceProjectionCids[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetDefinitionRows[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceDefinitionRows[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetTypeArenaTypeIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.sourceTypeArenaTypeIds[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.postDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, sidecar.postDefinitionRows[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.effectCids[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.linearTokenCids[row])
        layout.ByteBufAppendFixed32(
            buf, sidecar.bridgeCids[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRManualConsumeSidecarCid(
        bodyIR: BodyIR): layout.FixedBytes32 =
    return bodyIRManualConsumeSidecarCidExact(
        bodyIR, bodyIR.manualConsume)

@borrows
fn BodyIRManualConsumeSidecarShapeValid(
        bodyIR: BodyIR): bool =
    if !BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        return false
    if !bodyIR.manualConsume.sealed:
        return BodyIRManualConsumeSidecarIsCanonicalEmpty(
            bodyIR.manualConsume)
    if !bodyIRManualConsumeFunctionShapeValid(
           bodyIR, bodyIR.manualConsume) ||
       !bodyIRManualConsumeRowsShapeValid(
           bodyIR, bodyIR.manualConsume) ||
       (!bodyIR.manualConsume.functionPresent &&
        bodyIR.manualConsume.callOrdinals.len == 0) ||
       !BodyIRTypeArenaArtifactCidValid(
           bodyIR.manualConsume.rootCid):
        return false
    return layout.FixedBytes32Equal(
        bodyIR.manualConsume.rootCid,
        BodyIRManualConsumeSidecarCid(bodyIR))

@borrows
fn BodyIRManualConsumeExactValidateAgainst(
        bodyIR: BodyIR,
        expectedRootCid: layout.FixedBytes32): bool =
    return bodyIR.manualConsume.sealed &&
           bodyIR.manualConsume.callOrdinals.len > 0 &&
           BodyIRTypeArenaArtifactCidValid(
               expectedRootCid) &&
           BodyIRManualConsumeSidecarShapeValid(bodyIR) &&
           layout.FixedBytes32Equal(
               bodyIR.manualConsume.rootCid,
               expectedRootCid)

fn BodyIRManualConsumeSeal(bodyIR: var BodyIR) =
    if bodyIR.manualConsume.sealed ||
       (!bodyIR.manualConsume.functionPresent &&
        bodyIR.manualConsume.callOrdinals.len == 0):
        panic("body ir manual consume: seal state invalid")
    bodyIR.manualConsume.sealed = true
    let rootCid = BodyIRManualConsumeSidecarCid(bodyIR)
    if !BodyIRTypeArenaArtifactCidValid(rootCid):
        bodyIR.manualConsume.sealed = false
        panic("body ir manual consume: effect shape invalid")
    bodyIR.manualConsume.rootCid = rootCid
    if !BodyIRManualConsumeSidecarShapeValid(bodyIR):
        panic("body ir manual consume: sealed root invalid")

fn BodyIRExternFfiHandleCapabilitySidecarNew(): BodyIRExternFfiHandleCapabilitySidecar =
    var out: BodyIRExternFfiHandleCapabilitySidecar
    # wall69: 大结构构造器逐字段显式落定。seq 用描述符直写
    # (len=0/cap=0/buffer=nil, 纯 store 无 rc 语义)——「= []」空列赋值带
    # release 旧值语义, 对未初始化槽=release 垃圾描述符, 与栈复用残留叠加
    # 即误释放真实堆块 (cold_nested 编译期 use-after-free 实证)。
    out.sealed = false
    out.snapshotProjectionAuthorityCid = layout.FixedBytes32()
    out.semanticCargoCid = layout.FixedBytes32()
    out.loweringBridgeCid = layout.FixedBytes32()
    out.callOrdinals.len = 0
    out.callOrdinals.cap = 0
    out.callOrdinals.buffer = nil
    out.callBodyOpRows.len = 0
    out.callBodyOpRows.cap = 0
    out.callBodyOpRows.buffer = nil
    out.semanticCapabilityCallRows.len = 0
    out.semanticCapabilityCallRows.cap = 0
    out.semanticCapabilityCallRows.buffer = nil
    out.resolvedCallRows.len = 0
    out.resolvedCallRows.cap = 0
    out.resolvedCallRows.buffer = nil
    out.snapshotCallIds.len = 0
    out.snapshotCallIds.cap = 0
    out.snapshotCallIds.buffer = nil
    out.semanticContractRows.len = 0
    out.semanticContractRows.cap = 0
    out.semanticContractRows.buffer = nil
    out.snapshotContractRows.len = 0
    out.snapshotContractRows.cap = 0
    out.snapshotContractRows.buffer = nil
    out.semanticEffectStarts.len = 0
    out.semanticEffectStarts.cap = 0
    out.semanticEffectStarts.buffer = nil
    out.effectStarts.len = 0
    out.effectStarts.cap = 0
    out.effectStarts.buffer = nil
    out.effectCounts.len = 0
    out.effectCounts.cap = 0
    out.effectCounts.buffer = nil
    out.callCapabilityCids.len = 0
    out.callCapabilityCids.cap = 0
    out.callCapabilityCids.buffer = nil
    out.contractCids.len = 0
    out.contractCids.cap = 0
    out.contractCids.buffer = nil
    out.interfaceCids.len = 0
    out.interfaceCids.cap = 0
    out.interfaceCids.buffer = nil
    out.callBridgeCids.len = 0
    out.callBridgeCids.cap = 0
    out.callBridgeCids.buffer = nil
    out.semanticCapabilityEffectRows.len = 0
    out.semanticCapabilityEffectRows.cap = 0
    out.semanticCapabilityEffectRows.buffer = nil
    out.contractEffectRows.len = 0
    out.contractEffectRows.cap = 0
    out.contractEffectRows.buffer = nil
    out.snapshotEffectRows.len = 0
    out.snapshotEffectRows.cap = 0
    out.snapshotEffectRows.buffer = nil
    out.snapshotEffectContractRows.len = 0
    out.snapshotEffectContractRows.cap = 0
    out.snapshotEffectContractRows.buffer = nil
    out.effectKinds.len = 0
    out.effectKinds.cap = 0
    out.effectKinds.buffer = nil
    out.targetKinds.len = 0
    out.targetKinds.cap = 0
    out.targetKinds.buffer = nil
    out.parameterOrdinals.len = 0
    out.parameterOrdinals.cap = 0
    out.parameterOrdinals.buffer = nil
    out.argumentRows.len = 0
    out.argumentRows.cap = 0
    out.argumentRows.buffer = nil
    out.argumentSlotIds.len = 0
    out.argumentSlotIds.cap = 0
    out.argumentSlotIds.buffer = nil
    out.argumentValueNodeIndexes.len = 0
    out.argumentValueNodeIndexes.cap = 0
    out.argumentValueNodeIndexes.buffer = nil
    out.valueDefinitionRows.len = 0
    out.valueDefinitionRows.cap = 0
    out.valueDefinitionRows.buffer = nil
    out.generationRootValueDefinitionRows.len = 0
    out.generationRootValueDefinitionRows.cap = 0
    out.generationRootValueDefinitionRows.buffer = nil
    out.exactTypeIds.len = 0
    out.exactTypeIds.cap = 0
    out.exactTypeIds.buffer = nil
    out.carrierKinds.len = 0
    out.carrierKinds.cap = 0
    out.carrierKinds.buffer = nil
    out.argumentBindingCids.len = 0
    out.argumentBindingCids.cap = 0
    out.argumentBindingCids.buffer = nil
    out.typeCids.len = 0
    out.typeCids.cap = 0
    out.typeCids.buffer = nil
    out.generationCids.len = 0
    out.generationCids.cap = 0
    out.generationCids.buffer = nil
    out.definitionLineageCids.len = 0
    out.definitionLineageCids.cap = 0
    out.definitionLineageCids.buffer = nil
    out.effectCapabilityCids.len = 0
    out.effectCapabilityCids.cap = 0
    out.effectCapabilityCids.buffer = nil
    out.contractEffectCids.len = 0
    out.contractEffectCids.cap = 0
    out.contractEffectCids.buffer = nil
    out.effectBridgeCids.len = 0
    out.effectBridgeCids.cap = 0
    out.effectBridgeCids.buffer = nil
    out.rootCid = layout.FixedBytes32()
    return out
@borrows
fn bodyIRExternFfiHandleCapabilityCallRowsAligned(
        sidecar: BodyIRExternFfiHandleCapabilitySidecar): bool =
    let rowCount = sidecar.callOrdinals.len
    return sidecar.callBodyOpRows.len == rowCount &&
           sidecar.semanticCapabilityCallRows.len == rowCount &&
           sidecar.resolvedCallRows.len == rowCount &&
           sidecar.snapshotCallIds.len == rowCount &&
           sidecar.semanticContractRows.len == rowCount &&
           sidecar.snapshotContractRows.len == rowCount &&
           sidecar.semanticEffectStarts.len == rowCount &&
           sidecar.effectStarts.len == rowCount &&
           sidecar.effectCounts.len == rowCount &&
           sidecar.callCapabilityCids.len == rowCount &&
           sidecar.contractCids.len == rowCount &&
           sidecar.interfaceCids.len == rowCount &&
           sidecar.callBridgeCids.len == rowCount

@borrows
fn bodyIRExternFfiHandleCapabilityEffectRowsAligned(
        sidecar: BodyIRExternFfiHandleCapabilitySidecar): bool =
    let rowCount = sidecar.semanticCapabilityEffectRows.len
    return sidecar.contractEffectRows.len == rowCount &&
           sidecar.snapshotEffectRows.len == rowCount &&
           sidecar.snapshotEffectContractRows.len == rowCount &&
           sidecar.effectKinds.len == rowCount &&
           sidecar.targetKinds.len == rowCount &&
           sidecar.parameterOrdinals.len == rowCount &&
           sidecar.argumentRows.len == rowCount &&
           sidecar.argumentSlotIds.len == rowCount &&
           sidecar.argumentValueNodeIndexes.len == rowCount &&
           sidecar.valueDefinitionRows.len == rowCount &&
           sidecar.generationRootValueDefinitionRows.len == rowCount &&
           sidecar.exactTypeIds.len == rowCount &&
           sidecar.carrierKinds.len == rowCount &&
           sidecar.argumentBindingCids.len == rowCount &&
           sidecar.typeCids.len == rowCount &&
           sidecar.generationCids.len == rowCount &&
           sidecar.definitionLineageCids.len == rowCount &&
           sidecar.effectCapabilityCids.len == rowCount &&
           sidecar.contractEffectCids.len == rowCount &&
           sidecar.effectBridgeCids.len == rowCount

@borrows
fn BodyIRExternFfiHandleCapabilitySidecarHasPhysicalStorage(
        sidecar: BodyIRExternFfiHandleCapabilitySidecar): bool =
    return sidecar.callOrdinals.cap > 0 ||
           sidecar.callBodyOpRows.cap > 0 ||
           sidecar.semanticCapabilityCallRows.cap > 0 ||
           sidecar.resolvedCallRows.cap > 0 ||
           sidecar.snapshotCallIds.cap > 0 ||
           sidecar.semanticContractRows.cap > 0 ||
           sidecar.snapshotContractRows.cap > 0 ||
           sidecar.semanticEffectStarts.cap > 0 ||
           sidecar.effectStarts.cap > 0 ||
           sidecar.effectCounts.cap > 0 ||
           sidecar.callCapabilityCids.cap > 0 ||
           sidecar.contractCids.cap > 0 ||
           sidecar.interfaceCids.cap > 0 ||
           sidecar.callBridgeCids.cap > 0 ||
           sidecar.semanticCapabilityEffectRows.cap > 0 ||
           sidecar.contractEffectRows.cap > 0 ||
           sidecar.snapshotEffectRows.cap > 0 ||
           sidecar.snapshotEffectContractRows.cap > 0 ||
           sidecar.effectKinds.cap > 0 ||
           sidecar.targetKinds.cap > 0 ||
           sidecar.parameterOrdinals.cap > 0 ||
           sidecar.argumentRows.cap > 0 ||
           sidecar.argumentSlotIds.cap > 0 ||
           sidecar.argumentValueNodeIndexes.cap > 0 ||
           sidecar.valueDefinitionRows.cap > 0 ||
           sidecar.generationRootValueDefinitionRows.cap > 0 ||
           sidecar.exactTypeIds.cap > 0 ||
           sidecar.carrierKinds.cap > 0 ||
           sidecar.argumentBindingCids.cap > 0 ||
           sidecar.typeCids.cap > 0 ||
           sidecar.generationCids.cap > 0 ||
           sidecar.definitionLineageCids.cap > 0 ||
           sidecar.effectCapabilityCids.cap > 0 ||
           sidecar.contractEffectCids.cap > 0 ||
           sidecar.effectBridgeCids.cap > 0

@borrows
fn BodyIRExternFfiHandleCapabilitySidecarIsCanonicalEmpty(
        sidecar: BodyIRExternFfiHandleCapabilitySidecar): bool =
    return !sidecar.sealed && sidecar.functionRow == -1 &&
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.snapshotProjectionAuthorityCid) &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.semanticCargoCid) &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.loweringBridgeCid) &&
           sidecar.callOrdinals.len == 0 &&
           sidecar.semanticCapabilityEffectRows.len == 0 &&
           bodyIRExternFfiHandleCapabilityCallRowsAligned(sidecar) &&
           bodyIRExternFfiHandleCapabilityEffectRowsAligned(sidecar) &&
           !BodyIRTypeArenaArtifactCidValid(sidecar.rootCid) &&
           !BodyIRExternFfiHandleCapabilitySidecarHasPhysicalStorage(
               sidecar)

fn BodyIRExternFfiHandleCapabilitySidecarMoveInto(
        out: var BodyIRExternFfiHandleCapabilitySidecar,
        sidecar: var BodyIRExternFfiHandleCapabilitySidecar) =
    if !BodyIRExternFfiHandleCapabilitySidecarIsCanonicalEmpty(out) ||
       !bodyIRExternFfiHandleCapabilityCallRowsAligned(sidecar) ||
       !bodyIRExternFfiHandleCapabilityEffectRowsAligned(sidecar):
        panic("body ir ffi handle capability: move shape invalid")
    out.sealed = sidecar.sealed
    out.functionRow = sidecar.functionRow
    out.snapshotProjectionAuthorityCid =
        sidecar.snapshotProjectionAuthorityCid
    out.semanticCargoCid = sidecar.semanticCargoCid
    out.loweringBridgeCid = sidecar.loweringBridgeCid
    out.callOrdinals = sidecar.callOrdinals
    out.callBodyOpRows = sidecar.callBodyOpRows
    out.semanticCapabilityCallRows =
        sidecar.semanticCapabilityCallRows
    out.resolvedCallRows = sidecar.resolvedCallRows
    out.snapshotCallIds = sidecar.snapshotCallIds
    out.semanticContractRows = sidecar.semanticContractRows
    out.snapshotContractRows = sidecar.snapshotContractRows
    out.semanticEffectStarts = sidecar.semanticEffectStarts
    out.effectStarts = sidecar.effectStarts
    out.effectCounts = sidecar.effectCounts
    out.callCapabilityCids = sidecar.callCapabilityCids
    out.contractCids = sidecar.contractCids
    out.interfaceCids = sidecar.interfaceCids
    out.callBridgeCids = sidecar.callBridgeCids
    out.semanticCapabilityEffectRows =
        sidecar.semanticCapabilityEffectRows
    out.contractEffectRows = sidecar.contractEffectRows
    out.snapshotEffectRows = sidecar.snapshotEffectRows
    out.snapshotEffectContractRows =
        sidecar.snapshotEffectContractRows
    out.effectKinds = sidecar.effectKinds
    out.targetKinds = sidecar.targetKinds
    out.parameterOrdinals = sidecar.parameterOrdinals
    out.argumentRows = sidecar.argumentRows
    out.argumentSlotIds = sidecar.argumentSlotIds
    out.argumentValueNodeIndexes =
        sidecar.argumentValueNodeIndexes
    out.valueDefinitionRows = sidecar.valueDefinitionRows
    out.generationRootValueDefinitionRows =
        sidecar.generationRootValueDefinitionRows
    out.exactTypeIds = sidecar.exactTypeIds
    out.carrierKinds = sidecar.carrierKinds
    out.argumentBindingCids = sidecar.argumentBindingCids
    out.typeCids = sidecar.typeCids
    out.generationCids = sidecar.generationCids
    out.definitionLineageCids = sidecar.definitionLineageCids
    out.effectCapabilityCids = sidecar.effectCapabilityCids
    out.contractEffectCids = sidecar.contractEffectCids
    out.effectBridgeCids = sidecar.effectBridgeCids
    out.rootCid = sidecar.rootCid
    sidecar = BodyIRExternFfiHandleCapabilitySidecarNew()

fn BodyIRExternFfiHandleCapabilityBegin(
        bodyIR: var BodyIR,
        functionRow: int32,
        snapshotProjectionAuthorityCid: layout.FixedBytes32,
        semanticCargoCid: layout.FixedBytes32,
        loweringBridgeCid: layout.FixedBytes32) =
    if !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.controlFunctionRow != functionRow ||
       functionRow < 0 ||
       !BodyIRExternFfiHandleCapabilitySidecarIsCanonicalEmpty(
           bodyIR.externFfiHandleCapabilities) ||
       !BodyIRTypeArenaArtifactCidValid(
           snapshotProjectionAuthorityCid) ||
       !BodyIRTypeArenaArtifactCidValid(semanticCargoCid) ||
       !BodyIRTypeArenaArtifactCidValid(loweringBridgeCid):
        panic("body ir ffi handle capability: begin state invalid")
    bodyIR.externFfiHandleCapabilities.functionRow = functionRow
    bodyIR.externFfiHandleCapabilities.
        snapshotProjectionAuthorityCid =
            layout.FixedBytes32Copy(snapshotProjectionAuthorityCid)
    bodyIR.externFfiHandleCapabilities.semanticCargoCid =
        layout.FixedBytes32Copy(semanticCargoCid)
    bodyIR.externFfiHandleCapabilities.loweringBridgeCid =
        layout.FixedBytes32Copy(loweringBridgeCid)

fn BodyIRExternFfiHandleCapabilityAppendCall(
        bodyIR: var BodyIR,
        capability: BodyIRExternFfiHandleCallCapability) =
    let callBodyOpRow =
        BodyIRUniqueCallBodyOpRow(
            bodyIR, capability.callOrdinal)
    if !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.externFfiHandleCapabilities.sealed ||
       bodyIR.externFfiHandleCapabilities.functionRow < 0 ||
       capability.callOrdinal < 0 ||
       capability.callOrdinal >= bodyIR.callSequence.len ||
       capability.semanticCapabilityCallRow < 0 ||
       capability.resolvedCallRow < 0 ||
       capability.snapshotCallId < 0 ||
       capability.semanticContractRow < 0 ||
       capability.snapshotContractRow < 0 ||
       capability.semanticEffectStart < 0 ||
       capability.effectCount <= 0 ||
       callBodyOpRow < 0 ||
       !BodyIRTypeArenaArtifactCidValid(
           capability.callCapabilityCid) ||
       !BodyIRTypeArenaArtifactCidValid(capability.contractCid) ||
       !BodyIRTypeArenaArtifactCidValid(capability.interfaceCid) ||
       !BodyIRTypeArenaArtifactCidValid(capability.callBridgeCid):
        panic("body ir ffi handle capability: call row invalid")
    let rowCount =
        bodyIR.externFfiHandleCapabilities.callOrdinals.len
    if rowCount > 0 &&
       (capability.callOrdinal <=
            bodyIR.externFfiHandleCapabilities.callOrdinals[
                rowCount - 1] ||
        capability.semanticCapabilityCallRow <=
            bodyIR.externFfiHandleCapabilities.
                semanticCapabilityCallRows[rowCount - 1]):
        panic("body ir ffi handle capability: call order invalid")
    add(bodyIR.externFfiHandleCapabilities.callOrdinals,
        capability.callOrdinal)
    add(bodyIR.externFfiHandleCapabilities.callBodyOpRows,
        callBodyOpRow)
    add(bodyIR.externFfiHandleCapabilities.semanticCapabilityCallRows,
        capability.semanticCapabilityCallRow)
    add(bodyIR.externFfiHandleCapabilities.resolvedCallRows,
        capability.resolvedCallRow)
    add(bodyIR.externFfiHandleCapabilities.snapshotCallIds,
        capability.snapshotCallId)
    add(bodyIR.externFfiHandleCapabilities.semanticContractRows,
        capability.semanticContractRow)
    add(bodyIR.externFfiHandleCapabilities.snapshotContractRows,
        capability.snapshotContractRow)
    add(bodyIR.externFfiHandleCapabilities.semanticEffectStarts,
        capability.semanticEffectStart)
    add(bodyIR.externFfiHandleCapabilities.effectStarts,
        bodyIR.externFfiHandleCapabilities.
            semanticCapabilityEffectRows.len)
    add(bodyIR.externFfiHandleCapabilities.effectCounts,
        capability.effectCount)
    add(bodyIR.externFfiHandleCapabilities.callCapabilityCids,
        layout.FixedBytes32Copy(capability.callCapabilityCid))
    add(bodyIR.externFfiHandleCapabilities.contractCids,
        layout.FixedBytes32Copy(capability.contractCid))
    add(bodyIR.externFfiHandleCapabilities.interfaceCids,
        layout.FixedBytes32Copy(capability.interfaceCid))
    add(bodyIR.externFfiHandleCapabilities.callBridgeCids,
        layout.FixedBytes32Copy(capability.callBridgeCid))

fn BodyIRExternFfiHandleCapabilityAppendEffect(
        bodyIR: var BodyIR,
        capability: BodyIRExternFfiHandleEffectCapability) =
    let callRow =
        bodyIR.externFfiHandleCapabilities.callOrdinals.len - 1
    if !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.externFfiHandleCapabilities.sealed || callRow < 0:
        panic("body ir ffi handle capability: effect owner missing")
    let effectOffset =
        bodyIR.externFfiHandleCapabilities.semanticCapabilityEffectRows.len -
            bodyIR.externFfiHandleCapabilities.effectStarts[callRow]
    let expectedSemanticEffectRow =
        bodyIR.externFfiHandleCapabilities.semanticEffectStarts[callRow] +
            effectOffset
    let expectedSnapshotContractRow =
        bodyIR.externFfiHandleCapabilities.snapshotContractRows[callRow]
    let typeCidOk = BodyIRTypeArenaArtifactCidValid(capability.typeCid)
    let generationCidOk =
        BodyIRTypeArenaArtifactCidValid(capability.generationCid)
    let lineageCidOk =
        BodyIRTypeArenaArtifactCidValid(capability.definitionLineageCid)
    let effectCapabilityCidOk =
        BodyIRTypeArenaArtifactCidValid(capability.effectCapabilityCid)
    let contractEffectCidOk =
        BodyIRTypeArenaArtifactCidValid(capability.contractEffectCid)
    let effectBridgeCidOk =
        BodyIRTypeArenaArtifactCidValid(capability.effectBridgeCid)
    if effectOffset < 0 ||
       effectOffset >=
           bodyIR.externFfiHandleCapabilities.effectCounts[callRow] ||
       capability.semanticCapabilityEffectRow !=
           expectedSemanticEffectRow ||
       capability.contractEffectRow < 0 ||
       capability.snapshotEffectRow < 0 ||
       capability.snapshotEffectContractRow !=
           expectedSnapshotContractRow ||
       capability.argumentSlotId < 0 ||
       capability.argumentSlotId >= bodyIR.localSlots.len ||
       capability.argumentValueNodeIndex < 0 ||
       capability.valueDefinitionRow < 0 ||
       capability.generationRootValueDefinitionRow < 0 ||
       capability.generationRootValueDefinitionRow >
           capability.valueDefinitionRow ||
       capability.exactTypeId < 0 ||
       !typeCidOk ||
       !generationCidOk ||
       !lineageCidOk ||
       !effectCapabilityCidOk ||
       !contractEffectCidOk ||
       !effectBridgeCidOk:
        panic("body ir ffi handle capability: effect row invalid")
    add(bodyIR.externFfiHandleCapabilities.semanticCapabilityEffectRows,
        capability.semanticCapabilityEffectRow)
    add(bodyIR.externFfiHandleCapabilities.contractEffectRows,
        capability.contractEffectRow)
    add(bodyIR.externFfiHandleCapabilities.snapshotEffectRows,
        capability.snapshotEffectRow)
    add(bodyIR.externFfiHandleCapabilities.snapshotEffectContractRows,
        capability.snapshotEffectContractRow)
    add(bodyIR.externFfiHandleCapabilities.effectKinds,
        capability.effectKind)
    add(bodyIR.externFfiHandleCapabilities.targetKinds,
        capability.targetKind)
    add(bodyIR.externFfiHandleCapabilities.parameterOrdinals,
        capability.parameterOrdinal)
    add(bodyIR.externFfiHandleCapabilities.argumentRows,
        capability.argumentRow)
    add(bodyIR.externFfiHandleCapabilities.argumentSlotIds,
        capability.argumentSlotId)
    add(bodyIR.externFfiHandleCapabilities.argumentValueNodeIndexes,
        capability.argumentValueNodeIndex)
    add(bodyIR.externFfiHandleCapabilities.valueDefinitionRows,
        capability.valueDefinitionRow)
    add(bodyIR.externFfiHandleCapabilities.generationRootValueDefinitionRows,
        capability.generationRootValueDefinitionRow)
    add(bodyIR.externFfiHandleCapabilities.exactTypeIds,
        capability.exactTypeId)
    add(bodyIR.externFfiHandleCapabilities.carrierKinds,
        capability.carrierKind)
    add(bodyIR.externFfiHandleCapabilities.argumentBindingCids,
        layout.FixedBytes32Copy(capability.argumentBindingCid))
    add(bodyIR.externFfiHandleCapabilities.typeCids,
        layout.FixedBytes32Copy(capability.typeCid))
    add(bodyIR.externFfiHandleCapabilities.generationCids,
        layout.FixedBytes32Copy(capability.generationCid))
    add(bodyIR.externFfiHandleCapabilities.definitionLineageCids,
        layout.FixedBytes32Copy(capability.definitionLineageCid))
    add(bodyIR.externFfiHandleCapabilities.effectCapabilityCids,
        layout.FixedBytes32Copy(capability.effectCapabilityCid))
    add(bodyIR.externFfiHandleCapabilities.contractEffectCids,
        layout.FixedBytes32Copy(capability.contractEffectCid))
    add(bodyIR.externFfiHandleCapabilities.effectBridgeCids,
        layout.FixedBytes32Copy(capability.effectBridgeCid))

@borrows
fn bodyIRExternFfiHandleCapabilityRowsShapeValid(
        bodyIR: BodyIR,
        sidecar: BodyIRExternFfiHandleCapabilitySidecar): bool =
    if !bodyIRExternFfiHandleCapabilityCallRowsAligned(sidecar) ||
       !bodyIRExternFfiHandleCapabilityEffectRowsAligned(sidecar) ||
       sidecar.functionRow != bodyIR.controlFunctionRow ||
       sidecar.functionRow < 0 ||
       !bodyIR.controlFlowSealed ||
       !BodyIRControlFlowShapeValid(bodyIR) ||
       !BodyIRTypeArenaProofDomainValid(bodyIR) ||
       !BodyIRTypeArenaArtifactCidValid(
           sidecar.snapshotProjectionAuthorityCid) ||
       !BodyIRTypeArenaArtifactCidValid(sidecar.semanticCargoCid) ||
       !BodyIRTypeArenaArtifactCidValid(sidecar.loweringBridgeCid) ||
       sidecar.callOrdinals.len <= 0:
        return false
    var effectCursor: int32
    var previousCallOrdinal: int32 = -1
    var previousCapabilityCallRow: int32 = -1
    for callRow in 0..<sidecar.callOrdinals.len:
        let callOrdinal = sidecar.callOrdinals[callRow]
        let callBodyOpRow = sidecar.callBodyOpRows[callRow]
        if callOrdinal <= previousCallOrdinal ||
           callOrdinal >= bodyIR.callSequence.len ||
           callBodyOpRow < 0 ||
           callBodyOpRow >= bodyIR.ops.len ||
           callBodyOpRow !=
               BodyIRUniqueCallBodyOpRow(bodyIR, callOrdinal) ||
           bodyIR.ops[callBodyOpRow].kind != BodyOpCallTag ||
           bodyIR.ops[callBodyOpRow].operands.len != 1 ||
           bodyIR.ops[callBodyOpRow].operands[0] != callOrdinal ||
           callOrdinal >= bodyIR.callTargetDomainKinds.len ||
           callOrdinal >= bodyIR.callTargetRows.len ||
           callOrdinal >= bodyIR.callTargetInterfaceCids.len ||
           sidecar.semanticCapabilityCallRows[callRow] <=
               previousCapabilityCallRow ||
           sidecar.resolvedCallRows[callRow] < 0 ||
           sidecar.snapshotCallIds[callRow] < 0 ||
           sidecar.semanticContractRows[callRow] < 0 ||
           sidecar.snapshotContractRows[callRow] < 0 ||
           sidecar.semanticEffectStarts[callRow] < 0 ||
           sidecar.effectStarts[callRow] != effectCursor ||
           sidecar.effectCounts[callRow] <= 0 ||
           sidecar.effectCounts[callRow] >
               sidecar.semanticCapabilityEffectRows.len - effectCursor ||
           bodyIR.callTargetDomainKinds[callOrdinal] !=
               BodyCallTargetDomainExternFunctionTag ||
           bodyIR.callTargetRows[callOrdinal] < 0 ||
           !BodyIRTypeArenaArtifactCidValid(
               bodyIR.callTargetInterfaceCids[callOrdinal]) ||
           bodyIR.callSequence[callOrdinal].semanticCallExprNodeIndex < 0 ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.callCapabilityCids[callRow]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.contractCids[callRow]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.interfaceCids[callRow]) ||
           !BodyIRTypeArenaArtifactCidValid(
               sidecar.callBridgeCids[callRow]):
            return false
        previousCallOrdinal = callOrdinal
        previousCapabilityCallRow =
            sidecar.semanticCapabilityCallRows[callRow]
        var previousParameterOrdinal: int32 = -1
        var previousContractEffectRow: int32 = -1
        var previousSnapshotEffectRow: int32 = -1
        let effectEnd = effectCursor + sidecar.effectCounts[callRow]
        for effectRow in effectCursor..<effectEnd:
            let effectOffset = effectRow - effectCursor
            let argumentSlotId = sidecar.argumentSlotIds[effectRow]
            let exactTypeId = sidecar.exactTypeIds[effectRow]
            let typeFactRow = BodyIRCanonicalTypeFactRow(
                bodyIR, exactTypeId)
            if sidecar.semanticCapabilityEffectRows[effectRow] !=
                   sidecar.semanticEffectStarts[callRow] + effectOffset ||
               sidecar.contractEffectRows[effectRow] <=
                   previousContractEffectRow ||
               sidecar.snapshotEffectRows[effectRow] <=
                   previousSnapshotEffectRow ||
               sidecar.snapshotEffectContractRows[effectRow] !=
                   sidecar.snapshotContractRows[callRow] ||
               argumentSlotId < 0 ||
               argumentSlotId >= bodyIR.localSlots.len ||
               sidecar.argumentValueNodeIndexes[effectRow] < 0 ||
               sidecar.valueDefinitionRows[effectRow] < 0 ||
               sidecar.generationRootValueDefinitionRows[effectRow] < 0 ||
               sidecar.generationRootValueDefinitionRows[effectRow] >
                   sidecar.valueDefinitionRows[effectRow] ||
               exactTypeId < 0 || typeFactRow < 0 ||
               bodyIR.localSlots[argumentSlotId].typeArenaTypeId !=
                   exactTypeId ||
               bodyIR.localSlots[argumentSlotId].managedStorageKind !=
                   BodyManagedStorageUnmanagedTag ||
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.typeCids[effectRow]) ||
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.generationCids[effectRow]) ||
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.definitionLineageCids[effectRow]) ||
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.effectCapabilityCids[effectRow]) ||
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.contractEffectCids[effectRow]) ||
               !BodyIRTypeArenaArtifactCidValid(
                   sidecar.effectBridgeCids[effectRow]):
                return false
            let carrierKind = sidecar.carrierKinds[effectRow]
            let carrierSize =
                carrierKind == BodyExternFfiHandleCarrierUInt32Tag ? 4 :
                carrierKind == BodyExternFfiHandleCarrierUInt64Tag ? 8 : 0
            if carrierSize <= 0 ||
               bodyIR.typeFactSizeBytes[typeFactRow] != carrierSize ||
               bodyIR.localSlots[argumentSlotId].sizeBytes != carrierSize:
                return false
            let targetKind = sidecar.targetKinds[effectRow]
            let effectKind = sidecar.effectKinds[effectRow]
            let parameterOrdinal =
                sidecar.parameterOrdinals[effectRow]
            if targetKind == BodyExternFfiHandleTargetResultTag:
                if effectOffset != 0 ||
                   effectKind != BodyExternFfiHandleEffectProduceTag ||
                   parameterOrdinal != -1 ||
                   sidecar.argumentRows[effectRow] != -1 ||
                   argumentSlotId !=
                       bodyIR.callSequence[callOrdinal].resultSlot ||
                   bodyIR.callSequence[callOrdinal].resultPassKind !=
                       BodyCallPassStackValueTag ||
                   sidecar.argumentValueNodeIndexes[effectRow] !=
                       bodyIR.callSequence[
                           callOrdinal].semanticCallExprNodeIndex ||
                   sidecar.valueDefinitionRows[effectRow] !=
                       sidecar.generationRootValueDefinitionRows[
                           effectRow] ||
                   BodyIRTypeArenaArtifactCidValid(
                       sidecar.argumentBindingCids[effectRow]):
                    return false
            elif targetKind == BodyExternFfiHandleTargetParameterTag:
                if (effectKind != BodyExternFfiHandleEffectBorrowTag &&
                    effectKind != BodyExternFfiHandleEffectConsumeTag) ||
                   parameterOrdinal < 0 ||
                   parameterOrdinal <= previousParameterOrdinal ||
                   parameterOrdinal >=
                       bodyIR.callSequence[callOrdinal].argSlots.len ||
                   parameterOrdinal >=
                       bodyIR.callSequence[callOrdinal].argPassKinds.len ||
                   bodyIR.callSequence[callOrdinal].argPassKinds[
                       parameterOrdinal] != BodyCallPassStackValueTag ||
                   bodyIR.callSequence[callOrdinal].argSlots[
                       parameterOrdinal] != argumentSlotId ||
                   sidecar.argumentRows[effectRow] < 0 ||
                   !BodyIRTypeArenaArtifactCidValid(
                       sidecar.argumentBindingCids[effectRow]):
                    return false
                previousParameterOrdinal = parameterOrdinal
            else:
                return false
            previousContractEffectRow =
                sidecar.contractEffectRows[effectRow]
            previousSnapshotEffectRow =
                sidecar.snapshotEffectRows[effectRow]
            for priorEffectRow in 0..<effectRow:
                if layout.FixedBytes32Equal(
                       sidecar.effectCapabilityCids[priorEffectRow],
                       sidecar.effectCapabilityCids[effectRow]) ||
                   layout.FixedBytes32Equal(
                       sidecar.effectBridgeCids[priorEffectRow],
                       sidecar.effectBridgeCids[effectRow]):
                    return false
        effectCursor = effectEnd
        for priorCallRow in 0..<callRow:
            if layout.FixedBytes32Equal(
                   sidecar.callCapabilityCids[priorCallRow],
                   sidecar.callCapabilityCids[callRow]) ||
               layout.FixedBytes32Equal(
                   sidecar.callBridgeCids[priorCallRow],
                   sidecar.callBridgeCids[callRow]):
                return false
    return effectCursor == sidecar.semanticCapabilityEffectRows.len

@borrows
fn bodyIRExternFfiHandleCapabilitySidecarCidExact(
        bodyIR: BodyIR,
        sidecar: BodyIRExternFfiHandleCapabilitySidecar): layout.FixedBytes32 =
    if !sidecar.sealed ||
       !bodyIRExternFfiHandleCapabilityRowsShapeValid(
           bodyIR, sidecar):
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(
        512 + sidecar.callOrdinals.len * 256 +
            sidecar.semanticCapabilityEffectRows.len * 512)
    bodyIRControlActionAppendText(
        buf,
        "cheng.body_ir.extern_ffi_handle_capability.call_body_op_bound.current")
    layout.ByteBufAppendFixed32(buf, bodyIR.typeArenaArtifactCid)
    bodyIRControlActionAppendI32(buf, sidecar.functionRow)
    layout.ByteBufAppendFixed32(
        buf, sidecar.snapshotProjectionAuthorityCid)
    layout.ByteBufAppendFixed32(buf, sidecar.semanticCargoCid)
    layout.ByteBufAppendFixed32(buf, sidecar.loweringBridgeCid)
    bodyIRControlActionAppendI32(buf, sidecar.callOrdinals.len)
    bodyIRControlActionAppendI32(
        buf, sidecar.semanticCapabilityEffectRows.len)
    for callRow in 0..<sidecar.callOrdinals.len:
        let callOrdinal = sidecar.callOrdinals[callRow]
        let call = bodyIR.callSequence[callOrdinal]
        bodyIRControlActionAppendI32(buf, callOrdinal)
        bodyIRControlActionAppendI32(
            buf, sidecar.callBodyOpRows[callRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.semanticCapabilityCallRows[callRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.resolvedCallRows[callRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotCallIds[callRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.semanticContractRows[callRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotContractRows[callRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.semanticEffectStarts[callRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.effectStarts[callRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.effectCounts[callRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.callCapabilityCids[callRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.contractCids[callRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.interfaceCids[callRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.callBridgeCids[callRow])
        bodyIRControlActionAppendI32(
            buf, bodyIR.callTargetDomainKinds[callOrdinal])
        bodyIRControlActionAppendI32(
            buf, bodyIR.callTargetRows[callOrdinal])
        layout.ByteBufAppendFixed32(
            buf, bodyIR.callTargetInterfaceCids[callOrdinal])
        bodyIRControlActionAppendI32(
            buf, call.semanticCallExprNodeIndex)
        bodyIRControlActionAppendI32(buf, call.resultSlot)
        bodyIRControlActionAppendI32(buf, call.resultPassKind)
        bodyIRControlActionAppendI32(buf, call.argSlots.len)
        for argumentOrdinal in 0..<call.argSlots.len:
            bodyIRControlActionAppendI32(
                buf, call.argSlots[argumentOrdinal])
            bodyIRControlActionAppendI32(
                buf, call.argPassKinds[argumentOrdinal])
    for effectRow in 0..<
            sidecar.semanticCapabilityEffectRows.len:
        bodyIRControlActionAppendI32(
            buf, sidecar.semanticCapabilityEffectRows[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.contractEffectRows[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotEffectRows[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.snapshotEffectContractRows[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.effectKinds[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.targetKinds[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.parameterOrdinals[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.argumentRows[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.argumentSlotIds[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.argumentValueNodeIndexes[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.valueDefinitionRows[effectRow])
        bodyIRControlActionAppendI32(
            buf,
            sidecar.generationRootValueDefinitionRows[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.exactTypeIds[effectRow])
        bodyIRControlActionAppendI32(
            buf, sidecar.carrierKinds[effectRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.argumentBindingCids[effectRow])
        layout.ByteBufAppendFixed32(buf, sidecar.typeCids[effectRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.generationCids[effectRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.definitionLineageCids[effectRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.effectCapabilityCids[effectRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.contractEffectCids[effectRow])
        layout.ByteBufAppendFixed32(
            buf, sidecar.effectBridgeCids[effectRow])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRExternFfiHandleCapabilitySidecarCid(
        bodyIR: BodyIR): layout.FixedBytes32 =
    return bodyIRExternFfiHandleCapabilitySidecarCidExact(
        bodyIR, bodyIR.externFfiHandleCapabilities)

@borrows
fn BodyIRExternFfiHandleCapabilitySidecarShapeValid(
        bodyIR: BodyIR): bool =
    let sidecar = bodyIR.externFfiHandleCapabilities
    if !sidecar.sealed:
        return BodyIRExternFfiHandleCapabilitySidecarIsCanonicalEmpty(
            sidecar)
    if !bodyIRExternFfiHandleCapabilityRowsShapeValid(
           bodyIR, sidecar) ||
       !BodyIRTypeArenaArtifactCidValid(sidecar.rootCid):
        return false
    return layout.FixedBytes32Equal(
        sidecar.rootCid,
        bodyIRExternFfiHandleCapabilitySidecarCidExact(
            bodyIR, sidecar))

fn BodyIRExternFfiHandleCapabilitySeal(bodyIR: var BodyIR) =
    if bodyIR.externFfiHandleCapabilities.sealed ||
       bodyIR.externFfiHandleCapabilities.callOrdinals.len <= 0 ||
       !bodyIRExternFfiHandleCapabilityRowsShapeValid(
           bodyIR, bodyIR.externFfiHandleCapabilities):
        panic("body ir ffi handle capability: seal state invalid")
    bodyIR.externFfiHandleCapabilities.sealed = true
    bodyIR.externFfiHandleCapabilities.rootCid =
        BodyIRExternFfiHandleCapabilitySidecarCid(bodyIR)
    if !BodyIRExternFfiHandleCapabilitySidecarShapeValid(bodyIR):
        panic("body ir ffi handle capability: sealed root invalid")

fn BodyIRPhaseArenaNew(): BodyIRPhaseArena =
    var out: BodyIRPhaseArena
    return out

fn BodyIRPhaseArenaReset(arena: var BodyIRPhaseArena) =
    arena.generation = arena.generation + 1
    arena.resetCount = arena.resetCount + 1
    arena.reserveCount = 0
    arena.capacityBytes = int64(0)
    arena.usedBytes = int64(0)
    arena.peakBytes = int64(0)
    arena.spillCount = 0
    arena.live = false
    arena.lastOpCount = 0
    arena.lastTermCount = 0
    arena.lastOperandCount = 0

fn BodyIRFlatSoAI32SlotBytes(): int64 =
    return int64(4)

fn BodyIRFlatSoAStrSlotBytes(): int64 =
    return int64(24)

fn BodyIRFlatSoAFixedBytes32SlotBytes(): int64 =
    return int64(32)

@borrows
fn BodyIRPhaseArenaOpOperandCount(bodyIR: BodyIR): int32 =
    var count: int32
    for opIndex in 0..<bodyIR.ops.len:
        count = count + bodyIR.ops[opIndex].operands.len
    return count

@borrows
fn BodyIRPhaseArenaCallArgSlotCount(bodyIR: BodyIR): int32 =
    var count: int32
    for callIndex in 0..<bodyIR.callSequence.len:
        count = count + bodyIR.callSequence[callIndex].argSlots.len
    return count

@borrows
fn BodyIRPhaseArenaCallArgPassCount(bodyIR: BodyIR): int32 =
    var count: int32
    for callIndex in 0..<bodyIR.callSequence.len:
        let callOp = bodyIR.callSequence[callIndex]
        var passCount = callOp.argSlots.len
        if callOp.argPassKinds.len < passCount:
            passCount = callOp.argPassKinds.len
        count = count + passCount
    return count

@borrows
fn BodyIRPhaseArenaTermOperandCount(bodyIR: BodyIR): int32 =
    var count: int32
    for termIndex in 0..<bodyIR.terms.len:
        count = count + bodyIR.terms[termIndex].operands.len
    return count

fn BodyIRPhaseArenaReserveBytesAfter(used: int64,
                                     count: int32,
                                     elemSize: int64): int64 =
    assert(count >= 0, " body ir phase arena reserve: negative count")
    assert(elemSize >= int64(0), " body ir phase arena reserve: negative element size")
    if count <= 0 || elemSize == int64(0):
        return used
    let aligned = phase.PhaseArenaAlign(used, int64(8))
    return aligned + int64(count) * elemSize

fn BodyIRPhaseArenaReserveByteColumns(used: int64,
                                      columnCount: int32,
                                      count: int32,
                                      elemSize: int64): int64 =
    assert(columnCount >= 0, " body ir phase arena reserve: negative column count")
    var out = used
    for columnIndex in 0..<columnCount:
        out = BodyIRPhaseArenaReserveBytesAfter(out, count, elemSize)
    return out

@borrows
fn BodyIRFlatSoAReserveCapacityBytes(bodyIR: BodyIR): int64 =
    let i32Bytes = BodyIRFlatSoAI32SlotBytes()
    let strBytes = BodyIRFlatSoAStrSlotBytes()
    let fixed32Bytes = BodyIRFlatSoAFixedBytes32SlotBytes()
    let opCount = bodyIR.ops.len
    let opOperandCount = BodyIRPhaseArenaOpOperandCount(bodyIR)
    let callCount = bodyIR.callSequence.len
    let callArgSlotCount = BodyIRPhaseArenaCallArgSlotCount(bodyIR)
    let callArgPassCount = BodyIRPhaseArenaCallArgPassCount(bodyIR)
    let localCount = bodyIR.localSlots.len
    let blockCount = bodyIR.blocks.len
    let termCount = bodyIR.terms.len
    let termOperandCount = BodyIRPhaseArenaTermOperandCount(bodyIR)
    let cstringCount = bodyIR.cstringLiterals.len
    let typeFactCount = bodyIR.typeFactTypeIds.len
    let entryDefinitionCount =
        bodyIR.entryDefinitionOwnershipKinds.len
    let entryParameterCount = bodyIR.entryParameterSlotIds.len
    let localBindingDefinitionCount =
        bodyIR.localBindingValueDefinitionRows.len
    let managedReplaceRowCount =
        bodyIR.managedLvalueReplace.callOrdinals.len
    let managedReplacePathCount =
        bodyIR.managedLvalueReplace.pathKinds.len
    let managedReplaceDescriptorCount =
        bodyIR.managedLvalueReplace.descriptorRootTypeIds.len
    var used: int64
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 2, entryDefinitionCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 1, entryParameterCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 1, localBindingDefinitionCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 7, typeFactCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(used, 17, opCount, i32Bytes)
    used = BodyIRPhaseArenaReserveBytesAfter(used, opOperandCount, i32Bytes)
    used = BodyIRPhaseArenaReserveBytesAfter(used, callCount, strBytes)
    used = BodyIRPhaseArenaReserveByteColumns(used, 20, callCount, i32Bytes)
    used = BodyIRPhaseArenaReserveBytesAfter(used, callArgSlotCount, i32Bytes)
    used = BodyIRPhaseArenaReserveBytesAfter(used, callArgPassCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(used, 13, localCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(used, 4, blockCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(used, 11, termCount, i32Bytes)
    used = BodyIRPhaseArenaReserveBytesAfter(used, termOperandCount, i32Bytes)
    used = BodyIRPhaseArenaReserveBytesAfter(used, cstringCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(used, 2, cstringCount, strBytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 19, managedReplaceRowCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 1, managedReplaceRowCount, fixed32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 12, managedReplacePathCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 1, managedReplaceDescriptorCount, i32Bytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 1, managedReplaceDescriptorCount, strBytes)
    used = BodyIRPhaseArenaReserveByteColumns(
        used, 1, managedReplaceDescriptorCount, fixed32Bytes)
    return used

fn BodyIRPhaseArenaReserveColumns(scratch: var phase.PhaseArena,
                                  columnCount: int32,
                                  count: int32,
                                  elemSize: int64): int32 =
    assert(columnCount >= 0, " body ir flat soa reserve: negative column count")
    assert(count >= 0, " body ir flat soa reserve: negative count")
    assert(elemSize >= int64(0), " body ir flat soa reserve: negative element size")
    if columnCount <= 0 || count <= 0 || elemSize == int64(0):
        return 0
    for columnIndex in 0..<columnCount:
        let _ = phase.PhaseArenaReserve(scratch, int64(count), elemSize)
    return columnCount

@borrows
fn BodyIRFlatSoAReserveFromBody(out: var BodyIRFlatSoA,
                                scratch: var phase.PhaseArena,
                                bodyIR: BodyIR): int32 =
    let opCount = bodyIR.ops.len
    let opOperandCount = BodyIRPhaseArenaOpOperandCount(bodyIR)
    let callCount = bodyIR.callSequence.len
    let callArgSlotCount = BodyIRPhaseArenaCallArgSlotCount(bodyIR)
    let callArgPassCount = BodyIRPhaseArenaCallArgPassCount(bodyIR)
    let localCount = bodyIR.localSlots.len
    let blockCount = bodyIR.blocks.len
    let termCount = bodyIR.terms.len
    let termOperandCount = BodyIRPhaseArenaTermOperandCount(bodyIR)
    let cstringCount = bodyIR.cstringLiterals.len
    let typeFactCount = bodyIR.typeFactTypeIds.len
    let entryDefinitionCount =
        bodyIR.entryDefinitionOwnershipKinds.len
    let entryParameterCount = bodyIR.entryParameterSlotIds.len
    let localBindingDefinitionCount =
        bodyIR.localBindingValueDefinitionRows.len
    let managedReplaceRowCount =
        bodyIR.managedLvalueReplace.callOrdinals.len
    let managedReplacePathCount =
        bodyIR.managedLvalueReplace.pathKinds.len
    let managedReplaceDescriptorCount =
        bodyIR.managedLvalueReplace.descriptorRootTypeIds.len
    var reserveCount: int32
    if entryDefinitionCount > 0:
        reserveCount = reserveCount +
            BodyIRPhaseArenaReserveColumns(
                scratch, 2, entryDefinitionCount,
                BodyIRFlatSoAI32SlotBytes())
    if entryParameterCount > 0:
        reserveCount = reserveCount +
            BodyIRPhaseArenaReserveColumns(
                scratch, 1, entryParameterCount,
                BodyIRFlatSoAI32SlotBytes())
    if localBindingDefinitionCount > 0:
        reserveCount = reserveCount +
            BodyIRPhaseArenaReserveColumns(
                scratch, 1, localBindingDefinitionCount,
                BodyIRFlatSoAI32SlotBytes())
    if typeFactCount > 0:
        reserveCount = reserveCount +
            BodyIRPhaseArenaReserveColumns(
                scratch, 7, typeFactCount,
                BodyIRFlatSoAI32SlotBytes())
    if opCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 17, opCount, BodyIRFlatSoAI32SlotBytes())
    if opOperandCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, opOperandCount, BodyIRFlatSoAI32SlotBytes())
    if callCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, callCount, BodyIRFlatSoAStrSlotBytes())
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 20, callCount, BodyIRFlatSoAI32SlotBytes())
    if callArgSlotCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, callArgSlotCount, BodyIRFlatSoAI32SlotBytes())
    if callArgPassCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, callArgPassCount, BodyIRFlatSoAI32SlotBytes())
    if localCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 13, localCount, BodyIRFlatSoAI32SlotBytes())
    if blockCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 4, blockCount, BodyIRFlatSoAI32SlotBytes())
    if termCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 11, termCount, BodyIRFlatSoAI32SlotBytes())
    if termOperandCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, termOperandCount, BodyIRFlatSoAI32SlotBytes())
    if cstringCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, cstringCount, BodyIRFlatSoAI32SlotBytes())
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 2, cstringCount, BodyIRFlatSoAStrSlotBytes())
    if managedReplaceRowCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 19, managedReplaceRowCount, BodyIRFlatSoAI32SlotBytes())
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, managedReplaceRowCount, BodyIRFlatSoAFixedBytes32SlotBytes())
    if managedReplacePathCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 12, managedReplacePathCount, BodyIRFlatSoAI32SlotBytes())
    if managedReplaceDescriptorCount > 0:
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, managedReplaceDescriptorCount, BodyIRFlatSoAI32SlotBytes())
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, managedReplaceDescriptorCount, BodyIRFlatSoAStrSlotBytes())
        reserveCount = reserveCount + BodyIRPhaseArenaReserveColumns(scratch, 1, managedReplaceDescriptorCount, BodyIRFlatSoAFixedBytes32SlotBytes())
    return reserveCount

@borrows
fn BodyIRFlatSoAReserveCountFromBody(bodyIR: BodyIR): int32 =
    let opCount = bodyIR.ops.len
    let opOperandCount = BodyIRPhaseArenaOpOperandCount(bodyIR)
    let callCount = bodyIR.callSequence.len
    let callArgSlotCount = BodyIRPhaseArenaCallArgSlotCount(bodyIR)
    let callArgPassCount = BodyIRPhaseArenaCallArgPassCount(bodyIR)
    let localCount = bodyIR.localSlots.len
    let blockCount = bodyIR.blocks.len
    let termCount = bodyIR.terms.len
    let termOperandCount = BodyIRPhaseArenaTermOperandCount(bodyIR)
    let cstringCount = bodyIR.cstringLiterals.len
    let typeFactCount = bodyIR.typeFactTypeIds.len
    let entryDefinitionCount =
        bodyIR.entryDefinitionOwnershipKinds.len
    let entryParameterCount = bodyIR.entryParameterSlotIds.len
    let localBindingDefinitionCount =
        bodyIR.localBindingValueDefinitionRows.len
    let managedReplaceRowCount =
        bodyIR.managedLvalueReplace.callOrdinals.len
    let managedReplacePathCount =
        bodyIR.managedLvalueReplace.pathKinds.len
    let managedReplaceDescriptorCount =
        bodyIR.managedLvalueReplace.descriptorRootTypeIds.len
    var reserveCount: int32
    if entryDefinitionCount > 0:
        reserveCount = reserveCount + 2
    if entryParameterCount > 0:
        reserveCount = reserveCount + 1
    if localBindingDefinitionCount > 0:
        reserveCount = reserveCount + 1
    if typeFactCount > 0:
        reserveCount = reserveCount + 7
    if opCount > 0:
        reserveCount = reserveCount + 17
    if opOperandCount > 0:
        reserveCount = reserveCount + 1
    if callCount > 0:
        reserveCount = reserveCount + 21
    if callArgSlotCount > 0:
        reserveCount = reserveCount + 1
    if callArgPassCount > 0:
        reserveCount = reserveCount + 1
    if localCount > 0:
        reserveCount = reserveCount + 13
    if blockCount > 0:
        reserveCount = reserveCount + 4
    if termCount > 0:
        reserveCount = reserveCount + 11
    if termOperandCount > 0:
        reserveCount = reserveCount + 1
    if cstringCount > 0:
        reserveCount = reserveCount + 3
    if managedReplaceRowCount > 0:
        reserveCount = reserveCount + 20
    if managedReplacePathCount > 0:
        reserveCount = reserveCount + 12
    if managedReplaceDescriptorCount > 0:
        reserveCount = reserveCount + 3
    return reserveCount

@borrows
fn BodyIRDodProjectedFlatSoAIsAligned(bodyIR: BodyIR,
                                      opOperandCount: int32,
                                      termOperandCount: int32): bool =
    if !BodyIREntryDefinitionOwnershipShapeValid(bodyIR) ||
       !BodyIREntryParameterSlotsShapeValid(bodyIR):
        return false
    var opOperandCursor: int32
    for opIndex in 0..<bodyIR.ops.len:
        let operandCount = bodyIR.ops[opIndex].operands.len
        if operandCount < 0:
            return false
        opOperandCursor = opOperandCursor + operandCount
    if opOperandCursor != opOperandCount:
        return false
    for callIndex in 0..<bodyIR.callSequence.len:
        let callOp = bodyIR.callSequence[callIndex]
        if callOp.argSlots.len != callOp.argPassKinds.len:
            return false
    var termOperandCursor: int32
    for termIndex in 0..<bodyIR.terms.len:
        let operandCount = bodyIR.terms[termIndex].operands.len
        if operandCount < 0:
            return false
        termOperandCursor = termOperandCursor + operandCount
    return termOperandCursor == termOperandCount

@borrows
fn BodyIRPhaseArenaProjectFlatSoAAudit(arena: var BodyIRPhaseArena,
                                       bodyIR: BodyIR,
                                       opOperandCount: int32,
                                       termOperandCount: int32) =
    BodyIRPhaseArenaReset(arena)
    let capacityBytes = BodyIRFlatSoAReserveCapacityBytes(bodyIR)
    arena.reserveCount = BodyIRFlatSoAReserveCountFromBody(bodyIR)
    arena.capacityBytes = capacityBytes
    arena.usedBytes = capacityBytes
    arena.peakBytes = capacityBytes
    arena.spillCount = 0
    arena.live = true
    arena.lastOpCount = bodyIR.ops.len
    arena.lastTermCount = bodyIR.terms.len
    arena.lastOperandCount = opOperandCount + termOperandCount

@borrows
fn BodyIRFlatSoAAppendFromBody(out: var BodyIRFlatSoA,
                               bodyIR: BodyIR) =
    if !BodyIRTypeArenaProofDomainValid(bodyIR):
        panic("body ir: TypeArena proof domain invalid")
    if !BodyIREntryDefinitionOwnershipShapeValid(bodyIR):
        panic("body ir: entry definition ownership shape invalid")
    if !BodyIRManagedLvalueReplaceSidecarShapeValid(bodyIR):
        panic("body ir: managed replace projection source invalid")
    if BodyIRTypeArenaArtifactCidValid(out.typeArenaArtifactCid) &&
       !layout.FixedBytes32Equal(
           out.typeArenaArtifactCid, bodyIR.typeArenaArtifactCid):
        panic("body ir: flattened TypeArena artifact CID drift")
    out.typeArenaArtifactCid = layout.FixedBytes32Copy(bodyIR.typeArenaArtifactCid)
    out.managedReplaceBuilding =
        bodyIR.managedLvalueReplace.building
    out.managedReplaceSealed =
        bodyIR.managedLvalueReplace.sealed
    out.managedReplaceFunctionRow =
        bodyIR.managedLvalueReplace.functionRow
    out.managedReplaceTypeArenaArtifactCid =
        layout.FixedBytes32Copy(
            bodyIR.managedLvalueReplace.typeArenaArtifactCid)
    out.managedReplaceRootCid =
        layout.FixedBytes32Copy(
            bodyIR.managedLvalueReplace.rootCid)
    for row in 0..<bodyIR.managedLvalueReplace.callOrdinals.len:
        add(out.managedReplaceCallOrdinals,
            bodyIR.managedLvalueReplace.callOrdinals[row])
        add(out.managedReplaceOpRows,
            bodyIR.managedLvalueReplace.replaceOpRows[row])
        add(out.managedReplaceTargetKinds,
            bodyIR.managedLvalueReplace.targetKinds[row])
        add(out.managedReplaceModes,
            bodyIR.managedLvalueReplace.replaceModes[row])
        add(out.managedReplaceTargetLvalueNodeIndexes,
            bodyIR.managedLvalueReplace.targetLvalueNodeIndexes[row])
        add(out.managedReplaceSourceValueNodeIndexes,
            bodyIR.managedLvalueReplace.sourceValueNodeIndexes[row])
        add(out.managedReplaceTargetRootDefinitionDomains,
            bodyIR.managedLvalueReplace.targetRootDefinitionDomains[row])
        add(out.managedReplaceTargetRootDefinitionRows,
            bodyIR.managedLvalueReplace.targetRootDefinitionRows[row])
        add(out.managedReplaceTargetAddressSlotIds,
            bodyIR.managedLvalueReplace.targetAddressSlotIds[row])
        add(out.managedReplaceTargetAddressDefinitionRows,
            bodyIR.managedLvalueReplace.targetAddressDefinitionRows[row])
        add(out.managedReplaceTargetTypeIds,
            bodyIR.managedLvalueReplace.targetTypeIds[row])
        add(out.managedReplaceSourceDefinitionDomains,
            bodyIR.managedLvalueReplace.sourceDefinitionDomains[row])
        add(out.managedReplaceSourceDefinitionRows,
            bodyIR.managedLvalueReplace.sourceDefinitionRows[row])
        add(out.managedReplaceSourceSlotIds,
            bodyIR.managedLvalueReplace.sourceSlotIds[row])
        add(out.managedReplaceSourceSemanticRows,
            bodyIR.managedLvalueReplace.sourceSemanticRows[row])
        add(out.managedReplaceConsumeActionRows,
            bodyIR.managedLvalueReplace.consumeActionRows[row])
        add(out.managedReplaceRuntimeSemanticCids,
            layout.FixedBytes32Copy(
                bodyIR.managedLvalueReplace.runtimeSemanticCids[row]))
        add(out.managedReplacePathStarts,
            bodyIR.managedLvalueReplace.pathStarts[row])
        add(out.managedReplacePathCounts,
            bodyIR.managedLvalueReplace.pathCounts[row])
        add(out.managedReplaceDropGlueDescriptorRows,
            bodyIR.managedLvalueReplace.dropGlueDescriptorRows[row])
    for row in 0..<bodyIR.managedLvalueReplace.pathKinds.len:
        add(out.managedReplacePathKinds,
            bodyIR.managedLvalueReplace.pathKinds[row])
        add(out.managedReplacePathProjectionNodeIndexes,
            bodyIR.managedLvalueReplace.pathProjectionNodeIndexes[row])
        add(out.managedReplacePathParentTypeIds,
            bodyIR.managedLvalueReplace.pathParentTypeIds[row])
        add(out.managedReplacePathIdentityKinds,
            bodyIR.managedLvalueReplace.pathIdentityKinds[row])
        add(out.managedReplacePathIdentityRows,
            bodyIR.managedLvalueReplace.pathIdentityRows[row])
        add(out.managedReplacePathSelectorOrdinals,
            bodyIR.managedLvalueReplace.pathSelectorOrdinals[row])
        add(out.managedReplacePathResultTypeIds,
            bodyIR.managedLvalueReplace.pathResultTypeIds[row])
        add(out.managedReplacePathByteOffsets,
            bodyIR.managedLvalueReplace.pathByteOffsets[row])
        add(out.managedReplacePathByteWidths,
            bodyIR.managedLvalueReplace.pathByteWidths[row])
        add(out.managedReplacePathIndexNodeIndexes,
            bodyIR.managedLvalueReplace.pathIndexNodeIndexes[row])
        add(out.managedReplacePathIndexDefinitionDomains,
            bodyIR.managedLvalueReplace.pathIndexDefinitionDomains[row])
        add(out.managedReplacePathIndexDefinitionRows,
            bodyIR.managedLvalueReplace.pathIndexDefinitionRows[row])
    for row in 0..<
            bodyIR.managedLvalueReplace.descriptorRootTypeIds.len:
        add(out.managedReplaceDescriptorRootTypeIds,
            bodyIR.managedLvalueReplace.descriptorRootTypeIds[row])
        add(out.managedReplaceDescriptorPayloads,
            strings.CloneStr(
                bodyIR.managedLvalueReplace.descriptorPayloads[row]))
        add(out.managedReplaceDescriptorDigests,
            layout.FixedBytes32Copy(
                bodyIR.managedLvalueReplace.descriptorDigests[row]))
    out.entryDefinitionOwnershipSealed =
        bodyIR.entryDefinitionOwnershipSealed
    for row in 0..<bodyIR.entryDefinitionOwnershipKinds.len:
        add(out.entryDefinitionOwnershipKinds,
            bodyIR.entryDefinitionOwnershipKinds[row])
        add(out.entryDefinitionSemanticRows,
            bodyIR.entryDefinitionSemanticRows[row])
    for row in 0..<bodyIR.entryParameterSlotIds.len:
        add(out.entryParameterSlotIds,
            bodyIR.entryParameterSlotIds[row])
    out.localBindingValueDefinitionDomainStart =
        bodyIR.localBindingValueDefinitionDomainStart
    out.localBindingValueDefinitionDomainCount =
        bodyIR.localBindingValueDefinitionDomainCount
    for slotId in 0..<bodyIR.localBindingValueDefinitionRows.len:
        add(out.localBindingValueDefinitionRows,
            bodyIR.localBindingValueDefinitionRows[slotId])
    for row in 0..<bodyIR.typeFactTypeIds.len:
        add(out.typeFactTypeIds, bodyIR.typeFactTypeIds[row])
        add(out.typeFactStructuralKinds,
            bodyIR.typeFactStructuralKinds[row])
        add(out.typeFactScalarKinds, bodyIR.typeFactScalarKinds[row])
        add(out.typeFactChildTypeIds,
            bodyIR.typeFactChildTypeIds[row])
        add(out.typeFactFixedLengths,
            bodyIR.typeFactFixedLengths[row])
        add(out.typeFactSizeBytes, bodyIR.typeFactSizeBytes[row])
        add(out.typeFactAlignBytes, bodyIR.typeFactAlignBytes[row])
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        add(out.opKinds, op.kind)
        add(out.opTargets, op.target)
        add(out.opOperandStarts, out.operands.len)
        add(out.opOperandCounts, op.operands.len)
        add(out.opValueDefSlots, op.valueDefSlot)
        add(out.opValueDefExprNodeIndexes, op.valueDefExprNodeIndex)
        add(out.opValueDefSemanticRows, op.valueDefSemanticRow)
        add(out.opValueDefOwnershipKinds, int32(op.valueDefOwnership))
        add(out.opValueDefBorrowOwnerSemanticRows,
            op.valueDefBorrowOwnerSemanticRow)
        add(out.opValueDefBorrowOwnerDefinitionDomains,
            op.valueDefBorrowOwnerDefinitionDomain)
        add(out.opValueDefBorrowOwnerDefinitionRows,
            op.valueDefBorrowOwnerDefinitionRow)
        add(out.opValueDefConsumeOpIndexPlusOnes,
            op.valueDefConsumeOpIndexPlusOne)
        add(out.opValueDefOriginKinds, op.valueDefOriginKind)
        add(out.opValueDefOriginIds, op.valueDefOriginId)
        add(out.opSourceDefinitionDomains,
            op.sourceDefinitionDomain)
        add(out.opSourceDefinitionRows, op.sourceDefinitionRow)
        add(out.opConsumeActionRows, op.consumeActionRow)
        for operandIndex in 0..<op.operands.len:
            add(out.operands, op.operands[operandIndex])
    for callIndex in 0..<bodyIR.callSequence.len:
        let callOp = bodyIR.callSequence[callIndex]
        add(out.callTargetSymbols, strings.CloneStr(callOp.targetSymbol))
        add(out.callResultSlots, callOp.resultSlot)
        add(out.callResultPassKinds, callOp.resultPassKind)
        add(out.callResultOwnershipKinds, int32(callOp.resultOwnership))
        add(out.callResultExprNodeIndexes, callOp.resultExprNodeIndex)
        add(out.callResultValueDefinitionRows,
            callOp.resultValueDefinitionRow)
        add(out.callResultBorrowOwnerValueDefinitionRows,
            callOp.resultBorrowOwnerValueDefinitionRow)
        add(out.callResultBorrowOwnerDefinitionDomains,
            callOp.resultBorrowOwnerDefinitionDomain)
        add(out.callResultBorrowOwnerDefinitionRows,
            callOp.resultBorrowOwnerDefinitionRow)
        add(out.callResultDefinitionOriginKinds,
            callOp.resultDefinitionOriginKind)
        add(out.callResultDefinitionOriginIds,
            callOp.resultDefinitionOriginId)
        add(out.callSourceDefinitionDomains,
            callOp.sourceDefinitionDomain)
        add(out.callSourceDefinitionRows,
            callOp.sourceDefinitionRow)
        add(out.callSemanticCallExprNodeIndexes,
            callOp.semanticCallExprNodeIndex)
        add(out.callConsumeActionRows, callOp.consumeActionRow)
        add(out.callManagedStoreKinds, callOp.managedStoreKind)
        add(out.callManagedReplaceReceiptRows,
            callOp.managedReplaceReceiptRow)
        add(out.callManagedDropGlueDescriptorRows,
            callOp.managedDropGlueDescriptorRow)
        add(out.callRelocWordOffsets, callOp.relocWordOffset)
        add(out.callArgStarts, out.callArgSlots.len)
        add(out.callArgCounts, callOp.argSlots.len)
        for argIndex in 0..<callOp.argSlots.len:
            add(out.callArgSlots, callOp.argSlots[argIndex])
            if argIndex < callOp.argPassKinds.len:
                add(out.callArgPassKinds, callOp.argPassKinds[argIndex])
    for localIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[localIndex]
        add(out.localIds, slot.id)
        add(out.localTypeKinds, slot.typeKind)
        add(out.localTypeArenaTypeIds, slot.typeArenaTypeId)
        add(out.localManagedStorageKinds, slot.managedStorageKind)
        add(out.localPlaceKinds, slot.placeKind)
        add(out.localStackOffsets, slot.stackOffset)
        add(out.localSizeBytes, slot.sizeBytes)
        add(out.localAlignBytes, slot.alignBytes)
        add(out.localAuxValues, slot.auxValue)
        add(out.localOwnershipKinds, int32(slot.ownership))
        add(out.localAliasClasses, int32(slot.aliasClass))
        add(out.localEscapeKinds, int32(slot.escapeKind))
        if slot.noAlias:
            add(out.localNoAliasFlags, 1)
        else:
            add(out.localNoAliasFlags, 0)
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        add(out.blockIds, block.id)
        add(out.blockOpStarts, block.opStart)
        add(out.blockOpCounts, block.opCount)
        add(out.blockTermIndices, block.termIndex)
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[termIndex]
        add(out.termKinds, term.kind)
        add(out.termCondKinds, term.conditionKind)
        add(out.termResultSlots, term.resultSlot)
        add(out.termSourceDefinitionDomains,
            term.sourceDefinitionDomain)
        add(out.termSourceDefinitionRows,
            term.sourceDefinitionRow)
        add(out.termLhsSlots, term.lhsSlot)
        add(out.termRhsSlots, term.rhsSlot)
        add(out.termTrueBlocks, term.trueBlock)
        add(out.termFalseBlocks, term.falseBlock)
        add(out.termOperandStarts, out.termOperands.len)
        add(out.termOperandCounts, term.operands.len)
        for operandIndex in 0..<term.operands.len:
            add(out.termOperands, term.operands[operandIndex])
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        let literal = bodyIR.cstringLiterals[literalIndex]
        add(out.cstringIds, literal.id)
        add(out.cstringTexts, strings.CloneStr(literal.text))
        add(out.cstringDataLabels, strings.CloneStr(literal.dataLabel))

@borrows
fn BodyIRPhaseArenaBuildFlatSoA(arena: var BodyIRPhaseArena,
                                bodyIR: BodyIR): BodyIRFlatSoA =
    BodyIRPhaseArenaReset(arena)
    var flat: BodyIRFlatSoA
    let capacityBytes = BodyIRFlatSoAReserveCapacityBytes(bodyIR)
    var scratch = phase.PhaseArenaInit(capacityBytes)
    let reserveCount = BodyIRFlatSoAReserveFromBody(flat, scratch, bodyIR)
    let scratchReport = phase.PhaseArenaReport(scratch)
    arena.reserveCount = reserveCount
    arena.capacityBytes = scratchReport.capacityBytes
    arena.usedBytes = scratchReport.usedBytes
    arena.peakBytes = scratchReport.peakBytes
    arena.spillCount = scratchReport.spillCount
    assert(arena.spillCount == 0, " body ir phase arena reserve spilled")
    BodyIRFlatSoAAppendFromBody(flat, bodyIR)
    arena.live = true
    arena.lastOpCount = bodyIR.ops.len
    arena.lastTermCount = bodyIR.terms.len
    arena.lastOperandCount = flat.operands.len + flat.termOperands.len
    return flat

@borrows
fn BodyIRFlattenSoA(bodyIR: BodyIR): BodyIRFlatSoA =
    var arena = BodyIRPhaseArenaNew()
    return BodyIRPhaseArenaBuildFlatSoA(arena, bodyIR)

fn BodyIRFlatSoAScalarArrayCount(): int32 =
    return 113

fn BodyIRFlatSoAStringArrayCount(): int32 =
    return 4

fn BodyIRFlatSoAFixedBytes32ArrayCount(): int32 =
    return 2

@borrows
fn bodyIRFlatManagedReplaceCidExact(
        flat: BodyIRFlatSoA): layout.FixedBytes32 =
    if flat.managedReplaceBuilding ||
       !flat.managedReplaceSealed:
        return layout.FixedBytes32()
    var buf = layout.ByteBufInit(1024)
    bodyIRControlActionAppendText(
        buf, "cheng.body_ir.managed_lvalue_replace.v1")
    bodyIRControlActionAppendI32(
        buf, flat.managedReplaceFunctionRow)
    layout.ByteBufAppendFixed32(
        buf, flat.managedReplaceTypeArenaArtifactCid)
    bodyIRControlActionAppendI32(
        buf, flat.managedReplaceCallOrdinals.len)
    for row in 0..<flat.managedReplaceCallOrdinals.len:
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceCallOrdinals[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceOpRows[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceTargetKinds[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceModes[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceTargetLvalueNodeIndexes[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceSourceValueNodeIndexes[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceTargetRootDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceTargetRootDefinitionRows[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceTargetAddressSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceTargetAddressDefinitionRows[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceTargetTypeIds[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceSourceDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceSourceDefinitionRows[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceSourceSlotIds[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceSourceSemanticRows[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceConsumeActionRows[row])
        layout.ByteBufAppendFixed32(
            buf, flat.managedReplaceRuntimeSemanticCids[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathStarts[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathCounts[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceDropGlueDescriptorRows[row])
    bodyIRControlActionAppendI32(
        buf, flat.managedReplacePathKinds.len)
    for row in 0..<flat.managedReplacePathKinds.len:
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathKinds[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathProjectionNodeIndexes[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathParentTypeIds[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathIdentityKinds[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathIdentityRows[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathSelectorOrdinals[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathResultTypeIds[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathByteOffsets[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathByteWidths[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathIndexNodeIndexes[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathIndexDefinitionDomains[row])
        bodyIRControlActionAppendI32(
            buf, flat.managedReplacePathIndexDefinitionRows[row])
    bodyIRControlActionAppendI32(
        buf, flat.managedReplaceDescriptorRootTypeIds.len)
    for row in 0..<flat.managedReplaceDescriptorRootTypeIds.len:
        bodyIRControlActionAppendI32(
            buf, flat.managedReplaceDescriptorRootTypeIds[row])
        bodyIRControlActionAppendText(
            buf, flat.managedReplaceDescriptorPayloads[row])
        layout.ByteBufAppendFixed32(
            buf, flat.managedReplaceDescriptorDigests[row])
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

@borrows
fn BodyIRFlatManagedReplaceCidExact(
        flat: BodyIRFlatSoA): layout.FixedBytes32 =
    return bodyIRFlatManagedReplaceCidExact(flat)

@borrows
fn bodyIRFlatManagedReplaceAligned(flat: BodyIRFlatSoA): bool =
    let rowCount = flat.managedReplaceCallOrdinals.len
    let pathCount = flat.managedReplacePathKinds.len
    let descriptorCount =
        flat.managedReplaceDescriptorRootTypeIds.len
    let callCount = flat.callTargetSymbols.len
    let opCount = flat.opKinds.len
    let localCount = flat.localIds.len
    if flat.managedReplaceOpRows.len != rowCount ||
       flat.managedReplaceTargetKinds.len != rowCount ||
       flat.managedReplaceModes.len != rowCount ||
       flat.managedReplaceTargetLvalueNodeIndexes.len != rowCount ||
       flat.managedReplaceSourceValueNodeIndexes.len != rowCount ||
       flat.managedReplaceTargetRootDefinitionDomains.len != rowCount ||
       flat.managedReplaceTargetRootDefinitionRows.len != rowCount ||
       flat.managedReplaceTargetAddressSlotIds.len != rowCount ||
       flat.managedReplaceTargetAddressDefinitionRows.len != rowCount ||
       flat.managedReplaceTargetTypeIds.len != rowCount ||
       flat.managedReplaceSourceDefinitionDomains.len != rowCount ||
       flat.managedReplaceSourceDefinitionRows.len != rowCount ||
       flat.managedReplaceSourceSlotIds.len != rowCount ||
       flat.managedReplaceSourceSemanticRows.len != rowCount ||
       flat.managedReplaceConsumeActionRows.len != rowCount ||
       flat.managedReplaceRuntimeSemanticCids.len != rowCount ||
       flat.managedReplacePathStarts.len != rowCount ||
       flat.managedReplacePathCounts.len != rowCount ||
       flat.managedReplaceDropGlueDescriptorRows.len != rowCount ||
       flat.managedReplacePathProjectionNodeIndexes.len != pathCount ||
       flat.managedReplacePathParentTypeIds.len != pathCount ||
       flat.managedReplacePathIdentityKinds.len != pathCount ||
       flat.managedReplacePathIdentityRows.len != pathCount ||
       flat.managedReplacePathSelectorOrdinals.len != pathCount ||
       flat.managedReplacePathResultTypeIds.len != pathCount ||
       flat.managedReplacePathByteOffsets.len != pathCount ||
       flat.managedReplacePathByteWidths.len != pathCount ||
       flat.managedReplacePathIndexNodeIndexes.len != pathCount ||
       flat.managedReplacePathIndexDefinitionDomains.len != pathCount ||
       flat.managedReplacePathIndexDefinitionRows.len != pathCount ||
       flat.managedReplaceDescriptorPayloads.len != descriptorCount ||
       flat.managedReplaceDescriptorDigests.len != descriptorCount ||
       flat.callConsumeActionRows.len != callCount ||
       flat.callSourceDefinitionDomains.len != callCount ||
       flat.callSourceDefinitionRows.len != callCount ||
       flat.callManagedStoreKinds.len != callCount ||
       flat.callManagedReplaceReceiptRows.len != callCount ||
       flat.callManagedDropGlueDescriptorRows.len != callCount ||
       flat.opOperandStarts.len != opCount ||
       flat.opOperandCounts.len != opCount ||
       flat.opTargets.len != opCount ||
       flat.opValueDefSlots.len != opCount ||
       flat.opValueDefExprNodeIndexes.len != opCount ||
       flat.opValueDefSemanticRows.len != opCount ||
       flat.opValueDefOwnershipKinds.len != opCount ||
       flat.opValueDefBorrowOwnerSemanticRows.len != opCount ||
       flat.opValueDefBorrowOwnerDefinitionDomains.len != opCount ||
       flat.opValueDefBorrowOwnerDefinitionRows.len != opCount ||
       flat.opValueDefConsumeOpIndexPlusOnes.len != opCount ||
       flat.opValueDefOriginKinds.len != opCount ||
       flat.opValueDefOriginIds.len != opCount ||
       flat.opSourceDefinitionDomains.len != opCount ||
       flat.opSourceDefinitionRows.len != opCount ||
       flat.opConsumeActionRows.len != opCount ||
       (rowCount > 0 &&
        (!flat.entryDefinitionOwnershipSealed ||
         flat.entryDefinitionOwnershipKinds.len != localCount ||
         flat.entryDefinitionSemanticRows.len != localCount)) ||
       (flat.entryDefinitionOwnershipSealed &&
        flat.localBindingValueDefinitionRows.len != localCount) ||
       (!flat.entryDefinitionOwnershipSealed &&
        flat.localBindingValueDefinitionRows.len != 0 &&
        flat.localBindingValueDefinitionRows.len != localCount) ||
       flat.localTypeKinds.len != localCount ||
       flat.localTypeArenaTypeIds.len != localCount ||
       flat.localManagedStorageKinds.len != localCount ||
       flat.localPlaceKinds.len != localCount:
        return false
    if rowCount == 0:
        if pathCount != 0 || descriptorCount != 0 ||
           flat.managedReplaceBuilding ||
           flat.managedReplaceSealed ||
           flat.managedReplaceFunctionRow != -1 ||
           BodyIRTypeArenaArtifactCidValid(
               flat.managedReplaceTypeArenaArtifactCid) ||
           BodyIRTypeArenaArtifactCidValid(
               flat.managedReplaceRootCid):
            return false
        for callOrdinal in 0..<callCount:
            if flat.callManagedReplaceReceiptRows[callOrdinal] != -1 ||
               flat.callManagedDropGlueDescriptorRows[callOrdinal] != -1 ||
               flat.callManagedStoreKinds[callOrdinal] ==
                   ManagedStoreAggregateRetainTag ||
               flat.callManagedStoreKinds[callOrdinal] ==
                   ManagedStoreAggregateMoveTag:
                return false
        return true
    if flat.managedReplaceBuilding ||
       !flat.managedReplaceSealed ||
       flat.managedReplaceFunctionRow < 0 ||
       descriptorCount <= 0 ||
       !BodyIRTypeArenaArtifactCidValid(
           flat.managedReplaceTypeArenaArtifactCid) ||
       !BodyIRTypeArenaArtifactCidValid(
           flat.managedReplaceRootCid):
        return false
    if !layout.FixedBytes32Equal(
           flat.managedReplaceTypeArenaArtifactCid,
           flat.typeArenaArtifactCid):
        return false
    var pathCursor: int32
    var previousCallOrdinal: int32 = -1
    for row in 0..<rowCount:
        let callOrdinal = flat.managedReplaceCallOrdinals[row]
        let replaceOpRow = flat.managedReplaceOpRows[row]
        let targetAddressSlotId =
            flat.managedReplaceTargetAddressSlotIds[row]
        let targetAddressDefinitionRow =
            flat.managedReplaceTargetAddressDefinitionRows[row]
        let descriptorRow =
            flat.managedReplaceDropGlueDescriptorRows[row]
        let rowPathCount = flat.managedReplacePathCounts[row]
        if callOrdinal <= previousCallOrdinal ||
           callOrdinal < 0 || callOrdinal >= callCount ||
           replaceOpRow < 0 || replaceOpRow >= opCount ||
           flat.opKinds[replaceOpRow] != BodyOpCallTag ||
           flat.opOperandStarts[replaceOpRow] < 0 ||
           flat.opOperandCounts[replaceOpRow] != 1 ||
           flat.opOperandStarts[replaceOpRow] >= flat.operands.len ||
           flat.operands[flat.opOperandStarts[replaceOpRow]] !=
               callOrdinal ||
           (flat.managedReplaceTargetKinds[row] != 2 &&
            flat.managedReplaceTargetKinds[row] != 3) ||
           (flat.managedReplaceModes[row] != 1 &&
            flat.managedReplaceModes[row] != 2) ||
           flat.managedReplaceTargetLvalueNodeIndexes[row] < 0 ||
           flat.managedReplaceSourceValueNodeIndexes[row] < 0 ||
           flat.managedReplaceTargetRootDefinitionDomains[row] ==
               BodyDefinitionDomainInvalidTag ||
           flat.managedReplaceTargetRootDefinitionRows[row] < 0 ||
           targetAddressSlotId < 0 ||
           targetAddressSlotId >= localCount ||
           targetAddressDefinitionRow < 0 ||
           targetAddressDefinitionRow >= replaceOpRow ||
           flat.opKinds[targetAddressDefinitionRow] !=
               BodyOpLoadLocalTag ||
           flat.opOperandStarts[targetAddressDefinitionRow] < 0 ||
           flat.opOperandCounts[targetAddressDefinitionRow] != 5 ||
           flat.opOperandStarts[targetAddressDefinitionRow] >
               flat.operands.len - 5 ||
           flat.operands[
               flat.opOperandStarts[targetAddressDefinitionRow]] !=
                   BodyLoadLocalIndexedAddressTag ||
           flat.managedReplaceTargetTypeIds[row] < 0 ||
           flat.managedReplaceSourceDefinitionDomains[row] ==
               BodyDefinitionDomainInvalidTag ||
           flat.managedReplaceSourceDefinitionRows[row] < 0 ||
           flat.managedReplaceSourceSlotIds[row] < 0 ||
           flat.managedReplaceSourceSlotIds[row] >= localCount ||
           flat.managedReplaceSourceSemanticRows[row] < 0 ||
           !BodyIRTypeArenaArtifactCidValid(
               flat.managedReplaceRuntimeSemanticCids[row]) ||
           flat.managedReplacePathStarts[row] != pathCursor ||
           rowPathCount <= 0 ||
           (flat.managedReplaceTargetKinds[row] == 3 &&
            rowPathCount < 2) ||
           rowPathCount >
               pathCount - pathCursor ||
           descriptorRow < 0 || descriptorRow >= descriptorCount ||
           flat.managedReplaceDescriptorRootTypeIds[descriptorRow] !=
               flat.managedReplaceTargetTypeIds[row] ||
           flat.localTypeKinds[targetAddressSlotId] != LocalPtrTag ||
           flat.localTypeArenaTypeIds[targetAddressSlotId] !=
               flat.managedReplaceTargetTypeIds[row] ||
           flat.localManagedStorageKinds[targetAddressSlotId] !=
               BodyManagedStorageManagedTag ||
           flat.localPlaceKinds[targetAddressSlotId] !=
               BodyPlaceBorrowAddressTag ||
           flat.opTargets[targetAddressDefinitionRow] !=
               targetAddressSlotId ||
           flat.opValueDefSlots[targetAddressDefinitionRow] !=
               targetAddressSlotId ||
           flat.opValueDefExprNodeIndexes[targetAddressDefinitionRow] !=
               flat.managedReplaceTargetLvalueNodeIndexes[row] ||
           flat.opValueDefSemanticRows[targetAddressDefinitionRow] < 0 ||
           flat.opValueDefOwnershipKinds[targetAddressDefinitionRow] !=
               int32(OwnBorrowShared) ||
           flat.opValueDefBorrowOwnerDefinitionDomains[
               targetAddressDefinitionRow] !=
               flat.managedReplaceTargetRootDefinitionDomains[row] ||
           flat.opValueDefBorrowOwnerDefinitionRows[
               targetAddressDefinitionRow] !=
               flat.managedReplaceTargetRootDefinitionRows[row] ||
           flat.opValueDefConsumeOpIndexPlusOnes[
               targetAddressDefinitionRow] != 0 ||
           flat.opValueDefOriginKinds[targetAddressDefinitionRow] !=
               BodyDefinitionOriginTypedExprTag ||
           flat.opValueDefOriginIds[targetAddressDefinitionRow] !=
               flat.opValueDefSemanticRows[
                   targetAddressDefinitionRow] ||
           flat.opSourceDefinitionDomains[targetAddressDefinitionRow] !=
               flat.managedReplaceTargetRootDefinitionDomains[row] ||
           flat.opSourceDefinitionRows[targetAddressDefinitionRow] !=
               flat.managedReplaceTargetRootDefinitionRows[row] ||
           flat.opConsumeActionRows[targetAddressDefinitionRow] != -1 ||
           flat.callManagedReplaceReceiptRows[callOrdinal] != row ||
           flat.callManagedDropGlueDescriptorRows[callOrdinal] !=
               descriptorRow ||
           flat.callSourceDefinitionDomains[callOrdinal] !=
               flat.managedReplaceSourceDefinitionDomains[row] ||
           flat.callSourceDefinitionRows[callOrdinal] !=
               flat.managedReplaceSourceDefinitionRows[row] ||
           flat.callConsumeActionRows[callOrdinal] !=
               flat.managedReplaceConsumeActionRows[row]:
            return false
        if flat.managedReplaceSourceDefinitionDomains[row] ==
               BodyDefinitionDomainBodyOpTag:
            let sourceDefinitionRow =
                flat.managedReplaceSourceDefinitionRows[row]
            if sourceDefinitionRow < 0 ||
               sourceDefinitionRow >= replaceOpRow ||
               flat.opValueDefConsumeOpIndexPlusOnes[
                   sourceDefinitionRow] != 0 ||
               flat.opConsumeActionRows[sourceDefinitionRow] != -1:
                return false
        if flat.managedReplaceModes[row] == 1:
            if flat.managedReplaceConsumeActionRows[row] != replaceOpRow ||
               flat.callManagedStoreKinds[callOrdinal] !=
                   ManagedStoreAggregateMoveTag:
                return false
        else:
            if flat.managedReplaceConsumeActionRows[row] != -1 ||
               flat.callManagedStoreKinds[callOrdinal] !=
                   ManagedStoreAggregateRetainTag:
                return false
        let terminalPathRow = pathCursor + rowPathCount - 1
        if (flat.managedReplaceTargetKinds[row] == 2 &&
            flat.managedReplacePathKinds[terminalPathRow] != 1) ||
           (flat.managedReplaceTargetKinds[row] == 3 &&
            flat.managedReplacePathKinds[terminalPathRow] != 2) ||
           flat.managedReplacePathResultTypeIds[terminalPathRow] !=
               flat.managedReplaceTargetTypeIds[row]:
            return false
        let addressOperandStart =
            flat.opOperandStarts[targetAddressDefinitionRow]
        let rootDefinitionRow =
            flat.managedReplaceTargetRootDefinitionRows[row]
        let rootDefinitionDomain =
            flat.managedReplaceTargetRootDefinitionDomains[row]
        let rootSlot = flat.operands[addressOperandStart + 1]
        var rootSemanticRow: int32 = -1
        if rootDefinitionDomain == BodyDefinitionDomainEntrySlotTag:
            if rootDefinitionRow == rootSlot &&
               rootDefinitionRow < localCount:
                rootSemanticRow =
                    flat.entryDefinitionSemanticRows[rootDefinitionRow]
        elif rootDefinitionDomain == BodyDefinitionDomainBodyOpTag:
            if rootDefinitionRow < targetAddressDefinitionRow &&
               flat.opValueDefSlots[rootDefinitionRow] == rootSlot:
                rootSemanticRow =
                    flat.opValueDefSemanticRows[rootDefinitionRow]
        let fieldPathRow = terminalPathRow - 1
        if fieldPathRow < pathCursor ||
           rootDefinitionDomain != BodyDefinitionDomainBodyOpTag ||
           rootDefinitionRow < 0 ||
           rootDefinitionRow >= targetAddressDefinitionRow ||
           flat.opKinds[rootDefinitionRow] != BodyOpLoadLocalTag ||
           flat.opOperandCounts[rootDefinitionRow] != 4 ||
           flat.opOperandStarts[rootDefinitionRow] < 0 ||
           flat.opOperandStarts[rootDefinitionRow] >
               flat.operands.len - 4:
            return false
        let fieldOperandStart =
            flat.opOperandStarts[rootDefinitionRow]
        let fieldRootSlot = flat.operands[fieldOperandStart + 1]
        var fieldRootSemanticRow: int32 = -1
        let fieldSourceDomain =
            flat.opSourceDefinitionDomains[rootDefinitionRow]
        let fieldSourceRow =
            flat.opSourceDefinitionRows[rootDefinitionRow]
        if fieldSourceDomain == BodyDefinitionDomainEntrySlotTag:
            if fieldSourceRow == fieldRootSlot &&
               fieldSourceRow >= 0 && fieldSourceRow < localCount:
                fieldRootSemanticRow =
                    flat.entryDefinitionSemanticRows[fieldSourceRow]
        elif fieldSourceDomain == BodyDefinitionDomainBodyOpTag:
            if fieldSourceRow >= 0 &&
               fieldSourceRow < rootDefinitionRow &&
               flat.opValueDefSlots[fieldSourceRow] == fieldRootSlot:
                fieldRootSemanticRow =
                    flat.opValueDefSemanticRows[fieldSourceRow]
        if flat.operands[fieldOperandStart] !=
               BodyLoadLocalFieldAddressTag ||
           flat.opTargets[rootDefinitionRow] != rootSlot ||
           flat.opValueDefSlots[rootDefinitionRow] != rootSlot ||
           flat.opValueDefExprNodeIndexes[rootDefinitionRow] !=
               flat.managedReplacePathProjectionNodeIndexes[
                   fieldPathRow] ||
           fieldRootSemanticRow < 0 ||
           flat.opValueDefSemanticRows[rootDefinitionRow] !=
               fieldRootSemanticRow ||
           flat.opValueDefOwnershipKinds[rootDefinitionRow] !=
               int32(OwnBorrowShared) ||
           flat.opValueDefBorrowOwnerSemanticRows[
               rootDefinitionRow] != fieldRootSemanticRow ||
           flat.opValueDefBorrowOwnerDefinitionDomains[
               rootDefinitionRow] != fieldSourceDomain ||
           flat.opValueDefBorrowOwnerDefinitionRows[
               rootDefinitionRow] != fieldSourceRow ||
           flat.opValueDefConsumeOpIndexPlusOnes[
               rootDefinitionRow] != 0 ||
           flat.opValueDefOriginKinds[rootDefinitionRow] !=
               BodyDefinitionOriginTypedExprTag ||
           flat.opValueDefOriginIds[rootDefinitionRow] !=
               fieldRootSemanticRow ||
           flat.opConsumeActionRows[rootDefinitionRow] != -1 ||
           flat.managedReplacePathKinds[fieldPathRow] != 1 ||
           flat.operands[fieldOperandStart + 2] !=
               flat.managedReplacePathByteOffsets[fieldPathRow] ||
           flat.operands[fieldOperandStart + 3] !=
               flat.managedReplacePathByteWidths[fieldPathRow] ||
           flat.managedReplacePathResultTypeIds[fieldPathRow] !=
               flat.managedReplacePathParentTypeIds[
                   terminalPathRow]:
            return false
        if rootSemanticRow < 0 ||
           flat.opValueDefSemanticRows[
               targetAddressDefinitionRow] != rootSemanticRow ||
           flat.opValueDefBorrowOwnerSemanticRows[
               targetAddressDefinitionRow] != rootSemanticRow ||
           flat.operands[addressOperandStart + 3] !=
               flat.managedReplacePathByteWidths[terminalPathRow] ||
           (flat.operands[addressOperandStart + 4] != 0 &&
            flat.operands[addressOperandStart + 4] != 1):
            return false
        let indexDefinitionDomain =
            flat.managedReplacePathIndexDefinitionDomains[
                terminalPathRow]
        let indexDefinitionRow =
            flat.managedReplacePathIndexDefinitionRows[
                terminalPathRow]
        let indexSlot = flat.operands[addressOperandStart + 2]
        if indexDefinitionDomain == BodyDefinitionDomainEntrySlotTag:
            if indexDefinitionRow != indexSlot:
                return false
        elif indexDefinitionDomain == BodyDefinitionDomainBodyOpTag:
            if indexDefinitionRow < 0 ||
               indexDefinitionRow >= targetAddressDefinitionRow ||
               flat.opValueDefSlots[indexDefinitionRow] != indexSlot:
                return false
        else:
            return false
        for pathOffset in 1..<rowPathCount:
            let previousPathRow = pathCursor + pathOffset - 1
            let pathRow = pathCursor + pathOffset
            if flat.managedReplacePathResultTypeIds[previousPathRow] !=
                   flat.managedReplacePathParentTypeIds[pathRow]:
                return false
        pathCursor = pathCursor + rowPathCount
        previousCallOrdinal = callOrdinal
    if pathCursor != pathCount:
        return false
    for callOrdinal in 0..<callCount:
        let receiptRow =
            flat.callManagedReplaceReceiptRows[callOrdinal]
        let aggregateStore =
            flat.callManagedStoreKinds[callOrdinal] ==
                ManagedStoreAggregateRetainTag ||
            flat.callManagedStoreKinds[callOrdinal] ==
                ManagedStoreAggregateMoveTag
        if aggregateStore:
            if receiptRow < 0 || receiptRow >= rowCount ||
               flat.managedReplaceCallOrdinals[receiptRow] !=
                   callOrdinal:
                return false
        elif receiptRow != -1 ||
             flat.callManagedDropGlueDescriptorRows[callOrdinal] != -1:
            return false
    for pathRow in 0..<pathCount:
        if !bodyIRManagedLvalueReplacePathTupleValid(
               flat.managedReplacePathKinds[pathRow],
               flat.managedReplacePathProjectionNodeIndexes[pathRow],
               flat.managedReplacePathParentTypeIds[pathRow],
               flat.managedReplacePathIdentityKinds[pathRow],
               flat.managedReplacePathIdentityRows[pathRow],
               flat.managedReplacePathSelectorOrdinals[pathRow],
               flat.managedReplacePathResultTypeIds[pathRow],
               flat.managedReplacePathByteOffsets[pathRow],
               flat.managedReplacePathByteWidths[pathRow],
               flat.managedReplacePathIndexNodeIndexes[pathRow],
               flat.managedReplacePathIndexDefinitionDomains[pathRow],
               flat.managedReplacePathIndexDefinitionRows[pathRow]):
            return false
    for row in 0..<descriptorCount:
        if flat.managedReplaceDescriptorRootTypeIds[row] < 0 ||
           len(flat.managedReplaceDescriptorPayloads[row]) == 0 ||
           !BodyIRTypeArenaArtifactCidValid(
               flat.managedReplaceDescriptorDigests[row]) ||
           !layout.FixedBytes32Equal(
               flat.managedReplaceDescriptorDigests[row],
               bodyIRManagedLvalueReplaceDescriptorDigest(
                   flat.managedReplaceDescriptorPayloads[row])):
            return false
    return layout.FixedBytes32Equal(
        flat.managedReplaceRootCid,
        bodyIRFlatManagedReplaceCidExact(flat))

@borrows
fn BodyIRFlatSoAIsAligned(flat: BodyIRFlatSoA): bool =
    # A zero CID is valid only for legacy/untyped bodies with no local
    # TypeArena proof; slot rows are checked by the canonical BodyIR path.
    let typeFactCount = flat.typeFactTypeIds.len
    if !bodyIRFlatManagedReplaceAligned(flat):
        return false
    if !flat.entryDefinitionOwnershipSealed:
        if flat.entryDefinitionOwnershipKinds.len != 0 ||
           flat.entryDefinitionSemanticRows.len != 0:
            return false
    else:
        if flat.entryDefinitionSemanticRows.len !=
               flat.entryDefinitionOwnershipKinds.len:
            return false
        for row in 0..<flat.entryDefinitionOwnershipKinds.len:
            if flat.entryDefinitionOwnershipKinds[row] <
                   int32(OwnInvalid) ||
               flat.entryDefinitionOwnershipKinds[row] >
                   int32(OwnBorrowUnique):
                return false
            let kind = flat.entryDefinitionOwnershipKinds[row]
            if (kind == int32(OwnInvalid) ||
                kind == int32(OwnPlain)) &&
               flat.entryDefinitionSemanticRows[row] != -1:
                return false
    for parameterOrdinal in 0..<flat.entryParameterSlotIds.len:
        let slotId = flat.entryParameterSlotIds[parameterOrdinal]
        if slotId < 0 || slotId >= flat.localIds.len ||
           flat.localStackOffsets[slotId] !=
               0 - 1 - parameterOrdinal:
            return false
    if (flat.entryDefinitionOwnershipSealed &&
        flat.localBindingValueDefinitionRows.len != flat.localIds.len) ||
       (!flat.entryDefinitionOwnershipSealed &&
        flat.localBindingValueDefinitionRows.len != 0 &&
        flat.localBindingValueDefinitionRows.len != flat.localIds.len):
        return false
    if flat.localBindingValueDefinitionDomainStart < 0 ||
       flat.localBindingValueDefinitionDomainCount < 0 ||
       flat.localBindingValueDefinitionDomainStart >
           2147483647 - flat.localBindingValueDefinitionDomainCount:
        return false
    var localSlotsByDefinitionRows: int32[]
    setLen(localSlotsByDefinitionRows,
           flat.localBindingValueDefinitionDomainCount)
    for definitionDomainRow in 0..<localSlotsByDefinitionRows.len:
        localSlotsByDefinitionRows[definitionDomainRow] = -1
    for slotId in 0..<flat.localBindingValueDefinitionRows.len:
        let definitionRow =
            flat.localBindingValueDefinitionRows[slotId]
        if definitionRow < -1 ||
           (definitionRow >= 0 &&
            (definitionRow <
                 flat.localBindingValueDefinitionDomainStart ||
             definitionRow -
                 flat.localBindingValueDefinitionDomainStart >=
                 flat.localBindingValueDefinitionDomainCount)):
            return false
        if definitionRow < 0:
            continue
        let definitionDomainRow = definitionRow -
            flat.localBindingValueDefinitionDomainStart
        if localSlotsByDefinitionRows[definitionDomainRow] >= 0:
            return false
        localSlotsByDefinitionRows[definitionDomainRow] = slotId
    if typeFactCount != flat.typeFactStructuralKinds.len ||
       typeFactCount != flat.typeFactScalarKinds.len ||
       typeFactCount != flat.typeFactChildTypeIds.len ||
       typeFactCount != flat.typeFactFixedLengths.len ||
       typeFactCount != flat.typeFactSizeBytes.len ||
       typeFactCount != flat.typeFactAlignBytes.len:
        return false
    for row in 0..<typeFactCount:
        if flat.typeFactTypeIds[row] < 0 ||
           (row > 0 &&
            flat.typeFactTypeIds[row - 1] >=
                flat.typeFactTypeIds[row]) ||
           flat.typeFactStructuralKinds[row] <= 0 ||
           flat.typeFactSizeBytes[row] < 0 ||
           flat.typeFactAlignBytes[row] <= 0:
            return false
    if typeFactCount > 0 &&
       !BodyIRTypeArenaArtifactCidValid(
           flat.typeArenaArtifactCid):
        return false
    if flat.opKinds.len != flat.opTargets.len ||
       flat.opKinds.len != flat.opOperandStarts.len ||
       flat.opKinds.len != flat.opOperandCounts.len ||
       flat.opKinds.len != flat.opValueDefSlots.len ||
       flat.opKinds.len != flat.opValueDefExprNodeIndexes.len ||
       flat.opKinds.len != flat.opValueDefSemanticRows.len ||
       flat.opKinds.len != flat.opValueDefOwnershipKinds.len ||
       flat.opKinds.len != flat.opValueDefBorrowOwnerSemanticRows.len ||
       flat.opKinds.len !=
           flat.opValueDefBorrowOwnerDefinitionDomains.len ||
       flat.opKinds.len !=
           flat.opValueDefBorrowOwnerDefinitionRows.len ||
       flat.opKinds.len != flat.opValueDefConsumeOpIndexPlusOnes.len ||
       flat.opKinds.len != flat.opValueDefOriginKinds.len ||
       flat.opKinds.len != flat.opValueDefOriginIds.len ||
       flat.opKinds.len != flat.opSourceDefinitionDomains.len ||
       flat.opKinds.len != flat.opSourceDefinitionRows.len ||
       flat.opKinds.len != flat.opConsumeActionRows.len:
        return false
    if flat.callTargetSymbols.len != flat.callResultSlots.len ||
       flat.callTargetSymbols.len != flat.callResultPassKinds.len ||
       flat.callTargetSymbols.len != flat.callResultOwnershipKinds.len ||
       flat.callTargetSymbols.len != flat.callResultExprNodeIndexes.len ||
       flat.callTargetSymbols.len !=
           flat.callResultValueDefinitionRows.len ||
       flat.callTargetSymbols.len !=
           flat.callResultBorrowOwnerValueDefinitionRows.len ||
       flat.callTargetSymbols.len !=
           flat.callResultBorrowOwnerDefinitionDomains.len ||
       flat.callTargetSymbols.len !=
           flat.callResultBorrowOwnerDefinitionRows.len ||
       flat.callTargetSymbols.len !=
           flat.callResultDefinitionOriginKinds.len ||
       flat.callTargetSymbols.len !=
           flat.callResultDefinitionOriginIds.len ||
       flat.callTargetSymbols.len !=
           flat.callSourceDefinitionDomains.len ||
       flat.callTargetSymbols.len !=
           flat.callSourceDefinitionRows.len ||
       flat.callTargetSymbols.len !=
           flat.callSemanticCallExprNodeIndexes.len ||
       flat.callTargetSymbols.len != flat.callConsumeActionRows.len ||
       flat.callTargetSymbols.len != flat.callManagedStoreKinds.len ||
       flat.callTargetSymbols.len !=
           flat.callManagedReplaceReceiptRows.len ||
       flat.callTargetSymbols.len !=
           flat.callManagedDropGlueDescriptorRows.len ||
       flat.callTargetSymbols.len != flat.callRelocWordOffsets.len ||
       flat.callTargetSymbols.len != flat.callArgStarts.len ||
       flat.callTargetSymbols.len != flat.callArgCounts.len:
        return false
    if flat.callArgSlots.len != flat.callArgPassKinds.len:
        return false
    if flat.entryDefinitionOwnershipSealed &&
       (flat.entryDefinitionOwnershipKinds.len !=
            flat.localIds.len ||
        flat.entryDefinitionSemanticRows.len !=
            flat.localIds.len):
        return false
    if (flat.entryDefinitionOwnershipSealed &&
        flat.localBindingValueDefinitionRows.len != flat.localIds.len) ||
       (!flat.entryDefinitionOwnershipSealed &&
        flat.localBindingValueDefinitionRows.len != 0 &&
        flat.localBindingValueDefinitionRows.len != flat.localIds.len):
        return false
    for callIndex in 0..<flat.callTargetSymbols.len:
        let start = flat.callArgStarts[callIndex]
        let count = flat.callArgCounts[callIndex]
        if start < 0 || count < 0 || start + count > flat.callArgSlots.len:
            return false
    if flat.localIds.len != flat.localTypeKinds.len ||
       flat.localIds.len != flat.localTypeArenaTypeIds.len ||
       flat.localIds.len != flat.localManagedStorageKinds.len ||
       flat.localIds.len != flat.localPlaceKinds.len ||
       flat.localIds.len != flat.localStackOffsets.len ||
       flat.localIds.len != flat.localSizeBytes.len ||
       flat.localIds.len != flat.localAlignBytes.len ||
       flat.localIds.len != flat.localAuxValues.len ||
       flat.localIds.len != flat.localOwnershipKinds.len ||
       flat.localIds.len != flat.localAliasClasses.len ||
       flat.localIds.len != flat.localEscapeKinds.len ||
       flat.localIds.len != flat.localNoAliasFlags.len:
        return false
    var flatHasTypeArenaProof = false
    for localIndex in 0..<flat.localIds.len:
        let typeId = flat.localTypeArenaTypeIds[localIndex]
        let storageKind = flat.localManagedStorageKinds[localIndex]
        if typeId == -1:
            if storageKind != BodyManagedStorageUnknownTag:
                return false
        elif typeId >= 0:
            if storageKind != BodyManagedStorageUnmanagedTag &&
               storageKind != BodyManagedStorageManagedTag:
                return false
            flatHasTypeArenaProof = true
        else:
            return false
    if flatHasTypeArenaProof &&
       !BodyIRTypeArenaArtifactCidValid(flat.typeArenaArtifactCid):
        return false
    if flat.blockIds.len != flat.blockOpStarts.len ||
       flat.blockIds.len != flat.blockOpCounts.len ||
       flat.blockIds.len != flat.blockTermIndices.len:
        return false
    if flat.termKinds.len != flat.termCondKinds.len ||
       flat.termKinds.len != flat.termResultSlots.len ||
       flat.termKinds.len != flat.termSourceDefinitionDomains.len ||
       flat.termKinds.len != flat.termSourceDefinitionRows.len ||
       flat.termKinds.len != flat.termLhsSlots.len ||
       flat.termKinds.len != flat.termRhsSlots.len ||
       flat.termKinds.len != flat.termTrueBlocks.len ||
       flat.termKinds.len != flat.termFalseBlocks.len ||
       flat.termKinds.len != flat.termOperandStarts.len ||
       flat.termKinds.len != flat.termOperandCounts.len:
        return false
    for termIndex in 0..<flat.termKinds.len:
        let start = flat.termOperandStarts[termIndex]
        let count = flat.termOperandCounts[termIndex]
        if start < 0 || count < 0 || start + count > flat.termOperands.len:
            return false
    if flat.cstringIds.len != flat.cstringTexts.len ||
       flat.cstringIds.len != flat.cstringDataLabels.len:
        return false
    return true

fn bodyIRDodBoolText(value: bool): str =
    if value:
        return "1"
    return "0"

fn bodyIRDodBodyOpKindValid(kind: int32): bool =
    return kind >= BodyOpFirstTag && kind <= BodyOpLastTag

fn bodyIRDodLocalTypeKindValid(kind: int32): bool =
    if kind == LocalI32Tag:
        return true
    if kind == LocalF64Tag:
        return true
    if kind == LocalStrTag:
        return true
    if kind == LocalPtrTag:
        return true
    if kind == LocalAggregateTag:
        return true
    if kind == LocalI64Tag:
        return true
    return false

fn bodyIRDodPlaceKindValid(kind: int32): bool =
    if kind == BodyPlaceStackValueTag:
        return true
    if kind == BodyPlaceParamAddressTag:
        return true
    if kind == BodyPlaceBorrowAddressTag:
        return true
    if kind == BodyPlaceGlobalAddressTag:
        return true
    return false

fn bodyIRDodCallPassKindValid(kind: int32): bool =
    if kind == BodyCallPassStackValueTag:
        return true
    if kind == BodyCallPassParamAddressTag:
        return true
    if kind == BodyCallPassBorrowAddressTag:
        return true
    if kind == BodyCallPassSretResultTag:
        return true
    if kind == BodyCallPassByAddressAggregateTag:
        return true
    if kind == BodyCallPassGlobalAddressTag:
        return true
    if kind == BodyCallPassPtrNilTag:
        return true
    return false

fn bodyIRDodCallArgPassKindValid(kind: int32): bool =
    if kind == BodyCallPassStackValueTag:
        return true
    if kind == BodyCallPassParamAddressTag:
        return true
    if kind == BodyCallPassBorrowAddressTag:
        return true
    if kind == BodyCallPassByAddressAggregateTag:
        return true
    if kind == BodyCallPassGlobalAddressTag:
        return true
    if kind == BodyCallPassPtrNilTag:
        return true
    return false

fn bodyIRDodCallResultPassKindValid(kind: int32): bool =
    if kind == BodyCallPassStackValueTag:
        return true
    if kind == BodyCallPassSretResultTag:
        return true
    if kind == BodyCallPassForwardEntrySretTag:
        return true
    return false

fn bodyIRDodBodyTermKindValid(kind: int32): bool =
    return kind >= BodyTermReturnTag && kind <= BodyTermCbrTag

fn bodyIRDodBodyCondKindValid(kind: int32): bool =
    return kind >= BodyCondLocalNonZeroTag && kind <= BodyCondF64GeTag

fn bodyIRDodMarkInvalid(report: var BodyIRDodSoAContractReport,
                         owner: str,
                         value: int32,
                         limit: int32) =
    if report.invalidRefCount == 0:
        report.firstInvalidRefOwner = owner
        report.firstInvalidRefValue = value
        report.firstInvalidRefLimit = limit
    report.invalidRefCount = report.invalidRefCount + 1
    report.ok = false

fn bodyIRDodCheckLocalRef(report: var BodyIRDodSoAContractReport,
                           owner: str,
                           value: int32,
                           limit: int32) =
    report.localRefCount = report.localRefCount + 1
    if value < 0 || value >= limit:
        bodyIRDodMarkInvalid(report, owner, value, limit)

fn bodyIRDodCheckMaybeLocalRef(report: var BodyIRDodSoAContractReport,
                                owner: str,
                                value: int32,
                                limit: int32) =
    if value < 0:
        return
    bodyIRDodCheckLocalRef(report, owner, value, limit)

fn bodyIRDodCheckCallArgRef(report: var BodyIRDodSoAContractReport,
                             owner: str,
                             value: int32,
                             passKind: int32,
                             localLimit: int32,
                             cstringLimit: int32) =
    if !bodyIRDodCallArgPassKindValid(passKind):
        bodyIRDodMarkInvalid(report, owner, passKind, BodyCallPassPtrNilTag)
        return
    if passKind == BodyCallPassPtrNilTag:
        report.encodedParamRefCount = report.encodedParamRefCount + 1
        if CallArgSlotConstOrdinal(value) != 3:
            bodyIRDodMarkInvalid(report, owner, value, CallArgSlotConstPtrNil())
        return
    if passKind == BodyCallPassGlobalAddressTag:
        report.encodedParamRefCount = report.encodedParamRefCount + 1
        if value < 0:
            bodyIRDodMarkInvalid(report, owner, value, 0)
        return
    if passKind == BodyCallPassParamAddressTag ||
       passKind == BodyCallPassBorrowAddressTag ||
       passKind == BodyCallPassByAddressAggregateTag:
        if !CallArgSlotIsAddress(value):
            bodyIRDodMarkInvalid(report, owner, value, CallArgSlotAddressBase())
            return
        let addressSlotId = CallArgSlotAddressId(value)
        bodyIRDodCheckLocalRef(report, owner, addressSlotId, localLimit)
        return
    if value == CallArgSlotMissing():
        bodyIRDodMarkInvalid(report, owner, value, localLimit)
        return
    if value < 0:
        if CallArgSlotIsConst(value):
            report.encodedParamRefCount = report.encodedParamRefCount + 1
            return
        if CallArgSlotIsCString(value):
            let literalId = CallArgSlotCStringId(value)
            bodyIRDodCheckCStringRef(report, owner, literalId, cstringLimit)
            return
        if CallArgSlotIsAddress(value):
            let slotId = CallArgSlotAddressId(value)
            bodyIRDodCheckLocalRef(report, owner, slotId, localLimit)
            return
        bodyIRDodMarkInvalid(report, owner, value, localLimit)
        return
    bodyIRDodCheckLocalRef(report, owner, value, localLimit)

fn bodyIRDodCheckBlockRef(report: var BodyIRDodSoAContractReport,
                           owner: str,
                           value: int32,
                           limit: int32) =
    report.blockRefCount = report.blockRefCount + 1
    if value < 0 || value >= limit:
        bodyIRDodMarkInvalid(report, owner, value, limit)

fn bodyIRDodCheckTermRef(report: var BodyIRDodSoAContractReport,
                          owner: str,
                          value: int32,
                          limit: int32) =
    report.termRefCount = report.termRefCount + 1
    if value < 0 || value >= limit:
        bodyIRDodMarkInvalid(report, owner, value, limit)

fn bodyIRDodCheckCallRef(report: var BodyIRDodSoAContractReport,
                          owner: str,
                          value: int32,
                          limit: int32) =
    report.callRefCount = report.callRefCount + 1
    if value < 0 || value >= limit:
        bodyIRDodMarkInvalid(report, owner, value, limit)

fn bodyIRDodCheckCStringRef(report: var BodyIRDodSoAContractReport,
                             owner: str,
                             value: int32,
                             limit: int32) =
    report.cstringRefCount = report.cstringRefCount + 1
    if value < 0 || value >= limit:
        bodyIRDodMarkInvalid(report, owner, value, limit)

@borrows
fn bodyIRDodCheckLocalSlots(bodyIR: BodyIR,
                             report: var BodyIRDodSoAContractReport) =
    for localIndex in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[localIndex]
        if slot.id != localIndex:
            bodyIRDodMarkInvalid(report,
                                 Fmt"localSlots[{localIndex}].id",
                                 slot.id,
                                 bodyIR.localSlots.len)
        if !bodyIRDodLocalTypeKindValid(slot.typeKind):
            bodyIRDodMarkInvalid(report,
                                 Fmt"localSlots[{localIndex}].typeKind",
                                 slot.typeKind,
                                 LocalI64Tag)
        if !BodyIRLocalSlotTypeArenaProofValid(slot):
            bodyIRDodMarkInvalid(
                report,
                Fmt"localSlots[{localIndex}].typeArenaTypeId",
                slot.typeArenaTypeId,
                BodyManagedStorageManagedTag)
        if !bodyIRDodPlaceKindValid(slot.placeKind):
            bodyIRDodMarkInvalid(report,
                                 Fmt"localSlots[{localIndex}].placeKind",
                                 slot.placeKind,
                                 BodyPlaceGlobalAddressTag)

@borrows
fn bodyIRDodCheckCStringLiterals(bodyIR: BodyIR,
                                  report: var BodyIRDodSoAContractReport) =
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        let literal = bodyIR.cstringLiterals[literalIndex]
        if literal.id != literalIndex:
            bodyIRDodMarkInvalid(report,
                                 Fmt"cstringLiterals[{literalIndex}].id",
                                 literal.id,
                                 bodyIR.cstringLiterals.len)

@borrows
fn bodyIRDodCheckBlocks(bodyIR: BodyIR,
                         report: var BodyIRDodSoAContractReport) =
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.id != blockIndex:
            bodyIRDodMarkInvalid(report,
                                 Fmt"blocks[{blockIndex}].id",
                                 block.id,
                                 bodyIR.blocks.len)
        if block.opStart < 0 ||
           block.opCount < 0 ||
           block.opStart + block.opCount > bodyIR.ops.len:
            bodyIRDodMarkInvalid(report,
                                 Fmt"blocks[{blockIndex}].opRange",
                                 block.opStart,
                                 bodyIR.ops.len)
        bodyIRDodCheckTermRef(report,
                              Fmt"blocks[{blockIndex}].termIndex",
                              block.termIndex,
                              bodyIR.terms.len)

@borrows
fn bodyIRDodCheckTerm(bodyIR: BodyIR,
                       report: var BodyIRDodSoAContractReport,
                       termIndex: int32) =
    let term = bodyIR.terms[termIndex]
    if !bodyIRDodBodyTermKindValid(term.kind):
        bodyIRDodMarkInvalid(report,
                             Fmt"terms[{termIndex}].kind",
                             term.kind,
                             BodyTermCbrTag)
        return
    bodyIRDodCheckMaybeLocalRef(report,
                                Fmt"terms[{termIndex}].resultSlot",
                                term.resultSlot,
                                bodyIR.localSlots.len)
    bodyIRDodCheckMaybeLocalRef(report,
                                Fmt"terms[{termIndex}].lhsSlot",
                                term.lhsSlot,
                                bodyIR.localSlots.len)
    bodyIRDodCheckMaybeLocalRef(report,
                                Fmt"terms[{termIndex}].rhsSlot",
                                term.rhsSlot,
                                bodyIR.localSlots.len)
    if term.kind == BodyTermBrTag:
        bodyIRDodCheckBlockRef(report,
                               Fmt"terms[{termIndex}].trueBlock",
                               term.trueBlock,
                               bodyIR.blocks.len)
    elif term.kind == BodyTermCbrTag:
        if !bodyIRDodBodyCondKindValid(term.conditionKind):
            bodyIRDodMarkInvalid(report,
                                 Fmt"terms[{termIndex}].conditionKind",
                                 term.conditionKind,
                                 BodyCondF64GeTag)
        bodyIRDodCheckBlockRef(report,
                               Fmt"terms[{termIndex}].trueBlock",
                               term.trueBlock,
                               bodyIR.blocks.len)
        bodyIRDodCheckBlockRef(report,
                               Fmt"terms[{termIndex}].falseBlock",
                               term.falseBlock,
                               bodyIR.blocks.len)

@borrows
fn bodyIRDodCheckTerms(bodyIR: BodyIR,
                        report: var BodyIRDodSoAContractReport) =
    for termIndex in 0..<bodyIR.terms.len:
        bodyIRDodCheckTerm(bodyIR, report, termIndex)

@borrows
fn bodyIRDodCheckCallSequence(bodyIR: BodyIR,
                               report: var BodyIRDodSoAContractReport) =
    for callIndex in 0..<bodyIR.callSequence.len:
        let callOp = bodyIR.callSequence[callIndex]
        if callOp.argSlots.len != callOp.argPassKinds.len:
            bodyIRDodMarkInvalid(report,
                                 Fmt"callSequence[{callIndex}].argPassKinds_len",
                                 callOp.argPassKinds.len,
                                 callOp.argSlots.len)
            return
        if !bodyIRDodCallResultPassKindValid(callOp.resultPassKind):
            bodyIRDodMarkInvalid(report,
                                 Fmt"callSequence[{callIndex}].resultPassKind",
                                 callOp.resultPassKind,
                                 BodyCallPassForwardEntrySretTag)
        bodyIRDodCheckMaybeLocalRef(report,
                                    Fmt"callSequence[{callIndex}].resultSlot",
                                    callOp.resultSlot,
                                    bodyIR.localSlots.len)
        for argIndex in 0..<callOp.argSlots.len:
            bodyIRDodCheckCallArgRef(report,
                                     Fmt"callSequence[{callIndex}].argSlots[{argIndex}]",
                                     callOp.argSlots[argIndex],
                                     callOp.argPassKinds[argIndex],
                                     bodyIR.localSlots.len,
                                     bodyIR.cstringLiterals.len)

@borrows
fn bodyIRDodCheckOpTarget(bodyIR: BodyIR,
                           report: var BodyIRDodSoAContractReport,
                           opIndex: int32,
                           op: BodyOp) =
    if op.kind == BodyOpResultPanicGuardTag:
        if op.target != -1:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].panicGuardTarget",
                                 op.target,
                                 -1)
        return
    if op.kind == BodyOpReturnTag ||
       op.kind == BodyOpBranchTag ||
       op.kind == BodyOpCallTag:
        bodyIRDodCheckMaybeLocalRef(report,
                                    Fmt"ops[{opIndex}].target",
                                    op.target,
                                    bodyIR.localSlots.len)
        return
    bodyIRDodCheckLocalRef(report,
                           Fmt"ops[{opIndex}].target",
                           op.target,
                           bodyIR.localSlots.len)

@borrows
fn bodyIRDodCheckFieldAccessOp(bodyIR: BodyIR,
                                report: var BodyIRDodSoAContractReport,
                                opIndex: int32,
                                op: BodyOp,
                                isStore: bool) =
    if op.operands.len != 4:
        bodyIRDodMarkInvalid(report,
                             Fmt"ops[{opIndex}].fieldAccessArity",
                             op.operands.len,
                             4)
        return

    let baseSlot = op.operands[0]
    let valueSlot = op.operands[1]
    let byteOffset = op.operands[2]
    let byteCount = op.operands[3]
    bodyIRDodCheckLocalRef(report,
                           Fmt"ops[{opIndex}].fieldAccessBase",
                           baseSlot,
                           bodyIR.localSlots.len)
    bodyIRDodCheckLocalRef(report,
                           Fmt"ops[{opIndex}].fieldAccessValue",
                           valueSlot,
                           bodyIR.localSlots.len)
    if byteOffset < 0:
        bodyIRDodMarkInvalid(report,
                             Fmt"ops[{opIndex}].fieldAccessByteOffset",
                             byteOffset,
                             0)
    if byteCount <= 0:
        bodyIRDodMarkInvalid(report,
                             Fmt"ops[{opIndex}].fieldAccessByteCount",
                             byteCount,
                             1)

    if isStore:
        if op.target != baseSlot:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].fieldStoreTargetBaseMismatch",
                                 op.target,
                                 baseSlot)
    else:
        if op.target != valueSlot:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].fieldLoadTargetValueMismatch",
                                 op.target,
                                 valueSlot)

    if baseSlot < 0 || baseSlot >= bodyIR.localSlots.len ||
       valueSlot < 0 || valueSlot >= bodyIR.localSlots.len ||
       byteOffset < 0 || byteCount <= 0:
        return

    let base = bodyIR.localSlots[baseSlot]
    let value = bodyIR.localSlots[valueSlot]
    if value.sizeBytes < byteCount:
        bodyIRDodMarkInvalid(report,
                             Fmt"ops[{opIndex}].fieldAccessValueByteCount",
                             byteCount,
                             value.sizeBytes)
    if base.typeKind != LocalPtrTag && base.stackOffset >= 0:
        if base.sizeBytes <= 0 || byteOffset > base.sizeBytes - byteCount:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].fieldAccessBaseRange",
                                 byteOffset,
                                 base.sizeBytes)

@borrows
fn bodyIRDodCheckOp(bodyIR: BodyIR,
                     report: var BodyIRDodSoAContractReport,
                     opIndex: int32) =
    let op = bodyIR.ops[opIndex]
    if !bodyIRDodBodyOpKindValid(op.kind):
        bodyIRDodMarkInvalid(report,
                             Fmt"ops[{opIndex}].kind",
                             op.kind,
                             BodyOpLastTag)
        return
    bodyIRDodCheckOpTarget(bodyIR, report, opIndex, op)
    if op.kind == BodyOpResultPanicGuardTag:
        if op.operands.len != 2:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].panicGuardArity",
                                 op.operands.len,
                                 2)
            return
        let conditionSlot = op.operands[0]
        bodyIRDodCheckLocalRef(report,
                               Fmt"ops[{opIndex}].panicGuardCondition",
                               conditionSlot,
                               bodyIR.localSlots.len)
        if conditionSlot >= 0 && conditionSlot < bodyIR.localSlots.len &&
           bodyIR.localSlots[conditionSlot].typeKind != LocalI32Tag:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].panicGuardConditionType",
                                 bodyIR.localSlots[conditionSlot].typeKind,
                                 LocalI32Tag)
        let callOrdinal = op.operands[1]
        bodyIRDodCheckCallRef(report,
                              Fmt"ops[{opIndex}].panicGuardCallOrdinal",
                              callOrdinal,
                              bodyIR.callSequence.len)
        if callOrdinal >= 0 && callOrdinal < bodyIR.callSequence.len &&
           bodyIR.callSequence[callOrdinal].resultSlot != -1:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].panicGuardCallResult",
                                 bodyIR.callSequence[callOrdinal].resultSlot,
                                 -1)
    elif op.kind == BodyOpCallTag:
        if op.operands.len != 1:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].callOrdinal",
                                 -1,
                                 bodyIR.callSequence.len)
            return
        bodyIRDodCheckCallRef(report,
                              Fmt"ops[{opIndex}].callOrdinal",
                              op.operands[0],
                              bodyIR.callSequence.len)
        if op.operands[0] >= 0 && op.operands[0] < bodyIR.callSequence.len:
            let callOp = bodyIR.callSequence[op.operands[0]]
            if op.target != callOp.resultSlot:
                bodyIRDodMarkInvalid(report,
                                     Fmt"ops[{opIndex}].target_result_mismatch",
                                     op.target,
                                     callOp.resultSlot)
    elif op.kind == BodyOpLoadLocalTag:
        if op.operands.len == 5 &&
           op.operands[0] == BodyLoadLocalIndexedAddressTag:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].indexedAddressRoot",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].indexedAddressIndex",
                                   op.operands[2],
                                   bodyIR.localSlots.len)
            if op.operands[3] <= 0 ||
               (op.operands[4] != 0 && op.operands[4] != 1):
                bodyIRDodMarkInvalid(
                    report,
                    Fmt"ops[{opIndex}].indexedAddressShape",
                    op.operands[3],
                    op.operands[4])
        elif op.operands.len == 4 &&
             op.operands[0] == BodyLoadLocalFieldAddressTag:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].fieldAddressRoot",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
            if op.operands[2] < 0 || op.operands[3] <= 0:
                bodyIRDodMarkInvalid(
                    report,
                    Fmt"ops[{opIndex}].fieldAddressShape",
                    op.operands[2],
                    op.operands[3])
        elif op.operands.len >= 3 &&
           op.operands[0] == BodyLoadLocalStrIndexU8Tag:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].strSource",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].indexSource",
                                   op.operands[2],
                                   bodyIR.localSlots.len)
        elif op.operands.len >= 3 &&
           (op.operands[0] == BodyLoadLocalPtrDerefI32Tag ||
            op.operands[0] == BodyLoadLocalPtrDerefU8Tag ||
            op.operands[0] == BodyLoadLocalPtrDerefU64Tag):
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].ptrSource",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
        elif op.operands.len >= 1:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].source",
                                   op.operands[0],
                                   bodyIR.localSlots.len)
        else:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].source",
                                 -1,
                                 bodyIR.localSlots.len)
    elif op.kind == BodyOpStoreLocalTag ||
         op.kind == BodyOpCopyLocalTag:
        if op.operands.len < 1:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].source",
                                 -1,
                                 bodyIR.localSlots.len)
        else:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].source",
                                   op.operands[0],
                                   bodyIR.localSlots.len)
    elif op.kind == BodyOpBinOpTag:
        if op.operands.len < 4:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].binop_arity",
                                 op.operands.len,
                                 4)
        for operandIndex in 2..<op.operands.len:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].operands[{operandIndex}]",
                                   op.operands[operandIndex],
                                   bodyIR.localSlots.len)
    elif op.kind == BodyOpCmpTag:
        if op.operands.len < 3:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].cmp_arity",
                                 op.operands.len,
                                 3)
        for operandIndex in 1..<op.operands.len:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].operands[{operandIndex}]",
                                   op.operands[operandIndex],
                                   bodyIR.localSlots.len)
    elif op.kind == BodyOpBranchTag:
        if op.operands.len >= 2:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].branchSlot",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
    elif op.kind == BodyOpResultProjectTag:
        if op.operands.len < 2:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].projectSource",
                                 -1,
                                 bodyIR.localSlots.len)
        else:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].projectSource",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
    elif op.kind == BodyOpStrEqLiteralTag:
        if op.operands.len < 2:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].cstringLiteral",
                                 -1,
                                 bodyIR.cstringLiterals.len)
        else:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].strEqLocal",
                                   op.operands[0],
                                   bodyIR.localSlots.len)
            bodyIRDodCheckCStringRef(report,
                                     Fmt"ops[{opIndex}].cstringLiteral",
                                     op.operands[1],
                                     bodyIR.cstringLiterals.len)
    elif op.kind == BodyOpStrEqTag:
        if op.operands.len < 2:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].strEqArity",
                                 op.operands.len,
                                 2)
        else:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].strEqLhs",
                                   op.operands[0],
                                   bodyIR.localSlots.len)
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].strEqRhs",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
    elif op.kind == BodyOpIndexedLoadTag:
        if op.operands.len < 2:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].indexedLoadArity",
                                 op.operands.len,
                                 2)
        else:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].indexedLoadBase",
                                   op.operands[0],
                                   bodyIR.localSlots.len)
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].indexedLoadResult",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
    elif op.kind == BodyOpIndexedStoreTag:
        if op.operands.len < 2:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].indexedStoreArity",
                                 op.operands.len,
                                 2)
        else:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].indexedStoreBase",
                                   op.operands[0],
                                   bodyIR.localSlots.len)
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].indexedStoreValue",
                                   op.operands[1],
                                   bodyIR.localSlots.len)
    elif op.kind == BodyOpFieldLoadTag:
        bodyIRDodCheckFieldAccessOp(bodyIR, report, opIndex, op, false)
    elif op.kind == BodyOpFieldStoreTag:
        bodyIRDodCheckFieldAccessOp(bodyIR, report, opIndex, op, true)
    elif op.kind == BodyOpGlobalLoadTag ||
         op.kind == BodyOpGlobalStoreTag:
        if op.operands.len < 1:
            bodyIRDodMarkInvalid(report,
                                 Fmt"ops[{opIndex}].globalRefArity",
                                 op.operands.len,
                                 1)
        else:
            bodyIRDodCheckLocalRef(report,
                                   Fmt"ops[{opIndex}].globalSlot",
                                   op.operands[0],
                                   bodyIR.localSlots.len)

@borrows
fn bodyIRDodCheckOps(bodyIR: BodyIR,
                      report: var BodyIRDodSoAContractReport) =
    for opIndex in 0..<bodyIR.ops.len:
        bodyIRDodCheckOp(bodyIR, report, opIndex)

@borrows
fn BodyIRDodSoAContractCheck(bodyIR: BodyIR): BodyIRDodSoAContractReport =
    var report: BodyIRDodSoAContractReport
    report.ok = true
    report.indexWidthBits = 32
    # Baseline BodyIR owns 29 independent arrays. Managed replacement adds
    # 35 explicit SoA/CSR columns; descriptorPayloads is its nested text
    # payload column and is deep-owned by lifecycle.
    report.independentArrayCount = 64
    report.flatScalarArrayCount = BodyIRFlatSoAScalarArrayCount()
    report.flatStringArrayCount = BodyIRFlatSoAStringArrayCount()
    report.flatFixedBytes32ArrayCount =
        BodyIRFlatSoAFixedBytes32ArrayCount()
    report.nestedPayloadArrayCount = 1
    report.opCount = bodyIR.ops.len
    report.callCount = bodyIR.callSequence.len
    report.localCount = bodyIR.localSlots.len
    report.blockCount = bodyIR.blocks.len
    report.termCount = bodyIR.terms.len
    report.cstringCount = bodyIR.cstringLiterals.len
    bodyIRDodCheckLocalSlots(bodyIR, report)
    bodyIRDodCheckCStringLiterals(bodyIR, report)
    bodyIRDodCheckCallSequence(bodyIR, report)
    bodyIRDodCheckOps(bodyIR, report)
    bodyIRDodCheckBlocks(bodyIR, report)
    bodyIRDodCheckTerms(bodyIR, report)
    if !BodyIRLocalBindingValueDefinitionRowsShapeValid(bodyIR):
        bodyIRDodMarkInvalid(report,
                             "local_binding_value_definition_rows",
                             bodyIR.localBindingValueDefinitionRows.len,
                             bodyIR.localSlots.len)
    if !BodyIRControlFlowShapeValid(bodyIR):
        bodyIRDodMarkInvalid(report,
                             "control_flow_shape",
                             0,
                             1)
    if !BodyIRCleanupProofShapeValid(bodyIR):
        bodyIRDodMarkInvalid(report,
                             "cleanup_proof_shape",
                             0,
                             1)
    if !BodyIRManualConsumeSidecarShapeValid(bodyIR):
        bodyIRDodMarkInvalid(report,
                             "manual_consume_sidecar_shape",
                             0,
                             1)
    if !BodyIRManagedLvalueReplaceSidecarShapeValid(bodyIR):
        bodyIRDodMarkInvalid(report,
                             "managed_lvalue_replace_sidecar_shape",
                             0,
                             1)
    if !BodyIRExternFfiHandleCapabilitySidecarShapeValid(bodyIR):
        bodyIRDodMarkInvalid(report,
                             "extern_ffi_handle_capability_shape",
                             0,
                             1)
    let opOperandCount = BodyIRPhaseArenaOpOperandCount(bodyIR)
    let termOperandCount = BodyIRPhaseArenaTermOperandCount(bodyIR)
    var arena = BodyIRPhaseArenaNew()
    BodyIRPhaseArenaProjectFlatSoAAudit(arena, bodyIR, opOperandCount, termOperandCount)
    report.phaseArenaResetCount = arena.resetCount
    report.phaseArenaGeneration = arena.generation
    report.phaseArenaLive = arena.live
    report.phaseArenaReserveCount = arena.reserveCount
    report.phaseArenaCapacityBytes = arena.capacityBytes
    report.phaseArenaUsedBytes = arena.usedBytes
    report.phaseArenaPeakBytes = arena.peakBytes
    report.phaseArenaSpillCount = arena.spillCount
    report.opOperandCount = opOperandCount
    report.termOperandCount = termOperandCount
    if !BodyIRDodProjectedFlatSoAIsAligned(bodyIR, opOperandCount, termOperandCount):
        bodyIRDodMarkInvalid(report,
                             "flat_soa_alignment",
                             0,
                             1)
    if arena.lastOpCount != report.opCount:
        bodyIRDodMarkInvalid(report,
                             "phase_arena_op_count",
                             arena.lastOpCount,
                             report.opCount)
    if arena.lastTermCount != report.termCount:
        bodyIRDodMarkInvalid(report,
                             "phase_arena_term_count",
                             arena.lastTermCount,
                             report.termCount)
    if arena.lastOperandCount != report.opOperandCount + report.termOperandCount:
        bodyIRDodMarkInvalid(report,
                             "phase_arena_operand_count",
                             arena.lastOperandCount,
                             report.opOperandCount + report.termOperandCount)
    if arena.spillCount != 0:
        bodyIRDodMarkInvalid(report,
                             "phase_arena_spill_count",
                             arena.spillCount,
                             0)
    if report.pointerKeyCount != 0:
        report.ok = false
    return report

fn BodyIRDodSoAContractAppendLine(out: var str, line: str) =
    if len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{line}"

@borrows
fn BodyIRDodSoAContractReportText(report: BodyIRDodSoAContractReport): str =
    var out = ""
    BodyIRDodSoAContractAppendLine(out, Fmt"body_ir_dod_soa_ok={bodyIRDodBoolText(report.ok)}")
    BodyIRDodSoAContractAppendLine(out, Fmt"body_ir_dod_soa_index_width_bits={report.indexWidthBits}")
    BodyIRDodSoAContractAppendLine(out, Fmt"body_ir_dod_soa_independent_array_count={report.independentArrayCount}")
    BodyIRDodSoAContractAppendLine(out, "body_ir_dod_soa_arrays=ops,callSequence,localSlots,entryDefinitionOwnershipKinds,entryDefinitionSemanticRows,localBindingValueDefinitionRows,entryParameterSlotIds,blocks,terms,cstringLiterals,managedLvalueReplace[35]")
    BodyIRDodSoAContractAppendLine(out, Fmt"body_ir_dod_soa_flat_scalar_array_count={report.flatScalarArrayCount}")
    BodyIRDodSoAContractAppendLine(out, Fmt"body_ir_dod_soa_flat_string_array_count={report.flatStringArrayCount}")
    BodyIRDodSoAContractAppendLine(out, Fmt"body_ir_dod_soa_flat_fixed_bytes32_array_count={report.flatFixedBytes32ArrayCount}")
    BodyIRDodSoAContractAppendLine(out, Fmt"body_ir_dod_soa_nested_payload_array_count={report.nestedPayloadArrayCount}")
