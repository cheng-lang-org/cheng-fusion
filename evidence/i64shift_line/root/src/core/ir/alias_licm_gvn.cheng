# Step 5 (备) — alias + LICM/GVN-on-memory scaffold.
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (same pattern as the retired
# Step 1 P1 liveness scaffold + Step 3 escape_arena_route.cheng + Step 2
# typed_ir_paramref_subst.cheng).  Env gate CHENG_ALIAS_LICM_GVN=1
# default off.
#
# Design source: docs/beat-c.md §1.4.5.
# Estimated 1.3-1.7x speedup, used as backup if Step 1-4 累乘 underdelivers
# below 4x total target.  Not on critical path (per master plan §4.6:
# "不上 Step 5 也能达 Step 1-4 累乘目标; 上才有 buffer").
#
# Combined pass for three intertwined optimizations:
#
# 1. Alias analysis: per memory operation (LoadLocal/StoreLocal/FieldLoad/
#    FieldStore/IndexedLoad/IndexedStore/GlobalLoad/GlobalStore), assign
#    an alias class — does this op alias with another op's memory?
#    Read-from-class[i] = set of write-class[j] that may alias.
#
# 2. LICM (Loop Invariant Code Motion): requires canonical loop facts.
#    This scaffold does not own or synthesize those facts.
#
# 3. GVN-on-memory (Global Value Numbering of memory operations):
#    redundant memory reads after the same address since last store get
#    the cached value number — eliminate the redundant load.
#
# All three share the alias analysis output, so combined in one pass to
# avoid duplicate scans.
#
# Wiring plan (Step 5 P2+):
#   1) primary_object_plan PrimaryBodyIrPrepareA64LayoutMetricsInPlace
#      gains optional call to AliasLicmGvnAnalyze (env-gated).
#   2) Result stored in module-level arrays parallel to existing
#      layoutXxx bitmaps; size predictor + filler read them under the
#      same two-pass-symmetry contract.

import cheng/core/ir/core_types as coreir
import std/os
import std/strings

const
    AliasClassUnknown = 0
    AliasClassLocalRead = 1
    AliasClassLocalWrite = 2
    AliasClassFieldRead = 3
    AliasClassFieldWrite = 4
    AliasClassIndexedRead = 5
    AliasClassIndexedWrite = 6
    AliasClassGlobalRead = 7
    AliasClassGlobalWrite = 8

type
    AliasMemoryOp =
        opIndex: int32
        aliasClass: int32
        baseSlot: int32
        indexHint: int32

    AliasLicmGvnResult =
        memoryOps: AliasMemoryOp[]
        totalMemoryOps: int32
        readCount: int32
        writeCount: int32
        licmHoistCandidateCount: int32
        gvnRedundantLoadCount: int32

fn AliasLicmGvnClassifyOpKind(opKind: int32): int32 =
    if opKind == coreir.BodyOpLoadLocalTag:
        return AliasClassLocalRead
    if opKind == coreir.BodyOpStoreLocalTag:
        return AliasClassLocalWrite
    if opKind == coreir.BodyOpFieldLoadTag:
        return AliasClassFieldRead
    if opKind == coreir.BodyOpFieldStoreTag:
        return AliasClassFieldWrite
    if opKind == coreir.BodyOpIndexedLoadTag:
        return AliasClassIndexedRead
    if opKind == coreir.BodyOpIndexedStoreTag:
        return AliasClassIndexedWrite
    if opKind == coreir.BodyOpGlobalLoadTag:
        return AliasClassGlobalRead
    if opKind == coreir.BodyOpGlobalStoreTag:
        return AliasClassGlobalWrite
    return AliasClassUnknown

fn AliasLicmGvnIsRead(cls: int32): bool =
    return cls == AliasClassLocalRead || cls == AliasClassFieldRead ||
           cls == AliasClassIndexedRead || cls == AliasClassGlobalRead

fn AliasLicmGvnIsWrite(cls: int32): bool =
    return cls == AliasClassLocalWrite || cls == AliasClassFieldWrite ||
           cls == AliasClassIndexedWrite || cls == AliasClassGlobalWrite

@borrows
fn AliasLicmGvnAnalyze(bodyIR: coreir.BodyIR): AliasLicmGvnResult =
    var result: AliasLicmGvnResult
    result.totalMemoryOps = 0
    result.readCount = 0
    result.writeCount = 0
    result.licmHoistCandidateCount = 0
    result.gvnRedundantLoadCount = 0

    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        let cls = AliasLicmGvnClassifyOpKind(op.kind)
        if cls == AliasClassUnknown:
            continue
        var memOp: AliasMemoryOp
        memOp.opIndex = opIndex
        memOp.aliasClass = cls
        memOp.baseSlot = -1
        memOp.indexHint = -1
        if op.operands.len > 0:
            memOp.baseSlot = op.operands[0]
        if op.operands.len > 1:
            memOp.indexHint = op.operands[1]
        add(result.memoryOps, memOp)
        result.totalMemoryOps = result.totalMemoryOps + 1
        if AliasLicmGvnIsRead(cls):
            result.readCount = result.readCount + 1
        else:
            result.writeCount = result.writeCount + 1

    for i in 0..<result.memoryOps.len:
        let cur = result.memoryOps[i]
        if !AliasLicmGvnIsRead(cur.aliasClass):
            continue
        for j in 0..<i:
            let prev = result.memoryOps[j]
            if prev.aliasClass == cur.aliasClass &&
               prev.baseSlot == cur.baseSlot &&
               prev.indexHint == cur.indexHint:
                result.gvnRedundantLoadCount = result.gvnRedundantLoadCount + 1
                break

    return result

@borrows
fn AliasLicmGvnSummary(result: AliasLicmGvnResult): str =
    return "alias_licm_gvn placeholder"

@borrows
fn AliasLicmGvnTraceIfEnabled(result: AliasLicmGvnResult) =
    let _gate = os.GetEnv("CHENG_ALIAS_LICM_GVN_TRACE")
    if _gate != "1":
        return
    var _line: str = "[alias-licm-gvn] mem_ops="
    _line = _line + strings.IntToStr(result.totalMemoryOps)
    _line = _line + " reads="
    _line = _line + strings.IntToStr(result.readCount)
    _line = _line + " writes="
    _line = _line + strings.IntToStr(result.writeCount)
    _line = _line + " licm_hoist_candidates="
    _line = _line + strings.IntToStr(result.licmHoistCandidateCount)
    _line = _line + " gvn_redundant_loads="
    _line = _line + strings.IntToStr(result.gvnRedundantLoadCount)
    os.WriteLine(os.GetStderr(), _line)
