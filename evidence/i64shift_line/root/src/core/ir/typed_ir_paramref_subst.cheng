# Step 2 — ParamRef substitution scaffold for leaf-function inlining.
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (same pattern as the retired
# Step 1 P1 liveness scaffold + Step 3 escape_arena_route.cheng).  Env gate
# CHENG_PARAMREF_SUBST=1 default off.
#
# Design source: docs/step-2-paramref-substitution-apply-ready.md.
# Master plan: docs/beat-c.md §1.4.2 (~2-3x speedup from
# call-density reduction; lets Step 1 regalloc fire on larger BBs).
#
# Companion to typed_ir_inline_pass.cheng (callgraph + leaf classifier).
# Inline pass identifies inlinable leaf functions and call sites; this
# pass performs the actual ParamRef → argument substitution on cloned
# typed-expr subtrees.
#
# Substitution algorithm:
#   For each (callSite, leafFunc) pair identified by inline pass:
#     1. Clone leaf body's typed-expr subtree
#     2. Walk clone bottom-up; for each TypedExprIrParamRef node:
#        a. Look up ParamRef.paramIndex in substitution table
#        b. Replace ParamRef with the corresponding call argument's
#           typed-expr (deep-copied if mutable, shared if immutable)
#     3. Re-link cloned subtree at call site (replace TypedExprIrCall
#        with cloned body)
#     4. Update callgraph edges (remove resolved edge, add transitive)
#
# Storage: per-substitution table = parallel arrays keyed by
# (functionId, paramIndex) → argExprId.  Module-level so the wire site
# (typed_ir_inline_pass.cheng + lowering_plan.cheng) can populate &
# consume without typed_expr struct mutation.
#
# Wiring plan (Step 2 P2+):
#   1) typed_ir_inline_pass.cheng TypedIrInlinePassRun gains optional
#      call to TypedIrParamRefSubstBuild (env-gated) after callgraph
#      classification, populates substitution table for each leaf
#      call site.
#   2) lowering_plan.cheng or compiler_main.cheng triggers apply pass
#      that walks call sites in reverse-postorder, substitutes
#      ParamRef references, and rewrites the typed-expr subtree.
#   3) bootstrap fp will drift on first real apply (codegen output
#      changes) — handle as new baseline per master plan §12.2 protocol.

import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod
import std/os
import std/strings

const
    ParamRefSubstKindInvalid = 0
    ParamRefSubstKindI32Literal = 1
    ParamRefSubstKindStrLiteral = 2
    ParamRefSubstKindParamRef = 3
    ParamRefSubstKindCallResult = 4

type
    ParamRefSubstitution =
        callSiteId: int32
        leafFunctionId: int32
        paramIndex: int32
        argKind: int32
        argExprId: int32
        argI32Value: int32

    ParamRefSubstTable =
        substitutions: ParamRefSubstitution[]
        totalCallSites: int32
        totalParams: int32
        resolvedSubstitutionCount: int32
        unresolvedKindCount: int32

fn TypedIrParamRefSubstNew(): ParamRefSubstTable =
    var t: ParamRefSubstTable
    t.totalCallSites = 0
    t.totalParams = 0
    t.resolvedSubstitutionCount = 0
    t.unresolvedKindCount = 0
    return t

fn TypedIrParamRefSubstAppend(table: var ParamRefSubstTable,
                               callSiteId: int32,
                               leafFunctionId: int32,
                               paramIndex: int32,
                               argKind: int32,
                               argExprId: int32,
                               argI32Value: int32) =
    var s: ParamRefSubstitution
    s.callSiteId = callSiteId
    s.leafFunctionId = leafFunctionId
    s.paramIndex = paramIndex
    s.argKind = argKind
    s.argExprId = argExprId
    s.argI32Value = argI32Value
    add(table.substitutions, s)
    if argKind == ParamRefSubstKindInvalid:
        table.unresolvedKindCount = table.unresolvedKindCount + 1
    else:
        table.resolvedSubstitutionCount = table.resolvedSubstitutionCount + 1

fn TypedIrParamRefSubstLookup(table: ParamRefSubstTable,
                               callSiteId: int32,
                               paramIndex: int32): int32 =
    for i in 0..<table.substitutions.len:
        let s = table.substitutions[i]
        if s.callSiteId == callSiteId && s.paramIndex == paramIndex:
            return i
    return -1

fn TypedIrParamRefSubstGetArgKind(table: ParamRefSubstTable,
                                   subIndex: int32): int32 =
    if subIndex < 0 || subIndex >= table.substitutions.len:
        return ParamRefSubstKindInvalid
    return table.substitutions[subIndex].argKind

fn TypedIrParamRefSubstGetArgI32(table: ParamRefSubstTable,
                                  subIndex: int32): int32 =
    if subIndex < 0 || subIndex >= table.substitutions.len:
        return 0
    return table.substitutions[subIndex].argI32Value

fn TypedIrParamRefSubstBuildStub(typedIr: var texpr.TypedExprIr): ParamRefSubstTable =
    # Minimal real impl: walk every function in typedIr, count totals.
    # No real substitution emitted (Step 2 P2 will consume inline_pass
    # callgraph + leaf classification to fill substitution table).
    # This step lets us verify the pass is reachable and the totals make
    # sense before adding rewrite logic.
    var table = TypedIrParamRefSubstNew()
    let functionCount = typedIr.functions2_functionNameIds.len
    table.totalCallSites = 0
    table.totalParams = 0
    for fi in 0..<functionCount:
        let stmtStart = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                     typedIr.functions2_statementStarts,
                                                     fi)
        let stmtCount = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                     typedIr.functions2_statementCounts,
                                                     fi)
        table.totalParams = table.totalParams + stmtCount
        table.totalCallSites = table.totalCallSites + stmtStart
        if stmtStart < 0:
            table.unresolvedKindCount = table.unresolvedKindCount + 1
    # Step 2 instrumentation (env-gated): stderr line for next-session
    # visibility — verify BuildStub reached + show typedIr totals.
    let _substGate = os.GetEnv("CHENG_PARAMREF_SUBST_TRACE")
    if _substGate == "1":
        var _line: str = "[paramref-subst] function_count="
        _line = _line + strings.IntToStr(functionCount)
        _line = _line + " total_call_sites_proxy="
        _line = _line + strings.IntToStr(table.totalCallSites)
        _line = _line + " total_params_proxy="
        _line = _line + strings.IntToStr(table.totalParams)
        _line = _line + " unresolved="
        _line = _line + strings.IntToStr(table.unresolvedKindCount)
        os.WriteLine(os.GetStderr(), _line)
    return table
