import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as bodyaccess

# Canonical CFG, liveness and reaching-version analysis for BodyIR.  The pass
# accepts a closed CFG whose blocks partition the op stream and whose terms have
# one owner.  Unreachable blocks remain structurally checked but are excluded
# from RPO and dataflow.  LocalSlot is not SSA: every semantic definition
# has a distinct valueId supplied by body_ir_access, and every live multi-input
# block gets a deterministic merge value plus ordered incoming edge values.

const
    BodyIrCfgVersionNoValue = -1
    BodyIrCfgVersionUnknown = -3
    BodyIrCfgVersionNoGeneration = -4

    BodyIrCfgErrorNone = 0
    BodyIrCfgErrorAccessInvalid = 1
    BodyIrCfgErrorEmpty = 2
    BodyIrCfgErrorBlockId = 3
    BodyIrCfgErrorBlockRange = 4
    BodyIrCfgErrorTermRef = 5
    BodyIrCfgErrorTermOwnership = 6
    BodyIrCfgErrorEdge = 7
    BodyIrCfgErrorFactShape = 9
    BodyIrCfgErrorUninitializedUse = 11
    BodyIrCfgErrorTypeConflict = 12

type
    BodyIrCfgAnalysis =
        valid: bool
        errorCode: int32
        errorBlock: int32 = -1
        errorSlot: int32 = -1
        errorDetail: int32
        blockCount: int32
        slotCount: int32
        edgeCount: int32
        succOffsets: int32[]
        succBlocks: int32[]
        predOffsets: int32[]
        predBlocks: int32[]
        reachable: bool[]
        reversePostorder: int32[]
        hasCycle: bool
        opOwnerBlocks: int32[]
        termOwnerBlocks: int32[]
        factOwnerBlocks: int32[]
        blockUse: bool[]
        blockDef: bool[]
        liveIn: bool[]
        liveOut: bool[]
        blockEntryVersions: int32[]
        blockExitVersions: int32[]
        blockLastDefValues: int32[]
        blockInitIn: bool[]
        blockInitOut: bool[]
        mergeValueByBlockSlot: int32[]
        mergeInputStarts: int32[]
        mergeInputCounts: int32[]
        mergeInputPredecessors: int32[]
        mergeInputValues: int32[]
        valueSlotIndices: int32[]
        valueTypeKinds: int32[]
        reachingValueByFact: int32[]
        valueCount: int32
        livenessProcessCount: int32
        initializationProcessCount: int32
        versionProcessCount: int32

fn bodyIrCfgIntSeq(count: int32, value: int32): int32[] =
    var out: int32[]
    for _ in 0..<count:
        add(out, value)
    return out

fn bodyIrCfgBoolSeq(count: int32, value: bool): bool[] =
    var out: bool[]
    for _ in 0..<count:
        add(out, value)
    return out

fn bodyIrCfgFail(out: var BodyIrCfgAnalysis,
                 code: int32,
                 blockIndex: int32,
                 slotIndex: int32,
                 detail: int32) =
    if out.valid:
        out.errorCode = code
        out.errorBlock = blockIndex
        out.errorSlot = slotIndex
        out.errorDetail = detail
    out.valid = false

fn bodyIrCfgSlotOffset(out: var BodyIrCfgAnalysis,
                       blockIndex: int32,
                       slotIndex: int32): int32 =
    return blockIndex * out.slotCount + slotIndex

fn bodyIrCfgReachablePredCount(out: var BodyIrCfgAnalysis,
                               blockIndex: int32): int32 =
    var count: int32
    for predIndex in out.predOffsets[blockIndex]..<out.predOffsets[blockIndex + 1]:
        if out.reachable[out.predBlocks[predIndex]]:
            count = count + 1
    return count

fn bodyIrCfgFirstReachablePred(out: var BodyIrCfgAnalysis,
                               blockIndex: int32): int32 =
    for predIndex in out.predOffsets[blockIndex]..<out.predOffsets[blockIndex + 1]:
        let predecessor = out.predBlocks[predIndex]
        if out.reachable[predecessor]:
            return predecessor
    return -1

fn bodyIrCfgBuildOwners(bodyIR: var coreir.BodyIR,
                        out: var BodyIrCfgAnalysis): bool =
    if bodyIR.blocks.len <= 0:
        bodyIrCfgFail(out, BodyIrCfgErrorEmpty, -1, -1, bodyIR.blocks.len)
        return false
    out.opOwnerBlocks = bodyIrCfgIntSeq(bodyIR.ops.len, -1)
    out.termOwnerBlocks = bodyIrCfgIntSeq(bodyIR.terms.len, -1)
    var expectedOpStart: int32
    for blockIndex in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockIndex]
        if block.id != blockIndex:
            bodyIrCfgFail(out, BodyIrCfgErrorBlockId,
                          blockIndex, -1, block.id)
            return false
        if block.opStart != expectedOpStart || block.opCount < 0 ||
           block.opStart + block.opCount > bodyIR.ops.len:
            bodyIrCfgFail(out, BodyIrCfgErrorBlockRange,
                          blockIndex, -1, block.opStart)
            return false
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            if out.opOwnerBlocks[opIndex] >= 0:
                bodyIrCfgFail(out, BodyIrCfgErrorBlockRange,
                              blockIndex, -1, opIndex)
                return false
            out.opOwnerBlocks[opIndex] = blockIndex
        expectedOpStart = block.opStart + block.opCount
        if block.termIndex < 0 || block.termIndex >= bodyIR.terms.len:
            bodyIrCfgFail(out, BodyIrCfgErrorTermRef,
                          blockIndex, -1, block.termIndex)
            return false
        if out.termOwnerBlocks[block.termIndex] >= 0:
            bodyIrCfgFail(out, BodyIrCfgErrorTermOwnership,
                          blockIndex, -1, block.termIndex)
            return false
        out.termOwnerBlocks[block.termIndex] = blockIndex
    if expectedOpStart != bodyIR.ops.len:
        bodyIrCfgFail(out, BodyIrCfgErrorBlockRange,
                      bodyIR.blocks.len - 1, -1, expectedOpStart)
        return false
    for termIndex in 0..<bodyIR.terms.len:
        if out.termOwnerBlocks[termIndex] < 0:
            bodyIrCfgFail(out, BodyIrCfgErrorTermOwnership,
                          -1, -1, termIndex)
            return false
    return true

fn bodyIrCfgAppendEdge(out: var BodyIrCfgAnalysis,
                       sourceBlock: int32,
                       targetBlock: int32): bool =
    if targetBlock < 0 || targetBlock >= out.blockCount:
        bodyIrCfgFail(out, BodyIrCfgErrorEdge,
                      sourceBlock, -1, targetBlock)
        return false
    add(out.succBlocks, targetBlock)
    return true

fn bodyIrCfgBuildEdges(bodyIR: var coreir.BodyIR,
                       out: var BodyIrCfgAnalysis): bool =
    add(out.succOffsets, 0)
    for blockIndex in 0..<bodyIR.blocks.len:
        let term = bodyIR.terms[bodyIR.blocks[blockIndex].termIndex]
        if term.kind == coreir.BodyTermBrTag:
            if !bodyIrCfgAppendEdge(out, blockIndex, term.trueBlock):
                return false
        elif term.kind == coreir.BodyTermCbrTag:
            if !bodyIrCfgAppendEdge(out, blockIndex, term.trueBlock):
                return false
            if term.falseBlock != term.trueBlock:
                if !bodyIrCfgAppendEdge(out, blockIndex, term.falseBlock):
                    return false
        elif term.kind != coreir.BodyTermReturnTag:
            bodyIrCfgFail(out, BodyIrCfgErrorTermRef,
                          blockIndex, -1, term.kind)
            return false
        add(out.succOffsets, out.succBlocks.len)
    out.edgeCount = out.succBlocks.len
    out.predOffsets = bodyIrCfgIntSeq(out.blockCount + 1, 0)
    for edgeIndex in 0..<out.succBlocks.len:
        let target = out.succBlocks[edgeIndex]
        out.predOffsets[target + 1] = out.predOffsets[target + 1] + 1
    for offsetIndex in 1..<out.predOffsets.len:
        out.predOffsets[offsetIndex] = out.predOffsets[offsetIndex] +
                                       out.predOffsets[offsetIndex - 1]
    out.predBlocks = bodyIrCfgIntSeq(out.edgeCount, -1)
    var cursors = bodyIrCfgIntSeq(out.blockCount, 0)
    for blockIndex in 0..<out.blockCount:
        cursors[blockIndex] = out.predOffsets[blockIndex]
    for sourceBlock in 0..<out.blockCount:
        for edgeIndex in out.succOffsets[sourceBlock]..<out.succOffsets[sourceBlock + 1]:
            let targetBlock = out.succBlocks[edgeIndex]
            let writeIndex = cursors[targetBlock]
            out.predBlocks[writeIndex] = sourceBlock
            cursors[targetBlock] = writeIndex + 1
    return true

fn bodyIrCfgBuildReachability(out: var BodyIrCfgAnalysis): bool =
    out.reachable = bodyIrCfgBoolSeq(out.blockCount, false)
    var colors = bodyIrCfgIntSeq(out.blockCount, 0)
    var stackBlocks = bodyIrCfgIntSeq(out.blockCount, 0)
    var stackNextEdges = bodyIrCfgIntSeq(out.blockCount, 0)
    var postorder: int32[]
    var stackDepth = 1
    stackBlocks[0] = 0
    stackNextEdges[0] = out.succOffsets[0]
    colors[0] = 1
    out.reachable[0] = true
    while stackDepth > 0:
        let topIndex = stackDepth - 1
        let blockIndex = stackBlocks[topIndex]
        let nextEdge = stackNextEdges[topIndex]
        if nextEdge < out.succOffsets[blockIndex + 1]:
            let targetBlock = out.succBlocks[nextEdge]
            stackNextEdges[topIndex] = nextEdge + 1
            if colors[targetBlock] == 0:
                colors[targetBlock] = 1
                out.reachable[targetBlock] = true
                stackBlocks[stackDepth] = targetBlock
                stackNextEdges[stackDepth] = out.succOffsets[targetBlock]
                stackDepth = stackDepth + 1
            elif colors[targetBlock] == 1:
                out.hasCycle = true
        else:
            colors[blockIndex] = 2
            add(postorder, blockIndex)
            stackDepth = stackDepth - 1
    var postIndex = postorder.len - 1
    while postIndex >= 0:
        add(out.reversePostorder, postorder[postIndex])
        postIndex = postIndex - 1
    return true

fn bodyIrCfgRecordFact(bodyIR: var coreir.BodyIR,
                       accessTable: var bodyaccess.BodyIrAccessTable,
                       out: var BodyIrCfgAnalysis,
                       factIndex: int32,
                       blockIndex: int32,
                       seenDef: var bool[]): bool =
    if factIndex < 0 || factIndex >= accessTable.facts.len:
        bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                      blockIndex, -1, factIndex)
        return false
    let fact = accessTable.facts[factIndex]
    if fact.kind < bodyaccess.BodyIrAccessFactUse ||
       fact.kind > bodyaccess.BodyIrAccessFactAddress:
        bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                      blockIndex, -1, fact.kind)
        return false
    if fact.kind == bodyaccess.BodyIrAccessFactAddress:
        if fact.slotIndex < 0 || fact.slotIndex >= bodyIR.localSlots.len ||
           !fact.addressEscapes:
            bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                          blockIndex, fact.slotIndex, factIndex)
            return false
        if fact.typeKind != bodyIR.localSlots[fact.slotIndex].typeKind:
            bodyIrCfgFail(out, BodyIrCfgErrorTypeConflict,
                          blockIndex, fact.slotIndex, fact.typeKind)
            return false
        return true
    if fact.kind != bodyaccess.BodyIrAccessFactUse &&
       fact.kind != bodyaccess.BodyIrAccessFactDef:
        return true
    let slotIndex = fact.slotIndex
    if slotIndex < 0 || slotIndex >= bodyIR.localSlots.len:
        bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                      blockIndex, slotIndex, factIndex)
        return false
    if fact.typeKind != bodyIR.localSlots[slotIndex].typeKind:
        bodyIrCfgFail(out, BodyIrCfgErrorTypeConflict,
                      blockIndex, slotIndex, fact.typeKind)
        return false
    let slotOffset = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
    if fact.kind == bodyaccess.BodyIrAccessFactUse:
        if !seenDef[slotIndex]:
            out.blockUse[slotOffset] = true
        return true
    if fact.valueId < 0 || fact.valueId >= accessTable.nextValueId:
        bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                      blockIndex, slotIndex, fact.valueId)
        return false
    seenDef[slotIndex] = true
    out.blockDef[slotOffset] = true
    out.blockLastDefValues[slotOffset] = fact.valueId
    return true

fn bodyIrCfgRecordFactRange(bodyIR: var coreir.BodyIR,
                            accessTable: var bodyaccess.BodyIrAccessTable,
                            out: var BodyIrCfgAnalysis,
                            blockIndex: int32,
                            start: int32,
                            count: int32,
                            expectedSiteKind: int32,
                            expectedSiteIndex: int32,
                            seenDef: var bool[]): bool =
    if start < 0 || count < 0 || start + count > accessTable.facts.len:
        bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                      blockIndex, -1, start)
        return false
    for factIndex in start..<(start + count):
        let fact = accessTable.facts[factIndex]
        if fact.siteKind != expectedSiteKind ||
           fact.siteIndex != expectedSiteIndex ||
           out.factOwnerBlocks[factIndex] >= 0:
            bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                          blockIndex, fact.slotIndex, factIndex)
            return false
        out.factOwnerBlocks[factIndex] = blockIndex
        if !bodyIrCfgRecordFact(bodyIR, accessTable, out,
                                factIndex, blockIndex, seenDef):
            return false
    return true

fn bodyIrCfgBuildBlockFacts(bodyIR: var coreir.BodyIR,
                            accessTable: var bodyaccess.BodyIrAccessTable,
                            out: var BodyIrCfgAnalysis): bool =
    if accessTable.opFactStarts.len != bodyIR.ops.len ||
       accessTable.opFactCounts.len != bodyIR.ops.len ||
       accessTable.termFactStarts.len != bodyIR.terms.len ||
       accessTable.termFactCounts.len != bodyIR.terms.len ||
       accessTable.entryValueIdsBySlot.len != bodyIR.localSlots.len ||
       accessTable.valueSlotIndices.len != accessTable.nextValueId ||
       accessTable.valueTypeKinds.len != accessTable.nextValueId:
        bodyIrCfgFail(out, BodyIrCfgErrorFactShape, -1, -1,
                      accessTable.facts.len)
        return false
    out.factOwnerBlocks = bodyIrCfgIntSeq(accessTable.facts.len, -1)
    let flatCount = out.blockCount * out.slotCount
    out.blockUse = bodyIrCfgBoolSeq(flatCount, false)
    out.blockDef = bodyIrCfgBoolSeq(flatCount, false)
    out.blockLastDefValues = bodyIrCfgIntSeq(flatCount,
                                             BodyIrCfgVersionNoGeneration)
    var seenValues = bodyIrCfgBoolSeq(accessTable.nextValueId, false)
    for factIndex in 0..<accessTable.facts.len:
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactDef:
            if fact.valueId < 0 || fact.valueId >= accessTable.nextValueId ||
               seenValues[fact.valueId] ||
               accessTable.valueSlotIndices[fact.valueId] != fact.slotIndex ||
               accessTable.valueTypeKinds[fact.valueId] != fact.typeKind:
                bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                              -1, fact.slotIndex, fact.valueId)
                return false
            seenValues[fact.valueId] = true
        if fact.siteKind == bodyaccess.BodyIrAccessSiteEntry:
            if fact.kind != bodyaccess.BodyIrAccessFactDef ||
               fact.siteIndex != fact.slotIndex ||
               fact.slotIndex < 0 || fact.slotIndex >= out.slotCount ||
               accessTable.entryValueIdsBySlot[fact.slotIndex] != fact.valueId:
                bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                              -1, fact.slotIndex, factIndex)
                return false
    for valueId in 0..<seenValues.len:
        if !seenValues[valueId]:
            bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                          -1, -1, valueId)
            return false
    for blockIndex in 0..<out.blockCount:
        var seenDef = bodyIrCfgBoolSeq(out.slotCount, false)
        let block = bodyIR.blocks[blockIndex]
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            if !bodyIrCfgRecordFactRange(bodyIR, accessTable, out,
                                         blockIndex,
                                         accessTable.opFactStarts[opIndex],
                                         accessTable.opFactCounts[opIndex],
                                         bodyaccess.BodyIrAccessSiteOp,
                                         opIndex,
                                         seenDef):
                return false
        let termIndex = block.termIndex
        if !bodyIrCfgRecordFactRange(bodyIR, accessTable, out,
                                     blockIndex,
                                     accessTable.termFactStarts[termIndex],
                                     accessTable.termFactCounts[termIndex],
                                     bodyaccess.BodyIrAccessSiteTerm,
                                     termIndex,
                                     seenDef):
            return false
    for factIndex in 0..<accessTable.facts.len:
        if accessTable.facts[factIndex].siteKind != bodyaccess.BodyIrAccessSiteEntry &&
           out.factOwnerBlocks[factIndex] < 0:
            bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                          -1, accessTable.facts[factIndex].slotIndex,
                          factIndex)
            return false
    return true

fn bodyIrCfgComputeLiveness(out: var BodyIrCfgAnalysis) =
    let flatCount = out.blockCount * out.slotCount
    out.liveIn = bodyIrCfgBoolSeq(flatCount, false)
    out.liveOut = bodyIrCfgBoolSeq(flatCount, false)
    var queue: int32[]
    var queued = bodyIrCfgBoolSeq(out.blockCount, false)
    var rpoIndex = out.reversePostorder.len - 1
    while rpoIndex >= 0:
        let blockIndex = out.reversePostorder[rpoIndex]
        add(queue, blockIndex)
        queued[blockIndex] = true
        rpoIndex = rpoIndex - 1
    var readIndex: int32
    while readIndex < queue.len:
        let blockIndex = queue[readIndex]
        readIndex = readIndex + 1
        queued[blockIndex] = false
        out.livenessProcessCount = out.livenessProcessCount + 1
        var changed: bool
        for slotIndex in 0..<out.slotCount:
            let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            var nextOut: bool
            for edgeIndex in out.succOffsets[blockIndex]..<out.succOffsets[blockIndex + 1]:
                let successor = out.succBlocks[edgeIndex]
                if out.liveIn[bodyIrCfgSlotOffset(out, successor, slotIndex)]:
                    nextOut = true
            let nextIn = out.blockUse[flatIndex] ||
                         (nextOut && !out.blockDef[flatIndex])
            if out.liveOut[flatIndex] != nextOut:
                out.liveOut[flatIndex] = nextOut
                changed = true
            if out.liveIn[flatIndex] != nextIn:
                out.liveIn[flatIndex] = nextIn
                changed = true
        if changed:
            for predIndex in out.predOffsets[blockIndex]..<out.predOffsets[blockIndex + 1]:
                let predecessor = out.predBlocks[predIndex]
                if out.reachable[predecessor] && !queued[predecessor]:
                    add(queue, predecessor)
                    queued[predecessor] = true

fn bodyIrCfgComputeInitialization(accessTable: var bodyaccess.BodyIrAccessTable,
                                  out: var BodyIrCfgAnalysis): bool =
    let flatCount = out.blockCount * out.slotCount
    out.blockInitIn = bodyIrCfgBoolSeq(flatCount, true)
    out.blockInitOut = bodyIrCfgBoolSeq(flatCount, true)
    for blockIndex in 0..<out.blockCount:
        if !out.reachable[blockIndex]:
            for slotIndex in 0..<out.slotCount:
                let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
                out.blockInitIn[flatIndex] = false
                out.blockInitOut[flatIndex] = false
    var queue: int32[]
    var queued = bodyIrCfgBoolSeq(out.blockCount, false)
    for rpoIndex in 0..<out.reversePostorder.len:
        let blockIndex = out.reversePostorder[rpoIndex]
        add(queue, blockIndex)
        queued[blockIndex] = true
    var readIndex: int32
    while readIndex < queue.len:
        let blockIndex = queue[readIndex]
        readIndex = readIndex + 1
        queued[blockIndex] = false
        out.initializationProcessCount = out.initializationProcessCount + 1
        var outChanged: bool
        for slotIndex in 0..<out.slotCount:
            var sourceCount: int32
            var nextIn = true
            if blockIndex == 0:
                sourceCount = 1
                nextIn = accessTable.entryValueIdsBySlot[slotIndex] >= 0
            for predIndex in out.predOffsets[blockIndex]..<out.predOffsets[blockIndex + 1]:
                let predecessor = out.predBlocks[predIndex]
                if !out.reachable[predecessor]:
                    continue
                let predecessorOffset = bodyIrCfgSlotOffset(out,
                                                            predecessor,
                                                            slotIndex)
                let predecessorInitialized = out.blockInitOut[predecessorOffset]
                if sourceCount == 0:
                    nextIn = predecessorInitialized
                else:
                    nextIn = nextIn && predecessorInitialized
                sourceCount = sourceCount + 1
            if sourceCount == 0:
                nextIn = false
            let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            let nextOut = out.blockDef[flatIndex] || nextIn
            out.blockInitIn[flatIndex] = nextIn
            if out.blockInitOut[flatIndex] != nextOut:
                out.blockInitOut[flatIndex] = nextOut
                outChanged = true
        if outChanged:
            for edgeIndex in out.succOffsets[blockIndex]..<out.succOffsets[blockIndex + 1]:
                let successor = out.succBlocks[edgeIndex]
                if !queued[successor]:
                    add(queue, successor)
                    queued[successor] = true
    for blockIndex in 0..<out.blockCount:
        if !out.reachable[blockIndex]:
            continue
        for slotIndex in 0..<out.slotCount:
            let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            if out.liveIn[flatIndex] && !out.blockInitIn[flatIndex]:
                bodyIrCfgFail(out, BodyIrCfgErrorUninitializedUse,
                              blockIndex, slotIndex,
                              BodyIrCfgVersionNoValue)
                return false
    return true

fn bodyIrCfgAllocateMerges(bodyIR: var coreir.BodyIR,
                           accessTable: var bodyaccess.BodyIrAccessTable,
                           out: var BodyIrCfgAnalysis) =
    let flatCount = out.blockCount * out.slotCount
    out.mergeValueByBlockSlot = bodyIrCfgIntSeq(flatCount,
                                                BodyIrCfgVersionNoValue)
    out.mergeInputStarts = bodyIrCfgIntSeq(flatCount, -1)
    out.mergeInputCounts = bodyIrCfgIntSeq(flatCount, 0)
    for valueId in 0..<accessTable.nextValueId:
        add(out.valueSlotIndices, accessTable.valueSlotIndices[valueId])
        add(out.valueTypeKinds, accessTable.valueTypeKinds[valueId])
    var nextValueId = accessTable.nextValueId
    for blockIndex in 0..<out.blockCount:
        if !out.reachable[blockIndex]:
            continue
        var sourceCount = bodyIrCfgReachablePredCount(out, blockIndex)
        if blockIndex == 0:
            sourceCount = sourceCount + 1
        if sourceCount < 2:
            continue
        for slotIndex in 0..<out.slotCount:
            let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            if out.liveIn[flatIndex]:
                out.mergeValueByBlockSlot[flatIndex] = nextValueId
                add(out.valueSlotIndices, slotIndex)
                add(out.valueTypeKinds, bodyIR.localSlots[slotIndex].typeKind)
                nextValueId = nextValueId + 1
    out.valueCount = nextValueId

fn bodyIrCfgBuildMergeInputs(accessTable: var bodyaccess.BodyIrAccessTable,
                             out: var BodyIrCfgAnalysis): bool =
    for blockIndex in 0..<out.blockCount:
        if !out.reachable[blockIndex]:
            continue
        for slotIndex in 0..<out.slotCount:
            let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            if out.mergeValueByBlockSlot[flatIndex] < 0:
                continue
            out.mergeInputStarts[flatIndex] = out.mergeInputValues.len
            if blockIndex == 0:
                let entryValue = accessTable.entryValueIdsBySlot[slotIndex]
                if entryValue < 0:
                    bodyIrCfgFail(out, BodyIrCfgErrorUninitializedUse,
                                  blockIndex, slotIndex, entryValue)
                    return false
                if entryValue >= out.valueCount ||
                   out.valueSlotIndices[entryValue] != slotIndex ||
                   out.valueTypeKinds[entryValue] !=
                       out.valueTypeKinds[out.mergeValueByBlockSlot[flatIndex]]:
                    bodyIrCfgFail(out, BodyIrCfgErrorTypeConflict,
                                  blockIndex, slotIndex, entryValue)
                    return false
                add(out.mergeInputPredecessors, -1)
                add(out.mergeInputValues, entryValue)
            for predIndex in out.predOffsets[blockIndex]..<out.predOffsets[blockIndex + 1]:
                let predecessor = out.predBlocks[predIndex]
                if !out.reachable[predecessor]:
                    continue
                let predecessorOffset = bodyIrCfgSlotOffset(out,
                                                            predecessor,
                                                            slotIndex)
                let incomingValue = out.blockExitVersions[predecessorOffset]
                if incomingValue < 0:
                    bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                                  blockIndex, slotIndex, incomingValue)
                    return false
                if incomingValue >= out.valueCount ||
                   out.valueSlotIndices[incomingValue] != slotIndex ||
                   out.valueTypeKinds[incomingValue] !=
                       out.valueTypeKinds[out.mergeValueByBlockSlot[flatIndex]]:
                    bodyIrCfgFail(out, BodyIrCfgErrorTypeConflict,
                                  blockIndex, slotIndex, incomingValue)
                    return false
                add(out.mergeInputPredecessors, predecessor)
                add(out.mergeInputValues, incomingValue)
            out.mergeInputCounts[flatIndex] = out.mergeInputValues.len -
                                              out.mergeInputStarts[flatIndex]
    return true

fn bodyIrCfgComputeVersions(bodyIR: var coreir.BodyIR,
                            accessTable: var bodyaccess.BodyIrAccessTable,
                            out: var BodyIrCfgAnalysis): bool =
    let flatCount = out.blockCount * out.slotCount
    out.blockEntryVersions = bodyIrCfgIntSeq(flatCount,
                                             BodyIrCfgVersionUnknown)
    out.blockExitVersions = bodyIrCfgIntSeq(flatCount,
                                            BodyIrCfgVersionUnknown)
    if out.slotCount <= 0:
        out.valueCount = accessTable.nextValueId
        return true
    if !bodyIrCfgComputeInitialization(accessTable, out):
        return false
    bodyIrCfgAllocateMerges(bodyIR, accessTable, out)
    var queue: int32[]
    var queued = bodyIrCfgBoolSeq(out.blockCount, false)
    add(queue, 0)
    queued[0] = true
    var readIndex: int32
    while readIndex < queue.len:
        let blockIndex = queue[readIndex]
        readIndex = readIndex + 1
        queued[blockIndex] = false
        out.versionProcessCount = out.versionProcessCount + 1
        var exitChanged: bool
        for slotIndex in 0..<out.slotCount:
            let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            var nextEntry = BodyIrCfgVersionNoValue
            if out.liveIn[flatIndex]:
                if out.mergeValueByBlockSlot[flatIndex] >= 0:
                    nextEntry = out.mergeValueByBlockSlot[flatIndex]
                elif blockIndex == 0:
                    nextEntry = accessTable.entryValueIdsBySlot[slotIndex]
                elif bodyIrCfgReachablePredCount(out, blockIndex) == 1:
                    let predecessor = bodyIrCfgFirstReachablePred(out,
                                                                  blockIndex)
                    let predecessorOffset = bodyIrCfgSlotOffset(out,
                                                                predecessor,
                                                                slotIndex)
                    nextEntry = out.blockExitVersions[predecessorOffset]
            out.blockEntryVersions[flatIndex] = nextEntry
            var nextExit = nextEntry
            if out.blockLastDefValues[flatIndex] >= 0:
                nextExit = out.blockLastDefValues[flatIndex]
            if out.blockExitVersions[flatIndex] != nextExit:
                out.blockExitVersions[flatIndex] = nextExit
                exitChanged = true
        if exitChanged:
            for edgeIndex in out.succOffsets[blockIndex]..<out.succOffsets[blockIndex + 1]:
                let successor = out.succBlocks[edgeIndex]
                if !queued[successor]:
                    add(queue, successor)
                    queued[successor] = true
    for blockIndex in 0..<out.blockCount:
        if !out.reachable[blockIndex]:
            continue
        for slotIndex in 0..<out.slotCount:
            let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            if (out.liveIn[flatIndex] &&
                out.blockEntryVersions[flatIndex] < 0) ||
               out.blockExitVersions[flatIndex] == BodyIrCfgVersionUnknown:
                bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                              blockIndex, slotIndex,
                              BodyIrCfgVersionUnknown)
                return false
    return bodyIrCfgBuildMergeInputs(accessTable, out)

fn bodyIrCfgResolveFactRange(accessTable: var bodyaccess.BodyIrAccessTable,
                             out: var BodyIrCfgAnalysis,
                             blockIndex: int32,
                             start: int32,
                             count: int32,
                             currentVersions: var int32[]): bool =
    for factIndex in start..<(start + count):
        let fact = accessTable.facts[factIndex]
        if fact.kind == bodyaccess.BodyIrAccessFactUse:
            let reachingValue = currentVersions[fact.slotIndex]
            if reachingValue < 0:
                bodyIrCfgFail(out, BodyIrCfgErrorUninitializedUse,
                              blockIndex, fact.slotIndex, factIndex)
                return false
            if reachingValue >= out.valueCount ||
               out.valueSlotIndices[reachingValue] != fact.slotIndex ||
               out.valueTypeKinds[reachingValue] != fact.typeKind:
                bodyIrCfgFail(out, BodyIrCfgErrorTypeConflict,
                              blockIndex, fact.slotIndex, reachingValue)
                return false
            out.reachingValueByFact[factIndex] = reachingValue
        elif fact.kind == bodyaccess.BodyIrAccessFactDef:
            currentVersions[fact.slotIndex] = fact.valueId
            out.reachingValueByFact[factIndex] = fact.valueId
    return true

fn bodyIrCfgResolveUses(bodyIR: var coreir.BodyIR,
                        accessTable: var bodyaccess.BodyIrAccessTable,
                        out: var BodyIrCfgAnalysis): bool =
    out.reachingValueByFact = bodyIrCfgIntSeq(accessTable.facts.len,
                                              BodyIrCfgVersionNoValue)
    for factIndex in 0..<accessTable.facts.len:
        let fact = accessTable.facts[factIndex]
        if fact.siteKind == bodyaccess.BodyIrAccessSiteEntry:
            out.reachingValueByFact[factIndex] = fact.valueId
    for blockIndex in 0..<out.blockCount:
        if !out.reachable[blockIndex]:
            continue
        var currentVersions = bodyIrCfgIntSeq(out.slotCount,
                                              BodyIrCfgVersionNoValue)
        for slotIndex in 0..<out.slotCount:
            let entryOffset = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            currentVersions[slotIndex] = out.blockEntryVersions[entryOffset]
        let block = bodyIR.blocks[blockIndex]
        for opIndex in block.opStart..<(block.opStart + block.opCount):
            if !bodyIrCfgResolveFactRange(accessTable, out, blockIndex,
                                          accessTable.opFactStarts[opIndex],
                                          accessTable.opFactCounts[opIndex],
                                          currentVersions):
                return false
        let termIndex = block.termIndex
        if !bodyIrCfgResolveFactRange(accessTable, out, blockIndex,
                                      accessTable.termFactStarts[termIndex],
                                      accessTable.termFactCounts[termIndex],
                                      currentVersions):
            return false
        for slotIndex in 0..<out.slotCount:
            let exitOffset = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
            let expected = out.blockExitVersions[exitOffset]
            if currentVersions[slotIndex] != expected:
                bodyIrCfgFail(out, BodyIrCfgErrorFactShape,
                              blockIndex, slotIndex,
                              currentVersions[slotIndex])
                return false
    return true

fn BodyIrCfgAnalyze(bodyIR: var coreir.BodyIR,
                    accessTable: var bodyaccess.BodyIrAccessTable): BodyIrCfgAnalysis =
    var out: BodyIrCfgAnalysis
    out.valid = true
    out.blockCount = bodyIR.blocks.len
    out.slotCount = bodyIR.localSlots.len
    if !accessTable.valid:
        bodyIrCfgFail(out, BodyIrCfgErrorAccessInvalid,
                      -1, -1, accessTable.errorCode)
        return out
    if !bodyIrCfgBuildOwners(bodyIR, out):
        return out
    if !bodyIrCfgBuildEdges(bodyIR, out):
        return out
    if !bodyIrCfgBuildReachability(out):
        return out
    if !bodyIrCfgBuildBlockFacts(bodyIR, accessTable, out):
        return out
    bodyIrCfgComputeLiveness(out)
    if !bodyIrCfgComputeVersions(bodyIR, accessTable, out):
        return out
    if !bodyIrCfgResolveUses(bodyIR, accessTable, out):
        return out
    return out

fn BodyIrCfgDecodeAndAnalyze(bodyIR: var coreir.BodyIR): BodyIrCfgAnalysis =
    var accessTable = bodyaccess.BodyIrAccessDecode(bodyIR)
    return BodyIrCfgAnalyze(bodyIR, accessTable)

fn BodyIrCfgLiveInAt(out: var BodyIrCfgAnalysis,
                     blockIndex: int32,
                     slotIndex: int32): bool =
    if blockIndex < 0 || blockIndex >= out.blockCount ||
       slotIndex < 0 || slotIndex >= out.slotCount:
        return false
    return out.liveIn[bodyIrCfgSlotOffset(out, blockIndex, slotIndex)]

fn BodyIrCfgLiveOutAt(out: var BodyIrCfgAnalysis,
                      blockIndex: int32,
                      slotIndex: int32): bool =
    if blockIndex < 0 || blockIndex >= out.blockCount ||
       slotIndex < 0 || slotIndex >= out.slotCount:
        return false
    return out.liveOut[bodyIrCfgSlotOffset(out, blockIndex, slotIndex)]

fn BodyIrCfgEntryVersionAt(out: var BodyIrCfgAnalysis,
                           blockIndex: int32,
                           slotIndex: int32): int32 =
    if blockIndex < 0 || blockIndex >= out.blockCount ||
       slotIndex < 0 || slotIndex >= out.slotCount:
        return BodyIrCfgVersionUnknown
    let flatIndex = bodyIrCfgSlotOffset(out, blockIndex, slotIndex)
    return out.blockEntryVersions[flatIndex]

fn BodyIrCfgReachingValueAt(out: var BodyIrCfgAnalysis,
                            factIndex: int32): int32 =
    if factIndex < 0 || factIndex >= out.reachingValueByFact.len:
        return BodyIrCfgVersionUnknown
    return out.reachingValueByFact[factIndex]
