module csg_web_facts

import cheng/core/ir/core_types as coreir

# -------------------------------------------------------------------
# CSG-Web fact schema: type-level formalization of every fact kind.
# The types here mirror the TypeScript interfaces in ts-csg/src/
# and are the single source of truth for the Cheng runtime.
# -------------------------------------------------------------------

const CSG_WEB_SCHEMA_VERSION = 1
const CSG_WEB_FEATURE_JS = 0x01
const CSG_WEB_FEATURE_REACT = 0x02
const CSG_WEB_FEATURE_DOM = 0x04
const CSG_WEB_FEATURE_CSS = 0x08
const CSG_WEB_FEATURE_EVENT = 0x10
const CSG_WEB_FEATURE_LAYOUT = 0x20
const CSG_WEB_FEATURE_PAINT = 0x40

type CsgWebModuleHeader =
    schemaVersion: int32
    featureBits: int32
    sourcePath: str
    timestamp: int64
    contentHash: str       # SHA256 of facts body

type
    # --- fact discriminator tags  (matches allowedWebFactKinds) ---
    CsgWebFactKind = enum
        CsgWebSchema,
        CsgWebProject,
        CsgWebModuleImportRef,
        CsgWebJsFunctionRef,
        CsgWebJsCallRef,
        CsgWebJsClassRef,
        CsgWebJsClassHeritageRef,
        CsgWebJsxElement,
        CsgWebDomNodeTemplate,
        CsgWebControlSurface,
        CsgWebVoiceComputerUseScenario,
        CsgWebComputerUseAction,
        CsgWebVoiceTaskTemplate,
        CsgWebVoiceTaskStep,
        CsgWebConfirmationGate,
        CsgWebSubgraphCid,
        CsgWebRuntimeRequirement,
        CsgWebExternalSymbol,
        CsgWebUnsupportedRef,
        CsgWebMediaAsset,
        CsgWebMediaPlaybackSlot,
        CsgWebMediaControlAction,
        CsgWebMediaControlReceipt,
        CsgWebMediaLifecycleEvent,
        CsgWebMediaFrameReceipt,
        CsgWebMediaReceiptIdentity,
        CsgWebMediaDeliveryReceipt

    # --- Source location (shared) ---
    CsgWebSourceLoc =
        file: str
        line: int32
        column: int32
        start: int32
        end: int32

    # ==================================================================
    # schema fact  "csg.web.schema"
    # ==================================================================
    CsgWebSchemaFact =
        kind: CsgWebFactKind          # = CsgWebSchema
        language: str                 # "typescript"
        schema: str                   # "csg-web"
        features: str[]               # feature flags
        extends: str                  # "csg-core"

    # ==================================================================
    # project fact  "csg.web.project"
    # ==================================================================
    CsgWebProjectFact =
        kind: CsgWebFactKind          # = CsgWebProject
        id: str
        coreSchema: str               # "csg-core"
        projectRoot: str
        projectFile: str?
        runtimes: str[]
        entryRoots: str[]
        engineDependency: str         # "none"
        runtimeTarget: str            # "cheng-web-runtime"
        coreFactCount: int32

    # ==================================================================
    # module import ref  "csg.web.module_import_ref"
    # ==================================================================
    CsgWebModuleImportRefFact =
        kind: CsgWebFactKind          # = CsgWebModuleImportRef
        id: str
        coreFact: str
        module: str
        moduleName: str
        importKind: str
        runtime: str
        loc: CsgWebSourceLoc?

    # ==================================================================
    # function ref  "csg.web.js_function_ref"
    # ==================================================================
    CsgWebJsFunctionRefFact =
        kind: CsgWebFactKind          # = CsgWebJsFunctionRef
        id: str
        coreFact: str
        name: str
        async: bool
        generator: bool
        exported: bool
        parameters: int32
        returnType: str?
        loc: CsgWebSourceLoc?

    # ==================================================================
    # call ref  "csg.web.js_call_ref"
    # ==================================================================
    CsgWebJsCallRefFact =
        kind: CsgWebFactKind          # = CsgWebJsCallRef
        id: str
        coreFact: str
        owner: str
        targetText: str
        argumentCount: int32
        optionalChain: bool
        receiver: str?
        memberName: str?
        loc: CsgWebSourceLoc?

    # ==================================================================
    # class ref  "csg.web.js_class_ref"
    # ==================================================================
    CsgWebJsClassRefFact =
        kind: CsgWebFactKind          # = CsgWebJsClassRef
        id: str
        coreFact: str
        name: str
        symbol: str
        exported: bool
        abstract: bool
        typeParameters: int32
        heritageCount: int32
        loc: CsgWebSourceLoc?

    # ==================================================================
    # class heritage ref  "csg.web.js_class_heritage_ref"
    # ==================================================================
    CsgWebJsClassHeritageRefFact =
        kind: CsgWebFactKind          # = CsgWebJsClassHeritageRef
        id: str
        coreFact: str
        class: str
        heritageKind: str
        expression: str
        target: str?
        typeArguments: int32
        loc: CsgWebSourceLoc?

    # ==================================================================
    # JSX element fact  "csg.web.jsx_element"
    # ==================================================================
    CsgWebJsxProp =
        name: str
        value: str

    CsgWebJsxChild =
        ref: str?
        coreFact: str?
        text: str?

    CsgWebJsxElementFact =
        kind: CsgWebFactKind          # = CsgWebJsxElement
        id: str
        coreFact: str
        owner: str
        tagName: str
        jsxKind: str
        attributeCount: int32
        childCount: int32
        props: CsgWebJsxProp[]
        children: CsgWebJsxChild[]
        lowering: str                 # "react-compatible-runtime"
        loc: CsgWebSourceLoc?

    # ==================================================================
    # DOM node template  "csg.web.dom_node_template"
    # ==================================================================
    CsgWebDomNodeTemplateFact =
        kind: CsgWebFactKind          # = CsgWebDomNodeTemplate
        id: str
        coreFact: str
        owner: str
        tagName: str
        nodeKind: str                 # "element" | "text"
        domain: str
        attributeCount: int32
        childCount: int32
        props: CsgWebJsxProp[]
        children: CsgWebJsxChild[]
        runtimeTarget: str            # "cheng-web-runtime"
        loc: CsgWebSourceLoc?

    # ==================================================================
    # Control surface fact  "csg.web.control_surface"
    # ==================================================================
    CsgWebControlSurfaceFact =
        kind: CsgWebFactKind          # = CsgWebControlSurface
        id: str
        coreFact: str
        nodeTemplate: str
        owner: str
        role: str
        label: str
        stateRef: str
        actionKind: str               # "Click" | "SetText" | "Select" | "SelectFile" | "Toggle"
        payloadSchema: str
        effect: str
        guard: str
        trace: str
        sourceFile: str
        sourceLine: int32

    # ==================================================================
    # Voice computer-use scenario  "csg.web.voice_computer_use_scenario"
    # ==================================================================
    CsgWebVoiceComputerUseScenarioFact =
        kind: CsgWebFactKind          # = CsgWebVoiceComputerUseScenario
        id: str
        controlSurface: str
        nodeTemplate: str
        scenarioKind: str             # "voice-command" | "voice-dictation" | "voice-selection" | "voice-toggle"
        role: str
        label: str
        actionKind: str
        payloadSchema: str
        utteranceTemplate: str
        computerUseMode: str          # "typed-control-action"
        automationPath: str
        eventEffect: str
        dispatch: str                 # "event-system"
        visualClickFallback: bool
        hardFailReason: str           # "surface-provider-not-attached"
        trace: str

    # ==================================================================
    # Computer-use action  "csg.web.computer_use_action"
    # ==================================================================
    CsgWebComputerUseActionFact =
        kind: CsgWebFactKind          # = CsgWebComputerUseAction
        id: str
        controlSurface: str
        semanticId: str
        nodeTemplate: str
        owner: str
        role: str
        label: str
        actionKind: str
        payloadSchema: str
        effectClass: str
        guard: str
        trace: str
        dispatch: str                 # "event-system"
        visualClickFallback: bool
        sourceFile: str
        sourceLine: int32

    # ==================================================================
    # Voice task template  "csg.web.voice_task_template"
    # ==================================================================
    CsgWebVoiceTaskTemplateFact =
        kind: CsgWebFactKind          # = CsgWebVoiceTaskTemplate
        id: str
        templateId: str
        taskKind: str
        utterancePatterns: str[]
        stepIds: str[]
        riskPolicy: str

    # ==================================================================
    # Voice task step  "csg.web.voice_task_step"
    # ==================================================================
    CsgWebVoiceTaskStepFact =
        kind: CsgWebFactKind          # = CsgWebVoiceTaskStep
        id: str
        templateId: str
        stepIndex: int32
        computerUseAction: str
        semanticId: str
        targetActionKind: str
        targetRole: str
        targetLabel: str
        targetSourceFile: str
        payloadBinding: str
        effectClass: str
        confirmationRequired: bool
        confirmationGateId: str
        confirmationMode: str
        blockedUntilConfirmed: bool
        guard: str
        trace: str

    # ==================================================================
    # Confirmation gate  "csg.web.confirmation_gate"
    # ==================================================================
    CsgWebConfirmationGateFact =
        kind: CsgWebFactKind          # = CsgWebConfirmationGate
        id: str
        voiceTaskStep: str
        templateId: str
        computerUseAction: str
        semanticId: str
        effectClass: str
        confirmationMode: str
        blockedUntilConfirmed: bool
        confirmIntent: str

    # ==================================================================
    # Subgraph CID fact  "csg.web.subgraph_cid"
    # ==================================================================
    CsgWebSubgraphCidFact =
        kind: CsgWebFactKind          # = CsgWebSubgraphCid
        id: str
        sourceFact: str
        sourceKind: str
        cid: str
        target: str

    # ==================================================================
    # runtime requirement  "csg.web.runtime_requirement"
    # ==================================================================
    CsgWebRuntimeRequirementFact =
        kind: CsgWebFactKind          # = CsgWebRuntimeRequirement
        id: str
        coreRequirement: str
        domain: str
        requirementKind: str          # matches TS "requirementKind" field
        name: str
        runtime: str
        source: str
        providerStatus: str           # "closed" | "open"
        provider: str?
        candidateProvider: str?
        loc: CsgWebSourceLoc?
        owner: str?

    # ==================================================================
    # external symbol  "csg.web.external_symbol"
    # ==================================================================
    CsgWebExternalSymbolFact =
        kind: CsgWebFactKind          # = CsgWebExternalSymbol
        id: str
        coreExternalSymbol: str
        domain: str
        name: str
        runtime: str
        source: str
        providerStatus: str           # "closed" | "open"
        provider: str?
        candidateProvider: str?

    # ==================================================================
    # unsupported ref  "csg.web.unsupported_ref"
    # ==================================================================
    CsgWebUnsupportedRefFact =
        kind: CsgWebFactKind          # = CsgWebUnsupportedRef
        id: str
        coreFact: str
        code: str
        message: str
        owner: str
        loc: CsgWebSourceLoc?

    CsgWebMediaObjectDescriptor =
        objectIndex: int32
        objectId: str
        objectCid: str
        byteOffset: int32
        byteLength: int32
        sourceBlockBytes: int32
        sourceBlockCount: int32
        priority: int32

    CsgWebMediaDropletDescriptor =
        objectIndex: int32
        dropletIndex: int32
        kindCode: int32
        key: str
        peerId: str
        cid: str
        degree: int32
        blockIndexes: int32[]

    # ==================================================================
    # Media asset manifest fact  "csg.web.media_asset"
    # ==================================================================
    CsgWebMediaAssetFact =
        kind: CsgWebFactKind          # = CsgWebMediaAsset
        id: str
        assetCid: str
        bundleCid: str
        mime: str
        kindCode: int32              # 1 video, 2 image, 3 audio
        durationMs: str              # exact decimal int64 string
        codec: str
        posterCid: str?
        initSegmentCid: str?
        initSegmentByteLength: int32
        keyframeIndex: str?
        transport: str               # "moq"
        fecScheme: str               # "lt_xor_v1:experimental" or later RFC6330 profile
        contentSignature: str
        catalogCid: str
        catalogKey: str
        rebuildTemplateCid: str
        rebuildTemplateKey: str
        objectTargetBytes: int32
        sourceBlockBytes: int32
        objectCount: int32
        dropletCount: int32
        objects: CsgWebMediaObjectDescriptor[]
        droplets: CsgWebMediaDropletDescriptor[]

    # ==================================================================
    # Media playback slot fact  "csg.web.media_playback_slot"
    # ==================================================================
    CsgWebMediaPlaybackSlotFact =
        kind: CsgWebFactKind          # = CsgWebMediaPlaybackSlot
        id: str
        slotId: str
        assetFact: str
        assetCid: str
        manifestCid: str
        nodeTemplate: str?
        providerKind: str             # "media-decode-provider"
        stateRef: str
        decodeProvider: str
        textureProvider: str
        audioProvider: str
        objectFit: str

    # ==================================================================
    # Media control action fact  "csg.web.media_control_action"
    # ==================================================================
    CsgWebMediaControlActionFact =
        kind: CsgWebFactKind          # = CsgWebMediaControlAction
        id: str
        slotId: str
        actionKind: str               # Play | Pause | Seek | OpenAsset | EditAsset | PublishAsset | ShareAsset
        payloadSchema: str
        dispatch: str                 # "event-queue"
        guard: str
        trace: str

    # ==================================================================
    # Media control receipt fact  "csg.web.media_control_receipt"
    # ==================================================================
    CsgWebMediaControlReceiptFact =
        kind: CsgWebFactKind          # = CsgWebMediaControlReceipt
        id: str
        receiptCid: str
        slotId: str
        assetCid: str
        kindCode: int32
        actionKind: str               # Play | Pause | Seek | OpenAsset | EditAsset | PublishAsset | ShareAsset
        payloadSchema: str
        payload: str
        dispatch: str                 # "event-queue"
        sourceStateCode: int32
        resultStateCode: int32
        statusCode: int32
        guard: str
        trace: str

    # ==================================================================
    # Media lifecycle event fact  "csg.web.media_lifecycle_event"
    # ==================================================================
    CsgWebMediaLifecycleEventFact =
        kind: CsgWebFactKind          # = CsgWebMediaLifecycleEvent
        id: str
        eventKind: str                # OpenAsset | EditAsset | PublishAsset
        eventCid: str
        slotId: str
        assetCid: str
        bundleCid: str
        manifestCid: str
        kindCode: int32
        payloadSchema: str
        payload: str
        transport: str
        dispatch: str
        guard: str
        sourceStateCode: int32
        resultStateCode: int32
        statusCode: int32
        objectCount: int32
        dropletCount: int32
        trace: str

    # ==================================================================
    # Media frame receipt fact  "csg.web.media_frame_receipt"
    # ==================================================================
    CsgWebMediaFrameReceiptFact =
        kind: CsgWebFactKind          # = CsgWebMediaFrameReceipt
        id: str
        receiptKind: str              # Frame | Image | Audio
        slotId: str
        assetCid: str
        manifestCid: str
        kindCode: int32               # 1 video, 2 image, 3 audio
        firstFrameCid: str
        firstImageCid: str
        firstAudioCid: str
        audioDataCid: str
        bytesReady: int32
        initSegmentCid: str
        initBytesReady: int32
        sourceCode: int32
        verified: bool
        textureProvider: str
        textureHandle: str            # uint64 decimal string
        textureReady: bool
        decodedWidth: int32
        decodedHeight: int32
        pixelFormat: int32
        pixelBufferHandle: str        # uint64 decimal string
        audioProvider: str
        sampleRateHz: int32
        channelCount: int32
        bitsPerSample: int32
        pcmDataOffset: int32
        pcmDataBytes: int32
        startedAtMs: str              # exact decimal int64 string
        elapsedMs: str                # exact decimal int64 string
        openToMediaMs: str            # exact decimal int64 string
        trace: str

    # ==================================================================
    # Media receipt identity fact  "csg.web.media_receipt_identity"
    # ==================================================================
    CsgWebMediaReceiptIdentityFact =
        kind: CsgWebFactKind          # = CsgWebMediaReceiptIdentity
        id: str
        receiptFactId: str            # csg.web.media_frame_receipt.id
        receiptCid: str
        receiptKind: str              # Frame | Image | Audio
        slotId: str
        assetCid: str
        manifestCid: str
        trace: str

    # ==================================================================
    # Media delivery receipt fact  "csg.web.media_delivery_receipt"
    # ==================================================================
    CsgWebMediaDeliveryReceiptFact =
        kind: CsgWebFactKind          # = CsgWebMediaDeliveryReceipt
        id: str
        receiptCid: str
        receiptKind: str              # RemoteFrame | RemoteImage | RemoteAudio
        slotId: str
        assetCid: str
        bundleCid: str
        manifestCid: str
        kindCode: int32               # 1 video, 2 image, 3 audio
        transport: str                # "moq"
        publishEventCid: str
        openEventCid: str
        firstMediaCid: str
        sourceCode: int32
        announcedBytes: int32
        transferredBytes: int32
        bytesReady: int32
        objectCount: int32
        dropletCount: int32
        remoteFetchMs: str            # exact decimal int64 string
        openToMediaMs: str            # exact decimal int64 string
        budgetMs: str                 # exact decimal int64 string
        statusCode: int32
        verified: bool
        guard: str
        trace: str

    # ==================================================================
    # Runtime closure / report types
    # ==================================================================
    CsgWebRuntimeClosureBucket =
        id: str
        domain: str
        count: int32
        closedCount: int32
        openCount: int32
        candidateCount: int32

    CsgWebRuntimeClosure =
        schema: str                   # "csg-web.runtime-closure"
        complete: bool
        requirementCount: int32
        externalSymbolCount: int32
        openRequirementCount: int32
        openExternalSymbolCount: int32
        closedRequirementCount: int32
        closedExternalSymbolCount: int32
        candidateRequirementCount: int32
        candidateExternalSymbolCount: int32
        domainCount: int32
        byDomain: CsgWebRuntimeClosureBucket[]

    CsgWebCounts =
        coreFacts: int32
        webFacts: int32
        sourceFiles: int32
        modules: int32
        jsFunctions: int32
        jsCalls: int32
        jsClasses: int32
        jsObjectLiterals: int32
        jsPropertyAccesses: int32
        jsPropertyWrites: int32
        jsElementAccesses: int32
        jsElementWrites: int32
        jsxElements: int32
        domNodeTemplates: int32
        moduleImports: int32
        runtimeRequirements: int32
        externalSymbols: int32
        unsupported: int32

    CsgWebReport =
        schema: str                   # "csg-web.report"
        complete: bool
        coreComplete: bool
        runtimeImplemented: bool
        runtimeIndependent: bool
        engineDependency: str
        oracleUse: str[]
        projectRoot: str
        projectFile: str?
        runtimes: str[]
        entryRoots: str[]
        counts: CsgWebCounts
        runtimeClosure: CsgWebRuntimeClosure
        blockedReasons: str[]
        controlSurfaceActionCount: int32
        actionableDomControlCount: int32
        controlSurfaceSkippedUnlabeledCount: int32
        controlSurfaceActionableCoveragePercent: int32
        voiceComputerUseScenarioCount: int32
        voiceComputerUseControlCoveragePercent: int32
        computerUseActionCount: int32
        computerUseActionCoveragePercent: int32
        computerUseActionUnresolvedCount: int32
        voiceTaskTemplateCount: int32
        voiceTaskStepCount: int32
        confirmationGateCount: int32
        voiceTaskHighRiskStepCount: int32
        voiceTaskRequiredConfirmationGateCount: int32
        voiceTaskMissingConfirmationGateCount: int32
        voiceTaskBlockedStepCount: int32
        voiceTaskAmbiguousStepCount: int32
        unimakerInternalTaskReady: bool
        subgraphCidCount: int32

    # ==================================================================
    # Top-level fact union discriminator
    # ==================================================================
    CsgWebFactKindTag = CsgWebFactKind

# --- constructor helpers ---
fn CsgWebSourceLocInvalid(): CsgWebSourceLoc =
    var out: CsgWebSourceLoc
    return out
