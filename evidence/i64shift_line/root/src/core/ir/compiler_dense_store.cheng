# CompilerDenseStore: Frozen dense column store for compiler functions.
# Queries use int32 funcId and exact sourcePath+name keys, never tail suffix guesses.

import std/strformat
import std/seqs
import std/strings

type
    CompilerDenseStore =
        bucketCount: int32
        bucketHeads: int32[]
        hashEntryNameHashes: int32[]
        hashEntryFuncIds: int32[]
        hashEntryNext: int32[]
        functionCount: int32
        functionNames: str[]
        functionTailNames: str[]
        functionParamCounts: int32[]
        functionResultTypeTags: int32[]
        functionSourcePaths: str[]
        functionBodyKinds: int32[]
        functionEntryFlags: int32[]
        functionTypedIndices: int32[]
        functionParamTypeTags: int32[]
        functionParamTypeStarts: int32[]
        sourceScopedQueryCount: int32
        sourceScopedQueryHitCount: int32
        sourceScopedQueryMissCount: int32
        frozen: bool
        buildMs: int32

    CompilerDenseStoreReport =
        functionCount: int32
        symbolCount: int32
        bodyCount: int32
        cfgCount: int32
        typedCount: int32
        bodyIrCount: int32
        pointerKeyCount: int32
        suffixGuessCount: int32
        tailAliasCount: int32
        sourceScopedKeyCount: int32
        sourceScopedSourceCount: int32
        sourceScopedNameCollisionCount: int32
        sourceScopedQueryCount: int32
        sourceScopedQueryHitCount: int32
        sourceScopedQueryMissCount: int32
        bucketCount: int32
        hashEntryCount: int32
        buildMs: int32
        frozen: bool

const
    DenseResultInvalidTag = 0
    DenseResultI32Tag = 1
    DenseResultBoolTag = 2
    DenseResultStrTag = 3
    DenseResultCStringTag = 4
    DenseResultPtrTag = 5
    DenseResultI64Tag = 6
    DenseResultF64Tag = 7
    DenseResultU32Tag = 9
    DenseResultVoidTag = 13
    DenseResultOtherTag = 99
    DenseParamInvalidTag = 0
    DenseParamI32Tag = 1
    DenseParamBoolTag = 2
    DenseParamStrTag = 3
    DenseParamCStringTag = 4
    DenseParamPtrTag = 5
    DenseParamI64Tag = 6
    DenseParamF64Tag = 7
    DenseParamU8Tag = 8
    DenseParamU32Tag = 9
    DenseParamOtherTag = 99
    DenseEntryNoneFlag = 0
    DenseEntryIsEntryFlag = 1
    DenseEntryIsExportedFlag = 2
    DenseStoreBodyKindNone = 0
    DenseStoreBodyKindSource = 1
    DenseStoreBodyKindCfg = 2
    DenseStoreBodyKindTyped = 3
    DenseStoreBodyKindBodyIr = 4

fn DenseStoreResultTypeTagInvalid(): int32 =
    return 0

fn DenseStoreResultTypeTagVoid(): int32 =
    return 13

fn DenseStoreResultTypeTagI32(): int32 =
    return 1

fn DenseStoreBodyKindNoneTag(): int32 =
    return DenseStoreBodyKindNone

fn DenseStoreBodyKindSourceTag(): int32 =
    return DenseStoreBodyKindSource

fn DenseStoreBodyKindCfgTag(): int32 =
    return DenseStoreBodyKindCfg

fn DenseStoreBodyKindTypedTag(): int32 =
    return DenseStoreBodyKindTyped

fn DenseStoreBodyKindBodyIrTag(): int32 =
    return DenseStoreBodyKindBodyIr

@borrows
fn DenseStoreResultTypeTagFromTypeText(typeText: str): int32 =
    if typeText == "" || typeText == "void":
        return 13
    if typeText == "int32" || typeText == "int":
        return 1
    if typeText == "bool":
        return 2
    if typeText == "str":
        return 3
    if typeText == "cstring":
        return 4
    if typeText == "ptr":
        return 5
    if typeText == "int64":
        return 6
    if typeText == "f64":
        return 7
    if typeText == "uint8":
        return 8
    if typeText == "uint32":
        return 9
    if typeText == "int32[]" || typeText == "int[]":
        return 11
    if typeText.len > 1 && typeText[0] >= 'A' && typeText[0] <= 'Z':
        return 13
    return 99

@borrows
fn DenseStoreParamTypeTagFromTypeText(typeText: str): int32 =
    if typeText == "int32" || typeText == "int":
        return 1
    if typeText == "bool":
        return 2
    if typeText == "str":
        return 3
    if typeText == "cstring":
        return 4
    if typeText == "ptr":
        return 5
    if typeText == "int64":
        return 6
    if typeText == "f64":
        return 7
    if typeText == "uint8":
        return 8
    if typeText == "uint32":
        return 9
    if typeText.len > 1 && typeText[0] >= 'A' && typeText[0] <= 'Z':
        return 13
    return 99

fn DenseStoreBucketCountForCapacity(capacity: int32): int32 =
    var need = capacity * 2 + 16
    if need < 16:
        need = 16
    var out: int32 = 1
    while out < need:
        out = out * 2
    return out

fn DenseStoreBucketForHash(h: int32, bucketCount: int32): int32 =
    if bucketCount <= 0:
        return 0
    return h & (bucketCount - 1)

@borrows
fn DenseStoreSourceNameHash(sourcePath: str, name: str): int32 =
    var h: int32 = sourcePath.len
    for sourceIndex in 0..<sourcePath.len:
        h = h * 131 + Int32(sourcePath[sourceIndex])
    h = h * 131 + name.len
    for nameIndex in 0..<name.len:
        h = h * 131 + Int32(name[nameIndex])
    if h < 0:
        h = -h
    return h

@borrows
fn DenseStoreHashEntryCount(store: CompilerDenseStore): int32 =
    let count = store.hashEntryFuncIds.len
    if store.hashEntryNameHashes.len != count:
        assert(false, " dense store hash SoA name hash length drift")
    if store.hashEntryNext.len != count:
        assert(false, " dense store hash SoA next length drift")
    return count

fn DenseStoreAssertBuildInputs(functionNames: str[],
                               functionTailNames: str[],
                               functionParamCounts: int32[],
                               functionResultTypeTags: int32[],
                               functionSourcePaths: str[],
                               functionBodyKinds: int32[],
                               functionEntryFlags: int32[],
                               functionTypedIndices: int32[],
                               functionParamTypeTags: int32[],
                               functionParamTypeStarts: int32[]): int32 =
    let count = functionNames.len
    if functionTailNames.len != count:
        assert(false, " dense store build: tail name column length drift")
    if functionParamCounts.len != count:
        assert(false, " dense store build: param count column length drift")
    if functionResultTypeTags.len != count:
        assert(false, " dense store build: result type column length drift")
    if functionSourcePaths.len != count:
        assert(false, " dense store build: source path column length drift")
    if functionBodyKinds.len != count:
        assert(false, " dense store build: body kind column length drift")
    if functionEntryFlags.len != count:
        assert(false, " dense store build: entry flag column length drift")
    if functionTypedIndices.len != count:
        assert(false, " dense store build: typed index column length drift")
    if functionParamTypeStarts.len != count + 1:
        assert(false, " dense store build: param type CSR sentinel missing")
    var previousStart: int32
    for funcId in 0..<count:
        let start = functionParamTypeStarts[funcId]
        let end = functionParamTypeStarts[funcId + 1]
        if start < previousStart:
            assert(false, " dense store build: param type CSR is not monotonic")
        if end < start:
            assert(false, " dense store build: param type CSR range is negative")
        if end - start != functionParamCounts[funcId]:
            assert(false, " dense store build: param count does not match CSR range")
        previousStart = end
    let finalStart = functionParamTypeStarts[count]
    if finalStart < previousStart:
        assert(false, " dense store build: final param type CSR is not monotonic")
    if finalStart != functionParamTypeTags.len:
        assert(false, " dense store build: param type tag column length drift")
    return 0

@borrows
fn DenseStoreExistingEntryForSourceName(
        store: CompilerDenseStore,
        sourcePath: str,
        name: str,
        nameHash: int32,
        bucket: int32): int32 =
    let entryCount = DenseStoreHashEntryCount(store)
    var entryIndex = store.bucketHeads[bucket]
    while entryIndex >= 0:
        if entryIndex >= entryCount:
            assert(false, " dense store build: hash chain points outside SoA columns")
        if store.hashEntryNameHashes[entryIndex] == nameHash:
            let candidateFuncId = store.hashEntryFuncIds[entryIndex]
            if candidateFuncId < 0 ||
               candidateFuncId >= store.functionCount:
                assert(false, " dense store build: hash func id out of range")
            if store.functionSourcePaths[candidateFuncId] == sourcePath &&
               store.functionNames[candidateFuncId] == name:
                return entryIndex
        entryIndex = store.hashEntryNext[entryIndex]
    return -1

@borrows
fn DenseStoreAppendHashEntry(store: var CompilerDenseStore,
                             sourcePath: str,
                             name: str,
                             funcId: int32,
                             bucketCount: int32): int32 =
    if funcId < 0 || funcId >= store.functionCount:
        assert(false, " dense store build: func id out of range")
    let nameHash = DenseStoreSourceNameHash(sourcePath, name)
    let bucket = DenseStoreBucketForHash(nameHash, bucketCount)
    if bucket < 0 || bucket >= store.bucketHeads.len:
        assert(false, " dense store build: hash bucket out of range")
    let existingEntryIndex = DenseStoreExistingEntryForSourceName(
        store, sourcePath, name, nameHash, bucket)
    if existingEntryIndex >= 0:
        return -1
    let entryIndex = store.hashEntryFuncIds.len
    add(store.hashEntryNameHashes, nameHash)
    add(store.hashEntryFuncIds, funcId)
    add(store.hashEntryNext, store.bucketHeads[bucket])
    store.bucketHeads[bucket] = entryIndex
    return 0

@borrows
fn DenseStoreCountLookupKeys(functionNames: str[]): int32 =
    var count: int32
    for funcId in 0..<functionNames.len:
        if len(functionNames[funcId]) > 0:
            count = count + 1
    return count

fn DenseStoreInitHashColumns(store: var CompilerDenseStore,
                             bucketCount: int32,
                             entryCount: int32): int32 =
    if bucketCount <= 0:
        assert(false, " dense store build: bucket count must be positive")
    if entryCount < 0:
        assert(false, " dense store build: negative entry count")
    var bucketHeads: int32[]
    for bucketIndex in 0..<bucketCount:
        add(bucketHeads, -1)
    var hashEntryNameHashes: int32[]
    var hashEntryFuncIds: int32[]
    var hashEntryNext: int32[]
    store.bucketHeads = bucketHeads
    store.hashEntryNameHashes = hashEntryNameHashes
    store.hashEntryFuncIds = hashEntryFuncIds
    store.hashEntryNext = hashEntryNext
    return 0

@borrows
fn DenseStoreTailNameFromQualified(qualified: str): str =
    if len(qualified) <= 0:
        return ""
    var sepIndex = -1
    for i in 0..<(len(qualified) - 1):
        if qualified[i] == ':' && qualified[i + 1] == ':':
            sepIndex = i + 2
    if sepIndex > 0 && sepIndex < len(qualified):
        return strings.CloneStr(strings.SliceBytes(
            qualified, sepIndex, len(qualified) - sepIndex))
    return strings.CloneStr(qualified)

fn DenseStoreNew(): CompilerDenseStore =
    var out: CompilerDenseStore
    out.frozen = false
    out.buildMs = 0
    out.functionCount = 0
    return out

fn DenseStorePhysicalBufferCount(store: var CompilerDenseStore): int32 =
    var count: int32
    if store.bucketHeads.cap > 0:
        count = count + 1
    if store.hashEntryNameHashes.cap > 0:
        count = count + 1
    if store.hashEntryFuncIds.cap > 0:
        count = count + 1
    if store.hashEntryNext.cap > 0:
        count = count + 1
    if store.functionNames.cap > 0:
        count = count + 1
    if store.functionTailNames.cap > 0:
        count = count + 1
    if store.functionParamCounts.cap > 0:
        count = count + 1
    if store.functionResultTypeTags.cap > 0:
        count = count + 1
    if store.functionSourcePaths.cap > 0:
        count = count + 1
    if store.functionBodyKinds.cap > 0:
        count = count + 1
    if store.functionEntryFlags.cap > 0:
        count = count + 1
    if store.functionTypedIndices.cap > 0:
        count = count + 1
    if store.functionParamTypeTags.cap > 0:
        count = count + 1
    if store.functionParamTypeStarts.cap > 0:
        count = count + 1
    return count

fn DenseStoreRetainedBytes(store: var CompilerDenseStore): int64 =
    var bytes: int64
    bytes = bytes + int64(store.bucketHeads.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.hashEntryNameHashes.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.hashEntryFuncIds.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.hashEntryNext.cap) * int64(sizeof(int32))
    bytes = bytes + int64(store.functionNames.cap) * int64(sizeof(str))
    bytes = bytes +
        int64(store.functionTailNames.cap) * int64(sizeof(str))
    bytes = bytes +
        int64(store.functionParamCounts.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.functionResultTypeTags.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.functionSourcePaths.cap) * int64(sizeof(str))
    bytes = bytes +
        int64(store.functionBodyKinds.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.functionEntryFlags.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.functionTypedIndices.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.functionParamTypeTags.cap) * int64(sizeof(int32))
    bytes = bytes +
        int64(store.functionParamTypeStarts.cap) * int64(sizeof(int32))
    for functionIndex in 0..<store.functionNames.len:
        bytes = bytes + int64(len(store.functionNames[functionIndex]))
    for functionIndex in 0..<store.functionTailNames.len:
        bytes = bytes + int64(len(store.functionTailNames[functionIndex]))
    for functionIndex in 0..<store.functionSourcePaths.len:
        bytes = bytes + int64(len(store.functionSourcePaths[functionIndex]))
    return bytes

fn DenseStoreRelease(store: var CompilerDenseStore) =
    seqs.freeSeq(store.bucketHeads)
    seqs.freeSeq(store.hashEntryNameHashes)
    seqs.freeSeq(store.hashEntryFuncIds)
    seqs.freeSeq(store.hashEntryNext)
    seqs.freeSeqStrRelease(store.functionNames)
    seqs.freeSeqStrRelease(store.functionTailNames)
    seqs.freeSeq(store.functionParamCounts)
    seqs.freeSeq(store.functionResultTypeTags)
    seqs.freeSeqStrRelease(store.functionSourcePaths)
    seqs.freeSeq(store.functionBodyKinds)
    seqs.freeSeq(store.functionEntryFlags)
    seqs.freeSeq(store.functionTypedIndices)
    seqs.freeSeq(store.functionParamTypeTags)
    seqs.freeSeq(store.functionParamTypeStarts)
    store = DenseStoreNew()
    if DenseStorePhysicalBufferCount(store) != 0 ||
       DenseStoreRetainedBytes(store) != int64(0):
        panic("dense store: physical release incomplete")

fn DenseStoreBuildBegin(store: var CompilerDenseStore,
                        expectedFunctionCount: int32,
                        expectedKeyCount: int32): int32 =
    if expectedFunctionCount < 0:
        assert(false, " dense store build: negative expected function count")
    if expectedKeyCount < 0:
        assert(false, " dense store build: negative expected key count")
    store.frozen = false
    store.buildMs = 0
    store.functionCount = 0
    store.sourceScopedQueryCount = 0
    store.sourceScopedQueryHitCount = 0
    store.sourceScopedQueryMissCount = 0
    let bucketCount = DenseStoreBucketCountForCapacity(expectedFunctionCount)
    store.bucketCount = bucketCount
    let _ = DenseStoreInitHashColumns(store, bucketCount, expectedKeyCount)
    var emptyStrs: str[]
    var emptyI32s: int32[]
    store.functionNames = emptyStrs
    store.functionTailNames = emptyStrs
    store.functionSourcePaths = emptyStrs
    store.functionParamCounts = emptyI32s
    store.functionResultTypeTags = emptyI32s
    store.functionBodyKinds = emptyI32s
    store.functionEntryFlags = emptyI32s
    store.functionTypedIndices = emptyI32s
    store.functionParamTypeTags = emptyI32s
    store.functionParamTypeStarts = emptyI32s
    return 0

fn DenseStoreBuildAppendFunction(store: var CompilerDenseStore,
                                 name: str,
                                 tailName: str,
                                 paramCount: int32,
                                 resultTypeTag: int32,
                                 sourcePath: str,
                                 bodyKind: int32,
                                 entryFlag: int32,
                                 typedIndex: int32): int32 =
    if store.frozen:
        assert(false, " dense store build: append after freeze")
    if paramCount < 0:
        assert(false, " dense store build: negative param count")
    let funcId = store.functionCount
    add(store.functionNames, name)
    add(store.functionTailNames, tailName)
    add(store.functionParamCounts, paramCount)
    add(store.functionResultTypeTags, resultTypeTag)
    add(store.functionSourcePaths, sourcePath)
    add(store.functionBodyKinds, bodyKind)
    add(store.functionEntryFlags, entryFlag)
    add(store.functionTypedIndices, typedIndex)
    add(store.functionParamTypeStarts, store.functionParamTypeTags.len)
    store.functionCount = funcId + 1
    return funcId

@borrows
fn DenseStoreBuildAppendFunctionName(store: var CompilerDenseStore,
                                     name: str): int32 =
    if store.frozen:
        assert(false, " dense store build: append after freeze")
    let funcId = store.functionCount
    add(store.functionNames, strings.CloneStr(name))
    add(store.functionTailNames, DenseStoreTailNameFromQualified(name))
    add(store.functionParamCounts, 0)
    add(store.functionResultTypeTags, DenseStoreResultTypeTagInvalid())
    add(store.functionSourcePaths, "")
    add(store.functionBodyKinds, DenseStoreBodyKindNone)
    add(store.functionEntryFlags, 0)
    add(store.functionTypedIndices, -1)
    add(store.functionParamTypeStarts, store.functionParamTypeTags.len)
    store.functionCount = funcId + 1
    return funcId

fn DenseStoreBuildSetFunctionParamCount(store: var CompilerDenseStore,
                                        funcId: int32,
                                        paramCount: int32): int32 =
    if funcId < 0 || funcId >= store.functionParamCounts.len:
        assert(false, " dense store build: param count func id out of range")
    if paramCount < 0:
        assert(false, " dense store build: negative param count")
    store.functionParamCounts[funcId] = paramCount
    return 0

fn DenseStoreBuildSetFunctionResultTypeTag(store: var CompilerDenseStore,
                                           funcId: int32,
                                           resultTypeTag: int32): int32 =
    if funcId < 0 || funcId >= store.functionResultTypeTags.len:
        assert(false, " dense store build: result tag func id out of range")
    store.functionResultTypeTags[funcId] = resultTypeTag
    return 0

fn DenseStoreBuildSetFunctionSourcePath(store: var CompilerDenseStore,
                                        funcId: int32,
                                        sourcePath: str): int32 =
    if funcId < 0 || funcId >= store.functionSourcePaths.len:
        assert(false, " dense store build: source path func id out of range")
    store.functionSourcePaths[funcId] = sourcePath
    return 0

fn DenseStoreBuildSetFunctionBodyKind(store: var CompilerDenseStore,
                                      funcId: int32,
                                      bodyKind: int32): int32 =
    if funcId < 0 || funcId >= store.functionBodyKinds.len:
        assert(false, " dense store build: body kind func id out of range")
    store.functionBodyKinds[funcId] = bodyKind
    return 0

fn DenseStoreBuildSetFunctionEntryFlag(store: var CompilerDenseStore,
                                       funcId: int32,
                                       entryFlag: int32): int32 =
    if funcId < 0 || funcId >= store.functionEntryFlags.len:
        assert(false, " dense store build: entry flag func id out of range")
    store.functionEntryFlags[funcId] = entryFlag
    return 0

fn DenseStoreBuildSetFunctionTypedIndex(store: var CompilerDenseStore,
                                        funcId: int32,
                                        typedIndex: int32): int32 =
    if funcId < 0 || funcId >= store.functionTypedIndices.len:
        assert(false, " dense store build: typed index func id out of range")
    store.functionTypedIndices[funcId] = typedIndex
    return 0

fn DenseStoreBuildAppendParamType(store: var CompilerDenseStore,
                                  paramTypeTag: int32): int32 =
    if store.frozen:
        assert(false, " dense store build: append param after freeze")
    add(store.functionParamTypeTags, paramTypeTag)
    return store.functionParamTypeTags.len

fn DenseStoreBuildFinish(store: var CompilerDenseStore): int32 =
    if store.frozen:
        assert(false, " dense store build: finish after freeze")
    add(store.functionParamTypeStarts, store.functionParamTypeTags.len)
    let count = store.functionNames.len
    if store.functionTailNames.len != count:
        assert(false, " dense store build: tail name column length drift")
    if store.functionParamCounts.len != count:
        assert(false, " dense store build: param count column length drift")
    if store.functionResultTypeTags.len != count:
        assert(false, " dense store build: result type column length drift")
    if store.functionSourcePaths.len != count:
        assert(false, " dense store build: source path column length drift")
    if store.functionBodyKinds.len != count:
        assert(false, " dense store build: body kind column length drift")
    if store.functionEntryFlags.len != count:
        assert(false, " dense store build: entry flag column length drift")
    if store.functionTypedIndices.len != count:
        assert(false, " dense store build: typed index column length drift")
    if store.functionParamTypeStarts.len != count + 1:
        assert(false, " dense store build: param type CSR sentinel missing")
    var previousStart: int32
    for funcIndex in 0..<count:
        let start = store.functionParamTypeStarts[funcIndex]
        let finish = store.functionParamTypeStarts[funcIndex + 1]
        if start < previousStart:
            assert(false, " dense store build: param type CSR is not monotonic")
        if finish < start:
            assert(false, " dense store build: param type CSR range is negative")
        if finish - start != store.functionParamCounts[funcIndex]:
            assert(false, " dense store build: param count does not match CSR range")
        previousStart = finish
    if store.functionParamTypeStarts[count] != store.functionParamTypeTags.len:
        assert(false, " dense store build: param type tag column length drift")
    var entryIndex: int32
    for funcId in 0..<store.functionCount:
        let name = store.functionNames[funcId]
        if len(name) <= 0:
            continue
        let appended = DenseStoreAppendHashEntry(
            store,
            store.functionSourcePaths[funcId],
            name,
            funcId,
            store.bucketCount)
        if appended >= 0:
            entryIndex = entryIndex + 1
    if entryIndex != DenseStoreHashEntryCount(store):
        assert(false, " dense store build: hash entry count drift")
    store.frozen = true
    return 0

fn DenseStoreBuild(store: var CompilerDenseStore,
                    functionNames: str[],
                    functionTailNames: str[],
                    functionParamCounts: int32[],
                    functionResultTypeTags: int32[],
                    functionSourcePaths: str[],
                    functionBodyKinds: int32[],
                    functionEntryFlags: int32[],
                    functionTypedIndices: int32[],
                    functionParamTypeTags: int32[],
                    functionParamTypeStarts: int32[]): int32 =
    if store.frozen:
        assert(false, " dense store build: store is already frozen")
    let count = functionNames.len
    if functionTailNames.len != count:
        assert(false, " dense store build: tail name column length drift")
    if functionParamCounts.len != count:
        assert(false, " dense store build: param count column length drift")
    if functionResultTypeTags.len != count:
        assert(false, " dense store build: result type column length drift")
    if functionSourcePaths.len != count:
        assert(false, " dense store build: source path column length drift")
    if functionBodyKinds.len != count:
        assert(false, " dense store build: body kind column length drift")
    if functionEntryFlags.len != count:
        assert(false, " dense store build: entry flag column length drift")
    if functionTypedIndices.len != count:
        assert(false, " dense store build: typed index column length drift")
    if functionParamTypeStarts.len != count + 1:
        assert(false, " dense store build: param type CSR sentinel missing")
    var previousStart: int32
    for funcId in 0..<count:
        let start = functionParamTypeStarts[funcId]
        let finish = functionParamTypeStarts[funcId + 1]
        if start < previousStart:
            assert(false, " dense store build: param type CSR is not monotonic")
        if finish < start:
            assert(false, " dense store build: param type CSR range is negative")
        if finish - start != functionParamCounts[funcId]:
            assert(false, " dense store build: param count does not match CSR range")
        previousStart = finish
    let finalStart = functionParamTypeStarts[count]
    if finalStart < previousStart:
        assert(false, " dense store build: final param type CSR is not monotonic")
    if finalStart != functionParamTypeTags.len:
        assert(false, " dense store build: param type tag column length drift")
    let entryCount = DenseStoreCountLookupKeys(functionNames)
    let bucketCount = DenseStoreBucketCountForCapacity(count)
    store.bucketCount = bucketCount
    let _ = DenseStoreInitHashColumns(store, bucketCount, entryCount)
    store.functionNames = functionNames
    store.functionTailNames = functionTailNames
    store.functionParamCounts = functionParamCounts
    store.functionResultTypeTags = functionResultTypeTags
    store.functionSourcePaths = functionSourcePaths
    store.functionBodyKinds = functionBodyKinds
    store.functionEntryFlags = functionEntryFlags
    store.functionTypedIndices = functionTypedIndices
    store.functionParamTypeTags = functionParamTypeTags
    store.functionParamTypeStarts = functionParamTypeStarts
    store.functionCount = count
    store.sourceScopedQueryCount = 0
    store.sourceScopedQueryHitCount = 0
    store.sourceScopedQueryMissCount = 0
    var entryIndex: int32
    for funcId in 0..<count:
        let name = store.functionNames[funcId]
        if len(name) <= 0:
            continue
        let appended = DenseStoreAppendHashEntry(
            store,
            store.functionSourcePaths[funcId],
            name,
            funcId,
            bucketCount)
        if appended >= 0:
            entryIndex = entryIndex + 1
    if entryIndex != DenseStoreHashEntryCount(store):
        assert(false, " dense store build: hash entry count drift")
    store.frozen = true
    return 0

fn DenseStoreBuildFromFunctionArrays(store: var CompilerDenseStore,
                                      functionNames: str[],
                                      functionParamCounts: int32[],
                                      functionResultTypeTags: int32[],
                                      functionSourcePaths: str[],
                                      functionBodyKinds: int32[],
                                      functionEntryFlags: int32[],
                                      functionTypedIndices: int32[],
                                      functionParamTypeTags: int32[],
                                      functionParamTypeStarts: int32[]) =
    var tailNames: str[]
    for i in 0..<functionNames.len:
        add(tailNames, DenseStoreTailNameFromQualified(functionNames[i]))
    let _ = DenseStoreBuild(store,
                            functionNames,
                            tailNames,
                            functionParamCounts,
                            functionResultTypeTags,
                            functionSourcePaths,
                            functionBodyKinds,
                            functionEntryFlags,
                            functionTypedIndices,
                            functionParamTypeTags,
                            functionParamTypeStarts)
    return

fn DenseStoreBuildMinimal(store: var CompilerDenseStore,
                           functionNames: str[]) =
    var tailNames: str[]
    var paramCounts: int32[]
    var resultTags: int32[]
    var sourcePaths: str[]
    var bodyKinds: int32[]
    var entryFlags: int32[]
    var typedIndices: int32[]
    var paramTypeTags: int32[]
    var paramTypeStarts: int32[]
    for i in 0..<functionNames.len:
        add(tailNames, DenseStoreTailNameFromQualified(functionNames[i]))
        add(paramCounts, 0)
        add(resultTags, DenseStoreResultTypeTagInvalid())
        add(sourcePaths, "")
        add(bodyKinds, 0)
        add(entryFlags, 0)
        add(typedIndices, -1)
        add(paramTypeStarts, 0)
    # CSR sentinel: mark end of last param block
    add(paramTypeStarts, 0)
    let _ = DenseStoreBuild(store,
                            functionNames,
                            tailNames,
                            paramCounts,
                            resultTags,
                            sourcePaths,
                            bodyKinds,
                            entryFlags,
                            typedIndices,
                            paramTypeTags,
                            paramTypeStarts)
    return

fn DenseStoreFreeze(store: var CompilerDenseStore) =
    store.frozen = true
    return

@borrows
fn DenseStoreFindFunctionInSourceReadonly(store: CompilerDenseStore,
                                          sourcePath: str,
                                          name: str): int32 =
    if len(name) <= 0:
        return -1
    if store.functionCount <= 0:
        return -1
    let nameHash = DenseStoreSourceNameHash(sourcePath, name)
    let bucket = DenseStoreBucketForHash(nameHash, store.bucketCount)
    if bucket < 0 || bucket >= store.bucketHeads.len:
        return -1
    let entryIndex = DenseStoreExistingEntryForSourceName(
        store, sourcePath, name, nameHash, bucket)
    if entryIndex < 0:
        return -1
    return store.hashEntryFuncIds[entryIndex]

@borrows
fn DenseStoreFindFunctionInSource(store: var CompilerDenseStore,
                                  sourcePath: str,
                                  name: str): int32 =
    let funcId = DenseStoreFindFunctionInSourceReadonly(store, sourcePath, name)
    store.sourceScopedQueryCount = store.sourceScopedQueryCount + 1
    if funcId >= 0:
        store.sourceScopedQueryHitCount = store.sourceScopedQueryHitCount + 1
    else:
        store.sourceScopedQueryMissCount = store.sourceScopedQueryMissCount + 1
    return funcId

@borrows
fn DenseStoreFindFunction(store: CompilerDenseStore, name: str): int32 =
    return DenseStoreFindFunctionInSourceReadonly(store, "", name)

@borrows
fn DenseStoreFunctionCount(store: CompilerDenseStore): int32 =
    return store.functionCount

@borrows
fn DenseStoreSymbolCount(store: CompilerDenseStore): int32 =
    var count: int32
    for funcId in 0..<store.functionCount:
        if funcId >= 0 && funcId < store.functionNames.len:
            if len(store.functionNames[funcId]) > 0:
                count = count + 1
    return count

@borrows
fn DenseStoreBodyCount(store: CompilerDenseStore): int32 =
    var count: int32
    for funcId in 0..<store.functionCount:
        if DenseStoreFunctionBodyKind(store, funcId) > DenseStoreBodyKindNone:
            count = count + 1
    return count

@borrows
fn DenseStoreCfgCount(store: CompilerDenseStore): int32 =
    var count: int32
    for funcId in 0..<store.functionCount:
        if DenseStoreFunctionBodyKind(store, funcId) >= DenseStoreBodyKindCfg:
            count = count + 1
    return count

@borrows
fn DenseStoreTypedCount(store: CompilerDenseStore): int32 =
    var count: int32
    for funcId in 0..<store.functionCount:
        let bodyKind = DenseStoreFunctionBodyKind(store, funcId)
        let typedIndex = DenseStoreFunctionTypedIndex(store, funcId)
        if typedIndex >= 0 || bodyKind >= DenseStoreBodyKindTyped:
            count = count + 1
    return count

@borrows
fn DenseStoreBodyIrCount(store: CompilerDenseStore): int32 =
    var count: int32
    for funcId in 0..<store.functionCount:
        if DenseStoreFunctionBodyKind(store, funcId) >= DenseStoreBodyKindBodyIr:
            count = count + 1
    return count

@borrows
fn DenseStorePointerKeyCount(store: CompilerDenseStore): int32 =
    return 0

@borrows
fn DenseStoreSuffixGuessCount(store: CompilerDenseStore): int32 =
    return 0

@borrows
fn DenseStoreTailAliasCount(store: CompilerDenseStore): int32 =
    return 0

@borrows
fn DenseStoreSourceScopedKeyCount(store: CompilerDenseStore): int32 =
    return DenseStoreHashEntryCount(store)

@borrows
fn DenseStoreSourcePathSeenBefore(store: CompilerDenseStore,
                                  funcId: int32): bool =
    if funcId < 0 || funcId >= store.functionCount:
        return false
    let sourcePath = store.functionSourcePaths[funcId]
    for previousId in 0..<funcId:
        if store.functionSourcePaths[previousId] == sourcePath:
            return true
    return false

@borrows
fn DenseStoreSourceScopedSourceCount(store: CompilerDenseStore): int32 =
    var count: int32
    for funcId in 0..<store.functionCount:
        if len(store.functionSourcePaths[funcId]) > 0 &&
           !DenseStoreSourcePathSeenBefore(store, funcId):
            count = count + 1
    return count

@borrows
fn DenseStoreSourceScopedNameCollisionCount(store: CompilerDenseStore): int32 =
    var count: int32
    for funcId in 0..<store.functionCount:
        let name = store.functionNames[funcId]
        if len(name) <= 0:
            continue
        var collided = false
        for previousId in 0..<funcId:
            if store.functionNames[previousId] == name:
                collided = true
        if collided:
            count = count + 1
    return count

@borrows
fn DenseStoreSourceScopedQueryCount(store: CompilerDenseStore): int32 =
    return store.sourceScopedQueryCount

@borrows
fn DenseStoreSourceScopedQueryHitCount(store: CompilerDenseStore): int32 =
    return store.sourceScopedQueryHitCount

@borrows
fn DenseStoreSourceScopedQueryMissCount(store: CompilerDenseStore): int32 =
    return store.sourceScopedQueryMissCount

@borrows
fn DenseStoreBuildMs(store: CompilerDenseStore): int32 =
    return store.buildMs

@borrows
fn DenseStoreIsFrozen(store: CompilerDenseStore): bool =
    return store.frozen

@borrows
fn DenseStoreFunctionName(store: CompilerDenseStore, funcId: int32): str =
    if funcId < 0 || funcId >= store.functionCount:
        return ""
    return store.functionNames[funcId]

@borrows
fn DenseStoreFunctionTailName(store: CompilerDenseStore, funcId: int32): str =
    if funcId < 0 || funcId >= store.functionCount:
        return ""
    return store.functionTailNames[funcId]

@borrows
fn DenseStoreFunctionParamCount(store: CompilerDenseStore, funcId: int32): int32 =
    if funcId < 0 || funcId >= store.functionCount:
        return 0
    return store.functionParamCounts[funcId]

@borrows
fn DenseStoreFunctionResultTypeTag(store: CompilerDenseStore, funcId: int32): int32 =
    if funcId < 0 || funcId >= store.functionCount:
        return DenseResultInvalidTag
    return store.functionResultTypeTags[funcId]

@borrows
fn DenseStoreFunctionSourcePath(store: CompilerDenseStore, funcId: int32): str =
    if funcId < 0 || funcId >= store.functionCount:
        return ""
    return store.functionSourcePaths[funcId]

@borrows
fn DenseStoreFunctionBodyKind(store: CompilerDenseStore, funcId: int32): int32 =
    if funcId < 0 || funcId >= store.functionCount:
        return 0
    return store.functionBodyKinds[funcId]

@borrows
fn DenseStoreFunctionEntryFlag(store: CompilerDenseStore, funcId: int32): int32 =
    if funcId < 0 || funcId >= store.functionCount:
        return 0
    return store.functionEntryFlags[funcId]

@borrows
fn DenseStoreFunctionTypedIndex(store: CompilerDenseStore, funcId: int32): int32 =
    if funcId < 0 || funcId >= store.functionCount:
        return -1
    return store.functionTypedIndices[funcId]

@borrows
fn DenseStoreFunctionIsEntry(store: CompilerDenseStore, funcId: int32): bool =
    return DenseStoreFunctionEntryFlag(store, funcId) & DenseEntryIsEntryFlag != 0

@borrows
fn DenseStoreFunctionIsExported(store: CompilerDenseStore, funcId: int32): bool =
    return DenseStoreFunctionEntryFlag(store, funcId) & DenseEntryIsExportedFlag != 0

@borrows
fn DenseStoreGetParamTypeTag(store: CompilerDenseStore,
                             funcId: int32,
                             paramIndex: int32): int32 =
    if funcId < 0 || funcId >= store.functionCount:
        return DenseParamInvalidTag
    if paramIndex < 0:
        return DenseParamInvalidTag
    if funcId + 1 >= store.functionParamTypeStarts.len:
        return DenseParamInvalidTag
    let start = store.functionParamTypeStarts[funcId]
    let end = store.functionParamTypeStarts[funcId + 1]
    if paramIndex >= end - start:
        return DenseParamInvalidTag
    let flatIndex = start + paramIndex
    if flatIndex < 0 || flatIndex >= store.functionParamTypeTags.len:
        return DenseParamInvalidTag
    return store.functionParamTypeTags[flatIndex]

@borrows
fn DenseStoreContractReport(store: CompilerDenseStore): CompilerDenseStoreReport =
    var report: CompilerDenseStoreReport
    report.functionCount = DenseStoreFunctionCount(store)
    report.symbolCount = DenseStoreSymbolCount(store)
    report.bodyCount = DenseStoreBodyCount(store)
    report.cfgCount = DenseStoreCfgCount(store)
    report.typedCount = DenseStoreTypedCount(store)
    report.bodyIrCount = DenseStoreBodyIrCount(store)
    report.pointerKeyCount = DenseStorePointerKeyCount(store)
    report.suffixGuessCount = DenseStoreSuffixGuessCount(store)
    report.tailAliasCount = DenseStoreTailAliasCount(store)
    report.sourceScopedKeyCount = DenseStoreSourceScopedKeyCount(store)
    report.sourceScopedSourceCount = DenseStoreSourceScopedSourceCount(store)
    report.sourceScopedNameCollisionCount = DenseStoreSourceScopedNameCollisionCount(store)
    report.sourceScopedQueryCount = store.sourceScopedQueryCount
    report.sourceScopedQueryHitCount = store.sourceScopedQueryHitCount
    report.sourceScopedQueryMissCount = store.sourceScopedQueryMissCount
    report.bucketCount = store.bucketCount
    report.hashEntryCount = DenseStoreHashEntryCount(store)
    report.buildMs = store.buildMs
    report.frozen = store.frozen
    return report

@borrows
fn DenseStoreReport(store: CompilerDenseStore): str =
    let report = DenseStoreContractReport(store)
    var out: str
    out = Fmt"dense_store_function_count={report.functionCount}"
    out = Fmt"{out}\ndense_store_symbol_count={report.symbolCount}"
    out = Fmt"{out}\ndense_store_body_count={report.bodyCount}"
    out = Fmt"{out}\ndense_store_cfg_count={report.cfgCount}"
    out = Fmt"{out}\ndense_store_typed_count={report.typedCount}"
    out = Fmt"{out}\ndense_store_bodyir_count={report.bodyIrCount}"
    out = Fmt"{out}\ndense_store_pointer_key_count={report.pointerKeyCount}"
    out = Fmt"{out}\ndense_store_suffix_guess_count={report.suffixGuessCount}"
    out = Fmt"{out}\ndense_store_tail_alias_count={report.tailAliasCount}"
    out = Fmt"{out}\ndense_store_source_scoped_key_count={report.sourceScopedKeyCount}"
    out = Fmt"{out}\ndense_store_source_scoped_source_count={report.sourceScopedSourceCount}"
    out = Fmt"{out}\ndense_store_source_scoped_name_collision_count={report.sourceScopedNameCollisionCount}"
    out = Fmt"{out}\ndense_store_source_scoped_query_count={report.sourceScopedQueryCount}"
    out = Fmt"{out}\ndense_store_source_scoped_query_hit_count={report.sourceScopedQueryHitCount}"
    out = Fmt"{out}\ndense_store_source_scoped_query_miss_count={report.sourceScopedQueryMissCount}"
    out = Fmt"{out}\ndense_store_build_ms={report.buildMs}"
    out = Fmt"{out}\ndense_store_frozen={report.frozen}"
    out = Fmt"{out}\ndense_store_bucket_count={report.bucketCount}"
    out = Fmt"{out}\ndense_store_hash_entry_count={report.hashEntryCount}"
    return out
