# Step 2 P3 — ParamRef substitution apply scaffold (ghost, no-mutation).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (same pattern as the retired
# Step 1 P4 overlay scaffold + Step 2 P2 typed_ir_paramref_build.cheng,
# lesson e4550c1b5 applied).  Env gate CHENG_PARAMREF_APPLY=1 default off.
#
# Design source: docs/step-2-paramref-substitution-apply-ready.md §6.
# Master plan: docs/beat-c.md §1.4.2 Step 2 P3.
#
# Companion to typed_ir_paramref_subst.cheng (subst table) +
# typed_ir_paramref_build.cheng (P2 build real algorithm).  This module
# implements the apply pass that consumes the substitution table and
# rewrites ParamRef references inline in the typedIr subtree.
#
# IMPORTANT: This scaffold version performs NO mutation of typedIr — it
# only walks the substitution table and emits trace counts.  Real
# mutation (P3 真 apply) requires:
#   1. typedIr.functions2_* node array clone + ParamRef rewrite
#   2. callgraph edge update (remove resolved edge, add transitive)
#   3. Codegen output 真改 → bootstrap fp 漂 → §12.2 new baseline
# All deferred to cross-session work per master plan §12.2 protocol.
#
# Wiring plan (Step 2 P3 真 apply, cross-session):
#   1. typed_ir_inline_pass.cheng's TypedIrInlinePassRun gains optional
#      call to TypedIrParamRefApply after build pass; env-gated.
#   2. Apply walks substitution table; for each entry whose argKind !=
#      Invalid, mutates the typedIr subtree to replace ParamRef refs.
#   3. Bootstrap fp drifts; new baseline + §12.2 cross-session measurement.

import cheng/core/ir/typed_ir_paramref_subst as subst
import std/os
import std/strings

type
    TypedIrParamRefApplyStats =
        totalEntries: int32
        appliedEntries: int32
        skippedInvalidKind: int32
        skippedNoOpInvocation: int32

fn TypedIrParamRefApplyShouldApply(kind: int32): bool =
    if kind == subst.ParamRefSubstKindInvalid:
        return false
    if kind == subst.ParamRefSubstKindParamRef:
        # ParamRef → ParamRef substitution is identity, skip
        return false
    return true

fn TypedIrParamRefApplyDryRun(table: subst.ParamRefSubstTable): TypedIrParamRefApplyStats =
    var stats: TypedIrParamRefApplyStats
    stats.totalEntries = table.substitutions.len
    stats.appliedEntries = 0
    stats.skippedInvalidKind = 0
    stats.skippedNoOpInvocation = 0

    for i in 0..<table.substitutions.len:
        let entry = table.substitutions[i]
        if entry.argKind == subst.ParamRefSubstKindInvalid:
            stats.skippedInvalidKind = stats.skippedInvalidKind + 1
            continue
        if !TypedIrParamRefApplyShouldApply(entry.argKind):
            stats.skippedNoOpInvocation = stats.skippedNoOpInvocation + 1
            continue
        # NO MUTATION here — this is dry-run scaffold; real mutation
        # of typedIr is Step 2 P3 真 apply (cross-session per §12.2).
        stats.appliedEntries = stats.appliedEntries + 1

    let _gate = os.GetEnv("CHENG_PARAMREF_APPLY_TRACE")
    if _gate == "1":
        var _line: str = "[paramref-apply] total="
        _line = _line + strings.IntToStr(stats.totalEntries)
        _line = _line + " would_apply="
        _line = _line + strings.IntToStr(stats.appliedEntries)
        _line = _line + " skipped_invalid="
        _line = _line + strings.IntToStr(stats.skippedInvalidKind)
        _line = _line + " skipped_noop="
        _line = _line + strings.IntToStr(stats.skippedNoOpInvocation)
        os.WriteLine(os.GetStderr(), _line)

    return stats

fn TypedIrParamRefApplyStatsTotal(stats: TypedIrParamRefApplyStats): int32 =
    return stats.totalEntries

fn TypedIrParamRefApplyStatsApplied(stats: TypedIrParamRefApplyStats): int32 =
    return stats.appliedEntries
