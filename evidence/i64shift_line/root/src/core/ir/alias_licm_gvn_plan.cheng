# Step 5 (备) P2 — LICM hoist + GVN elimination plan from alias result (ghost).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (lesson e4550c1b5 applied).
# Env gate CHENG_ALIAS_LICM_GVN_PLAN_TRACE=1 default off.
#
# Design source: docs/beat-c.md §1.4.5 Step 5 P2.
#
# Companion to alias_licm_gvn.cheng (P1 alias classification + LICM/GVN
# candidate detection). This module consumes AliasLicmGvnResult and
# emits per-op hoist / elimination plan entries.
#
# Algorithm:
# 1. For each AliasMemoryOp in result.memoryOps:
#    a. If AliasLicmGvnIsRead && licm_eligible: emit HoistEntry
#       (op moves to preheader, aliasClass stable across loop)
#    b. If AliasLicmGvnIsRead && gvn_redundant: emit EliminateEntry
#       (use cached value number, drop redundant load)
# 2. Aggregate: hoistCount + elimCount.
#
# Real wire (Step 5 P3 cross-session): consume plan + mutate BodyIR
# emit (drop redundant op + hoist into preheader block). Codegen output
# changes; bootstrap fp drifts; functional output identical.

import cheng/core/ir/alias_licm_gvn as alg
import std/os
import std/strings

const
    AliasPlanActionNone = 0
    AliasPlanActionHoist = 1
    AliasPlanActionEliminate = 2

type
    AliasLicmGvnPlanEntry =
        opIndex: int32
        action: int32
        baseSlot: int32

    AliasLicmGvnPlan =
        entries: AliasLicmGvnPlanEntry[]
        totalEntries: int32
        hoistCount: int32
        elimCount: int32

fn AliasLicmGvnPlanBuild(result: alg.AliasLicmGvnResult): AliasLicmGvnPlan =
    var plan: AliasLicmGvnPlan
    plan.totalEntries = 0
    plan.hoistCount = 0
    plan.elimCount = 0

    var seen: int32[]
    for mi in 0..<result.memoryOps.len:
        let memOp = result.memoryOps[mi]
        if !alg.AliasLicmGvnIsRead(memOp.aliasClass):
            continue

        var isRedundant: bool
        for si in 0..<seen.len:
            if seen[si] == memOp.baseSlot:
                isRedundant = true
                break
        if !isRedundant:
            add(seen, memOp.baseSlot)

        var entry: AliasLicmGvnPlanEntry
        entry.opIndex = memOp.opIndex
        entry.baseSlot = memOp.baseSlot
        if isRedundant:
            entry.action = AliasPlanActionEliminate
            plan.elimCount = plan.elimCount + 1
        else:
            entry.action = AliasPlanActionHoist
            plan.hoistCount = plan.hoistCount + 1
        add(plan.entries, entry)
        plan.totalEntries = plan.totalEntries + 1

    let _gate = os.GetEnv("CHENG_ALIAS_LICM_GVN_PLAN_TRACE")
    if _gate == "1":
        var _line: str = "[alias-licm-gvn-plan] total="
        _line = _line + strings.IntToStr(plan.totalEntries)
        _line = _line + " hoist="
        _line = _line + strings.IntToStr(plan.hoistCount)
        _line = _line + " elim="
        _line = _line + strings.IntToStr(plan.elimCount)
        os.WriteLine(os.GetStderr(), _line)

    return plan

fn AliasLicmGvnPlanOpAction(plan: AliasLicmGvnPlan, opIndex: int32): int32 =
    for i in 0..<plan.entries.len:
        if plan.entries[i].opIndex == opIndex:
            return plan.entries[i].action
    return AliasPlanActionNone
