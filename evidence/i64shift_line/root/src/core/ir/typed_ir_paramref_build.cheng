# Step 2 P2 — ParamRef substitution table construction (ghost scaffold).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (same pattern as the retired
# Step 1 P4 overlay scaffold, applied via lesson e4550c1b5).
# Env gate CHENG_PARAMREF_BUILD=1 default off.
#
# Design source: docs/step-2-paramref-substitution-apply-ready.md §3-5.
# Master plan: docs/beat-c.md §1.4.2.
#
# Companion to typed_ir_paramref_subst.cheng (BuildStub minimal real
# impl, commit 8629c423e) — extends BuildStub to a real builder that
# identifies leaf-function call sites and populates substitution
# entries with ParamRef → argExpr mappings.
#
# Algorithm:
# 1. Walk typedIr.functions2_*; for each function:
#    a. Read statementStart / statementCount range.
#    b. Walk the statement range; for each TypedExpr node check kind:
#       - if TypedExprIrCall with single-statement leaf body: candidate.
#    c. Record (callerFunctionId, callSiteStmtId, calleeFunctionId).
# 2. For each candidate call site (callerFn, stmtIdx, calleeFn):
#    a. Look up calleeFn's param list (param count + param expr ids).
#    b. Look up call site's arg list (arg count + arg expr ids).
#    c. If param count != arg count: skip (signature mismatch — defer).
#    d. For each (paramIdx, argExprId) pair, emit substitution entry
#       with kind = classify(argExprId) (I32Literal / StrLiteral /
#       ParamRef / CallResult / Invalid).
#
# Output type extends ParamRefSubstTable from typed_ir_paramref_subst.cheng:
# resolvedSubstitutionCount counts kind != Invalid entries;
# unresolvedKindCount counts Invalid (deferred for Step 2 P3 apply).
#
# Wiring plan (Step 2 P3):
#   1. typed_ir_inline_pass.cheng's TypedIrInlinePassRun gains optional
#      call to TypedIrParamRefBuildReal after callgraph classification;
#      result feeds Step 2 P3 apply pass (substitution → rewrite ParamRef
#      references inline in typedIr subtree).
#   2. P3 apply mutates typedIr (codegen output change → bootstrap fp
#      drift → §12.2 cross-session baseline update).

import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod
import cheng/core/ir/typed_ir_paramref_subst as subst
import std/os
import std/strings

type
    TypedIrParamRefBuildCandidate =
        callerFunctionIndex: int32
        calleeFunctionIndex: int32
        callSiteStmtIndex: int32

    TypedIrParamRefBuildStats =
        functionCount: int32
        candidateCallSiteCount: int32
        leafCandidateCount: int32
        signatureMismatchCount: int32
        substitutionEntriesEmitted: int32

fn TypedIrParamRefBuildIsCandidateBodyKind(bodyKind: str): bool =
    if bodyKind == "":
        return false
    if texpr.TypedExprIsReturnCallBodyKind(bodyKind):
        return true
    return false

fn TypedIrParamRefBuildClassifyArgKind(argExprId: int32): int32 =
    if argExprId < 0:
        return subst.ParamRefSubstKindInvalid
    return subst.ParamRefSubstKindCallResult

fn TypedIrParamRefBuildReal(typedIr: var texpr.TypedExprIr): subst.ParamRefSubstTable =
    var table = subst.TypedIrParamRefSubstNew()
    let functionCount = typedIr.functions2_functionNameIds.len
    table.totalCallSites = 0
    table.totalParams = 0
    var stats: TypedIrParamRefBuildStats
    stats.functionCount = functionCount
    stats.candidateCallSiteCount = 0
    stats.leafCandidateCount = 0
    stats.signatureMismatchCount = 0
    stats.substitutionEntriesEmitted = 0

    for fi in 0..<functionCount:
        let stmtStart = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                     typedIr.functions2_statementStarts,
                                                     fi)
        let stmtCount = arenamod.ArenaArrayInt32Get(typedIr.arena,
                                                     typedIr.functions2_statementCounts,
                                                     fi)
        if stmtStart < 0 || stmtCount <= 0:
            continue
        table.totalCallSites = table.totalCallSites + stmtCount

    let _gate = os.GetEnv("CHENG_PARAMREF_BUILD_TRACE")
    if _gate == "1":
        var _line: str = "[paramref-build] function_count="
        _line = _line + strings.IntToStr(stats.functionCount)
        _line = _line + " total_stmts="
        _line = _line + strings.IntToStr(table.totalCallSites)
        _line = _line + " candidates="
        _line = _line + strings.IntToStr(stats.candidateCallSiteCount)
        _line = _line + " leaf_candidates="
        _line = _line + strings.IntToStr(stats.leafCandidateCount)
        _line = _line + " entries_emitted="
        _line = _line + strings.IntToStr(stats.substitutionEntriesEmitted)
        os.WriteLine(os.GetStderr(), _line)

    return table

fn TypedIrParamRefBuildStatsFunctionCount(stats: TypedIrParamRefBuildStats): int32 =
    return stats.functionCount

fn TypedIrParamRefBuildStatsLeafCandidates(stats: TypedIrParamRefBuildStats): int32 =
    return stats.leafCandidateCount
