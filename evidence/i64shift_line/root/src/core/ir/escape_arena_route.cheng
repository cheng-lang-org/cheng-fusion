# Step 3 — arena + escape routing scaffold.
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (same pattern as the retired
# Step 1 P1 liveness scaffold + Step 2 typed_ir_inline_pass.cheng).
# Env gate CHENG_ESCAPE_ARENA_ROUTE=1 default off.
#
# Design source: docs/beat-c.md §1.4.3.
# Estimated 1.5-2x speedup (RSS 16.97 GB → <4 GB target via CSG node/edge/
# typedIr table arena migration, see master plan §13 KPI table row "次3").
#
# Purpose: per coreir.BodyIR LocalSlot, classify escape kind (None/Local/
# Return/Global/Unknown) and emit an arena-vs-heap routing decision.
# This is the input that the lowering/codegen arena allocator consumes
# to decide which slot lives in a phase-arena (cheap bulk free) versus
# the system heap (per-slot free).
#
# Classification algorithm (single forward pass over bodyIR.ops):
#   - operand reads do not escape (slot stays local)
#   - target write to a slot whose placeKind == ParamAddress => EscapeNone
#     (param storage is caller-frame, slot value is consumed locally)
#   - any GlobalStore op whose source operand contains the slot id =>
#     mark EscapeGlobal (slot value reaches global scope)
#   - any Return-class term whose operand contains the slot id =>
#     EscapeReturn (slot value reaches caller frame)
#   - any IndexedStore op writing to a borrowed pointer with slot src =>
#     EscapeLocal (slot data lives but pointer ownership unclear)
#   - otherwise EscapeNone
#
# Heuristic conservatism: aliased slots (LocalSlot.aliasClass != Unknown)
# stay EscapeUnknown to avoid mis-routing aliased writes to arena.
#
# Wiring plan (Step 3 P2+):
#   1) primary_object_plan PrimaryBodyIrPrepareA64LayoutMetricsInPlace
#      gains optional call to EscapeArenaRouteAnalyze (env-gated) and
#      stores result.slotEscapes into a module-level array (parallel
#      to layoutLiveReg / IsCallee storage from Step 1 P3).
#   2) Lowering codegen reads escape classification to pick arena vs heap
#      allocation for each slot's backing store.

import cheng/core/ir/core_types as coreir
import std/os
import std/strings

const
    EscapeKindNone = 0
    EscapeKindLocal = 1
    EscapeKindReturn = 2
    EscapeKindGlobal = 3
    EscapeKindUnknown = 4

type
    EscapeArenaRouteResult =
        slotEscapes: int32[]
        totalSlots: int32
        noneCount: int32
        localCount: int32
        returnCount: int32
        globalCount: int32
        unknownCount: int32

@borrows
fn EscapeArenaRouteAnalyze(bodyIR: coreir.BodyIR): EscapeArenaRouteResult =
    var result: EscapeArenaRouteResult
    result.totalSlots = bodyIR.localSlots.len
    result.noneCount = 0
    result.localCount = 0
    result.returnCount = 0
    result.globalCount = 0
    result.unknownCount = 0

    for i in 0..<bodyIR.localSlots.len:
        add(result.slotEscapes, EscapeKindNone)

    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        if op.kind == coreir.BodyOpGlobalStoreTag:
            for j in 0..<op.operands.len:
                let slotId = op.operands[j]
                if slotId >= 0 && slotId < result.slotEscapes.len:
                    if result.slotEscapes[slotId] == EscapeKindNone:
                        result.slotEscapes[slotId] = EscapeKindGlobal
        elif op.kind == coreir.BodyOpIndexedStoreTag:
            for j in 0..<op.operands.len:
                let slotId = op.operands[j]
                if slotId >= 0 && slotId < result.slotEscapes.len:
                    if result.slotEscapes[slotId] == EscapeKindNone:
                        result.slotEscapes[slotId] = EscapeKindLocal

    for ti in 0..<bodyIR.terms.len:
        let term = bodyIR.terms[ti]
        if term.kind == coreir.BodyTermReturnTag:
            if term.resultSlot >= 0 && term.resultSlot < result.slotEscapes.len:
                if result.slotEscapes[term.resultSlot] == EscapeKindNone:
                    result.slotEscapes[term.resultSlot] = EscapeKindReturn
            for j in 0..<term.operands.len:
                let slotId = term.operands[j]
                if slotId >= 0 && slotId < result.slotEscapes.len:
                    if result.slotEscapes[slotId] == EscapeKindNone:
                        result.slotEscapes[slotId] = EscapeKindReturn

    for i in 0..<bodyIR.localSlots.len:
        let slot = bodyIR.localSlots[i]
        if !slot.noAlias && result.slotEscapes[i] == EscapeKindNone:
            result.slotEscapes[i] = EscapeKindUnknown

    for i in 0..<result.slotEscapes.len:
        let kind = result.slotEscapes[i]
        if kind == EscapeKindNone:
            result.noneCount = result.noneCount + 1
        elif kind == EscapeKindLocal:
            result.localCount = result.localCount + 1
        elif kind == EscapeKindReturn:
            result.returnCount = result.returnCount + 1
        elif kind == EscapeKindGlobal:
            result.globalCount = result.globalCount + 1
        else:
            result.unknownCount = result.unknownCount + 1

    let _escapeGate = os.GetEnv("CHENG_ESCAPE_ARENA_ROUTE_TRACE")
    if _escapeGate == "1":
        var _line: str = "[escape-arena] total="
        _line = _line + strings.IntToStr(result.totalSlots)
        _line = _line + " none="
        _line = _line + strings.IntToStr(result.noneCount)
        _line = _line + " local="
        _line = _line + strings.IntToStr(result.localCount)
        _line = _line + " return="
        _line = _line + strings.IntToStr(result.returnCount)
        _line = _line + " global="
        _line = _line + strings.IntToStr(result.globalCount)
        _line = _line + " unknown="
        _line = _line + strings.IntToStr(result.unknownCount)
        os.WriteLine(os.GetStderr(), _line)

    return result

@borrows
fn EscapeArenaRouteSlotEscape(result: EscapeArenaRouteResult,
                               slotIndex: int32): int32 =
    if slotIndex < 0 || slotIndex >= result.slotEscapes.len:
        return EscapeKindUnknown
    return result.slotEscapes[slotIndex]

@borrows
fn EscapeArenaRouteSlotIsArenaSafe(result: EscapeArenaRouteResult,
                                    slotIndex: int32): bool =
    let kind = EscapeArenaRouteSlotEscape(result, slotIndex)
    return kind == EscapeKindNone || kind == EscapeKindLocal
