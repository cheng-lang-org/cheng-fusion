import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/std/bytes_layout as layout
import std/os

# Canonical semantic access decoder for BodyIR.  This is deliberately separate
# from register allocation: it turns every supported op/term/call shape into one
# ordered stream of uses, effects, clobbers and definitions.  Consumers must
# reject table.valid=false; there is no "treat every operand as a slot" path.

const
    BodyIrAccessSiteEntry = 1
    BodyIrAccessSiteOp = 2
    BodyIrAccessSiteTerm = 3

    BodyIrAccessFactUse = 1
    BodyIrAccessFactDef = 2
    BodyIrAccessFactFixed = 3
    BodyIrAccessFactMemory = 4
    BodyIrAccessFactClobber = 5
    BodyIrAccessFactAddress = 6

    BodyIrAccessFixedNone = 0
    BodyIrAccessFixedCallArg = 1
    BodyIrAccessFixedCallResult = 2
    BodyIrAccessFixedSretResult = 3
    BodyIrAccessFixedReturnValue = 4
    BodyIrAccessFixedGlobal = 5
    BodyIrAccessFixedSretForward = 6
    # 全覆盖写内征(setMem)的目的槽 def:调用本身完成 home 写入,与 sret 结果
    # 同构 — 不产生寄存器、不需要 producer,由结构性 bind 标记 home 已写。
    BodyIrAccessFixedCallWriteHome = 7

    BodyIrAccessClobberNone = 0
    BodyIrAccessClobberCallAbi = 1

    BodyIrAccessMemoryNone = 0
    BodyIrAccessMemoryLocalRead = 1
    BodyIrAccessMemoryLocalWrite = 2
    BodyIrAccessMemoryLocalReadWrite = 3
    BodyIrAccessMemoryIndirectRead = 4
    BodyIrAccessMemoryIndirectWrite = 5
    BodyIrAccessMemoryGlobalRead = 6
    BodyIrAccessMemoryGlobalWrite = 7
    BodyIrAccessMemoryCallReadWrite = 8

    BodyIrAccessNoIndex = -1
    BodyIrAccessNoValue = -1

    BodyIrAccessErrorNone = 0
    BodyIrAccessErrorUnknownOp = 1
    BodyIrAccessErrorArity = 2
    BodyIrAccessErrorLocalRef = 3
    BodyIrAccessErrorCallOrdinal = 4
    BodyIrAccessErrorCallShape = 5
    BodyIrAccessErrorPassKind = 6
    BodyIrAccessErrorEncodedArg = 7
    BodyIrAccessErrorTermShape = 8
    BodyIrAccessErrorLiteralRef = 9
    BodyIrAccessErrorOperandShape = 10
    BodyIrAccessErrorLocalShape = 11
    BodyIrAccessErrorAddressOwner = 12
    BodyIrAccessErrorAddressRange = 13
    BodyIrAccessErrorAbiLayout = 14
    BodyIrAccessErrorOwnership = 15

type
    BodyIrAccessFact =
        order: int32
        kind: int32
        siteKind: int32
        siteIndex: int32
        slotIndex: int32 = -1
        typeKind: int32
        operandIndex: int32 = -1
        valueId: int32 = -1
        defOrdinal: int32 = -1
        # Exact immutable value-definition identity.  This is independent of
        # physical fact/op order and is populated for every definition plus
        # the two manual-consume inputs.
        definitionDomain: int32
        definitionRow: int32 = -1
        consumesDefinition: bool
        # Sealed ExactDef call-arg CSR row that owns this projection.  This
        # separates semantic argument consumption from the CallOp's scalar
        # sourceDefinition pair: one call may consume several exact values.
        exactCallArgRow: int32 = -1
        manualConsumeRow: int32 = -1
        fixedKind: int32
        fixedOrdinal: int32 = -1
        clobberKind: int32
        memoryEffect: int32
        passKind: int32 = -1
        encodedValue: int32
        addressEscapes: bool
        addressOwnerSlot: int32 = -1
        addressByteOffset: int32
        addressByteLength: int32
        callOrdinal: int32 = -1
        abiSizeBytes: int32
        abiSizeExplicit: bool
        outgoingStackArgIndex: int32 = -1
        outgoingStackByteOffset: int32 = -1
        outgoingStackByteWidth: int32
        outgoingStackFrameBytes: int32

    BodyIrAccessTable =
        facts: BodyIrAccessFact[]
        opFactStarts: int32[]
        opFactCounts: int32[]
        termFactStarts: int32[]
        termFactCounts: int32[]
        callFactStarts: int32[]
        callFactCounts: int32[]
        callUseCounts: int32[]
        callResultPassKinds: int32[]
        # Dense call-domain accelerator.  -1 means the CallOp has no
        # @manual_consume effect; otherwise the value is the unique sidecar
        # row.  The three fact-index arrays are dense in sidecar-row order.
        manualConsumeRowByCallOrdinal: int32[]
        manualConsumeTargetConsumeFactIndices: int32[]
        manualConsumeSourceConsumeFactIndices: int32[]
        manualConsumePostDefinitionFactIndices: int32[]
        entryValueIdsBySlot: int32[]
        defFactIndices: int32[]
        useFactIndices: int32[]
        valueSlotIndices: int32[]
        valueTypeKinds: int32[]
        valueDefinitionDomains: int32[]
        valueDefinitionRows: int32[]
        nextValueId: int32
        valid: bool
        errorCode: int32
        errorSiteKind: int32
        errorSiteIndex: int32 = -1
        errorDetail: int32
        # [wall126] 判词富化：Ownership 拒绝门的唯一相位标识（=fail 调用
        # 首行在 body_ir_access.cheng 中的源行号），0=非 Ownership 路径
        # 或未打标。detail 在多门间语义重叠（originKind/manualConsume 行/
        # 定义序数皆可为 0），phase 消歧归因。
        errorPhase: int32

    BodyIrAccessManagedDefinitionIndex =
        bucketCount: int32
        definitionOriginKinds: int32[]
        definitionOriginIds: int32[]
        definitionSlots: int32[]
        definitionOwnershipKinds: int32[]
        definitionSemanticRows: int32[]
        definitionTemplateRows: int32[]
        definitionLastReplayRows: int32[]
        # Exact DOD identity map.  Each domain owns its row space and maps
        # directly to one dense managed-definition ordinal.
        entryDefinitionOrdinals: int32[]
        bodyOpDefinitionOrdinals: int32[]
        manualPostDefinitionOrdinals: int32[]
        definitionDomains: int32[]
        definitionRows: int32[]
        definitionSlotsByOrdinal: int32[]
        definitionOwnershipKindsByOrdinal: int32[]
        borrowOwnerDefinitionOrdinals: int32[]
        consumeActionRows: int32[]
        returnConsumeOpByDefinition: int32[]
        returnConsumeTermCountByDefinition: int32[]
        lastReturnConsumeTermByDefinition: int32[]
        managedMoveStoreOpByDefinition: int32[]
        explicitSourceOpCountByDefinition: int32[]
        lastExplicitSourceOpByDefinition: int32[]
        hasMatchingDefinitionFactByOp: bool[]
        managedDefinitionCountBySlot: int32[]
        retainActionRows: int32[]
        retainSourceDefinitionOrdinals: int32[]
        retainCallOps: int32[]
        retainDefinitionUseCounts: int32[]
        retainedDerivationByOp: bool[]

    BodyIrAccessDeferReplayIndex =
        # Dense projection of the core-validated replay relation. A mapped
        # replay op has both rows >= 0; a referenced template has
        # replayRow=-1 and templateRow=self.
        replayRowByOp: int32[]
        templateRowByOp: int32[]

    BodyIrAccessDefinitionCfg =
        opBlockIds: int32[]
        termBlockIds: int32[]
        transferStartsByOp: int32[]
        transferCountsByOp: int32[]
        transferKinds: int32[]
        transferDefinitionOrdinals: int32[]
        blockReached: bool[]
        blockEndStates: int32[]

const
    # Exact per-slot CFG lattice.  Block reachability is also carried
    # explicitly so an unreachable row is never confused with a consumed
    # managed definition.
    BodyIrAccessCfgUnreached = -3
    BodyIrAccessCfgAmbiguous = -2
    BodyIrAccessCfgConsumed = -1
    BodyIrAccessCfgTransferKill = 1
    BodyIrAccessCfgTransferGen = 2

fn bodyIrAccessDefinitionPairIsInvalid(
        domain: int32,
        row: int32): bool =
    return domain ==
               coreir.BodyDefinitionDomainInvalidTag &&
           row == BodyIrAccessNoIndex

fn bodyIrAccessDefinitionPairEqual(
        lhsDomain: int32,
        lhsRow: int32,
        rhsDomain: int32,
        rhsRow: int32): bool =
    return lhsDomain == rhsDomain && lhsRow == rhsRow

@borrows
fn bodyIrAccessManualPostCallOpIndex(
        bodyIR: coreir.BodyIR,
        manualRow: int32): int32 =
    if manualRow < 0 ||
       manualRow >= bodyIR.manualConsume.callOrdinals.len:
        return BodyIrAccessNoIndex
    let callOrdinal =
        bodyIR.manualConsume.callOrdinals[manualRow]
    var found = BodyIrAccessNoIndex
    for opIndex in 0..<bodyIR.ops.len:
        if bodyIR.ops[opIndex].kind ==
               coreir.BodyOpCallTag &&
           bodyIR.ops[opIndex].operands.len == 1 &&
           bodyIR.ops[opIndex].operands[0] ==
               callOrdinal:
            if found != BodyIrAccessNoIndex:
                return BodyIrAccessNoIndex
            found = opIndex
    return found

@borrows
fn bodyIrAccessDefinitionPairShapeValid(
        bodyIR: coreir.BodyIR,
        domain: int32,
        row: int32): bool =
    if domain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        return row >= 0 &&
               row < bodyIR.localSlots.len &&
               bodyIR.entryDefinitionOwnershipSealed &&
               row <
                   bodyIR.entryDefinitionOwnershipKinds.len &&
               bodyIR.localSlots[row].stackOffset < 0
    if domain ==
           coreir.BodyDefinitionDomainBodyOpTag:
        return row >= 0 &&
               row < bodyIR.ops.len &&
               bodyIR.ops[row].valueDefOwnership !=
                   coreir.OwnInvalid &&
               bodyIR.ops[row].valueDefSlot >= 0 &&
               bodyIR.ops[row].valueDefSlot <
                   bodyIR.localSlots.len
    if domain ==
           coreir.BodyDefinitionDomainManualConsumePostCallTag:
        return row >= 0 &&
               row <
                   bodyIR.manualConsume.postDefinitionRows.len &&
               bodyIR.manualConsume.postDefinitionDomains[row] ==
                   coreir.BodyDefinitionDomainManualConsumePostCallTag &&
               bodyIR.manualConsume.postDefinitionRows[row] == row &&
               bodyIR.manualConsume.targetOwnerSlotIds[row] >= 0 &&
               bodyIR.manualConsume.targetOwnerSlotIds[row] <
                   bodyIR.localSlots.len &&
               bodyIrAccessManualPostCallOpIndex(
                   bodyIR, row) >= 0
    return false

@borrows
fn bodyIrAccessDefinitionSlot(
        bodyIR: coreir.BodyIR,
        domain: int32,
        row: int32): int32 =
    if !bodyIrAccessDefinitionPairShapeValid(
           bodyIR, domain, row):
        return BodyIrAccessNoIndex
    if domain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        return row
    if domain ==
           coreir.BodyDefinitionDomainBodyOpTag:
        return bodyIR.ops[row].valueDefSlot
    return bodyIR.manualConsume.targetOwnerSlotIds[row]

@borrows
fn bodyIrAccessDefinitionOwnership(
        bodyIR: coreir.BodyIR,
        domain: int32,
        row: int32): int32 =
    if !bodyIrAccessDefinitionPairShapeValid(
           bodyIR, domain, row):
        return int32(coreir.OwnInvalid)
    if domain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        return bodyIR.entryDefinitionOwnershipKinds[row]
    if domain ==
           coreir.BodyDefinitionDomainBodyOpTag:
        return int32(bodyIR.ops[row].valueDefOwnership)
    return int32(coreir.OwnMove)

@borrows
fn bodyIrAccessDefinitionSemanticRow(
        bodyIR: coreir.BodyIR,
        domain: int32,
        row: int32): int32 =
    if domain ==
           coreir.BodyDefinitionDomainEntrySlotTag &&
       row >= 0 &&
       row < bodyIR.entryDefinitionSemanticRows.len:
        return bodyIR.entryDefinitionSemanticRows[row]
    if domain ==
           coreir.BodyDefinitionDomainBodyOpTag &&
       row >= 0 && row < bodyIR.ops.len:
        return bodyIR.ops[row].valueDefSemanticRow
    return BodyIrAccessNoIndex

fn BodyIrAccessManagedDefinitionOrdinal(
        index: var BodyIrAccessManagedDefinitionIndex,
        domain: int32,
        row: int32): int32 =
    if domain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        if row >= 0 &&
           row < index.entryDefinitionOrdinals.len:
            return index.entryDefinitionOrdinals[row]
        return BodyIrAccessNoIndex
    if domain ==
           coreir.BodyDefinitionDomainBodyOpTag:
        if row >= 0 &&
           row < index.bodyOpDefinitionOrdinals.len:
            return index.bodyOpDefinitionOrdinals[row]
        return BodyIrAccessNoIndex
    if domain ==
           coreir.BodyDefinitionDomainManualConsumePostCallTag:
        if row >= 0 &&
           row < index.manualPostDefinitionOrdinals.len:
            return index.manualPostDefinitionOrdinals[row]
    return BodyIrAccessNoIndex

fn bodyIrAccessFail(table: var BodyIrAccessTable,
                    code: int32,
                    siteKind: int32,
                    siteIndex: int32,
                    detail: int32) =
    if table.valid:
        table.errorCode = code
        table.errorSiteKind = siteKind
        table.errorSiteIndex = siteIndex
        table.errorDetail = detail
    table.valid = false

# [wall126] Ownership 拒绝门相位标记：phase=fail 调用首行源行号（见
# errorPhase 注记）。仅判词富化，错误四元组语义与 bodyIrAccessFail
# 逐字节一致。
fn bodyIrAccessFailPhase(table: var BodyIrAccessTable,
                         phase: int32,
                         code: int32,
                         siteKind: int32,
                         siteIndex: int32,
                         detail: int32) =
    if table.valid:
        table.errorPhase = phase
    bodyIrAccessFail(table, code, siteKind, siteIndex, detail)

@borrows
fn bodyIrAccessLocalValid(bodyIR: coreir.BodyIR, slotIndex: int32): bool =
    return slotIndex >= 0 && slotIndex < bodyIR.localSlots.len

@borrows
@borrow_result
fn bodyIrAccessOpAt(
        bodyIR: coreir.BodyIR,
        opIndex: int32): coreir.BodyOp =
    return bodyIR.ops[opIndex]

@borrows
@borrow_result
fn bodyIrAccessCallAt(
        bodyIR: coreir.BodyIR,
        callOrdinal: int32): coreir.CallOp =
    return bodyIR.callSequence[callOrdinal]

@borrows
@borrow_result
fn bodyIrAccessTermAt(
        bodyIR: coreir.BodyIR,
        termIndex: int32): coreir.BodyTerm =
    return bodyIR.terms[termIndex]

@borrows
@borrow_result
fn bodyIrAccessLocalSlotAt(
        bodyIR: coreir.BodyIR,
        slotIndex: int32): coreir.LocalSlot =
    return bodyIR.localSlots[slotIndex]

fn bodyIrAccessLocalTypeValid(typeKind: int32): bool =
    return typeKind >= coreir.LocalI32Tag &&
           typeKind <= coreir.LocalI64Tag

fn bodyIrAccessPlaceKindValid(placeKind: int32): bool =
    return placeKind >= coreir.BodyPlaceStackValueTag &&
           placeKind <= coreir.BodyPlaceGlobalAddressTag

@borrows
fn bodyIrAccessAddressDescriptor(bodyIR: coreir.BodyIR,
                                 slotIndex: int32,
                                 ownerSlot: var int32,
                                 byteOffset: var int32,
                                 byteLength: var int32): int32 =
    if !bodyIrAccessLocalValid(bodyIR, slotIndex):
        return BodyIrAccessErrorLocalRef
    if bodyIR.localSlots[slotIndex].sizeBytes <= 0 ||
       bodyIR.localSlots[slotIndex].alignBytes <= 0:
        return BodyIrAccessErrorAddressRange
    if bodyIR.localSlots[slotIndex].stackOffset >= 0 &&
       bodyIR.localSlots[slotIndex].stackOffset %
           bodyIR.localSlots[slotIndex].alignBytes != 0:
        return BodyIrAccessErrorAddressRange
    ownerSlot = slotIndex
    byteOffset = 0
    byteLength = bodyIR.localSlots[slotIndex].sizeBytes
    if bodyIR.localSlots[slotIndex].placeKind !=
           coreir.BodyPlaceBorrowAddressTag:
        return BodyIrAccessErrorNone
    ownerSlot = bodyIR.localSlots[slotIndex].auxValue
    if !bodyIrAccessLocalValid(bodyIR, ownerSlot) ||
       ownerSlot == slotIndex ||
       bodyIR.localSlots[ownerSlot].placeKind !=
           coreir.BodyPlaceStackValueTag:
        return BodyIrAccessErrorAddressOwner
    if bodyIR.localSlots[ownerSlot].stackOffset < 0 ||
       bodyIR.localSlots[ownerSlot].sizeBytes <= 0 ||
       bodyIR.localSlots[ownerSlot].alignBytes <= 0 ||
       bodyIR.localSlots[ownerSlot].stackOffset %
           bodyIR.localSlots[ownerSlot].alignBytes != 0 ||
       bodyIR.localSlots[slotIndex].stackOffset <
           bodyIR.localSlots[ownerSlot].stackOffset ||
       bodyIR.localSlots[slotIndex].sizeBytes >
           bodyIR.localSlots[ownerSlot].sizeBytes:
        return BodyIrAccessErrorAddressRange
    byteOffset = bodyIR.localSlots[slotIndex].stackOffset -
                 bodyIR.localSlots[ownerSlot].stackOffset
    if byteOffset >
           bodyIR.localSlots[ownerSlot].sizeBytes -
           bodyIR.localSlots[slotIndex].sizeBytes:
        return BodyIrAccessErrorAddressRange
    return BodyIrAccessErrorNone

@borrows
fn bodyIrAccessManagedReplaceAddressDescriptorExact(
        bodyIR: coreir.BodyIR,
        siteKind: int32,
        siteIndex: int32,
        slotIndex: int32,
        ownerSlot: var int32,
        byteOffset: var int32,
        byteLength: var int32): bool =
    if siteKind != BodyIrAccessSiteOp ||
       siteIndex < 0 || siteIndex >= bodyIR.ops.len:
        return false
    let siteOp = bodyIR.ops[siteIndex]
    if siteOp.kind != coreir.BodyOpCallTag ||
       siteOp.operands.len != 1 ||
       siteOp.operands[0] < 0 ||
       siteOp.operands[0] >= bodyIR.callSequence.len:
        return false
    let callOrdinal = siteOp.operands[0]
    let receiptRow =
        bodyIR.callSequence[callOrdinal].managedReplaceReceiptRow
    if receiptRow < 0 ||
       receiptRow >=
           bodyIR.managedLvalueReplace.callOrdinals.len ||
       bodyIR.managedLvalueReplace.callOrdinals[receiptRow] !=
           callOrdinal ||
       bodyIR.managedLvalueReplace.targetAddressSlotIds[
           receiptRow] != slotIndex:
        return false
    let addressDefinitionRow =
        bodyIR.managedLvalueReplace.targetAddressDefinitionRows[
            receiptRow]
    let pathStart =
        bodyIR.managedLvalueReplace.pathStarts[receiptRow]
    let pathCount =
        bodyIR.managedLvalueReplace.pathCounts[receiptRow]
    if addressDefinitionRow < 0 ||
       addressDefinitionRow >= siteIndex ||
       pathStart < 0 || pathCount <= 0 ||
       pathStart >
           bodyIR.managedLvalueReplace.pathByteWidths.len - pathCount:
        return false
    let addressOp = bodyIR.ops[addressDefinitionRow]
    if addressOp.kind != coreir.BodyOpLoadLocalTag ||
       addressOp.operands.len != 5 ||
       addressOp.operands[0] !=
           coreir.BodyLoadLocalIndexedAddressTag ||
       addressOp.target != slotIndex ||
       addressOp.operands[1] < 0 ||
       addressOp.operands[1] >= bodyIR.localSlots.len:
        return false
    ownerSlot = addressOp.operands[1]
    byteOffset = 0
    byteLength =
        bodyIR.managedLvalueReplace.pathByteWidths[
            pathStart + pathCount - 1]
    return byteLength > 0

@borrows
fn BodyIrAccessAddressFactIsValid(bodyIR: coreir.BodyIR,
                                  fact: BodyIrAccessFact): bool =
    if fact.kind != BodyIrAccessFactAddress || !fact.addressEscapes ||
       fact.slotIndex < 0 || fact.slotIndex >= bodyIR.localSlots.len:
        return false
    var ownerSlot: int32 = -1
    var byteOffset: int32
    var byteLength: int32
    if !bodyIrAccessManagedReplaceAddressDescriptorExact(
           bodyIR, fact.siteKind, fact.siteIndex, fact.slotIndex,
           ownerSlot, byteOffset, byteLength):
        if bodyIrAccessAddressDescriptor(bodyIR, fact.slotIndex,
                                         ownerSlot, byteOffset,
                                         byteLength) !=
               BodyIrAccessErrorNone:
            return false
    return fact.typeKind == bodyIR.localSlots[fact.slotIndex].typeKind &&
           fact.addressOwnerSlot == ownerSlot &&
           fact.addressByteOffset == byteOffset &&
           fact.addressByteLength == byteLength

@borrows
fn BodyIrAccessBaseIsLocalMemory(bodyIR: coreir.BodyIR,
                                slotIndex: int32): bool =
    if !bodyIrAccessLocalValid(bodyIR, slotIndex):
        return false
    return (bodyIR.localSlots[slotIndex].typeKind ==
                coreir.LocalAggregateTag ||
            bodyIR.localSlots[slotIndex].typeKind ==
                coreir.LocalStrTag) &&
           bodyIR.localSlots[slotIndex].stackOffset >= 0 &&
           bodyIR.localSlots[slotIndex].placeKind ==
               coreir.BodyPlaceStackValueTag

@borrows
fn BodyIrAccessStoreDefinesBase(bodyIR: coreir.BodyIR,
                               slotIndex: int32): bool =
    return BodyIrAccessBaseIsLocalMemory(bodyIR, slotIndex) &&
           bodyIR.localSlots[slotIndex].typeKind ==
               coreir.LocalAggregateTag

@borrows
fn bodyIrAccessAppendStoreBaseUse(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        opIndex: int32,
        baseSlot: int32,
        isStore: bool): bool =
    if bodyIrAccessLocalValid(bodyIR, baseSlot) &&
       bodyIR.localSlots[baseSlot].placeKind ==
           coreir.BodyPlaceGlobalAddressTag:
        return bodyIrAccessAppendGlobalRef(
            bodyIR, table, opIndex, baseSlot, 0)
    if isStore && BodyIrAccessStoreDefinesBase(bodyIR, baseSlot):
        return true
    return bodyIrAccessAppendUse(
        bodyIR, table, BodyIrAccessSiteOp, opIndex,
        baseSlot, 0, BodyIrAccessFixedNone,
        BodyIrAccessNoIndex, BodyIrAccessNoIndex, false)

@borrows
fn bodyIrAccessCopyCompatible(bodyIR: coreir.BodyIR,
                              sourceSlot: int32,
                              targetSlot: int32): bool =
    if !bodyIrAccessLocalValid(bodyIR, sourceSlot) ||
       !bodyIrAccessLocalValid(bodyIR, targetSlot):
        return false
    let source = bodyIrAccessLocalSlotAt(
        bodyIR, sourceSlot)
    let target = bodyIrAccessLocalSlotAt(
        bodyIR, targetSlot)
    if target.typeKind == coreir.LocalPtrTag:
        if target.auxValue == coreir.LocalI32Tag:
            return source.typeKind == coreir.LocalI32Tag
        if target.auxValue == coreir.LocalI64Tag:
            return source.typeKind == coreir.LocalI32Tag ||
                   source.typeKind == coreir.LocalI64Tag ||
                   source.typeKind == coreir.LocalPtrTag
        if target.auxValue == coreir.LocalStrTag:
            return source.typeKind == coreir.LocalStrTag
    if source.typeKind == target.typeKind:
        if target.typeKind == coreir.LocalStrTag ||
           target.typeKind == coreir.LocalAggregateTag:
            return source.sizeBytes == target.sizeBytes &&
                   target.sizeBytes > 0
        return true
    if target.typeKind == coreir.LocalI64Tag:
        return source.typeKind == coreir.LocalI32Tag ||
               source.typeKind == coreir.LocalPtrTag
    if target.typeKind == coreir.LocalI32Tag:
        return source.typeKind == coreir.LocalI64Tag
    if target.typeKind == coreir.LocalPtrTag:
        return source.typeKind == coreir.LocalI64Tag
    return false

fn bodyIrAccessAppend(table: var BodyIrAccessTable,
                      kind: int32,
                      siteKind: int32,
                      siteIndex: int32,
                      slotIndex: int32,
                      operandIndex: int32,
                      fixedKind: int32,
                      fixedOrdinal: int32,
                      clobberKind: int32,
                      memoryEffect: int32,
                      passKind: int32,
                      encodedValue: int32,
                      addressEscapes: bool): int32 =
    var fact: BodyIrAccessFact
    fact.order = table.facts.len
    fact.kind = kind
    fact.siteKind = siteKind
    fact.siteIndex = siteIndex
    fact.slotIndex = slotIndex
    fact.typeKind = coreir.LocalInvalidTag
    fact.operandIndex = operandIndex
    fact.valueId = BodyIrAccessNoValue
    fact.defOrdinal = BodyIrAccessNoValue
    fact.definitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    fact.definitionRow = BodyIrAccessNoIndex
    fact.exactCallArgRow = BodyIrAccessNoIndex
    fact.manualConsumeRow = BodyIrAccessNoIndex
    fact.fixedKind = fixedKind
    fact.fixedOrdinal = fixedOrdinal
    fact.clobberKind = clobberKind
    fact.memoryEffect = memoryEffect
    fact.passKind = passKind
    fact.encodedValue = encodedValue
    fact.addressEscapes = addressEscapes
    fact.addressOwnerSlot = BodyIrAccessNoIndex
    fact.callOrdinal = BodyIrAccessNoIndex
    fact.outgoingStackArgIndex = BodyIrAccessNoIndex
    fact.outgoingStackByteOffset = BodyIrAccessNoIndex
    add(table.facts, fact)
    return table.facts.len - 1

@borrows
fn bodyIrAccessAppendUse(bodyIR: coreir.BodyIR,
                         table: var BodyIrAccessTable,
                         siteKind: int32,
                         siteIndex: int32,
                         slotIndex: int32,
                         operandIndex: int32,
                         fixedKind: int32,
                         fixedOrdinal: int32,
                         passKind: int32,
                         addressEscapes: bool): bool =
    if !bodyIrAccessLocalValid(bodyIR, slotIndex):
        bodyIrAccessFail(table,
                         BodyIrAccessErrorLocalRef,
                         siteKind,
                         siteIndex,
                         slotIndex)
        return false
    let factIndex = bodyIrAccessAppend(table,
                                       BodyIrAccessFactUse,
                                       siteKind,
                                       siteIndex,
                                       slotIndex,
                                       operandIndex,
                                       fixedKind,
                                       fixedOrdinal,
                                       BodyIrAccessClobberNone,
                                       BodyIrAccessMemoryNone,
                                       passKind,
                                       0,
                                       addressEscapes)
    add(table.useFactIndices, factIndex)
    table.facts[factIndex].typeKind = bodyIR.localSlots[slotIndex].typeKind
    return true

@borrows
fn bodyIrAccessAppendDefExact(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        siteKind: int32,
        siteIndex: int32,
        slotIndex: int32,
        fixedKind: int32,
        definitionDomain: int32,
        definitionRow: int32,
        manualConsumeRow: int32): int32 =
    if !bodyIrAccessLocalValid(bodyIR, slotIndex):
        bodyIrAccessFail(table,
                         BodyIrAccessErrorLocalRef,
                         siteKind,
                         siteIndex,
                         slotIndex)
        return BodyIrAccessNoValue
    if definitionDomain == coreir.BodyDefinitionDomainInvalidTag ||
       definitionRow < 0:
        bodyIrAccessFailPhase(table, 689,
                         BodyIrAccessErrorOwnership,
                         siteKind,
                         siteIndex,
                         definitionDomain)
        return BodyIrAccessNoValue
    let factIndex = bodyIrAccessAppend(table,
                                       BodyIrAccessFactDef,
                                       siteKind,
                                       siteIndex,
                                       slotIndex,
                                       BodyIrAccessNoIndex,
                                       fixedKind,
                                       BodyIrAccessNoIndex,
                                       BodyIrAccessClobberNone,
                                       BodyIrAccessMemoryNone,
                                       BodyIrAccessNoIndex,
                                       0,
                                       false)
    let valueId = table.nextValueId
    table.nextValueId = table.nextValueId + 1
    table.facts[factIndex].valueId = valueId
    table.facts[factIndex].defOrdinal = valueId
    table.facts[factIndex].definitionDomain =
        definitionDomain
    table.facts[factIndex].definitionRow = definitionRow
    table.facts[factIndex].manualConsumeRow =
        manualConsumeRow
    table.facts[factIndex].typeKind = bodyIR.localSlots[slotIndex].typeKind
    add(table.valueSlotIndices, slotIndex)
    add(table.valueTypeKinds, bodyIR.localSlots[slotIndex].typeKind)
    add(table.valueDefinitionDomains, definitionDomain)
    add(table.valueDefinitionRows, definitionRow)
    add(table.defFactIndices, factIndex)
    return valueId

@borrows
fn bodyIrAccessAppendDef(bodyIR: coreir.BodyIR,
                         table: var BodyIrAccessTable,
                         siteKind: int32,
                         siteIndex: int32,
                         slotIndex: int32,
                         fixedKind: int32): int32 =
    var definitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    var definitionRow = siteIndex
    if siteKind == BodyIrAccessSiteEntry:
        definitionDomain =
            coreir.BodyDefinitionDomainEntrySlotTag
        definitionRow = slotIndex
    return bodyIrAccessAppendDefExact(
        bodyIR, table, siteKind, siteIndex,
        slotIndex, fixedKind,
        definitionDomain, definitionRow,
        BodyIrAccessNoIndex)

fn bodyIrAccessAppendFixed(table: var BodyIrAccessTable,
                           siteKind: int32,
                           siteIndex: int32,
                           operandIndex: int32,
                           fixedKind: int32,
                           fixedOrdinal: int32,
                           passKind: int32,
                           encodedValue: int32,
                           addressEscapes: bool) =
    let _ = bodyIrAccessAppend(table,
                               BodyIrAccessFactFixed,
                               siteKind,
                               siteIndex,
                               BodyIrAccessNoIndex,
                               operandIndex,
                               fixedKind,
                               fixedOrdinal,
                               BodyIrAccessClobberNone,
                               BodyIrAccessMemoryNone,
                               passKind,
                               encodedValue,
                               addressEscapes)

@borrows
fn bodyIrAccessAppendAddress(bodyIR: coreir.BodyIR,
                             table: var BodyIrAccessTable,
                             siteKind: int32,
                             siteIndex: int32,
                             slotIndex: int32,
                             operandIndex: int32,
                             fixedKind: int32,
                             fixedOrdinal: int32,
                             passKind: int32): bool =
    var ownerSlot: int32 = -1
    var byteOffset: int32
    var byteLength: int32
    var descriptorError = BodyIrAccessErrorNone
    if !bodyIrAccessManagedReplaceAddressDescriptorExact(
           bodyIR, siteKind, siteIndex, slotIndex,
           ownerSlot, byteOffset, byteLength):
        descriptorError = bodyIrAccessAddressDescriptor(
            bodyIR, slotIndex, ownerSlot, byteOffset, byteLength)
    if descriptorError != BodyIrAccessErrorNone:
        bodyIrAccessFail(table,
                         descriptorError,
                         siteKind,
                         siteIndex,
                         slotIndex)
        return false
    let factIndex = bodyIrAccessAppend(table,
                                       BodyIrAccessFactAddress,
                                       siteKind,
                                       siteIndex,
                                       slotIndex,
                                       operandIndex,
                                       fixedKind,
                                       fixedOrdinal,
                                       BodyIrAccessClobberNone,
                                       BodyIrAccessMemoryNone,
                                       passKind,
                                       0,
                                       true)
    table.facts[factIndex].typeKind =
        bodyIR.localSlots[slotIndex].typeKind
    table.facts[factIndex].addressOwnerSlot = ownerSlot
    table.facts[factIndex].addressByteOffset = byteOffset
    table.facts[factIndex].addressByteLength = byteLength
    return true

fn bodyIrAccessAppendMemory(table: var BodyIrAccessTable,
                            siteKind: int32,
                            siteIndex: int32,
                            effect: int32) =
    let _ = bodyIrAccessAppend(table,
                               BodyIrAccessFactMemory,
                               siteKind,
                               siteIndex,
                               BodyIrAccessNoIndex,
                               BodyIrAccessNoIndex,
                               BodyIrAccessFixedNone,
                               BodyIrAccessNoIndex,
                               BodyIrAccessClobberNone,
                               effect,
                               BodyIrAccessNoIndex,
                               0,
                               false)

@borrows
fn bodyIrAccessAppendGlobalRef(bodyIR: coreir.BodyIR,
                               table: var BodyIrAccessTable,
                               opIndex: int32,
                               slotIndex: int32,
                               operandIndex: int32): bool =
    if !bodyIrAccessLocalValid(bodyIR, slotIndex):
        bodyIrAccessFail(table, BodyIrAccessErrorLocalRef,
                         BodyIrAccessSiteOp, opIndex, slotIndex)
        return false
    if bodyIR.localSlots[slotIndex].placeKind !=
       coreir.BodyPlaceGlobalAddressTag:
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, slotIndex)
        return false
    let factIndex = bodyIrAccessAppend(table,
                                       BodyIrAccessFactFixed,
                                       BodyIrAccessSiteOp,
                                       opIndex,
                                       slotIndex,
                                       operandIndex,
                                       BodyIrAccessFixedGlobal,
                                       BodyIrAccessNoIndex,
                                       BodyIrAccessClobberNone,
                                       BodyIrAccessMemoryNone,
                                       BodyIrAccessNoIndex,
                                       slotIndex,
                                       false)
    table.facts[factIndex].typeKind = bodyIR.localSlots[slotIndex].typeKind
    return factIndex >= 0

fn bodyIrAccessAppendCallClobber(table: var BodyIrAccessTable,
                                 siteKind: int32,
                                 siteIndex: int32,
                                 callOrdinal: int32) =
    let factIndex = bodyIrAccessAppend(table,
                                       BodyIrAccessFactClobber,
                                       siteKind,
                                       siteIndex,
                                       BodyIrAccessNoIndex,
                                       BodyIrAccessNoIndex,
                                       BodyIrAccessFixedNone,
                                       BodyIrAccessNoIndex,
                                       BodyIrAccessClobberCallAbi,
                                       BodyIrAccessMemoryNone,
                                       BodyIrAccessNoIndex,
                                       callOrdinal,
                                       false)
    table.facts[factIndex].callOrdinal = callOrdinal

fn bodyIrAccessArgPassKindValid(kind: int32): bool =
    return kind == coreir.BodyCallPassStackValueTag ||
           kind == coreir.BodyCallPassParamAddressTag ||
           kind == coreir.BodyCallPassBorrowAddressTag ||
           kind == coreir.BodyCallPassByAddressAggregateTag ||
           kind == coreir.BodyCallPassGlobalAddressTag ||
           kind == coreir.BodyCallPassPtrNilTag

fn bodyIrAccessResultPassKindValid(kind: int32): bool =
    return kind == coreir.BodyCallPassStackValueTag ||
           kind == coreir.BodyCallPassSretResultTag ||
           kind == coreir.BodyCallPassForwardEntrySretTag

fn bodyIrAccessAbiSizeValid(sizeBytes: int32): bool =
    return sizeBytes == 1 || sizeBytes == 2 ||
           sizeBytes == 4 || sizeBytes == 8

@borrows
fn bodyIrAccessCallArgIsCompositeStackValue(
        bodyIR: coreir.BodyIR,
        encodedSlot: int32,
        passKind: int32): bool =
    if passKind != coreir.BodyCallPassStackValueTag ||
       encodedSlot < 0 || encodedSlot >= bodyIR.localSlots.len:
        return false
    let typeKind = bodyIR.localSlots[encodedSlot].typeKind
    return typeKind == coreir.LocalStrTag ||
           typeKind == coreir.LocalAggregateTag

@borrows
fn bodyIrAccessCallArgUsesAddressChannel(
        bodyIR: coreir.BodyIR,
        encodedSlot: int32,
        passKind: int32): bool =
    return passKind == coreir.BodyCallPassParamAddressTag ||
           passKind == coreir.BodyCallPassBorrowAddressTag ||
           passKind == coreir.BodyCallPassByAddressAggregateTag ||
           passKind == coreir.BodyCallPassGlobalAddressTag ||
           passKind == coreir.BodyCallPassPtrNilTag ||
           coreir.CallArgSlotIsCString(encodedSlot) ||
           coreir.CallArgSlotIsAddress(encodedSlot) ||
           bodyIrAccessCallArgIsCompositeStackValue(
               bodyIR, encodedSlot, passKind)

@borrows
fn bodyIrAccessCallArgAbiSizeValid(
        bodyIR: coreir.BodyIR,
        encodedSlot: int32,
        passKind: int32,
        sizeBytes: int32): bool =
    if !bodyIrAccessAbiSizeValid(sizeBytes):
        return false
    if bodyIrAccessCallArgUsesAddressChannel(
           bodyIR, encodedSlot, passKind):
        return sizeBytes == 8
    return true

@borrows
fn bodyIrAccessCallArgAbiSize(bodyIR: coreir.BodyIR,
                              encodedSlot: int32,
                              passKind: int32): int32 =
    if bodyIrAccessCallArgUsesAddressChannel(
           bodyIR, encodedSlot, passKind):
        return 8
    if encodedSlot >= 0 && encodedSlot < bodyIR.localSlots.len:
        let sizeBytes = bodyIR.localSlots[encodedSlot].sizeBytes
        if bodyIrAccessAbiSizeValid(sizeBytes):
            return sizeBytes
    if coreir.CallArgSlotIsConst(encodedSlot):
        return 4
    return 0

@borrows
fn bodyIrAccessDecodeCallArg(bodyIR: coreir.BodyIR,
                             table: var BodyIrAccessTable,
                             opIndex: int32,
                             argIndex: int32,
                             encodedSlot: int32,
                             passKind: int32,
                             writeOnlyAddress: bool): bool =
    if !bodyIrAccessArgPassKindValid(passKind):
        bodyIrAccessFail(table,
                         BodyIrAccessErrorPassKind,
                         BodyIrAccessSiteOp,
                         opIndex,
                         passKind)
        return false
    if passKind == coreir.BodyCallPassPtrNilTag:
        if coreir.CallArgSlotConstOrdinal(encodedSlot) != 3:
            bodyIrAccessFail(table,
                             BodyIrAccessErrorEncodedArg,
                             BodyIrAccessSiteOp,
                             opIndex,
                             encodedSlot)
            return false
        bodyIrAccessAppendFixed(table,
                                BodyIrAccessSiteOp,
                                opIndex,
                                argIndex,
                                BodyIrAccessFixedCallArg,
                                argIndex,
                                passKind,
                                encodedSlot,
                                false)
        return true
    if passKind == coreir.BodyCallPassGlobalAddressTag:
        if !bodyIrAccessLocalValid(bodyIR, encodedSlot):
            bodyIrAccessFail(table,
                             BodyIrAccessErrorLocalRef,
                             BodyIrAccessSiteOp,
                             opIndex,
                             encodedSlot)
            return false
        if bodyIR.localSlots[encodedSlot].placeKind !=
           coreir.BodyPlaceGlobalAddressTag:
            bodyIrAccessFail(table,
                             BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp,
                             opIndex,
                             encodedSlot)
            return false
        return bodyIrAccessAppendAddress(bodyIR, table,
                                         BodyIrAccessSiteOp, opIndex,
                                         encodedSlot, argIndex,
                                         BodyIrAccessFixedCallArg, argIndex,
                                         passKind)
    if passKind == coreir.BodyCallPassParamAddressTag ||
       passKind == coreir.BodyCallPassBorrowAddressTag ||
       passKind == coreir.BodyCallPassByAddressAggregateTag:
        if !coreir.CallArgSlotIsAddress(encodedSlot):
            bodyIrAccessFail(table,
                             BodyIrAccessErrorEncodedArg,
                             BodyIrAccessSiteOp,
                             opIndex,
                             encodedSlot)
            return false
        let addressSlot = coreir.CallArgSlotAddressId(encodedSlot)
        if writeOnlyAddress:
            # 只写目的(setMem dst):取址不读值、不外逃,既不记 address 也不记
            # value use;仅保留 ABI 实参 fixed 事实,写语义由调用方先行注册
            # 的 def 表达(全覆盖写)。
            bodyIrAccessAppendFixed(table,
                                    BodyIrAccessSiteOp,
                                    opIndex,
                                    argIndex,
                                    BodyIrAccessFixedCallArg,
                                    argIndex,
                                    passKind,
                                    encodedSlot,
                                    false)
            return true
        if !bodyIrAccessAppendAddress(bodyIR,
                                      table,
                                      BodyIrAccessSiteOp,
                                      opIndex,
                                      addressSlot,
                                      argIndex,
                                      BodyIrAccessFixedCallArg,
                                      argIndex,
                                      passKind):
            return false
        return bodyIrAccessAppendUse(bodyIR, table,
                                     BodyIrAccessSiteOp, opIndex,
                                     addressSlot, argIndex,
                                     BodyIrAccessFixedCallArg, argIndex,
                                     passKind, true)
    if encodedSlot == coreir.CallArgSlotMissing():
        bodyIrAccessFail(table,
                         BodyIrAccessErrorEncodedArg,
                         BodyIrAccessSiteOp,
                         opIndex,
                         encodedSlot)
        return false
    if encodedSlot >= 0:
        if bodyIrAccessCallArgIsCompositeStackValue(
               bodyIR, encodedSlot, passKind):
            if !bodyIrAccessAppendAddress(
                   bodyIR, table, BodyIrAccessSiteOp, opIndex,
                   encodedSlot, argIndex,
                   BodyIrAccessFixedCallArg, argIndex, passKind):
                return false
            return bodyIrAccessAppendUse(
                bodyIR, table, BodyIrAccessSiteOp, opIndex,
                encodedSlot, argIndex,
                BodyIrAccessFixedCallArg, argIndex, passKind, true)
        return bodyIrAccessAppendUse(bodyIR,
                                     table,
                                     BodyIrAccessSiteOp,
                                     opIndex,
                                     encodedSlot,
                                     argIndex,
                                     BodyIrAccessFixedCallArg,
                                     argIndex,
                                     passKind,
                                     false)
    if coreir.CallArgSlotIsAddress(encodedSlot):
        let addressSlot = coreir.CallArgSlotAddressId(encodedSlot)
        if writeOnlyAddress:
            # 只写目的(setMem dst):取址不读值、不外逃,既不记 address 也不记
            # value use;仅保留 ABI 实参 fixed 事实,写语义由调用方先行注册
            # 的 def 表达(全覆盖写)。
            bodyIrAccessAppendFixed(table,
                                    BodyIrAccessSiteOp,
                                    opIndex,
                                    argIndex,
                                    BodyIrAccessFixedCallArg,
                                    argIndex,
                                    passKind,
                                    encodedSlot,
                                    false)
            return true
        if !bodyIrAccessAppendAddress(bodyIR,
                                      table,
                                      BodyIrAccessSiteOp,
                                      opIndex,
                                      addressSlot,
                                      argIndex,
                                      BodyIrAccessFixedCallArg,
                                      argIndex,
                                      passKind):
            return false
        return bodyIrAccessAppendUse(bodyIR, table,
                                     BodyIrAccessSiteOp, opIndex,
                                     addressSlot, argIndex,
                                     BodyIrAccessFixedCallArg, argIndex,
                                     passKind, true)
    if coreir.CallArgSlotIsCString(encodedSlot):
        let literalId = coreir.CallArgSlotCStringId(encodedSlot)
        if literalId < 0 || literalId >= bodyIR.cstringLiterals.len:
            bodyIrAccessFail(table,
                             BodyIrAccessErrorLiteralRef,
                             BodyIrAccessSiteOp,
                             opIndex,
                             literalId)
            return false
        bodyIrAccessAppendFixed(table,
                                BodyIrAccessSiteOp,
                                opIndex,
                                argIndex,
                                BodyIrAccessFixedCallArg,
                                argIndex,
                                passKind,
                                encodedSlot,
                                false)
        return true
    if coreir.CallArgSlotIsConst(encodedSlot):
        bodyIrAccessAppendFixed(table,
                                BodyIrAccessSiteOp,
                                opIndex,
                                argIndex,
                                BodyIrAccessFixedCallArg,
                                argIndex,
                                passKind,
                                encodedSlot,
                                false)
        return true
    bodyIrAccessFail(table,
                     BodyIrAccessErrorEncodedArg,
                     BodyIrAccessSiteOp,
                     opIndex,
                     encodedSlot)
    return false

@borrows
fn bodyIrAccessBuildManualConsumeCallIndex(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable): bool =
    for _ in 0..<bodyIR.callSequence.len:
        add(table.manualConsumeRowByCallOrdinal,
            BodyIrAccessNoIndex)
    for row in 0..<bodyIR.manualConsume.callOrdinals.len:
        let callOrdinal =
            bodyIR.manualConsume.callOrdinals[row]
        if callOrdinal < 0 ||
           callOrdinal >=
               table.manualConsumeRowByCallOrdinal.len ||
           table.manualConsumeRowByCallOrdinal[
               callOrdinal] != BodyIrAccessNoIndex:
            bodyIrAccessFailPhase(
                table, 1160,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                BodyIrAccessNoIndex,
                callOrdinal)
            return false
        table.manualConsumeRowByCallOrdinal[
            callOrdinal] = row
        add(table.manualConsumeTargetConsumeFactIndices,
            BodyIrAccessNoIndex)
        add(table.manualConsumeSourceConsumeFactIndices,
            BodyIrAccessNoIndex)
        add(table.manualConsumePostDefinitionFactIndices,
            BodyIrAccessNoIndex)
    return true

fn BodyIrAccessManualConsumeRowForCall(
        table: var BodyIrAccessTable,
        callOrdinal: int32): int32 =
    if callOrdinal < 0 ||
       callOrdinal >=
           table.manualConsumeRowByCallOrdinal.len:
        return BodyIrAccessNoIndex
    return table.manualConsumeRowByCallOrdinal[callOrdinal]

@borrows
fn bodyIrAccessManagedReplaceTargetArgumentExact(
        bodyIR: coreir.BodyIR,
        call: coreir.CallOp): bool =
    if call.argSlots.len < 2 ||
       call.argPassKinds.len != call.argSlots.len:
        return false
    let encodedTarget = call.argSlots[0]
    let targetPassKind = call.argPassKinds[0]
    if targetPassKind ==
           coreir.BodyCallPassGlobalAddressTag:
        return bodyIrAccessLocalValid(
                   bodyIR, encodedTarget) &&
               bodyIR.localSlots[encodedTarget].placeKind ==
                   coreir.BodyPlaceGlobalAddressTag
    if targetPassKind !=
           coreir.BodyCallPassBorrowAddressTag ||
       !coreir.CallArgSlotIsAddress(encodedTarget):
        return false
    let targetSlot =
        coreir.CallArgSlotAddressId(encodedTarget)
    return bodyIrAccessLocalValid(bodyIR, targetSlot) &&
           bodyIR.localSlots[targetSlot].placeKind ==
               coreir.BodyPlaceBorrowAddressTag

@borrows
fn bodyIrAccessMarkManualConsumeInput(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        row: int32,
        argFactStart: int32,
        argFactEnd: int32,
        isTarget: bool): bool =
    var expectedSlot =
        bodyIR.manualConsume.sourcePlaceSlotIds[row]
    var expectedOwner = expectedSlot
    var expectedOrdinal =
        bodyIR.manualConsume.sourceArgumentOrdinals[row]
    var definitionDomain =
        bodyIR.manualConsume.sourceDefinitionDomains[row]
    var definitionRow =
        bodyIR.manualConsume.sourceDefinitionRows[row]
    var expectedKind = BodyIrAccessFactUse
    if isTarget:
        expectedSlot =
            bodyIR.manualConsume.targetPlaceSlotIds[row]
        expectedOwner =
            bodyIR.manualConsume.targetOwnerSlotIds[row]
        expectedOrdinal =
            bodyIR.manualConsume.targetArgumentOrdinals[row]
        definitionDomain =
            bodyIR.manualConsume.targetDefinitionDomains[row]
        definitionRow =
            bodyIR.manualConsume.targetDefinitionRows[row]
        expectedKind = BodyIrAccessFactAddress
    var found = BodyIrAccessNoIndex
    for factIndex in argFactStart..<argFactEnd:
        if table.facts[factIndex].kind == expectedKind &&
           table.facts[factIndex].fixedKind ==
               BodyIrAccessFixedCallArg &&
           table.facts[factIndex].fixedOrdinal ==
               expectedOrdinal &&
           table.facts[factIndex].slotIndex ==
               expectedSlot &&
           (!isTarget ||
            table.facts[factIndex].addressOwnerSlot ==
                expectedOwner):
            if found != BodyIrAccessNoIndex:
                bodyIrAccessFailPhase(
                    table, 1254,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    table.facts[factIndex].siteIndex,
                    row)
                return false
            found = factIndex
    if found == BodyIrAccessNoIndex:
        bodyIrAccessFailPhase(
            table, 1263,
            BodyIrAccessErrorOwnership,
            BodyIrAccessSiteOp,
            BodyIrAccessNoIndex,
            row)
        return false
    table.facts[found].definitionDomain =
        definitionDomain
    table.facts[found].definitionRow = definitionRow
    table.facts[found].consumesDefinition = true
    table.facts[found].manualConsumeRow = row
    if isTarget:
        table.manualConsumeTargetConsumeFactIndices[row] =
            found
    else:
        table.manualConsumeSourceConsumeFactIndices[row] =
            found
    return true

@borrows
fn bodyIrAccessBindExactCallArg(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        opIndex: int32,
        callOrdinal: int32,
        argIndex: int32,
        argFactStart: int32,
        argFactEnd: int32): bool =
    if !bodyIR.exactDef.sealed:
        return true
    let argRow = bodyIR.exactDef.callArgStarts[callOrdinal] + argIndex
    if argRow < 0 ||
       argRow >= bodyIR.exactDef.argDefOpRows.len:
        bodyIrAccessFailPhase(table, 1297,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         argRow)
        return false
    let definitionRow = bodyIR.exactDef.argDefOpRows[argRow]
    let argumentOwnership = bodyIR.exactDef.argOwnerships[argRow]
    if argumentOwnership != int32(coreir.OwnPlain) &&
       argumentOwnership != int32(coreir.OwnMove) &&
       argumentOwnership != int32(coreir.OwnBorrowShared) &&
       argumentOwnership != int32(coreir.OwnBorrowUnique):
        bodyIrAccessFailPhase(table, 1309,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         argumentOwnership)
        return false
    if definitionRow < 0:
        if argumentOwnership == int32(coreir.OwnMove):
            bodyIrAccessFailPhase(table, 1317,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             argRow)
            return false
        return true
    # BodyOp row order is storage order, not control-flow order.  The exact
    # CFG verifier below proves that this precise definition is live on every
    # path reaching the call; imposing definitionRow < opIndex here would
    # reject a legal block layout whose producer block is stored later.
    if definitionRow >= bodyIR.ops.len:
        bodyIrAccessFailPhase(table, 1329,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         definitionRow)
        return false
    let definition = bodyIR.ops[definitionRow]
    let encodedSlot =
        bodyIR.callSequence[callOrdinal].argSlots[argIndex]
    if encodedSlot < 0 ||
       definition.valueDefSlot != encodedSlot ||
       definition.valueDefOwnership == coreir.OwnInvalid ||
       (argumentOwnership == int32(coreir.OwnMove) &&
        definition.valueDefOwnership != coreir.OwnMove) ||
       bodyIR.exactDef.argPlaceKinds[argRow] !=
           bodyIR.exactDef.opPlaceKinds[definitionRow] ||
       bodyIR.exactDef.argOriginIds[argRow] !=
           bodyIR.exactDef.opOriginIds[definitionRow]:
        bodyIrAccessFailPhase(table, 1347,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         definitionRow)
        return false
    # Any argument which moves a definition must be its only reference in
    # this call.  Two shared reads remain legal; borrow+move and move+move do
    # not, because all call arguments are simultaneously live at entry.
    for priorArgIndex in 0..<argIndex:
        let priorArgRow =
            bodyIR.exactDef.callArgStarts[callOrdinal] + priorArgIndex
        if bodyIR.exactDef.argDefOpRows[priorArgRow] == definitionRow &&
           (argumentOwnership == int32(coreir.OwnMove) ||
            bodyIR.exactDef.argOwnerships[priorArgRow] ==
                int32(coreir.OwnMove)):
            bodyIrAccessFailPhase(table, 1363,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             definitionRow)
            return false
    var found = BodyIrAccessNoIndex
    for factIndex in argFactStart..<argFactEnd:
        if table.facts[factIndex].kind == BodyIrAccessFactUse &&
           table.facts[factIndex].fixedKind ==
               BodyIrAccessFixedCallArg &&
           table.facts[factIndex].fixedOrdinal == argIndex &&
           table.facts[factIndex].slotIndex == encodedSlot:
            if found != BodyIrAccessNoIndex:
                bodyIrAccessFailPhase(table, 1377,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteOp,
                                 opIndex,
                                 argRow)
                return false
            found = factIndex
    if found == BodyIrAccessNoIndex ||
       (!bodyIrAccessDefinitionPairIsInvalid(
            table.facts[found].definitionDomain,
            table.facts[found].definitionRow) &&
        !bodyIrAccessDefinitionPairEqual(
            table.facts[found].definitionDomain,
            table.facts[found].definitionRow,
            coreir.BodyDefinitionDomainBodyOpTag,
            definitionRow)):
        bodyIrAccessFailPhase(table, 1393,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         argRow)
        return false
    table.facts[found].definitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    table.facts[found].definitionRow = definitionRow
    table.facts[found].consumesDefinition =
        argumentOwnership == int32(coreir.OwnMove)
    table.facts[found].exactCallArgRow = argRow
    return true

@borrows
fn bodyIrAccessDecodeCallOrdinal(bodyIR: coreir.BodyIR,
                                 table: var BodyIrAccessTable,
                                 opIndex: int32,
                                 callOrdinal: int32,
                                 resultSlot: int32): bool =
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
        bodyIrAccessFail(table,
                         BodyIrAccessErrorCallOrdinal,
                         BodyIrAccessSiteOp,
                         opIndex,
                         callOrdinal)
        return false
    if table.callUseCounts[callOrdinal] != 0:
        bodyIrAccessFail(table,
                         BodyIrAccessErrorCallOrdinal,
                         BodyIrAccessSiteOp,
                         opIndex,
                         callOrdinal)
        return false
    let manualConsumeRow =
        BodyIrAccessManualConsumeRowForCall(
            table, callOrdinal)
    if manualConsumeRow >= 0 &&
       (bodyIR.ops[opIndex].kind !=
            coreir.BodyOpCallTag ||
        bodyIR.ops[opIndex].operands.len != 1 ||
        bodyIR.ops[opIndex].operands[0] !=
            callOrdinal ||
        bodyIR.callSequence[
            callOrdinal].managedStoreKind !=
            coreir.ManagedStoreNoneTag):
        bodyIrAccessFailPhase(table, 1439,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         manualConsumeRow)
        return false
    if bodyIR.callSequence[callOrdinal].targetSymbol == "setMem" && bodyIR.callSequence[callOrdinal].argSlots.len == 3 &&
       coreir.CallArgSlotIsAddress(bodyIR.callSequence[callOrdinal].argSlots[0]):
        # setMem(dst, val, size) 是全覆盖写:目的槽的值不依赖先前内容,def
        # 必须先于本 op 的地址实参 use 注册,否则聚合零初始化
        # (AppendZeroLocalSlot)在 CFG 初始化分析里永远不可见,后续任一读
        # 都被误判 uninitialized。
        let zeroDestSlot = coreir.CallArgSlotAddressId(bodyIR.callSequence[callOrdinal].argSlots[0])
        if bodyIrAccessLocalValid(bodyIR, zeroDestSlot) &&
           bodyIR.localSlots[zeroDestSlot].placeKind !=
               coreir.BodyPlaceGlobalAddressTag:
            if bodyIrAccessAppendDef(bodyIR,
                                     table,
                                     BodyIrAccessSiteOp,
                                     opIndex,
                                     zeroDestSlot,
                                     BodyIrAccessFixedCallWriteHome) < 0:
                return false
    let managedSnapshot =
        bodyIR.callSequence[callOrdinal].managedStoreKind ==
            coreir.ManagedStoreSnapshotRetainTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind ==
            coreir.ManagedStoreSnapshotCloneTag
    let managedCleanupRetain =
        bodyIR.callSequence[callOrdinal].managedStoreKind ==
            coreir.ManagedStoreCleanupRetainTag
    let managedReplace =
        bodyIR.callSequence[callOrdinal].managedStoreKind == coreir.ManagedStoreStrRetainTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind == coreir.ManagedStoreStrMoveTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind == coreir.ManagedStoreSeqRetainTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind == coreir.ManagedStoreSeqMoveTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind ==
            coreir.ManagedStoreAggregateRetainTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind ==
            coreir.ManagedStoreAggregateMoveTag
    let managedReplaceMove =
        bodyIR.callSequence[callOrdinal].managedStoreKind == coreir.ManagedStoreStrMoveTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind == coreir.ManagedStoreSeqMoveTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind ==
            coreir.ManagedStoreAggregateMoveTag
    let managedReplaceRetain =
        bodyIR.callSequence[callOrdinal].managedStoreKind == coreir.ManagedStoreStrRetainTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind == coreir.ManagedStoreSeqRetainTag ||
        bodyIR.callSequence[callOrdinal].managedStoreKind ==
            coreir.ManagedStoreAggregateRetainTag
    if bodyIR.callSequence[callOrdinal].managedStoreKind != coreir.ManagedStoreNoneTag &&
         !managedReplace &&
         !managedSnapshot &&
         !managedCleanupRetain:
        bodyIrAccessFailPhase(table, 1493,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         bodyIR.callSequence[callOrdinal].managedStoreKind)
        return false
    if managedCleanupRetain &&
       (bodyIR.callSequence[callOrdinal].resultSlot != -1 ||
        bodyIR.callSequence[callOrdinal].resultOwnership != coreir.OwnInvalid ||
        bodyIR.callSequence[callOrdinal].resultExprNodeIndex != -1 ||
        bodyIR.callSequence[callOrdinal].resultValueDefinitionRow != -1 ||
        bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind !=
            coreir.BodyDefinitionOriginUnknownTag ||
        bodyIR.callSequence[callOrdinal].resultDefinitionOriginId != -1 ||
        !bodyIrAccessDefinitionPairShapeValid(
            bodyIR,
            bodyIR.callSequence[
                callOrdinal].sourceDefinitionDomain,
            bodyIR.callSequence[
                callOrdinal].sourceDefinitionRow) ||
        bodyIR.callSequence[callOrdinal].consumeActionRow < 0 ||
        bodyIR.callSequence[callOrdinal].argSlots.len != 1 ||
        bodyIR.callSequence[callOrdinal].argPassKinds.len != 1 ||
        !coreir.CallArgSlotIsAddress(bodyIR.callSequence[callOrdinal].argSlots[0]) ||
        bodyIR.callSequence[callOrdinal].argPassKinds[0] !=
            coreir.BodyCallPassByAddressAggregateTag ||
        coreir.CallArgSlotAddressId(bodyIR.callSequence[callOrdinal].argSlots[0]) !=
            bodyIrAccessDefinitionSlot(
                bodyIR,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionDomain,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionRow)):
        bodyIrAccessFailPhase(table, 1526,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         bodyIR.callSequence[callOrdinal].managedStoreKind)
        return false
    if managedSnapshot &&
       (bodyIR.callSequence[callOrdinal].resultSlot < 0 ||
        bodyIR.callSequence[callOrdinal].resultPassKind !=
            coreir.BodyCallPassSretResultTag ||
        bodyIR.callSequence[callOrdinal].resultOwnership != coreir.OwnMove ||
        bodyIR.callSequence[callOrdinal].resultValueDefinitionRow < 0 ||
        bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind !=
            coreir.BodyDefinitionOriginCanonicalCleanupActionTag ||
        bodyIR.callSequence[callOrdinal].resultDefinitionOriginId < 0 ||
        !bodyIrAccessDefinitionPairShapeValid(
            bodyIR,
            bodyIR.callSequence[
                callOrdinal].sourceDefinitionDomain,
            bodyIR.callSequence[
                callOrdinal].sourceDefinitionRow) ||
        bodyIR.callSequence[callOrdinal].resultValueDefinitionRow !=
            bodyIrAccessDefinitionSemanticRow(
                bodyIR,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionDomain,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionRow) ||
        bodyIR.callSequence[callOrdinal].consumeActionRow != -1 ||
        bodyIR.callSequence[callOrdinal].argSlots.len != 1 ||
        bodyIR.callSequence[callOrdinal].argPassKinds.len != 1 ||
        !coreir.CallArgSlotIsAddress(bodyIR.callSequence[callOrdinal].argSlots[0]) ||
        bodyIR.callSequence[callOrdinal].argPassKinds[0] !=
            coreir.BodyCallPassByAddressAggregateTag):
        bodyIrAccessFailPhase(table, 1560,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         bodyIR.callSequence[callOrdinal].managedStoreKind)
        return false
    if managedReplace &&
        (bodyIR.callSequence[callOrdinal].resultSlot != -1 ||
         bodyIR.callSequence[callOrdinal].resultOwnership != coreir.OwnInvalid ||
         bodyIR.callSequence[callOrdinal].resultExprNodeIndex != -1 ||
         bodyIR.callSequence[callOrdinal].resultValueDefinitionRow != -1 ||
         bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind !=
             coreir.BodyDefinitionOriginUnknownTag ||
         bodyIR.callSequence[callOrdinal].resultDefinitionOriginId != -1 ||
         !bodyIrAccessDefinitionPairShapeValid(
             bodyIR,
             bodyIR.callSequence[
                 callOrdinal].sourceDefinitionDomain,
             bodyIR.callSequence[
                 callOrdinal].sourceDefinitionRow) ||
         (managedReplaceMove &&
          bodyIR.callSequence[callOrdinal].consumeActionRow < 0) ||
         (managedReplaceRetain &&
          bodyIR.callSequence[callOrdinal].consumeActionRow != -1) ||
         bodyIR.callSequence[callOrdinal].argSlots.len !=
             ((bodyIR.callSequence[callOrdinal].managedStoreKind ==
                   coreir.ManagedStoreAggregateRetainTag ||
               bodyIR.callSequence[callOrdinal].managedStoreKind ==
                   coreir.ManagedStoreAggregateMoveTag) ? 6 : 2) ||
         bodyIR.callSequence[callOrdinal].argPassKinds.len !=
             bodyIR.callSequence[callOrdinal].argSlots.len ||
         !bodyIrAccessManagedReplaceTargetArgumentExact(
             bodyIR,
             bodyIR.callSequence[callOrdinal]) ||
         (bodyIR.callSequence[callOrdinal].argPassKinds[1] != coreir.BodyCallPassGlobalAddressTag &&
          bodyIR.callSequence[callOrdinal].argPassKinds[1] != coreir.BodyCallPassParamAddressTag &&
          bodyIR.callSequence[callOrdinal].argPassKinds[1] !=
              coreir.BodyCallPassBorrowAddressTag)):
        bodyIrAccessFailPhase(table, 1598,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         bodyIR.callSequence[callOrdinal].managedStoreKind)
        return false
    if bodyIR.callSequence[callOrdinal].argSlots.len != bodyIR.callSequence[callOrdinal].argPassKinds.len:
        bodyIrAccessFail(table,
                         BodyIrAccessErrorCallShape,
                         BodyIrAccessSiteOp,
                         opIndex,
                         bodyIR.callSequence[callOrdinal].argPassKinds.len)
        return false
    if bodyIR.callSequence[callOrdinal].argAbiSizes.len != 0 && bodyIR.callSequence[callOrdinal].argAbiSizes.len != bodyIR.callSequence[callOrdinal].argSlots.len:
        bodyIrAccessFail(table,
                         BodyIrAccessErrorCallShape,
                         BodyIrAccessSiteOp,
                         opIndex,
                         bodyIR.callSequence[callOrdinal].argAbiSizes.len)
        return false
    if !bodyIrAccessResultPassKindValid(bodyIR.callSequence[callOrdinal].resultPassKind):
        bodyIrAccessFail(table,
                         BodyIrAccessErrorPassKind,
                         BodyIrAccessSiteOp,
                         opIndex,
                         bodyIR.callSequence[callOrdinal].resultPassKind)
        return false
    if resultSlot != bodyIR.callSequence[callOrdinal].resultSlot:
        bodyIrAccessFail(table,
                         BodyIrAccessErrorCallShape,
                         BodyIrAccessSiteOp,
                         opIndex,
                         resultSlot)
        return false
    let resultOwnership = int32(bodyIR.callSequence[callOrdinal].resultOwnership)
    if resultOwnership < int32(coreir.OwnInvalid) ||
       resultOwnership > int32(coreir.OwnBorrowUnique):
        bodyIrAccessFailPhase(table, 1635,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         opIndex,
                         resultOwnership)
        return false
    if bodyIR.callSequence[callOrdinal].resultOwnership != coreir.OwnInvalid:
        let typedOrigin =
            bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind ==
                coreir.BodyDefinitionOriginTypedExprTag
        let cleanupOrigin =
            bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind ==
                coreir.BodyDefinitionOriginCanonicalCleanupActionTag
        let sourceDefinitionValid =
            (typedOrigin &&
             bodyIrAccessDefinitionPairIsInvalid(
                 bodyIR.callSequence[
                     callOrdinal].sourceDefinitionDomain,
                 bodyIR.callSequence[
                     callOrdinal].sourceDefinitionRow)) ||
            (cleanupOrigin &&
             bodyIrAccessDefinitionPairShapeValid(
                 bodyIR,
                 bodyIR.callSequence[
                     callOrdinal].sourceDefinitionDomain,
                 bodyIR.callSequence[
                     callOrdinal].sourceDefinitionRow))
        if bodyIR.callSequence[callOrdinal].resultSlot < 0 || bodyIR.callSequence[callOrdinal].resultExprNodeIndex < 0 ||
           (!typedOrigin && !cleanupOrigin) ||
           bodyIR.callSequence[callOrdinal].resultDefinitionOriginId < 0 ||
           (typedOrigin &&
            bodyIR.callSequence[callOrdinal].resultDefinitionOriginId !=
                bodyIR.callSequence[callOrdinal].resultValueDefinitionRow) ||
           !sourceDefinitionValid ||
           bodyIR.callSequence[callOrdinal].consumeActionRow != -1:
            bodyIrAccessFailPhase(table, 1670,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             bodyIR.callSequence[callOrdinal].resultSlot)
            return false
        if bodyIR.callSequence[callOrdinal].resultOwnership == coreir.OwnMove ||
           bodyIR.callSequence[callOrdinal].resultOwnership == coreir.OwnBorrowShared:
            # The BodyOp definition may already bind its future canonical
            # consumer, while CallOp.consumeActionRow describes only this
            # call's own source effect.  Their independent validators below
            # prove both edges; equality here would reject every consumed call
            # result whose producing call has no source effect.
            if bodyIR.callSequence[callOrdinal].resultValueDefinitionRow < 0 ||
               (cleanupOrigin &&
                bodyIR.callSequence[callOrdinal].resultValueDefinitionRow !=
                    bodyIrAccessDefinitionSemanticRow(
                        bodyIR,
                        bodyIR.callSequence[
                            callOrdinal].sourceDefinitionDomain,
                        bodyIR.callSequence[
                            callOrdinal].sourceDefinitionRow)) ||
               bodyIR.ops[opIndex].valueDefSlot != bodyIR.callSequence[callOrdinal].resultSlot ||
               bodyIR.ops[opIndex].valueDefExprNodeIndex != bodyIR.callSequence[callOrdinal].resultExprNodeIndex ||
               bodyIR.ops[opIndex].valueDefSemanticRow !=
                   bodyIR.callSequence[callOrdinal].resultValueDefinitionRow ||
               bodyIR.ops[opIndex].valueDefOwnership != bodyIR.callSequence[callOrdinal].resultOwnership ||
               bodyIR.ops[opIndex].valueDefOriginKind !=
                   bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind ||
               bodyIR.ops[opIndex].valueDefOriginId != bodyIR.callSequence[callOrdinal].resultDefinitionOriginId ||
               !bodyIrAccessDefinitionPairEqual(
                   bodyIR.ops[
                       opIndex].sourceDefinitionDomain,
                   bodyIR.ops[
                       opIndex].sourceDefinitionRow,
                   bodyIR.callSequence[
                       callOrdinal].sourceDefinitionDomain,
                   bodyIR.callSequence[
                       callOrdinal].sourceDefinitionRow):
                bodyIrAccessFailPhase(table, 1709,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteOp,
                                 opIndex,
                                 bodyIR.callSequence[callOrdinal].resultSlot)
                return false
        elif bodyIR.callSequence[callOrdinal].resultOwnership != coreir.OwnPlain:
            bodyIrAccessFailPhase(table, 1716,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             int32(bodyIR.callSequence[callOrdinal].resultOwnership))
            return false
        elif bodyIR.callSequence[callOrdinal].resultValueDefinitionRow != -1:
            bodyIrAccessFailPhase(table, 1723,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             bodyIR.callSequence[callOrdinal].resultValueDefinitionRow)
            return false
    else:
        let explicitSourceConsumer =
            bodyIrAccessDefinitionPairShapeValid(
                bodyIR,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionDomain,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionRow) &&
            bodyIrAccessDefinitionPairEqual(
                bodyIR.ops[opIndex].sourceDefinitionDomain,
                bodyIR.ops[opIndex].sourceDefinitionRow,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionDomain,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionRow) &&
            bodyIR.ops[opIndex].consumeActionRow == bodyIR.callSequence[callOrdinal].consumeActionRow &&
            (bodyIR.callSequence[callOrdinal].consumeActionRow >= 0 ||
             managedReplaceRetain)
        let exactCleanupRetain =
            managedCleanupRetain &&
            bodyIrAccessDefinitionPairIsInvalid(
                bodyIR.ops[opIndex].sourceDefinitionDomain,
                bodyIR.ops[opIndex].sourceDefinitionRow) &&
            bodyIR.ops[opIndex].consumeActionRow == -1
        # [wall108] 非托管 call-result 纯值定义 admit 臂。发射器
        # PrimaryBodyIrBindUnmanagedCallResultDefinition 对非托管
        # call-result 以 OwnPlain 落 op valueDef 全列，而 CallOp 行六列
        # 保持 OwnInvalid/Unknown/-1 哨兵（既有契约）；原 else 臂强制
        # 「call OwnInvalid ⇒ op OwnInvalid」，把该纯值定义形误拒于
        # ingress。admit 谓词与发射器契约逐列联立自证：call 行全哨兵
        # （六列+源/消费列）∧ op OwnPlain+TypedExpr+originId==semanticRow
        # >=0 ∧ exprNode>=0 ∧ slot==resultSlot ∧ op 借主/源/消费列全
        # sentinel ∧ 槽 Unmanaged+tid>=0（发射器 panic 级证明的同一槽
        # 形）。任一列不符即不 admit，走原 else 臂原判词 fail-closed；
        # 无 sentinel 豁免、无计数门放宽、derive 零接触。
        # [wall108r2] 警示：本谓词与 return 纯值槽 admit 的 op 段判定
        # 禁止提取共享 helper——r2 实测提取 @borrows 谓词后在
        # decodeCallOrdinal（按值 bodyIR 形参）调用点 admit 翻 false
        # （v6 判词回退 w106 形，驱动 sha 确定性复现），值形参→借用
        # 形参的谓词调用路径嫌疑为编译器缺陷，已移交。两站点形漂移由
        # 本注记双点互检约束。
        let plainUnmanagedResultDefinition =
            bodyIR.callSequence[callOrdinal].resultExprNodeIndex == -1 &&
            bodyIR.callSequence[callOrdinal].resultValueDefinitionRow == -1 &&
            bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind ==
                coreir.BodyDefinitionOriginUnknownTag &&
            bodyIR.callSequence[callOrdinal].resultDefinitionOriginId == -1 &&
            bodyIR.callSequence[callOrdinal].resultBorrowOwnerValueDefinitionRow == -1 &&
            bodyIR.callSequence[callOrdinal].resultBorrowOwnerDefinitionDomain ==
                coreir.BodyDefinitionDomainInvalidTag &&
            bodyIR.callSequence[callOrdinal].resultBorrowOwnerDefinitionRow == -1 &&
            bodyIrAccessDefinitionPairIsInvalid(
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionDomain,
                bodyIR.callSequence[
                    callOrdinal].sourceDefinitionRow) &&
            bodyIR.callSequence[callOrdinal].consumeActionRow == -1 &&
            bodyIR.ops[opIndex].valueDefOwnership == coreir.OwnPlain &&
            bodyIR.ops[opIndex].valueDefOriginKind ==
                coreir.BodyDefinitionOriginTypedExprTag &&
            bodyIR.ops[opIndex].valueDefOriginId == bodyIR.ops[opIndex].valueDefSemanticRow &&
            bodyIR.ops[opIndex].valueDefOriginId >= 0 &&
            bodyIR.ops[opIndex].valueDefExprNodeIndex >= 0 &&
            bodyIR.ops[opIndex].valueDefSlot == bodyIR.callSequence[callOrdinal].resultSlot &&
            bodyIR.ops[opIndex].valueDefBorrowOwnerSemanticRow == -1 &&
            bodyIR.ops[opIndex].valueDefBorrowOwnerDefinitionDomain ==
                coreir.BodyDefinitionDomainInvalidTag &&
            bodyIR.ops[opIndex].valueDefBorrowOwnerDefinitionRow == -1 &&
            bodyIrAccessDefinitionPairIsInvalid(
                bodyIR.ops[opIndex].sourceDefinitionDomain,
                bodyIR.ops[opIndex].sourceDefinitionRow) &&
            bodyIR.ops[opIndex].consumeActionRow == -1 &&
            bodyIrAccessLocalValid(bodyIR, bodyIR.callSequence[callOrdinal].resultSlot) &&
            bodyIR.localSlots[bodyIR.callSequence[callOrdinal].resultSlot].managedStorageKind ==
                coreir.BodyManagedStorageUnmanagedTag &&
            bodyIR.localSlots[bodyIR.callSequence[callOrdinal].resultSlot].typeArenaTypeId >= 0
        if !plainUnmanagedResultDefinition &&
           (bodyIR.ops[opIndex].valueDefOwnership != coreir.OwnInvalid ||
           bodyIR.callSequence[callOrdinal].resultValueDefinitionRow != -1 ||
           bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind !=
               coreir.BodyDefinitionOriginUnknownTag ||
           bodyIR.callSequence[callOrdinal].resultDefinitionOriginId != -1 ||
           ((!bodyIrAccessDefinitionPairIsInvalid(
                  bodyIR.callSequence[
                      callOrdinal].sourceDefinitionDomain,
                  bodyIR.callSequence[
                      callOrdinal].sourceDefinitionRow) ||
             bodyIR.callSequence[callOrdinal].consumeActionRow != -1 ||
             !bodyIrAccessDefinitionPairIsInvalid(
                  bodyIR.ops[opIndex].sourceDefinitionDomain,
                  bodyIR.ops[opIndex].sourceDefinitionRow) ||
             bodyIR.ops[opIndex].consumeActionRow != -1) &&
            !explicitSourceConsumer &&
            !exactCleanupRetain)):
            bodyIrAccessFailPhase(table, 1823,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             int32(bodyIR.ops[opIndex].valueDefOwnership))
            return false
    table.callUseCounts[callOrdinal] = 1
    table.callFactStarts[callOrdinal] = table.facts.len
    for argIndex in 0..<bodyIR.callSequence[callOrdinal].argSlots.len:
        if !bodyIrAccessArgPassKindValid(bodyIR.callSequence[callOrdinal].argPassKinds[argIndex]):
            bodyIrAccessFail(table,
                             BodyIrAccessErrorPassKind,
                             BodyIrAccessSiteOp,
                             opIndex,
                             bodyIR.callSequence[callOrdinal].argPassKinds[argIndex])
            return false
        var abiSizeBytes = bodyIrAccessCallArgAbiSize(
            bodyIR, bodyIR.callSequence[callOrdinal].argSlots[argIndex], bodyIR.callSequence[callOrdinal].argPassKinds[argIndex])
        var abiSizeExplicit: bool
        if bodyIR.callSequence[callOrdinal].argAbiSizes.len > 0:
            abiSizeBytes = bodyIR.callSequence[callOrdinal].argAbiSizes[argIndex]
            abiSizeExplicit = true
            if !bodyIrAccessCallArgAbiSizeValid(
                   bodyIR, bodyIR.callSequence[callOrdinal].argSlots[argIndex],
                   bodyIR.callSequence[callOrdinal].argPassKinds[argIndex], abiSizeBytes):
                bodyIrAccessFail(table,
                                 BodyIrAccessErrorCallShape,
                                 BodyIrAccessSiteOp,
                                 opIndex,
                                 abiSizeBytes)
                return false
        elif !bodyIrAccessCallArgAbiSizeValid(
                 bodyIR, bodyIR.callSequence[callOrdinal].argSlots[argIndex],
                 bodyIR.callSequence[callOrdinal].argPassKinds[argIndex], abiSizeBytes):
            bodyIrAccessFail(table,
                             BodyIrAccessErrorCallShape,
                             BodyIrAccessSiteOp,
                             opIndex,
                             argIndex)
            return false
        let argFactStart = table.facts.len
        let argWriteOnly = bodyIR.callSequence[callOrdinal].targetSymbol == "setMem" && argIndex == 0 &&
                           coreir.CallArgSlotIsAddress(bodyIR.callSequence[callOrdinal].argSlots[argIndex])
        if !bodyIrAccessDecodeCallArg(bodyIR,
                                      table,
                                      opIndex,
                                      argIndex,
                                      bodyIR.callSequence[callOrdinal].argSlots[argIndex],
                                      bodyIR.callSequence[callOrdinal].argPassKinds[argIndex],
                                      argWriteOnly):
            return false
        let argFactEnd = table.facts.len
        for factIndex in argFactStart..<argFactEnd:
            if table.facts[factIndex].fixedKind ==
                   BodyIrAccessFixedCallArg &&
               table.facts[factIndex].fixedOrdinal == argIndex:
                table.facts[factIndex].callOrdinal = callOrdinal
                table.facts[factIndex].abiSizeBytes = abiSizeBytes
                table.facts[factIndex].abiSizeExplicit = abiSizeExplicit
        if manualConsumeRow >= 0 &&
           argIndex ==
               bodyIR.manualConsume.targetArgumentOrdinals[
                       manualConsumeRow]:
            if !bodyIrAccessMarkManualConsumeInput(
                   bodyIR, table, manualConsumeRow,
                   argFactStart, argFactEnd, true):
                return false
        if manualConsumeRow >= 0 &&
           argIndex ==
               bodyIR.manualConsume.sourceArgumentOrdinals[
                       manualConsumeRow]:
            if !bodyIrAccessMarkManualConsumeInput(
                   bodyIR, table, manualConsumeRow,
                   argFactStart, argFactEnd, false):
                return false
        if !bodyIrAccessBindExactCallArg(
               bodyIR, table, opIndex, callOrdinal,
               argIndex, argFactStart, argFactEnd):
            return false
    bodyIrAccessAppendMemory(table,
                             BodyIrAccessSiteOp,
                             opIndex,
                             BodyIrAccessMemoryCallReadWrite)
    if bodyIR.callSequence[callOrdinal].resultPassKind == coreir.BodyCallPassForwardEntrySretTag:
       if bodyIR.callSequence[callOrdinal].resultSlot >= 0 || !bodyIR.entryIsCAbi ||
           bodyIR.callSequence[callOrdinal].resultOwnership != coreir.OwnInvalid ||
           bodyIR.callSequence[callOrdinal].resultExprNodeIndex >= 0 ||
           bodyIR.callSequence[callOrdinal].resultDefinitionOriginKind !=
               coreir.BodyDefinitionOriginUnknownTag ||
           bodyIR.callSequence[callOrdinal].resultDefinitionOriginId != -1 ||
           !bodyIrAccessDefinitionPairIsInvalid(
               bodyIR.callSequence[
                   callOrdinal].sourceDefinitionDomain,
               bodyIR.callSequence[
                   callOrdinal].sourceDefinitionRow) ||
           bodyIR.callSequence[callOrdinal].consumeActionRow != -1:
            bodyIrAccessFail(table,
                             BodyIrAccessErrorCallShape,
                             BodyIrAccessSiteOp,
                             opIndex,
                             bodyIR.callSequence[callOrdinal].resultSlot)
            return false
        let forwardFactIndex = bodyIrAccessAppend(
            table,
            BodyIrAccessFactFixed,
            BodyIrAccessSiteOp,
            opIndex,
            BodyIrAccessNoIndex,
            BodyIrAccessNoIndex,
            BodyIrAccessFixedSretForward,
            BodyIrAccessNoIndex,
            BodyIrAccessClobberNone,
            BodyIrAccessMemoryNone,
            coreir.BodyCallPassForwardEntrySretTag,
            0,
            false)
        table.facts[forwardFactIndex].callOrdinal = callOrdinal
    bodyIrAccessAppendCallClobber(table,
                                  BodyIrAccessSiteOp,
                                  opIndex,
                                  callOrdinal)
    if bodyIR.callSequence[callOrdinal].resultSlot >= 0:
        var fixedKind = BodyIrAccessFixedCallResult
        if bodyIR.callSequence[callOrdinal].resultPassKind == coreir.BodyCallPassSretResultTag:
            fixedKind = BodyIrAccessFixedSretResult
        let resultValueId = bodyIrAccessAppendDef(
            bodyIR, table, BodyIrAccessSiteOp, opIndex,
            bodyIR.callSequence[callOrdinal].resultSlot, fixedKind)
        if resultValueId < 0 || table.facts.len <= 0:
            return false
        let resultFactIndex = table.facts.len - 1
        table.facts[resultFactIndex].callOrdinal = callOrdinal
    elif bodyIR.callSequence[callOrdinal].resultPassKind == coreir.BodyCallPassSretResultTag:
        bodyIrAccessFail(table,
                         BodyIrAccessErrorCallShape,
                         BodyIrAccessSiteOp,
                         opIndex,
                         bodyIR.callSequence[callOrdinal].resultSlot)
        return false
    if manualConsumeRow >= 0:
        let postValueId =
            bodyIrAccessAppendDefExact(
                bodyIR, table,
                BodyIrAccessSiteOp, opIndex,
                bodyIR.manualConsume.targetOwnerSlotIds[
                    manualConsumeRow],
                BodyIrAccessFixedNone,
                coreir.BodyDefinitionDomainManualConsumePostCallTag,
                manualConsumeRow,
                manualConsumeRow)
        if postValueId < 0:
            return false
        let postFactIndex = table.facts.len - 1
        table.facts[postFactIndex].callOrdinal =
            callOrdinal
        table.manualConsumePostDefinitionFactIndices[
            manualConsumeRow] = postFactIndex
        if table.manualConsumeTargetConsumeFactIndices[
               manualConsumeRow] < 0 ||
           table.manualConsumeSourceConsumeFactIndices[
               manualConsumeRow] < 0:
            bodyIrAccessFailPhase(
                table, 1984,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                opIndex,
                manualConsumeRow)
            return false
    table.callFactCounts[callOrdinal] = table.facts.len - table.callFactStarts[callOrdinal]
    return true

@borrows
fn bodyIrAccessDecodeCall(bodyIR: coreir.BodyIR,
                          table: var BodyIrAccessTable,
                          opIndex: int32,
                          op: coreir.BodyOp): bool =
    if op.operands.len != 1:
        bodyIrAccessFail(table,
                         BodyIrAccessErrorArity,
                         BodyIrAccessSiteOp,
                         opIndex,
                         op.operands.len)
        return false
    return bodyIrAccessDecodeCallOrdinal(bodyIR,
                                         table,
                                         opIndex,
                                         op.operands[0],
                                         op.target)

fn bodyIrAccessAlignBytes(value: int32, alignment: int32): int32 =
    if value < 0 || alignment <= 0:
        return -1
    let remainder = value % alignment
    if remainder == 0:
        return value
    let delta = alignment - remainder
    if value > 2147483647 - delta:
        return -1
    return value + delta

@borrows
fn BodyIrAccessApplyCallAbiLayout(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        registerArgCount: int32,
        sretShiftsFixedArgs: bool,
        packedStackArgs: bool,
        stackSlotBytes: int32,
        stackAlignmentBytes: int32): bool =
    if !table.valid:
        return false
    if registerArgCount < 0 || stackSlotBytes <= 0 ||
       stackAlignmentBytes <= 0 ||
       stackSlotBytes > stackAlignmentBytes:
        bodyIrAccessFail(table, BodyIrAccessErrorAbiLayout,
                         BodyIrAccessSiteEntry, -1, registerArgCount)
        return false
    for callOrdinal in 0..<bodyIR.callSequence.len:
        let call = bodyIrAccessCallAt(
            bodyIR, callOrdinal)
        if call.argSlots.len != call.argPassKinds.len ||
           (call.argAbiSizes.len != 0 &&
            call.argAbiSizes.len != call.argSlots.len):
            bodyIrAccessFail(table, BodyIrAccessErrorAbiLayout,
                             BodyIrAccessSiteOp, callOrdinal,
                             call.argSlots.len)
            return false
        var argOffsets: int32[]
        var argWidths: int32[]
        var argStackIndices: int32[]
        for _ in 0..<call.argSlots.len:
            add(argOffsets, -1)
            add(argWidths, 0)
            add(argStackIndices, -1)
        var nextStackOffset: int32
        var stackArgIndex: int32
        var effectiveRegisterArgCount = registerArgCount
        if sretShiftsFixedArgs &&
           (call.resultPassKind ==
                coreir.BodyCallPassSretResultTag ||
            call.resultPassKind ==
                coreir.BodyCallPassForwardEntrySretTag):
            effectiveRegisterArgCount =
                effectiveRegisterArgCount - 1
        if effectiveRegisterArgCount < 0:
            bodyIrAccessFail(table, BodyIrAccessErrorAbiLayout,
                             BodyIrAccessSiteOp, callOrdinal,
                             effectiveRegisterArgCount)
            return false
        for argIndex in 0..<call.argSlots.len:
            var abiSizeBytes = bodyIrAccessCallArgAbiSize(
                bodyIR, call.argSlots[argIndex], call.argPassKinds[argIndex])
            if call.argAbiSizes.len > 0:
                abiSizeBytes = call.argAbiSizes[argIndex]
            if !bodyIrAccessCallArgAbiSizeValid(
                   bodyIR, call.argSlots[argIndex],
                   call.argPassKinds[argIndex], abiSizeBytes):
                bodyIrAccessFail(table, BodyIrAccessErrorAbiLayout,
                                 BodyIrAccessSiteOp, callOrdinal,
                                 abiSizeBytes)
                return false
            if argIndex < effectiveRegisterArgCount:
                continue
            var byteOffset = stackArgIndex * stackSlotBytes
            var byteWidth = stackSlotBytes
            if packedStackArgs:
                byteOffset = bodyIrAccessAlignBytes(
                    nextStackOffset, abiSizeBytes)
                byteWidth = abiSizeBytes
            if byteOffset < 0 || byteWidth <= 0 ||
               byteOffset > 2147483647 - byteWidth:
                bodyIrAccessFail(table, BodyIrAccessErrorAbiLayout,
                                 BodyIrAccessSiteOp, callOrdinal,
                                 argIndex)
                return false
            argOffsets[argIndex] = byteOffset
            argWidths[argIndex] = byteWidth
            argStackIndices[argIndex] = stackArgIndex
            nextStackOffset = byteOffset + byteWidth
            stackArgIndex = stackArgIndex + 1
        let stackFrameBytes = bodyIrAccessAlignBytes(
            nextStackOffset, stackAlignmentBytes)
        if stackFrameBytes < 0:
            bodyIrAccessFail(table, BodyIrAccessErrorAbiLayout,
                             BodyIrAccessSiteOp, callOrdinal,
                             nextStackOffset)
            return false
        let factStart = table.callFactStarts[callOrdinal]
        let factCount = table.callFactCounts[callOrdinal]
        if factStart < 0 || factCount <= 0 ||
           factStart > table.facts.len - factCount:
            bodyIrAccessFail(table, BodyIrAccessErrorAbiLayout,
                             BodyIrAccessSiteOp, callOrdinal,
                             factStart)
            return false
        for factIndex in factStart..<(factStart + factCount):
            let argIndex = table.facts[factIndex].fixedOrdinal
            if table.facts[factIndex].fixedKind !=
                   BodyIrAccessFixedCallArg:
                continue
            if table.facts[factIndex].callOrdinal != callOrdinal ||
               argIndex < 0 || argIndex >= call.argSlots.len:
                bodyIrAccessFail(table, BodyIrAccessErrorAbiLayout,
                                 BodyIrAccessSiteOp, callOrdinal,
                                 factIndex)
                return false
            table.facts[factIndex].outgoingStackArgIndex =
                argStackIndices[argIndex]
            table.facts[factIndex].outgoingStackByteOffset =
                argOffsets[argIndex]
            table.facts[factIndex].outgoingStackByteWidth =
                argWidths[argIndex]
            table.facts[factIndex].outgoingStackFrameBytes =
                stackFrameBytes
    return true

@borrows
fn bodyIrAccessDecodeLocalCopy(bodyIR: coreir.BodyIR,
                               table: var BodyIrAccessTable,
                               opIndex: int32,
                               op: coreir.BodyOp): bool =
    if op.operands.len != 1:
        bodyIrAccessFail(table, BodyIrAccessErrorArity,
                         BodyIrAccessSiteOp, opIndex, op.operands.len)
        return false
    if !bodyIrAccessCopyCompatible(bodyIR, op.operands[0], op.target):
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, op.target)
        return false
    let targetSlot = bodyIrAccessLocalSlotAt(
        bodyIR, op.target)
    let sourceSlot = bodyIrAccessLocalSlotAt(
        bodyIR, op.operands[0])
    let sourceManaged =
        sourceSlot.managedStorageKind ==
            coreir.BodyManagedStorageManagedTag
    let targetManaged =
        targetSlot.managedStorageKind ==
            coreir.BodyManagedStorageManagedTag
    # Single-operand StoreLocal/LoadLocal are physical bit-copies and can
    # never establish or transfer managed ownership.  Managed replacement
    # has its own exact call/sidecar representation; accepting either raw
    # form would create a second authority.
    if (op.kind == coreir.BodyOpStoreLocalTag ||
        op.kind == coreir.BodyOpLoadLocalTag) &&
       (sourceManaged || targetManaged):
        bodyIrAccessFailPhase(table, 2169, BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp, opIndex, op.target)
        return false
    # A managed CopyLocal is an OwnMove transport between two managed slots.
    # Its canonical cleanup origin and exact source definition are classified
    # once by the immutable managed-definition verifier below; duplicating
    # that authority here would create two admission truths.
    # [wall111] borrowed-view 物化 admit 臂：PrimaryBodyIrMaterializeManaged
    # BorrowedNodeValueExact 对托管→托管 CopyLocal 逐列盖 TypedExpr 原点
    # OwnBorrowShared 权威戳（originKind=TypedExpr ∧ originId==semanticRow
    # >=0 ∧ exprNode>=0 ∧ 借主语义行>=0 ∧ 借主定义对经
    # bodyIrAccessDefinitionPairShapeValid 双域联立校验，BodyOp 域另拒自
    # 身 ∧ 源定义对保持 Invalid 哨兵 ∧ consumeActionRow==-1 ∧
    # consume_plus1==0）。该形无所有权转移，借主权威序/语义行/所有权种类
    # 的语义审仍归下方 immutable verifier（typedBorrowOwnerValid 臂）独
    # 家裁决，本臂只认戳形；任一列不符即走原判词原 detail 逐字节不变
    # （fail 条件仅外包 `!borrowViewCopyAdmit`）。
    var borrowViewCopyAdmit = false
    if op.kind == coreir.BodyOpCopyLocalTag &&
       op.valueDefOwnership == coreir.OwnBorrowShared &&
       op.valueDefOriginKind ==
           coreir.BodyDefinitionOriginTypedExprTag &&
       op.valueDefOriginId == op.valueDefSemanticRow &&
       op.valueDefOriginId >= 0 &&
       op.valueDefExprNodeIndex >= 0 &&
       op.valueDefBorrowOwnerSemanticRow >= 0 &&
       (op.valueDefBorrowOwnerDefinitionDomain ==
            coreir.BodyDefinitionDomainBodyOpTag ||
        op.valueDefBorrowOwnerDefinitionDomain ==
            coreir.BodyDefinitionDomainEntrySlotTag) &&
       bodyIrAccessDefinitionPairShapeValid(
           bodyIR,
           op.valueDefBorrowOwnerDefinitionDomain,
           op.valueDefBorrowOwnerDefinitionRow) &&
       (op.valueDefBorrowOwnerDefinitionDomain !=
            coreir.BodyDefinitionDomainBodyOpTag ||
        op.valueDefBorrowOwnerDefinitionRow != opIndex) &&
       bodyIrAccessDefinitionPairIsInvalid(
           op.sourceDefinitionDomain,
           op.sourceDefinitionRow) &&
       op.consumeActionRow == -1 &&
       op.valueDefConsumeOpIndexPlusOne == 0:
        borrowViewCopyAdmit = true
    if op.kind == coreir.BodyOpCopyLocalTag &&
       (sourceManaged || targetManaged) &&
        (!sourceManaged || !targetManaged ||
        op.valueDefSlot != op.target ||
        (op.valueDefOwnership != coreir.OwnMove &&
         !borrowViewCopyAdmit)):
        bodyIrAccessFailPhase(table, 2218, BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp, opIndex, op.target)
        return false
    let writesThroughPointer =
        targetSlot.typeKind == coreir.LocalPtrTag &&
        (targetSlot.auxValue == coreir.LocalI32Tag ||
         targetSlot.auxValue == coreir.LocalI64Tag ||
         targetSlot.auxValue == coreir.LocalStrTag)
    if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                              op.operands[0], 0, BodyIrAccessFixedNone,
                              BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
        return false
    if writesThroughPointer:
        if !bodyIrAccessAppendUse(
               bodyIR, table, BodyIrAccessSiteOp, opIndex,
               op.target, BodyIrAccessNoIndex,
               BodyIrAccessFixedNone, BodyIrAccessNoIndex,
               BodyIrAccessNoIndex, false):
            return false
        bodyIrAccessAppendMemory(
            table, BodyIrAccessSiteOp, opIndex,
            BodyIrAccessMemoryIndirectWrite)
        return true
    bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                             BodyIrAccessMemoryLocalReadWrite)
    return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                 op.target, BodyIrAccessFixedNone) >= 0

@borrows
fn bodyIrAccessDecodeLoadLocal(bodyIR: coreir.BodyIR,
                               table: var BodyIrAccessTable,
                               opIndex: int32,
                               op: coreir.BodyOp): bool =
    if op.operands.len == 1:
        return bodyIrAccessDecodeLocalCopy(bodyIR, table, opIndex, op)
    if op.operands.len == 5 &&
       op.operands[0] == coreir.BodyLoadLocalIndexedAddressTag:
        let rootSlot = op.operands[1]
        let indexSlot = op.operands[2]
        let elementSizeBytes = op.operands[3]
        let dynamicSequenceFlag = op.operands[4]
        if op.target < 0 || op.target >= bodyIR.localSlots.len ||
           bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag ||
           bodyIR.localSlots[op.target].placeKind !=
               coreir.BodyPlaceBorrowAddressTag ||
           bodyIR.localSlots[op.target].typeArenaTypeId < 0 ||
           bodyIR.localSlots[op.target].managedStorageKind !=
               coreir.BodyManagedStorageManagedTag ||
           op.valueDefSlot != op.target ||
           op.valueDefOwnership != coreir.OwnBorrowShared ||
           op.valueDefSemanticRow < 0 ||
           op.valueDefExprNodeIndex < 0 ||
           elementSizeBytes <= 0 ||
           (dynamicSequenceFlag != 0 && dynamicSequenceFlag != 1) ||
           !bodyIrAccessAppendUse(
               bodyIR, table, BodyIrAccessSiteOp, opIndex,
               rootSlot, 1, BodyIrAccessFixedNone,
               BodyIrAccessNoIndex, BodyIrAccessNoIndex, false) ||
           !bodyIrAccessAppendUse(
               bodyIR, table, BodyIrAccessSiteOp, opIndex,
               indexSlot, 2, BodyIrAccessFixedNone,
               BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        if bodyIR.localSlots[indexSlot].typeKind != coreir.LocalI32Tag &&
           bodyIR.localSlots[indexSlot].typeKind != coreir.LocalI64Tag:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex,
                             bodyIR.localSlots[indexSlot].typeKind)
            return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryIndirectRead)
    elif op.operands.len == 4 &&
         op.operands[0] == coreir.BodyLoadLocalFieldAddressTag:
        let rootSlot = op.operands[1]
        let byteOffset = op.operands[2]
        let byteWidth = op.operands[3]
        if op.target < 0 || op.target >= bodyIR.localSlots.len ||
           bodyIR.localSlots[op.target].typeKind != coreir.LocalPtrTag ||
           bodyIR.localSlots[op.target].placeKind !=
               coreir.BodyPlaceBorrowAddressTag ||
           bodyIR.localSlots[op.target].typeArenaTypeId < 0 ||
           op.valueDefSlot != op.target ||
           op.valueDefOwnership != coreir.OwnBorrowShared ||
           op.valueDefSemanticRow < 0 ||
           op.valueDefExprNodeIndex < 0 ||
           byteOffset < 0 || byteWidth <= 0 ||
           !bodyIrAccessAppendUse(
               bodyIR, table, BodyIrAccessSiteOp, opIndex,
               rootSlot, 1, BodyIrAccessFixedNone,
               BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryIndirectRead)
    elif op.operands.len == 2 &&
         op.operands[0] == coreir.BodyLoadLocalAddressTag:
        if !bodyIrAccessAppendAddress(bodyIR, table,
                                      BodyIrAccessSiteOp, opIndex,
                                      op.operands[1], 1,
                                      BodyIrAccessFixedNone,
                                      BodyIrAccessNoIndex,
                                      BodyIrAccessNoIndex):
            return false
    elif op.operands.len == 2 &&
         op.operands[0] == coreir.BodyLoadLocalCStringTag:
        let literalId = op.operands[1]
        if literalId < 0 || literalId >= bodyIR.cstringLiterals.len:
            bodyIrAccessFail(table, BodyIrAccessErrorLiteralRef,
                             BodyIrAccessSiteOp, opIndex, literalId)
            return false
    elif op.operands.len == 3 &&
         op.operands[0] == coreir.BodyLoadLocalStrIndexU8Tag:
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  op.operands[1], 1, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  op.operands[2], 2, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        let indexType = bodyIR.localSlots[op.operands[2]].typeKind
        if indexType != coreir.LocalI32Tag &&
           indexType != coreir.LocalI64Tag:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, indexType)
            return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryIndirectRead)
    elif op.operands.len == 3 &&
         (op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag ||
          op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag ||
          op.operands[0] == coreir.BodyLoadLocalPtrDerefU64Tag):
        var expectedWidth = 8
        if op.operands[0] == coreir.BodyLoadLocalPtrDerefU8Tag:
            expectedWidth = 1
        elif op.operands[0] == coreir.BodyLoadLocalPtrDerefI32Tag:
            expectedWidth = 4
        if op.operands[2] != expectedWidth:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, op.operands[2])
            return false
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  op.operands[1], 1, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryIndirectRead)
    else:
        bodyIrAccessFail(table, BodyIrAccessErrorArity,
                         BodyIrAccessSiteOp, opIndex, op.operands.len)
        return false
    return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                 op.target, BodyIrAccessFixedNone) >= 0

@borrows
fn bodyIrAccessDecodeIndexed(bodyIR: coreir.BodyIR,
                             table: var BodyIrAccessTable,
                             opIndex: int32,
                             op: coreir.BodyOp,
                             isStore: bool): bool =
    let count = op.operands.len
    let validCount = count == 2 || (isStore && count == 3) ||
                     count == 4 || count == 5
    if !validCount:
        bodyIrAccessFail(table, BodyIrAccessErrorArity,
                         BodyIrAccessSiteOp, opIndex, count)
        return false
    let baseSlot = op.operands[0]
    let valueSlot = op.operands[1]
    let indexedIndirect = count == 5 && op.operands[4] == 1
    if !bodyIrAccessAppendStoreBaseUse(
           bodyIR, table, opIndex, baseSlot,
           isStore && !indexedIndirect):
        return false
    if isStore:
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  valueSlot, 1, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
    elif op.target != valueSlot:
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, op.target)
        return false
    if !bodyIrAccessLocalValid(bodyIR, valueSlot):
        bodyIrAccessFail(table, BodyIrAccessErrorLocalRef,
                         BodyIrAccessSiteOp, opIndex, valueSlot)
        return false
    if isStore &&
       bodyIR.localSlots[valueSlot].managedStorageKind ==
           coreir.BodyManagedStorageManagedTag:
        bodyIrAccessFailPhase(table, 2407, BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp, opIndex, valueSlot)
        return false
    if count >= 4:
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  op.operands[2], 2, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        let indexedIndexType = bodyIR.localSlots[op.operands[2]].typeKind
        if indexedIndexType != coreir.LocalI32Tag &&
           indexedIndexType != coreir.LocalI64Tag:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, indexedIndexType)
            return false
        if op.operands[3] <= 0:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, op.operands[3])
            return false
        if count == 5 && op.operands[4] != 1:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, op.operands[4])
            return false
    elif count == 3 && op.operands[2] != coreir.BodyStoreLocalPtrDerefU8Tag:
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, op.operands[2])
        return false
    let baseType = bodyIR.localSlots[baseSlot].typeKind
    if ((count == 2 || count == 3) && baseType != coreir.LocalPtrTag) ||
       (count == 4 && baseType != coreir.LocalAggregateTag) ||
       (count == 5 && baseType != coreir.LocalAggregateTag &&
        baseType != coreir.LocalPtrTag):
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, baseType)
        return false
    var byteCount = bodyIR.localSlots[valueSlot].sizeBytes
    if count == 3:
        byteCount = 1
    elif count >= 4:
        byteCount = op.operands[3]
    let value = bodyIrAccessLocalSlotAt(
        bodyIR, valueSlot)
    let ptr24Store = isStore && byteCount == 24 &&
                       value.typeKind == coreir.LocalPtrTag
    if byteCount <= 0 || (value.sizeBytes < byteCount && !ptr24Store):
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, byteCount)
        return false
    if count == 4:
        let base = bodyIrAccessLocalSlotAt(
            bodyIR, baseSlot)
        if base.sizeBytes <= 0 || byteCount > base.sizeBytes:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, byteCount)
            return false
    var memoryEffect = BodyIrAccessMemoryIndirectRead
    if bodyIR.localSlots[baseSlot].placeKind ==
       coreir.BodyPlaceGlobalAddressTag:
        memoryEffect = BodyIrAccessMemoryGlobalRead
        if isStore && !indexedIndirect:
            memoryEffect = BodyIrAccessMemoryGlobalWrite
    elif BodyIrAccessBaseIsLocalMemory(bodyIR, baseSlot):
        memoryEffect = BodyIrAccessMemoryLocalRead
        if isStore && !indexedIndirect:
            memoryEffect = BodyIrAccessMemoryLocalWrite
    elif isStore && !indexedIndirect:
        memoryEffect = BodyIrAccessMemoryIndirectWrite
    bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                             memoryEffect)
    if indexedIndirect:
        var elementEffect = BodyIrAccessMemoryIndirectRead
        if isStore:
            elementEffect = BodyIrAccessMemoryIndirectWrite
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 elementEffect)
    if isStore:
        if op.target != baseSlot:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, op.target)
            return false
        if !indexedIndirect &&
           BodyIrAccessStoreDefinesBase(bodyIR, baseSlot):
            return bodyIrAccessAppendDef(bodyIR, table,
                                         BodyIrAccessSiteOp, opIndex,
                                         op.target,
                                         BodyIrAccessFixedNone) >= 0
        return true
    return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                 op.target, BodyIrAccessFixedNone) >= 0

@borrows
fn bodyIrAccessDecodeField(bodyIR: coreir.BodyIR,
                           table: var BodyIrAccessTable,
                           opIndex: int32,
                           op: coreir.BodyOp,
                           isStore: bool): bool =
    if op.operands.len != 4:
        bodyIrAccessFail(table, BodyIrAccessErrorArity,
                         BodyIrAccessSiteOp, opIndex, op.operands.len)
        return false
    let baseSlot = op.operands[0]
    let valueSlot = op.operands[1]
    if op.operands[2] < 0 || op.operands[3] <= 0:
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, op.operands[3])
        return false
    if !bodyIrAccessLocalValid(bodyIR, baseSlot) ||
       !bodyIrAccessLocalValid(bodyIR, valueSlot):
        bodyIrAccessFail(table, BodyIrAccessErrorLocalRef,
                         BodyIrAccessSiteOp, opIndex, baseSlot)
        return false
    let byteOffset = op.operands[2]
    let byteCount = op.operands[3]
    let base = bodyIrAccessLocalSlotAt(
        bodyIR, baseSlot)
    let value = bodyIrAccessLocalSlotAt(
        bodyIR, valueSlot)
    if isStore &&
       value.managedStorageKind ==
           coreir.BodyManagedStorageManagedTag:
        bodyIrAccessFailPhase(table, 2526, BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp, opIndex, valueSlot)
        return false
    if base.typeKind != coreir.LocalPtrTag &&
       base.typeKind != coreir.LocalAggregateTag &&
       base.typeKind != coreir.LocalStrTag:
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, base.typeKind)
        return false
    if value.sizeBytes < byteCount:
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, byteCount)
        return false
    if base.typeKind != coreir.LocalPtrTag && base.stackOffset >= 0 &&
       (base.sizeBytes <= 0 || byteCount > base.sizeBytes ||
        byteOffset > base.sizeBytes - byteCount):
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, byteOffset)
        return false
    if !bodyIrAccessAppendStoreBaseUse(
           bodyIR, table, opIndex, baseSlot, isStore):
        return false
    if isStore:
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  valueSlot, 1, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        if op.target != baseSlot:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, op.target)
            return false
    elif op.target != valueSlot:
        bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                         BodyIrAccessSiteOp, opIndex, op.target)
        return false
    var memoryEffect = BodyIrAccessMemoryIndirectRead
    if bodyIR.localSlots[baseSlot].placeKind ==
       coreir.BodyPlaceGlobalAddressTag:
        memoryEffect = BodyIrAccessMemoryGlobalRead
        if isStore:
            memoryEffect = BodyIrAccessMemoryGlobalWrite
    elif BodyIrAccessBaseIsLocalMemory(bodyIR, baseSlot):
        memoryEffect = BodyIrAccessMemoryLocalRead
        if isStore:
            memoryEffect = BodyIrAccessMemoryLocalWrite
    elif isStore:
        memoryEffect = BodyIrAccessMemoryIndirectWrite
    bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                             memoryEffect)
    if isStore && !BodyIrAccessStoreDefinesBase(bodyIR, baseSlot):
        return true
    return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                 op.target, BodyIrAccessFixedNone) >= 0

@borrows
fn bodyIrAccessDecodeOp(bodyIR: coreir.BodyIR,
                        table: var BodyIrAccessTable,
                        opIndex: int32): bool =
    if bodyIR.ops[opIndex].kind == coreir.BodyOpCallTag:
        if bodyIR.ops[opIndex].operands.len != 1:
            bodyIrAccessFail(table,
                             BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp,
                             opIndex,
                             bodyIR.ops[
                                 opIndex].operands.len)
            return false
        return bodyIrAccessDecodeCallOrdinal(
            bodyIR, table, opIndex,
            bodyIR.ops[opIndex].operands[0],
            bodyIR.ops[opIndex].target)
    let op = bodyIrAccessOpAt(bodyIR, opIndex)
    if op.kind == coreir.BodyOpInvalidTag:
        bodyIrAccessFail(table, BodyIrAccessErrorUnknownOp,
                         BodyIrAccessSiteOp, opIndex, op.kind)
        return false
    if op.kind == coreir.BodyOpLoadConstTag:
        if (op.operands.len != 2 && op.operands.len != 5) ||
           (op.operands[0] != coreir.LocalI32Tag &&
            op.operands[0] != coreir.LocalI64Tag &&
            op.operands[0] != coreir.LocalF64Tag &&
            op.operands[0] != coreir.LocalPtrTag):
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        if !bodyIrAccessLocalValid(bodyIR, op.target) ||
           bodyIR.localSlots[op.target].typeKind != op.operands[0]:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, op.target)
            return false
        return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                     op.target, BodyIrAccessFixedNone) >= 0
    if op.kind == coreir.BodyOpBinOpTag:
        if op.operands.len != 4 && op.operands.len != 5:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        for operandIndex in 2..<op.operands.len:
            if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                      op.operands[operandIndex], operandIndex,
                                      BodyIrAccessFixedNone, BodyIrAccessNoIndex,
                                      BodyIrAccessNoIndex, false):
                return false
        return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                     op.target, BodyIrAccessFixedNone) >= 0
    if op.kind == coreir.BodyOpCmpTag:
        if op.operands.len != 3:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        for operandIndex in 1..<3:
            if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                      op.operands[operandIndex], operandIndex,
                                      BodyIrAccessFixedNone, BodyIrAccessNoIndex,
                                      BodyIrAccessNoIndex, false):
                return false
        return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                     op.target, BodyIrAccessFixedNone) >= 0
    if op.kind == coreir.BodyOpBranchTag:
        if op.operands.len != 3 && op.operands.len != 4:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        let subKind = op.operands[0]
        var expected = 3
        if subKind == coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
            expected = 4
        if op.operands.len != expected ||
           (subKind < coreir.BodyBranchIfLocalNilReturnI32ConstTag ||
            subKind > coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag):
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, subKind)
            return false
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  op.operands[1], 1, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        if subKind == coreir.BodyBranchIfLocalLeZeroReturnCallNoargTag ||
           subKind == coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
            if subKind == coreir.BodyBranchIfLocalLeZeroCallArg0ReturnI32ConstTag:
                if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                          op.operands[2], 2,
                                          BodyIrAccessFixedCallArg, 0,
                                          coreir.BodyCallPassStackValueTag, false):
                    return false
            bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                     BodyIrAccessMemoryCallReadWrite)
            bodyIrAccessAppendCallClobber(table, BodyIrAccessSiteOp, opIndex,
                                          BodyIrAccessNoIndex)
        return true
    if op.kind == coreir.BodyOpReturnTag:
        if op.operands.len != 1 && op.operands.len != 2:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        if op.target >= 0:
            return bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                         op.target, BodyIrAccessNoIndex,
                                         BodyIrAccessFixedReturnValue, 0,
                                         BodyIrAccessNoIndex, false)
        if op.operands.len == 2:
            bodyIrAccessAppendFixed(table, BodyIrAccessSiteOp, opIndex, 1,
                                    BodyIrAccessFixedReturnValue, 0,
                                    BodyIrAccessNoIndex, op.operands[1], false)
        return true
    if op.kind == coreir.BodyOpLoadLocalTag:
        return bodyIrAccessDecodeLoadLocal(bodyIR, table, opIndex, op)
    if op.kind == coreir.BodyOpStoreLocalTag ||
       op.kind == coreir.BodyOpCopyLocalTag:
        return bodyIrAccessDecodeLocalCopy(bodyIR, table, opIndex, op)
    if op.kind == coreir.BodyOpResultProjectTag:
        if op.operands.len != 2 && op.operands.len != 4:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        let projectKind = op.operands[0]
        let scalarProject = projectKind == coreir.BodyResultProjectIsErrTag ||
                            projectKind == coreir.BodyResultProjectIsOkTag
        let aggregateProject = projectKind == coreir.BodyResultProjectErrorStrTag ||
                               projectKind == coreir.BodyResultProjectValueStrTag ||
                               projectKind == coreir.BodyResultProjectErrInfoTag
        if (scalarProject && op.operands.len != 2) ||
           (aggregateProject && op.operands.len != 4) ||
           (!scalarProject && !aggregateProject):
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, projectKind)
            return false
        if aggregateProject &&
           (op.operands[2] < 0 || op.operands[3] <= 0):
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, op.operands[3])
            return false
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  op.operands[1], 1, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryLocalRead)
        return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                     op.target, BodyIrAccessFixedNone) >= 0
    if op.kind == coreir.BodyOpResultPanicGuardTag:
        if op.operands.len != 2:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        if op.target != BodyIrAccessNoValue:
            bodyIrAccessFail(table, BodyIrAccessErrorCallShape,
                             BodyIrAccessSiteOp, opIndex, op.target)
            return false
        let conditionSlot = op.operands[0]
        if !bodyIrAccessLocalValid(bodyIR, conditionSlot):
            bodyIrAccessFail(table, BodyIrAccessErrorLocalRef,
                             BodyIrAccessSiteOp, opIndex, conditionSlot)
            return false
        if bodyIR.localSlots[conditionSlot].typeKind != coreir.LocalI32Tag:
            bodyIrAccessFail(table, BodyIrAccessErrorOperandShape,
                             BodyIrAccessSiteOp, opIndex, conditionSlot)
            return false
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  conditionSlot, 0, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        return bodyIrAccessDecodeCallOrdinal(bodyIR,
                                             table,
                                             opIndex,
                                             op.operands[1],
                                             BodyIrAccessNoValue)
    if op.kind == coreir.BodyOpStrEqLiteralTag:
        if op.operands.len != 2 || op.operands[1] < 0 ||
           op.operands[1] >= bodyIR.cstringLiterals.len:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  op.operands[0], 0, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryIndirectRead)
        return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                     op.target, BodyIrAccessFixedNone) >= 0
    if op.kind == coreir.BodyOpIndexedLoadTag:
        return bodyIrAccessDecodeIndexed(bodyIR, table, opIndex, op, false)
    if op.kind == coreir.BodyOpIndexedStoreTag:
        return bodyIrAccessDecodeIndexed(bodyIR, table, opIndex, op, true)
    if op.kind == coreir.BodyOpFieldLoadTag:
        return bodyIrAccessDecodeField(bodyIR, table, opIndex, op, false)
    if op.kind == coreir.BodyOpFieldStoreTag:
        return bodyIrAccessDecodeField(bodyIR, table, opIndex, op, true)
    if op.kind == coreir.BodyOpGlobalLoadTag:
        if (op.operands.len != 1 && op.operands.len != 2) ||
           (op.operands.len == 2 && op.operands[1] != 1):
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        if !bodyIrAccessAppendGlobalRef(bodyIR, table, opIndex,
                                        op.operands[0], 0):
            return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryGlobalRead)
        return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                     op.target, BodyIrAccessFixedNone) >= 0
    if op.kind == coreir.BodyOpGlobalStoreTag:
        if op.operands.len != 1:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        if !bodyIrAccessAppendGlobalRef(bodyIR, table, opIndex,
                                        op.operands[0], 0):
            return false
        let globalSlot = op.operands[0]
        if !bodyIrAccessLocalValid(bodyIR, op.target):
            bodyIrAccessFail(table, BodyIrAccessErrorLocalRef,
                             BodyIrAccessSiteOp, opIndex, op.target)
            return false
        if bodyIR.localSlots[globalSlot].managedStorageKind ==
               coreir.BodyManagedStorageManagedTag ||
           bodyIR.localSlots[op.target].managedStorageKind ==
               coreir.BodyManagedStorageManagedTag:
            bodyIrAccessFailPhase(table, 2805, BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp, opIndex, globalSlot)
            return false
        if bodyIR.localSlots[globalSlot].typeKind == coreir.LocalStrTag:
            # A raw global store is a bit-copy and cannot express the
            # RetainValue -> StoreOwned -> DropPlace ordering required by a
            # borrowed str, nor the consume edge required by an owned str.
            # Managed str globals must arrive as the canonical managed-store
            # CallOp; reject the old emitter path before object bytes exist.
            bodyIrAccessFailPhase(table, 2814, BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp, opIndex, globalSlot)
            return false
        if bodyIR.localSlots[globalSlot].typeKind ==
               coreir.LocalAggregateTag:
            if !bodyIrAccessLocalValid(bodyIR, op.target):
                bodyIrAccessFail(table, BodyIrAccessErrorLocalRef,
                                 BodyIrAccessSiteOp, opIndex, op.target)
                return false
            let globalStorage =
                bodyIrAccessLocalSlotAt(
                    bodyIR, globalSlot)
            let valueStorage =
                bodyIrAccessLocalSlotAt(
                    bodyIR, op.target)
            # Aggregate size/typeKind cannot distinguish a plain record from a
            # sequence header or an inline managed object.  Admit the raw
            # bit-copy only when both slots carry the same exact semantic
            # TypeId and the typed producer proved that TypeId unmanaged.
            if valueStorage.typeKind != coreir.LocalAggregateTag ||
               !coreir.BodyIRLocalSlotTypeArenaProofValid(globalStorage) ||
               !coreir.BodyIRLocalSlotTypeArenaProofValid(valueStorage) ||
               globalStorage.typeArenaTypeId != valueStorage.typeArenaTypeId ||
               globalStorage.managedStorageKind !=
                   coreir.BodyManagedStorageUnmanagedTag ||
               valueStorage.managedStorageKind !=
                   coreir.BodyManagedStorageUnmanagedTag:
                bodyIrAccessFailPhase(table, 2841, BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteOp, opIndex, globalSlot)
                return false
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                  op.target, BodyIrAccessNoIndex,
                                  BodyIrAccessFixedNone, BodyIrAccessNoIndex,
                                  BodyIrAccessNoIndex, false):
            return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryGlobalWrite)
        return true
    if op.kind == coreir.BodyOpStrEqTag:
        if op.operands.len != 2:
            bodyIrAccessFail(table, BodyIrAccessErrorArity,
                             BodyIrAccessSiteOp, opIndex, op.operands.len)
            return false
        for operandIndex in 0..<2:
            if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                      op.operands[operandIndex], operandIndex,
                                      BodyIrAccessFixedNone, BodyIrAccessNoIndex,
                                      BodyIrAccessNoIndex, false):
                return false
        bodyIrAccessAppendMemory(table, BodyIrAccessSiteOp, opIndex,
                                 BodyIrAccessMemoryIndirectRead)
        return bodyIrAccessAppendDef(bodyIR, table, BodyIrAccessSiteOp, opIndex,
                                     op.target, BodyIrAccessFixedNone) >= 0
    bodyIrAccessFail(table, BodyIrAccessErrorUnknownOp,
                     BodyIrAccessSiteOp, opIndex, op.kind)
    return false

@borrows
fn bodyIrAccessDecodeTerm(bodyIR: coreir.BodyIR,
                          table: var BodyIrAccessTable,
                          termIndex: int32): bool =
    let term = bodyIrAccessTermAt(bodyIR, termIndex)
    if term.kind == coreir.BodyTermReturnTag:
        if term.operands.len > 2:
            bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                             BodyIrAccessSiteTerm, termIndex, term.operands.len)
            return false
        if term.resultSlot >= 0:
            if term.operands.len > 1:
                bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                                 BodyIrAccessSiteTerm, termIndex,
                                 term.operands.len)
                return false
            return bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteTerm,
                                         termIndex, term.resultSlot,
                                         BodyIrAccessNoIndex,
                                         BodyIrAccessFixedReturnValue, 0,
                                         BodyIrAccessNoIndex, false)
        if term.operands.len == 2:
            bodyIrAccessAppendFixed(table, BodyIrAccessSiteTerm, termIndex, 1,
                                    BodyIrAccessFixedReturnValue, 0,
                                    BodyIrAccessNoIndex, term.operands[1], false)
        return true
    if term.kind == coreir.BodyTermBrTag:
        if term.operands.len != 0:
            bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                             BodyIrAccessSiteTerm, termIndex, term.operands.len)
            return false
        return true
    if term.kind == coreir.BodyTermCbrTag:
        if term.conditionKind < coreir.BodyCondLocalNonZeroTag ||
           term.conditionKind > coreir.BodyCondF64GeTag:
            bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                             BodyIrAccessSiteTerm, termIndex, term.conditionKind)
            return false
        var lhsSlot = term.lhsSlot
        if lhsSlot < 0:
            lhsSlot = term.resultSlot
        if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteTerm, termIndex,
                                  lhsSlot, 0, BodyIrAccessFixedNone,
                                  BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
            return false
        let localZeroTest = term.conditionKind == coreir.BodyCondLocalNonZeroTag ||
                            term.conditionKind == coreir.BodyCondLocalZeroTag
        if localZeroTest:
            if term.rhsSlot >= 0 || term.operands.len != 0:
                bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                                 BodyIrAccessSiteTerm, termIndex,
                                 term.rhsSlot)
                return false
        elif term.rhsSlot >= 0:
            if term.operands.len != 0:
                bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                                 BodyIrAccessSiteTerm, termIndex,
                                 term.operands.len)
                return false
            if !bodyIrAccessAppendUse(bodyIR, table, BodyIrAccessSiteTerm, termIndex,
                                      term.rhsSlot, 1, BodyIrAccessFixedNone,
                                      BodyIrAccessNoIndex, BodyIrAccessNoIndex, false):
                return false
        elif term.conditionKind >= coreir.BodyCondF64EqTag:
            bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                             BodyIrAccessSiteTerm, termIndex,
                             term.rhsSlot)
            return false
        elif term.operands.len > 1:
            bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                             BodyIrAccessSiteTerm, termIndex,
                             term.operands.len)
            return false
        return true
    bodyIrAccessFail(table, BodyIrAccessErrorTermShape,
                     BodyIrAccessSiteTerm, termIndex, term.kind)
    return false

fn BodyIrAccessOwnershipInvariantErrorCode(): int32 =
    return BodyIrAccessErrorOwnership

fn bodyIrAccessManagedMoveStoreKindExact(kind: int32): bool =
    return kind == coreir.ManagedStoreStrMoveTag ||
           kind == coreir.ManagedStoreSeqMoveTag ||
           kind == coreir.ManagedStoreAggregateMoveTag

fn bodyIrAccessManagedRetainStoreKindExact(kind: int32): bool =
    return kind == coreir.ManagedStoreStrRetainTag ||
           kind == coreir.ManagedStoreSeqRetainTag ||
           kind == coreir.ManagedStoreAggregateRetainTag

fn bodyIrAccessManagedSnapshotKindExact(kind: int32): bool =
    return kind == coreir.ManagedStoreSnapshotRetainTag ||
           kind == coreir.ManagedStoreSnapshotCloneTag

@borrows
fn bodyIrAccessAppendOnlyManagedMoveEventExact(
        bodyIR: coreir.BodyIR,
        opIndex: int32,
        op: coreir.BodyOp): bool =
    if opIndex < 0 || opIndex >= bodyIR.ops.len ||
       op.kind != coreir.BodyOpCallTag ||
       op.operands.len != 1 ||
       op.operands[0] < 0 ||
       op.operands[0] >= bodyIR.callSequence.len ||
       op.consumeActionRow != opIndex ||
       !bodyIrAccessDefinitionPairShapeValid(
           bodyIR, op.sourceDefinitionDomain,
           op.sourceDefinitionRow):
        return false
    let call = bodyIR.callSequence[op.operands[0]]
    return bodyIrAccessManagedMoveStoreKindExact(
               call.managedStoreKind) &&
           call.consumeActionRow == opIndex &&
           bodyIrAccessDefinitionPairEqual(
               call.sourceDefinitionDomain,
               call.sourceDefinitionRow,
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow) &&
           bodyIrAccessCallUsesSourceSlotExact(
               call,
               bodyIrAccessDefinitionSlot(
                   bodyIR,
                   op.sourceDefinitionDomain,
                   op.sourceDefinitionRow))

@borrows
fn bodyIrAccessIndexedAddressIsNonConsumingExact(
        bodyIR: coreir.BodyIR,
        op: coreir.BodyOp): bool =
    let indexed = op.operands.len == 5 &&
                  op.operands[0] ==
                      coreir.BodyLoadLocalIndexedAddressTag
    let field = op.operands.len == 4 &&
                op.operands[0] ==
                    coreir.BodyLoadLocalFieldAddressTag
    return op.kind == coreir.BodyOpLoadLocalTag &&
           (indexed || field) &&
           op.valueDefOwnership == coreir.OwnBorrowShared &&
           bodyIrAccessDefinitionPairShapeValid(
               bodyIR,
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow) &&
           bodyIrAccessDefinitionPairEqual(
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow,
               op.valueDefBorrowOwnerDefinitionDomain,
               op.valueDefBorrowOwnerDefinitionRow) &&
           op.operands[1] ==
               bodyIrAccessDefinitionSlot(
                   bodyIR,
                   op.sourceDefinitionDomain,
                   op.sourceDefinitionRow) &&
           op.valueDefBorrowOwnerSemanticRow ==
               bodyIrAccessDefinitionSemanticRow(
                   bodyIR,
                   op.sourceDefinitionDomain,
                   op.sourceDefinitionRow)

fn bodyIrAccessDefinitionIndexBucket(originKind: int32,
                                      originId: int32,
                                      slot: int32,
                                      bucketCount: int32): int32 =
    let mask = bucketCount - 1
    var out = originId & mask
    out = (out + (slot & mask)) & mask
    out = (out + (originKind & mask)) & mask
    return out

fn bodyIrAccessConsumeIndexBucket(actionRow: int32,
                                   bucketCount: int32): int32 =
    return actionRow & (bucketCount - 1)

@borrows
fn bodyIrAccessManagedMoveStoreSourceSlot(
        bodyIR: coreir.BodyIR,
        op: coreir.BodyOp): int32 =
    if op.kind != coreir.BodyOpCallTag || op.operands.len != 1:
        return -1
    let callOrdinal = op.operands[0]
    if callOrdinal < 0 || callOrdinal >= bodyIR.callSequence.len:
        return -1
    let call = bodyIrAccessCallAt(
        bodyIR, callOrdinal)
    if !bodyIrAccessManagedMoveStoreKindExact(call.managedStoreKind) ||
       call.argSlots.len != 2:
        return -1
    var sourceSlot = call.argSlots[1]
    if coreir.CallArgSlotIsAddress(sourceSlot):
        sourceSlot = coreir.CallArgSlotAddressId(sourceSlot)
    if !bodyIrAccessLocalValid(bodyIR, sourceSlot):
        return -1
    return sourceSlot

@borrows
fn bodyIrAccessBuildDeferReplayIndex(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        index: var BodyIrAccessDeferReplayIndex): bool =
    # Core owns shape, semantic equivalence and root verification. Access only
    # projects that admitted relation into dense op-domain indices.
    let intentEmpty =
        coreir.BodyIRCleanupIntentSidecarIsCanonicalEmpty(
            bodyIR.cleanupIntent)
    let scheduleEmpty =
        coreir.BodyIRCleanupScheduleSidecarIsCanonicalEmpty(
            bodyIR.cleanupSchedule)
    let replayEmpty =
        coreir.BodyIRDeferReplaySidecarIsCanonicalEmpty(
            bodyIR.deferReplay)
    if !coreir.BodyIRControlFlowShapeValid(bodyIR) ||
       !coreir.BodyIRCleanupIntentSidecarShapeValid(bodyIR) ||
       !coreir.BodyIRCleanupScheduleSidecarShapeValid(bodyIR) ||
       !coreir.BodyIRDeferReplaySidecarShapeValid(bodyIR) ||
       (intentEmpty && (!scheduleEmpty || !replayEmpty)) ||
       (!intentEmpty && scheduleEmpty):
        bodyIrAccessFailPhase(
            table, 3087,
            BodyIrAccessErrorOwnership,
            BodyIrAccessSiteEntry,
            BodyIrAccessNoIndex,
            bodyIR.deferReplay.templateOpMapStarts.len)
        return false
    for _ in 0..<bodyIR.ops.len:
        add(index.replayRowByOp, BodyIrAccessNoIndex)
        add(index.templateRowByOp, BodyIrAccessNoIndex)
    if intentEmpty:
        return true
    var mapRow: int32
    for unitRow in 0..<bodyIR.cleanupIntent.unitKinds.len:
        if bodyIR.cleanupIntent.unitKinds[unitRow] !=
               coreir.BodyCleanupUnitDeferTag:
            continue
        if replayEmpty ||
           mapRow >= bodyIR.deferReplay.templateOpMapStarts.len:
            bodyIrAccessFailPhase(
                table, 3106,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteEntry,
                unitRow,
                mapRow)
            return false
        let mapStart =
            bodyIR.deferReplay.templateOpMapStarts[mapRow]
        let mapCount =
            bodyIR.deferReplay.templateOpMapCounts[mapRow]
        let replayOpStart =
            bodyIR.cleanupSchedule.opStarts[unitRow]
        let replayOpCount =
            bodyIR.cleanupSchedule.opCounts[unitRow]
        # Bounds are checked here only for safe dense-index construction; the
        # canonical ranges and template equivalence were already proved by
        # the core validators above.
        if mapStart < 0 || mapCount < 0 ||
           mapStart >
               bodyIR.deferReplay.templateOpRows.len - mapCount ||
           replayOpStart < 0 || replayOpCount < 0 ||
           replayOpStart > bodyIR.ops.len - replayOpCount ||
           mapCount > replayOpCount:
            bodyIrAccessFailPhase(
                table, 3130,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteEntry,
                unitRow,
                mapStart)
            return false
        for offset in 0..<mapCount:
            let replayOpRow = replayOpStart + offset
            let templateOpRow =
                bodyIR.deferReplay.templateOpRows[mapStart + offset]
            if templateOpRow < 0 ||
               templateOpRow >= bodyIR.ops.len ||
               replayOpRow == templateOpRow ||
               index.replayRowByOp[replayOpRow] !=
                   BodyIrAccessNoIndex ||
               index.templateRowByOp[replayOpRow] !=
                   BodyIrAccessNoIndex ||
               index.replayRowByOp[templateOpRow] !=
                   BodyIrAccessNoIndex ||
               (index.templateRowByOp[templateOpRow] !=
                    BodyIrAccessNoIndex &&
                index.templateRowByOp[templateOpRow] !=
                    templateOpRow):
                bodyIrAccessFailPhase(
                    table, 3154,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    replayOpRow,
                    templateOpRow)
                return false
            index.replayRowByOp[replayOpRow] = mapRow
            index.templateRowByOp[replayOpRow] = templateOpRow
            index.templateRowByOp[templateOpRow] = templateOpRow
        mapRow = mapRow + 1
    if mapRow != bodyIR.deferReplay.templateOpMapStarts.len:
        bodyIrAccessFailPhase(
            table, 3166,
            BodyIrAccessErrorOwnership,
            BodyIrAccessSiteEntry,
            BodyIrAccessNoIndex,
            mapRow)
        return false
    return true

fn bodyIrAccessRegisterManagedDefinition(
        index: var BodyIrAccessManagedDefinitionIndex,
        domain: int32,
        row: int32,
        slot: int32,
        ownership: int32): int32 =
    var existing = BodyIrAccessNoIndex
    if domain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        if row < 0 ||
           row >= index.entryDefinitionOrdinals.len:
            return BodyIrAccessNoIndex
        existing = index.entryDefinitionOrdinals[row]
    elif domain ==
             coreir.BodyDefinitionDomainBodyOpTag:
        if row < 0 ||
           row >= index.bodyOpDefinitionOrdinals.len:
            return BodyIrAccessNoIndex
        existing = index.bodyOpDefinitionOrdinals[row]
    elif domain ==
             coreir.BodyDefinitionDomainManualConsumePostCallTag:
        if row < 0 ||
           row >= index.manualPostDefinitionOrdinals.len:
            return BodyIrAccessNoIndex
        existing = index.manualPostDefinitionOrdinals[row]
    else:
        return BodyIrAccessNoIndex
    if existing != BodyIrAccessNoIndex:
        return BodyIrAccessNoIndex
    let ordinal = index.definitionDomains.len
    add(index.definitionDomains, domain)
    add(index.definitionRows, row)
    add(index.definitionSlotsByOrdinal, slot)
    add(index.definitionOwnershipKindsByOrdinal,
        ownership)
    add(index.borrowOwnerDefinitionOrdinals, -1)
    add(index.returnConsumeOpByDefinition, -1)
    add(index.returnConsumeTermCountByDefinition, 0)
    add(index.lastReturnConsumeTermByDefinition, -1)
    add(index.managedMoveStoreOpByDefinition, -1)
    add(index.explicitSourceOpCountByDefinition, 0)
    add(index.lastExplicitSourceOpByDefinition, -1)
    if domain ==
           coreir.BodyDefinitionDomainEntrySlotTag:
        index.entryDefinitionOrdinals[row] = ordinal
    elif domain ==
             coreir.BodyDefinitionDomainBodyOpTag:
        index.bodyOpDefinitionOrdinals[row] = ordinal
    else:
        index.manualPostDefinitionOrdinals[row] = ordinal
    return ordinal

@borrows
fn bodyIrAccessBuildManagedDefinitionIndex(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        index: var BodyIrAccessManagedDefinitionIndex): bool =
    index.bucketCount = 1
    if bodyIR.localSlots.len >
           2147483647 - bodyIR.ops.len ||
       bodyIR.localSlots.len + bodyIR.ops.len >
           2147483647 -
               bodyIR.manualConsume.callOrdinals.len:
        bodyIrAccessFailPhase(
            table, 3238,
            BodyIrAccessErrorOwnership,
            BodyIrAccessSiteEntry,
            BodyIrAccessNoIndex,
            bodyIR.ops.len)
        return false
    let definitionCapacity =
        bodyIR.localSlots.len +
        bodyIR.ops.len +
        bodyIR.manualConsume.callOrdinals.len
    while index.bucketCount <= definitionCapacity:
        if index.bucketCount > 1073741823:
            bodyIrAccessFailPhase(table, 3251,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             -1,
                             bodyIR.ops.len)
            return false
        index.bucketCount = index.bucketCount * 2
    for bucketIndex in 0..<index.bucketCount:
        add(index.definitionOriginKinds, -1)
        add(index.definitionOriginIds, -1)
        add(index.definitionSlots, -1)
        add(index.definitionOwnershipKinds,
            int32(coreir.OwnInvalid))
        add(index.definitionSemanticRows, -1)
        add(index.definitionTemplateRows, -1)
        add(index.definitionLastReplayRows, -1)
        add(index.consumeActionRows, -1)
        add(index.retainActionRows, -1)
        add(index.retainSourceDefinitionOrdinals, -1)
        add(index.retainCallOps, -1)
        add(index.retainDefinitionUseCounts, 0)
    for opIndex in 0..<bodyIR.ops.len:
        add(index.bodyOpDefinitionOrdinals, -1)
        add(index.hasMatchingDefinitionFactByOp, false)
        add(index.retainedDerivationByOp, false)
    for slotIndex in 0..<bodyIR.localSlots.len:
        add(index.entryDefinitionOrdinals, -1)
        add(index.managedDefinitionCountBySlot, 0)
    for _ in 0..<bodyIR.manualConsume.callOrdinals.len:
        add(index.manualPostDefinitionOrdinals, -1)
    for slotIndex in 0..<bodyIR.localSlots.len:
        # [wall82] 入口托管定义注册两形态：(a) 既有托管形态（mg==Managed ∧
        # 入口所有权 ∉ {Invalid, Plain}）；(b) [w61/w77] canonical
        # borrowed-view 参数形态 —— `var T`（T 托管）参数的 exact 类型是
        # 非持有 BorrowedView，trait 派生刻意 managed=false，lowering 冻结
        # 侧（lowering_plan canonicalBorrowedViewParameter 臂）据此把该参
        # 数槽建成 mg==Unmanaged，同时入口所有权按可变 stamp BorrowUnique
        # / 不可变 BorrowShared，semanticRow=参数权威定义行（八列指纹联
        # 立已在冻结臂证明）。该族是借视权威槽，不是第二所有权：Unmanaged
        # 是 BorrowedView 的精确存储真相，注册谓词据 seal 权威列
        # entryDefinitionOwnershipKinds 而非 mg 识别它，借主定义对
        # (EntrySlot, slot) 才能在 ingress 借主验证内解析。Borrow* 入口
        # 所有权仅可能来自这两个生产臂（冻结函数对其余形状 panic），无
        # 第三来源。
        let entrySlotOwnership =
            bodyIR.entryDefinitionOwnershipKinds[slotIndex]
        let entryBorrowedViewParameter =
            (entrySlotOwnership == int32(coreir.OwnBorrowShared) ||
             entrySlotOwnership == int32(coreir.OwnBorrowUnique)) &&
            bodyIR.localSlots[slotIndex].managedStorageKind ==
                coreir.BodyManagedStorageUnmanagedTag
        if bodyIR.localSlots[slotIndex].stackOffset < 0 &&
           (bodyIR.localSlots[slotIndex].managedStorageKind ==
                coreir.BodyManagedStorageManagedTag ||
            entryBorrowedViewParameter) &&
           entrySlotOwnership != int32(coreir.OwnInvalid) &&
           entrySlotOwnership != int32(coreir.OwnPlain):
            if bodyIrAccessRegisterManagedDefinition(
                   index,
                   coreir.BodyDefinitionDomainEntrySlotTag,
                   slotIndex,
                   slotIndex,
                   entrySlotOwnership) < 0:
                bodyIrAccessFailPhase(
                    table, 3314,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteEntry,
                    slotIndex,
                    slotIndex)
                return false
            index.managedDefinitionCountBySlot[slotIndex] =
                index.managedDefinitionCountBySlot[slotIndex] + 1
    for defOpIndex in 0..<bodyIR.ops.len:
        let defOp = bodyIrAccessOpAt(
            bodyIR, defOpIndex)
        if defOp.valueDefOwnership != coreir.OwnInvalid &&
           bodyIrAccessLocalValid(bodyIR, defOp.valueDefSlot):
            let slot = defOp.valueDefSlot
            let nextCount =
                index.managedDefinitionCountBySlot[slot] + 1
            index.managedDefinitionCountBySlot[slot] = nextCount
            if bodyIrAccessRegisterManagedDefinition(
                   index,
                   coreir.BodyDefinitionDomainBodyOpTag,
                   defOpIndex,
                   slot,
                   int32(defOp.valueDefOwnership)) < 0:
                bodyIrAccessFailPhase(
                    table, 3338,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    defOpIndex,
                    defOpIndex)
                return false
    for row in 0..<bodyIR.manualConsume.callOrdinals.len:
        let slot =
            bodyIR.manualConsume.targetOwnerSlotIds[row]
        if !bodyIrAccessLocalValid(bodyIR, slot) ||
           bodyIrAccessRegisterManagedDefinition(
               index,
               coreir.BodyDefinitionDomainManualConsumePostCallTag,
               row,
               slot,
               int32(coreir.OwnMove)) < 0:
            bodyIrAccessFailPhase(
                table, 3355,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                bodyIrAccessManualPostCallOpIndex(
                    bodyIR, row),
                row)
            return false
        index.managedDefinitionCountBySlot[slot] =
            index.managedDefinitionCountBySlot[slot] + 1
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIrAccessOpAt(bodyIR, opIndex)
        if op.kind != coreir.BodyOpCallTag ||
           op.operands.len != 1:
            continue
        let callOrdinal = op.operands[0]
        if callOrdinal < 0 ||
           callOrdinal >= bodyIR.callSequence.len:
            continue
        let call = bodyIrAccessCallAt(
            bodyIR, callOrdinal)
        if call.managedStoreKind !=
               coreir.ManagedStoreCleanupRetainTag:
            continue
        let sourceDefinitionOrdinal =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                call.sourceDefinitionDomain,
                call.sourceDefinitionRow)
        if sourceDefinitionOrdinal < 0 ||
           !bodyIrAccessDefinitionPairShapeValid(
               bodyIR,
               call.sourceDefinitionDomain,
               call.sourceDefinitionRow):
            bodyIrAccessFailPhase(
                table, 3389,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                opIndex,
                call.sourceDefinitionRow)
            return false
        var retainProbe =
            bodyIrAccessConsumeIndexBucket(
                call.consumeActionRow,
                index.bucketCount)
        var retainScanned: int32
        var retainIndexed: bool
        while retainScanned < index.bucketCount:
            if index.retainActionRows[retainProbe] == -1:
                index.retainActionRows[retainProbe] =
                    call.consumeActionRow
                index.retainSourceDefinitionOrdinals[retainProbe] =
                    sourceDefinitionOrdinal
                index.retainCallOps[retainProbe] = opIndex
                retainIndexed = true
                break
            if index.retainActionRows[retainProbe] ==
                   call.consumeActionRow:
                bodyIrAccessFailPhase(table, 3413,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteOp,
                                 opIndex,
                                 call.consumeActionRow)
                return false
            retainProbe = retainProbe + 1
            if retainProbe >= index.bucketCount:
                retainProbe = 0
            retainScanned = retainScanned + 1
        if !retainIndexed:
            bodyIrAccessFailPhase(table, 3424,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             call.consumeActionRow)
            return false
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIrAccessOpAt(bodyIR, opIndex)
        if op.valueDefOwnership != coreir.OwnMove ||
           op.valueDefOriginKind !=
               coreir.BodyDefinitionOriginCanonicalCleanupActionTag ||
           !bodyIrAccessDefinitionPairShapeValid(
               bodyIR,
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow) ||
           op.kind != coreir.BodyOpCopyLocalTag ||
           op.operands.len != 1 ||
           op.valueDefExprNodeIndex < 0:
            continue
        var retainProbe =
            bodyIrAccessConsumeIndexBucket(
                op.valueDefOriginId,
                index.bucketCount)
        var retainScanned: int32
        let sourceDefinitionOrdinal =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                op.sourceDefinitionDomain,
                op.sourceDefinitionRow)
        while retainScanned < index.bucketCount:
            let actionRow = index.retainActionRows[retainProbe]
            if actionRow == -1:
                break
            if actionRow == op.valueDefOriginId:
                let retainSourceDefinitionOrdinal =
                    index.retainSourceDefinitionOrdinals[
                        retainProbe]
                var exactRetainSource =
                    retainSourceDefinitionOrdinal ==
                        sourceDefinitionOrdinal
                if !exactRetainSource &&
                   retainSourceDefinitionOrdinal >= 0 &&
                   sourceDefinitionOrdinal >= 0 &&
                   op.sourceDefinitionDomain ==
                       coreir.BodyDefinitionDomainBodyOpTag &&
                   op.valueDefOriginId < 2147483647:
                    let originalDefinitionDomain =
                        index.definitionDomains[
                            retainSourceDefinitionOrdinal]
                    let originalDefinitionRow =
                        index.definitionRows[
                            retainSourceDefinitionOrdinal]
                    if originalDefinitionDomain ==
                           coreir.BodyDefinitionDomainBodyOpTag &&
                       originalDefinitionRow >= 0 &&
                       originalDefinitionRow < bodyIR.ops.len:
                        let relocatedDefinition =
                            bodyIR.ops[op.sourceDefinitionRow]
                        let originalDefinition =
                            bodyIR.ops[originalDefinitionRow]
                        exactRetainSource =
                            relocatedDefinition.kind ==
                                coreir.BodyOpCopyLocalTag &&
                            relocatedDefinition.operands.len == 1 &&
                            relocatedDefinition.target ==
                                relocatedDefinition.valueDefSlot &&
                            relocatedDefinition.valueDefSlot ==
                                op.operands[0] &&
                            relocatedDefinition.valueDefSlot !=
                                originalDefinition.valueDefSlot &&
                            relocatedDefinition.valueDefOwnership ==
                                coreir.OwnMove &&
                            relocatedDefinition.valueDefExprNodeIndex == -1 &&
                            relocatedDefinition.valueDefSemanticRow ==
                                originalDefinition.valueDefSemanticRow &&
                            relocatedDefinition.valueDefOriginKind ==
                                coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
                            relocatedDefinition.valueDefOriginId ==
                                op.valueDefOriginId + 1 &&
                            relocatedDefinition.sourceDefinitionDomain ==
                                originalDefinitionDomain &&
                            relocatedDefinition.sourceDefinitionRow ==
                                originalDefinitionRow &&
                            relocatedDefinition.operands[0] ==
                                originalDefinition.valueDefSlot &&
                            originalDefinition.valueDefConsumeOpIndexPlusOne ==
                                op.sourceDefinitionRow + 1 &&
                            originalDefinition.consumeActionRow ==
                                relocatedDefinition.valueDefOriginId &&
                            op.target ==
                                originalDefinition.valueDefSlot
                if sourceDefinitionOrdinal < 0 ||
                   !exactRetainSource ||
                   index.retainDefinitionUseCounts[retainProbe] != 0:
                    bodyIrAccessFailPhase(table, 3518,
                                     BodyIrAccessErrorOwnership,
                                     BodyIrAccessSiteOp,
                                     opIndex,
                                     op.valueDefOriginId)
                    return false
                index.retainDefinitionUseCounts[retainProbe] = 1
                index.retainedDerivationByOp[opIndex] = true
                break
            retainProbe = retainProbe + 1
            if retainProbe >= index.bucketCount:
                retainProbe = 0
            retainScanned = retainScanned + 1
    for retainProbe in 0..<index.bucketCount:
        if index.retainActionRows[retainProbe] >= 0 &&
           index.retainDefinitionUseCounts[retainProbe] != 1:
            bodyIrAccessFailPhase(
                table, 3534,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                index.retainCallOps[retainProbe],
                index.retainActionRows[retainProbe])
            return false
    # Only explicit int32 definition edges are indexed.  Physical op order is
    # not semantic reaching-definition authority in a CFG with branches/loops.
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIrAccessOpAt(bodyIR, opIndex)
        let factStart = table.opFactStarts[opIndex]
        let factCount = table.opFactCounts[opIndex]
        for factOffset in 0..<factCount:
            let fact = table.facts[factStart + factOffset]
            if fact.kind == BodyIrAccessFactDef &&
               fact.slotIndex == op.valueDefSlot:
                index.hasMatchingDefinitionFactByOp[opIndex] = true
        if bodyIrAccessDefinitionPairIsInvalid(
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow):
            continue
        let sourceDefinition =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                op.sourceDefinitionDomain,
                op.sourceDefinitionRow)
        if sourceDefinition < 0 ||
           !bodyIrAccessDefinitionPairShapeValid(
               bodyIR,
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow):
            bodyIrAccessFailPhase(
                table, 3566,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                opIndex,
                op.sourceDefinitionRow)
            return false
        var sourceIsNonConsumingRetain =
            index.retainedDerivationByOp[opIndex] ||
            bodyIrAccessIndexedAddressIsNonConsumingExact(
                bodyIR, op)
        if op.kind == coreir.BodyOpCallTag &&
           op.operands.len == 1 &&
           op.operands[0] >= 0 &&
           op.operands[0] < bodyIR.callSequence.len:
            sourceIsNonConsumingRetain =
                sourceIsNonConsumingRetain ||
                bodyIrAccessManagedRetainStoreKindExact(
                    bodyIR.callSequence[
                        op.operands[0]].managedStoreKind) ||
                bodyIrAccessManagedSnapshotKindExact(
                    bodyIR.callSequence[
                        op.operands[0]].managedStoreKind)
        if sourceIsNonConsumingRetain:
            continue
        let appendOnlyManagedMove =
            bodyIrAccessAppendOnlyManagedMoveEventExact(
                bodyIR, opIndex, op)
        let managedMoveSourceSlot =
            bodyIrAccessManagedMoveStoreSourceSlot(bodyIR, op)
        if managedMoveSourceSlot >= 0 &&
           !appendOnlyManagedMove:
            bodyIrAccessFailPhase(
                table, 3598,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                opIndex,
                managedMoveSourceSlot)
            return false
        if op.sourceDefinitionDomain ==
               coreir.BodyDefinitionDomainBodyOpTag &&
           bodyIR.ops[op.sourceDefinitionRow].valueDefConsumeOpIndexPlusOne !=
               opIndex + 1 &&
           !appendOnlyManagedMove:
            continue
        index.explicitSourceOpCountByDefinition[sourceDefinition] =
            index.explicitSourceOpCountByDefinition[sourceDefinition] + 1
        index.lastExplicitSourceOpByDefinition[sourceDefinition] =
            opIndex
        if op.kind == coreir.BodyOpReturnTag:
            index.returnConsumeOpByDefinition[sourceDefinition] =
                opIndex
        if managedMoveSourceSlot >= 0:
            if index.managedMoveStoreOpByDefinition[
                   sourceDefinition] >= 0:
                bodyIrAccessFailPhase(
                    table, 3621,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    sourceDefinition)
                return false
            index.managedMoveStoreOpByDefinition[sourceDefinition] =
                opIndex
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIrAccessTermAt(
            bodyIR, termIndex)
        let sourceDefinition =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                term.sourceDefinitionDomain,
                term.sourceDefinitionRow)
        if term.kind != coreir.BodyTermReturnTag ||
           sourceDefinition < 0:
            continue
        index.returnConsumeTermCountByDefinition[sourceDefinition] =
            index.returnConsumeTermCountByDefinition[sourceDefinition] + 1
        index.lastReturnConsumeTermByDefinition[sourceDefinition] =
            termIndex
    return true

@borrows
fn bodyIrAccessIndexManagedDefinition(
        index: var BodyIrAccessManagedDefinitionIndex,
        replayIndex: var BodyIrAccessDeferReplayIndex,
        defOp: coreir.BodyOp,
        defOpIndex: int32,
        table: var BodyIrAccessTable): bool =
    if defOpIndex < 0 ||
       defOpIndex >= replayIndex.replayRowByOp.len ||
       replayIndex.templateRowByOp.len !=
           replayIndex.replayRowByOp.len:
        bodyIrAccessFailPhase(table, 3658,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         defOpIndex,
                         defOpIndex)
        return false
    let replayRow = replayIndex.replayRowByOp[defOpIndex]
    let mappedTemplateRow =
        replayIndex.templateRowByOp[defOpIndex]
    var definitionProbe =
        bodyIrAccessDefinitionIndexBucket(
            defOp.valueDefOriginKind,
            defOp.valueDefOriginId,
            defOp.valueDefSlot,
            index.bucketCount)
    var definitionScanned: int32
    var definitionIndexed: bool
    while definitionScanned < index.bucketCount:
        if index.definitionOriginKinds[definitionProbe] == -1:
            index.definitionOriginKinds[definitionProbe] =
                defOp.valueDefOriginKind
            index.definitionOriginIds[definitionProbe] =
                defOp.valueDefOriginId
            index.definitionSlots[definitionProbe] =
                defOp.valueDefSlot
            index.definitionOwnershipKinds[definitionProbe] =
                int32(defOp.valueDefOwnership)
            index.definitionSemanticRows[definitionProbe] =
                defOp.valueDefSemanticRow
            # A later duplicate can be authorized only when the first tuple
            # is the exact template row already referenced by templateOpRows.
            if defOp.valueDefOwnership == coreir.OwnMove &&
               replayRow == BodyIrAccessNoIndex &&
               mappedTemplateRow == defOpIndex:
                index.definitionTemplateRows[definitionProbe] =
                    defOpIndex
            definitionIndexed = true
            break
        if index.definitionOriginKinds[definitionProbe] ==
               defOp.valueDefOriginKind &&
           index.definitionOriginIds[definitionProbe] ==
               defOp.valueDefOriginId &&
           index.definitionSlots[definitionProbe] ==
               defOp.valueDefSlot:
            if defOp.valueDefOwnership == coreir.OwnMove ||
               index.definitionOwnershipKinds[definitionProbe] ==
                   int32(coreir.OwnMove):
                let templateRow =
                    index.definitionTemplateRows[definitionProbe]
                if defOp.valueDefOwnership != coreir.OwnMove ||
                   index.definitionOwnershipKinds[definitionProbe] !=
                       int32(coreir.OwnMove) ||
                   index.definitionSemanticRows[definitionProbe] !=
                       defOp.valueDefSemanticRow ||
                   templateRow < 0 ||
                   templateRow >=
                       replayIndex.templateRowByOp.len ||
                   replayIndex.replayRowByOp[templateRow] !=
                       BodyIrAccessNoIndex ||
                   replayIndex.templateRowByOp[templateRow] !=
                       templateRow ||
                   replayRow < 0 ||
                   mappedTemplateRow != templateRow ||
                   index.definitionLastReplayRows[
                       definitionProbe] == replayRow:
                    bodyIrAccessFailPhase(
                        table, 3723,
                        BodyIrAccessErrorOwnership,
                        BodyIrAccessSiteOp,
                        defOpIndex,
                        defOp.valueDefOriginId)
                    return false
                index.definitionLastReplayRows[
                    definitionProbe] = replayRow
            definitionIndexed = true
            break
        definitionProbe = definitionProbe + 1
        if definitionProbe >= index.bucketCount:
            definitionProbe = 0
        definitionScanned = definitionScanned + 1
    if !definitionIndexed:
        bodyIrAccessFailPhase(table, 3739,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteOp,
                         defOpIndex,
                         defOp.valueDefOriginId)
        return false
    if defOp.consumeActionRow < 0:
        return true
    var consumeProbe =
        bodyIrAccessConsumeIndexBucket(defOp.consumeActionRow,
                                       index.bucketCount)
    var consumeScanned: int32
    while consumeScanned < index.bucketCount:
        if index.consumeActionRows[consumeProbe] == -1:
            index.consumeActionRows[consumeProbe] =
                defOp.consumeActionRow
            return true
        if index.consumeActionRows[consumeProbe] ==
               defOp.consumeActionRow:
            bodyIrAccessFailPhase(table, 3758,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             defOpIndex,
                             defOp.consumeActionRow)
            return false
        consumeProbe = consumeProbe + 1
        if consumeProbe >= index.bucketCount:
            consumeProbe = 0
        consumeScanned = consumeScanned + 1
    bodyIrAccessFailPhase(table, 3768,
                     BodyIrAccessErrorOwnership,
                     BodyIrAccessSiteOp,
                     defOpIndex,
                     defOp.consumeActionRow)
    return false

@borrows
fn bodyIrAccessCallUsesSourceSlotExact(
        call: coreir.CallOp,
        sourceSlot: int32): bool =
    for argIndex in 0..<call.argSlots.len:
        var argSlot = call.argSlots[argIndex]
        if coreir.CallArgSlotIsAddress(argSlot):
            argSlot = coreir.CallArgSlotAddressId(argSlot)
        if argSlot == sourceSlot:
            return true
    return false

@borrows
fn bodyIrAccessVerifyExplicitDefinitionEdges(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        index: var BodyIrAccessManagedDefinitionIndex): bool =
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIrAccessOpAt(bodyIR, opIndex)
        if bodyIrAccessDefinitionPairIsInvalid(
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow):
            if op.kind == coreir.BodyOpReturnTag &&
               bodyIrAccessLocalValid(bodyIR, op.target) &&
               index.managedDefinitionCountBySlot[op.target] > 0:
                bodyIrAccessFailPhase(table, 3800,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteOp,
                                 opIndex,
                                 op.target)
                return false
            continue
        let sourceDefinitionIndex =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                op.sourceDefinitionDomain,
                op.sourceDefinitionRow)
        if sourceDefinitionIndex < 0 ||
           !bodyIrAccessDefinitionPairShapeValid(
               bodyIR,
               op.sourceDefinitionDomain,
               op.sourceDefinitionRow):
            bodyIrAccessFailPhase(table, 3817,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             op.sourceDefinitionRow)
            return false
        let sourceOwnership =
            bodyIrAccessDefinitionOwnership(
                bodyIR,
                op.sourceDefinitionDomain,
                op.sourceDefinitionRow)
        let sourceSlot =
            bodyIrAccessDefinitionSlot(
                bodyIR,
                op.sourceDefinitionDomain,
                op.sourceDefinitionRow)
        if (sourceOwnership != int32(coreir.OwnMove) &&
            sourceOwnership !=
                int32(coreir.OwnBorrowShared)) ||
           !bodyIrAccessLocalValid(bodyIR, sourceSlot):
            bodyIrAccessFailPhase(table, 3837,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             sourceSlot)
            return false
        var exactSourceShape = false
        var exactNonConsumingDerivation = false
        var sourceUseSlot = sourceSlot
        if op.kind == coreir.BodyOpCopyLocalTag &&
           op.operands.len == 1:
            let operandSlot = op.operands[0]
            sourceUseSlot = operandSlot
            var exactProjectedSource = false
            if bodyIrAccessLocalValid(bodyIR, operandSlot):
                let projection =
                    bodyIrAccessLocalSlotAt(
                        bodyIR, operandSlot)
                exactProjectedSource =
                    projection.placeKind ==
                        coreir.BodyPlaceBorrowAddressTag &&
                    projection.auxValue ==
                        sourceSlot &&
                    bodyIrAccessLocalValid(bodyIR, op.target) &&
                    bodyIR.localSlots[op.target].placeKind ==
                        coreir.BodyPlaceStackValueTag
            exactSourceShape =
                operandSlot == sourceSlot ||
                exactProjectedSource
            exactNonConsumingDerivation =
                exactSourceShape &&
                op.valueDefOwnership == coreir.OwnMove &&
                op.valueDefOriginKind ==
                    coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
                ((operandSlot == sourceSlot &&
                  op.valueDefExprNodeIndex >= 0 &&
                  index.retainedDerivationByOp[opIndex]) ||
                 (exactProjectedSource &&
                  op.valueDefExprNodeIndex == -1))
        elif op.kind == coreir.BodyOpLoadLocalTag &&
             ((op.operands.len == 5 &&
               op.operands[0] ==
                   coreir.BodyLoadLocalIndexedAddressTag) ||
              (op.operands.len == 4 &&
               op.operands[0] ==
                   coreir.BodyLoadLocalFieldAddressTag)):
            sourceUseSlot = op.operands[1]
            exactSourceShape =
                sourceUseSlot == sourceSlot &&
                bodyIrAccessIndexedAddressIsNonConsumingExact(
                    bodyIR, op)
            exactNonConsumingDerivation = exactSourceShape
        elif op.kind == coreir.BodyOpReturnTag:
            exactSourceShape =
                op.target == sourceSlot
        elif op.kind == coreir.BodyOpCallTag &&
             op.operands.len == 1:
            let callOrdinal = op.operands[0]
            if callOrdinal >= 0 &&
               callOrdinal < bodyIR.callSequence.len:
                let call = bodyIrAccessCallAt(
                    bodyIR, callOrdinal)
                exactSourceShape =
                    bodyIrAccessDefinitionPairEqual(
                        call.sourceDefinitionDomain,
                        call.sourceDefinitionRow,
                        op.sourceDefinitionDomain,
                        op.sourceDefinitionRow) &&
                    bodyIrAccessCallUsesSourceSlotExact(
                        call, sourceSlot)
                if exactSourceShape &&
                   bodyIrAccessManagedRetainStoreKindExact(
                       call.managedStoreKind) &&
                   sourceOwnership ==
                       int32(coreir.OwnBorrowShared) &&
                   call.consumeActionRow == -1 &&
                   op.consumeActionRow == -1:
                    exactNonConsumingDerivation = true
                elif exactSourceShape &&
                     call.managedStoreKind ==
                         coreir.ManagedStoreCleanupRetainTag &&
                     call.consumeActionRow >= 0 &&
                     op.consumeActionRow ==
                         call.consumeActionRow &&
                     op.valueDefOwnership == coreir.OwnInvalid:
                    exactNonConsumingDerivation = true
                elif exactSourceShape &&
                     bodyIrAccessManagedSnapshotKindExact(
                         call.managedStoreKind) &&
                     op.valueDefOwnership == coreir.OwnMove &&
                     op.valueDefOriginKind ==
                         coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
                     op.valueDefExprNodeIndex >= 0 &&
                     call.resultOwnership == op.valueDefOwnership &&
                     call.resultDefinitionOriginKind ==
                         op.valueDefOriginKind &&
                     call.resultDefinitionOriginId ==
                         op.valueDefOriginId &&
                     op.consumeActionRow == -1:
                    exactNonConsumingDerivation = true
        if !exactSourceShape:
            bodyIrAccessFailPhase(table, 3938,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             sourceUseSlot)
            return false
        let managedMoveEvent =
            op.kind == coreir.BodyOpCallTag &&
            op.operands.len == 1 &&
            op.operands[0] >= 0 &&
            op.operands[0] < bodyIR.callSequence.len &&
            bodyIrAccessManagedMoveStoreKindExact(
                bodyIR.callSequence[
                    op.operands[0]].managedStoreKind)
        let sourceConsumeLinked =
            !exactNonConsumingDerivation &&
            ((managedMoveEvent &&
              bodyIrAccessAppendOnlyManagedMoveEventExact(
                  bodyIR, opIndex, op)) ||
             (!managedMoveEvent &&
              (op.sourceDefinitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag ||
               bodyIR.ops[
                   op.sourceDefinitionRow].valueDefConsumeOpIndexPlusOne ==
                   opIndex + 1)))
        if !sourceConsumeLinked &&
           !exactNonConsumingDerivation:
            bodyIrAccessFailPhase(table, 3965,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             sourceOwnership)
            return false
        let factStart = table.opFactStarts[opIndex]
        let factCount = table.opFactCounts[opIndex]
        var sourceUseFactIndex = BodyIrAccessNoIndex
        for factOffset in 0..<factCount:
            let factIndex = factStart + factOffset
            if table.facts[factIndex].kind !=
                   BodyIrAccessFactUse ||
               table.facts[factIndex].slotIndex != sourceUseSlot:
                continue
            if sourceUseFactIndex != BodyIrAccessNoIndex ||
               !bodyIrAccessDefinitionPairIsInvalid(
                   table.facts[factIndex].definitionDomain,
                   table.facts[factIndex].definitionRow):
                bodyIrAccessFailPhase(table, 3984,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteOp,
                                 opIndex,
                                 sourceUseSlot)
                return false
            sourceUseFactIndex = factIndex
        if sourceUseFactIndex == BodyIrAccessNoIndex:
            bodyIrAccessFailPhase(table, 3992,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             sourceUseSlot)
            return false
        table.facts[sourceUseFactIndex].definitionDomain =
            op.sourceDefinitionDomain
        table.facts[sourceUseFactIndex].definitionRow =
            op.sourceDefinitionRow
        table.facts[sourceUseFactIndex].consumesDefinition =
            sourceConsumeLinked
    for termIndex in 0..<bodyIR.terms.len:
        let term = bodyIrAccessTermAt(
            bodyIR, termIndex)
        if term.kind != coreir.BodyTermReturnTag:
            if !bodyIrAccessDefinitionPairIsInvalid(
                   term.sourceDefinitionDomain,
                   term.sourceDefinitionRow):
                bodyIrAccessFailPhase(table, 4011,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteTerm,
                                 termIndex,
                                 term.sourceDefinitionRow)
                return false
            continue
        if bodyIrAccessDefinitionPairIsInvalid(
               term.sourceDefinitionDomain,
               term.sourceDefinitionRow):
            let termResultSlot = term.resultSlot
            if bodyIrAccessLocalValid(bodyIR, termResultSlot) &&
               index.managedDefinitionCountBySlot[termResultSlot] > 0:
                # [wall108r2] return 纯值槽 admit：槽上全部 managed def
                # （与注册计数联立核对）均为 OwnPlain 纯值定义形且槽非托管
                # （tid>=0）时，非托管 return 无所有权转移，term.source
                # 保持 Invalid 哨兵是精确真相——def 由值语义在 return 处
                # 自然终结，非「悬空托管定义」。任一 def 形不符、计数不齐
                # （含 manualConsume 入册形）或槽非 Unmanaged 即原判词
                # fail-closed；无 sentinel 豁免、无计数门放宽。
                var plainPureValueDefs = 0
                var allPlainPureValue = true
                for defOpIndex in 0..<bodyIR.ops.len:
                    if bodyIR.ops[defOpIndex].valueDefSlot == termResultSlot &&
                       bodyIR.ops[defOpIndex].valueDefOwnership !=
                           coreir.OwnInvalid:
                        if bodyIR.ops[defOpIndex].valueDefOwnership == coreir.OwnPlain &&
                           bodyIR.ops[defOpIndex].valueDefOriginKind ==
                               coreir.BodyDefinitionOriginTypedExprTag &&
                           bodyIR.ops[defOpIndex].valueDefOriginId == bodyIR.ops[defOpIndex].valueDefSemanticRow &&
                           bodyIR.ops[defOpIndex].valueDefOriginId >= 0 &&
                           bodyIR.ops[defOpIndex].valueDefExprNodeIndex >= 0 &&
                           bodyIR.ops[defOpIndex].valueDefBorrowOwnerSemanticRow == -1 &&
                           bodyIR.ops[defOpIndex].valueDefBorrowOwnerDefinitionDomain ==
                               coreir.BodyDefinitionDomainInvalidTag &&
                           bodyIR.ops[defOpIndex].valueDefBorrowOwnerDefinitionRow == -1 &&
                           bodyIrAccessDefinitionPairIsInvalid(
                               bodyIR.ops[defOpIndex].sourceDefinitionDomain,
                               bodyIR.ops[defOpIndex].sourceDefinitionRow) &&
                           bodyIR.ops[defOpIndex].consumeActionRow == -1:
                            plainPureValueDefs = plainPureValueDefs + 1
                        else:
                            allPlainPureValue = false
                let plainPureValueReturnSlot =
                    allPlainPureValue &&
                    plainPureValueDefs ==
                        index.managedDefinitionCountBySlot[termResultSlot] &&
                    bodyIR.localSlots[termResultSlot].managedStorageKind ==
                        coreir.BodyManagedStorageUnmanagedTag &&
                    bodyIR.localSlots[termResultSlot].typeArenaTypeId >= 0
                if !plainPureValueReturnSlot:
                    bodyIrAccessFailPhase(table, 4062,
                                     BodyIrAccessErrorOwnership,
                                     BodyIrAccessSiteTerm,
                                     termIndex,
                                     term.resultSlot)
                    return false
            continue
        let sourceDefinitionIndex =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                term.sourceDefinitionDomain,
                term.sourceDefinitionRow)
        if sourceDefinitionIndex < 0:
            bodyIrAccessFailPhase(table, 4075,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteTerm,
                             termIndex,
                             sourceDefinitionIndex)
            return false
        let sourceOwnership =
            bodyIrAccessDefinitionOwnership(
                bodyIR,
                term.sourceDefinitionDomain,
                term.sourceDefinitionRow)
        # A borrowed definition cannot cross the function boundary. A legal
        # borrowed return first materializes an exact retained OwnMove root.
        if sourceOwnership != int32(coreir.OwnMove) ||
           bodyIrAccessDefinitionSlot(
               bodyIR,
               term.sourceDefinitionDomain,
               term.sourceDefinitionRow) != term.resultSlot:
            bodyIrAccessFailPhase(table, 4093,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteTerm,
                             termIndex,
                             sourceDefinitionIndex)
            return false
        let factStart = table.termFactStarts[termIndex]
        let factCount = table.termFactCounts[termIndex]
        var sourceUseFactIndex = BodyIrAccessNoIndex
        for factOffset in 0..<factCount:
            let factIndex = factStart + factOffset
            if table.facts[factIndex].kind !=
                   BodyIrAccessFactUse ||
               table.facts[factIndex].slotIndex !=
                   term.resultSlot:
                continue
            if sourceUseFactIndex != BodyIrAccessNoIndex ||
               !bodyIrAccessDefinitionPairIsInvalid(
                   table.facts[factIndex].definitionDomain,
                   table.facts[factIndex].definitionRow):
                bodyIrAccessFailPhase(table, 4113,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteTerm,
                                 termIndex,
                                 term.resultSlot)
                return false
            sourceUseFactIndex = factIndex
        if sourceUseFactIndex == BodyIrAccessNoIndex:
            bodyIrAccessFailPhase(table, 4121,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteTerm,
                             termIndex,
                             term.resultSlot)
            return false
        table.facts[sourceUseFactIndex].definitionDomain =
            term.sourceDefinitionDomain
        table.facts[sourceUseFactIndex].definitionRow =
            term.sourceDefinitionRow
        table.facts[sourceUseFactIndex].consumesDefinition = false
    return true

@borrows
fn bodyIrAccessCfgBlockReaches(
        bodyIR: coreir.BodyIR,
        fromBlockId: int32,
        toBlockId: int32): bool =
    if fromBlockId < 0 ||
       fromBlockId >= bodyIR.blocks.len ||
       toBlockId < 0 ||
       toBlockId >= bodyIR.blocks.len:
        return false
    let termIndex = bodyIR.blocks[fromBlockId].termIndex
    if termIndex < 0 ||
       termIndex >= bodyIR.termSuccessorStarts.len ||
       termIndex >= bodyIR.termSuccessorCounts.len:
        return false
    let start = bodyIR.termSuccessorStarts[termIndex]
    let count = bodyIR.termSuccessorCounts[termIndex]
    if start < 0 || count < 0 ||
       start > bodyIR.successorBlockIds.len - count:
        return false
    for offset in 0..<count:
        if bodyIR.successorBlockIds[start + offset] ==
               toBlockId:
            return true
    return false

fn bodyIrAccessCfgMergeState(
        current: var int32,
        incoming: int32) =
    if current == BodyIrAccessCfgUnreached:
        current = incoming
        return
    if incoming == BodyIrAccessCfgUnreached ||
       current == incoming:
        return
    current = BodyIrAccessCfgAmbiguous

@borrows
fn bodyIrAccessCfgSourceIsNonConsuming(
        bodyIR: coreir.BodyIR,
        index: var BodyIrAccessManagedDefinitionIndex,
        opIndex: int32): bool =
    if index.retainedDerivationByOp[opIndex]:
        return true
    let op = bodyIR.ops[opIndex]
    if bodyIrAccessIndexedAddressIsNonConsumingExact(
           bodyIR, op):
        return true
    if op.kind != coreir.BodyOpCallTag ||
       op.operands.len != 1:
        return false
    let callOrdinal = op.operands[0]
    if callOrdinal < 0 ||
       callOrdinal >= bodyIR.callSequence.len:
        return false
    let kind =
        bodyIR.callSequence[callOrdinal].managedStoreKind
    return bodyIrAccessManagedRetainStoreKindExact(kind) ||
           bodyIrAccessManagedSnapshotKindExact(kind) ||
           kind == coreir.ManagedStoreCleanupRetainTag

fn bodyIrAccessCfgAppendTransfer(
        cfg: var BodyIrAccessDefinitionCfg,
        kind: int32,
        definitionOrdinal: int32): bool =
    if (kind != BodyIrAccessCfgTransferKill &&
        kind != BodyIrAccessCfgTransferGen) ||
       definitionOrdinal < 0:
        return false
    add(cfg.transferKinds, kind)
    add(cfg.transferDefinitionOrdinals,
        definitionOrdinal)
    return true

@borrows
fn bodyIrAccessBuildDefinitionCfg(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        index: var BodyIrAccessManagedDefinitionIndex,
        cfg: var BodyIrAccessDefinitionCfg): bool =
    if !coreir.BodyIRControlFlowShapeValid(bodyIR) ||
       bodyIR.blocks.len <= 0 ||
       bodyIR.terms.len <= 0:
        bodyIrAccessFailPhase(table, 4217,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteEntry,
                         BodyIrAccessNoIndex,
                         bodyIR.blocks.len)
        return false
    for _ in 0..<bodyIR.ops.len:
        add(cfg.opBlockIds, BodyIrAccessNoIndex)
    for _ in 0..<bodyIR.terms.len:
        add(cfg.termBlockIds, BodyIrAccessNoIndex)
    # [wall126] managed-replace 行索引：replaceOpRows[op] 恒为该 op 的
    # 唯一 sidecar 行（ShapeValid 保证一致性），-1=非 replace 站点。
    var replaceRowByOp: int32[]
    for _ in 0..<bodyIR.ops.len:
        add(replaceRowByOp, -1)
    for replaceRow in 0..<bodyIR.managedLvalueReplace.replaceOpRows.len:
        let replaceOpRow =
            bodyIR.managedLvalueReplace.replaceOpRows[replaceRow]
        if replaceOpRow >= 0 && replaceOpRow < bodyIR.ops.len &&
           replaceRowByOp[replaceOpRow] < 0:
            replaceRowByOp[replaceOpRow] = replaceRow
    for blockId in 0..<bodyIR.blocks.len:
        let block = bodyIR.blocks[blockId]
        if block.id != blockId ||
           block.opStart < 0 ||
           block.opStart > bodyIR.ops.len ||
           block.opCount < 0 ||
           block.opCount >
               bodyIR.ops.len - block.opStart ||
           block.termIndex < 0 ||
           block.termIndex >= bodyIR.terms.len ||
           cfg.termBlockIds[block.termIndex] !=
               BodyIrAccessNoIndex:
            bodyIrAccessFailPhase(table, 4239,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteEntry,
                             blockId,
                             block.termIndex)
            return false
        cfg.termBlockIds[block.termIndex] = blockId
        for opOffset in 0..<block.opCount:
            let opIndex = block.opStart + opOffset
            if cfg.opBlockIds[opIndex] !=
                   BodyIrAccessNoIndex:
                bodyIrAccessFailPhase(
                    table, 4250,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    blockId)
                return false
            cfg.opBlockIds[opIndex] = blockId
    for opIndex in 0..<cfg.opBlockIds.len:
        if cfg.opBlockIds[opIndex] < 0:
            bodyIrAccessFailPhase(table, 4260,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             opIndex,
                             opIndex)
            return false
    for termIndex in 0..<cfg.termBlockIds.len:
        if cfg.termBlockIds[termIndex] < 0:
            bodyIrAccessFailPhase(table, 4268,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteTerm,
                             termIndex,
                             termIndex)
            return false
    for opIndex in 0..<bodyIR.ops.len:
        add(cfg.transferStartsByOp,
            cfg.transferKinds.len)
        let op = bodyIR.ops[opIndex]
        var manualRow = BodyIrAccessNoIndex
        if op.kind == coreir.BodyOpCallTag &&
           op.operands.len == 1:
            manualRow =
                BodyIrAccessManualConsumeRowForCall(
                    table, op.operands[0])
        if manualRow >= 0:
            let callOrdinal = op.operands[0]
            let call = bodyIR.callSequence[
                callOrdinal]
            let targetSlot =
                bodyIR.manualConsume.targetOwnerSlotIds[
                    manualRow]
            var callDefinesManagedTarget: bool
            if call.resultSlot == targetSlot:
                if call.resultOwnership ==
                       coreir.OwnMove ||
                   call.resultOwnership ==
                       coreir.OwnBorrowShared:
                    callDefinesManagedTarget = true
            var opDefinesManagedTarget: bool
            if op.valueDefSlot == targetSlot:
                if op.valueDefOwnership ==
                       coreir.OwnMove ||
                   op.valueDefOwnership ==
                       coreir.OwnBorrowShared:
                    opDefinesManagedTarget = true
            # A manual-consume call has exactly one target definition:
            # ManualConsumePostCall(row).  A regular managed call/op result
            # in that same slot would silently overwrite the canonical post
            # state during replay, so it is not a second valid producer.
            if callDefinesManagedTarget ||
               opDefinesManagedTarget:
                bodyIrAccessFailPhase(
                    table, 4311,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    targetSlot)
                return false
            let targetOrdinal =
                BodyIrAccessManagedDefinitionOrdinal(
                    index,
                    bodyIR.manualConsume.targetDefinitionDomains[
                        manualRow],
                    bodyIR.manualConsume.targetDefinitionRows[
                        manualRow])
            let sourceOrdinal =
                BodyIrAccessManagedDefinitionOrdinal(
                    index,
                    bodyIR.manualConsume.sourceDefinitionDomains[
                        manualRow],
                    bodyIR.manualConsume.sourceDefinitionRows[
                        manualRow])
            let postOrdinal =
                BodyIrAccessManagedDefinitionOrdinal(
                    index,
                    coreir.BodyDefinitionDomainManualConsumePostCallTag,
                    manualRow)
            if targetOrdinal < 0 ||
               sourceOrdinal < 0 ||
               postOrdinal < 0 ||
               index.definitionSlotsByOrdinal[
                   targetOrdinal] ==
                   index.definitionSlotsByOrdinal[
                       sourceOrdinal] ||
               !bodyIrAccessCfgAppendTransfer(
                   cfg,
                   BodyIrAccessCfgTransferKill,
                   targetOrdinal) ||
               !bodyIrAccessCfgAppendTransfer(
                   cfg,
                   BodyIrAccessCfgTransferKill,
                   sourceOrdinal) ||
               !bodyIrAccessCfgAppendTransfer(
                   cfg,
                   BodyIrAccessCfgTransferGen,
                   postOrdinal):
                bodyIrAccessFailPhase(
                    table, 4356,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    manualRow)
                return false
        elif !bodyIrAccessDefinitionPairIsInvalid(
                  op.sourceDefinitionDomain,
                  op.sourceDefinitionRow) &&
             !bodyIrAccessCfgSourceIsNonConsuming(
                  bodyIR, index, opIndex):
            let sourceOrdinal =
                BodyIrAccessManagedDefinitionOrdinal(
                    index,
                    op.sourceDefinitionDomain,
                    op.sourceDefinitionRow)
            if !bodyIrAccessCfgAppendTransfer(
                   cfg,
                   BodyIrAccessCfgTransferKill,
                   sourceOrdinal):
                bodyIrAccessFailPhase(
                    table, 4377,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    op.sourceDefinitionRow)
                return false
        # Exact call arguments are a dense multi-source consume channel.  A
        # CallOp's scalar sourceDefinition pair cannot represent this without
        # losing identity when one call moves more than one argument.
        let factStart = table.opFactStarts[opIndex]
        let factCount = table.opFactCounts[opIndex]
        for factOffset in 0..<factCount:
            let fact = table.facts[factStart + factOffset]
            if fact.exactCallArgRow < 0 ||
               fact.manualConsumeRow >= 0 ||
               !fact.consumesDefinition ||
               fact.definitionDomain !=
                   coreir.BodyDefinitionDomainBodyOpTag:
                continue
            # Cleanup/manual transports may mirror the same source in both
            # channels.  They are one semantic consume, so the scalar channel
            # remains their transfer authority.
            if bodyIrAccessDefinitionPairEqual(
                   op.sourceDefinitionDomain,
                   op.sourceDefinitionRow,
                   fact.definitionDomain,
                   fact.definitionRow):
                continue
            # [wall126] managed-replace 镜像守卫（per-fact 精确收窄）：
            # 密封 replace 行站点（bodyIR.managedLvalueReplace，Decode
            # 入口 ShapeValid + 生产道 ManagedLvalueReplaceProductionVerify
            # 双重权威）对其 sourceDefinition 对的 exact-call-arg Move
            # 消费是「绑定传输」不是所有权转移终局：胶水 call 按值收走
            # new 结果又原位 sret 绑回同一 def 的所属槽，def 身份跨胶水
            # 存续。此处 Kill 会在无 re-Gen 的 bind 形上清空该槽唯一存
            # 活 def（v6/probe 实证：states[slot]<0 于首次 FieldStore 基
            # 使用，phase=4746），而 replace 的旧根释放由 sidecar 自身
            # consumeAction/cleanup 通道承载（与 manual-consume
            # 「physical BodyOp row is not a cp1 contract」同构：sidecar
            # 是该消费的转移权威）。fail-closed 自证：①仅跳过与 sidecar
            # source 对精确相等的 fact，其余 exact-call-arg Kill 零触；
            # ②replace 绑定真伪由密封 sidecar 的 rootCid/类型闭包/地址
            # 精确列 + 生产道 Verify + 物化后 final decode 重审同一验证
            # 器兜底；③被跳过 Kill 的 def 仍受本函数 Kill 合法性预检、
            # Gen 借主预检与 states 一致性门（blockEndStates 恒等）全量
            # 约束。
            let replaceRow = replaceRowByOp[opIndex]
            if replaceRow >= 0 &&
               fact.definitionDomain ==
                   bodyIR.managedLvalueReplace.sourceDefinitionDomains[
                       replaceRow] &&
               fact.definitionRow ==
                   bodyIR.managedLvalueReplace.sourceDefinitionRows[
                       replaceRow]:
                continue
            # [wall128] 合成桥值传输守卫（per-fact 精确收窄）：合成运行时
            # 桥 call（core_types CallOp 契约：semanticCallExprNodeIndex
            # 「Synthetic calls keep -1」，无源调用表达式）且结果权威九列
            # 全哨兵（无任何 def 物化）、scalar source 边/consumeAction/
            # managedStoreKind/replace/drop-glue 描述符全空，对其值编码
            # 实参槽（argSlots[argIndex]>=0，derive 批 2 Move 镜像臂的
            # 同一触发条件）的 exact-call-arg Move 消费是「地址/内存语义
            # 传输」不是所有权转移终局：setMem zero-init 桥按值收走 new
            # 结果的槽值只写对象体，def 身份跨桥存续（v6/E2 探针四证联
            # 立：失败 FieldStore src 对无效+slot0defops 唯一 d3+replace
            # /manual-consume 行全空+killer 为 op3 后唯一值编码实参
            # call）。此处 Kill 会在无 re-Gen 的桥形上清空该槽唯一存活
            # def（states[slot]<0 于首次托管基使用，phase=4746），而
            # def-census（BuildManagedDefinitionIndex）与 Def fact 生成
            # 域均不认为该消费终结定义——CFG Kill 是唯一终局执行点，
            # 豁免即 wall127 dual-domain split 的 decode 内对齐。fail-
            # closed 自证：①用户 call（semanticCallExprNodeIndex>=0）
            # 照常 Kill，owned 形参真消费零放行；②带结果物化/replace/
            # drop-glue/非 None 语义码的合成 call 一列不符即不豁免，原
            # 样走 Kill；③被跳过 Kill 的 def 仍受本函数 Kill 合法性预
            # 检、Gen 借主预检与 states 一致性门（blockEndStates 恒等）
            # 全量约束；④豁免只跳过 transfer，fact 本身仍在表，其余域
            # 验证零触碰。
            let bridgeCallOrdinal = op.operands[0]
            if op.kind == coreir.BodyOpCallTag &&
               op.operands.len == 1 &&
               bridgeCallOrdinal >= 0 &&
               bridgeCallOrdinal < bodyIR.callSequence.len:
                let bridgeCall = bodyIR.callSequence[bridgeCallOrdinal]
                let bridgeArgIndex = fact.fixedOrdinal
                if bridgeCall.semanticCallExprNodeIndex == -1 &&
                   bridgeCall.resultSlot == -1 &&
                   bridgeCall.resultOwnership == coreir.OwnInvalid &&
                   bridgeCall.resultExprNodeIndex == -1 &&
                   bridgeCall.resultValueDefinitionRow == -1 &&
                   bridgeCall.resultDefinitionOriginKind ==
                       coreir.BodyDefinitionOriginUnknownTag &&
                   bridgeCall.resultDefinitionOriginId == -1 &&
                   bridgeCall.resultBorrowOwnerValueDefinitionRow == -1 &&
                   bridgeCall.resultBorrowOwnerDefinitionDomain ==
                       coreir.BodyDefinitionDomainInvalidTag &&
                   bridgeCall.resultBorrowOwnerDefinitionRow == -1 &&
                   bodyIrAccessDefinitionPairIsInvalid(
                       bridgeCall.sourceDefinitionDomain,
                       bridgeCall.sourceDefinitionRow) &&
                   bridgeCall.consumeActionRow == -1 &&
                   bridgeCall.managedStoreKind ==
                       coreir.ManagedStoreNoneTag &&
                   bridgeCall.managedReplaceReceiptRow == -1 &&
                   bridgeCall.managedDropGlueDescriptorRow == -1 &&
                   bridgeArgIndex >= 0 &&
                   bridgeArgIndex < bridgeCall.argSlots.len &&
                   bridgeCall.argSlots[bridgeArgIndex] >= 0:
                    continue
            let definitionOrdinal =
                BodyIrAccessManagedDefinitionOrdinal(
                    index,
                    fact.definitionDomain,
                    fact.definitionRow)
            if !bodyIrAccessCfgAppendTransfer(
                   cfg,
                   BodyIrAccessCfgTransferKill,
                   definitionOrdinal):
                bodyIrAccessFailPhase(
                    table, 4415,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    fact.definitionRow)
                return false
        if op.valueDefOwnership != coreir.OwnInvalid:
            let definitionOrdinal =
                BodyIrAccessManagedDefinitionOrdinal(
                    index,
                    coreir.BodyDefinitionDomainBodyOpTag,
                    opIndex)
            if !bodyIrAccessCfgAppendTransfer(
                   cfg,
                   BodyIrAccessCfgTransferGen,
                   definitionOrdinal):
                bodyIrAccessFailPhase(
                    table, 4432,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    op.valueDefSlot)
                return false
        add(cfg.transferCountsByOp,
            cfg.transferKinds.len -
                cfg.transferStartsByOp[opIndex])
    return true

@borrows
fn bodyIrAccessCfgIncomingState(
        bodyIR: coreir.BodyIR,
        index: var BodyIrAccessManagedDefinitionIndex,
        cfg: var BodyIrAccessDefinitionCfg,
        blockId: int32,
        states: var int32[]): bool =
    if states.len != 0:
        return false
    for _ in 0..<bodyIR.localSlots.len:
        add(states, BodyIrAccessCfgUnreached)
    var hasIncoming: bool
    if blockId == 0:
        hasIncoming = true
        for slot in 0..<bodyIR.localSlots.len:
            let entryOrdinal =
                index.entryDefinitionOrdinals[slot]
            if entryOrdinal >= 0:
                states[slot] = entryOrdinal
            else:
                states[slot] =
                    BodyIrAccessCfgConsumed
    for predecessorId in 0..<bodyIR.blocks.len:
        if !cfg.blockReached[predecessorId] ||
           !bodyIrAccessCfgBlockReaches(
               bodyIR, predecessorId, blockId):
            continue
        let predecessorStart =
            predecessorId * bodyIR.localSlots.len
        for slot in 0..<bodyIR.localSlots.len:
            bodyIrAccessCfgMergeState(
                states[slot],
                cfg.blockEndStates[
                    predecessorStart + slot])
        hasIncoming = true
    return hasIncoming

@borrows
fn bodyIrAccessCfgApplyOpTransfers(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        index: var BodyIrAccessManagedDefinitionIndex,
        cfg: var BodyIrAccessDefinitionCfg,
        opIndex: int32,
        states: var int32[],
        validate: bool): bool =
    let start = cfg.transferStartsByOp[opIndex]
    let count = cfg.transferCountsByOp[opIndex]
    if validate:
        for offset in 0..<count:
            let eventIndex = start + offset
            if cfg.transferKinds[eventIndex] !=
                   BodyIrAccessCfgTransferKill:
                continue
            let definitionOrdinal =
                cfg.transferDefinitionOrdinals[eventIndex]
            let slot =
                index.definitionSlotsByOrdinal[
                    definitionOrdinal]
            if states[slot] != definitionOrdinal:
                bodyIrAccessFailPhase(
                    table, 4504,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    definitionOrdinal)
                return false
        for offset in 0..<count:
            let eventIndex = start + offset
            if cfg.transferKinds[eventIndex] !=
                   BodyIrAccessCfgTransferGen:
                continue
            let definitionOrdinal =
                cfg.transferDefinitionOrdinals[eventIndex]
            let slot =
                index.definitionSlotsByOrdinal[
                    definitionOrdinal]
            let borrowOwnerOrdinal =
                index.borrowOwnerDefinitionOrdinals[
                    definitionOrdinal]
            if borrowOwnerOrdinal >= 0:
                let ownerSlot =
                    index.definitionSlotsByOrdinal[
                        borrowOwnerOrdinal]
                if states[ownerSlot] != borrowOwnerOrdinal:
                    bodyIrAccessFailPhase(
                        table, 4529,
                        BodyIrAccessErrorOwnership,
                        BodyIrAccessSiteOp,
                        opIndex,
                        borrowOwnerOrdinal)
                    return false
            var killedSameSlot: bool
            for probeOffset in 0..<count:
                let probeIndex = start + probeOffset
                if cfg.transferKinds[probeIndex] ==
                       BodyIrAccessCfgTransferKill &&
                   index.definitionSlotsByOrdinal[
                       cfg.transferDefinitionOrdinals[
                           probeIndex]] == slot:
                    killedSameSlot = true
            if states[slot] !=
                   BodyIrAccessCfgConsumed &&
               !killedSameSlot:
                bodyIrAccessFailPhase(
                    table, 4548,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    definitionOrdinal)
                return false
    # All kills were checked against one immutable pre-state.  Only now may
    # the transfer mutate the lattice, so manual target/source cannot
    # accidentally validate against each other's result.
    for offset in 0..<count:
        let eventIndex = start + offset
        if cfg.transferKinds[eventIndex] ==
               BodyIrAccessCfgTransferKill:
            let definitionOrdinal =
                cfg.transferDefinitionOrdinals[eventIndex]
            let slot =
                index.definitionSlotsByOrdinal[
                    definitionOrdinal]
            states[slot] = BodyIrAccessCfgConsumed
            # [wall111b] 借主死亡传播（lattice 契约补全，fail-closed 零弱
            # 化）：owner def 被 Kill 的同一变更相内，凡 borrowOwner==
            # owner 的 current 借视 def 一并 Consumed（fixpoint 覆盖链式
            # 借视）。契约依据：借视 def 禁止携带 consume link（OwnBorrow
            # Shared def 审 cp1!=0 即 fail），lattice 本无任何借视终结机
            # 制，而词法作用域语义=借视随借主作用域终结——作用域出口
            # cleanup drop 单元杀死借主时，其借视必须同相终结，否则
            # validate 尾「current 借视的借主必须仍 current」门把一切
            # 「借用后于作用域出口释放借主」的合法程序误判为悬空借用
            # （cold_nested 实证：code=15 site=Op index=dropOp detail=
            # borrowOwnerOrdinal）。零弱化自证：①此前可过形处必无
            # current 借视（有则旧门已 RED），本传播对其零触；②传播后
            # 对已终结借视的任何后续 Use 走 states[slot]!=ordinal 原判
            # 词 RED（悬空借用守卫面原样保留）；③借视仍可被新 def 正常
            # 覆盖，Kill 合法性预检与 Gen 借主预检零改动。validate 与
            # replay 两相同步应用，lattice 不动点语义一致。
            var sweptDerivedBorrow = true
            while sweptDerivedBorrow:
                sweptDerivedBorrow = false
                for sweepSlot in 0..<states.len:
                    let sweepOrdinal = states[sweepSlot]
                    if sweepOrdinal < 0:
                        continue
                    if index.borrowOwnerDefinitionOrdinals[
                           sweepOrdinal] == definitionOrdinal:
                        states[sweepSlot] =
                            BodyIrAccessCfgConsumed
                        sweptDerivedBorrow = true
    for offset in 0..<count:
        let eventIndex = start + offset
        if cfg.transferKinds[eventIndex] ==
               BodyIrAccessCfgTransferGen:
            let definitionOrdinal =
                cfg.transferDefinitionOrdinals[eventIndex]
            let slot =
                index.definitionSlotsByOrdinal[
                    definitionOrdinal]
            states[slot] = definitionOrdinal
    if validate:
        for slot in 0..<states.len:
            let definitionOrdinal = states[slot]
            if definitionOrdinal < 0:
                continue
            let borrowOwnerOrdinal =
                index.borrowOwnerDefinitionOrdinals[
                    definitionOrdinal]
            if borrowOwnerOrdinal < 0:
                continue
            let ownerSlot =
                index.definitionSlotsByOrdinal[
                    borrowOwnerOrdinal]
            if states[ownerSlot] != borrowOwnerOrdinal:
                bodyIrAccessFailPhase(
                    table, 4620,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    opIndex,
                    borrowOwnerOrdinal)
                return false
    return true

@borrows
fn bodyIrAccessVerifyDefinitionCfg(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        index: var BodyIrAccessManagedDefinitionIndex): bool =
    var cfg: BodyIrAccessDefinitionCfg
    if !bodyIrAccessBuildDefinitionCfg(
           bodyIR, table, index, cfg):
        return false
    if bodyIR.localSlots.len > 0 &&
       bodyIR.blocks.len >
           2147483647 / bodyIR.localSlots.len:
        bodyIrAccessFailPhase(table, 4641,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteEntry,
                         BodyIrAccessNoIndex,
                         bodyIR.blocks.len)
        return false
    let stateCount =
        bodyIR.blocks.len * bodyIR.localSlots.len
    var nextReached: bool[]
    var nextStates: int32[]
    for _ in 0..<bodyIR.blocks.len:
        add(cfg.blockReached, false)
        add(nextReached, false)
    for _ in 0..<stateCount:
        add(cfg.blockEndStates,
            BodyIrAccessCfgUnreached)
        add(nextStates,
            BodyIrAccessCfgUnreached)
    if bodyIR.blocks.len >
           (2147483647 - 4) / 4:
        bodyIrAccessFailPhase(table, 4661,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteEntry,
                         BodyIrAccessNoIndex,
                         bodyIR.blocks.len)
        return false
    let stepLimit = bodyIR.blocks.len * 4 + 4
    var stepCount: int32
    var changed = true
    while changed:
        changed = false
        stepCount = stepCount + 1
        if stepCount > stepLimit:
            bodyIrAccessFailPhase(
                table, 4674,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteEntry,
                BodyIrAccessNoIndex,
                stepCount)
            return false
        for blockId in 0..<bodyIR.blocks.len:
            var states: int32[]
            let reached =
                bodyIrAccessCfgIncomingState(
                    bodyIR, index, cfg,
                    blockId, states)
            nextReached[blockId] = reached
            if reached:
                let block = bodyIR.blocks[blockId]
                for opOffset in 0..<block.opCount:
                    let opIndex =
                        block.opStart + opOffset
                    if !bodyIrAccessCfgApplyOpTransfers(
                           bodyIR, table, index, cfg,
                           opIndex, states, false):
                        return false
            let rowStart =
                blockId * bodyIR.localSlots.len
            for slot in 0..<bodyIR.localSlots.len:
                nextStates[rowStart + slot] =
                    states[slot]
        for blockId in 0..<bodyIR.blocks.len:
            if cfg.blockReached[blockId] !=
                   nextReached[blockId]:
                changed = true
            cfg.blockReached[blockId] =
                nextReached[blockId]
        for stateIndex in 0..<stateCount:
            if cfg.blockEndStates[stateIndex] !=
                   nextStates[stateIndex]:
                changed = true
            cfg.blockEndStates[stateIndex] =
                nextStates[stateIndex]
    for blockId in 0..<bodyIR.blocks.len:
        if !cfg.blockReached[blockId]:
            continue
        var states: int32[]
        if !bodyIrAccessCfgIncomingState(
               bodyIR, index, cfg,
               blockId, states):
            bodyIrAccessFailPhase(
                table, 4721,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteEntry,
                blockId,
                blockId)
            return false
        let block = bodyIR.blocks[blockId]
        for opOffset in 0..<block.opCount:
            let opIndex = block.opStart + opOffset
            let factStart =
                table.opFactStarts[opIndex]
            let factCount =
                table.opFactCounts[opIndex]
            for factOffset in 0..<factCount:
                let fact =
                    table.facts[factStart + factOffset]
                if fact.kind == BodyIrAccessFactDef ||
                   fact.slotIndex < 0 ||
                   fact.slotIndex >=
                       bodyIR.localSlots.len ||
                   index.managedDefinitionCountBySlot[
                       fact.slotIndex] <= 0:
                    continue
                if states[fact.slotIndex] < 0:
                    # [wall128] 诊断富化（reject 路径专用，绿路径零成本，
                    # wall126 phase/diag 同款先例）：4746 死点只见
                    # states[slot]<0，此前 ops 的 Kill 来源（exact-call-arg
                    # 消费/scalar 源边/守卫豁免实况）全列不可见。此处把
                    # 死点前全部 ops 的 (kind,target,operands,vdo_own,
                    # src_row,action_row,callArg 消费列) 与各槽守卫豁免
                    # 计数一次带入判词，定点暴露伪消费 killer。只读实况
                    # 投影，无任何放行面变化。
                    var wall128Dump = ""
                    for dumpOpIndex in 0..<opIndex:
                        let dumpOp = bodyIR.ops[dumpOpIndex]
                        var dumpOperands = ""
                        for dumpOperandIndex in 0..<dumpOp.operands.len:
                            dumpOperands = Fmt"{dumpOperands},{dumpOp.operands[dumpOperandIndex]}"
                        var dumpCallOrdinal = -1
                        if dumpOp.kind == coreir.BodyOpCallTag &&
                           dumpOp.operands.len == 1:
                            dumpCallOrdinal = dumpOp.operands[0]
                        var dumpConsumes = ""
                        if dumpCallOrdinal >= 0 &&
                           dumpCallOrdinal < bodyIR.callSequence.len:
                            let dumpFactStart =
                                table.opFactStarts[dumpOpIndex]
                            let dumpFactCount =
                                table.opFactCounts[dumpOpIndex]
                            for dumpFactOffset in 0..<dumpFactCount:
                                let dumpFact = table.facts[
                                    dumpFactStart + dumpFactOffset]
                                if dumpFact.exactCallArgRow >= 0 &&
                                   dumpFact.consumesDefinition:
                                    var dumpAlive = "dead"
                                    if dumpFact.slotIndex >= 0 &&
                                       dumpFact.slotIndex < states.len &&
                                       states[dumpFact.slotIndex] >= 0:
                                        dumpAlive = "alive"
                                    dumpConsumes = Fmt"{dumpConsumes}c{dumpFact.fixedOrdinal}:s{dumpFact.slotIndex}:d{dumpFact.definitionRow}({dumpAlive})"
                        wall128Dump = Fmt"{wall128Dump}|o{dumpOpIndex}:k{Int32(dumpOp.kind)}:t{dumpOp.target}:vd{Int32(dumpOp.valueDefOwnership)}:src{dumpOp.sourceDefinitionRow}:act{dumpOp.consumeActionRow}:ops{dumpOp.operands.len}{dumpOperands}{dumpConsumes}"
                    os.WriteLine(
                        os.GetStderr(),
                        Fmt"phase=wall128_cfg_kill_dump fail_op={opIndex} fail_slot={fact.slotIndex} fail_state={states[fact.slotIndex]} ops={wall128Dump}")
                    bodyIrAccessFailPhase(
                        table, 4746,
                        BodyIrAccessErrorOwnership,
                        BodyIrAccessSiteOp,
                        opIndex,
                        fact.slotIndex)
                    return false
                if fact.exactCallArgRow >= 0:
                    let definitionOrdinal =
                        BodyIrAccessManagedDefinitionOrdinal(
                            index,
                            fact.definitionDomain,
                            fact.definitionRow)
                    if definitionOrdinal < 0 ||
                       index.definitionSlotsByOrdinal[
                           definitionOrdinal] != fact.slotIndex ||
                       states[fact.slotIndex] != definitionOrdinal:
                        bodyIrAccessFailPhase(
                            table, 4763,
                            BodyIrAccessErrorOwnership,
                            BodyIrAccessSiteOp,
                            opIndex,
                            fact.definitionRow)
                        return false
            let op = bodyIR.ops[opIndex]
            if !bodyIrAccessDefinitionPairIsInvalid(
                   op.sourceDefinitionDomain,
                   op.sourceDefinitionRow):
                let sourceOrdinal =
                    BodyIrAccessManagedDefinitionOrdinal(
                        index,
                        op.sourceDefinitionDomain,
                        op.sourceDefinitionRow)
                if sourceOrdinal < 0:
                    bodyIrAccessFailPhase(
                        table, 4780,
                        BodyIrAccessErrorOwnership,
                        BodyIrAccessSiteOp,
                        opIndex,
                        op.sourceDefinitionRow)
                    return false
                let sourceSlot =
                    index.definitionSlotsByOrdinal[
                        sourceOrdinal]
                if states[sourceSlot] != sourceOrdinal:
                    bodyIrAccessFailPhase(
                        table, 4791,
                        BodyIrAccessErrorOwnership,
                        BodyIrAccessSiteOp,
                        opIndex,
                        sourceSlot)
                    return false
            if !bodyIrAccessCfgApplyOpTransfers(
                   bodyIR, table, index, cfg,
                   opIndex, states, true):
                return false
        let termIndex = block.termIndex
        let termFactStart =
            table.termFactStarts[termIndex]
        let termFactCount =
            table.termFactCounts[termIndex]
        for factOffset in 0..<termFactCount:
            let fact =
                table.facts[termFactStart + factOffset]
            if fact.kind == BodyIrAccessFactDef ||
               fact.slotIndex < 0 ||
               fact.slotIndex >=
                   bodyIR.localSlots.len ||
               index.managedDefinitionCountBySlot[
                   fact.slotIndex] <= 0:
                continue
            if states[fact.slotIndex] < 0:
                bodyIrAccessFailPhase(
                    table, 4818,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteTerm,
                    termIndex,
                    fact.slotIndex)
                return false
        let term = bodyIR.terms[termIndex]
        for slot in 0..<states.len:
            let definitionOrdinal = states[slot]
            if definitionOrdinal < 0:
                continue
            let borrowOwnerOrdinal =
                index.borrowOwnerDefinitionOrdinals[
                    definitionOrdinal]
            if borrowOwnerOrdinal < 0:
                continue
            let ownerSlot =
                index.definitionSlotsByOrdinal[
                    borrowOwnerOrdinal]
            if states[ownerSlot] != borrowOwnerOrdinal:
                bodyIrAccessFailPhase(
                    table, 4839,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteTerm,
                    termIndex,
                    borrowOwnerOrdinal)
                return false
        if !bodyIrAccessDefinitionPairIsInvalid(
               term.sourceDefinitionDomain,
               term.sourceDefinitionRow):
            let sourceOrdinal =
                BodyIrAccessManagedDefinitionOrdinal(
                    index,
                    term.sourceDefinitionDomain,
                    term.sourceDefinitionRow)
            if sourceOrdinal < 0:
                bodyIrAccessFailPhase(
                    table, 4855,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteTerm,
                    termIndex,
                    term.sourceDefinitionRow)
                return false
            let sourceSlot =
                index.definitionSlotsByOrdinal[
                    sourceOrdinal]
            if states[sourceSlot] != sourceOrdinal:
                bodyIrAccessFailPhase(
                    table, 4866,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteTerm,
                    termIndex,
                    sourceOrdinal)
                return false
        let rowStart =
            blockId * bodyIR.localSlots.len
        for slot in 0..<bodyIR.localSlots.len:
            if states[slot] !=
                   cfg.blockEndStates[rowStart + slot]:
                bodyIrAccessFailPhase(
                    table, 4878,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteEntry,
                    blockId,
                    slot)
                return false
    for row in 0..<bodyIR.manualConsume.callOrdinals.len:
        let opIndex =
            bodyIrAccessManualPostCallOpIndex(
                bodyIR, row)
        if opIndex < 0 ||
           !cfg.blockReached[
               cfg.opBlockIds[opIndex]]:
            bodyIrAccessFailPhase(
                table, 4892,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                opIndex,
                row)
            return false
    return true

@borrows
fn bodyIrAccessVerifyManualConsumeDefinitions(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        index: var BodyIrAccessManagedDefinitionIndex): bool =
    let rowCount =
        bodyIR.manualConsume.callOrdinals.len
    if table.manualConsumeTargetConsumeFactIndices.len !=
           rowCount ||
       table.manualConsumeSourceConsumeFactIndices.len !=
           rowCount ||
       table.manualConsumePostDefinitionFactIndices.len !=
           rowCount:
        bodyIrAccessFailPhase(table, 4914,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteEntry,
                         BodyIrAccessNoIndex,
                         rowCount)
        return false
    var manualConsumedByDefinition: int32[]
    for _ in 0..<index.definitionDomains.len:
        add(manualConsumedByDefinition, -1)
    for row in 0..<rowCount:
        let callOrdinal =
            bodyIR.manualConsume.callOrdinals[row]
        let targetFactIndex =
            table.manualConsumeTargetConsumeFactIndices[row]
        let sourceFactIndex =
            table.manualConsumeSourceConsumeFactIndices[row]
        let postFactIndex =
            table.manualConsumePostDefinitionFactIndices[row]
        let callOpIndex =
            bodyIrAccessManualPostCallOpIndex(bodyIR, row)
        let targetDefinitionOrdinal =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                bodyIR.manualConsume.targetDefinitionDomains[row],
                bodyIR.manualConsume.targetDefinitionRows[row])
        let sourceDefinitionOrdinal =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                bodyIR.manualConsume.sourceDefinitionDomains[row],
                bodyIR.manualConsume.sourceDefinitionRows[row])
        let postDefinitionOrdinal =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                coreir.BodyDefinitionDomainManualConsumePostCallTag,
                row)
        if callOrdinal < 0 ||
           callOrdinal >=
               table.manualConsumeRowByCallOrdinal.len ||
           table.manualConsumeRowByCallOrdinal[
               callOrdinal] != row ||
           targetFactIndex < 0 ||
           targetFactIndex >= table.facts.len ||
           sourceFactIndex < 0 ||
           sourceFactIndex >= table.facts.len ||
           postFactIndex < 0 ||
           postFactIndex >= table.facts.len ||
           targetFactIndex == sourceFactIndex ||
           targetFactIndex == postFactIndex ||
           sourceFactIndex == postFactIndex ||
           callOpIndex < 0 ||
           targetDefinitionOrdinal < 0 ||
           sourceDefinitionOrdinal < 0 ||
           postDefinitionOrdinal < 0 ||
           targetDefinitionOrdinal ==
               sourceDefinitionOrdinal ||
           targetDefinitionOrdinal ==
               postDefinitionOrdinal ||
           sourceDefinitionOrdinal ==
               postDefinitionOrdinal ||
           !bodyIrAccessDefinitionPairShapeValid(
               bodyIR,
               bodyIR.manualConsume.targetDefinitionDomains[row],
               bodyIR.manualConsume.targetDefinitionRows[row]) ||
           !bodyIrAccessDefinitionPairShapeValid(
               bodyIR,
               bodyIR.manualConsume.sourceDefinitionDomains[row],
               bodyIR.manualConsume.sourceDefinitionRows[row]) ||
           manualConsumedByDefinition[
               targetDefinitionOrdinal] >= 0 ||
           manualConsumedByDefinition[
               sourceDefinitionOrdinal] >= 0 ||
           bodyIR.callSequence[
               callOrdinal].semanticCallExprNodeIndex < 0 ||
           bodyIR.manualConsume.snapshotCallIds[row] < 0 ||
           !coreir.BodyIRTypeArenaArtifactCidValid(
               bodyIR.manualConsume.bridgeCids[row]):
            bodyIrAccessFailPhase(table, 4990,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             BodyIrAccessNoIndex,
                             row)
            return false
        for priorRow in 0..<row:
            let priorCallOrdinal =
                bodyIR.manualConsume.callOrdinals[priorRow]
            if bodyIR.manualConsume.snapshotCallIds[
                   priorRow] ==
                   bodyIR.manualConsume.snapshotCallIds[row] ||
               bodyIR.callSequence[priorCallOrdinal].semanticCallExprNodeIndex ==
                   bodyIR.callSequence[callOrdinal].semanticCallExprNodeIndex ||
               layout.FixedBytes32Equal(
                   bodyIR.manualConsume.bridgeCids[
                       priorRow],
                   bodyIR.manualConsume.bridgeCids[row]):
                bodyIrAccessFailPhase(
                    table, 5008,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    callOpIndex,
                    row)
                return false
        manualConsumedByDefinition[
            targetDefinitionOrdinal] = row
        manualConsumedByDefinition[
            sourceDefinitionOrdinal] = row
        if table.facts[targetFactIndex].kind !=
               BodyIrAccessFactAddress ||
           !table.facts[targetFactIndex].consumesDefinition ||
           table.facts[targetFactIndex].manualConsumeRow != row ||
           table.facts[targetFactIndex].callOrdinal !=
               callOrdinal ||
           table.facts[targetFactIndex].slotIndex !=
               bodyIR.manualConsume.targetPlaceSlotIds[row] ||
           table.facts[targetFactIndex].addressOwnerSlot !=
               bodyIR.manualConsume.targetOwnerSlotIds[row] ||
           table.facts[targetFactIndex].definitionDomain !=
               bodyIR.manualConsume.targetDefinitionDomains[row] ||
           table.facts[targetFactIndex].definitionRow !=
               bodyIR.manualConsume.targetDefinitionRows[row]:
            bodyIrAccessFailPhase(table, 5033,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             table.facts[
                                 targetFactIndex].siteIndex,
                             row)
            return false
        if table.facts[sourceFactIndex].kind !=
               BodyIrAccessFactUse ||
           !table.facts[sourceFactIndex].consumesDefinition ||
           table.facts[sourceFactIndex].manualConsumeRow != row ||
           table.facts[sourceFactIndex].callOrdinal !=
               callOrdinal ||
           table.facts[sourceFactIndex].slotIndex !=
               bodyIR.manualConsume.sourcePlaceSlotIds[row] ||
           table.facts[sourceFactIndex].definitionDomain !=
               bodyIR.manualConsume.sourceDefinitionDomains[row] ||
           table.facts[sourceFactIndex].definitionRow !=
               bodyIR.manualConsume.sourceDefinitionRows[row]:
            bodyIrAccessFailPhase(table, 5052,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             table.facts[
                                 sourceFactIndex].siteIndex,
                             row)
            return false
        if table.facts[postFactIndex].kind !=
               BodyIrAccessFactDef ||
           table.facts[postFactIndex].consumesDefinition ||
           table.facts[postFactIndex].manualConsumeRow != row ||
           table.facts[postFactIndex].callOrdinal !=
               callOrdinal ||
           table.facts[postFactIndex].slotIndex !=
               bodyIR.manualConsume.targetOwnerSlotIds[row] ||
           table.facts[postFactIndex].definitionDomain !=
               coreir.BodyDefinitionDomainManualConsumePostCallTag ||
           table.facts[postFactIndex].definitionRow != row:
            bodyIrAccessFailPhase(table, 5070,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             table.facts[
                                 postFactIndex].siteIndex,
                             row)
            return false
        var targetConsumeCount: int32
        var sourceConsumeCount: int32
        var postDefinitionCount: int32
        for factIndex in 0..<table.facts.len:
            if table.facts[factIndex].consumesDefinition &&
               table.facts[factIndex].definitionDomain ==
                   bodyIR.manualConsume.targetDefinitionDomains[row] &&
               table.facts[factIndex].definitionRow ==
                   bodyIR.manualConsume.targetDefinitionRows[row]:
                targetConsumeCount =
                    targetConsumeCount + 1
            if table.facts[factIndex].consumesDefinition &&
               table.facts[factIndex].definitionDomain ==
                   bodyIR.manualConsume.sourceDefinitionDomains[row] &&
               table.facts[factIndex].definitionRow ==
                   bodyIR.manualConsume.sourceDefinitionRows[row]:
                sourceConsumeCount =
                    sourceConsumeCount + 1
            if !table.facts[factIndex].consumesDefinition &&
               table.facts[factIndex].kind ==
                   BodyIrAccessFactDef &&
               table.facts[factIndex].definitionDomain ==
                   coreir.BodyDefinitionDomainManualConsumePostCallTag &&
               table.facts[factIndex].definitionRow == row:
                postDefinitionCount =
                    postDefinitionCount + 1
        if targetConsumeCount != 1 ||
           sourceConsumeCount != 1 ||
           postDefinitionCount != 1:
            bodyIrAccessFailPhase(table, 5106,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             table.facts[
                                 postFactIndex].siteIndex,
                             row)
            return false
    return true

@borrows
fn bodyIrAccessVerifyManagedValueDefinitions(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable): bool =
    # One deterministic event index replaces all definition×fact/op scans.  The
    # power-of-two open-addressed tables resolve every collision by exact
    # int32 tuple comparison; no name/text identity participates.
    var replayIndex: BodyIrAccessDeferReplayIndex
    if !bodyIrAccessBuildDeferReplayIndex(
           bodyIR, table, replayIndex):
        return false
    var index: BodyIrAccessManagedDefinitionIndex
    if !bodyIrAccessBuildManagedDefinitionIndex(bodyIR, table, index):
        return false
    if !bodyIrAccessVerifyManualConsumeDefinitions(
           bodyIR, table, index):
        return false
    if !bodyIrAccessVerifyExplicitDefinitionEdges(
            bodyIR, table, index):
        return false
    for defOpIndex in 0..<bodyIR.ops.len:
        let defOp = bodyIrAccessOpAt(
            bodyIR, defOpIndex)
        if defOp.valueDefOwnership == coreir.OwnInvalid:
            let explicitConsumer =
                !bodyIrAccessDefinitionPairIsInvalid(
                    defOp.sourceDefinitionDomain,
                    defOp.sourceDefinitionRow) &&
                (defOp.kind == coreir.BodyOpReturnTag ||
                 defOp.kind == coreir.BodyOpCallTag)
            var exactNonConsumingManagedReplace: bool
            if explicitConsumer &&
               defOp.kind == coreir.BodyOpCallTag &&
               defOp.operands.len == 1 &&
               defOp.operands[0] >= 0 &&
               defOp.operands[0] <
                   bodyIR.callSequence.len:
                let sourceCall =
                    bodyIR.callSequence[defOp.operands[0]]
                exactNonConsumingManagedReplace =
                    bodyIrAccessManagedRetainStoreKindExact(
                        sourceCall.managedStoreKind) &&
                    bodyIrAccessDefinitionPairEqual(
                        sourceCall.sourceDefinitionDomain,
                        sourceCall.sourceDefinitionRow,
                        defOp.sourceDefinitionDomain,
                        defOp.sourceDefinitionRow) &&
                    sourceCall.consumeActionRow == -1 &&
                    defOp.consumeActionRow == -1
            if defOp.valueDefSlot != -1 ||
               defOp.valueDefExprNodeIndex != -1 ||
               defOp.valueDefSemanticRow != -1 ||
               defOp.valueDefBorrowOwnerSemanticRow != -1 ||
               !bodyIrAccessDefinitionPairIsInvalid(
                   defOp.valueDefBorrowOwnerDefinitionDomain,
                   defOp.valueDefBorrowOwnerDefinitionRow) ||
               defOp.valueDefConsumeOpIndexPlusOne != 0 ||
               defOp.valueDefOriginKind !=
                   coreir.BodyDefinitionOriginUnknownTag ||
               defOp.valueDefOriginId != -1 ||
               (!explicitConsumer &&
                !bodyIrAccessDefinitionPairIsInvalid(
                    defOp.sourceDefinitionDomain,
                    defOp.sourceDefinitionRow)) ||
               (explicitConsumer &&
                defOp.kind == coreir.BodyOpCallTag &&
                defOp.consumeActionRow < 0 &&
                !exactNonConsumingManagedReplace) ||
               (explicitConsumer &&
                defOp.kind == coreir.BodyOpReturnTag &&
                defOp.consumeActionRow != -1):
                bodyIrAccessFailPhase(table, 5186,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteOp,
                                 defOpIndex,
                                 defOp.valueDefOriginKind)
                return false
            continue
        # [wall108r3] 非托管纯值定义 admit（第三道门）。本枚举门及其后
        # 的托管 def 权威审按 OwnMove/OwnBorrowShared 转移语义构建；
        # OwnPlain+TypedExpr 纯值定义形（全哨兵联立，与 decodeCallOrdinal
        # /VerifyExplicitDefinitionEdges 两 admit 同形）∧ 槽
        # Unmanaged+tid>=0 时无所有权转移无 cleanup 义务，def 在值语义
        # 下自洽，本函数剩余审不适用。任一列不符即走原枚举门原判词
        # fail-closed。判词四元组（code=15/site=Op/detail=OwnPlain）与
        # decode 入口墙同构，index 语义不同（defOpIndex vs op 循环同一
        # op），归因时以 r2/r4 单调推进实录为准。禁止提取共享 helper
        # （[wall108r2] 警示同款）。
        if bodyIR.ops[defOpIndex].valueDefOwnership == coreir.OwnPlain &&
           bodyIR.ops[defOpIndex].valueDefOriginKind ==
               coreir.BodyDefinitionOriginTypedExprTag &&
           bodyIR.ops[defOpIndex].valueDefOriginId == bodyIR.ops[defOpIndex].valueDefSemanticRow &&
           bodyIR.ops[defOpIndex].valueDefOriginId >= 0 &&
           bodyIR.ops[defOpIndex].valueDefExprNodeIndex >= 0 &&
           bodyIR.ops[defOpIndex].valueDefBorrowOwnerSemanticRow == -1 &&
           bodyIR.ops[defOpIndex].valueDefBorrowOwnerDefinitionDomain ==
               coreir.BodyDefinitionDomainInvalidTag &&
           bodyIR.ops[defOpIndex].valueDefBorrowOwnerDefinitionRow == -1 &&
           bodyIrAccessDefinitionPairIsInvalid(
               bodyIR.ops[defOpIndex].sourceDefinitionDomain,
               bodyIR.ops[defOpIndex].sourceDefinitionRow) &&
           bodyIR.ops[defOpIndex].consumeActionRow == -1 &&
           bodyIrAccessLocalValid(bodyIR, bodyIR.ops[defOpIndex].valueDefSlot) &&
           bodyIR.localSlots[bodyIR.ops[defOpIndex].valueDefSlot].managedStorageKind ==
               coreir.BodyManagedStorageUnmanagedTag &&
           bodyIR.localSlots[bodyIR.ops[defOpIndex].valueDefSlot].typeArenaTypeId >= 0:
            continue
        if defOp.valueDefOwnership != coreir.OwnMove &&
           defOp.valueDefOwnership != coreir.OwnBorrowShared:
            bodyIrAccessFailPhase(table, 5224,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             defOpIndex,
                             int32(defOp.valueDefOwnership))
            return false
        let typedOrigin =
            defOp.valueDefOriginKind ==
                coreir.BodyDefinitionOriginTypedExprTag
        let cleanupOrigin =
            defOp.valueDefOriginKind ==
                coreir.BodyDefinitionOriginCanonicalCleanupActionTag
        var typedBorrowOwnerValid = true
        var typedBorrowOwnerOrdinal = BodyIrAccessNoIndex
        if typedOrigin &&
           defOp.valueDefOwnership == coreir.OwnBorrowShared:
            typedBorrowOwnerValid = false
            typedBorrowOwnerOrdinal =
                BodyIrAccessManagedDefinitionOrdinal(
                    index,
                    defOp.valueDefBorrowOwnerDefinitionDomain,
                    defOp.valueDefBorrowOwnerDefinitionRow)
            if defOp.valueDefBorrowOwnerSemanticRow >= 0 &&
               typedBorrowOwnerOrdinal >= 0 &&
               bodyIrAccessDefinitionPairShapeValid(
                   bodyIR,
                   defOp.valueDefBorrowOwnerDefinitionDomain,
                   defOp.valueDefBorrowOwnerDefinitionRow) &&
               !(defOp.valueDefBorrowOwnerDefinitionDomain ==
                     coreir.BodyDefinitionDomainBodyOpTag &&
                 defOp.valueDefBorrowOwnerDefinitionRow == defOpIndex):
                let ownerOwnership =
                    index.definitionOwnershipKindsByOrdinal[
                        typedBorrowOwnerOrdinal]
                var ownerSemanticRow: int32 = -1
                if defOp.valueDefBorrowOwnerDefinitionDomain ==
                       coreir.BodyDefinitionDomainEntrySlotTag:
                    ownerSemanticRow =
                        bodyIR.entryDefinitionSemanticRows[
                            defOp.valueDefBorrowOwnerDefinitionRow]
                    # [wall82] 借主为 [w61/w77] borrowed-view 参数槽时，入
                    # 口所有权可为 BorrowUnique（可变 `var T` 视图冻结形，
                    # mg==Unmanaged）；共享借读单调弱于唯一借，def 自身仍
                    # 须 OwnBorrowShared，跨函数逃逸仍被 return 边守卫拒
                    # 绝。ownerSemanticRow==借主语义行校验原样保留。
                    # [wall121b] 不可变 Owned 托管形参借主 admit：冻结权
                    # 威臂（LoweringBodyIrFreezeEntryDefinitionOwnership，
                    # lowering_plan）对 managed∧Owned 形参恒盖 OwnMove
                    # （mutable 即 panic "mutable managed parameter is
                    # owned"），OwnMove 入口=不可变 Owned 托管形参的唯一
                    # 冻结形；typed_expr canonical 裁定 Owned 行自身即借
                    # 主权威。[wall82] 注册臂已把 mg==Managed∧OwnMove 入
                    # 口注册为托管定义，下方 BodyOp 借主臂同认 OwnMove 借
                    # 主，EntrySlot 臂漏该形系缺臂非禁形（cold_nested 实
                    # 证：def=FieldLoad Shared 借视 name:str，探针 tbov=0
                    # 唯一假支 + eo0=2 + owner_ord=0 + esem==bo_sem）。
                    # 共享借视 def 仍 OwnBorrowShared 最弱主张；借主不可
                    # 变=全函数体持有，单调强于已 admit 的 BorrowUnique
                    # 可变视图。ordinal>=0（已注册托管定义）∧ pairShape
                    # Valid ∧ 非自身 ∧ ownerSemanticRow 恒等联立原样保留，
                    # return 边逃逸守卫零触碰；mg==Managed 联立自证 owned
                    # 入口存储真相（OwnMove+Unmanaged 形在 [wall82] 注册
                    # 臂即 ordinal<0 拒，此处双保险 fail-closed）。禁止提
                    # 取共享 helper（[wall108r2] 警示同款）。
                    typedBorrowOwnerValid =
                        ownerOwnership == int32(coreir.OwnBorrowShared) ||
                        ownerOwnership == int32(coreir.OwnBorrowUnique) ||
                        (ownerOwnership == int32(coreir.OwnMove) &&
                         bodyIR.localSlots[defOp.valueDefBorrowOwnerDefinitionRow].managedStorageKind ==
                             coreir.BodyManagedStorageManagedTag)
                elif defOp.valueDefBorrowOwnerDefinitionDomain ==
                         coreir.BodyDefinitionDomainBodyOpTag:
                    let ownerOp =
                        bodyIR.ops[
                            defOp.valueDefBorrowOwnerDefinitionRow]
                    ownerSemanticRow =
                        ownerOp.valueDefSemanticRow
                    typedBorrowOwnerValid =
                        ownerOwnership == int32(coreir.OwnMove) ||
                        (ownerOwnership ==
                             int32(coreir.OwnBorrowShared) &&
                         bodyIrAccessIndexedAddressIsNonConsumingExact(
                             bodyIR, ownerOp))
                typedBorrowOwnerValid =
                    typedBorrowOwnerValid &&
                    ownerSemanticRow ==
                        defOp.valueDefBorrowOwnerSemanticRow
        elif defOp.valueDefBorrowOwnerSemanticRow != -1 ||
             !bodyIrAccessDefinitionPairIsInvalid(
                 defOp.valueDefBorrowOwnerDefinitionDomain,
                 defOp.valueDefBorrowOwnerDefinitionRow):
            typedBorrowOwnerValid = false
        var typedOwnedCallMirrorValid = true
        if typedOrigin &&
           (defOp.valueDefOwnership == coreir.OwnMove ||
            defOp.kind == coreir.BodyOpCallTag):
            typedOwnedCallMirrorValid = false
            if defOp.kind == coreir.BodyOpCallTag &&
               defOp.operands.len == 1 &&
               defOp.operands[0] >= 0 &&
               defOp.operands[0] < bodyIR.callSequence.len:
                let call = bodyIR.callSequence[defOp.operands[0]]
                typedOwnedCallMirrorValid =
                    call.resultSlot == defOp.valueDefSlot &&
                    call.resultOwnership == defOp.valueDefOwnership &&
                    call.resultExprNodeIndex ==
                        defOp.valueDefExprNodeIndex &&
                    call.resultValueDefinitionRow ==
                        defOp.valueDefSemanticRow &&
                    call.resultBorrowOwnerValueDefinitionRow ==
                        defOp.valueDefBorrowOwnerSemanticRow &&
                    call.resultBorrowOwnerDefinitionDomain ==
                        defOp.valueDefBorrowOwnerDefinitionDomain &&
                    call.resultBorrowOwnerDefinitionRow ==
                        defOp.valueDefBorrowOwnerDefinitionRow &&
                    call.resultDefinitionOriginKind ==
                        defOp.valueDefOriginKind &&
                    call.resultDefinitionOriginId ==
                        defOp.valueDefOriginId &&
                    bodyIrAccessDefinitionPairIsInvalid(
                        defOp.sourceDefinitionDomain,
                        defOp.sourceDefinitionRow) &&
                    bodyIrAccessDefinitionPairIsInvalid(
                        call.sourceDefinitionDomain,
                        call.sourceDefinitionRow) &&
                    call.consumeActionRow == -1 &&
                    (call.resultPassKind ==
                         coreir.BodyCallPassStackValueTag ||
                     call.resultPassKind ==
                         coreir.BodyCallPassSretResultTag)
        let typedIndexedAddressSourceValid =
            typedOrigin &&
            defOp.kind == coreir.BodyOpLoadLocalTag &&
            ((defOp.operands.len == 5 &&
              defOp.operands[0] ==
                  coreir.BodyLoadLocalIndexedAddressTag) ||
             (defOp.operands.len == 4 &&
              defOp.operands[0] ==
                  coreir.BodyLoadLocalFieldAddressTag)) &&
            defOp.valueDefOwnership == coreir.OwnBorrowShared &&
            bodyIrAccessDefinitionPairEqual(
                defOp.sourceDefinitionDomain,
                defOp.sourceDefinitionRow,
                defOp.valueDefBorrowOwnerDefinitionDomain,
                defOp.valueDefBorrowOwnerDefinitionRow) &&
            defOp.operands[1] ==
                bodyIrAccessDefinitionSlot(
                    bodyIR,
                    defOp.sourceDefinitionDomain,
                    defOp.sourceDefinitionRow)
        let sourceDefinitionValid =
            (typedOrigin &&
             (bodyIrAccessDefinitionPairIsInvalid(
                  defOp.sourceDefinitionDomain,
                  defOp.sourceDefinitionRow) ||
              typedIndexedAddressSourceValid)) ||
            (cleanupOrigin &&
             bodyIrAccessDefinitionPairShapeValid(
                 bodyIR,
                 defOp.sourceDefinitionDomain,
                 defOp.sourceDefinitionRow) &&
             defOp.valueDefSemanticRow ==
                 bodyIrAccessDefinitionSemanticRow(
                     bodyIR,
                     defOp.sourceDefinitionDomain,
                     defOp.sourceDefinitionRow))
        var cleanupDefinitionShapeValid = true
        if cleanupOrigin:
            if !bodyIrAccessDefinitionPairShapeValid(
                   bodyIR,
                   defOp.sourceDefinitionDomain,
                   defOp.sourceDefinitionRow):
                cleanupDefinitionShapeValid = false
            else:
                let sourceDefinitionSlot =
                    bodyIrAccessDefinitionSlot(
                        bodyIR,
                        defOp.sourceDefinitionDomain,
                        defOp.sourceDefinitionRow)
                var consumingDefinition =
                    defOp.consumeActionRow >= 0
                if defOp.sourceDefinitionDomain ==
                       coreir.BodyDefinitionDomainBodyOpTag:
                    consumingDefinition =
                        bodyIR.ops[defOp.sourceDefinitionRow].valueDefConsumeOpIndexPlusOne ==
                            defOpIndex + 1
                var exactProjectedSource: bool
                if defOp.kind == coreir.BodyOpCopyLocalTag &&
                   defOp.operands.len == 1 &&
                   bodyIrAccessLocalValid(bodyIR, defOp.operands[0]):
                    let projection =
                        bodyIR.localSlots[defOp.operands[0]]
                    exactProjectedSource =
                        projection.placeKind ==
                            coreir.BodyPlaceBorrowAddressTag &&
                        projection.auxValue ==
                            sourceDefinitionSlot
                cleanupDefinitionShapeValid =
                    (consumingDefinition &&
                     ((defOp.kind == coreir.BodyOpCopyLocalTag &&
                       defOp.operands.len == 1 &&
                       ((defOp.operands[0] ==
                             sourceDefinitionSlot &&
                         defOp.valueDefExprNodeIndex == -1) ||
                        (exactProjectedSource &&
                         defOp.valueDefExprNodeIndex == -1))) ||
                      (defOp.kind == coreir.BodyOpCallTag &&
                       defOp.valueDefExprNodeIndex >= 0))) ||
                    (!consumingDefinition &&
                     ((defOp.kind == coreir.BodyOpCopyLocalTag &&
                       defOp.operands.len == 1 &&
                       ((defOp.operands[0] ==
                             sourceDefinitionSlot &&
                         defOp.valueDefExprNodeIndex >= 0 &&
                         index.retainedDerivationByOp[defOpIndex]) ||
                        (exactProjectedSource &&
                         defOp.valueDefExprNodeIndex == -1))) ||
                      (defOp.kind == coreir.BodyOpCallTag &&
                       defOp.operands.len == 1 &&
                       defOp.valueDefExprNodeIndex >= 0 &&
                       defOp.operands[0] >= 0 &&
                       defOp.operands[0] <
                           bodyIR.callSequence.len &&
                       bodyIrAccessManagedSnapshotKindExact(
                           bodyIR.callSequence[
                               defOp.operands[0]].managedStoreKind))))
        if !bodyIrAccessLocalValid(bodyIR, defOp.valueDefSlot) ||
           defOp.valueDefSemanticRow < 0 ||
           (!typedOrigin && !cleanupOrigin) ||
           defOp.valueDefOriginId < 0 ||
           !index.hasMatchingDefinitionFactByOp[defOpIndex] ||
           (typedOrigin &&
            (defOp.valueDefExprNodeIndex < 0 ||
             defOp.valueDefOriginId !=
                 defOp.valueDefSemanticRow)) ||
           !typedBorrowOwnerValid ||
           !typedOwnedCallMirrorValid ||
           !sourceDefinitionValid ||
           !cleanupDefinitionShapeValid:
            bodyIrAccessFailPhase(table, 5463,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             defOpIndex,
                             defOp.valueDefSlot)
            return false
        if !bodyIrAccessIndexManagedDefinition(
                index, replayIndex,
                defOp, defOpIndex, table):
            return false
        let defDefinitionOrdinal =
            BodyIrAccessManagedDefinitionOrdinal(
                index,
                coreir.BodyDefinitionDomainBodyOpTag,
                defOpIndex)
        if defDefinitionOrdinal < 0:
            bodyIrAccessFailPhase(
                table, 5479,
                BodyIrAccessErrorOwnership,
                BodyIrAccessSiteOp,
                defOpIndex,
                defOpIndex)
            return false
        if defOp.valueDefOwnership == coreir.OwnBorrowShared:
            index.borrowOwnerDefinitionOrdinals[
                defDefinitionOrdinal] =
                    typedBorrowOwnerOrdinal
            if defOp.valueDefConsumeOpIndexPlusOne != 0:
                bodyIrAccessFailPhase(table, 5491,
                                 BodyIrAccessErrorOwnership,
                                 BodyIrAccessSiteOp,
                                 defOpIndex,
                                 defOp.valueDefConsumeOpIndexPlusOne)
                return false
            continue
        if defOp.valueDefConsumeOpIndexPlusOne == 0:
            let appendOnlyMoveOp =
                index.managedMoveStoreOpByDefinition[
                    defDefinitionOrdinal]
            if appendOnlyMoveOp >= 0:
                if index.explicitSourceOpCountByDefinition[
                       defDefinitionOrdinal] != 1 ||
                   index.returnConsumeTermCountByDefinition[
                       defDefinitionOrdinal] != 0 ||
                   !bodyIrAccessAppendOnlyManagedMoveEventExact(
                       bodyIR,
                       appendOnlyMoveOp,
                       bodyIR.ops[appendOnlyMoveOp]):
                    bodyIrAccessFailPhase(
                        table, 5511,
                        BodyIrAccessErrorOwnership,
                        BodyIrAccessSiteOp,
                        appendOnlyMoveOp,
                        defOpIndex)
                    return false
                continue
            # [wall116] 待物化 admit（OwnMove cp1==0 臂，wall108r3 同族
            # 第四道门）。primary 发射侧 primaryCleanupWillMaterialize
            # 扫描（OwnMove ∧ cp1==0 ∧ 非 manual-consume）命中即走
            # cleanup 物化路径，而本 decode 权威审是 ApplyOwned 第一步，
            # drop 单元与 consume link 回写要等同次 ApplyOwned 末尾
            # CleanupPlanMaterialize 才产生——管线时序矛盾（wall115 实
            # 锤），凡触发谓词的合法程序在此必死。本 admit 谓词逐列同构
            # 并收窄：TypedExpr 全戳 + Managed 槽 + 全哨兵列 + rtc==0 ∧
            # esc==0（恰为本墙形），命中即放行待物化；production 侧同
            # 谓词 RequireOwnedDefinition 复查 + 物化 + 末尾 final
            # decode 重审同一验证器 fail-closed，物化失约不可能静默逃
            # 逸。禁止提取共享 helper（[wall108r2] 警示同款）。
            var manualConsumeBound = false
            for manualConsumeRow in
                    0..<bodyIR.manualConsume.sourceDefinitionRows.len:
                if bodyIR.manualConsume.sourceDefinitionDomains[
                       manualConsumeRow] ==
                       coreir.BodyDefinitionDomainBodyOpTag &&
                   bodyIR.manualConsume.sourceDefinitionRows[
                       manualConsumeRow] == defOpIndex:
                    manualConsumeBound = true
                    break
            # Manual-consume has its own sealed definition authority.  The
            # verifier above proved a unique consuming fact for this exact
            # definition; CFG replay below proves that definition reaches the
            # call.  A physical BodyOp row is therefore not a cp1 contract.
            if manualConsumeBound:
                continue
            if bodyIR.ops[defOpIndex].valueDefOwnership ==
                   coreir.OwnMove &&
               bodyIR.ops[defOpIndex].valueDefOriginKind ==
                   coreir.BodyDefinitionOriginTypedExprTag &&
               bodyIR.ops[defOpIndex].valueDefOriginId ==
                   bodyIR.ops[defOpIndex].valueDefSemanticRow &&
               bodyIR.ops[defOpIndex].valueDefOriginId >= 0 &&
               bodyIR.ops[defOpIndex].valueDefExprNodeIndex >= 0 &&
               bodyIR.ops[defOpIndex].consumeActionRow == -1 &&
               bodyIR.ops[defOpIndex].valueDefBorrowOwnerSemanticRow ==
                   -1 &&
               bodyIR.ops[defOpIndex].valueDefBorrowOwnerDefinitionDomain ==
                   coreir.BodyDefinitionDomainInvalidTag &&
               bodyIR.ops[defOpIndex].valueDefBorrowOwnerDefinitionRow ==
                   -1 &&
               bodyIrAccessDefinitionPairIsInvalid(
                   bodyIR.ops[defOpIndex].sourceDefinitionDomain,
                   bodyIR.ops[defOpIndex].sourceDefinitionRow) &&
               bodyIrAccessLocalValid(
                   bodyIR, bodyIR.ops[defOpIndex].valueDefSlot) &&
               bodyIR.localSlots[
                   bodyIR.ops[defOpIndex].valueDefSlot].managedStorageKind ==
                   coreir.BodyManagedStorageManagedTag &&
               bodyIR.localSlots[
                   bodyIR.ops[defOpIndex].valueDefSlot].typeArenaTypeId >=
                   0 &&
               index.returnConsumeTermCountByDefinition[
                   defDefinitionOrdinal] == 0 &&
               index.explicitSourceOpCountByDefinition[
                   defDefinitionOrdinal] == 0 &&
               !manualConsumeBound:
                continue
            # Owned values do not disappear at lexical scope end.  With no op
            # consume link, the only admitted transfer is an exact return-term
            # edge.  Missing release/return authority remains RED.
            let returnTermCount =
                index.returnConsumeTermCountByDefinition[
                    defDefinitionOrdinal]
            if returnTermCount <= 0 ||
               index.explicitSourceOpCountByDefinition[
                   defDefinitionOrdinal] != 0:
                bodyIrAccessFailPhase(
                    table, 5588,
                    BodyIrAccessErrorOwnership,
                    BodyIrAccessSiteOp,
                    defOpIndex,
                    index.lastReturnConsumeTermByDefinition[
                        defDefinitionOrdinal])
                return false
            continue
        let consumeOpIndex = defOp.valueDefConsumeOpIndexPlusOne - 1
        if consumeOpIndex < 0 ||
           consumeOpIndex >= bodyIR.ops.len:
            bodyIrAccessFailPhase(table, 5600,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             defOpIndex,
                             consumeOpIndex)
            return false
        let consumeOp = bodyIrAccessOpAt(
            bodyIR, consumeOpIndex)
        var canonicalConsume: bool
        var exactCallArgConsume: bool
        var canonicalConsumeAction = -1
        if consumeOp.kind == coreir.BodyOpCallTag &&
           consumeOp.operands.len == 1:
            let consumeCallOrdinal = consumeOp.operands[0]
            if consumeCallOrdinal >= 0 &&
               consumeCallOrdinal < bodyIR.callSequence.len:
                let consumeCall =
                    bodyIR.callSequence[consumeCallOrdinal]
                exactCallArgConsume =
                    BodyIrAccessOpExactCallArgConsumesBodyDefinition(
                        table, consumeOpIndex, defOpIndex) &&
                    !bodyIrAccessDefinitionPairEqual(
                        consumeOp.sourceDefinitionDomain,
                        consumeOp.sourceDefinitionRow,
                        coreir.BodyDefinitionDomainBodyOpTag,
                        defOpIndex) &&
                    !bodyIrAccessDefinitionPairEqual(
                        consumeCall.sourceDefinitionDomain,
                        consumeCall.sourceDefinitionRow,
                        coreir.BodyDefinitionDomainBodyOpTag,
                        defOpIndex)
                canonicalConsume = exactCallArgConsume ||
                    (bodyIrAccessDefinitionPairEqual(
                         consumeOp.sourceDefinitionDomain,
                         consumeOp.sourceDefinitionRow,
                         coreir.BodyDefinitionDomainBodyOpTag,
                         defOpIndex) &&
                     bodyIrAccessDefinitionPairEqual(
                         consumeCall.sourceDefinitionDomain,
                         consumeCall.sourceDefinitionRow,
                         coreir.BodyDefinitionDomainBodyOpTag,
                         defOpIndex) &&
                     bodyIrAccessCallUsesSourceSlotExact(
                         consumeCall, defOp.valueDefSlot))
                canonicalConsumeAction =
                    consumeCall.consumeActionRow
                if consumeOp.valueDefOwnership !=
                       coreir.OwnInvalid &&
                   consumeOp.valueDefOriginKind ==
                       coreir.BodyDefinitionOriginCanonicalCleanupActionTag:
                    canonicalConsumeAction =
                        consumeOp.valueDefOriginId
        elif consumeOp.kind == coreir.BodyOpCopyLocalTag &&
             consumeOp.operands.len == 1 &&
             consumeOp.valueDefOriginKind ==
                 coreir.BodyDefinitionOriginCanonicalCleanupActionTag &&
             bodyIrAccessDefinitionPairEqual(
                 consumeOp.sourceDefinitionDomain,
                 consumeOp.sourceDefinitionRow,
                 coreir.BodyDefinitionDomainBodyOpTag,
                 defOpIndex):
            let consumeSourceSlot = consumeOp.operands[0]
            canonicalConsume =
                consumeSourceSlot == defOp.valueDefSlot
            if !canonicalConsume &&
               bodyIrAccessLocalValid(bodyIR, consumeSourceSlot):
                let projection =
                    bodyIR.localSlots[consumeSourceSlot]
                canonicalConsume =
                    projection.placeKind ==
                        coreir.BodyPlaceBorrowAddressTag &&
                    projection.auxValue == defOp.valueDefSlot
            canonicalConsumeAction =
                consumeOp.valueDefOriginId
        elif consumeOp.kind == coreir.BodyOpReturnTag &&
             consumeOp.target == defOp.valueDefSlot &&
             bodyIrAccessDefinitionPairEqual(
                 consumeOp.sourceDefinitionDomain,
                 consumeOp.sourceDefinitionRow,
                 coreir.BodyDefinitionDomainBodyOpTag,
                 defOpIndex):
            canonicalConsume = true
        if !canonicalConsume ||
           (defOp.consumeActionRow >= 0 &&
            canonicalConsumeAction != defOp.consumeActionRow):
            bodyIrAccessFailPhase(table, 5685,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             consumeOpIndex,
                             consumeOp.kind)
            return false
        if consumeOp.kind == coreir.BodyOpCallTag &&
           bodyIrAccessManagedMoveStoreSourceSlot(
               bodyIR, consumeOp) >= 0 &&
           index.managedMoveStoreOpByDefinition[
               defDefinitionOrdinal] !=
               consumeOpIndex:
            bodyIrAccessFailPhase(table, 5697,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             consumeOpIndex,
                             defOp.valueDefSlot)
            return false
        let exactCallArgCountsValid =
            exactCallArgConsume &&
            index.explicitSourceOpCountByDefinition[
                defDefinitionOrdinal] == 0 &&
            index.returnConsumeTermCountByDefinition[
                defDefinitionOrdinal] == 0
        let scalarSourceCountsValid =
            !exactCallArgConsume &&
            index.explicitSourceOpCountByDefinition[
                defDefinitionOrdinal] == 1 &&
            index.lastExplicitSourceOpByDefinition[
                defDefinitionOrdinal] == consumeOpIndex &&
            index.returnConsumeTermCountByDefinition[
                defDefinitionOrdinal] == 0
        if !exactCallArgCountsValid && !scalarSourceCountsValid:
            bodyIrAccessFailPhase(table, 5718,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteOp,
                             consumeOpIndex,
                             defOp.valueDefSlot)
            return false
    return bodyIrAccessVerifyDefinitionCfg(
        bodyIR, table, index)

@borrows
fn BodyIrAccessDecode(bodyIR: coreir.BodyIR): BodyIrAccessTable =
    var table: BodyIrAccessTable
    table.valid = true
    if !coreir.BodyIREntryDefinitionOwnershipShapeValid(
           bodyIR) ||
       !coreir.BodyIRLocalBindingValueDefinitionRowsShapeValid(
           bodyIR) ||
       !bodyIR.entryDefinitionOwnershipSealed ||
       !coreir.BodyIRManualConsumeSidecarShapeValid(bodyIR) ||
       !coreir.BodyIRManagedLvalueReplaceSidecarShapeValid(bodyIR) ||
       !exactdef.BodyIrExactDefSidecarShapeValid(bodyIR):
        bodyIrAccessFailPhase(table, 5739,
                         BodyIrAccessErrorOwnership,
                         BodyIrAccessSiteEntry,
                         BodyIrAccessNoIndex,
                         coreir.BodyDefinitionDomainManualConsumePostCallTag)
        return table
    for slotIndex in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[slotIndex].id != slotIndex ||
           !bodyIrAccessLocalTypeValid(
               bodyIR.localSlots[slotIndex].typeKind) ||
           !bodyIrAccessPlaceKindValid(
               bodyIR.localSlots[slotIndex].placeKind) ||
           !coreir.BodyIRLocalSlotTypeArenaProofValid(
               bodyIR.localSlots[slotIndex]):
            bodyIrAccessFail(table, BodyIrAccessErrorLocalShape,
                             BodyIrAccessSiteEntry, slotIndex,
                             bodyIR.localSlots[slotIndex].id)
            return table
        let bindingDefinitionRow =
            bodyIR.localBindingValueDefinitionRows[slotIndex]
        let entrySemanticRow =
            bodyIR.entryDefinitionSemanticRows[slotIndex]
        if bindingDefinitionRow >= 0 && entrySemanticRow >= 0 &&
           bindingDefinitionRow != entrySemanticRow:
            bodyIrAccessFailPhase(table, 5763,
                             BodyIrAccessErrorOwnership,
                             BodyIrAccessSiteEntry,
                             slotIndex,
                             bindingDefinitionRow)
            return table
    for literalIndex in 0..<bodyIR.cstringLiterals.len:
        if bodyIR.cstringLiterals[literalIndex].id != literalIndex:
            bodyIrAccessFail(table, BodyIrAccessErrorLiteralRef,
                             BodyIrAccessSiteEntry, literalIndex,
                             bodyIR.cstringLiterals[literalIndex].id)
            return table
    for _ in 0..<bodyIR.localSlots.len:
        add(table.entryValueIdsBySlot, BodyIrAccessNoValue)
    for _ in 0..<bodyIR.ops.len:
        add(table.opFactStarts, BodyIrAccessNoIndex)
        add(table.opFactCounts, 0)
    for _ in 0..<bodyIR.terms.len:
        add(table.termFactStarts, BodyIrAccessNoIndex)
        add(table.termFactCounts, 0)
    for _ in 0..<bodyIR.callSequence.len:
        add(table.callFactStarts, BodyIrAccessNoIndex)
        add(table.callFactCounts, 0)
        add(table.callUseCounts, 0)
    if !bodyIrAccessBuildManualConsumeCallIndex(
           bodyIR, table):
        return table
    for callOrdinal in 0..<bodyIR.callSequence.len:
        add(table.callResultPassKinds,
            bodyIR.callSequence[callOrdinal].resultPassKind)
    # stackOffset<0 is the canonical BodyIR parameter marker.
    for slotIndex in 0..<bodyIR.localSlots.len:
        if bodyIR.localSlots[slotIndex].stackOffset < 0:
            let valueId = bodyIrAccessAppendDef(bodyIR,
                                                table,
                                                BodyIrAccessSiteEntry,
                                                slotIndex,
                                                slotIndex,
                                                BodyIrAccessFixedNone)
            if valueId < 0:
                return table
            table.entryValueIdsBySlot[slotIndex] = valueId
    for opIndex in 0..<bodyIR.ops.len:
        table.opFactStarts[opIndex] = table.facts.len
        if !bodyIrAccessDecodeOp(
               bodyIR, table, opIndex):
            return table
        table.opFactCounts[opIndex] = table.facts.len - table.opFactStarts[opIndex]
    for callOrdinal in 0..<bodyIR.callSequence.len:
        if table.callUseCounts[callOrdinal] != 1:
            bodyIrAccessFail(table,
                             BodyIrAccessErrorCallOrdinal,
                             BodyIrAccessSiteOp,
                             BodyIrAccessNoIndex,
                             callOrdinal)
            return table
    for termIndex in 0..<bodyIR.terms.len:
        table.termFactStarts[termIndex] = table.facts.len
        if !bodyIrAccessDecodeTerm(bodyIR, table, termIndex):
            return table
        table.termFactCounts[termIndex] = table.facts.len - table.termFactStarts[termIndex]
    if !bodyIrAccessVerifyManagedValueDefinitions(
           bodyIR, table):
        return table
    return table

fn BodyIrAccessTableIsValid(table: var BodyIrAccessTable): bool =
    return table.valid

fn BodyIrAccessManualConsumeTargetFactIndex(
        table: var BodyIrAccessTable,
        row: int32): int32 =
    if row < 0 ||
       row >=
           table.manualConsumeTargetConsumeFactIndices.len:
        return BodyIrAccessNoIndex
    return table.manualConsumeTargetConsumeFactIndices[row]

fn BodyIrAccessManualConsumeSourceFactIndex(
        table: var BodyIrAccessTable,
        row: int32): int32 =
    if row < 0 ||
       row >=
           table.manualConsumeSourceConsumeFactIndices.len:
        return BodyIrAccessNoIndex
    return table.manualConsumeSourceConsumeFactIndices[row]

fn BodyIrAccessManualConsumePostDefinitionFactIndex(
        table: var BodyIrAccessTable,
        row: int32): int32 =
    if row < 0 ||
       row >=
           table.manualConsumePostDefinitionFactIndices.len:
        return BodyIrAccessNoIndex
    return table.manualConsumePostDefinitionFactIndices[row]

fn BodyIrAccessOpExactCallArgConsumesBodyDefinition(
        table: var BodyIrAccessTable,
        opIndex: int32,
        definitionRow: int32): bool =
    if !table.valid ||
       opIndex < 0 || opIndex >= table.opFactStarts.len ||
       definitionRow < 0:
        return false
    let factStart = table.opFactStarts[opIndex]
    let factCount = table.opFactCounts[opIndex]
    if factStart < 0 || factCount < 0 ||
       factStart > table.facts.len - factCount:
        return false
    for factOffset in 0..<factCount:
        let fact = table.facts[factStart + factOffset]
        if fact.exactCallArgRow >= 0 &&
           fact.manualConsumeRow < 0 &&
           fact.consumesDefinition &&
           fact.definitionDomain ==
               coreir.BodyDefinitionDomainBodyOpTag &&
           fact.definitionRow == definitionRow:
            return true
    return false

@borrows
fn BodyIrAccessManualConsumeExactValidateAgainst(
        bodyIR: coreir.BodyIR,
        table: var BodyIrAccessTable,
        expectedRootCid: layout.FixedBytes32): bool =
    return table.valid &&
           coreir.BodyIRManualConsumeExactValidateAgainst(
               bodyIR, expectedRootCid) &&
           bodyIrAccessVerifyManagedValueDefinitions(
               bodyIR, table)
