# Step 5 (备) P3 — LICM hoist + GVN elimination apply (ghost, no-mutation).
#
# Status: SCAFFOLD / GHOST-WITH-DEAD-WIRE (lesson e4550c1b5 applied).
# Env gate CHENG_ALIAS_LICM_GVN_APPLY=1 default off.
#
# Design source: docs/beat-c.md §1.4.5 Step 5 P3.
#
# Companion to alias_licm_gvn_plan.cheng (P2 hoist/elim plan emission).
# This module consumes the plan + receives bodyIR by var (so the real
# wire can mutate in-place later) and executes the apply pass.
#
# IMPORTANT: This scaffold version performs NO mutation of bodyIR — it
# only walks the plan entries and tallies what would have happened.
# Real mutation (P3 真 apply, cross-session per §12.2):
#   1. ActionHoist  → splice op out of body + insert into preheader block.
#   2. Eliminate    → drop op + remap downstream slot references to the
#                     cached value number from the earlier read.
#   3. Codegen output 真改 → bootstrap fp 漂 → §12.2 new baseline.
#
# Wiring plan (Step 5 P3 真 apply, cross-session):
#   1) primary_object_plan's PrimaryBodyIrPrepareA64LayoutMetricsInPlace
#      consumes plan + calls AliasLicmGvnApplyExecute on the bodyIR.
#   2) Predictor + filler honor the rewritten op stream under the same
#      two-pass-symmetry contract as other layout bitmaps.
#   3) Bootstrap fp drifts; new baseline + §12.2 cross-session measurement.

import cheng/core/ir/alias_licm_gvn_plan as algplan
import cheng/core/ir/core_types as coreir
import std/os
import std/strings

type
    AliasApplyResult =
        hoistedOps: int32
        eliminatedOps: int32
        skippedOps: int32

fn AliasLicmGvnApplyExecute(plan: algplan.AliasLicmGvnPlan,
                            bodyIR: var coreir.BodyIR): AliasApplyResult =
    var result: AliasApplyResult
    result.hoistedOps = 0
    result.eliminatedOps = 0
    result.skippedOps = 0

    for i in 0..<plan.entries.len:
        let entry = plan.entries[i]
        if entry.action == algplan.AliasPlanActionHoist:
            # NO MUTATION here — a production wire needs canonical loop
            # identity and an exact preheader block index in the plan.
            result.hoistedOps = result.hoistedOps + 1
            continue
        if entry.action == algplan.AliasPlanActionEliminate:
            # NO MUTATION here — real wire will drop the redundant read
            # and remap its downstream slot to the cached value number
            # from the earlier read of the same baseSlot.
            result.eliminatedOps = result.eliminatedOps + 1
            continue
        result.skippedOps = result.skippedOps + 1

    let _gate = os.GetEnv("CHENG_ALIAS_LICM_GVN_APPLY")
    if _gate == "1":
        var _line: str = "[alias-licm-gvn-apply] hoisted="
        _line = _line + strings.IntToStr(result.hoistedOps)
        _line = _line + " eliminated="
        _line = _line + strings.IntToStr(result.eliminatedOps)
        _line = _line + " skipped="
        _line = _line + strings.IntToStr(result.skippedOps)
        os.WriteLine(os.GetStderr(), _line)

    return result

fn AliasLicmGvnApplyResultHoisted(result: AliasApplyResult): int32 =
    return result.hoistedOps

fn AliasLicmGvnApplyResultEliminated(result: AliasApplyResult): int32 =
    return result.eliminatedOps

fn AliasLicmGvnApplyResultSkipped(result: AliasApplyResult): int32 =
    return result.skippedOps
