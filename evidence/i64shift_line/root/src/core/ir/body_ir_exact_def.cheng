# body_ir_exact_def — ExactDef 批 1: C 冷链 exact-authority 验证层的 Cheng 侧
# 数据模型基座 (docs/cheng-exact-def-rewrite-design.md §3.2, 批 1 范围)。
#
# 职责 (本模块 = 值域常量 + 侧车形状/seal/CID + sentinel 单实现 + 判词文本基座):
#   1. C 9 值 place 域 / 5 值 storage 域常量 (数值逐字对齐 cheng_cold.c:18399-18421,
#      跨基板判词字段值按此域解释)。
#   2. BodyIrExactDefSidecar (类型内嵌 coreir.BodyIR.exactDef, 见 core_types.cheng)
#      的形状校验 / canonical-empty 判定 / seal + CID 指纹。
#   3. BodyIrExactDefSlotIsSentinel — sentinel 单实现 (C 两实现
#      cold_slot_authority_sentinel_is_exact_var_out_carrier /
#      _is_exact_formal_carrier 及 use-scan 臂的 Cheng 对齐, 设计 §5-2:
#      Cheng 槽创建即默认证明、TypeArena 绑定幂等, use-scan 臂按真空实现;
#      夹具守「fresh str/seq 载体不误判」)。
#   4. identity schema storage 子句判词文本基座 (单行确定, C 文本逐字保留,
#      字段序冻结; 发射 IO 在 exact_def_derive, 本层不持 IO)。
#   5. ExactProgramContract 程序级契约表 (批 5 扩列, 规格
#      docs/cheng-exact-def-batch5-authority-spec.md §4.1/§4.5): per function
#      row 五槽 (rootKind/formalIndex/formalMask/globalRow/readOnlyProof) 的
#      SoA 类型 + 值域常量。推导/形状/seal/CID 行为函数在
#      exact_def_call_authority 持单实现 (本模块是钉死种子死点行之前的
#      有序模块, 新增函数会移动死点行号, 零漂移口径不许; 类型/常量声明
#      不产生函数行), seal 接线在 compiler_csg 全程序门 (批 5 锚点)。
#      值域逐值对齐 cheng_cold.c:4336-4345 (root kind UNKNOWN0/FORMAL1/
#      GLOBAL2/STATIC3, read-only UNKNOWN0/PROVEN1)。
#
# 身份纪律: 一切跨节点身份为 int32 行 (op 行 / LocalSlot 行 / TypeArena TypeId /
# 函数行); originIds 的行域由 place kind 选定 (PARAM→形参序, STACK_LOCAL→槽行,
# TEMPORARY→op 行, BORROW_PROJECTION→源定义在其域的行), 与 C 裁定同
# (cheng_cold.c ColdExprResult 注释: origin_id's row domain is selected by
# place_kind)。严禁文本/源码行/name+arity/裸指针键。
#
# import 纪律 (设计 §3.1「只 import coreir/layout」的落地口径): coreir 提供
# BodyIR/侧车类型, layout 提供 FixedBytes32/ByteBuf, hash256 提供 CID 指纹
# (std 纯值库, 与 backend2_plugin_cid 同例), strformat 提供判词行 Fmt 格式化
# (core_types.cheng 同款)。零编译器状态 import。

import std/strformat
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/ir/core_types as coreir

const
    # C place 9 值域 (cheng_cold.c:18399-18413 逐值对齐)。
    BodyIrExactDefPlaceInvalidTag = 0
    BodyIrExactDefPlaceTemporaryTag = 1
    BodyIrExactDefPlaceStackLocalTag = 2
    BodyIrExactDefPlaceParamTag = 3
    BodyIrExactDefPlaceBorrowProjectionTag = 4
    BodyIrExactDefPlaceGlobalTag = 5
    BodyIrExactDefPlaceCfgMergeTag = 6
    BodyIrExactDefPlaceSharedCopyTag = 7
    BodyIrExactDefPlaceMemoryVersionTag = 8
    # C storage 5 值域 (cheng_cold.c:18417-18421 逐值对齐)。
    BodyIrExactDefStorageUnknownTag = 0
    BodyIrExactDefStoragePlainTag = 1
    BodyIrExactDefStorageStrTag = 2
    BodyIrExactDefStorageSequenceTag = 3
    BodyIrExactDefStorageObjectTag = 4
    bodyIrExactDefCidDomainTag: str = "cheng.core.ir.bodyirexactdef"

type
    # 规范推导的 TypeArena 证据窗: 推导器只读这十列不可变投影
    # (LoweringPlanStub.typeArena* 的直传), 不 import lowering/typed_expr,
    # 批 2 两处 lowering 接线点各自投影后传入, 结构上避免 import 环。
    BodyIrExactDefTypeArenaWindow =
        artifactCid: layout.FixedBytes32
        structuralKinds: int32[]
        scalarKinds: int32[]
        childTypeIds: int32[]
        layoutChildStarts: int32[]
        layoutChildCounts: int32[]
        layoutChildTypeIds: int32[]
        layoutChildOffsets: int32[]
        layoutChildWidths: int32[]
        fixedLengths: int32[]
        sizeBytes: int32[]
        alignBytes: int32[]

@borrows
fn BodyIrExactDefTypeArenaWindowShapeValid(
        window: BodyIrExactDefTypeArenaWindow): bool =
    let count = window.structuralKinds.len
    if count <= 0:
        return false
    if window.scalarKinds.len != count ||
       window.childTypeIds.len != count ||
       window.layoutChildStarts.len != count ||
       window.layoutChildCounts.len != count ||
       window.fixedLengths.len != count ||
       window.sizeBytes.len != count ||
       window.alignBytes.len != count:
        return false
    if window.layoutChildTypeIds.len != window.layoutChildOffsets.len ||
       window.layoutChildTypeIds.len != window.layoutChildWidths.len:
        return false
    for typeId in 0..<count:
        let childStart = window.layoutChildStarts[typeId]
        let childCount = window.layoutChildCounts[typeId]
        if childStart < 0 || childCount < 0 ||
           childStart > window.layoutChildTypeIds.len - childCount:
            return false
        for childOffset in 0..<childCount:
            if window.layoutChildTypeIds[childStart + childOffset] < 0 ||
               window.layoutChildTypeIds[childStart + childOffset] >= count:
                return false
    return !layout.FixedBytes32Equal(
        window.artifactCid, layout.FixedBytes32())

@borrows
fn BodyIrExactDefSidecarIsCanonicalEmpty(
        sidecar: coreir.BodyIrExactDefSidecar): bool =
    return !sidecar.sealed &&
           sidecar.opPlaceKinds.len == 0 &&
           sidecar.opExactTypeIds.len == 0 &&
           sidecar.opOriginIds.len == 0 &&
           sidecar.opProducerFunctionRows.len == 0 &&
           sidecar.opSourceDefOpRows.len == 0 &&
           sidecar.opReadADefOpRows.len == 0 &&
           sidecar.slotPlaceKinds.len == 0 &&
           sidecar.slotOriginIds.len == 0 &&
           sidecar.slotStorageKinds.len == 0 &&
           sidecar.callArgStarts.len == 0 &&
           sidecar.callArgCounts.len == 0 &&
           sidecar.argDefOpRows.len == 0 &&
           sidecar.argPlaceKinds.len == 0 &&
           sidecar.argOwnerships.len == 0 &&
           sidecar.argOriginIds.len == 0 &&
           layout.FixedBytes32Equal(
               sidecar.exactDefCid, layout.FixedBytes32())

@borrows
fn BodyIrExactDefSidecarShapeValid(bodyIR: coreir.BodyIR): bool =
    let sidecar = bodyIR.exactDef
    if !sidecar.sealed:
        # 未冻结只承认 canonical empty (构建前/旧 BodyIR 合法态); 推导中间态
        # 不出现在任何 seal/codec/校验边界。
        return BodyIrExactDefSidecarIsCanonicalEmpty(sidecar)
    let opCount = bodyIR.ops.len
    if sidecar.opPlaceKinds.len != opCount ||
       sidecar.opExactTypeIds.len != opCount ||
       sidecar.opOriginIds.len != opCount ||
       sidecar.opProducerFunctionRows.len != opCount ||
       sidecar.opSourceDefOpRows.len != opCount ||
       sidecar.opReadADefOpRows.len != opCount:
        return false
    let slotCount = bodyIR.localSlots.len
    if sidecar.slotPlaceKinds.len != slotCount ||
       sidecar.slotOriginIds.len != slotCount ||
       sidecar.slotStorageKinds.len != slotCount:
        return false
    if sidecar.callArgStarts.len != bodyIR.callSequence.len ||
       sidecar.callArgCounts.len != bodyIR.callSequence.len:
        return false
    var argTotal: int32
    for callIndex in 0..<bodyIR.callSequence.len:
        let start = sidecar.callArgStarts[callIndex]
        let count = sidecar.callArgCounts[callIndex]
        if start != argTotal || count < 0 ||
           count != bodyIR.callSequence[callIndex].argSlots.len:
            return false
        argTotal = argTotal + count
    if sidecar.argDefOpRows.len != argTotal ||
       sidecar.argPlaceKinds.len != argTotal ||
       sidecar.argOwnerships.len != argTotal ||
       sidecar.argOriginIds.len != argTotal:
        return false
    for opRow in 0..<opCount:
        if sidecar.opPlaceKinds[opRow] < BodyIrExactDefPlaceInvalidTag ||
           sidecar.opPlaceKinds[opRow] > BodyIrExactDefPlaceMemoryVersionTag:
            return false
    for slotRow in 0..<slotCount:
        if sidecar.slotPlaceKinds[slotRow] < BodyIrExactDefPlaceInvalidTag ||
           sidecar.slotPlaceKinds[slotRow] >
               BodyIrExactDefPlaceMemoryVersionTag ||
           sidecar.slotStorageKinds[slotRow] <
               BodyIrExactDefStorageUnknownTag ||
           sidecar.slotStorageKinds[slotRow] >
               BodyIrExactDefStorageObjectTag:
            return false
    return !layout.FixedBytes32Equal(
        sidecar.exactDefCid, layout.FixedBytes32())

fn BodyIrExactDefSidecarReset(sidecar: var coreir.BodyIrExactDefSidecar) =
    sidecar.opPlaceKinds = []
    sidecar.opExactTypeIds = []
    sidecar.opOriginIds = []
    sidecar.opProducerFunctionRows = []
    sidecar.opSourceDefOpRows = []
    sidecar.opReadADefOpRows = []
    sidecar.slotPlaceKinds = []
    sidecar.slotOriginIds = []
    sidecar.slotStorageKinds = []
    sidecar.callArgStarts = []
    sidecar.callArgCounts = []
    sidecar.argDefOpRows = []
    sidecar.argPlaceKinds = []
    sidecar.argOwnerships = []
    sidecar.argOriginIds = []
    sidecar.sealed = false
    sidecar.exactDefCid = layout.FixedBytes32()

fn bodyIrExactDefCidAppendI32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

fn bodyIrExactDefCidAppendColumn(buf: var layout.ByteBuf,
                                 column: var int32[]) =
    bodyIrExactDefCidAppendI32(buf, column.len)
    for row in 0..<column.len:
        bodyIrExactDefCidAppendI32(buf, column[row])

fn bodyIrExactDefCidAppendText(buf: var layout.ByteBuf, text: str) =
    bodyIrExactDefCidAppendI32(buf, len(text))
    for index in 0..<len(text):
        layout.ByteBufAppendByte(buf, Int32(text[index]) & 255)

# seal: 全列 dense 完整 (形状前置证明) → CID 指纹一次落 + sealed。
# CID 域标签 + 按声明序全列 LE; 不含任何 BodyIR 外状态, 同列同 CID。
fn BodyIrExactDefSidecarSealInto(bodyIR: var coreir.BodyIR) =
    let sidecar = bodyIR.exactDef
    if sidecar.sealed:
        panic("body ir exact def: sidecar already sealed")
    let opCount = bodyIR.ops.len
    let slotCount = bodyIR.localSlots.len
    if sidecar.opPlaceKinds.len != opCount ||
       sidecar.opExactTypeIds.len != opCount ||
       sidecar.opOriginIds.len != opCount ||
       sidecar.opProducerFunctionRows.len != opCount ||
       sidecar.opSourceDefOpRows.len != opCount ||
       sidecar.opReadADefOpRows.len != opCount ||
       sidecar.slotPlaceKinds.len != slotCount ||
       sidecar.slotOriginIds.len != slotCount ||
       sidecar.slotStorageKinds.len != slotCount ||
       sidecar.callArgStarts.len != bodyIR.callSequence.len ||
       sidecar.callArgCounts.len != bodyIR.callSequence.len:
        panic("body ir exact def: seal shape incomplete")
    var argTotal: int32
    for callIndex in 0..<bodyIR.callSequence.len:
        if sidecar.callArgStarts[callIndex] != argTotal ||
           sidecar.callArgCounts[callIndex] !=
               bodyIR.callSequence[callIndex].argSlots.len:
            panic("body ir exact def: seal call-arg CSR invalid")
        argTotal = argTotal + sidecar.callArgCounts[callIndex]
    if sidecar.argDefOpRows.len != argTotal ||
       sidecar.argPlaceKinds.len != argTotal ||
       sidecar.argOwnerships.len != argTotal ||
       sidecar.argOriginIds.len != argTotal:
        panic("body ir exact def: seal call-arg column shape incomplete")
    var buf = layout.ByteBufInit(1024)
    bodyIrExactDefCidAppendText(buf, bodyIrExactDefCidDomainTag)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opPlaceKinds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opExactTypeIds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opOriginIds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opProducerFunctionRows)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opSourceDefOpRows)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opReadADefOpRows)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.slotPlaceKinds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.slotOriginIds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.slotStorageKinds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.callArgStarts)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.callArgCounts)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.argDefOpRows)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.argPlaceKinds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.argOwnerships)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.argOriginIds)
    bodyIR.exactDef.exactDefCid =
        hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    bodyIR.exactDef.sealed = true

# refreeze CID (批 2): freeze 层 read-edge 单遍完成填 opReadADefOpRows /
# 同步扩列追加 cleanup 物化行后, 侧车内容已变但 sealed 语义不变 — 按 seal
# 同字节序就地重算 CID (域标签 + 按声明序全列 LE)。前置: sealed 且形状合法,
# 否则属上层不变式破坏, panic hard fail。
fn BodyIrExactDefSidecarRefreezeCidInto(bodyIR: var coreir.BodyIR) =
    if !bodyIR.exactDef.sealed:
        panic("body ir exact def: refreeze requires sealed sidecar")
    if !BodyIrExactDefSidecarShapeValid(bodyIR):
        panic("body ir exact def: refreeze shape invalid")
    var buf = layout.ByteBufInit(1024)
    bodyIrExactDefCidAppendText(buf, bodyIrExactDefCidDomainTag)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opPlaceKinds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opExactTypeIds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opOriginIds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opProducerFunctionRows)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opSourceDefOpRows)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.opReadADefOpRows)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.slotPlaceKinds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.slotOriginIds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.slotStorageKinds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.callArgStarts)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.callArgCounts)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.argDefOpRows)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.argPlaceKinds)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.argOwnerships)
    bodyIrExactDefCidAppendColumn(buf, bodyIR.exactDef.argOriginIds)
    bodyIR.exactDef.exactDefCid =
        hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)

# sentinel 单实现。C 语义: 权威四道全 sentinel 且结构上是合法非托管载体。
# Cheng 车道裁定 (设计 §5-2 真空实现):
#   - 已绑权威 (typeArenaTypeId>=0 或 managedStorageKind 已分类) 永非 sentinel;
#     TypeArena 绑定幂等, 已分类 str/seq/object 载体在此短路 → 不误判。
#   - 标量/裸指针静态道载体 (i32/i64/f64/ptr 未绑) = 结构 sentinel
#     (非 nominal 静态 storage, 对齐 C 57489-57493 无条件臂)。
#   - 未绑 nominal 聚合槽 = nominal UNKNOWN sentinel
#     (C 的 transient view-carrier / address-only use-scan 臂在 Cheng 无对应
#      op 形态, 按真空落到「未分类 nominal 即结构载体」)。
#   - 未分类 str 托管值载体不是 sentinel (C 同: SLOT_STR 不在无条件臂,
#     其形式载体证在 entry-definition 车道, 由推导/冻结层核对)。
# 侧车已 seal 时, 三道侧车车道必须同时在 sentinel 值 (place INVALID /
# origin -1 / storage UNKNOWN), 否则该槽已持权威。
@borrows
fn BodyIrExactDefSlotIsSentinel(bodyIR: coreir.BodyIR,
                                slotId: int32): bool =
    if slotId < 0 || slotId >= bodyIR.localSlots.len:
        return false
    let slot = bodyIR.localSlots[slotId]
    if slot.typeArenaTypeId >= 0 ||
       slot.managedStorageKind != coreir.BodyManagedStorageUnknownTag:
        return false
    if bodyIR.exactDef.sealed:
        if bodyIR.exactDef.slotPlaceKinds[slotId] !=
               BodyIrExactDefPlaceInvalidTag ||
           bodyIR.exactDef.slotOriginIds[slotId] != -1 ||
           bodyIR.exactDef.slotStorageKinds[slotId] !=
               BodyIrExactDefStorageUnknownTag:
            return false
    let kind = slot.typeKind
    if kind == coreir.LocalI32Tag || kind == coreir.LocalI64Tag ||
       kind == coreir.LocalF64Tag || kind == coreir.LocalPtrTag:
        return true
    if kind == coreir.LocalAggregateTag:
        return true
    return false

# identity schema storage 子句判词文本基座 (单行确定)。
# C 原文 (cheng_cold.c:68402) 逐字保留, 含 `cheng_cold:` 前缀与字段序;
# 两处基板替换按 §3.5「字段值不跨基板比对」裁定: fn= 打函数行 (C 打名字
# 文本, Cheng BodyIR 不持函数名权威), slot_name= 打 LocalSlot.name (C 打
# slot_type 文本, Cheng 身份纪律禁文本键, 该字段仅为确定性强排投影)。
@borrows
fn BodyIrExactDefSlotAuthorityMismatchLine(
        phase: str,
        functionRow: int32,
        opRow: int32,
        slotId: int32,
        slotKind: int32,
        slotSize: int32,
        slotName: str,
        opKind: int32,
        opDst: int32,
        opA: int32,
        opB: int32,
        opC: int32,
        opSource: int32,
        opReadA: int32,
        defType: int32,
        slotType: int32,
        defPlace: int32,
        slotPlace: int32,
        defOrigin: int32,
        slotOrigin: int32,
        defStorage: int32,
        slotStorage: int32): str =
    return Fmt"cheng_cold: exact identity schema [{phase}] fn={functionRow} op row={opRow} slot={slotId} slot_kind={slotKind} slot_size={slotSize} slot_name={slotName} op_kind={opKind} dst={opDst} a={opA} b={opB} c={opC} source={opSource} read_a={opReadA} slot authority mismatch def_type={defType} slot_type={slotType} def_place={defPlace} slot_place={slotPlace} def_origin={defOrigin} slot_origin={slotOrigin} def_storage={defStorage} slot_storage={slotStorage}"

# ---- 批 5 程序契约表 (ExactProgramContract; 规格 §4.1 五槽 §4.5 扩列) ----

const
    # C borrow_result_root_kind 值域 (cheng_cold.c:4336-4341 逐值对齐)。
    BodyIrExactDefContractRootUnknownTag = 0
    BodyIrExactDefContractRootFormalTag = 1
    BodyIrExactDefContractRootGlobalTag = 2
    BodyIrExactDefContractRootStaticTag = 3
    # C borrow_result_root_read_only_proof 值域 (cheng_cold.c:4343-4345)。
    BodyIrExactDefContractReadOnlyUnknownTag = 0
    BodyIrExactDefContractReadOnlyProvenTag = 1
    BodyIrExactDefContractCidDomainTag: str =
        "cheng.core.ir.bodyirexactdef.contract"

type
    # 程序级契约表: per function row 五列 dense SoA。rootKind==FORMAL 时
    # formalIndex=mask 最低位形参序, formalMask=32 位形参集; GLOBAL 时
    # globalRow=唯一全局行; STATIC/UNKNOWN 时其余四列 -1/0/-1/UNKNOWN
    # (C OWNED/STATIC 门同形, 规格 §4.2-2/§4.2-6)。行为函数 (canonical
    # empty/shape/seal/CID) 在 exact_def_call_authority 持单实现 — 本模
    # 块是钉死种子死点行 (fn=11464) 之前的有序模块, 新增函数会移动死
    # 点行号 (零漂移口径不许, 批 5 实证); 类型/常量声明不产生函数行。
    ExactProgramContract =
        rootKinds: int32[]
        formalIndexs: int32[]
        formalMasks: int32[]
        globalRows: int32[]
        readOnlyProofs: int32[]
        sealed: bool
        contractCid: layout.FixedBytes32
