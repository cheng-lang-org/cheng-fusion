# #129 minimal repro, entry point: imports BOTH the leaf (directly, default
# non-aliased import) and the intermediate module (which itself already
# imports the same leaf under a different alias) -- a diamond import. Mirrors
# src/libp2p/tests/tcp_transport_smoke.cheng importing both
# .../stream/connection (directly, default alias `connection`) and
# .../transports/tcptransport (which imports the same connection module as
# `streamconn`).
#
# Before the #129 fix: the bare `CD129Leaf` reference below resolves via
# parser_find_const's cross-module alias scan to two DIFFERENT qualified
# names -- `cd129_leaf.CD129Leaf` (registered via entry's own direct import
# edge) and `cd129ml.CD129Leaf` (registered via mid's own aliased import
# edge) -- both reaching the SAME physical const declaration, but the scan
# dedups candidates only by qualified-name string equality
# (`!span_same(found, scoped)`), so it counts them as two distinct
# candidates and dies "ambiguous imported const name".

import cheng/repro_constdiamond129/cd129_leaf
import cheng/repro_constdiamond129/cd129_mid

fn main(): int32 =
    let bumped: int32 = cd129MidBump()
    let bare: int32 = CD129Leaf
    return bare + bumped
