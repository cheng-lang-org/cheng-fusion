# Cinema camera (D2): right-handed look-at perspective camera. Screen
# coordinates are pixel centers; focal length is expressed in pixels so
# sphere impostors scale directly.
import cheng/game/csg/numerics
import std/math as m

type
    CameraProj =
        sx: float64
        sy: float64
        depth: float64

    CameraRay =
        x: float64
        y: float64
        z: float64

    CinemaCamera =
        posX: float64
        posY: float64
        posZ: float64
        # orthonormal basis: forward f, right r, up u
        fx: float64
        fy: float64
        fz: float64
        rx: float64
        ry: float64
        rz: float64
        ux: float64
        uy: float64
        uz: float64
        focalPx: float64
        width: int32
        height: int32

# Build a look-at camera (Z-up world).
fn CinemaCameraLookAt(px: float64,
                      py: float64,
                      pz: float64,
                      tx: float64,
                      ty: float64,
                      tz: float64,
                      focalPx: float64,
                      width: int32,
                      height: int32): CinemaCamera =
    var cam: CinemaCamera
    cam.posX = px
    cam.posY = py
    cam.posZ = pz
    cam.focalPx = focalPx
    cam.width = width
    cam.height = height
    let fx = tx - px
    let fy = ty - py
    let fz = tz - pz
    let fLen = numerics.CsgSqrt(fx * fx + fy * fy + fz * fz)
    cam.fx = fx / fLen
    cam.fy = fy / fLen
    cam.fz = fz / fLen
    # right = forward x world-up (0,0,1)
    let rxx = cam.fy * 1.0 - cam.fz * 0.0
    let ryy = cam.fz * 0.0 - cam.fx * 1.0
    let rLen = numerics.CsgSqrt(rxx * rxx + ryy * ryy)
    cam.rx = rxx / rLen
    cam.ry = ryy / rLen
    cam.rz = 0.0
    # up = right x forward
    cam.ux = cam.ry * cam.fz - cam.rz * cam.fy
    cam.uy = cam.rz * cam.fx - cam.rx * cam.fz
    cam.uz = cam.rx * cam.fy - cam.ry * cam.fx
    return cam

fn CameraProject(cam: CinemaCamera, x: float64, y: float64, z: float64): CameraProj =
    var out: CameraProj
    let dx = x - cam.posX
    let dy = y - cam.posY
    let dz = z - cam.posZ
    let depth = dx * cam.fx + dy * cam.fy + dz * cam.fz
    out.depth = depth
    let u = dx * cam.rx + dy * cam.ry + dz * cam.rz
    let v = dx * cam.ux + dy * cam.uy + dz * cam.uz
    out.sx = cam.focalPx * u / depth + float64(cam.width) * 0.5
    out.sy = float64(cam.height) * 0.5 - cam.focalPx * v / depth
    return out

fn CameraRayDir(cam: CinemaCamera, px: int32, py: int32): CameraRay =
    var out: CameraRay
    let su = (float64(px) + 0.5 - float64(cam.width) * 0.5) / cam.focalPx
    let sv = (float64(cam.height) * 0.5 - float64(py) - 0.5) / cam.focalPx
    out.x = cam.fx + cam.rx * su + cam.ux * sv
    out.y = cam.fy + cam.ry * su + cam.uy * sv
    out.z = cam.fz + cam.rz * su + cam.uz * sv
    return out
