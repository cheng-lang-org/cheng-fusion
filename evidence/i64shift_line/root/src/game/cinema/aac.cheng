# Pure-Cheng AAC-LC encoding bridge (D3): linear PCM s16le mono 48 kHz
# in, raw AAC frames out, via AudioConverterFillComplexBuffer. The input
# callback runs on the caller thread and reads from a C-heap cursor
# context (no Cheng-managed memory crosses the ABI); packet sizes are
# captured through the AudioStreamPacketDescription table. Output is
# ADTS-free raw AAC — the MP4 muxer writes the esds/ASC itself.
type
    UInt8Ptr = uint8 *

const
    FormatLPCM = 1819304813  # 'lpcm' = 0x6C70636D
    FormatAAC32 = 1633772320  # 'aac ' = 0x61616320
    PcmFormatFlagsS16LE = 12  # IsSignedInteger(4) | IsPacked(8)
    AacErrRequiresMoreInput = 560226676  # kAudioConverterErr_RequiresMoreInputData '!dat'
    AacOutputCapBytes = 2097152
    AacMaxPackets = 4096
    AacFramesPerPacket = 1024

@importc("AudioConverterNew")
fn aacConverterNew(inDesc: ptr, outDesc: ptr, convOut: ptr): int32
@importc("AudioConverterFillComplexBuffer")
fn aacConverterFill(conv: ptr, cb: ptr, userData: ptr,
                    ioPacketSizeOut: ptr, outData: ptr,
                    packetDescOut: ptr): int32
@importc("AudioConverterDispose")
fn aacConverterDispose(conv: ptr): int32
@importc("calloc")
fn aCalloc(n: int64, size: int64): ptr
@importc("memcpy")
fn aMemcpy(dst: ptr, src: ptr, n: int64): ptr
@importc("cheng_ptr_plus")
fn aPtrPlus(base: ptr, off: int32): ptr

fn ALoadI32(p: ptr, off: int32): int32 =
    var v: int32 = 0
    let _c = aMemcpy(ptr(&v), aPtrPlus(p, off), 4)
    return v

fn AStoreI32(p: ptr, off: int32, v: int32) =
    let _c = aMemcpy(aPtrPlus(p, off), ptr(&v), 4)

fn ALoadPtr(p: ptr, off: int32): ptr =
    var q: ptr = nil
    let _c = aMemcpy(ptr(&q), aPtrPlus(p, off), 8)
    return q

fn AStorePtr(p: ptr, off: int32, q: ptr) =
    let _c = aMemcpy(aPtrPlus(p, off), ptr(&q), 8)

fn AStoreF64(p: ptr, off: int32, v: float64) =
    let _c = aMemcpy(aPtrPlus(p, off), ptr(&v), 8)

# AudioConverterInputDataProc ABI:
#   (converter, ioNumberDataPackets*, AudioBufferList*, packetDesc**, userData*)
# The AudioBufferList layout for one buffer (arm64):
#   0 mNumberBuffers, 8 buffer[0].mNumberChannels, 12 mDataByteSize, 16 mData.
@exportc("cheng_csg_aac_input")
fn chengCsgAacInput(conv: ptr, ioNumPackets: ptr, ioData: ptr,
                    descOut: ptr, userData: ptr): int32 =
    if userData == nil || ioNumPackets == nil || ioData == nil:
        return AacErrRequiresMoreInput
    let total = ALoadI32(userData, 8)
    let cursor = ALoadI32(userData, 16)
    if cursor >= total:
        AStoreI32(ioNumPackets, 0, 0)
        return AacErrRequiresMoreInput
    let remain = total - cursor
    var give: int32 = remain
    if give > 262144:
        give = 262144
    AStoreI32(ioData, 0, 1)
    AStoreI32(ioData, 8, 1)
    AStoreI32(ioData, 12, give)
    AStorePtr(ioData, 16, aPtrPlus(ALoadPtr(userData, 0), cursor))
    AStoreI32(ioNumPackets, 0, give / 2)
    AStoreI32(userData, 16, cursor + give)
    return 0

# AudioStreamBasicDescription (40 bytes, arm64):
#   0 mSampleRate f64, 8 mFormatID, 12 mFormatFlags, 16 mBytesPerPacket,
#   20 mFramesPerPacket, 24 mBytesPerFrame, 28 mChannelsPerFrame,
#   32 mBitsPerChannel, 36 mReserved.
fn writeAsbd(p: ptr, rate: float64, formatId: int32, flags: int32,
             bytesPerPacket: int32, framesPerPacket: int32,
             bytesPerFrame: int32, channels: int32, bits: int32) =
    AStoreF64(p, 0, rate)
    AStoreI32(p, 8, formatId)
    AStoreI32(p, 12, flags)
    AStoreI32(p, 16, bytesPerPacket)
    AStoreI32(p, 20, framesPerPacket)
    AStoreI32(p, 24, bytesPerFrame)
    AStoreI32(p, 28, channels)
    AStoreI32(p, 32, bits)
    AStoreI32(p, 36, 0)

# Encode s16le mono 48 kHz PCM into raw AAC-LC packets.
#   pcm         — the interleaved s16le bytes
#   totalBytes  — pcm.len (must be even)
#   outPayload  — appended with the concatenated AAC packets
#   outSizes    — appended with one byte size per packet
# returns 0 when at least one packet was produced.
@borrows
fn AacEncodePcm16(pcm: uint8[], totalBytes: int32,
                  outPayload: var uint8[], outSizes: var int32[]): int32 =
    let inAsbd: ptr = aCalloc(1, 64)
    let outAsbd: ptr = aCalloc(1, 64)
    writeAsbd(inAsbd, 48000.0, FormatLPCM, PcmFormatFlagsS16LE, 2, 1, 2, 1, 16)
    writeAsbd(outAsbd, 48000.0, FormatAAC32, 0, 0, AacFramesPerPacket, 0, 1, 0)
    var conv: ptr = nil
    let nrc = aacConverterNew(inAsbd, outAsbd, ptr(&conv))
    if nrc != 0:
        return nrc
    if conv == nil:
        return -2
    # copy the Cheng-owned PCM into a C-heap block, 4 bytes at a time
    let pcmHeap: ptr = aCalloc(1, int64(totalBytes) + 4)
    var wi: int32 = 0
    while wi + 4 <= totalBytes:
        var word: int32 = int32(pcm[wi]) + int32(pcm[wi + 1]) * 256 + int32(pcm[wi + 2]) * 65536 + int32(pcm[wi + 3]) * 16777216
        let _w = aMemcpy(aPtrPlus(pcmHeap, wi), ptr(&word), 4)
        wi = wi + 4
    if wi < totalBytes:
        var tail: int32 = 0
        var mul: int32 = 1
        var k: int32 = wi
        while k < totalBytes:
            tail = tail + int32(pcm[k]) * mul
            mul = mul * 256
            k = k + 1
        let _t = aMemcpy(aPtrPlus(pcmHeap, wi), ptr(&tail), 4)
    # cursor context: 0 pcmHeap, 8 totalBytes, 16 cursor
    let ctx: ptr = aCalloc(1, 64)
    AStorePtr(ctx, 0, pcmHeap)
    AStoreI32(ctx, 8, totalBytes)
    AStoreI32(ctx, 16, 0)
    # output AudioBufferList: 1 buffer of AacOutputCapBytes
    let outAbl: ptr = aCalloc(1, 64)
    let outData: ptr = aCalloc(1, int64(AacOutputCapBytes))
    AStoreI32(outAbl, 0, 1)
    AStoreI32(outAbl, 8, 1)
    AStoreI32(outAbl, 12, int32(AacOutputCapBytes))
    AStorePtr(outAbl, 16, outData)
    # AudioStreamPacketDescription (arm64): 0 mStartOffset i64,
    # 8 mVariableFramesInPacket i32, 12 mDataByteSize i32 -> 16B stride.
    let descs: ptr = aCalloc(int64(AacMaxPackets), 16)
    var ioPackets: int32 = AacMaxPackets
    let frc = aacConverterFill(conv, chengCsgAacInput, ctx,
        ptr(&ioPackets), outAbl, descs)
    var produced: int32 = ioPackets
    if produced > AacMaxPackets:
        produced = AacMaxPackets
    var pi: int32 = 0
    while pi < produced:
        let off = ALoadI32(descs, 16 * pi)
        let sz = ALoadI32(descs, 16 * pi + 12)
        if sz > 0:
            var q: int32 = 0
            while q < sz:
                var b: int32 = int32(*(UInt8Ptr(aPtrPlus(outData, off + q))))
                add(outPayload, uint8(b))
                q = q + 1
            add(outSizes, sz)
        pi = pi + 1
    let _d = aacConverterDispose(conv)
    if outSizes.len == 0:
        if frc == 0:
            return -3
        return frc
    return 0
