# Deterministic film score (cinema sound track source): low drone (55 +
# 110 Hz under a slow amplitude LFO) plus an ascending pentatonic-ish
# ladder, one soft sine note per second of film. Pure integer-free math
# over float64; the tail is padded to the 1024-sample AAC frame boundary
# so the converter drops no real samples (AacEncodePcm16 contract).
import std/math as m
import std/rawbytes

const
    ScoreSampleRate = 48000
    ScoreAacFrameSamples = 1024

fn ScoreNoteFreq(step: int32): float64 =
    # A minor pentatonic ladder across two octaves, then cycles
    var s: int32 = step
    if s < 0:
        s = 0
    var k: int32 = s % 10
    if k == 0:
        return 220.0
    if k == 1:
        return 261.626
    if k == 2:
        return 293.665
    if k == 3:
        return 329.628
    if k == 4:
        return 391.995
    if k == 5:
        return 440.0
    if k == 6:
        return 523.251
    if k == 7:
        return 587.330
    if k == 8:
        return 659.255
    return 783.991

# Render `seconds` of the score into pcm (s16le mono 48 kHz). Returns
# the sample count (a multiple of 1024).
fn ScorePcm48k(pcm: var uint8[], seconds: int32): int32 =
    let bodySamples: int32 = seconds * ScoreSampleRate
    let pad: int32 = ScoreAacFrameSamples - (bodySamples % ScoreAacFrameSamples)
    let total: int32 = bodySamples + pad
    setLen(pcm, total * 2)
    var i: int32 = 0
    while i < total:
        let t: float64 = float64(i) / 48000.0
        let lfo: float64 = 0.75 + 0.25 * m.sinFloat(2.0 * 3.14159265358979 * 0.125 * t)
        var v: float64 = 2400.0 * lfo * (m.sinFloat(2.0 * 3.14159265358979 * 55.0 * t) + 0.5 * m.sinFloat(2.0 * 3.14159265358979 * 110.0 * t))
        var step: int32 = int32(t)
        if step > seconds - 1:
            step = seconds - 1
        let noteT: float64 = t - float64(step)
        let env: float64 = m.sinFloat(3.14159265358979 * noteT)
        v = v + 5200.0 * env * m.sinFloat(2.0 * 3.14159265358979 * ScoreNoteFreq(step) * t)
        if v > 12000.0:
            v = 12000.0
        if v < -12000.0:
            v = -12000.0
        let biased: int32 = int32(v) + 32768
        pcm[i * 2] = uint8(biased % 256)
        pcm[i * 2 + 1] = uint8((biased / 256) % 256)
        i = i + 1
    return total
