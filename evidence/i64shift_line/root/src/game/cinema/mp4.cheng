# MP4 assembly (D3): pure-Cheng ISO-BMFF box writer for one H.264 video
# track plus one AAC-LC audio track. All timing tables (stts/stsz/stco/
# stss) and the audio tail-packet duration are computed here — the plan
# assigns timestamps and muxing to Cheng, not to the system codec bridge.
# Fixed layout: ftyp | mdat(video payload, audio payload) | moov.
import std/os
import std/rawbytes

const
    Mp4Timescale = 24000
    Mp4FrameDelta = 1000
    Mp4AudioTimescale = 48000

@borrows
fn W8(w: var uint8[], v: int32) =
    add(w, uint8(v & 255))

@borrows
fn W16(w: var uint8[], v: int32) =
    add(w, uint8((v / 256) & 255))
    add(w, uint8(v & 255))

@borrows
fn W32(w: var uint8[], v: int32) =
    add(w, uint8((v / 16777216) & 255))
    add(w, uint8((v / 65536) & 255))
    add(w, uint8((v / 256) & 255))
    add(w, uint8(v & 255))

@borrows
fn WStr(w: var uint8[], s: str) =
    var i: int32 = 0
    while i < s.len:
        W8(w, int32(s[i]))
        i = i + 1

@borrows
fn WBytes(w: var uint8[], src: uint8[], start: int32, count: int32) =
    var i: int32 = 0
    while i < count:
        add(w, src[start + i])
        i = i + 1

@borrows
fn WBytesBytes(w: var uint8[], src: uint8[]) =
    var i: int32 = 0
    while i < src.len:
        add(w, src[i])
        i = i + 1

# begin a box: returns the offset of the size field; caller writes the
# payload then calls W32PatchSize with the saved offset
@borrows
fn BoxBegin(w: var uint8[], fourcc: str): int32 =
    let sizePos: int32 = w.len
    W32(w, 0)
    WStr(w, fourcc)
    return sizePos

@borrows
fn BoxEnd(w: var uint8[], sizePos: int32) =
    let size: int32 = w.len - sizePos
    w[sizePos] = uint8((size / 16777216) & 255)
    w[sizePos + 1] = uint8((size / 65536) & 255)
    w[sizePos + 2] = uint8((size / 256) & 255)
    w[sizePos + 3] = uint8(size & 255)

@borrows
fn W32At(w: var uint8[], pos: int32, v: int32) =
    w[pos] = uint8((v / 16777216) & 255)
    w[pos + 1] = uint8((v / 65536) & 255)
    w[pos + 2] = uint8((v / 256) & 255)
    w[pos + 3] = uint8(v & 255)

@borrows
fn WFullBox(w: var uint8[], fourcc: str, version: int32, flags: int32): int32 =
    let pos = BoxBegin(w, fourcc)
    W8(w, version)
    W8(w, (flags / 65536) % 256)
    W8(w, (flags / 256) % 256)
    W8(w, flags % 256)
    return pos

# audio specific config for AAC-LC, 48 kHz, mono (AOT 2, freq idx 3)
fn WAudioSpecificConfig(w: var uint8[]) =
    W16(w, 0x1188)

type
    Mp4Input =
        videoSizes: int32[]
        videoKf: int32[]
        videoPayload: uint8[]
        sps: uint8[]
        pps: uint8[]
        audioPayload: uint8[]
        audioSizes: int32[]
        audioSamples: int32

# Assemble and write the finished MP4.
fn Mp4Assemble(inp: Mp4Input, path: str) =
    var out: uint8[]
    setLen(out, 0)
    # ftyp
    let ftypPos = BoxBegin(out, "ftyp")
    W32(out, int32(0x69736F6D))
    W32(out, 512)
    WStr(out, "isom")
    WStr(out, "mp41")
    BoxEnd(out, ftypPos)
    # video payload chunk offset: ftyp + 8 + payload
    let mdatPos = BoxBegin(out, "mdat")
    let videoChunkOffset: int32 = 24 + 8
    WBytesBytes(out, inp.videoPayload)
    let audioChunkOffset: int32 = 24 + 8 + inp.videoPayload.len
    var audioHave: bool = inp.audioPayload.len > 0
    if audioHave:
        WBytesBytes(out, inp.audioPayload)
    BoxEnd(out, mdatPos)
    # moov
    let moovPos = BoxBegin(out, "moov")
    # mvhd (v0, exact field layout)
    let mvhdPos = WFullBox(out, "mvhd", 0, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, Mp4Timescale)
    W32(out, inp.videoSizes.len * Mp4FrameDelta)
    W32(out, 0x00010000)
    W16(out, 0x0100)
    W16(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0x00010000)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0x40000000)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 1)
    BoxEnd(out, mvhdPos)
    # ---- video trak ----
    let vTrakPos = BoxBegin(out, "trak")
    let vTkhdPos = WFullBox(out, "tkhd", 0, 7)
    W32(out, 0)
    W32(out, 0)
    W32(out, 1)
    W32(out, 0)
    W32(out, inp.videoSizes.len * Mp4FrameDelta)
    W32(out, 0)
    W32(out, 0)
    W16(out, 0)
    W16(out, 0)
    W16(out, 0)
    W16(out, 0)
    W32(out, 0x00010000)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0x00010000)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, 0x40000000)
    W32(out, 1280 * 65536)
    W32(out, 720 * 65536)
    BoxEnd(out, vTkhdPos)
    let vMdiaPos = BoxBegin(out, "mdia")
    let vMdhdPos = WFullBox(out, "mdhd", 0, 0)
    W32(out, 0)
    W32(out, 0)
    W32(out, Mp4Timescale)
    W32(out, inp.videoSizes.len * Mp4FrameDelta)
    W32(out, 0x55C40000)
    BoxEnd(out, vMdhdPos)
    let vHdlrPos = WFullBox(out, "hdlr", 0, 0)
    W32(out, 0)
    WStr(out, "vide")
    W32(out, 0)
    W32(out, 0)
    W32(out, 0)
    WStr(out, "ChengVideoHandler")
    BoxEnd(out, vHdlrPos)
    let vMinfPos = BoxBegin(out, "minf")
    let vVmhdPos = WFullBox(out, "vmhd", 0, 1)
    W16(out, 0)
    W16(out, 0)
    W16(out, 0)
    W16(out, 0)
    BoxEnd(out, vVmhdPos)
    let vDinfPos = BoxBegin(out, "dinf")
    let vDrefPos = WFullBox(out, "dref", 0, 0)
    W32(out, 1)
    let vUrlPos = WFullBox(out, "url ", 0, 1)
    BoxEnd(out, vUrlPos)
    BoxEnd(out, vDrefPos)
    BoxEnd(out, vDinfPos)
    let vStblPos = BoxBegin(out, "stbl")
    # stsd > avc1 > avcC
    let vStsdPos = WFullBox(out, "stsd", 0, 0)
    W32(out, 1)
    let avc1Pos = BoxBegin(out, "avc1")
    var z: int32 = 0
    while z < 6:
        W8(out, 0)
        z = z + 1
    W16(out, 1)
    W16(out, 0)
    W16(out, 0)
    var pre: int32 = 0
    while pre < 12:
        W8(out, 0)
        pre = pre + 1
    W16(out, 1280)
    W16(out, 720)
    W32(out, 0x00480000)
    W32(out, 0x00700000)
    W32(out, 0)
    W16(out, 1)
    var comp: int32 = 0
    while comp < 32:
        W8(out, 0)
        comp = comp + 1
    W16(out, 24)
    W16(out, 65535)
    let avcCPos = BoxBegin(out, "avcC")
    W8(out, 1)
    W8(out, inp.sps[1])
    W8(out, inp.sps[2])
    W8(out, inp.sps[3])
    W8(out, 255)
    W8(out, 225)
    W16(out, inp.sps.len)
    WBytesBytes(out, inp.sps)
    W8(out, 1)
    W16(out, inp.pps.len)
    WBytesBytes(out, inp.pps)
    BoxEnd(out, avcCPos)
    BoxEnd(out, avc1Pos)
    BoxEnd(out, vStsdPos)
    let vSttsPos = WFullBox(out, "stts", 0, 0)
    W32(out, 1)
    W32(out, inp.videoSizes.len)
    W32(out, Mp4FrameDelta)
    BoxEnd(out, vSttsPos)
    let vStscPos = WFullBox(out, "stsc", 0, 0)
    W32(out, 1)
    W32(out, 1)
    W32(out, inp.videoSizes.len)
    W32(out, 1)
    BoxEnd(out, vStscPos)
    let vStszPos = WFullBox(out, "stsz", 0, 0)
    W32(out, 0)
    W32(out, inp.videoSizes.len)
    var vs: int32 = 0
    while vs < inp.videoSizes.len:
        W32(out, inp.videoSizes[vs])
        vs = vs + 1
    BoxEnd(out, vStszPos)
    let vStcoPos = WFullBox(out, "stco", 0, 0)
    W32(out, 1)
    W32(out, videoChunkOffset)
    BoxEnd(out, vStcoPos)
    let vStssPos = WFullBox(out, "stss", 0, 0)
    var kfCount: int32 = 0
    var ki: int32 = 0
    while ki < inp.videoKf.len:
        if inp.videoKf[ki] == 1:
            kfCount = kfCount + 1
        ki = ki + 1
    W32(out, kfCount)
    ki = 0
    var kfOrdinal: int32 = 0
    while ki < inp.videoKf.len:
        kfOrdinal = kfOrdinal + 1
        if inp.videoKf[ki] == 1:
            W32(out, kfOrdinal)
        ki = ki + 1
    BoxEnd(out, vStssPos)
    BoxEnd(out, vStblPos)
    BoxEnd(out, vMinfPos)
    BoxEnd(out, vMdiaPos)
    BoxEnd(out, vTrakPos)
    # ---- audio trak (mp4a + esds) ----
    if audioHave:
        let aTrakPos = BoxBegin(out, "trak")
        let aTkhdPos = WFullBox(out, "tkhd", 0, 7)
        W32(out, 0)
        W32(out, 0)
        W32(out, 2)
        W32(out, 0)
        W32(out, inp.audioSamples)
        W32(out, 0)
        W32(out, 0)
        W16(out, 0)
        W16(out, 0)
        W16(out, 0)
        W16(out, 0)
        W32(out, 0x00010000)
        W32(out, 0)
        W32(out, 0)
        W32(out, 0)
        W32(out, 0x00010000)
        W32(out, 0)
        W32(out, 0)
        W32(out, 0)
        W32(out, 0x40000000)
        W32(out, 0)
        W32(out, 0)
        BoxEnd(out, aTkhdPos)
        let aMdiaPos = BoxBegin(out, "mdia")
        let aMdhdPos = WFullBox(out, "mdhd", 0, 0)
        W32(out, 0)
        W32(out, 0)
        W32(out, Mp4AudioTimescale)
        W32(out, inp.audioSamples)
        W32(out, 0x55C40000)
        BoxEnd(out, aMdhdPos)
        let aHdlrPos = WFullBox(out, "hdlr", 0, 0)
        W32(out, 0)
        WStr(out, "soun")
        W32(out, 0)
        W32(out, 0)
        W32(out, 0)
        WStr(out, "ChengSoundHandler")
        BoxEnd(out, aHdlrPos)
        let aMinfPos = BoxBegin(out, "minf")
        let aSmhdPos = WFullBox(out, "smhd", 0, 0)
        W16(out, 0)
        W16(out, 0)
        BoxEnd(out, aSmhdPos)
        let aDinfPos = BoxBegin(out, "dinf")
        let aDrefPos = WFullBox(out, "dref", 0, 0)
        W32(out, 1)
        let aUrlPos = WFullBox(out, "url ", 0, 1)
        BoxEnd(out, aUrlPos)
        BoxEnd(out, aDrefPos)
        BoxEnd(out, aDinfPos)
        let aStblPos = BoxBegin(out, "stbl")
        let aStsdPos = WFullBox(out, "stsd", 0, 0)
        W32(out, 1)
        let mp4aPos = BoxBegin(out, "mp4a")
        var az: int32 = 0
        while az < 6:
            W8(out, 0)
            az = az + 1
        W16(out, 1)
        # AudioSampleEntry: version(2) + revision(2) + vendor(4) = 8 bytes
        W16(out, 0)
        W16(out, 0)
        W32(out, 0)
        W16(out, 1)
        W16(out, 16)
        W16(out, 0)
        W16(out, 0)
        # samplerate 16.16: 48000<<16 overflows int32, write the halves
        W16(out, Mp4AudioTimescale)
        W16(out, 0)
        let esdsPos = BoxBegin(out, "esds")
        W32(out, 0)
        W8(out, 3)
        # ES_Descriptor content: ES_ID(2) + flags(1) + DecoderConfigDescr
        # (2+20) + SLConfigDescr (3) = 28
        W8(out, 28)
        W16(out, 1)
        W8(out, 0)
        W8(out, 4)
        W8(out, 20)
        W8(out, 64)
        W8(out, 21)
        # bufferSizeDB is a 24-bit field
        W8(out, 0)
        W16(out, 0)
        W32(out, 96000)
        W32(out, 96000)
        W8(out, 5)
        W8(out, 2)
        WAudioSpecificConfig(out)
        W8(out, 6)
        W8(out, 1)
        W8(out, 2)
        BoxEnd(out, esdsPos)
        BoxEnd(out, mp4aPos)
        BoxEnd(out, aStsdPos)
        let aSttsPos = WFullBox(out, "stts", 0, 0)
        W32(out, 1)
        W32(out, inp.audioSizes.len)
        W32(out, 1024)
        BoxEnd(out, aSttsPos)
        let aStscPos = WFullBox(out, "stsc", 0, 0)
        W32(out, 1)
        W32(out, 1)
        W32(out, inp.audioSizes.len)
        W32(out, 1)
        BoxEnd(out, aStscPos)
        let aStszPos = WFullBox(out, "stsz", 0, 0)
        W32(out, 0)
        W32(out, inp.audioSizes.len)
        var asz: int32 = 0
        while asz < inp.audioSizes.len:
            W32(out, inp.audioSizes[asz])
            asz = asz + 1
        BoxEnd(out, aStszPos)
        let aStcoPos = WFullBox(out, "stco", 0, 0)
        W32(out, 1)
        W32(out, audioChunkOffset)
        BoxEnd(out, aStcoPos)
        BoxEnd(out, aStblPos)
        BoxEnd(out, aMinfPos)
        BoxEnd(out, aMdiaPos)
        BoxEnd(out, aTrakPos)
    BoxEnd(out, moovPos)
    os.WriteFileBytes(path, out)
