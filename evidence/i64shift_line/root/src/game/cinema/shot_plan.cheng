# Shot plan (F-c): the film-edit schema — per-shot camera windows plus a
# subtitle timeline, both validated for monotonic non-overlapping ticks.
# The edit main loop consumes a plan to pick the camera and overlay per
# frame; nothing else may choose cameras.
const
    ShotPlanSchema = "cheng.game.cinema.shot_plan.v1"

type
    ShotPlan =
        shotCount: int32
        camPx: float64[]
        camPy: float64[]
        camPz: float64[]
        camTx: float64[]
        camTy: float64[]
        camTz: float64[]
        camFocal: float64[]
        startTick: int64[]
        endTick: int64[]
        label: str[]
        subCount: int32
        subStart: int64[]
        subEnd: int64[]
        subText: str[]

fn ShotPlanReset(p: var ShotPlan) =
    p.shotCount = 0
    setLen(p.camPx, 0)
    setLen(p.camPy, 0)
    setLen(p.camPz, 0)
    setLen(p.camTx, 0)
    setLen(p.camTy, 0)
    setLen(p.camTz, 0)
    setLen(p.camFocal, 0)
    setLen(p.startTick, 0)
    setLen(p.endTick, 0)
    setLen(p.label, 0)
    p.subCount = 0
    setLen(p.subStart, 0)
    setLen(p.subEnd, 0)
    setLen(p.subText, 0)

fn ShotPlanAddShot(p: var ShotPlan,
                   px: float64, py: float64, pz: float64,
                   tx: float64, ty: float64, tz: float64,
                   focal: float64,
                   startTick: int64, endTick: int64,
                   label: str) =
    add(p.camPx, px)
    add(p.camPy, py)
    add(p.camPz, pz)
    add(p.camTx, tx)
    add(p.camTy, ty)
    add(p.camTz, tz)
    add(p.camFocal, focal)
    add(p.startTick, startTick)
    add(p.endTick, endTick)
    add(p.label, label)
    p.shotCount = p.shotCount + 1

fn ShotPlanAddSubtitle(p: var ShotPlan,
                       startTick: int64, endTick: int64, text: str) =
    add(p.subStart, startTick)
    add(p.subEnd, endTick)
    add(p.subText, text)
    p.subCount = p.subCount + 1

# Window helpers: the shot/sub active at a tick, or -1.
@borrows
fn ShotPlanShotAt(p: ShotPlan, tick: int64): int32 =
    var i: int32 = 0
    while i < p.shotCount:
        if tick >= p.startTick[i] && tick <= p.endTick[i]:
            return i
        i = i + 1
    return -1

@borrows
fn ShotPlanSubtitleAt(p: ShotPlan, tick: int64): int32 =
    var i: int32 = 0
    while i < p.subCount:
        if tick >= p.subStart[i] && tick <= p.subEnd[i]:
            return i
        i = i + 1
    return -1

# Valid: shot windows in order, no gaps or overlaps; subtitle windows
# non-overlapping; labels/captions non-empty.
@borrows
fn ShotPlanValid(p: ShotPlan): bool =
    if p.shotCount <= 0:
        return false
    var prevEnd: int64 = int64(-1)
    var i: int32 = 0
    while i < p.shotCount:
        if p.startTick[i] > p.endTick[i]:
            return false
        if i > 0:
            if p.startTick[i] != prevEnd + int64(1):
                return false
        prevEnd = p.endTick[i]
        if p.label[i].len == 0:
            return false
        i = i + 1
    var a: int32 = 0
    while a < p.subCount:
        if p.subStart[a] > p.subEnd[a]:
            return false
        var b: int32 = 0
        while b < p.subCount:
            if b != a:
                if p.subStart[b] < p.subEnd[a] && p.subStart[a] < p.subEnd[b]:
                    return false
            b = b + 1
        a = a + 1
    return true
