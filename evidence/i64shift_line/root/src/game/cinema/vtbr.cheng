# Darwin media encoder session (D3): pure-Cheng VideoToolbox H.264
# compression via direct system-symbol imports. The platform callback
# (encoder-internal queue) only retains CMSampleBuffer references into a
# fixed C-heap table; all byte extraction, parameter-set capture, sample
# sizes and keyframe flags are drained on the Cheng main thread after
# CompleteFrames — no races, no Cheng-managed memory on foreign threads.
# All timestamps, packet tables and MP4 boxes are computed in Cheng.
import std/rawbytes
import std/os
import std/strings as strings

type
    UInt8Ptr = uint8 *
    Int32Ptr = int32 *
    CMTime = object
        value: int64
        timescale: int32
        flagsPad: int32
        epoch: int64

const
    CodecH264 = 1635148593
    PixelFormatBGRA = 1111970369
    PayloadCapBytes = 67108864
    MaxSamples = 4096

@importc("VTCompressionSessionCreate")
fn vtSessionCreate(allocator: ptr, w: int32, h: int32, codecType: int32,
                   encoderSpec: ptr, srcAttrs: ptr, dstAttrs: ptr,
                   outputCallback: ptr, refCon: ptr, sessionOut: ptr): int32
@importc("VTCompressionSessionPrepareToEncodeFrames")
fn vtSessionPrepare(session: ptr): int32
@importc("VTCompressionSessionEncodeFrame")
fn vtSessionEncodeFrame(session: ptr, imageBuffer: ptr,
                        pts: CMTime, dur: CMTime,
                        frameProps: ptr, infoOut: ptr, outSample: ptr): int32
@importc("VTCompressionSessionCompleteFrames")
fn vtSessionCompleteFrames(session: ptr, invalidTime: CMTime): int32
@importc("VTCompressionSessionInvalidate")
fn vtSessionInvalidate(session: ptr)
@importc("CVPixelBufferCreate")
fn cvPixelBufferCreate(allocator: ptr, w: int32, h: int32, fmt: int32, attrs: ptr, pbOut: ptr): int32
@importc("CVPixelBufferLockBaseAddress")
fn cvPixelBufferLock(pb: ptr, flags: int32): int32
@importc("CVPixelBufferUnlockBaseAddress")
fn cvPixelBufferUnlock(pb: ptr, flags: int32): int32
@importc("CVPixelBufferGetBaseAddress")
fn cvPixelBufferBase(pb: ptr): ptr
@importc("CVPixelBufferGetBytesPerRow")
fn cvPixelBufferBytesPerRow(pb: ptr): int32
@importc("CVPixelBufferRelease")
fn cvPixelBufferRelease(pb: ptr)
@importc("CMVideoFormatDescriptionGetH264ParameterSetAtIndex")
fn cmH264ParamSet(desc: ptr, index: int64, outPtr: ptr, outSize: ptr, outCount: ptr, flagsOut: ptr): int32
@importc("CMSampleBufferGetFormatDescription")
fn cmSampleFormatDescription(sample: ptr): ptr
@importc("CMSampleBufferGetDataBuffer")
fn cmSampleDataBuffer(sample: ptr): ptr
@importc("CMBlockBufferGetDataLength")
fn cmBlockBufferLength(blockBuf: ptr): int32
@importc("CMBlockBufferCopyDataBytes")
fn cmBlockBufferCopy(blockBuf: ptr, offset: int64, length: int64, dst: ptr): int32
@importc("memcpy")
fn cMemcpy(dst: ptr, src: ptr, n: int64): ptr
@importc("calloc")
fn cCalloc(n: int64, size: int64): ptr
@importc("usleep")
fn USleep(value: uint32): int32
@importc("CFRetain")
fn CFRetain(cf: ptr)
@importc("CFRelease")
fn CFRelease(cf: ptr)
@importc("cheng_ptr_plus")
fn PtrPlusBase(base: ptr, off: int32): ptr
@importc("VTSessionSetProperty")
fn vtSessionSetPropertyNumber(session: ptr, key: ptr, value: ptr): int32
@importc("CFNumberCreate")
fn cfNumberCreate(allocator: ptr, kind: int32, valuePtr: ptr): ptr
@importc("CFRelease")
fn cfRelease(cf: ptr)
@importc("dlopen")
fn dlOpenPath(path: str, mode: int32): ptr
@importc("dlsym")
fn dlSymNative(handle: ptr, symbol: str): ptr

fn CtxLoadI32(ctx: ptr, off: int32): int32 =
    var v: int32 = 0
    let _c = cMemcpy(ptr(&v), PtrPlusBase(ctx, off), 4)
    return v

fn CtxStoreI32(ctx: ptr, off: int32, v: int32) =
    let _c = cMemcpy(PtrPlusBase(ctx, off), ptr(&v), 4)

fn CtxLoadPtr(ctx: ptr, off: int32): ptr =
    var p: ptr = nil
    let _c = cMemcpy(ptr(&p), PtrPlusBase(ctx, off), 8)
    return p

fn CtxStorePtr(ctx: ptr, off: int32, p: ptr) =
    let _c = cMemcpy(PtrPlusBase(ctx, off), ptr(&p), 8)

# VTCompressionOutputCallback ABI: retain the sample and count it. All
# byte extraction happens on the Cheng main thread during drain.
@exportc("cheng_csg_world_vt_output")
fn chengCsgWorldVtOutput(refCon: ptr, reserved: ptr, status: int32, info: int32, sample: ptr): int32 =
    if refCon == nil:
        return 0
    if status != 0:
        return 0
    let frameCount = CtxLoadI32(refCon, 0)
    if frameCount < MaxSamples:
        let samplesPtr = CtxLoadPtr(refCon, 96)
        CFRetain(sample)
        CtxStorePtr(samplesPtr, 8 * frameCount, sample)
        CtxStoreI32(refCon, 0, frameCount + 1)
    return 0

# Video session context layout (128-byte calloc block):
#   0 frameCount, 8 payloadLen, 12 payloadCap, 16 payloadPtr,
#   24 sizesPtr, 32 kfPtr, 72 spsPtr, 80 ppsPtr, 88 samplesPtr,
#   96 sessionPtr.
fn VtbrVideoSessionCreate(w: int32, h: int32): ptr =
    let ctx: ptr = cCalloc(1, 128)
    if ctx == nil:
        return nil
    let payload: ptr = cCalloc(1, int64(PayloadCapBytes))
    let sizes: ptr = cCalloc(int64(MaxSamples), 4)
    let kf: ptr = cCalloc(int64(MaxSamples), 4)
    let samples: ptr = cCalloc(int64(MaxSamples), 8)
    let sps: ptr = cCalloc(1, 128)
    let pps: ptr = cCalloc(1, 128)
    CtxStoreI32(ctx, 12, int32(PayloadCapBytes))
    CtxStorePtr(ctx, 16, payload)
    CtxStorePtr(ctx, 24, sizes)
    CtxStorePtr(ctx, 32, kf)
    CtxStorePtr(ctx, 72, sps)
    CtxStorePtr(ctx, 80, pps)
    CtxStorePtr(ctx, 96, samples)
    var session: ptr = nil
    let rc = vtSessionCreate(nil, w, h, CodecH264, nil, nil, nil,
        chengCsgWorldVtOutput, ctx, ptr(&session))
    if rc != 0:
        return nil
    CtxStorePtr(ctx, 88, session)
    # periodic IDR (keyframe every 240 frames) so the stream has random
    # access points and the first frame is an IDR
    let vtHandle: ptr = dlOpenPath("/System/Library/Frameworks/VideoToolbox.framework/VideoToolbox", 2)
    if vtHandle != nil:
        let kfKey: ptr = dlSymNative(vtHandle, "kVTCompressionPropertyKey_KeyFrameInterval")
        if kfKey != nil:
            var interval: int32 = 240
            var intNum: ptr = cfNumberCreate(nil, 4, ptr(&interval))
            let _s1 = vtSessionSetPropertyNumber(session, kfKey, intNum)
            CFRelease(intNum)
    if vtSessionPrepare(session) != 0:
        return nil
    return ctx

fn VtbrVideoSessionSession(ctx: ptr): ptr =
    return CtxLoadPtr(ctx, 88)

fn VtbrVideoSessionSampleCount(ctx: ptr): int32 =
    return CtxLoadI32(ctx, 0)

# Encode one BGRA frame; ptsNum ticks at 1/24000 s.
fn VtbrVideoEncodeBgra(ctx: ptr, bgra: ptr, strideBytes: int32,
                       w: int32, h: int32, ptsNum: int32): int32 =
    let session = CtxLoadPtr(ctx, 88)
    var pb: ptr = nil
    if cvPixelBufferCreate(nil, w, h, PixelFormatBGRA, nil, ptr(&pb)) != 0:
        return 1
    let _l = cvPixelBufferLock(pb, 0)
    let dst = cvPixelBufferBase(pb)
    let dstStride = cvPixelBufferBytesPerRow(pb)
    var r: int32 = 0
    while r < h:
        let _c = cMemcpy(PtrPlusBase(dst, r * dstStride), PtrPlusBase(bgra, r * (w * 4)), int64(w * 4))
        r = r + 1
    let _u = cvPixelBufferUnlock(pb, 0)
    let pts: CMTime = CMTime(value: int64(ptsNum), timescale: 24000, flagsPad: 0, epoch: 0)
    let dur: CMTime = CMTime(value: int64(1000), timescale: 24000, flagsPad: 0, epoch: 0)
    let rc = vtSessionEncodeFrame(session, pb, pts, dur, nil, nil, nil)
    cvPixelBufferRelease(pb)
    if rc != 0:
        return 1
    return 0

fn VtbrVideoFinish(ctx: ptr): int32 =
    let session = CtxLoadPtr(ctx, 88)
    let invalidTime: CMTime = CMTime(value: int64(0), timescale: 0, flagsPad: 0, epoch: 0)
    let rc = vtSessionCompleteFrames(session, invalidTime)
    var spins: int32 = 0
    while spins < 100:
        let _w = USleep(20000)
        spins = spins + 1
    return rc

# Main-thread drain (call after CompleteFrames): walk the retained
# samples, copy AVCC bytes into the payload, record sizes/keyframe flags,
# capture SPS/PPS from the first format description, then release.
fn VtbrVideoDrain(ctx: ptr): int32 =
    let n = CtxLoadI32(ctx, 0)
    let samplesPtr = CtxLoadPtr(ctx, 96)
    let payloadPtr = CtxLoadPtr(ctx, 16)
    let payloadCap = CtxLoadI32(ctx, 12)
    let sizesPtr = CtxLoadPtr(ctx, 24)
    let kfPtr = CtxLoadPtr(ctx, 32)
    let spsPtr = CtxLoadPtr(ctx, 72)
    let ppsPtr = CtxLoadPtr(ctx, 80)
    var payloadLen: int32 = 0
    var outSamples: int32 = 0
    var i: int32 = 0
    while i < n:
        let sample = CtxLoadPtr(samplesPtr, 8 * i)
        var ok: bool = false
        if sample != nil:
            let blockBuf = cmSampleDataBuffer(sample)
            let total = cmBlockBufferLength(blockBuf)
            if total > 0 && payloadLen + total <= payloadCap:
                let _c = cmBlockBufferCopy(blockBuf, int64(0), int64(total), PtrPlusBase(payloadPtr, int32(payloadLen)))
                # a sample is a picture when ANY contained NAL is a slice
                var hasSlice: bool = false
                var isIdr: bool = false
                var t0: int32 = 0
                var q: int32 = 0
                while q + 4 <= total:
                    let b0: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + q))))
                    let b1: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + q + 1))))
                    let b2: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + q + 2))))
                    let b3: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + q + 3))))
                    let nl: int32 = b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
                    if nl <= 0:
                        break
                    let t: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + q + 4)))) % 32
                    if q == 0:
                        t0 = t
                    if t == 1 || t == 5:
                        hasSlice = true
                    if t == 5:
                        isIdr = true
                    q = q + 4 + nl
                echo("DBG s i=" + strings.IntToStr(i) + " total=" + strings.IntToStr(total) + " nal0=" + strings.IntToStr(t0) + " hasSlice=" + strings.IntToStr(int32(hasSlice)))
                if hasSlice:
                    if outSamples == 0:
                        # first kept sample: drop the leading non-slice NALs
                        var qq: int32 = 0
                        while qq + 4 <= total:
                            let c0: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + qq))))
                            let c1: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + qq + 1))))
                            let c2: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + qq + 2))))
                            let c3: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + qq + 3))))
                            let nl: int32 = c0 * 16777216 + c1 * 65536 + c2 * 256 + c3
                            if nl <= 0:
                                break
                            let tt: int32 = int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, int32(payloadLen) + qq + 4)))) % 32
                            if tt == 1 || tt == 5:
                                if qq > 0:
                                    let _mv = cMemcpy(PtrPlusBase(payloadPtr, 0), PtrPlusBase(payloadPtr, int32(payloadLen) + qq), int64(total - qq))
                                    total = total - qq
                                break
                            qq = qq + 4 + nl
                    CtxStoreI32(sizesPtr, 4 * outSamples, total)
                    if isIdr:
                        CtxStoreI32(kfPtr, 4 * outSamples, 1)
                    else:
                        CtxStoreI32(kfPtr, 4 * outSamples, 0)
                    outSamples = outSamples + 1
                    payloadLen = payloadLen + total
                    if outSamples == 1:
                        let firstDesc = cmSampleFormatDescription(sample)
                        if firstDesc != nil:
                            var size0: int64 = 0
                            var size1: int64 = 0
                            var count0: int64 = 0
                            var spsReal: ptr = nil
                            var ppsReal: ptr = nil
                            let rc0 = cmH264ParamSet(firstDesc, int64(0), ptr(&spsReal), ptr(&size0), ptr(&count0), nil)
                            let rc1 = cmH264ParamSet(firstDesc, int64(1), ptr(&ppsReal), ptr(&size1), ptr(&count0), nil)
                            if rc0 == 0 && rc1 == 0 && spsReal != nil && ppsReal != nil && size0 > 0 && size1 > 0 && size0 <= 120 && size1 <= 120:
                                let _c0 = cMemcpy(spsPtr, spsReal, size0)
                                let _c1 = cMemcpy(ppsPtr, ppsReal, size1)
                                CtxStoreI32(ctx, 40, int32(size0))
                                CtxStoreI32(ctx, 44, int32(size1))
        # release the retained sample (after its bytes are in the payload)
        if sample != nil:
            let _rel = CFRelease(sample)
        i = i + 1
    # parameter sets from the first PICTURE sample's description: capture
    # before releasing (inside the loop would also work; here the first
    # picture sample is still retained until after its own release pass,
    # so capture from samplesPtr[0] before the release of that index)
    CtxStoreI32(ctx, 8, int32(payloadLen))
    CtxStoreI32(ctx, 0, outSamples)
    os.WriteFile("/tmp/csgw_drain_dump.txt", "payloadLen=" + strings.IntToStr(payloadLen) + " p0=" + strings.IntToStr(int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, 0))))) + " p4=" + strings.IntToStr(int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, 4))))) + " p5=" + strings.IntToStr(int32(*(UInt8Ptr(PtrPlusBase(payloadPtr, 5))))) + " outSamples=" + strings.IntToStr(outSamples))
    return outSamples

# ---- readout: copy encoder outputs from the C-heap blocks into Cheng ----
fn VtbrVideoCopyPayload(ctx: ptr, dst: var uint8[]) =
    let src = CtxLoadPtr(ctx, 16)
    let n = CtxLoadI32(ctx, 8)
    setLen(dst, n)
    var i: int32 = 0
    while i < n:
        dst[i] = uint8(int32(*(UInt8Ptr(PtrPlusBase(src, i)))))
        i = i + 1

fn VtbrVideoCopySizes(ctx: ptr, dst: var int32[]) =
    let src = CtxLoadPtr(ctx, 24)
    let n = CtxLoadI32(ctx, 0)
    setLen(dst, n)
    var i: int32 = 0
    while i < n:
        dst[i] = int32(*(Int32Ptr(PtrPlusBase(src, i * 4))))
        i = i + 1

fn VtbrVideoCopyKeyframes(ctx: ptr, dst: var int32[]) =
    let src = CtxLoadPtr(ctx, 32)
    let n = CtxLoadI32(ctx, 0)
    setLen(dst, n)
    var i: int32 = 0
    while i < n:
        dst[i] = int32(*(Int32Ptr(PtrPlusBase(src, i * 4))))
        i = i + 1

fn VtbrVideoCopyParamSets(ctx: ptr, spsDst: var uint8[], ppsDst: var uint8[]) =
    let spsPtr = CtxLoadPtr(ctx, 72)
    let ppsPtr = CtxLoadPtr(ctx, 80)
    let spsLen = CtxLoadI32(ctx, 40)
    let ppsLen = CtxLoadI32(ctx, 44)
    setLen(spsDst, spsLen)
    setLen(ppsDst, ppsLen)
    var i: int32 = 0
    while i < spsLen:
        spsDst[i] = uint8(int32(*(UInt8Ptr(PtrPlusBase(spsPtr, i)))))
        i = i + 1
    var j: int32 = 0
    while j < ppsLen:
        ppsDst[j] = uint8(int32(*(UInt8Ptr(PtrPlusBase(ppsPtr, j)))))
        j = j + 1
