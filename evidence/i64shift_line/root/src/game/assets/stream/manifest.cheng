# CSG 场景流容器 (StreamManifest v1)。
#
# 合同 (campaigns/2026-09-06-csg-asset-pipeline/task_scene_stream.md):
# 时间轴切片化场景资产流。magic "SSM1" + version 1 + chunkCount + 变长 chunk
# 条目 (startMs/durationMs/isKeyframe/cidLen+cidHex/payloadLen/payloadOffset,
# 全小端) + 末尾 audioTrackRef (cidLen+cidHex, 0=无音轨)。chunk 覆盖半开区间
# [start, start+dur), 允许间隙, 单调不重叠。按时间二分定位; 关键帧 seek 取
# <=t 的最近关键帧 (解析期构建前缀数组, 查询 O(1))。payload v1 为不透明字节。
# 全部非法输入 (magic/版本/截断/越界/超配额/时间轴非法/尾部垃圾) 显式 false,
# 无兜底无部分结果。i64 读取按两次 u32 组合并重建符号。
import std/rawbytes
import cheng/game/assets/import/reader

# 冻结配额 (对齐 csg-asset-import-contract §4): manifest 文件 <= 256MiB,
# chunkCount <= 1e6。超配额显式拒绝, 不截断。
fn StreamManifestQuotaMaxBytes(): int64 =
    return int64(268435456)

fn StreamManifestQuotaMaxChunks(): int32 =
    return 1000000

# v1 冻结: chunk 与音轨 CID 为 64 字符小写 hex 内容 CID。
fn StreamManifestCidLenV1(): int32 =
    return 64

type
    StreamChunk =
        index: int32
        startMs: int64
        durationMs: int64
        isKeyframe: bool
        cid: str
        payloadLen: int64
        payloadOffset: int64

    # SoA 存储; keyframeBefore[i] = 位置 <=i 的最近关键帧 chunk 索引, 无则 -1。
    StreamManifest =
        ok: bool
        chunkCount: int32
        startMs: int64[]
        durationMs: int64[]
        keyframe: int32[]
        keyframeBefore: int32[]
        cid: str[]
        payloadLen: int64[]
        payloadOffset: int64[]
        audioCid: str             # 空串 = 无音轨
        totalDurationMs: int64    # start[last] + duration[last]

# i64 小端读取: 两次 u32 组合, hi>=2^31 时按补码重建负值 (随后由范围契约拒绝)。
@borrows
fn StreamManifestI64At(data: rawbytes.Bytes, offset: int32, out: var int64): bool =
    var lo: int64
    var hi: int64
    if !reader.AssetReaderU32At(data, offset, lo):
        return false
    if !reader.AssetReaderU32At(data, offset + 4, hi):
        return false
    if hi >= int64(2147483648):
        out = lo + ((hi - int64(4294967296)) * int64(4294967296))
    else:
        out = lo + (hi * int64(4294967296))
    return true

# 小写 hex 字节 ([0-9a-f])。
fn StreamManifestHexByte(c: int32): bool =
    if c >= Int32('0') && c <= Int32('9'):
        return true
    if c >= Int32('a') && c <= Int32('f'):
        return true
    return false

# 解析 (manifest-only 形态): 尾部 = audioRef 后恰为 EOF。
@borrows
fn StreamManifestParse(data: rawbytes.Bytes, outM: var StreamManifest): bool =
    return StreamManifestParseEx(data, outM, false)

# 解析 (单文件内嵌 payload 形态): 尾部 = payload 区按序无缝恰好覆盖。
@borrows
fn StreamManifestParseEmbedded(data: rawbytes.Bytes,
                               outM: var StreamManifest): bool =
    return StreamManifestParseEx(data, outM, true)

# 解析 (单文件内嵌 payload 形态, task_ssm1_pack.md §3): audioRef 之后为
# payload 区, 须被各 chunk 按序无缝恰好覆盖 (offset 依次相接, 终点=EOF)。
# 失败时 outM 复位零值, 不返回半解析结果。
# 偏移收窄 int32 前有配额证明: n64 <= 256MiB < 2^31, 所有 cursor < n64。
@borrows
fn StreamManifestParseEx(data: rawbytes.Bytes, outM: var StreamManifest,
                         embedded: bool): bool =
    var fresh: StreamManifest
    outM = fresh
    let n64 = int64(rawbytes.BytesLen(data))
    if n64 > StreamManifestQuotaMaxBytes():
        return false
    if n64 < int64(12):
        return false
    if rawbytes.BytesGet(data, 0) != Int32('S'):
        return false
    if rawbytes.BytesGet(data, 1) != Int32('S'):
        return false
    if rawbytes.BytesGet(data, 2) != Int32('M'):
        return false
    if rawbytes.BytesGet(data, 3) != Int32('1'):
        return false
    var version: int64
    if !reader.AssetReaderU32At(data, 4, version):
        return false
    if version != int64(1):
        return false
    var count64: int64
    if !reader.AssetReaderU32At(data, 8, count64):
        return false
    if count64 < int64(1) || count64 > int64(StreamManifestQuotaMaxChunks()):
        return false
    var m: StreamManifest
    m.chunkCount = int32(count64)
    var cursor: int64
    cursor = int64(12)
    var prevEnd: int64
    prevEnd = int64(0)
    for i in 0..<m.chunkCount:
        var startMs: int64
        if !StreamManifestI64At(data, int32(cursor), startMs):
            return false
        if startMs < int64(0):
            return false
        var durationMs: int64
        if !StreamManifestI64At(data, int32(cursor + 8), durationMs):
            return false
        if durationMs < int64(0):
            return false
        # 单调不重叠: 间隙允许; start+dur 溢出 int64 显式拒绝。
        if startMs < prevEnd:
            return false
        if durationMs > int64(9223372036854775807) - startMs:
            return false
        prevEnd = startMs + durationMs
        cursor = cursor + 16
        var kf: int32
        if cursor >= n64:
            return false
        kf = rawbytes.BytesGet(data, int32(cursor))
        if kf != 0 && kf != 1:
            return false
        cursor = cursor + 1
        var cidLen: int64
        if !reader.AssetReaderU32At(data, int32(cursor), cidLen):
            return false
        cursor = cursor + 4
        if cidLen != int64(StreamManifestCidLenV1()):
            return false
        if cursor + cidLen > n64:
            return false
        for k in 0..<StreamManifestCidLenV1():
            if !StreamManifestHexByte(rawbytes.BytesGet(data, int32(cursor) + k)):
                return false
        add(m.cid, rawbytes.BytesToString(
            rawbytes.BytesSliceView(data, int32(cursor), StreamManifestCidLenV1())))
        cursor = cursor + cidLen
        var payloadLen: int64
        if !StreamManifestI64At(data, int32(cursor), payloadLen):
            return false
        if payloadLen < int64(0):
            return false
        var payloadOffset: int64
        if !StreamManifestI64At(data, int32(cursor + 8), payloadOffset):
            return false
        if payloadOffset < int64(0):
            return false
        # 宽域越界判定: offset+len <= 文件总长, 两操作数非负无溢出。
        if payloadLen > n64 - payloadOffset:
            return false
        cursor = cursor + 16
        add(m.startMs, startMs)
        add(m.durationMs, durationMs)
        add(m.keyframe, kf)
        add(m.payloadLen, payloadLen)
        add(m.payloadOffset, payloadOffset)
    # 末尾 audioTrackRef: 0 = 无音轨; 否则 v1 冻结 64 hex。
    var audioLen: int64
    if !reader.AssetReaderU32At(data, int32(cursor), audioLen):
        return false
    cursor = cursor + 4
    if audioLen != int64(0):
        if audioLen != int64(StreamManifestCidLenV1()):
            return false
        if cursor + audioLen > n64:
            return false
        for k in 0..<StreamManifestCidLenV1():
            if !StreamManifestHexByte(rawbytes.BytesGet(data, int32(cursor) + k)):
                return false
        m.audioCid = rawbytes.BytesToString(
            rawbytes.BytesSliceView(data, int32(cursor), StreamManifestCidLenV1()))
        cursor = cursor + audioLen
    if embedded:
        # 内嵌 payload 形态: payload 区按序无缝恰好覆盖 [cursor, n64)。
        var expected: int64
        expected = cursor
        for i in 0..<m.chunkCount:
            if m.payloadOffset[i] != expected:
                return false
            expected = expected + m.payloadLen[i]
        if expected != n64:
            return false
    else:
        if cursor != n64:
            return false
    m.totalDurationMs = prevEnd
    var lastKf: int32
    lastKf = -1
    for i in 0..<m.chunkCount:
        if m.keyframe[i] == 1:
            lastKf = i
        add(m.keyframeBefore, lastKf)
    m.ok = true
    outM = m
    return true

# 文件入口: 复用 reader 有界读取, 套用本容器 256MiB 配额。
@borrows
fn StreamManifestLoadFile(path: str, outM: var StreamManifest): bool =
    var fresh: StreamManifest
    outM = fresh
    var bounds = reader.AssetReaderBoundsFor("manifest")
    bounds.maxBytes = StreamManifestQuotaMaxBytes()
    var data = rawbytes.EmptyBytes()
    if !reader.AssetReaderLoadBounded(path, bounds, data):
        return false
    defer:
        rawbytes.BytesFree(data)
    return StreamManifestParseEx(data, outM, false)

# 文件入口 (单文件内嵌 payload 形态): 其余同 StreamManifestLoadFile。
@borrows
fn StreamManifestLoadFileEmbedded(path: str, outM: var StreamManifest): bool =
    var fresh: StreamManifest
    outM = fresh
    var bounds = reader.AssetReaderBoundsFor("manifest")
    bounds.maxBytes = StreamManifestQuotaMaxBytes()
    var data = rawbytes.EmptyBytes()
    if !reader.AssetReaderLoadBounded(path, bounds, data):
        return false
    defer:
        rawbytes.BytesFree(data)
    return StreamManifestParseEx(data, outM, true)

@borrows
fn StreamManifestChunkCount(m: StreamManifest): int32 =
    return m.chunkCount

@borrows
fn StreamManifestTotalDurationMs(m: StreamManifest): int64 =
    return m.totalDurationMs

@borrows
fn StreamManifestChunkAt(m: StreamManifest, index: int32,
                         outChunk: var StreamChunk): bool =
    var fresh: StreamChunk
    outChunk = fresh
    if !m.ok:
        return false
    if index < 0 || index >= m.chunkCount:
        return false
    outChunk.index = index
    outChunk.startMs = m.startMs[index]
    outChunk.durationMs = m.durationMs[index]
    outChunk.isKeyframe = m.keyframe[index] == 1
    outChunk.cid = m.cid[index]
    outChunk.payloadLen = m.payloadLen[index]
    outChunk.payloadOffset = m.payloadOffset[index]
    return true

# 二分: startMs <= t 的最后一个 chunk; t 早于首 chunk 起点 => -1。
# 搜索空间 [lo, hi), 迭代 21 次, chunkCount <= 1e6 < 2^20 保证收敛;
# 收敛后 lo==hi 不再取索引, 无越界读。
@borrows
fn StreamManifestChunkIndexForTime(m: StreamManifest, tms: int64): int32 =
    if !m.ok || m.chunkCount <= 0:
        return -1
    if tms < m.startMs[0]:
        return -1
    var lo: int32
    lo = 0
    var hi: int32
    hi = m.chunkCount
    for step in 0..<21:
        if lo < hi:
            var mid: int32
            mid = (lo + hi) / 2
            if m.startMs[mid] <= tms:
                lo = mid + 1
            else:
                hi = mid
    return lo - 1

# <=t 的最近关键帧 chunk 索引 (关键帧时间 = 该 chunk startMs); 无则 -1。
@borrows
fn StreamManifestNearestKeyframeIndexForTime(m: StreamManifest,
                                             tms: int64): int32 =
    let p = StreamManifestChunkIndexForTime(m, tms)
    if p < 0:
        return -1
    return m.keyframeBefore[p]
