# SSM1 场景流 -> MoQ 段流秒开编排 (opensmoke)。
#
# 单一事实源: 4-chunk SSM1 v1 manifest 字节 (纯头, audioRef 即 EOF) + 独立
# 载荷 blob。v1 冻结合同: audioTrackRef 结束位置必须恰好等于 manifest 文件
# 末尾 (尾部多余字节显式拒绝), payload 范围校验以 manifest 文件长度为界
# (offset+len <= manifestLen), 因此载荷声明域落在 [0, manifestLen) 内。
# 服务侧注册两个 MoQ 段: manifest 段 = manifest 字节 [0, 484); 首关键帧
# chunk 段 = 载荷 blob 内 manifest 声明的 range [kfOffset, kfLen)。客户侧
# 顺序: 取 manifest 段 -> StreamManifestParse 解析 -> 定位首关键帧 -> 取
# chunk 段 -> 与独立重算的期望字节逐字节断言。确定性 payload 模式
# (chunkIndex*37 + j*11) % 251 让客户端不依赖服务端源即可验证字节一致。
import std/strings
import std/rawbytes
import std/os
import cheng/quic/native_runtime
import cheng/game/assets/stream/manifest

fn OpenSmokeChunkCount(): int32 =
    return 4

# 每chunk载荷 120 字节 (声明域 [0, 484) 内: 4*120=480 <= 484)。
fn OpenSmokeChunkPayloadLen(chunkIndex: int32): int32 =
    return 120

fn OpenSmokeChunkStartMs(chunkIndex: int32): int64 =
    return int64(chunkIndex) * int64(100)

fn OpenSmokeChunkDurationMs(): int64 =
    return int64(100)

# 关键帧位图: chunk0 与 chunk3。
fn OpenSmokeChunkIsKeyframe(chunkIndex: int32): bool =
    if chunkIndex == 0:
        return true
    if chunkIndex == 3:
        return true
    return false

# 头 = magic4 + version4 + count4 + 4*(start8+dur8+kf1+cidLen4+cid64+len8+off8)
#      + audioRef(cidLen4 + cid64) = 12 + 4*101 + 68 = 484。EOF 即此处。
fn OpenSmokeHeaderLen(): int32 =
    return 484

fn OpenSmokeManifestLen(): int32 =
    return OpenSmokeHeaderLen()

# 载荷在 blob 内的偏移 (顺序排布)。
fn OpenSmokeChunkPayloadOffset(chunkIndex: int32): int32 =
    var off: int32
    off = 0
    for i in 0..<chunkIndex:
        off = off + OpenSmokeChunkPayloadLen(i)
    return off

fn OpenSmokeBlobLen(): int32 =
    var total: int32
    total = 0
    for i in 0..<OpenSmokeChunkCount():
        total = total + OpenSmokeChunkPayloadLen(i)
    return total

# 64 字符小写 hex (数字) 内容 CID。
fn OpenSmokeCidHex(seed: int32): str =
    var parts: str[]
    for i in 0..<64:
        add(parts, strings.IntToStr((seed * 7 + i) % 10))
    var out: str
    for k in 0..<parts.len:
        out = out + parts[k]
    return out

# 确定性 payload 模式: 客户端可独立重算, 不依赖服务端源。
fn OpenSmokePayloadByteAt(chunkIndex: int32, byteIndex: int32): int32 =
    return (chunkIndex * 37 + byteIndex * 11) % 251

fn OpenSmokeAppendU32(b: var rawbytes.BytesBuilder, v: int64) =
    rawbytes.BytesBuilderAppendByte(b, int32(v % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(256)) % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(65536)) % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(16777216)) % int64(256)))

fn OpenSmokeAppendI64(b: var rawbytes.BytesBuilder, v: int64) =
    var hi: int64
    hi = v / int64(4294967296)
    OpenSmokeAppendU32(b, v % int64(4294967296))
    OpenSmokeAppendU32(b, hi)

fn OpenSmokeAppendStr(b: var rawbytes.BytesBuilder, s: str) =
    for i in 0..<len(s):
        rawbytes.BytesBuilderAppendByte(b, Int32(s[i]))

fn OpenSmokeAppendChunkEntry(b: var rawbytes.BytesBuilder, chunkIndex: int32) =
    OpenSmokeAppendI64(b, OpenSmokeChunkStartMs(chunkIndex))
    OpenSmokeAppendI64(b, OpenSmokeChunkDurationMs())
    if OpenSmokeChunkIsKeyframe(chunkIndex):
        rawbytes.BytesBuilderAppendByte(b, 1)
    else:
        rawbytes.BytesBuilderAppendByte(b, 0)
    OpenSmokeAppendU32(b, int64(64))
    OpenSmokeAppendStr(b, OpenSmokeCidHex(chunkIndex))
    OpenSmokeAppendI64(b, int64(OpenSmokeChunkPayloadLen(chunkIndex)))
    OpenSmokeAppendI64(b, int64(OpenSmokeChunkPayloadOffset(chunkIndex)))

# 服务侧注册的 manifest 段: 纯 SSM1 v1 头 (audioRef 即 EOF)。
fn OpenSmokeBuildManifestBytes(): rawbytes.Bytes =
    var b = rawbytes.BytesBuilderNew(0)
    OpenSmokeAppendStr(b, "SSM1")
    OpenSmokeAppendU32(b, int64(1))
    OpenSmokeAppendU32(b, int64(OpenSmokeChunkCount()))
    for i in 0..<OpenSmokeChunkCount():
        OpenSmokeAppendChunkEntry(b, i)
    OpenSmokeAppendU32(b, int64(64))
    OpenSmokeAppendStr(b, OpenSmokeCidHex(99))
    return rawbytes.BytesBuilderFinish(b)

# 服务侧注册的载荷 blob: 4 个 chunk payload 顺序排布。
fn OpenSmokeBuildPayloadBlob(): rawbytes.Bytes =
    var b = rawbytes.BytesBuilderNew(0)
    for i in 0..<OpenSmokeChunkCount():
        for j in 0..<OpenSmokeChunkPayloadLen(i):
            rawbytes.BytesBuilderAppendByte(b, OpenSmokePayloadByteAt(i, j))
    return rawbytes.BytesBuilderFinish(b)

# 客户端独立重算期望 chunk payload。
fn OpenSmokeExpectChunkPayload(chunkIndex: int32): rawbytes.Bytes =
    let n = OpenSmokeChunkPayloadLen(chunkIndex)
    var out = rawbytes.BytesAlloc(n)
    for j in 0..<n:
        rawbytes.BytesSet(out, j, OpenSmokePayloadByteAt(chunkIndex, j))
    return out

# 等待对端数据到达某个会话槽。native runtime 的 app-stream 二级表按全局
# CurSlot 索引, pump 分发写入的槽与 dial/accept conn token 指向的槽错位
# (token 恒为槽 0, 数据落在 pump 槽), 故读端需扫描定位数据槽后经
# ConnFromPipeIdx 构造。返回槽号; 超时返回 -1。
fn OpenSmokeWaitReadable(side: int32, streamId: int64, want: int32,
                         maxSpins: int32): int32 =
    var spins: int32
    spins = 0
    while spins < maxSpins:
        for k in 0..<6:
            native_runtime.msquicNativeBindSlotFromPipeIdx(1000001 + k)
            let avail = native_runtime.msquicNativeAppRecvAvailable(side, streamId)
            if avail >= want:
                return k
        os.sleepMs(10)
        spins = spins + 1
    return -1

# B 线解析 + 首关键帧定位合同: 取回的 manifest 段必须可解析, 且 t=0 定位到
# 关键帧 chunk 0。
@borrows
fn OpenSmokeLocateFirstKeyframe(m: manifest.StreamManifest,
                                outChunk: var manifest.StreamChunk): bool =
    var fresh: manifest.StreamChunk
    outChunk = fresh
    if !m.ok:
        return false
    let kf = manifest.StreamManifestNearestKeyframeIndexForTime(m, int64(0))
    if kf < 0:
        return false
    if !manifest.StreamManifestChunkAt(m, kf, outChunk):
        return false
    return outChunk.isKeyframe

# 逐字节相等 (取回字节 vs 期望/源 range)。
fn OpenSmokeBytesEq(left: rawbytes.Bytes, right: rawbytes.Bytes): bool =
    if rawbytes.BytesLen(left) != rawbytes.BytesLen(right):
        return false
    for i in 0..<rawbytes.BytesLen(left):
        if rawbytes.BytesGet(left, i) != rawbytes.BytesGet(right, i):
            return false
    return true

# 零拷贝 range 比较: data[offset..] 与 expect 逐字节一致。
# (BytesSliceView 返回借用视图, 绑定局部触发当前编译器 plain-copy 拒绝,
#  故 range 对比不经中间视图, 直接以 var 形参传入两个拥有值。)
@borrows
fn OpenSmokeRangeMatches(data: rawbytes.Bytes, offsetBytes: int32,
                         expect: rawbytes.Bytes): bool =
    let n = rawbytes.BytesLen(expect)
    if offsetBytes < 0:
        return false
    if offsetBytes + n > rawbytes.BytesLen(data):
        return false
    for i in 0..<n:
        if rawbytes.BytesGet(data, offsetBytes + i) != rawbytes.BytesGet(expect, i):
            return false
    return true
