import std/strings
import std/os
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_canonical as jc
import cheng/game/assets/semantic_video/schema

# v0.1 写入路径：记录 → canonical 行（逐行断言 canonicalize 恒等）→
# CsgCoreCsgcEncodeVerifiedLines 打包 → 暂存-rename 原子提交。
# 规范依据 docs/specs/csg-semantic-video-v0.1.md §5。

type
    SvLineSet =
        lines: str[]
        error: str

    SvEncodeResult =
        ok: bool
        error: str
        bytes: rawbytes.Bytes
        factCount: int32
        claimedDirectoryCid: str

@borrows
fn SvLineSetInit(): SvLineSet =
    var out: SvLineSet
    return out

@borrows
fn SvLineSetFail(set: var SvLineSet, error: str) =
    if set.error.len == 0:
        set.error = strings.CloneStr(error)

@borrows
fn SvAddVerifiedLine(set: var SvLineSet, line: str) =
    if line.len == 0:
        SvLineSetFail(set, "sv_empty_line")
        return
    let canonical = jc.CsgCoreJsonCanonicalize(line)
    if !canonical.ok:
        SvLineSetFail(set, schema.SvCat("sv_noncanonical_line ", canonical.error))
        return
    if canonical.value != line:
        SvLineSetFail(set, "sv_noncanonical_line emitter_order")
        return
    add(set.lines, strings.CloneStr(line))

@borrows
fn SvAddRecordChecked(set: var SvLineSet, line: str) =
    if set.error.len > 0:
        return
    if set.lines.len >= schema.SvMaxRecordsPerBlock:
        SvLineSetFail(set, "sv_quota_exceeded")
        return
    SvAddVerifiedLine(set, line)

@borrows
fn SvAddManifest(set: var SvLineSet, rec: schema.SvManifestRec) =
    SvAddRecordChecked(set, schema.SvManifestLine(rec))

@borrows
fn SvAddObservation(set: var SvLineSet, rec: schema.SvObservationRec) =
    SvAddRecordChecked(set, schema.SvObservationLine(rec))

@borrows
fn SvAddEntity(set: var SvLineSet, rec: schema.SvEntityRec) =
    SvAddRecordChecked(set, schema.SvEntityLine(rec))

@borrows
fn SvAddAssertion(set: var SvLineSet, rec: schema.SvAssertionRec) =
    SvAddRecordChecked(set, schema.SvAssertionLine(rec))

@borrows
fn SvAddSnapshot(set: var SvLineSet, rec: schema.SvSnapshotRec) =
    SvAddRecordChecked(set, schema.SvSnapshotLine(rec))

@borrows
fn SvAddDelta(set: var SvLineSet, rec: schema.SvDeltaRec) =
    SvAddRecordChecked(set, schema.SvDeltaLine(rec))

@borrows
fn SvAddCorrection(set: var SvLineSet, rec: schema.SvCorrectionRec) =
    SvAddRecordChecked(set, schema.SvCorrectionLine(rec))

@borrows
fn SvAddDependency(set: var SvLineSet, rec: schema.SvDependencyRec) =
    SvAddRecordChecked(set, schema.SvDependencyLine(rec))

@borrows
fn SvAddRevision(set: var SvLineSet, rec: schema.SvRevisionRec) =
    SvAddRecordChecked(set, schema.SvRevisionLine(rec))

@borrows
fn SvAddReceipt(set: var SvLineSet, rec: schema.SvReceiptRec) =
    SvAddRecordChecked(set, schema.SvReceiptLine(rec))

@borrows
fn SvAddSemPlane(set: var SvLineSet, rec: schema.SvSemPlaneRec) =
    SvAddRecordChecked(set, schema.SvSemPlaneLine(rec))

@borrows
fn SvWriterEncode(set: SvLineSet): SvEncodeResult =
    var out: SvEncodeResult
    if set.error.len > 0:
        out.error = strings.CloneStr(set.error)
        return out
    if set.lines.len == 0:
        out.error = "sv_empty_block"
        return out
    var encoded = csgc.CsgCoreCsgcEncodeVerifiedLines(set.lines)
    if !encoded.ok:
        out.error = schema.SvCat("sv_csgc_encode ", encoded.error)
        return out
    out.ok = true
    out.bytes = encoded.bytes
    out.factCount = encoded.factCount
    out.claimedDirectoryCid = encoded.claimedDirectoryCid
    return out

@borrows
fn SvContentCid(manifestLine: str): str =
    return schema.SvFramedCid(schema.SvContentCidDomain, manifestLine)

fn SvResourceCid(bytes: rawbytes.Bytes): str =
    var out = layout.ByteBufInit(64)
    schema.SvAppendText(out, schema.SvResourceCidDomain)
    layout.ByteBufAppendBytes(out, bytes)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(out))
    layout.ByteBufFree(out)
    return strings.ConcatStr("sha256:", layout.FixedBytes32Hex(digest))

# 原子提交：写 <target>.svstaging → rename 到 <target>。rename 失败保留
# 暂存现场并报错，不覆写任何已存在的有效文件（规范 §5）。
@borrows
fn SvWriterCommit(bytes: rawbytes.Bytes, targetPath: str): str =
    var stagingPath: str = strings.ConcatStr(targetPath, ".svstaging")
    var writeError: str
    if !os.WriteFileBytesStatus(stagingPath, bytes, writeError):
        let _ = os.RemoveFile(stagingPath)
        return strings.ConcatStr("sv_commit_write ", writeError)
    if !os.RenameFile(stagingPath, targetPath):
        let _ = os.RemoveFile(stagingPath)
        return "sv_commit_rename_failed"
    return ""
