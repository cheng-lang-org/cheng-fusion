import std/strings
import std/rawbytes
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_field as field
import cheng/game/assets/semantic_video/schema

# v0.1 读取路径：CSGC 字节 → CsgCoreCsgcDecodeLines（唯一核心解码）→
# 顶层字段提取 → 类型化记录集。本模块不复用 writer 的发射函数，
# 记录级解析与 writer 发射互为独立对拍（验收 §9.1 一）。

type
    SvDecodeResult =
        ok: bool
        error: str
        lines: str[]
        factCount: int32

    SvParseResult =
        ok: bool
        error: str
        records: schema.SvRecords

@borrows
fn SvDecodeFail(error: str): SvDecodeResult =
    var out: SvDecodeResult
    out.error = strings.CloneStr(error)
    return out

@borrows
fn SvStrField(line: str, name: str): str =
    let found = field.CsgCoreJsonTopStringField(line, name)
    if !found.found:
        return ""
    return found.value

@borrows
fn SvFieldRaw(line: str, name: str): str =
    let found = field.CsgCoreJsonTopRawField(line, name)
    if !found.found:
        return ""
    return found.value

type
    SvI64Parse =
        ok: bool
        value: int64

    SvI32Parse =
        ok: bool
        value: int32

    SvStrArrayParse =
        ok: bool
        values: str[]

    SvI64ArrayParse =
        ok: bool
        values: int64[]

    SvI32ArrayParse =
        ok: bool
        values: int32[]

    SvTimeParse =
        ok: bool
        tbNum: int32
        tbDen: int32
        tickStart: int64
        tickEnd: int64

# canonical JSON 整数解析，覆盖核心 canonicalizer 的两种输出形态：
# plain（0 / -?[1-9][0-9]*）与 scientific（-?d[.ddd]e-?d+，当 plain 不短于
# scientific 时核心输出后者，如 90000 → 9e4）。带小数部分即非整数，拒绝；
# 换算全程做 i64 溢出检查。
@borrows
fn SvParseI64(text: str): SvI64Parse =
    var out: SvI64Parse
    if text.len == 0:
        return out
    var at: int32 = 0
    var negative = false
    if text[0] == '-':
        negative = true
        at = 1
    if at >= text.len || text[at] < '0' || text[at] > '9':
        return out
    var mantissa: int64 = 0
    var intDigits: int32 = 0
    while at < text.len && text[at] >= '0' && text[at] <= '9':
        let digit = int64(int32(text[at]) - int32('0'))
        if mantissa > (Int64(9223372036854775807) - digit) / int64(10):
            return out
        mantissa = mantissa * int64(10) + digit
        intDigits = intDigits + 1
        at = at + 1
    if intDigits == 0:
        return out
    var fracDigits: int32 = 0
    if at < text.len && text[at] == '.':
        at = at + 1
        if at >= text.len || text[at] < '0' || text[at] > '9':
            return out
        while at < text.len && text[at] >= '0' && text[at] <= '9':
            let digit = int64(int32(text[at]) - int32('0'))
            if mantissa > (Int64(9223372036854775807) - digit) / int64(10):
                return out
            mantissa = mantissa * int64(10) + digit
            fracDigits = fracDigits + 1
            at = at + 1
    var exponent: int64 = 0
    if at < text.len && text[at] == 'e':
        at = at + 1
        var expNegative = false
        if at < text.len && text[at] == '-':
            expNegative = true
            at = at + 1
        if at >= text.len || text[at] < '0' || text[at] > '9':
            return out
        while at < text.len && text[at] >= '0' && text[at] <= '9':
            let digit = int64(int32(text[at]) - int32('0'))
            if exponent > int64(100000):
                return out
            exponent = exponent * int64(10) + digit
            at = at + 1
        if expNegative:
            exponent = -exponent
    if at != text.len:
        return out
    let valueExponent = exponent - int64(fracDigits)
    if mantissa == 0:
        if negative || intDigits != 1 || fracDigits != 0 ||
           at != text.len:
            return out
        out.ok = true
        out.value = int64(0)
        return out
    if valueExponent < int64(0):
        return out
    if valueExponent > int64(18):
        return out
    var scale: int64 = int64(0)
    while scale < valueExponent:
        if mantissa > Int64(9223372036854775807) / int64(10):
            return out
        mantissa = mantissa * int64(10)
        scale = scale + int64(1)
    if negative && mantissa == Int64(9223372036854775807):
        return out
    out.ok = true
    out.value = negative ? -mantissa : mantissa
    return out

@borrows
fn SvParseI32(text: str): SvI32Parse =
    var out: SvI32Parse
    let parsed = SvParseI64(text)
    if !parsed.ok:
        return out
    if parsed.value < Int64(-2147483647) - Int64(1) ||
       parsed.value > Int64(2147483647):
        return out
    out.ok = true
    out.value = int32(parsed.value)
    return out

# 解码 canonical JSON 字符串元素：包一层最小对象复用公共字段解码器。
@borrows
fn SvDecodeQuotedElement(rawElement: str): str =
    let wrapped = schema.SvCat3("{\"v\":", rawElement, "}")
    let decoded = field.CsgCoreJsonTopStringField(wrapped, "v")
    if !decoded.found:
        return ""
    return decoded.value

@borrows
fn SvParseStrArray(raw: str): SvStrArrayParse =
    var out: SvStrArrayParse
    if raw.len < 2 || raw[0] != '[':
        return out
    if raw[1] == ']':
        out.ok = raw.len == 2
        return out
    var at: int32 = 1
    while at < raw.len:
        if raw[at] != '"':
            return out
        var endAt: int32 = at + 1
        var escaped = false
        while endAt < raw.len:
            let ch = raw[endAt]
            if escaped:
                escaped = false
            elif ch == '\\':
                escaped = true
            elif ch == '"':
                break
            endAt = endAt + 1
        if endAt >= raw.len || raw[endAt] != '"':
            return out
        let element = strings.SliceBytes(raw, at, endAt - at + 1)
        add(out.values, strings.CloneStr(SvDecodeQuotedElement(element)))
        at = endAt + 1
        if at >= raw.len:
            return out
        if raw[at] == ']':
            out.ok = at == raw.len - 1
            return out
        if raw[at] != ',':
            return out
        at = at + 1
    return out

@borrows
fn SvParseI64Array(raw: str): SvI64ArrayParse =
    var out: SvI64ArrayParse
    if raw.len < 2 || raw[0] != '[':
        return out
    if raw[1] == ']':
        out.ok = raw.len == 2
        return out
    var at: int32 = 1
    while at < raw.len:
        var endAt: int32 = at
        while endAt < raw.len && raw[endAt] != ',' && raw[endAt] != ']':
            endAt = endAt + 1
        if endAt >= raw.len:
            return out
        let token = strings.SliceBytes(raw, at, endAt - at)
        let parsed = SvParseI64(token)
        if !parsed.ok:
            return out
        add(out.values, parsed.value)
        at = endAt
        if raw[at] == ']':
            out.ok = at == raw.len - 1
            return out
        if raw[at] != ',':
            return out
        at = at + 1
    return out

@borrows
fn SvParseI32Array(raw: str): SvI32ArrayParse =
    var out: SvI32ArrayParse
    let parsed = SvParseI64Array(raw)
    if !parsed.ok:
        return out
    for i in 0..<parsed.values.len:
        if parsed.values[i] < Int64(-2147483647) - Int64(1) ||
           parsed.values[i] > Int64(2147483647):
            return out
        add(out.values, int32(parsed.values[i]))
    out.ok = true
    return out

@borrows
fn SvParseTimeFields(line: str): SvTimeParse =
    var out: SvTimeParse
    let tbNumParsed = SvParseI32(SvFieldRaw(line, "tbNum"))
    if !tbNumParsed.ok:
        return out
    out.tbNum = tbNumParsed.value
    let tbDenParsed = SvParseI32(SvFieldRaw(line, "tbDen"))
    if !tbDenParsed.ok:
        return out
    out.tbDen = tbDenParsed.value
    let startParsed = SvParseI64(SvFieldRaw(line, "tickStart"))
    if !startParsed.ok:
        return out
    out.tickStart = startParsed.value
    let endParsed = SvParseI64(SvFieldRaw(line, "tickEnd"))
    if !endParsed.ok:
        return out
    out.tickEnd = endParsed.value
    out.ok = true
    return out

@borrows
fn SvParseFail(error: str): SvParseResult =
    var out: SvParseResult
    out.error = strings.CloneStr(error)
    return out

# 记录集装载：borrowed 行数组进，值返回结果结构（记录集在结果内就地构建）。
@borrows
fn SvParseRecords(lines: str[]): SvParseResult =
    var out: SvParseResult
    for i in 0..<lines.len:
        let line = lines[i]
        let kind = field.CsgCoreJsonKind(line)
        if !kind.found:
            return SvParseFail("sv_unknown_kind")
        if kind.value == schema.SvKindManifest:
            var rec: schema.SvManifestRec
            rec.contentId = SvStrField(line, "contentId")
            rec.entrySnapshot = SvStrField(line, "entrySnapshot")
            let capParsed = SvParseStrArray(SvFieldRaw(line, "cap"))
            if !capParsed.ok:
                return SvParseFail("sv_field_type_mismatch cap")
            rec.caps = capParsed.values
            let resCidParsed = SvParseStrArray(SvFieldRaw(line, "resCid"))
            if !resCidParsed.ok:
                return SvParseFail("sv_field_type_mismatch resCid")
            rec.resCid = resCidParsed.values
            let resTypeParsed = SvParseStrArray(SvFieldRaw(line, "resType"))
            if !resTypeParsed.ok:
                return SvParseFail("sv_field_type_mismatch resType")
            rec.resType = resTypeParsed.values
            let resLengthParsed = SvParseI64Array(SvFieldRaw(line, "resLength"))
            if !resLengthParsed.ok:
                return SvParseFail("sv_field_type_mismatch resLength")
            rec.resLength = resLengthParsed.values
            let tbNumParsed = SvParseI32(SvFieldRaw(line, "tbNum"))
            if !tbNumParsed.ok:
                return SvParseFail("sv_field_type_mismatch tbNum")
            rec.tbNum = tbNumParsed.value
            let tbDenParsed = SvParseI32(SvFieldRaw(line, "tbDen"))
            if !tbDenParsed.ok:
                return SvParseFail("sv_field_type_mismatch tbDen")
            rec.tbDen = tbDenParsed.value
            let startParsed = SvParseI64(SvFieldRaw(line, "timeStart"))
            if !startParsed.ok:
                return SvParseFail("sv_field_type_mismatch timeStart")
            rec.timeStart = startParsed.value
            let endParsed = SvParseI64(SvFieldRaw(line, "timeEnd"))
            if !endParsed.ok:
                return SvParseFail("sv_field_type_mismatch timeEnd")
            rec.timeEnd = endParsed.value
            # x- 可选扩展：缺失 = 空串（旧夹具无此键）。
            rec.xPhysicsBaseline = SvStrField(line, "x-physicsBaseline")
            add(out.records.manifests, rec)
        elif kind.value == schema.SvKindObservation:
            var rec: schema.SvObservationRec
            rec.obsId = SvStrField(line, "obsId")
            rec.sensor = SvStrField(line, "sensor")
            rec.srcTrack = SvStrField(line, "srcTrack")
            rec.sourceClass = SvStrField(line, "sourceClass")
            rec.method = SvStrField(line, "method")
            let timeParsed = SvParseTimeFields(line)
            if !timeParsed.ok:
                return SvParseFail("sv_field_type_mismatch observation_time")
            rec.tbNum = timeParsed.tbNum
            rec.tbDen = timeParsed.tbDen
            rec.tickStart = timeParsed.tickStart
            rec.tickEnd = timeParsed.tickEnd
            add(out.records.observations, rec)
        elif kind.value == schema.SvKindEntity:
            var rec: schema.SvEntityRec
            rec.ns = SvStrField(line, "ns")
            rec.typeVer = SvStrField(line, "typeVer")
            rec.lifecycle = SvStrField(line, "lifecycle")
            let genParsed = SvParseI64(SvFieldRaw(line, "gen"))
            if !genParsed.ok:
                return SvParseFail("sv_field_type_mismatch gen")
            rec.gen = genParsed.value
            let numParsed = SvParseI32(SvFieldRaw(line, "num"))
            if !numParsed.ok:
                return SvParseFail("sv_field_type_mismatch num")
            rec.num = numParsed.value
            add(out.records.entities, rec)
        elif kind.value == schema.SvKindAssertion:
            var rec: schema.SvAssertionRec
            rec.uid = SvStrField(line, "uid")
            rec.obj = SvStrField(line, "obj")
            rec.pred = SvStrField(line, "pred")
            rec.val = SvStrField(line, "val")
            rec.confDef = SvStrField(line, "confDef")
            rec.sourceClass = SvStrField(line, "sourceClass")
            rec.method = SvStrField(line, "method")
            let confBpParsed = SvParseI32(SvFieldRaw(line, "confBp"))
            if !confBpParsed.ok:
                return SvParseFail("sv_field_type_mismatch confBp")
            rec.confBp = confBpParsed.value
            let revParsed = SvParseI32(SvFieldRaw(line, "rev"))
            if !revParsed.ok:
                return SvParseFail("sv_field_type_mismatch rev")
            rec.rev = revParsed.value
            let timeParsed = SvParseTimeFields(line)
            if !timeParsed.ok:
                return SvParseFail("sv_field_type_mismatch assertion_time")
            rec.tbNum = timeParsed.tbNum
            rec.tbDen = timeParsed.tbDen
            rec.tickStart = timeParsed.tickStart
            rec.tickEnd = timeParsed.tickEnd
            add(out.records.assertions, rec)
        elif kind.value == schema.SvKindSnapshot:
            var rec: schema.SvSnapshotRec
            rec.branch = SvStrField(line, "branch")
            rec.ckpt = SvStrField(line, "ckpt")
            rec.worldCid = SvStrField(line, "worldCid")
            let depsParsed = SvParseStrArray(SvFieldRaw(line, "deps"))
            if !depsParsed.ok:
                return SvParseFail("sv_field_type_mismatch deps")
            rec.deps = depsParsed.values
            let tickParsed = SvParseI64(SvFieldRaw(line, "tick"))
            if !tickParsed.ok:
                return SvParseFail("sv_field_type_mismatch tick")
            rec.tick = tickParsed.value
            let tbNumParsed = SvParseI32(SvFieldRaw(line, "tbNum"))
            if !tbNumParsed.ok:
                return SvParseFail("sv_field_type_mismatch tbNum")
            rec.tbNum = tbNumParsed.value
            let tbDenParsed = SvParseI32(SvFieldRaw(line, "tbDen"))
            if !tbDenParsed.ok:
                return SvParseFail("sv_field_type_mismatch tbDen")
            rec.tbDen = tbDenParsed.value
            add(out.records.snapshots, rec)
        elif kind.value == schema.SvKindDelta:
            var rec: schema.SvDeltaRec
            rec.baseCkpt = SvStrField(line, "baseCkpt")
            rec.toCkpt = SvStrField(line, "toCkpt")
            rec.opsCid = SvStrField(line, "opsCid")
            let seqParsed = SvParseI64(SvFieldRaw(line, "seq"))
            if !seqParsed.ok:
                return SvParseFail("sv_field_type_mismatch seq")
            rec.seqNum = seqParsed.value
            let timeParsed = SvParseTimeFields(line)
            if !timeParsed.ok:
                return SvParseFail("sv_field_type_mismatch delta_time")
            rec.tbNum = timeParsed.tbNum
            rec.tbDen = timeParsed.tbDen
            rec.tickStart = timeParsed.tickStart
            rec.tickEnd = timeParsed.tickEnd
            add(out.records.deltas, rec)
        elif kind.value == schema.SvKindCorrection:
            var rec: schema.SvCorrectionRec
            rec.obsRef = SvStrField(line, "obsRef")
            rec.spaceDomain = SvStrField(line, "spaceDomain")
            rec.basisCid = SvStrField(line, "basisCid")
            rec.payloadCid = SvStrField(line, "payloadCid")
            let timeParsed = SvParseTimeFields(line)
            if !timeParsed.ok:
                return SvParseFail("sv_field_type_mismatch correction_time")
            rec.tbNum = timeParsed.tbNum
            rec.tbDen = timeParsed.tbDen
            rec.tickStart = timeParsed.tickStart
            rec.tickEnd = timeParsed.tickEnd
            add(out.records.corrections, rec)
        elif kind.value == schema.SvKindDependency:
            var rec: schema.SvDependencyRec
            rec.consumer = SvStrField(line, "consumer")
            rec.purpose = SvStrField(line, "purpose")
            rec.queryBasis = SvStrField(line, "queryBasis")
            rec.target = SvStrField(line, "target")
            rec.targetVer = SvStrField(line, "targetVer")
            add(out.records.dependencies, rec)
        elif kind.value == schema.SvKindRevision:
            var rec: schema.SvRevisionRec
            rec.targetUid = SvStrField(line, "targetUid")
            rec.supersedes = SvStrField(line, "supersedes")
            rec.reason = SvStrField(line, "reason")
            let oldRevParsed = SvParseI32(SvFieldRaw(line, "oldRev"))
            if !oldRevParsed.ok:
                return SvParseFail("sv_field_type_mismatch oldRev")
            rec.oldRev = oldRevParsed.value
            let newRevParsed = SvParseI32(SvFieldRaw(line, "newRev"))
            if !newRevParsed.ok:
                return SvParseFail("sv_field_type_mismatch newRev")
            rec.newRev = newRevParsed.value
            let tickParsed = SvParseI64(SvFieldRaw(line, "publishedTick"))
            if !tickParsed.ok:
                return SvParseFail("sv_field_type_mismatch publishedTick")
            rec.publishedTick = tickParsed.value
            let tbNumParsed = SvParseI32(SvFieldRaw(line, "tbNum"))
            if !tbNumParsed.ok:
                return SvParseFail("sv_field_type_mismatch tbNum")
            rec.tbNum = tbNumParsed.value
            let tbDenParsed = SvParseI32(SvFieldRaw(line, "tbDen"))
            if !tbDenParsed.ok:
                return SvParseFail("sv_field_type_mismatch tbDen")
            rec.tbDen = tbDenParsed.value
            add(out.records.revisions, rec)
        elif kind.value == schema.SvKindReceipt:
            var rec: schema.SvReceiptRec
            rec.configCid = SvStrField(line, "configCid")
            rec.implCid = SvStrField(line, "implCid")
            rec.subjectCid = SvStrField(line, "subjectCid")
            rec.summaryCid = SvStrField(line, "summaryCid")
            rec.result = SvStrField(line, "result")
            let capReqParsed = SvParseStrArray(SvFieldRaw(line, "capReq"))
            if !capReqParsed.ok:
                return SvParseFail("sv_field_type_mismatch capReq")
            rec.capReq = capReqParsed.values
            let capVerifiedParsed = SvParseStrArray(SvFieldRaw(line, "capVerified"))
            if !capVerifiedParsed.ok:
                return SvParseFail("sv_field_type_mismatch capVerified")
            rec.capVerified = capVerifiedParsed.values
            add(out.records.receipts, rec)
        elif kind.value == schema.SvKindPlane:
            var rec: schema.SvSemPlaneRec
            rec.colorDef = SvStrField(line, "colorDef")
            rec.confDef = SvStrField(line, "confDef")
            rec.method = SvStrField(line, "method")
            rec.sourceClass = SvStrField(line, "sourceClass")
            let tidParsed = SvParseI32(SvFieldRaw(line, "tid"))
            if !tidParsed.ok:
                return SvParseFail("sv_field_type_mismatch tid")
            rec.tid = tidParsed.value
            let timeParsed = SvParseTimeFields(line)
            if !timeParsed.ok:
                return SvParseFail("sv_field_type_mismatch plane_time")
            rec.tbNum = timeParsed.tbNum
            rec.tbDen = timeParsed.tbDen
            rec.tickStart = timeParsed.tickStart
            rec.tickEnd = timeParsed.tickEnd
            let frameCountParsed = SvParseI32(SvFieldRaw(line, "frameCount"))
            if !frameCountParsed.ok:
                return SvParseFail("sv_field_type_mismatch frameCount")
            rec.frameCount = frameCountParsed.value
            let maxAreaParsed = SvParseI32(SvFieldRaw(line, "maxAreaPx"))
            if !maxAreaParsed.ok:
                return SvParseFail("sv_field_type_mismatch maxAreaPx")
            rec.maxAreaPx = maxAreaParsed.value
            let meanAreaParsed = SvParseI32(SvFieldRaw(line, "meanAreaM1"))
            if !meanAreaParsed.ok:
                return SvParseFail("sv_field_type_mismatch meanAreaM1")
            rec.meanAreaM1 = meanAreaParsed.value
            let meanDepthParsed = SvParseI32(SvFieldRaw(line, "meanDepthM1"))
            if !meanDepthParsed.ok:
                return SvParseFail("sv_field_type_mismatch meanDepthM1")
            rec.meanDepthM1 = meanDepthParsed.value
            let pathLenParsed = SvParseI32(SvFieldRaw(line, "pathLenM2"))
            if !pathLenParsed.ok:
                return SvParseFail("sv_field_type_mismatch pathLenM2")
            rec.pathLenM2 = pathLenParsed.value
            let colorRParsed = SvParseI32(SvFieldRaw(line, "colorR"))
            if !colorRParsed.ok:
                return SvParseFail("sv_field_type_mismatch colorR")
            rec.colorR = colorRParsed.value
            let colorGParsed = SvParseI32(SvFieldRaw(line, "colorG"))
            if !colorGParsed.ok:
                return SvParseFail("sv_field_type_mismatch colorG")
            rec.colorG = colorGParsed.value
            let colorBParsed = SvParseI32(SvFieldRaw(line, "colorB"))
            if !colorBParsed.ok:
                return SvParseFail("sv_field_type_mismatch colorB")
            rec.colorB = colorBParsed.value
            let samplesParsed = SvParseI32(SvFieldRaw(line, "colorSamples"))
            if !samplesParsed.ok:
                return SvParseFail("sv_field_type_mismatch colorSamples")
            rec.colorSamples = samplesParsed.value
            let confParsed = SvParseI32(SvFieldRaw(line, "confBp"))
            if !confParsed.ok:
                return SvParseFail("sv_field_type_mismatch confBp")
            rec.confBp = confParsed.value
            let cxAbsent = SvFieldRaw(line, "cxM2").len == 0
            let cyAbsent = SvFieldRaw(line, "cyM2").len == 0
            let areaAbsent = SvFieldRaw(line, "areaPx").len == 0
            if cxAbsent || cyAbsent || areaAbsent:
                return SvParseFail("sv_missing_required_field plane_traj")
            let cxParsed = SvParseI32Array(SvFieldRaw(line, "cxM2"))
            if !cxParsed.ok:
                return SvParseFail("sv_field_type_mismatch cxM2")
            rec.cxM2 = cxParsed.values
            let cyParsed = SvParseI32Array(SvFieldRaw(line, "cyM2"))
            if !cyParsed.ok:
                return SvParseFail("sv_field_type_mismatch cyM2")
            rec.cyM2 = cyParsed.values
            let areaParsed = SvParseI32Array(SvFieldRaw(line, "areaPx"))
            if !areaParsed.ok:
                return SvParseFail("sv_field_type_mismatch areaPx")
            rec.areaPx = areaParsed.values
            # param* 可选，全有或全无。
            let paramFramesRaw = SvFieldRaw(line, "paramFrames")
            let paramARaw = SvFieldRaw(line, "paramA")
            let paramBRaw = SvFieldRaw(line, "paramB")
            let paramCRaw = SvFieldRaw(line, "paramC")
            if paramFramesRaw.len > 0 || paramARaw.len > 0 ||
               paramBRaw.len > 0 || paramCRaw.len > 0:
                if paramFramesRaw.len == 0 || paramARaw.len == 0 ||
                   paramBRaw.len == 0 || paramCRaw.len == 0:
                    return SvParseFail("sv_missing_required_field plane_param")
                let pfParsed = SvParseI32Array(paramFramesRaw)
                if !pfParsed.ok:
                    return SvParseFail("sv_field_type_mismatch paramFrames")
                rec.paramFrames = pfParsed.values
                let paParsed = SvParseI32Array(paramARaw)
                if !paParsed.ok:
                    return SvParseFail("sv_field_type_mismatch paramA")
                rec.paramA = paParsed.values
                let pbParsed = SvParseI32Array(paramBRaw)
                if !pbParsed.ok:
                    return SvParseFail("sv_field_type_mismatch paramB")
                rec.paramB = pbParsed.values
                let pcParsed = SvParseI32Array(paramCRaw)
                if !pcParsed.ok:
                    return SvParseFail("sv_field_type_mismatch paramC")
                rec.paramC = pcParsed.values
            add(out.records.planes, rec)
        else:
            return SvParseFail(
                schema.SvCat("sv_unknown_kind ", kind.value))
    out.ok = true
    return out

# 解码到行级；记录集经 SvParseRecords 值返回装载。
@borrows
fn SvReaderDecode(bytes: rawbytes.Bytes): SvDecodeResult =
    var out: SvDecodeResult
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        out.error = schema.SvCat("sv_csgc_decode ", decoded.error)
        return out
    for i in 0..<decoded.lines.len:
        add(out.lines, strings.CloneStr(decoded.lines[i]))
    out.ok = true
    out.factCount = decoded.factCount
    return out
