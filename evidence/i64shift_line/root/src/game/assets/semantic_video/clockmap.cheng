# CSG语义视频 流时钟映射。设计冻结来源：docs/csg-semantic-video-core-design.md
# §3.3 —— 实时记录观测发生/结果产生/接收端到达三个时间；源时钟到会话时间的
# 映射携带版本（世代）、适用区间和测量不确定度；漂移更新 = 同世代追加新段
# （新基准点+新速率）；断时钟 = 新世代，旧世代查询立即拒绝。段内区间左闭右开；
# 换算必须整除且防溢出；不确定度以基点（0.01%）计，超请求上限即拒绝同步能力。
# 纯数据结构 + 查询：SoA 平行数组，行身份只走精确 int64 世代 / int32 段序，
# 禁止文本或指针主键。

type
    SvClockMapTable =
        srcGeneration: int64[]
        segSeq: int32[]
        srcTickStart: int64[]
        sessionTickStart: int64[]
        rateNum: int32[]
        rateDen: int32[]
        uncertaintyBp: int32[]

    SvClockMapAddResult =
        ok: bool
        error: str

    SvClockMapLookupResult =
        ok: bool
        error: str
        sessionTick: int64

# 追加一段映射。守卫（任一不满足即结构化拒绝，不改表）：
# - 速率为正有理数，不确定度非负；
# - 同世代（= 当前世代）：segSeq 必须等于当前最大+1，srcTickStart 严格递增；
# - 新世代（> 当前世代）：断时钟，首段 segSeq 必须 = 0；
# - 旧世代（< 当前世代）：已随断时钟废弃，禁止再追加。
fn SvClockMapAddSegment(table: var SvClockMapTable, generation: int64,
        segSeq: int32, srcTickStart: int64, sessionTickStart: int64,
        rateNum: int32, rateDen: int32, uncertaintyBp: int32): SvClockMapAddResult =
    var out: SvClockMapAddResult
    if rateNum <= 0 || rateDen <= 0:
        out.error = "svcm_rate_invalid"
        return out
    if uncertaintyBp < 0:
        out.error = "svcm_uncertainty_invalid"
        return out
    let count = table.srcGeneration.len
    if count > 0:
        let currentGen = table.srcGeneration[count - 1]
        if generation == currentGen:
            if segSeq != table.segSeq[count - 1] + 1:
                out.error = "svcm_seg_seq_gap"
                return out
            if srcTickStart <= table.srcTickStart[count - 1]:
                out.error = "svcm_src_tick_reversed"
                return out
        else:
            if generation < currentGen:
                out.error = "svcm_generation_retired"
                return out
            if segSeq != 0:
                out.error = "svcm_generation_first_seg_seq"
                return out
    add(table.srcGeneration, generation)
    add(table.segSeq, segSeq)
    add(table.srcTickStart, srcTickStart)
    add(table.sessionTickStart, sessionTickStart)
    add(table.rateNum, rateNum)
    add(table.rateDen, rateDen)
    add(table.uncertaintyBp, uncertaintyBp)
    out.ok = true
    return out

# 查询 generation 世代内覆盖 srcTick 的最新段并换算会话时间。
# 拒绝路径（错误码 svcm_ 前缀）：
# - svcm_generation_unknown / svcm_generation_retired：世代不存在或已废弃；
# - svcm_src_tick_before_first：早于该世代首段起点；
# - svcm_clock_uncertainty：段不确定度 > 请求上限 maxUncertaintyBp；
# - svcm_not_divisible：(srcTick-srcTickStart)*rateNum 不被 rateDen 整除；
# - svcm_tick_overflow：乘法或最终加法溢出（§3.3 换算防溢出）。
@borrows
fn SvClockMapLookup(table: SvClockMapTable, generation: int64, srcTick: int64,
        maxUncertaintyBp: int32): SvClockMapLookupResult =
    var out: SvClockMapLookupResult
    let count = table.srcGeneration.len
    if count == 0:
        out.error = "svcm_generation_unknown"
        return out
    if table.srcGeneration[count - 1] != generation:
        # 当前世代 = 最后追加的世代；存在但非当前 = 已被断时钟废弃。
        var known = false
        for i in 0..<count:
            if table.srcGeneration[i] == generation:
                known = true
                break
        if !known:
            out.error = "svcm_generation_unknown"
            return out
        out.error = "svcm_generation_retired"
        return out
    # 最新段 = 逆向首个"本世代且 srcTickStart ≤ srcTick"的行；段按
    # srcTickStart 严格递增追加，其下一段起点必然 > srcTick（或为最后段），
    # 左闭右开区间由扫描语义直接保证。
    var seg: int32 = -1
    var i: int32 = count - 1
    while i >= 0:
        if table.srcGeneration[i] == generation && table.srcTickStart[i] <= srcTick:
            seg = i
            break
        i = i - 1
    if seg < 0:
        out.error = "svcm_src_tick_before_first"
        return out
    if table.uncertaintyBp[seg] > maxUncertaintyBp:
        out.error = "svcm_clock_uncertainty"
        return out
    if table.rateNum[seg] <= 0 || table.rateDen[seg] <= 0:
        out.error = "svcm_rate_invalid"
        return out
    let delta = srcTick - table.srcTickStart[seg]
    let scaled = delta * int64(table.rateNum[seg])
    if delta > 0 && scaled < delta:
        out.error = "svcm_tick_overflow"
        return out
    if (scaled % int64(table.rateDen[seg])) != 0:
        out.error = "svcm_not_divisible"
        return out
    let quot = scaled / int64(table.rateDen[seg])
    let shifted = table.sessionTickStart[seg] + quot
    # delta ≥ 0 且速率 > 0，故 quot ≥ 0：加法只可能正向回绕。
    if table.sessionTickStart[seg] > 0 && quot > 0 && shifted < 0:
        out.error = "svcm_tick_overflow"
        return out
    out.ok = true
    out.sessionTick = shifted
    return out
