import std/strings
import std/rawbytes
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/physics3d
import cheng/game/world3d
import cheng/game/assets/semantic_video/schema as svschema
import cheng/game/assets/semantic_video/writer
import cheng/game/assets/semantic_video/validator

# F1 snapshot semantic block: the deterministic ball-film drive shared by
# capture and restore (the replay contract: both sides run the exact same
# build -> inject -> setParams -> setBallMode -> tick sequence), plus the
# v0.1 snapshot block builder (records only; payloads travel as separate
# state_payload resources bound by SvResourceCid, the b2/b3 media model).

const
    SvSnapTbNum: int32 = 1
    SvSnapTbDen: int32 = 240
    SvSnapResType: str = "state_payload"
    SvSnapBranch: str = "main"
    SvSnapEntityNs: str = "semantic_snapshot@v1"
    SvSnapEntityTypeVer: str = "state@v1"
    SvSnapObsId: str = "obs-gen0"
    SvSnapObsSensor: str = "state-capture"
    SvSnapObsTrack: str = "sv-f1:0"
    SvSnapMethod: str = "f-loop-capture"
    SvSnapAssertUid0: str = "asv-gen0"
    SvSnapAssertUid1: str = "asv-gen1"
    SvSnapAssertVal: str = "checkpoint capture"
    SvSnapConfDef: str = "deterministic capture provenance"
    SvSnapRevisionReason: str = "f-loop provenance rebind"
    SvSnapDepConsumer: str = "semantic_player"
    SvSnapDepTargetVer: str = "csgworld.v1"
    SvSnapDepPurpose: str = "world_restore"
    SvSnapDepQueryBasis: str = "f-loop"
    # 物理默认行为基线探针 tick：同一 facts 权威驱动到该 tick 的
    # World3dCid（状态结构哈希域）= 录制时物理默认行为指纹（base pass
    # 门值/扫描数等默认行为变更会改变探针值）。
    SvSnapBaselineProbeTick: int64 = int64(8)

type
    SvSnapDrive =
        ok: bool
        error: str
        factsCid: str
        ballSlot: int32
        st: execution.CsgExecutionState

    SvSnapBlockResult =
        ok: bool
        error: str
        factCount: int32
        contentId: str
        dirCid: str
        blockBytes: int64

@borrows
fn SvSnapCkptId(tick: int64): str =
    return "ck-" + strings.Int64ToStr(tick)

# Borrow-shaped wrappers around plain (unannotated) writer/rawbytes calls.
# A BytesSliceView result is an address-bearing value; the cheng_cold plain
# local copy guard rejects passing it straight into an unannotated callee,
# while a @borrows callee binds it as a borrow (the b3 SvSmVerifyChain
# call shape). All snapshot-module calls on views go through these.
@borrows
fn SvSnapResourceCid(data: rawbytes.Bytes): str =
    return writer.SvResourceCid(data)

@borrows
fn SvSnapBytesEqual(a: rawbytes.Bytes, b: rawbytes.Bytes): bool =
    return rawbytes.BytesEqual(a, b)

# The one deterministic episode driver. capture builds it from
# CsgProducerBuildBallBalanceScene(); restore builds it from the loaded
# .csgworld facts after verifying the facts CID equals the block dependency
# — the function body is shared verbatim, so both sides replay the same
# call sequence (no RNG, no wall clock). The caller keeps the facts and
# passes them to SvSnapDriveTick (the state struct carries no facts copy).
@borrows
fn SvSnapDriveStartFromFacts(facts: schema.CsgWorldFacts): SvSnapDrive =
    var out: SvSnapDrive
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        out.error = "sv_snap_drive_facts_invalid"
        return out
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        out.error = "sv_snap_drive_materialize"
        return out
    # execution-side ball injection before execution init (the ball_film
    # chain-gap bridge, verbatim)
    var ballSlot: int32 = world3d.World3dSpawnBody(w,
        producer.CsgBallBalanceBallCenterX,
        producer.CsgBallBalanceBallCenterY,
        producer.CsgBallBalanceBallRadiusM,
        producer.CsgBallBalanceBallMassKg,
        producer.CsgBallBalanceBallRadiusM,
        world3d.World3dBodyBallRigid)
    execution.CsgExecutionInit(out.st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    execution.CsgBalanceSetParams(out.st,
        execution.CsgBalanceGain,
        execution.CsgBalanceDamp,
        execution.CsgBalanceCorrCapMps,
        100.0,
        execution.CsgCaptureStepLenM,
        2.0, 30.0, 270.0)
    execution.CsgBalanceSetBallMode(out.st,
        ballSlot,
        producer.CsgBallBalanceBallRadiusM,
        execution.CsgBalanceBallGain,
        execution.CsgBalanceBallFootGain,
        execution.CsgBalanceBallDamp,
        execution.CsgBalanceBallTorsoCapMps,
        execution.CsgBalanceBallCorrCapMps)
    out.factsCid = Fmt"{schema.CsgWorldFactsCid(facts)}"
    out.ballSlot = ballSlot
    out.ok = true
    return out

# One authority tick; false on a rejected physics step (fail loud).
# The caller passes the facts it owns alongside the state.
@borrows
fn SvSnapDriveTick(st: var execution.CsgExecutionState,
                   facts: schema.CsgWorldFacts): bool =
    var receipt = execution.CsgExecutionTick(st, facts)
    return receipt.statusCode == physics3d.Physics3dStatusOk

# 物理默认行为基线探针：capture 与消费端（smoke/后续 hub）共用本定义，
# 从同一 facts 出发权威驱动到 SvSnapBaselineProbeTick 取 World3dCid。
# 返回 "" = 探针失败（facts 无效/物理拒绝），调用方必须显式处理。
@borrows
fn SvSnapPhysicsBaseline(facts: schema.CsgWorldFacts): str =
    var probe = SvSnapDriveStartFromFacts(facts)
    if !probe.ok:
        return ""
    var t: int64 = int64(0)
    while t < SvSnapBaselineProbeTick:
        if !SvSnapDriveTick(probe.st, facts):
            return ""
        t = t + 1
    return world3d.World3dCid(probe.st.w)

# 基线对拍单一入口（smoke 装载段与 semantic_snapshot CLI restore 共用，
# 禁止各自内联漂移）：recorded = manifest x-physicsBaseline（缺键 = 空串），
# facts = 消费端装载的世界事实。返回 "" = 基线在场且与现树探针一致；
# 非空 = 结构化过期原因（统一「夹具基线过期（物理默认行为已变，请重录）」
# 文案，失配附 expected/actual 前 16 位），调用方加自身前缀 echo 后以
# rc=1 退出（与 smoke 同款语义）。
@borrows
fn SvSnapBaselineGuard(recorded: str, facts: schema.CsgWorldFacts): str =
    if recorded.len == 0:
        return "夹具基线过期（物理默认行为已变，请重录）: manifest x-physicsBaseline missing"
    var current: str = SvSnapPhysicsBaseline(facts)
    if current.len == 0:
        return "夹具基线过期（物理默认行为已变，请重录）: physics baseline probe failed"
    if recorded != current:
        # 注意：裸 return 的续行 `+` 会被静默截断（2026-09-20 实测：无括号
        # 续行的 return 只返回首行字面量，后续行静默丢弃），多行串接必须
        # 整体括号包裹。
        return ("夹具基线过期（物理默认行为已变，请重录） expected="
            + strings.CloneStrRange(recorded, 0, 16)
            + " actual=" + strings.CloneStrRange(current, 0, 16))
    return ""

@borrows
fn SvSnapBlockFail(error: str): SvSnapBlockResult =
    var out: SvSnapBlockResult
    out.error = strings.CloneStr(error)
    return out

# Build + validate + atomically commit the snapshot block. Payloads are
# handed over as one concatenated byte buffer with per-checkpoint lengths
# (plain data shape; per-ckpt resources are sliced out for CID binding).
# 旧签名保留：不带基线（x- 键不发射，行为与既往逐字节一致）。
@borrows
fn SvSnapshotBlockBuild(factsCid: str,
                        ticks: int64[],
                        payloadLengths: int32[],
                        allPayloads: rawbytes.Bytes,
                        outPath: str): SvSnapBlockResult =
    return SvSnapshotBlockBuildWithBaseline(factsCid, ticks, payloadLengths,
        allPayloads, "", outPath)

# 带物理默认行为基线的构建变体：physicsBaseline 非空时写进 manifest
# x-physicsBaseline 扩展键（状态快照夹具录制路径专用）。
@borrows
fn SvSnapshotBlockBuildWithBaseline(factsCid: str,
                                    ticks: int64[],
                                    payloadLengths: int32[],
                                    allPayloads: rawbytes.Bytes,
                                    physicsBaseline: str,
                                    outPath: str): SvSnapBlockResult =
    if ticks.len < 1 || ticks.len != payloadLengths.len:
        return SvSnapBlockFail("sv_snap_block_shape")
    for i in 0..<ticks.len:
        if payloadLengths[i] < 0:
            return SvSnapBlockFail("sv_snap_block_shape")
        if i > 0 && ticks[i] <= ticks[i - 1]:
            return SvSnapBlockFail("sv_snap_ticks_unsorted")
    var set = writer.SvLineSetInit()
    # per-checkpoint resource CIDs over the sliced payloads
    var resCids: str[]
    var offset: int32 = 0
    for i in 0..<ticks.len:
        var view = rawbytes.BytesSliceView(allPayloads, offset, payloadLengths[i])
        add(resCids, strings.CloneStr(SvSnapResourceCid(view)))
        offset = offset + payloadLengths[i]
    # manifest (contentId over the contentId-less preimage, the b1 shape)
    var manifest: svschema.SvManifestRec
    add(manifest.caps, strings.CloneStr(svschema.SvCapCommonCore))
    add(manifest.caps, strings.CloneStr(svschema.SvCapWorldExecution))
    manifest.entrySnapshot = strings.CloneStr(SvSnapCkptId(ticks[0]))
    for i in 0..<resCids.len:
        add(manifest.resCid, strings.CloneStr(resCids[i]))
        add(manifest.resLength, int64(payloadLengths[i]))
        add(manifest.resType, strings.CloneStr(SvSnapResType))
    manifest.tbNum = SvSnapTbNum
    manifest.tbDen = SvSnapTbDen
    manifest.timeStart = int64(0)
    manifest.timeEnd = ticks[ticks.len - 1]
    manifest.xPhysicsBaseline = strings.CloneStr(physicsBaseline)
    let preLine = svschema.SvManifestLine(manifest)
    manifest.contentId = strings.CloneStr(writer.SvContentCid(preLine))
    writer.SvAddManifest(set, manifest)
    # producer entity (the assertion object)
    var entity: svschema.SvEntityRec
    entity.ns = strings.CloneStr(SvSnapEntityNs)
    entity.gen = int64(0)
    entity.num = 1
    entity.typeVer = strings.CloneStr(SvSnapEntityTypeVer)
    entity.lifecycle = strings.CloneStr(svschema.SvLifecycleActive)
    writer.SvAddEntity(set, entity)
    let entityUid: str = svschema.SvEntityUid(entity)
    # manual observation of the capture run
    var observation: svschema.SvObservationRec
    observation.obsId = strings.CloneStr(SvSnapObsId)
    observation.sensor = strings.CloneStr(SvSnapObsSensor)
    observation.srcTrack = strings.CloneStr(SvSnapObsTrack)
    observation.sourceClass = strings.CloneStr(svschema.SvSourceManual)
    observation.method = strings.CloneStr(SvSnapMethod)
    observation.tbNum = SvSnapTbNum
    observation.tbDen = SvSnapTbDen
    observation.tickStart = int64(0)
    observation.tickEnd = int64(1)
    writer.SvAddObservation(set, observation)
    # assertion pair: gen0 (superseded) and gen1 (current) coexist in-block;
    # the revision record ties them — the S1 "revisions never erase" gate
    var assertion0: svschema.SvAssertionRec
    assertion0.uid = strings.CloneStr(SvSnapAssertUid0)
    assertion0.obj = strings.CloneStr(entityUid)
    assertion0.pred = strings.CloneStr(svschema.SvPredUserOperation)
    assertion0.val = strings.CloneStr(SvSnapAssertVal)
    assertion0.confBp = 10000
    assertion0.confDef = strings.CloneStr(SvSnapConfDef)
    assertion0.rev = 0
    assertion0.sourceClass = strings.CloneStr(svschema.SvSourceManual)
    assertion0.method = strings.CloneStr(SvSnapMethod)
    assertion0.tbNum = SvSnapTbNum
    assertion0.tbDen = SvSnapTbDen
    assertion0.tickStart = int64(0)
    assertion0.tickEnd = ticks[ticks.len - 1]
    writer.SvAddAssertion(set, assertion0)
    var assertion1: svschema.SvAssertionRec
    assertion1.uid = strings.CloneStr(SvSnapAssertUid1)
    assertion1.obj = strings.CloneStr(entityUid)
    assertion1.pred = strings.CloneStr(svschema.SvPredUserOperation)
    assertion1.val = strings.CloneStr(SvSnapAssertVal)
    assertion1.confBp = 10000
    assertion1.confDef = strings.CloneStr(SvSnapConfDef)
    assertion1.rev = 1
    assertion1.sourceClass = strings.CloneStr(svschema.SvSourceManual)
    assertion1.method = strings.CloneStr(SvSnapMethod)
    assertion1.tbNum = SvSnapTbNum
    assertion1.tbDen = SvSnapTbDen
    assertion1.tickStart = int64(0)
    assertion1.tickEnd = ticks[ticks.len - 1]
    writer.SvAddAssertion(set, assertion1)
    # one snapshot record per checkpoint
    for i in 0..<ticks.len:
        var snap: svschema.SvSnapshotRec
        snap.branch = strings.CloneStr(SvSnapBranch)
        snap.ckpt = strings.CloneStr(SvSnapCkptId(ticks[i]))
        add(snap.deps, strings.CloneStr(factsCid))
        snap.tick = ticks[i]
        snap.worldCid = strings.CloneStr(resCids[i])
        snap.tbNum = SvSnapTbNum
        snap.tbDen = SvSnapTbDen
        writer.SvAddSnapshot(set, snap)
    # world restore dependency
    var dep: svschema.SvDependencyRec
    dep.consumer = strings.CloneStr(SvSnapDepConsumer)
    dep.target = strings.CloneStr(factsCid)
    dep.targetVer = strings.CloneStr(SvSnapDepTargetVer)
    dep.purpose = strings.CloneStr(SvSnapDepPurpose)
    dep.queryBasis = strings.CloneStr(SvSnapDepQueryBasis)
    writer.SvAddDependency(set, dep)
    # revision: asv-gen1 supersedes asv-gen0, both records stay in the block
    var revision: svschema.SvRevisionRec
    revision.targetUid = strings.CloneStr(SvSnapAssertUid1)
    revision.supersedes = strings.CloneStr(SvSnapAssertUid0)
    revision.oldRev = 0
    revision.newRev = 1
    revision.publishedTick = ticks[ticks.len - 1]
    revision.reason = strings.CloneStr(SvSnapRevisionReason)
    revision.tbNum = SvSnapTbNum
    revision.tbDen = SvSnapTbDen
    writer.SvAddRevision(set, revision)
    # encode + self-validate + atomic commit
    var encoded = writer.SvWriterEncode(set)
    if !encoded.ok:
        return SvSnapBlockFail(strings.CloneStr(encoded.error))
    var validation = validator.SvValidate(encoded.bytes)
    if !validation.ok:
        return SvSnapBlockFail(strings.CloneStr(validation.error))
    var commitError: str = writer.SvWriterCommit(encoded.bytes, outPath)
    if commitError.len > 0:
        return SvSnapBlockFail(strings.CloneStr(commitError))
    var out: SvSnapBlockResult
    out.ok = true
    out.factCount = encoded.factCount
    out.contentId = strings.CloneStr(manifest.contentId)
    out.dirCid = strings.CloneStr(encoded.claimedDirectoryCid)
    out.blockBytes = int64(rawbytes.BytesLen(encoded.bytes))
    return out
