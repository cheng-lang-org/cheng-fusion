import std/strings
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_canonical as jc
import cheng/core/csg_core/json_field as jfield
import cheng/core/csg_core/merkle_store_codec
import cheng/game/assets/semantic_video/schema
import cheng/game/assets/semantic_video/reader

# v0.1 验证路径：结构、schema、未知扩展、值域、跨记录引用与依赖环。
# 全部规则与错误码见 docs/specs/csg-semantic-video-v0.1.md §2/§4。
# 失败返回首个错误码；可选 x- 扩展记入 ignoredExtensions。

type
    SvValidation =
        ok: bool
        error: str
        ignoredExtensions: str[]

@borrows
fn SvValidateFail(error: str): SvValidation =
    var out: SvValidation
    out.error = strings.CloneStr(error)
    return out

@borrows
fn SvValidOk(): SvValidation =
    var out: SvValidation
    out.ok = true
    return out

@borrows
fn SvStrInList(value: str, list: str[]): bool =
    for i in 0..<list.len:
        if list[i] == value:
            return true
    return false

@borrows
fn SvStrArraySortedUnique(list: str[]): bool =
    for i in 0..<list.len:
        if i > 0 && schema.SvTextCompare(list[i - 1], list[i]) >= 0:
            return false
    return true

@borrows
fn SvCapKnown(cap: str): bool =
    return cap == schema.SvCapCommonCore ||
        cap == schema.SvCapSemanticDescription ||
        cap == schema.SvCapSpatialReconstruction ||
        cap == schema.SvCapWorldExecution ||
        cap == schema.SvCapRealtimeStreaming

@borrows
fn SvPredKnown(pred: str): bool =
    return pred == schema.SvPredObjectTrack ||
        pred == schema.SvPredEnterRegion ||
        pred == schema.SvPredLeaveRegion ||
        pred == schema.SvPredContactCandidate ||
        pred == schema.SvPredUserOperation

@borrows
fn SvSourceClassKnown(sourceClass: str): bool =
    return sourceClass == schema.SvSourceObserved ||
        sourceClass == schema.SvSourceInferred ||
        sourceClass == schema.SvSourceManual ||
        sourceClass == schema.SvSourceUnknown

@borrows
fn SvTimeRangeValid(tbNum: int32, tbDen: int32,
        tickStart: int64, tickEnd: int64): bool =
    return tbNum > 0 && tbDen > 0 &&
        tickStart >= int64(0) && tickStart < tickEnd

# 顶层键遍历：canonical 行内无字符串外空白，可顺序扫描。
@borrows
fn SvSkipString(line: str, quoteAt: int32): int32 =
    var at: int32 = quoteAt + 1
    var escaped = false
    while at < line.len:
        let ch = line[at]
        if escaped:
            escaped = false
        elif ch == '\\':
            escaped = true
        elif ch == '"':
            return at + 1
        at = at + 1
    return -1

@borrows
fn SvSkipValue(line: str, valueAt: int32): int32 =
    var at: int32 = valueAt
    if at >= line.len:
        return -1
    if line[at] == '"':
        return SvSkipString(line, at)
    if line[at] == '{' || line[at] == '[':
        var depth: int32 = 0
        while at < line.len:
            let ch = line[at]
            if ch == '"':
                at = SvSkipString(line, at)
                if at < 0:
                    return -1
                continue
            if ch == '{' || ch == '[':
                depth = depth + 1
            elif ch == '}' || ch == ']':
                depth = depth - 1
                if depth == 0:
                    return at + 1
            at = at + 1
        return -1
    while at < line.len:
        let ch = line[at]
        if ch == ',' || ch == '}' || ch == ']':
            return at
        at = at + 1
    return at

@borrows
fn SvTopLevelKeys(line: str, keys: var str[]) : bool =
    var at: int32 = 1
    if line.len < 2 || line[0] != '{':
        return false
    while at < line.len:
        if line[at] == '}':
            return true
        if line[at] != '"':
            return false
        let keyEnd = SvSkipString(line, at)
        if keyEnd < 0:
            return false
        let rawKey = strings.SliceBytes(line, at, keyEnd - at)
        add(keys, strings.CloneStr(reader.SvDecodeQuotedElement(rawKey)))
        if keyEnd >= line.len || line[keyEnd] != ':':
            return false
        let valueEnd = SvSkipValue(line, keyEnd + 1)
        if valueEnd < 0:
            return false
        if valueEnd >= line.len:
            return false
        if line[valueEnd] == '}':
            return true
        if line[valueEnd] != ',':
            return false
        at = valueEnd + 1
    return false

@borrows
fn SvKindAllowedKeys(kind: str): str[] =
    var keys: str[]
    if kind == schema.SvKindManifest:
        add(keys, "cap")
        add(keys, "contentId")
        add(keys, "entrySnapshot")
        add(keys, "kind")
        add(keys, "resCid")
        add(keys, "resLength")
        add(keys, "resType")
        add(keys, "schema")
        add(keys, "tbDen")
        add(keys, "tbNum")
        add(keys, "timeEnd")
        add(keys, "timeStart")
    elif kind == schema.SvKindObservation:
        add(keys, "kind")
        add(keys, "method")
        add(keys, "obsId")
        add(keys, "schema")
        add(keys, "sensor")
        add(keys, "sourceClass")
        add(keys, "srcTrack")
        add(keys, "tbDen")
        add(keys, "tbNum")
        add(keys, "tickEnd")
        add(keys, "tickStart")
    elif kind == schema.SvKindEntity:
        add(keys, "gen")
        add(keys, "kind")
        add(keys, "lifecycle")
        add(keys, "ns")
        add(keys, "num")
        add(keys, "schema")
        add(keys, "typeVer")
        add(keys, "uid")
    elif kind == schema.SvKindAssertion:
        add(keys, "confBp")
        add(keys, "confDef")
        add(keys, "kind")
        add(keys, "method")
        add(keys, "obj")
        add(keys, "pred")
        add(keys, "rev")
        add(keys, "schema")
        add(keys, "sourceClass")
        add(keys, "tbDen")
        add(keys, "tbNum")
        add(keys, "tickEnd")
        add(keys, "tickStart")
        add(keys, "uid")
        add(keys, "val")
    elif kind == schema.SvKindSnapshot:
        add(keys, "branch")
        add(keys, "ckpt")
        add(keys, "deps")
        add(keys, "kind")
        add(keys, "schema")
        add(keys, "tbDen")
        add(keys, "tbNum")
        add(keys, "tick")
        add(keys, "worldCid")
    elif kind == schema.SvKindDelta:
        add(keys, "baseCkpt")
        add(keys, "kind")
        add(keys, "opsCid")
        add(keys, "schema")
        add(keys, "seq")
        add(keys, "tbDen")
        add(keys, "tbNum")
        add(keys, "tickEnd")
        add(keys, "tickStart")
        add(keys, "toCkpt")
    elif kind == schema.SvKindCorrection:
        add(keys, "basisCid")
        add(keys, "kind")
        add(keys, "obsRef")
        add(keys, "payloadCid")
        add(keys, "schema")
        add(keys, "spaceDomain")
        add(keys, "tbDen")
        add(keys, "tbNum")
        add(keys, "tickEnd")
        add(keys, "tickStart")
    elif kind == schema.SvKindDependency:
        add(keys, "consumer")
        add(keys, "kind")
        add(keys, "purpose")
        add(keys, "queryBasis")
        add(keys, "schema")
        add(keys, "target")
        add(keys, "targetVer")
    elif kind == schema.SvKindRevision:
        add(keys, "kind")
        add(keys, "newRev")
        add(keys, "oldRev")
        add(keys, "publishedTick")
        add(keys, "reason")
        add(keys, "schema")
        add(keys, "supersedes")
        add(keys, "targetUid")
        add(keys, "tbDen")
        add(keys, "tbNum")
    elif kind == schema.SvKindReceipt:
        add(keys, "capReq")
        add(keys, "capVerified")
        add(keys, "configCid")
        add(keys, "implCid")
        add(keys, "kind")
        add(keys, "result")
        add(keys, "schema")
        add(keys, "subjectCid")
        add(keys, "summaryCid")
    elif kind == schema.SvKindPlane:
        add(keys, "areaPx")
        add(keys, "colorB")
        add(keys, "colorDef")
        add(keys, "colorG")
        add(keys, "colorR")
        add(keys, "colorSamples")
        add(keys, "confBp")
        add(keys, "confDef")
        add(keys, "cxM2")
        add(keys, "cyM2")
        add(keys, "frameCount")
        add(keys, "kind")
        add(keys, "maxAreaPx")
        add(keys, "meanAreaM1")
        add(keys, "meanDepthM1")
        add(keys, "method")
        add(keys, "paramA")
        add(keys, "paramB")
        add(keys, "paramC")
        add(keys, "paramFrames")
        add(keys, "pathLenM2")
        add(keys, "schema")
        add(keys, "sourceClass")
        add(keys, "tbDen")
        add(keys, "tbNum")
        add(keys, "tickEnd")
        add(keys, "tickStart")
        add(keys, "tid")
    return keys

# 未知键规则：仅 x- 前缀可忽略并回报；其余拒绝 sv_unknown_field。
@borrows
fn SvCheckKeys(line: str, kind: str,
        validation: var SvValidation): bool =
    var keys: str[]
    if !SvTopLevelKeys(line, keys):
        return false
    let allowed = SvKindAllowedKeys(kind)
    for i in 0..<keys.len:
        if SvStrInList(keys[i], allowed):
            continue
        if strings.HasPrefix(keys[i], "x-"):
            add(validation.ignoredExtensions, strings.CloneStr(keys[i]))
            continue
        return false
    return true

# 实体 uid 行级复算：uid 必须等于 sv-ent:<ns>:<gen>:<num>。
@borrows
fn SvCheckEntityUid(line: str): str =
    let uidField = jfield.CsgCoreJsonTopStringField(line, "uid")
    if !uidField.found || uidField.value.len == 0:
        return "sv_missing_required_field uid"
    let nsField = jfield.CsgCoreJsonTopStringField(line, "ns")
    if !nsField.found:
        return "sv_field_type_mismatch ns"
    let genParsed = reader.SvParseI64(
        jfield.CsgCoreJsonTopRawField(line, "gen").value)
    if !genParsed.ok:
        return "sv_field_type_mismatch gen"
    let numRaw = jfield.CsgCoreJsonTopRawField(line, "num")
    if !numRaw.found:
        return "sv_field_type_mismatch num"
    let numParsed = reader.SvParseI32(numRaw.value)
    if !numParsed.ok:
        return "sv_field_type_mismatch num"
    var entity: schema.SvEntityRec
    entity.ns = nsField.value
    entity.gen = genParsed.value
    entity.num = numParsed.value
    if uidField.value != schema.SvEntityUid(entity):
        return "sv_field_type_mismatch uid"
    return ""

# 依赖环检测：consumer→target 有向图。节点取 uid 去重全集，迭代 DFS
# 三色标记；栈收缩用 setLen，不依赖未声明的 pop 内建。
@borrows
fn SvDependencyHasCycle(records: schema.SvRecords): bool =
    var nodes: str[]
    for i in 0..<records.dependencies.len:
        let d = records.dependencies[i]
        if !SvStrInList(d.consumer, nodes):
            add(nodes, strings.CloneStr(d.consumer))
        if !SvStrInList(d.target, nodes):
            add(nodes, strings.CloneStr(d.target))
    var edgeFrom: int32[]
    var edgeTo: int32[]
    for i in 0..<records.dependencies.len:
        let d = records.dependencies[i]
        add(edgeFrom, SvNodeIndex(nodes, d.consumer))
        add(edgeTo, SvNodeIndex(nodes, d.target))
    var color: int32[]
    for i in 0..<nodes.len:
        add(color, 0)
    for start in 0..<nodes.len:
        if color[start] != 0:
            continue
        var stack: int32[]
        var cursor: int32[]
        add(stack, start)
        add(cursor, 0)
        color[start] = 1
        while stack.len > 0:
            let node = stack[stack.len - 1]
            var descended = false
            while cursor[cursor.len - 1] < edgeFrom.len:
                let edge = cursor[cursor.len - 1]
                cursor[cursor.len - 1] = edge + 1
                if edgeFrom[edge] != node:
                    continue
                let next = edgeTo[edge]
                if color[next] == 1:
                    return true
                if color[next] == 0:
                    color[next] = 1
                    add(stack, next)
                    add(cursor, 0)
                    descended = true
                    break
            if descended:
                continue
            color[node] = 2
            setLen(stack, stack.len - 1)
            setLen(cursor, cursor.len - 1)
    return false

@borrows
fn SvNodeIndex(nodes: str[], value: str): int32 =
    for i in 0..<nodes.len:
        if nodes[i] == value:
            return i
    return -1

@borrows
fn SvValidate(bytes: rawbytes.Bytes): SvValidation =
    var validation: SvValidation
    if int64(rawbytes.BytesLen(bytes)) > schema.SvMaxBlockBytes:
        return SvValidateFail("sv_quota_exceeded")
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if !decoded.ok:
        return SvValidateFail(schema.SvCat("sv_csgc_decode ", decoded.error))
    if decoded.factCount > schema.SvMaxRecordsPerBlock:
        return SvValidateFail("sv_quota_exceeded")
    var ownedLines: str[]
    for i in 0..<decoded.lines.len:
        add(ownedLines, strings.CloneStr(decoded.lines[i]))
    return SvValidateLines(ownedLines)

# 行级 + 记录级全量检查；SvValidate 的字节入口在解码后调用同一函数。
# lines 为 borrowed 视图时内部先落 owned 副本（SvParseRecords 收 owned 数组）。
@borrows
fn SvValidateLines(lines: str[]): SvValidation =
    var validation: SvValidation
    var ownedLines: str[]
    for i in 0..<lines.len:
        add(ownedLines, strings.CloneStr(lines[i]))
    for i in 0..<ownedLines.len:
        let line = ownedLines[i]
        let canonical = jc.CsgCoreJsonCanonicalize(line)
        if !canonical.ok || canonical.value != line:
            return SvValidateFail("sv_noncanonical_line")
        let schemaField = jfield.CsgCoreJsonTopStringField(line, "schema")
        if !schemaField.found || schemaField.value != schema.SvSchemaNamespace:
            return SvValidateFail("sv_unknown_field schema")
        let kindField = jfield.CsgCoreJsonKind(line)
        if !kindField.found:
            return SvValidateFail("sv_unknown_kind")
        let allowedKeys = SvKindAllowedKeys(kindField.value)
        if allowedKeys.len == 0:
            return SvValidateFail(
                schema.SvCat("sv_unknown_kind ", kindField.value))
        if !SvCheckKeys(line, kindField.value, validation):
            return SvValidateFail("sv_unknown_field")
        if kindField.value == schema.SvKindEntity:
            let uidError = SvCheckEntityUid(line)
            if uidError.len > 0:
                return SvValidateFail(uidError)
    let parsed = reader.SvParseRecords(ownedLines)
    if !parsed.ok:
        return SvValidateFail(parsed.error)
    let semanticError = SvValidateRecords(parsed.records)
    if semanticError.len > 0:
        return SvValidateFail(semanticError)
    validation.ok = true
    return validation

@borrows
fn SvValidateRecords(records: schema.SvRecords): str =
    # manifest
    var manifestTbNum: int32 = 0
    var manifestTbDen: int32 = 0
    if records.manifests.len > 0:
        let m = records.manifests[0]
        if records.manifests.len != 1:
            return "sv_ref_duplicate manifest"
        if m.caps.len == 0:
            return "sv_missing_required_field cap"
        if !SvStrArraySortedUnique(m.caps):
            return "sv_cap_arrays_mismatch cap_order"
        for i in 0..<m.caps.len:
            if !SvCapKnown(m.caps[i]):
                return schema.SvCat("sv_cap_unknown ", m.caps[i])
        if m.resCid.len != m.resLength.len ||
           m.resCid.len != m.resType.len:
            return "sv_cap_arrays_mismatch res"
        for i in 0..<m.resCid.len:
            if !merkle_store_codec.CsgCoreMerkleStoreCidValid(m.resCid[i]):
                return "sv_cid_malformed resCid"
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(m.contentId):
            return "sv_cid_malformed contentId"
        let hasWorld = SvStrInList(schema.SvCapWorldExecution, m.caps)
        if hasWorld != (m.entrySnapshot.len > 0):
            return "sv_missing_required_field entrySnapshot"
        if m.tbNum <= 0 || m.tbDen <= 0:
            return "sv_timebase_invalid"
        if m.timeStart < int64(0) || m.timeStart > m.timeEnd:
            return "sv_interval_reversed"
        manifestTbNum = m.tbNum
        manifestTbDen = m.tbDen
    else:
        return "sv_missing_required_field manifest"
    # entity（uid 已在行级首查中复算；此处查值域与重复）
    for i in 0..<records.entities.len:
        let e = records.entities[i]
        if e.lifecycle != schema.SvLifecycleActive &&
           e.lifecycle != schema.SvLifecycleRetired:
            return "sv_field_type_mismatch lifecycle"
        if e.gen < int64(0):
            return "sv_tick_out_of_range gen"
        for j in 0..<i:
            if records.entities[j].ns == e.ns &&
               records.entities[j].gen == e.gen &&
               records.entities[j].num == e.num:
                return "sv_ref_duplicate entity_uid"
    # observation
    for i in 0..<records.observations.len:
        let o = records.observations[i]
        if o.sensor.len == 0 || o.obsId.len == 0:
            return "sv_missing_required_field observation"
        if !SvSourceClassKnown(o.sourceClass):
            return "sv_field_type_mismatch sourceClass"
        if o.sourceClass != schema.SvSourceUnknown && o.method.len == 0:
            return "sv_missing_required_field method"
        if !SvTimeRangeValid(o.tbNum, o.tbDen, o.tickStart, o.tickEnd):
            return "sv_interval_reversed"
        if o.tbNum != manifestTbNum || o.tbDen != manifestTbDen:
            return "sv_timebase_invalid"
        for j in 0..<i:
            if records.observations[j].obsId == o.obsId:
                return "sv_ref_duplicate obsId"
    # assertion
    for i in 0..<records.assertions.len:
        let a = records.assertions[i]
        if a.uid.len == 0:
            return "sv_missing_required_field uid"
        if !SvPredKnown(a.pred):
            return schema.SvCat("sv_unknown_kind pred ", a.pred)
        if a.confBp < 0 || a.confBp > 10000 || a.confDef.len == 0:
            return "sv_conf_out_of_range"
        if a.rev < 0:
            return "sv_tick_out_of_range rev"
        if !SvSourceClassKnown(a.sourceClass):
            return "sv_field_type_mismatch sourceClass"
        if a.sourceClass != schema.SvSourceUnknown && a.method.len == 0:
            return "sv_missing_required_field method"
        if !SvTimeRangeValid(a.tbNum, a.tbDen, a.tickStart, a.tickEnd):
            return "sv_interval_reversed"
        if a.tbNum != manifestTbNum || a.tbDen != manifestTbDen:
            return "sv_timebase_invalid"
        var objFound = false
        for j in 0..<records.entities.len:
            if schema.SvEntityUid(records.entities[j]) == a.obj:
                objFound = true
                break
        if !objFound:
            return "sv_ref_undefined assertion_obj"
        for j in 0..<i:
            if records.assertions[j].uid == a.uid:
                return "sv_ref_duplicate assertion_uid"
    # snapshot
    for i in 0..<records.snapshots.len:
        let s = records.snapshots[i]
        if s.branch.len == 0 || s.ckpt.len == 0:
            return "sv_missing_required_field snapshot"
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(s.worldCid):
            return "sv_cid_malformed worldCid"
        if s.tbNum != manifestTbNum || s.tbDen != manifestTbDen:
            return "sv_timebase_invalid"
        if s.tick < int64(0):
            return "sv_tick_out_of_range tick"
        if !SvStrArraySortedUnique(s.deps):
            return "sv_cap_arrays_mismatch deps_order"
        for j in 0..<i:
            if records.snapshots[j].branch == s.branch &&
               records.snapshots[j].ckpt == s.ckpt:
                return "sv_ref_duplicate snapshot_ckpt"
    # delta：值域检查；链检查在 SvDeltaChainsInvalid（与物理顺序无关）。
    for i in 0..<records.deltas.len:
        let d = records.deltas[i]
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(d.opsCid):
            return "sv_cid_malformed opsCid"
        if !SvTimeRangeValid(d.tbNum, d.tbDen, d.tickStart, d.tickEnd):
            return "sv_interval_reversed"
        if d.tbNum != manifestTbNum || d.tbDen != manifestTbDen:
            return "sv_timebase_invalid"
        if d.seqNum < int64(0):
            return "sv_delta_seq_gap"
        if d.baseCkpt.len == 0 || d.toCkpt.len == 0:
            return "sv_missing_required_field delta"
    if SvDeltaChainsInvalid(records):
        return "sv_delta_seq_gap"
    # correction
    for i in 0..<records.corrections.len:
        let c = records.corrections[i]
        if c.spaceDomain.len == 0:
            return "sv_missing_required_field spaceDomain"
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(c.basisCid):
            return "sv_cid_malformed basisCid"
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(c.payloadCid):
            return "sv_cid_malformed payloadCid"
        if !SvTimeRangeValid(c.tbNum, c.tbDen, c.tickStart, c.tickEnd):
            return "sv_interval_reversed"
        if c.tbNum != manifestTbNum || c.tbDen != manifestTbDen:
            return "sv_timebase_invalid"
        var obsFound = false
        for j in 0..<records.observations.len:
            if records.observations[j].obsId == c.obsRef:
                obsFound = true
                break
        if !obsFound:
            return "sv_ref_undefined correction_obs"
    # dependency：非空 + 无环
    for i in 0..<records.dependencies.len:
        let d = records.dependencies[i]
        if d.consumer.len == 0 || d.purpose.len == 0 ||
           d.queryBasis.len == 0 || d.target.len == 0 ||
           d.targetVer.len == 0:
            return "sv_missing_required_field dependency"
    if SvDependencyHasCycle(records):
        return "sv_ref_cycle"
    # revision
    for i in 0..<records.revisions.len:
        let r = records.revisions[i]
        if r.reason.len == 0 || r.targetUid.len == 0 || r.supersedes.len == 0:
            return "sv_missing_required_field revision"
        if r.oldRev < 0 || r.newRev <= r.oldRev:
            return "sv_field_type_mismatch rev"
        if r.publishedTick < int64(0):
            return "sv_tick_out_of_range publishedTick"
        if r.tbNum != manifestTbNum || r.tbDen != manifestTbDen:
            return "sv_timebase_invalid"
        var supersededFound = false
        for j in 0..<records.assertions.len:
            if records.assertions[j].uid == r.supersedes:
                supersededFound = true
                break
        if !supersededFound:
            for j in 0..<records.observations.len:
                if records.observations[j].obsId == r.supersedes:
                    supersededFound = true
                    break
        if !supersededFound:
            return "sv_ref_undefined revision_supersedes"
    # receipt
    for i in 0..<records.receipts.len:
        let rc = records.receipts[i]
        if rc.result != schema.SvResultPass && rc.result != schema.SvResultFail:
            return "sv_field_type_mismatch result"
        if !SvStrArraySortedUnique(rc.capReq) ||
           !SvStrArraySortedUnique(rc.capVerified):
            return "sv_cap_arrays_mismatch cap_order"
        for j in 0..<rc.capReq.len:
            if !SvCapKnown(rc.capReq[j]):
                return schema.SvCat("sv_cap_unknown ", rc.capReq[j])
        for j in 0..<rc.capVerified.len:
            if !SvStrInList(rc.capVerified[j], rc.capReq):
                return "sv_cap_arrays_mismatch capVerified"
        if !merkle_store_codec.CsgCoreMerkleStoreCidValid(rc.configCid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(rc.implCid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(rc.subjectCid) ||
           !merkle_store_codec.CsgCoreMerkleStoreCidValid(rc.summaryCid):
            return "sv_cid_malformed receipt"
    # plane（规范 §9）：值域、轨迹/参数形状、tid 块内唯一。CSGC 按 kind
    # 分节，块内记录是集合不是序列（同 delta 链「与物理顺序无关」先例），
    # 顺序类检查一律序无关；平面记录无跨记录引用，环不可能，环合同由
    # dependency/delta 承担。
    for i in 0..<records.planes.len:
        let p = records.planes[i]
        if p.tid < 0:
            return "sv_tick_out_of_range tid"
        for j in 0..<i:
            if records.planes[j].tid == p.tid:
                return "sv_ref_duplicate plane_tid"
        if !SvTimeRangeValid(p.tbNum, p.tbDen, p.tickStart, p.tickEnd):
            return "sv_interval_reversed"
        if p.tbNum != manifestTbNum || p.tbDen != manifestTbDen:
            return "sv_timebase_invalid"
        if p.frameCount < 1 ||
           p.tickEnd - p.tickStart != int64(p.frameCount):
            return "sv_plane_traj_len"
        if p.cxM2.len != p.frameCount || p.cyM2.len != p.frameCount ||
           p.areaPx.len != p.frameCount:
            return "sv_plane_traj_len"
        if p.maxAreaPx < 1 || p.meanAreaM1 < 0 ||
           Int64(p.meanAreaM1) > Int64(p.maxAreaPx) * int64(10):
            return "sv_field_type_mismatch plane_area"
        for j in 0..<p.areaPx.len:
            if p.areaPx[j] < 0 || p.areaPx[j] > p.maxAreaPx:
                return "sv_field_type_mismatch plane_area"
        if p.meanDepthM1 < 0 || p.meanDepthM1 > 2550:
            return "sv_field_type_mismatch plane_depth"
        if p.colorR < 0 || p.colorR > 255 || p.colorG < 0 ||
           p.colorG > 255 || p.colorB < 0 || p.colorB > 255:
            return "sv_field_type_mismatch plane_color"
        if p.colorSamples != p.frameCount:
            return "sv_field_type_mismatch plane_color"
        if p.confBp < 0 || p.confBp > 10000:
            return "sv_conf_out_of_range"
        if p.colorDef.len == 0 || p.confDef.len == 0 || p.method.len == 0:
            return "sv_missing_required_field plane"
        if !SvSourceClassKnown(p.sourceClass):
            return "sv_field_type_mismatch sourceClass"
        let hasParams = p.paramFrames.len > 0 || p.paramA.len > 0 ||
            p.paramB.len > 0 || p.paramC.len > 0
        if hasParams:
            if p.paramFrames.len != p.paramA.len ||
               p.paramFrames.len != p.paramB.len ||
               p.paramFrames.len != p.paramC.len:
                return "sv_plane_param"
            for j in 0..<p.paramFrames.len:
                if j > 0 && p.paramFrames[j - 1] >= p.paramFrames[j]:
                    return "sv_plane_param"
                if Int64(p.paramFrames[j]) < p.tickStart ||
                   Int64(p.paramFrames[j]) >= p.tickEnd:
                    return "sv_plane_param"
    return ""

# delta 链检查（与物理顺序无关）：toCkpt/baseCkpt 不得分叉；每个
# delta 沿 predecessor（toCkpt==baseCkpt）走到链头（某 snapshot.ckpt），
# 步数必须恰等于 seq。
@borrows
fn SvDeltaChainsInvalid(records: schema.SvRecords): bool =
    for i in 0..<records.deltas.len:
        for j in 0..<records.deltas.len:
            if i != j && records.deltas[i].toCkpt ==
                   records.deltas[j].toCkpt:
                return true
            if i != j && records.deltas[i].baseCkpt ==
                   records.deltas[j].baseCkpt:
                return true
    for i in 0..<records.deltas.len:
        var current = i
        var steps: int64 = int64(0)
        while steps <= int64(records.deltas.len):
            var advanced = false
            for j in 0..<records.deltas.len:
                if j != current && records.deltas[j].toCkpt ==
                       records.deltas[current].baseCkpt:
                    current = j
                    steps = steps + int64(1)
                    advanced = true
                    break
            if advanced:
                continue
            break
        if steps != records.deltas[i].seqNum:
            return true
        var headIsSnapshot = false
        for j in 0..<records.snapshots.len:
            if records.snapshots[j].ckpt ==
                   records.deltas[current].baseCkpt:
                headIsSnapshot = true
                break
        if !headIsSnapshot:
            return true
    return false
