# CSG语义视频 v0.1 时间合同纯函数。字节合同唯一来源：
# docs/specs/csg-semantic-video-v0.1.md §3：int64 tick + 有理 timebase
# tbNum/tbDen（均 >0），区间左闭右开；比较/换算必须防溢出。
# 本模块全部为纯 int64/int32 运算，无 IO、无托管内存。
# 前置条件（由 validator 的 sv_timebase_invalid / sv_tick_out_of_range /
# sv_interval_reversed 保证，本模块不重复校验）：
#   tbNum > 0、tbDen > 0、tick ≥ 0、interval start ≤ end。

const
    SvMaxI64: int64 = 9223372036854775807
    SvLimbMask: int64 = 4294967295

type
    SvConvertResult =
        ok: bool
        value: int64

    # 128 位无符号累加器，基 2^32 小端四肢。溢出防护方案（理论最稳）：
    # 交叉积 = aTick*aTbNum*bTbDen，上界 2^63 * 2^31 * 2^31 = 2^125 < 2^128，
    # 四肢基 2^32 恰好完整容纳整个定义域，全程无任何中间溢出，因此
    # 无需先约分、无需任何"溢出再兜底"的分段比较——单一路径精确比较。
    SvLimb128 =
        v0: int64
        v1: int64
        v2: int64
        v3: int64

fn SvLimb128FromTick(tick: int64): SvLimb128 =
    var limbs: SvLimb128
    limbs.v0 = tick & SvLimbMask
    limbs.v1 = tick >> 32
    limbs.v2 = 0
    limbs.v3 = 0
    return limbs

# acc *= factor。factor ∈ [1, 2^31-1]（int32 正数）。
# 每步 t = limb*factor + carry 上界 (2^32-1)(2^31-1) + (2^31-1) < 2^63，
# int64 内精确；末端 carry 必为 0（acc < 2^125 < 2^128），违例即断言崩溃。
fn SvLimb128MulSmall(acc: var SvLimb128, factor: int64) =
    var carry: int64 = 0
    var t = acc.v0 * factor + carry
    acc.v0 = t & SvLimbMask
    carry = t >> 32
    t = acc.v1 * factor + carry
    acc.v1 = t & SvLimbMask
    carry = t >> 32
    t = acc.v2 * factor + carry
    acc.v2 = t & SvLimbMask
    carry = t >> 32
    t = acc.v3 * factor + carry
    acc.v3 = t & SvLimbMask
    carry = t >> 32
    assert(carry == 0, "svtime: 128-bit limb overflow")

# 比较 aTick*(aTbNum/aTbDen) 与 bTick*(bTbNum/bTbDen) 两个时间点。
# 返回 -1/0/1。交叉相乘走 128 位四肢（见 SvLimb128 注释），对整个
# 合同定义域（tick < 2^63、tbNum/tbDen < 2^31）精确，不溢出、不拒绝。
fn SvTickCmp(aTbNum: int32, aTbDen: int32, aTick: int64,
        bTbNum: int32, bTbDen: int32, bTick: int64): int32 =
    var left = SvLimb128FromTick(aTick)
    SvLimb128MulSmall(left, int64(aTbNum))
    SvLimb128MulSmall(left, int64(bTbDen))
    var right = SvLimb128FromTick(bTick)
    SvLimb128MulSmall(right, int64(bTbNum))
    SvLimb128MulSmall(right, int64(aTbDen))
    if left.v3 != right.v3:
        return left.v3 < right.v3 ? -1 : 1
    if left.v2 != right.v2:
        return left.v2 < right.v2 ? -1 : 1
    if left.v1 != right.v1:
        return left.v1 < right.v1 ? -1 : 1
    if left.v0 != right.v0:
        return left.v0 < right.v0 ? -1 : 1
    return 0

# SvGcdPos(a, b)：非负欧几里得最大公约数。
fn SvGcdPos(a: int64, b: int64): int64 =
    var x = a
    var y = b
    while y > 0:
        let r = x % y
        x = y
        y = r
    return x

# 把 tick 从 timebase fromNum/fromDen 精确换算到 toNum/toDen。
# 即求 t' = tick * fromNum * toDen / (fromDen * toNum)。
# v0.1 不做舍入：先对 6 对分子/分母因子反复约分到最简（此时
# gcd(分子, 分母)=1），分母未归一则无法精确表示，返回 ok=false；
# 分母已归一但数值超出 int64 同样返回 ok=false。宁可拒绝，不猜测。
fn SvTickConvert(tick: int64, fromNum: int32, fromDen: int32,
        toNum: int32, toDen: int32): SvConvertResult =
    var t = tick
    var num1 = int64(fromNum)
    var den1 = int64(fromDen)
    var num2 = int64(toDen)
    var den2 = int64(toNum)
    var changed = true
    while changed:
        changed = false
        var g = SvGcdPos(t, den1)
        if g > 1:
            t = t / g
            den1 = den1 / g
            changed = true
        g = SvGcdPos(t, den2)
        if g > 1:
            t = t / g
            den2 = den2 / g
            changed = true
        g = SvGcdPos(num1, den1)
        if g > 1:
            num1 = num1 / g
            den1 = den1 / g
            changed = true
        g = SvGcdPos(num1, den2)
        if g > 1:
            num1 = num1 / g
            den2 = den2 / g
            changed = true
        g = SvGcdPos(num2, den1)
        if g > 1:
            num2 = num2 / g
            den1 = den1 / g
            changed = true
        g = SvGcdPos(num2, den2)
        if g > 1:
            num2 = num2 / g
            den2 = den2 / g
            changed = true
    var miss: SvConvertResult
    miss.ok = false
    miss.value = 0
    if den1 != 1 || den2 != 1:
        return miss
    var value = t
    if num1 > 1:
        if value > SvMaxI64 / num1:
            return miss
        value = value * num1
    if num2 > 1:
        if value > SvMaxI64 / num2:
            return miss
        value = value * num2
    var hit: SvConvertResult
    hit.ok = true
    hit.value = value
    return hit

# 左闭右开区间 [aStart,aEnd) 与 [bStart,bEnd) 是否相交。
# 精确判据 max(aStart,bStart) < min(aEnd,bEnd)：相邻（一开一闭共享
# 端点）不算相交；空区间与任何区间（含另一空区间）都不相交。
fn SvIntervalOverlap(aStart: int64, aEnd: int64,
        bStart: int64, bEnd: int64): bool =
    var lo = aStart > bStart ? aStart : bStart
    var hi = aEnd < bEnd ? aEnd : bEnd
    return lo < hi

# 左闭右开区间包含：[bStart,bEnd) ⊆ [aStart,aEnd)。
fn SvIntervalContains(aStart: int64, aEnd: int64,
        bStart: int64, bEnd: int64): bool =
    return aStart <= bStart && bEnd <= aEnd

# 左闭右开区间单点包含：tick ∈ [start,end)，右端点不属于。
fn SvIntervalContainsTick(start: int64, end: int64, tick: int64): bool =
    return start <= tick && tick < end
