import std/strings
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/game/assets/import/mp4

# CSG 语义视频 B2: 存量 MP4 视频轨完整样本表。
# import/mp4 只解析 stts/stss/mdhd (无逐样本 offset/size); 本模块补齐
# stbl 下 stsz(stz2 不做)/stco/co64 + stsc (sample-to-chunk, 逐样本
# offset 的精确推导必需——单 chunk 多样本文件无 stsc 不可算)。
# 合同 (B2 冻结接口): offset=文件绝对字节偏移; pts=stts delta 累计 tick
# (严格递增, 首样本 pts=0); key∈{0,1}。跨模块只经值返回结构体交换
# (跨模块 var 结构体出参不可靠, asset 战役在案)。
# 任何损坏/不一致/越界: ok=false + svsrc_ 前缀结构化错误串, 不补位不启发。

fn SvSrcFourccMoov(): int32 =
    return (109 << 24) + (111 << 16) + (111 << 8) + 118

fn SvSrcFourccTrak(): int32 =
    return (116 << 24) + (114 << 16) + (97 << 8) + 107

fn SvSrcFourccMdia(): int32 =
    return (109 << 24) + (100 << 16) + (105 << 8) + 97

fn SvSrcFourccMinf(): int32 =
    return (109 << 24) + (105 << 16) + (110 << 8) + 102

fn SvSrcFourccStbl(): int32 =
    return (115 << 24) + (116 << 16) + (98 << 8) + 108

fn SvSrcFourccStsz(): int32 =
    return (115 << 24) + (116 << 16) + (115 << 8) + 122

fn SvSrcFourccStz2(): int32 =
    return (115 << 24) + (116 << 16) + (122 << 8) + 50

fn SvSrcFourccStco(): int32 =
    return (115 << 24) + (116 << 16) + (99 << 8) + 111

fn SvSrcFourccCo64(): int32 =
    return (99 << 24) + (111 << 16) + (54 << 8) + 52

fn SvSrcFourccStsc(): int32 =
    return (115 << 24) + (116 << 16) + (115 << 8) + 99

fn SvSrcQuotaSamples(): int32 =
    return 1048576

type
    SvSourceIndex =
        ok: bool
        error: str
        timescale: int32          # 视频轨 mdhd timescale
        sampleCount: int32
        keyframeCount: int32
        pts: int64[]              # 逐样本 pts (tick, 严格递增, 首样本 0)
        offset: int64[]           # 文件绝对字节偏移
        size: int32[]
        key: int32[]              # 1=关键帧 (stss 同步样本; 无 stss 全关键帧)

    SvSrcStblTables =
        ok: bool
        error: str
        stszFixed: int64          # stsz sample_size; 0=逐样本表
        stszCount: int64
        sizes: int32[]            # 逐样本表 (fixed>0 时为空)
        chunkOffsets: int64[]     # stco/co64 chunk 文件偏移
        stscFirst: int32[]        # stsc first_chunk (1-based, 严格递增)
        stscPer: int32[]          # stsc samples_per_chunk (>0)

@borrows
fn SvSrcFindChildBox(data: rawbytes.Bytes, payload: int32, length: int32,
                     want: int32, outPayload: var int32,
                     outLen: var int32): bool =
    var off: int32 = payload
    let endOff: int32 = payload + length
    var boxType: int32
    var childPayload: int32
    var childLen: int32
    while off < endOff:
        if !mp4.AssetMediaBoxChildNext(data, off, endOff, boxType,
                childPayload, childLen):
            return false
        if boxType == want:
            outPayload = childPayload
            outLen = childLen
            return true
    return false

# stbl 子盒解析: stsz/stco/co64/stsc 一次性收集并做入口级结构校验
# (存在性/重复/截断/配额/co64 高位/stsc 序列)。值返回结构体。
@borrows
fn SvSrcParseStbl(data: rawbytes.Bytes, stblPayload: int32, stblLen: int32,
                  fileLen: int32): SvSrcStblTables =
    var out: SvSrcStblTables
    var sawStsz = false
    var sawStco = false
    var sawCo64 = false
    var sawStsc = false
    var bOff: int32 = stblPayload
    let bEnd: int32 = stblPayload + stblLen
    var bType: int32
    var bPayload: int32
    var bLen: int32
    while bOff < bEnd:
        if !mp4.AssetMediaBoxChildNext(data, bOff, bEnd, bType, bPayload, bLen):
            out.error = "svsrc_box_walk stbl"
            return out
        if bType == SvSrcFourccStz2():
            out.error = "svsrc_stz2_unsupported"
            return out
        elif bType == SvSrcFourccStsz():
            if sawStsz:
                out.error = "svsrc_duplicate_box stsz"
                return out
            sawStsz = true
            if bLen < 12:
                out.error = "svsrc_box_truncated stsz"
                return out
            var fixed: int64
            var cnt: int64
            if !mp4.AssetMediaU32Be(data, bPayload + 4, fixed) ||
               !mp4.AssetMediaU32Be(data, bPayload + 8, cnt):
                out.error = "svsrc_box_truncated stsz"
                return out
            if cnt > int64(SvSrcQuotaSamples()):
                out.error = "svsrc_quota_exceeded stsz"
                return out
            if fixed > int64(fileLen):
                out.error = "svsrc_offset_out_of_range stsz_fixed_size"
                return out
            if fixed == int64(0):
                if int64(bLen) < int64(12) + cnt * int64(4):
                    out.error = "svsrc_box_truncated stsz_table"
                    return out
                var k: int32 = 0
                while k < int32(cnt):
                    var sz: int64
                    if !mp4.AssetMediaU32Be(data, bPayload + 12 + k * 4, sz):
                        out.error = "svsrc_box_truncated stsz_entry"
                        return out
                    if sz > int64(fileLen):
                        out.error = "svsrc_offset_out_of_range stsz_entry"
                        return out
                    add(out.sizes, int32(sz))
                    k = k + 1
            out.stszFixed = fixed
            out.stszCount = cnt
        elif bType == SvSrcFourccStco() || bType == SvSrcFourccCo64():
            if sawStco || sawCo64:
                out.error = "svsrc_duplicate_box stco_co64"
                return out
            if bType == SvSrcFourccStco():
                sawStco = true
            else:
                sawCo64 = true
            if bLen < 8:
                out.error = "svsrc_box_truncated chunk_offset"
                return out
            var cnt: int64
            if !mp4.AssetMediaU32Be(data, bPayload + 4, cnt):
                out.error = "svsrc_box_truncated chunk_offset"
                return out
            if cnt > int64(SvSrcQuotaSamples()):
                out.error = "svsrc_quota_exceeded chunk_offset"
                return out
            var k: int32 = 0
            while k < int32(cnt):
                if bType == SvSrcFourccStco():
                    var v: int64
                    if !mp4.AssetMediaU32Be(data, bPayload + 8 + k * 4, v):
                        out.error = "svsrc_box_truncated stco_entry"
                        return out
                    add(out.chunkOffsets, v)
                else:
                    var hi: int64
                    var lo: int64
                    if !mp4.AssetMediaU32Be(data, bPayload + 8 + k * 8, hi) ||
                       !mp4.AssetMediaU32Be(data, bPayload + 12 + k * 8, lo):
                        out.error = "svsrc_box_truncated co64_entry"
                        return out
                    # Bytes 层 int32 寻址域 < 2GiB; co64 高位非 0 即超域拒绝。
                    if hi != int64(0):
                        out.error = "svsrc_offset_out_of_range co64_hi"
                        return out
                    add(out.chunkOffsets, lo)
                k = k + 1
        elif bType == SvSrcFourccStsc():
            if sawStsc:
                out.error = "svsrc_duplicate_box stsc"
                return out
            sawStsc = true
            if bLen < 8:
                out.error = "svsrc_box_truncated stsc"
                return out
            var cnt: int64
            if !mp4.AssetMediaU32Be(data, bPayload + 4, cnt):
                out.error = "svsrc_box_truncated stsc"
                return out
            if cnt > int64(65536):
                out.error = "svsrc_quota_exceeded stsc"
                return out
            if cnt < int64(1):
                out.error = "svsrc_bad_stsc empty"
                return out
            if int64(bLen) < int64(8) + cnt * int64(12):
                out.error = "svsrc_box_truncated stsc_entries"
                return out
            var k: int32 = 0
            while k < int32(cnt):
                var first: int64
                var per: int64
                var sdi: int64
                if !mp4.AssetMediaU32Be(data, bPayload + 8 + k * 12, first) ||
                   !mp4.AssetMediaU32Be(data, bPayload + 12 + k * 12, per) ||
                   !mp4.AssetMediaU32Be(data, bPayload + 16 + k * 12, sdi):
                    out.error = "svsrc_box_truncated stsc_entry"
                    return out
                if first > int64(2147483647):
                    out.error = "svsrc_bad_stsc first_chunk"
                    return out
                if k == 0:
                    if first != int64(1):
                        out.error = "svsrc_bad_stsc first_chunk_not_1"
                        return out
                else:
                    if first <= int64(out.stscFirst[out.stscFirst.len - 1]):
                        out.error = "svsrc_bad_stsc first_chunk_order"
                        return out
                if per <= int64(0) || per > int64(2147483647):
                    out.error = "svsrc_bad_stsc samples_per_chunk"
                    return out
                add(out.stscFirst, int32(first))
                add(out.stscPer, int32(per))
                k = k + 1
    if !sawStsz:
        out.error = "svsrc_missing_stsz"
        return out
    if !sawStco && !sawCo64:
        out.error = "svsrc_missing_stco"
        return out
    if !sawStsc:
        out.error = "svsrc_missing_stsc"
        return out
    out.ok = true
    return out

# 主入口: data=整个 mp4 文件字节。先 AssetMediaParseMp4 (stts/stss/mdhd),
# 再自行定位首个视频轨 stbl 解 stsz/stco/co64/stsc, 产出完整样本表。
@borrows
fn SvSourceIndexBuild(data: rawbytes.Bytes): SvSourceIndex =
    var idx: SvSourceIndex
    var info: mp4.AssetMp4Info
    var mp4Err: str
    if !mp4.AssetMediaParseMp4(data, info, mp4Err):
        idx.error = strings.ConcatStr("svsrc_mp4_parse ", mp4Err)
        return idx
    var videoTrack: int32 = -1
    for i in 0..<info.trackCount:
        if info.tracks[i].handler == mp4.AssetMediaHandlerVide() &&
           videoTrack < 0:
            videoTrack = i
    if videoTrack < 0:
        idx.error = "svsrc_no_video_track"
        return idx
    let track = info.tracks[videoTrack]
    if track.timebase <= 0:
        idx.error = "svsrc_timescale_invalid"
        return idx
    if track.sampleCount <= 0:
        idx.error = "svsrc_empty_video_track"
        return idx
    idx.timescale = track.timebase
    idx.sampleCount = track.sampleCount

    let fileLen = rawbytes.BytesLen(data)
    var off: int32 = 0
    var trakSeen: int32 = 0
    var stblPayload: int32 = 0
    var stblLen: int32 = 0
    var foundStbl = false
    var walkFailed = false
    while off + 8 <= fileLen:
        var boxType: int32
        var payload: int32
        var payloadLen: int32
        if !mp4.AssetMediaBoxChildNext(data, off, fileLen, boxType, payload,
                payloadLen):
            walkFailed = true
            break
        if boxType == SvSrcFourccMoov():
            var mOff: int32 = payload
            let mEnd: int32 = payload + payloadLen
            while mOff < mEnd:
                var tType: int32
                var tPayload: int32
                var tLen: int32
                if !mp4.AssetMediaBoxChildNext(data, mOff, mEnd, tType,
                        tPayload, tLen):
                    walkFailed = true
                    break
                if tType == SvSrcFourccTrak():
                    if trakSeen == videoTrack:
                        var mdiaPayload: int32
                        var mdiaLen: int32
                        var minfPayload: int32
                        var minfLen: int32
                        if !SvSrcFindChildBox(data, tPayload, tLen,
                                SvSrcFourccMdia(), mdiaPayload, mdiaLen):
                            idx.error = "svsrc_missing_box mdia"
                            return idx
                        if !SvSrcFindChildBox(data, mdiaPayload, mdiaLen,
                                SvSrcFourccMinf(), minfPayload, minfLen):
                            idx.error = "svsrc_missing_box minf"
                            return idx
                        if !SvSrcFindChildBox(data, minfPayload, minfLen,
                                SvSrcFourccStbl(), stblPayload, stblLen):
                            idx.error = "svsrc_missing_box stbl"
                            return idx
                        foundStbl = true
                    trakSeen = trakSeen + 1
                mOff = tPayload + tLen
        if foundStbl || walkFailed:
            break
    if walkFailed:
        idx.error = "svsrc_box_walk top_level"
        return idx
    if !foundStbl:
        idx.error = "svsrc_missing_stbl"
        return idx

    var tables = SvSrcParseStbl(data, stblPayload, stblLen, fileLen)
    if !tables.ok:
        idx.error = strings.CloneStr(tables.error)
        return idx
    if tables.stszCount != int64(track.sampleCount):
        idx.error = "svsrc_sample_count_mismatch stsz_stts"
        return idx

    # pts: stts delta 逐样本累计, 严格递增且非负 (delta<=0 拒绝)。
    var tick: int64 = int64(0)
    var si: int32 = 0
    for e in 0..<track.sttsCounts.len:
        let cnt = track.sttsCounts[e]
        let dl = track.sttsDeltas[e]
        if cnt <= int64(0) || cnt > int64(2147483647):
            idx.error = "svsrc_bad_stts count"
            return idx
        if dl <= int64(0):
            idx.error = "svsrc_bad_delta"
            return idx
        var k: int32 = 0
        while k < int32(cnt):
            if si >= track.sampleCount:
                idx.error = "svsrc_sample_count_mismatch stts_overrun"
                return idx
            add(idx.pts, tick)
            tick = tick + dl
            if tick >= int64(4611686018427387904):
                idx.error = "svsrc_pts_overflow"
                return idx
            si = si + 1
            k = k + 1
    if si != track.sampleCount:
        idx.error = "svsrc_sample_count_mismatch stts_underrun"
        return idx

    # 逐样本 offset: stsc 展开 chunk → chunk 内按样本尺寸顺次推进。
    var pi: int32 = 0
    var run: int32 = 0
    var chunkNo: int32 = 1
    while chunkNo <= tables.chunkOffsets.len:
        while run + 1 < tables.stscFirst.len &&
              tables.stscFirst[run + 1] <= chunkNo:
            run = run + 1
        let per = tables.stscPer[run]
        var pos: int64 = tables.chunkOffsets[chunkNo - 1]
        var k: int32 = 0
        while k < per:
            if pi >= track.sampleCount:
                idx.error = "svsrc_chunk_sample_mismatch overrun"
                return idx
            var sz: int32
            if tables.stszFixed > int64(0):
                sz = int32(tables.stszFixed)
            else:
                sz = tables.sizes[pi]
            if pos < int64(0) || sz <= 0 ||
               pos + int64(sz) > int64(fileLen):
                idx.error = "svsrc_offset_out_of_range sample"
                return idx
            add(idx.offset, pos)
            add(idx.size, sz)
            pos = pos + int64(sz)
            pi = pi + 1
            k = k + 1
        chunkNo = chunkNo + 1
    if pi != track.sampleCount:
        idx.error = "svsrc_chunk_sample_mismatch underrun"
        return idx

    # 关键帧: stss 同步样本号 (1-based); 无 stss = 全部同步样本。
    if track.syncCount < 0:
        var i: int32 = 0
        while i < track.sampleCount:
            add(idx.key, 1)
            i = i + 1
        idx.keyframeCount = track.sampleCount
    else:
        var i: int32 = 0
        while i < track.sampleCount:
            add(idx.key, 0)
            i = i + 1
        var kfCount: int32 = 0
        var t: int32 = 0
        while t < track.stssSamples.len:
            let smp = track.stssSamples[t]
            if smp < int64(1) || smp > int64(track.sampleCount):
                idx.error = "svsrc_keyframe_out_of_range"
                return idx
            if idx.key[int32(smp) - 1] == 0:
                idx.key[int32(smp) - 1] = 1
                kfCount = kfCount + 1
            t = t + 1
        if kfCount <= 0:
            idx.error = "svsrc_no_keyframe"
            return idx
        idx.keyframeCount = kfCount
    idx.ok = true
    return idx

# ---- 索引资源二进制 (小端) --------------------------------------------
# "SVIX"(4B) + u32 version=1 + u32 timescale + u32 sampleCount +
# u32 keyframeCount + pts[i64]×N + offset[i64]×N + size[i32]×N + key[i32]×N

fn SvSrcAppendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

fn SvSrcAppendI64(buf: var layout.ByteBuf, value: int64) =
    SvSrcAppendU32(buf, int32(value & int64(4294967295)))
    SvSrcAppendU32(buf, int32((value >> 32) & int64(4294967295)))

fn SvSrcLe32(b: rawbytes.Bytes, at: int32): int32 =
    return (rawbytes.BytesGet(b, at) & 255) |
        ((rawbytes.BytesGet(b, at + 1) & 255) << 8) |
        ((rawbytes.BytesGet(b, at + 2) & 255) << 16) |
        ((rawbytes.BytesGet(b, at + 3) & 255) << 24)

# 小端 i64; ≥2^63 域返回 -1 由调用方按非法值拒绝 (合法值全非负)。
fn SvSrcLeI64(b: rawbytes.Bytes, at: int32): int64 =
    let hi = SvSrcLe32(b, at + 4)
    let lo = SvSrcLe32(b, at)
    var loI: int64
    if lo < 0:
        loI = int64(lo) + int64(4294967296)
    else:
        loI = int64(lo)
    if hi < 0:
        return int64(-1)
    return int64(hi) * int64(4294967296) + loI

@borrows
fn SvSourceIndexEncodeResource(idx: SvSourceIndex): rawbytes.Bytes =
    var buf = layout.ByteBufInit(20 + idx.sampleCount * 24)
    layout.ByteBufAppendByte(buf, 83)
    layout.ByteBufAppendByte(buf, 86)
    layout.ByteBufAppendByte(buf, 73)
    layout.ByteBufAppendByte(buf, 88)
    SvSrcAppendU32(buf, 1)
    SvSrcAppendU32(buf, idx.timescale)
    SvSrcAppendU32(buf, idx.sampleCount)
    SvSrcAppendU32(buf, idx.keyframeCount)
    var i: int32 = 0
    while i < idx.sampleCount:
        SvSrcAppendI64(buf, idx.pts[i])
        i = i + 1
    i = 0
    while i < idx.sampleCount:
        SvSrcAppendI64(buf, idx.offset[i])
        i = i + 1
    i = 0
    while i < idx.sampleCount:
        SvSrcAppendU32(buf, idx.size[i])
        i = i + 1
    i = 0
    while i < idx.sampleCount:
        SvSrcAppendU32(buf, idx.key[i])
        i = i + 1
    let outBytes = layout.ByteBufToBytes(buf)
    layout.ByteBufFree(buf)
    return outBytes

# 对称解码 + 全量校验: magic/version/长度/值域 (timescale>0, 数量界内,
# pts 非负严格递增, offset 非负, size>0, key∈{0,1} 且计数吻合)。
@borrows
fn SvSourceIndexDecodeResource(bytes: rawbytes.Bytes): SvSourceIndex =
    var idx: SvSourceIndex
    let n = rawbytes.BytesLen(bytes)
    if n < 20:
        idx.error = "svsrc_index_too_short"
        return idx
    if rawbytes.BytesGet(bytes, 0) != 83 || rawbytes.BytesGet(bytes, 1) != 86 ||
       rawbytes.BytesGet(bytes, 2) != 73 || rawbytes.BytesGet(bytes, 3) != 88:
        idx.error = "svsrc_index_magic"
        return idx
    let version = SvSrcLe32(bytes, 4)
    if version != 1:
        idx.error = "svsrc_index_version"
        return idx
    let timescale = SvSrcLe32(bytes, 8)
    let sampleCount = SvSrcLe32(bytes, 12)
    let keyframeCount = SvSrcLe32(bytes, 16)
    if timescale <= 0:
        idx.error = "svsrc_index_field_invalid timescale"
        return idx
    if sampleCount <= 0 || sampleCount > SvSrcQuotaSamples():
        idx.error = "svsrc_index_field_invalid sampleCount"
        return idx
    if keyframeCount < 0 || keyframeCount > sampleCount:
        idx.error = "svsrc_index_field_invalid keyframeCount"
        return idx
    if int64(n) != int64(20) + int64(24) * int64(sampleCount):
        idx.error = "svsrc_index_length_mismatch"
        return idx
    idx.timescale = timescale
    idx.sampleCount = sampleCount
    idx.keyframeCount = keyframeCount
    var prev: int64 = int64(-1)
    var i: int32 = 0
    while i < sampleCount:
        let p = SvSrcLeI64(bytes, 20 + i * 8)
        if p < int64(0):
            idx.error = "svsrc_index_field_invalid pts"
            return idx
        if i > 0 && p <= prev:
            idx.error = "svsrc_index_field_invalid pts_order"
            return idx
        prev = p
        add(idx.pts, p)
        i = i + 1
    i = 0
    while i < sampleCount:
        let o = SvSrcLeI64(bytes, 20 + sampleCount * 8 + i * 8)
        if o < int64(0):
            idx.error = "svsrc_index_field_invalid offset"
            return idx
        add(idx.offset, o)
        i = i + 1
    var keySum: int32 = 0
    i = 0
    while i < sampleCount:
        let sz = SvSrcLe32(bytes, 20 + sampleCount * 16 + i * 4)
        if sz <= 0:
            idx.error = "svsrc_index_field_invalid size"
            return idx
        add(idx.size, sz)
        i = i + 1
    i = 0
    while i < sampleCount:
        let kf = SvSrcLe32(bytes, 20 + sampleCount * 20 + i * 4)
        if kf != 0 && kf != 1:
            idx.error = "svsrc_index_field_invalid key"
            return idx
        add(idx.key, kf)
        keySum = keySum + kf
        i = i + 1
    if keySum != keyframeCount:
        idx.error = "svsrc_index_field_invalid key_count"
        return idx
    idx.ok = true
    return idx
