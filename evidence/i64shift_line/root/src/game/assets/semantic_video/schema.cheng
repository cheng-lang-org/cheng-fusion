fn SvEntityLine(rec: SvEntityRec): str =
    var line: str = "{\"gen\":"
    line = SvCat(line, SvNumI64(rec.gen))
    line = SvCat(line, ",\"kind\":")
    line = SvCat(line, SvQuote(SvKindEntity))
    line = SvCat(line, SvCat3(",\"lifecycle\":", SvQuote(rec.lifecycle), ""))
    line = SvCat(line, SvCat3(",\"ns\":", SvQuote(rec.ns), ""))
    line = SvCat(line, SvCat3(",\"num\":", SvNumI32(rec.num), ""))
    line = SvCat(line, ",\"schema\":")
    line = SvCat(line, SvQuote(SvSchemaNamespace))
    line = SvCat(line, SvCat3(",\"typeVer\":", SvQuote(rec.typeVer), ""))
    line = SvCat(line, SvCat3(",\"uid\":", SvQuote(SvEntityUid(rec)), ""))
    line = SvCat(line, "}")
    return line

