import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/json_canonical as jc

# CSG语义视频 v0.1 领域 schema。字节合同唯一来源：
# docs/specs/csg-semantic-video-v0.1.md。字段发射顺序即该文件字段表顺序
# （canonical JSON 键序 = UTF-8 字节升序），改动任何顺序必须先改规范。

const
    SvSchemaNamespace: str = "csg_semantic_video::v0.1"
    SvKindManifest: str = "csg_semantic_video::manifest"
    SvKindObservation: str = "csg_semantic_video::observation"
    SvKindEntity: str = "csg_semantic_video::entity"
    SvKindAssertion: str = "csg_semantic_video::assertion"
    SvKindSnapshot: str = "csg_semantic_video::snapshot"
    SvKindDelta: str = "csg_semantic_video::delta"
    SvKindCorrection: str = "csg_semantic_video::correction"
    SvKindDependency: str = "csg_semantic_video::dependency"
    SvKindRevision: str = "csg_semantic_video::revision"
    SvKindReceipt: str = "csg_semantic_video::receipt"
    # 2026-09-19 增补（规范 §9, additive）：平面级语义记录。既有 10 kind
    # 与 §1-6 冻结合同不变；旧 v0.1 读取端按 sv_unknown_kind 拒绝本 kind。
    SvKindPlane: str = "csg_semantic_video::plane"

    SvCapCommonCore: str = "common_core"
    SvCapSemanticDescription: str = "semantic_description"
    SvCapSpatialReconstruction: str = "spatial_reconstruction"
    SvCapWorldExecution: str = "world_execution"
    SvCapRealtimeStreaming: str = "realtime_streaming"

    SvSourceObserved: str = "observed"
    SvSourceInferred: str = "inferred"
    SvSourceManual: str = "manual"
    SvSourceUnknown: str = "unknown"

    SvPredObjectTrack: str = "object_track"
    SvPredEnterRegion: str = "enter_region"
    SvPredLeaveRegion: str = "leave_region"
    SvPredContactCandidate: str = "contact_candidate"
    SvPredUserOperation: str = "user_operation"

    SvLifecycleActive: str = "active"
    SvLifecycleRetired: str = "retired"

    SvResultPass: str = "pass"
    SvResultFail: str = "fail"

    SvContentCidDomain: str = "csg_semantic_video.content.v0.1"
    SvResourceCidDomain: str = "csg_semantic_video.resource.v0.1"

    SvMaxRecordsPerBlock: int32 = 1048576
    SvMaxBlockBytes: int64 = 67108864

type
    SvManifestRec =
        caps: str[]
        contentId: str
        entrySnapshot: str
        resCid: str[]
        resLength: int64[]
        resType: str[]
        tbNum: int32
        tbDen: int32
        timeStart: int64
        timeEnd: int64
        # 可选扩展（规范 §2 x- 忽略键）：状态快照夹具的物理默认行为基线
        # （录制端探针 World3dCid@SvSnapBaselineProbeTick，见 snapshot_block）。
        # 空串 = 不发射该键（既有块字节不变）。
        xPhysicsBaseline: str

    SvObservationRec =
        obsId: str
        sensor: str
        srcTrack: str
        sourceClass: str
        method: str
        tbNum: int32
        tbDen: int32
        tickStart: int64
        tickEnd: int64

    SvEntityRec =
        ns: str
        gen: int64
        num: int32
        typeVer: str
        lifecycle: str

    SvAssertionRec =
        uid: str
        obj: str
        pred: str
        val: str
        confBp: int32
        confDef: str
        rev: int32
        sourceClass: str
        method: str
        tbNum: int32
        tbDen: int32
        tickStart: int64
        tickEnd: int64

    SvSnapshotRec =
        branch: str
        ckpt: str
        deps: str[]
        tick: int64
        worldCid: str
        tbNum: int32
        tbDen: int32

    SvDeltaRec =
        baseCkpt: str
        toCkpt: str
        seqNum: int64
        opsCid: str
        tbNum: int32
        tbDen: int32
        tickStart: int64
        tickEnd: int64

    SvCorrectionRec =
        obsRef: str
        spaceDomain: str
        basisCid: str
        payloadCid: str
        tbNum: int32
        tbDen: int32
        tickStart: int64
        tickEnd: int64

    SvDependencyRec =
        consumer: str
        purpose: str
        queryBasis: str
        target: str
        targetVer: str

    SvRevisionRec =
        targetUid: str
        supersedes: str
        oldRev: int32
        newRev: int32
        publishedTick: int64
        reason: str
        tbNum: int32
        tbDen: int32

    SvReceiptRec =
        capReq: str[]
        capVerified: str[]
        configCid: str
        implCid: str
        subjectCid: str
        summaryCid: str
        result: str

    # 平面级语义记录（规范 §9）：几何平面轨道（L2）。
    # 数值全部整数定点：cxM2/cyM2/pathLenM2 = 像素×100；meanAreaM1/
    # meanDepthM1 = ×10；paramA/B/C = u8 像素域平面拟合 abc×10000。
    # 时间合同 = 半开帧区间 [tickStart, tickEnd)，帧号 tick，tb=帧率倒数。
    # param* 仅在轨道有代表帧拟合值时发射（全有或全无，validator 检查）。
    SvSemPlaneRec =
        tid: int32
        tbNum: int32
        tbDen: int32
        tickStart: int64
        tickEnd: int64
        frameCount: int32
        maxAreaPx: int32
        meanAreaM1: int32
        meanDepthM1: int32
        pathLenM2: int32
        colorR: int32
        colorG: int32
        colorB: int32
        colorSamples: int32
        colorDef: str
        confBp: int32
        confDef: str
        sourceClass: str
        method: str
        cxM2: int32[]
        cyM2: int32[]
        areaPx: int32[]
        paramFrames: int32[]
        paramA: int32[]
        paramB: int32[]
        paramC: int32[]

    SvRecords =
        manifests: SvManifestRec[]
        observations: SvObservationRec[]
        entities: SvEntityRec[]
        assertions: SvAssertionRec[]
        snapshots: SvSnapshotRec[]
        deltas: SvDeltaRec[]
        corrections: SvCorrectionRec[]
        dependencies: SvDependencyRec[]
        revisions: SvRevisionRec[]
        receipts: SvReceiptRec[]
        planes: SvSemPlaneRec[]

@borrows
fn SvQuoteArray(values: str[]): str =
    var out: str = "["
    for i in 0..<values.len:
        if i > 0:
            out = SvCat(out, ",")
        out = SvCat(out, SvQuote(values[i]))
    out = SvCat(out, "]")
    return out

@borrows
fn SvCat(left: str, right: str): str =
    return strings.ConcatStr(left, right)

# JSON number 发射必须经核心 canonicalizer 权威格式化：本仓规范数在
# plain 不短于 scientific 时输出科学计数法（如 90000 → 9e4）。
# 手写 IntToStr 直出会在 SvAddVerifiedLine 的 canonical 恒等断言处被拒。
@borrows
fn SvNumI32(value: int32): str =
    let plain = strings.IntToStr(value)
    let canonical = jc.CsgCoreJsonCanonicalize(plain)
    if !canonical.ok:
        return plain
    return canonical.value

@borrows
fn SvNumI64(value: int64): str =
    let plain = strings.Int64ToStr(value)
    let canonical = jc.CsgCoreJsonCanonicalize(plain)
    if !canonical.ok:
        return plain
    return canonical.value

@borrows
fn SvTextCompare(left: str, right: str): int32 =
    let common = left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

@borrows
fn SvCat3(first: str, second: str, third: str): str =
    return SvCat(SvCat(first, second), third)

@borrows
fn SvQuote(text: str): str =
    return jc.CsgCoreJsonQuote(text)

fn SvAppendI32(out: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(out, value & 255)
    layout.ByteBufAppendByte(out, (value >> 8) & 255)
    layout.ByteBufAppendByte(out, (value >> 16) & 255)
    layout.ByteBufAppendByte(out, (value >> 24) & 255)

@borrows
fn SvAppendText(out: var layout.ByteBuf, text: str) =
    SvAppendI32(out, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(out, text[i])

@borrows
fn SvFramedCid(domain: str, payload: str): str =
    var out = layout.ByteBufInit(domain.len + payload.len + 16)
    SvAppendText(out, domain)
    SvAppendText(out, payload)
    let digest = hash256.Sha256Fixed(layout.ByteBufView(out))
    layout.ByteBufFree(out)
    return SvCat("sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn SvEntityUid(rec: SvEntityRec): str =
    return SvCat("sv-ent:",
        SvCat(rec.ns,
            SvCat(":",
                SvCat(strings.Int64ToStr(rec.gen),
                    SvCat(":", strings.IntToStr(rec.num))))))

@borrows
fn SvManifestLine(rec: SvManifestRec): str =
    var line: str = "{\"cap\":"
    line = SvCat(line, SvQuoteArray(rec.caps))
    line = SvCat(line, SvCat3(",\"contentId\":", SvQuote(rec.contentId), ""))
    line = SvCat(line, SvCat3(",\"entrySnapshot\":", SvQuote(rec.entrySnapshot), ""))
    line = SvCat(line, ",\"kind\":")
    line = SvCat(line, SvQuote(SvKindManifest))
    line = SvCat(line, ",\"resCid\":")
    line = SvCat(line, SvQuoteArray(rec.resCid))
    line = SvCat(line, ",\"resLength\":[")
    for i in 0..<rec.resLength.len:
        if i > 0:
            line = SvCat(line, ",")
        line = SvCat(line, SvNumI64(rec.resLength[i]))
    line = SvCat(line, "],\"resType\":")
    line = SvCat(line, SvQuoteArray(rec.resType))
    line = SvCat(line, ",\"schema\":")
    line = SvCat(line, SvQuote(SvSchemaNamespace))
    line = SvCat(line, SvCat3(",\"tbDen\":", SvNumI32(rec.tbDen), ""))
    line = SvCat(line, SvCat3(",\"tbNum\":", SvNumI32(rec.tbNum), ""))
    line = SvCat(line, SvCat3(",\"timeEnd\":", SvNumI64(rec.timeEnd), ""))
    line = SvCat(line, SvCat3(",\"timeStart\":", SvNumI64(rec.timeStart), ""))
    # x- 扩展键按 canonical 键序排在全部保留键之后（'x' > 't'）。
    if rec.xPhysicsBaseline.len > 0:
        line = SvCat(line, ",\"x-physicsBaseline\":")
        line = SvCat(line, SvQuote(rec.xPhysicsBaseline))
    line = SvCat(line, "}")
    return line

@borrows
fn SvObservationLine(rec: SvObservationRec): str =
    var line: str = "{\"kind\":"
    line = SvCat(line, SvQuote(SvKindObservation))
    line = SvCat(line, SvCat3(",\"method\":", SvQuote(rec.method), ""))
    line = SvCat(line, SvCat3(",\"obsId\":", SvQuote(rec.obsId), ""))
    line = SvCat(line, ",\"schema\":")
    line = SvCat(line, SvQuote(SvSchemaNamespace))
    line = SvCat(line, SvCat3(",\"sensor\":", SvQuote(rec.sensor), ""))
    line = SvCat(line, SvCat3(",\"sourceClass\":", SvQuote(rec.sourceClass), ""))
    line = SvCat(line, SvCat3(",\"srcTrack\":", SvQuote(rec.srcTrack), ""))
    line = SvCat(line, SvCat3(",\"tbDen\":", SvNumI32(rec.tbDen), ""))
    line = SvCat(line, SvCat3(",\"tbNum\":", SvNumI32(rec.tbNum), ""))
    line = SvCat(line, SvCat3(",\"tickEnd\":", SvNumI64(rec.tickEnd), ""))
    line = SvCat(line, SvCat3(",\"tickStart\":", SvNumI64(rec.tickStart), ""))
    line = SvCat(line, "}")
    return line

