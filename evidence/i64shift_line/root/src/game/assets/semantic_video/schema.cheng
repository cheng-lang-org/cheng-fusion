# i32 数组 canonical emission（元素经 SvNumI32 权威规范化）。
@borrows
fn SvI32ArrayLine(values: int32[]): str =
    var out: str = "["
    for i in 0..<values.len:
        if i > 0:
            out = SvCat(out, ",")
        out = SvCat(out, SvNumI32(values[i]))
    out = SvCat(out, "]")
    return out

# 平面级语义记录行。键序 = 全键 UTF-8 字节升序（areaPx < colorB <
# colorDef < colorG < colorR < colorSamples < confBp < confDef < cxM2 <
# cyM2 < frameCount < kind < maxAreaPx < meanAreaM1 < meanDepthM1 <
# method < paramA < paramB < paramC < paramFrames < pathLenM2 < schema <
# sourceClass < tbDen < tbNum < tickEnd < tickStart < tid）。
# param* 全有或全无，仅轨道存在代表帧拟合值时发射。
@borrows
fn SvSemPlaneLine(rec: SvSemPlaneRec): str =
    var line: str = "{\"areaPx\":"
    line = SvCat(line, SvI32ArrayLine(rec.areaPx))
    line = SvCat(line, SvCat3(",\"colorB\":", SvNumI32(rec.colorB), ""))
    line = SvCat(line, SvCat3(",\"colorDef\":", SvQuote(rec.colorDef), ""))
    line = SvCat(line, SvCat3(",\"colorG\":", SvNumI32(rec.colorG), ""))
    line = SvCat(line, SvCat3(",\"colorR\":", SvNumI32(rec.colorR), ""))
    line = SvCat(line, SvCat3(",\"colorSamples\":", SvNumI32(rec.colorSamples), ""))
    line = SvCat(line, SvCat3(",\"confBp\":", SvNumI32(rec.confBp), ""))
    line = SvCat(line, SvCat3(",\"confDef\":", SvQuote(rec.confDef), ""))
    line = SvCat(line, ",\"cxM2\":")
    line = SvCat(line, SvI32ArrayLine(rec.cxM2))
    line = SvCat(line, ",\"cyM2\":")
    line = SvCat(line, SvI32ArrayLine(rec.cyM2))
    line = SvCat(line, SvCat3(",\"frameCount\":", SvNumI32(rec.frameCount), ""))
    line = SvCat(line, ",\"kind\":")
    line = SvCat(line, SvQuote(SvKindPlane))
    line = SvCat(line, SvCat3(",\"maxAreaPx\":", SvNumI32(rec.maxAreaPx), ""))
    line = SvCat(line, SvCat3(",\"meanAreaM1\":", SvNumI32(rec.meanAreaM1), ""))
    line = SvCat(line, SvCat3(",\"meanDepthM1\":", SvNumI32(rec.meanDepthM1), ""))
    line = SvCat(line, SvCat3(",\"method\":", SvQuote(rec.method), ""))
    if rec.paramFrames.len > 0:
        line = SvCat(line, ",\"paramA\":")
        line = SvCat(line, SvI32ArrayLine(rec.paramA))
        line = SvCat(line, ",\"paramB\":")
        line = SvCat(line, SvI32ArrayLine(rec.paramB))
        line = SvCat(line, ",\"paramC\":")
        line = SvCat(line, SvI32ArrayLine(rec.paramC))
        line = SvCat(line, ",\"paramFrames\":")
        line = SvCat(line, SvI32ArrayLine(rec.paramFrames))
    line = SvCat(line, SvCat3(",\"pathLenM2\":", SvNumI32(rec.pathLenM2), ""))
    line = SvCat(line, ",\"schema\":")
    line = SvCat(line, SvQuote(SvSchemaNamespace))
    line = SvCat(line, SvCat3(",\"sourceClass\":", SvQuote(rec.sourceClass), ""))
    line = SvCat(line, SvCat3(",\"tbDen\":", SvNumI32(rec.tbDen), ""))
    line = SvCat(line, SvCat3(",\"tbNum\":", SvNumI32(rec.tbNum), ""))
    line = SvCat(line, SvCat3(",\"tickEnd\":", SvNumI64(rec.tickEnd), ""))
    line = SvCat(line, SvCat3(",\"tickStart\":", SvNumI64(rec.tickStart), ""))
    line = SvCat(line, SvCat3(",\"tid\":", SvNumI32(rec.tid), ""))
    line = SvCat(line, "}")
    return line
