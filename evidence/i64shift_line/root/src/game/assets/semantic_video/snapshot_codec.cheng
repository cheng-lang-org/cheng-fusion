    for i in 0..<cidLen:
        rd = SvSnapRdU8(data, pos)
        pos = rd.at
        if rd.failed:
            failed = true
        layout.ByteBufAppendByte(cidBuf, int32(rd.v) & 255)
    var cidBytes: rawbytes.Bytes = layout.ByteBufToBytes(cidBuf)
    layout.ByteBufFree(cidBuf)
    st.chainCid = rawbytes.BytesToString(cidBytes)
