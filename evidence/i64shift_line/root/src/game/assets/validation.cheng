# CSG 资产能力验证 (A2)。
#
# 合同 (计划 §2.2 + §5): 请求范围可以提前明确选择, 但运行失败后不得自动
# 缩小范围重签成功; 导入不满足请求能力时失败; "warning+成功" 吞能力禁止。
# 验证是纯函数: request x source_map x 逐能力 verified 记录 => 放行/诊断。
import std/strings
import cheng/game/assets/import/request
import cheng/game/assets/import/diagnostic
import cheng/game/assets/source_map

type
    AssetValidationOutcome =
        ok: bool
        diagnostics: diagnostic.AssetDiagnostic[]

fn AssetValidationOutcomeOk(): AssetValidationOutcome =
    var o: AssetValidationOutcome
    o.ok = true
    return o

# 请求能力必须全部落在 source_map 的 caps 记录里且 verified, 否则拒绝。
# sourceDeclared 只证明"源侧声明过", 不构成放行 (用户填写清单不构成完整
# 来源证明); verified 必须带 evidenceRef。
@borrows
fn AssetValidateCapabilities(r: request.AssetImportRequest,
                             m: source_map.AssetSourceMap): AssetValidationOutcome =
    var o: AssetValidationOutcome
    o.ok = true
    for i in 0..<r.requestedCapabilities.len:
        let cap = Fmt"{r.requestedCapabilities[i]}"
        var found: bool
        var verified: bool
        for j in 0..<m.caps.len:
            if m.caps[j].cap == cap:
                found = true
                if m.caps[j].verified:
                    verified = true
                break
        if !found:
            o.ok = false
            add(o.diagnostics, diagnostic.AssetDiagnosticMake(
                diagnostic.AssetDiagnosticStageValidate(),
                Fmt"{r.format}",
                Fmt"capabilities[{i}]",
                diagnostic.AssetDiagnosticContractCapability(),
                Fmt"capability not declared by source map: {cap}",
                Fmt""))
        elif !verified:
            o.ok = false
            add(o.diagnostics, diagnostic.AssetDiagnosticMake(
                diagnostic.AssetDiagnosticStageValidate(),
                Fmt"{r.format}",
                Fmt"capabilities[{i}]",
                diagnostic.AssetDiagnosticContractCapability(),
                Fmt"capability requested but not verified: {cap}",
                Fmt"source-declared only, verification evidence missing"))
    return o

# 格式与请求一致性: mp4/m4a 只可请求 raw_media; glb 不可请求 raw_media。
@borrows
fn AssetValidateFormatCapabilityFit(r: request.AssetImportRequest): AssetValidationOutcome =
    var o: AssetValidationOutcome
    o.ok = true
    if r.format == "mp4" || r.format == "m4a" || r.format == "wav":
        for i in 0..<r.requestedCapabilities.len:
            if r.requestedCapabilities[i] != request.AssetCapabilityRawMedia():
                o.ok = false
                add(o.diagnostics, diagnostic.AssetDiagnosticMake(
                    diagnostic.AssetDiagnosticStageValidate(),
                    Fmt"{r.format}",
                    Fmt"capabilities[{i}]",
                    diagnostic.AssetDiagnosticContractCapability(),
                    Fmt"media container cannot grant non-media capability",
                    Fmt"raw_media only"))
    if r.format == "glb":
        if request.AssetImportRequestHasCapability(r, request.AssetCapabilityRawMedia()):
            o.ok = false
            add(o.diagnostics, diagnostic.AssetDiagnosticMake(
                diagnostic.AssetDiagnosticStageValidate(),
                Fmt"glb",
                Fmt"capabilities",
                diagnostic.AssetDiagnosticContractCapability(),
                Fmt"raw_media is not a GLB capability",
                Fmt"geometry/material/camera/skeleton/keyframe_anim/morph"))
    return o

@borrows
fn AssetValidate(r: request.AssetImportRequest,
                 m: source_map.AssetSourceMap): AssetValidationOutcome =
    let fit = AssetValidateFormatCapabilityFit(r)
    if !fit.ok:
        return fit
    return AssetValidateCapabilities(r, m)
