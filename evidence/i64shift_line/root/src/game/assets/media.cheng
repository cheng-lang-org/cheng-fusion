# CSG 资产媒体解析: WAV (B1)。
#
# 合同 (计划 §3/§6): 原始字节保留 (载荷即冻结输入, 不改写); 真实解析声明
# 支持的轨道/时间/元数据; PCM 子集 (format=1, 16/32bit); 附加块 (LIST/INFO)
# 跳过并计数, 不静默丢弃; 损坏头/越界数据块/非 PCM 拒绝。
# 真值基准: fixtures/media/sample_440hz_2s.wav (ffprobe 独立交叉验证)。
import std/strings
import std/rawbytes
import cheng/game/assets/import/reader

fn AssetMediaWavFourccRiff(): int64 =
    return int64(1179011410)

fn AssetMediaWavFourccWave(): int64 =
    return int64(1163280727)

# 'fmt ' 'data' 'LIST' 的 u32le 值。
fn AssetMediaWavFourccFmt(): int64 =
    return int64(544501094)

fn AssetMediaWavFourccData(): int64 =
    return int64(1635017060)

type
    AssetWavInfo =
        parsed: bool
        audioFormat: int32        # 1=PCM
        channels: int32
        sampleRate: int32
        byteRate: int32
        blockAlign: int32
        bitsPerSample: int32
        dataOffset: int64         # data 载荷绝对偏移
        dataLen: int64
        extraChunks: int32        # 跳过的附加块计数 (LIST/INFO 等)
        durationMs: int64

# 小端 u32 读取; 越界返回 false。
@borrows
fn AssetMediaU32LeAt(data: rawbytes.Bytes, offset: int32, out: var int64): bool =
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return false
    let b0 = rawbytes.BytesGet(data, offset)
    let b1 = rawbytes.BytesGet(data, offset + 1)
    let b2 = rawbytes.BytesGet(data, offset + 2)
    let b3 = rawbytes.BytesGet(data, offset + 3)
    out = int64(b0) + int64(b1) * int64(256) + int64(b2) * int64(65536) +
        int64(b3) * int64(16777216)
    return true

@borrows
fn AssetMediaParseWav(data: rawbytes.Bytes, out: var AssetWavInfo,
                      errOut: var str): bool =
    let size = rawbytes.BytesLen(data)
    var fourcc: int64
    var riffSize: int64
    if !AssetMediaU32LeAt(data, 0, fourcc) || fourcc != AssetMediaWavFourccRiff():
        errOut = "wav: bad RIFF magic"
        return false
    if !AssetMediaU32LeAt(data, 4, riffSize):
        errOut = "wav: truncated riff size"
        return false
    if !AssetMediaU32LeAt(data, 8, fourcc) || fourcc != AssetMediaWavFourccWave():
        errOut = "wav: bad WAVE form type"
        return false

    var off: int32 = 12
    var haveFmt: bool
    var haveData: bool
    while off + 8 <= size:
        var cid: int64
        var csize: int64
        if !AssetMediaU32LeAt(data, off, cid) || !AssetMediaU32LeAt(data, off + 4, csize):
            errOut = "wav: truncated chunk header"
            return false
        let payload: int32 = off + 8
        # 范围证明: payload + csize 不越界 (csize int64 全程, 收窄前判定)。
        if csize < int64(0) || int64(payload) + csize > int64(size):
            errOut = "wav: chunk payload beyond file"
            return false
        if cid == AssetMediaWavFourccFmt():
            if csize < int64(16):
                errOut = "wav: fmt chunk too small"
                return false
            var u16v: int32
            if !reader.AssetReaderU16At(data, payload, u16v):
                errOut = "wav: fmt truncated"
                return false
            out.audioFormat = u16v
            if !reader.AssetReaderU16At(data, payload + 2, u16v):
                errOut = "wav: fmt truncated channels"
                return false
            out.channels = u16v
            var rate: int64
            if !AssetMediaU32LeAt(data, payload + 4, rate):
                errOut = "wav: fmt truncated rate"
                return false
            out.sampleRate = int32(rate)
            var byteRate: int64
            if !AssetMediaU32LeAt(data, payload + 8, byteRate):
                errOut = "wav: fmt truncated byte rate"
                return false
            out.byteRate = int32(byteRate)
            if !reader.AssetReaderU16At(data, payload + 12, u16v):
                errOut = "wav: fmt truncated block align"
                return false
            out.blockAlign = u16v
            if !reader.AssetReaderU16At(data, payload + 14, u16v):
                errOut = "wav: fmt truncated bits"
                return false
            out.bitsPerSample = u16v
            haveFmt = true
        elif cid == AssetMediaWavFourccData():
            out.dataOffset = int64(payload)
            out.dataLen = csize
            haveData = true
        else:
            out.extraChunks = out.extraChunks + 1
        # 块对齐: 奇数长度补 1 pad; off 前进量 int64 证明后收窄。
        let advance: int64 = int64(8) + csize + (csize % int64(2))
        if int64(off) + advance > int64(size):
            off = size
            break
        off = int32(int64(off) + advance)

    if !haveFmt:
        errOut = "wav: missing fmt chunk"
        return false
    if !haveData:
        errOut = "wav: missing data chunk"
        return false
    if out.audioFormat != 1:
        errOut = "wav: non-PCM format unsupported (supported: PCM=1)"
        return false
    if out.sampleRate <= 0 || out.channels <= 0 || out.blockAlign <= 0:
        errOut = "wav: invalid format fields"
        return false
    if out.dataLen <= int64(0):
        errOut = "wav: empty data chunk"
        return false
    let frames: int64 = out.dataLen / int64(out.blockAlign)
    out.durationMs = frames * int64(1000) / int64(out.sampleRate)
    out.parsed = true
    return true
