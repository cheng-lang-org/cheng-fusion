# Climb character asset binding (D1): makes the A2 skeleton
# correspondence table — semantic part role -> physics body slot ->
# render bone index — explicit versioned data for the frozen climb
# character, with a sha256 CID over the canonical row preimage. The
# render bone index is the facts part index (the character renderer is
# driven directly by the role table, so bone == part index by contract).
# Any duplicate/missing role or out-of-range slot yields "" (rejected).
import cheng/game/csg/schema
import cheng/game/csg/materializer
import std/strings as strings
import std/strutils as strutils

const
    ClimbAssetSchema = "cheng.assets.climb_character.v1"
    ClimbSkeletonRoles = 7

@borrows
fn ClimbCharacterCid(facts: schema.CsgWorldFacts,
                     mp: materializer.CsgMaterializerMapping): str =
    var rows: str[]
    setLen(rows, 0)
    var role: int32 = schema.CsgRolePelvis
    while role <= schema.CsgRoleFootR:
        var found: int32 = 0
        var part: int32 = -1
        var i: int32 = 0
        while i < facts.partRole.len:
            if facts.partRole[i] == role:
                found = found + 1
                part = i
            i = i + 1
        if found != 1:
            return ""
        if part >= mp.partSlot.len:
            return ""
        let slot: int32 = mp.partSlot[part]
        if slot < 0:
            return ""
        add(rows, strings.IntToStr(role) + ":" + strings.IntToStr(slot) + ":" + strings.IntToStr(part))
        role = role + 1
    if rows.len != ClimbSkeletonRoles:
        return ""
    let joined = strutils.Join(rows, "|")
    return strings.Sha256(ClimbAssetSchema + "|" + joined + "|rows=" + strings.IntToStr(rows.len))
