# CSG 资产来源映射与能力记录 (A2)。
#
# 合同 (计划 §2.3): 原始输入 CID、源对象身份、来源证据、能力
# (requested/source-declared/verified 分列)、规范化记录分列冻结。
# 显示名称不作身份; 无持久 GUID 的源对象用冻结源快照 CID+精确行键。
# 用户填写清单本身不构成完整来源证明。
import std/strings

# 源对象身份种类:
#   1 = 持久 GUID (绑定 sourceSystem+namespace+guid)
#   2 = 冻结快照 CID+精确对象表行 (无 GUID 时)
#   3 = 交换文件内精确路径键 (GLB node/mesh 索引链)
fn AssetSourceIdentityKindGuid(): int32 =
    return 1

fn AssetSourceIdentityKindSnapshotRow(): int32 =
    return 2

fn AssetSourceIdentityKindExchangePath(): int32 =
    return 3

type
    AssetSourceObjectIdentity =
        kind: int32
        sourceSystem: str         # 如 "blender-5.1" / "unreal-5.x" / "glb"
        guid: str                 # kind=1 时非空
        snapshotCid: str          # kind=2 时非空 (64 hex)
        rowKey: str               # kind=2/3 时非空 (精确行/路径键)
        displayName: str          # 仅展示, 不参与身份 preimage

    AssetCapabilityRecord =
        cap: str
        requested: bool
        sourceDeclared: bool
        verified: bool
        # 来源类别: 1=original 2=derived 3=reconstructed 4=authored
        originClass: int32
        evidenceRef: str          # 验证回执/对拍引用 (verified=true 时非空)

    AssetProvenanceRecord =
        toolName: str             # 源应用/导出器名
        toolVersion: str          # 版本字符串
        toolBuildHash: str        # 可获得的构建哈希 (空=不可得, 记录事实)
        exportOptions: str        # 导出选项 canonical 文本
        declaredCaps: str[]       # source-declared 能力

    AssetSourceMapEntry =
        identity: AssetSourceObjectIdentity
        exchangePath: str         # 交换文件内路径 (如 /nodes/3/meshes/0)
        assetKind: str            # mesh/material/node/camera/skin/animation/media
        targetCid: str            # 指向产物资源 CID (未映射时为空)

fn AssetOriginClassOriginal(): int32 =
    return 1

fn AssetOriginClassDerived(): int32 =
    return 2

fn AssetOriginClassReconstructed(): int32 =
    return 3

fn AssetOriginClassAuthored(): int32 =
    return 4

@borrows
fn AssetSourceObjectIdentityValid(id: AssetSourceObjectIdentity): bool =
    if id.kind < 1 || id.kind > 3:
        return false
    if id.sourceSystem.len <= 0:
        return false
    if id.kind == AssetSourceIdentityKindGuid():
        if id.guid.len <= 0:
            return false
    if id.kind == AssetSourceIdentityKindSnapshotRow():
        if id.snapshotCid.len != 64:
            return false
        if id.rowKey.len <= 0:
            return false
    if id.kind == AssetSourceIdentityKindExchangePath():
        if id.rowKey.len <= 0:
            return false
    return true

# 身份 preimage: 只含身份字段, displayName 明确排除 (显示名称不作身份)。
@borrows
fn AssetSourceObjectIdentityPreimage(id: AssetSourceObjectIdentity): str =
    var parts: str[]
    add(parts, Fmt"asset.srcid.v1|kind=")
    add(parts, strings.IntToStr(id.kind))
    add(parts, Fmt"|system=")
    add(parts, Fmt"{id.sourceSystem}")
    if id.kind == AssetSourceIdentityKindGuid():
        add(parts, Fmt"|guid=")
        add(parts, Fmt"{id.guid}")
    if id.kind == AssetSourceIdentityKindSnapshotRow():
        add(parts, Fmt"|snap=")
        add(parts, Fmt"{id.snapshotCid}")
        add(parts, Fmt"|row=")
        add(parts, Fmt"{id.rowKey}")
    if id.kind == AssetSourceIdentityKindExchangePath():
        add(parts, Fmt"|key=")
        add(parts, Fmt"{id.rowKey}")
    var out: str
    for i in 0..<parts.len:
        out = out + parts[i]
    return out

@borrows
fn AssetCapabilityRecordValid(c: AssetCapabilityRecord): bool =
    if c.cap.len <= 0:
        return false
    if c.verified && c.evidenceRef.len <= 0:
        return false
    if c.originClass < 1 || c.originClass > 4:
        return false
    return true

# 关键合同: requested 能力未 verified 时, 记录整体不得签发该能力 (§2.2)。
@borrows
fn AssetCapabilityRecordGrantable(c: AssetCapabilityRecord): bool =
    if !c.requested:
        return false
    return c.verified

@borrows
fn AssetProvenanceRecordValid(p: AssetProvenanceRecord): bool =
    if p.toolName.len <= 0:
        return false
    if p.toolVersion.len <= 0:
        return false
    return true

@borrows
fn AssetSourceMapEntryValid(e: AssetSourceMapEntry): bool =
    return AssetSourceObjectIdentityValid(e.identity) && e.assetKind.len > 0

# source_map 整体 canonical preimage: 身份/映射/能力/来源按固定顺序拼接;
# 同一冻结输入 + 同一映射表 => 字节相同 preimage => 字节相同 CID。
type
    AssetSourceMap =
        schema: str
        inputCid: str             # 原始输入冻结闭包 CID (64 hex)
        exchangeCid: str          # 交换文件 CID (64 hex)
        provenance: AssetProvenanceRecord
        entries: AssetSourceMapEntry[]
        caps: AssetCapabilityRecord[]

@borrows
fn AssetSourceMapMake(inputCid: str, exchangeCid: str): AssetSourceMap =
    var m: AssetSourceMap
    m.schema = "cheng.asset.source_map.v1"
    m.inputCid = Fmt"{inputCid}"
    m.exchangeCid = Fmt"{exchangeCid}"
    return m

@borrows
fn AssetSourceMapAddEntry(m: var AssetSourceMap, e: AssetSourceMapEntry) =
    # 形参为借用: 托管字段逐个 Fmt 深拷贝后再入 seq (借用共享合同)。
    var out: AssetSourceMapEntry
    out.identity.kind = e.identity.kind
    out.identity.sourceSystem = Fmt"{e.identity.sourceSystem}"
    out.identity.guid = Fmt"{e.identity.guid}"
    out.identity.snapshotCid = Fmt"{e.identity.snapshotCid}"
    out.identity.rowKey = Fmt"{e.identity.rowKey}"
    out.identity.displayName = Fmt"{e.identity.displayName}"
    out.exchangePath = Fmt"{e.exchangePath}"
    out.assetKind = Fmt"{e.assetKind}"
    out.targetCid = Fmt"{e.targetCid}"
    add(m.entries, out)

@borrows
fn AssetSourceMapAddCap(m: var AssetSourceMap, c: AssetCapabilityRecord) =
    # 形参为借用: 托管字段逐个 Fmt 深拷贝后再入 seq。
    var out: AssetCapabilityRecord
    out.cap = Fmt"{c.cap}"
    out.requested = c.requested
    out.sourceDeclared = c.sourceDeclared
    out.verified = c.verified
    out.originClass = c.originClass
    out.evidenceRef = Fmt"{c.evidenceRef}"
    add(m.caps, out)

@borrows
fn AssetSourceMapValid(m: AssetSourceMap): bool =
    if m.schema != "cheng.asset.source_map.v1":
        return false
    if m.inputCid.len != 64 || m.exchangeCid.len != 64:
        return false
    if !AssetProvenanceRecordValid(m.provenance):
        return false
    for i in 0..<m.entries.len:
        if !AssetSourceMapEntryValid(m.entries[i]):
            return false
    for i in 0..<m.caps.len:
        if !AssetCapabilityRecordValid(m.caps[i]):
            return false
    # 身份去重: 同一身份不得出现两行 (跨版本缺精确映射=建新版本, 不合并)
    for i in 0..<m.entries.len:
        for j in 0..<i:
            if AssetSourceObjectIdentityPreimage(m.entries[i].identity) ==
               AssetSourceObjectIdentityPreimage(m.entries[j].identity):
                return false
    return true

@borrows
fn AssetSourceMapPreimage(m: AssetSourceMap): str =
    var parts: str[]
    add(parts, Fmt"{m.schema}|in=")
    add(parts, Fmt"{m.inputCid}")
    add(parts, Fmt"|ex=")
    add(parts, Fmt"{m.exchangeCid}")
    add(parts, Fmt"|tool=")
    add(parts, Fmt"{m.provenance.toolName}")
    add(parts, Fmt"@")
    add(parts, Fmt"{m.provenance.toolVersion}")
    add(parts, Fmt"|build=")
    add(parts, Fmt"{m.provenance.toolBuildHash}")
    add(parts, Fmt"|opts=")
    add(parts, Fmt"{m.provenance.exportOptions}")
    add(parts, Fmt"|entries=")
    add(parts, strings.IntToStr(int32(m.entries.len)))
    for i in 0..<m.entries.len:
        add(parts, Fmt"|[")
        add(parts, AssetSourceObjectIdentityPreimage(m.entries[i].identity))
        add(parts, Fmt"->")
        add(parts, Fmt"{m.entries[i].exchangePath}")
        add(parts, Fmt":")
        add(parts, Fmt"{m.entries[i].assetKind}")
        add(parts, Fmt":")
        add(parts, Fmt"{m.entries[i].targetCid}")
        add(parts, Fmt"]")
    add(parts, Fmt"|caps=")
    for i in 0..<m.caps.len:
        add(parts, Fmt"[")
        add(parts, Fmt"{m.caps[i].cap}")
        add(parts, Fmt":")
        if m.caps[i].requested:
            add(parts, Fmt"r")
        if m.caps[i].sourceDeclared:
            add(parts, Fmt"d")
        if m.caps[i].verified:
            add(parts, Fmt"v")
        add(parts, Fmt":o")
        add(parts, strings.IntToStr(m.caps[i].originClass))
        add(parts, Fmt":")
        add(parts, Fmt"{m.caps[i].evidenceRef}")
        add(parts, Fmt"]")
    var out: str
    for i in 0..<parts.len:
        out = out + parts[i]
    return out

@borrows
fn AssetSourceMapCid(m: AssetSourceMap): str =
    return strings.Sha256(AssetSourceMapPreimage(m))
