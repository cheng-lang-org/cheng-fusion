# CSG 资产观测记录层 (B2): 存量视频的时序真值观测。
#
# 合同 (计划 §5 B2 行 + docs/csg-asset-import-contract.md): 只授予已验证
# 观测能力, 不伪造提取算法; 绑定帧区间、坐标系/时间系和方法; 来源类别
# 分列 (此处 = derived, 全部字段可由容器 stts/stss/mdhd 独立复算,
# 交付验证基准 = ffprobe)。观测对象是后续世界事实的输入, 不含任何
# 未验证的重建假设。
import std/strings
import std/rawbytes
import cheng/game/assets/import/mp4
import cheng/game/assets/import/commit

fn AssetVideoObservationMethod(): str =
    return "mp4-stts-stss-extraction"

fn AssetVideoObservationSchema(): str =
    return "cheng.asset.video.observation.v1"

type
    AssetVideoObservation =
        schema: str
        sourceName: str          # 源文件名 (展示用, 不入身份 preimage)
        sourceCid: str           # 源字节 CID (64 hex)
        trackHandler: int32      # 1=vide
        timescale: int32
        sampleCount: int32
        totalTicks: int64
        durationMs: int64
        keyframeCount: int32
        keyframeTicks: int64[]   # 各关键帧 pts (tick)
        keyframeMs: int64[]      # 毫秒显示值 (tick*1000/timescale)
        gopCount: int32          # GOP 段数 = 关键帧数 (末段延至 mediaDuration)
        frameTicks: int64[]      # 逐帧 pts 真值 (VFR 不均匀, 禁均匀近似)
        originClass: int32       # 2 = derived (mp4.cheng 同族枚举语义)
        method: str

# 从已解析的 vide 轨道构建观测: 关键帧 pts = 该关键帧样本号之前
# 的 stts delta 累计 (样本号 1-based)。timescale=0 / 非单调 / 越界拒绝。
# 只收标量+数组参数 (C 车头跨模块 var 结构体出参不可靠)。
@borrows
fn AssetVideoObserveFromTrack(handler: int32, timescale: int32,
                              sampleCount: int32, mediaDuration: int64,
                              sttsCounts: int64[], sttsDeltas: int64[],
                              stssSamples: int64[],
                              sourceName: str, sourceCid: str): AssetVideoObservation =
    var o: AssetVideoObservation
    o.schema = AssetVideoObservationSchema()
    o.sourceName = Fmt"{sourceName}"
    o.sourceCid = Fmt"{sourceCid}"
    o.trackHandler = handler
    o.timescale = timescale
    o.sampleCount = sampleCount
    o.totalTicks = mediaDuration
    if timescale > 0:
        o.durationMs = mediaDuration * int64(1000) / int64(timescale)
    o.originClass = 2
    o.method = AssetVideoObservationMethod()
    if handler != mp4.AssetMediaHandlerVide():
        return o
    if timescale <= 0 || sampleCount <= 0:
        return o
    # 关键帧样本号 -> pts tick: 逐条推进 stts 表 (C 车头未初始化局部被毒化,
    # 所有计数器显式归零)。
    var entry: int32 = 0
    var sampleStart: int64 = int64(1)   # 当前 stts 条目首样本号 (1-based)
    var tickBase: int64 = int64(0)      # 当前条目之前的 tick 累计
    var filled: int32 = 0
    var kf: int32 = 0
    while kf < stssSamples.len:
        let target = stssSamples[kf]
        if target < sampleStart:
            return o
        var guard: int32 = 0
        while entry < sttsCounts.len:
            if target < sampleStart + sttsCounts[entry]:
                break
            tickBase = tickBase + sttsCounts[entry] * sttsDeltas[entry]
            sampleStart = sampleStart + sttsCounts[entry]
            entry = entry + 1
            guard = guard + 1
        if guard > sttsCounts.len + 1:
            return o
        if entry >= sttsCounts.len:
            return o
        let pts = tickBase + (target - sampleStart) * sttsDeltas[entry]
        add(o.keyframeTicks, pts)
        add(o.keyframeMs, pts * int64(1000) / int64(timescale))
        filled = filled + 1
        kf = kf + 1
    # 逐帧 pts 真值: 展开全部 stts 条目 (VFR 真实帧距, 禁均匀近似)
    var runEntry: int32 = 0
    var runOffset: int32 = 0
    var runTick: int64 = int64(0)
    var fi: int32 = 0
    while fi < o.sampleCount:
        if runEntry >= sttsCounts.len:
            return o
        add(o.frameTicks, runTick)
        runTick = runTick + sttsDeltas[runEntry]
        runOffset = runOffset + 1
        if int64(runOffset) >= sttsCounts[runEntry]:
            runEntry = runEntry + 1
            runOffset = 0
        fi = fi + 1
    o.keyframeCount = filled
    o.gopCount = filled
    return o

@borrows
fn AssetVideoObservationValid(o: AssetVideoObservation): bool =
    if o.schema != AssetVideoObservationSchema():
        return false
    if o.sourceCid.len != 64:
        return false
    if o.timescale <= 0 || o.sampleCount <= 0 || o.totalTicks <= 0:
        return false
    if o.keyframeCount <= 0 || o.keyframeTicks.len != o.keyframeCount:
        return false
    if o.keyframeMs.len != o.keyframeCount:
        return false
    if o.keyframeTicks[0] != int64(0):
        return false
    var i: int32 = 1
    while i < o.keyframeCount:
        if o.keyframeTicks[i] <= o.keyframeTicks[i - 1]:
            return false
        if o.keyframeTicks[i] >= o.totalTicks:
            return false
        i = i + 1
    if o.frameTicks.len != o.sampleCount:
        return false
    var fi: int32 = 1
    while fi < o.frameTicks.len:
        if o.frameTicks[fi] <= o.frameTicks[fi - 1]:
            return false
        fi = fi + 1
    if o.method != AssetVideoObservationMethod():
        return false
    if o.originClass != 2:
        return false
    return true

# canonical preimage: sourceName 明确排除 (展示名不入身份);
# sourceCid + 时序真值 + 方法构成身份。
@borrows
fn AssetVideoObservationPreimage(o: AssetVideoObservation): str =
    var parts: str[]
    add(parts, Fmt"{o.schema}|src=")
    add(parts, Fmt"{o.sourceCid}")
    add(parts, Fmt"|ts=")
    add(parts, strings.IntToStr(o.timescale))
    add(parts, Fmt"|samples=")
    add(parts, strings.IntToStr(o.sampleCount))
    add(parts, Fmt"|ticks=")
    add(parts, strings.Int64ToStr(o.totalTicks))
    add(parts, Fmt"|kf=")
    add(parts, strings.IntToStr(o.keyframeCount))
    var i: int32
    while i < o.keyframeCount:
        add(parts, Fmt"[")
        add(parts, strings.Int64ToStr(o.keyframeTicks[i]))
        add(parts, Fmt"]")
        i = i + 1
    add(parts, Fmt"|frames=")
    add(parts, strings.IntToStr(int32(o.frameTicks.len)))
    var fi2: int32
    while fi2 < o.frameTicks.len:
        add(parts, Fmt"[")
        add(parts, strings.Int64ToStr(o.frameTicks[fi2]))
        add(parts, Fmt"]")
        fi2 = fi2 + 1
    add(parts, Fmt"|origin=derived|method=")
    add(parts, Fmt"{o.method}")
    var out: str = ""
    for i in 0..<parts.len:
        out = out + parts[i]
    return out

@borrows
fn AssetVideoObservationCid(o: AssetVideoObservation): str =
    return strings.Sha256(AssetVideoObservationPreimage(o))

# 观测对象落库: 观察 -> 准入 -> 激活; head 指向观测对象本体。
@borrows
fn AssetVideoObservationCommit(storeDir: str, o: AssetVideoObservation): bool =
    var sess = commit.AssetCommitSessionMake(storeDir)
    sess.state = commit.AssetCommitStateValidated()
    let pre = AssetVideoObservationPreimage(o)
    let cid = strings.Sha256(pre)
    if !commit.AssetCommitAdmitObject(sess, cid, pre):
        return false
    if !commit.AssetCommitMarkAdmitted(sess, cid):
        return false
    return commit.AssetCommitActivate(sess)
