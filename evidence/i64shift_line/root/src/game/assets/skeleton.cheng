# CSG 资产骨架 (D1): SoA 关节层级 + 逆绑定 + 姿态求值。
#
# 合同 (计划 §5 D1 行): 精确 joint/逆绑定/权重; 无按名称重配或静默修权重;
# 关节数配额 256; 父索引必须先于子 (DAG), 环/越界拒绝。
# 求值顺序固定 => 数值确定 (同输入字节一致合同)。
import std/strings
import cheng/game/assets/import/normalize

fn AssetSkeletonMaxJoints(): int32 =
    return 256

type
    AssetSkeleton =
        jointCount: int32
        parents: int32[]          # 根 = -1; 必须 parent < self (先序 DAG)
        names: str[]              # 仅展示, 不参与任何身份/配对
        inverseBinds: normalize.AssetMat4x3[]

    AssetSkeletonPose =
        local: normalize.AssetMat4x3[]   # 每关节本地 (源空间)
        global: normalize.AssetMat4x3[]  # 每关节全局 (源空间, 按先序求值)

@borrows
fn AssetSkeletonValid(s: AssetSkeleton): bool =
    if s.jointCount <= 0 || s.jointCount > AssetSkeletonMaxJoints():
        return false
    if s.parents.len != s.jointCount || s.inverseBinds.len != s.jointCount:
        return false
    for i in 0..<s.jointCount:
        let p = s.parents[i]
        if p >= i:
            return false
        if p >= 0:
            if p < 0 || p >= s.jointCount:
                return false
    return true

# 全局姿态: 先序 DAG 单遍 (parent < self 保证)。求值顺序固定。
@borrows
fn AssetSkeletonComputeGlobals(s: AssetSkeleton, pose: var AssetSkeletonPose): bool =
    if pose.local.len != s.jointCount || pose.global.len != s.jointCount:
        return false
    for i in 0..<s.jointCount:
        let p = s.parents[i]
        if p < 0:
            pose.global[i] = pose.local[i]
        else:
            pose.global[i] = normalize.AssetMatMul(pose.global[p], pose.local[i])
    return true

# 蒙皮矩阵: 全局 * 逆绑定 (蒙皮求值核心式, 固定顺序)。
@borrows
fn AssetSkeletonSkinningMatrix(s: AssetSkeleton,
                               pose: AssetSkeletonPose,
                               joint: int32): normalize.AssetMat4x3 =
    return normalize.AssetMatMul(pose.global[joint], s.inverseBinds[joint])

# 顶点蒙皮 (线性混合蒙皮, 权重和=1 由导入端保证; 归一化在导入端显式做,
# 这里只按给定权重混合, 不静默修正)。
fn AssetSkeletonSkinVertex(mats: normalize.AssetMat4x3[], joints: int32[],
                           weights: float64[], v: normalize.AssetVec3): normalize.AssetVec3 =
    var acc = normalize.AssetVec3Make(0.0, 0.0, 0.0)
    for k in 0..<4:
        let w = weights[k]
        if w > 0.0:
            let t = normalize.AssetMatMulVec(mats[joints[k]], v)
            acc = normalize.AssetVec3Make(acc.x + t.x * w, acc.y + t.y * w,
                acc.z + t.z * w)
    return acc

# 权重归一化 (显式步骤, 归一化系数记录在调用方回执, 不静默)。
fn AssetSkinWeightsNormalize(w: float64[]): bool =
    var sum = 0.0
    for i in 0..<w.len:
        if w[i] < 0.0:
            return false
        sum = sum + w[i]
    if sum <= 0.0:
        return false
    for i in 0..<w.len:
        w[i] = w[i] / sum
    return true
