# CSG 资产导入请求 (A2)。
#
# 合同: 输入请求先声明所需能力和选择范围, 导入不满足时失败;
# 运行失败后不得自动缩小范围重签成功 (§5)。
# 能力是可组合的明确集合, 不靠一个 "已转CSG" 布尔值表达 (计划 §2.2)。
import std/strings

# 能力枚举 (固定 canonical 字符串):
#   raw_media       原字节不变、时间信息正确、实际解码播放
#   geometry        类型与变换正确、真实绘制
#   material        PBR 材质与纹理绑定
#   camera          摄影机参数
#   skeleton        关节/逆绑定/权重
#   keyframe_anim   关键帧在指定时间正确求值
#   morph           形态键
#   physics_source  源工程物理参数对应 (需 E1 覆盖门)
fn AssetCapabilityRawMedia(): str =
    return "raw_media"

fn AssetCapabilityGeometry(): str =
    return "geometry"

fn AssetCapabilityMaterial(): str =
    return "material"

fn AssetCapabilityCamera(): str =
    return "camera"

fn AssetCapabilitySkeleton(): str =
    return "skeleton"

fn AssetCapabilityKeyframeAnim(): str =
    return "keyframe_anim"

fn AssetCapabilityMorph(): str =
    return "morph"

fn AssetCapabilityPhysicsSource(): str =
    return "physics_source"

# 已支持格式 (首期, 计划 §3): wav / mp4 / m4a / glb
@borrows
fn AssetFormatSupported(format: str): bool =
    if format == "wav":
        return true
    if format == "mp4":
        return true
    if format == "m4a":
        return true
    if format == "glb":
        return true
    return false

type
    AssetImportRequest =
        format: str                # wav/mp4/m4a/glb
        requestedCapabilities: str[]
        inputPaths: str[]          # 冻结清单内本地对象 (主输入在前)
        maxInputBytes: int64       # 有界读取配额 (字节)
        maxDecodePixels: int64     # 解码图像像素上限
        selectionScope: str        # 选择范围描述 (空=全部)

@borrows
fn AssetImportRequestValid(r: AssetImportRequest): bool =
    if !AssetFormatSupported(r.format):
        return false
    if r.requestedCapabilities.len <= 0:
        return false
    if r.inputPaths.len <= 0:
        return false
    if r.maxInputBytes <= 0:
        return false
    return true

@borrows
fn AssetImportRequestHasCapability(r: AssetImportRequest, cap: str): bool =
    for i in 0..<r.requestedCapabilities.len:
        if r.requestedCapabilities[i] == cap:
            return true
    return false

@borrows
fn AssetImportRequestAddCapability(r: var AssetImportRequest, cap: str) =
    if !AssetImportRequestHasCapability(r, cap):
        add(r.requestedCapabilities, Fmt"{cap}")

# 请求构建: 全部字段显式, 无默认值顶替 (§2.3 规范化记录规则)。
@borrows
fn AssetImportRequestMake(format: str, inputPaths: str[],
                          maxInputBytes: int64): AssetImportRequest =
    var r: AssetImportRequest
    r.format = Fmt"{format}"
    for i in 0..<inputPaths.len:
        add(r.inputPaths, Fmt"{inputPaths[i]}")
    r.maxInputBytes = maxInputBytes
    r.maxDecodePixels = int64(4096) * int64(4096)
    
    return r

# canonical preimage: 固定顺序, 供请求身份/审计 (同请求同 CID)。
@borrows
fn AssetImportRequestPreimage(r: AssetImportRequest): str =
    var parts: str[]
    add(parts, Fmt"asset.request.v1|format=")
    add(parts, Fmt"{r.format}")
    add(parts, Fmt"|caps=")
    for i in 0..<r.requestedCapabilities.len:
        if i > 0:
            add(parts, Fmt",")
        add(parts, Fmt"{r.requestedCapabilities[i]}")
    add(parts, Fmt"|inputs=")
    for i in 0..<r.inputPaths.len:
        if i > 0:
            add(parts, Fmt",")
        add(parts, Fmt"{r.inputPaths[i]}")
    add(parts, Fmt"|maxBytes=")
    add(parts, strings.Int64ToStr(r.maxInputBytes))
    add(parts, Fmt"|scope=")
    add(parts, Fmt"{r.selectionScope}")
    var out: str
    for i in 0..<parts.len:
        out = out + parts[i]
    return out
