# CSG 资产有界读取 (A3)。
#
# 合同 (计划 §7): 输入读取持有可验证的冻结文件身份; 源文件或依赖在读取
# 期间改变时拒绝本次结果。文件长度、offset/stride 计算用宽整数证明不溢出,
# 收窄到切片原语前每一步都有配额断言 (配额 <= 1GiB => int32 收窄可证安全)。
# 超配额显式拒绝, 不截断; 二进制层用 rawbytes (仓内约定), 解析零拷贝视图。
import std/strings
import std/os
import std/result
import std/rawbytes
import std/crypto/sha256

# 首期冻结配额 (capabilities.json budgets_frozen):
fn AssetReaderQuotaMaxGlb(): int64 =
    return int64(268435456)

fn AssetReaderQuotaMaxMedia(): int64 =
    return int64(1073741824)

fn AssetReaderMaxNodes(): int32 =
    return 100000

fn AssetReaderMaxJoints(): int32 =
    return 256

fn AssetReaderMaxTriangles(): int32 =
    return 1000000

type
    AssetFrozenInput =
        path: str
        sizeBytes: int64
        shaCid: str              # 内容 CID (64 hex), 捕获时计算
        sealed: bool

    AssetReaderBounds =
        maxBytes: int64
        maxNodes: int32
        maxJoints: int32
        maxTriangles: int32

@borrows
fn AssetReaderBoundsFor(format: str): AssetReaderBounds =
    var b: AssetReaderBounds
    if format == "glb":
        b.maxBytes = AssetReaderQuotaMaxGlb()
    else:
        b.maxBytes = AssetReaderQuotaMaxMedia()
    b.maxNodes = AssetReaderMaxNodes()
    b.maxJoints = AssetReaderMaxJoints()
    b.maxTriangles = AssetReaderMaxTriangles()
    return b

# 字节载荷读取: 超配额/读取失败 => sealed=false 且 len=0。
# 配额证明: maxBytes <= 1GiB < 2^31, 长度收窄 int32 前先在 int64 域判定。
@borrows
fn AssetReaderLoadBounded(path: str, bounds: AssetReaderBounds,
                          outData: var rawbytes.Bytes): bool =
    var res = os.ReadFileBytesResult(path)
    if result.IsErr(res):
        return false
    var data = result.Value(res)
    let n64 = int64(rawbytes.BytesLen(data))
    if n64 > bounds.maxBytes:
        rawbytes.BytesFree(data)
        return false
    rawbytes.BytesFree(outData)
    outData = data
    return true

# 冻结输入捕获: 持有内容 CID + 长度; 调用方随后自行持有载荷或重读。
@borrows
fn AssetFrozenInputCapture(path: str, bounds: AssetReaderBounds): AssetFrozenInput =
    var f: AssetFrozenInput
    f.path = Fmt"{path}"
    var res = os.ReadFileBytesResult(path)
    if result.IsErr(res):
        return f
    var data = result.Value(res)
    f.sizeBytes = int64(rawbytes.BytesLen(data))
    if f.sizeBytes > bounds.maxBytes:
        rawbytes.BytesFree(data)
        return f
    var digest = sha256.Sha256Digest(data)
    defer:
        rawbytes.BytesFree(digest)
    f.shaCid = rawbytes.BytesToHex(digest)
    f.sealed = true
    rawbytes.BytesFree(data)
    return f

# 冻结有效性复核: 当前文件身份与捕获一致 (期间被改 => 拒绝本次结果)。
@borrows
fn AssetFrozenInputStillValid(f: AssetFrozenInput): bool =
    if !f.sealed:
        return false
    var res = os.ReadFileBytesResult(f.path)
    if result.IsErr(res):
        return false
    var data = result.Value(res)
    if f.sizeBytes != int64(rawbytes.BytesLen(data)):
        rawbytes.BytesFree(data)
        return false
    var digest = sha256.Sha256Digest(data)
    defer:
        rawbytes.BytesFree(digest)
    let cid = rawbytes.BytesToHex(digest)
    rawbytes.BytesFree(data)
    return cid == f.shaCid

# 有界范围证明: 全 int64 (offset>=0, len>=0, offset+len 不溢出且 <= size);
# end 收窄 int32 前证明 end <= 2^31-1 (配额已保证 size 侧, 此处双保险)。
fn AssetReaderRangeProven(size: int64, offset: int64, length: int64): bool =
    if offset < int64(0):
        return false
    if length < int64(0):
        return false
    if offset > size:
        return false
    let end64 = offset + length
    if end64 < offset:
        return false
    if end64 > size:
        return false
    if end64 > int64(2147483647):
        return false
    return true

# 零拷贝范围视图: 先证明后收窄; 拒绝时返回空视图 (len=0)。
# 视图借用 data, 调用方保证 data 存活期覆盖视图使用期 (仓内 BytesSliceView 约定)。
@borrows
fn AssetReaderViewRange(data: rawbytes.Bytes, offset: int64,
                        length: int64): rawbytes.Bytes =
    var empty = rawbytes.EmptyBytes()
    if !AssetReaderRangeProven(int64(rawbytes.BytesLen(data)), offset, length):
        return empty
    return rawbytes.BytesSliceView(data, int32(offset), int32(length))

# 小端 u16/u32 读取; 越界返回 false。BytesGet 已返回 0..255 无符号值。
@borrows
fn AssetReaderU16At(data: rawbytes.Bytes, offset: int32, out: var int32): bool =
    if offset < 0 || offset + 2 > rawbytes.BytesLen(data):
        return false
    let b0 = rawbytes.BytesGet(data, offset)
    let b1 = rawbytes.BytesGet(data, offset + 1)
    out = b0 + (b1 << 8)
    return true

@borrows
fn AssetReaderU32At(data: rawbytes.Bytes, offset: int32, out: var int64): bool =
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return false
    let b0 = rawbytes.BytesGet(data, offset)
    let b1 = rawbytes.BytesGet(data, offset + 1)
    let b2 = rawbytes.BytesGet(data, offset + 2)
    let b3 = rawbytes.BytesGet(data, offset + 3)
    out = int64(b0) + int64(b1) * int64(256) + int64(b2) * int64(65536) +
        int64(b3) * int64(16777216)
    return true
