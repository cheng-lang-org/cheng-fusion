# CSG 资产导入结构化诊断 (A2)。
#
# 合同 (docs/csg-asset-import-contract.md §5): 导入错误必须返回具体源对象/
# 字段定位、违反的合同、失败阶段; 禁止 warning+成功吞掉所请求能力。
# 诊断是纯值类型, 零外部依赖; stage/contract 用固定枚举字符串保证
# canonical preimage 稳定 (不随诊断顺序变化)。
import std/strings

type
    AssetDiagnostic =
        stageCode: int32          # 失败阶段: 1=request 2=container 3=parse
                                  # 4=validate 5=normalize 6=pack 7=commit
        objectPath: str           # 源对象定位 (glTF node/mesh/accessor 路径或 box 路径)
        fieldPath: str            # 字段定位 (如 accessors[3].bufferView)
        contract: str             # 违反的合同条款 (固定字符串, 见下方常量函数)
        message: str              # 人读细节
        supportedRange: str       # 已支持范围描述 (空=无)

fn AssetDiagnosticStageContainer(): int32 =
    return 2

fn AssetDiagnosticStageParse(): int32 =
    return 3

fn AssetDiagnosticStageValidate(): int32 =
    return 4

fn AssetDiagnosticStageNormalize(): int32 =
    return 5

fn AssetDiagnosticStagePack(): int32 =
    return 6

fn AssetDiagnosticContractRequiredExtension(): str =
    return "extensionsRequired-unknown-rejected"

fn AssetDiagnosticContractBounds(): str =
    return "bounded-reader-quota-exceeded"

fn AssetDiagnosticContractCapability(): str =
    return "requested-capability-not-verified"

fn AssetDiagnosticContractFormat(): str =
    return "format-structure-invalid"

fn AssetDiagnosticMake(stageCode: int32, objectPath: str, fieldPath: str,
                       contract: str, message: str, supportedRange: str): AssetDiagnostic =
    var out: AssetDiagnostic
    out.stageCode = stageCode
    out.objectPath = Fmt"{objectPath}"
    out.fieldPath = Fmt"{fieldPath}"
    out.contract = Fmt"{contract}"
    out.message = Fmt"{message}"
    out.supportedRange = Fmt"{supportedRange}"
    return out

@borrows
fn AssetDiagnosticValid(d: AssetDiagnostic): bool =
    if d.stageCode < 1 || d.stageCode > 7:
        return false
    if d.contract.len <= 0:
        return false
    if d.message.len <= 0:
        return false
    return true

# canonical 单行格式: 固定字段顺序, 供 gate 报告与 preimage 消费。
@borrows
fn AssetDiagnosticLine(d: AssetDiagnostic): str =
    var parts: str[]
    add(parts, Fmt"stage=")
    add(parts, strings.IntToStr(d.stageCode))
    add(parts, Fmt"|object=")
    add(parts, Fmt"{d.objectPath}")
    add(parts, Fmt"|field=")
    add(parts, Fmt"{d.fieldPath}")
    add(parts, Fmt"|contract=")
    add(parts, Fmt"{d.contract}")
    add(parts, Fmt"|message=")
    add(parts, Fmt"{d.message}")
    if d.supportedRange.len > 0:
        add(parts, Fmt"|supported=")
        add(parts, Fmt"{d.supportedRange}")
    var out: str
    for i in 0..<parts.len:
        out = out + parts[i]
    return out
