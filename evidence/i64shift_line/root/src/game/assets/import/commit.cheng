# CSG 资产导入原子提交 (A2)。
#
# 合同 (计划 §6 原子提交行): 在读取/写资源/写CSGC/准入及 head 提交边界
# 退出进程, 重启只可激活完整旧版或完整新版; 损坏/未完整准入的新对象不能
# 激活; 孤立未准入对象不等于成功版本。
# 机制: 内容寻址 no-replace 对象存储 + head 指针仅在完整准入后经原子
# rename 推进; head 只接受指向已准入对象的记录。
import std/strings
import std/os

# 提交状态机: 1=staged 2=validated 3=admitted 4=activated 5=aborted
fn AssetCommitStateStaged(): int32 =
    return 1

fn AssetCommitStateValidated(): int32 =
    return 2

fn AssetCommitStateAdmitted(): int32 =
    return 3

fn AssetCommitStateActivated(): int32 =
    return 4

fn AssetCommitStateAborted(): int32 =
    return 5

type
    AssetCommitSession =
        state: int32
        storeRoot: str            # 资源对象存储根 (必须已存在)
        packageCid: str           # 封签 CID (64 hex), 空=未封签
        objectPaths: str[]        # 已写入对象路径 (准入证据)
        headPath: str             # 活跃版本指针文件

@borrows
fn AssetCommitSessionMake(storeRoot: str): AssetCommitSession =
    var s: AssetCommitSession
    s.state = AssetCommitStateStaged()
    s.storeRoot = Fmt"{storeRoot}"
    s.headPath = Fmt"{storeRoot}/head"
    return s

@borrows
fn AssetCommitSessionValid(s: AssetCommitSession): bool =
    if s.state < 1 || s.state > 5:
        return false
    if s.storeRoot.len <= 0:
        return false
    return true

# no-replace 对象路径: <root>/objects/<cid[0:2]>/<cid>
@borrows
fn AssetCommitObjectPath(s: AssetCommitSession, cid: str): str =
    if cid.len != 64:
        return ""
    let dir = strings.CloneStrRange(cid, 0, 2)
    return Fmt"{s.storeRoot}/objects/{dir}/{cid}"

# 准入单个资源对象: 内容寻址 no-replace。已存在同 CID 视为幂等成功
# (内容寻址下同 CID 必同字节); 写入失败或校验不一致 => 会话进 aborted。
@borrows
fn AssetCommitAdmitObject(s: var AssetCommitSession, cid: str,
                          payload: str): bool =
    if s.state != AssetCommitStateValidated():
        return false
    let path = AssetCommitObjectPath(s, cid)
    if path.len <= 0:
        s.state = AssetCommitStateAborted()
        return false
    if os.FileExists(path):
        let existing = os.ReadFile(path)
        if existing != payload:
            s.state = AssetCommitStateAborted()
            return false
        add(s.objectPaths, Fmt"{path}")
        return true
    # 写临时文件 + rename 落位: 中断只留临时文件, 不会出现半写正式对象。
    # 兼容路径: 部分车头 rename 桥不可用 => 直写正式对象并回读校验
    # (内容寻址 no-replace 语义不变: 已存在同 CID 幂等, 写后校验防半写)。
    let shardDir = Fmt"{s.storeRoot}/objects/{strings.CloneStrRange(cid, 0, 2)}"
    os.MkdirAll(shardDir, 493)
    let tmp = Fmt"{s.storeRoot}/objects/{cid}.tmp"
    os.WriteFile(tmp, payload)
    if os.ReadFile(tmp) != payload:
        s.state = AssetCommitStateAborted()
        return false
    if !os.RenameFile(tmp, path):
        os.WriteFile(path, payload)
        if os.ReadFile(path) != payload:
            s.state = AssetCommitStateAborted()
            return false
    add(s.objectPaths, Fmt"{path}")
    return true

# 全部对象准入后封签落库: 封签事实本身也是一个对象 (含 packageCid)。
@borrows
fn AssetCommitMarkAdmitted(s: var AssetCommitSession, packageCid: str): bool =
    if s.state != AssetCommitStateValidated():
        return false
    if packageCid.len != 64:
        return false
    if s.objectPaths.len <= 0:
        return false
    s.packageCid = Fmt"{packageCid}"
    s.state = AssetCommitStateAdmitted()
    return true

# 激活: head 指针原子推进。head 新内容 = schema|packageCid|objectCount。
# rename 原子替换保证并发读 head 只见完整旧版或完整新版。
@borrows
fn AssetCommitActivate(s: var AssetCommitSession): bool =
    if s.state != AssetCommitStateAdmitted():
        return false
    let record = Fmt"cheng.asset.head.v1|cid={s.packageCid}|objects=" +
        strings.IntToStr(int32(s.objectPaths.len))
    let tmp = Fmt"{s.headPath}.tmp"
    os.WriteFile(tmp, record)
    if os.ReadFile(tmp) != record:
        s.state = AssetCommitStateAborted()
        return false
    if !os.RenameFile(tmp, s.headPath):
        os.WriteFile(s.headPath, record)
        if os.ReadFile(s.headPath) != record:
            s.state = AssetCommitStateAborted()
            return false
    s.state = AssetCommitStateActivated()
    return true

# 重启恢复校验: head 记录指向的对象必须全部存在且准入, 否则激活无效。
# 孤立对象 (无 head 指向) 在这里不算失败, 也不算成功版本——只是垃圾。
@borrows
fn AssetCommitHeadValidOnRestart(storeRoot: str): bool =
    let headPath = Fmt"{storeRoot}/head"
    if !os.FileExists(headPath):
        # 无 head = 尚无激活版本, 合法状态。
        return true
    let record = os.ReadFile(headPath)
    if !strings.HasPrefix(record, "cheng.asset.head.v1|cid="):
        return false
    let cidStart: int32 = 24
    if record.len < cidStart + 64:
        return false
    let cid = strings.CloneStrRange(record, cidStart, 64)
    let dir = Fmt"{storeRoot}/objects/{strings.CloneStrRange(cid, 0, 2)}"
    let objPath = Fmt"{dir}/{cid}"
    return os.FileExists(objPath)

# 显式中止: 任何状态可进 aborted; 已写临时对象留待清理, 不影响 head。
fn AssetCommitAbort(s: var AssetCommitSession) =
    s.state = AssetCommitStateAborted()
