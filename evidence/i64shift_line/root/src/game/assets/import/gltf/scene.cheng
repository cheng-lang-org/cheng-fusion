# CSG 资产 GLTF 导入: mesh/材质/摄影机/节点场景层 (C1/C2 基础)。
#
# 合同: 受支持子集 = TRIANGLES(4) 单 primitive、PBR 因子材质、透视摄影机、
# TRS 或 matrix 节点、层级/实例; 灯光/扩展材质/正交摄影机/多 primitive
# 明确拒绝 (不静默清零)。节点环/越界/深度超限拒绝。层级在源空间 (Y-up)
# 组装, 世界变换经 Z-up 共轭一次完成 (normalize.cheng)。
import std/strings
import std/json
import cheng/game/assets/import/normalize

fn AssetGltfSceneMaxNodes(): int32 =
    return 100000

fn AssetGltfSceneMaxDepth(): int32 =
    return 64

type
    AssetGltfMeshInfo =
        name: str
        positionAccessor: int32
        normalAccessor: int32     # -1=无
        texcoordAccessor: int32   # -1=无
        indicesAccessor: int32    # -1=无 (非索引不支持, 拒绝)
        materialIndex: int32      # -1=无材质
        primitiveCount: int32

    AssetGltfMaterialInfo =
        name: str
        baseColorR: float64
        baseColorG: float64
        baseColorB: float64
        baseColorA: float64
        metallic: float64
        roughness: float64
        doubleSided: bool
        hasBaseColorTexture: bool

    AssetGltfCameraInfo =
        name: str
        yfov: float64
        aspectRatio: float64
        znear: float64
        zfar: float64

    AssetGltfNodeInfo =
        name: str
        meshIndex: int32          # -1=无
        cameraIndex: int32        # -1=无
        skinIndex: int32          # -1=无
        hasTrs: bool
        trs: normalize.AssetNodeTrs
        hasMatrix: bool
        srcMatrix: normalize.AssetMat4x3
        children: int32[]

    AssetGltfScene =
        meshes: AssetGltfMeshInfo[]
        materials: AssetGltfMaterialInfo[]
        cameras: AssetGltfCameraInfo[]
        nodes: AssetGltfNodeInfo[]
        rootNodes: int32[]

@borrows
fn AssetGltfJsonIntOrDefault(node: json.JsonNode, key: str,
                             fallback: int32): int32 =
    let v = json.jsonGetField(node, key)
    if v.kind == json.JInt:
        return int32(v.i)
    return fallback

@borrows
fn AssetGltfJsonFloatOrDefault(node: json.JsonNode, key: str,
                               fallback: float64): float64 =
    let v = json.jsonGetField(node, key)
    if v.kind == json.JFloat:
        return v.f
    if v.kind == json.JInt:
        return float64(v.i)
    return fallback

@borrows
fn AssetGltfParseMeshes(root: json.JsonNode, out: var AssetGltfScene,
                        errOut: var str): bool =
    let meshes = json.jsonGetField(root, "meshes")
    if meshes.kind != json.JArray:
        return true
    if meshes.a.len > AssetGltfSceneMaxNodes():
        errOut = "glb: mesh count over bound"
        return false
    for i in 0..<meshes.a.len:
        let m = meshes.a[i]
        if m.kind != json.JObject:
            errOut = "glb: mesh not an object"
            return false
        let prims = json.jsonGetField(m, "primitives")
        if prims.kind != json.JArray || prims.a.len != 1:
            errOut = "glb: mesh must have exactly one primitive (multi-primitive unsupported)"
            return false
        let p = prims.a[0]
        if p.kind != json.JObject:
            errOut = "glb: primitive not an object"
            return false
        let mode = AssetGltfJsonIntOrDefault(p, "mode", 4)
        if mode != 4:
            errOut = "glb: only TRIANGLES mode=4 supported"
            return false
        var info: AssetGltfMeshInfo
        info.normalAccessor = -1
        info.texcoordAccessor = -1
        info.indicesAccessor = -1
        info.materialIndex = -1
        info.primitiveCount = 1
        let nameNode = json.jsonGetField(m, "name")
        if nameNode.kind == json.JString:
            info.name = Fmt"{nameNode.s}"
        let attrs = json.jsonGetField(p, "attributes")
        if attrs.kind == json.JObject:
            let pos = json.jsonGetField(attrs, "POSITION")
            if pos.kind == json.JInt:
                info.positionAccessor = int32(pos.i)
            else:
                errOut = "glb: primitive missing POSITION"
                return false
            let nrm = json.jsonGetField(attrs, "NORMAL")
            if nrm.kind == json.JInt:
                info.normalAccessor = int32(nrm.i)
            let uv = json.jsonGetField(attrs, "TEXCOORD_0")
            if uv.kind == json.JInt:
                info.texcoordAccessor = int32(uv.i)
            let joints = json.jsonGetField(attrs, "JOINTS_0")
            let weights = json.jsonGetField(attrs, "WEIGHTS_0")
            if (joints.kind == json.JInt) != (weights.kind == json.JInt):
                errOut = "glb: JOINTS_0/WEIGHTS_0 must be present together"
                return false
        else:
            errOut = "glb: primitive missing attributes"
            return false
        let idxNode = json.jsonGetField(p, "indices")
        if idxNode.kind == json.JInt:
            info.indicesAccessor = int32(idxNode.i)
        else:
            errOut = "glb: non-indexed primitives unsupported"
            return false
        let matNode = json.jsonGetField(p, "material")
        if matNode.kind == json.JInt:
            info.materialIndex = int32(matNode.i)
        add(out.meshes, info)
    return true

@borrows
fn AssetGltfParseMaterials(root: json.JsonNode, out: var AssetGltfScene,
                           errOut: var str): bool =
    let mats = json.jsonGetField(root, "materials")
    if mats.kind != json.JArray:
        return true
    for i in 0..<mats.a.len:
        let m = mats.a[i]
        if m.kind != json.JObject:
            errOut = "glb: material not an object"
            return false
        var info: AssetGltfMaterialInfo
        info.baseColorR = 1.0
        info.baseColorG = 1.0
        info.baseColorB = 1.0
        info.baseColorA = 1.0
        info.metallic = 1.0
        info.roughness = 1.0
        let nameNode = json.jsonGetField(m, "name")
        if nameNode.kind == json.JString:
            info.name = Fmt"{nameNode.s}"
        let pbr = json.jsonGetField(m, "pbrMetallicRoughness")
        if pbr.kind == json.JObject:
            let bc = json.jsonGetField(pbr, "baseColorFactor")
            if bc.kind == json.JArray && bc.a.len == 4:
                # baseColorFactor 数组逐分量读取。
                if bc.a[0].kind == json.JFloat:
                    info.baseColorR = bc.a[0].f
                elif bc.a[0].kind == json.JInt:
                    info.baseColorR = float64(bc.a[0].i)
                if bc.a[1].kind == json.JFloat:
                    info.baseColorG = bc.a[1].f
                elif bc.a[1].kind == json.JInt:
                    info.baseColorG = float64(bc.a[1].i)
                if bc.a[2].kind == json.JFloat:
                    info.baseColorB = bc.a[2].f
                elif bc.a[2].kind == json.JInt:
                    info.baseColorB = float64(bc.a[2].i)
                if bc.a[3].kind == json.JFloat:
                    info.baseColorA = bc.a[3].f
                elif bc.a[3].kind == json.JInt:
                    info.baseColorA = float64(bc.a[3].i)
            let metal = json.jsonGetField(pbr, "metallicFactor")
            if metal.kind == json.JFloat:
                info.metallic = metal.f
            elif metal.kind == json.JInt:
                info.metallic = float64(metal.i)
            let rough = json.jsonGetField(pbr, "roughnessFactor")
            if rough.kind == json.JFloat:
                info.roughness = rough.f
            elif rough.kind == json.JInt:
                info.roughness = float64(rough.i)
            let bct = json.jsonGetField(pbr, "baseColorTexture")
            if bct.kind == json.JObject:
                info.hasBaseColorTexture = true
        let dsNode = json.jsonGetField(m, "doubleSided")
        info.doubleSided = dsNode.kind == json.JBool && dsNode.b
        let ext = json.jsonGetField(m, "extensions")
        if ext.kind == json.JObject && ext.okeys.len > 0:
            # KHR 材质扩展首期不支持: 显式拒绝, 不静默取默认。
            errOut = "glb: material extensions unsupported (KHR material extensions rejected)"
            return false
        add(out.materials, info)
    return true

@borrows
fn AssetGltfParseCameras(root: json.JsonNode, out: var AssetGltfScene,
                         errOut: var str): bool =
    let cams = json.jsonGetField(root, "cameras")
    if cams.kind != json.JArray:
        return true
    for i in 0..<cams.a.len:
        let c = cams.a[i]
        if c.kind != json.JObject:
            errOut = "glb: camera not an object"
            return false
        let typeNode = json.jsonGetField(c, "type")
        if typeNode.kind != json.JString || typeNode.s != "perspective":
            errOut = "glb: only perspective cameras supported"
            return false
        var info: AssetGltfCameraInfo
        let nameNode = json.jsonGetField(c, "name")
        if nameNode.kind == json.JString:
            info.name = Fmt"{nameNode.s}"
        let persp = json.jsonGetField(c, "perspective")
        if persp.kind != json.JObject:
            errOut = "glb: perspective camera missing perspective object"
            return false
        info.yfov = AssetGltfJsonFloatOrDefault(persp, "yfov", 0.0)
        info.aspectRatio = AssetGltfJsonFloatOrDefault(persp, "aspectRatio", 0.0)
        info.znear = AssetGltfJsonFloatOrDefault(persp, "znear", 0.0)
        info.zfar = AssetGltfJsonFloatOrDefault(persp, "zfar", 0.0)
        if info.yfov <= 0.0 || info.znear <= 0.0 || info.zfar <= info.znear:
            errOut = "glb: camera frustum parameters invalid"
            return false
        add(out.cameras, info)
    return true

# 节点解析 (含 TRS 与 matrix 双形态); 环检测在装配层做 DFS。
@borrows
fn AssetGltfParseNodes(root: json.JsonNode, out: var AssetGltfScene,
                       errOut: var str): bool =
    let nodes = json.jsonGetField(root, "nodes")
    if nodes.kind != json.JArray:
        errOut = "glb: missing nodes"
        return false
    if nodes.a.len <= 0 || nodes.a.len > AssetGltfSceneMaxNodes():
        errOut = "glb: node count invalid"
        return false
    for i in 0..<nodes.a.len:
        let n = nodes.a[i]
        if n.kind != json.JObject:
            errOut = "glb: node not an object"
            return false
        var info: AssetGltfNodeInfo
        info.meshIndex = -1
        info.cameraIndex = -1
        info.skinIndex = -1
        let nameNode = json.jsonGetField(n, "name")
        if nameNode.kind == json.JString:
            info.name = Fmt"{nameNode.s}"
        let meshNode = json.jsonGetField(n, "mesh")
        if meshNode.kind == json.JInt:
            info.meshIndex = int32(meshNode.i)
        let camNode = json.jsonGetField(n, "camera")
        if camNode.kind == json.JInt:
            info.cameraIndex = int32(camNode.i)
        let skinNode = json.jsonGetField(n, "skin")
        if skinNode.kind == json.JInt:
            info.skinIndex = int32(skinNode.i)
        let matrixNode = json.jsonGetField(n, "matrix")
        if matrixNode.kind == json.JArray && matrixNode.a.len == 16:
            # glTF matrix 列主序。行主序装入: m[c*4+r]。
            var vals: float64[]
            for k in 0..<16:
                if matrixNode.a[k].kind == json.JFloat:
                    add(vals, matrixNode.a[k].f)
                elif matrixNode.a[k].kind == json.JInt:
                    add(vals, float64(matrixNode.a[k].i))
                else:
                    errOut = "glb: node matrix non-numeric"
                    return false
            var m: normalize.AssetMat4x3
            m.m00 = vals[0]
            m.m10 = vals[1]
            m.m20 = vals[2]
            m.m01 = vals[4]
            m.m11 = vals[5]
            m.m21 = vals[6]
            m.m02 = vals[8]
            m.m12 = vals[9]
            m.m22 = vals[10]
            m.tx = vals[12]
            m.ty = vals[13]
            m.tz = vals[14]
            info.srcMatrix = m
            info.hasMatrix = true
        else:
            var trs: normalize.AssetNodeTrs
            let tNode = json.jsonGetField(n, "translation")
            if tNode.kind == json.JArray && tNode.a.len == 3:
                if tNode.a[0].kind == json.JFloat:
                    trs.t.x = tNode.a[0].f
                elif tNode.a[0].kind == json.JInt:
                    trs.t.x = float64(tNode.a[0].i)
                if tNode.a[1].kind == json.JFloat:
                    trs.t.y = tNode.a[1].f
                elif tNode.a[1].kind == json.JInt:
                    trs.t.y = float64(tNode.a[1].i)
                if tNode.a[2].kind == json.JFloat:
                    trs.t.z = tNode.a[2].f
                elif tNode.a[2].kind == json.JInt:
                    trs.t.z = float64(tNode.a[2].i)
            let rNode = json.jsonGetField(n, "rotation")
            if rNode.kind == json.JArray && rNode.a.len == 4:
                for k in 0..<4:
                    var v = 0.0
                    if rNode.a[k].kind == json.JFloat:
                        v = rNode.a[k].f
                    elif rNode.a[k].kind == json.JInt:
                        v = float64(rNode.a[k].i)
                    if k == 0:
                        trs.rx = v
                    if k == 1:
                        trs.ry = v
                    if k == 2:
                        trs.rz = v
                    if k == 3:
                        trs.rw = v
            else:
                trs.rw = 1.0
            let sNode = json.jsonGetField(n, "scale")
            if sNode.kind == json.JArray && sNode.a.len == 3:
                if sNode.a[0].kind == json.JFloat:
                    trs.sx = sNode.a[0].f
                elif sNode.a[0].kind == json.JInt:
                    trs.sx = float64(sNode.a[0].i)
                if sNode.a[1].kind == json.JFloat:
                    trs.sy = sNode.a[1].f
                elif sNode.a[1].kind == json.JInt:
                    trs.sy = float64(sNode.a[1].i)
                if sNode.a[2].kind == json.JFloat:
                    trs.sz = sNode.a[2].f
                elif sNode.a[2].kind == json.JInt:
                    trs.sz = float64(sNode.a[2].i)
            else:
                trs.sx = 1.0
                trs.sy = 1.0
                trs.sz = 1.0
            info.trs = trs
            info.hasTrs = true
        let childrenNode = json.jsonGetField(n, "children")
        if childrenNode.kind == json.JArray:
            for k in 0..<childrenNode.a.len:
                if childrenNode.a[k].kind != json.JInt:
                    errOut = "glb: node children non-integer"
                    return false
                let ci = int32(childrenNode.a[k].i)
                if ci < 0 || ci >= nodes.a.len:
                    errOut = "glb: node child index out of range"
                    return false
                add(info.children, ci)
        add(out.nodes, info)
    return true

# 场景装配: 默认场景根节点 + DFS 环检测 (递归, 三色标记)。
@borrows
fn AssetGltfAssembleScene(root: json.JsonNode, out: var AssetGltfScene,
                          errOut: var str): bool =
    let scenes = json.jsonGetField(root, "scenes")
    if scenes.kind != json.JArray || scenes.a.len == 0:
        errOut = "glb: missing scenes"
        return false
    let sceneIndex = AssetGltfJsonIntOrDefault(root, "scene", 0)
    if sceneIndex < 0 || sceneIndex >= scenes.a.len:
        errOut = "glb: scene index out of range"
        return false
    let scene = scenes.a[sceneIndex]
    let sceneRoots = json.jsonGetField(scene, "nodes")
    if sceneRoots.kind != json.JArray:
        errOut = "glb: scene missing nodes"
        return false
    for i in 0..<sceneRoots.a.len:
        if sceneRoots.a[i].kind != json.JInt:
            errOut = "glb: scene root non-integer"
            return false
        let ri = int32(sceneRoots.a[i].i)
        if ri < 0 || ri >= out.nodes.len:
            errOut = "glb: scene root index out of range"
            return false
        add(out.rootNodes, ri)
    # 三色标记: 0=未访问 1=在栈 2=完成; 遇 1 = 环, 拒绝。
    var state: int32[]
    for i in 0..<out.nodes.len:
        add(state, 0)
    for r in 0..<out.rootNodes.len:
        if !AssetGltfDfsCycleCheck(out.nodes, state, out.rootNodes[r], 0, errOut):
            return false
    return true

# 递归 DFS: 深度超限/环/越界拒绝。
@borrows
fn AssetGltfDfsCycleCheck(nodes: AssetGltfNodeInfo[], state: var int32[],
                          cur: int32, depth: int32, errOut: var str): bool =
    if depth > AssetGltfSceneMaxDepth():
        errOut = "glb: node depth over bound"
        return false
    if state[cur] == 1:
        errOut = "glb: node graph cycle detected"
        return false
    if state[cur] == 2:
        return true
    state[cur] = 1
    for i in 0..<nodes[cur].children.len:
        let child = nodes[cur].children[i]
        if child < 0 || child >= nodes.len:
            errOut = "glb: node child index out of range"
            return false
        if !AssetGltfDfsCycleCheck(nodes, state, child, depth + 1, errOut):
            return false
    state[cur] = 2
    return true

# 世界变换: 节点本地矩阵 (源空间) -> 世界 (Z-up) 共轭 (一次转换合同)。
@borrows
fn AssetGltfNodeLocalMatrix(n: AssetGltfNodeInfo): normalize.AssetMat4x3 =
    if n.hasMatrix:
        return n.srcMatrix
    return normalize.AssetMatFromTrs(n.trs)
