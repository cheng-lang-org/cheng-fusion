# CSG 资产 GLB 导入: 容器层 (C1)。
#
# 合同 (计划 §3 + docs/csg-asset-import-contract.md §3): glTF 2.0 受支持
# 子集; GLB 容器 (magic/version/length/JSON chunk/BIN chunk) 严格校验;
# 越界/截断/坏魔数/未知必需结构拒绝。JSON 语义解析复用 std/json。
import std/strings
import std/json
import std/rawbytes
import cheng/game/assets/import/reader

fn AssetGlbMagic(): int64 =
    return int64(1179937895)

fn AssetGlbChunkJson(): int64 =
    return int64(1313821514)

fn AssetGlbChunkBin(): int64 =
    return int64(5130562)

type
    AssetGlbContainer =
        parsed: bool
        version: int32
        jsonText: str             # JSON chunk 文本 (owned)
        binOffset: int64          # BIN chunk 载荷偏移; -1=无 BIN
        binLength: int64

# GLB 容器解析: 头 12 字节 + chunk 序列; JSON chunk 必需; BIN 至多一个
# 且必须在 JSON 之后; 长度/对齐严格。
@borrows
fn AssetGlbParse(data: rawbytes.Bytes, out: var AssetGlbContainer,
                 errOut: var str): bool =
    let size = rawbytes.BytesLen(data)
    var magic: int64
    var version: int64
    var totalLen: int64
    if size < 12:
        errOut = "glb: file too small"
        return false
    if !reader.AssetReaderU32At(data, 0, magic) || magic != AssetGlbMagic():
        errOut = "glb: bad magic (not glTF)"
        return false
    if !reader.AssetReaderU32At(data, 4, version):
        errOut = "glb: truncated version"
        return false
    if version != int64(2):
        errOut = "glb: unsupported container version (supported: 2)"
        return false
    if !reader.AssetReaderU32At(data, 8, totalLen):
        errOut = "glb: truncated total length"
        return false
    if totalLen > int64(size):
        errOut = "glb: declared length beyond file"
        return false
    if totalLen < int64(20):
        errOut = "glb: declared length too small"
        return false

    var jsonLen: int64
    var jsonType: int64
    if !reader.AssetReaderU32At(data, 12, jsonLen) ||
       !reader.AssetReaderU32At(data, 16, jsonType):
        errOut = "glb: truncated chunk 0 header"
        return false
    if jsonType != AssetGlbChunkJson():
        errOut = "glb: first chunk is not JSON"
        return false
    if jsonLen <= int64(0) || int64(20) + jsonLen > totalLen:
        errOut = "glb: JSON chunk length invalid"
        return false
    if jsonLen > int64(2147483647):
        errOut = "glb: JSON chunk too large"
        return false
    let jsonView = reader.AssetReaderViewRange(data, int64(20), jsonLen)
    if rawbytes.BytesLen(jsonView) != int32(jsonLen):
        errOut = "glb: JSON chunk view failed"
        return false
    let text = rawbytes.BytesToString(jsonView)
    out.jsonText = Fmt"{text}"

    var off: int32 = int32(int64(20) + jsonLen)
    # chunk 对齐: JSON chunk 长度按规范 4 字节对齐 (生成器 pad 空格)。
    if off % 4 != 0:
        errOut = "glb: JSON chunk not 4-byte aligned"
        return false
    if off + 8 <= int32(totalLen):
        var binLen: int64
        var binType: int64
        if !reader.AssetReaderU32At(data, off, binLen) ||
           !reader.AssetReaderU32At(data, off + 4, binType):
            errOut = "glb: truncated chunk 1 header"
            return false
        if binType == AssetGlbChunkBin():
            if binLen <= int64(0) ||
               int64(off + 8) + binLen > totalLen:
                errOut = "glb: BIN chunk length invalid"
                return false
            out.binOffset = int64(off + 8)
            out.binLength = binLen
        else:
            errOut = "glb: unknown second chunk type (only BIN supported)"
            return false
    out.version = int32(version)
    out.parsed = true
    return true

# JSON 语义层: 解析失败拒绝 (含 trailing content)。
@borrows
fn AssetGltfParseJson(glb: AssetGlbContainer, errOut: var str): json.JsonNode =
    var res = json.ParseJsonSafe(glb.jsonText)
    if !res.success:
        errOut = "glb: JSON parse failed: " + Fmt"{res.message}"
        return json.jsonNil()
    return res.value

# extensionsRequired 未知必拒 (合同 §3)。
@borrows
fn AssetGltfCheckRequiredExtensions(root: json.JsonNode,
                                    errOut: var str): bool =
    let req = json.jsonGetField(root, "extensionsRequired")
    if req.kind == json.JArray:
        if req.a.len > 0:
            errOut = "glb: extensionsRequired present but no extension is in the supported set"
            return false
    return true

@borrows
fn AssetGltfAssetVersionOk(root: json.JsonNode, errOut: var str): bool =
    let asset = json.jsonGetField(root, "asset")
    if asset.kind != json.JObject:
        errOut = "glb: missing asset object"
        return false
    let ver = json.jsonGetField(asset, "version")
    if ver.kind != json.JString || ver.s != "2.0":
        errOut = "glb: unsupported glTF asset version (supported: 2.0)"
        return false
    return true
