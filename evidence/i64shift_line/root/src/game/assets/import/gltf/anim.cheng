# CSG 资产 GLTF 导入: animation (D1)。
#
# 合同: LINEAR/STEP 支持, CUBICSPLINE 及未知插值显式拒绝 (§3);
# 采样器输入输出经 accessor 精确读取; 通道目标为节点索引+路径,
# 禁止名称匹配; morph weights 通道求值为标量数组。
import std/strings as strings
import std/json
import std/rawbytes
import cheng/game/assets/import/reader
import cheng/game/assets/animation
import cheng/game/assets/import/gltf/accessor

# 单采样器读取: input(SCALAR float) + output(VEC3/VEC4/SCALAR float)。
@borrows
fn AssetGltfParseSampler(root: json.JsonNode, data: rawbytes.Bytes,
                         binLen: int64, s: json.JsonNode,
                         out: var animation.AssetAnimSampler,
                         errOut: var str): bool =
    if s.kind != json.JObject:
        errOut = "anim: sampler not an object"
        return false
    let interpNode = json.jsonGetField(s, "interpolation")
    if interpNode.kind == json.JString:
        if interpNode.s == "LINEAR":
            out.interp = animation.AssetAnimInterpLinear()
        elif interpNode.s == "STEP":
            out.interp = animation.AssetAnimInterpStep()
        else:
            errOut = "anim: interpolation unsupported (supported: LINEAR/STEP)"
            return false
    else:
        out.interp = animation.AssetAnimInterpLinear()
    let inNode = json.jsonGetField(s, "input")
    if inNode.kind != json.JInt:
        errOut = "anim: sampler missing input accessor"
        return false
    var times = accessor.AssetGltfReadF64(root, data, binLen, int32(inNode.i),
                                          errOut)
    let outNode = json.jsonGetField(s, "output")
    if outNode.kind != json.JInt:
        errOut = "anim: sampler missing output accessor"
        return false
    var refInfo: accessor.AssetGltfAccessorRef
    if !accessor.AssetGltfResolveAccessor(root, binLen, int32(outNode.i),
                                          refInfo, errOut):
        return false
    var vals = accessor.AssetGltfReadF64(root, data, binLen, int32(outNode.i),
                                         errOut)
    let comps = accessor.AssetGltfTypeComponentCount(refInfo.typeStr)
    if comps != 1 && comps != 3 && comps != 4:
        errOut = "anim: output type unsupported (SCALAR/VEC3/VEC4)"
        return false
    if times.len * comps != vals.len:
        errOut = "anim: keyframe count mismatch"
        return false
    out.times = times
    out.values = vals
    out.components = comps
    return animation.AssetAnimSamplerValid(out)

@borrows
fn AssetGltfAnimPathCode(path: str): int32 =
    if path == "translation":
        return animation.AssetAnimPathTranslation()
    if path == "rotation":
        return animation.AssetAnimPathRotation()
    if path == "scale":
        return animation.AssetAnimPathScale()
    if path == "weights":
        return 3
    return -1

# 解析 animations[animIndex]。
@borrows
fn AssetGltfParseAnimation(root: json.JsonNode, data: rawbytes.Bytes,
                           binLen: int64, animIndex: int32,
                           out: var animation.AssetAnimation,
                           errOut: var str): bool =
    let anims = json.jsonGetField(root, "animations")
    if anims.kind != json.JArray || animIndex < 0 ||
       animIndex >= anims.a.len:
        errOut = "anim: animation index out of range"
        return false
    let a = anims.a[animIndex]
    if a.kind != json.JObject:
        errOut = "anim: animation not an object"
        return false
    let nameNode = json.jsonGetField(a, "name")
    if nameNode.kind == json.JString:
        out.name = Fmt"{nameNode.s}"
    let samplers = json.jsonGetField(a, "samplers")
    if samplers.kind != json.JArray || samplers.a.len <= 0 ||
       samplers.a.len > 4096:
        errOut = "anim: sampler count invalid"
        return false
    for i in 0..<samplers.a.len:
        var smp: animation.AssetAnimSampler
        if !AssetGltfParseSampler(root, data, binLen, samplers.a[i], smp,
                                  errOut):
            return false
        add(out.samplers, smp)
    let channels = json.jsonGetField(a, "channels")
    if channels.kind != json.JArray:
        errOut = "anim: missing channels"
        return false
    for i in 0..<channels.a.len:
        let c = channels.a[i]
        if c.kind != json.JObject:
            errOut = "anim: channel not an object"
            return false
        var ch: animation.AssetAnimChannel
        ch.targetNode = -1
        let sNode = json.jsonGetField(c, "sampler")
        if sNode.kind != json.JInt || int32(sNode.i) < 0 ||
           int32(sNode.i) >= out.samplers.len:
            errOut = "anim: channel sampler index invalid"
            return false
        ch.samplerIndex = int32(sNode.i)
        let target = json.jsonGetField(c, "target")
        if target.kind != json.JObject:
            errOut = "anim: channel missing target"
            return false
        let nodeNode = json.jsonGetField(target, "node")
        if nodeNode.kind == json.JInt:
            ch.targetNode = int32(nodeNode.i)
        let pathNode = json.jsonGetField(target, "path")
        if pathNode.kind != json.JString:
            errOut = "anim: channel missing path"
            return false
        ch.targetPath = AssetGltfAnimPathCode(Fmt"{pathNode.s}")
        if ch.targetPath < 0:
            errOut = "anim: channel path unsupported"
            return false
        add(out.channels, ch)
    return true
