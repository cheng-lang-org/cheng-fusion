# CSG 资产 GLTF 导入: accessor 解码 (C1)。
#
# 合同 (计划 §5 C1 行): offset/stride/component/matrix 填充、normalized、
# 索引与扩展准入。支持: componentType 5121(ubyte)/5123(ushort)/5125(uint32)/
# 5126(float32); 类型 SCALAR/VEC2/VEC3/VEC4/MAT4; bufferView byteStride 或
# 紧凑排列; normalized 归一化。越界/NaN/环拒绝; 数量配额有界。
# 语义: mesh.attributes 只支持 POSITION/NORMAL/TEXCOORD_0/JOINTS_0/WEIGHTS_0;
# primitives mode 仅 TRIANGLES(4); KHR 材质扩展拒绝。
import std/strings
import std/json
import std/rawbytes
import cheng/game/assets/import/reader
import cheng/game/assets/import/gltf/glb

fn AssetGltfComponentByteSize(componentType: int32): int32 =
    if componentType == 5120:
        return 1
    if componentType == 5121:
        return 1
    if componentType == 5122:
        return 2
    if componentType == 5123:
        return 2
    if componentType == 5125:
        return 4
    if componentType == 5126:
        return 4
    return 0

@borrows
fn AssetGltfTypeComponentCount(typeStr: str): int32 =
    if typeStr == "SCALAR":
        return 1
    if typeStr == "VEC2":
        return 2
    if typeStr == "VEC3":
        return 3
    if typeStr == "VEC4":
        return 4
    if typeStr == "MAT4":
        return 16
    return 0

type
    AssetGltfAccessorRef =
        accessorIndex: int32
        bufferViewIndex: int32
        bufferViewOffset: int32
        byteStride: int32          # 0=紧凑
        componentType: int32
        normalized: bool
        typeStr: str
        count: int32
        byteLength: int64          # 整个 accessor 跨度 (含 stride)
        minVals: float64[]         # min/max (存在时, 逐分量)
        maxVals: float64[]

# 解析 accessor 引用并静态校验范围 (不读载荷); bin 提供字节总量判定。
@borrows
fn AssetGltfResolveAccessor(root: json.JsonNode, binLen: int64,
                            accessorIndex: int32,
                            out: var AssetGltfAccessorRef,
                            errOut: var str): bool =
    if accessorIndex < 0:
        errOut = "accessor: negative index"
        return false
    let accs = json.jsonGetField(root, "accessors")
    if accs.kind != json.JArray || accessorIndex >= accs.a.len:
        errOut = "accessor: index out of range"
        return false
    let acc = accs.a[accessorIndex]
    if acc.kind != json.JObject:
        errOut = "accessor: not an object"
        return false
    let countNode = json.jsonGetField(acc, "count")
    if countNode.kind != json.JInt || countNode.i <= int64(0):
        errOut = "accessor: invalid count"
        return false
    if countNode.i > int64(100000000):
        errOut = "accessor: count over bound"
        return false
    out.count = int32(countNode.i)
    out.accessorIndex = accessorIndex

    let typeNode = json.jsonGetField(acc, "type")
    if typeNode.kind != json.JString:
        errOut = "accessor: missing type"
        return false
    out.typeStr = Fmt"{typeNode.s}"
    let comps = AssetGltfTypeComponentCount(out.typeStr)
    if comps <= 0:
        errOut = "accessor: unsupported type (supported: SCALAR/VEC2/VEC3/VEC4/MAT4)"
        return false

    let compNode = json.jsonGetField(acc, "componentType")
    if compNode.kind != json.JInt:
        errOut = "accessor: missing componentType"
        return false
    out.componentType = int32(compNode.i)
    let compSize = AssetGltfComponentByteSize(out.componentType)
    if compSize <= 0:
        errOut = "accessor: unsupported componentType (supported: 5120/5121/5122/5123/5125/5126)"
        return false

    let normNode = json.jsonGetField(acc, "normalized")
    out.normalized = normNode.kind == json.JBool && normNode.b

    let elemSize: int64 = int64(compSize * comps)
    var tightLen: int64 = elemSize * int64(out.count)

    let bvNode = json.jsonGetField(acc, "bufferView")
    if bvNode.kind == json.JInt:
        out.bufferViewIndex = int32(bvNode.i)
        let bvs = json.jsonGetField(root, "bufferViews")
        if bvs.kind != json.JArray || out.bufferViewIndex >= bvs.a.len ||
           out.bufferViewIndex < 0:
            errOut = "accessor: bufferView index out of range"
            return false
        let bv = bvs.a[out.bufferViewIndex]
        if bv.kind != json.JObject:
            errOut = "accessor: bufferView not an object"
            return false
        let bvLenNode = json.jsonGetField(bv, "byteLength")
        if bvLenNode.kind != json.JInt || bvLenNode.i <= int64(0):
            errOut = "accessor: bufferView missing byteLength"
            return false
        let bvOffNode = json.jsonGetField(bv, "byteOffset")
        var bvOff: int64 = int64(0)
        if bvOffNode.kind == json.JInt:
            if bvOffNode.i < int64(0):
                errOut = "accessor: negative bufferView byteOffset"
                return false
            bvOff = bvOffNode.i
        let bufNode = json.jsonGetField(bv, "buffer")
        if bufNode.kind != json.JInt || int32(bufNode.i) != 0:
            errOut = "accessor: only buffer 0 (GLB BIN) is supported; external buffers rejected"
            return false
        # byteStride: 仅顶点属性语义; 必须是元素大小倍数。
        let strideNode = json.jsonGetField(bv, "byteStride")
        var stride: int64 = int64(0)
        if strideNode.kind == json.JInt:
            if strideNode.i < int64(0):
                errOut = "accessor: negative byteStride"
                return false
            stride = strideNode.i
            if stride % elemSize != int64(0) || stride > int64(252):
                errOut = "accessor: invalid byteStride (must be multiple of element size, <=252)"
                return false
            if stride < elemSize:
                errOut = "accessor: byteStride smaller than element"
                return false
        out.byteStride = int32(stride)
        let byteOffsetNode = json.jsonGetField(acc, "byteOffset")
        var accOff: int64 = int64(0)
        if byteOffsetNode.kind == json.JInt:
            if byteOffsetNode.i < int64(0):
                errOut = "accessor: negative byteOffset"
                return false
            accOff = byteOffsetNode.i
        out.bufferViewOffset = int32(accOff)
        if stride > int64(0):
            out.byteLength = stride * int64(out.count - 1) + elemSize
        else:
            out.byteLength = tightLen
        # 有界证明: bvOff + accOff + span <= binLen。
        let start: int64 = bvOff + accOff
        if start > binLen:
            errOut = "accessor: start beyond BIN chunk"
            return false
        if out.byteLength > binLen - start:
            errOut = "accessor: span beyond BIN chunk"
            return false
        if start + out.byteLength > int64(2147483647):
            errOut = "accessor: span over int32 bound"
            return false
    else:
        # 无 bufferView 的 accessor 不在本子集内 (首期全部走 BIN)。
        errOut = "accessor: missing bufferView (sparse/external unsupported)"
        return false

    let minNode = json.jsonGetField(acc, "min")
    if minNode.kind == json.JArray && minNode.a.len == comps:
        for i in 0..<minNode.a.len:
            if minNode.a[i].kind == json.JFloat:
                add(out.minVals, minNode.a[i].f)
            elif minNode.a[i].kind == json.JInt:
                add(out.minVals, float64(minNode.a[i].i))
    let maxNode = json.jsonGetField(acc, "max")
    if maxNode.kind == json.JArray && maxNode.a.len == comps:
        for i in 0..<maxNode.a.len:
            if maxNode.a[i].kind == json.JFloat:
                add(out.maxVals, maxNode.a[i].f)
            elif maxNode.a[i].kind == json.JInt:
                add(out.maxVals, float64(maxNode.a[i].i))
    return true


# IEEE-754 单精度位 -> float64 精确解码 (float32 值在 float64 中精确可表)。
# 固定运算顺序; NaN/Inf 按位模式返回并由上层 finite 校验拒绝。
fn AssetGltfF32BitsToFloat64(bits: int32): float64 =
    let sign = (bits >> 31) & 1
    let exp = (bits >> 23) & 255
    let mant = bits & 8388607
    var m: float64 = float64(mant) / 8388608.0
    var e: int32 = exp - 127
    if exp == 0:
        # 非规格化: (0.mant) * 2^-126
        m = float64(mant) / 8388608.0
        e = -126
    else:
        m = m + 1.0
    # 2^e 精确幂: 循环乘 (e in [-126,127])
    var p2v = 1.0
    if e >= 0:
        var i: int32
        while i < e:
            p2v = p2v * 2.0
            i = i + 1
    else:
        var i: int32
        while i < 0 - e:
            p2v = p2v * 0.5
            i = i + 1
    var out = m * p2v
    if sign == 1:
        out = 0.0 - out
    return out

# float64 扁平解码 (POSITION/NORMAL/TEXCOORD_0/WEIGHTS_0/MAT4 通用)。
# 返回数组按值交付 (跨模块 var 出参在 C 车头上不可靠); 失败返回空数组。
@borrows
fn AssetGltfReadF64(root: json.JsonNode, data: rawbytes.Bytes, binLen: int64,
                    accessorIndex: int32,
                    errOut: var str): float64[] =
    var outVals: float64[]
    var aref: AssetGltfAccessorRef
    if !AssetGltfResolveAccessor(root, binLen, accessorIndex, aref, errOut):
        return outVals
    if aref.componentType != 5126:
        errOut = "accessor: readF64 requires componentType 5126 (float32)"
        return outVals
    let comps = AssetGltfTypeComponentCount(aref.typeStr)
    var base: int64
    if aref.bufferViewIndex >= 0:
        let bvs = json.jsonGetField(root, "bufferViews")
        let bv = bvs.a[aref.bufferViewIndex]
        var bvOff: int64 = int64(0)
        let offNode = json.jsonGetField(bv, "byteOffset")
        if offNode.kind == json.JInt:
            bvOff = offNode.i
        base = bvOff + int64(aref.bufferViewOffset)
    var i: int32
    while i < aref.count:
        var k: int32
        while k < comps:
            var stride: int32 = aref.byteStride
            if stride == 0:
                stride = AssetGltfComponentByteSize(aref.componentType) *
                    AssetGltfTypeComponentCount(aref.typeStr)
            let pos: int32 = int32(base) + i * stride + k * 4
            if pos < 0 || pos + 4 > rawbytes.BytesLen(data):
                errOut = "accessor: read beyond BIN"
                return outVals
            let b0 = rawbytes.BytesGet(data, pos)
            let b1 = rawbytes.BytesGet(data, pos + 1)
            let b2 = rawbytes.BytesGet(data, pos + 2)
            let b3 = rawbytes.BytesGet(data, pos + 3)
            var raw: int64 = int64(b0) + int64(b1) * int64(256) +
                int64(b2) * int64(65536) + int64(b3) * int64(16777216)
            add(outVals, AssetGltfF32BitsToFloat64(int32(raw)))
            k = k + 1
        i = i + 1
    return outVals

# 索引解码 (SCALAR 5123/5125/5121) -> int32 数组。
@borrows
fn AssetGltfReadIndices(root: json.JsonNode, data: rawbytes.Bytes,
                        binLen: int64, accessorIndex: int32,
                        errOut: var str): float64[] =
    var outIdx: float64[]
    var aref: AssetGltfAccessorRef
    if !AssetGltfResolveAccessor(root, binLen, accessorIndex, aref, errOut):
        return outIdx
    if aref.typeStr != "SCALAR":
        errOut = "accessor: indices must be SCALAR"
        return outIdx
    if aref.componentType != 5123 && aref.componentType != 5125 &&
       aref.componentType != 5121:
        errOut = "accessor: indices componentType unsupported (supported: 5121/5123/5125)"
        return outIdx
    var base: int64 = int64(0)
    if aref.bufferViewIndex >= 0:
        let bvs = json.jsonGetField(root, "bufferViews")
        let bv = bvs.a[aref.bufferViewIndex]
        let offNode = json.jsonGetField(bv, "byteOffset")
        if offNode.kind == json.JInt:
            base = base + offNode.i
        base = base + int64(aref.bufferViewOffset)
    let step: int32 = AssetGltfComponentByteSize(aref.componentType)
    var i: int32
    while i < aref.count:
        let pos: int32 = int32(base) + i * step
        if pos < 0 || pos + step > rawbytes.BytesLen(data):
            errOut = "accessor: index read beyond BIN"
            return outIdx
        let b0 = rawbytes.BytesGet(data, pos)
        var raw: int64 = int64(b0)
        if step == 2:
            let b1 = rawbytes.BytesGet(data, pos + 1)
            raw = int64(b0 + (b1 << 8))
        elif step == 4:
            let b1 = rawbytes.BytesGet(data, pos + 1)
            let b2 = rawbytes.BytesGet(data, pos + 2)
            let b3 = rawbytes.BytesGet(data, pos + 3)
            raw = int64(b0) + int64(b1) * int64(256) + int64(b2) * int64(65536) +
                int64(b3) * int64(16777216)
        add(outIdx, float64(int32(raw)))
        i = i + 1
    return outIdx

# 索引环检测: 顶点索引必须在位置数范围内 (引用完整性, 无悬垂)。
@borrows
fn AssetGltfIndicesInRangeF(idx: float64[], vertexCount: int32): bool =
    for i in 0..<idx.len:
        let v = idx[i]
        if v < 0.0 || v >= float64(vertexCount):
            return false
        if v != v:
            return false
    return true
