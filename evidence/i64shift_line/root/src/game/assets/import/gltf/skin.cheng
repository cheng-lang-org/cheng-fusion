# CSG 资产 GLTF 导入: skin (D1)。
#
# 合同: 精确 joint/逆绑定/权重; 关节身份=节点索引 (交换文件内精确路径键),
# 禁止按名称重配; joint 次序必须先序 (parent < self), 非先序显式拒绝
# (首期不做重排); IBM 列主序 MAT4 逐关节读取; 权重负值/全零显式拒绝。
import std/json
import std/rawbytes
import cheng/game/assets/import/normalize
import cheng/game/assets/skeleton
import cheng/game/assets/import/gltf/scene
import cheng/game/assets/import/gltf/accessor

# 从节点层级推导 parent 表 (树: 每节点至多一个父, 多父拒绝)。
@borrows
fn AssetGltfNodeParents(scene: scene.AssetGltfScene,
                        outParents: var int32[]): bool =
    for i in 0..<scene.nodes.len:
        add(outParents, -1)
    for i in 0..<scene.nodes.len:
        for k in 0..<scene.nodes[i].children.len:
            let child = scene.nodes[i].children[k]
            if outParents[child] != -1:
                return false
            outParents[child] = i
    return true

# 解析 skins[index] 并构建骨架; joint 次序必须先序 (parent < self)。
@borrows
fn AssetGltfParseSkin(root: json.JsonNode, data: rawbytes.Bytes,
                      binLen: int64, scene: scene.AssetGltfScene,
                      skinIndex: int32, out: var skeleton.AssetSkeleton,
                      errOut: var str): bool =
    var parents: int32[]
    if !AssetGltfNodeParents(scene, parents):
        errOut = "skin: node hierarchy is not a tree (multi-parent)"
        return false
    let skins = json.jsonGetField(root, "skins")
    if skins.kind != json.JArray || skinIndex < 0 ||
       skinIndex >= skins.a.len:
        errOut = "skin: skin index out of range"
        return false
    let skin = skins.a[skinIndex]
    if skin.kind != json.JObject:
        errOut = "skin: skin not an object"
        return false
    let joints = json.jsonGetField(skin, "joints")
    if joints.kind != json.JArray || joints.a.len <= 0 ||
       joints.a.len > skeleton.AssetSkeletonMaxJoints():
        errOut = "skin: joint count invalid (quota 256)"
        return false
    out.jointCount = int32(joints.a.len)
    for i in 0..<joints.a.len:
        if joints.a[i].kind != json.JInt:
            errOut = "skin: joint entry non-integer"
            return false
        let nodeIndex = int32(joints.a[i].i)
        if nodeIndex < 0 || nodeIndex >= scene.nodes.len:
            errOut = "skin: joint node index out of range"
            return false
        let parent = parents[nodeIndex]
        if parent < 0:
            add(out.parents, -1)
        else:
            # 先序校验: parent 必须已在本 skin 的前缀里出现。
            var parentJoint: int32 = -1
            for j in 0..<i:
                if joints.a[j].kind == json.JInt &&
                   int32(joints.a[j].i) == parent:
                    parentJoint = j
                    break
            if parentJoint < 0:
                errOut = "skin: joint order not topological (parent must precede child); reorder unsupported"
                return false
            add(out.parents, parentJoint)
    let ibmNode = json.jsonGetField(skin, "inverseBindMatrices")
    if ibmNode.kind != json.JInt:
        errOut = "skin: missing inverseBindMatrices"
        return false
    # IBM: MAT4 float64, 列主序 => 与节点 matrix 同构转换。
    var vals = accessor.AssetGltfReadF64(root, data, binLen, int32(ibmNode.i),
                                         errOut)
    let count = out.jointCount
    if vals.len != count * 16:
        errOut = "skin: IBM element count mismatch"
        return false
    for j in 0..<count:
        var m: normalize.AssetMat4x3
        m.m00 = vals[j * 16 + 0]
        m.m10 = vals[j * 16 + 1]
        m.m20 = vals[j * 16 + 2]
        m.m01 = vals[j * 16 + 4]
        m.m11 = vals[j * 16 + 5]
        m.m21 = vals[j * 16 + 6]
        m.m02 = vals[j * 16 + 8]
        m.m12 = vals[j * 16 + 9]
        m.m22 = vals[j * 16 + 10]
        m.tx = vals[j * 16 + 12]
        m.ty = vals[j * 16 + 13]
        m.tz = vals[j * 16 + 14]
        add(out.inverseBinds, m)
    for j in 0..<count:
        add(out.names, Fmt"{scene.nodes[int32(joints.a[j].i)].name}")
    return skeleton.AssetSkeletonValid(out)
