# CSG 资产媒体导入: MP4/M4A ISO-BMFF box 遍历 (B1)。
#
# 合同 (计划 §3/§6): 原码流保留; 真实解析轨道/索引/timebase/编辑列表;
# 不能假定恒定帧率 (stts 多 delta = VFR 显式记录); B帧经 stss<samples
# 证明; 非零起始经 elst 空编辑 (media_time=-1) 证明; AAC priming 经
# 音轨 mdhd 时长差显式可测。大端 box; 深度/数量有界; 损坏拒绝。
import std/strings
import std/rawbytes
import cheng/game/assets/import/reader

fn AssetMediaBoxMaxDepth(): int32 =
    return 4

fn AssetMediaBoxMaxCount(): int32 =
    return 4096

fn AssetMediaHandlerVide(): int32 =
    return 1

fn AssetMediaHandlerSoun(): int32 =
    return 2

# 大端 u32 读取 (ISO-BMFF 全部大端); 越界返回 false。
@borrows
fn AssetMediaU32Be(data: rawbytes.Bytes, offset: int32, out: var int64): bool =
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return false
    let b0 = rawbytes.BytesGet(data, offset)
    let b1 = rawbytes.BytesGet(data, offset + 1)
    let b2 = rawbytes.BytesGet(data, offset + 2)
    let b3 = rawbytes.BytesGet(data, offset + 3)
    out = int64((b0 << 24) + (b1 << 16) + (b2 << 8) + b3)
    if out < int64(0):
        out = out + int64(4294967296)
    return true

# fourcc 大端值: b0<<24|b1<<16|b2<<8|b3 (int32 有符号域内比较)。
@borrows
fn AssetMediaFourccBe(data: rawbytes.Bytes, offset: int32, out: var int32): bool =
    if offset < 0 || offset + 4 > rawbytes.BytesLen(data):
        return false
    let b0 = rawbytes.BytesGet(data, offset)
    let b1 = rawbytes.BytesGet(data, offset + 1)
    let b2 = rawbytes.BytesGet(data, offset + 2)
    let b3 = rawbytes.BytesGet(data, offset + 3)
    out = (b0 << 24) + (b1 << 16) + (b2 << 8) + b3
    return true

fn AssetMediaFourccVide(): int32 =
    return (118 << 24) + (105 << 16) + (100 << 8) + 101

fn AssetMediaFourccSoun(): int32 =
    return (115 << 24) + (111 << 16) + (117 << 8) + 110

fn AssetMediaFourccAvc1(): int32 =
    return (97 << 24) + (118 << 16) + (99 << 8) + 49

fn AssetMediaFourccMp4a(): int32 =
    return (109 << 24) + (112 << 16) + (52 << 8) + 97

type
    AssetMp4TrackInfo =
        handler: int32            # 1=vide 2=soun 0=其他
        sampleEntry: int32        # stsd 采样条目 fourcc (avc1/mp4a/...)
        sampleCount: int32        # stts 采样总数
        sttsEntries: int32        # stts (count,delta) 条目数
        sttsFirstDelta: int32     # 首条 delta (VFR 时后续不同)
        sttsTotalDuration: int64
        timebase: int32           # mdhd timescale
        mediaDuration: int64      # mdhd duration
        syncCount: int32          # stss 同步采样数; -1=无 stss (全关键帧或无此box)
        elstEntries: int32
        elstEmptyEdits: int32     # media_time=-1 的空编辑数 (非零起始证明)
        elstFirstMediaTime: int64
        sttsCounts: int64[]       # stts 逐条采样数 (观测层用时序真值)
        sttsDeltas: int64[]       # stts 逐条 delta
        stssSamples: int64[]      # stss 逐条同步采样号 (1-based)

    AssetMp4Info =
        parsed: bool
        timescale: int32          # mvhd timescale
        duration: int64           # mvhd duration
        trackCount: int32
        tracks: AssetMp4TrackInfo[]

fn AssetMp4InfoReset(out: var AssetMp4Info) =
    out.timescale = 0
    out.duration = int64(0)
    out.trackCount = 0
    out.parsed = false

# box 遍历: 返回发现的子 box 数; 损坏 (size<hdr / 越界 / 超量) 返回 -1。
# cb 不可用 (无闭包): 由调用方使用 AssetMediaBoxChildNext 逐步推进。
@borrows
fn AssetMediaBoxChildNext(data: rawbytes.Bytes, off: var int32, endOff: int32,
                          boxType: var int32, boxPayload: var int32,
                          boxPayloadLen: var int32): bool =
    if off < 0 || off + 8 > endOff || endOff > rawbytes.BytesLen(data):
        return false
    var size: int64
    if !AssetMediaU32Be(data, off, size):
        return false
    var hdr: int32 = 8
    if size == int64(1):
        # largesize (u64 大端): 高位必须为 0 (配额内), 低 32 位。
        var hi: int64
        var lo: int64
        if !AssetMediaU32Be(data, off + 8, hi) ||
           !AssetMediaU32Be(data, off + 12, lo):
            return false
        if hi != int64(0) || lo > int64(2147483647):
            return false
        size = lo
        hdr = 16
    elif size == int64(0):
        size = int64(endOff - off)
    if size < int64(hdr) || int64(off) + size > int64(endOff):
        return false
    if !AssetMediaFourccBe(data, off + 4, boxType):
        return false
    boxPayload = off + hdr
    boxPayloadLen = int32(size - int64(hdr))
    off = int32(int64(off) + size)
    return true

@borrows
fn AssetMediaParseTrack(data: rawbytes.Bytes, trakPayload: int32,
                        trakLen: int32, out: var AssetMp4TrackInfo,
                        errOut: var str): bool =
    var off: int32 = trakPayload
    let endOff: int32 = trakPayload + trakLen
    var boxType: int32
    var payload: int32
    var payloadLen: int32
    while off < endOff:
        if !AssetMediaBoxChildNext(data, off, endOff, boxType, payload, payloadLen):
            errOut = "mp4: corrupted trak box walk"
            return false
        if boxType == ((101 << 24) + (100 << 16) + (116 << 8) + 115):
            # edts -> elst
            var eOff: int32 = payload
            let eEnd: int32 = payload + payloadLen
            var eType: int32
            var ePayload: int32
            var eLen: int32
            while eOff < eEnd:
                if !AssetMediaBoxChildNext(data, eOff, eEnd, eType, ePayload, eLen):
                    errOut = "mp4: corrupted edts walk"
                    return false
                if eType == ((101 << 24) + (108 << 16) + (115 << 8) + 116) &&
                   eLen >= 8:
                    let version = rawbytes.BytesGet(data, ePayload)
                    var n: int64
                    if !AssetMediaU32Be(data, ePayload + 4, n):
                        errOut = "mp4: elst truncated"
                        return false
                    if n > int64(256):
                        errOut = "mp4: elst entries over bound"
                        return false
                    out.elstEntries = int32(n)
                    var k: int32
                    while k < int32(n):
                        if version == 0:
                            var segDur: int64
                            if !AssetMediaU32Be(data, ePayload + 8 + k * 12, segDur):
                                errOut = "mp4: elst entry truncated"
                                return false
                            var mt: int32
                            if !AssetMediaFourccBe(data, ePayload + 12 + k * 12, mt):
                                errOut = "mp4: elst media time truncated"
                                return false
                            if k == 0:
                                out.elstFirstMediaTime = int64(mt)
                            if mt == -1:
                                out.elstEmptyEdits = out.elstEmptyEdits + 1
                        k = k + 1
        if boxType == ((109 << 24) + (100 << 16) + (105 << 8) + 97):
            # mdia
            var mOff: int32 = payload
            let mEnd: int32 = payload + payloadLen
            var mType: int32
            var mPayload: int32
            var mLen: int32
            while mOff < mEnd:
                if !AssetMediaBoxChildNext(data, mOff, mEnd, mType, mPayload, mLen):
                    errOut = "mp4: corrupted mdia walk"
                    return false
                # hdlr: version/flags(4)+pre_defined(4)+handler_type(4) => +8。
                if mType == ((104 << 24) + (100 << 16) + (108 << 8) + 114) &&
                   mLen >= 12:
                    var h: int32
                    if AssetMediaFourccBe(data, mPayload + 8, h):
                        if h == AssetMediaFourccVide():
                            out.handler = AssetMediaHandlerVide()
                        elif h == AssetMediaFourccSoun():
                            out.handler = AssetMediaHandlerSoun()
                if mType == ((109 << 24) + (100 << 16) + (104 << 8) + 100) &&
                   mLen >= 20 && rawbytes.BytesGet(data, mPayload) == 0:
                    var ts: int64
                    var dur: int64
                    if !AssetMediaU32Be(data, mPayload + 12, ts) ||
                       !AssetMediaU32Be(data, mPayload + 16, dur):
                        errOut = "mp4: mdhd truncated"
                        return false
                    out.timebase = int32(ts)
                    out.mediaDuration = dur
                if mType == ((109 << 24) + (105 << 16) + (110 << 8) + 102):
                    # minf -> stbl
                    var sOff: int32 = mPayload
                    let sEnd: int32 = mPayload + mLen
                    var sType: int32
                    var sPayload: int32
                    var sLen: int32
                    while sOff < sEnd:
                        if !AssetMediaBoxChildNext(data, sOff, sEnd, sType, sPayload, sLen):
                            errOut = "mp4: corrupted minf walk"
                            return false
                        if sType == ((115 << 24) + (116 << 16) + (98 << 8) + 108):
                            # stbl -> stsd/stts/stss
                            var bOff: int32 = sPayload
                            let bEnd: int32 = sPayload + sLen
                            var bType: int32
                            var bPayload: int32
                            var bLen: int32
                            while bOff < bEnd:
                                if !AssetMediaBoxChildNext(data, bOff, bEnd, bType, bPayload, bLen):
                                    errOut = "mp4: corrupted stbl walk"
                                    return false
                                if bType == ((115 << 24) + (116 << 16) + (115 << 8) + 100) &&
                                   bLen >= 16:
                                    var f: int32
                                    if AssetMediaFourccBe(data, bPayload + 12, f):
                                        out.sampleEntry = f
                                if bType == ((115 << 24) + (116 << 16) + (116 << 8) + 115) &&
                                   bLen >= 8:
                                    var n: int64
                                    if !AssetMediaU32Be(data, bPayload + 4, n):
                                        errOut = "mp4: stts truncated"
                                        return false
                                    if n > int64(65536):
                                        errOut = "mp4: stts entries over bound"
                                        return false
                                    out.sttsEntries = int32(n)
                                    var k: int32
                                    while k < int32(n):
                                        var sc: int64
                                        var sd: int64
                                        if !AssetMediaU32Be(data, bPayload + 8 + k * 8, sc) ||
                                           !AssetMediaU32Be(data, bPayload + 12 + k * 8, sd):
                                            errOut = "mp4: stts entry truncated"
                                            return false
                                        if k == 0:
                                            out.sttsFirstDelta = int32(sd)
                                        add(out.sttsCounts, sc)
                                        add(out.sttsDeltas, sd)
                                        out.sampleCount = out.sampleCount + int32(sc)
                                        out.sttsTotalDuration = out.sttsTotalDuration +
                                            sc * sd
                                        k = k + 1
                                if bType == ((115 << 24) + (116 << 16) + (115 << 8) + 115) &&
                                   bLen >= 4:
                                    var n: int64
                                    if !AssetMediaU32Be(data, bPayload + 4, n):
                                        errOut = "mp4: stss truncated"
                                        return false
                                    out.syncCount = int32(n)
                                    var sk: int32
                                    while sk < int32(n):
                                        var smp: int64
                                        if !AssetMediaU32Be(data, bPayload + 8 + sk * 4, smp):
                                            errOut = "mp4: stss entry truncated"
                                            return false
                                        add(out.stssSamples, smp)
                                        sk = sk + 1
                                bOff = bPayload + bLen
                        sOff = sPayload + sLen
                mOff = mPayload + mLen
    return true

# MP4 解析主入口: ftyp 必需; moov 内 mvhd + trak 逐轨。
@borrows
fn AssetMediaParseMp4(data: rawbytes.Bytes, out: var AssetMp4Info,
                      errOut: var str): bool =
    AssetMp4InfoReset(out)
    let size = rawbytes.BytesLen(data)
    var off: int32
    var boxType: int32
    var payload: int32
    var payloadLen: int32
    var haveFtyp: bool
    var haveMoov: bool
    while off + 8 <= size:
        if !AssetMediaBoxChildNext(data, off, size, boxType, payload, payloadLen):
            errOut = "mp4: corrupted top-level box walk"
            return false
        if boxType == ((102 << 24) + (116 << 16) + (121 << 8) + 112):
            haveFtyp = true
        if boxType == ((109 << 24) + (111 << 16) + (111 << 8) + 118):
            haveMoov = true
            var mOff: int32 = payload
            let mEnd: int32 = payload + payloadLen
            var tType: int32
            var tPayload: int32
            var tLen: int32
            while mOff < mEnd:
                if !AssetMediaBoxChildNext(data, mOff, mEnd, tType, tPayload, tLen):
                    errOut = "mp4: corrupted moov walk"
                    return false
                if tType == ((109 << 24) + (118 << 16) + (104 << 8) + 100) &&
                   tLen >= 20 && rawbytes.BytesGet(data, tPayload) == 0:
                    var ts: int64
                    var dur: int64
                    if !AssetMediaU32Be(data, tPayload + 12, ts) ||
                       !AssetMediaU32Be(data, tPayload + 16, dur):
                        errOut = "mp4: mvhd truncated"
                        return false
                    out.timescale = int32(ts)
                    out.duration = dur
                if tType == ((116 << 24) + (114 << 16) + (97 << 8) + 107):
                    var t: AssetMp4TrackInfo
                    t.syncCount = -1
                    t.elstFirstMediaTime = int64(-2147483648)
                    if !AssetMediaParseTrack(data, tPayload, tLen, t, errOut):
                        return false
                    if out.trackCount >= 8:
                        errOut = "mp4: track count over bound (max 8)"
                        return false
                    add(out.tracks, t)
                    out.trackCount = out.trackCount + 1
                mOff = tPayload + tLen
    if !haveFtyp:
        errOut = "mp4: missing ftyp"
        return false
    if !haveMoov:
        errOut = "mp4: missing moov"
        return false
    if out.timescale <= 0:
        errOut = "mp4: invalid mvhd timescale"
        return false
    out.parsed = true
    return true

# VFR 判定: 同轨 stts 出现多个不同 delta => 变量帧率, 不得按恒定帧率解释。
@borrows
fn AssetMp4TrackVariableFps(t: AssetMp4TrackInfo): bool =
    if t.handler != AssetMediaHandlerVide():
        return false
    return t.sttsEntries > 1

# B帧判定: 有 stss 且同步采样数 < 采样总数 => 存在非关键帧 (P/B)。
@borrows
fn AssetMp4TrackHasInterFrames(t: AssetMp4TrackInfo): bool =
    if t.handler != AssetMediaHandlerVide():
        return false
    if t.syncCount < 0:
        return false
    return t.syncCount < t.sampleCount

# 非零起始判定: elst 存在空编辑 (media_time=-1) => 展示时间线相对媒体偏移。
@borrows
fn AssetMp4TrackNonZeroStart(t: AssetMp4TrackInfo): bool =
    return t.elstEmptyEdits > 0
