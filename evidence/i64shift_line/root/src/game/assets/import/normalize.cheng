# CSG 资产规范化 (A3): 坐标/单位一次完成转换。
#
# 合同 (计划 §3): 坐标转换一次完成: 源坐标 -> 世界右手 Z 向上、米制;
# 同步处理网格、法线、父子矩阵、逆绑定。glTF 为右手 Y-up 米 (规范 3.1.2),
# 世界为右手 Z-up 米: (x,y,z) -> (x,-z,y)。非均匀缩放允许, 镜像 (行列式
# <0) 记录标志, 奇异 (|det| < eps) 拒绝——判据明确, 不只修视觉矩阵。
# float64 固定运算顺序, 禁 NaN/Inf 输入。
import std/strings

type
    AssetVec3 =
        x: float64
        y: float64
        z: float64

    # 3x3 行主序 + 平移: 显式字段, 无指针。
    AssetMat4x3 =
        m00: float64
        m01: float64
        m02: float64
        m10: float64
        m11: float64
        m12: float64
        m20: float64
        m21: float64
        m22: float64
        tx: float64
        ty: float64
        tz: float64

    # glTF 节点 TRS (转换前源空间)。
    AssetNodeTrs =
        t: AssetVec3
        rx: float64                   # 四元数 (x,y,z,w)
        ry: float64
        rz: float64
        rw: float64
        sx: float64
        sy: float64
        sz: float64

fn AssetVec3Make(x: float64, y: float64, z: float64): AssetVec3 =
    var v: AssetVec3
    v.x = x
    v.y = y
    v.z = z
    return v

fn AssetVec3Finite(v: AssetVec3): bool =
    if v.x != v.x:
        return false
    if v.y != v.y:
        return false
    if v.z != v.z:
        return false
    if v.x > 1.0e308 || v.x < -1.0e308:
        return false
    if v.y > 1.0e308 || v.y < -1.0e308:
        return false
    if v.z > 1.0e308 || v.z < -1.0e308:
        return false
    return true

# Y-up -> Z-up 轴变换 (右手系, 保持手性): (x,y,z) -> (x,-z,y)。
fn AssetNormalizeVec3(v: AssetVec3): AssetVec3 =
    return AssetVec3Make(v.x, -v.z, v.y)

fn AssetMatIdentity(): AssetMat4x3 =
    var m: AssetMat4x3
    m.m00 = 1.0
    m.m11 = 1.0
    m.m22 = 1.0
    return m

# 轴变换矩阵 A: (x,y,z)->(x,-z,y) 行主序 [[1,0,0],[0,0,-1],[0,1,0]]。
fn AssetMatAxisYUpToZUp(): AssetMat4x3 =
    var m: AssetMat4x3
    m.m00 = 1.0
    m.m12 = -1.0
    m.m21 = 1.0
    return m

# 点变换 (含平移)。
fn AssetMatMulVecPoint(m: AssetMat4x3, v: AssetVec3): AssetVec3 =
    return AssetVec3Make(
        m.m00 * v.x + m.m01 * v.y + m.m02 * v.z + m.tx,
        m.m10 * v.x + m.m11 * v.y + m.m12 * v.z + m.ty,
        m.m20 * v.x + m.m21 * v.y + m.m22 * v.z + m.tz)

fn AssetMatMulVec(m: AssetMat4x3, v: AssetVec3): AssetVec3 =
    return AssetVec3Make(
        m.m00 * v.x + m.m01 * v.y + m.m02 * v.z,
        m.m10 * v.x + m.m11 * v.y + m.m12 * v.z,
        m.m20 * v.x + m.m21 * v.y + m.m22 * v.z)

# 行主序 3x3 乘法 (固定顺序)。
fn AssetMatMul(a: AssetMat4x3, b: AssetMat4x3): AssetMat4x3 =
    var out: AssetMat4x3
    out.m00 = a.m00 * b.m00 + a.m01 * b.m10 + a.m02 * b.m20
    out.m01 = a.m00 * b.m01 + a.m01 * b.m11 + a.m02 * b.m21
    out.m02 = a.m00 * b.m02 + a.m01 * b.m12 + a.m02 * b.m22
    out.m10 = a.m10 * b.m00 + a.m11 * b.m10 + a.m12 * b.m20
    out.m11 = a.m10 * b.m01 + a.m11 * b.m11 + a.m12 * b.m21
    out.m12 = a.m10 * b.m02 + a.m11 * b.m12 + a.m12 * b.m22
    out.m20 = a.m20 * b.m00 + a.m21 * b.m10 + a.m22 * b.m20
    out.m21 = a.m20 * b.m01 + a.m21 * b.m11 + a.m22 * b.m21
    out.m22 = a.m20 * b.m02 + a.m21 * b.m12 + a.m22 * b.m22
    out.tx = a.m00 * b.tx + a.m01 * b.ty + a.m02 * b.tz + a.tx
    out.ty = a.m10 * b.tx + a.m11 * b.ty + a.m12 * b.tz + a.ty
    out.tz = a.m20 * b.tx + a.m21 * b.ty + a.m22 * b.tz + a.tz
    return out

# 四元数 -> 旋转矩阵 (右手, 归一化输入由调用方保证; 固定运算顺序)。
fn AssetMatFromQuat(qx: float64, qy: float64, qz: float64, qw: float64): AssetMat4x3 =
    var m: AssetMat4x3
    let xx = qx * qx
    let yy = qy * qy
    let zz = qz * qz
    m.m00 = 1.0 - 2.0 * (yy + zz)
    m.m01 = 2.0 * (qx * qy - qz * qw)
    m.m02 = 2.0 * (qx * qz + qy * qw)
    m.m10 = 2.0 * (qx * qy + qz * qw)
    m.m11 = 1.0 - 2.0 * (xx + zz)
    m.m12 = 2.0 * (qy * qz - qx * qw)
    m.m20 = 2.0 * (qx * qz - qy * qw)
    m.m21 = 2.0 * (qy * qz + qx * qw)
    m.m22 = 1.0 - 2.0 * (xx + yy)
    return m

# glTF 节点 TRS -> 矩阵 (源空间): T * R * S。平移分量同步轴变换前先组源矩阵。
fn AssetMatFromTrs(trs: AssetNodeTrs): AssetMat4x3 =
    var m = AssetMatFromQuat(trs.rx, trs.ry, trs.rz, trs.rw)
    m.m00 = m.m00 * trs.sx
    m.m01 = m.m01 * trs.sy
    m.m02 = m.m02 * trs.sz
    m.m10 = m.m10 * trs.sx
    m.m11 = m.m11 * trs.sy
    m.m12 = m.m12 * trs.sz
    m.m20 = m.m20 * trs.sx
    m.m21 = m.m21 * trs.sy
    m.m22 = m.m22 * trs.sz
    m.tx = trs.t.x
    m.ty = trs.t.y
    m.tz = trs.t.z
    return m

# 源空间节点矩阵 -> 世界空间: A * M * A^-1 共轭 + A 作用平移。
# 对 A=(x,-z,y) 有 A^-1 = A^T, 共轭展开为固定公式 (下方实现), 平移 A*t。
fn AssetMatToWorld(src: AssetMat4x3): AssetMat4x3 =
    # 共轭: out = A * src * A^T; A 行主序 [[1,0,0],[0,0,-1],[0,1,0]]。
    # 展开后等价于对 3x3 做: 行取 (0,2,1) 再列取 (0,2,1) 并带符号翻转。
    var out: AssetMat4x3
    out.m00 = src.m00
    out.m01 = -src.m02
    out.m02 = src.m01
    out.m10 = -src.m20
    out.m11 = src.m22
    out.m12 = -src.m21
    out.m20 = src.m10
    out.m21 = -src.m12
    out.m22 = src.m11
    let t = AssetNormalizeVec3(AssetVec3Make(src.tx, src.ty, src.tz))
    out.tx = t.x
    out.ty = t.y
    out.tz = t.z
    return out

fn AssetMatDeterminant(m: AssetMat4x3): float64 =
    return m.m00 * (m.m11 * m.m22 - m.m12 * m.m21) -
        m.m01 * (m.m10 * m.m22 - m.m12 * m.m20) +
        m.m02 * (m.m10 * m.m21 - m.m11 * m.m20)

fn AssetMatFinite(m: AssetMat4x3): bool =
    if !AssetVec3Finite(AssetVec3Make(m.m00, m.m01, m.m02)):
        return false
    if !AssetVec3Finite(AssetVec3Make(m.m10, m.m11, m.m12)):
        return false
    if !AssetVec3Finite(AssetVec3Make(m.m20, m.m21, m.m22)):
        return false
    if !AssetVec3Finite(AssetVec3Make(m.tx, m.ty, m.tz)):
        return false
    return true

# 变换判据: 奇异拒绝; 镜像返回 true 并记录 (镜像变体必须显式知情)。
fn AssetMatSingular(m: AssetMat4x3): bool =
    let det = AssetMatDeterminant(m)
    if det < 0.000000000001 && det > -0.000000000001:
        return true
    return false

fn AssetMatMirrored(m: AssetMat4x3): bool =
    return AssetMatDeterminant(m) < 0.0

# 单位: glTF 长度单位为米 (规范定义), 世界为米: 恒等转换, 无缩放;
# 该函数显式存在以记录"单位转换独立按量纲计算"的事实 (禁止全字段乘比例)。
fn AssetNormalizeLengthMeters(meters: float64): float64 =
    return meters
