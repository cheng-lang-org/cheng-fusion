# CSG 资产动画 (D1): 采样器/通道/插值求值。
#
# 合同 (计划 §5 D1 行): 三种插值中首期 LINEAR/STEP (CUBICSPLINE 显式拒绝,
# 计划 §3); 四元数求值用 slerp (旋转误差 ≤0.01° 合同); 指定时刻求值确定
# (固定运算顺序); 动画不越权: 只写目标节点 TRS, 不产生物理能力。
import std/strings
import std/math
import cheng/game/assets/import/normalize

fn AssetAnimInterpLinear(): int32 =
    return 0

fn AssetAnimInterpStep(): int32 =
    return 1

fn AssetAnimPathTranslation(): int32 =
    return 0

fn AssetAnimPathRotation(): int32 =
    return 1

fn AssetAnimPathScale(): int32 =
    return 2

type
    AssetAnimSampler =
        interp: int32
        components: int32         # 每关键帧分量数 (3=vec3, 4=quat, 1=scalar)
        times: float64[]          # 单调不减, 首尾即动画区间
        values: float64[]         # times.len * components 扁平

    AssetAnimChannel =
        samplerIndex: int32
        targetNode: int32
        targetPath: int32

    AssetAnimation =
        name: str
        samplers: AssetAnimSampler[]
        channels: AssetAnimChannel[]

@borrows
fn AssetAnimSamplerValid(s: AssetAnimSampler): bool =
    if s.times.len <= 0:
        return false
    if s.values.len != s.times.len * s.components:
        return false
    if s.components != 3 && s.components != 4 && s.components != 1:
        return false
    for i in 1..<s.times.len:
        if s.times[i] < s.times[i - 1]:
            return false
    return true

# 时刻查找: 返回区间 [i, i+1]; t 首前/尾后由调用方钳制 (动画末端不外推)。
@borrows
fn AssetAnimKeyframeSpan(times: float64[], t: float64): int32 =
    let n = times.len
    if t <= times[0]:
        return 0
    if t >= times[n - 1]:
        return n - 2
    var i: int32
    while i + 1 < n && times[i + 1] <= t:
        i = i + 1
    if i + 1 >= n:
        return n - 2
    return i

fn AssetAnimLerp(a: float64, b: float64, u: float64): float64 =
    return a + (b - a) * u

# 四元数 slerp: dot<0 取反保证短弧; 接近平行退化 nlerp (阈值 0.9995);
# 角度经确定性二分 acos (60 次, 精度 ~1e-15 rad, 远优于 0.01° 合同)。
fn AssetAnimQuatSlerp(ax: float64, ay: float64, az: float64, aw: float64,
                      bx: float64, by: float64, bz: float64, bw: float64,
                      u: float64, out: var normalize.AssetNodeTrs) =
    var d = ax * bx + ay * by + az * bz + aw * bw
    var ex = bx
    var ey = by
    var ez = bz
    var ew = bw
    if d < 0.0:
        ex = 0.0 - ex
        ey = 0.0 - ey
        ez = 0.0 - ez
        ew = 0.0 - ew
        d = 0.0 - d
    var cx = ax
    var cy = ay
    var cz = az
    var cw = aw
    if d > 0.9995:
        cx = AssetAnimLerp(ax, ex, u)
        cy = AssetAnimLerp(ay, ey, u)
        cz = AssetAnimLerp(az, ez, u)
        cw = AssetAnimLerp(aw, ew, u)
    else:
        let angle = AssetAnimAcos(d)
        let sinAngle = math.Sin(angle)
        let s0 = math.Sin((1.0 - u) * angle) / sinAngle
        let s1 = math.Sin(u * angle) / sinAngle
        cx = ax * s0 + ex * s1
        cy = ay * s0 + ey * s1
        cz = az * s0 + ez * s1
        cw = aw * s0 + ew * s1
    # 归一化 (抵消累计数值误差, 属求值语义而非静默修数据)。
    let n = math.Sqrt(cx * cx + cy * cy + cz * cz + cw * cw)
    if n > 0.0:
        out.rx = cx / n
        out.ry = cy / n
        out.rz = cz / n
        out.rw = cw / n

# acos 二分: cos 在 [0, pi] 单调递减; 固定 60 次迭代, 结果确定。
@borrows
fn AssetAnimAcos(c: float64): float64 =
    var c2 = c
    if c2 > 1.0:
        c2 = 1.0
    if c2 < -1.0:
        c2 = -1.0
    var lo = 0.0
    var hi = 3.141592653589793
    var i: int32
    while i < 60:
        let mid = (lo + hi) * 0.5
        if math.Cos(mid) > c2:
            lo = mid
        else:
            hi = mid
        i = i + 1
    return (lo + hi) * 0.5

# vec3 通道求值 (translation/scale); 首前钳首帧, 尾后钳尾帧 (不外推);
# 单关键帧 = 常量。
@borrows
fn AssetAnimEvalVec3(s: AssetAnimSampler, t: float64,
                     out: var normalize.AssetVec3): bool =
    if s.components != 3 || !AssetAnimSamplerValid(s):
        return false
    if s.times.len == 1:
        out = normalize.AssetVec3Make(s.values[0], s.values[1], s.values[2])
        return true
    let i = AssetAnimKeyframeSpan(s.times, t)
    let base = i * 3
    if s.interp == AssetAnimInterpStep():
        out = normalize.AssetVec3Make(s.values[base], s.values[base + 1],
            s.values[base + 2])
        return true
    let span = s.times[i + 1] - s.times[i]
    var u = 0.0
    if span > 0.0:
        u = (t - s.times[i]) / span
    if u > 1.0:
        u = 1.0
    if u < 0.0:
        u = 0.0
    out = normalize.AssetVec3Make(
        AssetAnimLerp(s.values[base], s.values[base + 3], u),
        AssetAnimLerp(s.values[base + 1], s.values[base + 4], u),
        AssetAnimLerp(s.values[base + 2], s.values[base + 5], u))
    return true

# 四元数通道求值 (rotation, slerp); 单关键帧 = 常量。
@borrows
fn AssetAnimEvalQuat(s: AssetAnimSampler, t: float64,
                     out: var normalize.AssetNodeTrs): bool =
    if s.components != 4 || !AssetAnimSamplerValid(s):
        return false
    if s.times.len == 1:
        out.rx = s.values[0]
        out.ry = s.values[1]
        out.rz = s.values[2]
        out.rw = s.values[3]
        return true
    let i = AssetAnimKeyframeSpan(s.times, t)
    let base = i * 4
    if s.interp == AssetAnimInterpStep():
        out.rx = s.values[base]
        out.ry = s.values[base + 1]
        out.rz = s.values[base + 2]
        out.rw = s.values[base + 3]
        return true
    let span = s.times[i + 1] - s.times[i]
    var u = 0.0
    if span > 0.0:
        u = (t - s.times[i]) / span
    if u > 1.0:
        u = 1.0
    if u < 0.0:
        u = 0.0
    AssetAnimQuatSlerp(s.values[base], s.values[base + 1], s.values[base + 2],
        s.values[base + 3], s.values[base + 4], s.values[base + 5],
        s.values[base + 6], s.values[base + 7], u, out)
    return true

# 单通道应用: 把 t 时刻求值写进目标 TRS 对应分量。
@borrows
fn AssetAnimApplyChannel(anim: AssetAnimation, ch: AssetAnimChannel, t: float64,
                         trs: var normalize.AssetNodeTrs): bool =
    if ch.samplerIndex < 0 || ch.samplerIndex >= anim.samplers.len:
        return false
    let s = anim.samplers[ch.samplerIndex]
    if ch.targetPath == AssetAnimPathTranslation():
        var v = normalize.AssetVec3Make(0.0, 0.0, 0.0)
        if !AssetAnimEvalVec3(s, t, v):
            return false
        trs.t = v
        return true
    if ch.targetPath == AssetAnimPathRotation():
        return AssetAnimEvalQuat(s, t, trs)
    if ch.targetPath == AssetAnimPathScale():
        var v = normalize.AssetVec3Make(0.0, 0.0, 0.0)
        if !AssetAnimEvalVec3(s, t, v):
            return false
        trs.sx = v.x
        trs.sy = v.y
        trs.sz = v.z
        return true
    return false

# 动画区间: 全部采样器时间范围的并 (首帧最小, 尾帧最大)。
@borrows
fn AssetAnimTimeRange(anim: AssetAnimation, loOut: var float64,
                      hiOut: var float64): bool =
    var first: bool = true
    for i in 0..<anim.samplers.len:
        let s = anim.samplers[i]
        if s.times.len <= 0:
            continue
        if first:
            loOut = s.times[0]
            hiOut = s.times[s.times.len - 1]
            first = false
        else:
            if s.times[0] < loOut:
                loOut = s.times[0]
            if s.times[s.times.len - 1] > hiOut:
                hiOut = s.times[s.times.len - 1]
    return !first
