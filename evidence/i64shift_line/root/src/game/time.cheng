# Cinema time contract (A2 frozen): int64 ticks at 240 Hz authority rate,
# 24 fps video, 48 kHz audio. All mappings are exact integer math — no
# floating point on the timeline, no cumulative truncation (contract §2).
#
#   10 s film = 2400 physics ticks = 240 video frames = 480000 samples/ch.
#   Interval is [0, 10s): the terminal state may be saved but no extra
#   frame is exported.
#
# tick -> frame: tick / 10 (floor, exact)
# tick -> sample: tick * 200 (exact)
# frame -> tick: frame * 10 (exact)
import std/strings as strings

const
    CinemaTimeSchema = "cheng.game.cinema.time.v1"
    CinemaTickRate = 240
    CinemaFps = 24
    CinemaSampleRate = 48000
    CinemaStepsPerFrame = 10
    CinemaSamplesPerStep = 200
    CinemaFilmTicks = 2400
    CinemaFilmFrames = 240
    CinemaFilmSamples = 480000
    CinemaDtMilliNum = 1
    CinemaDtMilliDen = 240

type
    CinemaTime =
        tick: int64
        filmTickLimit: int64

fn CinemaTimeReset(t: var CinemaTime) =
    t.tick = 0
    t.filmTickLimit = int64(CinemaFilmTicks)

fn CinemaTimeMake(): CinemaTime =
    var t: CinemaTime
    CinemaTimeReset(t)
    return t

# Advance one authority tick; refusing to run past the film limit keeps the
# exported interval closed at [0, 10s) (no phantom extra step/frame).
fn CinemaTimeAdvance(t: var CinemaTime): bool =
    if t.tick + int64(1) >= t.filmTickLimit:
        return false
    t.tick = t.tick + int64(1)
    return true

fn CinemaTimeFrameOf(tick: int64): int32 =
    return int32(tick / int64(CinemaStepsPerFrame))

fn CinemaTimeSampleOf(tick: int64): int64 =
    return tick * int64(CinemaSamplesPerStep)

fn CinemaTimeFrameStartTick(frame: int32): int64 =
    return int64(frame) * int64(CinemaStepsPerFrame)

@borrows
fn CinemaTimeCanonicalPreimage(t: CinemaTime): str =
    var out: str = CinemaTimeSchema
    out = out + "|tick=" + strings.Int64ToStr(t.tick)
    out = out + "|limit=" + strings.Int64ToStr(t.filmTickLimit)
    out = out + "|rate=" + strings.IntToStr(CinemaTickRate)
    out = out + "|fps=" + strings.IntToStr(CinemaFps)
    out = out + "|sr=" + strings.IntToStr(CinemaSampleRate)
    return out

# Time invariants: tick inside film range, non-negative, frame/sample
# mappings consistent at both ends of the frozen table.
@borrows
fn CinemaTimeValid(t: CinemaTime): bool =
    if t.tick < int64(0):
        return false
    if t.tick >= t.filmTickLimit:
        return false
    if t.filmTickLimit != int64(CinemaFilmTicks):
        return false
    let frame = CinemaTimeFrameOf(t.tick)
    if CinemaTimeFrameStartTick(frame) != t.tick - (t.tick % int64(CinemaStepsPerFrame)):
        return false
    if CinemaTimeSampleOf(t.tick) != t.tick * int64(CinemaSamplesPerStep):
        return false
    return true
