import cheng/game/ecs
import std/system
import std/strings as strings
import std/strutils as strutil

const
    Physics2dSchema = "cheng.game.physics2d.v2"
    Physics2dForcesSchema = "cheng.game.physics2d.forces.v2"
    Physics2dStatusOk = 1
    Physics2dStatusInvalidWorld = 2
    Physics2dStatusUnsupportedCollider = 3
    Physics2dStatusInvalidForcesConfig = 4
    Physics2dCidHexLen = 32 * 2

type
    Physics2dStepReceipt =
        schema: str
        tick: int32
        dtMs: int32
        sourceWorldCid: str
        resultWorldCid: str
        contactCount: int32
        separationIterations: int32
        statusCode: int32
        forcesReceiptCid: str
        receiptCid: str
        trace: str

    Physics2dForcesConfig =
        gravityY: int32
        dragNum: int32
        dragDen: int32
        splashEnabled: int32
        splashFloorY: int32
        splashRestNum: int32
        splashRestDen: int32
        splashJitterNum: int32
        splashJitterDen: int32
        inkDecayNum: int32
        inkDecayDen: int32

    Physics2dForcesReceipt =
        schema: str
        tick: int32
        dtMs: int32
        gravityApplied: int32
        dragApplied: int32
        splashCount: int32
        statusCode: int32
        worldCid: str
        receiptCid: str
        trace: str

fn physicsAbsI32(value: int32): int32 =
    if value < 0:
        return 0 - value
    return value

fn physicsMixInt(hash: int32, value: int32): int32 =
    let h = hash % 65521
    let v = physicsAbsI32(value) % 1000003
    return (h * 33 + v + 19) % 1000000007

fn physicsSignNonZero(value: int32): int32 =
    if value < 0:
        return -1
    return 1

@borrows
fn Physics2dWorldSupported(world: ecs.EcsWorld): bool =
    if !ecs.EcsWorldColumnsValid(world):
        return false
    for i in 0..<world.count:
        let kind = ecs.EcsWorldColliderKindAt(world, i)
        if kind != ecs.EcsColliderNone:
            if kind != ecs.EcsColliderAabb:
                return false
    return true

@borrows
fn physics2dAabbPairOverlaps(world: ecs.EcsWorld, left: int32, right: int32): bool =
    if ecs.EcsWorldColliderKindAt(world, left) != ecs.EcsColliderAabb:
        return false
    if ecs.EcsWorldColliderKindAt(world, right) != ecs.EcsColliderAabb:
        return false
    let dx = physicsAbsI32(ecs.EcsWorldPositionXAt(world, right) - ecs.EcsWorldPositionXAt(world, left))
    let dy = physicsAbsI32(ecs.EcsWorldPositionYAt(world, right) - ecs.EcsWorldPositionYAt(world, left))
    let sumX = ecs.EcsWorldColliderHalfWidthAt(world, left) + ecs.EcsWorldColliderHalfWidthAt(world, right)
    let sumY = ecs.EcsWorldColliderHalfHeightAt(world, left) + ecs.EcsWorldColliderHalfHeightAt(world, right)
    if dx >= sumX:
        return false
    if dy >= sumY:
        return false
    return true

fn physics2dResolveAabbPair(world: var ecs.EcsWorld, left: int32, right: int32): bool =
    if !physics2dAabbPairOverlaps(world, left, right):
        return false
    let leftX = ecs.EcsWorldPositionXAt(world, left)
    let rightX = ecs.EcsWorldPositionXAt(world, right)
    let leftY = ecs.EcsWorldPositionYAt(world, left)
    let rightY = ecs.EcsWorldPositionYAt(world, right)
    let leftVx = ecs.EcsWorldVelocityXAt(world, left)
    let rightVx = ecs.EcsWorldVelocityXAt(world, right)
    let leftVy = ecs.EcsWorldVelocityYAt(world, left)
    let rightVy = ecs.EcsWorldVelocityYAt(world, right)
    let dx = rightX - leftX
    let dy = rightY - leftY
    let sumX = ecs.EcsWorldColliderHalfWidthAt(world, left) + ecs.EcsWorldColliderHalfWidthAt(world, right)
    let sumY = ecs.EcsWorldColliderHalfHeightAt(world, left) + ecs.EcsWorldColliderHalfHeightAt(world, right)
    let overlapX = sumX - physicsAbsI32(dx)
    let overlapY = sumY - physicsAbsI32(dy)
    if overlapX <= overlapY:
        let sign = physicsSignNonZero(dx)
        let leftMove = (overlapX + 1) / 2
        let rightMove = overlapX / 2
        let _leftPosOk = ecs.EcsWorldSetPositionAt(world, left, leftX - sign * leftMove, leftY)
        let _rightPosOk = ecs.EcsWorldSetPositionAt(world, right, rightX + sign * rightMove, rightY)
        let _leftVelOk = ecs.EcsWorldSetVelocityAt(world, left, rightVx, leftVy)
        let _rightVelOk = ecs.EcsWorldSetVelocityAt(world, right, leftVx, rightVy)
    else:
        let sign = physicsSignNonZero(dy)
        let leftMove = (overlapY + 1) / 2
        let rightMove = overlapY / 2
        let _leftPosOk = ecs.EcsWorldSetPositionAt(world, left, leftX, leftY - sign * leftMove)
        let _rightPosOk = ecs.EcsWorldSetPositionAt(world, right, rightX, rightY + sign * rightMove)
        let _leftVelOk = ecs.EcsWorldSetVelocityAt(world, left, leftVx, rightVy)
        let _rightVelOk = ecs.EcsWorldSetVelocityAt(world, right, rightVx, leftVy)
    return true

# Canonical step-receipt preimage. Every receipt field except receiptCid
# enters the preimage exactly once; the bound forces receipt is chained in
# by its own CID so the whole tick forms one hash chain (no parallel
# fingerprints).
@borrows
fn physics2dStepReceiptPreimage(receipt: Physics2dStepReceipt): str =
    var parts: str[]
    add(parts, Fmt"{receipt.schema}")
    add(parts, "|step|tick=")
    add(parts, strings.IntToStr(receipt.tick))
    add(parts, "|dt=")
    add(parts, strings.IntToStr(receipt.dtMs))
    add(parts, "|source=")
    add(parts, Fmt"{receipt.sourceWorldCid}")
    add(parts, "|result=")
    add(parts, Fmt"{receipt.resultWorldCid}")
    add(parts, "|contacts=")
    add(parts, strings.IntToStr(receipt.contactCount))
    add(parts, "|sep=")
    add(parts, strings.IntToStr(receipt.separationIterations))
    add(parts, "|status=")
    add(parts, strings.IntToStr(receipt.statusCode))
    add(parts, "|forces=")
    add(parts, Fmt"{receipt.forcesReceiptCid}")
    add(parts, "|trace=")
    add(parts, Fmt"{receipt.trace}")
    return strutil.Join(parts, "")

@borrows
fn physics2dStepReceiptCid(receipt: Physics2dStepReceipt): str =
    return strings.Sha256(physics2dStepReceiptPreimage(receipt))

fn Physics2dStep(world: var ecs.EcsWorld, tick: int32, dtMs: int32): Physics2dStepReceipt =
    var receipt: Physics2dStepReceipt
    receipt.schema = Physics2dSchema
    receipt.tick = tick
    receipt.dtMs = dtMs
    receipt.sourceWorldCid = ecs.EcsWorldCid(world)
    receipt.statusCode = Physics2dStatusOk
    receipt.forcesReceiptCid = ""
    receipt.trace = "physics2d:aabb:sequential-impulse"
    if !ecs.EcsWorldColumnsValid(world):
        receipt.statusCode = Physics2dStatusInvalidWorld
        receipt.resultWorldCid = receipt.sourceWorldCid
        receipt.receiptCid = physics2dStepReceiptCid(receipt)
        return receipt
    if !Physics2dWorldSupported(world):
        receipt.statusCode = Physics2dStatusUnsupportedCollider
        receipt.resultWorldCid = receipt.sourceWorldCid
        receipt.receiptCid = physics2dStepReceiptCid(receipt)
        return receipt
    ecs.EcsWorldStepKinematic(world, dtMs)
    for i in 0..<world.count:
        for j in i + 1..<world.count:
            if physics2dResolveAabbPair(world, i, j):
                receipt.contactCount = receipt.contactCount + 1
                receipt.separationIterations = receipt.separationIterations + 1
    receipt.resultWorldCid = ecs.EcsWorldCid(world)
    receipt.receiptCid = physics2dStepReceiptCid(receipt)
    return receipt

@borrows
fn Physics2dReceiptValid(receipt: Physics2dStepReceipt): bool =
    if receipt.statusCode <= 0:
        return false
    if receipt.schema != Physics2dSchema:
        return false
    if receipt.sourceWorldCid.len != Physics2dCidHexLen:
        return false
    if receipt.resultWorldCid.len != Physics2dCidHexLen:
        return false
    if receipt.receiptCid != physics2dStepReceiptCid(receipt):
        return false
    return true

# Binding consumes the whole forces receipt: a tampered or self-inconsistent
# forces receipt hard-fails here (let it crash), and the step receipt chains
# the forces receipt by its CID before its own CID is recomputed.
fn Physics2dReceiptBindForces(receipt: var Physics2dStepReceipt, forces: Physics2dForcesReceipt) =
    if !Physics2dForcesReceiptValid(forces):
        panic("physics2d: Physics2dReceiptBindForces rejected tampered forces receipt")
    if forces.tick != receipt.tick:
        panic("physics2d: Physics2dReceiptBindForces forces/step tick mismatch")
    if forces.dtMs != receipt.dtMs:
        panic("physics2d: Physics2dReceiptBindForces forces/step dt mismatch")
    receipt.forcesReceiptCid = forces.receiptCid
    receipt.receiptCid = physics2dStepReceiptCid(receipt)

fn Physics2dForcesConfigValid(cfg: Physics2dForcesConfig): bool =
    if cfg.dragDen <= 0:
        return false
    if cfg.dragNum < 0:
        return false
    if cfg.dragNum > cfg.dragDen:
        return false
    if cfg.splashRestDen <= 0:
        return false
    if cfg.splashRestNum < 0:
        return false
    if cfg.splashRestNum > cfg.splashRestDen:
        return false
    if cfg.splashJitterDen <= 0:
        return false
    if cfg.splashJitterNum < 0:
        return false
    if cfg.splashJitterNum > cfg.splashJitterDen:
        return false
    if cfg.inkDecayDen <= 0:
        return false
    if cfg.inkDecayNum < 0:
        return false
    if cfg.inkDecayNum >= cfg.inkDecayDen:
        return false
    return true

fn Physics2dApplyGravity(world: var ecs.EcsWorld, dtMs: int32, gravityY: int32): int32 =
    let deltaVy = (gravityY * dtMs) / 1000
    var applied: int32 = 0
    for i in 0..<world.count:
        let vx = ecs.EcsWorldVelocityXAt(world, i)
        let vy = ecs.EcsWorldVelocityYAt(world, i)
        let _ok = ecs.EcsWorldSetVelocityAt(world, i, vx, vy + deltaVy)
        applied = applied + 1
    return applied

fn Physics2dApplyDrag(world: var ecs.EcsWorld, dragNum: int32, dragDen: int32): int32 =
    var applied: int32 = 0
    for i in 0..<world.count:
        let vx = ecs.EcsWorldVelocityXAt(world, i)
        let vy = ecs.EcsWorldVelocityYAt(world, i)
        let _ok = ecs.EcsWorldSetVelocityAt(world, i, (vx * dragNum) / dragDen, (vy * dragNum) / dragDen)
        applied = applied + 1
    return applied

fn physics2dSplashEntity(world: var ecs.EcsWorld,
                         tick: int32,
                         index: int32,
                         floorY: int32,
                         restNum: int32,
                         restDen: int32,
                         jitterNum: int32,
                         jitterDen: int32): bool =
    if ecs.EcsWorldPositionYAt(world, index) < floorY:
        return false
    let vy = ecs.EcsWorldVelocityYAt(world, index)
    if vy <= 0:
        return false
    let vx = ecs.EcsWorldVelocityXAt(world, index)
    let posX = ecs.EcsWorldPositionXAt(world, index)
    let keptVy = (vy * restNum) / restDen
    let scaledVx = (vx * restNum) / restDen
    let dissipated = vy - keptVy
    let jitterSpan = (dissipated * jitterNum) / jitterDen
    var jitter: int32 = 0
    if jitterSpan > 0:
        var noise: int32 = 1009
        noise = physicsMixInt(noise, tick)
        noise = physicsMixInt(noise, ecs.EcsWorldEntityIdAt(world, index))
        noise = physicsMixInt(noise, vx)
        noise = physicsMixInt(noise, vy)
        jitter = noise % (jitterSpan + 1)
        if noise % 2 == 1:
            jitter = 0 - jitter
    let _posOk = ecs.EcsWorldSetPositionAt(world, index, posX, floorY)
    let _velOk = ecs.EcsWorldSetVelocityAt(world, index, scaledVx + jitter, 0 - keptVy)
    return true

fn Physics2dApplySplashImpulse(world: var ecs.EcsWorld,
                               tick: int32,
                               floorY: int32,
                               restNum: int32,
                               restDen: int32,
                               jitterNum: int32,
                               jitterDen: int32): int32 =
    var splashCount: int32 = 0
    for i in 0..<world.count:
        if physics2dSplashEntity(world, tick, i, floorY, restNum, restDen, jitterNum, jitterDen):
            splashCount = splashCount + 1
    return splashCount

fn Physics2dInkAlphaDecay(alpha: int32, cfg: Physics2dForcesConfig): int32 =
    if alpha <= 0:
        return 0
    return (alpha * cfg.inkDecayNum) / cfg.inkDecayDen

# Canonical forces-receipt preimage: every field except receiptCid enters
# exactly once (post-forces world CID included), same hash-chain discipline
# as the step receipt.
@borrows
fn physics2dForcesReceiptPreimage(receipt: Physics2dForcesReceipt): str =
    var parts: str[]
    add(parts, Fmt"{receipt.schema}")
    add(parts, "|forces|tick=")
    add(parts, strings.IntToStr(receipt.tick))
    add(parts, "|dt=")
    add(parts, strings.IntToStr(receipt.dtMs))
    add(parts, "|gravity=")
    add(parts, strings.IntToStr(receipt.gravityApplied))
    add(parts, "|drag=")
    add(parts, strings.IntToStr(receipt.dragApplied))
    add(parts, "|splash=")
    add(parts, strings.IntToStr(receipt.splashCount))
    add(parts, "|status=")
    add(parts, strings.IntToStr(receipt.statusCode))
    add(parts, "|world=")
    add(parts, Fmt"{receipt.worldCid}")
    add(parts, "|trace=")
    add(parts, Fmt"{receipt.trace}")
    return strutil.Join(parts, "")

@borrows
fn physics2dForcesReceiptCid(receipt: Physics2dForcesReceipt): str =
    return strings.Sha256(physics2dForcesReceiptPreimage(receipt))

fn Physics2dApplyForces(world: var ecs.EcsWorld, tick: int32, dtMs: int32, cfg: Physics2dForcesConfig): Physics2dForcesReceipt =
    var receipt: Physics2dForcesReceipt
    receipt.schema = Physics2dForcesSchema
    receipt.tick = tick
    receipt.dtMs = dtMs
    receipt.statusCode = Physics2dStatusOk
    receipt.trace = "physics2d:forces:gravity-drag-splash"
    if !ecs.EcsWorldColumnsValid(world):
        receipt.statusCode = Physics2dStatusInvalidWorld
        receipt.worldCid = ecs.EcsWorldCid(world)
        receipt.receiptCid = physics2dForcesReceiptCid(receipt)
        return receipt
    if !Physics2dForcesConfigValid(cfg):
        receipt.statusCode = Physics2dStatusInvalidForcesConfig
        receipt.worldCid = ecs.EcsWorldCid(world)
        receipt.receiptCid = physics2dForcesReceiptCid(receipt)
        return receipt
    receipt.gravityApplied = Physics2dApplyGravity(world, dtMs, cfg.gravityY)
    receipt.dragApplied = Physics2dApplyDrag(world, cfg.dragNum, cfg.dragDen)
    if cfg.splashEnabled != 0:
        receipt.splashCount = Physics2dApplySplashImpulse(world, tick, cfg.splashFloorY, cfg.splashRestNum, cfg.splashRestDen, cfg.splashJitterNum, cfg.splashJitterDen)
    receipt.worldCid = ecs.EcsWorldCid(world)
    receipt.receiptCid = physics2dForcesReceiptCid(receipt)
    return receipt

@borrows
fn Physics2dForcesReceiptValid(receipt: Physics2dForcesReceipt): bool =
    if receipt.statusCode <= 0:
        return false
    if receipt.schema != Physics2dForcesSchema:
        return false
    if receipt.worldCid.len != Physics2dCidHexLen:
        return false
    if receipt.receiptCid != physics2dForcesReceiptCid(receipt):
        return false
    return true
