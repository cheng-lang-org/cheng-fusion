# World3D: the unique submitted 3D world state (contract §2.2).
#
# Arena + SoA point-body world shared by semantics, dynamics and display.
# Pure-scalar float64/int32 columns only (ecs.cheng cold-backend constraints).
# Identity: world instance id + per-entity id/generation; a stale slot
# reference is rejected, generation overflow is rejected at spawn.
#
# State CID canonicalization: positions/lengths quantized to millimetres
# (roundFloat(x*1000) -> int64) so the preimage is a deterministic integer
# string; byte-identical states under one frozen build hash identically.
import std/rawbytes
import std/strings as strings
import std/strutils as strutil
import cheng/game/csg/numerics
import std/math as m

const
    World3dSchema = "cheng.game.world3d.v1"
    World3dMaxBodies = 64
    World3dMaxConstraints = 96
    World3dMaxWalls = 16
    World3dBodyStatic = 0
    World3dBodyDynamic = 1
    World3dBodyRope = 2
    World3dBodyAnchor = 3
    # Rigid sphere with rotational dynamics (solid sphere, I = 2/5 m r^2).
    # The angular-velocity columns only join the CID preimage when at
    # least one body of this kind exists, so worlds without rigid balls
    # keep the byte-exact preimage (and chainCid) of the pre-ball schema.
    World3dBodyBallRigid = 4
    # Rigid capsule with full pose (unit quaternion) and principal
    # moments of a uniform solid capsule (local +Z axis). The pose and
    # angular columns join the CID preimage only when at least one body
    # of this kind exists, so worlds without capsules keep the byte-exact
    # preimage (and chainCid) of the pre-capsule schema.
    World3dBodyCapsuleRigid = 5
    World3dConRopeSegment = 1
    World3dConJoint = 2
    World3dConGrasp = 3
    World3dConStepPull = 4
    World3dConDistMax = 5
    World3dConDistMin = 6
    # Point-mass <-> capsule spherical pin (3 coincident-anchor rows): the
    # point mass stays on the capsule local anchor (world = center + R*anchor).
    World3dConSpherePin = 7
    # Capsule-anchor <-> point distance servo (1 row); the commanded length
    # walks at a bounded per-tick rate (joint-motor / winch servo semantics).
    World3dConAnchorDist = 8
    # Torque-motorized hinge: the 5 hinge rows plus the C5 = theta - cmd
    # row, saturated by the DC double cap rate = min(omega0*dt, tauMax*dt^2/I).
    World3dConHingeServo = 9
    # Passive capsule-capsule hinge (5 scalar rows: 3 anchor + 2 axis).
    # Numbering note: the design doc reserved 6 for the hinge, but 6 is
    # already World3dConDistMin and the task assigns 7/8/9 to the mixed
    # joint kinds above, so the hinge takes the next free slot.
    World3dConHinge = 10
    World3dGenerationOverflow = 2147483647

type
    # Minimal local 3-vector used by the joint creation helpers.
    World3dVec3 =
        x: float64
        y: float64
        z: float64
    World3d =
        instanceId: int64
        count: int32
        nextEntityId: int32
        entityIds: int32[]
        generations: int32[]
        bodyPx: float64[]
        bodyPy: float64[]
        bodyPz: float64[]
        bodyVx: float64[]
        bodyVy: float64[]
        bodyVz: float64[]
        bodyInvMass: float64[]
        bodyRadius: float64[]
        bodyKind: int32[]
        bodyAngVx: float64[]
        bodyAngVy: float64[]
        bodyAngVz: float64[]
        # Capsule rigid pose (unit quaternion, world <- local) and the
        # body-frame principal moments of the uniform solid capsule
        # (Ixx = Iyy transverse, Izz axial). bodyCapsuleHalf is the
        # offset of each hemispherical cap center from the center of
        # mass along the local z axis. Non-capsule bodies carry the
        # identity quaternion and zeros.
        bodyQuatW: float64[]
        bodyQuatX: float64[]
        bodyQuatY: float64[]
        bodyQuatZ: float64[]
        bodyIxx: float64[]
        bodyIyy: float64[]
        bodyIzz: float64[]
        bodyCapsuleHalf: float64[]
        bodyFx: float64[]
        bodyFy: float64[]
        bodyFz: float64[]
        conCount: int32
        conA: int32[]
        conB: int32[]
        conRest: float64[]
        conKind: int32[]
        conActive: int32[]
        conTarget: float64[]
        # Joint extension columns, parallel to the constraint slots (only
        # kinds 7..10 consume them). Per the CID decision these live in the
        # conditional |joints= preimage section, never in |cons=: the motor
        # cmd/goal are evolving control state that decides later evolution,
        # so they must hash, while |cons= stays byte-identical (it hashes
        # conRest only). Anchors/axes/refs are local-frame; anchors map to
        # world through the body quaternion, axes/refs are unit vectors.
        conAnchAx: float64[]
        conAnchAy: float64[]
        conAnchAz: float64[]
        conAnchBx: float64[]
        conAnchBy: float64[]
        conAnchBz: float64[]
        conAxisAx: float64[]
        conAxisAy: float64[]
        conAxisAz: float64[]
        conAxisBx: float64[]
        conAxisBy: float64[]
        conAxisBz: float64[]
        conRefAx: float64[]
        conRefAy: float64[]
        conRefAz: float64[]
        conRefBx: float64[]
        conRefBy: float64[]
        conRefBz: float64[]
        # Servo state: cmd is the rate-capped command actually projected
        # (radians for the hinge servo, metres for the anchor distance),
        # goal is the controller target the cmd walks toward. Limits bound
        # the measured flexion angle; maxRate caps the distance servo walk
        # and tauMax/omega0 are the DC motor double cap of the hinge servo.
        conCmd: float64[]
        conGoal: float64[]
        conLimMin: float64[]
        conLimMax: float64[]
        conMaxRate: float64[]
        conTauMax: float64[]
        conOmega0: float64[]
        wallCount: int32
        wallCx: float64[]
        wallCy: float64[]
        wallCz: float64[]
        wallHx: float64[]
        wallHy: float64[]
        wallHz: float64[]
        wallFriction: float64[]
        ropeActive: int32
        ropeAnchorSlot: int32
        tick: int64

fn World3dReset(w: var World3d, instance: int64) =
    w.instanceId = instance
    w.count = 0
    w.nextEntityId = 1
    w.conCount = 0
    w.wallCount = 0
    w.ropeActive = 0
    w.ropeAnchorSlot = -1
    w.tick = int64(0)
    setLen(w.entityIds, 0)
    setLen(w.generations, 0)
    setLen(w.bodyPx, 0)
    setLen(w.bodyPy, 0)
    setLen(w.bodyPz, 0)
    setLen(w.bodyVx, 0)
    setLen(w.bodyVy, 0)
    setLen(w.bodyVz, 0)
    setLen(w.bodyInvMass, 0)
    setLen(w.bodyRadius, 0)
    setLen(w.bodyKind, 0)
    setLen(w.bodyAngVx, 0)
    setLen(w.bodyAngVy, 0)
    setLen(w.bodyAngVz, 0)
    setLen(w.bodyQuatW, 0)
    setLen(w.bodyQuatX, 0)
    setLen(w.bodyQuatY, 0)
    setLen(w.bodyQuatZ, 0)
    setLen(w.bodyIxx, 0)
    setLen(w.bodyIyy, 0)
    setLen(w.bodyIzz, 0)
    setLen(w.bodyCapsuleHalf, 0)
    setLen(w.bodyFx, 0)
    setLen(w.bodyFy, 0)
    setLen(w.bodyFz, 0)
    setLen(w.conA, 0)
    setLen(w.conB, 0)
    setLen(w.conRest, 0)
    setLen(w.conKind, 0)
    setLen(w.conActive, 0)
    setLen(w.conTarget, 0)
    setLen(w.conAnchAx, 0)
    setLen(w.conAnchAy, 0)
    setLen(w.conAnchAz, 0)
    setLen(w.conAnchBx, 0)
    setLen(w.conAnchBy, 0)
    setLen(w.conAnchBz, 0)
    setLen(w.conAxisAx, 0)
    setLen(w.conAxisAy, 0)
    setLen(w.conAxisAz, 0)
    setLen(w.conAxisBx, 0)
    setLen(w.conAxisBy, 0)
    setLen(w.conAxisBz, 0)
    setLen(w.conRefAx, 0)
    setLen(w.conRefAy, 0)
    setLen(w.conRefAz, 0)
    setLen(w.conRefBx, 0)
    setLen(w.conRefBy, 0)
    setLen(w.conRefBz, 0)
    setLen(w.conCmd, 0)
    setLen(w.conGoal, 0)
    setLen(w.conLimMin, 0)
    setLen(w.conLimMax, 0)
    setLen(w.conMaxRate, 0)
    setLen(w.conTauMax, 0)
    setLen(w.conOmega0, 0)
    setLen(w.wallCx, 0)
    setLen(w.wallCy, 0)
    setLen(w.wallCz, 0)
    setLen(w.wallHx, 0)
    setLen(w.wallHy, 0)
    setLen(w.wallHz, 0)
    setLen(w.wallFriction, 0)
    while w.entityIds.len < World3dMaxBodies:
        add(w.entityIds, 0)
        add(w.generations, 0)
        add(w.bodyPx, 0.0)
        add(w.bodyPy, 0.0)
        add(w.bodyPz, 0.0)
        add(w.bodyVx, 0.0)
        add(w.bodyVy, 0.0)
        add(w.bodyVz, 0.0)
        add(w.bodyInvMass, 0.0)
        add(w.bodyRadius, 0.0)
        add(w.bodyKind, World3dBodyStatic)
        add(w.bodyAngVx, 0.0)
        add(w.bodyAngVy, 0.0)
        add(w.bodyAngVz, 0.0)
        add(w.bodyQuatW, 1.0)
        add(w.bodyQuatX, 0.0)
        add(w.bodyQuatY, 0.0)
        add(w.bodyQuatZ, 0.0)
        add(w.bodyIxx, 0.0)
        add(w.bodyIyy, 0.0)
        add(w.bodyIzz, 0.0)
        add(w.bodyCapsuleHalf, 0.0)
        add(w.bodyFx, 0.0)
        add(w.bodyFy, 0.0)
        add(w.bodyFz, 0.0)
    while w.conA.len < World3dMaxConstraints:
        add(w.conA, -1)
        add(w.conB, -1)
        add(w.conRest, 0.0)
        add(w.conKind, 0)
        add(w.conActive, 0)
        add(w.conTarget, 0.0)
        add(w.conAnchAx, 0.0)
        add(w.conAnchAy, 0.0)
        add(w.conAnchAz, 0.0)
        add(w.conAnchBx, 0.0)
        add(w.conAnchBy, 0.0)
        add(w.conAnchBz, 0.0)
        add(w.conAxisAx, 0.0)
        add(w.conAxisAy, 0.0)
        add(w.conAxisAz, 0.0)
        add(w.conAxisBx, 0.0)
        add(w.conAxisBy, 0.0)
        add(w.conAxisBz, 0.0)
        add(w.conRefAx, 0.0)
        add(w.conRefAy, 0.0)
        add(w.conRefAz, 0.0)
        add(w.conRefBx, 0.0)
        add(w.conRefBy, 0.0)
        add(w.conRefBz, 0.0)
        add(w.conCmd, 0.0)
        add(w.conGoal, 0.0)
        add(w.conLimMin, 0.0)
        add(w.conLimMax, 0.0)
        add(w.conMaxRate, 0.0)
        add(w.conTauMax, 0.0)
        add(w.conOmega0, 0.0)
    while w.wallCx.len < World3dMaxWalls:
        add(w.wallCx, 0.0)
        add(w.wallCy, 0.0)
        add(w.wallCz, 0.0)
        add(w.wallHx, 0.0)
        add(w.wallHy, 0.0)
        add(w.wallHz, 0.0)
        add(w.wallFriction, 0.0)

fn World3dSpawnBody(w: var World3d,
                    px: float64,
                    py: float64,
                    pz: float64,
                    mass: float64,
                    radius: float64,
                    kind: int32): int32 =
    if w.count >= World3dMaxBodies:
        panic("world3d: body capacity exceeded")
    if w.nextEntityId >= World3dGenerationOverflow:
        panic("world3d: entity id generation overflow")
    let slot = w.count
    let entityId = w.nextEntityId
    w.entityIds[slot] = entityId
    w.generations[slot] = 1
    w.bodyPx[slot] = px
    w.bodyPy[slot] = py
    w.bodyPz[slot] = pz
    w.bodyVx[slot] = 0.0
    w.bodyVy[slot] = 0.0
    w.bodyVz[slot] = 0.0
    if mass > 0.0:
        w.bodyInvMass[slot] = 1.0 / mass
    else:
        w.bodyInvMass[slot] = 0.0
    w.bodyRadius[slot] = radius
    w.bodyKind[slot] = kind
    w.bodyAngVx[slot] = 0.0
    w.bodyAngVy[slot] = 0.0
    w.bodyAngVz[slot] = 0.0
    w.bodyQuatW[slot] = 1.0
    w.bodyQuatX[slot] = 0.0
    w.bodyQuatY[slot] = 0.0
    w.bodyQuatZ[slot] = 0.0
    w.bodyIxx[slot] = 0.0
    w.bodyIyy[slot] = 0.0
    w.bodyIzz[slot] = 0.0
    w.bodyCapsuleHalf[slot] = 0.0
    w.nextEntityId = w.nextEntityId + 1
    w.count = w.count + 1
    w.bodyFx[slot] = 0.0
    w.bodyFy[slot] = 0.0
    w.bodyFz[slot] = 0.0
    return slot

# Capsule rigid body: uniform solid capsule (cylinder of half length
# `halfLen` along the local z axis closed by two hemispheres of the given
# radius), quaternion pose with the capsule axis on local +Z. The input
# quaternion is normalized so sloppy caller input can never poison the
# rotation integrator. Principal moments about the center of mass
# (cylinder share mc over Vc = pi r^2 2h, cap share ms over the one-sphere
# volume Vs = 4/3 pi r^3, uniform density):
#   Izz (axial)     = mc r^2/2 + ms (2/5) r^2
#   Ixx = Iyy (trv) = mc (r^2/4 + h^2/3) + ms ((83/320) r^2 + h^2)
# World-frame angular velocity rides the shared bodyAngV columns.
fn World3dSpawnCapsule(w: var World3d,
                       px: float64,
                       py: float64,
                       pz: float64,
                       mass: float64,
                       radius: float64,
                       halfLen: float64,
                       qw: float64,
                       qx: float64,
                       qy: float64,
                       qz: float64): int32 =
    let slot = World3dSpawnBody(w, px, py, pz, mass, radius, World3dBodyCapsuleRigid)
    let qn = numerics.CsgSqrt(qw * qw + qx * qx + qy * qy + qz * qz)
    if qn > 0.0:
        w.bodyQuatW[slot] = qw / qn
        w.bodyQuatX[slot] = qx / qn
        w.bodyQuatY[slot] = qy / qn
        w.bodyQuatZ[slot] = qz / qn
    else:
        w.bodyQuatW[slot] = 1.0
    let vc = 3.14159265358979 * radius * radius * (2.0 * halfLen)
    let vs = 4.18879020478639 * radius * radius * radius
    let mc = mass * vc / (vc + vs)
    let ms = mass * vs / (vc + vs)
    w.bodyIxx[slot] = mc * (radius * radius * 0.25 + halfLen * halfLen / 3.0) + ms * (0.259375 * radius * radius + halfLen * halfLen)
    w.bodyIyy[slot] = w.bodyIxx[slot]
    w.bodyIzz[slot] = mc * radius * radius * 0.5 + ms * 0.4 * radius * radius
    w.bodyCapsuleHalf[slot] = halfLen
    return slot

fn World3dAddConstraint(w: var World3d,
                        aSlot: int32,
                        bSlot: int32,
                        rest: float64,
                        kind: int32): int32 =
    if w.conCount >= World3dMaxConstraints:
        panic("world3d: constraint capacity exceeded")
    if aSlot < 0 || aSlot >= w.count || bSlot < 0 || bSlot >= w.count:
        panic("world3d: constraint slot out of range")
    let idx = w.conCount
    w.conA[idx] = aSlot
    w.conB[idx] = bSlot
    w.conRest[idx] = rest
    w.conTarget[idx] = rest
    w.conKind[idx] = kind
    w.conActive[idx] = 1
    w.conCount = w.conCount + 1
    return idx

fn World3dAddWall(w: var World3d,
                  cx: float64,
                  cy: float64,
                  cz: float64,
                  hx: float64,
                  hy: float64,
                  hz: float64,
                  friction: float64) =
    if w.wallCount >= World3dMaxWalls:
        panic("world3d: wall capacity exceeded")
    let idx = w.wallCount
    w.wallCx[idx] = cx
    w.wallCy[idx] = cy
    w.wallCz[idx] = cz
    w.wallHx[idx] = hx
    w.wallHy[idx] = hy
    w.wallHz[idx] = hz
    w.wallFriction[idx] = friction
    w.wallCount = w.wallCount + 1

# --- Joint creation helpers (kinds 7..10) ---

fn world3dVec3(vx: float64, vy: float64, vz: float64): World3dVec3 =
    var v: World3dVec3
    v.x = vx
    v.y = vy
    v.z = vz
    return v

# Image of a body-local vector under the body rotation (unit quaternion):
# v' = v + qw t + qv x t with t = 2 qv x v.
fn world3dQuatRotVec(qw: float64, qx: float64, qy: float64, qz: float64, v: World3dVec3): World3dVec3 =
    let tx = 2.0 * (qy * v.z - qz * v.y)
    let ty = 2.0 * (qz * v.x - qx * v.z)
    let tz = 2.0 * (qx * v.y - qy * v.x)
    let ux = qy * tz - qz * ty
    let uy = qz * tx - qx * tz
    let uz = qx * ty - qy * tx
    return world3dVec3(v.x + qw * tx + ux, v.y + qw * ty + uy, v.z + qw * tz + uz)

# World position of a body-local anchor point (center + R * local).
@borrows
fn World3dBodyAnchorWorld(w: World3d, slot: int32, lx: float64, ly: float64, lz: float64): World3dVec3 =
    let loc = world3dQuatRotVec(w.bodyQuatW[slot], w.bodyQuatX[slot], w.bodyQuatY[slot], w.bodyQuatZ[slot], world3dVec3(lx, ly, lz))
    return world3dVec3(w.bodyPx[slot] + loc.x, w.bodyPy[slot] + loc.y, w.bodyPz[slot] + loc.z)

# Spherical pin (kind 7): the point mass (conB) stays coincident with the
# capsule local anchor (conA). The point side carries no angular term; the
# capsule side gets the full generalized-mass block in the projection.
fn World3dAddSpherePin(w: var World3d, capSlot: int32, pointSlot: int32, lx: float64, ly: float64, lz: float64): int32 =
    if w.bodyKind[capSlot] != World3dBodyCapsuleRigid:
        panic("world3d: sphere pin needs a capsule body")
    let ci = World3dAddConstraint(w, capSlot, pointSlot, 0.0, World3dConSpherePin)
    w.conAnchAx[ci] = lx
    w.conAnchAy[ci] = ly
    w.conAnchAz[ci] = lz
    return ci

# Anchor distance servo (kind 8): servo the distance between the capsule
# local anchor (conA) and the point body (conB). The command is parked at
# the current distance so creation never injects a step change.
fn World3dAddAnchorDist(w: var World3d, capSlot: int32, pointSlot: int32, lx: float64, ly: float64, lz: float64, maxRate: float64): int32 =
    if w.bodyKind[capSlot] != World3dBodyCapsuleRigid:
        panic("world3d: anchor distance needs a capsule body")
    let ci = World3dAddConstraint(w, capSlot, pointSlot, 0.0, World3dConAnchorDist)
    w.conAnchAx[ci] = lx
    w.conAnchAy[ci] = ly
    w.conAnchAz[ci] = lz
    w.conMaxRate[ci] = maxRate
    let anch = World3dBodyAnchorWorld(w, capSlot, lx, ly, lz)
    let dx = w.bodyPx[pointSlot] - anch.x
    let dy = w.bodyPy[pointSlot] - anch.y
    let dz = w.bodyPz[pointSlot] - anch.z
    let d0 = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
    w.conCmd[ci] = d0
    w.conGoal[ci] = d0
    return ci

# Capsule-capsule hinge (kinds 9 servo / 10 passive): both bodies carry a
# local anchor (creation-validated to coincide within 1 mm) and a local
# hinge axis (creation-validated parallel, stored normalized). The flexion
# reference vectors are set afterwards by World3dSetHingeRefs.
fn World3dAddHingeJoint(w: var World3d, aSlot: int32, bSlot: int32, kind: int32, anchAx: float64, anchAy: float64, anchAz: float64, anchBx: float64, anchBy: float64, anchBz: float64, axisAx: float64, axisAy: float64, axisAz: float64, axisBx: float64, axisBy: float64, axisBz: float64): int32 =
    if kind != World3dConHinge:
        if kind != World3dConHingeServo:
            panic("world3d: hinge joint kind must be 9 or 10")
    if w.bodyKind[aSlot] != World3dBodyCapsuleRigid:
        panic("world3d: hinge needs capsule bodies")
    if w.bodyKind[bSlot] != World3dBodyCapsuleRigid:
        panic("world3d: hinge needs capsule bodies")
    let naLen = numerics.CsgSqrt(axisAx * axisAx + axisAy * axisAy + axisAz * axisAz)
    if naLen <= 0.0:
        panic("world3d: hinge axis must be nonzero")
    let nbLen = numerics.CsgSqrt(axisBx * axisBx + axisBy * axisBy + axisBz * axisBz)
    if nbLen <= 0.0:
        panic("world3d: hinge axis must be nonzero")
    let anchA = World3dBodyAnchorWorld(w, aSlot, anchAx, anchAy, anchAz)
    let anchB = World3dBodyAnchorWorld(w, bSlot, anchBx, anchBy, anchBz)
    let gx = anchA.x - anchB.x
    let gy = anchA.y - anchB.y
    let gz = anchA.z - anchB.z
    let gap = numerics.CsgSqrt(gx * gx + gy * gy + gz * gz)
    if gap > 0.001:
        panic("world3d: hinge anchors must coincide at creation")
    let na = world3dVec3(axisAx / naLen, axisAy / naLen, axisAz / naLen)
    let nb = world3dVec3(axisBx / nbLen, axisBy / nbLen, axisBz / nbLen)
    let dot = na.x * nb.x + na.y * nb.y + na.z * nb.z
    if dot < 0.999:
        panic("world3d: hinge axes must be parallel at creation")
    let ci = World3dAddConstraint(w, aSlot, bSlot, 0.0, kind)
    w.conAnchAx[ci] = anchAx
    w.conAnchAy[ci] = anchAy
    w.conAnchAz[ci] = anchAz
    w.conAnchBx[ci] = anchBx
    w.conAnchBy[ci] = anchBy
    w.conAnchBz[ci] = anchBz
    w.conAxisAx[ci] = na.x
    w.conAxisAy[ci] = na.y
    w.conAxisAz[ci] = na.z
    w.conAxisBx[ci] = nb.x
    w.conAxisBy[ci] = nb.y
    w.conAxisBz[ci] = nb.z
    return ci

# Flexion reference vectors of the hinge: Gram-Schmidt against the stored
# axes, normalized; creation panics on a reference parallel to its axis so
# the angle measurement can never degenerate silently.
fn World3dSetHingeRefs(w: var World3d, ci: int32, refAx: float64, refAy: float64, refAz: float64, refBx: float64, refBy: float64, refBz: float64) =
    let k = w.conKind[ci]
    if k != World3dConHinge:
        if k != World3dConHingeServo:
            panic("world3d: hinge refs need a hinge constraint")
    let dotA = refAx * w.conAxisAx[ci] + refAy * w.conAxisAy[ci] + refAz * w.conAxisAz[ci]
    let pax = refAx - dotA * w.conAxisAx[ci]
    let pay = refAy - dotA * w.conAxisAy[ci]
    let paz = refAz - dotA * w.conAxisAz[ci]
    let paLen = numerics.CsgSqrt(pax * pax + pay * pay + paz * paz)
    if paLen < 0.000001:
        panic("world3d: hinge ref A parallel to axis")
    let dotB = refBx * w.conAxisBx[ci] + refBy * w.conAxisBy[ci] + refBz * w.conAxisBz[ci]
    let pbx = refBx - dotB * w.conAxisBx[ci]
    let pby = refBy - dotB * w.conAxisBy[ci]
    let pbz = refBz - dotB * w.conAxisBz[ci]
    let pbLen = numerics.CsgSqrt(pbx * pbx + pby * pby + pbz * pbz)
    if pbLen < 0.000001:
        panic("world3d: hinge ref B parallel to axis")
    w.conRefAx[ci] = pax / paLen
    w.conRefAy[ci] = pay / paLen
    w.conRefAz[ci] = paz / paLen
    w.conRefBx[ci] = pbx / pbLen
    w.conRefBy[ci] = pby / pbLen
    w.conRefBz[ci] = pbz / pbLen

# DC motor double cap plus passive flexion limits for a hinge servo.
# Angles in radians; limMin == limMax disables the passive limit.
fn World3dSetHingeServo(w: var World3d, ci: int32, tauMax: float64, omega0: float64, limMin: float64, limMax: float64) =
    let k = w.conKind[ci]
    if k != World3dConHingeServo:
        if k != World3dConHinge:
            panic("world3d: servo params need a hinge constraint")
    w.conTauMax[ci] = tauMax
    w.conOmega0[ci] = omega0
    w.conLimMin[ci] = limMin
    w.conLimMax[ci] = limMax

# Live slot reference check: slot in range, entity alive, generation must
# match the recorded one — stale references are rejected explicitly.
@borrows
fn World3dSlotLive(w: World3d, slot: int32, generation: int32): bool =
    if slot < 0:
        return false
    if slot >= w.count:
        return false
    if w.generations[slot] != generation:
        return false
    return true

@borrows
fn World3dEntityIdAt(w: World3d, slot: int32): int32 =
    if slot < 0 || slot >= w.count:
        return -1
    return w.entityIds[slot]

# Rope tension path: a grasp on `slot` counts as held only while the rope
# chain from the grasped node up to the anchor is fully active. Walks
# rope-segment constraints, not names or proximity (contract §2.2).
@borrows
fn World3dRopePathToAnchor(w: World3d, slot: int32): bool =
    if w.ropeActive == 0:
        return false
    if w.ropeAnchorSlot < 0:
        return false
    var current = slot
    var hops: int32 = 0
    while current != w.ropeAnchorSlot:
        if hops >= World3dMaxConstraints:
            return false
        var found: int32 = -1
        var ci: int32 = 0
        while ci < w.conCount:
            if w.conActive[ci] == 1 && w.conKind[ci] == World3dConRopeSegment:
                if w.conA[ci] == current:
                    found = w.conB[ci]
                if w.conB[ci] == current:
                    found = w.conA[ci]
                if found >= 0:
                    if w.bodyKind[found] != World3dBodyRope && found != w.ropeAnchorSlot:
                        found = -1
            if found >= 0:
                break
            ci = ci + 1
        if found < 0:
            return false
        current = found
        hops = hops + 1
    return true

# Deep copy: the checkpoint snapshot used to derive intervention films
# (E2). Same-instance clone keeps identity columns verbatim.
@borrows
fn World3dClone(w: World3d): World3d =
    var out: World3d
    World3dReset(out, w.instanceId)
    out.nextEntityId = w.nextEntityId
    out.count = w.count
    out.conCount = w.conCount
    out.wallCount = w.wallCount
    out.ropeActive = w.ropeActive
    out.ropeAnchorSlot = w.ropeAnchorSlot
    out.tick = w.tick
    var i: int32 = 0
    while i < w.count:
        out.entityIds[i] = w.entityIds[i]
        out.generations[i] = w.generations[i]
        out.bodyPx[i] = w.bodyPx[i]
        out.bodyPy[i] = w.bodyPy[i]
        out.bodyPz[i] = w.bodyPz[i]
        out.bodyVx[i] = w.bodyVx[i]
        out.bodyVy[i] = w.bodyVy[i]
        out.bodyVz[i] = w.bodyVz[i]
        out.bodyInvMass[i] = w.bodyInvMass[i]
        out.bodyRadius[i] = w.bodyRadius[i]
        out.bodyKind[i] = w.bodyKind[i]
        out.bodyAngVx[i] = w.bodyAngVx[i]
        out.bodyAngVy[i] = w.bodyAngVy[i]
        out.bodyAngVz[i] = w.bodyAngVz[i]
        out.bodyQuatW[i] = w.bodyQuatW[i]
        out.bodyQuatX[i] = w.bodyQuatX[i]
        out.bodyQuatY[i] = w.bodyQuatY[i]
        out.bodyQuatZ[i] = w.bodyQuatZ[i]
        out.bodyIxx[i] = w.bodyIxx[i]
        out.bodyIyy[i] = w.bodyIyy[i]
        out.bodyIzz[i] = w.bodyIzz[i]
        out.bodyCapsuleHalf[i] = w.bodyCapsuleHalf[i]
        out.bodyFx[i] = 0.0
        out.bodyFy[i] = 0.0
        out.bodyFz[i] = 0.0
        i = i + 1
    i = 0
    while i < w.conCount:
        out.conA[i] = w.conA[i]
        out.conB[i] = w.conB[i]
        out.conRest[i] = w.conRest[i]
        out.conKind[i] = w.conKind[i]
        out.conActive[i] = w.conActive[i]
        out.conTarget[i] = w.conTarget[i]
        out.conAnchAx[i] = w.conAnchAx[i]
        out.conAnchAy[i] = w.conAnchAy[i]
        out.conAnchAz[i] = w.conAnchAz[i]
        out.conAnchBx[i] = w.conAnchBx[i]
        out.conAnchBy[i] = w.conAnchBy[i]
        out.conAnchBz[i] = w.conAnchBz[i]
        out.conAxisAx[i] = w.conAxisAx[i]
        out.conAxisAy[i] = w.conAxisAy[i]
        out.conAxisAz[i] = w.conAxisAz[i]
        out.conAxisBx[i] = w.conAxisBx[i]
        out.conAxisBy[i] = w.conAxisBy[i]
        out.conAxisBz[i] = w.conAxisBz[i]
        out.conRefAx[i] = w.conRefAx[i]
        out.conRefAy[i] = w.conRefAy[i]
        out.conRefAz[i] = w.conRefAz[i]
        out.conRefBx[i] = w.conRefBx[i]
        out.conRefBy[i] = w.conRefBy[i]
        out.conRefBz[i] = w.conRefBz[i]
        out.conCmd[i] = w.conCmd[i]
        out.conGoal[i] = w.conGoal[i]
        out.conLimMin[i] = w.conLimMin[i]
        out.conLimMax[i] = w.conLimMax[i]
        out.conMaxRate[i] = w.conMaxRate[i]
        out.conTauMax[i] = w.conTauMax[i]
        out.conOmega0[i] = w.conOmega0[i]
        i = i + 1
    i = 0
    while i < w.wallCount:
        out.wallCx[i] = w.wallCx[i]
        out.wallCy[i] = w.wallCy[i]
        out.wallCz[i] = w.wallCz[i]
        out.wallHx[i] = w.wallHx[i]
        out.wallHy[i] = w.wallHy[i]
        out.wallHz[i] = w.wallHz[i]
        out.wallFriction[i] = w.wallFriction[i]
        i = i + 1
    return out

@borrows
fn World3dComZ(w: World3d): float64 =
    var massSum: float64 = 0.0
    var weighted: float64 = 0.0
    var i: int32 = 0
    while i < w.count:
        if w.bodyInvMass[i] > 0.0:
            let massKg = 1.0 / w.bodyInvMass[i]
            massSum = massSum + massKg
            weighted = weighted + massKg * w.bodyPz[i]
        i = i + 1
    if massSum <= 0.0:
        return 0.0
    return weighted / massSum

# Solid-sphere moment of inertia about any diameter: I = 2/5 m r^2.
# Caller must guarantee kind == World3dBodyBallRigid and invMass > 0.
@borrows
fn World3dBallInertia(w: World3d, slot: int32): float64 =
    let massKg = 1.0 / w.bodyInvMass[slot]
    return 0.4 * massKg * w.bodyRadius[slot] * w.bodyRadius[slot]

# Canonical CID preimage, emitted byte-for-byte identically to the
# established str[] + Join shape but straight into one reusable byte
# builder: the fragment-string version allocated ~15 strs per body per
# tick (twice per physics step) and the ORC release storm dominated the
# tick profile (sample 2026-09-08). The CIDs are unchanged byte-for-byte;
# the build_ascent chainCid is the hard gate.

@borrows
fn World3dCidAppendLit(b: var rawbytes.BytesBuilder, s: str) =
    var i: int32 = 0
    while i < s.len:
        rawbytes.BytesBuilderAppendByte(b, int32(s[i]))
        i = i + 1

@borrows
fn World3dCidAppendI64(b: var rawbytes.BytesBuilder, v: int64) =
    var mag: int64 = v
    if v < 0:
        rawbytes.BytesBuilderAppendByte(b, 45)
        mag = -mag
    if mag == 0:
        rawbytes.BytesBuilderAppendByte(b, 48)
        return
    var pw: int64 = 1
    while mag / (pw * 10) > 0:
        pw = pw * 10
    while pw > 0:
        let d: int32 = int32(mag / pw)
        rawbytes.BytesBuilderAppendByte(b, 48 + d)
        mag = mag - d * pw
        pw = pw / 10

# Shared micro-unit quantizer used by every scaled CID field (the callers
# pre-scale by 1000 exactly like the position columns do).
@borrows
fn World3dCidAppendMilli(b: var rawbytes.BytesBuilder, v: float64) =
    World3dCidAppendI64(b, numerics.CsgQuantMm(v * 1000.0))

@borrows
fn World3dCanonicalPreimage(w: World3d): str =
    var b: rawbytes.BytesBuilder = rawbytes.BytesBuilderNew(8192)
    World3dCidAppendLit(b, World3dSchema)
    World3dCidAppendLit(b, "|inst=")
    World3dCidAppendI64(b, w.instanceId)
    World3dCidAppendLit(b, "|tick=")
    World3dCidAppendI64(b, w.tick)
    World3dCidAppendLit(b, "|next=")
    World3dCidAppendI64(b, w.nextEntityId)
    World3dCidAppendLit(b, "|count=")
    World3dCidAppendI64(b, w.count)
    World3dCidAppendLit(b, "|rope=")
    World3dCidAppendI64(b, w.ropeActive)
    World3dCidAppendLit(b, "|anchor=")
    World3dCidAppendI64(b, w.ropeAnchorSlot)
    var i: int32 = 0
    while i < w.count:
        let pxMm: int64 = numerics.CsgQuantMm(w.bodyPx[i] * 1000.0)
        let pyMm: int64 = numerics.CsgQuantMm(w.bodyPy[i] * 1000.0)
        let pzMm: int64 = numerics.CsgQuantMm(w.bodyPz[i] * 1000.0)
        let vxMm: int64 = numerics.CsgQuantMm(w.bodyVx[i] * 1000.0)
        let vyMm: int64 = numerics.CsgQuantMm(w.bodyVy[i] * 1000.0)
        let vzMm: int64 = numerics.CsgQuantMm(w.bodyVz[i] * 1000.0)
        World3dCidAppendLit(b, "|b")
        World3dCidAppendI64(b, i)
        World3dCidAppendLit(b, ":")
        World3dCidAppendI64(b, w.entityIds[i])
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, w.generations[i])
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, w.bodyKind[i])
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, pxMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, pyMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, pzMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, vxMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, vyMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, vzMm)
        i = i + 1
    World3dCidAppendLit(b, "|cons=")
    World3dCidAppendI64(b, w.conCount)
    i = 0
    while i < w.conCount:
        let restMm: int64 = numerics.CsgQuantMm(w.conRest[i] * 1000.0)
        World3dCidAppendLit(b, "|c")
        World3dCidAppendI64(b, i)
        World3dCidAppendLit(b, ":")
        World3dCidAppendI64(b, w.conA[i])
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, w.conB[i])
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, w.conKind[i])
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, w.conActive[i])
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, restMm)
        i = i + 1
    World3dCidAppendLit(b, "|walls=")
    World3dCidAppendI64(b, w.wallCount)
    i = 0
    while i < w.wallCount:
        let cxMm: int64 = numerics.CsgQuantMm(w.wallCx[i] * 1000.0)
        let cyMm: int64 = numerics.CsgQuantMm(w.wallCy[i] * 1000.0)
        let czMm: int64 = numerics.CsgQuantMm(w.wallCz[i] * 1000.0)
        let hxMm: int64 = numerics.CsgQuantMm(w.wallHx[i] * 1000.0)
        let hyMm: int64 = numerics.CsgQuantMm(w.wallHy[i] * 1000.0)
        let hzMm: int64 = numerics.CsgQuantMm(w.wallHz[i] * 1000.0)
        World3dCidAppendLit(b, "|w")
        World3dCidAppendI64(b, i)
        World3dCidAppendLit(b, ":")
        World3dCidAppendI64(b, cxMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, cyMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, czMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, hxMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, hyMm)
        World3dCidAppendLit(b, ",")
        World3dCidAppendI64(b, hzMm)
        i = i + 1
    # Conditional rigid-ball angular segment: emitted only when at least
    # one World3dBodyBallRigid body exists, appended after the walls
    # section. Worlds without rigid balls append zero bytes, so their
    # preimage (and every CID derived from it) stays byte-identical to
    # the pre-ball schema. Angular velocities ride the same quantizer as
    # the linear columns (milli-unit integers).
    var ballCount: int32 = 0
    i = 0
    while i < w.count:
        if w.bodyKind[i] == World3dBodyBallRigid:
            ballCount = ballCount + 1
        i = i + 1
    if ballCount > 0:
        World3dCidAppendLit(b, "|balls=")
        World3dCidAppendI64(b, ballCount)
        i = 0
        while i < w.count:
            if w.bodyKind[i] == World3dBodyBallRigid:
                let wxMm: int64 = numerics.CsgQuantMm(w.bodyAngVx[i] * 1000.0)
                let wyMm: int64 = numerics.CsgQuantMm(w.bodyAngVy[i] * 1000.0)
                let wzMm: int64 = numerics.CsgQuantMm(w.bodyAngVz[i] * 1000.0)
                World3dCidAppendLit(b, "|ball")
                World3dCidAppendI64(b, i)
                World3dCidAppendLit(b, ":")
                World3dCidAppendI64(b, wxMm)
                World3dCidAppendLit(b, ",")
                World3dCidAppendI64(b, wyMm)
                World3dCidAppendLit(b, ",")
                World3dCidAppendI64(b, wzMm)
            i = i + 1
    # Conditional capsule pose segment: emitted only when at least one
    # World3dBodyCapsuleRigid exists, appended after the balls section.
    # The pose (unit quaternion) plus world angular velocity identify the
    # full rigid state beyond the shared center columns. Worlds without
    # capsules append zero bytes, so their preimage (and every CID
    # derived from it) stays byte-identical to the pre-capsule schema.
    # Principal moments and half length are spawn-time geometry exactly
    # like bodyRadius — not part of the state CID (same cut as balls).
    var capCount: int32 = 0
    i = 0
    while i < w.count:
        if w.bodyKind[i] == World3dBodyCapsuleRigid:
            capCount = capCount + 1
        i = i + 1
    if capCount > 0:
        World3dCidAppendLit(b, "|caps=")
        World3dCidAppendI64(b, capCount)
        i = 0
        while i < w.count:
            if w.bodyKind[i] == World3dBodyCapsuleRigid:
                let qwMm: int64 = numerics.CsgQuantMm(w.bodyQuatW[i] * 1000.0)
                let qxMm: int64 = numerics.CsgQuantMm(w.bodyQuatX[i] * 1000.0)
                let qyMm: int64 = numerics.CsgQuantMm(w.bodyQuatY[i] * 1000.0)
                let qzMm: int64 = numerics.CsgQuantMm(w.bodyQuatZ[i] * 1000.0)
                let cwzMm: int64 = numerics.CsgQuantMm(w.bodyAngVx[i] * 1000.0)
                let cwyMm: int64 = numerics.CsgQuantMm(w.bodyAngVy[i] * 1000.0)
                let cwzMm: int64 = numerics.CsgQuantMm(w.bodyAngVz[i] * 1000.0)
                World3dCidAppendLit(b, "|cap")
                World3dCidAppendI64(b, i)
                World3dCidAppendLit(b, ":")
                World3dCidAppendI64(b, qwMm)
                World3dCidAppendLit(b, ",")
                World3dCidAppendI64(b, qxMm)
                World3dCidAppendLit(b, ",")
                World3dCidAppendI64(b, qyMm)
                World3dCidAppendLit(b, ",")
                World3dCidAppendI64(b, qzMm)
                World3dCidAppendLit(b, ",")
                World3dCidAppendI64(b, cwzMm)
                World3dCidAppendLit(b, ",")
                World3dCidAppendI64(b, cwyMm)
                World3dCidAppendLit(b, ",")
                World3dCidAppendI64(b, cwzMm)
            i = i + 1
    # Conditional joint segment (kinds 7..10), appended after the capsules
    # section. Emitted only when at least one active joint-kind constraint
    # exists; worlds without joints append zero bytes and keep every CID
    # byte-identical. This section — never |cons= — carries the motor
    # cmd/goal: they are evolving control state that decides later
    # evolution, so they must join the CID (design §4.2). All values ride
    # the shared micro-unit quantizer (value scaled x1000 then quantized).
    var jointCount: int32 = 0
    i = 0
    while i < w.conCount:
        if w.conActive[i] == 1:
            let jk = w.conKind[i]
            if jk >= World3dConSpherePin:
                if jk <= World3dConHinge:
                    jointCount = jointCount + 1
        i = i + 1
    if jointCount > 0:
        World3dCidAppendLit(b, "|joints=")
        World3dCidAppendI64(b, jointCount)
        i = 0
        while i < w.conCount:
            if w.conActive[i] == 1:
                let jk = w.conKind[i]
                if jk >= World3dConSpherePin:
                    if jk <= World3dConHinge:
                        World3dCidAppendLit(b, "|j")
                        World3dCidAppendI64(b, i)
                        World3dCidAppendLit(b, ":")
                        World3dCidAppendI64(b, jk)
                        World3dCidAppendLit(b, ",")
                        World3dCidAppendI64(b, w.conA[i])
                        World3dCidAppendLit(b, ",")
                        World3dCidAppendI64(b, w.conB[i])
                        World3dCidAppendLit(b, ",")
                        World3dCidAppendMilli(b, w.conAnchAx[i])
                        World3dCidAppendMilli(b, w.conAnchAy[i])
                        World3dCidAppendMilli(b, w.conAnchAz[i])
                        World3dCidAppendMilli(b, w.conAnchBx[i])
                        World3dCidAppendMilli(b, w.conAnchBy[i])
                        World3dCidAppendMilli(b, w.conAnchBz[i])
                        World3dCidAppendMilli(b, w.conAxisAx[i])
                        World3dCidAppendMilli(b, w.conAxisAy[i])
                        World3dCidAppendMilli(b, w.conAxisAz[i])
                        World3dCidAppendMilli(b, w.conAxisBx[i])
                        World3dCidAppendMilli(b, w.conAxisBy[i])
                        World3dCidAppendMilli(b, w.conAxisBz[i])
                        World3dCidAppendMilli(b, w.conRefAx[i])
                        World3dCidAppendMilli(b, w.conRefAy[i])
                        World3dCidAppendMilli(b, w.conRefAz[i])
                        World3dCidAppendMilli(b, w.conRefBx[i])
                        World3dCidAppendMilli(b, w.conRefBy[i])
                        World3dCidAppendMilli(b, w.conRefBz[i])
                        World3dCidAppendMilli(b, w.conCmd[i])
                        World3dCidAppendMilli(b, w.conGoal[i])
                        World3dCidAppendMilli(b, w.conLimMin[i])
                        World3dCidAppendMilli(b, w.conLimMax[i])
                        World3dCidAppendMilli(b, w.conMaxRate[i])
                        World3dCidAppendMilli(b, w.conTauMax[i])
                        World3dCidAppendMilli(b, w.conOmega0[i])
            i = i + 1
    var raw: rawbytes.Bytes = rawbytes.BytesBuilderFinish(b)
    let out: str = rawbytes.BytesToString(raw)
    rawbytes.BytesFree(raw)
    return out

@borrows
fn World3dCid(w: World3d): str =
    return strings.Sha256(World3dCanonicalPreimage(w))

# Structural validity: counts in range, constraint slots in range, active
# grasp constraints reference live bodies, masses finite where dynamic.
@borrows
fn World3dValid(w: World3d): bool =
    if w.count < 0 || w.count > World3dMaxBodies:
        return false
    if w.conCount < 0 || w.conCount > World3dMaxConstraints:
        return false
    if w.wallCount < 0 || w.wallCount > World3dMaxWalls:
        return false
    if w.tick < int64(0):
        return false
    var i: int32 = 0
    while i < w.count:
        if w.entityIds[i] <= 0:
            return false
        if w.generations[i] <= 0:
            return false
        if w.bodyInvMass[i] < 0.0:
            return false
        if m.absFloat(w.bodyFx[i]) > 1000000000.0:
            return false
        if m.absFloat(w.bodyFy[i]) > 1000000000.0:
            return false
        if m.absFloat(w.bodyFz[i]) > 1000000000.0:
            return false
        if m.absFloat(w.bodyPx[i]) > 1000000.0:
            return false
        if m.absFloat(w.bodyPy[i]) > 1000000.0:
            return false
        if m.absFloat(w.bodyPz[i]) > 1000000.0:
            return false
        if w.bodyKind[i] == World3dBodyCapsuleRigid:
            # pose must stay a unit quaternion (renormalized every tick)
            let qn = numerics.CsgSqrt(w.bodyQuatW[i] * w.bodyQuatW[i] + w.bodyQuatX[i] * w.bodyQuatX[i] + w.bodyQuatY[i] * w.bodyQuatY[i] + w.bodyQuatZ[i] * w.bodyQuatZ[i])
            if m.absFloat(qn - 1.0) > 0.000001:
                return false
        i = i + 1
    i = 0
    while i < w.conCount:
        if w.conA[i] < 0 || w.conA[i] >= w.count:
            return false
        if w.conB[i] < 0 || w.conB[i] >= w.count:
            return false
        if w.conRest[i] < 0.0:
            return false
        let jk = w.conKind[i]
        if jk >= World3dConSpherePin:
            if jk <= World3dConHinge:
                # joint columns must stay finite; the hinge axes must stay
                # unit vectors (created normalized, never written again)
                if !(w.conCmd[i] > -1000000.0):
                    return false
                if !(w.conCmd[i] < 1000000.0):
                    return false
                if !(w.conGoal[i] > -1000000.0):
                    return false
                if !(w.conGoal[i] < 1000000.0):
                    return false
                if !(w.conLimMin[i] > -1000000.0):
                    return false
                if !(w.conLimMin[i] < 1000000.0):
                    return false
                if !(w.conLimMax[i] > -1000000.0):
                    return false
                if !(w.conLimMax[i] < 1000000.0):
                    return false
                if !(w.conMaxRate[i] > -1000000.0):
                    return false
                if !(w.conMaxRate[i] < 1000000.0):
                    return false
                if !(w.conTauMax[i] > -1000000.0):
                    return false
                if !(w.conTauMax[i] < 1000000.0):
                    return false
                if !(w.conOmega0[i] > -1000000.0):
                    return false
                if !(w.conOmega0[i] < 1000000.0):
                    return false
                if jk >= World3dConHingeServo:
                    let axLen = numerics.CsgSqrt(w.conAxisAx[i] * w.conAxisAx[i] + w.conAxisAy[i] * w.conAxisAy[i] + w.conAxisAz[i] * w.conAxisAz[i])
                    if m.absFloat(axLen - 1.0) > 0.000001:
                        return false
                    let bxLen = numerics.CsgSqrt(w.conAxisBx[i] * w.conAxisBx[i] + w.conAxisBy[i] * w.conAxisBy[i] + w.conAxisBz[i] * w.conAxisBz[i])
                    if m.absFloat(bxLen - 1.0) > 0.000001:
                        return false
        i = i + 1
    return true
