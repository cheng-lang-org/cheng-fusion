# Rope3D: rope spec, world construction and removal (intervention op).
# A rope is a chain of point-mass nodes linked by unilateral distance
# constraints; node 0 hangs from a static anchor (invMass=0). "Remove rope"
# deactivates every rope segment and grasp constraint and freezes the rope
# nodes — the semantic removal a re-materialization would produce, applied
# in place so intervention films can derive from a checkpoint.
import cheng/game/world3d
import std/math as m

const
    Rope3dMaxNodes = 32

type
    Rope3dSpec =
        nodeCount: int32
        nodeMassKg: float64
        segmentLenM: float64
        renderRadiusM: float64
        anchorX: float64
        anchorY: float64
        anchorZ: float64

@borrows
fn Rope3dSpecValid(spec: Rope3dSpec): bool =
    # nodeCount == 0 is a legal rope-free scene
    if spec.nodeCount == 0:
        return true
    if spec.nodeCount < 2 || spec.nodeCount > Rope3dMaxNodes:
        return false
    if spec.nodeMassKg <= 0.0:
        return false
    if spec.segmentLenM <= 0.0:
        return false
    if spec.renderRadiusM <= 0.0:
        return false
    return true

# Build the rope hanging straight down from the anchor. Returns the slot of
# the lowest (free-end) node; -1 for a rope-free scene (ropeActive stays 0).
@borrows
fn Rope3dBuild(w: var World3d, spec: Rope3dSpec): int32 =
    if !Rope3dSpecValid(spec):
        panic("rope3d: invalid rope spec")
    if spec.nodeCount == 0:
        w.ropeActive = 0
        return -1
    w.ropeActive = 1
    let anchorSlot = World3dSpawnBody(w, spec.anchorX, spec.anchorY, spec.anchorZ, 0.0, spec.renderRadiusM, world3d.World3dBodyStatic)
    w.ropeAnchorSlot = anchorSlot
    var prev = anchorSlot
    var lowest = anchorSlot
    var i: int32 = 0
    while i < spec.nodeCount:
        let z = spec.anchorZ - spec.segmentLenM * float64(i + 1)
        let nodeSlot = World3dSpawnBody(w, spec.anchorX, spec.anchorY, z, spec.nodeMassKg, spec.renderRadiusM, world3d.World3dBodyRope)
        let _ci = World3dAddConstraint(w, prev, nodeSlot, spec.segmentLenM, world3d.World3dConRopeSegment)
        prev = nodeSlot
        lowest = nodeSlot
        i = i + 1
    return lowest

# Semantic removal: all rope segments and grasp constraints go inactive,
# rope nodes are TAKEN AWAY (radius zeroed — they neither collide nor
# render), the tension path is cut. Body slots keep their identity (world
# rows are not deleted mid-film).
fn Rope3dRemoveFromWorld(w: var World3d) =
    w.ropeActive = 0
    var ci: int32 = 0
    while ci < w.conCount:
        if w.conKind[ci] == world3d.World3dConRopeSegment || w.conKind[ci] == world3d.World3dConGrasp:
            w.conActive[ci] = 0
        ci = ci + 1
    var i: int32 = 0
    while i < w.count:
        if w.bodyKind[i] == world3d.World3dBodyRope:
            w.bodyInvMass[i] = 0.0
            w.bodyRadius[i] = 0.0
        i = i + 1
