import cheng/game/ecs
import cheng/game/physics2d
import std/system
import std/strings as strings
import std/strutils as strutil

const
    GameRuntimeSchema = "cheng.game.runtime.v2"
    GameRuntimeMaxPendingInputs = 8
    GameActionMove = 1
    GameActionPause = 2
    GameActionStep = 3
    GameRuntimeCidHexLen = 32 * 2

type
    GameInputEvent =
        tick: int32
        entityId: int32
        actionKind: int32
        axisX: int32
        axisY: int32
        magnitude: int32
        guard: str
        trace: str

    GameTickReceipt =
        schema: str
        tick: int32
        fixedDtMs: int32
        sourceWorldCid: str
        resultWorldCid: str
        inputCount: int32
        physicsContactCount: int32
        statusCode: int32
        physicsReceiptCid: str
        receiptCid: str
        trace: str

    GameRuntime =
        world: ecs.EcsWorld
        tick: int32
        fixedDtMs: int32
        paused: bool
        pendingInputCount: int32
        pendingInput0: GameInputEvent
        pendingInput1: GameInputEvent
        pendingInput2: GameInputEvent
        pendingInput3: GameInputEvent
        pendingInput4: GameInputEvent
        pendingInput5: GameInputEvent
        pendingInput6: GameInputEvent
        pendingInput7: GameInputEvent
        lastReceipt: GameTickReceipt

fn GameRuntimeInit(world: ecs.EcsWorld, fixedDtMs: int32): GameRuntime =
    var runtime: GameRuntime
    runtime.world = ecs.EcsWorldClone(world)
    runtime.fixedDtMs = fixedDtMs
    return runtime

fn GameRuntimeReset(runtime: var GameRuntime, world: ecs.EcsWorld, fixedDtMs: int32) =
    runtime.world = world
    runtime.tick = 0
    runtime.fixedDtMs = fixedDtMs
    runtime.paused = false
    runtime.pendingInputCount = 0

fn GameMakeMoveInput(tick: int32,
                      entityId: int32,
                      vx: int32,
                      vy: int32,
                      guard: str): GameInputEvent =
    var input: GameInputEvent
    input.tick = tick
    input.entityId = entityId
    input.actionKind = GameActionMove
    input.axisX = vx
    input.axisY = vy
    input.magnitude = 1
    input.guard = guard
    input.trace = "typed-action:move"
    return input

fn GameRuntimePendingInputAt(runtime: GameRuntime, index: int32): GameInputEvent =
    if index == 0: return runtime.pendingInput0
    if index == 1: return runtime.pendingInput1
    if index == 2: return runtime.pendingInput2
    if index == 3: return runtime.pendingInput3
    if index == 4: return runtime.pendingInput4
    if index == 5: return runtime.pendingInput5
    if index == 6: return runtime.pendingInput6
    if index == 7: return runtime.pendingInput7
    var input: GameInputEvent
    return input

fn GameRuntimeSetPendingInputAt(runtime: var GameRuntime, index: int32, input: GameInputEvent): bool =
    if index == 0:
        runtime.pendingInput0 = input
        return true
    if index == 1:
        runtime.pendingInput1 = input
        return true
    if index == 2:
        runtime.pendingInput2 = input
        return true
    if index == 3:
        runtime.pendingInput3 = input
        return true
    if index == 4:
        runtime.pendingInput4 = input
        return true
    if index == 5:
        runtime.pendingInput5 = input
        return true
    if index == 6:
        runtime.pendingInput6 = input
        return true
    if index == 7:
        runtime.pendingInput7 = input
        return true
    return false

fn GameRuntimeEnqueue(runtime: var GameRuntime, input: GameInputEvent): bool =
    if input.tick != runtime.tick:
        return false
    if input.actionKind == GameActionMove:
        if ecs.EcsWorldIndexOf(runtime.world, input.entityId) < 0:
            return false
    if input.guard.len <= 0:
        return false
    if runtime.pendingInputCount >= 8:
        return false
    if !GameRuntimeSetPendingInputAt(runtime, runtime.pendingInputCount, input):
        return false
    runtime.pendingInputCount = runtime.pendingInputCount + 1
    return true

fn gameApplyInput(runtime: var GameRuntime, input: GameInputEvent): bool =
    if input.actionKind == GameActionMove:
        return ecs.EcsWorldSetVelocity(runtime.world, input.entityId, input.axisX, input.axisY)
    if input.actionKind == GameActionPause:
        runtime.paused = true
        return true
    if input.actionKind == GameActionStep:
        runtime.paused = false
        return true
    return false

# Canonical tick-receipt preimage. The physics step receipt is chained in
# by its CID, so the tick receipt transitively commits to world state and
# the forces chain — one hash chain across the whole engine tick.
fn gameTickReceiptPreimage(receipt: GameTickReceipt): str =
    var parts: str[]
    add(parts, receipt.schema)
    add(parts, "|tick|tick=")
    add(parts, strings.IntToStr(receipt.tick))
    add(parts, "|dt=")
    add(parts, strings.IntToStr(receipt.fixedDtMs))
    add(parts, "|source=")
    add(parts, receipt.sourceWorldCid)
    add(parts, "|result=")
    add(parts, receipt.resultWorldCid)
    add(parts, "|inputs=")
    add(parts, strings.IntToStr(receipt.inputCount))
    add(parts, "|contacts=")
    add(parts, strings.IntToStr(receipt.physicsContactCount))
    add(parts, "|status=")
    add(parts, strings.IntToStr(receipt.statusCode))
    add(parts, "|physics=")
    add(parts, receipt.physicsReceiptCid)
    add(parts, "|trace=")
    add(parts, receipt.trace)
    return strutil.Join(parts, "")

fn GameTickReceiptCid(receipt: GameTickReceipt): str =
    return strings.Sha256(gameTickReceiptPreimage(receipt))

fn GameRuntimeTick(runtime: var GameRuntime): GameTickReceipt =
    var receipt: GameTickReceipt
    receipt.schema = GameRuntimeSchema
    receipt.tick = runtime.tick
    receipt.fixedDtMs = runtime.fixedDtMs
    receipt.sourceWorldCid = ecs.EcsWorldCid(runtime.world)
    receipt.inputCount = runtime.pendingInputCount
    receipt.physicsReceiptCid = ""
    receipt.trace = "game-runtime:fixed-step"
    for i in 0..<runtime.pendingInputCount:
        let input = GameRuntimePendingInputAt(runtime, i)
        if !gameApplyInput(runtime, input):
            receipt.statusCode = 2
    runtime.pendingInputCount = 0
    if !runtime.paused:
        let physicsReceipt = physics2d.Physics2dStep(runtime.world, runtime.tick, runtime.fixedDtMs)
        if !physics2d.Physics2dReceiptValid(physicsReceipt):
            panic("game-runtime: physics step receipt failed self-validation")
        receipt.physicsContactCount = physicsReceipt.contactCount
        receipt.physicsReceiptCid = physicsReceipt.receiptCid
        if physicsReceipt.statusCode != 1:
            receipt.statusCode = physicsReceipt.statusCode
    if receipt.statusCode == 0:
        receipt.statusCode = 1
    receipt.resultWorldCid = ecs.EcsWorldCid(runtime.world)
    receipt.receiptCid = GameTickReceiptCid(receipt)
    runtime.lastReceipt = receipt
    runtime.tick = runtime.tick + 1
    return receipt

fn GameTickReceiptValid(receipt: GameTickReceipt): bool =
    if receipt.schema != GameRuntimeSchema:
        return false
    if receipt.sourceWorldCid.len != GameRuntimeCidHexLen:
        return false
    if receipt.resultWorldCid.len != GameRuntimeCidHexLen:
        return false
    if receipt.receiptCid != GameTickReceiptCid(receipt):
        return false
    return true
