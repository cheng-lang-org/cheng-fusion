# Screen-space bitmap text (F-b): a 5x7 pixel font for subtitles and
# captions, drawn on top of the finished raster (no depth test). Each
# glyph packs its seven row bitmaps (5 bits per row, row 0 lowest) into
# one int64; the table below is generated data.
import cheng/game/render/cpu_raster as raster
import std/rawbytes
import std/strings as strings

# Rows for one character; returns 0 for unknown glyphs (blank cell).
fn TextGlyphBits(ch: int32): int64 =
    if ch == 65:
        return int64(18842895918)
    if ch == 66:
        return int64(32801506878)
    if ch == 67:
        return int64(15620129326)
    if ch == 68:
        return int64(32801080894)
    if ch == 69:
        return int64(33840644639)
    if ch == 70:
        return int64(17734517279)
    if ch == 71:
        return int64(15621407278)
    if ch == 72:
        return int64(18842895921)
    if ch == 73:
        return int64(15170932878)
    if ch == 74:
        return int64(13491046471)
    if ch == 75:
        return int64(18879369809)
    if ch == 76:
        return int64(33840185872)
    if ch == 77:
        return int64(18842572657)
    if ch == 78:
        return int64(18842507057)
    if ch == 79:
        return int64(15621211694)
    if ch == 80:
        return int64(17734518334)
    if ch == 81:
        return int64(14585218606)
    if ch == 82:
        return int64(18879563326)
    if ch == 83:
        return int64(32247333391)
    if ch == 84:
        return int64(4433514655)
    if ch == 85:
        return int64(15621211697)
    if ch == 86:
        return int64(4648912433)
    if ch == 87:
        return int64(19182306865)
    if ch == 88:
        return int64(18834663985)
    if ch == 89:
        return int64(4433521201)
    if ch == 90:
        return int64(33831389247)
    if ch == 48:
        return int64(15629733422)
    if ch == 49:
        return int64(15170933124)
    if ch == 50:
        return int64(33558693422)
    if ch == 51:
        return int64(15603929183)
    if ch == 52:
        return int64(2247698626)
    if ch == 53:
        return int64(15603923487)
    if ch == 54:
        return int64(15621636358)
    if ch == 55:
        return int64(8866891839)
    if ch == 56:
        return int64(15621113390)
    if ch == 57:
        return int64(12953568814)
    if ch == 32:
        return int64(0)
    if ch == 46:
        return int64(13287555072)
    if ch == 33:
        return int64(4299296900)
    if ch == 63:
        return int64(4299228718)
    if ch == 45:
        return int64(1015808)
    if ch == 58:
        return int64(415248768)
    if ch == 39:
        return int64(8324)
    if ch == 44:
        return int64(8736735232)
    if ch == 47:
        return int64(17725261857)
    return int64(0)

# Draw one text line onto the raster at screen pixel (x, y), scaled.
# Written directly into rgb after depth rendering — captions overlay.
@borrows
fn RasterText(t: raster.RasterTarget,
              x: int32,
              y: int32,
              scale: int32,
              text: str,
              r: int32,
              g: int32,
              b: int32) =
    var cursor: int32 = x
    var si: int32 = 0
    while si < text.len:
        let chCode: int32 = int32(text[si]) & 255
        let bits: int64 = TextGlyphBits(chCode)
        var row: int32 = 0
        while row < 7:
            let rowData: int32 = int32((bits >> (row * 5)) & 31)
            var col: int32 = 0
            while col < 5:
                if (rowData >> (4 - col)) & 1 == 1:
                    var dy: int32 = 0
                    while dy < scale:
                        var dx: int32 = 0
                        while dx < scale:
                            let px = cursor + col * scale + dx
                            let py = y + row * scale + dy
                            if px >= 0:
                                if px < t.width:
                                    if py >= 0:
                                        if py < t.height:
                                            let idx = py * t.width + px
                                            rawbytes.BytesSet(t.frame.bgra, idx * 4, b)
                                            rawbytes.BytesSet(t.frame.bgra, idx * 4 + 1, g)
                                            rawbytes.BytesSet(t.frame.bgra, idx * 4 + 2, r)
                                            rawbytes.BytesSet(t.frame.bgra, idx * 4 + 3, 255)
                            dx = dx + 1
                        dy = dy + 1
                col = col + 1
            row = row + 1
        cursor = cursor + 6 * scale
        si = si + 1

@borrows
fn TextPixelWidth(text: str, scale: int32): int32 =
    return text.len * 6 * scale
