# Character/rope renderer (D1): draws the A2 programmatic character over
# the analytic raster — sphere head, capsule torso/limbs, sphere hands and
# feet, plus a continuous capsule rope through the rope node chain. All
# geometry is read from the submitted world state only; the slot lookup
# goes through the part-role table (no name or proximity pairing).
import cheng/game/world3d
import cheng/game/cinema/camera
import cheng/game/render/cpu_raster as raster
import cheng/game/render/render_state
import cheng/game/csg/schema
import cheng/game/csg/numerics
import std/math as m

# Screen-space capsule between two world points: sweep-circle impostor
# with per-pixel depth (axis interpolation minus the surface bulge) and
# Lambert shading on the exact 3D surface normal.
@borrows
fn RasterCapsule(t: raster.RasterTarget,
                 cam: camera.CinemaCamera,
                 x0: float64, y0: float64, z0: float64,
                 x1: float64, y1: float64, z1: float64,
                 radius: float64,
                 baseR: int32, baseG: int32, baseB: int32) =
    let p0 = camera.CameraProject(cam, x0, y0, z0)
    let p1 = camera.CameraProject(cam, x1, y1, z1)
    if p0.depth <= 0.05:
        return
    if p1.depth <= 0.05:
        return
    let ax = p1.sx - p0.sx
    let ay = p1.sy - p0.sy
    let len2 = ax * ax + ay * ay
    let rad0 = radius * cam.focalPx / p0.depth
    let rad1 = radius * cam.focalPx / p1.depth
    let radMax = m.maxFloat(rad0, rad1)
    if radMax < 0.5:
        return
    let bx0: int32 = int32(m.minFloat(p0.sx, p1.sx) - radMax) - 1
    let bx1: int32 = int32(m.maxFloat(p0.sx, p1.sx) + radMax) + 1
    let by0: int32 = int32(m.minFloat(p0.sy, p1.sy) - radMax) - 1
    let by1: int32 = int32(m.maxFloat(p0.sy, p1.sy) + radMax) + 1
    var py: int32 = by0
    while py <= by1:
        var px: int32 = bx0
        while px <= bx1:
            let ex = float64(px) - p0.sx
            let ey = float64(py) - p0.sy
            var s: float64 = 0.0
            if len2 > 0.000001:
                s = (ex * ax + ey * ay) / len2
                if s < 0.0:
                    s = 0.0
                if s > 1.0:
                    s = 1.0
            let cx = p0.sx + ax * s
            let cy = p0.sy + ay * s
            let dx = float64(px) - cx
            let dy = float64(py) - cy
            let rad = rad0 + (rad1 - rad0) * s
            let d2 = dx * dx + dy * dy
            if d2 <= rad * rad:
                let hx = dx / rad
                let hy = (0.0 - dy) / rad
                let hf = numerics.CsgSqrt(m.maxFloat(0.0, 1.0 - hx * hx - hy * hy))
                let nx = cam.rx * hx + cam.ux * hy + cam.fx * hf
                let ny = cam.ry * hx + cam.uy * hy + cam.fy * hf
                let nz = cam.rz * hx + cam.uz * hy + cam.fz * hf
                let diff = nx * raster.RasterLightX + ny * raster.RasterLightY + nz * raster.RasterLightZ
                var lum = 0.30 + 0.70 * diff
                if lum > 1.0:
                    lum = 1.0
                if lum < 0.15:
                    lum = 0.15
                let axisDepth = p0.depth + (p1.depth - p0.depth) * s
                let depth = axisDepth - radius * hf
                raster.RasterPut(t, px, py, depth, int32(float64(baseR) * lum), int32(float64(baseG) * lum), int32(float64(baseB) * lum))
            px = px + 1
        py = py + 1

# Locate the body slot of one semantic role through the part-role table.
@borrows
fn RoleSlot(partRoles: int32[], role: int32): int32 =
    var i: int32 = 0
    while i < partRoles.len:
        if partRoles[i] == role:
            return i
        i = i + 1
    return -1

# A2 character appearance: sphere head (skin), capsule chest-pelvis torso
# (red shirt), capsule limbs (deep blue pants / red sleeves), sphere gray
# hands and feet.
@borrows
fn RenderCharacter(t: raster.RasterTarget,
                   cam: camera.CinemaCamera,
                   w: world3d.World3d,
                   partRoles: int32[]) =
    let head = RoleSlot(partRoles, schema.CsgRoleHead)
    let chest = RoleSlot(partRoles, schema.CsgRoleChest)
    let pelvis = RoleSlot(partRoles, schema.CsgRolePelvis)
    let handL = RoleSlot(partRoles, schema.CsgRoleHandL)
    let handR = RoleSlot(partRoles, schema.CsgRoleHandR)
    let footL = RoleSlot(partRoles, schema.CsgRoleFootL)
    let footR = RoleSlot(partRoles, schema.CsgRoleFootR)
    let kneeL = RoleSlot(partRoles, schema.CsgRoleKneeL)
    let kneeR = RoleSlot(partRoles, schema.CsgRoleKneeR)
    let elbowL = RoleSlot(partRoles, schema.CsgRoleElbowL)
    let elbowR = RoleSlot(partRoles, schema.CsgRoleElbowR)
    if chest < 0:
        return
    if pelvis < 0:
        return
    # torso: chest -> pelvis, red shirt
    RasterCapsule(t, cam, w.bodyPx[chest], w.bodyPy[chest], w.bodyPz[chest],
        w.bodyPx[pelvis], w.bodyPy[pelvis], w.bodyPz[pelvis], 0.13, 185, 45, 45)
    # arms: chest -> elbow -> hand, red sleeves; the thin segment capsules
    # (RenderRope line style) keep the tagged elbow joint sphere visible —
    # a fatter direct capsule would bury it in the depth buffer
    if elbowL >= 0:
        RasterCapsule(t, cam, w.bodyPx[chest], w.bodyPy[chest], w.bodyPz[chest],
            w.bodyPx[elbowL], w.bodyPy[elbowL], w.bodyPz[elbowL], 0.024, 165, 55, 55)
        if handL >= 0:
            RasterCapsule(t, cam, w.bodyPx[elbowL], w.bodyPy[elbowL], w.bodyPz[elbowL],
                w.bodyPx[handL], w.bodyPy[handL], w.bodyPz[handL], 0.024, 165, 55, 55)
    else:
        if handL >= 0:
            RasterCapsule(t, cam, w.bodyPx[chest], w.bodyPy[chest], w.bodyPz[chest],
                w.bodyPx[handL], w.bodyPy[handL], w.bodyPz[handL], 0.05, 165, 55, 55)
    if elbowR >= 0:
        RasterCapsule(t, cam, w.bodyPx[chest], w.bodyPy[chest], w.bodyPz[chest],
            w.bodyPx[elbowR], w.bodyPy[elbowR], w.bodyPz[elbowR], 0.024, 165, 55, 55)
        if handR >= 0:
            RasterCapsule(t, cam, w.bodyPx[elbowR], w.bodyPy[elbowR], w.bodyPz[elbowR],
                w.bodyPx[handR], w.bodyPy[handR], w.bodyPz[handR], 0.024, 165, 55, 55)
    else:
        if handR >= 0:
            RasterCapsule(t, cam, w.bodyPx[chest], w.bodyPy[chest], w.bodyPz[chest],
                w.bodyPx[handR], w.bodyPy[handR], w.bodyPz[handR], 0.05, 165, 55, 55)
    # legs: pelvis -> knee -> foot, deep blue pants; same thin-segment rule
    if kneeL >= 0:
        RasterCapsule(t, cam, w.bodyPx[pelvis], w.bodyPy[pelvis], w.bodyPz[pelvis],
            w.bodyPx[kneeL], w.bodyPy[kneeL], w.bodyPz[kneeL], 0.024, 45, 45, 65)
        if footL >= 0:
            RasterCapsule(t, cam, w.bodyPx[kneeL], w.bodyPy[kneeL], w.bodyPz[kneeL],
                w.bodyPx[footL], w.bodyPy[footL], w.bodyPz[footL], 0.024, 45, 45, 65)
    else:
        if footL >= 0:
            RasterCapsule(t, cam, w.bodyPx[pelvis], w.bodyPy[pelvis], w.bodyPz[pelvis],
                w.bodyPx[footL], w.bodyPy[footL], w.bodyPz[footL], 0.065, 45, 45, 65)
    if kneeR >= 0:
        RasterCapsule(t, cam, w.bodyPx[pelvis], w.bodyPy[pelvis], w.bodyPz[pelvis],
            w.bodyPx[kneeR], w.bodyPy[kneeR], w.bodyPz[kneeR], 0.024, 45, 45, 65)
        if footR >= 0:
            RasterCapsule(t, cam, w.bodyPx[kneeR], w.bodyPy[kneeR], w.bodyPz[kneeR],
                w.bodyPx[footR], w.bodyPy[footR], w.bodyPz[footR], 0.024, 45, 45, 65)
    else:
        if footR >= 0:
            RasterCapsule(t, cam, w.bodyPx[pelvis], w.bodyPy[pelvis], w.bodyPz[pelvis],
                w.bodyPx[footR], w.bodyPy[footR], w.bodyPz[footR], 0.065, 45, 45, 65)
    # head: skin sphere
    if head >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[head], w.bodyPy[head], w.bodyPz[head], 0.10, 220, 178, 140)
    # hands/feet: gray spheres
    if handL >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[handL], w.bodyPy[handL], w.bodyPz[handL], 0.05, 150, 150, 160)
    if handR >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[handR], w.bodyPy[handR], w.bodyPz[handR], 0.05, 150, 150, 160)
    if footL >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[footL], w.bodyPy[footL], w.bodyPz[footL], 0.06, 90, 90, 100)
    if footR >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[footR], w.bodyPy[footR], w.bodyPz[footR], 0.06, 90, 90, 100)
    # knee/elbow skeleton joints: dark-gray spheres, drawn last so their
    # bright caps survive the depth test against every limb capsule
    if kneeL >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[kneeL], w.bodyPy[kneeL], w.bodyPz[kneeL], 0.045, 60, 60, 70)
    if kneeR >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[kneeR], w.bodyPy[kneeR], w.bodyPz[kneeR], 0.045, 60, 60, 70)
    if elbowL >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[elbowL], w.bodyPy[elbowL], w.bodyPz[elbowL], 0.04, 70, 70, 80)
    if elbowR >= 0:
        raster.RasterSphere(t, cam, w.bodyPx[elbowR], w.bodyPy[elbowR], w.bodyPz[elbowR], 0.04, 70, 70, 80)

# Continuous rope: consecutive rope-node spheres joined by thin brown
# capsules, anchor included. Nodes with zero radius are "taken away"
# (rope removed by the intervention) and break the chain.
@borrows
fn RenderRope(t: raster.RasterTarget,
              cam: camera.CinemaCamera,
              w: world3d.World3d) =
    var prev: int32 = -1
    var i: int32 = 0
    while i < w.count:
        if w.bodyKind[i] == world3d.World3dBodyRope:
            if w.bodyRadius[i] > 0.0:
                raster.RasterSphere(t, cam, w.bodyPx[i], w.bodyPy[i], w.bodyPz[i], 0.03, 140, 90, 50)
                if prev >= 0:
                    if w.bodyRadius[prev] > 0.0:
                        RasterCapsule(t, cam, w.bodyPx[prev], w.bodyPy[prev], w.bodyPz[prev],
                            w.bodyPx[i], w.bodyPy[i], w.bodyPz[i], 0.024, 140, 90, 50)
                prev = i
            else:
                prev = -1
        i = i + 1

# ---- RenderState variants (F/G1): same appearance over a loaded state ----

@borrows
fn RenderRopeState(t: raster.RasterTarget,
                   cam: camera.CinemaCamera,
                   st: render_state.RenderState) =
    var prev: int32 = -1
    var i: int32 = 0
    while i < st.bodyCount:
        if st.kinds[i] == world3d.World3dBodyRope:
            if st.radius[i] > 0.0:
                raster.RasterSphere(t, cam, st.px[i], st.py[i], st.pz[i], 0.03, 140, 90, 50)
                if prev >= 0:
                    if st.radius[prev] > 0.0:
                        RasterCapsule(t, cam, st.px[prev], st.py[prev], st.pz[prev],
                            st.px[i], st.py[i], st.pz[i], 0.024, 140, 90, 50)
                prev = i
            else:
                prev = -1
        i = i + 1

@borrows
fn RenderCharacterState(t: raster.RasterTarget,
                        cam: camera.CinemaCamera,
                        st: render_state.RenderState) =
    # frozen role order: 0 pelvis, 1 chest, 2 head, 3 handL, 4 handR,
    # 5 footL, 6 footR (producer part order)
    let head: int32 = st.roles[2]
    let chest: int32 = st.roles[1]
    let pelvis: int32 = st.roles[0]
    let handL: int32 = st.roles[3]
    let handR: int32 = st.roles[4]
    let footL: int32 = st.roles[5]
    let footR: int32 = st.roles[6]
    RasterCapsule(t, cam, st.px[chest], st.py[chest], st.pz[chest],
        st.px[pelvis], st.py[pelvis], st.pz[pelvis], 0.13, 185, 45, 45)
    RasterCapsule(t, cam, st.px[chest], st.py[chest], st.pz[chest],
        st.px[handL], st.py[handL], st.pz[handL], 0.05, 165, 55, 55)
    RasterCapsule(t, cam, st.px[chest], st.py[chest], st.pz[chest],
        st.px[handR], st.py[handR], st.pz[handR], 0.05, 165, 55, 55)
    RasterCapsule(t, cam, st.px[pelvis], st.py[pelvis], st.pz[pelvis],
        st.px[footL], st.py[footL], st.pz[footL], 0.065, 45, 45, 65)
    RasterCapsule(t, cam, st.px[pelvis], st.py[pelvis], st.pz[pelvis],
        st.px[footR], st.py[footR], st.pz[footR], 0.065, 45, 45, 65)
    raster.RasterSphere(t, cam, st.px[head], st.py[head], st.pz[head], 0.10, 220, 178, 140)
    raster.RasterSphere(t, cam, st.px[handL], st.py[handL], st.pz[handL], 0.05, 150, 150, 160)
    raster.RasterSphere(t, cam, st.px[handR], st.py[handR], st.pz[handR], 0.05, 150, 150, 160)
    raster.RasterSphere(t, cam, st.px[footL], st.py[footL], st.pz[footL], 0.06, 90, 90, 100)
    raster.RasterSphere(t, cam, st.px[footR], st.py[footR], st.pz[footR], 0.06, 90, 90, 100)
