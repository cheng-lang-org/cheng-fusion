# Render state stream (F/G1): the deterministic frame-state files that
# decouple physics from rendering. Pass 1 (physics) dumps one SoA state
# file per film frame; pass 2 (render) workers load a state file each and
# render their frame into their own buffer — no shared mutable state
# crosses a thread boundary. File format is plain text in millimetres for
# exact round-trip determinism:
#   line 1: bodyCount roleCount
#   line 2: role[0..roleCount-1]          (omitted when roleCount = 0)
#   then bodyCount lines: kind pxMm pyMm pzMm radiusMm
import cheng/game/world3d
import std/os
import std/strings as strings

const
    RenderStateMm = 1000

type
    RenderState = ref object
        bodyCount: int32
        roleCount: int32
        kinds: int32[]
        roles: int32[]
        px: float64[]
        py: float64[]
        pz: float64[]
        radius: float64[]

fn RenderStateFramePath(dir: str, frame: int32): str =
    return dir + "/state_f" + strings.IntToStr(frame) + ".txt"

fn RoundMm64(v: float64): int64 =
    let mm: int32 = int32(v * float64(RenderStateMm))
    let wide: int64 = mm
    return wide

@borrows
fn RenderStateSave(w: world3d.World3d, partRoles: int32[], path: str) =
    var text: str = ""
    text = text + strings.IntToStr(w.count) + " " + strings.IntToStr(partRoles.len) + "\n"
    if partRoles.len > 0:
        var ri: int32 = 0
        while ri < partRoles.len:
            if ri > 0:
                text = text + " "
            text = text + strings.IntToStr(partRoles[ri])
            ri = ri + 1
        text = text + "\n"
    var i: int32 = 0
    while i < w.count:
        text = text + strings.IntToStr(w.bodyKind[i])
        text = text + " " + strings.Int64ToStr(RoundMm64(w.bodyPx[i]))
        text = text + " " + strings.Int64ToStr(RoundMm64(w.bodyPy[i]))
        text = text + " " + strings.Int64ToStr(RoundMm64(w.bodyPz[i]))
        text = text + " " + strings.Int64ToStr(RoundMm64(w.bodyRadius[i])) + "\n"
        i = i + 1
    var out: uint8[]
    setLen(out, text.len)
    var ci: int32 = 0
    while ci < text.len:
        out[ci] = uint8(int32(text[ci]) & 255)
        ci = ci + 1
    os.WriteFileBytes(path, out)

fn ParseI64(text: str): int64 =
    var v: int64 = 0
    var neg: bool = false
    var i: int32 = 0
    if text.len > 0:
        if text[0] == char(45):
            neg = true
            i = 1
    while i < text.len:
        v = v * 10 + int64(int32(text[i]) - 48)
        i = i + 1
    if neg:
        v = 0 - v
    return v

# Load a state file; all fields are ref-reachable through the returned
# handle. Returns nil when the file is missing or malformed.
@borrows
fn RenderStateLoad(path: str): RenderState =
    let text: str = os.ReadFile(path)
    var out = new(RenderState)
    out.bodyCount = 0
    out.roleCount = 0
    setLen(out.roles, 0)
    setLen(out.kinds, 0)
    setLen(out.px, 0)
    setLen(out.py, 0)
    setLen(out.pz, 0)
    setLen(out.radius, 0)
    var pos: int32 = 0
    var total: int32 = text.len
    # line 1: bodyCount roleCount
    var header: int64[]
    setLen(header, 0)
    var h: int32 = 0
    while h < 2:
        var v: int64 = 0
        var seen: bool = false
        while pos < total:
            let c: int32 = int32(text[pos])
            if c == 32 || c == 10:
                if seen:
                    pos = pos + 1
                    break
                pos = pos + 1
            else:
                v = v * 10 + int64(c - 48)
                seen = true
                pos = pos + 1
        add(header, v)
        h = h + 1
    out.bodyCount = int32(header[0])
    out.roleCount = int32(header[1])
    var ri: int32 = 0
    while ri < out.roleCount:
        var v: int64 = 0
        var seen: bool = false
        while pos < total:
            let c: int32 = int32(text[pos])
            if c == 32 || c == 10:
                if seen:
                    pos = pos + 1
                    break
                pos = pos + 1
            else:
                v = v * 10 + int64(c - 48)
                seen = true
                pos = pos + 1
        add(out.roles, int32(v))
        ri = ri + 1
    setLen(out.px, 0)
    setLen(out.py, 0)
    setLen(out.pz, 0)
    setLen(out.radius, 0)
    setLen(out.kinds, 0)
    var bi: int32 = 0
    while bi < out.bodyCount:
        var fields: int32[]
        setLen(fields, 5)
        var fi: int32 = 0
        while fi < 5:
            var v: int64 = 0
            var neg: bool = false
            var seen: bool = false
            while pos < total:
                let c: int32 = int32(text[pos])
                if c == 45:
                    neg = true
                    seen = true
                    pos = pos + 1
                else:
                    if c == 32 || c == 10:
                        if seen:
                            pos = pos + 1
                            break
                        pos = pos + 1
                    else:
                        v = v * 10 + int64(c - 48)
                        seen = true
                        pos = pos + 1
            if neg:
                v = 0 - v
            fields[fi] = int32(v)
            fi = fi + 1
        add(out.kinds, fields[0])
        let mm: float64 = float64(RenderStateMm)
        add(out.px, float64(fields[1]) / mm)
        add(out.py, float64(fields[2]) / mm)
        add(out.pz, float64(fields[3]) / mm)
        add(out.radius, float64(fields[4]) / mm)
        bi = bi + 1
    return out
