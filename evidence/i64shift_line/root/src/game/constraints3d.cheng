# Constraint projection operator (solver-decision §2): XPBD-style distance
# projection weighted by inverse mass. Rope segments are unilateral (only
# stretch is corrected, slack is legal); joints are bilateral; grasp
# constraints project to conTarget (the muscle pull-in length); distance
# limit kinds are unilateral bounds: ConDistMax resists only separation
# beyond conTarget, ConDistMin resists only approach below conTarget.
# Returns the max |d - target| residual in metres after the pass.
import cheng/game/world3d
import cheng/game/csg/numerics
import std/math as m
import std/strings as strings

# last tick the gauge-drift removal actually acted (diagnostic: the
# removal's residual gate skips it whenever the solve rides the gate,
# and each skipped tick lets the pitch ratchet advance)
var constraints3dGaugeLastActTick: int32 = 0 - 1
# hinge-level diagnostic (DUCK_HINGE_ECHO): echo the anchor gap and
# angle error of one constraint index before/after each joint solve
var constraints3dHingeEchoCi: int32 = 0 - 1
var constraints3dHingeEchoOn: int32 = 0
# support rows for standing (DUCK_SUPPORT_STAND): the position-level
# foot clamp removes the per-tick gravity-drop gap churn at the foot
# anchors (the oscillation drive); lift-accounted so no pogo
var constraints3dSupportStanding: int32 = 0

const
    Constraints3dIterations = 96
    Constraints3dRefineIterations = 4096
    Constraints3dSlackEps = 0.0000001

fn constraints3dProjectOne(w: var World3d, ci: int32): float64 =
    # joint kinds project through their dedicated operators (the generic
    # center-distance path below only fits plain point-point rows)
    let kind = w.conKind[ci]
    if kind == world3d.World3dConSpherePin:
        return constraints3dProjectAnchors(w, ci)
    if kind == world3d.World3dConAnchorDist:
        return constraints3dProjectAnchorDist(w, ci)
    if kind == world3d.World3dConHingeServo:
        return constraints3dProjectHinge(w, ci)
    if kind == world3d.World3dConHinge:
        return constraints3dProjectHinge(w, ci)
    let aSlot = w.conA[ci]
    let bSlot = w.conB[ci]
    let dx = w.bodyPx[bSlot] - w.bodyPx[aSlot]
    let dy = w.bodyPy[bSlot] - w.bodyPy[aSlot]
    let dz = w.bodyPz[bSlot] - w.bodyPz[aSlot]
    let dist = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
    if dist <= Constraints3dSlackEps:
        return 0.0
    let wInvA = w.bodyInvMass[aSlot]
    let wInvB = w.bodyInvMass[bSlot]
    let wSum = wInvA + wInvB
    if wSum <= 0.0:
        return 0.0
    # every constraint projects to its target length (== rest at creation;
    # servo actuators move the target for joints, winches and legs)
    let target = w.conTarget[ci]
    let diff = dist - target
    if w.conKind[ci] == world3d.World3dConRopeSegment:
        # unilateral: rope only resists stretch
        if diff <= 0.0:
            return 0.0
    if w.conKind[ci] == world3d.World3dConGrasp:
        # unilateral winch: the grasp resists stretch at its target length
        # (ascender model); the servo winches the target down to climb
        if diff <= 0.0:
            return 0.0
    if w.conKind[ci] == world3d.World3dConDistMax:
        # unilateral upper bound (joint angle limit base): only resists
        # separation beyond the target; at or under it the constraint is slack
        if diff <= 0.0:
            return 0.0
    if w.conKind[ci] == world3d.World3dConDistMin:
        # unilateral lower bound: only resists approach below the target;
        # at or over it the constraint is slack
        if diff >= 0.0:
            return 0.0
    let correction = diff / (dist * wSum)
    w.bodyPx[aSlot] = w.bodyPx[aSlot] + correction * wInvA * dx
    w.bodyPy[aSlot] = w.bodyPy[aSlot] + correction * wInvA * dy
    w.bodyPz[aSlot] = w.bodyPz[aSlot] + correction * wInvA * dz
    w.bodyPx[bSlot] = w.bodyPx[bSlot] - correction * wInvB * dx
    w.bodyPy[bSlot] = w.bodyPy[bSlot] - correction * wInvB * dy
    w.bodyPz[bSlot] = w.bodyPz[bSlot] - correction * wInvB * dz
    return m.absFloat(diff)

# One support pole projection: one-sided vertical row holding a
# capsule pole (world point e, radius r) above the floor plane z=0.
# C = e_z - r; if C < 0 push the BODY up along +z by -C weighted by
# the pole's generalized inverse mass (translation + rotation about
# the COM through the pole arm r_p = e - com), split like a normal
# row. Position-level ground inside the solve — the stance foot
# stops losing the tug-of-war with the swing-side torques.
@borrows
fn constraints3dProjectSupportPole(w: var World3d, slot: int32, ex: float64, ey: float64, ez: float64, r: float64, supRepair: var float64[]): float64 =
    let c = ez - r
    if c >= 0.0:
        return 0.0
    let invM = w.bodyInvMass[slot]
    if invM <= 0.0:
        return 0.0
    # pole arm from COM (world)
    let rpx = ex - w.bodyPx[slot]
    let rpy = ey - w.bodyPy[slot]
    let rpz = ez - w.bodyPz[slot]
    # lever n for a vertical push = (r_p x z) = (rpy, -rpx, 0)
    let nx = rpy
    let ny = 0.0 - rpx
    let nz = 0.0
    var wSum = invM
    if w.bodyKind[slot] == world3d.World3dBodyCapsuleRigid:
        if w.bodyIxx[slot] > 0.0:
            let t = constraints3dCapsuleInvInertia(w, slot, constraints3dVec(nx, ny, nz))
            wSum = wSum + nx * t.x + ny * t.y + nz * t.z
    if wSum <= Constraints3dJointEps:
        return 0.0
    let s = (0.0 - c) / wSum
    w.bodyPz[slot] = w.bodyPz[slot] + s * invM
    # geometric ground repair: recorded per body so the Verlet velocity
    # rebuild can exclude it exactly like the capsule pushout lift
    # (billing it as COM velocity re-launches the resting stance —
    # measured: the rigid solve pumped both feet to 80 mm airborne
    # within 30 ticks of the ground spawn)
    supRepair[slot * 4] = supRepair[slot * 4] + s * invM
    if w.bodyKind[slot] == world3d.World3dBodyCapsuleRigid:
        if w.bodyIxx[slot] > 0.0:
            let t = constraints3dCapsuleInvInertia(w, slot, constraints3dVec(nx, ny, nz))
            constraints3dApplyWorldRot(w, slot, s * t.x, s * t.y, s * t.z)
            # the pole repair's rotation is the same geometric ground
            # repair as the lift: recorded so the angular velocity
            # rebuild can exclude it (foot-rock spin from alternating
            # pole repairs pumped the resting stance)
            supRepair[slot * 4 + 1] = supRepair[slot * 4 + 1] + s * t.x
            supRepair[slot * 4 + 2] = supRepair[slot * 4 + 2] + s * t.y
            supRepair[slot * 4 + 3] = supRepair[slot * 4 + 3] + s * t.z
    return 0.0 - c

# One projection sweep over active constraints in index order, then
# the support poles of every capsule in the band (position-level
# ground; one-sided, no pull-down, no friction — the velocity layer
# keeps those).
@borrows
fn constraints3dProjectSupports(w: var World3d, supRepair: var float64[]): float64 =
    var maxResidual: float64 = 0.0
    var i: int32 = 0
    while i < w.count:
        if w.bodyInvMass[i] > 0.0:
            if w.bodyKind[i] == world3d.World3dBodyCapsuleRigid:
                let r = w.bodyRadius[i]
                let h = w.bodyCapsuleHalf[i]
                let ax = 2.0 * (w.bodyQuatX[i] * w.bodyQuatZ[i] + w.bodyQuatW[i] * w.bodyQuatY[i])
                let ay = 2.0 * (w.bodyQuatY[i] * w.bodyQuatZ[i] - w.bodyQuatW[i] * w.bodyQuatX[i])
                let az = 1.0 - 2.0 * (w.bodyQuatX[i] * w.bodyQuatX[i] + w.bodyQuatY[i] * w.bodyQuatY[i])
                # pole 1: +h along axis
                let e1x = w.bodyPx[i] + h * ax
                let e1y = w.bodyPy[i] + h * ay
                let e1z = w.bodyPz[i] + h * az
                let g1 = e1z - r
                if g1 > 0.0 - 0.050 and g1 < 0.050:
                    let res1 = constraints3dProjectSupportPole(w, i, e1x, e1y, e1z, r, supRepair)
                    if res1 > maxResidual:
                        maxResidual = res1
                # pole 2: -h
                let e2x = w.bodyPx[i] - h * ax
                let e2y = w.bodyPy[i] - h * ay
                let e2z = w.bodyPz[i] - h * az
                let g2 = e2z - r
                if g2 > 0.0 - 0.050 and g2 < 0.050:
                    let res2 = constraints3dProjectSupportPole(w, i, e2x, e2y, e2z, r, supRepair)
                    if res2 > maxResidual:
                        maxResidual = res2
        i = i + 1
    return maxResidual

# One projection sweep over active constraints in index order.
fn constraints3dSweep(w: var World3d, supRepair: var float64[]): float64 =
    var maxResidual: float64 = 0.0
    var ci: int32 = 0
    while ci < w.conCount:
        if w.conActive[ci] == 1:
            let res = constraints3dProjectOne(w, ci)
            if res > maxResidual:
                maxResidual = res
        ci = ci + 1
    # support rows stay gait-gated: under the rigid block solve their
    # position repair still pumps the standing stance (116 ticks vs 172
    # without — retested after the spawn/accounting/feet fixes), while
    # the velocity-level ground contact holds the resting feet
    if physics3d.physics3dGaitMode == 1 or constraints3dSupportStanding == 1:
        let resSup = constraints3dProjectSupports(w, supRepair)
        if resSup > maxResidual:
            maxResidual = resSup
    return maxResidual

fn constraints3dSweepReversed(w: var World3d, supRepair: var float64[]): float64 =
    var maxResidual: float64 = 0.0
    var ci: int32 = w.conCount - 1
    while ci >= 0:
        if w.conActive[ci] == 1:
            let res = constraints3dProjectOne(w, ci)
            if res > maxResidual:
                maxResidual = res
        ci = ci - 1
    return maxResidual

# sweeps actually burned in the last solve tick (base + refine), for the
# DUCK_SWEEP_ECHO instrument: frame-time variance is refine-convergence
# variance (early exit fast vs full-budget burn slow), this makes it a
# measurement instead of an inference
var constraints3dSweepCountLast: int32 = 0
# base-pass residual early exit in milli-mm (DUCK_SWEEP_EXIT_MM). The
# quality contract is the residual, the sweep count is only the budget
# cap. Default 1000 (1.0mm): the standing equilibrium residual is the
# load deflection (0.55-1.0mm measured — joint rows PARK at their
# soft-servo deflection, they never reach 0), so sweeping past
# equilibrium is pure solve-window churn — stopping there measured
# BETTER on every gate (passive 318→360, ball drift 61.5→86.9mm both
# far under the 500 gate, 5/7 law exact) at ~8x fewer rest sweeps.
# 0 restores the fixed 96-sweep schedule.
var constraints3dBaseExitMm: int32 = 1000
# residual of the last solve in micrometres (for the SW echo)
var constraints3dResidLastUm: int32 = 0

# Symmetric Gauss-Seidel block: `iterations` alternating sweeps, with an
# early exit once `gateM` is met — a converged solve must not burn the
# remaining sweeps (the ball-stand refine pass ran all 4096 every tick:
# 101 of the 124 ms tick). Skipped sweeps are past the convergence point,
# so the returned state is identical; only wasted iterations vanish.
fn constraints3dRun(w: var World3d, iterations: int32, gateM: float64, supRepair: var float64[]): float64 =
    var maxResidual: float64 = 0.0
    var it: int32 = 0
    while it < iterations:
        if it % 2 == 0:
            maxResidual = constraints3dSweep(w, supRepair)
        else:
            maxResidual = constraints3dSweepReversed(w, supRepair)
        constraints3dSweepCountLast = constraints3dSweepCountLast + 1
        if maxResidual <= gateM:
            return maxResidual
        it = it + 1
    return maxResidual

# Regular solve. If the residual is above the gate, refine once with many
# more sweeps: impact transients converge; true divergence does not.
# Regular solve, optionally tracking the per-body position displacement the
# gauge-drift removal applies (the caller decides whether that gauge repair
# enters its velocity channels; see physics3d's Verlet rebuild, which must
# exclude it exactly like the ground pushout lift).
fn Constraints3dSolveTracked(w: var World3d, residualGateM: float64, gaugeDx: var float64[], gaugeDy: var float64[], gaugeDz: var float64[], supRepair: var float64[]): float64 =
    return Constraints3dSolveTrackedBudget(w, residualGateM, gaugeDx, gaugeDy, gaugeDz, supRepair, Constraints3dRefineIterations)

fn Constraints3dSolveTrackedBudget(w: var World3d, residualGateM: float64, gaugeDx: var float64[], gaugeDy: var float64[], gaugeDz: var float64[], supRepair: var float64[], refineBudget: int32): float64 =
    constraints3dSweepCountLast = 0
    setLen(supRepair, 0)
    var szi: int32 = 0
    while szi < w.count * 4:
        add(supRepair, 0.0)
        szi = szi + 1
    var qw1: float64[]
    var qx1: float64[]
    var qy1: float64[]
    var qz1: float64[]
    setLen(qw1, 0)
    setLen(qx1, 0)
    setLen(qy1, 0)
    setLen(qz1, 0)
    var si: int32 = 0
    while si < w.count:
        add(qw1, w.bodyQuatW[si])
        add(qx1, w.bodyQuatX[si])
        add(qy1, w.bodyQuatY[si])
        add(qz1, w.bodyQuatZ[si])
        si = si + 1
    # base pass keeps its EXACT 96-sweep schedule: the solve trajectory
    # is part of the validated balance contract. The refine pass exits
    # as soon as the receipt gate is met — its tail sweeps past
    # convergence were 101 of the 124 ms tick on the standing-ball
    # scene. (A 100x tighter exit gate was tried: joint rows stall near
    # 0.1 mm, the refine budget exhausts every tick, and the stance
    # destabilizes — the plain gate is the keeper.)
    # BUGFIX (DUCK sweep instrument, 2026-09-19): the base gate was
    # 1e9 with a `<=` exit — every residual (mm scale) satisfies it on
    # the FIRST sweep, so the base pass has been running 1 sweep, not
    # 96, since the early-exit landing. A base gate of -1.0 (residuals
    # are >= 0) restores the intended never-exit schedule.
    # DUCK_SWEEP_EXIT_MM: residual-gated exit after a 4-sweep floor —
    # converged means converged; 96 is only the budget cap. The gate is
    # OR-ed with a RELATIVE-STALL test (improvement < 5% of the running
    # residual over one sweep): the loaded-equilibrium residual hovers
    # at the gate edge (0.6-1.0 mm measured) so an absolute gate alone
    # is bimodal — ticks either exit at the floor or burn the full 96
    # when the transient parks just above it. The stall test fires at
    # the flattening point regardless of the absolute level.
    var residual: float64 = 0.0
    if constraints3dBaseExitMm > 0:
        let baseGate = float64(constraints3dBaseExitMm) / 1000.0 / 1000.0
        var prevRes: float64 = 0.0
        var preIt: int32 = 0
        while preIt < 4:
            if preIt % 2 == 0:
                residual = constraints3dSweep(w, supRepair)
            else:
                residual = constraints3dSweepReversed(w, supRepair)
            constraints3dSweepCountLast = constraints3dSweepCountLast + 1
            prevRes = residual
            preIt = preIt + 1
        var stall: bool = false
        if residual <= baseGate:
            stall = true
        while stall == false:
            if preIt % 2 == 0:
                residual = constraints3dSweep(w, supRepair)
            else:
                residual = constraints3dSweepReversed(w, supRepair)
            constraints3dSweepCountLast = constraints3dSweepCountLast + 1
            preIt = preIt + 1
            if residual <= baseGate:
                stall = true
            # the stall exit may never trade away the receipt contract:
            # a flattened transient above the receipt gate keeps sweeping
            if prevRes > 0.0:
                if residual <= residualGateM:
                    if prevRes - residual < prevRes * 0.05:
                        stall = true
            prevRes = residual
            if preIt >= Constraints3dIterations:
                stall = true
    else:
        residual = constraints3dRun(w, Constraints3dIterations, 0.0 - 1.0, supRepair)
    constraints3dResidLastUm = int32(residual * 1000000000.0)
    if residual > residualGateM:
        residual = constraints3dRun(w, refineBudget, residualGateM, supRepair)
    # zero the gauge-delta buffers for every body: the removal gates to a
    # strict no-op whenever its safety conditions fail
    setLen(gaugeDx, 0)
    setLen(gaugeDy, 0)
    setLen(gaugeDz, 0)
    var zi: int32 = 0
    while zi < w.count:
        add(gaugeDx, 0.0)
        add(gaugeDy, 0.0)
        add(gaugeDz, 0.0)
        zi = zi + 1
    constraints3dGaugeRemove(w, residualGateM, residual, qw1, qx1, qy1, qz1, gaugeDx, gaugeDy, gaugeDz)
    return residual

fn Constraints3dSolve(w: var World3d, residualGateM: float64): float64 =
    var gaugeDx: float64[]
    var gaugeDy: float64[]
    var gaugeDz: float64[]
    var supRepair: float64[]
    return Constraints3dSolveTracked(w, residualGateM, gaugeDx, gaugeDy, gaugeDz, supRepair)

# --- Solve-window gauge-drift removal (pitch-ratchet fix) ---
#
# Every row this solver projects is INTERNAL (anchor gaps, axis
# alignment, servo flexion, distances), so the constraint set is exactly
# invariant under rigid rotations of all dynamic bodies: absolute
# attitude is pure gauge for the projection. Gauss-Seidel spends that
# gauge - the iteration path picks an asymmetric point on the solution
# manifold, and on a ground-standing assembly (whose ground contact is
# velocity-level + z-only pushout, pinning no attitude) the leftover
# common rotation re-injects every tick and ratchets the whole pose
# around the ground contact line. Measured: the flat-stand microduck and
# the minimal rig of src/tests/pitch_ratchet_probe.cheng both lean
# forward rigidly (feet axis.z and trunk tilt locked together) at
# ~0.004 rad/tick while joint angles hold - physics3d's angular rebuild
# reads the pose increment into omega and the ground LCP wipes the
# velocity evidence at the feet, so the pose increment itself stays and
# accumulates until the support load decays and the face slams down.
#
# After a converged solve this pass measures the solve-window rotation
# vector of every dynamic capsule (2*vec(q2 (x) q1^-1), the exact
# quantity the physics3d angular rebuild consumes) and removes its
# common component with ONE exact rigid rotation of all dynamic bodies:
#   - exactness: a rigid rotation of all dynamic bodies leaves every
#     internal constraint satisfied to the same residual, so the removal
#     cannot break the solve result and the returned residual stands;
#   - grounding: the rotation center sits on the ground plane (z = 0,
#     the engine-wide ground convention) under the dynamic-body
#     centroid, so ground-resting feet barely move and the support
#     cycle is intact;
#   - velocity channel: the rebuild spans this whole window, so removing
#     the common component here also removes it from omega - no spurious
#     spin, no LCP cleanup kick, no double count;
#   - safety gates (all must hold, else a strict no-op): solve converged
#     (real corrections in flight are not touched), no active constraint
#     references a static body (with an absolute anchor the gauge is
#     physical), and consensus - every measured capsule rotation agrees
#     with the common component within max(GaugeConsensusRad, its
#     magnitude), so differential-dominated motion (walk swing, topple,
#     impact transient) is never acted on.
fn constraints3dGaugeRemove(w: var World3d, residualGateM: float64, residual: float64, qw1: float64[], qx1: float64[], qy1: float64[], qz1: float64[], gaugeDx: var float64[], gaugeDy: var float64[], gaugeDz: var float64[]) =
    if residual > residualGateM:
        return
    var ci: int32 = 0
    while ci < w.conCount:
        if w.conActive[ci] == 1:
            if w.bodyInvMass[w.conA[ci]] <= 0.0:
                return
            if w.bodyInvMass[w.conB[ci]] <= 0.0:
                return
        ci = ci + 1
    # ground-touching capsules sit on an EXTERNAL constraint (the floor
    # plane): their rotation is contact repair, not assembly gauge —
    # excluded from both the common-rotation measure and the consensus
    # vote (with the support rows gait-gated, the standing feet rotate
    # from the contact LCP and their vote fails the 1 mrad band every
    # tick, which left the pitch ratchet unopposed — measured:
    # gaugeLastActTick stayed -1 through a 164-tick face-plant)
    var touch: bool[]
    setLen(touch, 0)
    var ti2: int32 = 0
    while ti2 < w.count:
        add(touch, false)
        ti2 = ti2 + 1
    var n: int32 = 0
    var sx: float64 = 0.0
    var sy: float64 = 0.0
    var sz: float64 = 0.0
    var i: int32 = 0
    while i < w.count:
        if w.bodyInvMass[i] > 0.0:
            if w.bodyKind[i] == world3d.World3dBodyCapsuleRigid:
                var isTouch: bool = false
                if w.bodyIxx[i] > 0.0:
                    let h = w.bodyCapsuleHalf[i]
                    let r = w.bodyRadius[i]
                    let qxt = w.bodyQuatX[i]
                    let qyt = w.bodyQuatY[i]
                    let azt = 1.0 - 2.0 * (qxt * qxt + qyt * qyt)
                    let g1t = w.bodyPz[i] + h * azt - r
                    let g2t = w.bodyPz[i] - h * azt - r
                    if g1t <= 0.001:
                        if g1t > 0.0 - 0.060:
                            isTouch = true
                    if g2t <= 0.001:
                        if g2t > 0.0 - 0.060:
                            isTouch = true
                touch[i] = isTouch
                if !isTouch:
                    let qw2 = w.bodyQuatW[i]
                    let qx2 = w.bodyQuatX[i]
                    let qy2 = w.bodyQuatY[i]
                    let qz2 = w.bodyQuatZ[i]
                    let qw1i = qw1[i]
                    let qx1i = qx1[i]
                    let qy1i = qy1[i]
                    let qz1i = qz1[i]
                    sx = sx + 2.0 * ((0.0 - qw2) * qx1i + qw1i * qx2 + (0.0 - qy2) * qz1i + qz2 * qy1i)
                    sy = sy + 2.0 * ((0.0 - qw2) * qy1i + qw1i * qy2 + (0.0 - qz2) * qx1i + qx2 * qz1i)
                    sz = sz + 2.0 * ((0.0 - qw2) * qz1i + qw1i * qz2 + (0.0 - qx2) * qy1i + qy2 * qx1i)
                    n = n + 1
        i = i + 1
    if n <= 0:
        return
    let invN = 1.0 / float64(n)
    let comx = sx * invN
    let comy = sy * invN
    let comz = sz * invN
    let comMag = numerics.CsgSqrt(comx * comx + comy * comy + comz * comz)
    if comMag < Constraints3dGaugeMinRad:
        return
    let tol = m.maxFloat(Constraints3dGaugeConsensusRad, comMag)
    var maxDev: float64 = 0.0
    i = 0
    while i < w.count:
        if w.bodyInvMass[i] > 0.0:
            if w.bodyKind[i] == world3d.World3dBodyCapsuleRigid:
                if !touch[i]:
                    let qw2 = w.bodyQuatW[i]
                    let qx2 = w.bodyQuatX[i]
                    let qy2 = w.bodyQuatY[i]
                    let qz2 = w.bodyQuatZ[i]
                    let qw1i = qw1[i]
                    let qx1i = qx1[i]
                    let qy1i = qy1[i]
                    let qz1i = qz1[i]
                    let relx = 2.0 * ((0.0 - qw2) * qx1i + qw1i * qx2 + (0.0 - qy2) * qz1i + qz2 * qy1i)
                    let rely = 2.0 * ((0.0 - qw2) * qy1i + qw1i * qy2 + (0.0 - qz2) * qx1i + qx2 * qz1i)
                    let relz = 2.0 * ((0.0 - qw2) * qz1i + qw1i * qz2 + (0.0 - qx2) * qy1i + qy2 * qx1i)
                    let devx = relx - comx
                    let devy = rely - comy
                    let devz = relz - comz
                    let dev = numerics.CsgSqrt(devx * devx + devy * devy + devz * devz)
                    if dev > maxDev:
                        maxDev = dev
        i = i + 1
    if maxDev > tol:
        return
    # rotation center: ground plane under the SUPPORT CONTACT PATCH - the
    # average of the touching poles of constraint-held capsules - with the
    # dynamic-body centroid as the airborne fallback. The original
    # centroid choice slid the whole support sideways on every removal
    # (measured: the flat-stand microduck accelerated sideways at
    # ~0.2 mm/s per tick because each removal displaced the feet across
    # the ground, the solve then hauled the config back, and the Verlet
    # rebuild billed the corrections as COM velocity). Rotating about the
    # patch instead keeps the contact geometry intact: the support poles
    # sit on the rotation axis and barely move, the common lean is still
    # removed exactly, and no post-removal repair chase remains.
    var nAll: int32 = 0
    var nPatch: int32 = 0
    var cx: float64 = 0.0
    var cy: float64 = 0.0
    var pxc: float64 = 0.0
    var pyc: float64 = 0.0
    i = 0
    while i < w.count:
        if w.bodyInvMass[i] > 0.0:
            cx = cx + w.bodyPx[i]
            cy = cy + w.bodyPy[i]
            nAll = nAll + 1
            if w.bodyKind[i] == world3d.World3dBodyCapsuleRigid:
                if w.bodyIxx[i] > 0.0:
                    # touching = either pole at or below the plane; only
                    # capsules the active constraint set holds count as
                    # support (a free resting capsule may slide freely)
                    var held = false
                    var ci: int32 = 0
                    while ci < w.conCount:
                        if w.conActive[ci] == 1:
                            if w.conA[ci] == i || w.conB[ci] == i:
                                held = true
                        ci = ci + 1
                    if held:
                        let h = w.bodyCapsuleHalf[i]
                        let r = w.bodyRadius[i]
                        let qx2 = w.bodyQuatX[i]
                        let qy2 = w.bodyQuatY[i]
                        let axw = 2.0 * (qx2 * w.bodyQuatZ[i] + w.bodyQuatW[i] * qy2)
                        let ayw = 2.0 * (qy2 * w.bodyQuatZ[i] - w.bodyQuatW[i] * qx2)
                        let azw = 1.0 - 2.0 * (qx2 * qx2 + qy2 * qy2)
                        let g1 = w.bodyPz[i] + h * azw - r
                        let g2 = w.bodyPz[i] - h * azw - r
                        if g1 <= 0.0:
                            pxc = pxc + w.bodyPx[i] + h * axw
                            pyc = pyc + w.bodyPy[i] + h * ayw
                            nPatch = nPatch + 1
                        if g2 <= 0.0:
                            pxc = pxc + w.bodyPx[i] - h * axw
                            pyc = pyc + w.bodyPy[i] - h * ayw
                            nPatch = nPatch + 1
        i = i + 1
    if nAll <= 0:
        return
    if nPatch > 0:
        cx = pxc / float64(nPatch)
        cy = pyc / float64(nPatch)
    else:
        cx = cx / float64(nAll)
        cy = cy / float64(nAll)
    # exact inverse rotation: angle comMag about -com/comMag
    constraints3dGaugeLastActTick = int32(w.tick)
    let invMag = 1.0 / comMag
    let half = 0.5 * comMag
    let rw = m.cosFloat(half)
    let rs = m.sinFloat(half) * invMag
    let rx = (0.0 - comx) * rs
    let ry = (0.0 - comy) * rs
    let rz = (0.0 - comz) * rs
    i = 0
    while i < w.count:
        if w.bodyInvMass[i] > 0.0:
            let dxp = w.bodyPx[i] - cx
            let dyp = w.bodyPy[i] - cy
            let dzp = w.bodyPz[i]
            let rv = constraints3dQuatRot(rw, rx, ry, rz, constraints3dVec(dxp, dyp, dzp))
            let npx = cx + rv.x
            let npy = cy + rv.y
            let npz = rv.z
            gaugeDx[i] = npx - w.bodyPx[i]
            gaugeDy[i] = npy - w.bodyPy[i]
            gaugeDz[i] = npz - w.bodyPz[i]
            w.bodyPx[i] = npx
            w.bodyPy[i] = npy
            w.bodyPz[i] = npz
            if w.bodyKind[i] == world3d.World3dBodyCapsuleRigid:
                let qw = w.bodyQuatW[i]
                let qx = w.bodyQuatX[i]
                let qy = w.bodyQuatY[i]
                let qz = w.bodyQuatZ[i]
                let nw = rw * qw - rx * qx - ry * qy - rz * qz
                let nx = rw * qx + rx * qw + ry * qz - rz * qy
                let ny = rw * qy - rx * qz + ry * qw + rz * qx
                let nz = rw * qz + rx * qy - ry * qx + rz * qw
                let qn = numerics.CsgSqrt(nw * nw + nx * nx + ny * ny + nz * nz)
                w.bodyQuatW[i] = nw / qn
                w.bodyQuatX[i] = nx / qn
                w.bodyQuatY[i] = ny / qn
                w.bodyQuatZ[i] = nz / qn
        i = i + 1

# --- Joint operators (kinds 7..10, design doc torque-motor §1-§3) ---
#
# All rows are position-level projections over the generalized inverse
# masses: a scalar row with translation lever t and angular lever n on body
# i gets w_i = invM_i |t|^2 + n . I_world^-1(n) and the applied correction
# is Delta x = lambda invM t, Delta theta = lambda I_world^-1(n) with
# lambda = -C / sum(w_i) — the same shape as the scalar distance row above,
# with the capsule's symmetric-top I_world^-1 applied in closed form.
# Rotation corrections touch only the quaternion (Delta x angular rows are
# pure couples); the anchor rows carry translation plus rotation, solved as
# one coupled 3x3 block so the 5 hinge rows stay order-unbiased within a
# single projection call.

const
    Constraints3dJointEps = 0.000000001
    Constraints3dAnchorDetMin = 0.000000000000000001
    # Cholesky pivot floor on the Jacobi-scaled joint block (unit
    # diagonal): a smaller pivot means the included rows are dependent —
    # a configuration error, same contract as AnchorDetMin above
    Constraints3dJointPivotMin = 0.000000000001
    # SOR-style under-relaxation of the joint block apply: the head
    # chain's 5.7 g carrier sandwiched between the 36.8 g neck and the
    # 172.6 g head makes plain Gauss-Seidel over the four-hinge chain
    # DIVERGE (the head-pitch anchor gap cycles 9->2->9 mm sweep over
    # sweep — amplification product >= 1). A uniform 0.7 contraction
    # per sweep pulls the spectral radius under 1; convergence costs a
    # few more sweeps, which the 96-sweep base schedule already pays.
    Constraints3dJointRelax = 0.7
    # gauge-drift removal gates (see constraints3dGaugeRemove): below
    # GaugeMinRad the common rotation is float dust; the consensus gate
    # tolerates the larger of GaugeConsensusRad and the common magnitude
    # itself, so near-rigid fields act and differential-dominated fields
    # (walk swing, topple, impact) stay untouched
    Constraints3dGaugeMinRad = 0.000000001
    Constraints3dGaugeConsensusRad = 0.001

type
    Constraints3dVec3 =
        x: float64
        y: float64
        z: float64
    Constraints3dMat3 =
        k11: float64
        k12: float64
        k13: float64
        k22: float64
        k23: float64
        k33: float64

fn constraints3dVec(vx: float64, vy: float64, vz: float64): Constraints3dVec3 =
    var v: Constraints3dVec3
    v.x = vx
    v.y = vy
    v.z = vz
    return v

fn constraints3dMat3Zero(): Constraints3dMat3 =
    var m: Constraints3dMat3
    m.k11 = 0.0
    m.k12 = 0.0
    m.k13 = 0.0
    m.k22 = 0.0
    m.k23 = 0.0
    m.k33 = 0.0
    return m

# R v for a unit quaternion.
fn constraints3dQuatRot(qw: float64, qx: float64, qy: float64, qz: float64, v: Constraints3dVec3): Constraints3dVec3 =
    let tx = 2.0 * (qy * v.z - qz * v.y)
    let ty = 2.0 * (qz * v.x - qx * v.z)
    let tz = 2.0 * (qx * v.y - qy * v.x)
    let ux = qy * tz - qz * ty
    let uy = qz * tx - qx * tz
    let uz = qx * ty - qy * tx
    return constraints3dVec(v.x + qw * tx + ux, v.y + qw * ty + uy, v.z + qw * tz + uz)

@borrows
fn constraints3dBodyQuatRot(w: World3d, slot: int32, v: Constraints3dVec3): Constraints3dVec3 =
    return constraints3dQuatRot(w.bodyQuatW[slot], w.bodyQuatX[slot], w.bodyQuatY[slot], w.bodyQuatZ[slot], v)

# I_world^-1 v for the capsule symmetric top: split along the world axis
# (image of local +Z), perpendicular part over the transverse moment,
# parallel part over the axial moment. Caller guarantees invMass > 0 and
# bodyIxx > 0.
@borrows
fn constraints3dCapsuleInvInertia(w: World3d, slot: int32, v: Constraints3dVec3): Constraints3dVec3 =
    let axis = constraints3dBodyQuatRot(w, slot, constraints3dVec(0.0, 0.0, 1.0))
    let par = v.x * axis.x + v.y * axis.y + v.z * axis.z
    let px = v.x - par * axis.x
    let py = v.y - par * axis.y
    let pz = v.z - par * axis.z
    let it = w.bodyIxx[slot]
    let ia = w.bodyIzz[slot]
    return constraints3dVec(px / it + par * axis.x / ia, py / it + par * axis.y / ia, pz / it + par * axis.z / ia)

@borrows
fn constraints3dAngularGenMassPivot(w: World3d, slot: int32, nx: float64, ny: float64, nz: float64, px: float64, py: float64, pz: float64): float64 =
    if w.bodyInvMass[slot] <= 0.0:
        return 0.0
    let base = constraints3dAngularGenMass(w, slot, nx, ny, nz)
    let qw = w.bodyQuatW[slot]
    let qx = w.bodyQuatX[slot]
    let qy = w.bodyQuatY[slot]
    let qz = w.bodyQuatZ[slot]
    let rwx = (1.0 - 2.0 * (qy * qy + qz * qz)) * px + 2.0 * (qx * qy - qz * qw) * py + 2.0 * (qx * qz + qy * qw) * pz
    let rwy = 2.0 * (qx * qy + qz * qw) * px + (1.0 - 2.0 * (qx * qx + qz * qz)) * py + 2.0 * (qy * qz - qx * qw) * pz
    let rwz = 2.0 * (qx * qz - qy * qw) * px + 2.0 * (qy * qz + qx * qw) * py + (1.0 - 2.0 * (qx * qx + qy * qy)) * pz
    let cx = rwy * nz - rwz * ny
    let cy = rwz * nx - rwx * nz
    let cz = rwx * ny - rwy * nx
    return base + w.bodyInvMass[slot] * (cx * cx + cy * cy + cz * cz)

# Generalized inverse mass of the angular lever n (n . Iinv n), zero for
# bodies without rotational dynamics.
@borrows
fn constraints3dAngularGenMass(w: World3d, slot: int32, nx: float64, ny: float64, nz: float64): float64 =
    if w.bodyInvMass[slot] <= 0.0:
        return 0.0
    if w.bodyKind[slot] != world3d.World3dBodyCapsuleRigid:
        return 0.0
    if w.bodyIxx[slot] <= 0.0:
        return 0.0
    let u = constraints3dCapsuleInvInertia(w, slot, constraints3dVec(nx, ny, nz))
    return nx * u.x + ny * u.y + nz * u.z

# World-frame small rotation applied to the pose: q <- normalize((r/2, 1)) * q.
# World small rotation about a BODY-LOCAL pivot: the quaternion rides
# as in ApplyWorldRot and the COM translates by dw x r_world so the
# pivot stays fixed — the pair (GenMassPivot, ApplyWorldRotPivot) is
# the XPBD angular row about a joint.
@borrows
fn constraints3dApplyWorldRotPivot(w: var World3d, slot: int32, rx: float64, ry: float64, rz: float64, dx: float64, dy: float64, dz: float64) =
    let qw = w.bodyQuatW[slot]
    let qx = w.bodyQuatX[slot]
    let qy = w.bodyQuatY[slot]
    let qz = w.bodyQuatZ[slot]
    # COM translation dr supplied by the caller: s * invM * (r x n),
    # the XPBD position part of the pivot rotation (NOT dw x r — the
    # inertia makes dw x r inconsistent with the mass term)
    w.bodyPx[slot] = w.bodyPx[slot] + dx
    w.bodyPy[slot] = w.bodyPy[slot] + dy
    w.bodyPz[slot] = w.bodyPz[slot] + dz
    let hx = rx * 0.5
    let hy = ry * 0.5
    let hz = rz * 0.5
    let nw = qw - hx * qx - hy * qy - hz * qz
    let nx = qx + hx * qw + hy * qz - hz * qy
    let ny = qy - hx * qz + hy * qw + hz * qx
    let nz = qz + hx * qy - hy * qx + hz * qw
    let qn = numerics.CsgSqrt(nw * nw + nx * nx + ny * ny + nz * nz)
    w.bodyQuatW[slot] = nw / qn
    w.bodyQuatX[slot] = nx / qn
    w.bodyQuatY[slot] = ny / qn
    w.bodyQuatZ[slot] = nz / qn

fn constraints3dApplyWorldRot(w: var World3d, slot: int32, rx: float64, ry: float64, rz: float64) =
    # per-tick attitude correction rate limiter: a legitimate constraint
    # repair rotates a body by microradians per tick; anything past
    # 0.35 rad/tick is numerical churn (a light welded body's solve
    # correction resonating through the contact layer) and would feed
    # the Verlet angular rebuild an absurd omega
    let rm = numerics.CsgSqrt(rx * rx + ry * ry + rz * rz)
    var rx2: float64 = rx
    var ry2: float64 = ry
    var rz2: float64 = rz
    if rm > 0.35:
        let sc = 0.35 / rm
        rx2 = rx * sc
        ry2 = ry * sc
        rz2 = rz * sc
    let qw = w.bodyQuatW[slot]
    let qx = w.bodyQuatX[slot]
    let qy = w.bodyQuatY[slot]
    let qz = w.bodyQuatZ[slot]
    let hx = rx2 * 0.5
    let hy = ry2 * 0.5
    let hz = rz2 * 0.5
    let nw = qw - hx * qx - hy * qy - hz * qz
    let nx = qx + hx * qw + hy * qz - hz * qy
    let ny = qy - hx * qz + hy * qw + hz * qx
    let nz = qz + hx * qy - hy * qx + hz * qw
    let qn = numerics.CsgSqrt(nw * nw + nx * nx + ny * ny + nz * nz)
    w.bodyQuatW[slot] = nw / qn
    w.bodyQuatX[slot] = nx / qn
    w.bodyQuatY[slot] = ny / qn
    w.bodyQuatZ[slot] = nz / qn

# Generalized inverse-mass block of one body for an anchor arm r:
# K_i = invM_i I - [r]x Iinv [r]x (point masses carry only the linear part).
@borrows
fn constraints3dBodyK(w: World3d, slot: int32, rx: float64, ry: float64, rz: float64): Constraints3dMat3 =
    var m = constraints3dMat3Zero()
    let invM = w.bodyInvMass[slot]
    m.k11 = invM
    m.k22 = invM
    m.k33 = invM
    if invM <= 0.0:
        return m
    if w.bodyKind[slot] != world3d.World3dBodyCapsuleRigid:
        return m
    if w.bodyIxx[slot] <= 0.0:
        return m
    # columns of [r]x Iinv [r]x: c_j = r x Iinv(r x e_j). Symmetric storage:
    # each off-diagonal is written exactly once (column j accumulates only
    # rows >= j), otherwise the shared slots double-count and poison K.
    var t = constraints3dVec(0.0, rz, 0.0 - ry)
    var u = constraints3dCapsuleInvInertia(w, slot, t)
    var c = constraints3dVec(ry * u.z - rz * u.y, rz * u.x - rx * u.z, rx * u.y - ry * u.x)
    m.k11 = m.k11 - c.x
    m.k12 = m.k12 - c.y
    m.k13 = m.k13 - c.z
    t = constraints3dVec(0.0 - rz, 0.0, rx)
    u = constraints3dCapsuleInvInertia(w, slot, t)
    c = constraints3dVec(ry * u.z - rz * u.y, rz * u.x - rx * u.z, rx * u.y - ry * u.x)
    m.k22 = m.k22 - c.y
    m.k23 = m.k23 - c.z
    t = constraints3dVec(ry, 0.0 - rx, 0.0)
    u = constraints3dCapsuleInvInertia(w, slot, t)
    c = constraints3dVec(ry * u.z - rz * u.y, rz * u.x - rx * u.z, rx * u.y - ry * u.x)
    m.k33 = m.k33 - c.z
    return m

# Cramer solve of the symmetric 3x3 block K j = s. A non-positive or
# non-finite determinant is a configuration error (nothing can move) and
# panics instead of being silently skipped.
fn constraints3dSolveSym3(k: Constraints3dMat3, sx: float64, sy: float64, sz: float64): Constraints3dVec3 =
    let a = k.k11
    let b = k.k12
    let c = k.k13
    let d = k.k22
    let e = k.k23
    let f = k.k33
    let c11 = d * f - e * e
    let c12 = c * e - b * f
    let c13 = b * e - c * d
    let c22 = a * f - c * c
    let c23 = b * c - a * e
    let c33 = a * d - b * b
    let det = a * c11 + b * c12 + c * c13
    if !(det > Constraints3dAnchorDetMin):
        panic("constraints3d: singular joint anchor block")
    return constraints3dVec((c11 * sx + c12 * sy + c13 * sz) / det, (c12 * sx + c22 * sy + c23 * sz) / det, (c13 * sx + c23 * sy + c33 * sz) / det)

# Coupled 3-row anchor block: bring the world anchor points of the two
# constraint slots together (SpherePin uses a zero anchor on the point
# side; Hinge shares this block as its C0..C2 rows). Returns the max
# anchor component error in metres after the projection.
fn constraints3dProjectAnchors(w: var World3d, ci: int32): float64 =
    let aSlot = w.conA[ci]
    let bSlot = w.conB[ci]
    let rA = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci]))
    let rB = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAnchBx[ci], w.conAnchBy[ci], w.conAnchBz[ci]))
    let cx = (w.bodyPx[bSlot] + rB.x) - (w.bodyPx[aSlot] + rA.x)
    let cy = (w.bodyPy[bSlot] + rB.y) - (w.bodyPy[aSlot] + rA.y)
    let cz = (w.bodyPz[bSlot] + rB.z) - (w.bodyPz[aSlot] + rA.z)
    var k = constraints3dMat3Zero()
    let ka = constraints3dBodyK(w, aSlot, rA.x, rA.y, rA.z)
    k.k11 = k.k11 + ka.k11
    k.k12 = k.k12 + ka.k12
    k.k13 = k.k13 + ka.k13
    k.k22 = k.k22 + ka.k22
    k.k23 = k.k23 + ka.k23
    k.k33 = k.k33 + ka.k33
    let kb = constraints3dBodyK(w, bSlot, rB.x, rB.y, rB.z)
    k.k11 = k.k11 + kb.k11
    k.k12 = k.k12 + kb.k12
    k.k13 = k.k13 + kb.k13
    k.k22 = k.k22 + kb.k22
    k.k23 = k.k23 + kb.k23
    k.k33 = k.k33 + kb.k33
    let j = constraints3dSolveSym3(k, 0.0 - cx, 0.0 - cy, 0.0 - cz)
    # body A moves against the multiplier, body B along it; the rotation
    # vectors go through the world-frame inverse inertia
    if w.bodyInvMass[aSlot] > 0.0:
        w.bodyPx[aSlot] = w.bodyPx[aSlot] - w.bodyInvMass[aSlot] * j.x
        w.bodyPy[aSlot] = w.bodyPy[aSlot] - w.bodyInvMass[aSlot] * j.y
        w.bodyPz[aSlot] = w.bodyPz[aSlot] - w.bodyInvMass[aSlot] * j.z
        if w.bodyKind[aSlot] == world3d.World3dBodyCapsuleRigid:
            if w.bodyIxx[aSlot] > 0.0:
                let t = constraints3dCapsuleInvInertia(w, aSlot, constraints3dVec(rA.y * j.z - rA.z * j.y, rA.z * j.x - rA.x * j.z, rA.x * j.y - rA.y * j.x))
                constraints3dApplyWorldRot(w, aSlot, 0.0 - t.x, 0.0 - t.y, 0.0 - t.z)
    if w.bodyInvMass[bSlot] > 0.0:
        w.bodyPx[bSlot] = w.bodyPx[bSlot] + w.bodyInvMass[bSlot] * j.x
        w.bodyPy[bSlot] = w.bodyPy[bSlot] + w.bodyInvMass[bSlot] * j.y
        w.bodyPz[bSlot] = w.bodyPz[bSlot] + w.bodyInvMass[bSlot] * j.z
        if w.bodyKind[bSlot] == world3d.World3dBodyCapsuleRigid:
            if w.bodyIxx[bSlot] > 0.0:
                let t = constraints3dCapsuleInvInertia(w, bSlot, constraints3dVec(rB.y * j.z - rB.z * j.y, rB.z * j.x - rB.x * j.z, rB.x * j.y - rB.y * j.x))
                constraints3dApplyWorldRot(w, bSlot, t.x, t.y, t.z)
    let ax = m.absFloat(cx)
    let ay = m.absFloat(cy)
    let az = m.absFloat(cz)
    var out = ax
    if ay > out:
        out = ay
    if az > out:
        out = az
    return out

# Lean local trig for the acos fast path: pure deterministic arithmetic,
# no std Taylor recursion (the recursion's per-call cost was the single
# largest term in the sweep budget). sin on [0, pi/2] via a 6-term
# Horner series (error ~1e-12, orders below the 1e-6 rad target); cos on
# [0, pi] via the half-range symmetry.
fn constraints3dSinHalf(t: float64): float64 =
    let y = t * t
    return t * (1.0 + y * (-0.16666666666666666 + y * (0.008333333333333333 + y * (-0.0001984126984126984 + y * (0.0000027557319223985893 + y * (-0.000000025052108385441718))))))

fn constraints3dCos01(x: float64): float64 =
    # cos for x in [0, pi]
    if x <= 1.5707963267948966:
        return constraints3dSinHalf(1.5707963267948966 - x)
    return 0.0 - constraints3dSinHalf(x - 1.5707963267948966)

fn constraints3dSin01(x: float64): float64 =
    # sin for x in [0, pi]
    if x <= 1.5707963267948966:
        return constraints3dSinHalf(x)
    return constraints3dSinHalf(3.141592653589793 - x)

# Fast acos: asin-series seed + Newton polish on cos, all lean trig.
# ~1e-9 rad converged (the 22-round bisection delivered pi/2^22). Near
# the poles (|c| > 0.98) Newton's sin denominator collapses, so those
# take a short bisection on the small-angle branch instead.
fn constraints3dAcosFast(c: float64): float64 =
    var cc = c
    if cc > 1.0:
        cc = 1.0
    if cc < 0.0 - 1.0:
        cc = 0.0 - 1.0
    var neg: bool = false
    if cc < 0.0:
        neg = true
        cc = 0.0 - cc
    var th: float64 = 0.0
    if cc > 0.98:
        # pole branch: acos in [0, 0.2003], bisect 10 rounds (~1e-4 abs,
        # irrelevant at angles this small)
        var lo: float64 = 0.0
        var hi: float64 = 0.2003346974049604
        var i: int32 = 0
        while i < 10:
            let mid = (lo + hi) * 0.5
            if constraints3dCos01(mid) > cc:
                lo = mid
            else:
                hi = mid
            i = i + 1
        th = (lo + hi) * 0.5
    else:
        # asin-series seed (4 terms) then Newton on cos(theta) - cc:
        #   theta <- theta + (cos(theta) - cc) / sin(theta)
        th = 1.5707963267948966 - (cc + cc * cc * cc / 6.0 + cc * cc * cc * cc * cc * 0.075 + cc * cc * cc * cc * cc * cc * cc * 0.044642857142857146)
        var i: int32 = 0
        while i < 4:
            if th < 0.000001:
                th = 0.000001
            if th > 3.141592653589793 - 0.000001:
                th = 3.141592653589793 - 0.000001
            let f = constraints3dCos01(th) - cc
            let sp = constraints3dSin01(th)
            th = th + f / sp
            i = i + 1
        if th < 0.0:
            th = 0.0
        if th > 3.141592653589793:
            th = 3.141592653589793
    if neg:
        return 3.141592653589793 - th
    return th

# Flexion angle of a hinge constraint (radians, signed): cos via the dot of
# A's world reference with B's de-projected world reference, sign via the
# scalar triple product with the hinge axis — zero atan2, Newton acos.
@borrows
fn Constraints3dHingeAngle(w: World3d, ci: int32): float64 =
    let aSlot = w.conA[ci]
    let bSlot = w.conB[ci]
    let uB = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAxisBx[ci], w.conAxisBy[ci], w.conAxisBz[ci]))
    let dA = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conRefAx[ci], w.conRefAy[ci], w.conRefAz[ci]))
    let bRaw = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conRefBx[ci], w.conRefBy[ci], w.conRefBz[ci]))
    let dotBU = bRaw.x * uB.x + bRaw.y * uB.y + bRaw.z * uB.z
    let bx = bRaw.x - dotBU * uB.x
    let by = bRaw.y - dotBU * uB.y
    let bz = bRaw.z - dotBU * uB.z
    var bn = numerics.CsgSqrt(bx * bx + by * by + bz * bz)
    if bn < Constraints3dJointEps:
        # degenerate projection (axis rows far outside tolerance): clamp
        # domain like jointMotorAcos instead of dividing by zero
        bn = Constraints3dJointEps
    let c = dA.x * bx / bn + dA.y * by / bn + dA.z * bz / bn
    var c2 = c
    if c2 > 1.0:
        c2 = 1.0
    if c2 < -1.0:
        c2 = -1.0
    let ang = constraints3dAcosFast(c2)
    let sx = dA.y * bz - dA.z * by
    let sy = dA.z * bx - dA.x * bz
    let sz = dA.x * by - dA.y * bx
    let sign = sx * uB.x + sy * uB.y + sz * uB.z
    if sign >= 0.0:
        return ang
    return 0.0 - ang

# World distance between the two anchor points of a joint constraint
# (probe-facing residual measure; the point side carries a zero anchor).
@borrows
fn Constraints3dJointAnchorGap(w: World3d, ci: int32): float64 =
    let rA = constraints3dBodyQuatRot(w, w.conA[ci], constraints3dVec(w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci]))
    let rB = constraints3dBodyQuatRot(w, w.conB[ci], constraints3dVec(w.conAnchBx[ci], w.conAnchBy[ci], w.conAnchBz[ci]))
    let dx = (w.bodyPx[w.conB[ci]] + rB.x) - (w.bodyPx[w.conA[ci]] + rA.x)
    let dy = (w.bodyPy[w.conB[ci]] + rB.y) - (w.bodyPy[w.conA[ci]] + rA.y)
    let dz = (w.bodyPz[w.conB[ci]] + rB.z) - (w.bodyPz[w.conA[ci]] + rA.z)
    return numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)

# One unilateral/bilateral scalar angle row about the hinge axis u: the
# flexion of body B against body A is driven toward `target`. Rotating B
# about u changes the angle by +delta, rotating A by -delta (levers -u, +u
# through the symmetric-top inverse inertia); pure couples, no translation.
fn constraints3dProjectAngleRow(w: var World3d, ci: int32, ux: float64, uy: float64, uz: float64, target: float64, oneSidedHigh: bool, oneSidedLow: bool): float64 =
    let theta = Constraints3dHingeAngle(w, ci)
    let c = theta - target
    if oneSidedHigh:
        if c < 0.0:
            return 0.0
    if oneSidedLow:
        if c > 0.0:
            return 0.0
    let aSlot = w.conA[ci]
    let bSlot = w.conB[ci]
    # pivot-corrected PAIR: the mass term and the apply both derive
    # from the same pivot lambda (rotating about the joint, not the
    # COM) — the earlier mass-only attempt understated nothing but
    # applied inconsistently and exploded
    let wA = constraints3dAngularGenMassPivot(w, aSlot, ux, uy, uz, w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci])
    let wB = constraints3dAngularGenMassPivot(w, bSlot, ux, uy, uz, w.conAnchBx[ci], w.conAnchBy[ci], w.conAnchBz[ci])
    # from the same pivot lambda (rotating about the joint, not the
    # COM) — the earlier mass-only attempt understated nothing but
    # applied inconsistently and exploded
    let wA = constraints3dAngularGenMassPivot(w, aSlot, ux, uy, uz, w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci])
    let wB = constraints3dAngularGenMassPivot(w, bSlot, ux, uy, uz, w.conAnchBx[ci], w.conAnchBy[ci], w.conAnchBz[ci])
    let wSum = wA + wB
    if wSum <= Constraints3dJointEps:
        return m.absFloat(c)
    let s = (0.0 - c) / wSum
    if w.bodyInvMass[aSlot] > 0.0:
        if w.bodyKind[aSlot] == world3d.World3dBodyCapsuleRigid:
            if w.bodyIxx[aSlot] > 0.0:
                let t = constraints3dCapsuleInvInertia(w, aSlot, constraints3dVec(ux, uy, uz))
                let rA = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci]))
                let drxA = (0.0 - s) * w.bodyInvMass[aSlot] * (rA.y * uz - rA.z * uy)
                let dryA = (0.0 - s) * w.bodyInvMass[aSlot] * (rA.z * ux - rA.x * uz)
                let drzA = (0.0 - s) * w.bodyInvMass[aSlot] * (rA.x * uy - rA.y * ux)
                constraints3dApplyWorldRotPivot(w, aSlot, (0.0 - s) * t.x, (0.0 - s) * t.y, (0.0 - s) * t.z, drxA, dryA, drzA)
    if w.bodyInvMass[bSlot] > 0.0:
        if w.bodyKind[bSlot] == world3d.World3dBodyCapsuleRigid:
            if w.bodyIxx[bSlot] > 0.0:
                let t = constraints3dCapsuleInvInertia(w, bSlot, constraints3dVec(ux, uy, uz))
                let rB = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAnchBx[ci], w.conAnchBy[ci], w.conAnchBz[ci]))
                let drxB = s * w.bodyInvMass[bSlot] * (rB.y * uz - rB.z * uy)
                let dryB = s * w.bodyInvMass[bSlot] * (rB.z * ux - rB.x * uz)
                let drzB = s * w.bodyInvMass[bSlot] * (rB.x * uy - rB.y * ux)
                constraints3dApplyWorldRotPivot(w, bSlot, s * t.x, s * t.y, s * t.z, drxB, dryB, drzB)
    # 解析锚点补偿：角行旋转把两体锚点推开 break 向量——把 break
    # 按 invMass 比例平移两体 COM 使锚点重新闭合。角修正本身保留
    # （这就是全联立：角修正+锚点补偿在同一次施加中自洽）。
    let anchorA2 = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci]))
    let anchorB2 = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAnchBx[ci], w.conAnchBy[ci], w.conAnchBz[ci]))
    let bkX = (w.bodyPx[bSlot] + anchorB2.x) - (w.bodyPx[aSlot] + anchorA2.x)
    let bkY = (w.bodyPy[bSlot] + anchorB2.y) - (w.bodyPy[aSlot] + anchorA2.y)
    let bkZ = (w.bodyPz[bSlot] + anchorB2.z) - (w.bodyPz[aSlot] + anchorA2.z)
    let invSum2 = w.bodyInvMass[aSlot] + w.bodyInvMass[bSlot]
    if invSum2 > 1e-15:
        w.bodyPx[aSlot] = w.bodyPx[aSlot] + bkX * (w.bodyInvMass[aSlot] / invSum2)
        w.bodyPy[aSlot] = w.bodyPy[aSlot] + bkY * (w.bodyInvMass[aSlot] / invSum2)
        w.bodyPz[aSlot] = w.bodyPz[aSlot] + bkZ * (w.bodyInvMass[aSlot] / invSum2)
        w.bodyPx[bSlot] = w.bodyPx[bSlot] - bkX * (w.bodyInvMass[bSlot] / invSum2)
        w.bodyPy[bSlot] = w.bodyPy[bSlot] - bkY * (w.bodyInvMass[bSlot] / invSum2)
        w.bodyPz[bSlot] = w.bodyPz[bSlot] - bkZ * (w.bodyInvMass[bSlot] / invSum2)
    return m.absFloat(c)

# One axis-parallel row (C3/C4): d world against B's world axis uB. The
# lever of A is d x uB, that of B is uB x d; anchor arms do not enter.
fn constraints3dProjectAxisRow(w: var World3d, ci: int32, d: Constraints3dVec3, uB: Constraints3dVec3): float64 =
    let c = d.x * uB.x + d.y * uB.y + d.z * uB.z
    let aSlot = w.conA[ci]
    let bSlot = w.conB[ci]
    let nAx = d.y * uB.z - d.z * uB.y
    let nAy = d.z * uB.x - d.x * uB.z
    let nAz = d.x * uB.y - d.y * uB.x
    let nBx = uB.y * d.z - uB.z * d.y
    let nBy = uB.z * d.x - uB.x * d.z
    let nBz = uB.x * d.y - uB.y * d.x
    let wA = constraints3dAngularGenMass(w, aSlot, nAx, nAy, nAz)
    let wB = constraints3dAngularGenMass(w, bSlot, nBx, nBy, nBz)
    let wSum = wA + wB
    if wSum <= Constraints3dJointEps:
        return m.absFloat(c)
    let s = (0.0 - c) / wSum
    if w.bodyInvMass[aSlot] > 0.0:
        if w.bodyKind[aSlot] == world3d.World3dBodyCapsuleRigid:
            if w.bodyIxx[aSlot] > 0.0:
                let t = constraints3dCapsuleInvInertia(w, aSlot, constraints3dVec(nAx, nAy, nAz))
                constraints3dApplyWorldRot(w, aSlot, s * t.x, s * t.y, s * t.z)
    if w.bodyInvMass[bSlot] > 0.0:
        if w.bodyKind[bSlot] == world3d.World3dBodyCapsuleRigid:
            if w.bodyIxx[bSlot] > 0.0:
                let t = constraints3dCapsuleInvInertia(w, bSlot, constraints3dVec(nBx, nBy, nBz))
                constraints3dApplyWorldRot(w, bSlot, s * t.x, s * t.y, s * t.z)
    return m.absFloat(c)

# Anchor distance servo (kind 8): one bilateral row closing
# |x_point - (x_cap + R*anchor)| - cmd with the capsule entering through
# its full generalized mass (translation + anchor-arm rotation).
fn constraints3dProjectAnchorDist(w: var World3d, ci: int32): float64 =
    let capSlot = w.conA[ci]
    let pointSlot = w.conB[ci]
    let rC = constraints3dBodyQuatRot(w, capSlot, constraints3dVec(w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci]))
    let dx = w.bodyPx[pointSlot] - (w.bodyPx[capSlot] + rC.x)
    let dy = w.bodyPy[pointSlot] - (w.bodyPy[capSlot] + rC.y)
    let dz = w.bodyPz[pointSlot] - (w.bodyPz[capSlot] + rC.z)
    let dist = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
    let c = dist - w.conCmd[ci]
    if dist <= Constraints3dSlackEps:
        return m.absFloat(c)
    let invMassP = w.bodyInvMass[pointSlot]
    let invMassC = w.bodyInvMass[capSlot]
    let tx = dx / dist
    let ty = dy / dist
    let tz = dz / dist
    # angular lever of the capsule: dHat x rC would be the lever of the
    # anchor speed, so the row lever is -(rC x dHat); sign folded below
    let wSum = invMassP + invMassC + constraints3dAngularGenMass(w, capSlot, rC.y * tz - rC.z * ty, rC.z * tx - rC.x * tz, rC.x * ty - rC.y * tx)
    if wSum <= Constraints3dJointEps:
        return m.absFloat(c)
    let s = (0.0 - c) / wSum
    if invMassP > 0.0:
        w.bodyPx[pointSlot] = w.bodyPx[pointSlot] + invMassP * s * tx
        w.bodyPy[pointSlot] = w.bodyPy[pointSlot] + invMassP * s * ty
        w.bodyPz[pointSlot] = w.bodyPz[pointSlot] + invMassP * s * tz
    if invMassC > 0.0:
        w.bodyPx[capSlot] = w.bodyPx[capSlot] - invMassC * s * tx
        w.bodyPy[capSlot] = w.bodyPy[capSlot] - invMassC * s * ty
        w.bodyPz[capSlot] = w.bodyPz[capSlot] - invMassC * s * tz
        if w.bodyKind[capSlot] == world3d.World3dBodyCapsuleRigid:
            if w.bodyIxx[capSlot] > 0.0:
                # Delta theta = -s Iinv(rC x dHat)
                let t = constraints3dCapsuleInvInertia(w, capSlot, constraints3dVec(rC.y * tz - rC.z * ty, rC.z * tx - rC.x * tz, rC.x * ty - rC.y * tx))
                constraints3dApplyWorldRot(w, capSlot, (0.0 - s) * t.x, (0.0 - s) * t.y, (0.0 - s) * t.z)
    return m.absFloat(c)

# Per-body angular response images for the joint block solve: the six
# row levers carried through the body's world inverse inertia, stored
# as 18 floats (3 per lever): Iinv(r x e_j) for the three anchor rows,
# Iinv(u) for the servo angle row, Iinv(n4)/Iinv(n5) for the axis rows.
# Zeros for bodies without rotational dynamics — the same contract as
# constraints3dAngularGenMass.
@borrows
fn constraints3dBodyAngResp(w: World3d, slot: int32, rx: float64, ry: float64, rz: float64, ux: float64, uy: float64, uz: float64, n4: Constraints3dVec3, n5: Constraints3dVec3, resp: var float64[]) =
    setLen(resp, 18)
    var i: int32 = 0
    while i < 18:
        resp[i] = 0.0
        i = i + 1
    if w.bodyInvMass[slot] <= 0.0:
        return
    if w.bodyKind[slot] != world3d.World3dBodyCapsuleRigid:
        return
    if w.bodyIxx[slot] <= 0.0:
        return
    var u = constraints3dCapsuleInvInertia(w, slot, constraints3dVec(0.0, rz, 0.0 - ry))
    resp[0] = u.x
    resp[1] = u.y
    resp[2] = u.z
    u = constraints3dCapsuleInvInertia(w, slot, constraints3dVec(0.0 - rz, 0.0, rx))
    resp[3] = u.x
    resp[4] = u.y
    resp[5] = u.z
    u = constraints3dCapsuleInvInertia(w, slot, constraints3dVec(ry, 0.0 - rx, 0.0))
    resp[6] = u.x
    resp[7] = u.y
    resp[8] = u.z
    u = constraints3dCapsuleInvInertia(w, slot, constraints3dVec(ux, uy, uz))
    resp[9] = u.x
    resp[10] = u.y
    resp[11] = u.z
    u = constraints3dCapsuleInvInertia(w, slot, n4)
    resp[12] = u.x
    resp[13] = u.y
    resp[14] = u.z
    u = constraints3dCapsuleInvInertia(w, slot, n5)
    resp[15] = u.x
    resp[16] = u.y
    resp[17] = u.z

# Dense SPD solve for the joint block: Cholesky over a symmetric matrix
# stored row-major with stride 6, at most 6 rows. The matrix arrives
# Jacobi-scaled (unit diagonal), so a non-positive pivot means the
# included rows are genuinely dependent. Fixed-order float ops with
# CsgSqrt only — bit-deterministic.
fn constraints3dSolveSpd6(a: float64[], b: float64[], n: int32, x: var float64[]): int32 =
    var l: float64[]
    setLen(l, 36)
    var i: int32 = 0
    while i < 36:
        l[i] = 0.0
        i = i + 1
    setLen(x, 6)
    i = 0
    while i < n:
        var j: int32 = 0
        while j <= i:
            var s: float64 = a[i * 6 + j]
            var k: int32 = 0
            while k < j:
                s = s - l[i * 6 + k] * l[j * 6 + k]
                k = k + 1
            if i == j:
                if s < Constraints3dJointPivotMin:
                    return i
                l[i * 6 + i] = numerics.CsgSqrt(s)
            else:
                l[i * 6 + j] = s / l[j * 6 + j]
            j = j + 1
        i = i + 1
    i = 0
    while i < n:
        var s: float64 = b[i]
        var k: int32 = 0
        while k < i:
            s = s - l[i * 6 + k] * x[k]
            k = k + 1
        x[i] = s / l[i * 6 + i]
        i = i + 1
    i = n - 1
    while i >= 0:
        var s: float64 = x[i]
        var k: int32 = i + 1
        while k < n:
            s = s - l[k * 6 + i] * x[k]
            k = k + 1
        x[i] = s / l[i * 6 + i]
        i = i - 1
    return 0 - 1

# Rank-adaptive joint block solve: assembles the Jacobi-scaled compact
# system from the full symmetric matrix `a` (stride 6) with residual
# vector c0..c5, tries Cholesky, and on a pivot below the floor drops
# that row (multiplier stays zero — the row set went rank-deficient at
# this pose, the same contract as the near-parallel skip) and re-solves
# the well-posed subsystem. Returns the surviving-row bitmask (1 = servo
# row, 2 = axis row 4, 4 = axis row 5) for the residual reporting. `lam`
# must arrive setLen'd to 6 and zeroed (owned by the caller).
fn constraints3dJointBlockSolve(a: float64[], c0: float64, c1: float64, c2: float64, c3: float64, c4: float64, c5: float64, keep3: bool, keep4: bool, keep5: bool, lam: var float64[]): int32 =
    # LDL^T (unit-diagonal L, no sqrt) over the raw symmetric block —
    # sqrt-free because CsgSqrt is a software routine and the refine
    # pass multiplies every per-solve sqrt by thousands. The matrix is
    # not diagonal-scaled: float64 carries the metre-vs-radian mass
    # spread (kappa ~ 1e4) without loss, and the pivot floor is taken
    # RELATIVE to the largest included diagonal so dependency detection
    # stays scale-free.
    var use3: bool = keep3
    var use4: bool = keep4
    var use5: bool = keep5
    var idx: int32[]
    setLen(idx, 6)
    var sm: float64[]
    setLen(sm, 36)
    var rh: float64[]
    setLen(rh, 6)
    var d: float64[]
    setLen(d, 6)
    var dl: float64[]
    setLen(dl, 6)
    var mu: float64[]
    setLen(mu, 6)
    var mz: int32 = 0
    while mz < 6:
        mu[mz] = 0.0
        mz = mz + 1
    var l: float64[]
    setLen(l, 36)
    var n: int32 = 0
    var p: int32 = 0
    var solved: int32 = 0
    while solved == 0:
        n = 0
        var r: int32 = 0
        while r < 6:
            var on: bool = false
            if r == 0:
                on = true
            if r == 1:
                on = true
            if r == 2:
                on = true
            if r == 3:
                on = use3
            if r == 4:
                on = use4
            if r == 5:
                on = use5
            if on:
                idx[n] = r
                n = n + 1
            r = r + 1
        # symmetric Jacobi scaling (d = 1/CsgSqrt(diag)): one hinge can
        # span a 300x inertia spread (5.7 g carrier vs the 172.6 g head)
        # and the raw block's lambda for the light side loses precision —
        # the head servos then fail to converge and the lolling head
        # swings the COM out of the 9 mm capsule support margin. Six
        # CsgSqrt per solve; the LDL^T below stays sqrt-free.
        p = 0
        while p < n:
            d[p] = 1.0 / numerics.CsgSqrt(a[idx[p] * 6 + idx[p]])
            p = p + 1
        p = 0
        while p < n:
            var q: int32 = 0
            while q < n:
                sm[p * 6 + q] = a[idx[p] * 6 + idx[q]] * d[p] * d[q]
                q = q + 1
            if idx[p] == 0:
                rh[p] = (0.0 - c0) * d[p]
            if idx[p] == 1:
                rh[p] = (0.0 - c1) * d[p]
            if idx[p] == 2:
                rh[p] = (0.0 - c2) * d[p]
            if idx[p] == 3:
                rh[p] = (0.0 - c3) * d[p]
            if idx[p] == 4:
                rh[p] = (0.0 - c4) * d[p]
            if idx[p] == 5:
                rh[p] = (0.0 - c5) * d[p]
            p = p + 1
        var maxDiag: float64 = 0.0
        p = 0
        while p < n:
            let dg = sm[p * 6 + p]
            if dg > maxDiag:
                maxDiag = dg
            p = p + 1
        p = 0
        while p < 36:
            l[p] = 0.0
            p = p + 1
        var floorP: float64 = maxDiag * Constraints3dJointPivotMin
        var failRow: int32 = 0 - 1
        if maxDiag < Constraints3dJointEps:
            failRow = 0
        p = 0
        while p < n:
            if failRow < 0:
                var ssum: float64 = sm[p * 6 + p]
                var k: int32 = 0
                while k < p:
                    ssum = ssum - l[p * 6 + k] * l[p * 6 + k] * dl[k]
                    k = k + 1
                if ssum < floorP:
                    failRow = p
                else:
                    dl[p] = ssum
                    var q: int32 = p + 1
                    while q < n:
                        var tsum: float64 = sm[q * 6 + p]
                        var k2: int32 = 0
                        while k2 < p:
                            tsum = tsum - l[q * 6 + k2] * l[p * 6 + k2] * dl[k2]
                            k2 = k2 + 1
                        l[q * 6 + p] = tsum / dl[p]
                        q = q + 1
            p = p + 1
        if failRow >= 0:
            let gr = idx[failRow]
            if gr < 3:
                panic("constraints3d: singular joint anchor block")
            if gr == 3:
                panic("constraints3d: singular joint servo row")
            if gr == 4:
                use4 = false
            if gr == 5:
                use5 = false
        else:
            solved = 1
    p = 0
    while p < n:
        var ssum: float64 = rh[p]
        var k: int32 = 0
        while k < p:
            ssum = ssum - l[p * 6 + k] * mu[k]
            k = k + 1
        mu[p] = ssum
        p = p + 1
    p = 0
    while p < n:
        mu[p] = mu[p] / dl[p]
        p = p + 1
    p = n - 1
    while p >= 0:
        var ssum: float64 = mu[p]
        var k: int32 = p + 1
        while k < n:
            ssum = ssum - l[k * 6 + p] * mu[k]
            k = k + 1
        mu[p] = ssum
        p = p - 1
    p = 0
    while p < n:
        lam[idx[p]] = mu[p] * d[p]
        p = p + 1
    var mask: int32 = 0
    if use3:
        mask = mask + 1
    if use4:
        mask = mask + 2
    if use5:
        mask = mask + 4
    return mask

# One simultaneous solve of the hinge's 6 scalar rows (3 anchor + 1
# servo angle + 2 axis) as ONE linear system A lambda = -C with
# A = sum over the two bodies of J M^-1 J^T in the COM form: angular
# rows are pure couples, and the pivot translation a standalone angle
# row needs is carried here by the anchor rows' multipliers — the
# Schur complement of the anchor block reproduces the exact pivot
# inertia (I + m d^2), so this is the same physics the pivot-form mass/
# apply pair approximates, solved exactly and order-free. Symmetric
# Jacobi scaling (d_j = 1/sqrt(A_jj)) removes the metre-vs-radian mass
# scale spread that made a naive dense solve explode; the scaled system
# goes through Cholesky. Returns the POST-solve residual in metres
# (anchor rows directly, angle/axis rows folded by the smaller anchor
# arm) so the sweep gate measures what is actually left.
fn constraints3dProjectHingeJoint(w: var World3d, ci: int32): float64 =
    if constraints3dHingeEchoOn == 1:
        if ci == constraints3dHingeEchoCi:
            if w.tick <= 200:
                echo("hj t=" + strings.Int64ToStr(w.tick) + " pre gap=" + strings.IntToStr(int32(Constraints3dJointAnchorGap(w, ci) * 1000000.0)) + " ang=" + strings.IntToStr(int32(Constraints3dHingeAngle(w, ci) * 1000.0)))
    let aSlot = w.conA[ci]
    let bSlot = w.conB[ci]
    let rA = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci]))
    let rB = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAnchBx[ci], w.conAnchBy[ci], w.conAnchBz[ci]))
    let uA = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conAxisAx[ci], w.conAxisAy[ci], w.conAxisAz[ci]))
    let uB = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAxisBx[ci], w.conAxisBy[ci], w.conAxisBz[ci]))
    let dAw = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conRefAx[ci], w.conRefAy[ci], w.conRefAz[ci]))
    # second A reference: axis x ref, unit and orthogonal by construction
    let eAw = constraints3dQuatRot(w.bodyQuatW[aSlot], w.bodyQuatX[aSlot], w.bodyQuatY[aSlot], w.bodyQuatZ[aSlot], constraints3dVec(w.conAxisAy[ci] * w.conRefAz[ci] - w.conAxisAz[ci] * w.conRefAy[ci], w.conAxisAz[ci] * w.conRefAx[ci] - w.conAxisAx[ci] * w.conRefAz[ci], w.conAxisAx[ci] * w.conRefAy[ci] - w.conAxisAy[ci] * w.conRefAx[ci]))
    # near-parallel axes: the axis-alignment rows degenerate (their arms
    # d x uB / uB x d vanish as uB -> +-uA), keep anchor+angle only
    let axisDot = uA.x * uB.x + uA.y * uB.y + uA.z * uB.z
    let axisOn = axisDot < 0.999
    let n4x = dAw.y * uB.z - dAw.z * uB.y
    let n4y = dAw.z * uB.x - dAw.x * uB.z
    let n4z = dAw.x * uB.y - dAw.y * uB.x
    let m4x = uB.y * dAw.z - uB.z * dAw.y
    let m4y = uB.z * dAw.x - uB.x * dAw.z
    let m4z = uB.x * dAw.y - uB.y * dAw.x
    let n5x = eAw.y * uB.z - eAw.z * uB.y
    let n5y = eAw.z * uB.x - eAw.x * uB.z
    let n5z = eAw.x * uB.y - eAw.y * uB.x
    let m5x = uB.y * eAw.z - uB.z * eAw.y
    let m5y = uB.z * eAw.x - uB.x * eAw.z
    let m5z = uB.x * eAw.y - uB.y * eAw.x
    var respA: float64[]
    var respB: float64[]
    constraints3dBodyAngResp(w, aSlot, rA.x, rA.y, rA.z, uA.x, uA.y, uA.z, constraints3dVec(n4x, n4y, n4z), constraints3dVec(n5x, n5y, n5z), respA)
    constraints3dBodyAngResp(w, bSlot, rB.x, rB.y, rB.z, uA.x, uA.y, uA.z, constraints3dVec(m4x, m4y, m4z), constraints3dVec(m5x, m5y, m5z), respB)
    # residual vector C: metres on the anchor rows, radians on the servo
    # row, dimensionless on the axis rows
    let cx = (w.bodyPx[bSlot] + rB.x) - (w.bodyPx[aSlot] + rA.x)
    let cy = (w.bodyPy[bSlot] + rB.y) - (w.bodyPy[aSlot] + rA.y)
    let cz = (w.bodyPz[bSlot] + rB.z) - (w.bodyPz[aSlot] + rA.z)
    let kind = w.conKind[ci]
    let servoOn = kind == world3d.World3dConHingeServo
    var c3: float64 = 0.0
    if servoOn:
        c3 = Constraints3dHingeAngle(w, ci) - w.conCmd[ci]
    let c4 = dAw.x * uB.x + dAw.y * uB.y + dAw.z * uB.z
    let c5 = eAw.x * uB.x + eAw.y * uB.y + eAw.z * uB.z
    # anchor arm reference for folding the angular rows into metres,
    # max-component form (sqrt-free; arm lengths are rotation invariant)
    var la = m.absFloat(rA.x)
    if m.absFloat(rA.y) > la:
        la = m.absFloat(rA.y)
    if m.absFloat(rA.z) > la:
        la = m.absFloat(rA.z)
    var lb = m.absFloat(rB.x)
    if m.absFloat(rB.y) > lb:
        lb = m.absFloat(rB.y)
    if m.absFloat(rB.z) > lb:
        lb = m.absFloat(rB.z)
    var lref = la
    if lb < lref:
        lref = lb
    if lref < Constraints3dJointEps:
        lref = 1.0
    # assemble A (symmetric, stride 6)
    var a: float64[]
    setLen(a, 36)
    var i: int32 = 0
    while i < 36:
        a[i] = 0.0
        i = i + 1
    let ka = constraints3dBodyK(w, aSlot, rA.x, rA.y, rA.z)
    let kb = constraints3dBodyK(w, bSlot, rB.x, rB.y, rB.z)
    a[0] = ka.k11 + kb.k11
    a[1] = ka.k12 + kb.k12
    a[2] = ka.k13 + kb.k13
    a[7] = ka.k22 + kb.k22
    a[8] = ka.k23 + kb.k23
    a[14] = ka.k33 + kb.k33
    # anchor column of each angular row: the anchor gap response to that
    # row's multiplier, e_j . (Iinv(lever) x r) summed with the row
    # signs (B carries +levers, A mirrors the anchor side)
    let v3x = (respB[10] * rB.z - respB[11] * rB.y) + (respA[10] * rA.z - respA[11] * rA.y)
    let v3y = (respB[11] * rB.x - respB[9] * rB.z) + (respA[11] * rA.x - respA[9] * rA.z)
    let v3z = (respB[9] * rB.y - respB[10] * rB.x) + (respA[9] * rA.y - respA[10] * rA.x)
    let v4x = (respB[13] * rB.z - respB[14] * rB.y) - (respA[13] * rA.z - respA[14] * rA.y)
    let v4y = (respB[14] * rB.x - respB[12] * rB.z) - (respA[14] * rA.x - respA[12] * rA.z)
    let v4z = (respB[12] * rB.y - respB[13] * rB.x) - (respA[12] * rA.y - respA[13] * rA.x)
    let v5x = (respB[16] * rB.z - respB[17] * rB.y) - (respA[16] * rA.z - respA[17] * rA.y)
    let v5y = (respB[17] * rB.x - respB[15] * rB.z) - (respA[17] * rA.x - respA[15] * rA.z)
    let v5z = (respB[15] * rB.y - respB[16] * rB.x) - (respA[15] * rA.y - respA[16] * rA.x)
    a[3] = v3x
    a[9] = v3y
    a[15] = v3z
    a[4] = v4x
    a[10] = v4y
    a[16] = v4z
    a[5] = v5x
    a[11] = v5y
    a[17] = v5z
    a[21] = respA[9] * uA.x + respA[10] * uA.y + respA[11] * uA.z + respB[9] * uA.x + respB[10] * uA.y + respB[11] * uA.z
    a[22] = respB[12] * uA.x + respB[13] * uA.y + respB[14] * uA.z - (respA[12] * uA.x + respA[13] * uA.y + respA[14] * uA.z)
    a[23] = respB[15] * uA.x + respB[16] * uA.y + respB[17] * uA.z - (respA[15] * uA.x + respA[16] * uA.y + respA[17] * uA.z)
    a[28] = n4x * respA[12] + n4y * respA[13] + n4z * respA[14] + m4x * respB[12] + m4y * respB[13] + m4z * respB[14]
    a[29] = n4x * respA[15] + n4y * respA[16] + n4z * respA[17] + m4x * respB[15] + m4y * respB[16] + m4z * respB[17]
    a[35] = n5x * respA[15] + n5y * respA[16] + n5z * respA[17] + m5x * respB[15] + m5y * respB[16] + m5z * respB[17]
    # mirror the upper triangle: the compact assembly reads both orders
    a[6] = a[1]
    a[12] = a[2]
    a[13] = a[8]
    a[18] = a[3]
    a[19] = a[9]
    a[20] = a[15]
    a[24] = a[4]
    a[25] = a[10]
    a[26] = a[16]
    a[30] = a[5]
    a[31] = a[11]
    a[32] = a[17]
    a[27] = a[22]
    a[33] = a[23]
    a[34] = a[29]
    # row inclusion: anchors always (an all-static hinge is the same
    # configuration error the anchor block panics on); the servo row and
    # the axis rows carry their own guards
    var useRow: bool[]
    setLen(useRow, 6)
    useRow[0] = true
    useRow[1] = true
    useRow[2] = true
    useRow[3] = false
    useRow[4] = false
    useRow[5] = false
    if servoOn:
        if a[21] > Constraints3dJointEps:
            useRow[3] = true
    if axisOn:
        if a[28] > Constraints3dJointEps:
            useRow[4] = true
        if a[35] > Constraints3dJointEps:
            useRow[5] = true
    # rank-adaptive solve (see constraints3dJointBlockSolve): as uB
    # swings toward perpendicular uA the axis levers align with the
    # servo lever and the row set goes rank-deficient; the dropped
    # row's multiplier stays zero and its residual leaves the reported
    # gate, the same contract as the near-parallel skip
    var lam: float64[]
    setLen(lam, 6)
    var zi: int32 = 0
    while zi < 6:
        lam[zi] = 0.0
        zi = zi + 1
    var keep3 = useRow[3]
    var keep4 = useRow[4]
    var keep5 = useRow[5]
    let alive = constraints3dJointBlockSolve(a, cx, cy, cz, c3, c4, c5, keep3, keep4, keep5, lam)
    keep3 = alive % 2 == 1
    keep4 = (alive / 2) % 2 == 1
    keep5 = (alive / 4) % 2 == 1
    lam[0] = lam[0] * Constraints3dJointRelax
    lam[1] = lam[1] * Constraints3dJointRelax
    lam[2] = lam[2] * Constraints3dJointRelax
    lam[3] = lam[3] * Constraints3dJointRelax
    lam[4] = lam[4] * Constraints3dJointRelax
    lam[5] = lam[5] * Constraints3dJointRelax
    # apply: A takes the mirrored anchor impulse, B the direct one; the
    # angular corrections sum every row's inverse-inertia image
    let invA = w.bodyInvMass[aSlot]
    let invB = w.bodyInvMass[bSlot]
    let dthAx = (0.0 - (lam[0] * respA[0] + lam[1] * respA[3] + lam[2] * respA[6] + lam[3] * respA[9])) + lam[4] * respA[12] + lam[5] * respA[15]
    let dthAy = (0.0 - (lam[0] * respA[1] + lam[1] * respA[4] + lam[2] * respA[7] + lam[3] * respA[10])) + lam[4] * respA[13] + lam[5] * respA[16]
    let dthAz = (0.0 - (lam[0] * respA[2] + lam[1] * respA[5] + lam[2] * respA[8] + lam[3] * respA[11])) + lam[4] * respA[14] + lam[5] * respA[17]
    let dthBx = lam[0] * respB[0] + lam[1] * respB[3] + lam[2] * respB[6] + lam[3] * respB[9] + lam[4] * respB[12] + lam[5] * respB[15]
    let dthBy = lam[0] * respB[1] + lam[1] * respB[4] + lam[2] * respB[7] + lam[3] * respB[10] + lam[4] * respB[13] + lam[5] * respB[16]
    let dthBz = lam[0] * respB[2] + lam[1] * respB[5] + lam[2] * respB[8] + lam[3] * respB[11] + lam[4] * respB[14] + lam[5] * respB[17]
    if invA > 0.0:
        w.bodyPx[aSlot] = w.bodyPx[aSlot] - invA * lam[0]
        w.bodyPy[aSlot] = w.bodyPy[aSlot] - invA * lam[1]
        w.bodyPz[aSlot] = w.bodyPz[aSlot] - invA * lam[2]
        constraints3dApplyWorldRot(w, aSlot, dthAx, dthAy, dthAz)
    if invB > 0.0:
        w.bodyPx[bSlot] = w.bodyPx[bSlot] + invB * lam[0]
        w.bodyPy[bSlot] = w.bodyPy[bSlot] + invB * lam[1]
        w.bodyPz[bSlot] = w.bodyPz[bSlot] + invB * lam[2]
        constraints3dApplyWorldRot(w, bSlot, dthBx, dthBy, dthBz)
    if constraints3dHingeEchoOn == 1:
        if ci == constraints3dHingeEchoCi:
            if w.tick <= 200:
                echo("hj t=" + strings.Int64ToStr(w.tick) + " post gap=" + strings.IntToStr(int32(Constraints3dJointAnchorGap(w, ci) * 1000000.0)) + " ang=" + strings.IntToStr(int32(Constraints3dHingeAngle(w, ci) * 1000.0)) + " lam0=" + strings.IntToStr(int32(lam[0] * 1000000.0)) + " lam3=" + strings.IntToStr(int32(lam[3] * 1000000.0)))
    # post-solve residual, metres, max-component like the anchor block —
    # only over row families the final solve actually carried (a dropped
    # row's pose-dependency is the same not-promised contract as the
    # near-parallel skip)
    let gapAx = (w.bodyPx[bSlot] + rB.x) - (w.bodyPx[aSlot] + rA.x)
    let gapAy = (w.bodyPy[bSlot] + rB.y) - (w.bodyPy[aSlot] + rA.y)
    let gapAz = (w.bodyPz[bSlot] + rB.z) - (w.bodyPz[aSlot] + rA.z)
    var out = m.absFloat(gapAx)
    if m.absFloat(gapAy) > out:
        out = m.absFloat(gapAy)
    if m.absFloat(gapAz) > out:
        out = m.absFloat(gapAz)
    if keep3:
        let e3 = m.absFloat(Constraints3dHingeAngle(w, ci) - w.conCmd[ci])
        if e3 * lref > out:
            out = e3 * lref
    if keep4:
        let uB2 = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAxisBx[ci], w.conAxisBy[ci], w.conAxisBz[ci]))
        let d2 = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conRefAx[ci], w.conRefAy[ci], w.conRefAz[ci]))
        let e4 = m.absFloat(d2.x * uB2.x + d2.y * uB2.y + d2.z * uB2.z)
        if e4 * lref > out:
            out = e4 * lref
    if keep5:
        let uB3 = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAxisBx[ci], w.conAxisBy[ci], w.conAxisBz[ci]))
        let e3v = constraints3dQuatRot(w.bodyQuatW[aSlot], w.bodyQuatX[aSlot], w.bodyQuatY[aSlot], w.bodyQuatZ[aSlot], constraints3dVec(w.conAxisAy[ci] * w.conRefAz[ci] - w.conAxisAz[ci] * w.conRefAy[ci], w.conAxisAz[ci] * w.conRefAx[ci] - w.conAxisAx[ci] * w.conRefAz[ci], w.conAxisAx[ci] * w.conRefAy[ci] - w.conAxisAy[ci] * w.conRefAx[ci]))
        let e5 = m.absFloat(e3v.x * uB3.x + e3v.y * uB3.y + e3v.z * uB3.z)
        if e5 * lref > out:
            out = e5 * lref
    return out

# Hinge projection (kinds 9 servo / 10 passive): one exact joint block
# solve per call (see constraints3dProjectHingeJoint), then the passive
# flexion limits as one-sided clamps; a fired limit breaks the anchor
# closure behind it, so one exact re-close follows.
fn constraints3dProjectHinge(w: var World3d, ci: int32): float64 =
    var res = constraints3dProjectHingeJoint(w, ci)
    # Newton iterate to tolerance: one simultaneous solve leaves an
    # O(dtheta^2) linearization remainder; a hinge still above the
    # millimetre fold gets up to two more exact passes (fixed budget,
    # deterministic — the light head chain's 10+ degree servo errors
    # were a single-pass remainder the metre fold hid under the gate)
    let limOn = w.conLimMax[ci] > w.conLimMin[ci]
    if limOn:
        let aSlot = w.conA[ci]
        let uA = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conAxisAx[ci], w.conAxisAy[ci], w.conAxisAz[ci]))
        let resHi = constraints3dProjectAngleRow(w, ci, uA.x, uA.y, uA.z, w.conLimMax[ci], true, false)
        let resLo = constraints3dProjectAngleRow(w, ci, uA.x, uA.y, uA.z, w.conLimMin[ci], false, true)
        if resHi > 0.0 or resLo > 0.0:
            res = constraints3dProjectHingeJoint(w, ci)
    return res

# Velocity-level hinge post-stabilization: one pass projecting each
# hinge's velocity error (anchor-point relative velocity, servo axis
# rate, axis-row rates) through the SAME generalized mass matrix the
# position block assembles — the velocity analogue of the position
# solve, run once per tick after the contact stage. Under the rigid
# position solve the per-sweep correction churn reads through the
# Verlet rebuild as joint omega noise; the friction layer converts
# that noise into stance creep (measured: lateral launch vy 0.4 m/s by
# t=160, and a Newton-iterated position solve made it explode faster —
# the noise is billed per correction pass). Projecting velocities
# removes the violation where it lives without any position churn.
fn Constraints3dProjectHingeVelocities(w: var World3d) =
    # sequential Gauss-Seidel over the hinges, iterated to convergence
    # with SOR under-relaxation: the velocity problem is linear, but the
    # chain mass ratios (5.7 g carrier between heavy neighbours) give a
    # single-pass GS spectral radius >= 1 — the unprojected common-mode
    # remainder rode the torso at +-1 rad/s (measured). 8 passes x 0.7
    # contraction is fixed and deterministic.
    var pass: int32 = 0
    while pass < 8:
        var ci: int32 = 0
        while ci < w.conCount:
        if w.conActive[ci] == 1:
            let kind = w.conKind[ci]
            if kind == world3d.World3dConHingeServo:
                if kind == world3d.World3dConHinge:
                    panic("constraints3d: unreachable hinge kind pair")
            if kind == world3d.World3dConHingeServo or kind == world3d.World3dConHinge:
                let aSlot = w.conA[ci]
                let bSlot = w.conB[ci]
                let rA = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conAnchAx[ci], w.conAnchAy[ci], w.conAnchAz[ci]))
                let rB = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAnchBx[ci], w.conAnchBy[ci], w.conAnchBz[ci]))
                let uA = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conAxisAx[ci], w.conAxisAy[ci], w.conAxisAz[ci]))
                let uB = constraints3dBodyQuatRot(w, bSlot, constraints3dVec(w.conAxisBx[ci], w.conAxisBy[ci], w.conAxisBz[ci]))
                let dAw = constraints3dBodyQuatRot(w, aSlot, constraints3dVec(w.conRefAx[ci], w.conRefAy[ci], w.conRefAz[ci]))
                let eAw = constraints3dQuatRot(w.bodyQuatW[aSlot], w.bodyQuatX[aSlot], w.bodyQuatY[aSlot], w.bodyQuatZ[aSlot], constraints3dVec(w.conAxisAy[ci] * w.conRefAz[ci] - w.conAxisAz[ci] * w.conRefAy[ci], w.conAxisAz[ci] * w.conRefAx[ci] - w.conAxisAx[ci] * w.conRefAz[ci], w.conAxisAx[ci] * w.conRefAy[ci] - w.conAxisAy[ci] * w.conRefAx[ci]))
                let axisDot = uA.x * uB.x + uA.y * uB.y + uA.z * uB.z
                let axisOn = axisDot < 0.999
                let n4x = dAw.y * uB.z - dAw.z * uB.y
                let n4y = dAw.z * uB.x - dAw.x * uB.z
                let n4z = dAw.x * uB.y - dAw.y * uB.x
                let m4x = uB.y * dAw.z - uB.z * dAw.y
                let m4y = uB.z * dAw.x - uB.x * dAw.z
                let m4z = uB.x * dAw.y - uB.y * dAw.x
                let n5x = eAw.y * uB.z - eAw.z * uB.y
                let n5y = eAw.z * uB.x - eAw.x * uB.z
                let n5z = eAw.x * uB.y - eAw.y * uB.x
                let m5x = uB.y * eAw.z - uB.z * eAw.y
                let m5y = uB.z * eAw.x - uB.x * eAw.z
                let m5z = uB.x * eAw.y - uB.y * eAw.x
                var respA: float64[]
                var respB: float64[]
                constraints3dBodyAngResp(w, aSlot, rA.x, rA.y, rA.z, uA.x, uA.y, uA.z, constraints3dVec(n4x, n4y, n4z), constraints3dVec(n5x, n5y, n5z), respA)
                constraints3dBodyAngResp(w, bSlot, rB.x, rB.y, rB.z, uA.x, uA.y, uA.z, constraints3dVec(m4x, m4y, m4z), constraints3dVec(m5x, m5y, m5z), respB)
                # velocity residuals: anchor-point relative velocity,
                # servo axis rate, axis-row rates
                let vax = w.bodyVx[aSlot] + w.bodyAngVy[aSlot] * rA.z - w.bodyAngVz[aSlot] * rA.y
                let vay = w.bodyVy[aSlot] + w.bodyAngVz[aSlot] * rA.x - w.bodyAngVx[aSlot] * rA.z
                let vaz = w.bodyVz[aSlot] + w.bodyAngVx[aSlot] * rA.y - w.bodyAngVy[aSlot] * rA.x
                let vbx = w.bodyVx[bSlot] + w.bodyAngVy[bSlot] * rB.z - w.bodyAngVz[bSlot] * rB.y
                let vby = w.bodyVy[bSlot] + w.bodyAngVz[bSlot] * rB.x - w.bodyAngVx[bSlot] * rB.z
                let vbz = w.bodyVz[bSlot] + w.bodyAngVx[bSlot] * rB.y - w.bodyAngVy[bSlot] * rB.x
                let c0 = vbx - vax
                let c1 = vby - vay
                let c2 = vbz - vaz
                let servoOn = kind == world3d.World3dConHingeServo
                var c3: float64 = 0.0
                if servoOn:
                    c3 = (w.bodyAngVx[bSlot] - w.bodyAngVx[aSlot]) * uA.x + (w.bodyAngVy[bSlot] - w.bodyAngVy[aSlot]) * uA.y + (w.bodyAngVz[bSlot] - w.bodyAngVz[aSlot]) * uA.z
                let wAx = w.bodyAngVx[aSlot]
                let wAy = w.bodyAngVy[aSlot]
                let wAz = w.bodyAngVz[aSlot]
                let wBx = w.bodyAngVx[bSlot]
                let wBy = w.bodyAngVy[bSlot]
                let wBz = w.bodyAngVz[bSlot]
                let c4 = wAx * n4x + wAy * n4y + wAz * n4z + wBx * m4x + wBy * m4y + wBz * m4z
                let c5 = wAx * n5x + wAy * n5y + wAz * n5z + wBx * m5x + wBy * m5y + wBz * m5z
                # assemble A (identical to the position block)
                var a: float64[]
                setLen(a, 36)
                var ii: int32 = 0
                while ii < 36:
                    a[ii] = 0.0
                    ii = ii + 1
                let ka = constraints3dBodyK(w, aSlot, rA.x, rA.y, rA.z)
                let kb = constraints3dBodyK(w, bSlot, rB.x, rB.y, rB.z)
                a[0] = ka.k11 + kb.k11
                a[1] = ka.k12 + kb.k12
                a[2] = ka.k13 + kb.k13
                a[7] = ka.k22 + kb.k22
                a[8] = ka.k23 + kb.k23
                a[14] = ka.k33 + kb.k33
                let v3x = (respB[10] * rB.z - respB[11] * rB.y) + (respA[10] * rA.z - respA[11] * rA.y)
                let v3y = (respB[11] * rB.x - respB[9] * rB.z) + (respA[11] * rA.x - respA[9] * rA.z)
                let v3z = (respB[9] * rB.y - respB[10] * rB.x) + (respA[9] * rA.y - respA[10] * rA.x)
                let v4x = (respB[13] * rB.z - respB[14] * rB.y) - (respA[13] * rA.z - respA[14] * rA.y)
                let v4y = (respB[14] * rB.x - respB[12] * rB.z) - (respA[14] * rA.x - respA[12] * rA.z)
                let v4z = (respB[12] * rB.y - respB[13] * rB.x) - (respA[12] * rA.y - respA[13] * rA.x)
                let v5x = (respB[16] * rB.z - respB[17] * rB.y) - (respA[16] * rA.z - respA[17] * rA.y)
                let v5y = (respB[17] * rB.x - respB[15] * rB.z) - (respA[17] * rA.x - respA[15] * rA.z)
                let v5z = (respB[15] * rB.y - respB[16] * rB.x) - (respA[15] * rA.y - respA[16] * rA.x)
                a[3] = v3x
                a[9] = v3y
                a[15] = v3z
                a[4] = v4x
                a[10] = v4y
                a[16] = v4z
                a[5] = v5x
                a[11] = v5y
                a[17] = v5z
                a[21] = respA[9] * uA.x + respA[10] * uA.y + respA[11] * uA.z + respB[9] * uA.x + respB[10] * uA.y + respB[11] * uA.z
                a[22] = respB[12] * uA.x + respB[13] * uA.y + respB[14] * uA.z - (respA[12] * uA.x + respA[13] * uA.y + respA[14] * uA.z)
                a[23] = respB[15] * uA.x + respB[16] * uA.y + respB[17] * uA.z - (respA[15] * uA.x + respA[16] * uA.y + respA[17] * uA.z)
                a[28] = n4x * respA[12] + n4y * respA[13] + n4z * respA[14] + m4x * respB[12] + m4y * respB[13] + m4z * respB[14]
                a[29] = n4x * respA[15] + n4y * respA[16] + n4z * respA[17] + m4x * respB[15] + m4y * respB[16] + m4z * respB[17]
                a[35] = n5x * respA[15] + n5y * respA[16] + n5z * respA[17] + m5x * respB[15] + m5y * respB[16] + m5z * respB[17]
                a[6] = a[1]
                a[12] = a[2]
                a[13] = a[8]
                a[18] = a[3]
                a[19] = a[9]
                a[20] = a[15]
                a[24] = a[4]
                a[25] = a[10]
                a[26] = a[16]
                a[30] = a[5]
                a[31] = a[11]
                a[32] = a[17]
                a[27] = a[22]
                a[33] = a[23]
                a[34] = a[29]
                var useRow: bool[]
                setLen(useRow, 6)
                useRow[0] = true
                useRow[1] = true
                useRow[2] = true
                useRow[3] = false
                useRow[4] = false
                useRow[5] = false
                if servoOn:
                    if a[21] > Constraints3dJointEps:
                        useRow[3] = true
                if axisOn:
                    if a[28] > Constraints3dJointEps:
                        useRow[4] = true
                    if a[35] > Constraints3dJointEps:
                        useRow[5] = true
                var lam: float64[]
                setLen(lam, 6)
                var zi: int32 = 0
                while zi < 6:
                    lam[zi] = 0.0
                    zi = zi + 1
                var keep3 = useRow[3]
                var keep4 = useRow[4]
                var keep5 = useRow[5]
                let alive = constraints3dJointBlockSolve(a, c0, c1, c2, c3, c4, c5, keep3, keep4, keep5, lam)
                keep3 = alive % 2 == 1
                keep4 = (alive / 2) % 2 == 1
                keep5 = (alive / 4) % 2 == 1
                let keep0: bool = true
                let keep1: bool = true
                let keep2: bool = true
                let _k0 = keep0
                let _k1 = keep1
                let _k2 = keep2
                let invA = w.bodyInvMass[aSlot]
                let invB = w.bodyInvMass[bSlot]
                let dthAx = (0.0 - (lam[0] * respA[0] + lam[1] * respA[3] + lam[2] * respA[6] + lam[3] * respA[9])) + lam[4] * respA[12] + lam[5] * respA[15]
                let dthAy = (0.0 - (lam[0] * respA[1] + lam[1] * respA[4] + lam[2] * respA[7] + lam[3] * respA[10])) + lam[4] * respA[13] + lam[5] * respA[16]
                let dthAz = (0.0 - (lam[0] * respA[2] + lam[1] * respA[5] + lam[2] * respA[8] + lam[3] * respA[11])) + lam[4] * respA[14] + lam[5] * respA[17]
                let dthBx = lam[0] * respB[0] + lam[1] * respB[3] + lam[2] * respB[6] + lam[3] * respB[9] + lam[4] * respB[12] + lam[5] * respB[15]
                let dthBy = lam[0] * respB[1] + lam[1] * respB[4] + lam[2] * respB[7] + lam[3] * respB[10] + lam[4] * respB[13] + lam[5] * respB[16]
                let dthBz = lam[0] * respB[2] + lam[1] * respB[5] + lam[2] * respB[8] + lam[3] * respB[11] + lam[4] * respB[14] + lam[5] * respB[17]
                if invA > 0.0:
                    w.bodyVx[aSlot] = w.bodyVx[aSlot] - invA * lam[0] * 0.7
                    w.bodyVy[aSlot] = w.bodyVy[aSlot] - invA * lam[1] * 0.7
                    w.bodyVz[aSlot] = w.bodyVz[aSlot] - invA * lam[2] * 0.7
                    w.bodyAngVx[aSlot] = w.bodyAngVx[aSlot] + dthAx * 0.7
                    w.bodyAngVy[aSlot] = w.bodyAngVy[aSlot] + dthAy * 0.7
                    w.bodyAngVz[aSlot] = w.bodyAngVz[aSlot] + dthAz * 0.7
                if invB > 0.0:
                    w.bodyVx[bSlot] = w.bodyVx[bSlot] + invB * lam[0] * 0.7
                    w.bodyVy[bSlot] = w.bodyVy[bSlot] + invB * lam[1] * 0.7
                    w.bodyVz[bSlot] = w.bodyVz[bSlot] + invB * lam[2] * 0.7
                    w.bodyAngVx[bSlot] = w.bodyAngVx[bSlot] + dthBx * 0.7
                    w.bodyAngVy[bSlot] = w.bodyAngVy[bSlot] + dthBy * 0.7
                    w.bodyAngVz[bSlot] = w.bodyAngVz[bSlot] + dthBz * 0.7
            ci = ci + 1
        pass = pass + 1
