# Fixed-capacity SoA ECS world (EcsCapacity = 64 slots).
#
# Cold-backend constraints honored here (findings.md 2026-06-12):
# - Columns are pure-scalar int32[] sequences stored as struct fields of a
#   var-param world; element reads/writes through that field path are the
#   reliable shape (the self-hosted compiler uses it pervasively).
# - No Bytes/str columns: struct-seq elements containing Bytes crash on
#   overwrite; sprite CIDs stay out of the SoA until that is fixed.
# - Columns are preallocated to full capacity by add() in EcsWorldReset and
#   then only whole-element writes happen; capacity overflow hard-fails via
#   panic (never silently dropped).

import std/system
import std/strings as strings
import std/strutils as strutil

const
    EcsCapacity = 64
    EcsColliderNone = 0
    EcsColliderCircle = 1
    EcsColliderAabb = 2
    EcsWorldPreimageSchema = "cheng.game.ecs.world.v2"

type
    EcsWorld =
        count: int32
        nextEntityId: int32
        entityIds: int32[]
        positionX: int32[]
        positionY: int32[]
        velocityX: int32[]
        velocityY: int32[]
        mass: int32[]
        colliderKind: int32[]
        colliderRadius: int32[]
        colliderHalfWidth: int32[]
        colliderHalfHeight: int32[]

fn EcsWorldInit(): EcsWorld =
    var world: EcsWorld
    EcsWorldReset(world)
    return world

fn EcsWorldReset(world: var EcsWorld) =
    world.count = 0
    world.nextEntityId = 1
    setLen(world.entityIds, 0)
    setLen(world.positionX, 0)
    setLen(world.positionY, 0)
    setLen(world.velocityX, 0)
    setLen(world.velocityY, 0)
    setLen(world.mass, 0)
    setLen(world.colliderKind, 0)
    setLen(world.colliderRadius, 0)
    setLen(world.colliderHalfWidth, 0)
    setLen(world.colliderHalfHeight, 0)
    while world.entityIds.len < EcsCapacity:
        add(world.entityIds, 0)
        add(world.positionX, 0)
        add(world.positionY, 0)
        add(world.velocityX, 0)
        add(world.velocityY, 0)
        add(world.mass, 0)
        add(world.colliderKind, EcsColliderNone)
        add(world.colliderRadius, 0)
        add(world.colliderHalfWidth, 0)
        add(world.colliderHalfHeight, 0)

@borrows
fn EcsWorldEntityCount(world: EcsWorld): int32 =
    return world.count

@borrows
fn EcsWorldEntityIdAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.entityIds.len:
        return 0
    return world.entityIds[index]

@borrows
fn EcsWorldPositionXAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.positionX.len:
        return 0
    return world.positionX[index]

@borrows
fn EcsWorldPositionYAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.positionY.len:
        return 0
    return world.positionY[index]

@borrows
fn EcsWorldVelocityXAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.velocityX.len:
        return 0
    return world.velocityX[index]

@borrows
fn EcsWorldVelocityYAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.velocityY.len:
        return 0
    return world.velocityY[index]

@borrows
fn EcsWorldMassAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.mass.len:
        return 0
    return world.mass[index]

@borrows
fn EcsWorldColliderKindAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.colliderKind.len:
        return 0
    return world.colliderKind[index]

@borrows
fn EcsWorldColliderRadiusAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.colliderRadius.len:
        return 0
    return world.colliderRadius[index]

@borrows
fn EcsWorldColliderHalfWidthAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.colliderHalfWidth.len:
        return 0
    return world.colliderHalfWidth[index]

@borrows
fn EcsWorldColliderHalfHeightAt(world: EcsWorld, index: int32): int32 =
    if index < 0:
        return 0
    if index >= world.colliderHalfHeight.len:
        return 0
    return world.colliderHalfHeight[index]

fn EcsWorldSpriteTextureCidAt(world: EcsWorld, index: int32): str =
    return ""

fn EcsWorldSetSlot(world: var EcsWorld,
                   index: int32,
                   entityId: int32,
                   x: int32,
                   y: int32,
                   massValue: int32,
                   spriteCid: str): bool =
    if index < 0:
        return false
    if index >= world.entityIds.len:
        return false
    world.entityIds[index] = entityId
    world.positionX[index] = x
    world.positionY[index] = y
    world.velocityX[index] = 0
    world.velocityY[index] = 0
    world.mass[index] = massValue
    world.colliderKind[index] = EcsColliderNone
    world.colliderRadius[index] = 0
    world.colliderHalfWidth[index] = 0
    world.colliderHalfHeight[index] = 0
    return true

fn EcsWorldSetVelocityAt(world: var EcsWorld, index: int32, vx: int32, vy: int32): bool =
    if index < 0:
        return false
    if index >= world.velocityX.len:
        return false
    world.velocityX[index] = vx
    world.velocityY[index] = vy
    return true

fn EcsWorldSetPositionAt(world: var EcsWorld, index: int32, x: int32, y: int32): bool =
    if index < 0:
        return false
    if index >= world.positionX.len:
        return false
    world.positionX[index] = x
    world.positionY[index] = y
    return true

fn EcsWorldSetAabbColliderAt(world: var EcsWorld, index: int32, halfWidth: int32, halfHeight: int32): bool =
    if index < 0:
        return false
    if index >= world.colliderKind.len:
        return false
    world.colliderKind[index] = EcsColliderAabb
    world.colliderRadius[index] = 0
    world.colliderHalfWidth[index] = halfWidth
    world.colliderHalfHeight[index] = halfHeight
    return true

fn EcsWorldSetCircleColliderAt(world: var EcsWorld, index: int32, radius: int32): bool =
    if index < 0:
        return false
    if index >= world.colliderKind.len:
        return false
    world.colliderKind[index] = EcsColliderCircle
    world.colliderRadius[index] = radius
    world.colliderHalfWidth[index] = 0
    world.colliderHalfHeight[index] = 0
    return true

@borrows
fn EcsWorldColumnsValid(world: EcsWorld): bool =
    if world.count < 0:
        return false
    if world.count > EcsCapacity:
        return false
    if world.count > world.entityIds.len:
        return false
    for i in 0..<world.count:
        if world.entityIds[i] <= 0:
            return false
        for j in i + 1..<world.count:
            if world.entityIds[i] == world.entityIds[j]:
                return false
    return true

@borrows
fn EcsWorldIndexOf(world: EcsWorld, entityId: int32): int32 =
    for i in 0..<world.count:
        if world.entityIds[i] == entityId:
            return i
    return -1

fn EcsWorldSpawn(world: var EcsWorld,
                  x: int32,
                  y: int32,
                  massValue: int32,
                  spriteCid: str): int32 =
    if world.count >= EcsCapacity:
        panic("ecs: EcsWorldSpawn capacity exceeded (EcsCapacity slots full)")
    let entityId = world.nextEntityId
    let index = world.count
    if !EcsWorldSetSlot(world, index, entityId, x, y, massValue, spriteCid):
        panic("ecs: EcsWorldSpawn slot write failed (world not reset?)")
    world.nextEntityId = world.nextEntityId + 1
    world.count = world.count + 1
    return entityId

fn EcsWorldSetVelocity(world: var EcsWorld,
                        entityId: int32,
                        vx: int32,
                        vy: int32): bool =
    let index = EcsWorldIndexOf(world, entityId)
    if index < 0:
        return false
    return EcsWorldSetVelocityAt(world, index, vx, vy)

fn EcsWorldSetPosition(world: var EcsWorld,
                        entityId: int32,
                        x: int32,
                        y: int32): bool =
    let index = EcsWorldIndexOf(world, entityId)
    if index < 0:
        return false
    return EcsWorldSetPositionAt(world, index, x, y)

fn EcsWorldSetAabbCollider(world: var EcsWorld,
                            entityId: int32,
                            halfWidth: int32,
                            halfHeight: int32): bool =
    let index = EcsWorldIndexOf(world, entityId)
    if index < 0:
        return false
    if halfWidth <= 0:
        return false
    if halfHeight <= 0:
        return false
    return EcsWorldSetAabbColliderAt(world, index, halfWidth, halfHeight)

fn EcsWorldSetCircleCollider(world: var EcsWorld,
                              entityId: int32,
                              radius: int32): bool =
    let index = EcsWorldIndexOf(world, entityId)
    if index < 0:
        return false
    if radius <= 0:
        return false
    return EcsWorldSetCircleColliderAt(world, index, radius)

fn EcsWorldStepKinematic(world: var EcsWorld, dtMs: int32) =
    if dtMs <= 0:
        return
    for i in 0..<world.count:
        let dx = (world.velocityX[i] * dtMs) / 1000
        let dy = (world.velocityY[i] * dtMs) / 1000
        world.positionX[i] = world.positionX[i] + dx
        world.positionY[i] = world.positionY[i] + dy

fn EcsWorldClone(world: EcsWorld): EcsWorld =
    var out: EcsWorld
    out.count = world.count
    out.nextEntityId = world.nextEntityId
    for i in 0..<world.entityIds.len:
        add(out.entityIds, world.entityIds[i])
        add(out.positionX, world.positionX[i])
        add(out.positionY, world.positionY[i])
        add(out.velocityX, world.velocityX[i])
        add(out.velocityY, world.velocityY[i])
        add(out.mass, world.mass[i])
        add(out.colliderKind, world.colliderKind[i])
        add(out.colliderRadius, world.colliderRadius[i])
        add(out.colliderHalfWidth, world.colliderHalfWidth[i])
        add(out.colliderHalfHeight, world.colliderHalfHeight[i])
    return out

# Canonical world preimage. Deterministic byte-exact layout:
#   schema|next=<nextEntityId>|count=<count>{|slot=<i>:<id>,<px>,<py>,<vx>,<vy>,<mass>,<ck>,<cr>,<chw>,<chh>}
# Only live slots (0..<count) enter the preimage; reads go through the
# bounds-checked At accessors so an invalid world still hashes
# deterministically instead of trapping.
@borrows
fn EcsWorldCanonicalPreimage(world: EcsWorld): str =
    var parts: str[]
    add(parts, EcsWorldPreimageSchema)
    add(parts, "|next=")
    add(parts, strings.IntToStr(world.nextEntityId))
    add(parts, "|count=")
    add(parts, strings.IntToStr(world.count))
    for i in 0..<world.count:
        add(parts, "|slot=")
        add(parts, strings.IntToStr(i))
        add(parts, ":")
        add(parts, strings.IntToStr(EcsWorldEntityIdAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldPositionXAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldPositionYAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldVelocityXAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldVelocityYAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldMassAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldColliderKindAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldColliderRadiusAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldColliderHalfWidthAt(world, i)))
        add(parts, ",")
        add(parts, strings.IntToStr(EcsWorldColliderHalfHeightAt(world, i)))
    return strutil.Join(parts, "")

# SHA-256 of the canonical preimage, lowercase hex (64 chars) — repo-wide
# CID convention (same as media receipt CIDs). No base64 anywhere.
@borrows
fn EcsWorldCid(world: EcsWorld): str =
    return strings.Sha256(EcsWorldCanonicalPreimage(world))
