# 世界 CSG producer (B1): 观测对象 -> 世界事实行集。
#
# 合同: 相同观测输入两次生产字节一致 (canonical); 事实行只含观测层
# 已验证字段 (tick/ms/origin=derived), 零重建假设; entity 行绑定
# 源字节 CID 与观测 CID (来源链不断)。
import std/strings
import cheng/game/assets/reconstruction/observation
import cheng/game/csg/world_schema

type
    WorldFactSet =
        entityId: str
        sourceCid: str
        observationCid: str
        facts: str[]             # canonical 事实行 (add-only, 顺序=生产序)

# 从观测投影世界事实集: 1 entity 行 + 每样本 1 frame 行
# (帧 tick 由观测的 stts 时序展开, 帧号 0-based)。
@borrows
fn WorldProduceFromObservation(o: observation.AssetVideoObservation): WorldFactSet =
    var f: WorldFactSet
    f.entityId = Fmt"{o.sourceCid}"
    f.sourceCid = Fmt"{o.sourceCid}"
    f.observationCid = strings.Sha256(observation.AssetVideoObservationPreimage(o))
    add(f.facts, world_schema.WorldEntityFactLine(f.entityId, o.sourceCid,
        f.observationCid))
    # 帧时间线: 使用观测层逐帧 tick 真值 (VFR 真实帧距, 禁均匀近似)。
    if o.sampleCount <= 0 || o.timescale <= 0 || o.frameTicks.len != o.sampleCount:
        return f
    var i: int32
    while i < o.sampleCount:
        add(f.facts, world_schema.WorldFrameFactLine(f.entityId, i, o.frameTicks[i],
            o.frameTicks[i] * int64(1000) / int64(o.timescale)))
        i = i + 1
    return f
