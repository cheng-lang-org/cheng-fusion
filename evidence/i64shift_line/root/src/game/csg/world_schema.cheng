# 世界 CSG schema (B1 最小): 存量视频时间线的世界事实种类。
#
# 归属: 世界计划 B1 (事实与准入) 最小切面; 上游标准: docs/csg-core-standard.md
# (canonical JSON + SHA-256 CID + Merkle 准入复用, 零新协议)。
# 两类事实:
#   world.entity        源视频实体 (绑定源字节 CID 与观测 CID)
#   world.timeline.frame 时间线状态帧 (tick/ms/来源帧号)
# 事实行即 canonical 文本行; 字节级确定性由 producer 保证。
import std/strings

fn WorldSchemaVersion(): str =
    return "cheng.world.schema.v1"

fn WorldKindEntity(): str =
    return "world.entity"

fn WorldKindFrame(): str =
    return "world.timeline.frame"

# world.entity 事实行:
#   world.entity|entity=<eid>|source_cid=<源字节CID>|observation_cid=<观测CID>|kind=video
@borrows
fn WorldEntityFactLine(entityId: str, sourceCid: str, observationCid: str): str =
    var parts: str[]
    add(parts, Fmt"{WorldKindEntity()}|entity={entityId}|source_cid={sourceCid}|observation_cid={observationCid}|kind=video")
    var out: str = ""
    for i in 0..<parts.len:
        out = out + parts[i]
    return out

# world.timeline.frame 事实行:
#   world.timeline.frame|entity=<eid>|index=<i>|tick=<t>|ms=<ms>|origin=derived
@borrows
fn WorldFrameFactLine(entityId: str, index: int32, tick: int64, ms: int64): str =
    var parts: str[]
    add(parts, Fmt"{WorldKindFrame()}|entity={entityId}|index={strings.IntToStr(index)}|tick={strings.Int64ToStr(tick)}|ms={strings.Int64ToStr(ms)}|origin=derived")
    var out: str = ""
    for i in 0..<parts.len:
        out = out + parts[i]
    return out
