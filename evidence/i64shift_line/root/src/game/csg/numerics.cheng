# Numerics support for the CSG world (C1).
#
# std/math's sqrtFloat is defective on the current stage3 backend: its
# Babylonian loop starts from y=1.0 and returns the input unchanged for
# any value < 1 (probed 2026-09-06: sqrtFloat(0.25)=0.25). Recursion with
# fresh parameter bindings is the documented-safe shape on this backend,
# so sqrt lives here as recursive Newton iteration (quadratic convergence,
# 80 iterations is far beyond double-precision convergence for any
# physical magnitude in this world).
import std/math as m

fn CsgSqrtStep(v: float64, x: float64, n: int32): float64 =
    let nx: float64 = 0.5 * (x + v / x)
    # quadratic convergence: stop once the iterate is stable to ~1e-12 rel
    let delta: float64 = nx - x
    if n >= 4:
        if delta < 0.0:
            if delta > -0.000000000001 * nx:
                return nx
        if delta >= 0.0:
            if delta < 0.000000000001 * nx:
                return nx
    if n >= 48:
        return nx
    return CsgSqrtStep(v, nx, n + 1)

fn CsgSqrt(v: float64): float64 =
    if v <= 0.0:
        return 0.0
    return CsgSqrtStep(v, v, 0)

fn CsgAbs(v: float64): float64 =
    if v < 0.0:
        return 0.0 - v
    return v

# float64 -> int64 millimetre quantization. The cold backend's direct
# float64->int64 conversion materializes garbage (probed 2026-09-06: every
# value in a process becomes the same pointer-like constant, varying across
# processes); routing through int32 (which works) is exact for every
# physical magnitude in this world (|x*1000| < 2^31).
fn CsgQuantMm(x: float64): int64 =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    return int64(scaled)
