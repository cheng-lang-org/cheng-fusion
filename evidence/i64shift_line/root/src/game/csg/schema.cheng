# CSG world facts schema (B1): the typed scene description that is the
# single source of truth. Parallel scalar arrays only — no str inside
# struct sequences (ecs.cheng crash zone). Roles/enums are int32 codes.
# Producers must register facts here; consumers must validate through
# csg/validation before materialization.
import cheng/game/rope3d
import std/strings as strings
import std/strutils as strutil
import cheng/game/csg/numerics
import std/math as m

const
    CsgWorldFactsSchema = "cheng.game.csg.world.facts.v1"
    CsgRoleNone = 0
    CsgRolePelvis = 1
    CsgRoleChest = 2
    CsgRoleHead = 3
    CsgRoleHandL = 4
    CsgRoleHandR = 5
    CsgRoleFootL = 6
    CsgRoleFootR = 7
    CsgRoleKneeL = 8
    CsgRoleKneeR = 9
    CsgRoleElbowL = 10
    CsgRoleElbowR = 11
    # desktop-biped roles (reserved 12..19, same reservation pattern as
    # 8..11 above): ankle joins the shank to the foot plate; each foot
    # plate is a 3-point triangle (heel + medial/lateral toe). Facts
    # validation still bounds figure roles at ElbowR, so the desktop-biped
    # producer carries these parts as CsgRoleNone until the bound moves.
    CsgRoleAnkleL = 12
    CsgRoleAnkleR = 13
    CsgRoleHeelL = 14
    CsgRoleToeLIn = 15
    CsgRoleToeLOut = 16
    CsgRoleHeelR = 17
    CsgRoleToeRIn = 18
    CsgRoleToeROut = 19
    CsgPartFigurePoint = 1
    CsgActionGrasp = 1
    CsgActionRelease = 2
    CsgActionArmPull = 3
    CsgActionLegPush = 4
    CsgActionReach = 5
    CsgActionStep = 6
    CsgFilmTotalTicks = 2400

type
    CsgWorldFacts =
        instanceId: int64
        partKind: int32[]
        partRole: int32[]
        partMassKg: float64[]
        partX: float64[]
        partY: float64[]
        partZ: float64[]
        partRadiusM: float64[]
        jointA: int32[]
        jointB: int32[]
        jointRestM: float64[]
        rope: rope3d.Rope3dSpec
        wallCx: float64[]
        wallCy: float64[]
        wallCz: float64[]
        wallHx: float64[]
        wallHy: float64[]
        wallHz: float64[]
        wallFriction: float64[]
        actionKind: int32[]
        actionPart: int32[]
        actionTargetNode: int32[]
        actionStartTick: int64[]
        actionEndTick: int64[]
        actionRateLimit: float64[]
        actionMinLen: float64[]
        actionMaxLen: float64[]
        stepPart: int32[]
        stepX: float64[]
        stepY: float64[]
        stepZ: float64[]
        stepStartTick: int64[]
        stepEndTick: int64[]
        stepRate: float64[]
        stepPlantLen: float64[]
        totalTicks: int64

fn CsgWorldFactsReset(f: var CsgWorldFacts, instance: int64) =
    f.instanceId = instance
    f.totalTicks = int64(CsgFilmTotalTicks)
    setLen(f.partKind, 0)
    setLen(f.partRole, 0)
    setLen(f.partMassKg, 0)
    setLen(f.partX, 0)
    setLen(f.partY, 0)
    setLen(f.partZ, 0)
    setLen(f.partRadiusM, 0)
    setLen(f.jointA, 0)
    setLen(f.jointB, 0)
    setLen(f.jointRestM, 0)
    f.rope.nodeCount = 0
    f.rope.nodeMassKg = 0.0
    f.rope.segmentLenM = 0.0
    f.rope.renderRadiusM = 0.0
    f.rope.anchorX = 0.0
    f.rope.anchorY = 0.0
    f.rope.anchorZ = 0.0
    setLen(f.wallCx, 0)
    setLen(f.wallCy, 0)
    setLen(f.wallCz, 0)
    setLen(f.wallHx, 0)
    setLen(f.wallHy, 0)
    setLen(f.wallHz, 0)
    setLen(f.wallFriction, 0)
    setLen(f.actionKind, 0)
    setLen(f.actionPart, 0)
    setLen(f.actionTargetNode, 0)
    setLen(f.actionStartTick, 0)
    setLen(f.actionEndTick, 0)
    setLen(f.actionRateLimit, 0)
    setLen(f.actionMinLen, 0)
    setLen(f.actionMaxLen, 0)
    setLen(f.stepPart, 0)
    setLen(f.stepX, 0)
    setLen(f.stepY, 0)
    setLen(f.stepZ, 0)
    setLen(f.stepStartTick, 0)
    setLen(f.stepEndTick, 0)
    setLen(f.stepRate, 0)
    setLen(f.stepPlantLen, 0)

fn CsgFactsAddPart(f: var CsgWorldFacts,
                   kind: int32,
                   role: int32,
                   massKg: float64,
                   x: float64,
                   y: float64,
                   z: float64,
                   radiusM: float64): int32 =
    let idx = f.partKind.len
    add(f.partKind, kind)
    add(f.partRole, role)
    add(f.partMassKg, massKg)
    add(f.partX, x)
    add(f.partY, y)
    add(f.partZ, z)
    add(f.partRadiusM, radiusM)
    return idx

fn CsgFactsAddJoint(f: var CsgWorldFacts, a: int32, b: int32, restM: float64) =
    add(f.jointA, a)
    add(f.jointB, b)
    add(f.jointRestM, restM)

fn CsgFactsAddWall(f: var CsgWorldFacts,
                   cx: float64,
                   cy: float64,
                   cz: float64,
                   hx: float64,
                   hy: float64,
                   hz: float64,
                   friction: float64) =
    add(f.wallCx, cx)
    add(f.wallCy, cy)
    add(f.wallCz, cz)
    add(f.wallHx, hx)
    add(f.wallHy, hy)
    add(f.wallHz, hz)
    add(f.wallFriction, friction)

fn CsgFactsAddAction(f: var CsgWorldFacts,
                     kind: int32,
                     part: int32,
                     targetNode: int32,
                     startTick: int64,
                     endTick: int64,
                     rateLimit: float64,
                     minLen: float64,
                     maxLen: float64) =
    add(f.actionKind, kind)
    add(f.actionPart, part)
    add(f.actionTargetNode, targetNode)
    add(f.actionStartTick, startTick)
    add(f.actionEndTick, endTick)
    add(f.actionRateLimit, rateLimit)
    add(f.actionMinLen, minLen)
    add(f.actionMaxLen, maxLen)

# A scripted footstep/hand-reach: the part is pulled toward the landing
# point by a rate-limited winch constraint to a static anchor body (the
# same bounded-rate servo family as the climb winch), held at plantLen
# (0.02 = planted foot, larger = light hand touch) until endTick, then
# released.
fn CsgFactsAddStep(f: var CsgWorldFacts,
                   part: int32,
                   x: float64,
                   y: float64,
                   z: float64,
                   startTick: int64,
                   endTick: int64,
                   rate: float64,
                   plantLen: float64) =
    add(f.stepPart, part)
    add(f.stepX, x)
    add(f.stepY, y)
    add(f.stepZ, z)
    add(f.stepStartTick, startTick)
    add(f.stepEndTick, endTick)
    add(f.stepRate, rate)
    add(f.stepPlantLen, plantLen)

# Canonical preimage uses the established str[] + Join shape (ecs.cheng
# precedent); incremental str concatenation trips body-store-freeze.
@borrows
fn CsgWorldFactsCanonicalPreimage(f: CsgWorldFacts): str =
    var parts: str[]
    add(parts, CsgWorldFactsSchema)
    add(parts, "|inst=")
    add(parts, strings.Int64ToStr(f.instanceId))
    add(parts, "|parts=")
    add(parts, strings.IntToStr(f.partKind.len))
    var i: int32 = 0
    while i < f.partKind.len:
        let massMm: int64 = numerics.CsgQuantMm(f.partMassKg[i] * 1000.0)
        let pxMm: int64 = numerics.CsgQuantMm(f.partX[i] * 1000.0)
        let pyMm: int64 = numerics.CsgQuantMm(f.partY[i] * 1000.0)
        let pzMm: int64 = numerics.CsgQuantMm(f.partZ[i] * 1000.0)
        let radMm: int64 = numerics.CsgQuantMm(f.partRadiusM[i] * 1000.0)
        add(parts, "|p")
        add(parts, strings.IntToStr(i))
        add(parts, ":")
        add(parts, strings.IntToStr(f.partKind[i]))
        add(parts, ",")
        add(parts, strings.IntToStr(f.partRole[i]))
        add(parts, ",")
        add(parts, strings.Int64ToStr(massMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(pxMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(pyMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(pzMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(radMm))
        i = i + 1
    add(parts, "|joints=")
    add(parts, strings.IntToStr(f.jointA.len))
    i = 0
    while i < f.jointA.len:
        let restMm: int64 = numerics.CsgQuantMm(f.jointRestM[i] * 1000.0)
        add(parts, "|j")
        add(parts, strings.IntToStr(i))
        add(parts, ":")
        add(parts, strings.IntToStr(f.jointA[i]))
        add(parts, ",")
        add(parts, strings.IntToStr(f.jointB[i]))
        add(parts, ",")
        add(parts, strings.Int64ToStr(restMm))
        i = i + 1
    let ropeMassMm: int64 = numerics.CsgQuantMm(f.rope.nodeMassKg * 1000.0)
    let ropeSegMm: int64 = numerics.CsgQuantMm(f.rope.segmentLenM * 1000.0)
    let ropeAxMm: int64 = numerics.CsgQuantMm(f.rope.anchorX * 1000.0)
    let ropeAyMm: int64 = numerics.CsgQuantMm(f.rope.anchorY * 1000.0)
    let ropeAzMm: int64 = numerics.CsgQuantMm(f.rope.anchorZ * 1000.0)
    add(parts, "|rope:")
    add(parts, strings.IntToStr(f.rope.nodeCount))
    add(parts, ",")
    add(parts, strings.Int64ToStr(ropeMassMm))
    add(parts, ",")
    add(parts, strings.Int64ToStr(ropeSegMm))
    add(parts, ",")
    add(parts, strings.Int64ToStr(ropeAxMm))
    add(parts, ",")
    add(parts, strings.Int64ToStr(ropeAyMm))
    add(parts, ",")
    add(parts, strings.Int64ToStr(ropeAzMm))
    add(parts, "|walls=")
    add(parts, strings.IntToStr(f.wallCx.len))
    i = 0
    while i < f.wallCx.len:
        let cxMm: int64 = numerics.CsgQuantMm(f.wallCx[i] * 1000.0)
        let cyMm: int64 = numerics.CsgQuantMm(f.wallCy[i] * 1000.0)
        let czMm: int64 = numerics.CsgQuantMm(f.wallCz[i] * 1000.0)
        let hxMm: int64 = numerics.CsgQuantMm(f.wallHx[i] * 1000.0)
        let hyMm: int64 = numerics.CsgQuantMm(f.wallHy[i] * 1000.0)
        let hzMm: int64 = numerics.CsgQuantMm(f.wallHz[i] * 1000.0)
        let frMm: int64 = numerics.CsgQuantMm(f.wallFriction[i] * 1000.0)
        add(parts, "|w")
        add(parts, strings.IntToStr(i))
        add(parts, ":")
        add(parts, strings.Int64ToStr(cxMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(cyMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(czMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(hxMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(hyMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(hzMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(frMm))
        i = i + 1
    add(parts, "|actions=")
    add(parts, strings.IntToStr(f.actionKind.len))
    i = 0
    while i < f.actionKind.len:
        let rateMm: int64 = numerics.CsgQuantMm(f.actionRateLimit[i] * 1000.0)
        let minMm: int64 = numerics.CsgQuantMm(f.actionMinLen[i] * 1000.0)
        let maxMm: int64 = numerics.CsgQuantMm(f.actionMaxLen[i] * 1000.0)
        add(parts, "|a")
        add(parts, strings.IntToStr(i))
        add(parts, ":")
        add(parts, strings.IntToStr(f.actionKind[i]))
        add(parts, ",")
        add(parts, strings.IntToStr(f.actionPart[i]))
        add(parts, ",")
        add(parts, strings.IntToStr(f.actionTargetNode[i]))
        add(parts, ",")
        add(parts, strings.Int64ToStr(f.actionStartTick[i]))
        add(parts, ",")
        add(parts, strings.Int64ToStr(f.actionEndTick[i]))
        add(parts, ",")
        add(parts, strings.Int64ToStr(rateMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(minMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(maxMm))
        i = i + 1
    add(parts, "|steps=")
    add(parts, strings.IntToStr(f.stepPart.len))
    i = 0
    while i < f.stepPart.len:
        let sxMm: int64 = numerics.CsgQuantMm(f.stepX[i] * 1000.0)
        let syMm: int64 = numerics.CsgQuantMm(f.stepY[i] * 1000.0)
        let szMm: int64 = numerics.CsgQuantMm(f.stepZ[i] * 1000.0)
        let srMm: int64 = numerics.CsgQuantMm(f.stepRate[i] * 1000.0)
        let sPMm: int64 = numerics.CsgQuantMm(f.stepPlantLen[i] * 1000.0)
        add(parts, "|s")
        add(parts, strings.IntToStr(i))
        add(parts, ":")
        add(parts, strings.IntToStr(f.stepPart[i]))
        add(parts, ",")
        add(parts, strings.Int64ToStr(sxMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(syMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(szMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(f.stepStartTick[i]))
        add(parts, ",")
        add(parts, strings.Int64ToStr(f.stepEndTick[i]))
        add(parts, ",")
        add(parts, strings.Int64ToStr(srMm))
        add(parts, ",")
        add(parts, strings.Int64ToStr(sPMm))
        i = i + 1
    add(parts, "|totalTicks=")
    add(parts, strings.Int64ToStr(f.totalTicks))
    return strutil.Join(parts, "")

@borrows
fn CsgWorldFactsCid(f: CsgWorldFacts): str =
    return strings.Sha256(CsgWorldFactsCanonicalPreimage(f))
