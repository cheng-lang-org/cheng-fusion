# Pure cheng ONNX inference for MICRODUCK alpha policies.
# 4-layer MLP: 61 -> 512(ELU) -> 256(ELU) -> 128(ELU) -> 14
# Weights loaded from binary file (float64 LE, 197896 values = 1.58 MB).
# Forward pass: ~200k multiply-adds per inference, runs in < 1ms.

import std/os
import std/rawbytes
import std/rawmem_support
import cheng/game/csg/numerics

const OnnxObsDim: int32 = 61
const OnnxH1Dim: int32 = 512
const OnnxH2Dim: int32 = 256
const OnnxH3Dim: int32 = 128
const OnnxActDim: int32 = 14
const OnnxTotalParams: int32 = 197896

const OnnxOffObsMean: int32 = 0
const OnnxOffObsStd: int32 = 61
const OnnxOffW1: int32 = 122
const OnnxOffB1: int32 = 31354
const OnnxOffW2: int32 = 31866
const OnnxOffB2: int32 = 162938
const OnnxOffW3: int32 = 163194
const OnnxOffB3: int32 = 195962
const OnnxOffW4: int32 = 196090
const OnnxOffB4: int32 = 197882

var onnxW: float64[197896]
var onnxReady: bool = false

fn OnnxLoadWeights(path: str): bool =
    let data = os.ReadFileBytes(path)
    if data.len < OnnxTotalParams * 8:
        return false
    var i: int32 = 0
    while i < OnnxTotalParams:
        var v: float64
        rawmem_support.RawmemCopy(ptr(&v), rawmem_support.RawmemPtrAdd(rawbytes.BytesDataPtr(data), i * 8), 8)
        onnxW[i] = v
        i = i + 1
    onnxReady = true
    return true

fn OnnxElu(x: float64): float64 =
    if x > 0.0:
        return x
    let x2: float64 = x * x
    let x3: float64 = x2 * x
    let x4: float64 = x2 * x2
    let x5: float64 = x4 * x
    let x6: float64 = x4 * x2
    return x + x2 * 0.5 + x3 / 6.0 + x4 / 24.0 + x5 / 120.0 + x6 / 720.0

fn OnnxForward(obs: float64[], actions: float64[]) =
    if !onnxReady:
        return
    var norm: float64[OnnxObsDim]
    var i: int32 = 0
    while i < OnnxObsDim:
        norm[i] = (obs[i] - onnxW[OnnxOffObsMean + i]) / onnxW[OnnxOffObsStd + i]
        i = i + 1
    var h1: float64[OnnxH1Dim]
    i = 0
    while i < OnnxH1Dim:
        var acc: float64 = onnxW[OnnxOffB1 + i]
        var j: int32 = 0
        while j < OnnxObsDim:
            acc = acc + onnxW[OnnxOffW1 + i * OnnxObsDim + j] * norm[j]
            j = j + 1
        h1[i] = OnnxElu(acc)
        i = i + 1
    var h2: float64[OnnxH2Dim]
    i = 0
    while i < OnnxH2Dim:
        var acc: float64 = onnxW[OnnxOffB2 + i]
        var j: int32 = 0
        while j < OnnxH1Dim:
            acc = acc + onnxW[OnnxOffW2 + i * OnnxH1Dim + j] * h1[j]
            j = j + 1
        h2[i] = OnnxElu(acc)
        i = i + 1
    var h3: float64[OnnxH3Dim]
    i = 0
    while i < OnnxH3Dim:
        var acc: float64 = onnxW[OnnxOffB3 + i]
        var j: int32 = 0
        while j < OnnxH2Dim:
            acc = acc + onnxW[OnnxOffW3 + i * OnnxH2Dim + j] * h2[j]
            j = j + 1
        h3[i] = OnnxElu(acc)
        i = i + 1
    i = 0
    while i < OnnxActDim:
        var acc: float64 = onnxW[OnnxOffB4 + i]
        var j: int32 = 0
        while j < OnnxH3Dim:
            acc = acc + onnxW[OnnxOffW4 + i * OnnxH3Dim + j] * h3[j]
            j = j + 1
        actions[i] = acc
        i = i + 1
