# Materializer (B2): facts -> live World3D. Refuses invalid facts (the
# validation verdict is re-checked here), spawns bodies/joints/rope/walls
# in frozen order, and hands back the exact slot mapping that binds
# semantic parts, rope nodes and world rows for the whole pipeline.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/world3d
import cheng/game/rope3d
import std/strings as strings

const
    CsgMaterializerSchema = "cheng.game.csg.materializer.v1"
    CsgMaterializerOk = 1
    CsgMaterializerInvalidFacts = 2

type
    CsgMaterializerMapping =
        partCount: int32
        partSlot: int32[]
        ropeNodeCount: int32
        ropeNodeSlot: int32[]

    CsgMaterializerReceipt =
        schema: str
        statusCode: int32
        sourceFactsCid: str
        resultWorldCid: str
        bodyCount: int32
        constraintCount: int32
        receiptCid: str

fn CsgMappingPartSlotAt(mp: CsgMaterializerMapping, part: int32): int32 =
    if part < 0 || part >= mp.partCount:
        return -1
    return mp.partSlot[part]

fn CsgMappingRopeNodeSlotAt(mp: CsgMaterializerMapping, node: int32): int32 =
    if node < 0 || node >= mp.ropeNodeCount:
        return -1
    return mp.ropeNodeSlot[node]

# rope node indices in facts count from the anchor (0) down to the free
# end; world rope slots were spawned anchor-first, so index == spawn order.
@borrows
fn CsgMaterialize(facts: schema.CsgWorldFacts,
                  w: var World3d,
                  mp: var CsgMaterializerMapping,
                  err: var str): bool =
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        err = "csg materializer: facts rejected by validation"
        return false
    World3dReset(w, facts.instanceId)
    setLen(mp.partSlot, 0)
    setLen(mp.ropeNodeSlot, 0)
    mp.partCount = facts.partKind.len
    var i: int32 = 0
    while i < facts.partKind.len:
        let slot = World3dSpawnBody(w,
            facts.partX[i], facts.partY[i], facts.partZ[i],
            facts.partMassKg[i], facts.partRadiusM[i],
            world3d.World3dBodyDynamic)
        add(mp.partSlot, slot)
        i = i + 1
    i = 0
    while i < facts.jointA.len:
        let aPart = facts.jointA[i]
        let bPart = facts.jointB[i]
        if aPart < 0 || aPart >= mp.partCount || bPart < 0 || bPart >= mp.partCount:
            err = "csg materializer: joint part out of range"
            return false
        let aSlot = mp.partSlot[aPart]
        let bSlot = mp.partSlot[bPart]
        let _ci = World3dAddConstraint(w, aSlot, bSlot, facts.jointRestM[i], world3d.World3dConJoint)
        i = i + 1
    let lowestNode = rope3d.Rope3dBuild(w, facts.rope)
    mp.ropeNodeCount = facts.rope.nodeCount
    if mp.ropeNodeCount == 0:
        # rope-free scene: no anchor, no node mapping
        i = 0
        while i < facts.wallCx.len:
            World3dAddWall(w,
                facts.wallCx[i], facts.wallCy[i], facts.wallCz[i],
                facts.wallHx[i], facts.wallHy[i], facts.wallHz[i],
                facts.wallFriction[i])
            i = i + 1
        return true
    # anchor spawned first, then nodes top-down; node k lives at
    # slot (lowestNode - nodeCount + 1 + k).
    let firstNodeSlot = lowestNode - mp.ropeNodeCount + 1
    if firstNodeSlot - 1 < 0:
        err = "csg materializer: rope anchor slot out of range"
        return false
    i = 0
    while i < mp.ropeNodeCount:
        add(mp.ropeNodeSlot, firstNodeSlot + i)
        i = i + 1
    if mp.ropeNodeSlot[mp.ropeNodeCount - 1] != lowestNode:
        err = "csg materializer: rope node slot mapping mismatch"
        return false
    i = 0
    while i < facts.wallCx.len:
        World3dAddWall(w,
            facts.wallCx[i], facts.wallCy[i], facts.wallCz[i],
            facts.wallHx[i], facts.wallHy[i], facts.wallHz[i],
            facts.wallFriction[i])
        i = i + 1
    return true
