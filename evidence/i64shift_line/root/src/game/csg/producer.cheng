# Producer (B1): builds the frozen 10-second climb scene fact set.
# One figure (70 kg), one rope (2 kg, 10 nodes), one wall (pedal face),
# scripted alternating grasps + leg pushes. Deterministic; the produced
# facts bind their CID and are the only world authority downstream.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/numerics
import std/strings as strings
import std/strutils as strutil
import std/math as m

const
    CsgProducerSchema = "cheng.game.csg.producer.v1"
    CsgProducerInstance = 20260906
    CsgGraspReachM = 0.30
    CsgWinchMinLenM = 0.03
    CsgArmPullRateMps = 0.10
    CsgLegPushRateMps = 0.50
    CsgLegRestM = 0.78
    CsgLegPushMaxM = 0.98

type
    CsgProducerReceipt =
        schema: str
        factsCid: str
        validationStatus: int32
        partCount: int32
        jointCount: int32
        actionCount: int32
        receiptCid: str

# Exact initial-pose distance between two parts: the frozen joint rest
# length, so the materialized world starts with zero constraint violation.
@borrows
fn CsgJointRestFromPose(f: schema.CsgWorldFacts, a: int32, b: int32): float64 =
    let dx = f.partX[b] - f.partX[a]
    let dy = f.partY[b] - f.partY[a]
    let dz = f.partZ[b] - f.partZ[a]
    return numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)

# Figure part indices (frozen order): 0 pelvis, 1 chest, 2 head,
# 3 handL, 4 handR, 5 footL, 6 footR. Rope nodes are numbered 0..9 from
# the anchor down (node 9 = free end, z = 1.0).
fn CsgProducerBuildClimbScene(): schema.CsgWorldFacts =
    var f: schema.CsgWorldFacts
    schema.CsgWorldFactsReset(f, CsgProducerInstance)
    # figure (79 kg): hanging start below the rope's free end, arms
    # overhead, knees bent with both feet on the low rope — the real
    # climb technique: hands grip high, feet pinch the low rope, the legs
    # push the body up, then the hands re-grip higher
    let pelvis = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRolePelvis, 30.0, 0.0, 0.70, 0.76, 0.12)
    let chest = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleChest, 25.0, 0.0, 0.70, 1.06, 0.14)
    let head = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHead, 8.0, 0.0, 0.70, 1.33, 0.11)
    let handL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandL, 6.0, 0.0, 0.88, 1.44, 0.05)
    let handR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandR, 6.0, 0.15, 0.87, 1.40, 0.05)
    let footL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootL, 2.0, -0.06, 0.88, 0.30, 0.06)
    let footR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootR, 2.0, 0.06, 0.88, 0.55, 0.06)
    # joints: rest lengths are the exact initial-pose distances (frozen
    # function of the frozen coordinates), so the world starts settled
    schema.CsgFactsAddJoint(f, pelvis, chest, CsgJointRestFromPose(f, pelvis, chest))
    schema.CsgFactsAddJoint(f, chest, head, CsgJointRestFromPose(f, chest, head))
    schema.CsgFactsAddJoint(f, chest, handL, CsgJointRestFromPose(f, chest, handL))
    schema.CsgFactsAddJoint(f, chest, handR, CsgJointRestFromPose(f, chest, handR))
    schema.CsgFactsAddJoint(f, pelvis, footL, CsgJointRestFromPose(f, pelvis, footL))
    schema.CsgFactsAddJoint(f, pelvis, footR, CsgJointRestFromPose(f, pelvis, footR))
    # rope: anchor (0, 0.9, 6.0), 22 nodes x 0.25 m = 5.5 m (1.98 kg);
    # the free end n21 hangs to z = 0.5 — low enough for the feet to pinch
    f.rope.nodeCount = 22
    f.rope.nodeMassKg = 0.09
    f.rope.segmentLenM = 0.25
    f.rope.renderRadiusM = 0.015
    f.rope.anchorX = 0.0
    f.rope.anchorY = 0.9
    f.rope.anchorZ = 6.0
    # wall: pedal face at y=0.5, z in [0,4], x in [-2,2]
    schema.CsgFactsAddWall(f, 0.0, 0.2, 2.0, 2.0, 0.3, 2.0, 0.8)
    # action script — the real climb cycle (hands high, feet pinch the
    # low rope, legs push, hands re-grip):
    #   both hands grip n17/n16; feet pinch n21/n20 for the whole film;
    #   three leg-push cycles (knee extension lifts the body along the
    #   pinched rope) interleaved with hand winches and higher re-grips
    schema.CsgFactsAddAction(f, schema.CsgActionGrasp, handL, 17, int64(0), int64(950), 0.0, 0.0, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handR, 16, int64(0), int64(950), 0.0, 0.0, 0.70)
    # feet pinch the low rope and stay pinched
    schema.CsgFactsAddAction(f, schema.CsgActionReach, footL, 21, int64(100), int64(2399), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, footR, 20, int64(150), int64(2399), 0.0, 0.0, 0.70)
    # cycle 1: winch, then leg push
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(300), int64(700), 0.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handR, -1, int64(500), int64(900), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(650), int64(900), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(900), int64(1150), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    # hands re-grip higher while the feet hold
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handL, 15, int64(960), int64(2150), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handR, 14, int64(1560), int64(2399), 0.0, 0.0, 0.70)
    # cycle 2
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(980), int64(1490), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handR, -1, int64(1580), int64(2090), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(1250), int64(1500), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(1550), int64(1800), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    # cycle 3
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handL, 13, int64(2160), int64(2399), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(2180), int64(2390), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(1850), int64(2100), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(2150), int64(2390), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    return f

# Frozen walk scene (F): traverse along the climbing wall — the right
# hand stays anchored on the wall face (three-point support, the honest
# stability mechanism for a point-mass figure with no ankle torques)
# while the feet shuffle along +x. `steps` shuffling steps, then a
# standing tail. Prompt-applier entry (F): step count comes from the
# parsed prompt intent; steps must be even.
fn CsgProducerBuildWalkSceneSteps(steps: int32): schema.CsgWorldFacts =
    var f: schema.CsgWorldFacts
    schema.CsgWorldFactsReset(f, CsgProducerInstance)
    # standing pose beside the wall (face at y = 0.5), right hand on it
    let pelvis = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRolePelvis, 30.0, 0.0, 0.85, 0.72, 0.12)
    let chest = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleChest, 25.0, 0.0, 0.85, 1.02, 0.14)
    let head = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHead, 8.0, 0.0, 0.85, 1.29, 0.11)
    let handL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandL, 6.0, 0.18, 0.92, 0.50, 0.05)
    let handR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandR, 6.0, 0.0, 0.55, 1.44, 0.05)
    let footL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootL, 2.0, 0.10, 0.85, 0.06, 0.06)
    let footR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootR, 2.0, -0.10, 0.85, 0.06, 0.06)
    schema.CsgFactsAddJoint(f, pelvis, chest, CsgJointRestFromPose(f, pelvis, chest))
    schema.CsgFactsAddJoint(f, chest, head, CsgJointRestFromPose(f, chest, head))
    # posture struts (F): the wall arm is a structural brace and a
    # pelvis-head tie keeps the torso upright — distance-constraint
    # "muscles" giving the point-mass torso its pose stiffness
    schema.CsgFactsAddJoint(f, pelvis, handR, CsgJointRestFromPose(f, pelvis, handR))
    schema.CsgFactsAddJoint(f, pelvis, head, CsgJointRestFromPose(f, pelvis, head))
    schema.CsgFactsAddJoint(f, chest, handL, CsgJointRestFromPose(f, chest, handL))
    schema.CsgFactsAddJoint(f, chest, handR, CsgJointRestFromPose(f, chest, handR))
    schema.CsgFactsAddJoint(f, pelvis, footL, CsgJointRestFromPose(f, pelvis, footL))
    schema.CsgFactsAddJoint(f, pelvis, footR, CsgJointRestFromPose(f, pelvis, footR))
    # rope-free scene: the zeroed spec is the validated no-rope form
    f.rope.nodeCount = 0
    # the same pedal wall as the climb scene provides the handholds
    schema.CsgFactsAddWall(f, 0.0, 0.2, 2.0, 2.0, 0.3, 2.0, 0.8)
    # station anchors: both feet plus the wall hand, each until its first
    # moving window opens
    schema.CsgFactsAddStep(f, footL, 0.10, 0.85, 0.06, int64(0), int64(345), 0.80, 0.02)
    schema.CsgFactsAddStep(f, footR, -0.10, 0.85, 0.06, int64(0), int64(210), 0.80, 0.02)
    schema.CsgFactsAddStep(f, handR, 0.0, 0.55, 1.44, int64(0), int64(210), 0.80, 0.15)
    # wall-anchor chain paced with the steps: one 540-tick reach per pair
    var hTick: int64 = int64(210)
    var hx: float64 = 0.25
    var h: int32 = 0
    while h < steps / 2:
        schema.CsgFactsAddStep(f, handR, hx, 0.58, 1.40, hTick, hTick + int64(540), 0.80, 0.15)
        hx = hx + 0.45
        hTick = hTick + int64(540)
        h = h + 1
    # shuffling steps along +x (0.25 m landings, 270-tick windows on a
    # 135-tick half cycle so one foot is always anchored)
    var sTick: int64 = int64(210)
    var feet: int32[] = [footR, footL]
    var sideX: float64[] = [-0.10, 0.10]
    var laneX: float64 = 0.40
    var k: int32 = 0
    while k < steps:
        schema.CsgFactsAddStep(f, feet[k % 2], laneX + sideX[k % 2], 0.85, 0.06,
            sTick, sTick + int64(270), 0.80, 0.02)
        if k % 2 == 1:
            laneX = laneX + 0.25
        sTick = sTick + int64(135)
        k = k + 1
    return f

fn CsgProducerBuildWalkScene(): schema.CsgWorldFacts =
    return CsgProducerBuildWalkSceneSteps(6)

@borrows
fn CsgProducerReceiptCid(r: CsgProducerReceipt): str =
    var parts: str[]
    add(parts, Fmt"{r.schema}")
    add(parts, "|facts=")
    add(parts, Fmt"{r.factsCid}")
    add(parts, "|valid=")
    add(parts, strings.IntToStr(r.validationStatus))
    add(parts, "|parts=")
    add(parts, strings.IntToStr(r.partCount))
    add(parts, "|joints=")
    add(parts, strings.IntToStr(r.jointCount))
    add(parts, "|actions=")
    add(parts, strings.IntToStr(r.actionCount))
    return strings.Sha256(strutil.Join(parts, ""))

# Produce + validate: the receipt carries the validation verdict; a failed
# validation must abort the pipeline (materializer refuses invalid facts).
fn CsgProducerProduceClimbScene(): CsgProducerReceipt =
    var facts: schema.CsgWorldFacts = CsgProducerBuildClimbScene()
    var receipt: CsgProducerReceipt
    receipt.schema = CsgProducerSchema
    receipt.factsCid = schema.CsgWorldFactsCid(facts)
    var verdict = validation.CsgValidateFacts(facts)
    receipt.validationStatus = verdict.statusCode
    receipt.partCount = facts.partKind.len
    receipt.jointCount = facts.jointA.len
    receipt.actionCount = facts.actionKind.len
    receipt.receiptCid = CsgProducerReceiptCid(receipt)
    return receipt

# Frozen journey scene (JOURNEY): one 14400-tick continuous take. The
# figure starts standing beside the pedal wall (the proven walk pose,
# right hand braced on the wall face), walks eight shuffling steps along
# +x under the rope (anchor above the walk destination, wall parallel to
# the walk line so the brace stays honest), transitions onto the rope
# (left hand reaches first, feet pinch the low nodes, right hand swaps
# off the wall), climbs five arm-pull/leg-push cycles up the node ladder
# (17/16 -> 9/8), and finishes hanging tall on the high grips with the
# legs extended.
const
    CsgJourneyTotalTicks = 14400
    CsgJourneyWalkStartTick = 1800
    CsgJourneyWalkSteps = 8

fn CsgProducerBuildJourneyScene(): schema.CsgWorldFacts =
    var f: schema.CsgWorldFacts
    schema.CsgWorldFactsReset(f, CsgProducerInstance)
    f.totalTicks = int64(CsgJourneyTotalTicks)
    # figure: the proven walk-scene standing pose (right hand on the wall)
    let pelvis = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRolePelvis, 30.0, 0.0, 0.85, 0.72, 0.12)
    let chest = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleChest, 25.0, 0.0, 0.85, 1.02, 0.14)
    let head = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHead, 8.0, 0.0, 0.85, 1.29, 0.11)
    let handL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandL, 6.0, 0.18, 0.92, 0.50, 0.05)
    let handR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandR, 6.0, 0.0, 0.55, 1.44, 0.05)
    let footL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootL, 2.0, 0.10, 0.85, 0.06, 0.06)
    let footR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootR, 2.0, -0.10, 0.85, 0.06, 0.06)
    # joints: exact initial-pose distances (walk-scene posture set: the
    # wall arm brace plus the pelvis-head tie keep the torso honest)
    schema.CsgFactsAddJoint(f, pelvis, chest, CsgJointRestFromPose(f, pelvis, chest))
    schema.CsgFactsAddJoint(f, chest, head, CsgJointRestFromPose(f, chest, head))
    schema.CsgFactsAddJoint(f, pelvis, handR, CsgJointRestFromPose(f, pelvis, handR))
    schema.CsgFactsAddJoint(f, pelvis, head, CsgJointRestFromPose(f, pelvis, head))
    schema.CsgFactsAddJoint(f, chest, handL, CsgJointRestFromPose(f, chest, handL))
    schema.CsgFactsAddJoint(f, chest, handR, CsgJointRestFromPose(f, chest, handR))
    schema.CsgFactsAddJoint(f, pelvis, footL, CsgJointRestFromPose(f, pelvis, footL))
    schema.CsgFactsAddJoint(f, pelvis, footR, CsgJointRestFromPose(f, pelvis, footR))
    # rope: 22 nodes x 0.25 m anchored above the walk destination so the
    # whole approach keeps the right hand braced on the +x-parallel wall
    f.rope.nodeCount = 22
    f.rope.nodeMassKg = 0.09
    f.rope.segmentLenM = 0.25
    f.rope.renderRadiusM = 0.015
    f.rope.anchorX = 1.2
    f.rope.anchorY = 0.9
    f.rope.anchorZ = 6.0
    # the same pedal wall as the climb/walk scenes
    schema.CsgFactsAddWall(f, 0.0, 0.2, 2.0, 2.0, 0.3, 2.0, 0.8)
    # phase A: standing stations (each ends where the part's first moving
    # window opens — no free-floating limb, no overlapping anchors)
    schema.CsgFactsAddStep(f, footL, 0.10, 0.85, 0.06, int64(0), int64(1934), 0.80, 0.02)
    schema.CsgFactsAddStep(f, footR, -0.10, 0.85, 0.06, int64(0), int64(1799), 0.80, 0.02)
    schema.CsgFactsAddStep(f, handR, 0.0, 0.55, 1.44, int64(0), int64(1799), 0.80, 0.15)
    # phase B: eight shuffling steps along +x (0.25 m landings on the
    # 135-tick half cycle / 270-tick window) with the wall-anchor chain
    # paced one brace window per step pair
    var sTick: int64 = int64(CsgJourneyWalkStartTick)
    var feet: int32[] = [footR, footL]
    var sideX: float64[] = [-0.10, 0.10]
    var laneX: float64 = 0.40
    var k: int32 = 0
    while k < CsgJourneyWalkSteps:
        schema.CsgFactsAddStep(f, feet[k % 2], laneX + sideX[k % 2], 0.85, 0.06,
            sTick, sTick + int64(270), 0.80, 0.02)
        if k % 2 == 1:
            laneX = laneX + 0.25
        sTick = sTick + int64(135)
        k = k + 1
    var hTick: int64 = int64(CsgJourneyWalkStartTick)
    var hx: float64 = 0.25
    var h: int32 = 0
    while h < CsgJourneyWalkSteps / 2 - 1:
        schema.CsgFactsAddStep(f, handR, hx, 0.58, 1.40, hTick, hTick + int64(270), 0.80, 0.15)
        hx = hx + 0.45
        hTick = hTick + int64(270)
        h = h + 1
    # the last brace holds until the rope swap releases the wall hand
    schema.CsgFactsAddStep(f, handR, 1.40, 0.58, 1.40, hTick, int64(3100), 0.80, 0.15)
    # phase C: onto the rope — left hand reaches first (wall brace still
    # live), then the feet pinch the low nodes, then the right hand swaps
    # from the wall to the rope; both feet stay pinched to the film end
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handL, 17, int64(2880), int64(5579), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, footL, 21, int64(3020), int64(14399), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, footR, 20, int64(3120), int64(14399), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handR, 16, int64(3200), int64(5879), 0.0, 0.0, 0.70)
    # phase D: five climb cycles — alternate arm winches haul the chest to
    # the gripped node, leg pushes extend the pinned legs, then the free
    # hand re-grips two nodes higher; the winches always live inside one
    # exact grip window (never across a release gap)
    # cycle 1
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(4300), int64(5560), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handR, -1, int64(4750), int64(5860), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(4800), int64(5050), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(5100), int64(5350), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    # cycle 2 (hands re-grip 15/14)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handL, 15, int64(5590), int64(7059), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handR, 14, int64(5900), int64(7359), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(5750), int64(7040), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handR, -1, int64(6050), int64(7340), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(6100), int64(6350), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(6400), int64(6650), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    # cycle 3 (hands re-grip 13/12)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handL, 13, int64(7070), int64(8539), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handR, 12, int64(7390), int64(8849), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(7230), int64(8520), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handR, -1, int64(7550), int64(8830), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(7450), int64(7700), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(7750), int64(8000), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    # cycle 4 (hands re-grip 11/10)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handL, 11, int64(8570), int64(10039), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handR, 10, int64(8880), int64(10349), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(8730), int64(10020), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handR, -1, int64(9050), int64(10330), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(8800), int64(9050), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(9100), int64(9350), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    # cycle 5 (left hand re-grips 9; the right hand takes its final 8)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handL, 9, int64(10070), int64(11539), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handR, 8, int64(10380), int64(14399), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(10230), int64(11520), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handR, -1, int64(10550), int64(11830), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(10150), int64(10400), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(10450), int64(10700), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    # phase E: the finish — the left hand takes its final high grip 7,
    # both winches settle the hang, and a last leg stretch holds tall to
    # the final frame
    schema.CsgFactsAddAction(f, schema.CsgActionReach, handL, 7, int64(11570), int64(14399), 0.0, 0.0, 0.70)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handL, -1, int64(11730), int64(13260), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionArmPull, handR, -1, int64(12030), int64(13560), 1.50, CsgWinchMinLenM, 0.0)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footL, -1, int64(13700), int64(13950), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    schema.CsgFactsAddAction(f, schema.CsgActionLegPush, footR, -1, int64(14050), int64(14395), CsgLegPushRateMps, CsgLegRestM, CsgLegPushMaxM)
    return f

# Frozen playground scene (PLAYGROUND): the interactive --play sandbox.
# Design intent: the static action table only anchors the standing pose
# for the first 690 ticks (both feet plus the wall hand, the walk
# scene's opening stations); after that the world is deliberately empty
# so keyboard-injected dynamic commands (WALK/CAM) own the physics for
# the full 14400-tick (60 s) interaction window. Any static action
# beyond tick 690 would physically reject the injected walk queue
# (residual overload), so there is no hand-reach chain, no gait table,
# and no rope (nodeCount = 0) — unlike climb/walk/journey the film is
# the player's, not the script's.
const
    CsgPlaygroundTotalTicks = 14400
    CsgPlaygroundAnchorEndTick = 690

fn CsgProducerBuildPlaygroundScene(): schema.CsgWorldFacts =
    var f: schema.CsgWorldFacts
    schema.CsgWorldFactsReset(f, CsgProducerInstance)
    f.totalTicks = int64(CsgPlaygroundTotalTicks)
    # figure: the proven walk-scene standing pose (right hand on the wall)
    let pelvis = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRolePelvis, 30.0, 0.0, 0.85, 0.72, 0.12)
    let chest = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleChest, 25.0, 0.0, 0.85, 1.02, 0.14)
    let head = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHead, 8.0, 0.0, 0.85, 1.29, 0.11)
    let handL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandL, 6.0, 0.18, 0.92, 0.50, 0.05)
    let handR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandR, 6.0, 0.0, 0.55, 1.44, 0.05)
    let footL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootL, 2.0, 0.10, 0.85, 0.06, 0.06)
    let footR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootR, 2.0, -0.10, 0.85, 0.06, 0.06)
    # joints: exact initial-pose distances (walk-scene posture set: the
    # wall arm brace plus the pelvis-head tie keep the torso honest)
    schema.CsgFactsAddJoint(f, pelvis, chest, CsgJointRestFromPose(f, pelvis, chest))
    schema.CsgFactsAddJoint(f, chest, head, CsgJointRestFromPose(f, chest, head))
    schema.CsgFactsAddJoint(f, pelvis, handR, CsgJointRestFromPose(f, pelvis, handR))
    schema.CsgFactsAddJoint(f, pelvis, head, CsgJointRestFromPose(f, pelvis, head))
    schema.CsgFactsAddJoint(f, chest, handL, CsgJointRestFromPose(f, chest, handL))
    schema.CsgFactsAddJoint(f, chest, handR, CsgJointRestFromPose(f, chest, handR))
    schema.CsgFactsAddJoint(f, pelvis, footL, CsgJointRestFromPose(f, pelvis, footL))
    schema.CsgFactsAddJoint(f, pelvis, footR, CsgJointRestFromPose(f, pelvis, footR))
    # rope-free scene: the zeroed spec is the validated no-rope form
    f.rope.nodeCount = 0
    # the same pedal wall as the climb/walk scenes
    schema.CsgFactsAddWall(f, 0.0, 0.2, 2.0, 2.0, 0.3, 2.0, 0.8)
    # standing stations: the walk scene's opening anchors, each held to
    # tick 690 — the only static table entries in this world
    schema.CsgFactsAddStep(f, footL, 0.10, 0.85, 0.06, int64(0), int64(CsgPlaygroundAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, footR, -0.10, 0.85, 0.06, int64(0), int64(CsgPlaygroundAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, handR, 0.0, 0.55, 1.44, int64(0), int64(CsgPlaygroundAnchorEndTick), 0.80, 0.15)
    return f

# Frozen skeleton scene (SKELETON): step one of figure skeletization — a
# visual skeleton overlay on the proven physical skeleton. Design intent:
# the base is the exact playground standing world (7-point walk-scene
# figure, same coordinates/masses/radii, same pedal wall, standing
# stations on footL/footR/handR/handL held to tick 690, rope-free,
# 14400-tick film), and on
# top of it four mid-segment visual mass points are attached without
# touching any proven restraint: kneeL/kneeR between pelvis and the
# matching foot (segment midpoint, +0.03 z for the bent-knee stance),
# elbowL/elbowR between chest and the matching hand (segment midpoint).
# Each overlay point rides two exact-pose restraints (knee-pelvis +
# knee-foot, elbow-chest + elbow-hand, all CsgJointRestFromPose), while
# the original pelvis-foot / chest-hand joints stay — the overlay is
# purely additive, so the physical skeleton carries zero risk (the scene
# CID itself moves — roles feed the facts preimage). Overlay points carry
# the semantic schema roles CsgRoleKneeL..CsgRoleElbowR (validation
# bounds figure roles at CsgRoleAnkleR), so the renderer locates them by
# role.
const
    CsgSkeletonTotalTicks = 14400
    CsgSkeletonAnchorEndTick = 690

fn CsgProducerBuildSkeletonScene(): schema.CsgWorldFacts =
    var f: schema.CsgWorldFacts
    schema.CsgWorldFactsReset(f, CsgProducerInstance)
    f.totalTicks = int64(CsgSkeletonTotalTicks)
    # figure: the proven walk-scene standing pose (right hand on the wall)
    let pelvis = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRolePelvis, 30.0, 0.0, 0.85, 0.72, 0.12)
    let chest = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleChest, 25.0, 0.0, 0.85, 1.02, 0.14)
    let head = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHead, 8.0, 0.0, 0.85, 1.29, 0.11)
    let handL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandL, 6.0, 0.18, 0.92, 0.50, 0.05)
    let handR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandR, 6.0, 0.0, 0.55, 1.44, 0.05)
    let footL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootL, 2.0, 0.10, 0.85, 0.06, 0.06)
    let footR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootR, 2.0, -0.10, 0.85, 0.06, 0.06)
    # joints: exact initial-pose distances (walk-scene posture set: the
    # wall arm brace plus the pelvis-head tie keep the torso honest)
    schema.CsgFactsAddJoint(f, pelvis, chest, CsgJointRestFromPose(f, pelvis, chest))
    schema.CsgFactsAddJoint(f, chest, head, CsgJointRestFromPose(f, chest, head))
    schema.CsgFactsAddJoint(f, pelvis, handR, CsgJointRestFromPose(f, pelvis, handR))
    schema.CsgFactsAddJoint(f, pelvis, head, CsgJointRestFromPose(f, pelvis, head))
    schema.CsgFactsAddJoint(f, chest, handL, CsgJointRestFromPose(f, chest, handL))
    schema.CsgFactsAddJoint(f, chest, handR, CsgJointRestFromPose(f, chest, handR))
    schema.CsgFactsAddJoint(f, pelvis, footL, CsgJointRestFromPose(f, pelvis, footL))
    schema.CsgFactsAddJoint(f, pelvis, footR, CsgJointRestFromPose(f, pelvis, footR))
    # visual skeleton overlay points: two per limb segment pair, exact
    # mid-segment coordinates (knees biased +0.03 z for the bent-knee
    # stance); overlay masses ride the proven joint net additively
    let kneeL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleKneeL, 2.0, 0.05, 0.85, 0.42, 0.06)
    let kneeR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleKneeR, 2.0, -0.05, 0.85, 0.42, 0.06)
    let elbowL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleElbowL, 2.0, 0.09, 0.885, 0.76, 0.05)
    let elbowR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleElbowR, 2.0, 0.0, 0.70, 1.23, 0.05)
    # overlay restraints: two exact-pose joints per overlay point; the
    # original pelvis-foot / chest-hand restraints above stay untouched
    schema.CsgFactsAddJoint(f, kneeL, pelvis, CsgJointRestFromPose(f, kneeL, pelvis))
    schema.CsgFactsAddJoint(f, kneeL, footL, CsgJointRestFromPose(f, kneeL, footL))
    schema.CsgFactsAddJoint(f, kneeR, pelvis, CsgJointRestFromPose(f, kneeR, pelvis))
    schema.CsgFactsAddJoint(f, kneeR, footR, CsgJointRestFromPose(f, kneeR, footR))
    schema.CsgFactsAddJoint(f, elbowL, chest, CsgJointRestFromPose(f, elbowL, chest))
    schema.CsgFactsAddJoint(f, elbowL, handL, CsgJointRestFromPose(f, elbowL, handL))
    schema.CsgFactsAddJoint(f, elbowR, chest, CsgJointRestFromPose(f, elbowR, chest))
    schema.CsgFactsAddJoint(f, elbowR, handR, CsgJointRestFromPose(f, elbowR, handR))
    # rope-free scene: the zeroed spec is the validated no-rope form
    f.rope.nodeCount = 0
    # the same pedal wall as the climb/walk scenes
    schema.CsgFactsAddWall(f, 0.0, 0.2, 2.0, 2.0, 0.3, 2.0, 0.8)
    # standing stations: the playground opening anchors (footL/footR/
    # handR, rate 0.80, window 0..690) with two mechanical corrections
    # against the step-winch contract (target starts at the spawn
    # distance and is bounded below by plantLen):
    #   1. the anchor spawns exactly one plant length away from the
    #      part's standing spot (feet: +0.02 z; wall hand: +0.02 y), so
    #      dist0 = plantLen and the tether is born satisfied — a spawn
    #      exactly ON the part (dist0 = 0) inverts the winch into a jack
    #      and fires a degenerate mega-projection on tick 0 (the
    #      walk-scene standing anchors share that latent defect; the
    #      climb scene has no steps, so it never surfaces there);
    #   2. the wall hand uses the feet's 0.02 plant (not 0.15): a 0.15
    #      leash lets the hand slide down its sphere off the wall face,
    #      which dissolves the three-point support into a toppling
    #      two-foot inverted pendulum — the 0.02 leash pins the grip and
    #      keeps the wall brace honest;
    #   3. the idle left hand joins the stations (0.02 leash at its pose,
    #      same window): the walk pose hangs it from the chest on one
    #      rod, 20 degrees off vertical — a free pendulum that drags the
    #      elbow overlay ~80 mm inside 100 ticks, so an exhibit standing
    #      pose stations it too and the whole overlay holds millimetres.
    schema.CsgFactsAddStep(f, footL, 0.10, 0.85, 0.08, int64(0), int64(CsgSkeletonAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, footR, -0.10, 0.85, 0.08, int64(0), int64(CsgSkeletonAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, handR, 0.0, 0.57, 1.44, int64(0), int64(CsgSkeletonAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, handL, 0.18, 0.92, 0.52, int64(0), int64(CsgSkeletonAnchorEndTick), 0.80, 0.02)
    return f

# Frozen ball-balance scene (BALLBALANCE): step one of the standing-on-a-
# rolling-ball milestone (the Isaac Sim ball-balance demo analogue).
# Chain-gap finding (frozen): the facts -> materializer -> world chain
# cannot express a rigid ball body — CsgMaterialize spawns every facts
# part as World3dBodyDynamic and the facts schema has no body-kind or
# angular-velocity columns — so the ball itself is NOT part of these
# facts. The facts carry the standard 7-point figure in the ball-top
# stance (the proven playground joint/mass/strut set translated +0.70 z
# so both feet sit on the apex region of the execution-side ball) plus
# 100-tick standing stations; the ball is injected on the execution side
# by src/tests/ball_balance_probe.cheng with exactly the frozen ball
# parameters below, and the chain gap is reported as an open defect.
const
    CsgBallBalanceTotalTicks = 14400
    CsgBallBalanceAnchorEndTick = 100
    # execution-side ball parameters (consumed by ball_balance_probe):
    # one solid sphere resting on the ground plane, center (0, 0.85, r),
    # directly under the figure; r = 0.35 m is the milestone ball size
    # and 30 kg keeps the figure-ball invMass split (1/30 vs 1/2 per
    # foot) from squirting the ball out at the first contact tick
    CsgBallBalanceBallRadiusM = 0.35
    CsgBallBalanceBallMassKg = 30.0
    CsgBallBalanceBallCenterX = 0.0
    CsgBallBalanceBallCenterY = 0.85

fn CsgProducerBuildBallBalanceScene(): schema.CsgWorldFacts =
    var f: schema.CsgWorldFacts
    schema.CsgWorldFactsReset(f, CsgProducerInstance)
    f.totalTicks = int64(CsgBallBalanceTotalTicks)
    # figure: the proven playground standing pose translated +0.70 z so
    # the feet (r = 0.06) rest on the apex of the 0.35 m ball: foot
    # centers at z = 2r + 0.06 = 0.76, 0.20 m apart at x = +-0.10. The
    # sphere-sphere contact gap at those offsets is |foot - ball center|
    # - rSum = 12.0 mm, so the anchored figure hangs 12 mm above the
    # apex until release and the real ball-top contact begins at tick 100
    let pelvis = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRolePelvis, 30.0, 0.0, 0.85, 1.42, 0.12)
    let chest = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleChest, 25.0, 0.0, 0.85, 1.72, 0.14)
    let head = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHead, 8.0, 0.0, 0.85, 1.99, 0.11)
    let handL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandL, 6.0, 0.18, 0.92, 1.20, 0.05)
    let handR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandR, 6.0, 0.0, 0.55, 2.14, 0.05)
    let footL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootL, 2.0, 0.10, 0.85, 0.76, 0.06)
    let footR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootR, 2.0, -0.10, 0.85, 0.76, 0.06)
    # joints: the exact playground walk-posture set, rest lengths are the
    # exact initial-pose distances
    schema.CsgFactsAddJoint(f, pelvis, chest, CsgJointRestFromPose(f, pelvis, chest))
    schema.CsgFactsAddJoint(f, chest, head, CsgJointRestFromPose(f, chest, head))
    schema.CsgFactsAddJoint(f, pelvis, handR, CsgJointRestFromPose(f, pelvis, handR))
    schema.CsgFactsAddJoint(f, pelvis, head, CsgJointRestFromPose(f, pelvis, head))
    schema.CsgFactsAddJoint(f, chest, handL, CsgJointRestFromPose(f, chest, handL))
    schema.CsgFactsAddJoint(f, chest, handR, CsgJointRestFromPose(f, chest, handR))
    schema.CsgFactsAddJoint(f, pelvis, footL, CsgJointRestFromPose(f, pelvis, footL))
    schema.CsgFactsAddJoint(f, pelvis, footR, CsgJointRestFromPose(f, pelvis, footR))
    # rope-free scene: the zeroed spec is the validated no-rope form; the
    # stage is deliberately wall-free (the ball under the feet is the
    # only support after release)
    f.rope.nodeCount = 0
    # standing stations held to tick 100, then release: anchors spawn one
    # plant length above each part (the skeleton-scene contract, dist0 =
    # plantLen, tether born satisfied). The free right hand gets no
    # station: its pose height 2.14 + 0.02 leash exceeds the validation
    # landing bound (step z <= 2.0) — documented, not worked around.
    schema.CsgFactsAddStep(f, footL, 0.10, 0.85, 0.78, int64(0), int64(CsgBallBalanceAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, footR, -0.10, 0.85, 0.78, int64(0), int64(CsgBallBalanceAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, handL, 0.18, 0.92, 1.22, int64(0), int64(CsgBallBalanceAnchorEndTick), 0.80, 0.02)
    return f

# Frozen desktop-biped scene (DESKTOPBIPED): the carrier model for the
# task-level desktop-biped balance milestone (the Isaac Sim biped
# ball-balance demo analogue, robot parameters self-chosen at public
# desktop-biped scale). Spec: total mass ~3.5 kg, standing height
# ~0.34 m (sole z=0 -> hip 0.17 -> shoulder 0.28 -> head top 0.34).
# Structure (17 point masses, frozen order):
#   0 pelvis, 1 chest, 2 head, 3 handL, 4 handR — the proven 5-role
#     torso set; arms are single lateral sway masses on chest rods.
#   5 ankleL / 6 ankleR — carry CsgRoleFootL/FootR (the balance servo's
#     foot-support points); 7 hipL / 8 hipR — CsgRoleNone.
#   9 kneeL / 10 kneeR — CsgRoleKneeL/KneeR.
#   11..16 — two 3-point foot plates (heel + medial/lateral toe,
#     ~0.09 m heel-to-toe edges), CsgRoleNone. A plate is a complete
#     graph on heel/toeIn/toeOut plus ankle-to-each-plate-point, so the
#     sole is an area, not a point.
# Masses (kg): pelvis 0.30, chest 0.90, head 0.30, hand 0.10x2,
# hip 0.40x2, knee 0.30x2, ankle 0.05x2, plate point 0.05x6 = 3.50.
# Radii follow r ~ 0.05*m^(1/3)*k with k tuned so only the plate points
# touch the ground plane (plate centers at z = r = 0.02).
# Knee: hip->knee->ankle per leg with a hip-ankle brace rod at the
# initial 17-degree bend (skeleton-scene triangulation form). Facts
# cannot express a DistMax limit (no constraint-kind column; the
# materializer emits World3dConJoint only — reported chain gap), so the
# brace is an equality rod: knee hyperextension is excluded
# structurally, knee articulation is blocked on the same facts gap.
# Rope-free, wall-free (ground plane only). Standing support: all six
# plate points station-anchored 0..690 at one plant length above their
# pose (the skeleton-scene born-satisfied tether contract), then the
# balance servo holds the free stander (empty action table = free-walk
# gate). Capture stepping is disarmed probe-side: its 0.15 m capture
# step length is tuned for the 1.4 m climb figure and is an unphysical
# lunge at 0.34 m scale.
const
    CsgDesktopBipedTotalTicks = 14400
    CsgDesktopBipedAnchorEndTick = 690

fn CsgProducerBuildDesktopBipedScene(): schema.CsgWorldFacts =
    var f: schema.CsgWorldFacts
    schema.CsgWorldFactsReset(f, CsgProducerInstance)
    f.totalTicks = int64(CsgDesktopBipedTotalTicks)
    # torso + head + single-mass arms (x lateral, +y forward, z up)
    let pelvis = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRolePelvis, 0.30, 0.0, 0.0, 0.17, 0.030)
    let chest = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleChest, 0.90, 0.0, 0.0, 0.28, 0.032)
    let head = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHead, 0.30, 0.0, 0.0, 0.315, 0.025)
    let handL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandL, 0.10, 0.115, 0.0, 0.20, 0.018)
    let handR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleHandR, 0.10, -0.115, 0.0, 0.20, 0.018)
    # legs: ankles carry the FootL/FootR roles (the balance servo's
    # foot-support points — execution locates them by role); hips ride
    # CsgRoleNone (no hip role exists; heel/toe plate roles 14..19 stay
    # reserved — facts validation bounds figure roles at AnkleR)
    let ankleL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootL, 0.05, 0.05, 0.0, 0.06, 0.016)
    let ankleR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleFootR, 0.05, -0.05, 0.0, 0.06, 0.016)
    let hipL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleNone, 0.40, 0.05, 0.0, 0.17, 0.024)
    let hipR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleNone, 0.40, -0.05, 0.0, 0.17, 0.024)
    let kneeL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleKneeL, 0.30, 0.05, 0.02, 0.105, 0.020)
    let kneeR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleKneeR, 0.30, -0.05, 0.02, 0.105, 0.020)
    # foot plates: heel + medial/lateral toe per foot, sole spheres
    # resting exactly on the ground plane (center z = radius = 0.02)
    let heelL = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleNone, 0.05, 0.05, -0.03, 0.02, 0.020)
    let toeLIn = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleNone, 0.05, 0.028, 0.055, 0.02, 0.020)
    let toeLOut = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleNone, 0.05, 0.072, 0.055, 0.02, 0.020)
    let heelR = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleNone, 0.05, -0.05, -0.03, 0.02, 0.020)
    let toeRIn = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleNone, 0.05, -0.028, 0.055, 0.02, 0.020)
    let toeROut = schema.CsgFactsAddPart(f, schema.CsgPartFigurePoint, schema.CsgRoleNone, 0.05, -0.072, 0.055, 0.02, 0.020)
    # torso: the proven walk-scene posture set (pelvis-chest, chest-head,
    # pelvis-head tie) plus the chest-hung sway arms
    schema.CsgFactsAddJoint(f, pelvis, chest, CsgJointRestFromPose(f, pelvis, chest))
    schema.CsgFactsAddJoint(f, chest, head, CsgJointRestFromPose(f, chest, head))
    schema.CsgFactsAddJoint(f, pelvis, head, CsgJointRestFromPose(f, pelvis, head))
    schema.CsgFactsAddJoint(f, chest, handL, CsgJointRestFromPose(f, chest, handL))
    schema.CsgFactsAddJoint(f, chest, handR, CsgJointRestFromPose(f, chest, handR))
    # pelvis girdle: hips on a 0.10 m spread, triangulated to the pelvis
    schema.CsgFactsAddJoint(f, pelvis, hipL, CsgJointRestFromPose(f, pelvis, hipL))
    schema.CsgFactsAddJoint(f, pelvis, hipR, CsgJointRestFromPose(f, pelvis, hipR))
    schema.CsgFactsAddJoint(f, hipL, hipR, CsgJointRestFromPose(f, hipL, hipR))
    # legs: hip->knee->ankle bones plus the hip-ankle brace rod holding
    # the initial bend (facts have no DistMax limit form — chain gap)
    schema.CsgFactsAddJoint(f, hipL, kneeL, CsgJointRestFromPose(f, hipL, kneeL))
    schema.CsgFactsAddJoint(f, kneeL, ankleL, CsgJointRestFromPose(f, kneeL, ankleL))
    schema.CsgFactsAddJoint(f, hipL, ankleL, CsgJointRestFromPose(f, hipL, ankleL))
    schema.CsgFactsAddJoint(f, hipR, kneeR, CsgJointRestFromPose(f, hipR, kneeR))
    schema.CsgFactsAddJoint(f, kneeR, ankleR, CsgJointRestFromPose(f, kneeR, ankleR))
    schema.CsgFactsAddJoint(f, hipR, ankleR, CsgJointRestFromPose(f, hipR, ankleR))
    # left foot plate: triangle on heel/toeIn/toeOut, ankle on each corner
    schema.CsgFactsAddJoint(f, heelL, toeLIn, CsgJointRestFromPose(f, heelL, toeLIn))
    schema.CsgFactsAddJoint(f, heelL, toeLOut, CsgJointRestFromPose(f, heelL, toeLOut))
    schema.CsgFactsAddJoint(f, toeLIn, toeLOut, CsgJointRestFromPose(f, toeLIn, toeLOut))
    schema.CsgFactsAddJoint(f, ankleL, heelL, CsgJointRestFromPose(f, ankleL, heelL))
    schema.CsgFactsAddJoint(f, ankleL, toeLIn, CsgJointRestFromPose(f, ankleL, toeLIn))
    schema.CsgFactsAddJoint(f, ankleL, toeLOut, CsgJointRestFromPose(f, ankleL, toeLOut))
    # right foot plate: mirrored
    schema.CsgFactsAddJoint(f, heelR, toeRIn, CsgJointRestFromPose(f, heelR, toeRIn))
    schema.CsgFactsAddJoint(f, heelR, toeROut, CsgJointRestFromPose(f, heelR, toeROut))
    schema.CsgFactsAddJoint(f, toeRIn, toeROut, CsgJointRestFromPose(f, toeRIn, toeROut))
    schema.CsgFactsAddJoint(f, ankleR, heelR, CsgJointRestFromPose(f, ankleR, heelR))
    schema.CsgFactsAddJoint(f, ankleR, toeRIn, CsgJointRestFromPose(f, ankleR, toeRIn))
    schema.CsgFactsAddJoint(f, ankleR, toeROut, CsgJointRestFromPose(f, ankleR, toeROut))
    # rope-free scene: the zeroed spec is the validated no-rope form;
    # wall-free too — the ground plane is the only support after release
    f.rope.nodeCount = 0
    # standing stations: all six plate points anchored at one plant
    # length above their pose (born-satisfied tethers, playground
    # window semantics), released at tick 690
    schema.CsgFactsAddStep(f, heelL, 0.05, -0.03, 0.04, int64(0), int64(CsgDesktopBipedAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, toeLIn, 0.028, 0.055, 0.04, int64(0), int64(CsgDesktopBipedAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, toeLOut, 0.072, 0.055, 0.04, int64(0), int64(CsgDesktopBipedAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, heelR, -0.05, -0.03, 0.04, int64(0), int64(CsgDesktopBipedAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, toeRIn, -0.028, 0.055, 0.04, int64(0), int64(CsgDesktopBipedAnchorEndTick), 0.80, 0.02)
    schema.CsgFactsAddStep(f, toeROut, -0.072, 0.055, 0.04, int64(0), int64(CsgDesktopBipedAnchorEndTick), 0.80, 0.02)
    return f
