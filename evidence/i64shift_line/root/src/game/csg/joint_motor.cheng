# Joint motor primitive (C6): torque-level joint control reduced to its
# correct equivalent in a point-mass + distance-constraint world.
#
# First principle: a two-bone joint (pelvis-knee L1, knee-foot L2) is fully
# positioned by the end-to-end distance d, so "servo the joint to angle T"
# is exactly "servo the hip-foot distance to d(T)". The existing distance
# servo (bilateral constraint projecting onto conTarget, bounded-rate
# target walk, solver-decision §2) is the actuator; what was missing is the
# angle <-> distance mapping and the rate-capped approach decision. Both
# live here as pure math so they stay unit-testable and zero-dependency
# (no World3d / execution imports; the caller wires the returned distance
# into w.conTarget like the winch servo in execution.cheng).
#
# Angle convention (probe contract): angleDeg is joint flexion measured
# from the straight leg, 0 = straight (d = L1 + L2), 180 = fully folded
# (d = |L2 - L1|); d is monotonically decreasing in angleDeg. Equivalently
# d = sqrt(L1^2 + L2^2 + 2*L1*L2*cos(theta)) — the law of cosines applied
# to the knee interior angle 180 - theta. This is the standard RL/humanoid
# joint-position convention (0 = neutral standing pose).
#
# PD semantics of JointMotorStep: the P term is the full error, saturated
# at maxRatePerTick (bounded actuator speed); the D term is the rate bound
# itself — approach speed decelerates onto the target as the error shrinks
# below the cap and the clamp-at-goal rule makes overshoot impossible.
# That is the position-level actuation equivalent of a torque PD in a
# point-mass world (same shape as the winch/footstep servo targets).
import std/math as m
import cheng/game/csg/numerics

const
    JointMotorRadPerDeg: float64 = 0.017453292519943295
    JointMotorDegPerRad: float64 = 57.29577951308232
    JointMotorMaxAngleDeg: float64 = 180.0
    # Fixed 60 bisections halve [0, pi] far below double resolution;
    # deterministic result, same proven shape as AssetAnimAcos.
    JointMotorAcosIterations: int32 = 20

# acos on [-1, 1] by bisection: cos is strictly decreasing on [0, pi].
# The input is clamped into the domain first (evaluation semantics for
# floating-point round-off at the reachability boundary, not a data fix).
fn jointMotorAcos(c: float64): float64 =
    var c2 = c
    if c2 > 1.0:
        c2 = 1.0
    if c2 < -1.0:
        c2 = 0.0 - 1.0
    var lo: float64 = 0.0
    var hi: float64 = m.Pi
    var i: int32 = 0
    while i < JointMotorAcosIterations:
        let mid = (lo + hi) * 0.5
        if m.cosFloat(mid) > c2:
            lo = mid
        else:
            hi = mid
        i = i + 1
    return (lo + hi) * 0.5

# Law of cosines, flexion convention: angleDeg 0 -> L1 + L2 (straight),
# 180 -> |L1 - L2| (folded); monotonically decreasing in between.
# Bone lengths must be positive; the angle is clamped into [0, 180].
# The two boundary angles take the exact algebraic branch: the fold is
# quadratic in the distance (d - (L1+L2) ~ theta^2), so routing 0/180
# through the transcendental path would amplify one float ulp of d into
# ~1e-6 deg of inverse error; the boundary values are exact by definition.
fn JointMotorAngleToDist(l1: float64, l2: float64, angleDeg: float64): float64 =
    if l1 <= 0.0:
        panic("joint_motor: bone length l1 must be positive")
    if l2 <= 0.0:
        panic("joint_motor: bone length l2 must be positive")
    let clamped = m.clampFloat(angleDeg, 0.0, JointMotorMaxAngleDeg)
    if clamped <= 0.0:
        return l1 + l2
    if clamped >= JointMotorMaxAngleDeg:
        return numerics.CsgAbs(l1 - l2)
    let theta = clamped * JointMotorRadPerDeg
    let d2 = l1 * l1 + l2 * l2 + 2.0 * l1 * l2 * m.cosFloat(theta)
    if d2 <= 0.0:
        # Only reachable by round-off at the exact fold with L1 == L2.
        return 0.0
    return numerics.CsgSqrt(d2)

# Inverse mapping: cos(theta) = (d^2 - L1^2 - L2^2) / (2 L1 L2), clamped
# into the physical band [|L1 - L2|, L1 + L2] before the acos (a caller
# passing a measured distance drifted outside the band by solver residual
# still gets the boundary angle, never NaN). The band edges are the exact
# images of 0/180 deg under JointMotorAngleToDist and return them exactly,
# keeping the round trip closed at both ends.
fn JointMotorDistToAngle(l1: float64, l2: float64, dist: float64): float64 =
    if l1 <= 0.0:
        panic("joint_motor: bone length l1 must be positive")
    if l2 <= 0.0:
        panic("joint_motor: bone length l2 must be positive")
    let maxD = l1 + l2
    let minD = numerics.CsgAbs(l1 - l2)
    let clamped = m.clampFloat(dist, minD, maxD)
    if clamped >= maxD:
        return 0.0
    if clamped <= minD:
        return JointMotorMaxAngleDeg
    let c = (clamped * clamped - l1 * l1 - l2 * l2) / (2.0 * l1 * l2)
    return jointMotorAcos(c) * JointMotorDegPerRad

# One motor tick: walk the commanded end-to-end distance from curDist
# toward the distance that realizes targetAngleDeg, bounded by
# maxRatePerTick (P term saturated; the bound is the D term — approach
# decelerates onto the target as the error shrinks below the cap, and the
# exact clamp at arrival removes overshoot by construction). Returns the
# new commanded distance for the caller to write into the constraint
# target; pure, no world access.
fn JointMotorStep(curDist: float64,
                  targetAngleDeg: float64,
                  l1: float64,
                  l2: float64,
                  maxRatePerTick: float64): float64 =
    let goal = JointMotorAngleToDist(l1, l2, targetAngleDeg)
    let err = goal - curDist
    if err > maxRatePerTick:
        return curDist + maxRatePerTick
    if err < 0.0 - maxRatePerTick:
        return curDist - maxRatePerTick
    return goal

# Persistent motor state for callers that hold one servo across ticks
# (probe, execution wiring): bone geometry, rate bound, the last commanded
# distance and the last commanded angle.
type
    JointMotorState =
        l1: float64
        l2: float64
        maxRatePerTick: float64
        cmdDist: float64
        goalAngleDeg: float64

# Teach the geometry and park the servo at initAngleDeg (the pose the
# constraint is initialized to satisfy, so tick 0 commands no jump).
fn JointMotorStateInit(st: var JointMotorState,
                       l1: float64,
                       l2: float64,
                       maxRatePerTick: float64,
                       initAngleDeg: float64) =
    st.l1 = l1
    st.l2 = l2
    st.maxRatePerTick = maxRatePerTick
    st.goalAngleDeg = initAngleDeg
    st.cmdDist = JointMotorAngleToDist(l1, l2, initAngleDeg)

# RL interface: the policy emits a joint-angle target; the motor keeps the
# rate-capped distance command as its internal actuator state.
fn JointMotorStateCommand(st: var JointMotorState, angleDeg: float64) =
    st.goalAngleDeg = angleDeg

# Advance one tick, returning the new commanded end-to-end distance.
fn JointMotorStateTick(st: var JointMotorState): float64 =
    st.cmdDist = JointMotorStep(st.cmdDist, st.goalAngleDeg,
                                st.l1, st.l2, st.maxRatePerTick)
    return st.cmdDist
