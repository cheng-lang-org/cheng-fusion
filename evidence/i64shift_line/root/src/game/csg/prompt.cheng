# Prompt grammar (F): deterministic natural-language goal parsing. A
# restricted ALL-CAPS verb grammar maps prompts onto verified scene
# behaviors — no LLM, no ambiguity: the same prompt always produces the
# same world. Supported verbs (case-insensitive, joined by AND/THEN):
#   WALK <N> STEPS            — wall traverse, N shuffling steps (even N)
#   STAND <N> SECONDS         — idle tail seconds (walk scenes)
#   CLIMB <N> SECONDS         — the rope climb film (N = 10 supported)
# Anything unrecognized marks the intent invalid; the caller must reject.
#
# DoD shape: tokens are (start, len) spans over the raw prompt — the
# parser never builds token strings.
const
    PromptSchema = "cheng.game.csg.prompt.v1"

type
    PromptIntent = ref object
        parseOk: bool
        walkSteps: int32
        standSeconds: int32
        climbSeconds: int32
        unsupportedAt: int32
        unsupportedLen: int32

    PromptSpans = ref object
        starts: int32[]
        lens: int32[]
        count: int32

fn PromptNewIntent(): PromptIntent =
    var p = new(PromptIntent)
    p.parseOk = true
    p.walkSteps = 0
    p.standSeconds = 0
    p.climbSeconds = 0
    p.unsupportedAt = 0
    p.unsupportedLen = 0
    return p

fn PromptCharUpper(c: int32): int32 =
    if c >= 97:
        if c <= 122:
            return c - 32
    return c

# span == want (ASCII, case-insensitive)
@borrows
fn PromptEq(text: str, start: int32, len: int32, want: str): bool =
    if len != want.len:
        return false
    var i: int32 = 0
    while i < len:
        if PromptCharUpper(int32(text[start + i])) != int32(want[i]):
            return false
        i = i + 1
    return true

@borrows
fn PromptIsConnector(text: str, start: int32, len: int32): bool =
    if PromptEq(text, start, len, "AND"):
        return true
    if PromptEq(text, start, len, "THEN"):
        return true
    return false

# digits-only span value; -1 when the span is not a plain number
@borrows
fn PromptValue(text: str, start: int32, len: int32): int32 =
    var v: int32 = 0
    var digits: int32 = 0
    var i: int32 = 0
    while i < len:
        let c: int32 = PromptCharUpper(int32(text[start + i]))
        if c >= 48:
            if c <= 57:
                v = v * 10 + (c - 48)
                digits = digits + 1
        i = i + 1
    if digits == 0:
        return -1
    if digits != len:
        return -1
    return v

# Parse a prompt into an intent. Any span that is neither a known verb
# fragment, a number, nor a connector invalidates the intent.
@borrows
fn PromptParse(text: str, intent: PromptIntent) =
    var starts: int32[]
    setLen(starts, 0)
    var lens: int32[]
    setLen(lens, 0)
    var count: int32 = 0
    var curStart: int32 = -1
    var ti: int32 = 0
    var tn: int32 = text.len
    while ti <= tn:
        var isSep: bool = ti == tn
        if !isSep:
            let c: int32 = int32(text[ti])
            if c == 32 || c == 10:
                isSep = true
        if isSep:
            if curStart >= 0:
                add(starts, curStart)
                add(lens, ti - curStart)
                count = count + 1
                curStart = -1
        else:
            if curStart < 0:
                curStart = ti
        ti = ti + 1
    var i: int32 = 0
    while i < count:
        let s: int32 = starts[i]
        let l: int32 = lens[i]
        var matched: bool = false
        if PromptEq(text, s, l, "WALK"):
            if i + 2 < count:
                let n = PromptValue(text, starts[i + 1], lens[i + 1])
                if n >= 0:
                    if PromptEq(text, starts[i + 2], lens[i + 2], "STEPS"):
                        intent.walkSteps = n
                        i = i + 3
                        matched = true
        if !matched:
            if PromptEq(text, s, l, "STAND"):
                if i + 2 < count:
                    let n = PromptValue(text, starts[i + 1], lens[i + 1])
                    if n >= 0:
                        if PromptEq(text, starts[i + 2], lens[i + 2], "SECONDS"):
                            intent.standSeconds = n
                            i = i + 3
                            matched = true
        if !matched:
            if PromptEq(text, s, l, "CLIMB"):
                if i + 2 < count:
                    let n = PromptValue(text, starts[i + 1], lens[i + 1])
                    if n >= 0:
                        if PromptEq(text, starts[i + 2], lens[i + 2], "SECONDS"):
                            intent.climbSeconds = n
                            i = i + 3
                            matched = true
        if !matched:
            if PromptIsConnector(text, s, l):
                matched = true
            else:
                if PromptValue(text, s, l) >= 0:
                    matched = true
        if !matched:
            intent.parseOk = false
            intent.unsupportedAt = s
            intent.unsupportedLen = l
        i = i + 1
