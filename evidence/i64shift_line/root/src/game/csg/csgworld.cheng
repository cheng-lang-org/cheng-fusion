# .csgworld (G2): the pure-CSG distribution format. A world is a few
# kilobytes of data — scene parameters (bodies/joints/rope/walls in
# millimetre/g fixed-point) plus the scripted action and footstep tables,
# sealed with the facts CID. The receiving end re-materializes and
# re-simulates deterministically: same file, same CID, same film — no
# pixel payload is ever shipped.
#
# Token-stream text format (whitespace separated, in order):
#   <schema> <instance> <totalTicks> <parts>
#   [p kind role massG xMm yMm zMm radiusMm] x parts
#   <joints> [j a b restMm] x joints
#   rope <nodeCount> <massG> <segMm> <radMm> <axMm> <ayMm> <azMm>
#   <walls> [w cx cy cz hx hy hz fr] x walls
#   <actions> [a kind part target start end rate min max] x actions
#   <steps> [s part x y z start end rate plant] x steps
#   cid <hex>
import cheng/game/csg/schema
import cheng/game/csg/numerics
import std/os
import std/strings as strings

const
    CsgWorldFormat = "cheng.csgworld.v1"
    CsgWorldG = 1000

fn CsgWorldPath(dir: str, name: str): str =
    return dir + "/" + name + ".csgworld"

@borrows
fn CsgWorldSave(f: schema.CsgWorldFacts, cid: str, path: str) =
    var o: str = ""
    o = o + CsgWorldFormat + "\n"
    o = o + strings.Int64ToStr(f.instanceId) + "\n"
    o = o + strings.Int64ToStr(f.totalTicks) + "\n"
    o = o + strings.IntToStr(f.partKind.len) + "\n"
    var i: int32 = 0
    while i < f.partKind.len:
        o = o + "p " + strings.IntToStr(f.partKind[i]) + " " + strings.IntToStr(f.partRole[i])
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.partMassKg[i] * float64(CsgWorldG)))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.partX[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.partY[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.partZ[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.partRadiusM[i])) + "\n"
        i = i + 1
    o = o + strings.IntToStr(f.jointA.len) + "\n"
    i = 0
    while i < f.jointA.len:
        o = o + "j " + strings.IntToStr(f.jointA[i]) + " " + strings.IntToStr(f.jointB[i])
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.jointRestM[i] * 1000.0)) + "\n"
        i = i + 1
    o = o + "rope " + strings.IntToStr(f.rope.nodeCount)
    o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.rope.nodeMassKg * float64(CsgWorldG)))
    o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.rope.segmentLenM))
    o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.rope.renderRadiusM))
    o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.rope.anchorX))
    o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.rope.anchorY))
    o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.rope.anchorZ)) + "\n"
    o = o + strings.IntToStr(f.wallCx.len) + "\n"
    i = 0
    while i < f.wallCx.len:
        o = o + "w " + strings.Int64ToStr(numerics.CsgQuantMm(f.wallCx[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.wallCy[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.wallCz[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.wallHx[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.wallHy[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.wallHz[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.wallFriction[i])) + "\n"
        i = i + 1
    o = o + strings.IntToStr(f.actionKind.len) + "\n"
    i = 0
    while i < f.actionKind.len:
        o = o + "a " + strings.IntToStr(f.actionKind[i]) + " " + strings.IntToStr(f.actionPart[i])
        o = o + " " + strings.IntToStr(f.actionTargetNode[i])
        o = o + " " + strings.Int64ToStr(f.actionStartTick[i]) + " " + strings.Int64ToStr(f.actionEndTick[i])
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.actionRateLimit[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.actionMinLen[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.actionMaxLen[i])) + "\n"
        i = i + 1
    o = o + strings.IntToStr(f.stepPart.len) + "\n"
    i = 0
    while i < f.stepPart.len:
        o = o + "s " + strings.IntToStr(f.stepPart[i])
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.stepX[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.stepY[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.stepZ[i]))
        o = o + " " + strings.Int64ToStr(f.stepStartTick[i]) + " " + strings.Int64ToStr(f.stepEndTick[i])
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.stepRate[i]))
        o = o + " " + strings.Int64ToStr(numerics.CsgQuantMm(f.stepPlantLen[i])) + "\n"
        i = i + 1
    o = o + "cid " + cid + "\n"
    var out: uint8[]
    setLen(out, o.len)
    var ci: int32 = 0
    while ci < o.len:
        out[ci] = uint8(int32(o[ci]) & 255)
        ci = ci + 1
    os.WriteFileBytes(path, out)

# ---- tokenization: (start, len) spans over the raw text (DoD, no
# token strings are ever built) ----

@borrows
fn CsgTokEq(text: str, s0: int32, l0: int32, want: str): bool =
    if l0 != want.len:
        return false
    var i: int32 = 0
    while i < l0:
        if int32(text[s0 + i]) != int32(want[i]):
            return false
        i = i + 1
    return true

@borrows
fn CsgTokI64(text: str, s0: int32, l0: int32): int64 =
    var v: int64 = 0
    var neg: bool = false
    var i: int32 = 0
    var seen: int32 = 0
    while i < l0:
        let c: int32 = int32(text[s0 + i])
        if c == 45:
            neg = true
        else:
            v = v * 10 + int64(c - 48)
        seen = seen + 1
        i = i + 1
    if seen == 0:
        return 0
    if neg:
        v = 0 - v
    return v

# Load a .csgworld file into facts. Returns the embedded CID (empty on
# failure); the caller verifies schema.CsgWorldFactsCid(out) == cid.
@borrows
fn CsgWorldLoad(path: str, out: var schema.CsgWorldFacts): str =
    let text: str = os.ReadFile(path)
    var starts: int32[]
    setLen(starts, 0)
    var lens: int32[]
    setLen(lens, 0)
    var count: int32 = 0
    var curStart: int32 = -1
    var si: int32 = 0
    var sn: int32 = text.len
    while si <= sn:
        var isSep: bool = si == sn
        if !isSep:
            let c: int32 = int32(text[si])
            if c == 32 || c == 10:
                isSep = true
        if isSep:
            if curStart >= 0:
                add(starts, curStart)
                add(lens, si - curStart)
                count = count + 1
                curStart = -1
        else:
            if curStart < 0:
                curStart = si
        si = si + 1
    let tokCount: int32 = count
    if tokCount < 6:
        return ""
    if !CsgTokEq(text, starts[0], lens[0], CsgWorldFormat):
        echo("DBG fail fmt")
        return ""
    var t: int32 = 1
    let instanceId: int64 = CsgTokI64(text, starts[t], lens[t])
    t = t + 1
    let totalTicks: int64 = CsgTokI64(text, starts[t], lens[t])
    t = t + 1
    schema.CsgWorldFactsReset(out, instanceId)
    out.totalTicks = totalTicks
    let partCount: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
    t = t + 1
    var i: int32 = 0
    while i < partCount:
        # skip the "p" tag token before the seven values
        t = t + 1
        let pk: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let pr: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let pmG: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let pxM: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let pyM: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let pzM: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let prM: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let _idx = schema.CsgFactsAddPart(out, pk, pr, float64(pmG) / 1000000.0, float64(pxM) / 1000.0, float64(pyM) / 1000.0, float64(pzM) / 1000.0, float64(prM) / 1000.0)
        i = i + 1
    let jointCount: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
    t = t + 1
    i = 0
    while i < jointCount:
        let _jt: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let ja: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let jb: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let jr: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        schema.CsgFactsAddJoint(out, ja, jb, float64(jr) / 1000000.0)
        i = i + 1
    let ropeTagOk: bool = CsgTokEq(text, starts[t], lens[t], "rope")
    if !ropeTagOk:
        return ""
    t = t + 1
    out.rope.nodeCount = int32(CsgTokI64(text, starts[t], lens[t]))
    t = t + 1
    out.rope.nodeMassKg = float64(CsgTokI64(text, starts[t], lens[t])) / 1000000.0
    t = t + 1
    out.rope.segmentLenM = float64(CsgTokI64(text, starts[t], lens[t])) / 1000.0
    t = t + 1
    out.rope.renderRadiusM = float64(CsgTokI64(text, starts[t], lens[t])) / 1000.0
    t = t + 1
    out.rope.anchorX = float64(CsgTokI64(text, starts[t], lens[t])) / 1000.0
    t = t + 1
    out.rope.anchorY = float64(CsgTokI64(text, starts[t], lens[t])) / 1000.0
    t = t + 1
    out.rope.anchorZ = float64(CsgTokI64(text, starts[t], lens[t])) / 1000.0
    t = t + 1
    let wallCount: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
    t = t + 1
    i = 0
    while i < wallCount:
        let _wt: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let cx: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let cy: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let cz: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let hx: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let hy: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let hz: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let fr: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        schema.CsgFactsAddWall(out, float64(cx) / 1000.0, float64(cy) / 1000.0, float64(cz) / 1000.0, float64(hx) / 1000.0, float64(hy) / 1000.0, float64(hz) / 1000.0, float64(fr) / 1000.0)
        i = i + 1
    let actCount: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
    t = t + 1
    i = 0
    while i < actCount:
        let _at: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let ak: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let ap: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let an: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let as0: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let ae: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let ar: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let amin: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let amax: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        schema.CsgFactsAddAction(out, ak, ap, an, as0, ae, float64(ar) / 1000.0, float64(amin) / 1000.0, float64(amax) / 1000.0)
        i = i + 1
    let stepCount: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
    t = t + 1
    i = 0
    while i < stepCount:
        let _st: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let sp: int32 = int32(CsgTokI64(text, starts[t], lens[t]))
        t = t + 1
        let sx: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let sy: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let sz: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let ss: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let se: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let sr: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        let spl: int64 = CsgTokI64(text, starts[t], lens[t])
        t = t + 1
        schema.CsgFactsAddStep(out, sp, float64(sx) / 1000.0, float64(sy) / 1000.0, float64(sz) / 1000.0, ss, se, float64(sr) / 1000.0, float64(spl) / 1000.0)
        i = i + 1
    let cidTagOk: bool = CsgTokEq(text, starts[t], lens[t], "cid")
    if !cidTagOk:
        echo("DBG fail cid at t=" + strings.IntToStr(t))
        return ""
    t = t + 1
    if t >= tokCount:
        echo("DBG fail tok end")
        return ""
    return strings.CloneStrRange(text, starts[t], lens[t])
