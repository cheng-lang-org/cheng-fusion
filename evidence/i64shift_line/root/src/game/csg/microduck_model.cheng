                                0.0000172925, 0.00000312694, 0.0000163707,
                                0.0 - 0.014501100, 0.026000000, 0.137922241)
    add(mdl.links, lnk)
    var lhp = MicroduckMakeLink("headPitchCarrier", 0.00572, 0.006, 0.008,
                                MicroduckAxisVertical,
                                0.0 - 0.000001115, 0.026000007, 0.199586388,
                                0.00000109186, 0.000000966855, 0.000000512111,
                                0.0 - 0.014501131, 0.026000000, 0.187922272)
    add(mdl.links, lhp)
    var lhy = MicroduckMakeLink("headYawCarrier", 0.02492, 0.008, 0.010,
