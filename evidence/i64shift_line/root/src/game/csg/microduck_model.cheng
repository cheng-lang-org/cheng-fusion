                                0.00000373979, 0.00000314478, 0.00000407916,
                                0.0 - 0.000001110, 0.026000000, 0.206615392)
    add(mdl.links, lhy)
    var lhd = MicroduckMakeLink("head", 0.172649, 0.016, 0.0145,
                                MicroduckAxisVertical,
