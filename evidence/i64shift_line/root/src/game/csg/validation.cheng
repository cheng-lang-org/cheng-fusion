# CSG world facts validation (B1): precise, reason-coded rejection of
# illegal facts. Every status code names the exact violated contract; no
# heuristic repairs, no silent coercion. A rejected fact set must never be
# materialized.
import cheng/game/csg/schema
import cheng/game/rope3d
import std/math as m

const
    CsgValidationSchema = "cheng.game.csg.validation.v1"
    CsgValidOk = 1
    CsgValidUnknownPartKind = 2
    CsgValidBadMass = 3
    CsgValidBadRadius = 4
    CsgValidBadPosition = 5
    CsgValidDuplicateRole = 6
    CsgValidMissingRole = 7
    CsgValidBadJointRef = 8
    CsgValidBadJointLen = 9
    CsgValidBadRopeSpec = 10
    CsgValidBadWall = 11
    CsgValidUnknownActionKind = 12
    CsgValidBadActionPart = 13
    CsgValidBadActionTarget = 14
    CsgValidBadActionWindow = 15
    CsgValidOverlappingGrasp = 16
    CsgValidBadFriction = 17
    CsgValidFigureMassMismatch = 18
    CsgValidBadStepPart = 19
    CsgValidBadStepWindow = 20
    CsgValidBadStepRate = 21
    CsgValidBadStepLanding = 22
    CsgValidOverlappingStep = 23

type
    CsgValidationResult =
        statusCode: int32
        detailIndex: int32

fn CsgValidationOk(): CsgValidationResult =
    var r: CsgValidationResult
    r.statusCode = CsgValidOk
    r.detailIndex = -1
    return r

fn CsgValidationFail(code: int32, detail: int32): CsgValidationResult =
    var r: CsgValidationResult
    r.statusCode = code
    r.detailIndex = detail
    return r

@borrows
fn CsgValidateFacts(f: schema.CsgWorldFacts): CsgValidationResult =
    var pelvisSeen: int32 = 0
    var chestSeen: int32 = 0
    var headSeen: int32 = 0
    var handLSeen: int32 = 0
    var handRSeen: int32 = 0
    var footLSeen: int32 = 0
    var footRSeen: int32 = 0
    var figureMass: float64 = 0.0
    var i: int32 = 0
    while i < f.partKind.len:
        if f.partKind[i] != schema.CsgPartFigurePoint:
            return CsgValidationFail(CsgValidUnknownPartKind, i)
        let role = f.partRole[i]
        if role < 0 || role > schema.CsgRoleAnkleR:
            return CsgValidationFail(CsgValidUnknownPartKind, i)
        if f.partMassKg[i] <= 0.0:
            return CsgValidationFail(CsgValidBadMass, i)
        if f.partRadiusM[i] <= 0.0 || f.partRadiusM[i] > 1.0:
            return CsgValidationFail(CsgValidBadRadius, i)
        if m.absFloat(f.partX[i]) > 1000.0 || m.absFloat(f.partY[i]) > 1000.0 || m.absFloat(f.partZ[i]) > 1000.0:
            return CsgValidationFail(CsgValidBadPosition, i)
        if role == schema.CsgRolePelvis:
            pelvisSeen = pelvisSeen + 1
        if role == schema.CsgRoleChest:
            chestSeen = chestSeen + 1
        if role == schema.CsgRoleHead:
            headSeen = headSeen + 1
        if role == schema.CsgRoleHandL:
            handLSeen = handLSeen + 1
        if role == schema.CsgRoleHandR:
            handRSeen = handRSeen + 1
        if role == schema.CsgRoleFootL:
            footLSeen = footLSeen + 1
        if role == schema.CsgRoleFootR:
            footRSeen = footRSeen + 1
        if role != schema.CsgRoleNone:
            figureMass = figureMass + f.partMassKg[i]
        i = i + 1
    if pelvisSeen != 1 || chestSeen != 1 || headSeen != 1 || handLSeen != 1 || handRSeen != 1 || footLSeen != 1 || footRSeen != 1:
        return CsgValidationFail(CsgValidMissingRole, 0)
    # duplicated roles already covered: any count != 1 fails above per-role
    # sum check; duplicate detection via counts is exact for single figures.
    if figureMass < 1.0 || figureMass > 500.0:
        return CsgValidationFail(CsgValidFigureMassMismatch, 0)
    i = 0
    while i < f.jointA.len:
        let a = f.jointA[i]
        let b = f.jointB[i]
        if a < 0 || a >= f.partKind.len || b < 0 || b >= f.partKind.len || a == b:
            return CsgValidationFail(CsgValidBadJointRef, i)
        if f.jointRestM[i] <= 0.0 || f.jointRestM[i] > 5.0:
            return CsgValidationFail(CsgValidBadJointLen, i)
        i = i + 1
    if !rope3d.Rope3dSpecValid(f.rope):
        return CsgValidationFail(CsgValidBadRopeSpec, 0)
    i = 0
    while i < f.wallCx.len:
        if f.wallHx[i] <= 0.0 || f.wallHy[i] <= 0.0 || f.wallHz[i] <= 0.0:
            return CsgValidationFail(CsgValidBadWall, i)
        if f.wallFriction[i] < 0.0 || f.wallFriction[i] > 2.0:
            return CsgValidationFail(CsgValidBadFriction, i)
        i = i + 1
    # per-part grasp windows must not overlap: a hand holds one hold at a time
    var a: int32 = 0
    while a < f.actionKind.len:
        let kind = f.actionKind[a]
        if kind != schema.CsgActionGrasp && kind != schema.CsgActionRelease && kind != schema.CsgActionArmPull && kind != schema.CsgActionLegPush && kind != schema.CsgActionReach:
            return CsgValidationFail(CsgValidUnknownActionKind, a)
        let part = f.actionPart[a]
        if part < 0 || part >= f.partKind.len:
            return CsgValidationFail(CsgValidBadActionPart, a)
        if f.actionStartTick[a] < int64(0) || f.actionStartTick[a] > f.actionEndTick[a] || f.actionEndTick[a] > f.totalTicks:
            return CsgValidationFail(CsgValidBadActionWindow, a)
        if kind == schema.CsgActionGrasp || kind == schema.CsgActionReach:
            if f.actionTargetNode[a] < 0 || f.actionTargetNode[a] >= f.rope.nodeCount:
                return CsgValidationFail(CsgValidBadActionTarget, a)
            var b: int32 = 0
            while b < f.actionKind.len:
                if b != a && f.actionKind[b] == schema.CsgActionGrasp && f.actionPart[b] == part:
                    if f.actionStartTick[b] < f.actionEndTick[a] && f.actionStartTick[a] < f.actionEndTick[b]:
                        return CsgValidationFail(CsgValidOverlappingGrasp, a)
                b = b + 1
        a = a + 1
    # footsteps: part refs, windows inside the film, bounded servo rate,
    # ground-level landing points, and one active step per foot
    var s: int32 = 0
    while s < f.stepPart.len:
        if f.stepPart[s] < 0 || f.stepPart[s] >= f.partKind.len:
            return CsgValidationFail(CsgValidBadStepPart, s)
        if f.stepStartTick[s] < int64(0) || f.stepStartTick[s] >= f.stepEndTick[s] || f.stepEndTick[s] > f.totalTicks:
            return CsgValidationFail(CsgValidBadStepWindow, s)
        if f.stepRate[s] <= 0.0 || f.stepRate[s] > 2.0:
            return CsgValidationFail(CsgValidBadStepRate, s)
        if f.stepPlantLen[s] < 0.0 || f.stepPlantLen[s] > 0.5:
            return CsgValidationFail(CsgValidBadStepRate, s)
        # landing points live on the ground (feet) or on wall faces (hands)
        if f.stepZ[s] < 0.0 || f.stepZ[s] > 2.0:
            return CsgValidationFail(CsgValidBadStepLanding, s)
        var b: int32 = 0
        while b < f.stepPart.len:
            if b != s && f.stepPart[b] == f.stepPart[s]:
                if f.stepStartTick[b] < f.stepEndTick[s] && f.stepStartTick[s] < f.stepEndTick[b]:
                    return CsgValidationFail(CsgValidOverlappingStep, s)
            b = b + 1
        s = s + 1
    return CsgValidationOk()
