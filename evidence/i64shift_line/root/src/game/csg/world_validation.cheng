# 世界 CSG validation (B1): 事实行集校验。
#
# 合同: 未知 kind / 坏引用 / 非单调时间线 / 重复帧拒绝; entity 行的
# source_cid 与 observation_cid 必须存在且帧行全部引用同一 entity。
import std/strings
import cheng/game/assets/reconstruction/observation
import cheng/game/csg/world_schema
import cheng/game/csg/world_producer

type
    WorldValidationReport =
        ok: bool
        entityLines: int32
        frameLines: int32
        firstError: str

# 校验事实行集: 第一行必须是 entity 行, 其后全为同 entity 的 frame 行,
# tick 严格递增, ms = tick*1000/timescale 一致性由调用侧观测提供核对。
@borrows
fn WorldValidateFactSet(f: world_producer.WorldFactSet, o: observation.AssetVideoObservation): WorldValidationReport =
    var r: WorldValidationReport
    r.firstError = ""
    if f.facts.len != o.sampleCount + 1:
        r.firstError = Fmt"fact count {f.facts.len} != samples+1 {o.sampleCount + 1}"
        return r
    # entity 行比对 (来源链闭合)
    let wantEntity = world_schema.WorldEntityFactLine(f.entityId, o.sourceCid,
        strings.Sha256(observation.AssetVideoObservationPreimage(o)))
    if f.facts[0] != wantEntity:
        r.firstError = "entity line mismatch"
        return r
    r.entityLines = 1
    # 帧行逐一比对: 从观测真值重生成期望行
    var i: int32
    while i < o.sampleCount:
        let want = world_schema.WorldFrameFactLine(f.entityId, i, o.frameTicks[i],
            o.frameTicks[i] * int64(1000) / int64(o.timescale))
        if f.facts[i + 1] != want:
            r.firstError = Fmt"frame line mismatch at {i}"
            return r
        r.frameLines = r.frameLines + 1
        i = i + 1
    # tick 单调性 (真值本身亦受检)
    var fi: int32 = 1
    while fi < o.sampleCount:
        if o.frameTicks[fi] <= o.frameTicks[fi - 1]:
            r.firstError = Fmt"non-monotonic frame tick at {fi}"
            return r
        fi = fi + 1
    r.ok = true
    return r
