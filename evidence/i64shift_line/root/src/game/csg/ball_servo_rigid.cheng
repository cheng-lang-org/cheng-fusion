# Ball-frame balance servo for the rigid-link machine duck: the rigid
# adaptation of the N1 particle ball-top servo (execution.cheng ball
# mode, the 14300-tick particle stand). The machine duck assembly does
# not run through execution (microduck_assembly_probe builds it
# directly on world3d + physics3d), so this library takes the live
# World3d itself: the corrections are velocity kicks written straight
# into the torso capsule's bodyVx/Vy/Vz and bodyAngVx/Vy/Vz immediately
# before the physics step (the N1 timing), and the XPBD constraint
# chain carries them into the legs.
#
# Linear channel (N1 identical): the torso com target is its frozen
# horizontal offset from the ball center (ball frame: the ball moves,
# the rider follows) plus the frozen ball-relative height; the damper
# references the ball center velocity. Dissipation contract: in the
# pair's common drift mode (ball + duck translating together in the
# frozen arrangement) the spring error is zero and v_rel is zero, so
# the channel does no work on the common mode — the structural fix
# that made the particle stand hold (the v1 world-frame servo pumped
# the pair to a 275.9 m roll).
#
# Angular channel (rigid new dimension): the torso's world up
# direction u = R e_z (third rotation column, the physics3d capsule
# axis convention) is driven upright. The quaternion error taking u to
# the vertical has rotation axis a = normalize(u x e_z) and half angle
# theta/2, and its vector part is exactly
#   a * sin(theta/2) = (u x e_z) / sqrt(2*(1 + u.z))
# (finite for every pose the arming basin allows, u.z > -1), which
# integrates as a world-frame angular velocity straight toward
# vertical under the dq(q(omega)) q pose update. Spring =
# k_ang * (a*sin(theta/2)), damper = -c_ang * (omega_torso -
# omega_ball): in the pair's common rotation mode both damper sides
# cancel, and a common yaw about the vertical leaves the error vector
# at zero (it has no z component), so the channel acts only on the
# relative tilt/wobble modes and is dissipative there. Yaw about the
# vertical is deliberately left free.
#
# Safety structure (N1 shapes): armed latch — any upright, height-band
# or range violation latches the servo off for the rest of the episode
# (kicks from a toppled/tangled/airborne state are unphysical
# actuation that pumps the pair without bound); soft-start ramp on the
# spring terms only (the release-drop transient is absorbed by the
# always full-strength dampers); per-term magnitude caps on every
# spring and damper (contact-path safety, not dynamics: uncapped a
# single tick can request tens of m/s or rad/s and the resulting
# contact impulses measurably pump the pair instead of bleeding it).
#
# Lean-trim channel (rigid adaptation of the N1 execution.cheng
# CsgBalanceBallTrimRate integrator, per-state opt-in via
# BallServoRigidSetTrim, 0.0 = off): a slow leak-free integrator walks
# the torso horizontal target toward the measured duck CoM (per tick
# trim -= trimRate * comErr, comErr = mass-weighted duck CoM minus ball
# center, clamped to +-BallServoRigidTrimRangeM) so the frozen
# release-pose offset converges to the loaded balance point. Sign
# derivation (N1 semantics): comErr < 0 along an axis (CoM lagging the
# ball) integrates trim toward +|comErr|, which pulls the duck toward
# the ball center while the foot-friction reaction drags the ball back
# — both shrink comErr, a negative loop; at comErr = 0 the integrator
# stops and the spring error can settle at zero. The arming basin stays
# frozen at the release pose (the trim may not widen it).
# Measured on this plant (microduck_ball_probe caseC, 14300 ticks):
# the integrator does what it is designed to do — the comErr DC
# collapses to sub-millimeter — but this rigid pair carries no standing
# lean to remove: comErr is a zero-mean +-30-65 mm shuttle at a
# ~200-tick period, and full-horizon drift is NOT reduced against the
# trim-off control (2216 mm vs 985 mm; a 4x slower rate is worse still,
# 5313 mm). The residual drift is the shuttle mode itself, which a DC
# integrator cannot cancel; parking the pair needs a common-mode sink
# (the N1 rolling-resistance analog), a separate mechanism. Kept as the
# verified N1 mechanism, opt-in, default off.
import cheng/game/world3d
import cheng/game/csg/numerics
import std/math as m

const
    # arming basin, N1 CsgBalanceBallZBandM / CsgBalanceBallServoRangeM
    BallServoRigidZBandM: float64 = 0.25
    BallServoRigidRangeM: float64 = 0.60
    # error normalization guard: sqrt(2*(1+u.z)) only reaches zero at
    # the fully inverted pose the arming latch never lets through
    BallServoRigidErrEps: float64 = 0.000001
    # conservative default tune. Linear side = the N1 defaults verbatim
    # (gain 0.5, damp 0.25, torso cap 0.25 m/s, damp cap 0.30 m/s).
    # Angular side is sized against the measured rigid topple: the whole
    # duck (1.44 kg, com ~0.55 m over the contact) topples with torque
    # ~7.8*theta Nm, while a torso kick of dw rad/s per tick is ~0.2*dw
    # Nm through the 8.4e-4 kg m^2 torso inertia — so the spring needs
    # k_ang*It*240*sin(theta/2) >= 7.8*theta, i.e. k_ang ~ 128 to hold
    # the tilt against gravity at every catchable angle, with the 4
    # rad/s per-term caps (= 0.8 Nm) bounding the authority just under
    # the 1.5 Nm hinge servo ratings. The damper is a DIRECT per-tick
    # velocity multiplier (1 - c_ang), so c_ang must stay under 2 for
    # discrete stability; 1.5 gives near-deadbeat relative wobble decay.
    # The ramp is short (24 ticks = 0.1 s): the frozen-offset spring has
    # zero error at the release pose, so there is no slam to soften, and
    # the measured topple outruns any longer ramp.
    BallServoRigidDefaultK: float64 = 0.5
    BallServoRigidDefaultC: float64 = 0.25
    BallServoRigidDefaultLinCapMps: float64 = 0.25
    BallServoRigidDefaultLinDampCapMps: float64 = 0.3
    BallServoRigidDefaultKAng: float64 = 128.0
    BallServoRigidDefaultCAng: float64 = 1.5
    BallServoRigidDefaultAngCapRadS: float64 = 4.0
    BallServoRigidDefaultAngDampCapRadS: float64 = 4.0
    BallServoRigidDefaultRampTicks: float64 = 24.0
    # lean-trim integrator (N1 CsgBalanceBallTrimRate values verbatim):
    # 1/1200 per tick (~5 s integration period, slow enough to average
    # over the articulation swing without rectifying it into drift),
    # clamp +-0.12 m
    BallServoRigidTrimRate: float64 = 0.0008333333333333334
    BallServoRigidTrimRangeM: float64 = 0.12
    # anchor bias authority: the stance tolerates only a few cm of
    # sustained lean before the legs fold (measured: 7-12 cm biases
    # squatted torsoZ 342 -> 230 mm over 3600 ticks), so the anchor
    # clamps well under the trim range
    BallServoRigidAnchorRangeM: float64 = 0.04

type
    BallServoRigidState =
        ballSlot: int32
        torsoSlot: int32
        headSlot: int32
        # armed latch: 1 while the servo actuates, latched to 0 forever
        # on the first basin violation
        armed: int32
        # soft-start tick counter (armed ticks since init)
        tickCount: int32
        rampTicks: float64
        # frozen ball-frame ride offsets: torso com relative to the ball
        # center at init (horizontal follow target, ball-relative height)
        offX: float64
        offY: float64
        offZ: float64
        # gains and per-term caps (caller tune, frozen at init)
        k: float64
        c: float64
        linCapMps: float64
        linDampCapMps: float64
        kAng: float64
        cAng: float64
        angCapRadS: float64
        angDampCapRadS: float64
        # lean-trim integrator (per-state opt-in, BallServoRigidSetTrim):
        # trimRate 0.0 = off (the Init default — states that never call
        # the setter behave exactly like the plain servo, accumulated
        # trim held when off); trimX/trimY ride on the torso horizontal
        # spring target; [trimComLo, trimComHi] is the inclusive slot
        # range of the mass-weighted duck CoM
        trimRate: float64
        trimX: float64
        trimY: float64
        trimComLo: int32
        trimComHi: int32
        # lever 2 (N7): contact-gated silence window, per-state opt-in via
        # BallServoRigidSetContactSilence (contactGateOn 0 = off, the Init
        # default): while on and before the first foot-ball contact
        # (foot-center distance under contactDistM) the tick writes no
        # velocity at all — the release-drop segment must not seed tilt
        # through the always-full-strength dampers — and at the contact
        # latch the soft-start ramp restarts from zero. contactTick counts
        # the silent ticks (diagnostic: contactSeen 0 at episode end means
        # the episode stayed fully silent).
        contactGateOn: int32
        contactSeen: int32
        contactTick: int32
        contactDistM: float64
        footLSlot: int32
        footRSlot: int32
        # pair station-keeping anchor (per-state opt-in via
        # BallServoRigidSetAnchor, anchorOn 0 = off, the Init default):
        # a lean bias that steers the duck+ball PAIR back to the anchor
        # point through rolling-consistent weight shift. Empirical reach
        # law (capture-step probes): reach AWAY from home pumps the ball
        # toward home, reach ALONG the roll direction brakes it — so the
        # bias is +kp on the ball's displacement from the anchor and
        # -kd on the ball's center velocity, clamped to the trim range.
        # Without it the balance loop free-drifts: nothing anchors the
        # pair to the world and the servo's momentum pumping accelerates
        # it (measured: v 0.025 -> 1.65 m/s over 3600 ticks, ~0.16 m/s^2).
        anchorOn: int32
        anchorX: float64
        anchorY: float64
        anchorKp: float64
        anchorKd: float64

# Freeze the ball-frame ride offsets from the current release pose,
# store the tune and latch the servo armed. Call once after the duck
# assembly and ball spawn, before the first physics step.
@borrows
fn BallServoRigidStateInit(st: var BallServoRigidState,
                           w: world3d.World3d,
                           ballSlot: int32,
                           torsoSlot: int32,
                           headSlot: int32,
                           k: float64,
                           c: float64,
                           linCapMps: float64,
                           linDampCapMps: float64,
                           kAng: float64,
                           cAng: float64,
                           angCapRadS: float64,
                           angDampCapRadS: float64,
                           rampTicks: float64) =
    if ballSlot < 0 || ballSlot >= w.bodyKind.len:
        panic("ball servo rigid: ball slot out of range")
    if w.bodyKind[ballSlot] != world3d.World3dBodyBallRigid:
        panic("ball servo rigid: ball slot is not a ball rigid body")
    if torsoSlot < 0 || torsoSlot >= w.bodyKind.len:
        panic("ball servo rigid: torso slot out of range")
    if w.bodyKind[torsoSlot] != world3d.World3dBodyCapsuleRigid:
        panic("ball servo rigid: torso slot is not a capsule rigid")
    if headSlot < 0 || headSlot >= w.bodyKind.len:
        panic("ball servo rigid: head slot out of range")
    if w.bodyPz[torsoSlot] <= w.bodyPz[ballSlot]:
        panic("ball servo rigid: torso not above the ball at init")
    if k < 0.0 || c < 0.0 || kAng < 0.0 || cAng < 0.0:
        panic("ball servo rigid: negative gain")
    if linCapMps <= 0.0 || linDampCapMps <= 0.0 || angCapRadS <= 0.0 || angDampCapRadS <= 0.0:
        panic("ball servo rigid: non-positive cap")
    if rampTicks < 1.0:
        panic("ball servo rigid: ramp ticks under 1")
    st.ballSlot = ballSlot
    st.torsoSlot = torsoSlot
    st.headSlot = headSlot
    st.offX = w.bodyPx[torsoSlot] - w.bodyPx[ballSlot]
    st.offY = w.bodyPy[torsoSlot] - w.bodyPy[ballSlot]
    st.offZ = w.bodyPz[torsoSlot] - w.bodyPz[ballSlot]
    st.k = k
    st.c = c
    st.linCapMps = linCapMps
    st.linDampCapMps = linDampCapMps
    st.kAng = kAng
    st.cAng = cAng
    st.angCapRadS = angCapRadS
    st.angDampCapRadS = angDampCapRadS
    st.rampTicks = rampTicks
    st.armed = 1
    st.tickCount = 0
    st.trimRate = 0.0
    st.trimX = 0.0
    st.trimY = 0.0
    st.trimComLo = 0
    st.trimComHi = 0
    st.contactGateOn = 0
    st.contactSeen = 0
    st.contactTick = 0
    st.contactDistM = 0.0
    st.footLSlot = 0
    st.footRSlot = 0
    st.anchorOn = 0
    st.anchorX = 0.0
    st.anchorY = 0.0
    st.anchorKp = 0.0
    st.anchorKd = 0.0

# Pair station-keeping per-state opt-in: freeze the anchor at the ball's
# CURRENT position and arm the lean bias (kp 1/m on the displacement,
# kd s on the ball center velocity, see the state comment). Call after
# BallServoRigidStateInit, before the first tick.
@borrows
fn BallServoRigidSetAnchor(st: var BallServoRigidState,
                           w: world3d.World3d,
                           kp: float64,
                           kd: float64) =
    st.anchorOn = 1
    st.anchorX = w.bodyPx[st.ballSlot]
    st.anchorY = w.bodyPy[st.ballSlot]
    st.anchorKp = kp
    st.anchorKd = kd

# Lean-trim per-state opt-in (the N1 CsgBalanceSetBallTrim shape):
# trimRate is the per-tick integration rate (BallServoRigidTrimRate =
# 1/1200, the N1 value; 0.0 disables — the Init default); [comLo,
# comHi] is the inclusive slot range of the mass-weighted duck CoM,
# i.e. every duck-owned dynamic body (link capsules plus the servo
# pin/ref point bodies riding them) — the free-assembly CoM whose
# zero-force equilibrium is parked over the ball center. Call after
# BallServoRigidStateInit, before the first tick.
fn BallServoRigidSetTrim(st: var BallServoRigidState,
                          trimRate: float64,
                          comLo: int32,
                          comHi: int32) =
    if trimRate < 0.0:
        panic("ball servo rigid: trim rate must be non-negative")
    if comLo < 0 || comHi < comLo:
        panic("ball servo rigid: trim com slot range invalid")
    st.trimRate = trimRate
    st.trimComLo = comLo
    st.trimComHi = comHi

# Lever 2 (N7) per-state opt-in: contact-gated silence window. While on,
# BallServoRigidTick writes no velocity at all until the first tick where
# either foot capsule center comes within contactDistM of the ball
# center: the release-drop segment — during which the always-full-strength
# dampers write the measured 4-degree forward-lean seed (N7 evidence 2) —
# stays servo-silent, and at the contact latch the soft-start ramp
# restarts from zero so contact meets a fresh ramp. contactDistM is
# center-to-center: size it as ballRadius + footRadius + a few mm of
# slack (the probe passes BallRadiusM + the model foot radius + slack).
# The basin checks keep running during the silence (the armed latch
# stays truthful); the lean-trim integrator is silent with the channel.
# Call after BallServoRigidStateInit, before the first tick.
@borrows
fn BallServoRigidSetContactSilence(st: var BallServoRigidState,
                                    w: world3d.World3d,
                                    footLSlot: int32,
                                    footRSlot: int32,
                                    contactDistM: float64) =
    if footLSlot < 0 || footLSlot >= w.bodyKind.len:
        panic("ball servo rigid: foot L slot out of range")
    if w.bodyKind[footLSlot] != world3d.World3dBodyCapsuleRigid:
        panic("ball servo rigid: foot L slot is not a capsule rigid")
    if footRSlot < 0 || footRSlot >= w.bodyKind.len:
        panic("ball servo rigid: foot R slot out of range")
    if w.bodyKind[footRSlot] != world3d.World3dBodyCapsuleRigid:
        panic("ball servo rigid: foot R slot is not a capsule rigid")
    if contactDistM <= 0.0:
        panic("ball servo rigid: non-positive contact distance")
    st.contactGateOn = 1
    st.contactSeen = 0
    st.contactTick = 0
    st.contactDistM = contactDistM
    st.footLSlot = footLSlot
    st.footRSlot = footRSlot

# One servo tick: arming checks, then the linear and angular velocity
# corrections on the torso capsule. Call immediately before
# physics3d.Physics3dStep (the N1 correction timing). Scalar math only.
fn BallServoRigidTick(st: var BallServoRigidState, w: var world3d.World3d) =
    if st.armed == 0:
        return
    # upright latch: head com above torso com
    if w.bodyPz[st.headSlot] < w.bodyPz[st.torsoSlot]:
        st.armed = 0
        return
    # height band around the frozen ride height (ball-relative)
    let dz = (w.bodyPz[st.torsoSlot] - w.bodyPz[st.ballSlot]) - st.offZ
    if dz > BallServoRigidZBandM:
        st.armed = 0
        return
    if dz < 0.0 - BallServoRigidZBandM:
        st.armed = 0
        return
    # horizontal range around the frozen follow point
    let ex = w.bodyPx[st.torsoSlot] - (w.bodyPx[st.ballSlot] + st.offX)
    let ey = w.bodyPy[st.torsoSlot] - (w.bodyPy[st.ballSlot] + st.offY)
    if ex * ex + ey * ey > BallServoRigidRangeM * BallServoRigidRangeM:
        st.armed = 0
        return
    # lever 2: contact-gated silence — no velocity writes at all (springs
    # OR dampers) before the first foot-ball contact; at the latch the
    # soft-start ramp restarts from zero (the latch tick runs at ramp 0)
    if st.contactGateOn == 1:
        if st.contactSeen == 0:
            let gdxL = w.bodyPx[st.footLSlot] - w.bodyPx[st.ballSlot]
            let gdyL = w.bodyPy[st.footLSlot] - w.bodyPy[st.ballSlot]
            let gdzL = w.bodyPz[st.footLSlot] - w.bodyPz[st.ballSlot]
            let gdxR = w.bodyPx[st.footRSlot] - w.bodyPx[st.ballSlot]
            let gdyR = w.bodyPy[st.footRSlot] - w.bodyPy[st.ballSlot]
            let gdzR = w.bodyPz[st.footRSlot] - w.bodyPz[st.ballSlot]
            let d2L = gdxL * gdxL + gdyL * gdyL + gdzL * gdzL
            let d2R = gdxR * gdxR + gdyR * gdyR + gdzR * gdzR
            let th2 = st.contactDistM * st.contactDistM
            if d2L < th2 || d2R < th2:
                st.contactSeen = 1
                st.tickCount = 0
            else:
                st.contactTick = st.contactTick + 1
                return
    # soft-start ramp on the spring terms only; the dampers are always
    # full strength so the release-drop transient meets pure dissipation
    var ramp: float64 = 1.0
    if float64(st.tickCount) < st.rampTicks:
        ramp = float64(st.tickCount) / st.rampTicks
    st.tickCount = st.tickCount + 1
    # --- lean trim (per-state opt-in): slow leak-free integrator
    # walking the torso horizontal target toward the measured loaded
    # balance point; sign and rate rationale live at
    # BallServoRigidTrimRate. Disabled (accumulated trim held) at
    # trimRate 0.0, the default.
    if st.trimRate > 0.0:
        if st.trimComLo < 0 || st.trimComHi >= w.bodyKind.len:
            panic("ball servo rigid: trim com slot range out of range")
        var mSum: float64 = 0.0
        var comX: float64 = 0.0
        var comY: float64 = 0.0
        var ci: int32 = st.trimComLo
        while ci <= st.trimComHi:
            let mass: float64 = 1.0 / w.bodyInvMass[ci]
            mSum = mSum + mass
            comX = comX + mass * w.bodyPx[ci]
            comY = comY + mass * w.bodyPy[ci]
            ci = ci + 1
        let comErrX = comX / mSum - w.bodyPx[st.ballSlot]
        let comErrY = comY / mSum - w.bodyPy[st.ballSlot]
        var trimXn = st.trimX - st.trimRate * comErrX
        if trimXn > BallServoRigidTrimRangeM:
            trimXn = BallServoRigidTrimRangeM
        if trimXn < 0.0 - BallServoRigidTrimRangeM:
            trimXn = 0.0 - BallServoRigidTrimRangeM
        st.trimX = trimXn
        var trimYn = st.trimY - st.trimRate * comErrY
        if trimYn > BallServoRigidTrimRangeM:
            trimYn = BallServoRigidTrimRangeM
        if trimYn < 0.0 - BallServoRigidTrimRangeM:
            trimYn = 0.0 - BallServoRigidTrimRangeM
        st.trimY = trimYn
    # --- pair station-keeping anchor (see the state comment): lean bias
    # toward the anchor point, clamped to the trim range. SIGN (measured
    # 2026-09-16): leaning DRIVES the pair in the lean direction (the
    # duck walks on the ball), so home-return needs the NEGATED error;
    # with +kp the pair ran away 8 m -> 23 m. ---
    var anchorBiasX: float64 = 0.0
    var anchorBiasY: float64 = 0.0
    if st.anchorOn == 1:
        # asymmetric authority: the bias TOTAL clamps at the trim range
        # (a far excursion transits home at full lean — transient, and
        # the arrival velocity needs matching brake authority; a 6 cm
        # total clamp produced a growing home-and-away limit cycle:
        # drive saturated but brake saturated at v ~ 0.1 m/s), while at
        # rest err -> 0 collapses the bias, so no chronic squat.
        var abx = 0.0 - st.anchorKp * (w.bodyPx[st.ballSlot] - st.anchorX) - st.anchorKd * w.bodyVx[st.ballSlot]
        var aby = 0.0 - st.anchorKp * (w.bodyPy[st.ballSlot] - st.anchorY) - st.anchorKd * w.bodyVy[st.ballSlot]
        if abx > BallServoRigidTrimRangeM:
            abx = BallServoRigidTrimRangeM
        if abx < 0.0 - BallServoRigidTrimRangeM:
            abx = 0.0 - BallServoRigidTrimRangeM
        if aby > BallServoRigidTrimRangeM:
            aby = BallServoRigidTrimRangeM
        if aby < 0.0 - BallServoRigidTrimRangeM:
            aby = 0.0 - BallServoRigidTrimRangeM
        anchorBiasX = abx
        anchorBiasY = aby
    # --- linear: torso com toward the frozen ball-frame target ---
    var sx = st.k * ramp * (w.bodyPx[st.ballSlot] + st.offX + st.trimX + anchorBiasX - w.bodyPx[st.torsoSlot])
    var sy = st.k * ramp * (w.bodyPy[st.ballSlot] + st.offY + st.trimY + anchorBiasY - w.bodyPy[st.torsoSlot])
    var sz = st.k * ramp * (w.bodyPz[st.ballSlot] + st.offZ - w.bodyPz[st.torsoSlot])
    let sMag = numerics.CsgSqrt(sx * sx + sy * sy + sz * sz)
    if sMag > st.linCapMps:
        let sc = st.linCapMps / sMag
        sx = sx * sc
        sy = sy * sc
        sz = sz * sc
    # damper against the ball center velocity (v_rel: zero in the pair's
    # common drift mode, so the channel never fights the common roll)
    let rvx = w.bodyVx[st.torsoSlot] - w.bodyVx[st.ballSlot]
    let rvy = w.bodyVy[st.torsoSlot] - w.bodyVy[st.ballSlot]
    let rvz = w.bodyVz[st.torsoSlot] - w.bodyVz[st.ballSlot]
    var dxv = 0.0 - st.c * rvx
    var dyv = 0.0 - st.c * rvy
    var dzv = 0.0 - st.c * rvz
    let dMag = numerics.CsgSqrt(dxv * dxv + dyv * dyv + dzv * dzv)
    if dMag > st.linDampCapMps:
        let dc = st.linDampCapMps / dMag
        dxv = dxv * dc
        dyv = dyv * dc
        dzv = dzv * dc
    w.bodyVx[st.torsoSlot] = w.bodyVx[st.torsoSlot] + sx + dxv
    w.bodyVy[st.torsoSlot] = w.bodyVy[st.torsoSlot] + sy + dyv
    w.bodyVz[st.torsoSlot] = w.bodyVz[st.torsoSlot] + sz + dzv
    # --- angular: torso up-direction u toward the vertical ---
    let qw = w.bodyQuatW[st.torsoSlot]
    let qx = w.bodyQuatX[st.torsoSlot]
    let qy = w.bodyQuatY[st.torsoSlot]
    let qz = w.bodyQuatZ[st.torsoSlot]
    let upx = 2.0 * (qx * qz + qw * qy)
    let upy = 2.0 * (qy * qz - qw * qx)
    let upz = 1.0 - 2.0 * (qx * qx + qy * qy)
    # error vector = axis(errQuat) = (u x e_z) / sqrt(2*(1+u.z)), zero z
    let sDiv = numerics.CsgSqrt(2.0 * (1.0 + upz))
    if sDiv <= BallServoRigidErrEps:
        return
    var axv = st.kAng * ramp * (upy / sDiv)
    var ayv = st.kAng * ramp * (0.0 - upx / sDiv)
    let aMag = numerics.CsgSqrt(axv * axv + ayv * ayv)
    if aMag > st.angCapRadS:
        let ac = st.angCapRadS / aMag
        axv = axv * ac
        ayv = ayv * ac
    # angular damper on omega_rel = omega_torso - omega_ball (zero in the
    # pair's common rotation mode)
    let rwx = w.bodyAngVx[st.torsoSlot] - w.bodyAngVx[st.ballSlot]
    let rwy = w.bodyAngVy[st.torsoSlot] - w.bodyAngVy[st.ballSlot]
    let rwz = w.bodyAngVz[st.torsoSlot] - w.bodyAngVz[st.ballSlot]
    var dax = 0.0 - st.cAng * rwx
    var day = 0.0 - st.cAng * rwy
    var daz = 0.0 - st.cAng * rwz
    let daMag = numerics.CsgSqrt(dax * dax + day * day + daz * daz)
    if daMag > st.angDampCapRadS:
        let adc = st.angDampCapRadS / daMag
        dax = dax * adc
        day = day * adc
        daz = daz * adc
    w.bodyAngVx[st.torsoSlot] = w.bodyAngVx[st.torsoSlot] + axv + dax
    w.bodyAngVy[st.torsoSlot] = w.bodyAngVy[st.torsoSlot] + ayv + day
    w.bodyAngVz[st.torsoSlot] = w.bodyAngVz[st.torsoSlot] + daz

# --- Joint-coordination feedback (the caseD strategy, hand-written v1) ---
#
# The root-cause channel the torso servo cannot touch: on the real
# 1.2:1 ball:duck mass ratio the measured failure mode is the BALL
# rolling out from under the duck (F2: 51 mm ball drift at the 52-tick
# fall with the frozen-stance servos). The torso channels stabilize the
# torso capsule in the ball frame but command no joint response, so
# nothing leans the body back over the contact as the ball shuttles.
# This channel is the joint-space capture step, static feedback v1:
# every tick (before the physics step, after BallServoRigidTick) the
# mass-weighted duck CoM error against the ball CENTER along the facing
# axis (engine +Y forward, e = comY - ballY) drives mirrored hip- and
# ankle-pitch goal offsets into the four leg hinge servos:
#
#   goal_hipL   += kHip   * e        goal_hipR   -= kHip   * e
#   goal_ankleL += kAnkle * e        goal_ankleR -= kAnkle * e
#
# Sign derivation (model joint table, engine +Y forward, stance
# hipL=+th hipR=-th ankleL=-th ankleR=+th, th = 0.43 rad):
#   - Hip L axis is root +X: raising its goal rotates the thigh +about
#     +X, the foot swings forward (+Y), the servo reaction pitches the
#     torso top backward (-Y), and the foot friction drags the ball
#     forward (+Y). For e > 0 (CoM ahead of the ball center) BOTH
#     effects shrink e - a double negative loop. The R hip axis is
#     root -X (mirror), so the same physical motion is -kHip*e there.
#   - Ankle L (axis +X): raising the goal dorsiflexes (toes up); the
#     shin/torso reaction pitches backward (-Y) and the toe press rolls
#     the ball forward (+Y) - same double negative loop, mirrored on R
#     (axis -X, stance +th: goal -= kAnkle*e).
# Every write is clamped twice: the offset against +-goalClampRad and
# the absolute goal against the joint's MJCF range [limMin, limMax]
# (caller passes the model-table ranges; physics3dServoWalk clamps the
# servo command into the same range a second time). Actuation is the
# conGoal column only: the per-tick servo walk (DC double cap) slews
# conCmd toward it, so no goal write can become a torque step. When the
# servo's armed latch is 0 the channel freezes (holds the last goals -
# a snap back to base would inject a step change into the wreck).
const
    # gain group, caseD v1 (measured ladder microduck_ball_probe caseD +
    # the scratch sweep: kHip/kAnkle 0/0, 2/1, 4/2, 8/4, 16/8 rad/m all
    # fall at 59-60 ticks against the 59-tick caseB baseline - the
    # static CoM-error channel is signal-blind to the contact-transient
    # ball-squirt mode, see the channel comment above). 8/4 shipped as
    # the best measured rung (fall 60, mid-ladder, unsaturated). kHip/
    # kAnkle in rad of goal per m of CoM error.
    BallServoCoordDefaultKHip: float64 = 8.0
    BallServoCoordDefaultKAnkle: float64 = 4.0
    # lever 1 (N7): PD velocity weight — rad of goal per (m/s) of CoM
    # error rate, applied as goal_rad += kVel * (e - ePrev) per tick
    # (e_dot * dt semantics at the fixed 240 Hz tick; the term rides the
    # same +-goalClampRad offset clamp as the position term). Off at 0.0
    # (the Init default — the static-v1 channel is behavior-identical).
    # Sizing: the N7 escape event (ball squirts at 0.35 m/s under a
    # <=25 mm position error the pure position term barely sees) reads
    # kVel * 0.35 / 240 ~= 0.047 rad = 2.7 deg of anticipatory lean
    # command at kVel = 32 — visible where the position channel is blind.
    BallServoCoordDefaultKVel: float64 = 32.0
    # error clamp: the CoM shuttle mode measures +-30-65 mm; beyond the
    # clamp the channel commands full lean and stops chasing
    BallServoCoordErrClampM: float64 = 0.06
    # goal-offset clamp (rad from the parked stance goal)
    BallServoCoordGoalClampRad: float64 = 0.5

type
    BallServoCoordState =
        on: int32
        ballSlot: int32
        # inclusive slot range of the mass-weighted duck CoM
        comLo: int32
        comHi: int32
        # the four leg pitch hinge-servo constraints
        conHipL: int32
        conHipR: int32
        conAnkleL: int32
        conAnkleR: int32
        # parked stance goals (captured at init from conGoal)
        baseHipL: float64
        baseHipR: float64
        baseAnkleL: float64
        baseAnkleR: float64
        # MJCF flexion ranges shared per pair (L defines, R matches)
        limHipMin: float64
        limHipMax: float64
        limAnkleMin: float64
        limAnkleMax: float64
        # gain group (frozen at init)
        kHip: float64
        kAnkle: float64
        errClampM: float64
        goalClampRad: float64
        # lever 1 (N7): PD velocity weight on the numerically
        # differentiated CoM error, goal += kVel * (e - ePrev) per tick
        # (0.0 = off, the Init default, via BallServoCoordSetVelGain);
        # eYPrev carries the last raw error (primed at init from the
        # release pose so tick 0 has no synthetic difference), eDotDt is
        # the last applied per-tick difference (diagnostic)
        kVel: float64
        eYPrev: float64
        eDotDt: float64
        # diagnostics (last tick)
        eY: float64
        goalHipL: float64
        goalHipR: float64
        goalAnkleL: float64
        goalAnkleR: float64
        ticks: int32

# Capture the parked stance goals as bases, validate the references and
# freeze the gain group. Call once after the duck assembly (servos
# parked) and ball spawn, before the first tick.
@borrows
fn BallServoCoordInit(cst: var BallServoCoordState,
                      w: world3d.World3d,
                      ballSlot: int32,
                      comLo: int32,
                      comHi: int32,
                      conHipL: int32,
                      conHipR: int32,
                      conAnkleL: int32,
                      conAnkleR: int32,
                      limHipMin: float64,
                      limHipMax: float64,
                      limAnkleMin: float64,
                      limAnkleMax: float64,
                      kHip: float64,
                      kAnkle: float64,
                      errClampM: float64,
                      goalClampRad: float64) =
    if ballSlot < 0 || ballSlot >= w.bodyKind.len:
        panic("ball servo coord: ball slot out of range")
    if w.bodyKind[ballSlot] != world3d.World3dBodyBallRigid:
        panic("ball servo coord: ball slot is not a ball rigid body")
    if comLo < 0 || comHi >= w.bodyKind.len || comHi < comLo:
        panic("ball servo coord: com slot range invalid")
    if comHi >= ballSlot:
        panic("ball servo coord: com range must exclude the ball")
    if conHipL < 0 || conHipL >= w.conCount:
        panic("ball servo coord: hip L constraint out of range")
    if conHipR < 0 || conHipR >= w.conCount:
        panic("ball servo coord: hip R constraint out of range")
    if conAnkleL < 0 || conAnkleL >= w.conCount:
        panic("ball servo coord: ankle L constraint out of range")
    if conAnkleR < 0 || conAnkleR >= w.conCount:
        panic("ball servo coord: ankle R constraint out of range")
    if w.conKind[conHipL] != world3d.World3dConHingeServo:
        panic("ball servo coord: hip L is not a hinge servo")
    if w.conKind[conHipR] != world3d.World3dConHingeServo:
        panic("ball servo coord: hip R is not a hinge servo")
    if w.conKind[conAnkleL] != world3d.World3dConHingeServo:
        panic("ball servo coord: ankle L is not a hinge servo")
    if w.conKind[conAnkleR] != world3d.World3dConHingeServo:
        panic("ball servo coord: ankle R is not a hinge servo")
    if limHipMin >= limHipMax:
        panic("ball servo coord: hip range unordered")
    if limAnkleMin >= limAnkleMax:
        panic("ball servo coord: ankle range unordered")
    if kHip < 0.0 || kAnkle < 0.0:
        panic("ball servo coord: negative gain")
    if errClampM <= 0.0:
        panic("ball servo coord: non-positive error clamp")
    if goalClampRad < 0.0:
        panic("ball servo coord: negative goal clamp")
    cst.ballSlot = ballSlot
    cst.comLo = comLo
    cst.comHi = comHi
    cst.conHipL = conHipL
    cst.conHipR = conHipR
    cst.conAnkleL = conAnkleL
    cst.conAnkleR = conAnkleR
    cst.baseHipL = w.conGoal[conHipL]
    cst.baseHipR = w.conGoal[conHipR]
    cst.baseAnkleL = w.conGoal[conAnkleL]
    cst.baseAnkleR = w.conGoal[conAnkleR]
    if cst.baseHipL < limHipMin || cst.baseHipL > limHipMax:
        panic("ball servo coord: hip L base outside range")
    if cst.baseHipR < limHipMin || cst.baseHipR > limHipMax:
        panic("ball servo coord: hip R base outside range")
    if cst.baseAnkleL < limAnkleMin || cst.baseAnkleL > limAnkleMax:
        panic("ball servo coord: ankle L base outside range")
    if cst.baseAnkleR < limAnkleMin || cst.baseAnkleR > limAnkleMax:
        panic("ball servo coord: ankle R base outside range")
    cst.limHipMin = limHipMin
    cst.limHipMax = limHipMax
    cst.limAnkleMin = limAnkleMin
    cst.limAnkleMax = limAnkleMax
    cst.kHip = kHip
    cst.kAnkle = kAnkle
    cst.errClampM = errClampM
    cst.goalClampRad = goalClampRad
    cst.eY = 0.0
    cst.goalHipL = cst.baseHipL
    cst.goalHipR = cst.baseHipR
    cst.goalAnkleL = cst.baseAnkleL
    cst.goalAnkleR = cst.baseAnkleR
    cst.ticks = 0
    # prime the lever-1 velocity state at the release pose so tick 0
    # differentiates against the true initial error
    var mSum0: float64 = 0.0
    var comY0: float64 = 0.0
    var ci0: int32 = comLo
    while ci0 <= comHi:
        let mass0: float64 = 1.0 / w.bodyInvMass[ci0]
        mSum0 = mSum0 + mass0
        comY0 = comY0 + mass0 * w.bodyPy[ci0]
        ci0 = ci0 + 1
    cst.kVel = 0.0
    cst.eYPrev = comY0 / mSum0 - w.bodyPy[ballSlot]
    cst.eDotDt = 0.0
    cst.on = 1

# Lever 1 (N7) per-state opt-in: the PD velocity weight — rad of goal per
# (m/s) of CoM error rate, 0.0 disables (the Init default). Call after
# BallServoCoordInit, before the first tick.
fn BallServoCoordSetVelGain(cst: var BallServoCoordState, kVel: float64) =
    if kVel < 0.0:
        panic("ball servo coord: negative velocity gain")
    cst.kVel = kVel

# One coordination tick: CoM error read, clamped, mirrored hip/ankle
# goal writes. Call immediately after BallServoRigidTick and before
# physics3d.Physics3dStep. armed = the servo state's armed latch (the
# channel freezes, goals held, once the latch trips). Scalar math only.
fn BallServoCoordTick(cst: var BallServoCoordState, w: var world3d.World3d, armed: int32) =
    if armed == 0:
        cst.on = 0
        return
    cst.on = 1
    # mass-weighted duck CoM over the inclusive slot range
    var mSum: float64 = 0.0
    var comY: float64 = 0.0
    var ci: int32 = cst.comLo
    while ci <= cst.comHi:
        let mass: float64 = 1.0 / w.bodyInvMass[ci]
        mSum = mSum + mass
        comY = comY + mass * w.bodyPy[ci]
        ci = ci + 1
    var e: float64 = comY / mSum - w.bodyPy[cst.ballSlot]
    # lever 1: per-tick numerical error difference (e_dot * dt at the
    # fixed tick period); the goal offsets below take it as the PD
    # damping term, clamped together with the position term by
    # goalClampRad
    var eDotDt: float64 = 0.0
    if cst.kVel > 0.0:
        eDotDt = e - cst.eYPrev
        cst.eDotDt = eDotDt
    cst.eYPrev = e
    cst.eY = e
    if e > cst.errClampM:
        e = cst.errClampM
    if e < 0.0 - cst.errClampM:
        e = 0.0 - cst.errClampM
    # hip goals: L += kHip*e + kVel*eDot, R mirrored; offset clamp then
    # MJCF clamp
    var offH = cst.kHip * e + cst.kVel * eDotDt
    if offH > cst.goalClampRad:
        offH = cst.goalClampRad
    if offH < 0.0 - cst.goalClampRad:
        offH = 0.0 - cst.goalClampRad
    var ghL = cst.baseHipL + offH
    if ghL > cst.limHipMax:
        ghL = cst.limHipMax
    if ghL < cst.limHipMin:
        ghL = cst.limHipMin
    var ghR = cst.baseHipR - offH
    if ghR > cst.limHipMax:
        ghR = cst.limHipMax
    if ghR < cst.limHipMin:
        ghR = cst.limHipMin
    w.conGoal[cst.conHipL] = ghL
    w.conGoal[cst.conHipR] = ghR
    cst.goalHipL = ghL
    cst.goalHipR = ghR
    # ankle goals: L += kAnkle*e + kVel*eDot, R mirrored; same two-stage
    # clamp
    var offA = cst.kAnkle * e + cst.kVel * eDotDt
    if offA > cst.goalClampRad:
        offA = cst.goalClampRad
    if offA < 0.0 - cst.goalClampRad:
        offA = 0.0 - cst.goalClampRad
    var gaL = cst.baseAnkleL + offA
    if gaL > cst.limAnkleMax:
        gaL = cst.limAnkleMax
    if gaL < cst.limAnkleMin:
        gaL = cst.limAnkleMin
    var gaR = cst.baseAnkleR - offA
    if gaR > cst.limAnkleMax:
        gaR = cst.limAnkleMax
    if gaR < cst.limAnkleMin:
        gaR = cst.limAnkleMin
    w.conGoal[cst.conAnkleL] = gaL
    w.conGoal[cst.conAnkleR] = gaR
    cst.goalAnkleL = gaL
    cst.goalAnkleR = gaR
    cst.ticks = cst.ticks + 1

# --- Hip-pitch lean-trim goal channel (the hipTrim line) ---
#
# The rigid adaptation of the N7 trim direction for the NO-TORSO-SERVO
# environment (the policy_tuner episode: the ONLY actuation is the
# duck's own 14 hinge servos, so the N1 torso velocity servo and its
# trimX/trimY target walk have no carrier there). The channel is
# joint-space: a slow leak-free integrator walks a hip-pitch GOAL
# OFFSET dTheta and writes it into the two leg hip-pitch HingeServo
# conGoal columns, mirrored (L goal += dTheta, R goal -= dTheta): the L
# pitch axis is root +X and the R axis root -X, so opposite numeric
# signs are the same physical pitch motion - the BallServoCoordTick
# convention.
#
# Error and sign (derived from the model geometry; engine +Y is the
# facing axis per the microduck_model frame map, the pitch plane is
# Y-Z, so hip pitch has zero authority over the lateral X and the
# channel is deliberately single-axis):
#   e = comY - ballY (mass-weighted duck CoM against the ball center
#   along the facing axis). e > 0: the CoM hangs ahead of the ball
#   center. Raising the L hip goal (and lowering R) swings the feet
#   forward (+Y) and pitches the stance torso top backward (-Y): the
#   planted feet drag the ball forward (ballY up) and the torso CoM
#   moves back (comY down) - BOTH effects strictly reduce e (the
#   measured caseD static-channel double negative loop). Therefore the
#   regulating slow integrator is
#       dTheta += trimRate * e
#   a negative loop on both sides: when the CoM lags the ball center
#   (e < 0, the measured standing lean) dTheta walks negative and the
#   stance pitches forward until the CoM hangs over the contact; when
#   the CoM runs ahead, dTheta walks positive and the stance pitches
#   back. At e = 0 the integrator stops and the goals settle - the
#   N1/N7 "target walks toward the loaded balance point" semantics in
#   joint space.
#
# Opt-in per state (BallServoHipTrimInit): trimRate 0.0 = off - no goal
# write at init or tick, the goals stay parked and the episode is
# behavior-identical to the plain servo protocol (the CEM baseline
# control). dTheta0 is clamped into +-trimRangeRad at init and the
# integral is clamped there every tick (leak-free otherwise); the
# absolute goals are additionally clamped into the joint's MJCF range
# (the two-stage clamp of BallServoCoordTick). Actuation is the
# conGoal column only: the per-tick servo walk slews conCmd toward it,
# so no goal write can become a torque step. The channel has no arming
# latch of its own: it keeps integrating after a topple (post-fall goal
# writes cannot fake survival - the alive convention stops at the first
# head-below tick - and every candidate's drift is measured under the
# same rule).
const
    # hipTrim reference values: trimRate 1/1200 per tick is the N1/N7
    # value (BallServoRigidTrimRate); +-0.10 rad is the suggested
    # starting goal-authority clamp
    BallServoHipTrimDefaultRate: float64 = 0.0008333333333333334
    BallServoHipTrimDefaultRangeRad: float64 = 0.10
    # caseH (T2) velocity-feedforward integration period: the fixed
    # physics tick (physics3d integrates each step at dt = 1/240 s)
    BallServoHipTrimTickPeriodS: float64 = 0.004166666666666667

type
    BallServoHipTrimState =
        on: int32
        ballSlot: int32
        # inclusive slot range of the mass-weighted duck CoM
        comLo: int32
        comHi: int32
        # the two leg pitch hinge-servo constraints
        conHipL: int32
        conHipR: int32
        # parked stance goals (captured at init from conGoal)
        baseHipL: float64
        baseHipR: float64
        # MJCF flexion range shared per pair (L defines, R matches)
        limHipMin: float64
        limHipMax: float64
        # integrator tune (frozen at init)
        trimRate: float64
        trimRangeRad: float64
        # caseH (T2) ball-velocity feedforward magnitude, rad of dTheta
        # per (m/s) of world-frame ball center velocity, >= 0, 0.0 = off
        # (the Init default - states that never call
        # BallServoHipTrimSetFeedforward behave exactly like the plain
        # slow integrator). Applied per tick with the DERIVED negative
        # sign (see the Tick comment): dTheta -= kFf * vBallY *
        # TickPeriodS. Rides the trimRate > 0 goal-write path (the Init
        # contract keeps trimRate 0.0 = no goal write at all).
        kFf: float64
        # the goal offset itself and the last measured error (diagnostic)
        dTheta: float64
        eY: float64
        ticks: int32

# Clamp dTheta into +-trimRangeRad and compute the mirrored hip-pitch
# goals (offset clamp already applied, MJCF clamp here). Scalar helper:
# the callers write the w.conGoal columns themselves (the Init runs
# under a borrow of the world and cannot hand it to a var param).
fn BallServoHipTrimGoalPair(ht: var BallServoHipTrimState, outL: var float64, outR: var float64) =
    var ghL = ht.baseHipL + ht.dTheta
    if ghL > ht.limHipMax:
        ghL = ht.limHipMax
    if ghL < ht.limHipMin:
        ghL = ht.limHipMin
    var ghR = ht.baseHipR - ht.dTheta
    if ghR > ht.limHipMax:
        ghR = ht.limHipMax
    if ghR < ht.limHipMin:
        ghR = ht.limHipMin
    outL = ghL
    outR = ghR

# Capture the parked stance goals as bases, validate the references and
# freeze the integrator tune. trimRate 0.0 = off (no goal write: the
# goals stay exactly as the caller parked them). A nonzero dTheta0 is
# applied immediately (the servo walk slews conCmd toward it, so tick 0
# commands no torque step). Call once after the duck assembly (servos
# parked) and ball spawn, before the first tick.
@borrows
fn BallServoHipTrimInit(ht: var BallServoHipTrimState,
                        w: world3d.World3d,
                        ballSlot: int32,
                        comLo: int32,
                        comHi: int32,
                        conHipL: int32,
                        conHipR: int32,
                        limHipMin: float64,
                        limHipMax: float64,
                        dTheta0: float64,
                        trimRate: float64,
                        trimRangeRad: float64) =
    if ballSlot < 0 || ballSlot >= w.bodyKind.len:
        panic("ball servo hip trim: ball slot out of range")
    if w.bodyKind[ballSlot] != world3d.World3dBodyBallRigid:
        panic("ball servo hip trim: ball slot is not a ball rigid body")
    if comLo < 0 || comHi >= w.bodyKind.len || comHi < comLo:
        panic("ball servo hip trim: com slot range invalid")
    if comHi >= ballSlot:
        panic("ball servo hip trim: com range must exclude the ball")
    if conHipL < 0 || conHipL >= w.conCount:
        panic("ball servo hip trim: hip L constraint out of range")
    if conHipR < 0 || conHipR >= w.conCount:
        panic("ball servo hip trim: hip R constraint out of range")
    if w.conKind[conHipL] != world3d.World3dConHingeServo:
        panic("ball servo hip trim: hip L is not a hinge servo")
    if w.conKind[conHipR] != world3d.World3dConHingeServo:
        panic("ball servo hip trim: hip R is not a hinge servo")
    if limHipMin >= limHipMax:
        panic("ball servo hip trim: hip range unordered")
    if trimRate < 0.0:
        panic("ball servo hip trim: negative trim rate")
    if trimRangeRad < 0.0:
        panic("ball servo hip trim: negative trim range")
    ht.ballSlot = ballSlot
    ht.comLo = comLo
    ht.comHi = comHi
    ht.conHipL = conHipL
    ht.conHipR = conHipR
    ht.baseHipL = w.conGoal[conHipL]
    ht.baseHipR = w.conGoal[conHipR]
    if ht.baseHipL < limHipMin || ht.baseHipL > limHipMax:
        panic("ball servo hip trim: hip L base outside range")
    if ht.baseHipR < limHipMin || ht.baseHipR > limHipMax:
        panic("ball servo hip trim: hip R base outside range")
    ht.limHipMin = limHipMin
    ht.limHipMax = limHipMax
    ht.trimRate = trimRate
    ht.trimRangeRad = trimRangeRad
    ht.kFf = 0.0
    ht.eY = 0.0
    ht.ticks = 0
    ht.on = 1
    ht.dTheta = dTheta0
    if ht.dTheta > ht.trimRangeRad:
        ht.dTheta = ht.trimRangeRad
    if ht.dTheta < 0.0 - ht.trimRangeRad:
        ht.dTheta = 0.0 - ht.trimRangeRad
    if trimRate > 0.0:
        var ghL: float64
        var ghR: float64
        BallServoHipTrimGoalPair(ht, ghL, ghR)
        w.conGoal[conHipL] = ghL
        w.conGoal[conHipR] = ghR

# CaseH (T2) per-state opt-in: the ball-velocity feedforward magnitude,
# rad of dTheta per (m/s) of world-frame ball velocity, >= 0 (0.0 = off,
# the Init default). The applied SIGN is derived at the Tick site: the
# ball escaping forward must pitch the stance forward immediately, and
# the measured caseG trim direction for that is dTheta walking NEGATIVE,
# so the tick applies dTheta -= kFf * vBallY * dt. Call after
# BallServoHipTrimInit, before the first tick; the term actuates only on
# the trimRate > 0 goal-write path.
fn BallServoHipTrimSetFeedforward(ht: var BallServoHipTrimState, kFf: float64) =
    if kFf < 0.0:
        panic("ball servo hip trim: negative feedforward gain")
    ht.kFf = kFf

# One hip-trim tick: CoM error read, slow integral, mirrored hip goal
# writes. Call immediately before physics3d.Physics3dStep. trimRate 0.0
# = off (diagnostics only, no goal write). Scalar math only.
fn BallServoHipTrimTick(ht: var BallServoHipTrimState, w: var world3d.World3d) =
    if ht.on == 0:
        return
    # mass-weighted duck CoM over the inclusive slot range
    var mSum: float64 = 0.0
    var comY: float64 = 0.0
    var ci: int32 = ht.comLo
    while ci <= ht.comHi:
        let mass: float64 = 1.0 / w.bodyInvMass[ci]
        mSum = mSum + mass
        comY = comY + mass * w.bodyPy[ci]
        ci = ci + 1
    let e: float64 = comY / mSum - w.bodyPy[ht.ballSlot]
    ht.eY = e
    if ht.trimRate > 0.0:
        var dNew = ht.dTheta + ht.trimRate * e
        # caseH (T2) velocity feedforward: the slow integrator only
        # reacts AFTER the comErr has accumulated (the measured caseG
        # escape: the ball rolls forward, comErr swings to -165 mm, and
        # the 1/856-per-tick walk cannot follow a ballistic escape). The
        # world-frame ball center velocity vBallY is the leading
        # indicator of exactly that escape, so it feeds the integrator
        # rate directly. Sign (engine +Y facing, the caseG measured trim
        # direction): the ball escaping forward (vBallY > 0) must pitch
        # the stance FORWARD immediately to chase it, and pitching
        # forward is dTheta walking NEGATIVE (the caseG CEM-best run
        # saturated trimEnd at the -0.100 clamp), so the applied term is
        #     dTheta -= kFf * vBallY * dt      (kFf >= 0, the magnitude;
        # equivalently dTheta += kFfSigned * vBallY * dt with
        # kFfSigned = -kFf < 0). dt is the fixed 240 Hz physics tick
        # period (BallServoHipTrimTickPeriodS, the physics3d step dt).
        # The clamp below bounds the combined walk to +-trimRangeRad.
        if ht.kFf > 0.0:
            dNew = dNew - ht.kFf * w.bodyVy[ht.ballSlot] * BallServoHipTrimTickPeriodS
        if dNew > ht.trimRangeRad:
            dNew = ht.trimRangeRad
        if dNew < 0.0 - ht.trimRangeRad:
            dNew = 0.0 - ht.trimRangeRad
        ht.dTheta = dNew
        var ghL: float64
        var ghR: float64
        BallServoHipTrimGoalPair(ht, ghL, ghR)
        w.conGoal[ht.conHipL] = ghL
        w.conGoal[ht.conHipR] = ghR
    ht.ticks = ht.ticks + 1

# --- Hip-roll lateral trim goal channel (the rollTrim line) ---
#
# The lateral twin of the hip-pitch trim channel above. The measured
# caseK stack (torso servo + the pitch trim on the real duck) balanced
# the facing axis (comErrY converged to 6.7 mm, dTheta walking positive
# unsaturated) but the pair still escaped 1918.7 mm with the +X lateral
# component at 99.97% of it: the pitch plane is Y/facing, so hip pitch
# has zero authority over the lateral X (deliberately single-axis,
# above), and the lateral common-mode roll runs unopposed. The
# actuator is already in the assembly (each leg's hipRoll HingeServo,
# MJCF +-22 deg = +-0.384 rad, parked at 0); what was missing is the
# slow goal-offset integrator driving it. Structure: the
# BallServoHipTrim shape verbatim, single axis - a hip roll rotation
# about the root-facing axis moves the stance in the X-Z plane only, so
# the channel has zero authority over the facing Y, symmetric to the
# pitch channel's zero lateral X authority.
#
# Sign derivation (model joint table: BOTH hip roll axes are root +Y -
# j1 right_hip_roll and j6 left_hip_roll - unlike the pitch pair, where
# L=+X and R=-X mirror, the roll pair is SAME-signed, so one and the
# same numeric offset on both goals is one physical lateral motion).
# Positive hinge rotation about +Y takes the hanging leg (-Z) to -X:
# raising both roll goals swings both feet toward -X; the planted feet
# then drag the ball -X (ballX down) while the servo reaction rolls the
# torso top +X (the CoM rides high over the hips, comX up) - so for
#     eX = comX - ballX   (mass-weighted duck CoM against the ball
#     center along the lateral axis)
# a positive goal offset GROWS eX. Therefore the regulating slow
# integrator is
#     dRoll -= trimRate * eX
# the pitch channel's double negative loop mirrored: when the CoM hangs
# on the +X side (eX > 0) dRoll walks negative, both feet swing +X, the
# foot friction drags the ball +X (ballX up) and the reaction shifts
# the torso CoM -X (comX down) - BOTH effects strictly shrink eX; at
# eX = 0 the integrator stops and the goals settle - the N1/N7
# "target walks toward the loaded balance point" semantics in the
# lateral joint space.
#
# Opt-in per state (BallServoRollTrimInit): trimRate 0.0 = off - no
# goal write at init or tick, the roll goals stay parked and the
# episode is behavior-identical to the plain servo protocol (the
# caseK baseline). dRoll0 is clamped into +-trimRangeRad at init and
# the integral is clamped there every tick (leak-free otherwise); the
# absolute goals are additionally clamped into the joint's MJCF range
# (the two-stage clamp of BallServoHipTrimGoalPair). Actuation is the
# conGoal column only: the per-tick servo walk slews conCmd toward it,
# so no goal write can become a torque step. The channel has no arming
# latch of its own (the pitch-channel convention: it keeps integrating
# after a topple - post-fall goal writes cannot fake survival - and
# every candidate's drift is measured under the same rule).
const
    # rollTrim reference values: trimRate 1/1200 per tick is the N1/N7
    # value (BallServoRigidTrimRate); +-0.05 rad is the conservative
    # starting goal-authority clamp, well inside the +-0.384 rad MJCF
    # hip-roll limit
    BallServoRollTrimDefaultRate: float64 = 0.0008333333333333334
    BallServoRollTrimDefaultRangeRad: float64 = 0.05

type
    BallServoRollTrimState =
        on: int32
        ballSlot: int32
        # inclusive slot range of the mass-weighted duck CoM
        comLo: int32
        comHi: int32
        # the two leg roll hinge-servo constraints
        conRollL: int32
        conRollR: int32
        # parked stance goals (captured at init from conGoal)
        baseRollL: float64
        baseRollR: float64
        # MJCF roll range shared per pair (L defines, R matches)
        limRollMin: float64
        limRollMax: float64
        # integrator tune (frozen at init)
        trimRate: float64
        trimRangeRad: float64
        # caseL lateral ball-velocity brake magnitude, rad of dRoll per
        # (m/s) of world-frame ball center velocity, >= 0, 0.0 = off
        # (the Init default - states that never call
        # BallServoRollTrimSetFeedforward behave exactly like the plain
        # slow integrator). Applied per tick with the DERIVED braking
        # sign (see the Tick comment): dRoll += kFf * vBallX *
        # TickPeriodS. Rides the trimRate > 0 goal-write path (the Init
        # contract keeps trimRate 0.0 = no goal write at all).
        kFf: float64
        # the goal offset itself and the last measured error (diagnostic)
        dRoll: float64
        eX: float64
        ticks: int32

# Clamp dRoll into +-trimRangeRad and compute the SAME-signed hip-roll
# goals (offset clamp already applied, MJCF clamp here) - both roll
# axes are root +Y, so both goals take +dRoll (the sign derivation at
# the channel comment above). Scalar helper: the callers write the
# w.conGoal columns themselves (the Init runs under a borrow of the
# world and cannot hand it to a var param).
fn BallServoRollTrimGoalPair(rt: var BallServoRollTrimState, outL: var float64, outR: var float64) =
    var grL = rt.baseRollL + rt.dRoll
    if grL > rt.limRollMax:
        grL = rt.limRollMax
    if grL < rt.limRollMin:
        grL = rt.limRollMin
    var grR = rt.baseRollR + rt.dRoll
    if grR > rt.limRollMax:
        grR = rt.limRollMax
    if grR < rt.limRollMin:
        grR = rt.limRollMin
    outL = grL
    outR = grR

# Capture the parked stance goals as bases, validate the references and
# freeze the integrator tune. trimRate 0.0 = off (no goal write: the
# roll goals stay exactly as the caller parked them). A nonzero dRoll0
# is applied immediately (the servo walk slews conCmd toward it, so
# tick 0 commands no torque step). Call once after the duck assembly
# (servos parked) and ball spawn, before the first tick.
@borrows
fn BallServoRollTrimInit(rt: var BallServoRollTrimState,
                         w: world3d.World3d,
                         ballSlot: int32,
                         comLo: int32,
                         comHi: int32,
                         conRollL: int32,
                         conRollR: int32,
                         limRollMin: float64,
                         limRollMax: float64,
                         dRoll0: float64,
                         trimRate: float64,
                         trimRangeRad: float64) =
    if ballSlot < 0 || ballSlot >= w.bodyKind.len:
        panic("ball servo roll trim: ball slot out of range")
    if w.bodyKind[ballSlot] != world3d.World3dBodyBallRigid:
        panic("ball servo roll trim: ball slot is not a ball rigid body")
    if comLo < 0 || comHi >= w.bodyKind.len || comHi < comLo:
        panic("ball servo roll trim: com slot range invalid")
    if comHi >= ballSlot:
        panic("ball servo roll trim: com range must exclude the ball")
    if conRollL < 0 || conRollL >= w.conCount:
        panic("ball servo roll trim: roll L constraint out of range")
    if conRollR < 0 || conRollR >= w.conCount:
        panic("ball servo roll trim: roll R constraint out of range")
    if w.conKind[conRollL] != world3d.World3dConHingeServo:
        panic("ball servo roll trim: roll L is not a hinge servo")
    if w.conKind[conRollR] != world3d.World3dConHingeServo:
        panic("ball servo roll trim: roll R is not a hinge servo")
    if limRollMin >= limRollMax:
        panic("ball servo roll trim: roll range unordered")
    if trimRate < 0.0:
        panic("ball servo roll trim: negative trim rate")
    if trimRangeRad < 0.0:
        panic("ball servo roll trim: negative trim range")
    rt.ballSlot = ballSlot
    rt.comLo = comLo
    rt.comHi = comHi
    rt.conRollL = conRollL
    rt.conRollR = conRollR
    rt.baseRollL = w.conGoal[conRollL]
    rt.baseRollR = w.conGoal[conRollR]
    if rt.baseRollL < limRollMin || rt.baseRollL > limRollMax:
        panic("ball servo roll trim: roll L base outside range")
    if rt.baseRollR < limRollMin || rt.baseRollR > limRollMax:
        panic("ball servo roll trim: roll R base outside range")
    rt.limRollMin = limRollMin
    rt.limRollMax = limRollMax
    rt.trimRate = trimRate
    rt.trimRangeRad = trimRangeRad
    rt.kFf = 0.0
    rt.eX = 0.0
    rt.ticks = 0
    rt.on = 1
    rt.dRoll = dRoll0
    if rt.dRoll > rt.trimRangeRad:
        rt.dRoll = rt.trimRangeRad
    if rt.dRoll < 0.0 - rt.trimRangeRad:
        rt.dRoll = 0.0 - rt.trimRangeRad
    if trimRate > 0.0:
        var grL: float64
        var grR: float64
        BallServoRollTrimGoalPair(rt, grL, grR)
        w.conGoal[conRollL] = grL
        w.conGoal[conRollR] = grR

# CaseL per-state opt-in: the lateral ball-velocity brake magnitude, rad
# of dRoll per (m/s) of world-frame ball velocity, >= 0 (0.0 = off, the
# Init default). The applied SIGN is derived at the Tick site from the
# ball-ground pure-rolling coupling (see the Tick comment): the applied
# term is dRoll += kFf * vBallX * dt (kFf >= 0, the magnitude). Call
# after BallServoRollTrimInit, before the first tick; the term actuates
# only on the trimRate > 0 goal-write path.
fn BallServoRollTrimSetFeedforward(rt: var BallServoRollTrimState, kFf: float64) =
    if kFf < 0.0:
        panic("ball servo roll trim: negative feedforward gain")
    rt.kFf = kFf

# One roll-trim tick: lateral CoM error read, slow integral, SAME-signed
# roll goal writes. Call immediately before physics3d.Physics3dStep
# (composes with BallServoHipTrimTick: disjoint conGoal columns).
# trimRate 0.0 = off (diagnostics only, no goal write). Scalar math only.
fn BallServoRollTrimTick(rt: var BallServoRollTrimState, w: var world3d.World3d) =
    if rt.on == 0:
        return
    # mass-weighted duck CoM over the inclusive slot range (lateral X)
    var mSum: float64 = 0.0
    var comX: float64 = 0.0
    var ci: int32 = rt.comLo
    while ci <= rt.comHi:
        let mass: float64 = 1.0 / w.bodyInvMass[ci]
        mSum = mSum + mass
        comX = comX + mass * w.bodyPx[ci]
        ci = ci + 1
    let e: float64 = comX / mSum - w.bodyPx[rt.ballSlot]
    rt.eX = e
    if rt.trimRate > 0.0:
        var dNew = rt.dRoll - rt.trimRate * e
        # caseL lateral ball-velocity brake: the slow position
        # integrator only reacts where comErrX carries the signal, and
        # the measured caseL baseline row (the pure dual integrator)
        # converged comErrX to -7.2 mm while the pair STILL coasted +X
        # at a constant ~0.386 mm/tick - the servo-zero-work common-mode
        # translation is invisible to comErrX (caseC documented the same
        # for the facing axis: parking the pair needs a common-mode
        # sink). The sink in joint space is a velocity-nulling term on
        # the same integrator, signed by the ball-ground pure-rolling
        # coupling. Wheel algebra (ball radius r, I = 0.4 m r^2, foot
        # friction f at the TOP point, ground friction G at the BOTTOM,
        # rolling constraint v = -omega_y r): translation m dv = f + G,
        # rotation I domega_y = r f - r G, constraint gives
        #     -0.4 (f + G) = f - G   ->   G = +2.333 f
        # - the ground reaction is SAME-
        # SIGNED as the foot friction and 2.33x stronger, so ANY top
        # friction is amplified by the ground into a pair-level force.
        # This was measured, not just derived: the first caseL rung with
        # the term signed dRoll -= kFf*vBallX*dt (dRoll clamped
        # NEGATIVE = feet sliding +X = f_x > 0) doubled the coast slope
        # 0.386 -> 0.83 mm/tick - the +f -> +G pump, exactly as the
        # same-sign algebra predicts. Braking a +X coast (vBallX > 0)
        # therefore needs foot friction -X at the ball top: the feet
        # slide -X across the surface, the torso leans +X, and by the
        # sign derivation above that is dRoll walking POSITIVE, so the
        # applied term is
        #     dRoll += kFf * vBallX * dt      (kFf >= 0, the magnitude;
        # dt is the fixed 240 Hz physics tick period,
        # BallServoHipTrimTickPeriodS). The clamp below bounds the
        # combined walk to +-trimRangeRad.
        if rt.kFf > 0.0:
            dNew = dNew + rt.kFf * w.bodyVx[rt.ballSlot] * BallServoHipTrimTickPeriodS
        if dNew > rt.trimRangeRad:
            dNew = rt.trimRangeRad
        if dNew < 0.0 - rt.trimRangeRad:
            dNew = 0.0 - rt.trimRangeRad
        rt.dRoll = dNew
        var grL: float64
        var grR: float64
        BallServoRollTrimGoalPair(rt, grL, grR)
        w.conGoal[rt.conRollL] = grL
        w.conGoal[rt.conRollR] = grR
    rt.ticks = rt.ticks + 1

# --- Ball-top walking coordinator (WALK-B: the dynamic capture-step gait) ---
#
# The N7 verdict is a structural gap: static feedback (torso servo + joint
# coordination) falls at 59-163 ticks because its shear authority (correction
# caps in the tens of mm/s) cannot cross the ~350 mm/s velocity-type escape of
# the 1.2:1 ball:duck pair, and the static channels are signal-blind to exactly
# that mode. Walking is the complementary mechanism: a rider on a rolling ball
# does not stand, it CONTINUOUSLY STEPS - every escape of the ball is answered
# by a capture step that rebuilds the support under the CoM (the
# inverted-pendulum capturing-step principle, the continuous version of the N1
# capture step).
#
# The primitive is the CsgExecutionQueueStep gait anchor adapted to the sphere.
# A kinematic anchor body (World3dBodyAnchor, invMass 0, never an obstacle -
# contacts3d skips zero-invMass bodies) is pinned to the BALL SURFACE at the
# point under the duck CoM:
#   anchor = ballCenter + normalize(com - ballCenter) * (r + footRadius)
# (the reverse of the CoM->ball direction extended to the surface, one foot
# radius above it - the foot-CENTER rolling constraint surface), and a
# bilateral World3dConStepPull rod - the exact CsgExecutionRunFootstep winch
# semantics (conTarget starts at the spawn distance and contracts at the
# bounded rate to the min(plantLen, dist0) floor) - pulls the foot to it. The
# anchor direction is recomputed EVERY tick from the live CoM and ball center,
# so as the ball rolls the anchor rides around the sphere staying under the
# CoM and the winched foot stays glued to the ball: the foot rolls WITH the
# ball instead of being left behind on the apex.
#
# Sign structure (the capture loop, symmetric in both directions): the ball
# escaping +Y leaves the CoM lagging, so the surface point under the CoM sits
# on the -Y flank of the apex; winching the foot there slides it backward over
# the ball surface, and the friction reaction drags the ball BACK toward the
# duck while the winch (through the leg chain) drags the duck FORWARD toward
# the ball - both effects strictly shrink the CoM error (the measured caseD
# double negative loop, now driven by the roll itself).
#
# Trigger: per tick the coordinator measures the ball-center horizontal
# displacement delta (previous tick vs current). Rolling accumulates; when the
# step window is free and the rolling accumulated since the last launch exceeds
# BallWalkTriggerM (0.2 mm: any real roll qualifies, numeric noise does not),
# the next ALTERNATING foot launches its capture step (short 60-tick window).
# A fully still ball launches nothing and the stance stays parked - the gait is
# dynamic walking, not a standing servo.
#
# Tuned adaptive overlay (BallWalkSetAdaptive, per-state opt-in; legacy
# states keep the exact pre-tuning behavior): the fixed 60-tick window and
# the exactly-under-CoM anchor cannot hold the end phase - the ball's
# escape outgrows the capture and the step recoil pumps the roll into a
# runaway (measured: drift 0.69 m at tick 2000 to 5.82 m at tick 3000,
# mean system velocity 1227 mm/s over the last 1000 ticks). The knob that
# closes it is the SIGNED roll-axis step reach: the anchor walks the arc
# reachM = clamp(|vBall| * kR, -cap, +cap) along the roll direction.
# Positive (ahead of the roll, the pump side) makes it WORSE - a press
# ahead of the ball center torques the roll forward about the ground
# contact. Negative (behind, the brake side) sinks the press point down
# the back flank and grows the brake lever: shipped kR = -0.10 s holds
# the mean system velocity at 199 mm/s (< the 0.3 m/s bounded-walk bar)
# with full survival and zero rejects. The adaptive window (winTicks =
# base/(1 + |v|*kW)) is measured NOT to help - shrink alone leaves the
# runaway (1175 mm/s at kW=1.0), aggressive shrink pumps harder (2543
# mm/s at kW=3.0, 183 steps) and degrades the brake reach in combination
# - so the shipped tune pins kW = 0 and keeps the formula for opt-in
# experiments only.
#
# Safety structure (the library conventions): contact-gated arming (no step
# before the first foot-ball proximity latch - the release drop must not be
# winched mid-air; the lever-2 shape), and the whole channel freezes on the
# torso servo's armed latch passed by the caller (actuation from a toppled or
# airborne state is unphysical, the BallServoCoordTick contract; a live rod is
# released at the freeze so the wreck is not held to the ball). Anchor bodies
# and rods are PERSISTENT per foot: the first step on each foot spawns them,
# every later launch rewrites the same body and constraint slots field-for-
# field identically to a fresh spawn/add (the documented dynamic-queue
# recycling semantics of CsgExecutionRunFootstep) - body and constraint
# capacity stay bounded no matter how many steps the episode walks.
const
    # anchor window: 60 ticks = 0.25 s per capture step (the WALK-B spec;
    # ground CsgExecutionQueueWalk uses 270 - the ball walk steps 4.5x faster)
    BallWalkWindowTicks: int64 = 60
    # winch contraction rate, the CsgExecutionQueueWalk ground value
    BallWalkRateMps: float64 = 0.80
    # plant length floor, the CsgExecutionQueueWalk ground value
    BallWalkPlantLenM: float64 = 0.02
    # accumulated ball rolling (m, since the last launch) that arms the next
    # capture step: 0.2 mm
    BallWalkTriggerM: float64 = 0.0002
    # anchor body radius, the execution.cheng anchor convention (0.03 m
    # control point, never an obstacle)
    BallWalkAnchorRadiusM: float64 = 0.03
    # normalize guard for the CoM->ball surface direction (the CoM rides
    # ~0.55 m above the ball center; only a degenerate wreck could reach zero)
    BallWalkDirEps: float64 = 0.000001
    # normalize guard for the ball escape-velocity direction
    BallWalkVelEpsMps: float64 = 0.001
    # -- tuned adaptive walk (the BW-line end-phase runaway fix; legacy
    #    states never calling BallWalkSetAdaptive keep the fixed 60-tick
    #    window and the exact pre-tuning behavior) --
    # adaptive window: winTicks = clamp(BallWalkWindowTicks /
    # (1 + |vBall| * winSpeedK), winMinTicks, BallWalkWindowTicks) - the
    # faster the ball rolls away, the shorter the capture window (higher
    # step frequency, smaller per-step winch impulse). MEASURED (probe
    # sweep round 2): window shrink alone does NOT close the runaway
    # (kW=1.0 -> 1175 mm/s system velocity, kW=3.0 -> 2543 mm/s - the
    # higher step frequency pumps harder) and it degrades the brake
    # reach when combined, so the shipped tune pins winSpeedK = 0 (the
    # fixed 60-tick window); the formula stays available for opt-in
    # experiments
    BallWalkWindowSpeedK: float64 = 0.0
    BallWalkWindowMinTicks: float64 = 60.0
    # adaptive step reach: reachM = clamp(|vBall| * reachSpeedK,
    # -reachMaxM, +reachMaxM) of arc ALONG THE ROLL AXIS - SIGNED:
    # positive reaches AHEAD along the escape (the pump side: a press
    # ahead of the ball center torques the roll forward about the ground
    # contact), negative reaches BEHIND (the brake side: the press point
    # sinks down the back flank behind the ball center and the brake
    # lever rho*W grows). MEASURED (probe sweep): positive reach pumps
    # hard (348 mm/s ball at tick 250 vs 124 legacy, early falls); the
    # shipped brake-side tune (kR = -0.10 s, cap 60 mm) holds the mean
    # system velocity at 199 mm/s over the last 1000 ticks (6.2x under
    # the legacy 1227 mm/s runaway, under the 0.3 m/s bar, zero rejects,
    # full 3000-tick survival, 49 capture steps)
    BallWalkReachSpeedK: float64 = -0.10
    BallWalkReachMaxM: float64 = 0.06

type
    BallWalkState =
        on: int32
        ballSlot: int32
        footLSlot: int32
        footRSlot: int32
        # inclusive slot range of the mass-weighted duck CoM (drives the
        # anchor surface direction)
        comLo: int32
        comHi: int32
        # contact gate (the lever-2 shape): contactDistM 0.0 = off, otherwise
        # no step launches before the first foot comes within contactDistM of
        # the ball center
        contactGateOn: int32
        contactSeen: int32
        contactDistM: float64
        # the two persistent per-foot tether bodies + StepPull rods (-1 until
        # the first step on that foot)
        anchorL: int32
        anchorR: int32
        conL: int32
        conR: int32
        # active step: 0 none, 1 foot L, 2 foot R
        activeFoot: int32
        endTick: int64
        floorLen: float64
        nextFoot: int32
        # ball-center tracking (previous tick position) and the rolling
        # accumulated since the last launch (the trigger)
        prevBallX: float64
        prevBallY: float64
        rolledM: float64
        # diagnostics (totals and last tick)
        stepCount: int32
        lastDeltaM: float64
        lastAnchorX: float64
        lastAnchorY: float64
        lastAnchorZ: float64
        ticks: int32
        # tuned adaptive walk: 0 = legacy fixed window, no reach (the
        # exact pre-tuning behavior); 1 = speed-adaptive window +
        # roll-direction step reach. The four tune scalars are Init-
        # defaulted to the conservative constants and overridable via
        # BallWalkSetAdaptive (the probe sweep / film pin path)
        adaptive: int32
        winSpeedK: float64
        winMinTicks: float64
        reachSpeedK: float64
        reachMaxM: float64
        # diagnostics of the last launch (60 / 0.0 in legacy mode)
        lastWindowTicks: int64
        lastReachM: float64
        lastBallV: float64

# Validate the references and freeze the contact gate. contactDistM is
# center-to-center: size it as ballRadius + footRadius + slack (the lever-2
# sizing); 0.0 disables the gate (steps armed from tick 0). Call once after
# the duck assembly and ball spawn, before the first physics step.
@borrows
fn BallWalkInit(bw: var BallWalkState,
                w: world3d.World3d,
                ballSlot: int32,
                footLSlot: int32,
                footRSlot: int32,
                comLo: int32,
                comHi: int32,
                contactDistM: float64) =
    if ballSlot < 0 || ballSlot >= w.bodyKind.len:
        panic("ball walk: ball slot out of range")
    if w.bodyKind[ballSlot] != world3d.World3dBodyBallRigid:
        panic("ball walk: ball slot is not a ball rigid body")
    if footLSlot < 0 || footLSlot >= w.bodyKind.len:
        panic("ball walk: foot L slot out of range")
    if w.bodyKind[footLSlot] != world3d.World3dBodyCapsuleRigid:
        panic("ball walk: foot L slot is not a capsule rigid")
    if footRSlot < 0 || footRSlot >= w.bodyKind.len:
        panic("ball walk: foot R slot out of range")
    if w.bodyKind[footRSlot] != world3d.World3dBodyCapsuleRigid:
        panic("ball walk: foot R slot is not a capsule rigid")
    if comLo < 0 || comHi >= ballSlot || comHi < comLo:
        panic("ball walk: com slot range invalid (must exclude the ball)")
    if contactDistM < 0.0:
        panic("ball walk: negative contact distance")
    bw.on = 1
    bw.ballSlot = ballSlot
    bw.footLSlot = footLSlot
    bw.footRSlot = footRSlot
    bw.comLo = comLo
    bw.comHi = comHi
    bw.contactGateOn = 0
    bw.contactSeen = 0
    bw.contactDistM = contactDistM
    if contactDistM > 0.0:
        bw.contactGateOn = 1
    bw.anchorL = 0 - 1
    bw.anchorR = 0 - 1
    bw.conL = 0 - 1
    bw.conR = 0 - 1
    bw.activeFoot = 0
    bw.endTick = 0
    bw.floorLen = 0.0
    bw.nextFoot = 1
    bw.prevBallX = w.bodyPx[ballSlot]
    bw.prevBallY = w.bodyPy[ballSlot]
    bw.rolledM = 0.0
    bw.stepCount = 0
    bw.lastDeltaM = 0.0
    bw.lastAnchorX = 0.0
    bw.lastAnchorY = 0.0
    bw.lastAnchorZ = 0.0
    bw.ticks = 0
    bw.adaptive = 0
    bw.winSpeedK = BallWalkWindowSpeedK
    bw.winMinTicks = BallWalkWindowMinTicks
    bw.reachSpeedK = BallWalkReachSpeedK
    bw.reachMaxM = BallWalkReachMaxM
    bw.lastWindowTicks = 0
    bw.lastReachM = 0.0
    bw.lastBallV = 0.0

# Opt into the tuned speed-adaptive walk: the adaptive capture window
# winTicks = clamp(BallWalkWindowTicks / (1 + |vBall| * windowSpeedK),
# windowMinTicks, BallWalkWindowTicks) and the signed roll-axis step
# reach reachM = clamp(|vBall| * reachSpeedK, -reachMaxM, +reachMaxM)
# (positive = ahead of the roll = the pump side, negative = behind =
# the brake side). The Init defaults are the shipped conservative tune;
# this setter exists so probes/films can pin the exact tune (and sweeps
# can explore it). Legacy states that never call it keep the exact
# pre-tuning behavior.
fn BallWalkSetAdaptive(bw: var BallWalkState, windowSpeedK: float64, windowMinTicks: float64, reachSpeedK: float64, reachMaxM: float64) =
    if windowSpeedK < 0.0:
        panic("ball walk: negative window speed gain")
    if windowMinTicks <= 0.0:
        panic("ball walk: non-positive window floor")
    if windowMinTicks > float64(BallWalkWindowTicks):
        panic("ball walk: window floor above the base window")
    if reachSpeedK < 0.0 - 10.0:
        panic("ball walk: unphysical reach speed gain")
    if reachSpeedK > 10.0:
        panic("ball walk: unphysical reach speed gain")
    if reachMaxM < 0.0:
        panic("ball walk: negative reach cap")
    if reachMaxM > 0.5:
        panic("ball walk: unphysical reach cap")
    bw.adaptive = 1
    bw.winSpeedK = windowSpeedK
    bw.winMinTicks = windowMinTicks
    bw.reachSpeedK = reachSpeedK
    bw.reachMaxM = reachMaxM

# One walking tick: rolling detection, active-step anchor follow + winch, or
# the next alternating capture-step launch. Call after BallServoRigidTick (and
# BallServoCoordTick) and immediately before physics3d.Physics3dStep. armed =
# the servo state's armed latch (the channel freezes and releases its live rod
# once the latch trips). Scalar math only.
fn BallWalkTick(bw: var BallWalkState, w: var world3d.World3d, armed: int32) =
    if bw.on == 0:
        return
    bw.ticks = bw.ticks + 1
    if armed == 0:
        # freeze on the servo armed latch: release the live rod so the
        # toppled wreck is not held to the ball, then step no more
        if bw.activeFoot != 0:
            var ciEnd: int32 = bw.conL
            if bw.activeFoot == 2:
                ciEnd = bw.conR
            w.conActive[ciEnd] = 0
            bw.activeFoot = 0
        return
    # contact gate: no stepping before the first foot-ball proximity latch
    if bw.contactGateOn == 1:
        if bw.contactSeen == 0:
            let gdxL = w.bodyPx[bw.footLSlot] - w.bodyPx[bw.ballSlot]
            let gdyL = w.bodyPy[bw.footLSlot] - w.bodyPy[bw.ballSlot]
            let gdzL = w.bodyPz[bw.footLSlot] - w.bodyPz[bw.ballSlot]
            let gdxR = w.bodyPx[bw.footRSlot] - w.bodyPx[bw.ballSlot]
            let gdyR = w.bodyPy[bw.footRSlot] - w.bodyPy[bw.ballSlot]
            let gdzR = w.bodyPz[bw.footRSlot] - w.bodyPz[bw.ballSlot]
            let d2L = gdxL * gdxL + gdyL * gdyL + gdzL * gdzL
            let d2R = gdxR * gdxR + gdyR * gdyR + gdzR * gdzR
            let th2 = bw.contactDistM * bw.contactDistM
            if d2L < th2 || d2R < th2:
                bw.contactSeen = 1
            else:
                bw.prevBallX = w.bodyPx[bw.ballSlot]
                bw.prevBallY = w.bodyPy[bw.ballSlot]
                return
    # ball rolling delta since the last tick
    let bx = w.bodyPx[bw.ballSlot]
    let by = w.bodyPy[bw.ballSlot]
    let ddx = bx - bw.prevBallX
    let ddy = by - bw.prevBallY
    let dMag = numerics.CsgSqrt(ddx * ddx + ddy * ddy)
    bw.lastDeltaM = dMag
    bw.rolledM = bw.rolledM + dMag
    bw.prevBallX = bx
    bw.prevBallY = by
    if bw.activeFoot != 0:
        # --- active step: the anchor rides the sphere under the live CoM ---
        var footSlot: int32 = bw.footLSlot
        var ci: int32 = bw.conL
        var anchorSlot: int32 = bw.anchorL
        if bw.activeFoot == 2:
            footSlot = bw.footRSlot
            ci = bw.conR
            anchorSlot = bw.anchorR
        var mSum: float64 = 0.0
        var comX: float64 = 0.0
        var comY: float64 = 0.0
        var comZ: float64 = 0.0
        var ci2: int32 = bw.comLo
        while ci2 <= bw.comHi:
            let mass: float64 = 1.0 / w.bodyInvMass[ci2]
            mSum = mSum + mass
            comX = comX + mass * w.bodyPx[ci2]
            comY = comY + mass * w.bodyPy[ci2]
            comZ = comZ + mass * w.bodyPz[ci2]
            ci2 = ci2 + 1
        let dirx = comX / mSum - bx
        let diry = comY / mSum - by
        let dirz = comZ / mSum - w.bodyPz[bw.ballSlot]
        let dn = numerics.CsgSqrt(dirx * dirx + diry * diry + dirz * dirz)
        if dn > BallWalkDirEps:
            let pad = w.bodyRadius[bw.ballSlot] + w.bodyRadius[footSlot]
            let ax = bx + dirx / dn * pad
            let ay = by + diry / dn * pad
            let az = w.bodyPz[bw.ballSlot] + dirz / dn * pad
            w.bodyPx[anchorSlot] = ax
            w.bodyPy[anchorSlot] = ay
            w.bodyPz[anchorSlot] = az
            bw.lastAnchorX = ax
            bw.lastAnchorY = ay
            bw.lastAnchorZ = az
        # winch contraction toward the floor (the RunFootstep semantics)
        let newTarget = w.conTarget[ci] - BallWalkRateMps * BallServoHipTrimTickPeriodS
        if newTarget < bw.floorLen:
            w.conTarget[ci] = bw.floorLen
        else:
            w.conTarget[ci] = newTarget
        if w.tick >= bw.endTick:
            w.conActive[ci] = 0
            bw.activeFoot = 0
        return
    # --- launch gate: rolling accumulated over the trigger arms the next
    # alternating capture step ---
    if bw.rolledM <= BallWalkTriggerM:
        return
    var mSum2: float64 = 0.0
    var comX2: float64 = 0.0
    var comY2: float64 = 0.0
    var comZ2: float64 = 0.0
    var ci3: int32 = bw.comLo
    while ci3 <= bw.comHi:
        let mass2: float64 = 1.0 / w.bodyInvMass[ci3]
        mSum2 = mSum2 + mass2
        comX2 = comX2 + mass2 * w.bodyPx[ci3]
        comY2 = comY2 + mass2 * w.bodyPy[ci3]
        comZ2 = comZ2 + mass2 * w.bodyPz[ci3]
        ci3 = ci3 + 1
    let dirX2 = comX2 / mSum2 - bx
    let dirY2 = comY2 / mSum2 - by
    let dirZ2 = comZ2 / mSum2 - w.bodyPz[bw.ballSlot]
    let dn2 = numerics.CsgSqrt(dirX2 * dirX2 + dirY2 * dirY2 + dirZ2 * dirZ2)
    if dn2 <= BallWalkDirEps:
        return
    # ball escape speed (horizontal center velocity) drives both adaptive
    # knobs; the legacy path (adaptive = 0) reads it for diagnostics only
    let bvx2 = w.bodyVx[bw.ballSlot]
    let bvy2 = w.bodyVy[bw.ballSlot]
    let vB2 = numerics.CsgSqrt(bvx2 * bvx2 + bvy2 * bvy2)
    bw.lastBallV = vB2
    var windowTicks: int64 = BallWalkWindowTicks
    var reachM: float64 = 0.0
    if bw.adaptive == 1:
        var winF: float64 = float64(BallWalkWindowTicks) / (1.0 + vB2 * bw.winSpeedK)
        if winF < bw.winMinTicks:
            winF = bw.winMinTicks
        if winF > float64(BallWalkWindowTicks):
            winF = float64(BallWalkWindowTicks)
        windowTicks = int64(winF + 0.5)
        reachM = vB2 * bw.reachSpeedK
        if reachM > bw.reachMaxM:
            reachM = bw.reachMaxM
        if reachM < 0.0 - bw.reachMaxM:
            reachM = 0.0 - bw.reachMaxM
    bw.lastWindowTicks = windowTicks
    bw.lastReachM = reachM
    var footSlot2: int32 = bw.footLSlot
    var anchorSlot2: int32 = bw.anchorL
    var ciNew: int32 = bw.conL
    let side: int32 = bw.nextFoot
    if side == 2:
        footSlot2 = bw.footRSlot
        anchorSlot2 = bw.anchorR
        ciNew = bw.conR
    let pad2 = w.bodyRadius[bw.ballSlot] + w.bodyRadius[footSlot2]
    var dirx2: float64 = dirX2 / dn2
    var diry2: float64 = dirY2 / dn2
    var dirz2: float64 = dirZ2 / dn2
    if reachM > 0.0 || reachM < 0.0:
        # signed adaptive step reach: Gram-Schmidt the roll direction onto
        # the tangent plane at the under-CoM surface direction, then walk
        # the anchor along the roll axis by the reach arc (angle =
        # reach / pad, negative = toward the back flank). Positive reach
        # lands the foot AHEAD of the roll (the pump side - measured to
        # accelerate the ball), negative reach sinks it BEHIND (the brake
        # side: a bigger behind-center press lever rho)
        let ux = bvx2 / vB2
        let uy = bvy2 / vB2
        let ud = ux * dirx2 + uy * diry2
        var tx2: float64 = ux - ud * dirx2
        var ty2: float64 = uy - ud * diry2
        var tz2: float64 = 0.0 - ud * dirz2
        let tn2 = numerics.CsgSqrt(tx2 * tx2 + ty2 * ty2 + tz2 * tz2)
        if tn2 > BallWalkDirEps:
            tx2 = tx2 / tn2
            ty2 = ty2 / tn2
            tz2 = tz2 / tn2
            let th2 = reachM / pad2
            let ct2 = m.cosFloat(th2)
            let st2 = m.sinFloat(th2)
            dirx2 = dirx2 * ct2 + tx2 * st2
            diry2 = diry2 * ct2 + ty2 * st2
            dirz2 = dirz2 * ct2 + tz2 * st2
    let ax2 = bx + dirx2 * pad2
    let ay2 = by + diry2 * pad2
    let az2 = w.bodyPz[bw.ballSlot] + dirz2 * pad2
    if anchorSlot2 < 0:
        anchorSlot2 = world3d.World3dSpawnBody(w, ax2, ay2, az2, 0.0, BallWalkAnchorRadiusM, world3d.World3dBodyAnchor)
        if side == 1:
            bw.anchorL = anchorSlot2
        else:
            bw.anchorR = anchorSlot2
    else:
        # persistent tether reuse: rewrite the anchor body field-for-field
        # identically to a fresh spawn (position refreshed, velocity/angular/
        # force columns cleared) - the documented dynamic-recycling semantics
        w.bodyPx[anchorSlot2] = ax2
        w.bodyPy[anchorSlot2] = ay2
        w.bodyPz[anchorSlot2] = az2
        w.bodyVx[anchorSlot2] = 0.0
        w.bodyVy[anchorSlot2] = 0.0
        w.bodyVz[anchorSlot2] = 0.0
        w.bodyAngVx[anchorSlot2] = 0.0
        w.bodyAngVy[anchorSlot2] = 0.0
        w.bodyAngVz[anchorSlot2] = 0.0
        w.bodyFx[anchorSlot2] = 0.0
        w.bodyFy[anchorSlot2] = 0.0
        w.bodyFz[anchorSlot2] = 0.0
    let fx = w.bodyPx[footSlot2]
    let fy = w.bodyPy[footSlot2]
    let fz = w.bodyPz[footSlot2]
    let d0x = ax2 - fx
    let d0y = ay2 - fy
    let d0z = az2 - fz
    let dist0 = numerics.CsgSqrt(d0x * d0x + d0y * d0y + d0z * d0z)
    if ciNew < 0:
        ciNew = world3d.World3dAddConstraint(w, footSlot2, anchorSlot2, dist0, world3d.World3dConStepPull)
        if side == 1:
            bw.conL = ciNew
        else:
            bw.conR = ciNew
    else:
        # persistent rod reuse: field-for-field identical to a fresh add
        w.conA[ciNew] = footSlot2
        w.conB[ciNew] = anchorSlot2
        w.conRest[ciNew] = dist0
        w.conTarget[ciNew] = dist0
        w.conKind[ciNew] = world3d.World3dConStepPull
        w.conActive[ciNew] = 1
    bw.activeFoot = side
    bw.endTick = w.tick + windowTicks
    var floorLen2: float64 = BallWalkPlantLenM
    if dist0 < floorLen2:
        floorLen2 = dist0
    bw.floorLen = floorLen2
    bw.nextFoot = 3 - side
    bw.stepCount = bw.stepCount + 1
    bw.rolledM = 0.0
    bw.lastAnchorX = ax2
    bw.lastAnchorY = ay2
    bw.lastAnchorZ = az2
