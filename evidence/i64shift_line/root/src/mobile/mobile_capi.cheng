    MobileCapiEmitLog("mobile_moq:build_request_after_copy")
    MobileCapiEmitLog("mobile_moq:build_request_before_build")
    var buildRes: MobileMoqBuildResult
    let buildOk = MobileCapiMoqBuildFromRequestWire(BytesView(blobPtr, blobLen), requestWire, buildRes)
    MobileCapiEmitLog("mobile_moq:build_request_after_build")
    if IsErr(buildOk):
        return MobileCapiMoqError(result.Error(buildOk))
    return MobileCapiMoqBuildResultToWire(buildRes)

