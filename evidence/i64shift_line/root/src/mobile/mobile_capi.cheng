fn mobileCapiMoqFountainBuildPersistFileCStringRaw(blobPathRaw: ptr,
                                                     requestWireRaw: ptr): ptr =
    if blobPathRaw == nil:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_missing_blob_path"))
    if requestWireRaw == nil:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_missing_request_wire"))
    let blobPath = bridge.InternalMobileBridgeCopyRawText(blobPathRaw)
    if len(blobPath) <= 0:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_missing_blob_path"))
    let requestWire = bridge.InternalMobileBridgeCopyRawText(requestWireRaw)
    if len(requestWire) <= 0:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_missing_request_wire"))
    let blobText = os.ReadFile(blobPath)
    let blobBytes = MobileCapiOwnedBytesFromText(blobText)
    if BytesLen(blobBytes) <= 0:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_empty_blob"))
    let requestRes = MobileCapiMoqParsePersistRequestWire(requestWire)
    if IsErr(requestRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError(result.Error(requestRes)))
    let persistRes = MobileCapiMoqPersistFromRequest(blobBytes, Value(requestRes))
    if IsErr(persistRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError(result.Error(persistRes)))
    return bridge.InternalMobileBridgeTextCString(Value(persistRes))

fn mobileCapiMoqFountainBuildPersistRequestFileCStringRaw(requestPathRaw: ptr): ptr =
    if requestPathRaw == nil:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_missing_request_path"))
    let requestPath = bridge.InternalMobileBridgeCopyRawText(requestPathRaw)
    if len(requestPath) <= 0:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_missing_request_path"))
    let requestWire = os.ReadFile(requestPath)
    if len(requestWire) <= 0:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_missing_request_wire"))
    let blobPathRes = moq.MoqFountainWireFindValue(requestWire, "blob_path")
    if IsErr(blobPathRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError(result.Error(blobPathRes)))
    let blobText = os.ReadFile(Value(blobPathRes))
    let blobBytes = MobileCapiOwnedBytesFromText(blobText)
    if BytesLen(blobBytes) <= 0:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_empty_blob"))
    let requestRes = MobileCapiMoqParsePersistRequestWire(requestWire)
    if IsErr(requestRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError(result.Error(requestRes)))
    let persistRes = MobileCapiMoqPersistFromRequest(blobBytes, Value(requestRes))
    if IsErr(persistRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError(result.Error(persistRes)))
    return bridge.InternalMobileBridgeTextCString(Value(persistRes))

fn mobileCapiMoqFountainBuildPersistRequestFileBlobCStringRaw(blobPtr: ptr,
                                                                blobLen: int32,
                                                                requestPathRaw: ptr): ptr =
    if blobPtr == nil || blobLen <= 0:
        return bridge.InternalMobileBridgeTextCString(MobileCapiMoqError("moq_fountain_empty_blob"))
    return mobileCapiMoqFountainBuildPersistRequestFileCStringRaw(requestPathRaw)

fn mobileCapiMoqFountainBuildPersistRequestStagedCStringRaw(): ptr =
    let requestPathRaw = bridge.InternalMobileBridgeHostMoqRequestPathRaw()
    return mobileCapiMoqFountainBuildPersistRequestFileCStringRaw(requestPathRaw)

fn mobileCapiMoqFountainBuildPersistStagedCStringRaw(): ptr =
    let blobRaw = bridge.InternalMobileBridgeHostMoqBlobRaw()
    let blobLen = bridge.InternalMobileBridgeHostMoqBlobLen()
    let requestWireRaw = bridge.InternalMobileBridgeHostMoqRequestWireRaw()
    let requestWireLen = bridge.InternalMobileBridgeHostMoqRequestWireLen()
    return mobileCapiMoqFountainBuildPersistRequestCStringRaw(blobRaw, blobLen, requestWireRaw, requestWireLen)

fn MobileCapiMoqDecodeBlockIndexes(csv: str): int32[] =
    let parts = MobileCapiSplitCsv(csv)
    var out: int32[]
    out = []
    var i: int32
    for i in i..<parts.len:
        let part = parts[i]
        let item = MobileCapiTrimAscii(part)
        if len(item) <= 0:
            continue
        add(out, MobileCapiParseInt32Text(item))
    return out

@borrows
fn mobileCapiMoqSolveFindPivot(equations: MobileMoqEquation[],
                                 pivotRow: int32,
                                 col: int32): int32 =
    var row: int32 = pivotRow
    for row in row..<equations.len:
        if equations[row].coeffs[col] != 0:
            return row
    return -1

@borrows
fn mobileCapiMoqCloneInt32Array(values: int32[]): int32[] =
    var out: int32[]
    out = []
    var i: int32
    for i in i..<values.len:
        add(out, values[i])
    return out

fn mobileCapiMoqSolveSwapRows(pivotRow: int32,
                                found: int32,
                                equations: var MobileMoqEquation[]) =
    let leftCoeffs = mobileCapiMoqCloneInt32Array(equations[pivotRow].coeffs)
    let rightCoeffs = mobileCapiMoqCloneInt32Array(equations[found].coeffs)
    let leftPayload = BytesSlice(equations[pivotRow].payload, 0, BytesLen(equations[pivotRow].payload))
    let rightPayload = BytesSlice(equations[found].payload, 0, BytesLen(equations[found].payload))
    equations[pivotRow].coeffs = rightCoeffs
    equations[found].coeffs = leftCoeffs
    equations[pivotRow].payload = rightPayload
    equations[found].payload = leftPayload

fn mobileCapiMoqSolveXorRowInto(row: int32,
                                  pivotRow: int32,
                                  sourceBlockCount: int32,
                                  equations: var MobileMoqEquation[]): Result[bool] =
    var coeffIndex: int32
    for coeffIndex in coeffIndex..<sourceBlockCount:
        equations[row].coeffs[coeffIndex] = equations[row].coeffs[coeffIndex] ^ equations[pivotRow].coeffs[coeffIndex]
    var rowPayload = BytesSlice(equations[row].payload, 0, BytesLen(equations[row].payload))
    let xorOk = MobileCapiXorInto(rowPayload, equations[pivotRow].payload)
    if IsErr(xorOk):
        return xorOk
    equations[row].payload = rowPayload
    return Ok[bool](true)

fn mobileCapiMoqSolveEliminateOthers(pivotRow: int32,
                                       col: int32,
                                       sourceBlockCount: int32,
                                       equations: var MobileMoqEquation[]): Result[bool] =
    var row: int32
    for row in range(equations.len):
        if row != pivotRow:
            if equations[row].coeffs[col] != 0:
                let xorOk = mobileCapiMoqSolveXorRowInto(row, pivotRow, sourceBlockCount, equations)
                if IsErr(xorOk):
                    return xorOk
    return Ok[bool](true)

@borrows
fn mobileCapiMoqSolveFillBlocks(sourceBlockCount: int32,
                                  blockBytes: int32,
                                  pivotCols: int32[],
                                  equations: MobileMoqEquation[]): Bytes[] =
    var solved: Bytes[]
    solved = []
    var i: int32
    for i in i..<sourceBlockCount:
        add(solved, BytesAlloc(blockBytes))
    var row: int32
    for row in row..<sourceBlockCount:
        solved[pivotCols[row]] = BytesSlice(equations[row].payload, 0, BytesLen(equations[row].payload))
    return solved

@borrows
fn mobileCapiMoqCloneEquations(equations0: MobileMoqEquation[]): MobileMoqEquation[] =
    var equations: MobileMoqEquation[]
    equations = []
    var i: int32
    for i in i..<equations0.len:
        add(equations, MobileMoqEquation(
            coeffs: mobileCapiMoqCloneInt32Array(equations0[i].coeffs),
            payload: BytesSlice(equations0[i].payload, 0, BytesLen(equations0[i].payload))
        ))
    return equations

@borrows
fn MobileCapiMoqSolveObject(sourceBlockCount: int32,
                              blockBytes: int32,
                              equations0: MobileMoqEquation[]): Result[Bytes[]] =
    if sourceBlockCount <= 0:
        return Err[Bytes[]]("moq_fountain_invalid_object")
    var equations = mobileCapiMoqCloneEquations(equations0)
    var pivotCols: int32[]
    pivotCols = []
    var pivotRow: int32
    var col: int32
    while col < sourceBlockCount && pivotRow < equations.len:
        let found = mobileCapiMoqSolveFindPivot(equations, pivotRow, col)
        if found >= 0:
            if found != pivotRow:
                mobileCapiMoqSolveSwapRows(pivotRow, found, equations)
            let elimOk = mobileCapiMoqSolveEliminateOthers(pivotRow, col, sourceBlockCount, equations)
            if IsErr(elimOk):
                return Err[Bytes[]](result.Error(elimOk))
            add(pivotCols, col)
            pivotRow = pivotRow + 1
        col = col + 1
    if pivotCols.len < sourceBlockCount:
        return Err[Bytes[]]("moq_fountain_insufficient_droplets")
    return Ok[Bytes[]](mobileCapiMoqSolveFillBlocks(sourceBlockCount, blockBytes, pivotCols, equations))

fn MobileCapiMoqFountainRebuild(requestWire: str): str =
    let outputPathRes = MobileCapiWireDecodedValue(requestWire, "output_path")
    if IsErr(outputPathRes):
        return MobileCapiMoqError(result.Error(outputPathRes))
    let outputPath = Value(outputPathRes)
    let rebuiltRes = moq.MoqFountainRebuildFromWire(requestWire)
    if IsErr(rebuiltRes):
        return MobileCapiMoqError(result.Error(rebuiltRes))
    let rebuilt = Value(rebuiltRes)
    let rebuiltBlob = rebuilt.blob
    let writeRes = bridge.InternalMobileBridgeWriteBytesPath(outputPath, rebuiltBlob)
    if IsErr(writeRes):
        return MobileCapiMoqError(result.Error(writeRes))
    return moq.MoqFountainRebuildResultToWire(outputPath, rebuilt)

