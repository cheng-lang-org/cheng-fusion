fn mobileCapiMoqBuildPersistFill(out: var str,
                                   blobPtr: ptr,
                                   blobLen: int32,
                                   ownerPeerIdRaw: ptr,
                                   remotePeersCsvRaw: ptr,
                                   mimeType0Raw: ptr,
                                   objectTargetBytes0: int32,
                                   sourceBlockBytes0: int32,
                                   repairDropletCount0: int32,
                                   outputDirRaw: ptr,
                                   fileNameStemRaw: ptr): Result[bool] =
    if blobPtr == nil || blobLen <= 0:
        return Err[bool]("moq_fountain_empty_blob")
    let ownerPeerId = bridge.InternalMobileBridgeCopyRawText(ownerPeerIdRaw)
    let remotePeersCsv = bridge.InternalMobileBridgeCopyRawText(remotePeersCsvRaw)
    let mimeType0 = bridge.InternalMobileBridgeCopyRawText(mimeType0Raw)
    let outputDir = bridge.InternalMobileBridgeCopyRawText(outputDirRaw)
    let fileNameStem = bridge.InternalMobileBridgeCopyRawText(fileNameStemRaw)
    if len(outputDir) <= 0:
        return Err[bool]("moq_fountain_missing_output_dir")
    if len(fileNameStem) <= 0:
        return Err[bool]("moq_fountain_missing_file_stem")
    MobileCapiEmitLog("mobile_moq:persist_raw_enter")
