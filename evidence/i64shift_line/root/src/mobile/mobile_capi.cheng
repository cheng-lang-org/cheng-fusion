fn mobileCapiBioDidCreateDiagEnrollCStringRaw(requestIdRaw: ptr,
                                                feature32HexRaw: ptr,
                                                deviceBindingSeedRaw: ptr,
                                                deviceLabelRaw: ptr,
                                                sensorIdRaw: ptr,
                                                hardwareAttestationRaw: ptr): ptr =
    let requestId = bridge.InternalMobileBridgeCopyRawText(requestIdRaw)
    let feature32Hex = bridge.InternalMobileBridgeCopyRawText(feature32HexRaw)
    let deviceBindingSeed = bridge.InternalMobileBridgeCopyRawText(deviceBindingSeedRaw)
    let deviceLabel = bridge.InternalMobileBridgeCopyRawText(deviceLabelRaw)
    let sensorId = bridge.InternalMobileBridgeCopyRawText(sensorIdRaw)
    let hardwareAttestation = bridge.InternalMobileBridgeCopyRawText(hardwareAttestationRaw)
    let captureRes = MobileCapiBioDidCapture(requestId,
                                               feature32Hex,
                                               deviceBindingSeed,
                                               deviceLabel,
                                               sensorId,
                                               hardwareAttestation)
    if IsErr(captureRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(captureRes)))
    let capture = Value(captureRes)
    let attestationOk = bio_did.BioDidCaptureAttestationValidate(capture, "create")
    if IsErr(attestationOk):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(attestationOk)))
    let recordRes = bio.BioEnroll(capture.feature32)
    if IsErr(recordRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(recordRes)))
    return mobileCapiBioDidDiagOkCString("enroll")

fn mobileCapiBioDidCreateDiagRecoverCStringRaw(requestIdRaw: ptr,
                                                 feature32HexRaw: ptr,
                                                 deviceBindingSeedRaw: ptr,
                                                 deviceLabelRaw: ptr,
                                                 sensorIdRaw: ptr,
                                                 hardwareAttestationRaw: ptr): ptr =
    let requestId = bridge.InternalMobileBridgeCopyRawText(requestIdRaw)
    let feature32Hex = bridge.InternalMobileBridgeCopyRawText(feature32HexRaw)
    let deviceBindingSeed = bridge.InternalMobileBridgeCopyRawText(deviceBindingSeedRaw)
    let deviceLabel = bridge.InternalMobileBridgeCopyRawText(deviceLabelRaw)
    let sensorId = bridge.InternalMobileBridgeCopyRawText(sensorIdRaw)
    let hardwareAttestation = bridge.InternalMobileBridgeCopyRawText(hardwareAttestationRaw)
    let captureRes = MobileCapiBioDidCapture(requestId,
                                               feature32Hex,
                                               deviceBindingSeed,
                                               deviceLabel,
                                               sensorId,
                                               hardwareAttestation)
    if IsErr(captureRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(captureRes)))
    let capture = Value(captureRes)
    let attestationOk = bio_did.BioDidCaptureAttestationValidate(capture, "create")
    if IsErr(attestationOk):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(attestationOk)))
    let recordRes = bio.BioEnroll(capture.feature32)
    if IsErr(recordRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(recordRes)))
    let rootSecretRes = bio.BioRecoverRoot(capture.feature32, Value(recordRes).helper)
    if IsErr(rootSecretRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(rootSecretRes)))
    return mobileCapiBioDidDiagOkCString("recover")

fn mobileCapiBioDidCreateDiagIdentityCStringRaw(requestIdRaw: ptr,
                                                  feature32HexRaw: ptr,
                                                  deviceBindingSeedRaw: ptr,
                                                  deviceLabelRaw: ptr,
                                                  sensorIdRaw: ptr,
                                                  hardwareAttestationRaw: ptr): ptr =
    let requestId = bridge.InternalMobileBridgeCopyRawText(requestIdRaw)
    let feature32Hex = bridge.InternalMobileBridgeCopyRawText(feature32HexRaw)
    let deviceBindingSeed = bridge.InternalMobileBridgeCopyRawText(deviceBindingSeedRaw)
    let deviceLabel = bridge.InternalMobileBridgeCopyRawText(deviceLabelRaw)
    let sensorId = bridge.InternalMobileBridgeCopyRawText(sensorIdRaw)
    let hardwareAttestation = bridge.InternalMobileBridgeCopyRawText(hardwareAttestationRaw)
    let captureRes = MobileCapiBioDidCapture(requestId,
                                               feature32Hex,
                                               deviceBindingSeed,
                                               deviceLabel,
                                               sensorId,
                                               hardwareAttestation)
    if IsErr(captureRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(captureRes)))
    let capture = Value(captureRes)
    let attestationOk = bio_did.BioDidCaptureAttestationValidate(capture, "create")
    if IsErr(attestationOk):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(attestationOk)))
    let recordRes = bio.BioEnroll(capture.feature32)
    if IsErr(recordRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(recordRes)))
    let rootSecretRes = bio.BioRecoverRoot(capture.feature32, Value(recordRes).helper)
    if IsErr(rootSecretRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(rootSecretRes)))
    let rootSecret = Value(rootSecretRes)
    let rootSeed = bio_did.BioDidRootSeedFromRootSecret(rootSecret)
    let deviceSeed = bio_did.BioDidDeviceSeedFromRootSecret(rootSecret, capture.deviceBindingSeed)
    let deviceLabelOwned = strings.CloneStr(capture.deviceLabel)
    let identity = did.DidIdentityMake(rootSeed, deviceSeed, deviceLabelOwned, times.EpochTimeSeconds())
    var document: did.DidDocument
    let documentRes = did.DidIdentityDocumentFill(document, identity)
    if IsErr(documentRes):
        return bridge.InternalMobileBridgeTextCString(MobileCapiBioDidErrorJson(result.Error(documentRes)))
    return mobileCapiBioDidDiagOkCString("identity")

fn mobileCapiBioDidCreateDiagCStringRaw(requestIdRaw: ptr,
                                         feature32HexRaw: ptr,
                                         deviceBindingSeedRaw: ptr,
