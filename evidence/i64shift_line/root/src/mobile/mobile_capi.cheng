fn MobileCapiMoqBuildFromRequestWire(blobBytes: Bytes,
                                      requestWire: str,
                                      out: var MobileMoqBuildResult): Result[bool] =
    let ownerPeerIdRes = moq.MoqFountainWireFindValue(requestWire, "owner_peer_id")
    if IsErr(ownerPeerIdRes):
        return Err[bool](result.Error(ownerPeerIdRes))
    let remotePeersCsvRes = moq.MoqFountainWireFindValue(requestWire, "remote_peers_csv")
    if IsErr(remotePeersCsvRes):
        return Err[bool](result.Error(remotePeersCsvRes))
    let mimeTypeRes = moq.MoqFountainWireFindValue(requestWire, "mime_type")
    if IsErr(mimeTypeRes):
        return Err[bool](result.Error(mimeTypeRes))
    let objectTargetBytesRes = moq.MoqFountainParseInt32Wire(requestWire, "object_target_bytes")
    if IsErr(objectTargetBytesRes):
        return Err[bool](result.Error(objectTargetBytesRes))
    let sourceBlockBytesRes = moq.MoqFountainParseInt32Wire(requestWire, "source_block_bytes")
    if IsErr(sourceBlockBytesRes):
        return Err[bool](result.Error(sourceBlockBytesRes))
    let repairDropletCountRes = moq.MoqFountainParseInt32Wire(requestWire, "repair_droplet_count")
    if IsErr(repairDropletCountRes):
        return Err[bool](result.Error(repairDropletCountRes))
    return MobileCapiMoqBuild(out,
                                blobBytes,
                                Value(ownerPeerIdRes),
                                Value(remotePeersCsvRes),
                                Value(mimeTypeRes),
                                Value(objectTargetBytesRes),
                                Value(sourceBlockBytesRes),
                                Value(repairDropletCountRes))

fn MobileCapiMoqFountainBuildRequest(blobText: str,
                                       requestWire: str): str =
    let blobBytes = MobileCapiOwnedBytesFromText(blobText)
    if BytesLen(blobBytes) <= 0:
        return MobileCapiMoqError("moq_fountain_empty_blob")
    var buildRes: MobileMoqBuildResult
    let buildOk = MobileCapiMoqBuildFromRequestWire(blobBytes, requestWire, buildRes)
    if IsErr(buildOk):
        return MobileCapiMoqError(result.Error(buildOk))
    return MobileCapiMoqBuildResultToWire(buildRes)

fn MobileCapiMoqFountainBuildPersist(blobText: str,
                                       ownerPeerId: str,
