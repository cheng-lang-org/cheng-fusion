fn MobileCapiBioDidImportRequestWire(latestBundleText: str,
                                       requestId: str,
                                       feature32Hex: str,
                                       deviceBindingSeed: str,
                                       deviceLabel: str,
                                       sensorId: str,
                                       hardwareAttestation: str): str =
    var out = ""
    out = did.DidStoreAppendLine(out, "latest_bundle_text", MobileCapiTextHex(latestBundleText))
    let createWire = MobileCapiBioDidCreateRequestWire(requestId,
                                                         feature32Hex,
                                                         deviceBindingSeed,
                                                         deviceLabel,
                                                         sensorId,
                                                         hardwareAttestation)
    out = strutils.Join([out, createWire], "")
    return out

@exportc("MobileCapiBioDidImportRequestWire")
fn MobileCapiBioDidImportRequestWire_export(latestBundleText: cstring,
                                             requestId: cstring,
                                             feature32Hex: cstring,
                                             deviceBindingSeed: cstring,
                                             deviceLabel: cstring,
                                             sensorId: cstring,
                                             hardwareAttestation: cstring): cstring =
    return strToCStringTemp(MobileCapiBioDidImportRequestWire(StrFromCStringBorrow(latestBundleText),
                                                              StrFromCStringBorrow(requestId),
                                                              StrFromCStringBorrow(feature32Hex),
                                                              StrFromCStringBorrow(deviceBindingSeed),
                                                              StrFromCStringBorrow(deviceLabel),
                                                              StrFromCStringBorrow(sensorId),
                                                              StrFromCStringBorrow(hardwareAttestation)))

fn MobileCapiBioDidCreate(requestId: str,
                            feature32Hex: str,
                            deviceBindingSeed: str,
                            deviceLabel: str,
                            sensorId: str,
                            hardwareAttestation: str): str =
    let captureRes = MobileCapiBioDidCapture(requestId,
                                               feature32Hex,
                                               deviceBindingSeed,
                                               deviceLabel,
                                               sensorId,
                                               hardwareAttestation)
    if IsErr(captureRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(captureRes))
        return errorText
    let createRes = bio_did.BioDidCreateBundleWithHardwareCapture(Value(captureRes),
                                                                    times.EpochTimeSeconds())
    if IsErr(createRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(createRes))
        return errorText
    let outcome = Value(createRes)
    return MobileCapiBioDidProvisionJson(outcome.document.did,
                                           outcome.identity.rootSeed,
                                           outcome.identity.deviceSeed,
                                           outcome.bundle.documentText,
                                           bio_did.BioDidChainBundleText(outcome.bundle))

