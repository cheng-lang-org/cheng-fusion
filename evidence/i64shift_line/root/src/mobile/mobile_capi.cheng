fn MobileCapiMoqFountainBuildPersistRequest(blobText: str,
                                               requestWire: str): str =
    let blobBytes = MobileCapiOwnedBytesFromText(blobText)
    if BytesLen(blobBytes) <= 0:
        return MobileCapiMoqError("moq_fountain_empty_blob")
    let reqRes = MobileCapiMoqParsePersistRequestWire(requestWire)
