@borrows
fn MobileCapiEmitLog(message: str) =
    bridge.InternalMobileBridgeEmitLog(message)

fn MobileCapiPeerIdFromSeed(seed: str): str =
    var peerValue: types.Libp2pPeerId
    peer_id.Libp2pPeerIdFillFromSeed(peerValue, seed)
    return peer_id.Libp2pPeerIdText(peerValue)

fn MobileCapiDidFromRootSeed(rootSeed: str): str =
    let out = did.DidFromRootSeed(rootSeed)
    return out

fn MobileCapiDidDevicePeerIdFromSeed(deviceSeed: str): str =
    let peerValue = did.DidDevicePeerIdFromSeed(deviceSeed)
    let out = peer_id.Libp2pPeerIdText(peerValue)
    return out

fn MobileCapiPeerIdNormalize(peerText: str): str =
    var peerValue: types.Libp2pPeerId
    let peerRes = peer_id.Libp2pPeerIdFillFromText(peerValue, peerText)
    if IsErr(peerRes):
        return ""
    return peer_id.Libp2pPeerIdText(peerValue)

fn MobileCapiMultiaddrNormalize(addrText: str): str =
    var addr: types.Libp2pMultiaddr
    let addrRes = multiaddr.Libp2pMultiaddrFillFromText(addr, addrText)
    if IsErr(addrRes):
        return ""
    return multiaddr.Libp2pMultiaddrText(addr)

fn MobileCapiDialableAddr(addrText: str, peerText: str): str =
    let base = MobileCapiMultiaddrNormalize(addrText)
    if len(base) <= 0:
        return ""
    let peer = MobileCapiPeerIdNormalize(peerText)
    if len(peer) <= 0:
        return ""
    if strings.StrContains(base, "/p2p/") || strings.StrContains(base, "/ipfs/"):
        return base
    return Fmt"{base}/p2p/{peer}"

@exportc("MobileCapiPeerIdFromSeed")
fn MobileCapiPeerIdFromSeed_export(seed: cstring): cstring =
    return strToCStringTemp(MobileCapiPeerIdFromSeed(StrFromCStringBorrow(seed)))

@exportc("MobileCapiDidFromRootSeed")
fn MobileCapiDidFromRootSeed_export(rootSeed: cstring): cstring =
    return strToCStringTemp(MobileCapiDidFromRootSeed(StrFromCStringBorrow(rootSeed)))

@exportc("MobileCapiDidDevicePeerIdFromSeed")
fn MobileCapiDidDevicePeerIdFromSeed_export(deviceSeed: cstring): cstring =
    return strToCStringTemp(MobileCapiDidDevicePeerIdFromSeed(StrFromCStringBorrow(deviceSeed)))

@exportc("MobileCapiPeerIdNormalize")
fn MobileCapiPeerIdNormalize_export(peerText: cstring): cstring =
    return strToCStringTemp(MobileCapiPeerIdNormalize(StrFromCStringBorrow(peerText)))

@exportc("MobileCapiMultiaddrNormalize")
fn MobileCapiMultiaddrNormalize_export(addrText: cstring): cstring =
    return strToCStringTemp(MobileCapiMultiaddrNormalize(StrFromCStringBorrow(addrText)))

@exportc("MobileCapiDialableAddr")
fn MobileCapiDialableAddr_export(addrText: cstring, peerText: cstring): cstring =
    return strToCStringTemp(MobileCapiDialableAddr(StrFromCStringBorrow(addrText),
                                                   StrFromCStringBorrow(peerText)))

fn MobileCapiBioDidCapture(requestId: str,
                             feature32Hex: str,
                             deviceBindingSeed: str,
                             deviceLabel: str,
                             sensorId: str,
                             hardwareAttestation: str): Result[bio_did.BioDidHardwareCapture] =
    let featureRes: Result[layout.FixedBytes32] = layout.FixedBytes32FromHex(feature32Hex)
    if IsErr(featureRes):
        return Err[bio_did.BioDidHardwareCapture](" mobile capi: invalid fingerprint feature32")
    var capture = bio_did.BioDidHardwareCapture()
    capture.verified = true
    capture.feature32 = Value(featureRes)
    capture.requestId = requestId
    capture.sensorId = sensorId
    capture.deviceBindingSeed = deviceBindingSeed
    capture.deviceLabel = deviceLabel
    capture.hardwareAttestation = hardwareAttestation
    let captureOk = bio_did.BioDidCaptureValidate(capture)
    if IsErr(captureOk):
        return Err[bio_did.BioDidHardwareCapture](result.Error(captureOk))
    return Ok[bio_did.BioDidHardwareCapture](capture)

@borrows
fn MobileCapiTextHex(value: str): str =
    let raw = BytesFromString(value)
    let out = BytesToHex(raw)
    return out

@borrows
fn MobileCapiDecodeWireText(text: str): Result[str] =
    let bytesRes = did.DidStoreDecodeBytes(text)
    if IsErr(bytesRes):
        return Err[str](result.Error(bytesRes))
    let decoded = BytesToString(Value(bytesRes))
    return Ok[str](decoded)

@borrows
fn MobileCapiWireFindValue(wire: str, key: str): Result[str] =
    let prefix = Fmt"{key}="
    var lineStart: int32
    let n = strings.Len(wire)
    while lineStart < n:
        var lineEnd = lineStart
        while lineEnd < n:
            if wire[lineEnd] == '\n':
                break
            lineEnd = lineEnd + 1
        var line = ""
        if lineEnd > lineStart:
            line = strutils.SliceStr(wire, lineStart, lineEnd - 1)
        if strutils.StartsWith(line, prefix):
            return Ok[str](strutils.SliceStr(line, strings.Len(prefix), strings.Len(line) - 1))
        lineStart = lineEnd + 1
    return Err[str](Fmt" mobile capi: missing wire field {key}")

@borrows
fn MobileCapiWireDecodedValue(wire: str, key: str): Result[str] =
    let rawRes = MobileCapiWireFindValue(wire, key)
    if IsErr(rawRes):
        return Err[str](result.Error(rawRes))
    let decodedRes = MobileCapiDecodeWireText(Value(rawRes))
    return decodedRes

@borrows
fn MobileCapiBioDidErrorJson(errorText: str): str =
    var out = ""
    out = did.DidStoreAppendLine(out, "ok", "0")
    out = did.DidStoreAppendLine(out, "error", errorText)
    return out

@borrows
fn MobileCapiTextBufferHandle(text: str): uint64 =
    let raw = BytesFromString(text)
    let textLen = BytesLen(raw)
    let rawData = raw.data
    if textLen <= 0 || rawData == nil:
        return uint64(0)
    MobileCapiEmitLog("mobile_moq:text_buffer_handle_before_bridge")
    let handle = bridge.InternalMobileBridgeBufferHandleCopy(rawData, textLen)
    MobileCapiEmitLog("mobile_moq:text_buffer_handle_after_bridge")
    return handle

@borrows
fn MobileCapiBytesBufferHandle(payload: Bytes): uint64 =
    let payloadLen = BytesLen(payload)
    if payloadLen <= 0:
        return uint64(0)
    let payloadData = payload.data
    if payloadData == nil:
        return uint64(0)
    return bridge.InternalMobileBridgeBufferHandleCopy(payloadData, payloadLen)

type MobileMoqDroplet =
    objectIndex: int32
    dropletIndex: int32
    kindCode: int32
    key: str
    peerId: str
    cid: str
    degree: int32
    blockIndexes: int32[]
    payload: Bytes

type MobileMoqObject =
    objectIndex: int32
    groupId: str
    objectId: str
    priority: int32
    byteOffset: int32
    byteLength: int32
    objectCid: str
    sourceBlockBytes: int32
    sourceBlockCount: int32
    repairDropletCount: int32
    droplets: MobileMoqDroplet[]

type MobileMoqEquation =
    coeffs: int32[]
    payload: Bytes

type MobileCapiMoqPersistRequest =
    ownerPeerId: str
    remotePeersCsv: str
    mimeType: str
    objectTargetBytes: int32
    sourceBlockBytes: int32
    repairDropletCount: int32
    outputDir: str
    fileNameStem: str

type MobileMoqBuildResult =
    ownerPeerId: str
    mimeType: str
    bundleCid: str
    blobCid: str
    catalogKey: str
    catalogCid: str
    catalogSizeBytes: int32
    catalogPayloadText: str
    catalogPayload: Bytes
    rebuildTemplateKey: str
    rebuildTemplateCid: str
    rebuildTemplateSizeBytes: int32
    rebuildTemplatePayloadText: str
    rebuildTemplatePayload: Bytes
    blobByteLen: int32
    objectTargetBytes: int32
    sourceBlockBytes: int32
    objectCount: int32
    remoteAckPeerIds: str[]
    objects: MobileMoqObject[]
    droplets: MobileMoqDroplet[]

const MobileMoqCatalogMagic = "unimaker.moq.fountain.catalog.v1"
const MobileMoqTransport = "moq"
const MobileMoqLayout = "lt_xor_v1"
const MobileMoqDropletKindSource = 1
const MobileMoqDropletKindRepair = 2

@borrows
fn MobileCapiByteBufAppendText(buf: var layout.ByteBuf, text: str) =
    if len(text) <= 0:
        return
    let data = BytesFromString(text)
    layout.ByteBufAppendBytes(buf, data)

@borrows
fn mobileCapiWireBufAppendRaw(buf: var layout.ByteBuf, key: str, value: str) =
    MobileCapiByteBufAppendText(buf, key)
    layout.ByteBufAppendByte(buf, int32('='))
    MobileCapiByteBufAppendText(buf, value)
    layout.ByteBufAppendByte(buf, int32('\n'))

@borrows
fn MobileCapiWireBufAppendInt(buf: var layout.ByteBuf, key: str, value: int32) =
    mobileCapiWireBufAppendRaw(buf, key, strings.IntToStr(value))

@borrows
fn MobileCapiWireRow(key: str, value: str): str =
    var buf = layout.ByteBufInit(len(key) + len(value) + 1)
    MobileCapiByteBufAppendText(buf, key)
    layout.ByteBufAppendByte(buf, int32('='))
    MobileCapiByteBufAppendText(buf, value)
    return BytesToString(layout.ByteBufToBytes(buf))

@borrows
fn MobileCapiWireRowInt(key: str, value: int32): str =
    return MobileCapiWireRow(key, strings.IntToStr(value))

@borrows
fn MobileCapiWireRowUint64(key: str, value: uint64): str =
    return MobileCapiWireRow(key, strings.Uint64ToStr(value))

@borrows
fn MobileCapiPrefixedWireKey(prefix: str, fieldName: str): str =
    return Fmt"{prefix}{fieldName}"

@borrows
fn MobileCapiWireRowPrefixed(prefix: str, fieldName: str, value: str): str =
    return MobileCapiWireRow(MobileCapiPrefixedWireKey(prefix, fieldName), value)

@borrows
fn MobileCapiWireRowIntPrefixed(prefix: str, fieldName: str, value: int32): str =
    return MobileCapiWireRowInt(MobileCapiPrefixedWireKey(prefix, fieldName), value)

@borrows
fn MobileCapiWireRowUint64Prefixed(prefix: str, fieldName: str, value: uint64): str =
    return MobileCapiWireRowUint64(MobileCapiPrefixedWireKey(prefix, fieldName), value)

@borrows
fn MobileCapiWireRowsText(rows: str[]): str =
    if rows.len <= 0:
        return ""
    var cap: int32
    var rowLen: int32
    for rowLen in rowLen..<rows.len:
        cap = cap + len(rows[rowLen]) + 1
    var buf = layout.ByteBufInit(cap)
    var row: int32
    for row in row..<rows.len:
        MobileCapiByteBufAppendText(buf, rows[row])
        layout.ByteBufAppendByte(buf, int32('\n'))
    return BytesToString(layout.ByteBufToBytes(buf))

@borrows
fn MobileCapiWireRowsResult(rows: str[], errorText: str): Result[str] =
    let out = MobileCapiWireRowsText(rows)
    if len(out) <= 0:
        return Err[str](errorText)
    return Ok[str](out)

@borrows
fn MobileCapiWireMergeRows(baseWire: str, extraRows: str[], errorText: str): Result[str] =
    let suffixRes = MobileCapiWireRowsResult(extraRows, errorText)
    if IsErr(suffixRes):
        return Err[str](result.Error(suffixRes))
    let suffix = Value(suffixRes)
    if len(baseWire) <= 0:
        return Ok[str](suffix)
    if baseWire[len(baseWire) - 1] == '\n':
        var buf = layout.ByteBufInit(len(baseWire) + len(suffix))
        MobileCapiByteBufAppendText(buf, baseWire)
        MobileCapiByteBufAppendText(buf, suffix)
        return Ok[str](BytesToString(layout.ByteBufToBytes(buf)))
    var buf = layout.ByteBufInit(len(baseWire) + len(suffix) + 1)
    MobileCapiByteBufAppendText(buf, baseWire)
    layout.ByteBufAppendByte(buf, int32('\n'))
    MobileCapiByteBufAppendText(buf, suffix)
    return Ok[str](BytesToString(layout.ByteBufToBytes(buf)))

fn MobileCapiMoqDropletKindText(kindCode: int32): str =
    if kindCode == MobileMoqDropletKindSource:
        return "source"
    if kindCode == MobileMoqDropletKindRepair:
        return "repair"
    return "unknown"

@borrows
fn MobileCapiMoqError(errorText: str): str =
    var rows: str[]
    rows = []
    add(rows, MobileCapiWireRow("ok", "0"))
    add(rows, MobileCapiWireRow("error", errorText))
    return MobileCapiWireRowsText(rows)

@borrows
fn MobileCapiPathJoin(dirPath: str, fileName: str): str =
    if len(dirPath) <= 0:
        var fileOnly = layout.ByteBufInit(len(fileName))
        MobileCapiByteBufAppendText(fileOnly, fileName)
        return BytesToString(layout.ByteBufToBytes(fileOnly))
    let needSep = dirPath[len(dirPath) - 1] != '/'
    var buf = layout.ByteBufInit(len(dirPath) + len(fileName) + if needSep: 1 else: 0)
    MobileCapiByteBufAppendText(buf, dirPath)
    if needSep:
        layout.ByteBufAppendByte(buf, int32('/'))
    MobileCapiByteBufAppendText(buf, fileName)
    return BytesToString(layout.ByteBufToBytes(buf))

@borrows
fn MobileCapiPathJoinStemSuffix(dirPath: str, fileNameStem: str, suffix: str): str =
    if len(dirPath) <= 0:
        var fileBuf = layout.ByteBufInit(len(fileNameStem) + len(suffix))
        MobileCapiByteBufAppendText(fileBuf, fileNameStem)
        MobileCapiByteBufAppendText(fileBuf, suffix)
        return BytesToString(layout.ByteBufToBytes(fileBuf))
    let needSep = dirPath[len(dirPath) - 1] != '/'
    var buf = layout.ByteBufInit(len(dirPath) + len(fileNameStem) + len(suffix) + if needSep: 1 else: 0)
    MobileCapiByteBufAppendText(buf, dirPath)
    if needSep:
        layout.ByteBufAppendByte(buf, int32('/'))
    MobileCapiByteBufAppendText(buf, fileNameStem)
    MobileCapiByteBufAppendText(buf, suffix)
    return BytesToString(layout.ByteBufToBytes(buf))

@borrows
fn MobileCapiDropletFileSuffix(objectIndex: int32,
                                 dropletIndex: int32): str =
    let objectText = strings.IntToStr(objectIndex)
    let dropletText = strings.IntToStr(dropletIndex)
    let cap = len(objectText) + len(dropletText) + 10
    var buf = layout.ByteBufInit(cap)
    layout.ByteBufAppendByte(buf, int32('.'))
    MobileCapiByteBufAppendText(buf, objectText)
    layout.ByteBufAppendByte(buf, int32('.'))
    MobileCapiByteBufAppendText(buf, dropletText)
    MobileCapiByteBufAppendText(buf, ".droplet")
    return BytesToString(layout.ByteBufToBytes(buf))

@borrows
fn MobileCapiDropletKindFileSuffix(objectIndex: int32,
                                     kindText: str,
                                     dropletIndex: int32): str =
    let objectText = strings.IntToStr(objectIndex)
    let dropletText = strings.IntToStr(dropletIndex)
    let cap = len(objectText) + len(kindText) + len(dropletText) + 11
    var buf = layout.ByteBufInit(cap)
    layout.ByteBufAppendByte(buf, int32('.'))
    MobileCapiByteBufAppendText(buf, objectText)
    layout.ByteBufAppendByte(buf, int32('.'))
    MobileCapiByteBufAppendText(buf, kindText)
    layout.ByteBufAppendByte(buf, int32('.'))
    MobileCapiByteBufAppendText(buf, dropletText)
    MobileCapiByteBufAppendText(buf, ".droplet")
    return BytesToString(layout.ByteBufToBytes(buf))

@borrows
fn MobileCapiIndexedFieldKey(groupName: str,
                               itemIndex: int32,
                               fieldName: str): str =
    let indexText = strings.IntToStr(itemIndex)
    let cap = len(groupName) + len(indexText) + len(fieldName) + 2
    var buf = layout.ByteBufInit(cap)
    MobileCapiByteBufAppendText(buf, groupName)
    layout.ByteBufAppendByte(buf, int32('.'))
    MobileCapiByteBufAppendText(buf, indexText)
    layout.ByteBufAppendByte(buf, int32('.'))
    MobileCapiByteBufAppendText(buf, fieldName)
    return BytesToString(layout.ByteBufToBytes(buf))

@borrows
fn MobileCapiWriteBytesFile(path: str, payload: Bytes): Result[bool] =
    return bridge.InternalMobileBridgeWriteBytesFile(path, payload)

@borrows
fn MobileCapiAppendBytesFile(path: str, payload: Bytes): Result[bool] =
    return bridge.InternalMobileBridgeAppendBytesFile(path, payload)

@borrows
fn MobileCapiWriteTraceLine(path: str, line: str): Result[bool] =
    let payload = BytesFromString(Fmt"{line}\n")
    return MobileCapiAppendBytesFile(path, payload)

@borrows
fn MobileCapiMaybeWriteTraceLine(path: str, line: str) =
    if len(path) <= 0:
        return
    let _trace = MobileCapiWriteTraceLine(path, line)

@borrows
fn MobileCapiMoqPersistWireObjectRows(objects: MobileMoqObject[]): str[] =
    var rows: str[]
    rows = []
    var objectRow: int32
    for objectRow in objectRow..<objects.len:
        let prefix = Fmt"object.{strings.IntToStr(objectRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", objects[objectRow].objectIndex))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "source_block_bytes", objects[objectRow].sourceBlockBytes))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "repair_droplet_count", objects[objectRow].repairDropletCount))
    return rows

@borrows
fn MobileCapiMoqPersistWireDropletText(droplets: MobileMoqDroplet[],
                                        outputDir: str,
                                        fileNameStem: str): Result[str] =
    var rows: str[]
    rows = []
    var dropletRow: int32
    for dropletRow in dropletRow..<droplets.len:
        let dropletPath = MobileCapiPathJoinStemSuffix(outputDir,
                                                         fileNameStem,
                                                         MobileCapiDropletFileSuffix(droplets[dropletRow].objectIndex,
                                                                                      droplets[dropletRow].dropletIndex))
        let dropletWriteRes = MobileCapiWriteBytesFile(dropletPath, droplets[dropletRow].payload)
        if IsErr(dropletWriteRes):
            return Err[str](result.Error(dropletWriteRes))
        let prefix = Fmt"droplet.{strings.IntToStr(dropletRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", droplets[dropletRow].objectIndex))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "droplet_index", droplets[dropletRow].dropletIndex))
        add(rows, MobileCapiWireRowPrefixed(prefix, "key", droplets[dropletRow].key))
        add(rows, MobileCapiWireRowPrefixed(prefix, "peer_id", droplets[dropletRow].peerId))
        add(rows, MobileCapiWireRowPrefixed(prefix, "cid", droplets[dropletRow].cid))
        add(rows, MobileCapiWireRowPrefixed(prefix, "block_indexes", MobileCapiJoinIntCsv(droplets[dropletRow].blockIndexes)))
        add(rows, MobileCapiWireRowPrefixed(prefix, "path", dropletPath))
    return MobileCapiWireRowsResult(rows, "moq_fountain_empty_persist_droplet_rows")

@borrows
fn MobileCapiMoqBuildPersistWire(buildResult: MobileMoqBuildResult,
                                   outputDir: str,
                                   fileNameStem: str): Result[str] =
    MobileCapiEmitLog("mobile_moq:build_persist_wire_enter")
    let catalogPath = MobileCapiPathJoinStemSuffix(outputDir, fileNameStem, ".catalog.json")
    if strings.Len(buildResult.catalogPayloadText) <= 0:
        return Err[str]("moq_fountain_empty_catalog_payload")
    let catalogWriteRes = MobileCapiWriteBytesFile(catalogPath, BytesFromString(buildResult.catalogPayloadText))
    if IsErr(catalogWriteRes):
        return Err[str](result.Error(catalogWriteRes))
    let rebuildPath = MobileCapiPathJoinStemSuffix(outputDir, fileNameStem, ".rebuild.txt")
    if strings.Len(buildResult.rebuildTemplatePayloadText) <= 0:
        return Err[str]("moq_fountain_empty_rebuild_template")
    let rebuildWriteRes = MobileCapiWriteBytesFile(rebuildPath, BytesFromString(buildResult.rebuildTemplatePayloadText))
    if IsErr(rebuildWriteRes):
        return Err[str](result.Error(rebuildWriteRes))
    var rows: str[]
    rows = []
    add(rows, MobileCapiWireRow("ok", "1"))
    add(rows, MobileCapiWireRow("owner_peer_id", buildResult.ownerPeerId))
    add(rows, MobileCapiWireRow("mime_type", buildResult.mimeType))
    add(rows, MobileCapiWireRow("bundle_cid", buildResult.bundleCid))
    add(rows, MobileCapiWireRow("blob_cid", buildResult.blobCid))
    add(rows, MobileCapiWireRow("catalog_key", buildResult.catalogKey))
    add(rows, MobileCapiWireRow("catalog_cid", buildResult.catalogCid))
    add(rows, MobileCapiWireRowInt("catalog_size_bytes", buildResult.catalogSizeBytes))
    add(rows, MobileCapiWireRow("catalog_path", catalogPath))
    add(rows, MobileCapiWireRow("rebuild_template_key", buildResult.rebuildTemplateKey))
    add(rows, MobileCapiWireRow("rebuild_template_cid", buildResult.rebuildTemplateCid))
    add(rows, MobileCapiWireRowInt("rebuild_template_size_bytes", buildResult.rebuildTemplateSizeBytes))
    add(rows, MobileCapiWireRow("rebuild_template_path", rebuildPath))
    add(rows, MobileCapiWireRowInt("blob_byte_len", buildResult.blobByteLen))
    add(rows, MobileCapiWireRowInt("object_target_bytes", buildResult.objectTargetBytes))
    add(rows, MobileCapiWireRowInt("source_block_bytes", buildResult.sourceBlockBytes))
    add(rows, MobileCapiWireRowInt("object_count", buildResult.objectCount))
    add(rows, MobileCapiWireRow("remote_ack_peer_ids", MobileCapiJoinCsv(buildResult.remoteAckPeerIds)))
    let objectRows = MobileCapiMoqPersistWireObjectRows(buildResult.objects)
    var objectRow: int32
    for objectRow in objectRow..<objectRows.len:
        add(rows, strings.CloneStr(objectRows[objectRow]))
    add(rows, MobileCapiWireRowInt("droplet_count", buildResult.droplets.len))
    let headerText = MobileCapiWireRowsText(rows)
    let dropletTextRes = MobileCapiMoqPersistWireDropletText(buildResult.droplets, outputDir, fileNameStem)
    if IsErr(dropletTextRes):
        return Err[str](result.Error(dropletTextRes))
    var extra: str[]
    extra = []
    add(extra, Value(dropletTextRes))
    return MobileCapiWireMergeRows(headerText, extra, "moq_fountain_empty_persist_wire")

@borrows
fn MobileCapiMoqWriteCoreDropletFile(coreResult: moq.MoqFountainBuildResult,
                                      outputDir: str,
                                      fileNameStem: str,
                                      dropletRow: int32): Result[str] =
    let dropletPath = MobileCapiPathJoinStemSuffix(outputDir,
                                                     fileNameStem,
                                                     MobileCapiDropletFileSuffix(coreResult.droplets[dropletRow].objectIndex,
                                                                                  coreResult.droplets[dropletRow].dropletIndex))
    let dropletWriteRes = MobileCapiWriteBytesFile(dropletPath, coreResult.droplets[dropletRow].payload)
    if IsErr(dropletWriteRes):
        return Err[str](result.Error(dropletWriteRes))
    return Ok[str](dropletPath)

@borrows
fn MobileCapiMoqPersistWireCoreObjectRows(objects: moq.MoqFountainObject[]): str[] =
    var rows: str[]
    rows = []
    var objectRow: int32
    for objectRow in objectRow..<objects.len:
        let prefix = Fmt"object.{strings.IntToStr(objectRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", objects[objectRow].objectIndex))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "source_block_bytes", objects[objectRow].sourceBlockBytes))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "repair_droplet_count", objects[objectRow].repairDropletCount))
    return rows

@borrows
fn MobileCapiMoqPersistWireCoreDropletText(coreResult: moq.MoqFountainBuildResult,
                                            outputDir: str,
                                            fileNameStem: str): Result[str] =
    var rows: str[]
    rows = []
    var dropletRow: int32
    for dropletRow in dropletRow..<coreResult.droplets.len:
        let pathRes = MobileCapiMoqWriteCoreDropletFile(coreResult, outputDir, fileNameStem, dropletRow)
        if IsErr(pathRes):
            return Err[str](result.Error(pathRes))
        let prefix = Fmt"droplet.{strings.IntToStr(dropletRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", coreResult.droplets[dropletRow].objectIndex))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "droplet_index", coreResult.droplets[dropletRow].dropletIndex))
        add(rows, MobileCapiWireRowPrefixed(prefix, "key", coreResult.droplets[dropletRow].key))
        add(rows, MobileCapiWireRowPrefixed(prefix, "peer_id", coreResult.droplets[dropletRow].peerId))
        add(rows, MobileCapiWireRowPrefixed(prefix, "cid", coreResult.droplets[dropletRow].cid))
        add(rows, MobileCapiWireRowPrefixed(prefix, "block_indexes", MobileCapiJoinIntCsv(coreResult.droplets[dropletRow].blockIndexes)))
        add(rows, MobileCapiWireRowPrefixed(prefix, "path", Value(pathRes)))
    return MobileCapiWireRowsResult(rows, "moq_fountain_empty_persist_wire_core_droplets")

@borrows
fn MobileCapiMoqBuildPersistWireCore(coreResult: moq.MoqFountainBuildResult,
                                       outputDir: str,
                                       fileNameStem: str): Result[str] =
    let catalogPath = MobileCapiPathJoinStemSuffix(outputDir, fileNameStem, ".catalog.json")
    let catalogWriteRes = MobileCapiWriteBytesFile(catalogPath, coreResult.catalogPayload)
    if IsErr(catalogWriteRes):
        return Err[str](result.Error(catalogWriteRes))
    let rebuildPath = MobileCapiPathJoinStemSuffix(outputDir, fileNameStem, ".rebuild.txt")
    let rebuildWriteRes = MobileCapiWriteBytesFile(rebuildPath, coreResult.rebuildTemplatePayload)
    if IsErr(rebuildWriteRes):
        return Err[str](result.Error(rebuildWriteRes))
    var rows: str[]
    rows = []
    add(rows, MobileCapiWireRow("ok", "1"))
    add(rows, MobileCapiWireRow("owner_peer_id", coreResult.ownerPeerId))
    add(rows, MobileCapiWireRow("mime_type", coreResult.mimeType))
    add(rows, MobileCapiWireRow("bundle_cid", coreResult.bundleCid))
    add(rows, MobileCapiWireRow("blob_cid", coreResult.blobCid))
    add(rows, MobileCapiWireRow("catalog_key", coreResult.catalogKey))
    add(rows, MobileCapiWireRow("catalog_cid", coreResult.catalogCid))
    add(rows, MobileCapiWireRowInt("catalog_size_bytes", coreResult.catalogSizeBytes))
    add(rows, MobileCapiWireRow("catalog_path", catalogPath))
    add(rows, MobileCapiWireRow("rebuild_template_key", coreResult.rebuildTemplateKey))
    add(rows, MobileCapiWireRow("rebuild_template_cid", coreResult.rebuildTemplateCid))
    add(rows, MobileCapiWireRowInt("rebuild_template_size_bytes", coreResult.rebuildTemplateSizeBytes))
    add(rows, MobileCapiWireRow("rebuild_template_path", rebuildPath))
    add(rows, MobileCapiWireRowInt("blob_byte_len", coreResult.blobByteLen))
    add(rows, MobileCapiWireRowInt("object_target_bytes", coreResult.objectTargetBytes))
    add(rows, MobileCapiWireRowInt("source_block_bytes", coreResult.sourceBlockBytes))
    add(rows, MobileCapiWireRowInt("object_count", coreResult.objectCount))
    add(rows, MobileCapiWireRow("remote_ack_peer_ids", MobileCapiJoinCsv(coreResult.remoteAckPeerIds)))
    let objectRows = MobileCapiMoqPersistWireCoreObjectRows(coreResult.objects)
    var objectRow: int32
    for objectRow in objectRow..<objectRows.len:
        add(rows, strings.CloneStr(objectRows[objectRow]))
    add(rows, MobileCapiWireRowInt("droplet_count", coreResult.droplets.len))
    let headerText = MobileCapiWireRowsText(rows)
    let dropletTextRes = MobileCapiMoqPersistWireCoreDropletText(coreResult, outputDir, fileNameStem)
    if IsErr(dropletTextRes):
        return Err[str](result.Error(dropletTextRes))
    var extra: str[]
    extra = []
    add(extra, Value(dropletTextRes))
    return MobileCapiWireMergeRows(headerText, extra, "moq_fountain_empty_persist_wire_core")

@borrows
fn MobileCapiMoqWriteWireHexFile(requestWire: str, key: str, path: str): Result[bool] =
    let hexRes = moq.MoqFountainWireFindValue(requestWire, key)
    if IsErr(hexRes):
        return Err[bool](result.Error(hexRes))
    let payloadRes = moq.MoqFountainBytesFromHex(Value(hexRes))
    if IsErr(payloadRes):
        return Err[bool](result.Error(payloadRes))
    return MobileCapiWriteBytesFile(path, Value(payloadRes))

@borrows
fn MobileCapiMoqPersistDropletPathRow(requestWire: str,
                                       outputDir: str,
                                       fileNameStem: str,
                                       dropletRow: int32): Result[str] =
    let prefix = Fmt"droplet.{strings.IntToStr(dropletRow)}."
    let objectIndexRes = moq.MoqFountainParseInt32Wire(requestWire, Fmt"{prefix}object_index")
    if IsErr(objectIndexRes):
        return Err[str](result.Error(objectIndexRes))
    let dropletIndexRes = moq.MoqFountainParseInt32Wire(requestWire, Fmt"{prefix}droplet_index")
    if IsErr(dropletIndexRes):
        return Err[str](result.Error(dropletIndexRes))
    let kindRes = moq.MoqFountainWireFindValue(requestWire, Fmt"{prefix}kind")
    if IsErr(kindRes):
        return Err[str](result.Error(kindRes))
    let dropletPath = MobileCapiPathJoinStemSuffix(outputDir,
                                                     fileNameStem,
                                                     MobileCapiDropletKindFileSuffix(Value(objectIndexRes),
                                                                                      Value(kindRes),
                                                                                      Value(dropletIndexRes)))
    let writeRes = MobileCapiMoqWriteWireHexFile(requestWire, Fmt"{prefix}payload_hex", dropletPath)
    if IsErr(writeRes):
        return Err[str](result.Error(writeRes))
    return Ok[str](MobileCapiWireRowPrefixed(prefix, "path", dropletPath))

@borrows
fn MobileCapiMoqPersistExtraRows(requestWire: str,
                                  outputDir: str,
                                  fileNameStem: str,
                                  catalogPath: str,
                                  rebuildPath: str): Result[str[]] =
    let dropletCountRes = moq.MoqFountainParseInt32Wire(requestWire, "droplet_count")
    if IsErr(dropletCountRes):
        return Err[str[]](result.Error(dropletCountRes))
    var extraRows: str[]
    extraRows = []
    add(extraRows, MobileCapiWireRow("catalog_path", catalogPath))
    add(extraRows, MobileCapiWireRow("rebuild_template_path", rebuildPath))
    var dropletRow: int32
    let dropletCount = Value(dropletCountRes)
    for dropletRow in dropletRow..<dropletCount:
        let rowRes = MobileCapiMoqPersistDropletPathRow(requestWire, outputDir, fileNameStem, dropletRow)
        if IsErr(rowRes):
            return Err[str[]](result.Error(rowRes))
        add(extraRows, Value(rowRes))
    return Ok[str[]](extraRows)

@borrows
fn MobileCapiMoqPersistWire(requestWire: str,
                              outputDir: str,
                              fileNameStem: str): Result[str] =
    if len(outputDir) <= 0:
        return Err[str]("moq_fountain_missing_output_dir")
    if len(fileNameStem) <= 0:
        return Err[str]("moq_fountain_missing_file_stem")
    let catalogPath = MobileCapiPathJoinStemSuffix(outputDir, fileNameStem, ".catalog.json")
    let catalogWriteRes = MobileCapiMoqWriteWireHexFile(requestWire, "catalog_payload_hex", catalogPath)
    if IsErr(catalogWriteRes):
        return Err[str](result.Error(catalogWriteRes))
    let rebuildPath = MobileCapiPathJoinStemSuffix(outputDir, fileNameStem, ".rebuild.txt")
    let rebuildWriteRes = MobileCapiMoqWriteWireHexFile(requestWire, "rebuild_template_payload_hex", rebuildPath)
    if IsErr(rebuildWriteRes):
        return Err[str](result.Error(rebuildWriteRes))
    let extraRowsRes = MobileCapiMoqPersistExtraRows(requestWire, outputDir, fileNameStem, catalogPath, rebuildPath)
    if IsErr(extraRowsRes):
        return Err[str](result.Error(extraRowsRes))
    return MobileCapiWireMergeRows(requestWire, Value(extraRowsRes), "moq_fountain_empty_persist_wire")

@borrows
fn MobileCapiMoqHandleObjectWire(buildResult: var MobileMoqBuildResult): str =
    var rows: str[]
    rows = []
    var objectRow: int32
    for objectRow in objectRow..<buildResult.objects.len:
        let prefix = Fmt"object.{strings.IntToStr(objectRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", buildResult.objects[objectRow].objectIndex))
        add(rows, MobileCapiWireRowPrefixed(prefix, "group_id", buildResult.objects[objectRow].groupId))
        add(rows, MobileCapiWireRowPrefixed(prefix, "object_id", buildResult.objects[objectRow].objectId))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "priority", buildResult.objects[objectRow].priority))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "byte_offset", buildResult.objects[objectRow].byteOffset))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "byte_length", buildResult.objects[objectRow].byteLength))
        add(rows, MobileCapiWireRowPrefixed(prefix, "object_cid", buildResult.objects[objectRow].objectCid))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "source_block_bytes", buildResult.objects[objectRow].sourceBlockBytes))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "source_block_count", buildResult.objects[objectRow].sourceBlockCount))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "repair_droplet_count", buildResult.objects[objectRow].repairDropletCount))
    return MobileCapiWireRowsText(rows)

@borrows
fn MobileCapiMoqHandleDropletWire(buildResult: var MobileMoqBuildResult): str =
    var rows: str[]
    rows = []
    add(rows, MobileCapiWireRowInt("droplet_count", buildResult.droplets.len))
    var dropletRow: int32
    for dropletRow in dropletRow..<buildResult.droplets.len:
        let dropletPrefix = Fmt"droplet.{strings.IntToStr(dropletRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(dropletPrefix, "object_index", buildResult.droplets[dropletRow].objectIndex))
        add(rows, MobileCapiWireRowIntPrefixed(dropletPrefix, "droplet_index", buildResult.droplets[dropletRow].dropletIndex))
        add(rows, MobileCapiWireRowPrefixed(dropletPrefix, "kind", MobileCapiMoqDropletKindText(buildResult.droplets[dropletRow].kindCode)))
        add(rows, MobileCapiWireRowPrefixed(dropletPrefix, "key", buildResult.droplets[dropletRow].key))
        add(rows, MobileCapiWireRowPrefixed(dropletPrefix, "peer_id", buildResult.droplets[dropletRow].peerId))
        add(rows, MobileCapiWireRowPrefixed(dropletPrefix, "cid", buildResult.droplets[dropletRow].cid))
        add(rows, MobileCapiWireRowIntPrefixed(dropletPrefix, "degree", buildResult.droplets[dropletRow].degree))
        add(rows, MobileCapiWireRowPrefixed(dropletPrefix, "block_indexes", MobileCapiJoinIntCsv(buildResult.droplets[dropletRow].blockIndexes)))
        add(rows, MobileCapiWireRowUint64Prefixed(dropletPrefix, "handle", MobileCapiBytesBufferHandle(buildResult.droplets[dropletRow].payload)))
    return MobileCapiWireRowsText(rows)

@borrows
fn MobileCapiMoqBuildHandleWire(buildResult: var MobileMoqBuildResult): str =
    var rows: str[]
    rows = []
    add(rows, MobileCapiWireRow("ok", "1"))
    add(rows, MobileCapiWireRow("owner_peer_id", buildResult.ownerPeerId))
    add(rows, MobileCapiWireRow("mime_type", buildResult.mimeType))
    add(rows, MobileCapiWireRow("bundle_cid", buildResult.bundleCid))
    add(rows, MobileCapiWireRow("blob_cid", buildResult.blobCid))
    add(rows, MobileCapiWireRow("catalog_key", buildResult.catalogKey))
    add(rows, MobileCapiWireRow("catalog_cid", buildResult.catalogCid))
    add(rows, MobileCapiWireRowInt("catalog_size_bytes", buildResult.catalogSizeBytes))
    let catalogHandle = MobileCapiTextBufferHandle(buildResult.catalogPayloadText)
    if catalogHandle == uint64(0):
        return MobileCapiMoqError("moq_fountain_empty_catalog_payload")
    add(rows, MobileCapiWireRowUint64("catalog_handle", catalogHandle))
    add(rows, MobileCapiWireRow("rebuild_template_key", buildResult.rebuildTemplateKey))
    add(rows, MobileCapiWireRow("rebuild_template_cid", buildResult.rebuildTemplateCid))
    add(rows, MobileCapiWireRowInt("rebuild_template_size_bytes", buildResult.rebuildTemplateSizeBytes))
    let rebuildTemplateHandle = MobileCapiTextBufferHandle(buildResult.rebuildTemplatePayloadText)
    if rebuildTemplateHandle == uint64(0):
        return MobileCapiMoqError("moq_fountain_empty_rebuild_template")
    add(rows, MobileCapiWireRowUint64("rebuild_template_handle", rebuildTemplateHandle))
    add(rows, MobileCapiWireRowInt("blob_byte_len", buildResult.blobByteLen))
    add(rows, MobileCapiWireRowInt("object_target_bytes", buildResult.objectTargetBytes))
    add(rows, MobileCapiWireRowInt("source_block_bytes", buildResult.sourceBlockBytes))
    add(rows, MobileCapiWireRowInt("object_count", buildResult.objectCount))
    add(rows, MobileCapiWireRow("remote_ack_peer_ids", MobileCapiJoinCsv(buildResult.remoteAckPeerIds)))
    let header = MobileCapiWireRowsText(rows)
    if strings.Len(header) <= 0:
        return MobileCapiMoqError("moq_fountain_empty_build_handle_wire")
    let objectWire = MobileCapiMoqHandleObjectWire(buildResult)
    let dropletWire = MobileCapiMoqHandleDropletWire(buildResult)
    return strings.ConcatStr(strings.ConcatStr(header, objectWire), dropletWire)

fn MobileCapiMaxInt32(left: int32, right: int32): int32 =
    if left >= right:
        return left
    return right

fn MobileCapiMinInt32(left: int32, right: int32): int32 =
    if left <= right:
        return left
    return right

fn MobileCapiNormalizePositiveInt(value: int32, fallback: int32): int32 =
    var out = value
    if out <= 0:
        out = fallback
    if out <= 0:
        return 1
    return out

fn MobileCapiHexValue(ch: char): int32 =
    if ch >= '0' && ch <= '9':
        return int32(ch) - int32('0')
    if ch >= 'a' && ch <= 'f':
        return 10 + int32(ch) - int32('a')
    if ch >= 'A' && ch <= 'F':
        return 10 + int32(ch) - int32('A')
    return -1

@borrows
fn MobileCapiBytesFromHex(text: str): Result[Bytes] =
    if len(text) <= 0:
        return Ok[Bytes](EmptyBytes())
    if (len(text) % 2) != 0:
        return Err[Bytes](" mobile capi: invalid hex length")
    let n = len(text) / 2
    var check: int32
    while check < n:
        if MobileCapiHexValue(text[check * 2]) < 0 ||
           MobileCapiHexValue(text[check * 2 + 1]) < 0:
            return Err[Bytes](" mobile capi: invalid hex")
        check = check + 1
    var out: Bytes
    out = BytesAlloc(n)
    let p = BytesDataPtr(out)
    var i: int32
    while i < n:
        let hi = MobileCapiHexValue(text[i * 2])
        let lo = MobileCapiHexValue(text[i * 2 + 1])
        rawmem_support.RawmemWriteI8(p, i, Int8((hi << 4) | lo))
        i = i + 1
    return Ok[Bytes](BytesTake(out))

@borrows
fn MobileCapiSha256HexBytes(data: Bytes): str =
    let digest = hash256.Sha256Fixed(layout.ByteSpanFromBytes(data))
    return layout.FixedBytes32Hex(digest)

@borrows
fn MobileCapiOwnedBytesFromText(text: str): Bytes =
    let view = BytesFromString(text)
    return BytesSlice(view, 0, BytesLen(view))

@borrows
fn MobileCapiSha256HexText(text: str): str =
    return MobileCapiSha256HexBytes(BytesFromString(text))

@borrows
fn MobileCapiAsciiTrimLeft(text: str): int32 =
    var idx: int32
    while idx < len(text):
        let ch = text[idx]
        let code = int32(ch)
        if code == 32:
            idx = idx + 1
            continue
        if code == 10:
            idx = idx + 1
            continue
        if code == 13:
            idx = idx + 1
            continue
        if code == 9:
            idx = idx + 1
            continue
        break
    return idx

@borrows
fn MobileCapiAsciiTrimRight(text: str): int32 =
    var idx: int32 = len(text)
    while idx > 0:
        let ch = text[idx - 1]
        let code = int32(ch)
        if code == 32:
            idx = idx - 1
            continue
        if code == 10:
            idx = idx - 1
            continue
        if code == 13:
            idx = idx - 1
            continue
        if code == 9:

            continue
        break
    return idx

@borrows
fn MobileCapiTrimAscii(text: str): str =
    let start = MobileCapiAsciiTrimLeft(text)
    let stop = MobileCapiAsciiTrimRight(text)
    if stop <= start:
        return ""
    return strings.SliceBytes(text, start, stop - start)

@borrows
fn MobileCapiSplitCsv(text: str): str[] =
    var out: str[]
    out = []
    if len(text) <= 0:
        return out
    var start: int32
    var idx: int32
    while idx <= len(text):
        let atEnd = idx >= len(text)
        if atEnd || text[idx] == ',':
            var item = ""
            if idx > start:
                item = strings.SliceBytes(text, start, idx - start)
            add(out, item)
            start = idx + 1
        idx = idx + 1
    return out

@borrows
fn MobileCapiNormalizePeerCsv(peerCsv: str): str[] =
    MobileCapiEmitLog("mobile_moq:normalize_peers_enter")
    let parts = MobileCapiSplitCsv(peerCsv)
    MobileCapiEmitLog("mobile_moq:normalize_peers_after_split")
    var out: str[]
    out = []
    var i: int32
    for i in range(parts.len):

        let part = parts[i]
        MobileCapiEmitLog("mobile_moq:normalize_peers_before_trim")
        let candidate = MobileCapiTrimAscii(part)
        MobileCapiEmitLog("mobile_moq:normalize_peers_after_trim")
        if len(candidate) <= 0:

            continue
        var exists = false
        var j: int32
        for j in j..<out.len:
            MobileCapiEmitLog("mobile_moq:normalize_peers_before_equals")
            if out[j] == candidate:
                exists = true
                break
        if !exists:
            add(out, candidate)

    MobileCapiEmitLog("mobile_moq:normalize_peers_ok")
    return out

@borrows
fn MobileCapiJoinCsv(values: str[]): str =
    if values.len <= 0:
        return ""
    return strutils.Join(values, ",")

@borrows
fn MobileCapiJoinIntCsv(values: int32[]): str =
    var rows: int32[]
    rows = []
    var i: int32
    for i in i..<values.len:
        add(rows, values[i])
    var texts: str[]
    texts = []
    i = 0
    for i in i..<rows.len:
        add(texts, strings.IntToStr(rows[i]))
    return strutils.Join(texts, ",")

@borrows
fn MobileCapiEscapeJsonText(text: str): str =
    var out = ""
    for i in 0..<len(text):
        let ch = text[i]
        let code = int32(ch)
        if code == 92:
            out = Fmt"{out}\\\\"
        elif code == 34:
            out = Fmt"{out}\\\""
        elif code == 8:
            out = Fmt"{out}\\b"
        elif code == 12:
            out = Fmt"{out}\\f"
        elif code == 10:
            out = Fmt"{out}\\n"
        elif code == 13:
            out = Fmt"{out}\\r"
        elif code == 9:
            out = Fmt"{out}\\t"
        else:
            out = Fmt"{out}{strings.charToStr(ch)}"
    return out

@borrows
fn MobileCapiQuoteJsonTextBridge(text: str): str =
    return Fmt"\"{MobileCapiEscapeJsonText(text)}\""

@borrows
fn MobileCapiStrformatFmtBridge(parts: str[]): str =
    return strutils.Join(parts, "")

@borrows
fn MobileCapiStrformatLinesBridge(parts: str[]): str =
    return strutils.Join(parts, "\n")

@borrows
fn MobileCapiJsonEscape(text: str): str =
    let quoted = MobileCapiQuoteJsonTextBridge(text)
    if len(quoted) <= 2:
        return ""
    return strings.SliceBytes(quoted, 1, len(quoted) - 2)

@borrows
fn MobileCapiJsonQuote(text: str): str =
    let quoted = MobileCapiQuoteJsonTextBridge(text)
    return quoted

@borrows
fn MobileCapiJoinIntJson(values: int32[]): str =
    if values.len <= 0:
        return "[]"
    var rows: str[]
    rows = []
    for i in 0..<values.len:
        add(rows, strings.IntToStr(values[i]))
    let joined = strutils.Join(rows, ",")
    return Fmt"[{joined}]"

@borrows
fn MobileCapiContainsInt(values: int32[], want: int32): bool =
    for i in 0..<values.len:
        if values[i] == want:
            return true
    return false

fn MobileCapiSortInts(values0: int32[]): int32[] =
    var values = values0
    for i in 0..<values.len:
        for j in i + 1..<values.len:
            if values[j] < values[i]:
                let tmp = values[i]
                values[i] = values[j]
                values[j] = tmp
    return values

@borrows
fn MobileCapiHashSeed(text: str): int32 =
    let digestHex = bridge.InternalMobileBridgeSha256Hex(text)
    if len(digestHex) < 8:
        return 1
    var out: int32
    var i: int32
    for i in i..<8:
        let nibble = MobileCapiHexValue(digestHex[i])
        if nibble < 0:
            return 1
        out = (out << 4) | nibble
    if out == 0:
        return 1
    return out

@borrows
fn MobileCapiMoqDropletJson(droplet: MobileMoqDroplet): str =
    let kindText = MobileCapiMoqDropletKindText(droplet.kindCode)
    var rows: str[]
    rows = []
    add(rows, Fmt"\"objectIndex\":{strings.IntToStr(droplet.objectIndex)}")
    add(rows, Fmt"\"dropletIndex\":{strings.IntToStr(droplet.dropletIndex)}")
    add(rows, Fmt"\"kind\":{MobileCapiJsonQuote(kindText)}")
    add(rows, Fmt"\"key\":{MobileCapiJsonQuote(droplet.key)}")
    add(rows, Fmt"\"peerId\":{MobileCapiJsonQuote(droplet.peerId)}")
    add(rows, Fmt"\"cid\":{MobileCapiJsonQuote(droplet.cid)}")
    add(rows, Fmt"\"degree\":{strings.IntToStr(droplet.degree)}")
    add(rows, Fmt"\"blockIndexes\":{MobileCapiJoinIntJson(droplet.blockIndexes)}")
    let joined = strutils.Join(rows, ",")
    return Fmt"{{{joined}}}"

@borrows
fn MobileCapiMoqDropletsJson(droplets: MobileMoqDroplet[]): str =
    var rows: str[]
    rows = []
    var idx: int32
    for idx in idx..<droplets.len:
        add(rows, MobileCapiMoqDropletJson(droplets[idx]))
    return strutils.Join(rows, ",")

@borrows
fn MobileCapiMoqObjectJson(item: MobileMoqObject): str =
    var rows: str[]
    rows = []
    add(rows, Fmt"\"objectIndex\":{strings.IntToStr(item.objectIndex)}")
    add(rows, Fmt"\"groupId\":{MobileCapiJsonQuote(item.groupId)}")
    add(rows, Fmt"\"objectId\":{MobileCapiJsonQuote(item.objectId)}")
    add(rows, Fmt"\"priority\":{strings.IntToStr(item.priority)}")
    add(rows, Fmt"\"byteOffset\":{strings.IntToStr(item.byteOffset)}")
    add(rows, Fmt"\"byteLength\":{strings.IntToStr(item.byteLength)}")
    add(rows, Fmt"\"objectCid\":{MobileCapiJsonQuote(item.objectCid)}")
    add(rows, Fmt"\"sourceBlockBytes\":{strings.IntToStr(item.sourceBlockBytes)}")
    add(rows, Fmt"\"sourceBlockCount\":{strings.IntToStr(item.sourceBlockCount)}")
    add(rows, Fmt"\"repairDropletCount\":{strings.IntToStr(item.repairDropletCount)}")
    add(rows, Fmt"\"droplets\":[{MobileCapiMoqDropletsJson(item.droplets)}]")
    let joined = strutils.Join(rows, ",")
    return Fmt"{{{joined}}}"

@borrows
fn MobileCapiParseInt32Text(text: str): int32 =
    return int32(strutils.ParseInt(text))

@borrows
fn MobileCapiParseInt32Wire(requestWire: str, key: str): Result[int32] =
    let rawRes = MobileCapiWireFindValue(requestWire, key)
    if IsErr(rawRes):
        return Err[int32](result.Error(rawRes))
    let rawText = Value(rawRes)
    return Ok[int32](MobileCapiParseInt32Text(rawText))

@borrows
fn MobileCapiMoqAppendDroplets(out: var MobileMoqDroplet[],
                                 droplets: MobileMoqDroplet[]) =
    var idx: int32
    for idx in idx..<droplets.len:
        add(out, share(droplets[idx]))

fn MobileCapiMoqSliceObjectBlocks(objectBytes: Bytes, sourceBlockBytes: int32): Bytes[] =
    let objectByteLen = BytesLen(objectBytes)
    let sourceBlockCount = (objectByteLen + sourceBlockBytes - 1) / sourceBlockBytes
    var blocks: Bytes[]
    blocks = []
    var blockIndex: int32
    for blockIndex in blockIndex..<sourceBlockCount:
        let blockOffset = blockIndex * sourceBlockBytes
        let blockLen = MobileCapiMinInt32(sourceBlockBytes, objectByteLen - blockOffset)
        add(blocks, MobileCapiPadBlock(BytesSlice(objectBytes, blockOffset, blockLen), sourceBlockBytes))
    return blocks

@borrows
fn MobileCapiMoqFillSourceDroplets(blocks: Bytes[],
                                     objectIndex: int32,
                                     peers: str[],
                                     bundleCid: str,
                                     droplets: var MobileMoqDroplet[]) =
    var blockIndex: int32
    for blockIndex in blockIndex..<blocks.len:
        var indexes: int32[]
        indexes = []
        add(indexes, blockIndex)
        let peerId = strings.CloneStr(peers[(objectIndex + blockIndex) % peers.len])
        let key = Fmt"moqdrop-{bundleCid}-o{strings.IntToStr(objectIndex)}-s{strings.IntToStr(blockIndex)}"
        add(droplets, MobileMoqDroplet(
            objectIndex: objectIndex,
            dropletIndex: blockIndex,
            kindCode: MobileMoqDropletKindSource,
            key: key,
            peerId: peerId,
            cid: MobileCapiSha256HexBytes(blocks[blockIndex]),
            degree: 1,
            blockIndexes: indexes,
            payload: BytesSlice(blocks[blockIndex], 0, BytesLen(blocks[blockIndex]))
        ))

@borrows
fn MobileCapiMoqFillRepairDroplets(blocks: Bytes[],
                                     objectIndex: int32,
                                     peers: str[],
                                     bundleCid: str,
                                     sourceBlockBytes: int32,
                                     repairDropletCount: int32,
                                     droplets: var MobileMoqDroplet[]): Result[bool] =
    let sourceBlockCount = blocks.len
    var repairIndex: int32
    while repairIndex < repairDropletCount:
        var degreeBase: int32 = 1
        if sourceBlockCount > 1:
            let seedText = Fmt"{bundleCid}|o{strings.IntToStr(objectIndex)}|r{strings.IntToStr(repairIndex)}"
            degreeBase = 2 + MobileCapiPositiveMod(MobileCapiHashSeed(seedText), sourceBlockCount - 1)
        let repairSeed = Fmt"{bundleCid}|repair|{strings.IntToStr(objectIndex)}|{strings.IntToStr(repairIndex)}"
        let blockIndexes = MobileCapiChooseUniqueBlockIndexes(
            sourceBlockCount,
            degreeBase,
            repairSeed
        )
        var payload = BytesAlloc(sourceBlockBytes)
        var blockPick: int32
        for blockPick in blockPick..<blockIndexes.len:
            let xorOk = MobileCapiXorInto(payload, blocks[blockIndexes[blockPick]])
            if IsErr(xorOk):
                return Err[bool](result.Error(xorOk))
        let dropletIndex = sourceBlockCount + repairIndex
        let peerId = strings.CloneStr(peers[(objectIndex + dropletIndex) % peers.len])
        let key = Fmt"moqdrop-{bundleCid}-o{strings.IntToStr(objectIndex)}-r{strings.IntToStr(repairIndex)}"
        add(droplets, MobileMoqDroplet(
            objectIndex: objectIndex,
            dropletIndex: dropletIndex,
            kindCode: MobileMoqDropletKindRepair,
            key: key,
            peerId: peerId,
            cid: MobileCapiSha256HexBytes(payload),
            degree: blockIndexes.len,
            blockIndexes: blockIndexes,
            payload: payload
        ))
        repairIndex = repairIndex + 1
    return Ok[bool](true)

fn MobileCapiMoqBuildObject(objectBytes: Bytes,
                              objectIndex: int32,
                              byteOffset: int32,
                              peers: str[],
                              bundleCid: str,
                              sourceBlockBytes: int32,
                              repairDropletCount: int32): Result[MobileMoqObject] =
    MobileCapiEmitLog("mobile_moq:build_object_enter")
    let objectByteLen = BytesLen(objectBytes)
    MobileCapiEmitLog("mobile_moq:build_object_after_len")
    let objectCid = MobileCapiSha256HexBytes(objectBytes)
    MobileCapiEmitLog("mobile_moq:build_object_after_object_cid")
    let sourceBlockCount = (objectByteLen + sourceBlockBytes - 1) / sourceBlockBytes
    MobileCapiEmitLog("mobile_moq:build_object_after_block_count")
    let blocks = MobileCapiMoqSliceObjectBlocks(objectBytes, sourceBlockBytes)
    MobileCapiEmitLog("mobile_moq:build_object_after_blocks")
    var objectDroplets: MobileMoqDroplet[]
    objectDroplets = []
    MobileCapiMoqFillSourceDroplets(blocks, objectIndex, peers, bundleCid, objectDroplets)
    MobileCapiEmitLog("mobile_moq:build_object_after_source_droplets")
    let repairOk = MobileCapiMoqFillRepairDroplets(blocks,
                                                     objectIndex,
                                                     peers,
                                                     bundleCid,
                                                     sourceBlockBytes,
                                                     repairDropletCount,
                                                     objectDroplets)
    if IsErr(repairOk):
        return Err[MobileMoqObject](result.Error(repairOk))
    MobileCapiEmitLog("mobile_moq:build_object_after_repair_droplets")
    let objectOut = MobileMoqObject(
        objectIndex: objectIndex,
        groupId: strings.CloneStr(bundleCid),
        objectId: Fmt"object-{strings.IntToStr(objectIndex)}",
        priority: objectIndex,
        byteOffset: byteOffset,
        byteLength: objectByteLen,
        objectCid: objectCid,
        sourceBlockBytes: sourceBlockBytes,
        sourceBlockCount: sourceBlockCount,
        repairDropletCount: repairDropletCount,
        droplets: objectDroplets
    )
    MobileCapiEmitLog("mobile_moq:build_object_ok")
    return Ok[MobileMoqObject](objectOut)

fn MobileCapiNextSeed(state0: int32): int32 =
    var state = state0
    if state == 0:
        state = 1
    state = state ^ (state << 13)
    state = state ^ (state >> 17)
    state = state ^ (state << 5)
    if state == 0:
        return 1
    return state

fn MobileCapiPositiveMod(value: int32, modBy: int32): int32 =
    if modBy <= 0:
        return 0
    let normalized = int64(value & 2147483647)
    return int32(normalized % int64(modBy))

@borrows
fn MobileCapiChooseUniqueBlockIndexes(blockCount: int32, degree0: int32, seedText: str): int32[] =
    var out: int32[]
    out = []
    if blockCount <= 0:
        return out
    let degree = MobileCapiMinInt32(blockCount, MobileCapiMaxInt32(1, degree0))
    var seed = MobileCapiHashSeed(seedText)
    while out.len < degree:
        seed = MobileCapiNextSeed(seed)
        let candidate = MobileCapiPositiveMod(seed, blockCount)
        if !MobileCapiContainsInt(out, candidate):
            add(out, candidate)
    return MobileCapiSortInts(out)

@borrows
fn MobileCapiPadBlock(data: Bytes, blockBytes: int32): Bytes =
    var out = BytesAlloc(blockBytes)
    let copyLen = MobileCapiMinInt32(BytesLen(data), blockBytes)
    var i: int32
    for i in i..<copyLen:
        BytesSet(out, i, BytesGet(data, i))
    return out

@borrows
fn MobileCapiXorInto(target: var Bytes, source: Bytes): Result[bool] =
    if BytesLen(target) != BytesLen(source):
        return Err[bool](" mobile capi: xor length mismatch")
    for i in 0..<BytesLen(target):
        BytesSet(target, i, BytesGet(target, i) ^ BytesGet(source, i))
    return Ok[bool](true)

@borrows
fn MobileCapiXorBytes(left: Bytes, right: Bytes): Result[Bytes] =
    if BytesLen(left) != BytesLen(right):
        return Err[Bytes](" mobile capi: xor length mismatch")
    var out = BytesAlloc(BytesLen(left))
    for i in 0..<BytesLen(left):
        BytesSet(out, i, BytesGet(left, i) ^ BytesGet(right, i))
    return Ok[Bytes](out)

@borrows
fn MobileCapiMoqBuildCatalogJson(ownerPeerId: str,
                                   mimeType: str,
                                   blobCid: str,
                                   blobByteLen: int32,
                                   bundleCid: str,
                                   objectTargetBytes: int32,
                                   sourceBlockBytes: int32,
                                   objects: MobileMoqObject[]): str =
    var objectRows: str[]
    objectRows = []
    var objectIndex: int32
    for objectIndex in objectIndex..<objects.len:
        add(objectRows, MobileCapiMoqObjectJson(objects[objectIndex]))
    var rows: str[]
    rows = []
    add(rows, strutils.Join(["\"magic\":", MobileCapiJsonQuote(MobileMoqCatalogMagic)], ""))
    add(rows, "\"version\":1")
    add(rows, strutils.Join(["\"transport\":", MobileCapiJsonQuote(MobileMoqTransport)], ""))
    add(rows, strutils.Join(["\"fountainLayout\":", MobileCapiJsonQuote(MobileMoqLayout)], ""))
    add(rows, strutils.Join(["\"ownerPeerId\":", MobileCapiJsonQuote(ownerPeerId)], ""))
    add(rows, strutils.Join(["\"mimeType\":", MobileCapiJsonQuote(mimeType)], ""))
    add(rows, strutils.Join(["\"blobCid\":", MobileCapiJsonQuote(blobCid)], ""))
    add(rows, strutils.Join(["\"blobByteLen\":", strings.IntToStr(blobByteLen)], ""))
    # Fmt 不能待在 call-arg 位: 纯路径 statement_sequence bail=44
    # (backend seq 族已立卷, repro=catjson_b), 提为 let 后金标一致。
    let trackIdText = Fmt"track:{bundleCid}"
    add(rows, strutils.Join(["\"trackId\":", MobileCapiJsonQuote(trackIdText)], ""))
    add(rows, strutils.Join(["\"bundleCid\":", MobileCapiJsonQuote(bundleCid)], ""))
    add(rows, strutils.Join(["\"objectTargetBytes\":", strings.IntToStr(objectTargetBytes)], ""))
    add(rows, strutils.Join(["\"sourceBlockBytes\":", strings.IntToStr(sourceBlockBytes)], ""))
    add(rows, strutils.Join(["\"objectCount\":", strings.IntToStr(objects.len)], ""))
    add(rows, strutils.Join(["\"objects\":[", strutils.Join(objectRows, ","), "]"], ""))
    return strutils.Join(["{", strutils.Join(rows, ","), "}"], "")

@borrows
fn MobileCapiMoqBuildBundleSeed(ownerPeerId: str,
                                  blobCid: str,
                                  mimeType: str,
                                  peers: str[],
                                  objectTargetBytes: int32,
                                  sourceBlockBytes: int32,
                                  repairDropletCount: int32): str =
    return Fmt"{ownerPeerId}|{blobCid}|{mimeType}|{MobileCapiJoinCsv(peers)}|{strings.IntToStr(objectTargetBytes)}|{strings.IntToStr(sourceBlockBytes)}|{strings.IntToStr(repairDropletCount)}"

@borrows
fn MobileCapiMoqRebuildTemplateWire(objects: MobileMoqObject[],
                                      droplets: MobileMoqDroplet[],
                                      blobCid: str,
                                      blobByteLen: int32): str =
    var rows: str[]
    rows = []
    add(rows, MobileCapiWireRow("blob_cid", blobCid))
    add(rows, MobileCapiWireRowInt("blob_byte_len", blobByteLen))
    add(rows, MobileCapiWireRowInt("object_count", objects.len))
    add(rows, MobileCapiWireRowInt("droplet_count", droplets.len))
    var objectRow: int32
    for objectRow in objectRow..<objects.len:
        let prefix = Fmt"object.{strings.IntToStr(objectRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", objects[objectRow].objectIndex))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "byte_length", objects[objectRow].byteLength))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "source_block_bytes", objects[objectRow].sourceBlockBytes))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "source_block_count", objects[objectRow].sourceBlockCount))
        add(rows, MobileCapiWireRowPrefixed(prefix, "object_cid", objects[objectRow].objectCid))
    var dropletRow: int32
    for dropletRow in dropletRow..<droplets.len:
        let prefix = Fmt"droplet.{strings.IntToStr(dropletRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", droplets[dropletRow].objectIndex))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "droplet_index", droplets[dropletRow].dropletIndex))
        add(rows, MobileCapiWireRowPrefixed(prefix, "key", droplets[dropletRow].key))
        add(rows, MobileCapiWireRowPrefixed(prefix, "peer_id", droplets[dropletRow].peerId))
        add(rows, MobileCapiWireRowPrefixed(prefix, "cid", droplets[dropletRow].cid))
        add(rows, MobileCapiWireRowPrefixed(prefix, "block_indexes", MobileCapiJoinIntCsv(droplets[dropletRow].blockIndexes)))
    return MobileCapiWireRowsText(rows)

@borrows
fn MobileCapiMoqAppendBuildResultHeaderRows(buildResult: MobileMoqBuildResult, rows: var str[]) =
    add(rows, MobileCapiWireRow("ok", "1"))
    add(rows, MobileCapiWireRow("owner_peer_id", buildResult.ownerPeerId))
    add(rows, MobileCapiWireRow("mime_type", buildResult.mimeType))
    add(rows, MobileCapiWireRow("bundle_cid", buildResult.bundleCid))
    add(rows, MobileCapiWireRow("blob_cid", buildResult.blobCid))
    add(rows, MobileCapiWireRow("catalog_key", buildResult.catalogKey))
    add(rows, MobileCapiWireRow("catalog_cid", buildResult.catalogCid))
    add(rows, MobileCapiWireRowInt("catalog_size_bytes", buildResult.catalogSizeBytes))
    add(rows, MobileCapiWireRow("catalog_payload_hex", BytesToHex(BytesFromString(buildResult.catalogPayloadText))))
    add(rows, MobileCapiWireRow("rebuild_template_key", buildResult.rebuildTemplateKey))
    add(rows, MobileCapiWireRow("rebuild_template_cid", buildResult.rebuildTemplateCid))
    add(rows, MobileCapiWireRowInt("rebuild_template_size_bytes", buildResult.rebuildTemplateSizeBytes))
    add(rows, MobileCapiWireRow("rebuild_template_payload_hex", BytesToHex(BytesFromString(buildResult.rebuildTemplatePayloadText))))
    add(rows, MobileCapiWireRowInt("blob_byte_len", buildResult.blobByteLen))
    add(rows, MobileCapiWireRowInt("object_target_bytes", buildResult.objectTargetBytes))
    add(rows, MobileCapiWireRowInt("source_block_bytes", buildResult.sourceBlockBytes))
    add(rows, MobileCapiWireRowInt("object_count", buildResult.objectCount))
    add(rows, MobileCapiWireRow("remote_ack_peer_ids", MobileCapiJoinCsv(buildResult.remoteAckPeerIds)))

@borrows
fn MobileCapiMoqAppendObjectWireRows(buildResult: MobileMoqBuildResult, rows: var str[]) =
    var objectRow: int32
    for objectRow in objectRow..<buildResult.objects.len:
        let prefix = Fmt"object.{strings.IntToStr(objectRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", buildResult.objects[objectRow].objectIndex))
        add(rows, MobileCapiWireRowPrefixed(prefix, "group_id", buildResult.objects[objectRow].groupId))
        add(rows, MobileCapiWireRowPrefixed(prefix, "object_id", buildResult.objects[objectRow].objectId))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "priority", buildResult.objects[objectRow].priority))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "byte_offset", buildResult.objects[objectRow].byteOffset))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "byte_length", buildResult.objects[objectRow].byteLength))
        add(rows, MobileCapiWireRowPrefixed(prefix, "object_cid", buildResult.objects[objectRow].objectCid))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "source_block_bytes", buildResult.objects[objectRow].sourceBlockBytes))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "source_block_count", buildResult.objects[objectRow].sourceBlockCount))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "repair_droplet_count", buildResult.objects[objectRow].repairDropletCount))

@borrows
fn MobileCapiMoqAppendDropletWireRows(buildResult: MobileMoqBuildResult, rows: var str[]) =
    add(rows, MobileCapiWireRowInt("droplet_count", buildResult.droplets.len))
    var dropletRow: int32
    for dropletRow in dropletRow..<buildResult.droplets.len:
        let prefix = Fmt"droplet.{strings.IntToStr(dropletRow)}."
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "object_index", buildResult.droplets[dropletRow].objectIndex))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "droplet_index", buildResult.droplets[dropletRow].dropletIndex))
        add(rows, MobileCapiWireRowPrefixed(prefix, "kind", MobileCapiMoqDropletKindText(buildResult.droplets[dropletRow].kindCode)))
        add(rows, MobileCapiWireRowPrefixed(prefix, "key", buildResult.droplets[dropletRow].key))
        add(rows, MobileCapiWireRowPrefixed(prefix, "peer_id", buildResult.droplets[dropletRow].peerId))
        add(rows, MobileCapiWireRowPrefixed(prefix, "cid", buildResult.droplets[dropletRow].cid))
        add(rows, MobileCapiWireRowIntPrefixed(prefix, "degree", buildResult.droplets[dropletRow].degree))
        add(rows, MobileCapiWireRowPrefixed(prefix, "block_indexes", MobileCapiJoinIntCsv(buildResult.droplets[dropletRow].blockIndexes)))
        add(rows, MobileCapiWireRowPrefixed(prefix, "payload_hex", BytesToHex(buildResult.droplets[dropletRow].payload)))

fn MobileCapiMoqBuildResultToWire(buildResult: MobileMoqBuildResult): str =
    var rows: str[]
    rows = []
    MobileCapiMoqAppendBuildResultHeaderRows(buildResult, rows)
    MobileCapiMoqAppendObjectWireRows(buildResult, rows)
    MobileCapiMoqAppendDropletWireRows(buildResult, rows)
    return MobileCapiWireRowsText(rows)

@borrows
fn MobileCapiMoqDropletFromCore(item: moq.MoqFountainDroplet): MobileMoqDroplet =
    return MobileMoqDroplet(
        objectIndex: item.objectIndex,
        dropletIndex: item.dropletIndex,
        kindCode: item.kindCode,
        key: strings.CloneStr(item.key),
        peerId: strings.CloneStr(item.peerId),
        cid: strings.CloneStr(item.cid),
        degree: item.degree,
        blockIndexes: MobileCapiMoqCloneBlockIndexes(item.blockIndexes),
        payload: BytesSlice(item.payload, 0, BytesLen(item.payload))
    )

@borrows
fn MobileCapiMoqObjectFromCore(item: moq.MoqFountainObject): MobileMoqObject =
    var objectDroplets: MobileMoqDroplet[]
    objectDroplets = []
    var idx: int32
    for idx in idx..<item.droplets.len:
        add(objectDroplets, MobileCapiMoqDropletFromCore(item.droplets[idx]))
    return MobileMoqObject(
        objectIndex: item.objectIndex,
        groupId: item.groupId,
        objectId: item.objectId,
        priority: item.priority,
        byteOffset: item.byteOffset,
        byteLength: item.byteLength,
        objectCid: item.objectCid,
        sourceBlockBytes: item.sourceBlockBytes,
        sourceBlockCount: item.sourceBlockCount,
        repairDropletCount: item.repairDropletCount,
        droplets: objectDroplets
    )

@borrows
fn MobileCapiMoqBuildResultFromCore(item: moq.MoqFountainBuildResult): MobileMoqBuildResult =
    var objects: MobileMoqObject[]
    objects = []
    var objectIdx: int32
    for objectIdx in objectIdx..<item.objects.len:
        add(objects, MobileCapiMoqObjectFromCore(item.objects[objectIdx]))
    var droplets: MobileMoqDroplet[]
    droplets = []
    var dropletIdx: int32
    for dropletIdx in dropletIdx..<item.droplets.len:
        add(droplets, MobileCapiMoqDropletFromCore(item.droplets[dropletIdx]))
    var ackPeers: str[]
    ackPeers = []
    var peerIdx: int32
    for peerIdx in peerIdx..<item.remoteAckPeerIds.len:
        add(ackPeers, strings.CloneStr(item.remoteAckPeerIds[peerIdx]))
    return MobileMoqBuildResult(
        ownerPeerId: strings.CloneStr(item.ownerPeerId),
        mimeType: strings.CloneStr(item.mimeType),
        bundleCid: strings.CloneStr(item.bundleCid),
        blobCid: strings.CloneStr(item.blobCid),
        catalogKey: strings.CloneStr(item.catalogKey),
        catalogCid: strings.CloneStr(item.catalogCid),
        catalogSizeBytes: item.catalogSizeBytes,
        catalogPayloadText: "",
        catalogPayload: BytesSlice(item.catalogPayload, 0, BytesLen(item.catalogPayload)),
        rebuildTemplateKey: strings.CloneStr(item.rebuildTemplateKey),
        rebuildTemplateCid: strings.CloneStr(item.rebuildTemplateCid),
        rebuildTemplateSizeBytes: item.rebuildTemplateSizeBytes,
        rebuildTemplatePayloadText: "",
        rebuildTemplatePayload: BytesSlice(item.rebuildTemplatePayload, 0, BytesLen(item.rebuildTemplatePayload)),
        blobByteLen: item.blobByteLen,
        objectTargetBytes: item.objectTargetBytes,
        sourceBlockBytes: item.sourceBlockBytes,
        objectCount: item.objectCount,
        remoteAckPeerIds: ackPeers,
        objects: objects,
        droplets: droplets
    )

@borrows
fn MobileCapiMoqSourceDropletKey(bundleCid: str, objectIndex: int32, dropletIndex: int32): str =
    return Fmt"moqdrop-{bundleCid}-o{strings.IntToStr(objectIndex)}-s{strings.IntToStr(dropletIndex)}"

@borrows
fn MobileCapiMoqRepairDropletKey(bundleCid: str, objectIndex: int32, repairIndex: int32): str =
    return Fmt"moqdrop-{bundleCid}-o{strings.IntToStr(objectIndex)}-r{strings.IntToStr(repairIndex)}"

@borrows
fn MobileCapiMoqCloneBlockIndexes(src: int32[]): int32[] =
    var out: int32[]
    out = []
    var i: int32
    for i in i..<src.len:
        add(out, src[i])
    return out

@borrows
fn MobileCapiMoqCloneDropletList(src: MobileMoqDroplet[]): MobileMoqDroplet[] =
    var out: MobileMoqDroplet[]
    out = []
    var i: int32
    for i in i..<src.len:
        add(out, MobileMoqDroplet(
            objectIndex: src[i].objectIndex,
            dropletIndex: src[i].dropletIndex,
            kindCode: src[i].kindCode,
            key: strings.CloneStr(src[i].key),
            peerId: strings.CloneStr(src[i].peerId),
            cid: strings.CloneStr(src[i].cid),
            degree: src[i].degree,
            blockIndexes: MobileCapiMoqCloneBlockIndexes(src[i].blockIndexes),
            payload: BytesSlice(src[i].payload, 0, BytesLen(src[i].payload))
        ))
    return out

@borrows
fn MobileCapiMoqCloneObjectList(src: MobileMoqObject[], bundleCid: str): MobileMoqObject[] =
    var out: MobileMoqObject[]
    out = []
    var i: int32
    for i in i..<src.len:
        add(out, MobileMoqObject(
            objectIndex: src[i].objectIndex,
            groupId: strings.CloneStr(bundleCid),
            objectId: Fmt"object-{strings.IntToStr(src[i].objectIndex)}",
            priority: src[i].priority,
            byteOffset: src[i].byteOffset,
            byteLength: src[i].byteLength,
            objectCid: strings.CloneStr(src[i].objectCid),
            sourceBlockBytes: src[i].sourceBlockBytes,
            sourceBlockCount: src[i].sourceBlockCount,
            repairDropletCount: src[i].repairDropletCount,
            droplets: MobileCapiMoqCloneDropletList(src[i].droplets)
        ))
    return out

@borrows
fn MobileCapiMoqFindObjectSourceBlockCount(objects: MobileMoqObject[], objectIndex: int32): int32 =
    var i: int32
    for i in i..<objects.len:
        if objects[i].objectIndex == objectIndex:
            return objects[i].sourceBlockCount
    return 0

@borrows
fn MobileCapiMoqHydrateFlatDroplets(src: MobileMoqDroplet[],
                                     objects: MobileMoqObject[],
                                     peers: str[],
                                     bundleCid: str): MobileMoqDroplet[] =
    var out: MobileMoqDroplet[]
    out = []
    var i: int32
    for i in i..<src.len:
        let objectIndex = src[i].objectIndex
        let sourceBlockCount = MobileCapiMoqFindObjectSourceBlockCount(objects, objectIndex)
        let peerSlot = (objectIndex + src[i].dropletIndex) % peers.len
        var dropletKey: str
        if src[i].kindCode == MobileMoqDropletKindSource:
            dropletKey = MobileCapiMoqSourceDropletKey(bundleCid, objectIndex, src[i].dropletIndex)
        else:
            dropletKey = MobileCapiMoqRepairDropletKey(bundleCid, objectIndex, src[i].dropletIndex - sourceBlockCount)
        add(out, MobileMoqDroplet(
            objectIndex: objectIndex,
            dropletIndex: src[i].dropletIndex,
            kindCode: src[i].kindCode,
            key: dropletKey,
            peerId: strings.CloneStr(peers[peerSlot]),
            cid: MobileCapiSha256HexBytes(src[i].payload),
            degree: src[i].degree,
            blockIndexes: MobileCapiMoqCloneBlockIndexes(src[i].blockIndexes),
            payload: BytesSlice(src[i].payload, 0, BytesLen(src[i].payload))
        ))
    return out

fn MobileCapiMoqHydratedFinish(ownerPeerId: str,
                                 mimeType: str,
                                 bundleCid: str,
                                 blobCid: str,
                                 catalogText: str,
                                 catalogPayloadOwned: Bytes,
                                 catalogCid: str,
                                 catalogSizeBytes: int32,
                                 rebuildTemplateText: str,
                                 rebuildTemplatePayloadOwned: Bytes,
                                 rebuildTemplateCid: str,
                                 rebuildTemplateSizeBytes: int32,
                                 blobByteLen: int32,
                                 objectTargetBytes: int32,
                                 sourceBlockBytes: int32,
                                 ackPeers: str[],
                                 objects: MobileMoqObject[],
                                 droplets: MobileMoqDroplet[]): MobileMoqBuildResult =
    return MobileMoqBuildResult(
        ownerPeerId: strings.CloneStr(ownerPeerId),
        mimeType: strings.CloneStr(mimeType),
        bundleCid: strings.CloneStr(bundleCid),
        blobCid: strings.CloneStr(blobCid),
        catalogKey: Fmt"moqcatalog-{bundleCid}",
        catalogCid: catalogCid,
        catalogSizeBytes: catalogSizeBytes,
        catalogPayloadText: catalogText,
        catalogPayload: catalogPayloadOwned,
        rebuildTemplateKey: Fmt"moqrebuild-{bundleCid}",
        rebuildTemplateCid: rebuildTemplateCid,
        rebuildTemplateSizeBytes: rebuildTemplateSizeBytes,
        rebuildTemplatePayloadText: rebuildTemplateText,
        rebuildTemplatePayload: rebuildTemplatePayloadOwned,
        blobByteLen: blobByteLen,
        objectTargetBytes: objectTargetBytes,
        sourceBlockBytes: sourceBlockBytes,
        objectCount: objects.len,
        remoteAckPeerIds: ackPeers,
        objects: objects,
        droplets: droplets
    )

@borrows
fn MobileCapiMoqHydratedCoreResult(base: MobileMoqBuildResult,
                                     blobBytes: Bytes,
                                     ownerPeerId: str,
                                     remotePeersCsv: str,
                                     mimeType0: str,
                                     objectTargetBytes0: int32,
                                     sourceBlockBytes0: int32,
                                     repairDropletCount0: int32): Result[MobileMoqBuildResult] =
    let peers = MobileCapiNormalizePeerCsv(remotePeersCsv)
    if peers.len <= 0:
        return Err[MobileMoqBuildResult]("video_publish_insufficient_storage_peers")
    var mimeType: str
    mimeType = "video/mp4"
    if len(mimeType0) > 0:
        mimeType = strings.CloneStr(mimeType0)
    let objectTargetBytes = MobileCapiNormalizePositiveInt(objectTargetBytes0, 512 * 1024)
    let sourceBlockBytes = MobileCapiNormalizePositiveInt(sourceBlockBytes0, 128 * 1024)
    let repairDropletCount = MobileCapiNormalizePositiveInt(repairDropletCount0, 2)
    let blobCid = MobileCapiSha256HexBytes(blobBytes)
    let bundleSeed = MobileCapiMoqBuildBundleSeed(ownerPeerId,
                                                    blobCid,
                                                    mimeType,
                                                    peers,
                                                    objectTargetBytes,
                                                    sourceBlockBytes,
                                                    repairDropletCount)
    if len(bundleSeed) <= 0:
        return Err[MobileMoqBuildResult]("moq_fountain_empty_bundle_seed")
    let bundleCid = MobileCapiSha256HexText(bundleSeed)
    if len(bundleCid) <= 0:
        return Err[MobileMoqBuildResult]("moq_fountain_empty_bundle_cid")

    var ackPeers: str[]
    ackPeers = []
    var peerCopy: int32
    for peerCopy in peerCopy..<peers.len:
        add(ackPeers, strings.CloneStr(peers[peerCopy]))

    let objects = MobileCapiMoqCloneObjectList(base.objects, bundleCid)
    let droplets = MobileCapiMoqHydrateFlatDroplets(base.droplets, objects, peers, bundleCid)

    let catalogText = MobileCapiMoqBuildCatalogJson(ownerPeerId,
                                                      mimeType,
                                                      blobCid,
                                                      BytesLen(blobBytes),
                                                      bundleCid,
                                                      objectTargetBytes,
                                                      sourceBlockBytes,
                                                      objects)
    let catalogPayload = BytesFromString(catalogText)
    if BytesLen(catalogPayload) <= 0:
        return Err[MobileMoqBuildResult]("moq_fountain_empty_catalog_payload")
    let catalogCid = MobileCapiSha256HexBytes(catalogPayload)
    let catalogSizeBytes = BytesLen(catalogPayload)

    let rebuildTemplateText = MobileCapiMoqRebuildTemplateWire(objects,
                                                                 droplets,
                                                                 blobCid,
                                                                 BytesLen(blobBytes))
    let rebuildTemplatePayload = BytesFromString(rebuildTemplateText)
    if BytesLen(rebuildTemplatePayload) <= 0:
        return Err[MobileMoqBuildResult]("moq_fountain_empty_rebuild_template")
    let rebuildTemplateCid = MobileCapiSha256HexBytes(rebuildTemplatePayload)
    let rebuildTemplateSizeBytes = BytesLen(rebuildTemplatePayload)
    let catalogPayloadOwned = BytesSlice(catalogPayload, 0, catalogSizeBytes)
    let rebuildTemplatePayloadOwned = BytesSlice(rebuildTemplatePayload, 0, rebuildTemplateSizeBytes)
    return Ok[MobileMoqBuildResult](MobileCapiMoqHydratedFinish(strings.CloneStr(ownerPeerId),
                                                                 strings.CloneStr(mimeType),
                                                                 strings.CloneStr(bundleCid),
                                                                 strings.CloneStr(blobCid),
                                                                 strings.CloneStr(catalogText),
                                                                 catalogPayloadOwned,
                                                                 strings.CloneStr(catalogCid),
                                                                 catalogSizeBytes,
                                                                 strings.CloneStr(rebuildTemplateText),
                                                                 rebuildTemplatePayloadOwned,
                                                                 strings.CloneStr(rebuildTemplateCid),
                                                                 rebuildTemplateSizeBytes,
                                                                 BytesLen(blobBytes),
                                                                 objectTargetBytes,
                                                                 sourceBlockBytes,
                                                                 ackPeers,
                                                                 objects,
                                                                 droplets))

@borrows
fn MobileCapiMoqParsePersistRequestWire(requestWire: str): Result[MobileCapiMoqPersistRequest] =
    let ownerPeerIdRes = moq.MoqFountainWireFindValue(requestWire, "owner_peer_id")
    if IsErr(ownerPeerIdRes):
        return Err[MobileCapiMoqPersistRequest](result.Error(ownerPeerIdRes))
    let remotePeersCsvRes = moq.MoqFountainWireFindValue(requestWire, "remote_peers_csv")
    if IsErr(remotePeersCsvRes):
        return Err[MobileCapiMoqPersistRequest](result.Error(remotePeersCsvRes))
    let mimeTypeRes = moq.MoqFountainWireFindValue(requestWire, "mime_type")
    if IsErr(mimeTypeRes):
        return Err[MobileCapiMoqPersistRequest](result.Error(mimeTypeRes))
    let objectTargetBytesRes = moq.MoqFountainParseInt32Wire(requestWire, "object_target_bytes")
    if IsErr(objectTargetBytesRes):
        return Err[MobileCapiMoqPersistRequest](result.Error(objectTargetBytesRes))
    let sourceBlockBytesRes = moq.MoqFountainParseInt32Wire(requestWire, "source_block_bytes")
    if IsErr(sourceBlockBytesRes):
        return Err[MobileCapiMoqPersistRequest](result.Error(sourceBlockBytesRes))
    let repairDropletCountRes = moq.MoqFountainParseInt32Wire(requestWire, "repair_droplet_count")
    if IsErr(repairDropletCountRes):
        return Err[MobileCapiMoqPersistRequest](result.Error(repairDropletCountRes))
    let outputDirRes = moq.MoqFountainWireFindValue(requestWire, "output_dir")
    if IsErr(outputDirRes):
        return Err[MobileCapiMoqPersistRequest](result.Error(outputDirRes))
    let fileNameStemRes = moq.MoqFountainWireFindValue(requestWire, "file_name_stem")
    if IsErr(fileNameStemRes):
        return Err[MobileCapiMoqPersistRequest](result.Error(fileNameStemRes))
    return Ok[MobileCapiMoqPersistRequest](MobileCapiMoqPersistRequest(
        ownerPeerId: Value(ownerPeerIdRes),
        remotePeersCsv: Value(remotePeersCsvRes),
        mimeType: Value(mimeTypeRes),
        objectTargetBytes: Value(objectTargetBytesRes),
        sourceBlockBytes: Value(sourceBlockBytesRes),
        repairDropletCount: Value(repairDropletCountRes),
        outputDir: Value(outputDirRes),
        fileNameStem: Value(fileNameStemRes)
    ))

@borrows
fn MobileCapiMoqPersistFromRequest(blobBytes: Bytes, request: MobileCapiMoqPersistRequest): Result[str] =
    return MobileCapiMoqBuildPersistDirect(BytesSlice(blobBytes, 0, BytesLen(blobBytes)),
                                            strings.CloneStr(request.ownerPeerId),
                                            strings.CloneStr(request.remotePeersCsv),
                                            strings.CloneStr(request.mimeType),
                                            request.objectTargetBytes,
                                            request.sourceBlockBytes,
                                            request.repairDropletCount,
                                            strings.CloneStr(request.outputDir),
                                            strings.CloneStr(request.fileNameStem))

fn MobileCapiMoqBuildPersistDirect(blobBytes: Bytes,
                                     ownerPeerId: str,
                                     remotePeersCsv: str,
                                     mimeType0: str,
                                     objectTargetBytes0: int32,
                                     sourceBlockBytes0: int32,
                                     repairDropletCount0: int32,
                                     outputDir: str,
                                     fileNameStem: str): Result[str] =
    MobileCapiEmitLog("mobile_moq:persist_direct_enter")
    if BytesLen(blobBytes) <= 0:
        return Err[str]("moq_fountain_empty_blob")
    if len(outputDir) <= 0:
        return Err[str]("moq_fountain_missing_output_dir")
    if len(fileNameStem) <= 0:
        return Err[str]("moq_fountain_missing_file_stem")
    let buildResolvedRes = MobileCapiMoqBuildResolved(blobBytes,
                                                        ownerPeerId,
                                                        remotePeersCsv,
                                                        mimeType0,
                                                        objectTargetBytes0,
                                                        sourceBlockBytes0,
                                                        repairDropletCount0,
                                                        "")
    MobileCapiEmitLog("mobile_moq:persist_direct_after_resolved")
    if IsErr(buildResolvedRes):
        return Err[str](result.Error(buildResolvedRes))
    let wireRes = MobileCapiMoqBuildPersistWire(Value(buildResolvedRes), outputDir, fileNameStem)
    if IsErr(wireRes):
        return Err[str](result.Error(wireRes))
    MobileCapiEmitLog("mobile_moq:persist_direct_ok")
    return wireRes

fn MobileCapiMoqBuildResolved(blobBytes: Bytes,
                                ownerPeerId: str,
                                remotePeersCsv: str,
                                mimeType0: str,
                                objectTargetBytes0: int32,
                                sourceBlockBytes0: int32,
                                repairDropletCount0: int32,
                                tracePath: str): Result[MobileMoqBuildResult] =
    MobileCapiEmitLog("mobile_moq:build_enter")
    let traceEnabled = len(tracePath) > 0
    if traceEnabled:
        MobileCapiMaybeWriteTraceLine(tracePath, "build:enter")
        MobileCapiMaybeWriteTraceLine(tracePath, Fmt"build:blob_len={strings.IntToStr(BytesLen(blobBytes))}")
    if BytesLen(blobBytes) <= 0:
        if traceEnabled:
            MobileCapiMaybeWriteTraceLine(tracePath, "build:error=moq_fountain_empty_blob")
        return Err[MobileMoqBuildResult]("moq_fountain_empty_blob")
    MobileCapiEmitLog("mobile_moq:build_before_core")
    if traceEnabled:
        moq.MoqFountainSetTracePath(tracePath)
    let hydrateBlob = BytesSlice(blobBytes, 0, BytesLen(blobBytes))
    let hydrateOwner = strings.CloneStr(ownerPeerId)
    let hydratePeersCsv = strings.CloneStr(remotePeersCsv)
    let hydrateMime = strings.CloneStr(mimeType0)
    let buildRes = moq.MoqFountainBuild(blobBytes,
                                        ownerPeerId,
                                        remotePeersCsv,
                                        mimeType0,
                                        objectTargetBytes0,
                                        sourceBlockBytes0,
                                        repairDropletCount0)
    if traceEnabled:
        moq.MoqFountainClearTracePath()
    MobileCapiEmitLog("mobile_moq:build_after_core")
    if IsErr(buildRes):
        if traceEnabled:
            MobileCapiMaybeWriteTraceLine(tracePath, Fmt"build:error={result.Error(buildRes)}")
        return Err[MobileMoqBuildResult](result.Error(buildRes))
    return MobileCapiMoqHydrateBuiltResult(Value(buildRes),
                                             hydrateBlob,
                                             hydrateOwner,
                                             hydratePeersCsv,
                                             hydrateMime,
                                             objectTargetBytes0,
                                             sourceBlockBytes0,
                                             repairDropletCount0,
                                             tracePath,
                                             traceEnabled)

fn MobileCapiMoqHydrateBuiltResult(coreBuild: moq.MoqFountainBuildResult,
                                     hydrateBlob: Bytes,
                                     hydrateOwner: str,
                                     hydratePeersCsv: str,
                                     hydrateMime: str,
                                     objectTargetBytes0: int32,
                                     sourceBlockBytes0: int32,
                                     repairDropletCount0: int32,
                                     tracePath: str,
                                     traceEnabled: bool): Result[MobileMoqBuildResult] =
    let mobileBuild = MobileCapiMoqBuildResultFromCore(coreBuild)
    let hydrateRes = MobileCapiMoqHydratedCoreResult(mobileBuild,
                                                       hydrateBlob,
                                                       hydrateOwner,
                                                       hydratePeersCsv,
                                                       hydrateMime,
                                                       objectTargetBytes0,
                                                       sourceBlockBytes0,
                                                       repairDropletCount0)
    if IsErr(hydrateRes):
        if traceEnabled:
            MobileCapiMaybeWriteTraceLine(tracePath, Fmt"build:error={result.Error(hydrateRes)}")
        return Err[MobileMoqBuildResult](result.Error(hydrateRes))
    let out = Value(hydrateRes)
    MobileCapiEmitLog("mobile_moq:build_ok")
    if traceEnabled:
        MobileCapiMaybeWriteTraceLine(tracePath, Fmt"build:blob_cid={out.blobCid}")
        MobileCapiMaybeWriteTraceLine(tracePath, Fmt"build:bundle_cid={out.bundleCid}")
        MobileCapiMaybeWriteTraceLine(tracePath,
                                        Fmt"build:objects_done count={strings.IntToStr(out.objects.len)} droplets={strings.IntToStr(out.droplets.len)}")
        MobileCapiMaybeWriteTraceLine(tracePath, Fmt"build:catalog_bytes={strings.IntToStr(BytesLen(out.catalogPayload))}")
        MobileCapiMaybeWriteTraceLine(tracePath, Fmt"build:rebuild_template_bytes={strings.IntToStr(BytesLen(out.rebuildTemplatePayload))}")
        MobileCapiMaybeWriteTraceLine(tracePath, "build:ok")
    return Ok[MobileMoqBuildResult](out)

fn MobileCapiMoqBuildTraced(out: var MobileMoqBuildResult,
                              tracePath: str,
                              blobBytes: Bytes,
                              ownerPeerId: str,
                              remotePeersCsv: str,
                              mimeType0: str,
                              objectTargetBytes0: int32,
                              sourceBlockBytes0: int32,
