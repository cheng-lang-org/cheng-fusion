fn MobileCapiBioDidCreateWire(requestWire: str): str =
    let requestIdRes = MobileCapiWireDecodedValue(requestWire, "request_id")
    if IsErr(requestIdRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(requestIdRes))
        return errorText
    let feature32HexRes = MobileCapiWireFindValue(requestWire, "feature32_hex")
    if IsErr(feature32HexRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(feature32HexRes))
        return errorText
    let deviceBindingSeedRes = MobileCapiWireDecodedValue(requestWire, "device_binding_seed")
    if IsErr(deviceBindingSeedRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(deviceBindingSeedRes))
        return errorText
    let deviceLabelRes = MobileCapiWireDecodedValue(requestWire, "device_label")
    if IsErr(deviceLabelRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(deviceLabelRes))
        return errorText
    let sensorIdRes = MobileCapiWireDecodedValue(requestWire, "sensor_id")
    if IsErr(sensorIdRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(sensorIdRes))
        return errorText
    let hardwareAttestationRes = MobileCapiWireDecodedValue(requestWire, "hardware_attestation")
    if IsErr(hardwareAttestationRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(hardwareAttestationRes))
        return errorText
    let out = MobileCapiBioDidCreate(Value(requestIdRes),
                                       Value(feature32HexRes),
                                       Value(deviceBindingSeedRes),
                                       Value(deviceLabelRes),
                                       Value(sensorIdRes),
                                       Value(hardwareAttestationRes))
    return out

fn MobileCapiBioDidCreateTrustedWire(requestWire: str): str =
    let trustedPubKeyRes = MobileCapiWireFindValue(requestWire, "trusted_attestor_pub_key")
    if IsErr(trustedPubKeyRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(trustedPubKeyRes))
        return errorText
    let trustedRootKeyIdRes = MobileCapiWireDecodedValue(requestWire, "trusted_attestor_root_key_id")
    if IsErr(trustedRootKeyIdRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(trustedRootKeyIdRes))
        return errorText
    let trustRes = bio_did.BioDidSetTrustedAttestorRootHex(Value(trustedPubKeyRes),
                                                           Value(trustedRootKeyIdRes))
    if IsErr(trustRes):
        let errorText = MobileCapiBioDidErrorJson(result.Error(trustRes))
        return errorText
    return MobileCapiBioDidCreateWire(requestWire)

