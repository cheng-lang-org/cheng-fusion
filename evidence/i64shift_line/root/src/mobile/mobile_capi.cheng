                                                ownerPeerId,
                                                remotePeersCsv,
                                                mimeType0,
                                                objectTargetBytes0,
                                                sourceBlockBytes0,
                                                repairDropletCount0,
                                                tracePath)
    if IsErr(buildRes):
        return Err[bool](result.Error(buildRes))
    out = Value(buildRes)
    return Ok[bool](true)

fn MobileCapiMoqBuild(out: var MobileMoqBuildResult,
                        blobBytes: Bytes,
                        ownerPeerId: str,
                        remotePeersCsv: str,
