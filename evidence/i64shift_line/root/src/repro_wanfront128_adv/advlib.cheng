type
    Cfg =
        x: int32

var gCfg: Cfg = Cfg(x: 0)
var gOther: Cfg = Cfg(x: 0)

fn setCfg(c: Cfg) =
    gCfg = c

fn setOther(c: Cfg) =
    gOther = c

fn sideEffect(c: var Cfg) =
    c.x = 999

# Adversarial: last (only) statement is a VOID call whose var-ref argument
# happens to be the SAME composite type as the declared return type.
# Must NOT be silently accepted as the implicit return value of gOther.
fn getOtherAfterTouch(): Cfg =
    sideEffect(gCfg)
    gOther
