import src/repro_wanfront128_adv/advlib

fn main(): int32 =
    var c: advlib.Cfg = advlib.Cfg(x: 9)
    advlib.setCfg(c)
    var o: advlib.Cfg = advlib.Cfg(x: 42)
    advlib.setOther(o)
    var r: advlib.Cfg = advlib.getOtherAfterTouch()
    if r.x != 42:
        echo(Fmt"FAIL: got x={r.x} want 42 (adversarial ref-arg misattribution)")
        return 1
    echo("adv ok")
    return 0
