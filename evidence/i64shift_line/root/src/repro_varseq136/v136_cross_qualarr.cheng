# #136 cell: direct qualified WHOLE-ARRAY assignment (`mod.Arr = []`,
# `add(mod.Arr, x)` is unrelated pre-existing syntax gap and not tested
# here) followed by a qualified read of the element -- nails the array
# dimension of the matrix precisely (the scalar dimension is already
# covered by v136_cross_default.cheng/v136_cross_alias.cheng).

import cheng/repro_varseq136/v136_leaf

fn main(): int32 =
    # populate one element through the wrapper writer (known-good path)
    v136_leaf.V136WriteArr()
    let lenBefore: int32 = v136_leaf.V136ReadArrLen()
    if lenBefore != 1:
        return 161
    # direct qualified WHOLE-ARRAY reassignment from the importer
    v136_leaf.V136Arr = []
    let lenAfter: int32 = v136_leaf.V136ReadArrLen()
    # if the qualified write landed in real storage, the module's own
    # reader observes the reset to an empty array (len 0); if it silently
    # dropped (pre-fix), the reader still observes the stale len 1
    if lenAfter != 0:
        return 162
    return 0
