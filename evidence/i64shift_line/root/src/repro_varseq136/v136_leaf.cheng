# #136 minimal repro leaf module: exported module-level mutable var storage
# (scalar + dynamic array), plus exported writer/reader wrapper functions.
# Used from three different entry fixtures (same-module baseline is a
# separate standalone file, not this one) to isolate whether the
# read-after-write desync depends on import qualification style.

var V136Scalar: int32 = 0
var V136Arr: int32[] = []

fn V136WriteScalar() =
    V136Scalar = 42

fn V136ReadScalar(): int32 =
    return V136Scalar

fn V136WriteArr() =
    V136Arr = []
    add(V136Arr, 42)

fn V136ReadArr(): int32 =
    return V136Arr[0]

fn V136ReadArrLen(): int32 =
    return len(V136Arr)
