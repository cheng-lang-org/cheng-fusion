# #136 diagnostic: write via the module's own exported wrapper FUNCTION
# (`mod.WriteVar()`) then read back via a DIRECT qualified reference
# (`mod.Var`). Isolates whether the direct-qualified-read source point is
# the same physical storage the module's internal code writes to.

import cheng/repro_varseq136/v136_leaf

fn main(): int32 =
    v136_leaf.V136WriteScalar()
    let viaQual: int32 = v136_leaf.V136Scalar
    if viaQual != 42:
        return 151
    return 0
