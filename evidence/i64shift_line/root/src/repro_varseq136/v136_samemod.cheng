# #136 cell: same-module read-write control (no import at all). Writer and
# reader functions live in the SAME file/module as the var declarations and
# main(). If this cell is already broken, the defect is unrelated to module
# boundaries / import resolution entirely.

var V136SmScalar: int32 = 0
var V136SmArr: int32[] = []

fn V136SmWriteScalar() =
    V136SmScalar = 42

fn V136SmReadScalar(): int32 =
    return V136SmScalar

fn V136SmWriteArr() =
    V136SmArr = []
    add(V136SmArr, 42)

fn V136SmReadArr(): int32 =
    return V136SmArr[0]

fn main(): int32 =
    V136SmWriteScalar()
    let s: int32 = V136SmReadScalar()
    V136SmWriteArr()
    let a: int32 = V136SmReadArr()
    if s != 42:
        return 101
    if a != 42:
        return 102
    return 0
