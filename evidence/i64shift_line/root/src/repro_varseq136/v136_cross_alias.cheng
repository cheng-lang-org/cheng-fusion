# #136 cell: cross-module, single EXPLICIT-ALIAS import (`as`), QUALIFIED
# access via the alias prefix. Single import edge only (no diamond, no
# double-alias of the same module) -- isolates whether an explicit `as`
# alias alone (without the double-import desync mechanism already fixed for
# GlobalDef dedup) still desyncs storage.

import cheng/repro_varseq136/v136_leaf as v136alias

fn main(): int32 =
    v136alias.V136WriteScalar()
    let s1: int32 = v136alias.V136ReadScalar()
    v136alias.V136WriteArr()
    let a1: int32 = v136alias.V136ReadArr()
    if s1 != 42:
        return 121
    if a1 != 42:
        return 122
    # array coverage stays on the wrapper-function path exercised above
    # (qualified indexed expressions hit an unrelated pre-existing parser
    # gap, see v136_cross_default.cheng comment)
    v136alias.V136Scalar = 99
    let s2: int32 = v136alias.V136Scalar
    if s2 != 99:
        return 123
    return 0
