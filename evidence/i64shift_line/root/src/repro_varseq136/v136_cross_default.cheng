# #136 cell: cross-module, single default (non-aliased) import, QUALIFIED
# access -- via the module's own default name prefix. Tests both (a) the
# exported writer/reader wrapper functions, and (b) DIRECT external mutation
# of the exported var through the qualified name (no function indirection),
# mirroring the qualified_import_var_global_desync repro shape
# (`qnative.gMsQuicSessions[slot].active`).

import cheng/repro_varseq136/v136_leaf

fn main(): int32 =
    # (a) via exported wrapper functions
    v136_leaf.V136WriteScalar()
    let s1: int32 = v136_leaf.V136ReadScalar()
    v136_leaf.V136WriteArr()
    let a1: int32 = v136_leaf.V136ReadArr()
    if s1 != 42:
        return 111
    if a1 != 42:
        return 112
    # (b) direct qualified field access from the importer, bypassing the
    # wrapper functions entirely
    # (c) direct qualified array element READ -- omitted: qualified indexed
    # expressions (`mod.name[idx]`, read or write) hit an unrelated
    # pre-existing parser gap ("unknown qualified identifier"), out of
    # scope for this defect; array coverage stays on the wrapper-function
    # path exercised in (a) above.
    v136_leaf.V136Scalar = 99
    let s2: int32 = v136_leaf.V136Scalar
    if s2 != 99:
        return 113
    return 0
