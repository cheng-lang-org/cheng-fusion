import src/repro_msgcrypto124_r2shadow/shtypes
import src/repro_msgcrypto124_r2shadow/deepCorrect

fn getField(x: int32, y: int32, output: var ShPub): bool =
    output = ShPub(a: x + y)
    return true

fn getField(x: int32, y: int32, output: var ShPriv): bool =
    output = ShPriv(a: x - y)
    return true
