# Resident experts: each expert is one DiLoCo job with its own GlobalVersion
# lineage. L0 stays local. The router emits token blocks to top-k experts.
# Hidden / layer tensors are not a legal WAN payload.

import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner

const
    DiLoCoExpertSchema = "cheng.diloco.expert.resident.v1"
    DiLoCoExpertPayloadTokenBlock: int32 = 1
    DiLoCoExpertPayloadHiddenLayer: int32 = 2

type
    DiLoCoExpertReplica =
        expertId: int32
        replicaIndex: int32
        peerId: types.Libp2pPeerId
        jobBundleCid: layout.FixedBytes32
        versionCid: layout.FixedBytes32
        modelRef: core.DiLoCoArtifactRef
        alive: bool

    DiLoCoExpertRegistry =
        schema: str
        expertCount: int32
        topK: int32
        hiddenSize: int32
        routerWeights: int32[]
        replicas: DiLoCoExpertReplica[]
        registryHash: int64

    DiLoCoExpertRouteHop =
        tokenIndex: int32
        expertId: int32
        replicaIndex: int32
        versionCid: layout.FixedBytes32
        payloadKind: int32
        tokenCount: int32

    DiLoCoExpertRoutePlan =
        schema: str
        tokenCount: int32
        hopCount: int32
        hops: DiLoCoExpertRouteHop[]
        planHash: int64

fn DiLoCoExpertHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1000003) + value + int64(41)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn DiLoCoExpertHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = DiLoCoExpertHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn DiLoCoExpertHashCid(hashRaw: int64, cid: layout.FixedBytes32): int64 =
    return DiLoCoExpertHashTextWith(hashRaw, layout.FixedBytes32Hex(cid))

@borrows
fn DiLoCoExpertHashI32sWith(hashRaw: int64, values: int32[]): int64 =
    var h: int64 = hashRaw
    h = DiLoCoExpertHashStep(h, int64(values.len))
    for i in 0..<values.len:
        h = DiLoCoExpertHashStep(h, int64(values[i]))
    return h

fn DiLoCoExpertCopyReplicaFill(out: var DiLoCoExpertReplica, src: DiLoCoExpertReplica) =
    out.expertId = src.expertId
    out.replicaIndex = src.replicaIndex
    out.peerId.value = src.peerId.value
    out.jobBundleCid = src.jobBundleCid
    out.versionCid = src.versionCid
    out.modelRef.stubCid = src.modelRef.stubCid
    out.modelRef.blobSummaryCid = src.modelRef.blobSummaryCid
    out.modelRef.manifestCid = src.modelRef.manifestCid
    out.modelRef.blobCid = src.modelRef.blobCid
    out.modelRef.payloadLen = src.modelRef.payloadLen
    out.modelRef.paramsCid = src.modelRef.paramsCid
    out.modelRef.layoutKind = src.modelRef.layoutKind
    out.modelRef.dataShardCount = src.modelRef.dataShardCount
    out.modelRef.parityShardCount = src.modelRef.parityShardCount
    out.modelRef.shardPayloadBytes = src.modelRef.shardPayloadBytes
    out.alive = src.alive

@borrows
fn DiLoCoExpertRegistryHash(registry: DiLoCoExpertRegistry): int64 =
    var h: int64 = int64(41)
    h = DiLoCoExpertHashTextWith(h, registry.schema)
    h = DiLoCoExpertHashStep(h, int64(registry.expertCount))
    h = DiLoCoExpertHashStep(h, int64(registry.topK))
    h = DiLoCoExpertHashStep(h, int64(registry.hiddenSize))
    h = DiLoCoExpertHashI32sWith(h, registry.routerWeights)
    h = DiLoCoExpertHashStep(h, int64(registry.replicas.len))
    for i in 0..<registry.replicas.len:
        let r = registry.replicas[i]
        h = DiLoCoExpertHashStep(h, int64(r.expertId))
        h = DiLoCoExpertHashStep(h, int64(r.replicaIndex))
        h = DiLoCoExpertHashCid(h, r.peerId.value)
        h = DiLoCoExpertHashCid(h, r.jobBundleCid)
        h = DiLoCoExpertHashCid(h, r.versionCid)
        h = DiLoCoExpertHashCid(h, r.modelRef.blobCid)
        if r.alive:
            h = DiLoCoExpertHashStep(h, int64(1))
        else:
            h = DiLoCoExpertHashStep(h, int64(0))
    return h

@borrows
fn DiLoCoExpertRoutePlanHash(plan: DiLoCoExpertRoutePlan): int64 =
    var h: int64 = int64(41)
    h = DiLoCoExpertHashTextWith(h, plan.schema)
    h = DiLoCoExpertHashStep(h, int64(plan.tokenCount))
    h = DiLoCoExpertHashStep(h, int64(plan.hopCount))
    for i in 0..<plan.hops.len:
        let hop = plan.hops[i]
        h = DiLoCoExpertHashStep(h, int64(hop.tokenIndex))
        h = DiLoCoExpertHashStep(h, int64(hop.expertId))
        h = DiLoCoExpertHashStep(h, int64(hop.replicaIndex))
        h = DiLoCoExpertHashCid(h, hop.versionCid)
        h = DiLoCoExpertHashStep(h, int64(hop.payloadKind))
        h = DiLoCoExpertHashStep(h, int64(hop.tokenCount))
    return h

fn DiLoCoExpertHiddenLayerSyncForbidden(): Result[bool] =
    return Err[bool](" diloco expert: hidden layer sync forbidden")

fn DiLoCoExpertAssertTokenBlockPayload(payloadKind: int32): Result[bool] =
    if payloadKind != DiLoCoExpertPayloadTokenBlock:
        return Err[bool](" diloco expert: hidden layer sync forbidden")
    return Ok[bool](true)

fn DiLoCoExpertRegistryInitFill(out: var DiLoCoExpertRegistry,
                                  expertCount: int32,
                                  topK: int32,
                                  hiddenSize: int32,
                                  routerWeights: int32[]): Result[bool] =
    if expertCount <= 0 || topK <= 0 || topK > expertCount || hiddenSize <= 0:
        return Err[bool](" diloco expert: registry dims")
    if routerWeights.len != expertCount * hiddenSize:
        return Err[bool](" diloco expert: router weight length")
    out.schema = DiLoCoExpertSchema
    out.expertCount = expertCount
    out.topK = topK
    out.hiddenSize = hiddenSize
    out.routerWeights = codec.DiLoCoTrainCopyI32(routerWeights)
    out.replicas = []
    out.registryHash = DiLoCoExpertRegistryHash(out)
    return Ok[bool](true)

@borrows
fn DiLoCoExpertReplicaValidate(replica: DiLoCoExpertReplica, expertCount: int32): Result[bool] =
    if replica.expertId < 0 || replica.expertId >= expertCount:
        return Err[bool](" diloco expert: replica expert id")
    if replica.replicaIndex < 0:
        return Err[bool](" diloco expert: replica index")
    if layout.FixedBytes32Equal(replica.jobBundleCid, layout.FixedBytes32()):
        return Err[bool](" diloco expert: replica job cid")
    if layout.FixedBytes32Equal(replica.versionCid, layout.FixedBytes32()):
        return Err[bool](" diloco expert: replica version cid")
    let refOk = core.DiLoCoArtifactRefValidate(replica.modelRef)
    if IsErr(refOk):
        return Err[bool](Error(refOk))
    if !replica.alive:
        return Err[bool](" diloco expert: register down replica")
    return Ok[bool](true)

fn DiLoCoExpertReplicaRegisterFill(registry: var DiLoCoExpertRegistry,
                                     replica: DiLoCoExpertReplica): Result[bool] =
    if registry.schema != DiLoCoExpertSchema:
        return Err[bool](" diloco expert: registry schema")
    let valOk = DiLoCoExpertReplicaValidate(replica, registry.expertCount)
    if IsErr(valOk):
        return Err[bool](Error(valOk))
    for i in 0..<registry.replicas.len:
        if registry.replicas[i].expertId == replica.expertId &&
           registry.replicas[i].replicaIndex == replica.replicaIndex:
            return Err[bool](" diloco expert: replica duplicate")
    var stored: DiLoCoExpertReplica
    DiLoCoExpertCopyReplicaFill(stored, replica)
    add(registry.replicas, stored)
    registry.registryHash = DiLoCoExpertRegistryHash(registry)
    return Ok[bool](true)

fn DiLoCoExpertReplicaMarkDownFill(registry: var DiLoCoExpertRegistry,
                                     expertId: int32,
                                     replicaIndex: int32): Result[bool] =
    if registry.schema != DiLoCoExpertSchema:
        return Err[bool](" diloco expert: registry schema")
    var found: int32 = 0 - 1
    for i in 0..<registry.replicas.len:
        if registry.replicas[i].expertId == expertId &&
           registry.replicas[i].replicaIndex == replicaIndex:
            found = i
    if found < 0:
        return Err[bool](" diloco expert: replica missing")
    if !registry.replicas[found].alive:
        return Err[bool](" diloco expert: replica already down")
    registry.replicas[found].alive = false
    registry.registryHash = DiLoCoExpertRegistryHash(registry)
    return Ok[bool](true)

@borrows
fn DiLoCoExpertPickReplicaPos(registry: DiLoCoExpertRegistry, expertId: int32): Result[int32] =
    if expertId < 0 || expertId >= registry.expertCount:
        return Err[int32](" diloco expert: expert id")
    var best: int32 = 0 - 1
    var bestIndex: int32 = 0
    for i in 0..<registry.replicas.len:
        if registry.replicas[i].expertId != expertId:
            continue
        if !registry.replicas[i].alive:
            continue
        if best < 0 || registry.replicas[i].replicaIndex < bestIndex:
            best = i
            bestIndex = registry.replicas[i].replicaIndex
    if best < 0:
        return Err[int32](" diloco expert: no live replica")
    return Ok[int32](best)

@borrows
fn DiLoCoExpertScoreFill(outScores: var int32[],
                           registry: DiLoCoExpertRegistry,
                           hidden: int32[]): Result[bool] =
    if registry.schema != DiLoCoExpertSchema:
        return Err[bool](" diloco expert: registry schema")
    if hidden.len != registry.hiddenSize:
        return Err[bool](" diloco expert: hidden length")
    if registry.routerWeights.len != registry.expertCount * registry.hiddenSize:
        return Err[bool](" diloco expert: router weight length")
    let scale = int64(inner.DiLoCoLinearScale)
    outScores = []
    for e in 0..<registry.expertCount:
        var acc: int64 = int64(0)
        let base = e * registry.hiddenSize
        for k in 0..<registry.hiddenSize:
            acc = acc + int64(registry.routerWeights[base + k]) * int64(hidden[k])
        add(outScores, codec.DiLoCoTrainSaturateI64(codec.DiLoCoTrainRoundDivI64(acc, scale)))
    return Ok[bool](true)

@borrows
fn DiLoCoExpertPickTopKFill(outIds: var int32[],
                              scores: int32[],
                              topK: int32): Result[bool] =
    if topK <= 0 || scores.len < topK:
        return Err[bool](" diloco expert: topk")
    var used: int32[]
    for e in 0..<scores.len:
        add(used, 0)
    outIds = []
    for pick in 0..<topK:
        var best: int32 = 0 - 1
        for e in 0..<scores.len:
            if used[e] != 0:
                continue
            if best < 0:
                best = e
            elif scores[e] > scores[best]:
                best = e
            elif scores[e] == scores[best] && e < best:
                best = e
        if best < 0:
            return Err[bool](" diloco expert: topk exhausted")
        used[best] = 1
        add(outIds, best)
    return Ok[bool](true)

@borrows
fn DiLoCoExpertRoutePlanValidate(plan: DiLoCoExpertRoutePlan): Result[bool] =
    if plan.schema != DiLoCoExpertSchema:
        return Err[bool](" diloco expert: plan schema")
    if plan.tokenCount <= 0 || plan.hopCount <= 0:
        return Err[bool](" diloco expert: plan empty")
    if plan.hops.len != plan.hopCount:
        return Err[bool](" diloco expert: hop length")
    for i in 0..<plan.hops.len:
        let hop = plan.hops[i]
        if hop.payloadKind != DiLoCoExpertPayloadTokenBlock:
            return Err[bool](" diloco expert: hidden layer sync forbidden")
        if hop.tokenCount != plan.tokenCount || hop.tokenCount <= 0:
            return Err[bool](" diloco expert: hop token count")
        if hop.expertId < 0:
            return Err[bool](" diloco expert: hop expert")
        if hop.replicaIndex < 0:
            return Err[bool](" diloco expert: hop replica")
        if layout.FixedBytes32Equal(hop.versionCid, layout.FixedBytes32()):
            return Err[bool](" diloco expert: hop version cid")
        let kindOk = DiLoCoExpertAssertTokenBlockPayload(hop.payloadKind)
        if IsErr(kindOk):
            return Err[bool](Error(kindOk))
    if DiLoCoExpertRoutePlanHash(plan) != plan.planHash:
        return Err[bool](" diloco expert: plan hash")
    return Ok[bool](true)

@borrows
fn DiLoCoExpertRouteTokenBlockFill(outPlan: var DiLoCoExpertRoutePlan,
                                     registry: DiLoCoExpertRegistry,
                                     tokenIds: int32[],
                                     hidden: int32[]): Result[bool] =
    if registry.schema != DiLoCoExpertSchema:
        return Err[bool](" diloco expert: registry schema")
    if DiLoCoExpertRegistryHash(registry) != registry.registryHash:
        return Err[bool](" diloco expert: registry hash")
    if tokenIds.len <= 0:
        return Err[bool](" diloco expert: empty token block")
    var scores: int32[]
    let scoreOk = DiLoCoExpertScoreFill(scores, registry, hidden)
    if IsErr(scoreOk):
        return Err[bool](Error(scoreOk))
    var expertIds: int32[]
    let topOk = DiLoCoExpertPickTopKFill(expertIds, scores, registry.topK)
    if IsErr(topOk):
        return Err[bool](Error(topOk))
    var hops: DiLoCoExpertRouteHop[]
    for i in 0..<expertIds.len:
        let expertId = expertIds[i]
        let posRes = DiLoCoExpertPickReplicaPos(registry, expertId)
        if IsErr(posRes):
            return Err[bool](Error(posRes))
        let pos = Value(posRes)
        var hop: DiLoCoExpertRouteHop
        hop.tokenIndex = 0
        hop.expertId = expertId
        hop.replicaIndex = registry.replicas[pos].replicaIndex
        hop.versionCid = registry.replicas[pos].versionCid
        hop.payloadKind = DiLoCoExpertPayloadTokenBlock
        hop.tokenCount = tokenIds.len
        add(hops, hop)
    outPlan.schema = DiLoCoExpertSchema
    outPlan.tokenCount = tokenIds.len
    outPlan.hopCount = hops.len
    outPlan.hops = hops
    outPlan.planHash = DiLoCoExpertRoutePlanHash(outPlan)
    let planOk = DiLoCoExpertRoutePlanValidate(outPlan)
    if IsErr(planOk):
        return Err[bool](Error(planOk))
    return Ok[bool](true)

@borrows
fn DiLoCoExpertApplyFill(outY: var int32[],
                           store: astore.DiLoCoArtifactStore,
                           replica: DiLoCoExpertReplica,
                           hidden: int32[],
                           outFeatures: int32,
                           inFeatures: int32): Result[bool] =
    if !replica.alive:
        return Err[bool](" diloco expert: apply down replica")
    if hidden.len != inFeatures:
        return Err[bool](" diloco expert: apply hidden")
    let refOk = core.DiLoCoArtifactRefValidate(replica.modelRef)
    if IsErr(refOk):
        return Err[bool](Error(refOk))
    var bytes = rawbytes.EmptyBytes()
    let getRes = astore.DiLoCoArtifactStoreGetFill(bytes, store, replica.modelRef)
    if IsErr(getRes):
        return Err[bool](Error(getRes))
    var weights: int32[]
    let unpackRes = codec.DiLoCoTrainUnpackI32Fill(weights, bytes)
    if IsErr(unpackRes):
        return Err[bool](Error(unpackRes))
    return inner.DiLoCoLinearForwardOneFill(outY, weights, hidden, 0, outFeatures, inFeatures)
