# D8 真双机 leader (sg)。
# 单进程: 真 genesis 字节开 job + 本地 join + 真实内步 delta 预落仓 ->
#   serve 窗口1 (worker join/lease/barrier/submit 共 4 请求) ->
#   真实 OuterMergeAndPublishFill (quorum+token 加权+合并字节落仓) ->
#   serve 窗口2 (worker verify 的 version/lineage 共 2 请求) ->
#   合并哈希+收据落盘。状态全程单进程内存, 无 stub ref。

import std/cmdline as cmdline
import std/os
import std/rawbytes as rawbytes
import std/strings as strings
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner
import cheng/DiLoCo/train/outer_merge as outer
import cheng/DiLoCo/expert/resident as expert
import cheng/DiLoCo/host/diloco_host
import cheng/DiLoCo/tests/support

const
    D8InnerSteps: int32 = 4
    D8Out: int32 = 2
    D8In: int32 = 4

fn die(msg: str): int32 =
    echo(msg)
    return 1

@borrows
fn putValues(store: var astore.DiLoCoArtifactStore,
             jobBundleCid: layout.FixedBytes32,
             values: int32[]): Result[core.DiLoCoArtifactRef] =
    var packed = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(packed, values)
    if IsErr(packRes):
        return Err[core.DiLoCoArtifactRef](Error(packRes))
    var artifactRef = core.DiLoCoArtifactRef()
    let putRes = astore.DiLoCoArtifactStorePutFill(artifactRef, store, jobBundleCid, packed, 64)
    if IsErr(putRes):
        return Err[core.DiLoCoArtifactRef](Error(putRes))
    return Ok[core.DiLoCoArtifactRef](artifactRef)

@borrows
fn loadValues(store: var astore.DiLoCoArtifactStore,
              artifactRef: core.DiLoCoArtifactRef): Result[int32[]] =
    var bytes = rawbytes.EmptyBytes()
    let getRes = astore.DiLoCoArtifactStoreGetFill(bytes, store, artifactRef)
    if IsErr(getRes):
        return Err[int32[]](Error(getRes))
    var values: int32[]
    let unpackRes = codec.DiLoCoTrainUnpackI32Fill(values, bytes)
    if IsErr(unpackRes):
        return Err[int32[]](Error(unpackRes))
    return Ok[int32[]](values)

@borrows
fn leaderBatchFill(xs: var int32[], ys: var int32[]) =
    for s in 0..<3:
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(xs, 0)
        add(ys, 1000)
        add(ys, 0)

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", 0)
    var readyPath: str
    let hasReady = cmdline.ReadFirstFlagValue("--ready-path", readyPath)
    var storeDir: str
    let hasStore = cmdline.ReadFirstFlagValue("--store-dir", storeDir)
    if port <= 0:
        return die(" diloco d8 server: port missing")
    if !hasReady:
        return die(" diloco d8 server: ready path missing")
    if !hasStore:
        return die(" diloco d8 server: store dir missing")

    var store = astore.DiLoCoArtifactStore()
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, storeDir)
    if IsErr(initRes):
        return die(Error(initRes))

    let jobBundleCid = support.DiLoCoTestJobBundleCid("d8-two-machine")
    var leaderPeer: types.Libp2pPeerId
    leaderPeer.value = support.DiLoCoTestJobBundleCid("d8-leader-peer")
    var workerPeer: types.Libp2pPeerId
    workerPeer.value = support.DiLoCoTestJobBundleCid("d8-worker-peer")

    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, D8Out, D8In)
    if IsErr(zeroRes):
        return die(Error(zeroRes))
    let modelPut = putValues(store, jobBundleCid, zeros)
    if IsErr(modelPut):
        return die(Error(modelPut))
    let optPut = putValues(store, jobBundleCid, zeros)
    if IsErr(optPut):
        return die(Error(optPut))

    var node = diloco_host.DiLoCoHostInit("diloco.d8.leader")
    var openedJob = core.DiLoCoJob()
    var genesis = core.DiLoCoGlobalVersion()
    let openRes = core.DiLoCoOpenJobFill(openedJob,
                                           genesis,
                                           node.state,
                                           jobBundleCid,
                                           2,
                                           D8InnerSteps,
                                           120,
                                           Value(modelPut),
                                           Value(optPut))
    if IsErr(openRes):
        return die(Error(openRes))

    var cohort = core.DiLoCoCohort()
    let joinL = core.DiLoCoJoinCohortFill(cohort, node.state, jobBundleCid, leaderPeer)
    if IsErr(joinL):
        return die(Error(joinL))

    # leader 自己的真实内步 delta, 预落本仓 (真字节, 非 stub)
    var baseW: int32[]
    let baseLoad = loadValues(store, genesis.modelRef)
    if IsErr(baseLoad):
        return die(Error(baseLoad))
    let baseWeights = Value(baseLoad)
    var xsL: int32[]
    var ysL: int32[]
    leaderBatchFill(xsL, ysL)
    var wL: int32[]
    var dL: int32[]
    let innerL = inner.DiLoCoInnerSgdLinearFill(wL, dL, baseWeights, xsL, ysL, 3, D8InnerSteps, D8Out, D8In, 1, 2)
    if IsErr(innerL):
        return die(Error(innerL))
    let leaderDeltaPut = putValues(store, jobBundleCid, dL)
    if IsErr(leaderDeltaPut):
        return die(Error(leaderDeltaPut))
    let leaderOptPut = putValues(store, jobBundleCid, zeros)
    if IsErr(leaderOptPut):
        return die(Error(leaderOptPut))

    diloco_host.DiLoCoHostEnableAutoLeader(node,
                                             jobBundleCid,
                                             leaderPeer,
                                             Value(leaderDeltaPut),
                                             Value(leaderOptPut),
                                             3,
                                             3 * D8InnerSteps,
                                             D8InnerSteps,
                                             1,
                                             2)

    let serveRes = diloco_host.DiLoCoHostServeWindowNamed(node,
                                                            "0.0.0.0",
                                                            port,
                                                            "localhost",
                                                            readyPath,
                                                            4,
                                                            -1)
    if IsErr(serveRes):
        return die(Error(serveRes))

    # 真实合并: quorum + token 加权 + 合并字节落仓 (非 register-only)
    var commit = core.DiLoCoMergeCommit()
    var version = core.DiLoCoGlobalVersion()
    let mergeRes = outer.DiLoCoOuterMergeAndPublishFill(commit,
                                                          version,
                                                          store,
                                                          node.state,
                                                          jobBundleCid,
                                                          leaderPeer,
                                                          64)
    if IsErr(mergeRes):
        return die(Error(mergeRes))

    var mergedW: int32[]
    let mergedLoad = loadValues(store, version.modelRef)
    if IsErr(mergedLoad):
        return die(Error(mergedLoad))
    let mergedHash = expert.DiLoCoExpertHashI32sWith(961, Value(mergedLoad))

    # 窗口2: worker verify 的 version/lineage 请求
    let serve2Res = diloco_host.DiLoCoHostServeWindowNamed(node,
                                                             "0.0.0.0",
                                                             port,
                                                             "localhost",
                                                             readyPath,
                                                             2,
                                                             30000)
    if IsErr(serve2Res):
        return die(Error(serve2Res))

    echo(strings.ConcatStr("d8_merge_hash=", strings.Int64ToStr(mergedHash)))
    echo(strings.ConcatStr("d8_committed_outer_step=", strings.IntToStr(version.committedOuterStep)))
    echo(strings.ConcatStr("d8_version_cid=", layout.FixedBytes32Hex(version.versionCid)))
    echo(strings.ConcatStr("d8_genesis_cid=", layout.FixedBytes32Hex(genesis.versionCid)))
    echo(" diloco_quic_d8_server ok")
    return 0
