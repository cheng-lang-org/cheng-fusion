# ORC registry_miss 最小复现 (编译器 lane 移交件, 2026-08-23 D8 线)。
# 现象: 对活 leader 发送 SubmitOuterDelta 请求, 客户端在 send 后/响应返回前
#   无输出崩溃: cheng_orc_release_failure code=registry_miss
#   operation=normal_release detail=wrong_object_or_owner, rc=1。
# 二分结论:
#   - 仅构造+Encode(1666B) 不崩 -> 编码侧干净
#   - 空 ref 最小请求即崩 -> 与载荷内容无关, 消息类型级
#   - Join/FetchLease/ReportBarrier 同传输路径往返不崩 -> SubmitOuterDelta 对专属
#   - 服务端零错误输出 -> 客户端接收/解码侧
# 用法: 先起 src/diloco/tests/diloco_quic_twoproc_server_smoke 的 leader,
#   再跑本探针 --port <leader端口> --phase joinfirst。
import std/cmdline as cmdline
import std/strings as strings
import cheng/DiLoCo/host/diloco_client as dclient
import cheng/DiLoCo/protocol/wire
import cheng/DiLoCo/tests/support

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", -1)
    var phase: str
    let hasPhase = cmdline.ReadFirstFlagValue("--phase", phase)
    if port <= 0 || !hasPhase:
        echo("usage: --port <n> --phase joinfirst")
        return 1
    let jobBundleCid = support.DiLoCoTestJobBundleCid("quic-twoproc")
    var workerPeerId = support.DiLoCoTestPeer("diloco.quic.worker")
    var joinReq = wire.DiLoCoJoinCohortRequest()
    joinReq.jobBundleCid = jobBundleCid
    joinReq.peerId = workerPeerId
    let joinRes = dclient.DiLoCoJoinCohortRequestNamed("127.0.0.1", port, "localhost", joinReq)
    echo("repro: join sent")
    var deltaReq = wire.DiLoCoSubmitOuterDeltaRequest()
    deltaReq.jobBundleCid = jobBundleCid
    deltaReq.publisherPeerId = workerPeerId
    echo("repro: sending minimal submit (期望此处触发 ORC)")
    let deltaRes = dclient.DiLoCoSubmitOuterDeltaRequestNamed("127.0.0.1", port, "localhost", deltaReq)
    echo("repro: got response (未触发则本行出现)")
    assert(IsErr(deltaRes), " repro expect reject")
    echo(" diloco_orc_submit_repro completed without ORC")
    return 0
