# D8 单机对拍重放: 与真双机完全一致的常量与算子路径, 单进程跑完整外步。
# 断言: 两机合并哈希 == 本重放哈希 (整数定点跨架构确定性)。
# 输出 d8_merge_hash=<int64> 供 gate 与 leader 收据比对。
import std/cmdline as cmdline
import std/os
import std/rawbytes as rawbytes
import std/strings as strings
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner
import cheng/DiLoCo/train/outer_merge as outer
import cheng/DiLoCo/expert/resident as expert
import cheng/DiLoCo/tests/support

const
    D8InnerSteps: int32 = 4
    D8Out: int32 = 2
    D8In: int32 = 4

fn die(msg: str): int32 =
    echo(msg)
    return 1

@borrows
fn leaderBatchFill(xs: var int32[], ys: var int32[]) =
    for s in 0..<3:
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(xs, 0)
        add(ys, 1000)
        add(ys, 0)

@borrows
fn workerBatchFill(xs: var int32[], ys: var int32[]) =
    for s in 0..<3:
        add(xs, 0)
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(ys, 0)
        add(ys, 1000)

@borrows
fn putValues(store: var astore.DiLoCoArtifactStore, jobBundleCid: layout.FixedBytes32, values: int32[]): Result[core.DiLoCoArtifactRef] =
    var packed = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(packed, values)
    if IsErr(packRes):
        return Err[core.DiLoCoArtifactRef](Error(packRes))
    var artifactRef = core.DiLoCoArtifactRef()
    let putRes = astore.DiLoCoArtifactStorePutFill(artifactRef, store, jobBundleCid, packed, 64)
    if IsErr(putRes):
        return Err[core.DiLoCoArtifactRef](Error(putRes))
    return Ok[core.DiLoCoArtifactRef](artifactRef)

@borrows
fn loadValues(store: var astore.DiLoCoArtifactStore, artifactRef: core.DiLoCoArtifactRef): Result[int32[]] =
    var bytes = rawbytes.EmptyBytes()
    let getRes = astore.DiLoCoArtifactStoreGetFill(bytes, store, artifactRef)
    if IsErr(getRes):
        return Err[int32[]](Error(getRes))
    var values: int32[]
    let unpackRes = codec.DiLoCoTrainUnpackI32Fill(values, bytes)
    if IsErr(unpackRes):
        return Err[int32[]](Error(unpackRes))
    return Ok[int32[]](values)

@borrows
fn innerDeltaFill(deltaOut: var int32[], baseWeights: int32[], xs: int32[], ys: int32[]): bool =
    var wOut: int32[]
    let res = inner.DiLoCoInnerSgdLinearFill(wOut, deltaOut, baseWeights, xs, ys, 3, D8InnerSteps, D8Out, D8In, 1, 2)
    if IsErr(res):
        return false
    return true

fn main(): int32 =
    var storeDir: str
    let hasStore = cmdline.ReadFirstFlagValue("--store-dir", storeDir)
    if !hasStore:
        return die(" diloco d8 replay: store dir missing")
    var store = astore.DiLoCoArtifactStore()
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, storeDir)
    if IsErr(initRes):
        return die(Error(initRes))

    let jobBundleCid = support.DiLoCoTestJobBundleCid("d8-two-machine")
    var leaderPeer: types.Libp2pPeerId
    leaderPeer.value = support.DiLoCoTestJobBundleCid("d8-leader-peer")
    var workerPeer: types.Libp2pPeerId
    workerPeer.value = support.DiLoCoTestJobBundleCid("d8-worker-peer")

    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, D8Out, D8In)
    if IsErr(zeroRes):
        return die(Error(zeroRes))
    let modelPut = putValues(store, jobBundleCid, zeros)
    if IsErr(modelPut):
        return die(Error(modelPut))
    let optPut = putValues(store, jobBundleCid, zeros)
    if IsErr(optPut):
        return die(Error(optPut))

    var nodeState = core.DiLoCoStateInit("diloco.d8.replay")
    var openedJob = core.DiLoCoJob()
    var genesis = core.DiLoCoGlobalVersion()
    let openRes = core.DiLoCoOpenJobFill(openedJob, genesis, nodeState, jobBundleCid, 2, D8InnerSteps, 120, Value(modelPut), Value(optPut))
    if IsErr(openRes):
        return die(Error(openRes))

    var cohort = core.DiLoCoCohort()
    let joinL = core.DiLoCoJoinCohortFill(cohort, nodeState, jobBundleCid, leaderPeer)
    if IsErr(joinL):
        return die(Error(joinL))
    var cohortW = core.DiLoCoCohort()
    let joinWR = core.DiLoCoJoinCohortFill(cohortW, nodeState, jobBundleCid, workerPeer)
    if IsErr(joinWR):
        return die(Error(joinWR))

    var baseW: int32[]
    let baseLoad = loadValues(store, genesis.modelRef)
    if IsErr(baseLoad):
        return die(Error(baseLoad))
    let baseWeights = Value(baseLoad)
    var xsL: int32[]
    var ysL: int32[]
    leaderBatchFill(xsL, ysL)
    var xsW: int32[]
    var ysW: int32[]
    workerBatchFill(xsW, ysW)
    var dLeader: int32[]
    var dWorker: int32[]
    if !innerDeltaFill(dLeader, baseWeights, xsL, ysL):
        return die(" diloco d8 replay: leader sgd")
    if !innerDeltaFill(dWorker, baseWeights, xsW, ysW):
        return die(" diloco d8 replay: worker sgd")

    # 双方 lease (barrier 前置条件, 与双机 wire 路径一致)
    var leaseL = core.DiLoCoLease()
    let leaseLRes = core.DiLoCoFetchLeaseFill(leaseL, nodeState, jobBundleCid, leaderPeer)
    if IsErr(leaseLRes):
        return die(Error(leaseLRes))
    var leaseW = core.DiLoCoLease()
    let leaseWRes = core.DiLoCoFetchLeaseFill(leaseW, nodeState, jobBundleCid, workerPeer)
    if IsErr(leaseWRes):
        return die(Error(leaseWRes))
    # 双方 barrier (合并前置条件, 与双机 wire 路径一致)
    var barrierL = core.DiLoCoBarrier()
    let barL = core.DiLoCoReportInnerStepDoneFill(barrierL, nodeState, jobBundleCid, leaderPeer)
    if IsErr(barL):
        return die(Error(barL))
    var barrierW = core.DiLoCoBarrier()
    let barW = core.DiLoCoReportInnerStepDoneFill(barrierW, nodeState, jobBundleCid, workerPeer)
    if IsErr(barW):
        return die(Error(barW))
    # 双方 delta 以真实字节入仓并提交到 state (与双机 wire 路径字段完全一致)
    let leaderDeltaPut = putValues(store, jobBundleCid, dLeader)
    if IsErr(leaderDeltaPut):
        return die(Error(leaderDeltaPut))
    let workerDeltaPut = putValues(store, jobBundleCid, dWorker)
    if IsErr(workerDeltaPut):
        return die(Error(workerDeltaPut))
    var leaderDelta = core.DiLoCoOuterDelta()
    let subL = core.DiLoCoSubmitOuterDeltaFill(leaderDelta, nodeState, jobBundleCid, genesis.versionCid, 1, leaderPeer, Value(leaderDeltaPut), Value(optPut), 3, 3 * D8InnerSteps, D8InnerSteps, 1, 2)
    if IsErr(subL):
        return die(Error(subL))
    var workerDelta = core.DiLoCoOuterDelta()
    let subW = core.DiLoCoSubmitOuterDeltaFill(workerDelta, nodeState, jobBundleCid, genesis.versionCid, 1, workerPeer, Value(workerDeltaPut), Value(optPut), 3, 3 * D8InnerSteps, D8InnerSteps, 1, 2)
    if IsErr(subW):
        return die(Error(subW))
    var commit = core.DiLoCoMergeCommit()
    var version = core.DiLoCoGlobalVersion()
    let mergeRes = outer.DiLoCoOuterMergeAndPublishFill(commit, version, store, nodeState, jobBundleCid, leaderPeer, 64)
    if IsErr(mergeRes):
        return die(Error(mergeRes))

    var mergedW: int32[]
    let mergedLoad = loadValues(store, version.modelRef)
    if IsErr(mergedLoad):
        return die(Error(mergedLoad))
    let mergedHash = expert.DiLoCoExpertHashI32sWith(961, Value(mergedLoad))
    echo(strings.ConcatStr("d8_merge_hash=", strings.Int64ToStr(mergedHash)))
    echo(" diloco_quic_d8_replay ok")
    return 0
