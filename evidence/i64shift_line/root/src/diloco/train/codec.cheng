# DiLoCo train artifacts: self-describing little-endian i32 vectors.
# First word is count; remaining words are parameters. Hash identity is the
# raw payload bytes (blobCid), so a count drift is a CID drift.

import std/result
import std/rawbytes as rawbytes

fn DiLoCoTrainWriteI32LE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, value & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(buf, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(buf, offset + 3, (value >> 24) & 255)

fn DiLoCoTrainReadI32LE(buf: rawbytes.Bytes, offset: int32): int32 =
    let b0: int64 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1: int64 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2: int64 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3: int64 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    var raw: int64 = b0 + b1 * int64(256) + b2 * int64(65536) + b3 * int64(16777216)
    if raw > int64(2147483647):
        raw = raw - int64(4294967296)
    return int32(raw)

fn DiLoCoTrainSaturateI64(value: int64): int32 =
    if value > int64(2147483647):
        return 2147483647
    if value < int64(-2147483648):
        return -2147483648
    return int32(value)

fn DiLoCoTrainRoundDivI64(numer: int64, denom: int64): int64 =
    if denom <= int64(0):
        return int64(0)
    let half = denom / int64(2)
    if numer >= int64(0):
        return (numer + half) / denom
    return (numer - half) / denom

@borrows
fn DiLoCoTrainCopyI32(src: int32[]): int32[] =
    var out: int32[]
    for i in 0..<src.len:
        add(out, src[i])
    return out

@borrows
fn DiLoCoTrainPackI32Fill(out: var rawbytes.Bytes, values: int32[]): Result[bool] =
    if values.len <= 0:
        return Err[bool](" diloco train codec: empty vector")
    if values.len > 536870910:
        return Err[bool](" diloco train codec: vector too large")
    let byteCount = (values.len + 1) * 4
    out = rawbytes.BytesAlloc(byteCount)
    DiLoCoTrainWriteI32LE(out, 0, values.len)
    for i in 0..<values.len:
        DiLoCoTrainWriteI32LE(out, (i + 1) * 4, values[i])
    return Ok[bool](true)

fn DiLoCoTrainUnpackI32Fill(out: var int32[], bytes: rawbytes.Bytes): Result[bool] =
    if rawbytes.BytesLen(bytes) < 4:
        return Err[bool](" diloco train codec: truncated header")
    if (rawbytes.BytesLen(bytes) % 4) != 0:
        return Err[bool](" diloco train codec: unaligned payload")
    let count = DiLoCoTrainReadI32LE(bytes, 0)
    if count <= 0:
        return Err[bool](" diloco train codec: count")
    if rawbytes.BytesLen(bytes) != (count + 1) * 4:
        return Err[bool](" diloco train codec: length drift")
    out = []
    for i in 0..<count:
        add(out, DiLoCoTrainReadI32LE(bytes, (i + 1) * 4))
    return Ok[bool](true)
