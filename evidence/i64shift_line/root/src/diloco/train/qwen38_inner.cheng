# DiLoCo inner on the frozen Qwen3.8 tiny hybrid.
# Production 64-layer plan stays pinned (interval 4, 16 full). Mini forward
# consumes the first 4 slots (3 GDN + 1 full attn). GDN/attn weights are
# fixture-frozen: no GDN backward, no STE. The DiLoCo blob is the i32
# lm_head (vocab x hidden + bias) trained by DiLoCoInnerSgdLinearFill.

import std/result
import std/math as m
import std/strutils as strutil
import cheng/inference/hf_qwen38_graph as hfq
import cheng/inference/qwen38_hybrid_executor as hx
import cheng/inference/qwen38_forward as fwd
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner

const
    DiLoCoQwen38TinySeed: int64 = int64(2026082301)
    DiLoCoQwen38TinyMicrosScale: float64 = 1000000.0

fn DiLoCoQwen38TinyVisionConfigChunk(): str =
    return strutil.Join([
        "\"vision_config\":{",
        "\"deepstack_visual_indexes\":[],",
        "\"depth\":27,",
        "\"hidden_act\":\"gelu_pytorch_tanh\",",
        "\"hidden_size\":1152,",
        "\"in_channels\":3,",
        "\"initializer_range\":0.02,",
        "\"intermediate_size\":4304,",
        "\"model_type\":\"qwen3_5\",",
        "\"num_heads\":16,",
        "\"num_position_embeddings\":2304,",
        "\"out_hidden_size\":5120,",
        "\"patch_size\":16,",
        "\"spatial_merge_size\":2,",
        "\"temporal_patch_size\":2",
        "},"
    ], "")

fn DiLoCoQwen38TinyPinnedConfigJson(): str =
    var layerItems: str[]
    for i in 0..<64:
        var word = "linear_attention"
        if (i + 1) % 4 == 0:
            word = "full_attention"
        add(layerItems, strutil.Join(["\"", share(word), "\""], ""))
    return strutil.Join([
        "{",
        "\"architectures\":[\"Qwen3_5ForConditionalGeneration\"],",
        "\"image_token_id\":248056,",
        "\"language_model_only\":false,",
        "\"model_type\":\"qwen3_5\",",
        "\"text_config\":{",
        "\"attention_bias\":false,",
        "\"attention_dropout\":0.0,",
        "\"attn_output_gate\":true,",
        "\"bos_token_id\":248044,",
        "\"dtype\":\"bfloat16\",",
        "\"eos_token_id\":248044,",
        "\"full_attention_interval\":4,",
        "\"head_dim\":256,",
        "\"hidden_act\":\"silu\",",
        "\"hidden_size\":5120,",
        "\"initializer_range\":0.02,",
        "\"intermediate_size\":17408,",
        "\"layer_types\":[", strutil.Join(layerItems, ","), "],",
        "\"linear_conv_kernel_dim\":4,",
        "\"linear_key_head_dim\":128,",
        "\"linear_num_key_heads\":16,",
        "\"linear_num_value_heads\":48,",
        "\"linear_value_head_dim\":128,",
        "\"mamba_ssm_dtype\":\"float32\",",
        "\"max_position_embeddings\":262144,",
        "\"model_type\":\"qwen3_5_text\",",
        "\"mtp_num_hidden_layers\":1,\"mtp_use_dedicated_embeddings\":false,",
        "\"num_attention_heads\":24,",
        "\"num_hidden_layers\":64,",
        "\"num_key_value_heads\":4,",
        "\"output_gate_type\":\"swish\",",
        "\"pad_token_id\":null,",
        "\"partial_rotary_factor\":0.25,",
        "\"rms_norm_eps\":1e-06,",
        "\"rope_parameters\":{\"mrope_interleaved\":true,\"mrope_section\":[11,11,10],\"partial_rotary_factor\":0.25,\"rope_theta\":10000000,\"rope_type\":\"default\"},",
        "\"tie_word_embeddings\":false,",
        "\"use_cache\":true,",
        "\"vocab_size\":248320,",
        "\"transformers_version\":\"5.8.0.dev0\",",
        "\"video_token_id\":248057,",
        DiLoCoQwen38TinyVisionConfigChunk(),
        "\"vision_end_token_id\":248054,",
        "\"vision_start_token_id\":248053",
        "}"
    ], "")

fn DiLoCoQwen38TinyPinnedPlanBuild(): Result[hx.Qwen38HybridLayerPlan] =
    let configJson = DiLoCoQwen38TinyPinnedConfigJson()
    let profileRes = hfq.HfQwen38DeployProfileFromConfig(hfq.HfQwen38RepoId, share(configJson))
    if IsErr(profileRes):
        return Err[hx.Qwen38HybridLayerPlan](Error(profileRes))
    return hx.Qwen38HybridLayerPlanBuild(Value(profileRes))

fn DiLoCoQwen38TinyFrozenWeightsBuild(): Result[fwd.Qwen38MiniWeights] =
    return fwd.Qwen38MiniWeightsBuild(DiLoCoQwen38TinySeed)

fn DiLoCoQwen38TinyLmHeadParamCount(): Result[int32] =
    return inner.DiLoCoLinearParamCount(fwd.Qwen38MiniVocab, fwd.Qwen38MiniHidden)

fn DiLoCoQwen38TinyRoundToI64(value: float64): int64 =
    if value >= 0.0:
        return int64(value + 0.5)
    return int64(value - 0.5)

@borrows
fn DiLoCoQwen38TinyQuantizeHiddenFill(out: var int32[], hidden: float64[]): Result[bool] =
    if hidden.len != fwd.Qwen38MiniHidden:
        return Err[bool](" diloco qwen38 tiny: hidden length")
    let scale = float64(inner.DiLoCoLinearScale)
    out = []
    var anyNz: bool
    anyNz = false
    for i in 0..<hidden.len:
        let q = codec.DiLoCoTrainSaturateI64(DiLoCoQwen38TinyRoundToI64(hidden[i] * scale))
        add(out, q)
        if q != 0:
            anyNz = true
    if !anyNz:
        return Err[bool](" diloco qwen38 tiny: hidden quantized to zero")
    return Ok[bool](true)

@borrows
fn DiLoCoQwen38TinyLastHiddenI32Fill(out: var int32[],
                                      weights: fwd.Qwen38MiniWeights,
                                      plan: hx.Qwen38HybridLayerPlan,
                                      tokenIds: int32[]): Result[bool] =
    var hidden: float64[]
    for i in 0..<fwd.Qwen38MiniHidden:
        add(hidden, 0.0)
    let hidOk = fwd.Qwen38MiniForwardLastHiddenFill(hidden, weights, plan, tokenIds)
    if IsErr(hidOk):
        return Err[bool](Error(hidOk))
    return DiLoCoQwen38TinyQuantizeHiddenFill(out, hidden)

fn DiLoCoQwen38TinyOneHotFill(out: var int32[], target: int32, vocab: int32): Result[bool] =
    if vocab <= 0:
        return Err[bool](" diloco qwen38 tiny: vocab")
    if target < 0 || target >= vocab:
        return Err[bool](" diloco qwen38 tiny: target range")
    out = []
    for v in 0..<vocab:
        if v == target:
            add(out, inner.DiLoCoLinearScale)
        else:
            add(out, 0)
    return Ok[bool](true)

@borrows
fn DiLoCoQwen38TinyAppendSampleFill(xs: var int32[],
                                     ys: var int32[],
                                     weights: fwd.Qwen38MiniWeights,
                                     plan: hx.Qwen38HybridLayerPlan,
                                     tokenIds: int32[],
                                     target: int32): Result[bool] =
    var hiddenI32: int32[]
    let hidOk = DiLoCoQwen38TinyLastHiddenI32Fill(hiddenI32, weights, plan, tokenIds)
    if IsErr(hidOk):
        return Err[bool](Error(hidOk))
    if hiddenI32.len != fwd.Qwen38MiniHidden:
        return Err[bool](" diloco qwen38 tiny: hidden rank")
    for i in 0..<hiddenI32.len:
        add(xs, hiddenI32[i])
    var oneHot: int32[]
    let yOk = DiLoCoQwen38TinyOneHotFill(oneHot, target, fwd.Qwen38MiniVocab)
    if IsErr(yOk):
        return Err[bool](Error(yOk))
    for v in 0..<oneHot.len:
        add(ys, oneHot[v])
    return Ok[bool](true)

@borrows
fn DiLoCoQwen38TinyNllOneMicros(lmHead: int32[],
                                 x: int32[],
                                 xOff: int32,
                                 target: int32,
                                 vocab: int32,
                                 hidden: int32): Result[int64] =
    if target < 0 || target >= vocab:
        return Err[int64](" diloco qwen38 tiny: nll target")
    var logits: int32[]
    let fwdOk = inner.DiLoCoLinearForwardOneFill(logits, lmHead, x, xOff, vocab, hidden)
    if IsErr(fwdOk):
        return Err[int64](Error(fwdOk))
    if logits.len != vocab:
        return Err[int64](" diloco qwen38 tiny: nll logits")
    var maxLogit: int32 = logits[0]
    for v in 1..<vocab:
        if logits[v] > maxLogit:
            maxLogit = logits[v]
    let gap64: int64 = int64(maxLogit) - int64(logits[target])
    if gap64 < int64(0):
        return Err[int64](" diloco qwen38 tiny: nll max")
    let boundDelta: int64 = int64(0 - inner.DiLoCoLinearScale * 40)
    let scale = float64(inner.DiLoCoLinearScale)
    var tieCount: int32 = 0
    var sumExp: float64 = 0.0
    var extraCount: int32 = 0
    for v in 0..<vocab:
        let delta64: int64 = int64(logits[v]) - int64(maxLogit)
        if delta64 == int64(0):
            tieCount = tieCount + 1
        elif delta64 >= boundDelta:
            sumExp = sumExp + m.Exp(float64(delta64) / scale)
            extraCount = extraCount + 1
    if tieCount <= 0:
        return Err[int64](" diloco qwen38 tiny: softmax ties")
    let gapMicros: int64 = gap64 * int64(1000)
    if extraCount == 0:
        if tieCount == 1:
            return Ok[int64](gapMicros)
        return Ok[int64](gapMicros + DiLoCoQwen38TinyRoundToI64(m.Ln(float64(tieCount)) * DiLoCoQwen38TinyMicrosScale))
    sumExp = sumExp + float64(tieCount)
    return Ok[int64](gapMicros + DiLoCoQwen38TinyRoundToI64(m.Ln(sumExp) * DiLoCoQwen38TinyMicrosScale))

@borrows
fn DiLoCoQwen38TinyNllMicrosSum(lmHead: int32[],
                                 xs: int32[],
                                 targets: int32[],
                                 sampleCount: int32,
                                 vocab: int32,
                                 hidden: int32): Result[int64] =
    if sampleCount <= 0:
        return Err[int64](" diloco qwen38 tiny: sample count")
    if targets.len != sampleCount:
        return Err[int64](" diloco qwen38 tiny: target length")
    if xs.len != sampleCount * hidden:
        return Err[int64](" diloco qwen38 tiny: xs length")
    var total: int64 = int64(0)
    for s in 0..<sampleCount:
        let one = DiLoCoQwen38TinyNllOneMicros(lmHead, xs, s * hidden, targets[s], vocab, hidden)
        if IsErr(one):
            return Err[int64](Error(one))
        total = total + Value(one)
    return Ok[int64](total)
