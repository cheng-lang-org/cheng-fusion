# DiLoCo inner loop: local SGD on a scaled i32 linear map.
# y = Wx + b, MSE vs target. Step count must equal the lease budget.

import std/result
import cheng/DiLoCo/train/codec as codec

const
    DiLoCoLinearScale: int32 = 1000

fn DiLoCoLinearParamCount(outFeatures: int32, inFeatures: int32): Result[int32] =
    if outFeatures <= 0 || inFeatures <= 0:
        return Err[int32](" diloco inner: feature count")
    return Ok[int32](outFeatures * inFeatures + outFeatures)

fn DiLoCoLinearZerosFill(out: var int32[], outFeatures: int32, inFeatures: int32): Result[bool] =
    let nRes = DiLoCoLinearParamCount(outFeatures, inFeatures)
    if IsErr(nRes):
        return Err[bool](Error(nRes))
    out = []
    for i in 0..<Value(nRes):
        add(out, 0)
    return Ok[bool](true)

@borrows
fn DiLoCoLinearForwardOneFill(outY: var int32[],
                                weights: int32[],
                                x: int32[],
                                xOff: int32,
                                outFeatures: int32,
                                inFeatures: int32): Result[bool] =
    let nRes = DiLoCoLinearParamCount(outFeatures, inFeatures)
    if IsErr(nRes):
        return Err[bool](Error(nRes))
    if weights.len != Value(nRes):
        return Err[bool](" diloco inner: weight length")
    if xOff < 0 || inFeatures > x.len - xOff:
        return Err[bool](" diloco inner: x window")
    let scale = int64(DiLoCoLinearScale)
    let biasOff = outFeatures * inFeatures
    outY = []
    for c in 0..<outFeatures:
        var acc: int64 = int64(weights[biasOff + c]) * scale
        for k in 0..<inFeatures:
            acc = acc + int64(weights[c * inFeatures + k]) * int64(x[xOff + k])
        add(outY, codec.DiLoCoTrainSaturateI64(codec.DiLoCoTrainRoundDivI64(acc, scale)))
    return Ok[bool](true)

@borrows
fn DiLoCoLinearMseSum(weights: int32[],
                        xs: int32[],
                        ys: int32[],
                        sampleCount: int32,
                        outFeatures: int32,
                        inFeatures: int32): Result[int64] =
    if sampleCount <= 0:
        return Err[int64](" diloco inner: sample count")
    if xs.len != sampleCount * inFeatures:
        return Err[int64](" diloco inner: xs length")
    if ys.len != sampleCount * outFeatures:
        return Err[int64](" diloco inner: ys length")
    var total: int64 = int64(0)
    for s in 0..<sampleCount:
        var yhat: int32[]
        let fwd = DiLoCoLinearForwardOneFill(yhat, weights, xs, s * inFeatures, outFeatures, inFeatures)
        if IsErr(fwd):
            return Err[int64](Error(fwd))
        for c in 0..<outFeatures:
            let err = int64(yhat[c] - ys[s * outFeatures + c])
            total = total + err * err
    return Ok[int64](total)

@borrows
fn DiLoCoInnerSgdLinearFill(outWeights: var int32[],
                              outDelta: var int32[],
                              baseWeights: int32[],
                              xs: int32[],
                              ys: int32[],
                              sampleCount: int32,
                              innerSteps: int32,
                              outFeatures: int32,
                              inFeatures: int32,
                              lrNum: int32,
                              lrDen: int32): Result[bool] =
    if innerSteps <= 0:
        return Err[bool](" diloco inner: step budget")
    if lrNum <= 0 || lrDen <= 0:
        return Err[bool](" diloco inner: learning rate")
    if sampleCount <= 0:
        return Err[bool](" diloco inner: sample count")
    let nRes = DiLoCoLinearParamCount(outFeatures, inFeatures)
    if IsErr(nRes):
        return Err[bool](Error(nRes))
    let n = Value(nRes)
    if baseWeights.len != n:
        return Err[bool](" diloco inner: base length")
    if xs.len != sampleCount * inFeatures:
        return Err[bool](" diloco inner: xs length")
    if ys.len != sampleCount * outFeatures:
        return Err[bool](" diloco inner: ys length")
    var w = codec.DiLoCoTrainCopyI32(baseWeights)
    let scale = int64(DiLoCoLinearScale)
    let biasOff = outFeatures * inFeatures
    for step in 0..<innerSteps:
        var grad: int32[]
        for p in 0..<n:
            add(grad, 0)
        for s in 0..<sampleCount:
            var yhat: int32[]
            let fwd = DiLoCoLinearForwardOneFill(yhat, w, xs, s * inFeatures, outFeatures, inFeatures)
            if IsErr(fwd):
                return Err[bool](Error(fwd))
            for c in 0..<outFeatures:
                let err = int64(yhat[c] - ys[s * outFeatures + c])
                let gBias = codec.DiLoCoTrainRoundDivI64(err * int64(lrNum), int64(lrDen))
                grad[biasOff + c] = grad[biasOff + c] + codec.DiLoCoTrainSaturateI64(gBias)
                for k in 0..<inFeatures:
                    let gW = codec.DiLoCoTrainRoundDivI64(err * int64(xs[s * inFeatures + k]) * int64(lrNum),
                                                           int64(lrDen) * scale)
                    let idx = c * inFeatures + k
                    grad[idx] = grad[idx] + codec.DiLoCoTrainSaturateI64(gW)
        for p in 0..<n:
            let avgG = codec.DiLoCoTrainRoundDivI64(int64(grad[p]), int64(sampleCount))
            w[p] = codec.DiLoCoTrainSaturateI64(int64(w[p]) - avgG)
    outWeights = codec.DiLoCoTrainCopyI32(w)
    outDelta = []
    for p in 0..<n:
        add(outDelta, codec.DiLoCoTrainSaturateI64(int64(w[p]) - int64(baseWeights[p])))
    return Ok[bool](true)
