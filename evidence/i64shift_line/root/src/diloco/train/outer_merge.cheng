# DiLoCo outer step: token-weighted average of worker parameter deltas
# applied to the shared base. Leader may not invent merged bytes.

import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec

@borrows
fn DiLoCoOuterWeightedDeltaFill(outMerged: var int32[],
                                  base: int32[],
                                  deltas: int32[],
                                  tokenCounts: int32[],
                                  workerCount: int32): Result[bool] =
    if workerCount <= 0:
        return Err[bool](" diloco outer: worker count")
    if base.len <= 0:
        return Err[bool](" diloco outer: empty base")
    if tokenCounts.len != workerCount:
        return Err[bool](" diloco outer: token count length")
    if deltas.len != workerCount * base.len:
        return Err[bool](" diloco outer: delta length")
    var tokenSum: int64 = int64(0)
    for w in 0..<workerCount:
        if tokenCounts[w] <= 0:
            return Err[bool](" diloco outer: token count")
        tokenSum = tokenSum + int64(tokenCounts[w])
    outMerged = []
    for p in 0..<base.len:
        var acc: int64 = int64(0)
        for w in 0..<workerCount:
            acc = acc + int64(tokenCounts[w]) * int64(deltas[w * base.len + p])
        let avgDelta = codec.DiLoCoTrainRoundDivI64(acc, tokenSum)
        add(outMerged, codec.DiLoCoTrainSaturateI64(int64(base[p]) + avgDelta))
    return Ok[bool](true)

fn DiLoCoOuterMergeAndPublishFill(outCommit: var core.DiLoCoMergeCommit,
                                    outVersion: var core.DiLoCoGlobalVersion,
                                    store: var astore.DiLoCoArtifactStore,
                                    state: var core.DiLoCoState,
                                    jobBundleCid: layout.FixedBytes32,
                                    leaderPeerId: types.Libp2pPeerId,
                                    shardPayloadBytes: int32): Result[bool] =
    let jobPos = core.DiLoCoJobPos(state, jobBundleCid)
    if jobPos < 0:
        return Err[bool](" diloco outer: job missing")
    let versionPos = core.DiLoCoVersionPos(state, state.jobs[jobPos].currentGlobalVersionCid)
    if versionPos < 0:
        return Err[bool](" diloco outer: base version missing")
    let cohortPos = core.DiLoCoCohortPos(state, jobBundleCid)
    if cohortPos < 0:
        return Err[bool](" diloco outer: cohort missing")
    var baseBytes = rawbytes.EmptyBytes()
    let baseGet = astore.DiLoCoArtifactStoreGetFill(baseBytes, store, state.versions[versionPos].modelRef)
    if IsErr(baseGet):
        return Err[bool](Error(baseGet))
    var base: int32[]
    let baseUnpack = codec.DiLoCoTrainUnpackI32Fill(base, baseBytes)
    if IsErr(baseUnpack):
        return Err[bool](Error(baseUnpack))
    let memberCount = state.cohorts[cohortPos].fixedMemberCount
    if memberCount <= 0:
        return Err[bool](" diloco outer: empty cohort")
    var flatDeltas: int32[]
    var tokenCounts: int32[]
    var optAcc: int32[]
    var optInit: bool
    optInit = false
    for m in 0..<state.cohorts[cohortPos].members.len:
        let peer = state.cohorts[cohortPos].members[m]
        let deltaPos = core.DiLoCoDeltaPos(state,
                                             jobBundleCid,
                                             state.jobs[jobPos].currentGlobalVersionCid,
                                             state.jobs[jobPos].currentOuterStep,
                                             peer)
        if deltaPos < 0:
            return Err[bool](" diloco outer: missing worker delta")
        let delta = state.deltas[deltaPos]
        var deltaBytes = rawbytes.EmptyBytes()
        let deltaGet = astore.DiLoCoArtifactStoreGetFill(deltaBytes, store, delta.modelDeltaRef)
        if IsErr(deltaGet):
            return Err[bool](Error(deltaGet))
        var dw: int32[]
        let deltaUnpack = codec.DiLoCoTrainUnpackI32Fill(dw, deltaBytes)
        if IsErr(deltaUnpack):
            return Err[bool](Error(deltaUnpack))
        if dw.len != base.len:
            return Err[bool](" diloco outer: delta rank drift")
        for p in 0..<dw.len:
            add(flatDeltas, dw[p])
        add(tokenCounts, delta.tokenCount)
        var optBytes = rawbytes.EmptyBytes()
        let optGet = astore.DiLoCoArtifactStoreGetFill(optBytes, store, delta.optimizerDeltaRef)
        if IsErr(optGet):
            return Err[bool](Error(optGet))
        var od: int32[]
        let optUnpack = codec.DiLoCoTrainUnpackI32Fill(od, optBytes)
        if IsErr(optUnpack):
            return Err[bool](Error(optUnpack))
        if od.len != base.len:
            return Err[bool](" diloco outer: optimizer rank drift")
        if !optInit:
            optAcc = codec.DiLoCoTrainCopyI32(od)
            optInit = true
        else:
            for p in 0..<od.len:
                optAcc[p] = codec.DiLoCoTrainSaturateI64(int64(optAcc[p]) + int64(od[p]))
    if tokenCounts.len != memberCount:
        return Err[bool](" diloco outer: member delta count")
    var merged: int32[]
    let mergeRes = DiLoCoOuterWeightedDeltaFill(merged, base, flatDeltas, tokenCounts, memberCount)
    if IsErr(mergeRes):
        return Err[bool](Error(mergeRes))
    var mergedBytes = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(mergedBytes, merged)
    if IsErr(packRes):
        return Err[bool](Error(packRes))
    var mergedRef = core.DiLoCoArtifactRef()
    let putRes = astore.DiLoCoArtifactStorePutFill(mergedRef, store, jobBundleCid, mergedBytes, shardPayloadBytes)
    if IsErr(putRes):
        return Err[bool](Error(putRes))
    if !optInit:
        return Err[bool](" diloco outer: optimizer missing")
    for p in 0..<optAcc.len:
        optAcc[p] = codec.DiLoCoTrainSaturateI64(codec.DiLoCoTrainRoundDivI64(int64(optAcc[p]), int64(memberCount)))
    var optBytesOut = rawbytes.EmptyBytes()
    let optPack = codec.DiLoCoTrainPackI32Fill(optBytesOut, optAcc)
    if IsErr(optPack):
        return Err[bool](Error(optPack))
    var optRef = core.DiLoCoArtifactRef()
    let optPut = astore.DiLoCoArtifactStorePutFill(optRef, store, jobBundleCid, optBytesOut, shardPayloadBytes)
    if IsErr(optPut):
        return Err[bool](Error(optPut))
    return core.DiLoCoPublishMergeCommitFill(outCommit, outVersion, state, jobBundleCid, leaderPeerId, mergedRef, optRef)
