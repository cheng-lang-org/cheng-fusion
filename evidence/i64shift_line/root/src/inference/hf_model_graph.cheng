    if IsErr(graph):
        return Err[ws.WeightSafetensorsShardHeaderPreflight](Error(graph))
    let peers = HfGlm52W4Afp8AuditPeerIds(Value(graph), auditPeerId)
    if IsErr(peers):
        return Err[ws.WeightSafetensorsShardHeaderPreflight](Error(peers))
    let shardIndex = HfGlm52W4Afp8BuildAuditShardIndex(
        profile,
        indexJson,
        Value(graph),
        baseDir,
        Value(peers),
        tensorScale
    )
    if IsErr(shardIndex):
        return Err[ws.WeightSafetensorsShardHeaderPreflight](Error(shardIndex))
    return ws.WeightSafetensorsBuildShardHeaderPreflight(Value(shardIndex), Value(graph))

