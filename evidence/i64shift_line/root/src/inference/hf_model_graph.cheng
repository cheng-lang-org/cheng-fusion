const
    HfGlm52W4Afp8DeployProfileSchema = "cheng.inference.hf_glm52_w4afp8_deploy_profile.v1"
    HfGlm52W4Afp8RepoId = "PhalaCloud/GLM-5.2-W4AFP8"
    HfGlm52W4Afp8Architecture = "GlmMoeDsaForCausalLM"
    HfGlm52W4Afp8ModelType = "deepseek_v3"
    HfGlm52W4Afp8QuantMethod = "w4afp8"
    HfGlm52W4Afp8DeploymentReceiptSchema = "cheng.inference.hf_glm52_w4afp8_deployment_receipt.v1"
    HfGlm52W4Afp8AuditShardReceiptSchema = "cheng.inference.hf_glm52_w4afp8_audit_shard_receipt.v1"

