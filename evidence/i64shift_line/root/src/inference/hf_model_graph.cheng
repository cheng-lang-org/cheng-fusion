    HfGlmMoeConfig =
        modelType: str
        vocabSize: int32
        hiddenSize: int32
        layerCount: int32
        attentionHeads: int32
        keyValueHeads: int32
        headDim: int32
        intermediateSize: int32
        expertCount: int32
        topK: int32
        tieWordEmbeddings: bool
        ropeTheta: float64
        sourceConfigHash: int64

    HfDenseTransformerConfig =
        modelType: str
        vocabSize: int32
        hiddenSize: int32
        layerCount: int32
        attentionHeads: int32
        keyValueHeads: int32
        headDim: int32
        intermediateSize: int32
        tieWordEmbeddings: bool
        ropeTheta: float64
        sourceConfigHash: int64

    HfGlm52W4Afp8DeployProfile =
        schema: str
        repoId: str
        architecture: str
        modelType: str
        vocabSize: int32
        hiddenSize: int32
        layerCount: int32
        attentionHeads: int32
        keyValueHeads: int32
        headDim: int32
        indexHeadDim: int32
        indexHeads: int32
        indexTopK: int32
        indexTopKFreq: int32
        qLoraRank: int32
        kvLoraRank: int32
        qkHeadDim: int32
        qkNopeHeadDim: int32
        qkRopeHeadDim: int32
        vHeadDim: int32
        denseIntermediateSize: int32
        moeIntermediateSize: int32
        denseLayerCount: int32
        routedExpertCount: int32
        sharedExpertCount: int32
        topK: int32
        maxPositionEmbeddings: int32
        mtpLayerCount: int32
        mtpStartLayer: int32
        indexShareForMtpIteration: bool
        quantMethod: str
        expectedShardFileCount: int32
        expectedTotalWeightBytes: int64
        ropeTheta: float64
        sourceConfigHash: int64
        profileHash: int64

    HfGlm52W4Afp8DeploymentReceipt =
        schema: str
        repoId: str
        profileHash: int64
        sourceConfigHash: int64
        indexHash: int64
        expectedShardFileCount: int32
        expectedTotalWeightBytes: int64
        quantMethod: str
        maxPositionEmbeddings: int32
        mtpLayerCount: int32
        receiptHash: int64

    HfGlm52W4Afp8AuditShardReceipt =
        schema: str
        repoId: str
        modelCid: str
        baseDir: str
        auditPeerId: str
        profileHash: int64
        sourceConfigHash: int64
        deploymentReceiptHash: int64
        indexHash: int64
        auditGraphHash: int64
        auditShardIndexHash: int64
        auditWeightCount: int32
        auditIndexEntryCount: int32
        tensorScale: int32
        receiptHash: int64

    HfGlm52W4Afp8LayerKey =
        layerIndex: int32
        suffix: str

    HfGlm52W4Afp8JsonStringRead =
        value: str
        nextPos: int32

fn HfModelGraphHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(104729) + value + int64(197)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn HfModelGraphHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = HfModelGraphHashStep(h, int64(Int32(text[i])))
    return h

fn HfGlm52W4Afp8ExpectedTotalWeightBytesValue(): int64 =
    return int64(399000) * int64(1000000) + int64(693862592)

fn HfGlm52W4Afp8ShardFileMarker(shardIndex: int32): str =
    if shardIndex <= 0 || shardIndex > 40:
        return ""
    if shardIndex < 10:
        return strutil.Join(["model-0000", strings.IntToStr(shardIndex), "-of-00040.safetensors"], "")
    return strutil.Join(["model-000", strings.IntToStr(shardIndex), "-of-00040.safetensors"], "")

fn hfJsonIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn hfJsonSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && hfJsonIsWs(text[i]):
        i = i + 1
    return i

@borrows
fn hfJsonRawExactNonNegativeInt(raw: str): Result[int32] =
    var pos: int32 = hfJsonSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] < '0' || raw[pos] > '9':
        return Err[int32]("hf glm moe config: integer")
    var value: int64
    while pos < raw.len && raw[pos] >= '0' && raw[pos] <= '9':
        let digit = int64(Int32(raw[pos]) - Int32('0'))
        if value > (int64(2147483647) - digit) / int64(10):
            return Err[int32]("hf glm moe config: integer range")
        value = value * int64(10) + digit
        pos = pos + 1
    pos = hfJsonSkipWs(raw, pos)
    if pos != raw.len:
        return Err[int32]("hf glm moe config: integer trailing")
    return Ok[int32](int32(value))

@borrows
fn hfJsonRawExactNonNegativeInt64(raw: str): Result[int64] =
    var pos: int32 = hfJsonSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] < '0' || raw[pos] > '9':
        return Err[int64]("hf glm52 w4afp8: integer")
    var value: int64
    while pos < raw.len && raw[pos] >= '0' && raw[pos] <= '9':
        let digit = int64(Int32(raw[pos]) - Int32('0'))
        if value > (int64(9223372036854775807) - digit) / int64(10):
            return Err[int64]("hf glm52 w4afp8: integer range")
        value = value * int64(10) + digit
        pos = pos + 1
    pos = hfJsonSkipWs(raw, pos)
    if pos != raw.len:
        return Err[int64]("hf glm52 w4afp8: integer trailing")
    return Ok[int64](value)

# Decimal power of ten via recursion (not the shared std/math powFloat,
# whose `while e > 0` loop silently no-ops for negative exponents on this
# backend - see std/math.cheng's mathReduceRound/mathMagnitudeIsNonNeg
# comments for the wider defect class this is one instance of).
fn hfJsonPow10Positive(exp: int32): float64 =
    if exp <= 0:
        return 1.0
    return 10.0 * hfJsonPow10Positive(exp - 1)

fn hfJsonPow10(exp: int32): float64 =
    if exp < 0:
        return 1.0 / hfJsonPow10Positive(0 - exp)
    return hfJsonPow10Positive(exp)

# Non-negative JSON number -> float64: accumulate all digits (integer part
# and fraction part share one int64 mantissa) plus a separate signed decimal
# exponent, then combine via mantissa * 10^(exp10 - fracDigits) using the
# existing integer-exponent Pow. Deliberately does not go through any
# runtime IEEE-bit-decode path (float64(int64) cast + one Pow call is the
# full arithmetic surface), matching the rest of this file's from-scratch
# JSON-number handling.
@borrows
fn hfJsonRawExactNonNegativeFloat64(raw: str): Result[float64] =
    var pos: int32 = hfJsonSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] < '0' || raw[pos] > '9':
        return Err[float64]("hf glm moe config: float")
    var mantissa: int64
    var fracDigits: int32
    var sawDot: bool
    while pos < raw.len && ((raw[pos] >= '0' && raw[pos] <= '9') || raw[pos] == '.'):
        if raw[pos] == '.':
            if sawDot:
                return Err[float64]("hf glm moe config: float")
            sawDot = true
            pos = pos + 1
            continue
        let digit = int64(Int32(raw[pos]) - Int32('0'))
        if mantissa > (int64(9223372036854775807) - digit) / int64(10):
            return Err[float64]("hf glm moe config: float range")
        mantissa = mantissa * int64(10) + digit
        if sawDot:
            fracDigits = fracDigits + 1
        pos = pos + 1
    var exp10: int32
    if pos < raw.len && (raw[pos] == 'e' || raw[pos] == 'E'):
        pos = pos + 1
        var expSign: int32 = 1
        if pos < raw.len && (raw[pos] == '+' || raw[pos] == '-'):
            if raw[pos] == '-':
                expSign = -1
            pos = pos + 1
        if pos >= raw.len || raw[pos] < '0' || raw[pos] > '9':
            return Err[float64]("hf glm moe config: float exponent")
        var expDigits: int32
        while pos < raw.len && raw[pos] >= '0' && raw[pos] <= '9':
            expDigits = expDigits * 10 + (Int32(raw[pos]) - Int32('0'))
            pos = pos + 1
        exp10 = expSign * expDigits
    pos = hfJsonSkipWs(raw, pos)
    if pos != raw.len:
        return Err[float64]("hf glm moe config: float trailing")
    let finalExp = exp10 - fracDigits
    return Ok[float64](float64(mantissa) * hfJsonPow10(finalExp))

@borrows
fn HfGlmMoeConfigOptionalFloat64(configJson: str, name: str, defaultValue: float64): Result[float64] =
    let raw = jsonfield.CsgCoreJsonTopRawField(configJson, name)
    if !raw.found:
        return Ok[float64](defaultValue)
    return hfJsonRawExactNonNegativeFloat64(raw.value)

@borrows
fn HfGlmMoeConfigOptionalInt(configJson: str, name: str): Result[int32] =
    let raw = jsonfield.CsgCoreJsonTopRawField(configJson, name)
    if !raw.found:
        return Ok[int32](0)
    return hfJsonRawExactNonNegativeInt(raw.value)

@borrows
fn HfGlmMoeConfigRequiredInt(configJson: str, name: str): Result[int32] =
    let value = HfGlmMoeConfigOptionalInt(configJson, name)
    if IsErr(value):
        return Err[int32](Error(value))
    if Value(value) <= 0:
        return Err[int32](strutil.Join(["hf glm moe config: missing ", share(name)], ""))
    return value

@borrows
fn HfGlmMoeConfigFirstPositive(configJson: str,
                               names: str[],
                               label: str): Result[int32] =
    for i in 0..<names.len:
        let value = HfGlmMoeConfigOptionalInt(configJson, names[i])
        if IsErr(value):
            return Err[int32](Error(value))
        if Value(value) > 0:
            return value
    return Err[int32](strutil.Join(["hf glm moe config: missing ", share(label)], ""))

@borrows
fn HfGlmMoeConfigOptionalFirstPositive(configJson: str,
                                       names: str[]): Result[int32] =
    for i in 0..<names.len:
        let value = HfGlmMoeConfigOptionalInt(configJson, names[i])
        if IsErr(value):
            return Err[int32](Error(value))
        if Value(value) > 0:
            return value
    return Ok[int32](0)

@borrows
fn HfGlmMoeConfigOptionalBoolInt(configJson: str, name: str, defaultValue: int32): Result[int32] =
    let raw = jsonfield.CsgCoreJsonTopRawField(configJson, name)
    if !raw.found:
        return Ok[int32](defaultValue)
    var value = strutil.Strip(raw.value)
    if value == "true":
        return Ok[int32](1)
    if value == "false":
        return Ok[int32](0)
    return Err[int32](strutil.Join(["hf glm moe config: bool ", share(name)], ""))

@borrows
fn HfGlm52W4Afp8ConfigRequiredBool(configJson: str, name: str): Result[bool] =
    let raw = jsonfield.CsgCoreJsonTopRawField(configJson, name)
    if !raw.found:
        return Err[bool](strutil.Join(["hf glm52 w4afp8: missing ", share(name)], ""))
    var value = strutil.Strip(raw.value)
    if value == "true":
        return Ok[bool](true)
    if value == "false":
        return Ok[bool](false)
    return Err[bool](strutil.Join(["hf glm52 w4afp8: bool ", share(name)], ""))

@borrows
fn HfGlm52W4Afp8ProfileHash(profile: HfGlm52W4Afp8DeployProfile): int64 =
    var h: int64 = int64(197)
    h = HfModelGraphHashTextWith(h, profile.schema)
    h = HfModelGraphHashTextWith(h, profile.repoId)
    h = HfModelGraphHashTextWith(h, profile.architecture)
    h = HfModelGraphHashTextWith(h, profile.modelType)
    h = HfModelGraphHashStep(h, int64(profile.vocabSize))
    h = HfModelGraphHashStep(h, int64(profile.hiddenSize))
    h = HfModelGraphHashStep(h, int64(profile.layerCount))
    h = HfModelGraphHashStep(h, int64(profile.attentionHeads))
    h = HfModelGraphHashStep(h, int64(profile.keyValueHeads))
    h = HfModelGraphHashStep(h, int64(profile.headDim))
    h = HfModelGraphHashStep(h, int64(profile.indexHeadDim))
    h = HfModelGraphHashStep(h, int64(profile.indexHeads))
    h = HfModelGraphHashStep(h, int64(profile.indexTopK))
    h = HfModelGraphHashStep(h, int64(profile.indexTopKFreq))
    h = HfModelGraphHashStep(h, int64(profile.qLoraRank))
    h = HfModelGraphHashStep(h, int64(profile.kvLoraRank))
    h = HfModelGraphHashStep(h, int64(profile.qkHeadDim))
    h = HfModelGraphHashStep(h, int64(profile.qkNopeHeadDim))
    h = HfModelGraphHashStep(h, int64(profile.qkRopeHeadDim))
    h = HfModelGraphHashStep(h, int64(profile.vHeadDim))
    h = HfModelGraphHashStep(h, int64(profile.denseIntermediateSize))
    h = HfModelGraphHashStep(h, int64(profile.moeIntermediateSize))
    h = HfModelGraphHashStep(h, int64(profile.denseLayerCount))
    h = HfModelGraphHashStep(h, int64(profile.routedExpertCount))
    h = HfModelGraphHashStep(h, int64(profile.sharedExpertCount))
    h = HfModelGraphHashStep(h, int64(profile.topK))
    h = HfModelGraphHashStep(h, int64(profile.maxPositionEmbeddings))
    h = HfModelGraphHashStep(h, int64(profile.mtpLayerCount))
    h = HfModelGraphHashStep(h, int64(profile.mtpStartLayer))
    if profile.indexShareForMtpIteration:
        h = HfModelGraphHashStep(h, int64(1))
    else:
        h = HfModelGraphHashStep(h, int64(0))
    h = HfModelGraphHashTextWith(h, profile.quantMethod)
    h = HfModelGraphHashStep(h, int64(profile.expectedShardFileCount))
    h = HfModelGraphHashStep(h, profile.expectedTotalWeightBytes)
    h = HfModelGraphHashStep(h, int64(profile.ropeTheta * 1000000.0))
    h = HfModelGraphHashStep(h, profile.sourceConfigHash)
    return h

@borrows
fn HfGlm52W4Afp8IndexHash(indexJson: str): int64 =
    if indexJson == "":
        return int64(0)
    return HfModelGraphHashTextWith(int64(197), indexJson)

@borrows
fn HfGlm52W4Afp8DeploymentReceiptHash(receipt: HfGlm52W4Afp8DeploymentReceipt): int64 =
    var h: int64 = int64(197)
    h = HfModelGraphHashTextWith(h, receipt.schema)
    h = HfModelGraphHashTextWith(h, receipt.repoId)
    h = HfModelGraphHashStep(h, receipt.profileHash)
    h = HfModelGraphHashStep(h, receipt.sourceConfigHash)
    h = HfModelGraphHashStep(h, receipt.indexHash)
    h = HfModelGraphHashStep(h, int64(receipt.expectedShardFileCount))
    h = HfModelGraphHashStep(h, receipt.expectedTotalWeightBytes)
    h = HfModelGraphHashTextWith(h, receipt.quantMethod)
    h = HfModelGraphHashStep(h, int64(receipt.maxPositionEmbeddings))
    h = HfModelGraphHashStep(h, int64(receipt.mtpLayerCount))
    return h

@borrows
fn HfGlm52W4Afp8AuditShardReceiptHash(receipt: HfGlm52W4Afp8AuditShardReceipt): int64 =
    var h: int64 = int64(197)
    h = HfModelGraphHashTextWith(h, receipt.schema)
    h = HfModelGraphHashTextWith(h, receipt.repoId)
    h = HfModelGraphHashTextWith(h, receipt.modelCid)
    h = HfModelGraphHashTextWith(h, receipt.baseDir)
    h = HfModelGraphHashTextWith(h, receipt.auditPeerId)
    h = HfModelGraphHashStep(h, receipt.profileHash)
    h = HfModelGraphHashStep(h, receipt.sourceConfigHash)
    h = HfModelGraphHashStep(h, receipt.deploymentReceiptHash)
    h = HfModelGraphHashStep(h, receipt.indexHash)
    h = HfModelGraphHashStep(h, receipt.auditGraphHash)
    h = HfModelGraphHashStep(h, receipt.auditShardIndexHash)
    h = HfModelGraphHashStep(h, int64(receipt.auditWeightCount))
    h = HfModelGraphHashStep(h, int64(receipt.auditIndexEntryCount))
    h = HfModelGraphHashStep(h, int64(receipt.tensorScale))
    return h

@borrows
fn HfGlm52W4Afp8ValidateProfile(profile: HfGlm52W4Afp8DeployProfile): Result[bool] =
    if profile.schema != HfGlm52W4Afp8DeployProfileSchema ||
       profile.repoId != HfGlm52W4Afp8RepoId ||
       profile.architecture != HfGlm52W4Afp8Architecture ||
       profile.modelType != HfGlm52W4Afp8ModelType ||
       profile.quantMethod != HfGlm52W4Afp8QuantMethod:
        return Err[bool]("hf glm52 w4afp8 profile: identity")
    if profile.vocabSize != 154880 ||
       profile.hiddenSize != 6144 ||
       profile.layerCount != 78 ||
       profile.attentionHeads != 64 ||
       profile.keyValueHeads != 64 ||
       profile.headDim != 192:
        return Err[bool]("hf glm52 w4afp8 profile: dimensions")
    if profile.indexHeadDim != 128 ||
       profile.indexHeads != 32 ||
       profile.indexTopK != 2048 ||
       profile.indexTopKFreq != 4:
        return Err[bool]("hf glm52 w4afp8 profile: dsa dimensions")
    if profile.qLoraRank != 2048 ||
       profile.kvLoraRank != 512 ||
       profile.qkHeadDim != profile.qkNopeHeadDim + profile.qkRopeHeadDim ||
       profile.qkHeadDim != 256 ||
       profile.vHeadDim != 256:
        return Err[bool]("hf glm52 w4afp8 profile: mla dimensions")
    if profile.denseIntermediateSize != 12288 ||
       profile.moeIntermediateSize != 2048 ||
       profile.denseLayerCount != 3 ||
       profile.routedExpertCount != 256 ||
       profile.sharedExpertCount != 1 ||
       profile.topK != 8:
        return Err[bool]("hf glm52 w4afp8 profile: moe dimensions")
    if profile.maxPositionEmbeddings != 1048576 ||
       profile.mtpLayerCount != 1 ||
       profile.mtpStartLayer != profile.layerCount ||
       !profile.indexShareForMtpIteration:
        return Err[bool]("hf glm52 w4afp8 profile: mtp")
    if profile.expectedShardFileCount != 41 ||
       profile.expectedTotalWeightBytes != HfGlm52W4Afp8ExpectedTotalWeightBytesValue() ||
       profile.sourceConfigHash <= int64(0):
        return Err[bool]("hf glm52 w4afp8 profile: repository")
    if HfGlm52W4Afp8ProfileHash(profile) != profile.profileHash:
        return Err[bool]("hf glm52 w4afp8 profile: hash")
    return Ok[bool](true)

fn HfGlm52W4Afp8DeployProfileFromConfig(repoId: str,
                                        configJson: str): Result[HfGlm52W4Afp8DeployProfile] =
    if repoId != HfGlm52W4Afp8RepoId:
        return Err[HfGlm52W4Afp8DeployProfile]("hf glm52 w4afp8 profile: repo")
    if configJson == "":
        return Err[HfGlm52W4Afp8DeployProfile]("hf glm52 w4afp8 profile: json")
    let archRaw = jsonfield.CsgCoreJsonTopRawField(configJson, "architectures")
    if !archRaw.found || !strutil.Contains(archRaw.value, HfGlm52W4Afp8Architecture):
        return Err[HfGlm52W4Afp8DeployProfile]("hf glm52 w4afp8 profile: architecture")
    let modelType = jsonfield.CsgCoreJsonTopStringField(configJson, "model_type")
    if !modelType.found || modelType.value != HfGlm52W4Afp8ModelType:
        return Err[HfGlm52W4Afp8DeployProfile]("hf glm52 w4afp8 profile: model_type")
    let quantRaw = jsonfield.CsgCoreJsonTopRawField(configJson, "quantization_config")
    if !quantRaw.found:
        return Err[HfGlm52W4Afp8DeployProfile]("hf glm52 w4afp8 profile: quant config")
    let quantMethod = jsonfield.CsgCoreJsonTopStringField(quantRaw.value, "quant_method")
    if !quantMethod.found || quantMethod.value != HfGlm52W4Afp8QuantMethod:
        return Err[HfGlm52W4Afp8DeployProfile]("hf glm52 w4afp8 profile: quant method")
    let vocabSize = HfGlmMoeConfigRequiredInt(configJson, "vocab_size")
    let hiddenSize = HfGlmMoeConfigRequiredInt(configJson, "hidden_size")
    let layerCount = HfGlmMoeConfigRequiredInt(configJson, "num_hidden_layers")
    let attentionHeads = HfGlmMoeConfigRequiredInt(configJson, "num_attention_heads")
    let keyValueHeads = HfGlmMoeConfigRequiredInt(configJson, "num_key_value_heads")
    let headDim = HfGlmMoeConfigRequiredInt(configJson, "head_dim")
    let indexHeadDim = HfGlmMoeConfigRequiredInt(configJson, "index_head_dim")
    let indexHeads = HfGlmMoeConfigRequiredInt(configJson, "index_n_heads")
    let indexTopK = HfGlmMoeConfigRequiredInt(configJson, "index_topk")
    let indexTopKFreq = HfGlmMoeConfigRequiredInt(configJson, "index_topk_freq")
    let qLoraRank = HfGlmMoeConfigRequiredInt(configJson, "q_lora_rank")
    let kvLoraRank = HfGlmMoeConfigRequiredInt(configJson, "kv_lora_rank")
    let qkHeadDim = HfGlmMoeConfigRequiredInt(configJson, "qk_head_dim")
    let qkNopeHeadDim = HfGlmMoeConfigRequiredInt(configJson, "qk_nope_head_dim")
    let qkRopeHeadDim = HfGlmMoeConfigRequiredInt(configJson, "qk_rope_head_dim")
    let vHeadDim = HfGlmMoeConfigRequiredInt(configJson, "v_head_dim")
    let denseIntermediateSize = HfGlmMoeConfigRequiredInt(configJson, "intermediate_size")
    let moeIntermediateSize = HfGlmMoeConfigRequiredInt(configJson, "moe_intermediate_size")
    let denseLayerCount = HfGlmMoeConfigRequiredInt(configJson, "first_k_dense_replace")
    let routedExpertCount = HfGlmMoeConfigRequiredInt(configJson, "n_routed_experts")
    let sharedExpertCount = HfGlmMoeConfigRequiredInt(configJson, "n_shared_experts")
    let topK = HfGlmMoeConfigRequiredInt(configJson, "num_experts_per_tok")
    let maxPositionEmbeddings = HfGlmMoeConfigRequiredInt(configJson, "max_position_embeddings")
    let mtpLayerCount = HfGlmMoeConfigRequiredInt(configJson, "num_nextn_predict_layers")
    let indexShare = HfGlm52W4Afp8ConfigRequiredBool(configJson, "index_share_for_mtp_iteration")
    if IsErr(vocabSize):
        return Err[HfGlm52W4Afp8DeployProfile](Error(vocabSize))
    if IsErr(hiddenSize):
        return Err[HfGlm52W4Afp8DeployProfile](Error(hiddenSize))
    if IsErr(layerCount):
        return Err[HfGlm52W4Afp8DeployProfile](Error(layerCount))
    if IsErr(attentionHeads):
        return Err[HfGlm52W4Afp8DeployProfile](Error(attentionHeads))
    if IsErr(keyValueHeads):
        return Err[HfGlm52W4Afp8DeployProfile](Error(keyValueHeads))
    if IsErr(headDim):
        return Err[HfGlm52W4Afp8DeployProfile](Error(headDim))
    if IsErr(indexHeadDim):
        return Err[HfGlm52W4Afp8DeployProfile](Error(indexHeadDim))
    if IsErr(indexHeads):
        return Err[HfGlm52W4Afp8DeployProfile](Error(indexHeads))
    if IsErr(indexTopK):
        return Err[HfGlm52W4Afp8DeployProfile](Error(indexTopK))
    if IsErr(indexTopKFreq):
        return Err[HfGlm52W4Afp8DeployProfile](Error(indexTopKFreq))
    if IsErr(qLoraRank):
        return Err[HfGlm52W4Afp8DeployProfile](Error(qLoraRank))
    if IsErr(kvLoraRank):
        return Err[HfGlm52W4Afp8DeployProfile](Error(kvLoraRank))
    if IsErr(qkHeadDim):
        return Err[HfGlm52W4Afp8DeployProfile](Error(qkHeadDim))
    if IsErr(qkNopeHeadDim):
        return Err[HfGlm52W4Afp8DeployProfile](Error(qkNopeHeadDim))
    if IsErr(qkRopeHeadDim):
        return Err[HfGlm52W4Afp8DeployProfile](Error(qkRopeHeadDim))
    if IsErr(vHeadDim):
        return Err[HfGlm52W4Afp8DeployProfile](Error(vHeadDim))
    if IsErr(denseIntermediateSize):
        return Err[HfGlm52W4Afp8DeployProfile](Error(denseIntermediateSize))
    if IsErr(moeIntermediateSize):
        return Err[HfGlm52W4Afp8DeployProfile](Error(moeIntermediateSize))
    if IsErr(denseLayerCount):
        return Err[HfGlm52W4Afp8DeployProfile](Error(denseLayerCount))
    if IsErr(routedExpertCount):
        return Err[HfGlm52W4Afp8DeployProfile](Error(routedExpertCount))
    if IsErr(sharedExpertCount):
        return Err[HfGlm52W4Afp8DeployProfile](Error(sharedExpertCount))
    if IsErr(topK):
        return Err[HfGlm52W4Afp8DeployProfile](Error(topK))
    if IsErr(maxPositionEmbeddings):
        return Err[HfGlm52W4Afp8DeployProfile](Error(maxPositionEmbeddings))
    if IsErr(mtpLayerCount):
        return Err[HfGlm52W4Afp8DeployProfile](Error(mtpLayerCount))
    if IsErr(indexShare):
        return Err[HfGlm52W4Afp8DeployProfile](Error(indexShare))
    let ropeTheta = HfGlmMoeConfigOptionalFloat64(configJson, "rope_theta", 10000.0)
    if IsErr(ropeTheta):
        return Err[HfGlm52W4Afp8DeployProfile](Error(ropeTheta))
    if (Value(ropeTheta) - 1.0) + 1000000000000000.0 < 1000000000000000.0:
        return Err[HfGlm52W4Afp8DeployProfile]("hf glm52 w4afp8 profile: rope_theta")
    var out = HfGlm52W4Afp8DeployProfile(
        schema: HfGlm52W4Afp8DeployProfileSchema,
        repoId: repoId,
        architecture: HfGlm52W4Afp8Architecture,
        modelType: modelType.value,
        vocabSize: Value(vocabSize),
        hiddenSize: Value(hiddenSize),
        layerCount: Value(layerCount),
        attentionHeads: Value(attentionHeads),
        keyValueHeads: Value(keyValueHeads),
        headDim: Value(headDim),
        indexHeadDim: Value(indexHeadDim),
        indexHeads: Value(indexHeads),
        indexTopK: Value(indexTopK),
        indexTopKFreq: Value(indexTopKFreq),
        qLoraRank: Value(qLoraRank),
        kvLoraRank: Value(kvLoraRank),
        qkHeadDim: Value(qkHeadDim),
        qkNopeHeadDim: Value(qkNopeHeadDim),
        qkRopeHeadDim: Value(qkRopeHeadDim),
        vHeadDim: Value(vHeadDim),
        denseIntermediateSize: Value(denseIntermediateSize),
        moeIntermediateSize: Value(moeIntermediateSize),
        denseLayerCount: Value(denseLayerCount),
        routedExpertCount: Value(routedExpertCount),
        sharedExpertCount: Value(sharedExpertCount),
        topK: Value(topK),
        maxPositionEmbeddings: Value(maxPositionEmbeddings),
        mtpLayerCount: Value(mtpLayerCount),
        mtpStartLayer: Value(layerCount),
        indexShareForMtpIteration: Value(indexShare),
        quantMethod: quantMethod.value,
        expectedShardFileCount: 41,
        expectedTotalWeightBytes: HfGlm52W4Afp8ExpectedTotalWeightBytesValue(),
        ropeTheta: Value(ropeTheta),
        sourceConfigHash: HfModelGraphHashTextWith(int64(197), configJson),
        profileHash: int64(0)
    )
    out.profileHash = HfGlm52W4Afp8ProfileHash(out)
    let profileOk = HfGlm52W4Afp8ValidateProfile(out)
    if IsErr(profileOk):
        return Err[HfGlm52W4Afp8DeployProfile](Error(profileOk))
    return Ok[HfGlm52W4Afp8DeployProfile](out)

fn hfGlm52W4Afp8ReadTextFile(path: str, label: str): Result[str] =
    if path == "":
        return Err[str](strutil.Join([ share(label), ": path"], ""))
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[str](Error(bytesRes))
    return Ok[str](rawbytes.BytesToString(Value(bytesRes)))

fn HfGlm52W4Afp8DeployProfileFromConfigPath(repoId: str,
                                            configPath: str): Result[HfGlm52W4Afp8DeployProfile] =
    let text = hfGlm52W4Afp8ReadTextFile(configPath, "hf glm52 w4afp8 profile config")
    if IsErr(text):
        return Err[HfGlm52W4Afp8DeployProfile](Error(text))
    return HfGlm52W4Afp8DeployProfileFromConfig(repoId, Value(text))

@borrows
fn hfGlm52W4Afp8ShardFileOrdinal(fileName: str): Result[int32] =
    if fileName.len != 32:
        return Err[int32]("hf glm52 w4afp8 index: shard file")
    if !hfGlm52TextStartsWith(fileName, "model-"):
        return Err[int32]("hf glm52 w4afp8 index: shard file prefix")
    if fileName[11] != '-' || fileName[12] != 'o' || fileName[13] != 'f' ||
       fileName[14] != '-' || fileName[20] != '.':
        return Err[int32]("hf glm52 w4afp8 index: shard file shape")
    let suffix = ".safetensors"
    for i in 0..<suffix.len:
        if fileName[20 + i] != suffix[i]:
            return Err[int32]("hf glm52 w4afp8 index: shard file suffix")
    let shardIndex = hfGlm52ParseIntRange(fileName, 6, 11)
    if IsErr(shardIndex):
        return Err[int32](Error(shardIndex))
    let shardTotal = hfGlm52ParseIntRange(fileName, 15, 20)
    if IsErr(shardTotal):
        return Err[int32](Error(shardTotal))
    if Value(shardTotal) == 40 && Value(shardIndex) >= 1 && Value(shardIndex) <= 40:
        return shardIndex
    if Value(shardTotal) == 41 && Value(shardIndex) == 41:
        return shardIndex
    return Err[int32]("hf glm52 w4afp8 index: shard file ordinal")

@borrows
fn HfGlm52W4Afp8ValidateIndexMetadata(profile: HfGlm52W4Afp8DeployProfile,
                                      indexJson: str): Result[bool] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[bool](Error(profileOk))
    let metadata = jsonfield.CsgCoreJsonTopRawField(indexJson, "metadata")
    if !metadata.found:
        return Err[bool]("hf glm52 w4afp8 index: metadata")
    let totalSize = jsonfield.CsgCoreJsonTopRawField(metadata.value, "total_size")
    if !totalSize.found:
        return Err[bool]("hf glm52 w4afp8 index: total size")
    let parsedTotal = hfJsonRawExactNonNegativeInt64(totalSize.value)
    if IsErr(parsedTotal):
        return Err[bool](Error(parsedTotal))
    if Value(parsedTotal) != profile.expectedTotalWeightBytes:
        return Err[bool]("hf glm52 w4afp8 index: total size drift")
    let rawWeightMap = jsonfield.CsgCoreJsonTopRawField(indexJson, "weight_map")
    if !rawWeightMap.found:
        return Err[bool]("hf glm52 w4afp8 index: weight_map")
    return Ok[bool](true)

@borrows
fn hfGlm52TextStartsWith(text: str, prefix: str): bool =
    if prefix.len > text.len:
        return false
    for i in 0..<prefix.len:
        if text[i] != prefix[i]:
            return false
    return true

@borrows
fn hfGlm52IndexOfChar(text: str, ch: char, start: int32): int32 =
    var i: int32 = start
    while i < text.len:
        if text[i] == ch:
            return i
        i = i + 1
    return -1

@borrows
fn hfGlm52ParseIntRange(text: str, start: int32, endPos: int32): Result[int32] =
    if start < 0 || endPos <= start || endPos > text.len:
        return Err[int32]("hf glm52 w4afp8 inventory: int range")
    var value: int64
    for i in start..<endPos:
        let ch = text[i]
        if ch < '0' || ch > '9':
            return Err[int32]("hf glm52 w4afp8 inventory: int")
        let digit = int64(Int32(ch) - Int32('0'))
        if value > (int64(2147483647) - digit) / int64(10):
            return Err[int32]("hf glm52 w4afp8 inventory: int overflow")
        value = value * int64(10) + digit
    return Ok[int32](int32(value))

@borrows
fn hfGlm52LayerHasDsaIndexerUnchecked(profile: HfGlm52W4Afp8DeployProfile,
                                      layerIndex: int32): bool =
    if layerIndex < profile.denseLayerCount:
        return true
    if layerIndex >= profile.mtpStartLayer:
        return true
    let sparseOffset = layerIndex - profile.denseLayerCount
    return sparseOffset % profile.indexTopKFreq == profile.indexTopKFreq - 1

@borrows
fn HfGlm52W4Afp8LayerHasDsaIndexer(profile: HfGlm52W4Afp8DeployProfile,
                                   layerIndex: int32): Result[bool] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[bool](Error(profileOk))
    if layerIndex < 0 || layerIndex > profile.mtpStartLayer:
        return Err[bool]("hf glm52 w4afp8 inventory: layer")
    return Ok[bool](hfGlm52LayerHasDsaIndexerUnchecked(profile, layerIndex))

@borrows
fn hfGlm52ExpectedLayerWeightCountUnchecked(profile: HfGlm52W4Afp8DeployProfile,
                                           layerIndex: int32): int32 =
    if layerIndex < profile.denseLayerCount:
        return 27
    if layerIndex < profile.layerCount:
        var count: int32 = 22 + profile.routedExpertCount * 9
        if hfGlm52LayerHasDsaIndexerUnchecked(profile, layerIndex):
            count = count + 7
        return count
    return 33 + profile.routedExpertCount * 9

@borrows
fn HfGlm52W4Afp8ExpectedLayerWeightCount(profile: HfGlm52W4Afp8DeployProfile,
                                         layerIndex: int32): Result[int32] =
    let hasDsa = HfGlm52W4Afp8LayerHasDsaIndexer(profile, layerIndex)
    if IsErr(hasDsa):
        return Err[int32](Error(hasDsa))
    return Ok[int32](hfGlm52ExpectedLayerWeightCountUnchecked(profile, layerIndex))

@borrows
fn HfGlm52W4Afp8ExpectedWeightCount(profile: HfGlm52W4Afp8DeployProfile): Result[int32] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[int32](Error(profileOk))
    var total: int32 = 3
    for layerIndex in 0..<profile.layerCount:
        total = total + hfGlm52ExpectedLayerWeightCountUnchecked(profile, layerIndex)
    for mtpIndex in 0..<profile.mtpLayerCount:
        total = total + hfGlm52ExpectedLayerWeightCountUnchecked(profile, profile.mtpStartLayer + mtpIndex)
    return Ok[int32](total)

@borrows
fn hfGlm52LayerBaseTable(profile: HfGlm52W4Afp8DeployProfile): Result[int32[]] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[int32[]](Error(profileOk))
    var out: int32[]
    let tableLen = profile.mtpStartLayer + profile.mtpLayerCount
    setLen(out, tableLen)
    var base: int32 = 3
    for layerIndex in 0..<tableLen:
        out[layerIndex] = base
        base = base + hfGlm52ExpectedLayerWeightCountUnchecked(profile, layerIndex)
    return Ok[int32[]](out)

@borrows
fn hfGlm52CommonAttentionSuffixOrdinal(suffix: str): Result[int32] =
    if suffix == "self_attn.q_a_proj.weight": return Ok[int32](0)
    if suffix == "self_attn.q_a_proj.weight_scale_inv": return Ok[int32](1)
    if suffix == "self_attn.q_a_layernorm.weight": return Ok[int32](2)
    if suffix == "self_attn.q_b_proj.weight": return Ok[int32](3)
    if suffix == "self_attn.q_b_proj.weight_scale_inv": return Ok[int32](4)
    if suffix == "self_attn.kv_a_proj_with_mqa.weight": return Ok[int32](5)
    if suffix == "self_attn.kv_a_proj_with_mqa.weight_scale_inv": return Ok[int32](6)
    if suffix == "self_attn.kv_a_layernorm.weight": return Ok[int32](7)
    if suffix == "self_attn.kv_b_proj.weight": return Ok[int32](8)
    if suffix == "self_attn.kv_b_proj.weight_scale_inv": return Ok[int32](9)
    if suffix == "self_attn.o_proj.weight": return Ok[int32](10)
    if suffix == "self_attn.o_proj.weight_scale_inv": return Ok[int32](11)
    return Err[int32]("hf glm52 w4afp8 inventory: attention suffix")

@borrows
fn hfGlm52DsaSuffixOrdinal(suffix: str): Result[int32] =
    if suffix == "self_attn.indexer.k_norm.bias": return Ok[int32](0)
    if suffix == "self_attn.indexer.k_norm.weight": return Ok[int32](1)
    if suffix == "self_attn.indexer.weights_proj.weight": return Ok[int32](2)
    if suffix == "self_attn.indexer.wk.weight": return Ok[int32](3)
    if suffix == "self_attn.indexer.wk.weight_scale_inv": return Ok[int32](4)
    if suffix == "self_attn.indexer.wq_b.weight": return Ok[int32](5)
    if suffix == "self_attn.indexer.wq_b.weight_scale_inv": return Ok[int32](6)
    return Err[int32]("hf glm52 w4afp8 inventory: dsa suffix")

@borrows
fn hfGlm52ExpertSuffixOrdinal(suffix: str): Result[int32] =
    if suffix == "down_proj.weight": return Ok[int32](0)
    if suffix == "down_proj.weight_scale_inv": return Ok[int32](1)
    if suffix == "gate_proj.weight": return Ok[int32](2)
    if suffix == "gate_proj.weight_scale_inv": return Ok[int32](3)
    if suffix == "up_proj.weight": return Ok[int32](4)
    if suffix == "up_proj.weight_scale_inv": return Ok[int32](5)
    if suffix == "w1.input_scale": return Ok[int32](6)
    if suffix == "w2.input_scale": return Ok[int32](7)
    if suffix == "w3.input_scale": return Ok[int32](8)
    return Err[int32]("hf glm52 w4afp8 inventory: expert suffix")

@borrows
fn hfGlm52DenseSuffixOrdinal(suffix: str): Result[int32] =
    if suffix == "input_layernorm.weight": return Ok[int32](0)
    let attn = hfGlm52CommonAttentionSuffixOrdinal(suffix)
    if IsOk(attn):
        return Ok[int32](1 + Value(attn))
    if suffix == "post_attention_layernorm.weight": return Ok[int32](13)
    if suffix == "mlp.gate_proj.weight": return Ok[int32](14)
    if suffix == "mlp.gate_proj.weight_scale_inv": return Ok[int32](15)
    if suffix == "mlp.up_proj.weight": return Ok[int32](16)
    if suffix == "mlp.up_proj.weight_scale_inv": return Ok[int32](17)
    if suffix == "mlp.down_proj.weight": return Ok[int32](18)
    if suffix == "mlp.down_proj.weight_scale_inv": return Ok[int32](19)
    let dsa = hfGlm52DsaSuffixOrdinal(suffix)
    if IsOk(dsa):
        return Ok[int32](20 + Value(dsa))
    return Err[int32]("hf glm52 w4afp8 inventory: dense suffix")

@borrows
fn hfGlm52SparseNonExpertSuffixOrdinal(suffix: str, hasDsa: bool): Result[int32] =
    if suffix == "input_layernorm.weight": return Ok[int32](0)
    let attn = hfGlm52CommonAttentionSuffixOrdinal(suffix)
    if IsOk(attn):
        return Ok[int32](1 + Value(attn))
    if suffix == "post_attention_layernorm.weight": return Ok[int32](13)
    if suffix == "mlp.gate.e_score_correction_bias": return Ok[int32](14)
    if suffix == "mlp.gate.weight": return Ok[int32](15)
    if suffix == "mlp.shared_experts.gate_proj.weight": return Ok[int32](16)
    if suffix == "mlp.shared_experts.gate_proj.weight_scale_inv": return Ok[int32](17)
    if suffix == "mlp.shared_experts.up_proj.weight": return Ok[int32](18)
    if suffix == "mlp.shared_experts.up_proj.weight_scale_inv": return Ok[int32](19)
    if suffix == "mlp.shared_experts.down_proj.weight": return Ok[int32](20)
    if suffix == "mlp.shared_experts.down_proj.weight_scale_inv": return Ok[int32](21)
    if hasDsa:
        let dsa = hfGlm52DsaSuffixOrdinal(suffix)
        if IsOk(dsa):
            return Ok[int32](22 + Value(dsa))
    return Err[int32]("hf glm52 w4afp8 inventory: sparse nonexpert suffix")

@borrows
fn hfGlm52MtpNonExpertSuffixOrdinal(suffix: str): Result[int32] =
    if suffix == "eh_proj.weight": return Ok[int32](0)
    if suffix == "enorm.weight": return Ok[int32](1)
    if suffix == "hnorm.weight": return Ok[int32](2)
    if suffix == "input_layernorm.weight": return Ok[int32](3)
    let attn = hfGlm52CommonAttentionSuffixOrdinal(suffix)
    if IsOk(attn):
        return Ok[int32](4 + Value(attn))
    if suffix == "post_attention_layernorm.weight": return Ok[int32](16)
    let dsa = hfGlm52DsaSuffixOrdinal(suffix)
    if IsOk(dsa):
        return Ok[int32](17 + Value(dsa))
    if suffix == "mlp.gate.e_score_correction_bias": return Ok[int32](24)
    if suffix == "mlp.gate.weight": return Ok[int32](25)
    if suffix == "mlp.shared_experts.gate_proj.weight": return Ok[int32](26)
    if suffix == "mlp.shared_experts.gate_proj.weight_scale_inv": return Ok[int32](27)
    if suffix == "mlp.shared_experts.up_proj.weight": return Ok[int32](28)
    if suffix == "mlp.shared_experts.up_proj.weight_scale_inv": return Ok[int32](29)
    if suffix == "mlp.shared_experts.down_proj.weight": return Ok[int32](30)
    if suffix == "mlp.shared_experts.down_proj.weight_scale_inv": return Ok[int32](31)
    if suffix == "shared_head.norm.weight": return Ok[int32](32)
    return Err[int32]("hf glm52 w4afp8 inventory: mtp suffix")

@borrows
fn hfGlm52ExpertOrdinal(profile: HfGlm52W4Afp8DeployProfile,
                        suffix: str,
                        baseOrdinal: int32): Result[int32] =
    let prefix = "mlp.experts."
    if !hfGlm52TextStartsWith(suffix, prefix):
        return Err[int32]("hf glm52 w4afp8 inventory: expert prefix")
    let dotPos = hfGlm52IndexOfChar(suffix, '.', prefix.len)
    if dotPos < 0:
        return Err[int32]("hf glm52 w4afp8 inventory: expert dot")
    let expertId = hfGlm52ParseIntRange(suffix, prefix.len, dotPos)
    if IsErr(expertId):
        return Err[int32](Error(expertId))
    if Value(expertId) < 0 || Value(expertId) >= profile.routedExpertCount:
        return Err[int32]("hf glm52 w4afp8 inventory: expert id")
    let rest = strings.SliceBytes(suffix, dotPos + 1, suffix.len - dotPos - 1)
    let expertSuffix = hfGlm52ExpertSuffixOrdinal(rest)
    if IsErr(expertSuffix):
        return Err[int32](Error(expertSuffix))
    return Ok[int32](baseOrdinal + Value(expertId) * 9 + Value(expertSuffix))

@borrows
fn hfGlm52LayerKey(key: str): Result[HfGlm52W4Afp8LayerKey] =
    let prefix = "model.layers."
    if !hfGlm52TextStartsWith(key, prefix):
        return Err[HfGlm52W4Afp8LayerKey]("hf glm52 w4afp8 inventory: layer prefix")
    let dotPos = hfGlm52IndexOfChar(key, '.', prefix.len)
    if dotPos < 0:
        return Err[HfGlm52W4Afp8LayerKey]("hf glm52 w4afp8 inventory: layer dot")
    let layerIndex = hfGlm52ParseIntRange(key, prefix.len, dotPos)
    if IsErr(layerIndex):
        return Err[HfGlm52W4Afp8LayerKey](Error(layerIndex))
    let suffix = strings.SliceBytes(key, dotPos + 1, key.len - dotPos - 1)
    return Ok[HfGlm52W4Afp8LayerKey](HfGlm52W4Afp8LayerKey(layerIndex: Value(layerIndex), suffix: suffix))

@borrows
fn hfGlm52ExpectedWeightOrdinalUnchecked(profile: HfGlm52W4Afp8DeployProfile,
                                         tensorName: str): Result[int32] =
    let baseTable = hfGlm52LayerBaseTable(profile)
    if IsErr(baseTable):
        return Err[int32](Error(baseTable))
    return hfGlm52ExpectedWeightOrdinalWithLayerBase(profile, tensorName, Value(baseTable))

@borrows
fn hfGlm52ExpectedWeightOrdinalWithLayerBase(profile: HfGlm52W4Afp8DeployProfile,
                                            tensorName: str,
                                            layerBase: int32[]): Result[int32] =
    if tensorName == "model.embed_tokens.weight": return Ok[int32](0)
    if tensorName == "model.norm.weight": return Ok[int32](1)
    if tensorName == "lm_head.weight": return Ok[int32](2)
    let layerKey = hfGlm52LayerKey(tensorName)
    if IsErr(layerKey):
        return Err[int32](Error(layerKey))
    let key = Value(layerKey)
    if key.layerIndex < 0 || key.layerIndex > profile.mtpStartLayer ||
       key.layerIndex >= layerBase.len:
        return Err[int32]("hf glm52 w4afp8 inventory: layer range")
    let base = layerBase[key.layerIndex]
    if key.layerIndex < profile.denseLayerCount:
        let dense = hfGlm52DenseSuffixOrdinal(key.suffix)
        if IsErr(dense):
            return Err[int32](Error(dense))
        return Ok[int32](base + Value(dense))
    if key.layerIndex < profile.layerCount:
        let hasDsa = hfGlm52LayerHasDsaIndexerUnchecked(profile, key.layerIndex)
        let nonExpert = hfGlm52SparseNonExpertSuffixOrdinal(key.suffix, hasDsa)
        if IsOk(nonExpert):
            return Ok[int32](base + Value(nonExpert))
        var expertBase: int32 = 22
        if hasDsa:
            expertBase = expertBase + 7
        let expert = hfGlm52ExpertOrdinal(profile, key.suffix, expertBase)
        if IsErr(expert):
            return Err[int32](Error(expert))
        return Ok[int32](base + Value(expert))
    if key.layerIndex == profile.mtpStartLayer:
        let nonExpert = hfGlm52MtpNonExpertSuffixOrdinal(key.suffix)
        if IsOk(nonExpert):
            return Ok[int32](base + Value(nonExpert))
        let expert = hfGlm52ExpertOrdinal(profile, key.suffix, 33)
        if IsErr(expert):
            return Err[int32](Error(expert))
        return Ok[int32](base + Value(expert))
    return Err[int32]("hf glm52 w4afp8 inventory: unexpected layer")

@borrows
fn HfGlm52W4Afp8ExpectedWeightOrdinal(profile: HfGlm52W4Afp8DeployProfile,
                                      tensorName: str): Result[int32] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[int32](Error(profileOk))
    return hfGlm52ExpectedWeightOrdinalUnchecked(profile, tensorName)

@borrows
fn hfGlm52AppendLayerWeightName(out: var str[], layerIndex: int32, suffix: str) =
    add(out, strutil.Join(["model.layers.", strings.IntToStr(layerIndex), ".", share(suffix)], ""))

@borrows
fn hfGlm52AppendDsaWeightNames(out: var str[], layerIndex: int32) =
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.indexer.k_norm.bias")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.indexer.k_norm.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.indexer.weights_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.indexer.wk.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.indexer.wk.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.indexer.wq_b.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.indexer.wq_b.weight_scale_inv")

@borrows
fn hfGlm52AppendCommonAttentionWeightNames(out: var str[], layerIndex: int32) =
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.q_a_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.q_a_proj.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.q_a_layernorm.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.q_b_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.q_b_proj.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.kv_a_proj_with_mqa.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.kv_a_proj_with_mqa.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.kv_a_layernorm.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.kv_b_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.kv_b_proj.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.o_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "self_attn.o_proj.weight_scale_inv")

@borrows
fn hfGlm52AppendDenseLayerWeightNames(out: var str[], layerIndex: int32) =
    hfGlm52AppendLayerWeightName(out, layerIndex, "input_layernorm.weight")
    hfGlm52AppendCommonAttentionWeightNames(out, layerIndex)
    hfGlm52AppendLayerWeightName(out, layerIndex, "post_attention_layernorm.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.gate_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.gate_proj.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.up_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.up_proj.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.down_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.down_proj.weight_scale_inv")
    hfGlm52AppendDsaWeightNames(out, layerIndex)

@borrows
fn hfGlm52AppendSharedExpertWeightNames(out: var str[], layerIndex: int32) =
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.shared_experts.gate_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.shared_experts.gate_proj.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.shared_experts.up_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.shared_experts.up_proj.weight_scale_inv")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.shared_experts.down_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.shared_experts.down_proj.weight_scale_inv")

@borrows
fn hfGlm52AppendExpertWeightNames(out: var str[], layerIndex: int32, expertId: int32) =
    let prefix = strutil.Join(["mlp.experts.", strings.IntToStr(expertId), "."], "")
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "down_proj.weight"], ""))
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "down_proj.weight_scale_inv"], ""))
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "gate_proj.weight"], ""))
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "gate_proj.weight_scale_inv"], ""))
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "up_proj.weight"], ""))
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "up_proj.weight_scale_inv"], ""))
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "w1.input_scale"], ""))
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "w2.input_scale"], ""))
    hfGlm52AppendLayerWeightName(out, layerIndex, strutil.Join([prefix, "w3.input_scale"], ""))

@borrows
fn hfGlm52AppendSparseLayerWeightNames(profile: HfGlm52W4Afp8DeployProfile,
                                       out: var str[],
                                       layerIndex: int32) =
    hfGlm52AppendLayerWeightName(out, layerIndex, "input_layernorm.weight")
    hfGlm52AppendCommonAttentionWeightNames(out, layerIndex)
    hfGlm52AppendLayerWeightName(out, layerIndex, "post_attention_layernorm.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.gate.e_score_correction_bias")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.gate.weight")
    hfGlm52AppendSharedExpertWeightNames(out, layerIndex)
    let hasDsa = HfGlm52W4Afp8LayerHasDsaIndexer(profile, layerIndex)
    if IsOk(hasDsa) && Value(hasDsa):
        hfGlm52AppendDsaWeightNames(out, layerIndex)
    for expertId in 0..<profile.routedExpertCount:
        hfGlm52AppendExpertWeightNames(out, layerIndex, expertId)

@borrows
fn hfGlm52AppendMtpLayerWeightNames(profile: HfGlm52W4Afp8DeployProfile,
                                    out: var str[],
                                    layerIndex: int32) =
    hfGlm52AppendLayerWeightName(out, layerIndex, "eh_proj.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "enorm.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "hnorm.weight")
    hfGlm52AppendLayerWeightName(out, layerIndex, "input_layernorm.weight")
    hfGlm52AppendCommonAttentionWeightNames(out, layerIndex)
    hfGlm52AppendLayerWeightName(out, layerIndex, "post_attention_layernorm.weight")
    hfGlm52AppendDsaWeightNames(out, layerIndex)
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.gate.e_score_correction_bias")
    hfGlm52AppendLayerWeightName(out, layerIndex, "mlp.gate.weight")
    hfGlm52AppendSharedExpertWeightNames(out, layerIndex)
    hfGlm52AppendLayerWeightName(out, layerIndex, "shared_head.norm.weight")
    for expertId in 0..<profile.routedExpertCount:
        hfGlm52AppendExpertWeightNames(out, layerIndex, expertId)

@borrows
fn HfGlm52W4Afp8ExpectedWeightNames(profile: HfGlm52W4Afp8DeployProfile): Result[str[]] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[str[]](Error(profileOk))
    var out: str[]
    add(out, "model.embed_tokens.weight")
    add(out, "model.norm.weight")
    add(out, "lm_head.weight")
    for layerIndex in 0..<profile.layerCount:
        if layerIndex < profile.denseLayerCount:
            hfGlm52AppendDenseLayerWeightNames(out, layerIndex)
        else:
            hfGlm52AppendSparseLayerWeightNames(profile, out, layerIndex)
    for mtpIndex in 0..<profile.mtpLayerCount:
        hfGlm52AppendMtpLayerWeightNames(profile, out, profile.mtpStartLayer + mtpIndex)
    let expected = HfGlm52W4Afp8ExpectedWeightCount(profile)
    if IsErr(expected):
        return Err[str[]](Error(expected))
    if out.len != Value(expected):
        return Err[str[]]("hf glm52 w4afp8 inventory: generated count")
    return Ok[str[]](out)

@borrows
fn HfGlm52W4Afp8ValidateExpectedWeightNameInventory(profile: HfGlm52W4Afp8DeployProfile,
                                                    tensorNames: str[]): Result[bool] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[bool](Error(profileOk))
    let total = HfGlm52W4Afp8ExpectedWeightCount(profile)
    if IsErr(total):
        return Err[bool](Error(total))
    if tensorNames.len != Value(total):
        return Err[bool](strutil.Join([
            "hf glm52 w4afp8 inventory: name count ",
            strings.IntToStr(tensorNames.len),
            "/",
            strings.IntToStr(Value(total))
        ], ""))
    let layerBase = hfGlm52LayerBaseTable(profile)
    if IsErr(layerBase):
        return Err[bool](Error(layerBase))
    let layerBaseValue = Value(layerBase)
    var seen: bool[]
    setLen(seen, Value(total))
    for i in 0..<tensorNames.len:
        let ordinal = hfGlm52ExpectedWeightOrdinalWithLayerBase(profile, tensorNames[i], layerBaseValue)
        if IsErr(ordinal):
            return Err[bool](Error(ordinal))
        if Value(ordinal) < 0 || Value(ordinal) >= seen.len:
            return Err[bool]("hf glm52 w4afp8 inventory: ordinal")
        if seen[Value(ordinal)]:
            return Err[bool]("hf glm52 w4afp8 inventory: duplicate tensor")
        seen[Value(ordinal)] = true
    for idx in 0..<seen.len:
        if !seen[idx]:
            return Err[bool]("hf glm52 w4afp8 inventory: missing tensor")
    return Ok[bool](true)

@borrows
fn hfGlm52JsonSkipString(text: str, quotePos: int32): int32 =
    if quotePos < 0 || quotePos >= text.len || text[quotePos] != '"':
        return -1
    var i: int32 = quotePos + 1
    while i < text.len:
        if text[i] == '\\':
            return -1
        if Int32(text[i]) < 32:
            return -1
        if text[i] == '"':
            return i + 1
        i = i + 1
    return -1

@borrows
fn hfGlm52JsonReadSimpleString(text: str, pos: int32): Result[HfGlm52W4Afp8JsonStringRead] =
    let start = hfJsonSkipWs(text, pos)
    if start >= text.len || text[start] != '"':
        return Err[HfGlm52W4Afp8JsonStringRead]("hf glm52 w4afp8 index: string")
    let endPos = hfGlm52JsonSkipString(text, start)
    if endPos < 0:
        return Err[HfGlm52W4Afp8JsonStringRead]("hf glm52 w4afp8 index: string escape")
    return Ok[HfGlm52W4Afp8JsonStringRead](HfGlm52W4Afp8JsonStringRead(
        value: strings.SliceBytes(text, start + 1, endPos - start - 2),
        nextPos: endPos
    ))

@borrows
fn HfGlm52W4Afp8ValidateFullIndexInventory(profile: HfGlm52W4Afp8DeployProfile,
                                           indexJson: str): Result[bool] =
    let indexOk = HfGlm52W4Afp8ValidateIndexMetadata(profile, indexJson)
    if IsErr(indexOk):
        return Err[bool](Error(indexOk))
    let total = HfGlm52W4Afp8ExpectedWeightCount(profile)
    if IsErr(total):
        return Err[bool](Error(total))
    let layerBase = hfGlm52LayerBaseTable(profile)
    if IsErr(layerBase):
        return Err[bool](Error(layerBase))
    let layerBaseValue = Value(layerBase)
    let rawWeightMap = jsonfield.CsgCoreJsonTopRawField(indexJson, "weight_map")
    if !rawWeightMap.found:
        return Err[bool]("hf glm52 w4afp8 index: weight_map")
    var seen: bool[]
    setLen(seen, Value(total))
    var shardSeen: bool[]
    setLen(shardSeen, profile.expectedShardFileCount + 1)
    var seenCount: int32
    var i: int32 = hfJsonSkipWs(rawWeightMap.value, 0)
    if i >= rawWeightMap.value.len || rawWeightMap.value[i] != '{':
        return Err[bool]("hf glm52 w4afp8 index: weight_map object")
    i = i + 1
    var expectValue = false
    while i < rawWeightMap.value.len:
        i = hfJsonSkipWs(rawWeightMap.value, i)
        if i < rawWeightMap.value.len && rawWeightMap.value[i] == '}':
            i = i + 1
            break
        if expectValue:
            if i >= rawWeightMap.value.len || rawWeightMap.value[i] != ',':
                return Err[bool]("hf glm52 w4afp8 index: weight_map comma")
            i = i + 1
            i = hfJsonSkipWs(rawWeightMap.value, i)
        let key = hfGlm52JsonReadSimpleString(rawWeightMap.value, i)
        if IsErr(key):
            return Err[bool](Error(key))
        i = hfJsonSkipWs(rawWeightMap.value, Value(key).nextPos)
        if i >= rawWeightMap.value.len || rawWeightMap.value[i] != ':':
            return Err[bool]("hf glm52 w4afp8 index: weight_map colon")
        let fileName = hfGlm52JsonReadSimpleString(rawWeightMap.value, i + 1)
        if IsErr(fileName):
            return Err[bool](Error(fileName))
        if !ws.WeightSafetensorsHfShardFileNameIsSafe(Value(fileName).value):
            return Err[bool]("hf glm52 w4afp8 index: shard file name")
        let shardOrdinal = hfGlm52W4Afp8ShardFileOrdinal(Value(fileName).value)
        if IsErr(shardOrdinal):
            return Err[bool](Error(shardOrdinal))
        if Value(shardOrdinal) <= 0 || Value(shardOrdinal) >= shardSeen.len:
            return Err[bool]("hf glm52 w4afp8 index: shard ordinal")
        shardSeen[Value(shardOrdinal)] = true
        let ordinal = hfGlm52ExpectedWeightOrdinalWithLayerBase(profile, Value(key).value, layerBaseValue)
        if IsErr(ordinal):
            return Err[bool](Error(ordinal))
        if Value(ordinal) < 0 || Value(ordinal) >= seen.len:
            return Err[bool]("hf glm52 w4afp8 index: ordinal")
        if seen[Value(ordinal)]:
            return Err[bool]("hf glm52 w4afp8 index: duplicate tensor")
        seen[Value(ordinal)] = true
        seenCount = seenCount + 1
        i = Value(fileName).nextPos
        expectValue = true
    i = hfJsonSkipWs(rawWeightMap.value, i)
    if i != rawWeightMap.value.len:
        return Err[bool]("hf glm52 w4afp8 index: weight_map trailing")
    if seenCount != Value(total):
        return Err[bool](strutil.Join([
            "hf glm52 w4afp8 index: weight inventory ",
            strings.IntToStr(seenCount),
            "/",
            strings.IntToStr(Value(total))
        ], ""))
    for idx in 0..<seen.len:
        if !seen[idx]:
            return Err[bool]("hf glm52 w4afp8 index: missing inventory ordinal")
    for shardIndex in 1..<shardSeen.len:
        if !shardSeen[shardIndex]:
            return Err[bool](strutil.Join(["hf glm52 w4afp8 index: missing shard ", strings.IntToStr(shardIndex)], ""))
    return Ok[bool](true)

fn HfGlm52W4Afp8ValidateFullIndexInventoryPath(profile: HfGlm52W4Afp8DeployProfile,
                                               indexPath: str): Result[bool] =
    let text = hfGlm52W4Afp8ReadTextFile(indexPath, "hf glm52 w4afp8 index")
    if IsErr(text):
        return Err[bool](Error(text))
    return HfGlm52W4Afp8ValidateFullIndexInventory(profile, Value(text))

@borrows
fn HfGlm52W4Afp8ValidateIndex(profile: HfGlm52W4Afp8DeployProfile,
                              indexJson: str): Result[bool] =
    let metaOk = HfGlm52W4Afp8ValidateIndexMetadata(profile, indexJson)
    if IsErr(metaOk):
        return Err[bool](Error(metaOk))
    let total = HfGlm52W4Afp8ExpectedWeightCount(profile)
    if IsErr(total):
        return Err[bool](Error(total))
    let layerBase = hfGlm52LayerBaseTable(profile)
    if IsErr(layerBase):
        return Err[bool](Error(layerBase))
    let layerBaseValue = Value(layerBase)
    var required = [
        "model.embed_tokens.weight",
        "model.norm.weight",
        "lm_head.weight",
        "model.layers.0.input_layernorm.weight",
        "model.layers.0.self_attn.q_a_proj.weight",
        "model.layers.0.self_attn.kv_a_proj_with_mqa.weight",
        "model.layers.0.self_attn.indexer.wq_b.weight",
        "model.layers.0.mlp.down_proj.weight",
        "model.layers.3.mlp.gate.weight",
        "model.layers.3.mlp.shared_experts.down_proj.weight",
        "model.layers.3.mlp.experts.0.gate_proj.weight",
        "model.layers.3.mlp.experts.255.w1.input_scale",
        "model.layers.78.eh_proj.weight",
        "model.layers.78.hnorm.weight",
        "model.layers.78.shared_head.norm.weight",
        "model.layers.78.self_attn.q_a_proj.weight",
        "model.layers.78.mlp.gate.weight",
        "model.layers.78.mlp.experts.255.w1.input_scale"
    ]
    var requiredByOrdinal: bool[]
    setLen(requiredByOrdinal, Value(total))
    for i in 0..<required.len:
        let ordinal = hfGlm52ExpectedWeightOrdinalWithLayerBase(profile, required[i], layerBaseValue)
        if IsErr(ordinal):
            return Err[bool](Error(ordinal))
        if Value(ordinal) < 0 || Value(ordinal) >= requiredByOrdinal.len:
            return Err[bool]("hf glm52 w4afp8 index: required ordinal")
        if requiredByOrdinal[Value(ordinal)]:
            return Err[bool]("hf glm52 w4afp8 index: duplicate required")
        requiredByOrdinal[Value(ordinal)] = true
    let rawWeightMap = jsonfield.CsgCoreJsonTopRawField(indexJson, "weight_map")
    if !rawWeightMap.found:
        return Err[bool]("hf glm52 w4afp8 index: weight_map")
    var seenRequired: bool[]
    setLen(seenRequired, Value(total))
    var seenCount: int32
    var pos: int32 = hfJsonSkipWs(rawWeightMap.value, 0)
    if pos >= rawWeightMap.value.len || rawWeightMap.value[pos] != '{':
        return Err[bool]("hf glm52 w4afp8 index: weight_map object")
    pos = pos + 1
    var expectValue = false
    while pos < rawWeightMap.value.len:
        pos = hfJsonSkipWs(rawWeightMap.value, pos)
        if pos < rawWeightMap.value.len && rawWeightMap.value[pos] == '}':
            pos = pos + 1
            break
        if expectValue:
            if pos >= rawWeightMap.value.len || rawWeightMap.value[pos] != ',':
                return Err[bool]("hf glm52 w4afp8 index: weight_map comma")
            pos = pos + 1
            pos = hfJsonSkipWs(rawWeightMap.value, pos)
        let key = hfGlm52JsonReadSimpleString(rawWeightMap.value, pos)
        if IsErr(key):
            return Err[bool](Error(key))
        pos = hfJsonSkipWs(rawWeightMap.value, Value(key).nextPos)
        if pos >= rawWeightMap.value.len || rawWeightMap.value[pos] != ':':
            return Err[bool]("hf glm52 w4afp8 index: weight_map colon")
        let fileName = hfGlm52JsonReadSimpleString(rawWeightMap.value, pos + 1)
        if IsErr(fileName):
            return Err[bool](Error(fileName))
        let ordinal = hfGlm52ExpectedWeightOrdinalWithLayerBase(profile, Value(key).value, layerBaseValue)
        if IsErr(ordinal):
            return Err[bool](Error(ordinal))
        if Value(ordinal) < 0 || Value(ordinal) >= requiredByOrdinal.len:
            return Err[bool]("hf glm52 w4afp8 index: ordinal")
        if requiredByOrdinal[Value(ordinal)]:
            if !ws.WeightSafetensorsHfShardFileNameIsSafe(Value(fileName).value):
                return Err[bool]("hf glm52 w4afp8 index: shard file name")
            if seenRequired[Value(ordinal)]:
                return Err[bool]("hf glm52 w4afp8 index: duplicate required tensor")
            seenRequired[Value(ordinal)] = true
            seenCount = seenCount + 1
        pos = Value(fileName).nextPos
        expectValue = true
    pos = hfJsonSkipWs(rawWeightMap.value, pos)
    if pos != rawWeightMap.value.len:
        return Err[bool]("hf glm52 w4afp8 index: weight_map trailing")
    if seenCount != required.len:
        return Err[bool]("hf glm52 w4afp8 index: required tensor coverage")
    for i in 0..<requiredByOrdinal.len:
        if requiredByOrdinal[i] && !seenRequired[i]:
            return Err[bool]("hf glm52 w4afp8 index: missing required tensor")
    return Ok[bool](true)

fn HfGlm52W4Afp8DeploymentReceiptBuild(profile: HfGlm52W4Afp8DeployProfile,
                                       indexJson: str): Result[HfGlm52W4Afp8DeploymentReceipt] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[HfGlm52W4Afp8DeploymentReceipt](Error(profileOk))
    let indexOk = HfGlm52W4Afp8ValidateFullIndexInventory(profile, indexJson)
    if IsErr(indexOk):
        return Err[HfGlm52W4Afp8DeploymentReceipt](Error(indexOk))
    let indexHash = HfGlm52W4Afp8IndexHash(indexJson)
    if indexHash <= int64(0):
        return Err[HfGlm52W4Afp8DeploymentReceipt]("hf glm52 w4afp8 deployment receipt: index hash")
    var out = HfGlm52W4Afp8DeploymentReceipt(
        schema: HfGlm52W4Afp8DeploymentReceiptSchema,
        repoId: profile.repoId,
        profileHash: profile.profileHash,
        sourceConfigHash: profile.sourceConfigHash,
        indexHash: indexHash,
        expectedShardFileCount: profile.expectedShardFileCount,
        expectedTotalWeightBytes: profile.expectedTotalWeightBytes,
        quantMethod: profile.quantMethod,
        maxPositionEmbeddings: profile.maxPositionEmbeddings,
        mtpLayerCount: profile.mtpLayerCount,
        receiptHash: int64(0)
    )
    out.receiptHash = HfGlm52W4Afp8DeploymentReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[HfGlm52W4Afp8DeploymentReceipt]("hf glm52 w4afp8 deployment receipt: hash")
    return Ok[HfGlm52W4Afp8DeploymentReceipt](out)

fn HfGlm52W4Afp8DeploymentReceiptBuildFromIndexPath(profile: HfGlm52W4Afp8DeployProfile,
                                                    indexPath: str): Result[HfGlm52W4Afp8DeploymentReceipt] =
    let text = hfGlm52W4Afp8ReadTextFile(indexPath, "hf glm52 w4afp8 deployment index")
    if IsErr(text):
        return Err[HfGlm52W4Afp8DeploymentReceipt](Error(text))
    return HfGlm52W4Afp8DeploymentReceiptBuild(profile, Value(text))

@borrows
fn HfGlm52W4Afp8ValidateDeploymentReceipt(profile: HfGlm52W4Afp8DeployProfile,
                                          indexJson: str,
                                          receipt: HfGlm52W4Afp8DeploymentReceipt): Result[bool] =
    let expected = HfGlm52W4Afp8DeploymentReceiptBuild(profile, indexJson)
    if IsErr(expected):
        return Err[bool](Error(expected))
    let exp = Value(expected)
    if receipt.schema != HfGlm52W4Afp8DeploymentReceiptSchema ||
       receipt.repoId != exp.repoId ||
       receipt.profileHash != exp.profileHash ||
       receipt.sourceConfigHash != exp.sourceConfigHash ||
       receipt.indexHash != exp.indexHash ||
       receipt.expectedShardFileCount != exp.expectedShardFileCount ||
       receipt.expectedTotalWeightBytes != exp.expectedTotalWeightBytes ||
       receipt.quantMethod != exp.quantMethod ||
       receipt.maxPositionEmbeddings != exp.maxPositionEmbeddings ||
       receipt.mtpLayerCount != exp.mtpLayerCount ||
       receipt.receiptHash != exp.receiptHash:
        return Err[bool]("hf glm52 w4afp8 deployment receipt: drift")
    if HfGlm52W4Afp8DeploymentReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("hf glm52 w4afp8 deployment receipt: hash drift")
    return Ok[bool](true)

fn HfGlm52W4Afp8ValidateDeploymentReceiptPath(profile: HfGlm52W4Afp8DeployProfile,
                                              indexPath: str,
                                              receipt: HfGlm52W4Afp8DeploymentReceipt): Result[bool] =
    let text = hfGlm52W4Afp8ReadTextFile(indexPath, "hf glm52 w4afp8 receipt index")
    if IsErr(text):
        return Err[bool](Error(text))
    return HfGlm52W4Afp8ValidateDeploymentReceipt(profile, Value(text), receipt)

@borrows
fn HfGlm52W4Afp8DeploymentFacts(profile: HfGlm52W4Afp8DeployProfile): str[] =
    var out: str[]
    add(out, strutil.Join(["hf_glm52_w4afp8_repo=", share(profile.repoId)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_profile_hash=", strings.Int64ToStr(profile.profileHash)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_context=", strings.IntToStr(profile.maxPositionEmbeddings)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_mtp_layers=", strings.IntToStr(profile.mtpLayerCount)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_quant=", share(profile.quantMethod)], ""))
    return out

@borrows
fn HfGlm52W4Afp8DeploymentReceiptFacts(receipt: HfGlm52W4Afp8DeploymentReceipt): str[] =
    var out: str[]
    add(out, strutil.Join(["hf_glm52_w4afp8_receipt_hash=", strings.Int64ToStr(receipt.receiptHash)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_index_hash=", strings.Int64ToStr(receipt.indexHash)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_expected_shards=", strings.IntToStr(receipt.expectedShardFileCount)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_expected_bytes=", strings.Int64ToStr(receipt.expectedTotalWeightBytes)], ""))
    return out

@borrows
fn HfGlm52W4Afp8AuditShardReceiptFacts(receipt: HfGlm52W4Afp8AuditShardReceipt): str[] =
    var out: str[]
    add(out, strutil.Join(["hf_glm52_w4afp8_audit_receipt_hash=", strings.Int64ToStr(receipt.receiptHash)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_audit_graph_hash=", strings.Int64ToStr(receipt.auditGraphHash)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_audit_shard_index_hash=", strings.Int64ToStr(receipt.auditShardIndexHash)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_audit_weight_count=", strings.IntToStr(receipt.auditWeightCount)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_audit_index_entries=", strings.IntToStr(receipt.auditIndexEntryCount)], ""))
    add(out, strutil.Join(["hf_glm52_w4afp8_audit_tensor_scale=", strings.IntToStr(receipt.tensorScale)], ""))
    return out

@borrows
fn HfGlmMoeModelTypeSupported(modelType: str): bool =
    if modelType == "glm" || modelType == "chatglm":
        return true
    if modelType == "glm_moe" || modelType == "glm4_moe" || modelType == "glm5_moe":
        return true
    if modelType == "glm5" || modelType == "chatglm_moe":
        return true
    return false

fn HfGlmMoeConfigFromJson(configJson: str): Result[HfGlmMoeConfig] =
    if configJson == "":
        return Err[HfGlmMoeConfig]("hf glm moe config: json")
    let canon = jsoncanon.CsgCoreJsonCanonicalize(configJson)
    if !canon.ok:
        return Err[HfGlmMoeConfig](strutil.Join(["hf glm moe config: json ", share(canon.error)], ""))
    let modelTypeField = jsonfield.CsgCoreJsonTopStringField(configJson, "model_type")
    if !modelTypeField.found || !HfGlmMoeModelTypeSupported(modelTypeField.value):
        return Err[HfGlmMoeConfig]("hf glm moe config: model_type")
    let vocabSize = HfGlmMoeConfigRequiredInt(configJson, "vocab_size")
    if IsErr(vocabSize):
        return Err[HfGlmMoeConfig](Error(vocabSize))
    let hiddenSize = HfGlmMoeConfigRequiredInt(configJson, "hidden_size")
    if IsErr(hiddenSize):
        return Err[HfGlmMoeConfig](Error(hiddenSize))
    let layerCount = HfGlmMoeConfigFirstPositive(configJson, ["num_hidden_layers", "n_layer", "num_layers"], "layer count")
    if IsErr(layerCount):
        return Err[HfGlmMoeConfig](Error(layerCount))
    let attentionHeads = HfGlmMoeConfigFirstPositive(configJson, ["num_attention_heads", "n_head"], "attention heads")
    if IsErr(attentionHeads):
        return Err[HfGlmMoeConfig](Error(attentionHeads))
    var keyValueHeads = Value(attentionHeads)
    let kvHeads = HfGlmMoeConfigOptionalFirstPositive(configJson, ["num_key_value_heads", "multi_query_group_num"])
    if IsErr(kvHeads):
        return Err[HfGlmMoeConfig](Error(kvHeads))
    if Value(kvHeads) > 0:
        keyValueHeads = Value(kvHeads)
    var headDim: int32
    let headDimOpt = HfGlmMoeConfigOptionalInt(configJson, "head_dim")
    if IsErr(headDimOpt):
        return Err[HfGlmMoeConfig](Error(headDimOpt))
    if Value(headDimOpt) > 0:
        headDim = Value(headDimOpt)
    else:
        if Value(hiddenSize) % Value(attentionHeads) != 0:
            return Err[HfGlmMoeConfig]("hf glm moe config: hidden/head divisibility")
        headDim = Value(hiddenSize) / Value(attentionHeads)
    if headDim <= 0 || int64(Value(attentionHeads)) * int64(headDim) != int64(Value(hiddenSize)):
        return Err[HfGlmMoeConfig]("hf glm moe config: head dim")
    if keyValueHeads <= 0 || keyValueHeads > Value(attentionHeads):
        return Err[HfGlmMoeConfig]("hf glm moe config: kv heads")
    if Value(attentionHeads) % keyValueHeads != 0:
        return Err[HfGlmMoeConfig]("hf glm moe config: grouped kv divisibility")
    let intermediateSize = HfGlmMoeConfigFirstPositive(configJson, ["moe_intermediate_size", "intermediate_size", "ffn_hidden_size"], "intermediate size")
    if IsErr(intermediateSize):
        return Err[HfGlmMoeConfig](Error(intermediateSize))
    let expertCount = HfGlmMoeConfigFirstPositive(configJson, ["num_experts", "n_routed_experts", "num_local_experts"], "expert count")
    if IsErr(expertCount):
        return Err[HfGlmMoeConfig](Error(expertCount))
    let topK = HfGlmMoeConfigFirstPositive(configJson, ["num_experts_per_tok", "moe_top_k", "num_selected_experts"], "top k")
    if IsErr(topK):
        return Err[HfGlmMoeConfig](Error(topK))
    if Value(topK) <= 0 || Value(topK) > Value(expertCount):
        return Err[HfGlmMoeConfig]("hf glm moe config: top k")
    let tied = HfGlmMoeConfigOptionalBoolInt(configJson, "tie_word_embeddings", 0)
    if IsErr(tied):
        return Err[HfGlmMoeConfig](Error(tied))
    var tiedBool: bool
    if Value(tied) != 0:
        tiedBool = true
    let ropeTheta = HfGlmMoeConfigOptionalFloat64(configJson, "rope_theta", 10000.0)
    if IsErr(ropeTheta):
        return Err[HfGlmMoeConfig](Error(ropeTheta))
    if (Value(ropeTheta) - 1.0) + 1000000000000000.0 < 1000000000000000.0:
        return Err[HfGlmMoeConfig]("hf glm moe config: rope_theta")
    return Ok[HfGlmMoeConfig](HfGlmMoeConfig(
        modelType: share(modelTypeField.value),
        vocabSize: Value(vocabSize),
        hiddenSize: Value(hiddenSize),
        layerCount: Value(layerCount),
        attentionHeads: Value(attentionHeads),
        keyValueHeads: keyValueHeads,
        headDim: headDim,
        intermediateSize: Value(intermediateSize),
        expertCount: Value(expertCount),
        topK: Value(topK),
        tieWordEmbeddings: tiedBool,
        ropeTheta: Value(ropeTheta),
        sourceConfigHash: HfModelGraphHashTextWith(int64(197), canon.value)
    ))

@borrows
fn HfDenseTransformerModelTypeSupported(modelType: str): bool =
    return modelType == "qwen2"

fn HfDenseTransformerConfigFromJson(configJson: str): Result[HfDenseTransformerConfig] =
    if configJson == "":
        return Err[HfDenseTransformerConfig]("hf dense transformer config: json")
    let canon = jsoncanon.CsgCoreJsonCanonicalize(configJson)
    if !canon.ok:
        return Err[HfDenseTransformerConfig](strutil.Join(["hf dense transformer config: json ", share(canon.error)], ""))
    let modelTypeField = jsonfield.CsgCoreJsonTopStringField(configJson, "model_type")
    if !modelTypeField.found || !HfDenseTransformerModelTypeSupported(modelTypeField.value):
        return Err[HfDenseTransformerConfig]("hf dense transformer config: model_type")
    let vocabSize = HfGlmMoeConfigRequiredInt(configJson, "vocab_size")
    if IsErr(vocabSize):
        return Err[HfDenseTransformerConfig](Error(vocabSize))
    let hiddenSize = HfGlmMoeConfigRequiredInt(configJson, "hidden_size")
    if IsErr(hiddenSize):
        return Err[HfDenseTransformerConfig](Error(hiddenSize))
    let layerCount = HfGlmMoeConfigFirstPositive(configJson, ["num_hidden_layers", "n_layer", "num_layers"], "layer count")
    if IsErr(layerCount):
        return Err[HfDenseTransformerConfig](Error(layerCount))
    let attentionHeads = HfGlmMoeConfigFirstPositive(configJson, ["num_attention_heads", "n_head"], "attention heads")
    if IsErr(attentionHeads):
        return Err[HfDenseTransformerConfig](Error(attentionHeads))
    var keyValueHeads = Value(attentionHeads)
    let kvHeads = HfGlmMoeConfigOptionalFirstPositive(configJson, ["num_key_value_heads", "multi_query_group_num"])
    if IsErr(kvHeads):
        return Err[HfDenseTransformerConfig](Error(kvHeads))
    if Value(kvHeads) > 0:
        keyValueHeads = Value(kvHeads)
    var headDim: int32
    let headDimOpt = HfGlmMoeConfigOptionalInt(configJson, "head_dim")
    if IsErr(headDimOpt):
        return Err[HfDenseTransformerConfig](Error(headDimOpt))
    if Value(headDimOpt) > 0:
        headDim = Value(headDimOpt)
    else:
        if Value(hiddenSize) % Value(attentionHeads) != 0:
            return Err[HfDenseTransformerConfig]("hf dense transformer config: hidden/head divisibility")
        headDim = Value(hiddenSize) / Value(attentionHeads)
    if headDim <= 0 || int64(Value(attentionHeads)) * int64(headDim) != int64(Value(hiddenSize)):
        return Err[HfDenseTransformerConfig]("hf dense transformer config: head dim")
    if keyValueHeads <= 0 || keyValueHeads > Value(attentionHeads):
        return Err[HfDenseTransformerConfig]("hf dense transformer config: kv heads")
    if Value(attentionHeads) % keyValueHeads != 0:
        return Err[HfDenseTransformerConfig]("hf dense transformer config: grouped kv divisibility")
    let intermediateSize = HfGlmMoeConfigFirstPositive(configJson, ["intermediate_size", "ffn_hidden_size"], "intermediate size")
    if IsErr(intermediateSize):
        return Err[HfDenseTransformerConfig](Error(intermediateSize))
    let tied = HfGlmMoeConfigOptionalBoolInt(configJson, "tie_word_embeddings", 0)
    if IsErr(tied):
        return Err[HfDenseTransformerConfig](Error(tied))
    var tiedBool: bool
    if Value(tied) != 0:
        tiedBool = true
    let ropeTheta = HfGlmMoeConfigOptionalFloat64(configJson, "rope_theta", 10000.0)
    if IsErr(ropeTheta):
        return Err[HfDenseTransformerConfig](Error(ropeTheta))
    if (Value(ropeTheta) - 1.0) + 1000000000000000.0 < 1000000000000000.0:
        return Err[HfDenseTransformerConfig]("hf dense transformer config: rope_theta")
    return Ok[HfDenseTransformerConfig](HfDenseTransformerConfig(
        modelType: share(modelTypeField.value),
        vocabSize: Value(vocabSize),
        hiddenSize: Value(hiddenSize),
        layerCount: Value(layerCount),
        attentionHeads: Value(attentionHeads),
        keyValueHeads: keyValueHeads,
        headDim: headDim,
        intermediateSize: Value(intermediateSize),
        tieWordEmbeddings: tiedBool,
        ropeTheta: Value(ropeTheta),
        sourceConfigHash: HfModelGraphHashTextWith(int64(197), canon.value)
    ))

@borrows
fn HfGlmMoeWeightShardCid(modelCid: str, tensorName: str): str =
    return strutil.Join(["cid:hf:", share(modelCid), ":", share(tensorName)], "")

@borrows
fn HfGlmMoeMakeWeight(modelCid: str,
                      tensorName: str,
                      dtype: str,
                      quantScheme: str,
                      shape: int32[]): Result[mg.ModelWeightShard] =
    let sizeBytes = mg.ModelGraphExpectedTensorBytes(dtype, shape)
    if IsErr(sizeBytes):
        return Err[mg.ModelWeightShard](Error(sizeBytes))
    return Ok[mg.ModelWeightShard](mg.ModelWeightShard(
        modelCid: strings.CloneStr(modelCid),
        shardCid: HfGlmMoeWeightShardCid(modelCid, tensorName),
        tensorName: strings.CloneStr(tensorName),
        dtype: strings.CloneStr(dtype),
        quantScheme: strings.CloneStr(quantScheme),
        shape: infer.InferenceShapeCopy(shape),
        sizeBytes: Value(sizeBytes),
        expectedPayloadHash: int64(0)
    ))

@borrows
fn HfGlmMoeMakeLayerWeight(modelCid: str,
                           layerIndex: int32,
                           suffix: str,
                           dtype: str,
                           quantScheme: str,
                           shape: int32[]): Result[mg.ModelWeightShard] =
    let name = strutil.Join(["model.layers.", strings.IntToStr(layerIndex), ".", share(suffix)], "")
    return HfGlmMoeMakeWeight(modelCid, name, dtype, quantScheme, shape)

@borrows
fn HfGlmMoeMakeOp(opKind: str,
                  inputNames: str[],
                  outputName: str,
                  weightNames: str[],
                  layerIndex: int32,
                  expertId: int32): mg.ModelGraphOp =
    var inputCopy: str[]
    for i in 0..<inputNames.len:
        add(inputCopy, share(inputNames[i]))
    var weightCopy: str[]
    for i in 0..<weightNames.len:
        add(weightCopy, share(weightNames[i]))
    return mg.ModelGraphOp(
        opKind: strings.CloneStr(opKind),
        inputNames: inputCopy,
        outputName: strings.CloneStr(outputName),
        weightNames: weightCopy,
        layerIndex: layerIndex,
        expertId: expertId
    )

fn HfModelGraphBuildGlm52W4Afp8AuditGraph(profile: HfGlm52W4Afp8DeployProfile,
                                          indexJson: str,
                                          modelCid: str): Result[mg.ModelGraph] =
    if modelCid == "":
        return Err[mg.ModelGraph]("hf glm52 w4afp8 audit graph: model cid")
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[mg.ModelGraph](Error(profileOk))
    let indexOk = HfGlm52W4Afp8ValidateIndex(profile, indexJson)
    if IsErr(indexOk):
        return Err[mg.ModelGraph](Error(indexOk))
    let qRows64 = int64(profile.attentionHeads) * int64(profile.qkHeadDim)
    let kvARows64 = int64(profile.kvLoraRank) + int64(profile.qkRopeHeadDim)
    let kvBRows64 = int64(profile.attentionHeads) * (int64(profile.qkNopeHeadDim) + int64(profile.vHeadDim))
    let oCols64 = int64(profile.attentionHeads) * int64(profile.vHeadDim)
    let indexRows64 = int64(profile.indexHeads) * int64(profile.indexHeadDim)
    if qRows64 > int64(2147483647) || kvARows64 > int64(2147483647) ||
       kvBRows64 > int64(2147483647) || oCols64 > int64(2147483647) ||
       indexRows64 > int64(2147483647):
        return Err[mg.ModelGraph]("hf glm52 w4afp8 audit graph: derived dimensions")
    let qRows = int32(qRows64)
    let kvARows = int32(kvARows64)
    let kvBRows = int32(kvBRows64)
    let oCols = int32(oCols64)
    let indexRows = int32(indexRows64)
    var tokenShape: int32[]
    add(tokenShape, 1)
    var hiddenShape: int32[]
    add(hiddenShape, 1)
    add(hiddenShape, profile.hiddenSize)
    var logitShape: int32[]
    add(logitShape, 1)
    add(logitShape, profile.vocabSize)
    var tokenDesc: mg.ModelTensorDesc
    tokenDesc.name = "token_ids"
    tokenDesc.dtype = kir.KernelDtypeI32
    tokenDesc.shape = tokenShape
    tokenDesc.quantScheme = mg.ModelQuantSchemeNone
    var hiddenDesc: mg.ModelTensorDesc
    hiddenDesc.name = "hidden"
    hiddenDesc.dtype = kir.KernelDtypeBf16
    hiddenDesc.shape = hiddenShape
    hiddenDesc.quantScheme = mg.ModelQuantSchemeNone
    var logitDesc: mg.ModelTensorDesc
    logitDesc.name = "logits"
    logitDesc.dtype = kir.KernelDtypeBf16
    logitDesc.shape = logitShape
    logitDesc.quantScheme = mg.ModelQuantSchemeNone
    var tensors: mg.ModelTensorDesc[]
    add(tensors, tokenDesc)
    add(tensors, hiddenDesc)
    add(tensors, logitDesc)
    var weights: mg.ModelWeightShard[]
    var ops: mg.ModelGraphOp[]

    let embedWeight = HfGlmMoeMakeWeight(modelCid, "model.embed_tokens.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [profile.vocabSize, profile.hiddenSize])
    if IsErr(embedWeight): return Err[mg.ModelGraph](Error(embedWeight))
    add(weights, Value(embedWeight))
    let finalNormWeight = HfGlmMoeMakeWeight(modelCid, "model.norm.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [profile.hiddenSize])
    if IsErr(finalNormWeight): return Err[mg.ModelGraph](Error(finalNormWeight))
    add(weights, Value(finalNormWeight))
    let lmHeadWeight = HfGlmMoeMakeWeight(modelCid, "lm_head.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [profile.vocabSize, profile.hiddenSize])
    if IsErr(lmHeadWeight): return Err[mg.ModelGraph](Error(lmHeadWeight))
    add(weights, Value(lmHeadWeight))

    let l0InputNorm = HfGlmMoeMakeLayerWeight(modelCid, 0, "input_layernorm.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [profile.hiddenSize])
    if IsErr(l0InputNorm): return Err[mg.ModelGraph](Error(l0InputNorm))
    add(weights, Value(l0InputNorm))
    let l0Qa = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.q_a_proj.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.qLoraRank, profile.hiddenSize])
    if IsErr(l0Qa): return Err[mg.ModelGraph](Error(l0Qa))
    add(weights, Value(l0Qa))
    let l0QaScale = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.q_a_proj.weight_scale_inv", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.qLoraRank])
    if IsErr(l0QaScale): return Err[mg.ModelGraph](Error(l0QaScale))
    add(weights, Value(l0QaScale))
    let l0QaNorm = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.q_a_layernorm.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [profile.qLoraRank])
    if IsErr(l0QaNorm): return Err[mg.ModelGraph](Error(l0QaNorm))
    add(weights, Value(l0QaNorm))
    let l0Qb = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.q_b_proj.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [qRows, profile.qLoraRank])
    if IsErr(l0Qb): return Err[mg.ModelGraph](Error(l0Qb))
    add(weights, Value(l0Qb))
    let l0KvA = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.kv_a_proj_with_mqa.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [kvARows, profile.hiddenSize])
    if IsErr(l0KvA): return Err[mg.ModelGraph](Error(l0KvA))
    add(weights, Value(l0KvA))
    let l0KvNorm = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.kv_a_layernorm.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [profile.kvLoraRank])
    if IsErr(l0KvNorm): return Err[mg.ModelGraph](Error(l0KvNorm))
    add(weights, Value(l0KvNorm))
    let l0KvB = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.kv_b_proj.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [kvBRows, profile.kvLoraRank])
    if IsErr(l0KvB): return Err[mg.ModelGraph](Error(l0KvB))
    add(weights, Value(l0KvB))
    let l0O = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.o_proj.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.hiddenSize, oCols])
    if IsErr(l0O): return Err[mg.ModelGraph](Error(l0O))
    add(weights, Value(l0O))
    let l0Indexer = HfGlmMoeMakeLayerWeight(modelCid, 0, "self_attn.indexer.wq_b.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [indexRows, profile.qLoraRank])
    if IsErr(l0Indexer): return Err[mg.ModelGraph](Error(l0Indexer))
    add(weights, Value(l0Indexer))
    let l0Down = HfGlmMoeMakeLayerWeight(modelCid, 0, "mlp.down_proj.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.hiddenSize, profile.denseIntermediateSize])
    if IsErr(l0Down): return Err[mg.ModelGraph](Error(l0Down))
    add(weights, Value(l0Down))

    let l3Gate = HfGlmMoeMakeLayerWeight(modelCid, 3, "mlp.gate.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.routedExpertCount, profile.hiddenSize])
    if IsErr(l3Gate): return Err[mg.ModelGraph](Error(l3Gate))
    add(weights, Value(l3Gate))
    let l3SharedDown = HfGlmMoeMakeLayerWeight(modelCid, 3, "mlp.shared_experts.down_proj.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.hiddenSize, profile.moeIntermediateSize])
    if IsErr(l3SharedDown): return Err[mg.ModelGraph](Error(l3SharedDown))
    add(weights, Value(l3SharedDown))
    let l3Expert0Gate = HfGlmMoeMakeLayerWeight(modelCid, 3, "mlp.experts.0.gate_proj.weight", kir.KernelDtypeInt8, mg.ModelQuantSchemeW4Afp8, [profile.moeIntermediateSize, profile.hiddenSize])
    if IsErr(l3Expert0Gate): return Err[mg.ModelGraph](Error(l3Expert0Gate))
    add(weights, Value(l3Expert0Gate))
    let l3Expert0GateScale = HfGlmMoeMakeLayerWeight(modelCid, 3, "mlp.experts.0.gate_proj.weight_scale_inv", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.moeIntermediateSize])
    if IsErr(l3Expert0GateScale): return Err[mg.ModelGraph](Error(l3Expert0GateScale))
    add(weights, Value(l3Expert0GateScale))
    let l3Expert0Up = HfGlmMoeMakeLayerWeight(modelCid, 3, "mlp.experts.0.up_proj.weight", kir.KernelDtypeInt8, mg.ModelQuantSchemeW4Afp8, [profile.moeIntermediateSize, profile.hiddenSize])
    if IsErr(l3Expert0Up): return Err[mg.ModelGraph](Error(l3Expert0Up))
    add(weights, Value(l3Expert0Up))
    let l3Expert0UpScale = HfGlmMoeMakeLayerWeight(modelCid, 3, "mlp.experts.0.up_proj.weight_scale_inv", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.moeIntermediateSize])
    if IsErr(l3Expert0UpScale): return Err[mg.ModelGraph](Error(l3Expert0UpScale))
    add(weights, Value(l3Expert0UpScale))
    let l3Expert0InputScale = HfGlmMoeMakeLayerWeight(modelCid, 3, "mlp.experts.0.w1.input_scale", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [1])
    if IsErr(l3Expert0InputScale): return Err[mg.ModelGraph](Error(l3Expert0InputScale))
    add(weights, Value(l3Expert0InputScale))
    let l3Expert255InputScale = HfGlmMoeMakeLayerWeight(modelCid, 3, "mlp.experts.255.w1.input_scale", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [1])
    if IsErr(l3Expert255InputScale): return Err[mg.ModelGraph](Error(l3Expert255InputScale))
    add(weights, Value(l3Expert255InputScale))

    let mtpEh = HfGlmMoeMakeLayerWeight(modelCid, profile.mtpStartLayer, "eh_proj.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.hiddenSize, profile.hiddenSize])
    if IsErr(mtpEh): return Err[mg.ModelGraph](Error(mtpEh))
    add(weights, Value(mtpEh))
    let mtpHNorm = HfGlmMoeMakeLayerWeight(modelCid, profile.mtpStartLayer, "hnorm.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [profile.hiddenSize])
    if IsErr(mtpHNorm): return Err[mg.ModelGraph](Error(mtpHNorm))
    add(weights, Value(mtpHNorm))
    let mtpSharedNorm = HfGlmMoeMakeLayerWeight(modelCid, profile.mtpStartLayer, "shared_head.norm.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [profile.hiddenSize])
    if IsErr(mtpSharedNorm): return Err[mg.ModelGraph](Error(mtpSharedNorm))
    add(weights, Value(mtpSharedNorm))
    let mtpQa = HfGlmMoeMakeLayerWeight(modelCid, profile.mtpStartLayer, "self_attn.q_a_proj.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.qLoraRank, profile.hiddenSize])
    if IsErr(mtpQa): return Err[mg.ModelGraph](Error(mtpQa))
    add(weights, Value(mtpQa))
    let mtpGate = HfGlmMoeMakeLayerWeight(modelCid, profile.mtpStartLayer, "mlp.gate.weight", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [profile.routedExpertCount, profile.hiddenSize])
    if IsErr(mtpGate): return Err[mg.ModelGraph](Error(mtpGate))
    add(weights, Value(mtpGate))
    let mtpExpert255InputScale = HfGlmMoeMakeLayerWeight(modelCid, profile.mtpStartLayer, "mlp.experts.255.w1.input_scale", kir.KernelDtypeFp8E4M3, mg.ModelQuantSchemeNone, [1])
    if IsErr(mtpExpert255InputScale): return Err[mg.ModelGraph](Error(mtpExpert255InputScale))
    add(weights, Value(mtpExpert255InputScale))

    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpEmbedding, ["token_ids"], "hidden0", [ share(Value(embedWeight).tensorName)], -1, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpMlaQCompress, ["hidden0"], "layer0.mla_q", [ share(Value(l0Qa).tensorName), share(Value(l0QaNorm).tensorName), share(Value(l0Qb).tensorName)], 0, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpMlaKvCompress, ["hidden0"], "layer0.mla_kv", [ share(Value(l0KvA).tensorName), share(Value(l0KvNorm).tensorName), share(Value(l0KvB).tensorName)], 0, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpDsaIndexer, ["layer0.mla_q"], "layer0.dsa_index", [ share(Value(l0Indexer).tensorName)], 0, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpAttention, ["layer0.mla_q", "layer0.mla_kv", "layer0.dsa_index"], "layer0.attention", [ share(Value(l0O).tensorName)], 0, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpMlp, ["layer0.attention"], "layer0.dense_mlp", [ share(Value(l0Down).tensorName)], 0, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRouter, ["layer0.dense_mlp"], "layer3.route", [ share(Value(l3Gate).tensorName)], 3, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpExpert, ["layer3.route"], "layer3.expert0", [ share(Value(l3Expert0Gate).tensorName), share(Value(l3Expert0Up).tensorName), share(Value(l3Expert0InputScale).tensorName)], 3, 0))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpMlp, ["layer3.expert0"], "layer3.shared_expert", [ share(Value(l3SharedDown).tensorName)], 3, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpMtpProject, ["layer3.shared_expert"], "layer78.mtp", [ share(Value(mtpEh).tensorName), share(Value(mtpHNorm).tensorName), share(Value(mtpSharedNorm).tensorName)], profile.mtpStartLayer, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpMlaQCompress, ["layer78.mtp"], "layer78.mla_q", [ share(Value(mtpQa).tensorName)], profile.mtpStartLayer, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRouter, ["layer78.mla_q"], "layer78.route", [ share(Value(mtpGate).tensorName)], profile.mtpStartLayer, -1))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpLmHead, ["layer78.route"], "logits", [ share(Value(finalNormWeight).tensorName), share(Value(lmHeadWeight).tensorName)], profile.mtpStartLayer, -1))

    var graph = mg.ModelGraph(
        schema: mg.InferenceModelGraphSchema,
        modelCid: modelCid,
        architecture: mg.InferenceModelArchitectureHfGlm52DsaMlaMtp,
        hiddenSize: profile.hiddenSize,
        attentionHeads: profile.attentionHeads,
        keyValueHeads: profile.keyValueHeads,
        headDim: profile.headDim,
        layerCount: profile.layerCount,
        expertCount: profile.routedExpertCount,
        topK: profile.topK,
        qLoraRank: profile.qLoraRank,
        kvLoraRank: profile.kvLoraRank,
        qkHeadDim: profile.qkHeadDim,
        qkNopeHeadDim: profile.qkNopeHeadDim,
        qkRopeHeadDim: profile.qkRopeHeadDim,
        vHeadDim: profile.vHeadDim,
        denseLayerCount: profile.denseLayerCount,
        sharedExpertCount: profile.sharedExpertCount,
        mtpLayerCount: profile.mtpLayerCount,
        mtpStartLayer: profile.mtpStartLayer,
        indexHeads: profile.indexHeads,
        indexHeadDim: profile.indexHeadDim,
        indexTopK: profile.indexTopK,
        indexTopKFreq: profile.indexTopKFreq,
        ropeTheta: profile.ropeTheta,
        tensors: tensors,
        weights: weights,
        ops: ops,
        graphHash: int64(0)
    )
    graph.graphHash = mg.ModelGraphHash(graph)
    let graphOk = mg.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[mg.ModelGraph](Error(graphOk))
    return Ok[mg.ModelGraph](graph)

@borrows
fn HfGlm52W4Afp8ValidateAuditGraph(profile: HfGlm52W4Afp8DeployProfile,
                                   graph: mg.ModelGraph): Result[bool] =
    let profileOk = HfGlm52W4Afp8ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[bool](Error(profileOk))
    let graphOk = mg.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    if graph.architecture != mg.InferenceModelArchitectureHfGlm52DsaMlaMtp ||
       graph.hiddenSize != profile.hiddenSize ||
       graph.layerCount != profile.layerCount ||
       graph.attentionHeads != profile.attentionHeads ||
       graph.keyValueHeads != profile.keyValueHeads ||
       graph.headDim != profile.headDim ||
       graph.expertCount != profile.routedExpertCount ||
       graph.topK != profile.topK:
        return Err[bool]("hf glm52 w4afp8 audit graph: dimensions")
    if graph.qLoraRank != profile.qLoraRank ||
       graph.kvLoraRank != profile.kvLoraRank ||
       graph.qkHeadDim != profile.qkHeadDim ||
       graph.qkNopeHeadDim != profile.qkNopeHeadDim ||
       graph.qkRopeHeadDim != profile.qkRopeHeadDim ||
       graph.vHeadDim != profile.vHeadDim ||
       graph.denseLayerCount != profile.denseLayerCount ||
       graph.sharedExpertCount != profile.sharedExpertCount ||
       graph.mtpLayerCount != profile.mtpLayerCount ||
       graph.mtpStartLayer != profile.mtpStartLayer ||
       graph.indexHeads != profile.indexHeads ||
       graph.indexHeadDim != profile.indexHeadDim ||
       graph.indexTopK != profile.indexTopK ||
       graph.indexTopKFreq != profile.indexTopKFreq:
        return Err[bool]("hf glm52 w4afp8 audit graph: profile facts")
    let requiredWeights = [
        "model.embed_tokens.weight",
        "model.norm.weight",
        "lm_head.weight",
        "model.layers.0.self_attn.q_a_proj.weight",
        "model.layers.0.self_attn.q_a_proj.weight_scale_inv",
        "model.layers.0.self_attn.q_b_proj.weight",
        "model.layers.0.self_attn.kv_a_proj_with_mqa.weight",
        "model.layers.0.self_attn.kv_a_layernorm.weight",
        "model.layers.0.self_attn.kv_b_proj.weight",
        "model.layers.0.self_attn.o_proj.weight",
        "model.layers.0.self_attn.indexer.wq_b.weight",
        "model.layers.0.mlp.down_proj.weight",
        "model.layers.3.mlp.gate.weight",
        "model.layers.3.mlp.shared_experts.down_proj.weight",
        "model.layers.3.mlp.experts.0.gate_proj.weight",
        "model.layers.3.mlp.experts.0.gate_proj.weight_scale_inv",
        "model.layers.3.mlp.experts.0.up_proj.weight",
        "model.layers.3.mlp.experts.0.w1.input_scale",
        "model.layers.3.mlp.experts.255.w1.input_scale",
        "model.layers.78.eh_proj.weight",
        "model.layers.78.hnorm.weight",
        "model.layers.78.shared_head.norm.weight",
        "model.layers.78.self_attn.q_a_proj.weight",
        "model.layers.78.mlp.gate.weight",
        "model.layers.78.mlp.experts.255.w1.input_scale"
    ]
    for i in 0..<requiredWeights.len:
        if !mg.ModelGraphHasWeight(graph, requiredWeights[i]):
            return Err[bool]("hf glm52 w4afp8 audit graph: missing weight")
    var hasMlaQ: bool
    var hasMlaKv: bool
    var hasDsa: bool
    var hasMtp: bool
    for i in 0..<graph.ops.len:
        if graph.ops[i].opKind == mg.InferenceModelOpMlaQCompress:
            hasMlaQ = true
        elif graph.ops[i].opKind == mg.InferenceModelOpMlaKvCompress:
            hasMlaKv = true
        elif graph.ops[i].opKind == mg.InferenceModelOpDsaIndexer:
            hasDsa = true
        elif graph.ops[i].opKind == mg.InferenceModelOpMtpProject:
            hasMtp = true
    if !hasMlaQ || !hasMlaKv || !hasDsa || !hasMtp:
        return Err[bool]("hf glm52 w4afp8 audit graph: op coverage")
    return Ok[bool](true)

fn HfGlm52W4Afp8BuildAuditShardIndex(profile: HfGlm52W4Afp8DeployProfile,
                                     indexJson: str,
                                     graph: mg.ModelGraph,
                                     baseDir: str,
                                     peerIds: str[],
                                     tensorScale: int32): Result[ws.WeightSafetensorsShardIndex] =
    let graphOk = HfGlm52W4Afp8ValidateAuditGraph(profile, graph)
    if IsErr(graphOk):
        return Err[ws.WeightSafetensorsShardIndex](Error(graphOk))
    let indexOk = HfGlm52W4Afp8ValidateIndex(profile, indexJson)
    if IsErr(indexOk):
        return Err[ws.WeightSafetensorsShardIndex](Error(indexOk))
    if baseDir == "":
        return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: base dir")
    if tensorScale <= 0:
        return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: tensor scale")
    if peerIds.len != graph.weights.len:
        return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: peer count")
    let total = HfGlm52W4Afp8ExpectedWeightCount(profile)
    if IsErr(total):
        return Err[ws.WeightSafetensorsShardIndex](Error(total))
    let layerBase = hfGlm52LayerBaseTable(profile)
    if IsErr(layerBase):
        return Err[ws.WeightSafetensorsShardIndex](Error(layerBase))
    let layerBaseValue = Value(layerBase)
    var targetGraphIndex: int32[]
    setLen(targetGraphIndex, Value(total))
    for i in 0..<targetGraphIndex.len:
        targetGraphIndex[i] = -1
    for i in 0..<graph.weights.len:
        let targetOrdinal = hfGlm52ExpectedWeightOrdinalWithLayerBase(
            profile,
            graph.weights[i].tensorName,
            layerBaseValue
        )
        if IsErr(targetOrdinal):
            return Err[ws.WeightSafetensorsShardIndex](Error(targetOrdinal))
        if Value(targetOrdinal) < 0 || Value(targetOrdinal) >= targetGraphIndex.len:
            return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: target ordinal")
        if targetGraphIndex[Value(targetOrdinal)] >= 0:
            return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: duplicate target")
        targetGraphIndex[Value(targetOrdinal)] = i
    if graph.weights.len <= 0:
        return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: graph weights")
    let rawWeightMap = jsonfield.CsgCoreJsonTopRawField(indexJson, "weight_map")
    if !rawWeightMap.found:
        return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: weight_map")
    var fileNames: str[]
    setLen(fileNames, graph.weights.len)
    var matched: bool[]
    setLen(matched, graph.weights.len)
    var matchedCount: int32
    var pos: int32 = hfJsonSkipWs(rawWeightMap.value, 0)
    if pos >= rawWeightMap.value.len || rawWeightMap.value[pos] != '{':
        return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: weight_map object")
    pos = pos + 1
    var expectValue = false
    while pos < rawWeightMap.value.len:
        pos = hfJsonSkipWs(rawWeightMap.value, pos)
        if pos < rawWeightMap.value.len && rawWeightMap.value[pos] == '}':
            pos = pos + 1
            break
        if expectValue:
            if pos >= rawWeightMap.value.len || rawWeightMap.value[pos] != ',':
                return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: weight_map comma")
            pos = pos + 1
            pos = hfJsonSkipWs(rawWeightMap.value, pos)
        let key = hfGlm52JsonReadSimpleString(rawWeightMap.value, pos)
        if IsErr(key):
            return Err[ws.WeightSafetensorsShardIndex](Error(key))
        pos = hfJsonSkipWs(rawWeightMap.value, Value(key).nextPos)
        if pos >= rawWeightMap.value.len || rawWeightMap.value[pos] != ':':
            return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: weight_map colon")
        let fileName = hfGlm52JsonReadSimpleString(rawWeightMap.value, pos + 1)
        if IsErr(fileName):
            return Err[ws.WeightSafetensorsShardIndex](Error(fileName))
        let ordinal = hfGlm52ExpectedWeightOrdinalWithLayerBase(profile, Value(key).value, layerBaseValue)
        if IsErr(ordinal):
            return Err[ws.WeightSafetensorsShardIndex](Error(ordinal))
        if Value(ordinal) < 0 || Value(ordinal) >= targetGraphIndex.len:
            return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: ordinal")
        let graphIndex = targetGraphIndex[Value(ordinal)]
        if graphIndex >= 0:
            if !ws.WeightSafetensorsHfShardFileNameIsSafe(Value(fileName).value):
                return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: shard file name")
            if matched[graphIndex]:
                return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: duplicate tensor")
            matched[graphIndex] = true
            fileNames[graphIndex] = Value(fileName).value
            matchedCount = matchedCount + 1
        pos = Value(fileName).nextPos
        expectValue = true
    pos = hfJsonSkipWs(rawWeightMap.value, pos)
    if pos != rawWeightMap.value.len:
        return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: weight_map trailing")
    if matchedCount != graph.weights.len:
        return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: missing tensor")
    var entries: ws.WeightSafetensorsShardIndexEntry[]
    for i in 0..<graph.weights.len:
        if peerIds[i] == "":
            return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: peer id")
        if !matched[i]:
            return Err[ws.WeightSafetensorsShardIndex]("hf glm52 w4afp8 audit shard index: missing tensor")
        add(entries, ws.WeightSafetensorsShardIndexEntry(
            modelCid: graph.weights[i].modelCid,
            graphHash: graph.graphHash,
            tensorName: graph.weights[i].tensorName,
            shardCid: graph.weights[i].shardCid,
            dtype: graph.weights[i].dtype,
            quantScheme: graph.weights[i].quantScheme,
            sizeBytes: graph.weights[i].sizeBytes,
            filePath: os.JoinPath(baseDir, fileNames[i]),
            peerId: peerIds[i],
            tensorScale: tensorScale
        ))
    let index = ws.WeightSafetensorsShardIndexBuild(graph.modelCid, graph.graphHash, entries)
    let indexValid = ws.WeightSafetensorsShardIndexValidate(index, graph)
    if IsErr(indexValid):
        return Err[ws.WeightSafetensorsShardIndex](Error(indexValid))
    return Ok[ws.WeightSafetensorsShardIndex](index)

@borrows
fn HfGlm52W4Afp8AuditPeerIds(graph: mg.ModelGraph, peerId: str): Result[str[]] =
    if peerId == "":
        return Err[str[]]("hf glm52 w4afp8 audit peer ids: peer id")
    let graphOk = mg.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[str[]](Error(graphOk))
    var peers: str[]
    for i in 0..<graph.weights.len:
        add(peers, peerId)
    return Ok[str[]](peers)

fn HfGlm52W4Afp8AuditShardReceiptBuild(profile: HfGlm52W4Afp8DeployProfile,
                                       indexJson: str,
                                       modelCid: str,
                                       baseDir: str,
                                       auditPeerId: str,
                                       tensorScale: int32): Result[HfGlm52W4Afp8AuditShardReceipt] =
    let deployment = HfGlm52W4Afp8DeploymentReceiptBuild(profile, indexJson)
    if IsErr(deployment):
        return Err[HfGlm52W4Afp8AuditShardReceipt](Error(deployment))
    let graph = HfModelGraphBuildGlm52W4Afp8AuditGraph(profile, indexJson, modelCid)
    if IsErr(graph):
        return Err[HfGlm52W4Afp8AuditShardReceipt](Error(graph))
    let peers = HfGlm52W4Afp8AuditPeerIds(Value(graph), auditPeerId)
    if IsErr(peers):
        return Err[HfGlm52W4Afp8AuditShardReceipt](Error(peers))
    let shardIndex = HfGlm52W4Afp8BuildAuditShardIndex(
        profile,
        indexJson,
        Value(graph),
        baseDir,
        Value(peers),
        tensorScale
    )
    if IsErr(shardIndex):
        return Err[HfGlm52W4Afp8AuditShardReceipt](Error(shardIndex))
    var out = HfGlm52W4Afp8AuditShardReceipt(
        schema: HfGlm52W4Afp8AuditShardReceiptSchema,
        repoId: profile.repoId,
        modelCid: modelCid,
        baseDir: baseDir,
        auditPeerId: auditPeerId,
        profileHash: profile.profileHash,
        sourceConfigHash: profile.sourceConfigHash,
        deploymentReceiptHash: Value(deployment).receiptHash,
        indexHash: Value(deployment).indexHash,
        auditGraphHash: Value(graph).graphHash,
        auditShardIndexHash: Value(shardIndex).indexHash,
        auditWeightCount: Value(graph).weights.len,
        auditIndexEntryCount: Value(shardIndex).entries.len,
        tensorScale: tensorScale,
        receiptHash: int64(0)
    )
    if out.auditWeightCount <= 0 || out.auditIndexEntryCount != out.auditWeightCount:
        return Err[HfGlm52W4Afp8AuditShardReceipt]("hf glm52 w4afp8 audit shard receipt: count")
    out.receiptHash = HfGlm52W4Afp8AuditShardReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[HfGlm52W4Afp8AuditShardReceipt]("hf glm52 w4afp8 audit shard receipt: hash")
    return Ok[HfGlm52W4Afp8AuditShardReceipt](out)

fn HfGlm52W4Afp8AuditShardReceiptBuildFromIndexPath(profile: HfGlm52W4Afp8DeployProfile,
                                                    indexPath: str,
                                                    modelCid: str,
                                                    baseDir: str,
                                                    auditPeerId: str,
                                                    tensorScale: int32): Result[HfGlm52W4Afp8AuditShardReceipt] =
    let text = hfGlm52W4Afp8ReadTextFile(indexPath, "hf glm52 w4afp8 audit shard index")
    if IsErr(text):
        return Err[HfGlm52W4Afp8AuditShardReceipt](Error(text))
    return HfGlm52W4Afp8AuditShardReceiptBuild(
        profile,
        Value(text),
        modelCid,
        baseDir,
        auditPeerId,
        tensorScale
    )

fn HfGlm52W4Afp8AuditShardHeaderPreflightBuild(profile: HfGlm52W4Afp8DeployProfile,
                                               indexJson: str,
                                               modelCid: str,
                                               baseDir: str,
                                               auditPeerId: str,
                                               tensorScale: int32): Result[ws.WeightSafetensorsShardHeaderPreflight] =
