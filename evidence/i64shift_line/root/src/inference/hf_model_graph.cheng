fn HfGlm52W4Afp8AuditShardDevicePageBindingSetBuild(profile: HfGlm52W4Afp8DeployProfile,
                                                     indexJson: str,
                                                     modelCid: str,
                                                     baseDir: str,
                                                     auditPeerId: str,
                                                     tensorScale: int32,
                                                     targetDevice: dev.Device,
                                                     chunkBytes: int32,
                                                     pageBytes: int64): Result[ws.WeightSafetensorsDevicePageBindingSet] =
    let graph = HfModelGraphBuildGlm52W4Afp8AuditGraph(profile, indexJson, modelCid)
    if IsErr(graph):
        return Err[ws.WeightSafetensorsDevicePageBindingSet](Error(graph))
    let peers = HfGlm52W4Afp8AuditPeerIds(Value(graph), auditPeerId)
    if IsErr(peers):
        return Err[ws.WeightSafetensorsDevicePageBindingSet](Error(peers))
    let shardIndex = HfGlm52W4Afp8BuildAuditShardIndex(
        profile,
        indexJson,
        Value(graph),
        baseDir,
        Value(peers),
        tensorScale
    )
    if IsErr(shardIndex):
        return Err[ws.WeightSafetensorsDevicePageBindingSet](Error(shardIndex))
    return ws.WeightSafetensorsBuildDevicePageBindingSetForDevice(
        Value(shardIndex),
        Value(graph),
        chunkBytes,
        targetDevice,
        pageBytes
    )

fn HfGlm52W4Afp8AuditShardDevicePageBindingSetBuildFromIndexPath(profile: HfGlm52W4Afp8DeployProfile,
                                                                 indexPath: str,
                                                                 modelCid: str,
                                                                 baseDir: str,
                                                                 auditPeerId: str,
                                                                 tensorScale: int32,
                                                                 targetDevice: dev.Device,
                                                                 chunkBytes: int32,
                                                                 pageBytes: int64): Result[ws.WeightSafetensorsDevicePageBindingSet] =
    let text = hfGlm52W4Afp8ReadTextFile(indexPath, "hf glm52 w4afp8 audit shard device page binding index")
    if IsErr(text):
        return Err[ws.WeightSafetensorsDevicePageBindingSet](Error(text))
    return HfGlm52W4Afp8AuditShardDevicePageBindingSetBuild(
        profile,
        Value(text),
        modelCid,
        baseDir,
        auditPeerId,
        tensorScale,
        targetDevice,
        chunkBytes,
        pageBytes
    )

@borrows
fn HfGlm52W4Afp8ValidateAuditShardReceipt(profile: HfGlm52W4Afp8DeployProfile,
                                          indexJson: str,
                                          receipt: HfGlm52W4Afp8AuditShardReceipt): Result[bool] =
    let expected = HfGlm52W4Afp8AuditShardReceiptBuild(
        profile,
        indexJson,
        receipt.modelCid,
        receipt.baseDir,
        receipt.auditPeerId,
        receipt.tensorScale
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let exp = Value(expected)
    if receipt.schema != HfGlm52W4Afp8AuditShardReceiptSchema ||
       receipt.repoId != exp.repoId ||
       receipt.modelCid != exp.modelCid ||
       receipt.baseDir != exp.baseDir ||
       receipt.auditPeerId != exp.auditPeerId ||
       receipt.profileHash != exp.profileHash ||
       receipt.sourceConfigHash != exp.sourceConfigHash ||
       receipt.deploymentReceiptHash != exp.deploymentReceiptHash ||
       receipt.indexHash != exp.indexHash ||
       receipt.auditGraphHash != exp.auditGraphHash ||
       receipt.auditShardIndexHash != exp.auditShardIndexHash ||
       receipt.auditWeightCount != exp.auditWeightCount ||
       receipt.auditIndexEntryCount != exp.auditIndexEntryCount ||
       receipt.tensorScale != exp.tensorScale ||
       receipt.receiptHash != exp.receiptHash:
        return Err[bool]("hf glm52 w4afp8 audit shard receipt: drift")
    if HfGlm52W4Afp8AuditShardReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("hf glm52 w4afp8 audit shard receipt: hash drift")
    return Ok[bool](true)

fn HfGlm52W4Afp8ValidateAuditShardReceiptPath(profile: HfGlm52W4Afp8DeployProfile,
                                              indexPath: str,
                                              receipt: HfGlm52W4Afp8AuditShardReceipt): Result[bool] =
    let text = hfGlm52W4Afp8ReadTextFile(indexPath, "hf glm52 w4afp8 audit shard receipt index")
    if IsErr(text):
        return Err[bool](Error(text))
    return HfGlm52W4Afp8ValidateAuditShardReceipt(profile, Value(text), receipt)

@borrows
fn HfGlmMoeValidateWeightClass(dtype: str, quantScheme: str, label: str): Result[bool] =
    let ok = mg.ModelGraphWeightQuantSchemeValid(dtype, quantScheme)
    if IsErr(ok):
        return Err[bool](strutil.Join([ share(label), ": ", Error(ok)], ""))
    return Ok[bool](true)

fn HfModelGraphBuildGlmMoeFromConfig(configJson: str,
                                     modelCid: str,
                                     linearDtype: str,
                                     linearQuantScheme: str): Result[mg.ModelGraph] =
    if modelCid == "":
        return Err[mg.ModelGraph]("hf glm moe graph: model cid")
    let linearOk = HfGlmMoeValidateWeightClass(linearDtype, linearQuantScheme, "hf glm moe graph: linear")
    if IsErr(linearOk):
        return Err[mg.ModelGraph](Error(linearOk))
    let normOk = HfGlmMoeValidateWeightClass(kir.KernelDtypeFp16, mg.ModelQuantSchemeNone, "hf glm moe graph: norm")
    if IsErr(normOk):
        return Err[mg.ModelGraph](Error(normOk))
    let cfgRes = HfGlmMoeConfigFromJson(configJson)
    if IsErr(cfgRes):
        return Err[mg.ModelGraph](Error(cfgRes))
    let cfg = Value(cfgRes)
    let kvRows64 = int64(cfg.keyValueHeads) * int64(cfg.headDim)
    if kvRows64 <= int64(0) || kvRows64 > int64(2147483647):
        return Err[mg.ModelGraph]("hf glm moe graph: kv rows")
    let kvRows = int32(kvRows64)
    var tokenShape: int32[]
    add(tokenShape, 1)
    var hiddenShape: int32[]
    add(hiddenShape, 1)
    add(hiddenShape, cfg.hiddenSize)
    var logitShape: int32[]
    add(logitShape, 1)
    add(logitShape, cfg.vocabSize)
    var tokenDesc: mg.ModelTensorDesc
    tokenDesc.name = "token_ids"
    tokenDesc.dtype = kir.KernelDtypeI32
    tokenDesc.shape = tokenShape
    tokenDesc.quantScheme = mg.ModelQuantSchemeNone
    var hiddenDesc: mg.ModelTensorDesc
    hiddenDesc.name = "hidden"
    hiddenDesc.dtype = kir.KernelDtypeFp16
    hiddenDesc.shape = hiddenShape
    hiddenDesc.quantScheme = mg.ModelQuantSchemeNone
    var logitDesc: mg.ModelTensorDesc
    logitDesc.name = "logits"
    logitDesc.dtype = kir.KernelDtypeFp16
    logitDesc.shape = logitShape
    logitDesc.quantScheme = mg.ModelQuantSchemeNone
    var tensors: mg.ModelTensorDesc[]
    add(tensors, tokenDesc)
    add(tensors, hiddenDesc)
    add(tensors, logitDesc)
    var weights: mg.ModelWeightShard[]
    var ops: mg.ModelGraphOp[]

    let embedName = "model.embed_tokens.weight"
    let embedWeight = HfGlmMoeMakeWeight(modelCid, embedName, kir.KernelDtypeFp16, mg.ModelQuantSchemeNone, [cfg.vocabSize, cfg.hiddenSize])
    if IsErr(embedWeight):
        return Err[mg.ModelGraph](Error(embedWeight))
    add(weights, Value(embedWeight))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpEmbedding, ["token_ids"], "hidden0", [ share(embedName)], -1, -1))

    var previous = "hidden0"
    for layerIndex in 0..<cfg.layerCount:
        let inputNormWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "input_layernorm.weight", kir.KernelDtypeFp16, mg.ModelQuantSchemeNone, [cfg.hiddenSize])
        if IsErr(inputNormWeight):
            return Err[mg.ModelGraph](Error(inputNormWeight))
        add(weights, Value(inputNormWeight))
        let inputNormOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".input_norm"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRmsNorm, [ share(previous)], inputNormOut, [ share(Value(inputNormWeight).tensorName)], layerIndex, -1))

        let qWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.q_proj.weight", linearDtype, linearQuantScheme, [cfg.hiddenSize, cfg.hiddenSize])
        if IsErr(qWeight):
            return Err[mg.ModelGraph](Error(qWeight))
        add(weights, Value(qWeight))
        let kWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.k_proj.weight", linearDtype, linearQuantScheme, [kvRows, cfg.hiddenSize])
        if IsErr(kWeight):
            return Err[mg.ModelGraph](Error(kWeight))
        add(weights, Value(kWeight))
        let vWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.v_proj.weight", linearDtype, linearQuantScheme, [kvRows, cfg.hiddenSize])
        if IsErr(vWeight):
            return Err[mg.ModelGraph](Error(vWeight))
        add(weights, Value(vWeight))
        let oWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.o_proj.weight", linearDtype, linearQuantScheme, [cfg.hiddenSize, cfg.hiddenSize])
        if IsErr(oWeight):
            return Err[mg.ModelGraph](Error(oWeight))
        add(weights, Value(oWeight))
        let qkvOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".qkv"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpQkv, [ share(inputNormOut)], qkvOut, [ share(Value(qWeight).tensorName), share(Value(kWeight).tensorName), share(Value(vWeight).tensorName), share(Value(oWeight).tensorName)], layerIndex, -1))
        let ropeOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".rope"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRope, [ share(qkvOut)], ropeOut, [], layerIndex, -1))
        let attnOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".attention"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpAttention, [ share(ropeOut)], attnOut, [ share(Value(oWeight).tensorName)], layerIndex, -1))
        let attnResidualOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".attention_residual"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpResidualAdd, [ share(previous), share(attnOut)], attnResidualOut, [], layerIndex, -1))

        let postNormWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "post_attention_layernorm.weight", kir.KernelDtypeFp16, mg.ModelQuantSchemeNone, [cfg.hiddenSize])
        if IsErr(postNormWeight):
            return Err[mg.ModelGraph](Error(postNormWeight))
        add(weights, Value(postNormWeight))
        let postNormOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".post_norm"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRmsNorm, [ share(attnResidualOut)], postNormOut, [ share(Value(postNormWeight).tensorName)], layerIndex, -1))

        let routerWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "mlp.gate.weight", linearDtype, linearQuantScheme, [cfg.expertCount, cfg.hiddenSize])
        if IsErr(routerWeight):
            return Err[mg.ModelGraph](Error(routerWeight))
        add(weights, Value(routerWeight))
        let routeOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".route"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRouter, [ share(postNormOut)], routeOut, [ share(Value(routerWeight).tensorName)], layerIndex, -1))

        var expertOutputs: str[]
        for expertId in 0..<cfg.expertCount:
            let expertPrefix = strutil.Join(["mlp.experts.", strings.IntToStr(expertId), "."], "")
            let gateWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, strutil.Join([expertPrefix, "gate_proj.weight"], ""), linearDtype, linearQuantScheme, [cfg.intermediateSize, cfg.hiddenSize])
            if IsErr(gateWeight):
                return Err[mg.ModelGraph](Error(gateWeight))
            add(weights, Value(gateWeight))
            let upWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, strutil.Join([expertPrefix, "up_proj.weight"], ""), linearDtype, linearQuantScheme, [cfg.intermediateSize, cfg.hiddenSize])
            if IsErr(upWeight):
                return Err[mg.ModelGraph](Error(upWeight))
            add(weights, Value(upWeight))
            let downWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, strutil.Join([expertPrefix, "down_proj.weight"], ""), linearDtype, linearQuantScheme, [cfg.hiddenSize, cfg.intermediateSize])
            if IsErr(downWeight):
                return Err[mg.ModelGraph](Error(downWeight))
            add(weights, Value(downWeight))
            let expertOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".expert", strings.IntToStr(expertId)], "")
            add(expertOutputs, expertOut)
            add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpExpert, [ share(postNormOut), share(routeOut)], expertOut, [ share(Value(gateWeight).tensorName), share(Value(upWeight).tensorName), share(Value(downWeight).tensorName)], layerIndex, expertId))
        let moeOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".moe_delta"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpMlp, expertOutputs, moeOut, [], layerIndex, -1))
        previous = strutil.Join(["layer", strings.IntToStr(layerIndex), ".moe"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpResidualAdd, [ share(attnResidualOut), share(moeOut)], previous, [], layerIndex, -1))

    let finalNormName = "model.norm.weight"
    let finalNormWeight = HfGlmMoeMakeWeight(modelCid, finalNormName, kir.KernelDtypeFp16, mg.ModelQuantSchemeNone, [cfg.hiddenSize])
    if IsErr(finalNormWeight):
        return Err[mg.ModelGraph](Error(finalNormWeight))
    add(weights, Value(finalNormWeight))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRmsNorm, [ share(previous)], "model.norm", [ share(finalNormName)], cfg.layerCount, -1))

    var lmHeadName = "lm_head.weight"
    if cfg.tieWordEmbeddings:
        lmHeadName = embedName
    else:
        let lmHeadWeight = HfGlmMoeMakeWeight(modelCid, lmHeadName, kir.KernelDtypeFp16, mg.ModelQuantSchemeNone, [cfg.vocabSize, cfg.hiddenSize])
        if IsErr(lmHeadWeight):
            return Err[mg.ModelGraph](Error(lmHeadWeight))
        add(weights, Value(lmHeadWeight))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpLmHead, ["model.norm"], "logits", [ share(lmHeadName)], cfg.layerCount, -1))

    var graph = mg.ModelGraph(
        schema: mg.InferenceModelGraphSchema,
        modelCid: modelCid,
        architecture: "hf_glm_moe",
        hiddenSize: cfg.hiddenSize,
        attentionHeads: cfg.attentionHeads,
        keyValueHeads: cfg.keyValueHeads,
        headDim: cfg.headDim,
        layerCount: cfg.layerCount,
        expertCount: cfg.expertCount,
        topK: cfg.topK,
        ropeTheta: cfg.ropeTheta,
        tensors: tensors,
        weights: weights,
        ops: ops,
        graphHash: int64(0)
    )
    graph.graphHash = mg.ModelGraphHash(graph)
    let graphOk = mg.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[mg.ModelGraph](Error(graphOk))
    return Ok[mg.ModelGraph](graph)

fn HfModelGraphBuildDenseTransformerFromConfig(configJson: str,
                                               modelCid: str,
                                               linearDtype: str,
                                               linearQuantScheme: str): Result[mg.ModelGraph] =
    if modelCid == "":
        return Err[mg.ModelGraph]("hf dense transformer graph: model cid")
    let linearOk = HfGlmMoeValidateWeightClass(linearDtype, linearQuantScheme, "hf dense transformer graph: linear")
    if IsErr(linearOk):
        return Err[mg.ModelGraph](Error(linearOk))
    let normOk = HfGlmMoeValidateWeightClass(kir.KernelDtypeFp16, mg.ModelQuantSchemeNone, "hf dense transformer graph: norm")
    if IsErr(normOk):
        return Err[mg.ModelGraph](Error(normOk))
    let cfgRes = HfDenseTransformerConfigFromJson(configJson)
    if IsErr(cfgRes):
        return Err[mg.ModelGraph](Error(cfgRes))
    let cfg = Value(cfgRes)
    let kvRows64 = int64(cfg.keyValueHeads) * int64(cfg.headDim)
    if kvRows64 <= int64(0) || kvRows64 > int64(2147483647):
        return Err[mg.ModelGraph]("hf dense transformer graph: kv rows")
    let kvRows = int32(kvRows64)
    # HF checkpoints store every tensor (linears, norms, embedding) in one
    # torch_dtype; when the caller asks for the unquantized bf16 linear class
    # (real Qwen2.5 safetensors are BF16 throughout) the norm/embedding/lm_head
    # weights must follow that dtype or safetensors header validation
    # hard-fails on "dtype mismatch". Every existing caller passes fp16, for
    # which normDtype stays the previously hardcoded KernelDtypeFp16 --
    # byte-for-byte identical graphs.
    var normDtype = kir.KernelDtypeFp16
    if linearDtype == kir.KernelDtypeBf16 && linearQuantScheme == mg.ModelQuantSchemeNone:
        normDtype = kir.KernelDtypeBf16
    var tokenShape: int32[]
    add(tokenShape, 1)
    var hiddenShape: int32[]
    add(hiddenShape, 1)
    add(hiddenShape, cfg.hiddenSize)
    var logitShape: int32[]
    add(logitShape, 1)
    add(logitShape, cfg.vocabSize)
    var tokenDesc: mg.ModelTensorDesc
    tokenDesc.name = "token_ids"
    tokenDesc.dtype = kir.KernelDtypeI32
    tokenDesc.shape = tokenShape
    tokenDesc.quantScheme = mg.ModelQuantSchemeNone
    var hiddenDesc: mg.ModelTensorDesc
    hiddenDesc.name = "hidden"
    hiddenDesc.dtype = kir.KernelDtypeFp16
    hiddenDesc.shape = hiddenShape
    hiddenDesc.quantScheme = mg.ModelQuantSchemeNone
    var logitDesc: mg.ModelTensorDesc
    logitDesc.name = "logits"
    logitDesc.dtype = kir.KernelDtypeFp16
    logitDesc.shape = logitShape
    logitDesc.quantScheme = mg.ModelQuantSchemeNone
    var tensors: mg.ModelTensorDesc[]
    add(tensors, tokenDesc)
    add(tensors, hiddenDesc)
    add(tensors, logitDesc)
    var weights: mg.ModelWeightShard[]
    var ops: mg.ModelGraphOp[]

    let embedName = "model.embed_tokens.weight"
    let embedWeight = HfGlmMoeMakeWeight(modelCid, embedName, normDtype, mg.ModelQuantSchemeNone, [cfg.vocabSize, cfg.hiddenSize])
    if IsErr(embedWeight):
        return Err[mg.ModelGraph](Error(embedWeight))
    add(weights, Value(embedWeight))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpEmbedding, ["token_ids"], "hidden0", [ share(embedName)], -1, -1))

    var previous = "hidden0"
    for layerIndex in 0..<cfg.layerCount:
        let inputNormWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "input_layernorm.weight", normDtype, mg.ModelQuantSchemeNone, [cfg.hiddenSize])
        if IsErr(inputNormWeight):
            return Err[mg.ModelGraph](Error(inputNormWeight))
        add(weights, Value(inputNormWeight))
        let inputNormOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".input_norm"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRmsNorm, [ share(previous)], inputNormOut, [ share(Value(inputNormWeight).tensorName)], layerIndex, -1))

        let qWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.q_proj.weight", linearDtype, linearQuantScheme, [cfg.hiddenSize, cfg.hiddenSize])
        if IsErr(qWeight):
            return Err[mg.ModelGraph](Error(qWeight))
        add(weights, Value(qWeight))
        let kWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.k_proj.weight", linearDtype, linearQuantScheme, [kvRows, cfg.hiddenSize])
        if IsErr(kWeight):
            return Err[mg.ModelGraph](Error(kWeight))
        add(weights, Value(kWeight))
        let vWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.v_proj.weight", linearDtype, linearQuantScheme, [kvRows, cfg.hiddenSize])
        if IsErr(vWeight):
            return Err[mg.ModelGraph](Error(vWeight))
        add(weights, Value(vWeight))
        let oWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.o_proj.weight", linearDtype, linearQuantScheme, [cfg.hiddenSize, cfg.hiddenSize])
        if IsErr(oWeight):
            return Err[mg.ModelGraph](Error(oWeight))
        add(weights, Value(oWeight))
        # Qwen2 q/k/v projections each carry a 1-D bias (o_proj has none); the
        # checkpoint stores them in the model's torch_dtype (normDtype), so they
        # ride the norm/embedding dtype rather than the (possibly quantized)
        # linear class. Appended to the QKV op's weightNames at indices 4/5/6;
        # the GLM MoE builder above keeps its bias-free 4-weight QKV op.
        let qBias = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.q_proj.bias", normDtype, mg.ModelQuantSchemeNone, [cfg.hiddenSize])
        if IsErr(qBias):
            return Err[mg.ModelGraph](Error(qBias))
        add(weights, Value(qBias))
        let kBias = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.k_proj.bias", normDtype, mg.ModelQuantSchemeNone, [kvRows])
        if IsErr(kBias):
            return Err[mg.ModelGraph](Error(kBias))
        add(weights, Value(kBias))
        let vBias = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "self_attn.v_proj.bias", normDtype, mg.ModelQuantSchemeNone, [kvRows])
        if IsErr(vBias):
            return Err[mg.ModelGraph](Error(vBias))
        add(weights, Value(vBias))
        let qkvOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".qkv"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpQkv, [ share(inputNormOut)], qkvOut, [ share(Value(qWeight).tensorName), share(Value(kWeight).tensorName), share(Value(vWeight).tensorName), share(Value(oWeight).tensorName), share(Value(qBias).tensorName), share(Value(kBias).tensorName), share(Value(vBias).tensorName)], layerIndex, -1))
        let ropeOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".rope"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRope, [ share(qkvOut)], ropeOut, [], layerIndex, -1))
        let attnOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".attention"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpAttention, [ share(ropeOut)], attnOut, [ share(Value(oWeight).tensorName)], layerIndex, -1))
        let attnResidualOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".attention_residual"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpResidualAdd, [ share(previous), share(attnOut)], attnResidualOut, [], layerIndex, -1))

        let postNormWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "post_attention_layernorm.weight", normDtype, mg.ModelQuantSchemeNone, [cfg.hiddenSize])
        if IsErr(postNormWeight):
            return Err[mg.ModelGraph](Error(postNormWeight))
        add(weights, Value(postNormWeight))
        let postNormOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".post_norm"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRmsNorm, [ share(attnResidualOut)], postNormOut, [ share(Value(postNormWeight).tensorName)], layerIndex, -1))

        let gateWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "mlp.gate_proj.weight", linearDtype, linearQuantScheme, [cfg.intermediateSize, cfg.hiddenSize])
        if IsErr(gateWeight):
            return Err[mg.ModelGraph](Error(gateWeight))
        add(weights, Value(gateWeight))
        let upWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "mlp.up_proj.weight", linearDtype, linearQuantScheme, [cfg.intermediateSize, cfg.hiddenSize])
        if IsErr(upWeight):
            return Err[mg.ModelGraph](Error(upWeight))
        add(weights, Value(upWeight))
        let downWeight = HfGlmMoeMakeLayerWeight(modelCid, layerIndex, "mlp.down_proj.weight", linearDtype, linearQuantScheme, [cfg.hiddenSize, cfg.intermediateSize])
        if IsErr(downWeight):
            return Err[mg.ModelGraph](Error(downWeight))
        add(weights, Value(downWeight))
        let mlpOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".mlp"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpMlp, [ share(postNormOut)], mlpOut, [ share(Value(gateWeight).tensorName), share(Value(upWeight).tensorName), share(Value(downWeight).tensorName)], layerIndex, -1))
        previous = strutil.Join(["layer", strings.IntToStr(layerIndex), ".residual"], "")
        add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpResidualAdd, [ share(attnResidualOut), share(mlpOut)], previous, [], layerIndex, -1))

    let finalNormName = "model.norm.weight"
    let finalNormWeight = HfGlmMoeMakeWeight(modelCid, finalNormName, normDtype, mg.ModelQuantSchemeNone, [cfg.hiddenSize])
    if IsErr(finalNormWeight):
        return Err[mg.ModelGraph](Error(finalNormWeight))
    add(weights, Value(finalNormWeight))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpRmsNorm, [ share(previous)], "model.norm", [ share(finalNormName)], cfg.layerCount, -1))

    var lmHeadName = "lm_head.weight"
    if cfg.tieWordEmbeddings:
        lmHeadName = embedName
    else:
        let lmHeadWeight = HfGlmMoeMakeWeight(modelCid, lmHeadName, normDtype, mg.ModelQuantSchemeNone, [cfg.vocabSize, cfg.hiddenSize])
        if IsErr(lmHeadWeight):
            return Err[mg.ModelGraph](Error(lmHeadWeight))
        add(weights, Value(lmHeadWeight))
    add(ops, HfGlmMoeMakeOp(mg.InferenceModelOpLmHead, ["model.norm"], "logits", [ share(lmHeadName)], cfg.layerCount, -1))

    var graph = mg.ModelGraph(
        schema: mg.InferenceModelGraphSchema,
        modelCid: modelCid,
        architecture: mg.InferenceModelArchitectureDenseTransformer,
        hiddenSize: cfg.hiddenSize,
        attentionHeads: cfg.attentionHeads,
        keyValueHeads: cfg.keyValueHeads,
        headDim: cfg.headDim,
        layerCount: cfg.layerCount,
        expertCount: 1,
        topK: 1,
        ropeTheta: cfg.ropeTheta,
        tensors: tensors,
        weights: weights,
        ops: ops,
        graphHash: int64(0)
    )
    graph.graphHash = mg.ModelGraphHash(graph)
    let graphOk = mg.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[mg.ModelGraph](Error(graphOk))
    return Ok[mg.ModelGraph](graph)
