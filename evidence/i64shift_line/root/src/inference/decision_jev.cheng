# Jev 对照适配器 (OpenSpec csg-semantic-decision-computer-use 任务 13 首切片)。
#
# 唯一需求来源: openspec/proposals/csg-semantic-decision-computer-use.md §3
# (适配器只做协议映射、响应验证和计量; 无合法凭据或费用预算记为未测,
# 不模拟成功; 生产内核不绑定 Jev SDK) +
# docs/campaigns/2026-09-21-csg-decision-computer-use/task_plan.md「13 Jev 对照」+
# 同目录 contract.md §2/§3 + evaluation_contract.md §3 (四组公平比较, 本适配器
# 服务组 1/2, 非生产内核依赖)。
#
# -------------------------------------------------------------------
# 在线 API 调研结论 (2026-09-21 实查, 来源即请求/响应映射依据)
# -------------------------------------------------------------------
# 端点/认证: POST https://api.typesafe.ai/v1/systemone, 头
#   Authorization: Bearer <API_KEY>, Content-Type: application/json
#   (https://docs.typesafe.ai/api.md)
# 请求体: state (string|object|array, 必填, 被评估内容); model (string, 必填,
#   如 "jev-latest"; 响应 model 字段回报实际回答版本, 如 "jev-1.13.0",
#   https://docs.typesafe.ai/models.md); questions (map: 问题ID -> Question,
#   必填; 键由调用者自选, 不发给模型 —— 本适配器用它做协议关联)。
#   批量 = 单次调用携带多个 question 条目
#   (https://docs.typesafe.ai/cookbooks/parallel_questions.md)。
# Question 三头 (https://docs.typesafe.ai/primitives/{choice,score,noul}.md):
#   noul:   {type:"noul", instructions, criteria?{true,false}} (可选 criteria
#           本适配器不发)
#   choice: {type:"choice", instructions?, criteria: map(选项->描述|null)},
#           最多 255 选项; no-match 非内建, 官方建议显式追加
#           "other"/"none of the above" 选项 (本适配器保留选项名
#           none_of_above, 见 JevNoMatchOptionName)
#   score:  {type:"score", instructions, criteria: 有序级别描述数组},
#           2..10 级
# 响应体: model (string, 实际回答版本); answers (map, 键=问题ID):
#   noul -> {type, noul: 0..1} (无 confidence);
#   choice -> {type, choice: 最高概率选项名, probabilities: 全选项分布, 和=1,
#              confidence: 0..1};
#   score -> {type, score: 概率加权级别位置 (可落在两级之间), legend,
#             probabilities: 按级别号字符串键的分布, 和=1, confidence}。
#   usage: {input_tokens, output_tokens}。
# 错误: 401 (凭据缺失/无效) / 422 (请求体校验失败) / 429 (限流) /
#   529 (过载); 429/529 由客户端退避重试 (https://docs.typesafe.ai/api.md)。
# 待核实 (文档未覆盖, 禁止捏造, 核实路径):
#   1. 官方 SDK 默认凭据环境变量名 —— 本适配器约定 TYPESAFE_API_KEY;
#      核实路径: docs.typesafe.ai/sdk/python/api.md 与 SDK 源码。
#   2. 请求级超时字段名 (HTTP API 未给; JS SDK 有 APITimeoutError 类) ——
#      核实路径: docs.typesafe.ai/sdk/javascript/api (RetryPolicy 接口)。
#   3. score 响应 legend 字段精确结构 (本适配器不消费 legend, 不受影响) ——
#      核实路径: docs.typesafe.ai/sdk/javascript/api/interfaces/ScoreResponse。
#   4. 422 响应体内部字段名 (仅知 "details the offending field") —— 同 api.md。
#
# -------------------------------------------------------------------
# 传输接缝 (任务 13 交付形态: 类型化接缝, 本文件不含任何传输实现)
# -------------------------------------------------------------------
# 仓内传输栈审计结论 (2026-09-21):
#   - src/std/http.cheng: 明文 HTTP/1.1 (libc socket importc), 无 TLS;
#     明文携带 Bearer 凭据不可接受, 不接线。
#   - cheng/libp2p/protocols/http/http.cheng: HTTP-over-libp2p 流编解码器,
#     非因特网 HTTPS 客户端。
#   - cheng/quic/tls/{common,tls13,handshake13,policy}.cheng +
#     std/tls/x509 + std/crypto/*: 纯 Cheng TLS 1.3 客户端原语, 闭包全部
#     std/* + cheng/quic/tls/*, 无 admission 墙连坐 (已逐文件审计 import)。
#   - TLS record 层在 cheng/apps/vpn_proxy/transport_tcp_tls_record.cheng
#     (app 层; inference 反向依赖 app 层不可接受; 且完整 TCP->TLS->HTTP/1.1
#     出站编排无现成入口)。
#   结论: 定义类型化传输接缝 (fn 类型: 请求 JSON 文本 -> JevTransportReply,
#   含计时), 接缝与已审计 TLS 栈 (quic/tls 原语 + record 层上移或适配 +
#   HTTP/1.1 编排) 的对接列为「待墙清后接线」, 由后续串行切片完成。
#   本文件无 mock 传输冒充真实成功; 测试注入只存在于测试驱动
#   src/tests/decision_jev_smoke.cheng 内并如实标注 fault-injection。
#
# -------------------------------------------------------------------
# 状态机与错误族映射 (contract.md §3 同族; learn 节点终态见 §1)
# -------------------------------------------------------------------
# 显式状态: NotConfigured (凭据 env 未设, 该状态下绝不发起传输调用) /
#   Timeout (传输超时) / BackendFailure (服务错误/取消, 与 no-match 分立) /
#   InvalidOutput (响应不合合同, 直接拒绝, 禁止事后修补成合法分布)。
#   no-match 是响应内的显式合法选项 (choice 选中保留选项 none_of_above),
#   不是任何失败, 契约结果不携带分布 (decision_validate no-match 分支)。
# 图内记录映射 JevContractFailureKind: Timeout -> DeadlinePassed,
#   BackendFailure -> InferenceFailed (统一错误族成员, 过
#   CsgDecisionFailureKindIsKnown 门; detail 保留原状态串, 无损显式映射,
#   非修补)。
#
# 内存生命周期: 适配器无常驻权重; 请求 JSON / 响应 body / 计量记录均为
# 每调用瞬时对象, 调用返回后即可回收, 无跨调用驻留状态。

import std/result
import std/strings
import std/json as jevjson
import std/os
import cheng/core/runtime/csg_decision_contract as dc
import cheng/inference/decision_validate as dv

# -------------------------------------------------------------------
# 协议常量 (字段名逐一来自头注释调研来源; 未核实项见待核实清单)
# -------------------------------------------------------------------
const
    JevEndpointUrl = "https://api.typesafe.ai/v1/systemone"
    JevEnvApiKey = "TYPESAFE_API_KEY"
    JevModelDefault = "jev-latest"

    # 概率定点化声明精度: Jev 返回 0..1 浮点, 适配边界唯一合法入口是
    # dv.DecisionProbFromFloat64 (NaN/负数/越界一律拒绝), 定点重建后在
    # 整数域做精确归一门 (和恰为 10^6), 无浮点容差。
    JevProbPrecision: int32 = 6

    JevChoiceOptionCountMax: int32 = 255   # Jev choice 选项上限 (含保留选项)
    JevScoreLevelMin: int32 = 2            # Jev score 级数下限
    JevScoreLevelMax: int32 = 10           # Jev score 级数上限

    # choice 协议选项名 = option_<集内偏移>, 响应映射回图内绝对候选索引
    # setStart + 偏移; no-match 保留选项名单列。
    JevChoiceOptionPrefix = "option_"
    JevNoMatchOptionName = "none_of_above"
    JevNoMatchOptionDesc = "以上候选都不符合"

    JevKeyState = "state"
    JevKeyModel = "model"
    JevKeyQuestions = "questions"
    JevKeyAnswers = "answers"
    JevKeyUsage = "usage"
    JevKeyUsageInputTokens = "input_tokens"
    JevKeyUsageOutputTokens = "output_tokens"
    JevKeyType = "type"
    JevKeyInstructions = "instructions"
    JevKeyCriteria = "criteria"
    JevKeyProbabilities = "probabilities"
    JevKeyChoice = "choice"
    JevKeyNoul = "noul"

    JevTypeNoul = "noul"
    JevTypeChoice = "choice"
    JevTypeScore = "score"

    # 显式状态串 (首 token 对齐 contract.md §3 族 / §1 learn 终态)
    JevStatusOk = "Ok"
    JevStatusNotTested = "NotTested"
    JevErrNotConfigured = dc.CsgDecisionErrNotConfigured
    JevErrTimeout = "Timeout"
    JevErrBackendFailure = "BackendFailure"
    JevErrInvalidOutput = dc.CsgDecisionErrInvalidOutput

    # 传输接缝错误信号种类 (接缝合同: 失败以 statusKind 表达, 不抛串)
    JevTransportKindOk = "Ok"
    JevTransportKindTimeout = "Timeout"
    JevTransportKindBackendFailure = "BackendFailure"

# -------------------------------------------------------------------
# 类型
# -------------------------------------------------------------------
type
    JevCredentials =
        apiKey: str

    # 问题完整语义 (文本编码只发生在适配边界; 图内只有索引, 文本不进图)
    JevQuestionText =
        questionId: str          # 仅协议关联 (questions map 键), 非身份
        instructions: str        # 问题完整语义

    # 候选完整语义文本; candidateIndex = 图内绝对候选索引 (绑定锚点)
    JevCandidateText =
        candidateIndex: int32
        description: str

    # 一次 learn 节点适配的完整输入: 合同图 + 绑定 + 边界语义文本
    JevRequestSpec =
        graph: dc.CsgDecisionGraph
        learnRef: int32
        boundGoalRef: int32
        question: JevQuestionText
        stateText: str
        candidateTexts: JevCandidateText[]
        allowNoMatch: bool
        model: str

    # 绑定校验后冻结的适配请求 (当前节点绑定 + 边界语义文本)
    JevLearnRequest =
        learnRef: int32
        generation: int64
        headKind: int32
        setStart: int32
        setCount: int32
        boundGoalRef: int32
        allowNoMatch: bool
        questionId: str
        instructions: str
        stateText: str
        model: str
        candidateTexts: JevCandidateText[]

    # 类型化传输接缝响应 (接缝形态: fn(req: str): JevTransportReply)。
    # ok=false 时 statusKind 必须是 JevTransportKindTimeout (超时) 或
    # JevTransportKindBackendFailure (连接失败/取消/非 HTTP 层错误);
    # ok=true 时 httpStatus/body/latencyMs 必须有效。真实 TLS 栈待墙清后
    # 对接本接缝。
    JevTransportReply =
        ok: bool
        statusKind: str
        httpStatus: int32
        body: str
        latencyMs: int64

    # 计量记录 (四组对比报告的每调用行); status 取显式状态串
    # (JevStatusOk / 错误族), errorDetail 为完整错误串或空。
    JevCallMetrics =
        questionId: str
        modelVersion: str
        latencyMs: int64
        inputTokens: int64
        outputTokens: int64
        requestCount: int32
        status: str
        errorDetail: str

    # 成功调用的类型化产出: 结果绑定当前 learn 节点 (learnRef/generation/
    # headKind/boundGoalRef 全部来自当前图, 不来自响应), 附计量行。
    JevDecisionOutcome =
        result: dc.CsgDecisionLearnResult
        metrics: JevCallMetrics

# -------------------------------------------------------------------
# 凭据与诚实报告入口
# -------------------------------------------------------------------

fn JevCredentialsFromEnv(): JevCredentials =
    var out: JevCredentials
    out.apiKey = os.GetEnv(JevEnvApiKey)
    return out

fn JevCredentialsEmpty(c: JevCredentials): bool =
    return c.apiKey == ""

# 「未测」诚实报告入口 (evaluation_contract.md §4: 13 对照缺测不阻断本地
# 功能验收; 无凭据/预算授权前恒为 NotTested, 首切片未发起任何真实调用)。
fn JevRealCallVerificationStatus(): str =
    return JevStatusNotTested

# 显式状态 -> contract.md §3 统一错误族 kind (图内记录唯一入口):
# Timeout -> DeadlinePassed, BackendFailure -> InferenceFailed, 其余原样。
# 全路径返回独立 owned 副本 (借用值禁止 return)。
@borrows
fn JevContractFailureKind(status: str): str =
    if status == JevErrTimeout:
        return strings.CloneStr(dc.CsgDecisionErrDeadlinePassed)
    if status == JevErrBackendFailure:
        return strings.CloneStr(dc.CsgDecisionErrInferenceFailed)
    return strings.CloneStr(status)

# -------------------------------------------------------------------
# 绑定校验 + 适配请求冻结
# -------------------------------------------------------------------

# learn 节点与 boundGoal 槽位复用 decision_validate 的引用校验口径
# (会话/世代/索引/类四步), 然后冻结当前绑定 + 边界语义文本。
fn JevFreezeRequest(spec: JevRequestSpec): Result[JevLearnRequest] =
    var learnRefVal: dc.CsgDecisionRef
    learnRefVal.session = spec.graph.session
    learnRefVal.generation = spec.graph.generation
    learnRefVal.index = spec.learnRef
    learnRefVal.kind = dc.CsgDecisionRefKindLearn
    let learnBound = dv.DecisionValidateRef(share(spec.graph), learnRefVal)
    if IsErr(learnBound):
        return Err[JevLearnRequest]("InvalidOutput: jev learn ref invalid")
    var goalRefVal: dc.CsgDecisionRef
    goalRefVal.session = spec.graph.session
    goalRefVal.generation = spec.graph.generation
    goalRefVal.index = spec.boundGoalRef
    goalRefVal.kind = dc.CsgDecisionSlotKindGoal
    let goalBound = dv.DecisionValidateRef(share(spec.graph), goalRefVal)
    if IsErr(goalBound):
        return Err[JevLearnRequest]("InvalidOutput: jev bound goal ref invalid")
    let node = spec.graph.learns[spec.learnRef]
    if node.headKind != dc.CsgDecisionHeadChoice && node.headKind != dc.CsgDecisionHeadNoul && node.headKind != dc.CsgDecisionHeadScore:
        return Err[JevLearnRequest]("InvalidOutput: jev learn head kind unknown")
    if spec.question.questionId == "" || spec.question.instructions == "":
        return Err[JevLearnRequest]("InvalidOutput: jev question text empty")
    var outReq: JevLearnRequest
    outReq.learnRef = spec.learnRef
    outReq.generation = spec.graph.generation
    outReq.headKind = node.headKind
    outReq.setStart = node.candidateSetRef
    outReq.setCount = node.candidateCount
    outReq.boundGoalRef = spec.boundGoalRef
    outReq.allowNoMatch = spec.allowNoMatch
    outReq.questionId = strings.CloneStr(spec.question.questionId)
    outReq.instructions = strings.CloneStr(spec.question.instructions)
    outReq.stateText = strings.CloneStr(spec.stateText)
    outReq.model = strings.CloneStr(spec.model)
    outReq.candidateTexts = spec.candidateTexts
    return Ok[JevLearnRequest](outReq)

# -------------------------------------------------------------------
# 请求映射 (协议事实依据见头注释)
# -------------------------------------------------------------------

fn jevChoiceOptionName(offset: int32): str =
    return strings.ConcatStr(JevChoiceOptionPrefix, strings.IntToStr(offset))

fn jevScoreLevelKey(level: int32): str =
    return strings.IntToStr(level)

fn jevEmptyProbArr(): dc.CsgDecisionProbValue[] =
    var r: dc.CsgDecisionProbValue[]
    return r

fn jevEmptyI32Arr(): int32[] =
    var r: int32[]
    return r

fn jevZeroProb(): dc.CsgDecisionProbValue =
    var p: dc.CsgDecisionProbValue
    p.numer = 0
    p.precision = JevProbPrecision
    return p

# 请求 JSON 构造 (只读适配请求; 文本编码只发生在本适配边界):
# {state, model, questions: {<questionId>: {type, instructions, criteria}}}
# choice criteria = {option_<j>: 描述...} (+ 保留选项 none_of_above 当
# allowNoMatch); score criteria = 有序级别描述数组; noul 不发 criteria
# (文档: 可选)。
@borrows
fn JevBuildRequestJson(req: JevLearnRequest): Result[str] =
    if req.headKind == dc.CsgDecisionHeadNoul:
        if req.setCount != 0 || req.candidateTexts.len != 0:
            return Err[str]("InvalidOutput: jev candidate texts size mismatch")
        var question = jevjson.newJObject()
        jevjson.JsonSetFieldStr(question, JevKeyType, JevTypeNoul)
        jevjson.JsonSetFieldStr(question, JevKeyInstructions, strings.CloneStr(req.instructions))
        var questions = jevjson.newJObject()
        jevjson.JsonSetField(questions, strings.CloneStr(req.questionId), question)
        var root = jevjson.newJObject()
        jevjson.JsonSetFieldStr(root, JevKeyState, strings.CloneStr(req.stateText))
        jevjson.JsonSetFieldStr(root, JevKeyModel, strings.CloneStr(req.model))
        jevjson.JsonSetField(root, JevKeyQuestions, questions)
        return Ok[str](jevjson.stringify(root))
    if req.headKind == dc.CsgDecisionHeadChoice:
        if req.candidateTexts.len != req.setCount:
            return Err[str]("InvalidOutput: jev candidate texts size mismatch")
        if req.allowNoMatch:
            if req.setCount + 1 > JevChoiceOptionCountMax:
                return Err[str]("InvalidOutput: jev choice option count out of range")
        elif req.setCount > JevChoiceOptionCountMax:
            return Err[str]("InvalidOutput: jev choice option count out of range")
        var criteria = jevjson.newJObject()
        for j in 0..<req.setCount:
            if req.candidateTexts[j].candidateIndex != req.setStart + j:
                return Err[str]("InvalidOutput: jev candidate binding mismatch")
            let desc = strings.CloneStr(req.candidateTexts[j].description)
            if desc == "":
                return Err[str]("InvalidOutput: jev candidate description empty")
            jevjson.JsonSetFieldStr(criteria, jevChoiceOptionName(j), desc)
        if req.allowNoMatch:
            jevjson.JsonSetFieldStr(criteria, JevNoMatchOptionName, JevNoMatchOptionDesc)
        var question = jevjson.newJObject()
        jevjson.JsonSetFieldStr(question, JevKeyType, JevTypeChoice)
        jevjson.JsonSetFieldStr(question, JevKeyInstructions, strings.CloneStr(req.instructions))
        jevjson.JsonSetField(question, JevKeyCriteria, criteria)
        var questions = jevjson.newJObject()
        jevjson.JsonSetField(questions, strings.CloneStr(req.questionId), question)
        var root = jevjson.newJObject()
        jevjson.JsonSetFieldStr(root, JevKeyState, strings.CloneStr(req.stateText))
        jevjson.JsonSetFieldStr(root, JevKeyModel, strings.CloneStr(req.model))
        jevjson.JsonSetField(root, JevKeyQuestions, questions)
        return Ok[str](jevjson.stringify(root))
    if req.candidateTexts.len != req.setCount:
        return Err[str]("InvalidOutput: jev candidate texts size mismatch")
    if req.setCount < JevScoreLevelMin || req.setCount > JevScoreLevelMax:
        return Err[str]("InvalidOutput: jev score level count out of range")
    var criteria = jevjson.newJArray()
    for j in 0..<req.setCount:
        if req.candidateTexts[j].candidateIndex != req.setStart + j:
            return Err[str]("InvalidOutput: jev candidate binding mismatch")
        let desc = strings.CloneStr(req.candidateTexts[j].description)
        if desc == "":
            return Err[str]("InvalidOutput: jev candidate description empty")
        jevjson.add(criteria, jevjson.jsonString(desc))
    var question = jevjson.newJObject()
    jevjson.JsonSetFieldStr(question, JevKeyType, JevTypeScore)
    jevjson.JsonSetFieldStr(question, JevKeyInstructions, strings.CloneStr(req.instructions))
    jevjson.JsonSetField(question, JevKeyCriteria, criteria)
    var questions = jevjson.newJObject()
    jevjson.JsonSetField(questions, strings.CloneStr(req.questionId), question)
    var root = jevjson.newJObject()
    jevjson.JsonSetFieldStr(root, JevKeyState, strings.CloneStr(req.stateText))
    jevjson.JsonSetFieldStr(root, JevKeyModel, strings.CloneStr(req.model))
    jevjson.JsonSetField(root, JevKeyQuestions, questions)
    return Ok[str](jevjson.stringify(root))

# -------------------------------------------------------------------
# 响应验证 (复用 decision_validate 校验口径, 直接拒绝, 无修补)
# -------------------------------------------------------------------

fn jevProbFromAnswerFloat(x: float64): Result[dc.CsgDecisionProbValue] =
    return dv.DecisionProbFromFloat64(x, JevProbPrecision)

@borrows
fn jevCheckNormalized(probs: dc.CsgDecisionProbValue[]): Result[bool] =
    let scale = dc.CsgDecisionProbScale(JevProbPrecision)
    if scale <= 0:
        return Err[bool]("InvalidOutput: decision prob precision out of range")
    var sum: int64 = 0
    for j in 0..<probs.len:
        sum = sum + probs[j].numer
    if sum != scale:
        return Err[bool]("InvalidOutput: jev probabilities not normalized")
    return Ok[bool](true)

fn jevParseProbEntry(node: jevjson.JsonNode): Result[dc.CsgDecisionProbValue] =
    if node.kind != jevjson.JFloat && node.kind != jevjson.JInt:
        return Err[dc.CsgDecisionProbValue]("InvalidOutput: jev probability value missing")
    let x = jevjson.getFloat(node)
    return jevProbFromAnswerFloat(x)

# answer.type 必须与当前 learn 头一致 (错头响应直接拒绝)
fn jevExpectedTypeStr(headKind: int32): str =
    if headKind == dc.CsgDecisionHeadChoice:
        return JevTypeChoice
    if headKind == dc.CsgDecisionHeadScore:
        return JevTypeScore
    return JevTypeNoul

# 响应信封门: model 版本字段存在且非空 -> answers 对象 -> 问题键存在 ->
# answer.type 与当前头一致 (调研依据: 响应 model 字段回报实际回答版本)。
@borrows
fn jevCheckAnswerEnvelope(root: jevjson.JsonNode, req: JevLearnRequest): Result[jevjson.JsonNode] =
    if !jevjson.HasKey(root, JevKeyModel):
        return Err[jevjson.JsonNode]("InvalidOutput: jev response model version missing")
    let modelNode = jevjson.JsonGetField(root, JevKeyModel)
    if modelNode.kind != jevjson.JString || jevjson.GetStr(modelNode) == "":
        return Err[jevjson.JsonNode]("InvalidOutput: jev response model version missing")
    if !jevjson.HasKey(root, JevKeyAnswers):
        return Err[jevjson.JsonNode]("InvalidOutput: jev response answers missing")
    let answers = jevjson.JsonGetField(root, JevKeyAnswers)
    if answers.kind != jevjson.JObject:
        return Err[jevjson.JsonNode]("InvalidOutput: jev response answers missing")
    if !jevjson.HasKey(answers, req.questionId):
        return Err[jevjson.JsonNode]("InvalidOutput: jev response answer key missing")
    let answer = jevjson.JsonGetField(answers, req.questionId)
    if answer.kind != jevjson.JObject:
        return Err[jevjson.JsonNode]("InvalidOutput: jev response answer key missing")
    if !jevjson.HasKey(answer, JevKeyType):
        return Err[jevjson.JsonNode]("InvalidOutput: jev answer type missing")
    let typeNode = jevjson.JsonGetField(answer, JevKeyType)
    if typeNode.kind != jevjson.JString || jevjson.GetStr(typeNode) != jevExpectedTypeStr(req.headKind):
        return Err[jevjson.JsonNode]("InvalidOutput: jev answer type mismatch")
    return Ok[jevjson.JsonNode](answer)

@borrows
fn jevNewMetrics(req: JevLearnRequest, modelVersion: str): JevCallMetrics =
    var metrics: JevCallMetrics
    metrics.questionId = strings.CloneStr(req.questionId)
    metrics.modelVersion = strings.CloneStr(modelVersion)
    metrics.latencyMs = 0
    metrics.inputTokens = 0
    metrics.outputTokens = 0
    metrics.requestCount = 0
    metrics.status = JevStatusOk
    metrics.errorDetail = ""
    return metrics

@borrows
fn jevParseNoulAnswer(answer: jevjson.JsonNode, req: JevLearnRequest, modelVersion: str): Result[JevDecisionOutcome] =
    if !jevjson.HasKey(answer, JevKeyNoul):
        return Err[JevDecisionOutcome]("InvalidOutput: jev noul value missing")
    let noulNode = jevjson.JsonGetField(answer, JevKeyNoul)
    let probRes = jevParseProbEntry(noulNode)
    if IsErr(probRes):
        return Err[JevDecisionOutcome](Error(probRes))
    var probs = jevEmptyProbArr()
    add(probs, Value(probRes))
    var res: dc.CsgDecisionLearnResult
    res.learnRef = req.learnRef
    res.generation = req.generation
    res.headKind = req.headKind
    res.noMatch = false
    res.boundGoalRef = req.boundGoalRef
    res.chosenCandidate = dc.CsgDecisionChosenNone
    res.probs = probs
    res.ranks = jevEmptyI32Arr()
    res.weighted = jevZeroProb()
    let metrics = jevNewMetrics(req, modelVersion)
    return Ok[JevDecisionOutcome](JevDecisionOutcome(result: res, metrics: metrics))

@borrows
fn jevParseChoiceAnswer(answer: jevjson.JsonNode, req: JevLearnRequest, modelVersion: str): Result[JevDecisionOutcome] =
    if !jevjson.HasKey(answer, JevKeyProbabilities):
        return Err[JevDecisionOutcome]("InvalidOutput: jev choice probabilities missing")
    let probsNode = jevjson.JsonGetField(answer, JevKeyProbabilities)
    if probsNode.kind != jevjson.JObject:
        return Err[JevDecisionOutcome]("InvalidOutput: jev choice probabilities missing")
    var expectedKeys = req.setCount
    if req.allowNoMatch:
        expectedKeys = req.setCount + 1
    if probsNode.okeys.len != expectedKeys:
        return Err[JevDecisionOutcome]("InvalidOutput: jev choice probabilities size mismatch")
    var probs = jevEmptyProbArr()
    # 精确归一在整数域求和, 覆盖全部响应选项 (含保留选项 none_of_above)
    let scale = dc.CsgDecisionProbScale(JevProbPrecision)
    var probSum: int64 = 0
    for j in 0..<req.setCount:
        let key = jevChoiceOptionName(j)
        if !jevjson.HasKey(probsNode, key):
            return Err[JevDecisionOutcome]("InvalidOutput: jev choice option key unknown")
        let probRes = jevParseProbEntry(jevjson.JsonGetField(probsNode, key))
        if IsErr(probRes):
            return Err[JevDecisionOutcome](Error(probRes))
        let probVal = Value(probRes)
        probSum = probSum + probVal.numer
        add(probs, probVal)
    if req.allowNoMatch:
        if !jevjson.HasKey(probsNode, JevNoMatchOptionName):
            return Err[JevDecisionOutcome]("InvalidOutput: jev choice option key unknown")
        let noneProb = jevParseProbEntry(jevjson.JsonGetField(probsNode, JevNoMatchOptionName))
        if IsErr(noneProb):
            return Err[JevDecisionOutcome](Error(noneProb))
        probSum = probSum + Value(noneProb).numer
    if scale <= 0:
        return Err[JevDecisionOutcome]("InvalidOutput: decision prob precision out of range")
    if probSum != scale:
        return Err[JevDecisionOutcome]("InvalidOutput: jev probabilities not normalized")
    if !jevjson.HasKey(answer, JevKeyChoice):
        return Err[JevDecisionOutcome]("InvalidOutput: jev choice winner missing")
    let winnerNode = jevjson.JsonGetField(answer, JevKeyChoice)
    if winnerNode.kind != jevjson.JString:
        return Err[JevDecisionOutcome]("InvalidOutput: jev choice winner missing")
    let winner = jevjson.GetStr(winnerNode)
    var noMatch = false
    var chosen = dc.CsgDecisionChosenNone
    if winner == JevNoMatchOptionName:
        # 显式 no-match: 契约结果不携带任何分布 (合同 §3 / decision_validate
        # no-match 分支); 服务端含保留选项的分布是协议细节, 丢弃不是修补
        # (不做任何重新归一)。
        noMatch = true
        probs = jevEmptyProbArr()
    else:
        var found = false
        for j in 0..<req.setCount:
            if winner == jevChoiceOptionName(j):
                chosen = req.setStart + j
                found = true
        if !found:
            return Err[JevDecisionOutcome]("InvalidOutput: jev choice winner unknown")
    var res: dc.CsgDecisionLearnResult
    res.learnRef = req.learnRef
    res.generation = req.generation
    res.headKind = req.headKind
    res.noMatch = noMatch
    res.boundGoalRef = req.boundGoalRef
    res.chosenCandidate = chosen
    res.probs = probs
    res.ranks = jevEmptyI32Arr()
    res.weighted = jevZeroProb()
    let metrics = jevNewMetrics(req, modelVersion)
    return Ok[JevDecisionOutcome](JevDecisionOutcome(result: res, metrics: metrics))

@borrows
fn jevParseScoreAnswer(answer: jevjson.JsonNode, req: JevLearnRequest, modelVersion: str): Result[JevDecisionOutcome] =
    if !jevjson.HasKey(answer, JevKeyProbabilities):
        return Err[JevDecisionOutcome]("InvalidOutput: jev score probabilities missing")
    let probsNode = jevjson.JsonGetField(answer, JevKeyProbabilities)
    if probsNode.kind != jevjson.JObject:
        return Err[JevDecisionOutcome]("InvalidOutput: jev score probabilities missing")
    if probsNode.okeys.len != req.setCount:
        return Err[JevDecisionOutcome]("InvalidOutput: jev score probabilities size mismatch")
    var probs = jevEmptyProbArr()
    for j in 0..<req.setCount:
        let key = jevScoreLevelKey(j)
        if !jevjson.HasKey(probsNode, key):
            return Err[JevDecisionOutcome]("InvalidOutput: jev score level key unknown")
        let probRes = jevParseProbEntry(jevjson.JsonGetField(probsNode, key))
        if IsErr(probRes):
            return Err[JevDecisionOutcome](Error(probRes))
        add(probs, Value(probRes))
    let normRes = jevCheckNormalized(share(probs))
    if IsErr(normRes):
        return Err[JevDecisionOutcome](Error(normRes))
    # 级别号本身有序: ranks 取恒等排列 0..<count, weighted 在整数域精确
    # 重算 sum(j * numer_j) (与 Jev score 的概率加权级别位置同定义; 不消费
    # 其浮点 score 字段, 无浮点容差)。
    var ranks = jevEmptyI32Arr()
    var weightedNumer: int64 = 0
    for j in 0..<req.setCount:
        add(ranks, j)
        weightedNumer = weightedNumer + int64(j) * probs[j].numer
    var weighted = jevZeroProb()
    weighted.numer = weightedNumer
    var res: dc.CsgDecisionLearnResult
    res.learnRef = req.learnRef
    res.generation = req.generation
    res.headKind = req.headKind
    res.noMatch = false
    res.boundGoalRef = req.boundGoalRef
    res.chosenCandidate = dc.CsgDecisionChosenNone
    res.probs = probs
    res.ranks = ranks
    res.weighted = weighted
    let metrics = jevNewMetrics(req, modelVersion)
    return Ok[JevDecisionOutcome](JevDecisionOutcome(result: res, metrics: metrics))

# usage 计量抽取 (严格: usage 或 token 字段缺失/非数值即拒, 不计 0 冒充)。
@borrows
fn jevFinalizeUsage(res: Result[JevDecisionOutcome], root: jevjson.JsonNode): Result[JevDecisionOutcome] =
    if IsErr(res):
        return res
    var outcome = Value(res)
    var tokensIn: int64 = 0
    var tokensOut: int64 = 0
    let usage = jevjson.JsonGetField(root, JevKeyUsage)
    if usage.kind != jevjson.JObject:
        return Err[JevDecisionOutcome]("InvalidOutput: jev usage missing")
    let inOk = jevjson.jsonTryGetInt64(usage, JevKeyUsageInputTokens, tokensIn)
    let outOk = jevjson.jsonTryGetInt64(usage, JevKeyUsageOutputTokens, tokensOut)
    if !inOk || !outOk:
        return Err[JevDecisionOutcome]("InvalidOutput: jev usage tokens missing")
    outcome.metrics.inputTokens = tokensIn
    outcome.metrics.outputTokens = tokensOut
    return Ok[JevDecisionOutcome](outcome)

# 响应验证 + 类型化恢复: 解析 (截断即拒) -> 信封 (model 版本字段存在性 /
# answers 键 / 头类型) -> 按头解析 (定点化 / 值域 / 精确归一 / 候选绑定) ->
# usage 计量; 全程恢复为绑定当前节点的 CsgDecisionLearnResult。
@borrows
fn JevParseResponse(req: JevLearnRequest, body: str): Result[JevDecisionOutcome] =
    let parsed = jevjson.parseJsonSafe(body)
    if !parsed.success:
        return Err[JevDecisionOutcome]("InvalidOutput: jev response truncated")
    let root = parsed.value
    if root.kind != jevjson.JObject:
        return Err[JevDecisionOutcome]("InvalidOutput: jev response root not object")
    let envelope = jevCheckAnswerEnvelope(root, req)
    if IsErr(envelope):
        return Err[JevDecisionOutcome](Error(envelope))
    let answer = Value(envelope)
    let modelVersion = jevjson.GetStr(jevjson.JsonGetField(root, JevKeyModel))
    if req.headKind == dc.CsgDecisionHeadNoul:
        return jevFinalizeUsage(jevParseNoulAnswer(answer, req, modelVersion), root)
    if req.headKind == dc.CsgDecisionHeadChoice:
        return jevFinalizeUsage(jevParseChoiceAnswer(answer, req, modelVersion), root)
    return jevFinalizeUsage(jevParseScoreAnswer(answer, req, modelVersion), root)

# -------------------------------------------------------------------
# 显式状态机 (唯一调用入口; 传输经类型化接缝注入)
# -------------------------------------------------------------------

# NotConfigured 状态下绝不发起传输调用; Timeout / BackendFailure 与
# no-match 分立; InvalidOutput 原样透传不修补。已知服务错误状态码按调研
# 结论给固定判词 (401/403 凭据被拒, 422 请求被拒, 429/529 过载;
# 429/529 退避重试属传输接缝职责, 首切片不重试)。
fn JevDecide(creds: JevCredentials, spec: JevRequestSpec,
             transport: fn(req: str): JevTransportReply): Result[JevDecisionOutcome] =
    if JevCredentialsEmpty(creds):
        return Err[JevDecisionOutcome]("NotConfigured: jev api key empty")
    let reqRes = JevFreezeRequest(spec)
    if IsErr(reqRes):
        return Err[JevDecisionOutcome](Error(reqRes))
    let req = Value(reqRes)
    let reqBodyRes = JevBuildRequestJson(req)
    if IsErr(reqBodyRes):
        return Err[JevDecisionOutcome](Error(reqBodyRes))
    let reply = transport(Value(reqBodyRes))
    if !reply.ok:
        if reply.statusKind == JevTransportKindTimeout:
            return Err[JevDecisionOutcome]("Timeout: jev transport timeout")
        return Err[JevDecisionOutcome]("BackendFailure: jev transport failure")
    if reply.httpStatus == 401 || reply.httpStatus == 403:
        return Err[JevDecisionOutcome]("BackendFailure: jev credential rejected")
    if reply.httpStatus == 422:
        return Err[JevDecisionOutcome]("BackendFailure: jev request rejected")
    if reply.httpStatus == 429 || reply.httpStatus == 529:
        return Err[JevDecisionOutcome]("BackendFailure: jev service overloaded")
    if reply.httpStatus != 200:
        return Err[JevDecisionOutcome]("BackendFailure: jev http status")
    let outcomeRes = JevParseResponse(req, reply.body)
    if IsErr(outcomeRes):
        return outcomeRes
    var outcome = Value(outcomeRes)
    outcome.metrics.latencyMs = reply.latencyMs
    outcome.metrics.requestCount = 1
    return Ok[JevDecisionOutcome](outcome)
