import std/result
import std/strings
import std/strutils as strutil
import cheng/core/csg_core/json_field as jsonfield
import cheng/inference/kernel_ir as kir
import cheng/inference/model_graph as mg

const
    HfQwen38DeployProfileSchema = "cheng.inference.hf_qwen38_deploy_profile.v1"
    HfQwen38RepoId = "Qwen/Qwen3.8-27B"
    HfQwen38HfArchitecture = "Qwen3_5ForConditionalGeneration"
    HfQwen38ModelType = "qwen3_5"
    HfQwen38TextModelType = "qwen3_5_text"
    HfQwen38RopeType = "default"
    HfQwen38OutputGateType = "swish"
    HfQwen38Dtype = "bfloat16"
    HfQwen38OpGdnConv = "gdn_conv"
    HfQwen38OpGdnDelta = "gdn_delta"

type
    HfQwen38TextConfig =
        modelType: str
        hiddenSize: int32
        intermediateSize: int32
        layerCount: int32
        attentionHeads: int32
        keyValueHeads: int32
        headDim: int32
        fullAttentionInterval: int32
        layerTypeCodes: int32[]
        linearNumKeyHeads: int32
        linearNumValueHeads: int32
        linearKeyHeadDim: int32
        linearValueHeadDim: int32
        linearConvKernelDim: int32
        mtpNumHiddenLayers: int32
        mtpUseDedicatedEmbeddings: bool
        vocabSize: int32
        maxPositionEmbeddings: int32
        rmsNormEps: float64
        ropeTheta: float64
        ropeType: str
        partialRotaryFactor: float64
        mropeInterleaved: bool
        mropeSection: int32[]
        attentionBias: bool
        attnOutputGate: bool
        outputGateType: str
        tieWordEmbeddings: bool
        dtype: str

    HfQwen38DeployProfile =
        schema: str
        repoId: str
        architecture: str
        modelType: str
        text: HfQwen38TextConfig
        sourceConfigHash: int64
        profileHash: int64

fn HfQwen38HashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(16777619) + value + int64(311)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn HfQwen38HashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = HfQwen38HashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn HfQwen38HashIntsWith(hashRaw: int64, values: int32[]): int64 =
    var h: int64 = hashRaw
    for i in 0..<values.len:
        h = HfQwen38HashStep(h, int64(values[i]))
    return h

fn hfJsonIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn hfJsonSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && hfJsonIsWs(text[i]):
        i = i + 1
    return i

@borrows
fn hfJsonRawExactNonNegativeInt(raw: str): Result[int32] =
    var pos: int32 = hfJsonSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] < '0' || raw[pos] > '9':
        return Err[int32]("hf qwen38 config: integer")
    var value: int64
    while pos < raw.len && raw[pos] >= '0' && raw[pos] <= '9':
        let digit = int64(Int32(raw[pos]) - Int32('0'))
        if value > (int64(2147483647) - digit) / int64(10):
            return Err[int32]("hf qwen38 config: integer range")
        value = value * int64(10) + digit
        pos = pos + 1
    pos = hfJsonSkipWs(raw, pos)
    if pos != raw.len:
        return Err[int32]("hf qwen38 config: integer trailing")
    return Ok[int32](int32(value))

# Decimal power of ten via recursion; std/math powFloat silently no-ops for
# negative exponents on this backend, so this file keeps its own from-scratch
# JSON number handling (see hf_model_graph.cheng for the wider defect note).
fn hfJsonPow10Positive(exp: int32): float64 =
    if exp <= 0:
        return 1.0
    return 10.0 * hfJsonPow10Positive(exp - 1)

fn hfJsonPow10(exp: int32): float64 =
    if exp < 0:
        return 1.0 / hfJsonPow10Positive(0 - exp)
    return hfJsonPow10Positive(exp)

@borrows
fn hfJsonRawExactNonNegativeFloat64(raw: str): Result[float64] =
    var pos: int32 = hfJsonSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] < '0' || raw[pos] > '9':
        return Err[float64]("hf qwen38 config: float")
    var mantissa: int64
    var fracDigits: int32
    var sawDot: bool
    while pos < raw.len && ((raw[pos] >= '0' && raw[pos] <= '9') || raw[pos] == '.'):
        if raw[pos] == '.':
            if sawDot:
                return Err[float64]("hf qwen38 config: float")
            sawDot = true
            pos = pos + 1
            continue
        let digit = int64(Int32(raw[pos]) - Int32('0'))
        if mantissa > (int64(9223372036854775807) - digit) / int64(10):
            return Err[float64]("hf qwen38 config: float range")
        mantissa = mantissa * int64(10) + digit
        if sawDot:
            fracDigits = fracDigits + 1
        pos = pos + 1
    var exp10: int32
    if pos < raw.len && (raw[pos] == 'e' || raw[pos] == 'E'):
        pos = pos + 1
        var expSign: int32 = 1
        if pos < raw.len && (raw[pos] == '+' || raw[pos] == '-'):
            if raw[pos] == '-':
                expSign = -1
            pos = pos + 1
        if pos >= raw.len || raw[pos] < '0' || raw[pos] > '9':
            return Err[float64]("hf qwen38 config: float exponent")
        var expDigits: int32
        while pos < raw.len && raw[pos] >= '0' && raw[pos] <= '9':
            expDigits = expDigits * 10 + (Int32(raw[pos]) - Int32('0'))
            pos = pos + 1
        exp10 = expSign * expDigits
    pos = hfJsonSkipWs(raw, pos)
    if pos != raw.len:
        return Err[float64]("hf qwen38 config: float trailing")
    let finalExp = exp10 - fracDigits
    return Ok[float64](float64(mantissa) * hfJsonPow10(finalExp))

@borrows
fn hfQwenRequiredInt(configJson: str, name: str): Result[int32] =
    let raw = jsonfield.CsgCoreJsonTopRawField(configJson, name)
    if !raw.found:
        return Err[int32](strutil.Join(["hf qwen38 config: missing ", share(name)], ""))
    return hfJsonRawExactNonNegativeInt(raw.value)

@borrows
fn hfQwenPositiveInt(configJson: str, name: str): Result[int32] =
    let value = hfQwenRequiredInt(configJson, name)
    if IsErr(value):
        return Err[int32](Error(value))
    if Value(value) <= 0:
        return Err[int32](strutil.Join(["hf qwen38 config: non-positive ", share(name)], ""))
    return value

@borrows
fn hfQwenRequiredFloat64(configJson: str, name: str): Result[float64] =
    let raw = jsonfield.CsgCoreJsonTopRawField(configJson, name)
    if !raw.found:
        return Err[float64](strutil.Join(["hf qwen38 config: missing ", share(name)], ""))
    return hfJsonRawExactNonNegativeFloat64(raw.value)

@borrows
fn hfQwenRequiredBool(configJson: str, name: str): Result[bool] =
    let raw = jsonfield.CsgCoreJsonTopRawField(configJson, name)
    if !raw.found:
        return Err[bool](strutil.Join(["hf qwen38 config: missing ", share(name)], ""))
    let value = strutil.Strip(raw.value)
    if value == "true":
        return Ok[bool](true)
    if value == "false":
        return Ok[bool](false)
    return Err[bool](strutil.Join(["hf qwen38 config: bool ", share(name)], ""))

@borrows
fn hfQwenRequiredString(configJson: str, name: str): Result[str] =
    let field = jsonfield.CsgCoreJsonTopStringField(configJson, name)
    if !field.found:
        return Err[str](strutil.Join(["hf qwen38 config: missing ", share(name)], ""))
    return Ok[str](share(field.value))

@borrows
fn hfQwenParseLayerTypeCodes(raw: str): Result[int32[]] =
    var pos: int32 = hfJsonSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        return Err[int32[]]("hf qwen38 config: layer_types array")
    pos = hfJsonSkipWs(raw, pos + 1)
    var codes: int32[]
    if pos < raw.len && raw[pos] == ']':
        pos = pos + 1
    else:
        while pos < raw.len:
            if raw[pos] != '"':
                return Err[int32[]]("hf qwen38 config: layer_types string")
            var endPos: int32 = pos + 1
            while endPos < raw.len && raw[endPos] != '"':
                if raw[endPos] == '\\':
                    return Err[int32[]]("hf qwen38 config: layer_types escape")
                endPos = endPos + 1
            if endPos >= raw.len:
                return Err[int32[]]("hf qwen38 config: layer_types unterminated")
            let word = strings.CloneStrRange(raw, pos + 1, endPos - pos - 1)
            if word == "linear_attention":
                add(codes, 0)
            elif word == "full_attention":
                add(codes, 1)
            else:
                return Err[int32[]]("hf qwen38 config: layer_types unknown value")
            pos = hfJsonSkipWs(raw, endPos + 1)
            if pos < raw.len && raw[pos] == ',':
                pos = hfJsonSkipWs(raw, pos + 1)
                continue
            if pos < raw.len && raw[pos] == ']':
                pos = pos + 1
                break
            return Err[int32[]]("hf qwen38 config: layer_types separator")
    pos = hfJsonSkipWs(raw, pos)
    if pos != raw.len:
        return Err[int32[]]("hf qwen38 config: layer_types trailing")
    return Ok[int32[]](codes)

@borrows
fn hfQwenParseMropeSection(raw: str): Result[int32[]] =
    var pos: int32 = hfJsonSkipWs(raw, 0)
    if pos >= raw.len || raw[pos] != '[':
        return Err[int32[]]("hf qwen38 config: mrope_section array")
    pos = hfJsonSkipWs(raw, pos + 1)
    var values: int32[]
    if pos < raw.len && raw[pos] == ']':
        pos = pos + 1
    else:
        while pos < raw.len:
            var endPos: int32 = pos
            while endPos < raw.len && raw[endPos] != ',' && raw[endPos] != ']':
                endPos = endPos + 1
            let itemRes = hfJsonRawExactNonNegativeInt(strings.CloneStrRange(raw, pos, endPos - pos))
            if IsErr(itemRes):
                return Err[int32[]](Error(itemRes))
            add(values, Value(itemRes))
            pos = hfJsonSkipWs(raw, endPos)
            if pos < raw.len && raw[pos] == ',':
                pos = hfJsonSkipWs(raw, pos + 1)
                continue
            if pos < raw.len && raw[pos] == ']':
                pos = pos + 1
                break
            return Err[int32[]]("hf qwen38 config: mrope_section separator")
    pos = hfJsonSkipWs(raw, pos)
    if pos != raw.len:
        return Err[int32[]]("hf qwen38 config: mrope_section trailing")
    return Ok[int32[]](values)

@borrows
fn HfQwen38ValidateTextConfig(text: HfQwen38TextConfig): Result[bool] =
    if text.modelType != HfQwen38TextModelType:
        return Err[bool]("hf qwen38 profile: text model_type")
    if text.layerCount != 64:
        return Err[bool]("hf qwen38 profile: layer count")
    if text.hiddenSize <= 0 || text.intermediateSize <= 0 ||
       text.vocabSize <= 0 || text.maxPositionEmbeddings <= 0 ||
       text.attentionHeads <= 0 || text.keyValueHeads <= 0 || text.headDim <= 0:
        return Err[bool]("hf qwen38 profile: dimensions")
    if text.attentionHeads % text.keyValueHeads != 0:
        return Err[bool]("hf qwen38 profile: grouped kv divisibility")
    if text.fullAttentionInterval != 4:
        return Err[bool]("hf qwen38 profile: full attention interval")
    if text.layerTypeCodes.len != text.layerCount:
        return Err[bool]("hf qwen38 profile: layer types length")
    var fullCount: int32 = 0
    for i in 0..<text.layerTypeCodes.len:
        let code = text.layerTypeCodes[i]
        if code != 0 && code != 1:
            return Err[bool]("hf qwen38 profile: layer type code")
        let atFullSlot = ((i + 1) % text.fullAttentionInterval) == 0
        if code == 1:
            fullCount = fullCount + 1
            if !atFullSlot:
                return Err[bool]("hf qwen38 profile: full layer spacing")
        elif atFullSlot:
            return Err[bool]("hf qwen38 profile: full layer spacing")
    if fullCount != 16:
        return Err[bool]("hf qwen38 profile: full layer count")
    if text.linearNumKeyHeads <= 0 || text.linearNumValueHeads <= 0 ||
       text.linearKeyHeadDim <= 0 || text.linearValueHeadDim <= 0 ||
       text.linearConvKernelDim <= 0:
        return Err[bool]("hf qwen38 profile: linear attention dimensions")
    if text.mtpNumHiddenLayers != 1:
        return Err[bool]("hf qwen38 profile: mtp layers")
    if (text.ropeTheta - 1.0) + 1000000000000000.0 < 1000000000000000.0:
        return Err[bool]("hf qwen38 profile: rope theta")
    if text.ropeType != HfQwen38RopeType:
        return Err[bool]("hf qwen38 profile: rope type")
    if text.partialRotaryFactor <= 0.0 || text.partialRotaryFactor > 1.0:
        return Err[bool]("hf qwen38 profile: partial rotary factor")
    if text.mropeSection.len != 3:
        return Err[bool]("hf qwen38 profile: mrope section")
    for i in 0..<text.mropeSection.len:
        if text.mropeSection[i] <= 0:
            return Err[bool]("hf qwen38 profile: mrope section dim")
    if !text.attnOutputGate || text.outputGateType != HfQwen38OutputGateType:
        return Err[bool]("hf qwen38 profile: output gate")
    if text.dtype != HfQwen38Dtype:
        return Err[bool]("hf qwen38 profile: dtype")
    if text.tieWordEmbeddings:
        return Err[bool]("hf qwen38 profile: tie word embeddings")
    return Ok[bool](true)

fn HfQwen38TextConfigFromTextConfigJson(textConfigJson: str): Result[HfQwen38TextConfig] =
    if textConfigJson == "":
        return Err[HfQwen38TextConfig]("hf qwen38 config: text_config json")
    let textModelType = hfQwenRequiredString(textConfigJson, "model_type")
    if IsErr(textModelType):
        return Err[HfQwen38TextConfig](Error(textModelType))
    let hiddenSize = hfQwenPositiveInt(textConfigJson, "hidden_size")
    if IsErr(hiddenSize):
        return Err[HfQwen38TextConfig](Error(hiddenSize))
    let intermediateSize = hfQwenPositiveInt(textConfigJson, "intermediate_size")
    if IsErr(intermediateSize):
        return Err[HfQwen38TextConfig](Error(intermediateSize))
    let layerCount = hfQwenPositiveInt(textConfigJson, "num_hidden_layers")
    if IsErr(layerCount):
        return Err[HfQwen38TextConfig](Error(layerCount))
    let attentionHeads = hfQwenPositiveInt(textConfigJson, "num_attention_heads")
    if IsErr(attentionHeads):
        return Err[HfQwen38TextConfig](Error(attentionHeads))
    let keyValueHeads = hfQwenPositiveInt(textConfigJson, "num_key_value_heads")
    if IsErr(keyValueHeads):
        return Err[HfQwen38TextConfig](Error(keyValueHeads))
    let headDim = hfQwenPositiveInt(textConfigJson, "head_dim")
    if IsErr(headDim):
        return Err[HfQwen38TextConfig](Error(headDim))
    let fullAttentionInterval = hfQwenPositiveInt(textConfigJson, "full_attention_interval")
    if IsErr(fullAttentionInterval):
        return Err[HfQwen38TextConfig](Error(fullAttentionInterval))
    let linearNumKeyHeads = hfQwenPositiveInt(textConfigJson, "linear_num_key_heads")
    if IsErr(linearNumKeyHeads):
        return Err[HfQwen38TextConfig](Error(linearNumKeyHeads))
    let linearNumValueHeads = hfQwenPositiveInt(textConfigJson, "linear_num_value_heads")
    if IsErr(linearNumValueHeads):
        return Err[HfQwen38TextConfig](Error(linearNumValueHeads))
    let linearKeyHeadDim = hfQwenPositiveInt(textConfigJson, "linear_key_head_dim")
    if IsErr(linearKeyHeadDim):
        return Err[HfQwen38TextConfig](Error(linearKeyHeadDim))
    let linearValueHeadDim = hfQwenPositiveInt(textConfigJson, "linear_value_head_dim")
    if IsErr(linearValueHeadDim):
        return Err[HfQwen38TextConfig](Error(linearValueHeadDim))
    let linearConvKernelDim = hfQwenPositiveInt(textConfigJson, "linear_conv_kernel_dim")
    if IsErr(linearConvKernelDim):
        return Err[HfQwen38TextConfig](Error(linearConvKernelDim))
    let mtpNumHiddenLayers = hfQwenPositiveInt(textConfigJson, "mtp_num_hidden_layers")
    if IsErr(mtpNumHiddenLayers):
        return Err[HfQwen38TextConfig](Error(mtpNumHiddenLayers))
    let mtpDedicated = hfQwenRequiredBool(textConfigJson, "mtp_use_dedicated_embeddings")
    if IsErr(mtpDedicated):
        return Err[HfQwen38TextConfig](Error(mtpDedicated))
    let vocabSize = hfQwenPositiveInt(textConfigJson, "vocab_size")
    if IsErr(vocabSize):
        return Err[HfQwen38TextConfig](Error(vocabSize))
    let maxPositionEmbeddings = hfQwenPositiveInt(textConfigJson, "max_position_embeddings")
    if IsErr(maxPositionEmbeddings):
        return Err[HfQwen38TextConfig](Error(maxPositionEmbeddings))
    let rmsNormEps = hfQwenRequiredFloat64(textConfigJson, "rms_norm_eps")
    if IsErr(rmsNormEps):
        return Err[HfQwen38TextConfig](Error(rmsNormEps))
    let attentionBias = hfQwenRequiredBool(textConfigJson, "attention_bias")
    if IsErr(attentionBias):
        return Err[HfQwen38TextConfig](Error(attentionBias))
    let attnOutputGate = hfQwenRequiredBool(textConfigJson, "attn_output_gate")
    if IsErr(attnOutputGate):
        return Err[HfQwen38TextConfig](Error(attnOutputGate))
    let outputGateType = hfQwenRequiredString(textConfigJson, "output_gate_type")
    if IsErr(outputGateType):
        return Err[HfQwen38TextConfig](Error(outputGateType))
    let tieWordEmbeddings = hfQwenRequiredBool(textConfigJson, "tie_word_embeddings")
    if IsErr(tieWordEmbeddings):
        return Err[HfQwen38TextConfig](Error(tieWordEmbeddings))
    let dtype = hfQwenRequiredString(textConfigJson, "dtype")
    if IsErr(dtype):
        return Err[HfQwen38TextConfig](Error(dtype))
    let layerTypesRaw = jsonfield.CsgCoreJsonTopRawField(textConfigJson, "layer_types")
    if !layerTypesRaw.found:
        return Err[HfQwen38TextConfig]("hf qwen38 config: missing layer_types")
    let layerTypeCodes = hfQwenParseLayerTypeCodes(layerTypesRaw.value)
    if IsErr(layerTypeCodes):
        return Err[HfQwen38TextConfig](Error(layerTypeCodes))
    let ropeRaw = jsonfield.CsgCoreJsonTopRawField(textConfigJson, "rope_parameters")
    if !ropeRaw.found:
        return Err[HfQwen38TextConfig]("hf qwen38 config: missing rope_parameters")
    let ropeTheta = hfQwenRequiredFloat64(ropeRaw.value, "rope_theta")
    if IsErr(ropeTheta):
        return Err[HfQwen38TextConfig](Error(ropeTheta))
    let ropeType = hfQwenRequiredString(ropeRaw.value, "rope_type")
    if IsErr(ropeType):
        return Err[HfQwen38TextConfig](Error(ropeType))
    let partialRotaryFactor = hfQwenRequiredFloat64(ropeRaw.value, "partial_rotary_factor")
    if IsErr(partialRotaryFactor):
        return Err[HfQwen38TextConfig](Error(partialRotaryFactor))
    let mropeInterleaved = hfQwenRequiredBool(ropeRaw.value, "mrope_interleaved")
    if IsErr(mropeInterleaved):
        return Err[HfQwen38TextConfig](Error(mropeInterleaved))
    let mropeSectionRaw = jsonfield.CsgCoreJsonTopRawField(ropeRaw.value, "mrope_section")
    if !mropeSectionRaw.found:
        return Err[HfQwen38TextConfig]("hf qwen38 config: missing mrope_section")
    let mropeSection = hfQwenParseMropeSection(mropeSectionRaw.value)
    if IsErr(mropeSection):
        return Err[HfQwen38TextConfig](Error(mropeSection))
    var out = HfQwen38TextConfig(
        modelType: Value(textModelType),
        hiddenSize: Value(hiddenSize),
        intermediateSize: Value(intermediateSize),
        layerCount: Value(layerCount),
        attentionHeads: Value(attentionHeads),
        keyValueHeads: Value(keyValueHeads),
        headDim: Value(headDim),
        fullAttentionInterval: Value(fullAttentionInterval),
        layerTypeCodes: Value(layerTypeCodes),
        linearNumKeyHeads: Value(linearNumKeyHeads),
        linearNumValueHeads: Value(linearNumValueHeads),
        linearKeyHeadDim: Value(linearKeyHeadDim),
        linearValueHeadDim: Value(linearValueHeadDim),
        linearConvKernelDim: Value(linearConvKernelDim),
        mtpNumHiddenLayers: Value(mtpNumHiddenLayers),
        mtpUseDedicatedEmbeddings: Value(mtpDedicated),
        vocabSize: Value(vocabSize),
        maxPositionEmbeddings: Value(maxPositionEmbeddings),
        rmsNormEps: Value(rmsNormEps),
        ropeTheta: Value(ropeTheta),
        ropeType: Value(ropeType),
        partialRotaryFactor: Value(partialRotaryFactor),
        mropeInterleaved: Value(mropeInterleaved),
        mropeSection: Value(mropeSection),
        attentionBias: Value(attentionBias),
        attnOutputGate: Value(attnOutputGate),
        outputGateType: Value(outputGateType),
        tieWordEmbeddings: Value(tieWordEmbeddings),
        dtype: Value(dtype)
    )
    let textOk = HfQwen38ValidateTextConfig(out)
    if IsErr(textOk):
        return Err[HfQwen38TextConfig](Error(textOk))
    return Ok[HfQwen38TextConfig](out)

fn HfQwen38TextConfigFromConfig(configJson: str): Result[HfQwen38TextConfig] =
    if configJson == "":
        return Err[HfQwen38TextConfig]("hf qwen38 config: json")
    let modelType = hfQwenRequiredString(configJson, "model_type")
    if IsErr(modelType):
        return Err[HfQwen38TextConfig](Error(modelType))
    if Value(modelType) != HfQwen38ModelType:
        return Err[HfQwen38TextConfig]("hf qwen38 config: model_type")
    let archRaw = jsonfield.CsgCoreJsonTopRawField(configJson, "architectures")
    if !archRaw.found || !strutil.Contains(archRaw.value, HfQwen38HfArchitecture):
        return Err[HfQwen38TextConfig]("hf qwen38 config: architectures")
    let textRaw = jsonfield.CsgCoreJsonTopRawField(configJson, "text_config")
    if !textRaw.found:
        return Err[HfQwen38TextConfig]("hf qwen38 config: missing text_config")
    return HfQwen38TextConfigFromTextConfigJson(textRaw.value)

@borrows
fn HfQwen38ProfileHash(profile: HfQwen38DeployProfile): int64 =
    var h: int64 = int64(311)
    h = HfQwen38HashTextWith(h, profile.schema)
    h = HfQwen38HashTextWith(h, profile.repoId)
    h = HfQwen38HashTextWith(h, profile.architecture)
    h = HfQwen38HashTextWith(h, profile.modelType)
    h = HfQwen38HashTextWith(h, profile.text.modelType)
    h = HfQwen38HashStep(h, int64(profile.text.hiddenSize))
    h = HfQwen38HashStep(h, int64(profile.text.intermediateSize))
    h = HfQwen38HashStep(h, int64(profile.text.layerCount))
    h = HfQwen38HashStep(h, int64(profile.text.attentionHeads))
    h = HfQwen38HashStep(h, int64(profile.text.keyValueHeads))
    h = HfQwen38HashStep(h, int64(profile.text.headDim))
    h = HfQwen38HashStep(h, int64(profile.text.fullAttentionInterval))
    for i in 0..<profile.text.layerTypeCodes.len:
        h = HfQwen38HashStep(h, int64(profile.text.layerTypeCodes[i]))
    h = HfQwen38HashStep(h, int64(profile.text.linearNumKeyHeads))
    h = HfQwen38HashStep(h, int64(profile.text.linearNumValueHeads))
    h = HfQwen38HashStep(h, int64(profile.text.linearKeyHeadDim))
    h = HfQwen38HashStep(h, int64(profile.text.linearValueHeadDim))
    h = HfQwen38HashStep(h, int64(profile.text.linearConvKernelDim))
    h = HfQwen38HashStep(h, int64(profile.text.mtpNumHiddenLayers))
    if profile.text.mtpUseDedicatedEmbeddings:
        h = HfQwen38HashStep(h, int64(1))
    else:
        h = HfQwen38HashStep(h, int64(0))
    h = HfQwen38HashStep(h, int64(profile.text.vocabSize))
    h = HfQwen38HashStep(h, int64(profile.text.maxPositionEmbeddings))
    h = HfQwen38HashStep(h, int64(profile.text.rmsNormEps * 1000000000.0))
    h = HfQwen38HashStep(h, int64(profile.text.ropeTheta * 1000000.0))
    h = HfQwen38HashTextWith(h, profile.text.ropeType)
    h = HfQwen38HashStep(h, int64(profile.text.partialRotaryFactor * 1000000.0))
    if profile.text.mropeInterleaved:
        h = HfQwen38HashStep(h, int64(1))
    else:
        h = HfQwen38HashStep(h, int64(0))
    for i in 0..<profile.text.mropeSection.len:
        h = HfQwen38HashStep(h, int64(profile.text.mropeSection[i]))
    if profile.text.attentionBias:
        h = HfQwen38HashStep(h, int64(1))
    else:
        h = HfQwen38HashStep(h, int64(0))
    if profile.text.attnOutputGate:
        h = HfQwen38HashStep(h, int64(1))
    else:
        h = HfQwen38HashStep(h, int64(0))
    h = HfQwen38HashTextWith(h, profile.text.outputGateType)
    if profile.text.tieWordEmbeddings:
        h = HfQwen38HashStep(h, int64(1))
    else:
        h = HfQwen38HashStep(h, int64(0))
    h = HfQwen38HashTextWith(h, profile.text.dtype)
    h = HfQwen38HashStep(h, profile.sourceConfigHash)
    return h

@borrows
fn HfQwen38ValidateProfile(profile: HfQwen38DeployProfile): Result[bool] =
    if profile.schema != HfQwen38DeployProfileSchema ||
       profile.repoId != HfQwen38RepoId ||
       profile.architecture != HfQwen38HfArchitecture ||
       profile.modelType != HfQwen38ModelType:
        return Err[bool]("hf qwen38 profile: identity")
    let textOk = HfQwen38ValidateTextConfig(profile.text)
    if IsErr(textOk):
        return Err[bool](Error(textOk))
    if profile.sourceConfigHash <= int64(0):
        return Err[bool]("hf qwen38 profile: source config hash")
    if HfQwen38ProfileHash(profile) != profile.profileHash:
        return Err[bool]("hf qwen38 profile: hash")
    return Ok[bool](true)

fn HfQwen38DeployProfileFromConfig(repoId: str,
                                   configJson: str): Result[HfQwen38DeployProfile] =
    if repoId != HfQwen38RepoId:
        return Err[HfQwen38DeployProfile]("hf qwen38 profile: repo")
    if configJson == "":
        return Err[HfQwen38DeployProfile]("hf qwen38 profile: json")
    let textRes = HfQwen38TextConfigFromConfig(share(configJson))
    if IsErr(textRes):
        return Err[HfQwen38DeployProfile](Error(textRes))
    var out = HfQwen38DeployProfile(
        schema: HfQwen38DeployProfileSchema,
        repoId: share(repoId),
        architecture: HfQwen38HfArchitecture,
        modelType: HfQwen38ModelType,
        text: Value(textRes),
        sourceConfigHash: HfQwen38HashTextWith(int64(197), configJson),
        profileHash: int64(0)
    )
    out.profileHash = HfQwen38ProfileHash(out)
    let profileOk = HfQwen38ValidateProfile(out)
    if IsErr(profileOk):
        return Err[HfQwen38DeployProfile](Error(profileOk))
    return Ok[HfQwen38DeployProfile](out)

@borrows
fn hfQwen38WeightShardCid(modelCid: str, tensorName: str): str =
    return strutil.Join(["cid:hf:", share(modelCid), ":", share(tensorName)], "")

@borrows
fn hfQwen38MakeWeight(modelCid: str,
                      tensorName: str,
                      dtype: str,
                      quantScheme: str,
                      shape: int32[]): Result[mg.ModelWeightShard] =
    let sizeBytes = mg.ModelGraphExpectedTensorBytes(dtype, shape)
    if IsErr(sizeBytes):
        return Err[mg.ModelWeightShard](Error(sizeBytes))
    var shapeCopy: int32[]
    for i in 0..<shape.len:
        add(shapeCopy, shape[i])
    return Ok[mg.ModelWeightShard](mg.ModelWeightShard(
        modelCid: strings.CloneStr(modelCid),
        shardCid: hfQwen38WeightShardCid(modelCid, tensorName),
        tensorName: strings.CloneStr(tensorName),
        dtype: strings.CloneStr(dtype),
        quantScheme: strings.CloneStr(quantScheme),
        shape: shapeCopy,
        sizeBytes: Value(sizeBytes),
        expectedPayloadHash: int64(0)
    ))

@borrows
fn hfQwen38MakeLayerWeight(modelCid: str,
                           layerIndex: int32,
                           suffix: str,
                           dtype: str,
                           quantScheme: str,
                           shape: int32[]): Result[mg.ModelWeightShard] =
    let name = strutil.Join(["model.layers.", strings.IntToStr(layerIndex), ".", share(suffix)], "")
    return hfQwen38MakeWeight(modelCid, name, dtype, quantScheme, shape)

@borrows
fn hfQwen38MakeOp(opKind: str,
                  inputNames: str[],
                  outputName: str,
                  weightNames: str[],
                  layerIndex: int32,
                  expertId: int32): mg.ModelGraphOp =
    var inputCopy: str[]
    for i in 0..<inputNames.len:
        # Borrowed caller elements (often loop-local Join temporaries that are
        # released right after this call) must be cloned into the owned op
        # arrays; storing aliased views leaves dangling str reads behind.
        add(inputCopy, strings.CloneStr(inputNames[i]))
    var weightCopy: str[]
    for i in 0..<weightNames.len:
        add(weightCopy, strings.CloneStr(weightNames[i]))
    return mg.ModelGraphOp(
        opKind: strings.CloneStr(opKind),
        inputNames: inputCopy,
        outputName: strings.CloneStr(outputName),
        weightNames: weightCopy,
        layerIndex: layerIndex,
        expertId: expertId
    )

# full attention: attention_bias=false, so q/k/v carry no bias shards.
fn hfQwen38AppendFullAttentionLayer(modelCid: str,
                                    layerIndex: int32,
                                    hiddenSize: int32,
                                    qRows: int32,
                                    kvRows: int32,
                                    inputNormOut: str,
                                    previous: str,
                                    weights: var mg.ModelWeightShard[],
                                    ops: var mg.ModelGraphOp[]): Result[bool] =
    let qWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "self_attn.q_proj.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [qRows, hiddenSize])
    if IsErr(qWeight):
        return Err[bool](Error(qWeight))
    add(weights, Value(qWeight))
    let kWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "self_attn.k_proj.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [kvRows, hiddenSize])
    if IsErr(kWeight):
        return Err[bool](Error(kWeight))
    add(weights, Value(kWeight))
    let vWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "self_attn.v_proj.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [kvRows, hiddenSize])
    if IsErr(vWeight):
        return Err[bool](Error(vWeight))
    add(weights, Value(vWeight))
    let oWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "self_attn.o_proj.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [hiddenSize, qRows])
    if IsErr(oWeight):
        return Err[bool](Error(oWeight))
    add(weights, Value(oWeight))
    let qkvOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".qkv"], "")
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpQkv, [share(inputNormOut)], qkvOut, [share(Value(qWeight).tensorName), share(Value(kWeight).tensorName), share(Value(vWeight).tensorName), share(Value(oWeight).tensorName)], layerIndex, -1))
    let ropeOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".rope"], "")
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpRope, [share(qkvOut)], ropeOut, [], layerIndex, -1))
    let attnOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".attention"], "")
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpAttention, [share(ropeOut)], attnOut, [share(Value(oWeight).tensorName)], layerIndex, -1))
    let attnResidualOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".attention_residual"], "")
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpResidualAdd, [share(previous), share(attnOut)], attnResidualOut, [], layerIndex, -1))
    return Ok[bool](true)

# GDN linear attention: in_proj (qkvz + ba), short conv, gated delta rule
# core with per-v-head norm and out_proj.
fn hfQwen38AppendLinearAttentionLayer(modelCid: str,
                                      layerIndex: int32,
                                      hiddenSize: int32,
                                      linearConvKernelDim: int32,
                                      gdnInRows: int32,
                                      gdnBaRows: int32,
                                      linearVRows: int32,
                                      convRows: int32,
                                      inputNormOut: str,
                                      previous: str,
                                      weights: var mg.ModelWeightShard[],
                                      ops: var mg.ModelGraphOp[]): Result[bool] =
    let inProjQkvzWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "linear_attn.in_proj_qkvz.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [gdnInRows, hiddenSize])
    if IsErr(inProjQkvzWeight):
        return Err[bool](Error(inProjQkvzWeight))
    add(weights, Value(inProjQkvzWeight))
    let inProjBaWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "linear_attn.in_proj_ba.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [gdnBaRows, hiddenSize])
    if IsErr(inProjBaWeight):
        return Err[bool](Error(inProjBaWeight))
    add(weights, Value(inProjBaWeight))
    let convWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "linear_attn.conv1d.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [convRows, 1, linearConvKernelDim])
    if IsErr(convWeight):
        return Err[bool](Error(convWeight))
    add(weights, Value(convWeight))
    let gdnConvOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".gdn_conv"], "")
    add(ops, hfQwen38MakeOp(HfQwen38OpGdnConv, [share(inputNormOut)], gdnConvOut, [share(Value(inProjQkvzWeight).tensorName), share(Value(inProjBaWeight).tensorName), share(Value(convWeight).tensorName)], layerIndex, -1))
    let gdnNormWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "linear_attn.norm.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [linearVRows])
    if IsErr(gdnNormWeight):
        return Err[bool](Error(gdnNormWeight))
    add(weights, Value(gdnNormWeight))
    let outProjWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "linear_attn.out_proj.weight", kir.KernelDtypeBf16, mg.ModelQuantSchemeNone, [hiddenSize, linearVRows])
    if IsErr(outProjWeight):
        return Err[bool](Error(outProjWeight))
    add(weights, Value(outProjWeight))
    let gdnOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".gdn_out"], "")
    add(ops, hfQwen38MakeOp(HfQwen38OpGdnDelta, [share(gdnConvOut)], gdnOut, [share(Value(gdnNormWeight).tensorName), share(Value(outProjWeight).tensorName)], layerIndex, -1))
    let attnResidualOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".attention_residual"], "")
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpResidualAdd, [share(previous), share(gdnOut)], attnResidualOut, [], layerIndex, -1))
    return Ok[bool](true)

fn hfQwen38AppendAttentionLayer(modelCid: str,
                                layerIndex: int32,
                                hiddenSize: int32,
                                linearConvKernelDim: int32,
                                qRows: int32,
                                kvRows: int32,
                                gdnInRows: int32,
                                gdnBaRows: int32,
                                linearVRows: int32,
                                convRows: int32,
                                isFullAttention: bool,
                                inputNormOut: str,
                                previous: str,
                                weights: var mg.ModelWeightShard[],
                                ops: var mg.ModelGraphOp[]): Result[bool] =
    if isFullAttention:
        return hfQwen38AppendFullAttentionLayer(modelCid, layerIndex, hiddenSize, qRows, kvRows, inputNormOut, previous, weights, ops)
    return hfQwen38AppendLinearAttentionLayer(modelCid, layerIndex, hiddenSize, linearConvKernelDim, gdnInRows, gdnBaRows, linearVRows, convRows, inputNormOut, previous, weights, ops)

# Builds the full hybrid graph for the pinned Qwen/Qwen3.8-27B text stack:
# 48 GDN linear-attention layers + 16 full-attention layers + 1 MTP layer.
# The architecture is registered with the shared validator as
# mg.InferenceModelArchitectureHfQwen38HybridMtp, so the built graph passes
# mg.ModelGraphValidate.
fn HfQwen38GraphBuildFromProfile(profile: HfQwen38DeployProfile,
                                 modelCid: str): Result[mg.ModelGraph] =
    if modelCid == "":
        return Err[mg.ModelGraph]("hf qwen38 graph: model cid")
    let profileOk = HfQwen38ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[mg.ModelGraph](Error(profileOk))
    let text = profile.text
    let weightDtype = kir.KernelDtypeBf16
    let qRows64 = int64(text.attentionHeads) * int64(text.headDim)
    let kvRows64 = int64(text.keyValueHeads) * int64(text.headDim)
    let linearQkRows64 = int64(text.linearNumKeyHeads) * int64(text.linearKeyHeadDim)
    let linearVRows64 = int64(text.linearNumValueHeads) * int64(text.linearValueHeadDim)
    let convRows64 = linearQkRows64 * int64(2) + linearVRows64
    let gdnInRows64 = linearQkRows64 * int64(2) + linearVRows64 * int64(2)
    if qRows64 <= int64(0) || kvRows64 <= int64(0) || convRows64 <= int64(0) ||
       gdnInRows64 <= int64(0) ||
       qRows64 > int64(2147483647) || kvRows64 > int64(2147483647) ||
       convRows64 > int64(2147483647) || gdnInRows64 > int64(2147483647):
        return Err[mg.ModelGraph]("hf qwen38 graph: derived dimensions")
    let qRows = int32(qRows64)
    let kvRows = int32(kvRows64)
    let linearQkRows = int32(linearQkRows64)
    let linearVRows = int32(linearVRows64)
    let convRows = int32(convRows64)
    let gdnInRows = int32(gdnInRows64)
    let gdnBaRows = text.linearNumValueHeads * 2
    let mtpEhCols = text.hiddenSize * 2
    let layerTypeCodes = text.layerTypeCodes
    var tokenShape: int32[]
    add(tokenShape, 1)
    var hiddenShape: int32[]
    add(hiddenShape, 1)
    add(hiddenShape, text.hiddenSize)
    var logitShape: int32[]
    add(logitShape, 1)
    add(logitShape, text.vocabSize)
    var tokenDesc: mg.ModelTensorDesc
    tokenDesc.name = "token_ids"
    tokenDesc.dtype = kir.KernelDtypeI32
    tokenDesc.shape = tokenShape
    tokenDesc.quantScheme = mg.ModelQuantSchemeNone
    var hiddenDesc: mg.ModelTensorDesc
    hiddenDesc.name = "hidden"
    hiddenDesc.dtype = kir.KernelDtypeFp16
    hiddenDesc.shape = hiddenShape
    hiddenDesc.quantScheme = mg.ModelQuantSchemeNone
    var logitDesc: mg.ModelTensorDesc
    logitDesc.name = "logits"
    logitDesc.dtype = kir.KernelDtypeFp16
    logitDesc.shape = logitShape
    logitDesc.quantScheme = mg.ModelQuantSchemeNone
    var tensors: mg.ModelTensorDesc[]
    add(tensors, tokenDesc)
    add(tensors, hiddenDesc)
    add(tensors, logitDesc)
    var weights: mg.ModelWeightShard[]
    var ops: mg.ModelGraphOp[]

    let embedName = "model.embed_tokens.weight"
    let embedWeight = hfQwen38MakeWeight(modelCid, embedName, weightDtype, mg.ModelQuantSchemeNone, [text.vocabSize, text.hiddenSize])
    if IsErr(embedWeight):
        return Err[mg.ModelGraph](Error(embedWeight))
    add(weights, Value(embedWeight))
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpEmbedding, ["token_ids"], "hidden0", [share(embedName)], -1, -1))

    var previous = "hidden0"
    for layerIndex in 0..<text.layerCount:
        let inputNormWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "input_layernorm.weight", weightDtype, mg.ModelQuantSchemeNone, [text.hiddenSize])
        if IsErr(inputNormWeight):
            return Err[mg.ModelGraph](Error(inputNormWeight))
        add(weights, Value(inputNormWeight))
        let inputNormOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".input_norm"], "")
        add(ops, hfQwen38MakeOp(mg.InferenceModelOpRmsNorm, [share(previous)], inputNormOut, [share(Value(inputNormWeight).tensorName)], layerIndex, -1))

        let attnBranch = hfQwen38AppendAttentionLayer(share(modelCid), layerIndex, text.hiddenSize, text.linearConvKernelDim, qRows, kvRows, gdnInRows, gdnBaRows, linearVRows, convRows, layerTypeCodes[layerIndex] == 1, inputNormOut, previous, weights, ops)
        if IsErr(attnBranch):
            return Err[mg.ModelGraph](Error(attnBranch))
        let attnResidualOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".attention_residual"], "")

        let postNormWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "post_attention_layernorm.weight", weightDtype, mg.ModelQuantSchemeNone, [text.hiddenSize])
        if IsErr(postNormWeight):
            return Err[mg.ModelGraph](Error(postNormWeight))
        add(weights, Value(postNormWeight))
        let postNormOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".post_norm"], "")
        add(ops, hfQwen38MakeOp(mg.InferenceModelOpRmsNorm, [share(attnResidualOut)], postNormOut, [share(Value(postNormWeight).tensorName)], layerIndex, -1))

        let gateWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "mlp.gate_proj.weight", weightDtype, mg.ModelQuantSchemeNone, [text.intermediateSize, text.hiddenSize])
        if IsErr(gateWeight):
            return Err[mg.ModelGraph](Error(gateWeight))
        add(weights, Value(gateWeight))
        let upWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "mlp.up_proj.weight", weightDtype, mg.ModelQuantSchemeNone, [text.intermediateSize, text.hiddenSize])
        if IsErr(upWeight):
            return Err[mg.ModelGraph](Error(upWeight))
        add(weights, Value(upWeight))
        let downWeight = hfQwen38MakeLayerWeight(modelCid, layerIndex, "mlp.down_proj.weight", weightDtype, mg.ModelQuantSchemeNone, [text.hiddenSize, text.intermediateSize])
        if IsErr(downWeight):
            return Err[mg.ModelGraph](Error(downWeight))
        add(weights, Value(downWeight))
        let mlpOut = strutil.Join(["layer", strings.IntToStr(layerIndex), ".mlp"], "")
        add(ops, hfQwen38MakeOp(mg.InferenceModelOpMlp, [share(postNormOut)], mlpOut, [share(Value(gateWeight).tensorName), share(Value(upWeight).tensorName), share(Value(downWeight).tensorName)], layerIndex, -1))
        previous = strutil.Join(["layer", strings.IntToStr(layerIndex), ".residual"], "")
        add(ops, hfQwen38MakeOp(mg.InferenceModelOpResidualAdd, [share(attnResidualOut), share(mlpOut)], previous, [], layerIndex, -1))

    let finalNormName = "model.norm.weight"
    let finalNormWeight = hfQwen38MakeWeight(modelCid, finalNormName, weightDtype, mg.ModelQuantSchemeNone, [text.hiddenSize])
    if IsErr(finalNormWeight):
        return Err[mg.ModelGraph](Error(finalNormWeight))
    add(weights, Value(finalNormWeight))
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpRmsNorm, [share(previous)], "model.norm", [share(finalNormName)], text.layerCount, -1))

    let mtpEhName = "model.mtp.eh_proj.weight"
    let mtpEhWeight = hfQwen38MakeWeight(modelCid, mtpEhName, weightDtype, mg.ModelQuantSchemeNone, [text.hiddenSize, mtpEhCols])
    if IsErr(mtpEhWeight):
        return Err[mg.ModelGraph](Error(mtpEhWeight))
    add(weights, Value(mtpEhWeight))
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpMtpProject, ["model.norm"], "mtp.hidden", [share(mtpEhName)], text.layerCount, -1))

    let lmHeadName = "lm_head.weight"
    let lmHeadWeight = hfQwen38MakeWeight(modelCid, lmHeadName, weightDtype, mg.ModelQuantSchemeNone, [text.vocabSize, text.hiddenSize])
    if IsErr(lmHeadWeight):
        return Err[mg.ModelGraph](Error(lmHeadWeight))
    add(weights, Value(lmHeadWeight))
    add(ops, hfQwen38MakeOp(mg.InferenceModelOpLmHead, ["model.norm"], "logits", [share(lmHeadName)], text.layerCount, -1))

    var graph = mg.ModelGraph(
        schema: mg.InferenceModelGraphSchema,
        modelCid: modelCid,
        architecture: mg.InferenceModelArchitectureHfQwen38HybridMtp,
        hiddenSize: text.hiddenSize,
        attentionHeads: text.attentionHeads,
        keyValueHeads: text.keyValueHeads,
        headDim: text.headDim,
        layerCount: text.layerCount,
        expertCount: 1,
        topK: 1,
        mtpLayerCount: text.mtpNumHiddenLayers,
        mtpStartLayer: text.layerCount,
        ropeTheta: text.ropeTheta,
        tensors: tensors,
        weights: weights,
        ops: ops,
        graphHash: int64(0)
    )
    graph.graphHash = mg.ModelGraphHash(graph)
    return Ok[mg.ModelGraph](graph)
