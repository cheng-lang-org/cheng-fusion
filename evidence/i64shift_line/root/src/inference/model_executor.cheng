@borrows
fn ModelExecutorKernelReceiptHash(seed: int64, receipt: device.KernelLaunchReceipt): Result[int64] =
    if receipt.status != device.InferenceDeviceKernelStatusLaunched:
        return Err[int64]("model executor metal: kernel not launched")
    if receipt.kernelHash <= int64(0) || receipt.inputHash <= int64(0) ||
       receipt.outputHash <= int64(0) || receipt.elapsedNs <= int64(0):
        return Err[int64]("model executor metal: receipt hash")
    var h: int64 = seed
    h = ModelExecutorHashStep(h, receipt.kernelHash)
    h = ModelExecutorHashStep(h, receipt.inputHash)
    h = ModelExecutorHashStep(h, receipt.outputHash)
    h = ModelExecutorHashStep(h, receipt.elapsedNs)
    if h <= int64(0):
        return Err[int64]("model executor metal: receipt aggregate")
    return Ok[int64](h)

fn ModelExecutorMetalRmsNormRowsFill(out: var infer.TensorQ,
                                     metal: device.Device,
                                     input: infer.TensorQ,
                                     weight: infer.TensorQ,
                                     epsilonScale: int32,
                                     receiptHash: var int64): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    let weightOk = infer.TensorValidate(weight)
    if IsErr(weightOk):
        return Err[bool](Error(weightOk))
    if input.shape.len != 2 || weight.shape.len != 1 || input.shape[1] != weight.shape[0]:
        return Err[bool]("model executor metal rmsnorm: shape")
    let zerosRes = infer.TensorZerosFill(out, input.shape, input.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    let tokenCount = input.shape[0]
    let hidden = input.shape[1]
    let program = kernel_ir.KernelIrRmsNormProgram(hidden, kernel_ir.KernelDtypeFp16, input.scale, epsilonScale)
    let weightLoad = device.DeviceMetalLoadTensorI32Buffer(metal, weight)
    if IsErr(weightLoad):
        return Err[bool](Error(weightLoad))
    for tokenIndex in 0..<tokenCount:
        var rowData: int32[]
        for hiddenIndex in 0..<hidden:
            add(rowData, input.data[infer.TensorOffset2(input.shape, tokenIndex, hiddenIndex)])
        let row = infer.TensorQ(shape: [hidden], scale: input.scale, data: rowData)
        let rowOk = infer.TensorValidate(row)
        if IsErr(rowOk):
            let _releaseWeightOnRowFail = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
            return Err[bool](Error(rowOk))
        var rowOut: infer.TensorQ
        let rowLoad = device.DeviceMetalLoadTensorI32Buffer(metal, row)
        if IsErr(rowLoad):
            let _releaseWeightOnLoadFail = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
            return Err[bool](Error(rowLoad))
        let receiptRes = device.DeviceMetalRmsNormBuffersFill(
            rowOut,
            metal,
            program,
            Value(rowLoad).buffer,
            Value(rowLoad).receipt,
            Value(weightLoad).buffer,
            Value(weightLoad).receipt,
            epsilonScale
        )
        let releaseRow = device.DeviceMetalReleaseBuffer(Value(rowLoad).buffer)
        if IsErr(releaseRow):
            let _releaseWeightOnRowReleaseFail = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
            return Err[bool](Error(releaseRow))
        if IsErr(receiptRes):
            let _releaseWeightOnKernelFail = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
            return Err[bool](Error(receiptRes))
        let nextHash = ModelExecutorKernelReceiptHash(receiptHash, Value(receiptRes))
        if IsErr(nextHash):
            let _releaseWeightOnHashFail = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
            return Err[bool](Error(nextHash))
        receiptHash = Value(nextHash)
        for hiddenIndex in 0..<hidden:
            out.data[infer.TensorOffset2(out.shape, tokenIndex, hiddenIndex)] = rowOut.data[hiddenIndex]
    let releaseWeight = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
    if IsErr(releaseWeight):
        return Err[bool](Error(releaseWeight))
    return Ok[bool](true)

fn ModelExecutorMetalMatMulFill(out: var infer.TensorQ,
                                metal: device.Device,
                                left: infer.TensorQ,
                                right: infer.TensorQ,
                                label: str,
                                receiptHash: var int64): Result[bool] =
    let leftOk = infer.TensorValidate(left)
    if IsErr(leftOk):
        return Err[bool](Error(leftOk))
    let rightOk = infer.TensorValidate(right)
    if IsErr(rightOk):
        return Err[bool](Error(rightOk))
    if left.shape.len != 2 || right.shape.len != 2 || left.shape[1] != right.shape[0]:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": shape"], ""))
    let program = kernel_ir.KernelIrGemmProgram(left.shape[0], right.shape[1], left.shape[1], kernel_ir.KernelDtypeFp16, left.scale)
    let leftLoad = device.DeviceMetalLoadTensorI32Buffer(metal, left)
    if IsErr(leftLoad):
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(leftLoad)], ""))
    let rightLoad = device.DeviceMetalLoadTensorI32Buffer(metal, right)
    if IsErr(rightLoad):
        let _releaseLeftAfterRightLoadFail = device.DeviceMetalReleaseBuffer(Value(leftLoad).buffer)
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(rightLoad)], ""))
    let receiptRes = device.DeviceMetalGemmBuffersFill(
        out,
        metal,
        program,
        Value(leftLoad).buffer,
        Value(leftLoad).receipt,
        Value(rightLoad).buffer,
        Value(rightLoad).receipt
    )
    let releaseRight = device.DeviceMetalReleaseBuffer(Value(rightLoad).buffer)
    let releaseLeft = device.DeviceMetalReleaseBuffer(Value(leftLoad).buffer)
    if IsErr(receiptRes):
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(receiptRes)], ""))
    if IsErr(releaseRight):
        return Err[bool](Error(releaseRight))
    if IsErr(releaseLeft):
        return Err[bool](Error(releaseLeft))
    let nextHash = ModelExecutorKernelReceiptHash(receiptHash, Value(receiptRes))
    if IsErr(nextHash):
        return Err[bool](Error(nextHash))
    receiptHash = Value(nextHash)
    return Ok[bool](true)

fn ModelExecutorBuildTinyRoutePlan(graph: model_graph.ModelGraph,
                                   bindings: weight_binding.WeightBindingSet,
                                   store: weight_store.WeightTensorStore,
                                   tokenIds: infer.TensorQ,
                                   expertCapacity: int32): Result[moe_router.MoeRoutePlan] =
    let graphOk = ModelExecutorValidateTinyGraph(graph)
    if IsErr(graphOk):
        return Err[moe_router.MoeRoutePlan](Error(graphOk))
    let storeOk = weight_store.WeightTensorValidateStore(store, bindings, graph)
    if IsErr(storeOk):
        return Err[moe_router.MoeRoutePlan](Error(storeOk))
    let embedding = ModelExecutorFindWeight(store, "embedding.weight")
    if IsErr(embedding):
        return Err[moe_router.MoeRoutePlan](Error(embedding))
    let normWeight = ModelExecutorFindWeight(store, "layer0.norm.weight")
    if IsErr(normWeight):
        return Err[moe_router.MoeRoutePlan](Error(normWeight))
    let qkvWeight = ModelExecutorFindWeight(store, "layer0.qkv.weight")
    if IsErr(qkvWeight):
        return Err[moe_router.MoeRoutePlan](Error(qkvWeight))
    let routerWeight = ModelExecutorFindWeight(store, "layer0.router.weight")
    if IsErr(routerWeight):
        return Err[moe_router.MoeRoutePlan](Error(routerWeight))

    var hidden: infer.TensorQ
    let hiddenOk = ModelExecutorEmbeddingFill(hidden, tokenIds, Value(embedding))
    if IsErr(hiddenOk):
        return Err[moe_router.MoeRoutePlan](Error(hiddenOk))
    var normed: infer.TensorQ
    let normOk = ModelExecutorRmsNormRowsFill(normed, hidden, Value(normWeight), 1)
    if IsErr(normOk):
        return Err[moe_router.MoeRoutePlan](Error(normOk))
    var qkv: infer.TensorQ
    let qkvOk = ModelExecutorMatMulFill(qkv, normed, Value(qkvWeight), "qkv")
    if IsErr(qkvOk):
        return Err[moe_router.MoeRoutePlan](Error(qkvOk))
    var attn: infer.TensorQ
    let attnOk = ModelExecutorTinyAttentionFill(attn, qkv)
    if IsErr(attnOk):
        return Err[moe_router.MoeRoutePlan](Error(attnOk))
    var routerScores: infer.TensorQ
    let routerOk = ModelExecutorMatMulFill(routerScores, attn, Value(routerWeight), "router")
    if IsErr(routerOk):
        return Err[moe_router.MoeRoutePlan](Error(routerOk))
    return moe_router.MoeRouteTop2(routerScores.data, routerScores.shape[0], routerScores.shape[1], expertCapacity)

fn ModelExecutorCombineExpertsFill(out: var infer.TensorQ,
                                   routePlan: moe_router.MoeRoutePlan,
                                   expert0: infer.TensorQ,
                                   expert1: infer.TensorQ): Result[bool] =
    let routeOk = moe_router.MoeValidateRoutePlan(routePlan)
    if IsErr(routeOk):
        return Err[bool](Error(routeOk))
    let expert0Ok = infer.TensorValidate(expert0)
    if IsErr(expert0Ok):
        return Err[bool](Error(expert0Ok))
    let expert1Ok = infer.TensorValidate(expert1)
    if IsErr(expert1Ok):
        return Err[bool](Error(expert1Ok))
    if routePlan.expertCount != 2 || expert0.shape.len != 2 || expert1.shape.len != 2:
        return Err[bool]("model executor combine: shape")
    if expert0.shape[0] != routePlan.tokenCount || expert1.shape[0] != routePlan.tokenCount ||
       expert0.shape[1] != expert1.shape[1] || expert0.scale != expert1.scale:
        return Err[bool]("model executor combine: expert shape")
    let zerosRes = infer.TensorZerosFill(out, expert0.shape, expert0.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    let hidden = expert0.shape[1]
    for tokenIndex in 0..<routePlan.tokenCount:
        let firstExpert = routePlan.choices[tokenIndex].expert0
        let secondExpert = routePlan.choices[tokenIndex].expert1
        for hiddenIndex in 0..<hidden:
            var firstValue: int32
            if firstExpert == 0:
                firstValue = expert0.data[infer.TensorOffset2(expert0.shape, tokenIndex, hiddenIndex)]
            elif firstExpert == 1:
                firstValue = expert1.data[infer.TensorOffset2(expert1.shape, tokenIndex, hiddenIndex)]
            else:
                return Err[bool]("model executor combine: expert id")
            var secondValue: int32
            if secondExpert == 0:
                secondValue = expert0.data[infer.TensorOffset2(expert0.shape, tokenIndex, hiddenIndex)]
            elif secondExpert == 1:
                secondValue = expert1.data[infer.TensorOffset2(expert1.shape, tokenIndex, hiddenIndex)]
            else:
                return Err[bool]("model executor combine: expert id")
            out.data[infer.TensorOffset2(out.shape, tokenIndex, hiddenIndex)] = (firstValue + secondValue) / 2
    return Ok[bool](true)

fn ModelExecutorExecuteTinyGlmMoe(graph: model_graph.ModelGraph,
                                 bindings: weight_binding.WeightBindingSet,
                                 store: weight_store.WeightTensorStore,
                                 tokenIds: infer.TensorQ,
                                 expectedRoutePlan: moe_router.MoeRoutePlan): Result[ModelExecutorOutput] =
    let routeRes = ModelExecutorBuildTinyRoutePlan(graph, bindings, store, tokenIds, expectedRoutePlan.expertCapacity)
    if IsErr(routeRes):
        return Err[ModelExecutorOutput](Error(routeRes))
    let routePlan = Value(routeRes)
    if routePlan.routeHash != expectedRoutePlan.routeHash:
        return Err[ModelExecutorOutput]("model executor: route mismatch")
    let embedding = ModelExecutorFindWeight(store, "embedding.weight")
    if IsErr(embedding):
        return Err[ModelExecutorOutput](Error(embedding))
    let normWeight = ModelExecutorFindWeight(store, "layer0.norm.weight")
    if IsErr(normWeight):
        return Err[ModelExecutorOutput](Error(normWeight))
    let qkvWeight = ModelExecutorFindWeight(store, "layer0.qkv.weight")
    if IsErr(qkvWeight):
        return Err[ModelExecutorOutput](Error(qkvWeight))
    let expert0Weight = ModelExecutorFindWeight(store, "layer0.expert0.weight")
    if IsErr(expert0Weight):
        return Err[ModelExecutorOutput](Error(expert0Weight))
    let expert1Weight = ModelExecutorFindWeight(store, "layer0.expert1.weight")
    if IsErr(expert1Weight):
        return Err[ModelExecutorOutput](Error(expert1Weight))
    let lmHeadWeight = ModelExecutorFindWeight(store, "lm_head.weight")
    if IsErr(lmHeadWeight):
        return Err[ModelExecutorOutput](Error(lmHeadWeight))

    var hidden: infer.TensorQ
    let hiddenOk = ModelExecutorEmbeddingFill(hidden, tokenIds, Value(embedding))
    if IsErr(hiddenOk):
        return Err[ModelExecutorOutput](Error(hiddenOk))
    var normed: infer.TensorQ
    let normOk = ModelExecutorRmsNormRowsFill(normed, hidden, Value(normWeight), 1)
    if IsErr(normOk):
        return Err[ModelExecutorOutput](Error(normOk))
    var qkv: infer.TensorQ
    let qkvOk = ModelExecutorMatMulFill(qkv, normed, Value(qkvWeight), "qkv")
    if IsErr(qkvOk):
        return Err[ModelExecutorOutput](Error(qkvOk))
    var attn: infer.TensorQ
    let attnOk = ModelExecutorTinyAttentionFill(attn, qkv)
    if IsErr(attnOk):
        return Err[ModelExecutorOutput](Error(attnOk))
    var expert0: infer.TensorQ
    let expert0Ok = ModelExecutorMatMulFill(expert0, attn, Value(expert0Weight), "expert0")
    if IsErr(expert0Ok):
        return Err[ModelExecutorOutput](Error(expert0Ok))
    var expert1: infer.TensorQ
    let expert1Ok = ModelExecutorMatMulFill(expert1, attn, Value(expert1Weight), "expert1")
    if IsErr(expert1Ok):
        return Err[ModelExecutorOutput](Error(expert1Ok))
    var combined: infer.TensorQ
    let combineOk = ModelExecutorCombineExpertsFill(combined, routePlan, expert0, expert1)
    if IsErr(combineOk):
        return Err[ModelExecutorOutput](Error(combineOk))
    var logits: infer.TensorQ
    let logitsOk = ModelExecutorMatMulFill(logits, combined, Value(lmHeadWeight), "lm_head")
    if IsErr(logitsOk):
        return Err[ModelExecutorOutput](Error(logitsOk))
    let routeSet = moe_router.MoeRoutePlanSetFromSingle(0, routePlan)
    let outputHash = ModelExecutorOutputHash(logits, routePlan, routeSet)
    if IsErr(outputHash):
        return Err[ModelExecutorOutput](Error(outputHash))
    return Ok[ModelExecutorOutput](ModelExecutorOutput(
        logits: logits,
        routePlan: routePlan,
        routePlanSet: routeSet,
        executionHash: Value(outputHash)
    ))

fn ModelExecutorExecuteTinyGlmMoeMetal(graph: model_graph.ModelGraph,
                                       bindings: weight_binding.WeightBindingSet,
                                       store: weight_store.WeightTensorStore,
                                       tokenIds: infer.TensorQ,
                                       expectedRoutePlan: moe_router.MoeRoutePlan,
                                       metal: device.Device): Result[ModelExecutorOutput] =
    let routeRes = ModelExecutorBuildTinyRoutePlan(graph, bindings, store, tokenIds, expectedRoutePlan.expertCapacity)
    if IsErr(routeRes):
        return Err[ModelExecutorOutput](Error(routeRes))
    let routePlan = Value(routeRes)
    if routePlan.routeHash != expectedRoutePlan.routeHash:
        return Err[ModelExecutorOutput]("model executor metal: route mismatch")
    if metal.backend != device.InferenceDeviceBackendMetal || !metal.ready:
        return Err[ModelExecutorOutput]("model executor metal: device")
    let embedding = ModelExecutorFindWeight(store, "embedding.weight")
    if IsErr(embedding):
        return Err[ModelExecutorOutput](Error(embedding))
    let normWeight = ModelExecutorFindWeight(store, "layer0.norm.weight")
    if IsErr(normWeight):
        return Err[ModelExecutorOutput](Error(normWeight))
    let qkvWeight = ModelExecutorFindWeight(store, "layer0.qkv.weight")
    if IsErr(qkvWeight):
        return Err[ModelExecutorOutput](Error(qkvWeight))
    let expert0Weight = ModelExecutorFindWeight(store, "layer0.expert0.weight")
    if IsErr(expert0Weight):
        return Err[ModelExecutorOutput](Error(expert0Weight))
    let expert1Weight = ModelExecutorFindWeight(store, "layer0.expert1.weight")
    if IsErr(expert1Weight):
        return Err[ModelExecutorOutput](Error(expert1Weight))
    let lmHeadWeight = ModelExecutorFindWeight(store, "lm_head.weight")
    if IsErr(lmHeadWeight):
        return Err[ModelExecutorOutput](Error(lmHeadWeight))

    var receiptHash: int64 = int64(131)
    var hidden: infer.TensorQ
    let hiddenOk = ModelExecutorEmbeddingFill(hidden, tokenIds, Value(embedding))
    if IsErr(hiddenOk):
        return Err[ModelExecutorOutput](Error(hiddenOk))
    var normed: infer.TensorQ
    let normOk = ModelExecutorMetalRmsNormRowsFill(normed, metal, hidden, Value(normWeight), 1, receiptHash)
    if IsErr(normOk):
        return Err[ModelExecutorOutput](Error(normOk))
    var qkv: infer.TensorQ
    let qkvOk = ModelExecutorMetalMatMulFill(qkv, metal, normed, Value(qkvWeight), "qkv", receiptHash)
    if IsErr(qkvOk):
        return Err[ModelExecutorOutput](Error(qkvOk))
    var attn: infer.TensorQ
    let attnOk = ModelExecutorTinyAttentionFill(attn, qkv)
    if IsErr(attnOk):
        return Err[ModelExecutorOutput](Error(attnOk))
    var expert0: infer.TensorQ
    let expert0Ok = ModelExecutorMetalMatMulFill(expert0, metal, attn, Value(expert0Weight), "expert0", receiptHash)
    if IsErr(expert0Ok):
        return Err[ModelExecutorOutput](Error(expert0Ok))
    var expert1: infer.TensorQ
    let expert1Ok = ModelExecutorMetalMatMulFill(expert1, metal, attn, Value(expert1Weight), "expert1", receiptHash)
    if IsErr(expert1Ok):
        return Err[ModelExecutorOutput](Error(expert1Ok))
    var combined: infer.TensorQ
    let combineOk = ModelExecutorCombineExpertsFill(combined, routePlan, expert0, expert1)
    if IsErr(combineOk):
        return Err[ModelExecutorOutput](Error(combineOk))
    var logits: infer.TensorQ
    let logitsOk = ModelExecutorMetalMatMulFill(logits, metal, combined, Value(lmHeadWeight), "lm_head", receiptHash)
    if IsErr(logitsOk):
        return Err[ModelExecutorOutput](Error(logitsOk))
    let routeSet = moe_router.MoeRoutePlanSetFromSingle(0, routePlan)
    let outputHash = ModelExecutorOutputHash(logits, routePlan, routeSet)
    if IsErr(outputHash):
        return Err[ModelExecutorOutput](Error(outputHash))
    let executionHash = ModelExecutorHashStep(Value(outputHash), receiptHash)
    return Ok[ModelExecutorOutput](ModelExecutorOutput(
        logits: logits,
        routePlan: routePlan,
        routePlanSet: routeSet,
        executionHash: executionHash
    ))

@borrows
fn ModelExecutorFacts(output: ModelExecutorOutput): str[] =
    var out: str[]
    add(out, strutil.Join(["model_executor_route_hash=", strings.Int64ToStr(output.routePlan.routeHash)], ""))
    add(out, strutil.Join(["model_executor_route_set_hash=", strings.Int64ToStr(output.routePlanSet.routeSetHash)], ""))
    add(out, strutil.Join(["model_executor_execution_hash=", strings.Int64ToStr(output.executionHash)], ""))
    return out

# ---- D5: DiLoCo 版本权重加载入口 (只加载与度量, 不改执行算法) ----
# GlobalVersion.modelRef (定点 i32 lmHead 字节, 工件仓 CID 寻址) -> 执行器侧
# 可推理权重; 版本绑定哈希把 versionCid 与生成/度量输出锁在一起, 漂移硬错。

@borrows
fn ModelExecutorLoadDiLoCoLinearWeightsFill(outWeights: var int32[],
                                              store: diloco_store.DiLoCoArtifactStore,
                                              artifactRef: diloco_core.DiLoCoArtifactRef,
                                              outFeatures: int32,
                                              inFeatures: int32): Result[bool] =
    var bytes = rawbytes.EmptyBytes()
    let getRes = diloco_store.DiLoCoArtifactStoreGetFill(bytes, store, artifactRef)
    if IsErr(getRes):
        return Err[bool](Error(getRes))
    var values: int32[]
    let unpackRes = diloco_codec.DiLoCoTrainUnpackI32Fill(values, bytes)
    if IsErr(unpackRes):
        return Err[bool](Error(unpackRes))
    let countRes = diloco_inner.DiLoCoLinearParamCount(outFeatures, inFeatures)
    if IsErr(countRes):
        return Err[bool](Error(countRes))
    if values.len != Value(countRes):
        return Err[bool]("model executor: diloco weight rank drift")
    outWeights = values
    return Ok[bool](true)

@borrows
fn ModelExecutorDiLoCoGreedyFill(outTokens: var int32[],
                                   lmHead: int32[],
                                   xs: int32[],
                                   sampleCount: int32,
                                   vocab: int32,
                                   hidden: int32): Result[bool] =
    if sampleCount <= 0 || vocab <= 0 || hidden <= 0:
        return Err[bool]("model executor: diloco greedy args")
    for s in 0..<sampleCount:
        var logits: int32[]
        let fwdOk = diloco_inner.DiLoCoLinearForwardOneFill(logits, lmHead, xs, s * hidden, vocab, hidden)
        if IsErr(fwdOk):
            return Err[bool](Error(fwdOk))
        var best: int32 = 0
        for v in 1..<vocab:
            if logits[v] > logits[best]:
                best = v
        add(outTokens, best)
    return Ok[bool](true)

@borrows
fn ModelExecutorDiLoCoVersionBindHash(versionCidHex: str,
                                        tokens: int32[],
                                        evalMetricMicros: int64): int64 =
    var h: int64 = int64(17)
    for i in 0..<versionCidHex.len:
        h = ModelExecutorHashStep(h, int64(versionCidHex[i]))
    for t in 0..<tokens.len:
        h = ModelExecutorHashStep(h, int64(tokens[t]))
    h = ModelExecutorHashStep(h, evalMetricMicros)
    return h
