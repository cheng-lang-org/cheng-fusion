fn ModelExecutorExecuteHfGlmMoeTokensWithKvState(graph: model_graph.ModelGraph,
                                                 bindings: weight_binding.WeightBindingSet,
                                                 store: weight_store.WeightTensorStore,
                                                 tokenIds: infer.TensorQ,
                                                 expectedRouteSet: moe_router.MoeRoutePlanSet,
                                                 inputKvState: ModelExecutorKvStateSet,
                                                 hasInputKvState: bool): Result[ModelExecutorOutputWithKv] =
    var metalCtx = ModelExecutorMetalContextDisabled()
    return ModelExecutorExecuteHfGlmMoeTokensWithKvStateWithMetalContext(
        graph,
        bindings,
        store,
        tokenIds,
        expectedRouteSet,
        inputKvState,
