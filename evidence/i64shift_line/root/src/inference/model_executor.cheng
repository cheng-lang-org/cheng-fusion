type
    ModelExecutorOutput =
        logits: infer.TensorQ
        routePlan: moe_router.MoeRoutePlan
        routePlanSet: moe_router.MoeRoutePlanSet
        executionHash: int64

    ModelExecutorKvLayerState =
        layerIndex: int32
        cache: paged_kv_cache.PagedKVCache
        seq: paged_kv_cache.PagedKVSequence
        stateHash: int64

    ModelExecutorKvStateSet =
        layerStates: ModelExecutorKvLayerState[]
        stateSetHash: int64

    ModelExecutorOutputWithKv =
        output: ModelExecutorOutput
        kvStateSet: ModelExecutorKvStateSet

    ModelExecutorTensorSlot =
        name: str
        tensor: infer.TensorQ

    ModelExecutorRouteSlot =
        name: str
        layerIndex: int32
        routePlan: moe_router.MoeRoutePlan

    ModelExecutorMetalContext =
        enabled: bool
        requirePackedInt4Linear: bool
        metal: device.Device
        receiptHash: int64
        launchedKernels: int32

fn ModelExecutorNoDevice(): device.Device =
    return device.Device(
        backend: "none",
        name: "none",
        capabilityHash: "none",
        capabilityMask: 0,
        ready: false
    )

fn ModelExecutorMetalContextDisabled(): ModelExecutorMetalContext =
    return ModelExecutorMetalContext(
        enabled: false,
        requirePackedInt4Linear: false,
        metal: ModelExecutorNoDevice(),
        receiptHash: int64(131),
        launchedKernels: 0
    )

fn ModelExecutorMetalContextEnabled(metal: device.Device,
                                    requirePackedInt4Linear: bool): Result[ModelExecutorMetalContext] =
    if metal.backend != device.InferenceDeviceBackendMetal ||
       (metal.capabilityMask & device.InferenceDeviceCapabilityMetalCompute) != device.InferenceDeviceCapabilityMetalCompute ||
       !metal.ready:
        return Err[ModelExecutorMetalContext]("model executor metal: ready metal device required")
    return Ok[ModelExecutorMetalContext](ModelExecutorMetalContext(
        enabled: true,
        requirePackedInt4Linear: requirePackedInt4Linear,
        metal: metal,
        receiptHash: int64(131),
        launchedKernels: 0
    ))

fn ModelExecutorHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(65537) + value + int64(131)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn ModelExecutorTensorHash(tensor: infer.TensorQ): Result[int64] =
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[int64](Error(tensorOk))
    var h: int64 = int64(131)
    h = ModelExecutorHashStep(h, int64(tensor.scale))
    for i in 0..<tensor.shape.len:
        h = ModelExecutorHashStep(h, int64(tensor.shape[i]))
    for i in 0..<tensor.data.len:
        h = ModelExecutorHashStep(h, int64(tensor.data[i]))
    if h <= int64(0):
        return Err[int64]("model executor: tensor hash")
    return Ok[int64](h)

@borrows
fn ModelExecutorOutputHash(logits: infer.TensorQ,
                           routePlan: moe_router.MoeRoutePlan,
                           routePlanSet: moe_router.MoeRoutePlanSet): Result[int64] =
    let logitsHash = ModelExecutorTensorHash(logits)
    if IsErr(logitsHash):
        return Err[int64](Error(logitsHash))
    let routePlanHash = routePlan.routeHash
    let routeSetHashValue = routePlanSet.routeSetHash
    let routeOk = moe_router.MoeValidateRoutePlan(routePlan)
    if IsErr(routeOk):
        return Err[int64](Error(routeOk))
    let routeSetOk = moe_router.MoeValidateRoutePlanSet(routePlanSet)
    if IsErr(routeSetOk):
        return Err[int64](Error(routeSetOk))
    var h: int64 = int64(131)
    h = ModelExecutorHashStep(h, Value(logitsHash))
    h = ModelExecutorHashStep(h, routePlanHash)
    h = ModelExecutorHashStep(h, routeSetHashValue)
    if h <= int64(0):
        return Err[int64]("model executor: output hash")
    return Ok[int64](h)

@borrows
fn ModelExecutorKvLayerStateHashRaw(layerIndex: int32,
                                    cache: paged_kv_cache.PagedKVCache,
                                    seq: paged_kv_cache.PagedKVSequence): Result[int64] =
    if layerIndex < 0:
        return Err[int64]("model executor kv state: layer")
    var inputs: paged_kv_cache.PagedKVAttentionInputTensors
    let inputsOk = paged_kv_cache.PagedKVBuildAttentionInputTensorsFill(inputs, cache, seq)
    if IsErr(inputsOk):
        return Err[int64](Error(inputsOk))
    let keysHash = ModelExecutorTensorHash(inputs.keysPageMajor)
    if IsErr(keysHash):
        return Err[int64](Error(keysHash))
    let valuesHash = ModelExecutorTensorHash(inputs.valuesPageMajor)
    if IsErr(valuesHash):
        return Err[int64](Error(valuesHash))
    let tableHash = ModelExecutorTensorHash(inputs.pageTable)
    if IsErr(tableHash):
        return Err[int64](Error(tableHash))
    var h: int64 = int64(131)
    h = ModelExecutorHashStep(h, int64(layerIndex))
    h = ModelExecutorHashStep(h, int64(cache.tokensPerPage))
    h = ModelExecutorHashStep(h, int64(cache.keyDim))
    h = ModelExecutorHashStep(h, int64(cache.valueDim))
    h = ModelExecutorHashStep(h, int64(cache.keyScale))
    h = ModelExecutorHashStep(h, int64(cache.valueScale))
    h = ModelExecutorHashStep(h, int64(seq.seqId))
    h = ModelExecutorHashStep(h, int64(seq.tokenCount))
    h = ModelExecutorHashStep(h, paged_kv_cache.PagedKVPageTableHash(seq))
    h = ModelExecutorHashStep(h, Value(keysHash))
    h = ModelExecutorHashStep(h, Value(valuesHash))
    h = ModelExecutorHashStep(h, Value(tableHash))
    if h <= int64(0):
        return Err[int64]("model executor kv state: hash")
    return Ok[int64](h)

@borrows
fn ModelExecutorKvLayerStateBuild(layerIndex: int32,
                                  cache: paged_kv_cache.PagedKVCache,
                                  seq: paged_kv_cache.PagedKVSequence): Result[ModelExecutorKvLayerState] =
    let hash = ModelExecutorKvLayerStateHashRaw(layerIndex, cache, seq)
    if IsErr(hash):
        return Err[ModelExecutorKvLayerState](Error(hash))
    let cacheCopyRes = ModelExecutorClonePagedKvCache(cache)
    if IsErr(cacheCopyRes):
        return Err[ModelExecutorKvLayerState](Error(cacheCopyRes))
    let seqCopy = ModelExecutorClonePagedKvSequence(seq)
    let cacheCopy = Value(cacheCopyRes)
    return Ok[ModelExecutorKvLayerState](ModelExecutorKvLayerState(
        layerIndex: layerIndex,
        cache: cacheCopy,
        seq: seqCopy,
        stateHash: Value(hash)
    ))

@borrows
fn ModelExecutorKvStateSetHash(set: ModelExecutorKvStateSet): int64 =
    var h: int64 = int64(131)
    for i in 0..<set.layerStates.len:
        h = ModelExecutorHashStep(h, int64(set.layerStates[i].layerIndex))
        h = ModelExecutorHashStep(h, set.layerStates[i].stateHash)
    return h

@borrows
fn ModelExecutorTensorClone(tensor: infer.TensorQ): Result[infer.TensorQ] =
    var out: infer.TensorQ
    let copyOk = infer.TensorFromDataFill(out, tensor.shape, tensor.scale, tensor.data)
    if IsErr(copyOk):
        return Err[infer.TensorQ](Error(copyOk))
    return Ok[infer.TensorQ](out)

@borrows
fn ModelExecutorClonePagedKvSequence(seq: paged_kv_cache.PagedKVSequence): paged_kv_cache.PagedKVSequence =
    var blockPageIds: int32[]
    for i in 0..<seq.blockPageIds.len:
        add(blockPageIds, seq.blockPageIds[i])
    return paged_kv_cache.PagedKVSequence(
        seqId: seq.seqId,
        blockPageIds: blockPageIds,
        tokenCount: seq.tokenCount
    )

@borrows
fn ModelExecutorClonePagedKvCache(cache: paged_kv_cache.PagedKVCache): Result[paged_kv_cache.PagedKVCache] =
    var pages: paged_kv_cache.PagedKVPage[]
    for pageIndex in 0..<cache.pages.len:
        var keys: infer.TensorQ[]
        var values: infer.TensorQ[]
        for tokenIndex in 0..<cache.pages[pageIndex].keys.len:
            let keyCopy = ModelExecutorTensorClone(cache.pages[pageIndex].keys[tokenIndex])
            if IsErr(keyCopy):
                return Err[paged_kv_cache.PagedKVCache](Error(keyCopy))
            add(keys, Value(keyCopy))
        for tokenIndex in 0..<cache.pages[pageIndex].values.len:
            let valueCopy = ModelExecutorTensorClone(cache.pages[pageIndex].values[tokenIndex])
            if IsErr(valueCopy):
                return Err[paged_kv_cache.PagedKVCache](Error(valueCopy))
            add(values, Value(valueCopy))
        add(pages, paged_kv_cache.PagedKVPage(
            pageId: cache.pages[pageIndex].pageId,
            seqId: cache.pages[pageIndex].seqId,
            usedTokens: cache.pages[pageIndex].usedTokens,
            keys: keys,
            values: values
        ))
    return Ok[paged_kv_cache.PagedKVCache](paged_kv_cache.PagedKVCache(
        tokensPerPage: cache.tokensPerPage,
        keyDim: cache.keyDim,
        valueDim: cache.valueDim,
        keyScale: cache.keyScale,
        valueScale: cache.valueScale,
        nextPageId: cache.nextPageId,
        pages: pages
    ))


# Ownership-isolation helper: borrow in, owned out. Used by call sites that must
# hand the same kv state set to a consuming callee multiple times (per-op loop).
@borrows
fn ModelExecutorKvStateSetClone(source: ModelExecutorKvStateSet): Result[ModelExecutorKvStateSet] =
    var layerStates: ModelExecutorKvLayerState[]
    for i in 0..<source.layerStates.len:
        let cacheCopyRes = ModelExecutorClonePagedKvCache(source.layerStates[i].cache)
        if IsErr(cacheCopyRes):
            return Err[ModelExecutorKvStateSet](Error(cacheCopyRes))
        let seqCopy = ModelExecutorClonePagedKvSequence(source.layerStates[i].seq)
        let cacheCopy = Value(cacheCopyRes)
        add(layerStates, ModelExecutorKvLayerState(
            layerIndex: source.layerStates[i].layerIndex,
            cache: cacheCopy,
            seq: seqCopy,
            stateHash: source.layerStates[i].stateHash
        ))
    var stateSetHash: int64 = int64(131)
    for i in 0..<layerStates.len:
        stateSetHash = ModelExecutorHashStep(stateSetHash, int64(layerStates[i].layerIndex))
        stateSetHash = ModelExecutorHashStep(stateSetHash, layerStates[i].stateHash)
    return Ok[ModelExecutorKvStateSet](ModelExecutorKvStateSet(
        layerStates: layerStates,
        stateSetHash: stateSetHash
    ))

fn ModelExecutorKvStateSetBuild(layerStates: ModelExecutorKvLayerState[]): ModelExecutorKvStateSet =
    var out = ModelExecutorKvStateSet(
        layerStates: layerStates,
        stateSetHash: int64(0)
    )
    out.stateSetHash = ModelExecutorKvStateSetHash(out)
    return out

@borrows
fn ModelExecutorValidateKvStateSet(set: ModelExecutorKvStateSet): Result[bool] =
    if set.layerStates.len <= 0:
        return Err[bool]("model executor kv state set: empty")
    for i in 0..<set.layerStates.len:
        if set.layerStates[i].layerIndex != i:
            return Err[bool]("model executor kv state set: layer order")
        let stateHash = ModelExecutorKvLayerStateHashRaw(
            set.layerStates[i].layerIndex,
            set.layerStates[i].cache,
            set.layerStates[i].seq
        )
        if IsErr(stateHash):
            return Err[bool](Error(stateHash))
        if Value(stateHash) != set.layerStates[i].stateHash:
            return Err[bool]("model executor kv state set: layer hash")
    if ModelExecutorKvStateSetHash(set) != set.stateSetHash:
        return Err[bool]("model executor kv state set: hash")
    return Ok[bool](true)

@borrows
fn ModelExecutorFindKvLayerStateIndex(set: ModelExecutorKvStateSet,
                                      layerIndex: int32): Result[int32] =
    var found: int32 = -1
    for i in 0..<set.layerStates.len:
        if set.layerStates[i].layerIndex == layerIndex:
            if found >= 0:
                return Err[int32]("model executor kv state: duplicate layer")
            found = i
    if found < 0:
        return Err[int32]("model executor kv state: missing layer")
    return Ok[int32](found)

fn ModelExecutorPutKvLayerState(states: var ModelExecutorKvLayerState[],
                                state: ModelExecutorKvLayerState): Result[bool] =
    let stateHash = ModelExecutorKvLayerStateHashRaw(state.layerIndex, state.cache, state.seq)
    if IsErr(stateHash):
        return Err[bool](Error(stateHash))
    if Value(stateHash) != state.stateHash:
        return Err[bool]("model executor kv state: hash")
    for i in 0..<states.len:
        if states[i].layerIndex == state.layerIndex:
            return Err[bool]("model executor kv state: duplicate output layer")
    add(states, state)
    return Ok[bool](true)

@borrows
fn ModelExecutorValidateTinyGraph(graph: model_graph.ModelGraph): Result[bool] =
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    if graph.architecture != "glm_moe_tiny_fixture":
        return Err[bool]("model executor: unsupported architecture")
    if graph.hiddenSize != 4 || graph.layerCount != 1 || graph.expertCount != 2 || graph.topK != 2:
        return Err[bool]("model executor: unsupported tiny dimensions")
    if graph.ops.len != 9:
        return Err[bool]("model executor: unsupported op count")
    if graph.ops[0].opKind != model_graph.InferenceModelOpEmbedding ||
       graph.ops[1].opKind != model_graph.InferenceModelOpRmsNorm ||
       graph.ops[2].opKind != model_graph.InferenceModelOpQkv ||
       graph.ops[3].opKind != model_graph.InferenceModelOpRope ||
       graph.ops[4].opKind != model_graph.InferenceModelOpAttention ||
       graph.ops[5].opKind != model_graph.InferenceModelOpRouter ||
       graph.ops[6].opKind != model_graph.InferenceModelOpExpert ||
       graph.ops[7].opKind != model_graph.InferenceModelOpExpert ||
       graph.ops[8].opKind != model_graph.InferenceModelOpLmHead:
        return Err[bool]("model executor: unsupported op sequence")
    return Ok[bool](true)

@borrows
fn ModelExecutorFindWeight(store: weight_store.WeightTensorStore,
                           tensorName: str): Result[infer.TensorQ] =
    let payload = ModelExecutorFindWeightPayload(store, tensorName)
    if IsErr(payload):
        return Err[infer.TensorQ](Error(payload))
    var owned = Value(payload)
    return Ok[infer.TensorQ](infer.TensorClone(owned.tensor))

@borrows
fn ModelExecutorFindWeightPayload(store: weight_store.WeightTensorStore,
                                  tensorName: str): Result[weight_store.WeightTensorPayload] =
    var found: int32 = -1
    for i in 0..<store.payloads.len:
        if store.payloads[i].tensorName == tensorName:
            if found >= 0:
                return Err[weight_store.WeightTensorPayload]("model executor: duplicate weight")
            found = i
    if found < 0:
        return Err[weight_store.WeightTensorPayload]("model executor: missing weight")
    return weight_store.WeightTensorPayloadClone(store.payloads[found])

@borrows
fn ModelExecutorFindWeightPayloadOptionalIndex(store: weight_store.WeightTensorStore,
                                               tensorName: str): Result[int32] =
    var found: int32 = -1
    for i in 0..<store.payloads.len:
        if store.payloads[i].tensorName == tensorName:
            if found >= 0:
                return Err[int32]("model executor: duplicate weight")
            found = i
    return Ok[int32](found)

@borrows
fn ModelExecutorFindTensor(slots: ModelExecutorTensorSlot[], name: str): Result[infer.TensorQ] =
    var found: int32 = -1
    for i in 0..<slots.len:
        if slots[i].name == name:
            if found >= 0:
                return Err[infer.TensorQ]("model executor graph: duplicate tensor")
            found = i
    if found < 0:
        return Err[infer.TensorQ]("model executor graph: missing tensor")
    return Ok[infer.TensorQ](infer.TensorClone(slots[found].tensor))

@borrows
fn ModelExecutorFindTensorIndex(slots: ModelExecutorTensorSlot[], name: str): Result[int32] =
    var found: int32 = -1
    for i in 0..<slots.len:
        if slots[i].name == name:
            if found >= 0:
                return Err[int32]("model executor graph: duplicate tensor")
            found = i
    return Ok[int32](found)

@borrows
fn ModelExecutorPutTensor(slots: var ModelExecutorTensorSlot[],
                          name: str,
                          tensor: infer.TensorQ): Result[bool] =
    if name == "":
        return Err[bool]("model executor graph: tensor name")
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[bool](Error(tensorOk))
    for i in 0..<slots.len:
        if slots[i].name == name:
            return Err[bool]("model executor graph: duplicate tensor")
    add(slots, ModelExecutorTensorSlot(
        name: strings.CloneStr(name),
        tensor: infer.TensorClone(tensor)))
    return Ok[bool](true)

@borrows
fn ModelExecutorPutTensorAndHash(slots: var ModelExecutorTensorSlot[],
                                 name: str,
                                 tensor: infer.TensorQ,
                                 executionHash: var int64): Result[bool] =
    let putOk = ModelExecutorPutTensor(slots, name, tensor)
    if IsErr(putOk):
        return Err[bool](Error(putOk))
    let hashOk = ModelExecutorHashTensorInto(executionHash, tensor)
    if IsErr(hashOk):
        return Err[bool](Error(hashOk))
    executionHash = Value(hashOk)
    return Ok[bool](true)

fn ModelExecutorFindRoute(slots: ModelExecutorRouteSlot[], name: str): Result[moe_router.MoeRoutePlan] =
    var found: int32 = -1
    for i in 0..<slots.len:
        if slots[i].name == name:
            if found >= 0:
                return Err[moe_router.MoeRoutePlan]("model executor graph: duplicate route")
            found = i
    if found < 0:
        return Err[moe_router.MoeRoutePlan]("model executor graph: missing route")
    return Ok[moe_router.MoeRoutePlan](slots[found].routePlan)

fn ModelExecutorPutRoute(slots: var ModelExecutorRouteSlot[],
                         name: str,
                         layerIndex: int32,
                         routePlan: moe_router.MoeRoutePlan): Result[bool] =
    if name == "":
        return Err[bool]("model executor graph: route name")
    if layerIndex < 0:
        return Err[bool]("model executor graph: route layer")
    let routeOk = moe_router.MoeValidateRoutePlan(routePlan)
    if IsErr(routeOk):
        return Err[bool](Error(routeOk))
    for i in 0..<slots.len:
        if slots[i].name == name:
            return Err[bool]("model executor graph: duplicate route")
    add(slots, ModelExecutorRouteSlot(name: name, layerIndex: layerIndex, routePlan: routePlan))
    return Ok[bool](true)

@borrows
fn ModelExecutorHashTensorInto(hash: int64, tensor: infer.TensorQ): Result[int64] =
    let tensorHash = ModelExecutorTensorHash(tensor)
    if IsErr(tensorHash):
        return Err[int64](Error(tensorHash))
    return Ok[int64](ModelExecutorHashStep(hash, Value(tensorHash)))

@borrows
fn ModelExecutorTensorCopyFill(out: var infer.TensorQ,
                               input: infer.TensorQ): Result[bool] =
    return infer.TensorFromDataFill(out, input.shape, input.scale, input.data)

@borrows
fn ModelExecutorShapeCopy(shape: int32[]): int32[] =
    var out: int32[]
    for i in 0..<shape.len:
        add(out, shape[i])
    return out

fn ModelExecutorTensorZerosValue(shape: int32[], scale: int32): Result[infer.TensorQ] =
    if scale <= 0:
        return Err[infer.TensorQ]("model executor tensor zeros: scale")
    let countRes = infer.TensorElementCount(shape)
    if IsErr(countRes):
        return Err[infer.TensorQ](Error(countRes))
    var data: int32[]
    for _ in 0..<Value(countRes):
        add(data, 0)
    return Ok[infer.TensorQ](infer.TensorQ(
        shape: ModelExecutorShapeCopy(shape),
        scale: scale,
        data: data
    ))

@borrows
fn ModelExecutorDerivedTensorName(base: str, suffix: str): str =
    return strutil.Join([ share(base), share(suffix)], "")

@borrows
fn ModelExecutorCopyDerivedTensorIfPresent(slots: var ModelExecutorTensorSlot[],
                                           inputBase: str,
                                           outputBase: str,
                                           suffix: str): Result[bool] =
    let inputName = ModelExecutorDerivedTensorName(inputBase, suffix)
    let index = ModelExecutorFindTensorIndex(slots, inputName)
    if IsErr(index):
        return Err[bool](Error(index))
    if Value(index) < 0:
        return Ok[bool](true)
    var out: infer.TensorQ
    let copyOk = ModelExecutorTensorCopyFill(out, slots[Value(index)].tensor)
    if IsErr(copyOk):
        return Err[bool](Error(copyOk))
    return ModelExecutorPutTensor(slots, ModelExecutorDerivedTensorName(outputBase, suffix), out)

@borrows
fn ModelExecutorTensorColumnSliceFill(out: var infer.TensorQ,
                                      input: infer.TensorQ,
                                      startCol: int32,
                                      width: int32): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    if input.shape.len != 2 || startCol < 0 || width <= 0 || startCol + width > input.shape[1]:
        return Err[bool]("model executor column slice: shape")
    var data: int32[]
    for row in 0..<input.shape[0]:
        for col in 0..<width:
            add(data, input.data[infer.TensorOffset2(input.shape, row, startCol + col)])
    return infer.TensorFromDataFill(out, [input.shape[0], width], input.scale, data)

@borrows
fn ModelExecutorTensorRowVectorFill(out: var infer.TensorQ,
                                    input: infer.TensorQ,
                                    row: int32): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    if input.shape.len != 2 || row < 0 || row >= input.shape[0]:
        return Err[bool]("model executor row vector: shape")
    var data: int32[]
    for col in 0..<input.shape[1]:
        add(data, input.data[infer.TensorOffset2(input.shape, row, col)])
    return infer.TensorFromDataFill(out, [input.shape[1]], input.scale, data)

# #155r-mgqa: slice one query head's headDim-wide span out of a
# hiddenSize-wide row vector (mirrors PagedKVAttentionQueryFill's
# queryBase slice on the CPU side).
@borrows
fn ModelExecutorHeadVectorSliceFill(out: var infer.TensorQ,
                                    full: infer.TensorQ,
                                    headDim: int32,
                                    headOffset: int32): Result[bool] =
    let fullOk = infer.TensorValidate(full)
    if IsErr(fullOk):
        return Err[bool](Error(fullOk))
    if full.shape.len != 1 || headDim <= 0 || headOffset < 0 || headOffset + headDim > full.shape[0]:
        return Err[bool]("model executor head vector slice: shape")
    var data: int32[]
    for dim in 0..<headDim:
        add(data, full.data[headOffset + dim])
    return infer.TensorFromDataFill(out, [headDim], full.scale, data)

# #155r-mgqa: write one query head's headDim-wide attention output back
# into its own span of the hiddenSize-wide hidden row -- no broadcast
# across the kv-head group, each of the attentionHeads heads gets its own
# independently-computed slice.
@borrows
fn ModelExecutorWriteHeadValueToHiddenRow(out: var infer.TensorQ,
                                          head: infer.TensorQ,
                                          graph: model_graph.ModelGraph,
                                          row: int32,
                                          headOffset: int32): Result[bool] =
    let headOk = infer.TensorValidate(head)
    if IsErr(headOk):
        return Err[bool](Error(headOk))
    let outOk = infer.TensorValidate(out)
    if IsErr(outOk):
        return Err[bool](Error(outOk))
    if head.shape.len != 1 || head.shape[0] != graph.headDim ||
       out.shape.len != 2 || row < 0 || row >= out.shape[0] || out.shape[1] != graph.hiddenSize ||
       out.scale != head.scale ||
       headOffset < 0 || headOffset + graph.headDim > graph.hiddenSize:
        return Err[bool]("model executor head row write: shape")
    for dim in 0..<graph.headDim:
        out.data[infer.TensorOffset2(out.shape, row, headOffset + dim)] = head.data[dim]
    return Ok[bool](true)

@borrows
fn ModelExecutorWriteFullHeadsValueToHiddenRow(out: var infer.TensorQ,
                                               heads: infer.TensorQ,
                                               graph: model_graph.ModelGraph,
                                               row: int32): Result[bool] =
    let headsOk = infer.TensorValidate(heads)
    if IsErr(headsOk):
        return Err[bool](Error(headsOk))
    let outOk = infer.TensorValidate(out)
    if IsErr(outOk):
        return Err[bool](Error(outOk))
    if heads.shape.len != 1 || heads.shape[0] != graph.hiddenSize ||
       out.shape.len != 2 || row < 0 || row >= out.shape[0] || out.shape[1] != graph.hiddenSize ||
       out.scale != heads.scale:
        return Err[bool]("model executor full heads row write: shape")
    for col in 0..<graph.hiddenSize:
        out.data[infer.TensorOffset2(out.shape, row, col)] = heads.data[col]
    return Ok[bool](true)

# --- RoPE (rotary position embedding) ---
#
# HF neox-style (non-interleaved) convention: for a rotated span of width
# `dim` split into two halves x1=in[0:dim/2], x2=in[dim/2:dim], with
# freq_i = theta^(-2i/dim) and angle_i = position * freq_i:
#   out[i]       = x1[i]*cos(angle_i) - x2[i]*sin(angle_i)
#   out[dim/2+i] = x2[i]*cos(angle_i) + x1[i]*sin(angle_i)
# cos/sin are computed once in float64 (std/math Cos/Sin/Ln/Exp) and
# quantized into the same int32 Q-format the rest of the tensor pipeline
# uses, via a fixed trig scale; the rotation itself runs entirely in that
# int32 domain through the existing InferenceMulQ saturating multiply.

fn ModelExecutorRopeTrigScale(): int32 =
    return 1073741824

fn ModelExecutorRopeInvFreqFill(out: var float64[], halfDim: int32, theta: float64): Result[bool] =
    if halfDim <= 0:
        return Err[bool]("model executor rope: inv freq halfDim")
    let lnTheta = mathlib.Ln(theta)
    for j in 0..<halfDim:
        let exponent = 0.0 - float64(2 * j) / float64(2 * halfDim)
        add(out, mathlib.Exp(exponent * lnTheta))
    return Ok[bool](true)

@borrows
fn ModelExecutorRopeCosSinRowFill(cosRow: var int32[], sinRow: var int32[],
                                  invFreq: float64[], position: int32): Result[bool] =
    let trigScaleF = float64(ModelExecutorRopeTrigScale())
    for j in 0..<invFreq.len:
        let angle = float64(position) * invFreq[j]
        add(cosRow, int32(int64(mathlib.Round(mathlib.Cos(angle) * trigScaleF))))
        add(sinRow, int32(int64(mathlib.Round(mathlib.Sin(angle) * trigScaleF))))
    return Ok[bool](true)

# Rotates the `dim`-wide column span [colStart, colStart+dim) of row `row`
# in `out` (already a plain copy of the pre-rotation input) in place.
@borrows
fn ModelExecutorRopeRotateSpan(out: var infer.TensorQ,
                               row: int32,
                               colStart: int32,
                               dim: int32,
                               cosRow: int32[],
                               sinRow: int32[]): Result[bool] =
    let halfDim = dim / 2
    if dim <= 0 || dim % 2 != 0 || cosRow.len < halfDim || sinRow.len < halfDim:
        return Err[bool]("model executor rope: rotate span shape")
    let trigScale = ModelExecutorRopeTrigScale()
    for j in 0..<halfDim:
        let idx1 = infer.TensorOffset2(out.shape, row, colStart + j)
        let idx2 = infer.TensorOffset2(out.shape, row, colStart + halfDim + j)
        let x1 = out.data[idx1]
        let x2 = out.data[idx2]
        let c = cosRow[j]
        let s = sinRow[j]
        let o1 = infer.InferenceSaturateI32(int64(infer.InferenceMulQ(x1, c, trigScale)) - int64(infer.InferenceMulQ(x2, s, trigScale)))
        let o2 = infer.InferenceSaturateI32(int64(infer.InferenceMulQ(x2, c, trigScale)) + int64(infer.InferenceMulQ(x1, s, trigScale)))
        out.data[idx1] = o1
        out.data[idx2] = o2
    return Ok[bool](true)

# Path A (GQA dense/MoE): position = kvInput's already-appended prefix
# length for this layer (PagedKVSequence.tokenCount, "next append position",
# per ModelExecutorPagedCausalAttentionFill's own use of the same field) if
# a kv cache carry-in is present, else 0 for a from-scratch prefill.
@borrows
fn ModelExecutorRopeBasePosition(kvInput: ModelExecutorKvStateSet,
                                 hasKvInput: bool,
                                 layerIndex: int32): Result[int32] =
    if !hasKvInput:
        return Ok[int32](0)
    let layerFound = ModelExecutorFindKvLayerStateIndex(kvInput, layerIndex)
    if IsErr(layerFound):
        return Err[int32](Error(layerFound))
    return Ok[int32](kvInput.layerStates[Value(layerFound)].seq.tokenCount)

# Rotates every attention head's headDim-wide slice of `q` and every kv
# head's headDim-wide slice of `k` (value is left untouched by RoPE).
@borrows
fn ModelExecutorRopeApplyQkFill(qOut: var infer.TensorQ,
                                kOut: var infer.TensorQ,
                                qIn: infer.TensorQ,
                                kIn: infer.TensorQ,
                                graph: model_graph.ModelGraph,
                                basePosition: int32): Result[bool] =
    if graph.headDim <= 0 || graph.headDim % 2 != 0:
        return Err[bool]("model executor rope qk: head dim")
    let copyQ = ModelExecutorTensorCopyFill(qOut, qIn)
    if IsErr(copyQ):
        return Err[bool](Error(copyQ))
    let copyK = ModelExecutorTensorCopyFill(kOut, kIn)
    if IsErr(copyK):
        return Err[bool](Error(copyK))
    var invFreq: float64[]
    let invFreqOk = ModelExecutorRopeInvFreqFill(invFreq, graph.headDim / 2, graph.ropeTheta)
    if IsErr(invFreqOk):
        return Err[bool](Error(invFreqOk))
    for row in 0..<qIn.shape[0]:
        var cosRow: int32[]
        var sinRow: int32[]
        let rowOk = ModelExecutorRopeCosSinRowFill(cosRow, sinRow, invFreq, basePosition + row)
        if IsErr(rowOk):
            return Err[bool](Error(rowOk))
        for head in 0..<graph.attentionHeads:
            let rotQ = ModelExecutorRopeRotateSpan(qOut, row, head * graph.headDim, graph.headDim, cosRow, sinRow)
            if IsErr(rotQ):
                return Err[bool](Error(rotQ))
        for head in 0..<graph.keyValueHeads:
            let rotK = ModelExecutorRopeRotateSpan(kOut, row, head * graph.headDim, graph.headDim, cosRow, sinRow)
            if IsErr(rotK):
                return Err[bool](Error(rotK))
    return Ok[bool](true)

# Path B (GLM MLA): rotates a single qkRopeHeadDim-wide column span shared
# across all heads (MLA's rope part is MQA-style: one shared k_pe/q_pe
# span). This audit path is prefill-only (no persisted kv cache anywhere in
# ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens), so position is simply
# the row's index within this forward call.
@borrows
fn ModelExecutorRopeApplySpanFill(out: var infer.TensorQ,
                                  input: infer.TensorQ,
                                  colStart: int32,
                                  ropeDim: int32,
                                  theta: float64): Result[bool] =
    if ropeDim <= 0 || ropeDim % 2 != 0:
        return Err[bool]("model executor rope span: dim")
    let copyOk = ModelExecutorTensorCopyFill(out, input)
    if IsErr(copyOk):
        return Err[bool](Error(copyOk))
    var invFreq: float64[]
    let invFreqOk = ModelExecutorRopeInvFreqFill(invFreq, ropeDim / 2, theta)
    if IsErr(invFreqOk):
        return Err[bool](Error(invFreqOk))
    for row in 0..<input.shape[0]:
        var cosRow: int32[]
        var sinRow: int32[]
        let rowOk = ModelExecutorRopeCosSinRowFill(cosRow, sinRow, invFreq, row)
        if IsErr(rowOk):
            return Err[bool](Error(rowOk))
        let rotOk = ModelExecutorRopeRotateSpan(out, row, colStart, ropeDim, cosRow, sinRow)
        if IsErr(rotOk):
            return Err[bool](Error(rotOk))
    return Ok[bool](true)

@borrows
fn ModelExecutorPagedCausalAttentionFill(out: var infer.TensorQ,
                                         graph: model_graph.ModelGraph,
                                         store: weight_store.WeightTensorStore,
                                         layerIndex: int32,
                                         query: infer.TensorQ,
                                         key: infer.TensorQ,
                                         value: infer.TensorQ,
                                         outWeight: weight_store.WeightTensorPayload,
                                         kvInput: ModelExecutorKvStateSet,
                                         hasKvInput: bool,
                                         kvOutput: var ModelExecutorKvLayerState[],
                                         captureKv: bool,
                                         receiptHash: var int64,
                                         metalCtx: var ModelExecutorMetalContext): Result[bool] =
    let queryOk = infer.TensorValidate(query)
    if IsErr(queryOk):
        return Err[bool](Error(queryOk))
    let keyOk = infer.TensorValidate(key)
    if IsErr(keyOk):
        return Err[bool](Error(keyOk))
    let valueOk = infer.TensorValidate(value)
    if IsErr(valueOk):
        return Err[bool](Error(valueOk))
    let kvRows = graph.keyValueHeads * graph.headDim
    if query.shape.len != 2 || query.shape[0] <= 0 || query.shape[1] != graph.hiddenSize ||
       key.shape.len != 2 || key.shape[0] != query.shape[0] || key.shape[1] != kvRows ||
       value.shape.len != 2 || value.shape[0] != query.shape[0] || value.shape[1] != kvRows:
        return Err[bool]("model executor paged attention: qkv shape")
    if query.scale != key.scale || key.scale != value.scale:
        return Err[bool]("model executor paged attention: scale")
    var cache: paged_kv_cache.PagedKVCache
    var seq: paged_kv_cache.PagedKVSequence
    if hasKvInput:
        let kvOk = ModelExecutorValidateKvStateSet(kvInput)
        if IsErr(kvOk):
            return Err[bool](Error(kvOk))
        let layerFound = ModelExecutorFindKvLayerStateIndex(kvInput, layerIndex)
        if IsErr(layerFound):
            return Err[bool](Error(layerFound))
        let cacheCopy = ModelExecutorClonePagedKvCache(kvInput.layerStates[Value(layerFound)].cache)
        if IsErr(cacheCopy):
            return Err[bool](Error(cacheCopy))
        cache = Value(cacheCopy)
        seq = ModelExecutorClonePagedKvSequence(kvInput.layerStates[Value(layerFound)].seq)
        if cache.tokensPerPage != 16 || cache.keyDim != kvRows || cache.valueDim != kvRows ||
           cache.keyScale != key.scale || cache.valueScale != value.scale:
            return Err[bool]("model executor paged attention: kv state shape")
    else:
        let cacheRes = paged_kv_cache.PagedKVInit(16, kvRows, kvRows, key.scale, value.scale)
        if IsErr(cacheRes):
            return Err[bool](Error(cacheRes))
        cache = Value(cacheRes)
        seq = paged_kv_cache.PagedKVSequenceInit(layerIndex + 1)
    let hiddenZeros = ModelExecutorTensorZerosValue([query.shape[0], graph.hiddenSize], value.scale)
    if IsErr(hiddenZeros):
        return Err[bool](Error(hiddenZeros))
    var hiddenOut = Value(hiddenZeros)
    for tokenIndex in 0..<query.shape[0]:
        var keyVector: infer.TensorQ
        let keyVectorOk = ModelExecutorTensorRowVectorFill(keyVector, key, tokenIndex)
        if IsErr(keyVectorOk):
            return Err[bool](Error(keyVectorOk))
        var valueVector: infer.TensorQ
        let valueVectorOk = ModelExecutorTensorRowVectorFill(valueVector, value, tokenIndex)
        if IsErr(valueVectorOk):
            return Err[bool](Error(valueVectorOk))
        let appendOk = paged_kv_cache.PagedKVAppendToken(cache, seq, keyVector, valueVector)
        if IsErr(appendOk):
            return Err[bool](Error(appendOk))
        var groupedOut: infer.TensorQ
        if metalCtx.enabled:
            # #155r-mgqa: Metal path now mirrors the CPU branch below --
            # every attention head gets its own independent
            # 1/sqrt(headDim)-scaled dot-product softmax over its own
            # kv-head's causal candidates (HF repeat_kv GQA semantics),
            # instead of one hardmax/softmax pick shared by a grouped
            # representative query. Reuses the unmodified #155/#155w MSL
            # fixed-point softmax helpers and cross-window online-softmax
            # two-pass protocol per head (keyDim/valueDim=headDim instead
            # of the full kvRows-wide concatenation) -- one Metal launch
            # per query head per token, exactly mirroring
            # PagedKVAttentionQueryFill's per-qh loop on GPU.
            if graph.attentionHeads <= 0 || graph.keyValueHeads <= 0 || graph.headDim <= 0 ||
               graph.attentionHeads % graph.keyValueHeads != 0 ||
               graph.attentionHeads * graph.headDim != graph.hiddenSize:
                return Err[bool]("model executor paged attention metal: graph")
            let repeat = graph.attentionHeads / graph.keyValueHeads
            var fullQueryVector: infer.TensorQ
            let fullQueryVectorOk = ModelExecutorTensorRowVectorFill(fullQueryVector, query, tokenIndex)
            if IsErr(fullQueryVectorOk):
                return Err[bool](Error(fullQueryVectorOk))
            var inputs: paged_kv_cache.PagedKVAttentionInputTensors
            let inputsOk = paged_kv_cache.PagedKVBuildAttentionInputTensorsFill(inputs, cache, seq)
            if IsErr(inputsOk):
                return Err[bool](Error(inputsOk))
            for qh in 0..<graph.attentionHeads:
                let kvHead = qh / repeat
                let queryBase = qh * graph.headDim
                let kvBase = kvHead * graph.headDim
                var queryVector: infer.TensorQ
                let queryVectorOk = ModelExecutorHeadVectorSliceFill(queryVector, fullQueryVector, graph.headDim, queryBase)
                if IsErr(queryVectorOk):
                    return Err[bool](Error(queryVectorOk))
                var headKeyPageTensors: infer.TensorQ[]
                var headValuePageTensors: infer.TensorQ[]
                for pageOrdinal in 0..<cache.pages.len:
                    let headKeyRes = paged_kv_cache.PagedKVBuildPageKeyHeadTensor(cache.pages[pageOrdinal], cache.tokensPerPage, cache.keyDim, graph.headDim, kvBase, cache.keyScale)
                    if IsErr(headKeyRes):
                        return Err[bool](Error(headKeyRes))
                    let headValueRes = paged_kv_cache.PagedKVBuildPageValueHeadTensor(cache.pages[pageOrdinal], cache.tokensPerPage, cache.valueDim, graph.headDim, kvBase, cache.valueScale)
                    if IsErr(headValueRes):
                        return Err[bool](Error(headValueRes))
                    add(headKeyPageTensors, Value(headKeyRes))
                    add(headValuePageTensors, Value(headValueRes))
                let pagedProgram = kernel_ir.KernelIrPagedAttentionProgram(
                    seq.tokenCount,
                    graph.headDim,
                    graph.headDim,
                    cache.tokensPerPage,
                    cache.pages.len,
                    seq.blockPageIds.len,
                    kernel_ir.KernelDtypeFp16,
                    queryVector.scale
                )
                let pagedProgramOk = kernel_ir.KernelIrValidateProgram(pagedProgram)
                if IsErr(pagedProgramOk):
                    return Err[bool](Error(pagedProgramOk))
                let attentionResult = paged_kv_cache.PagedKVDeviceMetalPagedAttentionTensorPageBuffersToBufferFill(
                    cache,
                    seq,
                    metalCtx.metal,
                    pagedProgram,
                    queryVector,
                    headKeyPageTensors,
                    headValuePageTensors,
                    inputs.pageTable,
                    kvBase
                )
                if IsErr(attentionResult):
                    return Err[bool](Error(attentionResult))
                var ownedAttention = Value(attentionResult)
                var headOut = ownedAttention.output
                let nextReceiptHash = ModelExecutorKernelReceiptHash(
                    metalCtx.receiptHash, ownedAttention.receipt)
                var attentionBuffer = ownedAttention.buffer
                let releaseAttentionOut = device.DeviceMetalReleaseBuffer(attentionBuffer)
                if IsErr(releaseAttentionOut):
                    return Err[bool](Error(releaseAttentionOut))
                if IsErr(nextReceiptHash):
                    return Err[bool](Error(nextReceiptHash))
                metalCtx.receiptHash = Value(nextReceiptHash)
                metalCtx.launchedKernels = metalCtx.launchedKernels + 1
                let writeOk = ModelExecutorWriteHeadValueToHiddenRow(hiddenOut, headOut, graph, tokenIndex, queryBase)
                if IsErr(writeOk):
                    return Err[bool](Error(writeOk))
        else:
            # CPU path: every attention head keeps its own query vector and
            # its own independent softmax distribution (HF repeat_kv GQA
            # semantics) -- heads sharing a kv-head group are NOT collapsed
            # into one distribution and broadcast.
            var fullQueryVector: infer.TensorQ
            let fullQueryVectorOk = ModelExecutorTensorRowVectorFill(fullQueryVector, query, tokenIndex)
            if IsErr(fullQueryVectorOk):
                return Err[bool](Error(fullQueryVectorOk))
            let attentionOk = paged_kv_cache.PagedKVAttentionQueryFill(groupedOut, cache, seq, fullQueryVector, graph.headDim, graph.attentionHeads)
            if IsErr(attentionOk):
                return Err[bool](Error(attentionOk))
            let writeOk = ModelExecutorWriteFullHeadsValueToHiddenRow(hiddenOut, groupedOut, graph, tokenIndex)
            if IsErr(writeOk):
                return Err[bool](Error(writeOk))
        let receipt = paged_kv_cache.PagedKVReceiptFor(seq)
        receiptHash = ModelExecutorHashStep(receiptHash, int64(receipt.seqId))
        receiptHash = ModelExecutorHashStep(receiptHash, int64(receipt.tokenCount))
        receiptHash = ModelExecutorHashStep(receiptHash, int64(receipt.pageCount))
        receiptHash = ModelExecutorHashStep(receiptHash, receipt.pageTableHash)
    if captureKv:
        let layerState = ModelExecutorKvLayerStateBuild(layerIndex, cache, seq)
        if IsErr(layerState):
            return Err[bool](Error(layerState))
        let putKv = ModelExecutorPutKvLayerState(kvOutput, Value(layerState))
        if IsErr(putKv):
            return Err[bool](Error(putKv))
    return ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, hiddenOut, store, outWeight, "attention_o", metalCtx)

@borrows
fn ModelExecutorEmbeddingFill(out: var infer.TensorQ,
                              tokenIds: infer.TensorQ,
                              embedding: infer.TensorQ): Result[bool] =
    let tokenOk = infer.TensorValidate(tokenIds)
    if IsErr(tokenOk):
        return Err[bool](Error(tokenOk))
    let embedOk = infer.TensorValidate(embedding)
    if IsErr(embedOk):
        return Err[bool](Error(embedOk))
    if tokenIds.shape.len != 1 || embedding.shape.len != 2:
        return Err[bool]("model executor embedding: shape")
    let tokenCount = tokenIds.shape[0]
    let vocab = embedding.shape[0]
    let hidden = embedding.shape[1]
    let zerosRes = infer.TensorZerosFill(out, [tokenCount, hidden], embedding.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for tokenIndex in 0..<tokenCount:
        let tokenId = tokenIds.data[tokenIndex]
        if tokenId < 0 || tokenId >= vocab:
            return Err[bool]("model executor embedding: token id")
        for hiddenIndex in 0..<hidden:
            out.data[infer.TensorOffset2(out.shape, tokenIndex, hiddenIndex)] =
                embedding.data[infer.TensorOffset2(embedding.shape, tokenId, hiddenIndex)]
    return Ok[bool](true)

@borrows
fn ModelExecutorRmsNormRowsFill(out: var infer.TensorQ,
                                input: infer.TensorQ,
                                weight: infer.TensorQ,
                                epsilonScale: int32): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    let weightOk = infer.TensorValidate(weight)
    if IsErr(weightOk):
        return Err[bool](Error(weightOk))
    if input.shape.len != 2 || weight.shape.len != 1 || input.shape[1] != weight.shape[0]:
        return Err[bool]("model executor rmsnorm: shape")
    if input.scale != weight.scale:
        return Err[bool]("model executor rmsnorm: scale")
    let zerosRes = infer.TensorZerosFill(out, input.shape, input.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    let tokenCount = input.shape[0]
    let hidden = input.shape[1]
    for tokenIndex in 0..<tokenCount:
        var squareSum: int64
        for hiddenIndex in 0..<hidden:
            let value = input.data[infer.TensorOffset2(input.shape, tokenIndex, hiddenIndex)]
            squareSum = squareSum + int64(value) * int64(value)
        let meanSquare = squareSum / int64(hidden)
        var normBase = infer.InferenceIntSqrt(meanSquare + int64(epsilonScale))
        if normBase <= int64(0):
            normBase = int64(1)
        for hiddenIndex in 0..<hidden:
            let inputValue = input.data[infer.TensorOffset2(input.shape, tokenIndex, hiddenIndex)]
            let weightValue = weight.data[hiddenIndex]
            let weighted = int64(inputValue) * int64(weightValue)
            out.data[infer.TensorOffset2(out.shape, tokenIndex, hiddenIndex)] =
                infer.InferenceSaturateI32(weighted / normBase)
    return Ok[bool](true)

@borrows
fn ModelExecutorRowDot(input: infer.TensorQ, leftRow: int32, rightRow: int32): int64 =
    var sum: int64
    let hidden = input.shape[1]
    for hiddenIndex in 0..<hidden:
        let left = input.data[infer.TensorOffset2(input.shape, leftRow, hiddenIndex)]
        let right = input.data[infer.TensorOffset2(input.shape, rightRow, hiddenIndex)]
        sum = sum + int64(left) * int64(right)
    return sum

@borrows
fn ModelExecutorTinyAttentionFill(out: var infer.TensorQ,
                                  input: infer.TensorQ): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    if input.shape.len != 2:
        return Err[bool]("model executor attention: shape")
    if input.scale <= 0:
        return Err[bool]("model executor attention: scale")
    let zerosRes = infer.TensorZerosFill(out, input.shape, input.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    let tokenCount = input.shape[0]
    let hidden = input.shape[1]
    for tokenIndex in 0..<tokenCount:
        var scores: int32[]
        var maxScore: int32
        for candidate in 0..<tokenIndex + 1:
            let score = infer.InferenceSaturateI32(infer.InferenceRoundDivI64(ModelExecutorRowDot(input, tokenIndex, candidate), int64(input.scale)))
            if candidate == 0 || score > maxScore:
                maxScore = score
            add(scores, score)
        var weights: int32[]
        var denom: int64
        for i in 0..<scores.len:
            let weight = infer.InferenceExpNegQ(scores[i] - maxScore, input.scale, infer.InferenceSoftmaxInternalScale)
            add(weights, weight)
            denom = denom + int64(weight)
        if denom <= int64(0):
            return Err[bool]("model executor attention: denom")
        for hiddenIndex in 0..<hidden:
            var numer: int64
            for candidate in 0..<tokenIndex + 1:
                let value = input.data[infer.TensorOffset2(input.shape, candidate, hiddenIndex)]
                numer = numer + int64(value) * int64(weights[candidate])
            out.data[infer.TensorOffset2(out.shape, tokenIndex, hiddenIndex)] =
                infer.InferenceSaturateI32(infer.InferenceRoundDivI64(numer, denom))
    return Ok[bool](true)

@borrows
fn ModelExecutorMatMulFill(out: var infer.TensorQ,
                           left: infer.TensorQ,
                           right: infer.TensorQ,
                           label: str): Result[bool] =
    let res = infer.MatMul2dFill(out, left, right)
    if IsErr(res):
        return Err[bool](strutil.Join(["model executor ", share(label), ": ", Error(res)], ""))
    return Ok[bool](true)

@borrows
fn ModelExecutorAddBiasRows(out: var infer.TensorQ, bias: infer.TensorQ): Result[bool] =
    let outOk = infer.TensorValidate(out)
    if IsErr(outOk):
        return Err[bool](Error(outOk))
    let biasOk = infer.TensorValidate(bias)
    if IsErr(biasOk):
        return Err[bool](Error(biasOk))
    if out.shape.len != 2:
        return Err[bool]("model executor add bias: out rank")
    let rows = out.shape[0]
    let outFeatures = out.shape[1]
    if bias.shape.len != 1 || bias.shape[0] != outFeatures:
        return Err[bool]("model executor add bias: bias shape")
    if bias.scale != out.scale:
        return Err[bool]("model executor add bias: bias scale")
    for row in 0..<rows:
        for f in 0..<outFeatures:
            let off = infer.TensorOffset2(out.shape, row, f)
            out.data[off] = infer.InferenceSaturateI32(int64(out.data[off]) + int64(bias.data[f]))
    return Ok[bool](true)

@borrows
fn ModelExecutorLinearOutInWeightFill(out: var infer.TensorQ,
                                      input: infer.TensorQ,
                                      weight: infer.TensorQ,
                                      label: str): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    let weightOk = infer.TensorValidate(weight)
    if IsErr(weightOk):
        return Err[bool](Error(weightOk))
    if input.scale != weight.scale:
        return Err[bool](strutil.Join(["model executor ", share(label), ": scale"], ""))
    if input.shape.len != 2 || weight.shape.len != 2:
        return Err[bool](strutil.Join(["model executor ", share(label), ": rank"], ""))
    if input.shape[1] != weight.shape[1]:
        return Err[bool](strutil.Join(["model executor ", share(label), ": inner dim"], ""))
    let rows = input.shape[0]
    let outFeatures = weight.shape[0]
    let inFeatures = weight.shape[1]
    let zerosRes = infer.TensorZerosFill(out, [rows, outFeatures], input.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for row in 0..<rows:
        for outFeature in 0..<outFeatures:
            var sum: int64
            sum = int64(0)
            for inFeature in 0..<inFeatures:
                let product = int64(input.data[infer.TensorOffset2(input.shape, row, inFeature)]) *
                              int64(weight.data[infer.TensorOffset2(weight.shape, outFeature, inFeature)])
                sum = sum + product
            out.data[infer.TensorOffset2(out.shape, row, outFeature)] = infer.InferenceSaturateI32(infer.InferenceRoundDivI64(sum, int64(input.scale)))
    return Ok[bool](true)

@borrows
fn ModelExecutorLinearOutInPackedInt4WeightFill(out: var infer.TensorQ,
                                                input: infer.TensorQ,
                                                payload: weight_store.WeightTensorPayload,
                                                label: str): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    let payloadOk = weight_store.WeightTensorPayloadValidate(payload)
    if IsErr(payloadOk):
        return Err[bool](Error(payloadOk))
    if !payload.hasPackedInt4:
        return Err[bool](strutil.Join(["model executor ", share(label), ": packed int4 missing"], ""))
    if input.scale != payload.packedInt4.scale:
        return Err[bool](strutil.Join(["model executor ", share(label), ": scale"], ""))
    if input.shape.len != 2 || payload.packedInt4.shape.len != 2:
        return Err[bool](strutil.Join(["model executor ", share(label), ": rank"], ""))
    if input.shape[1] != payload.packedInt4.shape[1]:
        return Err[bool](strutil.Join(["model executor ", share(label), ": inner dim"], ""))
    let rows = input.shape[0]
    let outFeatures = payload.packedInt4.shape[0]
    let inFeatures = payload.packedInt4.shape[1]
    let zerosRes = infer.TensorZerosFill(out, [rows, outFeatures], input.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for row in 0..<rows:
        for outFeature in 0..<outFeatures:
            var sum: int64
            sum = int64(0)
            for inFeature in 0..<inFeatures:
                let weightIndex = outFeature * inFeatures + inFeature
                let product = int64(input.data[infer.TensorOffset2(input.shape, row, inFeature)]) *
                              int64(kernel_ir.KernelIrPackedInt4ValueAtUnchecked(payload.packedInt4, weightIndex))
                sum = sum + infer.InferenceRoundDivI64(product, int64(input.scale))
            out.data[infer.TensorOffset2(out.shape, row, outFeature)] = infer.InferenceSaturateI32(sum)
    return Ok[bool](true)

@borrows
fn ModelExecutorLinearOutInW4Afp8TensorFill(out: var infer.TensorQ,
                                            input: infer.TensorQ,
                                            weightPayload: weight_store.WeightTensorPayload,
                                            weightScaleInv: infer.TensorQ,
                                            inputScale: infer.TensorQ,
                                            label: str): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    let weightOk = weight_store.WeightTensorPayloadValidate(weightPayload)
    if IsErr(weightOk):
        return Err[bool](Error(weightOk))
    let weightScaleOk = infer.TensorValidate(weightScaleInv)
    if IsErr(weightScaleOk):
        return Err[bool](Error(weightScaleOk))
    let inputScaleOk = infer.TensorValidate(inputScale)
    if IsErr(inputScaleOk):
        return Err[bool](Error(inputScaleOk))
    if !weightPayload.hasW4Afp8Raw ||
       weightPayload.dtype != kernel_ir.KernelDtypeInt8 ||
       weightPayload.quantScheme != model_graph.ModelQuantSchemeW4Afp8:
        return Err[bool](strutil.Join(["model executor ", share(label), ": w4afp8 raw weight"], ""))
    var ownedShape: int32[]
    ownedShape = []
    for si in 0..<weightPayload.tensor.shape.len:
        add(ownedShape, weightPayload.tensor.shape[si])
    let rawWeight = kernel_ir.KernelW4Afp8Tensor(
        shape: ownedShape,
        scale: weightPayload.tensor.scale,
        rawI8: rawbytes.BytesSlice(weightPayload.w4Afp8Raw, 0, rawbytes.BytesLen(weightPayload.w4Afp8Raw))
    )
    let fillOk = kernel_ir.KernelIrLinearOutInW4Afp8WeightCpuFill(
        out,
        input,
        rawWeight,
        weightScaleInv,
        inputScale
    )
    if IsErr(fillOk):
        return Err[bool](strutil.Join(["model executor ", share(label), ": ", Error(fillOk)], ""))
    return Ok[bool](true)

@borrows
fn ModelExecutorLinearOutInW4Afp8PayloadFill(out: var infer.TensorQ,
                                             input: infer.TensorQ,
                                             weightPayload: weight_store.WeightTensorPayload,
                                             weightScaleInvPayload: weight_store.WeightTensorPayload,
                                             inputScalePayload: weight_store.WeightTensorPayload,
                                             label: str): Result[bool] =
    let weightScaleOk = weight_store.WeightTensorPayloadValidate(weightScaleInvPayload)
    if IsErr(weightScaleOk):
        return Err[bool](Error(weightScaleOk))
    let inputScaleOk = weight_store.WeightTensorPayloadValidate(inputScalePayload)
    if IsErr(inputScaleOk):
        return Err[bool](Error(inputScaleOk))
    if weightScaleInvPayload.dtype != kernel_ir.KernelDtypeFp8E4M3 ||
       weightScaleInvPayload.quantScheme != model_graph.ModelQuantSchemeNone:
        return Err[bool](strutil.Join(["model executor ", share(label), ": w4afp8 weight scale"], ""))
    if inputScalePayload.dtype != kernel_ir.KernelDtypeFp8E4M3 ||
       inputScalePayload.quantScheme != model_graph.ModelQuantSchemeNone:
        return Err[bool](strutil.Join(["model executor ", share(label), ": w4afp8 input scale"], ""))
    return ModelExecutorLinearOutInW4Afp8TensorFill(out,
                                                   input,
                                                   weightPayload,
                                                   weightScaleInvPayload.tensor,
                                                   inputScalePayload.tensor,
                                                   label)

@borrows
fn ModelExecutorLinearOutInW4Afp8TensorMaybeMetalFill(out: var infer.TensorQ,
                                                      input: infer.TensorQ,
                                                      weightPayload: weight_store.WeightTensorPayload,
                                                      weightScaleInv: infer.TensorQ,
                                                      inputScale: infer.TensorQ,
                                                      label: str,
                                                      metalCtx: var ModelExecutorMetalContext): Result[bool] =
    if !metalCtx.enabled:
        return ModelExecutorLinearOutInW4Afp8TensorFill(out, input, weightPayload, weightScaleInv, inputScale, label)
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    let weightOk = weight_store.WeightTensorPayloadValidate(weightPayload)
    if IsErr(weightOk):
        return Err[bool](Error(weightOk))
    let weightScaleOk = infer.TensorValidate(weightScaleInv)
    if IsErr(weightScaleOk):
        return Err[bool](Error(weightScaleOk))
    let inputScaleOk = infer.TensorValidate(inputScale)
    if IsErr(inputScaleOk):
        return Err[bool](Error(inputScaleOk))
    if !weightPayload.hasW4Afp8Raw ||
       weightPayload.dtype != kernel_ir.KernelDtypeInt8 ||
       weightPayload.quantScheme != model_graph.ModelQuantSchemeW4Afp8:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": w4afp8 raw weight"], ""))
    if input.shape.len != 2 || weightPayload.tensor.shape.len != 2:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": rank"], ""))
    if input.shape[1] != weightPayload.tensor.shape[1]:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": inner dim"], ""))
    let outChannels = weightPayload.tensor.shape[0]
    let weightTensorScale = weightPayload.tensor.scale
    var ownedShapeM: int32[]
    ownedShapeM = []
    for si in 0..<weightPayload.tensor.shape.len:
        add(ownedShapeM, weightPayload.tensor.shape[si])
    var wScaleShapeOwned: int32[]
    wScaleShapeOwned = []
    for si in 0..<weightScaleInv.shape.len:
        add(wScaleShapeOwned, weightScaleInv.shape[si])
    var iScaleShapeOwned: int32[]
    iScaleShapeOwned = []
    for si in 0..<inputScale.shape.len:
        add(iScaleShapeOwned, inputScale.shape[si])
    let rawWeight = kernel_ir.KernelW4Afp8Tensor(
        shape: ownedShapeM,
        scale: weightTensorScale,
        rawI8: rawbytes.BytesSlice(weightPayload.w4Afp8Raw, 0, rawbytes.BytesLen(weightPayload.w4Afp8Raw))
    )
    let program = kernel_ir.KernelIrLinearOutInW4Afp8WeightProgramWithScaleShapes(
        input.shape[0],
        outChannels,
        input.shape[1],
        kernel_ir.KernelDtypeFp16,
        input.scale,
        weightTensorScale,
        wScaleShapeOwned,
        iScaleShapeOwned,
        weightScaleInv.scale
    )
    let inputLoad = device.DeviceMetalLoadTensorI32Buffer(metalCtx.metal, input)
    if IsErr(inputLoad):
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(inputLoad)], ""))
    let weightLoad = device.DeviceMetalLoadRawTensorBytesBuffer(
        metalCtx.metal,
        kernel_ir.KernelDtypeInt8,
        rawWeight.shape,
        rawWeight.scale,
        rawWeight.rawI8
    )
    if IsErr(weightLoad):
        let _releaseInputOnWeightLoadFail = device.DeviceMetalReleaseBuffer(Value(inputLoad).buffer)
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(weightLoad)], ""))
    let weightScaleLoad = device.DeviceMetalLoadTensorI32Buffer(metalCtx.metal, weightScaleInv)
    if IsErr(weightScaleLoad):
        let _releaseInputOnScaleLoadFail = device.DeviceMetalReleaseBuffer(Value(inputLoad).buffer)
        let _releaseWeightOnScaleLoadFail = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(weightScaleLoad)], ""))
    let inputScaleLoad = device.DeviceMetalLoadTensorI32Buffer(metalCtx.metal, inputScale)
    if IsErr(inputScaleLoad):
        let _releaseInputOnInputScaleLoadFail = device.DeviceMetalReleaseBuffer(Value(inputLoad).buffer)
        let _releaseWeightOnInputScaleLoadFail = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
        let _releaseWeightScaleOnInputScaleLoadFail = device.DeviceMetalReleaseBuffer(Value(weightScaleLoad).buffer)
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(inputScaleLoad)], ""))
    let receipt = device.DeviceMetalLinearOutInW4Afp8TensorRawWeightScaleBuffersFill(
        out,
        metalCtx.metal,
        program,
        Value(inputLoad).buffer,
        Value(inputLoad).receipt,
        Value(weightLoad).buffer,
        Value(weightLoad).receipt,
        Value(weightScaleLoad).buffer,
        Value(weightScaleLoad).receipt,
        Value(inputScaleLoad).buffer,
        Value(inputScaleLoad).receipt
    )
    let releaseInput = device.DeviceMetalReleaseBuffer(Value(inputLoad).buffer)
    let releaseWeight = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
    let releaseWeightScale = device.DeviceMetalReleaseBuffer(Value(weightScaleLoad).buffer)
    let releaseInputScale = device.DeviceMetalReleaseBuffer(Value(inputScaleLoad).buffer)
    if IsErr(receipt):
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(receipt)], ""))
    let nextHash = ModelExecutorKernelReceiptHash(metalCtx.receiptHash, Value(receipt))
    if IsErr(nextHash):
        return Err[bool](Error(nextHash))
    if IsErr(releaseInput):
        return Err[bool](Error(releaseInput))
    if IsErr(releaseWeight):
        return Err[bool](Error(releaseWeight))
    if IsErr(releaseWeightScale):
        return Err[bool](Error(releaseWeightScale))
    if IsErr(releaseInputScale):
        return Err[bool](Error(releaseInputScale))
    metalCtx.receiptHash = Value(nextHash)
    metalCtx.launchedKernels = metalCtx.launchedKernels + 1
    return Ok[bool](true)

@borrows
fn ModelExecutorLinearOutInW4Afp8PayloadMaybeMetalFill(out: var infer.TensorQ,
                                                       input: infer.TensorQ,
                                                       weightPayload: weight_store.WeightTensorPayload,
                                                       weightScaleInvPayload: weight_store.WeightTensorPayload,
                                                       inputScalePayload: weight_store.WeightTensorPayload,
                                                       label: str,
                                                       metalCtx: var ModelExecutorMetalContext): Result[bool] =
    let weightScaleOk = weight_store.WeightTensorPayloadValidate(weightScaleInvPayload)
    if IsErr(weightScaleOk):
        return Err[bool](Error(weightScaleOk))
    let inputScaleOk = weight_store.WeightTensorPayloadValidate(inputScalePayload)
    if IsErr(inputScaleOk):
        return Err[bool](Error(inputScaleOk))
    if weightScaleInvPayload.dtype != kernel_ir.KernelDtypeFp8E4M3 ||
       weightScaleInvPayload.quantScheme != model_graph.ModelQuantSchemeNone:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": w4afp8 weight scale"], ""))
    if inputScalePayload.dtype != kernel_ir.KernelDtypeFp8E4M3 ||
       inputScalePayload.quantScheme != model_graph.ModelQuantSchemeNone:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": w4afp8 input scale"], ""))
    return ModelExecutorLinearOutInW4Afp8TensorMaybeMetalFill(out,
                                                             input,
                                                             weightPayload,
                                                             weightScaleInvPayload.tensor,
                                                             inputScalePayload.tensor,
                                                             label,
                                                             metalCtx)

@borrows
fn ModelExecutorW4Afp8IdentityInputScale(input: infer.TensorQ): Result[infer.TensorQ] =
    if input.scale <= 0:
        return Err[infer.TensorQ]("model executor w4afp8 identity input scale: scale")
    var out: infer.TensorQ
    var shape: int32[]
    add(shape, 1)
    out.shape = shape
    out.scale = input.scale
    var data: int32[]
    add(data, input.scale)
    out.data = data
    return Ok[infer.TensorQ](out)

@borrows
fn ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out: var infer.TensorQ,
                                                      input: infer.TensorQ,
                                                      store: weight_store.WeightTensorStore,
                                                      payload: weight_store.WeightTensorPayload,
                                                      label: str,
                                                      metalCtx: var ModelExecutorMetalContext): Result[bool] =
    if !payload.hasW4Afp8Raw:
        return ModelExecutorLinearOutInPayloadMaybeMetalFill(out, input, payload, label, metalCtx)
    let scaleName = weight_store.WeightSafetensorsW4Afp8ScaleTensorName(payload.tensorName)
    if IsErr(scaleName):
        return Err[bool](Error(scaleName))
    let weightScalePayload = ModelExecutorFindWeightPayload(store, Value(scaleName))
    if IsErr(weightScalePayload):
        return Err[bool](strutil.Join(["model executor ", share(label), ": missing w4afp8 weight scale ", share(Value(scaleName))], ""))
    let weightScalePayloadOk = weight_store.WeightTensorPayloadValidate(Value(weightScalePayload))
    if IsErr(weightScalePayloadOk):
        return Err[bool](Error(weightScalePayloadOk))
    let inputScaleName = weight_store.WeightSafetensorsW4Afp8InputScaleTensorName(payload.tensorName)
    if IsErr(inputScaleName):
        return Err[bool](Error(inputScaleName))
    let inputScaleIndex = ModelExecutorFindWeightPayloadOptionalIndex(store, Value(inputScaleName))
    if IsErr(inputScaleIndex):
        return Err[bool](Error(inputScaleIndex))
    if Value(inputScaleIndex) >= 0:
        return ModelExecutorLinearOutInW4Afp8PayloadMaybeMetalFill(out,
                                                                  input,
                                                                  payload,
                                                                  Value(weightScalePayload),
                                                                  store.payloads[Value(inputScaleIndex)],
                                                                  label,
                                                                  metalCtx)
    if Value(weightScalePayload).dtype != kernel_ir.KernelDtypeFp8E4M3 ||
       Value(weightScalePayload).quantScheme != model_graph.ModelQuantSchemeNone:
        return Err[bool](strutil.Join(["model executor ", share(label), ": w4afp8 weight scale"], ""))
    let identityScale = ModelExecutorW4Afp8IdentityInputScale(input)
    if IsErr(identityScale):
        return Err[bool](Error(identityScale))
    return ModelExecutorLinearOutInW4Afp8TensorMaybeMetalFill(out,
                                                             input,
                                                             payload,
                                                             Value(weightScalePayload).tensor,
                                                             Value(identityScale),
                                                             label,
                                                             metalCtx)

@borrows
fn ModelExecutorLinearOutInPayloadFill(out: var infer.TensorQ,
                                       input: infer.TensorQ,
                                       payload: weight_store.WeightTensorPayload,
                                       label: str): Result[bool] =
    if payload.hasPackedInt4:
        return ModelExecutorLinearOutInPackedInt4WeightFill(out, input, payload, label)
    if payload.hasW4Afp8Raw:
        return Err[bool](strutil.Join(["model executor ", share(label), ": w4afp8 scale companions required"], ""))
    return ModelExecutorLinearOutInWeightFill(out, input, payload.tensor, label)

@borrows
fn ModelExecutorLinearOutInPayloadMaybeMetalFill(out: var infer.TensorQ,
                                                 input: infer.TensorQ,
                                                 payload: weight_store.WeightTensorPayload,
                                                 label: str,
                                                 metalCtx: var ModelExecutorMetalContext): Result[bool] =
    if !metalCtx.enabled:
        return ModelExecutorLinearOutInPayloadFill(out, input, payload, label)
    if !payload.hasPackedInt4:
        if metalCtx.requirePackedInt4Linear && payload.dtype == kernel_ir.KernelDtypeInt4:
            return Err[bool](strutil.Join(["model executor metal ", share(label), ": int4 packed facts missing"], ""))
        return ModelExecutorLinearOutInPayloadFill(out, input, payload, label)
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    let payloadOk = weight_store.WeightTensorPayloadValidate(payload)
    if IsErr(payloadOk):
        return Err[bool](Error(payloadOk))
    if input.shape.len != 2 || payload.packedInt4.shape.len != 2:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": rank"], ""))
    if input.shape[1] != payload.packedInt4.shape[1]:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": inner dim"], ""))
    if input.scale != payload.packedInt4.scale:
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": scale"], ""))
    let program = kernel_ir.KernelIrLinearOutInInt4WeightProgram(
        input.shape[0],
        payload.packedInt4.shape[0],
        input.shape[1],
        kernel_ir.KernelDtypeFp16,
        input.scale,
        payload.packedInt4.scale
    )
    let inputLoad = device.DeviceMetalLoadTensorI32Buffer(metalCtx.metal, input)
    if IsErr(inputLoad):
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(inputLoad)], ""))
    let weightLoad = device.DeviceMetalLoadRawTensorBytesBuffer(
        metalCtx.metal,
        kernel_ir.KernelDtypeInt4,
        payload.packedInt4.shape,
        payload.packedInt4.scale,
        payload.packedInt4.packed
    )
    if IsErr(weightLoad):
        let _releaseInputOnWeightLoadFail = device.DeviceMetalReleaseBuffer(Value(inputLoad).buffer)
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(weightLoad)], ""))
    let receipt = device.DeviceMetalLinearOutInInt4WeightBuffersFill(
        out,
        metalCtx.metal,
        program,
        Value(inputLoad).buffer,
        Value(inputLoad).receipt,
        Value(weightLoad).buffer,
        Value(weightLoad).receipt
    )
    let releaseInput = device.DeviceMetalReleaseBuffer(Value(inputLoad).buffer)
    let releaseWeight = device.DeviceMetalReleaseBuffer(Value(weightLoad).buffer)
    if IsErr(receipt):
        return Err[bool](strutil.Join(["model executor metal ", share(label), ": ", Error(receipt)], ""))
    let nextHash = ModelExecutorKernelReceiptHash(metalCtx.receiptHash, Value(receipt))
    if IsErr(nextHash):
        return Err[bool](Error(nextHash))
    if IsErr(releaseInput):
        return Err[bool](Error(releaseInput))
    if IsErr(releaseWeight):
        return Err[bool](Error(releaseWeight))
    metalCtx.receiptHash = Value(nextHash)
    metalCtx.launchedKernels = metalCtx.launchedKernels + 1
    return Ok[bool](true)

@borrows
fn ModelExecutorResidualAddFill(out: var infer.TensorQ,
                                left: infer.TensorQ,
                                right: infer.TensorQ): Result[bool] =
    let leftOk = infer.TensorValidate(left)
    if IsErr(leftOk):
        return Err[bool](Error(leftOk))
    let rightOk = infer.TensorValidate(right)
    if IsErr(rightOk):
        return Err[bool](Error(rightOk))
    if left.scale != right.scale || left.shape.len != right.shape.len:
        return Err[bool]("model executor residual: shape")
    for i in 0..<left.shape.len:
        if left.shape[i] != right.shape[i]:
            return Err[bool]("model executor residual: dim")
    let zerosRes = infer.TensorZerosFill(out, left.shape, left.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for i in 0..<left.data.len:
        out.data[i] = infer.InferenceSaturateI32(int64(left.data[i]) + int64(right.data[i]))
    return Ok[bool](true)

fn ModelExecutorSigmoidQ(value: int32, scale: int32): Result[int32] =
    if scale <= 0:
        return Err[int32]("model executor sigmoid: scale")
    var expTerm: int32
    if value >= 0:
        expTerm = infer.InferenceExpNegQ(0 - value, scale, scale)
        let denom = int64(scale) + int64(expTerm)
        if denom <= int64(0):
            return Err[int32]("model executor sigmoid: denominator")
        return Ok[int32](infer.InferenceSaturateI32(infer.InferenceRoundDivI64(int64(scale) * int64(scale), denom)))
    expTerm = infer.InferenceExpNegQ(value, scale, scale)
    let denom = int64(scale) + int64(expTerm)
    if denom <= int64(0):
        return Err[int32]("model executor sigmoid: denominator")
    return Ok[int32](infer.InferenceSaturateI32(infer.InferenceRoundDivI64(int64(expTerm) * int64(scale), denom)))

@borrows
fn ModelExecutorSwiGluFill(out: var infer.TensorQ,
                           gate: infer.TensorQ,
                           up: infer.TensorQ): Result[bool] =
    let gateOk = infer.TensorValidate(gate)
    if IsErr(gateOk):
        return Err[bool](Error(gateOk))
    let upOk = infer.TensorValidate(up)
    if IsErr(upOk):
        return Err[bool](Error(upOk))
    if gate.scale != up.scale || gate.shape.len != up.shape.len:
        return Err[bool]("model executor swiglu: shape")
    for i in 0..<gate.shape.len:
        if gate.shape[i] != up.shape[i]:
            return Err[bool]("model executor swiglu: dim")
    let zerosRes = infer.TensorZerosFill(out, gate.shape, gate.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for i in 0..<gate.data.len:
        let sigmoid = ModelExecutorSigmoidQ(gate.data[i], gate.scale)
        if IsErr(sigmoid):
            return Err[bool](Error(sigmoid))
        let silu = infer.InferenceSaturateI32(
            infer.InferenceRoundDivI64(int64(gate.data[i]) * int64(Value(sigmoid)), int64(gate.scale))
        )
        out.data[i] = infer.InferenceSaturateI32(
            infer.InferenceRoundDivI64(int64(silu) * int64(up.data[i]), int64(gate.scale))
        )
    return Ok[bool](true)

fn ModelExecutorSoftmax2Combine(a: int32, b: int32, scoreA: int32, scoreB: int32, scale: int32): Result[int32] =
    if scale <= 0:
        return Err[int32]("model executor combine: scale")
    var maxScore = scoreA
    if scoreB > maxScore:
        maxScore = scoreB
    let weightA = infer.InferenceExpNegQ(scoreA - maxScore, scale, infer.InferenceSoftmaxInternalScale)
    let weightB = infer.InferenceExpNegQ(scoreB - maxScore, scale, infer.InferenceSoftmaxInternalScale)
    let denom = int64(weightA) + int64(weightB)
    if denom <= int64(0):
        return Err[int32]("model executor combine: denominator")
    let numer = int64(a) * int64(weightA) + int64(b) * int64(weightB)
    return Ok[int32](infer.InferenceSaturateI32(infer.InferenceRoundDivI64(numer, denom)))

@borrows
fn ModelExecutorCombineExpertSetFill(out: var infer.TensorQ,
                                     routePlan: moe_router.MoeRoutePlan,
                                     experts: infer.TensorQ[]): Result[bool] =
    let routeOk = moe_router.MoeValidateRoutePlan(routePlan)
    if IsErr(routeOk):
        return Err[bool](Error(routeOk))
    if experts.len != routePlan.expertCount:
        return Err[bool]("model executor combine set: expert count")
    if experts.len <= 0:
        return Err[bool]("model executor combine set: empty")
    let firstOk = infer.TensorValidate(experts[0])
    if IsErr(firstOk):
        return Err[bool](Error(firstOk))
    if experts[0].shape.len != 2 || experts[0].shape[0] != routePlan.tokenCount:
        return Err[bool]("model executor combine set: shape")
    for i in 1..<experts.len:
        let expertOk = infer.TensorValidate(experts[i])
        if IsErr(expertOk):
            return Err[bool](Error(expertOk))
        if experts[i].scale != experts[0].scale || experts[i].shape.len != 2 ||
           experts[i].shape[0] != experts[0].shape[0] || experts[i].shape[1] != experts[0].shape[1]:
            return Err[bool]("model executor combine set: expert shape")
    let zerosRes = infer.TensorZerosFill(out, experts[0].shape, experts[0].scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    let hidden = experts[0].shape[1]
    for tokenIndex in 0..<routePlan.tokenCount:
        let choice = routePlan.choices[tokenIndex]
        if choice.expert0 < 0 || choice.expert0 >= experts.len ||
           choice.expert1 < 0 || choice.expert1 >= experts.len:
            return Err[bool]("model executor combine set: expert id")
        for hiddenIndex in 0..<hidden:
            let a = experts[choice.expert0].data[infer.TensorOffset2(experts[choice.expert0].shape, tokenIndex, hiddenIndex)]
            let b = experts[choice.expert1].data[infer.TensorOffset2(experts[choice.expert1].shape, tokenIndex, hiddenIndex)]
            let combined = ModelExecutorSoftmax2Combine(a, b, choice.score0, choice.score1, experts[0].scale)
            if IsErr(combined):
                return Err[bool](Error(combined))
            out.data[infer.TensorOffset2(out.shape, tokenIndex, hiddenIndex)] = Value(combined)
    return Ok[bool](true)

@borrows
fn ModelExecutorHfWeightExecutionSupported(weight: model_graph.ModelWeightShard): bool =
    if weight.quantScheme == model_graph.ModelQuantSchemeNone:
        return weight.dtype == kernel_ir.KernelDtypeFp16 ||
               weight.dtype == kernel_ir.KernelDtypeBf16 ||
               (weight.dtype == kernel_ir.KernelDtypeFp8E4M3 &&
                (strutil.Contains(weight.tensorName, "_scale_inv") ||
                 strutil.Contains(weight.tensorName, "input_scale")))
    if weight.dtype == kernel_ir.KernelDtypeInt8 &&
       weight.quantScheme == model_graph.ModelQuantSchemeSymmetricInt8:
        return true
    if weight.dtype == kernel_ir.KernelDtypeInt4 &&
       weight.quantScheme == model_graph.ModelQuantSchemeSymmetricInt4:
        return true
    if weight.dtype == kernel_ir.KernelDtypeInt8 &&
       weight.quantScheme == model_graph.ModelQuantSchemeW4Afp8:
        return true
    return false

@borrows
fn ModelExecutorValidateHfGlmMoeTokensGraph(graph: model_graph.ModelGraph,
                                            bindings: weight_binding.WeightBindingSet,
                                            store: weight_store.WeightTensorStore,
                                            tokenIds: infer.TensorQ): Result[bool] =
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    if graph.architecture != "hf_glm_moe":
        return Err[bool]("model executor hf glm moe: unsupported architecture")
    if graph.topK != 2 || graph.expertCount < 2:
        return Err[bool]("model executor hf glm moe: router config")
    let tokenOk = infer.TensorValidate(tokenIds)
    if IsErr(tokenOk):
        return Err[bool](Error(tokenOk))
    if tokenIds.shape.len != 1 || tokenIds.shape[0] <= 0:
        return Err[bool]("model executor hf glm moe: token shape")
    let storeOk = weight_store.WeightTensorValidateStore(store, bindings, graph)
    if IsErr(storeOk):
        return Err[bool](Error(storeOk))
    for i in 0..<graph.weights.len:
        if !ModelExecutorHfWeightExecutionSupported(graph.weights[i]):
            return Err[bool]("model executor hf glm moe: unsupported weight execution format")
    return Ok[bool](true)

@borrows
fn ModelExecutorValidateDenseTransformerGraph(graph: model_graph.ModelGraph,
                                              bindings: weight_binding.WeightBindingSet,
                                              store: weight_store.WeightTensorStore): Result[bool] =
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    if graph.architecture != model_graph.InferenceModelArchitectureDenseTransformer:
        return Err[bool]("model executor dense transformer: unsupported architecture")
    for i in 0..<graph.ops.len:
        if graph.ops[i].opKind == model_graph.InferenceModelOpRouter ||
           graph.ops[i].opKind == model_graph.InferenceModelOpExpert:
            return Err[bool]("model executor dense transformer: moe op not allowed")
    let storeOk = weight_store.WeightTensorValidateStore(store, bindings, graph)
    if IsErr(storeOk):
        return Err[bool](Error(storeOk))
    for i in 0..<graph.weights.len:
        if !ModelExecutorHfWeightExecutionSupported(graph.weights[i]):
            return Err[bool]("model executor dense transformer: unsupported weight execution format")
    return Ok[bool](true)

@borrows
fn ModelExecutorExecuteDenseTransformerOpWithKvState(graph: model_graph.ModelGraph,
                                                      store: weight_store.WeightTensorStore,
                                                      op: model_graph.ModelGraphOp,
                                                      slots: var ModelExecutorTensorSlot[],
                                                      kvInput: ModelExecutorKvStateSet,
                                                      hasKvInput: bool,
                                                      kvOutput: var ModelExecutorKvLayerState[],
                                                      captureKv: bool,
                                                      executionHash: var int64): Result[bool] =
    if op.opKind == model_graph.InferenceModelOpEmbedding:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "dense embedding")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let tokenIds = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(tokenIds):
            return Err[bool](Error(tokenIds))
        let embedding = ModelExecutorFindWeight(store, op.weightNames[0])
        if IsErr(embedding):
            return Err[bool](Error(embedding))
        var out: infer.TensorQ
        let fillOk = ModelExecutorEmbeddingFill(out, Value(tokenIds), Value(embedding))
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpRmsNorm:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "dense rmsnorm")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeight(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorRmsNormRowsFill(out, Value(input), Value(weight), 1)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpQkv:
        if op.weightNames.len == 4 || op.weightNames.len == 7:
            # HF safetensors shape: separate q/k/v/o weights (q/k/v projected
            # here, o consumed later by the attention op below) -- mirrors
            # ModelExecutorExecuteHfGlmMoeOp's Qkv branch exactly (same
            # ModelExecutorLinearOutInStorePayloadMaybeMetalFill calls), minus
            # the MoE-only bits it doesn't need. metalCtx is a fresh disabled
            # local (dense has no metal-context parameter to thread, matching
            # this function's existing signature): every fill below runs the
            # CPU path. When weightNames has 7 entries (Qwen2 q/k/v proj carry a
            # bias each), indices 4/5/6 are the q/k/v bias shards added row-wise
            # after projection; the 4-weight form (GLM MoE, bias-free) is kept.
            let hasQkvBias = op.weightNames.len == 7
            let arityOk = ModelExecutorValidateOpArity(op, 1, op.weightNames.len, "dense hf qkv")
            if IsErr(arityOk):
                return Err[bool](Error(arityOk))
            let input = ModelExecutorFindTensor(slots, op.inputNames[0])
            if IsErr(input):
                return Err[bool](Error(input))
            var inputOwned = Value(input)
            if inputOwned.shape.len != 2 || inputOwned.shape[0] <= 0:
                return Err[bool]("model executor dense hf qkv: token shape")
            let qWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
            if IsErr(qWeight):
                return Err[bool](Error(qWeight))
            let kWeight = ModelExecutorFindWeightPayload(store, op.weightNames[1])
            if IsErr(kWeight):
                return Err[bool](Error(kWeight))
            let vWeight = ModelExecutorFindWeightPayload(store, op.weightNames[2])
            if IsErr(vWeight):
                return Err[bool](Error(vWeight))
            var metalCtx = ModelExecutorMetalContextDisabled()
            var qOut: infer.TensorQ
            let qOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(qOut, inputOwned, store, Value(qWeight), "dense_hf_q", metalCtx)
            if IsErr(qOk):
                return Err[bool](Error(qOk))
            var kOut: infer.TensorQ
            let kOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(kOut, inputOwned, store, Value(kWeight), "dense_hf_k", metalCtx)
            if IsErr(kOk):
                return Err[bool](Error(kOk))
            var vOut: infer.TensorQ
            let vOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(vOut, inputOwned, store, Value(vWeight), "dense_hf_v", metalCtx)
            if IsErr(vOk):
                return Err[bool](Error(vOk))
            let kvRows = graph.keyValueHeads * graph.headDim
            if qOut.shape.len != 2 || qOut.shape[1] != graph.hiddenSize ||
               kOut.shape.len != 2 || kOut.shape[1] != kvRows ||
               vOut.shape.len != 2 || vOut.shape[1] != kvRows:
                return Err[bool]("model executor dense hf qkv: projection shape")
            if hasQkvBias:
                let qBias = ModelExecutorFindWeightPayload(store, op.weightNames[4])
                if IsErr(qBias):
                    return Err[bool](Error(qBias))
                let qBiasOk = ModelExecutorAddBiasRows(qOut, Value(qBias).tensor)
                if IsErr(qBiasOk):
                    return Err[bool](Error(qBiasOk))
                let kBias = ModelExecutorFindWeightPayload(store, op.weightNames[5])
                if IsErr(kBias):
                    return Err[bool](Error(kBias))
                let kBiasOk = ModelExecutorAddBiasRows(kOut, Value(kBias).tensor)
                if IsErr(kBiasOk):
                    return Err[bool](Error(kBiasOk))
                let vBias = ModelExecutorFindWeightPayload(store, op.weightNames[6])
                if IsErr(vBias):
                    return Err[bool](Error(vBias))
                let vBiasOk = ModelExecutorAddBiasRows(vOut, Value(vBias).tensor)
                if IsErr(vBiasOk):
                    return Err[bool](Error(vBiasOk))
            let putQ = ModelExecutorPutTensorAndHash(slots, op.outputName, qOut, executionHash)
            if IsErr(putQ):
                return Err[bool](Error(putQ))
            let putK = ModelExecutorPutTensorAndHash(slots, ModelExecutorDerivedTensorName(op.outputName, ".k"), kOut, executionHash)
            if IsErr(putK):
                return Err[bool](Error(putK))
            let putV = ModelExecutorPutTensorAndHash(slots, ModelExecutorDerivedTensorName(op.outputName, ".v"), vOut, executionHash)
            if IsErr(putV):
                return Err[bool](Error(putV))
            return Ok[bool](true)
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "dense qkv")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeight(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorMatMulFill(out, Value(input), Value(weight), "dense_qkv")
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpRope:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 0, "dense rope")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let kIndex = ModelExecutorFindTensorIndex(slots, ModelExecutorDerivedTensorName(op.inputNames[0], ".k"))
        if IsErr(kIndex):
            return Err[bool](Error(kIndex))
        if Value(kIndex) >= 0:
            # HF shape: the qkv op above split q/k/v -- rotate q's and k's
            # per-head spans (v passes through untouched), mirroring
            # ModelExecutorExecuteHfGlmMoeOp's Rope branch exactly, including
            # basePosition: 0 when this call carries no kv-state input (a
            # from-scratch prefill, or the frozen no-kv delegate below), else
            # the layer's already-cached token count (ModelExecutorRopeBasePosition)
            # so an incremental decode call's single new row lands at its true
            # absolute position instead of being mis-rotated as position 0.
            let vIndex = ModelExecutorFindTensorIndex(slots, ModelExecutorDerivedTensorName(op.inputNames[0], ".v"))
            if IsErr(vIndex):
                return Err[bool](Error(vIndex))
            if Value(vIndex) < 0:
                return Err[bool]("model executor dense rope: partial qkv")
            let basePos = ModelExecutorRopeBasePosition(kvInput, hasKvInput, op.layerIndex)
            if IsErr(basePos):
                return Err[bool](Error(basePos))
            var qOut: infer.TensorQ
            var kOut: infer.TensorQ
            let ropeOk = ModelExecutorRopeApplyQkFill(qOut, kOut, Value(input), slots[Value(kIndex)].tensor, graph, Value(basePos))
            if IsErr(ropeOk):
                return Err[bool](Error(ropeOk))
            let putQ = ModelExecutorPutTensorAndHash(slots, op.outputName, qOut, executionHash)
            if IsErr(putQ):
                return Err[bool](Error(putQ))
            let putK = ModelExecutorPutTensorAndHash(slots, ModelExecutorDerivedTensorName(op.outputName, ".k"), kOut, executionHash)
            if IsErr(putK):
                return Err[bool](Error(putK))
            let copyV = ModelExecutorCopyDerivedTensorIfPresent(slots, op.inputNames[0], op.outputName, ".v")
            if IsErr(copyV):
                return Err[bool](Error(copyV))
            return Ok[bool](true)
        var out: infer.TensorQ
        let fillOk = ModelExecutorRopeApplySpanFill(out, Value(input), 0, graph.headDim, graph.ropeTheta)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpAttention:
        if op.weightNames.len == 1:
            # HF shape: real GQA causal attention over the q/k/v split above,
            # then an o_proj linear -- mirrors ModelExecutorExecuteHfGlmMoeOp's
            # Attention branch exactly (same ModelExecutorPagedCausalAttentionFill
            # call, including its hardmax-over-dot-product-score paged KV
            # retrieval, unmodified here). kvInput/hasKvInput/kvOutput/captureKv
            # are threaded straight through from this function's own params
            # (the frozen no-kv delegate below passes hasKvInput=false,
            # captureKv=false, reproducing the old hardcoded-empty behavior
            # byte for byte). With no kv-state input, ModelExecutorPagedCausalAttentionFill
            # still attends correctly across every token in *this* call
            # because it builds a fresh paged cache and appends this call's
            # own tokens into it before attending each one in turn; with a kv
            # input it appends onto the carried-in cache instead, extending
            # rather than restarting it.
            let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "dense hf attention")
            if IsErr(arityOk):
                return Err[bool](Error(arityOk))
            let query = ModelExecutorFindTensor(slots, op.inputNames[0])
            if IsErr(query):
                return Err[bool](Error(query))
            if Value(query).shape.len != 2 || Value(query).shape[0] <= 0 ||
               Value(query).shape[1] != graph.hiddenSize:
                return Err[bool]("model executor dense hf attention: token shape")
            let key = ModelExecutorFindTensor(slots, ModelExecutorDerivedTensorName(op.inputNames[0], ".k"))
            if IsErr(key):
                return Err[bool](Error(key))
            let value = ModelExecutorFindTensor(slots, ModelExecutorDerivedTensorName(op.inputNames[0], ".v"))
            if IsErr(value):
                return Err[bool](Error(value))
            let outWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
            if IsErr(outWeight):
                return Err[bool](Error(outWeight))
            var metalCtx = ModelExecutorMetalContextDisabled()
            var out: infer.TensorQ
            let fillOk = ModelExecutorPagedCausalAttentionFill(
                out, graph, store, op.layerIndex,
                Value(query), Value(key), Value(value), Value(outWeight),
                kvInput, hasKvInput, kvOutput, captureKv,
                executionHash, metalCtx
            )
            if IsErr(fillOk):
                return Err[bool](Error(fillOk))
            return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)
        let arityOk = ModelExecutorValidateOpArity(op, 1, 0, "dense attention")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        var out: infer.TensorQ
        let fillOk = ModelExecutorTinyAttentionFill(out, Value(input))
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpResidualAdd:
        # HF shape only -- ModelGraphBuildTinyDenseTransformerFixture never
        # emits a residual_add op (model_graph.cheng), so this branch is dead
        # code for the tiny fixture path; it exists for the HF config graph's
        # attention-residual and mlp-residual adds (mirrors
        # ModelExecutorExecuteHfGlmMoeOp's ResidualAdd branch exactly).
        let arityOk = ModelExecutorValidateOpArity(op, 2, 0, "dense residual")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let left = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(left):
            return Err[bool](Error(left))
        let right = ModelExecutorFindTensor(slots, op.inputNames[1])
        if IsErr(right):
            return Err[bool](Error(right))
        var out: infer.TensorQ
        let fillOk = ModelExecutorResidualAddFill(out, Value(left), Value(right))
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpMlp:
        if op.weightNames.len == 3:
            # HF shape: separate gate/up/down projections + SwiGLU -- mirrors
            # ModelExecutorExecuteHfGlmMoeOp's Expert branch's math exactly
            # (same three fills + ModelExecutorSwiGluFill) minus MoE routing:
            # dense applies this unconditionally with no router/route input
            # (ModelExecutorValidateDenseTransformerGraph already hard-rejects
            # router/expert ops in a dense_transformer graph).
            let arityOk = ModelExecutorValidateOpArity(op, 1, 3, "dense hf mlp")
            if IsErr(arityOk):
                return Err[bool](Error(arityOk))
            let input = ModelExecutorFindTensor(slots, op.inputNames[0])
            if IsErr(input):
                return Err[bool](Error(input))
            let gateWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
            if IsErr(gateWeight):
                return Err[bool](Error(gateWeight))
            let upWeight = ModelExecutorFindWeightPayload(store, op.weightNames[1])
            if IsErr(upWeight):
                return Err[bool](Error(upWeight))
            let downWeight = ModelExecutorFindWeightPayload(store, op.weightNames[2])
            if IsErr(downWeight):
                return Err[bool](Error(downWeight))
            var metalCtx = ModelExecutorMetalContextDisabled()
            var gate: infer.TensorQ
            let gateOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(gate, Value(input), store, Value(gateWeight), "dense_hf_mlp_gate", metalCtx)
            if IsErr(gateOk):
                return Err[bool](Error(gateOk))
            var up: infer.TensorQ
            let upOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(up, Value(input), store, Value(upWeight), "dense_hf_mlp_up", metalCtx)
            if IsErr(upOk):
                return Err[bool](Error(upOk))
            var activated: infer.TensorQ
            let swigluOk = ModelExecutorSwiGluFill(activated, gate, up)
            if IsErr(swigluOk):
                return Err[bool](Error(swigluOk))
            var out: infer.TensorQ
            let downOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, activated, store, Value(downWeight), "dense_hf_mlp_down", metalCtx)
            if IsErr(downOk):
                return Err[bool](Error(downOk))
            return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "dense mlp")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeight(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorMatMulFill(out, Value(input), Value(weight), "dense_mlp")
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpLmHead:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "dense lm_head")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weightPayload = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(weightPayload):
            return Err[bool](Error(weightPayload))
        let lmHeadWeightShape = Value(weightPayload).tensor.shape
        let lmHeadInputShape = Value(input).shape
        var out: infer.TensorQ
        if lmHeadWeightShape.len == 2 && lmHeadInputShape.len == 2 &&
           lmHeadWeightShape[0] == lmHeadInputShape[1]:
            # Tiny fixture shape: lm_head.weight is [hiddenSize, vocabSize]
            # (plain [inFeatures,outFeatures] MatMul2dFill convention).
            # Checked first and preferred whenever dimensionally valid, so
            # this branch's behavior for the existing tiny-fixture path is
            # byte-for-byte unchanged from before this patch.
            let fillOk = ModelExecutorMatMulFill(out, Value(input), Value(weightPayload).tensor, "dense_lm_head")
            if IsErr(fillOk):
                return Err[bool](Error(fillOk))
        elif lmHeadWeightShape.len == 2 && lmHeadInputShape.len == 2 &&
             lmHeadWeightShape[1] == lmHeadInputShape[1]:
            # HF safetensors shape: lm_head.weight is [vocabSize, hiddenSize]
            # (outFeatures, inFeatures) -- the same transposed convention as
            # the qkv/mlp weights above. LmHead is a single linear op in both
            # shapes (arity can't distinguish them, unlike qkv/attention/mlp
            # above), so this branches on the weight tensor's own shape
            # instead (checked only once the plain/tiny interpretation above
            # is dimensionally impossible) -- still a per-op graph-structural
            # signal, not a global architecture-string switch.
            var metalCtx = ModelExecutorMetalContextDisabled()
            let fillOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, Value(input), store, Value(weightPayload), "dense_hf_lm_head", metalCtx)
            if IsErr(fillOk):
                return Err[bool](Error(fillOk))
        else:
            # Neither convention's dimensions line up: preserve the original
            # (pre-patch) error path and message for a genuinely malformed
            # graph.
            let fillOk = ModelExecutorMatMulFill(out, Value(input), Value(weightPayload).tensor, "dense_lm_head")
            if IsErr(fillOk):
                return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    return Err[bool]("model executor dense transformer: unsupported op")

# Frozen delegate (pre-#141 signature and behavior): threads an empty,
# non-captured kv state through the WithKvState op above, so hasKvInput=false/
# captureKv=false reproduce the old hardcoded-empty call byte for byte --
# every existing caller of this exact signature keeps working unmodified.
fn ModelExecutorExecuteDenseTransformerOp(graph: model_graph.ModelGraph,
                                          store: weight_store.WeightTensorStore,
                                          op: model_graph.ModelGraphOp,
                                          slots: var ModelExecutorTensorSlot[],
                                          executionHash: var int64): Result[bool] =
    var emptyKv: ModelExecutorKvStateSet
    var kvOutput: ModelExecutorKvLayerState[]
    return ModelExecutorExecuteDenseTransformerOpWithKvState(
        graph, store, op, slots, emptyKv, false, kvOutput, false, executionHash)

# #141: KV-cache-aware dense-transformer forward, machine-mirrored from
# ModelExecutorExecuteHfGlmMoeTokensWithKvStateWithMetalContext's op loop
# (3077-3157) minus MoE-only routing/metal-context threading (dense's op
# executor has no metalCtx parameter of its own -- every attention op builds
# its own disabled-metal local, same as the frozen path below).
#
# captureKv is unconditionally true for every op (mirroring the GLM-MoE
# Tokens-level call) so both prefill (hasInputKvState=false) and decode
# (hasInputKvState=true) calls always produce a kvStateSet -- this is what
# lets ModelExecutorExecuteDenseTransformerTokens's frozen delegate below
# stay behaviorally identical while still incidentally computing (and
# discarding) a kv state: capture is a pure write-only accumulation into
# kvOutput and never feeds back into the logits/executionHash, so it cannot
# perturb the frozen delegate's observable output.
#
# capturableAttentionOps counts HF-shape (weightNames.len==1) Attention ops
# actually visited -- the *only* op branch that ever captures a kv layer
# state (paged_kv_cache.PagedKVAttentionFill). The tiny/synthetic dense
# fixture (model_graph.ModelGraphBuildTinyDenseTransformerFixture) uses the
# non-HF "dense attention" branch (weightNames.len==0,
# ModelExecutorTinyAttentionFill) which never captures anything -- asserting
# kvOutput.len against graph.layerCount unconditionally (as GLM-MoE's Tokens
# function does) would wrongly reject that fixture even through the frozen,
# no-kv delegate path. Asserting against capturableAttentionOps instead makes
# the check a no-op (0==0) for that fixture while still catching a genuinely
# malformed real HF-shape graph that dropped a layer's capture.
@borrows
fn ModelExecutorExecuteDenseTransformerOpsRec(
        graph: model_graph.ModelGraph,
        store: weight_store.WeightTensorStore,
        opIndex: int32,
        slots: var ModelExecutorTensorSlot[],
        kvInput: ModelExecutorKvStateSet,
        hasInputKvState: bool,
        kvOutput: var ModelExecutorKvLayerState[],
        executionHash: var int64,
        capturableAttentionOps: var int32): Result[bool] =
    if opIndex >= graph.ops.len:
        return Ok[bool](true)
    if graph.ops[opIndex].opKind == model_graph.InferenceModelOpAttention &&
       graph.ops[opIndex].weightNames.len == 1:
        capturableAttentionOps = capturableAttentionOps + 1
    let opOk = ModelExecutorExecuteDenseTransformerOpWithKvState(
        graph, store, graph.ops[opIndex], slots,
        kvInput, hasInputKvState, kvOutput, true,
        executionHash)
    if IsErr(opOk):
        return Err[bool](Error(opOk))
    return ModelExecutorExecuteDenseTransformerOpsRec(
        graph, store, opIndex + 1, slots, kvInput, hasInputKvState,
        kvOutput, executionHash, capturableAttentionOps)

@borrows
fn ModelExecutorExecuteDenseTransformerTokensWithKvState(graph: model_graph.ModelGraph,
                                                          bindings: weight_binding.WeightBindingSet,
                                                          store: weight_store.WeightTensorStore,
                                                          tokenIds: infer.TensorQ,
                                                          inputKvState: ModelExecutorKvStateSet,
                                                          hasInputKvState: bool): Result[ModelExecutorOutputWithKv] =
    let supportOk = ModelExecutorValidateDenseTransformerGraph(graph, bindings, store)
    if IsErr(supportOk):
        return Err[ModelExecutorOutputWithKv](Error(supportOk))
    let tokenOk = infer.TensorValidate(tokenIds)
    if IsErr(tokenOk):
        return Err[ModelExecutorOutputWithKv](Error(tokenOk))
    if tokenIds.shape.len != 1 || tokenIds.shape[0] <= 0:
        return Err[ModelExecutorOutputWithKv]("model executor dense transformer: token shape")
    if hasInputKvState:
        let kvOk = ModelExecutorValidateKvStateSet(inputKvState)
        if IsErr(kvOk):
            return Err[ModelExecutorOutputWithKv](Error(kvOk))
        if inputKvState.layerStates.len != graph.layerCount:
            return Err[ModelExecutorOutputWithKv]("model executor dense transformer: kv layer count")
    var slots: ModelExecutorTensorSlot[]
    var kvOutput: ModelExecutorKvLayerState[]
    let putToken = ModelExecutorPutTensor(slots, "token_ids", tokenIds)
    if IsErr(putToken):
        return Err[ModelExecutorOutputWithKv](Error(putToken))
    var executionHash = ModelExecutorHashStep(int64(131), graph.graphHash)
    var capturableAttentionOps: int32 = 0
    let opsOk = ModelExecutorExecuteDenseTransformerOpsRec(
        graph, store, 0, slots, inputKvState, hasInputKvState,
        kvOutput, executionHash, capturableAttentionOps)
    if IsErr(opsOk):
        return Err[ModelExecutorOutputWithKv](Error(opsOk))
    if kvOutput.len != capturableAttentionOps:
        return Err[ModelExecutorOutputWithKv]("model executor dense transformer: kv output layer count")
    let kvStateSet = ModelExecutorKvStateSetBuild(kvOutput)
    # ModelExecutorValidateKvStateSet rejects an empty layerStates set outright
    # (it's meant to validate a real, consumable kv state) -- only run it when
    # this graph shape actually captured anything. The tiny/synthetic fixture
    # (capturableAttentionOps==0) legitimately produces an empty kvStateSet
    # here; that's fine because the frozen delegate below discards it and no
    # decode call can ever be made against it (ModelExecutorFindKvLayerStateIndex
    # would fail closed on the first lookup if anyone tried).
    if capturableAttentionOps > 0:
        let kvOutOk = ModelExecutorValidateKvStateSet(kvStateSet)
        if IsErr(kvOutOk):
            return Err[ModelExecutorOutputWithKv](Error(kvOutOk))
    let logits = ModelExecutorFindTensor(slots, graph.ops[graph.ops.len - 1].outputName)
    if IsErr(logits):
        return Err[ModelExecutorOutputWithKv](Error(logits))
    var logitsOwned = Value(logits)
    let logitsHash = ModelExecutorTensorHash(logitsOwned)
    if IsErr(logitsHash):
        return Err[ModelExecutorOutputWithKv](Error(logitsHash))
    # executionHash formula is byte-for-byte the pre-#141 formula (no
    # kvStateSet folded in) -- ModelExecutorExecuteDenseTransformerTokens's
    # frozen delegate below returns this exact value today, and #141 does not
    # get to change that observable field even though a kv state now also
    # happens to be available.
    executionHash = ModelExecutorHashStep(executionHash, Value(logitsHash))
    var routePlan: moe_router.MoeRoutePlan
    var routePlanSet: moe_router.MoeRoutePlanSet
    let output = ModelExecutorOutput(
        logits: infer.TensorClone(logitsOwned),
        routePlan: routePlan,
        routePlanSet: routePlanSet,
        executionHash: executionHash
    )
    return Ok[ModelExecutorOutputWithKv](ModelExecutorOutputWithKv(
        output: output,
        kvStateSet: kvStateSet
    ))

fn ModelExecutorExecuteDenseTransformerPrefillWithKvState(graph: model_graph.ModelGraph,
                                                           bindings: weight_binding.WeightBindingSet,
                                                           store: weight_store.WeightTensorStore,
                                                           tokenIds: infer.TensorQ): Result[ModelExecutorOutputWithKv] =
    var emptyKv: ModelExecutorKvStateSet
    return ModelExecutorExecuteDenseTransformerTokensWithKvState(
        graph, bindings, store, tokenIds, emptyKv, false)

fn ModelExecutorExecuteDenseTransformerDecodeWithKvState(graph: model_graph.ModelGraph,
                                                          bindings: weight_binding.WeightBindingSet,
                                                          store: weight_store.WeightTensorStore,
                                                          tokenIds: infer.TensorQ,
                                                          inputKvState: ModelExecutorKvStateSet): Result[ModelExecutorOutputWithKv] =
    return ModelExecutorExecuteDenseTransformerTokensWithKvState(
        graph, bindings, store, tokenIds, inputKvState, true)

# Frozen delegate (pre-#141 signature and behavior): delegates to the
# WithKvState function above with an empty, unused kv state -- same
# "behavior-preserving refactor" pattern as
# ModelExecutorExecuteHfGlmMoeTokensWithRouteSet's existing delegation to
# ...TokensWithKvState(...,emptyKv,false).
@borrows
fn ModelExecutorExecuteDenseTransformerTokens(graph: model_graph.ModelGraph,
                                              bindings: weight_binding.WeightBindingSet,
                                              store: weight_store.WeightTensorStore,
                                              tokenIds: infer.TensorQ): Result[ModelExecutorOutput] =
    var emptyKv: ModelExecutorKvStateSet
    let out = ModelExecutorExecuteDenseTransformerTokensWithKvState(graph, bindings, store, tokenIds, emptyKv, false)
    if IsErr(out):
        return Err[ModelExecutorOutput](Error(out))
    var owned = Value(out)
    var output = owned.output
    return Ok[ModelExecutorOutput](output)

@borrows
fn ModelExecutorValidateOpArity(op: model_graph.ModelGraphOp,
                                inputCount: int32,
                                weightCount: int32,
                                label: str): Result[bool] =
    if op.inputNames.len != inputCount || op.weightNames.len != weightCount:
        return Err[bool](strutil.Join(["model executor ", share(label), ": arity"], ""))
    return Ok[bool](true)

@borrows
fn ModelExecutorValidateHfGlm52DsaMlaMtpAuditGraph(graph: model_graph.ModelGraph,
                                                   bindings: weight_binding.WeightBindingSet,
                                                   store: weight_store.WeightTensorStore,
                                                   tokenIds: infer.TensorQ): Result[bool] =
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    if graph.architecture != model_graph.InferenceModelArchitectureHfGlm52DsaMlaMtp:
        return Err[bool]("model executor glm52 audit: unsupported architecture")
    if graph.topK != 2 || graph.expertCount < 2:
        return Err[bool]("model executor glm52 audit: router config")
    let tokenOk = infer.TensorValidate(tokenIds)
    if IsErr(tokenOk):
        return Err[bool](Error(tokenOk))
    if tokenIds.shape.len != 1 || tokenIds.shape[0] <= 0:
        return Err[bool]("model executor glm52 audit: token shape")
    let storeOk = weight_store.WeightTensorValidateStore(store, bindings, graph)
    if IsErr(storeOk):
        return Err[bool](Error(storeOk))
    for i in 0..<graph.weights.len:
        if !ModelExecutorHfWeightExecutionSupported(graph.weights[i]):
            return Err[bool]("model executor glm52 audit: unsupported weight execution format")
    var hasMlaQ: bool
    var hasMlaKv: bool
    var hasDsa: bool
    var hasMtp: bool
    var hasRouter: bool
    var hasLmHead: bool
    for i in 0..<graph.ops.len:
        let kind = graph.ops[i].opKind
        if kind == model_graph.InferenceModelOpEmbedding:
            # recognized op kind, no flag to set
        elif kind == model_graph.InferenceModelOpMlaQCompress:
            hasMlaQ = true
        elif kind == model_graph.InferenceModelOpMlaKvCompress:
            hasMlaKv = true
        elif kind == model_graph.InferenceModelOpDsaIndexer:
            hasDsa = true
        elif kind == model_graph.InferenceModelOpAttention:
            # recognized op kind, no flag to set
        elif kind == model_graph.InferenceModelOpMlp:
            # recognized op kind, no flag to set
        elif kind == model_graph.InferenceModelOpRouter:
            hasRouter = true
        elif kind == model_graph.InferenceModelOpExpert:
            # recognized op kind, no flag to set
        elif kind == model_graph.InferenceModelOpMtpProject:
            hasMtp = true
        elif kind == model_graph.InferenceModelOpLmHead:
            hasLmHead = true
        elif kind == model_graph.InferenceModelOpRmsNorm:
            # recognized op kind, no flag to set
        else:
            return Err[bool]("model executor glm52 audit: unsupported op")
    if !hasMlaQ || !hasMlaKv || !hasDsa || !hasMtp || !hasRouter || !hasLmHead:
        return Err[bool]("model executor glm52 audit: incomplete op set")
    if graph.ops[graph.ops.len - 1].opKind != model_graph.InferenceModelOpLmHead:
        return Err[bool]("model executor glm52 audit: final op")
    return Ok[bool](true)

fn ModelExecutorGlm52MlaKvKeyValueFill(out: var infer.TensorQ,
                                       graph: model_graph.ModelGraph,
                                       compressed: infer.TensorQ,
                                       projected: infer.TensorQ): Result[bool] =
    let compressedOk = infer.TensorValidate(compressed)
    if IsErr(compressedOk):
        return Err[bool](Error(compressedOk))
    let projectedOk = infer.TensorValidate(projected)
    if IsErr(projectedOk):
        return Err[bool](Error(projectedOk))
    if compressed.shape.len != 2 || projected.shape.len != 2 ||
       compressed.shape[0] <= 0 || projected.shape[0] != compressed.shape[0] ||
       compressed.shape[1] != graph.kvLoraRank + graph.qkRopeHeadDim ||
       projected.shape[1] != graph.qkNopeHeadDim + graph.vHeadDim ||
       graph.qkHeadDim != graph.qkNopeHeadDim + graph.qkRopeHeadDim:
        return Err[bool]("model executor glm52 mla kv: key value shape")
    if compressed.scale != projected.scale:
        return Err[bool]("model executor glm52 mla kv: key value scale")
    var data: int32[]
    for row in 0..<projected.shape[0]:
        for col in 0..<graph.qkNopeHeadDim:
            add(data, projected.data[infer.TensorOffset2(projected.shape, row, col)])
        for col in 0..<graph.qkRopeHeadDim:
            add(data, compressed.data[infer.TensorOffset2(compressed.shape, row, graph.kvLoraRank + col)])
        for col in 0..<graph.vHeadDim:
            add(data, projected.data[infer.TensorOffset2(projected.shape, row, graph.qkNopeHeadDim + col)])
    return infer.TensorFromDataFill(out, [projected.shape[0], graph.qkHeadDim + graph.vHeadDim], projected.scale, data)

fn ModelExecutorGlm52AttentionScore(q: infer.TensorQ,
                                    kv: infer.TensorQ,
                                    dsa: infer.TensorQ,
                                    graph: model_graph.ModelGraph,
                                    queryRow: int32,
                                    keyRow: int32): Result[int32] =
    if q.scale <= 0 || q.scale != kv.scale || q.scale != dsa.scale:
        return Err[int32]("model executor glm52 attention score: scale")
    if queryRow < 0 || keyRow < 0 || queryRow >= q.shape[0] || keyRow >= kv.shape[0] ||
       dsa.shape[0] != q.shape[0]:
        return Err[int32]("model executor glm52 attention score: row")
    var score: int64
    for col in 0..<graph.qkHeadDim:
        let qValue = q.data[infer.TensorOffset2(q.shape, queryRow, col)]
        let kValue = kv.data[infer.TensorOffset2(kv.shape, keyRow, col)]
        score = score + infer.InferenceRoundDivI64(int64(qValue) * int64(kValue), int64(q.scale))
    let dsaDim = graph.indexHeads * graph.indexHeadDim
    for col in 0..<dsaDim:
        let qBias = dsa.data[infer.TensorOffset2(dsa.shape, queryRow, col)]
        let kBias = dsa.data[infer.TensorOffset2(dsa.shape, keyRow, col)]
        score = score + infer.InferenceRoundDivI64(int64(qBias) * int64(kBias), int64(dsa.scale))
    return Ok[int32](infer.InferenceSaturateI32(score))

fn ModelExecutorGlm52MlaDsaCausalAttentionContextFill(out: var infer.TensorQ,
                                                      graph: model_graph.ModelGraph,
                                                      q: infer.TensorQ,
                                                      kv: infer.TensorQ,
                                                      dsa: infer.TensorQ): Result[bool] =
    let qOk = infer.TensorValidate(q)
    if IsErr(qOk):
        return Err[bool](Error(qOk))
    let kvOk = infer.TensorValidate(kv)
    if IsErr(kvOk):
        return Err[bool](Error(kvOk))
    let dsaOk = infer.TensorValidate(dsa)
    if IsErr(dsaOk):
        return Err[bool](Error(dsaOk))
    let dsaDim = graph.indexHeads * graph.indexHeadDim
    if q.shape.len != 2 || kv.shape.len != 2 || dsa.shape.len != 2 ||
       q.shape[0] <= 0 || kv.shape[0] != q.shape[0] || dsa.shape[0] != q.shape[0] ||
       q.shape[1] != graph.qkHeadDim ||
       kv.shape[1] != graph.qkHeadDim + graph.vHeadDim ||
       dsa.shape[1] != dsaDim ||
       graph.qkHeadDim != graph.qkNopeHeadDim + graph.qkRopeHeadDim:
        return Err[bool]("model executor glm52 mla dsa attention: shape")
    if q.scale != kv.scale || q.scale != dsa.scale:
        return Err[bool]("model executor glm52 mla dsa attention: scale")
    var data: int32[]
    for row in 0..<q.shape[0]:
        var scores: int32[]
        var maxScore: int32
        for candidate in 0..<row + 1:
            let score = ModelExecutorGlm52AttentionScore(q, kv, dsa, graph, row, candidate)
            if IsErr(score):
                return Err[bool](Error(score))
            if candidate == 0 || Value(score) > maxScore:
                maxScore = Value(score)
            add(scores, Value(score))
        var weights: int32[]
        var denom: int64
        for i in 0..<scores.len:
            let weight = infer.InferenceExpNegQ(scores[i] - maxScore, q.scale, infer.InferenceSoftmaxInternalScale)
            add(weights, weight)
            denom = denom + int64(weight)
        if denom <= int64(0):
            return Err[bool]("model executor glm52 mla dsa attention: denom")
        for valueCol in 0..<graph.vHeadDim:
            var numer: int64
            for candidate in 0..<row + 1:
                let value = kv.data[infer.TensorOffset2(kv.shape, candidate, graph.qkHeadDim + valueCol)]
                numer = numer + int64(value) * int64(weights[candidate])
            add(data, infer.InferenceSaturateI32(infer.InferenceRoundDivI64(numer, denom)))
    return infer.TensorFromDataFill(out, [q.shape[0], graph.vHeadDim], kv.scale, data)

@borrows
fn ModelExecutorExecuteHfGlm52DsaMlaMtpAuditOp(graph: model_graph.ModelGraph,
                                               store: weight_store.WeightTensorStore,
                                               op: model_graph.ModelGraphOp,
                                               slots: var ModelExecutorTensorSlot[],
                                               routeSlots: var ModelExecutorRouteSlot[],
                                               latestRoute: var moe_router.MoeRoutePlan,
                                               expertCapacity: int32,
                                               executionHash: var int64,
                                               metalCtx: var ModelExecutorMetalContext): Result[bool] =
    if op.opKind == model_graph.InferenceModelOpEmbedding:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "glm52 embedding")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let tokenIds = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(tokenIds):
            return Err[bool](Error(tokenIds))
        let embedding = ModelExecutorFindWeight(store, op.weightNames[0])
        if IsErr(embedding):
            return Err[bool](Error(embedding))
        var out: infer.TensorQ
        let fillOk = ModelExecutorEmbeddingFill(out, Value(tokenIds), Value(embedding))
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpMlaQCompress:
        if op.inputNames.len != 1 || (op.weightNames.len != 1 && op.weightNames.len != 3):
            return Err[bool]("model executor glm52 mla q: arity")
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        if op.weightNames.len == 1:
            let weight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
            if IsErr(weight):
                return Err[bool](Error(weight))
            var out: infer.TensorQ
            let fillOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, Value(input), store, Value(weight), "glm52_mla_q", metalCtx)
            if IsErr(fillOk):
                return Err[bool](Error(fillOk))
            return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)
        let qA = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(qA):
            return Err[bool](Error(qA))
        let qNorm = ModelExecutorFindWeight(store, op.weightNames[1])
        if IsErr(qNorm):
            return Err[bool](Error(qNorm))
        let qB = ModelExecutorFindWeightPayload(store, op.weightNames[2])
        if IsErr(qB):
            return Err[bool](Error(qB))
        var qLatent: infer.TensorQ
        let qAOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(qLatent, Value(input), store, Value(qA), "glm52_mla_q_a", metalCtx)
        if IsErr(qAOk):
            return Err[bool](Error(qAOk))
        var qNormed: infer.TensorQ
        let normOk = ModelExecutorRmsNormRowsFill(qNormed, qLatent, Value(qNorm), 1)
        if IsErr(normOk):
            return Err[bool](Error(normOk))
        var qOut: infer.TensorQ
        let qBOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(qOut, qNormed, store, Value(qB), "glm52_mla_q_b", metalCtx)
        if IsErr(qBOk):
            return Err[bool](Error(qBOk))
        if qOut.shape.len != 2 || qOut.shape[1] != graph.qkHeadDim || graph.qkHeadDim != graph.qkNopeHeadDim + graph.qkRopeHeadDim:
            return Err[bool]("model executor glm52 mla q: rope shape")
        var out: infer.TensorQ
        let qRopeOk = ModelExecutorRopeApplySpanFill(out, qOut, graph.qkNopeHeadDim, graph.qkRopeHeadDim, graph.ropeTheta)
        if IsErr(qRopeOk):
            return Err[bool](Error(qRopeOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpMlaKvCompress:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 3, "glm52 mla kv")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let kvA = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(kvA):
            return Err[bool](Error(kvA))
        let kvNorm = ModelExecutorFindWeight(store, op.weightNames[1])
        if IsErr(kvNorm):
            return Err[bool](Error(kvNorm))
        let kvB = ModelExecutorFindWeightPayload(store, op.weightNames[2])
        if IsErr(kvB):
            return Err[bool](Error(kvB))
        var compressed: infer.TensorQ
        let kvAOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(compressed, Value(input), store, Value(kvA), "glm52_mla_kv_a", metalCtx)
        if IsErr(kvAOk):
            return Err[bool](Error(kvAOk))
        if compressed.shape.len != 2 || compressed.shape[1] != graph.kvLoraRank + graph.qkRopeHeadDim:
            return Err[bool]("model executor glm52 mla kv: compressed shape")
        var compressedRoped: infer.TensorQ
        let kvRopeOk = ModelExecutorRopeApplySpanFill(compressedRoped, compressed, graph.kvLoraRank, graph.qkRopeHeadDim, graph.ropeTheta)
        if IsErr(kvRopeOk):
            return Err[bool](Error(kvRopeOk))
        var latent: infer.TensorQ
        let sliceOk = ModelExecutorTensorColumnSliceFill(latent, compressedRoped, 0, graph.kvLoraRank)
        if IsErr(sliceOk):
            return Err[bool](Error(sliceOk))
        var normed: infer.TensorQ
        let normOk = ModelExecutorRmsNormRowsFill(normed, latent, Value(kvNorm), 1)
        if IsErr(normOk):
            return Err[bool](Error(normOk))
        var projected: infer.TensorQ
        let kvBOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(projected, normed, store, Value(kvB), "glm52_mla_kv_b", metalCtx)
        if IsErr(kvBOk):
            return Err[bool](Error(kvBOk))
        var out: infer.TensorQ
        let keyValueOk = ModelExecutorGlm52MlaKvKeyValueFill(out, graph, compressedRoped, projected)
        if IsErr(keyValueOk):
            return Err[bool](Error(keyValueOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpDsaIndexer:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "glm52 dsa")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, Value(input), store, Value(weight), "glm52_dsa_indexer", metalCtx)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpAttention:
        let arityOk = ModelExecutorValidateOpArity(op, 3, 1, "glm52 attention")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let q = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(q):
            return Err[bool](Error(q))
        let kv = ModelExecutorFindTensor(slots, op.inputNames[1])
        if IsErr(kv):
            return Err[bool](Error(kv))
        let dsa = ModelExecutorFindTensor(slots, op.inputNames[2])
        if IsErr(dsa):
            return Err[bool](Error(dsa))
        let outWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(outWeight):
            return Err[bool](Error(outWeight))
        if Value(outWeight).tensor.shape.len != 2 || Value(outWeight).tensor.shape[1] != graph.vHeadDim:
            return Err[bool]("model executor glm52 attention: out weight")
        var context: infer.TensorQ
        let contextOk = ModelExecutorGlm52MlaDsaCausalAttentionContextFill(context, graph, Value(q), Value(kv), Value(dsa))
        if IsErr(contextOk):
            return Err[bool](Error(contextOk))
        var out: infer.TensorQ
        let outOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, context, store, Value(outWeight), "glm52_attention_o", metalCtx)
        if IsErr(outOk):
            return Err[bool](Error(outOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpMlp:
        if op.inputNames.len == 1 && op.weightNames.len == 1:
            let input = ModelExecutorFindTensor(slots, op.inputNames[0])
            if IsErr(input):
                return Err[bool](Error(input))
            let weight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
            if IsErr(weight):
                return Err[bool](Error(weight))
            var out: infer.TensorQ
            let fillOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, Value(input), store, Value(weight), "glm52_mlp_linear", metalCtx)
            if IsErr(fillOk):
                return Err[bool](Error(fillOk))
            return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)
        if op.inputNames.len == graph.expertCount && op.weightNames.len == 0:
            let latestOk = moe_router.MoeValidateRoutePlan(latestRoute)
            if IsErr(latestOk):
                return Err[bool](Error(latestOk))
            var experts: infer.TensorQ[]
            for i in 0..<op.inputNames.len:
                let expert = ModelExecutorFindTensor(slots, op.inputNames[i])
                if IsErr(expert):
                    return Err[bool](Error(expert))
                add(experts, Value(expert))
            var out: infer.TensorQ
            let combineOk = ModelExecutorCombineExpertSetFill(out, latestRoute, experts)
            if IsErr(combineOk):
                return Err[bool](Error(combineOk))
            return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)
        return Err[bool]("model executor glm52 mlp: arity")

    if op.opKind == model_graph.InferenceModelOpRouter:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "glm52 router")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var scores: infer.TensorQ
        let fillOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(scores, Value(input), store, Value(weight), "glm52_router", metalCtx)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        let routeRes = moe_router.MoeRouteTop2(scores.data, scores.shape[0], scores.shape[1], expertCapacity)
        if IsErr(routeRes):
            return Err[bool](Error(routeRes))
        latestRoute = Value(routeRes)
        let putRoute = ModelExecutorPutRoute(routeSlots, op.outputName, op.layerIndex, latestRoute)
        if IsErr(putRoute):
            return Err[bool](Error(putRoute))
        let hashOk = ModelExecutorHashTensorInto(executionHash, scores)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = ModelExecutorHashStep(Value(hashOk), latestRoute.routeHash)
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpExpert:
        let arityOk = ModelExecutorValidateOpArity(op, 2, 3, "glm52 expert")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        if op.expertId < 0 || op.expertId >= graph.expertCount:
            return Err[bool]("model executor glm52 expert: id")
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let route = ModelExecutorFindRoute(routeSlots, op.inputNames[1])
        if IsErr(route):
            return Err[bool](Error(route))
        let gateWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(gateWeight):
            return Err[bool](Error(gateWeight))
        let upWeight = ModelExecutorFindWeightPayload(store, op.weightNames[1])
        if IsErr(upWeight):
            return Err[bool](Error(upWeight))
        let downWeight = ModelExecutorFindWeightPayload(store, op.weightNames[2])
        if IsErr(downWeight):
            return Err[bool](Error(downWeight))
        var gate: infer.TensorQ
        let gateOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(gate, Value(input), store, Value(gateWeight), "glm52_expert_gate", metalCtx)
        if IsErr(gateOk):
            return Err[bool](Error(gateOk))
        var up: infer.TensorQ
        let upOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(up, Value(input), store, Value(upWeight), "glm52_expert_up", metalCtx)
        if IsErr(upOk):
            return Err[bool](Error(upOk))
        var activated: infer.TensorQ
        let swigluOk = ModelExecutorSwiGluFill(activated, gate, up)
        if IsErr(swigluOk):
            return Err[bool](Error(swigluOk))
        var out: infer.TensorQ
        let downOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, activated, store, Value(downWeight), "glm52_expert_down", metalCtx)
        if IsErr(downOk):
            return Err[bool](Error(downOk))
        executionHash = ModelExecutorHashStep(executionHash, Value(route).routeHash)
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpMtpProject:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 3, "glm52 mtp")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let ehWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(ehWeight):
            return Err[bool](Error(ehWeight))
        let hNorm = ModelExecutorFindWeight(store, op.weightNames[1])
        if IsErr(hNorm):
            return Err[bool](Error(hNorm))
        let sharedNorm = ModelExecutorFindWeight(store, op.weightNames[2])
        if IsErr(sharedNorm):
            return Err[bool](Error(sharedNorm))
        var projected: infer.TensorQ
        let ehOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(projected, Value(input), store, Value(ehWeight), "glm52_mtp_eh", metalCtx)
        if IsErr(ehOk):
            return Err[bool](Error(ehOk))
        var normed: infer.TensorQ
        let hNormOk = ModelExecutorRmsNormRowsFill(normed, projected, Value(hNorm), 1)
        if IsErr(hNormOk):
            return Err[bool](Error(hNormOk))
        var out: infer.TensorQ
        let sharedNormOk = ModelExecutorRmsNormRowsFill(out, normed, Value(sharedNorm), 1)
        if IsErr(sharedNormOk):
            return Err[bool](Error(sharedNormOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpLmHead:
        if op.inputNames.len != 1 || (op.weightNames.len != 1 && op.weightNames.len != 2):
            return Err[bool]("model executor glm52 lm_head: arity")
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        var lmInput = Value(input)
        if op.weightNames.len == 2:
            let normWeight = ModelExecutorFindWeight(store, op.weightNames[0])
            if IsErr(normWeight):
                return Err[bool](Error(normWeight))
            var normed: infer.TensorQ
            let normOk = ModelExecutorRmsNormRowsFill(normed, lmInput, Value(normWeight), 1)
            if IsErr(normOk):
                return Err[bool](Error(normOk))
            lmInput = normed
        let headName = op.weightNames[op.weightNames.len - 1]
        let headWeight = ModelExecutorFindWeightPayload(store, headName)
        if IsErr(headWeight):
            return Err[bool](Error(headWeight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, lmInput, store, Value(headWeight), "glm52_lm_head", metalCtx)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    if op.opKind == model_graph.InferenceModelOpRmsNorm:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "glm52 rmsnorm")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeight(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorRmsNormRowsFill(out, Value(input), Value(weight), 1)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        return ModelExecutorPutTensorAndHash(slots, op.outputName, out, executionHash)

    return Err[bool]("model executor glm52 audit: unsupported op")

@borrows
fn ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens(graph: model_graph.ModelGraph,
                                                   bindings: weight_binding.WeightBindingSet,
                                                   store: weight_store.WeightTensorStore,
                                                   tokenIds: infer.TensorQ,
                                                   expertCapacity: int32): Result[ModelExecutorOutput] =
    let supportOk = ModelExecutorValidateHfGlm52DsaMlaMtpAuditGraph(graph, bindings, store, tokenIds)
    if IsErr(supportOk):
        return Err[ModelExecutorOutput](Error(supportOk))
    if expertCapacity <= 0:
        return Err[ModelExecutorOutput]("model executor glm52 audit: expert capacity")
    var slots: ModelExecutorTensorSlot[]
    let putToken = ModelExecutorPutTensor(slots, "token_ids", infer.TensorClone(tokenIds))
    if IsErr(putToken):
        return Err[ModelExecutorOutput](Error(putToken))
    var routeSlots: ModelExecutorRouteSlot[]
    var latestRoute: moe_router.MoeRoutePlan
    var metalCtx = ModelExecutorMetalContextDisabled()
    var executionHash = ModelExecutorHashStep(int64(131), graph.graphHash)
    for i in 0..<graph.ops.len:
        let opOk = ModelExecutorExecuteHfGlm52DsaMlaMtpAuditOp(
            graph,
            store,
            graph.ops[i],
            slots,
            routeSlots,
            latestRoute,
            expertCapacity,
            executionHash,
            metalCtx
        )
        if IsErr(opOk):
            return Err[ModelExecutorOutput](Error(opOk))
    let routeSetRes = ModelExecutorRouteSlotsToSet(routeSlots)
    if IsErr(routeSetRes):
        return Err[ModelExecutorOutput](Error(routeSetRes))
    let logits = ModelExecutorFindTensor(slots, graph.ops[graph.ops.len - 1].outputName)
    if IsErr(logits):
        return Err[ModelExecutorOutput](Error(logits))
    var out = ModelExecutorOutput(
        logits: Value(logits),
        routePlan: latestRoute,
        routePlanSet: Value(routeSetRes),
        executionHash: int64(0)
    )
    # OutputHash re-validates the route plan and route set (propagating the
    # same moe_router errors), so no separate consuming validation is needed.
    let outputHash = ModelExecutorOutputHash(out.logits, out.routePlan, out.routePlanSet)
    if IsErr(outputHash):
        return Err[ModelExecutorOutput](Error(outputHash))
    out.executionHash = ModelExecutorHashStep(executionHash, Value(outputHash))
    return Ok[ModelExecutorOutput](out)

fn ModelExecutorExecuteHfGlmMoeOp(graph: model_graph.ModelGraph,
                                  store: weight_store.WeightTensorStore,
                                  op: model_graph.ModelGraphOp,
                                  slots: var ModelExecutorTensorSlot[],
                                  routeSlots: var ModelExecutorRouteSlot[],
                                  kvInput: ModelExecutorKvStateSet,
                                  hasKvInput: bool,
                                  kvOutput: var ModelExecutorKvLayerState[],
                                  captureKv: bool,
                                  latestRoute: var moe_router.MoeRoutePlan,
                                  expertCapacity: int32,
                                  executionHash: var int64,
                                  metalCtx: var ModelExecutorMetalContext): Result[bool] =
    if op.opKind == model_graph.InferenceModelOpEmbedding:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "embedding")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let tokenIds = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(tokenIds):
            return Err[bool](Error(tokenIds))
        let embedding = ModelExecutorFindWeight(store, op.weightNames[0])
        if IsErr(embedding):
            return Err[bool](Error(embedding))
        var out: infer.TensorQ
        let fillOk = ModelExecutorEmbeddingFill(out, Value(tokenIds), Value(embedding))
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        let putOk = ModelExecutorPutTensor(slots, op.outputName, out)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        let hashOk = ModelExecutorHashTensorInto(executionHash, out)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpRmsNorm:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "rmsnorm")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeight(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorRmsNormRowsFill(out, Value(input), Value(weight), 1)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        let putOk = ModelExecutorPutTensor(slots, op.outputName, out)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        let hashOk = ModelExecutorHashTensorInto(executionHash, out)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpQkv:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 4, "qkv")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        if Value(input).shape.len != 2 || Value(input).shape[0] <= 0:
            return Err[bool]("model executor qkv: token shape")
        let qWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(qWeight):
            return Err[bool](Error(qWeight))
        let kWeight = ModelExecutorFindWeightPayload(store, op.weightNames[1])
        if IsErr(kWeight):
            return Err[bool](Error(kWeight))
        let vWeight = ModelExecutorFindWeightPayload(store, op.weightNames[2])
        if IsErr(vWeight):
            return Err[bool](Error(vWeight))
        var qOut: infer.TensorQ
        let qOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(qOut, Value(input), store, Value(qWeight), "q", metalCtx)
        if IsErr(qOk):
            return Err[bool](Error(qOk))
        var kOut: infer.TensorQ
        let kOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(kOut, Value(input), store, Value(kWeight), "k", metalCtx)
        if IsErr(kOk):
            return Err[bool](Error(kOk))
        var vOut: infer.TensorQ
        let vOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(vOut, Value(input), store, Value(vWeight), "v", metalCtx)
        if IsErr(vOk):
            return Err[bool](Error(vOk))
        let kvRows = graph.keyValueHeads * graph.headDim
        if qOut.shape.len != 2 || qOut.shape[1] != graph.hiddenSize ||
           kOut.shape.len != 2 || kOut.shape[1] != kvRows ||
           vOut.shape.len != 2 || vOut.shape[1] != kvRows:
            return Err[bool]("model executor qkv: projection shape")
        var hashOk = ModelExecutorHashTensorInto(executionHash, qOut)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        hashOk = ModelExecutorHashTensorInto(executionHash, kOut)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        hashOk = ModelExecutorHashTensorInto(executionHash, vOut)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        let putOk = ModelExecutorPutTensor(slots, op.outputName, qOut)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        let putK = ModelExecutorPutTensor(slots, ModelExecutorDerivedTensorName(op.outputName, ".k"), kOut)
        if IsErr(putK):
            return Err[bool](Error(putK))
        let putV = ModelExecutorPutTensor(slots, ModelExecutorDerivedTensorName(op.outputName, ".v"), vOut)
        if IsErr(putV):
            return Err[bool](Error(putV))
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpRope:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 0, "rope")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let kIndex = ModelExecutorFindTensorIndex(slots, ModelExecutorDerivedTensorName(op.inputNames[0], ".k"))
        if IsErr(kIndex):
            return Err[bool](Error(kIndex))
        let vIndex = ModelExecutorFindTensorIndex(slots, ModelExecutorDerivedTensorName(op.inputNames[0], ".v"))
        if IsErr(vIndex):
            return Err[bool](Error(vIndex))
        if Value(kIndex) >= 0:
            if Value(vIndex) < 0:
                return Err[bool]("model executor rope: partial qkv")
        elif Value(vIndex) >= 0:
            return Err[bool]("model executor rope: partial qkv")
        let basePos = ModelExecutorRopeBasePosition(kvInput, hasKvInput, op.layerIndex)
        if IsErr(basePos):
            return Err[bool](Error(basePos))
        var out: infer.TensorQ
        if Value(kIndex) >= 0:
            var kOut: infer.TensorQ
            let ropeOk = ModelExecutorRopeApplyQkFill(out, kOut, Value(input), slots[Value(kIndex)].tensor, graph, Value(basePos))
            if IsErr(ropeOk):
                return Err[bool](Error(ropeOk))
            let putK = ModelExecutorPutTensor(slots, ModelExecutorDerivedTensorName(op.outputName, ".k"), kOut)
            if IsErr(putK):
                return Err[bool](Error(putK))
        else:
            if graph.headDim <= 0 || graph.headDim % 2 != 0:
                return Err[bool]("model executor rope: head dim")
            let copyOk = ModelExecutorTensorCopyFill(out, Value(input))
            if IsErr(copyOk):
                return Err[bool](Error(copyOk))
            var invFreq: float64[]
            let invFreqOk = ModelExecutorRopeInvFreqFill(invFreq, graph.headDim / 2, graph.ropeTheta)
            if IsErr(invFreqOk):
                return Err[bool](Error(invFreqOk))
            for row in 0..<Value(input).shape[0]:
                var cosRow: int32[]
                var sinRow: int32[]
                let rowOk = ModelExecutorRopeCosSinRowFill(cosRow, sinRow, invFreq, Value(basePos) + row)
                if IsErr(rowOk):
                    return Err[bool](Error(rowOk))
                for head in 0..<graph.attentionHeads:
                    let rotQ = ModelExecutorRopeRotateSpan(out, row, head * graph.headDim, graph.headDim, cosRow, sinRow)
                    if IsErr(rotQ):
                        return Err[bool](Error(rotQ))
        let putOk = ModelExecutorPutTensor(slots, op.outputName, out)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        let copyV = ModelExecutorCopyDerivedTensorIfPresent(slots, op.inputNames[0], op.outputName, ".v")
        if IsErr(copyV):
            return Err[bool](Error(copyV))
        let hashOk = ModelExecutorHashTensorInto(executionHash, out)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpAttention:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "attention")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let query = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(query):
            return Err[bool](Error(query))
        if Value(query).shape.len != 2 || Value(query).shape[0] <= 0 ||
           Value(query).shape[1] != graph.hiddenSize:
            return Err[bool]("model executor attention: token shape")
        let key = ModelExecutorFindTensor(slots, ModelExecutorDerivedTensorName(op.inputNames[0], ".k"))
        if IsErr(key):
            return Err[bool](Error(key))
        let value = ModelExecutorFindTensor(slots, ModelExecutorDerivedTensorName(op.inputNames[0], ".v"))
        if IsErr(value):
            return Err[bool](Error(value))
        let outWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(outWeight):
            return Err[bool](Error(outWeight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorPagedCausalAttentionFill(
            out,
            graph,
            store,
            op.layerIndex,
            Value(query),
            Value(key),
            Value(value),
            Value(outWeight),
            kvInput,
            hasKvInput,
            kvOutput,
            captureKv,
            executionHash,
            metalCtx
        )
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        let putOk = ModelExecutorPutTensor(slots, op.outputName, out)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        let hashOk = ModelExecutorHashTensorInto(executionHash, out)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpResidualAdd:
        let arityOk = ModelExecutorValidateOpArity(op, 2, 0, "residual")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let left = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(left):
            return Err[bool](Error(left))
        let right = ModelExecutorFindTensor(slots, op.inputNames[1])
        if IsErr(right):
            return Err[bool](Error(right))
        var out: infer.TensorQ
        let fillOk = ModelExecutorResidualAddFill(out, Value(left), Value(right))
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        let putOk = ModelExecutorPutTensor(slots, op.outputName, out)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        let hashOk = ModelExecutorHashTensorInto(executionHash, out)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpRouter:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "router")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var scores: infer.TensorQ
        let fillOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(scores, Value(input), store, Value(weight), "router", metalCtx)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        let routeRes = moe_router.MoeRouteTop2(scores.data, scores.shape[0], scores.shape[1], expertCapacity)
        if IsErr(routeRes):
            return Err[bool](Error(routeRes))
        latestRoute = Value(routeRes)
        let putRoute = ModelExecutorPutRoute(routeSlots, op.outputName, op.layerIndex, latestRoute)
        if IsErr(putRoute):
            return Err[bool](Error(putRoute))
        var hashOk = ModelExecutorHashTensorInto(executionHash, scores)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        executionHash = ModelExecutorHashStep(executionHash, latestRoute.routeHash)
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpExpert:
        let arityOk = ModelExecutorValidateOpArity(op, 2, 3, "expert")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        if op.expertId < 0 || op.expertId >= graph.expertCount:
            return Err[bool]("model executor expert: id")
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let route = ModelExecutorFindRoute(routeSlots, op.inputNames[1])
        if IsErr(route):
            return Err[bool](Error(route))
        let gateWeight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(gateWeight):
            return Err[bool](Error(gateWeight))
        let upWeight = ModelExecutorFindWeightPayload(store, op.weightNames[1])
        if IsErr(upWeight):
            return Err[bool](Error(upWeight))
        let downWeight = ModelExecutorFindWeightPayload(store, op.weightNames[2])
        if IsErr(downWeight):
            return Err[bool](Error(downWeight))
        var gate: infer.TensorQ
        let gateOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(gate, Value(input), store, Value(gateWeight), "expert_gate", metalCtx)
        if IsErr(gateOk):
            return Err[bool](Error(gateOk))
        var up: infer.TensorQ
        let upOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(up, Value(input), store, Value(upWeight), "expert_up", metalCtx)
        if IsErr(upOk):
            return Err[bool](Error(upOk))
        var activated: infer.TensorQ
        let swigluOk = ModelExecutorSwiGluFill(activated, gate, up)
        if IsErr(swigluOk):
            return Err[bool](Error(swigluOk))
        var out: infer.TensorQ
        let downOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, activated, store, Value(downWeight), "expert_down", metalCtx)
        if IsErr(downOk):
            return Err[bool](Error(downOk))
        let putOk = ModelExecutorPutTensor(slots, op.outputName, out)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        var hashOk = ModelExecutorHashTensorInto(executionHash, gate)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        hashOk = ModelExecutorHashTensorInto(executionHash, up)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        hashOk = ModelExecutorHashTensorInto(executionHash, out)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        route
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpMlp:
        if op.inputNames.len != graph.expertCount || op.weightNames.len != 0:
            return Err[bool]("model executor mlp: arity")
        let latestOk = moe_router.MoeValidateRoutePlan(latestRoute)
        if IsErr(latestOk):
            return Err[bool](Error(latestOk))
        var experts: infer.TensorQ[]
        for i in 0..<op.inputNames.len:
            let expert = ModelExecutorFindTensor(slots, op.inputNames[i])
            if IsErr(expert):
                return Err[bool](Error(expert))
            add(experts, Value(expert))
        var out: infer.TensorQ
        let combineOk = ModelExecutorCombineExpertSetFill(out, latestRoute, experts)
        if IsErr(combineOk):
            return Err[bool](Error(combineOk))
        let putOk = ModelExecutorPutTensor(slots, op.outputName, out)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        let hashOk = ModelExecutorHashTensorInto(executionHash, out)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        return Ok[bool](true)

    if op.opKind == model_graph.InferenceModelOpLmHead:
        let arityOk = ModelExecutorValidateOpArity(op, 1, 1, "lm_head")
        if IsErr(arityOk):
            return Err[bool](Error(arityOk))
        let input = ModelExecutorFindTensor(slots, op.inputNames[0])
        if IsErr(input):
            return Err[bool](Error(input))
        let weight = ModelExecutorFindWeightPayload(store, op.weightNames[0])
        if IsErr(weight):
            return Err[bool](Error(weight))
        var out: infer.TensorQ
        let fillOk = ModelExecutorLinearOutInStorePayloadMaybeMetalFill(out, Value(input), store, Value(weight), "lm_head", metalCtx)
        if IsErr(fillOk):
            return Err[bool](Error(fillOk))
        let putOk = ModelExecutorPutTensor(slots, op.outputName, out)
        if IsErr(putOk):
            return Err[bool](Error(putOk))
        let hashOk = ModelExecutorHashTensorInto(executionHash, out)
        if IsErr(hashOk):
            return Err[bool](Error(hashOk))
        executionHash = Value(hashOk)
        return Ok[bool](true)

    return Err[bool]("model executor hf glm moe: unsupported op")

fn ModelExecutorRouteSlotsToSet(routeSlots: ModelExecutorRouteSlot[]): Result[moe_router.MoeRoutePlanSet] =
    if routeSlots.len <= 0:
        return Err[moe_router.MoeRoutePlanSet]("model executor route set: empty")
    var layerRoutes: moe_router.MoeLayerRoutePlan[]
    for i in 0..<routeSlots.len:
        add(layerRoutes, moe_router.MoeLayerRoutePlan(
            layerIndex: routeSlots[i].layerIndex,
            routePlan: routeSlots[i].routePlan
        ))
    let set = moe_router.MoeRoutePlanSetBuild(layerRoutes)
    let setOk = moe_router.MoeValidateRoutePlanSet(set)
    if IsErr(setOk):
        return Err[moe_router.MoeRoutePlanSet](Error(setOk))
    return Ok[moe_router.MoeRoutePlanSet](set)

fn ModelExecutorLastRouteFromSet(set: moe_router.MoeRoutePlanSet): Result[moe_router.MoeRoutePlan] =
    let setOk = moe_router.MoeValidateRoutePlanSet(set)
    if IsErr(setOk):
        return Err[moe_router.MoeRoutePlan](Error(setOk))
    if set.layerRoutes.len <= 0:
        return Err[moe_router.MoeRoutePlan]("model executor route set: empty")
    return Ok[moe_router.MoeRoutePlan](set.layerRoutes[set.layerRoutes.len - 1].routePlan)

fn ModelExecutorBuildHfGlmMoeRoutePlan(graph: model_graph.ModelGraph,
                                       bindings: weight_binding.WeightBindingSet,
                                       store: weight_store.WeightTensorStore,
                                       tokenIds: infer.TensorQ,
                                       expertCapacity: int32): Result[moe_router.MoeRoutePlan] =
    let setRes = ModelExecutorBuildHfGlmMoeRoutePlanSet(graph, bindings, store, tokenIds, expertCapacity)
    if IsErr(setRes):
        return Err[moe_router.MoeRoutePlan](Error(setRes))
    return ModelExecutorLastRouteFromSet(Value(setRes))

fn ModelExecutorBuildHfGlmMoeRoutePlanSet(graph: model_graph.ModelGraph,
                                          bindings: weight_binding.WeightBindingSet,
                                          store: weight_store.WeightTensorStore,
                                          tokenIds: infer.TensorQ,
                                          expertCapacity: int32): Result[moe_router.MoeRoutePlanSet] =
    var emptyKv: ModelExecutorKvStateSet
    return ModelExecutorBuildHfGlmMoeRoutePlanSetWithKvState(
        graph,
        bindings,
        store,
        tokenIds,
        expertCapacity,
        emptyKv,
        false
    )

fn ModelExecutorBuildHfGlmMoeRoutePlanSetWithKvState(graph: model_graph.ModelGraph,
                                                     bindings: weight_binding.WeightBindingSet,
                                                     store: weight_store.WeightTensorStore,
                                                     tokenIds: infer.TensorQ,
                                                     expertCapacity: int32,
                                                     inputKvState: ModelExecutorKvStateSet,
                                                     hasInputKvState: bool): Result[moe_router.MoeRoutePlanSet] =
    let supportOk = ModelExecutorValidateHfGlmMoeTokensGraph(graph, bindings, store, tokenIds)
    if IsErr(supportOk):
        return Err[moe_router.MoeRoutePlanSet](Error(supportOk))
    if hasInputKvState:
        let kvOk = ModelExecutorValidateKvStateSet(inputKvState)
        if IsErr(kvOk):
            return Err[moe_router.MoeRoutePlanSet](Error(kvOk))
        if inputKvState.layerStates.len != graph.layerCount:
            return Err[moe_router.MoeRoutePlanSet]("model executor hf glm moe: kv layer count")
    var slots: ModelExecutorTensorSlot[]
    var routeSlots: ModelExecutorRouteSlot[]
    var kvOutput: ModelExecutorKvLayerState[]
    let putToken = ModelExecutorPutTensor(slots, "token_ids", tokenIds)
    if IsErr(putToken):
        return Err[moe_router.MoeRoutePlanSet](Error(putToken))
    var latestRoute: moe_router.MoeRoutePlan
    var executionHash: int64 = int64(131)
    var metalCtx = ModelExecutorMetalContextDisabled()
    for i in 0..<graph.ops.len:
        let inputKvStateIterRes = ModelExecutorKvStateSetClone(inputKvState)
        if IsErr(inputKvStateIterRes):
            return Err[moe_router.MoeRoutePlanSet](Error(inputKvStateIterRes))
        let inputKvStateIter = Value(inputKvStateIterRes)
        let opOk = ModelExecutorExecuteHfGlmMoeOp(
            graph,
            store,
            graph.ops[i],
            slots,
            routeSlots,
            inputKvStateIter,
            hasInputKvState,
            kvOutput,
            false,
            latestRoute,
            expertCapacity,
            executionHash,
            metalCtx
        )
        if IsErr(opOk):
            return Err[moe_router.MoeRoutePlanSet](Error(opOk))
    return ModelExecutorRouteSlotsToSet(routeSlots)

