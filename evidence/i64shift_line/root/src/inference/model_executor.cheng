fn ModelExecutorExecuteHfGlmMoeTokensWithKvStateWithMetalContext(graph: model_graph.ModelGraph,
                                                                 bindings: weight_binding.WeightBindingSet,
                                                                 store: weight_store.WeightTensorStore,
                                                                 tokenIds: infer.TensorQ,
                                                                 expectedRouteSet: moe_router.MoeRoutePlanSet,
                                                                 inputKvState: ModelExecutorKvStateSet,
                                                                 hasInputKvState: bool,
                                                                 metalCtx: var ModelExecutorMetalContext): Result[ModelExecutorOutputWithKv] =
    let supportOk = ModelExecutorValidateHfGlmMoeTokensGraph(graph, bindings, store, tokenIds)
    if IsErr(supportOk):
        return Err[ModelExecutorOutputWithKv](Error(supportOk))
    let expectedOk = moe_router.MoeValidateRoutePlanSet(expectedRouteSet)
    if IsErr(expectedOk):
        return Err[ModelExecutorOutputWithKv](Error(expectedOk))
    if expectedRouteSet.layerRoutes.len != graph.layerCount:
        return Err[ModelExecutorOutputWithKv]("model executor hf glm moe: route layer count")
    if hasInputKvState:
        let kvOk = ModelExecutorValidateKvStateSet(inputKvState)
        if IsErr(kvOk):
            return Err[ModelExecutorOutputWithKv](Error(kvOk))
        if inputKvState.layerStates.len != graph.layerCount:
            return Err[ModelExecutorOutputWithKv]("model executor hf glm moe: kv layer count")
    var slots: ModelExecutorTensorSlot[]
    var routeSlots: ModelExecutorRouteSlot[]
    var kvOutput: ModelExecutorKvLayerState[]
    let putToken = ModelExecutorPutTensor(slots, "token_ids", tokenIds)
    if IsErr(putToken):
        return Err[ModelExecutorOutputWithKv](Error(putToken))
    var latestRoute: moe_router.MoeRoutePlan
    var executionHash: int64 = int64(131)
    let expertCapacity = expectedRouteSet.layerRoutes[0].routePlan.expertCapacity
    for i in 0..<graph.ops.len:
        let inputKvStateIterRes = ModelExecutorKvStateSetClone(inputKvState)
        if IsErr(inputKvStateIterRes):
            return Err[ModelExecutorOutputWithKv](Error(inputKvStateIterRes))
        let inputKvStateIter = Value(inputKvStateIterRes)
        let opOk = ModelExecutorExecuteHfGlmMoeOp(
            graph,
            store,
            graph.ops[i],
            slots,
            routeSlots,
            inputKvStateIter,
            hasInputKvState,
            kvOutput,
            true,
            latestRoute,
            expertCapacity,
            executionHash,
            metalCtx
        )
        if IsErr(opOk):
            return Err[ModelExecutorOutputWithKv](Error(opOk))
    let latestOk = moe_router.MoeValidateRoutePlan(latestRoute)
    if IsErr(latestOk):
        return Err[ModelExecutorOutputWithKv](Error(latestOk))
    let actualRouteSet = ModelExecutorRouteSlotsToSet(routeSlots)
    if IsErr(actualRouteSet):
        return Err[ModelExecutorOutputWithKv](Error(actualRouteSet))
    if Value(actualRouteSet).routeSetHash != expectedRouteSet.routeSetHash:
        return Err[ModelExecutorOutputWithKv]("model executor hf glm moe: route set mismatch")
    if kvOutput.len != graph.layerCount:
        return Err[ModelExecutorOutputWithKv]("model executor hf glm moe: kv output layer count")
    let kvStateSet = ModelExecutorKvStateSetBuild(kvOutput)
    let kvOutOk = ModelExecutorValidateKvStateSet(kvStateSet)
    if IsErr(kvOutOk):
        return Err[ModelExecutorOutputWithKv](Error(kvOutOk))
    let logits = ModelExecutorFindTensor(slots, "logits")
    if IsErr(logits):
        return Err[ModelExecutorOutputWithKv](Error(logits))
    let outputHash = ModelExecutorOutputHash(Value(logits), latestRoute, Value(actualRouteSet))
    if IsErr(outputHash):
        return Err[ModelExecutorOutputWithKv](Error(outputHash))
    var finalExecutionHash = ModelExecutorHashStep(Value(outputHash), executionHash)
    finalExecutionHash = ModelExecutorHashStep(finalExecutionHash, kvStateSet.stateSetHash)
    let output = ModelExecutorOutput(
        logits: Value(logits),
        routePlan: latestRoute,
        routePlanSet: Value(actualRouteSet),
        executionHash: finalExecutionHash
    )
    return Ok[ModelExecutorOutputWithKv](ModelExecutorOutputWithKv(
        output: output,
        kvStateSet: kvStateSet
    ))

fn ModelExecutorExecuteHfGlmMoeTokensWithKvStateMetalQuantized(graph: model_graph.ModelGraph,
                                                              bindings: weight_binding.WeightBindingSet,
                                                              store: weight_store.WeightTensorStore,
                                                              tokenIds: infer.TensorQ,
                                                              expectedRouteSet: moe_router.MoeRoutePlanSet,
                                                              inputKvState: ModelExecutorKvStateSet,
                                                              hasInputKvState: bool,
                                                              metal: device.Device): Result[ModelExecutorOutputWithKv] =
    let metalCtxRes = ModelExecutorMetalContextEnabled(metal, true)
    if IsErr(metalCtxRes):
        return Err[ModelExecutorOutputWithKv](Error(metalCtxRes))
    var metalCtx = Value(metalCtxRes)
    let out = ModelExecutorExecuteHfGlmMoeTokensWithKvStateWithMetalContext(
        graph,
        bindings,
        store,
        tokenIds,
        expectedRouteSet,
        inputKvState,
        hasInputKvState,
        metalCtx
    )
    if IsErr(out):
        return Err[ModelExecutorOutputWithKv](Error(out))
    if metalCtx.launchedKernels <= 0:
        return Err[ModelExecutorOutputWithKv]("model executor metal: no kernel launched")
    let base = Value(out)
    var finalExecutionHash = ModelExecutorHashStep(base.output.executionHash, metalCtx.receiptHash)
    finalExecutionHash = ModelExecutorHashStep(finalExecutionHash, int64(metalCtx.launchedKernels))
    let output = ModelExecutorOutput(
        logits: base.output.logits,
        routePlan: base.output.routePlan,
        routePlanSet: base.output.routePlanSet,
        executionHash: finalExecutionHash
    )
    return Ok[ModelExecutorOutputWithKv](ModelExecutorOutputWithKv(
        output: output,
        kvStateSet: base.kvStateSet
    ))

