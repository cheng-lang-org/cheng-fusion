import std/result
import std/strings
import std/strutils as strutil
import std/rawbytes
import cheng/inference/kernel as infer

const
    ActivationTransportSchema = "cheng.inference.activation_transport.v1"
    ActivationTensorStoreSchema = "cheng.inference.activation_tensor_store.v1"
    ActivationTensorPayloadWireSchema = "cheng.inference.activation_tensor_payload_wire.v1"
    ActivationTensorPayloadWireHeaderWords = 16
    ActivationTensorPayloadWireHeaderBytes = 128

type
    ActivationEnvelope =
        schema: str
        enginePlanHash: int64
        sourcePeerId: str
        targetPeerId: str
        shardName: str
        seqNo: uint64
        tokenStart: int32
        tokenCount: int32
        featureStart: int32
        featureCount: int32
        payloadHash: int64
        prevEnvelopeHash: int64
        envelopeHash: int64

    ActivationTensorPayload =
        sourcePeerId: str
        targetPeerId: str
        shardName: str
        tokenStart: int32
        tokenCount: int32
        featureStart: int32
        featureCount: int32
        payloadHash: int64
        tensor: infer.TensorQ

    ActivationTensorStore =
        schema: str
        enginePlanHash: int64
        payloads: ActivationTensorPayload[]
        storeHash: int64

fn ActivationTransportHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(524287) + value + int64(97)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn ActivationTransportHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = ActivationTransportHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn ActivationTransportEnvelopeHash(envelope: ActivationEnvelope): int64 =
    var h: int64 = int64(97)
    h = ActivationTransportHashTextWith(h, envelope.schema)
    h = ActivationTransportHashStep(h, envelope.enginePlanHash)
    h = ActivationTransportHashTextWith(h, envelope.sourcePeerId)
    h = ActivationTransportHashTextWith(h, envelope.targetPeerId)
    h = ActivationTransportHashTextWith(h, envelope.shardName)
    h = ActivationTransportHashStep(h, int64(envelope.seqNo))
    h = ActivationTransportHashStep(h, int64(envelope.tokenStart))
    h = ActivationTransportHashStep(h, int64(envelope.tokenCount))
    h = ActivationTransportHashStep(h, int64(envelope.featureStart))
    h = ActivationTransportHashStep(h, int64(envelope.featureCount))
    h = ActivationTransportHashStep(h, envelope.payloadHash)
    h = ActivationTransportHashStep(h, envelope.prevEnvelopeHash)
    return h

@borrows
fn ActivationTensorHashValue(tensor: infer.TensorQ): Result[int64] =
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[int64](Error(tensorOk))
    var h: int64 = int64(97)
    h = ActivationTransportHashStep(h, int64(tensor.scale))
    for i in 0..<tensor.shape.len:
        h = ActivationTransportHashStep(h, int64(tensor.shape[i]))
    for i in 0..<tensor.data.len:
        h = ActivationTransportHashStep(h, int64(tensor.data[i]))
    if h <= int64(0):
        return Err[int64]("activation tensor store: tensor hash")
    return Ok[int64](h)

@borrows
fn ActivationTensorPayloadExpectedHash(sourcePeerId: str,
                                       targetPeerId: str,
                                       shardName: str,
                                       tokenStart: int32,
                                       tokenCount: int32,
                                       featureStart: int32,
                                       featureCount: int32,
                                       tensor: infer.TensorQ): Result[int64] =
    let tensorHash = ActivationTensorHashValue(tensor)
    if IsErr(tensorHash):
        return Err[int64](Error(tensorHash))
    var h: int64 = int64(97)
    h = ActivationTransportHashTextWith(h, ActivationTensorStoreSchema)
    h = ActivationTransportHashTextWith(h, sourcePeerId)
    h = ActivationTransportHashTextWith(h, targetPeerId)
    h = ActivationTransportHashTextWith(h, shardName)
    h = ActivationTransportHashStep(h, int64(tokenStart))
    h = ActivationTransportHashStep(h, int64(tokenCount))
    h = ActivationTransportHashStep(h, int64(featureStart))
    h = ActivationTransportHashStep(h, int64(featureCount))
    h = ActivationTransportHashStep(h, Value(tensorHash))
    if h <= int64(0):
        return Err[int64]("activation tensor store: payload hash")
    return Ok[int64](h)

@borrows
fn ActivationTensorPayloadHash(payload: ActivationTensorPayload): Result[int64] =
    return ActivationTensorPayloadExpectedHash(
        payload.sourcePeerId,
        payload.targetPeerId,
        payload.shardName,
        payload.tokenStart,
        payload.tokenCount,
        payload.featureStart,
        payload.featureCount,
        payload.tensor
    )

fn ActivationTensorPayloadBuild(sourcePeerId: str,
                                targetPeerId: str,
                                shardName: str,
                                tokenStart: int32,
                                tokenCount: int32,
                                featureStart: int32,
                                featureCount: int32,
                                tensor: infer.TensorQ): Result[ActivationTensorPayload] =
    if sourcePeerId == "" || targetPeerId == "" || shardName == "":
        return Err[ActivationTensorPayload]("activation tensor store: payload identity")
    if tokenStart < 0 || tokenCount <= 0 || featureStart < 0 || featureCount <= 0:
        return Err[ActivationTensorPayload]("activation tensor store: span")
    if tensor.shape.len != 2 || tensor.shape[0] != tokenCount || tensor.shape[1] != featureCount:
        return Err[ActivationTensorPayload]("activation tensor store: tensor shape")
    let payloadHash = ActivationTensorPayloadExpectedHash(
        sourcePeerId,
        targetPeerId,
        shardName,
        tokenStart,
        tokenCount,
        featureStart,
        featureCount,
        tensor
    )
    if IsErr(payloadHash):
        return Err[ActivationTensorPayload](Error(payloadHash))
    return Ok[ActivationTensorPayload](ActivationTensorPayload(
        sourcePeerId: sourcePeerId,
        targetPeerId: targetPeerId,
        shardName: shardName,
        tokenStart: tokenStart,
        tokenCount: tokenCount,
        featureStart: featureStart,
        featureCount: featureCount,
        payloadHash: Value(payloadHash),
        tensor: tensor
    ))

fn ActivationTransportBuildEnvelope(enginePlanHash: int64,
                                    sourcePeerId: str,
                                    targetPeerId: str,
                                    shardName: str,
                                    seqNo: uint64,
                                    tokenStart: int32,
                                    tokenCount: int32,
                                    featureStart: int32,
                                    featureCount: int32,
                                    payloadHash: int64,
                                    prevEnvelopeHash: int64): ActivationEnvelope =
    var envelope = ActivationEnvelope(
        schema: ActivationTransportSchema,
        enginePlanHash: enginePlanHash,
        sourcePeerId: sourcePeerId,
        targetPeerId: targetPeerId,
        shardName: shardName,
        seqNo: seqNo,
        tokenStart: tokenStart,
        tokenCount: tokenCount,
        featureStart: featureStart,
        featureCount: featureCount,
        payloadHash: payloadHash,
        prevEnvelopeHash: prevEnvelopeHash,
        envelopeHash: int64(0)
    )
    envelope.envelopeHash = ActivationTransportEnvelopeHash(envelope)
    return envelope

@borrows
fn ActivationTransportValidateEnvelope(envelope: ActivationEnvelope): Result[bool] =
    if envelope.schema != ActivationTransportSchema:
        return Err[bool]("activation transport: schema")
    if envelope.enginePlanHash <= int64(0):
        return Err[bool]("activation transport: plan hash")
    if envelope.sourcePeerId == "" || envelope.targetPeerId == "" || envelope.shardName == "":
        return Err[bool]("activation transport: identity")
    if envelope.tokenStart < 0 || envelope.tokenCount <= 0 || envelope.featureStart < 0 || envelope.featureCount <= 0:
        return Err[bool]("activation transport: span")
    if envelope.payloadHash <= int64(0):
        return Err[bool]("activation transport: payload hash")
    if ActivationTransportEnvelopeHash(envelope) != envelope.envelopeHash:
        return Err[bool]("activation transport: envelope hash mismatch")
    return Ok[bool](true)

@borrows
fn ActivationTransportValidateChain(envelopes: ActivationEnvelope[]): Result[bool] =
    if envelopes.len <= 0:
        return Err[bool]("activation transport: empty chain")
    for i in 0..<envelopes.len:
        let envelopeOk = ActivationTransportValidateEnvelope(envelopes[i])
        if IsErr(envelopeOk):
            return Err[bool](Error(envelopeOk))
        if envelopes[i].seqNo != uint64(i):
            return Err[bool]("activation transport: sequence")
        if i == 0:
            if envelopes[i].prevEnvelopeHash != int64(0):
                return Err[bool]("activation transport: first prev hash")
        else:
            if envelopes[i].enginePlanHash != envelopes[0].enginePlanHash:
                return Err[bool]("activation transport: plan hash drift")
            if envelopes[i].prevEnvelopeHash != envelopes[i - 1].envelopeHash:
                return Err[bool]("activation transport: prev hash")
        for j in i + 1..<envelopes.len:
            if envelopes[i].shardName == envelopes[j].shardName:
                return Err[bool]("activation transport: duplicate shard")
    return Ok[bool](true)

@borrows
fn ActivationTensorStoreHash(store: ActivationTensorStore): int64 =
    var h: int64 = int64(97)
    h = ActivationTransportHashTextWith(h, store.schema)
    h = ActivationTransportHashStep(h, store.enginePlanHash)
    for i in 0..<store.payloads.len:
        h = ActivationTransportHashTextWith(h, store.payloads[i].sourcePeerId)
        h = ActivationTransportHashTextWith(h, store.payloads[i].targetPeerId)
        h = ActivationTransportHashTextWith(h, store.payloads[i].shardName)
        h = ActivationTransportHashStep(h, int64(store.payloads[i].tokenStart))
        h = ActivationTransportHashStep(h, int64(store.payloads[i].tokenCount))
        h = ActivationTransportHashStep(h, int64(store.payloads[i].featureStart))
        h = ActivationTransportHashStep(h, int64(store.payloads[i].featureCount))
        h = ActivationTransportHashStep(h, store.payloads[i].payloadHash)
    return h

fn ActivationTensorStoreBuild(enginePlanHash: int64,
                              payloads: ActivationTensorPayload[]): ActivationTensorStore =
    var out = ActivationTensorStore(
        schema: ActivationTensorStoreSchema,
        enginePlanHash: enginePlanHash,
        payloads: payloads,
        storeHash: int64(0)
    )
    out.storeHash = ActivationTensorStoreHash(out)
    return out

@borrows
fn ActivationTensorPayloadValidate(payload: ActivationTensorPayload): Result[bool] =
    if payload.sourcePeerId == "" || payload.targetPeerId == "" || payload.shardName == "":
        return Err[bool]("activation tensor store: payload identity")
    if payload.tokenStart < 0 || payload.tokenCount <= 0 || payload.featureStart < 0 || payload.featureCount <= 0:
        return Err[bool]("activation tensor store: span")
    if payload.payloadHash <= int64(0):
        return Err[bool]("activation tensor store: payload hash")
    if payload.tensor.shape.len != 2 ||
       payload.tensor.shape[0] != payload.tokenCount ||
       payload.tensor.shape[1] != payload.featureCount:
        return Err[bool]("activation tensor store: tensor shape")
    let expected = ActivationTensorPayloadHash(payload)
    if IsErr(expected):
        return Err[bool](Error(expected))
    if Value(expected) != payload.payloadHash:
        return Err[bool]("activation tensor store: payload hash mismatch")
    return Ok[bool](true)

@borrows
fn ActivationTensorPayloadWireTextHash(text: str): int64 =
    return ActivationTransportHashTextWith(int64(83), text)

fn ActivationTensorPayloadWriteI64LE(buf: var rawbytes.Bytes, offset: int32, value: int64) =
    rawbytes.BytesSet(buf, offset, int32(value & int64(255)))
    rawbytes.BytesSet(buf, offset + 1, int32((value >> 8) & int64(255)))
    rawbytes.BytesSet(buf, offset + 2, int32((value >> 16) & int64(255)))
    rawbytes.BytesSet(buf, offset + 3, int32((value >> 24) & int64(255)))
    rawbytes.BytesSet(buf, offset + 4, int32((value >> 32) & int64(255)))
    rawbytes.BytesSet(buf, offset + 5, int32((value >> 40) & int64(255)))
    rawbytes.BytesSet(buf, offset + 6, int32((value >> 48) & int64(255)))
    rawbytes.BytesSet(buf, offset + 7, int32((value >> 56) & int64(255)))

@borrows
fn ActivationTensorPayloadReadI64LE(buf: rawbytes.Bytes, offset: int32): int64 =
    var out: int64
    out = int64(0)
    out = out + int64(rawbytes.BytesGet(buf, offset) & 255)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 1) & 255) << 8)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 2) & 255) << 16)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 3) & 255) << 24)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 4) & 255) << 32)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 5) & 255) << 40)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 6) & 255) << 48)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 7) & 255) << 56)
    return out

fn ActivationTensorPayloadWriteI32LE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, value & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(buf, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(buf, offset + 3, (value >> 24) & 255)

@borrows
fn ActivationTensorPayloadReadI32LE(buf: rawbytes.Bytes, offset: int32): int32 =
    let b0: int64 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1: int64 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2: int64 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3: int64 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    return int32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

@borrows
fn ActivationTensorPayloadWireByteCount(payload: ActivationTensorPayload): Result[int32] =
    let payloadOk = ActivationTensorPayloadValidate(payload)
    if IsErr(payloadOk):
        return Err[int32](Error(payloadOk))
    if payload.tensor.data.len > (2147483647 - ActivationTensorPayloadWireHeaderBytes) / 4:
        return Err[int32]("activation tensor payload wire: byte count overflow")
    return Ok[int32](ActivationTensorPayloadWireHeaderBytes + payload.tensor.data.len * 4)

@borrows
fn ActivationTensorPayloadWireWord(payload: ActivationTensorPayload,
                                   tensorHash: int64,
                                   index: int32): int64 =
    if index == 0:
        return ActivationTensorPayloadWireTextHash(ActivationTensorPayloadWireSchema)
    if index == 1:
        return ActivationTensorPayloadWireTextHash(ActivationTensorStoreSchema)
    if index == 2:
        return ActivationTensorPayloadWireTextHash(payload.sourcePeerId)
    if index == 3:
        return ActivationTensorPayloadWireTextHash(payload.targetPeerId)
    if index == 4:
        return ActivationTensorPayloadWireTextHash(payload.shardName)
    if index == 5:
        return int64(payload.tokenStart)
    if index == 6:
        return int64(payload.tokenCount)
    if index == 7:
        return int64(payload.featureStart)
    if index == 8:
        return int64(payload.featureCount)
    if index == 9:
        return payload.payloadHash
    if index == 10:
        return tensorHash
    if index == 11:
        return int64(payload.tensor.scale)
    if index == 12:
        return int64(payload.tensor.shape.len)
    if index == 13:
        return int64(payload.tensor.shape[0])
    if index == 14:
        return int64(payload.tensor.shape[1])
    if index == 15:
        return int64(payload.tensor.data.len)
    return int64(-1)

@borrows
fn ActivationTensorPayloadWireBytes(payload: ActivationTensorPayload): Result[rawbytes.Bytes] =
    let byteCount = ActivationTensorPayloadWireByteCount(payload)
    if IsErr(byteCount):
        return Err[rawbytes.Bytes](Error(byteCount))
    let tensorHash = ActivationTensorHashValue(payload.tensor)
    if IsErr(tensorHash):
        return Err[rawbytes.Bytes](Error(tensorHash))
    var out = rawbytes.BytesAlloc(Value(byteCount))
    if rawbytes.BytesLen(out) != Value(byteCount):
        return Err[rawbytes.Bytes]("activation tensor payload wire: allocation")
    for i in 0..<ActivationTensorPayloadWireHeaderWords:
        ActivationTensorPayloadWriteI64LE(out, i * 8, ActivationTensorPayloadWireWord(payload, Value(tensorHash), i))
    var offset: int32
    offset = ActivationTensorPayloadWireHeaderBytes
    for i in 0..<payload.tensor.data.len:
        ActivationTensorPayloadWriteI32LE(out, offset, payload.tensor.data[i])
        offset = offset + 4
    return Ok[rawbytes.Bytes](out)

@borrows
fn ActivationTensorPayloadValidateWire(payload: ActivationTensorPayload,
                                       bytes: rawbytes.Bytes): Result[bool] =
    let byteCount = ActivationTensorPayloadWireByteCount(payload)
    if IsErr(byteCount):
        return Err[bool](Error(byteCount))
    if rawbytes.BytesLen(bytes) != Value(byteCount):
        return Err[bool]("activation tensor payload wire: byte length")
    let tensorHash = ActivationTensorHashValue(payload.tensor)
    if IsErr(tensorHash):
        return Err[bool](Error(tensorHash))
    for i in 0..<ActivationTensorPayloadWireHeaderWords:
        let got = ActivationTensorPayloadReadI64LE(bytes, i * 8)
        let expected = ActivationTensorPayloadWireWord(payload, Value(tensorHash), i)
        if got != expected:
            return Err[bool](strutil.Join([
                "activation tensor payload wire: word mismatch index=",
                strings.Int64ToStr(int64(i))
            ], ""))
    var offset: int32
    offset = ActivationTensorPayloadWireHeaderBytes
    for i in 0..<payload.tensor.data.len:
        if ActivationTensorPayloadReadI32LE(bytes, offset) != payload.tensor.data[i]:
            return Err[bool](strutil.Join([
                "activation tensor payload wire: data mismatch index=",
                strings.Int64ToStr(int64(i))
            ], ""))
        offset = offset + 4
    return Ok[bool](true)

@borrows
fn ActivationTensorPayloadDecodeWire(envelope: ActivationEnvelope,
                                     bytes: rawbytes.Bytes): Result[ActivationTensorPayload] =
    let envelopeOk = ActivationTransportValidateEnvelope(envelope)
    if IsErr(envelopeOk):
        return Err[ActivationTensorPayload](Error(envelopeOk))
    if rawbytes.BytesLen(bytes) < ActivationTensorPayloadWireHeaderBytes:
        return Err[ActivationTensorPayload]("activation tensor payload wire: short header")
    if ActivationTensorPayloadReadI64LE(bytes, 0) != ActivationTensorPayloadWireTextHash(ActivationTensorPayloadWireSchema):
        return Err[ActivationTensorPayload]("activation tensor payload wire: schema")
    if ActivationTensorPayloadReadI64LE(bytes, 8) != ActivationTensorPayloadWireTextHash(ActivationTensorStoreSchema):
        return Err[ActivationTensorPayload]("activation tensor payload wire: store schema")
    if ActivationTensorPayloadReadI64LE(bytes, 16) != ActivationTensorPayloadWireTextHash(envelope.sourcePeerId) ||
       ActivationTensorPayloadReadI64LE(bytes, 24) != ActivationTensorPayloadWireTextHash(envelope.targetPeerId) ||
       ActivationTensorPayloadReadI64LE(bytes, 32) != ActivationTensorPayloadWireTextHash(envelope.shardName):
        return Err[ActivationTensorPayload]("activation tensor payload wire: identity")
    if ActivationTensorPayloadReadI64LE(bytes, 40) != int64(envelope.tokenStart) ||
       ActivationTensorPayloadReadI64LE(bytes, 48) != int64(envelope.tokenCount) ||
       ActivationTensorPayloadReadI64LE(bytes, 56) != int64(envelope.featureStart) ||
       ActivationTensorPayloadReadI64LE(bytes, 64) != int64(envelope.featureCount):
        return Err[ActivationTensorPayload]("activation tensor payload wire: span")
    if ActivationTensorPayloadReadI64LE(bytes, 72) != envelope.payloadHash:
        return Err[ActivationTensorPayload]("activation tensor payload wire: payload hash")
    let scale64 = ActivationTensorPayloadReadI64LE(bytes, 88)
    if scale64 <= int64(0) || scale64 > int64(2147483647):
        return Err[ActivationTensorPayload]("activation tensor payload wire: scale")
    let rank64 = ActivationTensorPayloadReadI64LE(bytes, 96)
    if rank64 != int64(2):
        return Err[ActivationTensorPayload]("activation tensor payload wire: rank")
    let shape0 = ActivationTensorPayloadReadI64LE(bytes, 104)
    let shape1 = ActivationTensorPayloadReadI64LE(bytes, 112)
    if shape0 <= int64(0) || shape1 <= int64(0) ||
       shape0 > int64(2147483647) || shape1 > int64(2147483647):
        return Err[ActivationTensorPayload]("activation tensor payload wire: shape")
    if shape0 != int64(envelope.tokenCount) || shape1 != int64(envelope.featureCount):
        return Err[ActivationTensorPayload]("activation tensor payload wire: envelope shape")
    let dataLen64 = ActivationTensorPayloadReadI64LE(bytes, 120)
    if dataLen64 != shape0 * shape1:
        return Err[ActivationTensorPayload]("activation tensor payload wire: data length")
    if dataLen64 > int64((2147483647 - ActivationTensorPayloadWireHeaderBytes) / 4):
        return Err[ActivationTensorPayload]("activation tensor payload wire: byte count overflow")
    let expectedByteCount = ActivationTensorPayloadWireHeaderBytes + int32(dataLen64) * 4
    if rawbytes.BytesLen(bytes) != expectedByteCount:
        return Err[ActivationTensorPayload]("activation tensor payload wire: byte length")
    var data: int32[]
    var offset: int32
    offset = ActivationTensorPayloadWireHeaderBytes
    for _ in 0..<int32(dataLen64):
        add(data, ActivationTensorPayloadReadI32LE(bytes, offset))
        offset = offset + 4
    var tensor: infer.TensorQ
    var shape: int32[]
    add(shape, int32(shape0))
    add(shape, int32(shape1))
    let tensorOk = infer.TensorFromDataFill(tensor, shape, int32(scale64), data)
    if IsErr(tensorOk):
        return Err[ActivationTensorPayload](Error(tensorOk))
    let payload = ActivationTensorPayloadBuild(
        strings.CloneStr(envelope.sourcePeerId),
        strings.CloneStr(envelope.targetPeerId),
        strings.CloneStr(envelope.shardName),
        envelope.tokenStart,
        envelope.tokenCount,
        envelope.featureStart,
        envelope.featureCount,
        tensor
    )
    if IsErr(payload):
        return Err[ActivationTensorPayload](Error(payload))
    let decodedPayload = Value(payload)
    if decodedPayload.payloadHash != envelope.payloadHash:
        return Err[ActivationTensorPayload]("activation tensor payload wire: payload hash mismatch")
    let wireOk = ActivationTensorPayloadValidateWire(decodedPayload, bytes)
    if IsErr(wireOk):
        return Err[ActivationTensorPayload](Error(wireOk))
    return Ok[ActivationTensorPayload](decodedPayload)

@borrows
fn ActivationTensorPayloadMatchesEnvelope(payload: ActivationTensorPayload,
                                          envelope: ActivationEnvelope): bool =
    if payload.sourcePeerId != envelope.sourcePeerId:
        return false
    if payload.targetPeerId != envelope.targetPeerId:
        return false
    if payload.shardName != envelope.shardName:
        return false
    if payload.tokenStart != envelope.tokenStart || payload.tokenCount != envelope.tokenCount:
        return false
    if payload.featureStart != envelope.featureStart || payload.featureCount != envelope.featureCount:
        return false
    if payload.payloadHash != envelope.payloadHash:
        return false
    return true

@borrows
fn ActivationTensorFindPayloadForEnvelope(store: ActivationTensorStore,
                                          envelope: ActivationEnvelope): int32 =
    var found: int32 = -1
    for i in 0..<store.payloads.len:
        if ActivationTensorPayloadMatchesEnvelope(store.payloads[i], envelope):
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn ActivationTransportValidateTensorStore(envelopes: ActivationEnvelope[],
                                          store: ActivationTensorStore): Result[bool] =
    let chainOk = ActivationTransportValidateChain(envelopes)
    if IsErr(chainOk):
        return Err[bool](Error(chainOk))
    if store.schema != ActivationTensorStoreSchema:
        return Err[bool]("activation tensor store: schema")
    if store.enginePlanHash != envelopes[0].enginePlanHash:
        return Err[bool]("activation tensor store: plan hash")
    if store.payloads.len != envelopes.len:
        return Err[bool]("activation tensor store: payload count")
    for i in 0..<store.payloads.len:
        let payloadOk = ActivationTensorPayloadValidate(store.payloads[i])
        if IsErr(payloadOk):
            return Err[bool](Error(payloadOk))
    for i in 0..<envelopes.len:
        let payloadIndex = ActivationTensorFindPayloadForEnvelope(store, envelopes[i])
        if payloadIndex == -2:
            return Err[bool]("activation tensor store: duplicate payload")
        if payloadIndex < 0:
            return Err[bool]("activation tensor store: missing payload")
    if ActivationTensorStoreHash(store) != store.storeHash:
        return Err[bool]("activation tensor store: hash mismatch")
    return Ok[bool](true)

@borrows
fn ActivationTensorAllGatherFill(out: var infer.TensorQ,
                                 envelopes: ActivationEnvelope[],
                                 store: ActivationTensorStore,
                                 tokenCount: int32,
                                 hiddenSize: int32): Result[bool] =
    let storeOk = ActivationTransportValidateTensorStore(envelopes, store)
    if IsErr(storeOk):
        return Err[bool](Error(storeOk))
    if tokenCount <= 0 || hiddenSize <= 0:
        return Err[bool]("activation all-gather: shape")
    if tokenCount > 2147483647 / hiddenSize:
        return Err[bool]("activation all-gather: element count overflow")
    let total = tokenCount * hiddenSize
    var scale: int32
    scale = 0
    var data: int32[]
    var coverage: int32[]
    for _ in 0..<total:
        add(data, 0)
        add(coverage, 0)
    for i in 0..<store.payloads.len:
        let payload = store.payloads[i]
        if payload.tokenStart < 0 || payload.tokenCount <= 0 ||
           payload.featureStart < 0 || payload.featureCount <= 0:
            return Err[bool]("activation all-gather: payload span")
        if payload.tokenStart + payload.tokenCount > tokenCount:
            return Err[bool]("activation all-gather: token bounds")
        if payload.featureStart + payload.featureCount > hiddenSize:
            return Err[bool]("activation all-gather: feature bounds")
        if payload.tensor.scale <= 0:
            return Err[bool]("activation all-gather: tensor scale")
        if scale == 0:
            scale = payload.tensor.scale
        elif payload.tensor.scale != scale:
            return Err[bool]("activation all-gather: scale drift")
        for row in 0..<payload.tokenCount:
            for col in 0..<payload.featureCount:
                let dst = (payload.tokenStart + row) * hiddenSize + payload.featureStart + col
                if coverage[dst] != 0:
                    return Err[bool]("activation all-gather: overlap")
                coverage[dst] = 1
                data[dst] = payload.tensor.data[row * payload.featureCount + col]
    for i in 0..<coverage.len:
        if coverage[i] != 1:
            return Err[bool]("activation all-gather: incomplete coverage")
    out.shape = [tokenCount, hiddenSize]
    out.scale = scale
    out.data = data
    return Ok[bool](true)

@borrows
fn ActivationTransportChainHash(envelopes: ActivationEnvelope[]): Result[int64] =
    let chainOk = ActivationTransportValidateChain(envelopes)
    if IsErr(chainOk):
        return Err[int64](Error(chainOk))
    var h: int64 = int64(97)
    for i in 0..<envelopes.len:
        h = ActivationTransportHashStep(h, envelopes[i].envelopeHash)
    if h <= int64(0):
        return Err[int64]("activation transport: chain hash")
    return Ok[int64](h)

@borrows
fn ActivationTransportExecutionHash(envelopes: ActivationEnvelope[],
                                    store: ActivationTensorStore): Result[int64] =
    let storeOk = ActivationTransportValidateTensorStore(envelopes, store)
    if IsErr(storeOk):
        return Err[int64](Error(storeOk))
    let chainHash = ActivationTransportChainHash(envelopes)
    if IsErr(chainHash):
        return Err[int64](Error(chainHash))
    var h: int64 = int64(97)
    h = ActivationTransportHashStep(h, Value(chainHash))
    h = ActivationTransportHashStep(h, store.storeHash)
    if h <= int64(0):
        return Err[int64]("activation transport: execution hash")
    return Ok[int64](h)

@borrows
fn ActivationTensorStoreFacts(store: ActivationTensorStore): str[] =
    var out: str[]
    add(out, strutil.Join(["activation_tensor_store_schema=", strings.CloneStr(store.schema)], ""))
    add(out, strutil.Join(["activation_tensor_store_plan_hash=", strings.Int64ToStr(store.enginePlanHash)], ""))
    add(out, strutil.Join(["activation_tensor_store_hash=", strings.Int64ToStr(store.storeHash)], ""))
    for i in 0..<store.payloads.len:
        add(out, strutil.Join([
            "activation_tensor_payload=",
            strings.CloneStr(store.payloads[i].shardName),
            ":",
            strings.CloneStr(store.payloads[i].sourcePeerId),
            ":",
            strings.CloneStr(store.payloads[i].targetPeerId),
            ":",
            strings.Int64ToStr(store.payloads[i].payloadHash)
        ], ""))
    return out

@borrows
fn ActivationTransportFacts(envelopes: ActivationEnvelope[]): str[] =
    var out: str[]
    for i in 0..<envelopes.len:
        add(out, strutil.Join([
            "activation_transport=",
            strings.Int64ToStr(envelopes[i].enginePlanHash),
            ":",
            strings.Int64ToStr(int64(envelopes[i].seqNo)),
            ":",
            strings.CloneStr(envelopes[i].sourcePeerId),
            ":",
            strings.CloneStr(envelopes[i].targetPeerId),
            ":",
            strings.CloneStr(envelopes[i].shardName),
            ":",
            strings.Int64ToStr(envelopes[i].payloadHash),
            ":",
            strings.Int64ToStr(envelopes[i].envelopeHash)
        ], ""))
    return out
