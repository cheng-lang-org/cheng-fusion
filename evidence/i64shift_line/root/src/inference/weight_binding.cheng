import std/result
import std/strings
import std/strutils as strutil
import cheng/inference/model_graph

const
    WeightBindingSchema = "cheng.inference.weight_binding.v1"

type
    WeightShardBinding =
        modelCid: str
        tensorName: str
        shardCid: str
        dtype: str
        quantScheme: str
        sizeBytes: int64
        peerId: str
        payloadHash: int64

    WeightBindingSet =
        schema: str
        modelCid: str
        bindings: WeightShardBinding[]
        bindingHash: int64

fn WeightBindingHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(262147) + value + int64(79)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn WeightBindingHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = WeightBindingHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn WeightBindingSetHash(set: WeightBindingSet): int64 =
    var h: int64 = int64(79)
    h = WeightBindingHashTextWith(h, set.schema)
    h = WeightBindingHashTextWith(h, set.modelCid)
    for i in 0..<set.bindings.len:
        h = WeightBindingHashTextWith(h, set.bindings[i].modelCid)
        h = WeightBindingHashTextWith(h, set.bindings[i].tensorName)
        h = WeightBindingHashTextWith(h, set.bindings[i].shardCid)
        h = WeightBindingHashTextWith(h, set.bindings[i].dtype)
        h = WeightBindingHashTextWith(h, set.bindings[i].quantScheme)
        h = WeightBindingHashStep(h, set.bindings[i].sizeBytes)
        h = WeightBindingHashTextWith(h, set.bindings[i].peerId)
        h = WeightBindingHashStep(h, set.bindings[i].payloadHash)
    return h

fn WeightBindingBuildSet(modelCid: str, bindings: WeightShardBinding[]): WeightBindingSet =
    var out = WeightBindingSet(
        schema: WeightBindingSchema,
        modelCid: modelCid,
        bindings: bindings,
        bindingHash: int64(0)
    )
    out.bindingHash = WeightBindingSetHash(out)
    return out

@borrows
fn WeightBindingMatchesGraphWeight(binding: WeightShardBinding,
                                   weight: model_graph.ModelWeightShard): bool =
    if binding.modelCid != weight.modelCid:
        return false
    if binding.tensorName != weight.tensorName:
        return false
    if binding.shardCid != weight.shardCid:
        return false
    if binding.dtype != weight.dtype:
        return false
    if binding.quantScheme != weight.quantScheme:
        return false
    if binding.sizeBytes != weight.sizeBytes:
        return false
    return true

@borrows
fn WeightBindingFindForWeight(set: WeightBindingSet,
                              weight: model_graph.ModelWeightShard): int32 =
    var found: int32 = -1
    for i in 0..<set.bindings.len:
        if WeightBindingMatchesGraphWeight(set.bindings[i], weight):
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn WeightBindingFindGraphWeight(graph: model_graph.ModelGraph,
                                binding: WeightShardBinding): int32 =
    var found: int32 = -1
    for i in 0..<graph.weights.len:
        if WeightBindingMatchesGraphWeight(binding, graph.weights[i]):
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn WeightBindingValidate(set: WeightBindingSet,
                         graph: model_graph.ModelGraph): Result[bool] =
    if set.schema != WeightBindingSchema:
        return Err[bool]("weight binding: schema")
    if set.modelCid == "" || set.modelCid != graph.modelCid:
        return Err[bool]("weight binding: model cid")
    if set.bindings.len != graph.weights.len:
        return Err[bool]("weight binding: binding count")
    for i in 0..<set.bindings.len:
        if set.bindings[i].peerId == "":
            return Err[bool]("weight binding: peer")
        if set.bindings[i].payloadHash <= int64(0):
            return Err[bool]("weight binding: payload hash")
        let graphIndex = WeightBindingFindGraphWeight(graph, set.bindings[i])
        if graphIndex < 0:
            return Err[bool]("weight binding: extra binding")
        if graph.weights[graphIndex].expectedPayloadHash > int64(0) &&
           set.bindings[i].payloadHash != graph.weights[graphIndex].expectedPayloadHash:
            return Err[bool]("weight binding: expected payload hash")
    for i in 0..<graph.weights.len:
        let bindIndex = WeightBindingFindForWeight(set, graph.weights[i])
        if bindIndex < 0:
            return Err[bool]("weight binding: missing binding")
    if WeightBindingSetHash(set) != set.bindingHash:
        return Err[bool]("weight binding: hash mismatch")
    return Ok[bool](true)

fn WeightBindingFacts(set: WeightBindingSet): str[] =
    var out: str[]
    add(out, strutil.Join(["weight_binding_schema=", share(set.schema)], ""))
    add(out, strutil.Join(["weight_binding_model=", share(set.modelCid)], ""))
    add(out, strutil.Join(["weight_binding_hash=", strings.Int64ToStr(set.bindingHash)], ""))
    for i in 0..<set.bindings.len:
        add(out, strutil.Join([
            "weight_binding=",
            set.bindings[i].tensorName,
            ":",
            set.bindings[i].shardCid,
            ":",
            set.bindings[i].peerId,
            ":",
            strings.Int64ToStr(set.bindings[i].payloadHash)
        ], ""))
    return out
