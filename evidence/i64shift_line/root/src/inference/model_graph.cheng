import std/result
import std/strings
import std/strutils as strutil
import cheng/inference/kernel_ir

const
    InferenceModelGraphSchema = "cheng.inference.model_graph.v1"
    InferenceModelOpEmbedding = "embedding"
    InferenceModelOpRmsNorm = "rmsnorm"
    InferenceModelOpQkv = "qkv"
    InferenceModelOpRope = "rope"
    InferenceModelOpAttention = "attention"
    InferenceModelOpMlaQCompress = "mla_q_compress"
    InferenceModelOpMlaKvCompress = "mla_kv_compress"
    InferenceModelOpDsaIndexer = "dsa_indexer"
    InferenceModelOpMtpProject = "mtp_project"
    InferenceModelOpResidualAdd = "residual_add"
    InferenceModelOpMlp = "mlp"
    InferenceModelOpRouter = "router"
    InferenceModelOpExpert = "expert"
    InferenceModelOpLmHead = "lm_head"
    InferenceModelArchitectureHfGlm52DsaMlaMtp = "hf_glm52_dsa_mla_mtp"
    InferenceModelArchitectureDenseTransformer = "dense_transformer"
    InferenceModelArchitectureHfQwen38HybridMtp = "hf_qwen38_hybrid_mtp"
    # Inventory-only mirror of rope_parameters.partial_rotary_factor parsed by
    # hf_qwen38_graph.cheng for the pinned Qwen/Qwen3.8-27B config; ModelGraph
    # has no matching scalar field, so ModelGraphFacts reports it verbatim.
    ModelGraphQwen38PartialRotaryFactor = "0.25"
    ModelQuantSchemeNone = "none"
    ModelQuantSchemeSymmetricInt8 = "symmetric_int8"
    ModelQuantSchemeSymmetricInt4 = "symmetric_int4"
    ModelQuantSchemeW4Afp8 = "w4afp8"

type
    ModelTensorDesc =
        name: str
        dtype: str
        shape: int32[]
        quantScheme: str

    ModelWeightShard =
        modelCid: str
        shardCid: str
        tensorName: str
        dtype: str
        quantScheme: str
        shape: int32[]
        sizeBytes: int64
        expectedPayloadHash: int64

    ModelGraphOp =
        opKind: str
        inputNames: str[]
        outputName: str
        weightNames: str[]
        layerIndex: int32
        expertId: int32

    ModelGraph =
        schema: str
        modelCid: str
        architecture: str
        hiddenSize: int32
        attentionHeads: int32
        keyValueHeads: int32
        headDim: int32
        layerCount: int32
        expertCount: int32
        topK: int32
        qLoraRank: int32
        kvLoraRank: int32
        qkHeadDim: int32
        qkNopeHeadDim: int32
        qkRopeHeadDim: int32
        vHeadDim: int32
        denseLayerCount: int32
        sharedExpertCount: int32
        mtpLayerCount: int32
        mtpStartLayer: int32
        indexHeads: int32
        indexHeadDim: int32
        indexTopK: int32
        indexTopKFreq: int32
        ropeTheta: float64
        tensors: ModelTensorDesc[]
        weights: ModelWeightShard[]
        ops: ModelGraphOp[]
        graphHash: int64

fn ModelGraphHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1315423911) + value + int64(31)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn ModelGraphHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = ModelGraphHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn ModelGraphHashIntsWith(hashRaw: int64, values: int32[]): int64 =
    var h: int64 = hashRaw
    for i in 0..<values.len:
        h = ModelGraphHashStep(h, int64(values[i]))
    return h

@borrows
fn ModelGraphTensorElementCount(shape: int32[]): Result[int64] =
    if shape.len <= 0:
        return Err[int64]("model graph: tensor rank")
    var total: int64 = int64(1)
    for i in 0..<shape.len:
        if shape[i] <= 0:
            return Err[int64]("model graph: tensor dim")
        if total > int64(9223372036854775807) / int64(shape[i]):
            return Err[int64]("model graph: tensor count overflow")
        total = total * int64(shape[i])
    return Ok[int64](total)

@borrows
fn ModelGraphDtypeBytes(dtype: str): Result[int64] =
    if dtype == kernel_ir.KernelDtypeFp16 || dtype == kernel_ir.KernelDtypeBf16:
        return Ok[int64](int64(2))
    if dtype == kernel_ir.KernelDtypeFp8E4M3 || dtype == kernel_ir.KernelDtypeInt8:
        return Ok[int64](int64(1))
    return Err[int64]("model graph: unsupported weight dtype")

@borrows
fn ModelGraphExpectedTensorBytes(dtype: str, shape: int32[]): Result[int64] =
    let countRes = ModelGraphTensorElementCount(shape)
    if IsErr(countRes):
        return Err[int64](Error(countRes))
    if dtype == kernel_ir.KernelDtypeInt4:
        return Ok[int64](Value(countRes) / int64(2) + Value(countRes) % int64(2))
    let dtypeBytesRes = ModelGraphDtypeBytes(dtype)
    if IsErr(dtypeBytesRes):
        return Err[int64](Error(dtypeBytesRes))
    if Value(countRes) > int64(9223372036854775807) / Value(dtypeBytesRes):
        return Err[int64]("model graph: tensor bytes overflow")
    return Ok[int64](Value(countRes) * Value(dtypeBytesRes))

@borrows
fn ModelGraphWeightQuantSchemeValid(dtype: str, quantScheme: str): Result[bool] =
    if quantScheme == ModelQuantSchemeNone:
        if dtype == kernel_ir.KernelDtypeInt8 || dtype == kernel_ir.KernelDtypeInt4:
            return Err[bool]("model graph: quant scheme")
        return Ok[bool](true)
    if quantScheme == ModelQuantSchemeSymmetricInt8:
        if dtype != kernel_ir.KernelDtypeInt8:
            return Err[bool]("model graph: symmetric int8 quant dtype")
        return Ok[bool](true)
    if quantScheme == ModelQuantSchemeSymmetricInt4:
        if dtype != kernel_ir.KernelDtypeInt4:
            return Err[bool]("model graph: symmetric int4 quant dtype")
        return Ok[bool](true)
    if quantScheme == ModelQuantSchemeW4Afp8:
        if dtype != kernel_ir.KernelDtypeInt8:
            return Err[bool]("model graph: w4afp8 quant dtype")
        return Ok[bool](true)
    return Err[bool]("model graph: unsupported quant scheme")

@borrows
fn ModelGraphHash(graph: ModelGraph): int64 =
    var h: int64 = int64(31)
    h = ModelGraphHashTextWith(h, graph.schema)
    h = ModelGraphHashTextWith(h, graph.modelCid)
    h = ModelGraphHashTextWith(h, graph.architecture)
    h = ModelGraphHashStep(h, int64(graph.hiddenSize))
    h = ModelGraphHashStep(h, int64(graph.attentionHeads))
    h = ModelGraphHashStep(h, int64(graph.keyValueHeads))
    h = ModelGraphHashStep(h, int64(graph.headDim))
    h = ModelGraphHashStep(h, int64(graph.layerCount))
    h = ModelGraphHashStep(h, int64(graph.expertCount))
    h = ModelGraphHashStep(h, int64(graph.topK))
    h = ModelGraphHashStep(h, int64(graph.qLoraRank))
    h = ModelGraphHashStep(h, int64(graph.kvLoraRank))
    h = ModelGraphHashStep(h, int64(graph.qkHeadDim))
    h = ModelGraphHashStep(h, int64(graph.qkNopeHeadDim))
    h = ModelGraphHashStep(h, int64(graph.qkRopeHeadDim))
    h = ModelGraphHashStep(h, int64(graph.vHeadDim))
    h = ModelGraphHashStep(h, int64(graph.denseLayerCount))
    h = ModelGraphHashStep(h, int64(graph.sharedExpertCount))
    h = ModelGraphHashStep(h, int64(graph.mtpLayerCount))
    h = ModelGraphHashStep(h, int64(graph.mtpStartLayer))
    h = ModelGraphHashStep(h, int64(graph.indexHeads))
    h = ModelGraphHashStep(h, int64(graph.indexHeadDim))
    h = ModelGraphHashStep(h, int64(graph.indexTopK))
    h = ModelGraphHashStep(h, int64(graph.indexTopKFreq))
    h = ModelGraphHashStep(h, int64(graph.ropeTheta * 1000000.0))
    for i in 0..<graph.tensors.len:
        h = ModelGraphHashTextWith(h, graph.tensors[i].name)
        h = ModelGraphHashTextWith(h, graph.tensors[i].dtype)
        h = ModelGraphHashIntsWith(h, graph.tensors[i].shape)
        h = ModelGraphHashTextWith(h, graph.tensors[i].quantScheme)
    for i in 0..<graph.weights.len:
        h = ModelGraphHashTextWith(h, graph.weights[i].modelCid)
        h = ModelGraphHashTextWith(h, graph.weights[i].shardCid)
        h = ModelGraphHashTextWith(h, graph.weights[i].tensorName)
        h = ModelGraphHashTextWith(h, graph.weights[i].dtype)
        h = ModelGraphHashTextWith(h, graph.weights[i].quantScheme)
        h = ModelGraphHashIntsWith(h, graph.weights[i].shape)
        h = ModelGraphHashStep(h, graph.weights[i].sizeBytes)
        h = ModelGraphHashStep(h, graph.weights[i].expectedPayloadHash)
    for i in 0..<graph.ops.len:
        h = ModelGraphHashTextWith(h, graph.ops[i].opKind)
        for j in 0..<graph.ops[i].inputNames.len:
            h = ModelGraphHashTextWith(h, graph.ops[i].inputNames[j])
        h = ModelGraphHashTextWith(h, graph.ops[i].outputName)
        for j in 0..<graph.ops[i].weightNames.len:
            h = ModelGraphHashTextWith(h, graph.ops[i].weightNames[j])
        h = ModelGraphHashStep(h, int64(graph.ops[i].layerIndex))
        h = ModelGraphHashStep(h, int64(graph.ops[i].expertId))
    return h

@borrows
fn ModelGraphHasWeight(graph: ModelGraph, tensorName: str): bool =
    for i in 0..<graph.weights.len:
        if graph.weights[i].tensorName == tensorName:
            return true
    return false

@borrows
fn ModelGraphValidate(graph: ModelGraph): Result[bool] =
    if graph.schema != InferenceModelGraphSchema:
        return Err[bool]("model graph: schema")
    if graph.modelCid == "" || graph.architecture == "":
        return Err[bool]("model graph: identity")
    if graph.hiddenSize <= 0 || graph.attentionHeads <= 0 || graph.keyValueHeads <= 0 ||
       graph.headDim <= 0 || graph.layerCount <= 0:
        return Err[bool]("model graph: dimensions")
    if graph.architecture != InferenceModelArchitectureHfQwen38HybridMtp:
        if graph.expertCount <= 0 || graph.topK <= 0:
            return Err[bool]("model graph: dimensions")
    if (graph.ropeTheta - 1.0) + 1000000000000000.0 < 1000000000000000.0:
        return Err[bool]("model graph: rope theta")
    if graph.architecture == InferenceModelArchitectureHfGlm52DsaMlaMtp:
        if graph.attentionHeads != graph.keyValueHeads:
            return Err[bool]("model graph: glm52 dsa kv heads")
        if graph.qLoraRank <= 0 || graph.kvLoraRank <= 0 ||
           graph.qkHeadDim <= 0 || graph.qkNopeHeadDim <= 0 ||
           graph.qkRopeHeadDim <= 0 || graph.vHeadDim <= 0:
            return Err[bool]("model graph: glm52 mla dimensions")
        if graph.qkHeadDim != graph.qkNopeHeadDim + graph.qkRopeHeadDim:
            return Err[bool]("model graph: glm52 qk dimensions")
        if graph.denseLayerCount <= 0 || graph.denseLayerCount >= graph.layerCount ||
           graph.sharedExpertCount <= 0 || graph.mtpLayerCount <= 0 ||
           graph.mtpStartLayer != graph.layerCount:
            return Err[bool]("model graph: glm52 layer dimensions")
        if graph.indexHeads <= 0 || graph.indexHeadDim <= 0 ||
           graph.indexTopK <= 0 || graph.indexTopKFreq <= 0:
            return Err[bool]("model graph: glm52 dsa dimensions")
    elif graph.architecture == InferenceModelArchitectureHfQwen38HybridMtp:
        # Pinned Qwen/Qwen3.8-27B hybrid shape: 64 layers, full attention
        # every 4th layer, 1 MTP layer. The full-attention interval itself has
        # no ModelGraph scalar field, so it is only recorded by ModelGraphFacts.
        if graph.attentionHeads % graph.keyValueHeads != 0:
            return Err[bool]("model graph: qwen38 grouped kv divisibility")
        if graph.hiddenSize % graph.headDim != 0:
            return Err[bool]("model graph: qwen38 hidden head dim divisibility")
        if graph.layerCount != 64:
            return Err[bool]("model graph: qwen38 layer count")
        if graph.keyValueHeads != 4:
            return Err[bool]("model graph: qwen38 kv heads")
        if graph.mtpLayerCount != 1:
            return Err[bool]("model graph: qwen38 mtp layers")
        if graph.mtpStartLayer != graph.layerCount:
            return Err[bool]("model graph: qwen38 mtp start layer")
        if graph.expertCount < 0 || graph.topK < 0:
            return Err[bool]("model graph: qwen38 moe fields")
    else:
        if graph.attentionHeads < graph.keyValueHeads ||
           int64(graph.attentionHeads) * int64(graph.headDim) != int64(graph.hiddenSize):
            return Err[bool]("model graph: attention dimensions")
        if graph.attentionHeads % graph.keyValueHeads != 0:
            return Err[bool]("model graph: grouped kv divisibility")
    if graph.tensors.len <= 0 || graph.weights.len <= 0 || graph.ops.len <= 0:
        return Err[bool]("model graph: empty graph")
    for i in 0..<graph.tensors.len:
        if graph.tensors[i].name == "" || graph.tensors[i].dtype == "" || graph.tensors[i].shape.len <= 0:
            return Err[bool]("model graph: tensor")
        if graph.tensors[i].quantScheme != ModelQuantSchemeNone:
            return Err[bool]("model graph: tensor quant scheme")
    for i in 0..<graph.weights.len:
        if graph.weights[i].modelCid != graph.modelCid:
            return Err[bool]("model graph: weight model cid")
        if graph.weights[i].shardCid == "" || graph.weights[i].tensorName == "":
            return Err[bool]("model graph: weight identity")
        let quantOk = ModelGraphWeightQuantSchemeValid(graph.weights[i].dtype, graph.weights[i].quantScheme)
        if IsErr(quantOk):
            return Err[bool](Error(quantOk))
        if graph.weights[i].shape.len <= 0:
            return Err[bool]("model graph: weight shape")
        let expectedBytes = ModelGraphExpectedTensorBytes(graph.weights[i].dtype, graph.weights[i].shape)
        if IsErr(expectedBytes):
            return Err[bool](Error(expectedBytes))
        if graph.weights[i].sizeBytes <= int64(0):
            return Err[bool]("model graph: weight size")
        if graph.weights[i].sizeBytes != Value(expectedBytes):
            return Err[bool]("model graph: weight byte size")
        if graph.weights[i].expectedPayloadHash < int64(0):
            return Err[bool]("model graph: weight expected payload hash")
    for i in 0..<graph.ops.len:
        if graph.ops[i].opKind == "" || graph.ops[i].outputName == "":
            return Err[bool]("model graph: op")
        for j in 0..<graph.ops[i].weightNames.len:
            if !ModelGraphHasWeight(graph, graph.ops[i].weightNames[j]):
                return Err[bool]("model graph: op weight missing")
    if ModelGraphHash(graph) != graph.graphHash:
        return Err[bool]("model graph: hash mismatch")
    return Ok[bool](true)

@borrows
fn ModelGraphValidateExpectedWeightPayloadHashes(graph: ModelGraph): Result[bool] =
    let graphOk = ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    for i in 0..<graph.weights.len:
        if graph.weights[i].expectedPayloadHash <= int64(0):
            return Err[bool]("model graph: missing expected weight payload hash")
    return Ok[bool](true)

fn ModelGraphBuildTinyGlmMoeFixture(modelCid: str): ModelGraph =
    let hidden: int32 = 4
    let tensors = [
        ModelTensorDesc(name: "token_ids", dtype: "int32", shape: [2], quantScheme: "none"),
        ModelTensorDesc(name: "hidden", dtype: kernel_ir.KernelDtypeFp16, shape: [2, hidden], quantScheme: "none"),
        ModelTensorDesc(name: "logits", dtype: kernel_ir.KernelDtypeFp16, shape: [2, 8], quantScheme: "none")
    ]
    let weights = [
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny:embedding", tensorName: "embedding.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [8, hidden], sizeBytes: int64(64), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny:norm", tensorName: "layer0.norm.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden], sizeBytes: int64(8), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny:qkv", tensorName: "layer0.qkv.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny:router", tensorName: "layer0.router.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, 2], sizeBytes: int64(16), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny:expert0", tensorName: "layer0.expert0.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny:expert1", tensorName: "layer0.expert1.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny:lm_head", tensorName: "lm_head.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, 8], sizeBytes: int64(64), expectedPayloadHash: int64(0))
    ]
    let ops = [
        ModelGraphOp(opKind: InferenceModelOpEmbedding, inputNames: ["token_ids"], outputName: "hidden", weightNames: ["embedding.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpRmsNorm, inputNames: ["hidden"], outputName: "norm0", weightNames: ["layer0.norm.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpQkv, inputNames: ["norm0"], outputName: "qkv0", weightNames: ["layer0.qkv.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpRope, inputNames: ["qkv0"], outputName: "rope0", weightNames: [], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpAttention, inputNames: ["rope0"], outputName: "attn0", weightNames: [], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpRouter, inputNames: ["attn0"], outputName: "route0", weightNames: ["layer0.router.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpExpert, inputNames: ["attn0", "route0"], outputName: "expert0", weightNames: ["layer0.expert0.weight"], layerIndex: 0, expertId: 0),
        ModelGraphOp(opKind: InferenceModelOpExpert, inputNames: ["attn0", "route0"], outputName: "expert1", weightNames: ["layer0.expert1.weight"], layerIndex: 0, expertId: 1),
        ModelGraphOp(opKind: InferenceModelOpLmHead, inputNames: ["expert0", "expert1"], outputName: "logits", weightNames: ["lm_head.weight"], layerIndex: 0, expertId: -1)
    ]
    var graph = ModelGraph(
        schema: InferenceModelGraphSchema,
        modelCid: modelCid,
        architecture: "glm_moe_tiny_fixture",
        hiddenSize: hidden,
        attentionHeads: 1,
        keyValueHeads: 1,
        headDim: hidden,
        layerCount: 1,
        expertCount: 2,
        topK: 2,
        ropeTheta: 10000.0,
        tensors: tensors,
        weights: weights,
        ops: ops,
        graphHash: int64(0)
    )
    graph.graphHash = ModelGraphHash(graph)
    return graph

