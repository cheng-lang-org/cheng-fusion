fn ModelGraphBuildTinyGlm52DsaMlaMtpFixture(modelCid: str): ModelGraph =
    let hidden: int32 = 4
    let vocab: int32 = 8
    let qLora: int32 = 4
    let kvLora: int32 = 4
    let qkNope: int32 = 2
    let qkRope: int32 = 2
    let qkHead: int32 = qkNope + qkRope
    let vHead: int32 = 4
    let kvCompressed: int32 = kvLora + qkRope
    let kvProjected: int32 = qkNope + vHead
    let indexDim: int32 = 2
    let tensors = [
        ModelTensorDesc(name: "token_ids", dtype: "int32", shape: [2], quantScheme: "none"),
        ModelTensorDesc(name: "hidden0", dtype: kernel_ir.KernelDtypeFp16, shape: [2, hidden], quantScheme: "none"),
        ModelTensorDesc(name: "logits", dtype: kernel_ir.KernelDtypeFp16, shape: [2, vocab], quantScheme: "none")
    ]
    let weights = [
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:embedding", tensorName: "model.embed_tokens.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [vocab, hidden], sizeBytes: int64(64), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:q_a", tensorName: "model.layers.0.self_attn.q_a_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [qLora, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:q_a_norm", tensorName: "model.layers.0.self_attn.q_a_layernorm.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [qLora], sizeBytes: int64(8), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:q_b", tensorName: "model.layers.0.self_attn.q_b_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [qkHead, qLora], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:kv_a", tensorName: "model.layers.0.self_attn.kv_a_proj_with_mqa.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [kvCompressed, hidden], sizeBytes: int64(48), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:kv_a_norm", tensorName: "model.layers.0.self_attn.kv_a_layernorm.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [kvLora], sizeBytes: int64(8), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:kv_b", tensorName: "model.layers.0.self_attn.kv_b_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [kvProjected, kvLora], sizeBytes: int64(48), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:indexer", tensorName: "model.layers.0.self_attn.indexer.wq_b.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [indexDim, qkHead], sizeBytes: int64(16), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:o_proj", tensorName: "model.layers.0.self_attn.o_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, vHead], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:dense_down", tensorName: "model.layers.0.mlp.down_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:router0", tensorName: "model.layers.1.mlp.gate.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [2, hidden], sizeBytes: int64(16), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:expert0_gate", tensorName: "model.layers.1.mlp.experts.0.gate_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:expert0_up", tensorName: "model.layers.1.mlp.experts.0.up_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:expert0_down", tensorName: "model.layers.1.mlp.experts.0.down_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:expert1_gate", tensorName: "model.layers.1.mlp.experts.1.gate_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:expert1_up", tensorName: "model.layers.1.mlp.experts.1.up_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:expert1_down", tensorName: "model.layers.1.mlp.experts.1.down_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:shared_down", tensorName: "model.layers.1.mlp.shared_experts.down_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:mtp_eh", tensorName: "model.layers.2.eh_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:mtp_hnorm", tensorName: "model.layers.2.hnorm.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden], sizeBytes: int64(8), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:mtp_shared_norm", tensorName: "model.layers.2.shared_head.norm.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [hidden], sizeBytes: int64(8), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:mtp_q_a", tensorName: "model.layers.2.self_attn.q_a_proj.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [qkHead, hidden], sizeBytes: int64(32), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:router_mtp", tensorName: "model.layers.2.mlp.gate.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [2, qkHead], sizeBytes: int64(16), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:final_norm", tensorName: "model.norm.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [qkHead], sizeBytes: int64(8), expectedPayloadHash: int64(0)),
        ModelWeightShard(modelCid: modelCid, shardCid: "cid:tiny52:lm_head", tensorName: "lm_head.weight", dtype: kernel_ir.KernelDtypeFp16, quantScheme: "none", shape: [vocab, qkHead], sizeBytes: int64(64), expectedPayloadHash: int64(0))
    ]
    let ops = [
        ModelGraphOp(opKind: InferenceModelOpEmbedding, inputNames: ["token_ids"], outputName: "hidden0", weightNames: ["model.embed_tokens.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpMlaQCompress, inputNames: ["hidden0"], outputName: "layer0.mla_q", weightNames: ["model.layers.0.self_attn.q_a_proj.weight", "model.layers.0.self_attn.q_a_layernorm.weight", "model.layers.0.self_attn.q_b_proj.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpMlaKvCompress, inputNames: ["hidden0"], outputName: "layer0.mla_kv", weightNames: ["model.layers.0.self_attn.kv_a_proj_with_mqa.weight", "model.layers.0.self_attn.kv_a_layernorm.weight", "model.layers.0.self_attn.kv_b_proj.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpDsaIndexer, inputNames: ["layer0.mla_q"], outputName: "layer0.dsa_index", weightNames: ["model.layers.0.self_attn.indexer.wq_b.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpAttention, inputNames: ["layer0.mla_q", "layer0.mla_kv", "layer0.dsa_index"], outputName: "layer0.attention", weightNames: ["model.layers.0.self_attn.o_proj.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpMlp, inputNames: ["layer0.attention"], outputName: "layer0.dense_mlp", weightNames: ["model.layers.0.mlp.down_proj.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpRouter, inputNames: ["layer0.dense_mlp"], outputName: "layer0.route", weightNames: ["model.layers.1.mlp.gate.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpExpert, inputNames: ["layer0.dense_mlp", "layer0.route"], outputName: "layer0.expert0", weightNames: ["model.layers.1.mlp.experts.0.gate_proj.weight", "model.layers.1.mlp.experts.0.up_proj.weight", "model.layers.1.mlp.experts.0.down_proj.weight"], layerIndex: 0, expertId: 0),
        ModelGraphOp(opKind: InferenceModelOpExpert, inputNames: ["layer0.dense_mlp", "layer0.route"], outputName: "layer0.expert1", weightNames: ["model.layers.1.mlp.experts.1.gate_proj.weight", "model.layers.1.mlp.experts.1.up_proj.weight", "model.layers.1.mlp.experts.1.down_proj.weight"], layerIndex: 0, expertId: 1),
        ModelGraphOp(opKind: InferenceModelOpMlp, inputNames: ["layer0.expert0", "layer0.expert1"], outputName: "layer0.expert_mix", weightNames: [], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpMlp, inputNames: ["layer0.expert_mix"], outputName: "layer0.shared_expert", weightNames: ["model.layers.1.mlp.shared_experts.down_proj.weight"], layerIndex: 1, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpMtpProject, inputNames: ["layer0.shared_expert"], outputName: "layer2.mtp", weightNames: ["model.layers.2.eh_proj.weight", "model.layers.2.hnorm.weight", "model.layers.2.shared_head.norm.weight"], layerIndex: 2, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpMlaQCompress, inputNames: ["layer2.mtp"], outputName: "layer2.mla_q", weightNames: ["model.layers.2.self_attn.q_a_proj.weight"], layerIndex: 2, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpRouter, inputNames: ["layer2.mla_q"], outputName: "layer2.route", weightNames: ["model.layers.2.mlp.gate.weight"], layerIndex: 1, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpLmHead, inputNames: ["layer2.mla_q"], outputName: "logits", weightNames: ["model.norm.weight", "lm_head.weight"], layerIndex: 2, expertId: -1)
    ]
    var graph = ModelGraph(
        schema: InferenceModelGraphSchema,
        modelCid: modelCid,
        architecture: InferenceModelArchitectureHfGlm52DsaMlaMtp,
        hiddenSize: hidden,
        attentionHeads: 1,
        keyValueHeads: 1,
        headDim: hidden,
        layerCount: 2,
        expertCount: 2,
        topK: 2,
        qLoraRank: qLora,
        kvLoraRank: kvLora,
        qkHeadDim: qkHead,
        qkNopeHeadDim: qkNope,
        qkRopeHeadDim: qkRope,
        vHeadDim: vHead,
        denseLayerCount: 1,
        sharedExpertCount: 1,
        mtpLayerCount: 1,
        mtpStartLayer: 2,
        indexHeads: 1,
        indexHeadDim: indexDim,
        indexTopK: 1,
        indexTopKFreq: 1,
        ropeTheta: 10000.0,
        tensors: tensors,
        weights: weights,
        ops: ops,
        graphHash: int64(0)
    )
    graph.graphHash = ModelGraphHash(graph)
    return graph

@borrows
fn ModelGraphBindExpectedWeightPayloadHashes(graph: ModelGraph,
                                             payloadHashes: int64[]): Result[ModelGraph] =
    let graphOk = ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[ModelGraph](Error(graphOk))
    if payloadHashes.len != graph.weights.len:
        return Err[ModelGraph]("model graph: expected payload hash count")
    var weights: ModelWeightShard[]
    for i in 0..<graph.weights.len:
        var weight = graph.weights[i]
        if payloadHashes[i] <= int64(0):
            return Err[ModelGraph]("model graph: expected payload hash")
        weight.expectedPayloadHash = payloadHashes[i]
        add(weights, weight)
    var out = graph
    out.weights = weights
    out.graphHash = ModelGraphHash(out)
    let outOk = ModelGraphValidate(out)
    if IsErr(outOk):
        return Err[ModelGraph](Error(outOk))
    return Ok[ModelGraph](out)

fn ModelGraphFacts(graph: ModelGraph): str[] =
    var out: str[]
    # str[] literal elements must be owned (field access is Borrowed per
    # docs/cheng-formal-spec.md; see findings.md STRARR-BORROWED-LITERAL-CLASS),
    # so borrowed graph fields are cloned before joining.
    add(out, strutil.Join(["model_graph_schema=", strings.CloneStr(graph.schema)], ""))
    add(out, strutil.Join(["model_cid=", strings.CloneStr(graph.modelCid)], ""))
    add(out, strutil.Join(["architecture=", strings.CloneStr(graph.architecture)], ""))
    add(out, strutil.Join(["graph_hash=", strings.Int64ToStr(graph.graphHash)], ""))
    if graph.architecture == InferenceModelArchitectureHfGlm52DsaMlaMtp:
        add(out, strutil.Join(["glm52_q_lora_rank=", strings.IntToStr(graph.qLoraRank)], ""))
        add(out, strutil.Join(["glm52_kv_lora_rank=", strings.IntToStr(graph.kvLoraRank)], ""))
        add(out, strutil.Join(["glm52_qk_head_dim=", strings.IntToStr(graph.qkHeadDim)], ""))
        add(out, strutil.Join(["glm52_v_head_dim=", strings.IntToStr(graph.vHeadDim)], ""))
        add(out, strutil.Join(["glm52_mtp_layers=", strings.IntToStr(graph.mtpLayerCount)], ""))
        add(out, strutil.Join(["glm52_index_topk=", strings.IntToStr(graph.indexTopK)], ""))
    if graph.architecture == InferenceModelArchitectureHfQwen38HybridMtp:
        var fullLayers: int32 = 0
        for i in 0..<graph.ops.len:
            if graph.ops[i].opKind == InferenceModelOpQkv:
                fullLayers = fullLayers + 1
        let linearLayers = graph.layerCount - fullLayers
        var fullInterval: int32 = 0
        if fullLayers > 0:
            fullInterval = graph.layerCount / fullLayers
        add(out, strutil.Join(["qwen38_full_layers=", strings.IntToStr(fullLayers)], ""))
        add(out, strutil.Join(["qwen38_linear_layers=", strings.IntToStr(linearLayers)], ""))
        add(out, strutil.Join(["qwen38_full_interval=", strings.IntToStr(fullInterval)], ""))
        add(out, strutil.Join(["qwen38_mtp_layers=", strings.IntToStr(graph.mtpLayerCount)], ""))
        add(out, strutil.Join(["qwen38_partial_rotary=", strings.CloneStr(ModelGraphQwen38PartialRotaryFactor)], ""))
    for i in 0..<graph.weights.len:
        add(out, strutil.Join([
            "weight_shard=",
            strings.CloneStr(graph.weights[i].tensorName),
            ":",
            strings.CloneStr(graph.weights[i].shardCid),
            ":",
            strings.CloneStr(graph.weights[i].dtype),
            ":",
            strings.CloneStr(graph.weights[i].quantScheme),
            ":",
            strings.Int64ToStr(graph.weights[i].expectedPayloadHash)
        ], ""))
    return out
