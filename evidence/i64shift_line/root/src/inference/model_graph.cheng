        ModelGraphOp(opKind: InferenceModelOpAttention, inputNames: ["rope0"], outputName: "attn0", weightNames: [], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpRmsNorm, inputNames: ["attn0"], outputName: "norm1", weightNames: ["layer0.norm1.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpMlp, inputNames: ["norm1"], outputName: "mlp0", weightNames: ["layer0.mlp.weight"], layerIndex: 0, expertId: -1),
        ModelGraphOp(opKind: InferenceModelOpLmHead, inputNames: ["mlp0"], outputName: "logits", weightNames: ["lm_head.weight"], layerIndex: 0, expertId: -1)
