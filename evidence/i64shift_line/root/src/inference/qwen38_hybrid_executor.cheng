import std/result
import std/strutils as strutil
import cheng/inference/gated_delta_net as gdn
import cheng/inference/hf_qwen38_graph as hfq
import cheng/inference/model_graph as mg

const
    Qwen38HybridExecutorSchema = "cheng.inference.qwen38_hybrid_executor.v1"
    Qwen38HybridPinnedLayerCount = 64
    Qwen38HybridPinnedFullInterval = 4
    Qwen38HybridPinnedFullLayerCount = 16
    Qwen38HybridPinnedLinearLayerCount = 48
    Qwen38HybridPinnedHiddenSize = 5120
    Qwen38HybridLayerKindGdn = 0
    Qwen38HybridLayerKindFull = 1

type
    Qwen38HybridLayerPlan =
        schema: str
        layerCount: int32
        fullAttentionInterval: int32
        fullLayerCount: int32
        layerIndex: int32[]
        isFullAttention: bool[]
        fullIntervalPos: int32[]
        planHash: int64

    Qwen38HybridExecutionTrace =
        schema: str
        layerCount: int32
        layerKindCode: int32[]
        kvStateHash: int64[]
        deltaStateHash: int64[]
        traceHash: int64

fn Qwen38HybridExecutorHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1315423911) + value + int64(97)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn Qwen38HybridExecutorHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = Qwen38HybridExecutorHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn Qwen38HybridExecutorHashIntsWith(hashRaw: int64, values: int32[]): int64 =
    var h: int64 = hashRaw
    for i in 0..<values.len:
        h = Qwen38HybridExecutorHashStep(h, int64(values[i]))
    return h

@borrows
fn Qwen38HybridExecutorHashI64sWith(hashRaw: int64, values: int64[]): int64 =
    var h: int64 = hashRaw
    for i in 0..<values.len:
        h = Qwen38HybridExecutorHashStep(h, values[i])
    return h

@borrows
fn Qwen38HybridLayerPlanHash(plan: Qwen38HybridLayerPlan): int64 =
    var h: int64 = int64(977)
    h = Qwen38HybridExecutorHashTextWith(h, plan.schema)
    h = Qwen38HybridExecutorHashStep(h, int64(plan.layerCount))
    h = Qwen38HybridExecutorHashStep(h, int64(plan.fullAttentionInterval))
    h = Qwen38HybridExecutorHashStep(h, int64(plan.fullLayerCount))
    h = Qwen38HybridExecutorHashIntsWith(h, plan.layerIndex)
    for i in 0..<plan.isFullAttention.len:
        if plan.isFullAttention[i]:
            h = Qwen38HybridExecutorHashStep(h, int64(1))
        else:
            h = Qwen38HybridExecutorHashStep(h, int64(0))
    h = Qwen38HybridExecutorHashIntsWith(h, plan.fullIntervalPos)
    return h

@borrows
fn Qwen38HybridExecutionTraceHash(trace: Qwen38HybridExecutionTrace): int64 =
    var h: int64 = int64(977)
    h = Qwen38HybridExecutorHashTextWith(h, trace.schema)
    h = Qwen38HybridExecutorHashStep(h, int64(trace.layerCount))
    h = Qwen38HybridExecutorHashIntsWith(h, trace.layerKindCode)
    h = Qwen38HybridExecutorHashI64sWith(h, trace.kvStateHash)
    h = Qwen38HybridExecutorHashI64sWith(h, trace.deltaStateHash)
    return h

@borrows
fn Qwen38HybridLayerPlanValidateSelf(plan: Qwen38HybridLayerPlan): Result[bool] =
    if plan.schema != Qwen38HybridExecutorSchema:
        return Err[bool]("qwen38 hybrid executor plan: schema")
    let n = plan.layerCount
    if n <= 0 || plan.layerIndex.len != n ||
       plan.isFullAttention.len != n || plan.fullIntervalPos.len != n:
        return Err[bool]("qwen38 hybrid executor plan: layer array length")
    if plan.fullAttentionInterval != Qwen38HybridPinnedFullInterval:
        return Err[bool]("qwen38 hybrid executor plan: full attention interval")
    var fullCount: int32 = 0
    for i in 0..<n:
        if plan.layerIndex[i] != i:
            return Err[bool]("qwen38 hybrid executor plan: layer order")
        if plan.fullIntervalPos[i] != i % plan.fullAttentionInterval:
            return Err[bool]("qwen38 hybrid executor plan: interval pos")
        let wantFull = ((i + 1) % plan.fullAttentionInterval) == 0
        if plan.isFullAttention[i]:
            if !wantFull:
                return Err[bool]("qwen38 hybrid executor plan: full layer spacing")
            fullCount = fullCount + 1
        else:
            if wantFull:
                return Err[bool]("qwen38 hybrid executor plan: full layer spacing")
    if plan.fullLayerCount != fullCount:
        return Err[bool]("qwen38 hybrid executor plan: full layer count")
    if plan.fullLayerCount != Qwen38HybridPinnedFullLayerCount:
        return Err[bool]("qwen38 hybrid executor plan: full layer count")
    if Qwen38HybridLayerPlanHash(plan) != plan.planHash:
        return Err[bool]("qwen38 hybrid executor plan: hash")
    return Ok[bool](true)

fn Qwen38HybridLayerPlanBuild(profile: hfq.HfQwen38DeployProfile): Result[Qwen38HybridLayerPlan] =
    let profileOk = hfq.HfQwen38ValidateProfile(profile)
    if IsErr(profileOk):
        return Err[Qwen38HybridLayerPlan](Error(profileOk))
    if profile.text.layerCount != Qwen38HybridPinnedLayerCount:
        return Err[Qwen38HybridLayerPlan]("qwen38 hybrid executor plan: layer count")
    if profile.text.fullAttentionInterval != Qwen38HybridPinnedFullInterval:
        return Err[Qwen38HybridLayerPlan]("qwen38 hybrid executor plan: full attention interval")
    let codes = profile.text.layerTypeCodes
    if codes.len != Qwen38HybridPinnedLayerCount:
        return Err[Qwen38HybridLayerPlan]("qwen38 hybrid executor plan: layer types length")
    if profile.text.linearNumKeyHeads != gdn.GatedDeltaNetKeyHeads ||
       profile.text.linearNumValueHeads != gdn.GatedDeltaNetValueHeads ||
       profile.text.linearKeyHeadDim != gdn.GatedDeltaNetHeadDim ||
       profile.text.linearValueHeadDim != gdn.GatedDeltaNetHeadDim ||
       profile.text.linearConvKernelDim != gdn.GatedDeltaNetConvKernel:
        return Err[Qwen38HybridLayerPlan]("qwen38 hybrid executor plan: gdn kernel geometry")
    var layerIndex: int32[]
    var isFullAttention: bool[]
    var fullIntervalPos: int32[]
    var fullCount: int32 = 0
    for i in 0..<codes.len:
        let code = codes[i]
        let atFullSlot = ((i + 1) % Qwen38HybridPinnedFullInterval) == 0
        if code != 0 && code != 1:
            return Err[Qwen38HybridLayerPlan]("qwen38 hybrid executor plan: layer type code")
        if code == 1:
            if !atFullSlot:
                return Err[Qwen38HybridLayerPlan]("qwen38 hybrid executor plan: full layer spacing")
            fullCount = fullCount + 1
        else:
            if atFullSlot:
                return Err[Qwen38HybridLayerPlan]("qwen38 hybrid executor plan: full layer spacing")
        add(layerIndex, i)
        if code == 1:
            add(isFullAttention, true)
        else:
            add(isFullAttention, false)
        add(fullIntervalPos, i % Qwen38HybridPinnedFullInterval)
    if fullCount != Qwen38HybridPinnedFullLayerCount:
        return Err[Qwen38HybridLayerPlan]("qwen38 hybrid executor plan: full layer count")
    var out = Qwen38HybridLayerPlan(
        schema: Qwen38HybridExecutorSchema,
        layerCount: Qwen38HybridPinnedLayerCount,
        fullAttentionInterval: Qwen38HybridPinnedFullInterval,
        fullLayerCount: fullCount,
        layerIndex: layerIndex,
        isFullAttention: isFullAttention,
        fullIntervalPos: fullIntervalPos,
        planHash: int64(0)
    )
    out.planHash = Qwen38HybridLayerPlanHash(out)
    return Ok[Qwen38HybridLayerPlan](out)

@borrows
fn Qwen38HybridLayerPlanIsFullAttention(plan: Qwen38HybridLayerPlan,
                                        layerIndex: int32): Result[bool] =
    if plan.schema != Qwen38HybridExecutorSchema:
        return Err[bool]("qwen38 hybrid executor plan: schema")
    if layerIndex < 0 || layerIndex >= plan.layerCount:
        return Err[bool]("qwen38 hybrid executor plan: layer index")
    return Ok[bool](plan.isFullAttention[layerIndex])

@borrows
fn Qwen38HybridForwardPlanValidate(plan: Qwen38HybridLayerPlan,
                                   graph: mg.ModelGraph): Result[bool] =
    let planOk = Qwen38HybridLayerPlanValidateSelf(plan)
    if IsErr(planOk):
        return Err[bool](Error(planOk))
    let graphOk = mg.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    if graph.architecture != mg.InferenceModelArchitectureHfQwen38HybridMtp:
        return Err[bool]("qwen38 hybrid executor plan: graph architecture")
    if plan.layerCount != graph.layerCount:
        return Err[bool]("qwen38 hybrid executor plan: graph layer count")
    if graph.hiddenSize != Qwen38HybridPinnedHiddenSize:
        return Err[bool]("qwen38 hybrid executor plan: graph hidden size")
    if graph.mtpLayerCount != 1:
        return Err[bool]("qwen38 hybrid executor plan: graph mtp layers")
    if graph.mtpStartLayer != graph.layerCount:
        return Err[bool]("qwen38 hybrid executor plan: graph mtp start")
    var qkvCount: int32 = 0
    var gdnCount: int32 = 0
    for i in 0..<graph.ops.len:
        let op = graph.ops[i]
        let li = op.layerIndex
        if op.opKind == mg.InferenceModelOpQkv:
            qkvCount = qkvCount + 1
            if li < 0 || li >= plan.layerCount || !plan.isFullAttention[li]:
                return Err[bool]("qwen38 hybrid executor plan: qkv layer dispatch")
        elif op.opKind == hfq.HfQwen38OpGdnConv || op.opKind == hfq.HfQwen38OpGdnDelta:
            gdnCount = gdnCount + 1
            if li < 0 || li >= plan.layerCount || plan.isFullAttention[li]:
                return Err[bool]("qwen38 hybrid executor plan: gdn layer dispatch")
    if qkvCount != Qwen38HybridPinnedFullLayerCount:
        return Err[bool]("qwen38 hybrid executor plan: qkv op count")
    if gdnCount != Qwen38HybridPinnedLinearLayerCount * 2:
        return Err[bool]("qwen38 hybrid executor plan: gdn op count")
    return Ok[bool](true)

@borrows
fn Qwen38HybridExecutionTraceBuild(plan: Qwen38HybridLayerPlan,
                                   kvStateHashes: int64[],
                                   deltaStateHashes: int64[]): Result[Qwen38HybridExecutionTrace] =
    let planOk = Qwen38HybridLayerPlanValidateSelf(plan)
    if IsErr(planOk):
        return Err[Qwen38HybridExecutionTrace](Error(planOk))
    if kvStateHashes.len != plan.layerCount || deltaStateHashes.len != plan.layerCount:
        return Err[Qwen38HybridExecutionTrace]("qwen38 hybrid executor trace: array length")
    var kinds: int32[]
    var kvCopy: int64[]
    var deltaCopy: int64[]
    for i in 0..<plan.layerCount:
        if kvStateHashes[i] <= int64(0) || deltaStateHashes[i] <= int64(0):
            return Err[Qwen38HybridExecutionTrace]("qwen38 hybrid executor trace: unrecorded layer state")
        if plan.isFullAttention[i]:
            add(kinds, Qwen38HybridLayerKindFull)
        else:
            add(kinds, Qwen38HybridLayerKindGdn)
        add(kvCopy, kvStateHashes[i])
        add(deltaCopy, deltaStateHashes[i])
    var out = Qwen38HybridExecutionTrace(
        schema: Qwen38HybridExecutorSchema,
        layerCount: plan.layerCount,
        layerKindCode: kinds,
        kvStateHash: kvCopy,
        deltaStateHash: deltaCopy,
        traceHash: int64(0)
    )
    out.traceHash = Qwen38HybridExecutionTraceHash(out)
    return Ok[Qwen38HybridExecutionTrace](out)

@borrows
fn Qwen38HybridExecutionTraceValidate(trace: Qwen38HybridExecutionTrace): Result[bool] =
    if trace.schema != Qwen38HybridExecutorSchema:
        return Err[bool]("qwen38 hybrid executor trace: schema")
    let n = trace.layerCount
    if n <= 0 || trace.layerKindCode.len != n ||
       trace.kvStateHash.len != n || trace.deltaStateHash.len != n:
        return Err[bool]("qwen38 hybrid executor trace: array length")
    for i in 0..<n:
        if trace.layerKindCode[i] != Qwen38HybridLayerKindGdn &&
           trace.layerKindCode[i] != Qwen38HybridLayerKindFull:
            return Err[bool]("qwen38 hybrid executor trace: layer kind")
        if trace.kvStateHash[i] <= int64(0) || trace.deltaStateHash[i] <= int64(0):
            return Err[bool]("qwen38 hybrid executor trace: unrecorded layer state")
    if Qwen38HybridExecutionTraceHash(trace) != trace.traceHash:
        return Err[bool]("qwen38 hybrid executor trace: hash")
    return Ok[bool](true)

@borrows
fn qwen38MtpFindWeightIndex(graph: mg.ModelGraph, tensorName: str): Result[int32] =
    var found: int32 = -1
    for i in 0..<graph.weights.len:
        if graph.weights[i].tensorName == tensorName:
            if found >= 0:
                return Err[int32](strutil.Join(["qwen38 hybrid executor mtp contract: duplicate weight ",
                                                share(tensorName)], ""))
            found = i
    if found < 0:
        return Err[int32](strutil.Join(["qwen38 hybrid executor mtp contract: missing weight ",
                                        share(tensorName)], ""))
    return Ok[int32](found)

@borrows
fn qwen38MtpFindUniqueOpIndexByKind(graph: mg.ModelGraph, opKind: str): Result[int32] =
    var found: int32 = -1
    for i in 0..<graph.ops.len:
        if graph.ops[i].opKind == opKind:
            if found >= 0:
                return Err[int32](strutil.Join(["qwen38 hybrid executor mtp contract: duplicate op ",
                                                share(opKind)], ""))
            found = i
    if found < 0:
        return Err[int32](strutil.Join(["qwen38 hybrid executor mtp contract: missing op ",
                                        share(opKind)], ""))
    return Ok[int32](found)

@borrows
fn Qwen38MtpDraftStepContract(graph: mg.ModelGraph,
                              lastHiddenWidth: int32,
                              vocabSize: int32,
                              embeddingBoundName: str,
                              dedicatedEmbedding: bool): Result[bool] =
    if graph.schema != mg.InferenceModelGraphSchema:
        return Err[bool]("qwen38 hybrid executor mtp contract: schema")
    if graph.architecture != mg.InferenceModelArchitectureHfQwen38HybridMtp:
        return Err[bool]("qwen38 hybrid executor mtp contract: architecture")
    if graph.mtpLayerCount != 1:
        return Err[bool]("qwen38 hybrid executor mtp contract: mtp layers")
    if dedicatedEmbedding:
        return Err[bool]("qwen38 hybrid executor mtp contract: dedicated embedding not bound")
    if lastHiddenWidth != Qwen38HybridPinnedHiddenSize || graph.hiddenSize != Qwen38HybridPinnedHiddenSize:
        return Err[bool]("qwen38 hybrid executor mtp contract: hidden size")
    if vocabSize <= 0:
        return Err[bool]("qwen38 hybrid executor mtp contract: vocab size")
    let embedName = "model.embed_tokens.weight"
    if embeddingBoundName != embedName:
        return Err[bool]("qwen38 hybrid executor mtp contract: embedding binding")
    let ehProjName = "model.mtp.eh_proj.weight"
    let normName = "model.norm.weight"
    let normTensorName = "model.norm"
    let lmHeadName = "lm_head.weight"
    let ehIdx = qwen38MtpFindWeightIndex(graph, ehProjName)
    if IsErr(ehIdx):
        return Err[bool](Error(ehIdx))
    let ehShape = graph.weights[Value(ehIdx)].shape
    if ehShape.len != 2 || ehShape[0] != Qwen38HybridPinnedHiddenSize ||
       ehShape[1] != Qwen38HybridPinnedHiddenSize * 2:
        return Err[bool]("qwen38 hybrid executor mtp contract: eh proj shape")
    let normIdx = qwen38MtpFindWeightIndex(graph, normName)
    if IsErr(normIdx):
        return Err[bool](Error(normIdx))
    let normShape = graph.weights[Value(normIdx)].shape
    if normShape.len != 1 || normShape[0] != Qwen38HybridPinnedHiddenSize:
        return Err[bool]("qwen38 hybrid executor mtp contract: norm shape")
    let lmIdx = qwen38MtpFindWeightIndex(graph, lmHeadName)
    if IsErr(lmIdx):
        return Err[bool](Error(lmIdx))
    let lmShape = graph.weights[Value(lmIdx)].shape
    if lmShape.len != 2 || lmShape[0] != vocabSize || lmShape[1] != Qwen38HybridPinnedHiddenSize:
        return Err[bool]("qwen38 hybrid executor mtp contract: lm head shape")
    let embedIdx = qwen38MtpFindWeightIndex(graph, embedName)
    if IsErr(embedIdx):
        return Err[bool](Error(embedIdx))
    let embedShape = graph.weights[Value(embedIdx)].shape
    if embedShape.len != 2 || embedShape[0] != vocabSize || embedShape[1] != Qwen38HybridPinnedHiddenSize:
        return Err[bool]("qwen38 hybrid executor mtp contract: embedding shape")
    let mtpOpIdx = qwen38MtpFindUniqueOpIndexByKind(graph, mg.InferenceModelOpMtpProject)
    if IsErr(mtpOpIdx):
        return Err[bool](Error(mtpOpIdx))
    let mtpOp = graph.ops[Value(mtpOpIdx)]
    if mtpOp.inputNames.len != 1 || mtpOp.inputNames[0] != normTensorName ||
       mtpOp.outputName != "mtp.hidden" || mtpOp.weightNames.len != 1 ||
       mtpOp.weightNames[0] != ehProjName:
        return Err[bool]("qwen38 hybrid executor mtp contract: mtp project op wiring")
    let lmOpIdx = qwen38MtpFindUniqueOpIndexByKind(graph, mg.InferenceModelOpLmHead)
    if IsErr(lmOpIdx):
        return Err[bool](Error(lmOpIdx))
    let lmOp = graph.ops[Value(lmOpIdx)]
    if lmOp.inputNames.len != 1 || lmOp.inputNames[0] != normTensorName ||
       lmOp.outputName != "logits" || lmOp.weightNames.len != 1 ||
       lmOp.weightNames[0] != lmHeadName:
        return Err[bool]("qwen38 hybrid executor mtp contract: lm head op wiring")
    let graphOk = mg.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    return Ok[bool](true)
