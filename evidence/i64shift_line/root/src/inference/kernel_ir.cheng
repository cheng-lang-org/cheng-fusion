import std/result
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/inference/kernel as infer

const
    KernelIrSchema = "cheng.inference.kernel_ir.v1"
    KernelDtypeFp16 = "fp16"
    KernelDtypeBf16 = "bf16"
    KernelDtypeFp8E4M3 = "fp8_e4m3"
    KernelDtypeInt8 = "int8"
    KernelDtypeInt4 = "int4"
    KernelDtypeI32 = "i32"
    KernelOpVectorAdd = "vector_add"
    KernelOpGemm = "gemm"
    KernelOpGemmInt4Weight = "gemm_int4_weight"
    KernelOpLinearOutInInt4Weight = "linear_out_in_int4_weight"
    KernelOpLinearOutInW4Afp8Weight = "linear_out_in_w4afp8_weight"
    KernelOpRmsNorm = "rmsnorm"
    KernelOpRope = "rope"
    KernelOpSoftmax = "softmax"
    KernelOpSwiGlu = "swiglu"
    KernelOpTopK = "topk"
    KernelOpPagedAttention = "paged_attention"

type
    KernelTensorDesc =
        name: str
        dtype: str
        shape: int32[]
        stride: int32[]
        scale: int32

    KernelIrOp =
        opKind: str
        inputNames: str[]
        outputName: str
        rows: int32
        cols: int32
        inner: int32
        topK: int32
        epsilonScale: int32

    KernelProgram =
        schema: str
        programName: str
        targetBackend: str
        tensors: KernelTensorDesc[]
        ops: KernelIrOp[]
        complete: bool
        kernelHash: int64

    KernelPackedInt4Tensor =
        shape: int32[]
        scale: int32
        packed: rawbytes.Bytes

    KernelW4Afp8Tensor =
        shape: int32[]
        scale: int32
        rawI8: rawbytes.Bytes

fn KernelIrHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(16777619) + value + int64(2166136261)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn KernelIrHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = KernelIrHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn KernelIrHashIntsWith(hashRaw: int64, values: int32[]): int64 =
    var h: int64 = hashRaw
    for i in 0..<values.len:
        h = KernelIrHashStep(h, int64(values[i]))
    return h

@borrows
fn KernelIrHashBytesWith(hashRaw: int64, bytes: rawbytes.Bytes): int64 =
    var h: int64 = hashRaw
    h = KernelIrHashStep(h, int64(rawbytes.BytesLen(bytes)))
    for i in 0..<rawbytes.BytesLen(bytes):
        h = KernelIrHashStep(h, int64(rawbytes.BytesGet(bytes, i) & 255))
    return h

@borrows
fn KernelIrHashProgram(program: KernelProgram): int64 =
    var h: int64 = int64(2166136261)
    h = KernelIrHashTextWith(h, program.schema)
    h = KernelIrHashTextWith(h, program.programName)
    h = KernelIrHashTextWith(h, program.targetBackend)
    for i in 0..<program.tensors.len:
        h = KernelIrHashTextWith(h, program.tensors[i].name)
        h = KernelIrHashTextWith(h, program.tensors[i].dtype)
        h = KernelIrHashIntsWith(h, program.tensors[i].shape)
        h = KernelIrHashIntsWith(h, program.tensors[i].stride)
        h = KernelIrHashStep(h, int64(program.tensors[i].scale))
    for i in 0..<program.ops.len:
        h = KernelIrHashTextWith(h, program.ops[i].opKind)
        for j in 0..<program.ops[i].inputNames.len:
            h = KernelIrHashTextWith(h, program.ops[i].inputNames[j])
        h = KernelIrHashTextWith(h, program.ops[i].outputName)
        h = KernelIrHashStep(h, int64(program.ops[i].rows))
        h = KernelIrHashStep(h, int64(program.ops[i].cols))
        h = KernelIrHashStep(h, int64(program.ops[i].inner))
        h = KernelIrHashStep(h, int64(program.ops[i].topK))
        h = KernelIrHashStep(h, int64(program.ops[i].epsilonScale))
    return h

fn KernelIrTensor(name: str, dtype: str, shape: int32[], scale: int32): KernelTensorDesc =
    var stride: int32[]
    if shape.len == 1:
        add(stride, 1)
    elif shape.len == 2:
        add(stride, shape[1])
        add(stride, 1)
    else:
        var running: int32 = 1
        var rev: int32[]
        var i = shape.len - 1
        while i >= 0:
            add(rev, running)
            running = running * shape[i]
            i = i - 1
        var j = rev.len - 1
        while j >= 0:
            add(stride, rev[j])
            j = j - 1
    return KernelTensorDesc(
        name: name,
        dtype: dtype,
        shape: shape,
        stride: stride,
        scale: scale
    )

@borrows
fn KernelIrValidateTensor(desc: KernelTensorDesc): Result[bool] =
    if desc.name == "":
        return Err[bool]("kernel ir: tensor name")
    if desc.dtype != KernelDtypeFp16 &&
       desc.dtype != KernelDtypeBf16 &&
       desc.dtype != KernelDtypeFp8E4M3 &&
       desc.dtype != KernelDtypeInt8 &&
       desc.dtype != KernelDtypeInt4 &&
       desc.dtype != KernelDtypeI32:
        return Err[bool]("kernel ir: unsupported dtype")
    if desc.shape.len <= 0 || desc.shape.len != desc.stride.len:
        return Err[bool]("kernel ir: tensor rank")
    for i in 0..<desc.shape.len:
        if desc.shape[i] <= 0 || desc.stride[i] <= 0:
            return Err[bool]("kernel ir: tensor shape")
    if desc.scale <= 0:
        return Err[bool]("kernel ir: tensor scale")
    return Ok[bool](true)

@borrows
fn KernelIrValidateProgram(program: KernelProgram): Result[bool] =
    if program.schema != KernelIrSchema:
        return Err[bool]("kernel ir: schema")
    if program.programName == "" || program.targetBackend == "":
        return Err[bool]("kernel ir: identity")
    if program.tensors.len <= 0 || program.ops.len <= 0:
        return Err[bool]("kernel ir: empty program")
    for i in 0..<program.tensors.len:
        let tensorRes = KernelIrValidateTensor(program.tensors[i])
        if IsErr(tensorRes):
            return Err[bool](Error(tensorRes))
    for i in 0..<program.ops.len:
        if program.ops[i].opKind == "":
            return Err[bool]("kernel ir: op kind")
        if program.ops[i].outputName == "":
            return Err[bool]("kernel ir: op output")
        if program.ops[i].inputNames.len <= 0:
            return Err[bool]("kernel ir: op inputs")
    if !program.complete:
        return Err[bool]("kernel ir: incomplete program")
    let expected = KernelIrHashProgram(program)
    if expected != program.kernelHash:
        return Err[bool]("kernel ir: hash mismatch")
    return Ok[bool](true)

fn KernelIrBuildProgram(programName: str,
                        targetBackend: str,
                        tensors: KernelTensorDesc[],
                        ops: KernelIrOp[]): KernelProgram =
    var out = KernelProgram(
        schema: KernelIrSchema,
        programName: programName,
        targetBackend: targetBackend,
        tensors: tensors,
        ops: ops,
        complete: true,
        kernelHash: int64(0)
    )
    out.kernelHash = KernelIrHashProgram(out)
    return out

fn KernelIrVectorAddProgram(dim: int32, dtype: str, scale: int32): KernelProgram =
    let tensors = [
        KernelIrTensor("a", share(dtype), [dim], scale),
        KernelIrTensor("b", share(dtype), [dim], scale),
        KernelIrTensor("out", dtype, [dim], scale)
    ]
    let op = KernelIrOp(
        opKind: KernelOpVectorAdd,
        inputNames: ["a", "b"],
        outputName: "out",
        rows: 1,
        cols: dim,
        inner: 1,
        topK: 0,
        epsilonScale: 0
    )
    return KernelIrBuildProgram("vector_add", "metal", tensors, [op])

fn KernelIrGemmProgram(rows: int32, cols: int32, inner: int32, dtype: str, scale: int32): KernelProgram =
    let tensors = [
        KernelIrTensor("left", share(dtype), [rows, inner], scale),
        KernelIrTensor("right", share(dtype), [inner, cols], scale),
        KernelIrTensor("out", dtype, [rows, cols], scale)
    ]
    let op = KernelIrOp(
        opKind: KernelOpGemm,
        inputNames: ["left", "right"],
        outputName: "out",
        rows: rows,
        cols: cols,
        inner: inner,
        topK: 0,
        epsilonScale: 0
    )
    return KernelIrBuildProgram("gemm", "metal", tensors, [op])

fn KernelIrGemmInt4WeightProgram(rows: int32,
                                 cols: int32,
                                 inner: int32,
                                 activationDtype: str,
                                 activationScale: int32,
                                 weightScale: int32): KernelProgram =
    let tensors = [
        KernelIrTensor("left", share(activationDtype), [rows, inner], activationScale),
        KernelIrTensor("right_packed_int4", KernelDtypeInt4, [inner, cols], weightScale),
        KernelIrTensor("out", activationDtype, [rows, cols], activationScale)
    ]
    let op = KernelIrOp(
        opKind: KernelOpGemmInt4Weight,
        inputNames: ["left", "right_packed_int4"],
        outputName: "out",
        rows: rows,
        cols: cols,
        inner: inner,
        topK: 0,
        epsilonScale: 0
    )
    return KernelIrBuildProgram("gemm_int4_weight", "metal", tensors, [op])

fn KernelIrLinearOutInInt4WeightProgram(rows: int32,
                                        outFeatures: int32,
                                        inFeatures: int32,
                                        activationDtype: str,
                                        activationScale: int32,
                                        weightScale: int32): KernelProgram =
    let tensors = [
        KernelIrTensor("left", share(activationDtype), [rows, inFeatures], activationScale),
        KernelIrTensor("right_packed_int4", KernelDtypeInt4, [outFeatures, inFeatures], weightScale),
        KernelIrTensor("out", activationDtype, [rows, outFeatures], activationScale)
    ]
    let op = KernelIrOp(
        opKind: KernelOpLinearOutInInt4Weight,
        inputNames: ["left", "right_packed_int4"],
        outputName: "out",
        rows: rows,
        cols: outFeatures,
        inner: inFeatures,
        topK: 0,
        epsilonScale: 0
    )
    return KernelIrBuildProgram("linear_out_in_int4_weight", "metal", tensors, [op])

fn KernelIrLinearOutInW4Afp8WeightProgram(rows: int32,
                                          outFeatures: int32,
                                          inFeatures: int32,
                                          activationDtype: str,
                                          activationScale: int32,
                                          weightScale: int32,
                                          fp8Scale: int32): KernelProgram =
    return KernelIrLinearOutInW4Afp8WeightProgramWithScaleShapes(
        rows,
        outFeatures,
        inFeatures,
        activationDtype,
        activationScale,
        weightScale,
        [outFeatures],
        [1],
        fp8Scale
    )

fn KernelIrLinearOutInW4Afp8WeightProgramWithScaleShapes(rows: int32,
                                                         outFeatures: int32,
                                                         inFeatures: int32,
                                                         activationDtype: str,
                                                         activationScale: int32,
                                                         weightScale: int32,
                                                         weightScaleShape: int32[],
                                                         inputScaleShape: int32[],
                                                         fp8Scale: int32): KernelProgram =
    let tensors = [
        KernelIrTensor("left", share(activationDtype), [rows, inFeatures], activationScale),
        KernelIrTensor("right_w4afp8_i8", KernelDtypeInt8, [outFeatures, inFeatures], weightScale),
        KernelIrTensor("weight_scale_inv", KernelDtypeFp8E4M3, weightScaleShape, fp8Scale),
        KernelIrTensor("input_scale", KernelDtypeFp8E4M3, inputScaleShape, fp8Scale),
        KernelIrTensor("out", activationDtype, [rows, outFeatures], activationScale)
    ]
    let op = KernelIrOp(
        opKind: KernelOpLinearOutInW4Afp8Weight,
        inputNames: ["left", "right_w4afp8_i8", "weight_scale_inv", "input_scale"],
        outputName: "out",
        rows: rows,
        cols: outFeatures,
        inner: inFeatures,
        topK: 0,
        epsilonScale: 0
    )
    return KernelIrBuildProgram("linear_out_in_w4afp8_weight", "metal", tensors, [op])

fn KernelIrRmsNormProgram(dim: int32, dtype: str, scale: int32, epsilonScale: int32): KernelProgram =
    let tensors = [
        KernelIrTensor("input", share(dtype), [dim], scale),
        KernelIrTensor("weight", share(dtype), [dim], scale),
        KernelIrTensor("out", dtype, [dim], scale)
    ]
    let op = KernelIrOp(
        opKind: KernelOpRmsNorm,
        inputNames: ["input", "weight"],
        outputName: "out",
        rows: 1,
        cols: dim,
        inner: dim,
        topK: 0,
        epsilonScale: epsilonScale
    )
    return KernelIrBuildProgram("rmsnorm", "metal", tensors, [op])

fn KernelIrPagedAttentionProgram(tokenCount: int32,
                                 keyDim: int32,
                                 valueDim: int32,
                                 tokensPerPage: int32,
                                 pageCount: int32,
                                 blockCount: int32,
                                 dtype: str,
                                 scale: int32): KernelProgram =
    let tensors = [
        KernelIrTensor("query", share(dtype), [keyDim], scale),
        KernelIrTensor("keys_page_major", share(dtype), [pageCount, tokensPerPage, keyDim], scale),
        KernelIrTensor("values_page_major", share(dtype), [pageCount, tokensPerPage, valueDim], scale),
        KernelIrTensor("page_table", KernelDtypeI32, [blockCount], 1),
        KernelIrTensor("out", dtype, [valueDim], scale)
    ]
    let op = KernelIrOp(
        opKind: KernelOpPagedAttention,
        inputNames: ["query", "keys_page_major", "values_page_major", "page_table"],
        outputName: "out",
        rows: tokenCount,
        cols: valueDim,
        inner: keyDim,
        topK: tokensPerPage,
        epsilonScale: pageCount
    )
    return KernelIrBuildProgram("paged_attention", "metal", tensors, [op])

@borrows
fn KernelIrVectorAddCpuFill(out: var infer.TensorQ, left: infer.TensorQ, right: infer.TensorQ): Result[bool] =
    let leftOk = infer.TensorValidate(left)
    if IsErr(leftOk):
        return Err[bool](Error(leftOk))
    let rightOk = infer.TensorValidate(right)
    if IsErr(rightOk):
        return Err[bool](Error(rightOk))
    if left.scale != right.scale || left.shape.len != 1 || right.shape.len != 1 || left.shape[0] != right.shape[0]:
        return Err[bool]("kernel ir vector add: shape")
    let zerosRes = infer.TensorZerosFill(out, [left.shape[0]], left.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for i in 0..<left.data.len:
        out.data[i] = left.data[i] + right.data[i]
    return Ok[bool](true)

@borrows
fn KernelIrMatMulCpuFill(out: var infer.TensorQ, left: infer.TensorQ, right: infer.TensorQ): Result[bool] =
    return infer.MatMul2dFill(out, left, right)

fn KernelIrDecodeInt4Scaled(rawNibble: int32, scale: int32): Result[int32] =
    if scale <= 0:
        return Err[int32]("kernel ir int4: scale")
    var signedValue = rawNibble & 15
    if signedValue >= 8:
        signedValue = signedValue - 16
    return Ok[int32](infer.InferenceSaturateI32(int64(signedValue) * int64(scale)))

fn KernelIrPackedInt4ExpectedBytes(valueCount: int32): Result[int32] =
    if valueCount < 0:
        return Err[int32]("kernel ir int4: value count")
    return Ok[int32](valueCount / 2 + valueCount % 2)

@borrows
fn KernelIrPackedInt4TensorValidate(tensor: KernelPackedInt4Tensor): Result[bool] =
    if tensor.scale <= 0:
        return Err[bool]("kernel ir int4: scale")
    let countRes = infer.TensorElementCount(tensor.shape)
    if IsErr(countRes):
        return Err[bool](Error(countRes))
    let expectedBytes = KernelIrPackedInt4ExpectedBytes(Value(countRes))
    if IsErr(expectedBytes):
        return Err[bool](Error(expectedBytes))
    if rawbytes.BytesLen(tensor.packed) != Value(expectedBytes):
        return Err[bool]("kernel ir int4: byte count")
    if rawbytes.BytesLen(tensor.packed) > 0 && tensor.packed.data == nil:
        return Err[bool]("kernel ir int4: bytes")
    if Value(countRes) % 2 == 1 && rawbytes.BytesLen(tensor.packed) > 0:
        let lastByte = rawbytes.BytesGet(tensor.packed, rawbytes.BytesLen(tensor.packed) - 1)
        if ((lastByte >> 4) & 15) != 0:
            return Err[bool]("kernel ir int4: padding")
    return Ok[bool](true)

@borrows
fn KernelIrPackedInt4TensorHash(tensor: KernelPackedInt4Tensor): Result[int64] =
    let ok = KernelIrPackedInt4TensorValidate(tensor)
    if IsErr(ok):
        return Err[int64](Error(ok))
    var h: int64 = KernelIrHashTextWith(int64(2166136261), "cheng.inference.kernel_ir.packed_int4.v1")
    h = KernelIrHashIntsWith(h, tensor.shape)
    h = KernelIrHashStep(h, int64(tensor.scale))
    h = KernelIrHashBytesWith(h, tensor.packed)
    return Ok[int64](h)

@borrows
fn KernelIrPackedInt4ValueAtUnchecked(tensor: KernelPackedInt4Tensor, index: int32): int32 =
    let packedByte = rawbytes.BytesGet(tensor.packed, index / 2)
    var rawNibble = packedByte & 15
    if index % 2 == 1:
        rawNibble = (packedByte >> 4) & 15
    var signedValue = rawNibble & 15
    if signedValue >= 8:
        signedValue = signedValue - 16
    return infer.InferenceSaturateI32(int64(signedValue) * int64(tensor.scale))

@borrows
fn KernelIrGemmInt4WeightCpuFill(out: var infer.TensorQ,
                                 left: infer.TensorQ,
                                 right: KernelPackedInt4Tensor): Result[bool] =
    let leftOk = infer.TensorValidate(left)
    if IsErr(leftOk):
        return Err[bool](Error(leftOk))
    let rightOk = KernelIrPackedInt4TensorValidate(right)
    if IsErr(rightOk):
        return Err[bool](Error(rightOk))
    if left.shape.len != 2 || right.shape.len != 2:
        return Err[bool]("kernel ir int4 gemm: rank")
    if left.shape[1] != right.shape[0]:
        return Err[bool]("kernel ir int4 gemm: inner dim")
    if left.scale != right.scale:
        return Err[bool]("kernel ir int4 gemm: scale")
    let rows = left.shape[0]
    let inner = left.shape[1]
    let cols = right.shape[1]
    let zerosRes = infer.TensorZerosFill(out, [rows, cols], left.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for row in 0..<rows:
        for col in 0..<cols:
            var sum: int64
            sum = int64(0)
            for kk in 0..<inner:
                let weightIndex = kk * cols + col
                let product = int64(left.data[row * inner + kk]) *
                              int64(KernelIrPackedInt4ValueAtUnchecked(right, weightIndex))
                sum = sum + infer.InferenceRoundDivI64(product, int64(left.scale))
            out.data[row * cols + col] = infer.InferenceSaturateI32(sum)
    return Ok[bool](true)

@borrows
fn KernelIrLinearOutInInt4WeightCpuFill(out: var infer.TensorQ,
                                        left: infer.TensorQ,
                                        right: KernelPackedInt4Tensor): Result[bool] =
    let leftOk = infer.TensorValidate(left)
    if IsErr(leftOk):
        return Err[bool](Error(leftOk))
    let rightOk = KernelIrPackedInt4TensorValidate(right)
    if IsErr(rightOk):
        return Err[bool](Error(rightOk))
    if left.shape.len != 2 || right.shape.len != 2:
        return Err[bool]("kernel ir linear int4: rank")
    if left.shape[1] != right.shape[1]:
        return Err[bool]("kernel ir linear int4: inner dim")
    if left.scale != right.scale:
        return Err[bool]("kernel ir linear int4: scale")
    let rows = left.shape[0]
    let outFeatures = right.shape[0]
    let inFeatures = right.shape[1]
    let zerosRes = infer.TensorZerosFill(out, [rows, outFeatures], left.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for row in 0..<rows:
        for outFeature in 0..<outFeatures:
            var sum: int64
            sum = int64(0)
            for inFeature in 0..<inFeatures:
                let weightIndex = outFeature * inFeatures + inFeature
                let product = int64(left.data[row * inFeatures + inFeature]) *
                              int64(KernelIrPackedInt4ValueAtUnchecked(right, weightIndex))
                sum = sum + infer.InferenceRoundDivI64(product, int64(left.scale))
            out.data[row * outFeatures + outFeature] = infer.InferenceSaturateI32(sum)
    return Ok[bool](true)

@borrows
fn KernelIrW4Afp8TensorValidate(tensor: KernelW4Afp8Tensor): Result[bool] =
    if tensor.scale <= 0:
        return Err[bool]("kernel ir w4afp8: scale")
    let countRes = infer.TensorElementCount(tensor.shape)
    if IsErr(countRes):
        return Err[bool](Error(countRes))
    if rawbytes.BytesLen(tensor.rawI8) != Value(countRes):
        return Err[bool]("kernel ir w4afp8: byte count")
    if rawbytes.BytesLen(tensor.rawI8) > 0 && tensor.rawI8.data == nil:
        return Err[bool]("kernel ir w4afp8: bytes")
    return Ok[bool](true)

@borrows
fn KernelIrW4Afp8TensorHash(tensor: KernelW4Afp8Tensor): Result[int64] =
    let ok = KernelIrW4Afp8TensorValidate(tensor)
    if IsErr(ok):
        return Err[int64](Error(ok))
    var h: int64 = KernelIrHashTextWith(int64(2166136261), "cheng.inference.kernel_ir.w4afp8_raw_i8.v1")
    h = KernelIrHashIntsWith(h, tensor.shape)
    h = KernelIrHashStep(h, int64(tensor.scale))
    h = KernelIrHashBytesWith(h, tensor.rawI8)
    return Ok[int64](h)

@borrows
fn KernelIrW4Afp8ValueAtUnchecked(tensor: KernelW4Afp8Tensor, index: int32): int32 =
    var raw = rawbytes.BytesGet(tensor.rawI8, index) & 255
    if raw >= 128:
        raw = raw - 256
    return infer.InferenceSaturateI32(int64(raw) * int64(tensor.scale))

@borrows
fn KernelIrW4Afp8WeightScaleValue(scaleTensor: infer.TensorQ,
                                  outFeatures: int32,
                                  inFeatures: int32,
                                  outFeature: int32,
                                  inFeature: int32): Result[int32] =
    let ok = infer.TensorValidate(scaleTensor)
    if IsErr(ok):
        return Err[int32](Error(ok))
    if scaleTensor.shape.len == 1:
        if scaleTensor.shape[0] == 1:
            return Ok[int32](scaleTensor.data[0])
        if scaleTensor.shape[0] == outFeatures:
            return Ok[int32](scaleTensor.data[outFeature])
    elif scaleTensor.shape.len == 2:
        if scaleTensor.shape[0] == outFeatures && scaleTensor.shape[1] == inFeatures:
            return Ok[int32](scaleTensor.data[outFeature * inFeatures + inFeature])
    return Err[int32]("kernel ir w4afp8: weight scale shape")

@borrows
fn KernelIrW4Afp8InputScaleValue(scaleTensor: infer.TensorQ,
                                 inFeatures: int32,
                                 inFeature: int32): Result[int32] =
    let ok = infer.TensorValidate(scaleTensor)
    if IsErr(ok):
        return Err[int32](Error(ok))
    if scaleTensor.shape.len == 1:
        if scaleTensor.shape[0] == 1:
            return Ok[int32](scaleTensor.data[0])
        if scaleTensor.shape[0] == inFeatures:
            return Ok[int32](scaleTensor.data[inFeature])
    return Err[int32]("kernel ir w4afp8: input scale shape")

@borrows
fn KernelIrLinearOutInW4Afp8WeightCpuFill(out: var infer.TensorQ,
                                          left: infer.TensorQ,
                                          right: KernelW4Afp8Tensor,
                                          weightScaleInv: infer.TensorQ,
                                          inputScale: infer.TensorQ): Result[bool] =
    let leftOk = infer.TensorValidate(left)
    if IsErr(leftOk):
        return Err[bool](Error(leftOk))
    let rightOk = KernelIrW4Afp8TensorValidate(right)
    if IsErr(rightOk):
        return Err[bool](Error(rightOk))
    let weightScaleOk = infer.TensorValidate(weightScaleInv)
    if IsErr(weightScaleOk):
        return Err[bool](Error(weightScaleOk))
    let inputScaleOk = infer.TensorValidate(inputScale)
    if IsErr(inputScaleOk):
        return Err[bool](Error(inputScaleOk))
    if left.shape.len != 2 || right.shape.len != 2:
        return Err[bool]("kernel ir linear w4afp8: rank")
    if left.shape[1] != right.shape[1]:
        return Err[bool]("kernel ir linear w4afp8: inner dim")
    if left.scale != right.scale || weightScaleInv.scale != left.scale || inputScale.scale != left.scale:
        return Err[bool]("kernel ir linear w4afp8: scale")
    let rows = left.shape[0]
    let outFeatures = right.shape[0]
    let inFeatures = right.shape[1]
    let zerosRes = infer.TensorZerosFill(out, [rows, outFeatures], left.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for row in 0..<rows:
        for outFeature in 0..<outFeatures:
            var sum: int64
            sum = int64(0)
            for inFeature in 0..<inFeatures:
                let weightIndex = outFeature * inFeatures + inFeature
                let weightScaleValue = KernelIrW4Afp8WeightScaleValue(weightScaleInv,
                                                                      outFeatures,
                                                                      inFeatures,
                                                                      outFeature,
                                                                      inFeature)
                if IsErr(weightScaleValue):
                    return Err[bool](Error(weightScaleValue))
                let inputScaleValue = KernelIrW4Afp8InputScaleValue(inputScale, inFeatures, inFeature)
                if IsErr(inputScaleValue):
                    return Err[bool](Error(inputScaleValue))
                let adjustedInput = infer.InferenceRoundDivI64(
                    int64(left.data[row * inFeatures + inFeature]) * int64(Value(inputScaleValue)),
                    int64(left.scale)
                )
                let adjustedWeight = infer.InferenceRoundDivI64(
                    int64(KernelIrW4Afp8ValueAtUnchecked(right, weightIndex)) * int64(Value(weightScaleValue)),
                    int64(left.scale)
                )
                let product = adjustedInput * adjustedWeight
                sum = sum + infer.InferenceRoundDivI64(product, int64(left.scale))
            out.data[row * outFeatures + outFeature] = infer.InferenceSaturateI32(sum)
    return Ok[bool](true)

@borrows
fn KernelIrRmsNormCpuFill(out: var infer.TensorQ,
                          input: infer.TensorQ,
                          weight: infer.TensorQ,
                          epsilonScale: int32): Result[bool] =
    let inputOk = infer.TensorValidate(input)
    if IsErr(inputOk):
        return Err[bool](Error(inputOk))
    let weightOk = infer.TensorValidate(weight)
    if IsErr(weightOk):
        return Err[bool](Error(weightOk))
    if input.shape.len != 1 || weight.shape.len != 1 || input.shape[0] != weight.shape[0]:
        return Err[bool]("kernel ir rmsnorm: shape")
    if input.scale != weight.scale:
        return Err[bool]("kernel ir rmsnorm: scale")
    let zerosRes = infer.TensorZerosFill(out, [input.shape[0]], input.scale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    var squareSum: int64
    for i in 0..<input.data.len:
        squareSum = squareSum + int64(input.data[i]) * int64(input.data[i])
    let denom = int64(input.data.len)
    if denom <= int64(0):
        return Err[bool]("kernel ir rmsnorm: empty")
    let meanSquare = squareSum / denom
    var normBase = infer.InferenceIntSqrt(meanSquare + int64(epsilonScale))
    if normBase <= int64(0):
        normBase = int64(1)
    for i in 0..<input.data.len:
        let weighted = int64(input.data[i]) * int64(weight.data[i])
        out.data[i] = infer.InferenceSaturateI32(weighted / normBase)
    return Ok[bool](true)

fn KernelIrFacts(program: KernelProgram): str[] =
    var out: str[]
    add(out, strutil.Join(["kernel_ir_schema=", share(program.schema)], ""))
    add(out, strutil.Join(["kernel_ir_program=", share(program.programName)], ""))
    add(out, strutil.Join(["kernel_ir_backend=", share(program.targetBackend)], ""))
    add(out, strutil.Join(["kernel_ir_hash=", strings.Int64ToStr(program.kernelHash)], ""))
    for i in 0..<program.ops.len:
        add(out, strutil.Join([
            "kernel_ir_op=",
            strings.IntToStr(i),
            ":",
            program.ops[i].opKind,
            ":",
            program.ops[i].outputName
        ], ""))
    return out
