import std/result
import std/strings
import std/strutils as strutil

const
    InferenceExecutionReceiptSchema = "cheng.inference.execution_receipt.v3"
    InferenceExecutionStatusPlanned = "planned"
    InferenceExecutionStatusExecuted = "executed"
    InferenceExecutionStatusHardFail = "hard_fail"

type
    InferenceExecutionReceipt =
        schema: str
        modelCid: str
        enginePlanHash: int64
        partitionPlanHash: int64
        kernelHash: int64
        kvPageTableHash: int64
        kvShardReceiptHash: int64
        routerDecisionHash: int64
        weightStoreHash: int64
        activationTransportHash: int64
        outputHash: int64
        elapsedNs: int64
        status: str
        receiptHash: int64

fn InferenceReceiptHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(104729) + value + int64(53)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

fn InferenceReceiptHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = InferenceReceiptHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn InferenceExecutionReceiptHash(receipt: InferenceExecutionReceipt): int64 =
    var h: int64 = int64(53)
    h = InferenceReceiptHashTextWith(h, receipt.schema)
    h = InferenceReceiptHashTextWith(h, receipt.modelCid)
    h = InferenceReceiptHashStep(h, receipt.enginePlanHash)
    h = InferenceReceiptHashStep(h, receipt.partitionPlanHash)
    h = InferenceReceiptHashStep(h, receipt.kernelHash)
    h = InferenceReceiptHashStep(h, receipt.kvPageTableHash)
    h = InferenceReceiptHashStep(h, receipt.kvShardReceiptHash)
    h = InferenceReceiptHashStep(h, receipt.routerDecisionHash)
    h = InferenceReceiptHashStep(h, receipt.weightStoreHash)
    h = InferenceReceiptHashStep(h, receipt.activationTransportHash)
    h = InferenceReceiptHashStep(h, receipt.outputHash)
    h = InferenceReceiptHashStep(h, receipt.elapsedNs)
    h = InferenceReceiptHashTextWith(h, receipt.status)
    return h

fn InferenceExecutionReceiptBuild(modelCid: str,
                                  enginePlanHash: int64,
                                  partitionPlanHash: int64,
                                  kernelHash: int64,
                                  kvPageTableHash: int64,
                                  kvShardReceiptHash: int64,
                                  routerDecisionHash: int64,
                                  weightStoreHash: int64,
                                  activationTransportHash: int64,
                                  outputHash: int64,
                                  elapsedNs: int64,
                                  status: str): InferenceExecutionReceipt =
    var receipt = InferenceExecutionReceipt(
        schema: InferenceExecutionReceiptSchema,
        modelCid: modelCid,
        enginePlanHash: enginePlanHash,
        partitionPlanHash: partitionPlanHash,
        kernelHash: kernelHash,
        kvPageTableHash: kvPageTableHash,
        kvShardReceiptHash: kvShardReceiptHash,
        routerDecisionHash: routerDecisionHash,
        weightStoreHash: weightStoreHash,
        activationTransportHash: activationTransportHash,
        outputHash: outputHash,
        elapsedNs: elapsedNs,
        status: status,
        receiptHash: int64(0)
    )
    receipt.receiptHash = InferenceExecutionReceiptHash(receipt)
    return receipt

@borrows
fn InferenceExecutionReceiptValidate(receipt: InferenceExecutionReceipt): Result[bool] =
    if receipt.schema != InferenceExecutionReceiptSchema:
        return Err[bool]("inference receipt: schema")
    if receipt.modelCid == "":
        return Err[bool]("inference receipt: model cid")
    if receipt.status != InferenceExecutionStatusPlanned &&
       receipt.status != InferenceExecutionStatusExecuted &&
       receipt.status != InferenceExecutionStatusHardFail:
        return Err[bool]("inference receipt: status")
    if receipt.enginePlanHash <= int64(0) || receipt.partitionPlanHash <= int64(0) || receipt.kernelHash <= int64(0):
        return Err[bool]("inference receipt: execution hashes")
    if receipt.kvPageTableHash <= int64(0) || receipt.kvShardReceiptHash <= int64(0):
        return Err[bool]("inference receipt: kv hashes")
    if receipt.routerDecisionHash < int64(0) ||
       receipt.weightStoreHash < int64(0) || receipt.activationTransportHash < int64(0) ||
       receipt.outputHash < int64(0) || receipt.elapsedNs < int64(0):
        return Err[bool]("inference receipt: negative field")
    if receipt.status == InferenceExecutionStatusExecuted:
        if receipt.weightStoreHash <= int64(0) || receipt.activationTransportHash <= int64(0):
            return Err[bool]("inference receipt: executed input hashes")
        if receipt.outputHash <= int64(0) || receipt.elapsedNs <= int64(0):
            return Err[bool]("inference receipt: executed output")
    else:
        if receipt.weightStoreHash != int64(0) || receipt.activationTransportHash != int64(0):
            return Err[bool]("inference receipt: non-executed input hashes")
        if receipt.outputHash != int64(0):
            return Err[bool]("inference receipt: non-executed output")
    if InferenceExecutionReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("inference receipt: hash mismatch")
    return Ok[bool](true)

fn InferenceExecutionReceiptFacts(receipt: InferenceExecutionReceipt): str[] =
    var out: str[]
    add(out, strutil.Join(["inference_receipt_schema=", share(receipt.schema)], ""))
    add(out, strutil.Join(["inference_receipt_model=", share(receipt.modelCid)], ""))
    add(out, strutil.Join(["inference_receipt_engine_plan_hash=", strings.Int64ToStr(receipt.enginePlanHash)], ""))
    add(out, strutil.Join(["inference_receipt_kv_page_table_hash=", strings.Int64ToStr(receipt.kvPageTableHash)], ""))
    add(out, strutil.Join(["inference_receipt_kv_shard_receipt_hash=", strings.Int64ToStr(receipt.kvShardReceiptHash)], ""))
    add(out, strutil.Join(["inference_receipt_weight_store_hash=", strings.Int64ToStr(receipt.weightStoreHash)], ""))
    add(out, strutil.Join(["inference_receipt_activation_transport_hash=", strings.Int64ToStr(receipt.activationTransportHash)], ""))
    add(out, strutil.Join(["inference_receipt_status=", share(receipt.status)], ""))
    add(out, strutil.Join(["inference_receipt_hash=", strings.Int64ToStr(receipt.receiptHash)], ""))
    return out
