# src/inference/tokenizer_qwen38.cheng - Qwen3.8-27B vocab adaptation gate.
#
# Qwen/Qwen3.8-27B (config.json, fetched 2026-08-22) ships text_config
# vocab_size=248320 -- far beyond the Qwen2.5-family vocab the current runtime
# fixture artifacts/tokenizer/qwen25/tokenizer_qwen25.bin was built from --
# plus multimodal control ids (image/video/vision_start/vision_end) and
# bos==eos==248044. The byte-level BPE runtime in tokenizer.cheng reads its
# vocabCount from the file header (int32 at offset 8), so loading a Qwen3.8
# vocab needs no code change there; what the DiLoCo inference stack does need
# is a hard gate that refuses to pair a mismatched vocab with Qwen3.8 weights
# instead of silently producing garbage ids. This module is that gate.
#
# Bin header layout (little-endian; authoritative source:
# ts-csg/scripts/tokenizer-fixture-build.mjs, consumer:
# src/inference/tokenizer.cheng TokenizerLoad), 28 bytes total:
#   int32 magic        = 0x314b4f54 ("TOK1")
#   int32 version      = 1
#   int32 vocabCount
#   int32 mergeCount
#   int32 specialCount
#   int64 contentHash  (rolling hash over header counts + all sections)
# This adapter re-derives the 28 header bytes locally instead of reaching
# into tokenizer.cheng's private readers, so it stays decoupled from the
# loader's internals; the format constants are pinned by the smoke test
# against both the converter script and the real qwen25 fixture.

import std/result
import std/os
import std/rawbytes
import std/strings
import std/strutils as strutil

const
    # Real Qwen/Qwen3.8-27B config.json values (2026-08-22).
    Qwen38VocabSize: int32 = 248320
    Qwen38ImageTokenId: int32 = 248056
    Qwen38VideoTokenId: int32 = 248057
    Qwen38VisionStartTokenId: int32 = 248053
    Qwen38VisionEndTokenId: int32 = 248054
    # bos_token_id == eos_token_id == 248044 in the same config.
    Qwen38BosTokenId: int32 = 248044
    Qwen38EosTokenId: int32 = 248044

const
    Qwen38TokMagic: int32 = 0x314b4f54
    Qwen38TokVersion: int32 = 1

type
    Qwen38TokenizerHeader =
        vocabCount: int32
        mergeCount: int32
        specialCount: int32
        contentHash: int64

@borrows
fn qwen38ReadI32LE(buf: rawbytes.Bytes, offset: int32): int32 =
    let b0: int64 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1: int64 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2: int64 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3: int64 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    return int32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

@borrows
fn qwen38ReadI64LE(buf: rawbytes.Bytes, offset: int32): int64 =
    let b0: int64 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1: int64 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2: int64 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3: int64 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    let b4: int64 = int64(rawbytes.BytesGet(buf, offset + 4) & 255)
    let b5: int64 = int64(rawbytes.BytesGet(buf, offset + 5) & 255)
    let b6: int64 = int64(rawbytes.BytesGet(buf, offset + 6) & 255)
    let b7: int64 = int64(rawbytes.BytesGet(buf, offset + 7) & 255)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)

# Parse + verify the fixed header fields (magic/version/counts). The section
# contentHash is returned but NOT verified here -- verifying it requires the
# full vocab/merge/special body, which is TokenizerLoad's job.
@borrows
fn Qwen38TokenizerHeaderCheck(buf: rawbytes.Bytes): Result[Qwen38TokenizerHeader] =
    if rawbytes.BytesLen(buf) < 28:
        return Err[Qwen38TokenizerHeader]("qwen38 tokenizer: truncated header")
    let magic = qwen38ReadI32LE(buf, 0)
    if magic != Qwen38TokMagic:
        return Err[Qwen38TokenizerHeader]("qwen38 tokenizer: bad magic")
    let version = qwen38ReadI32LE(buf, 4)
    if version != Qwen38TokVersion:
        return Err[Qwen38TokenizerHeader]("qwen38 tokenizer: bad version")
    let vocabCount = qwen38ReadI32LE(buf, 8)
    let mergeCount = qwen38ReadI32LE(buf, 12)
    let specialCount = qwen38ReadI32LE(buf, 16)
    if vocabCount <= 0 || mergeCount < 0 || specialCount < 0:
        return Err[Qwen38TokenizerHeader]("qwen38 tokenizer: bad counts")
    var out: Qwen38TokenizerHeader
    out.vocabCount = vocabCount
    out.mergeCount = mergeCount
    out.specialCount = specialCount
    out.contentHash = qwen38ReadI64LE(buf, 20)
    return Ok[Qwen38TokenizerHeader](out)

fn qwen38SpecialIdsInBounds(vocabCount: int32): bool =
    if Qwen38ImageTokenId < 0 || Qwen38ImageTokenId >= vocabCount:
        return false
    if Qwen38VideoTokenId < 0 || Qwen38VideoTokenId >= vocabCount:
        return false
    if Qwen38VisionStartTokenId < 0 || Qwen38VisionStartTokenId >= vocabCount:
        return false
    if Qwen38VisionEndTokenId < 0 || Qwen38VisionEndTokenId >= vocabCount:
        return false
    if Qwen38BosTokenId < 0 || Qwen38BosTokenId >= vocabCount:
        return false
    if Qwen38EosTokenId < 0 || Qwen38EosTokenId >= vocabCount:
        return false
    return true

# Full vocab-level gate for Qwen3.8: header must be well-formed, the vocab
# count must equal the Qwen3.8-27B embedding width exactly, and every pinned
# special token id must index inside the loaded vocab.
@borrows
fn Qwen38TokenizerValidateVocab(buf: rawbytes.Bytes): Result[Qwen38TokenizerHeader] =
    let hdrRes = Qwen38TokenizerHeaderCheck(buf)
    if IsErr(hdrRes):
        return Err[Qwen38TokenizerHeader](Error(hdrRes))
    let hdr = Value(hdrRes)
    if hdr.vocabCount != Qwen38VocabSize:
        let msg: str = strutil.Join(["qwen38 tokenizer: vocab size mismatch: expected ",
                                     strings.IntToStr(Qwen38VocabSize), " got ",
                                     strings.IntToStr(hdr.vocabCount)], "")
        return Err[Qwen38TokenizerHeader](msg)
    if !qwen38SpecialIdsInBounds(hdr.vocabCount):
        return Err[Qwen38TokenizerHeader]("qwen38 tokenizer: special token id out of vocab bounds")
    return Ok[Qwen38TokenizerHeader](hdr)

# File-level convenience for the inference wiring: locate + read the fixture,
# then run the same gate. FileExists precheck first -- propagating a borrowed
# ReadFileBytesResult error message across Result boundaries is a known ORC
# hazard (lessons.md 2026-08-29), so a missing file is reported as a literal.
fn Qwen38TokenizerValidateVocabFile(path: str): Result[Qwen38TokenizerHeader] =
    if !os.FileExists(path):
        return Err[Qwen38TokenizerHeader]("qwen38 tokenizer: fixture file not found")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[Qwen38TokenizerHeader](Error(bytesRes))
    let buf: rawbytes.Bytes = Value(bytesRes)
    return Qwen38TokenizerValidateVocab(buf)
