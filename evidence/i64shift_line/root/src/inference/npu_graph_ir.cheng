import std/result
import std/strings
import std/strutils as strutil

const
    NpuGraphIrSchema = "cheng.inference.npu_graph_ir.v1"
    NpuGraphBackendAppleAneCoreml = "apple_ane_coreml"
    NpuGraphBackendAndroidNnapi = "android_nnapi"
    NpuGraphBackendAscend = "ascend"
    NpuGraphOpRmsNorm = "rmsnorm"
    NpuGraphOpGemm = "gemm"
    NpuGraphStatusUnsupported = "unsupported"

type
    NpuGraphTensor =
        name: str
        dtype: str
        shape: int32[]
        dynamicShape: bool

    NpuGraphOp =
        opKind: str
        inputNames: str[]
        outputName: str

    NpuGraphIR =
        schema: str
        backend: str
        graphName: str
        tensors: NpuGraphTensor[]
        ops: NpuGraphOp[]
        staticShape: bool
        complete: bool
        graphHash: int64

fn NpuGraphHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(524287) + value + int64(41)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

fn NpuGraphHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = NpuGraphHashStep(h, int64(Int32(text[i])))
    return h

fn NpuGraphHashIntsWith(hashRaw: int64, values: int32[]): int64 =
    var h: int64 = hashRaw
    for i in 0..<values.len:
        h = NpuGraphHashStep(h, int64(values[i]))
    return h

fn NpuGraphHash(graph: NpuGraphIR): int64 =
    var h: int64 = int64(41)
    h = NpuGraphHashTextWith(h, graph.schema)
    h = NpuGraphHashTextWith(h, graph.backend)
    h = NpuGraphHashTextWith(h, graph.graphName)
    if graph.staticShape:
        h = NpuGraphHashStep(h, int64(1))
    else:
        h = NpuGraphHashStep(h, int64(0))
    for i in 0..<graph.tensors.len:
        h = NpuGraphHashTextWith(h, graph.tensors[i].name)
        h = NpuGraphHashTextWith(h, graph.tensors[i].dtype)
        h = NpuGraphHashIntsWith(h, graph.tensors[i].shape)
        if graph.tensors[i].dynamicShape:
            h = NpuGraphHashStep(h, int64(1))
        else:
            h = NpuGraphHashStep(h, int64(0))
    for i in 0..<graph.ops.len:
        h = NpuGraphHashTextWith(h, graph.ops[i].opKind)
        for j in 0..<graph.ops[i].inputNames.len:
            h = NpuGraphHashTextWith(h, graph.ops[i].inputNames[j])
        h = NpuGraphHashTextWith(h, graph.ops[i].outputName)
    return h

fn NpuGraphValidateTensor(tensor: NpuGraphTensor): Result[bool] =
    if tensor.name == "" || tensor.dtype == "":
        return Err[bool]("npu graph: tensor identity")
    if tensor.dynamicShape:
        return Err[bool]("npu graph: dynamic shape unsupported")
    if tensor.shape.len <= 0:
        return Err[bool]("npu graph: tensor rank")
    for i in 0..<tensor.shape.len:
        if tensor.shape[i] <= 0:
            return Err[bool]("npu graph: tensor shape")
    return Ok[bool](true)

fn NpuGraphValidate(graph: NpuGraphIR): Result[bool] =
    if graph.schema != NpuGraphIrSchema:
        return Err[bool]("npu graph: schema")
    if graph.backend != NpuGraphBackendAppleAneCoreml &&
       graph.backend != NpuGraphBackendAndroidNnapi &&
       graph.backend != NpuGraphBackendAscend:
        return Err[bool]("npu graph: backend")
    if graph.graphName == "":
        return Err[bool]("npu graph: name")
    if !graph.staticShape:
        return Err[bool]("npu graph: static shape required")
    if !graph.complete:
        return Err[bool]("npu graph: incomplete")
    if graph.tensors.len <= 0 || graph.ops.len <= 0:
        return Err[bool]("npu graph: empty")
    for i in 0..<graph.tensors.len:
        let tensorOk = NpuGraphValidateTensor(graph.tensors[i])
        if IsErr(tensorOk):
            return Err[bool](Error(tensorOk))
    for i in 0..<graph.ops.len:
        if graph.ops[i].opKind == "" || graph.ops[i].outputName == "" || graph.ops[i].inputNames.len <= 0:
            return Err[bool]("npu graph: op")
    if NpuGraphHash(graph) != graph.graphHash:
        return Err[bool]("npu graph: hash mismatch")
    return Ok[bool](true)

fn NpuGraphBuildStaticRmsNormFixture(backend: str, dtype: str, dim: int32): NpuGraphIR =
    let tensors = [
        NpuGraphTensor(name: "input", dtype: dtype, shape: [dim], dynamicShape: false),
        NpuGraphTensor(name: "weight", dtype: dtype, shape: [dim], dynamicShape: false),
        NpuGraphTensor(name: "out", dtype: dtype, shape: [dim], dynamicShape: false)
    ]
    let op = NpuGraphOp(
        opKind: NpuGraphOpRmsNorm,
        inputNames: ["input", "weight"],
        outputName: "out"
    )
    var graph = NpuGraphIR(
        schema: NpuGraphIrSchema,
        backend: backend,
        graphName: "npu_static_rmsnorm_fixture",
        tensors: tensors,
        ops: [op],
        staticShape: true,
        complete: true,
        graphHash: int64(0)
    )
    graph.graphHash = NpuGraphHash(graph)
    return graph

fn NpuGraphCompileUnsupported(graph: NpuGraphIR): Result[int64] =
    let graphOk = NpuGraphValidate(graph)
    if IsErr(graphOk):
        return Err[int64](Error(graphOk))
    return Err[int64]("npu graph: provider unsupported")

fn NpuGraphFacts(graph: NpuGraphIR): str[] =
    var out: str[]
    add(out, strutil.Join(["npu_graph_schema=", share(graph.schema)], ""))
    add(out, strutil.Join(["npu_graph_backend=", share(graph.backend)], ""))
    add(out, strutil.Join(["npu_graph_name=", share(graph.graphName)], ""))
    add(out, strutil.Join(["npu_graph_hash=", strings.Int64ToStr(graph.graphHash)], ""))
    return out
