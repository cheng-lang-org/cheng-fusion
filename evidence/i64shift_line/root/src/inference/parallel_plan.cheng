import std/result
import std/strings
import std/strutils as strutil

const
    ParallelTensorAxisAttentionHead = "attention_head"

type
    TensorParallelShard =
        shardId: int32
        axis: str
        start: int32
        count: int32
        peerId: str

    ExpertParallelShard =
        expertId: int32
        peerId: str
        shardCid: str

    InferencePartitionPlan =
        planCid: str
        tensorShards: TensorParallelShard[]
        expertShards: ExpertParallelShard[]
        pipelineStageCount: int32
        planHash: int64

fn ParallelHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(8191) + value + int64(23)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

fn ParallelHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = ParallelHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn ParallelPlanHash(plan: InferencePartitionPlan): int64 =
    var h: int64 = int64(23)
    h = ParallelHashTextWith(h, plan.planCid)
    h = ParallelHashStep(h, int64(plan.pipelineStageCount))
    for i in 0..<plan.tensorShards.len:
        h = ParallelHashStep(h, int64(plan.tensorShards[i].shardId))
        h = ParallelHashTextWith(h, plan.tensorShards[i].axis)
        h = ParallelHashStep(h, int64(plan.tensorShards[i].start))
        h = ParallelHashStep(h, int64(plan.tensorShards[i].count))
        h = ParallelHashTextWith(h, plan.tensorShards[i].peerId)
    for i in 0..<plan.expertShards.len:
        h = ParallelHashStep(h, int64(plan.expertShards[i].expertId))
        h = ParallelHashTextWith(h, plan.expertShards[i].peerId)
        h = ParallelHashTextWith(h, plan.expertShards[i].shardCid)
    return h

fn ParallelBuildTensorHeadPlan(planCid: str,
                               headCount: int32,
                               peers: str[]): Result[InferencePartitionPlan] =
    if planCid == "" || headCount <= 0 || peers.len <= 0:
        return Err[InferencePartitionPlan]("parallel plan: invalid tensor plan")
    var tensorShards: TensorParallelShard[]
    for i in 0..<headCount:
        let peerIndex = i % peers.len
        add(tensorShards, TensorParallelShard(
            shardId: i,
            axis: ParallelTensorAxisAttentionHead,
            start: i,
            count: 1,
            peerId: peers[peerIndex]
        ))
    var plan = InferencePartitionPlan(
        planCid: planCid,
        tensorShards: tensorShards,
        expertShards: [],
        pipelineStageCount: 0,
        planHash: int64(0)
    )
    plan.planHash = ParallelPlanHash(plan)
    return Ok[InferencePartitionPlan](plan)

fn ParallelAttachExpertPlan(plan: var InferencePartitionPlan,
                            expertCount: int32,
                            peers: str[],
                            shardPrefix: str): Result[bool] =
    if expertCount <= 0 || peers.len <= 0 || shardPrefix == "":
        return Err[bool]("parallel plan: invalid expert plan")
    var experts: ExpertParallelShard[]
    for i in 0..<expertCount:
        let peerIndex = i % peers.len
        add(experts, ExpertParallelShard(
            expertId: i,
            peerId: peers[peerIndex],
            shardCid: strutil.Join([ share(shardPrefix), strings.IntToStr(i)], "")
        ))
    plan.expertShards = experts
    plan.planHash = ParallelPlanHash(plan)
    return Ok[bool](true)

@borrows
fn ParallelValidatePlan(plan: InferencePartitionPlan): Result[bool] =
    if plan.planCid == "":
        return Err[bool]("parallel plan: cid")
    if plan.tensorShards.len <= 0 && plan.expertShards.len <= 0:
        return Err[bool]("parallel plan: empty")
    for i in 0..<plan.tensorShards.len:
        if plan.tensorShards[i].shardId != i:
            return Err[bool]("parallel plan: tensor shard order")
        if plan.tensorShards[i].axis == "" || plan.tensorShards[i].peerId == "" || plan.tensorShards[i].count <= 0:
            return Err[bool]("parallel plan: tensor shard")
    for i in 0..<plan.expertShards.len:
        if plan.expertShards[i].expertId != i:
            return Err[bool]("parallel plan: expert shard order")
        if plan.expertShards[i].peerId == "" || plan.expertShards[i].shardCid == "":
            return Err[bool]("parallel plan: expert shard")
    if ParallelPlanHash(plan) != plan.planHash:
        return Err[bool]("parallel plan: hash mismatch")
    return Ok[bool](true)

@borrows
fn ParallelValidateTensorHeadCoverage(plan: InferencePartitionPlan,
                                      headCount: int32): Result[bool] =
    let planOk = ParallelValidatePlan(plan)
    if IsErr(planOk):
        return Err[bool](Error(planOk))
    if headCount <= 0:
        return Err[bool]("parallel plan: tensor head count")
    if plan.tensorShards.len <= 0:
        return Err[bool]("parallel plan: tensor head empty")
    var coverage: int32[]
    for _ in 0..<headCount:
        add(coverage, 0)
    for i in 0..<plan.tensorShards.len:
        let shard = plan.tensorShards[i]
        if shard.axis != ParallelTensorAxisAttentionHead:
            return Err[bool]("parallel plan: tensor head axis")
        if shard.start < 0 || shard.count <= 0 || shard.start + shard.count > headCount:
            return Err[bool]("parallel plan: tensor head span")
        for head in shard.start..<shard.start + shard.count:
            if coverage[head] != 0:
                return Err[bool]("parallel plan: tensor head overlap")
            coverage[head] = 1
    for head in 0..<coverage.len:
        if coverage[head] != 1:
            return Err[bool]("parallel plan: tensor head gap")
    return Ok[bool](true)

fn ParallelFindTensorHeadOwner(plan: InferencePartitionPlan,
                               headIndex: int32): Result[str] =
    let planOk = ParallelValidatePlan(plan)
    if IsErr(planOk):
        return Err[str](Error(planOk))
    if headIndex < 0:
        return Err[str]("parallel plan: tensor head index")
    var found: str
    for i in 0..<plan.tensorShards.len:
        let shard = plan.tensorShards[i]
        if shard.axis == ParallelTensorAxisAttentionHead &&
           headIndex >= shard.start &&
           headIndex < shard.start + shard.count:
            if found != "":
                return Err[str]("parallel plan: tensor head duplicate owner")
            found = shard.peerId
    if found == "":
        return Err[str]("parallel plan: tensor head owner missing")
    return Ok[str](found)

fn ParallelPlanFacts(plan: InferencePartitionPlan): str[] =
    var out: str[]
    add(out, strutil.Join(["partition_plan_cid=", share(plan.planCid)], ""))
    add(out, strutil.Join(["partition_plan_hash=", strings.Int64ToStr(plan.planHash)], ""))
    for i in 0..<plan.tensorShards.len:
        add(out, strutil.Join([
            "tensor_parallel=",
            strings.IntToStr(plan.tensorShards[i].shardId),
            ":",
            plan.tensorShards[i].axis,
            ":",
            plan.tensorShards[i].peerId
        ], ""))
    for i in 0..<plan.expertShards.len:
        add(out, strutil.Join([
            "expert_parallel=",
            strings.IntToStr(plan.expertShards[i].expertId),
            ":",
            plan.expertShards[i].peerId,
            ":",
            plan.expertShards[i].shardCid
        ], ""))
    return out

@borrows
fn ParallelPartitionPlanClone(plan: InferencePartitionPlan): InferencePartitionPlan =
    var tensorShards: TensorParallelShard[]
    for i in 0..<plan.tensorShards.len:
        var shard = plan.tensorShards[i]
        add(tensorShards, TensorParallelShard(
            shardId: shard.shardId,
            axis: strings.CloneStr(shard.axis),
            start: shard.start,
            count: shard.count,
            peerId: strings.CloneStr(shard.peerId)
        ))
    var expertShards: ExpertParallelShard[]
    for i in 0..<plan.expertShards.len:
        var shard = plan.expertShards[i]
        add(expertShards, ExpertParallelShard(
            expertId: shard.expertId,
            peerId: strings.CloneStr(shard.peerId),
            shardCid: strings.CloneStr(shard.shardCid)
        ))
    return InferencePartitionPlan(
        planCid: strings.CloneStr(plan.planCid),
        tensorShards: tensorShards,
        expertShards: expertShards,
        pipelineStageCount: plan.pipelineStageCount,
        planHash: plan.planHash
    )
