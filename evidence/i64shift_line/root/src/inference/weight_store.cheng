    WeightSafetensorsShardHeaderReceiptSchema = "cheng.inference.weight_safetensors_shard_header_receipt.v1"
    WeightSafetensorsShardHeaderPreflightSchema = "cheng.inference.weight_safetensors_shard_header_preflight.v1"
    WeightSafetensorsTensorRawPayloadHashReceiptSchema = "cheng.inference.weight_safetensors_tensor_raw_payload_hash_receipt.v1"
    WeightSafetensorsPayloadHashPreflightSchema = "cheng.inference.weight_safetensors_payload_hash_preflight.v1"
