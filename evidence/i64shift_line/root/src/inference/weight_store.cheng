@borrows
fn WeightTensorHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(524287) + value + int64(113)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn WeightTensorHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = WeightTensorHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn WeightTensorHashBytesWith(hashRaw: int64, bytes: rawbytes.Bytes): int64 =
    var h: int64 = hashRaw
    for i in 0..<rawbytes.BytesLen(bytes):
        h = WeightTensorHashStep(h, int64(rawbytes.BytesGet(bytes, i)))
    return h

@borrows
fn WeightTensorHashValue(tensor: infer.TensorQ): Result[int64] =
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[int64](Error(tensorOk))
    var h: int64 = int64(113)
    h = WeightTensorHashStep(h, int64(tensor.scale))
    for i in 0..<tensor.shape.len:
        h = WeightTensorHashStep(h, int64(tensor.shape[i]))
    for i in 0..<tensor.data.len:
        h = WeightTensorHashStep(h, int64(tensor.data[i]))
    if h <= int64(0):
        return Err[int64]("weight tensor store: tensor hash")
    return Ok[int64](h)

@borrows
fn WeightTensorPayloadExpectedHash(modelCid: str,
                                   tensorName: str,
                                   shardCid: str,
                                   dtype: str,
                                   quantScheme: str,
                                   peerId: str,
                                   tensor: infer.TensorQ,
                                   hasPackedInt4: bool,
                                   packedInt4: kernel_ir.KernelPackedInt4Tensor,
                                   hasW4Afp8Raw: bool,
                                   w4Afp8Raw: rawbytes.Bytes): Result[int64] =
    let tensorHash = WeightTensorHashValue(tensor)
    if IsErr(tensorHash):
        return Err[int64](Error(tensorHash))
    var packedHash: int64
    if hasPackedInt4:
        let packedHashRes = kernel_ir.KernelIrPackedInt4TensorHash(packedInt4)
        if IsErr(packedHashRes):
            return Err[int64](Error(packedHashRes))
        packedHash = Value(packedHashRes)
    var w4RawHash: int64
    if hasW4Afp8Raw:
        let w4RawHashRes = WeightTensorRawBytesHash(w4Afp8Raw)
        if IsErr(w4RawHashRes):
            return Err[int64](Error(w4RawHashRes))
        w4RawHash = Value(w4RawHashRes)
    var h: int64 = int64(113)
    h = WeightTensorHashTextWith(h, WeightTensorStoreSchema)
    h = WeightTensorHashTextWith(h, modelCid)
    h = WeightTensorHashTextWith(h, tensorName)
    h = WeightTensorHashTextWith(h, shardCid)
    h = WeightTensorHashTextWith(h, dtype)
    h = WeightTensorHashTextWith(h, quantScheme)
    h = WeightTensorHashTextWith(h, peerId)
    h = WeightTensorHashStep(h, Value(tensorHash))
    if hasPackedInt4:
        h = WeightTensorHashTextWith(h, "packed_int4")
        h = WeightTensorHashStep(h, packedHash)
    if hasW4Afp8Raw:
        h = WeightTensorHashTextWith(h, "w4afp8_raw")
        h = WeightTensorHashStep(h, w4RawHash)
    if h <= int64(0):
        return Err[int64]("weight tensor store: payload hash")
    return Ok[int64](h)

@borrows
fn WeightTensorPayloadHash(payload: WeightTensorPayload): Result[int64] =
    return WeightTensorPayloadExpectedHash(
        payload.modelCid,
        payload.tensorName,
        payload.shardCid,
        payload.dtype,
        payload.quantScheme,
        payload.peerId,
        payload.tensor,
        payload.hasPackedInt4,
        payload.packedInt4,
        payload.hasW4Afp8Raw,
        payload.w4Afp8Raw
    )

fn WeightTensorEmptyPackedInt4(): kernel_ir.KernelPackedInt4Tensor =
    var out: kernel_ir.KernelPackedInt4Tensor
    out.scale = 1
    out.packed = rawbytes.EmptyBytes()
    var shape: int32[]
    add(shape, 1)
    out.shape = shape
    return out

@borrows
fn WeightTensorRawBytesHash(bytes: rawbytes.Bytes): Result[int64] =
    if rawbytes.BytesLen(bytes) <= 0:
        return Err[int64]("weight tensor store: raw bytes")
    var h: int64 = int64(113)
    h = WeightTensorHashStep(h, int64(rawbytes.BytesLen(bytes)))
    h = WeightTensorHashBytesWith(h, bytes)
    if h <= int64(0):
        return Err[int64]("weight tensor store: raw bytes hash")
    return Ok[int64](h)

@borrows
fn WeightTensorPackedInt4MatchesTensor(tensor: infer.TensorQ,
                                       packedInt4: kernel_ir.KernelPackedInt4Tensor): Result[bool] =
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[bool](Error(tensorOk))
    let packedOk = kernel_ir.KernelIrPackedInt4TensorValidate(packedInt4)
    if IsErr(packedOk):
        return Err[bool](Error(packedOk))
    if !WeightTensorShapeMatches(tensor.shape, packedInt4.shape) || tensor.scale != packedInt4.scale:
        return Err[bool]("weight tensor store: packed int4 shape")
    for i in 0..<tensor.data.len:
        if tensor.data[i] != kernel_ir.KernelIrPackedInt4ValueAtUnchecked(packedInt4, i):
            return Err[bool]("weight tensor store: packed int4 decoded mismatch")
    return Ok[bool](true)

@borrows
fn WeightTensorW4Afp8RawMatchesTensor(tensor: infer.TensorQ,
                                      rawBytes: rawbytes.Bytes): Result[bool] =
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[bool](Error(tensorOk))
    if rawbytes.BytesLen(rawBytes) != tensor.data.len:
        return Err[bool]("weight tensor store: w4afp8 raw byte count")
    for i in 0..<tensor.data.len:
        let decoded = WeightSafetensorsDecodeI8Scaled(rawbytes.BytesGet(rawBytes, i), tensor.scale)
        if IsErr(decoded):
            return Err[bool](Error(decoded))
        if Value(decoded) != tensor.data[i]:
            return Err[bool]("weight tensor store: w4afp8 raw decoded mismatch")
    return Ok[bool](true)

fn WeightTensorPayloadBuild(modelCid: str,
                            tensorName: str,
                            shardCid: str,
                            dtype: str,
                            quantScheme: str,
                            peerId: str,
                            tensor: infer.TensorQ): Result[WeightTensorPayload] =
    if dtype == kernel_ir.KernelDtypeInt8 && quantScheme == model_graph.ModelQuantSchemeW4Afp8:
        return Err[WeightTensorPayload]("weight tensor store: w4afp8 raw required")
    return WeightTensorPayloadBuildWithPackedInt4(
        modelCid,
        tensorName,
        shardCid,
        dtype,
        quantScheme,
        peerId,
        tensor,
        false,
        WeightTensorEmptyPackedInt4()
    )

fn WeightTensorPayloadBuildWithPackedInt4(modelCid: str,
                                          tensorName: str,
                                          shardCid: str,
                                          dtype: str,
                                          quantScheme: str,
                                          peerId: str,
                                          tensor: infer.TensorQ,
                                          hasPackedInt4: bool,
                                          packedInt4: kernel_ir.KernelPackedInt4Tensor): Result[WeightTensorPayload] =
    return WeightTensorPayloadBuildWithRawFacts(
        modelCid,
        tensorName,
        shardCid,
        dtype,
        quantScheme,
        peerId,
        tensor,
        hasPackedInt4,
        packedInt4,
        false,
        rawbytes.EmptyBytes()
    )

fn WeightTensorPayloadBuildWithW4Afp8Raw(modelCid: str,
                                        tensorName: str,
                                        shardCid: str,
                                        dtype: str,
                                        quantScheme: str,
                                        peerId: str,
                                        tensor: infer.TensorQ,
                                        w4Afp8Raw: rawbytes.Bytes): Result[WeightTensorPayload] =
    return WeightTensorPayloadBuildWithRawFacts(
        modelCid,
        tensorName,
        shardCid,
        dtype,
        quantScheme,
        peerId,
        tensor,
        false,
        WeightTensorEmptyPackedInt4(),
        true,
        w4Afp8Raw
    )

fn WeightTensorPayloadBuildWithRawFacts(modelCid: str,
                                       tensorName: str,
                                       shardCid: str,
                                       dtype: str,
                                       quantScheme: str,
                                       peerId: str,
                                       tensor: infer.TensorQ,
                                       hasPackedInt4: bool,
                                       packedInt4: kernel_ir.KernelPackedInt4Tensor,
                                       hasW4Afp8Raw: bool,
                                       w4Afp8Raw: rawbytes.Bytes): Result[WeightTensorPayload] =
    if modelCid == "" || tensorName == "" || shardCid == "" || dtype == "" || quantScheme == "" || peerId == "":
        return Err[WeightTensorPayload]("weight tensor store: payload identity")
    if hasPackedInt4 && hasW4Afp8Raw:
        return Err[WeightTensorPayload]("weight tensor store: mixed raw encodings")
    var packedHash: int64
    if hasPackedInt4:
        if dtype != kernel_ir.KernelDtypeInt4 || quantScheme != model_graph.ModelQuantSchemeSymmetricInt4:
            return Err[WeightTensorPayload]("weight tensor store: packed int4 metadata")
        let matchOk = WeightTensorPackedInt4MatchesTensor(tensor, packedInt4)
        if IsErr(matchOk):
            return Err[WeightTensorPayload](Error(matchOk))
        let packedHashRes = kernel_ir.KernelIrPackedInt4TensorHash(packedInt4)
        if IsErr(packedHashRes):
            return Err[WeightTensorPayload](Error(packedHashRes))
        packedHash = Value(packedHashRes)
    var w4RawHash: int64
    if hasW4Afp8Raw:
        if dtype != kernel_ir.KernelDtypeInt8 || quantScheme != model_graph.ModelQuantSchemeW4Afp8:
            return Err[WeightTensorPayload]("weight tensor store: w4afp8 raw metadata")
        let matchOk = WeightTensorW4Afp8RawMatchesTensor(tensor, w4Afp8Raw)
        if IsErr(matchOk):
            return Err[WeightTensorPayload](Error(matchOk))
        let rawHashRes = WeightTensorRawBytesHash(w4Afp8Raw)
        if IsErr(rawHashRes):
            return Err[WeightTensorPayload](Error(rawHashRes))
        w4RawHash = Value(rawHashRes)
    elif dtype == kernel_ir.KernelDtypeInt8 && quantScheme == model_graph.ModelQuantSchemeW4Afp8:
        return Err[WeightTensorPayload]("weight tensor store: w4afp8 raw required")
    let payloadHash = WeightTensorPayloadExpectedHash(
        modelCid,
        tensorName,
        shardCid,
        dtype,
        quantScheme,
        peerId,
        tensor,
        hasPackedInt4,
        packedInt4,
        hasW4Afp8Raw,
        w4Afp8Raw
    )
    if IsErr(payloadHash):
        return Err[WeightTensorPayload](Error(payloadHash))
    return Ok[WeightTensorPayload](WeightTensorPayload(
        modelCid: modelCid,
        tensorName: tensorName,
        shardCid: shardCid,
        dtype: dtype,
        quantScheme: quantScheme,
        peerId: peerId,
        payloadHash: Value(payloadHash),
        tensor: tensor,
        hasPackedInt4: hasPackedInt4,
        packedInt4Hash: packedHash,
        packedInt4: packedInt4,
        hasW4Afp8Raw: hasW4Afp8Raw,
        w4Afp8RawHash: w4RawHash,
        w4Afp8Raw: w4Afp8Raw
    ))

@borrows
fn WeightTensorStoreHash(store: WeightTensorStore): int64 =
    var h: int64 = int64(113)
    h = WeightTensorHashTextWith(h, store.schema)
    h = WeightTensorHashTextWith(h, store.modelCid)
    for i in 0..<store.payloads.len:
        h = WeightTensorHashTextWith(h, store.payloads[i].modelCid)
        h = WeightTensorHashTextWith(h, store.payloads[i].tensorName)
        h = WeightTensorHashTextWith(h, store.payloads[i].shardCid)
        h = WeightTensorHashTextWith(h, store.payloads[i].dtype)
        h = WeightTensorHashTextWith(h, store.payloads[i].quantScheme)
        h = WeightTensorHashTextWith(h, store.payloads[i].peerId)
        h = WeightTensorHashStep(h, store.payloads[i].payloadHash)
    return h

fn WeightTensorStoreBuild(modelCid: str, payloads: WeightTensorPayload[]): WeightTensorStore =
    var out = WeightTensorStore(
        schema: WeightTensorStoreSchema,
        modelCid: modelCid,
        payloads: payloads,
        storeHash: int64(0)
    )
    out.storeHash = WeightTensorStoreHash(out)
    return out

@borrows
fn WeightSafetensorsShardIndexEntryHashWith(hashRaw: int64,
                                            entry: WeightSafetensorsShardIndexEntry): int64 =
    var h = hashRaw
    h = WeightTensorHashTextWith(h, entry.modelCid)
    h = WeightTensorHashStep(h, entry.graphHash)
    h = WeightTensorHashTextWith(h, entry.tensorName)
    h = WeightTensorHashTextWith(h, entry.shardCid)
    h = WeightTensorHashTextWith(h, entry.dtype)
    h = WeightTensorHashTextWith(h, entry.quantScheme)
    h = WeightTensorHashStep(h, entry.sizeBytes)
    h = WeightTensorHashTextWith(h, entry.filePath)
    h = WeightTensorHashTextWith(h, entry.peerId)
    h = WeightTensorHashStep(h, int64(entry.tensorScale))
    return h

@borrows
fn WeightSafetensorsShardIndexHash(index: WeightSafetensorsShardIndex): int64 =
    var h: int64 = int64(113)
    h = WeightTensorHashTextWith(h, index.schema)
    h = WeightTensorHashTextWith(h, index.modelCid)
    h = WeightTensorHashStep(h, index.graphHash)
    for i in 0..<index.entries.len:
        h = WeightSafetensorsShardIndexEntryHashWith(h, index.entries[i])
    return h

fn WeightSafetensorsShardIndexBuild(modelCid: str,
                                    graphHash: int64,
                                    entries: WeightSafetensorsShardIndexEntry[]): WeightSafetensorsShardIndex =
    var out = WeightSafetensorsShardIndex(
        schema: WeightSafetensorsShardIndexSchema,
        modelCid: modelCid,
        graphHash: graphHash,
        entries: entries,
        indexHash: int64(0)
    )
    out.indexHash = WeightSafetensorsShardIndexHash(out)
    return out

fn WeightSafetensorsShardIndexEntryMatchesWeight(entry: WeightSafetensorsShardIndexEntry,
                                                 weight: model_graph.ModelWeightShard): bool =
    if entry.modelCid != weight.modelCid:
        return false
    if entry.tensorName != weight.tensorName:
        return false
    if entry.shardCid != weight.shardCid:
        return false
    if entry.dtype != weight.dtype:
        return false
    if entry.quantScheme != weight.quantScheme:
        return false
    if entry.sizeBytes != weight.sizeBytes:
        return false
    return true

fn WeightSafetensorsShardIndexFindGraphWeight(graph: model_graph.ModelGraph,
                                              entry: WeightSafetensorsShardIndexEntry): int32 =
    var found: int32 = -1
    for i in 0..<graph.weights.len:
        if WeightSafetensorsShardIndexEntryMatchesWeight(entry, graph.weights[i]):
            if found >= 0:
                return -2
            found = i
    return found

fn WeightSafetensorsShardIndexFindEntryForWeight(index: WeightSafetensorsShardIndex,
                                                 weight: model_graph.ModelWeightShard): int32 =
    var found: int32 = -1
    for i in 0..<index.entries.len:
        if WeightSafetensorsShardIndexEntryMatchesWeight(index.entries[i], weight):
            if found >= 0:
                return -2
            found = i
    return found

fn WeightSafetensorsShardIndexPathFirst(index: WeightSafetensorsShardIndex, entryIndex: int32): bool =
    for i in 0..<entryIndex:
        if index.entries[i].filePath == index.entries[entryIndex].filePath:
            return false
    return true

fn WeightSafetensorsShardIndexValidate(index: WeightSafetensorsShardIndex,
                                       graph: model_graph.ModelGraph): Result[bool] =
    if index.schema != WeightSafetensorsShardIndexSchema:
        return Err[bool]("weight safetensors index: schema")
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    if index.modelCid == "" || index.modelCid != graph.modelCid:
        return Err[bool]("weight safetensors index: model cid")
    if index.graphHash <= int64(0) || index.graphHash != graph.graphHash:
        return Err[bool]("weight safetensors index: graph hash")
    if index.entries.len != graph.weights.len:
        return Err[bool]("weight safetensors index: entry count")
    for i in 0..<index.entries.len:
        if index.entries[i].modelCid != index.modelCid || index.entries[i].graphHash != index.graphHash:
            return Err[bool]("weight safetensors index: entry identity")
        if index.entries[i].tensorName == "" || index.entries[i].shardCid == "" ||
           index.entries[i].dtype == "" || index.entries[i].quantScheme == "":
            return Err[bool]("weight safetensors index: entry weight")
        if index.entries[i].sizeBytes <= int64(0) || index.entries[i].filePath == "" ||
           index.entries[i].peerId == "" || index.entries[i].tensorScale <= 0:
            return Err[bool]("weight safetensors index: entry source")
        let graphIndex = WeightSafetensorsShardIndexFindGraphWeight(graph, index.entries[i])
        if graphIndex == -2:
            return Err[bool]("weight safetensors index: duplicate graph weight")
        if graphIndex < 0:
            return Err[bool]("weight safetensors index: extra entry")
    for i in 0..<graph.weights.len:
        let entryIndex = WeightSafetensorsShardIndexFindEntryForWeight(index, graph.weights[i])
        if entryIndex == -2:
            return Err[bool]("weight safetensors index: duplicate entry")
        if entryIndex < 0:
            return Err[bool]("weight safetensors index: missing entry")
    if WeightSafetensorsShardIndexHash(index) != index.indexHash:
        return Err[bool]("weight safetensors index: hash mismatch")
    return Ok[bool](true)

@borrows
fn WeightSafetensorsShardFileReceiptHash(receipts: WeightSafetensorsShardFileReceipt[]): int64 =
    var h: int64 = int64(113)
    for i in 0..<receipts.len:
        h = WeightTensorHashTextWith(h, receipts[i].filePath)
        h = WeightTensorHashStep(h, receipts[i].fileByteHash)
        h = WeightTensorHashStep(h, receipts[i].fileByteCount)
        h = WeightTensorHashStep(h, receipts[i].headerHash)
        h = WeightTensorHashStep(h, int64(receipts[i].indexedTensorCount))
    return h

