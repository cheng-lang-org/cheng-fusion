@borrows
fn WeightSafetensorsDevicePageLoadReceiptHash(receipt: WeightSafetensorsDevicePageLoadReceipt): int64 =
    var h: int64 = int64(113)
    h = WeightTensorHashTextWith(h, receipt.schema)
    h = WeightTensorHashTextWith(h, receipt.modelCid)
    h = WeightTensorHashStep(h, receipt.graphHash)
    h = WeightTensorHashStep(h, receipt.shardIndexHash)
    h = WeightTensorHashTextWith(h, receipt.tensorName)
    h = WeightTensorHashTextWith(h, receipt.shardCid)
    h = WeightTensorHashTextWith(h, receipt.dtype)
    h = WeightTensorHashTextWith(h, receipt.quantScheme)
    h = WeightTensorHashStep(h, int64(receipt.tensorScale))
    h = WeightTensorHashTextWith(h, receipt.filePath)
    h = WeightTensorHashStep(h, receipt.fileByteCount)
    h = WeightTensorHashStep(h, receipt.dataStart)
    h = WeightTensorHashStep(h, receipt.dataEnd)
    h = WeightTensorHashStep(h, receipt.byteCount)
    h = WeightTensorHashTextWith(h, receipt.deviceCapabilityHash)
    h = WeightTensorHashStep(h, receipt.bindingSetHash)
    h = WeightTensorHashStep(h, receipt.bindingHash)
    h = WeightTensorHashStep(h, receipt.pageTableReceiptHash)
    h = WeightTensorHashStep(h, receipt.pageAggregateHash)
    h = WeightTensorHashStep(h, int64(receipt.pageIndex))
    h = WeightTensorHashStep(h, receipt.pageOffsetBytes)
    h = WeightTensorHashStep(h, receipt.pageByteCount)
    h = WeightTensorHashStep(h, receipt.pageSourceRangeHash)
    h = WeightTensorHashTextWith(h, receipt.bufferLoadStatus)
    h = device.DeviceHashU64(h, receipt.deviceBufferHandle)
    h = WeightTensorHashStep(h, receipt.deviceBufferSizeBytes)
    h = WeightTensorHashTextWith(h, receipt.deviceBufferDtype)
    h = WeightTensorHashStep(h, receipt.deviceBufferLogicalHash)
    h = WeightTensorHashStep(h, receipt.bufferLoadReceiptHash)
    return h

