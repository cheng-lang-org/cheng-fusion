@borrows
fn WeightHfQuantizationConfigHash(config: WeightHfQuantizationConfig): int64 =
    var h: int64 = int64(113)
    h = WeightTensorHashTextWith(h, config.schema)
    h = WeightTensorHashStep(h, config.present ? int64(1) : int64(0))
    h = WeightTensorHashTextWith(h, config.quantMethod)
    h = WeightTensorHashStep(h, int64(config.bits))
    h = WeightTensorHashStep(h, int64(config.groupSize))
    h = WeightTensorHashTextWith(h, config.storageDtype)
    h = WeightTensorHashTextWith(h, config.computeDtype)
    h = WeightTensorHashStep(h, config.sourceConfigHash)
    return h

@borrows
fn WeightSafetensorsJsonRawExactNonNegativeInt(raw: str): Result[int32] =
    var pos: int32
    var value: int64
    if !weightSafetensorsParseNonNegativeInt(raw, pos, value):
        return Err[int32]("weight hf quantization config: integer")
    pos = weightSafetensorsSkipWs(raw, pos)
    if pos != raw.len:
        return Err[int32]("weight hf quantization config: integer trailing")
    if value > int64(2147483647):
        return Err[int32]("weight hf quantization config: integer range")
    return Ok[int32](int32(value))

fn WeightSafetensorsJsonOptionalInt32(rawObject: str, name: str): Result[int32] =
    let raw = jsonfield.CsgCoreJsonTopRawField(rawObject, name)
    if !raw.found:
        return Ok[int32](0)
    return WeightSafetensorsJsonRawExactNonNegativeInt(raw.value)

fn WeightSafetensorsJsonOptionalString(rawObject: str, name: str): str =
    let field = jsonfield.CsgCoreJsonTopStringField(rawObject, name)
    if !field.found:
        return ""
    return field.value

fn WeightSafetensorsHfQuantMethodIsKnown(method: str): bool =
    if method == "none" || method == "symmetric_int8" || method == "symmetric_int4":
        return true
    if method == "w4afp8":
        return true
    if method == "gptq" || method == "awq" || method == "bitsandbytes_4bit":
        return true
    if method == "fp8":
        return true
    return false

fn WeightSafetensorsHfQuantMethodDefaultBits(method: str): int32 =
    if method == "w4afp8":
        return 4
    if method == "bitsandbytes_4bit" || method == "gptq" || method == "awq" || method == "symmetric_int4":
        return 4
    if method == "fp8" || method == "symmetric_int8":
        return 8
    return 0

fn WeightSafetensorsHfQuantizationConfigFromJson(configJson: str): Result[WeightHfQuantizationConfig] =
    if configJson == "":
        return Err[WeightHfQuantizationConfig]("weight hf quantization config: json")
    let sourceCanon = jsoncanon.CsgCoreJsonCanonicalize(configJson)
    if !sourceCanon.ok:
        return Err[WeightHfQuantizationConfig](strutil.Join(["weight hf quantization config: json ", share(sourceCanon.error)], ""))
    let sourceHash = WeightTensorHashTextWith(int64(113), sourceCanon.value)
    let rawQuant = jsonfield.CsgCoreJsonTopRawField(configJson, "quantization_config")
    if !rawQuant.found:
        var noneConfig = WeightHfQuantizationConfig(
            schema: WeightHfQuantizationConfigSchema,
            present: false,
            quantMethod: "none",
            bits: 0,
            groupSize: 0,
            storageDtype: "",
            computeDtype: "",
            sourceConfigHash: sourceHash,
            quantConfigHash: int64(0)
        )
        noneConfig.quantConfigHash = WeightHfQuantizationConfigHash(noneConfig)
        return Ok[WeightHfQuantizationConfig](noneConfig)
    if !WeightSafetensorsJsonRawStartsObject(rawQuant.value):
        return Err[WeightHfQuantizationConfig]("weight hf quantization config: object")
    let quantCanon = jsoncanon.CsgCoreJsonCanonicalize(rawQuant.value)
    if !quantCanon.ok:
        return Err[WeightHfQuantizationConfig](strutil.Join(["weight hf quantization config: quant json ", share(quantCanon.error)], ""))
    var method = WeightSafetensorsJsonOptionalString(rawQuant.value, "quant_method")
    if method == "":
        method = WeightSafetensorsJsonOptionalString(rawQuant.value, "quantization_method")
    if method == "":
        let load4 = jsonfield.CsgCoreJsonTopRawField(rawQuant.value, "load_in_4bit")
        if load4.found && load4.value == "true":
            method = "bitsandbytes_4bit"
    if method == "":
        return Err[WeightHfQuantizationConfig]("weight hf quantization config: quant method")
    if !WeightSafetensorsHfQuantMethodIsKnown(method):
        return Err[WeightHfQuantizationConfig]("weight hf quantization config: unsupported method")
    let bitsRes = WeightSafetensorsJsonOptionalInt32(rawQuant.value, "bits")
    if IsErr(bitsRes):
        return Err[WeightHfQuantizationConfig](Error(bitsRes))
    var bits = Value(bitsRes)
    if bits == 0:
        let wBitsRes = WeightSafetensorsJsonOptionalInt32(rawQuant.value, "w_bit")
        if IsErr(wBitsRes):
            return Err[WeightHfQuantizationConfig](Error(wBitsRes))
        bits = Value(wBitsRes)
    if bits == 0:
        bits = WeightSafetensorsHfQuantMethodDefaultBits(method)
    if bits < 0 || bits > 16:
        return Err[WeightHfQuantizationConfig]("weight hf quantization config: bits")
    let groupRes = WeightSafetensorsJsonOptionalInt32(rawQuant.value, "group_size")
    if IsErr(groupRes):
        return Err[WeightHfQuantizationConfig](Error(groupRes))
    var groupSize = Value(groupRes)
    if groupSize == 0:
        let qGroupRes = WeightSafetensorsJsonOptionalInt32(rawQuant.value, "q_group_size")
        if IsErr(qGroupRes):
            return Err[WeightHfQuantizationConfig](Error(qGroupRes))
        groupSize = Value(qGroupRes)
    let storageDtype = WeightSafetensorsJsonOptionalString(rawQuant.value, "bnb_4bit_quant_type")
    var computeDtype = WeightSafetensorsJsonOptionalString(rawQuant.value, "bnb_4bit_compute_dtype")
    if computeDtype == "":
        computeDtype = WeightSafetensorsJsonOptionalString(rawQuant.value, "compute_dtype")
    var out = WeightHfQuantizationConfig(
        schema: WeightHfQuantizationConfigSchema,
        present: true,
        quantMethod: method,
        bits: bits,
        groupSize: groupSize,
        storageDtype: storageDtype,
        computeDtype: computeDtype,
        sourceConfigHash: sourceHash,
        quantConfigHash: int64(0)
    )
    out.quantConfigHash = WeightHfQuantizationConfigHash(out)
    return Ok[WeightHfQuantizationConfig](out)

fn WeightSafetensorsFindGraphWeightByName(graph: model_graph.ModelGraph, tensorName: str): int32 =
    var found: int32 = -1
    for i in 0..<graph.weights.len:
        if graph.weights[i].tensorName == tensorName:
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn WeightSafetensorsW4Afp8ScaleTensorName(weightName: str): Result[str] =
    if weightName == "":
        return Err[str]("weight hf quantization config: w4afp8 weight name")
    return Ok[str](strutil.Join([ share(weightName), "_scale_inv"], ""))

@borrows
fn WeightSafetensorsW4Afp8InputScaleTensorName(weightName: str): Result[str] =
    if weightName == "":
        return Err[str]("weight hf quantization config: w4afp8 weight name")
    if WeightSafetensorsStringEndsWith(weightName, ".weight"):
        let prefix = strings.SliceBytes(weightName, 0, weightName.len - len(".weight"))
        return Ok[str](strutil.Join([share(prefix), ".input_scale"], ""))
    return Ok[str](strutil.Join([ share(weightName), "_input_scale"], ""))

fn WeightSafetensorsValidateW4Afp8OptionalInputScaleFact(graph: model_graph.ModelGraph,
                                                        weightName: str): Result[bool] =
    let inputScaleName = WeightSafetensorsW4Afp8InputScaleTensorName(weightName)
    if IsErr(inputScaleName):
        return Err[bool](Error(inputScaleName))
    let inputScaleIndex = WeightSafetensorsFindGraphWeightByName(graph, Value(inputScaleName))
    if inputScaleIndex == -2:
        return Err[bool]("weight hf quantization config: duplicate w4afp8 input scale")
    if inputScaleIndex >= 0:
        if graph.weights[inputScaleIndex].dtype != kernel_ir.KernelDtypeFp8E4M3 ||
           graph.weights[inputScaleIndex].quantScheme != model_graph.ModelQuantSchemeNone:
            return Err[bool]("weight hf quantization config: w4afp8 input scale dtype")
    return Ok[bool](true)

fn WeightSafetensorsValidateW4Afp8ScaleFacts(graph: model_graph.ModelGraph): Result[bool] =
    for i in 0..<graph.weights.len:
        if graph.weights[i].quantScheme == model_graph.ModelQuantSchemeW4Afp8:
            if graph.weights[i].dtype != kernel_ir.KernelDtypeInt8:
                return Err[bool]("weight hf quantization config: w4afp8 weight dtype")
            let scaleName = WeightSafetensorsW4Afp8ScaleTensorName(graph.weights[i].tensorName)
            if IsErr(scaleName):
                return Err[bool](Error(scaleName))
            let scaleIndex = WeightSafetensorsFindGraphWeightByName(graph, Value(scaleName))
            if scaleIndex == -2:
                return Err[bool]("weight hf quantization config: duplicate w4afp8 scale")
            if scaleIndex < 0:
                return Err[bool]("weight hf quantization config: missing w4afp8 scale")
            if graph.weights[scaleIndex].dtype != kernel_ir.KernelDtypeFp8E4M3 ||
               graph.weights[scaleIndex].quantScheme != model_graph.ModelQuantSchemeNone:
                return Err[bool]("weight hf quantization config: w4afp8 scale dtype")
            let inputScaleOk = WeightSafetensorsValidateW4Afp8OptionalInputScaleFact(graph, graph.weights[i].tensorName)
            if IsErr(inputScaleOk):
                return Err[bool](Error(inputScaleOk))
        elif graph.weights[i].quantScheme == model_graph.ModelQuantSchemeNone &&
             strutil.Contains(graph.weights[i].tensorName, "weight_scale_inv") &&
             graph.weights[i].dtype != kernel_ir.KernelDtypeFp8E4M3:
            return Err[bool]("weight hf quantization config: w4afp8 scale dtype")
        elif graph.weights[i].quantScheme == model_graph.ModelQuantSchemeNone &&
             strutil.Contains(graph.weights[i].tensorName, "input_scale") &&
             graph.weights[i].dtype != kernel_ir.KernelDtypeFp8E4M3:
            return Err[bool]("weight hf quantization config: w4afp8 input scale dtype")
    return Ok[bool](true)

fn WeightSafetensorsHfQuantizationConfigValidateForGraph(config: WeightHfQuantizationConfig,
                                                         graph: model_graph.ModelGraph): Result[bool] =
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    if config.schema != WeightHfQuantizationConfigSchema || config.quantConfigHash != WeightHfQuantizationConfigHash(config):
        return Err[bool]("weight hf quantization config: hash")
    var quantizedWeightCount: int32
    for i in 0..<graph.weights.len:
        if graph.weights[i].quantScheme != model_graph.ModelQuantSchemeNone:
            quantizedWeightCount = quantizedWeightCount + 1
    if !config.present || config.quantMethod == "none":
        if quantizedWeightCount != 0:
            return Err[bool]("weight hf quantization config: missing quant config")
        return Ok[bool](true)
    if config.quantMethod == "symmetric_int8":
        if config.bits != 8:
            return Err[bool]("weight hf quantization config: int8 bits")
        if quantizedWeightCount <= 0:
            return Err[bool]("weight hf quantization config: no quantized weights")
        for i in 0..<graph.weights.len:
            if graph.weights[i].quantScheme != model_graph.ModelQuantSchemeNone &&
               (graph.weights[i].dtype != kernel_ir.KernelDtypeInt8 ||
                graph.weights[i].quantScheme != model_graph.ModelQuantSchemeSymmetricInt8):
                return Err[bool]("weight hf quantization config: int8 graph")
        return Ok[bool](true)
    if config.quantMethod == "symmetric_int4":
        if config.bits != 4:
            return Err[bool]("weight hf quantization config: int4 bits")
        if quantizedWeightCount <= 0:
            return Err[bool]("weight hf quantization config: no quantized weights")
        for i in 0..<graph.weights.len:
            if graph.weights[i].quantScheme != model_graph.ModelQuantSchemeNone &&
               (graph.weights[i].dtype != kernel_ir.KernelDtypeInt4 ||
                graph.weights[i].quantScheme != model_graph.ModelQuantSchemeSymmetricInt4):
                return Err[bool]("weight hf quantization config: int4 graph")
        return Ok[bool](true)
    if config.quantMethod == "w4afp8":
        if config.bits != 4:
            return Err[bool]("weight hf quantization config: w4afp8 bits")
        if quantizedWeightCount <= 0:
            return Err[bool]("weight hf quantization config: no quantized weights")
        for i in 0..<graph.weights.len:
            if graph.weights[i].quantScheme != model_graph.ModelQuantSchemeNone &&
               (graph.weights[i].dtype != kernel_ir.KernelDtypeInt8 ||
                graph.weights[i].quantScheme != model_graph.ModelQuantSchemeW4Afp8):
                return Err[bool]("weight hf quantization config: w4afp8 graph")
        let scaleOk = WeightSafetensorsValidateW4Afp8ScaleFacts(graph)
        if IsErr(scaleOk):
            return Err[bool](Error(scaleOk))
        return Ok[bool](true)
    return Err[bool]("weight hf quantization config: unsupported quantized execution")

fn WeightSafetensorsRepositoryReceiptBuild(modelCid: str,
                                           graphHash: int64,
                                           hfIndexHash: int64,
                                           hfQuantConfig: WeightHfQuantizationConfig,
                                           shardIndexHash: int64,
                                           fileReceipts: WeightSafetensorsShardFileReceipt[],
                                           bindings: weight_binding.WeightBindingSet,
                                           store: WeightTensorStore): Result[WeightSafetensorsRepositoryReceipt] =
    if modelCid == "" || modelCid != bindings.modelCid || modelCid != store.modelCid:
        return Err[WeightSafetensorsRepositoryReceipt]("weight safetensors repository: model cid")
    if graphHash <= int64(0) || hfIndexHash <= int64(0) || shardIndexHash <= int64(0) ||
       hfQuantConfig.sourceConfigHash <= int64(0) || hfQuantConfig.quantConfigHash <= int64(0):
        return Err[WeightSafetensorsRepositoryReceipt]("weight safetensors repository: identity hash")
    if fileReceipts.len <= 0 || store.payloads.len <= 0:
        return Err[WeightSafetensorsRepositoryReceipt]("weight safetensors repository: empty")
    var fileHash = WeightSafetensorsShardFileReceiptHash(fileReceipts)
    if fileHash <= int64(0) || bindings.bindingHash <= int64(0) || store.storeHash <= int64(0):
        return Err[WeightSafetensorsRepositoryReceipt]("weight safetensors repository: receipt hash")
    var out = WeightSafetensorsRepositoryReceipt(
        schema: WeightSafetensorsRepositoryReceiptSchema,
        modelCid: modelCid,
        graphHash: graphHash,
        hfIndexHash: hfIndexHash,
        hfConfigHash: hfQuantConfig.sourceConfigHash,
        quantConfigHash: hfQuantConfig.quantConfigHash,
        shardIndexHash: shardIndexHash,
        fileReceiptHash: fileHash,
        bindingHash: bindings.bindingHash,
        storeHash: store.storeHash,
        payloadCount: store.payloads.len,
        receiptHash: int64(0)
    )
    out.receiptHash = WeightSafetensorsRepositoryReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[WeightSafetensorsRepositoryReceipt]("weight safetensors repository: receipt hash")
    return Ok[WeightSafetensorsRepositoryReceipt](out)

@borrows
fn WeightSafetensorsStringEndsWith(text: str, suffix: str): bool =
    if suffix.len > text.len:
        return false
    let start = text.len - suffix.len
    for i in 0..<suffix.len:
        if text[start + i] != suffix[i]:
            return false
    return true

@borrows
fn WeightSafetensorsJsonRawStartsObject(raw: str): bool =
    var pos: int32
    while pos < raw.len && (raw[pos] == ' ' || raw[pos] == '\t' || raw[pos] == '\r' || raw[pos] == '\n'):
        pos = pos + 1
    return pos < raw.len && raw[pos] == '{'

fn WeightSafetensorsHfShardFileNameIsSafe(fileName: str): bool =
    if fileName == "":
        return false
    if !WeightSafetensorsStringEndsWith(fileName, ".safetensors"):
        return false
    var previousDot = false
    for i in 0..<fileName.len:
        let ch = fileName[i]
        if ch == '/' || ch == '\\' || ch == ':' || ch == '\0':
            return false
        if ch == '.':
            if previousDot:
                return false
            previousDot = true
        else:
            previousDot = false
    return true

fn WeightSafetensorsShardIndexFromHfWeightMap(indexJson: str,
                                             graph: model_graph.ModelGraph,
                                             baseDir: str,
                                             peerIds: str[],
                                             tensorScale: int32): Result[WeightSafetensorsShardIndex] =
    if indexJson == "":
        return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: json")
    if baseDir == "":
        return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: base dir")
    if tensorScale <= 0:
        return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: tensor scale")
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[WeightSafetensorsShardIndex](Error(graphOk))
    if peerIds.len != graph.weights.len:
        return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: peer count")
    let canon = jsoncanon.CsgCoreJsonCanonicalize(indexJson)
    if !canon.ok:
        return Err[WeightSafetensorsShardIndex](strutil.Join(["weight safetensors hf index: json ", share(canon.error)], ""))
    let rawWeightMap = jsonfield.CsgCoreJsonTopRawField(indexJson, "weight_map")
    if !rawWeightMap.found:
        return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: weight_map")
    let weightMapCanon = jsoncanon.CsgCoreJsonCanonicalize(rawWeightMap.value)
    if !weightMapCanon.ok:
        return Err[WeightSafetensorsShardIndex](strutil.Join(["weight safetensors hf index: weight_map json ", share(weightMapCanon.error)], ""))
    if !WeightSafetensorsJsonRawStartsObject(rawWeightMap.value):
        return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: weight_map object")

    var entries: WeightSafetensorsShardIndexEntry[]
    for i in 0..<graph.weights.len:
        if peerIds[i] == "":
            return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: peer id")
        let fileName = jsonfield.CsgCoreJsonTopStringField(rawWeightMap.value, graph.weights[i].tensorName)
        if !fileName.found:
            return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: missing tensor")
        if !WeightSafetensorsHfShardFileNameIsSafe(fileName.value):
            return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: shard file name")
        add(entries, WeightSafetensorsShardIndexEntry(
            modelCid: graph.weights[i].modelCid,
            graphHash: graph.graphHash,
            tensorName: graph.weights[i].tensorName,
            shardCid: graph.weights[i].shardCid,
            dtype: graph.weights[i].dtype,
            quantScheme: graph.weights[i].quantScheme,
            sizeBytes: graph.weights[i].sizeBytes,
            filePath: os.JoinPath(baseDir, fileName.value),
            peerId: peerIds[i],
            tensorScale: tensorScale
        ))
    let index = WeightSafetensorsShardIndexBuild(graph.modelCid, graph.graphHash, entries)
    let indexOk = WeightSafetensorsShardIndexValidate(index, graph)
    if IsErr(indexOk):
        return Err[WeightSafetensorsShardIndex](Error(indexOk))
    return Ok[WeightSafetensorsShardIndex](index)

fn WeightSafetensorsShardIndexFromHfWeightMapPath(indexPath: str,
                                                 graph: model_graph.ModelGraph,
                                                 baseDir: str,
                                                 peerIds: str[],
                                                 tensorScale: int32): Result[WeightSafetensorsShardIndex] =
    if indexPath == "":
        return Err[WeightSafetensorsShardIndex]("weight safetensors hf index: path")
    let bytesRes = os.ReadFileBytesResult(indexPath)
    if IsErr(bytesRes):
        return Err[WeightSafetensorsShardIndex](Error(bytesRes))
    let text = rawbytes.BytesToString(Value(bytesRes))
    return WeightSafetensorsShardIndexFromHfWeightMap(text, graph, baseDir, peerIds, tensorScale)

fn WeightTensorWriteI32LE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, value & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(buf, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(buf, offset + 3, (value >> 24) & 255)

fn WeightTensorReadI32LE(buf: rawbytes.Bytes, offset: int32): int32 =
    let b0: int64 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1: int64 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2: int64 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3: int64 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    return int32(b0 | (b1 << 8) | (b2 << 16) | (b3 << 24))

@borrows
fn WeightSafetensorsReadU64LE(buf: rawbytes.Bytes, offset: int32): Result[int64] =
    if offset < 0 || offset + 8 > rawbytes.BytesLen(buf):
        return Err[int64]("weight safetensors: short u64")
    let b7 = int64(rawbytes.BytesGet(buf, offset + 7) & 255)
    if b7 > int64(127):
        return Err[int64]("weight safetensors: u64 exceeds int64")
    let b0 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    let b4 = int64(rawbytes.BytesGet(buf, offset + 4) & 255)
    let b5 = int64(rawbytes.BytesGet(buf, offset + 5) & 255)
    let b6 = int64(rawbytes.BytesGet(buf, offset + 6) & 255)
    return Ok[int64](b0 |
                     (b1 << 8) |
                     (b2 << 16) |
                     (b3 << 24) |
                     (b4 << 32) |
                     (b5 << 40) |
                     (b6 << 48) |
                     (b7 << 56))

@borrows
fn WeightSafetensorsReadU16LE(buf: rawbytes.Bytes, offset: int32): Result[int32] =
    if offset < 0 || offset + 2 > rawbytes.BytesLen(buf):
        return Err[int32]("weight safetensors: short u16")
    let b0 = rawbytes.BytesGet(buf, offset) & 255
    let b1 = rawbytes.BytesGet(buf, offset + 1) & 255
    return Ok[int32](b0 | (b1 << 8))

fn WeightSafetensorsPow2I64(shift: int32): Result[int64] =
    if shift < 0 || shift > 62:
        return Err[int64]("weight safetensors: pow2 shift")
    return Ok[int64](int64(1) << shift)

fn WeightSafetensorsApplySign(value: int32, signBit: int32): int32 =
    if signBit != 0:
        return 0 - value
    return value

fn WeightSafetensorsScaleBinary(signBit: int32,
                                significand: int64,
                                scale: int32,
                                binaryShift: int32): Result[int32] =
    if significand == int64(0):
        return Ok[int32](0)
    if scale <= 0:
        return Err[int32]("weight safetensors: tensor scale")
    var magnitude: int64 = significand * int64(scale)
    if binaryShift >= 0:
        if binaryShift > 30:
            return Ok[int32](signBit == 0 ? 2147483647 : -2147483648)
        if magnitude > int64(9223372036854775807) >> binaryShift:
            return Ok[int32](signBit == 0 ? 2147483647 : -2147483648)
        magnitude = magnitude << binaryShift
    else:
        let denomShift = 0 - binaryShift
        if denomShift > 62:
            return Ok[int32](0)
        let denom = WeightSafetensorsPow2I64(denomShift)
        if IsErr(denom):
            return Err[int32](Error(denom))
        magnitude = infer.InferenceRoundDivI64(magnitude, Value(denom))
    let saturated = infer.InferenceSaturateI32(magnitude)
    return Ok[int32](WeightSafetensorsApplySign(saturated, signBit))

fn WeightSafetensorsDecodeF16Scaled(raw: int32, scale: int32): Result[int32] =
    let signBit = (raw >> 15) & 1
    let exp = (raw >> 10) & 31
    let frac = raw & 1023
    if exp == 31:
        return Err[int32]("weight safetensors: f16 nan inf")
    if exp == 0:
        if frac == 0:
            return Ok[int32](0)
        return WeightSafetensorsScaleBinary(signBit, int64(frac), scale, -24)
    return WeightSafetensorsScaleBinary(signBit, int64(1024 + frac), scale, exp - 25)

fn WeightSafetensorsDecodeBf16Scaled(raw: int32, scale: int32): Result[int32] =
    let signBit = (raw >> 15) & 1
    let exp = (raw >> 7) & 255
    let frac = raw & 127
    if exp == 255:
        return Err[int32]("weight safetensors: bf16 nan inf")
    if exp == 0:
        if frac == 0:
            return Ok[int32](0)
        return WeightSafetensorsScaleBinary(signBit, int64(frac), scale, -133)
    return WeightSafetensorsScaleBinary(signBit, int64(128 + frac), scale, exp - 134)

fn WeightSafetensorsDecodeFp8E4M3Scaled(raw: int32, scale: int32): Result[int32] =
    let byteValue = raw & 255
    let signBit = (byteValue >> 7) & 1
    let exp = (byteValue >> 3) & 15
    let frac = byteValue & 7
    if exp == 15 && frac == 7:
        return Err[int32]("weight safetensors: fp8 e4m3 nan")
    if exp == 0:
        if frac == 0:
            return Ok[int32](0)
        return WeightSafetensorsScaleBinary(signBit, int64(frac), scale, -9)
    return WeightSafetensorsScaleBinary(signBit, int64(8 + frac), scale, exp - 10)

fn WeightSafetensorsDecodeI8Scaled(raw: int32, scale: int32): Result[int32] =
    if scale <= 0:
        return Err[int32]("weight safetensors: tensor scale")
    var signedValue = raw & 255
    if signedValue >= 128:
        signedValue = signedValue - 256
    return Ok[int32](infer.InferenceSaturateI32(int64(signedValue) * int64(scale)))

fn WeightSafetensorsDecodeI4Scaled(rawNibble: int32, scale: int32): Result[int32] =
    let value = kernel_ir.KernelIrDecodeInt4Scaled(rawNibble, scale)
    if IsErr(value):
        return Err[int32]("weight safetensors: tensor scale")
    return value

@borrows
fn WeightSafetensorsHeaderLength(bytes: rawbytes.Bytes): Result[int32] =
    if rawbytes.BytesLen(bytes) < 8:
        return Err[int32]("weight safetensors: short file")
    let headerLen64 = WeightSafetensorsReadU64LE(bytes, 0)
    if IsErr(headerLen64):
        return Err[int32](Error(headerLen64))
    if Value(headerLen64) <= int64(0):
        return Err[int32]("weight safetensors: empty header")
    if Value(headerLen64) > int64(rawbytes.BytesLen(bytes) - 8):
        return Err[int32]("weight safetensors: header length")
    if Value(headerLen64) > int64(2147483639):
        return Err[int32]("weight safetensors: header too large")
    return Ok[int32](int32(Value(headerLen64)))

fn WeightSafetensorsHeaderText(bytes: rawbytes.Bytes): Result[str] =
    let headerLen = WeightSafetensorsHeaderLength(bytes)
    if IsErr(headerLen):
        return Err[str](Error(headerLen))
    let headerBytes = rawbytes.BytesSliceView(bytes, 8, Value(headerLen))
    let headerText = rawbytes.BytesToString(headerBytes)
    let canon = jsoncanon.CsgCoreJsonCanonicalize(headerText)
    if !canon.ok:
        return Err[str](strutil.Join(["weight safetensors: header json ", share(canon.error)], ""))
    return Ok[str](headerText)

fn weightSafetensorsIsWs(ch: char): bool =
    return ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'

@borrows
fn weightSafetensorsSkipWs(text: str, pos: int32): int32 =
    var i: int32 = pos
    while i < text.len && weightSafetensorsIsWs(text[i]):
        i = i + 1
    return i

@borrows
fn weightSafetensorsParseNonNegativeInt(text: str, pos: var int32, outValue: var int64): bool =
    pos = weightSafetensorsSkipWs(text, pos)
    if pos >= text.len || text[pos] < '0' || text[pos] > '9':
        return false
    var value: int64
    while pos < text.len && text[pos] >= '0' && text[pos] <= '9':
        let digit = int64(Int32(text[pos]) - Int32('0'))
        if value > (int64(9223372036854775807) - digit) / int64(10):
            return false
        value = value * int64(10) + digit
        pos = pos + 1
    outValue = value
    return true

@borrows
fn WeightSafetensorsParseInt64Array(raw: str): Result[int64[]] =
    var values: int64[]
    var pos: int32
    pos = weightSafetensorsSkipWs(raw, pos)
    if pos >= raw.len || raw[pos] != '[':
        return Err[int64[]]("weight safetensors: array expected")
    pos = pos + 1
    pos = weightSafetensorsSkipWs(raw, pos)
    if pos < raw.len && raw[pos] == ']':
        return Err[int64[]]("weight safetensors: empty array")
    while pos < raw.len:
        var item: int64
        if !weightSafetensorsParseNonNegativeInt(raw, pos, item):
            return Err[int64[]]("weight safetensors: integer array")
        add(values, item)
        pos = weightSafetensorsSkipWs(raw, pos)
        if pos >= raw.len:
            return Err[int64[]]("weight safetensors: unterminated array")
        if raw[pos] == ']':
            pos = pos + 1
            pos = weightSafetensorsSkipWs(raw, pos)
            if pos != raw.len:
                return Err[int64[]]("weight safetensors: trailing array input")
            return Ok[int64[]](values)
        if raw[pos] != ',':
            return Err[int64[]]("weight safetensors: array comma")
        pos = pos + 1
    return Err[int64[]]("weight safetensors: unterminated array")

@borrows
fn WeightSafetensorsDtypeForGraph(dtype: str): Result[str] =
    if dtype == kernel_ir.KernelDtypeFp16:
        return Ok[str]("F16")
    if dtype == kernel_ir.KernelDtypeBf16:
        return Ok[str]("BF16")
    if dtype == kernel_ir.KernelDtypeFp8E4M3:
        return Ok[str]("F8_E4M3")
    if dtype == kernel_ir.KernelDtypeInt8:
        return Ok[str]("I8")
    if dtype == kernel_ir.KernelDtypeInt4:
        return Ok[str]("U8")
    return Err[str]("weight safetensors: unsupported dtype")

@borrows
fn WeightSafetensorsShapeMatches(rawShape: str, expectedShape: int32[]): Result[bool] =
    let parsed = WeightSafetensorsParseInt64Array(rawShape)
    if IsErr(parsed):
        return Err[bool](Error(parsed))
    let values = Value(parsed)
    if values.len != expectedShape.len:
        return Err[bool]("weight safetensors: shape rank")
    for i in 0..<values.len:
        if values[i] <= int64(0) || values[i] > int64(2147483647):
            return Err[bool]("weight safetensors: shape dim")
        if int32(values[i]) != expectedShape[i]:
            return Err[bool]("weight safetensors: shape mismatch")
    return Ok[bool](true)

fn WeightSafetensorsTensorMetaFromHeader(headerText: str,
                                         fileLen: int64,
                                         dataBase: int64,
                                         weight: model_graph.ModelWeightShard): Result[WeightSafetensorsTensorMeta] =
    let quantOk = model_graph.ModelGraphWeightQuantSchemeValid(weight.dtype, weight.quantScheme)
    if IsErr(quantOk):
        return Err[WeightSafetensorsTensorMeta](Error(quantOk))
    let rawTensor = jsonfield.CsgCoreJsonTopRawField(headerText, weight.tensorName)
    if !rawTensor.found:
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: missing tensor")
    let tensorCanon = jsoncanon.CsgCoreJsonCanonicalize(rawTensor.value)
    if !tensorCanon.ok:
        return Err[WeightSafetensorsTensorMeta](strutil.Join(["weight safetensors: tensor json ", share(tensorCanon.error)], ""))
    let dtype = jsonfield.CsgCoreJsonTopStringField(rawTensor.value, "dtype")
    if !dtype.found:
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: tensor dtype")
    let expectedDtype = WeightSafetensorsDtypeForGraph(weight.dtype)
    if IsErr(expectedDtype):
        return Err[WeightSafetensorsTensorMeta](Error(expectedDtype))
    if dtype.value != Value(expectedDtype):
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: dtype mismatch")
    let rawShape = jsonfield.CsgCoreJsonTopRawField(rawTensor.value, "shape")
    if !rawShape.found:
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: tensor shape")
    let shapeOk = WeightSafetensorsShapeMatches(rawShape.value, weight.shape)
    if IsErr(shapeOk):
        return Err[WeightSafetensorsTensorMeta](Error(shapeOk))
    let rawOffsets = jsonfield.CsgCoreJsonTopRawField(rawTensor.value, "data_offsets")
    if !rawOffsets.found:
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: tensor offsets")
    let offsetsRes = WeightSafetensorsParseInt64Array(rawOffsets.value)
    if IsErr(offsetsRes):
        return Err[WeightSafetensorsTensorMeta](Error(offsetsRes))
    let offsets = Value(offsetsRes)
    if offsets.len != 2:
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: offset count")
    if offsets[1] <= offsets[0]:
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: offset order")
    if offsets[1] - offsets[0] != weight.sizeBytes:
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: tensor byte size")
    if offsets[1] > fileLen - dataBase:
        return Err[WeightSafetensorsTensorMeta]("weight safetensors: tensor range")
    return Ok[WeightSafetensorsTensorMeta](WeightSafetensorsTensorMeta(
        tensorName: share(weight.tensorName),
        dtype: share(dtype.value),
        shape: share(weight.shape),
        dataStart: offsets[0],
        dataEnd: offsets[1],
        byteCount: offsets[1] - offsets[0]
    ))

fn WeightSafetensorsValidateGraphFile(bytes: rawbytes.Bytes,
                                      graph: model_graph.ModelGraph): Result[WeightSafetensorsManifest] =
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[WeightSafetensorsManifest](Error(graphOk))
    let headerLen = WeightSafetensorsHeaderLength(bytes)
    if IsErr(headerLen):
        return Err[WeightSafetensorsManifest](Error(headerLen))
    let headerText = WeightSafetensorsHeaderText(bytes)
    if IsErr(headerText):
        return Err[WeightSafetensorsManifest](Error(headerText))
    let dataBase = int64(8 + Value(headerLen))
    var metas: WeightSafetensorsTensorMeta[]
    for i in 0..<graph.weights.len:
        let metaRes = WeightSafetensorsTensorMetaFromHeader(Value(headerText),
                                                           int64(rawbytes.BytesLen(bytes)),
                                                           dataBase,
                                                           graph.weights[i])
        if IsErr(metaRes):
            return Err[WeightSafetensorsManifest](Error(metaRes))
        add(metas, Value(metaRes))
    for i in 0..<metas.len:
        for j in i + 1..<metas.len:
            if !(metas[i].dataEnd <= metas[j].dataStart || metas[j].dataEnd <= metas[i].dataStart):
                return Err[WeightSafetensorsManifest]("weight safetensors: overlapping tensor data")
    return Ok[WeightSafetensorsManifest](WeightSafetensorsManifest(
        schema: WeightSafetensorsManifestSchema,
        headerHash: WeightTensorHashTextWith(int64(113), Value(headerText)),
        tensors: metas
    ))

fn WeightSafetensorsValidateGraphFilePath(path: str,
                                          graph: model_graph.ModelGraph): Result[WeightSafetensorsManifest] =
    if path == "":
        return Err[WeightSafetensorsManifest]("weight safetensors: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[WeightSafetensorsManifest](Error(bytesRes))
    return WeightSafetensorsValidateGraphFile(Value(bytesRes), graph)

fn WeightSafetensorsHeaderLen64FromPath(path: str): Result[int64] =
    if path == "":
        return Err[int64]("weight safetensors header: path")
    let first = os.ReadFilePrefixBytesResult(path, 8)
    if IsErr(first):
        return Err[int64](Error(first))
    var firstBytes = Value(first)
    if rawbytes.BytesLen(firstBytes) != 8:
        rawbytes.BytesFree(firstBytes)
        return Err[int64]("weight safetensors header: short length")
    let headerLen64 = WeightSafetensorsReadU64LE(firstBytes, 0)
    if IsErr(headerLen64):
        rawbytes.BytesFree(firstBytes)
        return Err[int64](Error(headerLen64))
    rawbytes.BytesFree(firstBytes)
    return headerLen64

fn WeightSafetensorsReadHeaderPrefixPath(path: str): Result[rawbytes.Bytes] =
    let headerLen64 = WeightSafetensorsHeaderLen64FromPath(share(path))
    if IsErr(headerLen64):
        return Err[rawbytes.Bytes](Error(headerLen64))
    if Value(headerLen64) <= int64(0):
        return Err[rawbytes.Bytes]("weight safetensors header: empty")
    if Value(headerLen64) > int64(2147483639):
        return Err[rawbytes.Bytes]("weight safetensors header: too large")
    let prefixLen = int32(Value(headerLen64) + int64(8))
    let prefixRes = os.ReadFilePrefixBytesResult(path, prefixLen)
    if IsErr(prefixRes):
        return Err[rawbytes.Bytes](Error(prefixRes))
    var prefix = Value(prefixRes)
    if rawbytes.BytesLen(prefix) != prefixLen:
        rawbytes.BytesFree(prefix)
        return Err[rawbytes.Bytes]("weight safetensors header: short file")
    let headerLenCheck = WeightSafetensorsHeaderLength(prefix)
    if IsErr(headerLenCheck):
        rawbytes.BytesFree(prefix)
        return Err[rawbytes.Bytes](Error(headerLenCheck))
    if Value(headerLenCheck) != int32(Value(headerLen64)):
        rawbytes.BytesFree(prefix)
        return Err[rawbytes.Bytes]("weight safetensors header: length mismatch")
    return Ok[rawbytes.Bytes](prefix)

fn WeightSafetensorsValidateGraphFileHeaderPath(path: str,
                                                graph: model_graph.ModelGraph): Result[WeightSafetensorsManifest] =
    if path == "":
        return Err[WeightSafetensorsManifest]("weight safetensors header: path")
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[WeightSafetensorsManifest](Error(graphOk))
    let fileLen = os.FileSize(path)
    if fileLen <= int64(8):
        return Err[WeightSafetensorsManifest]("weight safetensors header: file size")
    let prefixRes = WeightSafetensorsReadHeaderPrefixPath(path)
    if IsErr(prefixRes):
        return Err[WeightSafetensorsManifest](Error(prefixRes))
    var prefixBytes = Value(prefixRes)
    let headerLen = WeightSafetensorsHeaderLength(prefixBytes)
    if IsErr(headerLen):
        rawbytes.BytesFree(prefixBytes)
        return Err[WeightSafetensorsManifest](Error(headerLen))
    let headerTextRes = WeightSafetensorsHeaderText(prefixBytes)
    if IsErr(headerTextRes):
        rawbytes.BytesFree(prefixBytes)
        return Err[WeightSafetensorsManifest](Error(headerTextRes))
    var headerText = Value(headerTextRes)
    let dataBase = int64(8 + Value(headerLen))
    var metas: WeightSafetensorsTensorMeta[]
    for i in 0..<graph.weights.len:
        let metaRes = WeightSafetensorsTensorMetaFromHeader(share(headerText),
                                                           fileLen,
                                                           dataBase,
                                                           share(graph.weights[i]))
        if IsErr(metaRes):
            rawbytes.BytesFree(prefixBytes)
            return Err[WeightSafetensorsManifest](Error(metaRes))
        add(metas, Value(metaRes))
    for i in 0..<metas.len:
        for j in i + 1..<metas.len:
            if !(metas[i].dataEnd <= metas[j].dataStart || metas[j].dataEnd <= metas[i].dataStart):
                rawbytes.BytesFree(prefixBytes)
                return Err[WeightSafetensorsManifest]("weight safetensors header: overlapping tensor data")
    rawbytes.BytesFree(prefixBytes)
    return Ok[WeightSafetensorsManifest](WeightSafetensorsManifest(
        schema: WeightSafetensorsManifestSchema,
        headerHash: WeightTensorHashTextWith(int64(113), headerText),
        tensors: metas
    ))

@borrows
fn WeightSafetensorsHashFileRangePath(path: str,
                                      offsetBytes: int64,
                                      byteCount: int64,
                                      chunkBytes: int32): Result[int64] =
    if path == "":
        return Err[int64]("weight safetensors range hash: path")
    if offsetBytes < int64(0) || byteCount <= int64(0):
        return Err[int64]("weight safetensors range hash: range")
    if chunkBytes <= 0 || chunkBytes > 67108864:
        return Err[int64]("weight safetensors range hash: chunk")
    let fileLen = os.FileSize(path)
    if fileLen < int64(0):
        return Err[int64]("weight safetensors range hash: file size")
    if offsetBytes > fileLen || byteCount > fileLen - offsetBytes:
        return Err[int64]("weight safetensors range hash: range beyond file")
    var h: int64 = int64(113)
    h = WeightTensorHashStep(h, byteCount)
    var cursor: int64
    while cursor < byteCount:
        var want = chunkBytes
        if int64(want) > byteCount - cursor:
            want = int32(byteCount - cursor)
        let chunk = os.ReadFileRangeBytesResult(share(path), offsetBytes + cursor, want)
        if IsErr(chunk):
            return Err[int64](Error(chunk))
        if rawbytes.BytesLen(Value(chunk)) != want:
            return Err[int64]("weight safetensors range hash: short chunk")
        h = WeightTensorHashBytesWith(h, Value(chunk))
        cursor = cursor + int64(want)
    if h <= int64(0):
        return Err[int64]("weight safetensors range hash: hash")
    return Ok[int64](h)

@borrows
fn WeightSafetensorsBuildTensorRawPayloadHashReceipt(index: WeightSafetensorsShardIndex,
                                                     graph: model_graph.ModelGraph,
                                                     entryIndex: int32,
                                                     chunkBytes: int32): Result[WeightSafetensorsTensorRawPayloadHashReceipt] =
    let indexOk = WeightSafetensorsShardIndexValidate(index, graph)
    if IsErr(indexOk):
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt](Error(indexOk))
    if entryIndex < 0 || entryIndex >= index.entries.len:
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt]("weight safetensors raw payload hash: entry")
    let entry = index.entries[entryIndex]
    let graphIndex = WeightSafetensorsShardIndexFindGraphWeight(graph, entry)
    if graphIndex < 0:
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt]("weight safetensors raw payload hash: graph weight")
    let fileLen = os.FileSize(entry.filePath)
    if fileLen <= int64(8):
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt]("weight safetensors raw payload hash: file size")
    let prefix = WeightSafetensorsReadHeaderPrefixPath(entry.filePath)
    if IsErr(prefix):
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt](Error(prefix))
    let headerLen = WeightSafetensorsHeaderLength(Value(prefix))
    if IsErr(headerLen):
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt](Error(headerLen))
    let headerText = WeightSafetensorsHeaderText(Value(prefix))
    if IsErr(headerText):
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt](Error(headerText))
    let dataBase = int64(8 + Value(headerLen))
    let meta = WeightSafetensorsTensorMetaFromHeader(Value(headerText),
                                                     fileLen,
                                                     dataBase,
                                                     graph.weights[graphIndex])
    if IsErr(meta):
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt](Error(meta))
    let absStart = dataBase + Value(meta).dataStart
    let absEnd = dataBase + Value(meta).dataEnd
    let rawHash = WeightSafetensorsHashFileRangePath(entry.filePath,
                                                     absStart,
                                                     Value(meta).byteCount,
                                                     chunkBytes)
    if IsErr(rawHash):
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt](Error(rawHash))
    var out = WeightSafetensorsTensorRawPayloadHashReceipt(
        schema: WeightSafetensorsTensorRawPayloadHashReceiptSchema,
        modelCid: entry.modelCid,
        graphHash: entry.graphHash,
        shardIndexHash: index.indexHash,
        tensorName: entry.tensorName,
        shardCid: entry.shardCid,
        dtype: entry.dtype,
        quantScheme: entry.quantScheme,
        filePath: entry.filePath,
        fileByteCount: fileLen,
        dataStart: absStart,
        dataEnd: absEnd,
        byteCount: Value(meta).byteCount,
        chunkBytes: chunkBytes,
        rawPayloadByteHash: Value(rawHash),
        receiptHash: int64(0)
    )
    out.receiptHash = WeightSafetensorsTensorRawPayloadHashReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[WeightSafetensorsTensorRawPayloadHashReceipt]("weight safetensors raw payload hash: receipt hash")
    return Ok[WeightSafetensorsTensorRawPayloadHashReceipt](out)

@borrows
fn WeightSafetensorsValidateTensorRawPayloadHashReceipt(index: WeightSafetensorsShardIndex,
                                                       graph: model_graph.ModelGraph,
                                                       entryIndex: int32,
                                                       receipt: WeightSafetensorsTensorRawPayloadHashReceipt): Result[bool] =
    let expected = WeightSafetensorsBuildTensorRawPayloadHashReceipt(index, graph, entryIndex, receipt.chunkBytes)
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.schema != WeightSafetensorsTensorRawPayloadHashReceiptSchema ||
       receipt.modelCid != want.modelCid ||
       receipt.graphHash != want.graphHash ||
       receipt.shardIndexHash != want.shardIndexHash ||
       receipt.tensorName != want.tensorName ||
       receipt.shardCid != want.shardCid ||
       receipt.dtype != want.dtype ||
       receipt.quantScheme != want.quantScheme ||
       receipt.filePath != want.filePath ||
       receipt.fileByteCount != want.fileByteCount ||
       receipt.dataStart != want.dataStart ||
       receipt.dataEnd != want.dataEnd ||
       receipt.byteCount != want.byteCount ||
       receipt.chunkBytes != want.chunkBytes ||
       receipt.rawPayloadByteHash != want.rawPayloadByteHash ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("weight safetensors raw payload hash: mismatch")
    if WeightSafetensorsTensorRawPayloadHashReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("weight safetensors raw payload hash: hash")
    return Ok[bool](true)

@borrows
fn WeightSafetensorsBuildPayloadHashPreflight(index: WeightSafetensorsShardIndex,
                                              graph: model_graph.ModelGraph,
                                              chunkBytes: int32): Result[WeightSafetensorsPayloadHashPreflight] =
    let indexOk = WeightSafetensorsShardIndexValidate(index, graph)
    if IsErr(indexOk):
        return Err[WeightSafetensorsPayloadHashPreflight](Error(indexOk))
    if chunkBytes <= 0 || chunkBytes > 67108864:
        return Err[WeightSafetensorsPayloadHashPreflight]("weight safetensors payload hash preflight: chunk")
    var receipts: WeightSafetensorsTensorRawPayloadHashReceipt[]
    var totalBytes: int64
    for i in 0..<index.entries.len:
        let receipt = WeightSafetensorsBuildTensorRawPayloadHashReceipt(index, graph, i, chunkBytes)
        if IsErr(receipt):
            return Err[WeightSafetensorsPayloadHashPreflight](Error(receipt))
        if Value(receipt).chunkBytes != chunkBytes:
            return Err[WeightSafetensorsPayloadHashPreflight]("weight safetensors payload hash preflight: receipt chunk")
        totalBytes = totalBytes + Value(receipt).byteCount
        add(receipts, Value(receipt))
    if receipts.len <= 0 || receipts.len != graph.weights.len:
        return Err[WeightSafetensorsPayloadHashPreflight]("weight safetensors payload hash preflight: tensor count")
    let receiptHash = WeightSafetensorsTensorRawPayloadHashReceiptSetHash(receipts)
    if receiptHash <= int64(0):
        return Err[WeightSafetensorsPayloadHashPreflight]("weight safetensors payload hash preflight: tensor receipt hash")
    var out = WeightSafetensorsPayloadHashPreflight(
        schema: WeightSafetensorsPayloadHashPreflightSchema,
        modelCid: index.modelCid,
        graphHash: index.graphHash,
        shardIndexHash: index.indexHash,
        tensorReceipts: receipts,
        tensorReceiptHash: receiptHash,
        tensorCount: receipts.len,
        totalPayloadBytes: totalBytes,
        chunkBytes: chunkBytes,
        receiptHash: int64(0)
    )
    out.receiptHash = WeightSafetensorsPayloadHashPreflightHash(out)
    if out.receiptHash <= int64(0):
        return Err[WeightSafetensorsPayloadHashPreflight]("weight safetensors payload hash preflight: receipt hash")
    return Ok[WeightSafetensorsPayloadHashPreflight](out)

@borrows
fn WeightSafetensorsValidatePayloadHashPreflight(index: WeightSafetensorsShardIndex,
                                                 graph: model_graph.ModelGraph,
                                                 preflight: WeightSafetensorsPayloadHashPreflight): Result[bool] =
    let expected = WeightSafetensorsBuildPayloadHashPreflight(index, graph, preflight.chunkBytes)
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if preflight.schema != WeightSafetensorsPayloadHashPreflightSchema ||
       preflight.modelCid != want.modelCid ||
       preflight.graphHash != want.graphHash ||
       preflight.shardIndexHash != want.shardIndexHash ||
       preflight.tensorReceipts.len != want.tensorReceipts.len ||
       preflight.tensorReceiptHash != want.tensorReceiptHash ||
       preflight.tensorCount != want.tensorCount ||
       preflight.totalPayloadBytes != want.totalPayloadBytes ||
       preflight.chunkBytes != want.chunkBytes ||
       preflight.receiptHash != want.receiptHash:
        return Err[bool]("weight safetensors payload hash preflight: mismatch")
    for i in 0..<preflight.tensorReceipts.len:
        if preflight.tensorReceipts[i].receiptHash != want.tensorReceipts[i].receiptHash:
            return Err[bool]("weight safetensors payload hash preflight: tensor receipt")
    if WeightSafetensorsTensorRawPayloadHashReceiptSetHash(preflight.tensorReceipts) != preflight.tensorReceiptHash:
        return Err[bool]("weight safetensors payload hash preflight: tensor hash")
    if WeightSafetensorsPayloadHashPreflightHash(preflight) != preflight.receiptHash:
        return Err[bool]("weight safetensors payload hash preflight: hash")
    return Ok[bool](true)

fn WeightSafetensorsBuildDeviceRangeBindingFromReceipt(index: WeightSafetensorsShardIndex,
                                                       graph: model_graph.ModelGraph,
                                                       entryIndex: int32,
                                                       receipt: WeightSafetensorsTensorRawPayloadHashReceipt,
                                                       deviceCapabilityHash: str,
                                                       deviceBufferSizeBytes: int64,
                                                       deviceBufferDtype: str,
                                                       deviceBufferLogicalHash: int64): Result[WeightSafetensorsDeviceRangeBinding] =
    let receiptOk = WeightSafetensorsValidateTensorRawPayloadHashReceipt(index, graph, entryIndex, receipt)
    if IsErr(receiptOk):
        return Err[WeightSafetensorsDeviceRangeBinding](Error(receiptOk))
    if entryIndex < 0 || entryIndex >= index.entries.len:
        return Err[WeightSafetensorsDeviceRangeBinding]("weight safetensors device range: entry")
    let entry = index.entries[entryIndex]
    if entry.tensorScale <= 0:
        return Err[WeightSafetensorsDeviceRangeBinding]("weight safetensors device range: tensor scale")
    if deviceCapabilityHash == "":
        return Err[WeightSafetensorsDeviceRangeBinding]("weight safetensors device range: capability")
    if deviceBufferSizeBytes != receipt.byteCount:
        return Err[WeightSafetensorsDeviceRangeBinding]("weight safetensors device range: buffer size")
    if deviceBufferDtype != receipt.dtype:
        return Err[WeightSafetensorsDeviceRangeBinding]("weight safetensors device range: buffer dtype")
    if deviceBufferLogicalHash != receipt.rawPayloadByteHash:
        return Err[WeightSafetensorsDeviceRangeBinding]("weight safetensors device range: buffer hash")
    var out = WeightSafetensorsDeviceRangeBinding(
        schema: WeightSafetensorsDeviceRangeBindingSchema,
        modelCid: receipt.modelCid,
        graphHash: receipt.graphHash,
        shardIndexHash: receipt.shardIndexHash,
        tensorName: receipt.tensorName,
        shardCid: receipt.shardCid,
        dtype: receipt.dtype,
        quantScheme: receipt.quantScheme,
        tensorScale: entry.tensorScale,
        filePath: receipt.filePath,
        fileByteCount: receipt.fileByteCount,
        dataStart: receipt.dataStart,
        dataEnd: receipt.dataEnd,
        byteCount: receipt.byteCount,
        payloadChunkBytes: receipt.chunkBytes,
        rawPayloadByteHash: receipt.rawPayloadByteHash,
        payloadReceiptHash: receipt.receiptHash,
        deviceCapabilityHash: deviceCapabilityHash,
        deviceBufferSizeBytes: deviceBufferSizeBytes,
        deviceBufferDtype: deviceBufferDtype,
        deviceBufferLogicalHash: deviceBufferLogicalHash,
        bindingHash: int64(0)
    )
    out.bindingHash = WeightSafetensorsDeviceRangeBindingHash(out)
    if out.bindingHash <= int64(0):
        return Err[WeightSafetensorsDeviceRangeBinding]("weight safetensors device range: binding hash")
    return Ok[WeightSafetensorsDeviceRangeBinding](out)

fn WeightSafetensorsBuildDeviceRangeBinding(index: WeightSafetensorsShardIndex,
                                            graph: model_graph.ModelGraph,
                                            entryIndex: int32,
                                            chunkBytes: int32,
                                            deviceCapabilityHash: str,
                                            deviceBufferSizeBytes: int64,
                                            deviceBufferDtype: str,
                                            deviceBufferLogicalHash: int64): Result[WeightSafetensorsDeviceRangeBinding] =
    let receipt = WeightSafetensorsBuildTensorRawPayloadHashReceipt(index, graph, entryIndex, chunkBytes)
    if IsErr(receipt):
        return Err[WeightSafetensorsDeviceRangeBinding](Error(receipt))
    return WeightSafetensorsBuildDeviceRangeBindingFromReceipt(
        index,
        graph,
        entryIndex,
        Value(receipt),
        deviceCapabilityHash,
        deviceBufferSizeBytes,
        deviceBufferDtype,
        deviceBufferLogicalHash
    )

fn WeightSafetensorsValidateDeviceRangeBinding(index: WeightSafetensorsShardIndex,
                                               graph: model_graph.ModelGraph,
                                               entryIndex: int32,
                                               binding: WeightSafetensorsDeviceRangeBinding): Result[bool] =
    let expected = WeightSafetensorsBuildDeviceRangeBinding(
        index,
        graph,
        entryIndex,
        binding.payloadChunkBytes,
        binding.deviceCapabilityHash,
        binding.deviceBufferSizeBytes,
        binding.deviceBufferDtype,
        binding.deviceBufferLogicalHash
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if binding.schema != WeightSafetensorsDeviceRangeBindingSchema ||
       binding.modelCid != want.modelCid ||
       binding.graphHash != want.graphHash ||
       binding.shardIndexHash != want.shardIndexHash ||
       binding.tensorName != want.tensorName ||
       binding.shardCid != want.shardCid ||
       binding.dtype != want.dtype ||
       binding.quantScheme != want.quantScheme ||
       binding.tensorScale != want.tensorScale ||
       binding.filePath != want.filePath ||
       binding.fileByteCount != want.fileByteCount ||
       binding.dataStart != want.dataStart ||
       binding.dataEnd != want.dataEnd ||
       binding.byteCount != want.byteCount ||
       binding.payloadChunkBytes != want.payloadChunkBytes ||
       binding.rawPayloadByteHash != want.rawPayloadByteHash ||
       binding.payloadReceiptHash != want.payloadReceiptHash ||
       binding.deviceCapabilityHash != want.deviceCapabilityHash ||
       binding.deviceBufferSizeBytes != want.deviceBufferSizeBytes ||
       binding.deviceBufferDtype != want.deviceBufferDtype ||
       binding.deviceBufferLogicalHash != want.deviceBufferLogicalHash ||
       binding.bindingHash != want.bindingHash:
        return Err[bool]("weight safetensors device range: mismatch")
    if WeightSafetensorsDeviceRangeBindingHash(binding) != binding.bindingHash:
        return Err[bool]("weight safetensors device range: hash")
    return Ok[bool](true)

fn WeightSafetensorsBuildDeviceRangeBindingSetFromPayloadPreflight(index: WeightSafetensorsShardIndex,
                                                                   graph: model_graph.ModelGraph,
                                                                   preflight: WeightSafetensorsPayloadHashPreflight,
                                                                   deviceCapabilityHash: str): Result[WeightSafetensorsDeviceRangeBindingSet] =
    let preflightOk = WeightSafetensorsValidatePayloadHashPreflight(index, graph, preflight)
    if IsErr(preflightOk):
        return Err[WeightSafetensorsDeviceRangeBindingSet](Error(preflightOk))
    if deviceCapabilityHash == "":
        return Err[WeightSafetensorsDeviceRangeBindingSet]("weight safetensors device range set: capability")
    if preflight.tensorReceipts.len != index.entries.len:
        return Err[WeightSafetensorsDeviceRangeBindingSet]("weight safetensors device range set: tensor count")
    var bindings: WeightSafetensorsDeviceRangeBinding[]
    var totalBytes: int64
    for i in 0..<preflight.tensorReceipts.len:
        let receipt = preflight.tensorReceipts[i]
        let binding = WeightSafetensorsBuildDeviceRangeBindingFromReceipt(
            index,
            graph,
            i,
            receipt,
            deviceCapabilityHash,
            receipt.byteCount,
            receipt.dtype,
            receipt.rawPayloadByteHash
        )
        if IsErr(binding):
            return Err[WeightSafetensorsDeviceRangeBindingSet](Error(binding))
        totalBytes = totalBytes + Value(binding).byteCount
        add(bindings, Value(binding))
    if bindings.len <= 0 || bindings.len != graph.weights.len:
        return Err[WeightSafetensorsDeviceRangeBindingSet]("weight safetensors device range set: binding count")
    if totalBytes != preflight.totalPayloadBytes:
        return Err[WeightSafetensorsDeviceRangeBindingSet]("weight safetensors device range set: total bytes")
    var out = WeightSafetensorsDeviceRangeBindingSet(
        schema: WeightSafetensorsDeviceRangeBindingSetSchema,
        modelCid: preflight.modelCid,
        graphHash: preflight.graphHash,
        shardIndexHash: preflight.shardIndexHash,
        deviceCapabilityHash: deviceCapabilityHash,
        payloadPreflightHash: preflight.receiptHash,
        payloadChunkBytes: preflight.chunkBytes,
        bindings: bindings,
        tensorCount: bindings.len,
        totalBytes: totalBytes,
        bindingSetHash: int64(0)
    )
    out.bindingSetHash = WeightSafetensorsDeviceRangeBindingSetHash(out)
    if out.bindingSetHash <= int64(0):
        return Err[WeightSafetensorsDeviceRangeBindingSet]("weight safetensors device range set: hash")
    return Ok[WeightSafetensorsDeviceRangeBindingSet](out)

fn WeightSafetensorsBuildDeviceRangeBindingSet(index: WeightSafetensorsShardIndex,
                                               graph: model_graph.ModelGraph,
                                               chunkBytes: int32,
                                               deviceCapabilityHash: str): Result[WeightSafetensorsDeviceRangeBindingSet] =
    let preflight = WeightSafetensorsBuildPayloadHashPreflight(index, graph, chunkBytes)
    if IsErr(preflight):
        return Err[WeightSafetensorsDeviceRangeBindingSet](Error(preflight))
    return WeightSafetensorsBuildDeviceRangeBindingSetFromPayloadPreflight(
        index,
        graph,
        Value(preflight),
        deviceCapabilityHash
    )

fn WeightSafetensorsValidateDeviceRangeBindingSet(index: WeightSafetensorsShardIndex,
                                                  graph: model_graph.ModelGraph,
                                                  set: WeightSafetensorsDeviceRangeBindingSet): Result[bool] =
    let expected = WeightSafetensorsBuildDeviceRangeBindingSet(
        index,
        graph,
        set.payloadChunkBytes,
        set.deviceCapabilityHash
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if set.schema != WeightSafetensorsDeviceRangeBindingSetSchema ||
       set.modelCid != want.modelCid ||
       set.graphHash != want.graphHash ||
       set.shardIndexHash != want.shardIndexHash ||
       set.deviceCapabilityHash != want.deviceCapabilityHash ||
       set.payloadPreflightHash != want.payloadPreflightHash ||
       set.payloadChunkBytes != want.payloadChunkBytes ||
       set.bindings.len != want.bindings.len ||
       set.tensorCount != want.tensorCount ||
       set.totalBytes != want.totalBytes ||
       set.bindingSetHash != want.bindingSetHash:
        return Err[bool]("weight safetensors device range set: mismatch")
    for i in 0..<set.bindings.len:
        if set.bindings[i].bindingHash != want.bindings[i].bindingHash:
            return Err[bool]("weight safetensors device range set: binding")
    if WeightSafetensorsDeviceRangeBindingSetHash(set) != set.bindingSetHash:
        return Err[bool]("weight safetensors device range set: hash")
    return Ok[bool](true)

fn WeightSafetensorsBuildDeviceFromPageTable(pageTable: device.DeviceFileRangePageTableReceipt): Result[device.Device] =
    if pageTable.deviceBackend == "" ||
       pageTable.deviceName == "" ||
       pageTable.deviceCapabilityHash == "" ||
       pageTable.deviceCapabilityMask <= 0:
        return Err[device.Device]("weight safetensors device page: page table device")
    return Ok[device.Device](device.Device(
        backend: pageTable.deviceBackend,
        name: pageTable.deviceName,
        capabilityHash: pageTable.deviceCapabilityHash,
        capabilityMask: pageTable.deviceCapabilityMask,
        ready: true
    ))

fn WeightSafetensorsBuildDevicePageBindingFromReceipt(index: WeightSafetensorsShardIndex,
                                                      graph: model_graph.ModelGraph,
                                                      entryIndex: int32,
                                                      receipt: WeightSafetensorsTensorRawPayloadHashReceipt,
                                                      pageTable: device.DeviceFileRangePageTableReceipt,
                                                      deviceCapabilityHash: str,
                                                      deviceBufferDtype: str): Result[WeightSafetensorsDevicePageBinding] =
    let receiptOk = WeightSafetensorsValidateTensorRawPayloadHashReceipt(index, graph, entryIndex, receipt)
    if IsErr(receiptOk):
        return Err[WeightSafetensorsDevicePageBinding](Error(receiptOk))
    if entryIndex < 0 || entryIndex >= index.entries.len:
        return Err[WeightSafetensorsDevicePageBinding]("weight safetensors device page: entry")
    let entry = index.entries[entryIndex]
    if entry.tensorScale <= 0:
        return Err[WeightSafetensorsDevicePageBinding]("weight safetensors device page: tensor scale")
    if deviceCapabilityHash == "" || pageTable.deviceCapabilityHash != deviceCapabilityHash:
        return Err[WeightSafetensorsDevicePageBinding]("weight safetensors device page: capability")
    if deviceBufferDtype != receipt.dtype:
        return Err[WeightSafetensorsDevicePageBinding]("weight safetensors device page: dtype")
    let pageDevice = WeightSafetensorsBuildDeviceFromPageTable(pageTable)
    if IsErr(pageDevice):
        return Err[WeightSafetensorsDevicePageBinding](Error(pageDevice))
    let pageOk = device.DeviceValidateFileRangePageTableReceipt(Value(pageDevice), pageTable)
    if IsErr(pageOk):
        return Err[WeightSafetensorsDevicePageBinding](Error(pageOk))
    if pageTable.filePath != receipt.filePath ||
       pageTable.fileByteCount != receipt.fileByteCount ||
       pageTable.offsetBytes != receipt.dataStart ||
       pageTable.byteCount != receipt.byteCount ||
       pageTable.chunkBytes != receipt.chunkBytes:
        return Err[WeightSafetensorsDevicePageBinding]("weight safetensors device page: page table range")
    if pageTable.pageBytes <= int64(0) ||
       pageTable.pageCount <= 0 ||
       pageTable.pages.len != int(pageTable.pageCount) ||
       pageTable.pageAggregateHash <= int64(0) ||
       pageTable.receiptHash <= int64(0):
        return Err[WeightSafetensorsDevicePageBinding]("weight safetensors device page: page table")
    var out = WeightSafetensorsDevicePageBinding(
        schema: WeightSafetensorsDevicePageBindingSchema,
        modelCid: receipt.modelCid,
        graphHash: receipt.graphHash,
        shardIndexHash: receipt.shardIndexHash,
        tensorName: receipt.tensorName,
        shardCid: receipt.shardCid,
        dtype: receipt.dtype,
        quantScheme: receipt.quantScheme,
        tensorScale: entry.tensorScale,
        filePath: receipt.filePath,
        fileByteCount: receipt.fileByteCount,
        dataStart: receipt.dataStart,
        dataEnd: receipt.dataEnd,
        byteCount: receipt.byteCount,
        payloadChunkBytes: receipt.chunkBytes,
        rawPayloadByteHash: receipt.rawPayloadByteHash,
        payloadReceiptHash: receipt.receiptHash,
        deviceCapabilityHash: deviceCapabilityHash,
        deviceBufferDtype: deviceBufferDtype,
        pageBytes: pageTable.pageBytes,
        pageCount: pageTable.pageCount,
        pageAggregateHash: pageTable.pageAggregateHash,
        pageTableReceiptHash: pageTable.receiptHash,
        bindingHash: int64(0)
    )
    out.bindingHash = WeightSafetensorsDevicePageBindingHash(out)
    if out.bindingHash <= int64(0):
        return Err[WeightSafetensorsDevicePageBinding]("weight safetensors device page: binding hash")
    return Ok[WeightSafetensorsDevicePageBinding](out)

fn WeightSafetensorsBuildDevicePageBinding(index: WeightSafetensorsShardIndex,
                                           graph: model_graph.ModelGraph,
                                           entryIndex: int32,
                                           chunkBytes: int32,
                                           pageTable: device.DeviceFileRangePageTableReceipt,
                                           deviceCapabilityHash: str,
                                           deviceBufferDtype: str): Result[WeightSafetensorsDevicePageBinding] =
    let receipt = WeightSafetensorsBuildTensorRawPayloadHashReceipt(index, graph, entryIndex, chunkBytes)
    if IsErr(receipt):
        return Err[WeightSafetensorsDevicePageBinding](Error(receipt))
    return WeightSafetensorsBuildDevicePageBindingFromReceipt(
        index,
        graph,
        entryIndex,
        Value(receipt),
        pageTable,
        deviceCapabilityHash,
        deviceBufferDtype
    )

fn WeightSafetensorsValidateDevicePageBinding(index: WeightSafetensorsShardIndex,
                                              graph: model_graph.ModelGraph,
                                              entryIndex: int32,
                                              pageTable: device.DeviceFileRangePageTableReceipt,
                                              binding: WeightSafetensorsDevicePageBinding): Result[bool] =
    let expected = WeightSafetensorsBuildDevicePageBinding(
        index,
        graph,
        entryIndex,
        binding.payloadChunkBytes,
        pageTable,
        binding.deviceCapabilityHash,
        binding.deviceBufferDtype
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if binding.schema != WeightSafetensorsDevicePageBindingSchema ||
       binding.modelCid != want.modelCid ||
       binding.graphHash != want.graphHash ||
       binding.shardIndexHash != want.shardIndexHash ||
       binding.tensorName != want.tensorName ||
       binding.shardCid != want.shardCid ||
       binding.dtype != want.dtype ||
       binding.quantScheme != want.quantScheme ||
       binding.tensorScale != want.tensorScale ||
       binding.filePath != want.filePath ||
       binding.fileByteCount != want.fileByteCount ||
       binding.dataStart != want.dataStart ||
       binding.dataEnd != want.dataEnd ||
       binding.byteCount != want.byteCount ||
       binding.payloadChunkBytes != want.payloadChunkBytes ||
       binding.rawPayloadByteHash != want.rawPayloadByteHash ||
       binding.payloadReceiptHash != want.payloadReceiptHash ||
       binding.deviceCapabilityHash != want.deviceCapabilityHash ||
       binding.deviceBufferDtype != want.deviceBufferDtype ||
       binding.pageBytes != want.pageBytes ||
       binding.pageCount != want.pageCount ||
       binding.pageAggregateHash != want.pageAggregateHash ||
       binding.pageTableReceiptHash != want.pageTableReceiptHash ||
       binding.bindingHash != want.bindingHash:
        return Err[bool]("weight safetensors device page: mismatch")
    if WeightSafetensorsDevicePageBindingHash(binding) != binding.bindingHash:
        return Err[bool]("weight safetensors device page: hash")
    return Ok[bool](true)

fn WeightSafetensorsBuildDevicePageBindingSetFromPayloadPreflight(index: WeightSafetensorsShardIndex,
                                                                  graph: model_graph.ModelGraph,
                                                                  preflight: WeightSafetensorsPayloadHashPreflight,
                                                                  pageTables: device.DeviceFileRangePageTableReceipt[],
                                                                  deviceCapabilityHash: str): Result[WeightSafetensorsDevicePageBindingSet] =
    let preflightOk = WeightSafetensorsValidatePayloadHashPreflight(index, graph, preflight)
    if IsErr(preflightOk):
        return Err[WeightSafetensorsDevicePageBindingSet](Error(preflightOk))
    if deviceCapabilityHash == "":
        return Err[WeightSafetensorsDevicePageBindingSet]("weight safetensors device page set: capability")
    if preflight.tensorReceipts.len != index.entries.len || pageTables.len != preflight.tensorReceipts.len:
        return Err[WeightSafetensorsDevicePageBindingSet]("weight safetensors device page set: tensor count")
    var bindings: WeightSafetensorsDevicePageBinding[]
    var totalBytes: int64
    for i in 0..<preflight.tensorReceipts.len:
        let receipt = preflight.tensorReceipts[i]
        let binding = WeightSafetensorsBuildDevicePageBindingFromReceipt(
            index,
            graph,
            i,
            receipt,
            pageTables[i],
            deviceCapabilityHash,
            receipt.dtype
        )
        if IsErr(binding):
            return Err[WeightSafetensorsDevicePageBindingSet](Error(binding))
        totalBytes = totalBytes + Value(binding).byteCount
        add(bindings, Value(binding))
    if bindings.len <= 0 || bindings.len != graph.weights.len:
        return Err[WeightSafetensorsDevicePageBindingSet]("weight safetensors device page set: binding count")
    if totalBytes != preflight.totalPayloadBytes:
        return Err[WeightSafetensorsDevicePageBindingSet]("weight safetensors device page set: total bytes")
    var out = WeightSafetensorsDevicePageBindingSet(
        schema: WeightSafetensorsDevicePageBindingSetSchema,
        modelCid: preflight.modelCid,
        graphHash: preflight.graphHash,
        shardIndexHash: preflight.shardIndexHash,
        deviceCapabilityHash: deviceCapabilityHash,
        payloadPreflightHash: preflight.receiptHash,
        payloadChunkBytes: preflight.chunkBytes,
        bindings: bindings,
        tensorCount: bindings.len,
        totalBytes: totalBytes,
        bindingSetHash: int64(0)
    )
    out.bindingSetHash = WeightSafetensorsDevicePageBindingSetHash(out)
    if out.bindingSetHash <= int64(0):
        return Err[WeightSafetensorsDevicePageBindingSet]("weight safetensors device page set: hash")
    return Ok[WeightSafetensorsDevicePageBindingSet](out)

fn WeightSafetensorsBuildDevicePageBindingSet(index: WeightSafetensorsShardIndex,
                                              graph: model_graph.ModelGraph,
                                              chunkBytes: int32,
                                              pageTables: device.DeviceFileRangePageTableReceipt[],
                                              deviceCapabilityHash: str): Result[WeightSafetensorsDevicePageBindingSet] =
    let preflight = WeightSafetensorsBuildPayloadHashPreflight(index, graph, chunkBytes)
    if IsErr(preflight):
        return Err[WeightSafetensorsDevicePageBindingSet](Error(preflight))
    return WeightSafetensorsBuildDevicePageBindingSetFromPayloadPreflight(
        index,
        graph,
        Value(preflight),
        pageTables,
        deviceCapabilityHash
    )

fn WeightSafetensorsBuildDevicePageTablesFromPayloadPreflight(index: WeightSafetensorsShardIndex,
                                                              graph: model_graph.ModelGraph,
                                                              preflight: WeightSafetensorsPayloadHashPreflight,
                                                              targetDevice: device.Device,
                                                              pageBytes: int64): Result[device.DeviceFileRangePageTableReceipt[]] =
    let preflightOk = WeightSafetensorsValidatePayloadHashPreflight(index, graph, preflight)
    if IsErr(preflightOk):
        return Err[device.DeviceFileRangePageTableReceipt[]](Error(preflightOk))
    if targetDevice.backend == "" ||
       targetDevice.name == "" ||
       targetDevice.capabilityHash == "" ||
       targetDevice.capabilityMask <= 0 ||
       !targetDevice.ready:
        return Err[device.DeviceFileRangePageTableReceipt[]]("weight safetensors device page table set: ready device")
    if pageBytes <= int64(0):
        return Err[device.DeviceFileRangePageTableReceipt[]]("weight safetensors device page table set: page bytes")
    if preflight.tensorReceipts.len != index.entries.len ||
       preflight.tensorReceipts.len != graph.weights.len:
        return Err[device.DeviceFileRangePageTableReceipt[]]("weight safetensors device page table set: tensor count")
    var pageTables: device.DeviceFileRangePageTableReceipt[]
    for i in 0..<preflight.tensorReceipts.len:
        let receipt = preflight.tensorReceipts[i]
        let pageTable = device.DeviceBuildFileRangePageTableReceipt(
            targetDevice,
            receipt.filePath,
            receipt.dataStart,
            receipt.byteCount,
            pageBytes,
            receipt.chunkBytes
        )
        if IsErr(pageTable):
            return Err[device.DeviceFileRangePageTableReceipt[]](Error(pageTable))
        if Value(pageTable).filePath != receipt.filePath ||
           Value(pageTable).fileByteCount != receipt.fileByteCount ||
           Value(pageTable).offsetBytes != receipt.dataStart ||
           Value(pageTable).byteCount != receipt.byteCount ||
           Value(pageTable).chunkBytes != receipt.chunkBytes ||
           Value(pageTable).deviceCapabilityHash != targetDevice.capabilityHash ||
           Value(pageTable).pageBytes != pageBytes ||
           Value(pageTable).pageCount <= 0 ||
           Value(pageTable).pageAggregateHash <= int64(0) ||
           Value(pageTable).receiptHash <= int64(0):
            return Err[device.DeviceFileRangePageTableReceipt[]]("weight safetensors device page table set: receipt")
        let pageOk = device.DeviceValidateFileRangePageTableReceipt(targetDevice, Value(pageTable))
        if IsErr(pageOk):
            return Err[device.DeviceFileRangePageTableReceipt[]](Error(pageOk))
        add(pageTables, Value(pageTable))
    if pageTables.len <= 0 || pageTables.len != graph.weights.len:
        return Err[device.DeviceFileRangePageTableReceipt[]]("weight safetensors device page table set: output count")
    return Ok[device.DeviceFileRangePageTableReceipt[]](pageTables)

fn WeightSafetensorsBuildDevicePageBindingSetFromPayloadPreflightForDevice(index: WeightSafetensorsShardIndex,
                                                                           graph: model_graph.ModelGraph,
                                                                           preflight: WeightSafetensorsPayloadHashPreflight,
                                                                           targetDevice: device.Device,
                                                                           pageBytes: int64): Result[WeightSafetensorsDevicePageBindingSet] =
    let pageTables = WeightSafetensorsBuildDevicePageTablesFromPayloadPreflight(
        index,
        graph,
        preflight,
        targetDevice,
        pageBytes
    )
    if IsErr(pageTables):
        return Err[WeightSafetensorsDevicePageBindingSet](Error(pageTables))
    return WeightSafetensorsBuildDevicePageBindingSetFromPayloadPreflight(
        index,
        graph,
        preflight,
        Value(pageTables),
        targetDevice.capabilityHash
    )

fn WeightSafetensorsBuildDevicePageBindingSetForDevice(index: WeightSafetensorsShardIndex,
                                                       graph: model_graph.ModelGraph,
                                                       chunkBytes: int32,
                                                       targetDevice: device.Device,
                                                       pageBytes: int64): Result[WeightSafetensorsDevicePageBindingSet] =
    let preflight = WeightSafetensorsBuildPayloadHashPreflight(index, graph, chunkBytes)
    if IsErr(preflight):
        return Err[WeightSafetensorsDevicePageBindingSet](Error(preflight))
    return WeightSafetensorsBuildDevicePageBindingSetFromPayloadPreflightForDevice(
        index,
        graph,
        Value(preflight),
        targetDevice,
        pageBytes
    )

fn WeightSafetensorsValidateDevicePageBindingSet(index: WeightSafetensorsShardIndex,
                                                 graph: model_graph.ModelGraph,
                                                 pageTables: device.DeviceFileRangePageTableReceipt[],
                                                 set: WeightSafetensorsDevicePageBindingSet): Result[bool] =
    let expected = WeightSafetensorsBuildDevicePageBindingSet(
        index,
        graph,
        set.payloadChunkBytes,
        pageTables,
        set.deviceCapabilityHash
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if set.schema != WeightSafetensorsDevicePageBindingSetSchema ||
       set.modelCid != want.modelCid ||
       set.graphHash != want.graphHash ||
       set.shardIndexHash != want.shardIndexHash ||
       set.deviceCapabilityHash != want.deviceCapabilityHash ||
       set.payloadPreflightHash != want.payloadPreflightHash ||
       set.payloadChunkBytes != want.payloadChunkBytes ||
       set.bindings.len != want.bindings.len ||
       set.tensorCount != want.tensorCount ||
       set.totalBytes != want.totalBytes ||
       set.bindingSetHash != want.bindingSetHash:
        return Err[bool]("weight safetensors device page set: mismatch")
    for i in 0..<set.bindings.len:
        if set.bindings[i].bindingHash != want.bindings[i].bindingHash:
            return Err[bool]("weight safetensors device page set: binding")
    if WeightSafetensorsDevicePageBindingSetHash(set) != set.bindingSetHash:
        return Err[bool]("weight safetensors device page set: hash")
    return Ok[bool](true)

fn WeightSafetensorsBuildDevicePageLoadReceiptFromBuffer(index: WeightSafetensorsShardIndex,
                                                         graph: model_graph.ModelGraph,
                                                         targetDevice: device.Device,
                                                         pageTables: device.DeviceFileRangePageTableReceipt[],
                                                         set: WeightSafetensorsDevicePageBindingSet,
                                                         entryIndex: int32,
                                                         pageIndex: int32,
                                                         loaded: device.DeviceFileRangeBufferLoadResult): Result[WeightSafetensorsDevicePageLoadResult] =
    if targetDevice.backend == "" ||
       targetDevice.name == "" ||
       targetDevice.capabilityHash == "" ||
       targetDevice.capabilityMask <= 0 ||
       !targetDevice.ready:
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load: ready device")
    if targetDevice.capabilityHash != set.deviceCapabilityHash:
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load: capability")
    if entryIndex < 0 ||
       entryIndex >= index.entries.len ||
       entryIndex >= graph.weights.len ||
       entryIndex >= pageTables.len ||
       entryIndex >= set.bindings.len:
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load: entry")
    let setOk = WeightSafetensorsValidateDevicePageBindingSet(index, graph, pageTables, set)
    if IsErr(setOk):
        return Err[WeightSafetensorsDevicePageLoadResult](Error(setOk))
    let binding = set.bindings[int(entryIndex)]
    let pageTable = pageTables[int(entryIndex)]
    let bindingOk = WeightSafetensorsValidateDevicePageBinding(
        index,
        graph,
        entryIndex,
        pageTable,
        binding
    )
    if IsErr(bindingOk):
        return Err[WeightSafetensorsDevicePageLoadResult](Error(bindingOk))
    let tableOk = device.DeviceValidateFileRangePageTableReceipt(targetDevice, pageTable)
    if IsErr(tableOk):
        return Err[WeightSafetensorsDevicePageLoadResult](Error(tableOk))
    if pageIndex < 0 || pageIndex >= pageTable.pageCount || int(pageIndex) >= pageTable.pages.len:
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load: page")
    let pageOk = device.DeviceValidateFileRangePageInTableReceipt(targetDevice, pageTable, pageIndex)
    if IsErr(pageOk):
        return Err[WeightSafetensorsDevicePageLoadResult](Error(pageOk))
    let loadOk = device.DeviceValidateFileRangeBufferLoadReceipt(targetDevice, loaded.buffer, loaded.receipt)
    if IsErr(loadOk):
        return Err[WeightSafetensorsDevicePageLoadResult](Error(loadOk))
    let page = pageTable.pages[int(pageIndex)]
    if pageTable.receiptHash != binding.pageTableReceiptHash ||
       pageTable.pageAggregateHash != binding.pageAggregateHash ||
       pageTable.filePath != binding.filePath ||
       pageTable.fileByteCount != binding.fileByteCount ||
       pageTable.offsetBytes != binding.dataStart ||
       pageTable.byteCount != binding.byteCount ||
       pageTable.chunkBytes != binding.payloadChunkBytes:
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load: page table")
    if loaded.buffer.deviceCapabilityHash != targetDevice.capabilityHash ||
       loaded.buffer.sizeBytes != page.byteCount ||
       loaded.buffer.dtype != binding.deviceBufferDtype ||
       loaded.buffer.logicalHash != page.sourceRangeHash:
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load: buffer")
    if loaded.receipt.deviceCapabilityHash != targetDevice.capabilityHash ||
       loaded.receipt.filePath != pageTable.filePath ||
       loaded.receipt.fileByteCount != pageTable.fileByteCount ||
       loaded.receipt.offsetBytes != page.offsetBytes ||
       loaded.receipt.byteCount != page.byteCount ||
       loaded.receipt.chunkBytes != page.chunkBytes ||
       loaded.receipt.sourceRangeHash != page.sourceRangeHash ||
       loaded.receipt.deviceBufferDtype != binding.deviceBufferDtype ||
       loaded.receipt.deviceBufferSizeBytes != page.byteCount ||
       loaded.receipt.deviceBufferLogicalHash != page.sourceRangeHash ||
       loaded.receipt.deviceBufferHandle != loaded.buffer.handle ||
       loaded.receipt.receiptHash != device.DeviceFileRangeBufferLoadReceiptHash(loaded.receipt):
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load: load receipt")
    var receipt = WeightSafetensorsDevicePageLoadReceipt(
        schema: WeightSafetensorsDevicePageLoadReceiptSchema,
        modelCid: binding.modelCid,
        graphHash: binding.graphHash,
        shardIndexHash: binding.shardIndexHash,
        tensorName: binding.tensorName,
        shardCid: binding.shardCid,
        dtype: binding.dtype,
        quantScheme: binding.quantScheme,
        tensorScale: binding.tensorScale,
        filePath: binding.filePath,
        fileByteCount: binding.fileByteCount,
        dataStart: binding.dataStart,
        dataEnd: binding.dataEnd,
        byteCount: binding.byteCount,
        deviceCapabilityHash: binding.deviceCapabilityHash,
        bindingSetHash: set.bindingSetHash,
        bindingHash: binding.bindingHash,
        pageTableReceiptHash: pageTable.receiptHash,
        pageAggregateHash: pageTable.pageAggregateHash,
        pageIndex: pageIndex,
        pageOffsetBytes: page.offsetBytes,
        pageByteCount: page.byteCount,
        pageSourceRangeHash: page.sourceRangeHash,
        bufferLoadStatus: loaded.receipt.status,
        deviceBufferHandle: loaded.buffer.handle,
        deviceBufferSizeBytes: loaded.buffer.sizeBytes,
        deviceBufferDtype: loaded.buffer.dtype,
        deviceBufferLogicalHash: loaded.buffer.logicalHash,
        bufferLoadReceiptHash: loaded.receipt.receiptHash,
        receiptHash: int64(0)
    )
    receipt.receiptHash = WeightSafetensorsDevicePageLoadReceiptHash(receipt)
    if receipt.receiptHash <= int64(0):
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load: receipt hash")
    return Ok[WeightSafetensorsDevicePageLoadResult](WeightSafetensorsDevicePageLoadResult(
        buffer: loaded.buffer,
        bufferReceipt: loaded.receipt,
        receipt: receipt
    ))

fn WeightSafetensorsValidateDevicePageLoadReceipt(index: WeightSafetensorsShardIndex,
                                                  graph: model_graph.ModelGraph,
                                                  targetDevice: device.Device,
                                                  pageTables: device.DeviceFileRangePageTableReceipt[],
                                                  set: WeightSafetensorsDevicePageBindingSet,
                                                  entryIndex: int32,
                                                  pageIndex: int32,
                                                  loaded: device.DeviceFileRangeBufferLoadResult,
                                                  receipt: WeightSafetensorsDevicePageLoadReceipt): Result[bool] =
    let expected = WeightSafetensorsBuildDevicePageLoadReceiptFromBuffer(
        index,
        graph,
        targetDevice,
        pageTables,
        set,
        entryIndex,
        pageIndex,
        loaded
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected).receipt
    if receipt.schema != WeightSafetensorsDevicePageLoadReceiptSchema ||
       receipt.modelCid != want.modelCid ||
       receipt.graphHash != want.graphHash ||
       receipt.shardIndexHash != want.shardIndexHash ||
       receipt.tensorName != want.tensorName ||
       receipt.shardCid != want.shardCid ||
       receipt.dtype != want.dtype ||
       receipt.quantScheme != want.quantScheme ||
       receipt.tensorScale != want.tensorScale ||
       receipt.filePath != want.filePath ||
       receipt.fileByteCount != want.fileByteCount ||
       receipt.dataStart != want.dataStart ||
       receipt.dataEnd != want.dataEnd ||
       receipt.byteCount != want.byteCount ||
       receipt.deviceCapabilityHash != want.deviceCapabilityHash ||
       receipt.bindingSetHash != want.bindingSetHash ||
       receipt.bindingHash != want.bindingHash ||
       receipt.pageTableReceiptHash != want.pageTableReceiptHash ||
       receipt.pageAggregateHash != want.pageAggregateHash ||
       receipt.pageIndex != want.pageIndex ||
       receipt.pageOffsetBytes != want.pageOffsetBytes ||
       receipt.pageByteCount != want.pageByteCount ||
       receipt.pageSourceRangeHash != want.pageSourceRangeHash ||
       receipt.bufferLoadStatus != want.bufferLoadStatus ||
       receipt.deviceBufferHandle != want.deviceBufferHandle ||
       receipt.deviceBufferSizeBytes != want.deviceBufferSizeBytes ||
       receipt.deviceBufferDtype != want.deviceBufferDtype ||
       receipt.deviceBufferLogicalHash != want.deviceBufferLogicalHash ||
       receipt.bufferLoadReceiptHash != want.bufferLoadReceiptHash ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("weight safetensors device page load: receipt mismatch")
    if WeightSafetensorsDevicePageLoadReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("weight safetensors device page load: receipt hash")
    return Ok[bool](true)

fn WeightSafetensorsLoadDevicePageFromBindingSet(index: WeightSafetensorsShardIndex,
                                                 graph: model_graph.ModelGraph,
                                                 targetDevice: device.Device,
                                                 pageTables: device.DeviceFileRangePageTableReceipt[],
                                                 set: WeightSafetensorsDevicePageBindingSet,
                                                 entryIndex: int32,
                                                 pageIndex: int32): Result[WeightSafetensorsDevicePageLoadResult] =
    if entryIndex < 0 ||
       entryIndex >= index.entries.len ||
       entryIndex >= graph.weights.len ||
       entryIndex >= pageTables.len ||
       entryIndex >= set.bindings.len:
        return Err[WeightSafetensorsDevicePageLoadResult]("weight safetensors device page load metal: entry")
    let setOk = WeightSafetensorsValidateDevicePageBindingSet(index, graph, pageTables, set)
    if IsErr(setOk):
        return Err[WeightSafetensorsDevicePageLoadResult](Error(setOk))
    let binding = set.bindings[int(entryIndex)]
    let loaded = device.DeviceMetalLoadFileRangePageBuffer(
        targetDevice,
        pageTables[int(entryIndex)],
        pageIndex,
        binding.deviceBufferDtype
    )
    if IsErr(loaded):
        return Err[WeightSafetensorsDevicePageLoadResult](Error(loaded))
    let out = WeightSafetensorsBuildDevicePageLoadReceiptFromBuffer(
        index,
        graph,
        targetDevice,
        pageTables,
        set,
        entryIndex,
        pageIndex,
        Value(loaded)
    )
    if IsErr(out):
        let _releaseAfterPageLoadReceiptFailure = device.DeviceMetalReleaseBuffer(Value(loaded).buffer)
        return Err[WeightSafetensorsDevicePageLoadResult](Error(out))
    return out

fn WeightSafetensorsBuildDevicePageLoadSetReceipt(index: WeightSafetensorsShardIndex,
                                                  graph: model_graph.ModelGraph,
                                                  targetDevice: device.Device,
                                                  pageTables: device.DeviceFileRangePageTableReceipt[],
                                                  set: WeightSafetensorsDevicePageBindingSet,
                                                  entryIndex: int32,
                                                  pageLoads: WeightSafetensorsDevicePageLoadResult[]): Result[WeightSafetensorsDevicePageLoadSetReceipt] =
    if entryIndex < 0 ||
       entryIndex >= index.entries.len ||
       entryIndex >= graph.weights.len ||
       entryIndex >= pageTables.len ||
       entryIndex >= set.bindings.len:
        return Err[WeightSafetensorsDevicePageLoadSetReceipt]("weight safetensors device page load set: entry")
    let setOk = WeightSafetensorsValidateDevicePageBindingSet(index, graph, pageTables, set)
    if IsErr(setOk):
        return Err[WeightSafetensorsDevicePageLoadSetReceipt](Error(setOk))
    let binding = set.bindings[int(entryIndex)]
    let pageTable = pageTables[int(entryIndex)]
    let tableOk = device.DeviceValidateFileRangePageTableReceipt(targetDevice, pageTable)
    if IsErr(tableOk):
        return Err[WeightSafetensorsDevicePageLoadSetReceipt](Error(tableOk))
    if pageLoads.len <= 0 ||
       pageTable.pageCount <= 0 ||
       pageLoads.len != int(pageTable.pageCount) ||
       pageLoads.len != pageTable.pages.len:
        return Err[WeightSafetensorsDevicePageLoadSetReceipt]("weight safetensors device page load set: page count")
    if pageTable.receiptHash != binding.pageTableReceiptHash ||
       pageTable.pageAggregateHash != binding.pageAggregateHash ||
       pageTable.pageBytes != binding.pageBytes ||
       pageTable.byteCount != binding.byteCount:
        return Err[WeightSafetensorsDevicePageLoadSetReceipt]("weight safetensors device page load set: page table")
    var totalBytes: int64
    var pageLoadStatus = pageLoads[0].receipt.bufferLoadStatus
    for i in 0..<pageLoads.len:
        let loaded = pageLoads[i]
        let loadOk = WeightSafetensorsValidateDevicePageLoadReceipt(
            index,
            graph,
            targetDevice,
            pageTables,
            set,
            entryIndex,
            int32(i),
            loaded,
            loaded.receipt
        )
        if IsErr(loadOk):
            return Err[WeightSafetensorsDevicePageLoadSetReceipt](Error(loadOk))
        if loaded.receipt.pageIndex != int32(i) ||
           loaded.receipt.bindingHash != binding.bindingHash ||
           loaded.receipt.bindingSetHash != set.bindingSetHash ||
           loaded.receipt.pageTableReceiptHash != pageTable.receiptHash ||
           loaded.receipt.pageAggregateHash != pageTable.pageAggregateHash ||
           loaded.receipt.bufferLoadStatus != pageLoadStatus ||
           loaded.receipt.pageOffsetBytes != pageTable.pages[i].offsetBytes ||
           loaded.receipt.pageByteCount != pageTable.pages[i].byteCount ||
           loaded.receipt.pageSourceRangeHash != pageTable.pages[i].sourceRangeHash:
            return Err[WeightSafetensorsDevicePageLoadSetReceipt]("weight safetensors device page load set: load")
        totalBytes = totalBytes + loaded.receipt.pageByteCount
    if totalBytes != binding.byteCount:
        return Err[WeightSafetensorsDevicePageLoadSetReceipt]("weight safetensors device page load set: total bytes")
    let pageLoadReceiptHash = WeightSafetensorsDevicePageLoadResultSetHash(pageLoads)
    if pageLoadReceiptHash <= int64(0):
        return Err[WeightSafetensorsDevicePageLoadSetReceipt]("weight safetensors device page load set: receipt set hash")
    let firstPage = pageTable.pages[0]
    let lastPage = pageTable.pages[pageTable.pages.len - 1]
    var receipt = WeightSafetensorsDevicePageLoadSetReceipt(
        schema: WeightSafetensorsDevicePageLoadSetReceiptSchema,
        modelCid: binding.modelCid,
        graphHash: binding.graphHash,
        shardIndexHash: binding.shardIndexHash,
        tensorName: binding.tensorName,
        shardCid: binding.shardCid,
        dtype: binding.dtype,
        quantScheme: binding.quantScheme,
        tensorScale: binding.tensorScale,
        filePath: binding.filePath,
        fileByteCount: binding.fileByteCount,
        dataStart: binding.dataStart,
        dataEnd: binding.dataEnd,
        byteCount: binding.byteCount,
        rawPayloadByteHash: binding.rawPayloadByteHash,
        payloadReceiptHash: binding.payloadReceiptHash,
        deviceCapabilityHash: binding.deviceCapabilityHash,
        bindingSetHash: set.bindingSetHash,
        bindingHash: binding.bindingHash,
        pageTableReceiptHash: pageTable.receiptHash,
        pageAggregateHash: pageTable.pageAggregateHash,
        pageBytes: pageTable.pageBytes,
        pageCount: pageTable.pageCount,
        pageLoadStatus: pageLoadStatus,
        firstPageOffsetBytes: firstPage.offsetBytes,
        finalPageEndBytes: lastPage.offsetBytes + lastPage.byteCount,
        pageLoadReceiptHash: pageLoadReceiptHash,
        receiptHash: int64(0)
    )
    receipt.receiptHash = WeightSafetensorsDevicePageLoadSetReceiptHash(receipt)
    if receipt.receiptHash <= int64(0):
        return Err[WeightSafetensorsDevicePageLoadSetReceipt]("weight safetensors device page load set: receipt hash")
    return Ok[WeightSafetensorsDevicePageLoadSetReceipt](receipt)

fn WeightSafetensorsValidateDevicePageLoadSetReceipt(index: WeightSafetensorsShardIndex,
                                                     graph: model_graph.ModelGraph,
                                                     targetDevice: device.Device,
                                                     pageTables: device.DeviceFileRangePageTableReceipt[],
                                                     set: WeightSafetensorsDevicePageBindingSet,
                                                     entryIndex: int32,
                                                     pageLoads: WeightSafetensorsDevicePageLoadResult[],
                                                     receipt: WeightSafetensorsDevicePageLoadSetReceipt): Result[bool] =
    let expected = WeightSafetensorsBuildDevicePageLoadSetReceipt(
        index,
        graph,
        targetDevice,
        pageTables,
        set,
        entryIndex,
        pageLoads
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.schema != WeightSafetensorsDevicePageLoadSetReceiptSchema ||
       receipt.modelCid != want.modelCid ||
       receipt.graphHash != want.graphHash ||
       receipt.shardIndexHash != want.shardIndexHash ||
       receipt.tensorName != want.tensorName ||
       receipt.shardCid != want.shardCid ||
       receipt.dtype != want.dtype ||
       receipt.quantScheme != want.quantScheme ||
       receipt.tensorScale != want.tensorScale ||
       receipt.filePath != want.filePath ||
       receipt.fileByteCount != want.fileByteCount ||
       receipt.dataStart != want.dataStart ||
       receipt.dataEnd != want.dataEnd ||
       receipt.byteCount != want.byteCount ||
       receipt.rawPayloadByteHash != want.rawPayloadByteHash ||
       receipt.payloadReceiptHash != want.payloadReceiptHash ||
       receipt.deviceCapabilityHash != want.deviceCapabilityHash ||
       receipt.bindingSetHash != want.bindingSetHash ||
       receipt.bindingHash != want.bindingHash ||
       receipt.pageTableReceiptHash != want.pageTableReceiptHash ||
       receipt.pageAggregateHash != want.pageAggregateHash ||
       receipt.pageBytes != want.pageBytes ||
       receipt.pageCount != want.pageCount ||
       receipt.pageLoadStatus != want.pageLoadStatus ||
       receipt.firstPageOffsetBytes != want.firstPageOffsetBytes ||
       receipt.finalPageEndBytes != want.finalPageEndBytes ||
       receipt.pageLoadReceiptHash != want.pageLoadReceiptHash ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("weight safetensors device page load set: mismatch")
    if WeightSafetensorsDevicePageLoadSetReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("weight safetensors device page load set: hash")
    return Ok[bool](true)

fn WeightSafetensorsLoadDevicePageSetFromBindingSet(index: WeightSafetensorsShardIndex,
                                                    graph: model_graph.ModelGraph,
                                                    targetDevice: device.Device,
                                                    pageTables: device.DeviceFileRangePageTableReceipt[],
                                                    set: WeightSafetensorsDevicePageBindingSet,
                                                    entryIndex: int32): Result[WeightSafetensorsDevicePageLoadResult[]] =
    if entryIndex < 0 || entryIndex >= pageTables.len:
        return Err[WeightSafetensorsDevicePageLoadResult[]]("weight safetensors device page load set metal: entry")
    let pageTable = pageTables[int(entryIndex)]
    if pageTable.pageCount <= 0 || pageTable.pages.len != int(pageTable.pageCount):
        return Err[WeightSafetensorsDevicePageLoadResult[]]("weight safetensors device page load set metal: page count")
    var loads: WeightSafetensorsDevicePageLoadResult[]
    for i in 0..<pageTable.pages.len:
        let loaded = WeightSafetensorsLoadDevicePageFromBindingSet(
            index,
            graph,
            targetDevice,
            pageTables,
            set,
            entryIndex,
            int32(i)
        )
        if IsErr(loaded):
            for j in 0..<loads.len:
                if loads[j].buffer.handle != uint64(0):
                    let _releasePageAfterFailure = device.DeviceMetalReleaseBuffer(loads[j].buffer)
            return Err[WeightSafetensorsDevicePageLoadResult[]](Error(loaded))
        add(loads, Value(loaded))
    return Ok[WeightSafetensorsDevicePageLoadResult[]](loads)

fn WeightSafetensorsValidateDevicePageLoadSetAgainstBuffer(index: WeightSafetensorsShardIndex,
                                                           graph: model_graph.ModelGraph,
                                                           targetDevice: device.Device,
                                                           pageTables: device.DeviceFileRangePageTableReceipt[],
                                                           set: WeightSafetensorsDevicePageBindingSet,
                                                           entryIndex: int32,
                                                           pageLoads: WeightSafetensorsDevicePageLoadResult[],
                                                           pageSetReceipt: WeightSafetensorsDevicePageLoadSetReceipt,
                                                           buffer: device.DeviceBuffer,
                                                           bufferReceipt: device.DeviceFileRangeBufferLoadReceipt): Result[bool] =
    if entryIndex < 0 ||
       entryIndex >= pageTables.len ||
       entryIndex >= set.bindings.len:
        return Err[bool]("weight safetensors device page load set buffer: entry")
    let pageSetOk = WeightSafetensorsValidateDevicePageLoadSetReceipt(
        index,
        graph,
        targetDevice,
        pageTables,
        set,
        entryIndex,
        pageLoads,
        pageSetReceipt
    )
    if IsErr(pageSetOk):
        return Err[bool](Error(pageSetOk))
    let bufferOk = device.DeviceValidateFileRangeBufferLoadReceipt(targetDevice, buffer, bufferReceipt)
    if IsErr(bufferOk):
        return Err[bool](Error(bufferOk))
    let binding = set.bindings[int(entryIndex)]
    if buffer.deviceCapabilityHash != targetDevice.capabilityHash ||
       buffer.dtype != binding.deviceBufferDtype ||
       buffer.sizeBytes != binding.byteCount ||
       buffer.logicalHash != binding.rawPayloadByteHash:
        return Err[bool]("weight safetensors device page load set buffer: buffer")
    if bufferReceipt.filePath != binding.filePath ||
       bufferReceipt.fileByteCount != binding.fileByteCount ||
       bufferReceipt.offsetBytes != binding.dataStart ||
       bufferReceipt.byteCount != binding.byteCount ||
       bufferReceipt.chunkBytes != binding.payloadChunkBytes ||
       bufferReceipt.sourceRangeHash != binding.rawPayloadByteHash ||
       bufferReceipt.deviceBufferDtype != binding.deviceBufferDtype ||
       bufferReceipt.deviceBufferSizeBytes != binding.byteCount ||
       bufferReceipt.deviceBufferLogicalHash != binding.rawPayloadByteHash ||
       bufferReceipt.deviceBufferHandle != buffer.handle:
        return Err[bool]("weight safetensors device page load set buffer: receipt")
    if pageSetReceipt.bindingHash != binding.bindingHash ||
       pageSetReceipt.rawPayloadByteHash != binding.rawPayloadByteHash ||
       pageSetReceipt.byteCount != binding.byteCount ||
       pageSetReceipt.firstPageOffsetBytes != binding.dataStart ||
       pageSetReceipt.finalPageEndBytes != binding.dataEnd:
        return Err[bool]("weight safetensors device page load set buffer: page set")
    return Ok[bool](true)

fn WeightSafetensorsDeviceMetalLinearOutInW4Afp8WeightPageSetBufferFill(out: var infer.TensorQ,
                                                                       index: WeightSafetensorsShardIndex,
                                                                       graph: model_graph.ModelGraph,
                                                                       targetDevice: device.Device,
                                                                       pageTables: device.DeviceFileRangePageTableReceipt[],
                                                                       set: WeightSafetensorsDevicePageBindingSet,
                                                                       entryIndex: int32,
                                                                       pageLoads: WeightSafetensorsDevicePageLoadResult[],
                                                                       pageSetReceipt: WeightSafetensorsDevicePageLoadSetReceipt,
                                                                       program: kernel_ir.KernelProgram,
                                                                       left: infer.TensorQ,
                                                                       rightBuffer: device.DeviceBuffer,
                                                                       rightReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                                       weightScaleInv: infer.TensorQ,
                                                                       inputScale: infer.TensorQ): Result[device.KernelLaunchReceipt] =
    if entryIndex < 0 || entryIndex >= set.bindings.len:
        return Err[device.KernelLaunchReceipt]("weight safetensors w4afp8 page set kernel: entry")
    let binding = set.bindings[int(entryIndex)]
    if binding.dtype != kernel_ir.KernelDtypeInt8 ||
       binding.quantScheme != model_graph.ModelQuantSchemeW4Afp8 ||
       binding.deviceBufferDtype != kernel_ir.KernelDtypeInt8:
        return Err[device.KernelLaunchReceipt]("weight safetensors w4afp8 page set kernel: weight kind")
    let pageSetOk = WeightSafetensorsValidateDevicePageLoadSetAgainstBuffer(
        index,
        graph,
        targetDevice,
        pageTables,
        set,
        entryIndex,
        pageLoads,
        pageSetReceipt,
        rightBuffer,
        rightReceipt
    )
    if IsErr(pageSetOk):
        return Err[device.KernelLaunchReceipt](Error(pageSetOk))
    if pageSetReceipt.pageLoadStatus != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       rightReceipt.status != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       rightBuffer.handle == uint64(0):
        return Err[device.KernelLaunchReceipt]("weight safetensors w4afp8 page set kernel: metal buffers")
    return device.DeviceMetalLinearOutInW4Afp8WeightBufferFill(
        out,
        targetDevice,
        program,
        left,
        rightBuffer,
        rightReceipt,
        weightScaleInv,
        inputScale
    )

fn WeightSafetensorsDeviceMetalLinearOutInW4Afp8RawScalePageSetBuffersToBufferFill(index: WeightSafetensorsShardIndex,
                                                                                  graph: model_graph.ModelGraph,
                                                                                  targetDevice: device.Device,
                                                                                  pageTables: device.DeviceFileRangePageTableReceipt[],
                                                                                  set: WeightSafetensorsDevicePageBindingSet,
                                                                                  rightEntryIndex: int32,
                                                                                  rightPageLoads: WeightSafetensorsDevicePageLoadResult[],
                                                                                  rightPageSetReceipt: WeightSafetensorsDevicePageLoadSetReceipt,
                                                                                  weightScaleEntryIndex: int32,
                                                                                  weightScalePageLoads: WeightSafetensorsDevicePageLoadResult[],
                                                                                  weightScalePageSetReceipt: WeightSafetensorsDevicePageLoadSetReceipt,
                                                                                  inputScaleEntryIndex: int32,
                                                                                  inputScalePageLoads: WeightSafetensorsDevicePageLoadResult[],
                                                                                  inputScalePageSetReceipt: WeightSafetensorsDevicePageLoadSetReceipt,
                                                                                  program: kernel_ir.KernelProgram,
                                                                                  leftBuffer: device.DeviceBuffer,
                                                                                  leftReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                                                  rightBuffer: device.DeviceBuffer,
                                                                                  rightReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                                                  weightScaleBuffer: device.DeviceBuffer,
                                                                                  weightScaleReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                                                  inputScaleBuffer: device.DeviceBuffer,
                                                                                  inputScaleReceipt: device.DeviceFileRangeBufferLoadReceipt): Result[device.DeviceBufferKernelLaunchResult] =
    if rightEntryIndex < 0 || rightEntryIndex >= set.bindings.len ||
       weightScaleEntryIndex < 0 || weightScaleEntryIndex >= set.bindings.len ||
       inputScaleEntryIndex < 0 || inputScaleEntryIndex >= set.bindings.len:
        return Err[device.DeviceBufferKernelLaunchResult]("weight safetensors w4afp8 raw scale page set kernel: entry")
    let rightBinding = set.bindings[int(rightEntryIndex)]
    let weightScaleBinding = set.bindings[int(weightScaleEntryIndex)]
    let inputScaleBinding = set.bindings[int(inputScaleEntryIndex)]
    if rightBinding.dtype != kernel_ir.KernelDtypeInt8 ||
       rightBinding.quantScheme != model_graph.ModelQuantSchemeW4Afp8 ||
       rightBinding.deviceBufferDtype != kernel_ir.KernelDtypeInt8:
        return Err[device.DeviceBufferKernelLaunchResult]("weight safetensors w4afp8 raw scale page set kernel: weight kind")
    if weightScaleBinding.dtype != kernel_ir.KernelDtypeFp8E4M3 ||
       weightScaleBinding.quantScheme != model_graph.ModelQuantSchemeNone ||
       weightScaleBinding.deviceBufferDtype != kernel_ir.KernelDtypeFp8E4M3:
        return Err[device.DeviceBufferKernelLaunchResult]("weight safetensors w4afp8 raw scale page set kernel: weight scale kind")
    if inputScaleBinding.dtype != kernel_ir.KernelDtypeFp8E4M3 ||
       inputScaleBinding.quantScheme != model_graph.ModelQuantSchemeNone ||
       inputScaleBinding.deviceBufferDtype != kernel_ir.KernelDtypeFp8E4M3:
        return Err[device.DeviceBufferKernelLaunchResult]("weight safetensors w4afp8 raw scale page set kernel: input scale kind")
    let rightPageSetOk = WeightSafetensorsValidateDevicePageLoadSetAgainstBuffer(
        index,
        graph,
        targetDevice,
        pageTables,
        set,
        rightEntryIndex,
        rightPageLoads,
        rightPageSetReceipt,
        rightBuffer,
        rightReceipt
    )
    if IsErr(rightPageSetOk):
        return Err[device.DeviceBufferKernelLaunchResult](Error(rightPageSetOk))
    let weightScalePageSetOk = WeightSafetensorsValidateDevicePageLoadSetAgainstBuffer(
        index,
        graph,
        targetDevice,
        pageTables,
        set,
        weightScaleEntryIndex,
        weightScalePageLoads,
        weightScalePageSetReceipt,
        weightScaleBuffer,
        weightScaleReceipt
    )
    if IsErr(weightScalePageSetOk):
        return Err[device.DeviceBufferKernelLaunchResult](Error(weightScalePageSetOk))
    let inputScalePageSetOk = WeightSafetensorsValidateDevicePageLoadSetAgainstBuffer(
        index,
        graph,
        targetDevice,
        pageTables,
        set,
        inputScaleEntryIndex,
        inputScalePageLoads,
        inputScalePageSetReceipt,
        inputScaleBuffer,
        inputScaleReceipt
    )
    if IsErr(inputScalePageSetOk):
        return Err[device.DeviceBufferKernelLaunchResult](Error(inputScalePageSetOk))
    if rightPageSetReceipt.pageLoadStatus != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       weightScalePageSetReceipt.pageLoadStatus != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       inputScalePageSetReceipt.pageLoadStatus != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       rightReceipt.status != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       weightScaleReceipt.status != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       inputScaleReceipt.status != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       rightBuffer.handle == uint64(0) ||
       weightScaleBuffer.handle == uint64(0) ||
       inputScaleBuffer.handle == uint64(0):
        return Err[device.DeviceBufferKernelLaunchResult]("weight safetensors w4afp8 raw scale page set kernel: metal buffers")
    return device.DeviceMetalLinearOutInW4Afp8ActivationWeightRawScaleBuffersToBufferFill(
        targetDevice,
        program,
        leftBuffer,
        leftReceipt,
        rightBuffer,
        rightReceipt,
        weightScaleBuffer,
        weightScaleReceipt,
        inputScaleBuffer,
        inputScaleReceipt
    )

@borrows
fn WeightSafetensorsDecodeTensorData(bytes: rawbytes.Bytes,
                                     dataBase: int64,
                                     meta: WeightSafetensorsTensorMeta,
                                     weight: model_graph.ModelWeightShard,
                                     tensorScale: int32): Result[infer.TensorQ] =
    if tensorScale <= 0:
        return Err[infer.TensorQ]("weight safetensors: tensor scale")
    let countRes = infer.TensorElementCount(weight.shape)
    if IsErr(countRes):
        return Err[infer.TensorQ](Error(countRes))
    if meta.byteCount != weight.sizeBytes:
        return Err[infer.TensorQ]("weight safetensors: tensor byte count")
    if dataBase < int64(0) || meta.dataStart < int64(0) || meta.dataEnd <= meta.dataStart:
        return Err[infer.TensorQ]("weight safetensors: tensor range")
    if meta.dataEnd > int64(rawbytes.BytesLen(bytes)) - dataBase:
        return Err[infer.TensorQ]("weight safetensors: tensor range")
    let fileStart64 = dataBase + meta.dataStart
    let fileEnd64 = dataBase + meta.dataEnd
    if fileStart64 > int64(2147483647) || fileEnd64 > int64(2147483647):
        return Err[infer.TensorQ]("weight safetensors: tensor offset")
    let fileStart = int32(fileStart64)
    var data: int32[]
    if weight.dtype == kernel_ir.KernelDtypeFp16:
        if meta.byteCount != int64(Value(countRes)) * int64(2):
            return Err[infer.TensorQ]("weight safetensors: f16 byte count")
        for i in 0..<Value(countRes):
            let raw = WeightSafetensorsReadU16LE(bytes, fileStart + i * 2)
            if IsErr(raw):
                return Err[infer.TensorQ](Error(raw))
            let value = WeightSafetensorsDecodeF16Scaled(Value(raw), tensorScale)
            if IsErr(value):
                return Err[infer.TensorQ](Error(value))
            add(data, Value(value))
    elif weight.dtype == kernel_ir.KernelDtypeBf16:
        if meta.byteCount != int64(Value(countRes)) * int64(2):
            return Err[infer.TensorQ]("weight safetensors: bf16 byte count")
        for i in 0..<Value(countRes):
            let raw = WeightSafetensorsReadU16LE(bytes, fileStart + i * 2)
            if IsErr(raw):
                return Err[infer.TensorQ](Error(raw))
            let value = WeightSafetensorsDecodeBf16Scaled(Value(raw), tensorScale)
            if IsErr(value):
                return Err[infer.TensorQ](Error(value))
            add(data, Value(value))
    elif weight.dtype == kernel_ir.KernelDtypeFp8E4M3:
        if meta.byteCount != int64(Value(countRes)):
            return Err[infer.TensorQ]("weight safetensors: fp8 e4m3 byte count")
        for i in 0..<Value(countRes):
            let value = WeightSafetensorsDecodeFp8E4M3Scaled(rawbytes.BytesGet(bytes, fileStart + i), tensorScale)
            if IsErr(value):
                return Err[infer.TensorQ](Error(value))
            add(data, Value(value))
    elif weight.dtype == kernel_ir.KernelDtypeInt8:
        if meta.byteCount != int64(Value(countRes)):
            return Err[infer.TensorQ]("weight safetensors: i8 byte count")
        for i in 0..<Value(countRes):
            let value = WeightSafetensorsDecodeI8Scaled(rawbytes.BytesGet(bytes, fileStart + i), tensorScale)
            if IsErr(value):
                return Err[infer.TensorQ](Error(value))
            add(data, Value(value))
    elif weight.dtype == kernel_ir.KernelDtypeInt4:
        let expectedI4Bytes = Value(countRes) / int64(2) + Value(countRes) % int64(2)
        if meta.byteCount != expectedI4Bytes:
            return Err[infer.TensorQ]("weight safetensors: i4 byte count")
        if Value(countRes) % int64(2) == int64(1):
            let lastByte = rawbytes.BytesGet(bytes, fileStart + int32(expectedI4Bytes - int64(1)))
            if ((lastByte >> 4) & 15) != 0:
                return Err[infer.TensorQ]("weight safetensors: i4 padding")
        for i in 0..<Value(countRes):
            let packed = rawbytes.BytesGet(bytes, fileStart + int32(i / int64(2)))
            var rawNibble = packed & 15
            if i % int64(2) == int64(1):
                rawNibble = (packed >> 4) & 15
            let value = WeightSafetensorsDecodeI4Scaled(rawNibble, tensorScale)
            if IsErr(value):
                return Err[infer.TensorQ](Error(value))
            add(data, Value(value))
    else:
        return Err[infer.TensorQ]("weight safetensors: unsupported dtype")
    var tensor: infer.TensorQ
    let tensorOk = infer.TensorFromDataFill(tensor, weight.shape, tensorScale, data)
    if IsErr(tensorOk):
        return Err[infer.TensorQ](Error(tensorOk))
    return Ok[infer.TensorQ](tensor)

@borrows
fn WeightSafetensorsPackedInt4Tensor(bytes: rawbytes.Bytes,
                                     dataBase: int64,
                                     meta: WeightSafetensorsTensorMeta,
                                     weight: model_graph.ModelWeightShard,
                                     tensorScale: int32): Result[kernel_ir.KernelPackedInt4Tensor] =
    if weight.dtype != kernel_ir.KernelDtypeInt4 || weight.quantScheme != model_graph.ModelQuantSchemeSymmetricInt4:
        return Err[kernel_ir.KernelPackedInt4Tensor]("weight safetensors: packed int4 metadata")
    if tensorScale <= 0:
        return Err[kernel_ir.KernelPackedInt4Tensor]("weight safetensors: tensor scale")
    let countRes = model_graph.ModelGraphTensorElementCount(weight.shape)
    if IsErr(countRes):
        return Err[kernel_ir.KernelPackedInt4Tensor](Error(countRes))
    let expectedBytes = Value(countRes) / int64(2) + Value(countRes) % int64(2)
    if expectedBytes <= int64(0) || expectedBytes > int64(2147483647):
        return Err[kernel_ir.KernelPackedInt4Tensor]("weight safetensors: packed int4 byte count")
    if meta.byteCount != expectedBytes:
        return Err[kernel_ir.KernelPackedInt4Tensor]("weight safetensors: packed int4 byte count")
    let fileStart64 = dataBase + meta.dataStart
    if fileStart64 < int64(0) || fileStart64 > int64(2147483647):
        return Err[kernel_ir.KernelPackedInt4Tensor]("weight safetensors: packed int4 offset")
    let packedBytes = rawbytes.BytesSlice(bytes, int32(fileStart64), int32(expectedBytes))
    if rawbytes.BytesLen(packedBytes) != int32(expectedBytes):
        return Err[kernel_ir.KernelPackedInt4Tensor]("weight safetensors: packed int4 slice")
    let packed = kernel_ir.KernelPackedInt4Tensor(shape: share(weight.shape), scale: tensorScale, packed: packedBytes)
    let ok = kernel_ir.KernelIrPackedInt4TensorValidate(packed)
    if IsErr(ok):
        return Err[kernel_ir.KernelPackedInt4Tensor](Error(ok))
    return Ok[kernel_ir.KernelPackedInt4Tensor](packed)

@borrows
fn WeightSafetensorsW4Afp8RawBytes(bytes: rawbytes.Bytes,
                                   dataBase: int64,
                                   meta: WeightSafetensorsTensorMeta,
                                   weight: model_graph.ModelWeightShard,
                                   tensorScale: int32): Result[rawbytes.Bytes] =
    if weight.dtype != kernel_ir.KernelDtypeInt8 || weight.quantScheme != model_graph.ModelQuantSchemeW4Afp8:
        return Err[rawbytes.Bytes]("weight safetensors: w4afp8 raw metadata")
    if tensorScale <= 0:
        return Err[rawbytes.Bytes]("weight safetensors: tensor scale")
    let countRes = model_graph.ModelGraphTensorElementCount(weight.shape)
    if IsErr(countRes):
        return Err[rawbytes.Bytes](Error(countRes))
    if Value(countRes) <= int64(0) || Value(countRes) > int64(2147483647):
        return Err[rawbytes.Bytes]("weight safetensors: w4afp8 raw byte count")
    if meta.byteCount != Value(countRes):
        return Err[rawbytes.Bytes]("weight safetensors: w4afp8 raw byte count")
    let fileStart64 = dataBase + meta.dataStart
    if fileStart64 < int64(0) || fileStart64 > int64(2147483647):
        return Err[rawbytes.Bytes]("weight safetensors: w4afp8 raw offset")
    let raw = rawbytes.BytesSlice(bytes, int32(fileStart64), int32(Value(countRes)))
    if rawbytes.BytesLen(raw) != int32(Value(countRes)):
        return Err[rawbytes.Bytes]("weight safetensors: w4afp8 raw slice")
    return Ok[rawbytes.Bytes](raw)

fn WeightSafetensorsLoadGraphFile(bytes: rawbytes.Bytes,
                                  graph: model_graph.ModelGraph,
                                  peerIds: str[],
                                  tensorScale: int32): Result[WeightSafetensorsLoadResult] =
    let manifestRes = WeightSafetensorsValidateGraphFile(bytes, graph)
    if IsErr(manifestRes):
        return Err[WeightSafetensorsLoadResult](Error(manifestRes))
    if peerIds.len != graph.weights.len:
        return Err[WeightSafetensorsLoadResult]("weight safetensors: peer count")
    let headerLen = WeightSafetensorsHeaderLength(bytes)
    if IsErr(headerLen):
        return Err[WeightSafetensorsLoadResult](Error(headerLen))
    let dataBase = int64(8 + Value(headerLen))
    let manifest = Value(manifestRes)
    var payloads: WeightTensorPayload[]
    var bindings: weight_binding.WeightShardBinding[]
    for i in 0..<graph.weights.len:
        if peerIds[i] == "":
            return Err[WeightSafetensorsLoadResult]("weight safetensors: peer id")
        let tensorRes = WeightSafetensorsDecodeTensorData(bytes, dataBase, manifest.tensors[i], graph.weights[i], tensorScale)
        if IsErr(tensorRes):
            return Err[WeightSafetensorsLoadResult](Error(tensorRes))
        var hasPackedInt4 = false
        var packedInt4 = WeightTensorEmptyPackedInt4()
        var hasW4Afp8Raw = false
        var w4Afp8Raw = rawbytes.EmptyBytes()
        if graph.weights[i].dtype == kernel_ir.KernelDtypeInt4 &&
           graph.weights[i].quantScheme == model_graph.ModelQuantSchemeSymmetricInt4:
            let packedRes = WeightSafetensorsPackedInt4Tensor(bytes, dataBase, manifest.tensors[i], graph.weights[i], tensorScale)
            if IsErr(packedRes):
                return Err[WeightSafetensorsLoadResult](Error(packedRes))
            hasPackedInt4 = true
            packedInt4 = Value(packedRes)
        elif graph.weights[i].dtype == kernel_ir.KernelDtypeInt8 &&
             graph.weights[i].quantScheme == model_graph.ModelQuantSchemeW4Afp8:
            let rawRes = WeightSafetensorsW4Afp8RawBytes(bytes, dataBase, manifest.tensors[i], graph.weights[i], tensorScale)
            if IsErr(rawRes):
                return Err[WeightSafetensorsLoadResult](Error(rawRes))
            hasW4Afp8Raw = true
            w4Afp8Raw = Value(rawRes)
        let payloadRes = WeightTensorPayloadBuildWithRawFacts(
            graph.weights[i].modelCid,
            graph.weights[i].tensorName,
            graph.weights[i].shardCid,
            graph.weights[i].dtype,
            graph.weights[i].quantScheme,
            peerIds[i],
            Value(tensorRes),
            hasPackedInt4,
            packedInt4,
            hasW4Afp8Raw,
            w4Afp8Raw
        )
        if IsErr(payloadRes):
            return Err[WeightSafetensorsLoadResult](Error(payloadRes))
        let payload = Value(payloadRes)
        add(bindings, weight_binding.WeightShardBinding(
            modelCid: share(graph.weights[i].modelCid),
            tensorName: share(graph.weights[i].tensorName),
            shardCid: share(graph.weights[i].shardCid),
            dtype: share(graph.weights[i].dtype),
            quantScheme: share(graph.weights[i].quantScheme),
            sizeBytes: graph.weights[i].sizeBytes,
            peerId: share(peerIds[i]),
            payloadHash: payload.payloadHash
        ))
        add(payloads, payload)
    let bindingSet = weight_binding.WeightBindingBuildSet(share(graph.modelCid), bindings)
    let bindingOk = weight_binding.WeightBindingValidate(bindingSet, graph)
    if IsErr(bindingOk):
        return Err[WeightSafetensorsLoadResult](Error(bindingOk))
    let store = WeightTensorStoreBuild(share(graph.modelCid), payloads)
    let storeOk = WeightTensorValidateStore(store, bindingSet, graph)
    if IsErr(storeOk):
        return Err[WeightSafetensorsLoadResult](Error(storeOk))
    return Ok[WeightSafetensorsLoadResult](WeightSafetensorsLoadResult(
        manifest: manifest,
        store: store,
        bindings: bindingSet
    ))

@borrows
fn WeightSafetensorsLoadGraphFilePath(path: str,
                                      graph: model_graph.ModelGraph,
                                      peerIds: str[],
                                      tensorScale: int32): Result[WeightSafetensorsLoadResult] =
    if path == "":
        return Err[WeightSafetensorsLoadResult]("weight safetensors: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[WeightSafetensorsLoadResult](Error(bytesRes))
    # 本函数独占持有这份刚读出的整文件字节(不像 WeightSafetensorsLoadGraphFile 的
    # bytes 形参那样被多处调用方复用/共享), 解码完毕后立即释放, 修复常驻泄漏。
    var bytes = Value(bytesRes)
    let result = WeightSafetensorsLoadGraphFile(bytes, graph, peerIds, tensorScale)
    rawbytes.BytesFree(bytes)
    return result

# 流式解码单个张量: payloadBytes 已是只含该张量数据区间的独立缓冲(dataBase=0
# 的 payload-only meta), 不做 expectedPayloadHash 复核(全量批量加载 WeightSafetensorsLoadGraphFile/
# WeightSafetensorsLoadShardIndexFile 走这条口径, 不是 WeightSafetensorsBuildPayloadFromEntryPayloadBytes
# 的按需单张量校验口径, 二者语义不同不可合并)。
fn weightSafetensorsBuildStreamedTensorPayload(payloadBytes: rawbytes.Bytes,
                                               meta: WeightSafetensorsTensorMeta,
                                               weight: model_graph.ModelWeightShard,
                                               peerId: str,
                                               tensorScale: int32): Result[WeightTensorPayload] =
    if meta.byteCount <= int64(0) || meta.byteCount > int64(rawbytes.BytesLen(payloadBytes)):
        return Err[WeightTensorPayload]("weight safetensors streaming payload: byte count")
    if int32(meta.byteCount) != rawbytes.BytesLen(payloadBytes):
        return Err[WeightTensorPayload]("weight safetensors streaming payload: length")
    let payloadMeta = WeightSafetensorsPayloadOnlyMeta(meta)
    let tensorRes = WeightSafetensorsDecodeTensorData(payloadBytes, int64(0), payloadMeta, weight, tensorScale)
    if IsErr(tensorRes):
        return Err[WeightTensorPayload](Error(tensorRes))
    var hasPackedInt4 = false
    var packedInt4 = WeightTensorEmptyPackedInt4()
    var hasW4Afp8Raw = false
    var w4Afp8Raw = rawbytes.EmptyBytes()
    if weight.dtype == kernel_ir.KernelDtypeInt4 &&
       weight.quantScheme == model_graph.ModelQuantSchemeSymmetricInt4:
        let packedRes = WeightSafetensorsPackedInt4Tensor(payloadBytes, int64(0), payloadMeta, weight, tensorScale)
        if IsErr(packedRes):
            return Err[WeightTensorPayload](Error(packedRes))
        hasPackedInt4 = true
        packedInt4 = Value(packedRes)
    elif weight.dtype == kernel_ir.KernelDtypeInt8 &&
         weight.quantScheme == model_graph.ModelQuantSchemeW4Afp8:
        let rawRes = WeightSafetensorsW4Afp8RawBytes(payloadBytes, int64(0), payloadMeta, weight, tensorScale)
        if IsErr(rawRes):
            return Err[WeightTensorPayload](Error(rawRes))
        hasW4Afp8Raw = true
        w4Afp8Raw = Value(rawRes)
    return WeightTensorPayloadBuildWithRawFacts(
        share(weight.modelCid),
        share(weight.tensorName),
        share(weight.shardCid),
        share(weight.dtype),
        share(weight.quantScheme),
        share(peerId),
        Value(tensorRes),
        hasPackedInt4,
        packedInt4,
        hasW4Afp8Raw,
        w4Afp8Raw
    )

# WeightSafetensorsLoadGraphFilePath 的流式姊妹函数: 接口签名完全一致, 但不整
# 文件一次性读入(避免峰值内存 = 文件字节 + 全部解码张量的双重物化)。只读文件头前
# 缀拿 dataBase, 每个张量各自 os.ReadFileRangeBytesResult 精确读取自己的数据区
# 间、解码、立即 BytesFree, 峰值内存只含"当前单个张量的原始字节"而非整个文件。
fn WeightSafetensorsLoadGraphFilePathStreaming(path: str,
                                               graph: model_graph.ModelGraph,
                                               peerIds: str[],
                                               tensorScale: int32): Result[WeightSafetensorsLoadResult] =
    if path == "":
        return Err[WeightSafetensorsLoadResult]("weight safetensors streaming: path")
    if peerIds.len != graph.weights.len:
        return Err[WeightSafetensorsLoadResult]("weight safetensors streaming: peer count")
    let pathCopy = share(path)
    let graphCopy = share(graph)
    let manifestRes = WeightSafetensorsValidateGraphFileHeaderPath(pathCopy, graphCopy)
    if IsErr(manifestRes):
        return Err[WeightSafetensorsLoadResult](Error(manifestRes))
    let manifest = Value(manifestRes)
    let prefixPathCopy = share(path)
    let prefix = WeightSafetensorsReadHeaderPrefixPath(prefixPathCopy)
    if IsErr(prefix):
        return Err[WeightSafetensorsLoadResult](Error(prefix))
    let prefixBytes = Value(prefix)
    let headerLen = WeightSafetensorsHeaderLength(prefixBytes)
    if IsErr(headerLen):
        return Err[WeightSafetensorsLoadResult](Error(headerLen))
    let dataBase = int64(8 + Value(headerLen))
    var payloads: WeightTensorPayload[]
    var bindings: weight_binding.WeightShardBinding[]
    for i in 0..<graph.weights.len:
        if peerIds[i] == "":
            return Err[WeightSafetensorsLoadResult]("weight safetensors streaming: peer id")
        let meta = manifest.tensors[i]
        if meta.byteCount <= int64(0) || meta.byteCount > int64(2147483647):
            return Err[WeightSafetensorsLoadResult]("weight safetensors streaming: tensor byte count")
        let absStart64 = dataBase + meta.dataStart
        if absStart64 < int64(0) || absStart64 > int64(2147483647):
            return Err[WeightSafetensorsLoadResult]("weight safetensors streaming: tensor offset")
        let readPathCopy = share(path)
        let payloadBytesRes = os.ReadFileRangeBytesResult(readPathCopy, absStart64, int32(meta.byteCount))
        if IsErr(payloadBytesRes):
            return Err[WeightSafetensorsLoadResult](Error(payloadBytesRes))
        var payloadBytes = Value(payloadBytesRes)
        let metaCopy = share(meta)
        let weightCopy = share(graph.weights[i])
        let peerCopy = share(peerIds[i])
        let payloadRes = weightSafetensorsBuildStreamedTensorPayload(payloadBytes, metaCopy, weightCopy, peerCopy, tensorScale)
        if IsErr(payloadRes):
            return Err[WeightSafetensorsLoadResult](Error(payloadRes))
        let payload = Value(payloadRes)
        add(bindings, weight_binding.WeightShardBinding(
            modelCid: share(graph.weights[i].modelCid),
            tensorName: share(graph.weights[i].tensorName),
            shardCid: share(graph.weights[i].shardCid),
            dtype: share(graph.weights[i].dtype),
            quantScheme: share(graph.weights[i].quantScheme),
            sizeBytes: graph.weights[i].sizeBytes,
            peerId: share(peerIds[i]),
            payloadHash: payload.payloadHash
        ))
        add(payloads, payload)
    let bindingSet = weight_binding.WeightBindingBuildSet(share(graph.modelCid), bindings)
    let bindingOk = weight_binding.WeightBindingValidate(bindingSet, graph)
    if IsErr(bindingOk):
        return Err[WeightSafetensorsLoadResult](Error(bindingOk))
    let store = WeightTensorStoreBuild(share(graph.modelCid), payloads)
    let storeOk = WeightTensorValidateStore(store, bindingSet, graph)
    if IsErr(storeOk):
        return Err[WeightSafetensorsLoadResult](Error(storeOk))
    return Ok[WeightSafetensorsLoadResult](WeightSafetensorsLoadResult(
        manifest: manifest,
        store: store,
        bindings: bindingSet
    ))

fn WeightSafetensorsBuildPayloadFromEntry(bytes: rawbytes.Bytes,
                                          dataBase: int64,
                                          meta: WeightSafetensorsTensorMeta,
                                          weight: model_graph.ModelWeightShard,
                                          entry: WeightSafetensorsShardIndexEntry): Result[WeightTensorPayload] =
    let tensorRes = WeightSafetensorsDecodeTensorData(bytes, dataBase, meta, weight, entry.tensorScale)
    if IsErr(tensorRes):
        return Err[WeightTensorPayload](Error(tensorRes))
    var hasPackedInt4 = false
    var packedInt4 = WeightTensorEmptyPackedInt4()
    var hasW4Afp8Raw = false
    var w4Afp8Raw = rawbytes.EmptyBytes()
    if weight.dtype == kernel_ir.KernelDtypeInt4 &&
       weight.quantScheme == model_graph.ModelQuantSchemeSymmetricInt4:
        let packedRes = WeightSafetensorsPackedInt4Tensor(bytes, dataBase, meta, weight, entry.tensorScale)
        if IsErr(packedRes):
            return Err[WeightTensorPayload](Error(packedRes))
        hasPackedInt4 = true
        packedInt4 = Value(packedRes)
    elif weight.dtype == kernel_ir.KernelDtypeInt8 &&
         weight.quantScheme == model_graph.ModelQuantSchemeW4Afp8:
        let rawRes = WeightSafetensorsW4Afp8RawBytes(bytes, dataBase, meta, weight, entry.tensorScale)
        if IsErr(rawRes):
            return Err[WeightTensorPayload](Error(rawRes))
        hasW4Afp8Raw = true
        w4Afp8Raw = Value(rawRes)
    return WeightTensorPayloadBuildWithRawFacts(
        share(weight.modelCid),
        share(weight.tensorName),
        share(weight.shardCid),
        share(weight.dtype),
        share(weight.quantScheme),
        share(entry.peerId),
        Value(tensorRes),
        hasPackedInt4,
        packedInt4,
        hasW4Afp8Raw,
        w4Afp8Raw
    )

fn WeightSafetensorsPayloadOnlyMeta(meta: WeightSafetensorsTensorMeta): WeightSafetensorsTensorMeta =
    return WeightSafetensorsTensorMeta(
        tensorName: share(meta.tensorName),
        dtype: share(meta.dtype),
        shape: share(meta.shape),
        dataStart: int64(0),
        dataEnd: meta.byteCount,
        byteCount: meta.byteCount
    )

fn WeightSafetensorsBuildPayloadFromEntryPayloadBytes(payloadBytes: rawbytes.Bytes,
                                                      meta: WeightSafetensorsTensorMeta,
                                                      weight: model_graph.ModelWeightShard,
                                                      entry: WeightSafetensorsShardIndexEntry): Result[WeightTensorPayload] =
    if meta.byteCount <= int64(0) || meta.byteCount > int64(rawbytes.BytesLen(payloadBytes)):
        return Err[WeightTensorPayload]("weight safetensors range payload: byte count")
    if meta.byteCount > int64(2147483647):
        return Err[WeightTensorPayload]("weight safetensors range payload: too large")
    if int32(meta.byteCount) != rawbytes.BytesLen(payloadBytes):
        return Err[WeightTensorPayload]("weight safetensors range payload: length")
    let payloadMeta = WeightSafetensorsPayloadOnlyMeta(meta)
    let tensorRes = WeightSafetensorsDecodeTensorData(payloadBytes, int64(0), payloadMeta, weight, entry.tensorScale)
    if IsErr(tensorRes):
        return Err[WeightTensorPayload](Error(tensorRes))
    var hasPackedInt4 = false
    var packedInt4 = WeightTensorEmptyPackedInt4()
    var hasW4Afp8Raw = false
    var w4Afp8Raw = rawbytes.EmptyBytes()
    if weight.dtype == kernel_ir.KernelDtypeInt4 &&
       weight.quantScheme == model_graph.ModelQuantSchemeSymmetricInt4:
        let packedRes = WeightSafetensorsPackedInt4Tensor(payloadBytes, int64(0), payloadMeta, weight, entry.tensorScale)
        if IsErr(packedRes):
            return Err[WeightTensorPayload](Error(packedRes))
        hasPackedInt4 = true
        packedInt4 = Value(packedRes)
    elif weight.dtype == kernel_ir.KernelDtypeInt8 &&
         weight.quantScheme == model_graph.ModelQuantSchemeW4Afp8:
        let rawRes = WeightSafetensorsW4Afp8RawBytes(payloadBytes, int64(0), payloadMeta, weight, entry.tensorScale)
        if IsErr(rawRes):
            return Err[WeightTensorPayload](Error(rawRes))
        hasW4Afp8Raw = true
        w4Afp8Raw = Value(rawRes)
    let payloadRes = WeightTensorPayloadBuildWithRawFacts(
        weight.modelCid,
        weight.tensorName,
        weight.shardCid,
        weight.dtype,
        weight.quantScheme,
        entry.peerId,
        Value(tensorRes),
        hasPackedInt4,
        packedInt4,
        hasW4Afp8Raw,
        w4Afp8Raw
    )
    if IsErr(payloadRes):
        return Err[WeightTensorPayload](Error(payloadRes))
    let payload = Value(payloadRes)
    if weight.expectedPayloadHash > int64(0) && payload.payloadHash != weight.expectedPayloadHash:
        return Err[WeightTensorPayload]("weight safetensors range payload: expected payload hash")
    return Ok[WeightTensorPayload](payload)

fn WeightSafetensorsBuildPayloadFromEntryRange(index: WeightSafetensorsShardIndex,
                                               graph: model_graph.ModelGraph,
                                               entryIndex: int32,
                                               maxPayloadBytes: int64): Result[WeightTensorPayload] =
    let indexOk = WeightSafetensorsShardIndexValidate(index, graph)
    if IsErr(indexOk):
        return Err[WeightTensorPayload](Error(indexOk))
    if entryIndex < 0 || entryIndex >= index.entries.len:
        return Err[WeightTensorPayload]("weight safetensors range payload: entry")
    if maxPayloadBytes <= int64(0):
        return Err[WeightTensorPayload]("weight safetensors range payload: max bytes")
    let entry = index.entries[entryIndex]
    if entry.filePath == "":
        return Err[WeightTensorPayload]("weight safetensors range payload: file path")
    let graphIndex = WeightSafetensorsShardIndexFindGraphWeight(graph, entry)
    if graphIndex < 0:
        return Err[WeightTensorPayload]("weight safetensors range payload: graph weight")
    let fileHeaderOk = WeightSafetensorsBuildShardHeaderReceiptFile(index, graph, entryIndex)
    if IsErr(fileHeaderOk):
        return Err[WeightTensorPayload](Error(fileHeaderOk))
    let fileLen = os.FileSize(entry.filePath)
    if fileLen <= int64(8):
        return Err[WeightTensorPayload]("weight safetensors range payload: file size")
    let prefix = WeightSafetensorsReadHeaderPrefixPath(entry.filePath)
    if IsErr(prefix):
        return Err[WeightTensorPayload](Error(prefix))
    let headerLen = WeightSafetensorsHeaderLength(Value(prefix))
    if IsErr(headerLen):
        return Err[WeightTensorPayload](Error(headerLen))
    let headerText = WeightSafetensorsHeaderText(Value(prefix))
    if IsErr(headerText):
        return Err[WeightTensorPayload](Error(headerText))
    let dataBase = int64(8 + Value(headerLen))
    let meta = WeightSafetensorsTensorMetaFromHeader(Value(headerText),
                                                     fileLen,
                                                     dataBase,
                                                     graph.weights[graphIndex])
    if IsErr(meta):
        return Err[WeightTensorPayload](Error(meta))
    if Value(meta).byteCount > maxPayloadBytes:
        return Err[WeightTensorPayload]("weight safetensors range payload: exceeds max bytes")
    if Value(meta).byteCount > int64(2147483647):
        return Err[WeightTensorPayload]("weight safetensors range payload: too large")
    let absStart = dataBase + Value(meta).dataStart
    let payloadBytes = os.ReadFileRangeBytesResult(entry.filePath, absStart, int32(Value(meta).byteCount))
    if IsErr(payloadBytes):
        return Err[WeightTensorPayload](Error(payloadBytes))
    return WeightSafetensorsBuildPayloadFromEntryPayloadBytes(Value(payloadBytes),
                                                              Value(meta),
                                                              graph.weights[graphIndex],
                                                              entry)

# WeightSafetensorsLoadShardIndexFile 的内层实现: bytes 由调用方独占读入并
# 在返回后统一释放(见下方 wrapper), 本函数自身绝不释放 bytes, 也绝不能提前
# return 而绕过调用方的释放——所有失败分支都走普通 Result 返回, 由 wrapper
# 统一在 Ok/Err 两种结果上都执行一次 BytesFree, 避免早退错误路径漏释放
# (fixup: 原实现把 BytesFree 放在函数末尾单一成功路径上, 前面 7 处 IsErr
# 早退分支全部跳过释放, 大 shard 文件解析失败时整文件字节常驻不回收)。
fn weightSafetensorsLoadShardIndexFileBody(bytes: rawbytes.Bytes,
                                           index: WeightSafetensorsShardIndex,
                                           graph: model_graph.ModelGraph,
                                           filePath: str,
                                           payloads: var WeightTensorPayload[],
                                           bindings: var weight_binding.WeightShardBinding[],
                                           fileReceipts: var WeightSafetensorsShardFileReceipt[]): Result[bool] =
    let headerLen = WeightSafetensorsHeaderLength(bytes)
    if IsErr(headerLen):
        return Err[bool](Error(headerLen))
    let headerText = WeightSafetensorsHeaderText(bytes)
    if IsErr(headerText):
        return Err[bool](Error(headerText))
    let dataBase = int64(8 + Value(headerLen))
    let headerHash = WeightTensorHashTextWith(int64(113), Value(headerText))
    var metas: WeightSafetensorsTensorMeta[]
    var graphIndexes: int32[]
    var entryIndexes: int32[]
    for i in 0..<index.entries.len:
        if index.entries[i].filePath == filePath:
            let graphIndex = WeightSafetensorsShardIndexFindGraphWeight(graph, index.entries[i])
            if graphIndex < 0:
                return Err[bool]("weight safetensors index: graph weight")
            let metaRes = WeightSafetensorsTensorMetaFromHeader(Value(headerText),
                                                               int64(rawbytes.BytesLen(bytes)),
                                                               dataBase,
                                                               graph.weights[graphIndex])
            if IsErr(metaRes):
                return Err[bool](Error(metaRes))
            add(metas, Value(metaRes))
            add(graphIndexes, graphIndex)
            add(entryIndexes, i)
    if metas.len <= 0:
        return Err[bool]("weight safetensors index: empty file")
    for i in 0..<metas.len:
        for j in i + 1..<metas.len:
            if !(metas[i].dataEnd <= metas[j].dataStart || metas[j].dataEnd <= metas[i].dataStart):
                return Err[bool]("weight safetensors index: overlapping tensor data")
    for i in 0..<metas.len:
        let entry = index.entries[entryIndexes[i]]
        let weight = graph.weights[graphIndexes[i]]
        let payloadRes = WeightSafetensorsBuildPayloadFromEntry(bytes, dataBase, metas[i], weight, entry)
        if IsErr(payloadRes):
            return Err[bool](Error(payloadRes))
        let payload = Value(payloadRes)
        add(payloads, payload)
        add(bindings, weight_binding.WeightShardBinding(
            modelCid: weight.modelCid,
            tensorName: weight.tensorName,
            shardCid: weight.shardCid,
            dtype: weight.dtype,
            quantScheme: weight.quantScheme,
            sizeBytes: weight.sizeBytes,
            peerId: entry.peerId,
            payloadHash: payload.payloadHash
        ))
    add(fileReceipts, WeightSafetensorsShardFileReceipt(
        filePath: filePath,
        fileByteHash: WeightTensorHashBytesWith(int64(113), bytes),
        fileByteCount: int64(rawbytes.BytesLen(bytes)),
        headerHash: headerHash,
        indexedTensorCount: metas.len
    ))
    return Ok[bool](true)

fn WeightSafetensorsLoadShardIndexFile(index: WeightSafetensorsShardIndex,
                                       graph: model_graph.ModelGraph,
                                       fileEntryIndex: int32,
                                       payloads: var WeightTensorPayload[],
                                       bindings: var weight_binding.WeightShardBinding[],
                                       fileReceipts: var WeightSafetensorsShardFileReceipt[]): Result[bool] =
    let filePath = index.entries[fileEntryIndex].filePath
    if filePath == "":
        return Err[bool]("weight safetensors index: file path")
    let bytesRes = os.ReadFileBytesResult(filePath)
    if IsErr(bytesRes):
        return Err[bool](Error(bytesRes))
    var bytes = Value(bytesRes)
    # 该 shard 文件此调用内独占读入的整文件字节, 无论 body 解析成功还是失败都
    # 立即释放, 不再常驻到 store 生命周期结束(修复真实泄漏, 且覆盖失败路径)。
    let result = weightSafetensorsLoadShardIndexFileBody(bytes, index, graph, filePath, payloads, bindings, fileReceipts)
    rawbytes.BytesFree(bytes)
    return result

# WeightSafetensorsLoadShardIndexFile 的流式姊妹函数: 同签名同副作用(向 payloads/
# bindings/fileReceipts 追加), 唯一区别是不整文件读入——每个属于该文件的张量各自
# os.ReadFileRangeBytesResult 只读自己的数据区间, 解码后立即释放。
# 明确排除: fileReceipts.fileByteHash 在此路径下不做整文件滚动哈希复现(需要整
# 文件字节逐字节折叠, 与流式的初衷矛盾), 显式置 0, 不伪造一个看似合法实则未覆盖
# 全文件的哈希值。如需该文件级审计哈希, 调用方应改用已存在的
# WeightSafetensorsHashFileRangePath(按 range 分块滚动哈希, 与此处解码 I/O 分离)。
fn WeightSafetensorsLoadShardIndexFileStreaming(index: WeightSafetensorsShardIndex,
                                                graph: model_graph.ModelGraph,
                                                fileEntryIndex: int32,
                                                payloads: var WeightTensorPayload[],
                                                bindings: var weight_binding.WeightShardBinding[],
                                                fileReceipts: var WeightSafetensorsShardFileReceipt[]): Result[bool] =
    let filePath = index.entries[fileEntryIndex].filePath
    if filePath == "":
        return Err[bool]("weight safetensors index streaming: file path")
    let fileLen = os.FileSize(filePath)
    if fileLen <= int64(8):
        return Err[bool]("weight safetensors index streaming: file size")
    let prefix = WeightSafetensorsReadHeaderPrefixPath(filePath)
    if IsErr(prefix):
        return Err[bool](Error(prefix))
    let headerLen = WeightSafetensorsHeaderLength(Value(prefix))
    if IsErr(headerLen):
        return Err[bool](Error(headerLen))
    let headerText = WeightSafetensorsHeaderText(Value(prefix))
    if IsErr(headerText):
        return Err[bool](Error(headerText))
    let dataBase = int64(8 + Value(headerLen))
    let headerHash = WeightTensorHashTextWith(int64(113), Value(headerText))
    var metas: WeightSafetensorsTensorMeta[]
    var graphIndexes: int32[]
    var entryIndexes: int32[]
    for i in 0..<index.entries.len:
        if index.entries[i].filePath == filePath:
            let graphIndex = WeightSafetensorsShardIndexFindGraphWeight(graph, index.entries[i])
            if graphIndex < 0:
                return Err[bool]("weight safetensors index streaming: graph weight")
            let metaRes = WeightSafetensorsTensorMetaFromHeader(Value(headerText),
                                                               fileLen,
                                                               dataBase,
                                                               graph.weights[graphIndex])
            if IsErr(metaRes):
                return Err[bool](Error(metaRes))
            add(metas, Value(metaRes))
            add(graphIndexes, graphIndex)
            add(entryIndexes, i)
    if metas.len <= 0:
        return Err[bool]("weight safetensors index streaming: empty file")
    for i in 0..<metas.len:
        for j in i + 1..<metas.len:
            if !(metas[i].dataEnd <= metas[j].dataStart || metas[j].dataEnd <= metas[i].dataStart):
                return Err[bool]("weight safetensors index streaming: overlapping tensor data")
    for i in 0..<metas.len:
        let entry = index.entries[entryIndexes[i]]
        let weight = graph.weights[graphIndexes[i]]
        let meta = metas[i]
        if meta.byteCount <= int64(0) || meta.byteCount > int64(2147483647):
            return Err[bool]("weight safetensors index streaming: tensor byte count")
        let absStart64 = dataBase + meta.dataStart
        if absStart64 < int64(0) || absStart64 > int64(2147483647):
            return Err[bool]("weight safetensors index streaming: tensor offset")
        let payloadBytesRes = os.ReadFileRangeBytesResult(filePath, absStart64, int32(meta.byteCount))
        if IsErr(payloadBytesRes):
            return Err[bool](Error(payloadBytesRes))
        var payloadBytes = Value(payloadBytesRes)
        let payloadRes = weightSafetensorsBuildStreamedTensorPayload(payloadBytes, share(meta), weight, share(entry.peerId), entry.tensorScale)
        if IsErr(payloadRes):
            return Err[bool](Error(payloadRes))
        let payload = Value(payloadRes)
        add(payloads, payload)
        add(bindings, weight_binding.WeightShardBinding(
            modelCid: weight.modelCid,
            tensorName: weight.tensorName,
            shardCid: weight.shardCid,
            dtype: weight.dtype,
            quantScheme: weight.quantScheme,
            sizeBytes: weight.sizeBytes,
            peerId: entry.peerId,
            payloadHash: payload.payloadHash
        ))
    add(fileReceipts, WeightSafetensorsShardFileReceipt(
        filePath: filePath,
        fileByteHash: int64(0),
        fileByteCount: fileLen,
        headerHash: headerHash,
        indexedTensorCount: metas.len
    ))
    return Ok[bool](true)

fn WeightSafetensorsBuildShardHeaderReceiptFile(index: WeightSafetensorsShardIndex,
                                                graph: model_graph.ModelGraph,
                                                fileEntryIndex: int32): Result[WeightSafetensorsShardHeaderReceipt] =
    let filePath = index.entries[fileEntryIndex].filePath
    if filePath == "":
        return Err[WeightSafetensorsShardHeaderReceipt]("weight safetensors header index: file path")
    let fileLen = os.FileSize(filePath)
    if fileLen <= int64(8):
        return Err[WeightSafetensorsShardHeaderReceipt]("weight safetensors header index: file size")
    let prefix = WeightSafetensorsReadHeaderPrefixPath(filePath)
    if IsErr(prefix):
        return Err[WeightSafetensorsShardHeaderReceipt](Error(prefix))
    let headerLen = WeightSafetensorsHeaderLength(Value(prefix))
    if IsErr(headerLen):
        return Err[WeightSafetensorsShardHeaderReceipt](Error(headerLen))
    let headerText = WeightSafetensorsHeaderText(Value(prefix))
    if IsErr(headerText):
        return Err[WeightSafetensorsShardHeaderReceipt](Error(headerText))
    let dataBase = int64(8 + Value(headerLen))
    let headerHash = WeightTensorHashTextWith(int64(113), Value(headerText))
    var metas: WeightSafetensorsTensorMeta[]
    for i in 0..<index.entries.len:
        if index.entries[i].filePath == filePath:
            let graphIndex = WeightSafetensorsShardIndexFindGraphWeight(graph, index.entries[i])
            if graphIndex < 0:
                return Err[WeightSafetensorsShardHeaderReceipt]("weight safetensors header index: graph weight")
            let metaRes = WeightSafetensorsTensorMetaFromHeader(Value(headerText),
                                                               fileLen,
                                                               dataBase,
                                                               graph.weights[graphIndex])
            if IsErr(metaRes):
                return Err[WeightSafetensorsShardHeaderReceipt](Error(metaRes))
            add(metas, Value(metaRes))
    if metas.len <= 0:
        return Err[WeightSafetensorsShardHeaderReceipt]("weight safetensors header index: empty file")
    for i in 0..<metas.len:
        for j in i + 1..<metas.len:
            if !(metas[i].dataEnd <= metas[j].dataStart || metas[j].dataEnd <= metas[i].dataStart):
                return Err[WeightSafetensorsShardHeaderReceipt]("weight safetensors header index: overlapping tensor data")
    var out = WeightSafetensorsShardHeaderReceipt(
        schema: WeightSafetensorsShardHeaderReceiptSchema,
        modelCid: index.modelCid,
        graphHash: index.graphHash,
        shardIndexHash: index.indexHash,
        filePath: filePath,
        fileByteCount: fileLen,
        headerHash: headerHash,
        indexedTensorCount: metas.len,
        receiptHash: int64(0)
    )
    out.receiptHash = WeightSafetensorsShardHeaderReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[WeightSafetensorsShardHeaderReceipt]("weight safetensors header index: receipt hash")
    return Ok[WeightSafetensorsShardHeaderReceipt](out)

fn WeightSafetensorsBuildShardHeaderPreflight(index: WeightSafetensorsShardIndex,
                                             graph: model_graph.ModelGraph): Result[WeightSafetensorsShardHeaderPreflight] =
    let indexOk = WeightSafetensorsShardIndexValidate(index, graph)
    if IsErr(indexOk):
        return Err[WeightSafetensorsShardHeaderPreflight](Error(indexOk))
    var receipts: WeightSafetensorsShardHeaderReceipt[]
    var tensorCount: int32
    for i in 0..<index.entries.len:
        if WeightSafetensorsShardIndexPathFirst(index, i):
            let receipt = WeightSafetensorsBuildShardHeaderReceiptFile(index, graph, i)
            if IsErr(receipt):
                return Err[WeightSafetensorsShardHeaderPreflight](Error(receipt))
            tensorCount = tensorCount + Value(receipt).indexedTensorCount
            add(receipts, Value(receipt))
    if receipts.len <= 0 || tensorCount != graph.weights.len:
        return Err[WeightSafetensorsShardHeaderPreflight]("weight safetensors header preflight: tensor count")
    let fileHash = WeightSafetensorsShardHeaderReceiptSetHash(receipts)
    if fileHash <= int64(0):
        return Err[WeightSafetensorsShardHeaderPreflight]("weight safetensors header preflight: file hash")
    var out = WeightSafetensorsShardHeaderPreflight(
        schema: WeightSafetensorsShardHeaderPreflightSchema,
        modelCid: index.modelCid,
        graphHash: index.graphHash,
        shardIndexHash: index.indexHash,
        fileReceipts: receipts,
        fileReceiptHash: fileHash,
        tensorCount: tensorCount,
        receiptHash: int64(0)
    )
    out.receiptHash = WeightSafetensorsShardHeaderPreflightHash(out)
    if out.receiptHash <= int64(0):
        return Err[WeightSafetensorsShardHeaderPreflight]("weight safetensors header preflight: receipt hash")
    return Ok[WeightSafetensorsShardHeaderPreflight](out)

fn WeightSafetensorsValidateShardHeaderPreflight(index: WeightSafetensorsShardIndex,
                                                graph: model_graph.ModelGraph,
                                                preflight: WeightSafetensorsShardHeaderPreflight): Result[bool] =
    let expected = WeightSafetensorsBuildShardHeaderPreflight(index, graph)
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if preflight.schema != WeightSafetensorsShardHeaderPreflightSchema ||
       preflight.modelCid != want.modelCid ||
       preflight.graphHash != want.graphHash ||
       preflight.shardIndexHash != want.shardIndexHash ||
       preflight.fileReceipts.len != want.fileReceipts.len ||
       preflight.fileReceiptHash != want.fileReceiptHash ||
       preflight.tensorCount != want.tensorCount ||
       preflight.receiptHash != want.receiptHash:
        return Err[bool]("weight safetensors header preflight: mismatch")
    if WeightSafetensorsShardHeaderPreflightHash(preflight) != preflight.receiptHash:
        return Err[bool]("weight safetensors header preflight: hash")
    return Ok[bool](true)

fn WeightSafetensorsLoadShardIndex(index: WeightSafetensorsShardIndex,
                                   graph: model_graph.ModelGraph): Result[WeightSafetensorsShardIndexLoadResult] =
    let indexOk = WeightSafetensorsShardIndexValidate(index, graph)
    if IsErr(indexOk):
        return Err[WeightSafetensorsShardIndexLoadResult](Error(indexOk))
    var payloads: WeightTensorPayload[]
    var bindings: weight_binding.WeightShardBinding[]
    var fileReceipts: WeightSafetensorsShardFileReceipt[]
    for i in 0..<index.entries.len:
        if WeightSafetensorsShardIndexPathFirst(index, i):
            let fileRes = WeightSafetensorsLoadShardIndexFile(index, graph, i, payloads, bindings, fileReceipts)
            if IsErr(fileRes):
                return Err[WeightSafetensorsShardIndexLoadResult](Error(fileRes))
    let bindingSet = weight_binding.WeightBindingBuildSet(share(graph.modelCid), bindings)
    let bindingOk = weight_binding.WeightBindingValidate(bindingSet, graph)
    if IsErr(bindingOk):
        return Err[WeightSafetensorsShardIndexLoadResult](Error(bindingOk))
    let store = WeightTensorStoreBuild(share(graph.modelCid), payloads)
    let storeOk = WeightTensorValidateStore(store, bindingSet, graph)
    if IsErr(storeOk):
        return Err[WeightSafetensorsShardIndexLoadResult](Error(storeOk))
    return Ok[WeightSafetensorsShardIndexLoadResult](WeightSafetensorsShardIndexLoadResult(
        index: index,
        fileReceipts: fileReceipts,
        store: store,
        bindings: bindingSet
    ))

# WeightSafetensorsLoadShardIndex 的流式姊妹函数: 同签名同返回类型, 每个 shard
# 文件走 WeightSafetensorsLoadShardIndexFileStreaming(按张量 range 读, 不整文件
# 物化)。分片 index 天然多文件, 流式收益随分片数线性放大。
fn WeightSafetensorsLoadShardIndexStreaming(index: WeightSafetensorsShardIndex,
                                            graph: model_graph.ModelGraph): Result[WeightSafetensorsShardIndexLoadResult] =
    let indexOk = WeightSafetensorsShardIndexValidate(index, graph)
    if IsErr(indexOk):
        return Err[WeightSafetensorsShardIndexLoadResult](Error(indexOk))
    var payloads: WeightTensorPayload[]
    var bindings: weight_binding.WeightShardBinding[]
    var fileReceipts: WeightSafetensorsShardFileReceipt[]
    for i in 0..<index.entries.len:
        if WeightSafetensorsShardIndexPathFirst(index, i):
            let fileRes = WeightSafetensorsLoadShardIndexFileStreaming(index, graph, i, payloads, bindings, fileReceipts)
            if IsErr(fileRes):
                return Err[WeightSafetensorsShardIndexLoadResult](Error(fileRes))
    let bindingSet = weight_binding.WeightBindingBuildSet(share(graph.modelCid), bindings)
    let bindingOk = weight_binding.WeightBindingValidate(bindingSet, graph)
    if IsErr(bindingOk):
        return Err[WeightSafetensorsShardIndexLoadResult](Error(bindingOk))
    let store = WeightTensorStoreBuild(share(graph.modelCid), payloads)
    let storeOk = WeightTensorValidateStore(store, bindingSet, graph)
    if IsErr(storeOk):
        return Err[WeightSafetensorsShardIndexLoadResult](Error(storeOk))
    return Ok[WeightSafetensorsShardIndexLoadResult](WeightSafetensorsShardIndexLoadResult(
        index: index,
        fileReceipts: fileReceipts,
        store: store,
        bindings: bindingSet
    ))

@borrows
fn WeightSafetensorsCanonicalJsonHash(indexJson: str): Result[int64] =
    let canon = jsoncanon.CsgCoreJsonCanonicalize(indexJson)
    if !canon.ok:
        return Err[int64](strutil.Join(["weight safetensors repository: index json ", share(canon.error)], ""))
    let h = WeightTensorHashTextWith(int64(113), canon.value)
    if h <= int64(0):
        return Err[int64]("weight safetensors repository: index hash")
    return Ok[int64](h)

fn WeightSafetensorsLoadHfRepositoryWithConfig(indexJson: str,
                                               configJson: str,
                                               graph: model_graph.ModelGraph,
                                               baseDir: str,
                                               peerIds: str[],
                                               tensorScale: int32): Result[WeightSafetensorsRepositoryLoadResult] =
    let graphOk = model_graph.ModelGraphValidateExpectedWeightPayloadHashes(graph)
    if IsErr(graphOk):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(graphOk))
    let quantConfig = WeightSafetensorsHfQuantizationConfigFromJson(configJson)
    if IsErr(quantConfig):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(quantConfig))
    let quantConfigOk = WeightSafetensorsHfQuantizationConfigValidateForGraph(Value(quantConfig), graph)
    if IsErr(quantConfigOk):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(quantConfigOk))
    let hfIndexHash = WeightSafetensorsCanonicalJsonHash(indexJson)
    if IsErr(hfIndexHash):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(hfIndexHash))
    let indexRes = WeightSafetensorsShardIndexFromHfWeightMap(indexJson, graph, baseDir, peerIds, tensorScale)
    if IsErr(indexRes):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(indexRes))
    let loadRes = WeightSafetensorsLoadShardIndex(Value(indexRes), graph)
    if IsErr(loadRes):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(loadRes))
    let load = Value(loadRes)
    let receiptRes = WeightSafetensorsRepositoryReceiptBuild(
        graph.modelCid,
        graph.graphHash,
        Value(hfIndexHash),
        Value(quantConfig),
        load.index.indexHash,
        load.fileReceipts,
        load.bindings,
        load.store
    )
    if IsErr(receiptRes):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(receiptRes))
    return Ok[WeightSafetensorsRepositoryLoadResult](WeightSafetensorsRepositoryLoadResult(
        receipt: Value(receiptRes),
        load: load
    ))

fn WeightSafetensorsLoadHfRepository(indexJson: str,
                                     graph: model_graph.ModelGraph,
                                     baseDir: str,
                                     peerIds: str[],
                                     tensorScale: int32): Result[WeightSafetensorsRepositoryLoadResult] =
    return WeightSafetensorsLoadHfRepositoryWithConfig(indexJson, "{}", graph, baseDir, peerIds, tensorScale)

fn WeightSafetensorsLoadHfRepositoryPathWithConfigPath(indexPath: str,
                                                       configPath: str,
                                                       graph: model_graph.ModelGraph,
                                                       baseDir: str,
                                                       peerIds: str[],
                                                       tensorScale: int32): Result[WeightSafetensorsRepositoryLoadResult] =
    if indexPath == "" || configPath == "":
        return Err[WeightSafetensorsRepositoryLoadResult]("weight safetensors repository: path")
    let indexBytes = os.ReadFileBytesResult(indexPath)
    if IsErr(indexBytes):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(indexBytes))
    let configBytes = os.ReadFileBytesResult(configPath)
    if IsErr(configBytes):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(configBytes))
    let indexText = rawbytes.BytesToString(Value(indexBytes))
    let configText = rawbytes.BytesToString(Value(configBytes))
    return WeightSafetensorsLoadHfRepositoryWithConfig(indexText, configText, graph, baseDir, peerIds, tensorScale)

fn WeightSafetensorsLoadHfRepositoryPath(indexPath: str,
                                         graph: model_graph.ModelGraph,
                                         baseDir: str,
                                         peerIds: str[],
                                         tensorScale: int32): Result[WeightSafetensorsRepositoryLoadResult] =
    if indexPath == "":
        return Err[WeightSafetensorsRepositoryLoadResult]("weight safetensors repository: path")
    let bytesRes = os.ReadFileBytesResult(indexPath)
    if IsErr(bytesRes):
        return Err[WeightSafetensorsRepositoryLoadResult](Error(bytesRes))
    let text = rawbytes.BytesToString(Value(bytesRes))
    return WeightSafetensorsLoadHfRepository(text, graph, baseDir, peerIds, tensorScale)

fn WeightTensorMaterializedShardByteCount(rank: int32, elemCount: int32): Result[int32] =
    if rank <= 0 || elemCount <= 0:
        return Err[int32]("weight tensor shard file: shape")
    if rank > (2147483647 - WeightTensorMaterializedShardHeaderBytes) / 4:
        return Err[int32]("weight tensor shard file: rank overflow")
    let shapeBytes = rank * 4
    if elemCount > (2147483647 - WeightTensorMaterializedShardHeaderBytes - shapeBytes) / 4:
        return Err[int32]("weight tensor shard file: data overflow")
    return Ok[int32](WeightTensorMaterializedShardHeaderBytes + shapeBytes + elemCount * 4)

fn WeightTensorMaterializedShardBytes(tensor: infer.TensorQ): Result[rawbytes.Bytes] =
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[rawbytes.Bytes](Error(tensorOk))
    let byteCount = WeightTensorMaterializedShardByteCount(tensor.shape.len, tensor.data.len)
    if IsErr(byteCount):
        return Err[rawbytes.Bytes](Error(byteCount))
    var out = rawbytes.BytesAlloc(Value(byteCount))
    if rawbytes.BytesLen(out) != Value(byteCount):
        return Err[rawbytes.Bytes]("weight tensor shard file: allocation")
    rawbytes.BytesSet(out, 0, WeightTensorMaterializedShardMagic0)
    rawbytes.BytesSet(out, 1, WeightTensorMaterializedShardMagic1)
    rawbytes.BytesSet(out, 2, WeightTensorMaterializedShardMagic2)
    rawbytes.BytesSet(out, 3, WeightTensorMaterializedShardMagic3)
    WeightTensorWriteI32LE(out, 4, tensor.shape.len)
    WeightTensorWriteI32LE(out, 8, tensor.scale)
    WeightTensorWriteI32LE(out, 12, tensor.data.len)
    var offset: int32
    offset = WeightTensorMaterializedShardHeaderBytes
    for i in 0..<tensor.shape.len:
        WeightTensorWriteI32LE(out, offset, tensor.shape[i])
        offset = offset + 4
    for i in 0..<tensor.data.len:
        WeightTensorWriteI32LE(out, offset, tensor.data[i])
        offset = offset + 4
    return Ok[rawbytes.Bytes](out)

fn WeightTensorMaterializedShardTensor(bytes: rawbytes.Bytes): Result[infer.TensorQ] =
    if rawbytes.BytesLen(bytes) < WeightTensorMaterializedShardHeaderBytes:
        return Err[infer.TensorQ]("weight tensor shard file: short header")
    if rawbytes.BytesGet(bytes, 0) != WeightTensorMaterializedShardMagic0 ||
       rawbytes.BytesGet(bytes, 1) != WeightTensorMaterializedShardMagic1 ||
       rawbytes.BytesGet(bytes, 2) != WeightTensorMaterializedShardMagic2 ||
       rawbytes.BytesGet(bytes, 3) != WeightTensorMaterializedShardMagic3:
        return Err[infer.TensorQ]("weight tensor shard file: magic")
    let rank = WeightTensorReadI32LE(bytes, 4)
    let scale = WeightTensorReadI32LE(bytes, 8)
    let elemCount = WeightTensorReadI32LE(bytes, 12)
    let byteCount = WeightTensorMaterializedShardByteCount(rank, elemCount)
    if IsErr(byteCount):
        return Err[infer.TensorQ](Error(byteCount))
    if rawbytes.BytesLen(bytes) != Value(byteCount):
        return Err[infer.TensorQ]("weight tensor shard file: byte length")
    var shape: int32[]
    var offset: int32
    offset = WeightTensorMaterializedShardHeaderBytes
    for _ in 0..<rank:
        let dim = WeightTensorReadI32LE(bytes, offset)
        if dim <= 0:
            return Err[infer.TensorQ]("weight tensor shard file: dim")
        add(shape, dim)
        offset = offset + 4
    let expectedCount = infer.TensorElementCount(shape)
    if IsErr(expectedCount):
        return Err[infer.TensorQ](Error(expectedCount))
    if Value(expectedCount) != elemCount:
        return Err[infer.TensorQ]("weight tensor shard file: element count")
    var data: int32[]
    for _ in 0..<elemCount:
        add(data, WeightTensorReadI32LE(bytes, offset))
        offset = offset + 4
    var tensor: infer.TensorQ
    let tensorOk = infer.TensorFromDataFill(tensor, shape, scale, data)
    if IsErr(tensorOk):
        return Err[infer.TensorQ](Error(tensorOk))
    return Ok[infer.TensorQ](tensor)

@borrows
fn WeightTensorPayloadWriteMaterializedShardFile(path: str,
                                                 payload: WeightTensorPayload): Result[bool] =
    let payloadOk = WeightTensorPayloadValidate(payload)
    if IsErr(payloadOk):
        return Err[bool](Error(payloadOk))
    if payload.hasPackedInt4:
        return Err[bool]("weight tensor shard file: packed int4 unsupported")
    if payload.hasW4Afp8Raw:
        return Err[bool]("weight tensor shard file: w4afp8 raw unsupported")
    let bytesRes = WeightTensorMaterializedShardBytes(payload.tensor)
    if IsErr(bytesRes):
        return Err[bool](Error(bytesRes))
    var bytes = Value(bytesRes)
    let writeOk = os.WriteFileBytesResult(path, bytes)
    if IsErr(writeOk):
        return Err[bool](Error(writeOk))
    return Ok[bool](true)

fn WeightTensorPayloadReadMaterializedShardFile(binding: weight_binding.WeightShardBinding,
                                                path: str): Result[WeightTensorPayload] =
    if path == "":
        return Err[WeightTensorPayload]("weight tensor shard file: path")
    let readRes = os.ReadFileBytesResult(path)
    if IsErr(readRes):
        return Err[WeightTensorPayload](Error(readRes))
    let tensorRes = WeightTensorMaterializedShardTensor(Value(readRes))
    if IsErr(tensorRes):
        return Err[WeightTensorPayload](Error(tensorRes))
    let payloadRes = WeightTensorPayloadBuild(
        binding.modelCid,
        binding.tensorName,
        binding.shardCid,
        binding.dtype,
        binding.quantScheme,
        binding.peerId,
        Value(tensorRes)
    )
    if IsErr(payloadRes):
        return Err[WeightTensorPayload](Error(payloadRes))
    if Value(payloadRes).payloadHash != binding.payloadHash:
        return Err[WeightTensorPayload]("weight tensor shard file: payload hash")
    return payloadRes

@borrows
fn WeightTensorPayloadClone(payload: WeightTensorPayload): Result[WeightTensorPayload] =
    var tensorCopy: infer.TensorQ
    let tensorOk = infer.TensorFromDataFill(tensorCopy, payload.tensor.shape, payload.tensor.scale, payload.tensor.data)
    if IsErr(tensorOk):
        return Err[WeightTensorPayload](Error(tensorOk))
    var packedShape = infer.InferenceShapeCopy(payload.packedInt4.shape)
    var packedBytes = rawbytes.BytesAlloc(rawbytes.BytesLen(payload.packedInt4.packed))
    if rawbytes.BytesLen(payload.packedInt4.packed) > 0 && packedBytes.data == nil:
        return Err[WeightTensorPayload]("weight tensor store: packed int4 copy")
    rawbytes.BytesCopyInto(packedBytes, 0, payload.packedInt4.packed)
    let packedCopy = kernel_ir.KernelPackedInt4Tensor(
        shape: packedShape,
        scale: payload.packedInt4.scale,
        packed: packedBytes
    )
    var w4Bytes = rawbytes.BytesAlloc(rawbytes.BytesLen(payload.w4Afp8Raw))
    if rawbytes.BytesLen(payload.w4Afp8Raw) > 0 && w4Bytes.data == nil:
        return Err[WeightTensorPayload]("weight tensor store: w4afp8 raw copy")
    rawbytes.BytesCopyInto(w4Bytes, 0, payload.w4Afp8Raw)
    return Ok[WeightTensorPayload](WeightTensorPayload(
        modelCid: strings.CloneStr(payload.modelCid),
        tensorName: strings.CloneStr(payload.tensorName),
        shardCid: strings.CloneStr(payload.shardCid),
        dtype: strings.CloneStr(payload.dtype),
        quantScheme: strings.CloneStr(payload.quantScheme),
        peerId: strings.CloneStr(payload.peerId),
        payloadHash: payload.payloadHash,
        tensor: tensorCopy,
        hasPackedInt4: payload.hasPackedInt4,
        packedInt4Hash: payload.packedInt4Hash,
        packedInt4: packedCopy,
        hasW4Afp8Raw: payload.hasW4Afp8Raw,
        w4Afp8RawHash: payload.w4Afp8RawHash,
        w4Afp8Raw: w4Bytes
    ))

@borrows
fn WeightTensorStoreLoadMaterializedShardFiles(modelCid: str,
                                               bindings: weight_binding.WeightBindingSet,
                                               shardPaths: str[]): Result[WeightTensorStore] =
    if modelCid == "" || modelCid != bindings.modelCid:
        return Err[WeightTensorStore]("weight tensor shard file: model cid")
    if shardPaths.len != bindings.bindings.len:
        return Err[WeightTensorStore]("weight tensor shard file: path count")
    var payloads: WeightTensorPayload[]
    for i in 0..<bindings.bindings.len:
        let payloadRes = WeightTensorPayloadReadMaterializedShardFile(bindings.bindings[i], shardPaths[i])
        if IsErr(payloadRes):
            return Err[WeightTensorStore](Error(payloadRes))
        add(payloads, Value(payloadRes))
    return Ok[WeightTensorStore](WeightTensorStoreBuild(modelCid, payloads))

@borrows
fn WeightTensorPayloadValidate(payload: WeightTensorPayload): Result[bool] =
    if payload.modelCid == "" || payload.tensorName == "" || payload.shardCid == "":
        return Err[bool]("weight tensor store: payload identity")
    if payload.dtype == "" || payload.quantScheme == "" || payload.peerId == "":
        return Err[bool]("weight tensor store: payload metadata")
    if payload.payloadHash <= int64(0):
        return Err[bool]("weight tensor store: payload hash")
    if payload.hasPackedInt4:
        if payload.packedInt4Hash <= int64(0):
            return Err[bool]("weight tensor store: packed int4 hash")
        if payload.dtype != kernel_ir.KernelDtypeInt4 ||
           payload.quantScheme != model_graph.ModelQuantSchemeSymmetricInt4:
            return Err[bool]("weight tensor store: packed int4 metadata")
        let matchOk = WeightTensorPackedInt4MatchesTensor(payload.tensor, payload.packedInt4)
        if IsErr(matchOk):
            return Err[bool](Error(matchOk))
        let packedHash = kernel_ir.KernelIrPackedInt4TensorHash(payload.packedInt4)
        if IsErr(packedHash):
            return Err[bool](Error(packedHash))
        if Value(packedHash) != payload.packedInt4Hash:
            return Err[bool]("weight tensor store: packed int4 hash mismatch")
    elif payload.packedInt4Hash != int64(0):
        return Err[bool]("weight tensor store: unexpected packed int4 hash")
    if payload.hasW4Afp8Raw:
        if payload.w4Afp8RawHash <= int64(0):
            return Err[bool]("weight tensor store: w4afp8 raw hash")
        if payload.dtype != kernel_ir.KernelDtypeInt8 ||
           payload.quantScheme != model_graph.ModelQuantSchemeW4Afp8:
            return Err[bool]("weight tensor store: w4afp8 raw metadata")
        let matchOk = WeightTensorW4Afp8RawMatchesTensor(payload.tensor, payload.w4Afp8Raw)
        if IsErr(matchOk):
            return Err[bool](Error(matchOk))
        let rawHash = WeightTensorRawBytesHash(payload.w4Afp8Raw)
        if IsErr(rawHash):
            return Err[bool](Error(rawHash))
        if Value(rawHash) != payload.w4Afp8RawHash:
            return Err[bool]("weight tensor store: w4afp8 raw hash mismatch")
    elif payload.w4Afp8RawHash != int64(0) || rawbytes.BytesLen(payload.w4Afp8Raw) != 0:
        return Err[bool]("weight tensor store: unexpected w4afp8 raw")
    if payload.hasPackedInt4 && payload.hasW4Afp8Raw:
        return Err[bool]("weight tensor store: mixed raw encodings")
    if payload.dtype == kernel_ir.KernelDtypeInt8 &&
       payload.quantScheme == model_graph.ModelQuantSchemeW4Afp8 &&
       !payload.hasW4Afp8Raw:
        return Err[bool]("weight tensor store: w4afp8 raw required")
    let expected = WeightTensorPayloadHash(payload)
    if IsErr(expected):
        return Err[bool](Error(expected))
    if Value(expected) != payload.payloadHash:
        return Err[bool]("weight tensor store: payload hash mismatch")
    return Ok[bool](true)

@borrows
fn WeightTensorPayloadMatchesBinding(payload: WeightTensorPayload,
                                     binding: weight_binding.WeightShardBinding): bool =
    if payload.modelCid != binding.modelCid:
        return false
    if payload.tensorName != binding.tensorName:
        return false
    if payload.shardCid != binding.shardCid:
        return false
    if payload.dtype != binding.dtype:
        return false
    if payload.quantScheme != binding.quantScheme:
        return false
    if payload.peerId != binding.peerId:
        return false
    if payload.payloadHash != binding.payloadHash:
        return false
    return true

@borrows
fn WeightTensorShapeMatches(left: int32[], right: int32[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn WeightTensorFindPayloadForBinding(store: WeightTensorStore,
                                     binding: weight_binding.WeightShardBinding): int32 =
    var found: int32 = -1
    for i in 0..<store.payloads.len:
        if WeightTensorPayloadMatchesBinding(store.payloads[i], binding):
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn WeightTensorValidateStore(store: WeightTensorStore,
                             bindings: weight_binding.WeightBindingSet,
                             graph: model_graph.ModelGraph): Result[bool] =
    if store.schema != WeightTensorStoreSchema:
        return Err[bool]("weight tensor store: schema")
    if store.modelCid == "" || store.modelCid != graph.modelCid || store.modelCid != bindings.modelCid:
        return Err[bool]("weight tensor store: model cid")
    let graphOk = model_graph.ModelGraphValidate(graph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    let bindingOk = weight_binding.WeightBindingValidate(bindings, graph)
    if IsErr(bindingOk):
        return Err[bool](Error(bindingOk))
    if store.payloads.len != bindings.bindings.len:
        return Err[bool]("weight tensor store: payload count")
    for i in 0..<store.payloads.len:
        let payloadOk = WeightTensorPayloadValidate(store.payloads[i])
        if IsErr(payloadOk):
            return Err[bool](Error(payloadOk))
    for i in 0..<bindings.bindings.len:
        let payloadIndex = WeightTensorFindPayloadForBinding(store, bindings.bindings[i])
        if payloadIndex == -2:
            return Err[bool]("weight tensor store: duplicate payload")
        if payloadIndex < 0:
            return Err[bool]("weight tensor store: missing payload")
        let graphIndex = weight_binding.WeightBindingFindGraphWeight(graph, bindings.bindings[i])
        if graphIndex < 0:
            return Err[bool]("weight tensor store: graph weight")
        if !WeightTensorShapeMatches(store.payloads[payloadIndex].tensor.shape, graph.weights[graphIndex].shape):
            return Err[bool]("weight tensor store: tensor shape")
    if WeightTensorStoreHash(store) != store.storeHash:
        return Err[bool]("weight tensor store: hash mismatch")
    return Ok[bool](true)

@borrows
fn WeightTensorStoreFacts(store: WeightTensorStore): str[] =
    var out: str[]
    add(out, strutil.Join(["weight_tensor_store_schema=", strings.CloneStr(store.schema)], ""))
    add(out, strutil.Join(["weight_tensor_store_model=", strings.CloneStr(store.modelCid)], ""))
    add(out, strutil.Join(["weight_tensor_store_hash=", strings.Int64ToStr(store.storeHash)], ""))
    for i in 0..<store.payloads.len:
        add(out, strutil.Join([
            "weight_tensor_payload=",
            strings.CloneStr(store.payloads[i].tensorName),
            ":",
            strings.CloneStr(store.payloads[i].shardCid),
            ":",
            strings.CloneStr(store.payloads[i].peerId),
            ":",
            strings.Int64ToStr(store.payloads[i].payloadHash)
        ], ""))
        if store.payloads[i].hasPackedInt4:
            add(out, strutil.Join([
                "weight_tensor_packed_int4=",
                strings.CloneStr(store.payloads[i].tensorName),
                ":",
                strings.Int64ToStr(store.payloads[i].packedInt4Hash)
            ], ""))
        if store.payloads[i].hasW4Afp8Raw:
            add(out, strutil.Join([
                "weight_tensor_w4afp8_raw=",
                strings.CloneStr(store.payloads[i].tensorName),
                ":",
                strings.Int64ToStr(store.payloads[i].w4Afp8RawHash)
            ], ""))
    return out
