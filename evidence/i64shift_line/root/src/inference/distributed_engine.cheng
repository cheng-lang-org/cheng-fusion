fn DistributedHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(2097143) + value + int64(67)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn DistributedHashTextWith(hashRaw: int64, text: str): int64 =
    var h: int64 = hashRaw
    for i in 0..<len(text):
        h = DistributedHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn DistributedKernelSetHash(programs: kernel_ir.KernelProgram[]): int64 =
    var h: int64 = int64(67)
    for i in 0..<programs.len:
        h = DistributedHashStep(h, programs[i].kernelHash)
    return h

@borrows
fn DistributedKvShardPayloadHash(receipt: DistributedKvShardReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, DistributedKvShardReceiptSchema)
    h = DistributedHashStep(h, int64(receipt.layerIndex))
    h = DistributedHashTextWith(h, receipt.shardKind)
    h = DistributedHashStep(h, int64(receipt.seqId))
    h = DistributedHashStep(h, int64(receipt.tokenCount))
    h = DistributedHashStep(h, int64(receipt.pageCount))
    h = DistributedHashStep(h, receipt.pageTableHash)
    h = DistributedHashStep(h, receipt.kvStateHash)
    return h

@borrows
fn DistributedKvShardReceiptHash(receipt: DistributedKvShardReceipt): int64 =
    var h: int64 = DistributedKvShardPayloadHash(receipt)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashTextWith(h, receipt.ownerPeerId)
    h = DistributedHashStep(h, receipt.shardHash)
    return h

@borrows
fn DistributedKvShardReceiptSetHash(set: DistributedKvShardReceiptSet): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, set.schema)
    for i in 0..<set.receipts.len:
        h = DistributedHashStep(h, int64(set.receipts[i].layerIndex))
        h = DistributedHashTextWith(h, set.receipts[i].ownerPeerId)
        h = DistributedHashStep(h, set.receipts[i].receiptHash)
    return h

@borrows
fn DistributedBuildKvShardReceipt(layerIndex: int32,
                                  ownerPeerId: str,
                                  kvReceipt: paged_kv_cache.PagedKVReceipt,
                                  kvStateHash: int64): Result[DistributedKvShardReceipt] =
    if layerIndex < 0 || ownerPeerId == "":
        return Err[DistributedKvShardReceipt]("distributed kv shard receipt: identity")
    if kvReceipt.pageCount <= 0 || kvReceipt.tokenCount <= 0 ||
       kvReceipt.pageTableHash <= int64(0) || kvStateHash <= int64(0):
        return Err[DistributedKvShardReceipt]("distributed kv shard receipt: kv")
    var out = DistributedKvShardReceipt(
        schema: DistributedKvShardReceiptSchema,
        layerIndex: layerIndex,
        ownerPeerId: ownerPeerId,
        shardKind: DistributedKvShardKindPagedKvState,
        seqId: kvReceipt.seqId,
        tokenCount: kvReceipt.tokenCount,
        pageCount: kvReceipt.pageCount,
        pageTableHash: kvReceipt.pageTableHash,
        kvStateHash: kvStateHash,
        shardHash: int64(0),
        receiptHash: int64(0)
    )
    out.shardHash = DistributedKvShardPayloadHash(out)
    out.receiptHash = DistributedKvShardReceiptHash(out)
    if out.shardHash <= int64(0) || out.receiptHash <= int64(0):
        return Err[DistributedKvShardReceipt]("distributed kv shard receipt: hash")
    return Ok[DistributedKvShardReceipt](out)

@borrows
fn DistributedBuildKvShardReceiptSet(receipts: DistributedKvShardReceipt[]): Result[DistributedKvShardReceiptSet] =
    if receipts.len <= 0:
        return Err[DistributedKvShardReceiptSet]("distributed kv shard receipt set: empty")
    var out = DistributedKvShardReceiptSet(
        schema: DistributedKvShardReceiptSetSchema,
        receipts: receipts,
        receiptSetHash: int64(0)
    )
    out.receiptSetHash = DistributedKvShardReceiptSetHash(out)
    if out.receiptSetHash <= int64(0):
        return Err[DistributedKvShardReceiptSet]("distributed kv shard receipt set: hash")
    return Ok[DistributedKvShardReceiptSet](out)

fn DistributedKvOwnerPeerId(partition: parallel_plan.InferencePartitionPlan): Result[str] =
    let partitionOk = parallel_plan.ParallelValidatePlan(partition)
    if IsErr(partitionOk):
        return Err[str](Error(partitionOk))
    if partition.tensorShards.len > 0:
        return Ok[str](partition.tensorShards[0].peerId)
    if partition.expertShards.len > 0:
        return Ok[str](partition.expertShards[0].peerId)
    return Err[str]("distributed kv shard receipt: owner")

fn DistributedBuildDefaultKvShardReceiptSet(partition: parallel_plan.InferencePartitionPlan,
                                            kvReceipt: paged_kv_cache.PagedKVReceipt,
                                            kvStateHash: int64): Result[DistributedKvShardReceiptSet] =
    let owner = DistributedKvOwnerPeerId(partition)
    if IsErr(owner):
        return Err[DistributedKvShardReceiptSet](Error(owner))
    let receipt = DistributedBuildKvShardReceipt(0, Value(owner), kvReceipt, kvStateHash)
    if IsErr(receipt):
        return Err[DistributedKvShardReceiptSet](Error(receipt))
    return DistributedBuildKvShardReceiptSet([Value(receipt)])

@borrows
fn DistributedValidateKvShardReceiptSet(set: DistributedKvShardReceiptSet,
                                        kvReceipt: paged_kv_cache.PagedKVReceipt,
                                        kvStateHash: int64,
                                        peers: DistributedInferencePeer[]): Result[bool] =
    if set.schema != DistributedKvShardReceiptSetSchema || set.receipts.len <= 0:
        return Err[bool]("distributed kv shard receipt set: schema")
    var totalTokenCount: int32
    for i in 0..<set.receipts.len:
        let receipt = set.receipts[i]
        if receipt.schema != DistributedKvShardReceiptSchema ||
           receipt.layerIndex != i ||
           receipt.ownerPeerId == "" ||
           receipt.shardKind != DistributedKvShardKindPagedKvState:
            return Err[bool]("distributed kv shard receipt: schema")
        if !DistributedPeerReady(peers, receipt.ownerPeerId):
            return Err[bool]("distributed kv shard receipt: owner")
        if receipt.seqId != kvReceipt.seqId ||
           receipt.tokenCount != kvReceipt.tokenCount ||
           receipt.pageCount != kvReceipt.pageCount ||
           receipt.pageTableHash != kvReceipt.pageTableHash ||
           receipt.kvStateHash != kvStateHash:
            return Err[bool]("distributed kv shard receipt: kv mismatch")
        if receipt.shardHash != DistributedKvShardPayloadHash(receipt):
            return Err[bool]("distributed kv shard receipt: shard hash")
        if receipt.receiptHash != DistributedKvShardReceiptHash(receipt):
            return Err[bool]("distributed kv shard receipt: receipt hash")
        totalTokenCount = totalTokenCount + receipt.tokenCount
    if totalTokenCount <= 0:
        return Err[bool]("distributed kv shard receipt set: token coverage")
    if DistributedKvShardReceiptSetHash(set) != set.receiptSetHash:
        return Err[bool]("distributed kv shard receipt set: hash")
    return Ok[bool](true)

@borrows
fn DistributedKvPagePayloadHash(payload: DistributedKvPagePayload): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, payload.schema)
    h = DistributedHashStep(h, payload.enginePlanHash)
    h = DistributedHashTextWith(h, payload.sourcePeerId)
    h = DistributedHashTextWith(h, payload.targetPeerId)
    h = DistributedHashStep(h, int64(payload.seqId))
    h = DistributedHashStep(h, int64(payload.pageId))
    h = DistributedHashStep(h, int64(payload.pageOrdinal))
    h = DistributedHashStep(h, int64(payload.usedTokens))
    h = DistributedHashStep(h, payload.keyTensorHash)
    h = DistributedHashStep(h, payload.valueTensorHash)
    h = DistributedHashStep(h, payload.keyDataHash)
    h = DistributedHashStep(h, payload.valueDataHash)
    return h

@borrows
fn DistributedKvPagePayloadStoreHash(store: DistributedKvPagePayloadStore): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, store.schema)
    h = DistributedHashStep(h, store.enginePlanHash)
    for i in 0..<store.payloads.len:
        h = DistributedHashStep(h, store.payloads[i].payloadHash)
    return h

@borrows
fn DistributedKvPageTransferExpectedInputHash(plan: DistributedInferencePlan,
                                             ownerPeerId: str,
                                             targetPeerId: str,
                                             pageId: int32,
                                             pageOrdinal: int32,
                                             expectedPayloadHash: int64): Result[int64] =
    if ownerPeerId == "" || targetPeerId == "" || ownerPeerId == targetPeerId:
        return Err[int64]("distributed kv page transfer input: peers")
    if pageId <= 0 || pageOrdinal < 0 || expectedPayloadHash <= int64(0):
        return Err[int64]("distributed kv page transfer input: page")
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, "cheng.inference.distributed_kv_page_transfer_input.v1")
    h = DistributedHashStep(h, plan.engineHash)
    h = DistributedHashStep(h, plan.modelGraph.graphHash)
    h = DistributedHashStep(h, plan.kvReceipt.pageTableHash)
    h = DistributedHashStep(h, plan.kvStateHash)
    h = DistributedHashStep(h, plan.kvShardReceipts.receiptSetHash)
    h = DistributedHashTextWith(h, ownerPeerId)
    h = DistributedHashTextWith(h, targetPeerId)
    h = DistributedHashStep(h, int64(pageId))
    h = DistributedHashStep(h, int64(pageOrdinal))
    h = DistributedHashStep(h, expectedPayloadHash)
    if h <= int64(0):
        return Err[int64]("distributed kv page transfer input: hash")
    return Ok[int64](h)

@borrows
fn DistributedKvShardOwnerReceipt(plan: DistributedInferencePlan): Result[DistributedKvShardReceipt] =
    if plan.kvShardReceipts.schema != DistributedKvShardReceiptSetSchema ||
       plan.kvShardReceipts.receipts.len <= 0:
        return Err[DistributedKvShardReceipt]("distributed kv page transfer: missing shard receipt")
    let receipt = plan.kvShardReceipts.receipts[0]
    if receipt.schema != DistributedKvShardReceiptSchema ||
       receipt.ownerPeerId == "" ||
       receipt.pageTableHash != plan.kvReceipt.pageTableHash ||
       receipt.kvStateHash != plan.kvStateHash:
        return Err[DistributedKvShardReceipt]("distributed kv page transfer: shard receipt")
    return Ok[DistributedKvShardReceipt](receipt)

@borrows
fn DistributedKvPagePayloadBuild(plan: DistributedInferencePlan,
                                 cache: paged_kv_cache.PagedKVCache,
                                 seq: paged_kv_cache.PagedKVSequence,
                                 targetPeerId: str,
                                 pageOrdinal: int32): Result[DistributedKvPagePayload] =
    let ownerReceipt = DistributedKvShardOwnerReceipt(plan)
    if IsErr(ownerReceipt):
        return Err[DistributedKvPagePayload](Error(ownerReceipt))
    let ownerPeerId = Value(ownerReceipt).ownerPeerId
    if targetPeerId == "" || targetPeerId == ownerPeerId:
        return Err[DistributedKvPagePayload]("distributed kv page payload: target")
    if seq.seqId != plan.kvReceipt.seqId ||
       seq.tokenCount != plan.kvReceipt.tokenCount ||
       paged_kv_cache.PagedKVPageTableHash(seq) != plan.kvReceipt.pageTableHash:
        return Err[DistributedKvPagePayload]("distributed kv page payload: sequence")
    if pageOrdinal < 0 || pageOrdinal >= seq.blockPageIds.len:
        return Err[DistributedKvPagePayload]("distributed kv page payload: page ordinal")
    let pageId = seq.blockPageIds[pageOrdinal]
    let pageIndex = paged_kv_cache.PagedKVFindPageIndex(cache, pageId)
    if pageIndex < 0:
        return Err[DistributedKvPagePayload]("distributed kv page payload: page missing")
    let page = cache.pages[pageIndex]
    if page.seqId != seq.seqId || page.pageId != pageId ||
       page.usedTokens < 0 || page.usedTokens > cache.tokensPerPage:
        return Err[DistributedKvPagePayload]("distributed kv page payload: page binding")
    let keyTensor = paged_kv_cache.PagedKVBuildPageKeyTensor(
        page,
        cache.tokensPerPage,
        cache.keyDim,
        cache.keyScale
    )
    if IsErr(keyTensor):
        return Err[DistributedKvPagePayload](Error(keyTensor))
    let valueTensor = paged_kv_cache.PagedKVBuildPageValueTensor(
        page,
        cache.tokensPerPage,
        cache.valueDim,
        cache.valueScale
    )
    if IsErr(valueTensor):
        return Err[DistributedKvPagePayload](Error(valueTensor))
    let keyTensorHash = activation_transport.ActivationTensorHashValue(Value(keyTensor))
    if IsErr(keyTensorHash):
        return Err[DistributedKvPagePayload](Error(keyTensorHash))
    let valueTensorHash = activation_transport.ActivationTensorHashValue(Value(valueTensor))
    if IsErr(valueTensorHash):
        return Err[DistributedKvPagePayload](Error(valueTensorHash))
    var payload = DistributedKvPagePayload(
        schema: DistributedKvPagePayloadSchema,
        enginePlanHash: plan.engineHash,
        sourcePeerId: strings.CloneStr(ownerPeerId),
        targetPeerId: strings.CloneStr(targetPeerId),
        seqId: seq.seqId,
        pageId: pageId,
        pageOrdinal: pageOrdinal,
        usedTokens: page.usedTokens,
        keyTensorHash: Value(keyTensorHash),
        valueTensorHash: Value(valueTensorHash),
        keyDataHash: device.DeviceHashI32(Value(keyTensor).data),
        valueDataHash: device.DeviceHashI32(Value(valueTensor).data),
        payloadHash: int64(0),
        keyTensor: Value(keyTensor),
        valueTensor: Value(valueTensor)
    )
    payload.payloadHash = DistributedKvPagePayloadHash(payload)
    if payload.payloadHash <= int64(0):
        return Err[DistributedKvPagePayload]("distributed kv page payload: hash")
    return Ok[DistributedKvPagePayload](payload)

@borrows
fn DistributedKvPagePayloadMatches(left: DistributedKvPagePayload,
                                   right: DistributedKvPagePayload): bool =
    return left.schema == right.schema &&
           left.enginePlanHash == right.enginePlanHash &&
           left.sourcePeerId == right.sourcePeerId &&
           left.targetPeerId == right.targetPeerId &&
           left.seqId == right.seqId &&
           left.pageId == right.pageId &&
           left.pageOrdinal == right.pageOrdinal &&
           left.usedTokens == right.usedTokens &&
           left.keyTensorHash == right.keyTensorHash &&
           left.valueTensorHash == right.valueTensorHash &&
           left.keyDataHash == right.keyDataHash &&
           left.valueDataHash == right.valueDataHash &&
           left.payloadHash == right.payloadHash

fn DistributedKvPagePayloadStoreBuild(enginePlanHash: int64,
                                      payloads: DistributedKvPagePayload[]): DistributedKvPagePayloadStore =
    var store = DistributedKvPagePayloadStore(
        schema: DistributedKvPagePayloadStoreSchema,
        enginePlanHash: enginePlanHash,
        payloads: payloads,
        storeHash: int64(0)
    )
    store.storeHash = DistributedKvPagePayloadStoreHash(store)
    return store

@borrows
fn DistributedFindKvPagePayload(store: DistributedKvPagePayloadStore,
                                pageOrdinal: int32): int32 =
    var found: int32 = -1
    for i in 0..<store.payloads.len:
        if store.payloads[i].pageOrdinal == pageOrdinal:
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn DistributedValidateKvPagePayloadStore(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[],
                                         cache: paged_kv_cache.PagedKVCache,
                                         seq: paged_kv_cache.PagedKVSequence,
                                         store: DistributedKvPagePayloadStore): Result[bool] =
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[bool](Error(planOk))
    if store.schema != DistributedKvPagePayloadStoreSchema ||
       store.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page payload store: schema")
    if store.payloads.len != plan.kvReceipt.pageCount ||
       store.payloads.len != seq.blockPageIds.len:
        return Err[bool]("distributed kv page payload store: count")
    for i in 0..<store.payloads.len:
        let payload = store.payloads[i]
        if payload.schema != DistributedKvPagePayloadSchema ||
           payload.enginePlanHash != plan.engineHash:
            return Err[bool]("distributed kv page payload: schema")
        let keyTensorHash = activation_transport.ActivationTensorHashValue(payload.keyTensor)
        if IsErr(keyTensorHash):
            return Err[bool](Error(keyTensorHash))
        let valueTensorHash = activation_transport.ActivationTensorHashValue(payload.valueTensor)
        if IsErr(valueTensorHash):
            return Err[bool](Error(valueTensorHash))
        if payload.keyTensorHash != Value(keyTensorHash) ||
           payload.valueTensorHash != Value(valueTensorHash) ||
           payload.keyDataHash != device.DeviceHashI32(payload.keyTensor.data) ||
           payload.valueDataHash != device.DeviceHashI32(payload.valueTensor.data):
            return Err[bool]("distributed kv page payload: tensor hash")
        if !DistributedPeerReady(peers, payload.sourcePeerId) ||
           !DistributedPeerReady(peers, payload.targetPeerId) ||
           payload.sourcePeerId == payload.targetPeerId:
            return Err[bool]("distributed kv page payload: peers")
        if payload.pageOrdinal < 0 || payload.pageOrdinal >= seq.blockPageIds.len ||
           payload.pageId != seq.blockPageIds[payload.pageOrdinal]:
            return Err[bool]("distributed kv page payload: page binding")
        if DistributedKvPagePayloadHash(payload) != payload.payloadHash:
            return Err[bool]("distributed kv page payload: hash")
        let expected = DistributedKvPagePayloadBuild(plan, cache, seq, payload.targetPeerId, payload.pageOrdinal)
        if IsErr(expected):
            return Err[bool](Error(expected))
        if !DistributedKvPagePayloadMatches(payload, Value(expected)):
            return Err[bool]("distributed kv page payload: content drift")
        for j in i + 1..<store.payloads.len:
            if payload.pageOrdinal == store.payloads[j].pageOrdinal ||
               payload.payloadHash == store.payloads[j].payloadHash:
                return Err[bool]("distributed kv page payload store: duplicate")
    if DistributedKvPagePayloadStoreHash(store) != store.storeHash:
        return Err[bool]("distributed kv page payload store: hash")
    return Ok[bool](true)

@borrows
fn DistributedKvPageTransferRequestHash(request: DistributedKvPageTransferRequest): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, request.schema)
    h = DistributedHashStep(h, request.enginePlanHash)
    h = DistributedHashTextWith(h, request.coordinatorPeerId)
    h = DistributedHashTextWith(h, request.ownerPeerId)
    h = DistributedHashTextWith(h, request.targetPeerId)
    h = DistributedHashStep(h, int64(request.seqId))
    h = DistributedHashStep(h, int64(request.pageId))
    h = DistributedHashStep(h, int64(request.pageOrdinal))
    h = DistributedHashStep(h, request.pageTableHash)
    h = DistributedHashStep(h, request.kvShardReceiptHash)
    h = DistributedHashStep(h, request.inputHash)
    h = DistributedHashStep(h, request.expectedPayloadHash)
    return h

fn DistributedKvPageTransferRequestBuild(draft: DistributedKvPageTransferRequest): DistributedKvPageTransferRequest =
    var request = draft
    request.schema = DistributedKvPageTransferRequestSchema
    request.requestHash = int64(0)
