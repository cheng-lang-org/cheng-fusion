@borrows
fn DistributedExecuteHfGlm52DsaMlaMtpAudit(plan: DistributedInferencePlan,
                                           peers: DistributedInferencePeer[],
                                           envelopes: activation_transport.ActivationEnvelope[],
                                           activationStore: activation_transport.ActivationTensorStore,
                                           evidence: DistributedActivationEvidence,
                                           store: weight_store.WeightTensorStore,
                                           tokenIds: infer.TensorQ,
                                           expertCapacity: int32,
                                           elapsedNs: int64): Result[DistributedInferenceRunResult] =
    let ordinaryOk = DistributedRequireOrdinaryDecodeExecution(plan, "hf_glm52_dsa_mla_mtp_audit")
    if IsErr(ordinaryOk):
        return Err[DistributedInferenceRunResult](Error(ordinaryOk))
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedInferenceRunResult](Error(planOk))
    if plan.modelGraph.architecture != model_graph.InferenceModelArchitectureHfGlm52DsaMlaMtp:
        return Err[DistributedInferenceRunResult]("distributed inference glm52 audit: architecture")
    if expertCapacity <= 0:
        return Err[DistributedInferenceRunResult]("distributed inference glm52 audit: expert capacity")
    if elapsedNs <= int64(0):
        return Err[DistributedInferenceRunResult]("distributed inference glm52 audit: elapsed ns")
    let outputRes = model_executor.ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens(
        plan.modelGraph,
        plan.weightBindings,
        store,
        tokenIds,
        expertCapacity
    )
    if IsErr(outputRes):
        return Err[DistributedInferenceRunResult](Error(outputRes))
    let acceptedRes = DistributedAcceptModelExecutorOutput(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence,
        store,
        Value(outputRes),
        elapsedNs
    )
    if IsErr(acceptedRes):
        return Err[DistributedInferenceRunResult](Error(acceptedRes))
    var out = Value(acceptedRes)
    add(out.traceFacts, "distributed_execution_stage=hf_glm52_dsa_mla_mtp_audit")
    add(out.traceFacts, "distributed_execution_runtime=pure_cheng_audit")
    return Ok[DistributedInferenceRunResult](out)

@borrows
fn DistributedGenerateHfGlm52DsaMlaMtpSpecDraftAudit(plan: DistributedInferencePlan,
                                                     peers: DistributedInferencePeer[],
                                                     envelopes: activation_transport.ActivationEnvelope[],
                                                     activationStore: activation_transport.ActivationTensorStore,
                                                     evidence: DistributedActivationEvidence,
                                                     store: weight_store.WeightTensorStore,
                                                     contextTokenIds: infer.TensorQ,
                                                     expertCapacity: int32,
                                                     elapsedNs: int64): Result[DistributedSpecDecodeDraftResult] =
    let specRequired = DistributedRequireHfGlm52MtpSpecDecodeExecution(plan, "hf_glm52_dsa_mla_mtp_spec_draft_audit")
    if IsErr(specRequired):
        return Err[DistributedSpecDecodeDraftResult](Error(specRequired))
    if plan.specDecodePlan.draftTokenCount != 1 ||
       plan.specDecodePlan.draftWindow != 1:
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp spec draft: single-step plan")
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedSpecDecodeDraftResult](Error(planOk))
    if expertCapacity <= 0:
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp spec draft: expert capacity")
    if elapsedNs <= int64(0):
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp spec draft: elapsed ns")
    let contextOk = infer.TensorValidate(contextTokenIds)
    if IsErr(contextOk):
        return Err[DistributedSpecDecodeDraftResult](Error(contextOk))
    if contextTokenIds.shape.len != 1 ||
       contextTokenIds.shape[0] <= 0 ||
       contextTokenIds.shape[0] != plan.routePlan.tokenCount:
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp spec draft: context tokens")
    let weightStoreOk = DistributedValidateWeightStore(plan, store)
    if IsErr(weightStoreOk):
        return Err[DistributedSpecDecodeDraftResult](Error(weightStoreOk))
    let activationStoreOk = activation_transport.ActivationTransportValidateTensorStore(envelopes, activationStore)
    if IsErr(activationStoreOk):
        return Err[DistributedSpecDecodeDraftResult](Error(activationStoreOk))
    let evidenceOk = DistributedValidateActivationEvidence(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence
    )
    if IsErr(evidenceOk):
        return Err[DistributedSpecDecodeDraftResult](Error(evidenceOk))
    let modelOutputRes = model_executor.ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens(
        plan.modelGraph,
        plan.weightBindings,
        store,
        contextTokenIds,
        expertCapacity
    )
    if IsErr(modelOutputRes):
        return Err[DistributedSpecDecodeDraftResult](Error(modelOutputRes))
    let modelOut = Value(modelOutputRes)
    if modelOut.routePlan.routeHash != plan.routePlan.routeHash:
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp spec draft: route hash")
    if modelOut.routePlanSet.routeSetHash != plan.routePlanSet.routeSetHash:
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp spec draft: route set hash")
    let token = DistributedLogitArgmaxRow(modelOut.logits, contextTokenIds.shape[0] - 1)
    if IsErr(token):
        return Err[DistributedSpecDecodeDraftResult](Error(token))
    var draftTokenIds: infer.TensorQ
    var draftShape: int32[]
    add(draftShape, 1)
    draftTokenIds.shape = draftShape
    draftTokenIds.scale = contextTokenIds.scale
    var draftData: int32[]
    add(draftData, Value(token))
    draftTokenIds.data = draftData
    let draftOk = infer.TensorValidate(draftTokenIds)
    if IsErr(draftOk):
        return Err[DistributedSpecDecodeDraftResult](Error(draftOk))
    let contextHash = DistributedTensorOutputHash(contextTokenIds)
    if IsErr(contextHash):
        return Err[DistributedSpecDecodeDraftResult](Error(contextHash))
    let draftHash = DistributedTensorOutputHash(draftTokenIds)
    if IsErr(draftHash):
        return Err[DistributedSpecDecodeDraftResult](Error(draftHash))
    let logitsHash = DistributedTensorOutputHash(modelOut.logits)
    if IsErr(logitsHash):
        return Err[DistributedSpecDecodeDraftResult](Error(logitsHash))
    let modelHash = DistributedModelExecutorOutputHash(modelOut)
    if IsErr(modelHash):
        return Err[DistributedSpecDecodeDraftResult](Error(modelHash))
    let evidenceHashRes = DistributedActivationEvidenceHash(envelopes, activationStore, evidence)
    if IsErr(evidenceHashRes):
        return Err[DistributedSpecDecodeDraftResult](Error(evidenceHashRes))
    let executedReceipt = DistributedBuildReceiptWithOutput(
        plan,
        execution_receipt.InferenceExecutionStatusExecuted,
        store.storeHash,
        Value(evidenceHashRes),
        Value(modelHash),
        elapsedNs
    )
    let receiptOk = execution_receipt.InferenceExecutionReceiptValidate(executedReceipt)
    if IsErr(receiptOk):
        return Err[DistributedSpecDecodeDraftResult](Error(receiptOk))
    var trace = DistributedPlanFacts(plan)
    let weightFacts = weight_store.WeightTensorStoreFacts(store)
    for i in 0..<weightFacts.len:
        add(trace, weightFacts[i])
    let transportFacts = activation_transport.ActivationTransportFacts(envelopes)
    for i in 0..<transportFacts.len:
        add(trace, transportFacts[i])
    let activationStoreFacts = activation_transport.ActivationTensorStoreFacts(activationStore)
    for i in 0..<activationStoreFacts.len:
        add(trace, activationStoreFacts[i])
    add(trace, "distributed_execution_stage=hf_glm52_dsa_mla_mtp_spec_draft")
    add(trace, "distributed_execution_runtime=pure_cheng_audit")
    add(trace, strutil.Join(["distributed_spec_draft_context_hash=", strings.Int64ToStr(Value(contextHash))], ""))
    add(trace, strutil.Join(["distributed_spec_draft_token_hash=", strings.Int64ToStr(Value(draftHash))], ""))
    add(trace, strutil.Join(["distributed_spec_draft_logits_hash=", strings.Int64ToStr(Value(logitsHash))], ""))
    add(trace, strutil.Join(["distributed_spec_draft_model_output_hash=", strings.Int64ToStr(Value(modelHash))], ""))
    add(trace, "distributed_spec_draft_token_count=1")
    let modelFacts = model_executor.ModelExecutorFacts(modelOut)
    for i in 0..<modelFacts.len:
        add(trace, modelFacts[i])
    var result = DistributedSpecDecodeDraftResult(
        schema: DistributedSpecDecodeDraftSchema,
        draftTokenCount: 1,
        contextTokenHash: Value(contextHash),
        draftTokenHash: Value(draftHash),
        draftLogitsHash: Value(logitsHash),
        draftKvStateHash: plan.kvStateHash,
        receiptHash: executedReceipt.receiptHash,
        draftHash: int64(0),
        draftTokenIds: draftTokenIds,
        receipt: executedReceipt,
        traceFacts: trace
    )
    result.draftHash = DistributedSpecDecodeDraftHash(result)
    if result.draftHash <= int64(0):
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp spec draft: hash")
    add(trace, strutil.Join(["distributed_spec_draft_hash=", strings.Int64ToStr(result.draftHash)], ""))
    return Ok[DistributedSpecDecodeDraftResult](DistributedSpecDecodeDraftResult(
        schema: result.schema,
        draftTokenCount: result.draftTokenCount,
        contextTokenHash: result.contextTokenHash,
        draftTokenHash: result.draftTokenHash,
        draftLogitsHash: result.draftLogitsHash,
        draftKvStateHash: result.draftKvStateHash,
        receiptHash: result.receiptHash,
        draftHash: result.draftHash,
        draftTokenIds: result.draftTokenIds,
        receipt: result.receipt,
        traceFacts: trace
    ))

@borrows
fn DistributedGenerateHfGlm52DsaMlaMtpSpecDraftIterativeAudit(plan: DistributedInferencePlan,
                                                              peers: DistributedInferencePeer[],
                                                              envelopes: activation_transport.ActivationEnvelope[],
                                                              activationStore: activation_transport.ActivationTensorStore,
                                                              evidence: DistributedActivationEvidence,
                                                              store: weight_store.WeightTensorStore,
                                                              contextTokenIds: infer.TensorQ,
                                                              stepRouteSets: moe_router.MoeRoutePlanSet[],
                                                              expertCapacity: int32,
                                                              elapsedNs: int64): Result[DistributedSpecDecodeDraftResult] =
    let specRequired = DistributedRequireHfGlm52MtpSpecDecodeExecution(plan, "hf_glm52_dsa_mla_mtp_spec_draft_iterative_audit")
    if IsErr(specRequired):
        return Err[DistributedSpecDecodeDraftResult](Error(specRequired))
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedSpecDecodeDraftResult](Error(planOk))
    if expertCapacity <= 0:
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp iterative draft: expert capacity")
    if elapsedNs <= int64(0):
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp iterative draft: elapsed ns")
    let contextOk = infer.TensorValidate(contextTokenIds)
    if IsErr(contextOk):
        return Err[DistributedSpecDecodeDraftResult](Error(contextOk))
    if contextTokenIds.shape.len != 1 ||
       contextTokenIds.shape[0] <= 0 ||
       contextTokenIds.shape[0] + plan.specDecodePlan.draftTokenCount - 1 != plan.routePlan.tokenCount:
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp iterative draft: context tokens")
    if stepRouteSets.len != plan.specDecodePlan.draftTokenCount:
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp iterative draft: step route set count")
    for i in 0..<stepRouteSets.len:
        let stepRouteOk = moe_router.MoeValidateRoutePlanSet(stepRouteSets[i])
        if IsErr(stepRouteOk):
            return Err[DistributedSpecDecodeDraftResult](Error(stepRouteOk))
    let weightStoreOk = DistributedValidateWeightStore(plan, store)
    if IsErr(weightStoreOk):
        return Err[DistributedSpecDecodeDraftResult](Error(weightStoreOk))
    let activationStoreOk = activation_transport.ActivationTransportValidateTensorStore(envelopes, activationStore)
    if IsErr(activationStoreOk):
        return Err[DistributedSpecDecodeDraftResult](Error(activationStoreOk))
    let evidenceOk = DistributedValidateActivationEvidence(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence
    )
    if IsErr(evidenceOk):
        return Err[DistributedSpecDecodeDraftResult](Error(evidenceOk))
    var trace = DistributedPlanFacts(plan)
    let weightFacts = weight_store.WeightTensorStoreFacts(store)
    for i in 0..<weightFacts.len:
        add(trace, weightFacts[i])
    let transportFacts = activation_transport.ActivationTransportFacts(envelopes)
    for i in 0..<transportFacts.len:
        add(trace, transportFacts[i])
    let activationStoreFacts = activation_transport.ActivationTensorStoreFacts(activationStore)
    for i in 0..<activationStoreFacts.len:
        add(trace, activationStoreFacts[i])
    add(trace, "distributed_execution_stage=hf_glm52_dsa_mla_mtp_spec_draft_iterative")
    add(trace, "distributed_execution_runtime=pure_cheng_audit")
    add(trace, strutil.Join([
        "distributed_spec_draft_token_count=",
        strings.Int64ToStr(int64(plan.specDecodePlan.draftTokenCount))
    ], ""))

    var currentTokenIds = contextTokenIds
    var draftData: int32[]
    var aggregateModelHash: int64 = int64(67)
    var aggregateLogitsHash: int64 = int64(67)
    for step in 0..<plan.specDecodePlan.draftTokenCount:
        let modelOutputRes = model_executor.ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens(
            plan.modelGraph,
            plan.weightBindings,
            store,
            currentTokenIds,
            expertCapacity
        )
        if IsErr(modelOutputRes):
            return Err[DistributedSpecDecodeDraftResult](Error(modelOutputRes))
        let modelOut = Value(modelOutputRes)
        if modelOut.routePlanSet.routeSetHash != stepRouteSets[step].routeSetHash:
            return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp iterative draft: step route set hash")
        if step == plan.specDecodePlan.draftTokenCount - 1:
            if modelOut.routePlan.routeHash != plan.routePlan.routeHash:
                return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp iterative draft: final route hash")
            if modelOut.routePlanSet.routeSetHash != plan.routePlanSet.routeSetHash:
                return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp iterative draft: final route set hash")
        let token = DistributedLogitArgmaxRow(modelOut.logits, currentTokenIds.shape[0] - 1)
        if IsErr(token):
            return Err[DistributedSpecDecodeDraftResult](Error(token))
        add(draftData, Value(token))
        let logitsHash = DistributedTensorOutputHash(modelOut.logits)
        if IsErr(logitsHash):
            return Err[DistributedSpecDecodeDraftResult](Error(logitsHash))
        let modelHash = DistributedModelExecutorOutputHash(modelOut)
        if IsErr(modelHash):
            return Err[DistributedSpecDecodeDraftResult](Error(modelHash))
        aggregateLogitsHash = DistributedHashStep(aggregateLogitsHash, Value(logitsHash))
        aggregateModelHash = DistributedHashStep(aggregateModelHash, Value(modelHash))
        add(trace, strutil.Join([
            "distributed_spec_draft_step=",
            strings.IntToStr(step),
            ":model_output_hash=",
            strings.Int64ToStr(Value(modelHash))
        ], ""))
        add(trace, strutil.Join([
            "distributed_spec_draft_step=",
            strings.IntToStr(step),
            ":route_set_hash=",
            strings.Int64ToStr(modelOut.routePlanSet.routeSetHash)
        ], ""))
        let modelFacts = model_executor.ModelExecutorFacts(modelOut)
        for factIndex in 0..<modelFacts.len:
            add(trace, modelFacts[factIndex])
        if step < plan.specDecodePlan.draftTokenCount - 1:
            var nextTokenIds: infer.TensorQ
            let appendOk = DistributedAppendTokenIdFill(nextTokenIds, currentTokenIds, Value(token))
            if IsErr(appendOk):
                return Err[DistributedSpecDecodeDraftResult](Error(appendOk))
            currentTokenIds = nextTokenIds
    var draftTokenIds: infer.TensorQ
    var draftShape: int32[]
    add(draftShape, plan.specDecodePlan.draftTokenCount)
    draftTokenIds.shape = draftShape
    draftTokenIds.scale = contextTokenIds.scale
    draftTokenIds.data = draftData
    let draftOk = infer.TensorValidate(draftTokenIds)
    if IsErr(draftOk):
        return Err[DistributedSpecDecodeDraftResult](Error(draftOk))
    let contextHash = DistributedTensorOutputHash(contextTokenIds)
    if IsErr(contextHash):
        return Err[DistributedSpecDecodeDraftResult](Error(contextHash))
    let draftHash = DistributedTensorOutputHash(draftTokenIds)
    if IsErr(draftHash):
        return Err[DistributedSpecDecodeDraftResult](Error(draftHash))
    let evidenceHashRes = DistributedActivationEvidenceHash(envelopes, activationStore, evidence)
    if IsErr(evidenceHashRes):
        return Err[DistributedSpecDecodeDraftResult](Error(evidenceHashRes))
    let executedReceipt = DistributedBuildReceiptWithOutput(
        plan,
        execution_receipt.InferenceExecutionStatusExecuted,
        store.storeHash,
        Value(evidenceHashRes),
        aggregateModelHash,
        elapsedNs
    )
    let receiptOk = execution_receipt.InferenceExecutionReceiptValidate(executedReceipt)
    if IsErr(receiptOk):
        return Err[DistributedSpecDecodeDraftResult](Error(receiptOk))
    add(trace, strutil.Join(["distributed_spec_draft_context_hash=", strings.Int64ToStr(Value(contextHash))], ""))
    add(trace, strutil.Join(["distributed_spec_draft_token_hash=", strings.Int64ToStr(Value(draftHash))], ""))
    add(trace, strutil.Join(["distributed_spec_draft_logits_hash=", strings.Int64ToStr(aggregateLogitsHash)], ""))
    add(trace, strutil.Join(["distributed_spec_draft_model_output_hash=", strings.Int64ToStr(aggregateModelHash)], ""))
    var result = DistributedSpecDecodeDraftResult(
        schema: DistributedSpecDecodeDraftSchema,
        draftTokenCount: plan.specDecodePlan.draftTokenCount,
        contextTokenHash: Value(contextHash),
        draftTokenHash: Value(draftHash),
        draftLogitsHash: aggregateLogitsHash,
        draftKvStateHash: plan.kvStateHash,
        receiptHash: executedReceipt.receiptHash,
        draftHash: int64(0),
        draftTokenIds: draftTokenIds,
        receipt: executedReceipt,
        traceFacts: trace
    )
    result.draftHash = DistributedSpecDecodeDraftHash(result)
    if result.draftHash <= int64(0):
        return Err[DistributedSpecDecodeDraftResult]("distributed glm52 mtp iterative draft: hash")
    add(trace, strutil.Join(["distributed_spec_draft_hash=", strings.Int64ToStr(result.draftHash)], ""))
    return Ok[DistributedSpecDecodeDraftResult](DistributedSpecDecodeDraftResult(
        schema: result.schema,
        draftTokenCount: result.draftTokenCount,
        contextTokenHash: result.contextTokenHash,
        draftTokenHash: result.draftTokenHash,
        draftLogitsHash: result.draftLogitsHash,
        draftKvStateHash: result.draftKvStateHash,
        receiptHash: result.receiptHash,
        draftHash: result.draftHash,
        draftTokenIds: result.draftTokenIds,
        receipt: result.receipt,
        traceFacts: trace
    ))

@borrows
fn DistributedExecuteHfGlm52DsaMlaMtpSpecDecodeAudit(plan: DistributedInferencePlan,
                                                     peers: DistributedInferencePeer[],
                                                     envelopes: activation_transport.ActivationEnvelope[],
                                                     activationStore: activation_transport.ActivationTensorStore,
                                                     evidence: DistributedActivationEvidence,
                                                     store: weight_store.WeightTensorStore,
                                                     contextTokenIds: infer.TensorQ,
                                                     draftTokenIds: infer.TensorQ,
                                                     expertCapacity: int32,
                                                     elapsedNs: int64): Result[DistributedInferenceRunResult] =
    let specRequired = DistributedRequireHfGlm52MtpSpecDecodeExecution(plan, "hf_glm52_dsa_mla_mtp_spec_decode_audit")
    if IsErr(specRequired):
        return Err[DistributedInferenceRunResult](Error(specRequired))
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedInferenceRunResult](Error(planOk))
    if expertCapacity <= 0:
        return Err[DistributedInferenceRunResult]("distributed glm52 mtp spec decode: expert capacity")
    if elapsedNs <= int64(0):
        return Err[DistributedInferenceRunResult]("distributed glm52 mtp spec decode: elapsed ns")
    let draftOk = infer.TensorValidate(draftTokenIds)
    if IsErr(draftOk):
        return Err[DistributedInferenceRunResult](Error(draftOk))
    if draftTokenIds.shape.len != 1 ||
       draftTokenIds.shape[0] <= 0 ||
       draftTokenIds.shape[0] > plan.specDecodePlan.draftTokenCount ||
       draftTokenIds.shape[0] > plan.specDecodePlan.draftWindow:
        return Err[DistributedInferenceRunResult]("distributed glm52 mtp spec decode: draft token count")
    let weightStoreOk = DistributedValidateWeightStore(plan, store)
    if IsErr(weightStoreOk):
        return Err[DistributedInferenceRunResult](Error(weightStoreOk))
    let activationStoreOk = activation_transport.ActivationTransportValidateTensorStore(envelopes, activationStore)
    if IsErr(activationStoreOk):
        return Err[DistributedInferenceRunResult](Error(activationStoreOk))
    let evidenceOk = DistributedValidateActivationEvidence(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence
    )
    if IsErr(evidenceOk):
        return Err[DistributedInferenceRunResult](Error(evidenceOk))
    var fullTokenIds: infer.TensorQ
    let fullTokensOk = DistributedConcatTokenIdsFill(fullTokenIds, contextTokenIds, draftTokenIds)
    if IsErr(fullTokensOk):
        return Err[DistributedInferenceRunResult](Error(fullTokensOk))
    if fullTokenIds.shape[0] != plan.routePlan.tokenCount:
        return Err[DistributedInferenceRunResult]("distributed glm52 mtp spec decode: full token count")
    let verifierOutput = model_executor.ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens(
        plan.modelGraph,
        plan.weightBindings,
        store,
        fullTokenIds,
        expertCapacity
    )
    if IsErr(verifierOutput):
        return Err[DistributedInferenceRunResult](Error(verifierOutput))
    let verifier = Value(verifierOutput)
    if verifier.routePlan.routeHash != plan.routePlan.routeHash:
        return Err[DistributedInferenceRunResult]("distributed glm52 mtp spec decode: route hash")
    if verifier.routePlanSet.routeSetHash != plan.routePlanSet.routeSetHash:
        return Err[DistributedInferenceRunResult]("distributed glm52 mtp spec decode: route set hash")
    let verifyRes = DistributedVerifyDraftTokensFromLogits(
        verifier.logits,
        contextTokenIds.shape[0],
        draftTokenIds
    )
    if IsErr(verifyRes):
        return Err[DistributedInferenceRunResult](Error(verifyRes))
    let verify = Value(verifyRes)
    let modelHash = DistributedModelExecutorOutputHash(verifier)
    if IsErr(modelHash):
        return Err[DistributedInferenceRunResult](Error(modelHash))
    let evidenceHashRes = DistributedActivationEvidenceHash(envelopes, activationStore, evidence)
    if IsErr(evidenceHashRes):
        return Err[DistributedInferenceRunResult](Error(evidenceHashRes))
    let executedReceipt = DistributedBuildReceiptWithOutput(
        plan,
        execution_receipt.InferenceExecutionStatusExecuted,
        store.storeHash,
        Value(evidenceHashRes),
        verify.verifyHash,
        elapsedNs
    )
    let receiptOk = execution_receipt.InferenceExecutionReceiptValidate(executedReceipt)
    if IsErr(receiptOk):
        return Err[DistributedInferenceRunResult](Error(receiptOk))
    var trace = DistributedPlanFacts(plan)
    let weightFacts = weight_store.WeightTensorStoreFacts(store)
    for i in 0..<weightFacts.len:
        add(trace, weightFacts[i])
    let transportFacts = activation_transport.ActivationTransportFacts(envelopes)
    for i in 0..<transportFacts.len:
        add(trace, transportFacts[i])
    let activationStoreFacts = activation_transport.ActivationTensorStoreFacts(activationStore)
    for i in 0..<activationStoreFacts.len:
        add(trace, activationStoreFacts[i])
    add(trace, "distributed_execution_stage=hf_glm52_dsa_mla_mtp_spec_decode")
    add(trace, "distributed_execution_runtime=pure_cheng_audit")
    add(trace, strutil.Join(["distributed_spec_decode_verify_hash=", strings.Int64ToStr(verify.verifyHash)], ""))
    add(trace, strutil.Join(["distributed_spec_decode_draft_hash=", strings.Int64ToStr(verify.draftTokenHash)], ""))
    add(trace, strutil.Join(["distributed_spec_decode_verifier_logits_hash=", strings.Int64ToStr(verify.verifierLogitsHash)], ""))
    add(trace, strutil.Join(["distributed_spec_decode_model_output_hash=", strings.Int64ToStr(Value(modelHash))], ""))
    add(trace, strutil.Join(["distributed_spec_decode_accepted_count=", strings.Int64ToStr(int64(verify.acceptedDraftTokenCount))], ""))
    add(trace, strutil.Join(["distributed_spec_decode_emitted_count=", strings.Int64ToStr(int64(verify.emittedTokenCount))], ""))
    add(trace, strutil.Join(["distributed_spec_decode_first_rejected=", strings.Int64ToStr(int64(verify.firstRejectedIndex))], ""))
    add(trace, strutil.Join(["distributed_spec_decode_correction_token=", strings.Int64ToStr(int64(verify.correctionToken))], ""))
    let modelFacts = model_executor.ModelExecutorFacts(verifier)
    for i in 0..<modelFacts.len:
        add(trace, modelFacts[i])
    return Ok[DistributedInferenceRunResult](DistributedInferenceRunResult(
        accepted: true,
        failureReason: "",
        receipt: executedReceipt,
        traceFacts: trace
    ))

@borrows
fn DistributedExecuteHfGlmMoe(plan: DistributedInferencePlan,
                              peers: DistributedInferencePeer[],
                              envelopes: activation_transport.ActivationEnvelope[],
                              activationStore: activation_transport.ActivationTensorStore,
                              evidence: DistributedActivationEvidence,
                              store: weight_store.WeightTensorStore,
                              tokenIds: infer.TensorQ,
                              inputKvState: model_executor.ModelExecutorKvStateSet,
                              hasInputKvState: bool,
                              elapsedNs: int64): Result[DistributedInferenceRunResult] =
    plan
    peers
    envelopes
    activationStore
    evidence
    store
    tokenIds
    inputKvState
    hasInputKvState
    elapsedNs
    return Err[DistributedInferenceRunResult](
        "distributed inference hf glm moe: device execution required; CPU oracle is test-only"
    )

@borrows
fn DistributedExecuteHfGlmMoeMetalQuantized(plan: DistributedInferencePlan,
                                           peers: DistributedInferencePeer[],
                                           envelopes: activation_transport.ActivationEnvelope[],
                                           activationStore: activation_transport.ActivationTensorStore,
                                           evidence: DistributedActivationEvidence,
                                           store: weight_store.WeightTensorStore,
                                           tokenIds: infer.TensorQ,
                                           inputKvState: model_executor.ModelExecutorKvStateSet,
                                           hasInputKvState: bool,
                                           metal: device.Device,
                                           elapsedNs: int64): Result[DistributedInferenceRunResult] =
    let ordinaryOk = DistributedRequireOrdinaryDecodeExecution(plan, "hf_glm_moe_metal_quantized")
    if IsErr(ordinaryOk):
        return Err[DistributedInferenceRunResult](Error(ordinaryOk))
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedInferenceRunResult](Error(planOk))
    if plan.modelGraph.architecture != "hf_glm_moe":
        return Err[DistributedInferenceRunResult]("distributed inference hf glm moe metal: architecture")
    if metal.backend != device.InferenceDeviceBackendMetal || !metal.ready:
        return Err[DistributedInferenceRunResult]("distributed inference hf glm moe metal: device")
    if elapsedNs <= int64(0):
        return Err[DistributedInferenceRunResult]("distributed inference hf glm moe metal: elapsed ns")
    let weightStoreOk = DistributedValidateWeightStore(plan, store)
    if IsErr(weightStoreOk):
        return Err[DistributedInferenceRunResult](Error(weightStoreOk))
    let activationStoreOk = activation_transport.ActivationTransportValidateTensorStore(envelopes, activationStore)
    if IsErr(activationStoreOk):
        return Err[DistributedInferenceRunResult](Error(activationStoreOk))
    let evidenceOk = DistributedValidateActivationEvidence(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence
    )
    if IsErr(evidenceOk):
        return Err[DistributedInferenceRunResult](Error(evidenceOk))
    let outputRes = model_executor.ModelExecutorExecuteHfGlmMoeTokensWithKvStateMetalQuantized(
        plan.modelGraph,
        plan.weightBindings,
        store,
        tokenIds,
        plan.routePlanSet,
        inputKvState,
        hasInputKvState,
        metal
    )
    if IsErr(outputRes):
        return Err[DistributedInferenceRunResult](Error(outputRes))
    let modelOutputWithKv = Value(outputRes)
    if modelOutputWithKv.kvStateSet.stateSetHash != plan.kvStateHash:
        return Err[DistributedInferenceRunResult]("distributed inference hf glm moe metal: kv state hash")
    let acceptedRes = DistributedAcceptOutputTensor(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence,
        store,
        modelOutputWithKv.output.logits,
        elapsedNs
    )
    if IsErr(acceptedRes):
        return Err[DistributedInferenceRunResult](Error(acceptedRes))
    var out = Value(acceptedRes)
    add(out.traceFacts, "distributed_execution_stage=hf_glm_moe")
    add(out.traceFacts, "distributed_execution_device=metal_quantized")
    add(out.traceFacts, strutil.Join(["distributed_model_kv_state_hash=", strings.Int64ToStr(modelOutputWithKv.kvStateSet.stateSetHash)], ""))
    let modelFacts = model_executor.ModelExecutorFacts(modelOutputWithKv.output)
    for i in 0..<modelFacts.len:
        add(out.traceFacts, modelFacts[i])
    return Ok[DistributedInferenceRunResult](out)

fn DistributedExecuteHfGlmMoeMetalPackedInt4(plan: DistributedInferencePlan,
                                             peers: DistributedInferencePeer[],
                                             envelopes: activation_transport.ActivationEnvelope[],
                                             activationStore: activation_transport.ActivationTensorStore,
                                             evidence: DistributedActivationEvidence,
                                             store: weight_store.WeightTensorStore,
                                             tokenIds: infer.TensorQ,
                                             inputKvState: model_executor.ModelExecutorKvStateSet,
                                             hasInputKvState: bool,
                                             metal: device.Device,
                                             elapsedNs: int64): Result[DistributedInferenceRunResult] =
    return DistributedExecuteHfGlmMoeMetalQuantized(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence,
        store,
        tokenIds,
        inputKvState,
        hasInputKvState,
        metal,
        elapsedNs
    )

@borrows
fn DistributedGenerateHfGlmMoeSpecDraftMetalPackedInt4(plan: DistributedInferencePlan,
                                                       peers: DistributedInferencePeer[],
                                                       envelopes: activation_transport.ActivationEnvelope[],
                                                       activationStore: activation_transport.ActivationTensorStore,
                                                       evidence: DistributedActivationEvidence,
                                                       store: weight_store.WeightTensorStore,
                                                       contextTokenIds: infer.TensorQ,
                                                       inputKvState: model_executor.ModelExecutorKvStateSet,
                                                       hasInputKvState: bool,
                                                       metal: device.Device,
                                                       elapsedNs: int64): Result[DistributedSpecDecodeDraftResult] =
    let specRequired = DistributedRequireSpecDecodeExecution(plan, "hf_glm_moe_spec_draft_metal_packed_int4")
    if IsErr(specRequired):
        return Err[DistributedSpecDecodeDraftResult](Error(specRequired))
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedSpecDecodeDraftResult](Error(planOk))
    if plan.modelGraph.architecture != "hf_glm_moe":
        return Err[DistributedSpecDecodeDraftResult]("distributed spec draft hf glm moe metal: architecture")
    if plan.specDecodePlan.mtpLayerCount != 1:
        return Err[DistributedSpecDecodeDraftResult]("distributed spec draft hf glm moe metal: single-step mtp required")
    if metal.backend != device.InferenceDeviceBackendMetal || !metal.ready:
        return Err[DistributedSpecDecodeDraftResult]("distributed spec draft hf glm moe metal: device")
    if elapsedNs <= int64(0):
        return Err[DistributedSpecDecodeDraftResult]("distributed spec draft hf glm moe metal: elapsed ns")
    if hasInputKvState:
        return Err[DistributedSpecDecodeDraftResult]("distributed spec draft hf glm moe metal: input kv unsupported")
    let contextOk = infer.TensorValidate(contextTokenIds)
    if IsErr(contextOk):
        return Err[DistributedSpecDecodeDraftResult](Error(contextOk))
    if contextTokenIds.shape.len != 1 ||
       contextTokenIds.shape[0] <= 0 ||
       contextTokenIds.shape[0] != plan.routePlan.tokenCount:
        return Err[DistributedSpecDecodeDraftResult]("distributed spec draft hf glm moe metal: context tokens")
    let weightStoreOk = DistributedValidateWeightStore(plan, store)
    if IsErr(weightStoreOk):
        return Err[DistributedSpecDecodeDraftResult](Error(weightStoreOk))
    let activationStoreOk = activation_transport.ActivationTransportValidateTensorStore(envelopes, activationStore)
    if IsErr(activationStoreOk):
        return Err[DistributedSpecDecodeDraftResult](Error(activationStoreOk))
    let evidenceOk = DistributedValidateActivationEvidence(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence
    )
    if IsErr(evidenceOk):
        return Err[DistributedSpecDecodeDraftResult](Error(evidenceOk))
    let draftOutput = model_executor.ModelExecutorExecuteHfGlmMoeTokensWithKvStateMetalPackedInt4(
        plan.modelGraph,
        plan.weightBindings,
        store,
        contextTokenIds,
        plan.routePlanSet,
        inputKvState,
        hasInputKvState,
        metal
    )
    if IsErr(draftOutput):
        return Err[DistributedSpecDecodeDraftResult](Error(draftOutput))
    let modelOut = Value(draftOutput)
    if modelOut.kvStateSet.stateSetHash != plan.kvStateHash:
        return Err[DistributedSpecDecodeDraftResult]("distributed spec draft hf glm moe metal: kv state hash")
    let token = DistributedLogitArgmaxRow(modelOut.output.logits, contextTokenIds.shape[0] - 1)
    if IsErr(token):
        return Err[DistributedSpecDecodeDraftResult](Error(token))
    var draftTokenIds: infer.TensorQ
    var draftShape: int32[]
    add(draftShape, 1)
    draftTokenIds.shape = draftShape
    draftTokenIds.scale = contextTokenIds.scale
    var draftData: int32[]
    add(draftData, Value(token))
    draftTokenIds.data = draftData
    let draftOk = infer.TensorValidate(draftTokenIds)
    if IsErr(draftOk):
        return Err[DistributedSpecDecodeDraftResult](Error(draftOk))
    let contextHash = DistributedTensorOutputHash(contextTokenIds)
    if IsErr(contextHash):
        return Err[DistributedSpecDecodeDraftResult](Error(contextHash))
    let draftHash = DistributedTensorOutputHash(draftTokenIds)
    if IsErr(draftHash):
        return Err[DistributedSpecDecodeDraftResult](Error(draftHash))
    let logitsHash = DistributedTensorOutputHash(modelOut.output.logits)
    if IsErr(logitsHash):
        return Err[DistributedSpecDecodeDraftResult](Error(logitsHash))
    let evidenceHashRes = DistributedActivationEvidenceHash(envelopes, activationStore, evidence)
    if IsErr(evidenceHashRes):
        return Err[DistributedSpecDecodeDraftResult](Error(evidenceHashRes))
    let executedReceipt = DistributedBuildReceiptWithOutput(
        plan,
        execution_receipt.InferenceExecutionStatusExecuted,
        store.storeHash,
        Value(evidenceHashRes),
        Value(draftHash),
        elapsedNs
    )
    let receiptOk = execution_receipt.InferenceExecutionReceiptValidate(executedReceipt)
    if IsErr(receiptOk):
        return Err[DistributedSpecDecodeDraftResult](Error(receiptOk))
    var trace = DistributedPlanFacts(plan)
    let weightFacts = weight_store.WeightTensorStoreFacts(store)
    for i in 0..<weightFacts.len:
        add(trace, weightFacts[i])
    let transportFacts = activation_transport.ActivationTransportFacts(envelopes)
    for i in 0..<transportFacts.len:
        add(trace, transportFacts[i])
    let activationStoreFacts = activation_transport.ActivationTensorStoreFacts(activationStore)
    for i in 0..<activationStoreFacts.len:
        add(trace, activationStoreFacts[i])
    add(trace, "distributed_execution_stage=hf_glm_moe_spec_draft")
    add(trace, "distributed_execution_device=metal_packed_int4")
    add(trace, strutil.Join(["distributed_spec_draft_context_hash=", strings.Int64ToStr(Value(contextHash))], ""))
    add(trace, strutil.Join(["distributed_spec_draft_token_hash=", strings.Int64ToStr(Value(draftHash))], ""))
    add(trace, strutil.Join(["distributed_spec_draft_logits_hash=", strings.Int64ToStr(Value(logitsHash))], ""))
    add(trace, strutil.Join(["distributed_spec_draft_token_count=1"], ""))
    add(trace, strutil.Join(["distributed_model_kv_state_hash=", strings.Int64ToStr(modelOut.kvStateSet.stateSetHash)], ""))
    let modelFacts = model_executor.ModelExecutorFacts(modelOut.output)
    for i in 0..<modelFacts.len:
        add(trace, modelFacts[i])
    var result = DistributedSpecDecodeDraftResult(
        schema: DistributedSpecDecodeDraftSchema,
        draftTokenCount: 1,
        contextTokenHash: Value(contextHash),
        draftTokenHash: Value(draftHash),
        draftLogitsHash: Value(logitsHash),
        draftKvStateHash: modelOut.kvStateSet.stateSetHash,
        receiptHash: executedReceipt.receiptHash,
        draftHash: int64(0),
        draftTokenIds: draftTokenIds,
        receipt: executedReceipt,
        traceFacts: trace
    )
    result.draftHash = DistributedSpecDecodeDraftHash(result)
    if result.draftHash <= int64(0):
        return Err[DistributedSpecDecodeDraftResult]("distributed spec draft hf glm moe metal: hash")
    add(trace, strutil.Join(["distributed_spec_draft_hash=", strings.Int64ToStr(result.draftHash)], ""))
    return Ok[DistributedSpecDecodeDraftResult](DistributedSpecDecodeDraftResult(
        schema: result.schema,
        draftTokenCount: result.draftTokenCount,
        contextTokenHash: result.contextTokenHash,
        draftTokenHash: result.draftTokenHash,
        draftLogitsHash: result.draftLogitsHash,
        draftKvStateHash: result.draftKvStateHash,
        receiptHash: result.receiptHash,
        draftHash: result.draftHash,
        draftTokenIds: result.draftTokenIds,
        receipt: result.receipt,
        traceFacts: trace
    ))

@borrows
fn DistributedExecuteHfGlmMoeSpecDecodeMetalPackedInt4(plan: DistributedInferencePlan,
                                                       peers: DistributedInferencePeer[],
                                                       envelopes: activation_transport.ActivationEnvelope[],
                                                       activationStore: activation_transport.ActivationTensorStore,
                                                       evidence: DistributedActivationEvidence,
                                                       store: weight_store.WeightTensorStore,
                                                       contextTokenIds: infer.TensorQ,
                                                       draftTokenIds: infer.TensorQ,
                                                       inputKvState: model_executor.ModelExecutorKvStateSet,
                                                       hasInputKvState: bool,
                                                       metal: device.Device,
                                                       elapsedNs: int64): Result[DistributedInferenceRunResult] =
    let specRequired = DistributedRequireSpecDecodeExecution(plan, "hf_glm_moe_spec_decode_metal_packed_int4")
    if IsErr(specRequired):
        return Err[DistributedInferenceRunResult](Error(specRequired))
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedInferenceRunResult](Error(planOk))
    if plan.modelGraph.architecture != "hf_glm_moe":
        return Err[DistributedInferenceRunResult]("distributed spec decode hf glm moe metal: architecture")
    if metal.backend != device.InferenceDeviceBackendMetal || !metal.ready:
        return Err[DistributedInferenceRunResult]("distributed spec decode hf glm moe metal: device")
    if elapsedNs <= int64(0):
        return Err[DistributedInferenceRunResult]("distributed spec decode hf glm moe metal: elapsed ns")
    if hasInputKvState:
        return Err[DistributedInferenceRunResult]("distributed spec decode hf glm moe metal: input kv unsupported")
    let draftOk = infer.TensorValidate(draftTokenIds)
    if IsErr(draftOk):
        return Err[DistributedInferenceRunResult](Error(draftOk))
    if draftTokenIds.shape.len != 1 ||
       draftTokenIds.shape[0] <= 0 ||
       draftTokenIds.shape[0] > plan.specDecodePlan.draftTokenCount ||
       draftTokenIds.shape[0] > plan.specDecodePlan.draftWindow:
        return Err[DistributedInferenceRunResult]("distributed spec decode hf glm moe metal: draft token count")
    let weightStoreOk = DistributedValidateWeightStore(plan, store)
    if IsErr(weightStoreOk):
        return Err[DistributedInferenceRunResult](Error(weightStoreOk))
    let activationStoreOk = activation_transport.ActivationTransportValidateTensorStore(envelopes, activationStore)
    if IsErr(activationStoreOk):
        return Err[DistributedInferenceRunResult](Error(activationStoreOk))
    let evidenceOk = DistributedValidateActivationEvidence(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence
    )
    if IsErr(evidenceOk):
        return Err[DistributedInferenceRunResult](Error(evidenceOk))
    var fullTokenIds: infer.TensorQ
    let fullTokensOk = DistributedConcatTokenIdsFill(fullTokenIds, contextTokenIds, draftTokenIds)
    if IsErr(fullTokensOk):
        return Err[DistributedInferenceRunResult](Error(fullTokensOk))
    let verifierOutput = model_executor.ModelExecutorExecuteHfGlmMoeTokensWithKvStateMetalPackedInt4(
        plan.modelGraph,
        plan.weightBindings,
        store,
        fullTokenIds,
        plan.routePlanSet,
        inputKvState,
        hasInputKvState,
        metal
    )
    if IsErr(verifierOutput):
        return Err[DistributedInferenceRunResult](Error(verifierOutput))
    let verifier = Value(verifierOutput)
    if verifier.kvStateSet.stateSetHash != plan.kvStateHash:
        return Err[DistributedInferenceRunResult]("distributed spec decode hf glm moe metal: kv state hash")
    let verifyRes = DistributedVerifyDraftTokensFromLogits(
        verifier.output.logits,
        contextTokenIds.shape[0],
        draftTokenIds
    )
    if IsErr(verifyRes):
        return Err[DistributedInferenceRunResult](Error(verifyRes))
    let verify = Value(verifyRes)
    let evidenceHashRes = DistributedActivationEvidenceHash(envelopes, activationStore, evidence)
    if IsErr(evidenceHashRes):
        return Err[DistributedInferenceRunResult](Error(evidenceHashRes))
    let executedReceipt = DistributedBuildReceiptWithOutput(
        plan,
        execution_receipt.InferenceExecutionStatusExecuted,
        store.storeHash,
        Value(evidenceHashRes),
        verify.outputTokenHash,
        elapsedNs
    )
    let receiptOk = execution_receipt.InferenceExecutionReceiptValidate(DistributedInferenceExecutionReceiptClone(executedReceipt))
    if IsErr(receiptOk):
        return Err[DistributedInferenceRunResult](Error(receiptOk))
    var trace = DistributedPlanFacts(plan)
    let weightFacts = weight_store.WeightTensorStoreFacts(store)
    for i in 0..<weightFacts.len:
        add(trace, share(weightFacts[i]))
    let transportFacts = activation_transport.ActivationTransportFacts(envelopes)
    for i in 0..<transportFacts.len:
        add(trace, share(transportFacts[i]))
    let activationStoreFacts = activation_transport.ActivationTensorStoreFacts(activationStore)
    for i in 0..<activationStoreFacts.len:
        add(trace, share(activationStoreFacts[i]))
    add(trace, "distributed_execution_stage=hf_glm_moe_spec_decode")
    add(trace, "distributed_execution_device=metal_packed_int4")
    add(trace, strutil.Join(["distributed_spec_decode_verify_hash=", strings.Int64ToStr(verify.verifyHash)], ""))
    add(trace, strutil.Join(["distributed_spec_decode_draft_hash=", strings.Int64ToStr(verify.draftTokenHash)], ""))
    add(trace, strutil.Join(["distributed_spec_decode_verifier_logits_hash=", strings.Int64ToStr(verify.verifierLogitsHash)], ""))
    add(trace, strutil.Join(["distributed_spec_decode_accepted_count=", strings.Int64ToStr(int64(verify.acceptedDraftTokenCount))], ""))
    add(trace, strutil.Join(["distributed_spec_decode_emitted_count=", strings.Int64ToStr(int64(verify.emittedTokenCount))], ""))
    add(trace, strutil.Join(["distributed_spec_decode_first_rejected=", strings.Int64ToStr(int64(verify.firstRejectedIndex))], ""))
    add(trace, strutil.Join(["distributed_spec_decode_correction_token=", strings.Int64ToStr(int64(verify.correctionToken))], ""))
    add(trace, strutil.Join(["distributed_model_kv_state_hash=", strings.Int64ToStr(verifier.kvStateSet.stateSetHash)], ""))
    let modelFacts = model_executor.ModelExecutorFacts(verifier.output)
    for i in 0..<modelFacts.len:
        add(trace, share(modelFacts[i]))
    return Ok[DistributedInferenceRunResult](DistributedInferenceRunResult(
        accepted: true,
        failureReason: "",
        receipt: executedReceipt,
        traceFacts: trace
    ))


fn DistributedSpecDecodePlanBuildDflash2(draftWindow: int32,
                                         draftTokenCount: int32): Result[DistributedSpecDecodePlan] =
    if draftWindow <= 0 || draftTokenCount <= 0 || draftWindow < draftTokenCount:
        return Err[DistributedSpecDecodePlan]("distributed spec decode: dflash2 shape")
    let probeHash = DistributedSpecDecodePlanHash(DistributedSpecDecodePlan(
        schema: DistributedSpecDecodePlanSchema,
        algorithm: DistributedSpecDecodeAlgorithmDflash2,
        draftWindow: draftWindow,
        draftTokenCount: draftTokenCount,
        mtpLayerCount: int32(0),
        planHash: int64(0)
    ))
    if probeHash <= int64(0):
        return Err[DistributedSpecDecodePlan]("distributed spec decode: dflash2 hash")
    return Ok[DistributedSpecDecodePlan](DistributedSpecDecodePlan(
        schema: DistributedSpecDecodePlanSchema,
        algorithm: DistributedSpecDecodeAlgorithmDflash2,
        draftWindow: draftWindow,
        draftTokenCount: draftTokenCount,
        mtpLayerCount: int32(0),
        planHash: probeHash
    ))

fn DistributedRequireArchitectureDflash2SpecDecodeExecution(plan: DistributedInferencePlan,
                                                            stage: str,
                                                            expectedArchitecture: str): Result[bool] =
    let specPlan = plan.specDecodePlan
    let architectureMatches = plan.modelGraph.architecture == expectedArchitecture
    let schemaMatches = specPlan.schema == DistributedSpecDecodePlanSchema
    let algorithmMatches = specPlan.algorithm == DistributedSpecDecodeAlgorithmDflash2
    let mtpLayerCount = specPlan.mtpLayerCount
    let draftTokenCount = specPlan.draftTokenCount
    let draftWindow = specPlan.draftWindow
    let storedPlanHash = specPlan.planHash
    if !architectureMatches:
        return Err[bool](strutil.Join([
            "distributed ",
            expectedArchitecture,
            " dflash2 spec decode: architecture"
        ], ""))
    if !schemaMatches || !algorithmMatches:
        return Err[bool](strutil.Join([
            "distributed ",
            expectedArchitecture,
            " dflash2 spec decode: algorithm"
        ], ""))
    if mtpLayerCount != 0 ||
       draftTokenCount <= 0 ||
       draftWindow < draftTokenCount:
        return Err[bool](strutil.Join([
            "distributed ",
            expectedArchitecture,
            " dflash2 spec decode: draft window"
        ], ""))
    let expectedHash = DistributedSpecDecodePlanHash(DistributedSpecDecodePlan(
        schema: DistributedSpecDecodePlanSchema,
        algorithm: DistributedSpecDecodeAlgorithmDflash2,
        draftWindow: draftWindow,
        draftTokenCount: draftTokenCount,
        mtpLayerCount: int32(0),
        planHash: int64(0)
    ))
    if expectedHash <= int64(0) || expectedHash != storedPlanHash:
        return Err[bool](strutil.Join([
            "distributed ",
            expectedArchitecture,
            " dflash2 spec decode: plan hash"
        ], ""))
    if len(stage) <= 0:
        return Err[bool]("distributed spec decode: stage")
    return Ok[bool](true)

fn DistributedSpecDecodeVerifyGreedyFromArgmax(draftTokenIds: infer.TensorQ,
                                               verifierArgmaxIds: int32[]): Result[DistributedSpecDecodeVerifyResult] =
    let draftOk = infer.TensorValidate(draftTokenIds)
    if IsErr(draftOk):
        return Err[DistributedSpecDecodeVerifyResult](Error(draftOk))
    if draftTokenIds.shape.len != 1 || draftTokenIds.shape[0] <= 0:
        return Err[DistributedSpecDecodeVerifyResult]("distributed spec decode: draft tokens")
    if verifierArgmaxIds.len < draftTokenIds.shape[0]:
        return Err[DistributedSpecDecodeVerifyResult]("distributed spec decode: verifier argmax count")
    var emitted: int32[]
    var acceptedCount: int32
    var firstRejected: int32 = -1
    var correctionToken: int32 = -1
    for draftIndex in 0..<draftTokenIds.shape[0]:
        let predicted = verifierArgmaxIds[draftIndex]
        if predicted < 0:
            return Err[DistributedSpecDecodeVerifyResult]("distributed spec decode: verifier argmax domain")
        if predicted == draftTokenIds.data[draftIndex]:
            add(emitted, draftTokenIds.data[draftIndex])
            acceptedCount = acceptedCount + 1
        else:
            firstRejected = draftIndex
            correctionToken = predicted
            add(emitted, correctionToken)
            break
    var argmaxTensor: infer.TensorQ
    let argmaxFillOk = infer.TensorFromDataFill(
        argmaxTensor,
        [verifierArgmaxIds.len],
        draftTokenIds.scale,
        verifierArgmaxIds
    )
    if IsErr(argmaxFillOk):
        return Err[DistributedSpecDecodeVerifyResult](Error(argmaxFillOk))
    var emittedForHash: int32[]
    for i in 0..<emitted.len:
        add(emittedForHash, emitted[i])
    var outputHashTensor: infer.TensorQ
    let outputHashFillOk = infer.TensorFromDataFill(
        outputHashTensor,
        [emitted.len],
        draftTokenIds.scale,
        emittedForHash
    )
    if IsErr(outputHashFillOk):
        return Err[DistributedSpecDecodeVerifyResult](Error(outputHashFillOk))
    var outputTokens: infer.TensorQ
    var outputShape: int32[]
    add(outputShape, emitted.len)
    outputTokens.shape = outputShape
    outputTokens.scale = draftTokenIds.scale
    outputTokens.data = emitted
    let emittedCount: int32 = outputTokens.shape[0]
    let outputScale: int32 = draftTokenIds.scale
    var emittedForReturn: int32[]
    for i in 0..<emitted.len:
        add(emittedForReturn, emitted[i])
    let outputOk = infer.TensorValidate(outputTokens)
    if IsErr(outputOk):
        return Err[DistributedSpecDecodeVerifyResult](Error(outputOk))
    let draftHash = DistributedTensorOutputHash(draftTokenIds)
    if IsErr(draftHash):
        return Err[DistributedSpecDecodeVerifyResult](Error(draftHash))
    let argmaxHash = DistributedTensorOutputHash(argmaxTensor)
    if IsErr(argmaxHash):
        return Err[DistributedSpecDecodeVerifyResult](Error(argmaxHash))
    let outputHash = DistributedTensorOutputHash(outputHashTensor)
    if IsErr(outputHash):
        return Err[DistributedSpecDecodeVerifyResult](Error(outputHash))
    var verifyProbe = DistributedSpecDecodeVerifyResult(
        schema: DistributedSpecDecodeVerifySchema,
        acceptedDraftTokenCount: acceptedCount,
        emittedTokenCount: emittedCount,
        firstRejectedIndex: firstRejected,
        correctionToken: correctionToken,
        draftTokenHash: Value(draftHash),
        verifierLogitsHash: Value(argmaxHash),
        outputTokenHash: Value(outputHash),
        verifyHash: int64(0),
        outputTokens: outputTokens
    )
    let computedVerifyHash = DistributedSpecDecodeVerifyHash(verifyProbe)
    if computedVerifyHash <= int64(0):
        return Err[DistributedSpecDecodeVerifyResult]("distributed spec decode: verify hash")
    var returnedTokens: infer.TensorQ
    var returnedShape: int32[]
    add(returnedShape, emittedCount)
    returnedTokens.shape = returnedShape
    returnedTokens.scale = outputScale
    returnedTokens.data = emittedForReturn
    return Ok[DistributedSpecDecodeVerifyResult](DistributedSpecDecodeVerifyResult(
        schema: DistributedSpecDecodeVerifySchema,
        acceptedDraftTokenCount: acceptedCount,
        emittedTokenCount: emittedCount,
        firstRejectedIndex: firstRejected,
        correctionToken: correctionToken,
        draftTokenHash: Value(draftHash),
        verifierLogitsHash: Value(argmaxHash),
        outputTokenHash: Value(outputHash),
        verifyHash: computedVerifyHash,
        outputTokens: returnedTokens
    ))

# ── Deep-clone helpers for ownership-isolated test fixtures (borrow in, owned out) ──

@borrows
fn DistributedKvResidencyEntryClone(entry: DistributedKvPageResidencyEntry): DistributedKvPageResidencyEntry =
    return DistributedKvPageResidencyEntry(
        schema: strings.CloneStr(entry.schema),
        enginePlanHash: entry.enginePlanHash,
        ownerPeerId: strings.CloneStr(entry.ownerPeerId),
        targetPeerId: strings.CloneStr(entry.targetPeerId),
        seqId: entry.seqId,
        pageId: entry.pageId,
        pageOrdinal: entry.pageOrdinal,
        payloadHash: entry.payloadHash,
        requestHash: entry.requestHash,
        responseHash: entry.responseHash,
        transferReceiptHash: entry.transferReceiptHash,
        requestFrameHash: entry.requestFrameHash,
        responseFrameHash: entry.responseFrameHash,
        residentSinceNs: entry.residentSinceNs,
        validUntilNs: entry.validUntilNs,
        entryHash: entry.entryHash
    )

@borrows
fn DistributedKvResidencyStoreClone(store: DistributedKvResidencyStore): DistributedKvResidencyStore =
    var activeEntries: DistributedKvPageResidencyEntry[]
    for i in 0..<store.activeEntries.len:
        add(activeEntries, DistributedKvResidencyEntryClone(store.activeEntries[i]))
    var operationHashes: int64[]
    for i in 0..<store.operationHashes.len:
        add(operationHashes, store.operationHashes[i])
    return DistributedKvResidencyStore(
        schema: strings.CloneStr(store.schema),
        enginePlanHash: store.enginePlanHash,
        targetPeerId: strings.CloneStr(store.targetPeerId),
        maxResidentPages: store.maxResidentPages,
        updatedAtNs: store.updatedAtNs,
        activeEntryCount: store.activeEntryCount,
        activeEntrySetHash: store.activeEntrySetHash,
        operationSetHash: store.operationSetHash,
        storeHash: store.storeHash,
        activeEntries: activeEntries,
        operationHashes: operationHashes
    )

@borrows
fn DistributedKvResidencyStoreOperationClone(operation: DistributedKvResidencyStoreOperation): DistributedKvResidencyStoreOperation =
    return DistributedKvResidencyStoreOperation(
        schema: strings.CloneStr(operation.schema),
        enginePlanHash: operation.enginePlanHash,
        targetPeerId: strings.CloneStr(operation.targetPeerId),
        previousStoreHash: operation.previousStoreHash,
        scheduleHash: operation.scheduleHash,
        transferResidencyReceiptHash: operation.transferResidencyReceiptHash,
        newActiveEntrySetHash: operation.newActiveEntrySetHash,
        appliedAtNs: operation.appliedAtNs,
        reusedPageCount: operation.reusedPageCount,
        transferredPageCount: operation.transferredPageCount,
        evictedPageCount: operation.evictedPageCount,
        finalResidentPageCount: operation.finalResidentPageCount,
        operationHash: operation.operationHash
    )

