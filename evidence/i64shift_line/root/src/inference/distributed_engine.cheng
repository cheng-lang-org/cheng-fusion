@borrows
fn DistributedInferenceRunResultClone(run: DistributedInferenceRunResult): DistributedInferenceRunResult =
    var traceFactsCopy: str[]
    for i in 0..<run.traceFacts.len:
        add(traceFactsCopy, strings.CloneStr(run.traceFacts[i]))
    return DistributedInferenceRunResult(
        accepted: run.accepted,
        failureReason: strings.CloneStr(run.failureReason),
        receipt: DistributedInferenceExecutionReceiptClone(run.receipt),
        traceFacts: traceFactsCopy
    )

@borrows
fn DistributedSpecDecodeVerifyResultClone(verify: DistributedSpecDecodeVerifyResult): DistributedSpecDecodeVerifyResult =
    return DistributedSpecDecodeVerifyResult(
        schema: strings.CloneStr(verify.schema),
        acceptedDraftTokenCount: verify.acceptedDraftTokenCount,
        emittedTokenCount: verify.emittedTokenCount,
        firstRejectedIndex: verify.firstRejectedIndex,
        correctionToken: verify.correctionToken,
        draftTokenHash: verify.draftTokenHash,
        verifierLogitsHash: verify.verifierLogitsHash,
        outputTokenHash: verify.outputTokenHash,
        verifyHash: verify.verifyHash,
        outputTokens: infer.TensorClone(verify.outputTokens)
    )

@borrows
fn DistributedSpecDecodeDraftResultClone(draft: DistributedSpecDecodeDraftResult): DistributedSpecDecodeDraftResult =
    var traceFactsCopy: str[]
    for i in 0..<draft.traceFacts.len:
        add(traceFactsCopy, strings.CloneStr(draft.traceFacts[i]))
    return DistributedSpecDecodeDraftResult(
        schema: strings.CloneStr(draft.schema),
        draftTokenCount: draft.draftTokenCount,
        contextTokenHash: draft.contextTokenHash,
        draftTokenHash: draft.draftTokenHash,
        draftLogitsHash: draft.draftLogitsHash,
        draftKvStateHash: draft.draftKvStateHash,
        receiptHash: draft.receiptHash,
        draftHash: draft.draftHash,
        draftTokenIds: infer.TensorClone(draft.draftTokenIds),
        receipt: DistributedInferenceExecutionReceiptClone(draft.receipt),
        traceFacts: traceFactsCopy
    )
