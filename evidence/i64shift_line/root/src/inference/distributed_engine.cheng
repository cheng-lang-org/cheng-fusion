fn DistributedKvPageTransferFrameSetBuild(enginePlanHash: int64,
                                          frames: DistributedKvPageTransferFrame[]): DistributedKvPageTransferFrameSet =
    var set = DistributedKvPageTransferFrameSet(
        schema: DistributedKvPageTransferFrameSetSchema,
