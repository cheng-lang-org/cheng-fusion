fn DistributedKvPageTransferRequestFrameBuild(request: DistributedKvPageTransferRequest,
                                              seqNo: uint64,
                                              sentAtNs: int64): Result[DistributedKvPageTransferFrame] =
    if request.schema != DistributedKvPageTransferRequestSchema || request.requestHash <= int64(0):
        return Err[DistributedKvPageTransferFrame]("distributed kv page transfer frame: request")
    if sentAtNs <= int64(0):
        return Err[DistributedKvPageTransferFrame]("distributed kv page transfer frame: time")
    return Ok[DistributedKvPageTransferFrame](DistributedKvPageTransferFrameBuild(DistributedKvPageTransferFrame(
        schema: "",
        frameKind: DistributedTransportFrameKindRequest,
        enginePlanHash: request.enginePlanHash,
        seqNo: seqNo,
        coordinatorPeerId: request.coordinatorPeerId,
        sourcePeerId: request.coordinatorPeerId,
        targetPeerId: request.ownerPeerId,
        pageId: request.pageId,
        pageOrdinal: request.pageOrdinal,
        requestHash: request.requestHash,
        responseHash: int64(0),
        payloadHash: request.expectedPayloadHash,
        receiptHash: int64(0),
        sentAtNs: sentAtNs,
        frameHash: int64(0)
    )))

fn DistributedKvPageTransferResponseFrameBuild(request: DistributedKvPageTransferRequest,
                                               response: DistributedKvPageTransferResponse,
                                               seqNo: uint64,
                                               sentAtNs: int64): Result[DistributedKvPageTransferFrame] =
    if request.schema != DistributedKvPageTransferRequestSchema || request.requestHash <= int64(0):
        return Err[DistributedKvPageTransferFrame]("distributed kv page transfer frame: request")
    if response.schema != DistributedKvPageTransferResponseSchema || response.responseHash <= int64(0):
        return Err[DistributedKvPageTransferFrame]("distributed kv page transfer frame: response")
    if response.requestHash != request.requestHash ||
       response.payloadHash != request.expectedPayloadHash ||
       response.pageId != request.pageId ||
       response.pageOrdinal != request.pageOrdinal:
        return Err[DistributedKvPageTransferFrame]("distributed kv page transfer frame: binding")
    if sentAtNs <= int64(0):
        return Err[DistributedKvPageTransferFrame]("distributed kv page transfer frame: time")
    return Ok[DistributedKvPageTransferFrame](DistributedKvPageTransferFrameBuild(DistributedKvPageTransferFrame(
        schema: "",
        frameKind: DistributedTransportFrameKindResponse,
        enginePlanHash: request.enginePlanHash,
        seqNo: seqNo,
        coordinatorPeerId: request.coordinatorPeerId,
        sourcePeerId: response.ownerPeerId,
        targetPeerId: response.targetPeerId,
        pageId: response.pageId,
        pageOrdinal: response.pageOrdinal,
        requestHash: request.requestHash,
        responseHash: response.responseHash,
        payloadHash: response.payloadHash,
        receiptHash: response.receiptHash,
        sentAtNs: sentAtNs,
        frameHash: int64(0)
    )))

@borrows
fn DistributedKvPageTransferEvidenceHash(evidence: DistributedKvPageTransferEvidence): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, evidence.schema)
    h = DistributedHashStep(h, evidence.enginePlanHash)
    h = DistributedHashStep(h, evidence.payloadStore.storeHash)
    h = DistributedHashStep(h, evidence.requests.requestSetHash)
    h = DistributedHashStep(h, evidence.responses.responseSetHash)
    h = DistributedHashStep(h, evidence.receipts.receiptSetHash)
    h = DistributedHashStep(h, evidence.frames.frameSetHash)
    return h

fn DistributedKvPageTransferEvidenceBuild(enginePlanHash: int64,
                                          payloadStore: DistributedKvPagePayloadStore,
                                          requests: DistributedKvPageTransferRequestSet,
                                          responses: DistributedKvPageTransferResponseSet,
                                          receipts: DistributedKvPageTransferReceiptSet,
                                          frames: DistributedKvPageTransferFrameSet): DistributedKvPageTransferEvidence =
    var evidence = DistributedKvPageTransferEvidence(
        schema: DistributedKvPageTransferEvidenceSchema,
        enginePlanHash: enginePlanHash,
        payloadStore: payloadStore,
        requests: requests,
        responses: responses,
        receipts: receipts,
        frames: frames,
        evidenceHash: int64(0)
    )
    return evidence

fn DistributedKvPageTransferEvidenceSeal(draft: DistributedKvPageTransferEvidence): Result[DistributedKvPageTransferEvidence] =
    var evidence = draft
    evidence.schema = DistributedKvPageTransferEvidenceSchema
    evidence.evidenceHash = int64(0)
    evidence.evidenceHash = DistributedKvPageTransferEvidenceHash(evidence)
    if evidence.evidenceHash <= int64(0):
        return Err[DistributedKvPageTransferEvidence]("distributed kv page transfer evidence: hash")
    return Ok[DistributedKvPageTransferEvidence](evidence)

@borrows
fn DistributedBuildKvPageTransferEvidence(plan: DistributedInferencePlan,
                                          peers: DistributedInferencePeer[],
                                          cache: paged_kv_cache.PagedKVCache,
                                          seq: paged_kv_cache.PagedKVSequence,
                                          targetPeerId: str,
                                          coordinatorPeerId: str,
                                          startNs: int64): Result[DistributedKvPageTransferEvidence] =
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedKvPageTransferEvidence](Error(planOk))
    let ownerReceipt = DistributedKvShardOwnerReceipt(plan)
    if IsErr(ownerReceipt):
        return Err[DistributedKvPageTransferEvidence](Error(ownerReceipt))
    let ownerPeerId = Value(ownerReceipt).ownerPeerId
    if coordinatorPeerId == "" || startNs <= int64(0):
        return Err[DistributedKvPageTransferEvidence]("distributed kv page transfer evidence: coordinator")
    if !DistributedPeerReady(peers, coordinatorPeerId) ||
       !DistributedPeerReady(peers, targetPeerId) ||
       targetPeerId == ownerPeerId:
        return Err[DistributedKvPageTransferEvidence]("distributed kv page transfer evidence: peers")
    var payloads: DistributedKvPagePayload[]
    var requests: DistributedKvPageTransferRequest[]
    var responses: DistributedKvPageTransferResponse[]
    var receipts: DistributedKvPageTransferReceipt[]
    var frames: DistributedKvPageTransferFrame[]
    for pageOrdinal in 0..<seq.blockPageIds.len:
        let payload = DistributedKvPagePayloadBuild(plan, cache, seq, targetPeerId, pageOrdinal)
        if IsErr(payload):
            return Err[DistributedKvPageTransferEvidence](Error(payload))
        add(payloads, Value(payload))
        let inputHash = DistributedKvPageTransferExpectedInputHash(
            plan,
            ownerPeerId,
            targetPeerId,
            Value(payload).pageId,
            pageOrdinal,
            Value(payload).payloadHash
        )
        if IsErr(inputHash):
            return Err[DistributedKvPageTransferEvidence](Error(inputHash))
        let request = DistributedKvPageTransferRequestBuild(DistributedKvPageTransferRequest(
            schema: "",
            enginePlanHash: plan.engineHash,
            coordinatorPeerId: strings.CloneStr(coordinatorPeerId),
            ownerPeerId: strings.CloneStr(ownerPeerId),
            targetPeerId: strings.CloneStr(targetPeerId),
            seqId: seq.seqId,
            pageId: Value(payload).pageId,
            pageOrdinal: pageOrdinal,
            pageTableHash: plan.kvReceipt.pageTableHash,
            kvShardReceiptHash: plan.kvShardReceipts.receiptSetHash,
            inputHash: Value(inputHash),
            expectedPayloadHash: Value(payload).payloadHash,
            requestHash: int64(0)
        ))
        let elapsedNs = startNs + int64(pageOrdinal) + int64(1)
        let receipt = DistributedKvPageTransferReceiptBuild(DistributedKvPageTransferReceipt(
            schema: "",
            enginePlanHash: plan.engineHash,
            ownerPeerId: strings.CloneStr(ownerPeerId),
            targetPeerId: strings.CloneStr(targetPeerId),
            pageId: Value(payload).pageId,
            pageOrdinal: pageOrdinal,
            inputHash: Value(inputHash),
            payloadHash: Value(payload).payloadHash,
            elapsedNs: elapsedNs,
            status: "",
            receiptHash: int64(0)
        ))
        let response = DistributedKvPageTransferResponseBuild(DistributedKvPageTransferResponse(
            schema: "",
            requestHash: request.requestHash,
            enginePlanHash: plan.engineHash,
            ownerPeerId: strings.CloneStr(ownerPeerId),
            targetPeerId: strings.CloneStr(targetPeerId),
            pageId: Value(payload).pageId,
            pageOrdinal: pageOrdinal,
            payloadHash: Value(payload).payloadHash,
            receiptHash: receipt.receiptHash,
            elapsedNs: elapsedNs,
            responseHash: int64(0)
        ))
        add(requests, request)
        add(receipts, receipt)
        add(responses, response)
        let requestFrame = DistributedKvPageTransferRequestFrameBuild(
            request,
            uint64(pageOrdinal * 2),
            startNs + int64(pageOrdinal * 2) + int64(1)
        )
        if IsErr(requestFrame):
            return Err[DistributedKvPageTransferEvidence](Error(requestFrame))
        add(frames, Value(requestFrame))
        let responseFrame = DistributedKvPageTransferResponseFrameBuild(
            request,
            response,
            uint64(pageOrdinal * 2 + 1),
            startNs + int64(pageOrdinal * 2) + int64(2)
        )
        if IsErr(responseFrame):
            return Err[DistributedKvPageTransferEvidence](Error(responseFrame))
        add(frames, Value(responseFrame))
    let payloadStore = DistributedKvPagePayloadStoreBuild(plan.engineHash, payloads)
    let requestSet = DistributedKvPageTransferRequestSetBuild(plan.engineHash, requests)
    let responseSet = DistributedKvPageTransferResponseSetBuild(plan.engineHash, responses)
    let receiptSet = DistributedKvPageTransferReceiptSetBuild(plan.engineHash, receipts)
    let frameSet = DistributedKvPageTransferFrameSetBuild(plan.engineHash, frames)
    let draft = DistributedKvPageTransferEvidenceBuild(
        plan.engineHash,
        payloadStore,
        requestSet,
        responseSet,
        receiptSet,
        frameSet
    )
    return DistributedKvPageTransferEvidenceSeal(draft)

@borrows
fn DistributedFindKvPageTransferRequestByHash(set: DistributedKvPageTransferRequestSet,
                                              requestHash: int64): int32 =
    var found: int32 = -1
    for i in 0..<set.requests.len:
        if set.requests[i].requestHash == requestHash:
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn DistributedFindKvPageTransferReceipt(set: DistributedKvPageTransferReceiptSet,
                                        pageOrdinal: int32): int32 =
    var found: int32 = -1
    for i in 0..<set.receipts.len:
        if set.receipts[i].pageOrdinal == pageOrdinal:
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn DistributedFindKvPageTransferFrame(set: DistributedKvPageTransferFrameSet,
                                      frameKind: str,
                                      requestHash: int64): int32 =
    var found: int32 = -1
    for i in 0..<set.frames.len:
        if set.frames[i].frameKind == frameKind && set.frames[i].requestHash == requestHash:
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn DistributedValidateKvPageTransferRequest(plan: DistributedInferencePlan,
                                            peers: DistributedInferencePeer[],
                                            store: DistributedKvPagePayloadStore,
                                            request: DistributedKvPageTransferRequest): Result[bool] =
    if request.schema != DistributedKvPageTransferRequestSchema:
        return Err[bool]("distributed kv page transfer request: schema")
    if request.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer request: plan")
    if request.coordinatorPeerId == "" || request.ownerPeerId == "" || request.targetPeerId == "":
        return Err[bool]("distributed kv page transfer request: identity")
    if !DistributedPeerReady(peers, request.coordinatorPeerId) ||
       !DistributedPeerReady(peers, request.ownerPeerId) ||
       !DistributedPeerReady(peers, request.targetPeerId) ||
       request.ownerPeerId == request.targetPeerId:
        return Err[bool]("distributed kv page transfer request: peers")
    let ownerReceipt = DistributedKvShardOwnerReceipt(plan)
    if IsErr(ownerReceipt):
        return Err[bool](Error(ownerReceipt))
    if request.ownerPeerId != Value(ownerReceipt).ownerPeerId ||
       request.pageTableHash != plan.kvReceipt.pageTableHash ||
       request.kvShardReceiptHash != plan.kvShardReceipts.receiptSetHash:
        return Err[bool]("distributed kv page transfer request: kv binding")
    let payloadIndex = DistributedFindKvPagePayload(store, request.pageOrdinal)
    if payloadIndex == -2:
        return Err[bool]("distributed kv page transfer request: duplicate payload")
    if payloadIndex < 0:
        return Err[bool]("distributed kv page transfer request: payload missing")
    let payload = store.payloads[payloadIndex]
    if payload.sourcePeerId != request.ownerPeerId ||
       payload.targetPeerId != request.targetPeerId ||
       payload.seqId != request.seqId ||
       payload.pageId != request.pageId ||
       payload.payloadHash != request.expectedPayloadHash:
        return Err[bool]("distributed kv page transfer request: payload binding")
    let inputHash = DistributedKvPageTransferExpectedInputHash(
        plan,
        request.ownerPeerId,
        request.targetPeerId,
        request.pageId,
        request.pageOrdinal,
        request.expectedPayloadHash
    )
    if IsErr(inputHash):
        return Err[bool](Error(inputHash))
    if request.inputHash != Value(inputHash):
        return Err[bool]("distributed kv page transfer request: input hash")
    if DistributedKvPageTransferRequestHash(request) != request.requestHash:
        return Err[bool]("distributed kv page transfer request: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageTransferRequestSet(plan: DistributedInferencePlan,
                                               peers: DistributedInferencePeer[],
                                               store: DistributedKvPagePayloadStore,
                                               set: DistributedKvPageTransferRequestSet): Result[bool] =
    if set.schema != DistributedKvPageTransferRequestSetSchema ||
       set.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer request set: schema")
    if set.requests.len != store.payloads.len:
        return Err[bool]("distributed kv page transfer request set: count")
    for i in 0..<set.requests.len:
        for j in i + 1..<set.requests.len:
            if set.requests[i].pageOrdinal == set.requests[j].pageOrdinal ||
               set.requests[i].requestHash == set.requests[j].requestHash:
                return Err[bool]("distributed kv page transfer request set: duplicate")
        let ok = DistributedValidateKvPageTransferRequest(plan, peers, store, set.requests[i])
        if IsErr(ok):
            return Err[bool](Error(ok))
    if DistributedKvPageTransferRequestSetHash(set) != set.requestSetHash:
        return Err[bool]("distributed kv page transfer request set: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageTransferReceipt(plan: DistributedInferencePlan,
                                            store: DistributedKvPagePayloadStore,
                                            receipt: DistributedKvPageTransferReceipt): Result[bool] =
    if receipt.schema != DistributedKvPageTransferReceiptSchema ||
       receipt.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer receipt: schema")
    if receipt.status != execution_receipt.InferenceExecutionStatusExecuted ||
       receipt.elapsedNs <= int64(0) ||
       receipt.inputHash <= int64(0) ||
       receipt.payloadHash <= int64(0):
        return Err[bool]("distributed kv page transfer receipt: execution")
    let payloadIndex = DistributedFindKvPagePayload(store, receipt.pageOrdinal)
    if payloadIndex < 0:
        return Err[bool]("distributed kv page transfer receipt: payload")
    let payload = store.payloads[payloadIndex]
    if payload.sourcePeerId != receipt.ownerPeerId ||
       payload.targetPeerId != receipt.targetPeerId ||
       payload.pageId != receipt.pageId ||
       payload.payloadHash != receipt.payloadHash:
        return Err[bool]("distributed kv page transfer receipt: payload binding")
    let expectedInput = DistributedKvPageTransferExpectedInputHash(
        plan,
        receipt.ownerPeerId,
        receipt.targetPeerId,
        receipt.pageId,
        receipt.pageOrdinal,
        receipt.payloadHash
    )
    if IsErr(expectedInput):
        return Err[bool](Error(expectedInput))
    if receipt.inputHash != Value(expectedInput):
        return Err[bool]("distributed kv page transfer receipt: input hash")
    if DistributedKvPageTransferReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("distributed kv page transfer receipt: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageTransferReceiptSet(plan: DistributedInferencePlan,
                                               store: DistributedKvPagePayloadStore,
                                               set: DistributedKvPageTransferReceiptSet): Result[bool] =
    if set.schema != DistributedKvPageTransferReceiptSetSchema ||
       set.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer receipt set: schema")
    if set.receipts.len != store.payloads.len:
        return Err[bool]("distributed kv page transfer receipt set: count")
    for i in 0..<set.receipts.len:
        for j in i + 1..<set.receipts.len:
            if set.receipts[i].pageOrdinal == set.receipts[j].pageOrdinal:
                return Err[bool]("distributed kv page transfer receipt set: duplicate")
        let ok = DistributedValidateKvPageTransferReceipt(plan, store, set.receipts[i])
        if IsErr(ok):
            return Err[bool](Error(ok))
    if DistributedKvPageTransferReceiptSetHash(set) != set.receiptSetHash:
        return Err[bool]("distributed kv page transfer receipt set: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageTransferResponse(plan: DistributedInferencePlan,
                                             store: DistributedKvPagePayloadStore,
                                             requests: DistributedKvPageTransferRequestSet,
                                             receipts: DistributedKvPageTransferReceiptSet,
                                             response: DistributedKvPageTransferResponse): Result[bool] =
    if response.schema != DistributedKvPageTransferResponseSchema ||
       response.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer response: schema")
    if response.requestHash <= int64(0) || response.payloadHash <= int64(0) ||
       response.receiptHash <= int64(0) || response.elapsedNs <= int64(0):
        return Err[bool]("distributed kv page transfer response: fields")
    let requestIndex = DistributedFindKvPageTransferRequestByHash(requests, response.requestHash)
    if requestIndex < 0:
        return Err[bool]("distributed kv page transfer response: request")
    let request = requests.requests[requestIndex]
    let receiptIndex = DistributedFindKvPageTransferReceipt(receipts, response.pageOrdinal)
    if receiptIndex < 0:
        return Err[bool]("distributed kv page transfer response: receipt")
    let receipt = receipts.receipts[receiptIndex]
    let payloadIndex = DistributedFindKvPagePayload(store, response.pageOrdinal)
    if payloadIndex < 0:
        return Err[bool]("distributed kv page transfer response: payload")
    let payload = store.payloads[payloadIndex]
    if response.ownerPeerId != request.ownerPeerId ||
       response.targetPeerId != request.targetPeerId ||
       response.pageId != request.pageId ||
       response.payloadHash != request.expectedPayloadHash ||
       response.payloadHash != payload.payloadHash ||
       response.receiptHash != receipt.receiptHash ||
       response.elapsedNs != receipt.elapsedNs:
        return Err[bool]("distributed kv page transfer response: binding")
    if DistributedKvPageTransferResponseHash(response) != response.responseHash:
        return Err[bool]("distributed kv page transfer response: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageTransferResponseSet(plan: DistributedInferencePlan,
                                                store: DistributedKvPagePayloadStore,
                                                requests: DistributedKvPageTransferRequestSet,
                                                receipts: DistributedKvPageTransferReceiptSet,
                                                responses: DistributedKvPageTransferResponseSet): Result[bool] =
    if responses.schema != DistributedKvPageTransferResponseSetSchema ||
       responses.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer response set: schema")
    if responses.responses.len != requests.requests.len:
        return Err[bool]("distributed kv page transfer response set: count")
    for i in 0..<responses.responses.len:
        for j in i + 1..<responses.responses.len:
            if responses.responses[i].requestHash == responses.responses[j].requestHash ||
               responses.responses[i].pageOrdinal == responses.responses[j].pageOrdinal:
                return Err[bool]("distributed kv page transfer response set: duplicate")
        let ok = DistributedValidateKvPageTransferResponse(plan, store, requests, receipts, responses.responses[i])
        if IsErr(ok):
            return Err[bool](Error(ok))
    if DistributedKvPageTransferResponseSetHash(responses) != responses.responseSetHash:
        return Err[bool]("distributed kv page transfer response set: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageTransferFrame(plan: DistributedInferencePlan,
                                          requests: DistributedKvPageTransferRequestSet,
                                          responses: DistributedKvPageTransferResponseSet,
                                          frame: DistributedKvPageTransferFrame): Result[bool] =
    if frame.schema != DistributedKvPageTransferFrameSchema ||
       frame.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer frame: schema")
    if frame.frameKind != DistributedTransportFrameKindRequest &&
       frame.frameKind != DistributedTransportFrameKindResponse:
        return Err[bool]("distributed kv page transfer frame: kind")
    if frame.coordinatorPeerId == "" || frame.sourcePeerId == "" ||
       frame.targetPeerId == "" || frame.pageId <= 0 ||
       frame.pageOrdinal < 0 || frame.requestHash <= int64(0) ||
       frame.payloadHash <= int64(0) || frame.sentAtNs <= int64(0):
        return Err[bool]("distributed kv page transfer frame: fields")
    let requestIndex = DistributedFindKvPageTransferRequestByHash(requests, frame.requestHash)
    if requestIndex < 0:
        return Err[bool]("distributed kv page transfer frame: request")
    let request = requests.requests[requestIndex]
    if frame.frameKind == DistributedTransportFrameKindRequest:
        if frame.sourcePeerId != request.coordinatorPeerId ||
           frame.targetPeerId != request.ownerPeerId ||
           frame.pageId != request.pageId ||
           frame.pageOrdinal != request.pageOrdinal ||
           frame.payloadHash != request.expectedPayloadHash ||
           frame.responseHash != int64(0) ||
           frame.receiptHash != int64(0):
            return Err[bool]("distributed kv page transfer frame: request binding")
    else:
        var foundResponse: int32 = -1
        for i in 0..<responses.responses.len:
            if responses.responses[i].requestHash == frame.requestHash:
                if foundResponse >= 0:
                    return Err[bool]("distributed kv page transfer frame: duplicate response")
                foundResponse = i
        if foundResponse < 0:
            return Err[bool]("distributed kv page transfer frame: response missing")
        let response = responses.responses[foundResponse]
        if frame.sourcePeerId != response.ownerPeerId ||
           frame.targetPeerId != response.targetPeerId ||
           frame.pageId != response.pageId ||
           frame.pageOrdinal != response.pageOrdinal ||
           frame.responseHash != response.responseHash ||
           frame.payloadHash != response.payloadHash ||
           frame.receiptHash != response.receiptHash:
            return Err[bool]("distributed kv page transfer frame: response binding")
    if DistributedKvPageTransferFrameHash(frame) != frame.frameHash:
        return Err[bool]("distributed kv page transfer frame: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageTransferFrameSet(plan: DistributedInferencePlan,
                                             requests: DistributedKvPageTransferRequestSet,
                                             responses: DistributedKvPageTransferResponseSet,
                                             frames: DistributedKvPageTransferFrameSet): Result[bool] =
    if frames.schema != DistributedKvPageTransferFrameSetSchema ||
       frames.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer frame set: schema")
    if frames.frames.len != requests.requests.len * 2:
        return Err[bool]("distributed kv page transfer frame set: count")
    for i in 0..<frames.frames.len:
        if frames.frames[i].seqNo != uint64(i):
            return Err[bool]("distributed kv page transfer frame set: sequence")
        for j in i + 1..<frames.frames.len:
            if frames.frames[i].frameHash == frames.frames[j].frameHash:
                return Err[bool]("distributed kv page transfer frame set: duplicate")
        let ok = DistributedValidateKvPageTransferFrame(plan, requests, responses, frames.frames[i])
        if IsErr(ok):
            return Err[bool](Error(ok))
    for i in 0..<requests.requests.len:
        if DistributedFindKvPageTransferFrame(frames, DistributedTransportFrameKindRequest, requests.requests[i].requestHash) < 0 ||
           DistributedFindKvPageTransferFrame(frames, DistributedTransportFrameKindResponse, requests.requests[i].requestHash) < 0:
            return Err[bool]("distributed kv page transfer frame set: missing pair")
    if DistributedKvPageTransferFrameSetHash(frames) != frames.frameSetHash:
        return Err[bool]("distributed kv page transfer frame set: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageTransferEvidence(plan: DistributedInferencePlan,
                                             peers: DistributedInferencePeer[],
                                             cache: paged_kv_cache.PagedKVCache,
                                             seq: paged_kv_cache.PagedKVSequence,
                                             evidence: DistributedKvPageTransferEvidence): Result[bool] =
    if evidence.schema != DistributedKvPageTransferEvidenceSchema ||
       evidence.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed kv page transfer evidence: schema")
    let storeOk = DistributedValidateKvPagePayloadStore(plan, peers, cache, seq, evidence.payloadStore)
    if IsErr(storeOk):
        return Err[bool](Error(storeOk))
    let requestOk = DistributedValidateKvPageTransferRequestSet(plan, peers, evidence.payloadStore, evidence.requests)
    if IsErr(requestOk):
        return Err[bool](Error(requestOk))
    let receiptOk = DistributedValidateKvPageTransferReceiptSet(plan, evidence.payloadStore, evidence.receipts)
    if IsErr(receiptOk):
        return Err[bool](Error(receiptOk))
    let responseOk = DistributedValidateKvPageTransferResponseSet(
        plan,
        evidence.payloadStore,
        evidence.requests,
        evidence.receipts,
        evidence.responses
    )
    if IsErr(responseOk):
        return Err[bool](Error(responseOk))
    let frameOk = DistributedValidateKvPageTransferFrameSet(
        plan,
        evidence.requests,
        evidence.responses,
        evidence.frames
    )
    if IsErr(frameOk):
        return Err[bool](Error(frameOk))
    if DistributedKvPageTransferEvidenceHash(evidence) != evidence.evidenceHash:
        return Err[bool]("distributed kv page transfer evidence: hash")
    return Ok[bool](true)

@borrows
fn DistributedKvPageResidencyEntryHash(entry: DistributedKvPageResidencyEntry): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, entry.schema)
    h = DistributedHashStep(h, entry.enginePlanHash)
    h = DistributedHashTextWith(h, entry.ownerPeerId)
    h = DistributedHashTextWith(h, entry.targetPeerId)
    h = DistributedHashStep(h, int64(entry.seqId))
    h = DistributedHashStep(h, int64(entry.pageId))
    h = DistributedHashStep(h, int64(entry.pageOrdinal))
    h = DistributedHashStep(h, entry.payloadHash)
    h = DistributedHashStep(h, entry.requestHash)
    h = DistributedHashStep(h, entry.responseHash)
    h = DistributedHashStep(h, entry.transferReceiptHash)
    h = DistributedHashStep(h, entry.requestFrameHash)
    h = DistributedHashStep(h, entry.responseFrameHash)
    h = DistributedHashStep(h, entry.residentSinceNs)
    h = DistributedHashStep(h, entry.validUntilNs)
    return h

@borrows
fn DistributedKvPageResidencyEntrySetHash(entries: DistributedKvPageResidencyEntry[]): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, DistributedKvPageResidencyReceiptSchema)
    h = DistributedHashStep(h, int64(entries.len))
    for i in 0..<entries.len:
        h = DistributedHashStep(h, entries[i].entryHash)
    return h

@borrows
fn DistributedKvPageResidencyReceiptHash(receipt: DistributedKvPageResidencyReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashStep(h, receipt.transferEvidenceHash)
    h = DistributedHashStep(h, int64(receipt.pageCount))
    h = DistributedHashStep(h, receipt.entrySetHash)
    return h

fn DistributedKvPageResidencyEntryBuild(draft: DistributedKvPageResidencyEntry): DistributedKvPageResidencyEntry =
    var entry = draft
    entry.schema = DistributedKvPageResidencyEntrySchema
    entry.entryHash = int64(0)
    entry.entryHash = DistributedKvPageResidencyEntryHash(entry)
    return entry

fn DistributedKvPageResidencyReceiptBuild(enginePlanHash: int64,
                                          targetPeerId: str,
                                          transferEvidenceHash: int64,
                                          entries: DistributedKvPageResidencyEntry[]): DistributedKvPageResidencyReceipt =
    var receipt = DistributedKvPageResidencyReceipt(
        schema: DistributedKvPageResidencyReceiptSchema,
        enginePlanHash: enginePlanHash,
        targetPeerId: targetPeerId,
        transferEvidenceHash: transferEvidenceHash,
        pageCount: entries.len,
        entrySetHash: int64(0),
        receiptHash: int64(0),
        entries: entries
    )
    receipt.entrySetHash = DistributedKvPageResidencyEntrySetHash(receipt.entries)
    receipt.receiptHash = DistributedKvPageResidencyReceiptHash(receipt)
    return receipt

@borrows
fn DistributedKvPageTransferTargetPeer(evidence: DistributedKvPageTransferEvidence): Result[str] =
    if evidence.payloadStore.payloads.len <= 0:
        return Err[str]("distributed kv page residency: empty payloads")
    let targetPeerId = evidence.payloadStore.payloads[0].targetPeerId
    if targetPeerId == "":
        return Err[str]("distributed kv page residency: target")
    for i in 0..<evidence.payloadStore.payloads.len:
        if evidence.payloadStore.payloads[i].targetPeerId != targetPeerId:
            return Err[str]("distributed kv page residency: mixed target")
    return Ok[str](targetPeerId)

@borrows
fn DistributedBuildKvPageResidencyReceipt(plan: DistributedInferencePlan,
                                          peers: DistributedInferencePeer[],
                                          evidence: DistributedKvPageTransferEvidence,
                                          residentSinceNs: int64,
                                          validUntilNs: int64): Result[DistributedKvPageResidencyReceipt] =
    if evidence.schema != DistributedKvPageTransferEvidenceSchema ||
       evidence.enginePlanHash != plan.engineHash ||
       evidence.evidenceHash <= int64(0) ||
       DistributedKvPageTransferEvidenceHash(evidence) != evidence.evidenceHash:
        return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: evidence")
    if residentSinceNs <= int64(0) || validUntilNs <= residentSinceNs:
        return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: time")
    let targetPeer = DistributedKvPageTransferTargetPeer(evidence)
    if IsErr(targetPeer):
        return Err[DistributedKvPageResidencyReceipt](Error(targetPeer))
    if !DistributedPeerReady(peers, Value(targetPeer)):
        return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: peer")
    var entries: DistributedKvPageResidencyEntry[]
    for i in 0..<evidence.payloadStore.payloads.len:
        let payload = evidence.payloadStore.payloads[i]
        var requestIndex: int32 = -1
        for q in 0..<evidence.requests.requests.len:
            if evidence.requests.requests[q].pageOrdinal == payload.pageOrdinal:
                if requestIndex >= 0:
                    return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: duplicate request")
                requestIndex = q
        if requestIndex < 0:
            return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: request")
        let request = evidence.requests.requests[requestIndex]
        if request.pageOrdinal != payload.pageOrdinal ||
           request.expectedPayloadHash != payload.payloadHash:
            return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: request binding")
        let receiptIndex = DistributedFindKvPageTransferReceipt(evidence.receipts, payload.pageOrdinal)
        if receiptIndex < 0:
            return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: transfer receipt")
        let transferReceipt = evidence.receipts.receipts[receiptIndex]
        var responseIndex: int32 = -1
        for r in 0..<evidence.responses.responses.len:
            if evidence.responses.responses[r].requestHash == request.requestHash:
                if responseIndex >= 0:
                    return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: duplicate response")
                responseIndex = r
        if responseIndex < 0:
            return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: response")
        let response = evidence.responses.responses[responseIndex]
        let requestFrameIndex = DistributedFindKvPageTransferFrame(
            evidence.frames,
            DistributedTransportFrameKindRequest,
            request.requestHash
        )
        let responseFrameIndex = DistributedFindKvPageTransferFrame(
            evidence.frames,
            DistributedTransportFrameKindResponse,
            request.requestHash
        )
        if requestFrameIndex < 0 || responseFrameIndex < 0:
            return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: frames")
        let requestFrame = evidence.frames.frames[requestFrameIndex]
        let responseFrame = evidence.frames.frames[responseFrameIndex]
        if payload.sourcePeerId != request.ownerPeerId ||
           payload.targetPeerId != request.targetPeerId ||
           payload.targetPeerId != Value(targetPeer) ||
           response.targetPeerId != Value(targetPeer) ||
           transferReceipt.targetPeerId != Value(targetPeer) ||
           response.payloadHash != payload.payloadHash ||
           transferReceipt.payloadHash != payload.payloadHash ||
           response.receiptHash != transferReceipt.receiptHash ||
           requestFrame.frameHash <= int64(0) ||
           responseFrame.frameHash <= int64(0):
            return Err[DistributedKvPageResidencyReceipt]("distributed kv page residency: binding")
        let entry = DistributedKvPageResidencyEntryBuild(DistributedKvPageResidencyEntry(
            schema: "",
            enginePlanHash: plan.engineHash,
            ownerPeerId: payload.sourcePeerId,
            targetPeerId: payload.targetPeerId,
            seqId: payload.seqId,
            pageId: payload.pageId,
            pageOrdinal: payload.pageOrdinal,
            payloadHash: payload.payloadHash,
            requestHash: request.requestHash,
            responseHash: response.responseHash,
            transferReceiptHash: transferReceipt.receiptHash,
            requestFrameHash: requestFrame.frameHash,
            responseFrameHash: responseFrame.frameHash,
            residentSinceNs: residentSinceNs,
            validUntilNs: validUntilNs,
            entryHash: int64(0)
        ))
        add(entries, entry)
    let out = DistributedKvPageResidencyReceiptBuild(
        plan.engineHash,
        Value(targetPeer),
        evidence.evidenceHash,
        entries
    )
    let ok = DistributedValidateKvPageResidencyReceipt(plan, peers, evidence, out)
    if IsErr(ok):
        return Err[DistributedKvPageResidencyReceipt](Error(ok))
    return Ok[DistributedKvPageResidencyReceipt](out)

@borrows
fn DistributedValidateKvPageResidencyReceipt(plan: DistributedInferencePlan,
                                             peers: DistributedInferencePeer[],
                                             evidence: DistributedKvPageTransferEvidence,
                                             receipt: DistributedKvPageResidencyReceipt): Result[bool] =
    if receipt.schema != DistributedKvPageResidencyReceiptSchema ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.transferEvidenceHash != evidence.evidenceHash:
        return Err[bool]("distributed kv page residency receipt: schema")
    if receipt.targetPeerId == "" || !DistributedPeerReady(peers, receipt.targetPeerId):
        return Err[bool]("distributed kv page residency receipt: target")
    if receipt.pageCount != evidence.payloadStore.payloads.len ||
       receipt.entries.len != evidence.payloadStore.payloads.len ||
       receipt.entries.len <= 0:
        return Err[bool]("distributed kv page residency receipt: count")
    let expectedTarget = DistributedKvPageTransferTargetPeer(evidence)
    if IsErr(expectedTarget):
        return Err[bool](Error(expectedTarget))
    if receipt.targetPeerId != Value(expectedTarget):
        return Err[bool]("distributed kv page residency receipt: target binding")
    for i in 0..<receipt.entries.len:
        let entry = receipt.entries[i]
        if entry.schema != DistributedKvPageResidencyEntrySchema ||
           entry.enginePlanHash != plan.engineHash ||
           entry.targetPeerId != receipt.targetPeerId ||
           entry.residentSinceNs <= int64(0) ||
           entry.validUntilNs <= entry.residentSinceNs:
            return Err[bool]("distributed kv page residency entry: schema")
        if DistributedKvPageResidencyEntryHash(entry) != entry.entryHash:
            return Err[bool]("distributed kv page residency entry: hash")
        let payloadIndex = DistributedFindKvPagePayload(evidence.payloadStore, entry.pageOrdinal)
        if payloadIndex < 0:
            return Err[bool]("distributed kv page residency entry: payload")
        let payload = evidence.payloadStore.payloads[payloadIndex]
        if payload.sourcePeerId != entry.ownerPeerId ||
           payload.targetPeerId != entry.targetPeerId ||
           payload.seqId != entry.seqId ||
           payload.pageId != entry.pageId ||
           payload.payloadHash != entry.payloadHash:
            return Err[bool]("distributed kv page residency entry: payload binding")
        let requestIndex = DistributedFindKvPageTransferRequestByHash(evidence.requests, entry.requestHash)
        if requestIndex < 0:
            return Err[bool]("distributed kv page residency entry: request")
        let request = evidence.requests.requests[requestIndex]
        let receiptIndex = DistributedFindKvPageTransferReceipt(evidence.receipts, entry.pageOrdinal)
        if receiptIndex < 0:
            return Err[bool]("distributed kv page residency entry: transfer receipt")
        let transferReceipt = evidence.receipts.receipts[receiptIndex]
        var responseIndex: int32 = -1
        for r in 0..<evidence.responses.responses.len:
            if evidence.responses.responses[r].requestHash == entry.requestHash:
                if responseIndex >= 0:
                    return Err[bool]("distributed kv page residency entry: duplicate response")
                responseIndex = r
        if responseIndex < 0:
            return Err[bool]("distributed kv page residency entry: response")
        let response = evidence.responses.responses[responseIndex]
        let requestFrameIndex = DistributedFindKvPageTransferFrame(evidence.frames, DistributedTransportFrameKindRequest, entry.requestHash)
        let responseFrameIndex = DistributedFindKvPageTransferFrame(evidence.frames, DistributedTransportFrameKindResponse, entry.requestHash)
        if requestFrameIndex < 0 || responseFrameIndex < 0:
            return Err[bool]("distributed kv page residency entry: frames")
        if request.pageOrdinal != entry.pageOrdinal ||
           request.ownerPeerId != entry.ownerPeerId ||
           request.targetPeerId != entry.targetPeerId ||
           request.expectedPayloadHash != entry.payloadHash ||
           response.responseHash != entry.responseHash ||
           response.payloadHash != entry.payloadHash ||
           transferReceipt.receiptHash != entry.transferReceiptHash ||
           transferReceipt.payloadHash != entry.payloadHash ||
           evidence.frames.frames[requestFrameIndex].frameHash != entry.requestFrameHash ||
           evidence.frames.frames[responseFrameIndex].frameHash != entry.responseFrameHash:
            return Err[bool]("distributed kv page residency entry: evidence binding")
        for j in i + 1..<receipt.entries.len:
            if entry.pageOrdinal == receipt.entries[j].pageOrdinal ||
               entry.entryHash == receipt.entries[j].entryHash:
                return Err[bool]("distributed kv page residency receipt: duplicate")
    if DistributedKvPageResidencyEntrySetHash(receipt.entries) != receipt.entrySetHash:
        return Err[bool]("distributed kv page residency receipt: entry set hash")
    if DistributedKvPageResidencyReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("distributed kv page residency receipt: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvPageResidencyReceiptSelf(plan: DistributedInferencePlan,
                                                 peers: DistributedInferencePeer[],
                                                 receipt: DistributedKvPageResidencyReceipt): Result[bool] =
    if receipt.schema != DistributedKvPageResidencyReceiptSchema ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.targetPeerId == "" ||
       receipt.pageCount != receipt.entries.len ||
       receipt.entries.len <= 0:
        return Err[bool]("distributed kv page residency self: schema")
    if !DistributedPeerReady(peers, receipt.targetPeerId):
        return Err[bool]("distributed kv page residency self: target")
    for i in 0..<receipt.entries.len:
        let entry = receipt.entries[i]
        if entry.schema != DistributedKvPageResidencyEntrySchema ||
           entry.enginePlanHash != plan.engineHash ||
           entry.targetPeerId != receipt.targetPeerId ||
           entry.residentSinceNs <= int64(0) ||
           entry.validUntilNs <= entry.residentSinceNs:
            return Err[bool]("distributed kv page residency self: entry")
        if DistributedKvPageResidencyEntryHash(entry) != entry.entryHash:
            return Err[bool]("distributed kv page residency self: entry hash")
        for j in i + 1..<receipt.entries.len:
            if entry.entryHash == receipt.entries[j].entryHash:
                return Err[bool]("distributed kv page residency self: duplicate")
    if DistributedKvPageResidencyEntrySetHash(receipt.entries) != receipt.entrySetHash:
        return Err[bool]("distributed kv page residency self: entry set")
    if DistributedKvPageResidencyReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("distributed kv page residency self: receipt hash")
    return Ok[bool](true)

@borrows
fn DistributedKvResidencyExistingReceiptSetHash(receipts: DistributedKvPageResidencyReceipt[]): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, DistributedKvResidencyScheduleSchema)
    h = DistributedHashStep(h, int64(receipts.len))
    for i in 0..<receipts.len:
        h = DistributedHashStep(h, receipts[i].receiptHash)
    return h

@borrows
fn DistributedKvResidencyDecisionHash(decision: DistributedKvResidencyDecision): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, decision.schema)
    h = DistributedHashStep(h, decision.enginePlanHash)
    h = DistributedHashTextWith(h, decision.action)
    h = DistributedHashTextWith(h, decision.targetPeerId)
    h = DistributedHashStep(h, int64(decision.seqId))
    h = DistributedHashStep(h, int64(decision.pageId))
    h = DistributedHashStep(h, int64(decision.pageOrdinal))
    h = DistributedHashStep(h, decision.payloadHash)
    h = DistributedHashStep(h, decision.sourceResidencyReceiptHash)
    h = DistributedHashStep(h, decision.sourceResidencyEntryHash)
    h = DistributedHashStep(h, decision.transferEvidenceHash)
    h = DistributedHashStep(h, decision.transferResidencyReceiptHash)
    h = DistributedHashStep(h, decision.transferResidencyEntryHash)
    return h

fn DistributedKvResidencyDecisionBuild(draft: DistributedKvResidencyDecision): DistributedKvResidencyDecision =
    var decision = draft
    decision.schema = DistributedKvResidencyDecisionSchema
    decision.decisionHash = int64(0)
    decision.decisionHash = DistributedKvResidencyDecisionHash(decision)
    return decision

@borrows
fn DistributedKvResidencyDecisionSetHash(decisions: DistributedKvResidencyDecision[]): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, DistributedKvResidencyDecisionSchema)
    h = DistributedHashStep(h, int64(decisions.len))
    for i in 0..<decisions.len:
        h = DistributedHashStep(h, decisions[i].decisionHash)
    return h

@borrows
fn DistributedKvResidencyScheduleHash(schedule: DistributedKvResidencySchedule): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, schedule.schema)
    h = DistributedHashStep(h, schedule.enginePlanHash)
    h = DistributedHashTextWith(h, schedule.targetPeerId)
    h = DistributedHashStep(h, int64(schedule.maxResidentPages))
    h = DistributedHashStep(h, schedule.nowNs)
    h = DistributedHashStep(h, schedule.requiredUntilNs)
    h = DistributedHashStep(h, schedule.transferEvidenceHash)
    h = DistributedHashStep(h, schedule.transferResidencyReceiptHash)
    h = DistributedHashStep(h, schedule.existingReceiptSetHash)
    h = DistributedHashStep(h, int64(schedule.requiredPageCount))
    h = DistributedHashStep(h, int64(schedule.reusedPageCount))
    h = DistributedHashStep(h, int64(schedule.transferredPageCount))
    h = DistributedHashStep(h, int64(schedule.evictedPageCount))
    h = DistributedHashStep(h, int64(schedule.finalResidentPageCount))
    h = DistributedHashStep(h, schedule.decisionSetHash)
    return h

fn DistributedKvResidencyScheduleBuild(enginePlanHash: int64,
                                       targetPeerId: str,
                                       maxResidentPages: int32,
                                       nowNs: int64,
                                       requiredUntilNs: int64,
                                       transferEvidenceHash: int64,
                                       transferResidencyReceiptHash: int64,
                                       existingReceiptSetHash: int64,
                                       requiredPageCount: int32,
                                       reusedPageCount: int32,
                                       transferredPageCount: int32,
                                       evictedPageCount: int32,
                                       finalResidentPageCount: int32,
                                       decisions: DistributedKvResidencyDecision[]): DistributedKvResidencySchedule =
    var schedule = DistributedKvResidencySchedule(
        schema: DistributedKvResidencyScheduleSchema,
        enginePlanHash: enginePlanHash,
        targetPeerId: targetPeerId,
        maxResidentPages: maxResidentPages,
        nowNs: nowNs,
        requiredUntilNs: requiredUntilNs,
        transferEvidenceHash: transferEvidenceHash,
        transferResidencyReceiptHash: transferResidencyReceiptHash,
        existingReceiptSetHash: existingReceiptSetHash,
        requiredPageCount: requiredPageCount,
        reusedPageCount: reusedPageCount,
        transferredPageCount: transferredPageCount,
        evictedPageCount: evictedPageCount,
        finalResidentPageCount: finalResidentPageCount,
        decisionSetHash: int64(0),
        scheduleHash: int64(0),
        decisions: decisions
    )
    schedule.decisionSetHash = DistributedKvResidencyDecisionSetHash(schedule.decisions)
    schedule.scheduleHash = DistributedKvResidencyScheduleHash(schedule)
    return schedule

@borrows
fn DistributedKvResidencyScheduleClone(schedule: DistributedKvResidencySchedule): Result[DistributedKvResidencySchedule] =
    var decisions: DistributedKvResidencyDecision[]
    for i in 0..<schedule.decisions.len:
        add(decisions, DistributedKvResidencyDecision(
            schema: strings.CloneStr(schedule.decisions[i].schema),
            enginePlanHash: schedule.decisions[i].enginePlanHash,
            action: strings.CloneStr(schedule.decisions[i].action),
            targetPeerId: strings.CloneStr(schedule.decisions[i].targetPeerId),
            seqId: schedule.decisions[i].seqId,
            pageId: schedule.decisions[i].pageId,
            pageOrdinal: schedule.decisions[i].pageOrdinal,
            payloadHash: schedule.decisions[i].payloadHash,
            sourceResidencyReceiptHash: schedule.decisions[i].sourceResidencyReceiptHash,
            sourceResidencyEntryHash: schedule.decisions[i].sourceResidencyEntryHash,
            transferEvidenceHash: schedule.decisions[i].transferEvidenceHash,
            transferResidencyReceiptHash: schedule.decisions[i].transferResidencyReceiptHash,
            transferResidencyEntryHash: schedule.decisions[i].transferResidencyEntryHash,
            decisionHash: schedule.decisions[i].decisionHash
        ))
    return Ok[DistributedKvResidencySchedule](DistributedKvResidencySchedule(
        schema: strings.CloneStr(schedule.schema),
        enginePlanHash: schedule.enginePlanHash,
        targetPeerId: strings.CloneStr(schedule.targetPeerId),
        maxResidentPages: schedule.maxResidentPages,
        nowNs: schedule.nowNs,
        requiredUntilNs: schedule.requiredUntilNs,
        transferEvidenceHash: schedule.transferEvidenceHash,
        transferResidencyReceiptHash: schedule.transferResidencyReceiptHash,
        existingReceiptSetHash: schedule.existingReceiptSetHash,
        requiredPageCount: schedule.requiredPageCount,
        reusedPageCount: schedule.reusedPageCount,
        transferredPageCount: schedule.transferredPageCount,
        evictedPageCount: schedule.evictedPageCount,
        finalResidentPageCount: schedule.finalResidentPageCount,
        decisionSetHash: schedule.decisionSetHash,
        scheduleHash: schedule.scheduleHash,
        decisions: decisions
    ))

@borrows
fn DistributedKvResidencyEntryMatchesPayload(entry: DistributedKvPageResidencyEntry,
                                             payload: DistributedKvPagePayload,
                                             targetPeerId: str): bool =
    return entry.targetPeerId == targetPeerId &&
           entry.seqId == payload.seqId &&
           entry.pageId == payload.pageId &&
           entry.pageOrdinal == payload.pageOrdinal &&
           entry.payloadHash == payload.payloadHash

fn DistributedKvResidencyDecisionMatchesPayload(decision: DistributedKvResidencyDecision,
                                                payload: DistributedKvPagePayload,
                                                targetPeerId: str): bool =
    return decision.targetPeerId == targetPeerId &&
           decision.seqId == payload.seqId &&
           decision.pageId == payload.pageId &&
           decision.pageOrdinal == payload.pageOrdinal &&
           decision.payloadHash == payload.payloadHash

fn DistributedKvResidencyEntryIsActive(entry: DistributedKvPageResidencyEntry,
                                       targetPeerId: str,
                                       nowNs: int64): bool =
    return entry.targetPeerId == targetPeerId && entry.validUntilNs > nowNs

fn DistributedKvResidencyDecisionReusesEntry(entry: DistributedKvPageResidencyEntry,
                                             decisions: DistributedKvResidencyDecision[]): bool =
    for i in 0..<decisions.len:
        if decisions[i].action == DistributedKvResidencyActionReuse &&
           decisions[i].sourceResidencyEntryHash == entry.entryHash:
            return true
    return false

@borrows
fn DistributedKvResidencyFindTransferEntry(receipt: DistributedKvPageResidencyReceipt,
                                           payload: DistributedKvPagePayload,
                                           targetPeerId: str,
                                           requiredUntilNs: int64): Result[DistributedKvPageResidencyEntry] =
    var found: int32 = -1
    for i in 0..<receipt.entries.len:
        let entry = receipt.entries[i]
        if DistributedKvResidencyEntryMatchesPayload(entry, payload, targetPeerId) &&
           entry.validUntilNs >= requiredUntilNs:
            if found >= 0:
                return Err[DistributedKvPageResidencyEntry]("distributed kv residency schedule: duplicate transfer entry")
            found = i
    if found < 0:
        return Err[DistributedKvPageResidencyEntry]("distributed kv residency schedule: missing transfer entry")
    return Ok[DistributedKvPageResidencyEntry](receipt.entries[found])

@borrows
fn DistributedKvResidencyFindExistingEntry(existingReceipts: DistributedKvPageResidencyReceipt[],
                                           payload: DistributedKvPagePayload,
                                           targetPeerId: str,
                                           nowNs: int64,
                                           requiredUntilNs: int64): Result[DistributedKvResidencyDecision] =
    var found: bool
    var foundReceiptHash: int64
    var foundEntry: DistributedKvPageResidencyEntry
    for r in 0..<existingReceipts.len:
        let receipt = existingReceipts[r]
        for e in 0..<receipt.entries.len:
            let entry = receipt.entries[e]
            if DistributedKvResidencyEntryMatchesPayload(entry, payload, targetPeerId) &&
               entry.residentSinceNs <= nowNs &&
               entry.validUntilNs >= requiredUntilNs:
                if found:
                    return Err[DistributedKvResidencyDecision]("distributed kv residency schedule: duplicate reusable entry")
                found = true
                foundReceiptHash = receipt.receiptHash
                foundEntry = entry
    if !found:
        return Err[DistributedKvResidencyDecision]("distributed kv residency schedule: reusable entry")
    let decision = DistributedKvResidencyDecisionBuild(DistributedKvResidencyDecision(
        schema: "",
        enginePlanHash: foundEntry.enginePlanHash,
        action: DistributedKvResidencyActionReuse,
        targetPeerId: strings.CloneStr(targetPeerId),
        seqId: foundEntry.seqId,
        pageId: foundEntry.pageId,
        pageOrdinal: foundEntry.pageOrdinal,
        payloadHash: foundEntry.payloadHash,
        sourceResidencyReceiptHash: foundReceiptHash,
        sourceResidencyEntryHash: foundEntry.entryHash,
        transferEvidenceHash: int64(0),
        transferResidencyReceiptHash: int64(0),
        transferResidencyEntryHash: int64(0),
        decisionHash: int64(0)
    ))
    return Ok[DistributedKvResidencyDecision](decision)

@borrows
fn DistributedBuildKvResidencySchedule(plan: DistributedInferencePlan,
                                       peers: DistributedInferencePeer[],
                                       kvCache: paged_kv_cache.PagedKVCache,
                                       kvSeq: paged_kv_cache.PagedKVSequence,
                                       transferEvidence: DistributedKvPageTransferEvidence,
                                       transferResidencyReceipt: DistributedKvPageResidencyReceipt,
                                       existingReceipts: DistributedKvPageResidencyReceipt[],
                                       maxResidentPages: int32,
                                       nowNs: int64,
                                       requiredUntilNs: int64): Result[DistributedKvResidencySchedule] =
    if maxResidentPages <= 0 || nowNs <= int64(0) || requiredUntilNs <= nowNs:
        return Err[DistributedKvResidencySchedule]("distributed kv residency schedule: limits")
    let transferEvidenceOk = DistributedValidateKvPageTransferEvidence(plan, peers, kvCache, kvSeq, transferEvidence)
    if IsErr(transferEvidenceOk):
        return Err[DistributedKvResidencySchedule](Error(transferEvidenceOk))
    if transferEvidence.schema != DistributedKvPageTransferEvidenceSchema ||
       transferEvidence.enginePlanHash != plan.engineHash ||
       transferEvidence.evidenceHash <= int64(0) ||
       DistributedKvPageTransferEvidenceHash(transferEvidence) != transferEvidence.evidenceHash:
        return Err[DistributedKvResidencySchedule]("distributed kv residency schedule: evidence")
    let target = DistributedKvPageTransferTargetPeer(transferEvidence)
    if IsErr(target):
        return Err[DistributedKvResidencySchedule](Error(target))
    if !DistributedPeerReady(peers, Value(target)):
        return Err[DistributedKvResidencySchedule]("distributed kv residency schedule: target")
    let transferReceiptOk = DistributedValidateKvPageResidencyReceipt(plan, peers, transferEvidence, transferResidencyReceipt)
    if IsErr(transferReceiptOk):
        return Err[DistributedKvResidencySchedule](Error(transferReceiptOk))
    if transferResidencyReceipt.targetPeerId != Value(target):
        return Err[DistributedKvResidencySchedule]("distributed kv residency schedule: transfer target")
    if transferEvidence.payloadStore.payloads.len <= 0 ||
       transferEvidence.payloadStore.payloads.len > maxResidentPages:
        return Err[DistributedKvResidencySchedule]("distributed kv residency schedule: capacity")
    for r in 0..<existingReceipts.len:
        let existingOk = DistributedValidateKvPageResidencyReceiptSelf(plan, peers, existingReceipts[r])
        if IsErr(existingOk):
            return Err[DistributedKvResidencySchedule](Error(existingOk))
    let existingSetHash = DistributedKvResidencyExistingReceiptSetHash(existingReceipts)
    var decisions: DistributedKvResidencyDecision[]
    var reusedCount: int32
    var transferredCount: int32
    for p in 0..<transferEvidence.payloadStore.payloads.len:
        let payload = transferEvidence.payloadStore.payloads[p]
        let reuse = DistributedKvResidencyFindExistingEntry(existingReceipts, payload, Value(target), nowNs, requiredUntilNs)
        if IsOk(reuse):
            add(decisions, Value(reuse))
            reusedCount = reusedCount + 1
        else:
            if Error(reuse) != "distributed kv residency schedule: reusable entry":
                return Err[DistributedKvResidencySchedule](Error(reuse))
            let transferEntry = DistributedKvResidencyFindTransferEntry(transferResidencyReceipt, payload, Value(target), requiredUntilNs)
            if IsErr(transferEntry):
                return Err[DistributedKvResidencySchedule](Error(transferEntry))
            let entry = Value(transferEntry)
            let decision = DistributedKvResidencyDecisionBuild(DistributedKvResidencyDecision(
                schema: "",
                enginePlanHash: plan.engineHash,
                action: DistributedKvResidencyActionTransfer,
                targetPeerId: strings.CloneStr(target),
                seqId: entry.seqId,
                pageId: entry.pageId,
                pageOrdinal: entry.pageOrdinal,
                payloadHash: entry.payloadHash,
                sourceResidencyReceiptHash: int64(0),
                sourceResidencyEntryHash: int64(0),
                transferEvidenceHash: transferEvidence.evidenceHash,
                transferResidencyReceiptHash: transferResidencyReceipt.receiptHash,
                transferResidencyEntryHash: entry.entryHash,
                decisionHash: int64(0)
            ))
            add(decisions, decision)
            transferredCount = transferredCount + 1
    var activeEntryHashes: int64[]
    var activeCount: int32
    for r in 0..<existingReceipts.len:
        for e in 0..<existingReceipts[r].entries.len:
            let entry = existingReceipts[r].entries[e]
            if DistributedKvResidencyEntryIsActive(entry, Value(target), nowNs):
                for h in 0..<activeEntryHashes.len:
                    if activeEntryHashes[h] == entry.entryHash:
                        return Err[DistributedKvResidencySchedule]("distributed kv residency schedule: duplicate active entry")
                add(activeEntryHashes, entry.entryHash)
                activeCount = activeCount + 1
    var finalResidentCount: int32 = activeCount + transferredCount
    var evictedCount: int32
    for r in 0..<existingReceipts.len:
        for e in 0..<existingReceipts[r].entries.len:
            let entry = existingReceipts[r].entries[e]
            if DistributedKvResidencyEntryIsActive(entry, Value(target), nowNs) &&
               !DistributedKvResidencyDecisionReusesEntry(entry, decisions) &&
               finalResidentCount > maxResidentPages:
                let evictDecision = DistributedKvResidencyDecisionBuild(DistributedKvResidencyDecision(
                    schema: "",
                    enginePlanHash: plan.engineHash,
                    action: DistributedKvResidencyActionEvict,
                    targetPeerId: Value(target),
                    seqId: entry.seqId,
                    pageId: entry.pageId,
                    pageOrdinal: entry.pageOrdinal,
                    payloadHash: entry.payloadHash,
                    sourceResidencyReceiptHash: existingReceipts[r].receiptHash,
                    sourceResidencyEntryHash: entry.entryHash,
                    transferEvidenceHash: int64(0),
                    transferResidencyReceiptHash: int64(0),
                    transferResidencyEntryHash: int64(0),
                    decisionHash: int64(0)
                ))
                add(decisions, evictDecision)
                evictedCount = evictedCount + 1
                finalResidentCount = finalResidentCount - 1
    if finalResidentCount > maxResidentPages:
        return Err[DistributedKvResidencySchedule]("distributed kv residency schedule: capacity after evict")
    let schedule = DistributedKvResidencyScheduleBuild(
        plan.engineHash,
        Value(target),
        maxResidentPages,
        nowNs,
        requiredUntilNs,
        transferEvidence.evidenceHash,
        transferResidencyReceipt.receiptHash,
        existingSetHash,
        transferEvidence.payloadStore.payloads.len,
        reusedCount,
        transferredCount,
        evictedCount,
        finalResidentCount,
        decisions
    )
    let ok = DistributedValidateKvResidencySchedule(
        plan,
        peers,
        kvCache,
        kvSeq,
        transferEvidence,
        transferResidencyReceipt,
        existingReceipts,
        schedule
    )
    if IsErr(ok):
        return Err[DistributedKvResidencySchedule](Error(ok))
    return Ok[DistributedKvResidencySchedule](schedule)

@borrows
fn DistributedValidateKvResidencySchedule(plan: DistributedInferencePlan,
                                          peers: DistributedInferencePeer[],
                                          kvCache: paged_kv_cache.PagedKVCache,
                                          kvSeq: paged_kv_cache.PagedKVSequence,
                                          transferEvidence: DistributedKvPageTransferEvidence,
                                          transferResidencyReceipt: DistributedKvPageResidencyReceipt,
                                          existingReceipts: DistributedKvPageResidencyReceipt[],
                                          schedule: DistributedKvResidencySchedule): Result[bool] =
    if schedule.schema != DistributedKvResidencyScheduleSchema ||
       schedule.enginePlanHash != plan.engineHash ||
       schedule.maxResidentPages <= 0 ||
       schedule.nowNs <= int64(0) ||
       schedule.requiredUntilNs <= schedule.nowNs ||
       schedule.transferEvidenceHash != transferEvidence.evidenceHash ||
       schedule.transferResidencyReceiptHash != transferResidencyReceipt.receiptHash ||
       schedule.requiredPageCount != transferEvidence.payloadStore.payloads.len:
        return Err[bool]("distributed kv residency schedule: schema")
    let transferEvidenceOk = DistributedValidateKvPageTransferEvidence(plan, peers, kvCache, kvSeq, transferEvidence)
    if IsErr(transferEvidenceOk):
        return Err[bool](Error(transferEvidenceOk))
    let target = DistributedKvPageTransferTargetPeer(transferEvidence)
    if IsErr(target):
        return Err[bool](Error(target))
    if schedule.targetPeerId != Value(target) || !DistributedPeerReady(peers, schedule.targetPeerId):
        return Err[bool]("distributed kv residency schedule: target")
    if schedule.requiredPageCount <= 0 || schedule.requiredPageCount > schedule.maxResidentPages:
        return Err[bool]("distributed kv residency schedule: required capacity")
    let transferReceiptOk = DistributedValidateKvPageResidencyReceipt(plan, peers, transferEvidence, transferResidencyReceipt)
    if IsErr(transferReceiptOk):
        return Err[bool](Error(transferReceiptOk))
    for r in 0..<existingReceipts.len:
        let existingOk = DistributedValidateKvPageResidencyReceiptSelf(plan, peers, existingReceipts[r])
        if IsErr(existingOk):
            return Err[bool](Error(existingOk))
    if DistributedKvResidencyExistingReceiptSetHash(existingReceipts) != schedule.existingReceiptSetHash:
        return Err[bool]("distributed kv residency schedule: existing set hash")
    var reuseCount: int32
    var transferCount: int32
    var evictCount: int32
    for i in 0..<schedule.decisions.len:
        let decision = schedule.decisions[i]
        if decision.schema != DistributedKvResidencyDecisionSchema ||
           decision.enginePlanHash != plan.engineHash ||
           decision.targetPeerId != schedule.targetPeerId ||
           decision.payloadHash <= int64(0):
            return Err[bool]("distributed kv residency decision: schema")
        if DistributedKvResidencyDecisionHash(decision) != decision.decisionHash:
            return Err[bool]("distributed kv residency decision: hash")
        for j in i + 1..<schedule.decisions.len:
            if decision.decisionHash == schedule.decisions[j].decisionHash:
                return Err[bool]("distributed kv residency decision: duplicate")
        if decision.action == DistributedKvResidencyActionReuse:
            if decision.sourceResidencyReceiptHash <= int64(0) ||
               decision.sourceResidencyEntryHash <= int64(0) ||
               decision.transferEvidenceHash != int64(0) ||
               decision.transferResidencyReceiptHash != int64(0) ||
               decision.transferResidencyEntryHash != int64(0):
                return Err[bool]("distributed kv residency reuse: fields")
            var foundReuse: bool
            for r in 0..<existingReceipts.len:
                if existingReceipts[r].receiptHash == decision.sourceResidencyReceiptHash:
                    for e in 0..<existingReceipts[r].entries.len:
                        let entry = existingReceipts[r].entries[e]
                        if entry.entryHash == decision.sourceResidencyEntryHash:
                            if foundReuse:
                                return Err[bool]("distributed kv residency reuse: duplicate")
                            if entry.seqId != decision.seqId ||
                               entry.pageId != decision.pageId ||
                               entry.pageOrdinal != decision.pageOrdinal ||
                               entry.payloadHash != decision.payloadHash ||
                               entry.targetPeerId != decision.targetPeerId ||
                               entry.residentSinceNs > schedule.nowNs ||
                               entry.validUntilNs < schedule.requiredUntilNs:
                                return Err[bool]("distributed kv residency reuse: binding")
                            foundReuse = true
            if !foundReuse:
                return Err[bool]("distributed kv residency reuse: missing")
            reuseCount = reuseCount + 1
        elif decision.action == DistributedKvResidencyActionTransfer:
            if decision.sourceResidencyReceiptHash != int64(0) ||
               decision.sourceResidencyEntryHash != int64(0) ||
               decision.transferEvidenceHash != transferEvidence.evidenceHash ||
               decision.transferResidencyReceiptHash != transferResidencyReceipt.receiptHash ||
               decision.transferResidencyEntryHash <= int64(0):
                return Err[bool]("distributed kv residency transfer: fields")
            var foundTransfer: bool
            for e in 0..<transferResidencyReceipt.entries.len:
                let entry = transferResidencyReceipt.entries[e]
                if entry.entryHash == decision.transferResidencyEntryHash:
                    if foundTransfer:
                        return Err[bool]("distributed kv residency transfer: duplicate")
                    if entry.seqId != decision.seqId ||
                       entry.pageId != decision.pageId ||
                       entry.pageOrdinal != decision.pageOrdinal ||
                       entry.payloadHash != decision.payloadHash ||
                       entry.targetPeerId != decision.targetPeerId ||
                       entry.validUntilNs < schedule.requiredUntilNs:
                        return Err[bool]("distributed kv residency transfer: binding")
                    foundTransfer = true
            if !foundTransfer:
                return Err[bool]("distributed kv residency transfer: missing")
            transferCount = transferCount + 1
        elif decision.action == DistributedKvResidencyActionEvict:
            if decision.sourceResidencyReceiptHash <= int64(0) ||
               decision.sourceResidencyEntryHash <= int64(0) ||
               decision.transferEvidenceHash != int64(0) ||
               decision.transferResidencyReceiptHash != int64(0) ||
               decision.transferResidencyEntryHash != int64(0):
                return Err[bool]("distributed kv residency evict: fields")
            var foundEvict: bool
            for r in 0..<existingReceipts.len:
                if existingReceipts[r].receiptHash == decision.sourceResidencyReceiptHash:
                    for e in 0..<existingReceipts[r].entries.len:
                        let entry = existingReceipts[r].entries[e]
                        if entry.entryHash == decision.sourceResidencyEntryHash:
                            if foundEvict:
                                return Err[bool]("distributed kv residency evict: duplicate")
                            if entry.seqId != decision.seqId ||
                               entry.pageId != decision.pageId ||
                               entry.pageOrdinal != decision.pageOrdinal ||
                               entry.payloadHash != decision.payloadHash ||
                               entry.targetPeerId != decision.targetPeerId ||
                               !DistributedKvResidencyEntryIsActive(entry, schedule.targetPeerId, schedule.nowNs) ||
                               DistributedKvResidencyDecisionReusesEntry(entry, schedule.decisions):
                                return Err[bool]("distributed kv residency evict: binding")
                            foundEvict = true
            if !foundEvict:
                return Err[bool]("distributed kv residency evict: missing")
            evictCount = evictCount + 1
        else:
            return Err[bool]("distributed kv residency decision: action")
    for p in 0..<transferEvidence.payloadStore.payloads.len:
        let payload = transferEvidence.payloadStore.payloads[p]
        var covered: int32
        for d in 0..<schedule.decisions.len:
            let decision = schedule.decisions[d]
            if (decision.action == DistributedKvResidencyActionReuse ||
                decision.action == DistributedKvResidencyActionTransfer) &&
               DistributedKvResidencyDecisionMatchesPayload(decision, payload, schedule.targetPeerId):
                covered = covered + 1
        if covered != 1:
            return Err[bool]("distributed kv residency schedule: required page coverage")
    var activeEntryHashes: int64[]
    var activeCount: int32
    for r in 0..<existingReceipts.len:
        for e in 0..<existingReceipts[r].entries.len:
            let entry = existingReceipts[r].entries[e]
            if DistributedKvResidencyEntryIsActive(entry, schedule.targetPeerId, schedule.nowNs):
                for h in 0..<activeEntryHashes.len:
                    if activeEntryHashes[h] == entry.entryHash:
                        return Err[bool]("distributed kv residency schedule: duplicate active")
                add(activeEntryHashes, entry.entryHash)
                activeCount = activeCount + 1
    let finalCount = activeCount - evictCount + transferCount
    if reuseCount != schedule.reusedPageCount ||
       transferCount != schedule.transferredPageCount ||
       evictCount != schedule.evictedPageCount ||
       finalCount != schedule.finalResidentPageCount ||
       finalCount > schedule.maxResidentPages:
        return Err[bool]("distributed kv residency schedule: counts")
    if DistributedKvResidencyDecisionSetHash(schedule.decisions) != schedule.decisionSetHash:
        return Err[bool]("distributed kv residency schedule: decision hash")
    if DistributedKvResidencyScheduleHash(schedule) != schedule.scheduleHash:
        return Err[bool]("distributed kv residency schedule: hash")
    return Ok[bool](true)

@borrows
fn DistributedKvResidencyStoreActiveEntrySetHash(entries: DistributedKvPageResidencyEntry[]): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, DistributedKvResidencyStoreSchema)
    h = DistributedHashStep(h, int64(entries.len))
    for i in 0..<entries.len:
        h = DistributedHashStep(h, entries[i].entryHash)
    return h

@borrows
fn DistributedKvResidencyStoreOperationSetHash(operationHashes: int64[]): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, DistributedKvResidencyStoreOperationSchema)
    h = DistributedHashStep(h, int64(operationHashes.len))
    for i in 0..<operationHashes.len:
        h = DistributedHashStep(h, operationHashes[i])
    return h

@borrows
fn DistributedKvResidencyStoreHash(store: DistributedKvResidencyStore): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, store.schema)
    h = DistributedHashStep(h, store.enginePlanHash)
    h = DistributedHashTextWith(h, store.targetPeerId)
    h = DistributedHashStep(h, int64(store.maxResidentPages))
    h = DistributedHashStep(h, store.updatedAtNs)
    h = DistributedHashStep(h, int64(store.activeEntryCount))
    h = DistributedHashStep(h, store.activeEntrySetHash)
    h = DistributedHashStep(h, store.operationSetHash)
    return h

fn DistributedKvResidencyStoreBuild(enginePlanHash: int64,
                                    targetPeerId: str,
                                    maxResidentPages: int32,
                                    updatedAtNs: int64,
                                    activeEntries: DistributedKvPageResidencyEntry[],
                                    operationHashes: int64[]): DistributedKvResidencyStore =
    var store = DistributedKvResidencyStore(
        schema: DistributedKvResidencyStoreSchema,
        enginePlanHash: enginePlanHash,
        targetPeerId: targetPeerId,
        maxResidentPages: maxResidentPages,
        updatedAtNs: updatedAtNs,
        activeEntryCount: activeEntries.len,
        activeEntrySetHash: int64(0),
        operationSetHash: int64(0),
        storeHash: int64(0),
        activeEntries: activeEntries,
        operationHashes: operationHashes
    )
    store.activeEntrySetHash = DistributedKvResidencyStoreActiveEntrySetHash(store.activeEntries)
    store.operationSetHash = DistributedKvResidencyStoreOperationSetHash(store.operationHashes)
    store.storeHash = DistributedKvResidencyStoreHash(store)
    return store

@borrows
fn DistributedValidateKvResidencyStore(plan: DistributedInferencePlan,
                                       peers: DistributedInferencePeer[],
                                       store: DistributedKvResidencyStore): Result[bool] =
    if store.schema != DistributedKvResidencyStoreSchema ||
       store.enginePlanHash != plan.engineHash ||
       store.targetPeerId == "" ||
       store.maxResidentPages <= 0 ||
       store.updatedAtNs <= int64(0) ||
       store.activeEntryCount != store.activeEntries.len ||
       store.activeEntries.len > store.maxResidentPages:
        return Err[bool]("distributed kv residency store: schema")
    if !DistributedPeerReady(peers, store.targetPeerId):
        return Err[bool]("distributed kv residency store: target")
    for i in 0..<store.operationHashes.len:
        if store.operationHashes[i] <= int64(0):
            return Err[bool]("distributed kv residency store: operation hash")
        for j in i + 1..<store.operationHashes.len:
            if store.operationHashes[i] == store.operationHashes[j]:
                return Err[bool]("distributed kv residency store: duplicate operation")
    for i in 0..<store.activeEntries.len:
        let entry = store.activeEntries[i]
        if entry.schema != DistributedKvPageResidencyEntrySchema ||
           entry.enginePlanHash != plan.engineHash ||
           entry.targetPeerId != store.targetPeerId ||
           entry.residentSinceNs > store.updatedAtNs ||
           entry.validUntilNs <= store.updatedAtNs:
            return Err[bool]("distributed kv residency store: entry")
        if DistributedKvPageResidencyEntryHash(entry) != entry.entryHash:
            return Err[bool]("distributed kv residency store: entry hash")
        for j in i + 1..<store.activeEntries.len:
            let other = store.activeEntries[j]
            if entry.entryHash == other.entryHash ||
               (entry.seqId == other.seqId &&
                entry.pageId == other.pageId &&
                entry.pageOrdinal == other.pageOrdinal &&
                entry.targetPeerId == other.targetPeerId):
                return Err[bool]("distributed kv residency store: duplicate entry")
    if DistributedKvResidencyStoreActiveEntrySetHash(store.activeEntries) != store.activeEntrySetHash:
        return Err[bool]("distributed kv residency store: active hash")
    if DistributedKvResidencyStoreOperationSetHash(store.operationHashes) != store.operationSetHash:
        return Err[bool]("distributed kv residency store: operation set hash")
    if DistributedKvResidencyStoreHash(store) != store.storeHash:
        return Err[bool]("distributed kv residency store: hash")
    return Ok[bool](true)

@borrows
fn DistributedBuildEmptyKvResidencyStore(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[],
                                         targetPeerId: str,
                                         maxResidentPages: int32,
                                         nowNs: int64): Result[DistributedKvResidencyStore] =
    if targetPeerId == "" || maxResidentPages <= 0 || nowNs <= int64(0):
        return Err[DistributedKvResidencyStore]("distributed kv residency store: empty args")
    if !DistributedPeerReady(peers, targetPeerId):
        return Err[DistributedKvResidencyStore]("distributed kv residency store: empty target")
    var entries: DistributedKvPageResidencyEntry[]
    var ops: int64[]
    let store = DistributedKvResidencyStoreBuild(plan.engineHash, targetPeerId, maxResidentPages, nowNs, entries, ops)
    let ok = DistributedValidateKvResidencyStore(plan, peers, store)
    if IsErr(ok):
        return Err[DistributedKvResidencyStore](Error(ok))
    return Ok[DistributedKvResidencyStore](store)

@borrows
fn DistributedKvResidencyStoreExistingReceipts(store: DistributedKvResidencyStore): DistributedKvPageResidencyReceipt[] =
    var receipts: DistributedKvPageResidencyReceipt[]
    if store.activeEntries.len <= 0:
        return receipts
    let receipt = DistributedKvPageResidencyReceiptBuild(
        store.enginePlanHash,
        store.targetPeerId,
        store.storeHash,
        store.activeEntries
    )
    add(receipts, receipt)
    return receipts

fn DistributedKvResidencyDecisionEvictsEntry(entry: DistributedKvPageResidencyEntry,
                                             decisions: DistributedKvResidencyDecision[]): bool =
    for i in 0..<decisions.len:
        if decisions[i].action == DistributedKvResidencyActionEvict &&
           decisions[i].sourceResidencyEntryHash == entry.entryHash:
            return true
    return false

@borrows
fn DistributedKvResidencyFindTransferEntryByHash(receipt: DistributedKvPageResidencyReceipt,
                                                 entryHash: int64): Result[DistributedKvPageResidencyEntry] =
    for i in 0..<receipt.entries.len:
        if receipt.entries[i].entryHash == entryHash:
            return Ok[DistributedKvPageResidencyEntry](receipt.entries[i])
    return Err[DistributedKvPageResidencyEntry]("distributed kv residency store: transfer entry")

@borrows
fn DistributedKvResidencyStoreOperationHash(operation: DistributedKvResidencyStoreOperation): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, operation.schema)
    h = DistributedHashStep(h, operation.enginePlanHash)
    h = DistributedHashTextWith(h, operation.targetPeerId)
    h = DistributedHashStep(h, operation.previousStoreHash)
    h = DistributedHashStep(h, operation.scheduleHash)
    h = DistributedHashStep(h, operation.transferResidencyReceiptHash)
    h = DistributedHashStep(h, operation.newActiveEntrySetHash)
    h = DistributedHashStep(h, operation.appliedAtNs)
    h = DistributedHashStep(h, int64(operation.reusedPageCount))
    h = DistributedHashStep(h, int64(operation.transferredPageCount))
    h = DistributedHashStep(h, int64(operation.evictedPageCount))
    h = DistributedHashStep(h, int64(operation.finalResidentPageCount))
    return h

fn DistributedKvResidencyStoreOperationBuild(draft: DistributedKvResidencyStoreOperation): DistributedKvResidencyStoreOperation =
    var operation = draft
    operation.schema = DistributedKvResidencyStoreOperationSchema
    operation.operationHash = int64(0)
    operation.operationHash = DistributedKvResidencyStoreOperationHash(operation)
    return operation

@borrows
fn DistributedKvResidencyStoreUpdateHash(update: DistributedKvResidencyStoreUpdate): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, update.schema)
    h = DistributedHashStep(h, update.operation.operationHash)
    h = DistributedHashStep(h, update.store.storeHash)
    return h

fn DistributedKvResidencyStoreUpdateBuild(operation: DistributedKvResidencyStoreOperation,
                                          store: DistributedKvResidencyStore): DistributedKvResidencyStoreUpdate =
    var update = DistributedKvResidencyStoreUpdate(
        schema: DistributedKvResidencyStoreUpdateSchema,
        operation: operation,
        store: store,
        updateHash: int64(0)
    )
    update.updateHash = DistributedKvResidencyStoreUpdateHash(update)
    return update

@borrows
fn DistributedApplyKvResidencyScheduleToStore(plan: DistributedInferencePlan,
                                              peers: DistributedInferencePeer[],
                                              kvCache: paged_kv_cache.PagedKVCache,
                                              kvSeq: paged_kv_cache.PagedKVSequence,
                                              transferEvidence: DistributedKvPageTransferEvidence,
                                              transferResidencyReceipt: DistributedKvPageResidencyReceipt,
                                              previousStore: DistributedKvResidencyStore,
                                              schedule: DistributedKvResidencySchedule): Result[DistributedKvResidencyStoreUpdate] =
    let previousOk = DistributedValidateKvResidencyStore(plan, peers, previousStore)
    if IsErr(previousOk):
        return Err[DistributedKvResidencyStoreUpdate](Error(previousOk))
    let existingReceipts = DistributedKvResidencyStoreExistingReceipts(previousStore)
    let scheduleOk = DistributedValidateKvResidencySchedule(
        plan,
        peers,
        kvCache,
        kvSeq,
        transferEvidence,
        transferResidencyReceipt,
        existingReceipts,
        schedule
    )
    if IsErr(scheduleOk):
        return Err[DistributedKvResidencyStoreUpdate](Error(scheduleOk))
    if previousStore.targetPeerId != schedule.targetPeerId ||
       previousStore.maxResidentPages != schedule.maxResidentPages ||
       previousStore.storeHash <= int64(0):
        return Err[DistributedKvResidencyStoreUpdate]("distributed kv residency store apply: binding")
    var activeEntries: DistributedKvPageResidencyEntry[]
    for i in 0..<previousStore.activeEntries.len:
        let entry = previousStore.activeEntries[i]
        if DistributedKvResidencyEntryIsActive(entry, schedule.targetPeerId, schedule.nowNs) &&
           !DistributedKvResidencyDecisionEvictsEntry(entry, schedule.decisions):
            add(activeEntries, entry)
    for d in 0..<schedule.decisions.len:
        let decision = schedule.decisions[d]
        if decision.action == DistributedKvResidencyActionTransfer:
            let transferEntry = DistributedKvResidencyFindTransferEntryByHash(
                transferResidencyReceipt,
                decision.transferResidencyEntryHash
            )
            if IsErr(transferEntry):
                return Err[DistributedKvResidencyStoreUpdate](Error(transferEntry))
            add(activeEntries, Value(transferEntry))
    if activeEntries.len != schedule.finalResidentPageCount:
        return Err[DistributedKvResidencyStoreUpdate]("distributed kv residency store apply: final count")
    var operationHashes: int64[]
    for o in 0..<previousStore.operationHashes.len:
        add(operationHashes, previousStore.operationHashes[o])
    let activeSetHash = DistributedKvResidencyStoreActiveEntrySetHash(activeEntries)
    let operationDraft = DistributedKvResidencyStoreOperationBuild(DistributedKvResidencyStoreOperation(
        schema: "",
        enginePlanHash: plan.engineHash,
        targetPeerId: schedule.targetPeerId,
        previousStoreHash: previousStore.storeHash,
        scheduleHash: schedule.scheduleHash,
        transferResidencyReceiptHash: transferResidencyReceipt.receiptHash,
        newActiveEntrySetHash: activeSetHash,
        appliedAtNs: schedule.nowNs,
        reusedPageCount: schedule.reusedPageCount,
        transferredPageCount: schedule.transferredPageCount,
        evictedPageCount: schedule.evictedPageCount,
        finalResidentPageCount: schedule.finalResidentPageCount,
        operationHash: int64(0)
    ))
    add(operationHashes, operationDraft.operationHash)
    let newStore = DistributedKvResidencyStoreBuild(
        plan.engineHash,
        schedule.targetPeerId,
        schedule.maxResidentPages,
        schedule.nowNs,
        activeEntries,
        operationHashes
    )
    let storeOk = DistributedValidateKvResidencyStore(plan, peers, newStore)
    if IsErr(storeOk):
        return Err[DistributedKvResidencyStoreUpdate](Error(storeOk))
    let update = DistributedKvResidencyStoreUpdateBuild(operationDraft, newStore)
    if DistributedKvResidencyStoreUpdateHash(update) != update.updateHash:
        return Err[DistributedKvResidencyStoreUpdate]("distributed kv residency store update: hash")
    return Ok[DistributedKvResidencyStoreUpdate](update)

@borrows
fn DistributedKvResidencyWalRecordHash(record: DistributedKvResidencyWalRecord): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, record.schema)
    h = DistributedHashStep(h, record.enginePlanHash)
    h = DistributedHashTextWith(h, record.targetPeerId)
    h = DistributedHashStep(h, int64(record.recordSeq))
    h = DistributedHashStep(h, record.previousRecordHash)
    h = DistributedHashStep(h, record.previousStoreHash)
    h = DistributedHashStep(h, record.operationHash)
    h = DistributedHashStep(h, record.updateHash)
    h = DistributedHashStep(h, record.newStoreHash)
    h = DistributedHashStep(h, record.appendedAtNs)
    return h

fn DistributedKvResidencyWalRecordBuild(draft: DistributedKvResidencyWalRecord): DistributedKvResidencyWalRecord =
    var record = draft
    record.schema = DistributedKvResidencyWalRecordSchema
    record.recordHash = int64(0)
    record.recordHash = DistributedKvResidencyWalRecordHash(record)
    return record

@borrows
fn DistributedKvResidencyWalRecordSetHash(records: DistributedKvResidencyWalRecord[]): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, DistributedKvResidencyWalRecordSchema)
    h = DistributedHashStep(h, int64(records.len))
    for i in 0..<records.len:
        h = DistributedHashStep(h, records[i].recordHash)
    return h

@borrows
fn DistributedKvResidencyWalLogHash(log: DistributedKvResidencyWalLog): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, log.schema)
    h = DistributedHashStep(h, log.enginePlanHash)
    h = DistributedHashTextWith(h, log.targetPeerId)
    h = DistributedHashStep(h, log.baseStoreHash)
    h = DistributedHashStep(h, int64(log.recordCount))
    h = DistributedHashStep(h, log.headRecordHash)
    h = DistributedHashStep(h, log.finalStoreHash)
    h = DistributedHashStep(h, log.recordSetHash)
    return h

fn DistributedKvResidencyWalLogBuild(enginePlanHash: int64,
                                     targetPeerId: str,
                                     baseStoreHash: int64,
                                     finalStoreHash: int64,
                                     records: DistributedKvResidencyWalRecord[]): DistributedKvResidencyWalLog =
    var head: int64
    if records.len > 0:
        head = records[records.len - 1].recordHash
    var log = DistributedKvResidencyWalLog(
        schema: DistributedKvResidencyWalLogSchema,
        enginePlanHash: enginePlanHash,
        targetPeerId: targetPeerId,
        baseStoreHash: baseStoreHash,
        recordCount: records.len,
        headRecordHash: head,
        finalStoreHash: finalStoreHash,
        recordSetHash: int64(0),
        logHash: int64(0),
        records: records
    )
    log.recordSetHash = DistributedKvResidencyWalRecordSetHash(log.records)
    log.logHash = DistributedKvResidencyWalLogHash(log)
    return log

@borrows
fn DistributedValidateKvResidencyWalRecord(plan: DistributedInferencePlan,
                                           record: DistributedKvResidencyWalRecord,
                                           targetPeerId: str,
                                           expectedSeq: int32,
                                           expectedPrevRecordHash: int64,
                                           expectedPrevStoreHash: int64): Result[bool] =
    if record.schema != DistributedKvResidencyWalRecordSchema ||
       record.enginePlanHash != plan.engineHash ||
       record.targetPeerId != targetPeerId ||
       record.recordSeq != expectedSeq ||
       record.previousRecordHash != expectedPrevRecordHash ||
       record.previousStoreHash != expectedPrevStoreHash ||
       record.operationHash <= int64(0) ||
       record.updateHash <= int64(0) ||
       record.newStoreHash <= int64(0) ||
       record.appendedAtNs <= int64(0):
        return Err[bool]("distributed kv residency wal record: schema")
    if DistributedKvResidencyWalRecordHash(record) != record.recordHash:
        return Err[bool]("distributed kv residency wal record: hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateKvResidencyWalLog(plan: DistributedInferencePlan,
                                        peers: DistributedInferencePeer[],
                                        log: DistributedKvResidencyWalLog): Result[bool] =
    if log.schema != DistributedKvResidencyWalLogSchema ||
       log.enginePlanHash != plan.engineHash ||
       log.targetPeerId == "" ||
       log.baseStoreHash <= int64(0) ||
       log.finalStoreHash <= int64(0) ||
       log.recordCount != log.records.len:
        return Err[bool]("distributed kv residency wal log: schema")
    if !DistributedPeerReady(peers, log.targetPeerId):
        return Err[bool]("distributed kv residency wal log: target")
    var expectedPrevRecordHash: int64
    var expectedPrevStoreHash: int64 = log.baseStoreHash
    for i in 0..<log.records.len:
        let recordOk = DistributedValidateKvResidencyWalRecord(
            plan,
            log.records[i],
            log.targetPeerId,
            i,
            expectedPrevRecordHash,
            expectedPrevStoreHash
        )
        if IsErr(recordOk):
            return Err[bool](Error(recordOk))
        expectedPrevRecordHash = log.records[i].recordHash
        expectedPrevStoreHash = log.records[i].newStoreHash
    if log.records.len > 0:
        if log.headRecordHash != log.records[log.records.len - 1].recordHash:
            return Err[bool]("distributed kv residency wal log: head")
        if log.finalStoreHash != log.records[log.records.len - 1].newStoreHash:
            return Err[bool]("distributed kv residency wal log: final store")
    else:
        if log.headRecordHash != int64(0) || log.finalStoreHash != log.baseStoreHash:
            return Err[bool]("distributed kv residency wal log: empty")
    if DistributedKvResidencyWalRecordSetHash(log.records) != log.recordSetHash:
        return Err[bool]("distributed kv residency wal log: record set hash")
    if DistributedKvResidencyWalLogHash(log) != log.logHash:
        return Err[bool]("distributed kv residency wal log: hash")
    return Ok[bool](true)

@borrows
fn DistributedBuildEmptyKvResidencyWalLog(plan: DistributedInferencePlan,
                                          peers: DistributedInferencePeer[],
                                          baseStore: DistributedKvResidencyStore): Result[DistributedKvResidencyWalLog] =
    let storeOk = DistributedValidateKvResidencyStore(plan, peers, baseStore)
    if IsErr(storeOk):
        return Err[DistributedKvResidencyWalLog](Error(storeOk))
    var records: DistributedKvResidencyWalRecord[]
    let log = DistributedKvResidencyWalLogBuild(
        plan.engineHash,
        baseStore.targetPeerId,
        baseStore.storeHash,
        baseStore.storeHash,
        records
    )
    let logOk = DistributedValidateKvResidencyWalLog(plan, peers, log)
    if IsErr(logOk):
        return Err[DistributedKvResidencyWalLog](Error(logOk))
    return Ok[DistributedKvResidencyWalLog](log)

@borrows
fn DistributedKvResidencyWalAppendReceiptHash(receipt: DistributedKvResidencyWalAppendReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashStep(h, receipt.record.recordHash)
    h = DistributedHashStep(h, receipt.update.updateHash)
    h = DistributedHashStep(h, receipt.log.logHash)
    return h

fn DistributedKvResidencyWalAppendReceiptBuild(record: DistributedKvResidencyWalRecord,
                                               update: DistributedKvResidencyStoreUpdate,
                                               log: DistributedKvResidencyWalLog): DistributedKvResidencyWalAppendReceipt =
    var receipt = DistributedKvResidencyWalAppendReceipt(
        schema: DistributedKvResidencyWalAppendReceiptSchema,
        record: record,
        update: update,
        log: log,
        appendHash: int64(0)
    )
    receipt.appendHash = DistributedKvResidencyWalAppendReceiptHash(receipt)
    return receipt

@borrows
fn DistributedValidateKvResidencyStoreUpdate(plan: DistributedInferencePlan,
                                             peers: DistributedInferencePeer[],
                                             update: DistributedKvResidencyStoreUpdate): Result[bool] =
    if update.schema != DistributedKvResidencyStoreUpdateSchema:
        return Err[bool]("distributed kv residency store update validate: schema")
    if update.operation.schema != DistributedKvResidencyStoreOperationSchema ||
       update.operation.enginePlanHash != plan.engineHash ||
       update.operation.operationHash <= int64(0) ||
       DistributedKvResidencyStoreOperationHash(update.operation) != update.operation.operationHash:
        return Err[bool]("distributed kv residency store update validate: operation")
    let storeOk = DistributedValidateKvResidencyStore(plan, peers, update.store)
    if IsErr(storeOk):
        return Err[bool](Error(storeOk))
    if update.operation.newActiveEntrySetHash != update.store.activeEntrySetHash ||
       update.operation.finalResidentPageCount != update.store.activeEntryCount:
        return Err[bool]("distributed kv residency store update validate: binding")
    if DistributedKvResidencyStoreUpdateHash(update) != update.updateHash:
        return Err[bool]("distributed kv residency store update validate: hash")
    return Ok[bool](true)

@borrows
fn DistributedAppendKvResidencyWal(plan: DistributedInferencePlan,
                                   peers: DistributedInferencePeer[],
                                   currentLog: DistributedKvResidencyWalLog,
                                   previousStore: DistributedKvResidencyStore,
                                   update: DistributedKvResidencyStoreUpdate,
                                   appendedAtNs: int64): Result[DistributedKvResidencyWalAppendReceipt] =
    if appendedAtNs <= int64(0):
        return Err[DistributedKvResidencyWalAppendReceipt]("distributed kv residency wal append: time")
    let logOk = DistributedValidateKvResidencyWalLog(plan, peers, currentLog)
    if IsErr(logOk):
        return Err[DistributedKvResidencyWalAppendReceipt](Error(logOk))
    let previousOk = DistributedValidateKvResidencyStore(plan, peers, previousStore)
    if IsErr(previousOk):
        return Err[DistributedKvResidencyWalAppendReceipt](Error(previousOk))
    let updateOk = DistributedValidateKvResidencyStoreUpdate(plan, peers, update)
    if IsErr(updateOk):
        return Err[DistributedKvResidencyWalAppendReceipt](Error(updateOk))
    if currentLog.targetPeerId != previousStore.targetPeerId ||
       currentLog.finalStoreHash != previousStore.storeHash ||
       update.operation.previousStoreHash != previousStore.storeHash ||
       update.store.targetPeerId != previousStore.targetPeerId:
        return Err[DistributedKvResidencyWalAppendReceipt]("distributed kv residency wal append: binding")
    var records: DistributedKvResidencyWalRecord[]
    for i in 0..<currentLog.records.len:
        add(records, currentLog.records[i])
    let record = DistributedKvResidencyWalRecordBuild(DistributedKvResidencyWalRecord(
        schema: "",
        enginePlanHash: plan.engineHash,
        targetPeerId: previousStore.targetPeerId,
        recordSeq: currentLog.recordCount,
        previousRecordHash: currentLog.headRecordHash,
        previousStoreHash: previousStore.storeHash,
        operationHash: update.operation.operationHash,
        updateHash: update.updateHash,
        newStoreHash: update.store.storeHash,
        appendedAtNs: appendedAtNs,
        recordHash: int64(0)
    ))
    add(records, record)
    let newLog = DistributedKvResidencyWalLogBuild(
        plan.engineHash,
        previousStore.targetPeerId,
        currentLog.baseStoreHash,
        update.store.storeHash,
        records
    )
    let newLogOk = DistributedValidateKvResidencyWalLog(plan, peers, newLog)
    if IsErr(newLogOk):
        return Err[DistributedKvResidencyWalAppendReceipt](Error(newLogOk))
    let receipt = DistributedKvResidencyWalAppendReceiptBuild(record, update, newLog)
    let receiptOk = DistributedValidateKvResidencyWalAppendReceipt(plan, peers, currentLog, previousStore, receipt)
    if IsErr(receiptOk):
        return Err[DistributedKvResidencyWalAppendReceipt](Error(receiptOk))
    return Ok[DistributedKvResidencyWalAppendReceipt](receipt)

@borrows
fn DistributedValidateKvResidencyWalAppendReceipt(plan: DistributedInferencePlan,
                                                  peers: DistributedInferencePeer[],
                                                  previousLog: DistributedKvResidencyWalLog,
                                                  previousStore: DistributedKvResidencyStore,
                                                  receipt: DistributedKvResidencyWalAppendReceipt): Result[bool] =
    if receipt.schema != DistributedKvResidencyWalAppendReceiptSchema:
        return Err[bool]("distributed kv residency wal append receipt: schema")
    let previousLogOk = DistributedValidateKvResidencyWalLog(plan, peers, previousLog)
    if IsErr(previousLogOk):
        return Err[bool](Error(previousLogOk))
    let previousStoreOk = DistributedValidateKvResidencyStore(plan, peers, previousStore)
    if IsErr(previousStoreOk):
        return Err[bool](Error(previousStoreOk))
    let updateOk = DistributedValidateKvResidencyStoreUpdate(plan, peers, receipt.update)
    if IsErr(updateOk):
        return Err[bool](Error(updateOk))
    if receipt.record.previousRecordHash != previousLog.headRecordHash ||
       receipt.record.previousStoreHash != previousStore.storeHash ||
       receipt.record.operationHash != receipt.update.operation.operationHash ||
       receipt.record.updateHash != receipt.update.updateHash ||
       receipt.record.newStoreHash != receipt.update.store.storeHash ||
       receipt.record.recordSeq != previousLog.recordCount ||
       receipt.log.recordCount != previousLog.recordCount + 1 ||
       receipt.log.headRecordHash != receipt.record.recordHash ||
       receipt.log.finalStoreHash != receipt.update.store.storeHash ||
       receipt.log.baseStoreHash != previousLog.baseStoreHash:
        return Err[bool]("distributed kv residency wal append receipt: binding")
    for prefixIndex in 0..<previousLog.records.len:
        if receipt.log.records[prefixIndex].recordHash != previousLog.records[prefixIndex].recordHash:
            return Err[bool]("distributed kv residency wal append receipt: prefix")
    if receipt.log.records[previousLog.records.len].recordHash != receipt.record.recordHash:
        return Err[bool]("distributed kv residency wal append receipt: tail")
    let recordOk = DistributedValidateKvResidencyWalRecord(
        plan,
        receipt.record,
        previousLog.targetPeerId,
        previousLog.recordCount,
        previousLog.headRecordHash,
        previousStore.storeHash
    )
    if IsErr(recordOk):
        return Err[bool](Error(recordOk))
    let logOk = DistributedValidateKvResidencyWalLog(plan, peers, receipt.log)
    if IsErr(logOk):
        return Err[bool](Error(logOk))
    if DistributedKvResidencyWalAppendReceiptHash(receipt) != receipt.appendHash:
        return Err[bool]("distributed kv residency wal append receipt: hash")
    return Ok[bool](true)

@borrows
fn DistributedKvResidencyWalReplayReceiptHash(receipt: DistributedKvResidencyWalReplayReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashStep(h, receipt.baseStoreHash)
    h = DistributedHashStep(h, receipt.finalStoreHash)
    h = DistributedHashStep(h, int64(receipt.recordCount))
    h = DistributedHashStep(h, receipt.headRecordHash)
    h = DistributedHashStep(h, receipt.logHash)
    return h

@borrows
fn DistributedBuildKvResidencyWalReplayReceipt(plan: DistributedInferencePlan,
                                               peers: DistributedInferencePeer[],
                                               baseStore: DistributedKvResidencyStore,
                                               appends: DistributedKvResidencyWalAppendReceipt[]): Result[DistributedKvResidencyWalReplayReceipt] =
    let baseOk = DistributedValidateKvResidencyStore(plan, peers, baseStore)
    if IsErr(baseOk):
        return Err[DistributedKvResidencyWalReplayReceipt](Error(baseOk))
    let emptyLog = DistributedBuildEmptyKvResidencyWalLog(plan, peers, baseStore)
    if IsErr(emptyLog):
        return Err[DistributedKvResidencyWalReplayReceipt](Error(emptyLog))
    var currentLog = Value(emptyLog)
    var currentStore = baseStore
    for i in 0..<appends.len:
        let appendOk = DistributedValidateKvResidencyWalAppendReceipt(
            plan,
            peers,
            currentLog,
            currentStore,
            appends[i]
        )
        if IsErr(appendOk):
            return Err[DistributedKvResidencyWalReplayReceipt](Error(appendOk))
        currentLog = appends[i].log
        currentStore = appends[i].update.store
    let replay = DistributedKvResidencyWalReplayReceipt(
        schema: DistributedKvResidencyWalReplayReceiptSchema,
        enginePlanHash: plan.engineHash,
        targetPeerId: baseStore.targetPeerId,
        baseStoreHash: baseStore.storeHash,
        finalStoreHash: currentStore.storeHash,
        recordCount: currentLog.recordCount,
        headRecordHash: currentLog.headRecordHash,
        logHash: currentLog.logHash,
        replayHash: int64(0)
    )
    var out = replay
    out.replayHash = DistributedKvResidencyWalReplayReceiptHash(out)
    let ok = DistributedValidateKvResidencyWalReplayReceipt(plan, peers, baseStore, appends, out)
    if IsErr(ok):
        return Err[DistributedKvResidencyWalReplayReceipt](Error(ok))
    return Ok[DistributedKvResidencyWalReplayReceipt](out)

@borrows
fn DistributedValidateKvResidencyWalReplayReceipt(plan: DistributedInferencePlan,
                                                  peers: DistributedInferencePeer[],
                                                  baseStore: DistributedKvResidencyStore,
                                                  appends: DistributedKvResidencyWalAppendReceipt[],
                                                  receipt: DistributedKvResidencyWalReplayReceipt): Result[bool] =
    let rebuilt = DistributedBuildKvResidencyWalReplayReceiptNoValidate(plan, peers, baseStore, appends)
    if IsErr(rebuilt):
        return Err[bool](Error(rebuilt))
    let expected = Value(rebuilt)
    if receipt.schema != DistributedKvResidencyWalReplayReceiptSchema ||
       receipt.enginePlanHash != expected.enginePlanHash ||
       receipt.targetPeerId != expected.targetPeerId ||
       receipt.baseStoreHash != expected.baseStoreHash ||
       receipt.finalStoreHash != expected.finalStoreHash ||
       receipt.recordCount != expected.recordCount ||
       receipt.headRecordHash != expected.headRecordHash ||
       receipt.logHash != expected.logHash ||
       DistributedKvResidencyWalReplayReceiptHash(receipt) != receipt.replayHash ||
       receipt.replayHash != expected.replayHash:
        return Err[bool]("distributed kv residency wal replay receipt: mismatch")
    return Ok[bool](true)

@borrows
fn DistributedBuildKvResidencyWalReplayReceiptNoValidate(plan: DistributedInferencePlan,
                                                         peers: DistributedInferencePeer[],
                                                         baseStore: DistributedKvResidencyStore,
                                                         appends: DistributedKvResidencyWalAppendReceipt[]): Result[DistributedKvResidencyWalReplayReceipt] =
    let baseOk = DistributedValidateKvResidencyStore(plan, peers, baseStore)
    if IsErr(baseOk):
        return Err[DistributedKvResidencyWalReplayReceipt](Error(baseOk))
    let emptyLog = DistributedBuildEmptyKvResidencyWalLog(plan, peers, baseStore)
    if IsErr(emptyLog):
        return Err[DistributedKvResidencyWalReplayReceipt](Error(emptyLog))
    var currentLog = Value(emptyLog)
    var currentStore = baseStore
    for i in 0..<appends.len:
        let appendOk = DistributedValidateKvResidencyWalAppendReceipt(plan, peers, currentLog, currentStore, appends[i])
        if IsErr(appendOk):
            return Err[DistributedKvResidencyWalReplayReceipt](Error(appendOk))
        currentLog = appends[i].log
        currentStore = appends[i].update.store
    var out = DistributedKvResidencyWalReplayReceipt(
        schema: DistributedKvResidencyWalReplayReceiptSchema,
        enginePlanHash: plan.engineHash,
        targetPeerId: baseStore.targetPeerId,
        baseStoreHash: baseStore.storeHash,
        finalStoreHash: currentStore.storeHash,
        recordCount: currentLog.recordCount,
        headRecordHash: currentLog.headRecordHash,
        logHash: currentLog.logHash,
        replayHash: int64(0)
    )
    out.replayHash = DistributedKvResidencyWalReplayReceiptHash(out)
    return Ok[DistributedKvResidencyWalReplayReceipt](out)

fn DistributedHashBytesWith(hashRaw: int64, bytes: rawbytes.Bytes): int64 =
    var h: int64 = hashRaw
    h = DistributedHashStep(h, int64(rawbytes.BytesLen(bytes)))
    for i in 0..<rawbytes.BytesLen(bytes):
        h = DistributedHashStep(h, int64(rawbytes.BytesGet(bytes, i) & 255))
    return h

@borrows
fn DistributedKvResidencyWalFileByteHash(bytes: rawbytes.Bytes): int64 =
    return DistributedHashBytesWith(int64(149), bytes)

@borrows
fn DistributedKvResidencyWalFileReceiptHash(receipt: DistributedKvResidencyWalFileReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashTextWith(h, receipt.path)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashStep(h, receipt.baseStoreHash)
    h = DistributedHashStep(h, receipt.finalStoreHash)
    h = DistributedHashStep(h, int64(receipt.recordCount))
    h = DistributedHashStep(h, receipt.headRecordHash)
    h = DistributedHashStep(h, receipt.recordSetHash)
    h = DistributedHashStep(h, receipt.logHash)
    h = DistributedHashStep(h, int64(receipt.byteCount))
    h = DistributedHashStep(h, receipt.byteHash)
    return h

fn DistributedKvResidencyWalFileReceiptBuild(path: str,
                                             log: DistributedKvResidencyWalLog,
                                             bytes: rawbytes.Bytes): DistributedKvResidencyWalFileReceipt =
    var receipt = DistributedKvResidencyWalFileReceipt(
        schema: DistributedKvResidencyWalFileReceiptSchema,
        path: path,
        enginePlanHash: log.enginePlanHash,
        targetPeerId: log.targetPeerId,
        baseStoreHash: log.baseStoreHash,
        finalStoreHash: log.finalStoreHash,
        recordCount: log.recordCount,
        headRecordHash: log.headRecordHash,
        recordSetHash: log.recordSetHash,
        logHash: log.logHash,
        byteCount: rawbytes.BytesLen(bytes),
        byteHash: DistributedKvResidencyWalFileByteHash(bytes),
        receiptHash: int64(0)
    )
    receipt.receiptHash = DistributedKvResidencyWalFileReceiptHash(receipt)
    return receipt

fn DistributedKvResidencyWalFileHeaderWord(log: DistributedKvResidencyWalLog,
                                           index: int32): int64 =
    if index == 0:
        return int64(DistributedKvResidencyWalFileMagic)
    if index == 1:
        return int64(DistributedKvResidencyWalFileVersion)
    if index == 2:
        return log.enginePlanHash
    if index == 3:
        return DistributedTransportFrameTextHash(log.targetPeerId)
    if index == 4:
        return log.baseStoreHash
    if index == 5:
        return int64(log.recordCount)
    if index == 6:
        return log.headRecordHash
    if index == 7:
        return log.finalStoreHash
    if index == 8:
        return log.recordSetHash
    if index == 9:
        return log.logHash
    return int64(-1)

fn DistributedKvResidencyWalFileRecordWord(record: DistributedKvResidencyWalRecord,
                                           index: int32): int64 =
    if index == 0:
        return int64(record.recordSeq)
    if index == 1:
        return record.previousRecordHash
    if index == 2:
        return record.previousStoreHash
    if index == 3:
        return record.operationHash
    if index == 4:
        return record.updateHash
    if index == 5:
        return record.newStoreHash
    if index == 6:
        return record.appendedAtNs
    if index == 7:
        return record.recordHash
    if index == 8:
        return record.enginePlanHash
    if index == 9:
        return DistributedTransportFrameTextHash(record.targetPeerId)
    return int64(-1)

fn DistributedKvResidencyWalLogFileBytes(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[],
                                         log: DistributedKvResidencyWalLog): Result[rawbytes.Bytes] =
    let logOk = DistributedValidateKvResidencyWalLog(plan, peers, log)
    if IsErr(logOk):
        return Err[rawbytes.Bytes](Error(logOk))
    if log.recordCount < 0 || log.recordCount != log.records.len:
        return Err[rawbytes.Bytes]("distributed kv residency wal file: record count")
    let wordCount = DistributedKvResidencyWalFileHeaderWordCount + log.records.len * DistributedKvResidencyWalFileRecordWordCount
    let byteCount = wordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("distributed kv residency wal file: allocation")
    for h in 0..<DistributedKvResidencyWalFileHeaderWordCount:
        DistributedWriteI64LE(out, h * 8, DistributedKvResidencyWalFileHeaderWord(log, h))
    var offset = DistributedKvResidencyWalFileHeaderWordCount * 8
    for r in 0..<log.records.len:
        for w in 0..<DistributedKvResidencyWalFileRecordWordCount:
            DistributedWriteI64LE(out, offset + w * 8, DistributedKvResidencyWalFileRecordWord(log.records[r], w))
        offset = offset + DistributedKvResidencyWalFileRecordWordCount * 8
    return Ok[rawbytes.Bytes](out)

fn DistributedKvResidencyWalLogFromFileBytes(plan: DistributedInferencePlan,
                                             peers: DistributedInferencePeer[],
                                             baseStore: DistributedKvResidencyStore,
                                             bytes: rawbytes.Bytes): Result[DistributedKvResidencyWalLog] =
    let baseOk = DistributedValidateKvResidencyStore(plan, peers, baseStore)
    if IsErr(baseOk):
        return Err[DistributedKvResidencyWalLog](Error(baseOk))
    let headerBytes = DistributedKvResidencyWalFileHeaderWordCount * 8
    if rawbytes.BytesLen(bytes) < headerBytes:
        return Err[DistributedKvResidencyWalLog]("distributed kv residency wal file: short header")
    let magic = DistributedReadI64LE(bytes, 0)
    let version = DistributedReadI64LE(bytes, 8)
    let enginePlanHash = DistributedReadI64LE(bytes, 16)
    let targetPeerHash = DistributedReadI64LE(bytes, 24)
    let baseStoreHash = DistributedReadI64LE(bytes, 32)
    let recordCountRaw = DistributedReadI64LE(bytes, 40)
    let headRecordHash = DistributedReadI64LE(bytes, 48)
    let finalStoreHash = DistributedReadI64LE(bytes, 56)
    let recordSetHash = DistributedReadI64LE(bytes, 64)
    let logHash = DistributedReadI64LE(bytes, 72)
    if magic != int64(DistributedKvResidencyWalFileMagic) ||
       version != int64(DistributedKvResidencyWalFileVersion):
        return Err[DistributedKvResidencyWalLog]("distributed kv residency wal file: magic")
    if enginePlanHash != plan.engineHash ||
       targetPeerHash != DistributedTransportFrameTextHash(baseStore.targetPeerId) ||
       baseStoreHash != baseStore.storeHash ||
       recordCountRaw < int64(0) ||
       recordCountRaw > int64(1000000):
        return Err[DistributedKvResidencyWalLog]("distributed kv residency wal file: header")
    let recordCount = int32(recordCountRaw)
    let wantBytes = headerBytes + recordCount * DistributedKvResidencyWalFileRecordWordCount * 8
    if rawbytes.BytesLen(bytes) != wantBytes:
        return Err[DistributedKvResidencyWalLog]("distributed kv residency wal file: byte length")
    var records: DistributedKvResidencyWalRecord[]
    var expectedPrevRecordHash: int64
    var expectedPrevStoreHash: int64 = baseStore.storeHash
    var offset = headerBytes
    for i in 0..<recordCount:
        let seqRaw = DistributedReadI64LE(bytes, offset)
        let previousRecordHash = DistributedReadI64LE(bytes, offset + 8)
        let previousStoreHash = DistributedReadI64LE(bytes, offset + 16)
        let operationHash = DistributedReadI64LE(bytes, offset + 24)
        let updateHash = DistributedReadI64LE(bytes, offset + 32)
        let newStoreHash = DistributedReadI64LE(bytes, offset + 40)
        let appendedAtNs = DistributedReadI64LE(bytes, offset + 48)
        let recordHash = DistributedReadI64LE(bytes, offset + 56)
        let recordEnginePlanHash = DistributedReadI64LE(bytes, offset + 64)
        let recordTargetPeerHash = DistributedReadI64LE(bytes, offset + 72)
        if seqRaw != int64(i) ||
           recordEnginePlanHash != plan.engineHash ||
           recordTargetPeerHash != DistributedTransportFrameTextHash(baseStore.targetPeerId):
            return Err[DistributedKvResidencyWalLog]("distributed kv residency wal file: record header")
        let record = DistributedKvResidencyWalRecord(
            schema: DistributedKvResidencyWalRecordSchema,
            enginePlanHash: plan.engineHash,
            targetPeerId: baseStore.targetPeerId,
            recordSeq: int32(seqRaw),
            previousRecordHash: previousRecordHash,
            previousStoreHash: previousStoreHash,
            operationHash: operationHash,
            updateHash: updateHash,
            newStoreHash: newStoreHash,
            appendedAtNs: appendedAtNs,
            recordHash: recordHash
        )
        let recordOk = DistributedValidateKvResidencyWalRecord(
            plan,
            record,
            baseStore.targetPeerId,
            i,
            expectedPrevRecordHash,
            expectedPrevStoreHash
        )
        if IsErr(recordOk):
            return Err[DistributedKvResidencyWalLog](Error(recordOk))
        add(records, record)
        expectedPrevRecordHash = record.recordHash
        expectedPrevStoreHash = record.newStoreHash
        offset = offset + DistributedKvResidencyWalFileRecordWordCount * 8
    let log = DistributedKvResidencyWalLogBuild(
        plan.engineHash,
        baseStore.targetPeerId,
        baseStore.storeHash,
        finalStoreHash,
        records
    )
    if log.recordCount != recordCount ||
       log.headRecordHash != headRecordHash ||
       log.recordSetHash != recordSetHash ||
       log.logHash != logHash:
        return Err[DistributedKvResidencyWalLog]("distributed kv residency wal file: log hash")
    let logOk = DistributedValidateKvResidencyWalLog(plan, peers, log)
    if IsErr(logOk):
        return Err[DistributedKvResidencyWalLog](Error(logOk))
    return Ok[DistributedKvResidencyWalLog](log)

@borrows
fn DistributedWriteKvResidencyWalLogFile(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[],
                                         log: DistributedKvResidencyWalLog,
                                         path: str): Result[DistributedKvResidencyWalFileReceipt] =
    if path == "":
        return Err[DistributedKvResidencyWalFileReceipt]("distributed kv residency wal file: path")
    let bytesRes = DistributedKvResidencyWalLogFileBytes(plan, peers, log)
    if IsErr(bytesRes):
        return Err[DistributedKvResidencyWalFileReceipt](Error(bytesRes))
    var bytes = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytes)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyWalFileReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyWalFileReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytes) ||
       DistributedKvResidencyWalFileByteHash(readBytes) != DistributedKvResidencyWalFileByteHash(bytes):
        rawbytes.BytesFree(bytes)
        rawbytes.BytesFree(readBytes)
        return Err[DistributedKvResidencyWalFileReceipt]("distributed kv residency wal file: readback")
    let receipt = DistributedKvResidencyWalFileReceiptBuild(path, log, readBytes)
    rawbytes.BytesFree(bytes)
    rawbytes.BytesFree(readBytes)
    return Ok[DistributedKvResidencyWalFileReceipt](receipt)

@borrows
fn DistributedReadKvResidencyWalLogFile(plan: DistributedInferencePlan,
                                        peers: DistributedInferencePeer[],
                                        baseStore: DistributedKvResidencyStore,
                                        path: str): Result[DistributedKvResidencyWalFileReadResult] =
    if path == "":
        return Err[DistributedKvResidencyWalFileReadResult]("distributed kv residency wal file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DistributedKvResidencyWalFileReadResult](Error(bytesRes))
    var bytes = Value(bytesRes)
    let logRes = DistributedKvResidencyWalLogFromFileBytes(plan, peers, baseStore, bytes)
    if IsErr(logRes):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyWalFileReadResult](Error(logRes))
    let receipt = DistributedKvResidencyWalFileReceiptBuild(path, Value(logRes), bytes)
    let out = DistributedKvResidencyWalFileReadResult(
        log: Value(logRes),
        receipt: receipt
    )
    rawbytes.BytesFree(bytes)
    return Ok[DistributedKvResidencyWalFileReadResult](out)

@borrows
fn DistributedValidateKvResidencyWalLogFileReceipt(plan: DistributedInferencePlan,
                                                   peers: DistributedInferencePeer[],
                                                   baseStore: DistributedKvResidencyStore,
                                                   receipt: DistributedKvResidencyWalFileReceipt): Result[bool] =
    if receipt.schema != DistributedKvResidencyWalFileReceiptSchema ||
       receipt.path == "" ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.targetPeerId != baseStore.targetPeerId ||
       receipt.baseStoreHash != baseStore.storeHash ||
       receipt.recordCount < 0 ||
       receipt.finalStoreHash <= int64(0) ||
       receipt.logHash <= int64(0) ||
       receipt.byteCount <= 0 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("distributed kv residency wal file receipt: schema")
    if DistributedKvResidencyWalFileReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("distributed kv residency wal file receipt: hash")
    let readRes = DistributedReadKvResidencyWalLogFile(plan, peers, baseStore, receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    let got = Value(readRes).receipt
    if got.enginePlanHash != receipt.enginePlanHash ||
       got.targetPeerId != receipt.targetPeerId ||
       got.baseStoreHash != receipt.baseStoreHash ||
       got.finalStoreHash != receipt.finalStoreHash ||
       got.recordCount != receipt.recordCount ||
       got.headRecordHash != receipt.headRecordHash ||
       got.recordSetHash != receipt.recordSetHash ||
       got.logHash != receipt.logHash ||
       got.byteCount != receipt.byteCount ||
       got.byteHash != receipt.byteHash ||
       got.receiptHash != receipt.receiptHash:
        return Err[bool]("distributed kv residency wal file receipt: mismatch")
    return Ok[bool](true)

@borrows
fn DistributedBuildKvResidencyWalReplayReceiptFromFile(plan: DistributedInferencePlan,
                                                       peers: DistributedInferencePeer[],
                                                       baseStore: DistributedKvResidencyStore,
                                                       appends: DistributedKvResidencyWalAppendReceipt[],
                                                       path: str): Result[DistributedKvResidencyWalReplayReceipt] =
    let readRes = DistributedReadKvResidencyWalLogFile(plan, peers, baseStore, path)
    if IsErr(readRes):
        return Err[DistributedKvResidencyWalReplayReceipt](Error(readRes))
    let replayRes = DistributedBuildKvResidencyWalReplayReceipt(plan, peers, baseStore, appends)
    if IsErr(replayRes):
        return Err[DistributedKvResidencyWalReplayReceipt](Error(replayRes))
    let fileLog = Value(readRes).log
    let replay = Value(replayRes)
    if fileLog.logHash != replay.logHash ||
       fileLog.finalStoreHash != replay.finalStoreHash ||
       fileLog.recordCount != replay.recordCount ||
       fileLog.headRecordHash != replay.headRecordHash:
        return Err[DistributedKvResidencyWalReplayReceipt]("distributed kv residency wal file replay: mismatch")
    return Ok[DistributedKvResidencyWalReplayReceipt](replay)

@borrows
fn DistributedPeerIdByTextHash(peers: DistributedInferencePeer[], peerHash: int64): Result[str] =
    if peerHash <= int64(0):
        return Err[str]("distributed peer hash: empty")
    var found: str
    var foundCount: int32
    for i in 0..<peers.len:
        if peers[i].peerId != "" && DistributedTransportFrameTextHash(peers[i].peerId) == peerHash:
            found = peers[i].peerId
            foundCount = foundCount + 1
    if foundCount != 1:
        return Err[str]("distributed peer hash: unresolved")
    return Ok[str](found)

@borrows
fn DistributedKvResidencyStoreFileByteHash(bytes: rawbytes.Bytes): int64 =
    return DistributedHashBytesWith(int64(151), bytes)

@borrows
fn DistributedKvResidencyStoreFileReceiptHash(receipt: DistributedKvResidencyStoreFileReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashTextWith(h, receipt.path)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashStep(h, int64(receipt.maxResidentPages))
    h = DistributedHashStep(h, receipt.updatedAtNs)
    h = DistributedHashStep(h, receipt.storeHash)
    h = DistributedHashStep(h, int64(receipt.activeEntryCount))
    h = DistributedHashStep(h, receipt.activeEntrySetHash)
    h = DistributedHashStep(h, int64(receipt.operationCount))
    h = DistributedHashStep(h, receipt.operationSetHash)
    h = DistributedHashStep(h, int64(receipt.byteCount))
    h = DistributedHashStep(h, receipt.byteHash)
    return h

fn DistributedKvResidencyStoreFileReceiptBuild(path: str,
                                               store: DistributedKvResidencyStore,
                                               bytes: rawbytes.Bytes): DistributedKvResidencyStoreFileReceipt =
    var receipt = DistributedKvResidencyStoreFileReceipt(
        schema: DistributedKvResidencyStoreFileReceiptSchema,
        path: path,
        enginePlanHash: store.enginePlanHash,
        targetPeerId: store.targetPeerId,
        maxResidentPages: store.maxResidentPages,
        updatedAtNs: store.updatedAtNs,
        storeHash: store.storeHash,
        activeEntryCount: store.activeEntryCount,
        activeEntrySetHash: store.activeEntrySetHash,
        operationCount: store.operationHashes.len,
        operationSetHash: store.operationSetHash,
        byteCount: rawbytes.BytesLen(bytes),
        byteHash: DistributedKvResidencyStoreFileByteHash(bytes),
        receiptHash: int64(0)
    )
    receipt.receiptHash = DistributedKvResidencyStoreFileReceiptHash(receipt)
    return receipt

fn DistributedKvResidencyStoreFileHeaderWord(store: DistributedKvResidencyStore,
                                             index: int32): int64 =
    if index == 0:
        return int64(DistributedKvResidencyStoreFileMagic)
    if index == 1:
        return int64(DistributedKvResidencyStoreFileVersion)
    if index == 2:
        return store.enginePlanHash
    if index == 3:
        return DistributedTransportFrameTextHash(store.targetPeerId)
    if index == 4:
        return int64(store.maxResidentPages)
    if index == 5:
        return store.updatedAtNs
    if index == 6:
        return int64(store.activeEntryCount)
    if index == 7:
        return store.activeEntrySetHash
    if index == 8:
        return int64(store.operationHashes.len)
    if index == 9:
        return store.operationSetHash
    if index == 10:
        return store.storeHash
    return int64(-1)

fn DistributedKvResidencyStoreFileEntryWord(entry: DistributedKvPageResidencyEntry,
                                            index: int32): int64 =
    if index == 0:
        return entry.enginePlanHash
    if index == 1:
        return DistributedTransportFrameTextHash(entry.ownerPeerId)
    if index == 2:
        return DistributedTransportFrameTextHash(entry.targetPeerId)
    if index == 3:
        return int64(entry.seqId)
    if index == 4:
        return int64(entry.pageId)
    if index == 5:
        return int64(entry.pageOrdinal)
    if index == 6:
        return entry.payloadHash
    if index == 7:
        return entry.requestHash
    if index == 8:
        return entry.responseHash
    if index == 9:
        return entry.transferReceiptHash
    if index == 10:
        return entry.requestFrameHash
    if index == 11:
        return entry.responseFrameHash
    if index == 12:
        return entry.residentSinceNs
    if index == 13:
        return entry.validUntilNs
    if index == 14:
        return entry.entryHash
    return int64(-1)

fn DistributedKvResidencyStoreFileBytes(plan: DistributedInferencePlan,
                                        peers: DistributedInferencePeer[],
                                        store: DistributedKvResidencyStore): Result[rawbytes.Bytes] =
    let storeOk = DistributedValidateKvResidencyStore(plan, peers, store)
    if IsErr(storeOk):
        return Err[rawbytes.Bytes](Error(storeOk))
    if store.activeEntryCount != store.activeEntries.len:
        return Err[rawbytes.Bytes]("distributed kv residency store file: active count")
    let wordCount = DistributedKvResidencyStoreFileHeaderWordCount +
        store.activeEntries.len * DistributedKvResidencyStoreFileEntryWordCount +
        store.operationHashes.len
    let byteCount = wordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("distributed kv residency store file: allocation")
    for h in 0..<DistributedKvResidencyStoreFileHeaderWordCount:
        DistributedWriteI64LE(out, h * 8, DistributedKvResidencyStoreFileHeaderWord(store, h))
    var offset = DistributedKvResidencyStoreFileHeaderWordCount * 8
    for e in 0..<store.activeEntries.len:
        for w in 0..<DistributedKvResidencyStoreFileEntryWordCount:
            DistributedWriteI64LE(out, offset + w * 8, DistributedKvResidencyStoreFileEntryWord(store.activeEntries[e], w))
        offset = offset + DistributedKvResidencyStoreFileEntryWordCount * 8
    for o in 0..<store.operationHashes.len:
        DistributedWriteI64LE(out, offset, store.operationHashes[o])
        offset = offset + 8
    return Ok[rawbytes.Bytes](out)

fn DistributedKvResidencyStoreFromFileBytes(plan: DistributedInferencePlan,
                                            peers: DistributedInferencePeer[],
                                            bytes: rawbytes.Bytes): Result[DistributedKvResidencyStore] =
    let headerBytes = DistributedKvResidencyStoreFileHeaderWordCount * 8
    if rawbytes.BytesLen(bytes) < headerBytes:
        return Err[DistributedKvResidencyStore]("distributed kv residency store file: short header")
    let magic = DistributedReadI64LE(bytes, 0)
    let version = DistributedReadI64LE(bytes, 8)
    let enginePlanHash = DistributedReadI64LE(bytes, 16)
    let targetPeerHash = DistributedReadI64LE(bytes, 24)
    let maxResidentPagesRaw = DistributedReadI64LE(bytes, 32)
    let updatedAtNs = DistributedReadI64LE(bytes, 40)
    let activeEntryCountRaw = DistributedReadI64LE(bytes, 48)
    let activeEntrySetHash = DistributedReadI64LE(bytes, 56)
    let operationCountRaw = DistributedReadI64LE(bytes, 64)
    let operationSetHash = DistributedReadI64LE(bytes, 72)
    let storeHash = DistributedReadI64LE(bytes, 80)
    if magic != int64(DistributedKvResidencyStoreFileMagic) ||
       version != int64(DistributedKvResidencyStoreFileVersion):
        return Err[DistributedKvResidencyStore]("distributed kv residency store file: magic")
    if enginePlanHash != plan.engineHash ||
       maxResidentPagesRaw <= int64(0) ||
       maxResidentPagesRaw > int64(1000000) ||
       updatedAtNs <= int64(0) ||
       activeEntryCountRaw < int64(0) ||
       activeEntryCountRaw > maxResidentPagesRaw ||
       operationCountRaw < int64(0) ||
       operationCountRaw > int64(1000000) ||
       storeHash <= int64(0):
        return Err[DistributedKvResidencyStore]("distributed kv residency store file: header")
    let targetPeerRes = DistributedPeerIdByTextHash(peers, targetPeerHash)
    if IsErr(targetPeerRes):
        return Err[DistributedKvResidencyStore](Error(targetPeerRes))
    let targetPeerId = Value(targetPeerRes)
    let activeEntryCount = int32(activeEntryCountRaw)
    let operationCount = int32(operationCountRaw)
    let wantBytes = headerBytes +
        activeEntryCount * DistributedKvResidencyStoreFileEntryWordCount * 8 +
        operationCount * 8
    if rawbytes.BytesLen(bytes) != wantBytes:
        return Err[DistributedKvResidencyStore]("distributed kv residency store file: byte length")
    var entries: DistributedKvPageResidencyEntry[]
    var offset = headerBytes
    for i in 0..<activeEntryCount:
        let entryEnginePlanHash = DistributedReadI64LE(bytes, offset)
        let ownerPeerHash = DistributedReadI64LE(bytes, offset + 8)
        let entryTargetPeerHash = DistributedReadI64LE(bytes, offset + 16)
        let seqIdRaw = DistributedReadI64LE(bytes, offset + 24)
        let pageIdRaw = DistributedReadI64LE(bytes, offset + 32)
        let pageOrdinalRaw = DistributedReadI64LE(bytes, offset + 40)
        let payloadHash = DistributedReadI64LE(bytes, offset + 48)
        let requestHash = DistributedReadI64LE(bytes, offset + 56)
        let responseHash = DistributedReadI64LE(bytes, offset + 64)
        let transferReceiptHash = DistributedReadI64LE(bytes, offset + 72)
        let requestFrameHash = DistributedReadI64LE(bytes, offset + 80)
        let responseFrameHash = DistributedReadI64LE(bytes, offset + 88)
        let residentSinceNs = DistributedReadI64LE(bytes, offset + 96)
        let validUntilNs = DistributedReadI64LE(bytes, offset + 104)
        let entryHash = DistributedReadI64LE(bytes, offset + 112)
        if entryEnginePlanHash != plan.engineHash ||
           seqIdRaw < int64(0) ||
           pageIdRaw <= int64(0) ||
           pageOrdinalRaw < int64(0) ||
           payloadHash <= int64(0) ||
           requestHash <= int64(0) ||
           responseHash <= int64(0) ||
           transferReceiptHash <= int64(0) ||
           requestFrameHash <= int64(0) ||
           responseFrameHash <= int64(0) ||
           residentSinceNs <= int64(0) ||
           validUntilNs <= updatedAtNs ||
           entryHash <= int64(0):
            return Err[DistributedKvResidencyStore]("distributed kv residency store file: entry header")
        let ownerPeerRes = DistributedPeerIdByTextHash(peers, ownerPeerHash)
        if IsErr(ownerPeerRes):
            return Err[DistributedKvResidencyStore](Error(ownerPeerRes))
        let entryTargetPeerRes = DistributedPeerIdByTextHash(peers, entryTargetPeerHash)
        if IsErr(entryTargetPeerRes):
            return Err[DistributedKvResidencyStore](Error(entryTargetPeerRes))
        if Value(entryTargetPeerRes) != targetPeerId:
            return Err[DistributedKvResidencyStore]("distributed kv residency store file: entry target")
        let entry = DistributedKvPageResidencyEntry(
            schema: DistributedKvPageResidencyEntrySchema,
            enginePlanHash: plan.engineHash,
            ownerPeerId: Value(ownerPeerRes),
            targetPeerId: targetPeerId,
            seqId: int32(seqIdRaw),
            pageId: int32(pageIdRaw),
            pageOrdinal: int32(pageOrdinalRaw),
            payloadHash: payloadHash,
            requestHash: requestHash,
            responseHash: responseHash,
            transferReceiptHash: transferReceiptHash,
            requestFrameHash: requestFrameHash,
            responseFrameHash: responseFrameHash,
            residentSinceNs: residentSinceNs,
            validUntilNs: validUntilNs,
            entryHash: entryHash
        )
        if DistributedKvPageResidencyEntryHash(entry) != entry.entryHash:
            return Err[DistributedKvResidencyStore]("distributed kv residency store file: entry hash")
        add(entries, entry)
        offset = offset + DistributedKvResidencyStoreFileEntryWordCount * 8
    var operationHashes: int64[]
    for o in 0..<operationCount:
        let operationHash = DistributedReadI64LE(bytes, offset)
        if operationHash <= int64(0):
            return Err[DistributedKvResidencyStore]("distributed kv residency store file: operation")
        add(operationHashes, operationHash)
        offset = offset + 8
    let store = DistributedKvResidencyStoreBuild(
        plan.engineHash,
        targetPeerId,
        int32(maxResidentPagesRaw),
        updatedAtNs,
        entries,
        operationHashes
    )
    if store.activeEntrySetHash != activeEntrySetHash ||
       store.operationSetHash != operationSetHash ||
       store.storeHash != storeHash:
        return Err[DistributedKvResidencyStore]("distributed kv residency store file: store hash")
    let storeOk = DistributedValidateKvResidencyStore(plan, peers, store)
    if IsErr(storeOk):
        return Err[DistributedKvResidencyStore](Error(storeOk))
    return Ok[DistributedKvResidencyStore](store)

@borrows
fn DistributedWriteKvResidencyStoreFile(plan: DistributedInferencePlan,
                                        peers: DistributedInferencePeer[],
                                        store: DistributedKvResidencyStore,
                                        path: str): Result[DistributedKvResidencyStoreFileReceipt] =
    if path == "":
        return Err[DistributedKvResidencyStoreFileReceipt]("distributed kv residency store file: path")
    let bytesRes = DistributedKvResidencyStoreFileBytes(plan, peers, store)
    if IsErr(bytesRes):
        return Err[DistributedKvResidencyStoreFileReceipt](Error(bytesRes))
    var bytes = Value(bytesRes)
    let writeRes = os.WriteFileBytesResult(path, bytes)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyStoreFileReceipt](Error(writeRes))
    let readBack = os.ReadFileBytesResult(path)
    if IsErr(readBack):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyStoreFileReceipt](Error(readBack))
    var readBytes = Value(readBack)
    if rawbytes.BytesLen(readBytes) != rawbytes.BytesLen(bytes) ||
       DistributedKvResidencyStoreFileByteHash(readBytes) != DistributedKvResidencyStoreFileByteHash(bytes):
        rawbytes.BytesFree(bytes)
        rawbytes.BytesFree(readBytes)
        return Err[DistributedKvResidencyStoreFileReceipt]("distributed kv residency store file: readback")
    let receipt = DistributedKvResidencyStoreFileReceiptBuild(path, store, readBytes)
    rawbytes.BytesFree(bytes)
    rawbytes.BytesFree(readBytes)
    return Ok[DistributedKvResidencyStoreFileReceipt](receipt)

@borrows
fn DistributedReadKvResidencyStoreFile(plan: DistributedInferencePlan,
                                       peers: DistributedInferencePeer[],
                                       path: str): Result[DistributedKvResidencyStoreFileReadResult] =
    if path == "":
        return Err[DistributedKvResidencyStoreFileReadResult]("distributed kv residency store file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DistributedKvResidencyStoreFileReadResult](Error(bytesRes))
    var bytes = Value(bytesRes)
    let storeRes = DistributedKvResidencyStoreFromFileBytes(plan, peers, bytes)
    if IsErr(storeRes):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyStoreFileReadResult](Error(storeRes))
    let receipt = DistributedKvResidencyStoreFileReceiptBuild(path, Value(storeRes), bytes)
    let out = DistributedKvResidencyStoreFileReadResult(
        store: Value(storeRes),
        receipt: receipt
    )
    rawbytes.BytesFree(bytes)
    return Ok[DistributedKvResidencyStoreFileReadResult](out)

@borrows
fn DistributedValidateKvResidencyStoreFileReceipt(plan: DistributedInferencePlan,
                                                  peers: DistributedInferencePeer[],
                                                  receipt: DistributedKvResidencyStoreFileReceipt): Result[bool] =
    if receipt.schema != DistributedKvResidencyStoreFileReceiptSchema ||
       receipt.path == "" ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.targetPeerId == "" ||
       receipt.maxResidentPages <= 0 ||
       receipt.updatedAtNs <= int64(0) ||
       receipt.storeHash <= int64(0) ||
       receipt.activeEntryCount < 0 ||
       receipt.activeEntrySetHash <= int64(0) ||
       receipt.operationCount < 0 ||
       receipt.operationSetHash <= int64(0) ||
       receipt.byteCount <= 0 ||
       receipt.byteHash <= int64(0):
        return Err[bool]("distributed kv residency store file receipt: schema")
    if DistributedKvResidencyStoreFileReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("distributed kv residency store file receipt: hash")
    let readRes = DistributedReadKvResidencyStoreFile(plan, peers, receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    let got = Value(readRes).receipt
    if got.enginePlanHash != receipt.enginePlanHash ||
       got.targetPeerId != receipt.targetPeerId ||
       got.maxResidentPages != receipt.maxResidentPages ||
       got.updatedAtNs != receipt.updatedAtNs ||
       got.storeHash != receipt.storeHash ||
       got.activeEntryCount != receipt.activeEntryCount ||
       got.activeEntrySetHash != receipt.activeEntrySetHash ||
       got.operationCount != receipt.operationCount ||
       got.operationSetHash != receipt.operationSetHash ||
       got.byteCount != receipt.byteCount ||
       got.byteHash != receipt.byteHash ||
       got.receiptHash != receipt.receiptHash:
        return Err[bool]("distributed kv residency store file receipt: mismatch")
    return Ok[bool](true)

@borrows
fn DistributedKvResidencyDurableCommitReceiptHash(receipt: DistributedKvResidencyDurableCommitReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashStep(h, receipt.baseStoreHash)
    h = DistributedHashStep(h, receipt.finalStoreHash)
    h = DistributedHashStep(h, int64(receipt.commitSeq))
    h = DistributedHashStep(h, receipt.previousCommitHash)
    h = DistributedHashTextWith(h, receipt.storeFilePath)
    h = DistributedHashTextWith(h, receipt.walFilePath)
    h = DistributedHashStep(h, receipt.storeFileReceiptHash)
    h = DistributedHashStep(h, receipt.walFileReceiptHash)
    h = DistributedHashStep(h, receipt.storeHash)
    h = DistributedHashStep(h, receipt.walLogHash)
    h = DistributedHashStep(h, int64(receipt.walRecordCount))
    h = DistributedHashStep(h, receipt.committedAtNs)
    return h

@borrows
fn DistributedBuildKvResidencyDurableCommitReceipt(plan: DistributedInferencePlan,
                                                   peers: DistributedInferencePeer[],
                                                   baseStore: DistributedKvResidencyStore,
                                                   storeFileReceipt: DistributedKvResidencyStoreFileReceipt,
                                                   walFileReceipt: DistributedKvResidencyWalFileReceipt,
                                                   previousCommitHash: int64,
                                                   commitSeq: int32,
                                                   committedAtNs: int64): Result[DistributedKvResidencyDurableCommitReceipt] =
    if commitSeq < 0 || previousCommitHash < int64(0) || committedAtNs <= int64(0):
        return Err[DistributedKvResidencyDurableCommitReceipt]("distributed kv residency durable commit: args")
    let baseOk = DistributedValidateKvResidencyStore(plan, peers, baseStore)
    if IsErr(baseOk):
        return Err[DistributedKvResidencyDurableCommitReceipt](Error(baseOk))
    let storeFileOk = DistributedValidateKvResidencyStoreFileReceipt(plan, peers, storeFileReceipt)
    if IsErr(storeFileOk):
        return Err[DistributedKvResidencyDurableCommitReceipt](Error(storeFileOk))
    let walFileOk = DistributedValidateKvResidencyWalLogFileReceipt(plan, peers, baseStore, walFileReceipt)
    if IsErr(walFileOk):
        return Err[DistributedKvResidencyDurableCommitReceipt](Error(walFileOk))
    if storeFileReceipt.targetPeerId != baseStore.targetPeerId ||
       walFileReceipt.targetPeerId != baseStore.targetPeerId ||
       walFileReceipt.baseStoreHash != baseStore.storeHash ||
       storeFileReceipt.storeHash != walFileReceipt.finalStoreHash:
        return Err[DistributedKvResidencyDurableCommitReceipt]("distributed kv residency durable commit: binding")
    var receipt = DistributedKvResidencyDurableCommitReceipt(
        schema: DistributedKvResidencyDurableCommitReceiptSchema,
        enginePlanHash: plan.engineHash,
        targetPeerId: baseStore.targetPeerId,
        baseStoreHash: baseStore.storeHash,
        finalStoreHash: storeFileReceipt.storeHash,
        commitSeq: commitSeq,
        previousCommitHash: previousCommitHash,
        storeFilePath: storeFileReceipt.path,
        walFilePath: walFileReceipt.path,
        storeFileReceiptHash: storeFileReceipt.receiptHash,
        walFileReceiptHash: walFileReceipt.receiptHash,
        storeHash: storeFileReceipt.storeHash,
        walLogHash: walFileReceipt.logHash,
        walRecordCount: walFileReceipt.recordCount,
        committedAtNs: committedAtNs,
        commitHash: int64(0)
    )
    receipt.commitHash = DistributedKvResidencyDurableCommitReceiptHash(receipt)
    return Ok[DistributedKvResidencyDurableCommitReceipt](receipt)

@borrows
fn DistributedWriteKvResidencyDurableCommitFiles(plan: DistributedInferencePlan,
                                                 peers: DistributedInferencePeer[],
                                                 baseStore: DistributedKvResidencyStore,
                                                 finalStore: DistributedKvResidencyStore,
                                                 walLog: DistributedKvResidencyWalLog,
                                                 storeFilePath: str,
                                                 walFilePath: str,
                                                 previousCommitHash: int64,
                                                 commitSeq: int32,
                                                 committedAtNs: int64): Result[DistributedKvResidencyDurableCommitReceipt] =
    if storeFilePath == "" || walFilePath == "" || storeFilePath == walFilePath:
        return Err[DistributedKvResidencyDurableCommitReceipt]("distributed kv residency durable commit: paths")
    let baseOk = DistributedValidateKvResidencyStore(plan, peers, baseStore)
    if IsErr(baseOk):
        return Err[DistributedKvResidencyDurableCommitReceipt](Error(baseOk))
    let storeOk = DistributedValidateKvResidencyStore(plan, peers, finalStore)
    if IsErr(storeOk):
        return Err[DistributedKvResidencyDurableCommitReceipt](Error(storeOk))
    let walOk = DistributedValidateKvResidencyWalLog(plan, peers, walLog)
    if IsErr(walOk):
        return Err[DistributedKvResidencyDurableCommitReceipt](Error(walOk))
    if finalStore.targetPeerId != baseStore.targetPeerId ||
       walLog.targetPeerId != baseStore.targetPeerId ||
       walLog.baseStoreHash != baseStore.storeHash ||
       walLog.finalStoreHash != finalStore.storeHash:
        return Err[DistributedKvResidencyDurableCommitReceipt]("distributed kv residency durable commit: chain")
    let walReceiptRes = DistributedWriteKvResidencyWalLogFile(plan, peers, walLog, walFilePath)
    if IsErr(walReceiptRes):
        return Err[DistributedKvResidencyDurableCommitReceipt](Error(walReceiptRes))
    let storeReceiptRes = DistributedWriteKvResidencyStoreFile(plan, peers, finalStore, storeFilePath)
    if IsErr(storeReceiptRes):
        return Err[DistributedKvResidencyDurableCommitReceipt](Error(storeReceiptRes))
    return DistributedBuildKvResidencyDurableCommitReceipt(
        plan,
        peers,
        baseStore,
        Value(storeReceiptRes),
        Value(walReceiptRes),
        previousCommitHash,
        commitSeq,
        committedAtNs
    )

@borrows
fn DistributedValidateKvResidencyDurableCommitReceipt(plan: DistributedInferencePlan,
                                                      peers: DistributedInferencePeer[],
                                                      baseStore: DistributedKvResidencyStore,
                                                      receipt: DistributedKvResidencyDurableCommitReceipt): Result[bool] =
    if receipt.schema != DistributedKvResidencyDurableCommitReceiptSchema ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.targetPeerId != baseStore.targetPeerId ||
       receipt.baseStoreHash != baseStore.storeHash ||
       receipt.finalStoreHash <= int64(0) ||
       receipt.commitSeq < 0 ||
       receipt.previousCommitHash < int64(0) ||
       receipt.storeFilePath == "" ||
       receipt.walFilePath == "" ||
       receipt.storeFilePath == receipt.walFilePath ||
       receipt.storeFileReceiptHash <= int64(0) ||
       receipt.walFileReceiptHash <= int64(0) ||
       receipt.storeHash <= int64(0) ||
       receipt.walLogHash <= int64(0) ||
       receipt.walRecordCount < 0 ||
       receipt.committedAtNs <= int64(0):
        return Err[bool]("distributed kv residency durable commit receipt: schema")
    if DistributedKvResidencyDurableCommitReceiptHash(receipt) != receipt.commitHash:
        return Err[bool]("distributed kv residency durable commit receipt: hash")
    let storeRead = DistributedReadKvResidencyStoreFile(plan, peers, receipt.storeFilePath)
    if IsErr(storeRead):
        return Err[bool](Error(storeRead))
    let walRead = DistributedReadKvResidencyWalLogFile(plan, peers, baseStore, receipt.walFilePath)
    if IsErr(walRead):
        return Err[bool](Error(walRead))
    let storeResult = Value(storeRead)
    let walResult = Value(walRead)
    if storeResult.receipt.receiptHash != receipt.storeFileReceiptHash ||
       walResult.receipt.receiptHash != receipt.walFileReceiptHash ||
       storeResult.store.targetPeerId != receipt.targetPeerId ||
       walResult.log.targetPeerId != receipt.targetPeerId ||
       storeResult.store.storeHash != receipt.storeHash ||
       walResult.log.finalStoreHash != receipt.finalStoreHash ||
       walResult.log.finalStoreHash != storeResult.store.storeHash ||
       walResult.log.baseStoreHash != baseStore.storeHash ||
       walResult.log.logHash != receipt.walLogHash ||
       walResult.log.recordCount != receipt.walRecordCount:
        return Err[bool]("distributed kv residency durable commit receipt: binding")
    return Ok[bool](true)

@borrows
fn DistributedKvResidencyDurableRecoveryReceiptHash(receipt: DistributedKvResidencyDurableRecoveryReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashStep(h, receipt.baseStoreHash)
    h = DistributedHashStep(h, receipt.recoveredStoreHash)
    h = DistributedHashStep(h, receipt.walLogHash)
    h = DistributedHashStep(h, int64(receipt.walRecordCount))
    h = DistributedHashStep(h, receipt.commitHash)
    h = DistributedHashStep(h, receipt.storeFileReceiptHash)
    h = DistributedHashStep(h, receipt.walFileReceiptHash)
    h = DistributedHashStep(h, receipt.recoveredAtNs)
    return h

@borrows
fn DistributedRecoverKvResidencyStoreFromDurableCommit(plan: DistributedInferencePlan,
                                                       peers: DistributedInferencePeer[],
                                                       baseStore: DistributedKvResidencyStore,
                                                       commit: DistributedKvResidencyDurableCommitReceipt,
                                                       recoveredAtNs: int64): Result[DistributedKvResidencyDurableRecoveryResult] =
    if recoveredAtNs <= int64(0):
        return Err[DistributedKvResidencyDurableRecoveryResult]("distributed kv residency durable recovery: time")
    let commitOk = DistributedValidateKvResidencyDurableCommitReceipt(plan, peers, baseStore, commit)
    if IsErr(commitOk):
        return Err[DistributedKvResidencyDurableRecoveryResult](Error(commitOk))
    let storeRead = DistributedReadKvResidencyStoreFile(plan, peers, commit.storeFilePath)
    if IsErr(storeRead):
        return Err[DistributedKvResidencyDurableRecoveryResult](Error(storeRead))
    let walRead = DistributedReadKvResidencyWalLogFile(plan, peers, baseStore, commit.walFilePath)
    if IsErr(walRead):
        return Err[DistributedKvResidencyDurableRecoveryResult](Error(walRead))
    let storeResult = Value(storeRead)
    let walResult = Value(walRead)
    if storeResult.store.storeHash != commit.storeHash ||
       walResult.log.finalStoreHash != storeResult.store.storeHash:
        return Err[DistributedKvResidencyDurableRecoveryResult]("distributed kv residency durable recovery: binding")
    var recovery = DistributedKvResidencyDurableRecoveryReceipt(
        schema: DistributedKvResidencyDurableRecoveryReceiptSchema,
        enginePlanHash: plan.engineHash,
        targetPeerId: commit.targetPeerId,
        baseStoreHash: baseStore.storeHash,
        recoveredStoreHash: storeResult.store.storeHash,
        walLogHash: walResult.log.logHash,
        walRecordCount: walResult.log.recordCount,
        commitHash: commit.commitHash,
        storeFileReceiptHash: storeResult.receipt.receiptHash,
        walFileReceiptHash: walResult.receipt.receiptHash,
        recoveredAtNs: recoveredAtNs,
        recoveryHash: int64(0)
    )
    recovery.recoveryHash = DistributedKvResidencyDurableRecoveryReceiptHash(recovery)
    let out = DistributedKvResidencyDurableRecoveryResult(
        store: storeResult.store,
        log: walResult.log,
        receipt: recovery
    )
    return Ok[DistributedKvResidencyDurableRecoveryResult](out)

fn DistributedCopyBytesInto(dst: var rawbytes.Bytes, offset: int32, src: rawbytes.Bytes): Result[bool] =
    if offset < 0 || rawbytes.BytesLen(src) < 0 || offset + rawbytes.BytesLen(src) > rawbytes.BytesLen(dst):
        return Err[bool]("distributed bytes copy: range")
    for i in 0..<rawbytes.BytesLen(src):
        rawbytes.BytesSet(dst, offset + i, rawbytes.BytesGet(src, i))
    return Ok[bool](true)

fn DistributedReadStringFromFileBytes(bytes: rawbytes.Bytes, offset: int32, count: int32): Result[str] =
    if offset < 0 || count <= 0 || offset + count > rawbytes.BytesLen(bytes):
        return Err[str]("distributed file string: range")
    var slice = rawbytes.BytesSlice(bytes, offset, count)
    if rawbytes.BytesLen(slice) != count:
        return Err[str]("distributed file string: slice")
    let text = rawbytes.BytesToString(slice)
    rawbytes.BytesFree(slice)
    return Ok[str](text)

@borrows
fn DistributedKvResidencyHeadFileByteHash(bytes: rawbytes.Bytes): int64 =
    return DistributedHashBytesWith(int64(153), bytes)

@borrows
fn DistributedKvResidencyHeadFileReceiptHash(receipt: DistributedKvResidencyHeadFileReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashTextWith(h, receipt.path)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashStep(h, receipt.baseStoreHash)
    h = DistributedHashStep(h, receipt.currentStoreHash)
    h = DistributedHashStep(h, int64(receipt.commitSeq))
    h = DistributedHashStep(h, receipt.previousCommitHash)
    h = DistributedHashStep(h, receipt.commitHash)
    h = DistributedHashTextWith(h, receipt.storeFilePath)
    h = DistributedHashTextWith(h, receipt.walFilePath)
    h = DistributedHashStep(h, receipt.storeFileReceiptHash)
    h = DistributedHashStep(h, receipt.walFileReceiptHash)
    h = DistributedHashStep(h, receipt.walLogHash)
    h = DistributedHashStep(h, int64(receipt.walRecordCount))
    h = DistributedHashStep(h, receipt.committedAtNs)
    h = DistributedHashStep(h, receipt.updatedAtNs)
    return h

fn DistributedKvResidencyHeadCommitReceipt(head: DistributedKvResidencyHeadFileReceipt): DistributedKvResidencyDurableCommitReceipt =
    return DistributedKvResidencyDurableCommitReceipt(
        schema: DistributedKvResidencyDurableCommitReceiptSchema,
        enginePlanHash: head.enginePlanHash,
        targetPeerId: head.targetPeerId,
        baseStoreHash: head.baseStoreHash,
        finalStoreHash: head.currentStoreHash,
        commitSeq: head.commitSeq,
        previousCommitHash: head.previousCommitHash,
        storeFilePath: head.storeFilePath,
        walFilePath: head.walFilePath,
        storeFileReceiptHash: head.storeFileReceiptHash,
        walFileReceiptHash: head.walFileReceiptHash,
        storeHash: head.currentStoreHash,
        walLogHash: head.walLogHash,
        walRecordCount: head.walRecordCount,
        committedAtNs: head.committedAtNs,
        commitHash: head.commitHash
    )

fn DistributedKvResidencyHeadFileReceiptBuild(path: str,
                                              commit: DistributedKvResidencyDurableCommitReceipt,
                                              updatedAtNs: int64): Result[DistributedKvResidencyHeadFileReceipt] =
    if path == "" ||
       commit.schema != DistributedKvResidencyDurableCommitReceiptSchema ||
       commit.targetPeerId == "" ||
       commit.baseStoreHash <= int64(0) ||
       commit.finalStoreHash <= int64(0) ||
       commit.commitSeq < 0 ||
       commit.previousCommitHash < int64(0) ||
       commit.storeFilePath == "" ||
       commit.walFilePath == "" ||
       commit.storeFilePath == commit.walFilePath ||
       commit.storeFileReceiptHash <= int64(0) ||
       commit.walFileReceiptHash <= int64(0) ||
       commit.storeHash != commit.finalStoreHash ||
       commit.walLogHash <= int64(0) ||
       commit.walRecordCount < 0 ||
       commit.committedAtNs <= int64(0) ||
       updatedAtNs <= int64(0):
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file receipt: args")
    if DistributedKvResidencyDurableCommitReceiptHash(commit) != commit.commitHash:
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file receipt: commit hash")
    var receipt = DistributedKvResidencyHeadFileReceipt(
        schema: DistributedKvResidencyHeadFileReceiptSchema,
        path: path,
        enginePlanHash: commit.enginePlanHash,
        targetPeerId: commit.targetPeerId,
        baseStoreHash: commit.baseStoreHash,
        currentStoreHash: commit.finalStoreHash,
        commitSeq: commit.commitSeq,
        previousCommitHash: commit.previousCommitHash,
        commitHash: commit.commitHash,
        storeFilePath: commit.storeFilePath,
        walFilePath: commit.walFilePath,
        storeFileReceiptHash: commit.storeFileReceiptHash,
        walFileReceiptHash: commit.walFileReceiptHash,
        walLogHash: commit.walLogHash,
        walRecordCount: commit.walRecordCount,
        committedAtNs: commit.committedAtNs,
        updatedAtNs: updatedAtNs,
        byteCount: 0,
        byteHash: int64(0),
        headHash: int64(0)
    )
    receipt.headHash = DistributedKvResidencyHeadFileReceiptHash(receipt)
    return Ok[DistributedKvResidencyHeadFileReceipt](receipt)

fn DistributedKvResidencyHeadFileHeaderWord(head: DistributedKvResidencyHeadFileReceipt,
                                            index: int32): int64 =
    if index == 0:
        return int64(DistributedKvResidencyHeadFileMagic)
    if index == 1:
        return int64(DistributedKvResidencyHeadFileVersion)
    if index == 2:
        return head.enginePlanHash
    if index == 3:
        return DistributedTransportFrameTextHash(head.targetPeerId)
    if index == 4:
        return head.baseStoreHash
    if index == 5:
        return head.currentStoreHash
    if index == 6:
        return int64(head.commitSeq)
    if index == 7:
        return head.previousCommitHash
    if index == 8:
        return head.commitHash
    if index == 9:
        return head.storeFileReceiptHash
    if index == 10:
        return head.walFileReceiptHash
    if index == 11:
        return head.walLogHash
    if index == 12:
        return int64(head.walRecordCount)
    if index == 13:
        return head.committedAtNs
    if index == 14:
        return head.updatedAtNs
    if index == 15:
        return int64(len(head.storeFilePath))
    if index == 16:
        return int64(len(head.walFilePath))
    if index == 17:
        return DistributedTransportFrameTextHash(head.storeFilePath)
    if index == 18:
        return DistributedTransportFrameTextHash(head.walFilePath)
    if index == 19:
        return head.headHash
    if index == 20:
        return int64(0)
    return int64(-1)

fn DistributedKvResidencyHeadFileBytes(head: DistributedKvResidencyHeadFileReceipt): Result[rawbytes.Bytes] =
    if head.schema != DistributedKvResidencyHeadFileReceiptSchema ||
       head.path == "" ||
       head.targetPeerId == "" ||
       head.storeFilePath == "" ||
       head.walFilePath == "" ||
       head.storeFilePath == head.walFilePath ||
       head.headHash <= int64(0):
        return Err[rawbytes.Bytes]("distributed kv residency head file: schema")
    if DistributedKvResidencyHeadFileReceiptHash(head) != head.headHash:
        return Err[rawbytes.Bytes]("distributed kv residency head file: hash")
    let storePathLen = len(head.storeFilePath)
    let walPathLen = len(head.walFilePath)
    if storePathLen <= 0 || walPathLen <= 0 || storePathLen > 65536 || walPathLen > 65536:
        return Err[rawbytes.Bytes]("distributed kv residency head file: path length")
    let headerBytes = DistributedKvResidencyHeadFileHeaderWordCount * 8
    let byteCount = headerBytes + storePathLen + walPathLen
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("distributed kv residency head file: allocation")
    for h in 0..<DistributedKvResidencyHeadFileHeaderWordCount:
        DistributedWriteI64LE(out, h * 8, DistributedKvResidencyHeadFileHeaderWord(head, h))
    let storePathBytes = rawbytes.BytesFromString(head.storeFilePath)
    let storeCopy = DistributedCopyBytesInto(out, headerBytes, storePathBytes)
    if IsErr(storeCopy):
        rawbytes.BytesFree(out)
        return Err[rawbytes.Bytes](Error(storeCopy))
    let walPathBytes = rawbytes.BytesFromString(head.walFilePath)
    let walCopy = DistributedCopyBytesInto(out, headerBytes + storePathLen, walPathBytes)
    if IsErr(walCopy):
        rawbytes.BytesFree(out)
        return Err[rawbytes.Bytes](Error(walCopy))
    return Ok[rawbytes.Bytes](out)

fn DistributedKvResidencyHeadFileFromBytes(plan: DistributedInferencePlan,
                                           peers: DistributedInferencePeer[],
                                           path: str,
                                           bytes: rawbytes.Bytes): Result[DistributedKvResidencyHeadFileReceipt] =
    let headerBytes = DistributedKvResidencyHeadFileHeaderWordCount * 8
    if path == "" || rawbytes.BytesLen(bytes) < headerBytes:
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file: short header")
    let magic = DistributedReadI64LE(bytes, 0)
    let version = DistributedReadI64LE(bytes, 8)
    let enginePlanHash = DistributedReadI64LE(bytes, 16)
    let targetPeerHash = DistributedReadI64LE(bytes, 24)
    let baseStoreHash = DistributedReadI64LE(bytes, 32)
    let currentStoreHash = DistributedReadI64LE(bytes, 40)
    let commitSeqRaw = DistributedReadI64LE(bytes, 48)
    let previousCommitHash = DistributedReadI64LE(bytes, 56)
    let commitHash = DistributedReadI64LE(bytes, 64)
    let storeFileReceiptHash = DistributedReadI64LE(bytes, 72)
    let walFileReceiptHash = DistributedReadI64LE(bytes, 80)
    let walLogHash = DistributedReadI64LE(bytes, 88)
    let walRecordCountRaw = DistributedReadI64LE(bytes, 96)
    let committedAtNs = DistributedReadI64LE(bytes, 104)
    let updatedAtNs = DistributedReadI64LE(bytes, 112)
    let storePathLenRaw = DistributedReadI64LE(bytes, 120)
    let walPathLenRaw = DistributedReadI64LE(bytes, 128)
    let storePathHash = DistributedReadI64LE(bytes, 136)
    let walPathHash = DistributedReadI64LE(bytes, 144)
    let headHash = DistributedReadI64LE(bytes, 152)
    if magic != int64(DistributedKvResidencyHeadFileMagic) ||
       version != int64(DistributedKvResidencyHeadFileVersion):
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file: magic")
    if enginePlanHash != plan.engineHash ||
       baseStoreHash <= int64(0) ||
       currentStoreHash <= int64(0) ||
       commitSeqRaw < int64(0) ||
       previousCommitHash < int64(0) ||
       commitHash <= int64(0) ||
       storeFileReceiptHash <= int64(0) ||
       walFileReceiptHash <= int64(0) ||
       walLogHash <= int64(0) ||
       walRecordCountRaw < int64(0) ||
       committedAtNs <= int64(0) ||
       updatedAtNs <= int64(0) ||
       storePathLenRaw <= int64(0) ||
       walPathLenRaw <= int64(0) ||
       storePathLenRaw > int64(65536) ||
       walPathLenRaw > int64(65536) ||
       storePathHash <= int64(0) ||
       walPathHash <= int64(0) ||
       headHash <= int64(0):
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file: header")
    let targetPeerRes = DistributedPeerIdByTextHash(peers, targetPeerHash)
    if IsErr(targetPeerRes):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(targetPeerRes))
    let storePathLen = int32(storePathLenRaw)
    let walPathLen = int32(walPathLenRaw)
    let wantBytes = headerBytes + storePathLen + walPathLen
    if rawbytes.BytesLen(bytes) != wantBytes:
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file: byte length")
    let storePathRes = DistributedReadStringFromFileBytes(bytes, headerBytes, storePathLen)
    if IsErr(storePathRes):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(storePathRes))
    let walPathRes = DistributedReadStringFromFileBytes(bytes, headerBytes + storePathLen, walPathLen)
    if IsErr(walPathRes):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(walPathRes))
    let storeFilePath = Value(storePathRes)
    let walFilePath = Value(walPathRes)
    if DistributedTransportFrameTextHash(storeFilePath) != storePathHash ||
       DistributedTransportFrameTextHash(walFilePath) != walPathHash ||
       storeFilePath == walFilePath:
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file: path hash")
    var receipt = DistributedKvResidencyHeadFileReceipt(
        schema: DistributedKvResidencyHeadFileReceiptSchema,
        path: path,
        enginePlanHash: enginePlanHash,
        targetPeerId: Value(targetPeerRes),
        baseStoreHash: baseStoreHash,
        currentStoreHash: currentStoreHash,
        commitSeq: int32(commitSeqRaw),
        previousCommitHash: previousCommitHash,
        commitHash: commitHash,
        storeFilePath: storeFilePath,
        walFilePath: walFilePath,
        storeFileReceiptHash: storeFileReceiptHash,
        walFileReceiptHash: walFileReceiptHash,
        walLogHash: walLogHash,
        walRecordCount: int32(walRecordCountRaw),
        committedAtNs: committedAtNs,
        updatedAtNs: updatedAtNs,
        byteCount: rawbytes.BytesLen(bytes),
        byteHash: DistributedKvResidencyHeadFileByteHash(bytes),
        headHash: headHash
    )
    if DistributedKvResidencyHeadFileReceiptHash(receipt) != receipt.headHash:
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file: head hash")
    let commit = DistributedKvResidencyHeadCommitReceipt(receipt)
    if DistributedKvResidencyDurableCommitReceiptHash(commit) != commit.commitHash:
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file: commit hash")
    return Ok[DistributedKvResidencyHeadFileReceipt](receipt)

@borrows
fn DistributedReadKvResidencyHeadFile(plan: DistributedInferencePlan,
                                      peers: DistributedInferencePeer[],
                                      path: str): Result[DistributedKvResidencyHeadFileReadResult] =
    if path == "":
        return Err[DistributedKvResidencyHeadFileReadResult]("distributed kv residency head file: path")
    let bytesRes = os.ReadFileBytesResult(path)
    if IsErr(bytesRes):
        return Err[DistributedKvResidencyHeadFileReadResult](Error(bytesRes))
    var bytes = Value(bytesRes)
    let receiptRes = DistributedKvResidencyHeadFileFromBytes(plan, peers, path, bytes)
    if IsErr(receiptRes):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyHeadFileReadResult](Error(receiptRes))
    let out = DistributedKvResidencyHeadFileReadResult(
        receipt: Value(receiptRes)
    )
    rawbytes.BytesFree(bytes)
    return Ok[DistributedKvResidencyHeadFileReadResult](out)

@borrows
fn DistributedValidateKvResidencyHeadFileReceipt(plan: DistributedInferencePlan,
                                                 peers: DistributedInferencePeer[],
                                                 baseStore: DistributedKvResidencyStore,
                                                 receipt: DistributedKvResidencyHeadFileReceipt): Result[bool] =
    if receipt.schema != DistributedKvResidencyHeadFileReceiptSchema ||
       receipt.path == "" ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.targetPeerId != baseStore.targetPeerId ||
       receipt.baseStoreHash != baseStore.storeHash ||
       receipt.currentStoreHash <= int64(0) ||
       receipt.commitSeq < 0 ||
       receipt.previousCommitHash < int64(0) ||
       receipt.commitHash <= int64(0) ||
       receipt.storeFilePath == "" ||
       receipt.walFilePath == "" ||
       receipt.storeFilePath == receipt.walFilePath ||
       receipt.storeFileReceiptHash <= int64(0) ||
       receipt.walFileReceiptHash <= int64(0) ||
       receipt.walLogHash <= int64(0) ||
       receipt.walRecordCount < 0 ||
       receipt.committedAtNs <= int64(0) ||
       receipt.updatedAtNs <= int64(0) ||
       receipt.byteCount <= 0 ||
       receipt.byteHash <= int64(0) ||
       receipt.headHash <= int64(0):
        return Err[bool]("distributed kv residency head file receipt: schema")
    if DistributedKvResidencyHeadFileReceiptHash(receipt) != receipt.headHash:
        return Err[bool]("distributed kv residency head file receipt: hash")
    let readRes = DistributedReadKvResidencyHeadFile(plan, peers, receipt.path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    let got = Value(readRes).receipt
    if got.enginePlanHash != receipt.enginePlanHash ||
       got.targetPeerId != receipt.targetPeerId ||
       got.baseStoreHash != receipt.baseStoreHash ||
       got.currentStoreHash != receipt.currentStoreHash ||
       got.commitSeq != receipt.commitSeq ||
       got.previousCommitHash != receipt.previousCommitHash ||
       got.commitHash != receipt.commitHash ||
       got.storeFilePath != receipt.storeFilePath ||
       got.walFilePath != receipt.walFilePath ||
       got.storeFileReceiptHash != receipt.storeFileReceiptHash ||
       got.walFileReceiptHash != receipt.walFileReceiptHash ||
       got.walLogHash != receipt.walLogHash ||
       got.walRecordCount != receipt.walRecordCount ||
       got.committedAtNs != receipt.committedAtNs ||
       got.updatedAtNs != receipt.updatedAtNs ||
       got.byteCount != receipt.byteCount ||
       got.byteHash != receipt.byteHash ||
       got.headHash != receipt.headHash:
        return Err[bool]("distributed kv residency head file receipt: mismatch")
    let commit = DistributedKvResidencyHeadCommitReceipt(receipt)
    let commitOk = DistributedValidateKvResidencyDurableCommitReceipt(plan, peers, baseStore, commit)
    if IsErr(commitOk):
        return Err[bool](Error(commitOk))
    return Ok[bool](true)

@borrows
fn DistributedWriteKvResidencyHeadFile(plan: DistributedInferencePlan,
                                       peers: DistributedInferencePeer[],
                                       baseStore: DistributedKvResidencyStore,
                                       commit: DistributedKvResidencyDurableCommitReceipt,
                                       headPath: str,
                                       tempPath: str,
                                       expectedPreviousCommitHash: int64,
                                       expectedPreviousCommitSeq: int32,
                                       updatedAtNs: int64): Result[DistributedKvResidencyHeadFileReceipt] =
    if headPath == "" ||
       tempPath == "" ||
       headPath == tempPath ||
       expectedPreviousCommitHash < int64(0) ||
       updatedAtNs <= int64(0):
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file write: args")
    let commitOk = DistributedValidateKvResidencyDurableCommitReceipt(plan, peers, baseStore, commit)
    if IsErr(commitOk):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(commitOk))
    if os.FileExists(headPath):
        let currentRead = DistributedReadKvResidencyHeadFile(plan, peers, headPath)
        if IsErr(currentRead):
            return Err[DistributedKvResidencyHeadFileReceipt](Error(currentRead))
        let current = Value(currentRead).receipt
        let currentOk = DistributedValidateKvResidencyHeadFileReceipt(plan, peers, baseStore, current)
        if IsErr(currentOk):
            return Err[DistributedKvResidencyHeadFileReceipt](Error(currentOk))
        if current.commitHash != expectedPreviousCommitHash ||
           current.commitSeq != expectedPreviousCommitSeq:
            return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file write: compare")
        if commit.previousCommitHash != expectedPreviousCommitHash ||
           commit.commitSeq != expectedPreviousCommitSeq + 1:
            return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file write: chain")
    else:
        if expectedPreviousCommitHash != int64(0) ||
           expectedPreviousCommitSeq >= 0 ||
           commit.previousCommitHash != int64(0) ||
           commit.commitSeq != 0:
            return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file write: first commit")
    let headRes = DistributedKvResidencyHeadFileReceiptBuild(headPath, commit, updatedAtNs)
    if IsErr(headRes):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(headRes))
    var head = Value(headRes)
    let bytesRes = DistributedKvResidencyHeadFileBytes(head)
    if IsErr(bytesRes):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(bytesRes))
    var bytes = Value(bytesRes)
    head.byteCount = rawbytes.BytesLen(bytes)
    head.byteHash = DistributedKvResidencyHeadFileByteHash(bytes)
    if os.FileExists(tempPath):
        if !os.RemoveFile(tempPath):
            rawbytes.BytesFree(bytes)
            return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file write: remove temp")
    let writeRes = os.WriteFileBytesResult(tempPath, bytes)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyHeadFileReceipt](Error(writeRes))
    let tempRead = os.ReadFileBytesResult(tempPath)
    if IsErr(tempRead):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyHeadFileReceipt](Error(tempRead))
    var tempBytes = Value(tempRead)
    if rawbytes.BytesLen(tempBytes) != rawbytes.BytesLen(bytes) ||
       DistributedKvResidencyHeadFileByteHash(tempBytes) != DistributedKvResidencyHeadFileByteHash(bytes):
        rawbytes.BytesFree(bytes)
        rawbytes.BytesFree(tempBytes)
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file write: temp readback")
    rawbytes.BytesFree(tempBytes)
    if !os.RenameFile(tempPath, headPath):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file write: rename")
    rawbytes.BytesFree(bytes)
    let finalRead = DistributedReadKvResidencyHeadFile(plan, peers, headPath)
    if IsErr(finalRead):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(finalRead))
    let finalHead = Value(finalRead).receipt
    if finalHead.commitHash != head.commitHash ||
       finalHead.commitSeq != head.commitSeq ||
       finalHead.previousCommitHash != head.previousCommitHash ||
       finalHead.currentStoreHash != head.currentStoreHash ||
       finalHead.storeFileReceiptHash != head.storeFileReceiptHash ||
       finalHead.walFileReceiptHash != head.walFileReceiptHash ||
       finalHead.byteCount != head.byteCount ||
       finalHead.byteHash != head.byteHash ||
       finalHead.headHash != head.headHash:
        return Err[DistributedKvResidencyHeadFileReceipt]("distributed kv residency head file write: final mismatch")
    return Ok[DistributedKvResidencyHeadFileReceipt](finalHead)

@borrows
fn DistributedRecoverKvResidencyStoreFromHeadFile(plan: DistributedInferencePlan,
                                                  peers: DistributedInferencePeer[],
                                                  baseStore: DistributedKvResidencyStore,
                                                  headPath: str,
                                                  recoveredAtNs: int64): Result[DistributedKvResidencyDurableRecoveryResult] =
    let headRead = DistributedReadKvResidencyHeadFile(plan, peers, headPath)
    if IsErr(headRead):
        return Err[DistributedKvResidencyDurableRecoveryResult](Error(headRead))
    let head = Value(headRead).receipt
    let headOk = DistributedValidateKvResidencyHeadFileReceipt(plan, peers, baseStore, head)
    if IsErr(headOk):
        return Err[DistributedKvResidencyDurableRecoveryResult](Error(headOk))
    let commit = DistributedKvResidencyHeadCommitReceipt(head)
    return DistributedRecoverKvResidencyStoreFromDurableCommit(plan, peers, baseStore, commit, recoveredAtNs)

@borrows
fn DistributedKvResidencyHeadLockFilePath(lockDirPath: str): str =
    return strutil.Join([ share(lockDirPath), "/owner.ckvl1"], "")

@borrows
fn DistributedKvResidencyHeadLockFileByteHash(bytes: rawbytes.Bytes): int64 =
    return DistributedHashBytesWith(int64(157), bytes)

@borrows
fn DistributedKvResidencyHeadLockReceiptHash(receipt: DistributedKvResidencyHeadLockReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashTextWith(h, receipt.lockDirPath)
    h = DistributedHashTextWith(h, receipt.lockFilePath)
    h = DistributedHashTextWith(h, receipt.ownerId)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashStep(h, receipt.baseStoreHash)
    h = DistributedHashTextWith(h, receipt.headPath)
    h = DistributedHashStep(h, receipt.expectedPreviousCommitHash)
    h = DistributedHashStep(h, int64(receipt.expectedPreviousCommitSeq))
    h = DistributedHashStep(h, receipt.acquiredAtNs)
    h = DistributedHashStep(h, receipt.leaseUntilNs)
    return h

@borrows
fn DistributedBuildKvResidencyHeadLockReceipt(plan: DistributedInferencePlan,
                                              baseStore: DistributedKvResidencyStore,
                                              lockDirPath: str,
                                              ownerId: str,
                                              headPath: str,
                                              expectedPreviousCommitHash: int64,
                                              expectedPreviousCommitSeq: int32,
                                              acquiredAtNs: int64,
                                              leaseUntilNs: int64): Result[DistributedKvResidencyHeadLockReceipt] =
    if lockDirPath == "" ||
       ownerId == "" ||
       headPath == "" ||
       expectedPreviousCommitHash < int64(0) ||
       expectedPreviousCommitSeq < -1 ||
       acquiredAtNs <= int64(0) ||
       leaseUntilNs <= acquiredAtNs ||
       baseStore.schema != DistributedKvResidencyStoreSchema ||
       baseStore.enginePlanHash != plan.engineHash ||
       baseStore.targetPeerId == "" ||
       baseStore.storeHash <= int64(0):
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock: args")
    var receipt = DistributedKvResidencyHeadLockReceipt(
        schema: DistributedKvResidencyHeadLockReceiptSchema,
        lockDirPath: lockDirPath,
        lockFilePath: DistributedKvResidencyHeadLockFilePath(lockDirPath),
        ownerId: ownerId,
        enginePlanHash: plan.engineHash,
        targetPeerId: baseStore.targetPeerId,
        baseStoreHash: baseStore.storeHash,
        headPath: headPath,
        expectedPreviousCommitHash: expectedPreviousCommitHash,
        expectedPreviousCommitSeq: expectedPreviousCommitSeq,
        acquiredAtNs: acquiredAtNs,
        leaseUntilNs: leaseUntilNs,
        byteCount: 0,
        byteHash: int64(0),
        lockHash: int64(0)
    )
    receipt.lockHash = DistributedKvResidencyHeadLockReceiptHash(receipt)
    return Ok[DistributedKvResidencyHeadLockReceipt](receipt)

fn DistributedKvResidencyHeadLockHeaderWord(lock: DistributedKvResidencyHeadLockReceipt,
                                            index: int32): int64 =
    if index == 0:
        return int64(DistributedKvResidencyHeadLockFileMagic)
    if index == 1:
        return int64(DistributedKvResidencyHeadLockFileVersion)
    if index == 2:
        return lock.enginePlanHash
    if index == 3:
        return DistributedTransportFrameTextHash(lock.targetPeerId)
    if index == 4:
        return lock.baseStoreHash
    if index == 5:
        return lock.expectedPreviousCommitHash
    if index == 6:
        return int64(lock.expectedPreviousCommitSeq)
    if index == 7:
        return lock.acquiredAtNs
    if index == 8:
        return lock.leaseUntilNs
    if index == 9:
        return int64(len(lock.ownerId))
    if index == 10:
        return int64(len(lock.headPath))
    if index == 11:
        return DistributedTransportFrameTextHash(lock.ownerId)
    if index == 12:
        return DistributedTransportFrameTextHash(lock.headPath)
    if index == 13:
        return lock.lockHash
    if index == 14:
        return int64(0)
    if index == 15:
        return int64(0)
    return int64(-1)

fn DistributedKvResidencyHeadLockFileBytes(lock: DistributedKvResidencyHeadLockReceipt): Result[rawbytes.Bytes] =
    if lock.schema != DistributedKvResidencyHeadLockReceiptSchema ||
       lock.lockDirPath == "" ||
       lock.lockFilePath != DistributedKvResidencyHeadLockFilePath(lock.lockDirPath) ||
       lock.ownerId == "" ||
       lock.targetPeerId == "" ||
       lock.headPath == "" ||
       lock.lockHash <= int64(0):
        return Err[rawbytes.Bytes]("distributed kv residency head lock file: schema")
    if DistributedKvResidencyHeadLockReceiptHash(lock) != lock.lockHash:
        return Err[rawbytes.Bytes]("distributed kv residency head lock file: hash")
    let ownerLen = len(lock.ownerId)
    let headPathLen = len(lock.headPath)
    if ownerLen <= 0 || headPathLen <= 0 || ownerLen > 65536 || headPathLen > 65536:
        return Err[rawbytes.Bytes]("distributed kv residency head lock file: text length")
    let headerBytes = DistributedKvResidencyHeadLockFileHeaderWordCount * 8
    let byteCount = headerBytes + ownerLen + headPathLen
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("distributed kv residency head lock file: allocation")
    for h in 0..<DistributedKvResidencyHeadLockFileHeaderWordCount:
        DistributedWriteI64LE(out, h * 8, DistributedKvResidencyHeadLockHeaderWord(lock, h))
    let ownerBytes = rawbytes.BytesFromString(lock.ownerId)
    let ownerCopy = DistributedCopyBytesInto(out, headerBytes, ownerBytes)
    if IsErr(ownerCopy):
        rawbytes.BytesFree(out)
        return Err[rawbytes.Bytes](Error(ownerCopy))
    let headPathBytes = rawbytes.BytesFromString(lock.headPath)
    let headCopy = DistributedCopyBytesInto(out, headerBytes + ownerLen, headPathBytes)
    if IsErr(headCopy):
        rawbytes.BytesFree(out)
        return Err[rawbytes.Bytes](Error(headCopy))
    return Ok[rawbytes.Bytes](out)

fn DistributedKvResidencyHeadLockFromBytes(plan: DistributedInferencePlan,
                                           peers: DistributedInferencePeer[],
                                           baseStore: DistributedKvResidencyStore,
                                           lockDirPath: str,
                                           bytes: rawbytes.Bytes): Result[DistributedKvResidencyHeadLockReceipt] =
    let headerBytes = DistributedKvResidencyHeadLockFileHeaderWordCount * 8
    if lockDirPath == "" || rawbytes.BytesLen(bytes) < headerBytes:
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock file: short header")
    let magic = DistributedReadI64LE(bytes, 0)
    let version = DistributedReadI64LE(bytes, 8)
    let enginePlanHash = DistributedReadI64LE(bytes, 16)
    let targetPeerHash = DistributedReadI64LE(bytes, 24)
    let baseStoreHash = DistributedReadI64LE(bytes, 32)
    let expectedPreviousCommitHash = DistributedReadI64LE(bytes, 40)
    let expectedPreviousCommitSeqRaw = DistributedReadI64LE(bytes, 48)
    let acquiredAtNs = DistributedReadI64LE(bytes, 56)
    let leaseUntilNs = DistributedReadI64LE(bytes, 64)
    let ownerLenRaw = DistributedReadI64LE(bytes, 72)
    let headPathLenRaw = DistributedReadI64LE(bytes, 80)
    let ownerHash = DistributedReadI64LE(bytes, 88)
    let headPathHash = DistributedReadI64LE(bytes, 96)
    let lockHash = DistributedReadI64LE(bytes, 104)
    if magic != int64(DistributedKvResidencyHeadLockFileMagic) ||
       version != int64(DistributedKvResidencyHeadLockFileVersion):
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock file: magic")
    if enginePlanHash != plan.engineHash ||
       baseStoreHash != baseStore.storeHash ||
       expectedPreviousCommitHash < int64(0) ||
       expectedPreviousCommitSeqRaw < int64(-1) ||
       acquiredAtNs <= int64(0) ||
       leaseUntilNs <= acquiredAtNs ||
       ownerLenRaw <= int64(0) ||
       headPathLenRaw <= int64(0) ||
       ownerLenRaw > int64(65536) ||
       headPathLenRaw > int64(65536) ||
       ownerHash <= int64(0) ||
       headPathHash <= int64(0) ||
       lockHash <= int64(0):
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock file: header")
    let targetPeerRes = DistributedPeerIdByTextHash(peers, targetPeerHash)
    if IsErr(targetPeerRes):
        return Err[DistributedKvResidencyHeadLockReceipt](Error(targetPeerRes))
    if Value(targetPeerRes) != baseStore.targetPeerId:
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock file: target")
    let ownerLen = int32(ownerLenRaw)
    let headPathLen = int32(headPathLenRaw)
    let wantBytes = headerBytes + ownerLen + headPathLen
    if rawbytes.BytesLen(bytes) != wantBytes:
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock file: byte length")
    let ownerRes = DistributedReadStringFromFileBytes(bytes, headerBytes, ownerLen)
    if IsErr(ownerRes):
        return Err[DistributedKvResidencyHeadLockReceipt](Error(ownerRes))
    let headPathRes = DistributedReadStringFromFileBytes(bytes, headerBytes + ownerLen, headPathLen)
    if IsErr(headPathRes):
        return Err[DistributedKvResidencyHeadLockReceipt](Error(headPathRes))
    let ownerId = Value(ownerRes)
    let headPath = Value(headPathRes)
    if DistributedTransportFrameTextHash(ownerId) != ownerHash ||
       DistributedTransportFrameTextHash(headPath) != headPathHash:
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock file: text hash")
    var receipt = DistributedKvResidencyHeadLockReceipt(
        schema: DistributedKvResidencyHeadLockReceiptSchema,
        lockDirPath: lockDirPath,
        lockFilePath: DistributedKvResidencyHeadLockFilePath(lockDirPath),
        ownerId: ownerId,
        enginePlanHash: enginePlanHash,
        targetPeerId: Value(targetPeerRes),
        baseStoreHash: baseStoreHash,
        headPath: headPath,
        expectedPreviousCommitHash: expectedPreviousCommitHash,
        expectedPreviousCommitSeq: int32(expectedPreviousCommitSeqRaw),
        acquiredAtNs: acquiredAtNs,
        leaseUntilNs: leaseUntilNs,
        byteCount: rawbytes.BytesLen(bytes),
        byteHash: DistributedKvResidencyHeadLockFileByteHash(bytes),
        lockHash: lockHash
    )
    if DistributedKvResidencyHeadLockReceiptHash(receipt) != receipt.lockHash:
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock file: lock hash")
    return Ok[DistributedKvResidencyHeadLockReceipt](receipt)

fn DistributedReadKvResidencyHeadLock(plan: DistributedInferencePlan,
                                      peers: DistributedInferencePeer[],
                                      baseStore: DistributedKvResidencyStore,
                                      lockDirPath: str): Result[DistributedKvResidencyHeadLockReadResult] =
    if lockDirPath == "":
        return Err[DistributedKvResidencyHeadLockReadResult]("distributed kv residency head lock read: path")
    let lockFilePath = DistributedKvResidencyHeadLockFilePath(lockDirPath)
    let bytesRes = os.ReadFileBytesResult(lockFilePath)
    if IsErr(bytesRes):
        return Err[DistributedKvResidencyHeadLockReadResult](Error(bytesRes))
    var bytes = Value(bytesRes)
    let receiptRes = DistributedKvResidencyHeadLockFromBytes(plan, peers, baseStore, lockDirPath, bytes)
    if IsErr(receiptRes):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyHeadLockReadResult](Error(receiptRes))
    let out = DistributedKvResidencyHeadLockReadResult(
        receipt: Value(receiptRes)
    )
    rawbytes.BytesFree(bytes)
    return Ok[DistributedKvResidencyHeadLockReadResult](out)

@borrows
fn DistributedValidateKvResidencyHeadLockReceipt(plan: DistributedInferencePlan,
                                                 peers: DistributedInferencePeer[],
                                                 baseStore: DistributedKvResidencyStore,
                                                 receipt: DistributedKvResidencyHeadLockReceipt): Result[bool] =
    if receipt.schema != DistributedKvResidencyHeadLockReceiptSchema ||
       receipt.lockDirPath == "" ||
       receipt.lockFilePath != DistributedKvResidencyHeadLockFilePath(receipt.lockDirPath) ||
       receipt.ownerId == "" ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.targetPeerId != baseStore.targetPeerId ||
       receipt.baseStoreHash != baseStore.storeHash ||
       receipt.headPath == "" ||
       receipt.expectedPreviousCommitHash < int64(0) ||
       receipt.expectedPreviousCommitSeq < -1 ||
       receipt.acquiredAtNs <= int64(0) ||
       receipt.leaseUntilNs <= receipt.acquiredAtNs ||
       receipt.byteCount <= 0 ||
       receipt.byteHash <= int64(0) ||
       receipt.lockHash <= int64(0):
        return Err[bool]("distributed kv residency head lock receipt: schema")
    if !os.DirExists(receipt.lockDirPath):
        return Err[bool]("distributed kv residency head lock receipt: dir")
    if DistributedKvResidencyHeadLockReceiptHash(receipt) != receipt.lockHash:
        return Err[bool]("distributed kv residency head lock receipt: hash")
    let readRes = DistributedReadKvResidencyHeadLock(plan, peers, baseStore, receipt.lockDirPath)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    let got = Value(readRes).receipt
    if got.lockFilePath != receipt.lockFilePath ||
       got.ownerId != receipt.ownerId ||
       got.enginePlanHash != receipt.enginePlanHash ||
       got.targetPeerId != receipt.targetPeerId ||
       got.baseStoreHash != receipt.baseStoreHash ||
       got.headPath != receipt.headPath ||
       got.expectedPreviousCommitHash != receipt.expectedPreviousCommitHash ||
       got.expectedPreviousCommitSeq != receipt.expectedPreviousCommitSeq ||
       got.acquiredAtNs != receipt.acquiredAtNs ||
       got.leaseUntilNs != receipt.leaseUntilNs ||
       got.byteCount != receipt.byteCount ||
       got.byteHash != receipt.byteHash ||
       got.lockHash != receipt.lockHash:
        return Err[bool]("distributed kv residency head lock receipt: mismatch")
    return Ok[bool](true)

@borrows
fn DistributedAcquireKvResidencyHeadLock(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[],
                                         baseStore: DistributedKvResidencyStore,
                                         lockDirPath: str,
                                         ownerId: str,
                                         headPath: str,
                                         expectedPreviousCommitHash: int64,
                                         expectedPreviousCommitSeq: int32,
                                         acquiredAtNs: int64,
                                         leaseUntilNs: int64): Result[DistributedKvResidencyHeadLockReceipt] =
    if lockDirPath == "" || ownerId == "" || headPath == "":
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock acquire: args")
    let baseOk = DistributedValidateKvResidencyStore(plan, peers, baseStore)
    if IsErr(baseOk):
        return Err[DistributedKvResidencyHeadLockReceipt](Error(baseOk))
    if os.DirExists(lockDirPath):
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock acquire: held")
    let receiptRes = DistributedBuildKvResidencyHeadLockReceipt(
        plan,
        baseStore,
        lockDirPath,
        ownerId,
        headPath,
        expectedPreviousCommitHash,
        expectedPreviousCommitSeq,
        acquiredAtNs,
        leaseUntilNs
    )
    if IsErr(receiptRes):
        return Err[DistributedKvResidencyHeadLockReceipt](Error(receiptRes))
    let receipt = Value(receiptRes)
    let bytesRes = DistributedKvResidencyHeadLockFileBytes(receipt)
    if IsErr(bytesRes):
        return Err[DistributedKvResidencyHeadLockReceipt](Error(bytesRes))
    var bytes = Value(bytesRes)
    if !os.MakeDir(lockDirPath):
        rawbytes.BytesFree(bytes)
        return Err[DistributedKvResidencyHeadLockReceipt]("distributed kv residency head lock acquire: mkdir")
    let writeRes = os.WriteFileBytesResult(receipt.lockFilePath, bytes)
    if IsErr(writeRes):
        rawbytes.BytesFree(bytes)
        if os.FileExists(receipt.lockFilePath):
            let _removePartial = os.RemoveFile(receipt.lockFilePath)
        os.RemoveDir(lockDirPath)
        return Err[DistributedKvResidencyHeadLockReceipt](Error(writeRes))
    rawbytes.BytesFree(bytes)
    let finalRead = DistributedReadKvResidencyHeadLock(plan, peers, baseStore, lockDirPath)
    if IsErr(finalRead):
        return Err[DistributedKvResidencyHeadLockReceipt](Error(finalRead))
    let finalReceipt = Value(finalRead).receipt
    let finalOk = DistributedValidateKvResidencyHeadLockReceipt(plan, peers, baseStore, finalReceipt)
    if IsErr(finalOk):
        return Err[DistributedKvResidencyHeadLockReceipt](Error(finalOk))
    return Ok[DistributedKvResidencyHeadLockReceipt](finalReceipt)

@borrows
fn DistributedReleaseKvResidencyHeadLock(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[],
                                         baseStore: DistributedKvResidencyStore,
                                         receipt: DistributedKvResidencyHeadLockReceipt): Result[bool] =
    let lockOk = DistributedValidateKvResidencyHeadLockReceipt(plan, peers, baseStore, receipt)
    if IsErr(lockOk):
        return Err[bool](Error(lockOk))
    if !os.RemoveFile(receipt.lockFilePath):
        return Err[bool]("distributed kv residency head lock release: file")
    os.RemoveDir(receipt.lockDirPath)
    if os.DirExists(receipt.lockDirPath):
        return Err[bool]("distributed kv residency head lock release: dir")
    return Ok[bool](true)

@borrows
fn DistributedWriteKvResidencyHeadFileWithLock(plan: DistributedInferencePlan,
                                               peers: DistributedInferencePeer[],
                                               baseStore: DistributedKvResidencyStore,
                                               commit: DistributedKvResidencyDurableCommitReceipt,
                                               headPath: str,
                                               tempPath: str,
                                               lockDirPath: str,
                                               ownerId: str,
                                               expectedPreviousCommitHash: int64,
                                               expectedPreviousCommitSeq: int32,
                                               acquiredAtNs: int64,
                                               leaseUntilNs: int64,
                                               updatedAtNs: int64): Result[DistributedKvResidencyHeadFileReceipt] =
    let lockRes = DistributedAcquireKvResidencyHeadLock(
        plan,
        peers,
        baseStore,
        lockDirPath,
        ownerId,
        headPath,
        expectedPreviousCommitHash,
        expectedPreviousCommitSeq,
        acquiredAtNs,
        leaseUntilNs
    )
    if IsErr(lockRes):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(lockRes))
    let lock = Value(lockRes)
    let writeRes = DistributedWriteKvResidencyHeadFile(
        plan,
        peers,
        baseStore,
        commit,
        headPath,
        tempPath,
        expectedPreviousCommitHash,
        expectedPreviousCommitSeq,
        updatedAtNs
    )
    if IsErr(writeRes):
        let releaseAfterFailure = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
        if IsErr(releaseAfterFailure):
            return Err[DistributedKvResidencyHeadFileReceipt](Error(releaseAfterFailure))
        return Err[DistributedKvResidencyHeadFileReceipt](Error(writeRes))
    let releaseRes = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
    if IsErr(releaseRes):
        return Err[DistributedKvResidencyHeadFileReceipt](Error(releaseRes))
    return Ok[DistributedKvResidencyHeadFileReceipt](Value(writeRes))

@borrows
fn DistributedKvResidencyServiceCommitReceiptHash(receipt: DistributedKvResidencyServiceCommitReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashTextWith(h, receipt.ownerId)
    h = DistributedHashStep(h, receipt.baseStoreHash)
    h = DistributedHashStep(h, receipt.finalStoreHash)
    h = DistributedHashStep(h, receipt.previousCommitHash)
    h = DistributedHashStep(h, int64(receipt.previousCommitSeq))
    h = DistributedHashStep(h, int64(receipt.commitSeq))
    h = DistributedHashStep(h, receipt.lockHash)
    h = DistributedHashStep(h, receipt.durableCommitHash)
    h = DistributedHashStep(h, receipt.headHash)
    h = DistributedHashTextWith(h, receipt.storeFilePath)
    h = DistributedHashTextWith(h, receipt.walFilePath)
    h = DistributedHashTextWith(h, receipt.headPath)
    h = DistributedHashStep(h, receipt.storeFileReceiptHash)
    h = DistributedHashStep(h, receipt.walFileReceiptHash)
    h = DistributedHashStep(h, receipt.walLogHash)
    h = DistributedHashStep(h, int64(receipt.walRecordCount))
    h = DistributedHashStep(h, receipt.committedAtNs)
    h = DistributedHashStep(h, receipt.updatedAtNs)
    return h

@borrows
fn DistributedBuildKvResidencyServiceCommitReceipt(lock: DistributedKvResidencyHeadLockReceipt,
                                                   commit: DistributedKvResidencyDurableCommitReceipt,
                                                   head: DistributedKvResidencyHeadFileReceipt): Result[DistributedKvResidencyServiceCommitReceipt] =
    if lock.schema != DistributedKvResidencyHeadLockReceiptSchema ||
       commit.schema != DistributedKvResidencyDurableCommitReceiptSchema ||
       head.schema != DistributedKvResidencyHeadFileReceiptSchema ||
       lock.enginePlanHash != commit.enginePlanHash ||
       lock.enginePlanHash != head.enginePlanHash ||
       lock.targetPeerId != commit.targetPeerId ||
       lock.targetPeerId != head.targetPeerId ||
       lock.baseStoreHash != commit.baseStoreHash ||
       lock.baseStoreHash != head.baseStoreHash ||
       lock.headPath != head.path ||
       lock.expectedPreviousCommitHash != commit.previousCommitHash ||
       lock.expectedPreviousCommitSeq + 1 != commit.commitSeq ||
       commit.commitHash != head.commitHash ||
       commit.finalStoreHash != head.currentStoreHash ||
       commit.storeFilePath != head.storeFilePath ||
       commit.walFilePath != head.walFilePath ||
       commit.storeFileReceiptHash != head.storeFileReceiptHash ||
       commit.walFileReceiptHash != head.walFileReceiptHash ||
       commit.walLogHash != head.walLogHash ||
       commit.walRecordCount != head.walRecordCount ||
       commit.committedAtNs != head.committedAtNs:
        return Err[DistributedKvResidencyServiceCommitReceipt]("distributed kv residency service commit receipt: binding")
    if DistributedKvResidencyHeadLockReceiptHash(lock) != lock.lockHash ||
       DistributedKvResidencyDurableCommitReceiptHash(commit) != commit.commitHash ||
       DistributedKvResidencyHeadFileReceiptHash(head) != head.headHash:
        return Err[DistributedKvResidencyServiceCommitReceipt]("distributed kv residency service commit receipt: hash")
    var receipt = DistributedKvResidencyServiceCommitReceipt(
        schema: DistributedKvResidencyServiceCommitReceiptSchema,
        enginePlanHash: commit.enginePlanHash,
        targetPeerId: commit.targetPeerId,
        ownerId: lock.ownerId,
        baseStoreHash: commit.baseStoreHash,
        finalStoreHash: commit.finalStoreHash,
        previousCommitHash: commit.previousCommitHash,
        previousCommitSeq: lock.expectedPreviousCommitSeq,
        commitSeq: commit.commitSeq,
        lockHash: lock.lockHash,
        durableCommitHash: commit.commitHash,
        headHash: head.headHash,
        storeFilePath: commit.storeFilePath,
        walFilePath: commit.walFilePath,
        headPath: head.path,
        storeFileReceiptHash: commit.storeFileReceiptHash,
        walFileReceiptHash: commit.walFileReceiptHash,
        walLogHash: commit.walLogHash,
        walRecordCount: commit.walRecordCount,
        committedAtNs: commit.committedAtNs,
        updatedAtNs: head.updatedAtNs,
        serviceCommitHash: int64(0)
    )
    receipt.serviceCommitHash = DistributedKvResidencyServiceCommitReceiptHash(receipt)
    return Ok[DistributedKvResidencyServiceCommitReceipt](receipt)

@borrows
fn DistributedValidateKvResidencyServiceCommitReceipt(plan: DistributedInferencePlan,
                                                      peers: DistributedInferencePeer[],
                                                      baseStore: DistributedKvResidencyStore,
                                                      receipt: DistributedKvResidencyServiceCommitReceipt): Result[bool] =
    if receipt.schema != DistributedKvResidencyServiceCommitReceiptSchema ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.targetPeerId != baseStore.targetPeerId ||
       receipt.ownerId == "" ||
       receipt.baseStoreHash != baseStore.storeHash ||
       receipt.finalStoreHash <= int64(0) ||
       receipt.previousCommitHash < int64(0) ||
       receipt.previousCommitSeq < -1 ||
       receipt.commitSeq != receipt.previousCommitSeq + 1 ||
       receipt.lockHash <= int64(0) ||
       receipt.durableCommitHash <= int64(0) ||
       receipt.headHash <= int64(0) ||
       receipt.storeFilePath == "" ||
       receipt.walFilePath == "" ||
       receipt.headPath == "" ||
       receipt.storeFilePath == receipt.walFilePath ||
       receipt.storeFileReceiptHash <= int64(0) ||
       receipt.walFileReceiptHash <= int64(0) ||
       receipt.walLogHash <= int64(0) ||
       receipt.walRecordCount < 0 ||
       receipt.committedAtNs <= int64(0) ||
       receipt.updatedAtNs <= int64(0):
        return Err[bool]("distributed kv residency service commit receipt: schema")
    if DistributedKvResidencyServiceCommitReceiptHash(receipt) != receipt.serviceCommitHash:
        return Err[bool]("distributed kv residency service commit receipt: hash")
    let storeRead = DistributedReadKvResidencyStoreFile(plan, peers, receipt.storeFilePath)
    if IsErr(storeRead):
        return Err[bool](Error(storeRead))
    let walRead = DistributedReadKvResidencyWalLogFile(plan, peers, baseStore, receipt.walFilePath)
    if IsErr(walRead):
        return Err[bool](Error(walRead))
    let buildCommit = DistributedBuildKvResidencyDurableCommitReceipt(
        plan,
        peers,
        baseStore,
        Value(storeRead).receipt,
        Value(walRead).receipt,
        receipt.previousCommitHash,
        receipt.commitSeq,
        receipt.committedAtNs
    )
    if IsErr(buildCommit):
        return Err[bool](Error(buildCommit))
    let commit = Value(buildCommit)
    if commit.commitHash != receipt.durableCommitHash ||
       commit.storeHash != receipt.finalStoreHash ||
       commit.storeFileReceiptHash != receipt.storeFileReceiptHash ||
       commit.walFileReceiptHash != receipt.walFileReceiptHash ||
       commit.walLogHash != receipt.walLogHash ||
       commit.walRecordCount != receipt.walRecordCount:
        return Err[bool]("distributed kv residency service commit receipt: durable binding")
    let headRead = DistributedReadKvResidencyHeadFile(plan, peers, receipt.headPath)
    if IsErr(headRead):
        return Err[bool](Error(headRead))
    let head = Value(headRead).receipt
    if head.headHash != receipt.headHash ||
       head.commitHash != receipt.durableCommitHash ||
       head.currentStoreHash != receipt.finalStoreHash ||
       head.storeFileReceiptHash != receipt.storeFileReceiptHash ||
       head.walFileReceiptHash != receipt.walFileReceiptHash ||
       head.walLogHash != receipt.walLogHash ||
       head.walRecordCount != receipt.walRecordCount ||
       head.updatedAtNs != receipt.updatedAtNs:
        return Err[bool]("distributed kv residency service commit receipt: head binding")
    return Ok[bool](true)

@borrows
fn DistributedCommitKvResidencyStoreService(plan: DistributedInferencePlan,
                                            peers: DistributedInferencePeer[],
                                            baseStore: DistributedKvResidencyStore,
                                            finalStore: DistributedKvResidencyStore,
                                            walLog: DistributedKvResidencyWalLog,
                                            storeFilePath: str,
                                            walFilePath: str,
                                            headPath: str,
                                            tempHeadPath: str,
                                            lockDirPath: str,
                                            ownerId: str,
                                            expectedPreviousCommitHash: int64,
                                            expectedPreviousCommitSeq: int32,
                                            acquiredAtNs: int64,
                                            leaseUntilNs: int64,
                                            committedAtNs: int64,
                                            updatedAtNs: int64): Result[DistributedKvResidencyServiceCommitResult] =
    if storeFilePath == "" ||
       walFilePath == "" ||
       headPath == "" ||
       tempHeadPath == "" ||
       lockDirPath == "" ||
       ownerId == "" ||
       storeFilePath == walFilePath ||
       headPath == tempHeadPath ||
       expectedPreviousCommitHash < int64(0) ||
       expectedPreviousCommitSeq < -1:
        return Err[DistributedKvResidencyServiceCommitResult]("distributed kv residency service commit: args")
    let lockRes = DistributedAcquireKvResidencyHeadLock(
        plan,
        peers,
        baseStore,
        lockDirPath,
        ownerId,
        headPath,
        expectedPreviousCommitHash,
        expectedPreviousCommitSeq,
        acquiredAtNs,
        leaseUntilNs
    )
    if IsErr(lockRes):
        return Err[DistributedKvResidencyServiceCommitResult](Error(lockRes))
    let lock = Value(lockRes)
    if os.FileExists(headPath):
        let currentRead = DistributedReadKvResidencyHeadFile(plan, peers, headPath)
        if IsErr(currentRead):
            let releaseAfterCurrentRead = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
            if IsErr(releaseAfterCurrentRead):
                return Err[DistributedKvResidencyServiceCommitResult](Error(releaseAfterCurrentRead))
            return Err[DistributedKvResidencyServiceCommitResult](Error(currentRead))
        let currentHead = Value(currentRead).receipt
        let currentOk = DistributedValidateKvResidencyHeadFileReceipt(plan, peers, baseStore, currentHead)
        if IsErr(currentOk):
            let releaseAfterCurrentValidate = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
            if IsErr(releaseAfterCurrentValidate):
                return Err[DistributedKvResidencyServiceCommitResult](Error(releaseAfterCurrentValidate))
            return Err[DistributedKvResidencyServiceCommitResult](Error(currentOk))
        if currentHead.commitHash != expectedPreviousCommitHash ||
           currentHead.commitSeq != expectedPreviousCommitSeq:
            let releaseAfterCompare = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
            if IsErr(releaseAfterCompare):
                return Err[DistributedKvResidencyServiceCommitResult](Error(releaseAfterCompare))
            return Err[DistributedKvResidencyServiceCommitResult]("distributed kv residency service commit: compare")
    else:
        if expectedPreviousCommitHash != int64(0) || expectedPreviousCommitSeq >= 0:
            let releaseAfterFirst = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
            if IsErr(releaseAfterFirst):
                return Err[DistributedKvResidencyServiceCommitResult](Error(releaseAfterFirst))
            return Err[DistributedKvResidencyServiceCommitResult]("distributed kv residency service commit: first commit")
    let commitSeq = expectedPreviousCommitSeq + 1
    let commitRes = DistributedWriteKvResidencyDurableCommitFiles(
        plan,
        peers,
        baseStore,
        finalStore,
        walLog,
        storeFilePath,
        walFilePath,
        expectedPreviousCommitHash,
        commitSeq,
        committedAtNs
    )
    if IsErr(commitRes):
        let releaseAfterCommit = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
        if IsErr(releaseAfterCommit):
            return Err[DistributedKvResidencyServiceCommitResult](Error(releaseAfterCommit))
        return Err[DistributedKvResidencyServiceCommitResult](Error(commitRes))
    let commit = Value(commitRes)
    let headRes = DistributedWriteKvResidencyHeadFile(
        plan,
        peers,
        baseStore,
        commit,
        headPath,
        tempHeadPath,
        expectedPreviousCommitHash,
        expectedPreviousCommitSeq,
        updatedAtNs
    )
    if IsErr(headRes):
        let releaseAfterHead = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
        if IsErr(releaseAfterHead):
            return Err[DistributedKvResidencyServiceCommitResult](Error(releaseAfterHead))
        return Err[DistributedKvResidencyServiceCommitResult](Error(headRes))
    let head = Value(headRes)
    let serviceReceiptRes = DistributedBuildKvResidencyServiceCommitReceipt(lock, commit, head)
    if IsErr(serviceReceiptRes):
        let releaseAfterReceipt = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
        if IsErr(releaseAfterReceipt):
            return Err[DistributedKvResidencyServiceCommitResult](Error(releaseAfterReceipt))
        return Err[DistributedKvResidencyServiceCommitResult](Error(serviceReceiptRes))
    let serviceReceipt = Value(serviceReceiptRes)
    let releaseRes = DistributedReleaseKvResidencyHeadLock(plan, peers, baseStore, lock)
    if IsErr(releaseRes):
        return Err[DistributedKvResidencyServiceCommitResult](Error(releaseRes))
    let out = DistributedKvResidencyServiceCommitResult(
        commit: commit,
        head: head,
        receipt: serviceReceipt
    )
    return Ok[DistributedKvResidencyServiceCommitResult](out)

@borrows
fn DistributedKvResidencyServiceApplyReceiptHash(receipt: DistributedKvResidencyServiceApplyReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.targetPeerId)
    h = DistributedHashTextWith(h, receipt.ownerId)
    h = DistributedHashStep(h, receipt.baseStoreHash)
    h = DistributedHashStep(h, receipt.previousStoreHash)
    h = DistributedHashStep(h, receipt.finalStoreHash)
    h = DistributedHashStep(h, receipt.scheduleHash)
    h = DistributedHashStep(h, receipt.operationHash)
    h = DistributedHashStep(h, receipt.updateHash)
    h = DistributedHashStep(h, receipt.walRecordHash)
    h = DistributedHashStep(h, receipt.walAppendHash)
    h = DistributedHashStep(h, receipt.walLogHash)
    h = DistributedHashStep(h, receipt.serviceCommitHash)
    h = DistributedHashStep(h, receipt.durableCommitHash)
    h = DistributedHashStep(h, receipt.headHash)
    h = DistributedHashStep(h, receipt.previousCommitHash)
    h = DistributedHashStep(h, int64(receipt.previousCommitSeq))
    h = DistributedHashStep(h, int64(receipt.commitSeq))
    h = DistributedHashStep(h, receipt.appliedAtNs)
    h = DistributedHashStep(h, receipt.appendedAtNs)
    h = DistributedHashStep(h, receipt.committedAtNs)
    h = DistributedHashStep(h, receipt.updatedAtNs)
    return h

@borrows
fn DistributedBuildKvResidencyServiceApplyReceipt(update: DistributedKvResidencyStoreUpdate,
                                                  appendReceipt: DistributedKvResidencyWalAppendReceipt,
                                                  serviceCommit: DistributedKvResidencyServiceCommitResult): Result[DistributedKvResidencyServiceApplyReceipt] =
    if update.schema != DistributedKvResidencyStoreUpdateSchema ||
       appendReceipt.schema != DistributedKvResidencyWalAppendReceiptSchema ||
       serviceCommit.receipt.schema != DistributedKvResidencyServiceCommitReceiptSchema:
        return Err[DistributedKvResidencyServiceApplyReceipt]("distributed kv residency service apply receipt: schema")
    if DistributedKvResidencyStoreUpdateHash(update) != update.updateHash ||
       DistributedKvResidencyWalAppendReceiptHash(appendReceipt) != appendReceipt.appendHash ||
       DistributedKvResidencyServiceCommitReceiptHash(serviceCommit.receipt) != serviceCommit.receipt.serviceCommitHash:
        return Err[DistributedKvResidencyServiceApplyReceipt]("distributed kv residency service apply receipt: hash")
    if appendReceipt.update.updateHash != update.updateHash ||
       appendReceipt.record.operationHash != update.operation.operationHash ||
       appendReceipt.record.updateHash != update.updateHash ||
       appendReceipt.record.newStoreHash != update.store.storeHash ||
       appendReceipt.log.finalStoreHash != update.store.storeHash ||
       serviceCommit.commit.finalStoreHash != update.store.storeHash ||
       serviceCommit.commit.walLogHash != appendReceipt.log.logHash ||
       serviceCommit.commit.commitHash != serviceCommit.receipt.durableCommitHash ||
       serviceCommit.head.headHash != serviceCommit.receipt.headHash ||
       serviceCommit.head.commitHash != serviceCommit.commit.commitHash ||
       serviceCommit.receipt.finalStoreHash != update.store.storeHash ||
       serviceCommit.receipt.walLogHash != appendReceipt.log.logHash ||
       serviceCommit.receipt.targetPeerId != update.store.targetPeerId ||
       serviceCommit.receipt.targetPeerId != appendReceipt.log.targetPeerId:
        return Err[DistributedKvResidencyServiceApplyReceipt]("distributed kv residency service apply receipt: binding")
    var receipt = DistributedKvResidencyServiceApplyReceipt(
        schema: DistributedKvResidencyServiceApplyReceiptSchema,
        enginePlanHash: serviceCommit.receipt.enginePlanHash,
        targetPeerId: serviceCommit.receipt.targetPeerId,
        ownerId: serviceCommit.receipt.ownerId,
        baseStoreHash: serviceCommit.receipt.baseStoreHash,
        previousStoreHash: update.operation.previousStoreHash,
        finalStoreHash: update.store.storeHash,
        scheduleHash: update.operation.scheduleHash,
        operationHash: update.operation.operationHash,
        updateHash: update.updateHash,
        walRecordHash: appendReceipt.record.recordHash,
        walAppendHash: appendReceipt.appendHash,
        walLogHash: appendReceipt.log.logHash,
        serviceCommitHash: serviceCommit.receipt.serviceCommitHash,
        durableCommitHash: serviceCommit.commit.commitHash,
        headHash: serviceCommit.head.headHash,
        previousCommitHash: serviceCommit.receipt.previousCommitHash,
        previousCommitSeq: serviceCommit.receipt.previousCommitSeq,
        commitSeq: serviceCommit.receipt.commitSeq,
        appliedAtNs: update.operation.appliedAtNs,
        appendedAtNs: appendReceipt.record.appendedAtNs,
        committedAtNs: serviceCommit.receipt.committedAtNs,
        updatedAtNs: serviceCommit.receipt.updatedAtNs,
        applyHash: int64(0)
    )
    receipt.applyHash = DistributedKvResidencyServiceApplyReceiptHash(receipt)
    return Ok[DistributedKvResidencyServiceApplyReceipt](receipt)

@borrows
fn DistributedValidateKvResidencyServiceApplyReceipt(plan: DistributedInferencePlan,
                                                     peers: DistributedInferencePeer[],
                                                     baseStore: DistributedKvResidencyStore,
                                                     previousStore: DistributedKvResidencyStore,
                                                     previousLog: DistributedKvResidencyWalLog,
                                                     update: DistributedKvResidencyStoreUpdate,
                                                     appendReceipt: DistributedKvResidencyWalAppendReceipt,
                                                     serviceCommit: DistributedKvResidencyServiceCommitResult,
                                                     receipt: DistributedKvResidencyServiceApplyReceipt): Result[bool] =
    if receipt.schema != DistributedKvResidencyServiceApplyReceiptSchema ||
       receipt.enginePlanHash != plan.engineHash ||
       receipt.targetPeerId != baseStore.targetPeerId ||
       receipt.ownerId == "" ||
       receipt.baseStoreHash != baseStore.storeHash ||
       receipt.previousStoreHash != previousStore.storeHash ||
       receipt.finalStoreHash <= int64(0) ||
       receipt.scheduleHash <= int64(0) ||
       receipt.operationHash <= int64(0) ||
       receipt.updateHash <= int64(0) ||
       receipt.walRecordHash <= int64(0) ||
       receipt.walAppendHash <= int64(0) ||
       receipt.walLogHash <= int64(0) ||
       receipt.serviceCommitHash <= int64(0) ||
       receipt.durableCommitHash <= int64(0) ||
       receipt.headHash <= int64(0) ||
       receipt.previousCommitHash < int64(0) ||
       receipt.previousCommitSeq < -1 ||
       receipt.commitSeq != receipt.previousCommitSeq + 1 ||
       receipt.appliedAtNs <= int64(0) ||
       receipt.appendedAtNs <= int64(0) ||
       receipt.committedAtNs <= int64(0) ||
       receipt.updatedAtNs <= int64(0):
        return Err[bool]("distributed kv residency service apply receipt: schema")
    if DistributedKvResidencyServiceApplyReceiptHash(receipt) != receipt.applyHash:
        return Err[bool]("distributed kv residency service apply receipt: hash")
    let updateOk = DistributedValidateKvResidencyStoreUpdate(plan, peers, update)
    if IsErr(updateOk):
        return Err[bool](Error(updateOk))
    let appendOk = DistributedValidateKvResidencyWalAppendReceipt(plan, peers, previousLog, previousStore, appendReceipt)
    if IsErr(appendOk):
        return Err[bool](Error(appendOk))
    let commitOk = DistributedValidateKvResidencyServiceCommitReceipt(plan, peers, baseStore, serviceCommit.receipt)
    if IsErr(commitOk):
        return Err[bool](Error(commitOk))
    let rebuilt = DistributedBuildKvResidencyServiceApplyReceipt(update, appendReceipt, serviceCommit)
    if IsErr(rebuilt):
        return Err[bool](Error(rebuilt))
    let expected = Value(rebuilt)
    if expected.enginePlanHash != receipt.enginePlanHash ||
       expected.targetPeerId != receipt.targetPeerId ||
       expected.ownerId != receipt.ownerId ||
       expected.baseStoreHash != receipt.baseStoreHash ||
       expected.previousStoreHash != receipt.previousStoreHash ||
       expected.finalStoreHash != receipt.finalStoreHash ||
       expected.scheduleHash != receipt.scheduleHash ||
       expected.operationHash != receipt.operationHash ||
       expected.updateHash != receipt.updateHash ||
       expected.walRecordHash != receipt.walRecordHash ||
       expected.walAppendHash != receipt.walAppendHash ||
       expected.walLogHash != receipt.walLogHash ||
       expected.serviceCommitHash != receipt.serviceCommitHash ||
       expected.durableCommitHash != receipt.durableCommitHash ||
       expected.headHash != receipt.headHash ||
       expected.previousCommitHash != receipt.previousCommitHash ||
       expected.previousCommitSeq != receipt.previousCommitSeq ||
       expected.commitSeq != receipt.commitSeq ||
       expected.applyHash != receipt.applyHash:
        return Err[bool]("distributed kv residency service apply receipt: mismatch")
    return Ok[bool](true)

@borrows
fn DistributedApplyKvResidencyScheduleService(plan: DistributedInferencePlan,
                                              peers: DistributedInferencePeer[],
                                              kvCache: paged_kv_cache.PagedKVCache,
                                              kvSeq: paged_kv_cache.PagedKVSequence,
                                              transferEvidence: DistributedKvPageTransferEvidence,
                                              transferResidencyReceipt: DistributedKvPageResidencyReceipt,
                                              baseStore: DistributedKvResidencyStore,
                                              schedule: DistributedKvResidencySchedule,
                                              storeFilePath: str,
                                              walFilePath: str,
                                              headPath: str,
                                              tempHeadPath: str,
                                              lockDirPath: str,
                                              ownerId: str,
                                              recoveredAtNs: int64,
                                              acquiredAtNs: int64,
                                              leaseUntilNs: int64,
                                              appendedAtNs: int64,
                                              committedAtNs: int64,
                                              updatedAtNs: int64): Result[DistributedKvResidencyServiceApplyResult] =
    if storeFilePath == "" ||
       walFilePath == "" ||
       headPath == "" ||
       tempHeadPath == "" ||
       lockDirPath == "" ||
       ownerId == "" ||
       storeFilePath == walFilePath ||
       headPath == tempHeadPath ||
       recoveredAtNs <= int64(0) ||
       appendedAtNs <= int64(0) ||
       committedAtNs <= int64(0) ||
       updatedAtNs <= int64(0):
        return Err[DistributedKvResidencyServiceApplyResult]("distributed kv residency service apply: args")
    let baseOk = DistributedValidateKvResidencyStore(plan, peers, baseStore)
    if IsErr(baseOk):
        return Err[DistributedKvResidencyServiceApplyResult](Error(baseOk))
    if os.FileExists(storeFilePath) || os.FileExists(walFilePath):
        return Err[DistributedKvResidencyServiceApplyResult]("distributed kv residency service apply: immutable output exists")
    var previousStore = baseStore
    var previousLog: DistributedKvResidencyWalLog
    var expectedPreviousCommitHash: int64
    var expectedPreviousCommitSeq: int32 = -1
    if os.FileExists(headPath):
        let headRead = DistributedReadKvResidencyHeadFile(plan, peers, headPath)
        if IsErr(headRead):
            return Err[DistributedKvResidencyServiceApplyResult](Error(headRead))
        let head = Value(headRead).receipt
        let headOk = DistributedValidateKvResidencyHeadFileReceipt(plan, peers, baseStore, head)
        if IsErr(headOk):
            return Err[DistributedKvResidencyServiceApplyResult](Error(headOk))
        if head.storeFilePath == storeFilePath || head.walFilePath == walFilePath:
            return Err[DistributedKvResidencyServiceApplyResult]("distributed kv residency service apply: current output path")
        let recover = DistributedRecoverKvResidencyStoreFromHeadFile(plan, peers, baseStore, headPath, recoveredAtNs)
        if IsErr(recover):
            return Err[DistributedKvResidencyServiceApplyResult](Error(recover))
        previousStore = Value(recover).store
        previousLog = Value(recover).log
        expectedPreviousCommitHash = head.commitHash
        expectedPreviousCommitSeq = head.commitSeq
    else:
        let emptyLog = DistributedBuildEmptyKvResidencyWalLog(plan, peers, baseStore)
        if IsErr(emptyLog):
            return Err[DistributedKvResidencyServiceApplyResult](Error(emptyLog))
        previousLog = Value(emptyLog)
        expectedPreviousCommitHash = int64(0)
        expectedPreviousCommitSeq = -1
    let updateRes = DistributedApplyKvResidencyScheduleToStore(
        plan,
        peers,
        kvCache,
        kvSeq,
        transferEvidence,
        transferResidencyReceipt,
        previousStore,
        schedule
    )
    if IsErr(updateRes):
        return Err[DistributedKvResidencyServiceApplyResult](Error(updateRes))
    let update = Value(updateRes)
    let appendRes = DistributedAppendKvResidencyWal(
        plan,
        peers,
        previousLog,
        previousStore,
        update,
        appendedAtNs
    )
    if IsErr(appendRes):
        return Err[DistributedKvResidencyServiceApplyResult](Error(appendRes))
    let appendReceipt = Value(appendRes)
    let commitRes = DistributedCommitKvResidencyStoreService(
        plan,
        peers,
        baseStore,
        update.store,
        appendReceipt.log,
        storeFilePath,
        walFilePath,
        headPath,
        tempHeadPath,
        lockDirPath,
        ownerId,
        expectedPreviousCommitHash,
        expectedPreviousCommitSeq,
        acquiredAtNs,
        leaseUntilNs,
        committedAtNs,
        updatedAtNs
    )
    if IsErr(commitRes):
        return Err[DistributedKvResidencyServiceApplyResult](Error(commitRes))
    let serviceCommit = Value(commitRes)
    let receiptRes = DistributedBuildKvResidencyServiceApplyReceipt(update, appendReceipt, serviceCommit)
    if IsErr(receiptRes):
        return Err[DistributedKvResidencyServiceApplyResult](Error(receiptRes))
    let receipt = Value(receiptRes)
    let receiptOk = DistributedValidateKvResidencyServiceApplyReceipt(
        plan,
        peers,
        baseStore,
        previousStore,
        previousLog,
        update,
        appendReceipt,
        serviceCommit,
        receipt
    )
    if IsErr(receiptOk):
        return Err[DistributedKvResidencyServiceApplyResult](Error(receiptOk))
    let out = DistributedKvResidencyServiceApplyResult(
        update: update,
        append: appendReceipt,
        serviceCommit: serviceCommit,
        receipt: receipt
    )
    return Ok[DistributedKvResidencyServiceApplyResult](out)

@borrows
fn DistributedSpecDecodePlanHash(plan: DistributedSpecDecodePlan): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, plan.schema)
    h = DistributedHashTextWith(h, plan.algorithm)
    h = DistributedHashStep(h, int64(plan.draftWindow))
    h = DistributedHashStep(h, int64(plan.draftTokenCount))
    h = DistributedHashStep(h, int64(plan.mtpLayerCount))
    return h

fn DistributedBuildSpecDecodePlan(algorithm: str,
                                  draftWindow: int32,
                                  draftTokenCount: int32,
                                  mtpLayerCount: int32): Result[DistributedSpecDecodePlan] =
    if algorithm != DistributedSpecDecodeAlgorithmNone &&
       algorithm != DistributedSpecDecodeAlgorithmMtp &&
       algorithm != DistributedSpecDecodeAlgorithmEagleMtp:
        return Err[DistributedSpecDecodePlan]("distributed spec decode: algorithm")
    if algorithm == DistributedSpecDecodeAlgorithmNone:
        if draftWindow != 0 || draftTokenCount != 0 || mtpLayerCount != 0:
            return Err[DistributedSpecDecodePlan]("distributed spec decode: disabled fields")
    else:
        if draftWindow <= 0 || draftTokenCount <= 0 || mtpLayerCount <= 0:
            return Err[DistributedSpecDecodePlan]("distributed spec decode: enabled fields")
        if draftTokenCount > draftWindow:
            return Err[DistributedSpecDecodePlan]("distributed spec decode: draft/window")
    let canonicalPlanHash = DistributedSpecDecodePlanHash(DistributedSpecDecodePlan(
        schema: DistributedSpecDecodePlanSchema,
        algorithm: share(algorithm),
        draftWindow: draftWindow,
        draftTokenCount: draftTokenCount,
        mtpLayerCount: mtpLayerCount,
        planHash: int64(0)
    ))
    if canonicalPlanHash <= int64(0):
        return Err[DistributedSpecDecodePlan]("distributed spec decode: hash")
    return Ok[DistributedSpecDecodePlan](DistributedSpecDecodePlan(
        schema: DistributedSpecDecodePlanSchema,
        algorithm: algorithm,
        draftWindow: draftWindow,
        draftTokenCount: draftTokenCount,
        mtpLayerCount: mtpLayerCount,
        planHash: canonicalPlanHash
    ))

fn DistributedBuildDisabledSpecDecodePlan(): DistributedSpecDecodePlan =
    let plan = DistributedBuildSpecDecodePlan(DistributedSpecDecodeAlgorithmNone, 0, 0, 0)
    return Value(plan)

@borrows
fn DistributedValidateSpecDecodePlan(plan: DistributedSpecDecodePlan): Result[bool] =
    if plan.schema != DistributedSpecDecodePlanSchema:
        return Err[bool]("distributed spec decode: schema")
    let expected = DistributedBuildSpecDecodePlan(
        plan.algorithm,
        plan.draftWindow,
        plan.draftTokenCount,
        plan.mtpLayerCount
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    if Value(expected).planHash != plan.planHash:
        return Err[bool]("distributed spec decode: hash mismatch")
    return Ok[bool](true)

fn DistributedRequireOrdinaryDecodeExecution(plan: DistributedInferencePlan,
                                             stage: str): Result[bool] =
    let specOk = DistributedValidateSpecDecodePlan(plan.specDecodePlan)
    if IsErr(specOk):
        return Err[bool](Error(specOk))
    if plan.specDecodePlan.algorithm != DistributedSpecDecodeAlgorithmNone:
        return Err[bool](strutil.Join([
            "distributed spec decode: executor required for ",
            stage
        ], ""))
    return Ok[bool](true)

fn DistributedRequireSpecDecodeExecution(plan: DistributedInferencePlan,
                                         stage: str): Result[bool] =
    let specOk = DistributedValidateSpecDecodePlan(plan.specDecodePlan)
    if IsErr(specOk):
        return Err[bool](Error(specOk))
    if plan.specDecodePlan.algorithm == DistributedSpecDecodeAlgorithmNone:
        return Err[bool](strutil.Join([
            "distributed spec decode: enabled plan required for ",
            stage
        ], ""))
    return Ok[bool](true)

fn DistributedRequireArchitectureMtpSpecDecodeExecution(plan: DistributedInferencePlan,
                                                        stage: str,
                                                        expectedArchitecture: str): Result[bool] =
    let specRequired = DistributedRequireSpecDecodeExecution(plan, stage)
    if IsErr(specRequired):
        return Err[bool](Error(specRequired))
    if plan.modelGraph.architecture != expectedArchitecture:
        return Err[bool](strutil.Join([
            "distributed ",
            expectedArchitecture,
            " mtp spec decode: architecture"
        ], ""))
    if plan.specDecodePlan.algorithm != DistributedSpecDecodeAlgorithmMtp:
        return Err[bool](strutil.Join([
            "distributed ",
            expectedArchitecture,
            " mtp spec decode: algorithm"
        ], ""))
    if plan.modelGraph.mtpLayerCount != 1 ||
       plan.specDecodePlan.mtpLayerCount != plan.modelGraph.mtpLayerCount ||
       plan.specDecodePlan.draftTokenCount <= 0 ||
       plan.specDecodePlan.draftWindow < plan.specDecodePlan.draftTokenCount:
        return Err[bool](strutil.Join([
            "distributed ",
            expectedArchitecture,
            " mtp spec decode: mtp shape"
        ], ""))
    return Ok[bool](true)

fn DistributedRequireHfGlm52MtpSpecDecodeExecution(plan: DistributedInferencePlan,
                                                   stage: str): Result[bool] =
    return DistributedRequireArchitectureMtpSpecDecodeExecution(
        plan,
        stage,
        model_graph.InferenceModelArchitectureHfGlm52DsaMlaMtp
    )

@borrows
fn DistributedSpecDecodeVerifyHash(result: DistributedSpecDecodeVerifyResult): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, result.schema)
    h = DistributedHashStep(h, int64(result.acceptedDraftTokenCount))
    h = DistributedHashStep(h, int64(result.emittedTokenCount))
    h = DistributedHashStep(h, int64(result.firstRejectedIndex))
    h = DistributedHashStep(h, int64(result.correctionToken))
    h = DistributedHashStep(h, result.draftTokenHash)
    h = DistributedHashStep(h, result.verifierLogitsHash)
    h = DistributedHashStep(h, result.outputTokenHash)
    return h

@borrows
fn DistributedSpecDecodeDraftHash(result: DistributedSpecDecodeDraftResult): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, result.schema)
    h = DistributedHashStep(h, int64(result.draftTokenCount))
    h = DistributedHashStep(h, result.contextTokenHash)
    h = DistributedHashStep(h, result.draftTokenHash)
    h = DistributedHashStep(h, result.draftLogitsHash)
    h = DistributedHashStep(h, result.draftKvStateHash)
    h = DistributedHashStep(h, result.receiptHash)
    return h

@borrows
fn DistributedLogitArgmaxRow(logits: infer.TensorQ, row: int32): Result[int32] =
    let logitsOk = infer.TensorValidate(logits)
    if IsErr(logitsOk):
        return Err[int32](Error(logitsOk))
    if logits.shape.len != 2 || row < 0 || row >= logits.shape[0] || logits.shape[1] <= 0:
        return Err[int32]("distributed spec decode: logits row")
    var bestIndex: int32
    var bestValue = logits.data[infer.TensorOffset2(logits.shape, row, 0)]
    for col in 1..<logits.shape[1]:
        let value = logits.data[infer.TensorOffset2(logits.shape, row, col)]
        if value > bestValue:
            bestValue = value
            bestIndex = col
    return Ok[int32](bestIndex)

fn DistributedConcatTokenIdsFill(out: var infer.TensorQ,
                                 contextTokenIds: infer.TensorQ,
                                 draftTokenIds: infer.TensorQ): Result[bool] =
    let contextOk = infer.TensorValidate(contextTokenIds)
    if IsErr(contextOk):
        return Err[bool](Error(contextOk))
    let draftOk = infer.TensorValidate(draftTokenIds)
    if IsErr(draftOk):
        return Err[bool](Error(draftOk))
    if contextTokenIds.shape.len != 1 || draftTokenIds.shape.len != 1:
        return Err[bool]("distributed spec decode: token rank")
    if contextTokenIds.shape[0] <= 0 || draftTokenIds.shape[0] <= 0:
        return Err[bool]("distributed spec decode: token count")
    if contextTokenIds.scale != draftTokenIds.scale:
        return Err[bool]("distributed spec decode: token scale")
    var data: int32[]
    for i in 0..<contextTokenIds.data.len:
        add(data, contextTokenIds.data[i])
    for i in 0..<draftTokenIds.data.len:
        add(data, draftTokenIds.data[i])
    let fillOk = infer.TensorFromDataFill(
        out,
        [contextTokenIds.shape[0] + draftTokenIds.shape[0]],
        contextTokenIds.scale,
        data
    )
    if IsErr(fillOk):
        return Err[bool](Error(fillOk))
    return Ok[bool](true)

@borrows
fn DistributedAppendTokenIdFill(out: var infer.TensorQ,
                                tokenIds: infer.TensorQ,
                                tokenId: int32): Result[bool] =
    let tokenOk = infer.TensorValidate(tokenIds)
    if IsErr(tokenOk):
        return Err[bool](Error(tokenOk))
    if tokenIds.shape.len != 1 || tokenIds.shape[0] <= 0:
        return Err[bool]("distributed spec decode: append token rank")
    var data: int32[]
    for i in 0..<tokenIds.data.len:
        add(data, tokenIds.data[i])
    add(data, tokenId)
    let fillOk = infer.TensorFromDataFill(
        out,
        [tokenIds.shape[0] + 1],
        tokenIds.scale,
        data
    )
    if IsErr(fillOk):
        return Err[bool](Error(fillOk))
    return Ok[bool](true)

# Bare single-process greedy generate loop for the HF GLM-5.2 DSA-MLA-MTP audit
# executor. Unlike the spec-decode draft functions above this needs no
# DistributedInferencePlan/peers/activation-evidence scaffolding: it walks
# ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens directly (full audit
# recompute per step, no persisted kv cache) and stops early once eosTokenId
# is produced (eosTokenId < 0 disables the stop check). Callers must size
# expertCapacity to cover the largest token count reached during the loop
# (promptTokenIds.shape[0] + maxNewTokens - 1), matching the contract already
# used by DistributedGenerateHfGlm52DsaMlaMtpSpecDraftIterativeAudit above.
fn DistributedGenerateGreedyHfGlm52DsaMlaMtpAuditTokens(graph: model_graph.ModelGraph,
                                                        bindings: weight_binding.WeightBindingSet,
                                                        store: weight_store.WeightTensorStore,
                                                        promptTokenIds: infer.TensorQ,
                                                        maxNewTokens: int32,
                                                        expertCapacity: int32,
                                                        eosTokenId: int32): Result[infer.TensorQ] =
    if maxNewTokens < 0:
        return Err[infer.TensorQ]("distributed generate greedy: max new tokens")
    let promptOk = infer.TensorValidate(promptTokenIds)
    if IsErr(promptOk):
        return Err[infer.TensorQ](Error(promptOk))
    if promptTokenIds.shape.len != 1 || promptTokenIds.shape[0] <= 0:
        return Err[infer.TensorQ]("distributed generate greedy: prompt token shape")
    var currentTokenIds = promptTokenIds
    for step in 0..<maxNewTokens:
        let modelOutputRes = model_executor.ModelExecutorExecuteHfGlm52DsaMlaMtpAuditTokens(
            graph,
            bindings,
            store,
            currentTokenIds,
            expertCapacity
        )
        if IsErr(modelOutputRes):
            return Err[infer.TensorQ](Error(modelOutputRes))
        let modelOut = Value(modelOutputRes)
        let tokenRes = DistributedLogitArgmaxRow(modelOut.logits, currentTokenIds.shape[0] - 1)
        if IsErr(tokenRes):
            return Err[infer.TensorQ](Error(tokenRes))
        let token = Value(tokenRes)
        var nextTokenIds: infer.TensorQ
        let appendOk = DistributedAppendTokenIdFill(nextTokenIds, currentTokenIds, token)
        if IsErr(appendOk):
            return Err[infer.TensorQ](Error(appendOk))
        currentTokenIds = nextTokenIds
        if eosTokenId >= 0 && token == eosTokenId:
            break
    return Ok[infer.TensorQ](currentTokenIds)

# Bare single-process greedy generate loop for the dense-transformer executor
# (model_executor.ModelExecutorExecuteDenseTransformerTokens). Same no-kv-cache,
# full-recompute-per-step, EOS-stop-early contract as
# DistributedGenerateGreedyHfGlm52DsaMlaMtpAuditTokens above, minus the MoE
# expertCapacity parameter: dense-transformer graphs carry no router/expert ops
# (ModelExecutorValidateDenseTransformerGraph hard-rejects them), so there is no
# expert-capacity dimension to size.
@borrows
fn DistributedGenerateGreedyDenseTransformerTokens(graph: model_graph.ModelGraph,
                                                    bindings: weight_binding.WeightBindingSet,
                                                    store: weight_store.WeightTensorStore,
                                                    promptTokenIds: infer.TensorQ,
                                                    maxNewTokens: int32,
                                                    eosTokenId: int32): Result[infer.TensorQ] =
    if maxNewTokens < 0:
        return Err[infer.TensorQ]("distributed generate greedy dense: max new tokens")
    let promptOk = infer.TensorValidate(promptTokenIds)
    if IsErr(promptOk):
        return Err[infer.TensorQ](Error(promptOk))
    if promptTokenIds.shape.len != 1 || promptTokenIds.shape[0] <= 0:
        return Err[infer.TensorQ]("distributed generate greedy dense: prompt token shape")
    var currentTokenIds = promptTokenIds
    for step in 0..<maxNewTokens:
        let modelOutputRes = model_executor.ModelExecutorExecuteDenseTransformerTokens(
            graph,
            bindings,
            store,
            currentTokenIds
        )
        if IsErr(modelOutputRes):
            return Err[infer.TensorQ](Error(modelOutputRes))
        let modelOut = Value(modelOutputRes)
        let tokenRes = DistributedLogitArgmaxRow(modelOut.logits, currentTokenIds.shape[0] - 1)
        if IsErr(tokenRes):
            return Err[infer.TensorQ](Error(tokenRes))
        let token = Value(tokenRes)
        var nextTokenIds: infer.TensorQ
        let appendOk = DistributedAppendTokenIdFill(nextTokenIds, currentTokenIds, token)
        if IsErr(appendOk):
            return Err[infer.TensorQ](Error(appendOk))
        currentTokenIds = nextTokenIds
        if eosTokenId >= 0 && token == eosTokenId:
            break
    return Ok[infer.TensorQ](currentTokenIds)

# #141: budget/timeout/cancellation for the KV-cache generation loop below.
# deadlineMs<=0 means unbounded (no wall-clock check); cancelPoll is called
# once per checkpoint and a true return means "stop cooperatively now" --
# neither condition is an error, both are normal early-exit signals reported
# via DistributedGenerateWithKvOutcome's budgetExceeded/cancelled fields.
type
    DistributedGenerationBudget =
        deadlineMs: int64
        cancelPoll: fn(): bool

    DistributedGenerateWithKvOutcome =
        tokenIds: infer.TensorQ
        stepsRun: int32
        budgetExceeded: bool
        cancelled: bool

fn distributedGenerationNeverCancel(): bool =
    return false

fn DistributedGenerationBudgetUnbounded(): DistributedGenerationBudget =
    return DistributedGenerationBudget(
        deadlineMs: int64(0),
        cancelPoll: distributedGenerationNeverCancel
    )

fn DistributedGenerationBudgetDeadlinePassed(budget: DistributedGenerationBudget): bool =
    return budget.deadlineMs > int64(0) && times.MonotimeMs() > budget.deadlineMs

# KV-cache-aware greedy generate loop for the dense-transformer executor:
# prefill the whole prompt once (ModelExecutorExecuteDenseTransformerPrefillWithKvState),
# then decode one new token at a time by forwarding only the previous step's
# single new token through the carried kv state
# (ModelExecutorExecuteDenseTransformerDecodeWithKvState) -- unlike
# DistributedGenerateGreedyDenseTransformerTokens above (kept frozen as the
# permanent full-recompute reference implementation), each decode step here
# is a single-token forward instead of a full recompute of the growing
# sequence. Produces the same token sequence as the frozen loop for the same
# prompt/maxNewTokens/eosTokenId (see
# model_executor_dense_kv_state_equivalence_smoke.cheng) because greedy
# argmax is a deterministic function of logits, and the numeric equivalence
# conditions (RmsNorm per-row independence, RoPE basePosition, append-then-
# attend causal ordering, GQA head mapping) hold unconditionally -- see the
# doc comment on ModelExecutorExecuteDenseTransformerTokensWithKvState.
#
# Budget/cancellation checkpoints (three tiers, matching what this execution
# model can actually preempt -- see DistributedGenerationBudget's doc
# comment): (1) before the prefill call -- the whole-prompt forward is a
# single atomic call this loop cannot interrupt mid-flight, so an
# already-expired/cancelled budget skips it entirely and returns the prompt
# unchanged with stepsRun=0; (2) at each decode step's boundary -- unlike the
# frozen full-recompute loop (where every step costs a full forward and a
# per-step check would be moot), each decode step here is a single-token
# forward, so a checkpoint here is the first place in this codebase where
# mid-generation budget enforcement is actually meaningful; (3) hitting
# either condition returns Ok with the tokens produced so far, never Err --
# running out of budget is not a failure.
fn DistributedGenerateGreedyDenseTransformerTokensWithKvState(graph: model_graph.ModelGraph,
                                                               bindings: weight_binding.WeightBindingSet,
                                                               store: weight_store.WeightTensorStore,
                                                               promptTokenIds: infer.TensorQ,
                                                               maxNewTokens: int32,
                                                               eosTokenId: int32,
                                                               budget: DistributedGenerationBudget): Result[DistributedGenerateWithKvOutcome] =
    if maxNewTokens < 0:
        return Err[DistributedGenerateWithKvOutcome]("distributed generate greedy dense kv: max new tokens")
    let promptOk = infer.TensorValidate(promptTokenIds)
    if IsErr(promptOk):
        return Err[DistributedGenerateWithKvOutcome](Error(promptOk))
    if promptTokenIds.shape.len != 1 || promptTokenIds.shape[0] <= 0:
        return Err[DistributedGenerateWithKvOutcome]("distributed generate greedy dense kv: prompt token shape")
    if maxNewTokens == 0:
        return Ok[DistributedGenerateWithKvOutcome](DistributedGenerateWithKvOutcome(
            tokenIds: promptTokenIds, stepsRun: 0, budgetExceeded: false, cancelled: false))
    if DistributedGenerationBudgetDeadlinePassed(budget):
        return Ok[DistributedGenerateWithKvOutcome](DistributedGenerateWithKvOutcome(
            tokenIds: promptTokenIds, stepsRun: 0, budgetExceeded: true, cancelled: false))
    if budget.cancelPoll():
        return Ok[DistributedGenerateWithKvOutcome](DistributedGenerateWithKvOutcome(
            tokenIds: promptTokenIds, stepsRun: 0, budgetExceeded: false, cancelled: true))

    let prefillRes = model_executor.ModelExecutorExecuteDenseTransformerPrefillWithKvState(
        graph, bindings, store, promptTokenIds)
    if IsErr(prefillRes):
        return Err[DistributedGenerateWithKvOutcome](Error(prefillRes))
    let prefillOut = Value(prefillRes)
    let firstTokenRes = DistributedLogitArgmaxRow(prefillOut.output.logits, promptTokenIds.shape[0] - 1)
    if IsErr(firstTokenRes):
        return Err[DistributedGenerateWithKvOutcome](Error(firstTokenRes))
    let firstToken = Value(firstTokenRes)
    var currentTokenIds: infer.TensorQ
    let firstAppendOk = DistributedAppendTokenIdFill(currentTokenIds, promptTokenIds, firstToken)
    if IsErr(firstAppendOk):
        return Err[DistributedGenerateWithKvOutcome](Error(firstAppendOk))
    var stepsRun: int32 = 1
    if eosTokenId >= 0 && firstToken == eosTokenId:
        return Ok[DistributedGenerateWithKvOutcome](DistributedGenerateWithKvOutcome(
            tokenIds: currentTokenIds, stepsRun: stepsRun, budgetExceeded: false, cancelled: false))
    var kvState = prefillOut.kvStateSet
    for step in 1..<maxNewTokens:
        if DistributedGenerationBudgetDeadlinePassed(budget):
            return Ok[DistributedGenerateWithKvOutcome](DistributedGenerateWithKvOutcome(
                tokenIds: currentTokenIds, stepsRun: stepsRun, budgetExceeded: true, cancelled: false))
        if budget.cancelPoll():
            return Ok[DistributedGenerateWithKvOutcome](DistributedGenerateWithKvOutcome(
                tokenIds: currentTokenIds, stepsRun: stepsRun, budgetExceeded: false, cancelled: true))
        var lastTokenData: int32[]
        add(lastTokenData, currentTokenIds.data[currentTokenIds.data.len - 1])
        var lastTokenTensor: infer.TensorQ
        let lastFillOk = infer.TensorFromDataFill(lastTokenTensor, [1], currentTokenIds.scale, lastTokenData)
        if IsErr(lastFillOk):
            return Err[DistributedGenerateWithKvOutcome](Error(lastFillOk))
        let decodeRes = model_executor.ModelExecutorExecuteDenseTransformerDecodeWithKvState(
            graph, bindings, store, lastTokenTensor, kvState)
        if IsErr(decodeRes):
            return Err[DistributedGenerateWithKvOutcome](Error(decodeRes))
        let decodeOut = Value(decodeRes)
        let tokenRes = DistributedLogitArgmaxRow(decodeOut.output.logits, 0)
        if IsErr(tokenRes):
            return Err[DistributedGenerateWithKvOutcome](Error(tokenRes))
        let token = Value(tokenRes)
        var nextTokenIds: infer.TensorQ
        let appendOk = DistributedAppendTokenIdFill(nextTokenIds, currentTokenIds, token)
        if IsErr(appendOk):
            return Err[DistributedGenerateWithKvOutcome](Error(appendOk))
        currentTokenIds = nextTokenIds
        kvState = decodeOut.kvStateSet
        stepsRun = stepsRun + 1
        if eosTokenId >= 0 && token == eosTokenId:
            break
    return Ok[DistributedGenerateWithKvOutcome](DistributedGenerateWithKvOutcome(
        tokenIds: currentTokenIds, stepsRun: stepsRun, budgetExceeded: false, cancelled: false))

@borrows
fn DistributedVerifyDraftTokensFromLogits(logits: infer.TensorQ,
                                          contextTokenCount: int32,
                                          draftTokenIds: infer.TensorQ): Result[DistributedSpecDecodeVerifyResult] =
    let draftOk = infer.TensorValidate(draftTokenIds)
    if IsErr(draftOk):
        return Err[DistributedSpecDecodeVerifyResult](Error(draftOk))
    let logitsOk = infer.TensorValidate(logits)
    if IsErr(logitsOk):
        return Err[DistributedSpecDecodeVerifyResult](Error(logitsOk))
    if draftTokenIds.shape.len != 1 || draftTokenIds.shape[0] <= 0:
        return Err[DistributedSpecDecodeVerifyResult]("distributed spec decode: draft tokens")
    if logits.shape.len != 2 || contextTokenCount <= 0 ||
       logits.shape[0] < contextTokenCount + draftTokenIds.shape[0]:
        return Err[DistributedSpecDecodeVerifyResult]("distributed spec decode: verifier logits")
    var emitted: int32[]
    var acceptedCount: int32
    var firstRejected: int32 = -1
    var correctionToken: int32 = -1
    for draftIndex in 0..<draftTokenIds.shape[0]:
        let predicted = DistributedLogitArgmaxRow(logits, contextTokenCount - 1 + draftIndex)
        if IsErr(predicted):
            return Err[DistributedSpecDecodeVerifyResult](Error(predicted))
        if Value(predicted) == draftTokenIds.data[draftIndex]:
            add(emitted, draftTokenIds.data[draftIndex])
            acceptedCount = acceptedCount + 1
        else:
            firstRejected = draftIndex
            correctionToken = Value(predicted)
            add(emitted, correctionToken)
            break
    if emitted.len <= 0:
        return Err[DistributedSpecDecodeVerifyResult]("distributed spec decode: empty emitted tokens")
    var outputTokens: infer.TensorQ
    var outputShape: int32[]
    add(outputShape, emitted.len)
    outputTokens.shape = outputShape
    outputTokens.scale = draftTokenIds.scale
    outputTokens.data = emitted
    let outputOk = infer.TensorValidate(outputTokens)
    if IsErr(outputOk):
        return Err[DistributedSpecDecodeVerifyResult](Error(outputOk))
    let draftHash = DistributedTensorOutputHash(draftTokenIds)
    if IsErr(draftHash):
        return Err[DistributedSpecDecodeVerifyResult](Error(draftHash))
    let logitsHash = DistributedTensorOutputHash(logits)
    if IsErr(logitsHash):
        return Err[DistributedSpecDecodeVerifyResult](Error(logitsHash))
    let outputHash = DistributedTensorOutputHash(outputTokens)
    if IsErr(outputHash):
        return Err[DistributedSpecDecodeVerifyResult](Error(outputHash))
    var result = DistributedSpecDecodeVerifyResult(
        schema: DistributedSpecDecodeVerifySchema,
        acceptedDraftTokenCount: acceptedCount,
        emittedTokenCount: outputTokens.shape[0],
        firstRejectedIndex: firstRejected,
        correctionToken: correctionToken,
        draftTokenHash: Value(draftHash),
        verifierLogitsHash: Value(logitsHash),
        outputTokenHash: Value(outputHash),
        verifyHash: int64(0),
        outputTokens: outputTokens
    )
    result.verifyHash = DistributedSpecDecodeVerifyHash(result)
    if result.verifyHash <= int64(0):
        return Err[DistributedSpecDecodeVerifyResult]("distributed spec decode: verify hash")
    return Ok[DistributedSpecDecodeVerifyResult](result)

@borrows
fn DistributedPlanHash(plan: DistributedInferencePlan): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, plan.schema)
    h = DistributedHashTextWith(h, plan.engineCid)
    h = DistributedHashStep(h, plan.modelGraph.graphHash)
    h = DistributedHashStep(h, plan.weightBindings.bindingHash)
    h = DistributedHashStep(h, plan.deviceWeightBindingHash)
    h = DistributedHashStep(h, plan.partitionPlan.planHash)
    h = DistributedHashStep(h, DistributedKernelSetHash(plan.kernelPrograms))
    h = DistributedHashStep(h, plan.kvReceipt.pageTableHash)
    h = DistributedHashStep(h, plan.kvStateHash)
    h = DistributedHashStep(h, plan.kvShardReceipts.receiptSetHash)
    h = DistributedHashStep(h, plan.specDecodePlan.planHash)
    h = DistributedHashStep(h, plan.routePlan.routeHash)
    h = DistributedHashStep(h, plan.routePlanSet.routeSetHash)
    for i in 0..<plan.activationShards.len:
        h = DistributedHashTextWith(h, plan.activationShards[i].shardName)
        h = DistributedHashTextWith(h, plan.activationShards[i].peerId)
        h = DistributedHashTextWith(h, plan.activationShards[i].schema)
        h = DistributedHashStep(h, int64(plan.activationShards[i].tokenStart))
        h = DistributedHashStep(h, int64(plan.activationShards[i].tokenCount))
        h = DistributedHashStep(h, int64(plan.activationShards[i].featureStart))
        h = DistributedHashStep(h, int64(plan.activationShards[i].featureCount))
        h = DistributedHashStep(h, plan.activationShards[i].shardHash)
    return h

@borrows
fn DistributedFindPeer(peers: DistributedInferencePeer[], peerId: str): int32 =
    for i in 0..<peers.len:
        if peers[i].peerId == peerId:
            return i
    return -1

@borrows
fn DistributedPeerReady(peers: DistributedInferencePeer[], peerId: str): bool =
    let idx = DistributedFindPeer(peers, peerId)
    if idx < 0:
        return false
    if !peers[idx].online:
        return false
    if peers[idx].deviceCapabilityHash == "":
        return false
    return true

@borrows
fn DistributedValidatePeers(peers: DistributedInferencePeer[]): Result[bool] =
    if peers.len <= 0:
        return Err[bool]("distributed inference: empty peer set")
    for i in 0..<peers.len:
        if peers[i].peerId == "" || peers[i].deviceCapabilityHash == "":
            return Err[bool]("distributed inference: peer identity")
        if !peers[i].online:
            return Err[bool]("distributed inference: peer offline")
        if peers[i].tensorShardBudget < 0 || peers[i].expertShardBudget < 0:
            return Err[bool]("distributed inference: peer budget")
        for j in i + 1..<peers.len:
            if peers[i].peerId == peers[j].peerId:
                return Err[bool]("distributed inference: duplicate peer")
    return Ok[bool](true)

@borrows
fn DistributedValidatePartitionPeers(plan: parallel_plan.InferencePartitionPlan,
                                     peers: DistributedInferencePeer[]): Result[bool] =
    for i in 0..<plan.tensorShards.len:
        if !DistributedPeerReady(peers, plan.tensorShards[i].peerId):
            return Err[bool]("distributed inference: tensor peer missing")
    for i in 0..<plan.expertShards.len:
        if !DistributedPeerReady(peers, plan.expertShards[i].peerId):
            return Err[bool]("distributed inference: expert peer missing")
    for i in 0..<peers.len:
        var tensorLoad: int32
        var expertLoad: int32
        for j in 0..<plan.tensorShards.len:
            if plan.tensorShards[j].peerId == peers[i].peerId:
                tensorLoad = tensorLoad + 1
        for j in 0..<plan.expertShards.len:
            if plan.expertShards[j].peerId == peers[i].peerId:
                expertLoad = expertLoad + 1
        if tensorLoad > peers[i].tensorShardBudget:
            return Err[bool]("distributed inference: tensor budget overflow")
        if expertLoad > peers[i].expertShardBudget:
            return Err[bool]("distributed inference: expert budget overflow")
    return Ok[bool](true)

@borrows
fn DistributedValidateWeightBindingPeers(bindings: weight_binding.WeightBindingSet,
                                         peers: DistributedInferencePeer[]): Result[bool] =
    for i in 0..<bindings.bindings.len:
        if !DistributedPeerReady(peers, bindings.bindings[i].peerId):
            return Err[bool]("distributed inference: weight peer missing")
    return Ok[bool](true)

@borrows
fn DistributedValidateActivationShard(shard: DistributedActivationShard,
                                      peers: DistributedInferencePeer[],
                                      tokenLimit: int32,
                                      hiddenSize: int32): Result[bool] =
    if shard.shardName == "" || shard.schema != DistributedInferenceActivationSchema:
        return Err[bool]("distributed inference: activation shard identity")
    if !DistributedPeerReady(peers, shard.peerId):
        return Err[bool]("distributed inference: activation peer missing")
    if shard.tokenStart < 0 || shard.tokenCount <= 0 || shard.featureStart < 0 || shard.featureCount <= 0:
        return Err[bool]("distributed inference: activation span")
    if shard.tokenStart + shard.tokenCount > tokenLimit:
        return Err[bool]("distributed inference: activation token bounds")
    if shard.featureStart + shard.featureCount > hiddenSize:
        return Err[bool]("distributed inference: activation feature bounds")
    if shard.shardHash <= int64(0):
        return Err[bool]("distributed inference: activation hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateActivationCoverage(shards: DistributedActivationShard[],
                                         tokenLimit: int32,
                                         hiddenSize: int32): Result[bool] =
    if tokenLimit <= 0 || hiddenSize <= 0:
        return Err[bool]("distributed inference: activation coverage shape")
    if tokenLimit > 2147483647 / hiddenSize:
        return Err[bool]("distributed inference: activation coverage overflow")
    let total = tokenLimit * hiddenSize
    var coverage: int32[]
    for _ in 0..<total:
        add(coverage, 0)
    for i in 0..<shards.len:
        for row in 0..<shards[i].tokenCount:
            for col in 0..<shards[i].featureCount:
                let idx = (shards[i].tokenStart + row) * hiddenSize + shards[i].featureStart + col
                if idx < 0 || idx >= total:
                    return Err[bool]("distributed inference: activation coverage bounds")
                if coverage[idx] != 0:
                    return Err[bool]("distributed inference: activation coverage overlap")
                coverage[idx] = 1
    for i in 0..<coverage.len:
        if coverage[i] != 1:
            return Err[bool]("distributed inference: activation coverage gap")
    return Ok[bool](true)

@borrows
fn DistributedFindActivationShard(plan: DistributedInferencePlan, shardName: str): int32 =
    for i in 0..<plan.activationShards.len:
        if plan.activationShards[i].shardName == shardName:
            return i
    return -1

fn DistributedFindExpertShard(plan: DistributedInferencePlan, expertId: int32): int32 =
    for i in 0..<plan.partitionPlan.expertShards.len:
        if plan.partitionPlan.expertShards[i].expertId == expertId:
            return i
    return -1

fn DistributedFindWeightBindingByTensor(plan: DistributedInferencePlan, tensorName: str): int32 =
    var found: int32 = -1
    for i in 0..<plan.weightBindings.bindings.len:
        if plan.weightBindings.bindings[i].tensorName == tensorName:
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn DistributedValidateExpertWeightBindings(plan: DistributedInferencePlan): Result[bool] =
    for i in 0..<plan.modelGraph.ops.len:
        let op = plan.modelGraph.ops[i]
        if op.opKind == model_graph.InferenceModelOpExpert:
            if op.expertId < 0 || op.expertId >= plan.modelGraph.expertCount:
                return Err[bool]("distributed inference: expert op id")
            let shardIndex = DistributedFindExpertShard(plan, op.expertId)
            if shardIndex < 0:
                return Err[bool]("distributed inference: expert op shard")
            let ownerPeer = plan.partitionPlan.expertShards[shardIndex].peerId
            for weightIndex in 0..<op.weightNames.len:
                let bindingIndex = DistributedFindWeightBindingByTensor(plan, op.weightNames[weightIndex])
                if bindingIndex < 0:
                    return Err[bool]("distributed inference: expert weight binding missing")
                if plan.weightBindings.bindings[bindingIndex].peerId != ownerPeer:
                    return Err[bool]("distributed inference: expert weight peer mismatch")
    return Ok[bool](true)

@borrows
fn DistributedValidateTensorParallelPlan(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[]): Result[bool] =
    if int64(plan.modelGraph.attentionHeads) * int64(plan.modelGraph.headDim) != int64(plan.modelGraph.hiddenSize):
        return Err[bool]("distributed inference: tensor head dimensions")
    let coverageOk = parallel_plan.ParallelValidateTensorHeadCoverage(
        plan.partitionPlan,
        plan.modelGraph.attentionHeads
    )
    if IsErr(coverageOk):
        return Err[bool](Error(coverageOk))
    for headIndex in 0..<plan.modelGraph.attentionHeads:
        let owner = parallel_plan.ParallelFindTensorHeadOwner(plan.partitionPlan, headIndex)
        if IsErr(owner):
            return Err[bool](Error(owner))
        if !DistributedPeerReady(peers, Value(owner)):
            return Err[bool]("distributed inference: tensor head peer missing")
    return Ok[bool](true)

@borrows
fn DistributedValidateActivationHeadAlignment(plan: DistributedInferencePlan,
                                              peers: DistributedInferencePeer[]): Result[bool] =
    if plan.modelGraph.headDim <= 0 || plan.modelGraph.attentionHeads <= 0:
        return Err[bool]("distributed inference: activation head dimensions")
    for i in 0..<plan.activationShards.len:
        let shard = plan.activationShards[i]
        if shard.featureStart % plan.modelGraph.headDim != 0 ||
           shard.featureCount % plan.modelGraph.headDim != 0:
            return Err[bool]("distributed inference: activation head alignment")
        let headStart = shard.featureStart / plan.modelGraph.headDim
        let headCount = shard.featureCount / plan.modelGraph.headDim
        if headCount <= 0 || headStart < 0 || headStart + headCount > plan.modelGraph.attentionHeads:
            return Err[bool]("distributed inference: activation head span")
        for headIndex in headStart..<headStart + headCount:
            let owner = parallel_plan.ParallelFindTensorHeadOwner(plan.partitionPlan, headIndex)
            if IsErr(owner):
                return Err[bool](Error(owner))
            if !DistributedPeerReady(peers, Value(owner)):
                return Err[bool]("distributed inference: activation head owner")
            if Value(owner) != shard.peerId:
                return Err[bool]("distributed inference: activation head peer mismatch")
    return Ok[bool](true)

@borrows
fn DistributedValidateRouteExpertPartitions(plan: DistributedInferencePlan,
                                            peers: DistributedInferencePeer[]): Result[bool] =
    let routeSetOk = moe_router.MoeValidateRoutePlanSet(plan.routePlanSet)
    if IsErr(routeSetOk):
        return Err[bool](Error(routeSetOk))
    if plan.routePlanSet.layerRoutes.len != plan.modelGraph.layerCount:
        return Err[bool]("distributed inference: route set layer count")
    if plan.partitionPlan.expertShards.len != plan.modelGraph.expertCount:
        return Err[bool]("distributed inference: expert partition/model mismatch")
    for layerIndex in 0..<plan.routePlanSet.layerRoutes.len:
        let route = plan.routePlanSet.layerRoutes[layerIndex].routePlan
        if route.expertCount != plan.modelGraph.expertCount:
            return Err[bool]("distributed inference: route expert count")
        for expertId in 0..<route.expertLoads.len:
            if route.expertLoads[expertId] > 0:
                let shardIndex = DistributedFindExpertShard(plan, expertId)
                if shardIndex < 0:
                    return Err[bool]("distributed inference: routed expert missing shard")
                if !DistributedPeerReady(peers, plan.partitionPlan.expertShards[shardIndex].peerId):
                    return Err[bool]("distributed inference: routed expert peer missing")
        for choiceIndex in 0..<route.choices.len:
            let expert0 = route.choices[choiceIndex].expert0
            let expert1 = route.choices[choiceIndex].expert1
            let shard0 = DistributedFindExpertShard(plan, expert0)
            let shard1 = DistributedFindExpertShard(plan, expert1)
            if shard0 < 0 || shard1 < 0:
                return Err[bool]("distributed inference: route choice expert shard")
            if !DistributedPeerReady(peers, plan.partitionPlan.expertShards[shard0].peerId) ||
               !DistributedPeerReady(peers, plan.partitionPlan.expertShards[shard1].peerId):
                return Err[bool]("distributed inference: route choice expert peer")
    return Ok[bool](true)

@borrows
fn DistributedValidatePlan(plan: DistributedInferencePlan,
                           peers: DistributedInferencePeer[]): Result[bool] =
    if plan.schema != DistributedInferenceSchema || plan.engineCid == "":
        return Err[bool]("distributed inference: plan identity")
    let peerOk = DistributedValidatePeers(peers)
    if IsErr(peerOk):
        return Err[bool](Error(peerOk))
    let graphOk = model_graph.ModelGraphValidate(plan.modelGraph)
    if IsErr(graphOk):
        return Err[bool](Error(graphOk))
    let weightAnchorOk = model_graph.ModelGraphValidateExpectedWeightPayloadHashes(plan.modelGraph)
    if IsErr(weightAnchorOk):
        return Err[bool](Error(weightAnchorOk))
    let weightOk = weight_binding.WeightBindingValidate(plan.weightBindings, plan.modelGraph)
    if IsErr(weightOk):
        return Err[bool](Error(weightOk))
    let weightPeerOk = DistributedValidateWeightBindingPeers(plan.weightBindings, peers)
    if IsErr(weightPeerOk):
        return Err[bool](Error(weightPeerOk))
    if plan.deviceWeightBindingHash <= int64(0):
        return Err[bool]("distributed inference: device weight binding hash")
    let partitionOk = parallel_plan.ParallelValidatePlan(plan.partitionPlan)
    if IsErr(partitionOk):
        return Err[bool](Error(partitionOk))
    let partitionPeersOk = DistributedValidatePartitionPeers(plan.partitionPlan, peers)
    if IsErr(partitionPeersOk):
        return Err[bool](Error(partitionPeersOk))
    let tensorPlanOk = DistributedValidateTensorParallelPlan(plan, peers)
    if IsErr(tensorPlanOk):
        return Err[bool](Error(tensorPlanOk))
    if plan.partitionPlan.expertShards.len != plan.modelGraph.expertCount:
        return Err[bool]("distributed inference: expert partition/model mismatch")
    let expertWeightOk = DistributedValidateExpertWeightBindings(plan)
    if IsErr(expertWeightOk):
        return Err[bool](Error(expertWeightOk))
    if plan.kernelPrograms.len <= 0:
        return Err[bool]("distributed inference: empty kernel set")
    for i in 0..<plan.kernelPrograms.len:
        let kernelOk = kernel_ir.KernelIrValidateProgram(plan.kernelPrograms[i])
        if IsErr(kernelOk):
            return Err[bool](Error(kernelOk))
    if plan.kvReceipt.pageCount <= 0 || plan.kvReceipt.tokenCount <= 0 || plan.kvReceipt.pageTableHash <= int64(0):
        return Err[bool]("distributed inference: kv receipt")
    if plan.kvStateHash <= int64(0):
        return Err[bool]("distributed inference: kv state hash")
    let kvShardOk = DistributedValidateKvShardReceiptSet(
        plan.kvShardReceipts,
        plan.kvReceipt,
        plan.kvStateHash,
        peers
    )
    if IsErr(kvShardOk):
        return Err[bool](Error(kvShardOk))
    let specOk = DistributedValidateSpecDecodePlan(plan.specDecodePlan)
    if IsErr(specOk):
        return Err[bool](Error(specOk))
    let routeOk = moe_router.MoeValidateRoutePlan(plan.routePlan)
    if IsErr(routeOk):
        return Err[bool](Error(routeOk))
    let routeSetOk = moe_router.MoeValidateRoutePlanSet(plan.routePlanSet)
    if IsErr(routeSetOk):
        return Err[bool](Error(routeSetOk))
    if plan.routePlan.expertCount != plan.modelGraph.expertCount || plan.routePlan.topK != plan.modelGraph.topK:
        return Err[bool]("distributed inference: router/model mismatch")
    if !moe_router.MoeRoutePlanSetContainsRoute(plan.routePlanSet, plan.routePlan.routeHash):
        return Err[bool]("distributed inference: router set missing active route")
    let expertRouteOk = DistributedValidateRouteExpertPartitions(plan, peers)
    if IsErr(expertRouteOk):
        return Err[bool](Error(expertRouteOk))
    if plan.activationShards.len <= 0:
        return Err[bool]("distributed inference: empty activation shards")
    for i in 0..<plan.activationShards.len:
        for j in i + 1..<plan.activationShards.len:
            if plan.activationShards[i].shardName == plan.activationShards[j].shardName:
                return Err[bool]("distributed inference: duplicate activation shard")
        let activationOk = DistributedValidateActivationShard(
            plan.activationShards[i],
            peers,
            plan.routePlan.tokenCount,
            plan.modelGraph.hiddenSize
        )
        if IsErr(activationOk):
            return Err[bool](Error(activationOk))
    let coverageOk = DistributedValidateActivationCoverage(
        plan.activationShards,
        plan.routePlan.tokenCount,
        plan.modelGraph.hiddenSize
    )
    if IsErr(coverageOk):
        return Err[bool](Error(coverageOk))
    let headAlignmentOk = DistributedValidateActivationHeadAlignment(plan, peers)
    if IsErr(headAlignmentOk):
        return Err[bool](Error(headAlignmentOk))
    if DistributedPlanHash(plan) != plan.engineHash:
        return Err[bool]("distributed inference: plan hash mismatch")
    return Ok[bool](true)

fn DistributedBuildPlan(engineCid: str,
                        graph: model_graph.ModelGraph,
                        weights: weight_binding.WeightBindingSet,
                        partition: parallel_plan.InferencePartitionPlan,
                        kernels: kernel_ir.KernelProgram[],
                        kvReceipt: paged_kv_cache.PagedKVReceipt,
                        kvStateHash: int64,
                        routePlan: moe_router.MoeRoutePlan,
                        activationShards: DistributedActivationShard[]): DistributedInferencePlan =
    return DistributedBuildPlanWithRouteSetAndSpecDecode(
        engineCid,
        graph,
        weights,
        partition,
        kernels,
        kvReceipt,
        kvStateHash,
        DistributedBuildDisabledSpecDecodePlan(),
        routePlan,
        moe_router.MoeRoutePlanSetFromSingle(0, routePlan),
        activationShards
    )

fn DistributedBuildPlanWithRouteSet(engineCid: str,
                                    graph: model_graph.ModelGraph,
                                    weights: weight_binding.WeightBindingSet,
                                    partition: parallel_plan.InferencePartitionPlan,
                                    kernels: kernel_ir.KernelProgram[],
                                    kvReceipt: paged_kv_cache.PagedKVReceipt,
                                    kvStateHash: int64,
                                    routePlan: moe_router.MoeRoutePlan,
                                    routePlanSet: moe_router.MoeRoutePlanSet,
                                    activationShards: DistributedActivationShard[]): DistributedInferencePlan =
    return DistributedBuildPlanWithRouteSetAndSpecDecode(
        engineCid,
        graph,
        weights,
        partition,
        kernels,
        kvReceipt,
        kvStateHash,
        DistributedBuildDisabledSpecDecodePlan(),
        routePlan,
        routePlanSet,
        activationShards
    )

fn DistributedBuildPlanWithRouteSetAndSpecDecode(engineCid: str,
                                                 graph: model_graph.ModelGraph,
                                                 weights: weight_binding.WeightBindingSet,
                                                 partition: parallel_plan.InferencePartitionPlan,
                                                 kernels: kernel_ir.KernelProgram[],
                                                 kvReceipt: paged_kv_cache.PagedKVReceipt,
                                                 kvStateHash: int64,
                                                 specDecodePlan: DistributedSpecDecodePlan,
                                                 routePlan: moe_router.MoeRoutePlan,
                                                 routePlanSet: moe_router.MoeRoutePlanSet,
                                                 activationShards: DistributedActivationShard[]): DistributedInferencePlan =
    return DistributedBuildPlanWithDeviceWeightBindingHash(
        engineCid,
        graph,
        weights,
        weights.bindingHash,
        partition,
        kernels,
        kvReceipt,
        kvStateHash,
        specDecodePlan,
        routePlan,
        routePlanSet,
        activationShards
    )

@borrows
fn DistributedBuildPlanWithDeviceWeightBindingHash(engineCid: str,
                                                   graph: model_graph.ModelGraph,
                                                   weights: weight_binding.WeightBindingSet,
                                                   deviceWeightBindingHash: int64,
                                                   partition: parallel_plan.InferencePartitionPlan,
                                                   kernels: kernel_ir.KernelProgram[],
                                                   kvReceipt: paged_kv_cache.PagedKVReceipt,
                                                   kvStateHash: int64,
                                                   specDecodePlan: DistributedSpecDecodePlan,
                                                   routePlan: moe_router.MoeRoutePlan,
                                                   routePlanSet: moe_router.MoeRoutePlanSet,
                                                   activationShards: DistributedActivationShard[]): DistributedInferencePlan =
    let kvShardSet = DistributedBuildDefaultKvShardReceiptSet(partition, kvReceipt, kvStateHash)
    var plan = DistributedInferencePlan(
        schema: DistributedInferenceSchema,
        engineCid: engineCid,
        modelGraph: graph,
        weightBindings: weights,
        deviceWeightBindingHash: deviceWeightBindingHash,
        partitionPlan: partition,
        kernelPrograms: kernels,
        kvReceipt: kvReceipt,
        kvStateHash: kvStateHash,
        kvShardReceipts: Value(kvShardSet),
        specDecodePlan: specDecodePlan,
        routePlan: routePlan,
        routePlanSet: routePlanSet,
        activationShards: activationShards,
        engineHash: int64(0)
    )
    plan.engineHash = DistributedPlanHash(plan)
    return plan

@borrows
fn DistributedDeviceWeightBindingHashFromPageSet(set: weight_store.WeightSafetensorsDevicePageBindingSet): Result[int64] =
    if set.schema != weight_store.WeightSafetensorsDevicePageBindingSetSchema ||
       set.bindingSetHash <= int64(0):
        return Err[int64]("distributed device weight page binding: schema")
    if weight_store.WeightSafetensorsDevicePageBindingSetHash(set) != set.bindingSetHash:
        return Err[int64]("distributed device weight page binding: hash")
    return Ok[int64](set.bindingSetHash)

@borrows
fn DistributedKernelHashAllowed(plan: DistributedInferencePlan, kernelHash: int64): bool =
    if kernelHash <= int64(0):
        return false
    for i in 0..<plan.kernelPrograms.len:
        if plan.kernelPrograms[i].kernelHash == kernelHash:
            return true
    return false

@borrows
fn DistributedShardDispatchExpectedInputHash(plan: DistributedInferencePlan,
                                             shard: DistributedActivationShard,
                                             kernelHash: int64): Result[int64] =
    if kernelHash <= int64(0):
        return Err[int64]("distributed inference dispatch input: kernel hash")
    if shard.schema != DistributedInferenceActivationSchema || shard.shardName == "" || shard.peerId == "":
        return Err[int64]("distributed inference dispatch input: shard identity")
    if shard.tokenStart < 0 || shard.tokenCount <= 0 || shard.featureStart < 0 || shard.featureCount <= 0:
        return Err[int64]("distributed inference dispatch input: shard span")
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, "cheng.inference.dispatch_input.v1")
    h = DistributedHashStep(h, plan.modelGraph.graphHash)
    h = DistributedHashStep(h, plan.weightBindings.bindingHash)
    h = DistributedHashStep(h, plan.deviceWeightBindingHash)
    h = DistributedHashStep(h, plan.partitionPlan.planHash)
    h = DistributedHashStep(h, DistributedKernelSetHash(plan.kernelPrograms))
    h = DistributedHashStep(h, kernelHash)
    h = DistributedHashStep(h, plan.kvReceipt.pageTableHash)
    h = DistributedHashStep(h, plan.kvStateHash)
    h = DistributedHashStep(h, plan.kvShardReceipts.receiptSetHash)
    h = DistributedHashStep(h, plan.specDecodePlan.planHash)
    h = DistributedHashStep(h, plan.routePlanSet.routeSetHash)
    h = DistributedHashTextWith(h, shard.shardName)
    h = DistributedHashTextWith(h, shard.peerId)
    h = DistributedHashStep(h, int64(shard.tokenStart))
    h = DistributedHashStep(h, int64(shard.tokenCount))
    h = DistributedHashStep(h, int64(shard.featureStart))
    h = DistributedHashStep(h, int64(shard.featureCount))
    if h <= int64(0):
        return Err[int64]("distributed inference dispatch input: hash")
    return Ok[int64](h)

@borrows
fn DistributedShardDispatchRequestHash(request: DistributedShardDispatchRequest): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, request.schema)
    h = DistributedHashStep(h, request.enginePlanHash)
    h = DistributedHashTextWith(h, request.coordinatorPeerId)
    h = DistributedHashTextWith(h, request.peerId)
    h = DistributedHashTextWith(h, request.targetPeerId)
    h = DistributedHashTextWith(h, request.deviceCapabilityHash)
    h = DistributedHashTextWith(h, request.shardName)
    h = DistributedHashStep(h, request.kernelHash)
    h = DistributedHashStep(h, request.inputHash)
    h = DistributedHashStep(h, request.expectedOutputPayloadHash)
    h = DistributedHashStep(h, int64(request.tokenStart))
    h = DistributedHashStep(h, int64(request.tokenCount))
    h = DistributedHashStep(h, int64(request.featureStart))
    h = DistributedHashStep(h, int64(request.featureCount))
    return h

fn DistributedShardDispatchRequestBuild(draft: DistributedShardDispatchRequest): DistributedShardDispatchRequest =
    var request = draft
    request.schema = DistributedShardDispatchRequestSchema
    request.requestHash = int64(0)
    request.requestHash = DistributedShardDispatchRequestHash(request)
    return request

@borrows
fn DistributedShardDispatchRequestSetHash(set: DistributedShardDispatchRequestSet): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, set.schema)
    h = DistributedHashStep(h, set.enginePlanHash)
    for i in 0..<set.requests.len:
        h = DistributedHashStep(h, set.requests[i].requestHash)
    return h

fn DistributedShardDispatchRequestSetBuild(enginePlanHash: int64,
                                           requests: DistributedShardDispatchRequest[]): DistributedShardDispatchRequestSet =
    var set = DistributedShardDispatchRequestSet(
        schema: DistributedShardDispatchRequestSetSchema,
        enginePlanHash: enginePlanHash,
        requests: requests,
        requestSetHash: int64(0)
    )
    set.requestSetHash = DistributedShardDispatchRequestSetHash(set)
    return set

@borrows
fn DistributedShardDispatchResponseHash(response: DistributedShardDispatchResponse): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, response.schema)
    h = DistributedHashStep(h, response.requestHash)
    h = DistributedHashStep(h, response.enginePlanHash)
    h = DistributedHashTextWith(h, response.peerId)
    h = DistributedHashTextWith(h, response.deviceCapabilityHash)
    h = DistributedHashTextWith(h, response.shardName)
    h = DistributedHashStep(h, response.payloadHash)
    h = DistributedHashStep(h, response.receiptHash)
    h = DistributedHashStep(h, response.elapsedNs)
    return h

fn DistributedShardDispatchResponseBuild(draft: DistributedShardDispatchResponse): DistributedShardDispatchResponse =
    var response = draft
    response.schema = DistributedShardDispatchResponseSchema
    response.responseHash = int64(0)
    response.responseHash = DistributedShardDispatchResponseHash(response)
    return response

@borrows
fn DistributedShardDispatchResponseSetHash(set: DistributedShardDispatchResponseSet): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, set.schema)
    h = DistributedHashStep(h, set.enginePlanHash)
    for i in 0..<set.responses.len:
        h = DistributedHashStep(h, set.responses[i].responseHash)
    return h

fn DistributedShardDispatchResponseSetBuild(enginePlanHash: int64,
                                            responses: DistributedShardDispatchResponse[]): DistributedShardDispatchResponseSet =
    var set = DistributedShardDispatchResponseSet(
        schema: DistributedShardDispatchResponseSetSchema,
        enginePlanHash: enginePlanHash,
        responses: responses,
        responseSetHash: int64(0)
    )
    set.responseSetHash = DistributedShardDispatchResponseSetHash(set)
    return set

@borrows
fn DistributedShardTransportFrameHash(frame: DistributedShardTransportFrame): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, frame.schema)
    h = DistributedHashTextWith(h, frame.frameKind)
    h = DistributedHashStep(h, frame.enginePlanHash)
    h = DistributedHashStep(h, int64(frame.seqNo))
    h = DistributedHashTextWith(h, frame.coordinatorPeerId)
    h = DistributedHashTextWith(h, frame.sourcePeerId)
    h = DistributedHashTextWith(h, frame.targetPeerId)
    h = DistributedHashTextWith(h, frame.shardName)
    h = DistributedHashStep(h, frame.requestHash)
    h = DistributedHashStep(h, frame.responseHash)
    h = DistributedHashStep(h, frame.envelopeHash)
    h = DistributedHashStep(h, frame.payloadHash)
    h = DistributedHashStep(h, frame.receiptHash)
    h = DistributedHashStep(h, frame.sentAtNs)
    return h

fn DistributedShardTransportFrameBuild(draft: DistributedShardTransportFrame): DistributedShardTransportFrame =
    var frame = draft
    frame.schema = DistributedShardTransportFrameSchema
    frame.frameHash = int64(0)
    frame.frameHash = DistributedShardTransportFrameHash(frame)
    return frame

@borrows
fn DistributedShardTransportFrameSetHash(set: DistributedShardTransportFrameSet): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, set.schema)
    h = DistributedHashStep(h, set.enginePlanHash)
    for i in 0..<set.frames.len:
        h = DistributedHashStep(h, set.frames[i].frameHash)
    return h

fn DistributedShardTransportFrameSetBuild(enginePlanHash: int64,
                                          frames: DistributedShardTransportFrame[]): DistributedShardTransportFrameSet =
    var set = DistributedShardTransportFrameSet(
        schema: DistributedShardTransportFrameSetSchema,
        enginePlanHash: enginePlanHash,
        frames: frames,
        frameSetHash: int64(0)
    )
    set.frameSetHash = DistributedShardTransportFrameSetHash(set)
    return set

fn DistributedWriteI64LE(buf: var rawbytes.Bytes, offset: int32, value: int64) =
    rawbytes.BytesSet(buf, offset, int32(value & int64(255)))
    rawbytes.BytesSet(buf, offset + 1, int32((value >> 8) & int64(255)))
    rawbytes.BytesSet(buf, offset + 2, int32((value >> 16) & int64(255)))
    rawbytes.BytesSet(buf, offset + 3, int32((value >> 24) & int64(255)))
    rawbytes.BytesSet(buf, offset + 4, int32((value >> 32) & int64(255)))
    rawbytes.BytesSet(buf, offset + 5, int32((value >> 40) & int64(255)))
    rawbytes.BytesSet(buf, offset + 6, int32((value >> 48) & int64(255)))
    rawbytes.BytesSet(buf, offset + 7, int32((value >> 56) & int64(255)))

@borrows
fn DistributedReadI64LE(buf: rawbytes.Bytes, offset: int32): int64 =
    var out: int64
    out = out + (int64(rawbytes.BytesGet(buf, offset) & 255))
    out = out + (int64(rawbytes.BytesGet(buf, offset + 1) & 255) << 8)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 2) & 255) << 16)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 3) & 255) << 24)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 4) & 255) << 32)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 5) & 255) << 40)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 6) & 255) << 48)
    out = out + (int64(rawbytes.BytesGet(buf, offset + 7) & 255) << 56)
    return out

fn DistributedTransportFrameKindCode(frameKind: str): int64 =
    if frameKind == DistributedTransportFrameKindRequest:
        return int64(1)
    if frameKind == DistributedTransportFrameKindResponse:
        return int64(2)
    return int64(0)

@borrows
fn DistributedTransportFrameTextHash(text: str): int64 =
    return DistributedHashTextWith(int64(67), text)

@borrows
fn DistributedShardTransportFrameWireWord(frame: DistributedShardTransportFrame,
                                          index: int32): int64 =
    if index == 0:
        return int64(DistributedTransportFrameWireMagic)
    if index == 1:
        return DistributedTransportFrameKindCode(frame.frameKind)
    if index == 2:
        return frame.enginePlanHash
    if index == 3:
        return int64(frame.seqNo)
    if index == 4:
        return DistributedTransportFrameTextHash(frame.coordinatorPeerId)
    if index == 5:
        return DistributedTransportFrameTextHash(frame.sourcePeerId)
    if index == 6:
        return DistributedTransportFrameTextHash(frame.targetPeerId)
    if index == 7:
        return DistributedTransportFrameTextHash(frame.shardName)
    if index == 8:
        return frame.requestHash
    if index == 9:
        return frame.responseHash
    if index == 10:
        return frame.envelopeHash
    if index == 11:
        return frame.payloadHash
    if index == 12:
        return frame.receiptHash
    if index == 13:
        return frame.sentAtNs
    if index == 14:
        return frame.frameHash
    return int64(-1)

@borrows
fn DistributedShardTransportFrameWireBytes(frame: DistributedShardTransportFrame): Result[rawbytes.Bytes] =
    if frame.schema != DistributedShardTransportFrameSchema:
        return Err[rawbytes.Bytes]("distributed inference transport wire: frame schema")
    if frame.frameHash <= int64(0) || DistributedShardTransportFrameHash(frame) != frame.frameHash:
        return Err[rawbytes.Bytes]("distributed inference transport wire: frame hash")
    let byteCount: int32 = DistributedTransportFrameWireWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("distributed inference transport wire: allocation")
    for i in 0..<DistributedTransportFrameWireWordCount:
        DistributedWriteI64LE(out, i * 8, DistributedShardTransportFrameWireWord(frame, i))
    return Ok[rawbytes.Bytes](out)

@borrows
fn DistributedValidateShardTransportFrameWire(frame: DistributedShardTransportFrame,
                                              bytes: rawbytes.Bytes): Result[bool] =
    if frame.schema != DistributedShardTransportFrameSchema:
        return Err[bool]("distributed inference transport wire: schema")
    if frame.enginePlanHash <= int64(0) || frame.frameHash <= int64(0):
        return Err[bool]("distributed inference transport wire: frame identity")
    if DistributedTransportFrameKindCode(frame.frameKind) == int64(0):
        return Err[bool]("distributed inference transport wire: kind")
    if DistributedShardTransportFrameHash(frame) != frame.frameHash:
        return Err[bool]("distributed inference transport wire: frame hash")
    let byteCount: int32 = DistributedTransportFrameWireWordCount * 8
    if rawbytes.BytesLen(bytes) != byteCount:
        return Err[bool]("distributed inference transport wire: byte length")
    for i in 0..<DistributedTransportFrameWireWordCount:
        let got = DistributedReadI64LE(bytes, i * 8)
        let expected = DistributedShardTransportFrameWireWord(frame, i)
        if got != expected:
            return Err[bool](strutil.Join([
                "distributed inference transport wire: word mismatch index=",
                strings.Int64ToStr(int64(i)),
                " got=",
                strings.Int64ToStr(got),
                " expected=",
                strings.Int64ToStr(expected)
            ], ""))
    return Ok[bool](true)

@borrows
fn DistributedKvPageTransferFramePageHash(frame: DistributedKvPageTransferFrame): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, "cheng.inference.distributed_kv_page_transfer_frame_page.v1")
    h = DistributedHashStep(h, int64(frame.pageId))
    h = DistributedHashStep(h, int64(frame.pageOrdinal))
    return h

fn DistributedKvPageTransferFrameWireWord(frame: DistributedKvPageTransferFrame,
                                          index: int32): int64 =
    if index == 0:
        return int64(DistributedTransportFrameWireMagic)
    if index == 1:
        return DistributedTransportFrameKindCode(frame.frameKind)
    if index == 2:
        return frame.enginePlanHash
    if index == 3:
        return int64(frame.seqNo)
    if index == 4:
        return DistributedTransportFrameTextHash(frame.coordinatorPeerId)
    if index == 5:
        return DistributedTransportFrameTextHash(frame.sourcePeerId)
    if index == 6:
        return DistributedTransportFrameTextHash(frame.targetPeerId)
    if index == 7:
        return DistributedKvPageTransferFramePageHash(frame)
    if index == 8:
        return frame.requestHash
    if index == 9:
        return frame.responseHash
    if index == 10:
        if frame.frameKind == DistributedTransportFrameKindResponse:
            return DistributedKvPageTransferFramePageHash(frame)
        return int64(0)
    if index == 11:
        return frame.payloadHash
    if index == 12:
        return frame.receiptHash
    if index == 13:
        return frame.sentAtNs
    if index == 14:
        return frame.frameHash
    return int64(-1)

fn DistributedKvPageTransferFrameWireBytes(frame: DistributedKvPageTransferFrame): Result[rawbytes.Bytes] =
    if frame.schema != DistributedKvPageTransferFrameSchema:
        return Err[rawbytes.Bytes]("distributed kv page transfer wire: frame schema")
    if frame.frameHash <= int64(0) || DistributedKvPageTransferFrameHash(frame) != frame.frameHash:
        return Err[rawbytes.Bytes]("distributed kv page transfer wire: frame hash")
    if DistributedTransportFrameKindCode(frame.frameKind) == int64(0):
        return Err[rawbytes.Bytes]("distributed kv page transfer wire: frame kind")
    if DistributedKvPageTransferFramePageHash(frame) <= int64(0):
        return Err[rawbytes.Bytes]("distributed kv page transfer wire: page hash")
    let byteCount: int32 = DistributedTransportFrameWireWordCount * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("distributed kv page transfer wire: allocation")
    for i in 0..<DistributedTransportFrameWireWordCount:
        DistributedWriteI64LE(out, i * 8, DistributedKvPageTransferFrameWireWord(frame, i))
    return Ok[rawbytes.Bytes](out)

@borrows
fn DistributedValidateKvPageTransferFrameWire(frame: DistributedKvPageTransferFrame,
                                              bytes: rawbytes.Bytes): Result[bool] =
    if frame.schema != DistributedKvPageTransferFrameSchema:
        return Err[bool]("distributed kv page transfer wire: schema")
    if frame.enginePlanHash <= int64(0) || frame.frameHash <= int64(0):
        return Err[bool]("distributed kv page transfer wire: frame identity")
    if DistributedTransportFrameKindCode(frame.frameKind) == int64(0):
        return Err[bool]("distributed kv page transfer wire: kind")
    if DistributedKvPageTransferFrameHash(frame) != frame.frameHash:
        return Err[bool]("distributed kv page transfer wire: frame hash")
    if DistributedKvPageTransferFramePageHash(frame) <= int64(0):
        return Err[bool]("distributed kv page transfer wire: page hash")
    let byteCount: int32 = DistributedTransportFrameWireWordCount * 8
    if rawbytes.BytesLen(bytes) != byteCount:
        return Err[bool]("distributed kv page transfer wire: byte length")
    for i in 0..<DistributedTransportFrameWireWordCount:
        let got = DistributedReadI64LE(bytes, i * 8)
        let expected = DistributedKvPageTransferFrameWireWord(frame, i)
        if got != expected:
            return Err[bool](strutil.Join([
                "distributed kv page transfer wire: word mismatch index=",
                strings.Int64ToStr(int64(i)),
                " got=",
                strings.Int64ToStr(got),
                " expected=",
                strings.Int64ToStr(expected)
            ], ""))
    return Ok[bool](true)

fn DistributedShardTransportRequestFrameBuild(request: DistributedShardDispatchRequest,
                                              seqNo: uint64,
                                              sentAtNs: int64): Result[DistributedShardTransportFrame] =
    if request.schema != DistributedShardDispatchRequestSchema || request.requestHash <= int64(0):
        return Err[DistributedShardTransportFrame]("distributed inference transport frame: request")
    if sentAtNs <= int64(0):
        return Err[DistributedShardTransportFrame]("distributed inference transport frame: sent time")
    let frame = DistributedShardTransportFrameBuild(DistributedShardTransportFrame(
        schema: "",
        frameKind: DistributedTransportFrameKindRequest,
        enginePlanHash: request.enginePlanHash,
        seqNo: seqNo,
        coordinatorPeerId: request.coordinatorPeerId,
        sourcePeerId: request.coordinatorPeerId,
        targetPeerId: request.peerId,
        shardName: request.shardName,
        requestHash: request.requestHash,
        responseHash: int64(0),
        envelopeHash: int64(0),
        payloadHash: request.expectedOutputPayloadHash,
        receiptHash: int64(0),
        sentAtNs: sentAtNs,
        frameHash: int64(0)
    ))
    return Ok[DistributedShardTransportFrame](frame)

fn DistributedShardTransportResponseFrameBuild(request: DistributedShardDispatchRequest,
                                               response: DistributedShardDispatchResponse,
                                               envelope: activation_transport.ActivationEnvelope,
                                               seqNo: uint64,
                                               sentAtNs: int64): Result[DistributedShardTransportFrame] =
    if request.schema != DistributedShardDispatchRequestSchema || request.requestHash <= int64(0):
        return Err[DistributedShardTransportFrame]("distributed inference transport frame: request")
    if response.schema != DistributedShardDispatchResponseSchema || response.responseHash <= int64(0):
        return Err[DistributedShardTransportFrame]("distributed inference transport frame: response")
    if envelope.schema != activation_transport.ActivationTransportSchema || envelope.envelopeHash <= int64(0):
        return Err[DistributedShardTransportFrame]("distributed inference transport frame: envelope")
    if response.requestHash != request.requestHash || envelope.shardName != request.shardName:
        return Err[DistributedShardTransportFrame]("distributed inference transport frame: binding")
    if sentAtNs <= int64(0):
        return Err[DistributedShardTransportFrame]("distributed inference transport frame: sent time")
    let frame = DistributedShardTransportFrameBuild(DistributedShardTransportFrame(
        schema: "",
        frameKind: DistributedTransportFrameKindResponse,
        enginePlanHash: request.enginePlanHash,
        seqNo: seqNo,
        coordinatorPeerId: request.coordinatorPeerId,
        sourcePeerId: response.peerId,
        targetPeerId: request.coordinatorPeerId,
        shardName: response.shardName,
        requestHash: request.requestHash,
        responseHash: response.responseHash,
        envelopeHash: envelope.envelopeHash,
        payloadHash: response.payloadHash,
        receiptHash: response.receiptHash,
        sentAtNs: sentAtNs,
        frameHash: int64(0)
    ))
    return Ok[DistributedShardTransportFrame](frame)

@borrows
fn DistributedPeerExecuteActivationDispatch(plan: DistributedInferencePlan,
                                            peers: DistributedInferencePeer[],
                                            request: DistributedShardDispatchRequest,
                                            output: infer.TensorQ,
                                            elapsedNs: int64): Result[DistributedShardPeerExecutionResult] =
    let requestOk = DistributedValidateShardDispatchRequest(plan, peers, request)
    if IsErr(requestOk):
        return Err[DistributedShardPeerExecutionResult](Error(requestOk))
    let outputOk = infer.TensorValidate(output)
    if IsErr(outputOk):
        return Err[DistributedShardPeerExecutionResult](Error(outputOk))
    if output.shape.len != 2 || output.shape[0] != request.tokenCount || output.shape[1] != request.featureCount:
        return Err[DistributedShardPeerExecutionResult]("distributed inference peer execute: output shape")
    if elapsedNs <= int64(0):
        return Err[DistributedShardPeerExecutionResult]("distributed inference peer execute: elapsed ns")
    let payloadRes = activation_transport.ActivationTensorPayloadBuild(
        strings.CloneStr(request.peerId),
        strings.CloneStr(request.targetPeerId),
        strings.CloneStr(request.shardName),
        request.tokenStart,
        request.tokenCount,
        request.featureStart,
        request.featureCount,
        infer.TensorClone(output)
    )
    if IsErr(payloadRes):
        return Err[DistributedShardPeerExecutionResult](Error(payloadRes))
    let payload = Value(payloadRes)
    if payload.payloadHash != request.expectedOutputPayloadHash:
        return Err[DistributedShardPeerExecutionResult]("distributed inference peer execute: output payload hash")
    let receipt = DistributedShardExecutionReceiptBuild(DistributedShardExecutionReceipt(
        schema: "",
        enginePlanHash: request.enginePlanHash,
        peerId: strings.CloneStr(request.peerId),
        deviceCapabilityHash: strings.CloneStr(request.deviceCapabilityHash),
        shardName: strings.CloneStr(request.shardName),
        kernelHash: request.kernelHash,
        inputHash: request.inputHash,
        outputPayloadHash: payload.payloadHash,
        elapsedNs: elapsedNs,
        status: "",
        receiptHash: int64(0)
    ))
    let response = DistributedShardDispatchResponseBuild(DistributedShardDispatchResponse(
        schema: "",
        requestHash: request.requestHash,
        enginePlanHash: request.enginePlanHash,
        peerId: strings.CloneStr(request.peerId),
        deviceCapabilityHash: strings.CloneStr(request.deviceCapabilityHash),
        shardName: strings.CloneStr(request.shardName),
        payloadHash: payload.payloadHash,
        receiptHash: receipt.receiptHash,
        elapsedNs: elapsedNs,
        responseHash: int64(0)
    ))
    return Ok[DistributedShardPeerExecutionResult](DistributedShardPeerExecutionResult(
        payload: payload,
        receipt: receipt,
        response: response
    ))

@borrows
fn DistributedShardExecutionReceiptHash(receipt: DistributedShardExecutionReceipt): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, receipt.schema)
    h = DistributedHashStep(h, receipt.enginePlanHash)
    h = DistributedHashTextWith(h, receipt.peerId)
    h = DistributedHashTextWith(h, receipt.deviceCapabilityHash)
    h = DistributedHashTextWith(h, receipt.shardName)
    h = DistributedHashStep(h, receipt.kernelHash)
    h = DistributedHashStep(h, receipt.inputHash)
    h = DistributedHashStep(h, receipt.outputPayloadHash)
    h = DistributedHashStep(h, receipt.elapsedNs)
    h = DistributedHashTextWith(h, receipt.status)
    return h

fn DistributedShardExecutionReceiptBuild(draft: DistributedShardExecutionReceipt): DistributedShardExecutionReceipt =
    var receipt = draft
    receipt.schema = DistributedShardExecutionReceiptSchema
    receipt.status = execution_receipt.InferenceExecutionStatusExecuted
    receipt.receiptHash = int64(0)
    receipt.receiptHash = DistributedShardExecutionReceiptHash(receipt)
    return receipt

@borrows
fn DistributedShardExecutionReceiptSetHash(set: DistributedShardExecutionReceiptSet): int64 =
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, set.schema)
    h = DistributedHashStep(h, set.enginePlanHash)
    for i in 0..<set.receipts.len:
        h = DistributedHashStep(h, set.receipts[i].receiptHash)
    return h

fn DistributedShardExecutionReceiptSetBuild(enginePlanHash: int64,
                                           receipts: DistributedShardExecutionReceipt[]): DistributedShardExecutionReceiptSet =
    var set = DistributedShardExecutionReceiptSet(
        schema: DistributedShardExecutionReceiptSetSchema,
        enginePlanHash: enginePlanHash,
        receipts: receipts,
        receiptSetHash: int64(0)
    )
    set.receiptSetHash = DistributedShardExecutionReceiptSetHash(set)
    return set

fn DistributedFindActivationPayload(store: activation_transport.ActivationTensorStore,
                                    shardName: str): int32 =
    var found: int32 = -1
    for i in 0..<store.payloads.len:
        if store.payloads[i].shardName == shardName:
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn DistributedFindPeerCapability(peers: DistributedInferencePeer[], peerId: str): Result[str] =
    let idx = DistributedFindPeer(peers, peerId)
    if idx < 0:
        return Err[str]("distributed inference: receipt peer missing")
    if !peers[idx].online || peers[idx].deviceCapabilityHash == "":
        return Err[str]("distributed inference: receipt peer unavailable")
    return Ok[str](peers[idx].deviceCapabilityHash)

@borrows
fn DistributedFindDispatchRequestByHash(set: DistributedShardDispatchRequestSet,
                                        requestHash: int64): int32 =
    var found: int32 = -1
    for i in 0..<set.requests.len:
        if set.requests[i].requestHash == requestHash:
            if found >= 0:
                return -2
            found = i
    return found

fn DistributedFindReceiptByShard(set: DistributedShardExecutionReceiptSet,
                                 shardName: str): int32 =
    var found: int32 = -1
    for i in 0..<set.receipts.len:
        if set.receipts[i].shardName == shardName:
            if found >= 0:
                return -2
            found = i
    return found

fn DistributedFindActivationEnvelope(envelopes: activation_transport.ActivationEnvelope[],
                                     shardName: str): int32 =
    var found: int32 = -1
    for i in 0..<envelopes.len:
        if envelopes[i].shardName == shardName:
            if found >= 0:
                return -2
            found = i
    return found

fn DistributedFindTransportFrame(set: DistributedShardTransportFrameSet,
                                 frameKind: str,
                                 requestHash: int64): int32 =
    var found: int32 = -1
    for i in 0..<set.frames.len:
        if set.frames[i].frameKind == frameKind && set.frames[i].requestHash == requestHash:
            if found >= 0:
                return -2
            found = i
    return found

@borrows
fn DistributedValidateShardDispatchRequest(plan: DistributedInferencePlan,
                                           peers: DistributedInferencePeer[],
                                           request: DistributedShardDispatchRequest): Result[bool] =
    if request.schema != DistributedShardDispatchRequestSchema:
        return Err[bool]("distributed inference dispatch request: schema")
    if request.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference dispatch request: plan hash")
    if request.coordinatorPeerId == "" || request.peerId == "" || request.targetPeerId == "" ||
       request.deviceCapabilityHash == "" || request.shardName == "":
        return Err[bool]("distributed inference dispatch request: identity")
    if request.kernelHash <= int64(0) || request.inputHash <= int64(0) ||
       request.expectedOutputPayloadHash <= int64(0):
        return Err[bool]("distributed inference dispatch request: hashes")
    if DistributedShardDispatchRequestHash(request) != request.requestHash:
        return Err[bool]("distributed inference dispatch request: hash mismatch")
    if !DistributedKernelHashAllowed(plan, request.kernelHash):
        return Err[bool]("distributed inference dispatch request: kernel not in plan")
    let peerCap = DistributedFindPeerCapability(peers, request.peerId)
    if IsErr(peerCap):
        return Err[bool](Error(peerCap))
    if Value(peerCap) != request.deviceCapabilityHash:
        return Err[bool]("distributed inference dispatch request: device capability")
    if !DistributedPeerReady(peers, request.targetPeerId):
        return Err[bool]("distributed inference dispatch request: target peer")
    let shardIndex = DistributedFindActivationShard(plan, request.shardName)
    if shardIndex < 0:
        return Err[bool]("distributed inference dispatch request: shard missing")
    let shard = plan.activationShards[shardIndex]
    if shard.peerId != request.peerId || shard.shardHash != request.expectedOutputPayloadHash:
        return Err[bool]("distributed inference dispatch request: shard binding")
    if shard.tokenStart != request.tokenStart || shard.tokenCount != request.tokenCount:
        return Err[bool]("distributed inference dispatch request: token span")
    if shard.featureStart != request.featureStart || shard.featureCount != request.featureCount:
        return Err[bool]("distributed inference dispatch request: feature span")
    let expectedInputHash = DistributedShardDispatchExpectedInputHash(plan, shard, request.kernelHash)
    if IsErr(expectedInputHash):
        return Err[bool](Error(expectedInputHash))
    if request.inputHash != Value(expectedInputHash):
        return Err[bool]("distributed inference dispatch request: input hash")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardDispatchRequestSet(plan: DistributedInferencePlan,
                                              peers: DistributedInferencePeer[],
                                              set: DistributedShardDispatchRequestSet): Result[bool] =
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[bool](Error(planOk))
    if set.schema != DistributedShardDispatchRequestSetSchema:
        return Err[bool]("distributed inference dispatch request set: schema")
    if set.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference dispatch request set: plan hash")
    if set.requests.len != plan.activationShards.len:
        return Err[bool]("distributed inference dispatch request set: count")
    for i in 0..<set.requests.len:
        for j in i + 1..<set.requests.len:
            if set.requests[i].shardName == set.requests[j].shardName ||
               set.requests[i].requestHash == set.requests[j].requestHash:
                return Err[bool]("distributed inference dispatch request set: duplicate")
        let requestOk = DistributedValidateShardDispatchRequest(plan, peers, set.requests[i])
        if IsErr(requestOk):
            return Err[bool](Error(requestOk))
    for i in 0..<plan.activationShards.len:
        var found: bool
        found = false
        for j in 0..<set.requests.len:
            if set.requests[j].shardName == plan.activationShards[i].shardName:
                found = true
        if !found:
            return Err[bool]("distributed inference dispatch request set: missing shard")
    if DistributedShardDispatchRequestSetHash(set) != set.requestSetHash:
        return Err[bool]("distributed inference dispatch request set: hash mismatch")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardExecutionReceipt(plan: DistributedInferencePlan,
                                            peers: DistributedInferencePeer[],
                                            store: activation_transport.ActivationTensorStore,
                                            receipt: DistributedShardExecutionReceipt): Result[bool] =
    if receipt.schema != DistributedShardExecutionReceiptSchema:
        return Err[bool]("distributed inference receipt: schema")
    if receipt.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference receipt: plan hash")
    if receipt.peerId == "" || receipt.deviceCapabilityHash == "" || receipt.shardName == "":
        return Err[bool]("distributed inference receipt: identity")
    if receipt.status != execution_receipt.InferenceExecutionStatusExecuted:
        return Err[bool]("distributed inference receipt: status")
    if receipt.kernelHash <= int64(0) || receipt.inputHash <= int64(0) ||
       receipt.outputPayloadHash <= int64(0) || receipt.elapsedNs <= int64(0):
        return Err[bool]("distributed inference receipt: execution fields")
    if DistributedShardExecutionReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("distributed inference receipt: hash mismatch")
    if !DistributedKernelHashAllowed(plan, receipt.kernelHash):
        return Err[bool]("distributed inference receipt: kernel not in plan")
    let peerCap = DistributedFindPeerCapability(peers, receipt.peerId)
    if IsErr(peerCap):
        return Err[bool](Error(peerCap))
    if Value(peerCap) != receipt.deviceCapabilityHash:
        return Err[bool]("distributed inference receipt: device capability")
    let shardIndex = DistributedFindActivationShard(plan, receipt.shardName)
    if shardIndex < 0:
        return Err[bool]("distributed inference receipt: shard missing")
    let shard = plan.activationShards[shardIndex]
    if shard.peerId != receipt.peerId || shard.shardHash != receipt.outputPayloadHash:
        return Err[bool]("distributed inference receipt: shard binding")
    let expectedInputHash = DistributedShardDispatchExpectedInputHash(plan, shard, receipt.kernelHash)
    if IsErr(expectedInputHash):
        return Err[bool](Error(expectedInputHash))
    if receipt.inputHash != Value(expectedInputHash):
        return Err[bool]("distributed inference receipt: input hash")
    let payloadIndex = DistributedFindActivationPayload(store, receipt.shardName)
    if payloadIndex == -2:
        return Err[bool]("distributed inference receipt: duplicate payload")
    if payloadIndex < 0:
        return Err[bool]("distributed inference receipt: payload missing")
    if store.payloads[payloadIndex].sourcePeerId != receipt.peerId ||
       store.payloads[payloadIndex].payloadHash != receipt.outputPayloadHash:
        return Err[bool]("distributed inference receipt: payload binding")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardExecutionReceiptSet(plan: DistributedInferencePlan,
                                               peers: DistributedInferencePeer[],
                                               envelopes: activation_transport.ActivationEnvelope[],
                                               store: activation_transport.ActivationTensorStore,
                                               set: DistributedShardExecutionReceiptSet): Result[bool] =
    let transportOk = DistributedValidateActivationTransport(plan, peers, envelopes)
    if IsErr(transportOk):
        return Err[bool](Error(transportOk))
    let storeOk = activation_transport.ActivationTransportValidateTensorStore(envelopes, store)
    if IsErr(storeOk):
        return Err[bool](Error(storeOk))
    if set.schema != DistributedShardExecutionReceiptSetSchema:
        return Err[bool]("distributed inference receipt set: schema")
    if set.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference receipt set: plan hash")
    if set.receipts.len != plan.activationShards.len:
        return Err[bool]("distributed inference receipt set: count")
    for i in 0..<set.receipts.len:
        for j in i + 1..<set.receipts.len:
            if set.receipts[i].shardName == set.receipts[j].shardName:
                return Err[bool]("distributed inference receipt set: duplicate shard")
        let receiptOk = DistributedValidateShardExecutionReceipt(plan, peers, store, set.receipts[i])
        if IsErr(receiptOk):
            return Err[bool](Error(receiptOk))
    for i in 0..<plan.activationShards.len:
        var found: bool
        found = false
        for j in 0..<set.receipts.len:
            if set.receipts[j].shardName == plan.activationShards[i].shardName:
                found = true
        if !found:
            return Err[bool]("distributed inference receipt set: missing shard")
    if DistributedShardExecutionReceiptSetHash(set) != set.receiptSetHash:
        return Err[bool]("distributed inference receipt set: hash mismatch")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardDispatchResponse(plan: DistributedInferencePlan,
                                            peers: DistributedInferencePeer[],
                                            store: activation_transport.ActivationTensorStore,
                                            requests: DistributedShardDispatchRequestSet,
                                            receipts: DistributedShardExecutionReceiptSet,
                                            response: DistributedShardDispatchResponse): Result[bool] =
    if response.schema != DistributedShardDispatchResponseSchema:
        return Err[bool]("distributed inference dispatch response: schema")
    if response.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference dispatch response: plan hash")
    if response.requestHash <= int64(0) || response.payloadHash <= int64(0) ||
       response.receiptHash <= int64(0) || response.elapsedNs <= int64(0):
        return Err[bool]("distributed inference dispatch response: hashes")
    if response.peerId == "" || response.deviceCapabilityHash == "" || response.shardName == "":
        return Err[bool]("distributed inference dispatch response: identity")
    if DistributedShardDispatchResponseHash(response) != response.responseHash:
        return Err[bool]("distributed inference dispatch response: hash mismatch")
    let requestIndex = DistributedFindDispatchRequestByHash(requests, response.requestHash)
    if requestIndex == -2:
        return Err[bool]("distributed inference dispatch response: duplicate request")
    if requestIndex < 0:
        return Err[bool]("distributed inference dispatch response: request missing")
    let request = requests.requests[requestIndex]
    if response.peerId != request.peerId || response.deviceCapabilityHash != request.deviceCapabilityHash ||
       response.shardName != request.shardName || response.payloadHash != request.expectedOutputPayloadHash:
        return Err[bool]("distributed inference dispatch response: request binding")
    let payloadIndex = DistributedFindActivationPayload(store, response.shardName)
    if payloadIndex == -2:
        return Err[bool]("distributed inference dispatch response: duplicate payload")
    if payloadIndex < 0:
        return Err[bool]("distributed inference dispatch response: payload missing")
    if store.payloads[payloadIndex].sourcePeerId != response.peerId ||
       store.payloads[payloadIndex].payloadHash != response.payloadHash:
        return Err[bool]("distributed inference dispatch response: payload binding")
    let receiptIndex = DistributedFindReceiptByShard(receipts, response.shardName)
    if receiptIndex == -2:
        return Err[bool]("distributed inference dispatch response: duplicate receipt")
    if receiptIndex < 0:
        return Err[bool]("distributed inference dispatch response: receipt missing")
    let receipt = receipts.receipts[receiptIndex]
    if receipt.receiptHash != response.receiptHash ||
       receipt.peerId != response.peerId ||
       receipt.deviceCapabilityHash != response.deviceCapabilityHash ||
       receipt.shardName != response.shardName ||
       receipt.outputPayloadHash != response.payloadHash ||
       receipt.inputHash != request.inputHash ||
       receipt.kernelHash != request.kernelHash ||
       receipt.elapsedNs != response.elapsedNs:
        return Err[bool]("distributed inference dispatch response: receipt binding")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardDispatchResponseSet(plan: DistributedInferencePlan,
                                               peers: DistributedInferencePeer[],
                                               envelopes: activation_transport.ActivationEnvelope[],
                                               store: activation_transport.ActivationTensorStore,
                                               requests: DistributedShardDispatchRequestSet,
                                               responses: DistributedShardDispatchResponseSet,
                                               receipts: DistributedShardExecutionReceiptSet): Result[bool] =
    let requestOk = DistributedValidateShardDispatchRequestSet(plan, peers, requests)
    if IsErr(requestOk):
        return Err[bool](Error(requestOk))
    let receiptOk = DistributedValidateShardExecutionReceiptSet(plan, peers, envelopes, store, receipts)
    if IsErr(receiptOk):
        return Err[bool](Error(receiptOk))
    if responses.schema != DistributedShardDispatchResponseSetSchema:
        return Err[bool]("distributed inference dispatch response set: schema")
    if responses.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference dispatch response set: plan hash")
    if responses.responses.len != requests.requests.len:
        return Err[bool]("distributed inference dispatch response set: count")
    for i in 0..<responses.responses.len:
        for j in i + 1..<responses.responses.len:
            if responses.responses[i].shardName == responses.responses[j].shardName ||
               responses.responses[i].requestHash == responses.responses[j].requestHash:
                return Err[bool]("distributed inference dispatch response set: duplicate")
        let responseOk = DistributedValidateShardDispatchResponse(
            plan,
            peers,
            store,
            requests,
            receipts,
            responses.responses[i]
        )
        if IsErr(responseOk):
            return Err[bool](Error(responseOk))
    for i in 0..<requests.requests.len:
        var found: bool
        found = false
        for j in 0..<responses.responses.len:
            if responses.responses[j].requestHash == requests.requests[i].requestHash:
                found = true
        if !found:
            return Err[bool]("distributed inference dispatch response set: missing request")
    if DistributedShardDispatchResponseSetHash(responses) != responses.responseSetHash:
        return Err[bool]("distributed inference dispatch response set: hash mismatch")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardTransportFrameBase(plan: DistributedInferencePlan,
                                              frame: DistributedShardTransportFrame): Result[bool] =
    if frame.schema != DistributedShardTransportFrameSchema:
        return Err[bool]("distributed inference transport frame: schema")
    if frame.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference transport frame: plan hash")
    if frame.frameKind != DistributedTransportFrameKindRequest &&
       frame.frameKind != DistributedTransportFrameKindResponse:
        return Err[bool]("distributed inference transport frame: kind")
    if frame.coordinatorPeerId == "" || frame.sourcePeerId == "" ||
       frame.targetPeerId == "" || frame.shardName == "":
        return Err[bool]("distributed inference transport frame: identity")
    if frame.requestHash <= int64(0) || frame.payloadHash <= int64(0) ||
       frame.sentAtNs <= int64(0):
        return Err[bool]("distributed inference transport frame: fields")
    if DistributedShardTransportFrameHash(frame) != frame.frameHash:
        return Err[bool]("distributed inference transport frame: hash mismatch")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardTransportRequestFrame(plan: DistributedInferencePlan,
                                                 request: DistributedShardDispatchRequest,
                                                 frame: DistributedShardTransportFrame): Result[bool] =
    let baseOk = DistributedValidateShardTransportFrameBase(plan, frame)
    if IsErr(baseOk):
        return Err[bool](Error(baseOk))
    if frame.frameKind != DistributedTransportFrameKindRequest:
        return Err[bool]("distributed inference transport request frame: kind")
    if frame.coordinatorPeerId != request.coordinatorPeerId ||
       frame.sourcePeerId != request.coordinatorPeerId ||
       frame.targetPeerId != request.peerId ||
       frame.shardName != request.shardName ||
       frame.requestHash != request.requestHash ||
       frame.payloadHash != request.expectedOutputPayloadHash:
        return Err[bool]("distributed inference transport request frame: binding")
    if frame.responseHash != int64(0) || frame.envelopeHash != int64(0) ||
       frame.receiptHash != int64(0):
        return Err[bool]("distributed inference transport request frame: response fields")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardTransportResponseFrame(plan: DistributedInferencePlan,
                                                  request: DistributedShardDispatchRequest,
                                                  response: DistributedShardDispatchResponse,
                                                  envelope: activation_transport.ActivationEnvelope,
                                                  frame: DistributedShardTransportFrame): Result[bool] =
    let baseOk = DistributedValidateShardTransportFrameBase(plan, frame)
    if IsErr(baseOk):
        return Err[bool](Error(baseOk))
    if frame.frameKind != DistributedTransportFrameKindResponse:
        return Err[bool]("distributed inference transport response frame: kind")
    if frame.coordinatorPeerId != request.coordinatorPeerId ||
       frame.sourcePeerId != response.peerId ||
       frame.targetPeerId != request.coordinatorPeerId ||
       frame.shardName != response.shardName ||
       frame.requestHash != request.requestHash ||
       frame.responseHash != response.responseHash ||
       frame.envelopeHash != envelope.envelopeHash ||
       frame.payloadHash != response.payloadHash ||
       frame.receiptHash != response.receiptHash:
        return Err[bool]("distributed inference transport response frame: binding")
    if frame.responseHash <= int64(0) || frame.envelopeHash <= int64(0) ||
       frame.receiptHash <= int64(0):
        return Err[bool]("distributed inference transport response frame: fields")
    return Ok[bool](true)

@borrows
fn DistributedValidateShardTransportFrameSet(plan: DistributedInferencePlan,
                                             peers: DistributedInferencePeer[],
                                             envelopes: activation_transport.ActivationEnvelope[],
                                             store: activation_transport.ActivationTensorStore,
                                             requests: DistributedShardDispatchRequestSet,
                                             responses: DistributedShardDispatchResponseSet,
                                             receipts: DistributedShardExecutionReceiptSet,
                                             frames: DistributedShardTransportFrameSet): Result[bool] =
    let responseOk = DistributedValidateShardDispatchResponseSet(
        plan,
        peers,
        envelopes,
        store,
        requests,
        responses,
        receipts
    )
    if IsErr(responseOk):
        return Err[bool](Error(responseOk))
    if frames.schema != DistributedShardTransportFrameSetSchema:
        return Err[bool]("distributed inference transport frame set: schema")
    if frames.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference transport frame set: plan hash")
    if frames.frames.len != requests.requests.len * 2:
        return Err[bool]("distributed inference transport frame set: count")
    for i in 0..<frames.frames.len:
        if frames.frames[i].seqNo != uint64(i):
            return Err[bool]("distributed inference transport frame set: sequence")
        for j in i + 1..<frames.frames.len:
            if frames.frames[i].frameHash == frames.frames[j].frameHash:
                return Err[bool]("distributed inference transport frame set: duplicate hash")
    for i in 0..<requests.requests.len:
        let request = requests.requests[i]
        let requestFrameIndex = DistributedFindTransportFrame(
            frames,
            DistributedTransportFrameKindRequest,
            request.requestHash
        )
        if requestFrameIndex == -2:
            return Err[bool]("distributed inference transport frame set: duplicate request")
        if requestFrameIndex < 0:
            return Err[bool]("distributed inference transport frame set: missing request")
        let requestFrameOk = DistributedValidateShardTransportRequestFrame(
            plan,
            request,
            frames.frames[requestFrameIndex]
        )
        if IsErr(requestFrameOk):
            return Err[bool](Error(requestFrameOk))
        var responseFound: int32 = -1
        for r in 0..<responses.responses.len:
            if responses.responses[r].requestHash == request.requestHash:
                if responseFound >= 0:
                    return Err[bool]("distributed inference transport frame set: duplicate response")
                responseFound = r
        if responseFound < 0:
            return Err[bool]("distributed inference transport frame set: missing response")
        let envelopeIndex = DistributedFindActivationEnvelope(envelopes, request.shardName)
        if envelopeIndex == -2:
            return Err[bool]("distributed inference transport frame set: duplicate envelope")
        if envelopeIndex < 0:
            return Err[bool]("distributed inference transport frame set: missing envelope")
        let responseFrameIndex = DistributedFindTransportFrame(
            frames,
            DistributedTransportFrameKindResponse,
            request.requestHash
        )
        if responseFrameIndex == -2:
            return Err[bool]("distributed inference transport frame set: duplicate response frame")
        if responseFrameIndex < 0:
            return Err[bool]("distributed inference transport frame set: missing response frame")
        let responseFrameOk = DistributedValidateShardTransportResponseFrame(
            plan,
            request,
            responses.responses[responseFound],
            envelopes[envelopeIndex],
            frames.frames[responseFrameIndex]
        )
        if IsErr(responseFrameOk):
            return Err[bool](Error(responseFrameOk))
    if DistributedShardTransportFrameSetHash(frames) != frames.frameSetHash:
        return Err[bool]("distributed inference transport frame set: hash mismatch")
    return Ok[bool](true)

@borrows
fn DistributedActivationEvidenceHash(envelopes: activation_transport.ActivationEnvelope[],
                                     store: activation_transport.ActivationTensorStore,
                                     evidence: DistributedActivationEvidence): Result[int64] =
    let transportHash = activation_transport.ActivationTransportExecutionHash(envelopes, store)
    if IsErr(transportHash):
        return Err[int64](Error(transportHash))
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, evidence.schema)
    h = DistributedHashStep(h, evidence.enginePlanHash)
    h = DistributedHashStep(h, Value(transportHash))
    h = DistributedHashStep(h, evidence.requests.requestSetHash)
    h = DistributedHashStep(h, evidence.responses.responseSetHash)
    h = DistributedHashStep(h, evidence.receipts.receiptSetHash)
    h = DistributedHashStep(h, evidence.transportFrames.frameSetHash)
    if h <= int64(0):
        return Err[int64]("distributed inference: activation evidence hash")
    return Ok[int64](h)

fn DistributedActivationEvidenceBuild(enginePlanHash: int64,
                                      requests: DistributedShardDispatchRequestSet,
                                      responses: DistributedShardDispatchResponseSet,
                                      receipts: DistributedShardExecutionReceiptSet,
                                      frames: DistributedShardTransportFrameSet): DistributedActivationEvidence =
    var evidence = DistributedActivationEvidence(
        schema: DistributedActivationEvidenceSchema,
        enginePlanHash: enginePlanHash,
        requests: requests,
        responses: responses,
        receipts: receipts,
        transportFrames: frames,
        evidenceHash: int64(0)
    )
    return evidence

@borrows
fn DistributedValidateActivationEvidence(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[],
                                         envelopes: activation_transport.ActivationEnvelope[],
                                         store: activation_transport.ActivationTensorStore,
                                         evidence: DistributedActivationEvidence): Result[bool] =
    if evidence.schema != DistributedActivationEvidenceSchema:
        return Err[bool]("distributed inference activation evidence: schema")
    if evidence.enginePlanHash != plan.engineHash:
        return Err[bool]("distributed inference activation evidence: plan hash")
    let frameOk = DistributedValidateShardTransportFrameSet(
        plan,
        peers,
        envelopes,
        store,
        evidence.requests,
        evidence.responses,
        evidence.receipts,
        evidence.transportFrames
    )
    if IsErr(frameOk):
        return Err[bool](Error(frameOk))
    let expected = DistributedActivationEvidenceHash(envelopes, store, evidence)
    if IsErr(expected):
        return Err[bool](Error(expected))
    if Value(expected) != evidence.evidenceHash:
        return Err[bool]("distributed inference activation evidence: hash mismatch")
    return Ok[bool](true)

@borrows
fn DistributedActivationEvidenceSeal(envelopes: activation_transport.ActivationEnvelope[],
                                     store: activation_transport.ActivationTensorStore,
                                     draft: DistributedActivationEvidence): Result[DistributedActivationEvidence] =
    var evidence = draft
    evidence.schema = DistributedActivationEvidenceSchema
    evidence.evidenceHash = int64(0)
    let h = DistributedActivationEvidenceHash(envelopes, store, evidence)
    if IsErr(h):
        return Err[DistributedActivationEvidence](Error(h))
    evidence.evidenceHash = Value(h)
    return Ok[DistributedActivationEvidence](evidence)

@borrows
fn DistributedBuildReceiptWithOutput(plan: DistributedInferencePlan,
                                     status: str,
                                     weightStoreHash: int64,
                                     activationTransportHash: int64,
                                     outputHash: int64,
                                     elapsedNs: int64): execution_receipt.InferenceExecutionReceipt =
    return execution_receipt.InferenceExecutionReceiptBuild(
        strings.CloneStr(plan.modelGraph.modelCid),
        plan.engineHash,
        plan.partitionPlan.planHash,
        DistributedKernelSetHash(plan.kernelPrograms),
        plan.kvReceipt.pageTableHash,
        plan.kvShardReceipts.receiptSetHash,
        plan.routePlanSet.routeSetHash,
        weightStoreHash,
        activationTransportHash,
        outputHash,
        elapsedNs,
        status
    )

fn DistributedBuildReceipt(plan: DistributedInferencePlan, status: str): execution_receipt.InferenceExecutionReceipt =
    return DistributedBuildReceiptWithOutput(plan, status, int64(0), int64(0), int64(0), int64(0))

@borrows
fn DistributedValidateActivationTransport(plan: DistributedInferencePlan,
                                          peers: DistributedInferencePeer[],
                                          envelopes: activation_transport.ActivationEnvelope[]): Result[bool] =
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[bool](Error(planOk))
    if envelopes.len != plan.activationShards.len:
        return Err[bool]("distributed inference: activation transport coverage")
    let chainOk = activation_transport.ActivationTransportValidateChain(envelopes)
    if IsErr(chainOk):
        return Err[bool](Error(chainOk))
    for i in 0..<envelopes.len:
        if envelopes[i].enginePlanHash != plan.engineHash:
            return Err[bool]("distributed inference: activation transport plan hash")
        if !DistributedPeerReady(peers, envelopes[i].sourcePeerId):
            return Err[bool]("distributed inference: activation transport source")
        if !DistributedPeerReady(peers, envelopes[i].targetPeerId):
            return Err[bool]("distributed inference: activation transport target")
        let shardIndex = DistributedFindActivationShard(plan, envelopes[i].shardName)
        if shardIndex < 0:
            return Err[bool]("distributed inference: activation transport shard")
        let shard = plan.activationShards[shardIndex]
        if envelopes[i].sourcePeerId != shard.peerId:
            return Err[bool]("distributed inference: activation transport owner")
        if envelopes[i].tokenStart != shard.tokenStart || envelopes[i].tokenCount != shard.tokenCount:
            return Err[bool]("distributed inference: activation transport token span")
        if envelopes[i].featureStart != shard.featureStart || envelopes[i].featureCount != shard.featureCount:
            return Err[bool]("distributed inference: activation transport feature span")
        if envelopes[i].payloadHash != shard.shardHash:
            return Err[bool]("distributed inference: activation transport payload")
    return Ok[bool](true)

@borrows
fn DistributedValidateWeightStore(plan: DistributedInferencePlan,
                                  store: weight_store.WeightTensorStore): Result[bool] =
    return weight_store.WeightTensorValidateStore(store, plan.weightBindings, plan.modelGraph)

@borrows
fn DistributedTensorOutputHash(tensor: infer.TensorQ): Result[int64] =
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[int64](Error(tensorOk))
    var h: int64 = int64(67)
    h = DistributedHashStep(h, int64(tensor.scale))
    for i in 0..<tensor.shape.len:
        h = DistributedHashStep(h, int64(tensor.shape[i]))
    for i in 0..<tensor.data.len:
        h = DistributedHashStep(h, int64(tensor.data[i]))
    if h <= int64(0):
        return Err[int64]("distributed inference: output hash")
    return Ok[int64](h)

@borrows
fn DistributedModelExecutorOutputHash(output: model_executor.ModelExecutorOutput): Result[int64] =
    let logitsHash = DistributedTensorOutputHash(output.logits)
    if IsErr(logitsHash):
        return Err[int64](Error(logitsHash))
    let routeOk = moe_router.MoeValidateRoutePlan(output.routePlan)
    if IsErr(routeOk):
        return Err[int64](Error(routeOk))
    let routeSetOk = moe_router.MoeValidateRoutePlanSet(output.routePlanSet)
    if IsErr(routeSetOk):
        return Err[int64](Error(routeSetOk))
    if output.executionHash <= int64(0):
        return Err[int64]("distributed inference: model execution hash")
    var h: int64 = int64(67)
    h = DistributedHashTextWith(h, "cheng.inference.model_executor_output.v1")
    h = DistributedHashStep(h, Value(logitsHash))
    h = DistributedHashStep(h, output.routePlan.routeHash)
    h = DistributedHashStep(h, output.routePlanSet.routeSetHash)
    h = DistributedHashStep(h, output.executionHash)
    if h <= int64(0):
        return Err[int64]("distributed inference: model executor output hash")
    return Ok[int64](h)

@borrows
fn DistributedAllGatherActivationTensorFill(out: var infer.TensorQ,
                                            plan: DistributedInferencePlan,
                                            peers: DistributedInferencePeer[],
                                            envelopes: activation_transport.ActivationEnvelope[],
                                            activationStore: activation_transport.ActivationTensorStore): Result[bool] =
    let transportOk = DistributedValidateActivationTransport(plan, peers, envelopes)
    if IsErr(transportOk):
        return Err[bool](Error(transportOk))
    return activation_transport.ActivationTensorAllGatherFill(
        out,
        envelopes,
        activationStore,
        plan.routePlan.tokenCount,
        plan.modelGraph.hiddenSize
    )

@borrows
fn DistributedPlanFacts(plan: DistributedInferencePlan): str[] =
    var out: str[]
    add(out, strutil.Join(["distributed_schema=", share(plan.schema)], ""))
    add(out, strutil.Join(["distributed_engine_cid=", share(plan.engineCid)], ""))
    add(out, strutil.Join(["distributed_model_cid=", share(plan.modelGraph.modelCid)], ""))
    add(out, strutil.Join(["distributed_plan_hash=", strings.Int64ToStr(plan.engineHash)], ""))
    add(out, strutil.Join(["distributed_weight_binding_hash=", strings.Int64ToStr(plan.weightBindings.bindingHash)], ""))
    add(out, strutil.Join(["distributed_device_weight_binding_hash=", strings.Int64ToStr(plan.deviceWeightBindingHash)], ""))
    add(out, strutil.Join(["distributed_kernel_set_hash=", strings.Int64ToStr(DistributedKernelSetHash(plan.kernelPrograms))], ""))
    add(out, strutil.Join(["distributed_kv_page_table_hash=", strings.Int64ToStr(plan.kvReceipt.pageTableHash)], ""))
    add(out, strutil.Join(["distributed_kv_state_hash=", strings.Int64ToStr(plan.kvStateHash)], ""))
    add(out, strutil.Join(["distributed_kv_shard_receipt_set_hash=", strings.Int64ToStr(plan.kvShardReceipts.receiptSetHash)], ""))
    for i in 0..<plan.kvShardReceipts.receipts.len:
        add(out, strutil.Join([
            "distributed_kv_shard_receipt=",
            strings.Int64ToStr(int64(plan.kvShardReceipts.receipts[i].layerIndex)),
            ":",
            plan.kvShardReceipts.receipts[i].ownerPeerId,
            ":",
            strings.Int64ToStr(plan.kvShardReceipts.receipts[i].receiptHash)
        ], ""))
    add(out, strutil.Join(["distributed_spec_decode_hash=", strings.Int64ToStr(plan.specDecodePlan.planHash)], ""))
    add(out, strutil.Join(["distributed_spec_decode_algorithm=", share(plan.specDecodePlan.algorithm)], ""))
    add(out, strutil.Join(["distributed_router_hash=", strings.Int64ToStr(plan.routePlan.routeHash)], ""))
    add(out, strutil.Join(["distributed_route_set_hash=", strings.Int64ToStr(plan.routePlanSet.routeSetHash)], ""))
    for i in 0..<plan.activationShards.len:
        add(out, strutil.Join([
            "distributed_activation_shard=",
            plan.activationShards[i].shardName,
            ":",
            plan.activationShards[i].peerId,
            ":",
            strings.Int64ToStr(plan.activationShards[i].shardHash)
        ], ""))
    return out

@borrows
fn DistributedPlanOnly(plan: DistributedInferencePlan,
                       peers: DistributedInferencePeer[]): Result[DistributedInferenceRunResult] =
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedInferenceRunResult](Error(planOk))
    let plannedReceipt = DistributedBuildReceipt(plan, execution_receipt.InferenceExecutionStatusPlanned)
    let receiptOk = execution_receipt.InferenceExecutionReceiptValidate(plannedReceipt)
    if IsErr(receiptOk):
        return Err[DistributedInferenceRunResult](Error(receiptOk))
    return Ok[DistributedInferenceRunResult](DistributedInferenceRunResult(
        accepted: true,
        failureReason: "",
        receipt: plannedReceipt,
        traceFacts: DistributedPlanFacts(plan)
    ))

@borrows
fn DistributedExecuteHardFail(plan: DistributedInferencePlan,
                              peers: DistributedInferencePeer[],
                              reason: str): Result[DistributedInferenceRunResult] =
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedInferenceRunResult](Error(planOk))
    if reason == "":
        return Err[DistributedInferenceRunResult](DistributedInferenceFailureInvalidPlan)
    let failedReceipt = DistributedBuildReceipt(plan, execution_receipt.InferenceExecutionStatusHardFail)
    let receiptOk = execution_receipt.InferenceExecutionReceiptValidate(failedReceipt)
    if IsErr(receiptOk):
        return Err[DistributedInferenceRunResult](Error(receiptOk))
    var trace = DistributedPlanFacts(plan)
    add(trace, strutil.Join(["distributed_failure=", share(reason)], ""))
    return Ok[DistributedInferenceRunResult](DistributedInferenceRunResult(
        accepted: false,
        failureReason: reason,
        receipt: failedReceipt,
        traceFacts: trace
    ))

@borrows
fn DistributedAcceptOutputHash(plan: DistributedInferencePlan,
                               peers: DistributedInferencePeer[],
                               envelopes: activation_transport.ActivationEnvelope[],
                               activationStore: activation_transport.ActivationTensorStore,
                               evidence: DistributedActivationEvidence,
                               store: weight_store.WeightTensorStore,
                               output: infer.TensorQ,
                               outputHash: int64,
                               elapsedNs: int64): Result[DistributedInferenceRunResult] =
    let ordinaryOk = DistributedRequireOrdinaryDecodeExecution(plan, "output_accept")
    if IsErr(ordinaryOk):
        return Err[DistributedInferenceRunResult](Error(ordinaryOk))
    let transportOk = DistributedValidateActivationTransport(plan, peers, envelopes)
    if IsErr(transportOk):
        return Err[DistributedInferenceRunResult](Error(transportOk))
    let weightStoreOk = DistributedValidateWeightStore(plan, store)
    if IsErr(weightStoreOk):
        return Err[DistributedInferenceRunResult](Error(weightStoreOk))
    let activationStoreOk = activation_transport.ActivationTransportValidateTensorStore(envelopes, activationStore)
    if IsErr(activationStoreOk):
        return Err[DistributedInferenceRunResult](Error(activationStoreOk))
    let evidenceOk = DistributedValidateActivationEvidence(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence
    )
    if IsErr(evidenceOk):
        return Err[DistributedInferenceRunResult](Error(evidenceOk))
    var gatheredActivation: infer.TensorQ
    let gatherOk = DistributedAllGatherActivationTensorFill(gatheredActivation, plan, peers, envelopes, activationStore)
    if IsErr(gatherOk):
        return Err[DistributedInferenceRunResult](Error(gatherOk))
    let gatheredHashRes = DistributedTensorOutputHash(gatheredActivation)
    if IsErr(gatheredHashRes):
        return Err[DistributedInferenceRunResult](Error(gatheredHashRes))
    let evidenceHashRes = DistributedActivationEvidenceHash(envelopes, activationStore, evidence)
    if IsErr(evidenceHashRes):
        return Err[DistributedInferenceRunResult](Error(evidenceHashRes))
    if elapsedNs <= int64(0):
        return Err[DistributedInferenceRunResult]("distributed inference: elapsed ns")
    let outputTensorHash = DistributedTensorOutputHash(output)
    if IsErr(outputTensorHash):
        return Err[DistributedInferenceRunResult](Error(outputTensorHash))
    if outputHash <= int64(0):
        return Err[DistributedInferenceRunResult]("distributed inference: output hash")
    let executedReceipt = DistributedBuildReceiptWithOutput(
        plan,
        execution_receipt.InferenceExecutionStatusExecuted,
        store.storeHash,
        Value(evidenceHashRes),
        outputHash,
        elapsedNs
    )
    let receiptOk = execution_receipt.InferenceExecutionReceiptValidate(executedReceipt)
    if IsErr(receiptOk):
        return Err[DistributedInferenceRunResult](Error(receiptOk))
    var trace = DistributedPlanFacts(plan)
    let weightFacts = weight_store.WeightTensorStoreFacts(store)
    for i in 0..<weightFacts.len:
        add(trace, weightFacts[i])
    let transportFacts = activation_transport.ActivationTransportFacts(envelopes)
    for i in 0..<transportFacts.len:
        add(trace, transportFacts[i])
    let activationStoreFacts = activation_transport.ActivationTensorStoreFacts(activationStore)
    for i in 0..<activationStoreFacts.len:
        add(trace, activationStoreFacts[i])
    add(trace, strutil.Join(["distributed_activation_gather_hash=", strings.Int64ToStr(Value(gatheredHashRes))], ""))
    add(trace, strutil.Join(["distributed_shard_dispatch_request_set_hash=", strings.Int64ToStr(evidence.requests.requestSetHash)], ""))
    add(trace, strutil.Join(["distributed_shard_dispatch_response_set_hash=", strings.Int64ToStr(evidence.responses.responseSetHash)], ""))
    add(trace, strutil.Join(["distributed_shard_execution_receipt_set_hash=", strings.Int64ToStr(evidence.receipts.receiptSetHash)], ""))
    add(trace, strutil.Join(["distributed_shard_transport_frame_set_hash=", strings.Int64ToStr(evidence.transportFrames.frameSetHash)], ""))
    add(trace, strutil.Join(["distributed_activation_evidence_hash=", strings.Int64ToStr(Value(evidenceHashRes))], ""))
    add(trace, strutil.Join(["distributed_output_tensor_hash=", strings.Int64ToStr(Value(outputTensorHash))], ""))
    add(trace, strutil.Join(["distributed_output_hash=", strings.Int64ToStr(outputHash)], ""))
    return Ok[DistributedInferenceRunResult](DistributedInferenceRunResult(
        accepted: true,
        failureReason: "",
        receipt: executedReceipt,
        traceFacts: trace
    ))

fn DistributedAcceptOutputTensor(plan: DistributedInferencePlan,
                                 peers: DistributedInferencePeer[],
                                 envelopes: activation_transport.ActivationEnvelope[],
                                 activationStore: activation_transport.ActivationTensorStore,
                                 evidence: DistributedActivationEvidence,
                                 store: weight_store.WeightTensorStore,
                                 output: infer.TensorQ,
                                 elapsedNs: int64): Result[DistributedInferenceRunResult] =
    let outputHash = DistributedTensorOutputHash(output)
    if IsErr(outputHash):
        return Err[DistributedInferenceRunResult](Error(outputHash))
    return DistributedAcceptOutputHash(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence,
        store,
        output,
        Value(outputHash),
        elapsedNs
    )

fn DistributedAcceptModelExecutorOutput(plan: DistributedInferencePlan,
                                        peers: DistributedInferencePeer[],
                                        envelopes: activation_transport.ActivationEnvelope[],
                                        activationStore: activation_transport.ActivationTensorStore,
                                        evidence: DistributedActivationEvidence,
                                        store: weight_store.WeightTensorStore,
                                        output: model_executor.ModelExecutorOutput,
                                        elapsedNs: int64): Result[DistributedInferenceRunResult] =
    if output.routePlan.routeHash != plan.routePlan.routeHash:
        return Err[DistributedInferenceRunResult]("distributed inference: model route hash")
    if output.routePlanSet.routeSetHash != plan.routePlanSet.routeSetHash:
        return Err[DistributedInferenceRunResult]("distributed inference: model route set hash")
    let outputHash = DistributedModelExecutorOutputHash(output)
    if IsErr(outputHash):
        return Err[DistributedInferenceRunResult](Error(outputHash))
    let accepted = DistributedAcceptOutputHash(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence,
        store,
        output.logits,
        Value(outputHash),
        elapsedNs
    )
    if IsErr(accepted):
        return Err[DistributedInferenceRunResult](Error(accepted))
    var out = Value(accepted)
    let modelFacts = model_executor.ModelExecutorFacts(output)
    for i in 0..<modelFacts.len:
        add(out.traceFacts, modelFacts[i])
    return Ok[DistributedInferenceRunResult](out)

@borrows
fn DistributedExecuteActivationAllGather(plan: DistributedInferencePlan,
                                         peers: DistributedInferencePeer[],
                                         envelopes: activation_transport.ActivationEnvelope[],
                                         activationStore: activation_transport.ActivationTensorStore,
                                         evidence: DistributedActivationEvidence,
                                         store: weight_store.WeightTensorStore,
                                         elapsedNs: int64): Result[DistributedInferenceRunResult] =
    let ordinaryOk = DistributedRequireOrdinaryDecodeExecution(plan, "activation_all_gather")
    if IsErr(ordinaryOk):
        return Err[DistributedInferenceRunResult](Error(ordinaryOk))
    var gathered: infer.TensorQ
    let gatherOk = DistributedAllGatherActivationTensorFill(gathered, plan, peers, envelopes, activationStore)
    if IsErr(gatherOk):
        return Err[DistributedInferenceRunResult](Error(gatherOk))
    return DistributedAcceptOutputTensor(plan, peers, envelopes, activationStore, evidence, store, gathered, elapsedNs)

@borrows
fn DistributedExecuteAllGatherLmHead(plan: DistributedInferencePlan,
                                     peers: DistributedInferencePeer[],
                                     envelopes: activation_transport.ActivationEnvelope[],
                                     activationStore: activation_transport.ActivationTensorStore,
                                     evidence: DistributedActivationEvidence,
                                     store: weight_store.WeightTensorStore,
                                     elapsedNs: int64): Result[DistributedInferenceRunResult] =
    plan
    peers
    envelopes
    activationStore
    evidence
    store
    elapsedNs
    return Err[DistributedInferenceRunResult](
        "distributed inference lm_head: device execution required; CPU oracle is test-only"
    )

@borrows
fn DistributedExecuteAllGatherLmHeadMetal(plan: DistributedInferencePlan,
                                          peers: DistributedInferencePeer[],
                                          envelopes: activation_transport.ActivationEnvelope[],
                                          activationStore: activation_transport.ActivationTensorStore,
                                          evidence: DistributedActivationEvidence,
                                          store: weight_store.WeightTensorStore,
                                          metal: device.Device,
                                          elapsedNs: int64): Result[DistributedInferenceRunResult] =
    let ordinaryOk = DistributedRequireOrdinaryDecodeExecution(plan, "all_gather_lm_head_metal")
    if IsErr(ordinaryOk):
        return Err[DistributedInferenceRunResult](Error(ordinaryOk))
    let planOk = DistributedValidatePlan(plan, peers)
    if IsErr(planOk):
        return Err[DistributedInferenceRunResult](Error(planOk))
    if metal.backend != device.InferenceDeviceBackendMetal || !metal.ready:
        return Err[DistributedInferenceRunResult]("distributed inference lm_head metal: device")
    var gathered: infer.TensorQ
    let gatherOk = DistributedAllGatherActivationTensorFill(gathered, plan, peers, envelopes, activationStore)
    if IsErr(gatherOk):
        return Err[DistributedInferenceRunResult](Error(gatherOk))
    let lmHeadWeight = model_executor.ModelExecutorFindWeight(store, "lm_head.weight")
    if IsErr(lmHeadWeight):
        return Err[DistributedInferenceRunResult](Error(lmHeadWeight))
    let lmHead = Value(lmHeadWeight)
    if gathered.shape.len != 2 || lmHead.shape.len != 2 ||
       gathered.shape[0] != plan.routePlan.tokenCount ||
       gathered.shape[1] != plan.modelGraph.hiddenSize ||
       lmHead.shape[0] != plan.modelGraph.hiddenSize:
        return Err[DistributedInferenceRunResult]("distributed inference lm_head metal: shape")
    let program = kernel_ir.KernelIrGemmProgram(
        gathered.shape[0],
        lmHead.shape[1],
        gathered.shape[1],
        kernel_ir.KernelDtypeFp16,
        gathered.scale
    )
    var logits: infer.TensorQ
    let gatheredLoad = device.DeviceMetalLoadTensorI32Buffer(metal, gathered)
    if IsErr(gatheredLoad):
        return Err[DistributedInferenceRunResult](Error(gatheredLoad))
    let lmHeadLoad = device.DeviceMetalLoadTensorI32Buffer(metal, lmHead)
    if IsErr(lmHeadLoad):
        let _releaseGatheredAfterLmHeadLoadFail = device.DeviceMetalReleaseBuffer(Value(gatheredLoad).buffer)
        return Err[DistributedInferenceRunResult](Error(lmHeadLoad))
    let launchRes = device.DeviceMetalGemmBuffersFill(
        logits,
        metal,
        program,
        Value(gatheredLoad).buffer,
        Value(gatheredLoad).receipt,
        Value(lmHeadLoad).buffer,
        Value(lmHeadLoad).receipt
    )
    let releaseLmHead = device.DeviceMetalReleaseBuffer(Value(lmHeadLoad).buffer)
    let releaseGathered = device.DeviceMetalReleaseBuffer(Value(gatheredLoad).buffer)
    if IsErr(launchRes):
        return Err[DistributedInferenceRunResult](Error(launchRes))
    if IsErr(releaseLmHead):
        return Err[DistributedInferenceRunResult](Error(releaseLmHead))
    if IsErr(releaseGathered):
        return Err[DistributedInferenceRunResult](Error(releaseGathered))
    let acceptedRes = DistributedAcceptOutputTensor(
        plan,
        peers,
        envelopes,
        activationStore,
        evidence,
        store,
        logits,
        elapsedNs
    )
    if IsErr(acceptedRes):
        return Err[DistributedInferenceRunResult](Error(acceptedRes))
    var out = Value(acceptedRes)
    add(out.traceFacts, "distributed_execution_stage=all_gather_lm_head")
    add(out.traceFacts, "distributed_execution_device=metal")
    add(out.traceFacts, strutil.Join(["distributed_lm_head_kernel_hash=", strings.Int64ToStr(Value(launchRes).kernelHash)], ""))
    return Ok[DistributedInferenceRunResult](out)

