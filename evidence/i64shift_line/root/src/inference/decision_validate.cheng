# CSG 统一决策合同校验门 (任务 04 首切片)。
#
# 全部拒绝语义的唯一权威 (contract: docs/campaigns/2026-09-21-csg-decision-
# computer-use/contract.md §1/§3)。逐项拒绝:
#   NaN / 概率越界 / 分布不归一 / 过期世代 / 伪造索引引用 (越界/悬空/错类型槽) /
#   候选交换 (候选<->目标绑定不一致) / 销毁重建 (失效索引复用, 世代+索引双键) /
#   跨会话引用 / 按名寻址请求。
#
# 错误串首 token 与 contract.md §3 错误族一致; 冒号后是可区分判词,
# 每个拒绝项一个固定串, 不做消息拼接 (无内容相关的可变消息)。
# 校验失败一律显式 Err, 无任何兜底/截断/哨兵值。

import std/result
import cheng/core/runtime/csg_decision_contract as dc

# -------------------------------------------------------------------
# 概率值合同
# -------------------------------------------------------------------

fn DecisionValidateProbValue(p: dc.CsgDecisionProbValue): Result[bool] =
    let scale = dc.CsgDecisionProbScale(p.precision)
    if scale <= 0:
        return Err[bool]("InvalidOutput: decision prob precision out of range")
    if p.numer < 0 || p.numer > scale:
        return Err[bool]("InvalidOutput: decision prob numer out of range")
    return Ok[bool](true)

# 浮点入口 (learn 后端原始输出的唯一合法入口): NaN/负数/越界一律显式拒绝。
# 本后端不可靠面 (实测/已记录): f64ToBits/bitsToF64 位型绑定返回错误结果、
# int64(NaN) 铸 0 (非饱和 INT64_MIN)、裸 0.0 浮点比较、大整型字面量截断
# —— 因此判定全部避开这些:
# - NaN: IEEE754 自不等 (x != x); 有序比较对 NaN 恒假已实测成立,
#   随后的非负门对 NaN 也必然拒绝, 无放行通道。
# - 非负: math.cheng 验证过的移位比较形 (x+headroom >= headroom),
#   概率域 |x| <= 1 << headroom=1024, x<0 时恒假。
# - 值域: 定点重建后在整数域与声明精度标尺精确比较。
fn DecisionProbFromFloat64(x: float64, precision: int32): Result[dc.CsgDecisionProbValue] =
    let scale = dc.CsgDecisionProbScale(precision)
    if scale <= 0:
        return Err[dc.CsgDecisionProbValue]("InvalidOutput: decision prob precision out of range")
    if x != x:
        return Err[dc.CsgDecisionProbValue]("InvalidOutput: decision prob NaN")
    let nonNeg: bool = (x + 1024.0) >= 1024.0
    if !nonNeg:
        return Err[dc.CsgDecisionProbValue]("InvalidOutput: decision prob negative")
    let sf = float64(scale)
    let numer = int64(x * sf + 0.5)
    if numer < 0 || numer > scale:
        return Err[dc.CsgDecisionProbValue]("InvalidOutput: decision prob float out of range")
    return dc.CsgDecisionProbFromFixed(numer, precision)

# -------------------------------------------------------------------
# 引用合同: 槽位 (世代+索引 双键) 与跨节点列
# -------------------------------------------------------------------

# 槽位引用四步: 越界 -> 错类型槽 -> 行世代不匹配 (销毁重建) -> 世代过期。
fn decisionCheckSlotRef(graph: dc.CsgDecisionGraph, generation: int64,
                        index: int32, kind: int32): Result[bool] =
    if index < 0 || index >= graph.slots.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    if graph.slots[index].kind != kind:
        return Err[bool]("InvalidOutput: decision ref slot kind mismatch")
    if graph.slots[index].generation != generation:
        return Err[bool]("InvalidOutput: decision ref stale generation binding (destroy/rebuild)")
    if generation != graph.generation:
        return Err[bool]("InvalidOutput: decision ref expired generation")
    return Ok[bool](true)

fn decisionNodeRowCount(graph: dc.CsgDecisionGraph, kind: int32): int32 =
    if kind == dc.CsgDecisionRefKindObserve:
        return graph.observes.len
    if kind == dc.CsgDecisionRefKindDeterministic:
        return graph.deterministics.len
    if kind == dc.CsgDecisionRefKindLearn:
        return graph.learns.len
    if kind == dc.CsgDecisionRefKindAction:
        return graph.actions.len
    if kind == dc.CsgDecisionRefKindExecute:
        return graph.executes.len
    if kind == dc.CsgDecisionRefKindReceipt:
        return graph.receipts.len
    if kind == dc.CsgDecisionRefKindCandidate:
        return graph.candidates.len
    if kind == dc.CsgDecisionRefKindLearnResult:
        return graph.learnResults.len
    return 0 - 1

fn decisionNodeRowGeneration(graph: dc.CsgDecisionGraph, ref: dc.CsgDecisionRef): int64 =
    if ref.kind == dc.CsgDecisionRefKindObserve:
        return graph.observes[ref.index].generation
    if ref.kind == dc.CsgDecisionRefKindDeterministic:
        return graph.deterministics[ref.index].generation
    if ref.kind == dc.CsgDecisionRefKindLearn:
        return graph.learns[ref.index].generation
    if ref.kind == dc.CsgDecisionRefKindAction:
        return graph.actions[ref.index].generation
    if ref.kind == dc.CsgDecisionRefKindExecute:
        return graph.executes[ref.index].generation
    if ref.kind == dc.CsgDecisionRefKindReceipt:
        return graph.receipts[ref.index].generation
    if ref.kind == dc.CsgDecisionRefKindCandidate:
        return graph.candidates[ref.index].generation
    if ref.kind == dc.CsgDecisionRefKindLearnResult:
        return graph.learnResults[ref.index].generation
    return 0 - 1

fn decisionCheckNodeRef(graph: dc.CsgDecisionGraph, ref: dc.CsgDecisionRef): Result[bool] =
    let rowCount = decisionNodeRowCount(share(graph), ref.kind)
    if rowCount < 0:
        return Err[bool]("InvalidOutput: decision ref unknown kind")
    if ref.index < 0 || ref.index >= rowCount:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = decisionNodeRowGeneration(share(graph), ref)
    if rowGen != ref.generation:
        return Err[bool]("InvalidOutput: decision ref stale generation binding (destroy/rebuild)")
    if ref.generation != graph.generation:
        return Err[bool]("InvalidOutput: decision ref expired generation")
    return Ok[bool](true)

# 有类型引用句柄校验 (会话 -> 类 -> 槽位/节点四步)。
fn DecisionValidateRef(graph: dc.CsgDecisionGraph, ref: dc.CsgDecisionRef): Result[bool] =
    if ref.session != graph.session:
        return Err[bool]("InvalidOutput: decision ref cross-session")
    if ref.kind >= 1 && ref.kind <= 13:
        return decisionCheckSlotRef(share(graph), ref.generation, ref.index, ref.kind)
    if ref.kind >= 101 && ref.kind <= 108:
        return decisionCheckNodeRef(share(graph), ref)
    return Err[bool]("InvalidOutput: decision ref unknown kind")

# -------------------------------------------------------------------
# 逐类节点行校验
# -------------------------------------------------------------------

fn decisionValidateObserveAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    if index < 0 || index >= graph.observes.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = graph.observes[index].generation
    if rowGen != graph.generation:
        return Err[bool]("InvalidOutput: decision node expired generation")
    let a = decisionCheckSlotRef(share(graph), rowGen, graph.observes[index].snapshotRef, dc.CsgDecisionSlotKindSnapshot)
    if IsErr(a):
        return Err[bool](Error(a))
    let b = decisionCheckSlotRef(share(graph), rowGen, graph.observes[index].sourceReceiptRef, dc.CsgDecisionSlotKindReceipt)
    if IsErr(b):
        return Err[bool](Error(b))
    let c = decisionCheckSlotRef(share(graph), rowGen, graph.observes[index].evidenceRef, dc.CsgDecisionSlotKindEvidence)
    if IsErr(c):
        return Err[bool](Error(c))
    return Ok[bool](true)

fn decisionValidateDeterministicAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    if index < 0 || index >= graph.deterministics.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = graph.deterministics[index].generation
    if rowGen != graph.generation:
        return Err[bool]("InvalidOutput: decision node expired generation")
    let a = decisionCheckSlotRef(share(graph), rowGen, graph.deterministics[index].predicateRef, dc.CsgDecisionSlotKindPredicate)
    if IsErr(a):
        return Err[bool](Error(a))
    let b = decisionCheckSlotRef(share(graph), rowGen, graph.deterministics[index].actionModelRef, dc.CsgDecisionSlotKindActionModel)
    if IsErr(b):
        return Err[bool](Error(b))
    let c = decisionCheckSlotRef(share(graph), rowGen, graph.deterministics[index].budgetRef, dc.CsgDecisionSlotKindBudget)
    if IsErr(c):
        return Err[bool](Error(c))
    let d = decisionCheckSlotRef(share(graph), rowGen, graph.deterministics[index].evidenceRef, dc.CsgDecisionSlotKindEvidence)
    if IsErr(d):
        return Err[bool](Error(d))
    return Ok[bool](true)

fn decisionValidateLearnNodeAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    if index < 0 || index >= graph.learns.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = graph.learns[index].generation
    if rowGen != graph.generation:
        return Err[bool]("InvalidOutput: decision node expired generation")
    let headKind = graph.learns[index].headKind
    if headKind != dc.CsgDecisionHeadChoice && headKind != dc.CsgDecisionHeadNoul && headKind != dc.CsgDecisionHeadScore:
        return Err[bool]("InvalidOutput: decision learn node head kind unknown")
    let a = decisionCheckSlotRef(share(graph), rowGen, graph.learns[index].evidenceRef, dc.CsgDecisionSlotKindEvidence)
    if IsErr(a):
        return Err[bool](Error(a))
    let b = decisionCheckSlotRef(share(graph), rowGen, graph.learns[index].backendRef, dc.CsgDecisionSlotKindBackend)
    if IsErr(b):
        return Err[bool](Error(b))
    let setStart = graph.learns[index].candidateSetRef
    let setCount = graph.learns[index].candidateCount
    if setCount < 0 || setStart < 0 || setStart + setCount > graph.candidates.len:
        return Err[bool]("InvalidOutput: decision learn candidate set out of bounds")
    return Ok[bool](true)

fn decisionValidateActionAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    if index < 0 || index >= graph.actions.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = graph.actions[index].generation
    if rowGen != graph.generation:
        return Err[bool]("InvalidOutput: decision node expired generation")
    var cr: dc.CsgDecisionRef
    cr.session = graph.session
    cr.generation = rowGen
    cr.index = graph.actions[index].candidateRef
    cr.kind = dc.CsgDecisionRefKindCandidate
    let a = decisionCheckNodeRef(share(graph), cr)
    if IsErr(a):
        return Err[bool](Error(a))
    let b = decisionCheckSlotRef(share(graph), rowGen, graph.actions[index].authorizationRef, dc.CsgDecisionSlotKindAuthorization)
    if IsErr(b):
        return Err[bool](Error(b))
    let c = decisionCheckSlotRef(share(graph), rowGen, graph.actions[index].preconditionRef, dc.CsgDecisionSlotKindPrecondition)
    if IsErr(c):
        return Err[bool](Error(c))
    return Ok[bool](true)

fn decisionValidateExecuteAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    if index < 0 || index >= graph.executes.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = graph.executes[index].generation
    if rowGen != graph.generation:
        return Err[bool]("InvalidOutput: decision node expired generation")
    var ar: dc.CsgDecisionRef
    ar.session = graph.session
    ar.generation = rowGen
    ar.index = graph.executes[index].actionRef
    ar.kind = dc.CsgDecisionRefKindAction
    let a = decisionCheckNodeRef(share(graph), ar)
    if IsErr(a):
        return Err[bool](Error(a))
    let b = decisionCheckSlotRef(share(graph), rowGen, graph.executes[index].commitAuthorityRef, dc.CsgDecisionSlotKindCommitAuthority)
    if IsErr(b):
        return Err[bool](Error(b))
    return Ok[bool](true)

fn decisionValidateReceiptAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    if index < 0 || index >= graph.receipts.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = graph.receipts[index].generation
    if rowGen != graph.generation:
        return Err[bool]("InvalidOutput: decision node expired generation")
    var er: dc.CsgDecisionRef
    er.session = graph.session
    er.generation = rowGen
    er.index = graph.receipts[index].executionRef
    er.kind = dc.CsgDecisionRefKindExecute
    let a = decisionCheckNodeRef(share(graph), er)
    if IsErr(a):
        return Err[bool](Error(a))
    let b = decisionCheckSlotRef(share(graph), rowGen, graph.receipts[index].goalPredicateRef, dc.CsgDecisionSlotKindPredicate)
    if IsErr(b):
        return Err[bool](Error(b))
    return Ok[bool](true)

# 候选 = 完整动作元组: 逐字段槽位类校验 + 参数槽位逐个 Param 类校验。
fn DecisionValidateCandidateAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    if index < 0 || index >= graph.candidates.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = graph.candidates[index].generation
    if rowGen != graph.generation:
        return Err[bool]("InvalidOutput: decision node expired generation")
    let a = decisionCheckSlotRef(share(graph), rowGen, graph.candidates[index].goalRef, dc.CsgDecisionSlotKindGoal)
    if IsErr(a):
        return Err[bool](Error(a))
    let b = decisionCheckSlotRef(share(graph), rowGen, graph.candidates[index].operationRef, dc.CsgDecisionSlotKindActionModel)
    if IsErr(b):
        return Err[bool](Error(b))
    let c = decisionCheckSlotRef(share(graph), rowGen, graph.candidates[index].preconditionRef, dc.CsgDecisionSlotKindPrecondition)
    if IsErr(c):
        return Err[bool](Error(c))
    let d = decisionCheckSlotRef(share(graph), rowGen, graph.candidates[index].effectContractRef, dc.CsgDecisionSlotKindEffectContract)
    if IsErr(d):
        return Err[bool](Error(d))
    let slotCount = graph.candidates[index].paramSlots.len
    for j in 0..<slotCount:
        let e = decisionCheckSlotRef(share(graph), rowGen, graph.candidates[index].paramSlots[j], dc.CsgDecisionSlotKindParam)
        if IsErr(e):
            return Err[bool](Error(e))
    return Ok[bool](true)

# -------------------------------------------------------------------
# learn 判断结果合同 (Choice / Noul / Score)
# -------------------------------------------------------------------

# 声明精度下的归一合同: 同一分布内精度一致, 每个 numer 落在值域内,
# 总和恰好等于 10^precision (整数精确比较, 无浮点容差)。
fn decisionValidateDistributionAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    let n = graph.learnResults[index].probs.len
    if n < 1:
        return Err[bool]("InvalidOutput: decision prob distribution size mismatch")
    let precision = graph.learnResults[index].probs[0].precision
    let scale = dc.CsgDecisionProbScale(precision)
    if scale <= 0:
        return Err[bool]("InvalidOutput: decision prob precision out of range")
    var sum: int64 = 0
    for j in 0..<n:
        let p = graph.learnResults[index].probs[j]
        if p.precision != precision:
            return Err[bool]("InvalidOutput: decision prob precision mismatch within distribution")
        if p.numer < 0 || p.numer > scale:
            return Err[bool]("InvalidOutput: decision prob numer out of range")
        sum = sum + p.numer
    if sum != scale:
        return Err[bool]("InvalidOutput: decision prob distribution not normalized")
    return Ok[bool](true)

fn DecisionValidateLearnResultAt(graph: dc.CsgDecisionGraph, index: int32): Result[bool] =
    if index < 0 || index >= graph.learnResults.len:
        return Err[bool]("InvalidOutput: decision ref forged index (out of bounds)")
    let rowGen = graph.learnResults[index].generation
    if rowGen != graph.generation:
        return Err[bool]("InvalidOutput: decision node expired generation")
    var lr: dc.CsgDecisionRef
    lr.session = graph.session
    lr.generation = rowGen
    lr.index = graph.learnResults[index].learnRef
    lr.kind = dc.CsgDecisionRefKindLearn
    let refOk = decisionCheckNodeRef(share(graph), lr)
    if IsErr(refOk):
        return Err[bool](Error(refOk))
    let nodeIdx = graph.learnResults[index].learnRef
    let nodeOk = decisionValidateLearnNodeAt(share(graph), nodeIdx)
    if IsErr(nodeOk):
        return Err[bool](Error(nodeOk))
    let headKind = graph.learnResults[index].headKind
    if headKind != dc.CsgDecisionHeadChoice && headKind != dc.CsgDecisionHeadNoul && headKind != dc.CsgDecisionHeadScore:
        return Err[bool]("InvalidOutput: decision learn result head kind unknown")
    if graph.learns[nodeIdx].headKind != headKind:
        return Err[bool]("InvalidOutput: decision learn result head kind mismatch with node")
    let noMatch = graph.learnResults[index].noMatch
    let boundGoal = graph.learnResults[index].boundGoalRef
    let chosen = graph.learnResults[index].chosenCandidate
    let setStart = graph.learns[nodeIdx].candidateSetRef
    let setCount = graph.learns[nodeIdx].candidateCount
    if noMatch:
        # 显式 no-match: 不携带任何概率/等级/选择, 也不混入服务失败
        if graph.learnResults[index].probs.len != 0 || graph.learnResults[index].ranks.len != 0 ||
           chosen != dc.CsgDecisionChosenNone || graph.learnResults[index].weighted.numer != 0:
            return Err[bool]("InvalidOutput: decision learn result no-match inconsistent")
        if headKind == dc.CsgDecisionHeadNoul && setCount != 0:
            return Err[bool]("InvalidOutput: decision learn candidate set inconsistent for head")
        return Ok[bool](true)
    let goalOk = decisionCheckSlotRef(share(graph), rowGen, boundGoal, dc.CsgDecisionSlotKindGoal)
    if IsErr(goalOk):
        return Err[bool](Error(goalOk))
    if headKind == dc.CsgDecisionHeadNoul:
        # Noul = 条件成立概率: 单概率, 无候选集, 无选择, 无等级
        if setCount != 0:
            return Err[bool]("InvalidOutput: decision learn candidate set inconsistent for head")
        if chosen != dc.CsgDecisionChosenNone:
            return Err[bool]("InvalidOutput: decision learn result chosen candidate out of range")
        if graph.learnResults[index].ranks.len != 0:
            return Err[bool]("InvalidOutput: decision learn result ranks not permitted for head")
        if graph.learnResults[index].probs.len != 1:
            return Err[bool]("InvalidOutput: decision prob distribution size mismatch")
        let p = graph.learnResults[index].probs[0]
        let pOk = DecisionValidateProbValue(p)
        if IsErr(pOk):
            return Err[bool](Error(pOk))
        return Ok[bool](true)
    # Choice / Score 共同部分: 候选集非空, 分布长度与归一
    if setCount < 1:
        return Err[bool]("InvalidOutput: decision learn candidate set inconsistent for head")
    if graph.learnResults[index].probs.len != setCount:
        return Err[bool]("InvalidOutput: decision prob distribution size mismatch")
    let distOk = decisionValidateDistributionAt(share(graph), index)
    if IsErr(distOk):
        return Err[bool](Error(distOk))
    if headKind == dc.CsgDecisionHeadChoice:
        if graph.learnResults[index].ranks.len != 0:
            return Err[bool]("InvalidOutput: decision learn result ranks not permitted for head")
        if chosen < setStart || chosen >= setStart + setCount:
            return Err[bool]("InvalidOutput: decision learn result chosen candidate out of range")
    else:
        # Score = 有序等级分布及加权值: ranks 是 0..<setCount 的精确排列,
        # weighted 与 sum(ranks[i]*probs[i].numer) 在声明精度下逐位一致
        if chosen != dc.CsgDecisionChosenNone:
            return Err[bool]("InvalidOutput: decision learn result chosen candidate out of range")
        if graph.learnResults[index].ranks.len != setCount:
            return Err[bool]("InvalidOutput: decision learn result ranks not permitted for head")
        for v in 0..<setCount:
            var found = false
            for j in 0..<setCount:
                if graph.learnResults[index].ranks[j] == v:
                    found = true
            if !found:
                return Err[bool]("InvalidOutput: decision learn result ranks not a permutation")
        var sum: int64 = 0
        for j in 0..<setCount:
            sum = sum + int64(graph.learnResults[index].ranks[j]) * graph.learnResults[index].probs[j].numer
        if graph.learnResults[index].weighted.precision != graph.learnResults[index].probs[0].precision ||
           graph.learnResults[index].weighted.numer != sum:
            return Err[bool]("InvalidOutput: decision learn result weighted value inconsistent")
    # 候选交换检测: 集合内每个候选都必须是同一绑定目标的完整动作元组
    for j in 0..<setCount:
        let candIdx = setStart + j
        let candOk = DecisionValidateCandidateAt(share(graph), candIdx)
        if IsErr(candOk):
            return Err[bool](Error(candOk))
        if graph.candidates[candIdx].goalRef != boundGoal:
            return Err[bool]("InvalidOutput: decision candidate goal swap")
    return Ok[bool](true)

# -------------------------------------------------------------------
# 全图校验门
# -------------------------------------------------------------------

fn DecisionValidateGraph(graph: dc.CsgDecisionGraph): Result[bool] =
    for i in 0..<graph.observes.len:
        let r = decisionValidateObserveAt(share(graph), i)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.deterministics.len:
        let r = decisionValidateDeterministicAt(share(graph), i)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.learns.len:
        let r = decisionValidateLearnNodeAt(share(graph), i)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.actions.len:
        let r = decisionValidateActionAt(share(graph), i)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.executes.len:
        let r = decisionValidateExecuteAt(share(graph), i)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.receipts.len:
        let r = decisionValidateReceiptAt(share(graph), i)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.candidates.len:
        let r = DecisionValidateCandidateAt(share(graph), i)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.learnResults.len:
        let r = DecisionValidateLearnResultAt(share(graph), i)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.facts.len:
        let rowGen = graph.facts[i].generation
        if rowGen != graph.generation:
            return Err[bool]("InvalidOutput: decision node expired generation")
        let r = decisionCheckSlotRef(share(graph), rowGen, graph.facts[i].slotRef, graph.facts[i].slotKind)
        if IsErr(r):
            return Err[bool](Error(r))
    for i in 0..<graph.failures.len:
        if !dc.CsgDecisionFailureKindIsKnown(graph.failures[i].kind):
            return Err[bool]("InvalidOutput: decision failure kind unknown")
    return Ok[bool](true)

# -------------------------------------------------------------------
# 按名寻址: 合同不提供按名查找, 一切请求显式拒绝
# -------------------------------------------------------------------

fn DecisionRejectNameRequest(name: str): Result[int32] =
    # 名称/路径/源码行一律不得充当身份 (contract.md §1); 本函数是按名
    # 寻址请求的唯一显式拒绝入口, 不存在任何按名查找实现。
    return Err[int32]("InvalidOutput: by-name addressing forbidden; use bound int32 indices")
