                               rightBuffer: DeviceBuffer,
                               rightReceiptHash: int64): Result[int64] =
    if leftBuffer.logicalHash <= int64(0) || leftReceiptHash <= int64(0) ||
       rightBuffer.logicalHash <= int64(0) || rightReceiptHash <= int64(0):
        return Err[int64]("inference device: buffer buffer input hash")
    var h: int64 = DeviceHashStep(programHash, leftBuffer.logicalHash)
    h = DeviceHashStep(h, leftReceiptHash)
    h = DeviceHashStep(h, rightBuffer.logicalHash)
    h = DeviceHashStep(h, rightReceiptHash)
    return Ok[int64](h)

