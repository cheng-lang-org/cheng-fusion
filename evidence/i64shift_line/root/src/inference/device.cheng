        return Err[bool]("inference device tensor buffer load: descriptor")
    if DeviceTensorBufferLoadReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("inference device tensor buffer load: receipt hash")
    return Ok[bool](true)

@borrows
fn DeviceBuildFileRangePageTableReceipt(device: Device,
                                        filePath: str,
                                        offsetBytes: int64,
                                        byteCount: int64,
                                        pageBytes: int64,
                                        chunkBytes: int32): Result[DeviceFileRangePageTableReceipt] =
    if device.backend == "" || device.name == "" || device.capabilityHash == "" || device.capabilityMask <= 0 || !device.ready:
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: ready device")
    if filePath == "" || offsetBytes < int64(0) || byteCount <= int64(0):
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: range")
    if pageBytes <= int64(0):
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: page bytes")
    if chunkBytes <= 0 || chunkBytes > 67108864:
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: chunk")
    let fileLen = os.FileSize(filePath)
    if fileLen <= int64(0):
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: file size")
    if offsetBytes > fileLen || byteCount > fileLen - offsetBytes:
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: range beyond file")
    var pages: DeviceFileRangePage[]
    var cursor: int64
    var ordinal: int32
    while cursor < byteCount:
        if ordinal >= 2147483647:
            return Err[DeviceFileRangePageTableReceipt]("inference device page table: too many pages")
        var thisPageBytes = pageBytes
        if thisPageBytes > byteCount - cursor:
            thisPageBytes = byteCount - cursor
        let pageOffset = offsetBytes + cursor
        let rangeHash = DeviceHashFileRangePath(filePath, pageOffset, thisPageBytes, chunkBytes)
        if IsErr(rangeHash):
            return Err[DeviceFileRangePageTableReceipt](Error(rangeHash))
        var page = DeviceFileRangePage(
            pageOrdinal: ordinal,
            offsetBytes: pageOffset,
            byteCount: thisPageBytes,
            chunkBytes: chunkBytes,
            sourceRangeHash: Value(rangeHash),
            pageHash: int64(0)
        )
        page.pageHash = DeviceFileRangePageHash(page)
        if page.pageHash <= int64(0):
            return Err[DeviceFileRangePageTableReceipt]("inference device page table: page hash")
        add(pages, page)
        cursor = cursor + thisPageBytes
        ordinal = ordinal + 1
    if pages.len <= 0 || pages.len != int(ordinal):
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: page count")
    let aggregateHash = DeviceFileRangePageAggregateHash(pages)
    if aggregateHash <= int64(0):
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: aggregate hash")
    var out = DeviceFileRangePageTableReceipt(
        schema: InferenceDeviceFileRangePageTableReceiptSchema,
        deviceBackend: strings.CloneStr(device.backend),
        deviceName: strings.CloneStr(device.name),
        deviceCapabilityHash: strings.CloneStr(device.capabilityHash),
        deviceCapabilityMask: device.capabilityMask,
        filePath: strings.CloneStr(filePath),
        fileByteCount: fileLen,
        offsetBytes: offsetBytes,
        byteCount: byteCount,
        pageBytes: pageBytes,
        chunkBytes: chunkBytes,
        pageCount: ordinal,
        pages: pages,
        pageAggregateHash: aggregateHash,
        receiptHash: int64(0)
    )
    out.receiptHash = DeviceFileRangePageTableReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[DeviceFileRangePageTableReceipt]("inference device page table: receipt hash")
    return Ok[DeviceFileRangePageTableReceipt](out)

@borrows
fn DeviceValidateFileRangePageTableReceipt(device: Device,
                                           receipt: DeviceFileRangePageTableReceipt): Result[bool] =
    let expected = DeviceBuildFileRangePageTableReceipt(
        device,
        receipt.filePath,
        receipt.offsetBytes,
        receipt.byteCount,
        receipt.pageBytes,
        receipt.chunkBytes
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.schema != InferenceDeviceFileRangePageTableReceiptSchema ||
       receipt.schema != want.schema ||
       receipt.deviceBackend != want.deviceBackend ||
       receipt.deviceName != want.deviceName ||
       receipt.deviceCapabilityHash != want.deviceCapabilityHash ||
       receipt.deviceCapabilityMask != want.deviceCapabilityMask ||
       receipt.filePath != want.filePath ||
       receipt.fileByteCount != want.fileByteCount ||
       receipt.offsetBytes != want.offsetBytes ||
       receipt.byteCount != want.byteCount ||
       receipt.pageBytes != want.pageBytes ||
       receipt.chunkBytes != want.chunkBytes ||
       receipt.pageCount != want.pageCount ||
       receipt.pages.len != want.pages.len ||
       receipt.pageAggregateHash != want.pageAggregateHash ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("inference device page table: receipt mismatch")
    for i in 0..<receipt.pages.len:
        if receipt.pages[i].pageOrdinal != want.pages[i].pageOrdinal ||
           receipt.pages[i].offsetBytes != want.pages[i].offsetBytes ||
           receipt.pages[i].byteCount != want.pages[i].byteCount ||
           receipt.pages[i].chunkBytes != want.pages[i].chunkBytes ||
           receipt.pages[i].sourceRangeHash != want.pages[i].sourceRangeHash ||
           receipt.pages[i].pageHash != want.pages[i].pageHash ||
           receipt.pages[i].pageHash != DeviceFileRangePageHash(receipt.pages[i]):
            return Err[bool]("inference device page table: page mismatch")
    if DeviceFileRangePageAggregateHash(receipt.pages) != receipt.pageAggregateHash:
        return Err[bool]("inference device page table: aggregate hash")
    if DeviceFileRangePageTableReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("inference device page table: receipt hash")
    return Ok[bool](true)

@borrows
fn DeviceValidateFileRangePageInTableReceipt(device: Device,
                                             receipt: DeviceFileRangePageTableReceipt,
                                             pageIndex: int32): Result[bool] =
    if device.backend == "" || device.name == "" || device.capabilityHash == "" || device.capabilityMask <= 0 || !device.ready:
        return Err[bool]("inference device page table page: ready device")
    if receipt.schema != InferenceDeviceFileRangePageTableReceiptSchema ||
       receipt.deviceBackend != device.backend ||
       receipt.deviceName != device.name ||
       receipt.deviceCapabilityHash != device.capabilityHash ||
       receipt.deviceCapabilityMask != device.capabilityMask:
        return Err[bool]("inference device page table page: device")
    if receipt.filePath == "" || receipt.offsetBytes < int64(0) || receipt.byteCount <= int64(0):
        return Err[bool]("inference device page table page: range")
    if receipt.pageBytes <= int64(0) || receipt.chunkBytes <= 0 || receipt.chunkBytes > 67108864:
        return Err[bool]("inference device page table page: page params")
    if receipt.pageCount <= 0 || receipt.pages.len != int(receipt.pageCount):
        return Err[bool]("inference device page table page: page count")
    if pageIndex < 0 || pageIndex >= receipt.pageCount:
        return Err[bool]("inference device page table page: page index")
    let fileLen = os.FileSize(receipt.filePath)
    if fileLen <= int64(0) || fileLen != receipt.fileByteCount:
        return Err[bool]("inference device page table page: file size")
    if receipt.offsetBytes > fileLen || receipt.byteCount > fileLen - receipt.offsetBytes:
        return Err[bool]("inference device page table page: range beyond file")
    var cursor: int64
    for i in 0..<receipt.pages.len:
        let page = receipt.pages[i]
        if page.pageOrdinal != int32(i) ||
           page.offsetBytes != receipt.offsetBytes + cursor ||
           page.byteCount <= int64(0) ||
           page.byteCount > receipt.pageBytes ||
           page.chunkBytes != receipt.chunkBytes ||
           page.sourceRangeHash <= int64(0) ||
           page.pageHash != DeviceFileRangePageHash(page):
            return Err[bool]("inference device page table page: page metadata")
        if i + 1 < receipt.pages.len && page.byteCount != receipt.pageBytes:
            return Err[bool]("inference device page table page: non-final page bytes")
        cursor = cursor + page.byteCount
    if cursor != receipt.byteCount:
        return Err[bool]("inference device page table page: total bytes")
    if DeviceFileRangePageAggregateHash(receipt.pages) != receipt.pageAggregateHash:
        return Err[bool]("inference device page table page: aggregate hash")
    if DeviceFileRangePageTableReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("inference device page table page: receipt hash")
    let target = receipt.pages[int(pageIndex)]
    let rangeHash = DeviceHashFileRangePath(
        receipt.filePath,
        target.offsetBytes,
        target.byteCount,
        target.chunkBytes
    )
    if IsErr(rangeHash):
        return Err[bool](Error(rangeHash))
    if Value(rangeHash) != target.sourceRangeHash:
        return Err[bool]("inference device page table page: source hash")
    return Ok[bool](true)

fn DeviceMetalLoadFileRangePageBuffer(device: Device,
                                      pageTable: DeviceFileRangePageTableReceipt,
                                      pageIndex: int32,
                                      dtype: str): Result[DeviceFileRangeBufferLoadResult] =
    let pageTableOk = DeviceValidateFileRangePageInTableReceipt(device, pageTable, pageIndex)
    if IsErr(pageTableOk):
        return Err[DeviceFileRangeBufferLoadResult](Error(pageTableOk))
    if pageIndex < 0 || pageIndex >= pageTable.pageCount || int(pageIndex) >= pageTable.pages.len:
        return Err[DeviceFileRangeBufferLoadResult]("inference device metal page buffer load: page")
    let page = pageTable.pages[int(pageIndex)]
    let loaded = DeviceMetalLoadFileRangeBufferChunked(
        device,
        pageTable.filePath,
        page.offsetBytes,
        page.byteCount,
        page.chunkBytes,
        dtype
    )
    if IsErr(loaded):
        return Err[DeviceFileRangeBufferLoadResult](Error(loaded))
    if Value(loaded).buffer.logicalHash != page.sourceRangeHash ||
       Value(loaded).receipt.sourceRangeHash != page.sourceRangeHash ||
       Value(loaded).receipt.offsetBytes != page.offsetBytes ||
       Value(loaded).receipt.byteCount != page.byteCount ||
       Value(loaded).receipt.chunkBytes != page.chunkBytes:
        let _releaseAfterPageMismatch = __inference_metal_release_buffer_bridge(Value(loaded).buffer.handle)
        return Err[DeviceFileRangeBufferLoadResult]("inference device metal page buffer load: page mismatch")
    return loaded

@borrows
fn DeviceShapeEquals(left: int32[], right: int32[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

@borrows
fn DeviceTensorHash(tensor: infer.TensorQ): Result[int64] =
    let ok = infer.TensorValidate(tensor)
    if IsErr(ok):
        return Err[int64](Error(ok))
    var h: int64 = DeviceHashText("cheng.inference.device.tensor.v1")
    h = DeviceHashStep(h, int64(tensor.scale))
    for i in 0..<tensor.shape.len:
        h = DeviceHashStep(h, int64(tensor.shape[i]))
    for i in 0..<tensor.data.len:
        h = DeviceHashStep(h, int64(tensor.data[i]))
    return Ok[int64](h)

@borrows
fn DeviceTensorPairInputHash(programHash: int64, left: infer.TensorQ, right: infer.TensorQ): Result[int64] =
    let leftHash = DeviceTensorHash(left)
    if IsErr(leftHash):
        return Err[int64](Error(leftHash))
    let rightHash = DeviceTensorHash(right)
    if IsErr(rightHash):
        return Err[int64](Error(rightHash))
    var h: int64 = DeviceHashStep(programHash, Value(leftHash))
    h = DeviceHashStep(h, Value(rightHash))
    return Ok[int64](h)

@borrows
fn DeviceTensorBufferPairInputHash(programHash: int64,
                                   leftBuffer: DeviceBuffer,
                                   leftReceipt: DeviceFileRangeBufferLoadReceipt,
                                   right: infer.TensorQ): Result[int64] =
    if leftBuffer.logicalHash <= int64(0) || leftReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: buffer input hash")
    let rightHash = DeviceTensorHash(right)
    if IsErr(rightHash):
        return Err[int64](Error(rightHash))
    var h: int64 = DeviceHashStep(programHash, leftBuffer.logicalHash)
    h = DeviceHashStep(h, leftReceipt.receiptHash)
    h = DeviceHashStep(h, Value(rightHash))
    return Ok[int64](h)

@borrows
fn DeviceBufferBufferInputHash(programHash: int64,
                               leftBuffer: DeviceBuffer,
