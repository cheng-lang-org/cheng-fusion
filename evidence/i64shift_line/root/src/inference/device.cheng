       program.tensors[1].shape[0] != dim ||
       program.tensors[2].shape[0] != dim ||
       epsilonScale != program.ops[0].epsilonScale:
        return Err[KernelLaunchReceipt]("inference device rmsnorm buffers: KernelIR tensor shape")
