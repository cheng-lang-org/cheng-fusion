       weightReceipt.deviceBufferHandle != weightBuffer.handle ||
       inputReceipt.deviceBufferLogicalHash != inputBuffer.logicalHash ||
       weightReceipt.deviceBufferLogicalHash != weightBuffer.logicalHash ||
       inputReceipt.deviceBufferSizeBytes != inputBuffer.sizeBytes ||
       weightReceipt.deviceBufferSizeBytes != weightBuffer.sizeBytes:
        return Err[KernelLaunchReceipt]("inference device rmsnorm buffers: receipt buffer")
    if inputReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       weightReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
