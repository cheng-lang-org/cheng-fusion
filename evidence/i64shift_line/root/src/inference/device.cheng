@borrows
fn DeviceBuildTensorBufferLoadReceiptWithStatus(device: Device,
                                                buffer: DeviceBuffer,
                                                tensor: infer.TensorQ,
                                                status: str): Result[DeviceTensorBufferLoadReceipt] =
    if device.backend == "" || device.name == "" || device.capabilityHash == "" || device.capabilityMask <= 0 || !device.ready:
        return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: ready device")
    if buffer.deviceCapabilityHash != device.capabilityHash:
        return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: capability")
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[DeviceTensorBufferLoadReceipt](Error(tensorOk))
    if buffer.sizeBytes <= int64(0) || buffer.dtype != kir.KernelDtypeI32 || buffer.logicalHash <= int64(0):
        return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: buffer")
    if status == InferenceDeviceBufferLoadStatusVerifiedLogical:
        if buffer.handle != uint64(0):
            return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: logical handle")
    elif status == InferenceDeviceBufferLoadStatusMetalBufferLoaded:
        if device.backend != InferenceDeviceBackendMetal || buffer.handle == uint64(0):
            return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: metal handle")
    else:
        return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: status")
    let byteCount = DeviceI32BytesRequired(tensor.data.len)
    if IsErr(byteCount):
        return Err[DeviceTensorBufferLoadReceipt](Error(byteCount))
    if buffer.sizeBytes != int64(Value(byteCount)):
        return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: byte size")
    let tensorHash = DeviceTensorHash(tensor)
    if IsErr(tensorHash):
        return Err[DeviceTensorBufferLoadReceipt](Error(tensorHash))
    if buffer.logicalHash != Value(tensorHash):
        return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: logical hash")
    var out = DeviceTensorBufferLoadReceipt(
        schema: InferenceDeviceTensorBufferLoadReceiptSchema,
        deviceBackend: strings.CloneStr(device.backend),
        deviceName: strings.CloneStr(device.name),
        deviceCapabilityHash: strings.CloneStr(device.capabilityHash),
        deviceCapabilityMask: device.capabilityMask,
        deviceBufferSizeBytes: buffer.sizeBytes,
        deviceBufferDtype: strings.CloneStr(buffer.dtype),
        deviceBufferLogicalHash: buffer.logicalHash,
        deviceBufferHandle: buffer.handle,
        tensorScale: tensor.scale,
        tensorShape: infer.InferenceShapeCopy(tensor.shape),
        tensorElementCount: tensor.data.len,
        tensorHash: Value(tensorHash),
        tensorDataHash: DeviceHashI32(tensor.data),
        status: strings.CloneStr(status),
        receiptHash: int64(0)
    )
    out.receiptHash = DeviceTensorBufferLoadReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[DeviceTensorBufferLoadReceipt]("inference device tensor buffer load: receipt hash")
    return Ok[DeviceTensorBufferLoadReceipt](out)

