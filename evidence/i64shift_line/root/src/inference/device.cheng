    if providerReceiptHandle == uint64(0):
        rawbytes.BytesFree(outBytes)
        return Err[KernelLaunchReceipt]("inference device rmsnorm buffers: metal provider failed")
    let elapsed = __inference_metal_launch_receipt_elapsed_ns_bridge(providerReceiptHandle)
    let outBufferHandle = __inference_metal_launch_receipt_output_buffer_handle_bridge(providerReceiptHandle)
    let providerOutputHash = __inference_metal_launch_receipt_output_hash_bridge(providerReceiptHandle)
    let providerReceiptRelease = __inference_metal_launch_receipt_release_bridge(providerReceiptHandle)
