    if receipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       buffer.handle == uint64(0) ||
       buffer.deviceCapabilityHash != device.capabilityHash:
        return Err[bool]("inference device raw tensor buffer load: provider handle")
    let expectedBytes = DeviceRawTensorBytesExpectedByteCount(receipt.deviceBufferDtype, receipt.tensorShape)
    if IsErr(expectedBytes):
        return Err[bool](Error(expectedBytes))
    let elems = infer.TensorElementCount(receipt.tensorShape)
    if IsErr(elems):
        return Err[bool](Error(elems))
    if receipt.tensorElementCount != Value(elems) ||
       receipt.rawByteCount != Value(expectedBytes) ||
       receipt.deviceBufferSizeBytes != Value(expectedBytes) ||
       receipt.rawBytesHash <= int64(0) ||
       receipt.rawBytesHash != buffer.logicalHash ||
       receipt.tensorScale <= 0:
        return Err[bool]("inference device raw tensor buffer load: descriptor")
    if DeviceRawTensorBytesBufferLoadReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("inference device raw tensor buffer load: receipt hash")
    return Ok[bool](true)

