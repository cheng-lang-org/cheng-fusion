    let want = Value(expected)
    if receipt.schema != InferenceDeviceTensorBufferLoadReceiptSchema ||
       receipt.deviceBackend != want.deviceBackend ||
       receipt.deviceName != want.deviceName ||
       receipt.deviceCapabilityHash != want.deviceCapabilityHash ||
       receipt.deviceCapabilityMask != want.deviceCapabilityMask ||
