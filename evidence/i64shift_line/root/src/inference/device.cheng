       weightBuffer.handle == uint64(0):
        return Err[KernelLaunchReceipt]("inference device rmsnorm buffers: provider handle")
    if inputBuffer.dtype != kir.KernelDtypeI32 || weightBuffer.dtype != kir.KernelDtypeI32:
        return Err[KernelLaunchReceipt]("inference device rmsnorm buffers: dtype")
    if program.tensors[0].shape.len != 1 ||
       program.tensors[1].shape.len != 1 ||
       program.tensors[2].shape.len != 1:
        return Err[KernelLaunchReceipt]("inference device rmsnorm buffers: tensor rank")
    let dim = program.ops[0].cols
    if dim <= 0 || program.ops[0].inner != dim || program.ops[0].rows != 1:
        return Err[KernelLaunchReceipt]("inference device rmsnorm buffers: dims")
