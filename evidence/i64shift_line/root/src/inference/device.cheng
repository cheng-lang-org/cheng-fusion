            return Err[int64]("inference device paged attention tensor page buffers: value page byte size")
    return DeviceTensorPagedAttentionTensorPageBuffersInputHash(program.kernelHash,
                                                                queryBuffer,
                                                                queryReceipt,
                                                                keyPageBuffers,
                                                                keyPageReceipts,
                                                                valuePageBuffers,
                                                                valuePageReceipts,
                                                                pageTableBuffer,
                                                                pageTableReceipt)

@borrows
fn DeviceMetalPagedAttentionTensorPageBuffersToBufferFill(device: Device,
                                                          program: kir.KernelProgram,
                                                          query: infer.TensorQ,
                                                          keyPageTensors: infer.TensorQ[],
                                                          valuePageTensors: infer.TensorQ[],
                                                          pageTable: infer.TensorQ): Result[DeviceBufferKernelLaunchResult] =
    if keyPageTensors.len <= 0 || keyPageTensors.len != valuePageTensors.len:
        return Err[DeviceBufferKernelLaunchResult]("inference device paged attention tensor page buffers output: page tensor count")
    let queryLoad = DeviceMetalLoadTensorI32Buffer(device, query)
    if IsErr(queryLoad):
        return Err[DeviceBufferKernelLaunchResult](Error(queryLoad))
    let pageTableLoad = DeviceMetalLoadTensorI32Buffer(device, pageTable)
    if IsErr(pageTableLoad):
        let _releaseQueryOnTableFail = DeviceMetalReleaseBuffer(Value(queryLoad).buffer)
        return Err[DeviceBufferKernelLaunchResult](Error(pageTableLoad))
    var keyPageBuffers: DeviceBuffer[]
    var keyPageReceipts: DeviceTensorBufferLoadReceipt[]
    var valuePageBuffers: DeviceBuffer[]
    var valuePageReceipts: DeviceTensorBufferLoadReceipt[]
    for i in 0..<keyPageTensors.len:
        let keyLoad = DeviceMetalLoadTensorI32Buffer(device, keyPageTensors[i])
        if IsErr(keyLoad):
            let _releaseQueryOnKeyFail = DeviceMetalReleaseBuffer(Value(queryLoad).buffer)
            let _releaseTableOnKeyFail = DeviceMetalReleaseBuffer(Value(pageTableLoad).buffer)
            let _releaseKeysOnKeyFail = DeviceMetalReleaseBufferSet(keyPageBuffers)
            let _releaseValuesOnKeyFail = DeviceMetalReleaseBufferSet(valuePageBuffers)
            return Err[DeviceBufferKernelLaunchResult](Error(keyLoad))
        let valueLoad = DeviceMetalLoadTensorI32Buffer(device, valuePageTensors[i])
        if IsErr(valueLoad):
            let _releaseKeyOnValueFail = DeviceMetalReleaseBuffer(Value(keyLoad).buffer)
            let _releaseQueryOnValueFail = DeviceMetalReleaseBuffer(Value(queryLoad).buffer)
            let _releaseTableOnValueFail = DeviceMetalReleaseBuffer(Value(pageTableLoad).buffer)
            let _releaseKeysOnValueFail = DeviceMetalReleaseBufferSet(keyPageBuffers)
            let _releaseValuesOnValueFail = DeviceMetalReleaseBufferSet(valuePageBuffers)
            return Err[DeviceBufferKernelLaunchResult](Error(valueLoad))
        add(keyPageBuffers, Value(keyLoad).buffer)
        add(keyPageReceipts, Value(keyLoad).receipt)
        add(valuePageBuffers, Value(valueLoad).buffer)
        add(valuePageReceipts, Value(valueLoad).receipt)
    let inputHash = DeviceValidatePagedAttentionTensorPageBuffersInput(
        device,
        program,
        query,
        Value(queryLoad).buffer,
        Value(queryLoad).receipt,
        keyPageTensors,
        keyPageBuffers,
        keyPageReceipts,
        valuePageTensors,
        valuePageBuffers,
        valuePageReceipts,
        pageTable,
        Value(pageTableLoad).buffer,
        Value(pageTableLoad).receipt
    )
    if IsErr(inputHash):
        let _releaseQueryOnInputFail = DeviceMetalReleaseBuffer(Value(queryLoad).buffer)
        let _releaseTableOnInputFail = DeviceMetalReleaseBuffer(Value(pageTableLoad).buffer)
        let _releaseKeysOnInputFail = DeviceMetalReleaseBufferSet(keyPageBuffers)
        let _releaseValuesOnInputFail = DeviceMetalReleaseBufferSet(valuePageBuffers)
        return Err[DeviceBufferKernelLaunchResult](Error(inputHash))
    let launched = DeviceMetalPagedAttentionPageBuffersWindowedToBufferFill(
        device,
        program,
        Value(inputHash),
        Value(queryLoad).buffer,
        keyPageBuffers,
        valuePageBuffers,
        Value(pageTableLoad).buffer
    )
    let releaseQuery = DeviceMetalReleaseBuffer(Value(queryLoad).buffer)
    let releaseTable = DeviceMetalReleaseBuffer(Value(pageTableLoad).buffer)
    let releaseKeys = DeviceMetalReleaseBufferSet(keyPageBuffers)
    let releaseValues = DeviceMetalReleaseBufferSet(valuePageBuffers)
    if IsErr(launched):
        return Err[DeviceBufferKernelLaunchResult](Error(launched))
    if IsErr(releaseQuery):
        let _releaseOutputOnQueryReleaseFail = DeviceMetalReleaseBuffer(Value(launched).buffer)
        return Err[DeviceBufferKernelLaunchResult](Error(releaseQuery))
    if IsErr(releaseTable):
        let _releaseOutputOnTableReleaseFail = DeviceMetalReleaseBuffer(Value(launched).buffer)
        return Err[DeviceBufferKernelLaunchResult](Error(releaseTable))
    if IsErr(releaseKeys):
        let _releaseOutputOnKeysReleaseFail = DeviceMetalReleaseBuffer(Value(launched).buffer)
        return Err[DeviceBufferKernelLaunchResult](Error(releaseKeys))
    if IsErr(releaseValues):
        let _releaseOutputOnValuesReleaseFail = DeviceMetalReleaseBuffer(Value(launched).buffer)
        return Err[DeviceBufferKernelLaunchResult](Error(releaseValues))
    var out = Value(launched)
    out.receipt.trace = "kernel_ir_facts->tensor_metal_page_buffers->resident_output_buffer"
    return Ok[DeviceBufferKernelLaunchResult](out)

@borrows
fn DeviceMetalPagedAttentionTensorLoadedPageBuffersToBufferFill(device: Device,
                                                                program: kir.KernelProgram,
                                                                query: infer.TensorQ,
                                                                queryBuffer: DeviceBuffer,
                                                                queryReceipt: DeviceTensorBufferLoadReceipt,
                                                                keyPageTensors: infer.TensorQ[],
                                                                keyPageBuffers: DeviceBuffer[],
                                                                keyPageReceipts: DeviceTensorBufferLoadReceipt[],
                                                                valuePageTensors: infer.TensorQ[],
                                                                valuePageBuffers: DeviceBuffer[],
                                                                valuePageReceipts: DeviceTensorBufferLoadReceipt[],
                                                                pageTable: infer.TensorQ,
                                                                pageTableBuffer: DeviceBuffer,
                                                                pageTableReceipt: DeviceTensorBufferLoadReceipt): Result[DeviceBufferKernelLaunchResult] =
    let inputHash = DeviceValidatePagedAttentionTensorPageBuffersInput(
        device,
        program,
        query,
        queryBuffer,
        queryReceipt,
        keyPageTensors,
        keyPageBuffers,
        keyPageReceipts,
        valuePageTensors,
        valuePageBuffers,
        valuePageReceipts,
        pageTable,
        pageTableBuffer,
        pageTableReceipt
    )
    if IsErr(inputHash):
        return Err[DeviceBufferKernelLaunchResult](Error(inputHash))
    let launched = DeviceMetalPagedAttentionPageBuffersWindowedToBufferFill(
        device,
        program,
        Value(inputHash),
        queryBuffer,
        keyPageBuffers,
        valuePageBuffers,
        pageTableBuffer
    )
    if IsErr(launched):
        return Err[DeviceBufferKernelLaunchResult](Error(launched))
    var out = Value(launched)
    out.receipt.trace = "kernel_ir_facts->tensor_loaded_page_buffers->resident_output_buffer"
    return Ok[DeviceBufferKernelLaunchResult](out)

@borrows
fn DeviceMetalPagedAttentionPageBuffersWindowedFill(out: var infer.TensorQ,
                                                    device: Device,
                                                    program: kir.KernelProgram,
                                                    inputHash: int64,
                                                    queryBuffer: DeviceBuffer,
                                                    keyPageBuffers: DeviceBuffer[],
                                                    valuePageBuffers: DeviceBuffer[],
                                                    pageTableBuffer: DeviceBuffer): Result[KernelLaunchReceipt] =
    let tokenCount = program.ops[0].rows
    let valueDim = program.ops[0].cols
    let keyDim = program.ops[0].inner
    let tokensPerPage = program.ops[0].topK
    let pageCount = program.ops[0].epsilonScale
    let blockCount = program.tensors[3].shape[0]
    let outByteCount = DeviceI32BytesRequired(valueDim)
    if IsErr(outByteCount):
        return Err[KernelLaunchReceipt](Error(outByteCount))
    var totalElapsed: int64
    totalElapsed = int64(0)
    var bestScore: int64
    bestScore = int64(0)
    var bestToken: int32
    bestToken = -1
    var hasBest: bool
    hasBest = false
    var bestOut: infer.TensorQ
    var pageStart: int32
    pageStart = 0
    while pageStart < pageCount:
        var windowPageCount: int32
        windowPageCount = pageCount - pageStart
        if windowPageCount > InferenceDeviceMetalPagedAttentionPageBufferSlotLimit:
            windowPageCount = InferenceDeviceMetalPagedAttentionPageBufferSlotLimit
        var outBytes = rawbytes.BytesAlloc(Value(outByteCount))
        if Value(outByteCount) > 0 && outBytes.data == nil:
            return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: output allocation")
        let key0 = DevicePagedAttentionWindowHandle(keyPageBuffers, pageStart, windowPageCount, 0)
        let key1 = DevicePagedAttentionWindowHandle(keyPageBuffers, pageStart, windowPageCount, 1)
        let key2 = DevicePagedAttentionWindowHandle(keyPageBuffers, pageStart, windowPageCount, 2)
        let key3 = DevicePagedAttentionWindowHandle(keyPageBuffers, pageStart, windowPageCount, 3)
        let value0 = DevicePagedAttentionWindowHandle(valuePageBuffers, pageStart, windowPageCount, 0)
        let value1 = DevicePagedAttentionWindowHandle(valuePageBuffers, pageStart, windowPageCount, 1)
        let value2 = DevicePagedAttentionWindowHandle(valuePageBuffers, pageStart, windowPageCount, 2)
        let value3 = DevicePagedAttentionWindowHandle(valuePageBuffers, pageStart, windowPageCount, 3)
        if IsErr(key0) || IsErr(key1) || IsErr(key2) || IsErr(key3) ||
           IsErr(value0) || IsErr(value1) || IsErr(value2) || IsErr(value3):
            rawbytes.BytesFree(outBytes)
            return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: handle")
        let providerReceiptHandle = __inference_metal_paged_attention_i32_page_buffers_window_handles_output_receipt_bridge(
            queryBuffer.handle,
            Value(key0),
            Value(key1),
            Value(key2),
            Value(key3),
            Value(value0),
            Value(value1),
            Value(value2),
            Value(value3),
            pageTableBuffer.handle,
            pageStart,
            windowPageCount,
            pageCount,
            outBytes,
            tokenCount,
            keyDim,
            valueDim,
            tokensPerPage,
            blockCount,
            program.tensors[0].scale
        )
        if providerReceiptHandle == uint64(0):
            rawbytes.BytesFree(outBytes)
            return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: metal provider failed")
        let elapsed = __inference_metal_launch_receipt_elapsed_ns_bridge(providerReceiptHandle)
        let windowBufferHandle = __inference_metal_launch_receipt_output_buffer_handle_bridge(providerReceiptHandle)
        let windowOutputHash = __inference_metal_launch_receipt_output_hash_bridge(providerReceiptHandle)
        let windowScore = __inference_metal_launch_receipt_window_score_bridge(providerReceiptHandle)
        let windowToken = __inference_metal_launch_receipt_window_token_bridge(providerReceiptHandle)
        let windowFound = __inference_metal_launch_receipt_window_found_bridge(providerReceiptHandle)
        let providerReceiptRelease = __inference_metal_launch_receipt_release_bridge(providerReceiptHandle)
        if elapsed <= int64(0) || windowOutputHash <= int64(0) || providerReceiptRelease != 0:
            rawbytes.BytesFree(outBytes)
            if windowBufferHandle != uint64(0):
                let _releaseWindowOnProviderFail = __inference_metal_release_buffer_bridge(windowBufferHandle)
            return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: metal provider failed")
        totalElapsed = totalElapsed + elapsed
        if windowFound != 0:
            if windowToken < 0 || windowBufferHandle == uint64(0):
                rawbytes.BytesFree(outBytes)
                if windowBufferHandle != uint64(0):
                    let _releaseWindowOnTokenFail = __inference_metal_release_buffer_bridge(windowBufferHandle)
                return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: provider token")
            if !hasBest || windowScore > bestScore || (windowScore == bestScore && windowToken < bestToken):
                let unpack = DeviceTensorFromI32Bytes([valueDim], program.tensors[0].scale, outBytes)
                if IsErr(unpack):
                    rawbytes.BytesFree(outBytes)
                    let _releaseWindowOnUnpackFail = __inference_metal_release_buffer_bridge(windowBufferHandle)
                    return Err[KernelLaunchReceipt](Error(unpack))
                let unpackHash = DeviceTensorHash(Value(unpack))
                if IsErr(unpackHash):
                    rawbytes.BytesFree(outBytes)
                    let _releaseWindowOnHashFail = __inference_metal_release_buffer_bridge(windowBufferHandle)
                    return Err[KernelLaunchReceipt](Error(unpackHash))
                if Value(unpackHash) != windowOutputHash:
                    rawbytes.BytesFree(outBytes)
                    let _releaseWindowOnHashMismatch = __inference_metal_release_buffer_bridge(windowBufferHandle)
                    return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: provider output hash")
                bestOut = Value(unpack)
                bestScore = windowScore
                bestToken = windowToken
                hasBest = true
            if windowBufferHandle != uint64(0):
                let releaseWindow = __inference_metal_release_buffer_bridge(windowBufferHandle)
                if releaseWindow != 0:
                    rawbytes.BytesFree(outBytes)
                    return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: output buffer release")
        else:
            if windowBufferHandle != uint64(0):
                let releaseEmptyWindow = __inference_metal_release_buffer_bridge(windowBufferHandle)
                if releaseEmptyWindow != 0:
                    rawbytes.BytesFree(outBytes)
                    return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: output buffer release")
        rawbytes.BytesFree(outBytes)
        pageStart = pageStart + windowPageCount
    if !hasBest:
        return Err[KernelLaunchReceipt]("inference device paged attention page buffers window: no token")
    let finalFill = infer.TensorFromDataFill(out, [valueDim], program.tensors[0].scale, bestOut.data)
    if IsErr(finalFill):
        return Err[KernelLaunchReceipt](Error(finalFill))
    return DeviceMetalReceipt(device,
                              program,
                              inputHash,
                              out,
                              totalElapsed,
                              "kernel_ir_facts->file_range_metal_paged_attention_page_buffers_windowed->typed_metal_paged_attention_i32")

@borrows
fn DeviceMetalPagedAttentionPageBuffersWindowedToBufferFill(device: Device,
                                                            program: kir.KernelProgram,
                                                            inputHash: int64,
                                                            queryBuffer: DeviceBuffer,
                                                            keyPageBuffers: DeviceBuffer[],
                                                            valuePageBuffers: DeviceBuffer[],
                                                            pageTableBuffer: DeviceBuffer): Result[DeviceBufferKernelLaunchResult] =
    let tokenCount = program.ops[0].rows
    let valueDim = program.ops[0].cols
    let keyDim = program.ops[0].inner
    let tokensPerPage = program.ops[0].topK
    let pageCount = program.ops[0].epsilonScale
    let blockCount = program.tensors[3].shape[0]
    let outByteCount = DeviceI32BytesRequired(valueDim)
    if IsErr(outByteCount):
        return Err[DeviceBufferKernelLaunchResult](Error(outByteCount))
    var totalElapsed: int64
    totalElapsed = int64(0)

    # ---- #155-wide cross-window online-softmax merge, pass 1: scan every
    # window's own local max score (the single-window kernel's existing,
    # unmodified per-window softmax scan) purely to find the GLOBAL max.
    # Union of windows partitions every token exactly once, so
    # max-of-window-maxima == the single global max PagedKVAttentionQueryFill
    # scans for over the whole sequence -- exact, not approximate.
    var globalMax: int64
    globalMax = int64(0)
    var hasGlobalMax: bool
    hasGlobalMax = false
    var scanPageStart: int32
    scanPageStart = 0
    while scanPageStart < pageCount:
        var scanWindowPageCount: int32
        scanWindowPageCount = pageCount - scanPageStart
        if scanWindowPageCount > InferenceDeviceMetalPagedAttentionPageBufferSlotLimit:
            scanWindowPageCount = InferenceDeviceMetalPagedAttentionPageBufferSlotLimit
        var scanOutBytes = rawbytes.BytesAlloc(Value(outByteCount))
        if Value(outByteCount) > 0 && scanOutBytes.data == nil:
            return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window pass1: output allocation")
        let scanKey0 = DevicePagedAttentionWindowHandle(keyPageBuffers, scanPageStart, scanWindowPageCount, 0)
        let scanKey1 = DevicePagedAttentionWindowHandle(keyPageBuffers, scanPageStart, scanWindowPageCount, 1)
        let scanKey2 = DevicePagedAttentionWindowHandle(keyPageBuffers, scanPageStart, scanWindowPageCount, 2)
        let scanKey3 = DevicePagedAttentionWindowHandle(keyPageBuffers, scanPageStart, scanWindowPageCount, 3)
        let scanValue0 = DevicePagedAttentionWindowHandle(valuePageBuffers, scanPageStart, scanWindowPageCount, 0)
        let scanValue1 = DevicePagedAttentionWindowHandle(valuePageBuffers, scanPageStart, scanWindowPageCount, 1)
        let scanValue2 = DevicePagedAttentionWindowHandle(valuePageBuffers, scanPageStart, scanWindowPageCount, 2)
        let scanValue3 = DevicePagedAttentionWindowHandle(valuePageBuffers, scanPageStart, scanWindowPageCount, 3)
        if IsErr(scanKey0) || IsErr(scanKey1) || IsErr(scanKey2) || IsErr(scanKey3) ||
           IsErr(scanValue0) || IsErr(scanValue1) || IsErr(scanValue2) || IsErr(scanValue3):
            rawbytes.BytesFree(scanOutBytes)
            return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window pass1: handle")
        let scanReceiptHandle = __inference_metal_paged_attention_i32_page_buffers_window_handles_output_receipt_bridge(
            queryBuffer.handle,
            Value(scanKey0),
            Value(scanKey1),
            Value(scanKey2),
            Value(scanKey3),
            Value(scanValue0),
            Value(scanValue1),
            Value(scanValue2),
            Value(scanValue3),
            pageTableBuffer.handle,
            scanPageStart,
            scanWindowPageCount,
            pageCount,
            scanOutBytes,
            tokenCount,
            keyDim,
            valueDim,
            tokensPerPage,
            blockCount,
            program.tensors[0].scale
        )
        if scanReceiptHandle == uint64(0):
            rawbytes.BytesFree(scanOutBytes)
            return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window pass1: metal provider failed")
        let scanElapsed = __inference_metal_launch_receipt_elapsed_ns_bridge(scanReceiptHandle)
        let scanWindowBufferHandle = __inference_metal_launch_receipt_output_buffer_handle_bridge(scanReceiptHandle)
        let scanWindowOutputHash = __inference_metal_launch_receipt_output_hash_bridge(scanReceiptHandle)
        let scanWindowScore = __inference_metal_launch_receipt_window_score_bridge(scanReceiptHandle)
        let scanWindowFound = __inference_metal_launch_receipt_window_found_bridge(scanReceiptHandle)
        let scanReceiptRelease = __inference_metal_launch_receipt_release_bridge(scanReceiptHandle)
        rawbytes.BytesFree(scanOutBytes)
        if scanElapsed <= int64(0) || scanWindowOutputHash <= int64(0) || scanReceiptRelease != 0:
            if scanWindowBufferHandle != uint64(0):
                let _releaseScanOnProviderFail = __inference_metal_release_buffer_bridge(scanWindowBufferHandle)
            return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window pass1: metal provider failed")
        totalElapsed = totalElapsed + scanElapsed
        if scanWindowBufferHandle != uint64(0):
            let releaseScanWindow = __inference_metal_release_buffer_bridge(scanWindowBufferHandle)
            if releaseScanWindow != 0:
                return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window pass1: output buffer release")
        if scanWindowFound != 0:
            if !hasGlobalMax || scanWindowScore > globalMax:
                globalMax = scanWindowScore
                hasGlobalMax = true
        scanPageStart = scanPageStart + scanWindowPageCount
    if !hasGlobalMax:
        return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window: no token")

    # ---- pass 2: re-weight every window's tokens against globalMax with
    # the pass2 kernel (raw, undivided per-dimension numer + a shared
    # denom), accumulate Cheng-side across every window, then perform the
    # single final round-div exactly like PagedKVAttentionQueryFill's one
    # global softmax -- not a per-window score/token comparison anymore.
    var globalNumer: int64[]
    for _ in 0..<valueDim:
        add(globalNumer, int64(0))
    var globalDenom: int64
    globalDenom = int64(0)
    let pass2OutCount = valueDim * 2 + 4
    var pageStart: int32
    pageStart = 0
    while pageStart < pageCount:
        var windowPageCount: int32
        windowPageCount = pageCount - pageStart
        if windowPageCount > InferenceDeviceMetalPagedAttentionPageBufferSlotLimit:
            windowPageCount = InferenceDeviceMetalPagedAttentionPageBufferSlotLimit
        var pass2OutBytes = rawbytes.BytesAlloc(pass2OutCount * 4)
        if pass2OutBytes.data == nil:
            return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window pass2: output allocation")
        let key0 = DevicePagedAttentionWindowHandle(keyPageBuffers, pageStart, windowPageCount, 0)
        let key1 = DevicePagedAttentionWindowHandle(keyPageBuffers, pageStart, windowPageCount, 1)
        let key2 = DevicePagedAttentionWindowHandle(keyPageBuffers, pageStart, windowPageCount, 2)
        let key3 = DevicePagedAttentionWindowHandle(keyPageBuffers, pageStart, windowPageCount, 3)
        let value0 = DevicePagedAttentionWindowHandle(valuePageBuffers, pageStart, windowPageCount, 0)
        let value1 = DevicePagedAttentionWindowHandle(valuePageBuffers, pageStart, windowPageCount, 1)
        let value2 = DevicePagedAttentionWindowHandle(valuePageBuffers, pageStart, windowPageCount, 2)
        let value3 = DevicePagedAttentionWindowHandle(valuePageBuffers, pageStart, windowPageCount, 3)
        if IsErr(key0) || IsErr(key1) || IsErr(key2) || IsErr(key3) ||
           IsErr(value0) || IsErr(value1) || IsErr(value2) || IsErr(value3):
            rawbytes.BytesFree(pass2OutBytes)
            return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window pass2: handle")
        let pass2Elapsed = __inference_metal_paged_attention_i32_page_buffers_window_pass2_bridge(
            queryBuffer.handle,
            Value(key0),
            Value(key1),
            Value(key2),
            Value(key3),
            Value(value0),
            Value(value1),
            Value(value2),
            Value(value3),
            pageTableBuffer.handle,
            pageStart,
            windowPageCount,
            pageCount,
            pass2OutBytes,
            tokenCount,
            keyDim,
            valueDim,
            tokensPerPage,
            blockCount,
            program.tensors[0].scale,
            globalMax
        )
        if pass2Elapsed <= int64(0):
            rawbytes.BytesFree(pass2OutBytes)
            return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window pass2: metal provider failed")
        totalElapsed = totalElapsed + pass2Elapsed
        let pass2WindowFound = DeviceReadI32LE(pass2OutBytes, valueDim * 8 + 8)
        if pass2WindowFound != 0:
            for d in 0..<valueDim:
                let numerLo = DeviceReadI32LE(pass2OutBytes, d * 8)
                let numerHi = DeviceReadI32LE(pass2OutBytes, d * 8 + 4)
                globalNumer[d] = globalNumer[d] + DeviceI64FromI32Pair(numerLo, numerHi)
            let denomLo = DeviceReadI32LE(pass2OutBytes, valueDim * 8)
            let denomHi = DeviceReadI32LE(pass2OutBytes, valueDim * 8 + 4)
            globalDenom = globalDenom + DeviceI64FromI32Pair(denomLo, denomHi)
        rawbytes.BytesFree(pass2OutBytes)
        pageStart = pageStart + windowPageCount
    if globalDenom <= int64(0):
        return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window: zero denominator")

    var outputValues: int32[]
    for d in 0..<valueDim:
        add(outputValues, infer.InferenceSaturateI32(infer.InferenceRoundDivI64(globalNumer[d], globalDenom)))
    let packed = DevicePackI32(outputValues)
    if IsErr(packed):
        return Err[DeviceBufferKernelLaunchResult](Error(packed))
    let bestOutput = infer.TensorQ(
        shape: infer.InferenceShapeCopy([valueDim]),
        scale: program.tensors[0].scale,
        data: infer.InferenceIntCopy(outputValues)
    )
    let outputValid = infer.TensorValidate(bestOutput)
    if IsErr(outputValid):
        return Err[DeviceBufferKernelLaunchResult](Error(outputValid))
    var packedBytes = Value(packed)
    let bestBufferHandle = __inference_metal_load_i32_tensor_bytes_buffer_bridge(packedBytes)
    rawbytes.BytesFree(packedBytes)
    if bestBufferHandle == uint64(0):
        return Err[DeviceBufferKernelLaunchResult]("inference device paged attention page buffers window: output buffer upload")
    let outHash = DeviceTensorHash(bestOutput)
    if IsErr(outHash):
        let _releaseAfterHashFail = __inference_metal_release_buffer_bridge(bestBufferHandle)
        return Err[DeviceBufferKernelLaunchResult](Error(outHash))
    let outBuffer = DeviceBufferWithHandle(device,
                                           bestBufferHandle,
                                           int64(Value(outByteCount)),
                                           kir.KernelDtypeI32,
                                           Value(outHash))
    if IsErr(outBuffer):
        let _releaseAfterBufferFail = __inference_metal_release_buffer_bridge(bestBufferHandle)
        return Err[DeviceBufferKernelLaunchResult](Error(outBuffer))
    let receipt = DeviceMetalReceipt(device,
                                     program,
                                     inputHash,
                                     bestOutput,
                                     totalElapsed,
                                     "kernel_ir_facts->file_range_metal_paged_attention_page_buffers_windowed->resident_output_buffer")
    if IsErr(receipt):
        let _releaseAfterReceiptFail = __inference_metal_release_buffer_bridge(bestBufferHandle)
        return Err[DeviceBufferKernelLaunchResult](Error(receipt))
    return Ok[DeviceBufferKernelLaunchResult](DeviceBufferKernelLaunchResult(
        buffer: Value(outBuffer),
        receipt: Value(receipt),
        output: bestOutput
    ))

@borrows
fn DeviceMetalPagedAttentionPageBuffersFill(out: var infer.TensorQ,
                                            device: Device,
                                            program: kir.KernelProgram,
                                            queryBuffer: DeviceBuffer,
                                            queryReceipt: DeviceFileRangeBufferLoadReceipt,
                                            keyPageBuffers: DeviceBuffer[],
                                            keyPageReceipts: DeviceFileRangeBufferLoadReceipt[],
                                            valuePageBuffers: DeviceBuffer[],
                                            valuePageReceipts: DeviceFileRangeBufferLoadReceipt[],
                                            pageTableBuffer: DeviceBuffer,
                                            pageTableReceipt: DeviceFileRangeBufferLoadReceipt): Result[KernelLaunchReceipt] =
    let launched = DeviceMetalPagedAttentionPageBuffersToBufferFill(device,
                                                                   program,
                                                                   queryBuffer,
                                                                   queryReceipt,
                                                                   keyPageBuffers,
                                                                   keyPageReceipts,
                                                                   valuePageBuffers,
                                                                   valuePageReceipts,
                                                                   pageTableBuffer,
                                                                   pageTableReceipt)
    if IsErr(launched):
        return Err[KernelLaunchReceipt](Error(launched))
    var resident = Value(launched)
    let copyOutput = infer.TensorFromDataFill(out,
                                             resident.output.shape,
                                             resident.output.scale,
                                             resident.output.data)
    let releaseOutput = DeviceMetalReleaseBuffer(resident.buffer)
    if IsErr(copyOutput):
        if IsErr(releaseOutput):
            return Err[KernelLaunchReceipt](Error(releaseOutput))
        return Err[KernelLaunchReceipt](Error(copyOutput))
    if IsErr(releaseOutput):
        return Err[KernelLaunchReceipt](Error(releaseOutput))
    resident.receipt.trace = "kernel_ir_facts->file_range_metal_paged_attention_page_buffers->typed_metal_paged_attention_i32"
    return Ok[KernelLaunchReceipt](resident.receipt)

@borrows
fn DeviceMetalPagedAttentionPageBuffersToBufferFill(device: Device,
                                                    program: kir.KernelProgram,
                                                    queryBuffer: DeviceBuffer,
                                                    queryReceipt: DeviceFileRangeBufferLoadReceipt,
                                                    keyPageBuffers: DeviceBuffer[],
                                                    keyPageReceipts: DeviceFileRangeBufferLoadReceipt[],
                                                    valuePageBuffers: DeviceBuffer[],
                                                    valuePageReceipts: DeviceFileRangeBufferLoadReceipt[],
                                                    pageTableBuffer: DeviceBuffer,
                                                    pageTableReceipt: DeviceFileRangeBufferLoadReceipt): Result[DeviceBufferKernelLaunchResult] =
    let inputHash = DeviceValidatePagedAttentionPageBuffersInput(device,
                                                                 program,
                                                                 queryBuffer,
                                                                 queryReceipt,
                                                                 keyPageBuffers,
                                                                 keyPageReceipts,
                                                                 valuePageBuffers,
                                                                 valuePageReceipts,
                                                                 pageTableBuffer,
                                                                 pageTableReceipt)
    if IsErr(inputHash):
        return Err[DeviceBufferKernelLaunchResult](Error(inputHash))
    return DeviceMetalPagedAttentionPageBuffersWindowedToBufferFill(device,
                                                                    program,
                                                                    Value(inputHash),
                                                                    queryBuffer,
                                                                    keyPageBuffers,
                                                                    valuePageBuffers,
                                                                    pageTableBuffer)

fn DeviceUnsupportedLaunchReceipt(device: Device,
                                  kernel: DeviceKernel,
                                  inputHash: int64): KernelLaunchReceipt =
    return KernelLaunchReceipt(
        deviceName: device.name,
        deviceCapabilityHash: device.capabilityHash,
        kernelHash: kernel.kernelHash,
        inputHash: inputHash,
        outputHash: int64(0),
        elapsedNs: int64(0),
        status: InferenceDeviceKernelStatusProviderMissing,
        trace: "hard-fail-no-metal-compute-provider"
    )
