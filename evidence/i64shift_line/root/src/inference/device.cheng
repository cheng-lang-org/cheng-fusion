       rightReceipt.deviceBufferHandle != rightBuffer.handle ||
       leftReceipt.deviceBufferLogicalHash != leftBuffer.logicalHash ||
       rightReceipt.deviceBufferLogicalHash != rightBuffer.logicalHash ||
       leftReceipt.deviceBufferSizeBytes != leftBuffer.sizeBytes ||
       rightReceipt.deviceBufferSizeBytes != rightBuffer.sizeBytes:
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: receipt buffer")
    if leftReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       rightReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       leftBuffer.handle == uint64(0) ||
       rightBuffer.handle == uint64(0):
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: provider handle")
    if leftBuffer.dtype != kir.KernelDtypeI32 || rightBuffer.dtype != kir.KernelDtypeI32:
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: dtype")
    if program.tensors[0].shape.len != 2 ||
       program.tensors[1].shape.len != 2 ||
       program.tensors[2].shape.len != 2:
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: tensor rank")
    let rows = program.ops[0].rows
    let cols = program.ops[0].cols
    let inner = program.ops[0].inner
    if rows <= 0 || cols <= 0 || inner <= 0:
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: dims")
    if program.tensors[0].shape[0] != rows ||
       program.tensors[0].shape[1] != inner ||
       program.tensors[1].shape[0] != inner ||
       program.tensors[1].shape[1] != cols ||
       program.tensors[2].shape[0] != rows ||
       program.tensors[2].shape[1] != cols:
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: KernelIR tensor shape")
    if leftReceipt.tensorShape.len != 2 ||
       rightReceipt.tensorShape.len != 2 ||
       leftReceipt.tensorShape[0] != rows ||
       leftReceipt.tensorShape[1] != inner ||
       rightReceipt.tensorShape[0] != inner ||
       rightReceipt.tensorShape[1] != cols ||
       leftReceipt.tensorScale != program.tensors[0].scale ||
       rightReceipt.tensorScale != program.tensors[1].scale ||
       leftReceipt.tensorElementCount != rows * inner ||
       rightReceipt.tensorElementCount != inner * cols:
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: receipt tensor")
    if program.tensors[0].scale != program.tensors[1].scale ||
       program.tensors[2].scale != program.tensors[0].scale:
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: scale")
    let leftBytes = DeviceI32BytesRequired(rows * inner)
    if IsErr(leftBytes):
        return Err[DeviceResidentBufferKernelLaunchResult](Error(leftBytes))
    let rightBytes = DeviceI32BytesRequired(inner * cols)
    if IsErr(rightBytes):
        return Err[DeviceResidentBufferKernelLaunchResult](Error(rightBytes))
    let outBytes = DeviceI32BytesRequired(rows * cols)
    if IsErr(outBytes):
        return Err[DeviceResidentBufferKernelLaunchResult](Error(outBytes))
    if leftBuffer.sizeBytes != int64(Value(leftBytes)) ||
       rightBuffer.sizeBytes != int64(Value(rightBytes)):
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: byte size")
    let inputHash = DeviceBufferBufferInputHash(
        program.kernelHash,
        leftBuffer,
        leftReceipt.receiptHash,
        rightBuffer,
        rightReceipt.receiptHash
    )
    if IsErr(inputHash):
        return Err[DeviceResidentBufferKernelLaunchResult](Error(inputHash))
    let providerReceiptHandle = __inference_metal_gemm_i32_buffers_launch_receipt_bridge(
        leftBuffer.handle,
        rightBuffer.handle,
        rows,
        cols,
        inner,
        program.tensors[0].scale
    )
    if providerReceiptHandle == uint64(0):
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: metal provider failed")
    let elapsed = __inference_metal_launch_receipt_elapsed_ns_bridge(providerReceiptHandle)
    let outHandle = __inference_metal_launch_receipt_output_buffer_handle_bridge(providerReceiptHandle)
    let outputHash = __inference_metal_launch_receipt_output_hash_bridge(providerReceiptHandle)
    let providerReceiptRelease = __inference_metal_launch_receipt_release_bridge(providerReceiptHandle)
    if elapsed <= int64(0) || outHandle == uint64(0) || outputHash <= int64(0) || providerReceiptRelease != 0:
        if outHandle != uint64(0):
            let _releaseFailedOut = __inference_metal_release_buffer_bridge(outHandle)
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: metal provider failed")
    let outBuffer = DeviceBufferWithHandle(device,
                                           outHandle,
                                           int64(Value(outBytes)),
                                           kir.KernelDtypeI32,
                                           outputHash)
    if IsErr(outBuffer):
        let _releaseAfterBufferFail = __inference_metal_release_buffer_bridge(outHandle)
        return Err[DeviceResidentBufferKernelLaunchResult](Error(outBuffer))
    let receipt = DeviceMetalReceiptFromOutputHash(
        device,
        program,
        Value(inputHash),
        outputHash,
        elapsed,
        "kernel_ir_facts->metal_gemm_buffers->resident_output_buffer"
    )
    if IsErr(receipt):
        let _releaseAfterReceiptFail = __inference_metal_release_buffer_bridge(outHandle)
        return Err[DeviceResidentBufferKernelLaunchResult](Error(receipt))
    return Ok[DeviceResidentBufferKernelLaunchResult](DeviceResidentBufferKernelLaunchResult(
        buffer: Value(outBuffer),
        receipt: Value(receipt)
    ))

@borrows
fn DeviceMetalLinearOutInInt4WeightBuffersFill(out: var infer.TensorQ,
                                               device: Device,
                                               program: kir.KernelProgram,
                                               leftBuffer: DeviceBuffer,
                                               leftReceipt: DeviceTensorBufferLoadReceipt,
                                               rightBuffer: DeviceBuffer,
