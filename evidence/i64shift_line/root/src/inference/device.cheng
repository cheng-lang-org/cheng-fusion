@borrows
fn DeviceValidatePageTable(pageTable: infer.TensorQ, pageCount: int32): Result[bool] =
    let ok = infer.TensorValidate(pageTable)
    if IsErr(ok):
        return Err[bool](Error(ok))
    if pageTable.scale != 1 || pageTable.shape.len != 1:
        return Err[bool]("inference device paged attention: page table shape")
    for i in 0..<pageTable.data.len:
        if pageTable.data[i] < 0 || pageTable.data[i] >= pageCount:
            return Err[bool]("inference device paged attention: page table ordinal")
    return Ok[bool](true)

@borrows
fn DeviceValidatePageTableFileRangeReceipt(pageTableReceipt: DeviceFileRangeBufferLoadReceipt,
                                           pageCount: int32,
                                           blockCount: int32): Result[bool] =
    if pageCount <= 0 || blockCount <= 0:
        return Err[bool]("inference device paged attention buffers: page table dims")
    let tableBytes = DeviceI32BytesRequired(blockCount)
    if IsErr(tableBytes):
        return Err[bool](Error(tableBytes))
    if pageTableReceipt.byteCount != int64(Value(tableBytes)):
        return Err[bool]("inference device paged attention buffers: page table byte size")
    let bytes = os.ReadFileRangeBytesResult(pageTableReceipt.filePath,
                                            pageTableReceipt.offsetBytes,
                                            Value(tableBytes))
    if IsErr(bytes):
        return Err[bool](Error(bytes))
    if rawbytes.BytesLen(Value(bytes)) != Value(tableBytes):
        return Err[bool]("inference device paged attention buffers: page table short read")
    for i in 0..<blockCount:
        let ordinal = DeviceReadI32LE(Value(bytes), i * 4)
        if ordinal < 0 || ordinal >= pageCount:
            return Err[bool]("inference device paged attention buffers: page table ordinal")
    return Ok[bool](true)

@borrows
fn DeviceMetalPagedAttentionBuffersFill(out: var infer.TensorQ,
                                       device: Device,
                                       program: kir.KernelProgram,
                                       queryBuffer: DeviceBuffer,
                                       queryReceipt: DeviceFileRangeBufferLoadReceipt,
                                       keysBuffer: DeviceBuffer,
                                       keysReceipt: DeviceFileRangeBufferLoadReceipt,
                                       valuesBuffer: DeviceBuffer,
                                       valuesReceipt: DeviceFileRangeBufferLoadReceipt,
                                       pageTableBuffer: DeviceBuffer,
                                       pageTableReceipt: DeviceFileRangeBufferLoadReceipt): Result[KernelLaunchReceipt] =
    let launched = DeviceMetalPagedAttentionBuffersToBufferFill(device,
                                                               program,
                                                               queryBuffer,
                                                               queryReceipt,
                                                               keysBuffer,
                                                               keysReceipt,
                                                               valuesBuffer,
                                                               valuesReceipt,
                                                               pageTableBuffer,
                                                               pageTableReceipt)
    if IsErr(launched):
        return Err[KernelLaunchReceipt](Error(launched))
    var resident = Value(launched)
    let copyOutput = infer.TensorFromDataFill(out,
                                             resident.output.shape,
                                             resident.output.scale,
                                             resident.output.data)
    let releaseOutput = DeviceMetalReleaseBuffer(resident.buffer)
    if IsErr(copyOutput):
        if IsErr(releaseOutput):
            return Err[KernelLaunchReceipt](Error(releaseOutput))
        return Err[KernelLaunchReceipt](Error(copyOutput))
    if IsErr(releaseOutput):
        return Err[KernelLaunchReceipt](Error(releaseOutput))
    resident.receipt.trace = "kernel_ir_facts->file_range_metal_paged_attention_buffers->typed_metal_paged_attention_i32"
    return Ok[KernelLaunchReceipt](resident.receipt)

