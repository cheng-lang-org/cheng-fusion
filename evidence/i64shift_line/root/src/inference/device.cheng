@borrows
fn DeviceTensorPagedAttentionBuffersInputHash(programHash: int64,
                                              queryBuffer: DeviceBuffer,
                                              queryReceipt: DeviceFileRangeBufferLoadReceipt,
                                              keysBuffer: DeviceBuffer,
                                              keysReceipt: DeviceFileRangeBufferLoadReceipt,
                                              valuesBuffer: DeviceBuffer,
                                              valuesReceipt: DeviceFileRangeBufferLoadReceipt,
                                              pageTableBuffer: DeviceBuffer,
                                              pageTableReceipt: DeviceFileRangeBufferLoadReceipt): Result[int64] =
    if queryBuffer.logicalHash <= int64(0) || queryReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: paged attention query buffer input hash")
    if keysBuffer.logicalHash <= int64(0) || keysReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: paged attention keys buffer input hash")
    if valuesBuffer.logicalHash <= int64(0) || valuesReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: paged attention values buffer input hash")
    if pageTableBuffer.logicalHash <= int64(0) || pageTableReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: paged attention page table buffer input hash")
    var h: int64 = DeviceHashStep(programHash, queryBuffer.logicalHash)
    h = DeviceHashStep(h, queryReceipt.receiptHash)
    h = DeviceHashStep(h, keysBuffer.logicalHash)
    h = DeviceHashStep(h, keysReceipt.receiptHash)
    h = DeviceHashStep(h, valuesBuffer.logicalHash)
    h = DeviceHashStep(h, valuesReceipt.receiptHash)
    h = DeviceHashStep(h, pageTableBuffer.logicalHash)
    h = DeviceHashStep(h, pageTableReceipt.receiptHash)
    return Ok[int64](h)

@borrows
fn DeviceTensorPagedAttentionPageBuffersInputHash(programHash: int64,
                                                  queryBuffer: DeviceBuffer,
                                                  queryReceipt: DeviceFileRangeBufferLoadReceipt,
                                                  keyPageBuffers: DeviceBuffer[],
                                                  keyPageReceipts: DeviceFileRangeBufferLoadReceipt[],
                                                  valuePageBuffers: DeviceBuffer[],
                                                  valuePageReceipts: DeviceFileRangeBufferLoadReceipt[],
                                                  pageTableBuffer: DeviceBuffer,
                                                  pageTableReceipt: DeviceFileRangeBufferLoadReceipt): Result[int64] =
    if queryBuffer.logicalHash <= int64(0) || queryReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: paged attention page buffers query input hash")
    if keyPageBuffers.len <= 0 ||
       keyPageBuffers.len != keyPageReceipts.len ||
       valuePageBuffers.len != valuePageReceipts.len ||
       keyPageBuffers.len != valuePageBuffers.len:
        return Err[int64]("inference device: paged attention page buffers input count")
    if pageTableBuffer.logicalHash <= int64(0) || pageTableReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: paged attention page buffers page table input hash")
    var h: int64 = DeviceHashStep(programHash, queryBuffer.logicalHash)
    h = DeviceHashStep(h, queryReceipt.receiptHash)
    for i in 0..<keyPageBuffers.len:
        if keyPageBuffers[i].logicalHash <= int64(0) ||
           keyPageReceipts[i].receiptHash <= int64(0) ||
           valuePageBuffers[i].logicalHash <= int64(0) ||
           valuePageReceipts[i].receiptHash <= int64(0):
            return Err[int64]("inference device: paged attention page buffers input hash")
        h = DeviceHashStep(h, keyPageBuffers[i].logicalHash)
        h = DeviceHashStep(h, keyPageReceipts[i].receiptHash)
        h = DeviceHashStep(h, valuePageBuffers[i].logicalHash)
        h = DeviceHashStep(h, valuePageReceipts[i].receiptHash)
    h = DeviceHashStep(h, pageTableBuffer.logicalHash)
    h = DeviceHashStep(h, pageTableReceipt.receiptHash)
    return Ok[int64](h)

@borrows
fn DeviceTensorPagedAttentionTensorPageBuffersInputHash(programHash: int64,
                                                        queryBuffer: DeviceBuffer,
                                                        queryReceipt: DeviceTensorBufferLoadReceipt,
                                                        keyPageBuffers: DeviceBuffer[],
                                                        keyPageReceipts: DeviceTensorBufferLoadReceipt[],
                                                        valuePageBuffers: DeviceBuffer[],
                                                        valuePageReceipts: DeviceTensorBufferLoadReceipt[],
                                                        pageTableBuffer: DeviceBuffer,
                                                        pageTableReceipt: DeviceTensorBufferLoadReceipt): Result[int64] =
    if queryBuffer.logicalHash <= int64(0) || queryReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: paged attention tensor page buffers query input hash")
    if keyPageBuffers.len <= 0 ||
       keyPageBuffers.len != keyPageReceipts.len ||
       valuePageBuffers.len != valuePageReceipts.len ||
       keyPageBuffers.len != valuePageBuffers.len:
        return Err[int64]("inference device: paged attention tensor page buffers input count")
    if pageTableBuffer.logicalHash <= int64(0) || pageTableReceipt.receiptHash <= int64(0):
        return Err[int64]("inference device: paged attention tensor page buffers page table input hash")
    var h: int64 = DeviceHashStep(programHash, queryBuffer.logicalHash)
    h = DeviceHashStep(h, queryReceipt.receiptHash)
    for i in 0..<keyPageBuffers.len:
        if keyPageBuffers[i].logicalHash <= int64(0) ||
           keyPageReceipts[i].receiptHash <= int64(0) ||
           valuePageBuffers[i].logicalHash <= int64(0) ||
           valuePageReceipts[i].receiptHash <= int64(0):
            return Err[int64]("inference device: paged attention tensor page buffers input hash")
        h = DeviceHashStep(h, keyPageBuffers[i].logicalHash)
        h = DeviceHashStep(h, keyPageReceipts[i].receiptHash)
        h = DeviceHashStep(h, valuePageBuffers[i].logicalHash)
        h = DeviceHashStep(h, valuePageReceipts[i].receiptHash)
    h = DeviceHashStep(h, pageTableBuffer.logicalHash)
    h = DeviceHashStep(h, pageTableReceipt.receiptHash)
    return Ok[int64](h)

fn DeviceI32BytesRequired(count: int32): Result[int32] =
    if count < 0:
        return Err[int32]("inference device: negative element count")
    if count > 536870911:
        return Err[int32]("inference device: tensor byte size overflow")
    return Ok[int32](count * 4)

fn DeviceWriteI32LE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, value & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(buf, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(buf, offset + 3, (value >> 24) & 255)

fn DeviceWriteU64LE(buf: var rawbytes.Bytes, offset: int32, value: uint64) =
    rawbytes.BytesSet(buf, offset, int32(value & uint64(255)))
    rawbytes.BytesSet(buf, offset + 1, int32((value >> uint64(8)) & uint64(255)))
    rawbytes.BytesSet(buf, offset + 2, int32((value >> uint64(16)) & uint64(255)))
    rawbytes.BytesSet(buf, offset + 3, int32((value >> uint64(24)) & uint64(255)))
    rawbytes.BytesSet(buf, offset + 4, int32((value >> uint64(32)) & uint64(255)))
    rawbytes.BytesSet(buf, offset + 5, int32((value >> uint64(40)) & uint64(255)))
    rawbytes.BytesSet(buf, offset + 6, int32((value >> uint64(48)) & uint64(255)))
    rawbytes.BytesSet(buf, offset + 7, int32((value >> uint64(56)) & uint64(255)))

fn DeviceReadI32LE(buf: rawbytes.Bytes, offset: int32): int32 =
    let b0: int64 = int64(rawbytes.BytesGet(buf, offset) & 255)
    let b1: int64 = int64(rawbytes.BytesGet(buf, offset + 1) & 255)
    let b2: int64 = int64(rawbytes.BytesGet(buf, offset + 2) & 255)
    let b3: int64 = int64(rawbytes.BytesGet(buf, offset + 3) & 255)
    var raw: int64 = b0 + b1 * int64(256) + b2 * int64(65536) + b3 * int64(16777216)
    if raw > int64(2147483647):
        raw = raw - int64(4294967296)
    return int32(raw)

# Lossless int64 reconstruction from a (lo32, hi32) pair as written by the
# Metal paged-attention pass-2 kernel (`out[2*d]=int(v); out[2*d+1]=int(v>>32)`
# for a `long v`): hi is always exactly representable in int32 because an
# arithmetic right shift of any int64 by 32 yields a value in [-2^31, 2^31),
# and lo carries the low 32 bits verbatim (two's complement), so this is an
# exact 64-bit decode, not an approximation.
fn DeviceI64FromI32Pair(lo: int32, hi: int32): int64 =
    let two32: int64 = int64(4294967296)
    var loUnsigned: int64 = int64(lo)
    if lo < 0:
        loUnsigned = loUnsigned + two32
    return int64(hi) * two32 + loUnsigned

@borrows
fn DevicePackI32(values: int32[]): Result[rawbytes.Bytes] =
    let byteCount = DeviceI32BytesRequired(values.len)
    if IsErr(byteCount):
        return Err[rawbytes.Bytes](Error(byteCount))
    var out = rawbytes.BytesAlloc(Value(byteCount))
    if Value(byteCount) > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("inference device: tensor byte allocation failed")
    for i in 0..<values.len:
        DeviceWriteI32LE(out, i * 4, values[i])
    return Ok[rawbytes.Bytes](out)

fn DevicePackBufferHandles(buffers: DeviceBuffer[]): Result[rawbytes.Bytes] =
    if buffers.len <= 0:
        return Err[rawbytes.Bytes]("inference device: buffer handle pack count")
    if buffers.len > 268435455:
        return Err[rawbytes.Bytes]("inference device: buffer handle pack overflow")
    let byteCount = buffers.len * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("inference device: buffer handle pack allocation")
    for i in 0..<buffers.len:
        if buffers[i].handle == uint64(0):
            rawbytes.BytesFree(out)
            return Err[rawbytes.Bytes]("inference device: buffer handle pack zero")
        DeviceWriteU64LE(out, i * 8, buffers[i].handle)
    return Ok[rawbytes.Bytes](out)

fn DevicePackBufferHandlesWindow(buffers: DeviceBuffer[], start: int32, count: int32): Result[rawbytes.Bytes] =
    if start < 0 || count <= 0:
        return Err[rawbytes.Bytes]("inference device: buffer handle window range")
    if start > buffers.len || count > buffers.len - start:
        return Err[rawbytes.Bytes]("inference device: buffer handle window bounds")
    let byteCount = count * 8
    var out = rawbytes.BytesAlloc(byteCount)
    if byteCount > 0 && out.data == nil:
        return Err[rawbytes.Bytes]("inference device: buffer handle window allocation")
    for i in 0..<count:
        let buffer = buffers[start + i]
        if buffer.handle == uint64(0):
            rawbytes.BytesFree(out)
            return Err[rawbytes.Bytes]("inference device: buffer handle window zero")
        DeviceWriteU64LE(out, i * 8, buffer.handle)
    return Ok[rawbytes.Bytes](out)

@borrows
fn DevicePagedAttentionWindowHandle(buffers: DeviceBuffer[], start: int32, count: int32, slot: int32): Result[uint64] =
    if start < 0 || count <= 0 || slot < 0 || slot >= InferenceDeviceMetalPagedAttentionPageBufferSlotLimit:
        return Err[uint64]("inference device: page window handle range")
    if start > buffers.len || count > buffers.len - start:
        return Err[uint64]("inference device: page window handle bounds")
    var local = slot
    if local >= count:
        local = 0
    let handle = buffers[start + local].handle
    if handle == uint64(0):
        return Err[uint64]("inference device: page window handle zero")
    return Ok[uint64](handle)

fn DeviceTensorFromI32BytesFill(out: var infer.TensorQ,
                                shape: int32[],
                                scale: int32,
                                bytes: rawbytes.Bytes): Result[bool] =
    let countRes = infer.TensorElementCount(shape)
    if IsErr(countRes):
        return Err[bool](Error(countRes))
    let byteCount = DeviceI32BytesRequired(Value(countRes))
    if IsErr(byteCount):
        return Err[bool](Error(byteCount))
    if rawbytes.BytesLen(bytes) != Value(byteCount):
        return Err[bool]("inference device: output byte length mismatch")
    let zeros = infer.TensorZerosFill(out, shape, scale)
    if IsErr(zeros):
        return Err[bool](Error(zeros))
    for i in 0..<out.data.len:
        out.data[i] = DeviceReadI32LE(bytes, i * 4)
    return Ok[bool](true)

fn DeviceTensorFromI32Bytes(shape: int32[],
                            scale: int32,
                            bytes: rawbytes.Bytes): Result[infer.TensorQ] =
    let countRes = infer.TensorElementCount(shape)
    if IsErr(countRes):
        return Err[infer.TensorQ](Error(countRes))
    let byteCount = DeviceI32BytesRequired(Value(countRes))
    if IsErr(byteCount):
        return Err[infer.TensorQ](Error(byteCount))
    if rawbytes.BytesLen(bytes) != Value(byteCount):
        return Err[infer.TensorQ]("inference device: output byte length mismatch")
    var values: int32[]
    for i in 0..<Value(countRes):
        add(values, DeviceReadI32LE(bytes, i * 4))
    let out = infer.TensorQ(
        shape: infer.InferenceShapeCopy(shape),
        scale: scale,
        data: values
    )
    let ok = infer.TensorValidate(out)
    if IsErr(ok):
        return Err[infer.TensorQ](Error(ok))
    return Ok[infer.TensorQ](out)

fn DeviceFp8E4M3RawByteValid(raw: int32): bool =
    let byteValue = raw & 255
    let exp = (byteValue >> 3) & 15
    let frac = byteValue & 7
    return !(exp == 15 && frac == 7)

@borrows
fn DeviceValidateFp8E4M3FileRangeReceipt(receipt: DeviceFileRangeBufferLoadReceipt,
                                         expectedCount: int32): Result[bool] =
    if expectedCount <= 0:
        return Err[bool]("inference device fp8 e4m3 range: count")
    if receipt.byteCount != int64(expectedCount):
        return Err[bool]("inference device fp8 e4m3 range: byte size")
    let bytes = os.ReadFileRangeBytesResult(receipt.filePath, receipt.offsetBytes, expectedCount)
    if IsErr(bytes):
        return Err[bool](Error(bytes))
    if rawbytes.BytesLen(Value(bytes)) != expectedCount:
        return Err[bool]("inference device fp8 e4m3 range: short read")
    for i in 0..<expectedCount:
        if !DeviceFp8E4M3RawByteValid(rawbytes.BytesGet(Value(bytes), i)):
            return Err[bool]("inference device fp8 e4m3 range: nan")
    return Ok[bool](true)

@borrows
fn DeviceValidateMetalProgram(program: kir.KernelProgram, opKind: str, tensorCount: int32): Result[bool] =
    let ok = kir.KernelIrValidateProgram(program)
    if IsErr(ok):
        return Err[bool](Error(ok))
    if program.targetBackend != InferenceDeviceBackendMetal:
        return Err[bool]("inference device: KernelIR target must be metal")
    if program.ops.len != 1 || program.ops[0].opKind != opKind:
        return Err[bool]("inference device: KernelIR op mismatch")
    if program.tensors.len != tensorCount:
        return Err[bool]("inference device: KernelIR tensor count")
    return Ok[bool](true)

@borrows
fn DeviceMetalReceipt(device: Device,
                      program: kir.KernelProgram,
                      inputHash: int64,
                      output: infer.TensorQ,
                      elapsedNs: int64,
                      trace: str): Result[KernelLaunchReceipt] =
    let outHash = DeviceTensorHash(output)
    if IsErr(outHash):
        return Err[KernelLaunchReceipt](Error(outHash))
    if elapsedNs <= int64(0):
        return Err[KernelLaunchReceipt]("inference device: metal elapsed ns")
    return Ok[KernelLaunchReceipt](KernelLaunchReceipt(
        deviceName: share(device.name),
        deviceCapabilityHash: share(device.capabilityHash),
        kernelHash: program.kernelHash,
        inputHash: inputHash,
        outputHash: Value(outHash),
        elapsedNs: elapsedNs,
        status: InferenceDeviceKernelStatusLaunched,
        trace: strings.CloneStr(trace)
    ))

@borrows
fn DeviceMetalReceiptFromOutputHash(device: Device,
                                    program: kir.KernelProgram,
                                    inputHash: int64,
                                    outputHash: int64,
                                    elapsedNs: int64,
                                    trace: str): Result[KernelLaunchReceipt] =
    if outputHash <= int64(0):
        return Err[KernelLaunchReceipt]("inference device: metal output hash")
    if elapsedNs <= int64(0):
        return Err[KernelLaunchReceipt]("inference device: metal elapsed ns")
    return Ok[KernelLaunchReceipt](KernelLaunchReceipt(
        deviceName: share(device.name),
        deviceCapabilityHash: share(device.capabilityHash),
        kernelHash: program.kernelHash,
        inputHash: inputHash,
        outputHash: outputHash,
        elapsedNs: elapsedNs,
        status: InferenceDeviceKernelStatusLaunched,
        trace: strings.CloneStr(trace)
    ))

fn DeviceCapabilityHash(backend: str, capabilityMask: int32, provider: str): str =
    return strutil.Join([
        "cheng.inference.device.v1:",
        backend,
        ":",
        strings.IntToStr(capabilityMask),
        ":",
        provider
    ], "")

fn DeviceProbeMetal(): Result[Device] =
    let probeRes = platform.MediaPlatformDarwinProbeStrict()
    if IsErr(probeRes):
        return Err[Device](Error(probeRes))
    let probe = Value(probeRes)
    if !probe.metalReady:
        return Err[Device]("inference device: metal unavailable")
    let capHash = DeviceCapabilityHash(
        InferenceDeviceBackendMetal,
        InferenceDeviceCapabilityMetalCompute,
        probe.textureProvider
    )
    return Ok[Device](Device(
        backend: InferenceDeviceBackendMetal,
        name: probe.textureProvider,
        capabilityHash: capHash,
        capabilityMask: InferenceDeviceCapabilityMetalCompute,
        ready: true
    ))

fn DeviceProbeNpu(): Result[Device] =
    return Err[Device]("inference device: npu backend unsupported")

fn DeviceBufferLogical(device: Device, sizeBytes: int64, dtype: str, logicalHash: int64): DeviceBuffer =
    return DeviceBuffer(
        deviceCapabilityHash: device.capabilityHash,
        handle: uint64(0),
        sizeBytes: sizeBytes,
        dtype: dtype,
        logicalHash: logicalHash
    )

@borrows
fn DeviceBufferWithHandle(device: Device,
                          handle: uint64,
                          sizeBytes: int64,
                          dtype: str,
                          logicalHash: int64): Result[DeviceBuffer] =
    if device.capabilityHash == "" || handle == uint64(0) || sizeBytes <= int64(0) || dtype == "" || logicalHash <= int64(0):
        return Err[DeviceBuffer]("inference device buffer handle: invalid")
    return Ok[DeviceBuffer](DeviceBuffer(
        deviceCapabilityHash: share(device.capabilityHash),
        handle: handle,
        sizeBytes: sizeBytes,
        dtype: strings.CloneStr(dtype),
        logicalHash: logicalHash
    ))

fn DeviceMetalLoadFileRangeBuffer(device: Device,
                                  filePath: str,
                                  offsetBytes: int64,
                                  byteCount: int64,
                                  chunkBytes: int32,
                                  dtype: str): Result[DeviceFileRangeBufferLoadResult] =
    return DeviceMetalLoadFileRangeBufferChunked(device, filePath, offsetBytes, byteCount, chunkBytes, dtype)

fn DeviceMetalLoadFileRangeBufferChunked(device: Device,
                                         filePath: str,
                                         offsetBytes: int64,
                                         byteCount: int64,
                                         chunkBytes: int32,
                                         dtype: str): Result[DeviceFileRangeBufferLoadResult] =
    if device.backend != InferenceDeviceBackendMetal || !device.ready:
        return Err[DeviceFileRangeBufferLoadResult]("inference device metal buffer load: ready metal device")
    if filePath == "" || offsetBytes < int64(0) || byteCount <= int64(0):
        return Err[DeviceFileRangeBufferLoadResult]("inference device metal buffer load: range")
    if dtype == "":
        return Err[DeviceFileRangeBufferLoadResult]("inference device metal buffer load: dtype")
    let sourceHash = DeviceHashFileRangePath(filePath, offsetBytes, byteCount, chunkBytes)
    if IsErr(sourceHash):
        return Err[DeviceFileRangeBufferLoadResult](Error(sourceHash))
    let pathText: cstring = strToCStringTemp(filePath)
    let handle = __inference_metal_load_file_range_buffer_chunked_bridge(
        pathText,
        offsetBytes,
        byteCount,
        chunkBytes
    )
    if handle == uint64(0):
        return Err[DeviceFileRangeBufferLoadResult]("inference device metal buffer load: provider")
    let buffer = DeviceBufferWithHandle(device, handle, byteCount, dtype, Value(sourceHash))
    if IsErr(buffer):
        let _releaseAfterBufferFailure = __inference_metal_release_buffer_bridge(handle)
        return Err[DeviceFileRangeBufferLoadResult](Error(buffer))
    let receipt = DeviceBuildFileRangeBufferLoadReceiptWithStatus(
        device,
        Value(buffer),
        filePath,
        offsetBytes,
        byteCount,
        chunkBytes,
        InferenceDeviceBufferLoadStatusMetalBufferLoaded
    )
    if IsErr(receipt):
        let _releaseAfterReceiptFailure = __inference_metal_release_buffer_bridge(handle)
        return Err[DeviceFileRangeBufferLoadResult](Error(receipt))
    return Ok[DeviceFileRangeBufferLoadResult](DeviceFileRangeBufferLoadResult(
        buffer: Value(buffer),
        receipt: Value(receipt)
    ))

@borrows
fn DeviceMetalLoadTensorI32Buffer(device: Device,
                                  tensor: infer.TensorQ): Result[DeviceTensorBufferLoadResult] =
    if device.backend != InferenceDeviceBackendMetal || !device.ready:
        return Err[DeviceTensorBufferLoadResult]("inference device metal tensor buffer load: ready metal device")
    let tensorOk = infer.TensorValidate(tensor)
    if IsErr(tensorOk):
        return Err[DeviceTensorBufferLoadResult](Error(tensorOk))
    let byteCount = DeviceI32BytesRequired(tensor.data.len)
    if IsErr(byteCount):
        return Err[DeviceTensorBufferLoadResult](Error(byteCount))
    if Value(byteCount) <= 0:
        return Err[DeviceTensorBufferLoadResult]("inference device metal tensor buffer load: empty tensor")
    let bytes = DevicePackI32(tensor.data)
    if IsErr(bytes):
        return Err[DeviceTensorBufferLoadResult](Error(bytes))
    var packed = Value(bytes)
    let handle = __inference_metal_load_i32_tensor_bytes_buffer_bridge(packed)
    rawbytes.BytesFree(packed)
    if handle == uint64(0):
        return Err[DeviceTensorBufferLoadResult]("inference device metal tensor buffer load: provider")
    let tensorHash = DeviceTensorHash(tensor)
    if IsErr(tensorHash):
        let _releaseOnHashFail = __inference_metal_release_buffer_bridge(handle)
        return Err[DeviceTensorBufferLoadResult](Error(tensorHash))
    let buffer = DeviceBufferWithHandle(device, handle, int64(Value(byteCount)), kir.KernelDtypeI32, Value(tensorHash))
    if IsErr(buffer):
        let _releaseOnBufferFail = __inference_metal_release_buffer_bridge(handle)
        return Err[DeviceTensorBufferLoadResult](Error(buffer))
    let receipt = DeviceBuildTensorBufferLoadReceiptWithStatus(
        device,
        Value(buffer),
        tensor,
        InferenceDeviceBufferLoadStatusMetalBufferLoaded
    )
    if IsErr(receipt):
        let _releaseOnReceiptFail = __inference_metal_release_buffer_bridge(handle)
        return Err[DeviceTensorBufferLoadResult](Error(receipt))
    return Ok[DeviceTensorBufferLoadResult](DeviceTensorBufferLoadResult(
        buffer: Value(buffer),
        receipt: Value(receipt)
    ))

@borrows
fn DeviceMetalLoadRawTensorBytesBuffer(device: Device,
                                       dtype: str,
                                       shape: int32[],
                                       scale: int32,
                                       rawBytes: rawbytes.Bytes): Result[DeviceRawTensorBytesBufferLoadResult] =
    if device.backend != InferenceDeviceBackendMetal || !device.ready:
        return Err[DeviceRawTensorBytesBufferLoadResult]("inference device metal raw tensor buffer load: ready metal device")
    let byteCount = DeviceRawTensorBytesExpectedByteCount(dtype, shape)
    if IsErr(byteCount):
        return Err[DeviceRawTensorBytesBufferLoadResult](Error(byteCount))
    if Value(byteCount) <= int64(0) || int64(rawbytes.BytesLen(rawBytes)) != Value(byteCount):
        return Err[DeviceRawTensorBytesBufferLoadResult]("inference device metal raw tensor buffer load: byte count")
    let rawHash = DeviceRawTensorBytesHash(dtype, shape, scale, rawBytes)
    if IsErr(rawHash):
        return Err[DeviceRawTensorBytesBufferLoadResult](Error(rawHash))
    var rawCopy = rawbytes.BytesAlloc(rawbytes.BytesLen(rawBytes))
    if rawbytes.BytesLen(rawBytes) > 0 && rawCopy.data == nil:
        return Err[DeviceRawTensorBytesBufferLoadResult]("inference device metal raw tensor buffer load: copy")
    rawbytes.BytesCopyInto(rawCopy, 0, rawBytes)
    let handle = __inference_metal_load_i32_tensor_bytes_buffer_bridge(rawCopy)
    rawbytes.BytesFree(rawCopy)
    if handle == uint64(0):
        return Err[DeviceRawTensorBytesBufferLoadResult]("inference device metal raw tensor buffer load: provider")
    let buffer = DeviceBufferWithHandle(device, handle, Value(byteCount), dtype, Value(rawHash))
    if IsErr(buffer):
        let _releaseOnBufferFail = __inference_metal_release_buffer_bridge(handle)
        return Err[DeviceRawTensorBytesBufferLoadResult](Error(buffer))
    let receipt = DeviceBuildRawTensorBytesBufferLoadReceiptWithStatus(
        device,
        Value(buffer),
        dtype,
        shape,
        scale,
        rawBytes,
        InferenceDeviceBufferLoadStatusMetalBufferLoaded
    )
    if IsErr(receipt):
        let _releaseOnReceiptFail = __inference_metal_release_buffer_bridge(handle)
        return Err[DeviceRawTensorBytesBufferLoadResult](Error(receipt))
    return Ok[DeviceRawTensorBytesBufferLoadResult](DeviceRawTensorBytesBufferLoadResult(
        buffer: Value(buffer),
        receipt: Value(receipt)
    ))

@borrows
fn DeviceMetalReleaseBuffer(buffer: DeviceBuffer): Result[bool] =
    if buffer.handle == uint64(0):
        return Err[bool]("inference device metal buffer release: handle")
    let rc = __inference_metal_release_buffer_bridge(buffer.handle)
    if rc != 0:
        return Err[bool]("inference device metal buffer release: provider")
    return Ok[bool](true)

fn DeviceKernelFromKernelIr(device: Device, opKind: str, kernelHash: int64): DeviceKernel =
    return DeviceKernel(
        opKind: opKind,
        kernelHash: kernelHash,
        deviceCapabilityHash: device.capabilityHash,
        sourceKind: "kernel_ir_facts",
        ready: false
    )

fn DeviceMetalLaunchKernel(device: Device,
                           kernel: DeviceKernel,
                           inputHash: int64): Result[KernelLaunchReceipt] =
    if device.backend != InferenceDeviceBackendMetal:
        return Err[KernelLaunchReceipt]("inference device: launch requires metal device")
    if kernel.sourceKind != "kernel_ir_facts":
        return Err[KernelLaunchReceipt]("inference device: kernel must come from KernelIR facts")
    return Err[KernelLaunchReceipt]("inference device: metal compute provider missing")

@borrows
fn DeviceMetalVectorAddBufferLeftFill(out: var infer.TensorQ,
                                      device: Device,
                                      program: kir.KernelProgram,
                                      leftBuffer: DeviceBuffer,
                                      leftReceipt: DeviceFileRangeBufferLoadReceipt,
                                      right: infer.TensorQ): Result[KernelLaunchReceipt] =
    if device.backend != InferenceDeviceBackendMetal || !device.ready:
        return Err[KernelLaunchReceipt]("inference device: vector add buffer requires ready metal device")
    let programOk = DeviceValidateMetalProgram(program, kir.KernelOpVectorAdd, 3)
    if IsErr(programOk):
        return Err[KernelLaunchReceipt](Error(programOk))
    let receiptOk = DeviceValidateFileRangeBufferLoadReceipt(device, leftBuffer, leftReceipt)
    if IsErr(receiptOk):
        return Err[KernelLaunchReceipt](Error(receiptOk))
    if leftReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded || leftBuffer.handle == uint64(0):
        return Err[KernelLaunchReceipt]("inference device vector add buffer: provider handle")
    if leftBuffer.dtype != kir.KernelDtypeI32:
        return Err[KernelLaunchReceipt]("inference device vector add buffer: dtype")
    if right.shape.len != 1 || right.shape[0] <= 0:
        return Err[KernelLaunchReceipt]("inference device vector add buffer: shape")
    if program.tensors[0].shape.len != 1 ||
       program.tensors[1].shape.len != 1 ||
       program.tensors[2].shape.len != 1 ||
       program.tensors[0].shape[0] != right.shape[0] ||
       program.tensors[1].shape[0] != right.shape[0] ||
       program.tensors[2].shape[0] != right.shape[0] ||
       program.tensors[0].scale != right.scale ||
       program.tensors[1].scale != right.scale ||
       program.tensors[2].scale != right.scale:
        return Err[KernelLaunchReceipt]("inference device vector add buffer: KernelIR dims")
    let leftByteCount = DeviceI32BytesRequired(right.data.len)
    if IsErr(leftByteCount):
        return Err[KernelLaunchReceipt](Error(leftByteCount))
    if leftBuffer.sizeBytes != int64(Value(leftByteCount)):
        return Err[KernelLaunchReceipt]("inference device vector add buffer: byte size")
    let inputHash = DeviceTensorBufferPairInputHash(program.kernelHash, leftBuffer, leftReceipt, right)
    if IsErr(inputHash):
        return Err[KernelLaunchReceipt](Error(inputHash))
    let rightPack = DevicePackI32(right.data)
    if IsErr(rightPack):
        return Err[KernelLaunchReceipt](Error(rightPack))
    var rightBytes = Value(rightPack)
    var outBytes = rawbytes.BytesAlloc(Value(leftByteCount))
    if Value(leftByteCount) > 0 && outBytes.data == nil:
        rawbytes.BytesFree(rightBytes)
        return Err[KernelLaunchReceipt]("inference device vector add buffer: output allocation")
    let elapsed = __inference_metal_vector_add_i32_buffer0_bridge(leftBuffer.handle,
                                                                 rightBytes,
                                                                 outBytes,
                                                                 right.data.len)
    rawbytes.BytesFree(rightBytes)
    if elapsed <= int64(0):
        rawbytes.BytesFree(outBytes)
        return Err[KernelLaunchReceipt]("inference device vector add buffer: metal provider failed")
    let unpack = DeviceTensorFromI32BytesFill(out, [right.shape[0]], right.scale, outBytes)
    rawbytes.BytesFree(outBytes)
    if IsErr(unpack):
        return Err[KernelLaunchReceipt](Error(unpack))
    return DeviceMetalReceipt(device,
                              program,
                              Value(inputHash),
                              out,
                              elapsed,
                              "kernel_ir_facts->file_range_metal_buffer0->typed_metal_vector_add_i32")

@borrows
fn DeviceMetalGemmBuffersFill(out: var infer.TensorQ,
                              device: Device,
                              program: kir.KernelProgram,
                              leftBuffer: DeviceBuffer,
                              leftReceipt: DeviceTensorBufferLoadReceipt,
                              rightBuffer: DeviceBuffer,
                              rightReceipt: DeviceTensorBufferLoadReceipt): Result[KernelLaunchReceipt] =
    if device.backend != InferenceDeviceBackendMetal || !device.ready:
        return Err[KernelLaunchReceipt]("inference device: gemm buffers requires ready metal device")
    let programOk = DeviceValidateMetalProgram(program, kir.KernelOpGemm, 3)
    if IsErr(programOk):
        return Err[KernelLaunchReceipt](Error(programOk))
    if leftReceipt.schema != InferenceDeviceTensorBufferLoadReceiptSchema ||
       rightReceipt.schema != InferenceDeviceTensorBufferLoadReceiptSchema ||
       DeviceTensorBufferLoadReceiptHash(leftReceipt) != leftReceipt.receiptHash ||
       DeviceTensorBufferLoadReceiptHash(rightReceipt) != rightReceipt.receiptHash:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: receipt hash")
    if leftReceipt.deviceCapabilityHash != device.capabilityHash ||
       rightReceipt.deviceCapabilityHash != device.capabilityHash ||
       leftReceipt.deviceBufferHandle != leftBuffer.handle ||
       rightReceipt.deviceBufferHandle != rightBuffer.handle ||
       leftReceipt.deviceBufferLogicalHash != leftBuffer.logicalHash ||
       rightReceipt.deviceBufferLogicalHash != rightBuffer.logicalHash ||
       leftReceipt.deviceBufferSizeBytes != leftBuffer.sizeBytes ||
       rightReceipt.deviceBufferSizeBytes != rightBuffer.sizeBytes:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: receipt buffer")
    if leftReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       rightReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       leftBuffer.handle == uint64(0) ||
       rightBuffer.handle == uint64(0):
        return Err[KernelLaunchReceipt]("inference device gemm buffers: provider handle")
    if leftBuffer.dtype != kir.KernelDtypeI32 || rightBuffer.dtype != kir.KernelDtypeI32:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: dtype")
    if program.tensors[0].shape.len != 2 ||
       program.tensors[1].shape.len != 2 ||
       program.tensors[2].shape.len != 2:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: tensor rank")
    let rows = program.ops[0].rows
    let cols = program.ops[0].cols
    let inner = program.ops[0].inner
    if rows <= 0 || cols <= 0 || inner <= 0:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: dims")
    if program.tensors[0].shape[0] != rows ||
       program.tensors[0].shape[1] != inner ||
       program.tensors[1].shape[0] != inner ||
       program.tensors[1].shape[1] != cols ||
       program.tensors[2].shape[0] != rows ||
       program.tensors[2].shape[1] != cols:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: KernelIR tensor shape")
    if leftReceipt.tensorShape.len != 2 ||
       rightReceipt.tensorShape.len != 2 ||
       leftReceipt.tensorShape[0] != rows ||
       leftReceipt.tensorShape[1] != inner ||
       rightReceipt.tensorShape[0] != inner ||
       rightReceipt.tensorShape[1] != cols ||
       leftReceipt.tensorScale != program.tensors[0].scale ||
       rightReceipt.tensorScale != program.tensors[1].scale ||
       leftReceipt.tensorElementCount != rows * inner ||
       rightReceipt.tensorElementCount != inner * cols:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: receipt tensor")
    if program.tensors[0].scale != program.tensors[1].scale ||
       program.tensors[2].scale != program.tensors[0].scale:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: scale")
    let leftBytes = DeviceI32BytesRequired(rows * inner)
    if IsErr(leftBytes):
        return Err[KernelLaunchReceipt](Error(leftBytes))
    let rightBytes = DeviceI32BytesRequired(inner * cols)
    if IsErr(rightBytes):
        return Err[KernelLaunchReceipt](Error(rightBytes))
    let outBytesRequired = DeviceI32BytesRequired(rows * cols)
    if IsErr(outBytesRequired):
        return Err[KernelLaunchReceipt](Error(outBytesRequired))
    if leftBuffer.sizeBytes != int64(Value(leftBytes)) ||
       rightBuffer.sizeBytes != int64(Value(rightBytes)):
        return Err[KernelLaunchReceipt]("inference device gemm buffers: byte size")
    let inputHash = DeviceBufferBufferInputHash(
        program.kernelHash,
        leftBuffer,
        leftReceipt.receiptHash,
        rightBuffer,
        rightReceipt.receiptHash
    )
    if IsErr(inputHash):
        return Err[KernelLaunchReceipt](Error(inputHash))
    var outBytes = rawbytes.BytesAlloc(Value(outBytesRequired))
    if Value(outBytesRequired) > 0 && outBytes.data == nil:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: output allocation")
    let providerReceiptHandle = __inference_metal_gemm_i32_buffers_output_receipt_bridge(
        leftBuffer.handle,
        rightBuffer.handle,
        outBytes,
        rows,
        cols,
        inner,
        program.tensors[0].scale
    )
    if providerReceiptHandle == uint64(0):
        rawbytes.BytesFree(outBytes)
        return Err[KernelLaunchReceipt]("inference device gemm buffers: metal provider failed")
    let elapsed = __inference_metal_launch_receipt_elapsed_ns_bridge(providerReceiptHandle)
    let outBufferHandle = __inference_metal_launch_receipt_output_buffer_handle_bridge(providerReceiptHandle)
    let providerOutputHash = __inference_metal_launch_receipt_output_hash_bridge(providerReceiptHandle)
    let providerReceiptRelease = __inference_metal_launch_receipt_release_bridge(providerReceiptHandle)
    if elapsed <= int64(0) || outBufferHandle == uint64(0) || providerOutputHash <= int64(0) || providerReceiptRelease != 0:
        rawbytes.BytesFree(outBytes)
        if outBufferHandle != uint64(0):
            let _releaseFailedOut = __inference_metal_release_buffer_bridge(outBufferHandle)
        return Err[KernelLaunchReceipt]("inference device gemm buffers: metal provider failed")
    let unpack = DeviceTensorFromI32BytesFill(out, [rows, cols], program.tensors[0].scale, outBytes)
    rawbytes.BytesFree(outBytes)
    if IsErr(unpack):
        let _releaseAfterUnpackFail = __inference_metal_release_buffer_bridge(outBufferHandle)
        return Err[KernelLaunchReceipt](Error(unpack))
    let outHash = DeviceTensorHash(out)
    if IsErr(outHash):
        let _releaseAfterHashFail = __inference_metal_release_buffer_bridge(outBufferHandle)
        return Err[KernelLaunchReceipt](Error(outHash))
    if Value(outHash) != providerOutputHash:
        let _releaseAfterProviderHashMismatch = __inference_metal_release_buffer_bridge(outBufferHandle)
        return Err[KernelLaunchReceipt]("inference device gemm buffers: provider output hash")
    let releaseOut = __inference_metal_release_buffer_bridge(outBufferHandle)
    if releaseOut != 0:
        return Err[KernelLaunchReceipt]("inference device gemm buffers: output buffer release")
    return DeviceMetalReceipt(device,
                              program,
                              Value(inputHash),
                              out,
                              elapsed,
                              "kernel_ir_facts->metal_gemm_buffers->host_output_receipt")

fn DeviceMetalGemmBuffersToBufferFill(device: Device,
                                      program: kir.KernelProgram,
                                      leftBuffer: DeviceBuffer,
                                      leftReceipt: DeviceTensorBufferLoadReceipt,
                                      rightBuffer: DeviceBuffer,
