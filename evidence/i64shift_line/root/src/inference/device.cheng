        schema: InferenceDeviceRawTensorBytesBufferLoadReceiptSchema,
        deviceBackend: strings.CloneStr(device.backend),
        deviceName: strings.CloneStr(device.name),
        deviceCapabilityHash: strings.CloneStr(device.capabilityHash),
        deviceCapabilityMask: device.capabilityMask,
        deviceBufferSizeBytes: buffer.sizeBytes,
        deviceBufferDtype: strings.CloneStr(buffer.dtype),
        deviceBufferLogicalHash: buffer.logicalHash,
        deviceBufferHandle: buffer.handle,
        tensorScale: scale,
        tensorShape: infer.InferenceShapeCopy(shape),
        tensorElementCount: Value(tensorElements),
        rawByteCount: Value(expectedBytes),
        rawBytesHash: Value(rawHash),
        status: strings.CloneStr(status),
        receiptHash: int64(0)
    )
    out.receiptHash = DeviceRawTensorBytesBufferLoadReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: receipt hash")
    return Ok[DeviceRawTensorBytesBufferLoadReceipt](out)

@borrows
fn DeviceValidateRawTensorBytesBufferLoadReceipt(device: Device,
                                                 buffer: DeviceBuffer,
                                                 receipt: DeviceRawTensorBytesBufferLoadReceipt): Result[bool] =
    if receipt.schema != InferenceDeviceRawTensorBytesBufferLoadReceiptSchema ||
