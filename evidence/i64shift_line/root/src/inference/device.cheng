const
    InferenceDeviceBackendMetal = "metal"
    InferenceDeviceBackendNpu = "npu"
    InferenceDeviceCapabilityMetalCompute: int32 = 1
    InferenceDeviceCapabilityNpuStaticGraph: int32 = 2
    InferenceDeviceKernelStatusUnsupported = "unsupported"
    InferenceDeviceKernelStatusProviderMissing = "provider_missing"
    InferenceDeviceKernelStatusLaunched = "launched"
    InferenceDeviceBufferLoadStatusVerifiedLogical = "verified_logical"
    InferenceDeviceBufferLoadStatusMetalBufferLoaded = "metal_buffer_loaded"
    InferenceDeviceFileRangeBufferLoadReceiptSchema = "cheng.inference.device_file_range_buffer_load_receipt.v1"
    InferenceDeviceTensorBufferLoadReceiptSchema = "cheng.inference.device_tensor_buffer_load_receipt.v1"
    InferenceDeviceRawTensorBytesBufferLoadReceiptSchema = "cheng.inference.device_raw_tensor_bytes_buffer_load_receipt.v1"
    InferenceDeviceFileRangePageTableReceiptSchema = "cheng.inference.device_file_range_page_table_receipt.v1"
    InferenceDeviceMetalPagedAttentionPageBufferSlotLimit: int32 = 4

type
    Device =
        backend: str
        name: str
        capabilityHash: str
        capabilityMask: int32
        ready: bool

    DeviceBuffer =
        deviceCapabilityHash: str
        handle: uint64
        sizeBytes: int64
        dtype: str
        logicalHash: int64

    DeviceQueue =
        deviceCapabilityHash: str
        handle: uint64
        queueOrdinal: int32

    DeviceKernel =
        opKind: str
        kernelHash: int64
        deviceCapabilityHash: str
        sourceKind: str
        ready: bool

    KernelLaunchReceipt =
        deviceName: str
        deviceCapabilityHash: str
        kernelHash: int64
        inputHash: int64
        outputHash: int64
        elapsedNs: int64
        status: str
        trace: str

    DeviceFileRangeBufferLoadReceipt =
        schema: str
        deviceBackend: str
        deviceName: str
        deviceCapabilityHash: str
        deviceCapabilityMask: int32
        deviceBufferSizeBytes: int64
        deviceBufferDtype: str
        deviceBufferLogicalHash: int64
        deviceBufferHandle: uint64
        filePath: str
        fileByteCount: int64
        offsetBytes: int64
        byteCount: int64
        chunkBytes: int32
        sourceRangeHash: int64
        status: str
        receiptHash: int64

    DeviceFileRangeBufferLoadResult =
        buffer: DeviceBuffer
        receipt: DeviceFileRangeBufferLoadReceipt

    DeviceTensorBufferLoadReceipt =
        schema: str
        deviceBackend: str
        deviceName: str
        deviceCapabilityHash: str
        deviceCapabilityMask: int32
        deviceBufferSizeBytes: int64
        deviceBufferDtype: str
        deviceBufferLogicalHash: int64
        deviceBufferHandle: uint64
        tensorScale: int32
        tensorShape: int32[]
        tensorElementCount: int32
        tensorHash: int64
        tensorDataHash: int64
        status: str
        receiptHash: int64

    DeviceTensorBufferLoadResult =
        buffer: DeviceBuffer
        receipt: DeviceTensorBufferLoadReceipt

    DeviceRawTensorBytesBufferLoadReceipt =
        schema: str
        deviceBackend: str
        deviceName: str
        deviceCapabilityHash: str
        deviceCapabilityMask: int32
        deviceBufferSizeBytes: int64
        deviceBufferDtype: str
        deviceBufferLogicalHash: int64
        deviceBufferHandle: uint64
        tensorScale: int32
        tensorShape: int32[]
        tensorElementCount: int32
        rawByteCount: int64
        rawBytesHash: int64
        status: str
        receiptHash: int64

    DeviceRawTensorBytesBufferLoadResult =
        buffer: DeviceBuffer
        receipt: DeviceRawTensorBytesBufferLoadReceipt

    DeviceFileRangePage =
        pageOrdinal: int32
        offsetBytes: int64
        byteCount: int64
        chunkBytes: int32
        sourceRangeHash: int64
        pageHash: int64

    DeviceFileRangePageTableReceipt =
        schema: str
        deviceBackend: str
        deviceName: str
        deviceCapabilityHash: str
        deviceCapabilityMask: int32
        filePath: str
        fileByteCount: int64
        offsetBytes: int64
        byteCount: int64
        pageBytes: int64
        chunkBytes: int32
        pageCount: int32
        pages: DeviceFileRangePage[]
        pageAggregateHash: int64
        receiptHash: int64

    DeviceBufferKernelLaunchResult =
        buffer: DeviceBuffer
        receipt: KernelLaunchReceipt
        output: infer.TensorQ

    DeviceResidentBufferKernelLaunchResult =
        buffer: DeviceBuffer
        receipt: KernelLaunchReceipt

fn DeviceHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1099511627) + value + int64(146959810)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn DeviceHashText(text: str): int64 =
    var h: int64 = int64(146959810)
    for i in 0..<len(text):
        h = DeviceHashStep(h, int64(Int32(text[i])))
    return h

@borrows
fn DeviceHashI32(values: int32[]): int64 =
    var h: int64 = int64(146959810)
    for i in 0..<values.len:
        h = DeviceHashStep(h, int64(values[i]))
    return h

@borrows
fn DeviceHashU64(hash: int64, value: uint64): int64 =
    var h = hash
    h = DeviceHashStep(h, int64(value & uint64(2147483647)))
    h = DeviceHashStep(h, int64((value >> uint64(31)) & uint64(2147483647)))
    h = DeviceHashStep(h, int64((value >> uint64(62)) & uint64(3)))
    return h

fn DeviceWeightRangeHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(524287) + value + int64(113)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn DeviceWeightRangeHashBytesWith(hashRaw: int64, bytes: rawbytes.Bytes): int64 =
    var h: int64 = hashRaw
    for i in 0..<rawbytes.BytesLen(bytes):
        h = DeviceWeightRangeHashStep(h, int64(rawbytes.BytesGet(bytes, i)))
    return h

@borrows
fn DeviceHashFileRangePath(path: str,
                           offsetBytes: int64,
                           byteCount: int64,
                           chunkBytes: int32): Result[int64] =
    if path == "":
        return Err[int64]("inference device file range hash: path")
    if offsetBytes < int64(0) || byteCount <= int64(0):
        return Err[int64]("inference device file range hash: range")
    if chunkBytes <= 0 || chunkBytes > 67108864:
        return Err[int64]("inference device file range hash: chunk")
    let fileLen = os.FileSize(path)
    if fileLen < int64(0):
        return Err[int64]("inference device file range hash: file size")
    if offsetBytes > fileLen || byteCount > fileLen - offsetBytes:
        return Err[int64]("inference device file range hash: range beyond file")
    var h: int64 = int64(113)
    h = DeviceWeightRangeHashStep(h, byteCount)
    var cursor: int64
    while cursor < byteCount:
        var want = chunkBytes
        if int64(want) > byteCount - cursor:
            want = int32(byteCount - cursor)
        let chunk = os.ReadFileRangeBytesResult(share(path), offsetBytes + cursor, want)
        if IsErr(chunk):
            return Err[int64](Error(chunk))
        if rawbytes.BytesLen(Value(chunk)) != want:
            return Err[int64]("inference device file range hash: short chunk")
        h = DeviceWeightRangeHashBytesWith(h, Value(chunk))
        cursor = cursor + int64(want)
    if h <= int64(0):
        return Err[int64]("inference device file range hash: hash")
    return Ok[int64](h)

@borrows
fn DeviceFileRangeBufferLoadReceiptHash(receipt: DeviceFileRangeBufferLoadReceipt): int64 =
    var h: int64 = DeviceHashText("cheng.inference.device_file_range_buffer_load_receipt.hash.v1")
    h = DeviceHashStep(h, DeviceHashText(receipt.schema))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceBackend))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceName))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceCapabilityHash))
    h = DeviceHashStep(h, int64(receipt.deviceCapabilityMask))
    h = DeviceHashStep(h, receipt.deviceBufferSizeBytes)
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceBufferDtype))
    h = DeviceHashStep(h, receipt.deviceBufferLogicalHash)
    h = DeviceHashU64(h, receipt.deviceBufferHandle)
    h = DeviceHashStep(h, DeviceHashText(receipt.filePath))
    h = DeviceHashStep(h, receipt.fileByteCount)
    h = DeviceHashStep(h, receipt.offsetBytes)
    h = DeviceHashStep(h, receipt.byteCount)
    h = DeviceHashStep(h, int64(receipt.chunkBytes))
    h = DeviceHashStep(h, receipt.sourceRangeHash)
    h = DeviceHashStep(h, DeviceHashText(receipt.status))
    return h

@borrows
fn DeviceTensorBufferLoadReceiptHash(receipt: DeviceTensorBufferLoadReceipt): int64 =
    var h: int64 = DeviceHashText("cheng.inference.device_tensor_buffer_load_receipt.hash.v1")
    h = DeviceHashStep(h, DeviceHashText(receipt.schema))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceBackend))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceName))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceCapabilityHash))
    h = DeviceHashStep(h, int64(receipt.deviceCapabilityMask))
    h = DeviceHashStep(h, receipt.deviceBufferSizeBytes)
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceBufferDtype))
    h = DeviceHashStep(h, receipt.deviceBufferLogicalHash)
    h = DeviceHashU64(h, receipt.deviceBufferHandle)
    h = DeviceHashStep(h, int64(receipt.tensorScale))
    for i in 0..<receipt.tensorShape.len:
        h = DeviceHashStep(h, int64(receipt.tensorShape[i]))
    h = DeviceHashStep(h, int64(receipt.tensorElementCount))
    h = DeviceHashStep(h, receipt.tensorHash)
    h = DeviceHashStep(h, receipt.tensorDataHash)
    h = DeviceHashStep(h, DeviceHashText(receipt.status))
    return h

@borrows
fn DeviceRawTensorBytesBufferLoadReceiptHash(receipt: DeviceRawTensorBytesBufferLoadReceipt): int64 =
    var h: int64 = DeviceHashText("cheng.inference.device_raw_tensor_bytes_buffer_load_receipt.hash.v1")
    h = DeviceHashStep(h, DeviceHashText(receipt.schema))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceBackend))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceName))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceCapabilityHash))
    h = DeviceHashStep(h, int64(receipt.deviceCapabilityMask))
    h = DeviceHashStep(h, receipt.deviceBufferSizeBytes)
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceBufferDtype))
    h = DeviceHashStep(h, receipt.deviceBufferLogicalHash)
    h = DeviceHashU64(h, receipt.deviceBufferHandle)
    h = DeviceHashStep(h, int64(receipt.tensorScale))
    for i in 0..<receipt.tensorShape.len:
        h = DeviceHashStep(h, int64(receipt.tensorShape[i]))
    h = DeviceHashStep(h, int64(receipt.tensorElementCount))
    h = DeviceHashStep(h, receipt.rawByteCount)
    h = DeviceHashStep(h, receipt.rawBytesHash)
    h = DeviceHashStep(h, DeviceHashText(receipt.status))
    return h

@borrows
fn DeviceRawTensorBytesExpectedByteCount(dtype: str, shape: int32[]): Result[int64] =
    let elems = infer.TensorElementCount(shape)
    if IsErr(elems):
        return Err[int64](Error(elems))
    if Value(elems) <= 0:
        return Err[int64]("inference device raw tensor bytes: element count")
    if dtype == kir.KernelDtypeInt4:
        return Ok[int64](int64((Value(elems) + 1) / 2))
    if dtype == kir.KernelDtypeInt8 || dtype == kir.KernelDtypeFp8E4M3:
        return Ok[int64](int64(Value(elems)))
    return Err[int64]("inference device raw tensor bytes: dtype")

@borrows
fn DeviceRawTensorBytesHash(dtype: str,
                            shape: int32[],
                            scale: int32,
                            bytes: rawbytes.Bytes): Result[int64] =
    if dtype == "" || shape.len <= 0 || scale <= 0:
        return Err[int64]("inference device raw tensor bytes: descriptor")
    let expectedBytes = DeviceRawTensorBytesExpectedByteCount(dtype, shape)
    if IsErr(expectedBytes):
        return Err[int64](Error(expectedBytes))
    if int64(rawbytes.BytesLen(bytes)) != Value(expectedBytes):
        return Err[int64]("inference device raw tensor bytes: byte count")
    let elems = infer.TensorElementCount(shape)
    if IsErr(elems):
        return Err[int64](Error(elems))
    if dtype == kir.KernelDtypeInt4 && Value(elems) % 2 == 1 && rawbytes.BytesLen(bytes) > 0:
        let lastByte = rawbytes.BytesGet(bytes, rawbytes.BytesLen(bytes) - 1)
        if ((lastByte >> 4) & 15) != 0:
            return Err[int64]("inference device raw tensor bytes: int4 padding")
    var h: int64 = DeviceHashText("cheng.inference.device.raw_tensor_bytes.v1")
    h = DeviceHashStep(h, DeviceHashText(dtype))
    h = DeviceHashStep(h, int64(scale))
    for i in 0..<shape.len:
        h = DeviceHashStep(h, int64(shape[i]))
    h = DeviceHashStep(h, int64(rawbytes.BytesLen(bytes)))
    h = DeviceWeightRangeHashBytesWith(h, bytes)
    if h <= int64(0):
        return Err[int64]("inference device raw tensor bytes: hash")
    return Ok[int64](h)

@borrows
fn DeviceFileRangePageHash(page: DeviceFileRangePage): int64 =
    var h: int64 = DeviceHashText("cheng.inference.device_file_range_page.hash.v1")
    h = DeviceHashStep(h, int64(page.pageOrdinal))
    h = DeviceHashStep(h, page.offsetBytes)
    h = DeviceHashStep(h, page.byteCount)
    h = DeviceHashStep(h, int64(page.chunkBytes))
    h = DeviceHashStep(h, page.sourceRangeHash)
    return h

@borrows
fn DeviceFileRangePageAggregateHash(pages: DeviceFileRangePage[]): int64 =
    var h: int64 = DeviceHashText("cheng.inference.device_file_range_page_aggregate.hash.v1")
    for i in 0..<pages.len:
        if pages[i].pageHash != DeviceFileRangePageHash(pages[i]):
            return int64(0)
        h = DeviceHashStep(h, int64(pages[i].pageOrdinal))
        h = DeviceHashStep(h, pages[i].offsetBytes)
        h = DeviceHashStep(h, pages[i].byteCount)
        h = DeviceHashStep(h, int64(pages[i].chunkBytes))
        h = DeviceHashStep(h, pages[i].sourceRangeHash)
        h = DeviceHashStep(h, pages[i].pageHash)
    return h

@borrows
fn DeviceFileRangePageTableReceiptHash(receipt: DeviceFileRangePageTableReceipt): int64 =
    var h: int64 = DeviceHashText("cheng.inference.device_file_range_page_table_receipt.hash.v1")
    h = DeviceHashStep(h, DeviceHashText(receipt.schema))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceBackend))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceName))
    h = DeviceHashStep(h, DeviceHashText(receipt.deviceCapabilityHash))
    h = DeviceHashStep(h, int64(receipt.deviceCapabilityMask))
    h = DeviceHashStep(h, DeviceHashText(receipt.filePath))
    h = DeviceHashStep(h, receipt.fileByteCount)
    h = DeviceHashStep(h, receipt.offsetBytes)
    h = DeviceHashStep(h, receipt.byteCount)
    h = DeviceHashStep(h, receipt.pageBytes)
    h = DeviceHashStep(h, int64(receipt.chunkBytes))
    h = DeviceHashStep(h, int64(receipt.pageCount))
    h = DeviceHashStep(h, receipt.pageAggregateHash)
    for i in 0..<receipt.pages.len:
        h = DeviceHashStep(h, receipt.pages[i].pageHash)
    return h

@borrows
fn DeviceBuildFileRangeBufferLoadReceiptWithStatus(device: Device,
                                                   buffer: DeviceBuffer,
                                                   filePath: str,
                                                   offsetBytes: int64,
                                                   byteCount: int64,
                                                   chunkBytes: int32,
                                                   status: str): Result[DeviceFileRangeBufferLoadReceipt] =
    if device.backend == "" || device.name == "" || device.capabilityHash == "" || device.capabilityMask <= 0 || !device.ready:
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: ready device")
    if buffer.deviceCapabilityHash != device.capabilityHash:
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: capability")
    if buffer.sizeBytes <= int64(0) || buffer.dtype == "" || buffer.logicalHash <= int64(0):
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: buffer")
    if status == InferenceDeviceBufferLoadStatusVerifiedLogical:
        if buffer.handle != uint64(0):
            return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: logical handle")
    elif status == InferenceDeviceBufferLoadStatusMetalBufferLoaded:
        if device.backend != InferenceDeviceBackendMetal || buffer.handle == uint64(0):
            return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: metal handle")
    else:
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: status")
    if filePath == "" || offsetBytes < int64(0) || byteCount <= int64(0):
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: range")
    if buffer.sizeBytes != byteCount:
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: buffer size")
    let fileLen = os.FileSize(filePath)
    if fileLen <= int64(0):
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: file size")
    if offsetBytes > fileLen || byteCount > fileLen - offsetBytes:
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: range beyond file")
    let rangeHash = DeviceHashFileRangePath(filePath, offsetBytes, byteCount, chunkBytes)
    if IsErr(rangeHash):
        return Err[DeviceFileRangeBufferLoadReceipt](Error(rangeHash))
    if buffer.logicalHash != Value(rangeHash):
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: source hash")
    var out = DeviceFileRangeBufferLoadReceipt(
        schema: InferenceDeviceFileRangeBufferLoadReceiptSchema,
        deviceBackend: strings.CloneStr(device.backend),
        deviceName: strings.CloneStr(device.name),
        deviceCapabilityHash: strings.CloneStr(device.capabilityHash),
        deviceCapabilityMask: device.capabilityMask,
        deviceBufferSizeBytes: buffer.sizeBytes,
        deviceBufferDtype: strings.CloneStr(buffer.dtype),
        deviceBufferLogicalHash: buffer.logicalHash,
        deviceBufferHandle: buffer.handle,
        filePath: strings.CloneStr(filePath),
        fileByteCount: fileLen,
        offsetBytes: offsetBytes,
        byteCount: byteCount,
        chunkBytes: chunkBytes,
        sourceRangeHash: Value(rangeHash),
        status: strings.CloneStr(status),
        receiptHash: int64(0)
    )
    out.receiptHash = DeviceFileRangeBufferLoadReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[DeviceFileRangeBufferLoadReceipt]("inference device buffer load: receipt hash")
    return Ok[DeviceFileRangeBufferLoadReceipt](out)

fn DeviceBuildVerifiedFileRangeBufferLoadReceipt(device: Device,
