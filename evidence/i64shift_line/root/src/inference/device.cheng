       receipt.deviceBufferLogicalHash != want.deviceBufferLogicalHash ||
       receipt.deviceBufferHandle != want.deviceBufferHandle ||
       receipt.tensorScale != want.tensorScale ||
       receipt.tensorShape.len != want.tensorShape.len ||
       receipt.tensorElementCount != want.tensorElementCount ||
       receipt.tensorHash != want.tensorHash ||
       receipt.tensorDataHash != want.tensorDataHash ||
       receipt.status != want.status ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("inference device tensor buffer load: receipt mismatch")
    for i in 0..<receipt.tensorShape.len:
        if receipt.tensorShape[i] != want.tensorShape[i]:
            return Err[bool]("inference device tensor buffer load: shape mismatch")
    if DeviceTensorBufferLoadReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("inference device tensor buffer load: receipt hash")
    return Ok[bool](true)

@borrows
fn DeviceBuildRawTensorBytesBufferLoadReceiptWithStatus(device: Device,
                                                        buffer: DeviceBuffer,
                                                        dtype: str,
                                                        shape: int32[],
                                                        scale: int32,
                                                        rawBytes: rawbytes.Bytes,
                                                        status: str): Result[DeviceRawTensorBytesBufferLoadReceipt] =
    if device.backend == "" || device.name == "" || device.capabilityHash == "" || device.capabilityMask <= 0 || !device.ready:
        return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: ready device")
    if buffer.deviceCapabilityHash != device.capabilityHash:
        return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: capability")
    if dtype == "" || shape.len <= 0 || scale <= 0:
        return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: descriptor")
    let expectedBytes = DeviceRawTensorBytesExpectedByteCount(dtype, shape)
    if IsErr(expectedBytes):
        return Err[DeviceRawTensorBytesBufferLoadReceipt](Error(expectedBytes))
    if buffer.sizeBytes != Value(expectedBytes) || buffer.dtype != dtype || buffer.logicalHash <= int64(0):
        return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: buffer")
    if status == InferenceDeviceBufferLoadStatusVerifiedLogical:
        if buffer.handle != uint64(0):
            return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: logical handle")
    elif status == InferenceDeviceBufferLoadStatusMetalBufferLoaded:
        if device.backend != InferenceDeviceBackendMetal || buffer.handle == uint64(0):
            return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: metal handle")
    else:
        return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: status")
    let tensorElements = infer.TensorElementCount(shape)
    if IsErr(tensorElements):
        return Err[DeviceRawTensorBytesBufferLoadReceipt](Error(tensorElements))
    let rawHash = DeviceRawTensorBytesHash(dtype, shape, scale, rawBytes)
    if IsErr(rawHash):
        return Err[DeviceRawTensorBytesBufferLoadReceipt](Error(rawHash))
    if buffer.logicalHash != Value(rawHash):
        return Err[DeviceRawTensorBytesBufferLoadReceipt]("inference device raw tensor buffer load: logical hash")
