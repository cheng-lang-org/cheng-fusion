@borrows
fn DeviceValidatePagedAttentionPageBuffersInput(device: Device,
                                                program: kir.KernelProgram,
                                                queryBuffer: DeviceBuffer,
                                                queryReceipt: DeviceFileRangeBufferLoadReceipt,
                                                keyPageBuffers: DeviceBuffer[],
                                                keyPageReceipts: DeviceFileRangeBufferLoadReceipt[],
                                                valuePageBuffers: DeviceBuffer[],
                                                valuePageReceipts: DeviceFileRangeBufferLoadReceipt[],
                                                pageTableBuffer: DeviceBuffer,
                                                pageTableReceipt: DeviceFileRangeBufferLoadReceipt): Result[int64] =
    if device.backend != InferenceDeviceBackendMetal || !device.ready:
        return Err[int64]("inference device: paged attention page buffers requires ready metal device")
    let programOk = DeviceValidateMetalProgram(program, kir.KernelOpPagedAttention, 5)
    if IsErr(programOk):
        return Err[int64](Error(programOk))
    let queryReceiptOk = DeviceValidateFileRangeBufferLoadReceipt(device, queryBuffer, queryReceipt)
    if IsErr(queryReceiptOk):
        return Err[int64](Error(queryReceiptOk))
    let pageTableReceiptOk = DeviceValidateFileRangeBufferLoadReceipt(device, pageTableBuffer, pageTableReceipt)
    if IsErr(pageTableReceiptOk):
        return Err[int64](Error(pageTableReceiptOk))
    if queryReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       pageTableReceipt.status != InferenceDeviceBufferLoadStatusMetalBufferLoaded:
        return Err[int64]("inference device paged attention page buffers: receipt status")
    if queryBuffer.handle == uint64(0) || pageTableBuffer.handle == uint64(0):
        return Err[int64]("inference device paged attention page buffers: provider handle")
    if queryBuffer.dtype != kir.KernelDtypeI32 ||
       pageTableBuffer.dtype != kir.KernelDtypeI32 ||
       queryReceipt.deviceBufferDtype != kir.KernelDtypeI32 ||
       pageTableReceipt.deviceBufferDtype != kir.KernelDtypeI32:
        return Err[int64]("inference device paged attention page buffers: dtype")
    if program.tensors[0].shape.len != 1 ||
       program.tensors[1].shape.len != 3 ||
       program.tensors[2].shape.len != 3 ||
       program.tensors[3].shape.len != 1 ||
       program.tensors[4].shape.len != 1:
        return Err[int64]("inference device paged attention page buffers: rank")
    if program.tensors[0].dtype == kir.KernelDtypeInt8 ||
       program.tensors[0].dtype == kir.KernelDtypeInt4 ||
       program.tensors[1].dtype != program.tensors[0].dtype ||
       program.tensors[2].dtype != program.tensors[0].dtype ||
       program.tensors[3].dtype != kir.KernelDtypeI32 ||
       program.tensors[4].dtype != program.tensors[0].dtype:
        return Err[int64]("inference device paged attention page buffers: KernelIR dtype")
    if program.tensors[0].scale != program.tensors[1].scale ||
       program.tensors[0].scale != program.tensors[2].scale ||
       program.tensors[3].scale != 1 ||
       program.tensors[4].scale != program.tensors[0].scale:
        return Err[int64]("inference device paged attention page buffers: scale")
    let tokenCount = program.ops[0].rows
    let valueDim = program.ops[0].cols
    let keyDim = program.ops[0].inner
    let tokensPerPage = program.ops[0].topK
    let pageCount = program.ops[0].epsilonScale
    let blockCount = program.tensors[3].shape[0]
    if tokenCount <= 0 || keyDim <= 0 || valueDim <= 0 || tokensPerPage <= 0 || pageCount <= 0:
        return Err[int64]("inference device paged attention page buffers: KernelIR dims")
    if keyPageBuffers.len != pageCount ||
       keyPageReceipts.len != pageCount ||
       valuePageBuffers.len != pageCount ||
       valuePageReceipts.len != pageCount:
        return Err[int64]("inference device paged attention page buffers: page count")
    if blockCount != (tokenCount + tokensPerPage - 1) / tokensPerPage:
        return Err[int64]("inference device paged attention page buffers: block count")
    if program.tensors[0].shape[0] != keyDim ||
       program.tensors[1].shape[0] != pageCount ||
       program.tensors[1].shape[1] != tokensPerPage ||
       program.tensors[1].shape[2] != keyDim ||
       program.tensors[2].shape[0] != pageCount ||
       program.tensors[2].shape[1] != tokensPerPage ||
       program.tensors[2].shape[2] != valueDim ||
       program.tensors[4].shape[0] != valueDim:
        return Err[int64]("inference device paged attention page buffers: tensor shape")
    if int64(tokensPerPage) > int64(536870911) / int64(keyDim) ||
       int64(tokensPerPage) > int64(536870911) / int64(valueDim):
        return Err[int64]("inference device paged attention page buffers: element limit")
    let keyPageElems64: int64 = int64(tokensPerPage) * int64(keyDim)
    let valuePageElems64: int64 = int64(tokensPerPage) * int64(valueDim)
    if keyPageElems64 <= int64(0) || valuePageElems64 <= int64(0):
        return Err[int64]("inference device paged attention page buffers: element count")
    let queryBytes = DeviceI32BytesRequired(keyDim)
    if IsErr(queryBytes):
        return Err[int64](Error(queryBytes))
    let keyPageBytes = DeviceI32BytesRequired(int32(keyPageElems64))
    if IsErr(keyPageBytes):
        return Err[int64](Error(keyPageBytes))
    let valuePageBytes = DeviceI32BytesRequired(int32(valuePageElems64))
    if IsErr(valuePageBytes):
        return Err[int64](Error(valuePageBytes))
    let pageTableBytes = DeviceI32BytesRequired(blockCount)
    if IsErr(pageTableBytes):
        return Err[int64](Error(pageTableBytes))
    if queryBuffer.sizeBytes != int64(Value(queryBytes)) || queryReceipt.byteCount != int64(Value(queryBytes)):
        return Err[int64]("inference device paged attention page buffers: query byte size")
    if pageTableBuffer.sizeBytes != int64(Value(pageTableBytes)) ||
       pageTableReceipt.byteCount != int64(Value(pageTableBytes)):
        return Err[int64]("inference device paged attention page buffers: page table byte size")
    for i in 0..<pageCount:
        let keyOk = DeviceValidateFileRangeBufferLoadReceipt(device, keyPageBuffers[i], keyPageReceipts[i])
        if IsErr(keyOk):
            return Err[int64](Error(keyOk))
        let valueOk = DeviceValidateFileRangeBufferLoadReceipt(device, valuePageBuffers[i], valuePageReceipts[i])
        if IsErr(valueOk):
            return Err[int64](Error(valueOk))
        if keyPageReceipts[i].status != InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
           valuePageReceipts[i].status != InferenceDeviceBufferLoadStatusMetalBufferLoaded:
            return Err[int64]("inference device paged attention page buffers: page receipt status")
        if keyPageBuffers[i].handle == uint64(0) || valuePageBuffers[i].handle == uint64(0):
            return Err[int64]("inference device paged attention page buffers: page provider handle")
        if keyPageBuffers[i].dtype != kir.KernelDtypeI32 ||
           valuePageBuffers[i].dtype != kir.KernelDtypeI32 ||
           keyPageReceipts[i].deviceBufferDtype != kir.KernelDtypeI32 ||
           valuePageReceipts[i].deviceBufferDtype != kir.KernelDtypeI32:
            return Err[int64]("inference device paged attention page buffers: page dtype")
        if keyPageBuffers[i].sizeBytes != int64(Value(keyPageBytes)) ||
           keyPageReceipts[i].byteCount != int64(Value(keyPageBytes)):
            return Err[int64]("inference device paged attention page buffers: key page byte size")
        if valuePageBuffers[i].sizeBytes != int64(Value(valuePageBytes)) ||
           valuePageReceipts[i].byteCount != int64(Value(valuePageBytes)):
            return Err[int64]("inference device paged attention page buffers: value page byte size")
    let tableOk = DeviceValidatePageTableFileRangeReceipt(pageTableReceipt, pageCount, blockCount)
    if IsErr(tableOk):
        return Err[int64](Error(tableOk))
    return DeviceTensorPagedAttentionPageBuffersInputHash(program.kernelHash,
                                                          queryBuffer,
                                                          queryReceipt,
                                                          keyPageBuffers,
                                                          keyPageReceipts,
                                                          valuePageBuffers,
                                                          valuePageReceipts,
                                                          pageTableBuffer,
                                                          pageTableReceipt)

fn DeviceMetalReleaseBufferSet(buffers: DeviceBuffer[]): Result[bool] =
    for i in 0..<buffers.len:
        if buffers[i].handle != uint64(0):
            let releaseOk = DeviceMetalReleaseBuffer(buffers[i])
            if IsErr(releaseOk):
                return Err[bool](Error(releaseOk))
    return Ok[bool](true)

