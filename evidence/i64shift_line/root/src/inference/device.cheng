       DeviceTensorBufferLoadReceiptHash(rightReceipt) != rightReceipt.receiptHash:
        return Err[DeviceResidentBufferKernelLaunchResult]("inference device gemm buffers: receipt hash")
    if leftReceipt.deviceCapabilityHash != device.capabilityHash ||
       rightReceipt.deviceCapabilityHash != device.capabilityHash ||
