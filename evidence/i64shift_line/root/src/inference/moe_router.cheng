import std/result

type
    MoeRouteChoice =
        tokenIndex: int32
        expert0: int32
        expert1: int32
        score0: int32
        score1: int32

    MoeRoutePlan =
        tokenCount: int32
        expertCount: int32
        topK: int32
        expertCapacity: int32
        choices: MoeRouteChoice[]
        expertLoads: int32[]
        routeHash: int64

    MoeLayerRoutePlan =
        layerIndex: int32
        routePlan: MoeRoutePlan

    MoeRoutePlanSet =
        layerRoutes: MoeLayerRoutePlan[]
        routeSetHash: int64

@borrows
fn MoeHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(1000003) + value + int64(17)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn MoeRouteHash(plan: MoeRoutePlan): int64 =
    var h: int64 = int64(17)
    h = MoeHashStep(h, int64(plan.tokenCount))
    h = MoeHashStep(h, int64(plan.expertCount))
    h = MoeHashStep(h, int64(plan.topK))
    h = MoeHashStep(h, int64(plan.expertCapacity))
    for i in 0..<plan.choices.len:
        h = MoeHashStep(h, int64(plan.choices[i].tokenIndex))
        h = MoeHashStep(h, int64(plan.choices[i].expert0))
        h = MoeHashStep(h, int64(plan.choices[i].expert1))
        h = MoeHashStep(h, int64(plan.choices[i].score0))
        h = MoeHashStep(h, int64(plan.choices[i].score1))
    for i in 0..<plan.expertLoads.len:
        h = MoeHashStep(h, int64(plan.expertLoads[i]))
    return h

@borrows
fn MoeScoreAt(scores: int32[], tokenIndex: int32, expertCount: int32, expertId: int32): int32 =
    return scores[tokenIndex * expertCount + expertId]

fn MoePickTop2ForToken(scores: int32[],
                       tokenIndex: int32,
                       expertCount: int32): Result[MoeRouteChoice] =
    if expertCount < 2:
        return Err[MoeRouteChoice]("moe router: expert count")
    var bestExpert: int32
    var secondExpert: int32 = 1
    var bestScore = MoeScoreAt(scores, tokenIndex, expertCount, bestExpert)
    var secondScore = MoeScoreAt(scores, tokenIndex, expertCount, secondExpert)
    if secondScore > bestScore:
        let oldExpert = bestExpert
        let oldScore = bestScore
        bestExpert = secondExpert
        bestScore = secondScore
        secondExpert = oldExpert
        secondScore = oldScore
    for expertId in 2..<expertCount:
        let score = MoeScoreAt(scores, tokenIndex, expertCount, expertId)
        if score > bestScore:
            secondExpert = bestExpert
            secondScore = bestScore
            bestExpert = expertId
            bestScore = score
        elif score > secondScore:
            secondExpert = expertId
            secondScore = score
    return Ok[MoeRouteChoice](MoeRouteChoice(
        tokenIndex: tokenIndex,
        expert0: bestExpert,
        expert1: secondExpert,
        score0: bestScore,
        score1: secondScore
    ))

fn MoeRouteTop2(scores: int32[],
                tokenCount: int32,
                expertCount: int32,
                expertCapacity: int32): Result[MoeRoutePlan] =
    if tokenCount <= 0 || expertCount < 2 || expertCapacity <= 0:
        return Err[MoeRoutePlan]("moe router: invalid config")
    if scores.len != tokenCount * expertCount:
        return Err[MoeRoutePlan]("moe router: score shape")
    var loads: int32[]
    for _ in 0..<expertCount:
        add(loads, 0)
    var choices: MoeRouteChoice[]
    for tokenIndex in 0..<tokenCount:
        let choiceRes = MoePickTop2ForToken(scores, tokenIndex, expertCount)
        if IsErr(choiceRes):
            return Err[MoeRoutePlan](Error(choiceRes))
        let choice = Value(choiceRes)
        if loads[choice.expert0] + 1 > expertCapacity:
            return Err[MoeRoutePlan]("moe router: expert capacity overflow")
        loads[choice.expert0] = loads[choice.expert0] + 1
        if loads[choice.expert1] + 1 > expertCapacity:
            return Err[MoeRoutePlan]("moe router: expert capacity overflow")
        loads[choice.expert1] = loads[choice.expert1] + 1
        add(choices, choice)
    var plan = MoeRoutePlan(
        tokenCount: tokenCount,
        expertCount: expertCount,
        topK: 2,
        expertCapacity: expertCapacity,
        choices: choices,
        expertLoads: loads,
        routeHash: int64(0)
    )
    plan.routeHash = MoeRouteHash(plan)
    return Ok[MoeRoutePlan](plan)

@borrows
fn MoeValidateRoutePlan(plan: MoeRoutePlan): Result[bool] =
    if plan.tokenCount <= 0 || plan.expertCount < 2 || plan.topK != 2 || plan.expertCapacity <= 0:
        return Err[bool]("moe router: plan config")
    if plan.choices.len != plan.tokenCount || plan.expertLoads.len != plan.expertCount:
        return Err[bool]("moe router: plan shape")
    var loads: int32[]
    for _ in 0..<plan.expertCount:
        add(loads, 0)
    for i in 0..<plan.choices.len:
        let choice = plan.choices[i]
        if choice.tokenIndex != i:
            return Err[bool]("moe router: token order")
        if choice.expert0 < 0 || choice.expert0 >= plan.expertCount ||
           choice.expert1 < 0 || choice.expert1 >= plan.expertCount:
            return Err[bool]("moe router: expert bounds")
        if choice.expert0 == choice.expert1:
            return Err[bool]("moe router: duplicate expert")
        loads[choice.expert0] = loads[choice.expert0] + 1
        loads[choice.expert1] = loads[choice.expert1] + 1
    for i in 0..<plan.expertLoads.len:
        if plan.expertLoads[i] != loads[i]:
            return Err[bool]("moe router: load mismatch")
        if plan.expertLoads[i] > plan.expertCapacity:
            return Err[bool]("moe router: load overflow")
    if MoeRouteHash(plan) != plan.routeHash:
        return Err[bool]("moe router: hash mismatch")
    return Ok[bool](true)

@borrows
fn MoeRoutePlanSetHash(set: MoeRoutePlanSet): int64 =
    var h: int64 = int64(17)
    for i in 0..<set.layerRoutes.len:
        h = MoeHashStep(h, int64(set.layerRoutes[i].layerIndex))
        h = MoeHashStep(h, set.layerRoutes[i].routePlan.routeHash)
    return h

fn MoeRoutePlanSetBuild(layerRoutes: MoeLayerRoutePlan[]): MoeRoutePlanSet =
    var out = MoeRoutePlanSet(
        layerRoutes: layerRoutes,
        routeSetHash: int64(0)
    )
    out.routeSetHash = MoeRoutePlanSetHash(out)
    return out

fn MoeRoutePlanSetFromSingle(layerIndex: int32, plan: MoeRoutePlan): MoeRoutePlanSet =
    return MoeRoutePlanSetBuild([
        MoeLayerRoutePlan(layerIndex: layerIndex, routePlan: plan)
    ])

@borrows
fn MoeValidateRoutePlanSet(set: MoeRoutePlanSet): Result[bool] =
    if set.layerRoutes.len <= 0:
        return Err[bool]("moe router set: empty")
    var tokenCount = set.layerRoutes[0].routePlan.tokenCount
    var expertCount = set.layerRoutes[0].routePlan.expertCount
    var topK = set.layerRoutes[0].routePlan.topK
    for i in 0..<set.layerRoutes.len:
        if set.layerRoutes[i].layerIndex != i:
            return Err[bool]("moe router set: layer order")
        let routeOk = MoeValidateRoutePlan(set.layerRoutes[i].routePlan)
        if IsErr(routeOk):
            return Err[bool](Error(routeOk))
        if set.layerRoutes[i].routePlan.tokenCount != tokenCount ||
           set.layerRoutes[i].routePlan.expertCount != expertCount ||
           set.layerRoutes[i].routePlan.topK != topK:
            return Err[bool]("moe router set: route shape")
    if MoeRoutePlanSetHash(set) != set.routeSetHash:
        return Err[bool]("moe router set: hash mismatch")
    return Ok[bool](true)

@borrows
fn MoeRoutePlanSetContainsRoute(set: MoeRoutePlanSet, routeHash: int64): bool =
    if routeHash <= int64(0):
        return false
    for i in 0..<set.layerRoutes.len:
        if set.layerRoutes[i].routePlan.routeHash == routeHash:
            return true
    return false

fn MoeCombineExpertScalars(plan: MoeRoutePlan, expertOutputs: int32[]): Result[int32[]] =
    if expertOutputs.len != plan.expertCount:
        return Err[int32[]]("moe router: combine shape")
    let planOk = MoeValidateRoutePlan(plan)
    if IsErr(planOk):
        return Err[int32[]](Error(planOk))
    var out: int32[]
    for i in 0..<plan.choices.len:
        let a = expertOutputs[plan.choices[i].expert0]
        let b = expertOutputs[plan.choices[i].expert1]
        add(out, a + b)
    return Ok[int32[]](out)

@borrows
fn MoeRoutePlanClone(plan: MoeRoutePlan): MoeRoutePlan =
    var choices: MoeRouteChoice[]
    for i in 0..<plan.choices.len:
        var choice = plan.choices[i]
        add(choices, MoeRouteChoice(
            tokenIndex: choice.tokenIndex,
            expert0: choice.expert0,
            expert1: choice.expert1,
            score0: choice.score0,
            score1: choice.score1
        ))
    var expertLoads: int32[]
    for i in 0..<plan.expertLoads.len:
        add(expertLoads, plan.expertLoads[i])
    return MoeRoutePlan(
        tokenCount: plan.tokenCount,
        expertCount: plan.expertCount,
        topK: plan.topK,
        expertCapacity: plan.expertCapacity,
        choices: choices,
        expertLoads: expertLoads,
        routeHash: plan.routeHash
    )
