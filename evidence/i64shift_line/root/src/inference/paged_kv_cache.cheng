@borrows
fn PagedKVValidateDeviceTensorBufferMatchesExpected(expected: infer.TensorQ,
                                                    targetDevice: device.Device,
                                                    buffer: device.DeviceBuffer,
                                                    loadReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                    label: str): Result[bool] =
    let tensorOk = infer.TensorValidate(expected)
    if IsErr(tensorOk):
        return Err[bool](Error(tensorOk))
    let receiptOk = device.DeviceValidateFileRangeBufferLoadReceipt(targetDevice, buffer, loadReceipt)
    if IsErr(receiptOk):
        return Err[bool](Error(receiptOk))
    if loadReceipt.status != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       buffer.handle == uint64(0):
        return Err[bool](strings.CloneStr(label))
    if buffer.dtype != kir.KernelDtypeI32 ||
       loadReceipt.deviceBufferDtype != kir.KernelDtypeI32:
        return Err[bool](strings.CloneStr(label))
    let expectedBytes = device.DeviceI32BytesRequired(expected.data.len)
    if IsErr(expectedBytes):
        return Err[bool](Error(expectedBytes))
    if buffer.sizeBytes != int64(Value(expectedBytes)) ||
       loadReceipt.byteCount != int64(Value(expectedBytes)):
        return Err[bool](strings.CloneStr(label))
    let rangeHash = device.DeviceHashFileRangePath(
        loadReceipt.filePath,
        loadReceipt.offsetBytes,
        loadReceipt.byteCount,
        loadReceipt.chunkBytes
    )
    if IsErr(rangeHash):
        return Err[bool](Error(rangeHash))
    if Value(rangeHash) != loadReceipt.sourceRangeHash ||
       buffer.logicalHash != loadReceipt.sourceRangeHash:
        return Err[bool](strings.CloneStr(label))
    let bytes = os.ReadFileRangeBytesResult(
        loadReceipt.filePath,
        loadReceipt.offsetBytes,
        Value(expectedBytes)
    )
    if IsErr(bytes):
        return Err[bool](Error(bytes))
    if rawbytes.BytesLen(Value(bytes)) != Value(expectedBytes):
        return Err[bool](strings.CloneStr(label))
    for i in 0..<expected.data.len:
        let observed = device.DeviceReadI32LE(Value(bytes), i * 4)
        if observed != expected.data[i]:
            return Err[bool](strings.CloneStr(label))
    return Ok[bool](true)

@borrows
fn PagedKVValidateDeviceTensorLoadReceiptMatchesExpected(expected: infer.TensorQ,
                                                         targetDevice: device.Device,
                                                         buffer: device.DeviceBuffer,
                                                         loadReceipt: device.DeviceTensorBufferLoadReceipt,
                                                         label: str): Result[bool] =
    let tensorOk = infer.TensorValidate(expected)
    if IsErr(tensorOk):
        return Err[bool](Error(tensorOk))
    let receiptOk = device.DeviceValidateTensorBufferLoadReceiptForKernel(targetDevice, buffer, loadReceipt)
    if IsErr(receiptOk):
        return Err[bool](Error(receiptOk))
    if loadReceipt.status != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       buffer.handle == uint64(0):
        return Err[bool](strings.CloneStr(label))
    if buffer.dtype != kir.KernelDtypeI32 ||
       loadReceipt.deviceBufferDtype != kir.KernelDtypeI32:
        return Err[bool](strings.CloneStr(label))
    let expectedBytes = device.DeviceI32BytesRequired(expected.data.len)
    if IsErr(expectedBytes):
        return Err[bool](Error(expectedBytes))
    if buffer.sizeBytes != int64(Value(expectedBytes)) ||
       loadReceipt.deviceBufferSizeBytes != int64(Value(expectedBytes)):
        return Err[bool](strings.CloneStr(label))
    let expectedHash = device.DeviceTensorHash(expected)
    if IsErr(expectedHash):
        return Err[bool](Error(expectedHash))
    if loadReceipt.tensorHash != Value(expectedHash) ||
       loadReceipt.deviceBufferLogicalHash != Value(expectedHash) ||
       buffer.logicalHash != Value(expectedHash) ||
       loadReceipt.tensorDataHash != device.DeviceHashI32(expected.data) ||
       loadReceipt.tensorScale != expected.scale ||
       loadReceipt.tensorElementCount != expected.data.len ||
       loadReceipt.tensorShape.len != expected.shape.len:
        return Err[bool](strings.CloneStr(label))
    for i in 0..<expected.shape.len:
        if loadReceipt.tensorShape[i] != expected.shape[i]:
            return Err[bool](strings.CloneStr(label))
    return Ok[bool](true)

fn PagedKVBuildDeviceKvBuffersReceipt(cache: PagedKVCache,
                                      seq: PagedKVSequence,
                                      targetDevice: device.Device,
                                      keysBuffer: device.DeviceBuffer,
                                      keysLoadReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                      valuesBuffer: device.DeviceBuffer,
                                      valuesLoadReceipt: device.DeviceFileRangeBufferLoadReceipt): Result[PagedKVDeviceKvBuffersReceipt] =
    var inputs: PagedKVAttentionInputTensors
    let inputOk = PagedKVBuildAttentionInputTensorsFill(inputs, cache, seq)
    if IsErr(inputOk):
        return Err[PagedKVDeviceKvBuffersReceipt](Error(inputOk))
    let keysOk = PagedKVValidateDeviceTensorBufferMatchesExpected(
        inputs.keysPageMajor,
        targetDevice,
        keysBuffer,
        keysLoadReceipt,
        "paged kv device kv buffers: keys"
    )
    if IsErr(keysOk):
        return Err[PagedKVDeviceKvBuffersReceipt](Error(keysOk))
    let valuesOk = PagedKVValidateDeviceTensorBufferMatchesExpected(
        inputs.valuesPageMajor,
        targetDevice,
        valuesBuffer,
        valuesLoadReceipt,
        "paged kv device kv buffers: values"
    )
    if IsErr(valuesOk):
        return Err[PagedKVDeviceKvBuffersReceipt](Error(valuesOk))
    let keysTensorHash = device.DeviceTensorHash(inputs.keysPageMajor)
    if IsErr(keysTensorHash):
        return Err[PagedKVDeviceKvBuffersReceipt](Error(keysTensorHash))
    let valuesTensorHash = device.DeviceTensorHash(inputs.valuesPageMajor)
    if IsErr(valuesTensorHash):
        return Err[PagedKVDeviceKvBuffersReceipt](Error(valuesTensorHash))
    let kvReceipt = PagedKVReceiptFor(seq)
    var out = PagedKVDeviceKvBuffersReceipt(
        schema: PagedKVDeviceKvBuffersReceiptSchema,
        seqId: kvReceipt.seqId,
        tokenCount: kvReceipt.tokenCount,
        blockCount: kvReceipt.pageCount,
        cachePageCount: cache.pages.len,
        tokensPerPage: cache.tokensPerPage,
        keyDim: cache.keyDim,
        valueDim: cache.valueDim,
        keyScale: cache.keyScale,
        valueScale: cache.valueScale,
        pageTableHash: kvReceipt.pageTableHash,
        keysTensorHash: Value(keysTensorHash),
        valuesTensorHash: Value(valuesTensorHash),
        keysDataHash: device.DeviceHashI32(inputs.keysPageMajor.data),
        valuesDataHash: device.DeviceHashI32(inputs.valuesPageMajor.data),
        deviceCapabilityHash: share(targetDevice.capabilityHash),
        keysBufferHandle: keysBuffer.handle,
        valuesBufferHandle: valuesBuffer.handle,
        keysBufferLogicalHash: keysBuffer.logicalHash,
        valuesBufferLogicalHash: valuesBuffer.logicalHash,
        keysLoadReceiptHash: keysLoadReceipt.receiptHash,
        valuesLoadReceiptHash: valuesLoadReceipt.receiptHash,
        keysFilePath: keysLoadReceipt.filePath,
        valuesFilePath: valuesLoadReceipt.filePath,
        keysOffsetBytes: keysLoadReceipt.offsetBytes,
        valuesOffsetBytes: valuesLoadReceipt.offsetBytes,
        keysByteCount: keysLoadReceipt.byteCount,
        valuesByteCount: valuesLoadReceipt.byteCount,
        keysSourceRangeHash: keysLoadReceipt.sourceRangeHash,
        valuesSourceRangeHash: valuesLoadReceipt.sourceRangeHash,
        receiptHash: int64(0)
    )
    out.receiptHash = PagedKVDeviceKvBuffersReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[PagedKVDeviceKvBuffersReceipt]("paged kv device kv buffers: receipt hash")
    return Ok[PagedKVDeviceKvBuffersReceipt](out)

fn PagedKVValidateDeviceKvBuffersReceipt(cache: PagedKVCache,
                                         seq: PagedKVSequence,
                                         targetDevice: device.Device,
                                         keysBuffer: device.DeviceBuffer,
                                         keysLoadReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                         valuesBuffer: device.DeviceBuffer,
                                         valuesLoadReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                         receipt: PagedKVDeviceKvBuffersReceipt): Result[bool] =
    let expected = PagedKVBuildDeviceKvBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keysBuffer,
        keysLoadReceipt,
        valuesBuffer,
        valuesLoadReceipt
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.schema != PagedKVDeviceKvBuffersReceiptSchema ||
       receipt.seqId != want.seqId ||
       receipt.tokenCount != want.tokenCount ||
       receipt.blockCount != want.blockCount ||
       receipt.cachePageCount != want.cachePageCount ||
       receipt.tokensPerPage != want.tokensPerPage ||
       receipt.keyDim != want.keyDim ||
       receipt.valueDim != want.valueDim ||
       receipt.keyScale != want.keyScale ||
       receipt.valueScale != want.valueScale ||
       receipt.pageTableHash != want.pageTableHash ||
       receipt.keysTensorHash != want.keysTensorHash ||
       receipt.valuesTensorHash != want.valuesTensorHash ||
       receipt.keysDataHash != want.keysDataHash ||
       receipt.valuesDataHash != want.valuesDataHash ||
       receipt.deviceCapabilityHash != want.deviceCapabilityHash ||
       receipt.keysBufferHandle != want.keysBufferHandle ||
       receipt.valuesBufferHandle != want.valuesBufferHandle ||
       receipt.keysBufferLogicalHash != want.keysBufferLogicalHash ||
       receipt.valuesBufferLogicalHash != want.valuesBufferLogicalHash ||
       receipt.keysLoadReceiptHash != want.keysLoadReceiptHash ||
       receipt.valuesLoadReceiptHash != want.valuesLoadReceiptHash ||
       receipt.keysFilePath != want.keysFilePath ||
       receipt.valuesFilePath != want.valuesFilePath ||
       receipt.keysOffsetBytes != want.keysOffsetBytes ||
       receipt.valuesOffsetBytes != want.valuesOffsetBytes ||
       receipt.keysByteCount != want.keysByteCount ||
       receipt.valuesByteCount != want.valuesByteCount ||
       receipt.keysSourceRangeHash != want.keysSourceRangeHash ||
       receipt.valuesSourceRangeHash != want.valuesSourceRangeHash ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("paged kv device kv buffers: receipt mismatch")
    if PagedKVDeviceKvBuffersReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("paged kv device kv buffers: hash")
    return Ok[bool](true)

fn PagedKVBuildDevicePageBuffersReceipt(cache: PagedKVCache,
                                        seq: PagedKVSequence,
                                        targetDevice: device.Device,
                                        keyPageBuffers: device.DeviceBuffer[],
                                        keyPageReceipts: device.DeviceFileRangeBufferLoadReceipt[],
                                        valuePageBuffers: device.DeviceBuffer[],
                                        valuePageReceipts: device.DeviceFileRangeBufferLoadReceipt[]): Result[PagedKVDevicePageBuffersReceipt] =
    var inputs: PagedKVAttentionInputTensors
    let inputOk = PagedKVBuildAttentionInputTensorsFill(inputs, cache, seq)
    if IsErr(inputOk):
        return Err[PagedKVDevicePageBuffersReceipt](Error(inputOk))
    if keyPageBuffers.len != cache.pages.len ||
       keyPageReceipts.len != cache.pages.len ||
       valuePageBuffers.len != cache.pages.len ||
       valuePageReceipts.len != cache.pages.len:
        return Err[PagedKVDevicePageBuffersReceipt]("paged kv device page buffers: page count")
    var pageReceipts: PagedKVDevicePageBufferReceipt[]
    for pageOrdinal in 0..<cache.pages.len:
        let keyTensorRes = PagedKVBuildPageKeyTensor(cache.pages[pageOrdinal], cache.tokensPerPage, cache.keyDim, cache.keyScale)
        if IsErr(keyTensorRes):
            return Err[PagedKVDevicePageBuffersReceipt](Error(keyTensorRes))
        let valueTensorRes = PagedKVBuildPageValueTensor(cache.pages[pageOrdinal], cache.tokensPerPage, cache.valueDim, cache.valueScale)
        if IsErr(valueTensorRes):
            return Err[PagedKVDevicePageBuffersReceipt](Error(valueTensorRes))
        let keyOk = PagedKVValidateDeviceTensorBufferMatchesExpected(
            Value(keyTensorRes),
            targetDevice,
            keyPageBuffers[pageOrdinal],
            keyPageReceipts[pageOrdinal],
            "paged kv device page buffers: key page"
        )
        if IsErr(keyOk):
            return Err[PagedKVDevicePageBuffersReceipt](Error(keyOk))
        let valueOk = PagedKVValidateDeviceTensorBufferMatchesExpected(
            Value(valueTensorRes),
            targetDevice,
            valuePageBuffers[pageOrdinal],
            valuePageReceipts[pageOrdinal],
            "paged kv device page buffers: value page"
        )
        if IsErr(valueOk):
            return Err[PagedKVDevicePageBuffersReceipt](Error(valueOk))
        let keyTensorHash = device.DeviceTensorHash(Value(keyTensorRes))
        if IsErr(keyTensorHash):
            return Err[PagedKVDevicePageBuffersReceipt](Error(keyTensorHash))
        let valueTensorHash = device.DeviceTensorHash(Value(valueTensorRes))
        if IsErr(valueTensorHash):
            return Err[PagedKVDevicePageBuffersReceipt](Error(valueTensorHash))
        var pageReceipt = PagedKVDevicePageBufferReceipt(
            pageId: cache.pages[pageOrdinal].pageId,
            pageOrdinal: pageOrdinal,
            seqId: cache.pages[pageOrdinal].seqId,
            usedTokens: cache.pages[pageOrdinal].usedTokens,
            keyTensorHash: Value(keyTensorHash),
            valueTensorHash: Value(valueTensorHash),
            keyDataHash: device.DeviceHashI32(Value(keyTensorRes).data),
            valueDataHash: device.DeviceHashI32(Value(valueTensorRes).data),
            keyBufferHandle: keyPageBuffers[pageOrdinal].handle,
            valueBufferHandle: valuePageBuffers[pageOrdinal].handle,
            keyBufferLogicalHash: keyPageBuffers[pageOrdinal].logicalHash,
            valueBufferLogicalHash: valuePageBuffers[pageOrdinal].logicalHash,
            keyLoadReceiptHash: keyPageReceipts[pageOrdinal].receiptHash,
            valueLoadReceiptHash: valuePageReceipts[pageOrdinal].receiptHash,
            keyFilePath: keyPageReceipts[pageOrdinal].filePath,
            valueFilePath: valuePageReceipts[pageOrdinal].filePath,
            keyOffsetBytes: keyPageReceipts[pageOrdinal].offsetBytes,
            valueOffsetBytes: valuePageReceipts[pageOrdinal].offsetBytes,
            keyByteCount: keyPageReceipts[pageOrdinal].byteCount,
            valueByteCount: valuePageReceipts[pageOrdinal].byteCount,
            keySourceRangeHash: keyPageReceipts[pageOrdinal].sourceRangeHash,
            valueSourceRangeHash: valuePageReceipts[pageOrdinal].sourceRangeHash,
            pageReceiptHash: int64(0)
        )
        pageReceipt.pageReceiptHash = PagedKVDevicePageBufferReceiptHash(pageReceipt)
        if pageReceipt.pageReceiptHash <= int64(0):
            return Err[PagedKVDevicePageBuffersReceipt]("paged kv device page buffers: page hash")
        add(pageReceipts, pageReceipt)
    let kvReceipt = PagedKVReceiptFor(seq)
    var out = PagedKVDevicePageBuffersReceipt(
        schema: PagedKVDevicePageBuffersReceiptSchema,
        seqId: kvReceipt.seqId,
        tokenCount: kvReceipt.tokenCount,
        blockCount: kvReceipt.pageCount,
        cachePageCount: cache.pages.len,
        tokensPerPage: cache.tokensPerPage,
        keyDim: cache.keyDim,
        valueDim: cache.valueDim,
        keyScale: cache.keyScale,
        valueScale: cache.valueScale,
        pageTableHash: kvReceipt.pageTableHash,
        deviceCapabilityHash: share(targetDevice.capabilityHash),
        pageAggregateHash: PagedKVDevicePageBuffersAggregateHash(pageReceipts),
        pageReceipts: pageReceipts,
        receiptHash: int64(0)
    )
    out.receiptHash = PagedKVDevicePageBuffersReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[PagedKVDevicePageBuffersReceipt]("paged kv device page buffers: receipt hash")
    return Ok[PagedKVDevicePageBuffersReceipt](out)

fn PagedKVDevicePageBufferReceiptMatches(receipt: PagedKVDevicePageBufferReceipt,
                                         want: PagedKVDevicePageBufferReceipt): bool =
    return receipt.pageId == want.pageId &&
           receipt.pageOrdinal == want.pageOrdinal &&
           receipt.seqId == want.seqId &&
           receipt.usedTokens == want.usedTokens &&
           receipt.keyTensorHash == want.keyTensorHash &&
           receipt.valueTensorHash == want.valueTensorHash &&
           receipt.keyDataHash == want.keyDataHash &&
           receipt.valueDataHash == want.valueDataHash &&
           receipt.keyBufferHandle == want.keyBufferHandle &&
           receipt.valueBufferHandle == want.valueBufferHandle &&
           receipt.keyBufferLogicalHash == want.keyBufferLogicalHash &&
           receipt.valueBufferLogicalHash == want.valueBufferLogicalHash &&
           receipt.keyLoadReceiptHash == want.keyLoadReceiptHash &&
           receipt.valueLoadReceiptHash == want.valueLoadReceiptHash &&
           receipt.keyFilePath == want.keyFilePath &&
           receipt.valueFilePath == want.valueFilePath &&
           receipt.keyOffsetBytes == want.keyOffsetBytes &&
           receipt.valueOffsetBytes == want.valueOffsetBytes &&
           receipt.keyByteCount == want.keyByteCount &&
           receipt.valueByteCount == want.valueByteCount &&
           receipt.keySourceRangeHash == want.keySourceRangeHash &&
           receipt.valueSourceRangeHash == want.valueSourceRangeHash &&
           receipt.pageReceiptHash == want.pageReceiptHash

fn PagedKVValidateDevicePageBuffersReceipt(cache: PagedKVCache,
                                           seq: PagedKVSequence,
                                           targetDevice: device.Device,
                                           keyPageBuffers: device.DeviceBuffer[],
                                           keyPageReceipts: device.DeviceFileRangeBufferLoadReceipt[],
                                           valuePageBuffers: device.DeviceBuffer[],
                                           valuePageReceipts: device.DeviceFileRangeBufferLoadReceipt[],
                                           receipt: PagedKVDevicePageBuffersReceipt): Result[bool] =
    let expected = PagedKVBuildDevicePageBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keyPageBuffers,
        keyPageReceipts,
        valuePageBuffers,
        valuePageReceipts
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.schema != PagedKVDevicePageBuffersReceiptSchema ||
       receipt.seqId != want.seqId ||
       receipt.tokenCount != want.tokenCount ||
       receipt.blockCount != want.blockCount ||
       receipt.cachePageCount != want.cachePageCount ||
       receipt.tokensPerPage != want.tokensPerPage ||
       receipt.keyDim != want.keyDim ||
       receipt.valueDim != want.valueDim ||
       receipt.keyScale != want.keyScale ||
       receipt.valueScale != want.valueScale ||
       receipt.pageTableHash != want.pageTableHash ||
       receipt.deviceCapabilityHash != want.deviceCapabilityHash ||
       receipt.pageAggregateHash != want.pageAggregateHash ||
       receipt.pageReceipts.len != want.pageReceipts.len ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("paged kv device page buffers: receipt mismatch")
    for i in 0..<receipt.pageReceipts.len:
        if !PagedKVDevicePageBufferReceiptMatches(receipt.pageReceipts[i], want.pageReceipts[i]):
            return Err[bool]("paged kv device page buffers: page receipt mismatch")
    if PagedKVDevicePageBuffersAggregateHash(receipt.pageReceipts) != receipt.pageAggregateHash:
        return Err[bool]("paged kv device page buffers: aggregate hash")
    if PagedKVDevicePageBuffersReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("paged kv device page buffers: hash")
    return Ok[bool](true)

@borrows
fn PagedKVBuildDeviceTensorPageTableReceipt(cache: PagedKVCache,
                                            seq: PagedKVSequence,
                                            targetDevice: device.Device,
                                            pageTableBuffer: device.DeviceBuffer,
                                            pageTableLoadReceipt: device.DeviceTensorBufferLoadReceipt): Result[PagedKVDeviceTensorPageTableReceipt] =
    var inputs: PagedKVAttentionInputTensors
