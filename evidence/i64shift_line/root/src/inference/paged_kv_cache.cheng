@borrows
fn PagedKVBuildDeviceTensorPageBuffersReceipt(cache: PagedKVCache,
                                              seq: PagedKVSequence,
                                              targetDevice: device.Device,
                                              keyPageBuffers: device.DeviceBuffer[],
                                              keyPageReceipts: device.DeviceTensorBufferLoadReceipt[],
                                              valuePageBuffers: device.DeviceBuffer[],
                                              valuePageReceipts: device.DeviceTensorBufferLoadReceipt[],
                                              headDim: int32,
                                              headOffset: int32): Result[PagedKVDeviceTensorPageBuffersReceipt] =
    if keyPageBuffers.len != cache.pages.len ||
       keyPageReceipts.len != cache.pages.len ||
       valuePageBuffers.len != cache.pages.len ||
       valuePageReceipts.len != cache.pages.len:
        return Err[PagedKVDeviceTensorPageBuffersReceipt]("paged kv device tensor page buffers: page count")
    var pageReceipts: PagedKVDeviceTensorPageBufferReceipt[]
    for pageOrdinal in 0..<cache.pages.len:
        # #155r-mgqa: what got loaded into keyPageBuffers/valuePageBuffers is
        # a headDim-wide per-kv-head slice (one Metal launch per query head),
        # not the whole kvRows-wide page row -- rebuild the same slice here
        # (via the identical PagedKVBuildPageKeyHeadTensor/ValueHeadTensor
        # helper the loader used) so the hash check below compares like for
        # like.
        let keyTensorRes = PagedKVBuildPageKeyHeadTensor(cache.pages[pageOrdinal], cache.tokensPerPage, cache.keyDim, headDim, headOffset, cache.keyScale)
        if IsErr(keyTensorRes):
            return Err[PagedKVDeviceTensorPageBuffersReceipt](Error(keyTensorRes))
        let valueTensorRes = PagedKVBuildPageValueHeadTensor(cache.pages[pageOrdinal], cache.tokensPerPage, cache.valueDim, headDim, headOffset, cache.valueScale)
        if IsErr(valueTensorRes):
            return Err[PagedKVDeviceTensorPageBuffersReceipt](Error(valueTensorRes))
        let keyOk = PagedKVValidateDeviceTensorLoadReceiptMatchesExpected(
            Value(keyTensorRes),
            targetDevice,
            keyPageBuffers[pageOrdinal],
            keyPageReceipts[pageOrdinal],
            "paged kv device tensor page buffers: key page"
        )
        if IsErr(keyOk):
            return Err[PagedKVDeviceTensorPageBuffersReceipt](Error(keyOk))
        let valueOk = PagedKVValidateDeviceTensorLoadReceiptMatchesExpected(
            Value(valueTensorRes),
            targetDevice,
            valuePageBuffers[pageOrdinal],
            valuePageReceipts[pageOrdinal],
            "paged kv device tensor page buffers: value page"
        )
        if IsErr(valueOk):
            return Err[PagedKVDeviceTensorPageBuffersReceipt](Error(valueOk))
        let keyTensorHash = device.DeviceTensorHash(Value(keyTensorRes))
        if IsErr(keyTensorHash):
            return Err[PagedKVDeviceTensorPageBuffersReceipt](Error(keyTensorHash))
        let valueTensorHash = device.DeviceTensorHash(Value(valueTensorRes))
        if IsErr(valueTensorHash):
            return Err[PagedKVDeviceTensorPageBuffersReceipt](Error(valueTensorHash))
        var pageReceipt = PagedKVDeviceTensorPageBufferReceipt(
            pageId: cache.pages[pageOrdinal].pageId,
            pageOrdinal: pageOrdinal,
            seqId: cache.pages[pageOrdinal].seqId,
            usedTokens: cache.pages[pageOrdinal].usedTokens,
            keyTensorHash: Value(keyTensorHash),
            valueTensorHash: Value(valueTensorHash),
            keyDataHash: device.DeviceHashI32(Value(keyTensorRes).data),
            valueDataHash: device.DeviceHashI32(Value(valueTensorRes).data),
            keyBufferHandle: keyPageBuffers[pageOrdinal].handle,
            valueBufferHandle: valuePageBuffers[pageOrdinal].handle,
            keyBufferLogicalHash: keyPageBuffers[pageOrdinal].logicalHash,
            valueBufferLogicalHash: valuePageBuffers[pageOrdinal].logicalHash,
            keyLoadReceiptHash: keyPageReceipts[pageOrdinal].receiptHash,
            valueLoadReceiptHash: valuePageReceipts[pageOrdinal].receiptHash,
            pageReceiptHash: int64(0)
        )
        pageReceipt.pageReceiptHash = PagedKVDeviceTensorPageBufferReceiptHash(pageReceipt)
        if pageReceipt.pageReceiptHash <= int64(0):
            return Err[PagedKVDeviceTensorPageBuffersReceipt]("paged kv device tensor page buffers: page hash")
        add(pageReceipts, pageReceipt)
    let kvReceipt = PagedKVReceiptFor(seq)
    var out = PagedKVDeviceTensorPageBuffersReceipt(
        schema: PagedKVDeviceTensorPageBuffersReceiptSchema,
        seqId: kvReceipt.seqId,
        tokenCount: kvReceipt.tokenCount,
        blockCount: kvReceipt.pageCount,
        cachePageCount: cache.pages.len,
        tokensPerPage: cache.tokensPerPage,
        keyDim: cache.keyDim,
        valueDim: cache.valueDim,
        keyScale: cache.keyScale,
        valueScale: cache.valueScale,
        pageTableHash: kvReceipt.pageTableHash,
        deviceCapabilityHash: share(targetDevice.capabilityHash),
        pageAggregateHash: PagedKVDeviceTensorPageBuffersAggregateHash(pageReceipts),
        pageReceipts: pageReceipts,
        receiptHash: int64(0)
    )
    out.receiptHash = PagedKVDeviceTensorPageBuffersReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[PagedKVDeviceTensorPageBuffersReceipt]("paged kv device tensor page buffers: receipt hash")
    return Ok[PagedKVDeviceTensorPageBuffersReceipt](out)

@borrows
fn PagedKVDeviceTensorPageBufferReceiptMatches(receipt: PagedKVDeviceTensorPageBufferReceipt,
                                               want: PagedKVDeviceTensorPageBufferReceipt): bool =
    return receipt.pageId == want.pageId &&
           receipt.pageOrdinal == want.pageOrdinal &&
           receipt.seqId == want.seqId &&
           receipt.usedTokens == want.usedTokens &&
           receipt.keyTensorHash == want.keyTensorHash &&
           receipt.valueTensorHash == want.valueTensorHash &&
           receipt.keyDataHash == want.keyDataHash &&
           receipt.valueDataHash == want.valueDataHash &&
           receipt.keyBufferHandle == want.keyBufferHandle &&
           receipt.valueBufferHandle == want.valueBufferHandle &&
           receipt.keyBufferLogicalHash == want.keyBufferLogicalHash &&
           receipt.valueBufferLogicalHash == want.valueBufferLogicalHash &&
           receipt.keyLoadReceiptHash == want.keyLoadReceiptHash &&
           receipt.valueLoadReceiptHash == want.valueLoadReceiptHash &&
           receipt.pageReceiptHash == want.pageReceiptHash

@borrows
fn PagedKVValidateDeviceTensorPageBuffersReceipt(cache: PagedKVCache,
                                                 seq: PagedKVSequence,
                                                 targetDevice: device.Device,
                                                 keyPageBuffers: device.DeviceBuffer[],
                                                 keyPageReceipts: device.DeviceTensorBufferLoadReceipt[],
                                                 valuePageBuffers: device.DeviceBuffer[],
                                                 valuePageReceipts: device.DeviceTensorBufferLoadReceipt[],
                                                 headDim: int32,
                                                 headOffset: int32,
                                                 receipt: PagedKVDeviceTensorPageBuffersReceipt): Result[bool] =
    let expected = PagedKVBuildDeviceTensorPageBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keyPageBuffers,
        keyPageReceipts,
        valuePageBuffers,
        valuePageReceipts,
        headDim,
        headOffset
    )
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.schema != PagedKVDeviceTensorPageBuffersReceiptSchema ||
       receipt.seqId != want.seqId ||
       receipt.tokenCount != want.tokenCount ||
       receipt.blockCount != want.blockCount ||
       receipt.cachePageCount != want.cachePageCount ||
       receipt.tokensPerPage != want.tokensPerPage ||
       receipt.keyDim != want.keyDim ||
       receipt.valueDim != want.valueDim ||
       receipt.keyScale != want.keyScale ||
       receipt.valueScale != want.valueScale ||
       receipt.pageTableHash != want.pageTableHash ||
       receipt.deviceCapabilityHash != want.deviceCapabilityHash ||
       receipt.pageAggregateHash != want.pageAggregateHash ||
       receipt.pageReceipts.len != want.pageReceipts.len ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("paged kv device tensor page buffers: receipt mismatch")
    for i in 0..<receipt.pageReceipts.len:
        if !PagedKVDeviceTensorPageBufferReceiptMatches(receipt.pageReceipts[i], want.pageReceipts[i]):
            return Err[bool]("paged kv device tensor page buffers: page receipt mismatch")
    if PagedKVDeviceTensorPageBuffersAggregateHash(receipt.pageReceipts) != receipt.pageAggregateHash:
        return Err[bool]("paged kv device tensor page buffers: aggregate hash")
    if PagedKVDeviceTensorPageBuffersReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("paged kv device tensor page buffers: hash")
    return Ok[bool](true)

fn PagedKVBindKernelReceiptToDeviceReceipts(receipt: device.KernelLaunchReceipt,
                                            pageTableReceipt: PagedKVDevicePageTableReceipt,
                                            kvBuffersReceipt: PagedKVDeviceKvBuffersReceipt,
                                            pageBuffersReceipt: PagedKVDevicePageBuffersReceipt,
                                            trace: str): Result[device.KernelLaunchReceipt] =
    if receipt.inputHash <= int64(0) ||
       pageTableReceipt.receiptHash <= int64(0) ||
       kvBuffersReceipt.receiptHash <= int64(0) ||
       pageBuffersReceipt.receiptHash <= int64(0):
        return Err[device.KernelLaunchReceipt]("paged kv device receipts: input hash")
    var out = receipt
    out.inputHash = device.DeviceHashStep(receipt.inputHash, pageTableReceipt.receiptHash)
    out.inputHash = device.DeviceHashStep(out.inputHash, kvBuffersReceipt.receiptHash)
    out.inputHash = device.DeviceHashStep(out.inputHash, pageBuffersReceipt.receiptHash)
    out.trace = trace
    return Ok[device.KernelLaunchReceipt](out)

fn PagedKVBindKernelReceiptToPageDeviceReceipts(receipt: device.KernelLaunchReceipt,
                                                pageTableReceipt: PagedKVDevicePageTableReceipt,
                                                pageBuffersReceipt: PagedKVDevicePageBuffersReceipt,
                                                trace: str): Result[device.KernelLaunchReceipt] =
    if receipt.inputHash <= int64(0) ||
       pageTableReceipt.receiptHash <= int64(0) ||
       pageBuffersReceipt.receiptHash <= int64(0):
        return Err[device.KernelLaunchReceipt]("paged kv page device receipts: input hash")
    var out = receipt
    out.inputHash = device.DeviceHashStep(receipt.inputHash, pageTableReceipt.receiptHash)
    out.inputHash = device.DeviceHashStep(out.inputHash, pageBuffersReceipt.receiptHash)
    out.trace = trace
    return Ok[device.KernelLaunchReceipt](out)

@borrows
fn PagedKVBindKernelReceiptToTensorPageDeviceReceipts(receipt: device.KernelLaunchReceipt,
                                                      pageTableReceipt: PagedKVDeviceTensorPageTableReceipt,
                                                      pageBuffersReceipt: PagedKVDeviceTensorPageBuffersReceipt,
                                                      trace: str): Result[device.KernelLaunchReceipt] =
    if receipt.inputHash <= int64(0) ||
       pageTableReceipt.receiptHash <= int64(0) ||
       pageBuffersReceipt.receiptHash <= int64(0):
        return Err[device.KernelLaunchReceipt]("paged kv tensor page device receipts: input hash")
    return Ok[device.KernelLaunchReceipt](device.KernelLaunchReceipt(
        deviceName: strings.CloneStr(receipt.deviceName),
        deviceCapabilityHash: strings.CloneStr(receipt.deviceCapabilityHash),
        kernelHash: receipt.kernelHash,
        inputHash: device.DeviceHashStep(
            device.DeviceHashStep(receipt.inputHash, pageTableReceipt.receiptHash),
            pageBuffersReceipt.receiptHash),
        outputHash: receipt.outputHash,
        elapsedNs: receipt.elapsedNs,
        status: strings.CloneStr(receipt.status),
        trace: strings.CloneStr(trace)
    ))

@borrows
fn PagedKVDeviceMetalPagedAttentionTensorPageBuffersToBufferFill(cache: PagedKVCache,
                                                                 seq: PagedKVSequence,
                                                                 targetDevice: device.Device,
                                                                 program: kir.KernelProgram,
                                                                 query: infer.TensorQ,
                                                                 keyPageTensors: infer.TensorQ[],
                                                                 valuePageTensors: infer.TensorQ[],
                                                                 pageTable: infer.TensorQ,
                                                                 headOffset: int32): Result[device.DeviceBufferKernelLaunchResult] =
    if keyPageTensors.len <= 0 || keyPageTensors.len != valuePageTensors.len:
        return Err[device.DeviceBufferKernelLaunchResult]("paged kv tensor page buffers: page tensor count")
    let queryLoad = device.DeviceMetalLoadTensorI32Buffer(targetDevice, query)
    if IsErr(queryLoad):
        return Err[device.DeviceBufferKernelLaunchResult](Error(queryLoad))
    var queryOwned = Value(queryLoad)
    var queryBuf = queryOwned.buffer
    var queryReceipt = queryOwned.receipt
    let pageTableLoad = device.DeviceMetalLoadTensorI32Buffer(targetDevice, pageTable)
    if IsErr(pageTableLoad):
        let _releaseQueryOnTableFail = device.DeviceMetalReleaseBuffer(queryBuf)
        return Err[device.DeviceBufferKernelLaunchResult](Error(pageTableLoad))
    var pageTableOwned = Value(pageTableLoad)
    var pageTableBuf = pageTableOwned.buffer
    var pageTableReceipt = pageTableOwned.receipt
    var keyPageBuffers: device.DeviceBuffer[]
    var keyPageReceipts: device.DeviceTensorBufferLoadReceipt[]
    var valuePageBuffers: device.DeviceBuffer[]
    var valuePageReceipts: device.DeviceTensorBufferLoadReceipt[]
    for i in 0..<keyPageTensors.len:
        let keyLoad = device.DeviceMetalLoadTensorI32Buffer(targetDevice, keyPageTensors[i])
        if IsErr(keyLoad):
            let _releaseQueryOnKeyFail = device.DeviceMetalReleaseBuffer(queryBuf)
            let _releaseTableOnKeyFail = device.DeviceMetalReleaseBuffer(pageTableBuf)
            let _releaseKeysOnKeyFail = device.DeviceMetalReleaseBufferSet(keyPageBuffers)
            let _releaseValuesOnKeyFail = device.DeviceMetalReleaseBufferSet(valuePageBuffers)
            return Err[device.DeviceBufferKernelLaunchResult](Error(keyLoad))
        var keyOwned = Value(keyLoad)
        var keyBuf = keyOwned.buffer
        var keyReceipt = keyOwned.receipt
        let valueLoad = device.DeviceMetalLoadTensorI32Buffer(targetDevice, valuePageTensors[i])
        if IsErr(valueLoad):
            let _releaseKeyOnValueFail = device.DeviceMetalReleaseBuffer(keyBuf)
            let _releaseQueryOnValueFail = device.DeviceMetalReleaseBuffer(queryBuf)
            let _releaseTableOnValueFail = device.DeviceMetalReleaseBuffer(pageTableBuf)
            let _releaseKeysOnValueFail = device.DeviceMetalReleaseBufferSet(keyPageBuffers)
            let _releaseValuesOnValueFail = device.DeviceMetalReleaseBufferSet(valuePageBuffers)
            return Err[device.DeviceBufferKernelLaunchResult](Error(valueLoad))
        var valueOwned = Value(valueLoad)
        var valueBuf = valueOwned.buffer
        var valueReceipt = valueOwned.receipt
        add(keyPageBuffers, keyBuf)
        add(keyPageReceipts, keyReceipt)
        add(valuePageBuffers, valueBuf)
        add(valuePageReceipts, valueReceipt)
    let pageTableDeviceReceipt = PagedKVBuildDeviceTensorPageTableReceipt(
        cache,
        seq,
        targetDevice,
        pageTableBuf,
        pageTableReceipt
    )
    if IsErr(pageTableDeviceReceipt):
        let _releaseQueryOnTableReceiptFail = device.DeviceMetalReleaseBuffer(queryBuf)
        let _releaseTableOnTableReceiptFail = device.DeviceMetalReleaseBuffer(pageTableBuf)
        let _releaseKeysOnTableReceiptFail = device.DeviceMetalReleaseBufferSet(keyPageBuffers)
        let _releaseValuesOnTableReceiptFail = device.DeviceMetalReleaseBufferSet(valuePageBuffers)
        return Err[device.DeviceBufferKernelLaunchResult](Error(pageTableDeviceReceipt))
    let pageBuffersDeviceReceipt = PagedKVBuildDeviceTensorPageBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keyPageBuffers,
        keyPageReceipts,
        valuePageBuffers,
        valuePageReceipts,
        program.ops[0].inner,
        headOffset
    )
    if IsErr(pageBuffersDeviceReceipt):
        let _releaseQueryOnPagesReceiptFail = device.DeviceMetalReleaseBuffer(queryBuf)
        let _releaseTableOnPagesReceiptFail = device.DeviceMetalReleaseBuffer(pageTableBuf)
        let _releaseKeysOnPagesReceiptFail = device.DeviceMetalReleaseBufferSet(keyPageBuffers)
        let _releaseValuesOnPagesReceiptFail = device.DeviceMetalReleaseBufferSet(valuePageBuffers)
        return Err[device.DeviceBufferKernelLaunchResult](Error(pageBuffersDeviceReceipt))
    let launched = device.DeviceMetalPagedAttentionTensorLoadedPageBuffersToBufferFill(
        targetDevice,
        program,
        query,
        queryBuf,
        queryReceipt,
        keyPageTensors,
        keyPageBuffers,
        keyPageReceipts,
        valuePageTensors,
        valuePageBuffers,
        valuePageReceipts,
        pageTable,
        pageTableBuf,
        pageTableReceipt
    )
    if IsErr(launched):
        let _releaseQueryOnLaunchFail = device.DeviceMetalReleaseBuffer(queryBuf)
        let _releaseTableOnLaunchFail = device.DeviceMetalReleaseBuffer(pageTableBuf)
        let _releaseKeysOnLaunchFail = device.DeviceMetalReleaseBufferSet(keyPageBuffers)
        let _releaseValuesOnLaunchFail = device.DeviceMetalReleaseBufferSet(valuePageBuffers)
        return Err[device.DeviceBufferKernelLaunchResult](Error(launched))
    var launchedOwned = Value(launched)
    let boundReceipt = PagedKVBindKernelReceiptToTensorPageDeviceReceipts(
        launchedOwned.receipt,
        Value(pageTableDeviceReceipt),
        Value(pageBuffersDeviceReceipt),
        "kernel_ir_facts->paged_kv_tensor_page_buffers_receipt->resident_output_buffer"
    )
    let releaseQuery = device.DeviceMetalReleaseBuffer(queryBuf)
    let releaseTable = device.DeviceMetalReleaseBuffer(pageTableBuf)
    let releaseKeys = device.DeviceMetalReleaseBufferSet(keyPageBuffers)
    let releaseValues = device.DeviceMetalReleaseBufferSet(valuePageBuffers)
    if IsErr(boundReceipt):
        var launchedBuf = launchedOwned.buffer
        let _releaseOutputOnBindFail = device.DeviceMetalReleaseBuffer(launchedBuf)
        return Err[device.DeviceBufferKernelLaunchResult](Error(boundReceipt))
    if IsErr(releaseQuery):
        var launchedBuf = launchedOwned.buffer
        let _releaseOutputOnQueryReleaseFail = device.DeviceMetalReleaseBuffer(launchedBuf)
        return Err[device.DeviceBufferKernelLaunchResult](Error(releaseQuery))
    if IsErr(releaseTable):
        var launchedBuf = launchedOwned.buffer
        let _releaseOutputOnTableReleaseFail = device.DeviceMetalReleaseBuffer(launchedBuf)
        return Err[device.DeviceBufferKernelLaunchResult](Error(releaseTable))
    if IsErr(releaseKeys):
        var launchedBuf = launchedOwned.buffer
        let _releaseOutputOnKeysReleaseFail = device.DeviceMetalReleaseBuffer(launchedBuf)
        return Err[device.DeviceBufferKernelLaunchResult](Error(releaseKeys))
    if IsErr(releaseValues):
        var launchedBuf = launchedOwned.buffer
        let _releaseOutputOnValuesReleaseFail = device.DeviceMetalReleaseBuffer(launchedBuf)
        return Err[device.DeviceBufferKernelLaunchResult](Error(releaseValues))
    launchedOwned.receipt = Value(boundReceipt)
    return Ok[device.DeviceBufferKernelLaunchResult](launchedOwned)

@borrows
fn PagedKVDeviceMetalPagedAttentionBuffersFill(out: var infer.TensorQ,
                                               cache: PagedKVCache,
                                               seq: PagedKVSequence,
                                               pageTableDeviceReceipt: PagedKVDevicePageTableReceipt,
                                               kvBuffersDeviceReceipt: PagedKVDeviceKvBuffersReceipt,
                                               pageBuffersDeviceReceipt: PagedKVDevicePageBuffersReceipt,
                                               targetDevice: device.Device,
                                               program: kir.KernelProgram,
                                               queryBuffer: device.DeviceBuffer,
                                               queryReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                               keysBuffer: device.DeviceBuffer,
                                               keysReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                               valuesBuffer: device.DeviceBuffer,
                                               valuesReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                               pageTableBuffer: device.DeviceBuffer,
                                               pageTableLoadReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                               keyPageBuffers: device.DeviceBuffer[],
                                               keyPageReceipts: device.DeviceFileRangeBufferLoadReceipt[],
                                               valuePageBuffers: device.DeviceBuffer[],
                                               valuePageReceipts: device.DeviceFileRangeBufferLoadReceipt[]): Result[device.KernelLaunchReceipt] =
    let tableOk = PagedKVValidateDevicePageTableReceipt(
        cache,
        seq,
        targetDevice,
        pageTableBuffer,
        pageTableLoadReceipt,
        pageTableDeviceReceipt
    )
    if IsErr(tableOk):
        return Err[device.KernelLaunchReceipt](Error(tableOk))
    let kvOk = PagedKVValidateDeviceKvBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keysBuffer,
        keysReceipt,
        valuesBuffer,
        valuesReceipt,
        kvBuffersDeviceReceipt
    )
    if IsErr(kvOk):
        return Err[device.KernelLaunchReceipt](Error(kvOk))
    let pageBuffersOk = PagedKVValidateDevicePageBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keyPageBuffers,
        keyPageReceipts,
        valuePageBuffers,
        valuePageReceipts,
        pageBuffersDeviceReceipt
    )
    if IsErr(pageBuffersOk):
        return Err[device.KernelLaunchReceipt](Error(pageBuffersOk))
    let launched = PagedKVDeviceMetalPagedAttentionBuffersToBufferFill(
        cache,
        seq,
        pageTableDeviceReceipt,
        kvBuffersDeviceReceipt,
        pageBuffersDeviceReceipt,
        targetDevice,
        program,
        queryBuffer,
        queryReceipt,
        keysBuffer,
        keysReceipt,
        valuesBuffer,
        valuesReceipt,
        pageTableBuffer,
        pageTableLoadReceipt,
        keyPageBuffers,
        keyPageReceipts,
        valuePageBuffers,
        valuePageReceipts
    )
    if IsErr(launched):
        return Err[device.KernelLaunchReceipt](Error(launched))
    var resident = Value(launched)
    let copyOutput = infer.TensorFromDataFill(out,
                                             resident.output.shape,
                                             resident.output.scale,
                                             resident.output.data)
    let releaseOutput = device.DeviceMetalReleaseBuffer(resident.buffer)
    if IsErr(copyOutput):
        if IsErr(releaseOutput):
            return Err[device.KernelLaunchReceipt](Error(releaseOutput))
        return Err[device.KernelLaunchReceipt](Error(copyOutput))
    if IsErr(releaseOutput):
        return Err[device.KernelLaunchReceipt](Error(releaseOutput))
    resident.receipt.trace = "kernel_ir_facts->paged_kv_device_kv_buffers_receipt->typed_metal_paged_attention_i32"
    return Ok[device.KernelLaunchReceipt](resident.receipt)

@borrows
fn PagedKVDeviceMetalPagedAttentionBuffersToBufferFill(cache: PagedKVCache,
                                                       seq: PagedKVSequence,
                                                       pageTableDeviceReceipt: PagedKVDevicePageTableReceipt,
                                                       kvBuffersDeviceReceipt: PagedKVDeviceKvBuffersReceipt,
                                                       pageBuffersDeviceReceipt: PagedKVDevicePageBuffersReceipt,
                                                       targetDevice: device.Device,
                                                       program: kir.KernelProgram,
                                                       queryBuffer: device.DeviceBuffer,
                                                       queryReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                       keysBuffer: device.DeviceBuffer,
                                                       keysReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                       valuesBuffer: device.DeviceBuffer,
                                                       valuesReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                       pageTableBuffer: device.DeviceBuffer,
                                                       pageTableLoadReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                       keyPageBuffers: device.DeviceBuffer[],
                                                       keyPageReceipts: device.DeviceFileRangeBufferLoadReceipt[],
                                                       valuePageBuffers: device.DeviceBuffer[],
                                                       valuePageReceipts: device.DeviceFileRangeBufferLoadReceipt[]): Result[device.DeviceBufferKernelLaunchResult] =
    let tableOk = PagedKVValidateDevicePageTableReceipt(
        cache,
        seq,
        targetDevice,
        pageTableBuffer,
        pageTableLoadReceipt,
        pageTableDeviceReceipt
    )
    if IsErr(tableOk):
        return Err[device.DeviceBufferKernelLaunchResult](Error(tableOk))
    let kvOk = PagedKVValidateDeviceKvBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keysBuffer,
        keysReceipt,
        valuesBuffer,
        valuesReceipt,
        kvBuffersDeviceReceipt
    )
    if IsErr(kvOk):
        return Err[device.DeviceBufferKernelLaunchResult](Error(kvOk))
    let pageBuffersOk = PagedKVValidateDevicePageBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keyPageBuffers,
        keyPageReceipts,
        valuePageBuffers,
        valuePageReceipts,
        pageBuffersDeviceReceipt
    )
    if IsErr(pageBuffersOk):
        return Err[device.DeviceBufferKernelLaunchResult](Error(pageBuffersOk))
    let launched = device.DeviceMetalPagedAttentionBuffersToBufferFill(
        targetDevice,
        program,
        queryBuffer,
        queryReceipt,
        keysBuffer,
        keysReceipt,
        valuesBuffer,
        valuesReceipt,
        pageTableBuffer,
        pageTableLoadReceipt
    )
    if IsErr(launched):
        return Err[device.DeviceBufferKernelLaunchResult](Error(launched))
    let boundReceipt = PagedKVBindKernelReceiptToDeviceReceipts(
        Value(launched).receipt,
        pageTableDeviceReceipt,
        kvBuffersDeviceReceipt,
        pageBuffersDeviceReceipt,
        "kernel_ir_facts->paged_kv_device_kv_buffers_receipt->resident_output_buffer"
    )
    if IsErr(boundReceipt):
        let _releaseAfterReceiptFailure = device.DeviceMetalReleaseBuffer(Value(launched).buffer)
        return Err[device.DeviceBufferKernelLaunchResult](Error(boundReceipt))
    var out = Value(launched)
    out.receipt = Value(boundReceipt)
    return Ok[device.DeviceBufferKernelLaunchResult](out)

