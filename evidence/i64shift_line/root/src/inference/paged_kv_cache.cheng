        pageTableBuffer,
        pageTableLoadReceipt,
        "paged kv device tensor page table"
    )
    if IsErr(tableOk):
        return Err[PagedKVDeviceTensorPageTableReceipt](Error(tableOk))
    let tensorHash = device.DeviceTensorHash(inputs.pageTable)
    if IsErr(tensorHash):
        return Err[PagedKVDeviceTensorPageTableReceipt](Error(tensorHash))
    let kvReceipt = PagedKVReceiptFor(seq)
