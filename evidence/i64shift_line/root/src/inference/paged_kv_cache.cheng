import std/result
import std/os
import std/rawbytes
import std/strings
import cheng/inference/kernel as infer
import cheng/inference/kernel_ir as kir
import cheng/inference/device

type
    PagedKVPage =
        pageId: int32
        seqId: int32
        usedTokens: int32
        keys: infer.TensorQ[]
        values: infer.TensorQ[]

    PagedKVSequence =
        seqId: int32
        blockPageIds: int32[]
        tokenCount: int32

    PagedKVCache =
        tokensPerPage: int32
        keyDim: int32
        valueDim: int32
        keyScale: int32
        valueScale: int32
        nextPageId: int32
        pages: PagedKVPage[]

    PagedKVReceipt =
        seqId: int32
        tokenCount: int32
        pageCount: int32
        pageTableHash: int64
        trace: str

    PagedKVDevicePageTableReceipt =
        schema: str
        seqId: int32
        tokenCount: int32
        blockCount: int32
        cachePageCount: int32
        tokensPerPage: int32
        keyDim: int32
        valueDim: int32
        pageTableHash: int64
        expectedOrdinalHash: int64
        pageTableTensorHash: int64
        deviceCapabilityHash: str
        pageTableBufferHandle: uint64
        pageTableBufferLogicalHash: int64
        pageTableLoadReceiptHash: int64
        filePath: str
        offsetBytes: int64
        byteCount: int64
        chunkBytes: int32
        sourceRangeHash: int64
        receiptHash: int64

    PagedKVDeviceKvBuffersReceipt =
        schema: str
        seqId: int32
        tokenCount: int32
        blockCount: int32
        cachePageCount: int32
        tokensPerPage: int32
        keyDim: int32
        valueDim: int32
        keyScale: int32
        valueScale: int32
        pageTableHash: int64
        keysTensorHash: int64
        valuesTensorHash: int64
        keysDataHash: int64
        valuesDataHash: int64
        deviceCapabilityHash: str
        keysBufferHandle: uint64
        valuesBufferHandle: uint64
        keysBufferLogicalHash: int64
        valuesBufferLogicalHash: int64
        keysLoadReceiptHash: int64
        valuesLoadReceiptHash: int64
        keysFilePath: str
        valuesFilePath: str
        keysOffsetBytes: int64
        valuesOffsetBytes: int64
        keysByteCount: int64
        valuesByteCount: int64
        keysSourceRangeHash: int64
        valuesSourceRangeHash: int64
        receiptHash: int64

    PagedKVDevicePageBufferReceipt =
        pageId: int32
        pageOrdinal: int32
        seqId: int32
        usedTokens: int32
        keyTensorHash: int64
        valueTensorHash: int64
        keyDataHash: int64
        valueDataHash: int64
        keyBufferHandle: uint64
        valueBufferHandle: uint64
        keyBufferLogicalHash: int64
        valueBufferLogicalHash: int64
        keyLoadReceiptHash: int64
        valueLoadReceiptHash: int64
        keyFilePath: str
        valueFilePath: str
        keyOffsetBytes: int64
        valueOffsetBytes: int64
        keyByteCount: int64
        valueByteCount: int64
        keySourceRangeHash: int64
        valueSourceRangeHash: int64
        pageReceiptHash: int64

    PagedKVDevicePageBuffersReceipt =
        schema: str
        seqId: int32
        tokenCount: int32
        blockCount: int32
        cachePageCount: int32
        tokensPerPage: int32
        keyDim: int32
        valueDim: int32
        keyScale: int32
        valueScale: int32
        pageTableHash: int64
        deviceCapabilityHash: str
        pageAggregateHash: int64
        pageReceipts: PagedKVDevicePageBufferReceipt[]
        receiptHash: int64

    PagedKVDeviceTensorPageTableReceipt =
        schema: str
        seqId: int32
        tokenCount: int32
        blockCount: int32
        cachePageCount: int32
        tokensPerPage: int32
        keyDim: int32
        valueDim: int32
        pageTableHash: int64
        expectedOrdinalHash: int64
        pageTableTensorHash: int64
        deviceCapabilityHash: str
        pageTableBufferHandle: uint64
        pageTableBufferLogicalHash: int64
        pageTableLoadReceiptHash: int64
        receiptHash: int64

    PagedKVDeviceTensorPageBufferReceipt =
        pageId: int32
        pageOrdinal: int32
        seqId: int32
        usedTokens: int32
        keyTensorHash: int64
        valueTensorHash: int64
        keyDataHash: int64
        valueDataHash: int64
        keyBufferHandle: uint64
        valueBufferHandle: uint64
        keyBufferLogicalHash: int64
        valueBufferLogicalHash: int64
        keyLoadReceiptHash: int64
        valueLoadReceiptHash: int64
        pageReceiptHash: int64

    PagedKVDeviceTensorPageBuffersReceipt =
        schema: str
        seqId: int32
        tokenCount: int32
        blockCount: int32
        cachePageCount: int32
        tokensPerPage: int32
        keyDim: int32
        valueDim: int32
        keyScale: int32
        valueScale: int32
        pageTableHash: int64
        deviceCapabilityHash: str
        pageAggregateHash: int64
        pageReceipts: PagedKVDeviceTensorPageBufferReceipt[]
        receiptHash: int64

    PagedKVAttentionInputTensors =
        keysPageMajor: infer.TensorQ
        valuesPageMajor: infer.TensorQ
        pageTable: infer.TensorQ

const
    PagedKVDevicePageTableReceiptSchema = "cheng.inference.paged_kv_device_page_table_receipt.v1"
    PagedKVDeviceKvBuffersReceiptSchema = "cheng.inference.paged_kv_device_kv_buffers_receipt.v1"
    PagedKVDevicePageBuffersReceiptSchema = "cheng.inference.paged_kv_device_page_buffers_receipt.v1"
    PagedKVDeviceTensorPageTableReceiptSchema = "cheng.inference.paged_kv_device_tensor_page_table_receipt.v1"
    PagedKVDeviceTensorPageBuffersReceiptSchema = "cheng.inference.paged_kv_device_tensor_page_buffers_receipt.v1"

fn PagedKVHashStep(hash: int64, value: int64): int64 =
    let mixed = hash * int64(65537) + value + int64(97)
    if mixed < int64(0):
        return int64(0) - mixed
    return mixed

@borrows
fn PagedKVPageTableHash(seq: PagedKVSequence): int64 =
    var h: int64 = int64(97)
    h = PagedKVHashStep(h, int64(seq.seqId))
    h = PagedKVHashStep(h, int64(seq.tokenCount))
    for i in 0..<seq.blockPageIds.len:
        h = PagedKVHashStep(h, int64(seq.blockPageIds[i]))
    return h

fn PagedKVInit(tokensPerPage: int32,
               keyDim: int32,
               valueDim: int32,
               keyScale: int32,
               valueScale: int32): Result[PagedKVCache] =
    if tokensPerPage <= 0 || keyDim <= 0 || valueDim <= 0 || keyScale <= 0 || valueScale <= 0:
        return Err[PagedKVCache]("paged kv: invalid config")
    return Ok[PagedKVCache](PagedKVCache(
        tokensPerPage: tokensPerPage,
        keyDim: keyDim,
        valueDim: valueDim,
        keyScale: keyScale,
        valueScale: valueScale,
        nextPageId: 1,
        pages: []
    ))

fn PagedKVSequenceInit(seqId: int32): PagedKVSequence =
    return PagedKVSequence(
        seqId: seqId,
        blockPageIds: [],
        tokenCount: 0
    )

@borrows
fn PagedKVValidateVector(tensor: infer.TensorQ, dim: int32, scale: int32, label: str): Result[bool] =
    let ok = infer.TensorValidate(tensor)
    if IsErr(ok):
        return Err[bool](Error(ok))
    if tensor.shape.len != 1 || tensor.shape[0] != dim:
        return Err[bool](strings.CloneStr(label))
    if tensor.scale != scale:
        return Err[bool](strings.CloneStr(label))
    return Ok[bool](true)

@borrows
fn PagedKVShapeCopy(shape: int32[]): int32[] =
    var out: int32[]
    for i in 0..<shape.len:
        add(out, shape[i])
    return out

fn PagedKVTensorZeros(shape: int32[], scale: int32): Result[infer.TensorQ] =
    if scale <= 0:
        return Err[infer.TensorQ]("paged kv tensor: scale")
    let countRes = infer.TensorElementCount(shape)
    if IsErr(countRes):
        return Err[infer.TensorQ](Error(countRes))
    var out: infer.TensorQ
    out.shape = PagedKVShapeCopy(shape)
    out.scale = scale
    out.data = []
    for _ in 0..<Value(countRes):
        add(out.data, 0)
    return Ok[infer.TensorQ](out)

@borrows
fn PagedKVFindPageIndex(cache: PagedKVCache, pageId: int32): int32 =
    for i in 0..<cache.pages.len:
        if cache.pages[i].pageId == pageId:
            return i
    return -1

fn PagedKVReplacePage(cache: var PagedKVCache, pageIndex: int32, page: PagedKVPage): Result[bool] =
    if pageIndex < 0 || pageIndex >= cache.pages.len:
        return Err[bool]("paged kv: replace page index")
    cache.pages[pageIndex] = page
    return Ok[bool](true)

fn PagedKVAppendPage(cache: var PagedKVCache, seq: var PagedKVSequence): int32 =
    let pageId = cache.nextPageId
    cache.nextPageId = cache.nextPageId + 1
    add(cache.pages, PagedKVPage(
        pageId: pageId,
        seqId: seq.seqId,
        usedTokens: 0,
        keys: [],
        values: []
    ))
    add(seq.blockPageIds, pageId)
    return pageId

fn PagedKVAppendToken(cache: var PagedKVCache,
                      seq: var PagedKVSequence,
                      key: infer.TensorQ,
                      value: infer.TensorQ): Result[bool] =
    let keyOk = PagedKVValidateVector(key, cache.keyDim, cache.keyScale, "paged kv: key shape")
    if IsErr(keyOk):
        return Err[bool](Error(keyOk))
    let valueOk = PagedKVValidateVector(value, cache.valueDim, cache.valueScale, "paged kv: value shape")
    if IsErr(valueOk):
        return Err[bool](Error(valueOk))
    var pageId: int32
    if seq.blockPageIds.len <= 0:
        pageId = PagedKVAppendPage(cache, seq)
    else:
        pageId = seq.blockPageIds[seq.blockPageIds.len - 1]
    var pageIndex = PagedKVFindPageIndex(cache, pageId)
    if pageIndex < 0:
        return Err[bool]("paged kv: missing page")
    if cache.pages[pageIndex].seqId != seq.seqId:
        return Err[bool]("paged kv: sequence/page mismatch")
    if cache.pages[pageIndex].usedTokens >= cache.tokensPerPage:
        pageId = PagedKVAppendPage(cache, seq)
        pageIndex = PagedKVFindPageIndex(cache, pageId)
        if pageIndex < 0:
            return Err[bool]("paged kv: page allocation")
    var page = cache.pages[pageIndex]
    add(page.keys, key)
    add(page.values, value)
    page.usedTokens = page.usedTokens + 1
    let replaceOk = PagedKVReplacePage(cache, pageIndex, page)
    if IsErr(replaceOk):
        return Err[bool](Error(replaceOk))
    seq.tokenCount = seq.tokenCount + 1
    return Ok[bool](true)

@borrows
fn PagedKVGetToken(cache: PagedKVCache,
                   seq: PagedKVSequence,
                   tokenIndex: int32,
                   outKey: var infer.TensorQ,
                   outValue: var infer.TensorQ): Result[bool] =
    if tokenIndex < 0 || tokenIndex >= seq.tokenCount:
        return Err[bool]("paged kv: token index")
    let blockIndex = tokenIndex / cache.tokensPerPage
    let offset = tokenIndex % cache.tokensPerPage
    if blockIndex < 0 || blockIndex >= seq.blockPageIds.len:
        return Err[bool]("paged kv: block table")
    let pageIndex = PagedKVFindPageIndex(cache, seq.blockPageIds[blockIndex])
    if pageIndex < 0:
        return Err[bool]("paged kv: page missing")
    if cache.pages[pageIndex].seqId != seq.seqId:
        return Err[bool]("paged kv: sequence/page mismatch")
    if offset < 0 || offset >= cache.pages[pageIndex].usedTokens:
        return Err[bool]("paged kv: page offset")
    if offset >= cache.pages[pageIndex].keys.len || offset >= cache.pages[pageIndex].values.len:
        return Err[bool]("paged kv: page data length")
    outKey = cache.pages[pageIndex].keys[offset]
    outValue = cache.pages[pageIndex].values[offset]
    return Ok[bool](true)

@borrows
fn PagedKVDotScore(query: infer.TensorQ, key: infer.TensorQ): Result[int64] =
    let keyValid = infer.TensorValidate(key)
    if IsErr(keyValid):
        return Err[int64](Error(keyValid))
    if key.shape.len != 1:
        return Err[int64]("paged kv attention: key rank")
    let queryOk = PagedKVValidateVector(query, key.shape[0], query.scale, "paged kv attention: query shape")
    if IsErr(queryOk):
        return Err[int64](Error(queryOk))
    if query.scale != key.scale:
        return Err[int64]("paged kv attention: key scale")
    var score: int64
    score = int64(0)
    for i in 0..<query.data.len:
        score = score + int64(query.data[i]) * int64(key.data[i])
    return Ok[int64](score)

@borrows
fn PagedKVAttentionQueryFill(out: var infer.TensorQ,
                             cache: PagedKVCache,
                             seq: PagedKVSequence,
                             query: infer.TensorQ,
                             headDim: int32,
                             queryHeadCount: int32): Result[bool] =
    if seq.tokenCount <= 0:
        return Err[bool]("paged kv attention: empty sequence")
    if headDim <= 0:
        return Err[bool]("paged kv attention: head dim")
    if cache.keyDim % headDim != 0 || cache.valueDim % headDim != 0:
        return Err[bool]("paged kv attention: head dim divisibility")
    let kvHeadCount = cache.valueDim / headDim
    if kvHeadCount != cache.keyDim / headDim:
        return Err[bool]("paged kv attention: head count mismatch")
    # GQA: queryHeadCount independent query heads share kvHeadCount key/value
    # heads (HF repeat_kv semantics) -- queryHead qh reads kv head qh/repeat;
    # repeat==1 (queryHeadCount==kvHeadCount) is the plain MHA case.
    if queryHeadCount <= 0 || queryHeadCount % kvHeadCount != 0:
        return Err[bool]("paged kv attention: query head count")
    let repeat = queryHeadCount / kvHeadCount
    let queryOk = PagedKVValidateVector(query, queryHeadCount * headDim, cache.keyScale, "paged kv attention: query shape")
    if IsErr(queryOk):
        return Err[bool](Error(queryOk))
    # 1/sqrt(headDim) temperature in fixed point: isqrtHead = sqrt(headDim)*SQRT_FIX.
    let sqrtFix = int64(10000)
    let isqrtHead = infer.InferenceIntSqrt(int64(headDim) * sqrtFix * sqrtFix)
    if isqrtHead <= int64(0):
        return Err[bool]("paged kv attention: sqrt head dim")
    let zerosRes = infer.TensorZerosFill(out, [queryHeadCount * headDim], cache.valueScale)
    if IsErr(zerosRes):
        return Err[bool](Error(zerosRes))
    for qh in 0..<queryHeadCount:
        let kvHead = qh / repeat
        let queryBase = qh * headDim
        let kvBase = kvHead * headDim
        var scores: int32[]
        var values: infer.TensorQ[]
        var maxScore: int32
        var sawToken: bool
        sawToken = false
        for tokenIndex in 0..<seq.tokenCount:
            var key: infer.TensorQ
            var value: infer.TensorQ
            let getRes = PagedKVGetToken(cache, seq, tokenIndex, key, value)
            if IsErr(getRes):
                return Err[bool](Error(getRes))
            let keyOk = PagedKVValidateVector(key, cache.keyDim, cache.keyScale, "paged kv attention: key shape")
            if IsErr(keyOk):
                return Err[bool](Error(keyOk))
            let valueOk = PagedKVValidateVector(value, cache.valueDim, cache.valueScale, "paged kv attention: value shape")
            if IsErr(valueOk):
                return Err[bool](Error(valueOk))
            var dot: int64
            dot = int64(0)
            for d in 0..<headDim:
                dot = dot + int64(query.data[queryBase + d]) * int64(key.data[kvBase + d])
            let score = infer.InferenceSaturateI32(infer.InferenceRoundDivI64(dot * sqrtFix, int64(cache.keyScale) * isqrtHead))
            if !sawToken || score > maxScore:
                maxScore = score
                sawToken = true
            add(scores, score)
            add(values, value)
        if !sawToken:
            return Err[bool]("paged kv attention: no token")
        var weights: int32[]
        var denom: int64
        denom = int64(0)
        for i in 0..<scores.len:
            let w = infer.InferenceExpNegQ(scores[i] - maxScore, cache.keyScale, infer.InferenceSoftmaxInternalScale)
            add(weights, w)
            denom = denom + int64(w)
        if denom <= int64(0):
            return Err[bool]("paged kv attention: zero denominator")
        for d in 0..<headDim:
            var numer: int64
            numer = int64(0)
            for tokenIndex in 0..<values.len:
                numer = numer + int64(values[tokenIndex].data[kvBase + d]) * int64(weights[tokenIndex])
            out.data[queryBase + d] = infer.InferenceSaturateI32(infer.InferenceRoundDivI64(numer, denom))
    return Ok[bool](true)

@borrows
fn PagedKVExpectedBlockCount(seq: PagedKVSequence, tokensPerPage: int32): Result[int32] =
    if tokensPerPage <= 0:
        return Err[int32]("paged kv: invalid tokens per page")
    if seq.tokenCount <= 0:
        return Err[int32]("paged kv: empty sequence")
    return Ok[int32]((seq.tokenCount + tokensPerPage - 1) / tokensPerPage)

@borrows
fn PagedKVBuildAttentionInputTensorsFill(out: var PagedKVAttentionInputTensors,
                                         cache: PagedKVCache,
                                         seq: PagedKVSequence): Result[bool] =
    let blockCountRes = PagedKVExpectedBlockCount(seq, cache.tokensPerPage)
    if IsErr(blockCountRes):
        return Err[bool](Error(blockCountRes))
    let blockCount = Value(blockCountRes)
    if seq.blockPageIds.len != blockCount:
        return Err[bool]("paged kv attention inputs: block table length")
    if cache.pages.len <= 0:
        return Err[bool]("paged kv attention inputs: cache pages")
    let keysRes = PagedKVTensorZeros([cache.pages.len, cache.tokensPerPage, cache.keyDim], cache.keyScale)
    if IsErr(keysRes):
        return Err[bool](Error(keysRes))
    let valuesRes = PagedKVTensorZeros([cache.pages.len, cache.tokensPerPage, cache.valueDim], cache.valueScale)
    if IsErr(valuesRes):
        return Err[bool](Error(valuesRes))
    let tableRes = PagedKVTensorZeros([blockCount], 1)
    if IsErr(tableRes):
        return Err[bool](Error(tableRes))
    var keysPageMajor = Value(keysRes)
    var valuesPageMajor = Value(valuesRes)
    var pageTable = Value(tableRes)
    for pageOrdinal in 0..<cache.pages.len:
        if cache.pages[pageOrdinal].usedTokens < 0 || cache.pages[pageOrdinal].usedTokens > cache.tokensPerPage:
            return Err[bool]("paged kv attention inputs: page used tokens")
        if cache.pages[pageOrdinal].keys.len != cache.pages[pageOrdinal].usedTokens ||
           cache.pages[pageOrdinal].values.len != cache.pages[pageOrdinal].usedTokens:
            return Err[bool]("paged kv attention inputs: page data length")
        for tokenOffset in 0..<cache.pages[pageOrdinal].usedTokens:
            let key = cache.pages[pageOrdinal].keys[tokenOffset]
            let value = cache.pages[pageOrdinal].values[tokenOffset]
            let keyOk = PagedKVValidateVector(key, cache.keyDim, cache.keyScale, "paged kv attention inputs: key shape")
            if IsErr(keyOk):
                return Err[bool](Error(keyOk))
            let valueOk = PagedKVValidateVector(value, cache.valueDim, cache.valueScale, "paged kv attention inputs: value shape")
            if IsErr(valueOk):
                return Err[bool](Error(valueOk))
            let keyBase = ((pageOrdinal * cache.tokensPerPage) + tokenOffset) * cache.keyDim
            for dim in 0..<cache.keyDim:
                keysPageMajor.data[keyBase + dim] = key.data[dim]
            let valueBase = ((pageOrdinal * cache.tokensPerPage) + tokenOffset) * cache.valueDim
            for dim in 0..<cache.valueDim:
                valuesPageMajor.data[valueBase + dim] = value.data[dim]
    for blockIndex in 0..<blockCount:
        let pageIndex = PagedKVFindPageIndex(cache, seq.blockPageIds[blockIndex])
        if pageIndex < 0:
            return Err[bool]("paged kv attention inputs: missing page")
        if cache.pages[pageIndex].seqId != seq.seqId:
            return Err[bool]("paged kv attention inputs: sequence/page mismatch")
        var expectedUsed = cache.tokensPerPage
        if blockIndex == blockCount - 1:
            expectedUsed = seq.tokenCount - blockIndex * cache.tokensPerPage
        if cache.pages[pageIndex].usedTokens != expectedUsed:
            return Err[bool]("paged kv attention inputs: page occupancy")
        pageTable.data[blockIndex] = pageIndex
    out.keysPageMajor = keysPageMajor
    out.valuesPageMajor = valuesPageMajor
    out.pageTable = pageTable
    return Ok[bool](true)

@borrows
fn PagedKVBuildPageKeyTensor(page: PagedKVPage,
                             tokensPerPage: int32,
                             keyDim: int32,
                             keyScale: int32): Result[infer.TensorQ] =
    if tokensPerPage <= 0 || keyDim <= 0:
        return Err[infer.TensorQ]("paged kv page key tensor: shape")
    if page.usedTokens < 0 || page.usedTokens > tokensPerPage:
        return Err[infer.TensorQ]("paged kv page key tensor: used tokens")
    if page.keys.len != page.usedTokens:
        return Err[infer.TensorQ]("paged kv page key tensor: key count")
    let tensorRes = PagedKVTensorZeros([tokensPerPage, keyDim], keyScale)
    if IsErr(tensorRes):
        return Err[infer.TensorQ](Error(tensorRes))
    var out = Value(tensorRes)
    for tokenOffset in 0..<page.usedTokens:
        let keyOk = PagedKVValidateVector(page.keys[tokenOffset], keyDim, keyScale, "paged kv page key tensor: key shape")
        if IsErr(keyOk):
            return Err[infer.TensorQ](Error(keyOk))
        let base = tokenOffset * keyDim
        for dim in 0..<keyDim:
            out.data[base + dim] = page.keys[tokenOffset].data[dim]
    return Ok[infer.TensorQ](out)

@borrows
fn PagedKVBuildPageValueTensor(page: PagedKVPage,
                               tokensPerPage: int32,
                               valueDim: int32,
                               valueScale: int32): Result[infer.TensorQ] =
    if tokensPerPage <= 0 || valueDim <= 0:
        return Err[infer.TensorQ]("paged kv page value tensor: shape")
    if page.usedTokens < 0 || page.usedTokens > tokensPerPage:
        return Err[infer.TensorQ]("paged kv page value tensor: used tokens")
    if page.values.len != page.usedTokens:
        return Err[infer.TensorQ]("paged kv page value tensor: value count")
    let tensorRes = PagedKVTensorZeros([tokensPerPage, valueDim], valueScale)
    if IsErr(tensorRes):
        return Err[infer.TensorQ](Error(tensorRes))
    var out = Value(tensorRes)
    for tokenOffset in 0..<page.usedTokens:
        let valueOk = PagedKVValidateVector(page.values[tokenOffset], valueDim, valueScale, "paged kv page value tensor: value shape")
        if IsErr(valueOk):
            return Err[infer.TensorQ](Error(valueOk))
        let base = tokenOffset * valueDim
        for dim in 0..<valueDim:
            out.data[base + dim] = page.values[tokenOffset].data[dim]
    return Ok[infer.TensorQ](out)

# #155r-mgqa: build one kv head's headDim-wide page tensor directly from a
# PagedKVPage's raw per-token key/value vectors (each keyDim/valueDim-wide,
# the kvRows-wide concatenation across every kv head), slicing out only the
# [headOffset:headOffset+headDim] span. Feeds the Metal per-query-head
# attention launch the same headDim-wide K/V a query head reads on the CPU
# path (PagedKVAttentionQueryFill's kvBase slice), instead of the whole
# concatenated kvRows-wide row -- and is also used, with the identical
# headDim/headOffset, to independently rebuild the "expected" tensor the
# device-buffer-load receipt is checked against
# (PagedKVBuildDeviceTensorPageBuffersReceipt), so both sides of that
# hash check slice the exact same way.
@borrows
fn PagedKVBuildPageKeyHeadTensor(page: PagedKVPage,
                                 tokensPerPage: int32,
                                 keyDim: int32,
                                 headDim: int32,
                                 headOffset: int32,
                                 keyScale: int32): Result[infer.TensorQ] =
    if tokensPerPage <= 0 || keyDim <= 0 || headDim <= 0 || headOffset < 0 || headOffset + headDim > keyDim:
        return Err[infer.TensorQ]("paged kv page key head tensor: shape")
    if page.usedTokens < 0 || page.usedTokens > tokensPerPage:
        return Err[infer.TensorQ]("paged kv page key head tensor: used tokens")
    if page.keys.len != page.usedTokens:
        return Err[infer.TensorQ]("paged kv page key head tensor: key count")
    let tensorRes = PagedKVTensorZeros([tokensPerPage, headDim], keyScale)
    if IsErr(tensorRes):
        return Err[infer.TensorQ](Error(tensorRes))
    var out = Value(tensorRes)
    for tokenOffset in 0..<page.usedTokens:
        let keyOk = PagedKVValidateVector(page.keys[tokenOffset], keyDim, keyScale, "paged kv page key head tensor: key shape")
        if IsErr(keyOk):
            return Err[infer.TensorQ](Error(keyOk))
        let base = tokenOffset * headDim
        for dim in 0..<headDim:
            out.data[base + dim] = page.keys[tokenOffset].data[headOffset + dim]
    return Ok[infer.TensorQ](out)

@borrows
fn PagedKVBuildPageValueHeadTensor(page: PagedKVPage,
                                   tokensPerPage: int32,
                                   valueDim: int32,
                                   headDim: int32,
                                   headOffset: int32,
                                   valueScale: int32): Result[infer.TensorQ] =
    if tokensPerPage <= 0 || valueDim <= 0 || headDim <= 0 || headOffset < 0 || headOffset + headDim > valueDim:
        return Err[infer.TensorQ]("paged kv page value head tensor: shape")
    if page.usedTokens < 0 || page.usedTokens > tokensPerPage:
        return Err[infer.TensorQ]("paged kv page value head tensor: used tokens")
    if page.values.len != page.usedTokens:
        return Err[infer.TensorQ]("paged kv page value head tensor: value count")
    let tensorRes = PagedKVTensorZeros([tokensPerPage, headDim], valueScale)
    if IsErr(tensorRes):
        return Err[infer.TensorQ](Error(tensorRes))
    var out = Value(tensorRes)
    for tokenOffset in 0..<page.usedTokens:
        let valueOk = PagedKVValidateVector(page.values[tokenOffset], valueDim, valueScale, "paged kv page value head tensor: value shape")
        if IsErr(valueOk):
            return Err[infer.TensorQ](Error(valueOk))
        let base = tokenOffset * headDim
        for dim in 0..<headDim:
            out.data[base + dim] = page.values[tokenOffset].data[headOffset + dim]
    return Ok[infer.TensorQ](out)

fn PagedKVEvictLastPage(cache: var PagedKVCache, seq: var PagedKVSequence): Result[bool] =
    if seq.blockPageIds.len <= 0:
        return Err[bool]("paged kv: evict empty")
    let pageId = seq.blockPageIds[seq.blockPageIds.len - 1]
    let pageIndex = PagedKVFindPageIndex(cache, pageId)
    if pageIndex < 0:
        return Err[bool]("paged kv: evict missing page")
    if cache.pages[pageIndex].seqId != seq.seqId:
        return Err[bool]("paged kv: evict seq mismatch")
    seq.tokenCount = seq.tokenCount - cache.pages[pageIndex].usedTokens
    if seq.tokenCount < 0:
        return Err[bool]("paged kv: evict token underflow")
    var newBlocks: int32[]
    let keepBlockCount = seq.blockPageIds.len - 1
    for i in 0..<keepBlockCount:
        add(newBlocks, seq.blockPageIds[i])
    seq.blockPageIds = newBlocks
    var newPages: PagedKVPage[]
    for i in 0..<cache.pages.len:
        if cache.pages[i].pageId != pageId:
            add(newPages, cache.pages[i])
    cache.pages = newPages
    return Ok[bool](true)

@borrows
fn PagedKVReceiptFor(seq: PagedKVSequence): PagedKVReceipt =
    return PagedKVReceipt(
        seqId: seq.seqId,
        tokenCount: seq.tokenCount,
        pageCount: seq.blockPageIds.len,
        pageTableHash: PagedKVPageTableHash(seq),
        trace: "paged-kv-page-table"
    )

fn PagedKVDevicePageTableReceiptHash(receipt: PagedKVDevicePageTableReceipt): int64 =
    var h: int64 = device.DeviceHashText("cheng.inference.paged_kv_device_page_table_receipt.hash.v1")
    h = device.DeviceHashStep(h, device.DeviceHashText(receipt.schema))
    h = device.DeviceHashStep(h, int64(receipt.seqId))
    h = device.DeviceHashStep(h, int64(receipt.tokenCount))
    h = device.DeviceHashStep(h, int64(receipt.blockCount))
    h = device.DeviceHashStep(h, int64(receipt.cachePageCount))
    h = device.DeviceHashStep(h, int64(receipt.tokensPerPage))
    h = device.DeviceHashStep(h, int64(receipt.keyDim))
    h = device.DeviceHashStep(h, int64(receipt.valueDim))
    h = device.DeviceHashStep(h, receipt.pageTableHash)
    h = device.DeviceHashStep(h, receipt.expectedOrdinalHash)
    h = device.DeviceHashStep(h, receipt.pageTableTensorHash)
    h = device.DeviceHashStep(h, device.DeviceHashText(receipt.deviceCapabilityHash))
    h = device.DeviceHashU64(h, receipt.pageTableBufferHandle)
    h = device.DeviceHashStep(h, receipt.pageTableBufferLogicalHash)
    h = device.DeviceHashStep(h, receipt.pageTableLoadReceiptHash)
    h = device.DeviceHashStep(h, device.DeviceHashText(receipt.filePath))
    h = device.DeviceHashStep(h, receipt.offsetBytes)
    h = device.DeviceHashStep(h, receipt.byteCount)
    h = device.DeviceHashStep(h, int64(receipt.chunkBytes))
    h = device.DeviceHashStep(h, receipt.sourceRangeHash)
    return h

fn PagedKVBuildDevicePageTableReceipt(cache: PagedKVCache,
                                      seq: PagedKVSequence,
                                      targetDevice: device.Device,
                                      pageTableBuffer: device.DeviceBuffer,
                                      pageTableLoadReceipt: device.DeviceFileRangeBufferLoadReceipt): Result[PagedKVDevicePageTableReceipt] =
    var inputs: PagedKVAttentionInputTensors
    let inputOk = PagedKVBuildAttentionInputTensorsFill(inputs, cache, seq)
    if IsErr(inputOk):
        return Err[PagedKVDevicePageTableReceipt](Error(inputOk))
    let receiptOk = device.DeviceValidateFileRangeBufferLoadReceipt(targetDevice, pageTableBuffer, pageTableLoadReceipt)
    if IsErr(receiptOk):
        return Err[PagedKVDevicePageTableReceipt](Error(receiptOk))
    if pageTableLoadReceipt.status != device.InferenceDeviceBufferLoadStatusMetalBufferLoaded ||
       pageTableBuffer.handle == uint64(0):
        return Err[PagedKVDevicePageTableReceipt]("paged kv device page table: metal buffer")
    if pageTableBuffer.dtype != kir.KernelDtypeI32 ||
       pageTableLoadReceipt.deviceBufferDtype != kir.KernelDtypeI32:
        return Err[PagedKVDevicePageTableReceipt]("paged kv device page table: dtype")
    let expectedBytes = device.DeviceI32BytesRequired(inputs.pageTable.data.len)
    if IsErr(expectedBytes):
        return Err[PagedKVDevicePageTableReceipt](Error(expectedBytes))
    if pageTableBuffer.sizeBytes != int64(Value(expectedBytes)) ||
       pageTableLoadReceipt.byteCount != int64(Value(expectedBytes)):
        return Err[PagedKVDevicePageTableReceipt]("paged kv device page table: byte size")
    let rangeHash = device.DeviceHashFileRangePath(
        pageTableLoadReceipt.filePath,
        pageTableLoadReceipt.offsetBytes,
        pageTableLoadReceipt.byteCount,
        pageTableLoadReceipt.chunkBytes
    )
    if IsErr(rangeHash):
        return Err[PagedKVDevicePageTableReceipt](Error(rangeHash))
    if Value(rangeHash) != pageTableLoadReceipt.sourceRangeHash ||
       pageTableBuffer.logicalHash != pageTableLoadReceipt.sourceRangeHash:
        return Err[PagedKVDevicePageTableReceipt]("paged kv device page table: source hash")
    let bytes = os.ReadFileRangeBytesResult(
        pageTableLoadReceipt.filePath,
        pageTableLoadReceipt.offsetBytes,
        Value(expectedBytes)
    )
    if IsErr(bytes):
        return Err[PagedKVDevicePageTableReceipt](Error(bytes))
    if rawbytes.BytesLen(Value(bytes)) != Value(expectedBytes):
        return Err[PagedKVDevicePageTableReceipt]("paged kv device page table: short read")
    for i in 0..<inputs.pageTable.data.len:
        let observed = device.DeviceReadI32LE(Value(bytes), i * 4)
        if observed != inputs.pageTable.data[i]:
            return Err[PagedKVDevicePageTableReceipt]("paged kv device page table: ordinal")
    let tensorHash = device.DeviceTensorHash(inputs.pageTable)
    if IsErr(tensorHash):
        return Err[PagedKVDevicePageTableReceipt](Error(tensorHash))
    let kvReceipt = PagedKVReceiptFor(seq)
    var out = PagedKVDevicePageTableReceipt(
        schema: PagedKVDevicePageTableReceiptSchema,
        seqId: kvReceipt.seqId,
        tokenCount: kvReceipt.tokenCount,
        blockCount: kvReceipt.pageCount,
        cachePageCount: cache.pages.len,
        tokensPerPage: cache.tokensPerPage,
        keyDim: cache.keyDim,
        valueDim: cache.valueDim,
        pageTableHash: kvReceipt.pageTableHash,
        expectedOrdinalHash: device.DeviceHashI32(inputs.pageTable.data),
        pageTableTensorHash: Value(tensorHash),
        deviceCapabilityHash: share(targetDevice.capabilityHash),
        pageTableBufferHandle: pageTableBuffer.handle,
        pageTableBufferLogicalHash: pageTableBuffer.logicalHash,
        pageTableLoadReceiptHash: pageTableLoadReceipt.receiptHash,
        filePath: pageTableLoadReceipt.filePath,
        offsetBytes: pageTableLoadReceipt.offsetBytes,
        byteCount: pageTableLoadReceipt.byteCount,
        chunkBytes: pageTableLoadReceipt.chunkBytes,
        sourceRangeHash: pageTableLoadReceipt.sourceRangeHash,
        receiptHash: int64(0)
    )
    out.receiptHash = PagedKVDevicePageTableReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[PagedKVDevicePageTableReceipt]("paged kv device page table: receipt hash")
    return Ok[PagedKVDevicePageTableReceipt](out)

fn PagedKVValidateDevicePageTableReceipt(cache: PagedKVCache,
                                         seq: PagedKVSequence,
                                         targetDevice: device.Device,
                                         pageTableBuffer: device.DeviceBuffer,
                                         pageTableLoadReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                         receipt: PagedKVDevicePageTableReceipt): Result[bool] =
    let expected = PagedKVBuildDevicePageTableReceipt(cache, seq, targetDevice, pageTableBuffer, pageTableLoadReceipt)
    if IsErr(expected):
        return Err[bool](Error(expected))
    let want = Value(expected)
    if receipt.schema != PagedKVDevicePageTableReceiptSchema ||
       receipt.seqId != want.seqId ||
       receipt.tokenCount != want.tokenCount ||
       receipt.blockCount != want.blockCount ||
       receipt.cachePageCount != want.cachePageCount ||
       receipt.tokensPerPage != want.tokensPerPage ||
       receipt.keyDim != want.keyDim ||
       receipt.valueDim != want.valueDim ||
       receipt.pageTableHash != want.pageTableHash ||
       receipt.expectedOrdinalHash != want.expectedOrdinalHash ||
       receipt.pageTableTensorHash != want.pageTableTensorHash ||
       receipt.deviceCapabilityHash != want.deviceCapabilityHash ||
       receipt.pageTableBufferHandle != want.pageTableBufferHandle ||
       receipt.pageTableBufferLogicalHash != want.pageTableBufferLogicalHash ||
       receipt.pageTableLoadReceiptHash != want.pageTableLoadReceiptHash ||
       receipt.filePath != want.filePath ||
       receipt.offsetBytes != want.offsetBytes ||
       receipt.byteCount != want.byteCount ||
       receipt.chunkBytes != want.chunkBytes ||
       receipt.sourceRangeHash != want.sourceRangeHash ||
       receipt.receiptHash != want.receiptHash:
        return Err[bool]("paged kv device page table: receipt mismatch")
    if PagedKVDevicePageTableReceiptHash(receipt) != receipt.receiptHash:
        return Err[bool]("paged kv device page table: hash")
    return Ok[bool](true)

@borrows
fn PagedKVDeviceKvBuffersReceiptHash(receipt: PagedKVDeviceKvBuffersReceipt): int64 =
    var h: int64 = device.DeviceHashText("cheng.inference.paged_kv_device_kv_buffers_receipt.hash.v1")
    h = device.DeviceHashStep(h, device.DeviceHashText(receipt.schema))
    h = device.DeviceHashStep(h, int64(receipt.seqId))
    h = device.DeviceHashStep(h, int64(receipt.tokenCount))
    h = device.DeviceHashStep(h, int64(receipt.blockCount))
    h = device.DeviceHashStep(h, int64(receipt.cachePageCount))
    h = device.DeviceHashStep(h, int64(receipt.tokensPerPage))
    h = device.DeviceHashStep(h, int64(receipt.keyDim))
    h = device.DeviceHashStep(h, int64(receipt.valueDim))
    h = device.DeviceHashStep(h, int64(receipt.keyScale))
    h = device.DeviceHashStep(h, int64(receipt.valueScale))
    h = device.DeviceHashStep(h, receipt.pageTableHash)
    h = device.DeviceHashStep(h, receipt.keysTensorHash)
    h = device.DeviceHashStep(h, receipt.valuesTensorHash)
    h = device.DeviceHashStep(h, receipt.keysDataHash)
    h = device.DeviceHashStep(h, receipt.valuesDataHash)
    h = device.DeviceHashStep(h, device.DeviceHashText(receipt.deviceCapabilityHash))
    h = device.DeviceHashU64(h, receipt.keysBufferHandle)
    h = device.DeviceHashU64(h, receipt.valuesBufferHandle)
    h = device.DeviceHashStep(h, receipt.keysBufferLogicalHash)
    h = device.DeviceHashStep(h, receipt.valuesBufferLogicalHash)
    h = device.DeviceHashStep(h, receipt.keysLoadReceiptHash)
    h = device.DeviceHashStep(h, receipt.valuesLoadReceiptHash)
    h = device.DeviceHashStep(h, device.DeviceHashText(receipt.keysFilePath))
    h = device.DeviceHashStep(h, device.DeviceHashText(receipt.valuesFilePath))
    h = device.DeviceHashStep(h, receipt.keysOffsetBytes)
    h = device.DeviceHashStep(h, receipt.valuesOffsetBytes)
    h = device.DeviceHashStep(h, receipt.keysByteCount)
    h = device.DeviceHashStep(h, receipt.valuesByteCount)
    h = device.DeviceHashStep(h, receipt.keysSourceRangeHash)
    h = device.DeviceHashStep(h, receipt.valuesSourceRangeHash)
    return h

