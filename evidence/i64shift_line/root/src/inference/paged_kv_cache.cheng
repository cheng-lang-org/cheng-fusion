        return Err[device.KernelLaunchReceipt](Error(releaseOutput))
    resident.receipt.trace = "kernel_ir_facts->paged_kv_device_page_buffers_receipt->native_page_buffers_typed_metal_paged_attention_i32"
    return Ok[device.KernelLaunchReceipt](resident.receipt)

@borrows
fn PagedKVDeviceMetalPagedAttentionPageBuffersToBufferFill(cache: PagedKVCache,
                                                           seq: PagedKVSequence,
                                                           pageTableDeviceReceipt: PagedKVDevicePageTableReceipt,
                                                           pageBuffersDeviceReceipt: PagedKVDevicePageBuffersReceipt,
                                                           targetDevice: device.Device,
                                                           program: kir.KernelProgram,
                                                           queryBuffer: device.DeviceBuffer,
                                                           queryReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                           pageTableBuffer: device.DeviceBuffer,
                                                           pageTableLoadReceipt: device.DeviceFileRangeBufferLoadReceipt,
                                                           keyPageBuffers: device.DeviceBuffer[],
                                                           keyPageReceipts: device.DeviceFileRangeBufferLoadReceipt[],
                                                           valuePageBuffers: device.DeviceBuffer[],
                                                           valuePageReceipts: device.DeviceFileRangeBufferLoadReceipt[]): Result[device.DeviceBufferKernelLaunchResult] =
    let tableOk = PagedKVValidateDevicePageTableReceipt(
        cache,
        seq,
        targetDevice,
        pageTableBuffer,
        pageTableLoadReceipt,
        pageTableDeviceReceipt
    )
    if IsErr(tableOk):
        return Err[device.DeviceBufferKernelLaunchResult](Error(tableOk))
    let pageBuffersOk = PagedKVValidateDevicePageBuffersReceipt(
        cache,
        seq,
        targetDevice,
        keyPageBuffers,
        keyPageReceipts,
        valuePageBuffers,
        valuePageReceipts,
        pageBuffersDeviceReceipt
    )
    if IsErr(pageBuffersOk):
        return Err[device.DeviceBufferKernelLaunchResult](Error(pageBuffersOk))
    let launched = device.DeviceMetalPagedAttentionPageBuffersToBufferFill(
        targetDevice,
        program,
        queryBuffer,
        queryReceipt,
        keyPageBuffers,
        keyPageReceipts,
        valuePageBuffers,
        valuePageReceipts,
        pageTableBuffer,
        pageTableLoadReceipt
    )
    if IsErr(launched):
        return Err[device.DeviceBufferKernelLaunchResult](Error(launched))
    let boundReceipt = PagedKVBindKernelReceiptToPageDeviceReceipts(
        Value(launched).receipt,
        pageTableDeviceReceipt,
        pageBuffersDeviceReceipt,
        "kernel_ir_facts->paged_kv_device_page_buffers_receipt->native_page_buffers_resident_output_buffer"
    )
    if IsErr(boundReceipt):
        let _releaseAfterReceiptFailure = device.DeviceMetalReleaseBuffer(Value(launched).buffer)
        return Err[device.DeviceBufferKernelLaunchResult](Error(boundReceipt))
    var out = Value(launched)
    out.receipt = Value(boundReceipt)
    return Ok[device.DeviceBufferKernelLaunchResult](out)
