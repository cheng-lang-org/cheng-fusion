        schema: PagedKVDeviceTensorPageTableReceiptSchema,
        seqId: kvReceipt.seqId,
        tokenCount: kvReceipt.tokenCount,
        blockCount: kvReceipt.pageCount,
        cachePageCount: cache.pages.len,
        tokensPerPage: cache.tokensPerPage,
        keyDim: cache.keyDim,
        valueDim: cache.valueDim,
        pageTableHash: kvReceipt.pageTableHash,
        expectedOrdinalHash: device.DeviceHashI32(inputs.pageTable.data),
        pageTableTensorHash: Value(tensorHash),
        deviceCapabilityHash: share(targetDevice.capabilityHash),
        pageTableBufferHandle: pageTableBuffer.handle,
        pageTableBufferLogicalHash: pageTableBuffer.logicalHash,
        pageTableLoadReceiptHash: pageTableLoadReceipt.receiptHash,
        receiptHash: int64(0)
    )
    out.receiptHash = PagedKVDeviceTensorPageTableReceiptHash(out)
    if out.receiptHash <= int64(0):
        return Err[PagedKVDeviceTensorPageTableReceipt]("paged kv device tensor page table: receipt hash")
    return Ok[PagedKVDeviceTensorPageTableReceipt](out)

