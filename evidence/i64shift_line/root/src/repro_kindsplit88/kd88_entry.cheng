# #88 minimal repro, entry point: imports BOTH the leaf (directly, default
# non-aliased import) and the intermediate module (which itself already
# imports the same leaf under a different alias) -- a diamond import. Mirrors
# src/libp2p/tests/node_resource_smoke.cheng importing both
# .../noderesource/noderesource (which imports protobuf as nrpb) and
# .../noderesource/protobuf directly.
#
# Before the #88 fix: the bare `KSplit88Box` in the `var` declaration below
# resolves ambiguously (two ObjectDef entries -- `kd88_leaf.KSplit88Box` and
# `kd88ml.KSplit88Box` -- share decl_path but were previously counted as two
# distinct candidates) and falls back to a guessed SLOT_VARIANT (kind=2),
# while the constructor call's own return type resolves to SLOT_OBJECT
# (kind=5) -- "typed let kind mismatch ... declared_kind=2 actual_kind=5".

import cheng/repro_kindsplit88/kd88_leaf
import cheng/repro_kindsplit88/kd88_mid

fn main(): int32 =
    var b: KSplit88Box = kd88MakeBox(41)
    return kd88MidBump(b)
