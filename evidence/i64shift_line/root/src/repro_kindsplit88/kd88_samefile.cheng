# Same-file control (mirrors revloop81's "probe14"): struct declared and used
# entirely within one file, no cross-module import at all. Must compile and
# run correctly both before and after the #88 fix.

type
    SameFileBox88 =
        v: int32

fn kd88SameFileMake(x: int32): SameFileBox88 =
    SameFileBox88(v: x)

fn main(): int32 =
    var b: SameFileBox88 = kd88SameFileMake(41)
    return b.v + 1
