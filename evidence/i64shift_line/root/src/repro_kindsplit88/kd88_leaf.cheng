# #88 minimal repro, leg 1: the leaf module declaring the struct that will be
# reached via two different import aliases (diamond import) from the entry
# file below -- this mirrors noderesource/protobuf.cheng in the real
# production trigger (src/libp2p/tests/node_resource_smoke.cheng).

type
    KSplit88Box =
        v: int32

fn kd88MakeBox(x: int32): KSplit88Box =
    KSplit88Box(v: x)
