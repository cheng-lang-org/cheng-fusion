# app_v0.cheng - pocket token V0 four-step flow, pure state machine.
#
# The 15-second acceptance (business plan section 3):
#   1. square screen shows the identity print;
#   2. function key or shake starts a short voice recording, waveform shown;
#   3. key release sends; the nearby phone opens the same item;
#   4. board vibrates once as delivery receipt.
#
# Anti-misfiring rules (plan section 16): touch confirm gates every send;
# shake must pass thresholds AND be in recording posture; when in doubt,
# do not send (hard failure is acceptable).
#
# This module is pure: events in, actions out. hal wiring lives elsewhere.

import "src/mosaico/events.cheng" as events

# ---- states -------------------------------------------------------------------
const StIdle: int32 = 1
const StRecording: int32 = 2
const StConfirming: int32 = 3
const StPublishing: int32 = 4
const StReceiptWait: int32 = 5

# ---- actions bitmask returned by Step ------------------------------------------
const ActNone: int32 = 0
const ActShowIdentityPrint: int32 = 1      # bit 0
const ActStartRecorder: int32 = 2          # bit 1
const ActStopRecorderKeep: int32 = 4       # bit 2 (hold for confirm gate)
const ActShowWaveform: int32 = 8           # bit 3
const ActSendToUniMaker: int32 = 16        # bit 4
const ActVibrateReceipt: int32 = 32        # bit 5
const ActLedSending: int32 = 64            # bit 6
const ActLedFailBlink: int32 = 128         # bit 7
const ActCancelRecording: int32 = 256      # bit 8

fn InitState(): int32 =
    return StIdle

# One transition per event kind.
# Returns packed: bits 0..15 action bitmask, bits 16..23 next state.
# Unknown event in a state returns no-op for that state (never crashes the
# loop; the event discipline keeps the machine total).
fn Step(state: int32, evKind: int32): int32 =
    var actions = ActNone
    var next = state

    if state == StIdle:
        if evKind == events.EvButtonDown:
            actions = ActStartRecorder | ActShowWaveform | ActLedSending
            next = StRecording
        if evKind == events.EvShake:
            # shake arms recording only from idle (recording posture check
            # belongs to the wire layer posture flag in P2)
            actions = ActStartRecorder | ActShowWaveform | ActLedSending
            next = StRecording
        if evKind == events.EvTimerTick:
            actions = ActShowIdentityPrint

    elif state == StRecording:
        if evKind == events.EvButtonUp:
            actions = ActStopRecorderKeep | ActShowIdentityPrint
            next = StConfirming
        if evKind == events.EvShake:
            # second shake cancels: hard-fail beats accidental send
            actions = ActCancelRecording | ActShowIdentityPrint
            next = StIdle

    elif state == StConfirming:
        if evKind == events.EvTouchTap:
            actions = ActSendToUniMaker | ActLedSending
            next = StPublishing
        if evKind == events.EvButtonUp:
            actions = ActCancelRecording | ActShowIdentityPrint
            next = StIdle
        if evKind == events.EvTimerTick:
            actions = ActShowIdentityPrint

    elif state == StPublishing:
        if evKind == events.EvBump:
            # a bump during publish is informational only in V0; never send
            # identity over the bump path
            actions = ActNone
        if evKind == events.EvBatteryLow:
            actions = ActLedFailBlink

    elif state == StReceiptWait:
        if evKind == events.EvTouchTap:
            # receipt arrives through the publish channel; tap only re-shows
            actions = ActShowIdentityPrint
            next = StIdle
        if evKind == events.EvSlotChanged:
            actions = ActShowIdentityPrint

    return (next << 16) | (actions & 0xFFFF)

fn ActionsOf(result: int32): int32 =
    return result & 0xFFFF

fn NextStateOf(result: int32): int32 =
    return (result >> 16) & 0xFF