# power.cheng - power rail sequencing and shutdown request policy.
#
# Facts from the Espressif hardware reference:
#   - VCC_3V3 / VCC_PW on GPIO60, ACTIVE LOW, with a soft-start ramp applied
#     by the BSP when enabling;
#   - CODEC_3V3 on GPIO56, high = on (own LDO HE9073A33);
#   - POWER_SWITCH on GPIO57: high-impedance while running, pulled low
#     (open-drain) to request shutdown of the SAM8108 supervisor;
#   - Type-C 5 V input charges the 65 mAh cell via TP4057 at 65 mA nominal;
#     >1 A output trips auto-cutoff. Runtime numbers are P5 business, not
#     code.

import "src/mosaico/board.cheng" as board

const RampSteps: int32 = 16              # soft-start ramp granularity
const RailSettleTicks: int32 = 20

# ---- system rail ------------------------------------------------------------------
# Pure scalar machine: Off -> Ramping(step..RampSteps) -> On.
# State packing: bits 0..3 phase (0 off, 1 ramping, 2 on),
#                bits 4..11 ramp step counter,
#                bits 12..19 settle countdown.

const PwrPhaseOff: int32 = 0
const PwrPhaseRamping: int32 = 1
const PwrPhaseOn: int32 = 2

fn RailInitState(): int32 =
    return 0

# One tick of the rail machine. Returns packed: bits 0..7 next state,
# bit 8 rail-good flag (fires once when entering On).
fn RailStep(state: int32): int32 =
    let phase = state & 3
    var step = (state >> 4) & 0xFF
    var settle = (state >> 12) & 0xFF
    var newPhase = phase
    var good = 0

    if phase == PwrPhaseOff:
        newPhase = PwrPhaseRamping
        step = 0
    elif phase == PwrPhaseRamping:
        var ns = step + 1
        step = ns
        if step >= RampSteps:
            newPhase = PwrPhaseOn
            settle = RailSettleTicks
    else:
        var nq = settle - 1
        if nq < 0:
            nq = 0
        settle = nq
        good = 1

    var ns2 = newPhase
    ns2 = ns2 | (step << 4)
    ns2 = ns2 | (settle << 12)
    return (ns2 << 8) | good

fn RailGoodOf(result: int32): int32 =
    return result & 1

fn RailStateOf(result: int32): int32 =
    return result >> 8

# GPIO60 is active low: level to apply for a given phase.
fn SystemRailLevelFor(phase: int32): int32 =
    if phase == PwrPhaseOff:
        return board.LevelHigh          # deasserted = high (active low)
    return board.LevelLow               # enabled = low

# ---- shutdown request -----------------------------------------------------------------
# POWER_SWITCH (GPIO57) is open-drain: driving LOW requests shutdown. The
# app layer may only request this after flushing pending publish state; the
# flag lives in the app state machine, not here.
fn ShutdownRequestLevel(): int32 =
    return board.LevelLow

fn ShutdownIdleLevel(): int32 =
    return board.LevelHigh              # high-impedance is emulated as idle-high by the shim