# bmm150x2.cheng - dual magnetometer pair (BMM150 #2 at 0x11, #3 at 0x12).
#
# The two onboard BMM150s are the bump sensor of the product: a board-to-board
# touch or a module snapping onto a slot shows up as a correlated field step
# on BOTH sensors within a few tens of milliseconds. Per the business plan
# (V0.5) a bump is only valid when both sensors agree inside a time window;
# sustained fields (metal surface, speaker magnet, bag rattle) must NOT fire.
#
# Register map and compensation constants: Bosch BMM150 datasheet
# (community-documented values), to be confirmed on hardware in P4/P2.

import "src/mosaico/frame.cheng" as frame
import "src/mosaico/board.cheng" as board

const RegChipId: int32 = 0x40
const ChipIdValue: int32 = 0x32          # BMM150 chip id (datasheet)
const RegPowerCtrl: int32 = 0x4B         # bit0 power on, bit1 soft reset
const RegOpMode: int32 = 0x4C            # opmode bits 1..2, ODR bits 4..5
const OpModeNormalOdr10: int32 = 0x01    # normal mode, 10 Hz (bits coded)

# mag data regs 0x42..0x48; X/Y are 13-bit signed, Z 15-bit signed, with
# always-1 LSBs that need masking per datasheet.
const RegMagDataStart: int32 = 0x42

# Build wake-up + normal-mode burst as [reg, value] pairs.
# Compiler-surface note: builders stage bytes in a local array with direct
# indexed stores, then copy once into the caller buffer. Chained helper calls
# that forward the caller buffer mis-lower on the current backend.
fn BuildInitSeq(buf: var uint8[frame.FrameCap], n: int32): int32 =
    var tmp: uint8[frame.FrameCap]
    var m = 0
    tmp[m] = uint8(RegPowerCtrl)
    m = m + 1
    tmp[m] = uint8(0x01)
    m = m + 1
    tmp[m] = uint8(RegOpMode)
    m = m + 1
    tmp[m] = uint8(OpModeNormalOdr10)
    m = m + 1
    var i = 0
    while i < m:
        let dst = n + i
        buf[dst] = tmp[i]
        i = i + 1
    return n + m

# Parse one raw X sample (13-bit signed) from the data burst at idx*2 offset
# relative to start; masks the forced LSB per datasheet. Input layout here:
# burst begins at RegMagDataStart with X_lsb, X_msb, Y_lsb, Y_msb, Z_lsb,
# Z_msb, RHALL pairs (byte pairs LE).
fn RawXFrom(buf: var uint8[frame.FrameCap], n: int32, base: int32): int32 =
    let raw = frame.FrameGet16Le(buf, n, base)
    if raw < 0:
        return -32768
    let v = raw >> 3
    var out = v
    if (v & 0x1000) != 0:
        out = v - 8192
    return out

fn RawYFrom(buf: var uint8[frame.FrameCap], n: int32, base: int32): int32 =
    let raw = frame.FrameGet16Le(buf, n, base + 2)
    if raw < 0:
        return -32768
    let v = raw >> 3
    var out = v
    if (v & 0x1000) != 0:
        out = v - 8192
    return out

fn RawZFrom(buf: var uint8[frame.FrameCap], n: int32, base: int32): int32 =
    let raw = frame.FrameGet16Le(buf, n, base + 4)
    if raw < 0:
        return -32768
    let v = raw >> 1
    var out = v
    if (v & 0x4000) != 0:
        out = v - 16384
    return out

# ---- bump detector ------------------------------------------------------------
# Pure scalar state machine driven once per paired sample burst (10 Hz ODR,
# so one step per 100 ms tick). Inputs are baseline-subtracted magnitudes in
# raw LSB for the left (0x11) and right (0x12) sensors.
#
# Fire policy (plan V0.5 / risk table):
#   - BOTH magnitudes must exceed BumpStepThreshold within BumpPairSamples
#     steps of each other;
#   - sustained fields never fire: a rising edge starts a candidate only when
#     both channels were quiet before, and a candidate expires after
#     BumpCandidateSteps without the partner arriving;
#   - after a fire, BumpQuietSteps samples must pass before re-arm.
#
# State packing:
#   bits 0..1   phase: 0 idle, 1 left-first candidate, 2 right-first candidate,
#               3 cooling
#   bits 4..9   candidate age counter
#   bits 10..17 quiet countdown

const BumpStepThreshold: int32 = 120       # raw LSB above baseline
const BumpPairSamples: int32 = 2           # partner must arrive within ~200 ms
const BumpQuietSamples: int32 = 30         # ~3 s re-arm at 10 Hz

fn BumpInitState(): int32 =
    return 0

# Returns bits: 0..7 next state, bit 8 fired-this-step flag.
fn BumpStep(state: int32, magL: int32, magR: int32): int32 =
    let phase = state & 3
    var age = (state >> 4) & 0x3F
    var quiet = (state >> 10) & 0xFF
    var fired = 0
    var newPhase = phase

    var lHot = 0
    if magL > BumpStepThreshold:
        lHot = 1
    var rHot = 0
    if magR > BumpStepThreshold:
        rHot = 1

    if phase == 0:
        if lHot == 1 && rHot == 1:
            fired = 1
            newPhase = 3
            quiet = BumpQuietSamples
        elif lHot == 1:
            newPhase = 1
            age = 0
        elif rHot == 1:
            newPhase = 2
            age = 0
    elif phase == 1:
        # left fired first; waiting for right partner
        if rHot == 1 && lHot == 1:
            fired = 1
            newPhase = 3
            quiet = BumpQuietSamples
        else:
            var na = age + 1
            age = na
            if age > BumpPairSamples:
                newPhase = 0
                age = 0
    elif phase == 2:
        if lHot == 1 && rHot == 1:
            fired = 1
            newPhase = 3
            quiet = BumpQuietSamples
        else:
            var na2 = age + 1
            age = na2
            if age > BumpPairSamples:
                newPhase = 0
                age = 0
    else:
        var nq = quiet - 1
        if nq < 0:
            nq = 0
        quiet = nq
        if quiet == 0:
            newPhase = 0

    var ns = newPhase
    ns = ns | (age << 4)
    ns = ns | (quiet << 10)
    return (ns << 8) | fired

fn BumpStateOf(result: int32): int32 =
    return result >> 8

fn BumpFiredOf(result: int32): int32 =
    return result & 1
