# publish.cheng - UniMaker event envelope framing and CRC32.
#
# Product rule (business plan section 9): the board only produces events.
# The envelope carries one event to the UniMaker edge agent
# (unimaker_edge_agent), which owns identity (AgentIdentity DID) and the
# capsule store. V0 therefore frames events, not social graphs.
#
# Layout (little-endian fields unless noted):
#   0..3   magic 'C','H','N','G'
#   4      envelope version (1)
#   5      event kind
#   6..9   device nonce (per boot, seeded by wire layer)
#   10..13 timestamp ms low word (uint32 wrap)
#   14..17 payload length (uint32; V0 keeps audio payloads out-of-band)
#   18..21 CRC32 over bytes [0..18), IEEE reflected (poly 0xEDB88320).
#
# CRC test vector: "123456789" -> 0xCBF43926.

import "src/mosaico/frame.cheng" as frame
import "src/mosaico/events.cheng" as events

const EnvelopeVersion: int32 = 1
const MagicC: int32 = 0x43
const MagicH: int32 = 0x48
const MagicN: int32 = 0x4E
const MagicG: int32 = 0x47

const EnvelopeBytes: int32 = 22
const CrcOffsetInEnvelope: int32 = 18
const CrcPoly: int32 = -306674912         # 0xEDB88320 as int32

# One CRC32 word update. Logical right shift is reconstructed from the
# arithmetic shift by clearing the sign-filled top bit.
fn Crc32Add(crc: int32, byteVal: int32): int32 =
    var acc = crc ^ (byteVal & 0xFF)
    var i = 0
    while i < 8:
        var mask = 0 - (acc & 1)
        let shifted = (acc >> 1) & 0x7FFFFFFF
        acc = shifted ^ (mask & CrcPoly)
        i = i + 1
    return acc

# ---- envelope builder ----------------------------------------------------------------
# Appends one complete event envelope. Staged-copy pattern (see bmm150x2
# note): bytes are staged in a local array, copied once, CRC computed over
# the local prefix, then patched into the copy destination. Returns new
# length or FrameErrOverflow.
fn BuildEnvelope(buf: var uint8[frame.FrameCap], n: int32, kind: int32, nonce: int32, tsLowMs: int32, payloadLen: int32): int32 =
    var tmp: uint8[32]
    var m = 0
    tmp[m] = uint8(MagicC)
    m = m + 1
    tmp[m] = uint8(MagicH)
    m = m + 1
    tmp[m] = uint8(MagicN)
    m = m + 1
    tmp[m] = uint8(MagicG)
    m = m + 1
    tmp[m] = uint8(EnvelopeVersion)
    m = m + 1
    tmp[m] = uint8(kind & 0xFF)
    m = m + 1
    tmp[m] = uint8(nonce & 0xFF)
    m = m + 1
    tmp[m] = uint8((nonce >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8((nonce >> 16) & 0xFF)
    m = m + 1
    tmp[m] = uint8((nonce >> 24) & 0xFF)
    m = m + 1
    tmp[m] = uint8(tsLowMs & 0xFF)
    m = m + 1
    tmp[m] = uint8((tsLowMs >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8((tsLowMs >> 16) & 0xFF)
    m = m + 1
    tmp[m] = uint8((tsLowMs >> 24) & 0xFF)
    m = m + 1
    tmp[m] = uint8(payloadLen & 0xFF)
    m = m + 1
    tmp[m] = uint8((payloadLen >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8(0)
    m = m + 1
    tmp[m] = uint8(0)
    m = m + 1
    tmp[m] = uint8(0)
    m = m + 1
    tmp[m] = uint8(0)
    m = m + 1
    # CRC over the 18 header bytes
    var crc = 0xFFFFFFFF
    var i = 0
    while i < CrcOffsetInEnvelope:
        crc = Crc32Add(crc, tmp[i])
        i = i + 1
    crc = crc ^ 0xFFFFFFFF
    let c0 = m
    tmp[c0] = uint8(crc & 0xFF)
    m = m + 1
    let c1 = m
    tmp[c1] = uint8((crc >> 8) & 0xFF)
    m = m + 1
    let c2 = m
    tmp[c2] = uint8((crc >> 16) & 0xFF)
    m = m + 1
    let c3 = m
    tmp[c3] = uint8((crc >> 24) & 0xFF)
    m = m + 1
    if n + m > frame.FrameCap:
        return frame.FrameErrOverflow
    var k = 0
    while k < m:
        let dst = n + k
        buf[dst] = tmp[k]
        k = k + 1
    return n + m