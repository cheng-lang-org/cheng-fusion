# frame.cheng - fixed-capacity byte frames for Mosaico board drivers.
#
# Design constraints (verified against the current cold-driver admission
# surface):
#   - caller-owned fixed-capacity buffers passed as `var uint8[FrameCap]`;
#   - the running length flows through RETURN values (`n = Put*(buf, n, ..)`),
#     because two sequential calls sharing a `var int32` length trip the
#     backend read-edge admission;
#   - negative return = error code; non-negative = new length;
#   - numeric world only.

const FrameCap: int32 = 64

const FrameOk: int32 = 0
const FrameErrOverflow: int32 = -1
const FrameErrRange: int32 = -2

# Append one raw byte; returns new length or FrameErrOverflow.
fn FramePut8(buf: var uint8[FrameCap], n: int32, v: uint8): int32 =
    if n >= FrameCap:
        return FrameErrOverflow
    let i0 = n
    buf[i0] = v
    return i0 + 1

# Little-endian u16 append; returns new length or FrameErrOverflow.
fn FramePut16Le(buf: var uint8[FrameCap], n: int32, v: int32): int32 =
    if n + 2 > FrameCap:
        return FrameErrOverflow
    let lo = v & 0xFF
    let hi = (v >> 8) & 0xFF
    let i0 = n
    let i1 = i0 + 1
    buf[i0] = uint8(lo)
    buf[i1] = uint8(hi)
    return i0 + 2

# Big-endian u16 append (TI BQ27220 registers, CO5300 window parameters).
fn FramePut16Be(buf: var uint8[FrameCap], n: int32, v: int32): int32 =
    if n + 2 > FrameCap:
        return FrameErrOverflow
    let lo = v & 0xFF
    let hi = (v >> 8) & 0xFF
    let i0 = n
    let i1 = i0 + 1
    buf[i0] = uint8(hi)
    buf[i1] = uint8(lo)
    return i0 + 2

fn FrameGet8(buf: var uint8[FrameCap], n: int32, idx: int32): int32 =
    if idx < 0 or idx >= n:
        return FrameErrRange
    return buf[idx]

# Read little-endian u16; FrameErrRange signals range error.
fn FrameGet16Le(buf: var uint8[FrameCap], n: int32, idx: int32): int32 =
    if idx < 0 or idx + 1 >= n:
        return FrameErrRange
    let lo = buf[idx]
    let hi = buf[idx + 1]
    return lo | (hi << 8)

# Read big-endian u16; FrameErrRange signals range error.
fn FrameGet16Be(buf: var uint8[FrameCap], n: int32, idx: int32): int32 =
    if idx < 0 or idx + 1 >= n:
        return FrameErrRange
    let hi = buf[idx]
    let lo = buf[idx + 1]
    return hi * 256 + lo

# Sign-extend an s16 value stored in u16 form.
fn S16FromU16(raw: int32): int32 =
    let sign = raw & 0x8000
    let mag = raw & 0x7FFF
    if sign != 0:
        return mag - 65536
    return mag

# Sign-extend an s12 value stored in the low bits.
fn S12FromRaw(raw: int32): int32 =
    let sign = raw & 0x800
    let mag = raw & 0x7FF
    if sign != 0:
        return mag - 4096
    return mag
