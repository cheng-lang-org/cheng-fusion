# hal.cheng - ESP-Mosaico hardware access contract.
#
# These declarations define the ONLY path from Cheng application code to the
# board. On esp32s31 they must be provided by the BSP shim layer (C side,
# ESP-IDF esp-mosaico BSP), matching the business-plan decision that V0
# peripheral drivers stay in the vendor BSP while Cheng owns events and the
# publish chain.
#
# The declarations carry no bodies: this module emits as a linkable object and
# resolves at final link. Host tests never link it - every device module above
# this boundary is pure computation over byte frames.
#
# All functions are thin, non-blocking except HalWaitEvent, which parks the
# core until any enabled interrupt source signals (GPIO2 SENSOR_INT, GPIO6
# TOUCH_INT, button edge, timer tick). The event discipline of this SDK is
# wait-and-drain, never poll.

@importc("cheng_hal_gpio_set")
fn HalGpioSet(pin: int32, level: int32)

@importc("cheng_hal_gpio_get")
fn HalGpioGet(pin: int32): int32

# One I2C master transaction: write tx bytes, then repeated-start read of rx
# bytes. Returns 0 on ACK-complete transfer, negative on bus error/NACK/
# timeout (codes defined by the BSP shim).
@importc("cheng_hal_i2c_write_read")
fn HalI2cWriteRead(port: int32, addr: int32, tx: ptr, txLen: int32, rx: ptr, rxLen: int32): int32

# Park until an event source fires or timeoutMs elapses; returns a bitmask of
# woken sources (bit0 sensor int, bit1 touch int, bit2 button, bit3 tick).
@importc("cheng_hal_wait_event")
fn HalWaitEvent(timeoutMs: int32): int32

@importc("cheng_hal_time_ms")
fn HalTimeMs(): int64

@importc("cheng_hal_abort")
fn HalAbort(code: int32)
