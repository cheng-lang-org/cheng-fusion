# bq27220.cheng - battery fuel gauge (BQ27220) register parsers.
#
# Bus facts from the Espressif hardware reference: I2C address 0x55. Register
# offsets and encodings follow the TI BQ27220 technical reference: values are
# big-endian 16-bit; temperature in units of 0.1 K; voltage in mV; current in
# mA signed; SOC in percent.

import "src/mosaico/frame.cheng" as frame

const RegTemperature: int32 = 0x06       # 0.1 K units
const RegVoltage: int32 = 0x08           # mV
const RegCurrent: int32 = 0x10           # mA signed
const RegStateOfCharge: int32 = 0x2C     # percent

# The wire layer reads one register as a 2-byte burst; each parser takes the
# two-byte frame. Read commands: write [reg], read 2 bytes.
fn BuildRegReadCmd(buf: var uint8[frame.FrameCap], n: int32, reg: int32): int32 =
    var len = frame.FramePut8(buf, n, uint8(reg))
    return len

# Temperature in tenths of kelvin.
fn TempTenthsKFrom(buf: var uint8[frame.FrameCap], n: int32): int32 =
    return frame.FrameGet16Be(buf, n, 0)

# Voltage in millivolts (0..4400 per cell spec); -1 on range error.
fn VoltageMvFrom(buf: var uint8[frame.FrameCap], n: int32): int32 =
    let v = frame.FrameGet16Be(buf, n, 0)
    if v < 0:
        return -1
    return v

# Current in milliamps signed (discharge negative).
fn CurrentMaFrom(buf: var uint8[frame.FrameCap], n: int32): int32 =
    let raw = frame.FrameGet16Be(buf, n, 0)
    if raw < 0:
        return -1
    return frame.S16FromU16(raw)

# State of charge clamped to 0..100.
fn SocPercentFrom(buf: var uint8[frame.FrameCap], n: int32): int32 =
    let soc = frame.FrameGet16Be(buf, n, 0)
    if soc < 0:
        return -1
    if soc > 100:
        return 100
    return soc

# Battery-low event threshold used by the app layer (plan P5 forbids any
# runtime claim until measured; this is an operational guard only).
const SocLowPercent: int32 = 10