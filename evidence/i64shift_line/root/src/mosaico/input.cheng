# input.cheng - button debounce and haptic/LED output policy.
#
# Function key GPIO7 is active low; the vibration motor GPIO8 is active high;
# the status LED GPIO3 is active low (all per the Espressif pin table).
# Edge detection is a pure function over an int state word so sequences are
# driven from a single call site (see frame.cheng header for the admission
# rules that shaped this design).

import "src/mosaico/board.cheng" as board

# ---- debounce ---------------------------------------------------------------
# State packing: bits 0..3 raw history shift register,
#                bits 4..7 stable level history,
#                upper bits reserved (zero).
const BtnHistMask: int32 = 0xF
const BtnStableShift: int32 = 4
const BtnStableOn: int32 = 0xF0

fn BtnInitState(): int32 =
    return 0

# One debounce step. pressedNow: 1 = key electrically down (GPIO low).
# Returns packed result: bits 0..2 event flags (bit0 stable-down level,
# bit1 down edge, bit2 up edge), bits 8..15 next state word.
# The key needs four identical consecutive raw samples to flip.
fn BtnStep(state: int32, pressedNow: int32): int32 =
    let hist = state & BtnHistMask
    let shifted = ((hist << 1) | (pressedNow & 1)) & BtnHistMask
    let stableBits = (state >> BtnStableShift) & BtnHistMask
    var newStableBits = stableBits
    if shifted == 0:
        newStableBits = 0
    if shifted == BtnHistMask:
        newStableBits = BtnHistMask
    var isDown = 0
    if newStableBits == BtnHistMask:
        isDown = 1
    var wasDown = 0
    if stableBits == BtnHistMask:
        wasDown = 1
    var edges = isDown
    var downEdge = 0
    var upEdge = 0
    if isDown - wasDown == 1:
        downEdge = 2
    if wasDown - isDown == 1:
        upEdge = 4
    let nextState = (newStableBits << BtnStableShift) | shifted
    return edges | downEdge | upEdge | (nextState << 8)

fn StepEdges(result: int32): int32 =
    return result & 0x7

fn StepNextState(result: int32): int32 =
    return (result >> 8) & 0xFFFF

# ---- outputs -----------------------------------------------------------------
fn LedLevelFor(on: int32): int32 =
    if on != 0:
        return board.LedOnLevel()
    return board.LedOffLevel()

fn MotorLevelFor(on: int32): int32 =
    if on != 0:
        return board.MotorOnLevel()
    return 0
