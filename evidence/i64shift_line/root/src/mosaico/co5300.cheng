# co5300.cheng - 480x480 QSPI AMOLED panel (CO5300) command builder.
#
# Panel facts from the Espressif hardware reference: QSPI interface on
# GPIO9/35/36/51 (data) + GPIO44 (SCL) + GPIO50 (CS) + GPIO42 (reset) +
# GPIO43 (TE tear-sync). The CO5300 belongs to the Samsung-style AMOLED
# command family; command bytes below follow that family convention and the
# community-documented CO5300 list, to be confirmed on hardware in P4.
#
# Builders produce COMMAND frames via the staged-copy pattern; pixel
# payloads are streamed by the wire layer in QSPI quad bursts.

import "src/mosaico/frame.cheng" as frame
import "src/mosaico/board.cheng" as board

const CmdSwReset: int32 = 0x01
const CmdSleepOut: int32 = 0x11
const CmdDisplayOn: int32 = 0x29
const CmdColumnAddr: int32 = 0x2A
const CmdRowAddr: int32 = 0x2B
const CmdWriteRam: int32 = 0x2C
const CmdTearingOn: int32 = 0x35
const CmdPixelFormat: int32 = 0x3A
const PixFmt16bpp: int32 = 0x55

const SleepOutWaitTicks: int32 = 12      # ~120 ms at a 100 Hz tick
const DisplayOnWaitTicks: int32 = 5

# Full wake sequence executed in order by the wire layer.
fn BuildWakeSeq(buf: var uint8[frame.FrameCap], n: int32): int32 =
    var tmp: uint8[frame.FrameCap]
    var m = 0
    tmp[m] = uint8(CmdSwReset)
    m = m + 1
    tmp[m] = uint8(CmdSleepOut)
    m = m + 1
    tmp[m] = uint8(CmdTearingOn)
    m = m + 1
    var i = 0
    while i < m:
        let dst = n + i
        buf[dst] = tmp[i]
        i = i + 1
    return n + m

fn BuildPixelFormatSeq(buf: var uint8[frame.FrameCap], n: int32): int32 =
    buf[n] = uint8(CmdPixelFormat)
    buf[n + 1] = uint8(PixFmt16bpp)
    return n + 2

# Window addressing: 0x2A with BE x0,x1 then 0x2B with BE y0,y1 (11 bytes).
fn BuildWindowSeq(buf: var uint8[frame.FrameCap], n: int32, x0: int32, y0: int32, x1: int32, y1: int32): int32 =
    var tmp: uint8[frame.FrameCap]
    var m = 0
    tmp[m] = uint8(CmdColumnAddr)
    m = m + 1
    tmp[m] = uint8((x0 >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8(x0 & 0xFF)
    m = m + 1
    tmp[m] = uint8((x1 >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8(x1 & 0xFF)
    m = m + 1
    tmp[m] = uint8(CmdRowAddr)
    m = m + 1
    tmp[m] = uint8((y0 >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8(y0 & 0xFF)
    m = m + 1
    tmp[m] = uint8((y1 >> 8) & 0xFF)
    m = m + 1
    tmp[m] = uint8(y1 & 0xFF)
    m = m + 1
    var i = 0
    while i < m:
        let dst = n + i
        buf[dst] = tmp[i]
        i = i + 1
    return n + m

# Write-RAM trigger for the wire layer after pixel stream setup.
fn BuildWriteRamCmd(buf: var uint8[frame.FrameCap], n: int32): int32 =
    buf[n] = uint8(CmdWriteRam)
    return n + 1

# ---- tile pattern ----------------------------------------------------------------
# The identity print renders as horizontal stripes of two RGB565 colors.
# One deterministic 16-pixel chunk (32 bytes big-endian) per call; the wire
# layer repeats chunks per scanline. Staged-copy pattern again.

const TileStripeRows: int32 = 8          # stripe height in pixel rows
const TileChunkPixels: int32 = 16

fn BuildTileChunk(buf: var uint8[frame.FrameCap], n: int32, row: int32, colorA: int32, colorB: int32): int32 =
    let stripeIdx = (row / TileStripeRows) % 2
    var color = colorB
    if stripeIdx == 0:
        color = colorA
    var tmp: uint8[32]
    var m = 0
    var i = 0
    while i < TileChunkPixels:
        let hi = (color >> 8) & 0xFF
        let lo = color & 0xFF
        let hIdx = m
        tmp[hIdx] = uint8(hi)
        m = m + 1
        let lIdx = m
        tmp[lIdx] = uint8(lo)
        m = m + 1
        i = i + 1
    var k = 0
    while k < m:
        let dst = n + k
        buf[dst] = tmp[k]
        k = k + 1
    return n + m