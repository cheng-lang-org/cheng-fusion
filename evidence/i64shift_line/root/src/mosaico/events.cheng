# events.cheng - event kinds and a bounded drop-oldest queue.
#
# Event discipline (business plan section 9 / AGENTS core rules): the board
# produces events, firmware waits and drains - it never polls sensors.
#
# The queue is a fixed int32 array of packed events. Packing keeps every
# helper in the verified compiler surface: one var-array param + length
# through return values.

import "src/mosaico/frame.cheng" as frame

# ---- event kinds ------------------------------------------------------------
const EvNone: int32 = 0
const EvButtonDown: int32 = 1
const EvButtonUp: int32 = 2
const EvShake: int32 = 3
const EvBump: int32 = 4
const EvTouchTap: int32 = 5
const EvTimerTick: int32 = 6
const EvBatteryLow: int32 = 7
const EvSlotChanged: int32 = 8

const EvCap: int32 = 32

# Pack kind + two small arguments into one slot word.
fn EvPack(kind: int32, arg0: int32, arg1: int32): int32 =
    return (kind & 0xFF) | ((arg0 & 0xFF) << 8) | ((arg1 & 0xFFFF) << 16)

fn EvKind(item: int32): int32 =
    return item & 0xFF

fn EvArg0(item: int32): int32 =
    return (item >> 8) & 0xFF

fn EvArg1(item: int32): int32 =
    return (item >> 16) & 0xFFFF

# Push packed item; when full, deterministically drops the OLDEST entry.
# Returns new count. Straight-line chaining only (see frame.cheng header).
fn EvPush(q: var int32[EvCap], count: int32, item: int32): int32 =
    if count < EvCap:
        q[count] = item
        return count + 1
    var i = 0
    while i < EvCap - 1:
        let j = i + 1
        q[i] = q[j]
        i = j
    q[EvCap - 1] = item
    return EvCap

# Peek item at index without removing; FrameErrRange when out of bounds.
fn EvPeek(q: var int32[EvCap], count: int32, idx: int32): int32 =
    if idx < 0 or idx >= count:
        return frame.FrameErrRange
    return q[idx]

# Drop the oldest entry by shifting left once; returns new count.
fn EvDropOldest(q: var int32[EvCap], count: int32): int32 =
    if count <= 0:
        return 0
    var i = 0
    while i < count - 1:
        let j = i + 1
        q[i] = q[j]
        i = j
    return count - 1
