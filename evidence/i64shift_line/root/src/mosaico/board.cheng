# board.cheng - ESP-Mosaico V1.0 board constants.
#
# Authoritative source: Espressif esp-dev-kits ESP32-S31 booklet,
# chapter 3 (ESP-Mosaico), tables "MCU and pin assignment" and
# "I2C device addresses" (Release master, 2026-08-21).
# Every constant below is traceable to that hardware reference.

# ---- shared I2C bus -------------------------------------------------------
const PinI2c0Sda: int32 = 0
const PinI2c0Scl: int32 = 1
const I2cPort0: int32 = 0

# 7-bit I2C addresses on the shared bus.
const AddrBmm150Left: int32 = 0x11
const AddrBmm150Right: int32 = 0x12
const AddrEs8311: int32 = 0x19
const AddrEepromSlotLeft: int32 = 0x50
const AddrEepromSlotRight: int32 = 0x51
const AddrBq27220: int32 = 0x55
const AddrCst9220: int32 = 0x5A
const AddrBmi270: int32 = 0x69

# ---- human interaction ----------------------------------------------------
const PinStatusLed: int32 = 3          # orange LED, active low
const PinAiButton: int32 = 7           # function key, active low
const PinVibrationMotor: int32 = 8     # motor, high = on
const PinSensorInt: int32 = 2          # IMU / magnetometer interrupt
const PinTouchInt: int32 = 6           # touch interrupt

# ---- CO5300 QSPI display ---------------------------------------------------
const PinLcdData0: int32 = 36
const PinLcdData1: int32 = 51
const PinLcdData2: int32 = 35
const PinLcdData3: int32 = 9
const PinLcdRst: int32 = 42
const PinLcdTe: int32 = 43
const PinLcdScl: int32 = 44
const PinLcdCs: int32 = 50
const LcdWidthPx: int32 = 480
const LcdHeightPx: int32 = 480

# ---- audio -----------------------------------------------------------------
const PinI2sBck: int32 = 37
const PinI2sDout: int32 = 40
const PinPaCtrl: int32 = 45            # NS4150B enable, high = on
const PinI2sWs: int32 = 49
const PinI2sDin: int32 = 52
const PinI2sMclk: int32 = 54
const PinCodecPower: int32 = 56        # CODEC_3V3, high = on

# ---- power ------------------------------------------------------------------
const PinPowerSwitch: int32 = 57       # shutdown request, open-drain low
const PinSystemRailCtrl: int32 = 60    # VCC_3V3 / VCC_PW, active low

# ---- SPI NAND ----------------------------------------------------------------
const PinNandClk: int32 = 20
const PinNandD: int32 = 21
const PinNandQ: int32 = 22
const PinNandCs: int32 = 23
const PinNandHold: int32 = 24
const PinNandWp: int32 = 25

# ---- module slots ------------------------------------------------------------
const PinSlotSelectLeft: int32 = 14    # EEPROM addr select, drive low = left
const PinSlotSelectRight: int32 = 39   # EEPROM addr select, drive high = right

# Slot select polarity per Espressif table:
# left EEPROM 0x50 selected by GPIO14 low;
# right EEPROM 0x51 selected by GPIO39 high; right slot is mounted rotated
# 180 degrees relative to the left slot.
const SlotLeft: int32 = 0
const SlotRight: int32 = 1

# ---- logic levels ------------------------------------------------------------
const LevelLow: int32 = 0
const LevelHigh: int32 = 1

fn LedOnLevel(): int32 =
    return LevelLow

fn LedOffLevel(): int32 =
    return LevelHigh

fn ButtonPressedLevel(): int32 =
    return LevelLow

fn MotorOnLevel(): int32 =
    return LevelHigh
