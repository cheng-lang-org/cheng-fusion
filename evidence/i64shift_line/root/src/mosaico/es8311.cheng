# es8311.cheng - audio codec (ES8311) init builder and power policy.
#
# Bus facts from the Espressif hardware reference: I2C address 0x19, I2S on
# GPIO37/40/49/52/54, codec rail CODEC_3V3 on GPIO56 (high = on), amplifier
# PA_CTRL on GPIO45 (high = on). Register writes follow the ES8311 datasheet
# register map (community-documented values); exact clock dividers must be
# re-verified against the MCLK actually wired in P4 bring-up.
#
# Builders use the staged-copy pattern: local array with direct indexed
# stores, then one copy loop into the caller buffer.

import "src/mosaico/frame.cheng" as frame
import "src/mosaico/board.cheng" as board

const RegReset: int32 = 0x01
const RegClkManager: int32 = 0x02
const RegAdcVol: int32 = 0x09
const RegDacVol: int32 = 0x0E
const RegSystem: int32 = 0x0D

fn BuildRecordInitSeq(buf: var uint8[frame.FrameCap], n: int32): int32 =
    var tmp: uint8[frame.FrameCap]
    var m = 0
    tmp[m] = uint8(RegReset)
    m = m + 1
    tmp[m] = uint8(0x80)
    m = m + 1
    tmp[m] = uint8(RegClkManager)
    m = m + 1
    tmp[m] = uint8(0x3F)
    m = m + 1
    tmp[m] = uint8(RegSystem)
    m = m + 1
    tmp[m] = uint8(0x10)
    m = m + 1
    tmp[m] = uint8(RegAdcVol)
    m = m + 1
    tmp[m] = uint8(0xBF)
    m = m + 1
    var i = 0
    while i < m:
        let dst = n + i
        buf[dst] = tmp[i]
        i = i + 1
    return n + m

fn BuildPlaybackInitSeq(buf: var uint8[frame.FrameCap], n: int32): int32 =
    var tmp: uint8[frame.FrameCap]
    var m = 0
    tmp[m] = uint8(RegReset)
    m = m + 1
    tmp[m] = uint8(0x80)
    m = m + 1
    tmp[m] = uint8(RegClkManager)
    m = m + 1
    tmp[m] = uint8(0x3F)
    m = m + 1
    tmp[m] = uint8(RegSystem)
    m = m + 1
    tmp[m] = uint8(0x0C)
    m = m + 1
    tmp[m] = uint8(RegDacVol)
    m = m + 1
    tmp[m] = uint8(0xDF)
    m = m + 1
    var i = 0
    while i < m:
        let dst = n + i
        buf[dst] = tmp[i]
        i = i + 1
    return n + m

fn BuildMuteSeq(buf: var uint8[frame.FrameCap], n: int32): int32 =
    var tmp: uint8[frame.FrameCap]
    var m = 0
    tmp[m] = uint8(RegAdcVol)
    m = m + 1
    tmp[m] = uint8(0x00)
    m = m + 1
    tmp[m] = uint8(RegDacVol)
    m = m + 1
    tmp[m] = uint8(0x00)
    m = m + 1
    var i = 0
    while i < m:
        let dst = n + i
        buf[dst] = tmp[i]
        i = i + 1
    return n + m

# ---- power sequencing policy -------------------------------------------------
# Order facts enforced by the app layer (plan section 5.3):
#   1. system rail VCC_3V3 (GPIO60) on first;
#   2. codec rail CODEC_3V3 (GPIO56) high;
#   3. wait RailSettleTicks;
#   4. I2C init burst;
#   5. PA (GPIO45) only after DAC path is up; PA off BEFORE codec rail down.
const RailSettleTicks: int32 = 20

const PwrIdle: int32 = 0
const PwrSysRailOn: int32 = 1
const PwrCodecRailOn: int32 = 2
const PwrCodecReady: int32 = 3
const PwrPaOn: int32 = 4

fn CodecRailLevelFor(stage: int32): int32 =
    if stage >= PwrCodecRailOn:
        return board.LevelHigh
    return board.LevelLow

fn PaLevelFor(stage: int32): int32 =
    if stage >= PwrPaOn:
        return board.LevelHigh
    return board.LevelLow