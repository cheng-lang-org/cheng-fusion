# slots.cheng - magnetic module slots: discovery plan and resource mutex.
#
# Facts from the Espressif hardware reference (mandatory, not advisory):
#   - left slot (H2) EEPROM at 0x50, selected by GPIO14 LOW;
#   - right slot (H1) EEPROM at 0x51 selected by GPIO39 HIGH;
#   - right slot pins GPIO49/52/54/37/40 are MULTIPLEXED with the codec I2S
#     bus: claiming them disables the onboard ES8311/speaker/mic path;
#   - a left DVP camera reuses GPIO14 and PAUSES left EEPROM discovery until
#     released.
# These mutual exclusions are enforced HERE in code, not in documentation.

import "src/mosaico/frame.cheng" as frame
import "src/mosaico/board.cheng" as board

const SlotLeft: int32 = 0
const SlotRight: int32 = 1

# Resource claim bits packed in one state word.
const ResCodecI2s: int32 = 1            # onboard audio path
const ResLeftEeprom: int32 = 2          # left slot discovery (GPIO14 owner)
const ResDvpCamera: int32 = 4           # left slot camera block
const ResRightAudioModule: int32 = 8    # right-slot module that needs I2S

# ---- discovery plan ----------------------------------------------------------------
# Discovery sequence per slot, executed by the wire layer:
#   1. drive select pin to the slot polarity,
#   2. I2C probe of the slot EEPROM address (write 1 byte, read 8 id bytes),
#   3. release select.
# The builder emits [selectPin, level, eepromAddr] triples for one slot scan.
fn BuildSlotScanPlan(buf: var uint8[frame.FrameCap], n: int32, slot: int32): int32 =
    var tmp: uint8[3]
    if slot == SlotLeft:
        tmp[0] = uint8(board.PinSlotSelectLeft)
        tmp[1] = uint8(board.LevelLow)
        tmp[2] = uint8(board.AddrEepromSlotLeft)
    else:
        tmp[0] = uint8(board.PinSlotSelectRight)
        tmp[1] = uint8(board.LevelHigh)
        tmp[2] = uint8(board.AddrEepromSlotRight)
    var i = 0
    while i < 3:
        let dst = n + i
        buf[dst] = tmp[i]
        i = i + 1
    return n + 3

# Module whitelist: V0 accepts identity/LED modules on the left; unknown ids
# and right-slot claims that would steal I2S are refused (plan section 5.4).
# Module ids are the first two EEPROM bytes.
const ModuleIdUnknown: int32 = 0
const ModuleIdIdentityTag: int32 = 257   # 0x0101
const ModuleIdLedBadge: int32 = 258      # 0x0102

fn ModuleAllowed(slot: int32, moduleId: int32): int32 =
    if moduleId == ModuleIdIdentityTag:
        return 1
    if moduleId == ModuleIdLedBadge:
        if slot == SlotLeft:
            return 1
    return 0

# ---- resource mutex ------------------------------------------------------------------
# Pure transitions over the claim word. Every function returns the new claim
# word or a negative error; callers must treat errors as hard failures.
# Bit clearing uses subtraction because unary ~ is not in the verified
# compiler surface.

const MutexOk: int32 = 0
const MutexErrConflict: int32 = -20

fn ClaimsInit(): int32 =
    return 0

fn ClaimCodecI2s(claims: int32): int32 =
    if (claims & ResRightAudioModule) != 0:
        return MutexErrConflict
    return claims | ResCodecI2s

fn ClaimRightAudioModule(claims: int32): int32 =
    var next = claims | ResRightAudioModule
    var held = next & ResCodecI2s
    next = next - held
    return next

fn ClaimDvpCamera(claims: int32): int32 =
    var next = claims | ResDvpCamera
    var held = next & ResLeftEeprom
    next = next - held
    return next

fn Release(claims: int32, resBit: int32): int32 =
    var held = claims & resBit
    return claims - held