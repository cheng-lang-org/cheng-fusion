# cst9220.cheng - touch controller (CST9220) parser and tap policy.
#
# Bus facts from the Espressif hardware reference: I2C address 0x5A on the
# shared bus, interrupt line GPIO6 (TOUCH_INT). The register/packet layout
# below follows the community-documented CST9220 burst format and MUST be
# confirmed against the panel datasheet during P4 bring-up; only the parse
# functions need to change if the layout differs.

import "src/mosaico/frame.cheng" as frame
import "src/mosaico/board.cheng" as board

const RegPacketStart: int32 = 0x00

# Packet layout used by this parser (burst read of 8 bytes):
#   byte0: contact point count (0..2 supported)
#   byte1: event id per point 0 (community format)
#   byte2/3: x low/high bits (12-bit)
#   byte4/5: y low/high bits (12-bit)
#   byte6..7: reserved

fn ContactsFrom(buf: var uint8[frame.FrameCap], n: int32): int32 =
    let c = frame.FrameGet8(buf, n, 0)
    if c < 0:
        return 0
    if c > 2:
        return 2
    return c

fn EventIdFrom(buf: var uint8[frame.FrameCap], n: int32): int32 =
    return frame.FrameGet8(buf, n, 1)

fn XFrom(buf: var uint8[frame.FrameCap], n: int32): int32 =
    let lo = frame.FrameGet8(buf, n, 2)
    let hi = frame.FrameGet8(buf, n, 3)
    if lo < 0 or hi < 0:
        return -1
    return ((hi & 0x0F) << 8) | lo

fn YFrom(buf: var uint8[frame.FrameCap], n: int32): int32 =
    let lo = frame.FrameGet8(buf, n, 4)
    let hi = frame.FrameGet8(buf, n, 5)
    if lo < 0 or hi < 0:
        return -1
    return ((hi & 0x0F) << 8) | lo

# ---- tap policy -----------------------------------------------------------------
# A tap is decided from explicit facts captured by the application when the
# touch interrupt delivers a down and later an up: hold length in feed ticks
# and pixel travel. Keeping the decision pure avoids hidden per-device state
# and matches the plan rule that touch confirms intent (anti-misfiring gate).

const TapMaxTicks: int32 = 40             # ~400 ms at a 100 Hz feed
const TapMaxMovePx: int32 = 48

fn AbsDiff(a: int32, b: int32): int32 =
    if a > b:
        return a - b
    return b - a

# Returns 1 when down->up qualifies as a deliberate tap.
fn IsTap(downX: int32, downY: int32, upX: int32, upY: int32, holdTicks: int32): int32 =
    if holdTicks < 0:
        return 0
    if holdTicks > TapMaxTicks:
        return 0
    if AbsDiff(downX, upX) > TapMaxMovePx:
        return 0
    if AbsDiff(downY, upY) > TapMaxMovePx:
        return 0
    return 1