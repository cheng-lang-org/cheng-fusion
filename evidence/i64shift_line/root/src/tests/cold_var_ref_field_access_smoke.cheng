type
    ColdVarRefFieldState = ref object
        value: int32
        released: bool

fn coldVarRefFieldInit(state: var ColdVarRefFieldState): bool =
    state = new(ColdVarRefFieldState)
    state.value = 41
    state.released = false
    return state.value == 41 && !state.released

fn main(): int32 =
    var state: ColdVarRefFieldState
    if !coldVarRefFieldInit(state):
        return 1
    if state == nil:
        return 2
    if state.value != 41 || state.released:
        return 3
    return 0
