const
    ColdDynamicIndexAlphabet: str =
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn coldDynamicIndexChar(packed: int32): int32 =
    return int32(ColdDynamicIndexAlphabet[(packed >> 18) & 63])

fn main() =
    let actual = coldDynamicIndexChar(2 << 18)
    if actual == int32('C'):
        echo("cold_const_dynamic_index=pass")
    else:
        echo("cold_const_dynamic_index=fail")
