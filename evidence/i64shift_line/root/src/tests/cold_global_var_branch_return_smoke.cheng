type
    ColdGlobalVarBranchCell =
        handle: uint64

var coldGlobalVarBranchCell: ColdGlobalVarBranchCell
var coldGlobalVarBranchLive: int32

fn coldGlobalVarBranchBegin(
        output: var ColdGlobalVarBranchCell): bool =
    output.handle = uint64(17)
    return true

fn coldGlobalVarBranchActivate(
        output: var ColdGlobalVarBranchCell): bool =
    output.handle = uint64(23)
    return true

fn main(): int32 =
    if !coldGlobalVarBranchBegin(coldGlobalVarBranchCell):
        return 11
    if coldGlobalVarBranchCell.handle != uint64(0):
        coldGlobalVarBranchLive = 1
    if coldGlobalVarBranchLive == 1:
        if !coldGlobalVarBranchActivate(coldGlobalVarBranchCell):
            return 12
    if coldGlobalVarBranchCell.handle != uint64(23):
        return 13
    return 0
