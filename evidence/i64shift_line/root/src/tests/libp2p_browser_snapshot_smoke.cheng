import std/system
import std/strings
import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_paint_runtime as paint
import cheng/apps/libp2p_browser/compile_render as compile
import cheng/apps/libp2p_browser/page_snapshot as snap
import cheng/apps/libp2p_browser/snapshot_script as snapscript
import cheng/apps/libp2p_browser/session as sess

fn fail(code: int32, msg: str): int32 =
    echo(msg)
    return code

@borrows
fn scriptHas(script: str, needle: str): bool =
    var i: int32 = 0
    while i + needle.len <= script.len:
        var ok = true
        var j: int32 = 0
        while j < needle.len:
            if script[i + j] != needle[j]:
                ok = false
                j = needle.len
            else:
                j = j + 1
        if ok:
            return true
        i = i + 1
    return false

fn main(): int32 =
    let cap = snapscript.BrowserSnapshotCaptureScript()
    if cap.len < 20:
        return fail(40, "capture script")
    if !scriptHas(cap, "CLB4"):
        return fail(41, "capture script clb4 magic")
    if !scriptHas(cap, "__chengCtlById"):
        return fail(51, "capture script ctl registry lookup")
    if !scriptHas(cap, "ctlNameOf"):
        return fail(52, "capture script name chain")
    if !scriptHas(cap, "ctlFlagsOf"):
        return fail(53, "capture script ctl flags")
    var hasWhen = false
    var ci: int32 = 0
    while ci + 9 <= cap.len:
        if cap[ci] == 'w' && cap[ci + 1] == 'h' && cap[ci + 2] == 'e' && cap[ci + 3] == 'n' && cap[ci + 4] == 'C' && cap[ci + 5] == 'l' && cap[ci + 6] == 'e' && cap[ci + 7] == 'a' && cap[ci + 8] == 'r':
            hasWhen = true
        ci = ci + 1
    if hasWhen:
        return fail(42, "capture script must not wait on whenClear")
    var hasLive = false
    ci = 0
    while ci + 7 <= cap.len:
        if cap[ci] == 'a' && cap[ci + 1] == 'r' && cap[ci + 2] == 'm' && cap[ci + 3] == 'L' && cap[ci + 4] == 'i' && cap[ci + 5] == 'v' && cap[ci + 6] == 'e':
            hasLive = true
        ci = ci + 1
    if !hasLive:
        return fail(43, "capture script must arm live recapture")
    let src = "CLB2\n400 600 3 7\n1 10 20 120 32 -1 -16777216 14 1 -16777216 2\ninput\n\ntext\nq\nx\n\n0 10 60 40 16 0 -16777216 16 0 0 0\n#text\n\n\n\n\nhi\n3 10 90 40 20 0 -16776978 14 0 0 0\na\n/go\n\n\n\n\n"
    var document: web.WebDocument
    var bundle: compile.BrowserCompileBundle
    if !snap.BrowserCompileSnapshot(src, document, bundle):
        echo(bundle.err)
        return fail(1, "compile snapshot")
    if bundle.stats.nodeCount != 3:
        echo(strings.IntToStr(bundle.stats.nodeCount))
        return fail(2, "box count")
    if bundle.stats.layoutMs != int64(7):
        echo(strings.int64ToStr(bundle.stats.layoutMs))
        return fail(3, "capture ms")
    if bundle.stats.viewportW != 400 || bundle.stats.viewportH != 600:
        return fail(4, "viewport")
    if bundle.stats.inputCount != 1 || bundle.stats.widgetCount != 2:
        echo(strings.IntToStr(bundle.stats.inputCount))
        echo(strings.IntToStr(bundle.stats.widgetCount))
        return fail(5, "widgets")
    var hasHi = false
    var oi: int32 = 0
    while oi < bundle.ops.len:
        if bundle.ops[oi].kind == paint.PaintOpKindFillText:
            if bundle.ops[oi].text.text == "hi":
                if bundle.ops[oi].rect.x != 10 || bundle.ops[oi].rect.y != 60:
                    return fail(6, "text box")
                hasHi = true
        oi = oi + 1
    if !hasHi:
        return fail(7, "text op")
    var inputIdx: int32 = -1
    var linkIdx: int32 = -1
    var wi: int32 = 0
    while wi < bundle.widgets.len:
        if bundle.widgets[wi].kind == compile.BrowserWidgetInput && bundle.widgets[wi].fieldId == "q":
            if bundle.widgets[wi].value != "x":
                echo(bundle.widgets[wi].value)
                return fail(8, "input value")
            if bundle.widgets[wi].x != 10 || bundle.widgets[wi].y != 20:
                return fail(9, "input rect")
            if bundle.widgets[wi].nodeId <= 0:
                return fail(10, "input node")
            inputIdx = wi
        if bundle.widgets[wi].kind == compile.BrowserWidgetAnchor && bundle.widgets[wi].href == "/go":
            linkIdx = wi
        wi = wi + 1
    if inputIdx < 0 || linkIdx < 0:
        return fail(11, "widget idx")
    let hit = compile.BrowserHitWidget(bundle.widgets, 11, 21)
    if hit != inputIdx:
        return fail(12, "hit input")
    var badDoc: web.WebDocument
    var badBundle: compile.BrowserCompileBundle
    if snap.BrowserCompileSnapshot("not-clb2", badDoc, badBundle):
        return fail(13, "bad magic must fail")
    if badBundle.err.len <= 0:
        return fail(14, "bad magic error")
    var session = sess.BrowserSessionInit("snap-peer", 320, 480)
    if !sess.BrowserSessionOnPageSnapshot(session, "https://ex.test/home", src):
        echo(session.lastError)
        return fail(15, "session snapshot")
    if !session.rightOpen || session.inputCount != 1:
        return fail(16, "session right")
    if session.viewportW != 400 || session.viewportH != 600:
        return fail(17, "session viewport")
    if session.widgets[inputIdx].x != 10:
        return fail(18, "session widget x")
    let ix = session.widgets[inputIdx].x + 1
    let iy = session.widgets[inputIdx].y + 1
    if sess.BrowserSessionClick(session, ix, iy) != 1:
        return fail(21, "focus input")
    if !sess.BrowserSessionRefreshSnapshot(session, "https://ex.test/home", src):
        echo(session.lastError)
        return fail(22, "refresh snapshot")
    var focusedQ = false
    var ri: int32 = 0
    while ri < session.widgets.len:
        if session.widgets[ri].fieldId == "q" && session.widgets[ri].nodeId == session.focusedNodeId:
            focusedQ = true
        ri = ri + 1
    if !focusedQ:
        return fail(23, "refresh keeps focus")
    let src3 = "CLB3\n400 600 1 2\n0 10 20 80 18 -1 -16777216 16 0 0 0 700 0 4 8 0 -16777216 0 0 400 600\n#text\n\n\n\n\nhi\nsans-serif\n\n\n"
    var d3: web.WebDocument
    var b3: compile.BrowserCompileBundle
    if !snap.BrowserCompileSnapshot(src3, d3, b3):
        echo(b3.err)
        return fail(24, "clb3 compile")
    var hasBold = false
    var hasShadow = false
    var oi3: int32 = 0
    while oi3 < b3.ops.len:
        if b3.ops[oi3].kind == paint.PaintOpKindFillText:
            if b3.ops[oi3].text.text != "hi":
                return fail(25, "clb3 text")
            if b3.ops[oi3].text.fontWeight != 700:
                echo(strings.IntToStr(b3.ops[oi3].text.fontWeight))
                return fail(26, "clb3 weight")
            if b3.ops[oi3].shadowText != "sans-serif":
                echo(b3.ops[oi3].shadowText)
                return fail(27, "clb3 family")
            hasBold = true
        if b3.ops[oi3].kind == paint.PaintOpKindBoxShadow:
            hasShadow = true
        oi3 = oi3 + 1
    if !hasBold || !hasShadow:
        return fail(28, "clb3 ops")
    # CLB4: CTL 控件语义行 + name 百分号解码 + patch 路径语义保持 + 越界 hard-fail。
    var src4 = "CLB4\n400 600 1 2\n4 10 20 120 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nbutton\nbtnOk\nGo\nGo\nsans-serif\n\n\nCTL|0|7|1|button|Go%7CBack\n"
    var d4: web.WebDocument
    var b4: compile.BrowserCompileBundle
    if !snap.BrowserCompileSnapshot(src4, d4, b4):
        echo(b4.err)
        return fail(54, "clb4 compile")
    if b4.widgets.len != 1:
        return fail(55, "clb4 widget count")
    if b4.widgets[0].ctlId != 7 || b4.widgets[0].ctlFlags != 1:
        return fail(56, "clb4 ctl id/flags")
    if b4.widgets[0].ctlRole != "button" || b4.widgets[0].ctlName != "Go|Back":
        echo(b4.widgets[0].ctlName)
        return fail(57, "clb4 ctl role/name")
    var ctlSess = sess.BrowserSessionInit("ctl-peer", 400, 600)
    if !sess.BrowserSessionOnPageSnapshot(ctlSess, "https://ex.test/ctl", src4):
        echo(ctlSess.lastError)
        return fail(58, "clb4 session")
    var src4b = "CLB4\n400 600 1 2\n4 10 20 120 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nbutton\nbtnOk\nSent\nSent\nsans-serif\n\n\nCTL|0|7|0|button|Go\n"
    if !sess.BrowserSessionRefreshSnapshot(ctlSess, "https://ex.test/ctl", src4b):
        echo(ctlSess.lastError)
        return fail(59, "clb4 patch")
    if ctlSess.widgets.len != 1 || ctlSess.widgets[0].ctlId != 7:
        return fail(60, "clb4 patch keeps ctl")
    if ctlSess.widgets[0].ctlFlags != 0 || ctlSess.widgets[0].ctlName != "Go":
        return fail(61, "clb4 patch ctl refresh")
    var bad4 = "CLB4\n400 600 1 2\n4 10 20 120 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nbutton\nbtnOk\nGo\nGo\nsans-serif\n\n\nCTL|9|7|0|button|Go\n"
    var badDoc4: web.WebDocument
    var badBundle4: compile.BrowserCompileBundle
    if snap.BrowserCompileSnapshot(bad4, badDoc4, badBundle4):
        return fail(62, "ctl out-of-range must fail")
    var badId4 = "CLB4\n400 600 1 2\n4 10 20 120 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nbutton\nbtnOk\nGo\nGo\nsans-serif\n\n\nCTL|0|0|0|button|Go\n"
    var badDoc5: web.WebDocument
    var badBundle5: compile.BrowserCompileBundle
    if snap.BrowserCompileSnapshot(badId4, badDoc5, badBundle5):
        return fail(63, "ctl zero id must fail")
    let srcSel = "CLB3\n400 600 1 1\n6 10 20 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect\nview\n\n\n\n\n0\ta\tAlpha%0A0\tb\tBeta\n"
    var selSess = sess.BrowserSessionInit("sel-peer", 400, 600)
    if !sess.BrowserSessionOnPageSnapshot(selSess, "https://ex.test/sel", srcSel):
        echo(selSess.lastError)
        return fail(29, "select snapshot")
    var hasSel = false
    var sidx: int32 = 0
    while sidx < selSess.widgets.len:
        if selSess.widgets[sidx].kind == compile.BrowserWidgetSelect:
            hasSel = true
        sidx = sidx + 1
    if !hasSel:
        return fail(30, "select widget")
    var hasFace = false
    var oiS: int32 = 0
    while oiS < selSess.ops.len:
        if selSess.ops[oiS].kind == paint.PaintOpKindFillText:
            if selSess.ops[oiS].text.text == "Alpha":
                hasFace = true
        oiS = oiS + 1
    if !hasFace:
        return fail(33, "select face is option label")
    if sess.BrowserSessionClick(selSess, 11, 21) != 5:
        return fail(31, "open select")
    if sess.BrowserSessionClick(selSess, 20, 20 + 32 + 8) != 5:
        return fail(32, "pick option")
    if !selSess.applyReady || selSess.applyValue != "a":
        return fail(35, "apply value")
    var hasOv = false
    var oiO: int32 = 0
    while oiO < selSess.overlayOps.len:
        if selSess.overlayOps[oiO].kind == paint.PaintOpKindFillText:
            if selSess.overlayOps[oiO].text.text == "Alpha":
                hasOv = true
        oiO = oiO + 1
    if !hasOv:
        return fail(34, "picked option paints label")
    var empty = sess.BrowserSessionInit("empty-peer", 320, 480)
    if sess.BrowserSessionOnPageSnapshot(empty, "https://ex.test/empty", ""):
        return fail(19, "empty snapshot must fail")
    if empty.rightOpen:
        return fail(20, "empty must not open right")
    echo("libp2p_browser_snapshot_smoke ok")
    return 0
