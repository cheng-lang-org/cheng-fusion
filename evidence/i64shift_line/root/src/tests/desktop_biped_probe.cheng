# Desktop-biped probe: headless standing run of the frozen desktopbiped
# scene (producer.CsgProducerBuildDesktopBipedScene — the 3.5 kg /
# 0.34 m point-mass biped carrier for the desktop-biped balance
# milestone). Protocol: materialize -> execution init -> push 14300
# ticks. The scene has an empty action table, so the balance v1 servo
# arms through the free-walk gate (verified: balance_on printed); the
# six foot-plate stations hold 0..690 and release, then the free
# stander rides the servo alone. Capture stepping is disarmed via the
# official per-state surface (ball-probe caseA form): its 0.15 m
# capture step length is tuned for the 1.4 m climb figure — on a
# 0.34 m biped it is an unphysical lunge, not balance.
# Contract: zero rejected physics steps, standing survival (head z >
# pelvis z at every tick, violations reported as-is), both foot plates
# grounded at the final tick (all six plate points z < 0.03).
# Metrics are buffered at 100-tick granularity and printed after the
# loop (no str work inside the physics loop).
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/world3d
import cheng/game/physics3d
import std/strings as strings
import std/math as m

const
    ProbeTotalTicks = 14300
    ProbeRecordEvery = 100
    ProbePrintEvery = 1000
    ProbePelvis = 0
    ProbeHead = 2
    ProbePlateStart = 11
    ProbePlateCount = 6
    ProbePlatePassZM = 0.030

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

fn reportRow(t: int32, torsoDz: float64, minPlateZ: float64) =
    echo("biped t=" + strings.IntToStr(t)
        + " head_minus_pelvis_mm=" + fmtMm(torsoDz * 1000.0)
        + " min_plate_z_mm=" + fmtMm(minPlateZ * 1000.0))

fn main(): int32 =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildDesktopBipedScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL desktop biped facts validation status=" + strings.IntToStr(verdict.statusCode)
            + " detail=" + strings.IntToStr(verdict.detailIndex))
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL desktop biped materialize err=" + err)
        return 1
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    # disarm capture stepping, keep the frozen servo gains/damping
    execution.CsgBalanceSetParams(st,
        execution.CsgBalanceGain,
        execution.CsgBalanceDamp,
        execution.CsgBalanceCorrCapMps,
        100.0,
        execution.CsgCaptureStepLenM,
        2.0, 30.0, 270.0)
    let pelvisSlot: int32 = mp.partSlot[ProbePelvis]
    let headSlot: int32 = mp.partSlot[ProbeHead]
    echo("desktop biped parts=" + strings.IntToStr(facts.partKind.len)
        + " joints=" + strings.IntToStr(facts.jointA.len)
        + " steps=" + strings.IntToStr(facts.stepPart.len)
        + " total_ticks=" + strings.Int64ToStr(facts.totalTicks)
        + " balance_on=" + strings.IntToStr(st.balOn)
        + " release_tick=" + strings.IntToStr(int32(producer.CsgDesktopBipedAnchorEndTick)))
    # buffered trace (100-tick granularity, printed after the loop)
    var recTick: int32[]
    var recTorsoDz: float64[]
    var recMinPlateZ: float64[]
    var rejected: int32 = 0
    var toppleTicks: int32 = 0
    var firstToppleTick: int32 = -1
    let pelvisZ0: float64 = st.w.bodyPz[pelvisSlot]
    var tick: int32 = 0
    while tick < ProbeTotalTicks:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            rejected = rejected + 1
        if st.w.bodyPz[headSlot] <= st.w.bodyPz[pelvisSlot]:
            toppleTicks = toppleTicks + 1
            if firstToppleTick < 0:
                firstToppleTick = tick
        if tick % ProbeRecordEvery == 0:
            let firstPlateZ: float64 = st.w.bodyPz[mp.partSlot[ProbePlateStart]]
            var minPlateZ: float64 = firstPlateZ
            var pi: int32 = 1
            while pi < ProbePlateCount:
                let pz: float64 = st.w.bodyPz[mp.partSlot[ProbePlateStart + pi]]
                if pz < minPlateZ:
                    minPlateZ = pz
                pi = pi + 1
            add(recTick, tick)
            add(recTorsoDz, st.w.bodyPz[headSlot] - st.w.bodyPz[pelvisSlot])
            add(recMinPlateZ, minPlateZ)
        tick = tick + 1
    # buffered trace out (physics loop is done)
    var k: int32 = 0
    while k < recTick.len:
        if recTick[k] % ProbePrintEvery == 0 || k == recTick.len - 1:
            reportRow(recTick[k], recTorsoDz[k], recMinPlateZ[k])
        k = k + 1
    # final per-plate heights: the two planted soles
    var p: int32 = 0
    var plateFail: int32 = 0
    while p < ProbePlateCount:
        let slot: int32 = mp.partSlot[ProbePlateStart + p]
        echo("plate p" + strings.IntToStr(ProbePlateStart + p)
            + " final_z_mm=" + fmtMm(st.w.bodyPz[slot] * 1000.0))
        if !(st.w.bodyPz[slot] < ProbePlatePassZM):
            plateFail = plateFail + 1
        p = p + 1
    let keptTicks: int32 = ProbeTotalTicks - toppleTicks
    let keptPerMille: int32 = keptTicks * 1000 / ProbeTotalTicks
    let pelvisDropMm: float64 = pelvisZ0 - st.w.bodyPz[pelvisSlot]
    echo("desktop biped rejected=" + strings.IntToStr(rejected)
        + " topple_ticks=" + strings.IntToStr(toppleTicks)
        + " first_topple_tick=" + strings.IntToStr(firstToppleTick)
        + " upright_permille=" + strings.IntToStr(keptPerMille)
        + " pelvis_z0_mm=" + fmtMm(pelvisZ0 * 1000.0)
        + " pelvis_drop_mm=" + fmtMm(pelvisDropMm)
        + " plate_fail=" + strings.IntToStr(plateFail))
    if rejected != 0:
        echo("FAIL desktop biped physics rejections")
        return 1
    if toppleTicks != 0:
        echo("FAIL desktop biped figure toppled (head z <= pelvis z) for "
            + strings.IntToStr(toppleTicks) + " ticks, first at "
            + strings.IntToStr(firstToppleTick))
        return 1
    if plateFail != 0:
        echo("FAIL desktop biped foot plate not grounded")
        return 1
    echo("PASS desktop biped probe")
    return 0
