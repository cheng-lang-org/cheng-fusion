import std/os
import std/rawbytes

const
    ParticipantMapStaging: str = "staging"
    ParticipantMapFinal: str =
        "93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab93ab"
    ParticipantMapRelative: str = "participant.bin"

fn main(): int32 =
    let parent = os.GetEnv("CHENG_PARTICIPANT_MAP_PARENT")
    if parent.len == 0:
        return 31
    let begun = os.AtomicTreeBegin(
        parent, ParticipantMapStaging, ParticipantMapFinal)
    if IsErr(begun):
        echo(Error(begun))
        return 32
    let tree = Value(begun)
    let bytes = rawbytes.BytesFromString("participant-map-payload")
    if IsErr(os.AtomicTreeWriteExclusiveSync(
           tree, ParticipantMapRelative, bytes)):
        return 33
    if IsErr(os.AtomicTreeSealReadOnly(tree, ParticipantMapRelative)):
        return 34
    if IsErr(os.AtomicTreeVerifyExact(
           tree, [], [ParticipantMapRelative])):
        return 35
    if IsErr(os.AtomicTreeCommitNoReplace(tree)):
        return 36
    if IsErr(os.AtomicTreeClose(tree)):
        return 37
    return 0
