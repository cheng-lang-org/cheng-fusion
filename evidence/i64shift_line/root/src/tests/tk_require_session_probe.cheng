module tk_require_session_probe

import std/system

type Session = ref object
    released: bool
    closed: bool
    count: int32

type Index = ref object
    released: bool

type Ir =
    typedExprMetadataSession: Session
    buildIndex: Index
    flag: int32

@borrows
@borrow_result
fn Require(ir: Ir, operation: str): Session =
    let session = ir.typedExprMetadataSession
    if session == nil:
        panic(Fmt"missing {operation}")
    if session.released:
        panic(Fmt"released {operation}")
    if session.closed:
        panic(Fmt"closed {operation}")
    if ir.buildIndex.released:
        panic(Fmt"index released {operation}")
    return session

fn main(): int32 =
    var x: Ir
    x.flag = 1
    x.buildIndex = new(Index)
    let s = Require(x, "test")
    return s.count

main()
