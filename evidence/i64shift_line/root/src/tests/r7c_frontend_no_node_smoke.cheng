# K3-R7C frontend no_node residue fixture:
# - module-local void callee bare_call (appendMark)
# - qualified call in condition (strutil.Contains)
# - constructor call resolvable return type (Pair())
# - return-of-call with uint32 return (u32FromBytes)
# - non-subscript seq .len as scalar (args.len)
# - let-binding type inheritance from RHS node (bool compare, field arith)
# - indexed-root field path in conditions (ps[i].a)

import std/strutils as strutil

type
    Pair =
        a: int32
        b: int32

fn u32FromBytes(b0: int32, b1: int32): uint32 =
    return uint32(b0 * 256 + b1)

fn readU32(): uint32 =
    return u32FromBytes(1, 2)

fn appendMark(out: var str, mark: str) =
    out = mark

fn lenScalar(args: str[]): int32 =
    let n = args.len
    if args.len > 1:
        return n + 1
    return n

fn boolBindingCond(i: int32, n: int32): int32 =
    let atEnd = i >= n
    if !atEnd:
        return 1
    return 2

fn fieldArithBinding(p: Pair, lines: str[]): int32 =
    let lineIndex = p.a - 1
    if lineIndex < 0 || lineIndex >= lines.len:
        return 1
    return 0

fn idxFieldCond(ps: Pair[], i: int32): int32 =
    if ps[i].a != 0:
        return ps[i].b
    return -1

fn ctorRoundTrip(): int32 =
    var p = Pair()
    p.a = 3
    p = Pair()
    return p.a

fn qualifiedCallCond(s: str): int32 =
    if strutil.Contains(s, "x"):
        return 1
    return 0

fn main(): int32 =
    var args: str[]
    args = []
    add(args, "a")
    add(args, "b")
    if lenScalar(args) != 3:
        return 1
    if boolBindingCond(0, 3) != 1:
        return 2
    if boolBindingCond(5, 3) != 2:
        return 3
    var p: Pair
    p.a = 1
    p.b = 9
    if fieldArithBinding(p, args) != 0:
        return 4
    p.a = 9
    if fieldArithBinding(p, args) != 1:
        return 5
    var ps: Pair[]
    ps = []
    add(ps, p)
    if idxFieldCond(ps, 0) != 9:
        return 6
    if ctorRoundTrip() != 0:
        return 7
    if readU32() != uint32(258):
        return 8
    if qualifiedCallCond("axe") != 1:
        return 9
    if qualifiedCallCond("bee") != 0:
        return 10
    var buf = ""
    appendMark(buf, "done")
    if buf != "done":
        return 11
    return 0
