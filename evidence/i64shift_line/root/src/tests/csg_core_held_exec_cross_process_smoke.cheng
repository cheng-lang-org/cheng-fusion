# csg_core_held_exec_cross_process_smoke.cheng - cross-process held-exec smoke.
#
# BLOCKED-ON domain G: the real cross-process spawn surface this smoke was
# written against (CsgCoreProductionHeldExecLinuxSpawnArgvInto) is not
# implemented. The only spawn entry currently exported by
# cheng/core/runtime/production_held_exec_spawn.cheng is the hard-red
# compatibility stub CsgCoreProductionHeldExecLinuxSpawnAndObserveInto.
# Until domain G lands, this smoke is an honest negative assertion: the stub
# must refuse, must report the exact hard-red error, and must not leak a
# child process identity.

import std/os as os
import cheng/core/runtime/production_held_exec_spawn as spawn

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(): int32 =
    var childIdentityCid: str
    var err: str
    if spawn.CsgCoreProductionHeldExecLinuxSpawnAndObserveInto(
           -1,
           childIdentityCid,
           err):
        return fail("cross-process spawn unexpectedly available before domain G")
    if !(err == spawn.CsgCoreProductionHeldExecSpawnUnavailableHardRed):
        return fail("cross-process spawn hard-red error drift")
    if childIdentityCid.len != 0:
        return fail("cross-process spawn leaked a child identity")
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_held_exec_cross_process_smoke ok (hard-red negative, blocked on domain G)")
    return 0
