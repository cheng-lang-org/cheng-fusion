import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/parser

fn main(): int32 =
    var externalRoots: parser.ParserExternalPackageRoot[]
    var sources: texpr.TypedExprSourceText[]
    add(
        sources,
        texpr.TypedExprSourceTextNewWithPackageFacts(
            "/work",
            "/work/pkg",
            "pkg://current",
            "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
            externalRoots,
            "/work/pkg/main.cheng",
            "fn main(): int32 = 0\n"))
    var identity: texpr.TypedExprSourceIdentityIndex
    var err: str
    if !texpr.TypedExprBuildSourceIdentityIndex(
            sources, identity, err):
        return 1
    var physicalPath: str
    var ownerKey: str
    if !texpr.TypedExprSourceIdentityIndexOwnerForPath(
            identity,
            "/work/pkg/main.cheng",
            physicalPath,
            ownerKey,
            err):
        return 2
    if physicalPath != "/work/pkg/main.cheng":
        return 3
    if ownerKey !=
            "workspace=/work\npackageId=current\nchannel=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\nroot=/work/pkg":
        return 4
    return 0
