import cheng/core/ir/core_types as ir
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/regalloc_production_artifacts as regart
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/compiler_request as creq
import cheng/core/backend2/backend2_assemble as b2asm
import cheng/core/backend2/backend2_cid as b2cid
import cheng/core/backend2/backend2_frag_codec as b2fc
import cheng/core/backend2/backend2_fragment_lifecycle as b2life
import cheng/core/backend2/backend2_assembler_lifecycle as b2temps
import cheng/core/backend2/backend2_types as b2t
import cheng/core/ir/body_ir_access as access
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout
import std/result
import std/rawbytes as rawbytes

fn backend2CanonicalTypeArenaArtifactCid(): layout.FixedBytes32 =
    let source = "type Backend2CanonicalScalar = int32\n"
    var tree: parser.ParserValueExprTree
    var authority: typearena.TypedExprTypeResolutionAuthority
    var arena: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err) &&
           typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaComplete(arena) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "backend2 canonical exact TypeArena fixture")
    let artifact = arena.artifactRaw32
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    return artifact

fn backend2CanonicalSmokeSlot(id: int32,
                              name: str,
                              typeKind: int32,
                              stackOffset: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = stackOffset
    slot.sizeBytes = 8
    slot.alignBytes = 8
    if typeKind == ir.LocalI32Tag:
        slot.sizeBytes = 4
        slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn backend2CanonicalAppendI32Return(body: var ir.BodyIR,
                                     slotIndex: int32,
                                     opCount: int32) =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, opCount, termIndex)

fn backend2CanonicalFreezeEntryOwnership(body: var ir.BodyIR) =
    var ownershipKinds: int32[]
    for slotIndex in 0..<body.localSlots.len:
        add(ownershipKinds, int32(body.localSlots[slotIndex].ownership))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, ownershipKinds)

fn backend2CanonicalSealControlFlow(
        body: var ir.BodyIR,
        functionRow: int32,
        callTargetFunctionRow: int32) =
    assert(body.blocks.len == 1 && body.terms.len == 1,
           "backend2 canonical control rows")
    ir.BodyIRControlFlowBegin(body, functionRow)
    ir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    var noSuccessors: int32[]
    var noEdgeKinds: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, 0, noSuccessors, noEdgeKinds)
    if callTargetFunctionRow >= 0:
        assert(body.callSequence.len == 1,
               "backend2 canonical call row")
        ir.BodyIRControlFlowBindCallTarget(
            body,
            0,
            ir.BodyCallTargetDomainFunctionTag,
            callTargetFunctionRow,
            body.typeArenaArtifactCid)
    else:
        assert(body.callSequence.len == 0,
               "backend2 canonical callee call rows")
    ir.BodyIRControlFlowSeal(body)

fn backend2CanonicalConstBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(
               body,
               backend2CanonicalTypeArenaArtifactCid()),
           "backend2 canonical callee TypeArena identity")
    add(body.localSlots,
        backend2CanonicalSmokeSlot(0, "result", ir.LocalI32Tag, 16))
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 70000)
    add(body.ops, op)
    backend2CanonicalAppendI32Return(body, 0, 1)
    backend2CanonicalFreezeEntryOwnership(body)
    backend2CanonicalSealControlFlow(body, 0, -1)
    return body

fn backend2CanonicalCallerBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(
               body,
               backend2CanonicalTypeArenaArtifactCid()),
           "backend2 canonical caller TypeArena identity")
    add(body.localSlots,
        backend2CanonicalSmokeSlot(0, "result", ir.LocalI32Tag, 16))
    add(body.localSlots,
        backend2CanonicalSmokeSlot(1, "value", ir.LocalI32Tag, 24))
    add(body.localSlots,
        backend2CanonicalSmokeSlot(2, "cstring", ir.LocalPtrTag, 32))
    var globalSlot = backend2CanonicalSmokeSlot(
        3, "canonical_counter", ir.LocalI32Tag, 40)
    globalSlot.placeKind = ir.BodyPlaceGlobalAddressTag
    add(body.localSlots, globalSlot)

    let literalId = ir.BodyIRAppendCStringLiteral(body, "payload", "")
    var valueOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(valueOp)
    valueOp.kind = ir.BodyOpLoadConstTag
    valueOp.target = 1
    add(valueOp.operands, ir.LocalI32Tag)
    add(valueOp.operands, 9)
    add(body.ops, valueOp)
    var cstringOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(cstringOp)
    cstringOp.kind = ir.BodyOpLoadLocalTag
    cstringOp.target = 2
    add(cstringOp.operands, ir.BodyLoadLocalCStringTag)
    add(cstringOp.operands, literalId)
    add(body.ops, cstringOp)
    var globalStore: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(globalStore)
    globalStore.kind = ir.BodyOpGlobalStoreTag
    globalStore.target = 1
    add(globalStore.operands, 3)
    add(body.ops, globalStore)

    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "backend2_regalloc_callee"
    call.resultSlot = 0
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, 2)
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 8)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 0
    add(callOp.operands, 0)
    add(body.ops, callOp)
    backend2CanonicalAppendI32Return(body, 0, 4)
    backend2CanonicalFreezeEntryOwnership(body)
    backend2CanonicalSealControlFlow(body, 1, 0)
    return body

fn backend2CanonicalFragment(body: ir.BodyIR,
                             symbol: str,
                             includeGlobal: bool): b2t.FunctionFragment =
    var encoded = b2fc.Backend2BodyIrEncode(body)
    var fragment: b2t.FunctionFragment
    fragment.functionSymbol = share(symbol)
    fragment.bodyIrPayload = rawbytes.BytesToString(encoded)
    rawbytes.BytesFree(encoded)
    fragment.funcEmitCid = share(symbol) + "-canonical-regalloc-smoke"
    var ignoredPayloadTexts: str[]
    pobj.PrimaryBodyIrAppendCStringDataLabels(
        body, symbol, fragment.cstringDataLabels,
        ignoredPayloadTexts, fragment.cstringPayloadRawBytes,
        fragment.cstringPayloadRawByteCounts)
    for literalIndex in 0..<body.cstringLiterals.len:
        add(fragment.cstringLiterals,
            share(body.cstringLiterals[literalIndex].text))
    if includeGlobal:
        add(fragment.globalDataLabelsRaw,
            "cheng_global_canonical_counter")
        add(fragment.globalDataPayloadTexts, "zero:4")
        add(fragment.globalDataPayloadByteCounts, 0)
    fragment.contentCid = b2cid.Backend2ContentCidOfFragment(fragment)
    return fragment

fn backend2CanonicalEvidenceCountsExact(
        plan: var pobj.PrimaryObjectPlan,
        count: int32): bool =
    return plan.regallocFrozenSnapshotSinglePayloads.len == count &&
        plan.regallocEmissionLedgerSinglePayloads.len == count &&
        plan.regallocFunctionSymbols.len == count &&
        plan.regallocFunctionIrIndexes.len == count &&
        plan.regallocFunctionKinds.len == count &&
        plan.regallocFunctionBodyIrSha256s.len == count &&
        plan.regallocFunctionSymbolByteStarts.len == count &&
        plan.regallocFunctionSymbolByteLengths.len == count &&
        plan.regallocFunctionSymbolBytesSha256s.len == count &&
        plan.regallocFunctionPlanSha256s.len == count &&
        plan.regallocFunctionActionSemanticRootSha256s.len == count &&
        plan.regallocFunctionActionLedgerRootSha256s.len == count &&
        plan.regallocFunctionMachineFragmentRootSha256s.len == count &&
        plan.regallocFunctionAbiIngressRootSha256s.len == count &&
        plan.regallocFunctionActionCounts.len == count &&
        plan.regallocFunctionExactCalleeMasks.len == count &&
        plan.regallocFunctionRegisterAssignmentCounts.len == count &&
        plan.regallocFunctionSpillActionCounts.len == count &&
        plan.regallocFunctionReloadActionCounts.len == count &&
        plan.regallocFunctionCallClobberActionCounts.len == count &&
        plan.regallocFunctionEdgeParallelCopyActionCounts.len == count &&
        plan.regallocFunctionParallelCopyCycleBreakActionCounts.len == count &&
        plan.regallocFunctionCriticalEdgeActionCounts.len == count &&
        plan.regallocFunctionSretExclusionCounts.len == count &&
        plan.regallocFunctionAddressEscapeMemoryActionCounts.len == count &&
        plan.regallocFunctionOutgoingStackArgActionCounts.len == count

fn backend2CanonicalDataRelocExact(
        plan: var pobj.PrimaryObjectPlan,
        targetSymbol: str,
        itemId: int32,
        functionWordStart: int32,
        functionWordCount: int32): bool =
    var matches: int32
    for relocIndex in 0..<plan.dataRelocTargetSymbols.len:
        if plan.dataRelocTargetSymbols[relocIndex] != targetSymbol:
            continue
        matches = matches + 1
        if plan.dataRelocSourceItemIds[relocIndex] != itemId ||
           plan.dataRelocWordOffsets[relocIndex] < functionWordStart ||
           plan.dataRelocWordOffsets[relocIndex] >=
               functionWordStart + functionWordCount:
            return false
    return matches == 1

fn main(): int32 =
    var invalidReturnBody = backend2CanonicalConstBody()
    invalidReturnBody.terms[0].sourceDefinitionDomain =
        ir.BodyDefinitionDomainBodyOpTag
    invalidReturnBody.terms[0].sourceDefinitionRow = 0
    var invalidReturnAccess =
        access.BodyIrAccessDecode(invalidReturnBody)
    if access.BodyIrAccessTableIsValid(invalidReturnAccess) ||
       invalidReturnAccess.errorCode !=
           access.BodyIrAccessErrorOwnership ||
       invalidReturnAccess.errorSiteKind !=
           access.BodyIrAccessSiteTerm ||
       invalidReturnAccess.errorSiteIndex != 0 ||
       invalidReturnAccess.errorDetail != -1:
        return 10

    let calleeBody = backend2CanonicalConstBody()
    let callerBody = backend2CanonicalCallerBody()
    var fragments: b2t.FunctionFragment[]
    add(fragments, backend2CanonicalFragment(
        calleeBody, "backend2_regalloc_callee", false))
    add(fragments, backend2CanonicalFragment(
        callerBody, "backend2_regalloc_caller", true))
    var functionIrIndexes: int32[]
    add(functionIrIndexes, 0)
    add(functionIrIndexes, 1)
    var fragmentBuilt: bool[]
    add(fragmentBuilt, true)
    add(fragmentBuilt, true)
    var functionTypedIrIndexes: int32[]
    add(functionTypedIrIndexes, 0)
    add(functionTypedIrIndexes, 1)
    var functionNameIds: int32[]
    add(functionNameIds, 17)
    add(functionNameIds, 19)
    var functionNames: str[]
    add(functionNames, "backend2_regalloc_callee")
    add(functionNames, "backend2_regalloc_caller")
    var functionSymbolRoles: int32[]
    add(functionSymbolRoles, pobj.PrimaryObjectSymbolRoleTypedName)
    add(functionSymbolRoles, pobj.PrimaryObjectSymbolRoleSourceEntry)
    let internDomainCidRes = layout.FixedBytes32FromHex(
        "1111111111111111111111111111111111111111111111111111111111111111")
    let loweringIdentityCidRes = layout.FixedBytes32FromHex(
        "2222222222222222222222222222222222222222222222222222222222222222")
    if !IsOk(internDomainCidRes) || !IsOk(loweringIdentityCidRes):
        return 11
    var assemblerLifecycle: b2temps.Backend2AssemblerTempLifecycle
    b2temps.Backend2AssemblerTempLifecycleBeginInvocation(
        assemblerLifecycle)
    b2temps.Backend2AssemblerLifecycleAppendAllSymbolName(
        assemblerLifecycle, "_backend2_regalloc_callee")
    b2temps.Backend2AssemblerLifecycleAppendAllSymbolName(
        assemblerLifecycle, "_backend2_regalloc_caller")
    b2temps.Backend2AssemblerLifecycleMoveAllSymbolsToAssembler(
        assemblerLifecycle)
    var linkPlan: slplan.SystemLinkPlanStub
    linkPlan.targetTriple = "arm64-apple-darwin"
    linkPlan.emitKind = creq.EmitObj
    linkPlan.outputPath = "/tmp/backend2-canonical-regalloc.o"
    linkPlan.entryPath =
        "src/tests/backend2_canonical_regalloc_wiring_smoke.cheng"
    linkPlan.entrySymbol = "backend2_regalloc_caller"
    var plan: pobj.PrimaryObjectPlan
    var fragmentLifecycle: b2life.Backend2FragmentLifecycle
    b2life.Backend2FragmentLifecycleBegin(
        fragmentLifecycle,
        fragments,
        fragmentBuilt,
        functionIrIndexes)
    b2life.Backend2FragmentLifecycleMoveToAssembler(
        fragmentLifecycle)
    b2asm.Backend2AssembleInto(fragments,
                               fragmentBuilt,
                               functionIrIndexes,
                               functionTypedIrIndexes,
                               functionNameIds,
                               functionNames,
                               functionSymbolRoles,
                               Value(internDomainCidRes),
                               Value(loweringIdentityCidRes),
                               1,
                               assemblerLifecycle,
                               linkPlan,
                               backend2CanonicalTypeArenaArtifactCid(),
                               fragmentLifecycle,
                               plan)
    if plan.symbolNames.len != 2 ||
       plan.entrySymbol != "backend2_regalloc_caller" ||
       plan.entryFunctionSymbol != "_backend2_regalloc_caller" ||
       plan.symbolNames[0] != "_backend2_regalloc_callee" ||
       plan.symbolNames[1] != "_backend2_regalloc_caller" ||
       plan.symbolTypedFunctionIndexes.len != 2 ||
       plan.symbolTypedFunctionIndexes[0] != 0 ||
       plan.symbolTypedFunctionIndexes[1] != 1 ||
       plan.symbolNameIds.len != 2 ||
       plan.symbolNameIds[0] != 17 ||
       plan.symbolNameIds[1] != 19 ||
       plan.symbolRoles.len != 2 ||
       plan.symbolRoles[0] !=
           pobj.PrimaryObjectSymbolRoleTypedName ||
       plan.symbolRoles[1] !=
           pobj.PrimaryObjectSymbolRoleSourceEntry ||
       layout.FixedBytes32Equal(
           plan.symbolIdentityReceiptCid,
           layout.FixedBytes32()) ||
       !layout.FixedBytes32Equal(
           plan.symbolIdentityReceiptCid,
           pobj.PrimaryObjectPlanSymbolIdentityReceiptCid(plan)) ||
       plan.functionWordOffsets.len != 2 ||
       plan.functionWordOffsets[0] != 0 ||
       plan.functionWordOffsets[1] <= 0 ||
       plan.functionWordCounts.len != 2 ||
       plan.functionWordCounts[0] <= 0 ||
       plan.functionWordCounts[1] <= 0 ||
       plan.instructionWords.len != plan.functionWordCounts[0] +
           plan.functionWordCounts[1] ||
       !backend2CanonicalEvidenceCountsExact(plan, 2) ||
       plan.regallocFunctionIrIndexes[0] != 0 ||
       plan.regallocFunctionIrIndexes[1] != 1 ||
       plan.regallocFunctionKinds[0] !=
           regart.RegallocProductionFunctionKindNormal ||
       plan.regallocFunctionKinds[1] !=
           regart.RegallocProductionFunctionKindNormal ||
       plan.regallocFunctionSymbols[1] !=
           "_backend2_regalloc_caller" ||
       plan.regallocFunctionSymbolByteStarts[1] !=
           plan.functionWordOffsets[1] * 4 ||
       plan.regallocFunctionSymbolByteLengths[1] !=
           plan.functionWordCounts[1] * 4 ||
       len(plan.regallocFunctionBodyIrSha256s[1]) != 64 ||
       len(plan.regallocFunctionPlanSha256s[1]) != 64 ||
       len(plan.regallocFunctionMachineFragmentRootSha256s[1]) != 64 ||
       plan.bodyIrLifecycleFunctionCount != 2 ||
       plan.bodyIrLifecycleAllocated != int64(2) ||
       plan.bodyIrLifecycleReleased != int64(2) ||
       plan.bodyIrLifecycleLive != int64(0) ||
       plan.bodyIrLifecycleAllocatedBytes !=
           plan.bodyIrLifecycleReleasedBytes ||
       plan.bodyIrLifecycleLiveBytes != int64(0) ||
       plan.bodyIrLifecycleOwnerTransferCount != int64(2) ||
       plan.bodyIrLifecyclePhysicalFreeCount < int64(2) ||
       !plan.bodyIrLifecycleAllClosed ||
       plan.backend2FragmentFunctionRowCount != 2 ||
       plan.backend2FragmentBuiltFunctionCount != 2 ||
       plan.backend2FragmentAllocated != int64(1) ||
       plan.backend2FragmentReleased != int64(1) ||
       plan.backend2FragmentLive != int64(0) ||
       plan.backend2FragmentAllocatedBytes !=
           plan.backend2FragmentReleasedBytes ||
       plan.backend2FragmentLiveBytes != int64(0) ||
       plan.backend2FragmentOwnerTransferCount != int64(1) ||
       plan.backend2FragmentPhysicalFreeCount <= 0 ||
       !plan.backend2FragmentPayloadReleased ||
       !plan.backend2FragmentLedgerStorageReleased ||
       !plan.backend2FragmentReleaseReceiptConsumed ||
       fragments.len != 0 || fragments.cap != 0 ||
       fragmentBuilt.len != 0 || fragmentBuilt.cap != 0 ||
       functionIrIndexes.len != 0 ||
       functionIrIndexes.cap != 0:
        return 1
    if plan.relocSourceItemIds.len != 1 ||
       plan.relocWordOffsets.len != 1 ||
       plan.relocTargetSymbols.len != 1 ||
       plan.relocSourceItemIds[0] != 100001 ||
       plan.relocTargetSymbols[0] != "_backend2_regalloc_callee" ||
       plan.relocWordOffsets[0] < plan.functionWordOffsets[1] ||
       plan.relocWordOffsets[0] >= plan.functionWordOffsets[1] +
           plan.functionWordCounts[1]:
        return 2
    if plan.dataRelocSourceItemIds.len != 2 ||
       plan.dataRelocWordOffsets.len != 2 ||
       plan.dataRelocTargetSymbols.len != 2 ||
       !backend2CanonicalDataRelocExact(
           plan,
           "_backend2_regalloc_caller__cheng_cstring_0",
           100001,
           plan.functionWordOffsets[1],
           plan.functionWordCounts[1]) ||
       !backend2CanonicalDataRelocExact(
           plan,
           "_cheng_global_canonical_counter",
           100001,
           plan.functionWordOffsets[1],
           plan.functionWordCounts[1]):
        return 3
    if plan.dataLabels.len != 2 ||
       plan.dataLabels[0] != "_cheng_global_canonical_counter" ||
       plan.dataLabels[1] !=
           "_backend2_regalloc_caller__cheng_cstring_0" ||
       plan.dataPayloadRawByteCounts.len != 2 ||
       plan.dataPayloadRawByteCounts[0] != 0 ||
       plan.dataPayloadRawByteCounts[1] != 8 ||
       plan.dataPayloadRawBytes.len != 8 ||
       plan.dataPayloadRawBytes[7] != 0:
        return 4
    echo("BACKEND2_CANONICAL_REGALLOC_OK lifecycle_live=0 lifecycle_closed=1")
    return 0

main()
