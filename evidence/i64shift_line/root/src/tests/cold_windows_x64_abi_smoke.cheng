import std/cmdline as cmdline
import std/os as os
import std/strings as strings

fn main(): int32 =
    let argc = cmdline.ParamCount()
    if argc < 2:
        return 11
    if cmdline.ParamStr(1) != "alpha":
        return 12
    if cmdline.ParamStr(2) != "beta":
        return 13

    let cwd = os.GetCurrentDir()
    if strings.Len(cwd) <= 0:
        return 14

    let envValue = os.GetEnv("CHENG_COLD_WINDOWS_ABI_PROBE")
    if envValue != "ok":
        return 15

    let dir = "cold_windows_x64_abi_smoke_tmp"
    let existed = os.DirExists(dir)
    if !existed:
        if !os.MakeDir(dir):
            return 16
    if !os.DirExists(dir):
        return 17
    if !existed:
        os.RemoveDir(dir)

    echo(" cold_windows_x64_abi_smoke ok")
    return 0
