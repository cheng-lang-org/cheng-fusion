import std/os
import std/strformat
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower

fn main(): int32 =
    var owner: lower.LoweringReportPartsOwner
    for row in 0..<40:
        lower.LoweringReportPartsAppendLine(
            owner,
            Fmt"key_{row}",
            Fmt"value_{row}")
    lower.LoweringReportPartsAppendBlock(owner, "tail=block")
    if owner.parts.len != 161:
        panic("formal lowering report parts: logical part count drift")
    let joined = strutil.Join(owner.parts, "")
    if joined.len <= 0:
        panic("formal lowering report parts: joined report missing")
    let terminalBufferCount =
        lower.LoweringReportPartsPhysicalBufferCount(owner)
    let terminalBytes =
        lower.LoweringReportPartsCapacityBytes(owner)
    if terminalBufferCount != 1 || terminalBytes <= int64(0):
        panic("formal lowering report parts: terminal retained mismatch")
    if os.GetEnv("CHENG_FORMAL_LOWERING_REPORT_PARTS_NEGATIVE") ==
           "shape":
        while owner.parts.len < owner.parts.cap:
            lower.LoweringReportPartsAppendText(owner, "tracked")
        add(owner.parts, "untracked-growth")
    var receipt: lower.LoweringSequenceAllocatorReceipt
    lower.LoweringReportPartsReleaseWithReceipt(owner, receipt)
    if os.GetEnv("CHENG_FORMAL_LOWERING_REPORT_PARTS_NEGATIVE") ==
           "receipt-bytes":
        receipt.allocatedCapacityBytes =
            receipt.allocatedCapacityBytes - int64(1)
    if receipt.allocationEventCount <= int64(terminalBufferCount) ||
       receipt.releaseEventCount != receipt.allocationEventCount ||
       receipt.allocatedCapacityBytes <= terminalBytes ||
       receipt.releasedCapacityBytes != receipt.allocatedCapacityBytes ||
       receipt.terminalRetainedBufferCount != terminalBufferCount ||
       receipt.terminalRetainedBytes != terminalBytes ||
       receipt.terminalReleasedBufferCount != terminalBufferCount ||
       receipt.terminalReleasedBytes != terminalBytes ||
       receipt.liveAllocationCount != int64(0) ||
       receipt.liveCapacityBytes != int64(0) ||
       !lower.LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !lower.LoweringReportPartsReceiptConsumeStrict(owner, receipt):
        panic("formal lowering report parts: allocator receipt mismatch")
    if os.GetEnv("CHENG_FORMAL_LOWERING_REPORT_PARTS_NEGATIVE") ==
           "append-after-close":
        lower.LoweringReportPartsAppendText(owner, "late")
    var primaryIr: lower.PrimaryObjectIr
    let primaryReport =
        lower.LoweringPrimaryObjectIrReportText(primaryIr)
    if primaryReport.len <= 0:
        panic("formal lowering report parts: primary producer missing")
    var plan: lower.LoweringPlanStub
    let planReport = lower.LoweringPlanStubReport(plan)
    if planReport.len <= primaryReport.len:
        panic("formal lowering report parts: plan producer missing")
    os.WriteLine(
        os.GetStdout(),
        Fmt"formal_lowering_report_parts_allocator_smoke ok columns=1 lines=40 parts=161 allocation_events={receipt.allocationEventCount} release_events={receipt.releaseEventCount} allocated_bytes={receipt.allocatedCapacityBytes} released_bytes={receipt.releasedCapacityBytes} terminal_buffers={receipt.terminalRetainedBufferCount} terminal_bytes={receipt.terminalRetainedBytes} live={receipt.liveAllocationCount} live_bytes={receipt.liveCapacityBytes}")
    return 0
