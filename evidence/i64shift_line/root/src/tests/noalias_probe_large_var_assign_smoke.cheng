type
    ProbeWide =
        a: int32
        b: int32
        c: int32
        d: int32
        e: int32
        f: int32

fn ProbeAssignWide(out: var ProbeWide, src: ProbeWide) =
    out = src
    return

fn main(): int32 =
    var out: ProbeWide
    var src: ProbeWide
    src.a = 77
    src.f = 9
    ProbeAssignWide(out, src)
    if out.f != 9:
        return 66
    return out.a
