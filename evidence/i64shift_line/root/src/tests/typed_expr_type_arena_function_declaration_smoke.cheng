import std/strutils as strutil
import cheng/core/lang/parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod

fn main(): int32 =
    let firstSource =
        "fn First(value: int32): bool =\n    return value > 0\n\nfn Second(): int32 =\n    return 0\n\nfn SecondTwin(): int32 =\n    return 1\n\nfn SameA(first: int32, second: int32): bool =\n    return first == second\n\nfn SameB(left: int32, right: int32): bool =\n    return left == right\n"
    let secondSource =
        "fn First(value: uint64, flag: bool): uint64 =\n    return value\n\nfn SameCross(a: int32, b: int32): bool =\n    return a == b\n"
    var firstTree: parser.ParserValueExprTree
    var secondTree: parser.ParserValueExprTree
    var forest: parser.ParserValueExprTree
    var err: str
    assert(
        parser.ParserValueExprReadTreeFromText(
            firstSource, firstTree, err) &&
        parser.ParserValueExprReadTreeFromText(
            secondSource, secondTree, err),
        Fmt"typed expr type arena function declaration: parse failed {err}")
    parser.ParserValueExprTreeAppendFrom(forest, firstTree)
    parser.ParserValueExprTreeAppendFrom(forest, secondTree)
    let authority =
        typearena.TypedExprTypeResolutionAuthorityEmpty()
    var arena: typearena.TypedExprTypeArena
    assert(
        typearena.TypedExprTypeArenaBuildFromParserTreeInto(
            forest, authority, arena, err) &&
        typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
        Fmt"typed expr type arena function declaration: build failed {err}")
    assert(
        arena.functionSourceStarts.len == 2 &&
        arena.functionSourceCounts.len == 2 &&
        arena.functionOwnerTokenIndexes.len == 7 &&
        arena.functionTypeIds.len == 7 &&
        arena.functionParameterStarts.len == 7 &&
        arena.functionParameterCounts.len == 7 &&
        arena.functionParameterDeclarationSourceLocalRows.len == 9 &&
        arena.functionParameterTypeSyntaxRootIndexes.len == 9 &&
        arena.functionParameterTypeIds.len == 9 &&
        arenamod.ArenaArrayInt32Get(
            arena.arena,
            arena.functionSourceStarts,
            0) == 0 &&
        arenamod.ArenaArrayInt32Get(
            arena.arena,
            arena.functionSourceCounts,
            0) == 5 &&
        arenamod.ArenaArrayInt32Get(
            arena.arena,
            arena.functionSourceStarts,
            1) == 5 &&
        arenamod.ArenaArrayInt32Get(
            arena.arena,
            arena.functionSourceCounts,
            1) == 2,
        "typed expr type arena function declaration: source CSR drift")
    let firstTypeId =
        typearena.TypedExprTypeArenaFunctionTypeId(
            arena, 0, 0)
    let secondTypeId =
        typearena.TypedExprTypeArenaFunctionTypeId(
            arena, 0, 1)
    let thirdTypeId =
        typearena.TypedExprTypeArenaFunctionTypeId(
            arena, 1, 0)
    let secondTwinTypeId =
        typearena.TypedExprTypeArenaFunctionTypeId(
            arena, 0, 2)
    let sameATypeId =
        typearena.TypedExprTypeArenaFunctionTypeId(
            arena, 0, 3)
    let sameBTypeId =
        typearena.TypedExprTypeArenaFunctionTypeId(
            arena, 0, 4)
    let sameCrossTypeId =
        typearena.TypedExprTypeArenaFunctionTypeId(
            arena, 1, 1)
    assert(
        firstTypeId != secondTypeId &&
        secondTypeId == secondTwinTypeId &&
        firstTypeId != thirdTypeId &&
        secondTypeId != thirdTypeId &&
        typearena.TypedExprTypeArenaKindAt(
            arena, firstTypeId) ==
            typearena.TypedExprStructuralTypeFunction &&
        typearena.TypedExprTypeArenaKindAt(
            arena, secondTypeId) ==
            typearena.TypedExprStructuralTypeFunction &&
        typearena.TypedExprTypeArenaKindAt(
            arena, thirdTypeId) ==
            typearena.TypedExprStructuralTypeFunction,
        "typed expr type arena function declaration: exact Function TypeId drift")
    assert(
        sameATypeId == sameBTypeId &&
        sameATypeId == sameCrossTypeId,
        "typed expr type arena function declaration: structural Function TypeId not shared")
    var typeSwap = typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        typeSwap.arena,
        typeSwap.functionTypeIds,
        0,
        secondTypeId)
    arenamod.ArenaArrayInt32Set(
        typeSwap.arena,
        typeSwap.functionTypeIds,
        1,
        firstTypeId)
    typeSwap.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(typeSwap)
    assert(
        !typearena.TypedExprTypeArenaStrictValidateInto(
            typeSwap, err) &&
        (strutil.Contains(err, "parameter TypeId drift") ||
         strutil.Contains(err, "return TypeId drift")),
        "typed expr type arena function declaration: recomputed-CID TypeId swap survived")
    var crossSourceSwap =
        typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        crossSourceSwap.arena,
        crossSourceSwap.functionTypeIds,
        0,
        thirdTypeId)
    arenamod.ArenaArrayInt32Set(
        crossSourceSwap.arena,
        crossSourceSwap.functionTypeIds,
        5,
        firstTypeId)
    crossSourceSwap.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            crossSourceSwap)
    assert(
        !typearena.TypedExprTypeArenaStrictValidateInto(
            crossSourceSwap, err) &&
        (strutil.Contains(err, "parameter TypeId drift") ||
         strutil.Contains(err, "return TypeId drift")),
        "typed expr type arena function declaration: cross-source same-name TypeId swap survived")
    var ownerSwap = typearena.TypedExprTypeArenaClone(arena)
    let firstOwner = arenamod.ArenaArrayInt32Get(
        ownerSwap.arena,
        ownerSwap.functionOwnerTokenIndexes,
        0)
    let secondOwner = arenamod.ArenaArrayInt32Get(
        ownerSwap.arena,
        ownerSwap.functionOwnerTokenIndexes,
        1)
    arenamod.ArenaArrayInt32Set(
        ownerSwap.arena,
        ownerSwap.functionOwnerTokenIndexes,
        0,
        secondOwner)
    arenamod.ArenaArrayInt32Set(
        ownerSwap.arena,
        ownerSwap.functionOwnerTokenIndexes,
        1,
        firstOwner)
    ownerSwap.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(ownerSwap)
    assert(
        !typearena.TypedExprTypeArenaStrictValidateInto(
            ownerSwap, err) &&
        (strutil.Contains(err, "parameter declaration identity drift") ||
         strutil.Contains(err, "function return TypeId drift") ||
         strutil.Contains(err, "function signature row invalid")),
        "typed expr type arena function declaration: recomputed-CID owner swap survived")
    var zeroDeclarationOwnerSwap =
        typearena.TypedExprTypeArenaClone(arena)
    let secondDeclaration = arenamod.ArenaArrayInt32Get(
        zeroDeclarationOwnerSwap.arena,
        zeroDeclarationOwnerSwap.functionDeclarationSourceLocalRows,
        1)
    let secondTwinDeclaration = arenamod.ArenaArrayInt32Get(
        zeroDeclarationOwnerSwap.arena,
        zeroDeclarationOwnerSwap.functionDeclarationSourceLocalRows,
        2)
    let secondZeroOwner = arenamod.ArenaArrayInt32Get(
        zeroDeclarationOwnerSwap.arena,
        zeroDeclarationOwnerSwap.functionOwnerTokenIndexes,
        1)
    let secondTwinOwner = arenamod.ArenaArrayInt32Get(
        zeroDeclarationOwnerSwap.arena,
        zeroDeclarationOwnerSwap.functionOwnerTokenIndexes,
        2)
    arenamod.ArenaArrayInt32Set(
        zeroDeclarationOwnerSwap.arena,
        zeroDeclarationOwnerSwap.functionDeclarationSourceLocalRows,
        1,
        secondTwinDeclaration)
    arenamod.ArenaArrayInt32Set(
        zeroDeclarationOwnerSwap.arena,
        zeroDeclarationOwnerSwap.functionDeclarationSourceLocalRows,
        2,
        secondDeclaration)
    arenamod.ArenaArrayInt32Set(
        zeroDeclarationOwnerSwap.arena,
        zeroDeclarationOwnerSwap.functionOwnerTokenIndexes,
        1,
        secondTwinOwner)
    arenamod.ArenaArrayInt32Set(
        zeroDeclarationOwnerSwap.arena,
        zeroDeclarationOwnerSwap.functionOwnerTokenIndexes,
        2,
        secondZeroOwner)
    zeroDeclarationOwnerSwap.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            zeroDeclarationOwnerSwap)
    assert(
        !typearena.TypedExprTypeArenaStrictValidateInto(
            zeroDeclarationOwnerSwap, err) &&
        strutil.Contains(err, "function declaration identity drift"),
        "typed expr type arena function declaration: zero-parameter declaration/owner swap survived")
    var parameterOrderSwap =
        typearena.TypedExprTypeArenaClone(arena)
    let sameAParameterStart = arenamod.ArenaArrayInt32Get(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterStarts,
        3)
    let sameAFirstDeclaration = arenamod.ArenaArrayInt32Get(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterDeclarationSourceLocalRows,
        sameAParameterStart)
    let sameASecondDeclaration = arenamod.ArenaArrayInt32Get(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterDeclarationSourceLocalRows,
        sameAParameterStart + 1)
    let sameAFirstRoot = arenamod.ArenaArrayInt32Get(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterTypeSyntaxRootIndexes,
        sameAParameterStart)
    let sameASecondRoot = arenamod.ArenaArrayInt32Get(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterTypeSyntaxRootIndexes,
        sameAParameterStart + 1)
    arenamod.ArenaArrayInt32Set(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterDeclarationSourceLocalRows,
        sameAParameterStart,
        sameASecondDeclaration)
    arenamod.ArenaArrayInt32Set(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterDeclarationSourceLocalRows,
        sameAParameterStart + 1,
        sameAFirstDeclaration)
    arenamod.ArenaArrayInt32Set(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterTypeSyntaxRootIndexes,
        sameAParameterStart,
        sameASecondRoot)
    arenamod.ArenaArrayInt32Set(
        parameterOrderSwap.arena,
        parameterOrderSwap.functionParameterTypeSyntaxRootIndexes,
        sameAParameterStart + 1,
        sameAFirstRoot)
    parameterOrderSwap.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            parameterOrderSwap)
    assert(
        !typearena.TypedExprTypeArenaStrictValidateInto(
            parameterOrderSwap, err) &&
        strutil.Contains(err, "parameter declaration order drift"),
        "typed expr type arena function declaration: same-TypeId parameter order swap survived")
    var sameSourceFunctionSwap =
        typearena.TypedExprTypeArenaClone(arena)
    let sameBParameterStart = arenamod.ArenaArrayInt32Get(
        sameSourceFunctionSwap.arena,
        sameSourceFunctionSwap.functionParameterStarts,
        4)
    let sameSourceFirstRoot = arenamod.ArenaArrayInt32Get(
        sameSourceFunctionSwap.arena,
        sameSourceFunctionSwap.functionParameterTypeSyntaxRootIndexes,
        sameAParameterStart)
    let sameSourceSecondRoot = arenamod.ArenaArrayInt32Get(
        sameSourceFunctionSwap.arena,
        sameSourceFunctionSwap.functionParameterTypeSyntaxRootIndexes,
        sameBParameterStart)
    arenamod.ArenaArrayInt32Set(
        sameSourceFunctionSwap.arena,
        sameSourceFunctionSwap.functionParameterTypeSyntaxRootIndexes,
        sameAParameterStart,
        sameSourceSecondRoot)
    arenamod.ArenaArrayInt32Set(
        sameSourceFunctionSwap.arena,
        sameSourceFunctionSwap.functionParameterTypeSyntaxRootIndexes,
        sameBParameterStart,
        sameSourceFirstRoot)
    sameSourceFunctionSwap.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            sameSourceFunctionSwap)
    assert(
        !typearena.TypedExprTypeArenaStrictValidateInto(
            sameSourceFunctionSwap, err) &&
        strutil.Contains(err, "parameter declaration identity drift"),
        "typed expr type arena function declaration: same-source function coordinate swap survived")
    var crossSourceFunctionSwap =
        typearena.TypedExprTypeArenaClone(arena)
    let sameCrossParameterStart = arenamod.ArenaArrayInt32Get(
        crossSourceFunctionSwap.arena,
        crossSourceFunctionSwap.functionParameterStarts,
        6)
    let firstSourceRoot = arenamod.ArenaArrayInt32Get(
        crossSourceFunctionSwap.arena,
        crossSourceFunctionSwap.functionParameterTypeSyntaxRootIndexes,
        sameAParameterStart)
    let secondSourceRoot = arenamod.ArenaArrayInt32Get(
        crossSourceFunctionSwap.arena,
        crossSourceFunctionSwap.functionParameterTypeSyntaxRootIndexes,
        sameCrossParameterStart)
    arenamod.ArenaArrayInt32Set(
        crossSourceFunctionSwap.arena,
        crossSourceFunctionSwap.functionParameterTypeSyntaxRootIndexes,
        sameAParameterStart,
        secondSourceRoot)
    arenamod.ArenaArrayInt32Set(
        crossSourceFunctionSwap.arena,
        crossSourceFunctionSwap.functionParameterTypeSyntaxRootIndexes,
        sameCrossParameterStart,
        firstSourceRoot)
    crossSourceFunctionSwap.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            crossSourceFunctionSwap)
    assert(
        !typearena.TypedExprTypeArenaStrictValidateInto(
            crossSourceFunctionSwap, err) &&
        strutil.Contains(err, "parameter declaration identity drift"),
        "typed expr type arena function declaration: cross-source coordinate swap survived")
    var provenanceSwap =
        typearena.TypedExprTypeArenaClone(arena)
    arenamod.ArenaArrayInt32Set(
        provenanceSwap.arena,
        provenanceSwap.originFunctionRows,
        sameATypeId,
        4)
    provenanceSwap.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            provenanceSwap)
    assert(
        !typearena.TypedExprTypeArenaStrictValidateInto(
            provenanceSwap, err) &&
        strutil.Contains(err, "provenance is not canonical"),
        "typed expr type arena function declaration: non-canonical provenance survived")
    typearena.TypedExprTypeArenaRelease(provenanceSwap)
    typearena.TypedExprTypeArenaRelease(crossSourceFunctionSwap)
    typearena.TypedExprTypeArenaRelease(sameSourceFunctionSwap)
    typearena.TypedExprTypeArenaRelease(parameterOrderSwap)
    typearena.TypedExprTypeArenaRelease(zeroDeclarationOwnerSwap)
    typearena.TypedExprTypeArenaRelease(ownerSwap)
    typearena.TypedExprTypeArenaRelease(crossSourceSwap)
    typearena.TypedExprTypeArenaRelease(typeSwap)
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(forest)
    parser.ParserValueExprTreeRelease(secondTree)
    parser.ParserValueExprTreeRelease(firstTree)
    echo("typed_expr_type_arena_function_declaration_smoke: ok")
    return 0
