import std/cmdline
import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

type
    CidEvidenceAuthenticatedMigration =
        plan: slplan.SystemLinkPlanStub
        currentCsg: ccsg.CompilerCsg
        migration: ccsg.CompilerLegacyMigration
        evidence: ceq.CompilerMigrationEvidence
        proof: ceq.CompilerMigrationSemanticProof
        baselineSemantic: sexec.CompileSemanticReceipt
        migratedSemantic: sexec.CompileSemanticReceipt
        currentText: str
        legacyText: str
        entryModulePath: str

@borrows
fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

@borrows
fn CidEvidenceTextLess(left: str, right: str): bool =
    let shared = left.len < right.len ? left.len : right.len
    for index in 0..<shared:
        if left[index] < right[index]:
            return true
        if left[index] > right[index]:
            return false
    return left.len < right.len

fn CidEvidenceSortTexts(values: var str[]) =
    for index in 1..<values.len:
        var cursor = index
        while cursor > 0 && CidEvidenceTextLess(
                strings.CloneStr(values[cursor]),
                strings.CloneStr(values[cursor - 1])):
            let prior = strings.CloneStr(values[cursor - 1])
            values[cursor - 1] = strings.CloneStr(values[cursor])
            values[cursor] = prior
            cursor = cursor - 1

@borrows
fn CidEvidenceWrite(root: str,
                    relativePath: str,
                    text: str) =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    os.WriteFile(absolute, text)

@borrows
fn CidEvidenceArtifactRelativePath(role: str): str =
    return strings.ConcatStr("artifacts/", strings.ConcatStr(strings.CloneStr(role), ".bin"))

fn CidEvidenceMigrationCoreRoles(): str[] =
    return [
        "baseline_csg",
        "baseline_semantic",
        "baseline_surface",
        "migrated_csg",
        "migrated_semantic",
        "migrated_surface",
        "migration_evidence",
        "migration_proof"]

@borrows
fn CidEvidencePrepareCase(caseId: str, caseRoot: str): bool =
    if caseId != "mirror-atomic-install":
        return false
    let sourceRoot = chengpath.PathJoin(caseRoot, "src")
    let legacyRoot = chengpath.PathJoin(caseRoot, "legacy")
    os.MkdirAll(sourceRoot, 493)
    os.MkdirAll(legacyRoot, 493)
    os.WriteFile(
        chengpath.PathJoin(caseRoot, "cheng-package.toml"),
        "package_id = \"cheng/compiler\"\n")
    os.WriteFile(
        chengpath.PathJoin(sourceRoot, "main.cheng"),
        CidEvidenceJoin([
            "fn ExportedAdd(left: int32, right: int32): int32 =\n",
            "    return left + right\n\n",
            "fn main(): int32 =\n",
            "    if false:\n",
            "        return 1\n",
            "    elif true:\n",
            "        return ExportedAdd(20, 22) - 42\n",
            "    return 2\n"]))
    os.WriteFile(
        chengpath.PathJoin(legacyRoot, "main.cheng"),
        CidEvidenceJoin([
            "proc ExportedAdd(left: int32, right: int32): int32 =\n",
            "    return left + right\n\n",
            "proc main(): int32 =\n",
            "    if false:\n",
            "        return 1\n",
            "    else if true:\n",
            "        return ExportedAdd(20, 22) - 42\n",
            "    return 2\n"]))
    return true

@borrows
fn CidEvidencePrepareMigrationRootForPackage(root: str,
                                             packageId: str,
                                             currentText: str,
                                             legacyText: str) =
    let sourceRoot = chengpath.PathJoin(root, "src")
    let legacyRoot = chengpath.PathJoin(root, "legacy")
    os.MkdirAll(sourceRoot, 493)
    os.MkdirAll(legacyRoot, 493)
    os.WriteFile(
        chengpath.PathJoin(root, "cheng-package.toml"),
        CidEvidenceJoin([
            "package_id = \"", strings.CloneStr(packageId), "\"\n"]))
    os.WriteFile(chengpath.PathJoin(sourceRoot, "main.cheng"), currentText)
    os.WriteFile(chengpath.PathJoin(legacyRoot, "main.cheng"), legacyText)

@borrows
fn CidEvidenceAuthenticatedMigrationReports(
        build: CidEvidenceAuthenticatedMigration): str[] =
    return [
        strings.CloneStr(build.migration.baselineArtifact.canonicalCsgReport),
        strings.CloneStr(sexec.SystemLinkExecCompileSemanticReceiptReport(
            build.baselineSemantic)),
        strings.CloneStr(ccsg.CompilerExportSurfaceReport(
            build.migration.baselineArtifact.exportSurface)),
        strings.CloneStr(build.migration.migratedArtifact.canonicalCsgReport),
        strings.CloneStr(sexec.SystemLinkExecCompileSemanticReceiptReport(
            build.migratedSemantic)),
        strings.CloneStr(ccsg.CompilerExportSurfaceReport(
            build.migration.migratedArtifact.exportSurface)),
        strings.CloneStr(ceq.CompilerMigrationEvidenceReport(build.evidence)),
        strings.CloneStr(ceq.CompilerMigrationSemanticProofReport(build.proof))]

@borrows
fn CidEvidenceBuildAuthenticatedMigration(
        workspaceRoot: str,
        outputPath: str,
        out: var CidEvidenceAuthenticatedMigration): Result[bool] =
    let currentSourcePath = chengpath.PathJoin(
        workspaceRoot, "src/main.cheng")
    let legacySourcePath = chengpath.PathJoin(
        workspaceRoot, "legacy/main.cheng")
    let request = creq.CompilerRequestNew(
        workspaceRoot,
        currentSourcePath,
        outputPath,
        "x86_64-unknown-linux-gnu",
        creq.EmitExe,
        "")
    var plan: slplan.SystemLinkPlanStub
    var err = ""
    if !slplan.BuildSystemLinkPlanStub(
            workspaceRoot, request, plan, err):
        return Err[bool](err)
    if plan.sourceBundleEntrySourceIndex < 0 ||
       plan.sourceBundleEntrySourceIndex >= plan.ownerModulePaths.len:
        return Err[bool]("CID evidence: authenticated entry index")
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(plan)
    if IsErr(sourceBundleRes):
        return Err[bool](Error(sourceBundleRes))
    var currentSourceReceipt: ccsg.PortableSourceIdentityReceipt
    if !ccsg.PortableSourceIdentityReceiptMakeInto(
            plan.sourceClosurePaths.len,
            plan.importEdges.len,
            plan.unresolvedImportCount,
            plan.packageId,
            plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
            plan.sourceBundleCidValue,
            plan.sourceBundleEntrySourceCid,
            plan.sourceBundleImportGraphCid,
            currentSourceReceipt,
            err):
        return Err[bool](err)
    if !layout.FixedBytes32Equal(
            Value(sourceBundleRes), currentSourceReceipt.sourceBundleCid):
        return Err[bool](
            "CID evidence: authenticated current source bundle receipt")
    var providers: str[]
    if !sexec.SystemLinkExecCanonicalProviderSetInto(
            plan.providerModules, providers, err):
        return Err[bool](err)
    let symbolVisibility = strings.CloneStr(plan.symbolVisibility)
    let packageId = strings.CloneStr(plan.packageId)
    let entryModulePath = strings.CloneStr(
        plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex])
    var currentCsg: ccsg.CompilerCsg
    var currentPlan = plan
    if !ccsg.BuildCompilerCsgConsumePortableReceiptInto(
            currentCsg, err, currentPlan, currentSourceReceipt):
        return Err[bool](err)
    var migration: ccsg.CompilerLegacyMigration
    let migrationRes = ccsg.BuildCompilerLegacyMigrationInto(
        strings.CloneStr(workspaceRoot),
        strings.CloneStr(workspaceRoot),
        strings.CloneStr(legacySourcePath),
        packageId,
        entryModulePath,
        migration)
    if IsErr(migrationRes):
        return Err[bool](Error(migrationRes))
    if migration.units.len != 1 || migration.unitCount != 1:
        return Err[bool](
            "CID evidence: authenticated migration unit count")
    let currentReadRes = os.ReadFileResult(currentSourcePath)
    let legacyReadRes = os.ReadFileResult(legacySourcePath)
    if IsErr(currentReadRes):
        return Err[bool](Error(currentReadRes))
    if IsErr(legacyReadRes):
        return Err[bool](Error(legacyReadRes))
    let currentText = Value(currentReadRes)
    let legacyText = Value(legacyReadRes)
    if migration.units[0].migratedText != currentText:
        return Err[bool](
            "CID evidence: authenticated migration text fixed point")
    if !ceq.CompilerMigrationSourceReceiptEqual(
            currentCsg.sourceIdentityReceipt,
            migration.migratedArtifact.sourceIdentityReceipt):
        return Err[bool](CidEvidenceJoin([
            "CID evidence: authenticated migration source receipt fixed point field=",
            strings.CloneStr(ceq.CompilerMigrationSourceReceiptMismatchField(
                migration.migratedArtifact.sourceIdentityReceipt,
                currentCsg.sourceIdentityReceipt)),
            " migrated=",
            IntToStr(migration.migratedArtifact.sourceIdentityReceipt.sourceSnapshotCount),
            " current=",
            IntToStr(currentCsg.sourceIdentityReceipt.sourceSnapshotCount)]))
    if !layout.FixedBytes32Equal(
            currentCsg.canonicalGraphCid,
            migration.migratedArtifact.canonicalGraphCid):
        return Err[bool](
            "CID evidence: authenticated migration canonical graph fixed point")
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceMake(
        migration, evidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    var baselineSemantic: sexec.CompileSemanticReceipt
    var migratedSemantic: sexec.CompileSemanticReceipt
    CidEvidenceSortTexts(providers)
    let canonicalOutputDigest = sexec.SystemLinkExecCanonicalOutputDigest(
        creq.EmitExe,
        symbolVisibility,
        request.targetTriple,
        providers,
        currentCsg.canonicalGraphCid)
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.baselineArtifact.sourceIdentityReceipt,
            migration.baselineArtifact.canonicalGraphCid,
            canonicalOutputDigest,
            request.targetTriple,
            "stage3_local",
            providers,
            baselineSemantic,
            err):
        return Err[bool](err)
    if !sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
            migration.migratedArtifact.sourceIdentityReceipt,
            migration.migratedArtifact.canonicalGraphCid,
            canonicalOutputDigest,
            request.targetTriple,
            "stage3_local",
            providers,
            migratedSemantic,
            err):
        return Err[bool](err)
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofMake(
        strings.CloneStr(packageId),
        "stable",
        evidence,
        migration.baselineArtifact.canonicalGraphCid,
        migration.migratedArtifact.canonicalGraphCid,
        migration.baselineArtifact.exportSurface,
        migration.migratedArtifact.exportSurface,
        baselineSemantic,
        migratedSemantic,
        request.targetTriple,
        proof)
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    if !ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence):
        return Err[bool](CidEvidenceJoin([
            "CID evidence: authenticated stable proof failed graph=",
            IntToStr(proof.graphEquivalent),
            " surface=",
            IntToStr(proof.exportSurfaceCompatible),
            " semantic=",
            IntToStr(proof.semanticEquivalent)]))
    out.currentCsg = currentCsg
    out.migration = migration
    out.evidence = evidence
    out.proof = proof
    out.baselineSemantic = baselineSemantic
    out.migratedSemantic = migratedSemantic
    out.currentText = currentText
    out.legacyText = legacyText
    out.entryModulePath = entryModulePath
    return Ok[bool](true)

fn CidEvidenceReleaseAuthenticatedMigration(
        build: var CidEvidenceAuthenticatedMigration) =
    ccsg.CompilerCsgReleaseBackendInputPayload(build.currentCsg)

@borrows
fn CidEvidenceMirrorMigrationStage(
        caseRoot: str,
        artifactRoot: str,
        compiledOutput: str): Result[bool] =
    var rootA: CidEvidenceAuthenticatedMigration
    let rootARes = CidEvidenceBuildAuthenticatedMigration(
        caseRoot, compiledOutput, rootA)
    if IsErr(rootARes):
        return Err[bool](Error(rootARes))
    let rootAReports = CidEvidenceAuthenticatedMigrationReports(rootA)
    let rootBWorkspace = CidEvidenceJoin([strings.CloneStr(caseRoot), "-root-b"])
    CidEvidencePrepareMigrationRootForPackage(
        rootBWorkspace,
        "cheng/compiler",
        rootA.currentText,
        rootA.legacyText)
    var rootB: CidEvidenceAuthenticatedMigration
    let rootBRes = CidEvidenceBuildAuthenticatedMigration(
        rootBWorkspace,
        chengpath.PathJoin(rootBWorkspace, "mirror-output"),
        rootB)
    if IsErr(rootBRes):
        return Err[bool](Error(rootBRes))
    let rootBReports = CidEvidenceAuthenticatedMigrationReports(rootB)
    if rootA.entryModulePath != rootB.entryModulePath ||
       rootAReports.len != rootBReports.len:
        return Err[bool](
            "CID evidence: mirror cross-root identity drift")
    for reportIndex in 0..<rootAReports.len:
        if rootAReports[reportIndex] != rootBReports[reportIndex]:
            return Err[bool](
                "CID evidence: mirror cross-root migration bytes")
    let roles = CidEvidenceMigrationCoreRoles()
    if roles.len != rootAReports.len:
        return Err[bool]("CID evidence: mirror migration role count")
    for roleIndex in 0..<roles.len:
        CidEvidenceWrite(
            artifactRoot,
            CidEvidenceArtifactRelativePath(
                strings.CloneStr(roles[roleIndex])),
            strings.CloneStr(rootAReports[roleIndex]))
        CidEvidenceWrite(
            artifactRoot,
            CidEvidenceArtifactRelativePath(
                strings.ConcatStr("root_b_", strings.CloneStr(roles[roleIndex]))),
            strings.CloneStr(rootBReports[roleIndex]))
    CidEvidenceReleaseAuthenticatedMigration(rootB)
    CidEvidenceReleaseAuthenticatedMigration(rootA)
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var caseRoot = ""
    if cmdline.hasFlag("--prepare-case"):
        if !cmdline.readFlagValue("--case", caseId) ||
           !cmdline.readFlagValue("--case-root", caseRoot) ||
           caseId == "" || caseRoot == "":
            os.WriteLine(os.Get_stderr(),
                         "CID evidence: missing prepare flag")
            return 2
        if !CidEvidencePrepareCase(caseId, caseRoot):
            os.WriteLine(os.Get_stderr(),
                         "CID evidence: unknown prepare case")
            return 2
        return 0
    var artifactRoot = ""
    var compiledOutput = ""
    var evidencePrefix = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--case-root", caseRoot) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--compiled-output", compiledOutput) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix) ||
       caseId != "mirror-atomic-install" || caseRoot == "" ||
       artifactRoot == "" || compiledOutput == "" ||
       evidencePrefix == "":
        os.WriteLine(os.Get_stderr(),
                     "CID evidence: invalid mirror migration flags")
        return 2
    let result = CidEvidenceMirrorMigrationStage(
        caseRoot, artifactRoot, compiledOutput)
    if IsErr(result):
        os.WriteLine(os.Get_stderr(), Error(result))
        return 1
    return 0
