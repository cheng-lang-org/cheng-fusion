import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/validator

const
    Cid1: str = "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    Cid2: str = "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    Cid3: str = "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    Cid4: str = "sha256:4444444444444444444444444444444444444444444444444444444444444444"
    Cid5: str = "sha256:5555555555555555555555555555555555555555555555555555555555555555"
    Cid6: str = "sha256:6666666666666666666666666666666666666666666666666666666666666666"
    Cid7: str = "sha256:7777777777777777777777777777777777777777777777777777777777777777"
    Cid8: str = "sha256:8888888888888888888888888888888888888888888888888888888888888888"
    Cid9: str = "sha256:9999999999999999999999999999999999999999999999999999999999999999"
    CidA: str = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn replaceOnce(text: str, needle: str, replacement: str): str =
    if needle.len == 0 || needle.len > text.len:
        return ""
    var at: int32 = -1
    for i in 0..<(text.len - needle.len + 1):
        var matches = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matches = false
                break
        if matches:
            at = i
            break
    if at < 0:
        return ""
    let prefix = strings.SliceBytes(text, 0, at)
    let suffix =
        strings.SliceBytes(
            text,
            at + needle.len,
            text.len - at - needle.len)
    return strings.ConcatStr(
        strings.ConcatStr(prefix, replacement),
        suffix)

@borrows
fn subgraphFor(count: int32, dagRootCid: str): str =
    var error: str
    let root =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            count, dagRootCid, error)
    if error.len > 0:
        return strings.ConcatStr(
            "invalid:", error)
    return root

fn setPartitionSubgraphCid(
        partitions: var merkle_manifest.CsgCoreMerklePartitionRecord[],
        index: int32,
        value: str) =
    partitions[index].factsRoot =
        strings.CloneStr(value)

@borrows
fn descriptor(
        shardKey: str,
        cid: str,
        root: str,
        entryCount: int32):
        merkle_manifest.CsgCoreMerkleShardDescriptor =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(shardKey)
    out.cid = strings.CloneStr(cid)
    out.root = strings.CloneStr(root)
    out.entryCount = entryCount
    return out

fn bucketName(bucket: int32): str =
    let digits = "0123456789abcdef"
    return strings.ConcatStr(
        strings.CloneStrRange(
            digits, bucket / 16, 1),
        strings.CloneStrRange(
            digits, bucket % 16, 1))

@borrows
fn partition(
        sourceId: str,
        sourceCid: str,
        factKind: str,
        factsCid: str,
        subgraphCid: str,
        dagRootCid: str,
        membershipCid: str,
        factCount: int32):
        merkle_manifest.CsgCoreMerklePartitionRecord =
    var out: merkle_manifest.CsgCoreMerklePartitionRecord
    out.sourceId = strings.CloneStr(sourceId)
    out.sourceCid = strings.CloneStr(sourceCid)
    out.factKind = strings.CloneStr(factKind)
    out.factsCid = strings.CloneStr(factsCid)
    out.factsRoot = strings.CloneStr(subgraphCid)
    out.dagRootCid = strings.CloneStr(dagRootCid)
    out.membershipCid =
        strings.CloneStr(membershipCid)
    out.factCount = factCount
    return out

@borrows
fn manifest(
        factsRoot: str,
        dagRootCid: str,
        reverse: bool):
        merkle_manifest.CsgCoreMerkleManifest =
    var out: merkle_manifest.CsgCoreMerkleManifest
    out.standard = validator.CsgCoreStandardIdentity()
    out.profiles = [validator.CsgCoreBaseProfileIdentity()]
    out.profileSetCid =
        validator.CsgCoreProfileSetCid(out.profiles)
    out.complete = true
    out.csgcDirectoryCid = Cid3
    out.csgcObjectCid = Cid4
    out.csgcByteCount = 64
    out.schemaCid = CidA
    out.factsRoot = strings.CloneStr(factsRoot)
    out.dagRootCid = strings.CloneStr(dagRootCid)
    out.factCount = 4
    out.nodeCount = 7
    let first = partition(
        "source:A",
        Cid1,
        "csg.core.schema",
        Cid2,
        subgraphFor(2, Cid4),
        Cid4,
        Cid5,
        2)
    let second = partition(
        "source:B",
        Cid2,
        "csg.symbol",
        Cid3,
        subgraphFor(2, Cid5),
        Cid5,
        Cid6,
        2)
    if reverse:
        add(out.partitions, second)
        add(out.partitions, first)
    else:
        add(out.partitions, first)
        add(out.partitions, second)
    out.partitionRoot =
        merkle_manifest.CsgCoreMerklePartitionRoot(
            out.partitions)
    add(
        out.dependencyConsumerShards,
        descriptor("source:A", Cid6, Cid7, 2))
    add(
        out.dependencyConsumerShards,
        descriptor("source:B", Cid7, Cid8, 2))
    out.dependencyConsumerRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
            out.dependencyConsumerShards)
    add(
        out.dependencyProviderShards,
        descriptor("source:A", Cid8, Cid9, 2))
    add(
        out.dependencyProviderShards,
        descriptor("source:B", Cid9, CidA, 2))
    out.dependencyProviderRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyProviderShardKind(),
            out.dependencyProviderShards)
    out.dependencyCount = 4
    for bucket in 0..<256:
        add(
            out.queryShards,
            descriptor(bucketName(bucket), Cid9, CidA, 0))
    out.queryShardRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleQueryShardKind(),
            out.queryShards)
    out.queryIndexCount = 0
    out.summaryCid = Cid8
    return out

fn main(): int32 =
    if merkle_manifest.CsgCoreMerkleExpectedNodeCount(-1) != -1 ||
       merkle_manifest.CsgCoreMerkleExpectedNodeCount(0) != 0 ||
       merkle_manifest.CsgCoreMerkleExpectedNodeCount(1) != 1 ||
       merkle_manifest.CsgCoreMerkleExpectedNodeCount(
           1073741824) != 2147483647 ||
       merkle_manifest.CsgCoreMerkleExpectedNodeCount(
           1073741825) != -1:
        return fail("manifest node count overflow gate failed")
    os.WriteLine(os.Get_stderr(), "m1_gate")
    let schema = "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleA = "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let symbolA = "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let symbolB = "{\"id\":\"sym_b\",\"kind\":\"csg.symbol\",\"name\":\"B\",\"symbolKind\":\"fn\"}"
    let unboundDag = merkle_dag.CsgCoreMerkleBuild(
        [
            strings.CloneStr(schema),
            strings.CloneStr(moduleA),
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB)])
    if !unboundDag.ok ||
       unboundDag.factsRoot.len != 0:
        return fail("manifest fixture DAG failed")
    os.WriteLine(os.Get_stderr(), "m2_unbound")
    let dag = merkle_dag.CsgCoreMerkleBuildBound(
        [
            strings.CloneStr(schema),
            strings.CloneStr(moduleA),
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB)],
        "csg_core::v1",
        ["csg_core"],
        "csg_core::v1",
        CidA)
    let repeatedDag = merkle_dag.CsgCoreMerkleBuildBound(
        [
            strings.CloneStr(schema),
            strings.CloneStr(moduleA),
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB)],
        "csg_core::v1",
        ["csg_core"],
        "csg_core::v1",
        CidA)
    let webBoundDag = merkle_dag.CsgCoreMerkleBuildBound(
        [
            strings.CloneStr(schema),
            strings.CloneStr(moduleA),
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB)],
        "csg_core::v1",
        ["csg_core", "csg_dialect::web"],
        "csg_core::v1",
        CidA)
    if !dag.ok || !repeatedDag.ok || !webBoundDag.ok ||
       dag.factsRoot.len == 0 ||
       dag.factsRoot != repeatedDag.factsRoot ||
       dag.factsRoot == webBoundDag.factsRoot ||
       dag.dagRootCid != unboundDag.dagRootCid ||
       dag.dagRootCid != webBoundDag.dagRootCid ||
       dag.subgraphCid != unboundDag.subgraphCid:
        return fail("manifest profile-set root binding failed")

    os.WriteLine(os.Get_stderr(), "m3_bounddags")
    let currentProfileSetCid =
        validator.CsgCoreProfileSetCid(["csg_core"])
    let differentStandardProfileSetCid =
        validator.CsgCoreProfileSetCidForIdentity(
            "csg_core::different-standard",
            validator.CsgCoreSchemaNamespaceIdentity(),
            ["csg_core"])
    let differentNamespaceProfileSetCid =
        validator.CsgCoreProfileSetCidForIdentity(
            validator.CsgCoreStandardIdentity(),
            "csg_core::different-schema-namespace",
            ["csg_core"])
    if currentProfileSetCid.len != 71 ||
       differentStandardProfileSetCid.len != 71 ||
       differentNamespaceProfileSetCid.len != 71 ||
       currentProfileSetCid == differentStandardProfileSetCid ||
       currentProfileSetCid == differentNamespaceProfileSetCid:
        return fail(
            "profile_set_cid standard identity domain separation failed")

    os.WriteLine(os.Get_stderr(), "m4_profilecids")
    let firstManifest =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    os.WriteLine(os.Get_stderr(), "m5_manifest")
    let partitionDag =
        merkle_dag.CsgCoreMerkleBuild(
            [
                merkle_manifest.CsgCoreMerklePartitionLine(
                    firstManifest.partitions[0]),
                merkle_manifest.CsgCoreMerklePartitionLine(
                    firstManifest.partitions[1])
            ])
    if !partitionDag.ok ||
       firstManifest.partitionRoot !=
           partitionDag.subgraphCid:
        return fail(
            "manifest partition root is not subgraph cid")
    os.WriteLine(os.Get_stderr(), "m6_partition")
    let consumerDescriptorDag =
        merkle_dag.CsgCoreMerkleBuild(
            [
                merkle_manifest.CsgCoreMerkleShardDescriptorLine(
                    merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
                    firstManifest.dependencyConsumerShards[0]),
                merkle_manifest.CsgCoreMerkleShardDescriptorLine(
                    merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
                    firstManifest.dependencyConsumerShards[1])
            ])
    if !consumerDescriptorDag.ok ||
       firstManifest.dependencyConsumerRoot !=
           consumerDescriptorDag.subgraphCid:
        return fail(
            "manifest descriptor root is not subgraph cid")
    os.WriteLine(os.Get_stderr(), "m7_descriptor")
    var encoded =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            firstManifest)
    if !encoded.ok:
        return fail(strings.ConcatStr(
            strings.ConcatStr(
                "manifest encode failed: ",
                encoded.error),
            strings.ConcatStr(
                " cid=", encoded.cid)))
    os.WriteLine(os.Get_stderr(), "m8_encoded")
    let decoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            encoded.bytes)
    if !decoded.ok ||
       decoded.cid != encoded.cid ||
       decoded.manifest.standard !=
           validator.CsgCoreStandardIdentity() ||
       !validator.CsgCoreProfilesEqual(
           decoded.manifest.profiles,
           firstManifest.profiles) ||
       decoded.manifest.profileSetCid !=
           firstManifest.profileSetCid ||
       decoded.manifest.csgcDirectoryCid !=
           firstManifest.csgcDirectoryCid ||
       decoded.manifest.factsRoot !=
           dag.factsRoot ||
       decoded.manifest.factCount != 4 ||
       decoded.manifest.partitions.len != 2 ||
       decoded.manifest.nodeCount != 7:
        return fail(strings.ConcatStr(
            "manifest decode failed: ",
            decoded.error))

    let directoryField =
        strings.ConcatStr(
            "\"csgc_directory_cid\":\"",
            strings.ConcatStr(
                firstManifest.csgcDirectoryCid,
                "\""))
    var missingDirectoryLines: str[]
    var missingDirectoryFound = false
    var oldDirectoryLines: str[]
    var oldDirectoryFound = false
    var duplicateDirectoryLines: str[]
    var duplicateDirectoryFound = false
    for i in 0..<encoded.lines.len:
        let missingLine = replaceOnce(
            encoded.lines[i],
            strings.ConcatStr(",", directoryField),
            "")
        if missingLine.len > 0:
            add(missingDirectoryLines, missingLine)
            missingDirectoryFound = true
        else:
            add(
                missingDirectoryLines,
                strings.CloneStr(encoded.lines[i]))
        # The strict CSGC encoder rejects non-canonical key order, so
        # the legacy-name negative uses the order-preserving unknown
        # key "csgc_dir_cid" (sorts between csgc_byte_count and
        # csgc_object_cid); decode rejects it through the same
        # exact-name lookup of csgc_directory_cid.
        let oldLine = replaceOnce(
            encoded.lines[i],
            "csgc_directory_cid",
            "csgc_dir_cid")
        if oldLine.len > 0:
            add(oldDirectoryLines, oldLine)
            oldDirectoryFound = true
        else:
            add(
                oldDirectoryLines,
                strings.CloneStr(encoded.lines[i]))
        let duplicateLine = replaceOnce(
            encoded.lines[i],
            directoryField,
            strings.ConcatStr(
                directoryField,
                strings.ConcatStr(",", directoryField)))
        if duplicateLine.len > 0:
            add(duplicateDirectoryLines, duplicateLine)
            duplicateDirectoryFound = true
        else:
            add(
                duplicateDirectoryLines,
                strings.CloneStr(encoded.lines[i]))
    if !missingDirectoryFound || !oldDirectoryFound ||
       !duplicateDirectoryFound:
        return fail("directory CID negative fixtures were not built")
    var missingDirectoryEncoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            missingDirectoryLines)
    var oldDirectoryEncoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            oldDirectoryLines)
    var duplicateDirectoryEncoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            duplicateDirectoryLines)
    if !missingDirectoryEncoded.ok ||
       !oldDirectoryEncoded.ok:
        return fail("directory CID negative CSGC encode failed")
    if duplicateDirectoryEncoded.ok:
        rawbytes.BytesFree(duplicateDirectoryEncoded.bytes)
        return fail("duplicate directory field encoded")
    let missingDirectoryDecoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            missingDirectoryEncoded.bytes)
    let oldDirectoryDecoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            oldDirectoryEncoded.bytes)
    rawbytes.BytesFree(missingDirectoryEncoded.bytes)
    rawbytes.BytesFree(oldDirectoryEncoded.bytes)
    if missingDirectoryDecoded.ok ||
       oldDirectoryDecoded.ok:
        return fail(
            "missing, old, or duplicate directory CID accepted")

    var invalidDirectory =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    invalidDirectory.csgcDirectoryCid = "sha256:invalid"
    let invalidDirectoryResult =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            invalidDirectory)
    if invalidDirectoryResult.ok ||
       invalidDirectoryResult.error !=
           "merkle_manifest_cid_invalid":
        return fail("invalid directory CID accepted")

    let profileFields =
        strings.ConcatStr(
            strings.ConcatStr(
                "\"profile_set_cid\":\"",
                firstManifest.profileSetCid),
            "\",\"profiles\":[\"csg_core\"]")
    var legacyLines: str[]
    var legacyHeaderFound = false
    for i in 0..<encoded.lines.len:
        let legacyLine = replaceOnce(
            encoded.lines[i],
            profileFields,
            "\"profile\":\"csg_core\"")
        if legacyLine.len > 0:
            add(legacyLines, legacyLine)
            legacyHeaderFound = true
        else:
            add(
                legacyLines,
                strings.CloneStr(encoded.lines[i]))
    if !legacyHeaderFound:
        return fail("legacy profile fixture was not built")
    var legacyEncoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            legacyLines)
    if !legacyEncoded.ok:
        return fail("legacy profile CSGC fixture failed")
    let legacyDecoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            legacyEncoded.bytes)
    rawbytes.BytesFree(legacyEncoded.bytes)
    if legacyDecoded.ok ||
       legacyDecoded.error !=
           "merkle_manifest_header_field_missing":
        return fail("legacy single profile manifest accepted")

    let hybridProfileFields =
        strings.ConcatStr(
            "\"profile\":\"csg_core\",",
            profileFields)
    var hybridLines: str[]
    var hybridHeaderFound = false
    for i in 0..<encoded.lines.len:
        let hybridLine = replaceOnce(
            encoded.lines[i],
            profileFields,
            hybridProfileFields)
        if hybridLine.len > 0:
            add(hybridLines, hybridLine)
            hybridHeaderFound = true
        else:
            add(
                hybridLines,
                strings.CloneStr(encoded.lines[i]))
    if !hybridHeaderFound:
        return fail("hybrid profile fixture was not built")
    var hybridEncoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            hybridLines)
    if !hybridEncoded.ok:
        return fail("hybrid profile CSGC fixture failed")
    let hybridDecoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            hybridEncoded.bytes)
    rawbytes.BytesFree(hybridEncoded.bytes)
    if hybridDecoded.ok ||
       hybridDecoded.error !=
           "merkle_manifest_header_non_canonical":
        return fail("hybrid legacy profile manifest accepted")

    let reversedManifest =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            true)
    var reversed =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            reversedManifest)
    if !reversed.ok ||
       reversed.cid != encoded.cid ||
       !rawbytes.BytesEqual(
           reversed.bytes, encoded.bytes):
        return fail("manifest order changed bytes")
    if reversed.lines.len != encoded.lines.len:
        return fail(
            "manifest canonical line count changed")
    for i in 0..<encoded.lines.len:
        if reversed.lines[i] != encoded.lines[i]:
            return fail(
                "manifest canonical lines changed")

    var badRootManifest =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    badRootManifest.partitionRoot = Cid1
    let badRoot =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badRootManifest)
    if badRoot.ok ||
       badRoot.error !=
           "merkle_manifest_partition_root_mismatch":
        return fail("bad manifest partition root accepted")

    var badFactsRoot =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    badFactsRoot.factsRoot = Cid1
    let badFacts =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badFactsRoot)
    if badFacts.ok ||
       badFacts.error !=
           "merkle_manifest_facts_root_mismatch":
        return fail("bad manifest facts root accepted")

    var badProfile =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    badProfile.profiles =
        ["csg_core", "csg_dialect::web"]
    badProfile.profileSetCid =
        validator.CsgCoreProfileSetCid(
            badProfile.profiles)
    let badProfileResult =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badProfile)
    if badProfileResult.ok ||
       badProfileResult.error !=
           "merkle_manifest_facts_root_mismatch":
        return fail(
            "context-unbound profile accepted")

    var missingProfiles =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    missingProfiles.profiles = []
    missingProfiles.profileSetCid = ""
    let missingProfilesResult =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            missingProfiles)
    if missingProfilesResult.ok ||
       missingProfilesResult.error !=
           "merkle_manifest_profiles csg_profiles_empty":
        return fail("missing profiles accepted")

    var duplicateProfiles =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    duplicateProfiles.profiles =
        ["csg_core", "csg_core"]
    duplicateProfiles.profileSetCid =
        validator.CsgCoreProfileSetCid(
            duplicateProfiles.profiles)
    let duplicateProfilesResult =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            duplicateProfiles)
    if duplicateProfilesResult.ok ||
       duplicateProfilesResult.error !=
           "merkle_manifest_profiles csg_profiles_noncanonical":
        return fail("duplicate profiles accepted")

    var unorderedProfiles =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    unorderedProfiles.profiles =
        [
            "csg_core",
            "csg_dialect::web",
            "csg_dialect::vexa"
        ]
    unorderedProfiles.profileSetCid =
        validator.CsgCoreProfileSetCid(
            unorderedProfiles.profiles)
    let unorderedProfilesResult =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            unorderedProfiles)
    if unorderedProfilesResult.ok ||
       unorderedProfilesResult.error !=
           "merkle_manifest_profiles csg_profiles_noncanonical":
        return fail("unordered profiles accepted")

    var tamperedProfileSetCid =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    tamperedProfileSetCid.profileSetCid = Cid1
    let tamperedProfileSetCidResult =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            tamperedProfileSetCid)
    if tamperedProfileSetCidResult.ok ||
       tamperedProfileSetCidResult.error !=
           "merkle_manifest_profile_set_cid_mismatch":
        return fail("tampered profile set cid accepted")

    var badSchema =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    badSchema.schemaCid = Cid9
    let badSchemaResult =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badSchema)
    if badSchemaResult.ok ||
       badSchemaResult.error !=
           "merkle_manifest_facts_root_mismatch":
        return fail(
            "context-unbound schema cid accepted")

    var badDagRoot =
        manifest(
            dag.factsRoot,
            Cid1,
            false)
    let badDagRootResult =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badDagRoot)
    if badDagRootResult.ok ||
       badDagRootResult.error !=
           "merkle_manifest_facts_root_mismatch":
        return fail(
            "context-unbound dag root accepted")

    var badNodeCount =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    badNodeCount.nodeCount = 6
    let badNode =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badNodeCount)
    if badNode.ok ||
       badNode.error !=
           "merkle_manifest_node_count_mismatch":
        return fail("bad node count accepted")

    var badPartitionFacts =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    setPartitionSubgraphCid(
        badPartitionFacts.partitions, 0, Cid1)
    if badPartitionFacts.partitions[0].factsRoot !=
       Cid1:
        return fail("partition mutation did not land")
    badPartitionFacts.partitionRoot =
        merkle_manifest.CsgCoreMerklePartitionRoot(
            badPartitionFacts.partitions)
    let badPartition =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badPartitionFacts)
    if badPartition.ok ||
       badPartition.error !=
           "merkle_manifest_partition_subgraph_cid_mismatch":
        return fail(
            "bad partition subgraph cid accepted")

    var badQueryShardCount =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    badQueryShardCount.queryShards[5].shardKey =
        strings.CloneStr(
            badQueryShardCount.queryShards[4].shardKey)
    badQueryShardCount.queryShardRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleQueryShardKind(),
            badQueryShardCount.queryShards)
    let badQueryCount =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badQueryShardCount)
    if badQueryCount.ok ||
       badQueryCount.error !=
           "merkle_manifest_cid_invalid":
        return fail("bad query shard count accepted")

    var badQueryBucket =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    badQueryBucket.queryShards[0].shardKey = "zz"
    badQueryBucket.queryShardRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleQueryShardKind(),
            badQueryBucket.queryShards)
    let badBucket =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badQueryBucket)
    if badBucket.ok ||
       badBucket.error !=
           "merkle_manifest_query_shard_bucket_invalid":
        return fail("bad query shard bucket accepted")

    var badDependencyProjection =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    badDependencyProjection.dependencyProviderShards[
        0].entryCount = 1
    badDependencyProjection.dependencyProviderRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyProviderShardKind(),
            badDependencyProjection.dependencyProviderShards)
    let badProjection =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            badDependencyProjection)
    if badProjection.ok ||
       badProjection.error !=
           "merkle_manifest_dependency_projection_count_mismatch":
        return fail("bad dependency projection count accepted")

    var incomplete =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    incomplete.complete = false
    if merkle_manifest.CsgCoreMerkleManifestEncode(
           incomplete).ok:
        return fail("incomplete manifest accepted")

    var unsupported =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    unsupported.unsupportedCount = 1
    if merkle_manifest.CsgCoreMerkleManifestEncode(
           unsupported).ok:
        return fail("unsupported manifest accepted")

    var tombstone =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    tombstone.tombstoneCount = 1
    if merkle_manifest.CsgCoreMerkleManifestEncode(
           tombstone).ok:
        return fail("tombstone manifest accepted")

    var runtimeRequirement =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    runtimeRequirement.runtimeRequirementCount = 1
    if merkle_manifest.CsgCoreMerkleManifestEncode(
           runtimeRequirement).ok:
        return fail(
            "runtime requirement manifest accepted")

    var tampered =
        rawbytes.BytesAlloc(
            rawbytes.BytesLen(encoded.bytes))
    rawbytes.BytesCopyInto(
        tampered, 0, encoded.bytes)
    let last = rawbytes.BytesLen(tampered) - 1
    rawbytes.BytesSet(
        tampered,
        last,
        rawbytes.BytesGet(tampered, last) ^ 1)
    let tamperedDecoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            tampered)
    rawbytes.BytesFree(tampered)
    if tamperedDecoded.ok:
        return fail("tampered manifest accepted")

    os.WriteLine(os.Get_stdout(), encoded.cid)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_manifest_smoke ok")
    rawbytes.BytesFree(reversed.bytes)
    rawbytes.BytesFree(encoded.bytes)
    return 0
