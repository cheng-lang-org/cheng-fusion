import std/cmdline
import std/os
import std/rawbytes
import std/result
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/data_edit
import cheng/core/csg_core/merkle_cargo
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/validator

const
    QueryKey: str = "id:mod_a"
    ModuleFact: str =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    ReplacedModuleFact: str =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a2.cheng\",\"sha256\":\"sha256:bbb\"}"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn cloneBytes(bytes: rawbytes.Bytes): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(bytes))
    rawbytes.BytesCopyInto(out, 0, bytes)
    return out

@borrows
fn writeBytes(path: str, bytes: rawbytes.Bytes): bool =
    var owned = cloneBytes(bytes)
    var written = os.WriteFileBytesResult(path, owned)
    return result.IsOk(written)

fn main(): int32 =
    if cmdline.ParamCount() != 7:
        return fail(
            "usage: csg_core_pure_cli_kernel_fixture INPUT.csgc UNPACKED.jsonl EDITED.csgc PROOF.csgc ROOT.txt RECEIPT.json")
    let inputPath = cmdline.ParamStr(1)
    let unpackedPath = cmdline.ParamStr(2)
    let editedPath = cmdline.ParamStr(3)
    let proofPath = cmdline.ParamStr(4)
    let rootPath = cmdline.ParamStr(5)
    let receiptPath = cmdline.ParamStr(6)

    var inputRead = os.ReadFileBytesResult(inputPath)
    if result.IsErr(inputRead):
        return fail("kernel fixture input read failed")
    var inputBytes = result.Value(inputRead)

    let decoded = csgc.CsgCoreCsgcDecodeLines(inputBytes)
    if !decoded.ok:
        return fail(strings.ConcatStr(
            "kernel fixture decode failed: ", decoded.error))
    var repackedA =
        csgc.CsgCoreCsgcEncodeCanonicalLines(decoded.lines)
    var repackedB =
        csgc.CsgCoreCsgcEncodeCanonicalLines(decoded.lines)
    if !repackedA.ok || !repackedB.ok ||
       !rawbytes.BytesEqual(inputBytes, repackedA.bytes) ||
       !rawbytes.BytesEqual(repackedA.bytes, repackedB.bytes):
        return fail("kernel fixture unpack/repack bytes changed")

    let admission =
        validator.CsgCoreProductionAdmitFactLines(
            decoded.lines)
    if !admission.valid || !admission.complete ||
       admission.unsupportedCount != 0 ||
       admission.tombstoneCount != 0:
        return fail("kernel fixture production admission failed")
    let dag =
        validator.CsgCoreMerkleBuildBoundFromCanonicalLines(
            decoded.lines)
    if !dag.ok || dag.factsRoot != admission.factsRoot:
        return fail("kernel fixture facts_root mismatch")

    let proof =
        merkle_dag.CsgCoreMerkleProveKey(dag, QueryKey)
    let verified = merkle_dag.CsgCoreMerkleVerifyFact(
        proof, dag.factsRoot, ModuleFact)
    if !proof.ok || !verified.ok || !verified.exists:
        return fail("kernel fixture proof verification failed")
    var proofCargoA =
        merkle_cargo.CsgCoreMerkleProofEncodeCsgc(
            proof, dag.factsRoot)
    var proofCargoB =
        merkle_cargo.CsgCoreMerkleProofEncodeCsgc(
            proof, dag.factsRoot)
    if !proofCargoA.ok || !proofCargoB.ok ||
       proofCargoA.cid != proofCargoB.cid ||
       !rawbytes.BytesEqual(
           proofCargoA.bytes, proofCargoB.bytes):
        return fail("kernel fixture proof bytes changed")
    let decodedProof =
        merkle_cargo.CsgCoreMerkleProofDecodeCsgc(
            proofCargoA.bytes, dag.factsRoot)
    let decodedVerified =
        merkle_dag.CsgCoreMerkleVerifyFact(
            decodedProof.proof,
            dag.factsRoot,
            ModuleFact)
    if !decodedProof.ok || !decodedVerified.ok ||
       !decodedVerified.exists ||
       decodedProof.cid != proofCargoA.cid:
        return fail("kernel fixture proof readback failed")

    let replay = merkle_dag.CsgCoreMerkleReplayReplace(
        proof, dag.factsRoot, ReplacedModuleFact)
    var operations: data_edit.CsgDataEditOperation[]
    add(
        operations,
        data_edit.CsgDataEditReplaceById(
            "mod_a", ReplacedModuleFact))
    var edited = data_edit.CsgDataEditApplyCsgcBytes(
        inputBytes, operations)
    if !replay.ok || !edited.ok ||
       edited.beforeRoot != replay.beforeFactsRoot ||
       edited.afterRoot != replay.afterFactsRoot ||
       edited.beforeRoot != dag.factsRoot:
        return fail("kernel fixture edit/replay mismatch")
    let editedDecoded =
        csgc.CsgCoreCsgcDecodeLines(edited.bytes)
    var editedRepacked =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            editedDecoded.lines)
    if !editedDecoded.ok || !editedRepacked.ok ||
       !rawbytes.BytesEqual(
           edited.bytes, editedRepacked.bytes):
        return fail("kernel fixture edited CSGC non-canonical")

    let unpackedText =
        data_edit.CsgDataEditLinesText(decoded.lines)
    var unpackedWrite =
        os.WriteFileResult(unpackedPath, unpackedText)
    if result.IsErr(unpackedWrite) ||
       !writeBytes(editedPath, edited.bytes) ||
       !writeBytes(proofPath, proofCargoA.bytes):
        return fail("kernel fixture artifact write failed")
    var rootWrite = os.WriteFileResult(
        rootPath,
        strings.ConcatStr(dag.factsRoot, "\n"))
    if result.IsErr(rootWrite):
        return fail("kernel fixture root write failed")
    var receiptWrite =
        os.WriteFileResult(receiptPath, edited.receipt)
    if result.IsErr(receiptWrite):
        return fail("kernel fixture receipt write failed")

    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "facts_root=", dag.factsRoot))
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "proof_cid=", proofCargoA.cid))
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "after_root=", replay.afterFactsRoot))
    return 0
