# Runtime verification for WebSceneMediaEsSeekToFrame added to
# web_scene_media_network_bridge.cheng (S2 of docs/video-seek-scrub-blueprint.md). Real
# QUIC client against a real media_moq_publisher_main process serving the real
# hgs_faststart fixture — no mocked network, no faked keyframe table. The fixture's real
# GOP keyframe indices (0,120,240,360,480,600 — verified independently in
# docs/video-seek-scrub-blueprint.md §1.1 by parsing the .moqidx binary in Python) are the
# oracle for the snap assertion; a target of 300 must snap to 240 (the nearest keyframe
# at-or-before 300), not some other value this test just invents.
#
# The host FIFO sink (cheng_scene_media_es_sink_frame) and the diag hook
# (cheng_host_es_diag) are provided by a small desktop-only C stub
# (host_stub/seek_test_host_stub.c) linked in via --provider-objects — no decode/render,
# it only records the first frameIdx WebSceneMediaEsStreamLoop hands it and reports 0 (stop)
# so a single pump tick makes exactly one moq-frame range request.
#
# Asserts, in order:
#   1. WebSceneMediaEsOpen succeeds against the real publisher.
#   2. WebSceneMediaEsSeekToFrame(300) returns true.
#   3. WebSceneMediaEsPumpCursor() == 240 — the seek snapped to the real nearest keyframe,
#      not to 300 itself and not to 0.
#   4. One WebSceneMediaEsStreamLoop() tick later, the desktop sink's captured first
#      frameIdx == 240 — the transport layer actually fetched and delivered the snapped
#      frame, not some other one.
# Any failure prints a reason and exits nonzero; success prints "ALL OK" and exits 0.
#
# offsetBytes cross-check (independent of this binary, see the calling harness): a
# standalone Python script parses the same .moqidx to compute frame 240's real offsetBytes,
# and is diffed against the publisher's own stderr log line
# (" media_moq_publisher: served moq-frame offset=<N> len=<M>") for the ONE moq-frame
# request this run makes — two sources independent of the Cheng code under test.

import std/os
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge

@importc("cheng_test_es_sink_first_frame_idx")
fn chengTestEsSinkFirstFrameIdx(): int32

@importc("cheng_test_es_sink_captured")
fn chengTestEsSinkCaptured(): int32

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    let targetFrameIdx: int32 = cmdline.ReadInt32FlagOrDefault("--target-frame", 300)
    let expectedSnap: int32 = cmdline.ReadInt32FlagOrDefault("--expected-snap", 240)

    # 1. Open against the real publisher.
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    os.WriteLine(os.Get_stdout(), "step1_open_ok")

    # 2. Seek must report success against an in-range target.
    if !media_bridge.WebSceneMediaEsSeekToFrame(targetFrameIdx):
        return fail("SeekToFrame returned false")
    os.WriteLine(os.Get_stdout(), "step2_seek_call_ok")

    # 3. The pump cursor must be the real snapped keyframe, not the raw target.
    let cursor: int32 = media_bridge.WebSceneMediaEsPumpCursor()
    if cursor != expectedSnap:
        return fail(strutil.Join(["pump cursor mismatch: got=", IntToStr(cursor), " expected=", IntToStr(expectedSnap)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step3_pump_cursor_snapped_ok cursor=", IntToStr(cursor)], ""))

    # 4. Drive one pump tick and check what the transport layer actually fetched/delivered.
    let loopRc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if loopRc != 0:
        return fail(strutil.Join(["StreamLoop unexpected rc=", IntToStr(loopRc)], ""))
    if chengTestEsSinkCaptured() == 0:
        return fail("sink never captured a frame — StreamLoop did not deliver anything")
    let gotFrameIdx: int32 = chengTestEsSinkFirstFrameIdx()
    if gotFrameIdx != expectedSnap:
        return fail(strutil.Join(["sink first frameIdx mismatch: got=", IntToStr(gotFrameIdx), " expected=", IntToStr(expectedSnap)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step4_stream_loop_delivered_snapped_frame_ok frameIdx=", IntToStr(gotFrameIdx)], ""))

    os.WriteLine(os.Get_stdout(), "ALL OK")
    return 0
