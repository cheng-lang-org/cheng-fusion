module cold_match_enum_smoke

type Color = Red | Green | Blue

fn describe(c: Color): str =
    match c:
        Red => return "red"
        Green => return "green"
        Blue => return "blue"

fn main(): int32 =
    let c: Color = Color.Red
    let r = describe(c)
    if r != "red":
        return 1
    let g = describe(Color.Green)
    if g != "green":
        return 2
    let b = describe(Color.Blue)
    if b != "blue":
        return 3
    return 0

main()
