import std/result
import std/rawbytes
import std/strutils as strutil
import cheng/quic/tls/test_pki as testpki
import cheng/quic/tls/policy as policy
import cheng/quic/tls/handshake13 as h13
import cheng/quic/tls/tls13
import cheng/apps/vpn_proxy/transport_tcp_tls_handshake as apphs
import cheng/apps/vpn_proxy/transport_tcp_tls_record as rec

fn fixed32(base: int32): Bytes =
    let out: Bytes = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(out, i, (base + i) & 255)
    return out

fn main(): int32 =
    let tlsPolicy: policy.MsQuicTlsPolicy = testpki.msquicMakeLocalhostTransportTlsPolicy()
    let clientHelloRes: Result[Bytes] = apphs.VpnProxyTcpTlsForwardClientBuildHello("localhost",
                                                                                   tlsPolicy.trustRoot0)
    if IsErr(clientHelloRes):
        echo(ErrorText(clientHelloRes))
        return 1
    h13.msquicTls13ResetServerDefault(false)
    var parsedHelloRecord: rec.VpnProxyTcpTlsRecordPlain
    let parsedHelloRecordRes: Result[bool] = rec.VpnProxyTcpTlsRecordParsePlainInto(Value(clientHelloRes),
                                                                                    parsedHelloRecord)
    if IsErr(parsedHelloRecordRes):
        echo(ErrorText(parsedHelloRecordRes))
        return 2
    let feedRes: Result[int32] = h13.msquicTls13SideFeed(1, parsedHelloRecord.payload)
    if IsErr(feedRes):
        echo(ErrorText(feedRes))
        return 3
    let genRes: Result[bool] = h13.msquicTls13ServerGenerateForClientKeyShare()
    if IsErr(genRes):
        echo(ErrorText(genRes))
        return 4
    var serverHello: Bytes
    let serverRandom: Bytes = fixed32(96)
    let shRes: Result[bool] = h13.msquicTls13ServerBuildServerHelloInto(serverHello,
                                                                        serverRandom,
                                                                        false)
    if IsErr(shRes):
        echo(ErrorText(shRes))
        return 5
    h13.msquicTls13ServerAppendTranscript(serverHello)
    let secRes: Result[bool] = h13.msquicTls13SideComputeHandshakeSecrets(1)
    if IsErr(secRes):
        echo(ErrorText(secRes))
        return 6
    let keyIvRes: Result[tls13.MsQuicTls13KeyIv] = h13.msquicTls13SideHandshakeKeyIv(1, true)
    if IsErr(keyIvRes):
        echo(ErrorText(keyIvRes))
        return 7
    let keyIv: tls13.MsQuicTls13KeyIv = Value(keyIvRes)
    echo(strutil.Join(["cipher=", IntToStr(int32(keyIv.cipher)),
                       " cipher_code=", IntToStr(keyIv.cipherCode),
                       " key_len=", IntToStr(BytesLen(keyIv.key)),
                       " iv_len=", IntToStr(BytesLen(keyIv.iv))], ""))
    return 0
