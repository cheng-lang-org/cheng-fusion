import std/system as system

type ColdManagedExactFixedArrayOwner =
    labels: str[3]

fn ColdManagedExactFixedArrayFieldExercise(): int32 =
    var owner: ColdManagedExactFixedArrayOwner
    owner.labels[0] = system.NewStringCopy(
        system.StrDataPtr("alpha"), "alpha".len)
    owner.labels[1] = system.NewStringCopy(
        system.StrDataPtr("beta"), "beta".len)
    owner.labels[2] = system.NewStringCopy(
        system.StrDataPtr("gamma"), "gamma".len)
    if owner.labels[0] != "alpha" ||
       owner.labels[1] != "beta" ||
       owner.labels[2] != "gamma":
        return 1
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactFixedArrayFieldExercise() != 0:
        return 1
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta != int64(3) || freeDelta != int64(3):
        return 2
    if system.memLiveCount() != liveBefore:
        return 3
    if retainDelta != int64(0) || releaseDelta != freeDelta:
        return 4
    echo("cold_managed_exact_fixed_array_field=PASS")
    return 0
