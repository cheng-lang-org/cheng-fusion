import std/strings

@borrows
fn writeFailure(error: var str): bool =
    error = strings.CloneStr("boom")
    return false

fn finish(error: str): int32 =
    return error == "boom" ? 0 : 1

fn main(): int32 =
    var error: str
    for i in 0..<2:
        if !writeFailure(error):
            return finish(error)
    return 0
