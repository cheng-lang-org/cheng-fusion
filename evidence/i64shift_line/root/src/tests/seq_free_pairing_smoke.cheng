# 分配器配对 (registry-as-provenance) 秒级夹具 — Step 3 前置 C1 验证。
#
# 契约: freeSeq 走 registry-checked release。buffer 来源两种都合法:
#   (a) runtime lowering (cheng_malloc/cheng_realloc, registry 注册) → 真 free,
#       free_count 增长;
#   (b) cold 内联 seq lowering (calloc shim / bump chunk, 裸 payload 无注册)
#       → foreign_free_count 增长, 安全跳过 (loud 可观测)。
# C1 之前 (b) 走 unchecked release = 盲写 rc + c_free 非法指针 (静默 corruption
# / slab ud2 / libc abort)。本夹具断言: 每轮 churn 数据完好 + 释放被两条计数器
# 之一如实记账 + 全程不 crash。cold-C 编不了 freeSeq(str[]) 的 .buffer 字段包
# 装, 秒级口径只走 int32[] 直通; str 路径归全量 gate。
import std/seqs as seqs

@importc("cheng_mm_free_count")
fn pairingMmFreeCount(): int64

@importc("cheng_mm_foreign_free_count")
fn pairingMmForeignFreeCount(): int64

fn pairingChurnOnce(round: int32): int32 =
    var xs: int32[]
    for i in 0..<256:
        add(xs, round * 1000 + i)
    if xs.len != 256:
        return 1
    if xs[0] != round * 1000:
        return 2
    if xs[255] != round * 1000 + 255:
        return 3
    seqs.freeSeq(xs)
    if xs.len != 0:
        return 4
    return 0

fn main(): int32 =
    let freeBefore = pairingMmFreeCount()
    let foreignBefore = pairingMmForeignFreeCount()
    for round in 0..<64:
        let rc = pairingChurnOnce(round)
        if rc != 0:
            return rc
    let freeDelta = pairingMmFreeCount() - freeBefore
    let foreignDelta = pairingMmForeignFreeCount() - foreignBefore
    # 64 轮 churn 的 64 次 freeSeq 必须被记账: 真 free 或 foreign 跳过,
    # 两计数器合计 ≥64。两者都不涨 = 释放路径静默蒸发 (配对契约破坏)。
    if freeDelta + foreignDelta < int64(64):
        return 10
    # foreign 出现本身合法 (cold 内联 lowering 的裸 buffer), 但必须是全有或
    # 全无 —— 同一二进制同一 lowering, 64 轮不该出现混合来源。
    if foreignDelta != int64(0) && foreignDelta < int64(64):
        return 11
    return 0
