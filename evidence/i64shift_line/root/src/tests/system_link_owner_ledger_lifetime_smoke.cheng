import std/os
import cheng/core/backend/system_link_exec as sexec
import cheng/core/tooling/compiler_payload_lifecycle as lifecycle

fn SystemLinkOwnerLedgerFill(
        ledger: var sexec.SystemLinkExecAllocationOwnerLedger) =
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindSystemLinkCompilerInput, true)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindCompilerCsgBackend, true)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindLowering, true)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindRuntimeMetadata, true)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindPrimaryBodyIr, true)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindPrimaryPlan, true)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindProvider, true)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindNative, true)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        ledger, sexec.SystemLinkExecOwnerKindSystemLinkPlan, true)

fn SystemLinkOwnerLedgerCycle(
        executionTokenId: int64,
        outcome: int32) =
    var ledger: sexec.SystemLinkExecAllocationOwnerLedger
    sexec.SystemLinkExecOwnerLedgerInit(
        ledger,
        executionTokenId)
    SystemLinkOwnerLedgerFill(ledger)
    let allocatedBytes =
        ledger.ownerTableLifetime.byteCount
    sexec.SystemLinkExecOwnerLedgerMoveToRuntime(ledger)
    sexec.SystemLinkExecOwnerLedgerReleaseStorage(
        ledger,
        outcome)
    let storageReleased =
        sexec.SystemLinkExecOwnerLedgerStorageReleased(ledger)
    var receipt = ledger.ownerTableLifetimeReceipt
    assert(
        storageReleased &&
        lifecycle.CompilerPayloadLifecycleReceiptClosed(receipt) &&
        receipt.outcome == outcome &&
        receipt.allocated == int64(1) &&
        receipt.released == int64(1) &&
        receipt.live == int64(0) &&
        receipt.allocatedBytes == allocatedBytes &&
        receipt.releasedBytes == allocatedBytes &&
        receipt.liveBytes == int64(0) &&
        receipt.retained == int64(1) &&
        receipt.borrowReturnCount == int64(1) &&
        receipt.ownerTransferCount == int64(1) &&
        receipt.physicalBufferCount == 1 &&
        receipt.physicalFreeCount == int64(1) &&
        receipt.storageReleased &&
        receipt.ledgerStorageReleased,
        " system link owner ledger lifetime receipt")

fn main() =
    for cycle in 0..<1000:
        SystemLinkOwnerLedgerCycle(
            int64(cycle + 1),
            lifecycle.CompilerPayloadOutcomeSuccess)
        SystemLinkOwnerLedgerCycle(
            int64(cycle + 1001),
            lifecycle.CompilerPayloadOutcomeDiagnostic)
    os.WriteLine(
        os.Get_stdout(),
        "system_link_owner_ledger_lifetime ok cycles=2000 live=0 live_bytes=0")
