type
    R22EdgeB =
        targetSourcePath: str
        targetSourcePathLen: int32

fn R22MakePathB(modulePath: str): str =
    return modulePath

fn R22AppendB(edges: var R22EdgeB[], modulePath: str): bool =
    var sourcePath = ""
    if modulePath == "":
        return false
    sourcePath = R22MakePathB(modulePath)
    var edge: R22EdgeB
    edge.targetSourcePath = share(sourcePath)
    edge.targetSourcePathLen = sourcePath.len
    add(edges, edge)
    return true

fn main(): int32 =
    var edges: R22EdgeB[]
    if !R22AppendB(edges, "alpha/beta"):
        return 10
    if edges.len != 1:
        return 11
    echo("r22 b ok")
    return 0
