import std/os
import std/result
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/backend/system_link_plan as system_plan
import cheng/core/lang/parser
import cheng/core/tooling/compiler_execution_stage_receipt as execution
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/lsp_server as lsp
import cheng/core/tooling/semantic_snapshot as snapshot_core

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn TestExecution(): execution.CompilerExecutionIdentity =
    return Value(execution.CompilerExecutionIdentityMake(
        "lsp-internal-producer", TestCid("compiler-source-bundle"),
        TestCid("materializer"), TestCid("grammar"),
        TestCid("compiler-source-closure"), TestCid("driver"),
        TestCid("toolchain"), TestCid("command"),
        "arm64-apple-darwin"))

fn TestUniverse(): cworld.CompilerLocalUniverse =
    var universe: cworld.CompilerLocalUniverse
    var entries: cworld.CompilerUniverseManifestEntry[]
    var err: str
    assert(cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
        universe,
        err,
        "stable",
        TestExecution().sourceBundleRaw32,
        TestCid("compiler-csg-root"),
        TestCid("compiler-export-surface"),
        layout.FixedBytes32(),
        entries), err)
    return universe

fn main() =
    let workspaceRoot = "/tmp/cheng_lsp_overlay_identity_fixture"
    let packageRoot = workspaceRoot
    let uriMain = "file:///tmp/cheng_lsp_overlay_identity_fixture/src/main.cheng"
    let uriHelper = "file:///tmp/cheng_lsp_overlay_identity_fixture/src/helper.cheng"
    let sourceMain = "/tmp/cheng_lsp_overlay_identity_fixture/src/main.cheng"
    let sourceHelper = "/tmp/cheng_lsp_overlay_identity_fixture/src/helper.cheng"
    let textMain = strutil.Join([
        "import pkg/helper as helper\n\n",
        "fn Main(): int32 =\n",
        "    return helper.Answer()\n"], "")
    let textHelper = strutil.Join([
        "fn Answer(): int32 =\n",
        "    return 7\n"], "")
    let sealedBaseText = "disk bytes must never feed CompilerCSG\n"
    os.MkdirAll("/tmp/cheng_lsp_overlay_identity_fixture/src", 493)
    os.WriteFile(
        "/tmp/cheng_lsp_overlay_identity_fixture/cheng-package.toml",
        "disk manifest must never feed exact CompilerCSG\n")
    os.WriteFile(sourceMain, sealedBaseText)
    os.WriteFile(sourceHelper, sealedBaseText)
    assert(os.FileExists(sourceMain) && os.FileExists(sourceHelper),
           "lsp internal producer: source identity fixture missing")

    var exactPlan: system_plan.SystemLinkPlanStub
    var err: str
    assert(system_plan.SystemLinkPlanBuildImmutableSourceOverlayInto(
               workspaceRoot,
               packageRoot,
               "pkg",
               "arm64-apple-darwin",
               sourceMain,
               [sourceHelper, sourceMain],
               ["pkg/helper", "pkg/main"],
               [textHelper, textMain],
               exactPlan,
               err), err)
    var rejectedPlan: system_plan.SystemLinkPlanStub
    assert(!system_plan.SystemLinkPlanBuildImmutableSourceOverlayInto(
               workspaceRoot,
               packageRoot,
               "other",
               "arm64-apple-darwin",
               sourceMain,
               [sourceHelper, sourceMain],
               ["pkg/helper", "pkg/main"],
               [textHelper, textMain],
               rejectedPlan,
               err),
           "lsp internal producer: package identity attack accepted")
    assert(!system_plan.SystemLinkPlanBuildImmutableSourceOverlayInto(
               workspaceRoot,
               packageRoot,
               "pkg",
               "arm64-apple-darwin",
               sourceMain,
               [sourceHelper, sourceMain],
               ["pkg/attacked", "pkg/main"],
               [textHelper, textMain],
               rejectedPlan,
               err),
           "lsp internal producer: module identity attack accepted")
    var exactProfile: parser.NormalizedExprCallProfile
    var noExternalRoots: parser.ParserExternalPackageRoot[]
    assert(parser.ParserBuildExprCallProfileExactInto(
               workspaceRoot,
               packageRoot,
               "pkg",
               noExternalRoots,
               sourceMain,
               "pkg/main",
               textMain,
               exactPlan.sourceClosurePaths,
               exactPlan.ownerModulePaths,
               exactPlan.importEdges,
               false,
               exactProfile,
               err) &&
           exactProfile.importEdges.len == 1 &&
           exactProfile.importEdges[0].targetModulePath == "pkg/helper" &&
           exactProfile.importEdges[0].targetSourcePath == sourceHelper,
           "lsp internal producer: exact import target join failed")
    var attackedEdges: parser.ImportEdge[]
    for edgeIndex in 0..<exactPlan.importEdges.len:
        add(attackedEdges, exactPlan.importEdges[edgeIndex])
    attackedEdges[0].targetModulePath = "pkg/main"
    assert(!parser.ParserBuildExprCallProfileExactInto(
               workspaceRoot,
               packageRoot,
               "pkg",
               noExternalRoots,
               sourceMain,
               "pkg/main",
               textMain,
               exactPlan.sourceClosurePaths,
               exactPlan.ownerModulePaths,
               attackedEdges,
               false,
               exactProfile,
               err),
           "lsp internal producer: sealed import edge attack accepted")

    var workspace: lsp.LspWorkspace
    assert(lsp.LspWorkspaceInitInto(
               TestCid("lsp-internal-producer/session"),
               TestUniverse(),
               TestExecution(), workspace, err), err)
    assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace,
               uriHelper,
               workspaceRoot,
               packageRoot,
               "pkg",
               "arm64-apple-darwin",
               sourceHelper,
               "pkg/helper",
               false,
               err), err)
    assert(lsp.LspWorkspaceBindDocumentCompilerIdentityInto(
               workspace,
               uriMain,
               workspaceRoot,
               packageRoot,
               "pkg",
               "arm64-apple-darwin",
               sourceMain,
               "pkg/main",
               true,
               err), err)

    var sourceVersion: int64
    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uriHelper, int64(1), textHelper,
               sourceVersion, err), err)
    assert(sourceVersion == int64(1),
           "lsp internal producer: helper open version drift")
    assert(lsp.LspWorkspaceDidOpenInto(
               workspace, uriMain, int64(1), textMain,
               sourceVersion, err), err)
    assert(sourceVersion == int64(2),
           "lsp internal producer: main open version drift")

    var definition: lsp.LspExactDefinitionResult
    assert(!lsp.LspWorkspaceExactDefinitionInto(
               workspace, uriMain, 3, 18, definition, err) &&
           strings.StrContains(err, "content modified"),
           "lsp internal producer: unpublished version returned a query")
    var lineMap: lsp.LspExactLineMapResult
    err = ""
    assert(!lsp.LspWorkspaceExactLineMapInto(
               workspace, uriMain, lineMap, err) &&
           strings.StrContains(err, "content modified"),
           "lsp internal producer: unpublished version returned a line-map")
    var diagnostics: lsp.LspExactDiagnosticsResult
    assert(lsp.LspWorkspaceExactDiagnosticsInto(
               workspace, uriMain, diagnostics, err) &&
           diagnostics.receipt.rejected &&
           diagnostics.items.len == 1,
           "lsp internal producer: rejected diagnostics unavailable")
    assert(workspace.metrics.candidateAttemptCount == int64(2) &&
           workspace.metrics.candidateRejectedCount == int64(2) &&
           workspace.metrics.candidatePublishedCount == int64(0) &&
           workspace.metrics.parserBuildObserved &&
           workspace.metrics.compilerCsgBuildObserved &&
           workspace.metrics.parserBuildWallNs > int64(0) &&
           workspace.metrics.compilerCsgBuildWallNs > int64(0) &&
           workspace.metrics.compilerSnapshotBuilderAttemptCount > int64(0) &&
           workspace.metrics.explicitSourceFileReadCount == int64(2) &&
           workspace.metrics.explicitSourceFileReadBytes ==
               int64(sealedBaseText.len) * int64(2) &&
           workspace.snapshotStore.core.publishedIndex < 0 &&
           workspace.snapshotStore.core.currentSourceVersion == int64(2) &&
           !layout.FixedBytes32Equal(
               workspace.candidateAdmissionReceiptCid,
               layout.FixedBytes32()) &&
           workspace.candidateAdmissionCompletedStageBitmap != 0 &&
           workspace.candidateAdmissionMissingFactBitmap == 336 &&
           (workspace.candidateAdmissionMissingFactBitmap & 1) == 0 &&
           (workspace.candidateAdmissionMissingFactBitmap & 4) == 0 &&
           (workspace.candidateAdmissionMissingFactBitmap & 8) == 0 &&
           (workspace.candidateAdmissionMissingFactBitmap & 16) == 16 &&
           (workspace.candidateAdmissionMissingFactBitmap & 32) == 0 &&
           (workspace.candidateAdmissionMissingFactBitmap & 64) == 64 &&
           (workspace.candidateAdmissionMissingFactBitmap & 256) == 256 &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "source_interfaces=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "symbol_interfaces=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "symbol_declarations=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "function_interfaces=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "function_owner_identities=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "function_param_ownerships=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "parser_typed_expr_identities=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "typed_node_captures=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "reference_parser_nodes=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "reference_owner_functions=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "reference_spans=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "reference_target_symbol_cids=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "reference_result_type_ids=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_parser_identities=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_typed_identities=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_statement_uses=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_owner_functions=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_bridges=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_owner_declarations=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_spans=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "lexical_scope_visible_symbols=") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_producer_kinds=5") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_completions_required=10") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_rows=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_completions_missing=10") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_source_identities=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_producer_kind_identities=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_spans=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_parser_nodes=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_owner_declarations=0") &&
           strings.StrContains(
               workspace.candidateBlockedReason,
               "diagnostic_proofs=10") &&
           workspace.candidateBlockedReason != "",
           Fmt"lsp internal producer: fail-closed producer metrics drift candidate={workspace.metrics.candidateAttemptCount} rejected={workspace.metrics.candidateRejectedCount} published={workspace.metrics.candidatePublishedCount} parser={workspace.metrics.parserBuildObserved} parser_ns={workspace.metrics.parserBuildWallNs} csg={workspace.metrics.compilerCsgBuildObserved} csg_ns={workspace.metrics.compilerCsgBuildWallNs} builder={workspace.metrics.compilerSnapshotBuilderAttemptCount} reads={workspace.metrics.explicitSourceFileReadCount} blocked={workspace.candidateBlockedReason}")
    let validatedAdmissionMissingFactBitmap =
        workspace.candidateAdmissionMissingFactBitmap
    let validatedAdmissionReceiptCid =
        workspace.candidateAdmissionReceiptCid

    var change: lsp.LspContentChange
    change.rangePresent = true
    change.startLine = 1
    change.startCharacter = 11
    change.endLine = 1
    change.endCharacter = 12
    change.rangeLengthPresent = true
    change.rangeLength = 1
    change.text = "8"
    assert(lsp.LspWorkspaceDidChangeInto(
               workspace, uriHelper, int64(2), [change],
               sourceVersion, err), err)
    assert(sourceVersion == int64(3) &&
           workspace.documents[0].sourceText ==
               "fn Answer(): int32 =\n    return 8\n" &&
           workspace.metrics.candidateAttemptCount == int64(3) &&
           workspace.metrics.candidatePublishedCount == int64(0),
           "lsp internal producer: changed overlay was not rebuilt")

    assert(lsp.LspWorkspaceDidCloseInto(
               workspace, uriHelper, sourceVersion, err), err)
    assert(sourceVersion == int64(4) &&
           !workspace.documents[0].open &&
           workspace.documents[0].text == "" &&
           workspace.documents[0].sourceText == sealedBaseText &&
           workspace.metrics.candidateAttemptCount == int64(4) &&
           workspace.metrics.candidateRejectedCount == int64(4) &&
           workspace.metrics.candidatePublishedCount == int64(0) &&
           workspace.metrics.explicitSourceFileReadCount == int64(2) &&
           workspace.snapshotStore.core.publishedIndex < 0 &&
           workspace.snapshotStore.core.currentSourceVersion == int64(4),
           "lsp internal producer: close did not restore sealed base bytes")
    assert(workspace.snapshotStore.core.states.len == 4 &&
           workspace.snapshotStore.rejectionSnapshotIndexes.len == 4 &&
           workspace.snapshotStore.core.states[3] ==
               snapshot_core.SemanticSnapshotStateRejected,
           "lsp internal producer: accepted version did not terminate rejected")
    assert(!lsp.LspWorkspaceExactDefinitionInto(
               workspace, uriMain, 3, 18, definition, err) &&
           strings.StrContains(err, "content modified"),
           "lsp internal producer: close returned stale publication")

    let successLine = strutil.Join([
        "lsp_internal_snapshot_producer_smoke: ok ",
        "candidate_attempt=", strings.Int64ToStr(
            workspace.metrics.candidateAttemptCount),
        " parser_observed=", workspace.metrics.parserBuildObserved ? "1" : "0",
        " csg_observed=", workspace.metrics.compilerCsgBuildObserved ? "1" : "0",
        " builder_attempt=", strings.Int64ToStr(
            workspace.metrics.compilerSnapshotBuilderAttemptCount),
        " published=", strings.Int64ToStr(
            workspace.metrics.candidatePublishedCount),
        " missing_fact_bitmap=", strings.IntToStr(
            validatedAdmissionMissingFactBitmap),
        " admission_receipt=", layout.FixedBytes32Hex(
            validatedAdmissionReceiptCid),
        " explicit_source_file_reads=", strings.Int64ToStr(
            workspace.metrics.explicitSourceFileReadCount)], "")
    assert(lsp.LspWorkspaceReleaseInto(workspace, err) &&
           !workspace.initialized &&
           layout.FixedBytes32Equal(
               workspace.compilerUniverse.worldHead.headCid,
               layout.FixedBytes32()),
           "lsp internal producer: release retained compiler universe")
    os.WriteLine(os.Get_stdout(), successLine)
