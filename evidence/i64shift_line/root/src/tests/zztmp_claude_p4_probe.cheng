import std/cmdline as cmdline
import std/system as system
import cheng/core/analysis/cleanup_cfg as cleanup
import cheng/core/analysis/ownership_drop_ir as odir
import cheng/core/ir/core_types as coreir
import cheng/core/ir/body_ir_access as bodyaccess
import cheng/std/bytes_layout as layout

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    echo("start")
    let a = cleanup.CleanupPlanCanonicalFingerprintSchemaFieldCount()
    echo("a done")
    let b = cleanup.CleanupPlanLimitsCanonicalFingerprintSchemaFieldCount()
    echo("b done")
    if a == 281 && b == 34:
        echo("counts ok")
    else:
        echo("counts mismatch")
    return 0
