fn R19Trim(raw: str): str =
    return raw

fn R19FindEq(text: str): int32 =
    return text.len

fn R19Core(lineRaw: str, prefixLen: int32): int32 =
    let line = R19Trim(lineRaw)
    var tail: str
    if prefixLen > 0:
        tail = R19Trim(line)
    else:
        tail = line
    let eqPos = R19FindEq(tail)
    if eqPos <= 0:
        return 0
    let left = R19Trim(tail)
    return left.len

fn main(): int32 =
    let n = R19Core("abcdef", 0)
    if n != 6:
        return 10
    echo("r19 ok")
    return 0
