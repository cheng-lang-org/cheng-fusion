import std/os
import std/rawbytes
import std/system
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/backend/coff_object_writer as coff
import cheng/core/backend/coff_x86_64_writer as coffx64
import cheng/core/backend/direct_object_emit as directemit
import cheng/core/backend/elf_object_writer as elf
import cheng/core/backend/elf_riscv64_writer as elfriscv64
import cheng/core/backend/elf_x86_64_writer as elfx64
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/direct_object_debug_sections as debugsections
import cheng/core/backend/debug_section_plan_receipt as planreceipt
import cheng/core/backend/macho_object_writer as macho
import cheng/core/backend/wasm_module_emit as wasm

fn BuildBytes32(): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(32)
    for index in 0..<32:
        obuf.ObjectBufferWriteU8(out, index)
    return obuf.ObjectBufferTakeBytes(out)

fn BuildLargeSymbolName(byteCount: int32): str =
    var bytes = rawbytes.BytesAlloc(byteCount)
    for index in 0..<byteCount:
        rawbytes.BytesSet(bytes, index, int32('A') + index % 23)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return out

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn BuildText(): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(8)
    obuf.ObjectBufferWriteU32LE(out, uint64(0xd503201f))
    obuf.ObjectBufferWriteU32LE(out, uint64(0xd65f03c0))
    return obuf.ObjectBufferTakeBytes(out)

fn BuildData(): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(8)
    obuf.ObjectBufferWriteU64LE(out, uint64(0x1020304050607080))
    return obuf.ObjectBufferTakeBytes(out)

fn BuildSymbols(): osym.ObjectSymbolTable =
    var out = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               out, "_Main", 0, int64(0), int64(8), true) == 0,
           "debug lifecycle: exact symbol build failed")
    return out

fn BuildDebugReceipt(): planreceipt.DebugSectionPlanReceipt =
    let documentCid = TestCid("lifecycle/document")
    let declCid = TestCid("lifecycle/decl")
    let symbolCid = TestCid("lifecycle/symbol")
    let hash = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    var out: planreceipt.DebugSectionPlanReceipt
    out.valid = true
    out.backendKind = "primary"
    out.sourceVersion = 1
    out.packageId = "lifecycle"
    out.debugBindingReceiptCid = TestCid("lifecycle/debug-binding")
    out.bindingReceiptCid = TestCid("lifecycle/binding")
    out.semanticSnapshotCid = TestCid("lifecycle/snapshot")
    out.worldHeadCid = TestCid("lifecycle/world")
    out.compilerCid = TestCid("lifecycle/compiler")
    out.sourceBundleCid = TestCid("lifecycle/source-bundle")
    out.csgRootCid = TestCid("lifecycle/csg")
    out.validationReceiptCid = TestCid("lifecycle/validation")
    out.debugProjectionCid = TestCid("lifecycle/projection")
    out.declarationTableCid = TestCid("lifecycle/declaration-table")
    out.declarationIdentityCid = TestCid("lifecycle/declaration-identity")
    out.sourceIds = [0]
    out.sourceModulePaths = ["lifecycle/main"]
    out.sourceDocumentCids = [documentCid]
    out.functionNames = ["Main"]
    add(out.functions, planreceipt.DebugSectionPlanFunctionRow(
        functionIndex: 0,
        functionId: 0,
        functionDeclId: 0,
        functionSymbolId: 0,
        functionSymbolName: "_Main",
        sourceId: 0,
        documentCid: documentCid,
        functionDeclKeyCid: declCid,
        functionSymbolCid: symbolCid,
        bodyStartLine: 0,
        bodyStartColumn: 0,
        bodyEndLine: 0,
        bodyEndColumn: 4,
        symbolByteStart: 0,
        symbolByteLength: 8,
        plannedSymbolBytesSha256: hash,
        bodyIrSha256: hash,
        frozenPlanSha256: hash,
        regallocPlanSha256: hash,
        emissionLedgerSha256: hash,
        actionSemanticRootSha256: hash,
        actionBindingRootSha256: hash,
        machineFragmentRootSha256: hash,
        abiIngressRootSha256: hash,
        debugProvenanceSha256: hash,
        debugMachineFragmentRootSha256: hash,
        rowStart: 0,
        rowCount: 1))
    add(out.rows, planreceipt.DebugSectionPlanRow(
        functionIndex: 0,
        functionId: 0,
        functionDeclId: 0,
        functionSymbolId: 0,
        functionDeclKeyCid: declCid,
        functionSymbolCid: symbolCid,
        debugOpId: 0,
        debugSyntheticKind: 0,
        typedNodeId: 0,
        typedIrNodeIndex: 0,
        sourceId: 0,
        spanId: 0,
        documentCid: documentCid,
        startLine: 0,
        startColumn: 0,
        endLine: 0,
        endColumn: 4,
        siteKind: 0,
        siteIndex: 0,
        machineOwnerKind: 0,
        machineOwnerOrdinal: 0,
        actionConsumerOrdinal: 0,
        textSectionRelativeByteStart: 0,
        byteLength: 8,
        plannedBytesSha256: hash))
    out.receiptCid = planreceipt.debugSectionPlanReceiptCid(out)
    return out

fn ExerciseBackendWriters(text: rawbytes.Bytes,
                          symbols: osym.ObjectSymbolTable,
                          relocs: orel.ObjectRelocTable) =
    let coffResult = coff.CoffTextObjectBytes(text, symbols, relocs)
    assert(coffResult.ok, coffResult.err.msg)
    var coffBytes = coffResult.value
    rawbytes.BytesFree(coffBytes)
    let coffX64Result =
        coffx64.CoffX64TextObjectBytes(text, symbols, relocs)
    assert(coffX64Result.ok, coffX64Result.err.msg)
    var coffX64Bytes = coffX64Result.value
    rawbytes.BytesFree(coffX64Bytes)
    let elfResult = elf.ElfTextObjectBytes(text, symbols, relocs)
    assert(elfResult.ok, elfResult.err.msg)
    var elfBytes = elfResult.value
    rawbytes.BytesFree(elfBytes)
    let elfX64Result =
        elfx64.ElfX64TextObjectBytes(text, symbols, relocs)
    assert(elfX64Result.ok, elfX64Result.err.msg)
    var elfX64Bytes = elfX64Result.value
    rawbytes.BytesFree(elfX64Bytes)
    let elfRv64Result =
        elfriscv64.ElfRv64TextObjectBytes(text, symbols, relocs)
    assert(elfRv64Result.ok, elfRv64Result.err.msg)
    var elfRv64Bytes = elfRv64Result.value
    rawbytes.BytesFree(elfRv64Bytes)
    var wasmBytes = wasm.WasmModuleBuildReturnZeroModule()
    assert(rawbytes.BytesLen(wasmBytes) > 0,
           "debug lifecycle: empty wasm object")
    rawbytes.BytesFree(wasmBytes)
    var directBytes = directemit.DirectObjectEmitReturnZeroText(
        ["_main"])
    assert(rawbytes.BytesLen(directBytes) == 8,
           "debug lifecycle: direct object text drift")
    rawbytes.BytesFree(directBytes)

fn main() =
    var err: str

    let chunk = BuildBytes32()
    defer:
        rawbytes.BytesFree(chunk)
    let growLiveBefore = memLiveCount()
    for iteration in 0..<4096:
        var grow = obuf.ObjectBufferInit(1)
        for appendIndex in 0..<8192:
            obuf.ObjectBufferWriteBytes(grow, chunk)
        assert(obuf.ObjectBufferLen(grow) == 262144,
               "debug lifecycle: grow length mismatch")
        var owned = obuf.ObjectBufferTakeBytes(grow)
        assert(obuf.ObjectBufferLen(grow) == 0 &&
               obuf.ObjectBufferCap(grow) == 0 &&
               rawbytes.BytesLen(owned) == 262144,
               "debug lifecycle: take did not clear owner")
        rawbytes.BytesFree(owned)
        obuf.ObjectBufferRelease(grow)
    assert(memLiveCount() == growLiveBefore,
           "debug lifecycle: grow/take owner balance drift")

    let receipt = BuildDebugReceipt()
    let text = BuildText()
    defer:
        rawbytes.BytesFree(text)
    let data = BuildData()
    defer:
        rawbytes.BytesFree(data)
    var symbols = BuildSymbols()
    var relocs = orel.ObjectRelocsInit()

    for iteration in 0..<256:
        ExerciseBackendWriters(text, symbols, relocs)

    for iteration in 0..<2048:
        var sections: debugsections.DirectObjectDebugSections
        assert(debugsections.DirectObjectDebugSectionsBuildInto(
                   receipt,
                   symbols, sections, err), err)
        debugsections.DirectObjectDebugSectionsRelease(sections)
        assert(!sections.valid &&
               rawbytes.BytesLen(sections.debugLine) == 0 &&
               rawbytes.BytesLen(sections.debugInfo) == 0 &&
               rawbytes.BytesLen(sections.debugAbbrev) == 0,
               "debug lifecycle: section release did not clear owner")

    var wrongSymbols = osym.ObjectSymbolsInit()
    let wrongIndex = osym.ObjectSymbolsAddDefined(
        wrongSymbols, "_Wrong", 0, int64(0), int64(8), true)
    assert(wrongIndex == 0, "debug lifecycle: wrong symbol fixture")
    for iteration in 0..<2048:
        var rejected: debugsections.DirectObjectDebugSections
        assert(!debugsections.DirectObjectDebugSectionsBuildInto(
                   receipt,
                   wrongSymbols, rejected, err),
               "debug lifecycle: missing exact symbol accepted")
        assert(!rejected.valid &&
               rawbytes.BytesLen(rejected.debugLine) == 0 &&
               rawbytes.BytesLen(rejected.debugInfo) == 0 &&
               rawbytes.BytesLen(rejected.debugAbbrev) == 0,
               "debug lifecycle: failed build retained bytes")
        debugsections.DirectObjectDebugSectionsRelease(rejected)

    var sections: debugsections.DirectObjectDebugSections
    assert(debugsections.DirectObjectDebugSectionsBuildInto(
               receipt,
               symbols, sections, err), err)
    defer:
        debugsections.DirectObjectDebugSectionsRelease(sections)
    for iteration in 0..<256:
        let result = macho.MachOTextDataDebugObjectBytes(
            text, data, symbols, relocs, sections)
        assert(result.ok, result.err.msg)
        var objectBytes = result.value
        assert(rawbytes.BytesLen(objectBytes) > 0,
               "debug lifecycle: empty successful object")
        rawbytes.BytesFree(objectBytes)

    let largeName = BuildLargeSymbolName(262144)
    let largeIndex = osym.ObjectSymbolsAddDefined(
        symbols, largeName, 0, int64(0), int64(0), false)
    assert(largeIndex == 1, "debug lifecycle: large symbol fixture")
    let attackIndex = orel.ObjectRelocsAdd(
        relocs, 0, int64(0), 2,
        orel.ObjectRelocBranch26, int64(0), true)
    assert(attackIndex == 0, "debug lifecycle: relocation attack fixture")
    for iteration in 0..<2304:
        let rejected = macho.MachOTextDataDebugObjectBytes(
            text, data, symbols, relocs, sections)
        assert(!rejected.ok &&
               rejected.err.msg ==
                   " macho object writer: relocation symbol out of range",
               "debug lifecycle: late relocation attack accepted")

    os.WriteLine(os.Get_stdout(),
                 "debug_object_buffer_orc_balance=1")
    os.WriteLine(os.Get_stdout(),
                 "debug_object_buffer_backend_writers=1")
    os.WriteLine(os.Get_stdout(),
                 "debug_object_buffer_lifecycle_smoke=pass")
