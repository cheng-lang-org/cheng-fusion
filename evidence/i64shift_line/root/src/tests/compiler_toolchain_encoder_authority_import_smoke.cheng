import std/cmdline
import std/os
import std/os_host_process as hostos
import std/rawbytes
import std/result
import std/strutils as strutil
import cheng/core/tooling/compiler_execution_stage_receipt as stage_receipt
import cheng/core/tooling/compiler_toolchain_encoder_authority_import as authority_import
import cheng/std/bytes_layout as layout

fn ImportFixtureOwnedBytes(text: str): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(text.len)
    assert(rawbytes.BytesLen(out) == text.len,
           " encoder authority import smoke: fixture allocation")
    for index in 0..<text.len:
        rawbytes.BytesSet(out, index, Int32(text[index]) % 256)
    return out

fn ImportFixtureObservedCid(text: str): layout.FixedBytes32 =
    var observed = ImportFixtureOwnedBytes(text)
    defer:
        rawbytes.BytesFree(observed)
    let observedRes =
        stage_receipt.CompilerExecutionIdentityObservedRaw32(observed)
    assert(IsOk(observedRes),
           " encoder authority import smoke: observed CID")
    return Value(observedRes)

fn ImportFixtureBuildIdentity(): stage_receipt.CompilerExecutionIdentity =
    let identityRes = stage_receipt.CompilerExecutionIdentityMake(
        "encoder-authority.runtime-import.0001",
        ImportFixtureObservedCid("source-bundle:runtime-import"),
        ImportFixtureObservedCid("materializer:runtime-import"),
        ImportFixtureObservedCid("grammar-obligation:runtime-import"),
        ImportFixtureObservedCid("compiler-source-closure:runtime-import"),
        ImportFixtureObservedCid("driver:runtime-import"),
        ImportFixtureObservedCid("toolchain-manifest:runtime-import"),
        ImportFixtureObservedCid("command-manifest:runtime-import"),
        "arm64-apple-darwin")
    assert(IsOk(identityRes),
           " encoder authority import smoke: fixture build identity")
    return Value(identityRes)

fn ImportFixtureBuildProjection():
        stage_receipt.CompilerToolchainEncoderAuthorityBuildProjectionReceipt =
    let identity = ImportFixtureBuildIdentity()
    let makeRes =
        stage_receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
            identity,
            ImportFixtureObservedCid("compiler-csg-artifact:runtime-import"),
            ImportFixtureObservedCid("compiler-csg-graph:runtime-import"),
            ImportFixtureObservedCid(
                "compiler-csg-canonical-graph:runtime-import"),
            ImportFixtureObservedCid(
                "compiler-csg-source-bundle:runtime-import"),
            ImportFixtureObservedCid("compiler-csg-cargo:runtime-import"),
            ImportFixtureObservedCid(
                "compiler-csg-facts-root:runtime-import"),
            ImportFixtureObservedCid(
                "compiler-csg-cargo-object-receipt:runtime-import"),
            17,
            9,
            41,
            ImportFixtureObservedCid(
                "document:src/core/backend/riscv64_encode.cheng"),
            ImportFixtureObservedCid(
                "content:src/core/backend/riscv64_encode.cheng:exact"))
    assert(IsOk(makeRes),
           " encoder authority import smoke: fixture projection")
    return Value(makeRes)

fn ImportFixturePrintField(key: str, value: str) =
    echo(strutil.Join([key, "=", value], ""))

fn ImportFixturePrintInner() =
    let value = ImportFixtureBuildProjection()
    ImportFixturePrintField(
        "encoder_build_projection_build_authority_cid",
        layout.FixedBytes32Hex(value.buildAuthorityCid))
    ImportFixturePrintField(
        "encoder_build_projection_canonical_row",
        IntToStr(value.canonicalRow))
    ImportFixturePrintField(
        "encoder_build_projection_compiler_csg_artifact_cid",
        layout.FixedBytes32Hex(value.compilerCsgArtifactCid))
    ImportFixturePrintField(
        "encoder_build_projection_compiler_csg_canonical_graph_cid",
        layout.FixedBytes32Hex(value.compilerCsgCanonicalGraphCid))
    ImportFixturePrintField(
        "encoder_build_projection_compiler_csg_cargo_cid",
        layout.FixedBytes32Hex(value.compilerCsgCargoCid))
    ImportFixturePrintField(
        "encoder_build_projection_compiler_csg_cargo_object_receipt_cid",
        layout.FixedBytes32Hex(value.compilerCsgCargoObjectReceiptCid))
    ImportFixturePrintField(
        "encoder_build_projection_compiler_csg_facts_root_cid",
        layout.FixedBytes32Hex(value.compilerCsgFactsRootCid))
    ImportFixturePrintField(
        "encoder_build_projection_compiler_csg_graph_cid",
        layout.FixedBytes32Hex(value.compilerCsgGraphCid))
    ImportFixturePrintField(
        "encoder_build_projection_compiler_csg_source_bundle_cid",
        layout.FixedBytes32Hex(value.compilerCsgSourceBundleCid))
    ImportFixturePrintField(
        "encoder_build_projection_content_cid",
        layout.FixedBytes32Hex(value.contentCid))
    ImportFixturePrintField(
        "encoder_build_projection_document_cid",
        layout.FixedBytes32Hex(value.documentCid))
    ImportFixturePrintField(
        "encoder_build_projection_module_path_text_id",
        IntToStr(value.modulePathTextId))
    ImportFixturePrintField(
        "encoder_build_projection_producer_row",
        IntToStr(value.producerRow))
    ImportFixturePrintField(
        "encoder_build_projection_projection_cid",
        layout.FixedBytes32Hex(value.projectionCid))
    ImportFixturePrintField(
        "encoder_build_projection_receipt_cid",
        layout.FixedBytes32Hex(value.receiptCid))
    ImportFixturePrintField(
        "encoder_build_projection_schema",
        "cheng.compiler.toolchain_encoder_authority_build_projection_receipt")

fn main(): int32 =
    if cmdline.HasFlag("--emit-inner-fixture"):
        ImportFixturePrintInner()
        return 0
    if cmdline.HasFlag("--create-self-hardlink"):
        let selfPath = cmdline.ParamStr(0)
        let hardlinkPath = cmdline.ParamStr(2)
        assert(selfPath.len > 0 && hardlinkPath.len > 0,
               " encoder authority import smoke: hardlink arguments")
        let linkResult = hostos.ExecFileCapture(
            "/bin/ln", [selfPath, hardlinkPath], [], "", true, 30)
        assert(os.ExecCmdResultExitCode(linkResult) == 0,
               " encoder authority import smoke: hardlink creation")
    let importRes =
        authority_import.CompilerToolchainEncoderRuntimeAuthorityImportCurrent()
    if cmdline.HasFlag("--expect-import-failure"):
        assert(IsErr(importRes),
               " encoder authority import smoke: mutation accepted")
        echo("compiler_toolchain_encoder_authority_import_mutation=rejected")
        return 0
    assert(IsOk(importRes),
           " encoder authority import smoke: valid receipt rejected")
    let authority = Value(importRes)
    assert(authority.canonicalRow == 9,
           " encoder authority import smoke: canonical row")
    assert(!layout.FixedBytes32Equal(
               authority.projectionReceiptCid, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               authority.compilerBytesRaw32, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               authority.officialReceiptRaw32, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(
               authority.runtimeAuthorityCid, layout.FixedBytes32()),
           " encoder authority import smoke: scalar authority absent")
    echo(strutil.Join([
        "compiler_toolchain_encoder_authority_import=pass canonical_row=9 runtime_authority_cid=",
        layout.FixedBytes32Hex(authority.runtimeAuthorityCid)], ""))
    return 0
