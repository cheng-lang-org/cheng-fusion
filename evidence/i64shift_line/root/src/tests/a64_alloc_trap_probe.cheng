import std/cmdline as cmdline
import std/system

fn buildSeq(seed: int32): int32 =
    let s: int32[] = [seed + 1, seed + 2, seed + 3, seed + 4]
    var total: int32 = 0
    var j: int32 = 0
    while j < s.len:
        total = total + s[j]
        j = j + 1
    return total

fn buildStr(n: int32): int32 =
    var total: int32 = 0
    var i: int32 = 0
    while i < n:
        let s = Fmt"chunk-{i}-payload-padding-to-force-heap-allocation"
        total = total + int32(s.len)
        i = i + 1
    return total

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var acc: int32 = 0
    var k: int32 = 0
    while k < 32:
        acc = acc + buildSeq(k)
        k = k + 1
    let t = buildStr(64)
    echo(Fmt"alloc_seq_total={acc}")
    echo(Fmt"alloc_str_total={t}")
    return 0
