var globalReport: str

fn appendReportPiece(out: var str, piece: str) =
    if len(out) > 0:
        out = Fmt"{out}\n"
    out = Fmt"{out}{piece}"

fn buildGlobalReport() =
    globalReport = ""
    appendReportPiece(globalReport, "alpha")
    appendReportPiece(globalReport, "beta")

fn main(): int32 =
    buildGlobalReport()
    if globalReport != "alpha\nbeta":
        return 1
    if globalReport == "alpha\nbetaX":
        return 2
    return 0
