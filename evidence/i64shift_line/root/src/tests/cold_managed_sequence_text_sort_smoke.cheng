import std/os as os
import std/strings

@borrows
fn textCompare(left: str, right: str): int32 =
    let common = left.len < right.len ? left.len : right.len
    for i in 0..<common:
        let leftByte = int32(left[i]) & 255
        let rightByte = int32(right[i]) & 255
        if leftByte < rightByte:
            return -1
        if leftByte > rightByte:
            return 1
    if left.len < right.len:
        return -1
    if left.len > right.len:
        return 1
    return 0

fn textSort(values: var str[]) =
    for index in 1..<values.len:
        var cursor = index
        while cursor > 0 &&
              textCompare(values[cursor], values[cursor - 1]) < 0:
            let swapped = values[cursor]
            values[cursor] = values[cursor - 1]
            values[cursor - 1] = swapped
            cursor = cursor - 1

fn main(): int32 =
    var values = [
        strings.CloneStr("sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"),
        strings.CloneStr("sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"),
        strings.CloneStr("sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")]
    textSort(values)
    if values.len != 3 ||
       values[0] != "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" ||
       values[1] != "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb" ||
       values[2] != "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc":
        for i in 0..<values.len:
            os.WriteLine(os.Get_stderr(), values[i])
        os.WriteLine(os.Get_stderr(), "cold_managed_sequence_text_sort=FAIL")
        return 1
    os.WriteLine(os.Get_stdout(), "cold_managed_sequence_text_sort=PASS")
    return 0
