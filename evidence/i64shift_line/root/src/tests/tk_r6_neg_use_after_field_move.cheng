type
    R6NegBundle =
        cacheMode: str
        count: int32

fn R6NegFill(out: var R6NegBundle): int32 =
    out = R6NegBundle()
    var s: str = "content"
    out.cacheMode = s
    return len(s)

fn main(): int32 =
    var bundle: R6NegBundle
    let n = R6NegFill(bundle)
    echo(Fmt"r6_neg n={n}")
    return 0
