fn ColdExactSharedVarOverwriteSet(value: var str) =
    value = "updated"

fn ColdExactSharedVarOverwriteRun(source: var str): int32 =
    let borrowed = source
    var alias = borrowed
    var sibling = borrowed
    alias = "owned"
    ColdExactSharedVarOverwriteSet(alias)
    if alias != "updated":
        return 21
    if borrowed != "owner" || sibling != "owner" || source != "owner":
        return 22
    return 0

fn main(): int32 =
    var owner = "owner"
    let code = ColdExactSharedVarOverwriteRun(owner)
    if code != 0:
        return code
    if owner != "owner":
        return 23
    return 0
