import std/result
import std/strformat
import cheng/core/backend/regalloc_production_emitter as regprod
import cheng/core/backend/regalloc_production_artifacts as regart
import cheng/core/backend2/backend2_lower_slots as b2slots
import cheng/core/backend2/backend2_lower_util as b2util
import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/core_types as coreir
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/backend/regalloc_aarch64_adapter as rega64

const SourcePath = "/fixture/generic_load_integer_cast.cheng"
const FunctionName = "Probe"
const LineNumber = 9

fn bindExactTypeArena(body: var coreir.BodyIR) =
    let source = "type Backend2CanonicalScalar = int32\n"
    var tree: parser.ParserValueExprTree
    var authority: typearena.TypedExprTypeResolutionAuthority
    var arena: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err) &&
           typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaComplete(arena) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "generic load cast exact TypeArena fixture")
    assert(coreir.BodyIRBindTypeArenaArtifactCid(
               body, arena.artifactRaw32),
           "generic load cast TypeArena bind")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)

fn nodeText(ir: var texpr.TypedExprIr,
            ids: langintern.InternId[],
            nodeIndex: int32): str =
    let textRes: Result[str] = langintern.LookupIntern(ir.internPool, ids[nodeIndex])
    if IsOk(textRes):
        return Value(textRes)
    return ""

fn addNode(ir: var texpr.TypedExprIr,
           kind: texpr.TypedExprIrOpKind,
           resultType: str,
           surfaceText: str,
           literalText: str,
           paramName: str,
           operand0: int32,
           operand1: int32): int32 =
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.sourcePath = SourcePath
    node.functionName = FunctionName
    node.lineNumber = LineNumber
    node.opKind = kind
    node.resultType = resultType
    node.surfaceText = surfaceText
    node.literalText = literalText
    node.paramName = paramName
    node.paramSlot = -1
    node.operand0NodeIndex = operand0
    node.operand1NodeIndex = operand1
    node.operand2NodeIndex = -1
    return texpr.TypedExprIrAddNode(ir, node)

fn addCast(ir: var texpr.TypedExprIr,
           sourceType: str,
           targetHead: str,
           targetType: str): int32 =
    let sourceNode = addNode(ir,
                             texpr.TypedExprIrOpLocalRef,
                             sourceType,
                             "src",
                             "",
                             "src",
                             -1,
                             -1)
    let linkNode = addNode(ir,
                           texpr.TypedExprIrOpArgLink,
                           sourceType,
                           "src",
                           "",
                           "",
                           sourceNode,
                           -1)
    return addNode(ir,
                   texpr.TypedExprIrOpCallExpr,
                   targetType,
                   Fmt"{targetHead}(src)",
                   targetHead,
                   "",
                   linkNode,
                   -1)

fn bodyHasU32ZeroExtend(body: coreir.BodyIR,
                        finalTarget: int32): bool =
    var sawSignedMachineWiden = false
    var sawU32Mask = false
    var sawI64And = false
    var sawFinalCopy = false
    for opIndex in 0..<body.ops.len:
        let op = body.ops[opIndex]
        if op.kind == coreir.BodyOpCopyLocalTag && op.operands.len >= 1:
            let sourceSlot = op.operands[0]
            if sourceSlot >= 0 && sourceSlot < body.localSlots.len &&
               op.target >= 0 && op.target < body.localSlots.len:
                let sourceKind = body.localSlots[sourceSlot].typeKind
                let targetKind = body.localSlots[op.target].typeKind
                if sourceKind == coreir.LocalI32Tag && targetKind == coreir.LocalI64Tag:
                    sawSignedMachineWiden = true
                if op.target == finalTarget && targetKind == coreir.LocalI64Tag:
                    sawFinalCopy = true
        elif op.kind == coreir.BodyOpLoadConstTag &&
             op.target >= 0 && op.target < body.localSlots.len &&
             body.localSlots[op.target].typeKind == coreir.LocalI64Tag &&
             op.operands.len == 5 &&
             op.operands[0] == coreir.LocalI64Tag &&
             op.operands[1] == 65535 && op.operands[2] == 65535 &&
             op.operands[3] == 0 && op.operands[4] == 0:
            sawU32Mask = true
        elif op.kind == coreir.BodyOpBinOpTag &&
             op.target >= 0 && op.target < body.localSlots.len &&
             body.localSlots[op.target].typeKind == coreir.LocalI64Tag &&
             op.operands.len == 4 &&
             op.operands[0] == coreir.LocalI64Tag &&
             op.operands[1] == int32(texpr.TypedExprIrOpI32BitAnd):
            sawI64And = true
    return sawSignedMachineWiden && sawU32Mask && sawI64And && sawFinalCopy

fn assertBackend2WholeCallU32ToU64() =
    var ir: texpr.TypedExprIr
    let castNode = addCast(ir, "uint32", "uint64", "uint64")
    var typedFn: texpr.TypedExprIrFunction
    typedFn.sourcePath = SourcePath
    typedFn.functionName = FunctionName
    var irFunction: lower.PrimaryObjectIrFunction
    irFunction.sourcePath = SourcePath
    irFunction.functionName = FunctionName
    var lowering: lower.LoweringPlanStub
    var varI32ParamNames: str[]
    var body = coreir.BodyIRNew()
    bindExactTypeArena(body)
    var names: str[]
    let sourceSlot = b2util.PrimaryBodyIrFindOrCreateSlot(body,
                                                          names,
                                                          "src",
                                                          coreir.LocalI32Tag)
    let targetSlot = b2util.PrimaryBodyIrFindOrCreateSlot(body,
                                                          names,
                                                          "dst",
                                                          coreir.LocalI64Tag)
    assert(sourceSlot >= 0 && targetSlot >= 0,
           "backend2 whole-call cast slots")
    var callOrdinal: int32
    assert(b2slots.PrimaryBodyIrAppendWholeCallExprToSlot(body,
                                                          names,
                                                          lowering,
                                                          ir,
                                                          typedFn,
                                                          irFunction,
                                                          varI32ParamNames,
                                                          "uint64(src)",
                                                          targetSlot,
                                                          LineNumber,
                                                          castNode,
                                                          callOrdinal),
           "backend2 whole-call public entry must lower uint32 to uint64")
    assert(callOrdinal == 0 && body.callSequence.len == 0,
           "integer cast must not become a runtime call")
    assert(bodyHasU32ZeroExtend(body, targetSlot),
           "uint32 high-bit widening must mask after arm64 signed machine widen")
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = targetSlot
    add(term.operands, coreir.LocalI64Tag)
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    coreir.BodyIRAppendBlock(body, 0, body.ops.len, termIndex)
    var callTargets: str[]
    var dataTargets: str[]
    let emission = regprod.RegallocProductionEmitFunction(
        "arm64-apple-darwin", body, "WholeCallU32ToU64",
        0, callTargets, dataTargets, 0,
        regart.RegallocProductionFunctionKindNormal)
    assert(emission.valid && emission.receipt.valid &&
           emission.recipes.functionWords.len > 0 &&
           emission.publishedWordCount ==
               emission.recipes.functionWords.len,
           "canonical whole-call cast arm64 emission")
    texpr.TypedExprIrReleasePayload(ir)

fn assertBackend2ClaimedCastMissIsTerminal() =
    var ir: texpr.TypedExprIr
    let castNode = addCast(ir, "unknown", "uint64", "uint64")
    var typedFn: texpr.TypedExprIrFunction
    typedFn.sourcePath = SourcePath
    typedFn.functionName = FunctionName
    var irFunction: lower.PrimaryObjectIrFunction
    irFunction.sourcePath = SourcePath
    irFunction.functionName = FunctionName
    var lowering: lower.LoweringPlanStub
    var varI32ParamNames: str[]
    var body = coreir.BodyIRNew()
    bindExactTypeArena(body)
    var names: str[]
    let _ = b2util.PrimaryBodyIrFindOrCreateSlot(body,
                                                 names,
                                                 "src",
                                                 coreir.LocalI32Tag)
    let targetSlot = b2util.PrimaryBodyIrFindOrCreateSlot(body,
                                                          names,
                                                          "dst",
                                                          coreir.LocalI64Tag)
    let opCountBefore = body.ops.len
    var callOrdinal: int32
    assert(!b2slots.PrimaryBodyIrAppendWholeCallExprToSlot(body,
                                                           names,
                                                           lowering,
                                                           ir,
                                                           typedFn,
                                                           irFunction,
                                                           varI32ParamNames,
                                                           "uint64(src)",
                                                           targetSlot,
                                                           LineNumber,
                                                           castNode,
                                                           callOrdinal),
           "claimed integer cast with missing type evidence must fail")
    assert(body.ops.len == opCountBefore && body.callSequence.len == 0 &&
           callOrdinal == 0,
           "claimed cast failure must not enter text rescue")
    texpr.TypedExprIrReleasePayload(ir)

fn assertBackend2LoadEmitterCase(loadKind: int32,
                                  targetKind: int32,
                                  loadSize: int32) =
    var body = coreir.BodyIRNew()
    bindExactTypeArena(body)
    var names: str[]
    let pointerSlot = b2util.PrimaryBodyIrFindOrCreateSlot(body,
                                                           names,
                                                           "ptr",
                                                           coreir.LocalPtrTag)
    let targetSlot = b2util.PrimaryBodyIrFindOrCreateSlot(body,
                                                          names,
                                                          "value",
                                                          targetKind)
    var loadOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(loadOp)
    loadOp.kind = coreir.BodyOpLoadLocalTag
    loadOp.target = targetSlot
    add(loadOp.operands, loadKind)
    add(loadOp.operands, pointerSlot)
    add(loadOp.operands, loadSize)
    add(body.ops, loadOp)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = targetSlot
    add(term.operands, targetKind)
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    coreir.BodyIRAppendBlock(body, 0, body.ops.len, termIndex)
    var callTargets: str[]
    var dataTargets: str[]
    let emission = regprod.RegallocProductionEmitFunction(
        "arm64-apple-darwin", body, "StdLoadContract",
        0, callTargets, dataTargets, 0,
        regart.RegallocProductionFunctionKindNormal)
    assert(emission.valid && emission.receipt.valid &&
           emission.recipes.functionWords.len > 0 &&
           emission.publishedWordCount ==
               emission.recipes.functionWords.len,
           "canonical std load emission contract")
    if loadKind == coreir.BodyLoadLocalPtrDerefU8Tag:
        assert(loadSize == 1 && targetKind == coreir.LocalI32Tag,
               "U8 load shape")
    elif loadKind == coreir.BodyLoadLocalPtrDerefI32Tag:
        assert(loadSize == 4 && targetKind == coreir.LocalI32Tag,
               "I32 load shape")
    else:
        assert(loadKind == coreir.BodyLoadLocalPtrDerefU64Tag &&
               loadSize == 8 && targetKind == coreir.LocalI64Tag,
               "U64 load shape")
    var sawLoadOwner = false
    for recipeIndex in 0..<emission.recipes.recipes.len:
        let recipe = emission.recipes.recipes[recipeIndex]
        if recipe.ownsBodyOp &&
           recipe.producerOpKind == coreir.BodyOpLoadLocalTag &&
           recipe.words.len > 0:
            sawLoadOwner = true
    assert(sawLoadOwner,
           "canonical allocator action must own the load instruction")

fn assertBackend2ExplicitGenericLoadTypeContract() =
    var ir: texpr.TypedExprIr
    let pointerNode = addNode(ir,
                              texpr.TypedExprIrOpLocalRef,
                              "ptr",
                              "p",
                              "",
                              "p",
                              -1,
                              -1)
    let linkNode = addNode(ir,
                           texpr.TypedExprIrOpArgLink,
                           "ptr",
                           "p",
                           "",
                           "",
                           pointerNode,
                           -1)
    let loadNode = addNode(ir,
                           texpr.TypedExprIrOpCallExpr,
                           "uint8",
                           "load[uint8](p)",
                           "load[uint8]",
                           "",
                           linkNode,
                           -1)
    var targetKind: int32
    var loadKind: int32
    var loadSize: int32
    assert(b2slots.PrimaryBodyIrStdSystemLoadNodeTypeContract(ir,
                                                              loadNode,
                                                              targetKind,
                                                              loadKind,
                                                              loadSize) &&
           targetKind == coreir.LocalI32Tag &&
           loadKind == coreir.BodyLoadLocalPtrDerefU8Tag &&
           loadSize == 1,
           "explicit generic load type must select one-byte memory access")
    texpr.TypedExprIrReleasePayload(ir)

fn assertParserExplicitGenericCallFact() =
    var layer: parser.NormalizedExprLayer
    var err: str
    let sourceText = "fn genericValue(p: ptr): T =\n    var out: T\n    return out\n\nfn Probe(p: ptr): uint8 =\n    return genericValue[uint8](p)\n"
    assert(parser.ParserReadNormalizedExprLayerFromText(SourcePath,
                                                         sourceText,
                                                         layer,
                                                         err),
           Fmt"explicit generic parser fixture failed: {err}")
    var callCount: int32
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.kind == parser.NormalizedExprCall &&
           expr.callCallee == "genericValue" &&
           expr.callArgsText == "p" && expr.callArgCount == 1:
            callCount = callCount + 1
    assert(callCount == 1,
           "explicit generic call must produce one canonical resolved-call fact")
    parser.NormalizedExprLayerReset(layer)

fn producerSource(): texpr.TypedExprSourceText =
    var externalRoots: parser.ParserExternalPackageRoot[]
    let sourceText = """
    fn genericValue(p: ptr): T =
        var out: T
        return out

    fn concreteValue(): int32 =
        return 7

    fn Probe(p: ptr, states: uint8[]): uint64 =
        let direct: uint64 = genericValue(p)
        let nested: uint64 = uint64(genericValue[uint8](p))
        let state: uint32 = uint32(states[0])
        let seqLen: int32 = len(states)
        let elemBytes: int32 = elemSize[uint8]()
        let typeBytes: int32 = int32(sizeof(uint64))
        let concrete: int32 = concreteValue()
        return nested + uint64(state)
    """
    return texpr.TypedExprSourceTextNewWithPackageFacts(
        "/fixture",
        "/fixture",
        "pkg://fixture/generic-producer",
        "stable",
        externalRoots,
        SourcePath,
        sourceText)

fn assertProducerGenericContract() =
    var resultType: str
    assert(texpr.TypedExprCallHeadSingleConcreteGenericType(
               "system.load[uint8]") == "uint8" &&
           texpr.TypedExprCallHeadSingleConcreteGenericType("load[T]") == "",
           "explicit generic call type evidence")
    assert(texpr.TypedExprWholeCallResultTypeWithExpected("T", "uint64", resultType) &&
           resultType == "uint64",
           "bare generic return expected type binding")
    assert(!texpr.TypedExprWholeCallResultTypeWithExpected("T", "", resultType),
           "bare generic return requires concrete context")
    assert(!texpr.TypedExprWholeCallResultTypeWithExpected("refT", "uint64", resultType),
           "ref generic cannot lose wrapper to scalar expected type")
    assert(!texpr.TypedExprWholeCallResultTypeWithExpected("varT", "uint64", resultType),
           "var generic cannot lose wrapper to scalar expected type")
    assert(!texpr.TypedExprWholeCallResultTypeWithExpected("refT", "refWidget", resultType),
           "wrapped generic requires structural substitution")
    assert(!texpr.TypedExprWholeCallResultTypeWithExpected("int32", "uint64", resultType),
           "concrete return conflict hard fail")
    assert(texpr.TypedExprWholeCallResultTypeWithExpected("int32", "int32", resultType) &&
           resultType == "int32",
           "concrete return identity")

    var sources: texpr.TypedExprSourceText[]
    add(sources, producerSource())
    var ir: texpr.TypedExprIr
    var err: str
    assert(texpr.TypedExprBuildIr(sources, ir, err),
           Fmt"generic producer build failed: {err}")
    var genericCount: int32
    var explicitGenericU8Node: int32 = -1
    var indexedCastNode: int32 = -1
    var sawLenCall = false
    var sawConcreteCall = false
    var sawElemSizeConst = false
    var sawSizeofConst = false
    for nodeIndex in 0..<ir.nodes2_nodeIndexs.len:
        if ir.nodes2_opKinds[nodeIndex] == texpr.TypedExprIrOpI32Const:
            let literal = nodeText(ir, ir.nodes2_literalTextIds, nodeIndex)
            if literal == "1":
                sawElemSizeConst = true
            elif literal == "8":
                sawSizeofConst = true
        if ir.nodes2_opKinds[nodeIndex] != texpr.TypedExprIrOpCallExpr:
            continue
        let head = nodeText(ir, ir.nodes2_literalTextIds, nodeIndex)
        let nodeResult = nodeText(ir, ir.nodes2_resultTypeIds, nodeIndex)
        if head == "genericValue":
            assert(nodeResult == "uint64",
                   "bare generic producer must use a concrete sink context")
            genericCount = genericCount + 1
        elif head == "genericValue[uint8]":
            assert(nodeResult == "uint8",
                   "explicit generic producer width must survive outer cast")
            explicitGenericU8Node = nodeIndex
        elif head == "uint32":
            let argNode = b2slots.PrimaryBodyIrCastCallArgNodeIndex(ir, nodeIndex)
            if argNode >= 0 && ir.nodes2_opKinds[argNode] == texpr.TypedExprIrOpIndexGet:
                indexedCastNode = nodeIndex
                assert(nodeText(ir, ir.nodes2_resultTypeIds, argNode) == "uint8",
                       "IndexGet source type must remain uint8")
        elif head == "len":
            sawLenCall = nodeResult == "int32"
        elif head == "concreteValue":
            sawConcreteCall = nodeResult == "int32"
    assert(genericCount == 1 && explicitGenericU8Node >= 0,
           "direct sink and explicit nested generic producer nodes")
    assert(indexedCastNode >= 0,
           "uint32(IndexGet:uint8) producer node")
    assert(sawLenCall && sawConcreteCall,
           "concrete whole calls retain ordinary structured builder")
    assert(sawElemSizeConst && sawSizeofConst,
           "sizeof and elemSize retain structured constant folding")
    texpr.TypedExprIrReleasePayload(ir)

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister():
        return 90
    assertParserExplicitGenericCallFact()
    assertProducerGenericContract()
    assertBackend2WholeCallU32ToU64()
    assertBackend2ClaimedCastMissIsTerminal()
    assertBackend2ExplicitGenericLoadTypeContract()
    assertBackend2LoadEmitterCase(coreir.BodyLoadLocalPtrDerefU8Tag,
                                  coreir.LocalI32Tag,
                                  1)
    assertBackend2LoadEmitterCase(coreir.BodyLoadLocalPtrDerefI32Tag,
                                  coreir.LocalI32Tag,
                                  4)
    assertBackend2LoadEmitterCase(coreir.BodyLoadLocalPtrDerefU64Tag,
                                  coreir.LocalI64Tag,
                                  8)
    echo("typed_expr_generic_load_integer_cast_contract_smoke ok")
    return 0
