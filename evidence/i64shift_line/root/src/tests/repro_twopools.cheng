import std/system
import cheng/core/lang/intern as langintern

fn main() =
    var p1 = langintern.InternPoolNew()
    let a1 = langintern.Intern(p1, "alpha")
    let b1 = langintern.Intern(p1, "beta")
    echo(Fmt"p1 a={a1} b={b1} count={langintern.InternPoolCount(p1)}")
    var p2 = langintern.InternPoolNew()
    let a2 = langintern.Intern(p2, "alpha")
    let b2 = langintern.Intern(p2, "beta")
    echo(Fmt"p2 a={a2} b={b2} count={langintern.InternPoolCount(p2)}")
    langintern.InternPoolRelease(p1)
    langintern.InternPoolRelease(p2)
    echo("repro_twopools done")
