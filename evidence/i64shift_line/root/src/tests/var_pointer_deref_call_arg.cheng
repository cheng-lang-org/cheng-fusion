# `*ptr` of a value-object pointer must bind a `var T` formal.

type
    Node =
        used: bool
        n: int32

var
    gNode: Node
    gPtr: Node*

fn clearNode(node: var Node) =
    node.used = false
    node.n = 0

fn main(): int32 =
    gNode.used = true
    gNode.n = 7
    gPtr = &gNode
    let node: Node* = gPtr
    if node != nil:
        clearNode(*node)
    if gNode.used:
        return 1
    if gNode.n != 0:
        return 2
    return 0
