# Reverse-direction gossipsub RPC golden probe(WebTransport slice-4).
#
# Reads the 9 wire-format vectors a TS encoder(React.js repo,
# app/libp2p/gossipsubRpc.ts) produced into a fixed directory and checks
# each one is BYTE-IDENTICAL to the same vector independently re-derived
# here from the real production LEB128-varint + tag + length-delimited
# primitives(InitProtoBuffer/writeString/writeVarint/writeBytes/
# protoToBytes, from cheng/libp2p/protobuf/minprotobuf.cheng --
# same primitives cheng/libp2p/protocols/pubsub/rpc/protobuf.cheng's
# encodePubsubRPC/encodePubsubControl/... are themselves built from; see
# webtransport_gossipsub_golden_probe.cheng's header comment for the full
# account of why this probe calls those primitives directly instead of
# the field-level Pubsub encoders).
#
# Byte-for-byte equality against an independently-computed reference is a
# strictly STRONGER check than decoding into fields and comparing them
# (it also catches field-order bugs and any other encoding-detail
# divergence, not just wrong field values) -- it is used here as the
# primary assertion. It replaces a getField()-based structural decode
# because of a second, independently confirmed pinned-driver
# (seed-rescue-20260709/cheng.stage3) limitation: calling ANY of
# minprotobuf's getField/GetFieldBytes/GetFieldInt64/GetFieldString
# family from a fresh single-entry probe reliably corrupts type-identity
# resolution for OTHER, unrelated calls in the same compile unit(observed
# 5 independent failure signatures across different getField call
# combinations, including one that broke the previously-working
# protoToBytes() itself with a fabricated `stdpb.GrowByteBuffer` vs
# `buffer.GrowByteBuffer` type mismatch purely because a getField call
# was added earlier in the same file) -- decode-side primitives are not
# reliably usable from this pinned driver in this compile mode at all,
# independent of the Pubsub-type-family issue documented in the golden
# probe. Both are pinned cold-compiler resolver bugs, out of this task's
# scope to fix.

import std/system
import std/os
import std/multiformats/protobuf/minprotobuf

const
    goldenTopic = "unimaker/content/v1"
    goldenPayloadJson = "{\"contentId\":\"c1\",\"postId\":\"c1\",\"text\":\"hello\"}"
    goldenSeqno = "1"
    tsVectorDir = "/tmp/wt4_ts_vectors"

    # Verbatim from cheng/libp2p/protocols/pubsub/rpc/protobuf.cheng's own
    # `const` block -- identical to webtransport_gossipsub_golden_probe.cheng.
    rpcSubField = 1
    rpcMsgField = 2
    rpcControlField = 3
    subTopicField = 1
    subSubscribeField = 2
    msgDataField = 2
    msgSeqnoField = 3
    msgTopicField = 4
    controlIHaveField = 1
    controlIWantField = 2
    controlGraftField = 3
    controlPruneField = 4
    controlIDontWantField = 5
    iHaveTopicField = 1
    iHaveMsgIdField = 2
    iWantTopicField = 1
    iWantMsgIdField = 2
    iDontWantTopicField = 1
    iDontWantMsgIdField = 2
    graftTopicField = 1
    pruneTopicField = 1

fn encodeSubscription(topic: str, subscribe: bool): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, subTopicField, topic)
    if subscribe:
        writeVarint(pb, subSubscribeField, 1)
    return protoToBytes(pb)

fn encodeMessageNoFrom(topic: str, seqno: str, dataJson: str): Bytes =
    var pb = InitProtoBuffer()
    writeBytes(pb, msgSeqnoField, BytesFromString(seqno))
    writeString(pb, msgTopicField, topic)
    writeBytes(pb, msgDataField, BytesFromString(dataJson))
    return protoToBytes(pb)

fn encodeIHave(topic: str, id0: str, id1: str, idCount: int32): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, iHaveTopicField, topic)
    if idCount >= 1:
        writeBytes(pb, iHaveMsgIdField, BytesFromString(id0))
    if idCount >= 2:
        writeBytes(pb, iHaveMsgIdField, BytesFromString(id1))
    return protoToBytes(pb)

fn encodeIWant(topic: str, id0: str, id1: str, idCount: int32): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, iWantTopicField, topic)
    if idCount >= 1:
        writeBytes(pb, iWantMsgIdField, BytesFromString(id0))
    if idCount >= 2:
        writeBytes(pb, iWantMsgIdField, BytesFromString(id1))
    return protoToBytes(pb)

fn encodeIDontWant(topic: str, id0: str, id1: str, idCount: int32): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, iDontWantTopicField, topic)
    if idCount >= 1:
        writeBytes(pb, iDontWantMsgIdField, BytesFromString(id0))
    if idCount >= 2:
        writeBytes(pb, iDontWantMsgIdField, BytesFromString(id1))
    return protoToBytes(pb)

fn encodeGraft(topic: str): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, graftTopicField, topic)
    return protoToBytes(pb)

fn encodePrune(topic: str): Bytes =
    var pb = InitProtoBuffer()
    writeString(pb, pruneTopicField, topic)
    return protoToBytes(pb)

fn encodeControl(
    ihaveBytes: Bytes, hasIhave: bool,
    iwantBytes: Bytes, hasIwant: bool,
    graftBytes: Bytes, hasGraft: bool,
    pruneBytes: Bytes, hasPrune: bool,
    idontwantBytes: Bytes, hasIdontwant: bool
): Bytes =
    var pb = InitProtoBuffer()
    if hasIhave:
        writeBytes(pb, controlIHaveField, ihaveBytes)
    if hasIwant:
        writeBytes(pb, controlIWantField, iwantBytes)
    if hasGraft:
        writeBytes(pb, controlGraftField, graftBytes)
    if hasPrune:
        writeBytes(pb, controlPruneField, pruneBytes)
    if hasIdontwant:
        writeBytes(pb, controlIDontWantField, idontwantBytes)
    return protoToBytes(pb)

fn encodeRpc(
    subBytes: Bytes, hasSub: bool,
    msgBytes: Bytes, hasMsg: bool,
    ctrlBytes: Bytes, hasCtrl: bool
): Bytes =
    var pb = InitProtoBuffer()
    if hasSub:
        writeBytes(pb, rpcSubField, subBytes)
    if hasMsg:
        writeBytes(pb, rpcMsgField, msgBytes)
    if hasCtrl:
        writeBytes(pb, rpcControlField, ctrlBytes)
    return protoToBytes(pb)

fn checkVector(name: str, expected: var Bytes) =
    let path: str = tsVectorDir + "/" + name + ".body.bin"
    let readRes = ReadFileBytesResult(path)
    if IsErr(readRes):
        panic("ts roundtrip: read " + path + ": " + ErrorText(readRes))
    var actual = Value(readRes)
    if ! BytesEqual(actual, expected):
        panic("ts roundtrip: " + name + " byte mismatch: ts_hex=" + BytesToHex(actual) + " want_hex=" + BytesToHex(expected))
    echo("vector=" + name + " ts_bytes_match_cheng_reference=true len=" + IntToStr(BytesLen(actual)))

fn main(): int32 =
    let emptyB = EmptyBytes()

    var subBytesV1 = encodeSubscription(goldenTopic, true)
    var bodyV1 = encodeRpc(subBytesV1, true, emptyB, false, emptyB, false)
    checkVector("v1_subscribe", bodyV1)

    var subBytesV2 = encodeSubscription(goldenTopic, false)
    var bodyV2 = encodeRpc(subBytesV2, true, emptyB, false, emptyB, false)
    checkVector("v2_unsubscribe", bodyV2)

    var msgBytesV3 = encodeMessageNoFrom(goldenTopic, goldenSeqno, goldenPayloadJson)
    var bodyV3 = encodeRpc(emptyB, false, msgBytesV3, true, emptyB, false)
    checkVector("v3_publish", bodyV3)

    var ihaveBytesV4 = encodeIHave(goldenTopic, "QmGoldenMsgId0001", "QmGoldenMsgId0002", 2)
    var ctrlBytesV4 = encodeControl(ihaveBytesV4, true, emptyB, false, emptyB, false, emptyB, false, emptyB, false)
    var bodyV4 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV4, true)
    checkVector("v4_control_ihave", bodyV4)

    var iwantBytesV5 = encodeIWant(goldenTopic, "QmGoldenMsgId0003", "QmGoldenMsgId0004", 2)
    var ctrlBytesV5 = encodeControl(emptyB, false, iwantBytesV5, true, emptyB, false, emptyB, false, emptyB, false)
    var bodyV5 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV5, true)
    checkVector("v5_control_iwant", bodyV5)

    var idontwantBytesV6 = encodeIDontWant(goldenTopic, "QmGoldenMsgId0005", "QmGoldenMsgId0006", 2)
    var ctrlBytesV6 = encodeControl(emptyB, false, emptyB, false, emptyB, false, emptyB, false, idontwantBytesV6, true)
    var bodyV6 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV6, true)
    checkVector("v6_control_idontwant", bodyV6)

    var graftBytesV7 = encodeGraft(goldenTopic)
    var ctrlBytesV7 = encodeControl(emptyB, false, emptyB, false, graftBytesV7, true, emptyB, false, emptyB, false)
    var bodyV7 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV7, true)
    checkVector("v7_control_graft", bodyV7)

    var pruneBytesV8 = encodePrune(goldenTopic)
    var ctrlBytesV8 = encodeControl(emptyB, false, emptyB, false, emptyB, false, pruneBytesV8, true, emptyB, false)
    var bodyV8 = encodeRpc(emptyB, false, emptyB, false, ctrlBytesV8, true)
    checkVector("v8_control_prune", bodyV8)

    var subBytesV9 = encodeSubscription(goldenTopic, true)
    var msgBytesV9 = encodeMessageNoFrom(goldenTopic, goldenSeqno, goldenPayloadJson)
    var ihaveBytesV9 = encodeIHave(goldenTopic, "QmGoldenMsgId0001", "", 1)
    var iwantBytesV9 = encodeIWant(goldenTopic, "QmGoldenMsgId0003", "", 1)
    var idontwantBytesV9 = encodeIDontWant(goldenTopic, "QmGoldenMsgId0005", "", 1)
    var graftBytesV9 = encodeGraft(goldenTopic)
    var pruneBytesV9 = encodePrune(goldenTopic)
    var ctrlBytesV9 = encodeControl(
        ihaveBytesV9, true,
        iwantBytesV9, true,
        graftBytesV9, true,
        pruneBytesV9, true,
        idontwantBytesV9, true
    )
    var bodyV9 = encodeRpc(subBytesV9, true, msgBytesV9, true, ctrlBytesV9, true)
    checkVector("v9_combo", bodyV9)

    echo("webtransport_gossipsub_ts_roundtrip_probe ok")
    return 0
