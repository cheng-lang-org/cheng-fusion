# Nested `None[T]()` inside an aggregate constructor must materialize the
# Option value, not be misclassified as a type constructor named `None[T]`.

import std/option

type
    Wrapper =
        value: Option[str]

fn makeWrapper(): Wrapper =
    Wrapper(value: None[str]())

fn main(): int32 =
    let wrapped: Wrapper = makeWrapper()
    if wrapped.value.has:
        return 1
    return 0
