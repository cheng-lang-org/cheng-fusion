type NegCallLeaf = ref object
    value: int32

type NegCallRoot =
    leaf: NegCallLeaf

fn NegCallLeafBump(leaf: var NegCallLeaf) =
    leaf.value = leaf.value + 1

fn NegCallMakeRoot(): NegCallRoot =
    var root: NegCallRoot
    root.leaf = new(NegCallLeaf)
    return root

# A call result is a temporary, not a place: passing its field to a `var`
# formal must hard-fail instead of fabricating the address of the temporary.
fn main(): int32 =
    NegCallLeafBump(NegCallMakeRoot().leaf)
    return 0
