# LSP JSON-RPC wire smoke. Semantic symbols/references are never reconstructed
# here; production queries consume the atomically published snapshot.

import std/json as json
import std/strings
import cheng/core/tooling/lsp_protocol as lsp

fn MakeDidOpenMessage(): json.JsonNode =
    var message = json.NewJObject()
    message["jsonrpc"] = "2.0"
    message["method"] = "textDocument/didOpen"
    var params = json.NewJObject()
    var document = json.NewJObject()
    document["uri"] = "file:///src/main.cheng"
    document["languageId"] = "cheng"
    document["version"] = json.NewJInt(int64(1))
    document["text"] = "fn Main(): int32 =\n    return 0\n"
    params["textDocument"] = document
    message["params"] = params
    return message

fn main() =
    let serialized = json.Stringify(MakeDidOpenMessage())
    assert(strings.Len(serialized) > 0 &&
           strings.StrContains(serialized, "textDocument/didOpen"),
           "lsp server smoke: JSON-RPC serialization drift")
    let range = lsp.LspMakeRange(0, 3, 0, 7)
    let location = lsp.LspMakeLocation("file:///src/main.cheng", range)
    let diagnostic = lsp.LspMakeDiagnostic(
        range, lsp.DsError, "parse_error", "cheng", "invalid syntax")
    assert(location.uri == "file:///src/main.cheng" &&
           diagnostic.range.start.character == 3 &&
           int32(diagnostic.severity) == 1,
           "lsp server smoke: protocol structure drift")
