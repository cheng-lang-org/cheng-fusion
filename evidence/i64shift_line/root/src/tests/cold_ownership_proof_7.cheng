// Ownership proof 7: rewrite safety via single-writer dominator proof
// Tests that identity rewrites correctly apply under ownership constraints:
//   - No-alias local scalar detection (distinct locals are non-aliasing)
//   - Single-writer dominator proof (each slot has exactly one live writer)
//   - Ownership report fields populated on compilation

fn main(): int32 =
    // No-alias test: distinct locals a and b are provably non-aliasing
    // Each identity rewrite must check that the constant operand's writer
    // dominates the use and has single-writer ownership.
    let base = 7

    // x + 0 -> x (add identity, requires single-writer on 0)
    let add_id = base + 0
    if add_id != 7: return 1

    // x - 0 -> x (sub identity, requires single-writer on 0)
    let sub_id = base - 0
    if sub_id != 7: return 2

    // x * 2 -> x << 1 (strength reduction, requires single-writer on 2)
    let mul_str = base * 2
    if mul_str != 14: return 3

    // x == x -> 1 (self-equality, same-slot comparison rewrite)
    let self_eq = base == base
    if self_eq != 1: return 4

    // x != x -> 0 (self-inequality, requires dominator proof on same slot)
    let self_ne = base != base
    if self_ne != 0: return 5

    // Single-writer proof: local_0 is CONST 7 with exactly one live writer.
    // The dominator chain CONST -> COPY -> use must be traceable through
    // the COPY forwarding logic in cold_apply_identity_rewrites.
    let local_0 = 7
    let local_1 = local_0 + 0
    if local_1 != 7: return 6

    let local_2 = local_0 - 0
    if local_2 != 7: return 7

    let local_3 = local_0 * 2
    if local_3 != 14: return 8

    // Comparison identity tests (self-referential slot checking)
    let cmp_a = 3
    if cmp_a == cmp_a:       // x == x -> 1, must be true
        let cmp_b = 4
    else:
        return 9

    if cmp_a != cmp_a:       // x != x -> 0, must be false
        return 10

    echo(" ownership_proof_7 ok")
    return 0
