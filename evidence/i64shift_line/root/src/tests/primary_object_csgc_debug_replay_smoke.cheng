import std/os
import std/rawbytes
import std/strings
import cheng/core/backend/debug_facts as debug
import cheng/core/backend/direct_object_emit as direct
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/primary_object_csgc_cargo as cargo
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/csg_core/csgc
import cheng/tests/debug_emission_receipt_smoke as fixture
import cheng/tests/debug_section_plan_backend_consumption_smoke as plansupport
import cheng/tests/debug_section_plan_receipt_smoke as support

@borrows
fn expectedDebugObjectBytes(
        plan: var pobj.PrimaryObjectPlan):
        rawbytes.Bytes =
    var text = direct.DirectObjectEmitPlanText(plan)
    defer:
        rawbytes.BytesFree(text)
    var data =
        direct.DirectObjectEmitPlanData(
            plan, plan.functionBodyKinds.len)
    defer:
        rawbytes.BytesFree(data)
    var symbols: osym.ObjectSymbolTable
    direct.DirectObjectEmitPlanSymbolsInto(
        plan, plan.targetTriple, symbols)
    var relocs: orel.ObjectRelocTable
    direct.DirectObjectEmitPlanRelocsInto(
        plan, symbols, relocs)
    var out: rawbytes.Bytes
    var relocCount: int32
    var err: str
    assert(
        direct.DirectObjectEmitPlanObjectBytesInto(
            plan,
            text,
            data,
            symbols,
            relocs,
            out,
            relocCount,
            err),
        strings.ConcatStr(
            "primary object CSGC debug smoke: direct bytes ",
            err))
    assert(
        relocCount == 4,
        "primary object CSGC debug smoke: direct reloc count")
    return out

fn main(): int32 =
    var err: str
    var bodyFacts: debug.DebugFactBundle
    support.BuildFacts("primary-object-csgc-debug", bodyFacts)
    var bindingFacts: debug.DebugFactBundle
    support.BuildFacts("primary-object-csgc-debug", bindingFacts)
    var evidenceFacts: debug.DebugFactBundle
    support.BuildFacts("primary-object-csgc-debug", evidenceFacts)
    var lowering: lower.LoweringPlanStub
    let retainedBody = fixture.BuildBody(bodyFacts, lowering)
    let binding = support.MakeBindingReceipt(bindingFacts, lowering)
    assert(
        lower.LoweringPlanBindPublishedDebugBindingReceiptInto(
            lowering, binding, err),
        err)

    var planEvidence = support.MakeEvidence(evidenceFacts)
    planEvidence.backendKind = "primary"
    var plan = plansupport.MakePrimaryPlan(
        planEvidence, "primary")
    plan.targetTriple = "arm64-apple-darwin"
    plan.objectFormat = "macho"
    plan.outputPath =
        "/tmp/primary-object-csgc-debug-replay-smoke.o"
    plan.entrySymbol = "_Main"
    plan.entryFunctionSymbol = "_Main"
    plan.itemIds = [int32(1)]
    plan.instructionWords = [
        int32(-721215457),
        int32(-698416192)]
    assert(
        pobj.PrimaryObjectPlanConsumeDebugSectionPlanReceiptInto(
            lowering, plan, err),
        err)

    var expected = expectedDebugObjectBytes(plan)
    defer:
        rawbytes.BytesFree(expected)
    var built = cargo.PrimaryObjectCsgcCargoBuild(plan)
    defer:
        cargo.PrimaryObjectCsgcCargoRelease(built)
    assert(
        built.ok,
        strings.ConcatStr(
            "primary object CSGC debug smoke: build ",
            built.error))

    let decoded = csgc.CsgCoreCsgcDecodeLines(built.bytes)
    assert(
        decoded.ok && decoded.factCount == built.factCount,
        "primary object CSGC debug smoke: decode")
    var debugManifestSeen = false
    var debugSectionFactCount: int32
    var debugRelocationFactCount: int32
    for lineIndex in 0..<decoded.lines.len:
        let line = decoded.lines[lineIndex]
        if strings.StrContains(line, "\"debugValid\":true"):
            debugManifestSeen = true
        if strings.StrContains(
               line,
               "\"kind\":\"csg_dialect::native::object_section_chunk\"") &&
           (strings.StrContains(line, "\"section\":\"debug_line\"") ||
            strings.StrContains(line, "\"section\":\"debug_info\"") ||
            strings.StrContains(line, "\"section\":\"debug_abbrev\"")):
            debugSectionFactCount = debugSectionFactCount + 1
        if strings.StrContains(
               line,
               "\"kind\":\"csg_dialect::native::object_debug_relocation\""):
            debugRelocationFactCount =
                debugRelocationFactCount + 1
    assert(
        debugManifestSeen && debugSectionFactCount >= 3 &&
        debugRelocationFactCount == 4,
        "primary object CSGC debug smoke: facts incomplete")

    var replay =
        cargo.PrimaryObjectCsgcCargoReplay(
            built.bytes,
            built.proofBytes,
            built.factsRoot,
            plan.targetTriple,
            plan.objectFormat)
    defer:
        cargo.PrimaryObjectCsgcReplayRelease(replay)
    assert(
        replay.ok,
        strings.ConcatStr(
            "primary object CSGC debug smoke: replay ",
            replay.error))
    assert(
        rawbytes.BytesEqual(expected, replay.objectBytes) &&
        replay.relocationCount == 4 &&
        replay.planRoot == built.planRoot,
        "primary object CSGC debug smoke: replay drift")

    os.WriteLine(
        os.GetStdout(),
        "primary_object_csgc_debug_replay_equal=1")
    os.WriteLine(
        os.GetStdout(),
        "primary_object_csgc_debug_replay_smoke_status=pass")
    return 0
