import cheng/std/bytes_layout as layout

@borrows
fn copyBorrowedPlainValues(
        values: layout.FixedBytes32[]): layout.FixedBytes32[] =
    if values.len != 2:
        return []
    return [values[0], values[1]]

fn main(): int32 =
    let first = layout.FixedBytes32()
    let second = layout.FixedBytes32()
    let values = [first, second]
    let copied = copyBorrowedPlainValues(values)
    if copied.len != 2:
        return 1
    return 0
