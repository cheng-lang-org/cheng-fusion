import std/system

@importc("getenv")
fn repro_getenv_bridge(name: cstring): cstring

fn wrapper(name: str): str =
    let raw = repro_getenv_bridge(strToCStringTemp(name))
    let s: str = if raw == nil: "" else: strFromCStringCopy(raw)
    return s

fn main(): int32 =
    let r = wrapper("HOME")
    return 0
