fn R20Piece(n: int32): str =
    if n == 0:
        return "alpha"
    if n == 1:
        return "bravo"
    return "charliex"

fn R20WhileSum(limit: int32, stopAt: int32): int32 =
    var total: int32
    var i: int32
    while i < limit:
        let piece = R20Piece(i)
        if i == stopAt:
            return total + 1000
        total = total + piece.len
        i = i + 1
    return total

fn R20ForSum(limit: int32, stopAt: int32): int32 =
    var total: int32
    for i in 0..<limit:
        let piece = R20Piece(i)
        if i == stopAt:
            return total + 1000
        total = total + piece.len
    return total

fn main(): int32 =
    if R20WhileSum(3, -1) != 18:
        return 10
    if R20WhileSum(3, 2) != 1010:
        return 11
    if R20WhileSum(3, 0) != 1000:
        return 12
    if R20ForSum(3, -1) != 18:
        return 13
    if R20ForSum(3, 2) != 1010:
        return 14
    if R20ForSum(3, 0) != 1000:
        return 15
    echo("tk_r20_loopdrop ok while=18/1010/1000 for=18/1010/1000")
    return 0
