fn R20Make(n: int32): str =
    if n > 0:
        return "continue"
    return "break"

fn R20Append(limit: int32): int32 =
    var total: int32
    for i in 0..<limit:
        let surfaceText = R20Make(i)
        if i > 5:
            return total
        total = total + surfaceText.len
    return total

fn main(): int32 =
    let n = R20Append(2)
    if n != 13:
        return 10
    echo("r20 ok")
    return 0
