# Runtime step injection probe (game v0.2 behavior layer): the six-step
# walk scene runs, and at tick 300 two extra footsteps are queued onto the
# live execution state (the established route extended along +x). The
# dynamic steps must obey the exact static footstep semantics: landing
# anchor spawned at startTick, bounded-rate StepPull winch to plantLen,
# release with a FootstepDone event at endTick. Assertions: queue rows
# stay inert until startTick, anchors materialize at the queued landings,
# completion events fire once per dynamic step, zero rejected physics
# steps, the pelvis advances strictly across the dynamic windows, the
# static footstep segment is untouched, and the double run is
# chain-CID deterministic.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/world3d
import cheng/game/physics3d
import std/strings as strings

const
    ProbeTicks = 2400
    ProbeQueueTick = 300
    ProbeStep1Start = 1200
    ProbeStep1End = 1470
    ProbeStep2Start = 1335
    ProbeStep2End = 1605
    ProbeFootL = 5
    ProbeFootR = 6

# Runs the walk scene with two steps injected at tick 300; returns the
# execution chain CID, or "" on failure (the failure reason is echoed).
fn runInject(): str =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildWalkScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL dyn facts validation")
        return ""
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL dyn materialize")
        return ""
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    let staticSteps: int32 = facts.stepPart.len
    if st.dynFootStart != staticSteps:
        echo("FAIL dyn segment origin")
        return ""
    let dyn0: int32 = staticSteps
    let dyn1: int32 = staticSteps + 1
    let pelvisSlot = mp.partSlot[0]
    var pxBefore: float64 = 0.0
    var pxAfter: float64 = 0.0
    var tick: int32 = 0
    while tick < ProbeTicks:
        if tick == ProbeQueueTick:
            # the established route extended along +x: landings 1.05 m and
            # 1.25 m continue the 0.25 m shuffle lane past the static film
            execution.CsgExecutionQueueStep(st, ProbeFootR, 1.05, 0.85, 0.06,
                int64(ProbeStep1Start), int64(ProbeStep1End), 0.80, 0.02)
            execution.CsgExecutionQueueStep(st, ProbeFootL, 1.25, 0.85, 0.06,
                int64(ProbeStep2Start), int64(ProbeStep2End), 0.80, 0.02)
            if st.footCon.len != staticSteps + 2:
                echo("FAIL dyn queue length")
                return ""
            if st.footCon[dyn0] != -1 || st.footCon[dyn1] != -1:
                echo("FAIL dyn queue fired early")
                return ""
            if st.footDone[dyn0] != 0 || st.footDone[dyn1] != 0:
                echo("FAIL dyn queue state dirty")
                return ""
        if tick == ProbeStep1Start:
            pxBefore = st.w.bodyPx[pelvisSlot]
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL dyn step rejected")
            echo("tick=" + strings.Int64ToStr(receipt.tick))
            return ""
        if tick == ProbeStep1Start:
            let a0 = st.footAnchor[dyn0]
            if st.footCon[dyn0] < 0 || a0 < 0:
                echo("FAIL dyn anchor1 missing")
                return ""
            if st.w.bodyKind[a0] != world3d.World3dBodyAnchor:
                echo("FAIL dyn anchor1 kind")
                return ""
            if numerics.CsgQuantMm(st.w.bodyPx[a0]) != int64(1050):
                echo("FAIL dyn anchor1 x")
                return ""
            if numerics.CsgQuantMm(st.w.bodyPy[a0]) != int64(850):
                echo("FAIL dyn anchor1 y")
                return ""
            if st.footDone[dyn0] != 1:
                echo("FAIL dyn step1 not running")
                return ""
        if tick == ProbeStep2Start:
            let a1 = st.footAnchor[dyn1]
            if st.footCon[dyn1] < 0 || a1 < 0:
                echo("FAIL dyn anchor2 missing")
                return ""
            if numerics.CsgQuantMm(st.w.bodyPx[a1]) != int64(1250):
                echo("FAIL dyn anchor2 x")
                return ""
        if tick == ProbeStep2End:
            pxAfter = st.w.bodyPx[pelvisSlot]
        tick = tick + 1
    if st.rejectedCount != 0:
        echo("FAIL dyn rejections")
        echo("n=" + strings.IntToStr(st.rejectedCount))
        return ""
    if st.footDone[dyn0] != 2 || st.footDone[dyn1] != 2:
        echo("FAIL dyn steps not done")
        return ""
    var doneStatic: int32 = 0
    var s: int32 = 0
    while s < staticSteps:
        if st.footDone[s] == 2:
            doneStatic = doneStatic + 1
        s = s + 1
    if doneStatic != staticSteps:
        echo("FAIL static footsteps disturbed")
        echo("done=" + strings.IntToStr(doneStatic))
        return ""
    # completion events: exactly one FootstepDone per dynamic step, at its
    # own endTick, carrying the stepping part
    var ev1: int32 = 0
    var ev2: int32 = 0
    var e: int32 = 0
    while e < st.eventCount:
        if st.eventKind[e] == execution.CsgExecEventFootstepDone:
            if st.eventTick[e] == int64(ProbeStep1End) && st.eventArg[e] == ProbeFootR:
                ev1 = ev1 + 1
            if st.eventTick[e] == int64(ProbeStep2End) && st.eventArg[e] == ProbeFootL:
                ev2 = ev2 + 1
        e = e + 1
    if ev1 != 1 || ev2 != 1:
        echo("FAIL dyn done events")
        echo("ev1=" + strings.IntToStr(ev1))
        echo("ev2=" + strings.IntToStr(ev2))
        return ""
    let delta = pxAfter - pxBefore
    let deltaMm: int64 = numerics.CsgQuantMm(delta)
    if delta <= 0.0 || deltaMm <= int64(0):
        echo("FAIL dyn pelvis advance")
        echo("mm=" + strings.Int64ToStr(deltaMm))
        return ""
    echo("dyn anchor1 slot=" + strings.IntToStr(st.footAnchor[dyn0]))
    echo("dyn anchor2 slot=" + strings.IntToStr(st.footAnchor[dyn1]))
    echo("dyn done events at ticks 1470 and 1605")
    echo("dyn advance_mm=" + strings.Int64ToStr(deltaMm))
    return Fmt"{st.chainCid}"

fn main(): int32 =
    let chainA = runInject()
    if chainA == "":
        return 1
    let chainB = runInject()
    if chainB == "":
        return 1
    if chainA != chainB:
        echo("FAIL dyn double-run chain diverged")
        return 1
    echo("PASS runtime_step_probe")
    return 0
