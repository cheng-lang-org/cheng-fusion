fn isAndroid(t: str): bool =
    return t == "aarch64-linux-android"

fn isLinuxA64(t: str): bool =
    if t == "aarch64-unknown-linux-gnu":
        return true
    if t == "arm64-unknown-linux-gnu":
        return true
    return false

fn main(): int32 =
    if !isAndroid("aarch64-linux-android"):
        return 1
    if isAndroid("arm64-apple-darwin"):
        return 2
    if !isLinuxA64("aarch64-unknown-linux-gnu"):
        return 3
    return 0
