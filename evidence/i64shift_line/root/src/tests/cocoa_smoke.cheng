# Cocoa bindings compile smoke test.
# Verifies cocoa.cheng types and bindings compile correctly.

import std/cocoa as cocoa

fn main() =
    # Test CocoaRect type construction
    var r: cocoa.CocoaRect
    r.x = 100
    r.y = 200
    r.width = 800
    r.height = 600
    assert(r.width == 800, "cocoa smoke: rect width")
    assert(r.height == 600, "cocoa smoke: rect height")
    assert(r.x == 100, "cocoa smoke: rect x")
    assert(r.y == 200, "cocoa smoke: rect y")
