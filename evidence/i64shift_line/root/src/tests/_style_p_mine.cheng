fn WebCssCascadeMerge(declarations: WebCssDeclaration[], style: var WebComputedStyle) =
    // Apply low priority first, then high priority. WebComputedStyleApplyDeclaration
    // keeps the later/higher specificity or source order winner per property.
    var i: int32
    while i < declarations.len:
        var j = i
        while j > 0:
            var cur: WebCssDeclaration
            var prev: WebCssDeclaration
            cur.property = declarations[j].property
            cur.valueSource = strings.CloneStr(declarations[j].valueSource)
            cur.valueStart = declarations[j].valueStart
            cur.valueStop = declarations[j].valueStop
            cur.specificity = declarations[j].specificity
            cur.sourceOrder = declarations[j].sourceOrder
            prev.property = declarations[j - 1].property
            prev.valueSource = strings.CloneStr(declarations[j - 1].valueSource)
            prev.valueStart = declarations[j - 1].valueStart
            prev.valueStop = declarations[j - 1].valueStop
            prev.specificity = declarations[j - 1].specificity
            prev.sourceOrder = declarations[j - 1].sourceOrder
            var lower = false
            if cur.specificity < prev.specificity:
                lower = true
            elif cur.specificity == prev.specificity && cur.sourceOrder < prev.sourceOrder:
                lower = true
            if !lower:
                break
            declarations[j] = prev
            declarations[j - 1] = cur
            j = j - 1
        i = i + 1
    var k: int32
    while k < declarations.len:
        var item: WebCssDeclaration
        item.property = declarations[k].property
        item.valueSource = strings.CloneStr(declarations[k].valueSource)
        item.valueStart = declarations[k].valueStart
        item.valueStop = declarations[k].valueStop
        item.specificity = declarations[k].specificity
        item.sourceOrder = declarations[k].sourceOrder
        WebComputedStyleApplyDeclaration(style, item)
        k = k + 1


fn _unused() =
    return
