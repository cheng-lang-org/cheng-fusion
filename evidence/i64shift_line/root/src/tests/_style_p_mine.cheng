import std/strings

type WebCssDeclaration =
    property: int32
    valueSource: str
    valueStart: int32
    valueStop: int32
    specificity: int32
    sourceOrder: int32

@borrows
fn WebComputedStyleApplyDeclaration(style: var WebComputedStyle, declaration: WebCssDeclaration) =
    if declaration.property == WebCssPropertyColor:
        if WebCssDeclarationWins(style.colorSpecificity,
                                 style.colorOrder,
                                 declaration.specificity,
                                 declaration.sourceOrder):
            style.colorSource = strings.CloneStr(declaration.valueSource)
            style.colorStart = declaration.valueStart
            style.colorStop = declaration.valueStop
            style.hasColor = true
            style.colorSpecificity = declaration.specificity
            style.colorOrder = declaration.sourceOrder
    elif declaration.property == WebCssPropertyDisplay:
        if WebCssDeclarationWins(style.displaySpecificity,
                                 style.displayOrder,
                                 declaration.specificity,
                                 declaration.sourceOrder):
            style.displaySource = strings.CloneStr(declaration.valueSource)
            style.displayStart = declaration.valueStart
            style.displayStop = declaration.valueStop
            style.hasDisplay = true
            style.displaySpecificity = declaration.specificity
            style.displayOrder = declaration.sourceOrder
    elif declaration.property == WebCssPropertyMarginLeft:
        if WebCssDeclarationWins(style.marginLeftSpecificity,
                                 style.marginLeftOrder,
