fn ColdExactBorrowedParamAppend(values: var str[]) =
    add(values, "forbidden")

fn ColdExactBorrowedParamReject(values: var str[]): int32 =
    let immutableAlias = values
    ColdExactBorrowedParamAppend(immutableAlias)
    return len(values)

fn main(): int32 =
    var values: str[]
    return ColdExactBorrowedParamReject(values)
