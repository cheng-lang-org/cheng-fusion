# WASM match/switch dispatch test (i32-only, no composite returns)
# Tests variant tag dispatch via BODY_TERM_SWITCH in the WASM backend

type Code = Ok | Warning(val: int32) | Error(val: int32, extra: int32)

fn test_ok(): int32 =
    let r: Code = Code.Ok
    match r:
        Ok => return 0
        Warning(v) => return v + 100
        Error(v, e) => return v + e + 200
    return 99

fn test_warning(): int32 =
    let r = Code.Warning(42)
    match r:
        Ok => return 100
        Warning(v) => return v
        Error(v, e) => return v + e + 200
    return 99

fn test_error(): int32 =
    let r = Code.Error(10, 5)
    match r:
        Ok => return 100
        Warning(v) => return v + 200
        Error(v, e) => return v + e
    return 99

fn main(): int32 =
    let a = test_ok()
    if a != 0: return 1
    let b = test_warning()
    if b != 42: return 2
    let c = test_error()
    if c != 15: return 3
    return 0
