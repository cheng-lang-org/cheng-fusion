@profile("driver_safe")

type
    P =
        raw: uint64

type
    R =
        phys: P
        offset: uint64

type
    IoUInt8Ptr = uint8 *

@trusted_abi
fn MkReg(): R =
    var out: R
    out.phys.raw = uint64(268435456)
    out.offset = uint64(5)
    return out

@trusted_abi
fn ReadAt(r: R): int32 =
    let addr = ptr(r.phys.raw + r.offset)
    return int32(*(IoUInt8Ptr(addr)))

fn main(): int32 =
    let r = MkReg()
    let v = ReadAt(r)
    let addr2 = ptr(uint64(268435456))
    *(IoUInt8Ptr(addr2)) = uint8(71 + (v & 0))
    return 0
