import std/system
import std/result
import std/rawbytes
import cheng/quic/core/packet_header_model

fn main(): int32 =
    let cid: Bytes = BytesAlloc(8)
    for i in 0..<8:
        BytesSet(cid, i, (0x31 + i) & 255)

    var initial: packet_header_model.QuicPacketHeader
    initial.longHeader = true
    initial.packetType = packet_header_model.QuicPacketInitial
    initial.version = 1
    initial.dcid = cid
    initial.scid = cid
    initial.token = emptyBytes()
    initial.payloadLength = 8
    initial.packetNumber = 1
    initial.packetNumberLen = 2
    initial.spinBit = false
    initial.keyPhase = false
    let initialRes: Result[Bytes] = packet_header_model.quicPacketHeaderEncode(initial)
    assert(IsOk(initialRes), " quic header first byte: initial encode")
    let initialBytes: Bytes = Value(initialRes)
    assert(BytesLen(initialBytes) > 0, " quic header first byte: initial bytes")
    assert(BytesGet(initialBytes, 0) == 193, " quic header first byte: initial fixed bits")

    var shortHeader: packet_header_model.QuicPacketHeader
    shortHeader.longHeader = false
    shortHeader.packetType = packet_header_model.QuicPacketShort
    shortHeader.version = 0
    shortHeader.dcid = cid
    shortHeader.scid = emptyBytes()
    shortHeader.token = emptyBytes()
    shortHeader.payloadLength = 0
    shortHeader.packetNumber = 7
    shortHeader.packetNumberLen = 1
    shortHeader.spinBit = false
    shortHeader.keyPhase = false
    let shortRes: Result[Bytes] = packet_header_model.quicPacketHeaderEncode(shortHeader)
    assert(IsOk(shortRes), " quic header first byte: short encode")
    let shortBytes: Bytes = Value(shortRes)
    assert(BytesLen(shortBytes) > 0, " quic header first byte: short bytes")
    assert(BytesGet(shortBytes, 0) == 64, " quic header first byte: short fixed bit")

    echo(" quic_packet_header_first_byte_smoke ok")
    return 0
