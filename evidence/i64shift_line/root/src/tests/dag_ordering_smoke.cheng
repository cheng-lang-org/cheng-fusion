# dag_ordering smoke: causal depth ordering, deterministic tie-break,
# missing-parent tolerance, insertion-order independence.

import std/os
import std/system
import std/rawbytes
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/chain/dag_ordering as dord

fn CidFromByte(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn FirstByte(cid: layout.FixedBytes32): int32 =
    let b = layout.FixedBytes32ToBytes(cid)
    return BytesGet(b, 0)

fn AssertCidOrder(tag: str, got: layout.FixedBytes32[], w0: int32, w1: int32,
                  w2: int32, wantLen: int32): int32 =
    if got.len != wantLen:
        os.WriteLine(os.Get_stderr(), strutil.Join([tag, " length mismatch"], ""))
        return 1
    if wantLen > 0 and FirstByte(got[0]) != w0:
        os.WriteLine(os.Get_stderr(), strutil.Join([tag, " mismatch at 0"], ""))
        return 1
    if wantLen > 1 and FirstByte(got[1]) != w1:
        os.WriteLine(os.Get_stderr(), strutil.Join([tag, " mismatch at 1"], ""))
        return 1
    if wantLen > 2 and FirstByte(got[2]) != w2:
        os.WriteLine(os.Get_stderr(), strutil.Join([tag, " mismatch at 2"], ""))
        return 1
    return 0

fn main(): int32 =
    var rc: int32 = 0

    # --- case 1: linear chain A<-B<-C, inserted out of order (C, B, A) ---
    var v1 = dord.DagOrderView()
    let a1 = CidFromByte(1)
    let b1 = CidFromByte(2)
    let c1 = CidFromByte(3)
    let zeroCid = layout.FixedBytes32()
    dord.DagOrderPush(v1, c1, b1, true, zeroCid, false, 1, 30, 0)
    dord.DagOrderPush(v1, b1, a1, true, zeroCid, false, 1, 20, 0)
    dord.DagOrderPush(v1, a1, zeroCid, false, zeroCid, false, 1, 10, 0)
    var out1: layout.FixedBytes32[]
    let rc1: int32 = dord.DagOrderCommitSequence(v1, out1)
    if rc1 != 0:
        os.WriteLine(os.Get_stderr(), "case1 commit sequence errored")
        rc = rc + 1
    else:
        # causal order must be A(1), B(2), C(3) regardless of insertion order
        rc = rc + AssertCidOrder("case1", out1, 1, 2, 3, 3)

    # --- case 2: concurrent events share a parent; tick breaks the tie ---
    var v2 = dord.DagOrderView()
    let p2 = CidFromByte(10)
    let late = CidFromByte(11)
    let early = CidFromByte(12)
    dord.DagOrderPush(v2, late, p2, true, zeroCid, false, 4, 900, 0)
    dord.DagOrderPush(v2, early, p2, true, zeroCid, false, 4, 100, 0)
    dord.DagOrderPush(v2, p2, zeroCid, false, zeroCid, false, 4, 50, 0)
    var out2: layout.FixedBytes32[]
    let rc2: int32 = dord.DagOrderCommitSequence(v2, out2)
    if rc2 != 0:
        os.WriteLine(os.Get_stderr(), "case2 errored")
        rc = rc + 1
    else:
        # parent first (tick 50), then early(tick 100), then late(tick 900)
        rc = rc + AssertCidOrder("case2", out2, 10, 12, 11, 3)

    # --- case 3: missing parent tolerated at depth 0 ---
    var v3 = dord.DagOrderView()
    let ghost = CidFromByte(200)
    let orphan = CidFromByte(201)
    dord.DagOrderPush(v3, orphan, ghost, true, zeroCid, false, 7, 5, 0)
    var out3: layout.FixedBytes32[]
    let rc3: int32 = dord.DagOrderCommitSequence(v3, out3)
    if rc3 != 0:
        os.WriteLine(os.Get_stderr(), "case3 errored on missing parent")
        rc = rc + 1
    else:
        rc = rc + AssertCidOrder("case3", out3, 201, 0, 0, 1)

    # --- case 4: insertion-order independence (same DAG, two orders) ---
    var v4a = dord.DagOrderView()
    var v4b = dord.DagOrderView()
    let n0 = CidFromByte(30)
    let n1 = CidFromByte(31)
    let n2 = CidFromByte(32)
    dord.DagOrderPush(v4a, n1, n0, true, zeroCid, false, 2, 22, 1)
    dord.DagOrderPush(v4a, n2, n1, true, zeroCid, false, 2, 33, 1)
    dord.DagOrderPush(v4a, n0, zeroCid, false, zeroCid, false, 2, 11, 1)
    dord.DagOrderPush(v4b, n0, zeroCid, false, zeroCid, false, 2, 11, 1)
    dord.DagOrderPush(v4b, n2, n1, true, zeroCid, false, 2, 33, 1)
    dord.DagOrderPush(v4b, n1, n0, true, zeroCid, false, 2, 22, 1)
    var out4a: layout.FixedBytes32[]
    var out4b: layout.FixedBytes32[]
    let rc4a: int32 = dord.DagOrderCommitSequence(v4a, out4a)
    let rc4b: int32 = dord.DagOrderCommitSequence(v4b, out4b)
    if rc4a != 0 or rc4b != 0:
        os.WriteLine(os.Get_stderr(), "case4 errored")
        rc = rc + 1
    else:
        if out4a.len != 3 or out4b.len != 3:
            os.WriteLine(os.Get_stderr(), "case4 length mismatch")
            rc = rc + 1
        else:
            var i: int32
            while i < 3:
                if FirstByte(out4a[i]) != FirstByte(out4b[i]):
                    os.WriteLine(os.Get_stderr(), strutil.Join(["case4 sequence diverged at ", IntToStr(i)], ""))
                    rc = rc + 1
                i = i + 1

    if rc == 0:
        echo("dag_ordering_smoke ok")
    return rc
