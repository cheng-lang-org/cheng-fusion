import cheng/core/runtime/js_runtime as jsrt
import cheng/core/runtime/js_module_runtime as modrt

fn main(): int32 =
    // ==========================================
    // Test 1: Module registration and dedup
    // ==========================================
    modrt.JsModuleRuntimeInit()
    let modA = modrt.JsModuleRegister("mod_a")
    assert(modA >= 0, "register mod_a")
    let modB = modrt.JsModuleRegister("mod_b")
    assert(modB != modA, "mod_b gets different id")
    let modAdup = modrt.JsModuleRegister("mod_a")
    assert(modAdup == modA, "duplicate register returns existing id")
    echo(" module_registration pass")

    // ==========================================
    // Test 2: Topological sort with dependency chain
    // ==========================================
    modrt.JsModuleRuntimeInit()
    let modX = modrt.JsModuleRegister("mod_x")
    let modY = modrt.JsModuleRegister("mod_y")
    let modZ = modrt.JsModuleRegister("mod_z")
    // x depends on y, y depends on z
    assert(modrt.JsModuleAddDependency(modX, "mod_y"), "x depends on y")
    assert(modrt.JsModuleAddDependency(modY, "mod_z"), "y depends on z")
    assert(modrt.JsModuleResolveDependencies(["mod_x"]), "resolve deps chain")
    assert(modrt.JsModuleLoadOrderCount() == 3, "three modules in order")
    // Leaf module (z) should be first, entry (x) last
    assert(modrt.JsModuleLoadOrderAt(0) == modZ, "z loaded first (leaf)")
    assert(modrt.JsModuleLoadOrderAt(1) == modY, "y loaded second")
    assert(modrt.JsModuleLoadOrderAt(2) == modX, "x loaded last (entry)")
    echo(" topological_sort pass")

    // ==========================================
    // Test 3: JsModuleSetExport / JsModuleGetExport
    // ==========================================
    modrt.JsModuleRuntimeInit()
    let modE = modrt.JsModuleRegister("mod_export")
    var strVal: jsrt.JsValue
    jsrt.JsValueInitString(strVal, "hello world")
    assert(modrt.JsModuleSetExport(modE, "greeting", strVal), "set string export")
    var intVal: jsrt.JsValue
    jsrt.JsValueInitInt32(intVal, 42)
    assert(modrt.JsModuleSetExport(modE, "answer", intVal), "set int export")

    var gotStr: jsrt.JsValue
    assert(modrt.JsModuleGetExport(modE, "greeting", gotStr), "get greeting")
    assert(jsrt.JsValueString(gotStr) == "hello world", "greeting matches")
    var gotInt: jsrt.JsValue
    assert(modrt.JsModuleGetExport(modE, "answer", gotInt), "get answer")
    assert(jsrt.JsValueInt32(gotInt) == 42, "answer matches")
    var missing: jsrt.JsValue
    assert(!modrt.JsModuleGetExport(modE, "nonexistent", missing), "missing export returns false")
    assert(jsrt.JsValueIsUndefined(missing), "missing export value is undefined")
    echo(" export_import pass")

    // ==========================================
    // Test 4: JsModuleBindAllExports + JsModuleResolveGlobal
    // ==========================================
    modrt.JsModuleRuntimeInit()
    let modG = modrt.JsModuleRegister("mod_global")
    var gVal1: jsrt.JsValue
    jsrt.JsValueInitString(gVal1, "alpha")
    var gVal2: jsrt.JsValue
    jsrt.JsValueInitInt32(gVal2, 99)
    assert(modrt.JsModuleSetExport(modG, "name", gVal1), "set name export")
    assert(modrt.JsModuleSetExport(modG, "value", gVal2), "set value export")
    assert(modrt.JsModuleBindAllExports(modG), "bind all exports")
    var resolved1: jsrt.JsValue
    assert(modrt.JsModuleResolveGlobal("name", resolved1), "resolve global 'name'")
    assert(jsrt.JsValueString(resolved1) == "alpha", "global name matches")
    var resolved2: jsrt.JsValue
    assert(modrt.JsModuleResolveGlobal("value", resolved2), "resolve global 'value'")
    assert(jsrt.JsValueInt32(resolved2) == 99, "global value matches")
    var unresolved: jsrt.JsValue
    assert(!modrt.JsModuleResolveGlobal("nope", unresolved), "unresolved global returns false")
    echo(" bind_all_exports pass")

    // ==========================================
    // Test 5: JsModuleLoad with entry point execution
    // ==========================================
    modrt.JsModuleRuntimeInit()
    let modH = modrt.JsModuleRegister("mod_exec")
    // Register test module entry chengFnId 3 (idempotent)
    jsrt.jsRegisterChengFn(3)
    assert(modrt.JsModuleSetEntryPoint(modH, 3), "set entry point chengFnId=3")
    assert(modrt.JsModuleLoad(["mod_exec"]), "load module with entry point")
    assert(modrt.JsModuleIsLoaded(modH), "module marked as loaded")
    // The module function sets testExport = "exported_value" on the exports object
    var testVal: jsrt.JsValue
    assert(modrt.JsModuleGetExport(modH, "testExport", testVal), "get testExport set by module function")
    assert(jsrt.JsValueString(testVal) == "exported_value", "testExport value matches")
    echo(" entry_point_execution pass")

    // ==========================================
    // Test 6: Full ESM flow — exporter sets export, importer depends on it
    // ==========================================
    modrt.JsModuleRuntimeInit()
    let exporter = modrt.JsModuleRegister("exporter")
    let importer = modrt.JsModuleRegister("importer")
    assert(modrt.JsModuleAddDependency(importer, "exporter"), "importer depends on exporter")
    // Register and set entry point for exporter module
    jsrt.jsRegisterChengFn(3)
    assert(modrt.JsModuleSetEntryPoint(exporter, 3), "set exporter entry point")
    // Load in dependency order: exporter then importer
    assert(modrt.JsModuleLoad(["importer"]), "load with dependency")
    assert(modrt.JsModuleIsLoaded(exporter), "exporter loaded first")
    assert(modrt.JsModuleIsLoaded(importer), "importer loaded second")
    // Bind exports so importer can resolve globals
    assert(modrt.JsModuleBindAllExports(exporter), "bind exporter exports")
    // Importer can resolve the export from exporter via global scope
    var globalVal: jsrt.JsValue
    assert(modrt.JsModuleResolveGlobal("testExport", globalVal), "importer resolves testExport")
    assert(jsrt.JsValueString(globalVal) == "exported_value", "exported value matches")
    echo(" full_esm_flow pass")

    // ==========================================
    // Test 7: Edge cases — invalid module IDs
    // ==========================================
    // JsModuleGetExport with out-of-range
    var bogus: jsrt.JsValue
    assert(!modrt.JsModuleGetExport(-1, "x", bogus), "negative moduleId returns false")
    assert(!modrt.JsModuleGetExport(999, "x", bogus), "out-of-range moduleId returns false")
    // JsModuleSetExport with out-of-range
    var dummy: jsrt.JsValue
    jsrt.JsValueInitInt32(dummy, 0)
    assert(!modrt.JsModuleSetExport(-1, "x", dummy), "set export invalid id")
    // JsModuleBindAllExports with out-of-range
    assert(!modrt.JsModuleBindAllExports(-1), "bind all exports invalid id")
    // JsModuleIsLoaded with out-of-range
    assert(!modrt.JsModuleIsLoaded(-1), "is loaded invalid id")
    // JsModuleLoadOrderAt with out-of-range
    assert(modrt.JsModuleLoadOrderAt(-1) == -1, "load order at invalid index")
    // JsModuleSetEntryPoint with out-of-range
    assert(!modrt.JsModuleSetEntryPoint(-1, 0), "set entry point invalid id")
    echo(" edge_cases pass")

    echo(" js_module_runtime_smoke ok")
    return 0
