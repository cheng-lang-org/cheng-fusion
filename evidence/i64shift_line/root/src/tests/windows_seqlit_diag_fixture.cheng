import std/strutils as strutil

type
    SmallRec =
        a: int32
        b: int32
    BigRec =
        name: str
        host: str
        port: int32

fn mkSmall(a: int32, b: int32): SmallRec =
    var out: SmallRec
    out.a = a
    out.b = b
    return out

fn mkBig(name: str, host: str, port: int32): BigRec =
    var out: BigRec
    out.name = name
    out.host = host
    out.port = port
    return out

fn main(): int32 =
    var ints: int32[]
    ints = [10, 20, 30]
    puts(strutil.Join(["int-lit len=", IntToStr(ints.len)], ""))

    var smalls: SmallRec[]
    smalls = [mkSmall(1, 2), mkSmall(3, 4)]
    puts(strutil.Join(["small-lit len=", IntToStr(smalls.len)], ""))
    if smalls.len >= 2:
        puts(strutil.Join(["small[1].a=", IntToStr(smalls[1].a), " b=", IntToStr(smalls[1].b)], ""))

    var bigs: BigRec[]
    bigs = [mkBig("x", "h1", 7), mkBig("y", "h2", 9)]
    puts(strutil.Join(["big-lit len=", IntToStr(bigs.len)], ""))
    if bigs.len >= 2:
        puts(strutil.Join(["big[1].name=", bigs[1].name, " host=", bigs[1].host, " port=", IntToStr(bigs[1].port)], ""))

    var bigs2: BigRec[]
    add(bigs2, mkBig("p", "h3", 11))
    add(bigs2, mkBig("q", "h4", 13))
    puts(strutil.Join(["big-add len=", IntToStr(bigs2.len)], ""))
    return 0
