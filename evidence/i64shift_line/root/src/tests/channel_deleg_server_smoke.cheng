# libp2p P3 收尾片: 委托 head 网络分发腿 — 应答方 (A) 服务端 exe (正典 §11.6 P3)。
# A 真两进程之一: 按 --scenario 把 store 种到不同形态 (委托库 channel_delegations/<L> + D 自证 head +
# 可选撤销记录) → 真 bind + AcceptTimed, 统一分发 HEAD/WANT/REVOKE/DELEG。A 对自库负责 (cert/head/撤销
# wire 原样透传, 不重验), 全部委托链验签/授权/新鲜度在客户端 B 侧编排器。
#
# 用法: --port 0 --ready-path <f> --store-root <A dir> --scenario <name>
#       --root-seed N --deleg-seed M [--serve-count N] [--wait-ms W]
# scenario: valid | deleg_miss | cert_a_mismatch | revoked | forged_cert | subdeleg | expired | head_missing

import std/system
import std/result
import std/cmdline as cmdline
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import std/crypto/sha512 as sha512
import std/crypto/ed25519/ref10 as ref10
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/head_store as headstore
import cheng/libp2p/protocols/cas_source/channel_head/authz_codec as authz
import cheng/libp2p/protocols/cas_source/channel_head/authz_store as authzstore
import cheng/libp2p/host/host_quic as hq
import std/strutils as strutil

fn deriveKeypair(seedv: int32, priv: var Bytes, pub: var Bytes) =
    var seed = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(seed, i, (seedv + i) & 255)
    var digest = sha512.Sha512Digest(seed)
    BytesSet(digest, 0, BytesGet(digest, 0) & 248)
    BytesSet(digest, 31, (BytesGet(digest, 31) & 63) | 64)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, BytesSlice(digest, 0, 32))
    pub = ref10.geP3ToBytes(r)
    priv = BytesConcat(seed, pub)

fn pubFixed(pub: Bytes): layout.FixedBytes32 =
    let r = layout.FixedBytes32FromBytes(pub)
    assert(!IsErr(r), " pubFixed 32B")
    return Value(r)

fn mkHeadCid(seed: int32): layout.FixedBytes32 =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed * 19 + i + 1) & 255)
    return pubFixed(b)

# 签一个 pub 的 v1 自证 head → 存 head 库 (键 = sha256(pub))。
fn storeHead(storeRoot: str, priv: Bytes, pub: Bytes, epoch: int64) =
    let hc = mkHeadCid(int32(epoch) + 7)
    let genesis = head.ChannelHeadGenesisPrev()
    var signRes = head.ChannelHeadSign(priv, epoch, hc, genesis, pub)
    assert(signRes.ok, " server: sign head: " + Error(signRes))
    var putRes = headstore.ChannelHeadStorePut(storeRoot, signRes.value)
    assert(putRes.ok, " server: head store put: " + Error(putRes))

# 签一份委托 cert (tag 0x40) 并以 key=storeKeyHex 存委托库 (原样, A 不重验)。
fn storeCert(storeRoot: str, storeKeyHex: str, signerPriv: Bytes, signerPub: Bytes,
             aChannel: layout.FixedBytes32, bDelegate: layout.FixedBytes32, notAfter: int64) =
    var certSign = authz.AuthzRecordSign(authz.AuthzTagDelegate, signerPriv, aChannel, bDelegate, notAfter, signerPub)
    assert(certSign.ok, " server: cert sign: " + Error(certSign))
    var encRes = authz.AuthzRecordEncode(certSign.value)
    assert(encRes.ok, " server: cert encode: " + Error(encRes))
    var wire = encRes.value
    var putRes = authzstore.AuthzDelegationPutWire(storeRoot, storeKeyHex, wire)
    assert(putRes.ok, " server: deleg store put: " + Error(putRes))

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", 0)
    let readyPath = cmdline.ReadFlagOrDefault("--ready-path", "")
    let storeRoot = cmdline.ReadFlagOrDefault("--store-root", "")
    let scenario = cmdline.ReadFlagOrDefault("--scenario", "valid")
    let rootSeed = cmdline.ReadInt32FlagOrDefault("--root-seed", 61)
    let delegSeed = cmdline.ReadInt32FlagOrDefault("--deleg-seed", 97)
    let serveCount = cmdline.ReadInt32FlagOrDefault("--serve-count", 10)
    let waitMs = cmdline.ReadInt32FlagOrDefault("--wait-ms", 4000)
    assert(readyPath != "", " server: --ready-path required")
    assert(storeRoot != "", " server: --store-root required")

    var rootPriv: Bytes
    var rootPub: Bytes
    deriveKeypair(rootSeed, rootPriv, rootPub)
    let logicalL = head.ChannelIdForPubKey(rootPub)   # currentRoot == L (无 rotation)
    let lHex = layout.FixedBytes32Hex(logicalL)

    var delPriv: Bytes
    var delPub: Bytes
    deriveKeypair(delegSeed, delPriv, delPub)
    let delPubFixed = pubFixed(delPub)
    let delegateChannel = head.ChannelIdForPubKey(delPub)   # = sha256(D)

    # 分场景种库。除 head_missing/subdeleg 外, D 自证 head epoch=3 存库。
    if scenario == "valid":
        storeHead(storeRoot, delPriv, delPub, int64(3))
        storeCert(storeRoot, lHex, rootPriv, rootPub, logicalL, delPubFixed, int64(10))
    elif scenario == "deleg_miss":
        storeHead(storeRoot, delPriv, delPub, int64(3))
        # 不存委托 cert → DELEG miss
    elif scenario == "cert_a_mismatch":
        storeHead(storeRoot, delPriv, delPub, int64(3))
        # cert 的 A 字段是别的 channel (delegateChannel), 却以 key=L 存 → fetch 请求绑定拒
        storeCert(storeRoot, lHex, rootPriv, rootPub, delegateChannel, delPubFixed, int64(10))
    elif scenario == "revoked":
        storeHead(storeRoot, delPriv, delPub, int64(3))
        storeCert(storeRoot, lHex, rootPriv, rootPub, logicalL, delPubFixed, int64(10))
        # 根钥在 L 撤销 delegate (A=L, B=delPub, signer=root; selfRoot 授权)
        var revSign = authz.AuthzRecordSign(authz.AuthzTagRevoke, rootPriv, logicalL, delPubFixed, int64(1), rootPub)
        assert(revSign.ok, " server: revoke sign: " + Error(revSign))
        var revAdmit = authzstore.AuthzRevocationAdmit(storeRoot, revSign.value)
        assert(revAdmit.ok, " server: revoke admit: " + Error(revAdmit))
    elif scenario == "forged_cert":
        storeHead(storeRoot, delPriv, delPub, int64(3))
        # cert 由非根钥 (forge) 签 (sig 本身合法, 但 sha256(signer)≠L) → resolver DelegationVerify 拒
        var forgePriv: Bytes
        var forgePub: Bytes
        deriveKeypair(rootSeed + 200, forgePriv, forgePub)
        storeCert(storeRoot, lHex, forgePriv, forgePub, logicalL, delPubFixed, int64(10))
    elif scenario == "subdeleg":
        # depth-2: cert 由 delegate D 签 (B=d2), d2 自证 head 存库 → resolver depth-1 结构化拒
        var d2Priv: Bytes
        var d2Pub: Bytes
        deriveKeypair(delegSeed + 300, d2Priv, d2Pub)
        storeHead(storeRoot, d2Priv, d2Pub, int64(3))
        storeCert(storeRoot, lHex, delPriv, delPub, logicalL, pubFixed(d2Pub), int64(10))
    elif scenario == "expired":
        # D head epoch=5 越 cert.notAfter=2 → resolver 越权闸拒
        storeHead(storeRoot, delPriv, delPub, int64(5))
        storeCert(storeRoot, lHex, rootPriv, rootPub, logicalL, delPubFixed, int64(2))
    elif scenario == "head_missing":
        # cert 合法但 D head 未服务 → FetchCasHead miss 硬错
        storeCert(storeRoot, lHex, rootPriv, rootPub, logicalL, delPubFixed, int64(10))
    else:
        assert(false, " server: 未知 scenario: " + scenario)

    echo(strutil.Join([" cas_deleg server scenario=", scenario,
                       " logical_l=", lHex,
                       " delegate_channel=", layout.FixedBytes32Hex(delegateChannel),
                       " delegate_pub=", rawbytes.BytesToHex(delPub)], ""))

    let serveRes = hq.Libp2pHostQuicServeCasUnified("127.0.0.1",
                                                    port,
                                                    "localhost",
                                                    storeRoot,
                                                    readyPath,
                                                    serveCount,
                                                    waitMs)
    assert(serveRes.ok, " server: serve: " + Error(serveRes))
    echo(strutil.Join([" cas_deleg_server ok served=", IntToStr(serveRes.value)], ""))
    return 0
