type
    ColdVarWideRecord =
        first: str
        second: str
        value: int64

    ColdVarChild = ref object
        value: int32

    ColdVarOwner = ref object
        child: ColdVarChild
        values: int32[]

fn copyVarValue(input: var ColdVarWideRecord): int32 =
    let values = [input]
    if values.len != 1:
        return -1
    if values[0].first != "first" || values[0].second != "second":
        return -2
    return int32(values[0].value)

fn initializeVarRef(owner: var ColdVarOwner): int32 =
    owner = new(ColdVarOwner)
    owner.child = new(ColdVarChild)
    owner.child.value = 42
    add(owner.values, 7)
    return owner.child.value + owner.values[0]

fn main(): int32 =
    var value: ColdVarWideRecord
    value.first = "first"
    value.second = "second"
    value.value = int64(33)
    if copyVarValue(value) != 33:
        return 1
    var owner: ColdVarOwner
    if initializeVarRef(owner) != 49:
        return 2
    return 0
