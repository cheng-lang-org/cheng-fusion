import std/cmdline
import std/os
import std/result
import std/strings
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/backend/system_link_plan as slplan
import std/strutils as strutil

type
    CidEvidenceModule =
        modulePath: str
        payloadPath: str
        sourcePath: str

@borrows
fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

@borrows
fn CidEvidenceJsonString(value: str): str =
    assert(value != "", "CID evidence: empty JSON string")
    for index in 0..<value.len:
        let ch = value[index]
        assert(Int32(ch) >= 32 && Int32(ch) != 127 &&
               ch != '"' && ch != '\\',
               "CID evidence: JSON string requires escaping")
    return CidEvidenceJoin(["\"", share(value), "\""])

@borrows
fn CidEvidenceTextLess(left: str, right: str): bool =
    let shared = left.len < right.len ? left.len : right.len
    for index in 0..<shared:
        if left[index] < right[index]:
            return true
        if left[index] > right[index]:
            return false
    return left.len < right.len

fn CidEvidenceSortTexts(values: var str[]) =
    for index in 1..<values.len:
        var cursor = index
        while cursor > 0 && CidEvidenceTextLess(
                strings.CloneStr(values[cursor]),
                strings.CloneStr(values[cursor - 1])):
            let prior = strings.CloneStr(values[cursor - 1])
            values[cursor - 1] = strings.CloneStr(values[cursor])
            values[cursor] = prior
            cursor = cursor - 1

fn CidEvidenceSortModules(values: var CidEvidenceModule[]) =
    for index in 1..<values.len:
        var cursor = index
        while cursor > 0 &&
              CidEvidenceTextLess(values[cursor].modulePath,
                                  values[cursor - 1].modulePath):
            let prior = values[cursor - 1]
            values[cursor - 1] = values[cursor]
            values[cursor] = prior
            cursor = cursor - 1

@borrows
fn CidEvidenceWrite(root: str,
                    relativePath: str,
                    text: str,
                    files: var str[]) =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    os.WriteFile(absolute, text)
    add(files, strings.CloneStr(relativePath))

@borrows
fn CidEvidenceStringArrayJson(values: str[]): str =
    var out = "["
    for index in 0..<values.len:
        if index > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([out, CidEvidenceJsonString(values[index])])
    return CidEvidenceJoin([out, "]"])

@borrows
fn CidEvidenceModulesJson(values: CidEvidenceModule[]): str =
    var out = "["
    for index in 0..<values.len:
        if index > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            "{\"module_path\":", CidEvidenceJsonString(values[index].modulePath),
            ",\"path\":", CidEvidenceJsonString(values[index].payloadPath),
            "}"])
    return CidEvidenceJoin([out, "]"])

fn CidEvidenceSourceArtifactsJson(): str =
    return CidEvidenceJoin([
        "{",
        "\"binding_report\":\"artifacts/binding-report.kv\",",
        "\"compile_receipt\":\"artifacts/compile-receipt.kv\",",
        "\"csg_sidecar\":\"artifacts/csg-sidecar.kv\",",
        "\"output\":\"artifacts/output.bin\",",
        "\"semantic_receipt\":\"artifacts/semantic-receipt.kv\",",
        "\"source_receipt\":\"artifacts/source-receipt.kv\"",
        "}"])

fn CidEvidenceZeroArtifactsJson(): str =
    return CidEvidenceJoin([
        "{",
        "\"binding_report\":\"artifacts/binding-report.kv\",",
        "\"compile_receipt\":\"artifacts/compile-receipt.kv\",",
        "\"csg_sidecar\":\"artifacts/csg-sidecar.kv\",",
        "\"missing_probe_stderr\":\"artifacts/missing-probe.stderr\",",
        "\"missing_probe_stdout\":\"artifacts/missing-probe.stdout\",",
        "\"missing_probe_trace\":\"artifacts/missing-probe-trace.json\",",
        "\"output\":\"artifacts/output.bin\",",
        "\"semantic_receipt\":\"artifacts/semantic-receipt.kv\",",
        "\"source_receipt\":\"artifacts/source-receipt.kv\",",
        "\"zero_entry_source\":\"artifacts/zero-entry.cheng\",",
        "\"zero_entry_source_receipt\":\"artifacts/zero-entry-receipt.kv\",",
        "\"zero_entry_stderr\":\"artifacts/zero-entry.stderr\",",
        "\"zero_entry_stdout\":\"artifacts/zero-entry.stdout\",",
        "\"zero_entry_trace\":\"artifacts/zero-entry-trace.json\"",
        "}"])

@borrows
fn CidEvidenceCaseIndex(caseId: str,
                        kind: str,
                        packageId: str,
                        entryModulePath: str,
                        providers: str[],
                        modules: CidEvidenceModule[],
                        artifactsJson: str): str =
    return CidEvidenceJoin([
        "{",
        "\"artifacts\":", share(artifactsJson), ",",
        "\"bootstrap_stage\":\"stage3_local\",",
        "\"case_id\":", CidEvidenceJsonString(caseId), ",",
        "\"entry_module_path\":", CidEvidenceJsonString(entryModulePath), ",",
        "\"kind\":", CidEvidenceJsonString(kind), ",",
        "\"legacy_modules\":[],",
        "\"migrated_modules\":[],",
        "\"modules\":", CidEvidenceModulesJson(modules), ",",
        "\"package_id\":", CidEvidenceJsonString(packageId), ",",
        "\"providers\":", CidEvidenceStringArrayJson(providers), ",",
        "\"root_b_legacy_modules\":[],",
        "\"root_b_migrated_modules\":[],",
        "\"schema\":\"cheng.cid.case_payload_index\",",
        "\"target\":\"x86_64-unknown-linux-gnu\"",
        "}\n"])

@borrows
fn CidEvidenceWriteFileList(artifactRoot: str,
                            files: var str[]) =
    add(files, "case-index.json")
    CidEvidenceSortTexts(files)
    var report = ""
    for index in 0..<files.len:
        assert(index == 0 || files[index] != files[index - 1],
               "CID evidence: duplicate payload file")
        report = CidEvidenceJoin([
            report, strings.CloneStr(files[index]), "\n"])
    let workRoot = chengpath.PathParentDir(artifactRoot)
    os.WriteFile(chengpath.PathJoin(workRoot, "case-files.list"), report)

@borrows
fn CidEvidencePrepareCase(caseId: str, caseRoot: str): bool =
    let sourceRoot = chengpath.PathJoin(caseRoot, "src")
    os.MkdirAll(sourceRoot, 493)
    os.WriteFile(
        chengpath.PathJoin(caseRoot, "cheng-package.toml"),
        "package_id = \"cheng/compiler\"\n")
    if caseId == "zero-byte-import":
        os.WriteFile(
            chengpath.PathJoin(sourceRoot, "main.cheng"),
            "import cheng/compiler/empty\n\nfn main(): int32 = 0\n")
        os.WriteFile(chengpath.PathJoin(sourceRoot, "empty.cheng"), "")
        return true
    if caseId == "source-bundle-entry" ||
       caseId == "source-csg-binding" ||
       caseId == "csg-atomic-consume":
        os.WriteFile(
            chengpath.PathJoin(sourceRoot, "main.cheng"),
            CidEvidenceJoin([
                "import cheng/compiler/helper as helper\n\n",
                "fn main(): int32 = helper.Value()\n"]))
        os.WriteFile(
            chengpath.PathJoin(sourceRoot, "helper.cheng"),
            "fn Value(): int32 = 0\n")
        return true
    if caseId == "migration-cross-root-fixed-point" ||
       caseId == "mirror-atomic-install":
        os.WriteFile(
            chengpath.PathJoin(sourceRoot, "main.cheng"),
            CidEvidenceJoin([
                "fn ExportedAdd(left: int32, right: int32): int32 =\n",
                "    return left + right\n\n",
                "fn main(): int32 =\n",
                "    if false:\n",
                "        return 1\n",
                "    elif true:\n",
                "        return ExportedAdd(20, 22) - 42\n",
                "    return 2\n"]))
        let legacyRoot = chengpath.PathJoin(caseRoot, "legacy")
        os.MkdirAll(legacyRoot, 493)
        os.WriteFile(
            chengpath.PathJoin(legacyRoot, "main.cheng"),
            CidEvidenceJoin([
                "proc ExportedAdd(left: int32, right: int32): int32 =\n",
                "    return left + right\n\n",
                "proc main(): int32 =\n",
                "    if false:\n",
                "        return 1\n",
                "    else if true:\n",
                "        return ExportedAdd(20, 22) - 42\n",
                "    return 2\n"]))
        return true
    return false

fn CidEvidenceAtomicTraceRoles(): str[] =
    return [
        "consume_first_graph_after",
        "consume_first_graph_before",
        "consume_first_output_after",
        "consume_first_output_before",
        "consume_first_plan_after",
        "consume_first_plan_before",
        "consume_first_stderr",
        "consume_first_stdout",
        "consume_rehash_graph_after",
        "consume_rehash_graph_before",
        "consume_rehash_output_after",
        "consume_rehash_output_before",
        "consume_rehash_plan_after",
        "consume_rehash_plan_before",
        "consume_rehash_stderr",
        "consume_rehash_stdout",
        "consume_second_graph_after",
        "consume_second_graph_before",
        "consume_second_output_after",
        "consume_second_output_before",
        "consume_second_plan_after",
        "consume_second_plan_before",
        "consume_second_stderr",
        "consume_second_stdout"]

@borrows
fn CidEvidenceArtifactRelativePath(role: str): str =
    if role == "binding_report":
        return "artifacts/binding-report.kv"
    if role == "compile_receipt":
        return "artifacts/compile-receipt.kv"
    if role == "csg_sidecar":
        return "artifacts/csg-sidecar.kv"
    if role == "output":
        return "artifacts/output.bin"
    if role == "semantic_receipt":
        return "artifacts/semantic-receipt.kv"
    if role == "source_receipt":
        return "artifacts/source-receipt.kv"
    if role == "consume_trace":
        return "artifacts/consume-trace.json"
    return CidEvidenceJoin(["artifacts/", share(role), ".bin"])

fn CidEvidenceAtomicArtifactsJson(): str =
    var roles = [
        "binding_report",
        "compile_receipt",
        "csg_sidecar",
        "consume_trace",
        "output",
        "semantic_receipt",
        "source_receipt"]
    let traceRoles = CidEvidenceAtomicTraceRoles()
    for roleIndex in 0..<traceRoles.len:
        add(roles, share(traceRoles[roleIndex]))
    CidEvidenceSortTexts(roles)
    var out = "{"
    for roleIndex in 0..<roles.len:
        if roleIndex > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            CidEvidenceJsonString(roles[roleIndex]),
            ":",
            CidEvidenceJsonString(
                CidEvidenceArtifactRelativePath(roles[roleIndex]))])
    return CidEvidenceJoin([out, "}"])

fn CidEvidenceSourceIndexCase(
        caseId: str,
        kind: str,
        artifactRoot: str,
        compiledOutput: str,
        caseRoot: str): Result[bool] =
    let workspaceRoot = caseRoot
    let sourcePath = chengpath.PathJoin(
        workspaceRoot,
        "src/main.cheng")
    let request = creq.CompilerRequestNew(
        share(workspaceRoot),
        sourcePath,
        compiledOutput,
        "x86_64-unknown-linux-gnu",
        creq.EmitExe,
        "")
    var err = ""
    var files = [
        "artifacts/binding-report.kv",
        "artifacts/compile-receipt.kv",
        "artifacts/csg-sidecar.kv",
        "artifacts/output.bin",
        "artifacts/semantic-receipt.kv",
        "artifacts/source-receipt.kv"]
    if kind == "zero_byte_import":
        let zeroFiles = [
            "artifacts/missing-probe.stderr",
            "artifacts/missing-probe.stdout",
            "artifacts/missing-probe-trace.json",
            "artifacts/zero-entry.cheng",
            "artifacts/zero-entry-receipt.kv",
            "artifacts/zero-entry.stderr",
            "artifacts/zero-entry.stdout",
            "artifacts/zero-entry-trace.json"]
        for zeroIndex in 0..<zeroFiles.len:
            add(files, strings.CloneStr(zeroFiles[zeroIndex]))
    elif kind == "csg_atomic_consume":
        add(files, CidEvidenceArtifactRelativePath("consume_trace"))
        let traceRoles = CidEvidenceAtomicTraceRoles()
        for roleIndex in 0..<traceRoles.len:
            add(files, CidEvidenceArtifactRelativePath(traceRoles[roleIndex]))

    var identityPlan: slplan.SystemLinkPlanStub
    if !slplan.BuildSystemLinkPlanStub(
            workspaceRoot, request, identityPlan, err):
        return Err[bool](err)
    var modules: CidEvidenceModule[]
    let sourceCount = identityPlan.sourceClosurePaths.len
    if sourceCount <= 0 ||
       sourceCount != identityPlan.ownerModulePaths.len:
        return Err[bool]("CID evidence: source closure column mismatch")
    for sourceIndex in 0..<sourceCount:
        var row: CidEvidenceModule
        row.modulePath = identityPlan.ownerModulePaths[sourceIndex]
        row.sourcePath = identityPlan.sourceClosurePaths[sourceIndex]
        row.payloadPath = CidEvidenceJoin([
            "modules/source-", strings.IntToStr(sourceIndex), ".cheng"])
        add(modules, row)
    CidEvidenceSortModules(modules)
    for moduleIndex in 0..<modules.len:
        let sourceReadRes = os.ReadFileResult(modules[moduleIndex].sourcePath)
        if IsErr(sourceReadRes):
            return Err[bool](Error(sourceReadRes))
        CidEvidenceWrite(
            artifactRoot,
            modules[moduleIndex].payloadPath,
            Value(sourceReadRes),
            files)

    var providers = identityPlan.providerModules
    CidEvidenceSortTexts(providers)
    let entryIndex = identityPlan.sourceBundleEntrySourceIndex
    if entryIndex < 0 || entryIndex >= identityPlan.ownerModulePaths.len:
        return Err[bool]("CID evidence: entry source index")
    let entryModulePath = identityPlan.ownerModulePaths[entryIndex]
    os.WriteFile(
        chengpath.PathJoin(artifactRoot, "case-index.json"),
        CidEvidenceCaseIndex(
            caseId,
            kind,
            identityPlan.packageId,
            entryModulePath,
            providers,
            modules,
            kind == "zero_byte_import" ?
                CidEvidenceZeroArtifactsJson() :
                kind == "csg_atomic_consume" ?
                    CidEvidenceAtomicArtifactsJson() :
                    CidEvidenceSourceArtifactsJson()))
    CidEvidenceWriteFileList(artifactRoot, files)
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var caseRoot = ""
    if cmdline.hasFlag("--prepare-case"):
        if !cmdline.readFlagValue("--case", caseId) ||
           !cmdline.readFlagValue("--case-root", caseRoot) ||
           caseId == "" || caseRoot == "":
            os.WriteLine(os.Get_stderr(), "CID evidence: missing prepare flag")
            return 2
        if !CidEvidencePrepareCase(caseId, caseRoot):
            os.WriteLine(os.Get_stderr(), "CID evidence: unknown prepare case")
            return 2
        return 0
    var artifactRoot = ""
    var compiledOutput = ""
    var evidencePrefix = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--case-root", caseRoot) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--compiled-output", compiledOutput) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix):
        os.WriteLine(os.Get_stderr(), "CID evidence: missing required flag")
        return 2
    if caseId == "" || caseRoot == "" || artifactRoot == "" ||
       compiledOutput == "" || evidencePrefix == "":
        os.WriteLine(os.Get_stderr(), "CID evidence: empty required flag")
        return 2
    if caseId != "source-bundle-entry" &&
       caseId != "zero-byte-import" &&
       caseId != "source-csg-binding" &&
       caseId != "csg-atomic-consume":
        os.WriteLine(os.Get_stderr(), "CID evidence: source case required")
        return 17
    var kind = "source_bundle_entry"
    if caseId == "zero-byte-import":
        kind = "zero_byte_import"
    elif caseId == "source-csg-binding":
        kind = "source_csg_binding"
    elif caseId == "csg-atomic-consume":
        kind = "csg_atomic_consume"
    let result = CidEvidenceSourceIndexCase(
        caseId, kind, artifactRoot, compiledOutput, caseRoot)
    if IsErr(result):
        os.WriteLine(os.Get_stderr(), Error(result))
        return 1
    return 0
