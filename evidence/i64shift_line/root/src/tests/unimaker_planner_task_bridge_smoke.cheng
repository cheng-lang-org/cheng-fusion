import std/os
import std/strings
import std/strutils as strutil
import cheng/inference/planner_task as ptask
import cheng/apps/unimaker/mobile/unimaker_planner_task_bridge_core as bridge

# 小优规划器桥冒烟 (SABI 进程内 FFI): 逐条驱动 @exportc 桥入口经 C 桩捕获
# emit 字节断言。任务03 失败语义迁移:
#   - 8 组 taskKind 用例 (7 taskKind + 1 空文本边界, 转录自
#     planner_task_kind_smoke.cheng) 走显式规则导出
#     cheng_unimaker_planner_classify_task_kind_rules —— 规则语义经 C 边界
#     逐字节一致; 分类规则本身由 planner_task_kind_smoke.cheng 验证。
#   - 模型导出 cheng_unimaker_planner_classify_task_kind 在 env 未设时必须
#     rc=2 且零 emit (clear -> 调用 -> touched==0): 失败无 emit 副作用,
#     不发生成功伪装。

@importc("unimaker_test_emit_matches")
fn UnimakerTestEmitMatchesRaw(expectedRaw: ptr, expectedLen: int64): int32

@importc("unimaker_test_emit_clear")
fn UnimakerTestEmitClear(): int32

@importc("unimaker_test_emit_touched")
fn UnimakerTestEmitTouched(): int32

fn checkBridgeKind(label: str, text: str, expected: str) =
    let ownedLabel = strings.CloneStr(label)
    let ownedText = strings.CloneStr(text)
    let ownedExpected = strings.CloneStr(expected)
    UnimakerTestEmitClear()
    let rc = bridge.cheng_unimaker_planner_classify_task_kind_rules(
        StrDataPtr(ownedText), int64(len(ownedText))
    )
    assert(rc == 0, strutil.Join([
        "unimaker_planner_task_bridge_smoke: ",
        strings.CloneStr(ownedLabel),
        " emit rc != 0"
    ], ""))
    let matched = UnimakerTestEmitMatchesRaw(StrDataPtr(ownedExpected), int64(len(ownedExpected)))
    assert(matched == 1, strutil.Join([
        "unimaker_planner_task_bridge_smoke: ",
        strings.CloneStr(ownedLabel),
        " expected=",
        strings.CloneStr(ownedExpected),
        " emit mismatch"
    ], ""))
    echo(strutil.Join([
        strings.CloneStr(ownedLabel),
        ": ",
        strings.CloneStr(ownedText),
        " -> ",
        strings.CloneStr(ownedExpected)
    ], ""))

fn main(): int32 =
    checkBridgeKind(
        "publish-short-video-draft",
        "帮我发布一个宠物视频",
        ptask.PlannerTaskKindPublishShortVideoDraft
    )
    checkBridgeKind(
        "publish-ad-video-draft",
        "帮我发布一个广告视频",
        ptask.PlannerTaskKindPublishAdVideoDraft
    )
    checkBridgeKind(
        "authorized-product-publish-draft",
        "帮我从淘宝导入商品",
        ptask.PlannerTaskKindAuthorizedProductPublishDraft
    )
    checkBridgeKind(
        "purchase-assist-review",
        "帮我买一件外套",
        ptask.PlannerTaskKindPurchaseAssistReview
    )
    checkBridgeKind(
        "feed-filter-review",
        "附近二手手机,查看一下距离",
        ptask.PlannerTaskKindFeedFilterReview
    )
    checkBridgeKind(
        "content-search-review",
        "帮我搜一下附近的咖啡馆",
        ptask.PlannerTaskKindContentSearchReview
    )
    checkBridgeKind(
        "unsupported-review",
        "今天天气怎么样",
        ptask.PlannerTaskKindUnsupportedReview
    )

    # 空文本同样归 unsupported-review (镜像 JS !text 早退)。
    checkBridgeKind(
        "unsupported-review-empty",
        "",
        ptask.PlannerTaskKindUnsupportedReview
    )

    # 模型导出失败语义: env 未设 (本 smoke 的默认环境) -> rc=2, 且自 clear
    # 以来零 emit。env 被外部设置指向真权重时本断言的前提不成立, 跳过并如实
    # 打印 (不是失败)。
    if os.GetEnv("CHENG_PLANNER_CONFIG") == "" && os.GetEnv("CHENG_PLANNER_WEIGHTS") == "":
        UnimakerTestEmitClear()
        let failText = strings.CloneStr("帮我发布一个宠物视频")
        let failRc = bridge.cheng_unimaker_planner_classify_task_kind(
            StrDataPtr(failText), int64(len(failText))
        )
        assert(failRc == 2, strutil.Join([
            "unimaker_planner_task_bridge_smoke: model export env-unset rc=",
            strings.IntToStr(failRc),
            " expected 2"
        ], ""))
        assert(UnimakerTestEmitTouched() == 0,
               "unimaker_planner_task_bridge_smoke: model export failure emitted (side effect)")
        echo("unimaker_planner_task_bridge_smoke: model-export env-unset reject rc=2 no-emit ok")
    else:
        echo("unimaker_planner_task_bridge_smoke: planner env set, skip env-unset reject assertion")

    echo("unimaker_planner_task_bridge_smoke ok")
    return 0
