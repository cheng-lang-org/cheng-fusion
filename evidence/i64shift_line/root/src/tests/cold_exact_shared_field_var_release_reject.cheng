import std/seqs

type
    ColdExactSharedReleaseInner =
        values: str[]

    ColdExactSharedReleaseOwner = ref object
        inner: ColdExactSharedReleaseInner

fn main(): int32 =
    var owner = new(ColdExactSharedReleaseOwner)
    add(owner.inner.values, "borrowed")
    let borrowedInner = owner.inner
    seqs.freeSeqStrRelease(borrowedInner.values)
    return 0
