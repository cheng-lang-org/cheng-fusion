import cheng/core/lang/parser as parser
import cheng/tests/cold_aggregate_field_store_left as left

type
    ColdAggregateQualifiedNested =
        payload: left.AggregateIdentity

    ColdAggregateQualifiedFieldStoreHolder =
        lookup: parser.ParserTextLookup
        nested: ColdAggregateQualifiedNested

fn ColdAggregateQualifiedLookupBuild(): parser.ParserTextLookup =
    return parser.ParserTextLookup()

fn ColdAggregateQualifiedStore(holder: var ColdAggregateQualifiedFieldStoreHolder,
                               payload: var left.AggregateIdentity) =
    holder.nested.payload = payload

fn main(): int32 =
    var holder: ColdAggregateQualifiedFieldStoreHolder
    holder.lookup = ColdAggregateQualifiedLookupBuild()
    holder.nested.payload = left.AggregateIdentity(label: "layout", values: [3, 5, 8, 13])
    var replacement = left.AggregateIdentity(label: "borrowed", values: [21, 34, 55, 89])
    ColdAggregateQualifiedStore(holder, replacement)
    if holder.lookup.totalCount != 0:
        return 1
    if holder.nested.payload.label != "borrowed":
        return 2
    if holder.nested.payload.values[2] != 55:
        return 3
    return 0
