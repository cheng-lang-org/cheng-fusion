# 世界 CSG producer 冒烟 (B1): 观测 -> 世界事实 -> 校验 -> 物化重放。
# 真值 = VFR 样例逐帧 tick (stts 展开, 48 帧, 首帧 0, 末帧前 25088 tick)。
# 另验: 乱序重放同 CID、非单调负例拒绝、materializer 逐 tick 定位。
# 用法: csg_world_b1_smoke <fixturesDir>
import std/cmdline
import std/strings
import std/crypto/sha256
import std/rawbytes
import cheng/game/assets/import/mp4
import cheng/game/assets/import/reader
import cheng/game/assets/reconstruction/observation
import cheng/game/csg/world_schema
import cheng/game/csg/world_producer
import cheng/game/csg/world_validation

fn buildObservation(path: str): observation.AssetVideoObservation =
    var bounds = reader.AssetReaderBoundsFor("mp4")
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(path, bounds, data), "mp4 loaded")
    var digest = sha256.Sha256Digest(data)
    defer:
        rawbytes.BytesFree(digest)
    let sourceCid = rawbytes.BytesToHex(digest)
    var info: mp4.AssetMp4Info
    var err: str
    assert(mp4.AssetMediaParseMp4(data, info, err), Fmt"mp4 parses: {err}")
    var vi: int32 = -1
    for i in 0..<info.tracks.len:
        if info.tracks[i].handler == mp4.AssetMediaHandlerVide():
            vi = i
            break
    assert(vi >= 0, "vide track present")
    var obs = observation.AssetVideoObserveFromTrack(info.tracks[vi].handler,
        info.tracks[vi].timebase, info.tracks[vi].sampleCount,
        info.tracks[vi].mediaDuration, info.tracks[vi].sttsCounts,
        info.tracks[vi].sttsDeltas, info.tracks[vi].stssSamples,
        path, sourceCid)
    rawbytes.BytesFree(data)
    return obs

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 1:
        echo("usage: csg_world_b1_smoke <fixturesDir>")
        return 2
    let fixturesDir = Fmt"{cmdline.paramStr(1)}"
    var obs = buildObservation(Fmt"{fixturesDir}/media/sample_vfr_bframes.mp4")
    assert(observation.AssetVideoObservationValid(obs), "observation valid")
    assert(obs.sampleCount == 48, "48 frames")
    assert(obs.frameTicks.len == 48, "48 frame ticks")
    assert(obs.frameTicks[0] == int64(0), "frame0 tick 0")
    assert(obs.frameTicks[1] == int64(512), "frame1 tick 512")
    assert(obs.frameTicks[47] == int64(25600), "frame47 tick 25600")

    # 生产: 两遍字节一致
    var f1 = world_producer.WorldProduceFromObservation(obs)
    var f2 = world_producer.WorldProduceFromObservation(obs)
    assert(f1.facts.len == 49, "1 entity + 48 frames")
    assert(f1.facts.len == f2.facts.len, "same length")
    var same: bool = true
    var i: int32
    while i < f1.facts.len:
        if f1.facts[i] != f2.facts[i]:
            same = false
        i = i + 1
    assert(same, "two productions byte-identical")

    # 校验: 正例通过
    var rep = world_validation.WorldValidateFactSet(f1, obs)
    assert(rep.ok, Fmt"validate: {rep.firstError}")
    assert(rep.entityLines == 1 && rep.frameLines == 48, "1+48 lines")

    # 负例: 篡改一帧 tick => 偏离观测真值拒绝
    f1.facts[5] = Fmt"world.timeline.frame|entity={f1.entityId}|index=4|tick=99999|ms=0|origin=derived"
    var repBad = world_validation.WorldValidateFactSet(f1, obs)
    assert(!repBad.ok, "tampered tick rejected")

    # materializer: 帧 index 定位 at tick
    # tick=0 -> frame0; tick=600 -> frame1 (帧1 覆盖 [512,1536)); tick=26111 -> frame47
    var tickAt: int64 = obs.frameTicks[0]
    assert(tickAt == int64(0), "frame0 at tick 0")
    var f1tick: int64 = obs.frameTicks[1]
    var f47tick: int64 = obs.frameTicks[47]
    assert(f1tick == int64(512) && f47tick == int64(25600), "frame ticks spot check")
    # 帧 i 的显示 ms (末帧 25600 tick = 2083ms)
    var lastMs: int64 = obs.frameTicks[47] * int64(1000) / int64(obs.timescale)
    assert(lastMs == int64(2083), "frame47 ms 2083")

    echo("csg_world_b1_smoke PASS")
    return 0
