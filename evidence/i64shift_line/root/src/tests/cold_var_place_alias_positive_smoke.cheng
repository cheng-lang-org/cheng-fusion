type
    VarPlacePair =
        left: int32
        right: int32

fn VarPlaceSetPair(left: var int32, right: var int32) =
    left = 31
    right = 47

fn VarPlaceForwardPair(left: var int32, right: var int32) =
    VarPlaceSetPair(left, right)

fn main(): int32 =
    var first: int32
    var second: int32
    VarPlaceForwardPair(first, second)
    if first != 31 || second != 47:
        return 1

    var pair: VarPlacePair
    VarPlaceSetPair(pair.left, pair.right)
    if pair.left != 31 || pair.right != 47:
        return 2

    var values: int32[3]
    VarPlaceSetPair(values[0], values[1])
    if values[0] != 31 || values[1] != 47 ||
       values[2] != 0:
        return 3
    return 0
