@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *

@trusted_abi
fn PutBreak() =
    var i = 0
    while i < 100:
        let addr = ptr(uint64(268435456))
        *(IoUInt8Ptr(addr)) = uint8(72)
        if i == 0:
            i = i + 100
            break
        i = i + 1

fn main(): int32 =
    PutBreak()
    return 0
