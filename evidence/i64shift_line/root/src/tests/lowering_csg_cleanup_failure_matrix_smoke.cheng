import std/os
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/lang/intern as langintern

fn cleanupFixtureInit(csg: var ccsg.CompilerCsg,
                      includeNode: bool,
                      validResolvedSnapshot: bool) =
    csg.exprLayer.sourceCount = 1
    csg.semanticGraph = ccsg.CompilerCsgSemanticInit()
    csg.semanticGraph.exprSliceTypedFactComplete = true
    if validResolvedSnapshot:
        csg.semanticGraph.resolvedCallTable.internPool = langintern.InternPoolNew()
    if includeNode:
        var node: ccsg.CompilerCsgNode
        node.nodeId = 1
        add(csg.nodes, node)

fn cleanupFixtureAssertReleased(csg: var ccsg.CompilerCsg,
                                plan: var lower.LoweringPlanStub,
                                label: str) =
    assert(csg.exprLayer.sourceCount == 0,
           Fmt"{label}: compiler csg expr layer not released")
    assert(csg.nodes.len == 0 && csg.edges.len == 0,
           Fmt"{label}: compiler csg graph payload not released")
    assert(csg.semanticGraph.builderName == "",
           Fmt"{label}: compiler csg payload not released")
    assert(plan.exprLayer.sourceCount == 0,
           Fmt"{label}: moved expr layer not released")
    assert(plan.compilerCsgExprSliceSidecar.sourceIndex.len == 0,
           Fmt"{label}: moved expr-slice payload not released")
    assert(plan.resolvedCallSnapshot.internPool == nil,
           Fmt"{label}: moved resolved-call payload not released")
    assert(plan.importEdges.len == 0,
           Fmt"{label}: lowering import payload not released")
    assert(plan.workspaceRoot == "" && plan.packageRoot == "" && plan.entryPath == "",
           Fmt"{label}: lowering plan identity payload not released")

fn cleanupFixtureRunFailure(caseId: int32,
                            expectedError: str) =
    var linkPlan: slplan.SystemLinkPlanStub
    var sourceBundleOwner: slplan.SystemLinkPlanSourceBundleOwner
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str

    let validResolvedSnapshot = caseId != 4
    cleanupFixtureInit(csg, true, validResolvedSnapshot)
    if caseId == 1:
        csg.semanticGraph = ccsg.CompilerCsgSemanticGraph()
    elif caseId == 2:
        csg.typedExprFactCountSnapshot = 1
    elif caseId == 3:
        csg.semanticGraph.exprSliceTypedFactComplete = false
        csg.semanticGraph.exprSliceValidationReason = "failure_matrix"
    elif caseId == 4:
        csg.semanticGraph.resolvedCallTable = ccsg.CompilerCsgSemanticResolvedCallTable()
    elif caseId != 5:
        panic("lowering csg cleanup failure matrix: unknown case")

    let ok =
        lower.BuildLoweringPlanStubFromCompilerCsgBorrowedWithSourceBundleOwner(
            linkPlan,
            sourceBundleOwner,
            csg,
            plan,
            err)
    assert(!ok, Fmt"failure_case_{caseId}: unexpectedly succeeded")
    assert(err == expectedError,
           Fmt"failure_case_{caseId}: wrong error: {err}")
    cleanupFixtureAssertReleased(csg, plan, Fmt"failure_case_{caseId}")

fn cleanupFixtureRunSuccess() =
    var linkPlan: slplan.SystemLinkPlanStub
    var sourceBundleOwner: slplan.SystemLinkPlanSourceBundleOwner
    var csg: ccsg.CompilerCsg
    var plan: lower.LoweringPlanStub
    var err: str
    cleanupFixtureInit(csg, false, true)
    let ok =
        lower.BuildLoweringPlanStubFromCompilerCsgBorrowedWithSourceBundleOwner(
            linkPlan,
            sourceBundleOwner,
            csg,
            plan,
            err)
    assert(ok, Fmt"success_case: failed: {err}")
    assert(err == "", "success_case: non-empty error")
    assert(plan.pipelineStage == "canonical_csg_to_lowering_plan",
           "success_case: lowering pipeline stage")
    assert(csg.exprLayer.sourceCount == 0 && csg.nodes.len == 0 &&
           csg.semanticGraph.builderName == "",
           "success_case: compiler csg payload not released by lowering")
    lower.LoweringPlanReleasePrePrimaryObjectPayload(plan)
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)

fn main(): int32 =
    cleanupFixtureRunFailure(
        1,
        " lowering plan: compiler csg snapshot missing")
    cleanupFixtureRunFailure(
        2,
        " lowering plan: typed-fact snapshot count mismatch expected=1 actual=0")
    cleanupFixtureRunFailure(
        3,
        " lowering plan: compiler csg expr-slice sidecar incomplete reason=failure_matrix gaps=0 overlaps=0 invalid=0 synthetic=0")
    cleanupFixtureRunFailure(
        4,
        " lowering plan: resolved-call snapshot column length mismatch")
    cleanupFixtureRunFailure(
        5,
        " lowering plan: compiler csg typed ir missing")
    cleanupFixtureRunSuccess()
    os.WriteLine(os.GetStdout(),
                 "lowering_csg_cleanup_failure_matrix ok failures=5 success=1")
    return 0
