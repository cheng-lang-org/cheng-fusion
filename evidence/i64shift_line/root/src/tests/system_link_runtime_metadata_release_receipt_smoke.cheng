import std/cmdline
import std/os
import std/os_host_process as hostos
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_csg_production_lifetime as csglife
import cheng/core/tooling/compiler_payload_lifecycle as compilerlife
import cheng/core/tooling/compiler_world as cworld
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

fn RuntimeMetadataFixture(
        kind: int32,
        ordinal: int32): sexec.SystemLinkExecPlan =
    var plan: sexec.SystemLinkExecPlan
    let executionTokenId =
        int64(kind + 1) * int64(100000) + int64(ordinal + 1)
    sexec.SystemLinkExecOwnerLedgerInit(
        plan.allocationOwnerLedger,
        executionTokenId)
    let _ = sexec.SystemLinkExecOwnerLedgerAppend(
        plan.allocationOwnerLedger,
        sexec.SystemLinkExecOwnerKindRuntimeMetadata,
        true)
    sexec.SystemLinkExecOwnerLedgerMoveToRuntime(
        plan.allocationOwnerLedger)
    if kind == 3:
        csglife.CompilerCsgProductionLifetimeBegin(
            plan.compilerCsg,
            plan.compilerCsgProductionLifetime)
        return plan

    plan.compilerCsg.packageId = Fmt"pkg-{kind}-{ordinal}"
    plan.compilerCsg.typedIrRoundBuildMsCsv = "1,2"
    var node: ccsg.CompilerCsgNode
    node.modulePath = "module"
    node.symbolText = "Symbol"
    node.factText = "fact"
    node.semanticSource = "semantic"
    node.semanticParamTypeJoin = "int32"
    node.semanticReturnType = "int32"
    node.exportSymbolName = "Symbol"
    add(plan.compilerCsg.nodes, node)
    plan.compilerCsg.nodeCount = 1
    if kind == 2:
        csglife.CompilerCsgProductionLifetimeBegin(
            plan.compilerCsg,
            plan.compilerCsgProductionLifetime)
        return plan

    plan.exportSurface.packageId = "pkg"
    add(plan.exportSurface.exportedSymbols, "Root")
    add(plan.exportSurface.exportedTargetNames, "_Root")
    add(plan.exportSurface.exportedLayouts, 1)
    add(plan.exportSurface.exportedEffects, 2)
    add(plan.exportSurface.exportedCapabilities, 3)

    plan.localUniverse.compilerSnapshot.packageId = "cheng/compiler"
    plan.localUniverse.compilerSnapshot.channel = "stable"
    plan.localUniverse.compilerSnapshot.signature = "compiler-signature"
    plan.localUniverse.stdSnapshot.packageId = "cheng/std"
    plan.localUniverse.stdSnapshot.channel = "stable"
    plan.localUniverse.stdSnapshot.signature = "std-signature"
    plan.localUniverse.runtimeSnapshot.packageId = "cheng/runtime"
    plan.localUniverse.runtimeSnapshot.channel = "stable"
    plan.localUniverse.runtimeSnapshot.signature = "runtime-signature"
    plan.localUniverse.manifest.channel = "stable"
    var universeEntry: cworld.CompilerUniverseManifestEntry
    universeEntry.packageId = "cheng/compiler"
    add(plan.localUniverse.manifest.entries, universeEntry)
    plan.localUniverse.worldHead.universeId = "cheng/compiler_universe"
    plan.localUniverse.worldHead.channel = "stable"
    plan.localUniverse.worldHead.signature = "world-signature"

    plan.compileReceipt.targetTriple = "arm64-apple-darwin"
    plan.compileReceipt.bootstrapStage = "stage3_local"
    add(plan.compileReceipt.runtimeProviderSet, "runtime/core")
    plan.notReadyReason = "ready"
    if kind == 1:
        plan.notReadyReason = "abort"
    plan.compilerEntrySource = "src/main.cheng"
    plan.managedDependencyReceipt.channel = "stable"
    var dependencyEntry: slplan.SystemLinkPlanManagedDependencyReceiptEntry
    dependencyEntry.canonicalPackageId = "pkg://dependency"
    add(plan.managedDependencyReceipt.entries, dependencyEntry)
    plan.lockPath = "cheng.lock"
    plan.baselineSurfacePath = "baseline.surface"
    plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top0Kind = "csg"
    plan.phaseMemoryLedger.csgToLoweringAndBackendRelease.top1Kind = "typed"
    plan.phaseMemoryLedger.loweringPreRelease.top0Kind = "lowering"
    plan.phaseMemoryLedger.loweringPreRelease.top1Kind = "source"
    plan.phaseMemoryLedger.primaryBuild.top0Kind = "primary"
    plan.phaseMemoryLedger.primaryBuild.top1Kind = "body"
    plan.phaseMemoryLedger.primaryRelease.top0Kind = "primary-release"
    plan.phaseMemoryLedger.primaryRelease.top1Kind = "body-release"
    plan.phaseMemoryLedger.loweringTerminalRelease.top0Kind = "lowering-terminal"
    plan.phaseMemoryLedger.loweringTerminalRelease.top1Kind = "terminal"
    plan.phaseMemoryLedger.reportPayloadAssembly.top0Kind = "report"
    plan.phaseMemoryLedger.reportPayloadAssembly.top1Kind = "payload"
    plan.exactFunctionCoverage.entrySourcePath = "src/main.cheng"
    plan.exactFunctionCoverage.targetSourcePath = "src/main.cheng"
    plan.exactFunctionCoverage.targetTriple = "arm64-apple-darwin"
    plan.exactFunctionCoverage.driverPath = "build/chengc"
    plan.exactFunctionCoverage.functionName = "Root"
    plan.exactFunctionCoverage.outputKind = "obj"
    plan.exactFunctionCoverage.outputPath = "build/main.o"
    csglife.CompilerCsgProductionLifetimeBegin(
        plan.compilerCsg,
        plan.compilerCsgProductionLifetime)
    return plan

fn RuntimeMetadataRequireLiveZero(
        plan: var sexec.SystemLinkExecPlan,
        label: str) =
    assert(sexec.SystemLinkExecRuntimeMetadataStorageReleased(plan),
           Fmt" runtime metadata receipt: storage not released {label}")
    assert(sexec.SystemLinkExecRuntimeMetadataRetainedBufferCount(plan) == 0,
           Fmt" runtime metadata receipt: live buffers {label}")
    assert(sexec.SystemLinkExecRuntimeMetadataRetainedBytes(plan) == int64(0),
           Fmt" runtime metadata receipt: live bytes {label}")

fn RuntimeMetadataReceiptClone(
        source: var sexec.SystemLinkExecRuntimeMetadataReleaseReceipt): sexec.SystemLinkExecRuntimeMetadataReleaseReceipt =
    var out: sexec.SystemLinkExecRuntimeMetadataReleaseReceipt
    out.ownerToken = source.ownerToken
    out.releasedOwnedStorageColumnCount =
        source.releasedOwnedStorageColumnCount
    out.releasedBufferCount = source.releasedBufferCount
    out.releasedBytes = source.releasedBytes
    out.storageReleased = source.storageReleased
    return out

fn RuntimeMetadataReleaseOnce(
        kind: int32,
        ordinal: int32) =
    var plan = RuntimeMetadataFixture(kind, ordinal)
    let beforeBuffers =
        sexec.SystemLinkExecRuntimeMetadataRetainedBufferCount(plan)
    let beforeBytes =
        sexec.SystemLinkExecRuntimeMetadataRetainedBytes(plan)
    var receipt: sexec.SystemLinkExecRuntimeMetadataReleaseReceipt
    sexec.SystemLinkExecRuntimeMetadataReleaseWithReceipt(
        plan,
        compilerlife.CompilerPayloadOutcomeSuccess,
        receipt)
    assert(receipt.releasedOwnedStorageColumnCount == 12 &&
           receipt.releasedBufferCount == beforeBuffers &&
           receipt.releasedBytes == beforeBytes &&
           receipt.storageReleased,
           " runtime metadata receipt: exact release receipt")
    RuntimeMetadataRequireLiveZero(plan, "release-once")
    var err: str
    let consumeOk =
        sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, receipt, err)
    assert(consumeOk && len(err) == 0 &&
           plan.runtimeMetadataReleaseReceiptConsumed,
        " runtime metadata receipt: strict consume")
    sexec.SystemLinkExecOwnerLedgerReleaseStorage(
        plan.allocationOwnerLedger,
        compilerlife.CompilerPayloadOutcomeSuccess)
    assert(sexec.SystemLinkExecOwnerLedgerStorageReleased(
               plan.allocationOwnerLedger),
           " runtime metadata receipt: owner ledger storage live")

fn RuntimeMetadataFourShapeThousandSmoke() =
    for ordinal in 0..<1000:
        RuntimeMetadataReleaseOnce(0, ordinal)
        RuntimeMetadataReleaseOnce(1, ordinal)
        RuntimeMetadataReleaseOnce(2, ordinal)
        RuntimeMetadataReleaseOnce(3, ordinal)

fn RuntimeMetadataTamperSmoke() =
    var plan = RuntimeMetadataFixture(0, 2001)
    var receipt: sexec.SystemLinkExecRuntimeMetadataReleaseReceipt
    sexec.SystemLinkExecRuntimeMetadataReleaseWithReceipt(
        plan,
        compilerlife.CompilerPayloadOutcomeSuccess,
        receipt)
    RuntimeMetadataRequireLiveZero(plan, "tamper")
    var err: str

    var wrongToken = RuntimeMetadataReceiptClone(receipt)
    wrongToken.ownerToken.data[0] =
        wrongToken.ownerToken.data[0] ^ uint8(1)
    assert(!sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, wrongToken, err),
        " runtime metadata receipt: wrong token accepted")
    var wrongColumns = RuntimeMetadataReceiptClone(receipt)
    wrongColumns.releasedOwnedStorageColumnCount =
        wrongColumns.releasedOwnedStorageColumnCount + 1
    assert(!sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, wrongColumns, err),
        " runtime metadata receipt: wrong column count accepted")
    var wrongBuffers = RuntimeMetadataReceiptClone(receipt)
    wrongBuffers.releasedBufferCount =
        wrongBuffers.releasedBufferCount + 1
    assert(!sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, wrongBuffers, err),
        " runtime metadata receipt: wrong buffer count accepted")
    var wrongBytes = RuntimeMetadataReceiptClone(receipt)
    wrongBytes.releasedBytes = wrongBytes.releasedBytes + int64(1)
    assert(!sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, wrongBytes, err),
        " runtime metadata receipt: wrong byte count accepted")
    var wrongStorage = RuntimeMetadataReceiptClone(receipt)
    wrongStorage.storageReleased = false
    assert(!sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, wrongStorage, err),
        " runtime metadata receipt: false storage proof accepted")

    var otherPlan = RuntimeMetadataFixture(1, 2002)
    var otherReceipt: sexec.SystemLinkExecRuntimeMetadataReleaseReceipt
    sexec.SystemLinkExecRuntimeMetadataReleaseWithReceipt(
        otherPlan,
        compilerlife.CompilerPayloadOutcomeSuccess,
        otherReceipt)
    var swappedReceipt = RuntimeMetadataReceiptClone(otherReceipt)
    assert(!sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, swappedReceipt, err),
        " runtime metadata receipt: swapped receipt accepted")
    var validReceipt = RuntimeMetadataReceiptClone(receipt)
    assert(sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, validReceipt, err),
        " runtime metadata receipt: valid receipt rejected after tamper")
    var duplicateReceipt = RuntimeMetadataReceiptClone(receipt)
    assert(!sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            plan, duplicateReceipt, err),
        " runtime metadata receipt: duplicate consume accepted")
    var otherValidReceipt = RuntimeMetadataReceiptClone(otherReceipt)
    assert(sexec.SystemLinkExecRuntimeMetadataReleaseReceiptConsumeStrictInto(
            otherPlan, otherValidReceipt, err),
        " runtime metadata receipt: swapped source receipt rejected")
    sexec.SystemLinkExecOwnerLedgerReleaseStorage(
        plan.allocationOwnerLedger,
        compilerlife.CompilerPayloadOutcomeSuccess)
    sexec.SystemLinkExecOwnerLedgerReleaseStorage(
        otherPlan.allocationOwnerLedger,
        compilerlife.CompilerPayloadOutcomeSuccess)

fn RuntimeMetadataDuplicateReleaseHardFailChild(): int32 =
    var plan = RuntimeMetadataFixture(0, 3001)
    var receipt: sexec.SystemLinkExecRuntimeMetadataReleaseReceipt
    sexec.SystemLinkExecRuntimeMetadataReleaseWithReceipt(
        plan,
        compilerlife.CompilerPayloadOutcomeSuccess,
        receipt)
    sexec.SystemLinkExecRuntimeMetadataReleaseWithReceipt(
        plan,
        compilerlife.CompilerPayloadOutcomeSuccess,
        receipt)
    return 3

fn RuntimeMetadataDuplicateReleaseSmoke() =
    let selfPath = cmdline.ParamStr(0)
    let result = hostos.ExecFileCapture(
        selfPath,
        ["duplicate-release"],
        [],
        "",
        true,
        60)
    assert(os.ExecCmdResultExitCode(result) == 1 &&
           strutil.Contains(
               os.ExecCmdResultOutput(result),
               "duplicate or corrupt runtime metadata release"),
           " runtime metadata receipt: duplicate release did not hard-fail")

fn main(): int32 =
    if cmdline.ParamStr(1) == "duplicate-release":
        return RuntimeMetadataDuplicateReleaseHardFailChild()
    RuntimeMetadataFourShapeThousandSmoke()
    RuntimeMetadataTamperSmoke()
    RuntimeMetadataDuplicateReleaseSmoke()
    return 0
