import cheng/core/backend/x86_64_body_emit as x64
import cheng/core/ir/core_types as ir

fn makeSlot(id: int32,
            typeKind: int32,
            stackOffset: int32,
            sizeBytes: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "v"
    slot.typeKind = typeKind
    slot.stackOffset = stackOffset
    slot.sizeBytes = sizeBytes
    slot.alignBytes = sizeBytes >= 8 ? 8 : 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn buildCallBody(argType: int32,
                 resultType: int32,
                 targetIsImportc: bool): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeSlot(0, argType, 32, argType == ir.LocalF64Tag ? 8 : 4))
    add(body.localSlots, makeSlot(1, resultType, 48, resultType == ir.LocalF64Tag ? 8 : 4))
    var call: ir.CallOp
    call.targetSymbol = targetIsImportc ? "ffi_id" : "id_f64"
    add(call.argSlots, 0)
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, argType == ir.LocalF64Tag ? 8 : 4)
    call.resultSlot = 1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    call.targetIsImportc = targetIsImportc
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = 1
    add(op.operands, 0)
    add(body.ops, op)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildCmpBody(conditionKind: int32,
                lhsType: int32,
                rhsType: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeSlot(0, lhsType, 32, lhsType == ir.LocalI32Tag ? 4 : 8))
    add(body.localSlots, makeSlot(1, rhsType, 48, rhsType == ir.LocalI32Tag ? 4 : 8))
    add(body.localSlots, makeSlot(2, ir.LocalI32Tag, 64, 4))
    var compare: ir.BodyOp
    compare.kind = ir.BodyOpCmpTag
    compare.target = 2
    add(compare.operands, conditionKind)
    add(compare.operands, 0)
    add(compare.operands, 1)
    add(body.ops, compare)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 2
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn fillSucceeds(body: var ir.BodyIR): bool =
    if !x64.X64BodyPrepareStackLayout(body) ||
       !body.x64StackLayoutReady || !body.x64BlockStartReady:
        return false
    let wordCount = x64.X64BodyIrWordCount(body)
    if wordCount <= 0:
        return false
    var words: int32[]
    setLen(words, wordCount)
    return x64.X64BodyFillWords(words, 0, wordCount, body) == wordCount

fn byteAt(words: int32[], byteIndex: int32): int32 =
    if byteIndex < 0 || byteIndex / 4 >= words.len:
        return -1
    let shift = uint32((byteIndex % 4) * 8)
    return int32((uint32(words[byteIndex / 4]) >> shift) & uint32(255))

fn internalF64ResultStoreIsExact(body: var ir.BodyIR): bool =
    let wordCount = x64.X64BodyIrWordCount(body)
    if wordCount <= 0 || body.ops.len != 1:
        return false
    let callBytes = x64.X64BodyCallWordCount(body, body.ops[0]) * 4
    if callBytes < 16:
        return false
    var words: int32[]
    setLen(words, wordCount)
    if x64.X64BodyFillWords(words, 0, wordCount, body) != wordCount:
        return false
    let resultStart = x64.X64BodyPrologueByteCount(body) + callBytes - 16
    let expected: int32[13] = [0x66, 0x48, 0x0F, 0x7E, 0xC0,
                               0x48, 0x89, 0x84, 0x24, 0x30, 0, 0, 0]
    for byteIndex in 0..<expected.len:
        if byteAt(words, resultStart + byteIndex) != expected[byteIndex]:
            return false
    return true

fn f64ReturnBridgeIsExact(body: var ir.BodyIR): bool =
    let wordCount = x64.X64BodyIrWordCount(body)
    if wordCount <= 0 || body.ops.len != 1:
        return false
    let callBytes = x64.X64BodyCallWordCount(body, body.ops[0]) * 4
    var words: int32[]
    setLen(words, wordCount)
    if x64.X64BodyFillWords(words, 0, wordCount, body) != wordCount:
        return false
    let bridgeStart = x64.X64BodyPrologueByteCount(body) + callBytes + 8
    let expected: int32[5] = [0x66, 0x48, 0x0F, 0x6E, 0xC0]
    for byteIndex in 0..<expected.len:
        if byteAt(words, bridgeStart + byteIndex) != expected[byteIndex]:
            return false
    return true

fn invalidFillRejected(body: var ir.BodyIR): bool =
    if x64.X64BodyPrepareStackLayout(body) ||
       body.x64StackLayoutReady || body.x64BlockStartReady:
        return false
    if x64.X64BodyIrWordCount(body) != 0:
        return false
    var words: int32[]
    setLen(words, 32)
    return x64.X64BodyFillWords(words, 0, words.len, body) == -1

fn invalidOperationFillRejected(body: var ir.BodyIR): bool =
    if x64.X64BodyPrepareStackLayout(body) ||
       body.x64StackLayoutReady || body.x64BlockStartReady:
        return false
    return true

fn cmpAdmissionBoundaryCases(): bool =
    if x64.X64BodyCondTrueCC(999) != -1:
        return false
    var validF64 = buildCmpBody(ir.BodyCondF64EqTag,
                                ir.LocalF64Tag,
                                ir.LocalF64Tag)
    if x64.X64BodyCmpKind(validF64, validF64.ops[0]) != 2 ||
       !fillSucceeds(validF64):
        return false

    var unknown = buildCmpBody(999, ir.LocalI64Tag, ir.LocalI64Tag)
    if x64.X64BodyCmpKind(unknown, unknown.ops[0]) != 0 ||
       !invalidOperationFillRejected(unknown):
        return false
    var f64WithIntegerCond = buildCmpBody(ir.BodyCondI64EqTag,
                                          ir.LocalF64Tag,
                                          ir.LocalF64Tag)
    if x64.X64BodyCmpKind(f64WithIntegerCond,
                          f64WithIntegerCond.ops[0]) != 0 ||
       !invalidOperationFillRejected(f64WithIntegerCond):
        return false
    var integerWithF64Cond = buildCmpBody(ir.BodyCondF64EqTag,
                                          ir.LocalI64Tag,
                                          ir.LocalI64Tag)
    if x64.X64BodyCmpKind(integerWithF64Cond,
                          integerWithF64Cond.ops[0]) != 0 ||
       !invalidOperationFillRejected(integerWithF64Cond):
        return false
    return true

fn frameBoundaryCases(): bool =
    if x64.X64BodyCheckedAlign16(2147483632) != 2147483632 ||
       x64.X64BodyCheckedAlign16(2147483633) != -1:
        return false
    if x64.X64BodyCheckedCallArgBytes(268435455) != 2147483640 ||
       x64.X64BodyCheckedCallArgBytes(268435456) != -1:
        return false

    var slotEndOverflow = ir.BodyIRNew()
    add(slotEndOverflow.localSlots,
        makeSlot(0, ir.LocalF64Tag, 2147483643, 8))
    if x64.X64BodyValidateFrameLayout(slotEndOverflow) ||
       !invalidFillRejected(slotEndOverflow):
        return false

    var alignOverflow = ir.BodyIRNew()
    add(alignOverflow.localSlots,
        makeSlot(0, ir.LocalI32Tag, 2147483632, 1))
    if x64.X64BodyValidateFrameLayout(alignOverflow) ||
       !invalidFillRejected(alignOverflow):
        return false

    var frameAddOverflow = ir.BodyIRNew()
    add(frameAddOverflow.localSlots,
        makeSlot(0, ir.LocalI64Tag, -268435451, 8))
    if x64.X64BodyValidateFrameLayout(frameAddOverflow) ||
       !invalidFillRejected(frameAddOverflow):
        return false

    var minParam = ir.BodyIRNew()
    add(minParam.localSlots,
        makeSlot(0, ir.LocalI64Tag, -2147483647 - 1, 8))
    if x64.X64BodyValidateFrameLayout(minParam) ||
       !invalidFillRejected(minParam):
        return false
    return true

fn copyMemoryBoundaryCases(): bool =
    # 8-byte chunks: 134217727 * 16 is the largest admitted instruction count.
    if x64.X64BodyCopyMemoryByteCount(1073741816) != 2147483632 ||
       x64.X64BodyCopyMemoryByteCount(1073741824) != -1:
        return false
    # 4-byte-only chunks: 153391689 * 14 is the exact odd-chunk boundary.
    if x64.X64BodyCopyMemoryByteCount(613566756) != 2147483646 ||
       x64.X64BodyCopyMemoryByteCount(613566764) != -1:
        return false
    # Byte chunks use 16 encoded bytes per copied byte.
    if x64.X64BodyCopyMemoryByteCount(134217727) != 2147483632 ||
       x64.X64BodyCopyMemoryByteCount(134217729) != -1:
        return false
    if !x64.X64BodyCopyMemoryRangeSupported(2147483639, 16) ||
       x64.X64BodyCopyMemoryRangeSupported(2147483640, 16):
        return false
    return true

fn copySlotBoundaryCases(): bool =
    var fixed = ir.BodyIRNew()
    add(fixed.localSlots,
        makeSlot(0, ir.LocalAggregateTag, 0, 1073741816))
    add(fixed.localSlots,
        makeSlot(1, ir.LocalAggregateTag, 0, 1073741816))
    if x64.X64BodyCopySlotByteCount(fixed, 0, 1) != 2147483632:
        return false
    fixed.localSlots[0].sizeBytes = 1073741824
    fixed.localSlots[1].sizeBytes = 1073741824
    if x64.X64BodyCopySlotByteCount(fixed, 0, 1) != -1:
        return false

    # The disp8 prefix makes the exact local-inline boundary slightly larger
    # than the all-disp32 memory-copy boundary; the closed form must preserve it.
    var inline = ir.BodyIRNew()
    add(inline.localSlots,
        makeSlot(0, ir.LocalAggregateTag, 0, 1073741864))
    add(inline.localSlots,
        makeSlot(1, ir.LocalAggregateTag, 0, 1073741864))
    if x64.X64BodyCopyLocalInlineBytesDisp(inline, 0, 1, 0) != 2147483632:
        return false
    inline.localSlots[0].sizeBytes = 1073741872
    inline.localSlots[1].sizeBytes = 1073741872
    if x64.X64BodyCopyLocalInlineBytesDisp(inline, 0, 1, 0) != -1:
        return false
    return true

fn sretBoundaryCases(): bool =
    if x64.X64ReturnSretCopyPairCount(12) != 3 ||
       x64.X64ReturnSretCopyPairCount(13) != 13 ||
       x64.X64ReturnSretCopyStride(12) != 4 ||
       x64.X64ReturnSretCopyStride(13) != 1:
        return false
    var body = ir.BodyIRNew()
    add(body.localSlots,
        makeSlot(0, ir.LocalAggregateTag, 32, 12))
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    let termIndex = ir.BodyIRAppendTerm(body, term)
    if x64.X64BodyTermSize(body, termIndex) != 62:
        return false
    body.localSlots[0].sizeBytes = 13
    if x64.X64BodyTermSize(body, termIndex) != 228:
        return false

    body.localSlots[0].sizeBytes = 1073741808
    if x64.X64BodyTermSize(body, termIndex) != 2147483636:
        return false
    body.localSlots[0].sizeBytes = 1073741816
    if x64.X64BodyTermSize(body, termIndex) != 0:
        return false
    body.localSlots[0].sizeBytes = 613566748
    if x64.X64BodyTermSize(body, termIndex) != 2147483638:
        return false
    body.localSlots[0].sizeBytes = 613566756
    if x64.X64BodyTermSize(body, termIndex) != 0:
        return false
    body.localSlots[0].sizeBytes = 134217726
    if x64.X64BodyTermSize(body, termIndex) != 2147483636:
        return false
    body.localSlots[0].sizeBytes = 134217727
    if x64.X64BodyTermSize(body, termIndex) != 0:
        return false
    return true

fn aggregate65Case(): bool =
    var copyBody = ir.BodyIRNew()
    add(copyBody.localSlots,
        makeSlot(0, ir.LocalAggregateTag, 32, 65))
    add(copyBody.localSlots,
        makeSlot(1, ir.LocalAggregateTag, 104, 65))
    var copyOp: ir.BodyOp
    copyOp.kind = ir.BodyOpCopyLocalTag
    copyOp.target = 1
    add(copyOp.operands, 0)
    add(copyBody.ops, copyOp)
    var voidTerm: ir.BodyTerm
    voidTerm.kind = ir.BodyTermReturnTag
    voidTerm.resultSlot = -1
    add(voidTerm.operands, ir.LocalInvalidTag)
    let voidTermIndex = ir.BodyIRAppendTerm(copyBody, voidTerm)
    let _ = ir.BodyIRAppendBlock(copyBody, 0, 1, voidTermIndex)
    if !x64.X64BodyPrepareStackLayout(copyBody) ||
       x64.X64BodyCopySlotByteCount(copyBody, 0, 1) != 1040 ||
       x64.X64BodyOpSizeAt(copyBody, 0) != 1040 ||
       !fillSucceeds(copyBody):
        return false

    var returnBody = ir.BodyIRNew()
    add(returnBody.localSlots,
        makeSlot(0, ir.LocalAggregateTag, 32, 65))
    var returnTerm: ir.BodyTerm
    returnTerm.kind = ir.BodyTermReturnTag
    returnTerm.resultSlot = 0
    let returnTermIndex = ir.BodyIRAppendTerm(returnBody, returnTerm)
    let _ = ir.BodyIRAppendBlock(returnBody, 0, 0, returnTermIndex)
    return x64.X64BodyTermSize(returnBody, returnTermIndex) == 1060 &&
           fillSucceeds(returnBody)

fn aggregateParam4Case(): bool =
    var body = ir.BodyIRNew()
    add(body.localSlots,
        makeSlot(0, ir.LocalAggregateTag, -1, 4))
    add(body.localSlots,
        makeSlot(1, ir.LocalAggregateTag, 32, 4))
    var op: ir.BodyOp
    op.kind = ir.BodyOpCopyLocalTag
    op.target = 1
    add(op.operands, 0)
    add(body.ops, op)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    add(term.operands, ir.LocalInvalidTag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    if !x64.X64BodyPrepareStackLayout(body) ||
       x64.X64BodyCopySlotByteCount(body, 0, 1) != 22 ||
       x64.X64BodyOpSizeAt(body, 0) != 22:
        return false
    return fillSucceeds(body)

fn exportEntryBoundaryCases(): bool =
    var f64Arg = buildCallBody(ir.LocalF64Tag,
                               ir.LocalI32Tag,
                               false)
    f64Arg.entryIsCAbi = true
    f64Arg.localSlots[0].stackOffset = -1
    if x64.X64BodyEntryAbiSupported(f64Arg) ||
       x64.X64BodyProductionAdmission(f64Arg) ||
       !invalidFillRejected(f64Arg):
        return false

    var f64Return = buildCallBody(ir.LocalI32Tag,
                                  ir.LocalF64Tag,
                                  false)
    f64Return.entryIsCAbi = true
    if !x64.X64BodyEntryAbiSupported(f64Return) ||
       !x64.X64BodyProductionAdmission(f64Return) ||
       !fillSucceeds(f64Return) ||
       !f64ReturnBridgeIsExact(f64Return):
        return false
    return true

fn main(): int32 =
    if x64.X64BodyWordsOfChecked(2147483644) != 536870911 ||
       x64.X64BodyWordsOfChecked(2147483645) != 0:
        return 12
    var internalF64 = buildCallBody(ir.LocalF64Tag,
                                    ir.LocalF64Tag,
                                    false)
    if !x64.X64BodyCallStoresScalarResult(internalF64,
                                           internalF64.callSequence[0]):
        return 1
    if !x64.X64BodyCallAbiSupported(internalF64,
                                     internalF64.callSequence[0]) ||
       !x64.X64BodyProductionAdmission(internalF64) ||
       !fillSucceeds(internalF64) ||
       !internalF64ResultStoreIsExact(internalF64) ||
       !f64ReturnBridgeIsExact(internalF64):
        return 2

    var importcF64 = buildCallBody(ir.LocalF64Tag,
                                   ir.LocalF64Tag,
                                   true)
    if !x64.X64BodyCallStoresScalarResult(importcF64,
                                           importcF64.callSequence[0]) ||
       x64.X64BodyCallAbiSupported(importcF64,
                                    importcF64.callSequence[0]) ||
       x64.X64BodyProductionAdmission(importcF64) ||
       !invalidFillRejected(importcF64):
        return 3

    var importcF64Arg = buildCallBody(ir.LocalF64Tag,
                                      ir.LocalI32Tag,
                                      true)
    if x64.X64BodyCallAbiSupported(importcF64Arg,
                                    importcF64Arg.callSequence[0]) ||
       !invalidFillRejected(importcF64Arg):
        return 4

    var importcF64Result = buildCallBody(ir.LocalI32Tag,
                                         ir.LocalF64Tag,
                                         true)
    if !x64.X64BodyCallStoresScalarResult(importcF64Result,
                                           importcF64Result.callSequence[0]) ||
       !x64.X64BodyCallAbiSupported(importcF64Result,
                                    importcF64Result.callSequence[0]) ||
       !fillSucceeds(importcF64Result) ||
       !internalF64ResultStoreIsExact(importcF64Result):
        return 5

    var importcI32 = buildCallBody(ir.LocalI32Tag,
                                   ir.LocalI32Tag,
                                   true)
    if !x64.X64BodyCallAbiSupported(importcI32,
                                     importcI32.callSequence[0]) ||
       !fillSucceeds(importcI32):
        return 6
    if !frameBoundaryCases():
        return 7
    if !copyMemoryBoundaryCases():
        return 8
    if !copySlotBoundaryCases():
        return 9
    if !sretBoundaryCases():
        return 10
    if !aggregateParam4Case():
        return 11
    if !aggregate65Case():
        return 13
    if !exportEntryBoundaryCases():
        return 14
    if !cmpAdmissionBoundaryCases():
        return 15
    return 0
