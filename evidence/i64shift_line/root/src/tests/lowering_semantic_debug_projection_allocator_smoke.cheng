import std/os
import std/strformat
import cheng/core/backend/lowering_plan as lower

fn main(): int32 =
    var plan: lower.LoweringPlanStub
    lower.LoweringPlanReleaseSemanticDebugPayload(plan)
    lower.LoweringSemanticDebugProjectionAllocatorBegin(plan)
    for row in 0..<40:
        lower.LoweringSemanticDebugProjectionAppendFunctionId(
            plan,
            row)
        lower.LoweringSemanticDebugProjectionAppendNodeRow(
            plan,
            row + 40,
            row + 80)
    let retainedBufferCount =
        lower.LoweringSemanticDebugProjectionAllocatorPhysicalBufferCount(
            plan)
    let retainedBytes =
        lower.LoweringSemanticDebugProjectionAllocatorCapacityBytes(plan)
    lower.LoweringPlanReleaseSemanticDebugPayload(plan)
    let receipt = plan.semanticDebugProjectionAllocatorReceipt
    if retainedBufferCount != 3 ||
       retainedBytes <= int64(0) ||
       !plan.semanticDebugProjectionAllocatorReceiptReady ||
       receipt.allocationEventCount <=
           int64(retainedBufferCount) ||
       receipt.releaseEventCount != receipt.allocationEventCount ||
       receipt.allocatedCapacityBytes <= retainedBytes ||
       receipt.releasedCapacityBytes !=
           receipt.allocatedCapacityBytes ||
       receipt.terminalRetainedBufferCount != retainedBufferCount ||
       receipt.terminalRetainedBytes != retainedBytes ||
       receipt.terminalReleasedBufferCount != retainedBufferCount ||
       receipt.terminalReleasedBytes != retainedBytes ||
       receipt.liveAllocationCount != int64(0) ||
       receipt.liveCapacityBytes != int64(0) ||
       !lower.LoweringSequenceAllocatorReceiptClosed(receipt) ||
       lower.LoweringSemanticDebugProjectionAllocatorPhysicalBufferCount(
           plan) != 0 ||
       lower.LoweringSemanticDebugProjectionAllocatorCapacityBytes(plan) !=
           int64(0):
        return 91
    lower.LoweringPlanReleaseSemanticDebugPayload(plan)
    os.WriteLine(
        os.GetStdout(),
        Fmt"semantic_debug_projection_allocator_allocation_events={receipt.allocationEventCount} semantic_debug_projection_allocator_release_events={receipt.releaseEventCount} semantic_debug_projection_allocator_allocated_bytes={receipt.allocatedCapacityBytes} semantic_debug_projection_allocator_released_bytes={receipt.releasedCapacityBytes} semantic_debug_projection_allocator_terminal_buffers={receipt.terminalRetainedBufferCount} semantic_debug_projection_allocator_terminal_bytes={receipt.terminalRetainedBytes} semantic_debug_projection_allocator_live={receipt.liveAllocationCount} semantic_debug_projection_allocator_live_bytes={receipt.liveCapacityBytes}")
    return 0
