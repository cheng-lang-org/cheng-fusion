import std/strutils as strutil
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/primary_object_csgc_cargo as cargo

fn main(): int32 =
    var call: orel.ObjectReloc
    call.sectionIndex = 0
    call.offset = int64(8)
    call.symbolIndex = 1
    call.kind = orel.ObjectRelocRiscvCall
    call.addend = int64(5)
    call.pcRelative = true

    var line: str
    assert(cargo.PrimaryObjectCsgcRelocationFactCanonicalInto(
               call, 0, line),
           " RISC-V relocation cargo: canonical encode")
    let expected =
        "{\"addend\":5,\"id\":\"native-object-relocation-0\",\"kind\":\"csg_dialect::native::object_relocation\",\"offset\":8,\"ordinal\":0,\"pcRelative\":true,\"relocationKind\":7,\"sectionIndex\":0,\"symbolIndex\":1}"
    assert(line == expected,
           " RISC-V relocation cargo: byte-exact code7 fact")

    var decoded: orel.ObjectReloc
    assert(cargo.PrimaryObjectCsgcRelocationFactParseCanonicalInto(
               line, 0, decoded),
           " RISC-V relocation cargo: canonical decode")
    assert(decoded.sectionIndex == call.sectionIndex &&
           decoded.offset == call.offset &&
           decoded.symbolIndex == call.symbolIndex &&
           decoded.kind == orel.ObjectRelocRiscvCall &&
           decoded.addend == call.addend &&
           decoded.pcRelative == call.pcRelative,
           " RISC-V relocation cargo: exact roundtrip")

    let unknownCode =
        strutil.Replace(
            line,
            "\"relocationKind\":7",
            "\"relocationKind\":8")
    assert(unknownCode != line,
           " RISC-V relocation cargo: mutation setup")
    var rejected: orel.ObjectReloc
    assert(!cargo.PrimaryObjectCsgcRelocationFactParseCanonicalInto(
               unknownCode, 0, rejected),
           " RISC-V relocation cargo: unknown code mutation accepted")

    let noncanonicalCode =
        strutil.Replace(
            line,
            "\"relocationKind\":7",
            "\"relocationKind\":07")
    assert(noncanonicalCode != line,
           " RISC-V relocation cargo: noncanonical mutation setup")
    assert(!cargo.PrimaryObjectCsgcRelocationFactParseCanonicalInto(
               noncanonicalCode, 0, rejected),
           " RISC-V relocation cargo: noncanonical code mutation accepted")

    echo("riscv_object_relocation_cargo_roundtrip_contract=pass bytes=187 code=7 rejected=2")
    return 0
