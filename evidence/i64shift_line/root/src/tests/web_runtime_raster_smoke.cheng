    if raster.RasterPixelAt(surface, 18, 20) != 77:
        return 53

    if !raster.RasterResize(surface, 40, 40, 9):
        return 54
    ops = []
    add(ops, paint.PaintOpMakeIcon(4, 4, 32, 32, paint.PaintIconKindCheck, 32, 77))
