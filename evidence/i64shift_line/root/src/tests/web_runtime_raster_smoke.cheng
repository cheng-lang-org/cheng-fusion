fn appendGlyphPoint(outline: var font.WebFontGlyphOutline,
                    x: int32, y: int32,
                    onCurve: bool,
                    endContour: bool) =
    var point: font.WebFontGlyphPoint
    point.x = x
    point.y = y
    point.onCurve = onCurve
    point.endContour = endContour
    add(outline.points, point)

fn makeRectGlyphOutline(outline: var font.WebFontGlyphOutline) =
    font.WebFontGlyphOutlineInit(outline)
    outline.glyphIndex = 5
    outline.simple = true
    outline.contourCount = 1
    outline.pointCount = 4
    outline.xMin = 0
    outline.yMin = 0
    outline.xMax = 1000
    outline.yMax = 1000
    appendGlyphPoint(outline, 0, 0, true, false)
    appendGlyphPoint(outline, 1000, 0, true, false)
    appendGlyphPoint(outline, 1000, 1000, true, false)
    appendGlyphPoint(outline, 0, 1000, true, true)

fn makeInsetRectGlyphOutline(outline: var font.WebFontGlyphOutline) =
    font.WebFontGlyphOutlineInit(outline)
    outline.glyphIndex = 6
    outline.simple = true
    outline.contourCount = 1
    outline.pointCount = 4
    outline.xMin = 125
    outline.yMin = 125
    outline.xMax = 875
    outline.yMax = 875
    appendGlyphPoint(outline, 125, 125, true, false)
    appendGlyphPoint(outline, 875, 125, true, false)
    appendGlyphPoint(outline, 875, 875, true, false)
    appendGlyphPoint(outline, 125, 875, true, true)

fn runRasterGlyphOutlineSmoke(): int32 =
    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 20, 20, 9):
        return 54

    var outline: font.WebFontGlyphOutline
    makeRectGlyphOutline(outline)
    if !raster.RasterFillGlyphOutline(surface, outline, 2, 18, 10, 1000, 77):
        return 55
    if raster.RasterPixelAt(surface, 7, 13) != 77:
        return 56
    if raster.RasterPixelAt(surface, 1, 13) != 9:
        return 57
    if raster.RasterPixelAt(surface, 7, 7) != 9:
        return 58
    if raster.RasterPixelAt(surface, 12, 13) != 9:
        return 59

    if !raster.RasterResize(surface, 20, 20, 9):
        return 60
    if !raster.RasterFillGlyphOutlineClipped(surface, outline, 2, 18, 10, 1000, 77, 2, 8, 5, 10):
        return 61
    if raster.RasterPixelAt(surface, 6, 13) != 77:
        return 62
    if raster.RasterPixelAt(surface, 7, 13) != 9:
        return 63

    outline.points[1].onCurve = false
    if !raster.RasterResize(surface, 20, 20, 9):
        return 64
    if !raster.RasterFillGlyphOutline(surface, outline, 2, 18, 10, 1000, 77):
        return 65
    if raster.RasterPixelAt(surface, 5, 13) != 77:
        return 79

    var insetOutline: font.WebFontGlyphOutline
    makeInsetRectGlyphOutline(insetOutline)
    if !raster.RasterResize(surface, 8, 8, -1):
        return 120
    if !raster.RasterFillGlyphOutline(surface, insetOutline, 1, 6, 4, 1000, int32(0xFF000000)):
        return 121
    let edgePixel = raster.RasterPixelAt(surface, 1, 3)
    if edgePixel == -1 || edgePixel == int32(0xFF000000):
        return 122
    if raster.RasterPixelAt(surface, 2, 3) != int32(0xFF000000):
        return 123
    return 0

fn runRasterFontTextSmoke(): int32 =
    let data = fontfixture.MakeWebFontSfntFixture()
    var face: font.WebFontFace
    if !font.WebFontLoadSfnt(data, face):
        return 66

    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 32, 24, 9):
        font.WebFontFree(face)
        return 67
    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeFillText(2, 2, "A a", 6, 12, 10, 77))
    if !raster.RasterPaintOpsWithFont(surface, ops, face):
        font.WebFontFree(face)
        return 68
    if raster.RasterPixelAt(surface, 5, 5) != 77:
        font.WebFontFree(face)
        return 69
    if raster.RasterPixelAt(surface, 9, 5) != 9:
        font.WebFontFree(face)
        return 70
    if raster.RasterPixelAt(surface, 13, 9) != 77:
        font.WebFontFree(face)
        return 71
    if raster.RasterPixelAt(surface, 11, 9) != 9:
        font.WebFontFree(face)
        return 72
    let missesAfterFirstText = raster.RasterGlyphAtlasMissCount(surface)
    if missesAfterFirstText <= 0:
        font.WebFontFree(face)
        return 124
    let hitsBeforeRepeatText = raster.RasterGlyphAtlasHitCount(surface)
    if !raster.RasterResize(surface, 32, 24, 9):
        font.WebFontFree(face)
        return 125
    ops = []
    add(ops, paint.PaintOpMakeFillText(2, 2, "A a", 6, 12, 10, 77))
    if !raster.RasterPaintOpsWithFont(surface, ops, face):
        font.WebFontFree(face)
        return 126
    if raster.RasterGlyphAtlasHitCount(surface) <= hitsBeforeRepeatText:
        font.WebFontFree(face)
        return 127
    if raster.RasterPixelAt(surface, 5, 5) != 77:
        font.WebFontFree(face)
        return 128

    if !raster.RasterResize(surface, 32, 24, 9):
        font.WebFontFree(face)
        return 73
    ops = []
    var clippedText = paint.PaintOpMakeFillText(2, 2, "A", 6, 12, 10, 77)
    clippedText.clipRect.x = 2
    clippedText.clipRect.y = 2
    clippedText.clipRect.width = 3
    clippedText.clipRect.height = 20
    add(ops, clippedText)
    if !raster.RasterPaintOpsWithFont(surface, ops, face):
        font.WebFontFree(face)
        return 74
    if raster.RasterPixelAt(surface, 4, 5) != 77:
        font.WebFontFree(face)
        return 75
    if raster.RasterPixelAt(surface, 5, 5) != 9:
        font.WebFontFree(face)
        return 76

    ops = []
    add(ops, paint.PaintOpMakeFillText(2, 2, "B", 6, 12, 10, 77))
    if raster.RasterPaintOpsWithFont(surface, ops, face):
        font.WebFontFree(face)
        return 77
    if raster.RasterLastError(surface) != "font glyph missing: 66":
        font.WebFontFree(face)
        return 78

    var fallbackData = fontfixture.MakeWebFontSfntFixture()
    fontfixture.PutU16BE(fallbackData, 172 + 16, 66)
    fontfixture.PutU16BE(fallbackData, 172 + 24, 66)
    fontfixture.PutI16BE(fallbackData, 172 + 34, -61)
    var fallbackFace: font.WebFontFace
    if !font.WebFontLoadSfnt(fallbackData, fallbackFace):
        font.WebFontFree(face)
        return 82
    var emptyFace2: font.WebFontFace
    var emptyFace3: font.WebFontFace
    if !raster.RasterResize(surface, 40, 24, 9):
        font.WebFontFree(fallbackFace)
        font.WebFontFree(face)
        return 83
    ops = []
    add(ops, paint.PaintOpMakeFillText(2, 2, "AB", 6, 12, 10, 77))
    if !raster.RasterPaintOpsWithFontCascade4(surface, ops, face, fallbackFace, emptyFace2, emptyFace3, 2):
        font.WebFontFree(fallbackFace)
        font.WebFontFree(face)
        return 84
    font.WebFontFree(fallbackFace)

    if !raster.RasterResize(surface, 40, 24, 9):
        font.WebFontFree(face)
        return 80
    ops = []
    add(ops, paint.PaintOpMakeFillText(2, 2, "A\nA", 6, 12, 10, 77))
    if !raster.RasterPaintOpsWithFont(surface, ops, face):
        font.WebFontFree(face)
        return 81
    if raster.RasterPixelAt(surface, 5, 5) != 77:
        font.WebFontFree(face)
        return 82
    if raster.RasterPixelAt(surface, 15, 5) != 77:
        font.WebFontFree(face)
        return 83

    if !raster.RasterResize(surface, 32, 24, 9):
        font.WebFontFree(face)
        return 84
    ops = []
    var centeredText = paint.PaintOpMakeFillText(0, 2, "A", 6, 12, 12, 77)
    centeredText.text.alignX = 2
    centeredText.text.alignWidth = 20
    centeredText.text.textAlign = layout.WebLayoutTextAlignCenter
    add(ops, centeredText)
    if !raster.RasterPaintOpsWithFont(surface, ops, face):
        font.WebFontFree(face)
        return 85
    if raster.RasterPixelAt(surface, 3, 5) != 9:
        font.WebFontFree(face)
        return 86
    if raster.RasterPixelAt(surface, 12, 5) != 77:
        font.WebFontFree(face)
        return 87

    font.WebFontFree(face)
    return 0

fn runRasterSmallWhiteTextOnColorSmoke(): int32 =
    var digitData = fontfixture.MakeWebFontSfntFixture()
    fontfixture.PutU16BE(digitData, 172 + 16, 49)
    fontfixture.PutU16BE(digitData, 172 + 26, 49)
    fontfixture.PutI16BE(digitData, 172 + 34, -44)
    var face: font.WebFontFace
    if !font.WebFontLoadSfnt(digitData, face):
        return 1

    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 24, 24, -65536):
        font.WebFontFree(face)
        return 2
    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeFillText(8, 5, "1", 6, 12, 10, -1))
    if !raster.RasterPaintOpsWithFont(surface, ops, face):
        font.WebFontFree(face)
        return 3
    var whitePixels: int32
    for y in 0..<24:
        for x in 0..<24:
            let px = raster.RasterPixelAt(surface, x, y)
            if px == -1:
                whitePixels = whitePixels + 1
    font.WebFontFree(face)
    if whitePixels <= 0:
        return 4
    return 0

fn runRasterBorderRectSmoke(): int32 =
    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 8, 8, 9):
        return 1
    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeFillRect(1, 1, 6, 6, 10))
    add(ops, paint.PaintOpMakeBorderRect(1, 1, 6, 6, 77, 1, 1, 1, 1, 3))
    if !raster.RasterPaintOps(surface, ops):
        return 2
    if raster.RasterPixelAt(surface, 4, 1) != 77:
        return 3
    if raster.RasterPixelAt(surface, 1, 4) != 77:
        return 4
    if raster.RasterPixelAt(surface, 4, 4) != 10:
        return 5
    if raster.RasterPixelAt(surface, 0, 0) != 9:
        return 6

    if !raster.RasterResize(surface, 8, 8, 9):
        return 7
    ops = []
    add(ops, paint.PaintOpMakeBorderRect(0, 0, 8, 8, 55, 1, 0, 0, 0, 0))
    if !raster.RasterPaintOps(surface, ops):
        return 8
    if raster.RasterPixelAt(surface, 4, 0) != 55:
        return 9
    if raster.RasterPixelAt(surface, 4, 1) != 9:
        return 10
    if raster.RasterPixelAt(surface, 0, 4) != 9:
        return 11
    return 0

fn main(): int32 =
    var code = runRasterDisplayListSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterDisplayListSmoke: {code}")
        return code
    code = runRasterPaintOpUnsupportedSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterPaintOpUnsupportedSmoke: {code}")
        return code
    code = runRasterAlphaCompositeSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterAlphaCompositeSmoke: {code}")
        return code
    code = runPaintOrderAncestorBeforeDescendantSmoke()
    if code != 0:
        echo(Fmt"FAIL runPaintOrderAncestorBeforeDescendantSmoke: {code}")
        return code
    code = runRasterDrawImageSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterDrawImageSmoke: {code}")
        return code
    code = runRasterPerOpClipSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterPerOpClipSmoke: {code}")
        return code
    code = runRasterIconGlobeSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterIconGlobeSmoke: {code}")
        return code
    code = runRasterGlyphOutlineSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterGlyphOutlineSmoke: {code}")
        return code
    code = runRasterFontTextSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterFontTextSmoke: {code}")
        return code
    code = runRasterSmallWhiteTextOnColorSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterSmallWhiteTextOnColorSmoke: {code}")
        return code
    code = runRasterBorderRectSmoke()
    if code != 0:
        echo(Fmt"FAIL runRasterBorderRectSmoke: {code}")
        return code
    echo("web_runtime_raster_smoke ok")
    return 0
