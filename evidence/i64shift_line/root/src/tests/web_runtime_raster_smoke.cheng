import cheng/core/runtime/web_layout_runtime as layout
import cheng/core/runtime/web_font_runtime as font
import cheng/core/runtime/web_paint_runtime as paint
import cheng/core/runtime/web_raster_runtime as raster
import cheng/tests/web_runtime_font_fixture as fontfixture

fn runRasterDisplayListSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var child = 0

    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 8, 8, 0, 0, root):
        return 1
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 4, 4, 2, 2, child):
        return 2
    if !layout.WebLayoutAppendChild(tree, root, child):
        return 3
    if !layout.WebLayoutCompute(tree, root):
        return 4

    var colors: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(colors)
    if !paint.WebPaintRegisterFillColor(colors, root, 111):
        return 5
    if !paint.WebPaintRegisterFillColor(colors, child, 222):
        return 6

    var list: paint.WebPaintDisplayList
    paint.WebPaintDisplayListInit(list)
    if !paint.WebPaintBuildDisplayList(tree, colors, 0, 0, 8, 8, list):
        return 7
    if paint.WebPaintDisplayItemCount(list) != 2:
        return 8

    var surface: raster.WebRasterSurface
    raster.WebRasterSurfaceInit(surface)
    if !raster.WebRasterClearSurface(surface, 8, 8, 9):
        return 40
    if !raster.WebRasterRasterizeDisplayList(list, 8, 8, 9, surface):
        return 9
    if surface.width != 8 || surface.height != 8 || surface.pixels.len != 64:
        return 10
    if raster.WebRasterPixelAt(surface, 7, 7) != 111:
        return 11
    if raster.WebRasterPixelAt(surface, 0, 0) != 111:
        return 12
    if raster.WebRasterPixelAt(surface, 2, 2) != 222:
        return 13
    if raster.WebRasterPixelAt(surface, 5, 5) != 222:
        return 14
    if raster.WebRasterPixelAt(surface, 6, 5) != 111:
        return 15

    var empty: paint.WebPaintDisplayList
    paint.WebPaintDisplayListInit(empty)
    if !raster.WebRasterRasterizeDisplayList(empty, 3, 2, 77, surface):
        return 16
    if surface.width != 3 || surface.height != 2 || surface.pixels.len != 6:
        return 17
    if raster.WebRasterPixelAt(surface, 0, 0) != 77:
        return 18
    if raster.WebRasterPixelAt(surface, 2, 1) != 77:
        return 19

    var manual: paint.WebPaintDisplayList
    paint.WebPaintDisplayListInit(manual)
    var clipped: paint.WebPaintRectItem
    clipped.nodeId = 10
    clipped.x = -1
    clipped.y = -1
    clipped.width = 3
    clipped.height = 3
    clipped.fillColor = 333
    add(manual.items, clipped)
    var cover: paint.WebPaintRectItem
    cover.nodeId = 11
    cover.x = 1
    cover.y = 1
    cover.width = 4
    cover.height = 2
    cover.fillColor = 444
    add(manual.items, cover)
    if !raster.WebRasterRasterizeDisplayList(manual, 3, 3, 55, surface):
        return 20
    if raster.WebRasterPixelAt(surface, 0, 0) != 333:
        return 21
    if raster.WebRasterPixelAt(surface, 2, 0) != 55:
        return 22
    if raster.WebRasterPixelAt(surface, 1, 1) != 444:
        return 23
    if raster.WebRasterPixelAt(surface, 2, 2) != 444:
        return 24

    var invalidRect: paint.WebPaintRectItem
    invalidRect.nodeId = 12
    invalidRect.x = 0
    invalidRect.y = 0
    invalidRect.width = -1
    invalidRect.height = 1
    invalidRect.fillColor = 1
    add(manual.items, invalidRect)
    if raster.WebRasterRasterizeDisplayList(manual, 3, 3, 55, surface):
        return 25
    if raster.WebRasterRasterizeDisplayList(empty, 0, 3, 55, surface):
        return 26
    if raster.WebRasterRasterizeDisplayList(empty, 3, -1, 55, surface):
        return 27
    return 0

fn runRasterPaintOpUnsupportedSmoke(): int32 =
    var opSurface: raster.RasterSurface
    raster.RasterSurfaceInit(opSurface)
    if !raster.RasterResize(opSurface, 4, 4, 0):
        return 28
    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeTextShadow("A", 0, 0, 1, 1, 1, 77))
    if raster.RasterPaintOps(opSurface, ops):
        return 29
    if raster.RasterLastError(opSurface) != "text shadow unsupported":
        return 30

    ops = []
    add(ops, paint.PaintOpMakeClipRect(0, 0, 2, 2))
    if !raster.RasterPaintOps(opSurface, ops):
        return 31
    return 0

fn runRasterAlphaCompositeSmoke(): int32 =
    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 2, 2, int32(0xFFFFFFFF)):
        return 110
    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeFillRect(0, 0, 2, 2, int32(0x80000000)))
    if !raster.RasterPaintOps(surface, ops):
        return 111
    if raster.RasterPixelAt(surface, 0, 0) != int32(0xFF7F7F7F):
        return 112

    var list: paint.WebPaintDisplayList
    paint.WebPaintDisplayListInit(list)
    var rect: paint.WebPaintRectItem
    rect.nodeId = 1
    rect.x = 0
    rect.y = 0
    rect.width = 2
    rect.height = 2
    rect.fillColor = int32(0x80000000)
    add(list.items, rect)
    var legacySurface: raster.WebRasterSurface
    raster.WebRasterSurfaceInit(legacySurface)
    if !raster.WebRasterRasterizeDisplayList(list, 2, 2, int32(0xFFFFFFFF), legacySurface):
        return 113
    if raster.WebRasterPixelAt(legacySurface, 1, 1) != int32(0xFF7F7F7F):
        return 114
    return 0

fn runPaintOrderAncestorBeforeDescendantSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var child = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 8, 8, 0, 0, root):
        return 96
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 4, 4, 2, 2, child):
        return 97
    if !layout.WebLayoutSetZIndex(tree, root, 50):
        return 98
    if !layout.WebLayoutAppendChild(tree, root, child):
        return 99
    if !layout.WebLayoutCompute(tree, root):
        return 100

    var colors: paint.WebPaintColorRegistry
    paint.WebPaintColorRegistryInit(colors)
    if !paint.WebPaintRegisterFillStyle(colors, root, 100, 0):
        return 101
    if !paint.WebPaintRegisterFillStyle(colors, child, 200, 0):
        return 102

    var ops: paint.PaintOp[]
    if !paint.WebPaintBuildOpsFromLayoutTreeWithRegistry(tree, colors, ops):
        return 103
    if ops.len != 2:
        return 104

    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 8, 8, 9):
        return 105
    if !raster.RasterPaintOps(surface, ops):
        return 106
    if raster.RasterPixelAt(surface, 0, 0) != 100:
        return 107
    if raster.RasterPixelAt(surface, 2, 2) != 200:
        return 108
    if raster.RasterPixelAt(surface, 6, 5) != 100:
        return 109
    return 0

fn runRasterDrawImageSmoke(): int32 =
    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 3, 3, 9):
        return 88
    # imageCache 像素语义(2026-08-24 演进): ARGB 打包, alpha=高 8 位;
    # alpha=0 的透明像素按浏览器语义跳过, 不覆盖目标(生产打包见
    # RasterImageCacheRegisterRgbaBase64 / ts-csg materializer)。
    let opaque11 = (255 << 24) | 11
    let opaque22 = (255 << 24) | 22
    let opaque33 = (255 << 24) | 33
    let opaque44 = (255 << 24) | 44
    var transparent: int32[]
    add(transparent, 11)
    add(transparent, 22)
    add(transparent, 33)
    add(transparent, 44)
    if !raster.RasterImageCacheRegister(surface.imageCache, 6, 2, 2, transparent):
        return 89
    var transparentOps: paint.PaintOp[]
    add(transparentOps, paint.PaintOpMakeDrawImage(0, 0, 2, 2, 6, 2, 2))
    if !raster.RasterPaintOps(surface, transparentOps):
        return 90
    if raster.RasterPixelAt(surface, 0, 0) != 9:
        return 96
    if raster.RasterPixelAt(surface, 1, 1) != 9:
        return 97
    var pixels: int32[]
    add(pixels, opaque11)
    add(pixels, opaque22)
    add(pixels, opaque33)
    add(pixels, opaque44)
    if !raster.RasterImageCacheRegister(surface.imageCache, 7, 2, 2, pixels):
        return 89
    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeDrawImage(0, 0, 2, 2, 7, 2, 2))
    if !raster.RasterPaintOps(surface, ops):
        return 90
    if raster.RasterPixelAt(surface, 0, 0) != opaque11:
        return 91
    if raster.RasterPixelAt(surface, 1, 0) != opaque22:
        return 92
    if raster.RasterPixelAt(surface, 0, 1) != opaque33:
        return 93
    if raster.RasterPixelAt(surface, 1, 1) != opaque44:
        return 94
    if raster.RasterPixelAt(surface, 2, 2) != 9:
        return 95
    return 0

fn runRasterPerOpClipSmoke(): int32 =
    var surface: raster.RasterSurface
    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 6, 6, 9):
        return 32

    var ops: paint.PaintOp[]
    var fillOp = paint.PaintOpMakeFillRect(0, 0, 6, 6, 22)
    fillOp.clipRect.x = 0
    fillOp.clipRect.y = 0
    fillOp.clipRect.width = 3
    fillOp.clipRect.height = 3
    add(ops, fillOp)
    if !raster.RasterPaintOps(surface, ops):
        return 33
    if raster.RasterPixelAt(surface, 2, 2) != 22:
        return 34
    if raster.RasterPixelAt(surface, 4, 4) != 9:
        return 35

    if !raster.RasterResize(surface, 12, 4, 9):
        return 36
    ops = []
    var textOp = paint.PaintOpMakeFillText(0, 0, "AA", 4, 4, 4, 77)
    textOp.clipRect.x = 0
    textOp.clipRect.y = 0
    textOp.clipRect.width = 4
    textOp.clipRect.height = 4
    add(ops, textOp)
    if !raster.RasterPaintOps(surface, ops):
        return 37
    if raster.RasterPixelAt(surface, 0, 2) != 77:
        return 38
    if raster.RasterPixelAt(surface, 4, 2) != 9:
        return 39

    if !raster.RasterResize(surface, 1024, 768, 9):
        return 41
    ops = []
    var clippedFill = paint.PaintOpMakeFillRect(352, 661, 320, 72, 22)
    clippedFill.borderRadius = 12
    clippedFill.clipRect.x = 352
    clippedFill.clipRect.y = 157
    clippedFill.clipRect.width = 320
    clippedFill.clipRect.height = 472
    add(ops, clippedFill)
    var laterFill = paint.PaintOpMakeFillRect(352, 645, 320, 32, 44)
    laterFill.borderRadius = 12
    add(ops, laterFill)
    if !raster.RasterPaintOps(surface, ops):
        return 42
    if raster.RasterPixelAt(surface, 500, 650) != 44:
        return 43
    if raster.RasterPixelAt(surface, 500, 670) != 44:
        return 44
    return 0

