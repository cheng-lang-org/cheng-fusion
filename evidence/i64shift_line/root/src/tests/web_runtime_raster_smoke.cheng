    raster.RasterSurfaceInit(surface)
    if !raster.RasterResize(surface, 40, 40, 9):
        return 45

    var ops: paint.PaintOp[]
    add(ops, paint.PaintOpMakeIcon(4, 4, 32, 32, paint.PaintIconKindGlobe, 32, 77))
    if !raster.RasterPaintOps(surface, ops):
        return 46
    if raster.RasterPixelAt(surface, 20, 20) != 77:
        return 47
    if raster.RasterPixelAt(surface, 20, 6) != 77:
        return 48
    if raster.RasterPixelAt(surface, 0, 0) != 9:
        return 49

    if !raster.RasterResize(surface, 40, 40, 9):
        return 50
    ops = []
