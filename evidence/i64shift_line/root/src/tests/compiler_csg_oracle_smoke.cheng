import std/os
import std/strings
import std/strutils as strutil
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath

fn main(): int32 =
    let root = os.GetCurrentDir()
    let sourcePath = chengpath.PathAbsolute(root, "src/tests/int32_add_direct_object_smoke.cheng")
    let sourceText = chengpath.ReadTextFile(root, sourcePath)
    assert(len(sourceText) > 0, " compiler csg oracle: source")
    var plan: slplan.SystemLinkPlanStub
    var planErr: str
    assert(slplan.BuildSystemLinkPlanStubWithFields(root,
                                                    root,
                                                    sourcePath,
                                                    chengpath.PathAbsolute(root, "artifacts/csg_oracle_smoke/oracle_out.o"),
                                                    "arm64-apple-darwin",
                                                    creq.EmitObj,
                                                    "public",
                                                    "",
                                                    plan,
                                                    planErr),
           strutil.Join([" compiler csg oracle: plan ", planErr], ""))
    let sourceBundle = slplan.SystemLinkPlanSourceBundleCid(plan)
    assert(IsOk(sourceBundle), " compiler csg oracle: source bundle")
    var csg: ccsg.CompilerCsg
    var csgErr: str
    assert(ccsg.BuildCompilerCsgSemanticConsumeEntryTextInto(plan,
                                                        sourcePath,
                                                        sourceText,
                                                        Value(sourceBundle),
                                                        csg,
                                                        csgErr),
           strutil.Join([" compiler csg oracle: build ", csgErr], ""))
    assert(csg.semanticGraph.builderName ==
               "BuildCompilerCsgSemanticConsumeEntryTextInto",
           " compiler csg oracle: internal graph builder")
    assert(csg.semanticGraph.sourceTable.sourcePaths.len == 1, " compiler csg oracle: source table")
    assert(csg.semanticGraph.declTable.names.len == 1, " compiler csg oracle: decl table")
    assert(csg.semanticGraph.importEdgeTable.ownerModulePaths.len == 0, " compiler csg oracle: import table")
    assert(csg.semanticGraph.reachableFunctionTable.functionNames.len >= 1, " compiler csg oracle: reachable table")
    assert(csg.semanticGraph.exprSliceTable.sourceIndex.len >= 1, " compiler csg oracle: expr slice table")
    assert(csg.semanticGraph.exprSliceTable.functionIndex.len == csg.semanticGraph.exprSliceTable.sourceIndex.len,
           " compiler csg oracle: function slice column")
    assert(csg.semanticGraph.exprSliceTable.functionIndex[0] >= 0,
           " compiler csg oracle: function slice bound")
    var seenSliceFunctions: bool[]
    for functionIndex in 0..<csg.semanticGraph.reachableFunctionTable.functionNames.len:
        add(seenSliceFunctions, false)
    for sliceIndex in 0..<csg.semanticGraph.exprSliceTable.functionIndex.len:
        let functionIndex = csg.semanticGraph.exprSliceTable.functionIndex[sliceIndex]
        if functionIndex >= 0:
            assert(functionIndex < seenSliceFunctions.len && !seenSliceFunctions[functionIndex],
                   " compiler csg oracle: duplicate function slice")
            seenSliceFunctions[functionIndex] = true
    assert(csg.semanticGraph.exprSliceFunctionBoundCount > 0,
           " compiler csg oracle: function slice count")
    assert(csg.semanticGraph.exprSliceMaxExprCount > 0,
           " compiler csg oracle: function slice max expr count")
    assert(csg.semanticGraph.exprSliceMaxTypedFactCount <= csg.typedExprFactCountSnapshot,
           " compiler csg oracle: bounded typed fact slice witness")
    assert(csg.semanticGraph.exprSliceTypedFactComplete, " compiler csg oracle: expr slice coverage")
    assert(csg.semanticGraph.exprSliceTypedFactGapCount == 0, " compiler csg oracle: expr slice gap")
    assert(csg.semanticGraph.exprSliceTypedFactOverlapCount == 0, " compiler csg oracle: expr slice overlap")
    assert(csg.semanticGraph.exprSummary.sourceCount == csg.semanticGraph.sourceTable.sourcePaths.len,
           " compiler csg oracle: expr summary source count")
    assert(csg.semanticGraph.exprSummary.exprCount > 0, " compiler csg oracle: expr summary count")
    assert(csg.exprLayer.exprs.len == 0, " compiler csg oracle: expr layer released")
    assert(csg.semanticGraph.typedFactTable.sourceIndexes.len == csg.typedExprFactCountSnapshot, " compiler csg oracle: typed facts")
    assert(csg.typedExprFacts.count == 0, " compiler csg oracle: legacy facts released")
    assert(csg.typedFactsReleasedBeforeTypedIr &&
           csg.typedIrRoundFactsReleaseCount == 1 &&
           csg.typedIrRoundFactsResetCount == csg.typedIrRoundCount,
           " compiler csg oracle: typed facts reset per frontier and released once")
    assert(csg.typedIrNewFunctionCount == csg.typedIr.functions2_functionNameIds.len,
           " compiler csg oracle: fixed point processed every typed ir function once")
    assert(csg.typedIrRoundExprMaxCount > 0,
           " compiler csg oracle: bounded frontier expr witness")
    assert(csg.semanticGraph.resolvedCallTable.internPool != nil, " compiler csg oracle: resolved-call intern pool")
    assert(csg.semanticGraph.resolvedCallTable.sourceIndexes.len == csg.semanticGraph.resolvedCallTable.sourcePathIds.len,
           " compiler csg oracle: resolved-call columns")
    assert(csg.semanticGraph.resolvedCallTable.sourceIndexes.len == csg.semanticGraph.resolvedCallTable.columnNumbers.len,
           " compiler csg oracle: resolved-call column positions")
    for resolvedIndex in 0..<csg.semanticGraph.resolvedCallTable.sourceIndexes.len:
        assert(csg.semanticGraph.resolvedCallTable.sourceIndexes[resolvedIndex] >= 0,
               " compiler csg oracle: resolved-call source index")
    assert(csg.semanticGraph.typedIrTable.functionNames.len == csg.typedIr.functions2_functionNameIds.len, " compiler csg oracle: typed ir")
    assert(csg.semanticGraph.worklist.roundCount >= 1, " compiler csg oracle: worklist rounds")
    assert(csg.semanticGraph.worklist.processedFunctionCount >= 1, " compiler csg oracle: processed functions")
    assert(csg.semanticGraph.phaseLedger.compilerCsgLogicalPayloadBytes >
               int64(0),
           " compiler csg oracle: phase ledger")
    assert(csg.semanticGraph.oracleCompared, " compiler csg oracle: compared")
    assert(csg.semanticGraph.oracleMatched, strutil.Join([" compiler csg oracle: mismatch ", csg.semanticGraph.oracleMismatchReason], ""))
    echo(strutil.Join(["compiler_csg_oracle_source_count=", strings.IntToStr(csg.semanticGraph.sourceTable.sourcePaths.len)], ""))
    echo(strutil.Join(["compiler_csg_oracle_decl_count=", strings.IntToStr(csg.semanticGraph.declTable.names.len)], ""))
    echo(strutil.Join(["compiler_csg_oracle_import_edge_count=", strings.IntToStr(csg.semanticGraph.importEdgeTable.ownerModulePaths.len)], ""))
    echo(strutil.Join(["compiler_csg_oracle_typed_ir_function_count=", strings.IntToStr(csg.semanticGraph.typedIrTable.functionNames.len)], ""))
    echo(strutil.Join(["compiler_csg_oracle_worklist_round_count=", strings.IntToStr(csg.semanticGraph.worklist.roundCount)], ""))
    echo(strutil.Join(["compiler_csg_oracle_old_csg_match=", strings.IntToStr(ccsg.CompilerCsgSemanticBoolToInt(csg.semanticGraph.oracleMatched))], ""))
    echo(" compiler_csg_oracle_smoke ok")
    return 0
