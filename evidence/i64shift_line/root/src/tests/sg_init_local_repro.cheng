import std/os
import cheng/libp2p/mobile_ffi/unimaker_android_social_group_backend as sg

fn main(): int32 =
    let cfg: str = "{\"dataDir\":\"/tmp/sg_repro_libp2p\",\"listenPort\":0,\"bootstrap\":[],\"deviceLabel\":\"repro\",\"announce\":false,\"padding\":\"xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"}"
    os.WriteLine(os.Get_stdout(), "calling init")
    let h = sg.libp2p_node_init(cfg)
    os.WriteLine(os.Get_stdout(), Fmt"init returned h={h}")
    return 0
