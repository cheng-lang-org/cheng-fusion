import cheng/core/ir/core_types as ir
import cheng/core/backend/x86_64_body_emit as x64
import std/strings

fn makeSlot(id: int32,
            typeKind: int32,
            sizeBytes: int32,
            alignBytes: int32,
            parameter: bool,
            paramOrdinal: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "runtime_x64_f64"
    slot.typeKind = typeKind
    slot.stackOffset = 32 + id * 16
    if parameter:
        slot.stackOffset = 0 - 1 - paramOrdinal
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = ir.BodyPlaceStackValueTag
    return slot

fn appendSlotReturn(body: var ir.BodyIR, slotIndex: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, ir.LocalI32Tag)
    return ir.BodyIRAppendTerm(body, term)

fn appendImmediateReturn(body: var ir.BodyIR, value: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    add(term.operands, 1)
    add(term.operands, value)
    return ir.BodyIRAppendTerm(body, term)

fn appendCompare(body: var ir.BodyIR, conditionKind: int32) =
    var compare: ir.BodyOp
    compare.kind = ir.BodyOpCmpTag
    compare.target = 2
    add(compare.operands, conditionKind)
    add(compare.operands, 0)
    add(compare.operands, 1)
    add(body.ops, compare)

fn buildCmpBody(conditionKind: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeSlot(0, ir.LocalF64Tag, 8, 8, true, 0))
    add(body.localSlots, makeSlot(1, ir.LocalF64Tag, 8, 8, true, 1))
    add(body.localSlots, makeSlot(2, ir.LocalI32Tag, 4, 4, false, -1))
    appendCompare(body, conditionKind)
    let termIndex = appendSlotReturn(body, 2)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildFusedCmpBody(conditionKind: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeSlot(0, ir.LocalF64Tag, 8, 8, true, 0))
    add(body.localSlots, makeSlot(1, ir.LocalF64Tag, 8, 8, true, 1))
    add(body.localSlots, makeSlot(2, ir.LocalI32Tag, 4, 4, false, -1))
    appendCompare(body, conditionKind)

    var branch: ir.BodyTerm
    branch.kind = ir.BodyTermCbrTag
    branch.conditionKind = ir.BodyCondLocalNonZeroTag
    branch.resultSlot = -1
    branch.lhsSlot = 2
    branch.rhsSlot = -1
    branch.trueBlock = 1
    branch.falseBlock = 2
    let branchIndex = ir.BodyIRAppendTerm(body, branch)
    let trueIndex = appendImmediateReturn(body, 1)
    let falseIndex = appendImmediateReturn(body, 0)
    let _entry = ir.BodyIRAppendBlock(body, 0, 1, branchIndex)
    let _true = ir.BodyIRAppendBlock(body, 1, 0, trueIndex)
    let _false = ir.BodyIRAppendBlock(body, 1, 0, falseIndex)
    return body

fn emitFunction(name: str,
                body: var ir.BodyIR,
                fusedExpected: bool): bool =
    if !x64.X64BodyPrepareStackLayout(body) ||
       !body.x64StackLayoutReady || !body.x64BlockStartReady:
        return false
    if x64.X64BodyCmpFusedAt(body, 0) != fusedExpected:
        return false
    let wordCount = x64.X64BodyIrWordCount(body)
    if wordCount <= 0:
        return false
    var words: int32[]
    setLen(words, wordCount)
    if x64.X64BodyFillWords(words, 0, wordCount, body) != wordCount:
        return false
    echo(".p2align 4, 0x90")
    echo(Fmt".globl _{name}")
    echo(Fmt"_{name}:")
    for wordIndex in 0..<words.len:
        echo(Fmt"    .long {strings.IntToStr(words[wordIndex])}")
    return true

fn main(): int32 =
    echo(".text")
    var conditions: int32[] = [
        ir.BodyCondF64EqTag, ir.BodyCondF64NeTag,
        ir.BodyCondF64LtTag, ir.BodyCondF64LeTag,
        ir.BodyCondF64GtTag, ir.BodyCondF64GeTag]
    var names: str[] = ["eq", "ne", "lt", "le", "gt", "ge"]
    for index in 0..<conditions.len:
        var materialized = buildCmpBody(conditions[index])
        if !emitFunction(Fmt"regalloc_x64_raw_f64_{names[index]}",
                         materialized, false):
            return 10 + index
        var fused = buildFusedCmpBody(conditions[index])
        if !emitFunction(Fmt"regalloc_x64_raw_f64_fused_{names[index]}",
                         fused, true):
            return 20 + index
    return 0
