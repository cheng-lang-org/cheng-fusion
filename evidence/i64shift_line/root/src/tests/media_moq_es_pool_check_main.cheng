# Runtime verification for the per-slot ES connection pool added to
# web_scene_media_network_bridge.cheng (多槽位 ES 会话并存 / 滚出即拆 / 预暖收养秒开).
#
# Real QUIC client against real media_moq_publisher_main processes serving the real
# hgs_stream ES fixture — no mocked network, no faked cache. Independent-python-oracle
# ground truth for hgs_stream (same parse method media_moq_es_prefetch_tick_check_main
# uses, cross-validated there): keyframes [0,120,240,360,480,600], count=675, GOP byte
# spans GOP0=1077887, GOP120=946127, GOP240=939519, GOP360=1042431, GOP480=1108639,
# GOP600=387279.
#
# Modes (--mode; pure is the default):
#   pure      Pool bookkeeping incl. release/teardown/reuse — no publisher needed:
#               1. SlotCount==3; three distinct peers acquire three distinct slots;
#               2. re-acquire of the same host:port returns the SAME slot (dedupe);
#               3. a fourth distinct peer is rejected with -1 (pool full, loud);
#               4. getters on reserved-not-open slots return the zero-value contract;
#               5. PrefetchTick on a reserved-not-open slot returns 0 (rc contract);
#               6. Release tears the slot down (IsUsed flips false), a double release
#                  returns false loudly, out-of-range indices return false loudly;
#               7. a released slot is handed out again by the next acquire (slot reuse);
#               8. OpenPeer on a full pool returns -1 with PoolLastError=="pool full".
#   coexist   Two publishers (ports --port/--port2, same hgs fixture): OpenPeer on both
#             peers yields two OPEN coexisting sessions (FrameCount==675 each) while the
#             primary session stays untouched (EsFrameCount()==0, RedialCount()==0);
#             PrefetchTick(slot) caches GOP0 (prewarm covers GOP0 — the playback
#             prefetch structurally never does) with byte length matching the oracle;
#             pause gates pool prefetch with rc=4; releasing one slot leaves the OTHER
#             slot fully operational (不互踢).
#   adopt     One publisher (--port): OpenPeer + PrefetchTick warms the slot and the S4
#             block cache; WebSceneMediaEsOpen on the same peer then ADOPTS the slot's
#             warm connection (the stub counts es_diag step-21 events — exactly one
#             adoption, zero cold redial: RedialCount()==0), frees the pool slot, and
#             the primary session serves frame 0 from the disk cache on the very first
#             StreamLoop tick (the 秒开 chain: tap -> warm conn -> GOP0 already on disk).
#             The shell harness additionally diffs the publisher's "served moq-frame"
#             log lines: exactly 1 (the pool prefetch's GOP0 fetch) — the primary
#             StreamLoop tick adds ZERO network frame requests.
#
# Any failure prints a reason and exits nonzero; success prints "<MODE>_OK" and exits 0.

import std/os
import std/rawbytes
import std/strutils as strutil
import std/strings as strs
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/core/runtime/web_scene_media_block_cache as blockcache

# An independently-owned cid copy for each by-value (consuming) cache-get call site —
# the two GOP probes below share one local; the helper borrows it and clones per call.
@borrows
fn cacheGetOwnedCid(cid: str, gopStartFrameIdx: int32): Result[Bytes] =
    return blockcache.WebSceneMediaBlockCacheGet(strs.CloneStr(cid), gopStartFrameIdx)

@importc("cheng_test_es_sink_first_frame_idx")
fn chengTestEsSinkFirstFrameIdx(): int32

@importc("cheng_test_es_sink_captured")
fn chengTestEsSinkCaptured(): int32

@importc("cheng_test_es_diag_step21_count")
fn chengTestEsDiagStep21Count(): int32

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

# Re-read the --host flag into an independent owned value for each OWNING (non-borrowed)
# str call site — OpenPeer/EsOpen consume their dialHost formal, so two sites must hand
# over two independent buffers (lessons 生产形: 无 @borrows 的 str 形参会吃掉实参).
fn openPeerFreshHost(port: int32): int32 =
    var raw: str
    let has: bool = cmdline.ReadFirstFlagValue("--host", raw)
    let h: str = if has: raw else: "127.0.0.1"
    return media_bridge.WebSceneMediaEsPoolSlotOpenPeer(h, port)

fn esOpenFreshHost(port: int32): bool =
    var raw: str
    let has: bool = cmdline.ReadFirstFlagValue("--host", raw)
    let h: str = if has: raw else: "127.0.0.1"
    return media_bridge.WebSceneMediaEsOpen(h, port)

fn runPure(): int32 =
    # S3 byte-evidence receipts start at zero in every fresh process.
    if media_bridge.WebSceneMediaEsPoolConnDialedReceipt() != 0 || media_bridge.WebSceneMediaEsPoolConnCloseReceipt() != 0 ||
       media_bridge.WebSceneMediaEsPoolReleaseReceipt() != 0 || media_bridge.WebSceneMediaEsPoolAdoptMoveReceipt() != 0:
        return fail("S3 receipts nonzero in a fresh process before any pool activity")
    if media_bridge.WebSceneMediaEsPoolSlotCount() != 3:
        return fail(strutil.Join(["PoolSlotCount=", IntToStr(media_bridge.WebSceneMediaEsPoolSlotCount()), " want=3"], ""))
    let sA: int32 = media_bridge.WebSceneMediaEsPoolAcquire("127.0.0.1", 39301)
    let sB: int32 = media_bridge.WebSceneMediaEsPoolAcquire("127.0.0.1", 39302)
    let sC: int32 = media_bridge.WebSceneMediaEsPoolAcquire("10.0.0.9", 39301)
    if sA < 0 || sB < 0 || sC < 0:
        return fail("acquire of first three distinct peers returned < 0")
    if sA == sB || sA == sC || sB == sC:
        return fail("distinct peers collided on the same slot")
    if media_bridge.WebSceneMediaEsPoolAcquire("127.0.0.1", 39301) != sA:
        return fail("re-acquire of same peer did not return the same slot")
    if media_bridge.WebSceneMediaEsPoolAcquire("127.0.0.1", 39304) != -1:
        return fail("fourth distinct peer was not rejected with -1 on a full pool")
    os.WriteLine(os.Get_stdout(), "step1_acquire_dedupe_full_ok")

    if !media_bridge.WebSceneMediaEsPoolSlotIsUsed(sA) || media_bridge.WebSceneMediaEsPoolSlotIsOpen(sA):
        return fail("reserved slot reports wrong used/open state")
    if media_bridge.WebSceneMediaEsPoolSlotFrameCount(sA) != 0 || media_bridge.WebSceneMediaEsPoolSlotAssetCid(sA).len != 0:
        return fail("never-opened slot violates the zero-value getter contract")
    if media_bridge.WebSceneMediaEsPoolSlotPrefetchTick(sA) != 0:
        return fail("PrefetchTick on a reserved-not-open slot did not return 0")
    if media_bridge.WebSceneMediaEsPoolSlotPrefetchTick(7) != 0:
        return fail("PrefetchTick on an out-of-range slot did not return 0")
    os.WriteLine(os.Get_stdout(), "step2_unopened_contracts_ok")

    # 滚出即拆 + loud double-release + loud invalid index.
    if !media_bridge.WebSceneMediaEsPoolSlotRelease(sA):
        return fail("Release of a reserved slot returned false")
    if media_bridge.WebSceneMediaEsPoolSlotIsUsed(sA):
        return fail("slot still used after Release (teardown did not happen)")
    if media_bridge.WebSceneMediaEsPoolSlotRelease(sA):
        return fail("double Release was not rejected loudly")
    if media_bridge.WebSceneMediaEsPoolSlotRelease(-1) || media_bridge.WebSceneMediaEsPoolSlotRelease(7):
        return fail("Release accepted an out-of-range slot index")
    # S3 receipt contract for NEVER-DIALED slots: the release physically freed index
    # blob + columns (its receipt advances), but NO connection ever existed to close —
    # ConnClose must NOT have moved (a "released without a connection" must never be
    # bookkeeped as a closed one), and no real dial/negotiate happened on this path.
    if media_bridge.WebSceneMediaEsPoolReleaseReceipt() != 1 || media_bridge.WebSceneMediaEsPoolConnCloseReceipt() != 0 ||
       media_bridge.WebSceneMediaEsPoolConnDialedReceipt() != 0:
        return fail(strutil.Join(["never-dialed release receipts wrong: rel=", IntToStr(media_bridge.WebSceneMediaEsPoolReleaseReceipt()),
                                  " close=", IntToStr(media_bridge.WebSceneMediaEsPoolConnCloseReceipt()),
                                  " dialed=", IntToStr(media_bridge.WebSceneMediaEsPoolConnDialedReceipt())], ""))
    os.WriteLine(os.Get_stdout(), "step3_release_teardown_loud_ok")

    # Slot reuse: the released slot is handed out again; the pool is full again after.
    let sA2: int32 = media_bridge.WebSceneMediaEsPoolAcquire("192.0.2.1", 39309)
    if sA2 != sA:
        return fail(strutil.Join(["released slot not reused: got slot ", IntToStr(sA2), " want ", IntToStr(sA)], ""))
    if media_bridge.WebSceneMediaEsPoolSlotOpenPeer("192.0.2.2", 39310) != -1:
        return fail("OpenPeer on a full pool did not return -1")
    if media_bridge.WebSceneMediaEsPoolLastError() != "pool full":
        return fail(strutil.Join(["PoolLastError=\"", media_bridge.WebSceneMediaEsPoolLastError(), "\" want \"pool full\""], ""))
    os.WriteLine(os.Get_stdout(), "step4_reuse_and_full_openpeer_ok")

    # Drain: every slot releases; the pool is empty again. Three more reserved-slot
    # releases => release receipt 1+3=4, still ZERO closes/dials (nothing was ever
    # dialed in pure mode by construction).
    if !media_bridge.WebSceneMediaEsPoolSlotRelease(sA2):
        return fail("drain: release of reused slot failed")
    if !media_bridge.WebSceneMediaEsPoolSlotRelease(sB) || !media_bridge.WebSceneMediaEsPoolSlotRelease(sC):
        return fail("drain: release of remaining slots failed")
    if media_bridge.WebSceneMediaEsPoolSlotIsUsed(sA2) || media_bridge.WebSceneMediaEsPoolSlotIsUsed(sB) ||
       media_bridge.WebSceneMediaEsPoolSlotIsUsed(sC):
        return fail("drain: some slot still used")
    if media_bridge.WebSceneMediaEsPoolAcquire("192.0.2.3", 39311) < 0:
        return fail("acquire after full drain returned < 0")
    if media_bridge.WebSceneMediaEsPoolReleaseReceipt() != 4 || media_bridge.WebSceneMediaEsPoolConnCloseReceipt() != 0 ||
       media_bridge.WebSceneMediaEsPoolConnDialedReceipt() != 0:
        return fail("pure-mode drain receipts wrong: reserved slots must release without ever closing a connection")
    os.WriteLine(os.Get_stdout(), "step5_drain_reacquire_ok")

    os.WriteLine(os.Get_stdout(), "POOL_PURE_OK")
    return 0

fn runCoexist(host: str, portA: int32, portB: int32, root: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    let s0: int32 = openPeerFreshHost(portA)
    if s0 < 0:
        return fail(strutil.Join(["OpenPeer(A) failed: ", media_bridge.WebSceneMediaEsPoolLastError()], ""))
    let s1: int32 = openPeerFreshHost(portB)
    if s1 < 0:
        return fail(strutil.Join(["OpenPeer(B) failed: ", media_bridge.WebSceneMediaEsPoolLastError()], ""))
    if s0 == s1:
        return fail("two distinct peers landed on the same pool slot")
    if !media_bridge.WebSceneMediaEsPoolSlotIsOpen(s0) || !media_bridge.WebSceneMediaEsPoolSlotIsOpen(s1):
        return fail("a pool slot reports not-open after a successful OpenPeer")
    if media_bridge.WebSceneMediaEsPoolSlotFrameCount(s0) != 675 || media_bridge.WebSceneMediaEsPoolSlotFrameCount(s1) != 675:
        return fail("pool slot frame count mismatch vs independent oracle (675)")
    # S3 receipt contract: TWO real OpenPeer sessions = two full dial+negotiate+ack
    # sequences over real sockets, zero closes so far.
    if media_bridge.WebSceneMediaEsPoolConnDialedReceipt() != 2 || media_bridge.WebSceneMediaEsPoolConnCloseReceipt() != 0:
        return fail(strutil.Join(["coexist dial/close receipts wrong: dialed=", IntToStr(media_bridge.WebSceneMediaEsPoolConnDialedReceipt()),
                                  " close=", IntToStr(media_bridge.WebSceneMediaEsPoolConnCloseReceipt())], ""))
    os.WriteLine(os.Get_stdout(), "step1_two_open_sessions_coexist_ok")

    # The primary playback session is structurally untouched by pool activity (不互踢).
    if media_bridge.WebSceneMediaEsFrameCount() != 0:
        return fail("primary ES session opened as a side effect of pool opens")
    if media_bridge.WebSceneMediaEsRedialCount() != 0:
        return fail("primary session redialed as a side effect of pool opens")
    os.WriteLine(os.Get_stdout(), "step2_primary_untouched_ok")

    # Same fixture on both publishers -> identical on-wire content identity.
    let cidA: str = media_bridge.WebSceneMediaEsPoolSlotAssetCid(s0)
    let cidB: str = media_bridge.WebSceneMediaEsPoolSlotAssetCid(s1)
    if cidA.len == 0 || cidA != cidB:
        return fail("asset cid mismatch/empty across the two pool sessions")
    if !media_bridge.WebSceneMediaEsPoolSlotContentMatches(s0, cidA):
        return fail("ContentMatches false against the slot's own on-wire cid")
    if media_bridge.WebSceneMediaEsPoolSlotContentMatches(s0, ""):
        return fail("ContentMatches true for an empty expectation (must never rubber-stamp)")
    if media_bridge.WebSceneMediaEsPoolSlotContentMatches(s0, "deadbeef"):
        return fail("ContentMatches true for a wrong cid")
    if media_bridge.WebSceneMediaEsPoolSlotFindPeer(host, portA) != s0 ||
       media_bridge.WebSceneMediaEsPoolSlotFindPeer(host, portB) != s1:
        return fail("FindPeer did not locate both open pool sessions")
    os.WriteLine(os.Get_stdout(), "step3_content_identity_ok")

    # Prewarm GOP0 — the playback-side PrefetchTick structurally never targets the GOP
    # under the cursor; the pool prefetch exists precisely to put GOP0 on disk pre-tap.
    if media_bridge.WebSceneMediaEsPoolSlotPrefetchTick(s0) != 1:
        return fail(strutil.Join(["pool PrefetchTick(GOP0) failed: ", media_bridge.WebSceneMediaEsPoolSlotLastError(s0)], ""))
    let gop0Res = cacheGetOwnedCid(cidA, 0)
    if IsErr(gop0Res):
        return fail("block cache miss for GOP0 after pool prefetch")
    # Value[] is the move-out contract: extract ONCE, then size from the owned buffer.
    let gop0Data = Value(gop0Res)
    if rawbytes.BytesLen(gop0Data) != 1077887:
        return fail(strutil.Join(["GOP0 byte length ", IntToStr(rawbytes.BytesLen(gop0Data)), " != oracle 1077887"], ""))
    os.WriteLine(os.Get_stdout(), "step4_gop0_prewarmed_ok")

    # Pause backpressure gates pool prefetch with rc=4 (same flag as the primary pump).
    media_bridge.WebSceneMediaEsSetPaused(true)
    let pausedRc0: int32 = media_bridge.WebSceneMediaEsPoolSlotPrefetchTick(s0)
    let pausedRc1: int32 = media_bridge.WebSceneMediaEsPoolSlotPrefetchTick(s1)
    media_bridge.WebSceneMediaEsSetPaused(false)
    if pausedRc0 != 4 || pausedRc1 != 4:
        return fail("pool PrefetchTick did not return 4 while paused")
    os.WriteLine(os.Get_stdout(), "step5_pause_gate_ok")

    # Bounded progress: the next tick skips the cached GOP0 and caches GOP120.
    if media_bridge.WebSceneMediaEsPoolSlotPrefetchTick(s0) != 1:
        return fail(strutil.Join(["pool PrefetchTick(GOP120) failed: ", media_bridge.WebSceneMediaEsPoolSlotLastError(s0)], ""))
    let gop120Res = cacheGetOwnedCid(cidA, 120)
    if IsErr(gop120Res):
        return fail("block cache miss for GOP120 after second pool prefetch")
    let gop120Data = Value(gop120Res)
    if rawbytes.BytesLen(gop120Data) != 946127:
        return fail(strutil.Join(["GOP120 byte length ", IntToStr(rawbytes.BytesLen(gop120Data)), " != oracle 946127"], ""))
    os.WriteLine(os.Get_stdout(), "step6_bounded_progress_ok")

    # 不互踢: releasing slot s0 leaves slot s1 fully operational.
    if !media_bridge.WebSceneMediaEsPoolSlotRelease(s0):
        return fail("Release(s0) returned false")
    if !media_bridge.WebSceneMediaEsPoolSlotIsOpen(s1):
        return fail("releasing one slot tore down the other slot's session")
    if media_bridge.WebSceneMediaEsPoolSlotFrameCount(s1) != 675:
        return fail("remaining slot lost its session state after the other slot's release")
    if media_bridge.WebSceneMediaEsPoolSlotPrefetchTick(s0) != 0:
        return fail("PrefetchTick on a released slot did not return 0")
    if !media_bridge.WebSceneMediaEsPoolSlotRelease(s1):
        return fail("Release(s1) returned false")
    # S3 release chain: both DIALED sessions torn down => two real ConnClose receipts
    # on top of the two releases; the second slot's session state above stayed live
    # until ITS OWN close (eviction isolation, receipts included).
    if media_bridge.WebSceneMediaEsPoolConnCloseReceipt() != 2 || media_bridge.WebSceneMediaEsPoolReleaseReceipt() != 2:
        return fail(strutil.Join(["coexist teardown receipts wrong: close=", IntToStr(media_bridge.WebSceneMediaEsPoolConnCloseReceipt()),
                                  " rel=", IntToStr(media_bridge.WebSceneMediaEsPoolReleaseReceipt())], ""))
    os.WriteLine(os.Get_stdout(), "step7_eviction_isolation_ok")

    os.WriteLine(os.Get_stdout(), "POOL_COEXIST_OK")
    return 0

fn runAdopt(host: str, port: int32, root: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    let s0: int32 = openPeerFreshHost(port)
    if s0 < 0:
        return fail(strutil.Join(["OpenPeer failed: ", media_bridge.WebSceneMediaEsPoolLastError()], ""))
    let cid: str = media_bridge.WebSceneMediaEsPoolSlotAssetCid(s0)
    if cid.len == 0:
        return fail("asset cid empty after pool open")
    # Prewarm GOP0 into the S4 cache BEFORE the tap.
    if media_bridge.WebSceneMediaEsPoolSlotPrefetchTick(s0) != 1:
        return fail(strutil.Join(["pool PrefetchTick(GOP0) failed: ", media_bridge.WebSceneMediaEsPoolSlotLastError(s0)], ""))
    os.WriteLine(os.Get_stdout(), "step1_prewarm_ok")

    # The tap: primary es_open must ADOPT the slot's warm connection (es_diag step 21),
    # free the pool slot, and redial nothing (RedialCount stays 0 on a never-dialed
    # primary session; adoption is the ONLY way both can hold).
    if !esOpenFreshHost(port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    if chengTestEsDiagStep21Count() != 1:
        return fail(strutil.Join(["adoption diag(21) count=", IntToStr(chengTestEsDiagStep21Count()), " want=1"], ""))
    if media_bridge.WebSceneMediaEsRedialCount() != 0:
        return fail("adoption caused a redial (the whole point of prewarm is zero redial)")
    if media_bridge.WebSceneMediaEsPoolSlotIsUsed(s0) || media_bridge.WebSceneMediaEsPoolSlotIsOpen(s0):
        return fail("pool slot not freed after adoption")
    if media_bridge.WebSceneMediaEsPoolSlotFindPeer(host, port) != -1:
        return fail("FindPeer still locates the adopted slot")
    # S3 ownership handoff receipts: adoption is a physical MOVE of the slot's warm
    # connection into the primary session — exactly one dial receipt (the pool prewarm)
    # and exactly one adopt-move receipt. The connection was NOT closed (it now lives
    # as the primary session — closing it would kill playback) and NO SlotRelease ran.
    if media_bridge.WebSceneMediaEsPoolConnDialedReceipt() != 1 || media_bridge.WebSceneMediaEsPoolAdoptMoveReceipt() != 1 ||
       media_bridge.WebSceneMediaEsPoolConnCloseReceipt() != 0 || media_bridge.WebSceneMediaEsPoolReleaseReceipt() != 0:
        return fail(strutil.Join(["adoption receipts wrong: dialed=", IntToStr(media_bridge.WebSceneMediaEsPoolConnDialedReceipt()),
                                  " adopt=", IntToStr(media_bridge.WebSceneMediaEsPoolAdoptMoveReceipt()),
                                  " close=", IntToStr(media_bridge.WebSceneMediaEsPoolConnCloseReceipt()),
                                  " rel=", IntToStr(media_bridge.WebSceneMediaEsPoolReleaseReceipt())], ""))
    if media_bridge.WebSceneMediaEsFrameCount() != 675:
        return fail("primary frame count mismatch after adoption")
    if media_bridge.WebSceneMediaEsAssetCid() != cid:
        return fail("primary asset cid differs from the prewarmed slot's on-wire cid")
    os.WriteLine(os.Get_stdout(), "step2_adoption_ok")

    # Seek semantics are unchanged on the adopted session.
    if !media_bridge.WebSceneMediaEsSeekToFrame(120):
        return fail("SeekToFrame(120) returned false on the adopted session")
    if media_bridge.WebSceneMediaEsPumpCursor() != 120:
        return fail("pump cursor mismatch after seek on the adopted session")
    os.WriteLine(os.Get_stdout(), "step3_seek_semantics_ok")

    # 秒开 chain: seek back to 0 and run ONE StreamLoop tick — GOP0 must be served from
    # the S4 disk cache the pool prefetch filled (the harness asserts ZERO new
    # "served moq-frame" lines on the publisher log for this tick).
    if !media_bridge.WebSceneMediaEsSeekToFrame(0):
        return fail("SeekToFrame(0) returned false")
    let rc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if rc != 0:
        return fail(strutil.Join(["StreamLoop unexpected rc=", IntToStr(rc)], ""))
    if chengTestEsSinkCaptured() != 1:
        return fail(strutil.Join(["sink captured count=", IntToStr(chengTestEsSinkCaptured()), " want=1"], ""))
    if chengTestEsSinkFirstFrameIdx() != 0:
        return fail(strutil.Join(["sink delivered frameIdx=", IntToStr(chengTestEsSinkFirstFrameIdx()), " want=0"], ""))
    os.WriteLine(os.Get_stdout(), "step4_gop0_served_from_disk_cache_ok")

    os.WriteLine(os.Get_stdout(), "POOL_ADOPT_OK")
    return 0

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let portA: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    let portB: int32 = cmdline.ReadInt32FlagOrDefault("--port2", 38001)
    var rootRaw: str
    let hasRoot: bool = cmdline.ReadFirstFlagValue("--root", rootRaw)
    var modeRaw: str
    let hasMode: bool = cmdline.ReadFirstFlagValue("--mode", modeRaw)
    let mode: str = if hasMode: modeRaw else: "pure"

    if mode == "pure":
        return runPure()
    if !hasRoot:
        return fail("missing --root")
    if mode == "coexist":
        return runCoexist(host, portA, portB, rootRaw)
    if mode == "adopt":
        return runAdopt(host, portA, rootRaw)
    return fail(strutil.Join(["unknown --mode: ", mode], ""))
