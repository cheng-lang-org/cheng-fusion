import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_cfg as cfg
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/std/bytes_layout as layout

fn makeSlot(id: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "abi_width"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = -1
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn buildCall(widths: int32[]): ir.BodyIR =
    var body = ir.BodyIRNew()
    let typeArenaCid = layout.FixedBytes32FromHex(
        "7777777777777777777777777777777777777777777777777777777777777777")
    assert(typeArenaCid.ok, "call ABI width TypeArena CID invalid")
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid.value),
           "call ABI width TypeArena CID bind failed")
    for slotIndex in 0..<widths.len:
        add(body.localSlots, makeSlot(slotIndex))
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "abi_width_target"
    for argIndex in 0..<widths.len:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, widths[argIndex])
    add(body.callSequence, call)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    add(op.operands, 0)
    add(body.ops, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn checkExactWidths(): int32 =
    let expected = [1, 2, 4, 8]
    var body = buildCall(expected)
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    if !table.valid:
        return 100 + table.errorDetail
    if !analysis.valid:
        return 12
    if !plan.valid:
        return 13
    var seen: bool[4]
    for factIndex in 0..<table.facts.len:
        let fact = table.facts[factIndex]
        if fact.fixedKind != access.BodyIrAccessFixedCallArg ||
           fact.callOrdinal != 0 ||
           fact.fixedOrdinal < 0 ||
           fact.fixedOrdinal >= expected.len:
            continue
        if !fact.abiSizeExplicit ||
           fact.abiSizeBytes != expected[fact.fixedOrdinal]:
            return 14
        seen[fact.fixedOrdinal] = true
    for widthIndex in 0..<expected.len:
        if !seen[widthIndex]:
            return 15
    var actionSeen: bool[4]
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.fixedKind != access.BodyIrAccessFixedCallArg ||
           action.callOrdinal != 0 ||
           action.fixedOrdinal < 0 ||
           action.fixedOrdinal >= expected.len:
            continue
        if !action.abiSizeExplicit ||
           action.abiSizeBytes != expected[action.fixedOrdinal]:
            return 16
        actionSeen[action.fixedOrdinal] = true
    for widthIndex in 0..<expected.len:
        if !actionSeen[widthIndex]:
            return 17
    return 0

fn invalidWidthRejected(width: int32): bool =
    var body = buildCall([width])
    let table = access.BodyIrAccessDecode(body)
    return !table.valid

fn cardinalityMismatchRejected(): bool =
    var body = buildCall([1, 2, 4, 8])
    body.callSequence[0].argAbiSizes = [1, 2, 4]
    let table = access.BodyIrAccessDecode(body)
    return !table.valid

fn main(): int32 =
    let widthCode = checkExactWidths()
    if widthCode != 0:
        return widthCode
    if !invalidWidthRejected(0):
        return 21
    if !invalidWidthRejected(3):
        return 22
    if !invalidWidthRejected(16):
        return 23
    if !cardinalityMismatchRejected():
        return 24
    return 0
