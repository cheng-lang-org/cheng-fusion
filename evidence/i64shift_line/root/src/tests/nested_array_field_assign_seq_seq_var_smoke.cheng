# M4: two-level nested DYNAMIC SEQ (both levels), tail scalar, VARIABLE indices,
# outer index != 0 (guards against an accidental always-index-0 collapse).
type
    Col =
        a: int32
        b: int32

type
    Row =
        cols: Col[]

type
    Grid =
        rows: Row[]

fn main(): int32 =
    var g: Grid
    var r0: Row
    var c00: Col
    c00.a = 1
    add(r0.cols, c00)
    var c01: Col
    c01.a = 2
    add(r0.cols, c01)
    add(g.rows, r0)
    var r1: Row
    var c10: Col
    c10.a = 3
    add(r1.cols, c10)
    var c11: Col
    c11.a = 4
    add(r1.cols, c11)
    add(g.rows, r1)

    var i: int32 = 1
    var j: int32 = 1
    g.rows[i].cols[j].a = 999

    if g.rows[1].cols[1].a != 999:
        return 1
    if g.rows[1].cols[0].a != 3:
        return 2
    if g.rows[0].cols[0].a != 1:
        return 3
    if g.rows[0].cols[1].a != 2:
        return 4
    return 0
