import std/os as os
import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_artifacts
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_store_codec
import cheng/core/csg_core/validator

type
    smokeVarintRead =
        ok: bool
        value: int32
        nextOffset: int32

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn findText(text: str, needle: str): int32 =
    if needle.len == 0 || needle.len > text.len:
        return -1
    for start in 0..<(text.len - needle.len + 1):
        var equal = true
        for i in 0..<needle.len:
            if text[start + i] != needle[i]:
                equal = false
                break
        if equal:
            return start
    return -1

@borrows
fn removeFirst(text: str, needle: str): str =
    let start = findText(text, needle)
    if start < 0:
        return ""
    return cat(
        strings.CloneStrRange(text, 0, start),
        strings.CloneStrRange(
            text,
            start + needle.len,
            text.len - start - needle.len))

@borrows
fn addExtraField(line: str): str =
    let marker = ",\"unsupported_count\":"
    let at = findText(line, marker)
    if at < 0:
        return ""
    return cat(
        strings.CloneStrRange(line, 0, at),
        cat(
            ",\"unexpected\":\"x\"",
            strings.CloneStrRange(
                line, at, line.len - at)))

@borrows
fn ownedBytesFromText(text: str): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(text.len)
    for i in 0..<text.len:
        rawbytes.BytesSet(out, i, int32(text[i]) & 255)
    return out

@borrows
fn readU32(bytes: rawbytes.Bytes, offset: int32): int32 =
    if offset < 0 ||
       offset + 3 >= rawbytes.BytesLen(bytes):
        return -1
    let value =
        (rawbytes.BytesGet(bytes, offset) & 255) |
        ((rawbytes.BytesGet(bytes, offset + 1) & 255) <<
         8) |
        ((rawbytes.BytesGet(bytes, offset + 2) & 255) <<
         16) |
        ((rawbytes.BytesGet(bytes, offset + 3) & 255) <<
         24)
    return value

@borrows
fn readVarint(
        bytes: rawbytes.Bytes,
        offsetRaw: int32): smokeVarintRead =
    var out: smokeVarintRead
    var offset = offsetRaw
    var value: int32
    var shift: int32
    for i in 0..<5:
        if offset < 0 ||
           offset >= rawbytes.BytesLen(bytes):
            return out
        let byteValue =
            rawbytes.BytesGet(bytes, offset) & 255
        offset = offset + 1
        if i == 4 && (byteValue & 240) != 0:
            return out
        value =
            value |
            ((byteValue & 127) << shift)
        if (byteValue & 128) == 0:
            out.ok = true
            out.value = value
            out.nextOffset = offset
            return out
        shift = shift + 7
    return out

@borrows
fn skipUtf8(
        bytes: rawbytes.Bytes,
        offset: int32): int32 =
    let length = readVarint(bytes, offset)
    if !length.ok ||
       length.value < 0 ||
       length.nextOffset >
           rawbytes.BytesLen(bytes) - length.value:
        return -1
    return length.nextOffset + length.value

@borrows
fn skipTokenLine(
        bytes: rawbytes.Bytes,
        offsetRaw: int32): int32 =
    let tokenCount = readVarint(bytes, offsetRaw)
    if !tokenCount.ok || tokenCount.value < 0:
        return -1
    var offset = tokenCount.nextOffset
    for i in 0..<tokenCount.value:
        if offset < 0 ||
           offset >= rawbytes.BytesLen(bytes):
            return -1
        let tag = rawbytes.BytesGet(bytes, offset) & 255
        offset = offset + 1
        if tag == 1:
            let dictionaryIndex =
                readVarint(bytes, offset)
            if !dictionaryIndex.ok:
                return -1
            offset = dictionaryIndex.nextOffset
        elif tag == 2:
            offset = skipUtf8(bytes, offset)
            if offset < 0:
                return -1
        else:
            return -1
    return offset

fn csgcSmokeAppendU32(
        buf: var layout.ByteBuf,
        value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(
        buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(
        buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(
        buf, (value >> 24) & 255)

@borrows
fn csgcSmokeAppendText(
        buf: var layout.ByteBuf,
        text: str) =
    csgcSmokeAppendU32(buf, text.len)
    for i in 0..<text.len:
        layout.ByteBufAppendByte(buf, text[i])

@borrows
fn swapFirstTwoCsgcLines(
        bytes: rawbytes.Bytes): rawbytes.Bytes =
    let total = rawbytes.BytesLen(bytes)
    if total < 72:
        return rawbytes.Bytes()
    let directoryLength = readU32(bytes, 64)
    let entryCount = readU32(bytes, 68)
    if directoryLength < 8 || entryCount < 2:
        return rawbytes.Bytes()
    let directoryEnd = 64 + directoryLength
    if directoryEnd > total:
        return rawbytes.Bytes()
    var cursor: int32 = 72
    var sectionTag: int32 = -1
    var sectionKindOffset: int32
    var sectionKindLength: int32
    var sectionPayloadOffset: int32
    var sectionPayloadLength: int32
    var sectionItemCount: int32
    var sectionDigestOffset: int32
    for entry in 0..<entryCount:
        if cursor >= directoryEnd:
            return rawbytes.Bytes()
        let tag = rawbytes.BytesGet(bytes, cursor) & 255
        cursor = cursor + 1
        let kindLength = readVarint(bytes, cursor)
        if !kindLength.ok || kindLength.value < 0:
            return rawbytes.Bytes()
        let kindOffset = kindLength.nextOffset
        cursor = kindOffset + kindLength.value
        if cursor > directoryEnd:
            return rawbytes.Bytes()
        let payloadOffset = readU32(bytes, cursor)
        let payloadLength = readU32(bytes, cursor + 4)
        let itemCount = readU32(bytes, cursor + 8)
        if payloadOffset < 0 ||
           payloadLength < 0 || itemCount < 0:
            return rawbytes.Bytes()
        cursor = cursor + 12
        let digestOffset = cursor
        cursor = cursor + 32
        if cursor > directoryEnd:
            return rawbytes.Bytes()
        if sectionTag < 0 && tag == 2 && itemCount >= 2:
            sectionTag = tag
            sectionKindOffset = kindOffset
            sectionKindLength = kindLength.value
            sectionPayloadOffset = payloadOffset
            sectionPayloadLength = payloadLength
            sectionItemCount = itemCount
            sectionDigestOffset = digestOffset
    if sectionTag < 0 || cursor != directoryEnd:
        return rawbytes.Bytes()
    let payloadStart = 64 + sectionPayloadOffset
    if payloadStart > total - sectionPayloadLength:
        return rawbytes.Bytes()
    let rowCount = readU32(bytes, payloadStart)
    if rowCount != sectionItemCount:
        return rawbytes.Bytes()
    let firstStart = payloadStart + 4
    let firstEnd = skipTokenLine(bytes, firstStart)
    let secondStart = firstEnd
    let secondEnd = skipTokenLine(bytes, secondStart)
    if firstEnd <= firstStart ||
       secondEnd <= secondStart:
        return rawbytes.Bytes()
    var out = rawbytes.BytesAlloc(total)
    rawbytes.BytesCopyRangeInto(
        out, 0, bytes, 0, firstStart)
    let secondLength = secondEnd - secondStart
    rawbytes.BytesCopyRangeInto(
        out,
        firstStart,
        bytes,
        secondStart,
        secondLength)
    let firstLength = firstEnd - firstStart
    rawbytes.BytesCopyRangeInto(
        out,
        firstStart + secondLength,
        bytes,
        firstStart,
        firstLength)
    rawbytes.BytesCopyRangeInto(
        out,
        firstStart + secondLength + firstLength,
        bytes,
        secondEnd,
        total - secondEnd)
    var digestBuf = layout.ByteBufInit(
        96 + sectionPayloadLength)
    csgcSmokeAppendText(
        digestBuf, "csg_core.csgc.section")
    layout.ByteBufAppendByte(digestBuf, sectionTag)
    csgcSmokeAppendU32(digestBuf, sectionKindLength)
    for i in 0..<sectionKindLength:
        layout.ByteBufAppendByte(
            digestBuf,
            rawbytes.BytesGet(
                bytes, sectionKindOffset + i))
    csgcSmokeAppendU32(digestBuf, sectionItemCount)
    csgcSmokeAppendU32(digestBuf, sectionPayloadLength)
    for i in 0..<sectionPayloadLength:
        layout.ByteBufAppendByte(
            digestBuf,
            rawbytes.BytesGet(out, payloadStart + i))
    let digest =
        hash256.Sha256Fixed(layout.ByteBufView(digestBuf))
    layout.ByteBufFree(digestBuf)
    var digestBytes = layout.FixedBytes32ToBytes(digest)
    rawbytes.BytesCopyRangeInto(
        out, sectionDigestOffset, digestBytes, 0, 32)
    rawbytes.BytesFree(digestBytes)
    return out

@borrows
fn membershipForFact(
        header:
            merkle_artifacts.CsgCoreMerklePartitionFactsHeader,
        dag: merkle_dag.CsgCoreMerkleDag,
        fact: str,
        error: var str):
        merkle_artifacts.CsgCoreMerkleMembershipRecord =
    error = ""
    var keyError: str
    let key =
        merkle_dag.CsgCoreMerkleFactKey(
            fact, keyError)
    if keyError.len > 0:
        error = keyError
        return merkle_artifacts.CsgCoreMerkleMembershipRecord()
    var hashError: str
    let factHash =
        merkle_dag.CsgCoreMerkleFactHash(
            fact, hashError)
    if hashError.len > 0:
        error = hashError
        return merkle_artifacts.CsgCoreMerkleMembershipRecord()
    var entryIndex: int32 = -1
    for i in 0..<dag.entryKeys.len:
        if dag.entryKeys[i] == key:
            entryIndex = i
            break
    if entryIndex < 0:
        error = "membership fixture entry missing"
        return merkle_artifacts.CsgCoreMerkleMembershipRecord()
    var leafCid: str
    for nodeIndex in 0..<dag.nodeKinds.len:
        if dag.nodeKinds[nodeIndex] ==
               merkle_dag.CsgCoreMerkleLeafNodeKind() &&
           dag.nodeEntries[nodeIndex] == entryIndex:
            var nodeError: str
            let node =
                merkle_dag.CsgCoreMerkleDagNodeRecord(
                    dag, nodeIndex, nodeError)
            if nodeError.len > 0:
                error = nodeError
                return merkle_artifacts.CsgCoreMerkleMembershipRecord()
            leafCid =
                merkle_dag.CsgCoreMerkleNodeRecordCid(
                    node)
            break
    if leafCid.len == 0:
        error = "membership fixture leaf missing"
        return merkle_artifacts.CsgCoreMerkleMembershipRecord()
    var out: merkle_artifacts.CsgCoreMerkleMembershipRecord
    out.partitionId =
        strings.CloneStr(header.partitionId)
    out.sourceId = strings.CloneStr(header.sourceId)
    out.sourceCid = strings.CloneStr(header.sourceCid)
    out.factKey = strings.CloneStr(key)
    out.factHash =
        cat(
            "sha256:",
            layout.FixedBytes32Hex(factHash))
    out.leafCid = strings.CloneStr(leafCid)
    return out

@borrows
fn queryForMembership(
        membership:
            merkle_artifacts.CsgCoreMerkleMembershipRecord,
        term: str):
        merkle_artifacts.CsgCoreMerkleQueryIndexRecord =
    var out: merkle_artifacts.CsgCoreMerkleQueryIndexRecord
    out.indexKind = "symbol.name"
    out.term = strings.CloneStr(term)
    out.factKey =
        strings.CloneStr(membership.factKey)
    out.factHash =
        strings.CloneStr(membership.factHash)
    out.leafCid =
        strings.CloneStr(membership.leafCid)
    out.partitionId =
        strings.CloneStr(membership.partitionId)
    out.sourceId =
        strings.CloneStr(membership.sourceId)
    out.sourceCid =
        strings.CloneStr(membership.sourceCid)
    return out

@borrows
fn dependencyRecord(
        consumerSource: str,
        providerSource: str,
        selector: str,
        providerSubgraphCid: str):
        merkle_artifacts.CsgCoreMerkleDependencyRecord =
    var out: merkle_artifacts.CsgCoreMerkleDependencyRecord
    out.consumerSource =
        strings.CloneStr(consumerSource)
    out.providerSource =
        strings.CloneStr(providerSource)
    out.selector = strings.CloneStr(selector)
    out.providerSubgraphCid =
        strings.CloneStr(providerSubgraphCid)
    return out

@borrows
fn partitionRootForRecord(
        record:
            merkle_manifest.CsgCoreMerklePartitionRecord):
        str =
    var owned: merkle_manifest.CsgCoreMerklePartitionRecord
    owned.sourceId = strings.CloneStr(record.sourceId)
    owned.sourceCid = strings.CloneStr(record.sourceCid)
    owned.factKind = strings.CloneStr(record.factKind)
    owned.factsCid = strings.CloneStr(record.factsCid)
    owned.factsRoot = strings.CloneStr(record.factsRoot)
    owned.dagRootCid = strings.CloneStr(record.dagRootCid)
    owned.membershipCid =
        strings.CloneStr(record.membershipCid)
    owned.factCount = record.factCount
    var records: merkle_manifest.CsgCoreMerklePartitionRecord[]
    add(records, owned)
    return merkle_manifest.CsgCoreMerklePartitionRoot(
        records)

@borrows
fn cloneSummaryHeader(
        header:
            merkle_artifacts.CsgCoreMerkleSummaryHeader):
        merkle_artifacts.CsgCoreMerkleSummaryHeader =
    var out: merkle_artifacts.CsgCoreMerkleSummaryHeader
    out.standard = strings.CloneStr(header.standard)
    out.profiles =
        validator.CsgCoreProfilesClone(
            header.profiles)
    out.profileSetCid =
        strings.CloneStr(header.profileSetCid)
    out.complete = header.complete
    out.schemaCid = strings.CloneStr(header.schemaCid)
    out.factsRoot = strings.CloneStr(header.factsRoot)
    out.dagRootCid = strings.CloneStr(header.dagRootCid)
    out.factCount = header.factCount
    out.nodeCount = header.nodeCount
    out.partitionRoot =
        strings.CloneStr(header.partitionRoot)
    out.partitionCount = header.partitionCount
    out.dependencyConsumerRoot =
        strings.CloneStr(header.dependencyConsumerRoot)
    out.dependencyProviderRoot =
        strings.CloneStr(header.dependencyProviderRoot)
    out.dependencyCount = header.dependencyCount
    out.dependencyConsumerShardCount =
        header.dependencyConsumerShardCount
    out.dependencyProviderShardCount =
        header.dependencyProviderShardCount
    out.queryShardRoot =
        strings.CloneStr(header.queryShardRoot)
    out.queryIndexCount = header.queryIndexCount
    out.queryShardCount = header.queryShardCount
    out.unsupportedCount = header.unsupportedCount
    out.tombstoneCount = header.tombstoneCount
    out.runtimeRequirementCount =
        header.runtimeRequirementCount
    return out

@borrows
fn membershipPairEncode(
        header:
            merkle_artifacts.CsgCoreMerkleMembershipHeader,
        partitionHeader:
            merkle_artifacts.CsgCoreMerklePartitionFactsHeader,
        dag: merkle_dag.CsgCoreMerkleDag,
        firstFact: str,
        secondFact: str,
        error: var str):
        merkle_artifacts.CsgCoreMerkleMembershipResult =
    error = ""
    let first =
        membershipForFact(
            partitionHeader, dag, firstFact, error)
    if error.len > 0:
        return merkle_artifacts.CsgCoreMerkleMembershipResult(
            error: strings.CloneStr(error))
    let second =
        membershipForFact(
            partitionHeader, dag, secondFact, error)
    if error.len > 0:
        return merkle_artifacts.CsgCoreMerkleMembershipResult(
            error: strings.CloneStr(error))
    var records: merkle_artifacts.CsgCoreMerkleMembershipRecord[]
    add(records, first)
    add(records, second)
    return merkle_artifacts.CsgCoreMerkleMembershipEncode(
        header, records)

@borrows
fn badMembershipEncode(
        header:
            merkle_artifacts.CsgCoreMerkleMembershipHeader,
        partitionHeader:
            merkle_artifacts.CsgCoreMerklePartitionFactsHeader,
        dag: merkle_dag.CsgCoreMerkleDag,
        firstFact: str,
        secondFact: str,
        error: var str):
        merkle_artifacts.CsgCoreMerkleMembershipResult =
    error = ""
    var first =
        membershipForFact(
            partitionHeader, dag, firstFact, error)
    if error.len > 0:
        return merkle_artifacts.CsgCoreMerkleMembershipResult(
            error: strings.CloneStr(error))
    let second =
        membershipForFact(
            partitionHeader, dag, secondFact, error)
    if error.len > 0:
        return merkle_artifacts.CsgCoreMerkleMembershipResult(
            error: strings.CloneStr(error))
    first.leafCid = strings.CloneStr(second.leafCid)
    var records: merkle_artifacts.CsgCoreMerkleMembershipRecord[]
    add(records, first)
    add(records, second)
    return merkle_artifacts.CsgCoreMerkleMembershipEncode(
        header, records)

@borrows
fn queryPairEncode(
        header:
            merkle_artifacts.CsgCoreMerkleQueryShardHeader,
        first:
            merkle_artifacts.CsgCoreMerkleMembershipRecord,
        second:
            merkle_artifacts.CsgCoreMerkleMembershipRecord):
        merkle_artifacts.CsgCoreMerkleQueryShardResult =
    var records: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    add(records, queryForMembership(first, "A"))
    add(records, queryForMembership(second, "A"))
    return merkle_artifacts.CsgCoreMerkleQueryShardEncode(
        header, records)

@borrows
fn duplicateQueryEncode(
        header:
            merkle_artifacts.CsgCoreMerkleQueryShardHeader,
        record:
            merkle_artifacts.CsgCoreMerkleMembershipRecord):
        merkle_artifacts.CsgCoreMerkleQueryShardResult =
    var records: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    add(records, queryForMembership(record, "A"))
    add(records, queryForMembership(record, "A"))
    return merkle_artifacts.CsgCoreMerkleQueryShardEncode(
        header, records)

@borrows
fn badQueryEncode(
        header:
            merkle_artifacts.CsgCoreMerkleQueryShardHeader,
        first:
            merkle_artifacts.CsgCoreMerkleMembershipRecord,
        second:
            merkle_artifacts.CsgCoreMerkleMembershipRecord):
        merkle_artifacts.CsgCoreMerkleQueryShardResult =
    var bad = queryForMembership(first, "A")
    bad.sourceCid = "sha256:bad"
    var records: merkle_artifacts.CsgCoreMerkleQueryIndexRecord[]
    add(records, bad)
    add(records, queryForMembership(second, "A"))
    return merkle_artifacts.CsgCoreMerkleQueryShardEncode(
        header, records)

@borrows
fn dependencyPairEncode(
        header:
            merkle_artifacts.CsgCoreMerkleDependencyShardHeader,
        firstProviderCid: str,
        secondProviderCid: str):
        merkle_artifacts.CsgCoreMerkleDependencyShardResult =
    var records: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    add(
        records,
        dependencyRecord(
            "source:a",
            "source:b",
            "symbol:A",
            firstProviderCid))
    add(
        records,
        dependencyRecord(
            "source:a",
            "source:c",
            "symbol:B",
            secondProviderCid))
    return merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
        header, records)

@borrows
fn reversedDependencyEncode(
        header:
            merkle_artifacts.CsgCoreMerkleDependencyShardHeader,
        firstProviderCid: str,
        secondProviderCid: str):
        merkle_artifacts.CsgCoreMerkleDependencyShardResult =
    var records: merkle_artifacts.CsgCoreMerkleDependencyRecord[]
    add(
        records,
        dependencyRecord(
            "source:a",
            "source:c",
            "symbol:B",
            secondProviderCid))
    add(
        records,
        dependencyRecord(
            "source:a",
            "source:b",
            "symbol:A",
            firstProviderCid))
    return merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
        header, records)

fn main(): int32 =
    let symbolA =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let symbolB =
        "{\"id\":\"sym_b\",\"kind\":\"csg.symbol\",\"name\":\"B\",\"symbolKind\":\"fn\"}"
    let facts = [strings.CloneStr(symbolA), strings.CloneStr(symbolB)]
    let dag = merkle_dag.CsgCoreMerkleBuild(facts)
    if !dag.ok:
        return fail("fixture DAG failed")

    var sourceBytes =
        ownedBytesFromText(
            "pkg://cheng/artifact-smoke/source.cheng")
    let sourceCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            "csg_core.external.source",
            sourceBytes)
    rawbytes.BytesFree(sourceBytes)
    if !merkle_store_codec.CsgCoreMerkleStoreCidValid(
           sourceCid):
        return fail("source CID failed")
    var partitionIdentity: merkle_manifest.CsgCoreMerklePartitionRecord
    partitionIdentity.sourceId = "source:artifact-smoke"
    partitionIdentity.factKind = "csg.symbol"
    var partitionHeader: merkle_artifacts.CsgCoreMerklePartitionFactsHeader
    partitionHeader.partitionId =
        merkle_manifest.CsgCoreMerklePartitionId(
            partitionIdentity)
    partitionHeader.sourceId =
        strings.CloneStr(partitionIdentity.sourceId)
    partitionHeader.sourceCid = strings.CloneStr(sourceCid)
    partitionHeader.factKind =
        strings.CloneStr(partitionIdentity.factKind)

    var partition =
        merkle_artifacts.CsgCoreMerklePartitionFactsEncode(
            partitionHeader, facts)
    if !partition.ok ||
       partition.factCount != 2 ||
       partition.factsRoot != dag.subgraphCid ||
       partition.dagRootCid !=
           merkle_dag.CsgCoreMerkleDagRootCid(dag):
        return fail(
            cat(
                "partition encode failed: ",
                partition.error))
    var partitionDecoded =
        merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
            partition.bytes)
    var partitionRepeated =
        merkle_artifacts.CsgCoreMerklePartitionFactsEncode(
            partitionHeader, facts)
    if !partitionDecoded.ok ||
       !partitionRepeated.ok ||
       partitionDecoded.cid != partition.cid ||
       partitionRepeated.cid != partition.cid ||
       !rawbytes.BytesEqual(
           partitionDecoded.bytes,
           partition.bytes) ||
       !rawbytes.BytesEqual(
           partitionRepeated.bytes,
           partition.bytes):
        return fail("partition roundtrip mismatch")
    let reversedPartition =
        merkle_artifacts.CsgCoreMerklePartitionFactsEncode(
            partitionHeader, [strings.CloneStr(symbolB), strings.CloneStr(symbolA)])
    if reversedPartition.ok ||
       !strings.StrContains(
           reversedPartition.error,
           "non_canonical_order"):
        return fail("partition non-sorted facts accepted")

    let sourceField =
        cat(
            ",\"source_cid\":",
            merkle_store_codec.CsgCoreMerkleStoreJsonString(
                sourceCid))
    let missingPartitionHeader =
        removeFirst(
            partition.lines[0], sourceField)
    var missingPartitionBytes =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            [missingPartitionHeader, strings.CloneStr(symbolA), strings.CloneStr(symbolB)])
    if !missingPartitionBytes.ok:
        return fail("missing partition fixture encode failed")
    let missingPartitionDecoded =
        merkle_artifacts.CsgCoreMerklePartitionFactsDecode(
            missingPartitionBytes.bytes)
    if missingPartitionDecoded.ok:
        return fail("partition missing field accepted")
    var membershipError: str
    var membershipHeader: merkle_artifacts.CsgCoreMerkleMembershipHeader
    membershipHeader.partitionId =
        strings.CloneStr(partitionHeader.partitionId)
    membershipHeader.sourceId =
        strings.CloneStr(partitionHeader.sourceId)
    membershipHeader.sourceCid =
        strings.CloneStr(partitionHeader.sourceCid)
    membershipHeader.factKind =
        strings.CloneStr(partitionHeader.factKind)
    membershipHeader.factsCid =
        strings.CloneStr(partition.cid)
    membershipHeader.factsRoot =
        strings.CloneStr(partition.factsRoot)
    membershipHeader.dagRootCid =
        strings.CloneStr(partition.dagRootCid)
    membershipHeader.factCount = partition.factCount
    var membership =
        membershipPairEncode(
            membershipHeader,
            partitionHeader,
            dag,
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB),
            membershipError)
    if membershipError.len > 0:
        return fail(membershipError)
    if !membership.ok || membership.recordCount != 2:
        return fail(
            cat(
                "membership encode failed: ",
                membership.error))
    var membershipDecoded =
        merkle_artifacts.CsgCoreMerkleMembershipDecode(
            membership.bytes)
    var membershipRepeated =
        membershipPairEncode(
            membershipHeader,
            partitionHeader,
            dag,
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB),
            membershipError)
    if membershipError.len > 0:
        return fail(membershipError)
    if !membershipDecoded.ok ||
       !membershipRepeated.ok ||
       membershipDecoded.cid != membership.cid ||
       membershipRepeated.cid != membership.cid ||
       !rawbytes.BytesEqual(
           membershipDecoded.bytes,
           membership.bytes) ||
       !rawbytes.BytesEqual(
           membershipRepeated.bytes,
           membership.bytes):
        return fail("membership roundtrip mismatch")
    let duplicateMembership =
        membershipPairEncode(
            membershipHeader,
            partitionHeader,
            dag,
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolA),
            membershipError)
    if membershipError.len > 0:
        return fail(membershipError)
    if duplicateMembership.ok ||
       !strings.StrContains(
           duplicateMembership.error, "duplicate"):
        return fail("membership duplicate accepted")
    let badMembership =
        badMembershipEncode(
            membershipHeader,
            partitionHeader,
            dag,
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB),
            membershipError)
    if membershipError.len > 0:
        return fail(membershipError)
    if badMembership.ok ||
       !strings.StrContains(
           badMembership.error, "leaf_binding"):
        return fail("membership wrong leaf CID accepted")
    var dependencyHeader: merkle_artifacts.CsgCoreMerkleDependencyShardHeader
    dependencyHeader.profileSetCid =
        validator.CsgCoreProfileSetCid(["csg_core"])
    dependencyHeader.projection =
        merkle_artifacts.CsgCoreMerkleDependencyConsumerProjection()
    dependencyHeader.shardKey = "source:a"
    var dependency =
        dependencyPairEncode(
            dependencyHeader,
            partition.cid,
            partition.dagRootCid)
    if !dependency.ok ||
       dependency.entryCount != 2:
        return fail(
            cat(
                "dependency encode failed: ",
                dependency.error))
    var dependencyDecoded =
        merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
            dependency.bytes)
    var dependencyRepeated =
        dependencyPairEncode(
            dependencyHeader,
            partition.cid,
            partition.dagRootCid)
    if !dependencyDecoded.ok ||
       !dependencyRepeated.ok ||
       dependencyDecoded.cid != dependency.cid ||
       dependencyRepeated.cid != dependency.cid ||
       !rawbytes.BytesEqual(
           dependencyDecoded.bytes,
           dependency.bytes) ||
       !rawbytes.BytesEqual(
           dependencyRepeated.bytes,
           dependency.bytes):
        return fail("dependency roundtrip mismatch")
    let reversedDependency =
        reversedDependencyEncode(
            dependencyHeader,
            partition.cid,
            partition.dagRootCid)
    if reversedDependency.ok ||
       !strings.StrContains(
           reversedDependency.error,
           "non_canonical_order"):
        return fail("dependency non-sorted records accepted")
    var swappedDependencyBytes =
        swapFirstTwoCsgcLines(dependency.bytes)
    if rawbytes.BytesLen(swappedDependencyBytes) !=
       rawbytes.BytesLen(dependency.bytes):
        return fail("dependency wire swap failed")
    let swappedDependency =
        merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
            swappedDependencyBytes)
    if swappedDependency.ok ||
       !strings.StrContains(
           swappedDependency.error,
           "non_canonical"):
        return fail("dependency non-sorted CSGC accepted")
    var queryHeader: merkle_artifacts.CsgCoreMerkleQueryShardHeader
    queryHeader.profileSetCid =
        validator.CsgCoreProfileSetCid(["csg_core"])
    queryHeader.bucket =
        merkle_artifacts.CsgCoreMerkleQueryBucket(
            "symbol.name", "A")
    var queryIndex =
        queryPairEncode(
            queryHeader,
            membership.records[0],
            membership.records[1])
    if !queryIndex.ok || queryIndex.entryCount != 2:
        return fail(
            cat(
                "query index encode failed: ",
                queryIndex.error))
    var queryDecoded =
        merkle_artifacts.CsgCoreMerkleQueryShardDecode(
            queryIndex.bytes)
    var queryRepeated =
        queryPairEncode(
            queryHeader,
            membership.records[0],
            membership.records[1])
    if !queryDecoded.ok ||
       !queryRepeated.ok ||
       queryDecoded.cid != queryIndex.cid ||
       queryRepeated.cid != queryIndex.cid ||
       !rawbytes.BytesEqual(
           queryDecoded.bytes,
           queryIndex.bytes) ||
       !rawbytes.BytesEqual(
           queryRepeated.bytes,
           queryIndex.bytes):
        return fail("query index roundtrip mismatch")
    let duplicateQuery =
        duplicateQueryEncode(
            queryHeader, membership.records[0])
    if duplicateQuery.ok ||
       !strings.StrContains(
           duplicateQuery.error, "duplicate"):
        return fail("query index duplicate accepted")
    let badQueryIndex =
        badQueryEncode(
            queryHeader,
            membership.records[0],
            membership.records[1])
    if badQueryIndex.ok ||
       !strings.StrContains(
           badQueryIndex.error, "record_invalid"):
        return fail("query index bad CID accepted")
    var nodes: merkle_dag.CsgCoreMerkleNodeRecord[]
    for nodeIndex in 0..<dag.nodeKinds.len:
        var nodeError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, nodeIndex, nodeError)
        if nodeError.len > 0:
            return fail("node segment projection failed")
        add(nodes, node)
    var nodeSegment =
        merkle_store_codec.CsgCoreMerkleNodeSegmentEncode(
            nodes)
    if !nodeSegment.ok:
        return fail("node segment encode failed")
    var partitionRecord: merkle_manifest.CsgCoreMerklePartitionRecord
    partitionRecord.sourceId =
        strings.CloneStr(partitionHeader.sourceId)
    partitionRecord.sourceCid =
        strings.CloneStr(partitionHeader.sourceCid)
    partitionRecord.factKind =
        strings.CloneStr(partitionHeader.factKind)
    partitionRecord.factsCid =
        strings.CloneStr(partition.cid)
    partitionRecord.factsRoot =
        strings.CloneStr(partition.factsRoot)
    partitionRecord.dagRootCid =
        strings.CloneStr(partition.dagRootCid)
    partitionRecord.membershipCid =
        strings.CloneStr(membership.cid)
    partitionRecord.factCount = partition.factCount
    var partitionRoot =
        partitionRootForRecord(partitionRecord)
    let schemaFact =
        "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var schemaHashError: str
    let schemaHash =
        merkle_dag.CsgCoreMerkleFactHash(
            strings.CloneStr(schemaFact), schemaHashError)
    if schemaHashError.len > 0:
        return fail("summary schema hash failed")
    let schemaCid =
        cat(
            "sha256:",
            layout.FixedBytes32Hex(schemaHash))
    let boundDag =
        merkle_dag.CsgCoreMerkleBuildBound(
            facts,
            "csg_core::v1",
            ["csg_core"],
            "csg_core::v1",
            schemaCid)
    if !boundDag.ok || boundDag.factsRoot.len == 0:
        return fail("summary facts root binding failed")
    var summaryHeader: merkle_artifacts.CsgCoreMerkleSummaryHeader
    summaryHeader.standard = "csg_core::v1"
    summaryHeader.profiles = ["csg_core"]
    summaryHeader.profileSetCid =
        validator.CsgCoreProfileSetCid(
            summaryHeader.profiles)
    summaryHeader.complete = true
    summaryHeader.schemaCid = strings.CloneStr(schemaCid)
    summaryHeader.factsRoot =
        strings.CloneStr(boundDag.factsRoot)
    summaryHeader.dagRootCid =
        strings.CloneStr(boundDag.dagRootCid)
    summaryHeader.factCount = partition.factCount
    summaryHeader.nodeCount = nodes.len
    summaryHeader.partitionRoot =
        strings.CloneStr(partitionRoot)
    summaryHeader.partitionCount = 1
    summaryHeader.dependencyConsumerRoot =
        strings.CloneStr(dependency.shardRoot)
    summaryHeader.dependencyProviderRoot =
        strings.CloneStr(dependency.shardRoot)
    summaryHeader.dependencyCount =
        dependency.entryCount
    summaryHeader.dependencyConsumerShardCount = 1
    summaryHeader.dependencyProviderShardCount = 1
    summaryHeader.queryShardRoot =
        strings.CloneStr(queryIndex.shardRoot)
    summaryHeader.queryIndexCount =
        queryIndex.entryCount
    summaryHeader.queryShardCount =
        merkle_artifacts.CsgCoreMerkleQueryBucketCount()
    var summary =
        merkle_artifacts.CsgCoreMerkleSummaryEncode(
            summaryHeader)
    if !summary.ok:
        return fail(
            cat(
                "summary encode failed: ",
                summary.error))
    var summaryDecoded =
        merkle_artifacts.CsgCoreMerkleSummaryDecode(
            summary.bytes)
    var summaryRepeated =
        merkle_artifacts.CsgCoreMerkleSummaryEncode(
            summaryHeader)
    if !summaryDecoded.ok ||
       !summaryRepeated.ok ||
       summaryDecoded.cid != summary.cid ||
       summaryRepeated.cid != summary.cid ||
       !rawbytes.BytesEqual(
           summaryDecoded.bytes,
           summary.bytes) ||
       !rawbytes.BytesEqual(
           summaryRepeated.bytes,
           summary.bytes):
        return fail("summary roundtrip mismatch")
    var badSummaryHeader =
        cloneSummaryHeader(summaryHeader)
    badSummaryHeader.factsRoot =
        strings.CloneStr(dependency.cid)
    let badSummary =
        merkle_artifacts.CsgCoreMerkleSummaryEncode(
            badSummaryHeader)
    if badSummary.ok ||
       !strings.StrContains(
           badSummary.error,
           "facts_root_mismatch"):
        return fail("summary wrong facts root accepted")
    let extraSummaryLine =
        addExtraField(summary.lines[0])
    var extraSummaryBytes =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            [extraSummaryLine])
    if !extraSummaryBytes.ok:
        return fail("extra summary fixture encode failed")
    let extraSummaryDecoded =
        merkle_artifacts.CsgCoreMerkleSummaryDecode(
            extraSummaryBytes.bytes)
    if extraSummaryDecoded.ok:
        return fail("summary extra field accepted")
    os.WriteLine(os.Get_stdout(), partition.cid)
    os.WriteLine(os.Get_stdout(), membership.cid)
    os.WriteLine(os.Get_stdout(), dependency.cid)
    os.WriteLine(os.Get_stdout(), summary.cid)
    os.WriteLine(os.Get_stdout(), queryIndex.cid)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_artifacts_smoke ok")

    rawbytes.BytesFree(extraSummaryBytes.bytes)
    rawbytes.BytesFree(summaryRepeated.bytes)
    rawbytes.BytesFree(summaryDecoded.bytes)
    rawbytes.BytesFree(summary.bytes)
    rawbytes.BytesFree(nodeSegment.bytes)
    rawbytes.BytesFree(queryRepeated.bytes)
    rawbytes.BytesFree(queryDecoded.bytes)
    rawbytes.BytesFree(queryIndex.bytes)
    rawbytes.BytesFree(swappedDependencyBytes)
    rawbytes.BytesFree(dependencyRepeated.bytes)
    rawbytes.BytesFree(dependencyDecoded.bytes)
    rawbytes.BytesFree(dependency.bytes)
    rawbytes.BytesFree(membershipRepeated.bytes)
    rawbytes.BytesFree(membershipDecoded.bytes)
    rawbytes.BytesFree(membership.bytes)
    rawbytes.BytesFree(missingPartitionBytes.bytes)
    rawbytes.BytesFree(partitionRepeated.bytes)
    rawbytes.BytesFree(partitionDecoded.bytes)
    rawbytes.BytesFree(partition.bytes)
    return 0
