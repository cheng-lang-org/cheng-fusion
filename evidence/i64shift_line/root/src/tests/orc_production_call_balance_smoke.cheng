import std/system

const OrcProductionCallCycles: int32 = 5000

type
    OrcProductionPathTotals =
        calls: int32
        allocated: int64
        freed: int64

@importc("cheng_runtime_heap_new")
fn runtimeHeapNew(size: int32): ptr

fn OrcProductionCall(
        requestedFailure: bool,
        totals: var OrcProductionPathTotals): bool =
    let allocBefore = memAllocCount()
    let freeBefore = memFreeCount()
    let liveBefore = memLiveCount()

    let request = runtimeHeapNew(32)
    if request == nil:
        panic("orc production call: request allocation failed")
    let response = runtimeHeapNew(64)
    if response == nil:
        memRelease(request)
        panic("orc production call: response allocation failed")

    memRetain(request)
    memRelease(request)
    memRetainAtomic(response)
    memReleaseAtomic(response)

    if requestedFailure:
        memReleaseAtomic(response)
        memRelease(request)
        let allocated = memAllocCount() - allocBefore
        let freed = memFreeCount() - freeBefore
        let live = memLiveCount() - liveBefore
        assert(allocated == int64(2) &&
               freed == int64(2) &&
               live == int64(0),
               "orc production call: failure cleanup ledger mismatch")
        totals.calls = totals.calls + 1
        totals.allocated = totals.allocated + allocated
        totals.freed = totals.freed + freed
        return false

    memReleaseAtomic(response)
    memRelease(request)
    let allocated = memAllocCount() - allocBefore
    let freed = memFreeCount() - freeBefore
    let live = memLiveCount() - liveBefore
    assert(allocated == int64(2) &&
           freed == int64(2) &&
           live == int64(0),
           "orc production call: success cleanup ledger mismatch")
    totals.calls = totals.calls + 1
    totals.allocated = totals.allocated + allocated
    totals.freed = totals.freed + freed
    return true

fn OrcProductionRunPath(
        requestedFailure: bool,
        totals: var OrcProductionPathTotals) =
    for cycle in 0..<OrcProductionCallCycles:
        let succeeded = OrcProductionCall(requestedFailure, totals)
        if succeeded == requestedFailure:
            panic("orc production call: path outcome mismatch")
    assert(totals.calls == OrcProductionCallCycles &&
           totals.allocated == int64(10000) &&
           totals.freed == int64(10000),
           "orc production call: path aggregate mismatch")

fn main(): int32 =
    let liveBefore = memLiveCount()
    var successTotals: OrcProductionPathTotals
    var failureTotals: OrcProductionPathTotals
    OrcProductionRunPath(false, successTotals)
    OrcProductionRunPath(true, failureTotals)
    assert(memLiveCount() == liveBefore,
           "orc production call: terminal live ledger mismatch")
    echo(Fmt"orc_production_call_balance path=success cycles={successTotals.calls} alloc={successTotals.allocated} free={successTotals.freed} live=0")
    echo(Fmt"orc_production_call_balance path=failure cycles={failureTotals.calls} alloc={failureTotals.allocated} free={failureTotals.freed} live=0")
    return 0
