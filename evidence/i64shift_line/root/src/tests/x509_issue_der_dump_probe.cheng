# Dumps one issued self-signed leaf cert's DER bytes + hex-printed
# SHA-256(DER) certhash to files, for independent cross-check against
# `openssl x509 -in <der> -inform DER -noout -fingerprint -sha256`
# (openssl only VERIFIES/computes-over what this program already produced --
# it is not a data source, so this is a real, non-circular cross-check).

import std/system
import std/result
import std/rawbytes
import std/os
import std/tls/x509_issue as x509issue

fn main(): int32 =
    let issuedRes: Result[x509issue.X509IssuedCert] = x509issue.X509IssueSelfSignedLeaf("localhost", 1)
    if IsErr(issuedRes):
        panic(" der dump: issue: " + ErrorText(issuedRes))
    var cert: x509issue.X509IssuedCert = Value(issuedRes)
    let derPath: str = "/tmp/wt2_issued_leaf.der"
    let writeRes: Result[bool] = os.WriteFileBytesResult(derPath, cert.der)
    if IsErr(writeRes):
        panic(" der dump: write: " + ErrorText(writeRes))
    echo(" der_path=" + derPath)
    echo(" der_len=" + IntToStr(BytesLen(cert.der)))
    echo(" certhash_hex=" + BytesToHex(cert.certHash))
    return 0
