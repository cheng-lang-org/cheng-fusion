import cheng/core/runtime/js_event_loop_runtime as eventloop

fn assertTrace(loop: var eventloop.JsEventLoop,
               index: int32,
               handlerId: int32,
               phase: int32,
               code: int32): int32 =
    if eventloop.JsEventLoopTraceHandlerAt(loop, index) != handlerId:
        return code
    if eventloop.JsEventLoopTracePhaseAt(loop, index) != phase:
        return code
    return 0

fn main(): int32 =
    var loop: eventloop.JsEventLoop
    eventloop.JsEventLoopInit(loop)

    if !eventloop.JsEventLoopEnqueueTask(loop, 10):
        return 1
    if !eventloop.JsEventLoopEnqueueMicrotask(loop, 1):
        return 2
    if !eventloop.JsEventLoopEnqueueTaskWithFollowUpMicrotask(loop, 20, 21):
        return 3
    if !eventloop.JsEventLoopEnqueueTask(loop, 30):
        return 4
    if !eventloop.JsEventLoopRunUntilEmpty(loop, 8):
        return 5
    if eventloop.JsEventLoopTraceCount(loop) != 5:
        return 6
    let check0 = assertTrace(loop, 0, 1, eventloop.JsEventLoopTracePhaseMicrotask, 7)
    if check0 != 0:
        return check0
    let check1 = assertTrace(loop, 1, 10, eventloop.JsEventLoopTracePhaseTask, 8)
    if check1 != 0:
        return check1
    let check2 = assertTrace(loop, 2, 20, eventloop.JsEventLoopTracePhaseTask, 9)
    if check2 != 0:
        return check2
    let check3 = assertTrace(loop, 3, 21, eventloop.JsEventLoopTracePhaseMicrotask, 10)
    if check3 != 0:
        return check3
    let check4 = assertTrace(loop, 4, 30, eventloop.JsEventLoopTracePhaseTask, 11)
    if check4 != 0:
        return check4
    if eventloop.JsEventLoopTaskQueueCount(loop) != 0:
        return 12
    if eventloop.JsEventLoopMicrotaskQueueCount(loop) != 0:
        return 13

    eventloop.JsEventLoopReset(loop)
    if eventloop.JsEventLoopEnqueueTask(loop, 0):
        return 14
    if eventloop.JsEventLoopEnqueueMicrotask(loop, -1):
        return 15
    if eventloop.JsEventLoopEnqueueTaskWithFollowUpMicrotask(loop, 1, 0):
        return 16

    eventloop.JsEventLoopReset(loop)
    if !eventloop.JsEventLoopEnqueueMicrotask(loop, 101):
        return 17
    if !eventloop.JsEventLoopEnqueueTask(loop, 102):
        return 18
    if eventloop.JsEventLoopRunUntilEmpty(loop, 1):
        return 19
    if eventloop.JsEventLoopTraceCount(loop) != 1:
        return 20
    let limitCheck = assertTrace(loop, 0, 101, eventloop.JsEventLoopTracePhaseMicrotask, 21)
    if limitCheck != 0:
        return limitCheck

    echo(" js_event_loop_smoke ok")
    return 0
