import std/os
import std/result
import cheng/core/lang/parser
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_world as cworld
import cheng/core/backend/system_link_plan as slplan

fn BuildLifecycleCsg(out: var ccsg.CompilerCsg) =
    # 新 seal 会核对 closure 源真实存在, 虚拟 fixture 落盘到 /tmp;
    # 身份行保持模块文本 (见下), 测试语义 (视图生命周期计数) 与路径无关。
    let sourcePath = "/tmp/compiler-csg-compact-profile-lifecycle/src/entry.cheng"
    let modulePath = "compiler-csg-compact-profile-lifecycle-smoke/entry"
    var linkPlan: slplan.SystemLinkPlanStub
    linkPlan.entryPath = sourcePath
    linkPlan.buildEntryPath = sourcePath
    linkPlan.workspaceRoot = "/tmp/compiler-csg-compact-profile-lifecycle"
    linkPlan.packageRoot = "/tmp/compiler-csg-compact-profile-lifecycle"
    linkPlan.packageId = "compiler-csg-compact-profile-lifecycle-smoke"
    linkPlan.moduleStem = modulePath
    linkPlan.targetTriple = "arm64-apple-darwin"
    linkPlan.emitKind = creq.EmitObj
    linkPlan.entrySymbol = "main"
    linkPlan.sourceClosurePaths = [sourcePath]
    linkPlan.buildSourceUnitCount = 1
    linkPlan.ownerModulePaths = [modulePath]
    linkPlan.sourceBundleEntrySourceIndex = 0
    linkPlan.mainFunctionPresent = true
    linkPlan.parserSyntaxTag = "cheng_normalized_source"

    var source: ccsg.CompilerCsgSourceText
    source.sourcePath = sourcePath
    source.modulePath = modulePath
    source.text = "fn leaf(x: int32): int32 =\n    return x + 1\n\nfn middle(x: int32): int32 =\n    return leaf(x)\n\nfn main(): int32 =\n    return middle(40)\n"
    var overrides = [source]
    os.MkdirAll("/tmp/compiler-csg-compact-profile-lifecycle/src", 493)
    os.WriteFile(sourcePath, source.text)
    # 新身份 API 逐行要求模块文本 (拒绝绝对路径/.cheng 后缀);
    # root-out 虚拟源的身份行改用与 owner 列一致的模块路径。
    var identityPaths = [modulePath]
    var identityTexts = [source.text]
    let sourceBundleRes = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        linkPlan.packageId,
        identityPaths,
        identityTexts)
    assert(IsOk(sourceBundleRes),
           "compiler csg compact profile lifecycle: source bundle")
    # 新绑定校验同时封 entry/import-graph 两列 cid, 经 portable binding
    # 一次算齐, 保证三列与磁盘文本严格一致。
    var noEdges: parser.ImportEdge[]
    var portableBinding: slplan.SystemLinkPlanPortableSourceBinding
    var err: str
    assert(slplan.SystemLinkPlanPortableSourceBindingFromTextsInto(
               linkPlan.packageId,
               modulePath,
               identityPaths,
               identityTexts,
               noEdges,
               portableBinding,
               err),
           Fmt"compiler csg compact profile lifecycle: portable binding failed {err}")
    linkPlan.sourceBundleIdentityPaths = identityPaths
    linkPlan.sourceBundleCid = sourceBundleRes
    linkPlan.sourceBundleCidValue = Value(sourceBundleRes)
    linkPlan.sourceBundleEntrySourceCid = portableBinding.entrySourceCid
    linkPlan.sourceBundleImportGraphCid = portableBinding.importGraphCid
    assert(slplan.SystemLinkPlanSealSourceBundleBinding(linkPlan, err),
           Fmt"compiler csg compact profile lifecycle: source binding failed {err}")
    assert(ccsg.BuildCompilerCsgWithOverridesInto(linkPlan,
                                                   Value(sourceBundleRes),
                                                   overrides,
                                                   out,
                                                   err),
           Fmt"compiler csg compact profile lifecycle: build failed {err}")

fn AssertAbortOwnerRelease() =
    var work: ccsg.CompilerCsgBuildWorkingSet
    work.activeCompactProfileViewOwned = true
    work.compactProfileViewLifecycle.viewBuildCount = Int64(1)
    work.compactProfileViewLifecycle.activeOwnerCount = Int64(1)
    ccsg.CompilerCsgBuildWorkingSetRelease(work)
    assert(!work.activeCompactProfileViewOwned &&
           work.activeCompactProfileView.profiles.len == 0 &&
           work.activeCompactProfileCacheOverlay.entries.len == 0 &&
           work.compactProfileViewLifecycle.activeOwnerCount == Int64(0),
           "compiler csg compact profile lifecycle: abort owner retained")

fn main(): int32 =
    var csg: ccsg.CompilerCsg
    BuildLifecycleCsg(csg)
    let lifecycle = csg.compactProfileViewLifecycle
    assert(lifecycle.eligibleSourceCount > Int64(0),
           "compiler csg compact profile lifecycle: no eligible source")
    assert(lifecycle.viewBuildCount == lifecycle.eligibleSourceCount,
           "compiler csg compact profile lifecycle: source/build mismatch")
    assert(lifecycle.functionLevelViewRebuildCount == Int64(0),
           "compiler csg compact profile lifecycle: function rebuild detected")
    assert(lifecycle.viewReleaseCount == lifecycle.viewBuildCount,
           "compiler csg compact profile lifecycle: source/release mismatch")
    assert(lifecycle.activeOwnerCount == Int64(0) &&
           lifecycle.activeOwnerPeakCount == Int64(1),
           "compiler csg compact profile lifecycle: owner count mismatch")
    assert(lifecycle.rangeBorrowCount > Int64(0),
           "compiler csg compact profile lifecycle: range was not borrowed")
    assert(lifecycle.cacheOverlayValidateCount == lifecycle.viewBuildCount &&
           lifecycle.cacheOverlayCommitCount == lifecycle.viewBuildCount,
           "compiler csg compact profile lifecycle: cache transaction mismatch")

    AssertAbortOwnerRelease()
    echo(Fmt"compact_profile_view_eligible_source_count={lifecycle.eligibleSourceCount}")
    echo(Fmt"compact_profile_view_build_count={lifecycle.viewBuildCount}")
    echo(Fmt"compact_profile_view_function_level_rebuild_count={lifecycle.functionLevelViewRebuildCount}")
    echo(Fmt"compact_profile_view_release_count={lifecycle.viewReleaseCount}")
    echo(Fmt"compact_profile_view_active_owner_final_count={lifecycle.activeOwnerCount}")
    echo(Fmt"compact_profile_view_active_owner_peak_count={lifecycle.activeOwnerPeakCount}")
    echo(Fmt"compact_profile_view_range_borrow_count={lifecycle.rangeBorrowCount}")
    echo(Fmt"compact_profile_view_cache_overlay_validate_count={lifecycle.cacheOverlayValidateCount}")
    echo(Fmt"compact_profile_view_cache_overlay_commit_count={lifecycle.cacheOverlayCommitCount}")
    echo("compiler_csg_compact_profile_view_source_lifecycle_smoke ok")
    ccsg.CompilerCsgReleaseBackendInputPayload(csg)
    return 0
