import std/strutils as strutil
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr

fn FixtureText(): str =
    var lines: str[]
    add(lines, "type")
    add(lines, "    CtorRow =")
    add(lines, "        left: int32")
    add(lines, "        right: int32")
    add(lines, "    Pair =")
    add(lines, "        left: int32")
    add(lines, "        right: int32")
    add(lines, "    Inner =")
    add(lines, "        value: int32")
    add(lines, "    Outer =")
    add(lines, "        left: int32")
    add(lines, "        inner: Inner")
    add(lines, "        right: int32")
    add(lines, "")
    add(lines, "fn Touch(value: int32): int32 = value + 1")
    add(lines, "")
    add(lines, "fn Named(left: int32, right: int32): int32 =")
    add(lines, "    return left * 10 + right")
    add(lines, "")
    add(lines, "fn Pair(left: int32, right: int32): int32 =")
    add(lines, "    return left * 100 + right")
    add(lines, "")
    add(lines, "fn ImportedPair(left: int32, right: int32): int32 =")
    add(lines, "    return left * 1000 + right")
    add(lines, "")
    add(lines, "fn Build(): int32 =")
    add(lines, "    let paren = CtorRow(left: Touch(1), right: Touch(2))")
    add(lines, "    let braced = CtorRow { left: Touch(3), right: Touch(4) }")
    add(lines, "    let nested = Outer(")
    add(lines, "        left: Touch(5),")
    add(lines, "        inner: Inner(value: Touch(6)),")
    add(lines, "        right: Touch(7),")
    add(lines, "    )")
    add(lines, "    let named = Named(8, 9)")
    add(lines, "    let sameNameCtor = Pair(left: Touch(10), right: Touch(11))")
    add(lines, "    let sameNameCall = Pair(12, 13)")
    add(lines, "    let plain = Touch(14)")
    add(lines, "    let importedCtor = ImportedPair(left: Touch(15), right: Touch(16))")
    add(lines, "    let importedCall = ImportedPair(17, 18)")
    add(lines, "    return paren.left + braced.right + nested.inner.value + sameNameCtor.left + importedCtor.right + named + sameNameCall + importedCall + plain")
    return strutil.Join(lines, "\n")

fn ImportedFixtureText(): str =
    var lines: str[]
    add(lines, "type")
    add(lines, "    ImportedPair =")
    add(lines, "        left: int32")
    add(lines, "        right: int32")
    return strutil.Join(lines, "\n")

fn FixtureSource(): texpr.TypedExprSourceText =
    var externalRoots: parser.ParserExternalPackageRoot[]
    return texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work",
        "pkg://t88-statement-contract",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        externalRoots,
        "/work/pkg/main.cheng",
        FixtureText())

fn ImportedFixtureSource(): texpr.TypedExprSourceText =
    var externalRoots: parser.ParserExternalPackageRoot[]
    return texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work",
        "pkg://t88-statement-contract",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        externalRoots,
        "/work/pkg/imported_model.cheng",
        ImportedFixtureText())

fn main(): int32 =
    let source = FixtureSource()
    let importedSource = ImportedFixtureSource()
    var sourceTexts: texpr.TypedExprSourceText[] = [source]
    var contexts: texpr.TypedExprSourceContext[]
    var context: texpr.TypedExprSourceContext
    var err: str
    if !texpr.TypedExprBuildSourceContext(source, context, err):
        return 10
    var importedModule: texpr.TypedExprImportedModule
    importedModule.qualifier = "model"
    importedModule.targetSourcePath = "/work/pkg/imported_model.cheng"
    add(context.importedModules, importedModule)
    texpr.TypedExprSourceContextAppendMove(contexts, context)
    var importedContext: texpr.TypedExprSourceContext
    if !texpr.TypedExprBuildSourceContext(importedSource, importedContext, err):
        return 15
    texpr.TypedExprSourceContextAppendMove(contexts, importedContext)
    var ir: texpr.TypedExprIr
    texpr.TypedExprBuildSourceContextIndex(ir, contexts)

    var layer: parser.NormalizedExprLayer
    if !texpr.TypedExprReadNormalizedExprLayerForSourceTexts(sourceTexts,
                                                             layer,
                                                             err):
        return 11
    sourceTexts = [source]
    var factsLayer = parser.NormalizedExprLayerClone(layer)
    var facts: texpr.TypedExprFactTable
    if !texpr.TypedExprBuildFactsWithMetadataContexts(sourceTexts,
                                                       factsLayer,
                                                       contexts,
                                                       facts,
                                                       err):
        return 12

    sourceTexts = [source]
    var filterSourcePaths: str[]
    var filterFunctionNames: str[]
    var filterStartLines: int32[]
    if !texpr.TypedExprSnapshotBuild(sourceTexts,
                                   contexts,
                                   facts,
                                   layer,
                                   ir,
                                   false,
                                   filterSourcePaths,
                                   filterFunctionNames,
                                   filterStartLines):
        return 13

    var parenRows: int32
    var bracedRows: int32
    var nestedRows: int32
    var sameNameCtorRows: int32
    var parenLocalDecls: int32
    var bracedLocalDecls: int32
    var nestedLocalDecls: int32
    var sameNameCtorLocalDecls: int32
    var namedLetCalls: int32
    var sameNameCallLetCalls: int32
    var plainLetCalls: int32
    var importedCtorRows: int32
    var importedCtorLocalDecls: int32
    var importedCallLetCalls: int32
    for statementIndex in 0..<ir.statements2_statementIndexs.len:
        let stmt = texpr.TypedExprIrStatementAt(ir, statementIndex)
        if stmt.functionName != "Build":
            continue
        if stmt.lineNumber == 27:
            parenRows = parenRows + 1
            if stmt.kind == texpr.TypedExprIrStmtLocalDecl &&
               stmt.bindingName == "paren" && stmt.resultType == "CtorRow":
                parenLocalDecls = parenLocalDecls + 1
        elif stmt.lineNumber == 28:
            bracedRows = bracedRows + 1
            if stmt.kind == texpr.TypedExprIrStmtLocalDecl &&
               stmt.bindingName == "braced" && stmt.resultType == "CtorRow":
                bracedLocalDecls = bracedLocalDecls + 1
        elif stmt.lineNumber >= 29 && stmt.lineNumber <= 33:
            nestedRows = nestedRows + 1
            if stmt.lineNumber == 29 &&
               stmt.kind == texpr.TypedExprIrStmtLocalDecl &&
               stmt.bindingName == "nested" && stmt.resultType == "Outer":
                nestedLocalDecls = nestedLocalDecls + 1
        elif stmt.lineNumber == 34:
            if stmt.kind == texpr.TypedExprIrStmtLetCall &&
               stmt.bindingName == "named" && stmt.callCallee == "Named" &&
               stmt.resultType == "int32":
                namedLetCalls = namedLetCalls + 1
        elif stmt.lineNumber == 35:
            sameNameCtorRows = sameNameCtorRows + 1
            if stmt.kind == texpr.TypedExprIrStmtLocalDecl &&
               stmt.bindingName == "sameNameCtor" && stmt.resultType == "Pair":
                sameNameCtorLocalDecls = sameNameCtorLocalDecls + 1
        elif stmt.lineNumber == 36:
            if stmt.kind == texpr.TypedExprIrStmtLetCall &&
               stmt.bindingName == "sameNameCall" && stmt.callCallee == "Pair" &&
               stmt.resultType == "int32":
                sameNameCallLetCalls = sameNameCallLetCalls + 1
        elif stmt.lineNumber == 37:
            if stmt.kind == texpr.TypedExprIrStmtLetCall &&
               stmt.bindingName == "plain" && stmt.callCallee == "Touch" &&
               stmt.resultType == "int32":
                plainLetCalls = plainLetCalls + 1
        elif stmt.lineNumber == 38:
            importedCtorRows = importedCtorRows + 1
            if stmt.kind == texpr.TypedExprIrStmtLocalDecl &&
               stmt.bindingName == "importedCtor" &&
               stmt.resultType == "ImportedPair":
                importedCtorLocalDecls = importedCtorLocalDecls + 1
        elif stmt.lineNumber == 39:
            if stmt.kind == texpr.TypedExprIrStmtLetCall &&
               stmt.bindingName == "importedCall" &&
               stmt.callCallee == "ImportedPair" &&
               stmt.resultType == "int32":
                importedCallLetCalls = importedCallLetCalls + 1

    let contractOk = parenRows == 1 && parenLocalDecls == 1 &&
                     bracedRows == 1 && bracedLocalDecls == 1 &&
                     nestedRows == 1 && nestedLocalDecls == 1 &&
                     sameNameCtorRows == 1 && sameNameCtorLocalDecls == 1 &&
                     importedCtorRows == 1 && importedCtorLocalDecls == 1 &&
                     namedLetCalls == 1 && sameNameCallLetCalls == 1 &&
                     importedCallLetCalls == 1 && plainLetCalls == 1
    texpr.TypedExprIrReleasePayload(ir)
    texpr.TypedExprFactTableRelease(facts)
    parser.NormalizedExprLayerReset(factsLayer)
    parser.NormalizedExprLayerReset(layer)
    for contextIndex in 0..<contexts.len:
        texpr.TypedExprClearSourceContextAllFields(contexts[contextIndex])
    if !contractOk:
        return 14
    return 0
