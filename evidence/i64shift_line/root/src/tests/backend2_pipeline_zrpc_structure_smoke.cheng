import cheng/core/backend2/backend2_pipeline as pipeline
import cheng/core/backend2/backend2_assemble as assemble
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/lang/intern as langintern
import std/result

fn main(): int32 =
    var lowering: lower.LoweringPlanStub
    lowering.typedIr.internPool = langintern.InternPoolNew()
    defer:
        langintern.InternPoolRelease(lowering.typedIr.internPool)

    let sourcePath = "src/tests/backend2_pipeline_zrpc_structure_smoke.cheng"
    let scalarTypeId = langintern.Intern(
        lowering.typedIr.internPool, "int32")
    let unaryNameId = langintern.Intern(
        lowering.typedIr.internPool, "整数加一")
    let binaryNameId = langintern.Intern(
        lowering.typedIr.internPool, "整数相加")
    let sourcePathId = langintern.Intern(
        lowering.typedIr.internPool, sourcePath)
    add(lowering.typedIr.functions2_functionNameIds, unaryNameId)
    add(lowering.typedIr.functions2_functionNameIds, binaryNameId)
    add(lowering.typedIr.functions2_sourcePathIds, sourcePathId)
    add(lowering.typedIr.functions2_sourcePathIds, sourcePathId)
    add(lowering.typedIr.functions2_returnTypeIds, scalarTypeId)
    add(lowering.typedIr.functions2_returnTypeIds, scalarTypeId)

    var unaryCallee: lower.PrimaryObjectIrFunction
    unaryCallee.functionName = "整数加一"
    unaryCallee.sourcePath = share(sourcePath)
    unaryCallee.typedFunctionIndex = 0
    add(unaryCallee.paramTypes, "int32")
    add(lowering.primaryObjectIr.functions, unaryCallee)

    var binaryCallee: lower.PrimaryObjectIrFunction
    binaryCallee.functionName = "整数相加"
    binaryCallee.sourcePath = share(sourcePath)
    binaryCallee.typedFunctionIndex = 1
    add(binaryCallee.paramTypes, "int32")
    add(binaryCallee.paramTypes, "int32")
    add(lowering.primaryObjectIr.functions, binaryCallee)

    var caller: lower.PrimaryObjectIrFunction
    caller.functionName = "zrpc_structure_caller"
    caller.typedFunctionIndex = 2
    add(caller.callTargets, "整数加一")
    add(caller.callTargetSourcePaths, share(sourcePath))
    add(caller.callTargetImportcFlags, false)
    add(caller.callImportcSymbols, "")
    add(caller.callTargetTypedFunctionIndexes, 0)
    add(caller.callTargets, "整数相加")
    add(caller.callTargetSourcePaths, share(sourcePath))
    add(caller.callTargetImportcFlags, false)
    add(caller.callImportcSymbols, "")
    add(caller.callTargetTypedFunctionIndexes, 1)
    let views = pipeline.Backend2CalleeAbiViewsForFunction(
        lowering, caller)
    let unaryNameRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.functions2_functionNameIds[
            caller.callTargetTypedFunctionIndexes[0]])
    let binaryNameRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.functions2_functionNameIds[
            caller.callTargetTypedFunctionIndexes[1]])
    let unaryReturnRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.functions2_returnTypeIds[
            caller.callTargetTypedFunctionIndexes[0]])
    let binaryReturnRes: Result[str] = langintern.LookupIntern(
        lowering.typedIr.internPool,
        lowering.typedIr.functions2_returnTypeIds[
            caller.callTargetTypedFunctionIndexes[1]])
    if !IsOk(unaryNameRes) || !IsOk(binaryNameRes) ||
       !IsOk(unaryReturnRes) || !IsOk(binaryReturnRes) ||
       views.len != 2 ||
       caller.callTargetTypedFunctionIndexes.len != 2 ||
       caller.callTargetTypedFunctionIndexes[0] != 0 ||
       caller.callTargetTypedFunctionIndexes[1] != 1 ||
       lowering.primaryObjectIr.functions[0].typedFunctionIndex != 0 ||
       lowering.primaryObjectIr.functions[1].typedFunctionIndex != 1 ||
       views[0].functionName != Value(unaryNameRes) ||
       views[0].returnType != Value(unaryReturnRes) ||
       views[0].paramTypes.len != 1 ||
       views[0].paramTypes[0] != "int32" ||
       views[1].functionName != Value(binaryNameRes) ||
       views[1].returnType != Value(binaryReturnRes) ||
       views[1].paramTypes.len != 2 ||
       views[1].paramTypes[0] != "int32" ||
       views[1].paramTypes[1] != "int32":
        return 2
    # lowering identity columns are indexed by lowering row, not by the
    # potentially sparse/shuffled TypedExpr function index.  Row 1 is the
    # entry while its typed index is 0; the old flags[typedIndex] lookup reads
    # row 0 and rejects this valid identity.
    lowering.primaryObjectIr.functions[0].functionName = "整数相加"
    lowering.primaryObjectIr.functions[0].typedFunctionIndex = 1
    lowering.primaryObjectIr.functions[1].functionName = "整数加一"
    lowering.primaryObjectIr.functions[1].typedFunctionIndex = 0
    add(lowering.functionNames, "整数相加")
    add(lowering.functionNames, "整数加一")
    add(lowering.functionNameIds, binaryNameId)
    add(lowering.functionNameIds, unaryNameId)
    add(lowering.functionTypedIrIndexes, 1)
    add(lowering.functionTypedIrIndexes, 0)
    add(lowering.functionEntryFlags, 0)
    add(lowering.functionEntryFlags, 1)
    if !pipeline.Backend2EntryFunctionRowIdentityValid(
           lowering, 1, 0) ||
       pipeline.Backend2EntryFunctionRowIdentityValid(
           lowering, 0, 0):
        return 3
    lowering.functionEntryFlags[1] = 0
    if pipeline.Backend2EntryFunctionRowIdentityValid(
           lowering, 1, 0):
        return 4
    lowering.functionEntryFlags[1] = 1
    lowering.functionNameIds[1] = binaryNameId
    if pipeline.Backend2EntryFunctionRowIdentityValid(
           lowering, 1, 0):
        return 5
    lowering.functionNameIds[1] = unaryNameId
    if assemble.Backend2SymbolRoleForFunctionRow(9, 9) !=
           pobj.PrimaryObjectSymbolRoleSourceEntry ||
       assemble.Backend2SymbolRoleForFunctionRow(4, 9) !=
           pobj.PrimaryObjectSymbolRoleTypedName ||
       !pipeline.Backend2PoolManagedSequenceMoveContract():
        return 6
    let receipt = pipeline.Backend2FunctionReceiptNew(
        0, 0, 0, 0, 0, 0, 0, 0)
    if !pipeline.Backend2FunctionReceiptValid(receipt):
        return 1
    return 0
