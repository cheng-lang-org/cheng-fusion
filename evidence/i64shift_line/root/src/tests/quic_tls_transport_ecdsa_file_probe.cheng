import std/system
import std/result
import std/strutils as strutil
import std/rawbytes
import std/os
import std/crypto/ecnist
import std/tls/x509

fn main(): int32 =
    let leafPath = "artifacts/vpn-proxy-local/transport.cert.der"
    let rootPath = "artifacts/vpn-proxy-local/transport.root.der"
    let leafRes: Result[Bytes] = os.ReadFileBytesResult(leafPath)
    if IsErr(leafRes):
        echo(strutil.Join(["ecdsa file probe: leaf read err=", ErrorText(leafRes)], ""))
        return 1
    let rootRes: Result[Bytes] = os.ReadFileBytesResult(rootPath)
    if IsErr(rootRes):
        echo(strutil.Join(["ecdsa file probe: root read err=", ErrorText(rootRes)], ""))
        return 1
    var leaf: x509.X509Certificate = x509.initX509Certificate()
    let leafParseRes: Result[bool] = x509.x509ParseCertificateInto(leaf, Value(leafRes))
    if IsErr(leafParseRes):
        echo(strutil.Join(["ecdsa file probe: leaf parse err=", ErrorText(leafParseRes)], ""))
        return 1
    var root: x509.X509Certificate = x509.initX509Certificate()
    let rootParseRes: Result[bool] = x509.x509ParseCertificateInto(root, Value(rootRes))
    if IsErr(rootParseRes):
        echo(strutil.Join(["ecdsa file probe: root parse err=", ErrorText(rootParseRes)], ""))
        return 1
    let rawSigRes: Result[Bytes] = x509.x509DecodeEcdsaSignature(leaf.signature)
    if IsErr(rawSigRes):
        echo(strutil.Join(["ecdsa file probe: sig decode err=", ErrorText(rawSigRes)], ""))
        return 1
    if ! ecnist.ecdsaVerifyTrustedBytes(root.publicKey.ecdsaBytes, leaf.tbs, Value(rawSigRes)):
        echo("ecdsa file probe: direct cert verify false")
        return 1
    let sigRes: Result[bool] = x509.x509VerifySignature(leaf, root)
    if IsErr(sigRes):
        echo(strutil.Join(["ecdsa file probe: x509 sig err=", ErrorText(sigRes)], ""))
        return 1
    if ! Value(sigRes):
        echo("ecdsa file probe: x509 sig false")
        return 1
    var roots: x509.X509CertList = x509.initX509CertList()
    let addRootRes: Result[bool] = x509.x509CertListAddDer(roots, Value(rootRes))
    if IsErr(addRootRes):
        echo(strutil.Join(["ecdsa file probe: root add err=", ErrorText(addRootRes)], ""))
        return 1
    var intermediates: x509.X509CertList = x509.initX509CertList()
    let chainRes: Result[bool] = x509.x509VerifyChain(leaf, intermediates, roots, 1800000000)
    if IsErr(chainRes):
        echo(strutil.Join(["ecdsa file probe: chain err=", ErrorText(chainRes)], ""))
        return 1
    if ! Value(chainRes):
        echo("ecdsa file probe: chain false")
        return 1
    echo("quic_tls_transport_ecdsa_file_probe ok")
    return 0
