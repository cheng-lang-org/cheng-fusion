import cheng/core/runtime/web_scene_runtime as scene

fn main(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneApplyMediaSelectionPayload(graph, "content", "/tmp/unimaker-test-video.mp4"):
        echo("web_scene_media_display_names_smoke fail apply path")
        return 1
    if scene.WebSceneStateValueForRef(graph, "mediaFiles") != "[\"/tmp/unimaker-test-video.mp4\"]":
        echo("web_scene_media_display_names_smoke fail mediaFiles")
        return 2
    if scene.WebSceneStateValueForRef(graph, "mediaDisplayNames") != "[\"\"]":
        echo("web_scene_media_display_names_smoke fail nameless slot")
        return 3
    if !scene.WebSceneApplyEventEffect(graph, "string_array_remove_index:mediaFiles:0", true):
        echo("web_scene_media_display_names_smoke fail remove files")
        return 4
    if !scene.WebSceneApplyEventEffect(graph, "string_array_remove_index:mediaDisplayNames:0", true):
        echo("web_scene_media_display_names_smoke fail remove names")
        return 5
    if scene.WebSceneStateValueForRef(graph, "mediaFiles") != "[]":
        echo("web_scene_media_display_names_smoke fail files after remove")
        return 6
    if scene.WebSceneStateValueForRef(graph, "mediaDisplayNames") != "[]":
        echo("web_scene_media_display_names_smoke fail names after remove")
        return 7
    if scene.WebSceneApplyMediaSelectionPayload(graph, "graphic", "{\"displayName\":\"clip.png\"}"):
        echo("web_scene_media_display_names_smoke fail nameless json without file")
        return 8
    if scene.WebSceneStateValueForRef(graph, "mediaFiles") != "[]":
        echo("web_scene_media_display_names_smoke fail json without file must not write mediaFiles")
        return 9
    if !scene.WebSceneApplyMediaSelectionPayload(graph, "graphic", "{\"uri\":\"content://x\",\"displayName\":\"a.mp4\"}"):
        echo("web_scene_media_display_names_smoke fail apply uri json")
        return 10
    if scene.WebSceneStateValueForRef(graph, "mediaFiles") != "[\"content://x\"]":
        echo("web_scene_media_display_names_smoke fail uri mediaFiles")
        return 11
    if scene.WebSceneStateValueForRef(graph, "mediaDisplayNames") != "[\"a.mp4\"]":
        echo("web_scene_media_display_names_smoke fail uri displayName")
        return 12
    if !scene.WebSceneApplyMediaSelectionPayload(graph, "graphic", "{\"path\":\"/tmp/b.jpg\",\"name\":\"shot.jpg\"}"):
        echo("web_scene_media_display_names_smoke fail apply name field")
        return 13
    if scene.WebSceneStateValueForRef(graph, "mediaFiles") != "[\"content://x\",\"/tmp/b.jpg\"]":
        echo("web_scene_media_display_names_smoke fail path mediaFiles append")
        return 14
    if scene.WebSceneStateValueForRef(graph, "mediaDisplayNames") != "[\"a.mp4\",\"shot.jpg\"]":
        echo("web_scene_media_display_names_smoke fail name field append")
        return 15
    echo("web_scene_media_display_names_smoke ok")
    return 0
