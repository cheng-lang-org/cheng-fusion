# CSG 资产管线 C1 冒烟: GLB 容器/JSON/accessor/场景对真实样例的精确断言。
# 真值来源: fixtures/glb 生成器同源输出 (python 独立提取, 见 fixtures.md)。
# 用法: csg_asset_c1_smoke <fixturesDir>
import std/cmdline
import std/strings
import std/json
import std/rawbytes
import cheng/game/assets/import/reader
import cheng/game/assets/import/gltf/glb
import cheng/game/assets/import/gltf/accessor
import cheng/game/assets/import/gltf/scene
import cheng/game/assets/import/normalize

fn approxEq(a: float64, b: float64, eps: float64): bool =
    var d = a - b
    if d < 0.0:
        d = 0.0 - d
    return d < eps

@borrows
fn checkStaticBox(dir: str) =
    let path = Fmt"{dir}/glb/static_box.glb"
    var bounds = reader.AssetReaderBoundsFor("glb")
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(path, bounds, data), "glb loaded")
    assert(int64(rawbytes.BytesLen(data)) == int64(2164), "glb size")

    var container: glb.AssetGlbContainer
    var err: str
    assert(glb.AssetGlbParse(data, container, err), "glb container: {err}")
    assert(container.version == 2, "glb version 2")
    assert(container.binOffset == int64(1324), "glb bin offset")
    assert(container.binLength == int64(840), "glb bin length")
    # accessor 偏移是 BIN 相对: 切出 BIN 载荷再读。
    var binData = rawbytes.BytesSlice(data, int32(container.binOffset), int32(container.binLength))

    let root = glb.AssetGltfParseJson(container, err)
    assert(root.kind == json.JObject, "gltf json root")
    assert(glb.AssetGltfAssetVersionOk(root, err), "gltf asset version")
    assert(glb.AssetGltfCheckRequiredExtensions(root, err),
        "gltf no required extensions")

    var sc: scene.AssetGltfScene
    assert(scene.AssetGltfParseMeshes(root, sc, err), "meshes parse: {err}")
    assert(sc.meshes.len == 1, "one mesh")
    assert(sc.meshes[0].name == "Box", "mesh name")
    assert(sc.meshes[0].positionAccessor == 0, "position accessor")
    assert(sc.meshes[0].normalAccessor == 1, "normal accessor")
    assert(sc.meshes[0].texcoordAccessor == 2, "texcoord accessor")
    assert(sc.meshes[0].indicesAccessor == 3, "indices accessor")
    assert(sc.meshes[0].materialIndex == 0, "material index")

    assert(scene.AssetGltfParseMaterials(root, sc, err), "materials parse")
    assert(sc.materials.len == 1, "one material")
    assert(sc.materials[0].name == "Matte", "material name")
    assert(approxEq(sc.materials[0].baseColorR, 0.8, 0.000001), "baseColor R")
    assert(approxEq(sc.materials[0].baseColorG, 0.2, 0.000001), "baseColor G")
    assert(approxEq(sc.materials[0].baseColorB, 0.1, 0.000001), "baseColor B")
    assert(approxEq(sc.materials[0].baseColorA, 1.0, 0.000001), "baseColor A")
    assert(approxEq(sc.materials[0].metallic, 0.0, 0.000001), "metallic 0")
    assert(approxEq(sc.materials[0].roughness, 0.9, 0.000001), "roughness 0.9")

    assert(scene.AssetGltfParseCameras(root, sc, err), "cameras parse")
    assert(sc.cameras.len == 1, "one camera")
    assert(sc.cameras[0].name == "MainCam", "camera name")
    assert(approxEq(sc.cameras[0].yfov, 0.9272952, 0.000001), "yfov")
    assert(approxEq(sc.cameras[0].aspectRatio, 1.7777778, 0.000001), "aspect")
    assert(approxEq(sc.cameras[0].znear, 0.1, 0.000001), "znear")
    assert(approxEq(sc.cameras[0].zfar, 100.0, 0.000001), "zfar")

    assert(scene.AssetGltfParseNodes(root, sc, err), "nodes parse: {err}")
    assert(sc.nodes.len == 3, "three nodes")
    assert(scene.AssetGltfAssembleScene(root, sc, err), "scene assemble: {err}")
    assert(sc.rootNodes.len == 1 && sc.rootNodes[0] == 0, "root is node 0")
    assert(sc.nodes[0].children.len == 2, "root two children")
    assert(sc.nodes[0].children[0] == 1 && sc.nodes[0].children[1] == 2,
        "children order")
    assert(sc.nodes[1].meshIndex == 0, "BoxA mesh")
    assert(approxEq(sc.nodes[1].trs.t.x, -1.5, 0.000001), "BoxA tx")
    assert(sc.nodes[2].meshIndex == 0, "BoxB mesh")
    assert(approxEq(sc.nodes[2].trs.sx, 2.0, 0.000001), "BoxB sx non-uniform")
    assert(approxEq(sc.nodes[2].trs.sy, 0.5, 0.000001), "BoxB sy")
    let m2 = scene.AssetGltfNodeLocalMatrix(sc.nodes[2])
    assert(normalize.AssetMatMirrored(m2) == false, "BoxB not mirrored")

    # accessor: POSITION 24 顶点, 首顶点 (-0.5,-0.5,0.5); min/max 齐备。
    var pos = accessor.AssetGltfReadF64(root, binData, container.binLength, 0, err)
    assert(err == "" && pos.len == 72, Fmt"positions: {err}")
    assert(pos.len == 72, "24 vertices * 3")
    assert(approxEq(pos[0], -0.5, 0.000001), "v0 x")
    assert(approxEq(pos[1], -0.5, 0.000001), "v0 y")
    assert(approxEq(pos[2], 0.5, 0.000001), "v0 z")
    var accRef: accessor.AssetGltfAccessorRef
    assert(accessor.AssetGltfResolveAccessor(root, container.binLength, 0, accRef, err),
        "resolve position accessor: {err}")
    assert(accRef.minVals.len == 3 && accRef.maxVals.len == 3, "position bounds present")
    assert(approxEq(accRef.minVals[0], -0.5, 0.000001), "bounds min x")

    # 索引: 36 个, 顶点引用全部在界内 (环/悬垂检测)。
    var idx = accessor.AssetGltfReadIndices(root, binData, container.binLength, 3, err)
    assert(err == "" && idx.len == 36, Fmt"indices: {err}")
    assert(idx.len == 36, "36 indices")
    assert(accessor.AssetGltfIndicesInRangeF(idx, 24), "indices in vertex range")
    assert(idx[0] == 0.0 && idx[1] == 1.0 && idx[2] == 2.0, "first triangle order")

    # 确定性: 重读同文件同值。
    var pos2 = accessor.AssetGltfReadF64(root, binData, container.binLength, 0, err)
    assert(err == "", Fmt"reread: {err}")
    assert(pos2.len == pos.len, "reread length")
    var same: bool = true
    for i in 0..<pos.len:
        if pos2[i] != pos[i]:
            same = false
    assert(same, "reread identical")
    rawbytes.BytesFree(binData)
    rawbytes.BytesFree(data)

@borrows
fn checkSkinStructure(dir: str) =
    let path = Fmt"{dir}/glb/skin_anim.glb"
    var bounds = reader.AssetReaderBoundsFor("glb")
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(path, bounds, data), "skin glb loaded")
    var container: glb.AssetGlbContainer
    var err: str
    assert(glb.AssetGlbParse(data, container, err), "skin container")
    let root = glb.AssetGltfParseJson(container, err)
    assert(root.kind == json.JObject, "skin json root")
    var skinBin = rawbytes.BytesSlice(data, int32(container.binOffset), int32(container.binLength))
    var sc: scene.AssetGltfScene
    assert(scene.AssetGltfParseMeshes(root, sc, err), "skin mesh parse")
    assert(sc.meshes[0].positionAccessor == 0, "skin position accessor")
    assert(sc.meshes[0].indicesAccessor == 3, "skin indices accessor")
    assert(scene.AssetGltfParseNodes(root, sc, err), "skin nodes parse")
    assert(sc.nodes.len == 4, "skin four nodes (3 joints + mesh)")
    assert(sc.nodes[3].meshIndex == 0, "SkinMesh mesh")
    assert(sc.nodes[3].skinIndex == 0, "SkinMesh skin ref")
    assert(scene.AssetGltfAssembleScene(root, sc, err), "skin scene assemble")
    assert(sc.rootNodes.len == 2, "skin two roots (armature + mesh)")
    # JOINTS_0: VEC4 5121, 8 顶点。
    var jref: accessor.AssetGltfAccessorRef
    assert(accessor.AssetGltfResolveAccessor(root, container.binLength, 1, jref, err),
        "joints accessor: {err}")
    assert(jref.typeStr == "VEC4" && jref.componentType == 5121, "joints VEC4 ubyte")
    assert(jref.count == 8, "joints count")
    rawbytes.BytesFree(data)

@borrows
fn checkNegatives(dir: str) =
    let path = Fmt"{dir}/glb/static_box.glb"
    var bounds = reader.AssetReaderBoundsFor("glb")
    var data = rawbytes.EmptyBytes()
    assert(reader.AssetReaderLoadBounded(path, bounds, data), "neg load")

    # 坏魔数。
    var bad = rawbytes.BytesSlice(data, 0, rawbytes.BytesLen(data))
    rawbytes.BytesSet(bad, 1, 88)
    var container: glb.AssetGlbContainer
    var err: str
    assert(!glb.AssetGlbParse(bad, container, err), "bad magic rejected")
    rawbytes.BytesFree(bad)

    # 截断: 保留前 30 字节 (头声明长度远超实际)。
    var cut = rawbytes.BytesSlice(data, 0, 30)
    var err2: str
    assert(!glb.AssetGlbParse(cut, container, err2), "truncated rejected")
    rawbytes.BytesFree(cut)
    rawbytes.BytesFree(data)

fn main(): int32 =
    let argc = cmdline.paramCount()
    if argc < 1:
        echo("usage: csg_asset_c1_smoke <fixturesDir>")
        return 2
    let fixturesDir = Fmt"{cmdline.paramStr(1)}"
    checkStaticBox(fixturesDir)
    checkSkinStructure(fixturesDir)
    checkNegatives(fixturesDir)
    echo("csg_asset_c1_smoke PASS")
    return 0
