import cheng/core/ir/phase_arena as phase

fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 32, 2)
    let first = phase.PhaseArenaStoreOpenArena(store, 1, 16, 1)
    phase.PhaseArenaHandleIsValid(first)
    let duplicate = phase.PhaseArenaStoreOpenArena(store, 1, 16, 1)
    return duplicate.arenaId
