import std/system
import std/rawbytes

type
    BytesBox =
        payload: Bytes

    PacketBox =
        payload: Bytes

fn releaseOwnedBytes(data: var Bytes) =
    if data.data != nil:
        memRelease(data.data)
    data = emptyBytes()

fn smokeBytesLocalOverwrite() =
    var payload: Bytes = BytesAlloc(32)
    let oldPtr = payload.data
    assert(memRefCount(oldPtr) == 1, " bytes overwrite orc: local old rc before overwrite")
    payload = BytesAlloc(48)
    assert(memRefCount(oldPtr) == 0, " bytes overwrite orc: local overwrite releases old payload")
    releaseOwnedBytes(payload)

fn smokeBytesFieldOverwrite() =
    var box: BytesBox
    box.payload = BytesAlloc(40)
    let oldPtr = box.payload.data
    assert(memRefCount(oldPtr) == 1, " bytes overwrite orc: field old rc before overwrite")
    box.payload = BytesAlloc(56)
    assert(memRefCount(oldPtr) == 0, " bytes overwrite orc: field overwrite releases old payload")
    if box.payload.data != nil:
        memRelease(box.payload.data)
    box.payload = emptyBytes()

fn smokeParentObjectCopy() =
    var slot: PacketBox
    slot.payload = BytesAlloc(24)
    let oldSlotPtr = slot.payload.data
    assert(memRefCount(oldSlotPtr) == 1, " bytes overwrite orc: slot old rc before copy")

    var rhs: PacketBox
    rhs.payload = BytesAlloc(64)
    BytesSet(rhs.payload, 0, int32('z'))
    let rhsPtr = rhs.payload.data
    assert(memRefCount(rhsPtr) == 1, " bytes overwrite orc: rhs rc before copy")

    slot = rhs
    assert(memRefCount(oldSlotPtr) == 0, " bytes overwrite orc: parent copy releases old payload")
    assert(memRefCount(rhsPtr) == 2, " bytes overwrite orc: parent copy retains new payload")

    rhs.payload = emptyBytes()
    assert(memRefCount(rhsPtr) == 1, " bytes overwrite orc: rhs release leaves slot owner")
    assert(BytesGet(slot.payload, 0) == int32('z'),
           " bytes overwrite orc: slot payload survives rhs release")

    slot.payload = emptyBytes()
    assert(memRefCount(rhsPtr) == 0, " bytes overwrite orc: final slot release closes payload")

fn main(): int32 =
    smokeBytesLocalOverwrite()
    smokeBytesFieldOverwrite()
    smokeParentObjectCopy()
    echo(" bytes_overwrite_orc_smoke ok")
    return 0
