# R8-F: hex integer literals as call args / return / let_call now build I32Const nodes.
# Pre-fix: 0xHEX rejected by TypedExprIrRhsTextIsI32Literal -> arg node fail -> no_node.

fn u32FromBytes(b0: int32, b1: int32, b2: int32, b3: int32): int32 =
    return ((b0 * 256 + b1) * 256 + b2) * 256 + b3

fn returnHexCall(): int32 =
    return u32FromBytes(0xf4, 0x0e, 0x35, 0x85)

fn letHexCall(): int32 =
    let v = u32FromBytes(0x12, 0x34, 0x56, 0x78)
    return v

fn hexConstReturn(): int32 =
    return 0x7F

fn main(): int32 =
    if returnHexCall() != ((244 * 256 + 14) * 256 + 53) * 256 + 133:
        return 1
    if letHexCall() != ((18 * 256 + 52) * 256 + 86) * 256 + 120:
        return 2
    if hexConstReturn() != 127:
        return 3
    return 0
