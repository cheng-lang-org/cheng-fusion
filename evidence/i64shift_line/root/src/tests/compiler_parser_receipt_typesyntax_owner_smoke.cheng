import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_parser_receipt as parser_receipt

fn TypeRoot(
        sidecar: parser_receipt.ParserCanonicalSourceSidecar,
        name: str): int32 =
    for row in 0..<sidecar.typeSyntaxKinds.len:
        if sidecar.typeSyntaxRootKinds[row] ==
               Int32(parser.ParserTypeSyntaxRootFieldDeclaration) ||
           sidecar.typeSyntaxRootKinds[row] ==
               Int32(parser.ParserTypeSyntaxRootTypeDeclarationRhs):
            let ownerToken = sidecar.typeSyntaxOwnerTokenIds[row]
            if ownerToken >= 0 &&
               sidecar.tokenValues[ownerToken] == name:
                return row
    return -1

fn AssertSealRejected(
        candidate: var parser_receipt.ParserCanonicalSourceSidecar,
        label: str) =
    var err: str
    assert(!parser_receipt.ParserCanonicalSourceSidecarSealInto(
               candidate, err),
           Fmt"compiler parser receipt TypeSyntax owner: mutation survived {label}")

fn BuildSidecar(
        source: str,
        path: str): parser_receipt.ParserCanonicalSourceSidecar =
    var declarations: parser.NormalizedFunctionDecl[]
    var err: str
    assert(parser.ParserReadNormalizedFunctionDecls(
               source, declarations, err) &&
           declarations.len == 1,
           Fmt"compiler parser receipt TypeSyntax owner: declarations {err}")
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    add(identities,
        parser_receipt.ParserNormalizedExprFunctionIdentityMake(
            0,
            0,
            path,
            "app/typesyntax_owner",
            "main",
            declarations[0].lineIndex,
            parser.ParserSplitChar(source, '\n').len))
    var sidecar: parser_receipt.ParserCanonicalSourceSidecar
    assert(parser_receipt.ParserCanonicalSourceSidecarBuildFromSourceInto(
               0,
               source,
               false,
               identities,
               declarations,
               sidecar,
               err) &&
           parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err),
           Fmt"compiler parser receipt TypeSyntax owner: positive {err}")
    return sidecar

fn main() =
    let directSource =
        "type Direct[T] = ref object:\n    scalar: int32\n    left: ref object\n    right: ref object\n\nfn main(): int32 =\n    return 0\n"
    let direct =
        BuildSidecar(
            directSource,
            "/workspace/typesyntax_owner_direct.cheng")
    let directRoot = TypeRoot(direct, "Direct")
    let directScalar = TypeRoot(direct, "scalar")
    let directLeft = TypeRoot(direct, "left")
    let directRight = TypeRoot(direct, "right")
    assert(directRoot >= 0 && directScalar >= 0 &&
           directLeft >= 0 && directRight >= 0 &&
           direct.typeSyntaxDeclarationOwnerIds[directRoot] == directRoot &&
           direct.typeSyntaxDeclarationOwnerIds[directScalar] == directRoot &&
           direct.typeSyntaxDeclarationOwnerIds[directLeft] == directRoot &&
           direct.typeSyntaxDeclarationOwnerIds[directRight] == directRoot,
           "compiler parser receipt TypeSyntax owner: direct chain missing")

    var directScalarOwner =
        parser_receipt.ParserCanonicalSourceSidecarClone(direct)
    directScalarOwner.typeSyntaxDeclarationOwnerIds[directRight] =
        directScalar
    AssertSealRejected(directScalarOwner, "direct_scalar_owner")

    var directForwardOwner =
        parser_receipt.ParserCanonicalSourceSidecarClone(direct)
    directForwardOwner.typeSyntaxDeclarationOwnerIds[directLeft] =
        directRight
    AssertSealRejected(directForwardOwner, "direct_forward_owner")

    var directSelfCycle =
        parser_receipt.ParserCanonicalSourceSidecarClone(direct)
    directSelfCycle.typeSyntaxDeclarationOwnerIds[directRight] =
        directRight
    AssertSealRejected(directSelfCycle, "direct_self_cycle")

    var directCrossSource =
        parser_receipt.ParserCanonicalSourceSidecarClone(direct)
    directCrossSource.typeSyntaxSourceIds[directRoot] =
        directCrossSource.typeSyntaxSourceIds[directRoot] + 1
    AssertSealRejected(directCrossSource, "direct_cross_source")

    var directTokenDrift =
        parser_receipt.ParserCanonicalSourceSidecarClone(direct)
    directTokenDrift.typeSyntaxDeclarationOwnerTokenIds[directRight] =
        directTokenDrift.typeSyntaxOwnerTokenIds[directLeft]
    AssertSealRejected(directTokenDrift, "direct_owner_token_drift")

    var directGenericSliceDrift =
        parser_receipt.ParserCanonicalSourceSidecarClone(direct)
    directGenericSliceDrift.typeSyntaxGenericSymbolStarts[directRight] = -1
    directGenericSliceDrift.typeSyntaxGenericSymbolCounts[directRight] = 0
    AssertSealRejected(directGenericSliceDrift, "direct_generic_slice_drift")
    echo("compiler_parser_receipt_typesyntax_owner_direct_mutations=6")

    let source =
        "type Outer[T] = ref object:\n    scalar: int32\n    left: ref object:\n        leftLeaf: int32\n    right: ref object:\n        next: object:\n            leaf: int32\n\nfn main(): int32 =\n    return 0\n"
    let sidecar =
        BuildSidecar(
            source,
            "/workspace/typesyntax_owner_nested.cheng")

    let outer = TypeRoot(sidecar, "Outer")
    let scalar = TypeRoot(sidecar, "scalar")
    let left = TypeRoot(sidecar, "left")
    let leftLeaf = TypeRoot(sidecar, "leftLeaf")
    let right = TypeRoot(sidecar, "right")
    let next = TypeRoot(sidecar, "next")
    let leaf = TypeRoot(sidecar, "leaf")
    assert(outer >= 0 && scalar >= 0 && left >= 0 &&
           leftLeaf >= 0 && right >= 0 && next >= 0 && leaf >= 0 &&
           sidecar.typeSyntaxDeclarationOwnerIds[outer] == outer &&
           sidecar.typeSyntaxDeclarationOwnerIds[scalar] == outer &&
           sidecar.typeSyntaxDeclarationOwnerIds[left] == outer &&
           sidecar.typeSyntaxDeclarationOwnerIds[leftLeaf] == left &&
           sidecar.typeSyntaxDeclarationOwnerIds[right] == outer &&
           sidecar.typeSyntaxDeclarationOwnerIds[next] == right &&
           sidecar.typeSyntaxDeclarationOwnerIds[leaf] == next,
           "compiler parser receipt TypeSyntax owner: immediate chain missing")

    var scalarOwner =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    scalarOwner.typeSyntaxDeclarationOwnerIds[next] = scalar
    AssertSealRejected(scalarOwner, "scalar_owner")

    var siblingOwner =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    siblingOwner.typeSyntaxDeclarationOwnerIds[next] = left
    AssertSealRejected(siblingOwner, "sibling_owner")

    var topLevelOwner =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    topLevelOwner.typeSyntaxDeclarationOwnerIds[next] = outer
    AssertSealRejected(topLevelOwner, "top_level_owner")

    var forwardOwner =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    forwardOwner.typeSyntaxDeclarationOwnerIds[leftLeaf] = right
    AssertSealRejected(forwardOwner, "forward_owner")

    var selfCycle =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    selfCycle.typeSyntaxDeclarationOwnerIds[next] = next
    AssertSealRejected(selfCycle, "self_cycle")

    var crossSource =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    crossSource.typeSyntaxSourceIds[right] =
        crossSource.typeSyntaxSourceIds[right] + 1
    AssertSealRejected(crossSource, "cross_source")

    var tokenDrift =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    tokenDrift.typeSyntaxDeclarationOwnerTokenIds[next] =
        tokenDrift.typeSyntaxOwnerTokenIds[left]
    AssertSealRejected(tokenDrift, "owner_token_drift")

    var genericSliceDrift =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    genericSliceDrift.typeSyntaxGenericSymbolStarts[next] = -1
    genericSliceDrift.typeSyntaxGenericSymbolCounts[next] = 0
    AssertSealRejected(genericSliceDrift, "generic_slice_drift")

    echo("compiler_parser_receipt_typesyntax_owner_positive=1")
    echo("compiler_parser_receipt_typesyntax_owner_mutations=8")
    echo("compiler_parser_receipt_typesyntax_owner_smoke: ok")
