# b4_x64_body_units_dispatch_smoke.cheng — B4 facade dispatch smoke.
# The ten CodegenX64Body* facade slots (codegen_x64_body_units.cheng, the
# shared-format facade primary_object_plan now calls through) must return
# exactly what direct x86_64_body_emit calls return on identically
# constructed bodies, including the var-carrier PrepareStackLayout hop.
# A/B independent bodies guard against a facade that mutates its argument.

import cheng/core/ir/core_types as ir
import cheng/core/backend/x86_64_body_emit as x64
import cheng/core/backend/codegen_x64_body_units as units

fn makeSlot(id: int32,
            typeKind: int32,
            sizeBytes: int32,
            alignBytes: int32,
            parameter: bool,
            paramOrdinal: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "b4_dispatch"
    slot.typeKind = typeKind
    slot.stackOffset = 32 + id * 16
    if parameter:
        slot.stackOffset = 0 - 1 - paramOrdinal
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = ir.BodyPlaceStackValueTag
    return slot

fn appendCompare(body: var ir.BodyIR, conditionKind: int32) =
    var compare: ir.BodyOp
    compare.kind = ir.BodyOpCmpTag
    compare.target = 2
    add(compare.operands, conditionKind)
    add(compare.operands, 0)
    add(compare.operands, 1)
    add(body.ops, compare)

fn buildCmpBody(conditionKind: int32): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeSlot(0, ir.LocalF64Tag, 8, 8, true, 0))
    add(body.localSlots, makeSlot(1, ir.LocalF64Tag, 8, 8, true, 1))
    add(body.localSlots, makeSlot(2, ir.LocalI32Tag, 4, 4, false, -1))
    appendCompare(body, conditionKind)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 2
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn main(): int32 =
    var bodyA = buildCmpBody(ir.BodyCondF64LtTag)
    var bodyB = buildCmpBody(ir.BodyCondF64LtTag)
    # var-carrier layout preparation: facade hop vs direct call
    if !units.CodegenX64BodyPrepareStackLayout(bodyA):
        return 1
    if !x64.X64BodyPrepareStackLayout(bodyB):
        return 2
    if bodyA.x64StackLayoutReady != bodyB.x64StackLayoutReady ||
       bodyA.x64BlockStartReady != bodyB.x64BlockStartReady:
        return 3
    # layout/sizing family: facade vs direct on independently prepared bodies
    let countFacade = units.CodegenX64BodyIrWordCount(bodyA)
    let countDirect = x64.X64BodyIrWordCount(bodyB)
    if countFacade != countDirect:
        return 4
    if countDirect <= 0:
        return 5
    if units.CodegenX64BodyPrologueByteCount(bodyA) !=
       x64.X64BodyPrologueByteCount(bodyB):
        return 6
    if units.CodegenX64BodyOpSizeAt(bodyA, 0) !=
       x64.X64BodyOpSizeAt(bodyB, 0):
        return 7
    if units.CodegenX64BodyTermSize(bodyA, 0) !=
       x64.X64BodyTermSize(bodyB, 0):
        return 8
    # call family on a sentinel CallOp (no indirect result, no args)
    var call: ir.CallOp
    call.targetSymbol = ""
    call.resultSlot = -1
    call.relocWordOffset = -1
    if units.CodegenX64BodyCallRegArgCount(bodyA, call) !=
       x64.X64BodyCallRegArgCount(bodyB, call):
        return 9
    if units.CodegenX64BodyCallStackArgCount(bodyA, call) !=
       x64.X64BodyCallStackArgCount(bodyB, call):
        return 10
    if units.CodegenX64BodyCallStackArgBytes(bodyA, call) !=
       x64.X64BodyCallStackArgBytes(bodyB, call):
        return 11
    if units.CodegenX64BodyCallArgWordCount(bodyA, -1, ir.BodyCallPassStackValueTag) !=
       x64.X64BodyCallArgWordCount(bodyB, -1, ir.BodyCallPassStackValueTag):
        return 12
    # reloc word offset: no call ordinals in the body -> -1 sentinel both paths
    if units.CodegenX64BodyRelocWordOffset(bodyA, 0) !=
       x64.X64BodyRelocWordOffset(bodyB, 0):
        return 13
    echo("b4_x64_body_units_dispatch=pass slots=10 prepare_var=ok")
    return 0
