module cold_linkerless_string_return

import std/strings

fn getGreeting(): str =
    return "hello"

fn getFarewell(): str =
    return "bye"

fn main(): int32 =
    let s = getGreeting()
    if strings.Len(s) != 5:
        return 1
    if s != "hello":
        return 2
    let t = getFarewell()
    if strings.Len(t) != 3:
        return 3
    if t != "bye":
        return 4
    return 0

main()
