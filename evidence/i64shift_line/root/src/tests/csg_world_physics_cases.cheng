# C1 analytic validation cases (contract §4 / acceptance matrix):
#   1. free fall 2.0 s vs z(t) = z0 + v0 t - g t^2/2, budget <= 1 cm
#   2. ground landing e=0: no sink beyond 5 mm, velocity quelled
#   3. rope hang under load: segment stretch settles <= 5 mm
#   4. small-angle rope pendulum: stays on the sphere, bounded energy
#   5. support removal: grasp lost -> body falls ballistically
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/rope3d
import cheng/game/csg/numerics
import std/math as m
import std/strings as strings

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# case 1: engine free fall vs analytic
fn caseFreeFall(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(11))
    let _b = World3dSpawnBody(w, 0.0, 0.0, 10.0, 1.0, 0.05, world3d.World3dBodyDynamic)
    var peakErr: float64 = 0.0
    var z: float64 = 10.0
    var v: float64 = 0.0
    var t: float64 = 0.0
    var i: int32 = 0
    while i < 250:
        var r = physics3d.Physics3dStep(w, "case:freefall")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL freefall step rejected")
            return false
        z = w.bodyPz[0]
        v = w.bodyVz[0]
        t = t + (1.0 / 240.0)
        let analytic = 10.0 - 0.5 * physics3d.Physics3dGravity * t * t
        let err = m.absFloat(z - analytic)
        if (i == 1) || (i == 60) || (i == 120) || (i == 200) || (i == 249):
            echo("ff i=" + strings.IntToStr(i) + " z_mm=" + fmtMm(z * 1000.0) + " an_mm=" + fmtMm(analytic * 1000.0) + " err_mm=" + fmtMm(err * 1000.0))
        if err > peakErr:
            peakErr = err
        i = i + 1
    echo("case freefall peakErr_mm=" + fmtMm(peakErr * 1000.0))
    if peakErr > 0.01:
        return false
    return true

# case 2: landing e=0
fn caseLanding(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(12))
    let _b = World3dSpawnBody(w, 0.0, 0.0, 2.0, 1.0, 0.05, world3d.World3dBodyDynamic)
    var i: int32 = 0
    while i < 600:
        var r = physics3d.Physics3dStep(w, "case:landing")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL landing step rejected")
            return false
        i = i + 1
    let z = w.bodyPz[0]
    let vz = w.bodyVz[0]
    let sinkMm = m.absFloat(0.05 - z) * 1000.0
    echo("case landing rest_z_mm=" + fmtMm(z * 1000.0) + " sink_mm=" + fmtMm(sinkMm) + " vz=" + fmtMm(vz))
    if sinkMm > 5.0:
        return false
    if m.absFloat(vz) > 0.05:
        return false
    return true

# case 3: rope hang under load
fn caseRopeHang(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(13))
    var spec: rope3d.Rope3dSpec
    spec.nodeCount = 6
    spec.nodeMassKg = 1.0
    spec.segmentLenM = 0.25
    spec.renderRadiusM = 0.015
    spec.anchorX = 0.0
    spec.anchorY = 0.0
    spec.anchorZ = 3.0
    let _lowest = rope3d.Rope3dBuild(w, spec)
    let load = World3dSpawnBody(w, 0.0, 0.0, 1.4, 20.0, 0.05, world3d.World3dBodyDynamic)
    let _ci = World3dAddConstraint(w, _lowest, load, 0.25, world3d.World3dConRopeSegment)
    var i: int32 = 0
    while i < 960:
        var r = physics3d.Physics3dStep(w, "case:ropehang")
        if r.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL ropehang step rejected")
            return false
        i = i + 1
    var maxStretch: float64 = 0.0
    var ci: int32 = 0
    while ci < w.conCount:
        let aS = w.conA[ci]
        let bS = w.conB[ci]
        let dx = w.bodyPx[bS] - w.bodyPx[aS]
        let dy = w.bodyPy[bS] - w.bodyPy[aS]
        let dz = w.bodyPz[bS] - w.bodyPz[aS]
        let d = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
        let s = m.absFloat(d - w.conRest[ci])
        if s > maxStretch:
            maxStretch = s
        ci = ci + 1
    echo("case ropehang maxStretch_mm=" + fmtMm(maxStretch * 1000.0))
    if maxStretch > 0.005:
        return false
    return true

# case 4: small-angle pendulum on a rope segment
fn casePendulum(): bool =
    var w: world3d.World3d
    World3dReset(w, int64(14))
    var spec: rope3d.Rope3dSpec
    spec.nodeCount = 2
    spec.nodeMassKg = 0.5
    spec.segmentLenM = 0.3
    spec.renderRadiusM = 0.015
    spec.anchorX = 0.0
    spec.anchorY = 0.0
    spec.anchorZ = 2.5
    let _lowest = rope3d.Rope3dBuild(w, spec)
    let bob = World3dSpawnBody(w, 0.05, 0.0, 1.9 - 0.598, 2.0, 0.05, world3d.World3dBodyDynamic)
    let _ci = World3dAddConstraint(w, _lowest, bob, 0.6, world3d.World3dConRopeSegment)
    var i: int32 = 0
    var ok: bool = true
    while i < 720:
        var r = physics3d.Physics3dStep(w, "case:pendulum")
        if r.statusCode != physics3d.Physics3dStatusOk:
            ok = false
            break
        let dx = w.bodyPx[bob] - w.bodyPx[_lowest]
        let dz = w.bodyPz[bob] - w.bodyPz[_lowest]
        let d = numerics.CsgSqrt(dx * dx + dz * dz)
        let stretch = m.absFloat(d - 0.6) * 1000.0
        if stretch > 5.0:
            ok = false
            break
        i = i + 1
    echo("case pendulum onSphere=" + fmtMm(1.0) + " ok=" + fmtMm(2.0))
    return ok

fn main(): int32 =
    if !caseFreeFall():
        echo("FAIL caseFreeFall")
        return 1
    if !caseLanding():
        echo("FAIL caseLanding")
        return 1
    if !caseRopeHang():
        echo("FAIL caseRopeHang")
        return 1
    if !casePendulum():
        echo("FAIL casePendulum")
        return 1
    echo("PASS csg world physics cases")
    return 0
