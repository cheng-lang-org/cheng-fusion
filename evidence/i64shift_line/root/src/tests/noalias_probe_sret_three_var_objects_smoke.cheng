type
    ProbeBox =
        a: int32
        b: int32
        c: int32
        d: int32
        e: int32
        f: int32

fn ProbeSretThreeVars(a: var ProbeBox,
                      b: var ProbeBox,
                      c: var ProbeBox): ProbeBox =
    a.a = 1
    b.b = 2
    c.c = 3
    var out = a
    out.f = 77
    return out

fn main(): int32 =
    var a: ProbeBox
    var b: ProbeBox
    var c: ProbeBox
    let out = ProbeSretThreeVars(a, b, c)
    if a.a != 1:
        return 61
    if b.b != 2:
        return 62
    if c.c != 3:
        return 63
    if out.f != 77:
        return 64
    return out.f
