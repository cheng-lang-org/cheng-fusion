import std/system
import std/result
import std/strutils as strutil
import cheng/libp2p/identity/did

# W3C DID document 组装原语黄金向量（三端同构，与 owner-did.mjs / did.go 一致）。
# SEED_1 = "cheng-did-seed-1-0123456789abcdef"
#
#   DidPublicKeyMultibaseFromSeed → z+base58btc(0xed01‖pub32)
#   DidDocumentSeedFieldsFromSeed → did|genesisCid|peerId|pubMultibase|keyId
#
# 期望值（来自 opc Go / k3 JS 同构实现）：
#   did      = did:cheng:g24585ba18095ebe21d2cd84da7ec8afd2d6979cec3c3402ecad26fb268a60342
#   genesisCid = 24585ba18095ebe21d2cd84da7ec8afd2d6979cec3c3402ecad26fb268a60342
#   peerId   = 12D3KooWLksLpe6ayMePLymXytnULvfje7tuXPDk6AKjkRccJDvc
#   multibase = z6MkqPmDfkmK7zsN3b6p2rzyRE8tyN87uaPcpaseCiRjKVz4
fn main(): int32 =
    let seed = "cheng-did-seed-1-0123456789abcdef"

    # 1) publicKeyMultibase
    let mbRes = did.DidPublicKeyMultibaseFromSeed(seed)
    if IsErr(mbRes):
        return 1
    if Value(mbRes) != "z6MkqPmDfkmK7zsN3b6p2rzyRE8tyN87uaPcpaseCiRjKVz4":
        return 2

    # 2) document seed 字段（did|genesisCid|peerId|pubMultibase|keyId）
    let fieldsRes = did.DidDocumentSeedFieldsFromSeed(seed)
    if IsErr(fieldsRes):
        return 3
    let wantDid = "did:cheng:g24585ba18095ebe21d2cd84da7ec8afd2d6979cec3c3402ecad26fb268a60342"
    let wantCid = "24585ba18095ebe21d2cd84da7ec8afd2d6979cec3c3402ecad26fb268a60342"
    let wantPeer = "12D3KooWLksLpe6ayMePLymXytnULvfje7tuXPDk6AKjkRccJDvc"
    let wantMb = "z6MkqPmDfkmK7zsN3b6p2rzyRE8tyN87uaPcpaseCiRjKVz4"
    let wantFields = strutil.Join([wantDid, "|", wantCid, "|", wantPeer, "|",
        wantMb, "|", wantDid + "#key-1"], "")
    if Value(fieldsRes) != wantFields:
        return 4

    return 0
