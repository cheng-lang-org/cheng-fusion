import std/result
import std/rawbytes
import std/tls/x509 as x509
import std/crypto/rsa as rsa
import cheng/quic/tls/test_pki as pki

fn main(): int32 =
    var leafDer: Bytes
    var keyDer: Bytes
    pki.msquicLocalhostCertDerInto(leafDer)
    pki.msquicLocalhostKeyPkcs8DerInto(keyDer)

    var leaf: x509.X509Certificate = x509.initX509Certificate()
    let parseRes: Result[bool] = x509.x509ParseCertificateInto(leaf, leafDer)
    if IsErr(parseRes):
        panic(ErrorText(parseRes))

    let msg: Bytes = BytesFromString("rsa-pss-self-smoke")
    let sigRes: Result[Bytes] = rsa.rsaBigSignPssBytes(keyDer, msg, false)
    if IsErr(sigRes):
        panic(ErrorText(sigRes))

    let verifyRes: Result[bool] = rsa.rsaVerifyPssBytes(
        leaf.publicKey.rsaN,
        leaf.publicKey.rsaE,
        msg,
        Value(sigRes),
        false
    )
    if IsErr(verifyRes):
        panic(ErrorText(verifyRes))
    assert(Value(verifyRes), " rsa pss self smoke: verify")

    let badMsg: Bytes = BytesFromString("rsa-pss-self-smoke-bad")
    let badVerifyRes: Result[bool] = rsa.rsaVerifyPssBytes(
        leaf.publicKey.rsaN,
        leaf.publicKey.rsaE,
        badMsg,
        Value(sigRes),
        false
    )
    if IsErr(badVerifyRes):
        echo(" rsa_pss_self_smoke ok")
        return 0
    assert(!Value(badVerifyRes), " rsa pss self smoke: reject bad message")

    echo(" rsa_pss_self_smoke ok")
    return 0
