var feederCallCount: int32 = 0

fn Bump(v: int32): int32 =
    feederCallCount = feederCallCount + 1
    return v + 1

fn Take2(a: int32, b: int32): int32 =
    return a + b

fn BareNestedFeeder(x: int32) =
    let _ = Take2(Bump(x), 3)

fn AssignNestedFeeder(x: int32): int32 =
    var y = 0
    y = Take2(Bump(x), 5)
    return y

fn VarStrWrite(out: var str) =
    out = ""

fn VarStrWriteLiteral(out: var str) =
    out = "alpha"

fn VarStrWriteIdent(out: var str, tag: str) =
    out = tag

fn LocalStrReassign(k: int32): str =
    var mode = "init"
    if k == 1:
        mode = "le"
    elif k == 2:
        mode = "be"
    return mode

fn StoreIdxI32(xs: var int32[], i: int32, v: int32) =
    xs[i] = v

fn StoreIdxI64(xs: var int64[], i: int32, v: int64) =
    xs[i] = v

fn StoreIdxStr(xs: var str[], i: int32, v: str) =
    xs[i] = v

fn StoreIdxExpr(xs: var int32[], i: int32, v: int32) =
    xs[i] = v * 2 + 1

fn MutI32(out: var int32) =
    out = out + 10

fn RetCall(x: int32): int32 =
    return Take2(Bump(x), 1)

fn VarIdxArg(xs: var int32[], i: int32) =
    MutI32(xs[i])

fn main(): int32 =
    BareNestedFeeder(1)
    if feederCallCount != 1:
        return 1
    let a = AssignNestedFeeder(2)
    if feederCallCount != 2:
        return 2
    if a != 8:
        return 3
    var s = "zz"
    VarStrWrite(s)
    if len(s) != 0:
        return 4
    VarStrWriteLiteral(s)
    if s != "alpha":
        return 5
    VarStrWriteIdent(s, "tagv")
    if s != "tagv":
        return 6
    if LocalStrReassign(1) != "le":
        return 7
    if LocalStrReassign(2) != "be":
        return 8
    let r = RetCall(3)
    if r != 5:
        return 9
    if feederCallCount != 3:
        return 17
    var q: int32[]
    add(q, 1)
    add(q, 2)
    StoreIdxI32(q, 0, 9)
    if q[0] != 9:
        return 10
    if q[1] != 2:
        return 11
    StoreIdxExpr(q, 1, 5)
    if q[1] != 11:
        return 12
    var w: int64[]
    let seven: int64 = 7
    add(w, seven)
    let answer: int64 = 42
    StoreIdxI64(w, 0, answer)
    if w[0] != 42:
        return 13
    var t: str[]
    add(t, "aa")
    add(t, "bb")
    StoreIdxStr(t, 1, "cc")
    if t[1] != "cc":
        return 14
    if t[0] != "aa":
        return 15
    VarIdxArg(q, 0)
    if q[0] != 19:
        return 16
    return 0
