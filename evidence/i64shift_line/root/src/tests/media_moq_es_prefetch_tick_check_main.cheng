# Runtime verification for S5 (后台顺流预取写入 S4 缓存 + 读路径优先命中缓存, S5 of
# docs/video-seek-scrub-blueprint.md), added to web_scene_media_network_bridge.cheng
# (WebSceneMediaEsPrefetchTick + WebSceneMediaEsStreamLoop's new cache-hit branch). Real
# QUIC client against a real media_moq_publisher_main process serving the real
# hgs_stream ES fixture — no mocked network, no faked cache. The fixture's real GOP
# keyframe indices (0,120,240,360,480,600, count=675 — the same ground truth
# media_moq_es_keyframe_signal_check_main.cheng independently verified against a
# standalone python3 struct.unpack of hgs_stream.moqidx) are the oracle for both the
# frame-count assertion and the per-GOP byte-length assertions below; the byte lengths
# were computed by the SAME independent python parse (sum of each GOP's frame sizes),
# never by this Cheng binary re-deriving its own answer.
#
# Three独立 OS processes drive this file via --mode (mirrors
# media_moq_block_cache_roundtrip_check_main.cheng's cross-process pattern), so the
# S4 cache writes from one process are read back by a genuinely separate process:
#   --mode prefetch       Calls WebSceneMediaEsPrefetchTick repeatedly from the initial
#                          cursor (frame 0, GOP 0 — the GOP about to be played right now,
#                          never a prefetch target by design) and asserts:
#                            1. exactly 5 calls return 1 (one real fetch each, one per
#                               remaining GOP: 120,240,360,480,600 — "hit rate rises");
#                            2. a 6th call returns 2 (window fully covered, no more work —
#                               "hit rate plateaus", not an unbounded puller);
#                            3. each of the 5 cached GOPs' byte length via
#                               WebSceneMediaBlockCacheGet matches the independent oracle
#                               exactly.
#   --mode replay-cached   Seeks the pump cursor to frame 120 (a GOP the prefetch phase
#                          already cached) and runs ONE WebSceneMediaEsStreamLoop() tick.
#                          The desktop sink (host_stub/es_prefetch_test_host_stub.c)
#                          always stops after exactly one delivered frame, so this proves
#                          the cache-hit branch actually delivered frame 120's bytes
#                          straight from disk. The CALLER (the shell harness driving this
#                          binary) diffs the publisher's own "served moq-frame" stderr
#                          line count across this invocation and asserts ZERO growth —
#                          the S4 verify② method ("QUIC 调用计数断言零请求"), applied here
#                          via the publisher's real request log instead of a packet
#                          capture, since both are equally an independent-of-the-bridge
#                          ground truth for "did a network request actually happen".
#   --mode replay-miss     Seeks to frame 0 (GOP 0 — structurally never a prefetch target,
#                          so guaranteed never cached) and runs ONE StreamLoop() tick. The
#                          same sink-stops-after-one-frame contract bounds this to exactly
#                          one network object request, so the caller's log diff must show
#                          EXACTLY +1 "served moq-frame" line — the pre-existing miss path
#                          is provably untouched (still makes real requests, still
#                          delivers real frames), not silently short-circuited.
#
# Any failure prints a reason and exits nonzero; success prints "<MODE>_OK" and exits 0.

import std/os
import std/rawbytes
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/core/runtime/web_scene_media_block_cache as blockcache

@importc("cheng_test_es_sink_first_frame_idx")
fn chengTestEsSinkFirstFrameIdx(): int32

@importc("cheng_test_es_sink_captured")
fn chengTestEsSinkCaptured(): int32

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn runPrefetch(host: str, port: int32, root: str, aheadGops: int32): int32 =
    # Independent-python-oracle ground truth for hgs_stream (see header comment): GOP
    # start frame indices strictly after GOP 0, and each GOP's exact byte span
    # (lastFrameOffset + lastFrameSize - gopStartOffset), in lockstep order.
    var gopIdx: int32[] = [120, 240, 360, 480, 600]
    var gopLen: int32[] = [946127, 939519, 1042431, 1108639, 387279]
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    let assetCid: str = media_bridge.WebSceneMediaEsAssetCid()
    if assetCid.len == 0:
        return fail("asset_cid empty after open")
    let frames: int32 = media_bridge.WebSceneMediaEsFrameCount()
    if frames != 675:
        return fail(strutil.Join(["frame count mismatch: got=", IntToStr(frames), " want=675 (independent oracle)"], ""))
    os.WriteLine(os.Get_stdout(), "step1_open_ok")

    var successCount: int32 = 0
    var attempts: int32 = 0
    while successCount < gopIdx.len && attempts < 10:
        let rc: int32 = media_bridge.WebSceneMediaEsPrefetchTick(aheadGops)
        attempts = attempts + 1
        if rc == 1:
            successCount = successCount + 1
        elif rc == 2:
            return fail(strutil.Join(["PrefetchTick returned 2 (nothing to do) after only ",
                                       IntToStr(successCount), "/", IntToStr(gopIdx.len), " GOPs cached"], ""))
        else:
            return fail(strutil.Join(["PrefetchTick unexpected rc=", IntToStr(rc), " err=", media_bridge.WebSceneMediaEsLastError()], ""))
    if successCount != gopIdx.len:
        return fail(strutil.Join(["only ", IntToStr(successCount), "/", IntToStr(gopIdx.len), " GOPs prefetched within attempt budget"], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step2_prefetched_gops=", IntToStr(successCount)], ""))

    # Window fully covered now — the next tick must report "nothing to do", proving the
    # prefetch loop is bounded (it plateaus instead of pulling unboundedly past the ahead
    # window / past the actually-available GOPs).
    let drainedRc: int32 = media_bridge.WebSceneMediaEsPrefetchTick(aheadGops)
    if drainedRc != 2:
        return fail(strutil.Join(["PrefetchTick after full window returned rc=", IntToStr(drainedRc), " want=2"], ""))
    os.WriteLine(os.Get_stdout(), "step3_window_plateaued_ok")

    var i: int32 = 0
    while i < gopIdx.len:
        let getRes = blockcache.WebSceneMediaBlockCacheGet(assetCid, gopIdx[i])
        if IsErr(getRes):
            return fail(strutil.Join(["cache Get(assetCid, ", IntToStr(gopIdx[i]), ") after prefetch returned Err: ", Error(getRes)], ""))
        let gotLen: int32 = BytesLen(Value(getRes))
        if gotLen != gopLen[i]:
            return fail(strutil.Join(["GOP ", IntToStr(gopIdx[i]), " byte length mismatch: got=", IntToStr(gotLen),
                                       " oracle=", IntToStr(gopLen[i])], ""))
        i = i + 1
    os.WriteLine(os.Get_stdout(), "step4_all_gop_byte_lengths_match_oracle_ok")

    os.WriteLine(os.Get_stdout(), "PREFETCH_OK")
    return 0

# Shared by both replay modes: open, seek to targetFrameIdx, run exactly one StreamLoop
# tick, and print what the desktop sink actually captured (so the shell harness — which
# owns the publisher's log — can decide pass/fail from its own request-count diff).
fn runReplay(host: str, port: int32, root: str, targetFrameIdx: int32, label: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    if !media_bridge.WebSceneMediaEsSeekToFrame(targetFrameIdx):
        return fail("SeekToFrame returned false")
    let cursor: int32 = media_bridge.WebSceneMediaEsPumpCursor()
    if cursor != targetFrameIdx:
        return fail(strutil.Join(["pump cursor mismatch: got=", IntToStr(cursor), " want=", IntToStr(targetFrameIdx)], ""))
    os.WriteLine(os.Get_stdout(), "step1_seek_ok")

    let rc: int32 = media_bridge.WebSceneMediaEsStreamLoop()
    if rc != 0:
        return fail(strutil.Join(["StreamLoop unexpected rc=", IntToStr(rc)], ""))
    if chengTestEsSinkCaptured() != 1:
        return fail(strutil.Join(["sink captured count=", IntToStr(chengTestEsSinkCaptured()), " want=1 (stub stops after one frame)"], ""))
    let gotFrameIdx: int32 = chengTestEsSinkFirstFrameIdx()
    if gotFrameIdx != targetFrameIdx:
        return fail(strutil.Join(["sink delivered frameIdx=", IntToStr(gotFrameIdx), " want=", IntToStr(targetFrameIdx)], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step2_stream_loop_delivered_frame_ok frameIdx=", IntToStr(gotFrameIdx)], ""))

    os.WriteLine(os.Get_stdout(), strutil.Join([label, "_OK"], ""))
    return 0

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    var rootRaw: str
    let hasRoot: bool = cmdline.ReadFirstFlagValue("--root", rootRaw)
    if !hasRoot:
        return fail("missing --root")
    var modeRaw: str
    let hasMode: bool = cmdline.ReadFirstFlagValue("--mode", modeRaw)
    let mode: str = if hasMode: modeRaw else: "prefetch"
    let aheadGops: int32 = cmdline.ReadInt32FlagOrDefault("--ahead-gops", 8)

    if mode == "prefetch":
        return runPrefetch(host, port, rootRaw, aheadGops)
    if mode == "replay-cached":
        return runReplay(host, port, rootRaw, 120, "REPLAY_CACHED")
    if mode == "replay-miss":
        return runReplay(host, port, rootRaw, 0, "REPLAY_MISS")
    return fail(strutil.Join(["unknown --mode: ", mode], ""))
