# W1-ECC pure-Cheng transport campaign: Ed25519 vectors (RFC 8032 section 7.1).
#
# Vector source: RFC 8032 section 7.1 TEST 1, TEST 2, TEST 3 and TEST SHA(abc),
# fetched verbatim from rfc-editor.org, hex hardcoded byte-identical.
#
# Convention note (lessons.md 2026-08-29): this repo's ed25519 module has two
# base-point conventions. epoch 0 = legacy -B world; epoch 1 = RFC 8032 via
# geScalarMultBasePos. RFC vectors are only meaningful under epoch=1, so every
# call below uses the *Epoch entry points (keyPairFromSeedEpoch,
# signEd25519RawEpoch, verifyEd25519Epoch) with epoch=1.
#
# Negatives (must FAIL to verify): single flipped signature bit, wrong
# message, flipped public-key bit. Each uses a fresh BytesFromHex copy so no
# shared-buffer mutation can leak between cases (lessons.md: var b = a shares
# seq/Bytes underlying storage).
#
# Exit code: 0 = all vectors and all negative expectations hold; 1 otherwise.

import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/strings
import cheng/libp2p/crypto/types
import cheng/libp2p/crypto/ed25519/ed25519 as w1ed
import cheng/std/crypto/sha512

var w1eccFailures: int32

# @borrows on the expect helpers: callers pass borrow-views projected out of
# the KeyPair/Result aggregates (kp.value.publicKey.data); an owning param
# would demand a move of a borrowed field = "plain local copy requires an
# address-free value object" (lessons.md: borrow 视图字段禁止 move 进 owned).
@borrows
fn w1eccExpect(got: Bytes, wantHex: str, label: str) =
    if BytesEqual(got, BytesFromHex(wantHex)):
        echo("PASS " + label)
    else:
        w1eccFailures = w1eccFailures + 1
        echo("FAIL " + label + " want=" + wantHex + " got=" + BytesToHex(got))

@borrows
fn w1eccExpectTrue(got: bool, label: str) =
    if got:
        echo("PASS " + label)
    else:
        w1eccFailures = w1eccFailures + 1
        echo("FAIL " + label + " expected true")

@borrows
fn w1eccExpectFalse(got: bool, label: str) =
    if !got:
        echo("PASS " + label)
    else:
        w1eccFailures = w1eccFailures + 1
        echo("FAIL " + label + " expected false")

# One RFC vector: derive pub from seed (epoch=1), sign, verify, then run the
# negative classes (flipped sig bit, wrong message).
# Result/KeyPair consumption follows the fcert_epoch_smoke proven idiom:
# inferred let + .ok/.value field access (a typed let of the managed KeyPair
# aggregate is rejected by the cold typed layer: "plain local copy requires
# an address-free value object").
fn w1eccRunVector(seedHex: str, pubHex: str, msg: Bytes, sigHex: str, tag: str) =
    let seed: Bytes = BytesFromHex(seedHex)
    let kp = w1ed.keyPairFromSeedEpoch(seed, 1)
    if !kp.ok:
        w1eccFailures = w1eccFailures + 1
        echo(strutil.Join(["FAIL ", tag, " keyPairFromSeedEpoch returned Err"], ""))
        return
    let pub: Bytes = kp.value.publicKey.data
    w1eccExpect(pub, pubHex, tag + " public key")

    let priv: Bytes = kp.value.privateKey.data
    let sigRes = w1ed.signEd25519RawEpoch(priv, msg, 1)
    if !sigRes.ok:
        w1eccFailures = w1eccFailures + 1
        echo(strutil.Join(["FAIL ", tag, " sign returned Err"], ""))
        return
    w1eccExpect(sigRes.value, sigHex, tag + " signature")

    let goodSig: Bytes = BytesFromHex(sigHex)
    w1eccExpectTrue(w1ed.verifyEd25519Epoch(pub, msg, goodSig, 1), tag + " verify(good)")

    # Negative: flip one bit in a fresh signature copy.
    let badSig: Bytes = BytesFromHex(sigHex)
    BytesSet(badSig, 10, BytesGet(badSig, 10) ^ 0x01)
    w1eccExpectFalse(w1ed.verifyEd25519Epoch(pub, msg, badSig, 1), tag + " verify(flipped sig bit) must fail")

    # Negative: wrong message ("x" instead of the vector message).
    let wrongMsg: Bytes = BytesFromString("x")
    w1eccExpectFalse(w1ed.verifyEd25519Epoch(pub, wrongMsg, goodSig, 1), tag + " verify(wrong message) must fail")

fn main(): int32 =
    echo("purept_w1ecc_ed25519: RFC 8032 section 7.1 (epoch=1 RFC convention)")

    # TEST 1: empty message
    w1eccRunVector(
        "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
        "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
        EmptyBytes(),
        "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b",
        "test1")

    # TEST 2: 1-byte message 0x72
    w1eccRunVector(
        "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
        "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c",
        BytesFromHex("72"),
        "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00",
        "test2")

    # TEST 3: 2-byte message af82
    w1eccRunVector(
        "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7",
        "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025",
        BytesFromHex("af82"),
        "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a",
        "test3")

    # TEST SHA(abc): message is SHA-512("abc"). Derive the message with this
    # repo's sha512 and require it to equal the RFC-published bytes (cross-
    # family tie-in), then sign/verify like the others.
    let shaAbcMsg: Bytes = sha512.Sha512Digest(BytesFromString("abc"))
    w1eccExpect(shaAbcMsg,
                "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f",
                "sha512(abc) equals RFC 8032 TEST SHA(abc) message")
    w1eccRunVector(
        "833fe62409237b9d62ec77587520911e9a759cec1d19755b7da901b96dca3d42",
        "ec172b93ad5e563bf4932c70e1245034c35467ef2efd4d64ebf819683467e2bf",
        shaAbcMsg,
        "dc2a4459e7369633a52b1bf277839a00201009a3efbf3ecb69bea2186c26b58909351fc9ac90b3ecfdfbc7c66431e0303dca179c138ac17ad9bef1177331a704",
        "shaabc")

    # Negative (TEST 1): flipped public-key bit must fail verification.
    let badPub: Bytes = BytesFromHex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a")
    BytesSet(badPub, 5, BytesGet(badPub, 5) ^ 0x02)
    let goodSig1: Bytes = BytesFromHex("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
    w1eccExpectFalse(w1ed.verifyEd25519Epoch(badPub, EmptyBytes(), goodSig1, 1),
                     "test1 verify(flipped pub bit) must fail")

    echo("purept_w1ecc_ed25519 failures=" + strings.IntToStr(w1eccFailures))
    if w1eccFailures == 0:
        return 0
    return 1
