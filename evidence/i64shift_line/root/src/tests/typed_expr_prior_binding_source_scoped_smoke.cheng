import std/result
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/intern as langintern

# Commit B 前置解扣: TypedExprIrPriorBindingType(Consider) 回退查找过去只按
# (functionName,bindingName,lineNumber) 过滤, sourcePath 字段虽然记在
# statements2_sourcePathIds 里却从不参与比对 —— 同一构建闭包里两个不同
# source 各自声明同名函数+同行号时会跨源错配绑定类型 (docs/beat-c-csge-
# incremental-spec.md §2.2 第4条待核实假设, 已实查证伪: src/core/** 内确有
# 跨文件同名函数, "函数名全局唯一"不成立)。本用例直接夹具两个源的同名
# 撞车记录, 验证修后按 sourcePath 精确隔离。

fn appendDeclStatement(ir: var texpr.TypedExprIr,
                        sourcePath: str,
                        functionName: str,
                        lineNumber: int32,
                        bindingName: str,
                        resultType: str) =
    var stmt: texpr.TypedExprIrStatement
    stmt.sourcePath = sourcePath
    stmt.functionName = functionName
    stmt.lineNumber = lineNumber
    stmt.bindingName = bindingName
    stmt.resultType = resultType
    stmt.kind = texpr.TypedExprIrStmtLocalDecl
    stmt.statementIndex = ir.statements2_statementIndexs.len
    stmt.assignLvalueNodeIndex = -1
    texpr.TypedExprIrAppendStatement(ir, stmt)
    texpr.TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)

fn main(): int32 =
    var ir: texpr.TypedExprIr
    ir.internPool = langintern.InternPoolNew()
    # 源 A 与源 B 各自声明同名函数 Dup, 同行号 10, 同绑定名 v, 类型不同——
    # 索引键 (functionName,bindingName) 不含 sourcePath, 两行落进同一个桶。
    appendDeclStatement(ir, "/fixtures/a.cheng", "Dup", 10, "v", "int32")
    appendDeclStatement(ir, "/fixtures/b.cheng", "Dup", 10, "v", "SmokeStrBox")
    let typeForA = texpr.TypedExprIrPriorBindingType(ir, "/fixtures/a.cheng", "Dup", 11, "v")
    let typeForB = texpr.TypedExprIrPriorBindingType(ir, "/fixtures/b.cheng", "Dup", 11, "v")
    # 正确期望: 各自源查各自类型, 不串源。
    if typeForA != "int32":
        return 1
    if typeForB != "SmokeStrBox":
        return 2
    # 故意错期望(必红): 如果 sourcePath 过滤失效, 后写入的源 B 会盖过源 A
    # (同行 tie-break "候选按插入序推进, 后者不因同行被拒"), 下面两个分支在
    # 缺陷复现时会成立——它们的存在保证本用例不是"怎么都绿"的摆设。
    if typeForA == "SmokeStrBox":
        return 3
    if typeForB == "int32":
        return 4
    return 0
