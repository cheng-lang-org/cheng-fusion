import std/os as os
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/apps/unimaker/innovation_csg as innovation
import cheng/core/csg_asset/oracle_asset as asset
import cheng/core/csg_core/validator as csg
import cheng/core/csg_core/csgc

const
    SymbolGroundingPatentSourceCid = "sha256:0c601cad7aafdcd512aaef21482ef49d5e9761271e2b11a95f07caf403b43e02"
    HumanAiPatentSourceCid = "sha256:d2ecdf6cdd3a2cc4791dcc92de871e7e7a085109df28c0b46bf8befbc31b1465"
    SymbolGroundingPaperSourceCid = "sha256:a703a181c02efee950e8c64afdc5c07bea9a31dc19da147a9367e1b2a0b1dac5"
    HumanAiPaperSourceCid = "sha256:d8d3771b860b67f211abf114751a2dabfd42243595c6a4aa50794f09b8cf9bc7"

fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn smokeExpect(condition: bool, message: str): int32 =
    if !condition:
        return smokeFail(message)
    return 0

@borrows
fn smokeHash(text: str): str =
    return asset.AssetSha256(text)

fn smokeModelCid(): str =
    return smokeHash("test-only quantized embedding algorithm fixture; not a production model")

fn smokeTokenizerCid(): str =
    return smokeHash("test-only tokenizer receipt fixture; no source corpus authority")

fn smokeToolCid(): str =
    return smokeHash("unimaker innovation csg smoke vector producer v1")

fn smokeAddDocument(store: var innovation.InnovationCsgStore,
                    id: str,
                    kind: int32,
                    title: str,
                    sourceCid: str,
                    sourceUri: str): int32 =
    let result = innovation.InnovationAddDocument(
        store,
        innovation.InnovationDocumentInput(
            id: id,
            documentKind: kind,
            externalId: sourceUri,
            titleHash: smokeHash(title),
            sourceCid: sourceCid,
            sourceUri: sourceUri,
            publicationDate: int64(0),
            priorityDate: int64(0),
            jurisdiction: "repository",
            language: "zh-CN",
            licenseHash: smokeHash("repository disclosure policy"),
            semanticStatus: "candidate_unreviewed"))
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.err.msg)
        return -1
    return result.value

fn smokeAddClaim(store: var innovation.InnovationCsgStore,
                 id: str,
                 documentIndex: int32,
                 normalizedClaim: str): int32 =
    let result = innovation.InnovationAddClaim(
        store,
        innovation.InnovationClaimInput(
            id: id,
            documentIndex: documentIndex,
            claimNumber: 1,
            independent: true,
            claimTextHash: smokeHash(normalizedClaim),
            semanticStatus: "candidate_unreviewed"))
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.err.msg)
        return -1
    return result.value

fn smokeAddElement(store: var innovation.InnovationCsgStore,
                   id: str,
                   claimIndex: int32,
                   ordinal: int32,
                   normalizedElement: str,
                   technicalEffect: str): int32 =
    let result = innovation.InnovationAddClaimElement(
        store,
        innovation.InnovationClaimElementInput(
            id: id,
            claimIndex: claimIndex,
            ordinal: ordinal,
            required: true,
            elementTextHash: smokeHash(normalizedElement),
            technicalEffectHash: smokeHash(technicalEffect),
            semanticStatus: "candidate_unreviewed"))
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.err.msg)
        return -1
    return result.value

fn smokeAddContribution(store: var innovation.InnovationCsgStore,
                        id: str,
                        documentIndex: int32,
                        contribution: str,
                        method: str,
                        evidence: str): int32 =
    let result = innovation.InnovationAddPaperContribution(
        store,
        innovation.InnovationPaperContributionInput(
            id: id,
            documentIndex: documentIndex,
            ordinal: 0,
            contributionHash: smokeHash(contribution),
            methodHash: smokeHash(method),
            evidenceHash: smokeHash(evidence),
            semanticStatus: "candidate_unreviewed"))
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.err.msg)
        return -1
    return result.value

fn smokeAddEvidence(store: var innovation.InnovationCsgStore,
                    id: str,
                    ordinal: int32,
                    evidence: str): int32 =
    let result = innovation.InnovationAddProductEvidence(
        store,
        innovation.InnovationProductEvidenceInput(
            id: id,
            productId: "unimaker-csg-runtime",
            ordinal: ordinal,
            evidenceHash: smokeHash(evidence),
            sourceCid: smokeHash("unimaker-csg-runtime-source-snapshot"),
            observedAtMs: int64(1),
            semanticStatus: "candidate_unreviewed"))
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.err.msg)
        return -1
    return result.value

@borrows
fn smokeAddEmbedding(store: var innovation.InnovationCsgStore,
                     id: str,
                     targetKind: int32,
                     targetIndex: int32,
                     values: int32[]): int32 =
    var ownedValues: int32[]
    for i in 0..<values.len:
        add(ownedValues, values[i])
    let result = innovation.InnovationAddEmbedding(
        store,
        innovation.InnovationEmbeddingInput(
            id: id,
            targetKind: targetKind,
            targetIndex: targetIndex,
            modelCid: smokeModelCid(),
            tokenizerCid: smokeTokenizerCid(),
            toolCid: smokeToolCid(),
            normalizationScale: 32767,
            quantization: "q15-signed",
            values: ownedValues))
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.err.msg)
        return -1
    return result.value

fn smokeBuildStore(store: var innovation.InnovationCsgStore): int32 =
    let patentGrounding = smokeAddDocument(
        store,
        "innovation-document:patent-symbol-grounding",
        innovation.InnovationDocumentPatent,
        "CSG符号落地发明专利技术交底书",
        SymbolGroundingPatentSourceCid,
        "docs/patents/csg_symbol_grounding_invention_disclosure.md")
    let patentHumanAi = smokeAddDocument(
        store,
        "innovation-document:patent-human-ai-equivalent",
        innovation.InnovationDocumentPatent,
        "CSG人机等价语义中间表示发明专利技术交底书",
        HumanAiPatentSourceCid,
        "docs/patents/csg_human_ai_equivalent_ir_invention_disclosure.md")
    let paperGrounding = smokeAddDocument(
        store,
        "innovation-document:paper-symbol-grounding",
        innovation.InnovationDocumentPaper,
        "基于CSG的携证工程符号落地方法",
        SymbolGroundingPaperSourceCid,
        "docs/papers/proof_carrying_symbol_grounding_csg_zh.md")
    let paperHumanAi = smokeAddDocument(
        store,
        "innovation-document:paper-human-ai-equivalent",
        innovation.InnovationDocumentPaper,
        "基于CSG的人机等价交互中间表示",
        HumanAiPaperSourceCid,
        "docs/papers/csg_human_ai_equivalent_ir_zh.md")
    if patentGrounding < 0 || patentHumanAi < 0 ||
       paperGrounding < 0 || paperHumanAi < 0:
        return 1

    let groundingClaim = smokeAddClaim(
        store,
        "innovation-claim:patent-symbol-grounding:1",
        patentGrounding,
        "可信观测到唯一现实指称再到确定性执行和效果回执的闭环")
    let humanAiClaim = smokeAddClaim(
        store,
        "innovation-claim:patent-human-ai-equivalent:1",
        patentHumanAi,
        "人类投影与AI类型化动作投影共享同一语义状态和执行路径")
    if groundingClaim < 0 || humanAiClaim < 0:
        return 1

    let groundObservation = smokeAddElement(
        store,
        "innovation-element:grounding:observation",
        groundingClaim, 0,
        "由签名传感器接口预言机或人工确认形成可信观测根",
        "排除未授权或陈旧输入")
    let groundBinding = smokeAddElement(
        store,
        "innovation-element:grounding:binding",
        groundingClaim, 1,
        "将符号意图绑定到可信域内唯一现实对象",
        "排除同类对象误指称")
    let groundReceipt = smokeAddElement(
        store,
        "innovation-element:grounding:receipt",
        groundingClaim, 2,
        "执行器消费准入计划并以新观测生成效果回执",
        "形成可验证因果闭环")
    let humanProjection = smokeAddElement(
        store,
        "innovation-element:human-ai:projection",
        humanAiClaim, 0,
        "同一内容寻址语义状态产生人类和AI投影",
        "消除双重交互语义")
    let humanAction = smokeAddElement(
        store,
        "innovation-element:human-ai:action",
        humanAiClaim, 1,
        "人工输入和AI工具调用归一为同一类型化事件",
        "共享授权和状态转移")
    let humanReceipt = smokeAddElement(
        store,
        "innovation-element:human-ai:receipt",
        humanAiClaim, 2,
        "以前后状态根和规范效果集验证操作等价",
        "提供可审计交互结果")
    if groundObservation < 0 || groundBinding < 0 || groundReceipt < 0 ||
       humanProjection < 0 || humanAction < 0 || humanReceipt < 0:
        return 1

    let paperContributionGround = smokeAddContribution(
        store,
        "innovation-contribution:paper-symbol-grounding:0",
        paperGrounding,
        "携证通用智能体符号落地协议",
        "观测实体意图计划执行回执多根闭环",
        "当前纯Cheng证据验证规范图根和工程绑定内核")
    let paperContributionHumanAi = smokeAddContribution(
        store,
        "innovation-contribution:paper-human-ai-equivalent:0",
        paperHumanAi,
        "人类与AI共享规范语义图中间表示",
        "统一投影事件守卫队列与状态转移",
        "以前后状态根动作CID和规范效果集生成语义回执")
    if paperContributionGround < 0 || paperContributionHumanAi < 0:
        return 1

    let evidenceObservation = smokeAddEvidence(
        store,
        "innovation-evidence:unimaker:observation",
        0,
        "UniMaker运行时生成绑定来源和时效的观察事实")
    let evidenceBinding = smokeAddEvidence(
        store,
        "innovation-evidence:unimaker:binding",
        1,
        "UniMaker运行时以int32精确身份绑定语义对象")
    let evidenceReceipt = smokeAddEvidence(
        store,
        "innovation-evidence:unimaker:receipt",
        2,
        "UniMaker运行时输出绑定计划根和状态根的执行回执")
    if evidenceObservation < 0 || evidenceBinding < 0 || evidenceReceipt < 0:
        return 1

    var vectorGrounding: int32[]
    add(vectorGrounding, 32767)
    add(vectorGrounding, 32767)
    add(vectorGrounding, 0)
    add(vectorGrounding, 0)
    var vectorHumanAi: int32[]
    add(vectorHumanAi, 0)
    add(vectorHumanAi, 0)
    add(vectorHumanAi, 32767)
    add(vectorHumanAi, 32767)
    var axisObservation: int32[]
    add(axisObservation, 32767)
    add(axisObservation, 0)
    add(axisObservation, 0)
    add(axisObservation, 0)
    var axisBinding: int32[]
    add(axisBinding, 0)
    add(axisBinding, 32767)
    add(axisBinding, 0)
    add(axisBinding, 0)
    var axisReceipt: int32[]
    add(axisReceipt, 0)
    add(axisReceipt, 0)
    add(axisReceipt, 32767)
    add(axisReceipt, 0)

    if smokeAddEmbedding(store, "innovation-embedding:doc-patent-grounding",
                         innovation.InnovationTargetDocument,
                         patentGrounding, vectorGrounding) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:doc-patent-human-ai",
                         innovation.InnovationTargetDocument,
                         patentHumanAi, vectorHumanAi) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:doc-paper-grounding",
                         innovation.InnovationTargetDocument,
                         paperGrounding, vectorGrounding) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:doc-paper-human-ai",
                         innovation.InnovationTargetDocument,
                         paperHumanAi, vectorHumanAi) < 0:
        return 1

    if smokeAddEmbedding(store, "innovation-embedding:element-ground-observation",
                         innovation.InnovationTargetClaimElement,
                         groundObservation, axisObservation) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:element-ground-binding",
                         innovation.InnovationTargetClaimElement,
                         groundBinding, axisBinding) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:element-ground-receipt",
                         innovation.InnovationTargetClaimElement,
                         groundReceipt, axisReceipt) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:element-human-projection",
                         innovation.InnovationTargetClaimElement,
                         humanProjection, vectorHumanAi) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:element-human-action",
                         innovation.InnovationTargetClaimElement,
                         humanAction, vectorHumanAi) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:element-human-receipt",
                         innovation.InnovationTargetClaimElement,
                         humanReceipt, vectorHumanAi) < 0:
        return 1

    if smokeAddEmbedding(store, "innovation-embedding:evidence-observation",
                         innovation.InnovationTargetProductEvidence,
                         evidenceObservation, axisObservation) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:evidence-binding",
                         innovation.InnovationTargetProductEvidence,
                         evidenceBinding, axisBinding) < 0 ||
       smokeAddEmbedding(store, "innovation-embedding:evidence-receipt",
                         innovation.InnovationTargetProductEvidence,
                         evidenceReceipt, axisReceipt) < 0:
        return 1
    return 0

fn smokeDuplicateIdRejected(): bool =
    var store: innovation.InnovationCsgStore
    let first = smokeAddDocument(
        store, "innovation-document:duplicate",
        innovation.InnovationDocumentPaper,
        "first", SymbolGroundingPaperSourceCid, "first")
    let second = smokeAddDocument(
        store, "innovation-document:duplicate",
        innovation.InnovationDocumentPaper,
        "second", HumanAiPaperSourceCid, "second")
    if first < 0 || second < 0:
        return false
    let sealed = innovation.InnovationSeal(store)
    return !sealed.ok

fn smokeMutatedVectorRejected(): bool =
    var store: innovation.InnovationCsgStore
    let documentIndex = smokeAddDocument(
        store, "innovation-document:mutated-vector",
        innovation.InnovationDocumentPaper,
        "mutated vector", SymbolGroundingPaperSourceCid, "mutated-vector")
    if documentIndex < 0:
        return false
    var values: int32[]
    add(values, 1)
    add(values, 2)
    if smokeAddEmbedding(
           store, "innovation-embedding:mutated-vector",
           innovation.InnovationTargetDocument,
           documentIndex, values) < 0:
        return false
    store.embeddingValues[0] = 3
    let sealed = innovation.InnovationSeal(store)
    return !sealed.ok

fn main(): int32 =
    var store: innovation.InnovationCsgStore
    if smokeBuildStore(store) != 0:
        return smokeFail("stock innovation corpus build failed")
    let sealed = innovation.InnovationSeal(store)
    if smokeExpect(sealed.ok, "innovation store should seal") != 0:
        if !sealed.ok:
            os.WriteLine(os.Get_stderr(), sealed.err.msg)
        return 1
    if smokeExpect(store.documentIds.len == 4 &&
                   store.claimIds.len == 2 &&
                   store.elementIds.len == 6 &&
                   store.contributionIds.len == 2 &&
                   store.evidenceIds.len == 3 &&
                   store.embeddingIds.len == 13,
                   "innovation SoA row counts mismatch") != 0:
        return 1

    let lines = innovation.InnovationFactsCanonicalLines(store)
    let admission = csg.CsgCoreProductionAdmitFactLines(lines)
    if smokeExpect(admission.valid && admission.complete,
                   "innovation facts should pass strict production admission") != 0:
        os.WriteLine(os.Get_stderr(), csg.CsgCoreValidationReportJson(admission))
        return 1
    if smokeExpect(admission.factCount == lines.len &&
                   admission.profiles.len == 2 &&
                   admission.profiles[0] == csg.CsgCoreBaseProfileIdentity() &&
                   admission.profiles[1] == asset.UnimakerProductDialectProfile,
                   "innovation profile binding mismatch") != 0:
        return 1
    let root = innovation.InnovationFactsRoot(store)
    let rootAgain = innovation.InnovationFactsRoot(store)
    if smokeExpect(root == rootAgain &&
                   innovation.InnovationSha256CidValid(root),
                   "innovation facts root must be deterministic") != 0:
        return 1

    var cargo = innovation.InnovationEncodeCsgc(store)
    if smokeExpect(cargo.ok && rawbytes.BytesLen(cargo.bytes) > 64,
                   "innovation CSGC encode failed") != 0:
        os.WriteLine(os.Get_stderr(), cargo.error)
        return 1
    let decoded = csgc.CsgCoreCsgcDecodeLines(cargo.bytes)
    if smokeExpect(decoded.ok,
                   "innovation CSGC decode failed") != 0:
        if !decoded.ok:
            os.WriteLine(os.Get_stderr(), decoded.error)
        return 1
    let decodedAdmission = csg.CsgCoreProductionAdmitFactLines(decoded.lines)
    if smokeExpect(decodedAdmission.valid &&
                   decodedAdmission.factsRoot == root &&
                   decoded.lines.len == lines.len,
                   "innovation CSGC semantic roundtrip mismatch") != 0:
        return 1
    var cargoAgain = innovation.InnovationEncodeCsgc(store)
    if smokeExpect(cargoAgain.ok &&
                   rawbytes.BytesEqual(cargo.bytes, cargoAgain.bytes),
                   "innovation CSGC repeated bytes must be identical") != 0:
        return 1

    var queryValues: int32[]
    add(queryValues, 32767)
    add(queryValues, 32767)
    add(queryValues, 0)
    add(queryValues, 0)
    let query = innovation.InnovationEmbeddingQuery(
        queryFactCid: smokeHash("query: proof carrying symbol grounding"),
        modelCid: smokeModelCid(),
        tokenizerCid: smokeTokenizerCid(),
        toolCid: smokeToolCid(),
        normalizationScale: 32767,
        quantization: "q15-signed",
        values: queryValues)
    let search = innovation.InnovationSearchByEmbedding(
        store, query, innovation.InnovationTargetDocument)
    if smokeExpect(search.ok && search.result.targetIndexes.len == 4,
                   "innovation latent search failed") != 0:
        os.WriteLine(os.Get_stderr(), search.error)
        return 1
    var otherQuantizationValues: int32[]
    add(otherQuantizationValues, 32767)
    add(otherQuantizationValues, 32767)
    add(otherQuantizationValues, 0)
    add(otherQuantizationValues, 0)
    let otherQuantizationQuery = innovation.InnovationEmbeddingQuery(
        queryFactCid: smokeHash("query: other quantization"),
        modelCid: smokeModelCid(),
        tokenizerCid: smokeTokenizerCid(),
        toolCid: smokeToolCid(),
        normalizationScale: 32767,
        quantization: "different-quantization",
        values: otherQuantizationValues)
    let otherQuantizationSearch = innovation.InnovationSearchByEmbedding(
        store, otherQuantizationQuery, innovation.InnovationTargetDocument)
    if smokeExpect(otherQuantizationSearch.ok &&
                   otherQuantizationSearch.result.targetIndexes.len == 0,
                   "quantization mismatch must not enter candidate set") != 0:
        return 1
    if smokeExpect(search.result.targetIndexes[0] == 0 &&
                   search.result.targetIndexes[1] == 2 &&
                   search.result.scoreMicros[0] == 1000000 &&
                   innovation.InnovationSha256CidValid(
                       search.result.queryReceiptHash),
                   "innovation search order or receipt mismatch") != 0:
        return 1

    let chart = innovation.InnovationBuildClaimChart(
        store, 0, "unimaker-csg-runtime", query, 990000)
    if smokeExpect(chart.ok && chart.chart.candidateOnly &&
                   chart.chart.requiredCount == 3 &&
                   chart.chart.matchedCount == 3 &&
                   chart.chart.allRequiredCandidate &&
                   innovation.InnovationSha256CidValid(chart.chart.receiptHash),
                   "claim chart full-element candidate mismatch") != 0:
        os.WriteLine(os.Get_stderr(), chart.error)
        return 1
    let chartFact = innovation.InnovationClaimChartFact(
        chart.chart, store.claimIds[0])
    let chartAdmission =
        csg.CsgCoreProductionValidateNamedReplacementFact(chartFact)
    if smokeExpect(chartAdmission.valid && chartAdmission.complete,
                   "claim chart fact should pass local strict admission") != 0:
        os.WriteLine(os.Get_stderr(),
                     csg.CsgCoreValidationReportJson(chartAdmission))
        for errorIndex in 0..<chartAdmission.errors.len:
            os.WriteLine(os.Get_stderr(), chartAdmission.errors[errorIndex])
        os.WriteLine(os.Get_stderr(), chartFact)
        return 1

    var badVectorFact: str
    for i in 0..<lines.len:
        if strings.strContains(
               lines[i],
               "csg_dialect::unimaker_product::innovation_embedding_receipt"):
            badVectorFact = strutil.Replace(
                lines[i],
                "\"vectorValues\":[32767,32767,0,0]",
                "\"vectorValues\":\"bad\"")
            break
    let badVectorAdmission =
        csg.CsgCoreProductionValidateNamedReplacementFact(badVectorFact)
    if smokeExpect(!badVectorAdmission.valid,
                   "non-array embedding vector must be rejected") != 0:
        return 1

    var badVectorCidFact: str
    let expectedVectorCidField = strings.ConcatStr(
        "\"vectorCid\":\"",
        strings.ConcatStr(store.embeddingVectorCids[0], "\""))
    let wrongVectorCidField = strings.ConcatStr(
        "\"vectorCid\":\"",
        strings.ConcatStr(smokeHash("wrong vector cid"), "\""))
    for i in 0..<lines.len:
        if strings.strContains(
               lines[i],
               "csg_dialect::unimaker_product::innovation_embedding_receipt"):
            badVectorCidFact = strutil.Replace(
                lines[i], expectedVectorCidField, wrongVectorCidField)
            break
    let badVectorCidAdmission =
        csg.CsgCoreProductionValidateNamedReplacementFact(badVectorCidFact)
    if smokeExpect(!badVectorCidAdmission.valid,
                   "unbound vectorCid must be rejected") != 0:
        return 1

    let inconsistentChartFact = strutil.Replace(
        chartFact, "\"matchedCount\":3", "\"matchedCount\":2")
    let inconsistentChartAdmission =
        csg.CsgCoreProductionValidateNamedReplacementFact(
            inconsistentChartFact)
    if smokeExpect(!inconsistentChartAdmission.valid,
                   "inconsistent claim chart counts must be rejected") != 0:
        return 1

    let unrelatedChart = innovation.InnovationBuildClaimChart(
        store, 1, "unimaker-csg-runtime", query, 990000)
    if smokeExpect(unrelatedChart.ok &&
                   !unrelatedChart.chart.allRequiredCandidate &&
                   unrelatedChart.chart.matchedCount <
                       unrelatedChart.chart.requiredCount,
                   "unrelated claim must not become full-element candidate") != 0:
        return 1
    if smokeExpect(smokeDuplicateIdRejected(),
                   "duplicate CSG fact identity must be rejected") != 0:
        return 1
    if smokeExpect(smokeMutatedVectorRejected(),
                   "mutated embedding arena must fail seal") != 0:
        return 1

    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr("innovation_facts_root=", root))
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "innovation_fact_count=", strings.IntToStr(lines.len)))
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            "innovation_csgc_byte_count=",
            strings.IntToStr(rawbytes.BytesLen(cargo.bytes))))
    os.WriteLine(os.Get_stdout(), "unimaker_innovation_csg_smoke ok")
    return 0
