import std/os
import std/rawbytes

type ColdPrimitiveKind = enum
    ColdPrimitiveReady
    ColdPrimitiveDone

type
    ByteStore =
        values: rawbytes.Bytes[]

    PrimitiveStore =
        texts: str[]
        numbers: int32[]
        flags: bool[]
        bytes: uint8[]
        wide: int64[]
        kinds: ColdPrimitiveKind[]
        matrices: int32[2][]

fn ClearBytes(value: var rawbytes.Bytes) =
    rawbytes.BytesFree(value)

fn ReplaceText(value: var str) =
    value = "changed"

fn ReplaceNumber(value: var int32) =
    value = 73

fn ReplaceFlag(value: var bool) =
    value = false

fn ReplaceByte(value: var uint8) =
    value = uint8(29)

fn ReplaceWide(value: var int64) =
    value = int64(101)

fn main() =
    var values: rawbytes.Bytes[]
    let owned = rawbytes.BytesAlloc(8)
    add(values, owned)
    assert(rawbytes.BytesLen(values[0]) == 8,
           " cold var array element composite: setup")
    ClearBytes(values[0])
    assert(rawbytes.BytesLen(values[0]) == 0,
           " cold var array element composite: writeback")
    var store: ByteStore
    let nestedOwned = rawbytes.BytesAlloc(8)
    add(store.values, nestedOwned)
    ClearBytes(store.values[0])
    assert(rawbytes.BytesLen(store.values[0]) == 0,
           " cold var array element composite: nested writeback")

    var texts: str[]
    add(texts, "before")
    ReplaceText(texts[0])
    assert(texts[0] == "changed",
           " cold var array element str: direct writeback")
    var numbers: int32[]
    add(numbers, 11)
    ReplaceNumber(numbers[0])
    assert(numbers[0] == 73,
           " cold var array element int32: direct writeback")

    var primitiveStore: PrimitiveStore
    add(primitiveStore.texts, "nested-before")
    add(primitiveStore.numbers, 17)
    ReplaceText(primitiveStore.texts[0])
    ReplaceNumber(primitiveStore.numbers[0])
    assert(primitiveStore.texts[0] == "changed",
           " cold var array element str: nested writeback")
    assert(primitiveStore.numbers[0] == 73,
           " cold var array element int32: nested writeback")
    primitiveStore.flags = [true]
    primitiveStore.bytes = [uint8(7)]
    primitiveStore.wide = [int64(11)]
    primitiveStore.kinds = [ColdPrimitiveReady, ColdPrimitiveDone]
    primitiveStore.matrices = [[1, 2], [3, 4]]
    ReplaceFlag(primitiveStore.flags[0])
    ReplaceByte(primitiveStore.bytes[0])
    ReplaceWide(primitiveStore.wide[0])
    assert(!primitiveStore.flags[0],
           " cold var array element bool: typed literal/writeback")
    assert(primitiveStore.bytes[0] == uint8(29),
           " cold var array element uint8: typed literal/writeback")
    assert(primitiveStore.wide[0] == int64(101),
           " cold var array element int64: typed literal/writeback")
    assert(primitiveStore.kinds[0] == ColdPrimitiveReady &&
           primitiveStore.kinds[1] == ColdPrimitiveDone,
           " cold var array element enum: typed literal")
    assert(primitiveStore.matrices[0][1] == 2 &&
           primitiveStore.matrices[1][0] == 3,
           " cold var array element fixed-array: typed nested literal")
    os.WriteLine(os.Get_stdout(),
                 "cold_var_array_element_composite_smoke: ok")
