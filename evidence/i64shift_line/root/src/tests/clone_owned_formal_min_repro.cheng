import std/strings

type Slot =
    payload: str

fn StoreIntoIndex(target: var Slot[], idx: int32, owned0: str) =
    target[idx].payload = strings.CloneStr(owned0)

fn StoreAppend(target: var Slot[], owned0: str) =
    var entry: Slot
    entry.payload = strings.CloneStr(owned0)
    add(target, entry)

fn BranchyStore(target: var Slot[], flag: bool, owned0: str): bool =
    if flag:
        let idx: int32 = 0
        StoreIntoIndex(target, idx, owned0)
        return true
    StoreAppend(target, owned0)
    return false

fn ReadLen(x: str): int32 =
    return x.len

@borrows
fn BorrowRead(x: str): int32 =
    return x.len

fn OwnedThenBorrow(owned0: str): int32 =
    let total0 = BorrowRead(owned0)
    let total1 = BorrowRead(owned0)
    return total0 + total1 + ReadLen(owned0)

type ListenerRow =
    handlerId: int32
    eventType: str
    once: bool

@borrows
fn Sink(row: ListenerRow, etype: str): int32 =
    if row.eventType == etype:
        let keepAlive = strings.CloneStr(etype)
        return keepAlive.len
    return 0

@borrows
fn InLoopBorrowUse(rows: ListenerRow[], etype: str): int32 =
    var dispatched = 0
    for i in 0..<rows.len:
        if rows[i].eventType == etype && rows[i].handlerId != 0:
            dispatched = dispatched + Sink(rows[i], etype)
            if rows[i].once:
                rows[i].handlerId = 0
    return dispatched

@borrows
fn LocalCloneLoopCase(rows: ListenerRow[], etypeRaw: str): int32 =
    let etype = strings.CloneStr(etypeRaw)
    var dispatched = 0
    for i in 0..<rows.len:
        if rows[i].eventType == etype && rows[i].handlerId != 0:
            dispatched = dispatched + Sink(rows[i], etype)
            if rows[i].once:
                rows[i].handlerId = 0
    return dispatched

fn main(): int32 =
    var bag: Slot[]
    setLen(bag, 1)
    let r1 = BranchyStore(bag, true, "alpha")
    let r2 = BranchyStore(bag, false, "gamma")
    let r3 = OwnedThenBorrow("delta")
    var rows: ListenerRow[]
    var row0: ListenerRow
    row0.handlerId = 5
    row0.eventType = "click"
    add(rows, row0)
    let r4 = InLoopBorrowUse(rows, "click")
    let r5 = LocalCloneLoopCase(rows, "click")
    if r1 == r2:
        return 7
    if r3 + r4 + r5 < 0:
        return 8
    return 0
