fn Take(xs: int32[]): int32 =
    return xs.len

fn Bump(xs: var int32[]): int32 =
    add(xs, 9)
    return xs.len

fn main(): int32 =
    var xs: int32[]
    add(xs, 5)
    add(xs, 6)
    let before = Take(xs)
    if before != 2:
        return 51
    let after = Bump(xs)
    if after != 3:
        return 52
    return xs[0] + xs[1] + xs[2] - 20

main()
