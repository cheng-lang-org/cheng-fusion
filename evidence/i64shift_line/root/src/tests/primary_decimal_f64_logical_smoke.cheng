import std/system
import std/strutils as strutil
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend2/backend2_lower_util as b2util

@importc("cheng_f64_to_bits")
fn runtimeF64Bits(value: float64): int64

var evaluationLog: int32

fn orderedF64(marker: int32,
              value: float64,
              expectedBits: uint64): bool =
    evaluationLog = evaluationLog * 10 + marker
    return uint64(runtimeF64Bits(value)) == expectedBits

fn consumeBool(value: bool): bool =
    return value

fn assertCompilerBits(text: str, expectedBits: uint64) =
    var primaryBits: uint64
    var backend2Bits: uint64
    assert(pobj.PrimaryBodyIrF64LiteralBits(text, primaryBits),
           "primary exact decimal parser accepts valid literal")
    assert(b2util.PrimaryBodyIrF64LiteralBits(text, backend2Bits),
           "backend2 exact decimal parser accepts valid literal")
    assert(primaryBits == expectedBits,
           "primary exact decimal parser is correctly rounded")
    assert(backend2Bits == expectedBits,
           "backend2 exact decimal parser is correctly rounded")
    assert(primaryBits == backend2Bits,
           "primary/backend2 decimal parser bit contract")

fn main(): int32 =
    let oneEminus19Bits = uint64(0x3bfd83c94fb6d2ac)
    let pointOneBits = uint64(0x3fb999999999999a)
    let oneBits = uint64(0x3ff0000000000000)
    let nextAfterOneBits = uint64(0x3ff0000000000001)
    let negativeZeroBits = uint64(0x8000000000000000)

    # This legal 19-digit fractional literal must compile, execute, and carry
    # the correctly rounded bits.
    let literal: float64 = 0.0000000000000000001
    assert(uint64(runtimeF64Bits(literal)) == oneEminus19Bits,
           "legal 19-digit f64 literal runtime bits")

    assertCompilerBits("0.0000000000000000001", oneEminus19Bits)
    assertCompilerBits("0.1", pointOneBits)
    assertCompilerBits(
        "1.00000000000000011102230246251565404236316680908203125",
        oneBits)
    assertCompilerBits(
        "1.00000000000000011102230246251565404236316680908203126",
        nextAfterOneBits)
    assertCompilerBits("-0.0", negativeZeroBits)
    var minSubnormalText = "0."
    for _ in 0..<323:
        minSubnormalText = strutil.Join([minSubnormalText, "0"], "")
    minSubnormalText = strutil.Join([minSubnormalText, "5"], "")
    assertCompilerBits(minSubnormalText, uint64(1))

    evaluationLog = 0
    let shortCircuit = consumeBool(
        orderedF64(1, 0.0000000000000000001, oneEminus19Bits) &&
        (orderedF64(2, 0.1, pointOneBits) ||
         orderedF64(9, 1.0, oneBits)))
    assert(shortCircuit, "f64 bool-chain result")
    assert(evaluationLog == 12,
           "f64 bool-chain preserves left-to-right short-circuit effects")

    echo("primary_decimal_f64_logical_smoke ok")
    return 0
