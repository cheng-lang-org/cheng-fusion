import std/rawbytes as rawbytes

fn main(): int32 =
    var selectedKey: rawbytes.Bytes = rawbytes.EmptyBytes()
    var i: int32 = 0
    while i < 2:
        let clientKey: rawbytes.Bytes = rawbytes.EmptyBytes()
        if i == 1:
            selectedKey = clientKey
            break
        if i == 0:
            selectedKey = clientKey
        i = i + 1
    if rawbytes.BytesLen(selectedKey) <= 0:
        return 1
    return 0
