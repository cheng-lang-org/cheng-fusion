# Scratch: does aesEncryptBlockInto(rounds=10) infinite-recurse via the HwHost route?
import std/system
import std/rawbytes
import std/crypto/aes

fn hexNib(c: int32): int32 =
    if c >= int32('0') && c <= int32('9'):
        return c - int32('0')
    if c >= int32('a') && c <= int32('f'):
        return c - int32('a') + 10
    return 0

fn bytesFromHexInto(b: Bytes, hex: str) =
    var i: int32
    while i < BytesLen(b):
        let hi: int32 = hexNib(int32(hex[i * 2]))
        let lo: int32 = hexNib(int32(hex[i * 2 + 1]))
        BytesSet(b, i, ((hi << 4) | lo) & 255)
        i = i + 1

fn main(): int32 =
    let block: Bytes = BytesAlloc(16)
    bytesFromHexInto(block, "00112233445566778899aabbccddeeff")
    let sched: Bytes = BytesAlloc(176)
    bytesFromHexInto(sched, "")
    var out: Bytes = BytesAlloc(16)
    let res: Result[bool] = aes.aesEncryptBlockInto(out, 10, sched, block)
    if IsErr(res):
        echo("into err")
        return 2
    let got: str = BytesToHex(out)
    echo(got)
    if got == "69c4e0d86a7b0430d8cdb78070b4c55a":
        echo("aes_into_cycle_probe ok")
        return 0
    echo("aes_into_cycle_probe FAIL")
    return 1
