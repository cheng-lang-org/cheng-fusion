# Real transmit proof: moment-report request frame (4 length-prefixed fields) +
# 1-byte ack over a real QUIC loopback connection (same msquicTransportWrite ->
# pipeWrite -> msquicNativePipeWrite STREAM-frame path the device uses). Single-
# threaded: the client write and server serve interleave on one thread over the
# loopback pair.
#
# Proves the report send service's wire protocol REALLY transmits bytes (not a
# stub): the client negotiates the moment-report protocol + writes the four-field
# report frame, the server reads it back over QUIC, parses the four length-prefixed
# fields, and writes the ack; the client reads the ack. If any byte failed to
# transmit/decrypt, the reads time out and the harness panics. This is the exact
# wire framing WebSceneSocialMomentReportIssue (the generated handleReport seg0)
# uses.

import std/system
import std/result
import std/os
import std/rawbytes
import std/strings as strings
import cheng/libp2p/core/types as types
import cheng/libp2p/core/multiaddr as multiaddr
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/core/runtime/web_scene_social_send as social

fn logLine(s: str) =
    os.WriteLine(os.Get_stdout(), s)

fn logInt(label: str, n: int32) =
    os.WriteLine(os.Get_stdout(), strings.ConcatStr(label, strings.IntToStr(n)))

# Read one length-prefixed [len:int32-be][bytes] field from the server side; returns the field text.
fn readField(pair: var quic_transport.Libp2pQuicLoopbackPair): str =
    let lenRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, 4)
    if IsErr(lenRes):
        panic(ErrorText(lenRes))
    let lenBytes = Value(lenRes)
    let n: int32 = (rawbytes.BytesGet(lenBytes, 0) << 24) |
                   (rawbytes.BytesGet(lenBytes, 1) << 16) |
                   (rawbytes.BytesGet(lenBytes, 2) << 8) |
                   rawbytes.BytesGet(lenBytes, 3)
    if n == 0:
        return ""
    let bodyRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, n)
    if IsErr(bodyRes):
        panic(ErrorText(bodyRes))
    return rawbytes.BytesToString(Value(bodyRes))

fn main(): int32 =
    var listenAddr: types.Libp2pMultiaddr
    multiaddr.Libp2pMultiaddrFillQuic(listenAddr, "127.0.0.1", 0)
    var pair: quic_transport.Libp2pQuicLoopbackPair
    let openRes = quic_transport.Libp2pQuicLoopbackOpenInto(pair, listenAddr)
    if IsErr(openRes):
        panic(ErrorText(openRes))
    logLine("loopback open ok")

    # --- client: negotiate moment-report protocol (real select bytes out the socket) ---
    let protocol: int32 = types.Libp2pProtocolSocialMomentReport
    let selRes = quic_transport.Libp2pQuicLoopbackSelectProtocol(pair, protocol)
    if IsErr(selRes):
        panic(ErrorText(selRes))
    logLine("negotiate ok (real report select transmitted + echoed)")

    # --- client: build + transmit the four-field report frame (REAL bytes out) ---
    # mirrors the generated handleReport seg0: contentId = content.postId||content.id,
    # channel = "blue", reasonCode = "user_report", detail = `${title} ${content}`.trim().slice(0,160)
    let frame = social.WebSceneSocialBuildReportFrameExport("img1", "blue", "user_report", "poster")
    let frameLen: int32 = rawbytes.BytesLen(frame)
    let wRes = quic_transport.Libp2pQuicLoopbackWriteClient(pair, frame)
    if IsErr(wRes):
        panic(ErrorText(wRes))
    if Value(wRes) != frameLen:
        panic("short report frame write")
    logInt("report frame transmitted bytes=", Value(wRes))

    # --- server: read the four fields back over QUIC, parse them, write the 1-byte ack ---
    let contentId: str = readField(pair)
    let channel: str = readField(pair)
    let reasonCode: str = readField(pair)
    let detail: str = readField(pair)
    logLine(strings.ConcatStr("server received contentId=", contentId))
    logLine(strings.ConcatStr("server received channel=", channel))
    logLine(strings.ConcatStr("server received reasonCode=", reasonCode))
    logLine(strings.ConcatStr("server received detail=", detail))

    var ack = rawbytes.BytesAlloc(1)
    rawbytes.BytesSet(ack, 0, 1)
    let ackW = quic_transport.Libp2pQuicLoopbackWriteServer(pair, ack)
    if IsErr(ackW):
        panic(ErrorText(ackW))
    logLine("server ack transmitted")

    # --- client: read the real recv done-signal (the 1-byte ack) ---
    let ackRes = quic_transport.Libp2pQuicLoopbackReadClient(pair, 1)
    if IsErr(ackRes):
        panic(ErrorText(ackRes))
    let ackBytes = Value(ackRes)
    if rawbytes.BytesLen(ackBytes) < 1:
        panic("short ack read")
    logInt("client received ack byte=", rawbytes.BytesGet(ackBytes, 0))

    quic_transport.Libp2pQuicLoopbackClose(pair)
    let fieldsOk: bool = contentId == "img1" &&
                         channel == "blue" &&
                         reasonCode == "user_report" &&
                         detail == "poster"
    if rawbytes.BytesGet(ackBytes, 0) == 1 && fieldsOk:
        logLine("MOMENT_REPORT_REAL_TRANSMIT_OK")
    else:
        logLine("MOMENT_REPORT_REJECTED")
    return 0
