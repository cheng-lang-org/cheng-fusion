# lsp_jsonrpc_smoke.cheng
# JSON-RPC 2.0 over stdin/stdout pipe smoke test (in-memory).
#
# Verifies the Content-Length framing and JSON-RPC 2.0 message format
# that the LSP server uses, without requiring LSP server compilation.
#
# Tests:
#   - Content-Length header construction and parsing (Test 1-2)
#   - LSP initialize request JSON-RPC format (Test 3)
#   - Initialize response with capabilities (Test 4)
#   - JSON-RPC error response format (Test 5)
#   - JSON-RPC notification format without "id" (Test 6)
#   - Content-Length body integrity (Test 7)
#   - Full message framing roundtrip (Test 8)

import std/strings
import std/strutils as strutil

# --- Helpers ---

fn FindIndex(text: str, sub: str): int32 =
    let n: int32 = strings.Len(text)
    let m: int32 = strings.Len(sub)
    if m <= 0 || m > n:
        return -1
    let limit: int32 = n - m
    for i in 0..limit:
        let candidate: str = strings.SliceBytes(text, i, m)
        if candidate == sub:
            return i
    return -1

fn StrContains(text: str, sub: str): bool =
    return strings.strContains(text, sub)

fn BuildContentLengthHeader(body: str): str =
    return strutil.Join(["Content-Length: ", strings.IntToStr(strings.Len(body)), "\r\n\r\n"], "")

# Manual int32 parser (cold compiler var parameter limitation workaround).
fn ParseInt32Simple(s: str): int32 =
    let n: int32 = strings.Len(s)
    if n <= 0: return -1
    var result: int32
    var start: int32
    if s[0] == '-':
        start = 1
    else:
        start = 0
    for i in start..<n:
        let ch: char = s[i]
        if ch < '0' || ch > '9':
            break
        result = result * 10 + int32(ch) - 48
    if start == 1:
        result = -result
    return result

fn ExtractContentLength(header: str): int32 =
    # Find ':' in header
    var colonPos: int32 = -1
    let hlen: int32 = strings.Len(header)
    for i in 0..<hlen:
        if header[i] == ':':
            colonPos = i
            break
    if colonPos < 0: return -1
    # Skip ": " to get to the number
    var valStart: int32 = colonPos + 2
    var valEnd: int32 = valStart
    while valEnd < hlen && header[valEnd] >= '0' && header[valEnd] <= '9':
        valEnd = valEnd + 1
    if valEnd <= valStart: return -2
    var valStr: str = strings.SliceBytes(header, valStart, valEnd - valStart)
    return ParseInt32Simple(valStr)

# =============================================
# Test 1: Content-Length header format
# =============================================
fn TestContentLengthHeaderFormat(): int32 =
    var body: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}"
    var header: str = BuildContentLengthHeader(body)
    # Verify header starts with correct prefix
    if !strings.hasPrefix(header, "Content-Length: "): return 1
    # Verify header ends with \r\n\r\n
    let hlen: int32 = strings.Len(header)
    if hlen < 4: return 2
    if header[hlen - 4] != '\r': return 3
    if header[hlen - 3] != '\n': return 4
    if header[hlen - 2] != '\r': return 5
    if header[hlen - 1] != '\n': return 6
    # Verify the Content-Length value equals body length
    var contentLen: int32 = ExtractContentLength(header)
    if contentLen != strings.Len(body): return 7
    return 0

# =============================================
# Test 2: Parse Content-Length from header
# =============================================
fn TestParseContentLength(): int32 =
    var body: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}"
    var header: str = BuildContentLengthHeader(body)
    var contentLen: int32 = ExtractContentLength(header)
    if contentLen < 0: return 1
    if contentLen != strings.Len(body): return 2
    return 0

# =============================================
# Test 3: LSP initialize request JSON-RPC format
# =============================================
fn TestInitializeRequestFormat(): int32 =
    var req: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}"
    if strings.Len(req) <= 0: return 1
    if !StrContains(req, "\"jsonrpc\""): return 2
    if !StrContains(req, "\"2.0\""): return 3
    if !StrContains(req, "\"id\""): return 4
    if !StrContains(req, "\"method\""): return 5
    if !StrContains(req, "\"initialize\""): return 6
    if !StrContains(req, "\"params\""): return 7
    if !StrContains(req, "\"processId\""): return 8
    if !StrContains(req, "\"rootUri\""): return 9
    if !StrContains(req, "\"capabilities\""): return 10
    if !StrContains(req, "null"): return 11
    return 0

# =============================================
# Test 4: Initialize response with capabilities
# =============================================
fn TestInitializeResponseCaps(): int32 =
    var resp: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"definitionProvider\":true,\"referencesProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"],\"resolveProvider\":false},\"diagnosticProvider\":{\"identifier\":\"cheng\",\"interFileDependencies\":true,\"workspaceDiagnostics\":false}},\"serverInfo\":{\"name\":\"cheng-lsp\",\"version\":\"0.1.0\"}}}"
    if !StrContains(resp, "\"jsonrpc\""): return 1
    if !StrContains(resp, "\"2.0\""): return 2
    if !StrContains(resp, "\"result\""): return 3
    if !StrContains(resp, "\"capabilities\""): return 4
    if !StrContains(resp, "\"textDocumentSync\""): return 5
    if !StrContains(resp, "\"hoverProvider\""): return 6
    if !StrContains(resp, "\"definitionProvider\""): return 7
    if !StrContains(resp, "\"referencesProvider\""): return 8
    if !StrContains(resp, "\"completionProvider\""): return 9
    if !StrContains(resp, "\"diagnosticProvider\""): return 10
    if !StrContains(resp, "\"serverInfo\""): return 11
    if !StrContains(resp, "\"cheng-lsp\""): return 12
    if !StrContains(resp, "\"0.1.0\""): return 13
    if !StrContains(resp, "\".\""): return 14
    if !StrContains(resp, "triggerCharacters"): return 15
    if !StrContains(resp, "interFileDependencies"): return 16
    if !StrContains(resp, "workspaceDiagnostics"): return 17
    return 0

# =============================================
# Test 5: JSON-RPC error response format
# =============================================
fn TestErrorResponseFormat(): int32 =
    var errResp: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"error\":{\"code\":-32601,\"message\":\"MethodNotFound\"}}"
    if !StrContains(errResp, "\"jsonrpc\""): return 1
    if !StrContains(errResp, "\"2.0\""): return 2
    if !StrContains(errResp, "\"error\""): return 3
    if !StrContains(errResp, "\"code\""): return 4
    if !StrContains(errResp, "-32601"): return 5
    if !StrContains(errResp, "\"message\""): return 6
    if !StrContains(errResp, "\"MethodNotFound\""): return 7
    # Error response with "id" must NOT have "result"
    if StrContains(errResp, "\"result\""): return 8
    return 0

# =============================================
# Test 6: JSON-RPC notification format (no "id")
# =============================================
fn TestNotificationFormat(): int32 =
    var notif: str = "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":\"file:///test.cheng\",\"diagnostics\":[]}}"
    if !StrContains(notif, "\"jsonrpc\""): return 1
    if !StrContains(notif, "\"2.0\""): return 2
    if !StrContains(notif, "\"method\""): return 3
    if !StrContains(notif, "\"textDocument/publishDiagnostics\""): return 4
    if !StrContains(notif, "\"params\""): return 5
    if !StrContains(notif, "\"diagnostics\""): return 6
    if !StrContains(notif, "\"uri\""): return 7
    # Notifications must NOT have "id" field
    if FindIndex(notif, "\"id\"") >= 0: return 8
    # Notifications must NOT have "result" field
    if FindIndex(notif, "\"result\"") >= 0: return 9
    return 0

# =============================================
# Test 7: Content-Length body integrity
# =============================================
fn TestContentLengthIntegrity(): int32 =
    var body: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}"
    var header: str = BuildContentLengthHeader(body)
    var parsedLen: int32 = ExtractContentLength(header)
    if parsedLen != strings.Len(body): return 1
    return 0

# =============================================
# Test 8: Full message framing roundtrip
# =============================================
fn TestMessageFramingRoundtrip(): int32 =
    var body: str = "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}}"
    var header: str = BuildContentLengthHeader(body)
    var framed: str = strutil.Join([header, body], "")

    # Find \r\n\r\n separator between headers and body
    var sepPos: int32 = FindIndex(framed, "\r\n\r\n")
    if sepPos < 0: return 1

    # Extract body from framed message
    var headerWithSepLen: int32 = sepPos + 4
    var extractedBody: str = strings.SliceBytes(framed, headerWithSepLen,
        strings.Len(framed) - headerWithSepLen)

    # Body must match original
    if extractedBody != body: return 2

    # Extract Content-Length and verify
    var parsedLen: int32 = ExtractContentLength(header)
    if parsedLen < 0: return 3
    if parsedLen != strings.Len(extractedBody): return 4

    # Verify body is valid JSON-RPC 2.0
    if !StrContains(extractedBody, "\"jsonrpc\""): return 5
    if !StrContains(extractedBody, "\"2.0\""): return 6
    if !StrContains(extractedBody, "\"id\""): return 7

    return 0

fn main(): int32 =
    var result: int32

    result = TestContentLengthHeaderFormat()
    if result != 0: return result

    result = TestParseContentLength()
    if result != 0: return 10 + result

    result = TestInitializeRequestFormat()
    if result != 0: return 20 + result

    result = TestInitializeResponseCaps()
    if result != 0: return 30 + result

    result = TestErrorResponseFormat()
    if result != 0: return 40 + result

    result = TestNotificationFormat()
    if result != 0: return 50 + result

    result = TestContentLengthIntegrity()
    if result != 0: return 60 + result

    result = TestMessageFramingRoundtrip()
    if result != 0: return 70 + result

    return 0
