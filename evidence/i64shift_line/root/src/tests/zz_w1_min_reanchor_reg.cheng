# W1 minimal repro: managed branch consume edge is not exact
type W1Box = object
    items: int32[]

fn W1TouchBox(box: var W1Box): int32 =
    add(box.items, 7)
    return box.items.len

fn W1TouchItems(items: var int32[]): int32 =
    add(items, 9)
    return items.len

fn W1Main(flag: bool): int32 =
    var box: W1Box
    let a = W1TouchBox(box)
    let b = W1TouchItems(box.items)
    var acc: int32 = 0
    if flag:
        acc = acc + 1
    else:
        acc = acc + 2
    acc = acc + box.items.len
    return acc + a + b

fn main(): int32 =
    if W1Main(true) > 0:
        return 0
    return 1
