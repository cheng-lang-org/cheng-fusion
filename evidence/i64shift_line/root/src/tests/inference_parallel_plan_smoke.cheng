import std/result
import cheng/inference/kernel_ir as kir
import cheng/inference/parallel_plan as pp
import cheng/inference/model_graph as mg
import cheng/inference/npu_graph_ir as npu
import cheng/inference/execution_receipt as receipt

fn main(): int32 =
    let graph = mg.ModelGraphBuildTinyGlmMoeFixture("cid:model:tiny-glm-moe")
    assert(IsOk(mg.ModelGraphValidate(graph)), " inference parallel smoke: model graph")
    let facts = mg.ModelGraphFacts(graph)
    assert(facts.len >= 4, " inference parallel smoke: model facts")

    let peers: str[] = ["peer:a", "peer:b"]
    let planRes = pp.ParallelBuildTensorHeadPlan("cid:plan:tiny", 4, peers)
    assert(IsOk(planRes), " inference parallel smoke: tensor plan")
    var plan = Value(planRes)
    let expertRes = pp.ParallelAttachExpertPlan(plan, 2, peers, "cid:expert:")
    assert(IsOk(expertRes), " inference parallel smoke: expert plan")
    assert(IsOk(pp.ParallelValidatePlan(plan)), " inference parallel smoke: validate")
    assert(plan.tensorShards.len == 4, " inference parallel smoke: tensor shards")
    assert(plan.expertShards.len == 2, " inference parallel smoke: expert shards")
    assert(plan.tensorShards[0].peerId == "peer:a", " inference parallel smoke: tensor peer0")
    assert(plan.tensorShards[1].peerId == "peer:b", " inference parallel smoke: tensor peer1")
    assert(plan.expertShards[0].shardCid == "cid:expert:0", " inference parallel smoke: expert cid0")
    assert(plan.expertShards[1].shardCid == "cid:expert:1", " inference parallel smoke: expert cid1")
    assert(IsOk(pp.ParallelValidateTensorHeadCoverage(plan, 4)),
        " inference parallel smoke: tensor head coverage")
    let head2Owner = pp.ParallelFindTensorHeadOwner(plan, 2)
    assert(IsOk(head2Owner) && Value(head2Owner) == "peer:a",
        " inference parallel smoke: tensor head owner")
    let planFacts = pp.ParallelPlanFacts(plan)
    assert(planFacts.len >= 4, " inference parallel smoke: plan facts")

    var overlapPlan = plan
    overlapPlan.tensorShards[1].start = 0
    overlapPlan.planHash = pp.ParallelPlanHash(overlapPlan)
    assert(IsErr(pp.ParallelValidateTensorHeadCoverage(overlapPlan, 4)),
        " inference parallel smoke: tensor head overlap hard fail")
    var badAxisPlan = plan
    badAxisPlan.tensorShards[0].axis = "hidden_feature"
    badAxisPlan.planHash = pp.ParallelPlanHash(badAxisPlan)
    assert(IsErr(pp.ParallelValidateTensorHeadCoverage(badAxisPlan, 4)),
        " inference parallel smoke: tensor axis hard fail")

    let npuGraph = npu.NpuGraphBuildStaticRmsNormFixture(
        npu.NpuGraphBackendAppleAneCoreml,
        kir.KernelDtypeFp16,
        4
    )
    assert(IsOk(npu.NpuGraphValidate(npuGraph)), " inference parallel smoke: npu static graph")
    assert(IsErr(npu.NpuGraphCompileUnsupported(npuGraph)),
        " inference parallel smoke: npu provider hard fail")
    let npuFacts = npu.NpuGraphFacts(npuGraph)
    assert(npuFacts.len >= 4, " inference parallel smoke: npu facts")

    let executionReceipt = receipt.InferenceExecutionReceiptBuild(
        graph.modelCid,
        npuGraph.graphHash,
        plan.planHash,
        npuGraph.graphHash,
        int64(123),
        int64(234),
        int64(456),
        int64(0),
        int64(0),
        int64(0),
        int64(0),
        receipt.InferenceExecutionStatusPlanned
    )
    assert(IsOk(receipt.InferenceExecutionReceiptValidate(executionReceipt)),
        " inference parallel smoke: execution receipt")
    var badReceipt = executionReceipt
    badReceipt.outputHash = badReceipt.outputHash + int64(1)
    assert(IsErr(receipt.InferenceExecutionReceiptValidate(badReceipt)),
        " inference parallel smoke: execution receipt hash drift")

    plan.tensorShards[1].peerId = ""
    let badRes = pp.ParallelValidatePlan(plan)
    assert(IsErr(badRes), " inference parallel smoke: invalid peer hard fail")

    echo(" inference_parallel_plan_smoke ok")
    return 0
