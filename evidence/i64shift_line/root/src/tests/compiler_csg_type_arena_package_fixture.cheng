import cheng/tests/compiler_csg_type_arena_left_fixture as left
import cheng/tests/compiler_csg_type_arena_right_fixture as right

fn ReadLeft(value: left.Box): int32 =
    return value.leftValue

fn ReadRight(value: right.Box): int32 =
    return value.leftValue

fn Identity(value: int32): int32 =
    return value

fn Accept(values: int32[]): int32 =
    return values.len

fn Main(): int32 =
    let literal = 7
    let called = Identity(literal)
    let projected = [7][0]
    return called + projected
