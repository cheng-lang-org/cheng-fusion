    if !layout.WebLayoutSetTextContent(tree, text, "ASI 助手"):
        return 4
    if !layout.WebLayoutSetFontSize(tree, text, 16):
        return 5
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 18, 18, 8, 0, badge):
        return 6
    if !layout.WebLayoutSetInlineLevel(tree, badge, true):
        return 7
    if !layout.WebLayoutSetFlexStyle(tree, badge, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentCenter, layout.WebLayoutAlignItemsCenter, 0, 0):
        return 8
