    if !layout.WebLayoutAppendChild(tree, badge, badgeText):
        return 15
    if !layout.WebLayoutCompute(tree, root):
        return 16

    var titleH: int32 = -1
    var textX: int32 = -1
    var badgeX: int32 = -1
    var badgeY: int32 = -1
    for bi in 0..<layout.WebLayoutBoxCount(tree):
        let node = layout.WebLayoutBoxNodeAt(tree, bi)
        if node == title:
            titleH = layout.WebLayoutBoxHeightAt(tree, bi)
        elif node == text:
            textX = layout.WebLayoutBoxXAt(tree, bi)
        elif node == badge:
            badgeX = layout.WebLayoutBoxXAt(tree, bi)
            badgeY = layout.WebLayoutBoxYAt(tree, bi)
    if titleH != 19:
