fn runLayoutGridPercentRemainderSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayGrid, 374, 42, 0, 0, root):
        return 1
    let rootIdx = layout.WebLayoutFindStyleIndex(tree, root)
    if rootIdx < 0:
        return 2
    tree.styles[rootIdx].gap = 4
    var colSizes: int32[]
    var colUnits: int32[]
    for _ in 0..<5:
        add(colSizes, 20)
        add(colUnits, 2)
    if !layout.WebLayoutSetGridTracks(tree, root, 0, colSizes, colUnits):
        return 3
    var firstNode = 0
    var thirdNode = 0
    var fifthNode = 0
    for idx in 0..<5:
        var child = 0
        if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 0, 42, 0, 0, child):
            return 4
        if idx == 0:
            firstNode = child
        elif idx == 2:
            thirdNode = child
        elif idx == 4:
            fifthNode = child
        if !layout.WebLayoutAppendChild(tree, root, child):
            return 5
    if !layout.WebLayoutCompute(tree, root):
        return 6
    var firstX: int32 = -1
    var firstW: int32 = -1
    var thirdX: int32 = -1
    var thirdW: int32 = -1
    var fifthX: int32 = -1
    var fifthW: int32 = -1
    for bi in 0..<layout.WebLayoutBoxCount(tree):
        let node = layout.WebLayoutBoxNodeAt(tree, bi)
        if node == firstNode && firstX < 0:
            firstX = layout.WebLayoutBoxXAt(tree, bi)
            firstW = layout.WebLayoutBoxWidthAt(tree, bi)
        elif node == thirdNode && thirdX < 0:
            thirdX = layout.WebLayoutBoxXAt(tree, bi)
            thirdW = layout.WebLayoutBoxWidthAt(tree, bi)
        elif node == fifthNode && fifthX < 0:
            fifthX = layout.WebLayoutBoxXAt(tree, bi)
            fifthW = layout.WebLayoutBoxWidthAt(tree, bi)
    if firstX != 0:
        return 7
    if firstW != 71:
        echo(Fmt"grid remainder w1={firstW}")
        return 8
    if thirdX != 151:
        echo(Fmt"grid remainder x3={thirdX} w3={thirdW}")
        return 9
    if thirdW != 71:
        echo(Fmt"grid remainder x3={thirdX} w3={thirdW}")
        return 10
    if fifthX != 302:
        echo(Fmt"grid remainder x5={fifthX} w5={fifthW}")
        return 11
    return 0

