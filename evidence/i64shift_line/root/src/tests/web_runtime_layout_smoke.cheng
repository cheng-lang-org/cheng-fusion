import cheng/core/runtime/web_layout_runtime as layout
import cheng/core/runtime/web_font_runtime as font
import cheng/tests/web_runtime_font_fixture as fontfixture

fn runLayoutBlockTreeSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var first = 0
    var hidden = 0
    var second = 0
    var nested = 0
    var invalid = 0

    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 200, 100, 3, 5, root):
        return 1
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 50, 10, 7, 11, first):
        return 2
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayNone, 80, 90, 13, 17, hidden):
        return 3
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 70, 20, 2, 4, second):
        return 4
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 30, 6, 1, 2, nested):
        return 5
    if layout.WebLayoutCreateStyleBox(tree, 99, 1, 1, 0, 0, invalid):
        return 6
    if invalid != 0:
        return 7
    if layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, -1, 1, 0, 0, invalid):
        return 8

    if !layout.WebLayoutAppendChild(tree, root, first):
        return 9
    if !layout.WebLayoutAppendChild(tree, root, hidden):
        return 10
    if !layout.WebLayoutAppendChild(tree, root, second):
        return 11
    if !layout.WebLayoutAppendChild(tree, second, nested):
        return 12
    if layout.WebLayoutAppendChild(tree, nested, root):
        return 13
    if layout.WebLayoutAppendChild(tree, root, nested):
        return 14

    if !layout.WebLayoutCompute(tree, root):
        return 15
    if layout.WebLayoutBoxCount(tree) != 4:
        return 16

    if layout.WebLayoutBoxNodeAt(tree, 0) != root:
        return 17
    if layout.WebLayoutBoxXAt(tree, 0) != 3:
        return 18
    if layout.WebLayoutBoxYAt(tree, 0) != 5:
        return 19
    if layout.WebLayoutBoxWidthAt(tree, 0) != 200:
        return 20
    if layout.WebLayoutBoxHeightAt(tree, 0) != 100:
        return 21

    if layout.WebLayoutBoxNodeAt(tree, 1) != first:
        return 22
    if layout.WebLayoutBoxXAt(tree, 1) != 10:
        return 23
    if layout.WebLayoutBoxYAt(tree, 1) != 16:
        return 24

    if layout.WebLayoutBoxNodeAt(tree, 2) != second:
        return 25
    if layout.WebLayoutBoxXAt(tree, 2) != 5:
        return 26
    if layout.WebLayoutBoxYAt(tree, 2) != 30:
        return 27

    if layout.WebLayoutBoxNodeAt(tree, 3) != nested:
        return 28
    if layout.WebLayoutBoxXAt(tree, 3) != 6:
        return 29
    if layout.WebLayoutBoxYAt(tree, 3) != 32:
        return 30
    if layout.WebLayoutBoxWidthAt(tree, 3) != 30:
        return 31
    if layout.WebLayoutBoxHeightAt(tree, 3) != 6:
        return 32

    if layout.WebLayoutCompute(tree, 0):
        return 33
    return 0

