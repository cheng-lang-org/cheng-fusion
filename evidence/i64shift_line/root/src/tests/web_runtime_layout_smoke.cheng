    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayInline, 0, 0, 0, 0, address):
        return 10
    if !layout.WebLayoutSetTextContent(tree, address, "中国河南省三门峡市陕州区"):
        return 11
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayInline, 366, 50, 0, 0, titleInput):
        return 12

    if !layout.WebLayoutAppendChild(tree, badge, badgeText):
        return 13
    if !layout.WebLayoutAppendChild(tree, locationRow, badge):
        return 14
    if !layout.WebLayoutAppendChild(tree, locationRow, address):
        return 15
    if !layout.WebLayoutAppendChild(tree, root, locationRow):
        return 16
    if !layout.WebLayoutAppendChild(tree, root, titleInput):
        return 17
    if !layout.WebLayoutCompute(tree, root):
        return 18

    var rowY: int32 = -1
    var rowH: int32 = -1
    var titleY: int32 = -1
    for bi in 0..<layout.WebLayoutBoxCount(tree):
        let node = layout.WebLayoutBoxNodeAt(tree, bi)
        if node == locationRow:
            rowY = layout.WebLayoutBoxYAt(tree, bi)
            rowH = layout.WebLayoutBoxHeightAt(tree, bi)
        elif node == titleInput:
            titleY = layout.WebLayoutBoxYAt(tree, bi)
    if rowY != 0 || rowH <= 0 || titleY != rowY + rowH + 8:
        echo(Fmt"block inline after block actual rowY={rowY} rowH={rowH} titleY={titleY}")
        return 19
    return 0

fn runLayoutFlexStickyHeaderFlowSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var header = 0
    var menuButton = 0
    var menuIcon = 0
    var actions = 0
    var searchButton = 0
    var sortButton = 0
    var tabs = 0
    var tabRow = 0
    var tabButton = 0
    var tabText = 0

    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 390, 844, 0, 0, root):
        return 1
    if !layout.WebLayoutSetFlexStyle(tree, root, layout.WebLayoutFlexDirectionColumn,
            layout.WebLayoutJustifyContentFlexStart, layout.WebLayoutAlignItemsFlexStart, 0, 0):
        return 2

    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 390, 0, 0, 0, header):
        return 3
    if !layout.WebLayoutSetFlexStyle(tree, header, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentSpaceBetween, layout.WebLayoutAlignItemsCenter, 0, 0):
        return 4
    let headerStyle = layout.WebLayoutFindStyleIndex(tree, header)
    if headerStyle < 0:
        return 5
    tree.styles[headerStyle].paddingLeft = 16
    tree.styles[headerStyle].paddingTop = 16
    tree.styles[headerStyle].paddingRight = 16
    tree.styles[headerStyle].paddingBottom = 16
    tree.styles[headerStyle].position = layout.WebLayoutPositionSticky
    tree.styles[headerStyle].zIndex = 10

    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 76, 30, 0, 0, menuButton):
        return 6
    if !layout.WebLayoutSetFlexStyle(tree, menuButton, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentCenter, layout.WebLayoutAlignItemsCenter, 0, 0):
        return 7
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 22, 22, 0, 0, menuIcon):
        return 8
    if !layout.WebLayoutAppendChild(tree, menuButton, menuIcon):
        return 9

    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 0, 0, 0, 0, actions):
        return 10
    if !layout.WebLayoutSetFlexStyle(tree, actions, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentFlexStart, layout.WebLayoutAlignItemsCenter, 0, 12):
        return 11
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 76, 30, 0, 0, searchButton):
        return 12
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 76, 30, 0, 0, sortButton):
        return 13
    if !layout.WebLayoutAppendChild(tree, actions, searchButton):
        return 14
    if !layout.WebLayoutAppendChild(tree, actions, sortButton):
        return 15
    if !layout.WebLayoutAppendChild(tree, header, menuButton):
        return 16
    if !layout.WebLayoutAppendChild(tree, header, actions):
        return 17

    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 390, 0, 0, 0, tabs):
        return 18
    let tabsStyle = layout.WebLayoutFindStyleIndex(tree, tabs)
    if tabsStyle < 0:
        return 19
    tree.styles[tabsStyle].paddingTop = 8
    tree.styles[tabsStyle].paddingBottom = 8
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 0, 0, 0, 0, tabRow):
        return 20
    if !layout.WebLayoutSetFlexStyle(tree, tabRow, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentFlexStart, layout.WebLayoutAlignItemsCenter, 0, 8):
        return 21
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 76, 30, 0, 0, tabButton):
        return 22
    if !layout.WebLayoutSetFlexStyle(tree, tabButton, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentCenter, layout.WebLayoutAlignItemsCenter, 0, 0):
        return 23
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayInline, 0, 0, 0, 0, tabText):
        return 24
    if !layout.WebLayoutSetTextContent(tree, tabText, "视频"):
        return 25
    if !layout.WebLayoutSetFontSize(tree, tabText, 14):
        return 26
    if !layout.WebLayoutAppendChild(tree, tabButton, tabText):
        return 27
    if !layout.WebLayoutAppendChild(tree, tabRow, tabButton):
        return 28
    if !layout.WebLayoutAppendChild(tree, tabs, tabRow):
        return 29

    if !layout.WebLayoutAppendChild(tree, root, header):
        return 30
    if !layout.WebLayoutAppendChild(tree, root, tabs):
        return 31

    if !layout.WebLayoutCompute(tree, root):
        return 32

    var headerY: int32 = -1
    var headerH: int32 = -1
    var headerBoxCount: int32
    var menuX: int32 = -1
    var menuY: int32 = -1
    var tabsY: int32 = -1
    var textBoxCount: int32
    for bi in 0..<layout.WebLayoutBoxCount(tree):
        let node = layout.WebLayoutBoxNodeAt(tree, bi)
        if node == header:
            headerBoxCount = headerBoxCount + 1
            headerY = layout.WebLayoutBoxYAt(tree, bi)
            headerH = layout.WebLayoutBoxHeightAt(tree, bi)
        elif node == menuButton:
            menuX = layout.WebLayoutBoxXAt(tree, bi)
            menuY = layout.WebLayoutBoxYAt(tree, bi)
        elif node == tabs:
            tabsY = layout.WebLayoutBoxYAt(tree, bi)
        elif node == tabText:
            textBoxCount = textBoxCount + 1
    if headerY != 0:
        return 33
    if headerH < 46:
        return 34
    if headerBoxCount != 1:
        return 37
    if menuX != 16 || menuY != 16:
        return 38
    if tabsY != headerY + headerH:
        return 35
    if textBoxCount != 1:
        return 36
    return 0

fn runLayoutFixedBottomInsetSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var nav = 0
    var item = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 390, 844, 0, 0, root):
        return 1
    if !layout.WebLayoutSetRootViewport(tree, root, 390, 844):
        return 2
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 0, 0, 0, 0, nav):
        return 3
    if !layout.WebLayoutSetPosition(tree, nav, layout.WebLayoutPositionFixed):
        return 4
    if !layout.WebLayoutSetOffsetLeft(tree, nav, 0):
        return 5
    if !layout.WebLayoutSetOffsetRight(tree, nav, 0):
        return 6
    if !layout.WebLayoutSetOffsetBottom(tree, nav, 0):
        return 7
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 100, 50, 0, 0, item):
        return 8
    if !layout.WebLayoutAppendChild(tree, root, nav):
        return 9
    if !layout.WebLayoutAppendChild(tree, nav, item):
        return 10
    if !layout.WebLayoutCompute(tree, root):
        return 11

    var navX: int32 = -1
    var navY: int32 = -1
    var navW: int32 = -1
    var navH: int32 = -1
    var itemY: int32 = -1
    for bi in 0..<layout.WebLayoutBoxCount(tree):
        let node = layout.WebLayoutBoxNodeAt(tree, bi)
        if node == nav:
            navX = layout.WebLayoutBoxXAt(tree, bi)
            navY = layout.WebLayoutBoxYAt(tree, bi)
            navW = layout.WebLayoutBoxWidthAt(tree, bi)
            navH = layout.WebLayoutBoxHeightAt(tree, bi)
        elif node == item:
            itemY = layout.WebLayoutBoxYAt(tree, bi)
    if navX != 0:
        return 12
    if navY != 794:
        return 13
    if navW != 390:
        return 14
    if navH != 50:
        return 15
    if itemY != 794:
        return 16
    return 0

fn runLayoutFlexColumnTabsBeforeFlexBodySmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var header = 0
    var tabs = 0
    var body = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 390, 844, 0, 0, root):
        return 1
    if !layout.WebLayoutSetFlexStyle(tree, root, layout.WebLayoutFlexDirectionColumn,
            layout.WebLayoutJustifyContentFlexStart, layout.WebLayoutAlignItemsFlexStart, 0, 0):
        return 2
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 390, 62, 0, 0, header):
        return 3
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 390, 46, 0, 0, tabs):
        return 4
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 390, 0, 0, 0, body):
        return 5
    if !layout.WebLayoutSetFlexStyle(tree, body, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentFlexStart, layout.WebLayoutAlignItemsFlexStart, 1, 0):
        return 6
    if !layout.WebLayoutAppendChild(tree, root, header):
        return 7
    if !layout.WebLayoutAppendChild(tree, root, tabs):
        return 8
    if !layout.WebLayoutAppendChild(tree, root, body):
        return 9
    if !layout.WebLayoutCompute(tree, root):
        return 10

    var headerY: int32 = -1
    var tabsY: int32 = -1
    var bodyY: int32 = -1
    var bodyH: int32 = -1
    for bi in 0..<layout.WebLayoutBoxCount(tree):
        let node = layout.WebLayoutBoxNodeAt(tree, bi)
        if node == header:
            headerY = layout.WebLayoutBoxYAt(tree, bi)
        elif node == tabs:
            tabsY = layout.WebLayoutBoxYAt(tree, bi)
        elif node == body:
            bodyY = layout.WebLayoutBoxYAt(tree, bi)
            bodyH = layout.WebLayoutBoxHeightAt(tree, bi)
    if headerY != 0:
        echo(Fmt"flex column tabs actual headerY={headerY} tabsY={tabsY} bodyY={bodyY} bodyH={bodyH}")
        return 11
    if tabsY != 62:
        echo(Fmt"flex column tabs actual headerY={headerY} tabsY={tabsY} bodyY={bodyY} bodyH={bodyH}")
        return 12
    if bodyY != 108:
        echo(Fmt"flex column tabs actual headerY={headerY} tabsY={tabsY} bodyY={bodyY} bodyH={bodyH}")
        return 13
    if bodyH != 736:
        echo(Fmt"flex column tabs actual headerY={headerY} tabsY={tabsY} bodyY={bodyY} bodyH={bodyH}")
        return 14
    return 0

fn main(): int32 =
    let code = runLayoutBlockTreeSmoke()
    if code != 0:
        echo(Fmt"FAIL runLayoutBlockTreeSmoke: {code}")
        return code
    let gapCode = runLayoutBlockGapSmoke()
    if gapCode != 0:
        echo(Fmt"FAIL runLayoutBlockGapSmoke: {gapCode}")
        return gapCode
    let collapsedMarginCode = runLayoutBlockCollapsedMarginHeightSmoke()
    if collapsedMarginCode != 0:
        echo(Fmt"FAIL runLayoutBlockCollapsedMarginHeightSmoke: {collapsedMarginCode}")
        return collapsedMarginCode
    let aspectRatioPercentChildCode = runLayoutBlockAspectRatioPercentChildSmoke()
    if aspectRatioPercentChildCode != 0:
        echo(Fmt"FAIL runLayoutBlockAspectRatioPercentChildSmoke: {aspectRatioPercentChildCode}")
        return aspectRatioPercentChildCode
    let inlineCode = runLayoutInlineTextSmoke()
    if inlineCode != 0:
        echo(Fmt"FAIL runLayoutInlineTextSmoke: {inlineCode}")
        return inlineCode
    let inlineCenterCode = runLayoutInlineTextAlignCenterSmoke()
    if inlineCenterCode != 0:
        echo(Fmt"FAIL runLayoutInlineTextAlignCenterSmoke: {inlineCenterCode}")
        return inlineCenterCode
    let inlineLineHeightPx2Code = runLayoutInlineLineHeightPx2Smoke()
    if inlineLineHeightPx2Code != 0:
        echo(Fmt"FAIL runLayoutInlineLineHeightPx2Smoke: {inlineLineHeightPx2Code}")
        return inlineLineHeightPx2Code
    let breakAllTextWrapCode = runLayoutBreakAllTextWrapSmoke()
    if breakAllTextWrapCode != 0:
        echo(Fmt"FAIL runLayoutBreakAllTextWrapSmoke: {breakAllTextWrapCode}")
        return breakAllTextWrapCode
    let inlineMarginCode = runLayoutInlineChildMarginCountedOnceSmoke()
    if inlineMarginCode != 0:
        echo(Fmt"FAIL runLayoutInlineChildMarginCountedOnceSmoke: {inlineMarginCode}")
        return inlineMarginCode
    let utf8TextWidthCode = runLayoutUtf8TextWidthSmoke()
    if utf8TextWidthCode != 0:
        echo(Fmt"FAIL runLayoutUtf8TextWidthSmoke: {utf8TextWidthCode}")
        return utf8TextWidthCode
    let fontCascadeDeepCopyCode = runLayoutFontCascadeDeepCopySmoke()
    if fontCascadeDeepCopyCode != 0:
        echo(Fmt"FAIL runLayoutFontCascadeDeepCopySmoke: {fontCascadeDeepCopyCode}")
        return fontCascadeDeepCopyCode
    let flexChipCode = runLayoutFlexChipShrinkToContentSmoke()
    if flexChipCode != 0:
        echo(Fmt"FAIL runLayoutFlexChipShrinkToContentSmoke: {flexChipCode}")
        return flexChipCode
    let flexRowMarginCode = runLayoutFlexRowMainAxisMarginSmoke()
    if flexRowMarginCode != 0:
        echo(Fmt"FAIL runLayoutFlexRowMainAxisMarginSmoke: {flexRowMarginCode}")
        return flexRowMarginCode
    let flexColumnDefaultStretchCode = runLayoutFlexColumnDefaultStretchSmoke()
    if flexColumnDefaultStretchCode != 0:
        echo(Fmt"FAIL runLayoutFlexColumnDefaultStretchSmoke: {flexColumnDefaultStretchCode}")
        return flexColumnDefaultStretchCode
    let gridCode = runLayoutGridPlacementSmoke()
    if gridCode != 0:
        echo(Fmt"FAIL runLayoutGridPlacementSmoke: {gridCode}")
        return gridCode
    let masonryCode = runLayoutMasonryShortestColumnSmoke()
    if masonryCode != 0:
        echo(Fmt"FAIL runLayoutMasonryShortestColumnSmoke: {masonryCode}")
        return masonryCode
    let mobileMasonryWidthCode = runLayoutMasonryMobileTwoColumnWidthSmoke()
    if mobileMasonryWidthCode != 0:
        echo(Fmt"FAIL runLayoutMasonryMobileTwoColumnWidthSmoke: {mobileMasonryWidthCode}")
        return mobileMasonryWidthCode
    let virtualizedMasonryWidthCode = runLayoutVirtualizedMasonryReactColumnWidthSmoke()
    if virtualizedMasonryWidthCode != 0:
        echo(Fmt"FAIL runLayoutVirtualizedMasonryReactColumnWidthSmoke: {virtualizedMasonryWidthCode}")
        return virtualizedMasonryWidthCode
    let gridPaddingCode = runLayoutGridPaddingAutoHeightSmoke()
    if gridPaddingCode != 0:
        echo(Fmt"FAIL runLayoutGridPaddingAutoHeightSmoke: {gridPaddingCode}")
        return gridPaddingCode
    let gridRemainderCode = runLayoutGridPercentRemainderSmoke()
    if gridRemainderCode != 0:
        echo(Fmt"FAIL runLayoutGridPercentRemainderSmoke: {gridRemainderCode}")
        return gridRemainderCode
    let flexAutoCrossCode = runLayoutFlexAutoCrossEndSmoke()
    if flexAutoCrossCode != 0:
        echo(Fmt"FAIL runLayoutFlexAutoCrossEndSmoke: {flexAutoCrossCode}")
        return flexAutoCrossCode
    let flexSingleSpaceBetweenCode = runLayoutFlexSingleSpaceBetweenSmoke()
    if flexSingleSpaceBetweenCode != 0:
        echo(Fmt"FAIL runLayoutFlexSingleSpaceBetweenSmoke: {flexSingleSpaceBetweenCode}")
        return flexSingleSpaceBetweenCode
    let flexOrderCode = runLayoutFlexOrderSmoke()
    if flexOrderCode != 0:
        echo(Fmt"FAIL runLayoutFlexOrderSmoke: {flexOrderCode}")
        return flexOrderCode
    let flexGrowZeroBasisCode = runLayoutFlexGrowUsesZeroBasisSmoke()
    if flexGrowZeroBasisCode != 0:
        echo(Fmt"FAIL runLayoutFlexGrowUsesZeroBasisSmoke: {flexGrowZeroBasisCode}")
        return flexGrowZeroBasisCode
    let flexGrowAutoBasisCode = runLayoutFlexGrowIgnoresAutoBasisSmoke()
    if flexGrowAutoBasisCode != 0:
        echo(Fmt"FAIL runLayoutFlexGrowIgnoresAutoBasisSmoke: {flexGrowAutoBasisCode}")
        return flexGrowAutoBasisCode
    let inlineFlexCode = runLayoutInlineFlexStaysInLineSmoke()
    if inlineFlexCode != 0:
        echo(Fmt"FAIL runLayoutInlineFlexStaysInLineSmoke: {inlineFlexCode}")
        return inlineFlexCode
    let inlineAutoHeightCode = runLayoutInlineAutoHeightUsesLaidOutChildSmoke()
    if inlineAutoHeightCode != 0:
        echo(Fmt"FAIL runLayoutInlineAutoHeightUsesLaidOutChildSmoke: {inlineAutoHeightCode}")
        return inlineAutoHeightCode
    let blockAutoOverflowCode = runLayoutBlockAutoHeightIgnoresOverflowHiddenSmoke()
    if blockAutoOverflowCode != 0:
        echo(Fmt"FAIL runLayoutBlockAutoHeightIgnoresOverflowHiddenSmoke: {blockAutoOverflowCode}")
        return blockAutoOverflowCode
    let displayNoneCode = runLayoutDisplayNoneWithChildrenSmoke()
    if displayNoneCode != 0:
        echo(Fmt"FAIL runLayoutDisplayNoneWithChildrenSmoke: {displayNoneCode}")
        return displayNoneCode
    let blockInlineAfterBlockCode = runLayoutBlockInlineAfterAutoBlockStartsAtFlowYSmoke()
    if blockInlineAfterBlockCode != 0:
        echo(Fmt"FAIL runLayoutBlockInlineAfterAutoBlockStartsAtFlowYSmoke: {blockInlineAfterBlockCode}")
        return blockInlineAfterBlockCode
    let stickyHeaderCode = runLayoutFlexStickyHeaderFlowSmoke()
    if stickyHeaderCode != 0:
        echo(Fmt"FAIL runLayoutFlexStickyHeaderFlowSmoke: {stickyHeaderCode}")
        return stickyHeaderCode
    let fixedBottomCode = runLayoutFixedBottomInsetSmoke()
    if fixedBottomCode != 0:
        echo(Fmt"FAIL runLayoutFixedBottomInsetSmoke: {fixedBottomCode}")
        return fixedBottomCode
    let flexColumnTabsCode = runLayoutFlexColumnTabsBeforeFlexBodySmoke()
    if flexColumnTabsCode != 0:
        echo(Fmt"FAIL runLayoutFlexColumnTabsBeforeFlexBodySmoke: {flexColumnTabsCode}")
        return flexColumnTabsCode
    echo("web_runtime_layout_smoke ok")
    return 0
