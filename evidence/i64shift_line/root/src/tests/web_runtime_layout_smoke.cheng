fn runLayoutBlockAspectRatioPercentChildSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var parent = 0
    var child = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 200, 0, 0, 0, root):
        return 1
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 200, 0, 0, 0, parent):
        return 2
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 0, 0, 0, 0, child):
        return 3
    let parentStyleIdx = layout.WebLayoutFindStyleIndex(tree, parent)
    if parentStyleIdx < 0:
        return 4
    tree.styles[parentStyleIdx].aspectRatioNumerator = 7
    tree.styles[parentStyleIdx].aspectRatioDenominator = 5
    let childStyleIdx = layout.WebLayoutFindStyleIndex(tree, child)
    if childStyleIdx < 0:
        return 5
    tree.styles[childStyleIdx].width = -100
    tree.styles[childStyleIdx].height = -100
    if !layout.WebLayoutAppendChild(tree, root, parent):
        return 6
    if !layout.WebLayoutAppendChild(tree, parent, child):
        return 7
    if !layout.WebLayoutCompute(tree, root):
        return 8
    if layout.WebLayoutBoxCount(tree) != 3:
        return 9
    if layout.WebLayoutBoxNodeAt(tree, 1) != parent:
        return 10
    if layout.WebLayoutBoxNodeAt(tree, 2) != child:
        return 11
    if layout.WebLayoutBoxWidthAt(tree, 1) != 200:
        return 12
    if layout.WebLayoutBoxHeightAt(tree, 1) != 143:
        echo(Fmt"aspect parent actual h={layout.WebLayoutBoxHeightAt(tree, 1)}")
        return 13
    if layout.WebLayoutBoxWidthAt(tree, 2) != 200:
        echo(Fmt"aspect child actual w={layout.WebLayoutBoxWidthAt(tree, 2)} h={layout.WebLayoutBoxHeightAt(tree, 2)}")
        return 14
    if layout.WebLayoutBoxHeightAt(tree, 2) != 143:
        echo(Fmt"aspect child actual w={layout.WebLayoutBoxWidthAt(tree, 2)} h={layout.WebLayoutBoxHeightAt(tree, 2)}")
        return 15
    return 0

