fn runLayoutUtf8TextWidthSmoke(): int32 =
    if layout.WebLayoutEstimateTextWidth("视频", 14) != 28:
        return 1
    if layout.WebLayoutEstimateTextWidth("Run", 16) != 27:
        return 2
    if layout.WebLayoutEstimateTextWidth("A B", 16) != 22:
        return 3
    return 0

fn runLayoutFontCascadeDeepCopySmoke(): int32 =
    let data = fontfixture.MakeWebFontSfntFixture()
    var face0: font.WebFontFace
    var face1: font.WebFontFace
    var face2: font.WebFontFace
    var face3: font.WebFontFace
    if !font.WebFontLoadSfnt(data, face0):
        return 1
    if !layout.WebLayoutSetFontCascade4Weighted(face0, face1, face2, face3, 1, 400, 400, 400, 400):
        font.WebFontFree(face0)
        return 2
    let measured = layout.WebLayoutEstimateTextWidthWeighted("A A", 16, 400)
    layout.WebLayoutClearFontCascade()
    font.WebFontFree(face0)
    if measured != 26:
        echo(Fmt"font cascade deep copy measured={measured}")
        return 3
    if layout.WebLayoutEstimateTextWidth("A A", 16) != 22:
        return 4
    return 0

fn runLayoutFlexChipShrinkToContentSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var chip = 0
    var label = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 200, 40, 0, 0, root):
        return 1
    if !layout.WebLayoutSetFlexStyle(tree, root, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentFlexStart, layout.WebLayoutAlignItemsCenter, 0, 8):
        return 2
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 0, 30, 0, 0, chip):
        return 3
    if !layout.WebLayoutSetFlexStyle(tree, chip, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentFlexStart, layout.WebLayoutAlignItemsCenter, 0, 4):
        return 4
    let chipIdx = layout.WebLayoutFindStyleIndex(tree, chip)
    if chipIdx < 0:
        return 5
    tree.styles[chipIdx].paddingLeft = 12
    tree.styles[chipIdx].paddingRight = 12
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayInline, 0, 0, 0, 0, label):
        return 6
    if !layout.WebLayoutSetTextContent(tree, label, "视频"):
        return 7
    if !layout.WebLayoutSetFontSize(tree, label, 14):
        return 8
    if !layout.WebLayoutAppendChild(tree, chip, label):
        return 9
    if !layout.WebLayoutAppendChild(tree, root, chip):
        return 10
    if !layout.WebLayoutCompute(tree, root):
        return 11
    if layout.WebLayoutBoxWidthAt(tree, 1) != 52:
        echo(Fmt"chip width actual {layout.WebLayoutBoxWidthAt(tree, 1)}")
        return 12
    return 0

fn runLayoutFlexRowMainAxisMarginSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var label = 0
    var badge = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 120, 20, 0, 0, root):
        return 1
    if !layout.WebLayoutSetFlexStyle(tree, root, layout.WebLayoutFlexDirectionRow,
            layout.WebLayoutJustifyContentFlexStart, layout.WebLayoutAlignItemsFlexStart, 0, 4):
        return 2
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 20, 10, 0, 0, label):
        return 3
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 20, 10, 4, 0, badge):
        return 4
    if !layout.WebLayoutAppendChild(tree, root, label):
        return 5
    if !layout.WebLayoutAppendChild(tree, root, badge):
        return 6
    if !layout.WebLayoutCompute(tree, root):
        return 7

    var labelX: int32 = -1
    var badgeX: int32 = -1
    for bi in 0..<layout.WebLayoutBoxCount(tree):
        let node = layout.WebLayoutBoxNodeAt(tree, bi)
        if node == label:
            labelX = layout.WebLayoutBoxXAt(tree, bi)
        elif node == badge:
            badgeX = layout.WebLayoutBoxXAt(tree, bi)
    if labelX != 0:
        echo(Fmt"flex row margin actual labelX={labelX} badgeX={badgeX}")
        return 8
    if badgeX != 28:
        echo(Fmt"flex row margin actual labelX={labelX} badgeX={badgeX}")
        return 9
    return 0

fn runLayoutFlexColumnDefaultStretchSmoke(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)

    var root = 0
    var card = 0
    var label = 0
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayFlex, 300, 80, 0, 0, root):
        return 1
    let rootIdx = layout.WebLayoutFindStyleIndex(tree, root)
    if rootIdx < 0:
        return 2
    tree.styles[rootIdx].flexDirection = layout.WebLayoutFlexDirectionColumn
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayBlock, 0, 20, 0, 0, card):
        return 3
    if !layout.WebLayoutCreateStyleBox(tree, layout.WebLayoutDisplayInline, 0, 0, 0, 0, label):
        return 4
    if !layout.WebLayoutSetTextContent(tree, label, "Profile"):
        return 5
    if !layout.WebLayoutSetFontSize(tree, label, 16):
        return 6
    if !layout.WebLayoutAppendChild(tree, card, label):
        return 7
    if !layout.WebLayoutAppendChild(tree, root, card):
        return 8
    if !layout.WebLayoutCompute(tree, root):
        return 9

    var cardW: int32 = -1
    var labelW: int32 = -1
    for bi in 0..<layout.WebLayoutBoxCount(tree):
        let node = layout.WebLayoutBoxNodeAt(tree, bi)
        if node == card:
            cardW = layout.WebLayoutBoxWidthAt(tree, bi)
        elif node == label:
            labelW = layout.WebLayoutBoxWidthAt(tree, bi)
    if labelW <= 0:
        return 10
    if cardW != 300:
        echo(Fmt"flex column default stretch actual cardW={cardW} labelW={labelW}")
        return 11
    return 0

fn runLayoutGridPlacementSmoke(): int32 =
