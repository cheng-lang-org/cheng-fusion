# slice-3 gate ②: full libp2p Noise-XX handshake, in-process, where message2
# and message3's Noise payloads carry real libp2p NoiseHandshakePayload
# bytes (src/libp2p/protocols/secure/noise_payload.cheng) -- the long-term
# ed25519 identity key signing the ephemeral X25519 Noise static key, per
# libp2p specs/noise/README.md -- not the empty payloads used by the
# slice-3a self-consistency probe. Runs both directions of AEAD transport
# afterward and checks the identity binding is rejected under mutation.

import std/system
import std/result
import std/rawbytes
import std/crypto/curve25519
import std/crypto/noise_xx as noise
import cheng/libp2p/crypto/ed25519/ed25519 as ed25519
import cheng/libp2p/protocols/secure/noise_payload as noisepay
import std/strutils as strutil

const
    # Fixed (non-random) seeds so every run is bit-exact reproducible. Not
    # secret, test fixtures only.
    initNoiseStaticPrivHex = "1111111111111111111111111111111111111111111111111111111111111111"
    respNoiseStaticPrivHex = "2222222222222222222222222222222222222222222222222222222222222222"
    initNoiseEphemeralPrivHex = "3333333333333333333333333333333333333333333333333333333333333333"
    respNoiseEphemeralPrivHex = "4444444444444444444444444444444444444444444444444444444444444444"
    initIdentitySeedHex = "5555555555555555555555555555555555555555555555555555555555555555"
    respIdentitySeedHex = "6666666666666666666666666666666666666666666666666666666666666666"
    otherIdentitySeedHex = "7777777777777777777777777777777777777777777777777777777777777777"

fn noiseKeyPairFromHex(privHex: str): curve25519.Curve25519KeyPair =
    let priv: Bytes = BytesFromHex(privHex)
    let pubRes: Result[Bytes] = curve25519.curve25519PublicFromPrivate(priv)
    assert(IsOk(pubRes), "smoke: derive noise static/ephemeral public key")
    var kp: curve25519.Curve25519KeyPair
    kp.priv = priv
    kp.pub = Value(pubRes)
    return kp

fn main(): int32 =
    var initiator: noise.HandshakeState = noise.noiseHandshakeInit(noiseKeyPairFromHex(initNoiseStaticPrivHex), EmptyBytes())
    noise.noiseHandshakeSetEphemeral(initiator, noiseKeyPairFromHex(initNoiseEphemeralPrivHex))
    var responder: noise.HandshakeState = noise.noiseHandshakeInit(noiseKeyPairFromHex(respNoiseStaticPrivHex), EmptyBytes())
    noise.noiseHandshakeSetEphemeral(responder, noiseKeyPairFromHex(respNoiseEphemeralPrivHex))

    # BytesFromHex on a 32-byte-hex seed yields exactly 32 raw bytes;
    # keyPairFromSeed hashes any non-32-byte seed through SHA-512 first, so
    # this is a plain fixed 32-byte Ed25519 seed, not a special case.
    # (initIdentity/respIdentity/otherIdentity are used directly as
    # `<result>.publicKey`/`<result>.privateKey` below rather than copied
    # into a freshly-declared local of the cross-module KeyPair aggregate
    # type -- `var x: t.KeyPair; x.publicKey = ...` trips a cheng_cold
    # ambiguous-imported-type-name edge case isolated with a minimal repro
    # during this slice; reading fields straight off Value(...) avoids it.)
    let initIdentityRes = ed25519.keyPairFromSeed(BytesFromHex(initIdentitySeedHex))
    assert(IsOk(initIdentityRes), "smoke: derive initiator identity keypair")
    let initIdentity = Value(initIdentityRes)
    let respIdentityRes = ed25519.keyPairFromSeed(BytesFromHex(respIdentitySeedHex))
    assert(IsOk(respIdentityRes), "smoke: derive responder identity keypair")
    let respIdentity = Value(respIdentityRes)
    let otherIdentityRes = ed25519.keyPairFromSeed(BytesFromHex(otherIdentitySeedHex))
    assert(IsOk(otherIdentityRes), "smoke: derive imposter identity keypair")
    let otherIdentity = Value(otherIdentityRes)

    let initNoiseStaticPub: Bytes = noiseKeyPairFromHex(initNoiseStaticPrivHex).pub
    let respNoiseStaticPub: Bytes = noiseKeyPairFromHex(respNoiseStaticPrivHex).pub

    # -> e (empty payload, matches Noise message1's usual empty early-data)
    let msg1Res: Result[Bytes] = noise.noiseWriteMessage1(initiator, EmptyBytes())
    assert(IsOk(msg1Res), "smoke: WriteMessage1")
    let read1Res: Result[Bytes] = noise.noiseReadMessage1(responder, Value(msg1Res))
    assert(IsOk(read1Res), "smoke: ReadMessage1")

    # <- e, ee, s, es -- payload carries responder's libp2p identity payload.
    let respPayloadRes: Result[Bytes] = noisepay.buildNoiseIdentityPayload(respIdentity.privateKey.data, respIdentity.publicKey.data, respNoiseStaticPub)
    assert(IsOk(respPayloadRes), "smoke: build responder identity payload")
    let msg2Res: Result[Bytes] = noise.noiseWriteMessage2(responder, Value(respPayloadRes))
    assert(IsOk(msg2Res), "smoke: WriteMessage2")
    let read2Res: Result[Bytes] = noise.noiseReadMessage2(initiator, Value(msg2Res))
    assert(IsOk(read2Res), "smoke: ReadMessage2")

    # Initiator has now received the responder's Noise static key inside the
    # handshake (initiator.rs) -- decode+verify the payload it just read
    # against exactly that key, the identity-binding libp2p actually relies on.
    let respParsedRes: Result[noisepay.NoiseIdentityPayload] = noisepay.parseNoiseIdentityPayload(Value(read2Res))
    assert(IsOk(respParsedRes), "smoke: parse responder identity payload")
    assert(noisepay.verifyNoiseIdentityPayload(Value(respParsedRes), initiator.rs), "smoke: responder identity payload must verify against the Noise static key initiator actually received")

    # -> s, se -- payload carries initiator's libp2p identity payload.
    let initPayloadRes: Result[Bytes] = noisepay.buildNoiseIdentityPayload(initIdentity.privateKey.data, initIdentity.publicKey.data, initNoiseStaticPub)
    assert(IsOk(initPayloadRes), "smoke: build initiator identity payload")
    let msg3Res: Result[Bytes] = noise.noiseWriteMessage3(initiator, Value(initPayloadRes))
    assert(IsOk(msg3Res), "smoke: WriteMessage3")
    let read3Res: Result[Bytes] = noise.noiseReadMessage3(responder, Value(msg3Res))
    assert(IsOk(read3Res), "smoke: ReadMessage3")

    let initParsedRes: Result[noisepay.NoiseIdentityPayload] = noisepay.parseNoiseIdentityPayload(Value(read3Res))
    assert(IsOk(initParsedRes), "smoke: parse initiator identity payload")
    assert(noisepay.verifyNoiseIdentityPayload(Value(initParsedRes), responder.rs), "smoke: initiator identity payload must verify against the Noise static key responder actually received")

    let hInit: Bytes = noise.noiseHandshakeHash(initiator)
    let hResp: Bytes = noise.noiseHandshakeHash(responder)
    assert(BytesEqual(hInit, hResp), "smoke: handshake hash must match on both sides")

    var initC1: noise.CipherState
    var initC2: noise.CipherState
    let splitIRes: Result[bool] = noise.noiseHandshakeSplit(initiator, initC1, initC2)
    assert(IsOk(splitIRes), "smoke: initiator Split")
    var respC1: noise.CipherState
    var respC2: noise.CipherState
    let splitRRes: Result[bool] = noise.noiseHandshakeSplit(responder, respC1, respC2)
    assert(IsOk(splitRRes), "smoke: responder Split")

    # Round-trip one transport message each direction.
    let outRes: Result[Bytes] = noise.cipherStateEncryptWithAd(initC1, EmptyBytes(), BytesFromString("hello responder"))
    assert(IsOk(outRes), "smoke: initiator->responder transport encrypt")
    let inRes: Result[Bytes] = noise.cipherStateDecryptWithAd(respC1, EmptyBytes(), Value(outRes))
    assert(IsOk(inRes), "smoke: initiator->responder transport decrypt")
    assert(BytesEqual(Value(inRes), BytesFromString("hello responder")), "smoke: initiator->responder transport payload mismatch")

    let backRes: Result[Bytes] = noise.cipherStateEncryptWithAd(respC2, EmptyBytes(), BytesFromString("hello initiator"))
    assert(IsOk(backRes), "smoke: responder->initiator transport encrypt")
    let backInRes: Result[Bytes] = noise.cipherStateDecryptWithAd(initC2, EmptyBytes(), Value(backRes))
    assert(IsOk(backInRes), "smoke: responder->initiator transport decrypt")
    assert(BytesEqual(Value(backInRes), BytesFromString("hello initiator")), "smoke: responder->initiator transport payload mismatch")

    # --- identity-binding mutation-negative tests -------------------------

    # A payload signed by a *different* identity key must fail verification
    # even though it is a perfectly well-formed, correctly-signed payload.
    let wrongPayloadRes: Result[Bytes] = noisepay.buildNoiseIdentityPayload(otherIdentity.privateKey.data, otherIdentity.publicKey.data, respNoiseStaticPub)
    assert(IsOk(wrongPayloadRes), "smoke: build imposter payload")
    let wrongParsedRes: Result[noisepay.NoiseIdentityPayload] = noisepay.parseNoiseIdentityPayload(Value(wrongPayloadRes))
    assert(IsOk(wrongParsedRes), "smoke: parse imposter payload")
    assert(noisepay.verifyNoiseIdentityPayload(Value(wrongParsedRes), respNoiseStaticPub), "smoke: imposter payload is internally self-consistent (sanity check)")
    # But binding it to the *real* responder connection (a different, wrong
    # peer's payload substituted onto this Noise static key) must fail --
    # this is the actual MITM the payload exists to prevent.
    let respParsed2Res: Result[noisepay.NoiseIdentityPayload] = noisepay.parseNoiseIdentityPayload(Value(respPayloadRes))
    assert(IsOk(respParsed2Res), "smoke: re-parse responder payload")
    var swapped: noisepay.NoiseIdentityPayload = Value(respParsed2Res)
    swapped.identityKeyBytes = Value(wrongParsedRes).identityKeyBytes
    assert(! noisepay.verifyNoiseIdentityPayload(swapped, respNoiseStaticPub), "smoke: swapped-identity payload must be rejected")

    # A flipped signature byte must fail verification.
    var flippedSig: noisepay.NoiseIdentityPayload = Value(respParsed2Res)
    var sigBytes: Bytes = BytesSlice(flippedSig.identitySig, 0, BytesLen(flippedSig.identitySig))
    BytesSet(sigBytes, 0, BytesGet(sigBytes, 0) ^ 1)
    flippedSig.identitySig = sigBytes
    assert(! noisepay.verifyNoiseIdentityPayload(flippedSig, respNoiseStaticPub), "smoke: flipped identity_sig must be rejected")

    # Verifying against the wrong Noise static key (the field the signature
    # actually binds) must also fail.
    assert(! noisepay.verifyNoiseIdentityPayload(Value(respParsed2Res), initNoiseStaticPub), "smoke: identity payload must not verify against an unrelated Noise static key")

    echo("noise_xx_libp2p_payload_smoke ok (real libp2p identity payloads carried inside XX message2/message3)")
    return 0
