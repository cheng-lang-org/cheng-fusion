# M6: two-level mixed -- outer DYNAMIC seq, inner FIXED array, tail scalar, const idx.
type
    Col =
        a: int32
        b: int32

type
    Row =
        cols: Col[4]

type
    Grid =
        rows: Row[]

fn main(): int32 =
    var g: Grid
    var r0: Row
    r0.cols[0].a = 1
    r0.cols[1].a = 2
    add(g.rows, r0)
    var r1: Row
    r1.cols[0].a = 3
    r1.cols[1].a = 4
    add(g.rows, r1)

    g.rows[0].cols[1].a = 999

    if g.rows[0].cols[1].a != 999:
        return 1
    if g.rows[0].cols[0].a != 1:
        return 2
    if g.rows[1].cols[0].a != 3:
        return 3
    if g.rows[1].cols[1].a != 4:
        return 4
    return 0
