import std/os
import std/seqs as seqs
import cheng/std/bytes_layout as layout
import cheng/core/lang/diagnostic_failure as diagnostic_failure
import cheng/core/lang/parser
import cheng/core/lang/parser_diagnostic_authority as authority
import cheng/core/tooling/compiler_csg
import cheng/core/tooling/compiler_parser_receipt as parser_receipt

# Synthetic module gate only. It does not prove production parser projection
# wiring; production acceptance requires a real parser sidecar fixture.

fn ExactCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(seed)
    return out

fn SealFixture(
        value: var authority.ParserDiagnosticAuthority,
        expected: var layout.FixedBytes32[]) =
    let projection =
        authority.ParserDiagnosticAuthorityParserProjectionCidAt(
            value, 0)
    add(value.producerProjectionCids, projection)
    add(expected, projection)
    add(value.proofCids,
        authority.ParserDiagnosticAuthorityRowProofCid(value, 0))
    value.authorityRootCid =
        authority.ParserDiagnosticAuthorityRootCid(value)

fn BuildCanonicalFixture(
        value: var authority.ParserDiagnosticAuthority,
        expected: var layout.FixedBytes32[]) =
    value = authority.ParserDiagnosticAuthority()
    expected = []
    value.schemaVersion =
        authority.ParserDiagnosticAuthoritySchemaVersionLatest
    add(value.authorityKinds,
        authority.ParserDiagnosticAuthorityKindCanonicalSidecar)
    add(value.parserLocalProducerSourceRows, 0)
    add(value.portableProducerSourceIndexes, 3)
    add(value.producerSourceByteLengths, 80)
    add(value.producerContentCids, ExactCid(3))
    add(value.parserInputCids, ExactCid(4))
    add(value.sourceSidecarCids, ExactCid(5))
    add(value.diagnosticCompletionCids, ExactCid(6))
    add(value.anchorKinds,
        authority.
            ParserDiagnosticAuthorityAnchorParserNodeOwnerDeclaration)
    add(value.canonicalParserNodeRows, 7)
    add(value.producerParserNodeRows, 11)
    add(value.parserNodeKinds, 9)
    add(value.parserNodeSpanStartBytes, 24)
    add(value.parserNodeSpanEndBytes, 36)
    add(value.ownerDeclarationSourceLocalRows, 2)
    add(value.ownerDeclarationKinds, 4)
    add(value.ownerDeclarationSpanStartBytes, 8)
    add(value.ownerDeclarationSpanEndBytes, 64)
    add(value.diagnosticSpanIds, 6)
    add(value.diagnosticSpanStartBytes, 24)
    add(value.diagnosticSpanEndBytes, 36)
    add(value.severities,
        authority.ParserDiagnosticAuthoritySeverityError)
    add(value.codes, "CHENG-PARSER-NODE")
    add(value.messages, "exact parser node failed")
    SealFixture(value, expected)

fn ResealInternalForAttack(
        value: var authority.ParserDiagnosticAuthority) =
    value.producerProjectionCids[0] =
        authority.ParserDiagnosticAuthorityParserProjectionCidAt(
            value, 0)
    value.proofCids[0] =
        authority.ParserDiagnosticAuthorityRowProofCid(value, 0)
    value.authorityRootCid =
        authority.ParserDiagnosticAuthorityRootCid(value)

fn RunProductionParserWiring() =
    let sourceText =
        "fn identity(x: int32): int32 =\n    return x\n\nfn main(): int32 =\n    return identity 1\n"
    var declarations: parser.NormalizedFunctionDecl[]
    var err: str
    var identityDeclaration: parser.NormalizedFunctionDecl
    identityDeclaration.name = "identity"
    identityDeclaration.lineIndex = 1
    identityDeclaration.signatureStartColumn = 0
    identityDeclaration.nameStartColumn = 3
    identityDeclaration.nameEndColumn = 11
    identityDeclaration.signatureEndLineIndex = 1
    identityDeclaration.signatureEndColumn = 30
    identityDeclaration.bodyStartLineIndex = 1
    identityDeclaration.bodyStartColumn = 30
    identityDeclaration.surfaceKeyword = "fn"
    add(declarations, identityDeclaration)
    var mainDeclaration: parser.NormalizedFunctionDecl
    mainDeclaration.name = "main"
    mainDeclaration.lineIndex = 4
    mainDeclaration.signatureStartColumn = 0
    mainDeclaration.nameStartColumn = 3
    mainDeclaration.nameEndColumn = 7
    mainDeclaration.signatureEndLineIndex = 4
    mainDeclaration.signatureEndColumn = 18
    mainDeclaration.bodyStartLineIndex = 4
    mainDeclaration.bodyStartColumn = 18
    mainDeclaration.surfaceKeyword = "fn"
    add(declarations, mainDeclaration)
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    var identity: parser_receipt.ParserNormalizedExprFunctionIdentity
    identity.sourceIndex = 7
    identity.functionIndex = 0
    identity.sourcePath = "src/imported_authority_fixture.cheng"
    identity.ownerModulePath = "imported/authority_fixture"
    identity.functionName = "identity"
    identity.signatureLineNumber = 1
    identity.endLineNumber = 2
    add(identities, identity)
    var mainIdentity: parser_receipt.ParserNormalizedExprFunctionIdentity
    mainIdentity.sourceIndex = 7
    mainIdentity.functionIndex = 1
    mainIdentity.sourcePath = "src/imported_authority_fixture.cheng"
    mainIdentity.ownerModulePath = "imported/authority_fixture"
    mainIdentity.functionName = "main"
    mainIdentity.signatureLineNumber = 4
    mainIdentity.endLineNumber = 5
    add(identities, mainIdentity)
    os.SetEnv("CHENG_STRICT_CALL_SYNTAX", "1")
    var tree: parser.ParserValueExprTree
    assert(!parser.ParserValueExprReadTreeFromText(
               sourceText, tree, err),
           "parser diagnostic authority: production SpaceCall parsed")
    var artifact: diagnostic_failure.DiagnosticFailureArtifact
    assert(parser.ParserValueExprTreeFailureArtifactMoveInto(
               tree, artifact, err), err)
    var productionAuthority: authority.ParserDiagnosticAuthority
    var expected: layout.FixedBytes32[]
    var sidecar: parser_receipt.ParserCanonicalSourceSidecar
    assert(parser_receipt.ParserDiagnosticFailureAuthorityBuildInto(
               7,
               sourceText,
               sourceText,
               tree,
               identities,
               declarations,
               artifact,
               productionAuthority,
               expected,
               sidecar,
               err), err)
    assert(productionAuthority.parserLocalProducerSourceRows[0] == 0 &&
           productionAuthority.portableProducerSourceIndexes[0] == 7 &&
           productionAuthority.producerParserNodeRows[0] ==
               artifact.parserNodeIds[0] &&
           layout.FixedBytes32Equal(
               expected[0], sidecar.diagnosticProofRaw32s[0]) &&
           authority.ParserDiagnosticAuthorityStrictValidateInto(
               productionAuthority, expected, err),
           "parser diagnostic authority: production parser wiring split")
    assert(diagnostic_failure.DiagnosticFailureArtifactBindParserAuthorityInto(
               artifact,
               productionAuthority.authorityRootCid,
               err) &&
           layout.FixedBytes32Equal(
               artifact.parserDiagnosticAuthorityRootCid,
               productionAuthority.authorityRootCid) &&
           diagnostic_failure.DiagnosticFailureArtifactStrictValidateInto(
               artifact, err),
           "parser diagnostic authority: production artifact root binding split")
    compiler_csg.CompilerCsgParserCanonicalSourceSidecarRelease(
        sidecar)
    seqs.freeSeq(identities)
    seqs.freeSeq(declarations)
    parser.ParserValueExprTreeRelease(tree)
    var artifactRelease: diagnostic_failure.DiagnosticFailureArtifactReleaseReceipt
    diagnostic_failure.DiagnosticFailureArtifactReleaseInto(
        artifact, artifactRelease)
    var authorityRelease: authority.ParserDiagnosticAuthorityReleaseReceipt
    authority.ParserDiagnosticAuthorityReleaseInto(
        productionAuthority, authorityRelease)
    seqs.freeSeq(expected)

fn main(): int32 =
    var err: str
    RunProductionParserWiring()
    var canonical: authority.ParserDiagnosticAuthority
    var canonicalExpected: layout.FixedBytes32[]
    BuildCanonicalFixture(canonical, canonicalExpected)
    assert(authority.ParserDiagnosticAuthorityStrictValidateInto(
               canonical, canonicalExpected, err), err)
    assert(authority.ParserDiagnosticAuthorityPhysicalBufferCount(
               canonical) == 26 &&
           authority.ParserDiagnosticAuthorityDynamicSequenceBytes(
               canonical, false) > Int64(0) &&
           authority.ParserDiagnosticAuthorityDynamicSequenceBytes(
               canonical, true) >=
               authority.ParserDiagnosticAuthorityDynamicSequenceBytes(
                   canonical, false) &&
           authority.ParserDiagnosticAuthorityScalarBytes(canonical) ==
               Int64(sizeof(authority.ParserDiagnosticAuthority)),
           "parser diagnostic authority: ledger split")

    var nodeAttack: authority.ParserDiagnosticAuthority
    assert(authority.ParserDiagnosticAuthorityCloneInto(
               canonical, canonicalExpected, nodeAttack, err), err)
    nodeAttack.canonicalParserNodeRows[0] = 8
    nodeAttack.producerParserNodeRows[0] = 12
    ResealInternalForAttack(nodeAttack)
    assert(!authority.ParserDiagnosticAuthorityStrictValidateInto(
                nodeAttack, canonicalExpected, err) &&
           err ==
               " parser diagnostic authority: producer projection authority split",
           "parser diagnostic authority: recomputed node attack survived")
    var nodeAttackRelease: authority.ParserDiagnosticAuthorityReleaseReceipt
    authority.ParserDiagnosticAuthorityReleaseInto(
        nodeAttack, nodeAttackRelease)

    var containmentAttack: authority.ParserDiagnosticAuthority
    assert(authority.ParserDiagnosticAuthorityCloneInto(
               canonical, canonicalExpected, containmentAttack, err), err)
    containmentAttack.ownerDeclarationSpanEndBytes[0] = 32
    assert(!authority.ParserDiagnosticAuthorityStrictValidateInto(
                containmentAttack, canonicalExpected, err) &&
           err ==
               " parser diagnostic authority: owner containment split",
           "parser diagnostic authority: owner containment attack survived")
    var containmentRelease: authority.ParserDiagnosticAuthorityReleaseReceipt
    authority.ParserDiagnosticAuthorityReleaseInto(
        containmentAttack, containmentRelease)

    var sidecarAttack: authority.ParserDiagnosticAuthority
    assert(authority.ParserDiagnosticAuthorityCloneInto(
               canonical, canonicalExpected, sidecarAttack, err), err)
    sidecarAttack.sourceSidecarCids[0] = layout.FixedBytes32()
    assert(!authority.ParserDiagnosticAuthorityStrictValidateInto(
                sidecarAttack, canonicalExpected, err),
           "parser diagnostic authority: zero sidecar survived")
    var sidecarRelease: authority.ParserDiagnosticAuthorityReleaseReceipt
    authority.ParserDiagnosticAuthorityReleaseInto(
        sidecarAttack, sidecarRelease)

    var independentClone: authority.ParserDiagnosticAuthority
    assert(authority.ParserDiagnosticAuthorityCloneInto(
               canonical, canonicalExpected, independentClone, err), err)
    independentClone.messages[0] = "independent clone"
    assert(canonical.messages[0] == "exact parser node failed" &&
           independentClone.messages[0] == "independent clone",
           "parser diagnostic authority: clone storage aliases source")
    var independentRelease: authority.ParserDiagnosticAuthorityReleaseReceipt
    authority.ParserDiagnosticAuthorityReleaseInto(
        independentClone, independentRelease)

    let canonicalRoot = canonical.authorityRootCid
    assert(authority.ParserDiagnosticAuthorityCloneInto(
               canonical, canonicalExpected, canonical, err) &&
           layout.FixedBytes32Equal(
               canonical.authorityRootCid, canonicalRoot),
           "parser diagnostic authority: self clone split")
    assert(!authority.ParserDiagnosticAuthorityMoveInto(
                canonical, canonical, canonicalExpected, err) &&
           authority.ParserDiagnosticAuthorityStrictValidateInto(
               canonical, canonicalExpected, err),
           "parser diagnostic authority: self move changed source")

    var moved: authority.ParserDiagnosticAuthority
    var moveSource: authority.ParserDiagnosticAuthority
    assert(authority.ParserDiagnosticAuthorityCloneInto(
               canonical, canonicalExpected, moveSource, err) &&
           authority.ParserDiagnosticAuthorityMoveInto(
               moved, moveSource, canonicalExpected, err) &&
           authority.ParserDiagnosticAuthorityReleased(moveSource) &&
           authority.ParserDiagnosticAuthorityStrictValidateInto(
               moved, canonicalExpected, err),
           "parser diagnostic authority: move split")
    var movedRelease: authority.ParserDiagnosticAuthorityReleaseReceipt
    authority.ParserDiagnosticAuthorityReleaseInto(moved, movedRelease)

    assert(authority.ParserDiagnosticAuthorityPhysicalBufferCount(
               canonical) == 26,
           "parser diagnostic authority: expected 26 owned sequences")
    var firstRelease: authority.ParserDiagnosticAuthorityReleaseReceipt
    authority.ParserDiagnosticAuthorityReleaseInto(
        canonical, firstRelease)
    assert(firstRelease.hadPayload &&
           firstRelease.sequenceCapacityBefore > Int64(0) &&
           firstRelease.logicalStringCountBefore == Int64(2) &&
           firstRelease.physicalFreeCount >= Int64(26) &&
           firstRelease.storageReleased &&
           authority.ParserDiagnosticAuthorityReleased(canonical),
           "parser diagnostic authority: release incomplete")
    var secondRelease: authority.ParserDiagnosticAuthorityReleaseReceipt
    authority.ParserDiagnosticAuthorityReleaseInto(
        canonical, secondRelease)
    assert(!secondRelease.hadPayload &&
           secondRelease.sequenceCapacityBefore == Int64(0) &&
           secondRelease.logicalStringCountBefore == Int64(0) &&
           secondRelease.physicalFreeCount == Int64(0) &&
           secondRelease.orcReleaseCount == Int64(0) &&
           secondRelease.storageReleased,
           "parser diagnostic authority: second release is not idempotent")

    os.WriteLine(
        os.Get_stdout(),
        "parser_diagnostic_authority module_gate_ok synthetic_fixture=1 production_parser_wiring=1 local0_global7=1")
    return 0
