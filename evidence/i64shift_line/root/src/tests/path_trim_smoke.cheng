import cheng/core/tooling/path as chengpath

fn main(): int32 =
    let trimmed = chengpath.PathTrim("  /tmp/demo  ")
    assert(trimmed == "/tmp/demo", " path trim: strip bridge")
    assert(chengpath.PathNonEmpty("  value  "), " path trim: non empty")
    # Early-exit shapes (empty / already-clean / all-ws / dual-end)
    assert(chengpath.PathTrim("") == "", " path trim: empty")
    assert(chengpath.PathTrim("/tmp/demo") == "/tmp/demo", " path trim: clean identity")
    assert(chengpath.PathTrim("   ") == "", " path trim: all space")
    assert(chengpath.PathTrim("\t\n\r x \r\n\t") == "x", " path trim: full ws both ends")
    assert(chengpath.PathTrim("a b") == "a b", " path trim: inner space preserved")
    echo(" path_trim_smoke ok")
    return 0
