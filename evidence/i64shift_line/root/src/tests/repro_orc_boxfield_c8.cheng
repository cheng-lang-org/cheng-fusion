import std/system
import std/hashmaps as hashmaps

type
    ReproBox8 = ref object
        m: hashmaps.HashMapStrInt

@borrows
fn reproNestedSeqRoundtrip8(b: ReproBox8) =
    # take bare seq members straight through the aggregate field (two hops),
    # skipping the aggregate wrapper local entirely
    var keys = b.m.keys
    b.m.keys = []
    var vals = b.m.vals
    b.m.vals = []
    b.m.keys = keys
    b.m.vals = vals

fn main() =
    var b: ReproBox8 = new(ReproBox8)
    hashmaps.HashMapStrIntInitInPlace(b.m, 64)
    hashmaps.HashMapStrIntPut(b.m, "alpha", 0)
    reproNestedSeqRoundtrip8(b)
    var found: bool
    let got = hashmaps.HashMapStrIntGetMutEx(b.m, "alpha", found)
    assert(found && got == 0, "repro C8: nested seq roundtrip")
    echo("repro_orc_boxfield_c8 ok")
