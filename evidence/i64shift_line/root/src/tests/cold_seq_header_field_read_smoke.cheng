fn main(): int32 =
    var texts: str[]
    if texts.buffer != nil || texts.cap != 0 || texts.len != 0:
        return 1
    add(texts, "cheng")
    if texts.buffer == nil || texts.cap < 1 || texts.len != 1:
        return 2

    var values: int32[]
    add(values, 79)
    if values.buffer == nil || values.cap < 1 || values.len != 1:
        return 3
    return values[0] - 79
