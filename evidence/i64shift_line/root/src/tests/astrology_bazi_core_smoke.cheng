import std/system
import std/strutils as strutil
import cheng/apps/astrology/astrology_bazi_core as bazi

fn main(): int32 =
    var resultJson: str
    var activeDayunIdx: int32
    let ok = bazi.AstrologyBaziBuildResultJson(1990,
                                                1,
                                                1,
                                                23,
                                                0,
                                                "男",
                                                "Asia/Shanghai",
                                                116400,
                                                true,
                                                false,
                                                "00:00",
                                                2026,
                                                resultJson,
                                                activeDayunIdx)
    assert(ok, " bazi core: default chart builds")
    assert(activeDayunIdx == 2, " bazi core: active dayun index")
    assert(strutil.Contains(resultJson, "\"yearPillar\":{\"gan\":\"己\",\"zhi\":\"巳\""), " bazi core: year pillar")
    assert(strutil.Contains(resultJson, "\"dayPillar\":{\"gan\":\"丙\",\"zhi\":\"寅\""), " bazi core: day pillar")
    assert(strutil.Contains(resultJson, "\"hourPillar\":{\"gan\":\"庚\",\"zhi\":\"子\""), " bazi core: hour pillar")
    assert(strutil.Contains(resultJson, "\"wuxingCount\":{\"木\":1,\"火\":3,\"土\":1,\"金\":1,\"水\":2}"), " bazi core: wuxingCount matches PWA calculateBaziChart")
    assert(strutil.Contains(resultJson, "\"napilar\""), " bazi core: keeps React napilar spelling")
    assert(strutil.Contains(resultJson, "\"dayunStartAge\":9"), " bazi core: dayun start age")
    return 0
