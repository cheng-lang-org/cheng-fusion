type R5Task = object
    modulePath: str

var
    r5GlobalTasks: R5Task[]

fn R5Prepare(tasks: R5Task[]) =
    r5GlobalTasks = tasks
    var total = 0
    for i in 0..<tasks.len:
        total = total + 1
    echo(Fmt"r5 prepared {total}")

fn main(): int32 =
    var made: R5Task[]
    var t: R5Task
    t.modulePath = "a"
    add(made, t)
    R5Prepare(made)
    return 0
