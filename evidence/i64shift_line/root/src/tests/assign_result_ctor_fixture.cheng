import std/result

fn assignOkThenErr(flag: int32): int32 =
    var r: Result[str]
    r = Ok[str]("payload")
    if flag == 0:
        r = Err[str]("boom")
    if IsErr(r):
        return 1
    return 2

fn assignErrThenOk(flag: int32): int32 =
    var r: Result[str]
    r = Err[str]("boom")
    if flag != 0:
        r = Ok[str]("payload")
    if IsErr(r):
        return 3
    return 4

fn main(): int32 =
    if assignOkThenErr(1) != 2:
        return 11
    if assignOkThenErr(0) != 1:
        return 12
    if assignErrThenOk(0) != 3:
        return 13
    if assignErrThenOk(1) != 4:
        return 14
    echo("assign_result_ctor_fixture ok")
    return 0
