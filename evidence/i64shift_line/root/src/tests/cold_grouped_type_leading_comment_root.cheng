import cheng/tests/cold_grouped_type_leading_comment_module as grouped

fn main(): int32 =
    let record: grouped.GroupedTypeLeadingCommentRecord =
        grouped.GroupedTypeLeadingCommentRecord(value: 40, delta: 2)
    let tail: grouped.GroupedTypeLeadingCommentTail =
        grouped.GroupedTypeLeadingCommentTail(value: record.value + record.delta)
    return tail.value - 42
