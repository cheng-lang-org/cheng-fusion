import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_loop as loop

fn check(cond: bool, code: int32): int32 =
    if cond:
        return 0
    return code

fn appendI32Slot(bodyIR: var ir.BodyIR,
                 name: str): int32 =
    var slot: ir.LocalSlot
    slot.id = bodyIR.localSlots.len
    slot.name = name
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + slot.id * 8
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(bodyIR.localSlots, slot)
    return slot.id

fn main(): int32 =
    var bodyIR = ir.BodyIRNew()
    let guard = appendI32Slot(bodyIR, "guard")

    var entryTerm: ir.BodyTerm
    entryTerm.kind = ir.BodyTermBrTag
    entryTerm.trueBlock = 1
    let entryTermIndex = ir.BodyIRAppendTerm(bodyIR, entryTerm)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 0, entryTermIndex)

    var loopTerm: ir.BodyTerm
    loopTerm.kind = ir.BodyTermCbrTag
    loopTerm.conditionKind = ir.BodyCondLocalNonZeroTag
    loopTerm.lhsSlot = guard
    loopTerm.trueBlock = 1
    loopTerm.falseBlock = 2
    add(loopTerm.operands, guard)
    let loopTermIndex = ir.BodyIRAppendTerm(bodyIR, loopTerm)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 0, loopTermIndex)

    var exitTerm: ir.BodyTerm
    exitTerm.kind = ir.BodyTermReturnTag
    exitTerm.resultSlot = guard
    add(exitTerm.operands, ir.LocalI32Tag)
    let exitTermIndex = ir.BodyIRAppendTerm(bodyIR, exitTerm)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 0, exitTermIndex)

    let report = ir.BodyIRDodSoAContractCheck(bodyIR)
    let c1 = check(report.ok, 11)
    if c1 != 0: return c1
    let c2 = check(report.termOperandCount == 2, 12)
    if c2 != 0: return c2
    let c3 = check(report.phaseArenaResetCount == 1 && report.phaseArenaLive, 13)
    if c3 != 0: return c3

    var arena = ir.BodyIRPhaseArenaNew()
    let flat = ir.BodyIRPhaseArenaBuildFlatSoA(arena, bodyIR)
    let c4 = check(ir.BodyIRFlatSoAIsAligned(flat), 14)
    if c4 != 0: return c4
    let c5 = check(flat.blockTermIndices.len == 3 &&
                   flat.termTrueBlocks[1] == 1 &&
                   flat.termFalseBlocks[1] == 2 &&
                   flat.termOperandStarts[1] == 0 &&
                   flat.termOperandCounts[1] == 1, 15)
    if c5 != 0: return c5

    let info = loop.BodyIrAnalyzeLoops(bodyIR)
    let c6 = check(loop.BodyIrLoopInfoHasLoop(info), 16)
    if c6 != 0: return c6
    let c7 = check(info.loopCount == 1 &&
                   info.backEdgeCount == 1 &&
                   info.reducibleCount == 1, 17)
    if c7 != 0: return c7
    let c8 = check(loop.BodyIrLoopInfoBlockIsInLoopWindow(info, 1), 18)
    if c8 != 0: return c8

    echo(" body_ir_dense_loop_smoke ok")
    return 0
