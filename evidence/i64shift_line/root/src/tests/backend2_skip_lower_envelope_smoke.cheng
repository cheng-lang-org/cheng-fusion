import std/rawbytes as rawbytes
import cheng/core/backend2/backend2_frag_codec as codec
import cheng/core/backend2/backend2_pipeline as pipeline
import cheng/core/backend2/backend2_types as types
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import std/result

fn envelopeTypeArenaArtifactCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "9999999999999999999999999999999999999999999999999999999999999999")
    assert(IsOk(parsed), "skip-lower envelope TypeArena CID fixture")
    return Value(parsed)

fn envelopeValid(payload: rawbytes.Bytes): bool =
    var emitCid = ""
    var receipt: pipeline.Backend2FunctionReceipt
    var bodyCursor: int32
    var bodyLen: int32
    return pipeline.Backend2SkipLowerCacheEnvelopeDecode(
        payload, "lower-cid", emitCid, receipt, bodyCursor, bodyLen) &&
        emitCid == "emit-cid" && bodyCursor + bodyLen == payload.len

fn main(): int32 =
    let receipt = pipeline.Backend2FunctionReceiptNew(0, 0, 0, 0, 0, 0, 0, 0)
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(
               body,
               envelopeTypeArenaArtifactCid()),
           "skip-lower envelope BodyIR TypeArena identity")
    var bodyBlob = codec.Backend2BodyIrEncode(body)
    var encoded = pipeline.Backend2SkipLowerCacheEncode(
        "lower-cid", "emit-cid", receipt, bodyBlob)
    var expectedSize: int32
    if !pipeline.Backend2SkipLowerCacheEncodedSize(
           9, 8, 64, 64, bodyBlob.len, expectedSize) ||
       encoded.len != expectedSize || !envelopeValid(encoded):
        return 1

    var oldHeader = rawbytes.BytesAlloc(encoded.len + 4)
    rawbytes.BytesCopyRangeInto(oldHeader, 0, encoded, 0, 4)
    codec.Backend2CodecPutU32(oldHeader, 4, 2)
    rawbytes.BytesCopyRangeInto(oldHeader, 8, encoded, 4, encoded.len - 4)
    if envelopeValid(oldHeader):
        return 2

    let truncated = rawbytes.BytesSliceView(encoded, 0, encoded.len - 1)
    if envelopeValid(truncated):
        return 3

    var trailing = rawbytes.BytesAlloc(encoded.len + 1)
    rawbytes.BytesCopyRangeInto(trailing, 0, encoded, 0, encoded.len)
    rawbytes.BytesSet(trailing, encoded.len, 0x5a)
    if envelopeValid(trailing):
        return 4

    rawbytes.BytesSet(encoded,
                      encoded.len - 1,
                      rawbytes.BytesGet(encoded, encoded.len - 1) ^ 1)
    if envelopeValid(encoded):
        return 5

    var fragment: types.FunctionFragment
    fragment.bodyIrPayload = "body"
    fragment.contentCid = "cid"
    var fragmentPayload = codec.Backend2FragmentEncode(fragment)
    if !pipeline.Backend2FragmentPayloadPrevalidate(fragmentPayload):
        return 6
    var oldFragment = rawbytes.BytesAlloc(fragmentPayload.len + 4)
    rawbytes.BytesCopyRangeInto(oldFragment, 0, fragmentPayload, 0, 4)
    codec.Backend2CodecPutU32(oldFragment, 4, 3)
    rawbytes.BytesCopyRangeInto(
        oldFragment, 8, fragmentPayload, 4, fragmentPayload.len - 4)
    let truncatedFragment = rawbytes.BytesSliceView(
        fragmentPayload, 0, fragmentPayload.len - 1)
    var trailingFragment = rawbytes.BytesAlloc(fragmentPayload.len + 1)
    rawbytes.BytesCopyRangeInto(
        trailingFragment, 0, fragmentPayload, 0, fragmentPayload.len)
    if pipeline.Backend2FragmentPayloadPrevalidate(oldFragment) ||
       pipeline.Backend2FragmentPayloadPrevalidate(truncatedFragment) ||
       pipeline.Backend2FragmentPayloadPrevalidate(trailingFragment):
        return 7
    rawbytes.BytesFree(bodyBlob)
    rawbytes.BytesFree(encoded)
    rawbytes.BytesFree(oldHeader)
    rawbytes.BytesFree(trailing)
    rawbytes.BytesFree(fragmentPayload)
    rawbytes.BytesFree(oldFragment)
    rawbytes.BytesFree(trailingFragment)
    echo("backend2_skip_lower_envelope_smoke ok")
    return 0
