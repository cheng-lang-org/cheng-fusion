type
    R5Cell = ref object
        value: int32

var
    r5GCellPos: R5Cell

fn R5CellPosPrepare(): int32 =
    let c = new(R5Cell)
    c.value = 7
    r5GCellPos = share(c)
    return c.value

fn main(): int32 =
    let seen = R5CellPosPrepare()
    if seen != 7:
        return 10
    if r5GCellPos == nil:
        return 11
    if r5GCellPos->value != 7:
        return 12
    r5GCellPos->value = 9
    if r5GCellPos->value != 9:
        return 13
    echo(Fmt"r5_cellmove_pos ok seen={seen}")
    return 0
