import std/bytes as bytes

type
    ColdVarRefSequenceFieldFreeOwner = ref object
        data: bytes.ByteBuffer

fn ColdVarRefSequenceFieldFree(
        owners: var ColdVarRefSequenceFieldFreeOwner[]) =
    for i in 0..<owners.len:
        if owners[i] != nil:
            bytes.FreeByteBuffer(owners[i].data)

fn main(): int32 =
    var owner = new(ColdVarRefSequenceFieldFreeOwner)
    owner.data = bytes.NewByteBuffer(32)
    if owner.data.len != 32 || owner.data.data == nil:
        return 1
    var owners: ColdVarRefSequenceFieldFreeOwner[]
    add(owners, share(owner))
    ColdVarRefSequenceFieldFree(owners)
    if owner.data.len != 0 || owner.data.data != nil:
        return 2
    owners = []
    owner = nil
    return 0
