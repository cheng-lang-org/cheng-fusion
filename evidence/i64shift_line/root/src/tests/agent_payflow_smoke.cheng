# agent payflow smoke: quote -> lock -> 3 metered charges -> refund on the
# settlement escrow state, plus expired-quote / mismatched-receipt /
# double-refund / re-lock negatives and a credit-conservation identity.

import std/os
import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_agent_payflow as apf

fn CidTag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    var st = ssm.SsmInit()

    let client = CidTag(3)
    let agent = CidTag(2)

    # client holds 50
    let cRes = ssm.SsmCredit(st, client, Int64(50))
    if !cRes.ok:
        os.WriteLine(os.Get_stderr(), "credit client failed")
        return 1

    # quote: price 10, maxCalls 5, expires at 1000+1000
    var book: apf.AgentBook
    var q: apf.AgentQuote
    q.quoteCid = CidTag(1)
    q.agentCid = agent
    q.clientCid = client
    q.pricePerCall = Int64(10)
    q.maxCalls = 5
    q.expiresAtMs = Int64(1000 + 1000)
    let fq = apf.FlowQuote(book, q)
    if !fq.ok:
        os.WriteLine(os.Get_stderr(), "quote rejected")
        rc = rc + 1

    # lock the full 10*5=50 into escrow 91 at now=1000
    let lk = apf.FlowLock(st, book, CidTag(91), Int64(1000))
    if !lk.ok:
        os.WriteLine(os.Get_stderr(), "lock failed")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, client) != 0:
        os.WriteLine(os.Get_stderr(), "client balance after lock wrong")
        rc = rc + 1

    # 3 metered charges of 10 each: receipt CidTag(7) vs expected CidTag(7)
    var i: int32 = 0
    while i < 3:
        let ch = apf.FlowCharge(st, book, CidTag(7), CidTag(7))
        if !ch.ok:
            os.WriteLine(os.Get_stderr(), "charge failed")
            rc = rc + 1
        i = i + 1
    if ssm.SsmBalanceOf(st, agent) != 30:
        os.WriteLine(os.Get_stderr(), "agent balance after 3 charges wrong")
        rc = rc + 1

    # 4th charge with receipt CidTag(8) != CidTag(7) must err; agent stays 30
    let ch4 = apf.FlowCharge(st, book, CidTag(8), CidTag(7))
    if ch4.ok:
        os.WriteLine(os.Get_stderr(), "mismatched receipt accepted")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, agent) != 30:
        os.WriteLine(os.Get_stderr(), "agent balance moved on rejected charge")
        rc = rc + 1

    # refund releases the remaining 20 back to the client
    let rf = apf.FlowRefund(st, book)
    if !rf.ok:
        os.WriteLine(os.Get_stderr(), "refund failed")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, client) != 20:
        os.WriteLine(os.Get_stderr(), "client refund amount wrong")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, agent) != 30:
        os.WriteLine(os.Get_stderr(), "agent balance changed on refund")
        rc = rc + 1

    # negative: an expired quote cannot lock (fresh book, expires 500, now 1000)
    var book2: apf.AgentBook
    var q2: apf.AgentQuote
    q2.quoteCid = CidTag(4)
    q2.agentCid = agent
    q2.clientCid = client
    q2.pricePerCall = Int64(10)
    q2.maxCalls = 5
    q2.expiresAtMs = Int64(500)
    let fq2 = apf.FlowQuote(book2, q2)
    if !fq2.ok:
        os.WriteLine(os.Get_stderr(), "expired-quote setup failed")
        rc = rc + 1
    let lk2 = apf.FlowLock(st, book2, CidTag(92), Int64(1000))
    if lk2.ok:
        os.WriteLine(os.Get_stderr(), "expired quote locked")
        rc = rc + 1

    # negative: a second refund is rejected
    let rf2 = apf.FlowRefund(st, book)
    if rf2.ok:
        os.WriteLine(os.Get_stderr(), "double refund accepted")
        rc = rc + 1

    # negative: locking the already locked book again is rejected
    let lk3 = apf.FlowLock(st, book, CidTag(93), Int64(1001))
    if lk3.ok:
        os.WriteLine(os.Get_stderr(), "re-lock accepted")
        rc = rc + 1

    # identity: initial credit 50 == client remainder 20 + agent payouts 30
    if Int64(50) != ssm.SsmBalanceOf(st, client) + ssm.SsmBalanceOf(st, agent):
        os.WriteLine(os.Get_stderr(), "credit conservation broken")
        rc = rc + 1

    if rc == 0:
        echo("agent_payflow_smoke ok")
    return rc
