import std/strings

type
    Holder =
        prefix: str
        suffix: str

fn Concat2(a: str, b: str): str =
    return a + b

fn AppendSlash(p: str): str =
    let out: str = p + "/"
    return out

fn Chain3(a: str, b: str, c: str): str =
    return a + b + c

fn HolderJoin(h: Holder): str =
    return h.prefix + h.suffix

fn main(): int32 =
    let h = Holder(prefix: "lib", suffix: "/core")
    let r1 = Concat2("foo", "bar")
    let r2 = AppendSlash("dir")
    let r3 = Chain3("x", "y", "z")
    let r4 = HolderJoin(h)
    let r5: str = r1 + "/" + r3
    echo(Fmt"str_add_node r1={r1} r2={r2} r3={r3} r4={r4} r5={r5}")
    if r1 != "foobar":
        echo(" str_add_node FAIL r1")
        return 1
    if r2 != "dir/":
        echo(" str_add_node FAIL r2")
        return 1
    if r3 != "xyz":
        echo(" str_add_node FAIL r3")
        return 1
    if r4 != "lib/core":
        echo(" str_add_node FAIL r4")
        return 1
    if r5 != "foobar/xyz":
        echo(" str_add_node FAIL r5")
        return 1
    echo(" str_add_node_fixture ok")
    return 0
