type
    VarAliasElement = int32
    VarAliasBox =
        items: VarAliasElement[]

fn varAliasSequenceAppend(items: var int32[]) =
    add(items, 17)

fn main(): int32 =
    var box: VarAliasBox
    varAliasSequenceAppend(box.items)
    if box.items.len != 1 || box.items[0] != 17:
        return 1
    echo("var_alias_sequence_forwarding_smoke ok")
    return 0
