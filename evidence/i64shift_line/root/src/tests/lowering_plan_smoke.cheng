import std/strutils as strutil

fn reportFieldValue(report: str, key: str): str =
    let firstLineNeedle = strutil.Join([key, "="], "")
    var valueStart: int32
    if parser.ParserStartsWith(report, firstLineNeedle):
        valueStart = firstLineNeedle.len
    else:
        let lineNeedle = strutil.Join(["\n", key, "="], "")
        let fieldPos = parser.ParserFindText(report, lineNeedle)
        if fieldPos < 0:
            return ""
        valueStart = fieldPos + lineNeedle.len
    var valueEnd = valueStart
    var scanLine = true
    while valueEnd < report.len && scanLine:
        if report[valueEnd] == '\n':
            scanLine = false
        else:
            valueEnd = valueEnd + 1
    if valueEnd == valueStart:
        return ""
    return chengpath.TextSlice(report, valueStart, valueEnd - valueStart)

fn reportFieldPositive(report: str, key: str): bool =
    let value = reportFieldValue(report, key)
    return value != "" && value != "0"

fn callReasonReportKey(reason: parser.NormalizedExprCallReason): str =
    if reason == parser.NormalizedExprCallReasonUnknownQualifiedTarget:
        return "expr_surface_call_reason_unknown_qualified_target_count"
    if reason == parser.NormalizedExprCallReasonShadowedQualifiedTarget:
        return "expr_surface_call_reason_shadowed_qualified_target_count"
    if reason == parser.NormalizedExprCallReasonAmbiguousExternalTarget:
        return "expr_surface_call_reason_ambiguous_external_target_count"
    if reason == parser.NormalizedExprCallReasonAmbiguousQualifiedTarget:
        return "expr_surface_call_reason_ambiguous_qualified_target_count"
    if reason == parser.NormalizedExprCallReasonUnknownExternalTarget:
        return "expr_surface_call_reason_unknown_external_target_count"
    if reason == parser.NormalizedExprCallReasonUnknownCallTarget:
        return "expr_surface_call_reason_unknown_call_target_count"
    return ""

fn assertCallReasonReportField(report: str,
                               layer: parser.NormalizedExprLayer,
                               reason: parser.NormalizedExprCallReason,
                               label: str) =
    let reportKey = callReasonReportKey(reason)
    assert(reportKey != "", strutil.Join([label, " report key"], ""))
    assert(reportFieldValue(report, reportKey) ==
           IntToStr(parser.NormalizedExprLayerCallReasonCountExact(layer, reason)),
           label)

fn assertTypedCallFactsMatchLayer(facts: var ccsg.TypedExprFactTable,
                                  layer: parser.NormalizedExprLayer,
                                  label: str) =
    assert(texpr.TypedExprTypeCallDefaultInitCount(facts) ==
           parser.NormalizedExprLayerDefaultInitCount(layer),
           strutil.Join([label, " typed default init count"], ""))
    assert(texpr.TypedExprTypeCallConstructorCount(facts) ==
           parser.NormalizedExprLayerConstructorCount(layer),
           strutil.Join([label, " typed constructor count"], ""))
    assert(texpr.TypedExprFactCountCallResolved(facts) ==
           parser.NormalizedExprLayerCallResolvedCount(layer),
           strutil.Join([label, " typed resolved call count"], ""))
    assert(texpr.TypedExprFactCountCallUnresolved(facts) ==
           parser.NormalizedExprLayerCallUnresolvedCount(layer),
           strutil.Join([label, " typed unresolved call count"], ""))
    assert(texpr.TypedExprFactCountSurfaceCallKindFromParser(facts, parser.NormalizedExprSurfaceCallLocal) ==
           parser.NormalizedExprLayerCallKindCountExact(layer, parser.NormalizedExprSurfaceCallLocal),
           strutil.Join([label, " typed local call kind count"], ""))
    assert(texpr.TypedExprFactCountSurfaceCallKindFromParser(facts, parser.NormalizedExprSurfaceCallExternal) ==
           parser.NormalizedExprLayerCallKindCountExact(layer, parser.NormalizedExprSurfaceCallExternal),
           strutil.Join([label, " typed external call kind count"], ""))
    assert(texpr.TypedExprFactCountSurfaceCallKindFromParser(facts, parser.NormalizedExprSurfaceCallImportc) ==
           parser.NormalizedExprLayerCallKindCountExact(layer, parser.NormalizedExprSurfaceCallImportc),
           strutil.Join([label, " typed importc call kind count"], ""))
    assert(texpr.TypedExprFactCountSurfaceCallKindFromParser(facts, parser.NormalizedExprSurfaceCallMember) ==
           parser.NormalizedExprLayerCallKindCountExact(layer, parser.NormalizedExprSurfaceCallMember),
           strutil.Join([label, " typed member call kind count"], ""))
    assert(texpr.TypedExprFactCountCallTargetImportc(facts) ==
           parser.NormalizedExprLayerCallTargetImportcCount(layer),
           strutil.Join([label, " typed importc target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonUnknownQualifiedTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonUnknownQualifiedTarget),
           strutil.Join([label, " typed unknown qualified target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonShadowedQualifiedTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonShadowedQualifiedTarget),
           strutil.Join([label, " typed shadowed qualified target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonAmbiguousExternalTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonAmbiguousExternalTarget),
           strutil.Join([label, " typed ambiguous external target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonAmbiguousQualifiedTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonAmbiguousQualifiedTarget),
           strutil.Join([label, " typed ambiguous qualified target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonUnknownExternalTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonUnknownExternalTarget),
           strutil.Join([label, " typed unknown external target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonUnknownCallTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonUnknownCallTarget),
           strutil.Join([label, " typed unknown call target count"], ""))

fn buildTypedSourceContexts(workspaceRoot: str,
                            packageRoot: str,
                            linkPlan: slplan.SystemLinkPlanStub): texpr.TypedExprSourceContext[] =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    var out: texpr.TypedExprSourceContext[]
    for i in 0..<linkPlan.sourceClosurePaths.len:
        let sourcePath = linkPlan.sourceClosurePaths[i]
        var sourceText = chengpath.ReadTextFile("", sourcePath)
        var typedSource = texpr.TypedExprSourceTextNewWithExternalPackageRoots(workspaceRoot,
                                                                                 packageRoot,
                                                                                 externalPackageRoots,
                                                                                 sourcePath,
                                                                                 sourceText)
        var sourceContext: texpr.TypedExprSourceContext
        var sourceContextErr = ""
        assert(texpr.TypedExprBuildSourceContext(typedSource, sourceContext, sourceContextErr),
               " lowering plan: typed source context")
        texpr.TypedExprClearSourceTextAllFields(typedSource)
        os.ReleaseStr(sourceText)
        texpr.TypedExprClearSourceContextHeavyFields(sourceContext)
        add(out, sourceContext)
    return out

fn buildTypedSourceTexts(workspaceRoot: str,
                         packageRoot: str,
                         linkPlan: slplan.SystemLinkPlanStub): texpr.TypedExprSourceText[] =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    var out: texpr.TypedExprSourceText[]
    for i in 0..<linkPlan.sourceClosurePaths.len:
        let sourcePath = linkPlan.sourceClosurePaths[i]
        let sourceText = chengpath.ReadTextFile("", sourcePath)
        add(out, texpr.TypedExprSourceTextNewWithExternalPackageRoots(workspaceRoot,
                                                                      packageRoot,
                                                                      externalPackageRoots,
                                                                      sourcePath,
                                                                      sourceText))
    return out

fn buildTypedExprLayer(workspaceRoot: str,
                       packageRoot: str,
                       linkPlan: slplan.SystemLinkPlanStub): parser.NormalizedExprLayer =
    var out: parser.NormalizedExprLayer
    var parseErr = ""
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    assert(parser.ParserReadNormalizedExprLayerForSourceClosureWithExternalPackageRoots(workspaceRoot,
                                                                                         packageRoot,
                                                                                         externalPackageRoots,
                                                                                         linkPlan.sourceClosurePaths,
                                                                                         out,
                                                                                         parseErr),
           strutil.Join([" lowering plan: test oracle expr layer ", parseErr], ""))
    os.ReleaseStr(parseErr)
    return out

fn buildPlan(workspaceRoot: str,
             packageRoot: str,
             sourcePath: str,
             outputPath: str,
             emitKind: int32): lower.LoweringPlanStub =
    var req = creq.CompilerRequestNew(
        packageRoot,
        sourcePath,
        outputPath,
        "arm64-apple-darwin",
        emitKind,
        ""
    )
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err), " lowering plan: build link plan")
    assert(linkPlan.missingReasons.len == 0, " lowering plan: link plan ready")
    var plan: lower.LoweringPlanStub
    assert(lower.BuildLoweringPlanStub(linkPlan, plan, err), strutil.Join([" lowering plan: build lowering plan err=", err], ""))
    linkPlan = slplan.SystemLinkPlanStub()
    os.ReleaseStr(err)
    return plan

fn buildPlanWithExportRoot(workspaceRoot: str,
                           packageRoot: str,
                           sourcePath: str,
                           outputPath: str,
                           emitKind: int32,
                           exportRoot: str): lower.LoweringPlanStub =
    let req0 = creq.CompilerRequestNew(
        packageRoot,
        sourcePath,
        outputPath,
        "arm64-apple-darwin",
        emitKind,
        ""
    )
    let req = creq.CompilerRequestWithExportRootSymbols(req0, [exportRoot])
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err), " lowering plan: build export link plan")
    assert(linkPlan.missingReasons.len == 0, " lowering plan: export link plan ready")
    var plan: lower.LoweringPlanStub
    assert(lower.BuildLoweringPlanStub(linkPlan, plan, err), strutil.Join([" lowering plan: build export lowering plan err=", err], ""))
    linkPlan = slplan.SystemLinkPlanStub()
    os.ReleaseStr(err)
    return plan

fn buildPrimaryReport(workspaceRoot: str,
                      packageRoot: str,
                      sourcePath: str,
                      outputPath: str,
                      exportRoot: str): str =
    let req0 = creq.CompilerRequestNew(
        packageRoot,
        sourcePath,
        outputPath,
        "arm64-apple-darwin",
        creq.EmitObj,
        ""
    )
    let req = creq.CompilerRequestWithExportRootSymbols(req0, [exportRoot])
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err), " lowering plan: build primary link plan")
    assert(linkPlan.missingReasons.len == 0, " lowering plan: primary link plan ready")
    var plan: lower.LoweringPlanStub
    assert(lower.BuildLoweringPlanStub(linkPlan, plan, err), strutil.Join([" lowering plan: build primary lowering err=", err], ""))
    lower.LoweringPlanReleasePrePrimaryObjectPayload(plan)
    var primary: pobj.PrimaryObjectPlan
    pobj.BuildPrimaryObjectPlanInto(linkPlan, plan, primary)
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(plan)
    var report = pobj.PrimaryObjectPlanReport(primary)
    pobj.PrimaryObjectPlanReleasePostEmitBodyIR(primary)
    primary = pobj.PrimaryObjectPlan()
    lower.LoweringPlanReleaseAllPayload(plan)
    linkPlan = slplan.SystemLinkPlanStub()
    os.ReleaseStr(err)
    return report

fn findTypedFact(facts: var ccsg.TypedExprFactTable,
                 sourcePath: str,
                 lineNumber: int32): ccsg.TypedExprFact =
    for i in 0..<facts.count:
        let factRow = texpr.TypedExprFactAt(facts, i)
        if factRow.sourcePath != sourcePath:
            continue
        if factRow.lineNumber != lineNumber:
            continue
        return factRow
    var missing: ccsg.TypedExprFact
    return missing

fn validateTypedFixture(workspaceRoot: str,
                        packageRoot: str,
                        outDir: str) =
    let typedFixturePath: str = chengpath.PathJoin(packageRoot, "src/tests/typed_expr_fact_fixture.cheng")
    let typedOutputPath: str = chengpath.PathJoin(outDir, "typed_expr_fact_fixture")
    var typedReq = creq.CompilerRequestNew(
        packageRoot,
        typedFixturePath,
        typedOutputPath,
        "arm64-apple-darwin",
        creq.EmitShared,
        ""
    )
    var typedLinkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, typedReq, typedLinkPlan, err),
           " lowering plan: typed build link plan")
    typedReq = creq.CompilerRequest()
    let typedSourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(typedLinkPlan)
    assert(IsOk(typedSourceBundleRes), " lowering plan: typed source bundle")
    let typedSourceBundleCid = Value(typedSourceBundleRes)
    var typedCsg: ccsg.CompilerCsg
    var typedCsgErr = ""
    assert(ccsg.BuildCompilerCsgInto(typedLinkPlan, typedSourceBundleCid, typedCsg, typedCsgErr),
           strutil.Join([" lowering plan: typed fixture csg ", typedCsgErr], ""))
    var typedOracleLinkPlan = typedLinkPlan
    typedOracleLinkPlan.sourceClosurePaths =
        typedCsg.semanticGraph.sourceTable.sourcePaths
    var typedSourceTexts = buildTypedSourceTexts(workspaceRoot, packageRoot, typedOracleLinkPlan)
    var typedSourceContexts = buildTypedSourceContexts(workspaceRoot, packageRoot, typedOracleLinkPlan)
    var typedOracleExprLayer = buildTypedExprLayer(workspaceRoot,
                                                   packageRoot,
                                                   typedOracleLinkPlan)
    typedOracleLinkPlan = slplan.SystemLinkPlanStub()
    var typedFactsBuildLayer = parser.NormalizedExprLayerClone(typedOracleExprLayer)
    var typedCsgFactsForCompare: ccsg.TypedExprFactTable
    var loweringErr = ""
    assert(texpr.TypedExprBuildFactsWithMetadataContexts(typedSourceTexts,
                                                         typedFactsBuildLayer,
                                                         typedSourceContexts,
                                                         typedCsgFactsForCompare,
                                                         loweringErr),
           strutil.Join([" lowering plan: test oracle facts ", loweringErr], ""))
    typedFactsBuildLayer = parser.NormalizedExprLayer()
    let typedCompactFactCount = typedCsg.typedExprFactCountSnapshot
    assert(typedCompactFactCount > 0 &&
           typedCsg.semanticGraph.typedFactTable.sourceIndexes.len ==
               typedCompactFactCount,
           " lowering plan: compact typed fact count")
    assert(typedCsg.semanticGraph.exprSliceTypedFactComplete &&
           typedCsg.semanticGraph.exprSliceTypedFactCoveredCount ==
               typedCompactFactCount,
           " lowering plan: compact typed fact slice coverage")
    assert(typedCsg.semanticGraph.exprSliceMaxTypedFactCount > 0 &&
           typedCsg.semanticGraph.exprSliceMaxTypedFactCount <
               typedCompactFactCount,
           " lowering plan: per-function typed fact peak below total facts")
    var typedCsgRules = texpr.TypedExprLoweringRulesFromFacts(typedCsgFactsForCompare)
    var typedCsgExprLayerForValidate = parser.NormalizedExprLayerClone(typedOracleExprLayer)
    if !texpr.TypedExprFactsValidateCallResolution(typedCsgExprLayerForValidate,
                                                   typedSourceContexts,
                                                   typedCsgFactsForCompare,
                                                   loweringErr):
        echo(strutil.Join(["BLOCKER lowering_plan:typed_csg_call_resolution ", loweringErr], ""))
        assert(false, " lowering plan: typed csg call resolution validate")
    if !texpr.TypedExprLoweringRulesValidate(typedCsgRules, loweringErr):
        echo(strutil.Join(["BLOCKER lowering_plan:typed_csg_lowering_rules ", loweringErr], ""))
        assert(false, " lowering plan: typed csg lowering rules validate")
    let typedCsgUniqueShapeCount = texpr.TypedExprLoweringRuleUniqueShapeCount(typedCsgRules)
    let typedCsgUniqueKeyCount = texpr.TypedExprLoweringRuleUniqueKeyCount(typedCsgRules)
    assert(typedCsgUniqueShapeCount > 0,
           " lowering plan: typed lowering rule shape count")
    assert(typedCsgUniqueKeyCount >= typedCsgUniqueShapeCount,
           " lowering plan: typed lowering rule key count")
    typedCsgRules = []
    typedCsgExprLayerForValidate = parser.NormalizedExprLayer()
    var typedPlan: lower.LoweringPlanStub
    err = ""
    assert(lower.BuildLoweringPlanStubFromCompilerCsgBorrowed(typedLinkPlan,
                                                              typedCsg,
                                                              typedPlan,
                                                              err),
           strutil.Join([" lowering plan: typed build lowering plan err=", err], ""))
    assert(typedPlan.typedExprFacts.count == 0,
           " lowering plan: legacy typed facts released")
    assert(typedPlan.typedExprFactCountSnapshot == typedCompactFactCount,
           " lowering plan: typed fact snapshot count")
    assert(lower.LoweringCompilerCsgExprSliceSidecarBound(typedPlan),
           " lowering plan: compiler csg expr slice sidecar bound")
    assert(lower.LoweringCompilerCsgExprSliceSidecarComplete(typedPlan),
           " lowering plan: compiler csg expr slice sidecar complete")
    assert(lower.LoweringCompilerCsgExprSliceSidecarCount(typedPlan) > 0,
           " lowering plan: compiler csg expr slice sidecar count")
    assert(lower.LoweringCompilerCsgExprSliceSidecarFunctionBoundCount(typedPlan) > 0,
           " lowering plan: compiler csg function slice count")
    assert(lower.LoweringCompilerCsgExprSliceSidecarGapCount(typedPlan) == 0,
           " lowering plan: compiler csg expr slice gaps")
    assert(lower.LoweringCompilerCsgExprSliceSidecarOverlapCount(typedPlan) == 0,
           " lowering plan: compiler csg expr slice overlaps")
    assert(lower.LoweringCompilerCsgExprSliceSidecarInvalidSliceCount(typedPlan) == 0,
           " lowering plan: compiler csg expr slice invalid")
    let typedSliceCount = lower.LoweringCompilerCsgExprSliceSidecarCount(typedPlan)
    var typedSliceSourceIndex: int32
    var typedSliceSourcePath: str
    var typedSliceFunctionIndex: int32
    var typedSliceExprStart: int32
    var typedSliceExprCount: int32
    var typedSliceFactStart: int32
    var typedSliceFactCount: int32
    assert(lower.LoweringCompilerCsgExprSliceSidecarRangeAt(typedPlan,
                                                            0,
                                                            typedSliceSourceIndex,
                                                            typedSliceSourcePath,
                                                            typedSliceFunctionIndex,
                                                            typedSliceExprStart,
                                                            typedSliceExprCount,
                                                            typedSliceFactStart,
                                                            typedSliceFactCount),
           " lowering plan: compiler csg expr slice range query")
    assert(typedSliceSourceIndex >= 0 && typedSliceSourcePath != "",
           " lowering plan: compiler csg expr slice source range")
    assert(typedSliceFunctionIndex >= -1 && typedSliceExprStart == 0 &&
           typedSliceExprCount >= 0 && typedSliceFactStart == 0 &&
           typedSliceFactCount >= 0,
           " lowering plan: compiler csg expr slice coordinate range")
    assert(lower.LoweringCompilerCsgExprSliceSidecarRangeQueryCount(typedPlan) == typedSliceCount + 1,
           " lowering plan: compiler csg expr slice query count")
    assert(lower.LoweringCompilerCsgExprSliceConsumedCount(typedPlan) == typedSliceCount &&
           lower.LoweringCompilerCsgExprSliceVerifiedComplete(typedPlan),
           " lowering plan: compiler csg expr slice verified history")
    assert(lower.LoweringResolvedCallFactSnapshotBound(typedPlan),
           " lowering plan: resolved-call snapshot bound")
    ccsg.CompilerCsgReleaseBackendInputPayload(typedCsg)
    typedCsg = ccsg.CompilerCsg()
    var typedPlanRules = texpr.TypedExprLoweringRulesFromFacts(typedCsgFactsForCompare)
    var typedPlanExprLayerForValidate = parser.NormalizedExprLayerClone(typedOracleExprLayer)
    if !texpr.TypedExprFactsValidateCallResolution(typedPlanExprLayerForValidate,
                                                   typedSourceContexts,
                                                   typedCsgFactsForCompare,
                                                   loweringErr):
        echo(strutil.Join(["BLOCKER lowering_plan:typed_plan_call_resolution ", loweringErr], ""))
        assert(false, " lowering plan: typed plan call resolution validate")
    if !texpr.TypedExprLoweringRulesValidate(typedPlanRules, loweringErr):
        echo(strutil.Join(["BLOCKER lowering_plan:typed_plan_lowering_rules ", loweringErr], ""))
        assert(false, " lowering plan: typed plan lowering rules validate")
    typedPlanExprLayerForValidate = parser.NormalizedExprLayer()
    for typedContextIndex in 0..<typedSourceContexts.len:
        texpr.TypedExprClearSourceContextHeavyFields(typedSourceContexts[typedContextIndex])
    typedSourceContexts = []
    let typedSurfaceIndex = lower.LoweringPlanFunctionIndex(typedPlan,
                                                            typedFixturePath,
                                                            "typedSurface")
    assert(typedSurfaceIndex >= 0, " lowering plan: dense store source-scoped typed surface")
    var typedPlanReport = lower.LoweringPlanStubReport(typedPlan)
    var typedFixtureFacts = texpr.TypedExprFactsForSource(typedCsgFactsForCompare, typedFixturePath)
    assert(typedFixtureFacts.count > 0, " lowering plan: typed fixture fact slice")
    assertTypedCallFactsMatchLayer(typedCsgFactsForCompare, typedOracleExprLayer, " lowering plan: typed fixture")
    assert(typedPlanRules.len == typedCsgFactsForCompare.count,
           " lowering plan: typed lowering rule count")
    assert(texpr.TypedExprLoweringRuleUniqueShapeCount(typedPlanRules) == typedCsgUniqueShapeCount,
           " lowering plan: typed lowering rule shape count")
    assert(texpr.TypedExprLoweringRuleUniqueKeyCount(typedPlanRules) == typedCsgUniqueKeyCount,
           " lowering plan: typed lowering rule key count")
    let typedFixtureAbiPolymorphicCount = texpr.TypedExprAbiPolymorphicCount(typedFixtureFacts)
    if typedFixtureAbiPolymorphicCount != 0:
        for typedFixtureFactIndex in 0..<typedFixtureFacts.count:
            let typedFixtureFact = texpr.TypedExprFactAt(typedFixtureFacts,
                                                         typedFixtureFactIndex)
            if typedFixtureFact.abiClass != texpr.TypedExprAbiPolymorphic:
                continue
            echo(strutil.Join(["BLOCKER lowering_plan:typed_fixture_abi_polymorphic source=",
                               typedFixtureFact.sourcePath,
                               " line=",
                               IntToStr(typedFixtureFact.lineNumber),
                               " type=",
                               typedFixtureFact.typeText,
                               " callee=",
                               typedFixtureFact.callCallee,
                               " target=",
                               typedFixtureFact.callTarget], ""))
    assert(typedFixtureAbiPolymorphicCount == 0,
           " lowering plan: typed fixture no abi polymorphic")
    assert(texpr.TypedExprLowerDeferredCount(typedFixtureFacts) == 0,
           " lowering plan: typed fixture no deferred lowering")
    assert(texpr.TypedExprPlaceLocalCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture local place count")
    assert(texpr.TypedExprCallBuiltinCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture builtin call kind")
    assert(texpr.TypedExprCallResultIntrinsicCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture result intrinsic call kind")
    assert(texpr.TypedExprCallProjectionCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture projection call kind")
    let resultErrorFact = findTypedFact(typedCsgFactsForCompare, typedFixturePath, 36)
    assert(resultErrorFact.kind == parser.NormalizedExprResultIntrinsic,
           " lowering plan: typed fixture result error fact kind")
    assert(resultErrorFact.callCallee == "Error",
           " lowering plan: typed fixture result error callee")
    if resultErrorFact.callArgCount != 1 || resultErrorFact.callArgsText != "errRes":
        echo(strutil.Join(["BLOCKER lowering_plan:result_error_fact callee=",
                           resultErrorFact.callCallee,
                           " argc=",
                           IntToStr(resultErrorFact.callArgCount),
                           " args=",
                           resultErrorFact.callArgsText,
                           " column=",
                           IntToStr(resultErrorFact.columnNumber),
                           " source=",
                           resultErrorFact.sourcePath,
                           " expr=",
                           resultErrorFact.exprId], ""))
    assert(resultErrorFact.callArgCount == 1,
           " lowering plan: typed fixture result error arg count")
    assert(resultErrorFact.callArgsText == "errRes",
           " lowering plan: typed fixture result error args")
    let resultIsErrFact = findTypedFact(typedCsgFactsForCompare, typedFixturePath, 39)
    assert(resultIsErrFact.kind == parser.NormalizedExprResultIntrinsic,
           " lowering plan: typed fixture result iserr fact kind")
    assert(resultIsErrFact.callCallee == "IsErr",
           " lowering plan: typed fixture result iserr callee")
    assert(resultIsErrFact.callArgCount == 1,
           " lowering plan: typed fixture result iserr arg count")
    assert(resultIsErrFact.callArgsText == "errRes",
           " lowering plan: typed fixture result iserr args")
    assert(parser.NormalizedExprLayerHasConstructorExpr(typedOracleExprLayer, 61),
           " lowering plan: typed fixture constructor expr")
    let constructorFact = findTypedFact(typedCsgFactsForCompare, typedFixturePath, 61)
    assert(constructorFact.kind == parser.NormalizedExprConstructor,
           " lowering plan: typed fixture constructor fact kind")
    assert(constructorFact.typeCallKind == texpr.TypedExprTypeCallConstructor,
           " lowering plan: typed fixture constructor type call kind")
    assert(constructorFact.typeText == "TypedDefaultWrap",
           " lowering plan: typed fixture constructor fact type")
    assert(!constructorFact.callPrefixStyle,
           " lowering plan: typed fixture constructor call prefix")
    assert(constructorFact.callArgCount == 1,
           " lowering plan: typed fixture constructor arg count")
    assert(constructorFact.callArgsText == "count: payload.len",
           " lowering plan: typed fixture constructor args text")
    let stringifyPrefixFact = findTypedFact(typedCsgFactsForCompare, typedFixturePath, 69)
    assert(stringifyPrefixFact.kind == parser.NormalizedExprCall,
           " lowering plan: typed fixture stringify prefix kind")
    assert(stringifyPrefixFact.callKind == texpr.TypedExprCallBuiltin,
           " lowering plan: typed fixture stringify prefix call kind")
    assert(stringifyPrefixFact.callResolved,
           " lowering plan: typed fixture stringify prefix resolved")
    assert(stringifyPrefixFact.callPrefixStyle,
           " lowering plan: typed fixture stringify prefix style")
    assert(stringifyPrefixFact.callArgCount == 1,
           " lowering plan: typed fixture stringify prefix arg count")
    assert(stringifyPrefixFact.callArgsText == "",
           " lowering plan: typed fixture stringify prefix compact args")
    assert(stringifyPrefixFact.typeText == "str",
           " lowering plan: typed fixture stringify prefix type")
    let stringifyParenFact = findTypedFact(typedCsgFactsForCompare, typedFixturePath, 70)
    assert(stringifyParenFact.kind == parser.NormalizedExprCall,
           " lowering plan: typed fixture stringify paren kind")
    assert(stringifyParenFact.callKind == texpr.TypedExprCallBuiltin,
           " lowering plan: typed fixture stringify paren call kind")
    assert(stringifyParenFact.callResolved,
           " lowering plan: typed fixture stringify paren resolved")
    assert(!stringifyParenFact.callPrefixStyle,
           " lowering plan: typed fixture stringify paren style")
    assert(stringifyParenFact.callArgCount == 1,
           " lowering plan: typed fixture stringify paren arg count")
    assert(stringifyParenFact.callArgsText == "",
           " lowering plan: typed fixture stringify paren compact args")
    assert(stringifyParenFact.typeText == "str",
           " lowering plan: typed fixture stringify paren type")
    var sawConstructorRule = false
    for i in 0..<typedPlanRules.len:
        if typedPlanRules[i].sourcePath == typedFixturePath &&
           typedPlanRules[i].lineNumber == 61 &&
           typedPlanRules[i].typeCallKind == texpr.TypedExprTypeCallConstructor:
            assert(typedPlanRules[i].callArgCount == 1,
                   " lowering plan: typed fixture constructor rule arg count")
            assert(typedPlanRules[i].callArgsText == "count: payload.len",
                   " lowering plan: typed fixture constructor rule args text")
            sawConstructorRule = true
    assert(sawConstructorRule, " lowering plan: typed fixture constructor lowering rule")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleExprLayer, parser.NormalizedExprSurfaceCallExternal, 29),
           " lowering plan: typed fixture alias external call")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleExprLayer, parser.NormalizedExprSurfaceCallExternal, 30),
           " lowering plan: typed fixture module stem external call")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleExprLayer, parser.NormalizedExprSurfaceCallExternal, 31),
           " lowering plan: typed fixture nested qualified external call")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleExprLayer, parser.NormalizedExprSurfaceCallExternal, 33),
           " lowering plan: typed fixture alias importc external call")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleExprLayer, parser.NormalizedExprSurfaceCallExternal, 34),
           " lowering plan: typed fixture nested importc external call")
    var sawAliasImportBuffer = false
    var sawNestedImportBuffer = false
    var sawDefaultInitFact = false
    for i in 0..<typedFixtureFacts.count:
        let fixtureFactRow = texpr.TypedExprFactAt(typedFixtureFacts, i)
        if fixtureFactRow.lineNumber == 33 &&
           texpr.TypedExprFactUsesImportBuffer(fixtureFactRow):
            sawAliasImportBuffer = true
        if fixtureFactRow.lineNumber == 34 &&
           texpr.TypedExprFactUsesImportBuffer(fixtureFactRow):
            sawNestedImportBuffer = true
        if fixtureFactRow.lineNumber == 57 &&
           fixtureFactRow.kind == parser.NormalizedExprDefaultInit:
            assert(fixtureFactRow.typeCallKind == texpr.TypedExprTypeCallDefaultInit,
                   " lowering plan: typed fixture default init type call kind")
            assert(fixtureFactRow.abiClass == texpr.TypedExprAbiComposite,
                   " lowering plan: typed fixture default init abi")
            assert(fixtureFactRow.placeKind != texpr.TypedExprPlaceCallResult,
                   " lowering plan: typed fixture default init place")
            assert(fixtureFactRow.loweringMode == texpr.TypedExprLowerLocalAddress,
                   " lowering plan: typed fixture default init lowering")
            assert(fixtureFactRow.returnKind == texpr.TypedExprReturnCompositeLocal,
                   " lowering plan: typed fixture default init return")
            sawDefaultInitFact = true
    assert(sawAliasImportBuffer, " lowering plan: typed fixture alias importc uses import buffer")
    assert(sawNestedImportBuffer, " lowering plan: typed fixture nested importc uses import buffer")
    assert(sawDefaultInitFact, " lowering plan: typed fixture saw default init fact")
    assert(texpr.TypedExprLowerImportBufferCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture import buffer lowering")
    assert(texpr.TypedExprReturnRegCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture reg return kind")
    assert(texpr.TypedExprReturnCompositeLocalCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture composite local return kind")
    assert(texpr.TypedExprReturnSretCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture sret return kind")
    assert(texpr.TypedExprReturnImportBufferCount(typedFixtureFacts) > 0,
           " lowering plan: typed fixture import buffer return kind")
    texpr.TypedExprFactTableRelease(typedFixtureFacts)
    assert(reportFieldValue(typedPlanReport, "expr_surface_call_count") ==
           IntToStr(parser.NormalizedExprLayerCallCount(typedOracleExprLayer)),
           " lowering plan: typed report call count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_default_init_count") ==
           IntToStr(parser.NormalizedExprLayerDefaultInitCount(typedOracleExprLayer)),
           " lowering plan: typed report default init count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_call_resolved_count") ==
           IntToStr(parser.NormalizedExprLayerCallResolvedCount(typedOracleExprLayer)),
           " lowering plan: typed report resolved call count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_call_unresolved_count") ==
           IntToStr(parser.NormalizedExprLayerCallUnresolvedCount(typedOracleExprLayer)),
           " lowering plan: typed report unresolved call count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_call_local_kind_count") ==
           IntToStr(parser.NormalizedExprLayerCallKindCountExact(typedOracleExprLayer, parser.NormalizedExprSurfaceCallLocal)),
           " lowering plan: typed report local call kind count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_call_external_kind_count") ==
           IntToStr(parser.NormalizedExprLayerCallKindCountExact(typedOracleExprLayer, parser.NormalizedExprSurfaceCallExternal)),
           " lowering plan: typed report external call kind count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_call_importc_kind_count") ==
           IntToStr(parser.NormalizedExprLayerCallKindCountExact(typedOracleExprLayer, parser.NormalizedExprSurfaceCallImportc)),
           " lowering plan: typed report importc call kind count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_call_member_kind_count") ==
           IntToStr(parser.NormalizedExprLayerCallKindCountExact(typedOracleExprLayer, parser.NormalizedExprSurfaceCallMember)),
           " lowering plan: typed report member call kind count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_call_target_importc_count") ==
           IntToStr(parser.NormalizedExprLayerCallTargetImportcCount(typedOracleExprLayer)),
           " lowering plan: typed report importc target count")
    assert(reportFieldValue(typedPlanReport, "expr_surface_constructor_count") ==
           IntToStr(parser.NormalizedExprLayerConstructorCount(typedOracleExprLayer)),
           " lowering plan: typed report constructor count")
    assert(reportFieldValue(typedPlanReport, "typed_expr_type_call_default_init_count") ==
           IntToStr(parser.NormalizedExprLayerDefaultInitCount(typedOracleExprLayer)),
           " lowering plan: typed report typed default init count")
    assert(reportFieldValue(typedPlanReport, "typed_expr_type_call_constructor_count") ==
           IntToStr(parser.NormalizedExprLayerConstructorCount(typedOracleExprLayer)),
           " lowering plan: typed report typed constructor count")
    assert(reportFieldPositive(typedPlanReport, "typed_ir_result_intrinsic_statement_count"),
           " lowering plan: typed report result intrinsic statement count")
    assert(reportFieldPositive(typedPlanReport, "lowering_dense_store_query_count"),
           " lowering plan: dense store hot path query count")
    if !reportFieldPositive(typedPlanReport, "lowering_dense_store_hit_count"):
        echo(strutil.Join(["BLOCKER lowering_plan:dense_store query=",
                           reportFieldValue(typedPlanReport, "lowering_dense_store_query_count"),
                           " hit=",
                           reportFieldValue(typedPlanReport, "lowering_dense_store_hit_count"),
                           " miss=",
                           reportFieldValue(typedPlanReport, "lowering_dense_store_miss_count"),
                           " fallback=",
                           reportFieldValue(typedPlanReport, "lowering_dense_store_fallback_scan_count")], ""))
    assert(reportFieldPositive(typedPlanReport, "lowering_dense_store_hit_count"),
           " lowering plan: dense store hot path hit count")
    assert(reportFieldValue(typedPlanReport, "lowering_dense_store_source_scoped_query_count") ==
           reportFieldValue(typedPlanReport, "lowering_dense_store_query_count"),
           " lowering plan: dense store source-scoped query count")
    assert(reportFieldValue(typedPlanReport, "lowering_dense_store_source_scoped_query_hit_count") ==
           reportFieldValue(typedPlanReport, "lowering_dense_store_hit_count"),
           " lowering plan: dense store source-scoped hit count")
    assert(reportFieldValue(typedPlanReport, "lowering_dense_store_source_scoped_query_miss_count") ==
           reportFieldValue(typedPlanReport, "lowering_dense_store_miss_count"),
           " lowering plan: dense store source-scoped miss count")
    if reportFieldValue(typedPlanReport, "lowering_dense_store_fallback_scan_count") != "0":
        echo(strutil.Join(["BLOCKER lowering_plan:dense_store_fallback query=",
                           reportFieldValue(typedPlanReport, "lowering_dense_store_query_count"),
                           " hit=",
                           reportFieldValue(typedPlanReport, "lowering_dense_store_hit_count"),
                           " miss=",
                           reportFieldValue(typedPlanReport, "lowering_dense_store_miss_count"),
                           " fallback=",
                           reportFieldValue(typedPlanReport, "lowering_dense_store_fallback_scan_count")], ""))
    assert(reportFieldValue(typedPlanReport, "lowering_dense_store_fallback_scan_count") == "0",
           " lowering plan: dense store fallback scan count")
    assert(reportFieldValue(typedPlanReport, "lowering_dense_store_pointer_key_count") == "0",
           " lowering plan: dense store pointer key count")
    assert(reportFieldValue(typedPlanReport, "lowering_dense_store_suffix_guess_count") == "0",
           " lowering plan: dense store suffix guess count")
    assert(reportFieldPositive(typedPlanReport, "lowering_phase_arena_reset_count"),
           " lowering plan: phase arena reset count")
    assert(reportFieldPositive(typedPlanReport, "lowering_phase_arena_reserve_count"),
           " lowering plan: phase arena reserve count")
    assert(reportFieldPositive(typedPlanReport, "lowering_phase_arena_peak_bytes"),
           " lowering plan: phase arena peak bytes")
    assert(reportFieldValue(typedPlanReport, "lowering_phase_arena_spill_count") == "0",
           " lowering plan: phase arena spill count")
    assert(reportFieldPositive(typedPlanReport, "phase_arena_peak_bytes"),
           " lowering plan: generic phase arena peak bytes")
    assert(reportFieldValue(typedPlanReport, "phase_arena_spill_count") == "0",
           " lowering plan: generic phase arena spill count")
    assert(reportFieldValue(typedPlanReport, "lowering_rule_type_call_default_init_count") ==
           IntToStr(parser.NormalizedExprLayerDefaultInitCount(typedOracleExprLayer)),
           " lowering plan: typed report lowering default init count")
    assert(reportFieldValue(typedPlanReport, "lowering_rule_type_call_constructor_count") ==
           IntToStr(parser.NormalizedExprLayerConstructorCount(typedOracleExprLayer)),
           " lowering plan: typed report lowering constructor count")
    assertCallReasonReportField(typedPlanReport,
                                typedOracleExprLayer,
                                parser.NormalizedExprCallReasonUnknownQualifiedTarget,
                                " lowering plan: typed report unknown qualified target count")
    assertCallReasonReportField(typedPlanReport,
                                typedOracleExprLayer,
                                parser.NormalizedExprCallReasonShadowedQualifiedTarget,
                                " lowering plan: typed report shadowed qualified target count")
    assertCallReasonReportField(typedPlanReport,
                                typedOracleExprLayer,
                                parser.NormalizedExprCallReasonAmbiguousExternalTarget,
                                " lowering plan: typed report ambiguous external target count")
    assertCallReasonReportField(typedPlanReport,
                                typedOracleExprLayer,
                                parser.NormalizedExprCallReasonAmbiguousQualifiedTarget,
                                " lowering plan: typed report ambiguous qualified target count")
    assertCallReasonReportField(typedPlanReport,
                                typedOracleExprLayer,
                                parser.NormalizedExprCallReasonUnknownExternalTarget,
                                " lowering plan: typed report unknown external target count")
    assertCallReasonReportField(typedPlanReport,
                                typedOracleExprLayer,
                                parser.NormalizedExprCallReasonUnknownCallTarget,
                                " lowering plan: typed report unknown call target count")
    assert(texpr.TypedExprLoweringRuleCountArgPassKind(typedPlanRules, texpr.TypedExprArgPassAddress) > 0,
           " lowering plan: typed address arg rule")
    assert(texpr.TypedExprLoweringRuleCountResultPassKind(typedPlanRules, texpr.TypedExprResultPassSret) > 0,
           " lowering plan: typed sret result rule")
    assert(texpr.TypedExprLoweringRuleCountMaterializeKind(typedPlanRules, texpr.TypedExprMaterializeDestAddress) > 0,
           " lowering plan: typed dest address materialize rule")
    assert(texpr.TypedExprLoweringRuleCountCopyKind(typedPlanRules, texpr.TypedExprCopyRegionCopy) > 0,
           " lowering plan: typed region copy rule")
    assert(texpr.TypedExprLoweringRuleCountImportKind(typedPlanRules, texpr.TypedExprImportBuiltinAddressSlot) > 0,
           " lowering plan: typed builtin address import rule")
    assert(texpr.TypedExprLoweringRuleCountImportKind(typedPlanRules, texpr.TypedExprImportImportBuffer) > 0,
           " lowering plan: typed import buffer import rule")
    assert(texpr.TypedExprLoweringRuleEntryText(typedPlanRules[0]) != "",
           " lowering plan: typed report rule entry")
    assert(chengpath.TextContains(texpr.TypedExprLoweringRuleEntryText(typedPlanRules[0]), "key=type="),
           " lowering plan: typed report rule key text")
    texpr.TypedExprFactTableRelease(typedCsgFactsForCompare)
    typedOracleExprLayer = parser.NormalizedExprLayer()
    for typedSourceTextIndex in 0..<typedSourceTexts.len:
        texpr.TypedExprClearSourceTextAllFields(typedSourceTexts[typedSourceTextIndex])
    typedSourceTexts = []
    lower.LoweringPlanReleaseAllPayload(typedPlan)
    assert(!lower.LoweringCompilerCsgExprSliceSidecarBound(typedPlan) &&
           lower.LoweringCompilerCsgExprSliceSidecarCount(typedPlan) == 0 &&
           lower.LoweringCompilerCsgExprSliceSidecarRangeQueryCount(typedPlan) == 0,
           " lowering plan: compiler csg expr slice live payload released")
    assert(lower.LoweringCompilerCsgExprSliceConsumedCount(typedPlan) == typedSliceCount &&
           lower.LoweringCompilerCsgExprSliceVerifiedComplete(typedPlan),
           " lowering plan: compiler csg expr slice history survives release")
    typedPlanRules = []
    os.ReleaseStr(typedPlanReport)
    typedCsgErr = ""
    typedLinkPlan = slplan.SystemLinkPlanStub()

fn validateResultDispatchFixture(workspaceRoot: str,
                                 packageRoot: str,
                                 outDir: str) =
    let resultDispatchPath: str = chengpath.PathJoin(packageRoot, "src/tests/result_request_dispatch_fixture.cheng")
    let resultDispatchOutputPath: str = chengpath.PathJoin(outDir, "result_request_dispatch_fixture")
    var resultDispatchReq0 = creq.CompilerRequestNew(
        packageRoot,
        resultDispatchPath,
        resultDispatchOutputPath,
        "arm64-apple-darwin",
        creq.EmitObj,
        ""
    )
    var resultDispatchReq = creq.CompilerRequestWithExportRootSymbols(resultDispatchReq0,
                                                                      ["BackendDriverDispatchMinRunSystemLinkExecWithRequest"])
    var resultDispatchLinkPlan: slplan.SystemLinkPlanStub
    var resultDispatchErr = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, resultDispatchReq, resultDispatchLinkPlan, resultDispatchErr),
           " lowering plan: result request dispatch link")
    resultDispatchReq = creq.CompilerRequest()
    resultDispatchReq0 = creq.CompilerRequest()
    assert(resultDispatchLinkPlan.missingReasons.len == 0,
           " lowering plan: result request dispatch link ready")
    var resultDispatchPlan: lower.LoweringPlanStub
    assert(lower.BuildLoweringPlanStub(resultDispatchLinkPlan, resultDispatchPlan, resultDispatchErr),
           strutil.Join([" lowering plan: result request dispatch lowering err=", resultDispatchErr], ""))
    var resultDispatchReport = lower.LoweringPlanStubReport(resultDispatchPlan)
    assert(chengpath.TextContains(reportFieldValue(resultDispatchReport, "primary_object_ir_statement_sequence_kinds"), "result_intrinsic"),
           " lowering plan: result request dispatch typed statement")
    assert(chengpath.TextContains(reportFieldValue(resultDispatchReport, "primary_object_ir_body_kinds"), texpr.BodyKindStatementSequence),
           " lowering plan: result request dispatch body ir statement sequence")
    let resultDispatchBodyIrCallCounts = reportFieldValue(resultDispatchReport,
                                                           "primary_object_ir_body_ir_call_counts")
    if !chengpath.TextContains(resultDispatchBodyIrCallCounts, "2"):
        echo(strutil.Join(["BLOCKER lowering_plan:result_dispatch_body_ir_call_counts value=",
                           resultDispatchBodyIrCallCounts,
                           " call_counts=",
                           reportFieldValue(resultDispatchReport, "primary_object_ir_call_sequence_counts"),
                           " call_targets=",
                           reportFieldValue(resultDispatchReport, "primary_object_ir_call_sequence_targets"),
                           " stmt_kinds=",
                           reportFieldValue(resultDispatchReport, "primary_object_ir_statement_sequence_kinds")], ""))
    assert(chengpath.TextContains(resultDispatchBodyIrCallCounts, "2"),
           " lowering plan: result request dispatch body ir call count")
    assert(chengpath.TextContains(reportFieldValue(resultDispatchReport, "primary_object_ir_call_sequence_targets"), "BackendDriverDispatchMinRunSystemLinkExecConcreteRequest"),
           " lowering plan: result request dispatch concrete target")
    assert(chengpath.TextContains(reportFieldValue(resultDispatchReport, "primary_object_ir_call_sequence_targets"), "BackendDriverDispatchMinUnsupported"),
           " lowering plan: result request dispatch unsupported target")
    os.ReleaseStr(resultDispatchReport)
    lower.LoweringPlanReleasePrePrimaryObjectPayload(resultDispatchPlan)
    var resultDispatchPrimary: pobj.PrimaryObjectPlan
    pobj.BuildPrimaryObjectPlanInto(resultDispatchLinkPlan, resultDispatchPlan, resultDispatchPrimary)
    lower.LoweringPlanReleaseAfterPrimaryObjectPlan(resultDispatchPlan)
    assert(!lower.LoweringResolvedCallFactSnapshotBound(resultDispatchPlan),
           " lowering plan: released snapshot not bound")
    assert(lower.LoweringResolvedCallFactSnapshotEntryCount(resultDispatchPlan) == 0,
           " lowering plan: released snapshot empty")
    var resultDispatchPrimaryReport = pobj.PrimaryObjectPlanReport(resultDispatchPrimary)
    pobj.PrimaryObjectPlanReleasePostEmitBodyIR(resultDispatchPrimary)
    resultDispatchPrimary = pobj.PrimaryObjectPlan()
    assert(reportFieldValue(resultDispatchPrimaryReport, "primary_object_first_missing_function") == "-",
           " lowering plan: result request dispatch primary ready")
    let resultDispatchStreamSchedule = reportFieldValue(resultDispatchPrimaryReport,
                                                         "primary_object_word_fill_schedule")
    if resultDispatchStreamSchedule != "decl_order_stream_emit_release":
        echo(strutil.Join(["BLOCKER lowering_plan:result_dispatch_stream schedule=",
                           resultDispatchStreamSchedule,
                           " active=",
                           reportFieldValue(resultDispatchPrimaryReport, "primary_object_streamed_emit_first"),
                           " released=",
                           reportFieldValue(resultDispatchPrimaryReport, "primary_object_fill_released_body_ir_function_count"),
                           " retained=",
                           reportFieldValue(resultDispatchPrimaryReport, "primary_object_retained_body_ir_function_count")], ""))
    assert(resultDispatchStreamSchedule == "decl_order_stream_emit_release",
           " lowering plan: result request dispatch stream schedule")
    assert(reportFieldValue(resultDispatchPrimaryReport, "primary_object_streamed_emit_first") == "1",
           " lowering plan: result request dispatch stream active")
    assert(reportFieldPositive(resultDispatchPrimaryReport,
                               "primary_object_fill_released_body_ir_function_count"),
           " lowering plan: result request dispatch stream released body ir")
    assert(reportFieldValue(resultDispatchPrimaryReport,
                            "primary_object_retained_body_ir_function_count") == "0",
           " lowering plan: result request dispatch no retained body ir")
    if reportFieldValue(resultDispatchPrimaryReport, "primary_object_reloc_count") != "2":
        echo(strutil.Join(["BLOCKER lowering_plan:result_dispatch_primary reloc=",
                           reportFieldValue(resultDispatchPrimaryReport, "primary_object_reloc_count"),
                           " targets=",
                           reportFieldValue(resultDispatchPrimaryReport, "primary_object_reloc_targets")], ""))
    assert(reportFieldValue(resultDispatchPrimaryReport, "primary_object_reloc_count") == "2",
           " lowering plan: result request dispatch primary call count")
    os.ReleaseStr(resultDispatchPrimaryReport)
    lower.LoweringPlanReleaseAllPayload(resultDispatchPlan)
    resultDispatchLinkPlan = slplan.SystemLinkPlanStub()
    os.ReleaseStr(resultDispatchErr)

fn validateMultiStmtFixture(workspaceRoot: str,
                            packageRoot: str,
                            outDir: str) =
    let multiStmtPath: str = chengpath.PathJoin(packageRoot, "src/tests/multi_stmt_call_sequence_unsupported_fixture.cheng")
    let multiStmtOutputPath: str = chengpath.PathJoin(outDir, "multi_stmt_call_sequence_unsupported_fixture")
    var multiStmtPlan = buildPlan(workspaceRoot, packageRoot, multiStmtPath, multiStmtOutputPath, creq.EmitExe)
    var multiStmtReport = lower.LoweringPlanStubReport(multiStmtPlan)
    assert(chengpath.TextContains(reportFieldValue(multiStmtReport, "primary_object_ir_structured_call_counts"), "2"),
           " lowering plan: unsupported multi statement structured call count")
    assert(chengpath.TextContains(reportFieldValue(multiStmtReport, "primary_object_ir_body_ir_call_counts"), "2"),
           " lowering plan: unsupported multi statement body ir call count")
    assert(chengpath.TextContains(reportFieldValue(multiStmtReport, "primary_object_ir_call_sequence_targets"), "LeftValue"),
           " lowering plan: unsupported multi statement left call target")
    assert(chengpath.TextContains(reportFieldValue(multiStmtReport, "primary_object_ir_call_sequence_targets"), "RightValue"),
           " lowering plan: unsupported multi statement right call target")
    os.ReleaseStr(multiStmtReport)
    lower.LoweringPlanReleaseAllPayload(multiStmtPlan)

fn main(): int32 =
    let workspaceRoot: str = os.GetEnvDefault("CHENG_SMOKE_ROOT", ".")
    let packageRoot: str = workspaceRoot
    let smokeLabel: str = os.GetEnvDefault("CHENG_SMOKE_LABEL", "host")
    let outDir: str = chengpath.PathJoin(workspaceRoot, strutil.Join(["artifacts/program_selfhost/", smokeLabel], ""))
    assert(chengpath.MkdirP(workspaceRoot, outDir), " lowering plan: mkdir")
    let sourcePath: str = chengpath.PathJoin(packageRoot, "src/tests/program_selfhost_smoke.cheng")
    let outputPath: str = chengpath.PathJoin(outDir, "program_selfhost_smoke")
    var err = ""
    let req = creq.CompilerRequestNew(
        packageRoot,
        sourcePath,
        outputPath,
        "arm64-apple-darwin",
        creq.EmitExe,
        ""
    )
    var linkPlan: slplan.SystemLinkPlanStub
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err), " lowering plan: build link plan")
    assert(linkPlan.missingReasons.len == 0, " lowering plan: link plan ready")
    var plan = buildPlan(workspaceRoot, packageRoot, sourcePath, outputPath, creq.EmitExe)
    linkPlan = slplan.SystemLinkPlanStub()
    assert(plan.functionNames.len >= 1, " lowering plan: function count")
    assert(plan.functionNameIds[0] >= 0, " lowering plan: intern id")
    assert(plan.functionCallConvs[0] == lower.LoweringCallConvInternal(), " lowering plan: callconv")
    assert(plan.typedExprFactCountSnapshot >= 0 &&
           plan.typedExprFactCountSnapshot <= plan.exprSummary.exprCount,
           " lowering plan: persistent typed facts bounded by normalized exprs")
    assert(lower.LoweringCompilerCsgExprSliceSidecarComplete(plan),
           " lowering plan: compiler csg expr and fact coordinates complete")
    assert(plan.typedExprFacts.count == 0,
           " lowering plan: legacy typed facts released")
    assert(lower.LoweringResolvedCallFactSnapshotBound(plan),
           " lowering plan: resolved-call snapshot bound")
    var sawMain = false
    for i in 0..<plan.functionNames.len:
        assert(!(plan.functionOwnerModulePaths[i] == "std/system" && plan.functionNames[i] == "mulCompat"),
               " lowering plan: skip importc decl")
        if plan.functionEntryFlags[i] != 0:
            sawMain = true
            assert(plan.functionNames[i] == "main", " lowering plan: entry name")
            assert(plan.functionResultLayoutKinds[i] == lower.LoweringLayoutKindI32(), " lowering plan: entry layout")
    assert(sawMain, " lowering plan: saw entry")
    assert(plan.exprLayer.exprs.len == 0, " lowering plan: expr layer released")
    assert(plan.exprSummary.sourceCount > 0, " lowering plan: expr surface count")
    assert(plan.exprSummary.exprCount > 0, " lowering plan: expr node count")
    assert(plan.exprSummary.tryCount >= 0, " lowering plan: try count")
    assert(plan.exprSummary.questionResidualCount == 0, " lowering plan: question normalized")
    assert(plan.typedFactSummary.lowerLocalAddressCount > 0,
           " lowering plan: typed lowering mode")
    assert(plan.missingReasons.len == 0, " lowering plan: no lowering blockers")
    assert(lower.LoweringPlanPipelineStage(plan) == "canonical_csg_to_lowering_plan",
           " lowering plan: report stage")
    lower.LoweringPlanReleaseAllPayload(plan)
    req = creq.CompilerRequest()
    os.ReleaseStr(err)

    validateResultDispatchFixture(workspaceRoot, packageRoot, outDir)

    validateTypedFixture(workspaceRoot, packageRoot, outDir)

    validateMultiStmtFixture(workspaceRoot, packageRoot, outDir)

    let cfgFinalCallPath: str = chengpath.PathJoin(packageRoot, "src/tests/cfg_final_return_call_sequence_fixture.cheng")
    let cfgFinalCallOutputPath: str = chengpath.PathJoin(outDir, "cfg_final_return_call_sequence_fixture")
    var cfgFinalCallPlan = buildPlan(workspaceRoot, packageRoot, cfgFinalCallPath, cfgFinalCallOutputPath, creq.EmitExe)
    var cfgFinalCallReport = lower.LoweringPlanStubReport(cfgFinalCallPlan)
    assert(chengpath.TextContains(reportFieldValue(cfgFinalCallReport, "primary_object_ir_call_sequence_counts"), "2"),
           " lowering plan: cfg final return call legacy count")
    assert(chengpath.TextContains(reportFieldValue(cfgFinalCallReport, "primary_object_ir_structured_call_counts"), "2"),
           " lowering plan: cfg final return call structured count")
    assert(chengpath.TextContains(reportFieldValue(cfgFinalCallReport, "primary_object_ir_body_ir_call_counts"), "2"),
           " lowering plan: cfg final return call body ir count")
    assert(chengpath.TextContains(reportFieldValue(cfgFinalCallReport, "primary_object_ir_call_sequence_targets"), "Guard"),
           " lowering plan: cfg final return call guard target")
    assert(chengpath.TextContains(reportFieldValue(cfgFinalCallReport, "primary_object_ir_call_sequence_targets"), "Finish"),
           " lowering plan: cfg final return call finish target")
    var cfgFinalCallPrimaryReport = buildPrimaryReport(workspaceRoot,
                                                       packageRoot,
                                                       cfgFinalCallPath,
                                                       cfgFinalCallOutputPath,
                                                       "main")
    assert(reportFieldValue(cfgFinalCallPrimaryReport, "primary_object_first_missing_function") == "-",
           " lowering plan: cfg final return call primary ready")
    assert(reportFieldValue(cfgFinalCallPrimaryReport, "primary_object_reloc_count") == "2",
           " lowering plan: cfg final return call primary reloc count")
    os.ReleaseStr(cfgFinalCallPrimaryReport)
    os.ReleaseStr(cfgFinalCallReport)
    lower.LoweringPlanReleaseAllPayload(cfgFinalCallPlan)

    let cfgStrReturnCallPath: str = chengpath.PathJoin(packageRoot, "src/tests/cfg_str_let_return_call_fixture.cheng")
    let cfgStrReturnCallOutputPath: str = chengpath.PathJoin(outDir, "cfg_str_let_return_call_fixture")
    var cfgStrReturnCallPlan = buildPlan(workspaceRoot, packageRoot, cfgStrReturnCallPath, cfgStrReturnCallOutputPath, creq.EmitExe)
    var cfgStrReturnCallReport = lower.LoweringPlanStubReport(cfgStrReturnCallPlan)
    assert(chengpath.TextContains(reportFieldValue(cfgStrReturnCallReport, "primary_object_ir_call_sequence_counts"), "2"),
           " lowering plan: cfg str let return call legacy count")
    assert(chengpath.TextContains(reportFieldValue(cfgStrReturnCallReport, "primary_object_ir_structured_call_counts"), "2"),
           " lowering plan: cfg str let return call structured count")
    assert(chengpath.TextContains(reportFieldValue(cfgStrReturnCallReport, "primary_object_ir_body_ir_call_counts"), "2"),
           " lowering plan: cfg str let return call body ir count")
    assert(chengpath.TextContains(reportFieldValue(cfgStrReturnCallReport, "primary_object_ir_call_sequence_targets"), "ParamStr"),
           " lowering plan: cfg str let return call param target")
    assert(chengpath.TextContains(reportFieldValue(cfgStrReturnCallReport, "primary_object_ir_call_sequence_targets"), "Dispatch"),
           " lowering plan: cfg str let return call dispatch target")
    os.ReleaseStr(cfgStrReturnCallReport)
    lower.LoweringPlanReleaseAllPayload(cfgStrReturnCallPlan)

    echo(" lowering_plan_smoke ok")
    return 0
