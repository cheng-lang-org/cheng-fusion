import std/result
import std/rawbytes
import std/monotimes
import cheng/quic/connection as qconn
import cheng/quic/msquicruntime as qruntime
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream
import cheng/moq/media_asset_manifest as media
import cheng/moq/media_csg_web_projection as media_csg
import cheng/core/ir/csg_web_facts as facts

fn moqSegmentStreamBytesEq(left: rawbytes.Bytes, right: rawbytes.Bytes): bool =
    if BytesLen(left) != BytesLen(right):
        return false
    for i in 0..<BytesLen(left):
        if BytesGet(left, i) != BytesGet(right, i):
            return false
    return true

fn moqSegmentStreamReadAll(reader: var moqstream.Libp2pMoqSegmentStreamReader,
                            maxChunkBytes: int32): Result[rawbytes.Bytes] =
    var out: rawbytes.Bytes
    while !reader.closed:
        let readRes = moqstream.Libp2pMoqSegmentStreamRead(reader, maxChunkBytes)
        if IsErr(readRes):
            return Err[rawbytes.Bytes](ErrorText(readRes))
        let chunk = Value(readRes)
        if BytesLen(chunk) <= 0:
            return Ok[rawbytes.Bytes](out)
        out = moqstream.Libp2pMoqSegmentStreamAppendBytes(out, chunk)
    return Ok[rawbytes.Bytes](out)

fn makeMoqSegmentVideoIngestRequest(initBytes: rawbytes.Bytes,
                                     posterBytes: rawbytes.Bytes,
                                     bodyBytes: rawbytes.Bytes): media.MediaIngestRequest =
    var req: media.MediaIngestRequest
    req.sourcePath = "/imports/video/moq-segment-first-frame.mp4"
    req.blob = moqstream.Libp2pMoqSegmentStreamAppendBytes(initBytes, bodyBytes)
    req.ownerPeerId = "peer-alpha"
    req.remotePeersCsv = "peer-bravo,peer-charlie"
    req.mime = "video/mp4"
    req.kindCode = media.MediaAssetKindVideo
    req.durationMs = int64(22000)
    req.codec = "h264/aac"
    req.posterBytes = posterBytes
    req.initSegmentBytes = initBytes
    req.keyframeIndex = "0:0"
    req.contentSignature = "moq-segment-first-frame-signature"
    req.objectTargetBytes = 32
    req.sourceBlockBytes = 8
    req.repairDropletCount = 2
    return req

fn exerciseNativeQuicMoqSegmentStream(): bool =
    var settings = qruntime.initMsQuicSettings()
    settings.allowDatagram = true

    var listener = qtransport.InitMsQuicTransport()
    assert(IsOk(qtransport.setMsQuicTransportSettings(listener, settings)),
        " moq segment stream smoke: listener settings")
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(listener)),
        " moq segment stream smoke: listener tls")
    let listenAddrRes = quic_transport.Libp2pQuicAddrFromHostPort("127.0.0.1", 0)
    assert(IsOk(listenAddrRes), " moq segment stream smoke: listen addr")
    qtransport.start(listener, Value(listenAddrRes))

    var client = qtransport.InitMsQuicTransport()
    assert(IsOk(qtransport.setMsQuicTransportSettings(client, settings)),
        " moq segment stream smoke: client settings")
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(client)),
        " moq segment stream smoke: client tls")
    let dialRes = qtransport.dial(client, listener.listenAddr)
    if IsErr(dialRes):
        panic(ErrorText(dialRes))
    assert(IsOk(dialRes), " moq segment stream smoke: dial")
    var clientLegacy = Value(dialRes)
    let acceptRes = qtransport.accept(listener)
    assert(IsOk(acceptRes), " moq segment stream smoke: accept")
    var serverLegacy = Value(acceptRes)

    let streamPairRes = qconn.newNativeConnectionPairForStreams(clientLegacy.localAddr,
                                                                clientLegacy.remoteAddr,
                                                                serverLegacy.localAddr,
                                                                serverLegacy.remoteAddr,
                                                                4,
                                                                4,
                                                                4,
                                                                4)
    assert(IsOk(streamPairRes), " moq segment stream smoke: stream pair")
    var clientStream = Value(streamPairRes).outbound
    var serverStream = Value(streamPairRes).inbound
    let negotiateSendRes = moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, clientStream)
    if IsErr(negotiateSendRes):
        panic(ErrorText(negotiateSendRes))
    assert(IsOk(negotiateSendRes), " moq segment stream smoke: client stream negotiate send")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerNegotiate(listener, serverStream)),
        " moq segment stream smoke: server stream negotiate")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, clientStream)),
        " moq segment stream smoke: client stream negotiate ack")

    let segment = BytesFromString("prefix-native-quic-moq-segment-tail")
    let expected = BytesFromString("native-quic-")

    var request: moqstream.Libp2pMoqSegmentStreamRequest
    request.streamId = "stream-native-quic-0"
    request.segmentKey = "video-segment-0"
    request.offsetBytes = 7
    request.lengthBytes = BytesLen(expected)
    request.readChunkBytes = 5

    var reader: moqstream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientOpen(reader, clientStream, request)),
        " moq segment stream smoke: client open")
    let serverServeRes = moqstream.Libp2pMoqSegmentStreamServerHandleRequestedRange(serverStream,
                                                                                    segment)
    assert(IsOk(serverServeRes), " moq segment stream smoke: server serve range")
    let serverRequest = Value(serverServeRes)
    assert(serverRequest.streamId == request.streamId,
        " moq segment stream smoke: request stream id")
    assert(serverRequest.segmentKey == request.segmentKey,
        " moq segment stream smoke: request segment key")
    assert(serverRequest.offsetBytes == request.offsetBytes,
        " moq segment stream smoke: request offset")
    assert(serverRequest.lengthBytes == request.lengthBytes,
        " moq segment stream smoke: request length")
    assert(serverRequest.readChunkBytes == request.readChunkBytes,
        " moq segment stream smoke: request chunk")

    let readAllRes = moqSegmentStreamReadAll(reader, 4)
    assert(IsOk(readAllRes), " moq segment stream smoke: read all")
    assert(moqSegmentStreamBytesEq(Value(readAllRes), expected),
        " moq segment stream smoke: native quic bytes")

    qconn.ConnClose(serverStream)
    moqstream.Libp2pMoqSegmentStreamClose(reader)
    qconn.ConnClose(serverLegacy)
    qconn.ConnClose(clientLegacy)
    qtransport.Stop(listener)
    return true

fn exerciseMediaManifestMoqFirstFrameSegmentStream(): bool =
    var settings = qruntime.initMsQuicSettings()
    settings.allowDatagram = true

    var listener = qtransport.InitMsQuicTransport()
    assert(IsOk(qtransport.setMsQuicTransportSettings(listener, settings)),
        " moq segment stream smoke: media listener settings")
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(listener)),
        " moq segment stream smoke: media listener tls")
    let listenAddrRes = quic_transport.Libp2pQuicAddrFromHostPort("127.0.0.1", 0)
    assert(IsOk(listenAddrRes), " moq segment stream smoke: media listen addr")
    qtransport.start(listener, Value(listenAddrRes))

    var client = qtransport.InitMsQuicTransport()
    assert(IsOk(qtransport.setMsQuicTransportSettings(client, settings)),
        " moq segment stream smoke: media client settings")
    assert(IsOk(quic_transport.Libp2pQuicConfigureTls(client)),
        " moq segment stream smoke: media client tls")
    let dialRes = qtransport.dial(client, listener.listenAddr)
    if IsErr(dialRes):
        panic(ErrorText(dialRes))
    var clientLegacy = Value(dialRes)
    let acceptRes = qtransport.accept(listener)
    assert(IsOk(acceptRes), " moq segment stream smoke: media accept")
    var serverLegacy = Value(acceptRes)

    let streamPairRes = qconn.newNativeConnectionPairForStreams(clientLegacy.localAddr,
                                                                clientLegacy.remoteAddr,
                                                                serverLegacy.localAddr,
                                                                serverLegacy.remoteAddr,
                                                                4,
                                                                4,
                                                                4,
                                                                4)
    assert(IsOk(streamPairRes), " moq segment stream smoke: media stream pair")
    var clientStream = Value(streamPairRes).outbound
    var serverStream = Value(streamPairRes).inbound
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, clientStream)),
        " moq segment stream smoke: media negotiate send")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamServerNegotiate(listener, serverStream)),
        " moq segment stream smoke: media negotiate server")
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, clientStream)),
        " moq segment stream smoke: media negotiate ack")

    var index = media.MediaLocalIndexInit()
    let initBytes = BytesFromString("init-segment-keyframe-zero")
    let posterBytes = BytesFromString("poster-first-frame")
    let bodyBytes = BytesFromString("|sample-video-body-from-moq-segment-stream")
    let ingestRes = media.MediaIngestPin(index,
                                         makeMoqSegmentVideoIngestRequest(initBytes,
                                                                          posterBytes,
                                                                          bodyBytes))
    assert(IsOk(ingestRes), " moq segment stream smoke: media ingest pin")
    let ingest = Value(ingestRes)
    let manifestRes = media.MediaLocalIndexFind(index, ingest.assetCid)
    assert(IsOk(manifestRes), " moq segment stream smoke: media manifest find")
    var manifest = Value(manifestRes)
    assert(manifest.objects.len > 0, " moq segment stream smoke: media object list")
    let firstObject = manifest.objects[0]
    assert(firstObject.byteOffset == 0, " moq segment stream smoke: first object offset")
    assert(manifest.initSegmentByteLength == BytesLen(initBytes),
        " moq segment stream smoke: manifest init segment length")
    assert(firstObject.byteLength >= manifest.initSegmentByteLength,
        " moq segment stream smoke: init segment within first object")
    let recordRes = media.MediaLocalIndexFindAssetRecord(index, ingest.assetCid)
    assert(IsOk(recordRes), " moq segment stream smoke: pinned asset record")
    let assetBytes = Value(recordRes).assetBytes

    let publishOpenRes = media.MediaOpenPinned(index,
                                               ingest.assetCid,
                                               "slot-moq-publish",
                                               "platform-codec-provider",
                                               "surface-texture-provider",
                                               "audio-provider")
    assert(IsOk(publishOpenRes),
        " moq segment stream smoke: media publish session")
    var publishSession = Value(publishOpenRes)
    var publishRequest = media.MediaControlRequest(
        slotId: publishSession.slotId,
        actionKind: "PublishAsset",
        payload: ingest.assetCid,
        guard: "asset-opened",
        trace: "typed-action:PublishAsset"
    )
    let publishControlRes = media.MediaControl(publishSession,
                                               publishRequest)
    assert(IsOk(publishControlRes),
        " moq segment stream smoke: media publish control")
    var publishControl = Value(publishControlRes)
    let publishEventRes = media.MediaPublishEventFromControl(index,
                                                             publishSession,
                                                             publishControl,
                                                             media.MediaAssetLifecycleSchema)
    assert(IsOk(publishEventRes),
        " moq segment stream smoke: media publish event")
    var publishEvent = Value(publishEventRes)
    assert(publishEvent.assetCid == ingest.assetCid,
        " moq segment stream smoke: publish event asset")
    assert(publishEvent.manifestCid == ingest.manifestCid,
        " moq segment stream smoke: publish event manifest")
    assert(publishEvent.eventCid == media.MediaPublishEventCanonicalCid(publishEvent),
        " moq segment stream smoke: publish event canonical cid")

    var request: moqstream.Libp2pMoqSegmentStreamRequest
    request.streamId = manifest.bundleCid
    request.segmentKey = firstObject.objectId
    request.offsetBytes = firstObject.byteOffset
    request.lengthBytes = manifest.initSegmentByteLength
    request.readChunkBytes = 6

    var remoteFetchStarted: monotimes.MonoTime
    remoteFetchStarted = monotimes.GetMonoTime()
    var reader: moqstream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamClientOpen(reader, clientStream, request)),
        " moq segment stream smoke: media client open")
    let serveRes = moqstream.Libp2pMoqSegmentStreamServerHandleRequestedObjectRange(serverStream,
                                                                                    assetBytes,
                                                                                    firstObject.objectId,
                                                                                    firstObject.byteOffset,
                                                                                    firstObject.byteLength)
    assert(IsOk(serveRes), " moq segment stream smoke: media serve object range")
    assert(Value(serveRes).segmentKey == firstObject.objectId,
        " moq segment stream smoke: served segment key")
    let readAllRes = moqSegmentStreamReadAll(reader, 5)
    assert(IsOk(readAllRes), " moq segment stream smoke: media read init")
    var remoteFetchCompleted: monotimes.MonoTime
    remoteFetchCompleted = monotimes.GetMonoTime()
    let remoteFetchMs = (monotimes.MonoTimeNs(remoteFetchCompleted) -
                         monotimes.MonoTimeNs(remoteFetchStarted)) / 1000000
    assert(moqSegmentStreamBytesEq(Value(readAllRes), initBytes),
        " moq segment stream smoke: media init bytes")
    assert(BytesLen(Value(readAllRes)) < BytesLen(assetBytes),
        " moq segment stream smoke: first-frame open must not fetch full asset")

    var remoteIndex = media.MediaLocalIndexInit()
    let missingRemoteOpenRes = media.MediaOpenPinned(remoteIndex,
                                                     ingest.assetCid,
                                                     "slot-moq-video",
                                                     "platform-codec-provider",
                                                     "surface-texture-provider",
                                                     "audio-provider")
    assert(IsErr(missingRemoteOpenRes),
        " moq segment stream smoke: remote open requires announced manifest")
    var remoteManifest = manifest
    var remoteOpenStarted: monotimes.MonoTime
    remoteOpenStarted = monotimes.GetMonoTime()
    let openRes = media.MediaOpenAnnouncedManifest(remoteIndex,
                                                   remoteManifest,
                                                   "slot-moq-video",
                                                   "platform-codec-provider",
                                                   "surface-texture-provider",
                                                   "audio-provider")
    var remoteOpenCompleted: monotimes.MonoTime
    remoteOpenCompleted = monotimes.GetMonoTime()
    assert(IsOk(openRes), " moq segment stream smoke: media open announced manifest")
    var session = Value(openRes)
    media.MediaPlaybackSessionStampOpen(session,
                                        monotimes.MonoTimeNs(remoteOpenStarted) / 1000000,
                                        monotimes.MonoTimeNs(remoteOpenCompleted) / 1000000)
    assert(session.manifestCid == ingest.manifestCid,
        " moq segment stream smoke: remote session manifest cid")
    let remoteAssetRecordRes = media.MediaLocalIndexFindAssetRecord(remoteIndex,
                                                                    ingest.assetCid)
    assert(IsErr(remoteAssetRecordRes),
        " moq segment stream smoke: remote first-frame path must not require full asset pin")
    let frameRes = media.MediaFirstFrame(session,
                                         remoteManifest,
                                         Value(readAllRes),
                                         media.MediaAssetFirstFrameSourceInitSegment)
    assert(IsOk(frameRes), " moq segment stream smoke: media first frame from init")
    var frame = Value(frameRes)
    media.MediaFrameReceiptStamp(frame,
                                 session.openedAtMs,
                                 session.openedAtMs,
                                 session.openedAtMs)
    assert(frame.firstFrameCid == ingest.initSegmentCid,
        " moq segment stream smoke: media first frame cid")
    assert(frame.verified, " moq segment stream smoke: media first frame verified")
    assert(len(frame.receiptCid) > 0,
        " moq segment stream smoke: media first frame receipt cid")
    let openEventRes = media.MediaOpenEventFromSession(remoteManifest,
                                                       session,
                                                       media.MediaAssetLifecycleSchema,
                                                       "moq-segment-init")
    assert(IsOk(openEventRes),
        " moq segment stream smoke: remote open lifecycle event")
    let openEvent = Value(openEventRes)
    assert(openEvent.assetCid == ingest.assetCid,
        " moq segment stream smoke: open lifecycle asset")
    assert(openEvent.manifestCid == ingest.manifestCid,
        " moq segment stream smoke: open lifecycle manifest")
    assert(openEvent.transport == media.MediaAssetTransportMoq,
        " moq segment stream smoke: open lifecycle transport")
    assert(openEvent.announcedBytes > 0,
        " moq segment stream smoke: open lifecycle announced bytes")
    assert(openEvent.objectCount == manifest.objects.len,
        " moq segment stream smoke: open lifecycle object count")
    assert(openEvent.dropletCount == manifest.droplets.len,
        " moq segment stream smoke: open lifecycle droplet count")
    var openEventForCanonical = openEvent
    assert(openEvent.eventCid == media.MediaOpenEventCanonicalCid(openEventForCanonical),
        " moq segment stream smoke: open lifecycle canonical cid")
    var lifecycleQueue = media.MediaLifecycleEventQueueInit()
    let openEnqueueRes = media.MediaLifecycleEventQueueEnqueueOpen(lifecycleQueue,
                                                                   openEvent)
    assert(IsOk(openEnqueueRes),
        " moq segment stream smoke: open lifecycle queued")
    let duplicateOpenEnqueueRes = media.MediaLifecycleEventQueueEnqueueOpen(lifecycleQueue,
                                                                            openEvent)
    assert(IsErr(duplicateOpenEnqueueRes),
        " moq segment stream smoke: duplicate open lifecycle rejected")
    var openEventForCsg = openEvent
    let openLifecycleFactRes = media_csg.MediaOpenEventToCsgWebLifecycleEventFact(openEventForCsg,
                                                                                 "media.lifecycle.moq.open")
    assert(IsOk(openLifecycleFactRes),
        " moq segment stream smoke: open lifecycle csg fact")
    let openLifecycleFact = Value(openLifecycleFactRes)
    assert(openLifecycleFact.kind == facts.CsgWebMediaLifecycleEvent,
        " moq segment stream smoke: open lifecycle fact kind")
    assert(openLifecycleFact.eventKind == "OpenAsset",
        " moq segment stream smoke: open lifecycle fact event")
    assert(openLifecycleFact.payload == ingest.manifestCid,
        " moq segment stream smoke: open lifecycle fact payload")
    assert(openLifecycleFact.transport == media.MediaAssetTransportMoq,
        " moq segment stream smoke: open lifecycle fact transport")
    assert(openLifecycleFact.objectCount == manifest.objects.len,
        " moq segment stream smoke: open lifecycle fact object count")
    assert(openLifecycleFact.dropletCount == manifest.droplets.len,
        " moq segment stream smoke: open lifecycle fact droplet count")
    let deliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(publishEvent,
                                                                          openEvent,
                                                                          manifest,
                                                                          frame,
                                                                          BytesLen(Value(readAllRes)),
                                                                          remoteFetchMs)
    if IsErr(deliveryRes):
        echo(Error(deliveryRes))
    assert(IsOk(deliveryRes),
        " moq segment stream smoke: media delivery receipt")
    var delivery = Value(deliveryRes)
    assert(delivery.receiptKind == "RemoteFrame",
        " moq segment stream smoke: delivery kind")
    assert(delivery.publishEventCid == publishEvent.eventCid,
        " moq segment stream smoke: delivery publish event")
    assert(delivery.openEventCid == openEvent.eventCid,
        " moq segment stream smoke: delivery open event")
    assert(delivery.firstMediaCid == ingest.initSegmentCid,
        " moq segment stream smoke: delivery media cid")
    assert(delivery.transferredBytes == BytesLen(Value(readAllRes)),
        " moq segment stream smoke: delivery transferred bytes")
    assert(delivery.remoteFetchMs <= int64(media.MediaDeliverySecondsOpenBudgetMs),
        " moq segment stream smoke: delivery remote fetch budget")
    assert(delivery.openToMediaMs <= int64(media.MediaDeliverySecondsOpenBudgetMs),
        " moq segment stream smoke: delivery open to media budget")
    var tamperedOpenForDelivery = openEvent
    tamperedOpenForDelivery.objectCount = tamperedOpenForDelivery.objectCount + 1
    let tamperedOpenDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(publishEvent,
                                                                                       tamperedOpenForDelivery,
                                                                                       manifest,
                                                                                       frame,
                                                                                       BytesLen(Value(readAllRes)),
                                                                                       remoteFetchMs)
    assert(IsErr(tamperedOpenDeliveryRes),
        " moq segment stream smoke: delivery rejects tampered open cid")
    var tamperedPublishForDelivery = publishEvent
    tamperedPublishForDelivery.dropletCount = tamperedPublishForDelivery.dropletCount + 1
    let tamperedPublishDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(tamperedPublishForDelivery,
                                                                                          openEvent,
                                                                                          manifest,
                                                                                          frame,
                                                                                          BytesLen(Value(readAllRes)),
                                                                                          remoteFetchMs)
    assert(IsErr(tamperedPublishDeliveryRes),
        " moq segment stream smoke: delivery rejects tampered publish cid")
    var tamperedManifestForDelivery = manifest
    tamperedManifestForDelivery.initSegmentByteLength = tamperedManifestForDelivery.initSegmentByteLength + 1
    let tamperedManifestDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(publishEvent,
                                                                                          openEvent,
                                                                                          tamperedManifestForDelivery,
                                                                                          frame,
                                                                                          BytesLen(Value(readAllRes)),
                                                                                          remoteFetchMs)
    assert(IsErr(tamperedManifestDeliveryRes),
        " moq segment stream smoke: delivery rejects tampered manifest")
    var deliveryForCsg = delivery
    let deliveryFactRes = media_csg.MediaDeliveryReceiptToCsgWebDeliveryReceiptFact(deliveryForCsg,
                                                                                   "media.delivery.moq.remote")
    assert(IsOk(deliveryFactRes),
        " moq segment stream smoke: delivery csg fact")
    let deliveryFact = Value(deliveryFactRes)
    assert(deliveryFact.kind == facts.CsgWebMediaDeliveryReceipt,
        " moq segment stream smoke: delivery fact kind")
    assert(deliveryFact.transport == media.MediaAssetTransportMoq,
        " moq segment stream smoke: delivery fact transport")
    assert(deliveryFact.publishEventCid == publishEvent.eventCid,
        " moq segment stream smoke: delivery fact publish event")
    assert(deliveryFact.openEventCid == openEvent.eventCid,
        " moq segment stream smoke: delivery fact open event")
    assert(deliveryFact.receiptCid == delivery.receiptCid,
        " moq segment stream smoke: delivery fact receipt cid")
    assert(deliveryFact.firstMediaCid == ingest.initSegmentCid,
        " moq segment stream smoke: delivery fact media cid")
    var frameForCsg = frame
    let frameFactRes = media_csg.MediaFrameReceiptToCsgWebFrameReceiptFact(frameForCsg,
                                                                          "media.frame.moq.remote",
                                                                          media.MediaAssetKindVideo)
    assert(IsOk(frameFactRes),
        " moq segment stream smoke: remote frame csg fact")
    let frameFact = Value(frameFactRes)
    let frameIdentityFactRes = media_csg.MediaFrameReceiptToCsgWebReceiptIdentityFact(frameForCsg,
                                                                                      frameFact.id,
                                                                                      "media.receipt.identity.moq.remote")
    assert(IsOk(frameIdentityFactRes),
        " moq segment stream smoke: remote frame identity fact")
    assert(Value(frameIdentityFactRes).receiptCid == frame.receiptCid,
        " moq segment stream smoke: remote frame identity cid")

    qconn.ConnClose(serverStream)
    moqstream.Libp2pMoqSegmentStreamClose(reader)
    qconn.ConnClose(serverLegacy)
    qconn.ConnClose(clientLegacy)
    qtransport.Stop(listener)
    return true

fn main(): int32 =
    assert(moqstream.Libp2pMoqSegmentStreamTransportText() == "native_quic_moq_stream",
        " moq segment stream smoke: transport")
    assert(moqstream.Libp2pMoqSegmentStreamProtocolId() == 20,
        " moq segment stream smoke: protocol id")

    let segment = BytesFromString("0123456789abcdefghijklmnopqrstuvwxyz")
    let expectedRes = moqstream.Libp2pMoqSegmentStreamCopyRange(segment, 5, 19)
    assert(IsOk(expectedRes), " moq segment stream smoke: expected range")
    let expected = Value(expectedRes)
    assert(BytesLen(expected) == 19, " moq segment stream smoke: expected len")

    var request: moqstream.Libp2pMoqSegmentStreamRequest
    request.streamId = "stream-32"
    request.segmentKey = "video-segment-0"
    request.offsetBytes = 5
    request.lengthBytes = 19
    request.readChunkBytes = 7

    var clientStream: qconn.Connection
    var reader: moqstream.Libp2pMoqSegmentStreamReader
    assert(IsOk(moqstream.Libp2pMoqSegmentStreamOpen(reader, clientStream, request)),
        " moq segment stream smoke: open")
    assert(reader.expectedBytes == 19, " moq segment stream smoke: reader expected")
    assert(reader.bytesRead == 0, " moq segment stream smoke: reader cursor")
    assert(!reader.closed, " moq segment stream smoke: reader open")

    let prefixRes = moqstream.Libp2pMoqSegmentStreamCopyRange(segment, 5, 4)
    assert(IsOk(prefixRes), " moq segment stream smoke: prefix")
    assert(moqSegmentStreamBytesEq(Value(prefixRes), BytesFromString("5678")),
        " moq segment stream smoke: prefix bytes")
    let pastEndRes = moqstream.Libp2pMoqSegmentStreamCopyRange(segment, BytesLen(segment), 1)
    assert(IsErr(pastEndRes), " moq segment stream smoke: past end rejected")

    let payloadRes = moqstream.Libp2pMoqSegmentStreamRequestPayloadBytes(request)
    assert(IsOk(payloadRes), " moq segment stream smoke: request payload")
    let parsedRes = moqstream.Libp2pMoqSegmentStreamParseRequestPayload(Value(payloadRes))
    assert(IsOk(parsedRes), " moq segment stream smoke: parse request")
    assert(Value(parsedRes).streamId == request.streamId,
        " moq segment stream smoke: parsed stream id")
    assert(Value(parsedRes).segmentKey == request.segmentKey,
        " moq segment stream smoke: parsed segment key")
    assert(exerciseNativeQuicMoqSegmentStream(),
        " moq segment stream smoke: native quic flow")
    assert(exerciseMediaManifestMoqFirstFrameSegmentStream(),
        " moq segment stream smoke: media manifest first frame flow")

    echo(" libp2p_moq_segment_stream_smoke ok")
    return 0
