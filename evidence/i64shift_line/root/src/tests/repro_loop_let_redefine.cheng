fn f(i: int32): Result[int64] =
    if i > 0:
        return Ok[int64](int64(i))
    return Err[int64]("neg")

fn g(): Result[int64] =
    for p in 0..<3:
        let r: Result[int64] = f(p)
        if IsOk(r):
            return r
    return Err[int64]("none")

fn main(): int32 =
    let rr = g()
    if IsOk(rr):
        return 0
    return 1
