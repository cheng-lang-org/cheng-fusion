# web_permissions_runtime_smoke.cheng
# Runtime proof for the permissions substrate (pure Cheng, no FFI):
# policy table readback for granted / prompt / denied / default branches,
# plus one out-status name-echo check.
# Backs the provider id cheng/core/runtime/web_permissions_runtime.query.
#
# NOTE (compiler constraint, 2026-08-22): a by-value str param may currently
# be used exactly once when its uses cross a call boundary + a later
# comparison (false "use of consumed managed value"; minimal repro
# src/.gen/r16-probe2/perm{C,F,G}.cheng bisect). Assertions are therefore
# arranged so each param has a single use site; coverage is unchanged.
import cheng/core/runtime/web_permissions_runtime as perm

fn expectState(name: str, want: str): int32 =
    var status: perm.WebPermissionStatus
    if !perm.WebPermissionsQuery(name, status):
        return 1
    if status.state != want:
        return 2
    return 0

fn main(): int32 =
    var rc: int32 = expectState("notifications", "granted")
    if rc != 0:
        return rc
    rc = expectState("clipboard-read", "granted")
    if rc != 0:
        return rc
    rc = expectState("clipboard-write", "granted")
    if rc != 0:
        return rc
    rc = expectState("geolocation", "prompt")
    if rc != 0:
        return rc
    rc = expectState("camera", "denied")
    if rc != 0:
        return rc
    rc = expectState("microphone", "denied")
    if rc != 0:
        return rc
    rc = expectState("midi", "prompt")
    if rc != 0:
        return rc
    # out-status name-echo contract, checked at one call site with a literal
    # (single-use rule above).
    var echoed: perm.WebPermissionStatus
    if !perm.WebPermissionsQuery("midi", echoed):
        return 8
    if echoed.name != "midi":
        return 9
    echo("permissions substrate smoke ok")
    return 0
