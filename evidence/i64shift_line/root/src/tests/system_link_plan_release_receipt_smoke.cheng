import std/result
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/parser as parser

fn SystemLinkPlanReleaseFixture(
        suffix: str): slplan.SystemLinkPlanStub =
    var plan: slplan.SystemLinkPlanStub
    plan.entryPath = Fmt"/workspace/{suffix}/main.cheng"
    plan.outputPath = Fmt"/workspace/{suffix}/main.o"
    plan.targetTriple = "arm64-apple-darwin"
    plan.symbolVisibility = "hidden"
    plan.browserBridgeObjectPath =
        Fmt"/workspace/{suffix}/browser.o"
    plan.exportRootSymbols = ["Main", Fmt"Export{suffix}"]
    plan.packageRoot = Fmt"/workspace/{suffix}"
    var externalRoot: parser.ParserExternalPackageRoot
    externalRoot.packageId = Fmt"dep/{suffix}"
    externalRoot.canonicalPackageId = Fmt"cheng/dep/{suffix}"
    externalRoot.packageRoot = Fmt"/deps/{suffix}"
    externalRoot.channel = "stable"
    externalRoot.verifiedSourcePaths = [
        Fmt"/deps/{suffix}/src/main.cheng"]
    externalRoot.verifiedSourceTexts = [
        Fmt"fn Dep{suffix}(): int32 = 1"]
    add(plan.externalPackageRoots, externalRoot)
    plan.managedDependencyReceipt.channel = "stable"
    var dependency: slplan.SystemLinkPlanManagedDependencyReceiptEntry
    dependency.canonicalPackageId =
        Fmt"cheng/dep/{suffix}"
    add(plan.managedDependencyReceipt.entries, dependency)
    plan.managedDependencyReceipt.dependencyCount = 1
    plan.workspaceRoot = Fmt"/workspace/{suffix}"
    plan.packageId = Fmt"cheng/release/{suffix}"
    plan.moduleStem = Fmt"release/{suffix}/main"
    plan.sourceBundleCid =
        Err[layout.FixedBytes32](
            Fmt"release-fixture-{suffix}")
    plan.sourceBundleIdentityPaths = [
        Fmt"release/{suffix}/main"]
    plan.sourceClosurePaths = [
        Fmt"/workspace/{suffix}/main.cheng"]
    plan.ownerModulePaths = [
        Fmt"release/{suffix}/main"]
    var edge: parser.ImportEdge
    edge.ownerModulePath = Fmt"release/{suffix}/main"
    edge.targetModulePath = Fmt"dep/{suffix}/main"
    edge.targetSourcePath = Fmt"/deps/{suffix}/src/main.cheng"
    edge.importAlias = Fmt"dep{suffix}"
    edge.qualifier = Fmt"dep{suffix}"
    add(plan.importEdges, edge)
    add(plan.exprLayer.exprNext, -1)
    plan.runtimeTargets = ["program_support"]
    plan.providerModules = ["core_runtime"]
    plan.providerObjectPaths = [
        Fmt"/workspace/{suffix}/provider.o"]
    plan.runtimeProviderBundle =
        Fmt"/workspace/{suffix}/providers.a"
    plan.entrySymbol = "Main"
    plan.missingReasons = [
        Fmt"fixture-{suffix}"]
    plan.parserSyntaxTag = "cheng_normalized_source"
    plan.buildEntryPath =
        Fmt"/workspace/{suffix}/main.cheng"
    plan.linkMode = "system"
    plan.pipelineStage = "release_fixture"
    return plan

fn main() =
    var allocatedBufferCount: int64
    var releasedBufferCount: int64
    var allocatedBytes: int64
    var releasedBytes: int64
    for iteration in 0..<1000:
        let suffix = strings.IntToStr(iteration)
        var plan =
            SystemLinkPlanReleaseFixture(suffix)
        let buffers =
            slplan.SystemLinkPlanRetainedBufferCount(plan)
        let bytes =
            slplan.SystemLinkPlanRetainedBytes(plan)
        assert(buffers > 0 && bytes > int64(0),
               "system link plan release smoke: fixture storage missing")
        allocatedBufferCount =
            allocatedBufferCount + int64(buffers)
        allocatedBytes = allocatedBytes + bytes
        var receipt: slplan.SystemLinkPlanReleaseReceipt
        slplan.SystemLinkPlanReleaseWithReceipt(
            plan, receipt)
        assert(receipt.storageReleased &&
               receipt.releasedOwnedStorageColumnCount ==
                   slplan.SystemLinkPlanOwnedStorageColumnCount &&
               receipt.releasedBufferCount == buffers &&
               receipt.releasedBytes == bytes &&
               slplan.SystemLinkPlanStorageReleased(plan) &&
               slplan.SystemLinkPlanRetainedBufferCount(plan) == 0 &&
               slplan.SystemLinkPlanRetainedBytes(plan) ==
                   int64(0),
               "system link plan release smoke: physical release receipt mismatch")
        var receiptErr: str
        assert(
            slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
                plan, receipt, receiptErr),
            receiptErr)
        releasedBufferCount =
            releasedBufferCount +
            int64(receipt.releasedBufferCount)
        releasedBytes =
            releasedBytes + receipt.releasedBytes
    assert(allocatedBufferCount == releasedBufferCount &&
           allocatedBytes == releasedBytes,
           "system link plan release smoke: alloc/release balance mismatch")

    var left = SystemLinkPlanReleaseFixture("left")
    var right = SystemLinkPlanReleaseFixture("right")
    var leftReceipt: slplan.SystemLinkPlanReleaseReceipt
    var rightReceipt: slplan.SystemLinkPlanReleaseReceipt
    slplan.SystemLinkPlanReleaseWithReceipt(
        left, leftReceipt)
    slplan.SystemLinkPlanReleaseWithReceipt(
        right, rightReceipt)
    var err: str
    assert(
        !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
            left, rightReceipt, err),
        "system link plan release smoke: exchanged receipt accepted")
    leftReceipt.releasedOwnedStorageColumnCount =
        leftReceipt.releasedOwnedStorageColumnCount - 1
    assert(
        !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
            left, leftReceipt, err),
        "system link plan release smoke: missing column receipt accepted")
    leftReceipt.releasedOwnedStorageColumnCount =
        leftReceipt.releasedOwnedStorageColumnCount + 1
    leftReceipt.releasedBytes =
        leftReceipt.releasedBytes + int64(1)
    assert(
        !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
            left, leftReceipt, err),
        "system link plan release smoke: wrong byte receipt accepted")
    leftReceipt.releasedBytes =
        leftReceipt.releasedBytes - int64(1)
    leftReceipt.ownerToken.data[0] =
        uint8(
            Int32(
                leftReceipt.ownerToken.data[0]) ^ 1)
    assert(
        !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
            left, leftReceipt, err),
        "system link plan release smoke: wrong token receipt accepted")
    leftReceipt.ownerToken.data[0] =
        uint8(Int32(leftReceipt.ownerToken.data[0]) ^ 1)
    assert(
        slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
            left, leftReceipt, err),
        err)
    assert(
        !slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
            left, leftReceipt, err),
        "system link plan release smoke: duplicate receipt accepted")
    assert(
        slplan.SystemLinkPlanReleaseReceiptConsumeStrictInto(
            right, rightReceipt, err),
        err)
    echo("system_link_plan_release_iterations=1000")
    echo("system_link_plan_release_alloc_eq_release=1")
    echo("system_link_plan_release_live=0")
    echo("system_link_plan_release_mutations_rejected=1")
