# w16 trailing-|| fallthrough: multi-condition `||` as the last statement
# of a function body must not collapse the false edge into the true block.
#
# Case file: docs/s2-feed-core-build-wall-20260708.md:238,241 (wave15 ③).
# Shape from the truncated w14 pushCopy smoke: `if a || b || c: return N`
# is the absolute last statement (no later `return 0`). CloseIfTop patches
# false/join to bodyIR.blocks.len but only void functions used to materialize
# that landing block; non-void left the edge OOB, emit fell through into then
# (false observationally equal to true) → silent wrong value.

# Absolute last stmt is if-|| with return in then — false must NOT take then.
fn CheckLast(a: int32, b: int32, c: int32): int32 =
    if a != 65 || b != 66 || c != 67:
        return 12

# Same chain with an explicit fallthrough return (control: mid-loop patch).
fn CheckWithTail(a: int32, b: int32, c: int32): int32 =
    if a != 65 || b != 66 || c != 67:
        return 12
    return 0

# Void body ending on || if (pre-existing void landing must stay green).
fn TrailingOrVoidLast(x: int32, out: var int32) =
    out = 0
    if x == 1 || x == 2 || x == 3:
        out = 1

fn main(): int32 =
    # Match → must not return 12 (the then path).
    if CheckLast(65, 66, 67) == 12:
        return 1
    # Mismatch on each arm → must take then.
    if CheckLast(0, 66, 67) != 12:
        return 2
    if CheckLast(65, 0, 67) != 12:
        return 3
    if CheckLast(65, 66, 0) != 12:
        return 4
    if CheckLast(1, 2, 3) != 12:
        return 5
    # Match fallthrough epilogue returns 0.
    if CheckLast(65, 66, 67) != 0:
        return 6

    if CheckWithTail(65, 66, 67) != 0:
        return 10
    if CheckWithTail(0, 66, 67) != 12:
        return 11

    var out: int32
    out = 99
    TrailingOrVoidLast(0, out)
    if out != 0:
        return 30
    TrailingOrVoidLast(2, out)
    if out != 1:
        return 31
    TrailingOrVoidLast(7, out)
    if out != 0:
        return 32

    return 0
