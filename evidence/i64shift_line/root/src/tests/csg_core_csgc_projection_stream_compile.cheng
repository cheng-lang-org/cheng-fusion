import cheng/core/csg_core/csgc_projection_stream as projection_stream
import cheng/core/csg_core/merkle_store_identity

fn main(): int32 =
    var authority: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority
    var expectedAfter: projection_stream.CsgCoreCsgcProjectionStreamExpectedAfterSemantic
    let materialized =
        projection_stream.CsgCoreCsgcProjectionStreamMaterialize(
            authority,
            1,
            0,
            "id:compile_only",
            "{}",
            "{\"x\":1}",
            expectedAfter)
    if materialized.ok:
        return 1
    return 0
