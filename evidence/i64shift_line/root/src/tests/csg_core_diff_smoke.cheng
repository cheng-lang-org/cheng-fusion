import std/os as os
import std/strings
import cheng/core/csg_core/diff

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn expect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

@borrows
fn expectKeys(keys: str[], expected: str[], message: str): int32 =
    if keys.len != expected.len:
        return smokeFail(message)
    for i in 0..<keys.len:
        if keys[i] != expected[i]:
            os.WriteLine(os.Get_stderr(), keys[i])
            return smokeFail(message)
    return 0

@borrows
fn expectClean(result: diff.CsgCoreDiffResult, message: str): int32 =
    if !result.ok:
        os.WriteLine(os.Get_stderr(), result.error)
        return smokeFail(message)
    if result.leftRoot.len == 0 || result.rightRoot.len == 0:
        return smokeFail(message)
    if result.added.len != 0 || result.removed.len != 0 || result.changed.len != 0:
        return smokeFail(message)
    return 0

fn main(): int32 =
    let schema = "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\"]}"
    let moduleA = "{\"kind\":\"csg.module\",\"id\":\"mod_a\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let moduleAReordered = "{\"sha256\":\"sha256:aaa\",\"path\":\"a.cheng\",\"id\":\"mod_a\",\"kind\":\"csg.module\"}"
    let moduleAChanged = "{\"kind\":\"csg.module\",\"id\":\"mod_a\",\"path\":\"a.cheng\",\"sha256\":\"sha256:bbb\"}"
    let moduleB = "{\"kind\":\"csg.module\",\"id\":\"mod_b\",\"path\":\"b.cheng\",\"sha256\":\"sha256:bbb\"}"
    let symbolA = "{\"kind\":\"csg.symbol\",\"id\":\"sym_a\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let symbolB = "{\"kind\":\"csg.symbol\",\"id\":\"sym_b\",\"name\":\"B\",\"symbolKind\":\"fn\"}"

    let same = diff.CsgCoreDiffCanonicalJsonLines([strings.CloneStr(schema), strings.CloneStr(moduleA)], [strings.CloneStr(schema), strings.CloneStr(moduleAReordered)])
    if expectClean(same, "same diff failed") != 0:
        return 1
    if expect(same.leftRoot == same.rightRoot, "same roots differ") != 0:
        return 1

    let changed = diff.CsgCoreDiffCanonicalJsonLines([strings.CloneStr(schema), strings.CloneStr(moduleA)], [strings.CloneStr(schema), strings.CloneStr(moduleAChanged)])
    if expect(changed.ok, "changed diff failed") != 0:
        return 1
    if expectKeys(changed.changed, ["id:mod_a"], "changed keys mismatch") != 0:
        return 1

    let added = diff.CsgCoreDiffCanonicalJsonLines([strings.CloneStr(schema), strings.CloneStr(moduleA)], [strings.CloneStr(schema), strings.CloneStr(moduleA), strings.CloneStr(moduleB)])
    if expect(added.ok, "added diff failed") != 0:
        return 1
    if expectKeys(added.added, ["id:mod_b"], "added keys mismatch") != 0:
        return 1

    let removed = diff.CsgCoreDiffCanonicalJsonLines([strings.CloneStr(schema), strings.CloneStr(moduleA), strings.CloneStr(moduleB)], [strings.CloneStr(schema), strings.CloneStr(moduleA)])
    if expect(removed.ok, "removed diff failed") != 0:
        return 1
    if expectKeys(removed.removed, ["id:mod_b"], "removed keys mismatch") != 0:
        return 1

    let sorted = diff.CsgCoreDiffCanonicalJsonLines([strings.CloneStr(schema), strings.CloneStr(moduleA), strings.CloneStr(symbolB)], [strings.CloneStr(schema), strings.CloneStr(moduleB), strings.CloneStr(symbolA)])
    if expect(sorted.ok, "sorted diff failed") != 0:
        return 1
    if expectKeys(sorted.added, ["id:mod_b", "id:sym_a"], "added sort mismatch") != 0:
        return 1
    if expectKeys(sorted.removed, ["id:mod_a", "id:sym_b"], "removed sort mismatch") != 0:
        return 1

    let missingLeft = "{\"kind\":\"csg.unsupported\",\"code\":\"x\",\"message\":\"left\"}"
    let missingRight = "{\"message\":\"right\",\"code\":\"x\",\"kind\":\"csg.unsupported\"}"
    let missingId = diff.CsgCoreDiffCanonicalJsonLines([strings.CloneStr(schema), strings.CloneStr(missingLeft)], [strings.CloneStr(schema), strings.CloneStr(missingRight)])
    if expect(missingId.ok, "missing id diff failed") != 0:
        return 1
    if expectKeys(
           missingId.added,
           ["anonymous:csg.unsupported:c027c4d1f86c7fac86d488513c1d53741e0e7eb679611554059de6c2e70cfa45"],
           "anonymous added key mismatch") != 0:
        return 1
    if expectKeys(
           missingId.removed,
           ["anonymous:csg.unsupported:cd9c86b9a81c642d77490f1619797dbb85e6b6239d3b054fbe7de1e31c5d3902"],
           "anonymous removed key mismatch") != 0:
        return 1
    if expectKeys(
           missingId.changed,
           [],
           "anonymous facts must use delete plus insert") != 0:
        return 1

    let unsupportedUnicode = diff.CsgCoreDiffCanonicalJsonLines([strings.CloneStr(schema), "{\"kind\":\"csg.module\",\"id\":\"bad\",\"path\":\"\\u0061\",\"sha256\":\"sha256:bad\"}"], [strings.CloneStr(schema)])
    if expect(unsupportedUnicode.ok, "unicode escape canonical decode failed") != 0:
        return 1
    if expectKeys(
           unsupportedUnicode.removed,
           ["id:bad"],
           "unicode escape fact must decode and diff as removed") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "csg_core_diff_smoke ok")
    return 0
