import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn expect(condition: bool, message: str): int32 =
    if !condition:
        return fail(message)
    return 0

@borrows
fn cloneBytes(bytes: rawbytes.Bytes): rawbytes.Bytes =
    var copy = rawbytes.BytesAlloc(rawbytes.BytesLen(bytes))
    rawbytes.BytesCopyInto(copy, 0, bytes)
    return copy

fn writeU32Le(bytes: var rawbytes.Bytes,
              offset: int32,
              value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)
    rawbytes.BytesSet(bytes, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(bytes, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(bytes, offset + 3, (value >> 24) & 255)

@borrows
fn hasError(actual: str, expected: str): bool =
    return strings.StrContains(actual, expected)

fn main(): int32 =
    let callFact =
        "{\"id\":\"call-1\",\"kind\":\"csg.call\",\"name\":\"shared\"}"
    let symbolFactA =
        "{\"id\":\"sym-1\",\"kind\":\"csg.symbol\",\"name\":\"shared\"}"
    let symbolFactB =
        "{\"id\":\"sym-2\",\"kind\":\"csg.symbol\",\"name\":\"shared\"}"
    let encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(
        [strings.CloneStr(symbolFactB),
         strings.CloneStr(callFact),
         strings.CloneStr(symbolFactA)])
    if expect(
           encoded.ok && encoded.claimedDirectoryCid.len == 71,
           "lazy CSGC encode failed") != 0:
        return 1
    let encodedAgain = csgc.CsgCoreCsgcEncodeCanonicalLines(
        [strings.CloneStr(callFact),
         strings.CloneStr(symbolFactA),
         strings.CloneStr(symbolFactB)])
    if expect(
           encodedAgain.ok &&
           encodedAgain.claimedDirectoryCid ==
               encoded.claimedDirectoryCid,
           "directory CID is not deterministic") != 0:
        return 1

    let directory =
        csgc.CsgCoreCsgcParseSectionDirectory(encoded.bytes)
    if expect(
           directory.ok && directory.sectionTags.len == 3 &&
           directory.sectionTags[0] == 1 &&
           directory.sectionKinds[0] == "" &&
           directory.sectionKinds[1] == "csg.call" &&
           directory.sectionKinds[2] == "csg.symbol",
           "section directory is not canonical") != 0:
        return 1

    var iterator = csgc.CsgCoreCsgcSectionIteratorInit()
    let dictionaryView =
        csgc.CsgCoreCsgcSectionIteratorNext(directory, iterator)
    let callView =
        csgc.CsgCoreCsgcSectionIteratorNext(directory, iterator)
    let symbolView =
        csgc.CsgCoreCsgcSectionIteratorNext(directory, iterator)
    let endView =
        csgc.CsgCoreCsgcSectionIteratorNext(directory, iterator)
    if expect(
           dictionaryView.ok && dictionaryView.tag == 1 &&
           dictionaryView.claimedCid.len == 71 &&
           callView.ok && callView.kind == "csg.call" &&
           callView.claimedCid.len == 71 &&
           symbolView.ok && symbolView.kind == "csg.symbol" &&
           endView.ok && endView.done,
           "section iterator contract failed") != 0:
        return 1

    let dictionary =
        csgc.CsgCoreCsgcDecodeDictionary(encoded.bytes)
    let callOnly = csgc.CsgCoreCsgcDecodeFactKindClaimed(
        encoded.bytes, "csg.call")
    if expect(
           dictionary.ok && dictionary.entries.len > 0 &&
           callOnly.ok && callOnly.found &&
           callOnly.lines.len == 1 &&
           callOnly.lines[0] == callFact &&
           callOnly.decodedFactCount == 1 &&
           callOnly.totalFactCount == 3 &&
           callOnly.claimedDirectoryCid ==
               encoded.claimedDirectoryCid &&
           callOnly.decodedSectionBytes < directory.bodySize,
           "fact-kind lazy decode touched the full fact set") != 0:
        return 1

    let missing = csgc.CsgCoreCsgcDecodeFactKindClaimed(
        encoded.bytes, "csg.type")
    if expect(
           missing.ok && !missing.found &&
           missing.decodedFactCount == 0 &&
           missing.claimedDirectoryCid ==
               encoded.claimedDirectoryCid,
           "missing fact-kind was not a canonical empty result") != 0:
        return 1

    let full = csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if expect(
           full.ok && full.factCount == 3 && full.lines.len == 3,
           "full decoder compatibility failed") != 0:
        return 1

    var cidMismatch = cloneBytes(encoded.bytes)
    let callPayload = 64 + directory.sectionOffsets[1] + 4
    rawbytes.BytesSet(
        cidMismatch,
        callPayload,
        (rawbytes.BytesGet(cidMismatch, callPayload) ^ 1) & 255)
    let cidResult = csgc.CsgCoreCsgcDecodeFactKindClaimed(
        cidMismatch, "csg.call")
    if expect(
           !cidResult.ok &&
           hasError(cidResult.error, "section_cid_mismatch"),
           "section CID mismatch was accepted") != 0:
        return 1

    var dictionaryMismatch = cloneBytes(encoded.bytes)
    let dictionaryPayload =
        64 + directory.sectionOffsets[0] + 4
    rawbytes.BytesSet(
        dictionaryMismatch,
        dictionaryPayload,
        (rawbytes.BytesGet(
            dictionaryMismatch, dictionaryPayload) ^ 1) & 255)
    let dictionaryMismatchResult =
        csgc.CsgCoreCsgcDecodeFactKindClaimed(
            dictionaryMismatch,
            "csg.call")
    if expect(
           !dictionaryMismatchResult.ok &&
           hasError(
               dictionaryMismatchResult.error,
               "section_cid_mismatch"),
           "dictionary payload mismatch was accepted") != 0:
        return 1

    var directoryMismatch = cloneBytes(encoded.bytes)
    rawbytes.BytesSet(
        directoryMismatch,
        86,
        (rawbytes.BytesGet(directoryMismatch, 86) ^ 1) & 255)
    let directoryMismatchResult =
        csgc.CsgCoreCsgcDecodeFactKindClaimed(
            directoryMismatch,
            "csg.call")
    if expect(
           !directoryMismatchResult.ok &&
           hasError(
               directoryMismatchResult.error,
               "section_cid_mismatch"),
           "directory byte mismatch was accepted") != 0:
        return 1

    var overlap = cloneBytes(encoded.bytes)
    writeU32Le(overlap, 74, directory.directorySize - 1)
    let overlapResult =
        csgc.CsgCoreCsgcParseSectionDirectory(overlap)
    if expect(
           !overlapResult.ok &&
           hasError(overlapResult.error, "section_overlap"),
           "overlapping section was accepted") != 0:
        return 1

    var outOfBounds = cloneBytes(encoded.bytes)
    writeU32Le(outOfBounds, 78, directory.bodySize)
    let boundsResult =
        csgc.CsgCoreCsgcParseSectionDirectory(outOfBounds)
    if expect(
           !boundsResult.ok &&
           hasError(boundsResult.error, "section_range_out_of_bounds"),
           "out-of-bounds section was accepted") != 0:
        return 1

    var unordered = cloneBytes(encoded.bytes)
    for i in 124..<128:
        rawbytes.BytesSet(unordered, i, 122)
    let unorderedResult =
        csgc.CsgCoreCsgcParseSectionDirectory(unordered)
    if expect(
           !unorderedResult.ok &&
           hasError(unorderedResult.error, "non_canonical_section_order"),
           "unordered sections were accepted") != 0:
        return 1

    let truncated = rawbytes.BytesSliceView(
        encoded.bytes, 0, rawbytes.BytesLen(encoded.bytes) - 1)
    let truncatedResult =
        csgc.CsgCoreCsgcParseSectionDirectory(truncated)
    if expect(
           !truncatedResult.ok &&
           hasError(truncatedResult.error, "truncated_body_size_mismatch"),
           "truncated CSGC was accepted") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "csg_core_csgc_lazy_smoke ok")
    return 0
