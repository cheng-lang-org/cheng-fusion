import std/os

importc fn cheng_udp_use_len_field_consistency_bridge(): int32

fn main(): int32 =
    let flag: int32 = os.UdpPlatformUseLenFieldBridge()
    let consistency: int32 = cheng_udp_use_len_field_consistency_bridge()
    if flag == 0:
        assert(consistency == 0, " udp use len field consistency: linux")
    else:
        assert(flag == 1, " udp use len field consistency: flag")
        assert(consistency == 1111, " udp use len field consistency: bsd")
    echo(" udp_use_len_field_consistency_smoke ok")
    return 0
