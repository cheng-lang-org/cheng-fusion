type
    ColdRefObjectBorrowSequenceElementOuter = ref object
        values: int32[]

fn ColdRefObjectBorrowSequenceElementWrite(
        values: var int32[]) =
    add(values, 19)

fn ColdRefObjectBorrowSequenceElementMutate(
        out: var ColdRefObjectBorrowSequenceElementOuter) =
    var values = out.values
    let forbiddenElement = out.values[0]
    ColdRefObjectBorrowSequenceElementWrite(values)
    if forbiddenElement == 0:
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowSequenceElementOuter)
    add(out.values, 7)
    ColdRefObjectBorrowSequenceElementMutate(out)
    return 0
