import tests/cold_ref_object_field_capacity_fixture as capacity

fn main(): int32 =
    var value = capacity.NewLargeRef()
    if value.f00 != 7:
        return 10
    if value.f63 != 63:
        return 63
    if value.f64 != 64:
        return 64
    value.f64 = 65
    if value.f64 != 65:
        return 65
    return 0
