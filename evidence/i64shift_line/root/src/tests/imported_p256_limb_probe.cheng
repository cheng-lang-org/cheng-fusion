import std/crypto/p256_fixed as pfix

fn importedP256LimbProbe(a: pfix.P256Fixed): uint64 =
    return pfix.p256FixedWordToBitsU64(a.limbs[0])

fn importedP256ScratchProbe(scratch: var pfix.P256FixedMontgomeryScratch): uint64 =
    return pfix.p256FixedWordToBitsU64(scratch.words[0])

fn importedP256ScratchDynamicProbe(scratch: var pfix.P256FixedMontgomeryScratch, i: int32): uint64 =
    return pfix.p256FixedWordToBitsU64(scratch.words[i])
