fn cheng_str_data(s: str): ptr =
    return s.data

fn cheng_ptr_plus(base: ptr, off: int32): ptr =
    return base

fn cheng_str_len(s: str): int32 =
    return s.len

fn probe(arg: str, key: str): int32 =
    let keyLen = cheng_str_len(key)
    let sep = *(UInt8Ptr(cheng_ptr_plus(cheng_str_data(arg), keyLen)))
    if int32(sep) == 58:
        return 1
    return 0

fn main(): int32 =
    return probe("foo:bar", "foo")

main()
