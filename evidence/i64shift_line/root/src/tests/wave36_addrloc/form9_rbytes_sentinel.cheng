# wave36 rbytes 四分叉哨兵 — #1b 嵌套实参族 第八/九形态 (read-deref 蒸发 + 混参槽位错位) 判决探针
# 原始: /tmp/wipv11/rbytes.cheng (30 秒四分叉复现, 30秒验收口径资产)
# 定谳: err支=90(误判NUL) / 空bytes=80+n(BytesLen坏) / ToString断裂 / 全绿=5 四路一次探清, 曾恒 rc=90
# 期望 rc = 5 (=strings.Len("hello"), 四支中任一劣化即偏离 5)
# 案卷: docs/op-lane-queue-2026-07-09.md L230/233 (四分叉定位+验收口径) + L251/253 (形态八/九根修后三绿实测)
# 路径已去会话依赖 (/tmp/wipv11 → /tmp/wave36_form9_rbytes_probe.txt), 判决逻辑逐字未改

import std/os as os
import std/rawbytes as rawbytes
import std/strings as strings

fn main(): int32 =
    let path: str = "/tmp/wave36_form9_rbytes_probe.txt"
    os.WriteFile(path, "hello")
    var br: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if IsErr(br):
        return 90
    let b: rawbytes.Bytes = Value(br)
    let n: int32 = rawbytes.BytesLen(b)
    if n != 5:
        return 80 + n
    let s: str = rawbytes.BytesToString(b)
    return strings.Len(s)
