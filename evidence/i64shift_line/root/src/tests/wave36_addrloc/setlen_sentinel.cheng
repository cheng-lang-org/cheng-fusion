# wave36 setLen 哨兵 — #1b 嵌套实参 / 第五形态代表点
# 验收: gen2 编本夹具秒级出 exe 且 rc=0 (非挂死)
# 镜像: src/tests/waveA_sentinels/setlen_zero_tail_ptr_field.cheng

fn main(): int32 =
    var row: int32[]
    setLen(row, 2)
    if row.len != 2:
        return 1
    if row[0] != 0:
        return 2
    if row[1] != 0:
        return 3
    return 0
