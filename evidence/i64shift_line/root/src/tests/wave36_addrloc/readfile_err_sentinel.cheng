# wave36 readfile err 支哨兵 — #1b 族 err 分支腐坏判决探针
# 原始: /tmp/wipv11/rerr.cheng (四分叉资产的 err 支单独隔离件)
# 定谳: 曾 err 支误命中且 Err 载荷本身腐坏(写它都 panic, rc=1); 根修后成功路径直落 err 支不再误判 NUL
# 期望 rc = 0 (err 支未命中, 走 return 0 成功路径)
# 案卷: docs/op-lane-queue-2026-07-09.md L233 (期望口径) + L238 (err 载荷腐坏实证) + L253 (根修后 rerr=0 三绿实测)
# 路径已去会话依赖 (/tmp/wipv11 → /tmp/wave36_readfile_err_probe.txt), 判决逻辑逐字未改

import std/os as os
import std/rawbytes as rawbytes
import std/strings as strings

fn main(): int32 =
    let path: str = "/tmp/wave36_readfile_err_probe.txt"
    os.WriteFile(path, "hello")
    var br: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if IsErr(br):
        let e: str = Error(br)
        os.WriteFile("/tmp/wave36_readfile_err_errtext.txt", e)
        return strings.Len(e)
    return 0
