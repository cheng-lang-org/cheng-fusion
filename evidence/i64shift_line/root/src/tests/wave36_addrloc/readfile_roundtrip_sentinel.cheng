# wave36 readfile 读写往返哨兵 — std/os.ReadFile 对已存在文件返回空串独立案
# 原始: /tmp/bisect11/s4_debug_readwrite.cheng (双世代稳定复现, S7/TraceStage rc=2 是其下游症状)
# 定谳: WriteFile("hello") 后同路径 ReadFile 曾返回空串(rc=0), #1b 形态八 read-deref 根修后往返一致
# 期望 rc = 5 (=strings.Len("hello"))
# 案卷: docs/op-lane-queue-2026-07-09.md L213 (独立立案) + L233 (期望口径) + L253 (根修后 s4_debug=5 三绿实测)
# 路径已去会话依赖 (/tmp/bisect11 → /tmp/wave36_readfile_roundtrip_probe.txt), 判决逻辑逐字未改

import std/os as os
import std/strings as strings

fn main(): int32 =
    let path: str = "/tmp/wave36_readfile_roundtrip_probe.txt"
    os.WriteFile(path, "hello")
    let back: str = os.ReadFile(path)
    return strings.Len(back)
