# wave36 bare_deref 哨兵 — F 线 i64/指针宽度代表 (防静默 4B 截断)
# 验收: gen2 编本夹具秒级出 exe 且 rc=0
# 风格对齐: src/tests/waveA_sentinels/bare_deref_inline_wide.cheng

type I64P = int64 *

@importc("malloc")
fn c_malloc(n: uint64): ptr

fn main(): int32 =
    let raw = c_malloc(uint64(8))
    let slot: I64P = I64P(raw)
    *slot = 0x1122334455667788
    let y = *slot
    if y != 0x1122334455667788:
        return 1
    return 0
