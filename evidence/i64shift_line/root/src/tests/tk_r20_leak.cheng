fn R20Build(n: int32): str =
    var s = "seed"
    s = s + "0123456789012345678901234567890123456789012345678901234567890123"
    if n < 0:
        s = s + "neg"
    return s

fn main(): int32 =
    var i: int32
    var total: int64
    while i < 300000:
        let piece = R20Build(i)
        total = total + piece.len
        i = i + 1
    if total != 20400000:
        echo("bad total")
        return 10
    echo("r20 leak probe done")
    return 0
