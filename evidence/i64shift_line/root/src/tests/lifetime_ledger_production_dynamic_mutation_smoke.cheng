import cheng/core/tooling/lifetime_ledger as lifetime

fn main(): int32 =
    var observed: lifetime.LifetimeLedger
    lifetime.LifetimeLedgerInit(observed)
    let category = lifetime.LifetimeLedgerRegisterCategory(
        observed, "production_dynamic_payload")
    let ownerA = lifetime.LifetimeLedgerRegisterOwner(
        observed, "production_dynamic_producer")
    let ownerB = lifetime.LifetimeLedgerRegisterOwner(
        observed, "production_dynamic_consumer")
    let objectId = lifetime.LifetimeLedgerReserveObject(
        observed, category, int64(96))
    lifetime.LifetimeLedgerOwn(observed, objectId, ownerA)
    let borrowId = lifetime.LifetimeLedgerBorrow(
        observed, objectId, ownerB)
    if lifetime.LifetimeLedgerRead(
            observed, objectId, ownerB) != category:
        panic("lifetime ledger dynamic: borrow read mismatch")
    lifetime.LifetimeLedgerReturnBorrow(
        observed, objectId, borrowId, ownerB)
    lifetime.LifetimeLedgerMove(
        observed, objectId, ownerA, ownerB)
    lifetime.LifetimeLedgerRelease(
        observed, objectId, ownerB)
    lifetime.LifetimeLedgerAssertOwnerClosed(observed, ownerA)
    lifetime.LifetimeLedgerAssertOwnerClosed(observed, ownerB)
    lifetime.LifetimeLedgerAssertClosed(observed)
    var metrics: lifetime.LifetimeLedgerMetrics
    lifetime.LifetimeLedgerReadTotalMetrics(observed, metrics)
    if metrics.allocated != int64(1) ||
       metrics.released != int64(1) ||
       metrics.live != int64(0) ||
       metrics.allocatedBytes != int64(96) ||
       metrics.releasedBytes != int64(96) ||
       metrics.liveBytes != int64(0) ||
       metrics.retained != int64(1) ||
       metrics.borrowReturnCount != int64(1) ||
       metrics.ownerTransferCount != int64(1):
        panic("lifetime ledger dynamic: logical receipt mismatch")
    let storageRelease =
        lifetime.LifetimeLedgerReleaseStorage(observed)
    if !storageRelease.storageReleased ||
       storageRelease.releasedSequenceBufferCount != 6 ||
       storageRelease.releasedSequenceCapacityBytes <= int64(0) ||
       !lifetime.LifetimeLedgerStorageReleased(observed):
        panic("lifetime ledger dynamic: physical release mismatch")
    echo("lifetime_ledger_production_dynamic path=success allocated=1 released=1 live=0 bytes=96 borrow=1 borrow_return=1 move=1 physical_release=1")
    return 0
