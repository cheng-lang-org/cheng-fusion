const
    NodeKindModule: int32 = 2
    NodeKindSymbol: int32 = 3

type
    GraphNode =
        nodeKind: int32
        paramSlot: int32
        weight: int32

    Graph =
        nodes: GraphNode[]

fn CountSymbols(g: Graph): int32 =
    var total = 0
    var i = 0
    while i < g.nodes.len:
        let node = g.nodes[i]
        i = i + 1
        if node.nodeKind != NodeKindSymbol:
            continue
        total = total + node.weight
    return total

fn MaxParamSlot(g: Graph): int32 =
    var maxSlot = -1
    for idx in 0..<g.nodes.len:
        let node = g.nodes[idx]
        if node.nodeKind == NodeKindModule:
            continue
        if node.paramSlot > maxSlot:
            maxSlot = node.paramSlot
    return maxSlot

fn main(): int32 =
    var g: Graph
    var n0: GraphNode
    n0.nodeKind = NodeKindModule
    n0.paramSlot = 1
    n0.weight = 100
    var n1: GraphNode
    n1.nodeKind = NodeKindSymbol
    n1.paramSlot = 5
    n1.weight = 10
    var n2: GraphNode
    n2.nodeKind = NodeKindSymbol
    n2.paramSlot = 3
    n2.weight = 7
    add(g.nodes, n0)
    add(g.nodes, n1)
    add(g.nodes, n2)
    let sym = CountSymbols(g)
    if sym != 17:
        return 1
    let maxSlot = MaxParamSlot(g)
    if maxSlot != 5:
        return 2
    return 0
