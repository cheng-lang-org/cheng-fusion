import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_paint_runtime as paint
import std/strutils as strutil

# Mutation-invalidation correctness repros for the three frame-path
# optimizations. Each one proves: (1) the optimized path returns the same
# answer a full rescan would immediately after a mutation (no stale read),
# and (2) a query that should legitimately miss still misses (no false
# positives introduced by the memo/index).

fn Fail(id: int32): int32 =
    echo(strutil.Join(["frame_perf_opt_correctness_repro FAIL id=", IntToStr(id)], ""))
    return id

# ---------------------------------------------------------------------
# A. WebSceneInvalidateLayerCachesForDirtySpans: a mutation applied AFTER
# one dirty-span batch has already rebuilt+consumed the range index must
# be visible to the NEXT batch's rebuild (proves the once-per-batch hoist
# in WebSceneInvalidateLayerCachesForDirtySpans does not leak a stale
# index across separate top-level calls).
# ---------------------------------------------------------------------
fn ReproA(): int32 =
    var graph: scene.WebSceneGraph
    var routeIndex = -1
    if !scene.WebSceneAddRoute(graph, "repro_a_route", 1, 1, routeIndex):
        return Fail(101)
    if !scene.WebSceneAddLayer(graph, routeIndex, 1, "content", 0):
        return Fail(102)
    if !scene.WebSceneAddNode(graph, routeIndex, 1, 0, 2, "div", "", 1):
        return Fail(103)
    if !scene.WebSceneAddNode(graph, routeIndex, 2, 1, 2, "div", "", 1):
        return Fail(104)
    if !scene.WebSceneAddPaintOpAt(graph, routeIndex, 2, 0, 0, 0, scene.WebScenePaintFill, Int64(4278190080), 0, 10, 10, "", ""):
        return Fail(105)
    if !scene.WebSceneEnsureLayerCache(graph, routeIndex, 1):
        return Fail(106)

    var span1: scene.WebSceneDirtySpan
    span1.routeIndex = routeIndex
    span1.reason = scene.WebSceneDirtyRoute
    add(graph.dirtySpans, span1)
    if !scene.WebSceneInvalidateLayerCachesForDirtySpans(graph):
        return Fail(107)
    let cacheIndex = scene.WebSceneFindLayerCacheIndex(graph, routeIndex, 1)
    if cacheIndex < 0:
        return Fail(108)
    # WebSceneInvalidateLayerCacheAt (called for every dirty span) computes
    # the union paint bounds and stores them as the layer's dirty rect —
    # this is the field the batched range-index rebuild actually feeds, so
    # it is what proves the rebuild saw node 2's paintOp.
    let dw1 = scene.WebSceneLayerCacheDirtyWidth(graph, routeIndex, 1)
    if dw1 != 10:
        return Fail(109)
    setLen(graph.dirtySpans, 0)

    # Mutation: a second node+paintOp appear at a disjoint position (e.g. a
    # list grew by one row) strictly AFTER the first dirty-span batch
    # already ran and rebuilt the range index once. Disjoint position (not
    # overlapping node 2's rect) so the union width can only grow if the
    # rebuild actually walked the new paintOp.
    if !scene.WebSceneAddNode(graph, routeIndex, 3, 1, 2, "div", "", 1):
        return Fail(110)
    if !scene.WebSceneAddPaintOpAt(graph, routeIndex, 3, 0, 40, 40, scene.WebScenePaintFill, Int64(4278190080), 0, 10, 10, "", ""):
        return Fail(111)

    var span2: scene.WebSceneDirtySpan
    span2.routeIndex = routeIndex
    span2.reason = scene.WebSceneDirtyRoute
    add(graph.dirtySpans, span2)
    if !scene.WebSceneInvalidateLayerCachesForDirtySpans(graph):
        return Fail(112)
    # Union of (0,0,10,10) and (40,40,10,10) is (0,0,50,50): width only
    # reaches 50 if the second batch's rebuild actually included node 3's
    # paintOp added after batch 1.
    let dw2 = scene.WebSceneLayerCacheDirtyWidth(graph, routeIndex, 1)
    if dw2 != 50:
        return Fail(113)
    return 0

# ---------------------------------------------------------------------
# B. WebSceneGlyphAtlasFindGlyphIndexCached / WebSceneGlyphAtlasSyncRunLookupCache:
# a glyph appended to atlas.glyphs strictly after the cache table was
# already built (and already queried once) must be found by the very next
# query without rebuilding the whole table from scratch; a genuinely
# absent (fontAtlasId, codepoint, fontSize) triple must still miss; and a
# duplicate codepoint inserted later must not shadow the earlier (correct,
# linear-scan-first-match) entry.
# ---------------------------------------------------------------------
fn ReproB(): int32 =
    var atlas: scene.WebSceneGlyphAtlas
    scene.WebSceneGlyphAtlasInit(atlas)
    var g1: scene.WebSceneGlyphAtlasGlyphEntry
    g1.glyphId = 1
    g1.fontAtlasId = 101
    g1.sdfAtlasId = 1001
    g1.codepoint = 65
    g1.fontSize = 14
    g1.advance = 8
    add(atlas.glyphs, g1)
    var g2: scene.WebSceneGlyphAtlasGlyphEntry
    g2.glyphId = 2
    g2.fontAtlasId = 202
    g2.sdfAtlasId = 2002
    g2.codepoint = 65
    g2.fontSize = 16
    g2.advance = 9
    add(atlas.glyphs, g2)

    var cacheSlots: int32[]
    var builtUpTo: int32 = 0
    let idx1 = scene.WebSceneGlyphAtlasFindGlyphIndexCached(atlas, 101, 65, 14, cacheSlots, builtUpTo)
    if idx1 != 0:
        return Fail(201)
    # genuinely absent triple: same codepoint, but no glyph at fontSize=99
    let idxMiss = scene.WebSceneGlyphAtlasFindGlyphIndexCached(atlas, 101, 65, 99, cacheSlots, builtUpTo)
    if idxMiss != -1:
        return Fail(202)

    # Mutation: a glyph is rasterized on demand and appended strictly
    # after the cache table above was already built and queried.
    var g3: scene.WebSceneGlyphAtlasGlyphEntry
    g3.glyphId = 3
    g3.fontAtlasId = 101
    g3.sdfAtlasId = 1001
    g3.codepoint = 66
    g3.fontSize = 14
    g3.advance = 10
    add(atlas.glyphs, g3)
    let idx3 = scene.WebSceneGlyphAtlasFindGlyphIndexCached(atlas, 101, 66, 14, cacheSlots, builtUpTo)
    if idx3 != 2:
        return Fail(203)

    # Duplicate codepoint appended later for the same (fontAtlasId,
    # fontSize): the cache must keep resolving to the earlier (index 0)
    # entry, matching WebSceneGlyphAtlasFindGlyphIndex's first-match
    # linear-scan semantics.
    var g4: scene.WebSceneGlyphAtlasGlyphEntry
    g4.glyphId = 4
    g4.fontAtlasId = 101
    g4.sdfAtlasId = 1001
    g4.codepoint = 65
    g4.fontSize = 14
    g4.advance = 11
    add(atlas.glyphs, g4)
    let idxDup = scene.WebSceneGlyphAtlasFindGlyphIndexCached(atlas, 101, 65, 14, cacheSlots, builtUpTo)
    if idxDup != 0:
        return Fail(204)

    # Cross-check against the uncached linear scan for every query above —
    # the cache must never disagree with the reference implementation.
    if scene.WebSceneGlyphAtlasFindGlyphIndex(atlas, 101, 66, 14) != idx3:
        return Fail(205)
    if scene.WebSceneGlyphAtlasFindGlyphIndex(atlas, 101, 65, 14) != idxDup:
        return Fail(206)
    if scene.WebSceneGlyphAtlasFindGlyphIndex(atlas, 101, 65, 99) != idxMiss:
        return Fail(207)
    return 0

# ---------------------------------------------------------------------
# C. WebSceneAppendPaintCommand SVG icon primitive range index: a
# primitive added to one icon node strictly after the range index was
# already rebuilt+used once must show up (and only for that node) once
# the index is rebuilt again; a sibling node's primitives must never leak
# into it either before or after the mutation.
# ---------------------------------------------------------------------
fn CountIconPrimitives(graph: var scene.WebSceneGraph, routeIndex: int32, nodeId: int32): int32 =
    let paintOpIndex = scene.WebSceneFindPaintOpIndex(graph, routeIndex, nodeId, 0)
    if paintOpIndex < 0:
        return -1
    let sceneOp = graph.paintOps[paintOpIndex]
    var ops: paint.PaintOp[]
    if !scene.WebSceneAppendPaintCommand(graph, sceneOp, ops):
        return -1
    if ops.len != 1:
        return -1
    return ops[0].icon.primitives.len

fn ReproC(): int32 =
    var graph: scene.WebSceneGraph
    var routeIndex = -1
    if !scene.WebSceneAddRoute(graph, "repro_c_route", 1, 1, routeIndex):
        return Fail(301)
    if !scene.WebSceneAddLayer(graph, routeIndex, 1, "content", 0):
        return Fail(302)
    if !scene.WebSceneAddNode(graph, routeIndex, 1, 0, 2, "div", "", 1):
        return Fail(303)
    if !scene.WebSceneAddNode(graph, routeIndex, 2, 1, 2, "svg", "", 1):
        return Fail(304)
    if !scene.WebSceneAddNode(graph, routeIndex, 3, 1, 2, "svg", "", 1):
        return Fail(305)
    if !scene.WebSceneAddPaintOpAt(graph, routeIndex, 2, 0, 0, 0, scene.WebScenePaintSvgIcon, Int64(4278190080), 0, 16, 16, "icon", ""):
        return Fail(306)
    if !scene.WebSceneAddPaintOpAt(graph, routeIndex, 3, 0, 0, 0, scene.WebScenePaintSvgIcon, Int64(4278190080), 0, 16, 16, "icon", ""):
        return Fail(307)
    if !scene.WebSceneAddPaintSvgLineKnownPaintOp(graph, routeIndex, 2, 0, 0, 0, 1, 1):
        return Fail(308)
    if !scene.WebSceneAddPaintSvgLineKnownPaintOp(graph, routeIndex, 2, 0, 2, 2, 3, 3):
        return Fail(309)
    if !scene.WebSceneAddPaintSvgLineKnownPaintOp(graph, routeIndex, 3, 0, 4, 4, 5, 5):
        return Fail(310)
    if !scene.WebSceneRebuildPaintCommandRangeIndexes(graph):
        return Fail(311)

    if CountIconPrimitives(graph, routeIndex, 2) != 2:
        return Fail(312)
    if CountIconPrimitives(graph, routeIndex, 3) != 1:
        return Fail(313)

    # Mutation: a new icon node (e.g. a list grew by one row) appears
    # strictly after the range index above was already rebuilt and
    # already queried once. (Retroactively appending a primitive to an
    # *earlier* node after a *later* node already has one would violate
    # the node-contiguity invariant WebSceneIndexSvgPrimitiveRanges shares
    # with the pre-existing paintOps/paintShadows/paintGradients range
    # indexes — graph.paintSvgPrimitives is populated strictly in
    # per-node order by the scene materializer, same as those three
    # arrays, so that is not a supported mutation shape for any of the
    # four range-indexed arrays, not something this change introduces.)
    if !scene.WebSceneAddNode(graph, routeIndex, 4, 1, 2, "svg", "", 1):
        return Fail(314)
    if !scene.WebSceneAddPaintOpAt(graph, routeIndex, 4, 0, 0, 0, scene.WebScenePaintSvgIcon, Int64(4278190080), 0, 16, 16, "icon", ""):
        return Fail(315)
    if !scene.WebSceneAddPaintSvgLineKnownPaintOp(graph, routeIndex, 4, 0, 6, 6, 7, 7):
        return Fail(316)
    if !scene.WebSceneAddPaintSvgLineKnownPaintOp(graph, routeIndex, 4, 0, 8, 8, 9, 9):
        return Fail(317)
    if !scene.WebSceneRebuildPaintCommandRangeIndexes(graph):
        return Fail(318)
    if CountIconPrimitives(graph, routeIndex, 4) != 2:
        return Fail(319)
    # sibling nodes 2 and 3 must be unaffected by node 4's mutation
    if CountIconPrimitives(graph, routeIndex, 2) != 2:
        return Fail(320)
    if CountIconPrimitives(graph, routeIndex, 3) != 1:
        return Fail(321)
    return 0

fn main(): int32 =
    let a = ReproA()
    if a != 0:
        return a
    let b = ReproB()
    if b != 0:
        return b
    let c = ReproC()
    if c != 0:
        return c
    echo("frame_perf_opt_correctness_repro ok")
    return 0
