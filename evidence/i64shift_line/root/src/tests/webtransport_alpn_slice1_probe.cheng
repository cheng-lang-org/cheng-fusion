# Slice 1 real-network proof: ALPN dispatch (h3 vs dm) over a real loopback
# QUIC/TLS1.3 handshake, plus the first real consumer of
# libp2p/transports/webtransport_common.cheng's SETTINGS validator, fed by
# real HTTP/3 SETTINGS frame bytes that crossed the same real connection.
#
# Non-production note: TLS material comes from cheng/quic/tls/test_pki.cheng
# (fixed self-signed localhost cert). No certificate rotation / libp2p
# certhash / Noise identity binding is exercised here -- see design.md.

import std/system
import std/result
import std/rawbytes
import cheng/quic/multiaddress as qaddr
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport
import cheng/quic/tls/policy as qpolicy
import cheng/quic/tls/test_pki as testpki
import cheng/quic/tls/handshake13 as handshake13
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/http3/frame as h3frame
import cheng/libp2p/transports/webtransport_common as wtcommon

type
    ScenarioPair =
        listener: qtransport.MsQuicTransport
        client: qtransport.MsQuicTransport
        outbound: qconn.Connection
        inbound: qconn.Connection

fn makeAddr(port: int32): qaddr.MultiAddress =
    var out: qaddr.MultiAddress
    out.raw = "/ip4/127.0.0.1/udp/" + IntToStr(port) + "/quic-v1"
    out.data = BytesFromString(out.raw)
    return out

fn policyAlpn1(a: str): qpolicy.MsQuicTlsPolicy =
    var out: qpolicy.MsQuicTlsPolicy
    testpki.msquicMakeLocalhostTlsPolicyInto(out)
    let r: Result[bool] = qpolicy.msquicTlsPolicyAddAlpn(out, a)
    assert(IsOk(r), " probe: policyAlpn1 setup")
    return out

fn policyAlpn2(a: str, b: str): qpolicy.MsQuicTlsPolicy =
    var out: qpolicy.MsQuicTlsPolicy
    testpki.msquicMakeLocalhostTlsPolicyInto(out)
    let r1: Result[bool] = qpolicy.msquicTlsPolicyAddAlpn(out, a)
    assert(IsOk(r1), " probe: policyAlpn2 setup a")
    let r2: Result[bool] = qpolicy.msquicTlsPolicyAddAlpn(out, b)
    assert(IsOk(r2), " probe: policyAlpn2 setup b")
    return out

fn openScenario(out: var ScenarioPair,
                 clientPolicy: qpolicy.MsQuicTlsPolicy,
                 serverPolicy: qpolicy.MsQuicTlsPolicy,
                 port: int32): Result[bool] =
    out.listener = qtransport.InitMsQuicTransport()
    out.client = qtransport.InitMsQuicTransport()
    let listenerTlsRes: Result[bool] = qtransport.setMsQuicTransportTlsPolicy(out.listener, serverPolicy)
    if IsErr(listenerTlsRes):
        return Err[bool]("scenario: listener tls: " + ErrorText(listenerTlsRes))
    let clientTlsRes: Result[bool] = qtransport.setMsQuicTransportTlsPolicy(out.client, clientPolicy)
    if IsErr(clientTlsRes):
        return Err[bool]("scenario: client tls: " + ErrorText(clientTlsRes))
    let addr: qaddr.MultiAddress = makeAddr(port)
    qtransport.start(out.listener, addr)
    if ! out.listener.running:
        return Err[bool]("scenario: listener start: " + out.listener.lastError)
    let dialRes: Result[qconn.Connection] = qtransport.dial(out.client, out.listener.listenAddr)
    if IsErr(dialRes):
        qtransport.Stop(out.listener)
        return Err[bool]("scenario: dial: " + ErrorText(dialRes))
    out.outbound = Value(dialRes)
    let acceptRes: Result[qconn.Connection] = qtransport.accept(out.listener)
    if IsErr(acceptRes):
        qconn.ConnClose(out.outbound)
        qtransport.Stop(out.listener)
        return Err[bool]("scenario: accept: " + ErrorText(acceptRes))
    out.inbound = Value(acceptRes)
    return Ok[bool](true)

fn closeScenario(pair: var ScenarioPair) =
    qconn.ConnClose(pair.outbound)
    qconn.ConnClose(pair.inbound)
    qtransport.Stop(pair.listener)

# Scenario A: client offers [h3,dm], server supports [h3,dm] (server
# preference order) -> real handshake must land on "h3", proving ALPN
# dispatch actually branches instead of the old hardcoded "dm" echo.
fn scenarioAH3Preferred(): ScenarioPair =
    handshake13.msquicTls13ResetClientDefault(true)
    let clientPolicy: qpolicy.MsQuicTlsPolicy = policyAlpn2("h3", "dm")
    let serverPolicy: qpolicy.MsQuicTlsPolicy = policyAlpn2("h3", "dm")
    var pair: ScenarioPair
    let openRes: Result[bool] = openScenario(pair, clientPolicy, serverPolicy, 58301)
    if IsErr(openRes):
        panic(" scenario A open: " + ErrorText(openRes))
    let negotiated: str = handshake13.msquicTls13ClientNegotiatedAlpn()
    assert(negotiated == "h3", " scenario A: expected h3, got " + negotiated)
    echo(" scenario A (h3 preferred dispatch) ok: negotiated=" + negotiated)
    return pair

# Scenario B: legacy client offers only [dm], server supports [h3,dm] ->
# must fall back to "dm" (backward compatibility dispatch, no protocol the
# client never offered gets forced on it).
fn scenarioBLegacyDmFallback() =
    handshake13.msquicTls13ResetClientDefault(true)
    let clientPolicy: qpolicy.MsQuicTlsPolicy = policyAlpn1("dm")
    let serverPolicy: qpolicy.MsQuicTlsPolicy = policyAlpn2("h3", "dm")
    var pair: ScenarioPair
    let openRes: Result[bool] = openScenario(pair, clientPolicy, serverPolicy, 58302)
    if IsErr(openRes):
        panic(" scenario B open: " + ErrorText(openRes))
    let negotiated: str = handshake13.msquicTls13ClientNegotiatedAlpn()
    assert(negotiated == "dm", " scenario B: expected dm, got " + negotiated)
    echo(" scenario B (legacy dm fallback dispatch) ok: negotiated=" + negotiated)
    closeScenario(pair)

# Scenario C: no overlap (client only offers "dm", server only supports
# "h3") -> real negotiation failure, not a silent default. Proves the
# no_application_protocol path is real, not decorative.
fn scenarioCNoOverlapRejected() =
    handshake13.msquicTls13ResetClientDefault(true)
    let clientPolicy: qpolicy.MsQuicTlsPolicy = policyAlpn1("dm")
    let serverPolicy: qpolicy.MsQuicTlsPolicy = policyAlpn1("h3")
    var pair: ScenarioPair
    let openRes: Result[bool] = openScenario(pair, clientPolicy, serverPolicy, 58303)
    assert(IsErr(openRes), " scenario C: expected handshake failure on alpn mismatch, got success")
    echo(" scenario C (no-overlap alpn rejected) ok: " + ErrorText(openRes))

# First real consumer of webtransport_common's SETTINGS validation: builds a
# real HTTP/3 SETTINGS frame with http3/frame.cheng (production framing,
# previously only reached from the Hysteria2 VPN disguise path), writes it
# across the real "h3"-negotiated QUIC connection from scenario A, reads it
# back on the real server side, decodes it, and validates it via
# settingsIsWebtransportCapable (see webtransport_common.cheng for why that
# wrapper exists instead of the Option[str]-returning settingsValidationError).
#
# SETTINGS_WEBTRANSPORT_MAX_SESSIONS (0xc671706a) is deliberately excluded
# from the wire entries below: quic_varint.quicVarIntEncodedLen on the pinned
# driver miscompares int64 values above int32 range (verified in isolation --
# see design.md / varint_repro.cheng), so encoding that exact wire id always
# fails with "value out of range". The 2 real wire cases here only need the
# small-id settings (0x8, 0x33) to prove the frame/decode/validate path with
# real bytes; the max-sessions accept dimension is proven separately below
# without going through the wire encoder.
fn settingsRoundTrip(pair: var ScenarioPair, entries: h3frame.Http3Setting[]): Result[bool] =
    let frameRes: Result[Bytes] = h3frame.Http3EncodeSettingsFrame(entries)
    assert(IsOk(frameRes), " settings round trip: encode")
    let framed: Bytes = quic_transport.Libp2pQuicEncodeFrame(Value(frameRes))
    let writeRes: Result[bool] = quic_transport.Libp2pQuicWriteExact(pair.client, pair.outbound, framed)
    assert(IsOk(writeRes), " settings round trip: write")
    let recvRes: Result[Bytes] = quic_transport.Libp2pQuicReadFrame(pair.listener, pair.inbound)
    assert(IsOk(recvRes), " settings round trip: read")
    let decodedRes: Result[h3frame.Http3FrameDecoded] = h3frame.Http3DecodeFrame(Value(recvRes), 0)
    assert(IsOk(decodedRes), " settings round trip: frame decode")
    assert(Value(decodedRes).frame.kind == h3frame.Http3FrameSettings, " settings round trip: frame kind")
    let entriesRes: Result[h3frame.Http3Setting[]] = h3frame.Http3DecodeSettingsFramePayload(Value(decodedRes).frame.payload)
    assert(IsOk(entriesRes), " settings round trip: settings decode")
    let settings: wtcommon.Http3Settings = wtcommon.Http3SettingsFromEntries(Value(entriesRes))
    return wtcommon.settingsIsWebtransportCapable(settings)

fn webtransportSettingsOverH3Connection() =
    var pair: ScenarioPair = scenarioAH3Preferred()

    # Real wire case 1: CONNECT protocol missing -> must reject on that
    # specific reason (datagram alone is not enough).
    var missingConnectEntries: h3frame.Http3Setting[]
    add(missingConnectEntries, h3frame.Http3MakeSetting(int64(wtcommon.http3SettingsH3Datagram), 1))
    let missingConnectRes: Result[bool] = settingsRoundTrip(pair, missingConnectEntries)
    assert(IsErr(missingConnectRes), " webtransport settings: missing CONNECT protocol must be rejected")
    assert(ErrorText(missingConnectRes) == "remote endpoint did ! enable CONNECT protocol",
        " webtransport settings: wrong rejection reason: " + ErrorText(missingConnectRes))
    echo(" webtransport settings (missing connect-protocol, real wire) rejected ok: " + ErrorText(missingConnectRes))

    # Real wire case 2: datagrams missing -> must reject on that reason.
    var missingDatagramEntries: h3frame.Http3Setting[]
    add(missingDatagramEntries, h3frame.Http3MakeSetting(int64(wtcommon.http3SettingsEnableConnectProtocol), 1))
    let missingDatagramRes: Result[bool] = settingsRoundTrip(pair, missingDatagramEntries)
    assert(IsErr(missingDatagramRes), " webtransport settings: missing datagram support must be rejected")
    assert(ErrorText(missingDatagramRes) == "remote endpoint did ! enable HTTP/3 datagrams",
        " webtransport settings: wrong rejection reason: " + ErrorText(missingDatagramRes))
    echo(" webtransport settings (missing datagram, real wire) rejected ok: " + ErrorText(missingDatagramRes))

    # Accept-path proof (not wire -- see comment above settingsRoundTrip):
    # a fully-capable Http3Settings must validate Ok.
    var capable: wtcommon.Http3Settings
    capable.enableConnectProtocol = true
    capable.enableDatagram = true
    capable.maxSessions = 16
    let capableRes: Result[bool] = wtcommon.settingsIsWebtransportCapable(capable)
    assert(IsOk(capableRes), " webtransport settings: fully capable settings must validate")
    echo(" webtransport settings (capable, direct struct) ok")

    closeScenario(pair)

fn main(): int32 =
    webtransportSettingsOverH3Connection()
    scenarioBLegacyDmFallback()
    scenarioCNoOverlapRejected()
    echo(" webtransport_alpn_slice1_probe ok")
    return 0
