import std/crypto/ecnist as ecnist
import std/crypto/p256_fixed as pfix
import std/result
import std/system
import std/strutils as strutil
import std/times as times

fn main(): int32 =
    var a: pfix.P256Fixed = pfix.p256FieldModulus()
    var b: pfix.P256Fixed = pfix.p256FieldR2()
    # perturb so it's not degenerate
    a.limbs[0] = a.limbs[0] + 7
    b.limbs[0] = b.limbs[0] + 3
    let N: int32 = 100000

    # (1) Result-returning field mul (current hot-path form)
    var t0: int64 = times.MonotimeNs()
    var i1: int32
    var acc1: int32
    while i1 < N:
        let r: Result[pfix.P256Fixed] = ecnist.p256FieldFixedMul(a, b)
        if IsOk(r):
            acc1 = (acc1 + Value(r).limbs[0]) & 0xFF
        i1 = i1 + 1
    var t1: int64 = times.MonotimeNs()
    echo(strutil.Join(["p256FieldFixedMul (Result):  ", IntToStr(int32((t1 - t0) / int64(N))), " ns/op"], ""))

    # (2) Crash variant (no Result wrapping)
    t0 = times.MonotimeNs()
    var i2: int32
    var acc2: int32
    while i2 < N:
        let c: pfix.P256Fixed = ecnist.p256FieldFixedMulCrash(a, b)
        acc2 = (acc2 + c.limbs[0]) & 0xFF
        i2 = i2 + 1
    t1 = times.MonotimeNs()
    echo(strutil.Join(["p256FieldFixedMulCrash (raw): ", IntToStr(int32((t1 - t0) / int64(N))), " ns/op  acc=", IntToStr(acc1 + acc2 & 0xFF)], ""))
    return 0
