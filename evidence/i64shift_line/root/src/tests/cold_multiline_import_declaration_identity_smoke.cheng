import cheng/tests/cold_multiline_import_declaration_identity_support as multiline_support

fn main(): int32 =
    if multiline_support.ColdMultilineImportedLimit != 7:
        return 1
    var record: multiline_support.ColdMultilineImportedRecord
    record.ok = true
    record.value =
        multiline_support.ColdMultilineImportedLimit
    if !record.ok:
        return 2
    if record.value != 7:
        return 3
    return 0
