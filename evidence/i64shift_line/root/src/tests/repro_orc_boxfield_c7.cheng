import std/system
import std/hashmaps as hashmaps

type
    ReproBox7 = ref object
        m: hashmaps.HashMapStrInt

fn reproOverwrite7(b: var ReproBox7) =
    b.m = hashmaps.HashMapStrInt()

fn main() =
    var b: ReproBox7 = new(ReproBox7)
    hashmaps.HashMapStrIntInitInPlace(b.m, 64)
    reproOverwrite7(b)
    echo("repro_orc_boxfield_c7 ok")
