type Tbl =
    offset: int32

type Face =
    data: int32[]
    head: Tbl
    loaded: bool

@borrows
fn touch(f: var Face): bool =
    return f.loaded

@borrows
fn probe(f: var Face, data: int32[]): bool =
    f.data = data
    f.loaded = true
    return touch(f)

fn main(): int32 =
    var f: Face
    var d: int32[]
    d = [1, 2, 3]
    if probe(f, d):
        return 1
    return 0
