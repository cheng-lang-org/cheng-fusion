# Basketball pattern visual probe: renders one 1280x720 frame holding a
# single RasterBasketball ball straight in front of the camera (center
# (0,0,0.121), radius 0.121, camera 0.46 m away on -Y so pixelR ~250
# and the whole bounding box stays on screen), identity visual
# quaternion, the production FIBA palette. Times the RasterBasketball
# call in wall-clock milliseconds, writes /tmp/bb_pattern_probe.ppm and
# asserts the ball disc pixel count lands in the analytic band
# (pi * 250^2 ~= 196k). Pixel-class percentages (quadrant / base /
# grooves) are verified externally against the PPM with the same
# geometry the rasterizer implements.
#
# Two diagnostics ride along: (1) a bright-orange pixel gate (only the
# 224/116/50 base can push R >= 100; a healthy four-quadrant ball shows
# ~40% of the disc) so a pattern-eating regression cannot print PASS;
# (2) a close-range ball timing (depth 0.06 -> pixelR ~1916, bounding
# box ~3830 px wide) that quantifies the unclamped impostor bounding
# box long tail.
import cheng/game/cinema/camera
import cheng/game/render/cpu_raster as raster
import std/rawbytes
import std/monotimes
import std/strings as strings

const
    ProbeWidth = 1280
    ProbeHeight = 720
    ProbeFocalPx = 950.0
    ProbeCamDist = 0.46
    ProbeBallRadius = 0.121

@borrows
fn ProbeCountNonBackground(t: raster.RasterTarget): int32 =
    var n: int32 = 0
    var bi: int32 = 0
    let total: int32 = t.width * t.height
    while bi < total:
        # clear-color backdrop is BGRA (140,120,96)
        var isBg: bool = rawbytes.BytesGet(t.frame.bgra, bi * 4 + 2) == 96
        if isBg:
            isBg = rawbytes.BytesGet(t.frame.bgra, bi * 4 + 1) == 120
        if isBg:
            isBg = rawbytes.BytesGet(t.frame.bgra, bi * 4) == 140
        if !isBg:
            n = n + 1
        bi = bi + 1
    return n

@borrows
fn ProbeCountBrightOrange(t: raster.RasterTarget): int32 =
    # only the 224/116/50 leather base reaches R >= 100 (logo/quadrant/
    # groove tops out at 52; the 96/120/140 backdrop stays below too)
    var n: int32 = 0
    var bi: int32 = 0
    let total: int32 = t.width * t.height
    while bi < total:
        if rawbytes.BytesGet(t.frame.bgra, bi * 4 + 2) >= 100:
            n = n + 1
        bi = bi + 1
    return n

fn main(): int32 =
    # look-at from -Y straight at the ball center: forward = (0,1,0),
    # right = (1,0,0), up = (0,0,1); ball center projects to the exact
    # frame center at depth = ProbeCamDist
    var cam = camera.CinemaCameraLookAt(0.0, 0.0 - ProbeCamDist, ProbeBallRadius, 0.0, 0.0, ProbeBallRadius, ProbeFocalPx, ProbeWidth, ProbeHeight)
    var t: raster.RasterTarget
    t = raster.RasterMake(ProbeWidth, ProbeHeight)
    var t1 = monotimes.GetMonoTime()
    raster.RasterBasketball(t, cam, 0.0, 0.0, ProbeBallRadius, ProbeBallRadius, 1.0, 0.0, 0.0, 0.0, 224, 116, 50, 30, 26, 24)
    var t2 = monotimes.GetMonoTime()
    raster.RasterWritePpm(t, "/tmp/bb_pattern_probe.ppm")
    let nonBg: int32 = ProbeCountNonBackground(t)
    let orange: int32 = ProbeCountBrightOrange(t)
    let rasterNs: int64 = monotimes.MonoTimeNs(t2) - monotimes.MonoTimeNs(t1)
    let rasterMs: int32 = int32(rasterNs / 1000000)
    echo("ballPixels=" + strings.IntToStr(nonBg))
    echo("rasterMs=" + strings.IntToStr(rasterMs))
    echo("brightOrangePixels=" + strings.IntToStr(orange))
    # close-range diagnostic: depth 0.06 -> pixelR ~1916, the unclamped
    # bounding box walks ~14.7M pixels regardless of screen coverage
    var camClose = camera.CinemaCameraLookAt(0.0, 0.0 - 0.06, ProbeBallRadius, 0.0, 0.0, ProbeBallRadius, ProbeFocalPx, ProbeWidth, ProbeHeight)
    var tClose: raster.RasterTarget
    tClose = raster.RasterMake(ProbeWidth, ProbeHeight)
    var t3 = monotimes.GetMonoTime()
    raster.RasterBasketball(tClose, camClose, 0.0, 0.0, ProbeBallRadius, ProbeBallRadius, 1.0, 0.0, 0.0, 0.0, 224, 116, 50, 30, 26, 24)
    var t4 = monotimes.GetMonoTime()
    let closeNs: int64 = monotimes.MonoTimeNs(t4) - monotimes.MonoTimeNs(t3)
    echo("closeRasterMs=" + strings.IntToStr(int32(closeNs / 1000000)))
    # full-frame component evidence: the ground plane over this camera
    # (horizontal forward, so the lower ~half of the scanlines run the
    # per-pixel path)
    var tGround: raster.RasterTarget
    tGround = raster.RasterMake(ProbeWidth, ProbeHeight)
    var t5 = monotimes.GetMonoTime()
    raster.RasterGround(tGround, cam)
    var t6 = monotimes.GetMonoTime()
    let groundNs: int64 = monotimes.MonoTimeNs(t6) - monotimes.MonoTimeNs(t5)
    echo("groundRasterMs=" + strings.IntToStr(int32(groundNs / 1000000)))
    # analytic disc: pi * pixelR^2 with pixelR = r*focal/dist ~= 249.91
    if nonBg < 185000:
        echo("FAIL ball disc degenerate")
        return 1
    if nonBg > 205000:
        echo("FAIL ball disc oversized")
        return 1
    # healthy four-quadrant pattern: base leather owns ~40% of the disc
    # (~78k px); the logo-sign regression paints those pixels flat gray
    if orange < 50000:
        echo("FAIL quadrant pattern not visible: bright orange px=" + strings.IntToStr(orange) + " (expected ~78k, logo test paints the ball gray)")
        return 1
    if orange > 120000:
        echo("FAIL quadrant pattern washed out: bright orange px=" + strings.IntToStr(orange))
        return 1
    echo("PASS basketball pattern probe (pixels=" + strings.IntToStr(nonBg) + " ms=" + strings.IntToStr(rasterMs) + ")")
    return 0
