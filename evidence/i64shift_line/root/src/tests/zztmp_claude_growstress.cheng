import std/cmdline as cmdline
import std/system as system

type
    GrowStressItem =
        idx: int32
        pad0: int64
        pad1: int64
        pad2: int64
        pad3: int64
        pad4: int64
        pad5: int64
        pad6: int64
        pad7: int64

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    echo("start")
    # 72-byte elements, 20000 appends => ~1.4MB backing, crosses the mmap tier
    # and exercises the grow reclaim (cheng_free of the abandoned old backing)
    # across every doubling step.
    var items: GrowStressItem[]
    var i = 0
    while i < 20000:
        var it: GrowStressItem
        it.idx = int32(i)
        it.pad0 = int64(i) * 3
        add(items, it)
        i = i + 1
    if items.len != 20000:
        echo("len_bad")
        return 1
    var ok = true
    i = 0
    while i < 20000:
        if items[i].idx != int32(i) || items[i].pad0 != int64(i) * 3:
            ok = false
            break
        i = i + 1
    if !ok:
        echo("content_bad")
        return 1
    let buffer = system.chengSeqHdrBufferGet(&items)
    let rc = system.memRefCount(buffer)
    if rc != 1:
        echo("rc_bad")
        return 1
    # str seq grow stress across many doublings
    var names: str[]
    i = 0
    while i < 5000:
        add(names, "stress")
        i = i + 1
    if names.len != 5000:
        echo("str_len_bad")
        return 1
    echo("grow_stress_ok")
    return 0
