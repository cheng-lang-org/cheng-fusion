import std/os as os
import std/strings
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/relfacts

type
    ProbeBinding =
        standard: str
        profiles: str[]
        schemaNamespace: str
        schemaCid: str

@borrows
fn mkBinding(profiles: str[]): ProbeBinding =
    var out: ProbeBinding
    out.standard = "csg_core::v1"
    out.profiles = profiles
    out.schemaNamespace = "csg_core::v1"
    out.schemaCid =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    return out

fn main(): int32 =
    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleOld =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let moduleNew =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:bbb\"}"
    let symbol =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let beforeFacts = [strings.CloneStr(schema), strings.CloneStr(moduleOld), strings.CloneStr(symbol)]
    let afterFacts = [strings.CloneStr(schema), strings.CloneStr(moduleNew), strings.CloneStr(symbol)]
    let binding = mkBinding(["csg_core"])
    let transition = relfacts.CsgCoreRelfactsEncodeCanonicalTransition(
        beforeFacts,
        afterFacts,
        "csg_core::v1",
        ["csg_core"],
        "csg_core::v1",
        "sha256:1111111111111111111111111111111111111111111111111111111111111111",
        "csg_core::v1",
        ["csg_core"],
        "csg_core::v1",
        "sha256:1111111111111111111111111111111111111111111111111111111111111111")
    if !transition.ok:
        os.WriteLine(os.Get_stderr(), transition.error)
        return 1
    os.WriteLine(os.Get_stderr(), "p_encoded")
    let text = strings.CloneStr(transition.text)
    let replay = relfacts.CsgCoreRelfactsReplayCanonicalTransition(
        text,
        beforeFacts,
        afterFacts,
        binding.standard,
        binding.profiles,
        binding.schemaNamespace,
        binding.schemaCid,
        binding.standard,
        binding.profiles,
        binding.schemaNamespace,
        binding.schemaCid)
    os.WriteLine(os.Get_stderr(), "p_replayed")
    if !replay.ok:
        os.WriteLine(os.Get_stderr(), replay.error)
        return 1
    os.WriteLine(os.Get_stdout(), "replay ok")
    return 0
