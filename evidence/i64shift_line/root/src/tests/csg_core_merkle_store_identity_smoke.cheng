import std/rawbytes
import std/cmdline
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_store_identity

fn StoreIdentityRequiredFlag(name: str): str =
    var value: str
    assert(cmdline.readFlagValue(name, value) && value.len > 0,
           "merkle store identity smoke: required flag missing")
    return value

fn StoreIdentityAcquireFixture(initialize: bool) =
    let parent = StoreIdentityRequiredFlag("--parent")
    let storeName = StoreIdentityRequiredFlag("--store")
    var intent =
        merkle_store_identity.CsgCoreMerkleStoreExistingOnly
    if initialize:
        intent =
            merkle_store_identity.CsgCoreMerkleStoreInitializeIfAbsent
    var opened =
        merkle_store_identity.CsgCoreMerkleStoreAcquirePathAuthority(
            parent, storeName, intent)
    assert(opened.ok, opened.error)
    assert(opened.reused != initialize,
           "merkle store identity smoke: reuse classification mismatch")
    assert(
        merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            opened.identityReceipt),
        "merkle store identity smoke: live receipt rejected")
    var tamperedReceipt: merkle_store_identity.CsgCoreMerkleStoreIdentityReceipt
    tamperedReceipt.ok = true
    tamperedReceipt.ownerId = opened.identityReceipt.ownerId
    tamperedReceipt.generation = opened.identityReceipt.generation
    tamperedReceipt.receiptNonce =
        opened.identityReceipt.receiptNonce
    assert(
        !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            tamperedReceipt),
        "merkle store identity smoke: incomplete receipt payload accepted")
    var tamperedPayload =
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityIdentityReceipt(
            opened.authority)
    assert(tamperedPayload.ok,
           "merkle store identity smoke: tamper receipt issue failed")
    tamperedPayload.beforeStoreIdentity =
        "sha256:0db991a37321e5116797bd21d108ea92669228ba168fcee11486e865f13d4522"
    assert(
        !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            tamperedPayload),
        "merkle store identity smoke: before identity tamper accepted")
    tamperedPayload =
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityIdentityReceipt(
            opened.authority)
    assert(tamperedPayload.ok,
           "merkle store identity smoke: tamper receipt issue failed")
    tamperedPayload.recordCid =
        "sha256:0db991a37321e5116797bd21d108ea92669228ba168fcee11486e865f13d4522"
    assert(
        !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            tamperedPayload),
        "merkle store identity smoke: record CID tamper accepted")
    tamperedPayload =
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityIdentityReceipt(
            opened.authority)
    assert(tamperedPayload.ok,
           "merkle store identity smoke: tamper receipt issue failed")
    tamperedPayload.storeInstanceSeed = layout.FixedBytes32()
    assert(
        !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            tamperedPayload),
        "merkle store identity smoke: seed tamper accepted")
    tamperedPayload =
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityIdentityReceipt(
            opened.authority)
    assert(tamperedPayload.ok,
           "merkle store identity smoke: tamper receipt issue failed")
    tamperedPayload.orderedCanonicalCategoryNames = []
    assert(
        !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            tamperedPayload),
        "merkle store identity smoke: category tamper accepted")
    var forged: merkle_store_identity.CsgCoreMerkleStorePathAuthority
    forged.ownerId = opened.identityReceipt.ownerId
    forged.generation = opened.identityReceipt.generation
    forged.leaseNonce = opened.identityReceipt.receiptNonce
    assert(
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityClose(
            forged).len > 0,
        "merkle store identity smoke: receipt forged path authority")
    assert(
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityIsValid(
            opened.authority),
        "merkle store identity smoke: forged close invalidated live authority")
    if initialize:
        let copiedOpen = opened.authority
        var openAuthority = opened.authority
        var planning =
            merkle_store_identity.CsgCoreMerkleStorePathAuthorityMoveToPlanning(
                openAuthority)
        assert(planning.ok,
               "merkle store identity smoke: planning move failed")
        let copiedPlanning = planning.authority
        var planningAuthority = planning.authority
        var prepared =
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityMoveToPrepared(
                planningAuthority)
        assert(prepared.ok,
               "merkle store identity smoke: prepared move failed")
        assert(
            !merkle_store_identity.CsgCoreMerkleStorePathAuthorityIsValid(
                copiedOpen),
            "merkle store identity smoke: copied open authority survived")
        var copiedOpenForClose = copiedOpen
        assert(
            merkle_store_identity.CsgCoreMerkleStorePathAuthorityClose(
                copiedOpenForClose).len > 0,
            "merkle store identity smoke: copied open authority closed lease")
        assert(
            !merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityIsValid(
                copiedPlanning),
            "merkle store identity smoke: copied planning authority survived")
        assert(
            merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityIsValid(
                prepared.authority),
            "merkle store identity smoke: prepared authority invalid")
        assert(
            merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
                prepared.identityReceipt),
            "merkle store identity smoke: prepared receipt invalid")
        let preparedLineage =
            merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityLineageBinding(
                prepared.authority)
        assert(
            !layout.FixedBytes32Equal(
                preparedLineage, layout.FixedBytes32()),
            "merkle store identity smoke: prepared lineage missing")
        assert(
            !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
                opened.identityReceipt),
            "merkle store identity smoke: open receipt survived prepare")
        let copiedPrepared = prepared.authority
        var preparedAuthority = prepared.authority
        var session =
            merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityMoveToSession(
                preparedAuthority)
        assert(session.ok,
               "merkle store identity smoke: session move failed")
        assert(
            !merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityIsValid(
                copiedPrepared),
            "merkle store identity smoke: copied prepared authority survived")
        var copiedPreparedForClose = copiedPrepared
        assert(
            merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityClose(
                copiedPreparedForClose).len > 0,
            "merkle store identity smoke: copied prepared authority closed lease")
        assert(
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
                session.authority),
            "merkle store identity smoke: session authority invalid")
        assert(
            merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
                session.identityReceipt),
            "merkle store identity smoke: session receipt invalid")
        assert(
            !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
                prepared.identityReceipt),
            "merkle store identity smoke: prepared receipt survived session")
        let sessionLineage =
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
                session.authority)
        assert(
            layout.FixedBytes32Equal(
                preparedLineage, sessionLineage),
            "merkle store identity smoke: lineage changed across session")
        assert(
            layout.FixedBytes32Equal(
                merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityLineageBinding(
                    copiedPrepared),
                layout.FixedBytes32()),
            "merkle store identity smoke: stale prepared lineage survived")
        let terminal =
            merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityCloseByBinding(
                sessionLineage)
        assert(
            terminal.ok && terminal.won && terminal.terminal,
            "merkle store identity smoke: lineage close failed")
        let repeatedTerminal =
            merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityCloseByBinding(
                sessionLineage)
        assert(
            repeatedTerminal.ok && !repeatedTerminal.won &&
            repeatedTerminal.terminal,
            "merkle store identity smoke: repeated lineage close won")
        var staleSessionAuthority = session.authority
        assert(
            merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityClose(
                staleSessionAuthority).len > 0,
            "merkle store identity smoke: stale session closed twice")
        assert(
            !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
                session.identityReceipt),
            "merkle store identity smoke: session receipt survived close")
        echo("CSG_CORE_MERKLE_STORE_IDENTITY_INITIALIZE_OK")
        return
    var authority = opened.authority
    assert(
        merkle_store_identity.CsgCoreMerkleStorePathAuthorityClose(
            authority).len == 0,
        "merkle store identity smoke: authority close failed")
    assert(
        !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
            opened.identityReceipt),
        "merkle store identity smoke: closed receipt remained live")
    echo("CSG_CORE_MERKLE_STORE_IDENTITY_REUSE_OK")

fn StoreIdentityPoisonReuseFixture() =
    let parent = StoreIdentityRequiredFlag("--parent")
    let storeName = StoreIdentityRequiredFlag("--store")
    var firstSession: merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthority
    for i in 0..<129:
        var opened =
            merkle_store_identity.CsgCoreMerkleStoreAcquirePathAuthority(
                parent,
                storeName,
                merkle_store_identity.CsgCoreMerkleStoreExistingOnly)
        assert(opened.ok,
               "merkle store identity smoke: poison-loop open failed")
        var openAuthority = opened.authority
        var planning =
            merkle_store_identity.CsgCoreMerkleStorePathAuthorityMoveToPlanning(
                openAuthority)
        assert(planning.ok,
               "merkle store identity smoke: poison-loop planning failed")
        var planningAuthority = planning.authority
        var prepared =
            merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityMoveToPrepared(
                planningAuthority)
        assert(prepared.ok,
               "merkle store identity smoke: poison-loop prepare failed")
        var preparedAuthority = prepared.authority
        var session =
            merkle_store_identity.CsgCoreMerkleStorePreparedPathAuthorityMoveToSession(
                preparedAuthority)
        assert(session.ok,
               "merkle store identity smoke: poison-loop session failed")
        if i == 0:
            firstSession = session.authority
        if i == 0:
            let lineage =
                merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityLineageBinding(
                    session.authority)
            let poisoned =
                merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityPoisonByBinding(
                    lineage)
            assert(poisoned.ok && poisoned.won && poisoned.terminal,
                   "merkle store identity smoke: lineage poison failed")
            let repeatedPoison =
                merkle_store_identity.CsgCoreMerkleStoreTransactionPathAuthorityPoisonByBinding(
                    lineage)
            assert(repeatedPoison.ok && !repeatedPoison.won &&
                   repeatedPoison.terminal,
                   "merkle store identity smoke: repeated lineage poison won")
        else:
            var sessionAuthority = session.authority
            assert(
                merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityPoison(
                    sessionAuthority).len == 0,
                "merkle store identity smoke: poison-loop terminal failed")
        assert(
            !merkle_store_identity.CsgCoreMerkleStoreIdentityReceiptIsValid(
                session.identityReceipt),
            "merkle store identity smoke: poison-loop receipt survived")
    assert(
        !merkle_store_identity.CsgCoreMerkleStoreSessionPathAuthorityIsValid(
            firstSession),
        "merkle store identity smoke: first poisoned token revived")
    echo("CSG_CORE_MERKLE_STORE_IDENTITY_POISON_REUSE_OK")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var mode: str
    if cmdline.readFlagValue("--mode", mode):
        if mode == "initialize":
            StoreIdentityAcquireFixture(true)
            return 0
        if mode == "reuse":
            StoreIdentityAcquireFixture(false)
            return 0
        if mode == "poison-reuse":
            StoreIdentityPoisonReuseFixture()
            return 0
        assert(false, "merkle store identity smoke: unknown mode")
    let line =
        "{\"beforeStoreIdentity\":\"sha256:5db991a37321e5116797bd21d108ea92669228ba168fcee11486e865f13d4522\",\"formatId\":\"csg_core.merkle_store.v1\",\"kind\":\"csg.merkle.store_identity\",\"markerSchema\":\"csg_core.store.marker.v1\",\"storeInstanceSeed\":\"000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f\",\"storeLayoutCid\":\"sha256:ffcf823e1924c359a236a7a8b6d0851fc540b866b240cad6362de0a945f12bc3\"}"
    var encoded = csgc.CsgCoreCsgcEncodeCanonicalLines([line])
    assert(encoded.ok,
           "merkle store identity smoke: fixed record encode failed")
    var decoded =
        merkle_store_identity.CsgCoreMerkleStoreIdentityRecordDecode(
            encoded.bytes)
    assert(decoded.ok,
           "merkle store identity smoke: fixed record rejected")
    assert(decoded.record.storeLayoutCid ==
               "sha256:ffcf823e1924c359a236a7a8b6d0851fc540b866b240cad6362de0a945f12bc3",
           "merkle store identity smoke: layout vector mismatch")
    assert(decoded.record.beforeStoreIdentity ==
               "sha256:5db991a37321e5116797bd21d108ea92669228ba168fcee11486e865f13d4522",
           "merkle store identity smoke: identity vector mismatch")
    var reencoded =
        merkle_store_identity.CsgCoreMerkleStoreIdentityRecordEncode(
            decoded.record)
    assert(reencoded.ok &&
           rawbytes.BytesEqual(encoded.bytes, reencoded.bytes),
           "merkle store identity smoke: passive record replay mismatch")
    rawbytes.BytesFree(reencoded.bytes)
    rawbytes.BytesFree(decoded.bytes)
    rawbytes.BytesFree(encoded.bytes)

    var invalidAuthority: merkle_store_identity.CsgCoreMerkleStorePathAuthority
    assert(
        !merkle_store_identity.CsgCoreMerkleStorePathAuthorityIsValid(
            invalidAuthority),
        "merkle store identity smoke: zero authority accepted")
    var invalidPlanningAuthority: merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthority
    let invalidSnapshot =
        merkle_store_identity.CsgCoreMerkleStorePlanningPathAuthorityIssueBeforeSnapshot(
            invalidPlanningAuthority)
    assert(!invalidSnapshot.ok,
           "merkle store identity smoke: zero snapshot source accepted")
    var invalidSnapshotAuthority: merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority
    let invalidClaim =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotClaim(
            invalidSnapshotAuthority)
    assert(!invalidClaim.ok,
           "merkle store identity smoke: zero snapshot claim accepted")
    let invalidLockedSummary =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotLockedSummary(
            invalidSnapshotAuthority)
    assert(!invalidLockedSummary.ok,
           "merkle store identity smoke: zero locked summary accepted")
    var invalidMappedSnapshot: merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority
    let invalidMappedIssue =
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotIssueMappedCsgc(
            invalidMappedSnapshot)
    assert(!invalidMappedIssue.ok,
           "merkle store identity smoke: zero mapped source accepted")
    var invalidMapped: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority
    let invalidFact =
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcReadFact(
            invalidMapped, 0)
    assert(!invalidFact.ok,
           "merkle store identity smoke: zero mapped read accepted")
    var invalidMappedFinish: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority
    assert(
        !merkle_store_identity.CsgCoreMerkleStoreMappedCsgcFinish(
            invalidMappedFinish).ok,
        "merkle store identity smoke: zero mapped finish accepted")
    var invalidMappedPoison: merkle_store_identity.CsgCoreMerkleStoreMappedCsgcAuthority
    assert(
        merkle_store_identity.CsgCoreMerkleStoreMappedCsgcPoison(
            invalidMappedPoison).len > 0,
        "merkle store identity smoke: zero mapped poison accepted")
    var invalidCompletion: merkle_store_identity.
            CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    let invalidCompletionSummary =
        merkle_store_identity.
            CsgCoreMerkleStoreMappedCsgcLockedCompletion(
                invalidCompletion)
    assert(!invalidCompletionSummary.ok,
           "merkle store identity smoke: zero completion read accepted")
    var invalidCompletionConsume: merkle_store_identity.
            CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    assert(
        merkle_store_identity.
            CsgCoreMerkleStoreMappedCsgcConsumeCompletion(
                invalidCompletionConsume).len > 0,
        "merkle store identity smoke: zero completion consume accepted")
    var invalidCompletionPoison: merkle_store_identity.
            CsgCoreMerkleStoreMappedCsgcCompletionAuthority
    assert(
        merkle_store_identity.
            CsgCoreMerkleStoreMappedCsgcPoisonCompletion(
                invalidCompletionPoison).len > 0,
        "merkle store identity smoke: zero completion poison accepted")
    var invalidPoisonAuthority: merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotAuthority
    assert(
        merkle_store_identity.CsgCoreMerkleStoreBeforeSnapshotPoison(
            invalidPoisonAuthority).len > 0,
        "merkle store identity smoke: zero snapshot poison accepted")
    echo("CSG_CORE_MERKLE_STORE_IDENTITY_INVALID_OK")
    return 0
