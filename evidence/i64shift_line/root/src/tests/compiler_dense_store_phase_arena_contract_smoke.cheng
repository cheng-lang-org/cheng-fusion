import std/strings
import cheng/core/ir/compiler_dense_store as dense
import cheng/core/ir/core_types as ir
import cheng/core/ir/phase_arena as phase

fn check(cond: bool, code: int32): int32 =
    if cond:
        return 0
    return code

@borrows
fn checkContains(text: str,
                 needle: str,
                 code: int32): int32 =
    if strings.StrContains(text, needle):
        return 0
    return code

fn appendI32Local(bodyIR: var ir.BodyIR,
                  name: str): int32 =
    var slot: ir.LocalSlot
    slot.id = bodyIR.localSlots.len
    slot.name = name
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + slot.id * 8
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(bodyIR.localSlots, slot)
    return slot.id

fn buildDenseStore(): dense.CompilerDenseStore =
    var names: str[]
    var paramCounts: int32[]
    var resultTags: int32[]
    var sourcePaths: str[]
    var bodyKinds: int32[]
    var entryFlags: int32[]
    var typedIndices: int32[]
    var paramTypeTags: int32[]
    var paramTypeStarts: int32[]

    add(names, "alpha")
    add(paramCounts, 1)
    add(resultTags, dense.DenseStoreResultTypeTagI32())
    add(sourcePaths, "src/a.cheng")
    add(bodyKinds, dense.DenseStoreBodyKindTypedTag())
    add(entryFlags, dense.DenseEntryIsEntryFlag)
    add(typedIndices, 7)
    add(paramTypeStarts, 0)
    add(paramTypeTags, dense.DenseParamI32Tag)

    add(names, "alpha")
    add(paramCounts, 0)
    add(resultTags, dense.DenseStoreResultTypeTagVoid())
    add(sourcePaths, "src/b.cheng")
    add(bodyKinds, dense.DenseStoreBodyKindBodyIrTag())
    add(entryFlags, 0)
    add(typedIndices, 11)
    add(paramTypeStarts, 1)

    add(names, "module::beta")
    add(paramCounts, 0)
    add(resultTags, dense.DenseStoreResultTypeTagI32())
    add(sourcePaths, "src/a.cheng")
    add(bodyKinds, dense.DenseStoreBodyKindCfgTag())
    add(entryFlags, 0)
    add(typedIndices, 13)
    add(paramTypeStarts, 1)

    add(paramTypeStarts, 1)

    var store = dense.DenseStoreNew()
    dense.DenseStoreBuildFromFunctionArrays(store,
                                            names,
                                            paramCounts,
                                            resultTags,
                                            sourcePaths,
                                            bodyKinds,
                                            entryFlags,
                                            typedIndices,
                                            paramTypeTags,
                                            paramTypeStarts)
    return store

fn buildBodyIR(): ir.BodyIR =
    var bodyIR = ir.BodyIRNew()
    let lhs = appendI32Local(bodyIR, "lhs")
    let rhs = appendI32Local(bodyIR, "rhs")
    let out = appendI32Local(bodyIR, "out")

    var op: ir.BodyOp
    op.kind = ir.BodyOpBinOpTag
    op.target = out
    add(op.operands, 1)
    add(op.operands, 0)
    add(op.operands, lhs)
    add(op.operands, rhs)
    add(bodyIR.ops, op)

    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = out
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(bodyIR, term)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, bodyIR.ops.len, termIndex)
    return bodyIR

fn checkDenseStoreMainShape(): int32 =
    let sourceA = "src/tests/compiler_dense_store_phase_arena_contract_smoke.cheng"
    let sourceB = "src/tests/compiler_dense_store_phase_arena_contract_other.cheng"

    var names: str[]
    add(names, "main")
    add(names, "main")
    add(names, "extern")

    var tailNames: str[]
    add(tailNames, "main")
    add(tailNames, "main")
    add(tailNames, "extern")

    var paramCounts: int32[]
    add(paramCounts, 1)
    add(paramCounts, 0)
    add(paramCounts, 0)

    var resultTags: int32[]
    add(resultTags, dense.DenseStoreResultTypeTagI32())
    add(resultTags, dense.DenseStoreResultTypeTagVoid())
    add(resultTags, dense.DenseStoreResultTypeTagVoid())

    var sourcePaths: str[]
    add(sourcePaths, share(sourceA))
    add(sourcePaths, share(sourceB))
    add(sourcePaths, share(sourceA))

    var bodyKinds: int32[]
    add(bodyKinds, dense.DenseStoreBodyKindBodyIrTag())
    add(bodyKinds, dense.DenseStoreBodyKindCfgTag())
    add(bodyKinds, dense.DenseStoreBodyKindNoneTag())

    var entryFlags: int32[]
    add(entryFlags, 1)
    add(entryFlags, 0)
    add(entryFlags, 0)

    var typedIndices: int32[]
    add(typedIndices, 0)
    add(typedIndices, 4)
    add(typedIndices, -1)

    var paramTypeTags: int32[]
    add(paramTypeTags, dense.DenseStoreParamTypeTagFromTypeText("int32"))

    var paramTypeStarts: int32[]
    add(paramTypeStarts, 0)
    add(paramTypeStarts, 1)
    add(paramTypeStarts, 1)
    add(paramTypeStarts, 1)

    var store = dense.DenseStoreNew()
    dense.DenseStoreBuild(store,
                          names,
                          tailNames,
                          paramCounts,
                          resultTags,
                          sourcePaths,
                          bodyKinds,
                          entryFlags,
                          typedIndices,
                          paramTypeTags,
                          paramTypeStarts)

    let c1 = check(dense.DenseStoreFunctionCount(store) == 3, 11)
    if c1 != 0: return c1
    let c2 = check(dense.DenseStoreFindFunctionInSource(store, sourceA, "main") == 0, 12)
    if c2 != 0: return c2
    let c3 = check(dense.DenseStoreFindFunctionInSource(store, sourceB, "main") == 1, 13)
    if c3 != 0: return c3
    let c3b = check(dense.DenseStoreFindFunctionInSource(store, sourceA, "worker") == -1, 35)
    if c3b != 0: return c3b
    let c3c = check(dense.DenseStoreFindFunction(store, "main") == -1, 36)
    if c3c != 0: return c3c
    let c4 = check(dense.DenseStoreGetParamTypeTag(store, 0, 0) == dense.DenseStoreParamTypeTagFromTypeText("int32"), 14)
    if c4 != 0: return c4

    let denseReport = dense.DenseStoreContractReport(store)
    let c5 = check(denseReport.functionCount == 3, 15)
    if c5 != 0: return c5
    let c6 = check(denseReport.symbolCount == 3, 16)
    if c6 != 0: return c6
    let c7 = check(denseReport.bodyCount == 2, 17)
    if c7 != 0: return c7
    let c8 = check(denseReport.cfgCount == 2, 18)
    if c8 != 0: return c8
    let c9 = check(denseReport.typedCount == 2, 19)
    if c9 != 0: return c9
    let c10 = check(denseReport.bodyIrCount == 1, 20)
    if c10 != 0: return c10
    let c11 = check(denseReport.pointerKeyCount == 0, 21)
    if c11 != 0: return c11
    let c12 = check(denseReport.suffixGuessCount == 0, 22)
    if c12 != 0: return c12
    let c12b = check(denseReport.tailAliasCount == 0, 31)
    if c12b != 0: return c12b
    let c12c = check(denseReport.hashEntryCount == 3, 32)
    if c12c != 0: return c12c
    let c12d = check(denseReport.sourceScopedKeyCount == 3, 37)
    if c12d != 0: return c12d
    let c12e = check(denseReport.sourceScopedSourceCount == 2, 38)
    if c12e != 0: return c12e
    let c12f = check(denseReport.sourceScopedNameCollisionCount == 1, 39)
    if c12f != 0: return c12f
    let c12g = check(denseReport.sourceScopedQueryCount == 3, 40)
    if c12g != 0: return c12g
    let c12h = check(denseReport.sourceScopedQueryHitCount == 2, 59)
    if c12h != 0: return c12h
    let c12i = check(denseReport.sourceScopedQueryMissCount == 1, 60)
    if c12i != 0: return c12i

    let denseText = dense.DenseStoreReport(store)
    let c13 = checkContains(denseText, "dense_store_function_count=3", 23)
    if c13 != 0: return c13
    let c14 = checkContains(denseText, "dense_store_symbol_count=3", 24)
    if c14 != 0: return c14
    let c15 = checkContains(denseText, "dense_store_body_count=2", 25)
    if c15 != 0: return c15
    let c16 = checkContains(denseText, "dense_store_cfg_count=2", 26)
    if c16 != 0: return c16
    let c17 = checkContains(denseText, "dense_store_typed_count=2", 27)
    if c17 != 0: return c17
    let c18 = checkContains(denseText, "dense_store_bodyir_count=1", 28)
    if c18 != 0: return c18
    let c19 = checkContains(denseText, "dense_store_pointer_key_count=0", 29)
    if c19 != 0: return c19
    let c20 = checkContains(denseText, "dense_store_suffix_guess_count=0", 30)
    if c20 != 0: return c20
    let c20b = checkContains(denseText, "dense_store_tail_alias_count=0", 33)
    if c20b != 0: return c20b
    let c20c = checkContains(denseText, "dense_store_hash_entry_count=3", 34)
    if c20c != 0: return c20c
    let c20d = checkContains(denseText, "dense_store_source_scoped_key_count=3", 61)
    if c20d != 0: return c20d
    let c20e = checkContains(denseText, "dense_store_source_scoped_source_count=2", 62)
    if c20e != 0: return c20e
    let c20f = checkContains(denseText, "dense_store_source_scoped_name_collision_count=1", 63)
    if c20f != 0: return c20f
    let c20g = checkContains(denseText, "dense_store_source_scoped_query_count=3", 64)
    if c20g != 0: return c20g
    let c20h = checkContains(denseText, "dense_store_source_scoped_query_hit_count=2", 65)
    if c20h != 0: return c20h
    let c20i = checkContains(denseText, "dense_store_source_scoped_query_miss_count=1", 66)
    if c20i != 0: return c20i
    return 0

fn checkDenseStoreQualifiedShape(): int32 =
    var store = buildDenseStore()
    let c1 = check(dense.DenseStoreIsFrozen(store), 81)
    if c1 != 0: return c1
    let c2 = check(dense.DenseStoreFindFunctionInSource(store, "src/a.cheng", "alpha") == 0, 82)
    if c2 != 0: return c2
    let c3 = check(dense.DenseStoreFindFunctionInSource(store, "src/b.cheng", "alpha") == 1, 83)
    if c3 != 0: return c3
    let c4 = check(dense.DenseStoreFindFunctionInSource(store, "src/a.cheng", "beta") < 0, 84)
    if c4 != 0: return c4
    let c5 = check(dense.DenseStoreFindFunctionInSource(store, "src/a.cheng", "module::beta") == 2, 85)
    if c5 != 0: return c5
    let report = dense.DenseStoreContractReport(store)
    let c6 = check(report.pointerKeyCount == 0 && report.suffixGuessCount == 0, 86)
    if c6 != 0: return c6
    let c7 = check(report.sourceScopedQueryCount == 4 &&
                   report.sourceScopedQueryHitCount == 3 &&
                   report.sourceScopedQueryMissCount == 1, 87)
    if c7 != 0: return c7
    return 0

fn checkPhaseArena(): int32 =
    var arena = phase.PhaseArenaInit(int64(64))
    let firstBlock = phase.PhaseArenaAllocAligned(arena, int64(5), int64(8))
    let c21 = check(phase.PhaseArenaBlockIsValid(firstBlock), 41)
    if c21 != 0: return c21
    let c21b = check(firstBlock.offsetBytes == int64(0), 56)
    if c21b != 0: return c21b
    let secondBlock = phase.PhaseArenaReserve(arena, int64(3), int64(4))
    let c22 = check(phase.PhaseArenaBlockIsValid(secondBlock), 42)
    if c22 != 0: return c22
    let c22b = check(secondBlock.offsetBytes == int64(8), 57)
    if c22b != 0: return c22b
    let c22c = check(secondBlock.sizeBytes == int64(12), 58)
    if c22c != 0: return c22c

    let arenaReportA = phase.PhaseArenaReport(arena)
    let c23 = check(arenaReportA.peakBytes == int64(20), 43)
    if c23 != 0: return c23
    let c24 = check(arenaReportA.usedBytes == int64(20), 44)
    if c24 != 0: return c24
    let c25 = check(arenaReportA.resetCount == 0, 45)
    if c25 != 0: return c25
    let c26 = check(arenaReportA.spillCount == 0, 46)
    if c26 != 0: return c26
    phase.PhaseArenaHardFailOnSpill(arena, "compiler_dense_store_phase_arena_contract_smoke")

    phase.PhaseArenaReset(arena)
    let arenaReportB = phase.PhaseArenaReport(arena)
    let c27 = check(arenaReportB.peakBytes == int64(20), 47)
    if c27 != 0: return c27
    let c28 = check(arenaReportB.usedBytes == int64(0), 48)
    if c28 != 0: return c28
    let c29 = check(arenaReportB.resetCount == 1, 49)
    if c29 != 0: return c29
    let c30 = check(arenaReportB.spillCount == 0, 50)
    if c30 != 0: return c30

    let arenaText = phase.PhaseArenaReportText(arenaReportB)
    let c31 = checkContains(arenaText, "phase_arena_peak_bytes=20", 51)
    if c31 != 0: return c31
    let c32 = checkContains(arenaText, "phase_arena_reset_count=1", 52)
    if c32 != 0: return c32
    let c33 = checkContains(arenaText, "phase_arena_spill_count=0", 53)
    if c33 != 0: return c33

    let spillBlock = phase.PhaseArenaAllocAligned(arena, int64(80), int64(8))
    let c34 = check(!phase.PhaseArenaBlockIsValid(spillBlock), 54)
    if c34 != 0: return c34
    let arenaReportC = phase.PhaseArenaReport(arena)
    let c35 = check(arenaReportC.spillCount == 1, 55)
    if c35 != 0: return c35

    phase.PhaseArenaDestroy(arena)
    return 0

fn checkBodyIRFlatSoA(): int32 =
    let body = buildBodyIR()
    var bodyArena = ir.BodyIRPhaseArenaNew()
    let flat = ir.BodyIRPhaseArenaBuildFlatSoA(bodyArena, body)
    let c36 = check(ir.BodyIRFlatSoAIsAligned(flat), 67)
    if c36 != 0: return c36
    let c37 = check(bodyArena.reserveCount > 0, 68)
    if c37 != 0: return c37
    let c38 = check(bodyArena.usedBytes > int64(0), 69)
    if c38 != 0: return c38
    let c39 = check(bodyArena.peakBytes == bodyArena.usedBytes, 70)
    if c39 != 0: return c39
    let c40 = check(bodyArena.capacityBytes == bodyArena.usedBytes, 71)
    if c40 != 0: return c40
    let c41 = check(bodyArena.spillCount == 0, 72)
    if c41 != 0: return c41
    let c41b = check(bodyArena.resetCount == 1, 88)
    if c41b != 0: return c41b

    let bodyReport = ir.BodyIRDodSoAContractCheck(body)
    let c42 = check(bodyReport.ok, 73)
    if c42 != 0: return c42
    let c43 = check(bodyReport.phaseArenaReserveCount == bodyArena.reserveCount, 74)
    if c43 != 0: return c43
    let c44 = check(bodyReport.phaseArenaUsedBytes == bodyArena.usedBytes, 75)
    if c44 != 0: return c44
    let bodyText = ir.BodyIRDodSoAContractReportText(bodyReport)
    let c45 = checkContains(bodyText, "body_ir_phase_arena_used_bytes=", 76)
    if c45 != 0: return c45
    let c46 = checkContains(bodyText, "body_ir_phase_arena_spill_count=0", 77)
    if c46 != 0: return c46
    return 0

fn main(): int32 =
    let c1 = checkDenseStoreMainShape()
    if c1 != 0: return c1
    let c2 = checkDenseStoreQualifiedShape()
    if c2 != 0: return c2
    let c3 = checkPhaseArena()
    if c3 != 0: return c3
    let c4 = checkBodyIRFlatSoA()
    if c4 != 0: return c4
    echo(" compiler_dense_store_phase_arena_contract_smoke ok")
    return 0
