# Offline unit fixture for the Android touch hit-test y-axis root-fix
# (docs: 触摸 hit-test y 轴系统性错位, 2026-07-14).
#
# Reproduces, bit-for-bit, the per-axis integer conversion that
# cheng_android_drain_input_ring() in src/core/tooling/mobile_shell_codegen.cheng
# applies to each drained touch sample:
#
#   app_x_milli = (x_milli * present_width)  / source_width
#   app_y_milli = (y_milli * present_height) / source_height
#
# where source_width/source_height are the SurfaceHolder's authoritative
# physical frame (holder.surfaceFrame.width()/height(), post-fix — no longer
# the displayMetrics-clamped value) and present_width/present_height are the
# app's actual rendered logical canvas (what the GLES viewport/ortho matrix
# stretches to fill the physical frame with).
#
# Device fixture from the real hit-test regression: physical 1212x2616,
# logical/rendered canvas 388x804 (logcat: cache_compositor size=388x804).
# A visual tap at physical y=2528 (the node tab) must land inside the
# node route's logical hit box (~777 +/- a few px of layout rounding),
# not at the pre-fix ~809 (which used the x-axis ratio for y and missed
# because 809 > 804, out of the canvas).

fn scaleMilli(valueMilli: int64, presentDim: int64, sourceDim: int64): int64 =
    return (valueMilli * presentDim) / sourceDim

fn main(): int32 =
    let sourceWidth: int64 = 1212
    let sourceHeight: int64 = 2616
    let presentWidth: int64 = 388
    let presentHeight: int64 = 804

    # Visual (physical) tap position of the node tab, in px (host receives it
    # pre-multiplied by 1000 as "milli"; the *1000/ /1000 cancels in the ratio,
    # so this fixture works directly in px units for readability).
    let visualY: int64 = 2528
    let visualX: int64 = 606

    let logicalY: int64 = scaleMilli(visualY, presentHeight, sourceHeight)
    let logicalX: int64 = scaleMilli(visualX, presentWidth, sourceWidth)

    echo("logicalY=" + IntToStr(int32(logicalY)))
    echo("logicalX=" + IntToStr(int32(logicalX)))

    # Correct (post-fix) y mapping: visual 2528 -> logical 776 exactly
    # (2528*804/2616 truncates to 776), inside the 804-tall canvas and
    # inside the node route's hit box.
    assert(logicalY == 776,
           "touch y-axis scale: physical 2528 must map to logical 776 (node tab), got " + IntToStr(int32(logicalY)))
    assert(logicalY < presentHeight,
           "touch y-axis scale: mapped y must stay inside the rendered canvas height")

    # The regression pattern (root-caused to source_height being fed the
    # x-axis-derived / undersized value): using x's ratio (presentWidth /
    # sourceWidth) for the y conversion overshoots the canvas and misses
    # every hit test near the bottom of the screen.
    let buggyLogicalY: int64 = scaleMilli(visualY, presentWidth, sourceWidth)
    assert(buggyLogicalY > presentHeight,
           "regression guard: reproducing the reported bug (x-ratio applied to y) must overshoot the 804-tall canvas — proves the fixed formula, not the buggy one, is what must ship")

    # x-axis conversion is untouched by this fix and must keep working
    # (606*388/1212 = 194 exactly).
    assert(logicalX == 194,
           "touch x-axis scale: physical 606 must map to logical 194, got " + IntToStr(int32(logicalX)))

    echo(" mobile_shell_touch_axis_scale_fixture ok")
    return 0
