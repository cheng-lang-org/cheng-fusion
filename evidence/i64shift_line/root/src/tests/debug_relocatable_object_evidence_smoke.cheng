import std/os
import std/rawbytes
import cheng/core/backend/debug_relocatable_object_evidence as evidence
import cheng/core/backend/macho_object_writer as macho
import cheng/core/backend/elf_object_writer as elf
import cheng/core/backend/coff_object_writer as coff
import cheng/core/backend/object_symbols as symbols
import cheng/core/backend/object_relocs as relocs

fn CopyBytes(source: rawbytes.Bytes): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(source))
    for index in 0..<rawbytes.BytesLen(source):
        rawbytes.BytesSet(out, index, rawbytes.BytesGet(source, index))
    return out

fn CopyU32(bytes: var rawbytes.Bytes,
           destination: int32,
           source: int32) =
    for index in 0..<4:
        rawbytes.BytesSet(bytes, destination + index,
                          rawbytes.BytesGet(bytes, source + index))

fn AssertObjectEvidence(objectBytes: rawbytes.Bytes,
                        expectedFormat: int32,
                        symbolNames: str[],
                        symbolStarts: int32[],
                        symbolLengths: int32[]): evidence.DebugRelocatableObjectEvidence =
    var out: evidence.DebugRelocatableObjectEvidence
    var err: str
    assert(evidence.DebugRelocatableObjectEvidenceBuildInto(
               objectBytes, symbolNames, symbolStarts,
               symbolLengths, out, err), err)
    assert(out.valid && out.formatKind == expectedFormat &&
           out.functions.len == 1 &&
           out.functions[0].sectionRelativeByteStart == 0 &&
           out.functions[0].byteLength == 8 &&
           out.functions[0].objectFileByteStart ==
               out.textSectionFileOffset &&
           evidence.DebugRelocatableObjectEvidenceStrictValidateInto(
               out, objectBytes, symbolNames, symbolStarts,
               symbolLengths, err), err)
    return out

fn main() =
    var text = rawbytes.BytesAlloc(8)
    for index in 0..<8:
        rawbytes.BytesSet(text, index, 16 + index)
    let functionName = "debug_relocatable_evidence_function"
    let externalName = "debug_relocatable_evidence_external"
    var objectSymbols = symbols.ObjectSymbolsInit()
    let functionSymbol = symbols.ObjectSymbolsAddDefined(
        objectSymbols, functionName, 0, int64(0), int64(8), true)
    let externalSymbol = symbols.ObjectSymbolsAddUndefined(
        objectSymbols, externalName, true)
    assert(functionSymbol == 0 && externalSymbol == 1,
           " debug object evidence smoke: symbol setup failed")
    var objectRelocs = relocs.ObjectRelocsInit()
    let _ = relocs.ObjectRelocsAdd(
        objectRelocs, 0, int64(0), externalSymbol,
        relocs.ObjectRelocAbs64, int64(0), false)
    let symbolNames = [functionName]
    let symbolStarts: int32[] = [0]
    let symbolLengths: int32[] = [8]

    let machoResult = macho.MachOTextObjectBytes(
        text, objectSymbols, objectRelocs)
    assert(machoResult.ok, machoResult.err.msg)
    let machoBytes = machoResult.value
    let machoEvidence = AssertObjectEvidence(
        machoBytes, evidence.DebugRelocatableObjectFormatMachO,
        symbolNames, symbolStarts, symbolLengths)

    let elfResult = elf.ElfTextObjectBytes(
        text, objectSymbols, objectRelocs)
    assert(elfResult.ok, elfResult.err.msg)
    let elfBytes = elfResult.value
    let elfEvidence = AssertObjectEvidence(
        elfBytes, evidence.DebugRelocatableObjectFormatElf,
        symbolNames, symbolStarts, symbolLengths)

    let coffResult = coff.CoffTextObjectBytes(
        text, objectSymbols, objectRelocs)
    assert(coffResult.ok, coffResult.err.msg)
    let coffBytes = coffResult.value
    let coffEvidence = AssertObjectEvidence(
        coffBytes, evidence.DebugRelocatableObjectFormatCoff,
        symbolNames, symbolStarts, symbolLengths)

    var err: str
    var rejected: evidence.DebugRelocatableObjectEvidence
    var attacked = CopyBytes(elfBytes)
    let elfFunction = elfEvidence.functions[0]
    rawbytes.BytesSet(
        attacked,
        elfEvidence.symbolTableFileOffset +
            elfFunction.symbolTableIndex * 24 + 16,
        7)
    assert(!evidence.DebugRelocatableObjectEvidenceBuildInto(
               attacked, symbolNames, symbolStarts,
               symbolLengths, rejected, err),
           " debug object evidence smoke: ELF function size attack accepted")
    rawbytes.BytesFree(attacked)

    attacked = CopyBytes(coffBytes)
    let coffFunction = coffEvidence.functions[0]
    rawbytes.BytesSet(
        attacked,
        coffEvidence.symbolTableFileOffset +
            coffFunction.symbolTableIndex * 18 + 12,
        0)
    rawbytes.BytesSet(
        attacked,
        coffEvidence.symbolTableFileOffset +
            coffFunction.symbolTableIndex * 18 + 13,
        0)
    assert(!evidence.DebugRelocatableObjectEvidenceBuildInto(
               attacked, symbolNames, symbolStarts,
               symbolLengths, rejected, err),
           " debug object evidence smoke: COFF undefined function accepted")
    rawbytes.BytesFree(attacked)

    attacked = CopyBytes(machoBytes)
    let machoFunction = machoEvidence.functions[0]
    let machoOtherSymbol = machoFunction.symbolTableIndex == 0 ? 1 : 0
    CopyU32(
        attacked,
        machoEvidence.symbolTableFileOffset + machoOtherSymbol * 16,
        machoEvidence.symbolTableFileOffset +
            machoFunction.symbolTableIndex * 16)
    assert(!evidence.DebugRelocatableObjectEvidenceBuildInto(
               attacked, symbolNames, symbolStarts,
               symbolLengths, rejected, err),
           " debug object evidence smoke: Mach-O duplicate function accepted")
    rawbytes.BytesFree(attacked)

    attacked = CopyBytes(elfBytes)
    rawbytes.BytesSet(
        attacked, elfEvidence.relocationTableFileOffset + 12, 255)
    assert(!evidence.DebugRelocatableObjectEvidenceBuildInto(
               attacked, symbolNames, symbolStarts,
               symbolLengths, rejected, err),
           " debug object evidence smoke: ELF relocation attack accepted")
    rawbytes.BytesFree(attacked)

    attacked = CopyBytes(coffBytes)
    rawbytes.BytesSet(
        attacked, coffEvidence.relocationTableFileOffset + 8, 255)
    assert(!evidence.DebugRelocatableObjectEvidenceBuildInto(
               attacked, symbolNames, symbolStarts,
               symbolLengths, rejected, err),
           " debug object evidence smoke: COFF relocation attack accepted")
    rawbytes.BytesFree(attacked)

    attacked = CopyBytes(machoBytes)
    rawbytes.BytesSet(
        attacked, machoEvidence.relocationTableFileOffset + 7, 255)
    assert(!evidence.DebugRelocatableObjectEvidenceBuildInto(
               attacked, symbolNames, symbolStarts,
               symbolLengths, rejected, err),
           " debug object evidence smoke: Mach-O relocation attack accepted")
    rawbytes.BytesFree(attacked)

    attacked = CopyBytes(elfBytes)
    rawbytes.BytesSet(attacked, 0, 0)
    assert(!evidence.DebugRelocatableObjectEvidenceBuildInto(
               attacked, symbolNames, symbolStarts,
               symbolLengths, rejected, err),
           " debug object evidence smoke: unknown format accepted")
    rawbytes.BytesFree(attacked)

    rawbytes.BytesFree(machoBytes)
    rawbytes.BytesFree(elfBytes)
    rawbytes.BytesFree(coffBytes)
    rawbytes.BytesFree(text)
    os.WriteLine(os.Get_stdout(),
                 "debug_relocatable_object_evidence_smoke: ok")
