type NestedChild = ref object
    value: int32

type NestedLeaf = ref object
    value: int32
    child: NestedChild

type NestedMid =
    leaf: NestedLeaf
    values: int32[]
    scores: int32[4]

type NestedRoot =
    mid: NestedMid
    spare: NestedLeaf
    direct: int32[]

fn NestedLeafBump(leaf: var NestedLeaf) =
    leaf.value = leaf.value + 1

fn NestedValuesAppend(values: var int32[]) =
    add(values, 7)

fn NestedScoreBump(score: var int32) =
    score = score + 1

fn NestedScalarBump(value: var int32) =
    value = value + 1

# Production shape: a `var` value-struct parameter whose (possibly nested)
# field is passed to a `var` formal.  Every hop must lower as an exact place
# (FIELD_REF/INDEX_REF), never as a loaded temporary value.
fn NestedRootMutate(root: var NestedRoot) =
    NestedLeafBump(root.spare)
    NestedLeafBump(root.mid.leaf)
    NestedScalarBump(root.mid.leaf.value)
    NestedScalarBump(root.mid.leaf.child.value)
    NestedValuesAppend(root.direct)
    NestedValuesAppend(root.mid.values)
    NestedScalarBump(root.direct[0])
    NestedScalarBump(root.mid.values[0])
    NestedScoreBump(root.mid.scores[2])

fn main(): int32 =
    var root: NestedRoot
    root.spare = new(NestedLeaf)
    root.mid.leaf = new(NestedLeaf)
    root.mid.leaf.child = new(NestedChild)
    NestedRootMutate(root)
    assert(root.spare.value == 1,
           "nested field var place: one-hop ref field mutation lost")
    assert(root.mid.leaf.value == 2,
           "nested field var place: ref-object hop scalar mutation lost")
    assert(root.mid.leaf.child.value == 1,
           "nested field var place: materialized ref authority lost")
    assert(root.direct.len == 1 && root.direct[0] == 8,
           "nested field var place: direct sequence element mutation lost")
    assert(root.mid.values.len == 1 && root.mid.values[0] == 8,
           "nested field var place: nested sequence element mutation lost")
    assert(root.mid.scores[2] == 1,
           "nested field var place: nested fixed-array element mutation lost")
    echo("cold_nested_field_var_place_smoke: ok")
    return 0
