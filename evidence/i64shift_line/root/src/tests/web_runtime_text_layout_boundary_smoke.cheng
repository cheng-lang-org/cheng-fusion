import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_layout_runtime as layout
import cheng/core/runtime/web_text_runtime as text

fn main(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let textNode = web.WebDocumentCreateText(document, "A B")
    if textNode <= 0:
        echo("FAIL create text node")
        return 1

    var metrics: text.WebTextMetrics
    if !text.WebTextMetricsInit(metrics, 2, 3):
        echo("FAIL text metrics")
        return 2

    var tree: layout.WebLayoutTree
    if !text.WebTextBuildTextNodeLayout(document, textNode, 1, 2, metrics, tree):
        echo("FAIL text layout build")
        return 3
    if layout.WebLayoutBoxCount(tree) != 1:
        echo("FAIL text layout box count")
        return 4
    if layout.WebLayoutBoxWidthAt(tree, 0) != 6:
        echo("FAIL text layout width")
        return 5

    echo("web_runtime_text_layout_boundary_smoke ok")
    return 0
