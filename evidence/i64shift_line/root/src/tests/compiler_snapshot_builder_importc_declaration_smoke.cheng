import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/tooling/compiler_csg
import cheng/core/tooling/compiler_snapshot_builder as builder
import cheng/core/tooling/compiler_world
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/semantic_snapshot
import cheng/std/bytes_layout as layout
import cheng/tests/compiler_snapshot_builder_type_only_smoke as helper

fn main() =
    let root = chengpath.PathCurrentDir()
    let sourcePath = chengpath.PathJoin(
        root,
        "src/tests/compiler_snapshot_builder_importc_declaration_fixture.cheng")
    let sourceText = chengpath.ReadTextFile(root, sourcePath)
    assert(sourceText != "",
           "compiler snapshot builder importc declaration smoke: source missing")
    var csg: compiler_csg.CompilerCsg
    var err: str
    assert(helper.TypeOnlyBuildCsg(
               root, sourcePath, sourceText, csg, err),
           Fmt"compiler snapshot builder importc declaration smoke: CSG failed {err}")
    assert(csg.semanticGraph.resolvedCallTable.sourceIndexes.len == 0,
           "compiler snapshot builder importc declaration smoke: fixture unexpectedly calls extern")
    var tables: schema.CsgCompilerSnapshotTables
    var admission: builder.CompilerSnapshotProductionAdmissionReceipt
    var documentCid: layout.FixedBytes32
    assert(compiler_world.CompilerWorldDocumentCidInto(
               csg.packageId,
               csg.semanticGraph.sourceTable.modulePaths[0],
               documentCid,
               err),
           Fmt"compiler snapshot builder importc declaration smoke: document identity failed {err}")
    var eventState: semantic_snapshot.WorkspaceSourceEventState
    assert(semantic_snapshot.WorkspaceSourceEventStateInitInto(
               csg.sourceBundleCid, eventState, err),
           Fmt"compiler snapshot builder importc declaration smoke: event init failed {err}")
    var sourceVersion: int64
    assert(semantic_snapshot.WorkspaceSourceEventAcceptInto(
               eventState,
               semantic_snapshot.SemanticSourceEventOpen,
               documentCid,
               int64(0),
               sourceVersion,
               err),
           Fmt"compiler snapshot builder importc declaration smoke: event accept failed {err}")
    var documentCids: layout.FixedBytes32[]
    var canonicalSourceByProducer: int32[]
    var sourceTexts: str[]
    add(documentCids, documentCid)
    add(canonicalSourceByProducer, 0)
    add(sourceTexts, sourceText)
    assert(builder.CompilerSnapshotProductionCandidateBuildUnsealedInto(
               csg,
               documentCids,
               canonicalSourceByProducer,
               sourceTexts,
               eventState,
               csg.canonicalGraphCid,
               csg.graphCid,
               csg.sourceIdentityReceipt.receiptCid,
               tables,
               admission,
               err),
           Fmt"compiler snapshot builder importc declaration smoke: snapshot failed {err}")
    assert(admission.admissionBlocked &&
           admission.missingSourceInterfaceCount ==
               tables.sources.documentCids.len &&
           (admission.missingFactBitmap &
                builder.CompilerSnapshotAdmissionMissingSourceInterface) != 0,
           "compiler snapshot builder importc declaration smoke: candidate was not unsealed")
    assert(tables.symbols.symbolCids.len == 4,
           Fmt"compiler snapshot builder importc declaration smoke: unsealed Symbol coverage={tables.symbols.symbolCids.len}/4")
    var parameterSymbolCount: int32
    for symbolId in 0..<tables.symbols.symbolKinds.len:
        if tables.symbols.symbolKinds[symbolId] !=
               schema.CsgCompilerSymbolParameter:
            continue
        let ownerSymbolId =
            tables.symbols.ownerSymbolIds[symbolId]
        assert(ownerSymbolId >= 0 &&
               ownerSymbolId < tables.symbols.symbolKinds.len &&
               tables.symbols.symbolKinds[ownerSymbolId] ==
                   schema.CsgCompilerSymbolFunction &&
               tables.symbols.declIds[symbolId] >= 0 &&
               tables.symbols.declIds[symbolId] <
                   tables.declarations.declIds.len &&
               layout.FixedBytes32Equal(
                   tables.symbols.symbolCids[symbolId],
                   tables.symbols.declKeyCids[symbolId]) &&
               tables.symbols.typeIds[symbolId] >= 0 &&
               tables.symbols.typeIds[symbolId] <
                   tables.types.typeCids.len,
               "compiler snapshot builder importc declaration smoke: Parameter identity incomplete")
        parameterSymbolCount = parameterSymbolCount + 1
    assert(parameterSymbolCount == 1,
           Fmt"compiler snapshot builder importc declaration smoke: Parameter coverage={parameterSymbolCount}/1")
    assert(builder.CompilerSnapshotProductionCandidateSealInto(
               csg,
               documentCids,
               canonicalSourceByProducer,
               tables,
               admission,
               err),
           Fmt"compiler snapshot builder importc declaration smoke: seal failed {err}")
    let canonicalValid =
        schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err)
    assert(!admission.admissionBlocked &&
           admission.missingFactBitmap == 0 &&
           tables.functions.symbolIds.len == 1 &&
           tables.externFunctions.symbolIds.len == 1 &&
           tables.calls.callReferenceIds.len == 0 &&
           tables.annotationTargets.parserAnnotationRows.len == 1 &&
           canonicalValid,
           Fmt"compiler snapshot builder importc declaration smoke: canonical extern authority invalid bitmap={admission.missingFactBitmap} {err}")
    echo("compiler_snapshot_builder_importc_declaration=1")
