# backend2_cid_contract_smoke — funcEmitCid 7-tuple 纯计算契约 + contentCid 二次校验负路径。
# spec: docs/beat-c.md §8.3/§4.3; gate: tools/backend2_cid_gate.sh。
#
# 模式 (argv[1], 缺省 unit):
#   unit           — 正路径全断言 (§3.1 epoch / §3.7 triple / §3.5 注册序不变 / §3.4 视图
#                    ABI 敏感 / §3.3 体敏感+α 局部改名不变+全局名敏感 / §3.2 路径规范 /
#                    replaced codec BodyIR payload/contentCid 往返 / 校验原语正路径),
# 全绿输出 B2_CID_UNIT_OK, rc=0。
#   tamper-content — 解码后篡改 words 一字 → Backend2FragmentVerifyContent 必硬崩 (rc!=0,
#                    stderr 含 backend2_content_cid_mismatch)。
#   tamper-cid     — 查询键 != 存储键 → Backend2FragmentVerifyCid 必硬崩 (backend2_cache_cid_mismatch)。
#   stale-global   — 仅改 normalized global init payload，旧 fragment key 必被拒。
#   empty-cid      — 空键拒收 → Backend2FragmentCacheKeyGuard 必硬崩 (backend2_empty_func_emit_cid_reject)。

import std/cmdline as cmdline
import cheng/std/bytes_layout as layout
import cheng/core/ir/core_types as coreir
import cheng/core/backend2/backend2_types as b2t
import cheng/core/backend2/backend2_frag_codec as b2fc
import cheng/core/backend2/backend2_cid as b2cid

# ---- 夹具: 合成 BodyIR (1 槽 1 op 1 term 1 块 1 call 1 cstring, 全臂覆盖) ----

fn buildBodyFixture(operandValue: int32, slotName: str, globalSlotName: str): coreir.BodyIR =
    var body: coreir.BodyIR
    var slot0: coreir.LocalSlot
    slot0.id = 0
    slot0.name = slotName
    slot0.typeKind = coreir.LocalI32Tag
    slot0.placeKind = coreir.BodyPlaceStackValueTag
    slot0.sizeBytes = 4
    slot0.alignBytes = 4
    slot0.stackOffset = 16
    slot0.auxValue = 7
    slot0.noAlias = true
    add(body.localSlots, slot0)
    var slot1: coreir.LocalSlot
    slot1.id = 1
    slot1.name = globalSlotName
    slot1.typeKind = coreir.LocalI32Tag
    slot1.placeKind = coreir.BodyPlaceGlobalAddressTag
    slot1.sizeBytes = 4
    slot1.alignBytes = 4
    add(body.localSlots, slot1)
    var op0: coreir.BodyOp
    op0.kind = 1
    op0.target = 0
    add(op0.operands, operandValue)
    add(body.ops, op0)
    var call0: coreir.CallOp
    call0.targetSymbol = "callee_alpha"
    add(call0.argSlots, 0)
    add(call0.argPassKinds, 0)
    add(call0.argAbiSizes, 4)
    call0.resultSlot = 0
    add(body.callSequence, call0)
    var term0: coreir.BodyTerm
    term0.kind = coreir.BodyTermReturnTag
    term0.resultSlot = 0
    term0.lhsSlot = -1
    term0.rhsSlot = -1
    add(body.terms, term0)
    var blk0: coreir.BodyBlock
    blk0.id = 0
    blk0.opStart = 0
    blk0.opCount = 1
    blk0.termIndex = 0
    add(body.blocks, blk0)
    var cstr0: coreir.CStringLiteralEntry
    cstr0.id = 0
    cstr0.text = "hello"
    add(body.cstringLiterals, cstr0)
    return body

fn buildView(name: str, paramType: str, returnType: str): b2t.CalleeAbiView =
    var view: b2t.CalleeAbiView
    view.functionName = name
    add(view.paramTypes, paramType)
    view.returnType = returnType
    return view

fn buildFragFixture(): b2t.FunctionFragment =
    var frag: b2t.FunctionFragment
    frag.functionSymbol = "cid_smoke_fn"
    frag.wordCount = 3
    add(frag.words, 0x11000001)
    add(frag.words, -1)
    add(frag.words, 0x33000003)
    add(frag.relocWordOffsets, 1)
    add(frag.relocTargetSymbols, "callee_alpha")
    add(frag.refSymbols, "callee_alpha")
    add(frag.cstringLiterals, "hello")
    add(frag.globalDataLabelsRaw, "cheng_global_counter")
    add(frag.globalDataPayloadTexts, "zero:4")
    add(frag.globalDataPayloadByteCounts, 0)
    frag.bodyIrPayload = "cid-smoke-body-ir-payload"
    return frag

fn computeFixtureCid(epochSalt: str,
                     targetTriple: str,
                     bodyHash: layout.FixedBytes32,
                     pathHash: layout.FixedBytes32,
                     callTargets: str[],
                     importcSymbols: str[],
                     views: b2t.CalleeAbiView[]): str =
    return b2cid.Backend2ComputeFuncEmitCid(epochSalt, targetTriple, bodyHash, pathHash,
                                            callTargets, importcSymbols, views)

fn computeGlobalPayloadFixtureCid(payloadText: str): str =
    var body = buildBodyFixture(42, "x", "g_counter")
    var labels: str[]
    add(labels, "cheng_global_g_counter")
    var payloads: str[]
    add(payloads, payloadText)
    var byteCounts: int32[]
    add(byteCounts, 0)
    let bodyHash = b2cid.Backend2TypedFnCanonicalHashWithGlobalData(
        body, "cid_smoke_fn", labels, payloads, byteCounts)
    let pathHash = b2cid.Backend2SourcePathHash(
        "/ws", "", "/ws/src/a.cheng")
    var callTargets: str[]
    var importcSymbols: str[]
    var views: b2t.CalleeAbiView[]
    return computeFixtureCid(
        "backend2-slice23",
        "arm64-apple-darwin",
        bodyHash,
        pathHash,
        callTargets,
        importcSymbols,
        views)

fn runUnit(): int32 =
    let bodyBase = buildBodyFixture(42, "x", "g_counter")
    let bodyHash = b2cid.Backend2TypedFnCanonicalHash(bodyBase, "cid_smoke_fn")
    let pathHash = b2cid.Backend2SourcePathHash("/ws", "", "/ws/src/a.cheng")
    var callTargets: str[]
    add(callTargets, "callee_beta")
    add(callTargets, "callee_alpha")
    var importcSymbols: str[]
    add(importcSymbols, "libc_write")
    add(importcSymbols, "libc_close")
    var views: b2t.CalleeAbiView[]
    add(views, buildView("callee_beta", "i64", "bool"))
    add(views, buildView("callee_alpha", "int32", "int32"))
    let cidBase = computeFixtureCid("backend2-slice0", "arm64-apple-darwin",
                                    bodyHash, pathHash, callTargets, importcSymbols, views)
    assert(len(cidBase) == 64, "cid is 64-hex sha256")

    # §3.1 epoch: 盐变 → cid 必变
    let cidEpoch = computeFixtureCid("backend2-slice1", "arm64-apple-darwin",
                                     bodyHash, pathHash, callTargets, importcSymbols, views)
    assert(cidEpoch != cidBase, "epoch salt flips cid")

    # §3.7 triple: 目标变 → cid 必变
    let cidTriple = computeFixtureCid("backend2-slice0", "x86_64-apple-darwin",
                                      bodyHash, pathHash, callTargets, importcSymbols, views)
    assert(cidTriple != cidBase, "target triple flips cid")

    # §3.5 注册序扰动: callTargets/importc/views 全部反序 → cid 必不变
    var callTargetsRev: str[]
    add(callTargetsRev, "callee_alpha")
    add(callTargetsRev, "callee_beta")
    var importcSymbolsRev: str[]
    add(importcSymbolsRev, "libc_close")
    add(importcSymbolsRev, "libc_write")
    var viewsRev: b2t.CalleeAbiView[]
    add(viewsRev, buildView("callee_alpha", "int32", "int32"))
    add(viewsRev, buildView("callee_beta", "i64", "bool"))
    let cidReordered = computeFixtureCid("backend2-slice0", "arm64-apple-darwin",
                                         bodyHash, pathHash, callTargetsRev, importcSymbolsRev, viewsRev)
    assert(cidReordered == cidBase, "registration order does not flip cid")

    # §3.4 视图 ABI 敏感: 被调方参数型 int32→i64 → caller cid 必变
    var viewsAbi: b2t.CalleeAbiView[]
    add(viewsAbi, buildView("callee_beta", "i64", "bool"))
    add(viewsAbi, buildView("callee_alpha", "i64", "int32"))
    let cidAbi = computeFixtureCid("backend2-slice0", "arm64-apple-darwin",
                                   bodyHash, pathHash, callTargets, importcSymbols, viewsAbi)
    assert(cidAbi != cidBase, "callee abi view change flips cid")

    # §3.3 体敏感: op 操作数 42→43 → 体哈希必变 → cid 必变
    let bodyChanged = buildBodyFixture(43, "x", "g_counter")
    let bodyHashChanged = b2cid.Backend2TypedFnCanonicalHash(bodyChanged, "cid_smoke_fn")
    assert(layout.FixedBytes32Hex(bodyHashChanged) != layout.FixedBytes32Hex(bodyHash),
           "body operand change flips typedFnCanonicalHash")
    let cidBody = computeFixtureCid("backend2-slice0", "arm64-apple-darwin",
                                    bodyHashChanged, pathHash, callTargets, importcSymbols, views)
    assert(cidBody != cidBase, "body change flips cid")

    # §3.3 α 不变量: 局部槽改名 (stack place) → 体哈希必不变
    let bodyRenamed = buildBodyFixture(42, "y", "g_counter")
    let bodyHashRenamed = b2cid.Backend2TypedFnCanonicalHash(bodyRenamed, "cid_smoke_fn")
    assert(layout.FixedBytes32Hex(bodyHashRenamed) == layout.FixedBytes32Hex(bodyHash),
           "local slot rename keeps typedFnCanonicalHash")

    # canonical allocator 可读字段必须全部入键，否则 warm cache 会替换 BodyIR。
    var bodyAuxChanged = bodyBase
    bodyAuxChanged.localSlots[0].auxValue = 8
    let bodyHashAuxChanged = b2cid.Backend2TypedFnCanonicalHash(
        bodyAuxChanged, "cid_smoke_fn")
    assert(layout.FixedBytes32Hex(bodyHashAuxChanged) !=
               layout.FixedBytes32Hex(bodyHash),
           "allocator-visible auxValue flips typedFnCanonicalHash")
    var bodyNoAliasChanged = bodyBase
    bodyNoAliasChanged.localSlots[0].noAlias = false
    let bodyHashNoAliasChanged = b2cid.Backend2TypedFnCanonicalHash(
        bodyNoAliasChanged, "cid_smoke_fn")
    assert(layout.FixedBytes32Hex(bodyHashNoAliasChanged) !=
               layout.FixedBytes32Hex(bodyHash),
           "allocator-visible noAlias flips typedFnCanonicalHash")

    # §3.3 全局名语义: 全局地址槽改名 → 体哈希必变 (reloc 标签是发射语义)
    let bodyGlobalRenamed = buildBodyFixture(42, "x", "g_other")
    let bodyHashGlobal = b2cid.Backend2TypedFnCanonicalHash(bodyGlobalRenamed, "cid_smoke_fn")
    assert(layout.FixedBytes32Hex(bodyHashGlobal) != layout.FixedBytes32Hex(bodyHash),
           "global slot rename flips typedFnCanonicalHash")

    # 同体异名函数: functionSymbol 入哈希 → 体哈希必变 (防跨函数错配)
    let bodyHashOtherFn = b2cid.Backend2TypedFnCanonicalHash(bodyBase, "cid_smoke_fn_2")
    assert(layout.FixedBytes32Hex(bodyHashOtherFn) != layout.FixedBytes32Hex(bodyHash),
           "function symbol flips typedFnCanonicalHash")

    # Global initializers are fragment data derived from typed IR rather than
    # BodyIR. A payload-only edit must still flip component 3 and the final key.
    let cidGlobalZero = computeGlobalPayloadFixtureCid("zero:4")
    let cidGlobalValue = computeGlobalPayloadFixtureCid("hex:2a000000")
    assert(cidGlobalZero != cidGlobalValue,
           "global init payload change flips funcEmitCid")

    # §3.2 路径规范: workspace 前缀剥除 → 跨机同 rel 路径同哈希; rel 路径变 → 哈希变
    let pathHashOtherRoot = b2cid.Backend2SourcePathHash("/other-machine-root", "", "/other-machine-root/src/a.cheng")
    assert(layout.FixedBytes32Hex(pathHashOtherRoot) == layout.FixedBytes32Hex(pathHash),
           "workspace prefix stripped: cross-root stable")
    let pathHashOtherFile = b2cid.Backend2SourcePathHash("/ws", "", "/ws/src/b.cheng")
    assert(layout.FixedBytes32Hex(pathHashOtherFile) != layout.FixedBytes32Hex(pathHash),
           "different source path flips hash")

    # §3.4 typeSpelling: 指针统一 + 空白归一
    assert(b2cid.Backend2TypeCanonicalSpelling("void*") == "ptr", "void* -> ptr")
    assert(b2cid.Backend2TypeCanonicalSpelling("ptr[int32]") == "ptr", "ptr[T] -> ptr")
    assert(b2cid.Backend2TypeCanonicalSpelling("MyType *") == "ptr", "T* -> ptr")
    assert(b2cid.Backend2TypeCanonicalSpelling("Result[ bool ]") == "Result[bool]", "whitespace normalized")

    # Replaced codec fields 17/18: BodyIR payload + contentCid 编解往返。
    var frag = buildFragFixture()
    frag.funcEmitCid = cidBase
    frag.contentCid = b2cid.Backend2ContentCidOfFragment(frag)
    assert(len(frag.contentCid) == 64, "contentCid is 64-hex sha256")
    b2fc.Backend2FragmentRoundTripAssert(frag)
    var enc = b2fc.Backend2FragmentEncode(frag)
    var cursor: int32
    let dec = b2fc.Backend2FragmentDecode(enc, cursor)
    assert(cursor == enc.len, "decode consumed all bytes")
    assert(dec.funcEmitCid == frag.funcEmitCid, "funcEmitCid round-trips")
    assert(dec.contentCid == frag.contentCid, "contentCid round-trips")
    assert(dec.bodyIrPayload == frag.bodyIrPayload,
           "bodyIrPayload round-trips")
    b2cid.Backend2FragmentVerifyCid(dec, cidBase)
    b2cid.Backend2FragmentVerifyContent(dec)
    b2cid.Backend2FragmentCacheKeyGuard(dec)

    # contentCid 与 funcEmitCid 解耦: 键值自指字段留空后哈希 → 换键不换 contentCid
    var fragOtherKey = buildFragFixture()
    fragOtherKey.funcEmitCid = cidEpoch
    assert(b2cid.Backend2ContentCidOfFragment(fragOtherKey) == frag.contentCid,
           "contentCid independent of funcEmitCid")

    echo("B2_CID_UNIT_OK")
    return 0

fn runTamperContent(): int32 =
    var frag = buildFragFixture()
    frag.funcEmitCid = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    frag.contentCid = b2cid.Backend2ContentCidOfFragment(frag)
    var enc = b2fc.Backend2FragmentEncode(frag)
    var cursor: int32
    var dec = b2fc.Backend2FragmentDecode(enc, cursor)
    # 模拟缓存 .frag 内容被篡改: words 区翻一字 → contentCid 二次校验必硬崩
    dec.words[0] = dec.words[0] + 1
    b2cid.Backend2FragmentVerifyContent(dec)
    echo("B2_CID_TAMPER_CONTENT_NOT_CAUGHT")
    return 1

fn runTamperCid(): int32 =
    var frag = buildFragFixture()
    frag.funcEmitCid = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
    frag.contentCid = b2cid.Backend2ContentCidOfFragment(frag)
    # 查询键与存储键不一致 (伪造键) → cid 校验必硬崩
    b2cid.Backend2FragmentVerifyCid(frag, "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff")
    echo("B2_CID_TAMPER_CID_NOT_CAUGHT")
    return 1

fn runStaleGlobal(): int32 =
    var frag = buildFragFixture()
    frag.funcEmitCid = computeGlobalPayloadFixtureCid("zero:4")
    frag.contentCid = b2cid.Backend2ContentCidOfFragment(frag)
    b2cid.Backend2FragmentVerifyCid(
        frag, computeGlobalPayloadFixtureCid("hex:2a000000"))
    echo("B2_CID_STALE_GLOBAL_NOT_CAUGHT")
    return 1

fn runEmptyCid(): int32 =
    var frag = buildFragFixture()
    # funcEmitCid 留空 (空键碰撞风险) → put 前置守卫必硬崩
    b2cid.Backend2FragmentCacheKeyGuard(frag)
    echo("B2_CID_EMPTY_NOT_CAUGHT")
    return 1

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    var mode = ""
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "" || mode == "unit":
        return runUnit()
    if mode == "tamper-content":
        return runTamperContent()
    if mode == "tamper-cid":
        return runTamperCid()
    if mode == "stale-global":
        return runStaleGlobal()
    if mode == "empty-cid":
        return runEmptyCid()
    echo("B2_CID_UNKNOWN_MODE")
    return 2
