import cheng/tests/cold_aggregate_field_store_left as left

type
    ColdAggregateGenericBox[T] =
        value: T

    ColdAggregateRefGenericHolder =
        borrowed: var left.AggregateIdentity
        boxed: ColdAggregateGenericBox[int32]

fn ColdAggregateStoreBorrowed(holder: var ColdAggregateRefGenericHolder,
                              payload: var left.AggregateIdentity) =
    holder.borrowed = payload

fn ColdAggregateCheckBorrowed(payload: var left.AggregateIdentity): int32 =
    if payload.label != "borrowed":
        return 1
    if payload.values[3] != 7:
        return 2
    return 0

fn main(): int32 =
    var payload = left.AggregateIdentity(label: "borrowed", values: [2, 3, 5, 7])
    var holder: ColdAggregateRefGenericHolder
    ColdAggregateStoreBorrowed(holder, payload)
    var same: ColdAggregateGenericBox[int32]
    same.value = 144
    holder.boxed = same
    let borrowedCheck = ColdAggregateCheckBorrowed(holder.borrowed)
    if borrowedCheck != 0:
        return borrowedCheck
    if holder.boxed.value != 144:
        return 3
    return 0
