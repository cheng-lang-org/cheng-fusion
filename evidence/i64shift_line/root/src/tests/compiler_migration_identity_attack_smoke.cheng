import std/result
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq

fn MigrationIdentityEvidence(
        workspaceRoot: str,
        packageRoot: str,
        legacySourcePath: str,
        packageId: str,
        targetModulePath: str,
        outMigration: var ccsg.CompilerLegacyMigration,
        outEvidence: var ceq.CompilerMigrationEvidence): Result[bool] =
    let migrationRes = ccsg.BuildCompilerLegacyMigrationInto(
        workspaceRoot,
        packageRoot,
        legacySourcePath,
        packageId,
        targetModulePath,
        outMigration)
    if IsErr(migrationRes):
        return Err[bool](Error(migrationRes))
    return ceq.CompilerMigrationEvidenceMake(
        outMigration,
        outEvidence)

fn main(): int32 =
    let workspaceRoot = chengpath.PathCurrentDir()
    let packageRoot = workspaceRoot
    let packageId = "cheng"
    let targetModulePath = "cheng/tests/compiler_migration_fixture"
    let legacySourcePath = chengpath.PathJoin(
        packageRoot,
        "testdata/compiler_migration/compiler_migration_fixture_legacy.cheng")
    var emptyPackage: ccsg.CompilerLegacyMigration
    assert(IsErr(ccsg.BuildCompilerLegacyMigrationInto(
               workspaceRoot,
               packageRoot,
               legacySourcePath,
               "",
               targetModulePath,
               emptyPackage)),
           " compiler migration identity: empty package accepted")
    var forgedTarget: ccsg.CompilerLegacyMigration
    assert(IsErr(ccsg.BuildCompilerLegacyMigrationInto(
               workspaceRoot,
               packageRoot,
               legacySourcePath,
               packageId,
               "cheng/tests/../forged",
               forgedTarget)),
           " compiler migration identity: forged module path accepted")
    var baselineMigration: ccsg.CompilerLegacyMigration
    var baselineEvidence: ceq.CompilerMigrationEvidence
    let baselineRes = MigrationIdentityEvidence(
        workspaceRoot,
        packageRoot,
        legacySourcePath,
        packageId,
        targetModulePath,
        baselineMigration,
        baselineEvidence)
    assert(IsOk(baselineRes) &&
           ceq.CompilerMigrationEvidenceVerify(baselineEvidence),
           " compiler migration identity: baseline evidence")
    let report = ceq.CompilerMigrationEvidenceReport(baselineEvidence)
    assert(!chengpath.TextContains(report, workspaceRoot) &&
           !chengpath.TextContains(report, legacySourcePath) &&
           chengpath.TextContains(
               report,
               "unit[0].module_path=cheng/tests/compiler_migration_fixture"),
           " compiler migration identity: portable report leaked local path")
    let relativeAlias =
        "testdata/compiler_migration/../compiler_migration/compiler_migration_fixture_legacy.cheng"
    var aliasMigration: ccsg.CompilerLegacyMigration
    var aliasEvidence: ceq.CompilerMigrationEvidence
    let aliasRes = MigrationIdentityEvidence(
        workspaceRoot,
        packageRoot,
        relativeAlias,
        packageId,
        targetModulePath,
        aliasMigration,
        aliasEvidence)
    assert(IsOk(aliasRes) &&
           layout.FixedBytes32Equal(aliasEvidence.evidenceCid,
                                    baselineEvidence.evidenceCid) &&
           ceq.CompilerMigrationEvidenceReport(aliasEvidence) == report,
           " compiler migration identity: local origin alias changed CID")
    var retargetMigration: ccsg.CompilerLegacyMigration
    var retargetEvidence: ceq.CompilerMigrationEvidence
    let retargetRes = MigrationIdentityEvidence(
        workspaceRoot,
        packageRoot,
        legacySourcePath,
        packageId,
        "cheng/tests/ordinary_zero_exit_fixture",
        retargetMigration,
        retargetEvidence)
    assert(IsOk(retargetRes) &&
           !layout.FixedBytes32Equal(retargetEvidence.evidenceCid,
                                     baselineEvidence.evidenceCid),
           " compiler migration identity: module retarget did not change CID")
    let originalPath = baselineEvidence.orderedModulePaths[0]
    baselineEvidence.orderedModulePaths[0] = "../escape"
    baselineEvidence.evidenceCid =
        ceq.CompilerMigrationEvidenceCid(baselineEvidence)
    assert(!ceq.CompilerMigrationEvidenceVerify(baselineEvidence),
           " compiler migration identity: path traversal mutation accepted")
    baselineEvidence.orderedModulePaths[0] = originalPath
    echo(" compiler_migration_identity_attack_smoke ok")
    return 0
