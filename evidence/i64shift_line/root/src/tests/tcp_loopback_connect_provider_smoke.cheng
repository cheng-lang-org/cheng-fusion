import std/result
import std/net/transports/tcp_syscall as tcp

fn main(): int32 =
    echo("tcp_loopback_connect_provider_smoke start")
    let listenRes: Result[tcp.TcpListenerHandle] = tcp.TcpListen4("127.0.0.1", 18123)
    if IsErr(listenRes):
        echo(ErrorText(listenRes))
        return 1
    var listener: tcp.TcpListenerHandle = Value(listenRes)
    echo("tcp_loopback_connect_provider_smoke listen ok")
    let blockingConnRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4("127.0.0.1", 18123)
    if IsErr(blockingConnRes):
        echo(ErrorText(blockingConnRes))
        tcp.TcpListenerClose(listener)
        return 1
    var blockingConn: tcp.TcpConnectionHandle = Value(blockingConnRes)
    let blockingAcceptRes: Result[tcp.TcpConnectionHandle] = tcp.TcpAccept(listener)
    if IsErr(blockingAcceptRes):
        echo(ErrorText(blockingAcceptRes))
        tcp.TcpClose(blockingConn)
        tcp.TcpListenerClose(listener)
        return 1
    var blockingAccepted: tcp.TcpConnectionHandle = Value(blockingAcceptRes)
    tcp.TcpClose(blockingAccepted)
    tcp.TcpClose(blockingConn)
    echo("tcp_loopback_connect_provider_smoke blocking connect ok")
    let connRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4Timeout("127.0.0.1", 18123, 3000)
    if IsErr(connRes):
        echo(ErrorText(connRes))
        tcp.TcpListenerClose(listener)
        return 1
    var conn: tcp.TcpConnectionHandle = Value(connRes)
    echo("tcp_loopback_connect_provider_smoke connect ok")
    let acceptRes: Result[tcp.TcpConnectionHandle] = tcp.TcpAccept(listener)
    if IsErr(acceptRes):
        echo(ErrorText(acceptRes))
        tcp.TcpClose(conn)
        tcp.TcpListenerClose(listener)
        return 1
    var accepted: tcp.TcpConnectionHandle = Value(acceptRes)
    tcp.TcpClose(accepted)
    tcp.TcpClose(conn)
    tcp.TcpListenerClose(listener)
    echo("tcp_loopback_connect_provider_smoke ok")
    return 0
