import std/system
import std/result
import cheng/core/lang/intern as langintern

fn main() =
    var pool = langintern.InternPoolNew()
    let alphaId = langintern.Intern(pool, "alpha")
    let dupId = langintern.Intern(pool, "alpha")
    let emptyId = langintern.Intern(pool, "")
    let betaId = langintern.Intern(pool, "beta-42")
    assert(alphaId == 0 && dupId == 0 && emptyId == 1 && betaId == 2,
           "repro B: ids")
    let lookupRes = langintern.LookupIntern(pool, betaId)
    assert(IsOk(lookupRes), "repro B: lookup")
    langintern.InternPoolRelease(pool)
    echo("repro_orc_intern_b ok")
