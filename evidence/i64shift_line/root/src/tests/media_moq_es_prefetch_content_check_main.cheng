# Runtime verification for the 秒开 prefetch content-addressing primitive added to
# web_scene_media_network_bridge.cheng (WebSceneMediaEsAssetCid / EsContentMatches /
# EsInvalidate). Real QUIC client against a real media_moq_publisher_main process — no
# mocked network, no faked hashes: the expected content id is read from ARGV (the caller
# passes the SAME asset_cid the publisher's own announce prints to its stdout log), and a
# deliberately WRONG id is used for the mutation-test branch.
#
# Asserts, in order:
#   1. WebSceneMediaEsOpen succeeds against the real publisher.
#   2. WebSceneMediaEsAssetCid() returns exactly the expected (real, on-wire) content id.
#   3. WebSceneMediaEsContentMatches(expected) is true.
#   4. WebSceneMediaEsContentMatches(wrong) is false — mismatch correctly detected, not
#      silently accepted (the "不许赌缓存" requirement).
#   5. WebSceneMediaEsInvalidate() tears the stale open down; a FRESH WebSceneMediaEsOpen
#      against the SAME peer afterwards still succeeds and still reports the correct
#      content id — proves invalidation is recoverable (a real redial), not a dead end.
# Any failure prints a reason and exits nonzero; success prints "ALL OK" and exits 0.

import std/os
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge

@importc("cheng_host_es_diag")
fn cheng_host_es_diag(step: int32, a: int32, b: int32): void =
    return

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    var expectedRaw: str
    let hasExpected: bool = cmdline.ReadFirstFlagValue("--expected-cid", expectedRaw)
    if !hasExpected:
        return fail("missing --expected-cid")
    var wrongRaw: str
    let hasWrong: bool = cmdline.ReadFirstFlagValue("--wrong-cid", wrongRaw)
    if !hasWrong:
        return fail("missing --wrong-cid")

    # 1. Open against the real publisher.
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["initial es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    os.WriteLine(os.Get_stdout(), "step1_open_ok")

    # 2. The getter must return exactly the real on-wire content id.
    let gotCid: str = media_bridge.WebSceneMediaEsAssetCid()
    if gotCid != expectedRaw:
        return fail(strutil.Join(["asset_cid mismatch: got=", gotCid, " expected=", expectedRaw], ""))
    os.WriteLine(os.Get_stdout(), strutil.Join(["step2_asset_cid_ok cid=", gotCid], ""))

    # 3. Positive match.
    if !media_bridge.WebSceneMediaEsContentMatches(expectedRaw):
        return fail("ContentMatches(expected) returned false, want true")
    os.WriteLine(os.Get_stdout(), "step3_content_matches_true_ok")

    # 4. Mutation test: a wrong expectation must NOT match (no silent accept).
    if media_bridge.WebSceneMediaEsContentMatches(wrongRaw):
        return fail("ContentMatches(wrong) returned true — mismatch NOT detected (would silently serve wrong content)")
    os.WriteLine(os.Get_stdout(), "step4_content_mismatch_detected_ok")

    # 4b. Empty expectation must never match (no guessing on an unknown expectation).
    if media_bridge.WebSceneMediaEsContentMatches(""):
        return fail("ContentMatches(\"\") returned true — must never rubber-stamp an empty expectation")
    os.WriteLine(os.Get_stdout(), "step4b_empty_expectation_never_matches_ok")

    # 5. Invalidate, then prove a fresh open against the SAME peer still works and still
    # reports the correct content id (invalidation is a real, recoverable redial).
    media_bridge.WebSceneMediaEsInvalidate()
    if media_bridge.WebSceneMediaEsAssetCid() != "":
        return fail("asset_cid not cleared after invalidate")
    os.WriteLine(os.Get_stdout(), "step5a_invalidate_cleared_ok")
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        return fail(strutil.Join(["redial after invalidate failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
    let gotCid2: str = media_bridge.WebSceneMediaEsAssetCid()
    if gotCid2 != expectedRaw:
        return fail(strutil.Join(["asset_cid mismatch after redial: got=", gotCid2, " expected=", expectedRaw], ""))
    os.WriteLine(os.Get_stdout(), "step5b_redial_after_invalidate_ok")

    os.WriteLine(os.Get_stdout(), "ALL OK")
    return 0
