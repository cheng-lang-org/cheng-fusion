import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/validator

const
    Cid1: str = "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    Cid2: str = "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    Cid3: str = "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    Cid4: str = "sha256:4444444444444444444444444444444444444444444444444444444444444444"
    Cid5: str = "sha256:5555555555555555555555555555555555555555555555555555555555555555"
    Cid6: str = "sha256:6666666666666666666666666666666666666666666666666666666666666666"
    Cid7: str = "sha256:7777777777777777777777777777777777777777777777777777777777777777"
    Cid8: str = "sha256:8888888888888888888888888888888888888888888888888888888888888888"
    Cid9: str = "sha256:9999999999999999999999999999999999999999999999999999999999999999"
    CidA: str = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn replaceOnce(text: str, needle: str, replacement: str): str =
    if needle.len == 0 || needle.len > text.len:
        return ""
    var at: int32 = -1
    for i in 0..<(text.len - needle.len + 1):
        var matches = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matches = false
                break
        if matches:
            at = i
            break
    if at < 0:
        return ""
    let prefix = strings.SliceBytes(text, 0, at)
    let suffix =
        strings.SliceBytes(
            text,
            at + needle.len,
            text.len - at - needle.len)
    return strings.ConcatStr(
        strings.ConcatStr(prefix, replacement),
        suffix)

@borrows
fn subgraphFor(count: int32, dagRootCid: str): str =
    var error: str
    let root =
        merkle_dag.CsgCoreMerkleSubgraphCidForDagRoot(
            count, dagRootCid, error)
    if error.len > 0:
        return strings.ConcatStr(
            "invalid:", error)
    return root

fn setPartitionSubgraphCid(
        partitions: var merkle_manifest.CsgCoreMerklePartitionRecord[],
        index: int32,
        value: str) =
    partitions[index].factsRoot =
        strings.CloneStr(value)

@borrows
fn descriptor(
        shardKey: str,
        cid: str,
        root: str,
        entryCount: int32):
        merkle_manifest.CsgCoreMerkleShardDescriptor =
    var out: merkle_manifest.CsgCoreMerkleShardDescriptor
    out.shardKey = strings.CloneStr(shardKey)
    out.cid = strings.CloneStr(cid)
    out.root = strings.CloneStr(root)
    out.entryCount = entryCount
    return out

fn bucketName(bucket: int32): str =
    let digits = "0123456789abcdef"
    return strings.ConcatStr(
        strings.CloneStrRange(
            digits, bucket / 16, 1),
        strings.CloneStrRange(
            digits, bucket % 16, 1))

@borrows
fn partition(
        sourceId: str,
        sourceCid: str,
        factKind: str,
        factsCid: str,
        subgraphCid: str,
        dagRootCid: str,
        membershipCid: str,
        factCount: int32):
        merkle_manifest.CsgCoreMerklePartitionRecord =
    var out: merkle_manifest.CsgCoreMerklePartitionRecord
    out.sourceId = strings.CloneStr(sourceId)
    out.sourceCid = strings.CloneStr(sourceCid)
    out.factKind = strings.CloneStr(factKind)
    out.factsCid = strings.CloneStr(factsCid)
    out.factsRoot = strings.CloneStr(subgraphCid)
    out.dagRootCid = strings.CloneStr(dagRootCid)
    out.membershipCid =
        strings.CloneStr(membershipCid)
    out.factCount = factCount
    return out

@borrows
fn manifest(
        factsRoot: str,
        dagRootCid: str,
        reverse: bool):
        merkle_manifest.CsgCoreMerkleManifest =
    var out: merkle_manifest.CsgCoreMerkleManifest
    out.standard = validator.CsgCoreStandardIdentity()
    out.profiles = [validator.CsgCoreBaseProfileIdentity()]
    out.profileSetCid =
        validator.CsgCoreProfileSetCid(out.profiles)
    out.complete = true
    out.csgcDirectoryCid = Cid3
    out.csgcObjectCid = Cid4
    out.csgcByteCount = 64
    out.schemaCid = CidA
    out.factsRoot = strings.CloneStr(factsRoot)
    out.dagRootCid = strings.CloneStr(dagRootCid)
    out.factCount = 4
    out.nodeCount = 7
    let first = partition(
        "source:A",
        Cid1,
        "csg.core.schema",
        Cid2,
        subgraphFor(2, Cid4),
        Cid4,
        Cid5,
        2)
    let second = partition(
        "source:B",
        Cid2,
        "csg.symbol",
        Cid3,
        subgraphFor(2, Cid5),
        Cid5,
        Cid6,
        2)
    if reverse:
        add(out.partitions, second)
        add(out.partitions, first)
    else:
        add(out.partitions, first)
        add(out.partitions, second)
    out.partitionRoot =
        merkle_manifest.CsgCoreMerklePartitionRoot(
            out.partitions)
    add(
        out.dependencyConsumerShards,
        descriptor("source:A", Cid6, Cid7, 2))
    add(
        out.dependencyConsumerShards,
        descriptor("source:B", Cid7, Cid8, 2))
    out.dependencyConsumerRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
            out.dependencyConsumerShards)
    add(
        out.dependencyProviderShards,
        descriptor("source:A", Cid8, Cid9, 2))
    add(
        out.dependencyProviderShards,
        descriptor("source:B", Cid9, CidA, 2))
    out.dependencyProviderRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleDependencyProviderShardKind(),
            out.dependencyProviderShards)
    out.dependencyCount = 4
    for bucket in 0..<256:
        add(
            out.queryShards,
            descriptor(bucketName(bucket), Cid9, CidA, 0))
    out.queryShardRoot =
        merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
            merkle_manifest.CsgCoreMerkleQueryShardKind(),
            out.queryShards)
    out.queryIndexCount = 0
    out.summaryCid = Cid8
    return out

fn main(): int32 =
    if merkle_manifest.CsgCoreMerkleExpectedNodeCount(-1) != -1 ||
       merkle_manifest.CsgCoreMerkleExpectedNodeCount(0) != 0 ||
       merkle_manifest.CsgCoreMerkleExpectedNodeCount(1) != 1 ||
       merkle_manifest.CsgCoreMerkleExpectedNodeCount(
           1073741824) != 2147483647 ||
       merkle_manifest.CsgCoreMerkleExpectedNodeCount(
           1073741825) != -1:
        return fail("manifest node count overflow gate failed")
    os.WriteLine(os.Get_stderr(), "m1_gate")
    let schema = "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleA = "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let symbolA = "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let symbolB = "{\"id\":\"sym_b\",\"kind\":\"csg.symbol\",\"name\":\"B\",\"symbolKind\":\"fn\"}"
    let unboundDag = merkle_dag.CsgCoreMerkleBuild(
        [
            strings.CloneStr(schema),
            strings.CloneStr(moduleA),
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB)])
    if !unboundDag.ok ||
       unboundDag.factsRoot.len != 0:
        return fail("manifest fixture DAG failed")
    os.WriteLine(os.Get_stderr(), "m2_unbound")
    let dag = merkle_dag.CsgCoreMerkleBuildBound(
        [
            strings.CloneStr(schema),
            strings.CloneStr(moduleA),
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB)],
        "csg_core::v1",
        ["csg_core"],
        "csg_core::v1",
        CidA)
    let repeatedDag = merkle_dag.CsgCoreMerkleBuildBound(
        [
            strings.CloneStr(schema),
            strings.CloneStr(moduleA),
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB)],
        "csg_core::v1",
        ["csg_core"],
        "csg_core::v1",
        CidA)
    let webBoundDag = merkle_dag.CsgCoreMerkleBuildBound(
        [
            strings.CloneStr(schema),
            strings.CloneStr(moduleA),
            strings.CloneStr(symbolA),
            strings.CloneStr(symbolB)],
        "csg_core::v1",
        ["csg_core", "csg_dialect::web"],
        "csg_core::v1",
        CidA)
    if !dag.ok || !repeatedDag.ok || !webBoundDag.ok ||
       dag.factsRoot.len == 0 ||
       dag.factsRoot != repeatedDag.factsRoot ||
       dag.factsRoot == webBoundDag.factsRoot ||
       dag.dagRootCid != unboundDag.dagRootCid ||
       dag.dagRootCid != webBoundDag.dagRootCid ||
       dag.subgraphCid != unboundDag.subgraphCid:
        return fail("manifest profile-set root binding failed")

    os.WriteLine(os.Get_stderr(), "m3_bounddags")
    let currentProfileSetCid =
        validator.CsgCoreProfileSetCid(["csg_core"])
    let differentStandardProfileSetCid =
        validator.CsgCoreProfileSetCidForIdentity(
            "csg_core::different-standard",
            validator.CsgCoreSchemaNamespaceIdentity(),
            ["csg_core"])
    let differentNamespaceProfileSetCid =
        validator.CsgCoreProfileSetCidForIdentity(
            validator.CsgCoreStandardIdentity(),
            "csg_core::different-schema-namespace",
            ["csg_core"])
    if currentProfileSetCid.len != 71 ||
       differentStandardProfileSetCid.len != 71 ||
       differentNamespaceProfileSetCid.len != 71 ||
       currentProfileSetCid == differentStandardProfileSetCid ||
       currentProfileSetCid == differentNamespaceProfileSetCid:
        return fail(
            "profile_set_cid standard identity domain separation failed")

    os.WriteLine(os.Get_stderr(), "m4_profilecids")
    let firstManifest =
        manifest(
            dag.factsRoot,
            merkle_dag.CsgCoreMerkleDagRootCid(dag),
            false)
    os.WriteLine(os.Get_stderr(), "m5_manifest")
    let partitionDag =
        merkle_dag.CsgCoreMerkleBuild(
            [
                merkle_manifest.CsgCoreMerklePartitionLine(
                    firstManifest.partitions[0]),
                merkle_manifest.CsgCoreMerklePartitionLine(
                    firstManifest.partitions[1])
            ])
    if !partitionDag.ok ||
       firstManifest.partitionRoot !=
           partitionDag.subgraphCid:
        return fail(
            "manifest partition root is not subgraph cid")
    os.WriteLine(os.Get_stderr(), "m6_partition")
    let consumerDescriptorDag =
        merkle_dag.CsgCoreMerkleBuild(
            [
                merkle_manifest.CsgCoreMerkleShardDescriptorLine(
                    merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
                    firstManifest.dependencyConsumerShards[0]),
                merkle_manifest.CsgCoreMerkleShardDescriptorLine(
                    merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
                    firstManifest.dependencyConsumerShards[1])
            ])
    if !consumerDescriptorDag.ok ||
       firstManifest.dependencyConsumerRoot !=
           consumerDescriptorDag.subgraphCid:
        return fail(
            "manifest descriptor root is not subgraph cid")
    os.WriteLine(os.Get_stderr(), "m7_descriptor")
    var encoded =
        merkle_manifest.CsgCoreMerkleManifestEncode(
            firstManifest)
    if !encoded.ok:
        return fail(strings.ConcatStr(
            strings.ConcatStr(
                "manifest encode failed: ",
                encoded.error),
            strings.ConcatStr(
                " cid=", encoded.cid)))
    os.WriteLine(os.Get_stderr(), "m8_encoded")
    let decoded =
        merkle_manifest.CsgCoreMerkleManifestDecode(
            encoded.bytes)
    if !decoded.ok ||
       decoded.cid != encoded.cid ||
       decoded.manifest.standard !=
           validator.CsgCoreStandardIdentity() ||
       !validator.CsgCoreProfilesEqual(
           decoded.manifest.profiles,
           firstManifest.profiles) ||
       decoded.manifest.profileSetCid !=
           firstManifest.profileSetCid ||
       decoded.manifest.csgcDirectoryCid !=
           firstManifest.csgcDirectoryCid ||
       decoded.manifest.factsRoot !=
           dag.factsRoot ||
       decoded.manifest.factCount != 4 ||
       decoded.manifest.partitions.len != 2 ||
       decoded.manifest.nodeCount != 7:
        return fail(strings.ConcatStr(
            "manifest decode failed: ",
            decoded.error))

    os.WriteLine(os.Get_stdout(), "mani_p2 ok")
    return 0
