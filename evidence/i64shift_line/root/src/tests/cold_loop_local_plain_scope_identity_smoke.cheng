import std/bytes_layout as layout

type GateLoopPlainPair =
    left: int32
    right: int32

@borrows
fn GateLoopPlainPairWrite(
        value: var GateLoopPlainPair,
        index: int32) =
    value = GateLoopPlainPair(
        left: index,
        right: -index)

@borrows
fn GateLoopPlainPairObserve(value: GateLoopPlainPair): int32 =
    return value.left + value.right

@borrows
fn GateLoopPlainFixedWrite(
        value: var layout.FixedBytes32): bool =
    value = layout.FixedBytes32()
    return true

@borrows
fn GateLoopPlainFixedObserve(
        value: layout.FixedBytes32): bool =
    return layout.FixedBytes32Equal(value, value)

fn main(): int32 =
    var total: int32
    for index in 0..<4:
        var expectedProofCid: GateLoopPlainPair
        GateLoopPlainPairWrite(expectedProofCid, index)
        if GateLoopPlainPairObserve(expectedProofCid) != 0:
            return 1
        total = total + index
    if total != 6:
        return 2
    for index in 0..<4:
        var expectedProofCid: layout.FixedBytes32
        if !GateLoopPlainFixedWrite(expectedProofCid):
            return index + 3
        if index < 0 ||
           !GateLoopPlainFixedObserve(expectedProofCid):
            return index + 7
    return 0
