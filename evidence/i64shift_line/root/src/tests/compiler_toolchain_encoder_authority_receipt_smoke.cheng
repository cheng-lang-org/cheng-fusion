import std/os
import std/rawbytes as rawbytes
import std/result
import std/strutils as strutil
import cheng/core/tooling/compiler_execution_stage_receipt as receipt
import cheng/core/tooling/compiler_execution_stage_receipt_wire as wire
import cheng/std/bytes_layout as layout

fn AuthorityOwnedBytes(text: str): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(text.len)
    assert(rawbytes.BytesLen(out) == text.len,
           " toolchain encoder authority smoke: byte allocation")
    for index in 0..<text.len:
        rawbytes.BytesSet(out, index, Int32(text[index]) & 255)
    return out

fn AuthorityObservedCid(text: str): layout.FixedBytes32 =
    var observed = AuthorityOwnedBytes(text)
    defer:
        rawbytes.BytesFree(observed)
    let observedRes = receipt.CompilerExecutionIdentityObservedRaw32(observed)
    assert(IsOk(observedRes),
           " toolchain encoder authority smoke: observed CID")
    return Value(observedRes)

fn AuthorityBuildIdentity(
        caseId: str): receipt.CompilerExecutionIdentity =
    let identityRes = receipt.CompilerExecutionIdentityMake(
        caseId,
        AuthorityObservedCid("source-bundle:exact"),
        AuthorityObservedCid("materializer:exact"),
        AuthorityObservedCid("grammar-obligation:exact"),
        AuthorityObservedCid("compiler-source-closure:exact"),
        AuthorityObservedCid("driver:exact"),
        AuthorityObservedCid("toolchain-manifest:exact"),
        AuthorityObservedCid("command-manifest:exact"),
        "arm64-apple-darwin")
    assert(IsOk(identityRes),
           " toolchain encoder authority smoke: build identity")
    return Value(identityRes)

fn AuthorityBitFlip(value: layout.FixedBytes32): layout.FixedBytes32 =
    var out = layout.FixedBytes32Copy(value)
    out.data[0] = uint8(Int32(out.data[0]) ^ 1)
    return out

@borrows
fn AuthorityMake(
        identity: receipt.CompilerExecutionIdentity,
        producerRow: int32,
        canonicalRow: int32,
        modulePathTextId: int32,
        documentCid: layout.FixedBytes32,
        contentCid: layout.FixedBytes32):
        Result[receipt.CompilerToolchainEncoderAuthorityBuildProjectionReceipt] =
    return receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
        identity,
        AuthorityObservedCid("compiler-csg-artifact:exact"),
        AuthorityObservedCid("compiler-csg-graph:exact"),
        AuthorityObservedCid("compiler-csg-canonical-graph:exact"),
        AuthorityObservedCid("compiler-csg-source-bundle:exact"),
        AuthorityObservedCid("compiler-csg-cargo:exact"),
        AuthorityObservedCid("compiler-csg-facts-root:exact"),
        AuthorityObservedCid("compiler-csg-cargo-object-receipt:exact"),
        producerRow,
        canonicalRow,
        modulePathTextId,
        documentCid,
        contentCid)

@borrows
fn AuthorityWireExpected(
        value: receipt.CompilerToolchainEncoderAuthorityBuildProjectionReceipt): str =
    return strutil.Join([
        "{\"buildAuthorityCid\":\"",
        layout.FixedBytes32Hex(value.buildAuthorityCid),
        "\",\"canonicalRow\":9,\"compilerCsgArtifactCid\":\"",
        layout.FixedBytes32Hex(value.compilerCsgArtifactCid),
        "\",\"compilerCsgCanonicalGraphCid\":\"",
        layout.FixedBytes32Hex(value.compilerCsgCanonicalGraphCid),
        "\",\"compilerCsgCargoCid\":\"",
        layout.FixedBytes32Hex(value.compilerCsgCargoCid),
        "\",\"compilerCsgCargoObjectReceiptCid\":\"",
        layout.FixedBytes32Hex(value.compilerCsgCargoObjectReceiptCid),
        "\",\"compilerCsgFactsRootCid\":\"",
        layout.FixedBytes32Hex(value.compilerCsgFactsRootCid),
        "\",\"compilerCsgGraphCid\":\"",
        layout.FixedBytes32Hex(value.compilerCsgGraphCid),
        "\",\"compilerCsgSourceBundleCid\":\"",
        layout.FixedBytes32Hex(value.compilerCsgSourceBundleCid),
        "\",\"contentCid\":\"",
        layout.FixedBytes32Hex(value.contentCid),
        "\",\"documentCid\":\"",
        layout.FixedBytes32Hex(value.documentCid),
        "\",\"modulePathTextId\":41,\"producerRow\":17,\"projectionCid\":\"",
        layout.FixedBytes32Hex(value.projectionCid),
        "\",\"receiptCid\":\"",
        layout.FixedBytes32Hex(value.receiptCid),
        "\",\"schema\":\"cheng.compiler.toolchain_encoder_authority_build_projection_receipt\"}\n"
    ], "")

fn main(): int32 =
    let identity = AuthorityBuildIdentity("encoder-authority.focused.0001")
    let documentCid = AuthorityObservedCid("document:riscv64_encode.cheng")
    let contentCid = AuthorityObservedCid("content:riscv64_encode.cheng:exact")
    let makeRes = AuthorityMake(
        identity, 17, 9, 41, documentCid, contentCid)
    assert(IsOk(makeRes),
           " toolchain encoder authority smoke: make")
    let authority = Value(makeRes)
    assert(IsOk(
               receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerifyForBuild(
                   authority, identity)),
           " toolchain encoder authority smoke: verify")
    assert(!layout.FixedBytes32Equal(authority.projectionCid,
                                     authority.receiptCid),
           " toolchain encoder authority smoke: projection domain")

    var rowSwap = authority
    rowSwap.producerRow = authority.canonicalRow
    rowSwap.canonicalRow = authority.producerRow
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     rowSwap)),
           " toolchain encoder authority smoke: row swap accepted")
    let swappedRes = AuthorityMake(
        identity, 9, 17, 41, documentCid, contentCid)
    assert(IsOk(swappedRes),
           " toolchain encoder authority smoke: swapped make")
    let swapped = Value(swappedRes)
    assert(!layout.FixedBytes32Equal(swapped.projectionCid,
                                         authority.projectionCid) &&
               !layout.FixedBytes32Equal(swapped.receiptCid,
                                         authority.receiptCid),
           " toolchain encoder authority smoke: row order not bound")

    let otherDocumentCid = AuthorityObservedCid(
        "document:other-module-same-source-bytes")
    let otherModuleRes = AuthorityMake(
        identity, 17, 9, 42, otherDocumentCid, contentCid)
    assert(IsOk(otherModuleRes),
           " toolchain encoder authority smoke: other module make")
    let otherModule = Value(otherModuleRes)
    assert(layout.FixedBytes32Equal(otherModule.contentCid,
                                        authority.contentCid) &&
               !layout.FixedBytes32Equal(otherModule.projectionCid,
                                         authority.projectionCid) &&
               !layout.FixedBytes32Equal(otherModule.receiptCid,
                                         authority.receiptCid),
           " toolchain encoder authority smoke: module/document lineage not bound")
    var staleModule = authority
    staleModule.modulePathTextId = 42
    staleModule.documentCid = layout.FixedBytes32Copy(otherDocumentCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     staleModule)),
           " toolchain encoder authority smoke: stale module receipt accepted")

    let driftedContentCid = AuthorityObservedCid(
        "content:riscv64_encode.cheng:drifted")
    let contentDriftRes = AuthorityMake(
        identity, 17, 9, 41, documentCid, driftedContentCid)
    assert(IsOk(contentDriftRes),
           " toolchain encoder authority smoke: content drift make")
    let contentDrift = Value(contentDriftRes)
    assert(!layout.FixedBytes32Equal(contentDrift.projectionCid,
                                         authority.projectionCid) &&
               !layout.FixedBytes32Equal(contentDrift.receiptCid,
                                         authority.receiptCid),
           " toolchain encoder authority smoke: content drift not bound")

    var buildAttack = authority
    buildAttack.buildAuthorityCid = AuthorityBitFlip(
        authority.buildAuthorityCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     buildAttack)),
           " toolchain encoder authority smoke: build CID bitflip accepted")
    var artifactAttack = authority
    artifactAttack.compilerCsgArtifactCid = AuthorityBitFlip(
        authority.compilerCsgArtifactCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     artifactAttack)),
           " toolchain encoder authority smoke: artifact CID bitflip accepted")
    var graphAttack = authority
    graphAttack.compilerCsgGraphCid = AuthorityBitFlip(
        authority.compilerCsgGraphCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     graphAttack)),
           " toolchain encoder authority smoke: graph CID bitflip accepted")
    var canonicalGraphAttack = authority
    canonicalGraphAttack.compilerCsgCanonicalGraphCid = AuthorityBitFlip(
        authority.compilerCsgCanonicalGraphCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     canonicalGraphAttack)),
           " toolchain encoder authority smoke: canonical graph CID bitflip accepted")
    var bundleAttack = authority
    bundleAttack.compilerCsgSourceBundleCid = AuthorityBitFlip(
        authority.compilerCsgSourceBundleCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     bundleAttack)),
           " toolchain encoder authority smoke: bundle CID bitflip accepted")
    var cargoAttack = authority
    cargoAttack.compilerCsgCargoCid = AuthorityBitFlip(
        authority.compilerCsgCargoCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     cargoAttack)),
           " toolchain encoder authority smoke: cargo CID bitflip accepted")
    var factsAttack = authority
    factsAttack.compilerCsgFactsRootCid = AuthorityBitFlip(
        authority.compilerCsgFactsRootCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     factsAttack)),
           " toolchain encoder authority smoke: facts CID bitflip accepted")
    var documentAttack = authority
    documentAttack.documentCid = AuthorityBitFlip(authority.documentCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     documentAttack)),
           " toolchain encoder authority smoke: document CID bitflip accepted")
    var contentAttack = authority
    contentAttack.contentCid = AuthorityBitFlip(authority.contentCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     contentAttack)),
           " toolchain encoder authority smoke: content CID bitflip accepted")
    var projectionAttack = authority
    projectionAttack.projectionCid = AuthorityBitFlip(
        authority.projectionCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     projectionAttack)),
           " toolchain encoder authority smoke: projection CID bitflip accepted")
    var receiptAttack = authority
    receiptAttack.receiptCid = AuthorityBitFlip(authority.receiptCid)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     receiptAttack)),
           " toolchain encoder authority smoke: receipt CID bitflip accepted")

    var missing: receipt.CompilerToolchainEncoderAuthorityBuildProjectionReceipt
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     missing)),
           " toolchain encoder authority smoke: missing receipt accepted")
    var zero: layout.FixedBytes32
    var zeroBuild = authority
    zeroBuild.buildAuthorityCid = layout.FixedBytes32Copy(zero)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     zeroBuild)),
           " toolchain encoder authority smoke: zero build accepted")
    var zeroProjection = authority
    zeroProjection.projectionCid = layout.FixedBytes32Copy(zero)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     zeroProjection)),
           " toolchain encoder authority smoke: zero projection accepted")
    var zeroReceipt = authority
    zeroReceipt.receiptCid = layout.FixedBytes32Copy(zero)
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerify(
                     zeroReceipt)),
           " toolchain encoder authority smoke: zero receipt accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, zero, authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, 41, documentCid, contentCid)),
           " toolchain encoder authority smoke: zero artifact accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid, zero,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, 41, documentCid, contentCid)),
           " toolchain encoder authority smoke: zero graph accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid, zero,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, 41, documentCid, contentCid)),
           " toolchain encoder authority smoke: zero canonical graph accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid, zero,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, 41, documentCid, contentCid)),
           " toolchain encoder authority smoke: zero bundle accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid, zero,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, 41, documentCid, contentCid)),
           " toolchain encoder authority smoke: zero cargo accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid, zero,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, 41, documentCid, contentCid)),
           " toolchain encoder authority smoke: zero facts accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid, zero,
                     17, 9, 41, documentCid, contentCid)),
           " toolchain encoder authority smoke: zero Cargo object receipt accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, 41, zero, contentCid)),
           " toolchain encoder authority smoke: zero document accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, 41, documentCid, zero)),
           " toolchain encoder authority smoke: zero content accepted")
    assert(IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     -1, 9, 41, documentCid, contentCid)) &&
               IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, -1, 41, documentCid, contentCid)) &&
               IsErr(receipt.CompilerToolchainEncoderAuthorityBuildProjectionMake(
                     identity, authority.compilerCsgArtifactCid,
                     authority.compilerCsgGraphCid,
                     authority.compilerCsgCanonicalGraphCid,
                     authority.compilerCsgSourceBundleCid,
                     authority.compilerCsgCargoCid,
                     authority.compilerCsgFactsRootCid,
                     authority.compilerCsgCargoObjectReceiptCid,
                     17, 9, -1, documentCid, contentCid)),
           " toolchain encoder authority smoke: missing row accepted")

    let otherIdentity = AuthorityBuildIdentity(
        "encoder-authority.focused.0002")
    assert(IsErr(
               receipt.CompilerToolchainEncoderAuthorityBuildProjectionVerifyForBuild(
                   authority, otherIdentity)),
           " toolchain encoder authority smoke: foreign build accepted")

    assert(wire.CompilerToolchainEncoderAuthorityBuildProjectionWireFieldCount == 16,
           " toolchain encoder authority smoke: wire field count")
    let wireRes =
        wire.CompilerToolchainEncoderAuthorityBuildProjectionCanonicalJson(
            identity, authority)
    assert(IsOk(wireRes),
           " toolchain encoder authority smoke: wire")
    let wireText = Value(wireRes)
    let expectedWireText = AuthorityWireExpected(authority)
    assert(wireText == expectedWireText,
           " toolchain encoder authority smoke: wire schema/order")
    assert(IsErr(wire.CompilerToolchainEncoderAuthorityBuildProjectionCanonicalJson(
                     otherIdentity, authority)),
           " toolchain encoder authority smoke: foreign wire build accepted")

    os.WriteLine(os.GetStdout(),
                 "compiler_toolchain_encoder_authority_receipt_smoke=pass")
    return 0
