import std/os as os
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/oracle/oracle_types as oracle_types
import cheng/oracle/oracle_plane as oracle_plane
import cheng/core/csg_asset/oracle_asset as asset
import cheng/core/csg_core/validator as csg
import cheng/core/csg_core/csgc
import cheng/tests/oracle_smoke_support as support

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn smokeExpect(cond: bool, message: str): int32 =
    if !cond:
        return smokeFail(message)
    return 0

fn smokeBuildSignedBatches(roundId: int64): oracle_plane.OracleSignedBatch[] =
    var batches: oracle_plane.OracleSignedBatch[]
    for reporterSlot in 1..<6:
        add(batches, support.oracleSmokeBatch(roundId, reporterSlot))
    return batches

fn smokeReporterPubKeys(): layout.FixedBytes65[] =
    var pubKeys: layout.FixedBytes65[]
    for reporterSlot in 1..<8:
        add(pubKeys, support.oracleSmokePubKey(reporterSlot))
    return pubKeys

fn smokeObservationFromBatches(batches: oracle_plane.OracleSignedBatch[]): Result[asset.OracleAssetObservation] =
    let committee = support.oracleSmokeCommittee()
    return asset.OracleAssetObservationFromSignedPriceBatchesWithPubKeys(batches,
                                                                         committee.committeeSetId,
                                                                         committee.quorum,
                                                                         smokeReporterPubKeys(),
                                                                         oracle_types.OracleAssetBtc,
                                                                         oracle_types.OracleQuoteUsd,
                                                                         "oracle://cheng/mainnet/price/BTC-USD",
                                                                         int64(120000))

fn main(): int32 =
    let committee = support.oracleSmokeCommittee()
    let batches = smokeBuildSignedBatches(int64(30))
    var firstBatch = batches[0]
    let firstPubKey = support.oracleSmokePubKey(1)
    let directVerify = oracle_plane.OracleSignedBatchVerify(firstBatch, layout.FixedBytes65ToBytes(firstPubKey))
    if smokeExpect(directVerify.ok, "oracle signed asset observation: direct batch verify failed") != 0:
        os.WriteLine(os.Get_stderr(), directVerify.err.msg)
        return 1
    let observationRes = smokeObservationFromBatches(batches)
    if smokeExpect(observationRes.ok, "oracle signed asset observation: observation build failed") != 0:
        os.WriteLine(os.Get_stderr(), observationRes.err.msg)
        return 1
    let observation = observationRes.value
    if smokeExpect(observation.sourceKind == "oracle_signed_price_quorum",
                   "oracle signed asset observation: source kind mismatch") != 0:
        return 1
    if smokeExpect(observation.subjectId == asset.OracleAssetPriceSubjectId(oracle_types.OracleAssetBtc,
                                                                            oracle_types.OracleQuoteUsd),
                   "oracle signed asset observation: subject mismatch") != 0:
        return 1
    if smokeExpect(observation.reporterCount == int32(5),
                   "oracle signed asset observation: reporter count mismatch") != 0:
        return 1
    if smokeExpect(observation.quorum == committee.quorum,
                   "oracle signed asset observation: quorum mismatch") != 0:
        return 1
    if smokeExpect(asset.AssetHashLooksValid(observation.appHash),
                   "oracle signed asset observation: app hash invalid") != 0:
        return 1
    if smokeExpect(asset.AssetHashLooksValid(observation.valueHash),
                   "oracle signed asset observation: value hash invalid") != 0:
        return 1
    if smokeExpect(asset.AssetHashLooksValid(observation.receiptHash),
                   "oracle signed asset observation: receipt hash invalid") != 0:
        return 1

    let repeatedRes = smokeObservationFromBatches(batches)
    if smokeExpect(repeatedRes.ok, "oracle signed asset observation: repeated build failed") != 0:
        os.WriteLine(os.Get_stderr(), repeatedRes.err.msg)
        return 1
    if smokeExpect(repeatedRes.value.valueHash == observation.valueHash,
                   "oracle signed asset observation: value hash not deterministic") != 0:
        return 1
    if smokeExpect(repeatedRes.value.receiptHash == observation.receiptHash,
                   "oracle signed asset observation: receipt hash not deterministic") != 0:
        return 1

    let observationOk = asset.OracleAssetObservationValidate(observation,
                                                             observation.observedAtMs + int64(1))
    if smokeExpect(observationOk.ok, "oracle signed asset observation: validation failed") != 0:
        os.WriteLine(os.Get_stderr(), observationOk.err.msg)
        return 1

    var lines: str[]
    add(lines, "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\",\"oracle-asset\",\"oracle-signed-quorum\"]}")
    add(lines, asset.OracleAssetObservationFactJson(observation))
    let validation = csg.CsgCoreValidateFactLines(lines, csg.CsgCoreModeStrict)
    if smokeExpect(validation.valid, "oracle signed asset observation: CSG validation failed") != 0:
        os.WriteLine(os.Get_stderr(), csg.CsgCoreValidationReportJson(validation))
        return 1
    if smokeExpect(validation.complete, "oracle signed asset observation: CSG incomplete") != 0:
        return 1

    let encoded = asset.CsgAssetEncodeCsgc(lines)
    if smokeExpect(encoded.ok, "oracle signed asset observation: CSGC encode failed") != 0:
        os.WriteLine(os.Get_stderr(), encoded.error)
        return 1
    if smokeExpect(rawbytes.BytesLen(encoded.bytes) > 64, "oracle signed asset observation: empty CSGC") != 0:
        return 1
    let decoded = csgc.CsgCoreCsgcDecodeLines(encoded.bytes)
    if smokeExpect(decoded.ok, "oracle signed asset observation: CSGC decode failed") != 0:
        os.WriteLine(os.Get_stderr(), decoded.error)
        return 1
    if smokeExpect(asset.CsgAssetFactsRoot(decoded.lines) == asset.CsgAssetFactsRoot(lines),
                   "oracle signed asset observation: CSGC root mismatch") != 0:
        return 1

    var duplicateBatches: oracle_plane.OracleSignedBatch[]
    add(duplicateBatches, support.oracleSmokeBatch(int64(30), 1))
    add(duplicateBatches, support.oracleSmokeBatch(int64(30), 1))
    add(duplicateBatches, support.oracleSmokeBatch(int64(30), 2))
    add(duplicateBatches, support.oracleSmokeBatch(int64(30), 3))
    add(duplicateBatches, support.oracleSmokeBatch(int64(30), 4))
    let duplicateRes = smokeObservationFromBatches(duplicateBatches)
    if smokeExpect(!duplicateRes.ok, "oracle signed asset observation: duplicate reporter must fail") != 0:
        return 1

    var mixedRoundBatches: oracle_plane.OracleSignedBatch[]
    add(mixedRoundBatches, support.oracleSmokeBatch(int64(30), 1))
    add(mixedRoundBatches, support.oracleSmokeBatch(int64(30), 2))
    add(mixedRoundBatches, support.oracleSmokeBatch(int64(30), 3))
    add(mixedRoundBatches, support.oracleSmokeBatch(int64(30), 4))
    add(mixedRoundBatches, support.oracleSmokeBatch(int64(40), 5))
    let mixedRoundRes = smokeObservationFromBatches(mixedRoundBatches)
    if smokeExpect(!mixedRoundRes.ok, "oracle signed asset observation: mixed round must fail") != 0:
        return 1

    var shortBatches: oracle_plane.OracleSignedBatch[]
    add(shortBatches, support.oracleSmokeBatch(int64(30), 1))
    add(shortBatches, support.oracleSmokeBatch(int64(30), 2))
    add(shortBatches, support.oracleSmokeBatch(int64(30), 3))
    add(shortBatches, support.oracleSmokeBatch(int64(30), 4))
    let shortRes = smokeObservationFromBatches(shortBatches)
    if smokeExpect(!shortRes.ok, "oracle signed asset observation: missing quorum must fail") != 0:
        return 1

    os.WriteLine(os.Get_stdout(), "csg_oracle_signed_asset_observation_smoke ok")
    return 0
