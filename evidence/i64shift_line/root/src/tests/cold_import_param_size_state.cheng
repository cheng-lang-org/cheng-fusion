type
    ColdImportParamSizeRow =
        ok: bool
        id: str
        title: str
        cwd: str
        modelProvider: str
        source: str
        rolloutPath: str
        createdAtMs: int64
        updatedAtMs: int64
        cliVersion: str
        firstUserMessage: str
        error: str

fn ColdImportParamSizeMakeRow(): ColdImportParamSizeRow =
    var row: ColdImportParamSizeRow
    row.ok = true
    row.id = "thread-1"
    row.title = "demo thread"
    row.cwd = "/tmp/cold-import-param-size"
    row.modelProvider = "openai"
    row.source = "cli"
    row.rolloutPath = "/tmp/cold-import-param-size/thread.jsonl"
    row.createdAtMs = int64(1700000000000)
    row.updatedAtMs = int64(1700000001000)
    row.cliVersion = "0.1.0"
    row.firstUserMessage = "hello"
    return row
