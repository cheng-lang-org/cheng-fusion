# W3a criterion (d): live-capture cross-check against the incumbent msquic
# transport. Parses the archived pcap from this campaign's W5 harness leg
# (layer2_cross serve/fetch = T_PUBLISH + T_SERVE session, artifacts/
# msquic_layer2/layer2_en0.pcap) at the plaintext header-form layer:
# coalesced-datagram walk via the Length field, per-packet header form
# classification (Initial client/server, Handshake, 1-RTT, VN), version /
# token length / connection ID extraction, and 1-RTT short-header parse with
# the DCID length learned from the peer's Initial SCID.
#
# Frame sequences inside Initial/Handshake/1-RTT payloads are AEAD-protected
# on the wire: decoding them requires the packet protection keys, which is
# the W3b module's scope. The semantic tie to T_PUBLISH/T_SERVE is via the
# session receipts archived next to the pcap (fetch_rc=0, bytes=582340).
#
# Expected values are the ones recorded independently by the W5 lane in
# results/purept_w5.md; exit non-zero on any mismatch.

import std/os
import std/rawbytes
import std/result as result
import std/strings as strings
import cheng/quic/pure/frames_varint as quicvarint
import cheng/quic/pure/frames_header as quichdr

var gFails: int32

fn fail4(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("FAIL ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))
    gFails = gFails + 1

fn pass4(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))

@borrows
fn be16(b: Bytes, o: int32): int32 =
    return ((BytesGet(b, o) & 255) << 8) | (BytesGet(b, o + 1) & 255)

@borrows
fn le32(b: Bytes, o: int32): int32 =
    return (BytesGet(b, o) & 255) | ((BytesGet(b, o + 1) & 255) << 8) |
        ((BytesGet(b, o + 2) & 255) << 16) | ((BytesGet(b, o + 3) & 255) << 24)

fn main(): int32 =
    let openRes: Result[os.FileHandle] = os.OpenReadHandleResult(
        "docs/campaigns/2026-09-21-pure-cheng-transport/harness/artifacts/msquic_layer2/layer2_en0.pcap")
    if result.IsErr(openRes):
        fail4("pcap_open", "handle failed")
        return 1
    let handle: os.FileHandle = result.Value(openRes)
    var bytesRes: Result[rawbytes.Bytes] = os.ReadAllBytesResult(handle)
    if result.IsErr(bytesRes):
        fail4("pcap_read", "read failed")
        return 1
    var f: Bytes = BytesTake(bytesRes.value)
    let closRes: Result[bool] = os.CloseFileResult(handle)
    if result.IsErr(closRes):
        fail4("pcap_close", "close failed")
        return 1
    pass4("pcap_open", strings.concatStr("bytes=", strings.IntToStr(f.len)))

    # ---- global header: magic d4 c3 b2 a1 (little-endian on file), link 1 ----
    if f.len < 24:
        fail4("pcap_header", "too short")
        return 1
    if (BytesGet(f, 0) & 255) != 0xd4 || (BytesGet(f, 1) & 255) != 0xc3 ||
       (BytesGet(f, 2) & 255) != 0xb2 || (BytesGet(f, 3) & 255) != 0xa1:
        fail4("pcap_magic", "not d4c3b2a1")
        return 1
    let linktype: int32 = le32(f, 20)
    if linktype != 1:
        fail4("pcap_linktype", strings.IntToStr(linktype))
        return 1
    pass4("pcap_header", "magic=d4c3b2a1 linktype=1 (Ethernet, LE)")

    var records: int32
    var clientInitial: int32
    var serverInitial: int32
    var handshakeTotal: int32
    var handshakeClient: int32
    var handshakeServer: int32
    var oneRttClient: int32
    var oneRttServer: int32
    var vnCount: int32
    var retryCount: int32
    var nonIpUdp: int32
    var initialTotalOk: int32
    var longHeaderWalkErr: int32
    var shortParseErr: int32
    var versionsAll1: bool
    versionsAll1 = true
    var tokenLenAll0: bool
    tokenLenAll0 = true
    var firstDcid: Bytes = EmptyBytes()
    var firstScid: Bytes = EmptyBytes()
    var serverScid: Bytes = EmptyBytes()
    var clientOctet: int32
    var clientOctetSeen: bool
    clientOctetSeen = false

    var off: int32 = 24
    while off + 16 <= f.len:
        let incl: int32 = le32(f, off + 8)
        off = off + 16
        if incl < 0 || off + incl > f.len:
            fail4("pcap_record", "record overruns file")
            break
        let pkt: Bytes = BytesSliceView(f, off, incl)
        off = off + incl
        records = records + 1
        if incl < 34 || (be16(pkt, 12)) != 0x0800:
            nonIpUdp = nonIpUdp + 1
            continue
        let ip: int32 = 14
        if (BytesGet(pkt, ip) >> 4) != 4:
            nonIpUdp = nonIpUdp + 1
            continue
        let ihl: int32 = (BytesGet(pkt, ip) & 15) * 4
        if (BytesGet(pkt, ip + 9) & 255) != 17:
            nonIpUdp = nonIpUdp + 1
            continue
        let udp: int32 = ip + ihl
        let sport: int32 = be16(pkt, udp)
        let ulen: int32 = be16(pkt, udp + 4)
        if ulen < 9 || udp + ulen > incl:
            nonIpUdp = nonIpUdp + 1
            continue
        let q: Bytes = BytesSliceView(pkt, udp + 8, ulen - 8)
        if q.len < 1:
            nonIpUdp = nonIpUdp + 1
            continue
        # ---- coalesced-datagram walk (each packet parsed from a view at o) ----
        var o: int32
        while o < q.len:
            let b0: int32 = BytesGet(q, o) & 255
            if (b0 & 0x80) == 0:
                # short header = 1-RTT; fixed bit required
                if (b0 & 0x40) == 0:
                    fail4("walk", "fixed bit clear inside datagram")
                    break
                var isClient: bool
                if clientOctetSeen && (BytesGet(pkt, ip + 15) & 255) == clientOctet:
                    isClient = true
                else:
                    isClient = false
                var dcidLen: int32 = firstScid.len
                if isClient:
                    dcidLen = serverScid.len
                var hs: quichdr.QuicHeader = quichdr.QuicHeaderZero()
                let sv: Bytes = BytesSliceView(q, o, q.len - o)
                let sr: int32 = quichdr.QuicShortHeaderParse(sv, dcidLen, hs)
                if sr < 0:
                    shortParseErr = shortParseErr + 1
                else:
                    if isClient:
                        oneRttClient = oneRttClient + 1
                    else:
                        oneRttServer = oneRttServer + 1
                break
            # long header
            if (b0 & 0x40) == 0:
                fail4("walk", "long header fixed bit clear")
                break
            if q.len - o < 6:
                longHeaderWalkErr = longHeaderWalkErr + 1
                break
            var h: quichdr.QuicHeader = quichdr.QuicHeaderZero()
            let lv: Bytes = BytesSliceView(q, o, q.len - o)
            let consumed: int32 = quichdr.QuicHeaderParsePacket(lv, h)
            if consumed < 0:
                if consumed == -6:
                    retryCount = retryCount + 1
                    break
                longHeaderWalkErr = longHeaderWalkErr + 1
                break
            if h.isVn:
                vnCount = vnCount + 1
                break
            if h.version != quichdr.QuicVersion1:
                versionsAll1 = false
            if h.ptype == quichdr.QuicPktTypeInitial:
                let dcid: Bytes = BytesSliceView(lv, h.dcidOff, h.dcidLen)
                if !clientOctetSeen:
                    firstDcid = BytesSlice(dcid, 0, dcid.len)
                    var scidV: Bytes = BytesSliceView(lv, h.scidOff, h.scidLen)
                    firstScid = BytesSlice(scidV, 0, h.scidLen)
                    clientOctet = BytesGet(pkt, ip + 15) & 255
                    clientOctetSeen = true
                    clientInitial = clientInitial + 1
                else:
                    if BytesEqual(dcid, firstDcid):
                        clientInitial = clientInitial + 1
                    else:
                        serverInitial = serverInitial + 1
                        var scidV2: Bytes = BytesSliceView(lv, h.scidOff, h.scidLen)
                        serverScid = BytesSlice(scidV2, 0, h.scidLen)
                if h.tokenLen != 0:
                    tokenLenAll0 = false
                if consumed == lv.len:
                    initialTotalOk = initialTotalOk + 1
            else:
                if h.ptype == quichdr.QuicPktTypeHandshake:
                    handshakeTotal = handshakeTotal + 1
                    if clientOctetSeen && (BytesGet(pkt, ip + 15) & 255) == clientOctet:
                        handshakeClient = handshakeClient + 1
                    else:
                        handshakeServer = handshakeServer + 1
            o = o + consumed

    # ---- verdicts bound to the W5 lane's independently recorded analysis ----
    if records != 2137:
        fail4("records", strings.IntToStr(records))
    if clientInitial != 6:
        fail4("initial_client", strings.IntToStr(clientInitial))
    if serverInitial != 2:
        fail4("initial_server", strings.IntToStr(serverInitial))
    if handshakeTotal != 14:
        fail4("handshake_total", strings.IntToStr(handshakeTotal))
    if handshakeClient != 2 || handshakeServer != 12:
        fail4("handshake_dirs", strings.concatStr(strings.IntToStr(handshakeClient),
            strings.concatStr("/", strings.IntToStr(handshakeServer))))
    if oneRttClient != 1056:
        fail4("onertt_client", strings.IntToStr(oneRttClient))
    if oneRttServer != 1059:
        fail4("onertt_server", strings.IntToStr(oneRttServer))
    if vnCount != 0:
        fail4("vn_zero", strings.IntToStr(vnCount))
    if retryCount != 0:
        fail4("retry_zero", strings.IntToStr(retryCount))
    if initialTotalOk != clientInitial + serverInitial:
        fail4("initial_length_walk", strings.IntToStr(initialTotalOk))
    if longHeaderWalkErr != 0 || shortParseErr != 0:
        fail4("walk_errors", strings.concatStr(strings.IntToStr(longHeaderWalkErr),
            strings.concatStr("/", strings.IntToStr(shortParseErr))))
    if !versionsAll1:
        fail4("versions", "non-v1 long header seen")
    if !tokenLenAll0:
        fail4("token_len", "nonzero Initial token seen")
    if !BytesEqual(BytesSliceView(firstDcid, 0, 8), BytesFromHex("0000000022222232")):
        fail4("first_dcid_prefix", BytesToHex(firstDcid))

    pass4("walk_sanity", strings.concatStr(strings.IntToStr(nonIpUdp),
        strings.concatStr(" nonIpUdp, walkErr=", strings.concatStr(strings.IntToStr(longHeaderWalkErr),
        strings.concatStr(" shortErr=", strings.IntToStr(shortParseErr))))))
    pass4("counts", strings.concatStr(strings.concatStr("records=",
        strings.IntToStr(records)),
        strings.concatStr(strings.concatStr(" initial=", strings.IntToStr(clientInitial)),
        strings.concatStr(strings.concatStr("c/", strings.IntToStr(serverInitial)),
        strings.concatStr(strings.concatStr(" hs=", strings.IntToStr(handshakeTotal)),
        strings.concatStr(strings.concatStr(" 1rtt=", strings.IntToStr(oneRttClient)),
        strings.concatStr(strings.concatStr("c/", strings.IntToStr(oneRttServer)),
        strings.concatStr(" vn=", strings.IntToStr(vnCount)))))))))
    pass4("first_client_dcid", BytesToHex(firstDcid))
    pass4("first_client_scid", strings.concatStr(BytesToHex(firstScid),
        strings.concatStr(" server_scid=", BytesToHex(serverScid))))
    pass4("initial_length_walk", strings.concatStr(strings.IntToStr(initialTotalOk),
        strings.concatStr("/", strings.concatStr(strings.IntToStr(clientInitial + serverInitial),
        " Initial datagrams: Length field consumed == UDP payload"))))

    if gFails != 0:
        os.WriteLine(os.Get_stdout(), strings.concatStr("W3A-LIVECAP RESULT: FAIL count=",
            strings.IntToStr(gFails)))
        return 1
    os.WriteLine(os.Get_stdout(), "W3A-LIVECAP RESULT: PASS")
    return 0
