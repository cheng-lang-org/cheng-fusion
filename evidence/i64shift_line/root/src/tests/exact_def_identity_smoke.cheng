    body.exactDef.slotOriginIds[slotId] = originRow

# ⑥ borrowed_plain_snapshot_edge: 字面量根 → 整值借视 (SHARED,
# borrow-owner=根) → CopyLocal 绑定 (PLAIN)。
fn buildBorrowedSnapshotBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let slot0 = addArr4Slot(body, "a1")
    let slot1 = addArr4Slot(body, "view")
    let slot2 = addArr4Slot(body, "local")
    let opLit = newDefOp(
        body, coreir.BodyOpLoadConstTag, slot0, 100, coreir.OwnPlain)
    add(body.ops[opLit].operands, coreir.LocalAggregateTag)
    let opView = newDefOp(
        body, coreir.BodyOpCopyLocalTag, slot1, 101,
        coreir.OwnBorrowShared)
    add(body.ops[opView].operands, slot0)
    body.ops[opView].valueDefBorrowOwnerSemanticRow = 100
    body.ops[opView].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opView].valueDefBorrowOwnerDefinitionRow = opLit
    let opBind = newDefOp(
        body, coreir.BodyOpCopyLocalTag, slot2, 102, coreir.OwnPlain)
    add(body.ops[opBind].operands, slot1)
    body.ops[opBind].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opBind].sourceDefinitionRow = opView
    sealSingleBlock(body, slot2)
    return body

fn borrowedSnapshotTransport(originKinds: var int32[],
                             exactTypeIds: var int32[]) =
    add(originKinds, 2)
    add(originKinds, 2)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeArr4)
    add(exactTypeIds, fixtureTypeArr4)
    add(exactTypeIds, fixtureTypeArr4)

# ⑦ 投影帧自有承认: rec 字面量根 (帧自有: STACK_LOCAL+PLAIN+
# origin==slot) → FieldLoad 字段借视 (SHARED retain)。
fn buildFrameOwnedProjectionBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let recSlot = addRecSlot(body, "obj")
    let fieldSlot = addStrSlot(body, "field")
    let opRoot = newDefOp(
        body, coreir.BodyOpLoadConstTag, recSlot, 100, coreir.OwnPlain)
    add(body.ops[opRoot].operands, coreir.LocalAggregateTag)
    let opProj = newDefOp(
        body, coreir.BodyOpFieldLoadTag, fieldSlot, 101,
        coreir.OwnBorrowShared)
    add(body.ops[opProj].operands, recSlot)
    add(body.ops[opProj].operands, fieldSlot)
    add(body.ops[opProj].operands, 0)
    add(body.ops[opProj].operands, 24)
    body.ops[opProj].valueDefBorrowOwnerSemanticRow = 100
    body.ops[opProj].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opProj].valueDefBorrowOwnerDefinitionRow = opRoot
    sealSingleBlock(body, fieldSlot)
    return body

fn frameOwnedProjectionTransport(originKinds: var int32[],
                                 exactTypeIds: var int32[]) =
    add(originKinds, 2)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeRec)
    add(exactTypeIds, fixtureTypeStr)

# ⑧ PARAM 臂四析取: i32 PLAIN / str MOVE / str SHARED / ptr UNIQUE(var)。
fn buildParamEffectsBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let p0 = addI32Slot(body, "p0")
    let p1 = addStrSlot(body, "p1")
    let p2 = addStrSlot(body, "p2")
    let p3 = addBoundSlot(
        body, "p3", coreir.LocalPtrTag, fixtureTypeRefRec,
        coreir.BodyManagedStorageManagedTag, 8, 8)
    for ordinal in 0..<4:
        body.localSlots[ordinal].stackOffset = -1 - ordinal
        coreir.BodyIRBindEntryParameterSlot(body, ordinal, ordinal)
    var entry: int32[]
    add(entry, Int32(coreir.OwnPlain))
    add(entry, Int32(coreir.OwnMove))
    add(entry, Int32(coreir.OwnBorrowShared))
    add(entry, Int32(coreir.OwnBorrowUnique))
    freezeEntryOwnership(body, entry)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, p0, 100, coreir.OwnPlain)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, p1, 101, coreir.OwnMove)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, p2, 102,
        coreir.OwnBorrowShared)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, p3, 103,
        coreir.OwnBorrowUnique)
    sealSingleBlock(body, p0)
    return body

fn paramEffectsTransport(originKinds: var int32[],
                         exactTypeIds: var int32[]) =
    add(originKinds, 1)
    add(originKinds, 1)
    add(originKinds, 1)
    add(originKinds, 1)
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeRefRec)

# ⑨ GLOBAL 臂: GlobalLoad 值定义 (戳 poke 到 GLOBAL place, origin=
# 全局地址槽)。
fn buildGlobalArmBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    var addrSlot: coreir.LocalSlot
    let addrId = body.localSlots.len
    addrSlot.id = addrId
    addrSlot.name = "g_addr"
    addrSlot.typeKind = coreir.LocalI64Tag
    addrSlot.stackOffset = 0
    addrSlot.sizeBytes = 8
    addrSlot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(addrSlot)
    add(body.localSlots, addrSlot)
    body.localSlots[addrId].placeKind = coreir.BodyPlaceGlobalAddressTag
    let valueSlot = addI64Slot(body, "g_value")
    let opLoad = newDefOp(
        body, coreir.BodyOpGlobalLoadTag, valueSlot, 100, coreir.OwnMove)
    add(body.ops[opLoad].operands, addrId)
    sealSingleBlock(body, valueSlot)
    return body

fn globalArmTransport(originKinds: var int32[],
                      exactTypeIds: var int32[]) =
    add(originKinds, 4)
    add(exactTypeIds, fixtureTypeI64)

fn pokeGlobalLane(body: var coreir.BodyIR,
                  opRow: int32,
                  slotId: int32,
                  addrSlot: int32) =
    body.ops[opRow].valueDefOwnership = coreir.OwnBorrowShared
    body.exactDef.opPlaceKinds[opRow] =
        exactdef.BodyIrExactDefPlaceGlobalTag
    body.exactDef.opOriginIds[opRow] = addrSlot
    body.exactDef.slotPlaceKinds[slotId] =
        exactdef.BodyIrExactDefPlaceGlobalTag
    body.exactDef.slotOriginIds[slotId] = addrSlot

# ---- 负例腿构建器 ----

# 断链: 参数根 (SHARED) → CopyLocal 绑定 (MOVE) — 六臂皆假。
fn buildChainBrokenBody(): coreir.BodyIR =
    var body = buildBorrowEdgeBody()
    body.ops[1].valueDefOwnership = coreir.OwnMove
    return body

# CSR consume (记录戳参数化; 与批 2 腿①同形)。
fn buildCsrConsumeBody(recordedPlusOne: int32): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let paramStr = addStrSlot(body, "text")
    body.localSlots[paramStr].stackOffset = -1
    let callStr = addStrSlot(body, "call_str")
    coreir.BodyIRBindEntryParameterSlot(body, 0, paramStr)
    var entry: int32[]
    add(entry, Int32(coreir.OwnMove))
    freezeEntryOwnership(body, entry)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 100, coreir.OwnMove)
    var call0: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call0)
    call0.targetSymbol = "exact_def_identity_fixture_make_str"
    call0.resultSlot = callStr
    call0.resultOwnership = coreir.OwnMove
    call0.resultExprNodeIndex = 101
    call0.resultValueDefinitionRow = 101
    call0.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call0.resultDefinitionOriginId = 101
    add(body.callSequence, call0)
    let opCall = newDefOp(
        body, coreir.BodyOpCallTag, callStr, 101, coreir.OwnMove)
    add(body.ops[opCall].operands, 0)
    var call1: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call1)
    call1.targetSymbol = "exact_def_identity_fixture_take_str"
    call1.resultSlot = -1
    add(call1.argSlots, callStr)
    add(call1.argPassKinds, coreir.BodyCallPassStackValueTag)
    add(body.callSequence, call1)
    var consumeOp: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(consumeOp)
    consumeOp.kind = coreir.BodyOpCallTag
    consumeOp.target = -1
    add(consumeOp.operands, 1)
    let _ = coreir.BodyIRAppendOp(body, consumeOp)
    body.ops[opCall].valueDefConsumeOpIndexPlusOne = recordedPlusOne
    let termIndex = newRetTerm(body, paramStr)
    let _ = appendBlock(body, 0, body.ops.len, termIndex)
    beginControl(body, 1)
    var successors: int32[]
    var edgeKinds: int32[]
    bindSuccessors(body, termIndex, successors, edgeKinds)
    appendCallTarget(body, 0)
    appendCallTarget(body, 1)
    sealControlFlow(body)
    return body

fn csrConsumeTransport(originKinds: var int32[],
                       exactTypeIds: var int32[]) =
    add(originKinds, 1)
    add(originKinds, 3)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# 顺序块非互斥双消费 (与批 2 腿⑥同形)。
fn buildMutexNegativeBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let tmp0 = addStrSlot(body, "tmp0")
    let tmp1 = addStrSlot(body, "tmp1")
    let tmp2 = addStrSlot(body, "tmp2")
    let opDef = newDefOp(
        body, coreir.BodyOpLoadConstTag, tmp0, 100, coreir.OwnMove)
    add(body.ops[opDef].operands, coreir.LocalStrTag)
    let term0 = newBrTerm(body, 1)
    let opFirst = newDefOp(
        body, coreir.BodyOpCopyLocalTag, tmp1, 101, coreir.OwnMove)
    add(body.ops[opFirst].operands, tmp0)
    body.ops[opFirst].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opFirst].sourceDefinitionRow = opDef
    let term1 = newBrTerm(body, 2)
    let opSecond = newDefOp(
        body, coreir.BodyOpCopyLocalTag, tmp2, 102, coreir.OwnMove)
    add(body.ops[opSecond].operands, tmp0)
    body.ops[opSecond].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opSecond].sourceDefinitionRow = opDef
    body.ops[opDef].valueDefConsumeOpIndexPlusOne = opFirst + 1
    let term2 = newRetTerm(body, tmp0)
    let _ = appendBlock(body, 0, 1, term0)
    let _ = appendBlock(body, 1, 1, term1)
    let _ = appendBlock(body, 2, 1, term2)
    beginControl(body, 3)
    var succ0: int32[]
    add(succ0, 1)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    var kind2: int32[]
    bindSuccessors(body, term2, succ2, kind2)
    sealControlFlow(body)
    return body

fn mutexNegativeTransport(originKinds: var int32[],
                          exactTypeIds: var int32[]) =
    add(originKinds, 4)
    add(originKinds, 2)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# 槽终校验腿基体: op0=消费者 (CopyLocal, 戳 poke 到 STACK_LOCAL),
# op1=视图位源 (裸行 poke 成 CFG_MERGE place 定义), 随后按腿追加
# 腐败写者。operand 槽 = 未绑 nominal 聚合 (sentinel, read-edge 不
# required)。
const
    terminalModeDrift = 0
    terminalModeNoSidecar = 1
    terminalModeNoDominating = 2

fn buildTerminalBody(mode: int32): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let scratch = addUnboundAggregateSlot(body, "scratch")
    let localStr = addStrSlot(body, "local_str")
    let opConsumer = newDefOp(
        body, coreir.BodyOpCopyLocalTag, localStr, 100, coreir.OwnMove)
    add(body.ops[opConsumer].operands, scratch)
    let opView = newBareOp(body, coreir.BodyOpLoadConstTag, -1)
    add(body.ops[opView].operands, coreir.LocalI32Tag)
    body.ops[opConsumer].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opConsumer].sourceDefinitionRow = opView
    if mode == terminalModeDrift:
        let _ = newBareOp(body, coreir.BodyOpStoreLocalTag, scratch)
    elif mode == terminalModeNoSidecar:
        let _ = newBareOp(body, coreir.BodyOpStoreLocalTag, scratch)
    sealSingleBlock(body, localStr)
    return body

fn terminalTransport(originKinds: var int32[],
                     exactTypeIds: var int32[]) =
    add(originKinds, 4)
    add(exactTypeIds, fixtureTypeStr)

# 消费者/视图位/腐败写者戳 poke。
fn pokeTerminalLanes(body: var coreir.BodyIR, mode: int32) =
    let scratch = 0
    let localStr = 1
    # 消费者: TEMPORARY→STACK_LOCAL (origin==槽)。
    body.exactDef.opPlaceKinds[0] =
        exactdef.BodyIrExactDefPlaceStackLocalTag
    body.exactDef.opOriginIds[0] = localStr
    body.exactDef.slotPlaceKinds[localStr] =
        exactdef.BodyIrExactDefPlaceStackLocalTag
    body.exactDef.slotOriginIds[localStr] = localStr
    # 视图位源: 裸行 poke 成 CFG_MERGE place 的 str 定义 (own PLAIN)。
    body.ops[1].valueDefSlot = scratch
    body.ops[1].valueDefSemanticRow = 100
    body.ops[1].valueDefOwnership = coreir.OwnPlain
    body.ops[1].valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    body.ops[1].valueDefOriginId = 100
    body.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceCfgMergeTag
    body.exactDef.opExactTypeIds[1] = fixtureTypeStr
    body.exactDef.opOriginIds[1] = 1
    body.exactDef.opProducerFunctionRows[1] = 0
    body.ops[1].valueDefConsumeOpIndexPlusOne = 1
    if mode == terminalModeDrift:
        # 腐败写者: 物理写 scratch 且持侧车, exactType 漂移 999。
        body.ops[2].valueDefSlot = scratch
        body.ops[2].valueDefSemanticRow = 100
        body.ops[2].valueDefOwnership = coreir.OwnPlain
        body.ops[2].valueDefOriginKind =
            coreir.BodyDefinitionOriginTypedExprTag
        body.ops[2].valueDefOriginId = 100
        body.exactDef.opPlaceKinds[2] =
            exactdef.BodyIrExactDefPlaceTemporaryTag
        body.exactDef.opExactTypeIds[2] = 999
        body.exactDef.opOriginIds[2] = 2
        body.exactDef.opProducerFunctionRows[2] = 0

