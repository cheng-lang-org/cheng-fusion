fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var mode = "unit"
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "":
        mode = "unit"
    if mode == "unit":
        return runUnit()
    if mode == "verdict-source-chain":
        return runVerdictSourceChain()
    if mode == "verdict-partial-tuple":
        return runVerdictPartialTuple()
    if mode == "verdict-storage-clause":
        return runVerdictStorageClause()
    if mode == "verdict-projection-21":
        return runVerdictProjection21()
    if mode == "verdict-op712":
        return runVerdictOp712()
    if mode == "verdict-audit-broken":
        return runVerdictAuditBroken()
    if mode == "verdict-audit-invalid-path":
        return runVerdictAuditInvalidPath()
    if mode == "verdict-param-broken":
        return runVerdictParamBroken()
    if mode == "verdict-param-effect":
        return runVerdictParamEffect()
    if mode == "verdict-terminal-drift":
        return runVerdictTerminalDrift()
    if mode == "verdict-terminal-nosidecar":
        return runVerdictTerminalNoSidecar()
    if mode == "verdict-terminal-nodominating":
        return runVerdictTerminalNoDominating()
    if mode == "verdict-block-outside":
        return runVerdictBlockOutside()
    if mode == "verdict-block-overlap":
        return runVerdictBlockOverlap()
    if mode == "verdict-block-orphan":
        return runVerdictBlockOrphan()
    if mode == "verdict-slot-partial-authority":
        return runVerdictSlotPartialAuthority()
    if mode == "verdict-slot-count":
        return runVerdictSlotCount()
    if mode == "verdict-bind-broken":
        return runVerdictBindBroken()
    if mode == "verdict-root-broken":
        return runVerdictRootBroken()
    if mode == "verdict-global-broken":
        return runVerdictGlobalBroken()
    if mode == "verdict-shared-copy-broken":
        return runVerdictSharedCopyBroken()
    if mode == "verdict-copy-source":
        return runVerdictCopySource()
    if mode == "verdict-consume-only":
        return runVerdictConsumeOnly()
    os.WriteLine(os.Get_stdout(), Fmt"unknown mode: {mode}")
    return 2
