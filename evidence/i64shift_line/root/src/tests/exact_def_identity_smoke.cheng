# 块区间腿基体 (两块)。
fn buildBlockBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let slot0 = addStrSlot(body, "s0")
    let slot1 = addStrSlot(body, "s1")
    let opLit = newDefOp(
        body, coreir.BodyOpLoadConstTag, slot0, 100, coreir.OwnPlain)
    add(body.ops[opLit].operands, coreir.LocalStrTag)
    let term0 = newBrTerm(body, 1)
    let opBind = newDefOp(
        body, coreir.BodyOpCopyLocalTag, slot1, 101, coreir.OwnPlain)
    add(body.ops[opBind].operands, slot0)
    body.ops[opBind].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opBind].sourceDefinitionRow = opLit
    body.ops[opLit].valueDefConsumeOpIndexPlusOne = opBind + 1
    let term1 = newRetTerm(body, slot1)
    let _ = appendBlock(body, 0, 1, term0)
    let _ = appendBlock(body, 1, 1, term1)
    beginControl(body, 2)
    var succ0: int32[]
    add(succ0, 1)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    var kind1: int32[]
    bindSuccessors(body, term1, succ1, kind1)
    sealControlFlow(body)
    return body

fn blockBodyTransport(originKinds: var int32[],
                      exactTypeIds: var int32[]) =
    add(originKinds, 2)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)


# ---- 运行腿 ----

fn runUnit(): int32 =
    let window = buildWindow()
    var originKinds: int32[]
    var exactTypeIds: int32[]
    # ① move_edge。
    moveEdgeTransport(originKinds, exactTypeIds)
    var body1 = buildMoveEdgeBody()
    deriveFixture(body1, originKinds, exactTypeIds, window)
    smokeAssert(validateComposed(body1), "identity smoke: leg1 move edge")
    # ② borrow_edge。
    originKinds = []
    exactTypeIds = []
    borrowEdgeTransport(originKinds, exactTypeIds)
    var body2 = buildBorrowEdgeBody()
    deriveFixture(body2, originKinds, exactTypeIds, window)
    smokeAssert(validateComposed(body2),
                "identity smoke: leg2 borrow edge")
    # ③ plain_static_string_edge。
    originKinds = []
    exactTypeIds = []
    staticStringTransport(originKinds, exactTypeIds)
    var body3 = buildStaticStringBody()
    deriveFixture(body3, originKinds, exactTypeIds, window)
    smokeAssert(validateComposed(body3),
                "identity smoke: leg3 plain static string edge")
    # ④ plain_copy_edge (定长数组独立道)。
    originKinds = []
    exactTypeIds = []
    plainCopyTransport(originKinds, exactTypeIds)
    var body4 = buildPlainCopyBody()
    deriveFixture(body4, originKinds, exactTypeIds, window)
    smokeAssert(validateComposed(body4),
                "identity smoke: leg4 plain copy edge")
    # ⑤ plain_shared_copy_edge (SHARED_COPY 戳 poke)。
    originKinds = []
    exactTypeIds = []
    sharedCopyTransport(originKinds, exactTypeIds)
    var body5 = buildSharedCopyBody()
    deriveFixture(body5, originKinds, exactTypeIds, window)
    pokeSharedCopyLane(body5, 1, 1, 0)
    smokeAssert(validateComposed(body5),
                "identity smoke: leg5 plain shared-copy edge")
    # ⑥ borrowed_plain_snapshot_edge。
    originKinds = []
    exactTypeIds = []
    borrowedSnapshotTransport(originKinds, exactTypeIds)
    var body6 = buildBorrowedSnapshotBody()
    deriveFixture(body6, originKinds, exactTypeIds, window)
    smokeAssert(validateComposed(body6),
                "identity smoke: leg6 borrowed plain snapshot edge")
    # ⑦ 投影帧自有承认 (BORROW_SHARED retain, 帧自有根)。
    originKinds = []
    exactTypeIds = []
    frameOwnedProjectionTransport(originKinds, exactTypeIds)
    var body7 = buildFrameOwnedProjectionBody()
    deriveFixture(body7, originKinds, exactTypeIds, window)
    smokeAssert(body7.exactDef.opPlaceKinds[1] ==
                    exactdef.BodyIrExactDefPlaceBorrowProjectionTag,
                "identity smoke: leg7 projection lane")
    smokeAssert(validateComposed(body7),
                "identity smoke: leg7 frame-owned projection")
    # ⑧ PARAM 臂四析取。
    originKinds = []
    exactTypeIds = []
    paramEffectsTransport(originKinds, exactTypeIds)
    var body8 = buildParamEffectsBody()
    deriveFixture(body8, originKinds, exactTypeIds, window)
    smokeAssert(validateComposed(body8),
                "identity smoke: leg8 param effects")
    # ⑨ GLOBAL 臂 (戳 poke)。
    originKinds = []
    exactTypeIds = []
    globalArmTransport(originKinds, exactTypeIds)
    var body9 = buildGlobalArmBody()
    deriveFixture(body9, originKinds, exactTypeIds, window)
    pokeGlobalLane(body9, 0, 1, 0)
    smokeAssert(validateComposed(body9), "identity smoke: leg9 global arm")
    # ⑩ 判词构建器文本断言。
    let summaryLine =
        identity.ExactDefIdentityTestResultSummaryMissingLine("freeze")
    smokeAssert(summaryLine ==
                    "cheng_cold: exact identity schema [freeze] function result ownership summary missing",
                "identity smoke: result summary verdict text")
    let columnsLine =
        identity.ExactDefIdentityTestColumnsMissingLine("freeze", "op")
    smokeAssert(columnsLine ==
                    "cheng_cold: exact identity schema [freeze] op columns missing",
                "identity smoke: columns verdict text")
    let gateLine = identity.ExactDefIdentityTestReadEdgesGateLine("freeze")
    smokeAssert(gateLine ==
                    "cheng_cold: exact identity schema [freeze] managed direct-read edges are incomplete or non-canonical",
                "identity smoke: read-edge gate verdict text")
    let tupleLine = identity.ExactDefIdentityTestPartialDefinitionTupleLine(
        "freeze", 0, 7, 4, 1, 0, 0, 2, 1, -1, 0, 9, 9, 4, 3, -1, -1)
    smokeAssert(tupleLine ==
                    "cheng_cold: exact identity schema [freeze] fn=0 op row=7 has partial definition tuple slot=4 exact_type=1 producer=0 body_producer=0 place=2 ownership=1 origin=-1 consume_plus_one=0 op_count=9 kind=9 dst=4 a=3 b=-1 c=-1",
                "identity smoke: partial tuple verdict text")
    os.WriteLine(os.Get_stdout(), "EXACT_DEF_IDENTITY_UNIT_OK")
    return 0

fn runVerdictSourceChain(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    borrowEdgeTransport(originKinds, exactTypeIds)
    var body = buildChainBrokenBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validateComposed(body):
        return 1
    return 2

