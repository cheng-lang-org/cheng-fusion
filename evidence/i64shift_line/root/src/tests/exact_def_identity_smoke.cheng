# exact_def_identity_smoke — ExactDef 批 3 单元验证: identity schema
# 主审 + 投影权威。spec: docs/cheng-exact-def-rewrite-design.md §4 批 3
# + docs/cheng-exact-def-batch3-identity-spec.md。
#
# 合成 BodyIR 全部经真实构建路径构造 (coreir 构建/绑定/冻结 API +
# 批 1 derive + 批 2 freeze 基元 + 批 3 identity), 零 Mock; consume 戳
# 由夹具按 cleanup 物化语义手工落 (与批 2 smoke 同形); 侧车戳 poke
# 仅用于 derive 无落戳车道的 place (SHARED_COPY/GLOBAL/CFG_MERGE 视图
# 位/参数根), 与批 2 夹具戳 poke 同例。
#
# 模式 (argv[1], 缺省 unit):
#   unit                    — 正例全绿 (rc=0, EXACT_DEF_IDENTITY_UNIT_OK):
#     ① move_edge ② borrow_edge ③ plain_static_string_edge
#     ④ plain_copy_edge (定长数组独立道) ⑤ plain_shared_copy_edge
#     ⑥ borrowed_plain_snapshot_edge ⑦ 投影帧自有承认 (rec 字段
#       借视, BORROW_SHARED retain) ⑧ PARAM 臂四析取 (PLAIN/MOVE/
#       SHARED/UNIQUE-var) ⑨ GLOBAL 臂正例 (poke 戳) ⑩ 判词文本
#       构建器断言 (入口门/列门/read-edge 总门/partial tuple 全字段)。
#   verdict-source-chain    — 六臂皆假断链 → `source chain is broken`
#     字段核对 + 链 dump。
#   verdict-partial-tuple   — origin poke -1 → `has partial definition
#     tuple` 全字段核对。
#   verdict-storage-clause  — def exactType poke 999 → 七字段
#     `slot authority mismatch` (identity 相位)。
#   verdict-projection-21   — 投影 consume 戳 poke → 21 字段
#     `managed borrow projection is broken` 全字段核对 (op712 带戳红
#     同族形, 基线 borrow-projection-20260825/receipts)。
#   verdict-op712           — 去戳红回归形: 记录戳指错 → composed 序
#     `consume edge is broken consumers=1 first=2` (op712 形
#     `consumers=1 first=717` 的 Cheng 行号对应)。
#   verdict-audit-broken    — 同形走 identity-only 相位: 审计段位置
#     发同文判词 (审计双判词调用序之一)。
#   verdict-audit-invalid-path — 顺序块双消费 → 审计段
#     `exact consume dataflow` + `has invalid path consume` (之二)。
#   verdict-param-broken    — 参数定义 kind 非法 → `managed parameter
#     definition is broken`。
#   verdict-param-effect    — 效应析取全假 → `managed parameter
#     effect mismatch`。
#   verdict-terminal-drift  — 槽终校验: 写者 TypeId 漂移 →
#     `source chain is broken ... place=6` (视图位源 + 漂移写者)。
#   verdict-terminal-nosidecar — 槽终校验: 缺侧车物理写者。
#   verdict-terminal-nodominating — 槽终校验: 无支配写者。
#   verdict-block-outside / verdict-block-overlap /
#   verdict-block-orphan    — 块区间三判词 (orphan 含双 dump 族)。
#   verdict-slot-partial-authority — 槽车道 origin poke →
#     `has partial authority` 全字段核对。
#   verdict-slot-count      — 倒排计数 0 → `definition count=0`。
#   verdict-bind-broken     — 非拷贝非字面量绑定 → `managed bind
#     definition is broken`。
#   verdict-root-broken     — 根源槽已持 storage 戳 → `managed root
#     definition is broken`。
#   verdict-global-broken   — GLOBAL place 非 GlobalLoad → `managed
#     global definition is broken` 全字段。
#   verdict-shared-copy-broken — origin 越界 → `managed shared-copy
#     definition is broken` 全字段 (含 origin_def_slot=-2)。
#   verdict-copy-source     — 空组托管拷贝缺 source → `managed copy
#     lacks exact source authority` 全字段。
#   verdict-consume-only    — 空组 consume-only 边异形 → `managed
#     consume-only edge is broken`。
#
# 零漂移口径: 全腿同基板双跑 rc 同 + stderr md5 同 (gate 钉 md5)。

import std/cmdline as cmdline
import std/result
import std/os
import cheng/core/analysis/exact_def_derive as derive
import cheng/core/analysis/exact_def_freeze as freeze
import cheng/core/analysis/exact_def_identity as identity
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

const
    # 合成 TypeArena 行: 0=i32 1=str 2=i64 3=arr4(i32×4) 4=rec{str}
    # 5=refrec。
    fixtureTypeI32 = 0
    fixtureTypeStr = 1
    fixtureTypeI64 = 2
    fixtureTypeArr4 = 3
    fixtureTypeRec = 4
    fixtureTypeRefRec = 5
    fixtureTransportStart = 100

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

fn fixtureCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd")
    if IsErr(parsed):
        panic(Error(parsed))
    return Value(parsed)

@borrows
fn buildWindow(): exactdef.BodyIrExactDefTypeArenaWindow =
    var window: exactdef.BodyIrExactDefTypeArenaWindow
    window.artifactCid = fixtureCid()
    for typeId in 0..<6:
        add(window.structuralKinds,
            Int32(typearena.TypedExprStructuralTypeInvalid))
        add(window.scalarKinds,
            Int32(typearena.TypedExprStructuralScalarInvalid))
        add(window.childTypeIds, -1)
        add(window.layoutChildStarts, 0)
        add(window.layoutChildCounts, 0)
        add(window.fixedLengths, 0)
        add(window.sizeBytes, 4)
        add(window.alignBytes, 4)
    window.structuralKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralScalarInt32)
    window.sizeBytes[fixtureTypeI32] = 4
    window.alignBytes[fixtureTypeI32] = 4
    window.structuralKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralScalarStr)
    window.sizeBytes[fixtureTypeStr] = 24
    window.alignBytes[fixtureTypeStr] = 8
    window.structuralKinds[fixtureTypeI64] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI64] =
        Int32(typearena.TypedExprStructuralScalarInt64)
    window.sizeBytes[fixtureTypeI64] = 8
    window.alignBytes[fixtureTypeI64] = 8
    window.structuralKinds[fixtureTypeArr4] =
        Int32(typearena.TypedExprStructuralTypeFixedArray)
    window.childTypeIds[fixtureTypeArr4] = fixtureTypeI32
    window.fixedLengths[fixtureTypeArr4] = 4
    window.sizeBytes[fixtureTypeArr4] = 16
    window.alignBytes[fixtureTypeArr4] = 4
    window.structuralKinds[fixtureTypeRec] =
        Int32(typearena.TypedExprStructuralTypeObject)
    window.layoutChildStarts[fixtureTypeRec] = 0
    window.layoutChildCounts[fixtureTypeRec] = 1
    window.sizeBytes[fixtureTypeRec] = 24
    window.alignBytes[fixtureTypeRec] = 8
    add(window.layoutChildTypeIds, fixtureTypeStr)
    add(window.layoutChildOffsets, 0)
    add(window.layoutChildWidths, 24)
    window.structuralKinds[fixtureTypeRefRec] =
        Int32(typearena.TypedExprStructuralTypeRefObject)
    window.sizeBytes[fixtureTypeRefRec] = 8
    window.alignBytes[fixtureTypeRefRec] = 8
    smokeAssert(exactdef.BodyIrExactDefTypeArenaWindowShapeValid(window),
                "identity smoke: window shape")
    return window

# typeFact 冻结投影 (identity 的 structural/independence 证据; 升序六行)。
fn bindTypeFacts(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeI32,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt32),
                    -1, 0, 4, 4),
                "identity smoke: type fact i32")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeStr,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarStr),
                    -1, 0, 24, 8),
                "identity smoke: type fact str")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeI64,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt64),
                    -1, 0, 8, 8),
                "identity smoke: type fact i64")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeArr4,
                    Int32(typearena.TypedExprStructuralTypeFixedArray),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    fixtureTypeI32, 4, 16, 4),
                "identity smoke: type fact arr4")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRec,
                    Int32(typearena.TypedExprStructuralTypeObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    -1, 0, 24, 8),
                "identity smoke: type fact rec")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRefRec,
                    Int32(typearena.TypedExprStructuralTypeRefObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    -1, 0, 8, 8),
                "identity smoke: type fact refrec")

fn addBoundSlot(body: var coreir.BodyIR,
                name: str,
                typeKind: int32,
                typeId: int32,
                managedStorageKind: int32,
                sizeBytes: int32,
                alignBytes: int32): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body, slotId, fixtureCid(), typeId,
                    managedStorageKind),
                "identity smoke: slot TypeArena proof bind")
    return slotId

fn addStrSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)

fn addI32Slot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalI32Tag, fixtureTypeI32,
        coreir.BodyManagedStorageUnmanagedTag, 4, 4)

fn addI64Slot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalI64Tag, fixtureTypeI64,
        coreir.BodyManagedStorageUnmanagedTag, 8, 8)

fn addArr4Slot(body: var coreir.BodyIR, name: str): int32 =
    let slotId = addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeArr4,
        coreir.BodyManagedStorageUnmanagedTag, 16, 4)
    body.localSlots[slotId].auxValue = 4
    return slotId

fn addRecSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeRec,
        coreir.BodyManagedStorageManagedTag, 24, 8)

# 未绑 nominal 聚合 (sentinel 道: typeArenaTypeId 恒 -1)。
fn addUnboundAggregateSlot(body: var coreir.BodyIR, name: str): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = coreir.LocalAggregateTag
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = 16
    slot.alignBytes = 8
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    return slotId

fn newDefOp(body: var coreir.BodyIR,
            kind: int32,
            target: int32,
            semanticRow: int32,
            ownership: coreir.OwnershipKind): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    op.valueDefSlot = target
    op.valueDefExprNodeIndex = semanticRow
    op.valueDefSemanticRow = semanticRow
    op.valueDefOwnership = ownership
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticRow
    return coreir.BodyIRAppendOp(body, op)

# 无定义裸行 (valueDef 全哨兵)。
fn newBareOp(body: var coreir.BodyIR,
             kind: int32,
             target: int32): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    return coreir.BodyIRAppendOp(body, op)

fn buildTransportRows(count: int32): int32[] =
    var rows: int32[]
    for row in 0..<count:
        add(rows, fixtureTransportStart + row)
    return rows

fn appendCallTarget(body: var coreir.BodyIR, callIndex: int32) =
    coreir.BodyIRControlFlowBindCallTarget(
        body, callIndex,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag, 0, fixtureCid())

fn appendBlock(body: var coreir.BodyIR,
               opStart: int32,
               opCount: int32,
               termIndex: int32): int32 =
    let blockId = coreir.BodyIRAppendBlock(body, opStart, opCount, 0)
    body.blocks[blockId].termIndex = termIndex
    return blockId

fn appendTerm(body: var coreir.BodyIR, term: coreir.BodyTerm): int32 =
    return coreir.BodyIRAppendTerm(body, term)

fn newRetTerm(body: var coreir.BodyIR, resultSlot: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    return appendTerm(body, term)

fn newBrTerm(body: var coreir.BodyIR, targetBlock: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermBrTag
    term.trueBlock = targetBlock
    term.falseBlock = -1
    return appendTerm(body, term)

fn bindSuccessors(body: var coreir.BodyIR,
                  termIndex: int32,
                  successors: int32[],
                  edgeKinds: int32[]) =
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)

fn beginControl(body: var coreir.BodyIR, blockCount: int32) =
    coreir.BodyIRControlFlowBegin(body, 0)
    for blockId in 0..<blockCount:
        coreir.BodyIRControlFlowBindBlockScope(body, blockId, 0)

fn sealControlFlow(body: var coreir.BodyIR) =
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "identity smoke: control flow seal")

# 单块收尾 (ops 全在块 0, RET term 无后继)。
fn sealSingleBlock(body: var coreir.BodyIR, resultSlot: int32) =
    let termIndex = newRetTerm(body, resultSlot)
    let _ = appendBlock(body, 0, body.ops.len, termIndex)
    beginControl(body, 1)
    var successors: int32[]
    var edgeKinds: int32[]
    bindSuccessors(body, termIndex, successors, edgeKinds)
    sealControlFlow(body)

fn freezeEntryOwnership(body: var coreir.BodyIR,
                        ownerships: int32[]) =
    var kinds: int32[]
    for slotIndex in 0..<body.localSlots.len:
        add(kinds, Int32(coreir.OwnInvalid))
    for ordinal in 0..<ownerships.len:
        let slotId = body.entryParameterSlotIds[ordinal]
        kinds[slotId] = ownerships[ordinal]
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, kinds)

@borrows
fn deriveFixture(body: var coreir.BodyIR,
                 originKinds: int32[],
                 exactTypeIds: int32[],
                 window: exactdef.BodyIrExactDefTypeArenaWindow) =
    smokeAssert(derive.BodyIrExactDefDerive(
                    body,
                    fixtureTransportStart,
                    buildTransportRows(originKinds.len),
                    originKinds,
                    exactTypeIds,
                    window),
                "identity smoke: derive rejected fixture")
    smokeAssert(body.exactDef.sealed, "identity smoke: sidecar sealed")

# ---- 验证车道 ----

fn validateComposed(body: var coreir.BodyIR): bool =
    return identity.ExactDefIdentityValidateInto(
        body, freeze.ExactDefFreezeProductionLimits())

# identity-only 相位 (预跑 read-edge 完成器, 绕开批 2 相位 — 夹具
# 断链/审计隔离腿专用)。
fn validateIdentityOnly(body: var coreir.BodyIR): bool =
    var dom = freeze.ExactDefFreezeDominatorsBuild(body)
    var workspace = freeze.ExactDefFreezeIdentityWorkspaceAcquire(body)
    smokeAssert(freeze.ExactDefFreezeIdentityCompleteReadEdges(
                    body, dom, workspace),
                "identity smoke: read-edge complete rejected fixture")
    exactdef.BodyIrExactDefSidecarRefreezeCidInto(body)
    return identity.ExactDefIdentityPhaseValidateInto(
        body, freeze.ExactDefFreezeProductionLimits(), "freeze")

# 块区间腿专用: 不预跑 (工作区构建对非法块区间 panic, 判词必须先达)。
fn validateIdentityPhaseDirect(body: var coreir.BodyIR): bool =
    return identity.ExactDefIdentityPhaseValidateInto(
        body, freeze.ExactDefFreezeProductionLimits(), "freeze")


# ---- 正例腿构建器 ----

# ① move_edge: 参数根 (MOVE) → CopyLocal 绑定 (MOVE)。
fn buildMoveEdgeBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let paramStr = addStrSlot(body, "text")
    body.localSlots[paramStr].stackOffset = -1
    let localStr = addStrSlot(body, "local_str")
    coreir.BodyIRBindEntryParameterSlot(body, 0, paramStr)
    var entry: int32[]
    add(entry, Int32(coreir.OwnMove))
    freezeEntryOwnership(body, entry)
    let opParam = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 100, coreir.OwnMove)
    let opBind = newDefOp(
        body, coreir.BodyOpCopyLocalTag, localStr, 101, coreir.OwnMove)
    add(body.ops[opBind].operands, paramStr)
    body.ops[opBind].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opBind].sourceDefinitionRow = opParam
    body.ops[opParam].valueDefConsumeOpIndexPlusOne = opBind + 1
    sealSingleBlock(body, localStr)
    return body

fn moveEdgeTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 1)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ② borrow_edge: 参数根 (SHARED) → CopyLocal 绑定 (SHARED, 无
# borrow-owner 域 → derive 落 STACK_LOCAL)。
fn buildBorrowEdgeBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let paramStr = addStrSlot(body, "text")
    body.localSlots[paramStr].stackOffset = -1
    let localStr = addStrSlot(body, "local_str")
    coreir.BodyIRBindEntryParameterSlot(body, 0, paramStr)
    var entry: int32[]
    add(entry, Int32(coreir.OwnBorrowShared))
    freezeEntryOwnership(body, entry)
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 100,
        coreir.OwnBorrowShared)
    let opBind = newDefOp(
        body, coreir.BodyOpCopyLocalTag, localStr, 101,
        coreir.OwnBorrowShared)
    add(body.ops[opBind].operands, paramStr)
    body.ops[opBind].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opBind].sourceDefinitionRow = 0
    sealSingleBlock(body, localStr)
    return body

fn borrowEdgeTransport(originKinds: var int32[],
                       exactTypeIds: var int32[]) =
    add(originKinds, 1)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ③ plain_static_string_edge: 字面量根 (LoadConst PLAIN) → CopyLocal
# 绑定 (PLAIN, 自身过静态串校验)。
fn buildStaticStringBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let slot0 = addStrSlot(body, "s1")
    let slot1 = addStrSlot(body, "s2")
    let opLit = newDefOp(
        body, coreir.BodyOpLoadConstTag, slot0, 100, coreir.OwnPlain)
    add(body.ops[opLit].operands, coreir.LocalStrTag)
    let opBind = newDefOp(
        body, coreir.BodyOpCopyLocalTag, slot1, 101, coreir.OwnPlain)
    add(body.ops[opBind].operands, slot0)
    body.ops[opBind].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opBind].sourceDefinitionRow = opLit
    body.ops[opLit].valueDefConsumeOpIndexPlusOne = opBind + 1
    sealSingleBlock(body, slot1)
    return body

fn staticStringTransport(originKinds: var int32[],
                         exactTypeIds: var int32[]) =
    add(originKinds, 2)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# ④ plain_copy_edge: 定长数组字面量根 → CopyLocal 绑定 (PLAIN,
# 独立道)。
fn buildPlainCopyBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let slot0 = addArr4Slot(body, "a1")
    let slot1 = addArr4Slot(body, "a2")
    let opLit = newDefOp(
        body, coreir.BodyOpLoadConstTag, slot0, 100, coreir.OwnPlain)
    add(body.ops[opLit].operands, coreir.LocalAggregateTag)
    let opBind = newDefOp(
        body, coreir.BodyOpCopyLocalTag, slot1, 101, coreir.OwnPlain)
    add(body.ops[opBind].operands, slot0)
    body.ops[opBind].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opBind].sourceDefinitionRow = opLit
    body.ops[opLit].valueDefConsumeOpIndexPlusOne = opBind + 1
    sealSingleBlock(body, slot1)
    return body

fn plainCopyTransport(originKinds: var int32[],
                      exactTypeIds: var int32[]) =
    add(originKinds, 2)
    add(originKinds, 2)
    add(exactTypeIds, fixtureTypeArr4)
    add(exactTypeIds, fixtureTypeArr4)

# ⑤ plain_shared_copy_edge: 字面量根 → SHARED_COPY 戳拷贝 (poke) →
# CopyLocal 绑定 (PLAIN)。
fn buildSharedCopyBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "identity smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let slot0 = addArr4Slot(body, "a1")
    let slot1 = addArr4Slot(body, "shared")
    let slot2 = addArr4Slot(body, "local")
    let opLit = newDefOp(
        body, coreir.BodyOpLoadConstTag, slot0, 100, coreir.OwnPlain)
    add(body.ops[opLit].operands, coreir.LocalAggregateTag)
    let opShared = newDefOp(
        body, coreir.BodyOpCopyLocalTag, slot1, 101, coreir.OwnPlain)
    add(body.ops[opShared].operands, slot0)
    let opBind = newDefOp(
        body, coreir.BodyOpCopyLocalTag, slot2, 102, coreir.OwnPlain)
    add(body.ops[opBind].operands, slot1)
    body.ops[opBind].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opBind].sourceDefinitionRow = opShared
    body.ops[opShared].valueDefConsumeOpIndexPlusOne = opBind + 1
    sealSingleBlock(body, slot2)
    return body

