import std/os
import std/strutils as strutil
import cheng/core/tooling/path as chengpath

type
    CleanupProbeLookup =
        keys: str[]
        slots: int32[]

    CleanupProbeWork =
        payloadMovedToOut: bool
        exprPayload: int32[]
        typedIrPayload: int32[]
        nodesPayload: int32[]
        edgesPayload: int32[]
        semanticPayload: int32[]
        sourceTexts: str[]
        metadataContexts: str[]
        scratchTexts: str[]
        scratchLookup: CleanupProbeLookup

    CleanupProbeOut =
        exprPayload: int32[]
        typedIrPayload: int32[]
        nodesPayload: int32[]
        edgesPayload: int32[]
        semanticPayload: int32[]

fn CleanupProbeWorkEmpty(work: var CleanupProbeWork): bool =
    return !work.payloadMovedToOut &&
           work.exprPayload.len == 0 &&
           work.typedIrPayload.len == 0 &&
           work.nodesPayload.len == 0 &&
           work.edgesPayload.len == 0 &&
           work.semanticPayload.len == 0 &&
           work.sourceTexts.len == 0 &&
           work.metadataContexts.len == 0 &&
           work.scratchTexts.len == 0 &&
           work.scratchLookup.keys.len == 0 &&
           work.scratchLookup.slots.len == 0

fn CleanupProbeRelease(work: var CleanupProbeWork) =
    if work.payloadMovedToOut:
        assert(work.exprPayload.len == 0 &&
               work.typedIrPayload.len == 0 &&
               work.nodesPayload.len == 0 &&
               work.edgesPayload.len == 0 &&
               work.semanticPayload.len == 0,
               "compiler csg cleanup probe: output move left owned payload")
    work = CleanupProbeWork()

fn CleanupProbeAbort(work: var CleanupProbeWork): bool =
    CleanupProbeRelease(work)
    return false

fn CleanupProbeBuild(work: var CleanupProbeWork,
                     out: var CleanupProbeOut,
                     failureRoute: int32): bool =
    add(work.exprPayload, 1)
    add(work.typedIrPayload, 2)
    add(work.nodesPayload, 3)
    add(work.edgesPayload, 4)
    add(work.semanticPayload, 5)
    add(work.sourceTexts, "source")
    add(work.metadataContexts, "metadata")
    add(work.scratchLookup.keys, "key")
    add(work.scratchLookup.slots, 0)
    for route in 1..40:
        add(work.scratchTexts, Fmt"route-{route}")
        if failureRoute == route:
            return CleanupProbeAbort(work)
    if failureRoute != 0:
        panic(Fmt"compiler csg cleanup probe: unknown failure route {failureRoute}")
    out.exprPayload = work.exprPayload
    work.exprPayload = []
    out.typedIrPayload = work.typedIrPayload
    work.typedIrPayload = []
    out.nodesPayload = work.nodesPayload
    work.nodesPayload = []
    out.edgesPayload = work.edgesPayload
    work.edgesPayload = []
    out.semanticPayload = work.semanticPayload
    work.semanticPayload = []
    work.payloadMovedToOut = true
    CleanupProbeRelease(work)
    return true

fn CleanupFind(text: str, needle: str): int32 =
    if needle.len == 0:
        return 0
    if text.len < needle.len:
        return -1
    let candidateCount = text.len - needle.len + 1
    for i in 0..<candidateCount:
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            return i
    return -1

fn CleanupCount(text: str, needle: str): int32 =
    if needle.len == 0 || text.len < needle.len:
        return 0
    var count: int32
    let candidateCount = text.len - needle.len + 1
    for i in 0..<candidateCount:
        var matched = true
        for j in 0..<needle.len:
            if text[i + j] != needle[j]:
                matched = false
                break
        if matched:
            count = count + 1
    return count

fn CleanupSourceSlice(text: str, startNeedle: str, endNeedle: str): str =
    let startIndex = CleanupFind(text, startNeedle)
    let endIndex = CleanupFind(text, endNeedle)
    assert(startIndex >= 0, Fmt"compiler csg cleanup matrix: missing start {startNeedle}")
    assert(endIndex > startIndex, Fmt"compiler csg cleanup matrix: missing end {endNeedle}")
    return strutil.SliceStr(text, startIndex, endIndex - 1)

fn CleanupAssertProductionSource() =
    let root = os.GetCurrentDir()
    let source = chengpath.ReadTextFile(root, "src/core/tooling/compiler_csg.cheng")
    assert(source.len > 0, "compiler csg cleanup matrix: source missing")
    let typedExprSource = chengpath.ReadTextFile(root, "src/core/lang/typed_expr.cheng")
    assert(typedExprSource.len > 0, "compiler csg cleanup matrix: typed expr source missing")
    let workType = CleanupSourceSlice(source,
                                      "    CompilerCsgBuildWorkingSet =",
                                      "    CompilerLegacySourceUnit =")
    assert(CleanupCount(workType,
                        "reachableFilterSourceLookup: parser.ParserTextLookup") == 1,
           "compiler csg cleanup matrix: reachable lookup must be ParserTextLookup")
    assert(CleanupCount(workType, "CompilerCsgReachableSourceLookup") == 0,
           "compiler csg cleanup matrix: forbidden 72-byte reachable lookup")

    let releaseBody = CleanupSourceSlice(source,
                                         "fn CompilerCsgBuildWorkingSetRelease(",
                                         "fn CompilerCsgBuildAbort(")
    assert(CleanupCount(releaseBody,
                        "CompilerCsgTypedFactTableTerminalRelease(work.typedIrRoundFacts)") == 1,
           "compiler csg cleanup matrix: typed fact terminal release")
    assert(CleanupCount(releaseBody,
                        "CompilerCsgNormalizedExprLayerTerminalRelease(work.activeSliceExprLayer)") == 1,
           "compiler csg cleanup matrix: slice expr scratch terminal release")
    assert(CleanupCount(releaseBody,
                        "CompilerCsgTypedFactTableTerminalRelease(work.activeSliceTypedFacts)") == 1,
           "compiler csg cleanup matrix: slice fact scratch terminal release")
    assert(CleanupCount(releaseBody,
                        "CompilerCsgNormalizedExprLayerTerminalRelease(work.exprLayer)") == 1,
           "compiler csg cleanup matrix: working expr layer terminal release")
    assert(CleanupCount(releaseBody, "CompilerCsgBuildSourceScratchRelease(work)") == 1,
           "compiler csg cleanup matrix: scratch release count")
    assert(CleanupCount(releaseBody, "arenamod.ArenaRelease(work.typedIr.arena)") == 1,
           "compiler csg cleanup matrix: typed ir arena release")
    assert(CleanupCount(releaseBody, "work.typedIr = texpr.TypedExprIr()") == 1,
           "compiler csg cleanup matrix: typed ir terminal reset")
    assert(CleanupCount(releaseBody, "work = CompilerCsgBuildWorkingSet()") == 1,
           "compiler csg cleanup matrix: working set terminal reset")

    let sliceBody = CleanupSourceSlice(source,
                                       "fn CompilerCsgSemanticAppendSourceExprSlices(",
                                       "fn CompilerCsgBuildSourceScratchRelease(")
    assert(CleanupCount(sliceBody,
                        "sliceExprLayer: var parser.NormalizedExprLayer") == 1,
           "compiler csg cleanup matrix: slice expr scratch parameter")
    assert(CleanupCount(sliceBody,
                        "sliceFacts: var TypedExprFactTable") == 1,
           "compiler csg cleanup matrix: slice fact scratch parameter")
    assert(CleanupCount(sliceBody,
                        "var sliceExprLayer: parser.NormalizedExprLayer") == 0,
           "compiler csg cleanup matrix: per-slice expr allocation remains")
    assert(CleanupCount(sliceBody,
                        "var sliceFacts: TypedExprFactTable") == 0,
           "compiler csg cleanup matrix: per-slice fact allocation remains")
    assert(CleanupCount(sliceBody,
                        "TypedExprFactTableRelease(sliceFacts)") == 0,
           "compiler csg cleanup matrix: per-slice fact release remains")
    assert(CleanupCount(sliceBody,
                        "CompilerCsgNormalizedExprLayerTerminalRelease(sliceExprLayer)") == 1,
           "compiler csg cleanup matrix: slice expr phase terminal release")
    assert(CleanupCount(sliceBody,
                        "CompilerCsgTypedFactTableTerminalRelease(sliceFacts)") == 1,
           "compiler csg cleanup matrix: slice fact phase terminal release")
    let sourceScratchReleaseBody = CleanupSourceSlice(
        source,
        "fn CompilerCsgBuildSourceScratchRelease(",
        "fn CompilerCsgTypedFactTableTerminalRelease(")
    assert(CleanupCount(sourceScratchReleaseBody,
                        "work.activeFunctionExprLayer)") == 1,
           "compiler csg cleanup matrix: function expr scratch terminal release")
    assert(CleanupCount(sourceScratchReleaseBody,
                        "CompilerCsgNormalizedExprLayerTerminalRelease(work.activeExprLayer)") == 1,
           "compiler csg cleanup matrix: source expr scratch terminal release")
    let frontierBody = CleanupSourceSlice(source,
                                          "fn CompilerCsgExprLayerForFrontierFunctions(",
                                          "fn CompilerCsgSemanticInitProcessedFunctionAndSourceFlags(")
    assert(CleanupCount(frontierBody,
                        "functionLayer: var parser.NormalizedExprLayer") == 1,
           "compiler csg cleanup matrix: frontier expr scratch parameter")
    assert(CleanupCount(frontierBody,
                        "var functionLayer: parser.NormalizedExprLayer") == 0,
           "compiler csg cleanup matrix: per-frontier expr allocation remains")
    let appendFrontierBody = CleanupSourceSlice(source,
                                                "fn CompilerCsgSemanticAppendUnprocessedFrontierFacts(",
                                                "fn CompilerCsgConsumeExprSliceIntoTypedFacts(")
    assert(CleanupCount(appendFrontierBody,
                        "functionExprLayer: var parser.NormalizedExprLayer") == 1,
           "compiler csg cleanup matrix: append frontier expr scratch parameter")
    assert(CleanupCount(appendFrontierBody,
                        "var functionExprLayer: parser.NormalizedExprLayer") == 0,
           "compiler csg cleanup matrix: append frontier allocation remains")

    let buildBody = CleanupSourceSlice(source,
                                       "fn compilerCsgBuildConsumeWithOverridesCoreInto(",
                                       "fn BuildCompilerCsgConsumeWithOverridesInto(")
    assert(CleanupCount(buildBody, "return CompilerCsgBuildAbort(work)") == 39,
           "compiler csg cleanup matrix: failure route count")
    assert(CleanupCount(buildBody, "return false") == 0,
           "compiler csg cleanup matrix: raw failure return remains")
    assert(CleanupCount(buildBody, "return true") == 1,
           "compiler csg cleanup matrix: success return count")
    assert(CleanupCount(buildBody, "work.payloadMovedToOut = true") == 1,
           "compiler csg cleanup matrix: success move marker count")
    assert(CleanupCount(buildBody, "CompilerCsgBuildWorkingSetRelease(work)") == 1,
           "compiler csg cleanup matrix: success release count")
    assert(CleanupCount(buildBody,
                        "work.activeSliceExprLayer,") == 4,
           "compiler csg cleanup matrix: all slice/frontier paths share expr scratch")
    assert(CleanupCount(buildBody,
                        "work.activeSliceTypedFacts,") == 3,
           "compiler csg cleanup matrix: streaming and reuse paths share fact scratch")
    assert(CleanupCount(buildBody,
                        "work.activeExprLayer = parser.NormalizedExprLayer()") == 0,
           "compiler csg cleanup matrix: per-source expr scratch rebuild remains")
    assert(CleanupCount(buildBody,
                        "texpr.TypedExprFactTableRelease(work.typedIrRoundFacts)") == 0,
           "compiler csg cleanup matrix: per-round fact arena release remains")
    assert(CleanupCount(buildBody,
                        "texpr.TypedExprFactTableReset(work.typedIrRoundFacts)") == 2,
           "compiler csg cleanup matrix: round fact scratch reset contract")
    let profilePayloadReleaseBody = CleanupSourceSlice(source,
                                                       "fn CompilerCsgReleaseProfileSourcePayloads(",
                                                       "fn CompilerCsgCloneInt32Seq(")
    assert(CleanupCount(profilePayloadReleaseBody, "profile.text = \"\"") == 1 &&
           CleanupCount(profilePayloadReleaseBody, "profile.lines = []") == 1 &&
           CleanupCount(profilePayloadReleaseBody,
                        "profiles[profileIndex] = profile") == 1,
           "compiler csg cleanup matrix: profile payload release must write row back")
    assert(CleanupCount(buildBody,
                        "CompilerCsgReleaseProfileSourcePayloads(work.exprCallProfiles)") == 1,
           "compiler csg cleanup matrix: profile payload release count")
    assert(CleanupCount(buildBody,
                        "CompilerCsgTraceStage(\"after_profile_source_payload_release\")") == 1,
           "compiler csg cleanup matrix: profile payload release trace")
    let profileDeclTableIndex = CleanupFind(buildBody,
                                            "CompilerCsgSemanticBuildSourceDeclImportTables(work.semanticGraph")
    let profileReachableTableIndex = CleanupFind(buildBody,
                                                 "CompilerCsgSemanticBuildReachableTable(work.semanticGraph")
    let profilePayloadReleaseIndex = CleanupFind(buildBody,
                                                 "CompilerCsgReleaseProfileSourcePayloads(work.exprCallProfiles)")
    let profileSlicePhaseIndex = CleanupFind(buildBody,
                                             "var debugOwnerMissingCount: int32")
    assert(profileDeclTableIndex >= 0 &&
           profileDeclTableIndex < profileReachableTableIndex &&
           profileReachableTableIndex < profilePayloadReleaseIndex &&
           profilePayloadReleaseIndex < profileSlicePhaseIndex,
           "compiler csg cleanup matrix: profile payload lifetime boundary")
    let preservingFactsBody = CleanupSourceSlice(typedExprSource,
                                                  "fn TypedExprBuildFactsForExprLayerPreserving(",
                                                  "fn TypedExprBuildFacts(")
    assert(CleanupCount(preservingFactsBody,
                        "TypedExprFactTableReset(facts)") == 1,
           "compiler csg cleanup matrix: preserving builder must reset fact scratch")
    assert(CleanupCount(preservingFactsBody,
                        "TypedExprFactTableRelease(facts)") == 0,
           "compiler csg cleanup matrix: preserving builder must not release fact scratch")
    assert(CleanupCount(typedExprSource,
                        "exprLineColumnHeads: int32[]") == 1 &&
           CleanupCount(typedExprSource,
                        "exprLineColumnValues: int32[]") == 1 &&
           CleanupCount(typedExprSource,
                        "exprLineColumnNext: int32[]") == 1,
           "compiler csg cleanup matrix: flat line-column SoA missing")
    assert(CleanupCount(typedExprSource,
                        "TypedExprLineExprColumns") == 0 &&
           CleanupCount(typedExprSource,
                        "lineExprColumns.columns = []") == 0,
           "compiler csg cleanup matrix: nested per-line allocation remains")
    let clearLineColumnsBody = CleanupSourceSlice(typedExprSource,
                                                   "fn TypedExprClearSourceExprLineColumnsForRange(",
                                                   "fn TypedExprBuildFactsAppendMetadataContext(")
    assert(CleanupCount(clearLineColumnsBody,
                        "setLen(ctx.exprLineColumnValues, 0)") == 1 &&
           CleanupCount(clearLineColumnsBody,
                        "setLen(ctx.exprLineColumnNext, 0)") == 1,
           "compiler csg cleanup matrix: flat line-column scratch must retain capacity")

    assert(CleanupCount(buildBody,
                        "parser.NormalizedExprLayerMoveInto(out.exprLayer") == 2,
           "compiler csg cleanup matrix: expr payload alternatives")
    assert(CleanupCount(buildBody,
                        "texpr.TypedExprIrMoveInto(out.typedIr, work.typedIr)") == 1,
           "compiler csg cleanup matrix: typed ir move")
    assert(CleanupCount(buildBody, "out.nodes = work.nodes") == 1 &&
           CleanupCount(buildBody, "work.nodes = []") == 1,
           "compiler csg cleanup matrix: node move")
    assert(CleanupCount(buildBody, "out.edges = work.edges") == 1 &&
           CleanupCount(buildBody, "work.edges = []") == 1,
           "compiler csg cleanup matrix: edge move")
    assert(CleanupCount(buildBody, "out.semanticGraph = work.semanticGraph") == 1 &&
           CleanupCount(buildBody, "work.semanticGraph = CompilerCsgSemanticGraph()") == 1,
           "compiler csg cleanup matrix: semantic graph move")

    let firstOutputIndex = CleanupFind(buildBody, "    out.version = 1")
    assert(firstOutputIndex >= 0,
           "compiler csg cleanup matrix: output transfer start missing")
    let outputTail = strutil.SliceStr(buildBody,
                                      firstOutputIndex,
                                      buildBody.len - 1)
    let movedIndex = CleanupFind(buildBody, "    work.payloadMovedToOut = true")
    let releaseIndex = CleanupFind(buildBody, "    CompilerCsgBuildWorkingSetRelease(work)")
    let successIndex = CleanupFind(buildBody, "    return true")
    assert(CleanupCount(outputTail, "return CompilerCsgBuildAbort(work)") == 0,
           "compiler csg cleanup matrix: failure after output transfer")
    assert(firstOutputIndex < movedIndex && movedIndex < releaseIndex && releaseIndex < successIndex,
           "compiler csg cleanup matrix: success ownership order")

fn main(): int32 =
    CleanupAssertProductionSource()
    for failureRoute in 1..40:
        var work: CleanupProbeWork
        var out: CleanupProbeOut
        let ok = CleanupProbeBuild(work, out, failureRoute)
        assert(!ok, Fmt"compiler csg cleanup matrix: route {failureRoute} succeeded")
        assert(CleanupProbeWorkEmpty(work),
               Fmt"compiler csg cleanup matrix: route {failureRoute} retained work")
        assert(out.exprPayload.len == 0 && out.typedIrPayload.len == 0 &&
               out.nodesPayload.len == 0 && out.edgesPayload.len == 0 &&
               out.semanticPayload.len == 0,
               Fmt"compiler csg cleanup matrix: route {failureRoute} mutated output")

    var successWork: CleanupProbeWork
    var successOut: CleanupProbeOut
    assert(CleanupProbeBuild(successWork, successOut, 0),
           "compiler csg cleanup matrix: success failed")
    assert(CleanupProbeWorkEmpty(successWork),
           "compiler csg cleanup matrix: success retained work")
    assert(successOut.exprPayload.len == 1 &&
           successOut.typedIrPayload.len == 1 &&
           successOut.nodesPayload.len == 1 &&
           successOut.edgesPayload.len == 1 &&
           successOut.semanticPayload.len == 1,
           "compiler csg cleanup matrix: success payload move")
    os.WriteLine(os.GetStdout(),
                 "compiler_csg_build_cleanup_failure_matrix ok failures=40 success=1 payload_moves=5")
    return 0
