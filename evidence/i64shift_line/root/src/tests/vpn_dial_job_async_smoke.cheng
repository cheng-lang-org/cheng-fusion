# N-A 拨号异步化 机制浸泡夹具(绿证, 依赖 [dial-job] 新符号):
# 1) 生命周期: submit → dial 线程 CAS 认领 → 结构性失败(127.0.0.1:1 拒连,
#    无真实网络) → 失败待收(4) → 收获认领(清槽) —— 全状态机走过。
# 2) 泵活性缩比判据: 作业在途期间, 提交线程(数据面替身)持续迭代 ≥100 次
#    —— 拨号不再阻塞调用线程(修复前该线程被内联冷拨卡死)。
# 3) ORC 浸泡: 8 个作业周期反复 CloneStr 交接(请求快照+结果槽所有权转移),
#    任何双释放/underflow 即 fail-stop 非零 rc; 正常完成 = 0 崩溃 0 卡槽。
import std/strings
import std/os
import std/result
import std/strutils
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn
import cheng/apps/vpn_proxy/vpn_proxy_config as config
import cheng/apps/vpn_proxy/vpn_proxy_routing as routing

# 等待作业进入终态(4=失败待收, 3=成功待收), 返回泵活性迭代数; 超时 -1。
fn waitTerminal(maxMs: int64): int64 =
    var iters: int64 = 0
    var waited: int64 = 0
    while waited < maxMs:
        let st: int32 = vpn.VpnProxyDialJobStateNow()
        if st == 3 || st == 4:
            return iters
        iters = iters + 1
        os.SleepMs(1)
        waited = waited + 1
    return -1

fn main(): int32 =
    var cfg: config.VpnProxyExitConfig
    cfg.name = strings.CloneStr("na")
    cfg.transport = strings.CloneStr("tcp-tls-forward")
    cfg.host = strings.CloneStr("127.0.0.1")
    cfg.port = 1
    cfg.serverName = strings.CloneStr("na.invalid")
    cfg.authority = strings.CloneStr("na.invalid")
    cfg.auth = strings.CloneStr("na-auth")
    var states: routing.VpnProxyExitState[]
    states = []
    add(states, routing.VpnProxyInitExitStateWithClientCertificate(cfg, false))
    var identity: vpn.VpnProxyLoadedIdentity
    # 会话环境: 交接快照 + maintainer/dial 双线程(maintainer 补池对拒连
    # 目标失败退避, 无害)。
    vpn.VpnProxyPoolSessionStart(states, identity)
    if vpn.VpnProxyDialJobStateNow() != 0:
        echo("dialjob slot not idle at start")
        return 10
    # kind=1 前台链接作业 × 5: 全生命周期 + 泵活性 + ORC 交接浸泡。
    var cycle: int32 = 0
    while cycle < 5:
        if !vpn.VpnProxyDialJobSubmit(1, int64(4242) + int64(cycle), strings.CloneStr("dial.invalid"), int32(443) + cycle):
            echo("dialjob submit busy")
            return 11
        let pumpIters: int64 = waitTerminal(int64(20000))
        if pumpIters < int64(0):
            echo("dialjob terminal timeout")
            return 12
        if pumpIters < int64(100):
            echo("pump liveness too low during dial window")
            return 13
        let claimed: int32 = vpn.VpnProxyDialJobPollClaim()
        if claimed != 4:
            echo("dialjob expected fail claim, got")
            return 14
        if vpn.VpnProxyDialJobStateNow() != 0:
            echo("dialjob slot not idle after claim")
            return 15
        cycle = cycle + 1
    # kind=2 mux 隧道作业 × 2: 同生命周期(DialSelected 单轮, 更快)。
    cycle = 0
    while cycle < 2:
        if !vpn.VpnProxyDialJobSubmit(2, int64(0), strings.CloneStr(""), int32(0)):
            echo("mux submit busy")
            return 16
        let pumpIters2: int64 = waitTerminal(int64(20000))
        if pumpIters2 < int64(0):
            echo("mux terminal timeout")
            return 17
        let claimed2: int32 = vpn.VpnProxyDialJobPollClaim()
        if claimed2 != 4:
            echo("mux expected fail claim, got")
            return 18
        cycle = cycle + 1
    echo(strutil.Join(["dialjob soak ok cycles=7"], ""))
    return 0
