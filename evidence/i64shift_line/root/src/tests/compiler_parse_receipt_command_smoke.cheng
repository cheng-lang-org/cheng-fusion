import std/cmdline as cmdline
import std/strings as strings
import cheng/core/tooling/compiler_parse_receipt_command as parsecommand
import cheng/core/tooling/path as chengpath

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    assert(cmdline.ParamCount() == 5,
           "compiler parse receipt command smoke: expected mode, root, source and out")
    let mode = cmdline.ParamStr(1)
    let rootDir = cmdline.ParamStr(2)
    let sourcePath = cmdline.ParamStr(3)
    let outPath = cmdline.ParamStr(4)
    let driverPath = chengpath.PathAbsolute(rootDir, cmdline.ProgramName())
    let runRes = parsecommand.CompilerParseReceiptCommandRun(
        rootDir,
        sourcePath,
        outPath,
        driverPath)
    if mode == "positive":
        assert(runRes.ok,
               "compiler parse receipt command smoke: positive failed")
        assert(strings.StrContains(runRes.value, "parse_receipt=1"),
               "compiler parse receipt command smoke: summary missing")
        assert(chengpath.FileExistsNonEmpty(rootDir, outPath),
               "compiler parse receipt command smoke: receipt missing")
        echo("compiler_parse_receipt_command_positive=1")
        return 0
    if mode == "missing-source":
        assert(!runRes.ok,
               "compiler parse receipt command smoke: missing source survived")
        assert(strings.StrContains(runRes.err.msg, "source missing"),
               "compiler parse receipt command smoke: wrong missing source error")
        assert(!chengpath.FileExistsNonEmpty(rootDir, outPath),
               "compiler parse receipt command smoke: negative wrote receipt")
        echo("compiler_parse_receipt_command_missing_source=1")
        return 0
    panic("compiler parse receipt command smoke: unknown mode")
