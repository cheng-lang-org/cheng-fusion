import std/result
import std/rawbytes
import cheng/quic/native_runtime as qnative
import cheng/quic/core/packet_header_model

fn ExpectDropSide(side: int32, data: Bytes, label: str) =
    let procRes: Result[int32] = qnative.msquicNativeProcessPacket(
        side,
        "/ip4/127.0.0.1/udp/7443/quic-v1",
        data
    )
    if IsErr(procRes):
        panic(ErrorText(procRes))
    assert(Value(procRes) == qnative.msquicNativeProcessOutcomeNone, label)

fn ExpectDrop(data: Bytes, label: str) =
    ExpectDropSide(qnative.msquicNativeClientSide, data, label)

fn BuildTruncatedShortPayload(): Bytes =
    let payload: Bytes = BytesAlloc(6)
    BytesSet(payload, 0, 14)
    BytesSet(payload, 1, 0)
    BytesSet(payload, 2, 0)
    BytesSet(payload, 3, 0)
    BytesSet(payload, 4, 5)
    BytesSet(payload, 5, 0xaa)
    return payload

fn BuildTruncatedShortWire(): Bytes =
    let cid: Bytes = BytesAlloc(qnative.msquicNativeConnIdLen)
    for i in 0..<qnative.msquicNativeConnIdLen:
        BytesSet(cid, i, (0x21 + i) & 0xff)

    var header: packet_header_model.QuicPacketHeader
    header.longHeader = false
    header.packetType = packet_header_model.QuicPacketShort
    header.version = 0
    header.dcid = cid
    header.scid = emptyBytes()
    header.token = emptyBytes()
    header.payloadLength = 0
    header.packetNumber = 9
    header.packetNumberLen = 1
    header.spinBit = false
    header.keyPhase = false

    let headerRes: Result[Bytes] = packet_header_model.quicPacketHeaderEncode(header)
    if IsErr(headerRes):
        panic(ErrorText(headerRes))

    let payload: Bytes = BuildTruncatedShortPayload()
    return BytesConcat3(Value(headerRes), payload, emptyBytes())

fn main(): int32 =
    qnative.msquicNativeResetSession()

    let oneByte: Bytes = BytesAlloc(1)
    BytesSet(oneByte, 0, 0x40)
    ExpectDrop(oneByte, "one byte packet drops without fatal error")

    let badFixed: Bytes = BytesAlloc(2)
    BytesSet(badFixed, 0, 0x00)
    BytesSet(badFixed, 1, 0x00)
    ExpectDrop(badFixed, "bad fixed bit packet drops without fatal error")

    qnative.msquicNativeTestSetSession0Active(true)
    qnative.msquicNativeTestSetSession0Closed(false)
    qnative.msquicNativeTestSetSession0ServerBound(true)
    qnative.msquicNativeTestSetSession0ClientAddrText("")
    let directShortOk: bool = qnative.msquicNativeProcessShortDirect(qnative.msquicNativeServerSide, 9, BuildTruncatedShortPayload())
    assert(directShortOk, "server truncated short direct payload drops without fatal error")

    let truncatedShort: Bytes = BuildTruncatedShortWire()
    ExpectDropSide(qnative.msquicNativeServerSide, truncatedShort, "server truncated short payload drops without fatal error")

    echo(" native_short_packet_drop_smoke ok")
    return 0
