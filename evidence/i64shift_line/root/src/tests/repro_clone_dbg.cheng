import std/system
import std/result
import std/strings
import cheng/core/lang/intern as langintern

fn main() =
    var pool = langintern.InternPoolNew()
    let a = langintern.Intern(pool, "alpha")
    let e = langintern.Intern(pool, "")
    let b = langintern.Intern(pool, "beta-42")
    echo(Fmt"orig a={a} e={e} b={b} count={langintern.InternPoolCount(pool)}")
    for i in 0..<pool.texts.len:
        let t = langintern.LookupInternOwnedCopy(pool, i)
        assert(IsOk(t), "dbg: lookup")
        let tv = Value(t)
        let found = langintern.FindInternId(pool, tv)
        echo(Fmt"orig i={i} len={tv.len} find={found}")
    var cloned = langintern.InternPoolNew()
    for j in 0..<pool.texts.len:
        let t2 = langintern.LookupInternOwnedCopy(pool, j)
        assert(IsOk(t2), "dbg: clone lookup")
        let tv2 = Value(t2)
        let cid = langintern.Intern(cloned, tv2)
        echo(Fmt"clone j={j} len={tv2.len} cid={cid} cnt={langintern.InternPoolCount(cloned)} empty={cloned.emptyId}")
    langintern.InternPoolRelease(pool)
    langintern.InternPoolRelease(cloned)
    echo("repro_clone_dbg done")
