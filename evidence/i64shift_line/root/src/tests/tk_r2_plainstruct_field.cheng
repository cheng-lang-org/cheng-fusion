import std/system as system

type
    TkR2Receipt =
        outcome: int32
        released: int64
        done: bool

    TkR2State =
        receipt: TkR2Receipt
        ready: bool

fn TkR2Mint(outcome: int32, released: int64, out: var TkR2Receipt) =
    out.outcome = outcome
    out.released = released
    out.done = true

fn main(): int32 =
    var state: TkR2State
    var receipt: TkR2Receipt
    TkR2Mint(7, int64(1200), receipt)
    state.receipt = receipt
    state.ready = true
    os.WriteLine(os.Get_stdout(),
        strings.ConcatStr(
            strings.Int64ToStr(int64(state.receipt.outcome)),
            strings.ConcatStr("/",
                strings.Int64ToStr(state.receipt.released))))
    return 0
