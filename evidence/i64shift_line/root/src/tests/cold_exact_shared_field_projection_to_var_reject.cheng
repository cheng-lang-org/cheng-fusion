type
    ColdExactSharedFieldProjectionBox =
        values: str[]

fn ColdExactSharedFieldProjectionMutate(values: var str[]) =
    add(values, "mutated")

@borrows
fn ColdExactSharedFieldProjectionForward(
        box: ColdExactSharedFieldProjectionBox) =
    ColdExactSharedFieldProjectionMutate(box.values)

fn main(): int32 =
    var box = ColdExactSharedFieldProjectionBox()
    ColdExactSharedFieldProjectionForward(box)
    return 0
