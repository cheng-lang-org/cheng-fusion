fn CastChecks(x: int32, y: int64): int32 =
    let w = int64(x)
    if w != int64(1000000):
        return 1
    let n = int32(y)
    if n != 88:
        return 2
    let lit = int64(4) + int64(16)
    if lit != int64(20):
        return 3
    let neg = int64(0 - 5)
    if neg != int64(0) - int64(5):
        return 4
    let trunc = int32(int64(4294967296) + int64(7))
    if trunc != 7:
        return 5
    let widened = int64(x) + int64(x)
    if widened != int64(2000000):
        return 6
    return 0

fn main(): int32 =
    return CastChecks(1000000, int64(88))
