import std/system

type
    ChildItem =
        name: str

    Container =
        name: str
        items: ChildItem[]

fn main(): int32 =
    let item1: ChildItem = ChildItem(name: "hello")
    let item2: ChildItem = ChildItem(name: "world")

    var outer: Container
    outer.name = "test"

    add(outer.items, item1)
    add(outer.items, item2)

    assert(outer.items.len == 2, " nested field add: len")
    assert(outer.items[0].name == "hello", " nested field add: first name")
    assert(outer.items[1].name == "world", " nested field add: second name")

    echo(" cold_smoke_nested_field_add ok")
    return 0
