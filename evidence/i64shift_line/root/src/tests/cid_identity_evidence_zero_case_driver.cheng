import std/cmdline
import std/os
import std/result
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_world as cworld
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan
import std/strings
import std/strutils as strutil

fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

@borrows
fn CidEvidenceWrite(root: str,
                    relativePath: str,
                    text: str,
                    files: var str[]) =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    os.WriteFile(absolute, text)
    add(files, strings.CloneStr(relativePath))

@borrows
fn CidEvidenceSourceReceiptReport(
        receipt: ccsg.PortableSourceIdentityReceipt): str =
    return CidEvidenceJoin([
        "source_snapshot_count=", strings.IntToStr(receipt.sourceSnapshotCount), "\n",
        "import_edge_count=", strings.IntToStr(receipt.importEdgeCount), "\n",
        "unresolved_import_count=", strings.IntToStr(receipt.unresolvedImportCount), "\n",
        "source_package_id_cid=",
        layout.FixedBytes32Hex(receipt.sourcePackageIdCid), "\n",
        "entry_module_path_cid=",
        layout.FixedBytes32Hex(receipt.entryModulePathCid), "\n",
        "source_bundle_cid=",
        layout.FixedBytes32Hex(receipt.sourceBundleCid), "\n",
        "entry_source_cid=",
        layout.FixedBytes32Hex(receipt.entrySourceCid), "\n",
        "import_graph_cid=",
        layout.FixedBytes32Hex(receipt.importGraphCid), "\n",
        "receipt_cid=", layout.FixedBytes32Hex(receipt.receiptCid)])

fn CidEvidencePortableReceiptForPlan(
        plan: var slplan.SystemLinkPlanStub,
        sourcePath: str,
        outReceipt: var ccsg.PortableSourceIdentityReceipt,
        err: var str): bool =
    if plan.sourceBundleEntrySourceIndex < 0 ||
       plan.sourceBundleEntrySourceIndex >= plan.ownerModulePaths.len:
        err = "CID evidence: portable receipt entry index"
        return false
    let sourceReadRes = os.ReadFileResult(sourcePath)
    if IsErr(sourceReadRes):
        err = Error(sourceReadRes)
        return false
    var importGraphCid: layout.FixedBytes32
    if !cworld.CompilerWorldPortableImportGraphCidInto(
            plan.packageId,
            plan.importEdges,
            plan.unresolvedImportCount,
            importGraphCid,
            err):
        return false
    return ccsg.PortableSourceIdentityReceiptMakeInto(
        plan.sourceClosurePaths.len,
        plan.importEdges.len,
        plan.unresolvedImportCount,
        plan.packageId,
        plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
        plan.sourceBundleCidValue,
        cworld.CompilerWorldSourceRawBytesCid(Value(sourceReadRes)),
        importGraphCid,
        outReceipt,
        err)

fn CidEvidencePortableReceiptForEntry(
        workspaceRoot: str,
        sourcePath: str,
        outReceipt: var ccsg.PortableSourceIdentityReceipt,
        err: var str): bool =
    let request = creq.CompilerRequestNew(
        share(workspaceRoot),
        share(sourcePath),
        chengpath.PathJoin(workspaceRoot, "receipt-probe.o"),
        "x86_64-unknown-linux-gnu",
        creq.EmitObj,
        "")
    var plan: slplan.SystemLinkPlanStub
    if !slplan.BuildSystemLinkPlanStub(workspaceRoot, request, plan, err):
        return false
    return CidEvidencePortableReceiptForPlan(
        plan, sourcePath, outReceipt, err)

@borrows
fn CidEvidenceZeroProbeArtifacts(caseRoot: str,
                                 artifactRoot: str,
                                 files: var str[]): Result[bool] =
    let zeroRoot = chengpath.PathJoin(caseRoot, "zero-entry-root")
    let zeroSourceRoot = chengpath.PathJoin(zeroRoot, "src")
    let zeroSourcePath = chengpath.PathJoin(zeroSourceRoot, "zeroentry.cheng")
    os.MkdirAll(zeroSourceRoot, 493)
    os.WriteFile(
        chengpath.PathJoin(zeroRoot, "cheng-package.toml"),
        "package_id = \"cheng/compiler\"\n")
    os.WriteFile(zeroSourcePath, "")
    var zeroReceipt: ccsg.PortableSourceIdentityReceipt
    var zeroErr = ""
    if !CidEvidencePortableReceiptForEntry(
            zeroRoot, zeroSourcePath, zeroReceipt, zeroErr):
        return Err[bool](zeroErr)
    let zeroReceiptReport = CidEvidenceSourceReceiptReport(zeroReceipt)
    let zeroProjection = CidEvidenceJoin([
        "{",
        "\"entry_module_path\":\"cheng/compiler/zeroentry\",",
        "\"exit_code\":0,",
        "\"package_id\":\"cheng/compiler\",",
        "\"schema\":\"cheng.cid.zero_entry_probe\",",
        "\"source_receipt_sha256\":\"", strings.Sha256(zeroReceiptReport), "\",",
        "\"stderr_sha256\":\"", strings.Sha256(""), "\",",
        "\"stdout_sha256\":\"", strings.Sha256(zeroReceiptReport), "\"",
        "}"])
    let zeroTrace = CidEvidenceJoin([
        "{",
        "\"entry_module_path\":\"cheng/compiler/zeroentry\",",
        "\"exit_code\":0,",
        "\"manifest_sha256\":\"", strings.Sha256(zeroProjection), "\",",
        "\"package_id\":\"cheng/compiler\",",
        "\"schema\":\"cheng.cid.zero_entry_probe\",",
        "\"source_receipt_sha256\":\"", strings.Sha256(zeroReceiptReport), "\",",
        "\"stderr_sha256\":\"", strings.Sha256(""), "\",",
        "\"stdout_sha256\":\"", strings.Sha256(zeroReceiptReport), "\"",
        "}\n"])
    CidEvidenceWrite(
        artifactRoot, "artifacts/zero-entry.cheng", "", files)
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/zero-entry-receipt.kv",
        zeroReceiptReport,
        files)
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/zero-entry.stdout",
        zeroReceiptReport,
        files)
    CidEvidenceWrite(
        artifactRoot, "artifacts/zero-entry.stderr", "", files)
    CidEvidenceWrite(
        artifactRoot, "artifacts/zero-entry-trace.json", zeroTrace, files)

    let missingRoot = chengpath.PathJoin(caseRoot, "missing-probe-root")
    let missingSourceRoot = chengpath.PathJoin(missingRoot, "src")
    let missingSourcePath = chengpath.PathJoin(missingSourceRoot, "missingprobe.cheng")
    os.MkdirAll(missingSourceRoot, 493)
    os.WriteFile(
        chengpath.PathJoin(missingRoot, "cheng-package.toml"),
        "package_id = \"cheng/compiler\"\n")
    os.WriteFile(
        missingSourcePath,
        "import cheng/compiler/absent\n\nfn Probe(): int32 = 0\n")
    let missingRequest = creq.CompilerRequestNew(
        share(missingRoot),
        missingSourcePath,
        chengpath.PathJoin(missingRoot, "missing.o"),
        "x86_64-unknown-linux-gnu",
        creq.EmitObj,
        "")
    var missingPlan: slplan.SystemLinkPlanStub
    var missingErr = ""
    if slplan.BuildSystemLinkPlanStub(
            missingRoot, missingRequest, missingPlan, missingErr):
        return Err[bool]("CID evidence: missing import unexpectedly succeeded")
    if missingErr == "":
        return Err[bool]("CID evidence: missing import returned empty error")
    let missingProjection = CidEvidenceJoin([
        "{",
        "\"exit_code\":1,",
        "\"missing_module_path\":\"cheng/compiler/absent\",",
        "\"schema\":\"cheng.cid.missing_file_probe\",",
        "\"stderr_sha256\":\"", strings.Sha256(missingErr), "\",",
        "\"stdout_sha256\":\"", strings.Sha256(""), "\"",
        "}"])
    let missingTrace = CidEvidenceJoin([
        "{",
        "\"exit_code\":1,",
        "\"manifest_sha256\":\"", strings.Sha256(missingProjection), "\",",
        "\"missing_module_path\":\"cheng/compiler/absent\",",
        "\"schema\":\"cheng.cid.missing_file_probe\",",
        "\"stderr_sha256\":\"", strings.Sha256(missingErr), "\",",
        "\"stdout_sha256\":\"", strings.Sha256(""), "\"",
        "}\n"])
    CidEvidenceWrite(
        artifactRoot, "artifacts/missing-probe.stdout", "", files)
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/missing-probe.stderr",
        missingErr,
        files)
    CidEvidenceWrite(
        artifactRoot,
        "artifacts/missing-probe-trace.json",
        missingTrace,
        files)
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var caseRoot = ""
    var artifactRoot = ""
    var compiledOutput = ""
    var evidencePrefix = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--case-root", caseRoot) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--compiled-output", compiledOutput) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix):
        os.WriteLine(os.Get_stderr(), "CID evidence: missing required flag")
        return 2
    if caseId == "" || caseRoot == "" || artifactRoot == "" ||
       compiledOutput == "" || evidencePrefix == "":
        os.WriteLine(os.Get_stderr(), "CID evidence: empty required flag")
        return 2
    if caseId != "zero-byte-import":
        os.WriteLine(os.Get_stderr(), "CID evidence: specialized case required")
        return 17
    var files: str[]
    let result = CidEvidenceZeroProbeArtifacts(caseRoot, artifactRoot, files)
    if IsErr(result):
        os.WriteLine(os.Get_stderr(), Error(result))
        return 1
    return 0
