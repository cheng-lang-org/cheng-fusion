import std/os
import cheng/core/lang/parser as parser

fn main() =
    let sourcePaths = [
        "src/core/runtime/core_runtime.cheng",
        "src/core/runtime/debug_runtime_provider.cheng",
        "src/core/runtime/program_support_backend.cheng",
        "src/core/runtime/program_support_host_runtime.cheng"
    ]
    var err: str
    for sourceIndex in 0..<sourcePaths.len:
        let sourcePath = sourcePaths[sourceIndex]
        let sourceText = os.ReadFile(sourcePath)
        assert(sourceText != "",
               Fmt"parser provider binding block smoke: source missing {sourcePath}")
        var tree: parser.ParserValueExprTree
        assert(parser.ParserValueExprReadTreeFromText(sourceText, tree, err) &&
               parser.ParserValueExprTreeDeclarationsStrictValidateInto(
                   tree, err) &&
               parser.ParserValueExprTreePatternsStrictValidateInto(tree, err),
               Fmt"parser provider binding block smoke: parse {sourcePath}: {err}")
        parser.ParserValueExprTreeRelease(tree)
    echo("parser_provider_binding_block_sources=4")
    echo("parser_provider_binding_block_smoke: ok")
