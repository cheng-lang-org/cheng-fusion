# libp2p P3 收尾片: 撤销新鲜度动词 (REVOKE_REQ/REVOKE_RESP) 线格式往返 + 畸形硬拒 (正典 §11.6 P3)。
# 自足 exe (无网络无状态), 断言失败即 abort 非零, 末行 "ok" 才打印。照 cas_head_transport_codec 模式。
# 覆盖: REQ 往返 (65B/tag 0x21); RESP found 往返 (171B/tag 0x22/status 1); RESP miss (2B/status 0);
#       畸形穷举 (REQ 长/tag/字段; RESP 截断/tag/status 非法/found 帧长/miss 尾残/撤销 wire 非 169) 一律拒。

import std/system
import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/protocols/cas_source/channel_head/revoke_transport_codec as rt

fn mkCid(seed: int32): layout.FixedBytes32 =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed * 17 + i + 3) & 255)
    let r = layout.FixedBytes32FromBytes(b)
    assert(!IsErr(r), " mkCid 32B")
    return Value(r)

fn mkWire169(seed: int32): Bytes =
    var b = BytesAlloc(169)
    for i in 0..<169:
        BytesSet(b, i, (seed * 7 + i) & 255)
    BytesSet(b, 0, 0x20)   # 撤销记录 tag
    return b

fn main(): int32 =
    # ---- REVOKE_REQ 往返 ----
    let cid = mkCid(11)
    let tgt = mkCid(29)
    var reqWire = rt.RevokeReqEncode(cid, tgt)
    assert(BytesLen(reqWire) == 65, " REQ wire = 65B")
    assert(BytesGet(reqWire, 0) == 0x21, " REQ tag 0x21")
    var reqDecRes = rt.RevokeReqDecode(reqWire)
    assert(!IsErr(reqDecRes), " REQ decode ok: " + Error(reqDecRes))
    var reqDec = Value(reqDecRes)
    assert(layout.FixedBytes32Equal(reqDec.channelId, cid), " REQ 往返 channelId 精确")
    assert(layout.FixedBytes32Equal(reqDec.targetPubKey, tgt), " REQ 往返 targetPubKey 精确")

    # REQ 畸形: 长度错 / tag 错
    assert(IsErr(rt.RevokeReqDecode(BytesSlice(reqWire, 0, 64))), " REQ 畸形: 64B 截断拒")
    var reqBadTag = BytesAlloc(65)
    for i in 0..<65:
        BytesSet(reqBadTag, i, BytesGet(reqWire, i))
    BytesSet(reqBadTag, 0, 0x11)   # 冒充 HEAD_REQ tag
    assert(IsErr(rt.RevokeReqDecode(reqBadTag)), " REQ 畸形: tag 非 0x21 拒")
    # 隔离对照: tag 恢复 0x21 → decode 应过 (只有 tag 变量触发拒绝)
    BytesSet(reqBadTag, 0, 0x21)
    assert(!IsErr(rt.RevokeReqDecode(reqBadTag)), " 对照: tag 恢复 0x21 → decode 过")

    # ---- REVOKE_RESP found 往返 ----
    var rw = mkWire169(23)
    var respFoundRes = rt.RevokeRespEncodeFound(rw)
    assert(!IsErr(respFoundRes), " RESP found encode: " + Error(respFoundRes))
    var respFound = Value(respFoundRes)
    assert(BytesLen(respFound) == 171, " RESP found = 171B")
    assert(BytesGet(respFound, 0) == 0x22, " RESP tag 0x22")
    assert(BytesGet(respFound, 1) == 1, " RESP status 1 (found)")
    var rfDecRes = rt.RevokeRespDecode(respFound)
    assert(!IsErr(rfDecRes), " RESP found decode: " + Error(rfDecRes))
    var rfDec = Value(rfDecRes)
    assert(rfDec.found, " RESP found decode.found == true")
    assert(rawbytes.BytesEqual(rfDec.recordWire, rw), " RESP found 往返 撤销 wire 精确")

    # RESP found encode 拒非 169B 撤销 wire
    assert(IsErr(rt.RevokeRespEncodeFound(BytesAlloc(168))), " RESP found encode 拒 168B 撤销 wire")

    # ---- REVOKE_RESP miss 往返 ----
    var respMiss = rt.RevokeRespEncodeMiss()
    assert(BytesLen(respMiss) == 2, " RESP miss = 2B")
    assert(BytesGet(respMiss, 1) == 0, " RESP miss status 0")
    var rmDecRes = rt.RevokeRespDecode(respMiss)
    assert(!IsErr(rmDecRes), " RESP miss decode")
    assert(!Value(rmDecRes).found, " RESP miss decode.found == false")

    # ---- RESP 畸形穷举 ----
    assert(IsErr(rt.RevokeRespDecode(BytesAlloc(1))), " RESP 畸形: 1B header 截断拒")
    var respBadTag = BytesAlloc(2)
    BytesSet(respBadTag, 0, 0x99)
    assert(IsErr(rt.RevokeRespDecode(respBadTag)), " RESP 畸形: tag 非 0x22 拒")
    var respBadStatus = BytesAlloc(2)
    BytesSet(respBadStatus, 0, 0x22)
    BytesSet(respBadStatus, 1, 0x05)   # status 非 0/1
    assert(IsErr(rt.RevokeRespDecode(respBadStatus)), " RESP 畸形: status 非 0/1 拒")
    # found 但帧长非 171 (status=1, 只给 10 字节)
    var respShort = BytesAlloc(10)
    BytesSet(respShort, 0, 0x22)
    BytesSet(respShort, 1, 0x01)
    assert(IsErr(rt.RevokeRespDecode(respShort)), " RESP 畸形: found 帧长非 171 拒")
    # miss 但帧长非 2 (status=0, 给 5 字节尾残)
    var respMissLong = BytesAlloc(5)
    BytesSet(respMissLong, 0, 0x22)
    BytesSet(respMissLong, 1, 0x00)
    assert(IsErr(rt.RevokeRespDecode(respMissLong)), " RESP 畸形: miss 帧长非 2 拒 (尾残)")

    echo(" revoke_transport_codec_roundtrip_smoke ok")
    return 0
