import std/system
import std/rawbytes
import std/result
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/libp2p/core/types
import cheng/libp2p/transports/quic_transport as qt

# DONE-drop fault-injection client. Dials the drop-injecting server N times and
# verifies each payload arrives. Each dial exercises a handshake whose
# HANDSHAKE_DONE was dropped server-side, so success proves the loss-recovery
# path completes the handshake instead of stalling.
fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", -1)
    let rounds = cmdline.ReadInt32FlagOrDefault("--rounds", 5)
    assert(port > 0, " done_drop_client: port")

    let expected: rawbytes.Bytes = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(expected, i, (0x40 + i) & 0xff)

    var round: int32 = 0
    while round < rounds:
        let recvRes = qt.Libp2pQuicRecvPayloadOnce("127.0.0.1", port, types.Libp2pProtocolSync)
        if IsErr(recvRes):
            panic(strutil.Join(["done_drop_client: round=", IntToStr(round), " recv_err=", ErrorText(recvRes)], ""))
        let got = Value(recvRes)
        if BytesLen(got) != BytesLen(expected):
            panic(strutil.Join(["done_drop_client: round=", IntToStr(round), " len_mismatch got=", IntToStr(BytesLen(got))], ""))
        for i in 0..<BytesLen(expected):
            if BytesGet(got, i) != BytesGet(expected, i):
                panic(strutil.Join(["done_drop_client: round=", IntToStr(round), " byte_mismatch at=", IntToStr(i)], ""))
        round = round + 1

    echo(" quic_handshake_done_drop_client ok")
    return 0
