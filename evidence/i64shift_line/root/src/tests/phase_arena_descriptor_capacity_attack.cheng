import cheng/core/ir/phase_arena as phase

fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 32, 1)
    let arena = phase.PhaseArenaStoreOpenArena(store, 1, 32, 1)
    let first = phase.PhaseArenaStoreAllocRef(store, arena, 8)
    phase.PhaseArenaStoreGetByte(store, arena, first, 0)
    let second = phase.PhaseArenaStoreAllocRef(store, arena, 8)
    return phase.PhaseArenaStoreGetByte(store, arena, second, 0)
