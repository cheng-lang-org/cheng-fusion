import std/strings
import std/rawbytes
import cheng/game/assets/semantic_video/schema
import cheng/game/assets/semantic_video/writer
import cheng/game/assets/semantic_video/reader
import cheng/game/assets/semantic_video/validator

# B1 往返验收：构建全部 10 类记录 → writer 打包 → validator 通过 →
# reader 解回 → 重新发射再打包，字节逐一相等（规范化一致）。

fn buildCid(seed: str): str =
    return writer.SvContentCid(seed)

@borrows
fn buildSet(): writer.SvLineSet =
    var set = writer.SvLineSetInit()
    var manifest: schema.SvManifestRec
    add(manifest.caps, strings.CloneStr(schema.SvCapCommonCore))
    add(manifest.caps, strings.CloneStr(schema.SvCapSemanticDescription))
    add(manifest.caps, strings.CloneStr(schema.SvCapWorldExecution))
    let resCid = buildCid("video-resource")
    add(manifest.resCid, strings.CloneStr(resCid))
    add(manifest.resLength, int64(1024))
    add(manifest.resType, strings.CloneStr("video_sample"))
    manifest.entrySnapshot = strings.CloneStr("ck-root")
    manifest.tbNum = 1
    manifest.tbDen = 90000
    manifest.timeStart = int64(0)
    manifest.timeEnd = int64(900000)
    let preLine = schema.SvManifestLine(manifest)
    manifest.contentId = strings.CloneStr(writer.SvContentCid(preLine))
    writer.SvAddManifest(set, manifest)

    var entity: schema.SvEntityRec
    entity.ns = strings.CloneStr("demo")
    entity.gen = int64(0)
    entity.num = 1
    entity.typeVer = strings.CloneStr("person@v1")
    entity.lifecycle = strings.CloneStr(schema.SvLifecycleActive)
    writer.SvAddEntity(set, entity)

    var observation: schema.SvObservationRec
    observation.obsId = strings.CloneStr("obs-0")
    observation.sensor = strings.CloneStr("cam-front")
    observation.srcTrack = strings.CloneStr("v:0")
    observation.sourceClass = strings.CloneStr(schema.SvSourceObserved)
    observation.method = strings.CloneStr("demux@v1")
    observation.tbNum = 1
    observation.tbDen = 90000
    observation.tickStart = int64(0)
    observation.tickEnd = int64(900000)
    writer.SvAddObservation(set, observation)

    var assertionOld: schema.SvAssertionRec
    assertionOld.uid = strings.CloneStr("asv-0000")
    assertionOld.obj = strings.CloneStr(schema.SvEntityUid(entity))
    assertionOld.pred = strings.CloneStr(schema.SvPredObjectTrack)
    assertionOld.val = strings.CloneStr("t0")
    assertionOld.confBp = 9000
    assertionOld.confDef = strings.CloneStr("frames with IoU>0.5")
    assertionOld.rev = 0
    assertionOld.sourceClass = strings.CloneStr(schema.SvSourceInferred)
    assertionOld.method = strings.CloneStr("demo-model@0.1")
    assertionOld.tbNum = 1
    assertionOld.tbDen = 90000
    assertionOld.tickStart = int64(0)
    assertionOld.tickEnd = int64(900000)
    writer.SvAddAssertion(set, assertionOld)

    var assertionNew: schema.SvAssertionRec
    assertionNew.uid = strings.CloneStr("asv-0001")
    assertionNew.obj = strings.CloneStr(schema.SvEntityUid(entity))
    assertionNew.pred = strings.CloneStr(schema.SvPredObjectTrack)
    assertionNew.val = strings.CloneStr("t0-corrected")
    assertionNew.confBp = 9500
    assertionNew.confDef = strings.CloneStr("frames with IoU>0.5")
    assertionNew.rev = 1
    assertionNew.sourceClass = strings.CloneStr(schema.SvSourceInferred)
    assertionNew.method = strings.CloneStr("demo-model@0.2")
    assertionNew.tbNum = 1
    assertionNew.tbDen = 90000
    assertionNew.tickStart = int64(0)
    assertionNew.tickEnd = int64(900000)
    writer.SvAddAssertion(set, assertionNew)

    var snapshot: schema.SvSnapshotRec
    snapshot.branch = strings.CloneStr("main")
    snapshot.ckpt = strings.CloneStr("ck-root")
    snapshot.tick = int64(0)
    snapshot.worldCid = strings.CloneStr(buildCid("world-state"))
    snapshot.tbNum = 1
    snapshot.tbDen = 90000
    writer.SvAddSnapshot(set, snapshot)

    var delta0: schema.SvDeltaRec
    delta0.baseCkpt = strings.CloneStr("ck-root")
    delta0.toCkpt = strings.CloneStr("ck-1")
    delta0.seqNum = int64(0)
    delta0.opsCid = strings.CloneStr(buildCid("ops-0"))
    delta0.tbNum = 1
    delta0.tbDen = 90000
    delta0.tickStart = int64(0)
    delta0.tickEnd = int64(1000)
    writer.SvAddDelta(set, delta0)

    var delta1: schema.SvDeltaRec
    delta1.baseCkpt = strings.CloneStr("ck-1")
    delta1.toCkpt = strings.CloneStr("ck-2")
    delta1.seqNum = int64(1)
    delta1.opsCid = strings.CloneStr(buildCid("ops-1"))
    delta1.tbNum = 1
    delta1.tbDen = 90000
    delta1.tickStart = int64(1000)
    delta1.tickEnd = int64(2000)
    writer.SvAddDelta(set, delta1)

    var correction: schema.SvCorrectionRec
    correction.obsRef = strings.CloneStr("obs-0")
    correction.spaceDomain = strings.CloneStr("full-frame")
    correction.basisCid = strings.CloneStr(buildCid("basis"))
    correction.payloadCid = strings.CloneStr(buildCid("payload"))
    correction.tbNum = 1
    correction.tbDen = 90000
    correction.tickStart = int64(0)
    correction.tickEnd = int64(900000)
    writer.SvAddCorrection(set, correction)

    var dependency: schema.SvDependencyRec
    dependency.consumer = strings.CloneStr("player")
    dependency.purpose = strings.CloneStr("render")
    dependency.queryBasis = strings.CloneStr("q-all")
    dependency.target = strings.CloneStr(schema.SvEntityUid(entity))
    dependency.targetVer = strings.CloneStr("v1")
    writer.SvAddDependency(set, dependency)

    var revision: schema.SvRevisionRec
    revision.targetUid = strings.CloneStr("asv-0001")
    revision.supersedes = strings.CloneStr("asv-0000")
    revision.oldRev = 0
    revision.newRev = 1
    revision.publishedTick = int64(100)
    revision.reason = strings.CloneStr("late recognition fix")
    revision.tbNum = 1
    revision.tbDen = 90000
    writer.SvAddRevision(set, revision)

    var receipt: schema.SvReceiptRec
    add(receipt.capReq, strings.CloneStr(schema.SvCapCommonCore))
    add(receipt.capReq, strings.CloneStr(schema.SvCapSemanticDescription))
    add(receipt.capVerified, strings.CloneStr(schema.SvCapCommonCore))
    add(receipt.capVerified, strings.CloneStr(schema.SvCapSemanticDescription))
    receipt.configCid = strings.CloneStr(buildCid("config"))
    receipt.implCid = strings.CloneStr(buildCid("impl"))
    receipt.subjectCid = strings.CloneStr(buildCid("subject"))
    receipt.summaryCid = strings.CloneStr(buildCid("summary"))
    receipt.result = strings.CloneStr(schema.SvResultPass)
    writer.SvAddReceipt(set, receipt)
    return set

fn main(): int32 =
    var set = buildSet()
    assert(set.lines.len == 12, " record count")
    assert(set.error.len == 0, " set error")
    let encoded = writer.SvWriterEncode(set)
    assert(encoded.ok, schema.SvCat(" encode: ", encoded.error))
    assert(encoded.factCount == 12, " fact count")

    let validation = validator.SvValidate(encoded.bytes)
    assert(validation.ok,
        schema.SvCat(" validate: ", validation.error))
    assert(validation.ignoredExtensions.len == 0, " no ignored")

    let decoded = reader.SvReaderDecode(encoded.bytes)
    assert(decoded.ok, schema.SvCat(" decode: ", decoded.error))
    let parsed = reader.SvParseRecords(decoded.lines)
    assert(parsed.ok, schema.SvCat(" parse: ", parsed.error))
    let records = parsed.records
    assert(records.manifests.len == 1, " manifest")
    assert(records.entities.len == 1, " entity")
    assert(records.observations.len == 1, " observation")
    assert(records.assertions.len == 2, " assertion")
    assert(records.snapshots.len == 1, " snapshot")
    assert(records.deltas.len == 2, " delta")
    assert(records.corrections.len == 1, " correction")
    assert(records.dependencies.len == 1, " dependency")
    assert(records.revisions.len == 1, " revision")
    assert(records.receipts.len == 1, " receipt")
    assert(records.entities[0].ns == "demo", " entity ns")
    assert(records.deltas[1].toCkpt == "ck-2" ||
        records.deltas[0].toCkpt == "ck-2", " delta chain")

    # 重新发射：解析出的记录再走 writer，字节与首次打包逐一相等。
    var rebuild = writer.SvLineSetInit()
    writer.SvAddManifest(rebuild, records.manifests[0])
    writer.SvAddEntity(rebuild, records.entities[0])
    writer.SvAddObservation(rebuild, records.observations[0])
    writer.SvAddAssertion(rebuild, records.assertions[0])
    writer.SvAddAssertion(rebuild, records.assertions[1])
    writer.SvAddSnapshot(rebuild, records.snapshots[0])
    writer.SvAddDelta(rebuild, records.deltas[0])
    writer.SvAddDelta(rebuild, records.deltas[1])
    writer.SvAddCorrection(rebuild, records.corrections[0])
    writer.SvAddDependency(rebuild, records.dependencies[0])
    writer.SvAddRevision(rebuild, records.revisions[0])
    writer.SvAddReceipt(rebuild, records.receipts[0])
    let reencoded = writer.SvWriterEncode(rebuild)
    assert(reencoded.ok,
        schema.SvCat(" reencode: ", reencoded.error))
    assert(rawbytes.BytesEqual(encoded.bytes, reencoded.bytes),
        " canonical roundtrip byte-identical")

    # 重复打包确定性：同输入两次编码逐字节相等。
    let again = writer.SvWriterEncode(set)
    assert(again.ok, " again encode")
    assert(rawbytes.BytesEqual(encoded.bytes, again.bytes),
        " deterministic encode")

    echo(" sv_b1_roundtrip_smoke ok")
    return 0
