import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/tooling/compiler_world
import cheng/core/tooling/semantic_snapshot_declaration_identity as declaration

fn TestCid(label: str): layout.FixedBytes32 =
    var bytes = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(bytes, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn Append(
        store: var declaration.SemanticSnapshotDeclarationCandidateStore,
        documentCid: layout.FixedBytes32,
        owner: int32,
        kind: int32,
        name: str,
        scopeCid: layout.FixedBytes32): int32 =
    var row: int32
    var err: str
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/bindings", documentCid, "", owner,
               kind,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               name, TestCid(Fmt"proof/{name}"), TestCid(Fmt"type/{name}"),
               scopeCid, 1, 2, row, err), err)
    return row

fn main() =
    var documentCid: layout.FixedBytes32
    var err: str
    assert(compiler_world.CompilerWorldDocumentCidInto(
               "pkg", "pkg/bindings", documentCid, err), err)
    var store: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(store)
    var moduleCandidate: int32
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               store, "pkg", "pkg/bindings", documentCid, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/bindings", documentCid, documentCid,
               layout.FixedBytes32(), 0, 0, moduleCandidate, err), err)
    let globalCandidate = Append(
        store, documentCid, moduleCandidate,
        declaration.SemanticSnapshotDeclarationKindGlobal,
        "globalValue", layout.FixedBytes32())
    let constCandidate = Append(
        store, documentCid, moduleCandidate,
        declaration.SemanticSnapshotDeclarationKindConst,
        "constantValue", layout.FixedBytes32())
    let functionCandidate = Append(
        store, documentCid, moduleCandidate,
        declaration.SemanticSnapshotDeclarationKindFunction,
        "Run", layout.FixedBytes32())
    let localCandidate = Append(
        store, documentCid, functionCandidate,
        declaration.SemanticSnapshotDeclarationKindLocal,
        "localValue", TestCid("scope/run/block"))
    var declarations: declaration.SemanticSnapshotDeclarationTable
    var mapping: declaration.SemanticSnapshotDeclarationMappingReceipt
    assert(declaration.SemanticSnapshotDeclarationTableSealInto(
               store, declarations, mapping, err), err)

    let candidates = [moduleCandidate, globalCandidate, constCandidate,
                      functionCandidate, localCandidate]
    let symbolKinds = [schema.CsgCompilerSymbolModule,
                       schema.CsgCompilerSymbolLocal,
                       schema.CsgCompilerSymbolLocal,
                       schema.CsgCompilerSymbolFunction,
                       schema.CsgCompilerSymbolLocal]
    let ownerSymbols = [-1, 0, 0, 0, 3]
    var tables: schema.CsgCompilerSnapshotTables
    tables.declarations = declarations
    add(tables.sources.documentCids, documentCid)
    for symbolId in 0..<candidates.len:
        let declId = mapping.producerCandidateToDeclIds[candidates[symbolId]]
        let key = declarations.declKeyCids[declId]
        add(tables.symbols.symbolCids, key)
        add(tables.symbols.declIds, declId)
        add(tables.symbols.declKeyCids, key)
        add(tables.symbols.sourceIds, 0)
        add(tables.symbols.symbolKinds, symbolKinds[symbolId])
        add(tables.symbols.ownerSymbolIds, ownerSymbols[symbolId])
    for symbolId in 0..<candidates.len:
        var observed: layout.FixedBytes32
        assert(schema.CsgCompilerSymbolRowCidInto(
                   tables, symbolId, observed, err), err)
        assert(layout.FixedBytes32Equal(
                   observed, tables.symbols.declKeyCids[symbolId]),
               "binding kind smoke: SymbolCid/DeclKey split")

    tables.symbols.symbolKinds[1] = schema.CsgCompilerSymbolFunction
    var rejected: layout.FixedBytes32
    assert(!schema.CsgCompilerSymbolRowCidInto(
               tables, 1, rejected, err),
           "binding kind smoke: Global accepted as Function")
    echo("csg_compiler_symbol_binding_kind_smoke: ok")

main()
