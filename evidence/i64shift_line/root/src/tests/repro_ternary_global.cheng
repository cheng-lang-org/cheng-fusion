import std/os as os

var gNonce: uint64

type
    Slot =
        nonce: uint64
        other: uint64

fn begin(cond: int32, slot: var Slot) =
    slot.nonce = cond == 1 ? gNonce : uint64(0)
    slot.other = uint64(7)

fn main(): int32 =
    gNonce = uint64(42)
    var s: Slot
    begin(0, s)
    if s.nonce == uint64(0) && s.other == uint64(7):
        os.WriteLine(os.Get_stdout(), "ternary-ok")
        return 0
    os.WriteLine(os.Get_stdout(), "ternary-bad")
    return 1
