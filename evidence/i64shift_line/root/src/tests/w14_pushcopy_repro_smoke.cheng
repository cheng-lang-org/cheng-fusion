# w14-pushcopy runtime repro/mutation smoke.
#
# Exercises the REAL zeroqueue.pushCopy (not a look-alike): a struct-typed
# whole aggregate constructor `Chunk(data: bytesClone(b), size: size, start: 0)`
# stored into a fixed-size struct array field element `q.chunks[q.tail]`
# (elemSize=24, value type=Aggregate). Before the primary_object_plan.cheng
# IndexedStore elemSize==24 fix, this shape hit an uncovered branch in both
# the word-count predictor and the AArch64 emitter (`return 0` / `return -1`
# for any value type other than Ptr/Str), producing plan_not_ready
# (bail family K, pushCopy).
#
# Verifies: (1) queue bookkeeping (count/tail) advances, (2) the stored
# Chunk's size/start fields are correct, (3) the byte payload is copied
# correctly, and (4) - the mutation check - the stored bytes are an
# INDEPENDENT clone: mutating the source buffer after the push must NOT
# change what is stored in the queue (this is exactly what `bytesClone`
# inside the aggregate constructor is supposed to guarantee; a wrong/short
# chunk-copy in the codegen fix would either crash, corrupt neighbor
# fields, or silently alias the source buffer, and this check would catch
# any of those). Field access is kept inline (`q.chunks[i].field`) rather
# than bound to a local `Chunk` variable, to stay clear of an unrelated
# cold-frontend `let x: AggregateType = <indexed-load>` quirk.

import std/rawbytes
import std/result
import std/net/utils/zeroqueue

fn main(): int32 =
    var q = initZeroQueue()
    var src: Bytes = BytesAlloc(3)
    BytesSet(src, 0, 65)
    BytesSet(src, 1, 66)
    BytesSet(src, 2, 67)

    let pushRes: Result[bool] = pushCopy(q, src)
    if IsErr(pushRes):
        echo("w14_pushcopy_repro_smoke fail: pushCopy returned Err")
        return 1

    if q.count != 1:
        echo("w14_pushcopy_repro_smoke fail: count")
        return 2
    if q.tail != 1:
        echo("w14_pushcopy_repro_smoke fail: tail")
        return 3
    if q.chunks[0].size != 3:
        echo("w14_pushcopy_repro_smoke fail: size")
        return 4
    if q.chunks[0].start != 0:
        echo("w14_pushcopy_repro_smoke fail: start")
        return 5
    if BytesLen(q.chunks[0].data) != 3:
        echo("w14_pushcopy_repro_smoke fail: data len")
        return 6
    if BytesGet(q.chunks[0].data, 0) != 65 || BytesGet(q.chunks[0].data, 1) != 66 || BytesGet(q.chunks[0].data, 2) != 67:
        echo("w14_pushcopy_repro_smoke fail: data bytes before mutation")
        return 7

    # Mutation check: clobber the SOURCE buffer after the push. If the
    # aggregate constructor's `bytesClone(b)` degraded into an alias (or a
    # partial/garbage copy), this mutation would leak into the stored chunk.
    BytesSet(src, 0, 90)
    BytesSet(src, 1, 90)
    BytesSet(src, 2, 90)

    if BytesGet(q.chunks[0].data, 0) != 65 || BytesGet(q.chunks[0].data, 1) != 66 || BytesGet(q.chunks[0].data, 2) != 67:
        echo("w14_pushcopy_repro_smoke fail: stored chunk aliased source after mutation")
        return 8

    # Push a second chunk and confirm the queue keeps advancing correctly
    # (exercises a second write to a different fixed-array element, q.chunks[1]).
    var src2: Bytes = BytesAlloc(2)
    BytesSet(src2, 0, 1)
    BytesSet(src2, 1, 2)
    let pushRes2: Result[bool] = pushCopy(q, src2)
    if IsErr(pushRes2):
        echo("w14_pushcopy_repro_smoke fail: second pushCopy returned Err")
        return 9
    if q.count != 2 || q.tail != 2:
        echo("w14_pushcopy_repro_smoke fail: second push bookkeeping")
        return 10
    if q.chunks[1].size != 2 || BytesGet(q.chunks[1].data, 0) != 1 || BytesGet(q.chunks[1].data, 1) != 2:
        echo("w14_pushcopy_repro_smoke fail: second chunk payload")
        return 11
    # First chunk must be untouched by the second push.
    if BytesGet(q.chunks[0].data, 0) != 65 || BytesGet(q.chunks[0].data, 1) != 66 || BytesGet(q.chunks[0].data, 2) != 67:
        echo("w14_pushcopy_repro_smoke fail: first chunk clobbered by second push")
        return 12

    # Push a third chunk (4 bytes) and cross-check all three elements stay
    # independent (elemSize=24 index*24 addressing across index 0/1/2).
    var src3: Bytes = BytesAlloc(4)
    BytesSet(src3, 0, 10)
    BytesSet(src3, 1, 20)
    BytesSet(src3, 2, 30)
    BytesSet(src3, 3, 40)
    let pushRes3: Result[bool] = pushCopy(q, src3)
    if IsErr(pushRes3):
        echo("w14_pushcopy_repro_smoke fail: third pushCopy returned Err")
        return 13
    if q.count != 3 || q.tail != 3:
        echo("w14_pushcopy_repro_smoke fail: third push bookkeeping")
        return 14
    if q.chunks[2].size != 4 || BytesGet(q.chunks[2].data, 0) != 10 || BytesGet(q.chunks[2].data, 1) != 20 || BytesGet(q.chunks[2].data, 2) != 30 || BytesGet(q.chunks[2].data, 3) != 40:
        echo("w14_pushcopy_repro_smoke fail: third chunk payload")
        return 15
    if BytesGet(q.chunks[0].data, 0) != 65 || BytesGet(q.chunks[0].data, 1) != 66 || BytesGet(q.chunks[0].data, 2) != 67:
        echo("w14_pushcopy_repro_smoke fail: first chunk clobbered by third push")
        return 16
    if q.chunks[1].size != 2 || BytesGet(q.chunks[1].data, 0) != 1 || BytesGet(q.chunks[1].data, 1) != 2:
        echo("w14_pushcopy_repro_smoke fail: second chunk clobbered by third push")
        return 17

    echo("w14_pushcopy_repro_smoke ok")
    return 0
