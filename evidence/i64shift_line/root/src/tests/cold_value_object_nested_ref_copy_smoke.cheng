import std/system

type
    ColdNestedCopySession = ref object
        value: int32

    ColdNestedCopyInner =
        session: ColdNestedCopySession

    ColdNestedCopyOuter =
        inner: ColdNestedCopyInner

fn copyRefCountFromVar(source: var ColdNestedCopyOuter): int32 =
    var copied = source
    if copied.inner.session != source.inner.session:
        return -1
    return memRefCount(source.inner.session)

fn main(): int32 =
    var source: ColdNestedCopyOuter
    source.inner.session = new(ColdNestedCopySession)
    source.inner.session.value = 17
    if memRefCount(source.inner.session) != 1:
        return 1

    var copied = source
    if copied.inner.session != source.inner.session:
        return 2
    if copied.inner.session.value != 17:
        return 3
    if memRefCount(source.inner.session) != 2:
        return 4
    if copyRefCountFromVar(source) != 3:
        return 5
    return 0
