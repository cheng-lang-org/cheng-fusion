import cheng/tests/csg_compiler_snapshot_schema_smoke as schema_smoke

fn SnapshotBuilderSmokeCid(first: int32,
                           second: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(first & 255)
    out.data[1] = uint8(second & 255)
    return out

fn SnapshotBuilderSmokeDocumentCid(modulePath: str): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    var err: str
    assert(compiler_world.CompilerWorldDocumentCidInto(
               "pkg", modulePath, out, err), err)
    return out

fn SnapshotBuilderSmokeSource(index: int32): str =
    if index == 0:
        return "fn same(borrowed: var int32, plain: int32): int32 =\n    let shared = 1\n    return shared\ntype Alpha = int32\ntype Gamma = str\n"
    return "fn same(managed: str): str =\n    let shared = Fmt\"{1}\"\n    return shared\ntype Beta = str\n"

fn SnapshotBuilderSmokeTypeArenaFromSources(
        firstSource: str,
        secondSource: str,
        out: var typearena.TypedExprTypeArena) =
    var forest: parser.ParserValueExprTree
    var arenaErr: str
    for producerSourceIndex in 0..<2:
        var layer: parser.NormalizedExprLayer
        assert(parser.ParserReadNormalizedExprLayerFromText(
                   producerSourceIndex == 0 ?
                       "/workspace/a.cheng" :
                       "/workspace/b.cheng",
                   producerSourceIndex == 0 ? firstSource : secondSource,
                   layer,
                   arenaErr),
               Fmt"compiler snapshot builder smoke: TypeArena parser failed {arenaErr}")
        parser.ParserValueExprTreeAppendFrom(forest, layer.valueExprTree)
        parser.NormalizedExprLayerReset(layer)
    var imports: typearena.TypedExprTypeImportAuthority
    imports.sealed = true
    var authority: typearena.TypedExprTypeResolutionAuthority
    assert(typearena.TypedExprTypeResolutionAuthorityBuildPackageForestInto(
               forest, imports, authority, arenaErr),
           Fmt"compiler snapshot builder smoke: TypeArena authority failed {arenaErr}")
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               forest, authority, out, arenaErr) &&
           typearena.TypedExprTypeArenaStrictValidateInto(out, arenaErr),
           Fmt"compiler snapshot builder smoke: TypeArena build failed {arenaErr}")
    parser.ParserValueExprTreeRelease(forest)

fn SnapshotBuilderSmokeSidecar(index: int32):
        parser_receipt.ParserCanonicalSourceSidecar =
    let source = SnapshotBuilderSmokeSource(index)
    let sourcePath = index == 0 ?
        "/workspace/a.cheng" : "/workspace/b.cheng"
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(
               sourcePath, source, layer, err),
           Fmt"compiler snapshot builder smoke: parse failed {err}")
    assert(layer.valueExprTree != nil &&
           layer.valueExprTree.nodeCount > 0 &&
           layer.valueExprTree.tokenCount > 0,
           "compiler snapshot builder smoke: parser rows missing")
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    let functionName = "same"
    let ownerModulePath = index == 0 ?
        "pkg/zeta_alpha_6" : "pkg/alpha_beta"
    add(identities,
        parser_receipt.ParserNormalizedExprFunctionIdentityMake(
            index,
            index,
            sourcePath,
            ownerModulePath,
            functionName,
            1,
            3))
    var declarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               source, declarations, err),
           Fmt"compiler snapshot builder smoke: declarations failed {err}")
    var sidecar: parser_receipt.ParserCanonicalSourceSidecar
    assert(parser_receipt.ParserCanonicalSourceSidecarBuildInto(
               index,
               source,
               source,
               layer.valueExprTree,
               identities,
               declarations,
               sidecar,
               err),
           Fmt"compiler snapshot builder smoke: sidecar build failed {err}")
    assert(parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err),
           Fmt"compiler snapshot builder smoke: sidecar invalid {err}")
    parser.NormalizedExprLayerReset(layer)
    return sidecar

fn SnapshotBuilderSmokeInputs(
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: var builder.CompilerSnapshotCanonicalSourceRow[],
        completeTexts: var str[],
        completeSpans: var builder.CompilerSnapshotCanonicalSpanInput[]) =
    add(sidecars, SnapshotBuilderSmokeSidecar(0))
    add(sidecars, SnapshotBuilderSmokeSidecar(1))
    # Producer order is alpha,beta; canonical document order is beta,alpha.
    var first: builder.CompilerSnapshotCanonicalSourceRow
    first.documentCid = SnapshotBuilderSmokeDocumentCid("pkg/alpha_beta")
    first.producerSourceIndex = 1
    first.modulePath = "pkg/alpha_beta"
    first.contentCid = sidecars[1].sourceContentRaw32
    add(sourceRows, first)
    var second: builder.CompilerSnapshotCanonicalSourceRow
    second.documentCid = SnapshotBuilderSmokeDocumentCid("pkg/zeta_alpha_6")
    second.producerSourceIndex = 0
    second.modulePath = "pkg/zeta_alpha_6"
    second.contentCid = sidecars[0].sourceContentRaw32
    add(sourceRows, second)
    add(completeTexts, "zz semantic text")
    add(completeTexts, " future semantic text")
    add(completeTexts, "zz semantic text")
    # Qualified symbol names are semantic (non-parser) texts; the canonical
    # pool must carry them before the graph projection can bind symbol rows.
    add(completeTexts, "pkg/zeta_alpha_6::same")
    add(completeTexts, "pkg/alpha_beta::same")
    var later: builder.CompilerSnapshotCanonicalSpanInput
    later.sourceIndex = 1
    later.startByte = 0
    later.endByte = 1
    later.startLine = 0
    later.startColumn = 0
    later.endLine = 0
    later.endColumn = 1
    add(completeSpans, later)
    var earlier: builder.CompilerSnapshotCanonicalSpanInput
    earlier.sourceIndex = 0
    earlier.startByte = 0
    earlier.endByte = 1
    earlier.startLine = 0
    earlier.startColumn = 0
    earlier.endLine = 0
    earlier.endColumn = 1
    add(completeSpans, earlier)

# `predecessor` is the only by-value parameter here and is read-only: it is
# forwarded as a CID, never rebound, stored or released.  Borrowing it lets
# main() feed the same value to every stage without a move.
@borrows
fn SnapshotBuilderSmokeBuild(
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: var builder.CompilerSnapshotCanonicalSourceRow[],
        completeTexts: var str[],
        completeSpans: var builder.CompilerSnapshotCanonicalSpanInput[],
        predecessor: layout.FixedBytes32): schema.CsgCompilerSnapshotTables =
    var tables: schema.CsgCompilerSnapshotTables
    var err: str
    assert(builder.CompilerSnapshotParserTablesBuildInto(
               sidecars,
               sourceRows,
               completeTexts,
               completeSpans,
               predecessor,
               tables,
               err),
           Fmt"compiler snapshot builder smoke: build failed {err}")
    assert(builder.CompilerSnapshotParserProjectionStrictValidateInto(
               tables,
               sidecars,
               sourceRows,
               completeTexts,
               completeSpans,
               predecessor,
               err),
           Fmt"compiler snapshot builder smoke: validate failed {err}")
    assert(tables.sources.documentCids.len == 2 &&
           layout.FixedBytes32Equal(
               tables.sources.interfaceCids[0],
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               tables.sources.interfaceCids[1],
               layout.FixedBytes32()) &&
           tables.parserSidecars.sourceIds.len == 2 &&
           tables.spans.sourceIds.len > completeSpans.len &&
           tables.parserNodes.sourceIds.len ==
               sidecars[0].nodeKinds.len + sidecars[1].nodeKinds.len &&
           tables.tokens.sourceIds.len ==
               sidecars[0].tokenKinds.len + sidecars[1].tokenKinds.len &&
           tables.types.typeCids.len == 0 &&
           tables.symbols.symbolCids.len == 0 &&
           tables.functions.symbolIds.len == 0 &&
           tables.functions.typedFunctionIndexes.len == 0 &&
           tables.typedNodes.functionIds.len == 0 &&
           tables.typedNodes.typedIrNodeIndexes.len == 0 &&
           tables.references.sourceIds.len == 0 &&
           tables.debugOps.typedNodeIds.len == 0,
           "compiler snapshot builder smoke: exact counts mismatch")
    var sharedTextCount: int32
    for textIndex in 1..<tables.texts.len:
        assert(tables.texts[textIndex - 1] != tables.texts[textIndex],
               "compiler snapshot builder smoke: duplicate canonical text")
    for textIndex in 0..<tables.texts.len:
        if tables.texts[textIndex] == "shared":
            sharedTextCount = sharedTextCount + 1
    assert(sharedTextCount == 1 && tables.texts[0] == " future semantic text" &&
           tables.texts[tables.sources.modulePathTextIds[0]] ==
               sourceRows[0].modulePath &&
           tables.texts[tables.sources.modulePathTextIds[1]] ==
               sourceRows[1].modulePath &&
           layout.FixedBytes32Equal(
               tables.parserSidecars.sidecarCids[0],
               sidecars[1].sidecarRaw32) &&
           layout.FixedBytes32Equal(
               tables.parserSidecars.sidecarCids[1],
               sidecars[0].sidecarRaw32) &&
           tables.spans.sourceIds[tables.parserNodes.spanIds[0]] == 0 &&
           tables.parserNodes.spanIds[0] > 0,
           "compiler snapshot builder smoke: canonical text remap mismatch")
    var statementBase: int32
    var tokenBase: int32
    var declarationBase: int32
    for sourceIndex in 0..<sourceRows.len:
        let producerIndex = sourceRows[sourceIndex].producerSourceIndex
        let sidecar = sidecars[producerIndex]
        for localStatement in 0..<sidecar.statementRootNodeIds.len:
            let globalStatement = statementBase + localStatement
            let localDeclarationStart =
                sidecar.statementRootBindingDeclarationStarts[
                    localStatement]
            assert(tables.parserSidecars.statementRootAnchorTokenIds[
                       globalStatement] == tokenBase +
                           sidecar.statementRootAnchorTokenIds[
                               localStatement] &&
                   tables.parserSidecars.statementRootBindingDeclarationStarts[
                           globalStatement] ==
                       (localDeclarationStart < 0 ? -1 :
                            declarationBase + localDeclarationStart) &&
                   tables.parserSidecars.statementRootBindingDeclarationCounts[
                           globalStatement] ==
                       sidecar.statementRootBindingDeclarationCounts[
                           localStatement],
                   "compiler snapshot builder smoke: statement identity remap mismatch")
        statementBase = statementBase + sidecar.statementRootNodeIds.len
        tokenBase = tokenBase + sidecar.tokenKinds.len
        declarationBase = declarationBase + sidecar.declarationKinds.len
    assert(statementBase ==
               tables.parserSidecars.statementRootNodeIds.len,
           "compiler snapshot builder smoke: statement identity coverage mismatch")
    echo("compiler_snapshot_builder_statement_identity_remap=1")
    return tables

# `predecessor` is the only by-value parameter here and is read-only: it is
# forwarded as a CID, never rebound, stored or released.  Borrowing it lets
# main() feed the same value to every stage without a move.
@borrows
fn SnapshotBuilderSmokeDeterminism(
        expected: var schema.CsgCompilerSnapshotTables,
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: var builder.CompilerSnapshotCanonicalSourceRow[],
        completeTexts: var str[],
        completeSpans: var builder.CompilerSnapshotCanonicalSpanInput[],
        predecessor: layout.FixedBytes32) =
    var reversedTexts: str[]
    for reverse in 0..<completeTexts.len:
        add(reversedTexts, share(completeTexts[completeTexts.len - 1 - reverse]))
    var reversedSpans: builder.CompilerSnapshotCanonicalSpanInput[]
    for reverse in 0..<completeSpans.len:
        add(reversedSpans, completeSpans[completeSpans.len - 1 - reverse])
    var actual: schema.CsgCompilerSnapshotTables
    var err: str
    assert(builder.CompilerSnapshotParserTablesBuildInto(
               sidecars, sourceRows, reversedTexts, reversedSpans,
               predecessor, actual, err),
           Fmt"compiler snapshot builder smoke: reordered build failed {err}")
    assert(actual.texts.len == expected.texts.len &&
           actual.spans.sourceIds.len == expected.spans.sourceIds.len &&
           actual.parserNodes.spanIds.len == expected.parserNodes.spanIds.len &&
           actual.tokens.valueTextIds.len == expected.tokens.valueTextIds.len,
           "compiler snapshot builder smoke: deterministic shape mismatch")
    for index in 0..<expected.texts.len:
        assert(actual.texts[index] == expected.texts[index],
               "compiler snapshot builder smoke: text order is input-dependent")
    for index in 0..<expected.spans.sourceIds.len:
        assert(actual.spans.sourceIds[index] == expected.spans.sourceIds[index] &&
               actual.spans.startBytes[index] == expected.spans.startBytes[index] &&
               actual.spans.endBytes[index] == expected.spans.endBytes[index] &&
               actual.spans.startLines[index] == expected.spans.startLines[index] &&
               actual.spans.startColumns[index] == expected.spans.startColumns[index] &&
               actual.spans.endLines[index] == expected.spans.endLines[index] &&
               actual.spans.endColumns[index] == expected.spans.endColumns[index],
               "compiler snapshot builder smoke: span order is input-dependent")
    for index in 0..<expected.parserNodes.spanIds.len:
        assert(actual.parserNodes.spanIds[index] ==
                   expected.parserNodes.spanIds[index],
               "compiler snapshot builder smoke: parser span remap is unstable")
    for index in 0..<expected.tokens.valueTextIds.len:
        assert(actual.tokens.valueTextIds[index] ==
                   expected.tokens.valueTextIds[index] &&
               actual.tokens.spanIds[index] == expected.tokens.spanIds[index] &&
               actual.tokens.sourceLocalRows[index] ==
                   expected.tokens.sourceLocalRows[index] &&
               actual.tokens.lexicalParentTokenIds[index] ==
                   expected.tokens.lexicalParentTokenIds[index],
               "compiler snapshot builder smoke: token remap is unstable")
    echo("compiler_snapshot_builder_determinism=1")

# `predecessor` is the only by-value parameter here and is read-only: it is
# forwarded as a CID, never rebound, stored or released.  Borrowing it lets
# main() feed the same value to every stage without a move.
@borrows
fn SnapshotBuilderSmokeTamper(
        tables: var schema.CsgCompilerSnapshotTables,
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: var builder.CompilerSnapshotCanonicalSourceRow[],
        completeTexts: var str[],
        completeSpans: var builder.CompilerSnapshotCanonicalSpanInput[],
        predecessor: layout.FixedBytes32) =
    var err: str

    var contentAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    contentAttack.sources.contentCids[0].data[0] =
        uint8(Int32(contentAttack.sources.contentCids[0].data[0]) ^ 1)
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               contentAttack, sidecars, sourceRows, completeTexts,
               completeSpans, predecessor, err),
           "compiler snapshot builder smoke: content attack survived")

    var parserInputAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    parserInputAttack.parserSidecars.parserInputCids[0] =
        tables.parserSidecars.parserInputCids[1]
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               parserInputAttack, sidecars, sourceRows, completeTexts,
               completeSpans, predecessor, err),
           "compiler snapshot builder smoke: parser input attack survived")

    var sidecarCidAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    sidecarCidAttack.parserSidecars.sidecarCids[0].data[0] =
        uint8(Int32(sidecarCidAttack.parserSidecars.sidecarCids[0].data[0]) ^ 1)
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               sidecarCidAttack, sidecars, sourceRows, completeTexts,
               completeSpans, predecessor, err),
           "compiler snapshot builder smoke: sidecar CID attack survived")

    var bindingStatementRow: int32 = -1
    for statementRow in 0..<
            tables.parserSidecars.statementRootRoles.len:
        if tables.parserSidecars.statementRootRoles[statementRow] ==
               Int32(parser.ParserValueExprStatementBindingInitializer):
            bindingStatementRow = statementRow
            break
    assert(bindingStatementRow >= 0,
           "compiler snapshot builder smoke: binding statement missing")
    var statementAnchorAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    statementAnchorAttack.parserSidecars.statementRootAnchorTokenIds[
        bindingStatementRow] = -1
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               statementAnchorAttack, sidecars, sourceRows, completeTexts,
               completeSpans, predecessor, err),
           "compiler snapshot builder smoke: statement anchor attack survived")
    var statementDeclarationAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    statementDeclarationAttack.parserSidecars.statementRootBindingDeclarationCounts[
        bindingStatementRow] = 0
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               statementDeclarationAttack, sidecars, sourceRows,
               completeTexts, completeSpans, predecessor, err),
           "compiler snapshot builder smoke: statement declaration attack survived")

    var crossSourceAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    let secondNodeBase = sidecars[sourceRows[0].producerSourceIndex].nodeKinds.len
    assert(secondNodeBase < crossSourceAttack.parserNodes.sourceIds.len,
           "compiler snapshot builder smoke: second source has no node")
    crossSourceAttack.parserNodes.sourceIds[secondNodeBase] = 0
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               crossSourceAttack, sidecars, sourceRows, completeTexts,
               completeSpans, predecessor, err),
           "compiler snapshot builder smoke: cross-source attack survived")

    var producerNodeAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    assert(secondNodeBase >= 2,
           "compiler snapshot builder smoke: producer-node fixture too small")
    producerNodeAttack.parserNodes.producerNodeIds[1] =
        producerNodeAttack.parserNodes.producerNodeIds[0]
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               producerNodeAttack, sidecars, sourceRows, completeTexts,
               completeSpans, predecessor, err),
           "compiler snapshot builder smoke: parser producer identity attack survived")

    var interpolationTokenId: int32 = -1
    for tokenId in 0..<tables.tokens.lexicalParentTokenIds.len:
        if tables.tokens.lexicalParentTokenIds[tokenId] >= 0:
            interpolationTokenId = tokenId
            break
    assert(interpolationTokenId >= 0,
           "compiler snapshot builder smoke: interpolation token missing")
    var tokenParentAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    tokenParentAttack.tokens.lexicalParentTokenIds[interpolationTokenId] = -1
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               tokenParentAttack, sidecars, sourceRows, completeTexts,
               completeSpans, predecessor, err),
           "compiler snapshot builder smoke: token parent attack survived")

    var sourceHashSidecars: parser_receipt.ParserCanonicalSourceSidecar[]
    for sourceIndex in 0..<sidecars.len:
        add(sourceHashSidecars,
            parser_receipt.ParserCanonicalSourceSidecarClone(
                sidecars[sourceIndex]))
    sourceHashSidecars[0].sourceContentRaw32.data[0] =
        uint8(Int32(sourceHashSidecars[0].sourceContentRaw32.data[0]) ^ 1)
    var rejected: schema.CsgCompilerSnapshotTables
    assert(!builder.CompilerSnapshotParserTablesBuildInto(
               sourceHashSidecars,
               sourceRows,
               completeTexts,
               completeSpans,
               predecessor,
               rejected,
               err),
           "compiler snapshot builder smoke: source hash attack survived")

    var duplicateMappingRows: builder.CompilerSnapshotCanonicalSourceRow[]
    add(duplicateMappingRows, share(sourceRows[0]))
    add(duplicateMappingRows, share(sourceRows[1]))
    duplicateMappingRows[1].producerSourceIndex =
        duplicateMappingRows[0].producerSourceIndex
    assert(!builder.CompilerSnapshotParserTablesBuildInto(
               sidecars, duplicateMappingRows, completeTexts, completeSpans,
               predecessor, rejected, err),
           "compiler snapshot builder smoke: duplicate producer mapping survived")

    var missingMappingRows: builder.CompilerSnapshotCanonicalSourceRow[]
    add(missingMappingRows, share(sourceRows[0]))
    add(missingMappingRows, share(sourceRows[1]))
    missingMappingRows[1].producerSourceIndex = sidecars.len
    assert(!builder.CompilerSnapshotParserTablesBuildInto(
               sidecars, missingMappingRows, completeTexts, completeSpans,
               predecessor, rejected, err),
           "compiler snapshot builder smoke: missing producer mapping survived")

    var omittedTexts: str[]
    assert(!builder.CompilerSnapshotParserProjectionStrictValidateInto(
               tables, sidecars, sourceRows, omittedTexts, completeSpans,
               predecessor, err),
           "compiler snapshot builder smoke: incomplete text universe survived")

    var conflictingSpans: builder.CompilerSnapshotCanonicalSpanInput[]
    for index in 0..<completeSpans.len:
        add(conflictingSpans, completeSpans[index])
    let producerIndex = sourceRows[0].producerSourceIndex
    var conflict: builder.CompilerSnapshotCanonicalSpanInput
    conflict.sourceIndex = 0
    conflict.startByte = sidecars[producerIndex].spanStartBytes[0]
    conflict.endByte = sidecars[producerIndex].spanEndBytes[0]
    conflict.startLine = sidecars[producerIndex].spanStartLines[0]
    conflict.startColumn = sidecars[producerIndex].spanStartColumns[0]
    conflict.endLine = sidecars[producerIndex].spanEndLines[0]
    conflict.endColumn = sidecars[producerIndex].spanEndColumns[0] + 1
    add(conflictingSpans, conflict)
    assert(!builder.CompilerSnapshotParserTablesBuildInto(
               sidecars, sourceRows, completeTexts, conflictingSpans,
               predecessor, rejected, err),
           "compiler snapshot builder smoke: conflicting span survived")
    echo("compiler_snapshot_builder_tamper_rejected=1")
    echo("compiler_snapshot_builder_cross_source_rejected=1")
    echo("compiler_snapshot_builder_universe_rejected=1")
    echo("compiler_snapshot_builder_statement_identity_rejected=1")
    echo("compiler_snapshot_builder_token_parent_rejected=1")

fn SnapshotBuilderSmokeGraphBuild(
        attackKind: int32,
        out: var compiler_csg.CompilerCsg) =
    out = compiler_csg.CompilerCsg()
    out.packageId = "pkg"
    out.sourceSnapshotCount = 2
    out.sourceBundleCid = SnapshotBuilderSmokeCid(31, 1)
    out.entrySourceCid = SnapshotBuilderSmokeCid(32, 1)
    var sourceTable: compiler_csg.CompilerCsgSemanticSourceTable
    add(sourceTable.sourcePaths, "/workspace/a.cheng")
    add(sourceTable.modulePaths, "pkg/zeta_alpha_6")
    add(sourceTable.textBytes, 64)
    add(sourceTable.declStart, 0)
    add(sourceTable.declCount, 1)
    add(sourceTable.importEdgeStart, 0)
    add(sourceTable.importEdgeCount, 0)
    add(sourceTable.sourcePaths, "/workspace/b.cheng")
    add(sourceTable.modulePaths, "pkg/alpha_beta")
    add(sourceTable.textBytes, 64)
    add(sourceTable.declStart, 1)
    add(sourceTable.declCount, 1)
    add(sourceTable.importEdgeStart, 0)
    add(sourceTable.importEdgeCount, 0)
    assert(sourceTable.sourcePaths[0] != sourceTable.modulePaths[0] &&
           sourceTable.sourcePaths[1] != sourceTable.modulePaths[1],
           "compiler snapshot builder smoke: source/module domains collapsed")
    var declTable: compiler_csg.CompilerCsgSemanticDeclTable
    add(declTable.sourceIndex, 0)
    add(declTable.names, "same")
    add(declTable.lineNumbers, 1)
    add(declTable.importc, false)
    add(declTable.exported, true)
    add(declTable.sourceIndex, 1)
    add(declTable.names, "same")
    add(declTable.lineNumbers, 1)
    add(declTable.importc, false)
    add(declTable.exported, true)
    var reachableTable: compiler_csg.CompilerCsgSemanticReachableFunctionTable
    for sourceIndex in 0..<2:
        let authoritySidecar = SnapshotBuilderSmokeSidecar(sourceIndex)
        add(reachableTable.sourceIndex, sourceIndex)
        add(reachableTable.sourcePaths,
            sourceIndex == 0 ? "/workspace/a.cheng" : "/workspace/b.cheng")
        add(reachableTable.functionNames, "same")
        add(reachableTable.symbolTexts, "same")
        add(reachableTable.producerSourceIndexes, sourceIndex)
        add(reachableTable.producerDeclarationIndexes, sourceIndex)
        add(reachableTable.functionNameSurfaceKinds,
            authoritySidecar.functionNameSurfaceKinds[0])
        add(reachableTable.functionNameProofCids,
            authoritySidecar.functionNameProofCids[0])
        add(reachableTable.startLines, 1)
        add(reachableTable.endLines, 2)
        add(reachableTable.reachable, true)
        add(reachableTable.graphNodeIds, sourceIndex + 4)
    if attackKind == 6:
        reachableTable.graphNodeIds[0] = 5

    var typedIr: texpr.TypedExprIr
    typedIr->internPool = langintern.InternPoolNew()
    var sourceA = "/workspace/a.cheng"
    var sourceB = "/workspace/b.cheng"
    var functionSame = "same"
    var int32Type = "int32"
    var strType = "str"
    SnapshotBuilderSmokeAppendTypedFunction(
        typedIr, sourceA, functionSame, 0, int32Type)
    if attackKind != 9:
        SnapshotBuilderSmokeAppendTypedFunction(
            typedIr, sourceB, functionSame, 1, strType)
    var typedTable: compiler_csg.CompilerCsgSemanticTypedIrTable
    add(typedTable.functionSourceIndexes, 0)
    add(typedTable.functionGraphNodeIds, 4)
    add(typedTable.functionNames, "same")
    add(typedTable.functionNodeStart, 0)
    add(typedTable.functionNodeCount, 2)
    add(typedTable.functionStatementStart, 0)
    add(typedTable.functionStatementCount, 0)
    if attackKind != 9:
        add(typedTable.functionSourceIndexes, 1)
        add(typedTable.functionGraphNodeIds, 5)
        add(typedTable.functionNames, "same")
        add(typedTable.functionNodeStart, 2)
        add(typedTable.functionNodeCount, 2)
        add(typedTable.functionStatementStart, 0)
        add(typedTable.functionStatementCount, 0)
    if attackKind == 8:
        typedTable.functionGraphNodeIds[0] = 5
    var resolvedTable: compiler_csg.CompilerCsgSemanticResolvedCallTable
    resolvedTable.internPool = langintern.InternPoolNew()
    add(resolvedTable.functionRowHeads, 0)
    if attackKind != 9:
        add(resolvedTable.functionRowHeads, -1)
    add(resolvedTable.sourceIndexes, 0)
    add(resolvedTable.originParserNodeIds, 0)
    add(resolvedTable.functionIndexes, 0)
    add(resolvedTable.functionRowNext, -1)
    add(resolvedTable.sourcePathIds,
        langintern.Intern(resolvedTable.internPool, "/workspace/a.cheng"))
    add(resolvedTable.lineNumbers, 2)
    add(resolvedTable.columnNumbers, 4)
    add(resolvedTable.callQualifierIds,
        langintern.Intern(resolvedTable.internPool, "pkg/alpha_beta"))
    add(resolvedTable.callCalleeIds,
        langintern.Intern(resolvedTable.internPool, "same"))
    add(resolvedTable.callTargetIds,
        langintern.Intern(
            resolvedTable.internPool,
            attackKind == 5 ? "same_text_is_not_a_target_node" : "same"))
    add(resolvedTable.callTargetSourcePathIds,
        langintern.Intern(resolvedTable.internPool, "/workspace/b.cheng"))
    add(resolvedTable.callTargetSignatureLineNumbers, 1)
    add(resolvedTable.callTargetImportcFlags, false)
    add(resolvedTable.callArgCounts, 0)
    add(resolvedTable.callArgsTextIds,
        langintern.Intern(resolvedTable.internPool, ""))
    add(resolvedTable.returnRootFlags, false)
    add(resolvedTable.callerGraphNodeIds, 4)
    add(resolvedTable.targetGraphNodeIds, 5)
    resolvedTable.graphNodeProjectionComplete = true
    if attackKind == 7:
        resolvedTable.targetGraphNodeIds[0] = 4
    var facts: compiler_csg.CompilerCsgSemanticGraph
    facts.sourceTable = sourceTable
    facts.declTable = declTable
    facts.reachableFunctionTable = reachableTable
    facts.typedIrTable = typedTable
    facts.resolvedCallTable = resolvedTable
    out.semanticGraph = facts
    out.typedIr = typedIr
    var sourceIdentityReceipt: compiler_csg.PortableSourceIdentityReceipt
    var receiptErr: str
    assert(compiler_csg.PortableSourceIdentityReceiptMakeInto(
               2,
               0,
               0,
               out.packageId,
               "pkg/zeta_alpha_6",
               out.sourceBundleCid,
               out.entrySourceCid,
               SnapshotBuilderSmokeCid(33, 1),
               sourceIdentityReceipt,
               receiptErr),
           Fmt"compiler snapshot builder smoke: source receipt failed {receiptErr}")
    out.sourceIdentityReceipt = sourceIdentityReceipt
    out.parserNormalizedExprReceipt.envelope.receiptRaw32 =
        SnapshotBuilderSmokeCid(36, 1)

    var nodes: compiler_csg.CompilerCsgNode[]
    let packageNodeId = compiler_csg.CompilerCsgAddNode(
        nodes, compiler_csg.CompilerCsgNodeKindPackage, 0,
        "", "", share(out.packageId), 0, 0, 0, 0, 0, 0, "")
    let moduleAId = compiler_csg.CompilerCsgAddNode(
        nodes, compiler_csg.CompilerCsgNodeKindModule, packageNodeId,
        "pkg/zeta_alpha_6", "", "pkg/zeta_alpha_6", 0, 0, 0, 0, 0, 0, "")
    let moduleBId = compiler_csg.CompilerCsgAddNode(
        nodes, compiler_csg.CompilerCsgNodeKindModule, packageNodeId,
        "pkg/alpha_beta", "", "pkg/alpha_beta", 0, 0, 0, 0, 0, 0, "")
    var symbolA: compiler_csg.CompilerCsgNode
    symbolA.nodeId = 4
    symbolA.nodeKind = compiler_csg.CompilerCsgNodeKindSymbol
    symbolA.ownerNodeId = moduleAId
    symbolA.modulePath = "pkg/zeta_alpha_6"
    symbolA.symbolText = "pkg/zeta_alpha_6::same"
    symbolA.factText = "same"
    symbolA.semanticSource = attackKind == 10 ?
        "/workspace/a.cheng" : "pkg/zeta_alpha_6"
    symbolA.semanticDeclarationLineIndex = 1
    symbolA.semanticReturnType = "int32"
    symbolA.semanticSignatureComplete = 1
    symbolA.exportedFlag = 1
    symbolA.exportSymbolName = "same"
    symbolA.factCid = compiler_csg.CompilerCsgHashNodeRecord(symbolA)
    if attackKind == 1:
        var badNodeCid = symbolA.factCid
        badNodeCid.data[0] = uint8(Int32(badNodeCid.data[0]) ^ 1)
        symbolA.factCid = badNodeCid
    add(nodes, share(symbolA))
    var symbolB = compiler_csg.CompilerCsgCloneNode(symbolA)
    symbolB.nodeId = 5
    symbolB.ownerNodeId = moduleBId
    symbolB.modulePath = "pkg/alpha_beta"
    symbolB.symbolText = "pkg/alpha_beta::same"
    symbolB.semanticSource = "pkg/alpha_beta"
    symbolB.semanticReturnType = "str"
    symbolB.factCid = compiler_csg.CompilerCsgHashNodeRecord(symbolB)
    add(nodes, symbolB)
    var cleanEdges: compiler_csg.CompilerCsgEdge[]
    compiler_csg.CompilerCsgAddEdge(
        cleanEdges, packageNodeId, moduleAId,
        compiler_csg.CompilerCsgEdgeKindContains)
    compiler_csg.CompilerCsgAddEdge(
        cleanEdges, packageNodeId, moduleBId,
        compiler_csg.CompilerCsgEdgeKindContains)
    compiler_csg.CompilerCsgAddEdge(
        cleanEdges, moduleAId, 4,
        compiler_csg.CompilerCsgEdgeKindContains)
    compiler_csg.CompilerCsgAddEdge(
        cleanEdges, moduleBId, 5,
        compiler_csg.CompilerCsgEdgeKindContains)
    let canonicalGraphCid =
        csgnorm.CsgNormalizedGraphCid(out.packageId, nodes, cleanEdges)
    var edges: compiler_csg.CompilerCsgEdge[]
    for index in 0..<cleanEdges.len:
        var edge = compiler_csg.CompilerCsgCloneEdge(cleanEdges[index])
        if attackKind == 2 && index == 0:
            var badEdgeCid = edge.edgeCid
            badEdgeCid.data[0] = uint8(Int32(badEdgeCid.data[0]) ^ 1)
            edge.edgeCid = badEdgeCid
        if attackKind == 3 && index == cleanEdges.len - 1:
            edge.toNodeId = 4
            edge.edgeCid = compiler_csg.CompilerCsgHashEdge(
                edge.fromNodeId, edge.toNodeId, edge.edgeKind)
        add(edges, edge)
    # `out.nodes = nodes` moves (spec 0.2: assignment moves ownership), so the
    # counts are read from the still-owned locals first.
    out.nodeCount = nodes.len
    out.edgeCount = edges.len
    out.nodes = nodes
    out.edges = edges
    out.canonicalGraphCid = canonicalGraphCid
    out.graphCid = SnapshotBuilderSmokeCid(35, 1)
    if attackKind == 4:
        var badGraphCid = out.graphCid
        badGraphCid.data[0] = uint8(Int32(badGraphCid.data[0]) ^ 1)
        out.graphCid = badGraphCid

    SnapshotBuilderSmokeTypeArenaFromSources(
        SnapshotBuilderSmokeSource(0),
        SnapshotBuilderSmokeSource(1),
        out.typeArena)
    out.typeArenaMissingResolutionAuthorityCount = 0

fn SnapshotBuilderSmokeGraphRelease(csg: var compiler_csg.CompilerCsg) =
    typearena.TypedExprTypeArenaRelease(csg.typeArena)
    csg = compiler_csg.CompilerCsg()

@borrows
fn SnapshotBuilderSmokeCidLess(left: layout.FixedBytes32,
                               right: layout.FixedBytes32): bool =
    for index in 0..<layout.FixedBytes32Size:
        if left.data[index] != right.data[index]:
            return left.data[index] < right.data[index]
    return false

fn SnapshotBuilderSmokeBodySpan(
        tables: var schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        startByte: var int32,
        endByte: var int32) =
    startByte = -1
    endByte = -1
    for functionRow in 0..<tables.parserSidecars.functionBodySpanIds.len:
        let spanId = tables.parserSidecars.functionBodySpanIds[functionRow]
        if spanId >= 0 && spanId < tables.spans.sourceIds.len &&
           tables.spans.sourceIds[spanId] == sourceId:
            startByte = tables.spans.startBytes[spanId]
            endByte = tables.spans.endBytes[spanId]
            return
    panic("compiler snapshot builder smoke: source body span missing")

fn SnapshotBuilderSmokePrebuildFacts(
        tables: var schema.CsgCompilerSnapshotTables,
        csg: var compiler_csg.CompilerCsg):
        incremental.SemanticSnapshotIncrementalPrebuildFacts =
    var eventState: semantic_snapshot.WorkspaceSourceEventState
    var err: str
    assert(semantic_snapshot.WorkspaceSourceEventStateInitInto(
               SnapshotBuilderSmokeCid(41, 1), eventState, err), err)
    var sourceVersion: int64
    for sourceId in 0..<tables.sources.documentCids.len:
        assert(semantic_snapshot.WorkspaceSourceEventAcceptInto(
                   eventState,
                   semantic_snapshot.SemanticSourceEventOpen,
                   tables.sources.documentCids[sourceId],
                   int64(0),
                   sourceVersion,
                   err),
               err)
    var input: incremental.SemanticSnapshotIncrementalPrebuildInput
    input.worldHeadCid = SnapshotBuilderSmokeCid(42, 1)
    input.compilerCid = SnapshotBuilderSmokeCid(43, 1)
    input.sourceBundleCid = csg.sourceBundleCid
    input.frontEndReceiptCid =
        csg.parserNormalizedExprReceipt.envelope.receiptRaw32
    for sourceId in 0..<tables.sources.documentCids.len:
        add(input.documentCids, tables.sources.documentCids[sourceId])
        add(input.sourceProducerIndexes,
            tables.parserSidecars.producerSourceIndexes[sourceId])
        add(input.sourceTexts,
            sourceId == 0 ? SnapshotBuilderSmokeSource(1) :
                            SnapshotBuilderSmokeSource(0))
        add(input.sourceInterfaceCids,
            tables.sources.interfaceCids[sourceId])
    var symbolCidBySource: layout.FixedBytes32[]
    for sourceId in 0..<2:
        add(symbolCidBySource,
            SnapshotBuilderSmokeCid(70 + sourceId, 1))
    let aFirst = SnapshotBuilderSmokeCidLess(
        symbolCidBySource[1], symbolCidBySource[0])
    for symbolId in 0..<2:
        let isA = (symbolId == 0) == aFirst
        let nodeId = isA ? csg.nodes[3].nodeId : csg.nodes[4].nodeId
        add(input.symbolCids, symbolCidBySource[isA ? 1 : 0])
        add(input.symbolInterfaceCids,
            SnapshotBuilderSmokeCid(50 + nodeId, 1))
    for functionId in 0..<2:
        let isA = (functionId == 0) == aFirst
        let sourceId = isA ? 1 : 0
        add(input.functionSymbolIds, functionId)
        add(input.functionSourceIds, sourceId)
        var bodyStart: int32
        var bodyEnd: int32
        SnapshotBuilderSmokeBodySpan(
            tables, sourceId, bodyStart, bodyEnd)
        add(input.bodyStartBytes, bodyStart)
        add(input.bodyEndBytes, bodyEnd)
        add(input.functionInterfaceCids,
            input.symbolInterfaceCids[functionId])
    var facts: incremental.SemanticSnapshotIncrementalPrebuildFacts
    assert(incremental.SemanticSnapshotIncrementalPrebuildFactsMakeInto(
               eventState, input, facts, err),
           Fmt"compiler snapshot builder smoke: prebuild failed {err}")
    return facts

fn SnapshotBuilderSmokePreviousPlanInto(
        current: var incremental.SemanticSnapshotIncrementalPrebuildFacts,
        previous: var schema.CsgCompilerSnapshotTables,
        plan: var incremental.SemanticSnapshotIncrementalPrebuildPlan,
        err: var str): bool =
    previous = schema_smoke.BuildSnapshot()
    var previousCargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(previous)
    if !previousCargo.ok:
        err = previousCargo.error
        return false
    var eventState: semantic_snapshot.WorkspaceSourceEventState
    if !semantic_snapshot.WorkspaceSourceEventStateInitInto(
            current.workspaceSessionCid, eventState, err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(previousCargo)
        return false
    var sourceVersion: int64
    if !semantic_snapshot.WorkspaceSourceEventAcceptInto(
            eventState, semantic_snapshot.SemanticSourceEventOpen,
            previous.sources.documentCids[0], int64(0),
            sourceVersion, err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(previousCargo)
        return false
    var identity: semantic_snapshot.PortableSemanticSnapshotIdentity
    if !semantic_snapshot.PortableSemanticSnapshotIdentityMakeInto(
            current.worldHeadCid, SnapshotBuilderSmokeCid(70, 1),
            current.compilerCid, SnapshotBuilderSmokeCid(71, 1),
            previousCargo.factsRootCid, identity, err):
        snapshot_cargo.CsgCompilerSnapshotCargoRelease(previousCargo)
        return false
    var binding: semantic_snapshot.LocalSourceVersionBinding
    var validation: semantic_snapshot.SemanticSnapshotValidationReceipt
    let valid = semantic_snapshot.LocalSourceVersionBindingMakeInto(
            eventState, identity, binding, err) &&
        semantic_snapshot.SemanticSnapshotValidationReceiptMakeInto(
            binding, identity, previousCargo.proofRoots.parserRootCid,
            previousCargo.proofRoots.typeRootCid,
            previousCargo.proofRoots.ownershipRootCid,
            previousCargo.proofRoots.callRootCid,
            previousCargo.proofRoots.layoutRootCid,
            previousCargo.proofRoots.dependencyRootCid,
            previousCargo.proofRoots.readSetRootCid,
            previousCargo.proofRoots.reachabilityRootCid,
            previousCargo.proofRoots.lifecycleRootCid,
            SnapshotBuilderSmokeCid(250, 251),
            validation, err) &&
        incremental.SemanticSnapshotIncrementalPrebuildPlanBuildInto(
            previous, identity, binding, validation, current,
            plan, err)
    snapshot_cargo.CsgCompilerSnapshotCargoRelease(previousCargo)
    return valid

fn SnapshotBuilderSmokeAppendTypedFunction(
        typedIr: var texpr.TypedExprIr,
        sourcePath: var str,
        functionName: var str,
        scopeStart: int32,
        returnType: var str) =
    let returnsStr = returnType == "str"
    assert(returnsStr || returnType == "int32",
           "compiler snapshot builder smoke: unsupported typed fixture return")
    texpr.TypedExprIrAppendScope(
        typedIr,
        0,
        -1,
        parser.NormalizedScopeRoot,
        -1,
        0,
        1,
        1,
        2,
        1)
    let nodeStart = typedIr.nodes2_nodeIndexs.len
    var node = texpr.TypedExprIrNodeNew()
    node.resultStructuralTypeId = -1
    node.callDeclarationIndex = -1
    node.originParserNodeId = 0
    node.syntheticOriginKind = texpr.TypedExprSyntheticOriginNone
    node.sourcePath = sourcePath
    node.functionName = functionName
    node.lineNumber = 2
    node.opKind = returnsStr ?
        texpr.TypedExprIrOpStrLit : texpr.TypedExprIrOpI32Const
    node.resultType = returnType
    node.resultTypeProofKind = texpr.TypedExprSnapshotTypeProofScalar
    node.resultTypeManaged = returnsStr
    node.resultTypeSend = !returnsStr
    node.resultTypeSync = !returnsStr
    node.surfaceText = returnsStr ? "\"value\"" : "1"
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.literalText = returnsStr ? "value" : "1"
    let returnNodeIndex = texpr.TypedExprIrAddNode(typedIr, node)
    var syntheticNode = texpr.TypedExprIrNodeNew()
    syntheticNode.resultStructuralTypeId = -1
    syntheticNode.callDeclarationIndex = -1
    syntheticNode.originParserNodeId = -1
    syntheticNode.syntheticOriginKind =
        texpr.TypedExprSyntheticOriginDesugared
    syntheticNode.spanAuthorityKind =
        texpr.TypedExprSpanAuthorityNoSource
    syntheticNode.sourcePath = sourcePath
    syntheticNode.functionName = functionName
    syntheticNode.lineNumber = 2
    syntheticNode.opKind = texpr.TypedExprIrOpI32Const
    syntheticNode.resultType = "int32"
    syntheticNode.resultTypeProofKind =
        texpr.TypedExprSnapshotTypeProofScalar
    syntheticNode.resultTypeManaged = false
    syntheticNode.resultTypeSend = true
    syntheticNode.resultTypeSync = true
    syntheticNode.surfaceText = "implicit"
    syntheticNode.paramSlot = -1
    syntheticNode.operand0NodeIndex = -1
    syntheticNode.operand1NodeIndex = -1
    syntheticNode.operand2NodeIndex = -1
    syntheticNode.literalText = "0"
    texpr.TypedExprIrAddNode(typedIr, syntheticNode)
    var function: texpr.TypedExprIrFunction
    function.sourcePath = sourcePath
    function.functionName = functionName
    function.signatureLineNumber = 1
    function.endLineNumber = 2
    function.bodyLineNumber = 2
    function.returnType = returnType
    function.resultExprClass = texpr.TypedExprExprOwned
    function.returnExpr = returnsStr ? "\"value\"" : "1"
    function.statementStart = 0
    function.statementCount = 0
    function.scopeStart = scopeStart
    function.scopeCount = 1
    function.nodeStart = nodeStart
    function.nodeCount = 2
    function.returnNodeIndex = returnNodeIndex
    texpr.TypedExprIrAppendFunction(typedIr, function)

fn SnapshotBuilderSmokeExactCallGraphProjection() =
    let root = chengpath.PathCurrentDir()
    let sourcePath = chengpath.PathJoin(
        root, "src/tests/ordinary_call_chain_fixture.cheng")
    let sourceText = chengpath.ReadTextFile(root, sourcePath)
    assert(sourceText != "",
           "compiler snapshot builder smoke: production call fixture missing")
    # CompilerRequestNew stores rootDir/sourcePath into the request, so it
    # takes ownership (spec 0.2).  Both are still read below, hence share().
    let baseRequest = creq.CompilerRequestNew(
        share(root),
        share(sourcePath),
        chengpath.PathJoin(
            root, "artifacts/compiler_snapshot_builder/call_projection.o"),
        "arm64-apple-darwin",
        creq.EmitObj,
        "")
    let request = creq.CompilerRequestWithExportRootSymbols(
        baseRequest, ["main"])
    var plan: slplan.SystemLinkPlanStub
    var err: str
    assert(slplan.BuildSystemLinkPlanStub(root, request, plan, err), err)
    let fixtureImportEdgeCount =
        slplan.SystemLinkPlanImportEdgeCount(plan)
    assert(fixtureImportEdgeCount == 0,
           "compiler snapshot builder smoke: call fixture import domain drift")
    let sourceBundle = slplan.SystemLinkPlanSourceBundleCid(plan)
    assert(IsOk(sourceBundle),
           "compiler snapshot builder smoke: production source bundle missing")
    var csg: compiler_csg.CompilerCsg
    assert(compiler_csg.BuildCompilerCsgSemanticConsumeEntryTextInto(
               plan,
               sourcePath,
               sourceText,
               Value(sourceBundle),
               csg,
               err),
           Fmt"compiler snapshot builder smoke: production CompilerCSG failed {err}")
    let producedReachable = csg.semanticGraph.reachableFunctionTable
    let producedSlices = csg.semanticGraph.exprSliceTable
    let producedCalls = csg.semanticGraph.resolvedCallTable
    assert(producedCalls.graphNodeProjectionComplete &&
           producedCalls.sourceIndexes.len > 0 &&
           producedSlices.functionSliceIndexes.len ==
               producedReachable.functionNames.len &&
           csg.parserNormalizedExprReceipt.sourceSidecars.len ==
               csg.semanticGraph.sourceTable.sourcePaths.len,
           "compiler snapshot builder smoke: production call authority missing")

    # Reconstruct the pre-finalization reachable owner domain exclusively from
    # CompilerCSG's retained structural tables.  No text/name lookup selects a
    # row: exprSliceTable is the exact reachable -> TypedIR identity map.
    var reachable =
        compiler_csg.CompilerCsgReachableFunctionSetInit(true)
    for functionIndex in 0..<producedReachable.functionNames.len:
        add(reachable.sourcePaths,
            share(producedReachable.sourcePaths[functionIndex]))
        add(reachable.functionNames,
            share(producedReachable.functionNames[functionIndex]))
        add(reachable.symbolTexts,
            share(producedReachable.symbolTexts[functionIndex]))
        add(reachable.producerSourceIndexes,
            producedReachable.producerSourceIndexes[functionIndex])
        add(reachable.producerDeclarationIndexes,
            producedReachable.producerDeclarationIndexes[functionIndex])
        add(reachable.startLines,
            producedReachable.startLines[functionIndex])
        add(reachable.endLines,
            producedReachable.endLines[functionIndex])
        add(reachable.reachable,
            producedReachable.reachable[functionIndex])

    # The finalized receipt owns the exact parser sidecars emitted by the same
    # CompilerCSG build.  Clone those rows into the accumulator view consumed
    # by declaration-coordinate validation; no empty accumulator is admitted.
    var accumulatorSourcePaths: str[]
    var accumulatorOwnerModulePaths: str[]
    for sourceIndex in 0..<csg.semanticGraph.sourceTable.sourcePaths.len:
        add(accumulatorSourcePaths,
            share(csg.semanticGraph.sourceTable.sourcePaths[sourceIndex]))
        add(accumulatorOwnerModulePaths,
            share(csg.semanticGraph.sourceTable.modulePaths[sourceIndex]))
    var accumulatorImportEdges: parser.ImportEdge[]
    let parserAccumulatorResult =
        parser_receipt.ParserNormalizedExprReceiptAccumulatorInit(
            Value(sourceBundle),
            accumulatorSourcePaths,
            accumulatorOwnerModulePaths,
            accumulatorImportEdges,
            producedReachable.functionNames.len)
    if IsErr(parserAccumulatorResult):
        panic(Error(parserAccumulatorResult))
    var parserAccumulator = Value(parserAccumulatorResult)
    for sourceIndex in 0..<csg.semanticGraph.sourceTable.sourcePaths.len:
        parserAccumulator.sourceSidecarPresent[sourceIndex] = true
        parserAccumulator.sourceSidecars[sourceIndex] =
            parser_receipt.ParserCanonicalSourceSidecarClone(
                csg.parserNormalizedExprReceipt.sourceSidecars[sourceIndex])

    var calls =
        compiler_csg.CompilerCsgSemanticResolvedCallTableClone(producedCalls)
    calls.functionRowHeads = []
    for functionIndex in 0..<producedReachable.functionNames.len:
        add(calls.functionRowHeads, -1)
    calls.functionRowNext = []
    for rowIndex in 0..<calls.functionIndexes.len:
        let typedFunctionIndex = calls.functionIndexes[rowIndex]
        var reachableFunctionIndex: int32 = -1
        for candidateIndex in 0..<producedSlices.functionSliceIndexes.len:
            let sliceIndex =
                producedSlices.functionSliceIndexes[candidateIndex]
            if sliceIndex >= 0 &&
               sliceIndex < producedSlices.typedIrFunctionIndexes.len &&
               producedSlices.typedIrFunctionIndexes[sliceIndex] ==
                   typedFunctionIndex:
                assert(reachableFunctionIndex < 0,
                       "compiler snapshot builder smoke: duplicate exact TypedIR slice")
                reachableFunctionIndex = candidateIndex
        assert(reachableFunctionIndex >= 0,
               "compiler snapshot builder smoke: call owner slice missing")
        calls.functionIndexes[rowIndex] = reachableFunctionIndex
        add(calls.functionRowNext,
            calls.functionRowHeads[reachableFunctionIndex])
        calls.functionRowHeads[reachableFunctionIndex] = rowIndex
        calls.targetProducerSourceIndexes[rowIndex] = -1
        calls.targetProducerDeclarationOrdinals[rowIndex] = -1
        calls.targetParserSourceLocalDeclarationRows[rowIndex] = -1
        calls.callerGraphNodeIds[rowIndex] = -1
        calls.targetGraphNodeIds[rowIndex] = -1
    calls.graphNodeProjectionComplete = false

    var badGraphNodeIds: int32[]
    for functionIndex in 0..<producedReachable.graphNodeIds.len:
        add(badGraphNodeIds,
            producedReachable.graphNodeIds[functionIndex])
    badGraphNodeIds[calls.functionIndexes[0]] = -1
    var rejectedCalls =
        compiler_csg.CompilerCsgSemanticResolvedCallTableClone(calls)
    assert(!compiler_csg.CompilerCsgSemanticFinalizeResolvedCallFunctionAdjacency(
               rejectedCalls,
               reachable,
               badGraphNodeIds,
               csg.typedIr,
               csg.semanticGraph.exprSliceTable,
               parserAccumulator,
               err) &&
           !rejectedCalls.graphNodeProjectionComplete &&
           rejectedCalls.functionIndexes[0] == calls.functionIndexes[0] &&
           rejectedCalls.callerGraphNodeIds[0] == -1 &&
           rejectedCalls.targetGraphNodeIds[0] == -1,
           "compiler snapshot builder smoke: failed projection mutated table")
    compiler_csg.CompilerCsgSemanticResolvedCallTableRelease(rejectedCalls)

    var graphNodeIds: int32[]
    for functionIndex in 0..<producedReachable.graphNodeIds.len:
        add(graphNodeIds, producedReachable.graphNodeIds[functionIndex])
    assert(compiler_csg.CompilerCsgSemanticFinalizeResolvedCallFunctionAdjacency(
               calls,
               reachable,
               graphNodeIds,
               csg.typedIr,
               csg.semanticGraph.exprSliceTable,
               parserAccumulator,
               err),
           Fmt"compiler snapshot builder smoke: projection failed {err}")
    assert(calls.graphNodeProjectionComplete &&
           calls.functionIndexes[0] == producedCalls.functionIndexes[0] &&
           calls.callerGraphNodeIds[0] ==
               producedCalls.callerGraphNodeIds[0] &&
           calls.targetGraphNodeIds[0] ==
               producedCalls.targetGraphNodeIds[0] &&
           compiler_csg.CompilerCsgSemanticResolvedCallTableValidate(
               calls, csg.typedIr.functions2_functionNameIds.len, err),
           Fmt"compiler snapshot builder smoke: exact call identity invalid {err}")
    compiler_csg.CompilerCsgSemanticResolvedCallTableRelease(calls)
    compiler_csg.CompilerCsgTerminalRelease(csg)
    echo("compiler_snapshot_builder_exact_call_graph_projection=1")

@borrows
fn SnapshotBuilderSmokeExpectedParserFunctionRow(
        tables: schema.CsgCompilerSnapshotTables,
        sourceId: int32): int32 =
    var matched: int32 = -1
    for row in 0..<tables.parserSidecars.functionIndexes.len:
        let declarationSpan =
            tables.parserSidecars.functionDeclarationSpanIds[row]
        if declarationSpan >= 0 &&
           declarationSpan < tables.spans.sourceIds.len &&
           tables.spans.sourceIds[declarationSpan] == sourceId &&
           tables.parserSidecars.functionSignatureLineNumbers[row] == 1 &&
           tables.texts[tables.parserSidecars.functionNameTextIds[row]] ==
               "same":
            assert(matched < 0,
                   "compiler snapshot builder smoke: fixture parser function is not unique")
            matched = row
    assert(matched >= 0,
           "compiler snapshot builder smoke: fixture parser function missing")
    return matched

@borrows
fn SnapshotBuilderSmokeExpectedParserNode(
        tables: schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        producerNodeId: int32): int32 =
    var matched: int32 = -1
    for row in 0..<tables.parserNodes.sourceIds.len:
        if tables.parserNodes.sourceIds[row] == sourceId &&
           tables.parserNodes.producerNodeIds[row] == producerNodeId:
            assert(matched < 0,
                   "compiler snapshot builder smoke: parser producer identity duplicated")
            matched = row
    assert(matched >= 0,
           "compiler snapshot builder smoke: parser producer identity missing")
    return matched

@borrows
fn SnapshotBuilderSmokeSymbolForSourceKind(
        tables: schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        symbolKind: int32): int32 =
    var matched: int32 = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.sourceIds[symbolId] == sourceId &&
           tables.symbols.symbolKinds[symbolId] == symbolKind:
            assert(matched < 0,
                   "compiler snapshot builder smoke: source/kind Symbol is not unique")
            matched = symbolId
    assert(matched >= 0,
           "compiler snapshot builder smoke: source/kind Symbol missing")
    return matched

@borrows
fn SnapshotBuilderSmokeTypeDeclarationForSourceName(
        tables: schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        name: str): int32 =
    var matched: int32 = -1
    for declarationRow in 0..<
            tables.parserSidecars.declarationKinds.len:
        let nameTokenId =
            tables.parserSidecars.declarationNameTokenIds[declarationRow]
        if tables.parserSidecars.declarationProducerSourceIds[
               declarationRow] == sourceId &&
           tables.parserSidecars.declarationKinds[declarationRow] ==
               Int32(parser.ParserDeclarationType) &&
           nameTokenId >= 0 &&
           nameTokenId < tables.tokens.valueTextIds.len &&
           tables.texts[tables.tokens.valueTextIds[nameTokenId]] == name:
            assert(matched < 0,
                   "compiler snapshot builder smoke: exact Type declaration is not unique")
            matched = declarationRow
    assert(matched >= 0,
           "compiler snapshot builder smoke: exact Type declaration missing")
    return matched

@borrows
fn SnapshotBuilderSmokeTypeSymbolForSourceName(
        tables: schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        name: str): int32 =
    var matched: int32 = -1
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let nameTextId = tables.symbols.nameTextIds[symbolId]
        if tables.symbols.sourceIds[symbolId] == sourceId &&
           tables.symbols.symbolKinds[symbolId] ==
               schema.CsgCompilerSymbolType &&
           nameTextId >= 0 && nameTextId < tables.texts.len &&
           tables.texts[nameTextId] == name:
            assert(matched < 0,
                   "compiler snapshot builder smoke: exact Type Symbol is not unique")
            matched = symbolId
    assert(matched >= 0,
           "compiler snapshot builder smoke: exact Type Symbol missing")
    return matched

@borrows
fn SnapshotBuilderSmokeLegacyMixedCidFind(
        values: layout.FixedBytes32[],
        value: layout.FixedBytes32): int32 =
    var low: int32
    var high = values.len
    while low < high:
        let middle = low + (high - low) / 2
        if SnapshotBuilderSmokeCidLess(values[middle], value):
            low = middle + 1
        else:
            high = middle
    if low < values.len &&
       layout.FixedBytes32Equal(values[low], value):
        return low
    return -1

# Read-only over `prebuildFacts` and `finalizedReads`: the body only compares
# their rows against `tables`.
@borrows
fn SnapshotBuilderSmokeAssertProjectedColumns(
        tables: var schema.CsgCompilerSnapshotTables,
        prebuildFacts: incremental.SemanticSnapshotIncrementalPrebuildFacts,
        finalizedReads:
            incremental.SemanticSnapshotIncrementalFinalizedReadSet) =
    assert(tables.symbols.symbolCids.len == 4 &&
           tables.symbols.interfaceCids.len == 4 &&
           tables.symbols.declarationHeaderCids.len == 4 &&
           tables.symbols.declarationPathCids.len == 4 &&
           tables.symbols.nameSpanIds.len == 4 &&
           tables.symbols.nameTokenIds.len == 4 &&
           tables.functions.symbolIds.len == 2 &&
           tables.functions.typedFunctionIndexes.len == 2 &&
           tables.functions.fragmentCids.len == 2 &&
           tables.functions.parameterOwnershipStarts.len == 2 &&
           tables.functions.parameterOwnershipCounts.len == 2 &&
           tables.functions.parameterOwnershipKinds.len == 0 &&
           tables.readSet.readerFunctionIds.len == 1 &&
           tables.readSet.targetPortableKeyCids.len == 1 &&
           tables.references.sourceIds.len == 0 &&
           tables.calls.callReferenceIds.len == 0 &&
           tables.types.typeCids.len == 0 &&
           tables.lexicalScopes.sourceIds.len == 0 &&
           tables.typedNodes.functionIds.len == 4 &&
           tables.debugOps.typedNodeIds.len == 4,
           "compiler snapshot builder smoke: projected table shape mismatch")
    for functionId in 0..<tables.functions.symbolIds.len:
        let symbolId = tables.functions.symbolIds[functionId]
        let sourceId = prebuildFacts.functionSourceIds[functionId]
        let moduleSymbolId = SnapshotBuilderSmokeSymbolForSourceKind(
            tables, sourceId, schema.CsgCompilerSymbolModule)
        let parserFunctionRow =
            SnapshotBuilderSmokeExpectedParserFunctionRow(tables, sourceId)
        let expectedDeclarationSpan =
            tables.parserSidecars.functionDeclarationSpanIds[
                parserFunctionRow]
        let expectedBodySpan =
            tables.parserSidecars.functionBodySpanIds[parserFunctionRow]
        let expectedQualified = sourceId == 1 ?
            "pkg/zeta_alpha_6::same" : "pkg/alpha_beta::same"
        assert(layout.FixedBytes32Equal(
                   tables.symbols.symbolCids[symbolId],
                   prebuildFacts.symbolCids[functionId]) &&
               layout.FixedBytes32Equal(
                   tables.symbols.interfaceCids[symbolId],
                   prebuildFacts.symbolInterfaceCids[functionId]) &&
               tables.symbols.sourceIds[symbolId] == sourceId &&
               tables.texts[tables.symbols.nameTextIds[symbolId]] == "same" &&
               tables.symbols.nameSpanIds[symbolId] ==
                   tables.parserSidecars.functionNameSpanIds[
                       parserFunctionRow] &&
               tables.tokens.spanIds[
                   tables.symbols.nameTokenIds[symbolId]] ==
                   tables.symbols.nameSpanIds[symbolId] &&
               layout.FixedBytes32Equal(
                   tables.symbols.declarationHeaderCids[symbolId],
                   tables.parserSidecars.functionDeclarationHeaderCids[
                       parserFunctionRow]) &&
               layout.FixedBytes32Equal(
                   tables.symbols.declarationPathCids[symbolId],
                   tables.parserSidecars.functionDeclarationPathCids[
                       parserFunctionRow]) &&
               tables.texts[
                   tables.symbols.qualifiedNameTextIds[symbolId]] ==
                   expectedQualified &&
               tables.symbols.symbolKinds[symbolId] ==
                   schema.CsgCompilerSymbolFunction &&
               tables.symbols.typeIds[symbolId] == -1 &&
               tables.symbols.declarationSpanIds[symbolId] ==
                   expectedDeclarationSpan &&
               tables.symbols.ownerSymbolIds[symbolId] == moduleSymbolId &&
               tables.symbols.functionIds[symbolId] == functionId &&
               tables.symbols.exportedFlags[symbolId],
               "compiler snapshot builder smoke: projected symbol row mismatch")
        assert(tables.functions.symbolIds[functionId] == symbolId &&
               tables.functions.typedFunctionIndexes[functionId] ==
                   (sourceId == 1 ? 0 : 1) &&
               tables.functions.bodySpanIds[functionId] == expectedBodySpan &&
               layout.FixedBytes32Equal(
                   tables.functions.bodyContentCids[functionId],
                   prebuildFacts.bodyContentCids[functionId]) &&
               !layout.FixedBytes32Equal(
                   tables.functions.fragmentCids[functionId],
                   layout.FixedBytes32()) &&
               layout.FixedBytes32Equal(
                   tables.functions.interfaceCids[functionId],
                   prebuildFacts.functionInterfaceCids[functionId]) &&
               tables.functions.annotationFlags[functionId] == 0 &&
               tables.functions.resultOwnershipKinds[functionId] ==
                   schema.CsgCompilerOwnershipOwned &&
               tables.functions.parameterOwnershipStarts[functionId] == 0 &&
               tables.functions.parameterOwnershipCounts[functionId] == 0 &&
               tables.functions.readStarts[functionId] ==
                   finalizedReads.readStarts[functionId] &&
               tables.functions.readCounts[functionId] ==
                   finalizedReads.readCounts[functionId] &&
               layout.FixedBytes32Equal(
                   tables.functions.readSetPreimageCids[functionId],
                   finalizedReads.readSetPreimageCids[functionId]) &&
               tables.functions.nodeStarts[functionId] == functionId * 2 &&
               tables.functions.nodeCounts[functionId] == 2,
               "compiler snapshot builder smoke: projected function row mismatch")
        let expectedParserNode = SnapshotBuilderSmokeExpectedParserNode(
            tables, sourceId, 0)
        let expectedTypedNodeIndex = sourceId == 1 ? 0 : 2
        let returnsStr = sourceId == 0
        let typedRow = functionId * 2
        let syntheticRow = typedRow + 1
        assert(tables.typedNodes.typedIrNodeIndexes[typedRow] ==
                   expectedTypedNodeIndex &&
               tables.typedNodes.originParserNodeIds[typedRow] ==
                   expectedParserNode &&
               tables.typedNodes.syntheticOriginKinds[typedRow] == 0 &&
               tables.typedNodes.spanAuthorityKinds[typedRow] ==
                   texpr.TypedExprSpanAuthorityParserNode &&
               tables.typedNodes.functionIds[typedRow] == functionId &&
               tables.typedNodes.opKinds[typedRow] ==
                   Int32(returnsStr ?
                       texpr.TypedExprIrOpStrLit :
                       texpr.TypedExprIrOpI32Const) &&
               tables.typedNodes.typeIds[typedRow] == -1 &&
               tables.typedNodes.valueKinds[typedRow] == 0 &&
               tables.typedNodes.captureCounts[typedRow] == 0 &&
               tables.typedNodes.ownershipKinds[typedRow] ==
                   (returnsStr ?
                       schema.CsgCompilerOwnershipOwned :
                       schema.CsgCompilerOwnershipUnmanaged) &&
               tables.typedNodes.ownershipProofKinds[typedRow] == 0 &&
               layout.FixedBytes32Equal(
                   tables.typedNodes.ownershipProofCids[typedRow],
                   layout.FixedBytes32()) &&
               !tables.typedNodes.sendConclusions[typedRow] &&
               tables.typedNodes.sendProofKinds[typedRow] == 0 &&
               layout.FixedBytes32Equal(
                   tables.typedNodes.sendProofCids[typedRow],
                   layout.FixedBytes32()) &&
               tables.typedNodes.syncProofKinds[typedRow] == 0 &&
               !tables.typedNodes.syncConclusions[typedRow] &&
               layout.FixedBytes32Equal(
                   tables.typedNodes.syncProofCids[typedRow],
                   layout.FixedBytes32()) &&
               tables.typedNodes.shareKinds[typedRow] == 0 &&
               layout.FixedBytes32Equal(
                   tables.typedNodes.shareProofCids[typedRow],
                   layout.FixedBytes32()) &&
               tables.typedNodes.spanIds[typedRow] ==
                   tables.parserNodes.spanIds[expectedParserNode] &&
               tables.typedNodes.operand0NodeIds[typedRow] == -1 &&
               tables.typedNodes.operand1NodeIds[typedRow] == -1 &&
               tables.typedNodes.operand2NodeIds[typedRow] == -1 &&
               tables.debugOps.typedNodeIds[typedRow] == typedRow &&
               tables.debugOps.functionIds[typedRow] == functionId &&
               tables.debugOps.spanIds[typedRow] ==
                   tables.typedNodes.spanIds[typedRow] &&
               tables.debugOps.symbolIds[typedRow] == symbolId &&
               tables.debugOps.opKinds[typedRow] ==
                   tables.typedNodes.opKinds[typedRow] &&
               tables.typedNodes.typedIrNodeIndexes[syntheticRow] ==
                   expectedTypedNodeIndex + 1 &&
               tables.typedNodes.originParserNodeIds[syntheticRow] == -1 &&
               tables.typedNodes.syntheticOriginKinds[syntheticRow] ==
                   texpr.TypedExprSyntheticOriginDesugared &&
               tables.typedNodes.spanAuthorityKinds[syntheticRow] ==
                   texpr.TypedExprSpanAuthorityNoSource &&
               tables.typedNodes.spanIds[syntheticRow] == -1 &&
               tables.debugOps.typedNodeIds[syntheticRow] == syntheticRow &&
               tables.debugOps.spanIds[syntheticRow] == -1,
               "compiler snapshot builder smoke: exact typed/debug projection mismatch")
        if functionId > 0:
            assert(!layout.FixedBytes32Equal(
                       tables.functions.fragmentCids[0],
                       tables.functions.fragmentCids[functionId]),
                   "compiler snapshot builder smoke: fragment CID is not input-sensitive")
    for sourceId in 0..<tables.sources.documentCids.len:
        let moduleSymbolId = SnapshotBuilderSmokeSymbolForSourceKind(
            tables, sourceId, schema.CsgCompilerSymbolModule)
        assert(tables.symbols.nameSpanIds[moduleSymbolId] == -1 &&
               tables.symbols.nameTokenIds[moduleSymbolId] == -1 &&
               tables.symbols.declarationSpanIds[moduleSymbolId] == -1 &&
               tables.symbols.ownerSymbolIds[moduleSymbolId] == -1 &&
               tables.symbols.typeIds[moduleSymbolId] == -1 &&
               tables.symbols.functionIds[moduleSymbolId] == -1 &&
               !tables.symbols.exportedFlags[moduleSymbolId] &&
               tables.texts[tables.symbols.nameTextIds[moduleSymbolId]] ==
                   tables.texts[
                       tables.sources.modulePathTextIds[sourceId]],
               "compiler snapshot builder smoke: implicit module Symbol row mismatch")
    let readerSymbolId = finalizedReads.readSet.readerFunctionIds[0]
    assert(tables.readSet.readerFunctionIds[0] == readerSymbolId &&
           tables.readSet.targetDomainKinds[0] ==
               schema.CsgCompilerReadDomainSymbolInterface &&
           layout.FixedBytes32Equal(
               tables.readSet.targetPortableKeyCids[0],
               finalizedReads.readSet.targetPortableKeyCids[0]) &&
           layout.FixedBytes32Equal(
               tables.readSet.observedValueCids[0],
               finalizedReads.readSet.observedValueCids[0]),
           "compiler snapshot builder smoke: projected read-set row mismatch")
    assert(!layout.FixedBytes32Equal(
               tables.readSet.reverseIndexCid, layout.FixedBytes32()) &&
           tables.readSet.reverseStarts.len == 1 &&
           tables.readSet.reverseCounts.len == 1 &&
           tables.readSet.reverseCounts[0] == 1 &&
           tables.readSet.reverseReaderFunctionIds.len == 1 &&
           tables.readSet.reverseReaderFunctionIds[0] == readerSymbolId &&
           layout.FixedBytes32Equal(
               tables.readSet.reverseObservedValueCids[0],
               finalizedReads.readSet.observedValueCids[0]) &&
           tables.readSet.reverseForwardRowIds.len == 1 &&
           tables.readSet.reverseForwardRowIds[0] == 0,
           "compiler snapshot builder smoke: reverse read-set projection mismatch")
    var validateErr: str
    assert(schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               tables, validateErr),
           Fmt"compiler snapshot builder smoke: projected tables invalid {validateErr}")
    assert(!schema.CsgCompilerSnapshotTypedNodeTablesStrictValidateInto(
               tables, validateErr),
           "compiler snapshot builder smoke: missing TypeArena proofs admitted")
    assert(schema.CsgCompilerSnapshotTypedNodeProjectionTablesStrictValidateInto(
               tables, validateErr),
           Fmt"compiler snapshot builder smoke: exact partial typed/debug tables invalid {validateErr}")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               tables, validateErr),
           "compiler snapshot builder smoke: blocked projection passed full schema")
    var blockedCargo = snapshot_cargo.CsgCompilerSnapshotCargoBuild(tables)
    assert(!blockedCargo.ok,
           "compiler snapshot builder smoke: blocked projection emitted atomic cargo")

fn SnapshotBuilderSmokeSymbolReadTargetRebindInto(
        tables: var schema.CsgCompilerSnapshotTables,
        targetSymbolId: int32) =
    assert(targetSymbolId >= 0 &&
           targetSymbolId < tables.symbols.symbolCids.len &&
           tables.readSet.readerFunctionIds.len == 1 &&
           tables.readSet.targetDomainKinds.len == 1 &&
           tables.readSet.targetPortableKeyCids.len == 1 &&
           tables.readSet.observedValueCids.len == 1,
           "compiler snapshot builder smoke: old SymbolCid index fixture invalid")
    let readRow = int32(0)
    let readerFunctionId =
        tables.readSet.readerFunctionIds[readRow]
    assert(readerFunctionId >= 0 &&
           readerFunctionId < tables.functions.symbolIds.len &&
           tables.functions.readStarts[readerFunctionId] == readRow &&
           tables.functions.readCounts[readerFunctionId] == 1 &&
           !layout.FixedBytes32Equal(
               tables.symbols.interfaceCids[targetSymbolId],
               layout.FixedBytes32()),
           "compiler snapshot builder smoke: old SymbolCid read target unavailable")
    tables.readSet.targetDomainKinds[readRow] =
        schema.CsgCompilerReadDomainSymbolInterface
    tables.readSet.targetPortableKeyCids[readRow] =
        tables.symbols.symbolCids[targetSymbolId]
    tables.readSet.observedValueCids[readRow] =
        tables.symbols.interfaceCids[targetSymbolId]
    let readerSymbolId =
        tables.functions.symbolIds[readerFunctionId]
    var preimageCid: layout.FixedBytes32
    var err: str
    assert(schema.CsgCompilerReadSetPreimageCidInto(
               tables.symbols.symbolCids[readerSymbolId],
               tables.readSet.targetDomainKinds,
               tables.readSet.targetPortableKeyCids,
               tables.readSet.observedValueCids,
               readRow,
               1,
               preimageCid,
               err),
           Fmt"compiler snapshot builder smoke: read preimage rebuild failed {err}")
    tables.functions.readSetPreimageCids[readerFunctionId] = preimageCid
    assert(schema.CsgCompilerReadSetReverseBuildInto(tables, err) &&
           schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               tables, err),
           Fmt"compiler snapshot builder smoke: rebound read invalid {err}")

fn SnapshotBuilderSmokeOldSymbolCidIndex(
        projectedBase: var schema.CsgCompilerSnapshotTables,
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        csg: var compiler_csg.CompilerCsg) =
    assert(projectedBase.sources.documentCids.len == 2 &&
           projectedBase.symbols.symbolCids.len == 4,
           "compiler snapshot builder smoke: multi-source base Symbol domain missing")
    var typeDeclarationCount: int32
    for declarationRow in 0..<
            projectedBase.parserSidecars.declarationKinds.len:
        if projectedBase.parserSidecars.declarationKinds[declarationRow] ==
               Int32(parser.ParserDeclarationType):
            typeDeclarationCount = typeDeclarationCount + 1
    assert(typeDeclarationCount == 3,
           "compiler snapshot builder smoke: multi-Type declaration fixture missing")
    let targetPositions = [
        int32(0),
        projectedBase.symbols.symbolCids.len / 2,
        projectedBase.symbols.symbolCids.len - 1]
    var err: str
    let legacyMixedMutation = [
        SnapshotBuilderSmokeCid(10, 0),
        SnapshotBuilderSmokeCid(20, 0),
        SnapshotBuilderSmokeCid(30, 0),
        SnapshotBuilderSmokeCid(40, 0),
        SnapshotBuilderSmokeCid(5, 0),
        SnapshotBuilderSmokeCid(50, 0),
        SnapshotBuilderSmokeCid(15, 0),
        SnapshotBuilderSmokeCid(45, 0)]
    assert(SnapshotBuilderSmokeLegacyMixedCidFind(
               legacyMixedMutation,
               legacyMixedMutation[1]) < 0,
           "compiler snapshot builder smoke: mixed-CID binary-search mutation did not fail")
    for targetIndex in 0..<targetPositions.len:
        let targetPosition = targetPositions[targetIndex]
        let targetSourceId =
            projectedBase.symbols.sourceIds[targetPosition]
        let targetKind =
            projectedBase.symbols.symbolKinds[targetPosition]
        var candidate =
            schema.CsgCompilerSnapshotTablesClone(projectedBase)
        SnapshotBuilderSmokeSymbolReadTargetRebindInto(
            candidate, targetPosition)
        assert(builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                   candidate, sidecars, csg, err),
               Fmt"compiler snapshot builder smoke: old SymbolCid index lookup failed position={targetPosition} err={err}")
        let remappedTarget = SnapshotBuilderSmokeSymbolForSourceKind(
            candidate, targetSourceId, targetKind)
        assert(layout.FixedBytes32Equal(
                   candidate.readSet.targetPortableKeyCids[0],
                   candidate.symbols.symbolCids[remappedTarget]),
               "compiler snapshot builder smoke: old SymbolCid read remap drift")

    var missingReadKeyAttack =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    missingReadKeyAttack.readSet.targetPortableKeyCids[0].data[0] =
        uint8(Int32(
            missingReadKeyAttack.readSet.targetPortableKeyCids[0].data[0]) ^
            1)
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                missingReadKeyAttack, sidecars, csg, err) &&
           missingReadKeyAttack.types.typeCids.len == 0,
           "compiler snapshot builder smoke: missing old SymbolCid read key survived")

    var readKeyTamperAttack =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    let originalTarget =
        readKeyTamperAttack.readSet.targetPortableKeyCids[0]
    var replacementSymbolId: int32 = -1
    for symbolId in 0..<readKeyTamperAttack.symbols.symbolCids.len:
        if replacementSymbolId < 0 &&
           !layout.FixedBytes32Equal(
               readKeyTamperAttack.symbols.symbolCids[symbolId],
               originalTarget) &&
           !layout.FixedBytes32Equal(
               readKeyTamperAttack.symbols.interfaceCids[symbolId],
               readKeyTamperAttack.readSet.observedValueCids[0]):
            replacementSymbolId = symbolId
    assert(replacementSymbolId >= 0,
           "compiler snapshot builder smoke: read-key attack replacement missing")
    readKeyTamperAttack.readSet.targetPortableKeyCids[0] =
        readKeyTamperAttack.symbols.symbolCids[replacementSymbolId]
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                readKeyTamperAttack, sidecars, csg, err) &&
           readKeyTamperAttack.types.typeCids.len == 0,
           "compiler snapshot builder smoke: old SymbolCid read-key tamper survived")

    var duplicateKeyAttack =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    duplicateKeyAttack.symbols.symbolCids[1] =
        duplicateKeyAttack.symbols.symbolCids[0]
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                duplicateKeyAttack, sidecars, csg, err) &&
           duplicateKeyAttack.types.typeCids.len == 0,
           "compiler snapshot builder smoke: duplicate old SymbolCid key survived")
    echo("compiler_snapshot_builder_old_symbol_cid_index=1")
    echo("compiler_snapshot_builder_old_symbol_cid_attacks_rejected=1")

fn SnapshotBuilderSmokeTypeFunctionProjection(
        projectedBase: var schema.CsgCompilerSnapshotTables,
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        csg: var compiler_csg.CompilerCsg) =
    SnapshotBuilderSmokeOldSymbolCidIndex(projectedBase, sidecars, csg)
    var tables = schema.CsgCompilerSnapshotTablesClone(projectedBase)
    var err: str
    let provisionalOwnerFunctionId: int32 = 0
    let provisionalTargetFunctionId: int32 = 1
    let provisionalOwnerSymbolId =
        tables.functions.symbolIds[provisionalOwnerFunctionId]
    let provisionalOwnerSourceId =
        tables.symbols.sourceIds[provisionalOwnerSymbolId]
    let provisionalOwnerParserFunctionRow =
        SnapshotBuilderSmokeExpectedParserFunctionRow(
            tables, provisionalOwnerSourceId)
    add(tables.references.sourceIds, provisionalOwnerSourceId)
    add(tables.references.spanIds,
        tables.parserSidecars.functionNameSpanIds[
            provisionalOwnerParserFunctionRow])
    add(tables.references.ownerFunctionIds,
        provisionalOwnerFunctionId)
    add(tables.references.ownerSymbolIds,
        provisionalOwnerSymbolId)
    add(tables.references.targetSymbolIds,
        tables.functions.symbolIds[provisionalTargetFunctionId])
    add(tables.references.referenceKinds,
        schema.CsgCompilerReferenceCall)
    var projectionReceipt: builder.CompilerSnapshotTypeProjectionReceipt
    assert(builder.CompilerSnapshotTypeFunctionSignatureTablesProjectWithReceiptInto(
               tables, sidecars, csg, projectionReceipt, err),
           Fmt"compiler snapshot builder smoke: type/signature projection failed {err}")
    assert(builder.CompilerSnapshotTypeProjectionReceiptStrictValidateInto(
           tables, sidecars, csg, projectionReceipt, err) &&
           !projectionReceipt.admissionBlocked &&
           projectionReceipt.projectedFunctionSignatureCount == 2 &&
           projectionReceipt.projectedTypeCount ==
               csg.typeArena.typeCount +
                   projectionReceipt.projectedFunctionSignatureCount,
           Fmt"compiler snapshot builder smoke: type receipt invalid {err}")
    var projectionReceiptAttack = projectionReceipt
    projectionReceiptAttack.projectedTypeCount =
        projectionReceiptAttack.projectedTypeCount + 1
    assert(!builder.CompilerSnapshotTypeProjectionReceiptStrictValidateInto(
                tables, sidecars, csg, projectionReceiptAttack, err),
           "compiler snapshot builder smoke: projected type receipt tamper survived")
    assert(builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
               tables, sidecars, csg, err),
           Fmt"compiler snapshot builder smoke: type/signature binding invalid {err}")
    assert(builder.CompilerSnapshotProductionDiagnosticCompletionsProjectInto(
               tables, csg, err) &&
           builder.CompilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
               tables, sidecars, csg, err) &&
           tables.diagnosticCompletions.sourceIds.len ==
               tables.sources.documentCids.len *
                   (schema.CsgCompilerDiagnosticLayout -
                        schema.CsgCompilerDiagnosticParser + 1) &&
           tables.diagnostics.sourceIds.len == 0,
           Fmt"compiler snapshot builder smoke: diagnostic completion failed {err}")
    let diagnosticProducerCount =
        schema.CsgCompilerDiagnosticLayout -
            schema.CsgCompilerDiagnosticParser + 1
    for sourceId in 0..<tables.sources.documentCids.len:
        for producerOffset in 0..<diagnosticProducerCount:
            let row = sourceId * diagnosticProducerCount +
                producerOffset
            assert(tables.diagnosticCompletions.sourceIds[row] ==
                       sourceId &&
                   tables.diagnosticCompletions.producerKinds[row] ==
                       schema.CsgCompilerDiagnosticParser +
                           producerOffset &&
                   tables.diagnosticCompletions.rowStarts[row] == 0 &&
                   tables.diagnosticCompletions.rowCounts[row] == 0 &&
                   !layout.FixedBytes32Equal(
                       tables.diagnosticCompletions.producerReceiptCids[
                           row],
                       layout.FixedBytes32()),
                   "compiler snapshot builder smoke: diagnostic CSR drift")
    var diagnosticReceiptAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    diagnosticReceiptAttack.diagnosticCompletions.producerReceiptCids[0] =
        SnapshotBuilderSmokeCid(91, 7)
    assert(!builder.CompilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
                diagnosticReceiptAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: diagnostic receipt tamper survived")
    var diagnosticCoverageAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    diagnosticCoverageAttack.diagnosticCompletions.sourceIds = [
        diagnosticCoverageAttack.diagnosticCompletions.sourceIds[0]]
    assert(!builder.CompilerSnapshotProductionDiagnosticCompletionsStrictValidateInto(
                diagnosticCoverageAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: diagnostic completion gap survived")
    echo("compiler_snapshot_builder_diagnostic_completion=1")
    assert(schema.CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
               tables, err),
           Fmt"compiler snapshot builder smoke: exact symbol/function tables invalid {err}")
    assert(tables.functions.parameterOwnershipKinds.len == 3,
           "compiler snapshot builder smoke: parameter ownership domain mismatch")
    for functionId in 0..<tables.functions.symbolIds.len:
        let functionSymbolId = tables.functions.symbolIds[functionId]
        let functionSourceId =
            tables.symbols.sourceIds[functionSymbolId]
        let ownershipStart =
            tables.functions.parameterOwnershipStarts[functionId]
        let ownershipCount =
            tables.functions.parameterOwnershipCounts[functionId]
        if functionSourceId == 1:
            assert(ownershipCount == 2 &&
                   tables.functions.parameterOwnershipKinds[
                       ownershipStart] ==
                       schema.CsgCompilerOwnershipBorrowed &&
                   tables.functions.parameterOwnershipKinds[
                       ownershipStart + 1] ==
                       schema.CsgCompilerOwnershipUnmanaged,
                   "compiler snapshot builder smoke: var/value ownership projection drift")
        else:
            assert(functionSourceId == 0 &&
                   ownershipCount == 1 &&
                   tables.functions.parameterOwnershipKinds[
                       ownershipStart] ==
                       schema.CsgCompilerOwnershipOwned,
                   "compiler snapshot builder smoke: managed ownership projection drift")
    var ownershipKindAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    let attackedOwnershipKind =
        ownershipKindAttack.functions.parameterOwnershipKinds[0]
    ownershipKindAttack.functions.parameterOwnershipKinds[0] =
        attackedOwnershipKind == schema.CsgCompilerOwnershipOwned ?
            schema.CsgCompilerOwnershipUnmanaged :
            schema.CsgCompilerOwnershipOwned
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                ownershipKindAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: parameter ownership kind tamper survived")
    var ownershipStartAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    ownershipStartAttack.functions.parameterOwnershipStarts[1] =
        ownershipStartAttack.functions.parameterOwnershipStarts[1] + 1
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                ownershipStartAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: parameter ownership start tamper survived")
    var ownershipCountAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    ownershipCountAttack.functions.parameterOwnershipCounts[0] =
        ownershipCountAttack.functions.parameterOwnershipCounts[0] + 1
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                ownershipCountAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: parameter ownership count tamper survived")
    assert(tables.references.ownerSymbolIds.len == 1 &&
           tables.references.ownerSymbolIds[0] ==
               tables.functions.symbolIds[provisionalOwnerFunctionId] &&
           tables.references.targetSymbolIds[0] ==
               tables.functions.symbolIds[provisionalTargetFunctionId],
           "compiler snapshot builder smoke: reference SymbolId exact remap drift")
    var referenceOwnerAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    referenceOwnerAttack.references.ownerSymbolIds[0] =
        referenceOwnerAttack.functions.symbolIds[
            provisionalTargetFunctionId]
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                referenceOwnerAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: reference owner remap attack survived")
    var referenceTargetAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    referenceTargetAttack.references.targetSymbolIds[0] =
        referenceTargetAttack.symbols.ownerSymbolIds[
            referenceTargetAttack.functions.symbolIds[
                provisionalTargetFunctionId]]
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                referenceTargetAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: reference target remap attack survived")
    echo("compiler_snapshot_builder_reference_owner_exact_remap=1")
    echo("compiler_snapshot_builder_reference_target_exact_remap=1")
    let functionSymbol0 = tables.functions.symbolIds[0]
    let functionSymbol1 = tables.functions.symbolIds[1]
    assert(tables.types.typeCids.len ==
               csg.typeArena.typeCount + 2 &&
           tables.symbols.typeIds.len == 7 &&
           tables.symbols.typeIds[functionSymbol0] !=
               tables.symbols.typeIds[functionSymbol1],
           "compiler snapshot builder smoke: exact signature TypeId count mismatch")
    var zeroParamSignatureCount: int32
    var oneParamSignatureCount: int32
    var twoParamSignatureCount: int32
    var scalarCount: int32
    var int32ScalarCount: int32
    var strScalarCount: int32
    var borrowCount: int32
    var sequenceCount: int32
    var arrayCount: int32
    var tupleCount: int32
    var aliasCount: int32
    var producerTypeArenaSeen: bool[]
    setLen(producerTypeArenaSeen, csg.typeArena.typeCount)
    var producerTypeArenaCount: int32
    var firstAliasTypeId: int32 = -1
    var secondDistinctAliasTypeId: int32 = -1
    for typeId in 0..<tables.types.typeCids.len:
        if typeId > 0:
            assert(SnapshotBuilderSmokeCidLess(
                       tables.types.typeCids[typeId - 1],
                       tables.types.typeCids[typeId]),
                   "compiler snapshot builder smoke: TypeCid order drift")
        if tables.types.typeKinds[typeId] == schema.CsgCompilerTypeFunction:
            assert(tables.types.producerTypeArenaIds[typeId] == -1,
                   "compiler snapshot builder smoke: synthesized signature gained a TypeArena row")
            if tables.types.argCounts[typeId] == 0:
                zeroParamSignatureCount = zeroParamSignatureCount + 1
            elif tables.types.argCounts[typeId] == 1:
                oneParamSignatureCount = oneParamSignatureCount + 1
            elif tables.types.argCounts[typeId] == 2:
                twoParamSignatureCount = twoParamSignatureCount + 1
            else:
                assert(false,
                       "compiler snapshot builder smoke: unexpected function signature arity")
        elif tables.types.typeKinds[typeId] ==
                 schema.CsgCompilerTypeScalar:
            scalarCount = scalarCount + 1
            if tables.types.scalarKinds[typeId] ==
                   schema.CsgCompilerScalarInt32:
                int32ScalarCount = int32ScalarCount + 1
                assert(!tables.types.managedFlags[typeId] &&
                       tables.types.sendFlags[typeId] &&
                       tables.types.syncFlags[typeId],
                       "compiler snapshot builder smoke: int32 trait projection drift")
            elif tables.types.scalarKinds[typeId] ==
                     schema.CsgCompilerScalarStr:
                strScalarCount = strScalarCount + 1
                assert(tables.types.managedFlags[typeId] &&
                       !tables.types.sendFlags[typeId] &&
                       !tables.types.syncFlags[typeId],
                       "compiler snapshot builder smoke: str trait projection drift")
            elif tables.types.scalarKinds[typeId] ==
                     schema.CsgCompilerScalarCString:
                assert(!tables.types.managedFlags[typeId] &&
                       !tables.types.sendFlags[typeId] &&
                       !tables.types.syncFlags[typeId],
                       "compiler snapshot builder smoke: cstring trait projection drift")
            else:
                assert(!tables.types.managedFlags[typeId] &&
                       tables.types.sendFlags[typeId] &&
                       tables.types.syncFlags[typeId],
                       "compiler snapshot builder smoke: plain scalar trait projection drift")
        elif tables.types.typeKinds[typeId] ==
                 schema.CsgCompilerTypeBorrow:
            borrowCount = borrowCount + 1
            assert(!tables.types.managedFlags[typeId] &&
                   !tables.types.sendFlags[typeId] &&
                   !tables.types.syncFlags[typeId] &&
                   tables.types.elementTypeIds[typeId] >= 0,
                   "compiler snapshot builder smoke: borrow projection drift")
        elif tables.types.typeKinds[typeId] ==
                 schema.CsgCompilerTypeSequence:
            sequenceCount = sequenceCount + 1
            assert(tables.types.managedFlags[typeId] &&
                   !tables.types.sendFlags[typeId] &&
                   !tables.types.syncFlags[typeId] &&
                   tables.types.elementTypeIds[typeId] >= 0,
                   "compiler snapshot builder smoke: sequence projection drift")
        elif tables.types.typeKinds[typeId] ==
                 schema.CsgCompilerTypeArray:
            arrayCount = arrayCount + 1
            assert(tables.types.arrayLengths[typeId] == 2 &&
                   !tables.types.managedFlags[typeId] &&
                   tables.types.sendFlags[typeId] &&
                   tables.types.syncFlags[typeId] &&
                   tables.types.elementTypeIds[typeId] >= 0,
                   "compiler snapshot builder smoke: fixed-array projection drift")
        elif tables.types.typeKinds[typeId] ==
                 schema.CsgCompilerTypeTuple:
            tupleCount = tupleCount + 1
            assert(tables.types.argCounts[typeId] == 2 &&
                   tables.types.managedFlags[typeId] &&
                   !tables.types.sendFlags[typeId] &&
                   !tables.types.syncFlags[typeId],
                   "compiler snapshot builder smoke: tuple projection drift")
        elif tables.types.typeKinds[typeId] ==
                 schema.CsgCompilerTypeAlias:
            aliasCount = aliasCount + 1
            let producerTypeArenaId =
                tables.types.producerTypeArenaIds[typeId]
            let targetTypeId =
                tables.types.aliasTargetTypeIds[typeId]
            assert(targetTypeId >= 0 &&
                   targetTypeId < tables.types.typeCids.len &&
                   producerTypeArenaId >= 0 &&
                   producerTypeArenaId < csg.typeArena.typeCount &&
                   arenamod.ArenaArrayInt32Get(
                       csg.typeArena.arena,
                       csg.typeArena.typeKinds,
                       producerTypeArenaId) ==
                       Int32(typearena.TypedExprStructuralTypeAlias) &&
                   arenamod.ArenaArrayInt32Get(
                       csg.typeArena.arena,
                       csg.typeArena.childCounts,
                       producerTypeArenaId) == 1 &&
                   arenamod.ArenaArrayInt32Get(
                       csg.typeArena.arena,
                       csg.typeArena.childTypeIds,
                       arenamod.ArenaArrayInt32Get(
                           csg.typeArena.arena,
                           csg.typeArena.childStarts,
                           producerTypeArenaId)) ==
                       tables.types.producerTypeArenaIds[targetTypeId] &&
                   tables.types.declSymbolIds[typeId] >= 0 &&
                   tables.types.traitPremiseCounts[typeId] == 1 &&
                   tables.types.traitPremiseTypeIds[
                       tables.types.traitPremiseStarts[typeId]] ==
                       targetTypeId &&
                   tables.types.managedFlags[typeId] ==
                       tables.types.managedFlags[targetTypeId] &&
                   tables.types.sendFlags[typeId] ==
                       tables.types.sendFlags[targetTypeId] &&
                   tables.types.syncFlags[typeId] ==
                       tables.types.syncFlags[targetTypeId],
                   "compiler snapshot builder smoke: alias projection drift")
            if firstAliasTypeId < 0:
                firstAliasTypeId = typeId
            elif secondDistinctAliasTypeId < 0 &&
                 tables.types.producerTypeArenaIds[
                     tables.types.aliasTargetTypeIds[
                         firstAliasTypeId]] !=
                     tables.types.producerTypeArenaIds[targetTypeId]:
                secondDistinctAliasTypeId = typeId
        else:
            assert(false,
                   "compiler snapshot builder smoke: unexpected projected type kind")
        let producerTypeArenaId =
            tables.types.producerTypeArenaIds[typeId]
        if producerTypeArenaId >= 0:
            assert(producerTypeArenaId < producerTypeArenaSeen.len &&
                   !producerTypeArenaSeen[producerTypeArenaId],
                   "compiler snapshot builder smoke: producer TypeArena bridge is not bijective")
            producerTypeArenaSeen[producerTypeArenaId] = true
            producerTypeArenaCount =
                producerTypeArenaCount + 1
    assert(zeroParamSignatureCount == 0 &&
           oneParamSignatureCount == 1 &&
           twoParamSignatureCount == 1 &&
           scalarCount == 15 && int32ScalarCount == 1 &&
           strScalarCount == 1 && borrowCount == 1 &&
           sequenceCount == 0 && arrayCount == 0 && tupleCount == 0 &&
           aliasCount == 3,
           "compiler snapshot builder smoke: exact int32/str overload types missing")
    assert(producerTypeArenaCount == csg.typeArena.typeCount,
           "compiler snapshot builder smoke: producer TypeArena coverage mismatch")
    for producerTypeArenaId in 0..<producerTypeArenaSeen.len:
        assert(producerTypeArenaSeen[producerTypeArenaId],
               "compiler snapshot builder smoke: producer TypeArena row missing")
    assert(firstAliasTypeId >= 0 &&
           secondDistinctAliasTypeId >= 0,
           "compiler snapshot builder smoke: distinct alias bridge fixture missing")
    var baselineBridgeCargoInput =
        schema.CsgCompilerSnapshotTablesClone(tables)
    let baselineBridgeCargo =
        snapshot_cargo.CsgCompilerSnapshotCargoBuild(
            baselineBridgeCargoInput)
    assert(baselineBridgeCargo.ok,
           baselineBridgeCargo.error)
    var aliasBridgeAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    let firstAliasProducer =
        aliasBridgeAttack.types.producerTypeArenaIds[
            firstAliasTypeId]
    aliasBridgeAttack.types.producerTypeArenaIds[
        firstAliasTypeId] =
        aliasBridgeAttack.types.producerTypeArenaIds[
            secondDistinctAliasTypeId]
    aliasBridgeAttack.types.producerTypeArenaIds[
        secondDistinctAliasTypeId] = firstAliasProducer
    assert(layout.FixedBytes32Equal(
               tables.types.typeCids[firstAliasTypeId],
               aliasBridgeAttack.types.typeCids[firstAliasTypeId]) &&
           layout.FixedBytes32Equal(
               tables.types.typeCids[secondDistinctAliasTypeId],
               aliasBridgeAttack.types.typeCids[
                   secondDistinctAliasTypeId]),
           "compiler snapshot builder smoke: producer TypeArena bridge mutation changed a TypeCid")
    var attackedBridgeCargoInput =
        schema.CsgCompilerSnapshotTablesClone(aliasBridgeAttack)
    let attackedBridgeCargo =
        snapshot_cargo.CsgCompilerSnapshotCargoBuild(
            attackedBridgeCargoInput)
    assert(attackedBridgeCargo.ok &&
           !layout.FixedBytes32Equal(
               baselineBridgeCargo.proofRoots.typeRootCid,
               attackedBridgeCargo.proofRoots.typeRootCid) &&
           !layout.FixedBytes32Equal(
               baselineBridgeCargo.cargoCid,
               attackedBridgeCargo.cargoCid) &&
           !layout.FixedBytes32Equal(
               baselineBridgeCargo.proofRoots.lifecycleRootCid,
               attackedBridgeCargo.proofRoots.lifecycleRootCid),
           "compiler snapshot builder smoke: producer TypeArena bridge mutation did not change bound roots")
    assert(schema.CsgCompilerSnapshotSymbolFunctionTablesStrictValidateInto(
               aliasBridgeAttack, err),
           Fmt"compiler snapshot builder smoke: schema-local alias bridge attack was not self-consistent {err}")
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                aliasBridgeAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: alias target TypeArena bridge swap survived")
    for symbolId in 0..<tables.symbols.symbolCids.len:
        let typeId = tables.symbols.typeIds[symbolId]
        let functionId = tables.symbols.functionIds[symbolId]
        let declId = tables.symbols.declIds[symbolId]
        let sourceId = tables.symbols.sourceIds[symbolId]
        assert(declId >= 0 &&
               declId < tables.declarations.declIds.len &&
               layout.FixedBytes32Equal(
                   tables.symbols.symbolCids[symbolId],
                   tables.symbols.declKeyCids[symbolId]) &&
               layout.FixedBytes32Equal(
                   tables.symbols.declKeyCids[symbolId],
                   tables.declarations.declKeyCids[declId]),
               "compiler snapshot builder smoke: exact Symbol declaration identity missing")
        if tables.symbols.symbolKinds[symbolId] ==
               schema.CsgCompilerSymbolModule:
            assert(typeId == -1 && functionId == -1 &&
                   tables.symbols.ownerSymbolIds[symbolId] == -1 &&
                   tables.declarations.declarationKinds[declId] ==
                       declaration.SemanticSnapshotDeclarationKindModule &&
                   tables.declarations.ownerDeclIds[declId] == -1 &&
                   tables.declarations.canonicalNames[declId] ==
                       tables.texts[
                           tables.sources.modulePathTextIds[sourceId]],
                   "compiler snapshot builder smoke: exact Module declaration missing")
            continue
        let moduleSymbolId =
            SnapshotBuilderSmokeSymbolForSourceKind(
                tables, sourceId, schema.CsgCompilerSymbolModule)
        if tables.symbols.symbolKinds[symbolId] ==
               schema.CsgCompilerSymbolType:
            let symbolName =
                tables.texts[tables.symbols.nameTextIds[symbolId]]
            let declarationRow =
                SnapshotBuilderSmokeTypeDeclarationForSourceName(
                    tables, sourceId, symbolName)
            let nameTokenId =
                tables.parserSidecars.declarationNameTokenIds[
                    declarationRow]
            let nameSpanId =
                tables.parserSidecars.declarationNameSpanIds[
                    declarationRow]
            let declarationSpanId =
                tables.parserSidecars.declarationSpanIds[
                    declarationRow]
            var aliasTypeId: int32 = -1
            for candidateTypeId in 0..<tables.types.typeCids.len:
                if tables.types.typeKinds[candidateTypeId] ==
                       schema.CsgCompilerTypeAlias &&
                   tables.types.declSymbolIds[candidateTypeId] ==
                       symbolId:
                    assert(aliasTypeId < 0,
                           "compiler snapshot builder smoke: Type Symbol has two alias rows")
                    aliasTypeId = candidateTypeId
            assert(tables.symbols.ownerSymbolIds[symbolId] ==
                       moduleSymbolId &&
                   functionId == -1 &&
                   typeId >= 0 &&
                   typeId < tables.types.typeCids.len &&
                   tables.types.typeKinds[typeId] ==
                       schema.CsgCompilerTypeScalar &&
                   aliasTypeId >= 0 &&
                   tables.types.aliasTargetTypeIds[aliasTypeId] ==
                       typeId &&
                   tables.symbols.nameTokenIds[symbolId] ==
                       nameTokenId &&
                   tables.symbols.nameSpanIds[symbolId] ==
                       nameSpanId &&
                   tables.symbols.declarationSpanIds[symbolId] ==
                       declarationSpanId &&
                   tables.tokens.sourceIds[nameTokenId] == sourceId &&
                   tables.spans.sourceIds[nameSpanId] == sourceId &&
                   tables.spans.sourceIds[declarationSpanId] == sourceId &&
                   tables.declarations.declarationKinds[declId] ==
                       declaration.SemanticSnapshotDeclarationKindType &&
                   tables.declarations.ownerDeclIds[declId] >= 0 &&
                   tables.declarations.canonicalNames[declId] ==
                       symbolName &&
                   layout.FixedBytes32Equal(
                       tables.declarations.portableSignatureTypeExpressionCids[
                           declId],
                       tables.types.typeCids[typeId]) &&
                   !layout.FixedBytes32Equal(
                       tables.symbols.interfaceCids[symbolId],
                       layout.FixedBytes32()),
                   "compiler snapshot builder smoke: exact Type Symbol declaration missing")
            continue
        let ownerDeclId = tables.declarations.ownerDeclIds[declId]
        let parserFunctionRow =
            SnapshotBuilderSmokeExpectedParserFunctionRow(
                tables, sourceId)
        let projectedFunctionSymbol =
            SnapshotBuilderSmokeSymbolForSourceKind(
                projectedBase, sourceId, schema.CsgCompilerSymbolFunction)
        assert(tables.symbols.symbolKinds[symbolId] ==
                   schema.CsgCompilerSymbolFunction &&
               tables.symbols.ownerSymbolIds[symbolId] == moduleSymbolId &&
               typeId >= 0 && typeId < tables.types.typeCids.len &&
               tables.types.typeKinds[typeId] ==
                   schema.CsgCompilerTypeFunction &&
               declId >= 0 &&
               declId < tables.declarations.declIds.len &&
               tables.declarations.declarationKinds[declId] ==
                   declaration.SemanticSnapshotDeclarationKindFunction &&
               ownerDeclId >= 0 &&
               tables.declarations.declarationKinds[ownerDeclId] ==
                   declaration.SemanticSnapshotDeclarationKindModule &&
               tables.declarations.canonicalNames[declId] == "same" &&
               tables.declarations.portableDocumentModulePaths[declId] ==
                   tables.texts[
                       tables.sources.modulePathTextIds[sourceId]] &&
               layout.FixedBytes32Equal(
                   tables.declarations.parserValidatedNameProofCids[
                       declId],
                   tables.parserSidecars.functionNameProofCids[
                       parserFunctionRow]) &&
               layout.FixedBytes32Equal(
                   tables.declarations.portableSignatureTypeExpressionCids[
                       declId],
                   tables.types.typeCids[typeId]) &&
               layout.FixedBytes32Equal(
                   tables.symbols.interfaceCids[symbolId],
                   tables.functions.interfaceCids[functionId]) &&
               !layout.FixedBytes32Equal(
                   tables.symbols.interfaceCids[symbolId],
                   projectedBase.symbols.interfaceCids[
                       projectedFunctionSymbol]),
               "compiler snapshot builder smoke: exact function interface missing")
    assert(tables.declarations.declIds.len == 7 &&
           tables.symbols.declIds.len == 7 &&
           tables.symbols.declKeyCids.len == 7 &&
           !layout.FixedBytes32Equal(
               tables.symbols.declKeyCids[functionSymbol0],
               tables.symbols.declKeyCids[functionSymbol1]) &&
           !layout.FixedBytes32Equal(
               tables.types.typeCids[
                   tables.symbols.typeIds[functionSymbol0]],
               tables.types.typeCids[
                   tables.symbols.typeIds[functionSymbol1]]),
           "compiler snapshot builder smoke: int32/str overload DeclKey collapsed")
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err),
           "compiler snapshot builder smoke: type-only slice bypassed missing value proofs")

    var deterministic = schema.CsgCompilerSnapshotTablesClone(projectedBase)
    assert(builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
               deterministic, sidecars, csg, err) &&
           builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
               deterministic, sidecars, csg, err),
           Fmt"compiler snapshot builder smoke: deterministic type projection failed {err}")
    for typeId in 0..<tables.types.typeCids.len:
        assert(layout.FixedBytes32Equal(
                   tables.types.typeCids[typeId],
                   deterministic.types.typeCids[typeId]) &&
               tables.types.producerTypeArenaIds[typeId] ==
                   deterministic.types.producerTypeArenaIds[typeId] &&
               tables.types.canonicalTextIds[typeId] ==
                   deterministic.types.canonicalTextIds[typeId],
               "compiler snapshot builder smoke: type projection is nondeterministic")
    assert(layout.FixedBytes32Equal(
               tables.declarations.tableCid,
               deterministic.declarations.tableCid) &&
           tables.declarations.declKeyCids.len ==
               deterministic.declarations.declKeyCids.len,
           "compiler snapshot builder smoke: declaration table is nondeterministic")
    for declId in 0..<tables.declarations.declKeyCids.len:
        assert(layout.FixedBytes32Equal(
                   tables.declarations.declKeyCids[declId],
                   deterministic.declarations.declKeyCids[declId]),
               "compiler snapshot builder smoke: declaration canonical order drift")
    var ownershipDeterministic =
        tables.functions.parameterOwnershipKinds.len ==
            deterministic.functions.parameterOwnershipKinds.len
    if ownershipDeterministic:
        for functionId in 0..<tables.functions.symbolIds.len:
            if tables.functions.parameterOwnershipStarts[functionId] !=
                   deterministic.functions.parameterOwnershipStarts[
                       functionId] ||
               tables.functions.parameterOwnershipCounts[functionId] !=
                   deterministic.functions.parameterOwnershipCounts[
                       functionId]:
                ownershipDeterministic = false
        for ownershipId in 0..<
                tables.functions.parameterOwnershipKinds.len:
            if tables.functions.parameterOwnershipKinds[ownershipId] !=
                   deterministic.functions.parameterOwnershipKinds[
                       ownershipId]:
                ownershipDeterministic = false
    assert(ownershipDeterministic,
           "compiler snapshot builder smoke: parameter ownership projection is nondeterministic")

    let alphaDeclaration =
        SnapshotBuilderSmokeTypeDeclarationForSourceName(
            projectedBase, 1, "Alpha")
    let gammaDeclaration =
        SnapshotBuilderSmokeTypeDeclarationForSourceName(
            projectedBase, 1, "Gamma")
    let alphaTypeRoot =
        projectedBase.parserSidecars.declarationTypeSyntaxRootIds[
            alphaDeclaration]
    let gammaTypeRoot =
        projectedBase.parserSidecars.declarationTypeSyntaxRootIds[
            gammaDeclaration]
    assert(alphaTypeRoot >= 0 && gammaTypeRoot >= 0 &&
           alphaTypeRoot != gammaTypeRoot,
           "compiler snapshot builder smoke: same-source Type roots missing")
    var swappedTypeRootAttack =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    swappedTypeRootAttack.parserSidecars.declarationTypeSyntaxRootIds[
        alphaDeclaration] = gammaTypeRoot
    swappedTypeRootAttack.parserSidecars.declarationTypeSyntaxRootIds[
        gammaDeclaration] = alphaTypeRoot
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                swappedTypeRootAttack, sidecars, csg, err) &&
           swappedTypeRootAttack.types.typeCids.len == 0 &&
           err ==
               " compiler snapshot builder: parser Type declaration root join drift",
           "compiler snapshot builder smoke: same-source Type root swap survived")
    var duplicateTypeRootAttack =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    duplicateTypeRootAttack.parserSidecars.declarationTypeSyntaxRootIds[
        gammaDeclaration] = alphaTypeRoot
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                duplicateTypeRootAttack, sidecars, csg, err) &&
           duplicateTypeRootAttack.types.typeCids.len == 0,
           "compiler snapshot builder smoke: duplicate Type root survived")
    var missingTypeRootAttack =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    missingTypeRootAttack.parserSidecars.declarationTypeSyntaxRootIds[
        gammaDeclaration] = -1
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                missingTypeRootAttack, sidecars, csg, err) &&
           missingTypeRootAttack.types.typeCids.len == 0,
           "compiler snapshot builder smoke: missing Type root survived")
    var crossSourceTypeRootAttack =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    crossSourceTypeRootAttack.parserSidecars.declarationProducerSourceIds[
        alphaDeclaration] = 0
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                crossSourceTypeRootAttack, sidecars, csg, err) &&
           crossSourceTypeRootAttack.types.typeCids.len == 0,
           "compiler snapshot builder smoke: cross-source Type root survived")

    var producerAttackSidecars: parser_receipt.ParserCanonicalSourceSidecar[]
    for sourceIndex in 0..<sidecars.len:
        add(producerAttackSidecars,
            parser_receipt.ParserCanonicalSourceSidecarClone(
                sidecars[sourceIndex]))
    var producerAttackSidecar = producerAttackSidecars[0]
    producerAttackSidecar.typeSyntaxProducerSourceIds[0] = 1
    producerAttackSidecars[0] = producerAttackSidecar
    var producerAttack =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                producerAttack, producerAttackSidecars, csg, err) &&
           producerAttack.types.typeCids.len == 0 &&
           producerAttack.symbols.typeIds[
               producerAttack.functions.symbolIds[0]] == -1,
           "compiler snapshot builder smoke: producer TypeSyntax drift survived")

    var ownerAttackSidecars: parser_receipt.ParserCanonicalSourceSidecar[]
    for sourceIndex in 0..<sidecars.len:
        add(ownerAttackSidecars,
            parser_receipt.ParserCanonicalSourceSidecarClone(
                sidecars[sourceIndex]))
    var ownerAttackSidecar = ownerAttackSidecars[0]
    var ownerAttacked = false
    for typeRow in 0..<ownerAttackSidecar.typeSyntaxKinds.len:
        let rootKind = ownerAttackSidecar.typeSyntaxRootKinds[typeRow]
        if !ownerAttacked &&
           (rootKind ==
                Int32(parser.ParserTypeSyntaxRootFunctionParameter) ||
            rootKind == Int32(parser.ParserTypeSyntaxRootFunctionReturn)):
            ownerAttackSidecar.typeSyntaxDeclarationOwnerTokenIds[
                typeRow] = 0
            ownerAttacked = true
    ownerAttackSidecars[0] = ownerAttackSidecar
    assert(ownerAttacked,
           "compiler snapshot builder smoke: function type root fixture missing")
    var ownerAttack = schema.CsgCompilerSnapshotTablesClone(projectedBase)
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                ownerAttack, ownerAttackSidecars, csg, err) &&
           ownerAttack.types.typeCids.len == 0,
           "compiler snapshot builder smoke: function owner-token drift survived")

    var typeCidAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    var badTypeCid = typeCidAttack.types.typeCids[0]
    badTypeCid.data[0] = uint8(Int32(badTypeCid.data[0]) ^ 1)
    typeCidAttack.types.typeCids[0] = badTypeCid
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                typeCidAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: type CID tamper survived")
    var symbolTypeAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    symbolTypeAttack.symbols.typeIds[functionSymbol0] =
        tables.symbols.typeIds[functionSymbol1]
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                symbolTypeAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: symbol signature TypeId swap survived")
    var declarationProofAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    let attackedDeclId =
        declarationProofAttack.symbols.declIds[functionSymbol0]
    declarationProofAttack.declarations.parserValidatedNameProofCids[
        attackedDeclId].data[0] = uint8(Int32(
            declarationProofAttack.declarations.parserValidatedNameProofCids[
                attackedDeclId].data[0]) ^ 1)
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                declarationProofAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: declaration name proof tamper survived")
    var declarationTableCidAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    declarationTableCidAttack.declarations.tableCid.data[0] = uint8(Int32(
        declarationTableCidAttack.declarations.tableCid.data[0]) ^ 1)
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                declarationTableCidAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: declaration table CID tamper survived")
    var declarationIdAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    declarationIdAttack.symbols.declIds[functionSymbol0] =
        declarationIdAttack.symbols.declIds[functionSymbol1]
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                declarationIdAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: symbol DeclId tamper survived")
    var declarationOwnerAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    declarationOwnerAttack.declarations.ownerDeclIds[attackedDeclId] = -1
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                declarationOwnerAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: declaration owner tamper survived")
    var declarationSignatureAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    declarationSignatureAttack.declarations.portableSignatureTypeExpressionCids[
        attackedDeclId] =
        tables.types.typeCids[tables.symbols.typeIds[functionSymbol1]]
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                declarationSignatureAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: declaration TypeCid tamper survived")
    let typeSymbol0 = SnapshotBuilderSmokeTypeSymbolForSourceName(
        tables, 1, "Alpha")
    let typeSymbol1 = SnapshotBuilderSmokeTypeSymbolForSourceName(
        tables, 0, "Beta")
    let moduleSymbol1 = SnapshotBuilderSmokeSymbolForSourceKind(
        tables, 0, schema.CsgCompilerSymbolModule)
    var missingTypeSymbolAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    missingTypeSymbolAttack.symbols.symbolKinds[typeSymbol0] =
        schema.CsgCompilerSymbolFunction
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                missingTypeSymbolAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: missing Type Symbol survived")
    var wrongTypeOwnerAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    wrongTypeOwnerAttack.symbols.ownerSymbolIds[typeSymbol0] =
        moduleSymbol1
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                wrongTypeOwnerAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: wrong Type Module owner survived")
    var wrongTypeIdAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    wrongTypeIdAttack.symbols.typeIds[typeSymbol0] =
        tables.symbols.typeIds[typeSymbol1]
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                wrongTypeIdAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: wrong TypeArena TypeId survived")
    var crossSourceTypeCoordinateAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    crossSourceTypeCoordinateAttack.symbols.sourceIds[typeSymbol0] = 0
    assert(!builder.CompilerSnapshotTypeFunctionSignatureProjectionStrictValidateInto(
                crossSourceTypeCoordinateAttack, sidecars, csg, err),
           "compiler snapshot builder smoke: cross-source Type coordinate survived")
    let publishedTypeCount = tables.types.typeCids.len
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectInto(
                tables, sidecars, csg, err) &&
           tables.types.typeCids.len == publishedTypeCount,
           "compiler snapshot builder smoke: non-empty type destination mutated")
    echo("compiler_snapshot_builder_type_signature_projection=1")
    echo("compiler_snapshot_builder_type_arena_bridge=1")
    echo("compiler_snapshot_builder_type_signature_tamper_rejected=1")
    echo("compiler_snapshot_builder_declaration_authority=1")
    echo("compiler_snapshot_builder_int32_str_overload=1")
    echo("compiler_snapshot_builder_type_symbol_projection=1")
    echo("compiler_snapshot_builder_type_symbol_attacks_rejected=1")
    echo("compiler_snapshot_builder_type_root_join_attacks_rejected=1")
    echo("compiler_snapshot_builder_generic_parameter_projection_owned_by_type_only_gate=1")

fn SnapshotBuilderSmokeBlockedTypeProjectionAssert(
        projectedBase: var schema.CsgCompilerSnapshotTables,
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        csg: var compiler_csg.CompilerCsg,
        expectedStage: int32) =
    var tables = schema.CsgCompilerSnapshotTablesClone(projectedBase)
    var receipt: builder.CompilerSnapshotTypeProjectionReceipt
    var err: str
    var rejected = true
    if builder.CompilerSnapshotTypeFunctionSignatureTablesProjectWithReceiptInto(
           tables, sidecars, csg, receipt, err):
        rejected = false
    var symbolsUntouched =
        tables.symbols.symbolCids.len ==
            projectedBase.symbols.symbolCids.len
    if symbolsUntouched:
        for symbolId in 0..<tables.symbols.symbolCids.len:
            if tables.symbols.typeIds[symbolId] != -1 ||
               !layout.FixedBytes32Equal(
                   tables.symbols.interfaceCids[symbolId],
                   projectedBase.symbols.interfaceCids[symbolId]):
                symbolsUntouched = false
    assert(rejected &&
           receipt.admissionBlocked &&
           receipt.firstMissingStage == expectedStage &&
           !layout.FixedBytes32Equal(
               receipt.receiptCid, layout.FixedBytes32()) &&
           tables.types.typeCids.len == 0 &&
           symbolsUntouched &&
           tables.texts.len == projectedBase.texts.len &&
           layout.FixedBytes32Equal(
               tables.readSet.reverseIndexCid,
               projectedBase.readSet.reverseIndexCid),
           Fmt"compiler snapshot builder smoke: missing-stage receipt mismatch stage={expectedStage} err={err}")
    assert(builder.CompilerSnapshotTypeProjectionReceiptStrictValidateInto(
               tables, sidecars, csg, receipt, err),
           Fmt"compiler snapshot builder smoke: missing-stage receipt invalid {err}")
    if expectedStage ==
           builder.CompilerSnapshotTypeProjectionStageTypeArenaProducer:
        assert(receipt.missingTypeArenaProducerCount == 1,
               "compiler snapshot builder smoke: missing producer count drift")
    elif expectedStage ==
             builder.CompilerSnapshotTypeProjectionStageTargetScalarWidth:
        assert(receipt.missingTargetScalarWidthCount > 0,
               "compiler snapshot builder smoke: missing scalar width count drift")
    elif expectedStage ==
             builder.CompilerSnapshotTypeProjectionStageSchemaKind:
        assert(receipt.missingSchemaKindCount > 0,
               "compiler snapshot builder smoke: missing schema kind count drift")
    elif expectedStage ==
             builder.CompilerSnapshotTypeProjectionStageDeclarationIdentity:
        assert(receipt.missingDeclarationIdentityCount > 0 &&
               receipt.missingDeclarationLayoutCount > 0,
               "compiler snapshot builder smoke: missing nominal authority count drift")
    else:
        assert(false,
               "compiler snapshot builder smoke: unknown missing-stage fixture")
    var tampered = receipt
    if tampered.firstMissingStage ==
           builder.CompilerSnapshotTypeProjectionStageTypeArenaProducer:
        tampered.firstMissingStage =
            builder.CompilerSnapshotTypeProjectionStageSchemaKind
    else:
        tampered.firstMissingStage =
            builder.CompilerSnapshotTypeProjectionStageTypeArenaProducer
    assert(!builder.CompilerSnapshotTypeProjectionReceiptStrictValidateInto(
                tables, sidecars, csg, tampered, err),
           "compiler snapshot builder smoke: missing-stage receipt tamper survived")

fn SnapshotBuilderSmokeTypeProjectionMissingStageMatrix(
        projectedBase: var schema.CsgCompilerSnapshotTables,
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[]) =
    var blockedCsg: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(0, blockedCsg)
    let validSourceBundleCid = blockedCsg.sourceBundleCid
    blockedCsg.sourceBundleCid = layout.FixedBytes32()
    var graphCorruptTables =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    var graphCorruptReceipt: builder.CompilerSnapshotTypeProjectionReceipt
    var graphCorruptErr: str
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectWithReceiptInto(
                graphCorruptTables, sidecars, blockedCsg,
                graphCorruptReceipt, graphCorruptErr) &&
           layout.FixedBytes32Equal(
               graphCorruptReceipt.receiptCid,
               layout.FixedBytes32()) &&
           graphCorruptTables.types.typeCids.len == 0,
           "compiler snapshot builder smoke: corrupt graph returned type receipt")
    blockedCsg.sourceBundleCid = validSourceBundleCid
    let validArenaCid = blockedCsg.typeArena.artifactRaw32
    blockedCsg.typeArena.artifactRaw32 = layout.FixedBytes32()
    var corruptTables =
        schema.CsgCompilerSnapshotTablesClone(projectedBase)
    var corruptReceipt: builder.CompilerSnapshotTypeProjectionReceipt
    var corruptErr: str
    assert(!builder.CompilerSnapshotTypeFunctionSignatureTablesProjectWithReceiptInto(
                corruptTables, sidecars, blockedCsg,
                corruptReceipt, corruptErr) &&
           layout.FixedBytes32Equal(
               corruptReceipt.receiptCid, layout.FixedBytes32()) &&
           corruptTables.types.typeCids.len == 0,
           "compiler snapshot builder smoke: corrupt TypeArena returned missing receipt")
    blockedCsg.typeArena.artifactRaw32 = validArenaCid
    typearena.TypedExprTypeArenaRelease(blockedCsg.typeArena)
    blockedCsg.typeArena = nil
    SnapshotBuilderSmokeBlockedTypeProjectionAssert(
        projectedBase, sidecars, blockedCsg,
        builder.CompilerSnapshotTypeProjectionStageTypeArenaProducer)

    SnapshotBuilderSmokeTypeArenaFromSources(
        "fn same(borrowed: var int, plain: int): int =\n    return 1\n",
        SnapshotBuilderSmokeSource(1),
        blockedCsg.typeArena)
    SnapshotBuilderSmokeBlockedTypeProjectionAssert(
        projectedBase, sidecars, blockedCsg,
        builder.CompilerSnapshotTypeProjectionStageTargetScalarWidth)

    typearena.TypedExprTypeArenaRelease(blockedCsg.typeArena)
    SnapshotBuilderSmokeTypeArenaFromSources(
        "fn same(borrowed: var uint, plain: uint): uint =\n    return 1\n",
        SnapshotBuilderSmokeSource(1),
        blockedCsg.typeArena)
    SnapshotBuilderSmokeBlockedTypeProjectionAssert(
        projectedBase, sidecars, blockedCsg,
        builder.CompilerSnapshotTypeProjectionStageTargetScalarWidth)

    typearena.TypedExprTypeArenaRelease(blockedCsg.typeArena)
    SnapshotBuilderSmokeTypeArenaFromSources(
        "fn same(borrowed: ref int32, plain: int32): int32 =\n    return 1\n",
        SnapshotBuilderSmokeSource(1),
        blockedCsg.typeArena)
    SnapshotBuilderSmokeBlockedTypeProjectionAssert(
        projectedBase, sidecars, blockedCsg,
        builder.CompilerSnapshotTypeProjectionStageSchemaKind)

    typearena.TypedExprTypeArenaRelease(blockedCsg.typeArena)
    SnapshotBuilderSmokeTypeArenaFromSources(
        "fn same(borrowed: fn(arg: int32): bool, plain: int32): int32 =\n    return 1\n",
        SnapshotBuilderSmokeSource(1),
        blockedCsg.typeArena)
    SnapshotBuilderSmokeBlockedTypeProjectionAssert(
        projectedBase, sidecars, blockedCsg,
        builder.CompilerSnapshotTypeProjectionStageSchemaKind)

    typearena.TypedExprTypeArenaRelease(blockedCsg.typeArena)
    SnapshotBuilderSmokeTypeArenaFromSources(
        "type Box =\n    value: int32\n\nfn same(borrowed: Box, plain: int32): int32 =\n    return 1\n",
        SnapshotBuilderSmokeSource(1),
        blockedCsg.typeArena)
    SnapshotBuilderSmokeBlockedTypeProjectionAssert(
        projectedBase, sidecars, blockedCsg,
        builder.CompilerSnapshotTypeProjectionStageDeclarationIdentity)

    SnapshotBuilderSmokeGraphRelease(blockedCsg)
    echo("compiler_snapshot_builder_type_missing_stage_matrix=1")

# `predecessor` is the only by-value parameter here and is read-only: it is
# forwarded as a CID, never rebound, stored or released.  Borrowing it lets
# main() feed the same value to every stage without a move.
@borrows
fn SnapshotBuilderSmokeGraphProjection(
        tables: var schema.CsgCompilerSnapshotTables,
        sidecars: var parser_receipt.ParserCanonicalSourceSidecar[],
        sourceRows: var builder.CompilerSnapshotCanonicalSourceRow[],
        completeTexts: var str[],
        completeSpans: var builder.CompilerSnapshotCanonicalSpanInput[],
        predecessor: layout.FixedBytes32) =
    var csg: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(0, csg)
    var admission: builder.CompilerSnapshotProductionAdmissionReceipt
    var admissionErr: str
    assert(!builder.CompilerSnapshotProductionAdmissionAssessInto(
                csg, int64(1), admission, admissionErr) &&
           layout.FixedBytes32Equal(
               admission.receiptCid, layout.FixedBytes32()),
           "compiler snapshot builder smoke: fixture parser envelope entered production admission")
    # Passed to `current: var ...` formals below, so it must be a mutable
    # place: `var` is a mutable borrow and cannot bind an immutable `let`.
    var prebuildFacts = SnapshotBuilderSmokePrebuildFacts(tables, csg)
    var previous: schema.CsgCompilerSnapshotTables
    var plan: incremental.SemanticSnapshotIncrementalPrebuildPlan
    var setupErr: str
    assert(SnapshotBuilderSmokePreviousPlanInto(
               prebuildFacts, previous, plan, setupErr), setupErr)
    var productionReads: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(builder.CompilerSnapshotIncrementalRebuildReadsProduceInto(
               tables, csg, prebuildFacts, plan, productionReads,
               setupErr),
           Fmt"compiler snapshot builder smoke: producer failed {setupErr}")
    assert(incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
               prebuildFacts, plan, productionReads, setupErr),
           Fmt"compiler snapshot builder smoke: producer replay failed {setupErr}")
    assert(productionReads.functionIds.len ==
               plan.rebuildFunctionIds.len &&
           productionReads.invocationReceiptCids.len ==
               plan.rebuildFunctionIds.len &&
           productionReads.producerFactKinds.len == 1 &&
           productionReads.producerFactKinds[0] ==
               incremental.SemanticSnapshotIncrementalProducerFactResolvedCall &&
           productionReads.producerFactRowIds[0] == 0 &&
           productionReads.producerSourceIds[0] ==
               csg.semanticGraph.resolvedCallTable.sourceIndexes[0] &&
           productionReads.producerCanonicalSourceIds[0] ==
               prebuildFacts.functionSourceIds[
                   productionReads.producerFactFunctionIds[0]] &&
           productionReads.producerOriginNodeIds[0] ==
               csg.semanticGraph.resolvedCallTable.originParserNodeIds[0] &&
           !layout.FixedBytes32Equal(
               productionReads.producerReceiptCid,
               layout.FixedBytes32()),
           "compiler snapshot builder smoke: resolved-call producer receipt mismatch")
    var producerDomainAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(builder.CompilerSnapshotIncrementalRebuildReadsProduceInto(
               tables, csg, prebuildFacts, plan,
               producerDomainAttack, setupErr), setupErr)
    producerDomainAttack.producerCanonicalSourceIds[0] =
        (producerDomainAttack.producerCanonicalSourceIds[0] + 1) %
            prebuildFacts.documentCids.len
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
                prebuildFacts, plan, producerDomainAttack, setupErr),
           "compiler snapshot builder smoke: producer canonical source tamper survived")
    var producerRawSourceAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(builder.CompilerSnapshotIncrementalRebuildReadsProduceInto(
               tables, csg, prebuildFacts, plan,
               producerRawSourceAttack, setupErr), setupErr)
    producerRawSourceAttack.producerSourceIds[0] =
        (producerRawSourceAttack.producerSourceIds[0] + 1) %
            prebuildFacts.documentCids.len
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
                prebuildFacts, plan, producerRawSourceAttack, setupErr),
           "compiler snapshot builder smoke: producer raw source tamper survived")
    var producerOriginAttack: incremental.SemanticSnapshotIncrementalRebuildReadInput
    assert(builder.CompilerSnapshotIncrementalRebuildReadsProduceInto(
               tables, csg, prebuildFacts, plan,
               producerOriginAttack, setupErr), setupErr)
    producerOriginAttack.producerOriginNodeIds[0] =
        producerOriginAttack.producerOriginNodeIds[0] + 1
    assert(!incremental.SemanticSnapshotIncrementalRebuildReadProducerStrictValidateInto(
                prebuildFacts, plan, producerOriginAttack, setupErr),
           "compiler snapshot builder smoke: producer origin tamper survived")
    echo("compiler_snapshot_builder_resolved_call_read_receipt=1")
    var finalizedReads: incremental.SemanticSnapshotIncrementalFinalizedReadSet
    assert(incremental.SemanticSnapshotIncrementalFinalizedReadSetBuildInto(
               previous, prebuildFacts, plan, productionReads,
               finalizedReads, setupErr), setupErr)
    echo("compiler_snapshot_builder_readonly_plan_reuse=1")
    let producerFunctionId = finalizedReads.readSet.readerFunctionIds[0]
    var partitionErr: str
    var duplicateProducerPrevious: schema.CsgCompilerSnapshotTables
    var duplicateProducerPlan: incremental.SemanticSnapshotIncrementalPrebuildPlan
    assert(SnapshotBuilderSmokePreviousPlanInto(
               prebuildFacts,
               duplicateProducerPrevious,
               duplicateProducerPlan,
               partitionErr), partitionErr)
    duplicateProducerPlan.rebuildFunctionIds = [producerFunctionId,
                                                 producerFunctionId]
    assert(!builder.CompilerSnapshotIncrementalRebuildReadsProduceInto(
                tables, csg, prebuildFacts, duplicateProducerPlan,
                productionReads, partitionErr),
           "compiler snapshot builder smoke: duplicate producer partition accepted")
    var preProjection = schema.CsgCompilerSnapshotTablesClone(tables)
    var attackBase = schema.CsgCompilerSnapshotTablesClone(tables)
    var receipt: builder.CompilerSnapshotGraphProjectionReceipt
    var err: str
    var dirtyReferenceOwnerDestination =
        schema.CsgCompilerSnapshotTablesClone(attackBase)
    add(dirtyReferenceOwnerDestination.references.ownerSymbolIds, 0)
    var dirtyReferenceOwnerReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
                dirtyReferenceOwnerDestination, csg, previous,
                prebuildFacts, plan,
                dirtyReferenceOwnerReceipt, err) &&
           dirtyReferenceOwnerDestination.symbols.symbolCids.len == 0,
           "compiler snapshot builder smoke: dirty reference owner destination accepted")
    echo("compiler_snapshot_builder_reference_owner_destination_rejected=1")
    assert(builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               tables, csg, previous, prebuildFacts, plan, receipt, err),
           Fmt"compiler snapshot builder smoke: exact projection failed {err}")
    assert(receipt.admissionBlocked &&
           receipt.symbolCandidateCount == 2 &&
           receipt.reachableFunctionCount == 2 &&
           receipt.typedIrFunctionCount == 2 &&
           receipt.resolvedCallCount == 1 &&
           receipt.projectedSymbolCount == 4 &&
           receipt.projectedFunctionCount == 2 &&
           receipt.projectedReferenceCount == 0 &&
           receipt.projectedCallCount == 0 &&
           receipt.projectedReadSetRowCount == 1 &&
           receipt.missingSymbolSourceBindingCount == 0 &&
           receipt.missingSymbolDeclarationSpanCount == 0 &&
           receipt.missingSymbolDeclarationHeaderCidCount == 0 &&
           receipt.missingSymbolDeclarationPathCidCount == 0 &&
           receipt.missingSymbolIdentityCidCount == 0 &&
           receipt.missingSymbolTypeCount == 2 &&
           receipt.missingSymbolInterfaceCidCount == 2 &&
           receipt.missingFunctionGraphNodeBindingCount == 0 &&
           receipt.missingFunctionTypedIrBindingCount == 0 &&
           receipt.missingFunctionBodySpanCount == 0 &&
           receipt.missingFunctionBodyContentCidCount == 0 &&
           receipt.missingFunctionFragmentCidCount == 2 &&
           receipt.missingFunctionInterfaceCidCount == 2 &&
           receipt.missingFunctionReadSetPreimageCidCount == 0 &&
           receipt.missingResolvedTargetNodeIdCount == 0 &&
           receipt.missingReferenceSpanCount == 1 &&
           receipt.missingResultTypeCount == 1 &&
           receipt.missingResultOwnershipCount == 1 &&
           receipt.missingLexicalScopeProofCount == 2 &&
           receipt.missingTypedNodeBindingCount == 0 &&
           receipt.missingTypedNodeTypeIdCount == 4 &&
           receipt.missingTypedNodeValueKindCount == 4 &&
           receipt.missingTypedNodeOwnershipProofCount == 4 &&
           receipt.missingValueSendProofCount == 4 &&
           receipt.missingValueSyncProofCount == 4 &&
           receipt.missingValueShareProofCount == 4 &&
           receipt.missingThreadBoundaryProofCount == 0,
           "compiler snapshot builder smoke: projection receipt mismatch")
    SnapshotBuilderSmokeAssertProjectedColumns(
        tables, prebuildFacts, finalizedReads)
    SnapshotBuilderSmokeTypeFunctionProjection(tables, sidecars, csg)
    SnapshotBuilderSmokeTypeProjectionMissingStageMatrix(
        tables, sidecars)
    assert(builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               tables, csg, prebuildFacts, finalizedReads, receipt, err),
           Fmt"compiler snapshot builder smoke: graph receipt invalid {err}")
    var secondReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    assert(builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               preProjection, csg, previous, prebuildFacts, plan,
               secondReceipt, err) &&
           layout.FixedBytes32Equal(
               receipt.receiptCid, secondReceipt.receiptCid),
           "compiler snapshot builder smoke: graph receipt is nondeterministic")
    var projectionDeterministic =
        preProjection.symbols.symbolCids.len ==
            tables.symbols.symbolCids.len &&
        preProjection.functions.fragmentCids.len ==
            tables.functions.fragmentCids.len
    if projectionDeterministic:
        for symbolId in 0..<tables.symbols.symbolCids.len:
            if !layout.FixedBytes32Equal(
                   preProjection.symbols.symbolCids[symbolId],
                   tables.symbols.symbolCids[symbolId]) ||
               preProjection.symbols.declarationSpanIds[symbolId] !=
                   tables.symbols.declarationSpanIds[symbolId] ||
               preProjection.symbols.ownerSymbolIds[symbolId] !=
                   tables.symbols.ownerSymbolIds[symbolId]:
                projectionDeterministic = false
        for functionId in 0..<tables.functions.symbolIds.len:
            if !layout.FixedBytes32Equal(
                   preProjection.functions.fragmentCids[functionId],
                   tables.functions.fragmentCids[functionId]) ||
               preProjection.functions.typedFunctionIndexes[functionId] !=
                   tables.functions.typedFunctionIndexes[functionId] ||
               preProjection.functions.symbolIds[functionId] !=
                   tables.functions.symbolIds[functionId]:
                projectionDeterministic = false
    assert(projectionDeterministic,
           "compiler snapshot builder smoke: semantic projection is nondeterministic")
    echo("compiler_snapshot_builder_semantic_projection=1")

    # Domain mismatch: a graph symbol without a committed TypedIR row is not
    # publishable; projection must fail closed with the exact gap ledger.
    var domainCsg: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(9, domainCsg)
    var domainTables = schema.CsgCompilerSnapshotTablesClone(attackBase)
    var domainReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               domainTables, domainCsg, previous, prebuildFacts, plan,
               domainReceipt, err) &&
           domainTables.symbols.symbolCids.len == 0 &&
           domainReceipt.admissionBlocked &&
           domainReceipt.missingFunctionTypedIrBindingCount == 1 &&
           domainReceipt.projectedSymbolCount == 0 &&
           domainReceipt.projectedFunctionCount == 0 &&
           domainReceipt.projectedReadSetRowCount == 0 &&
           domainReceipt.missingFunctionFragmentCidCount == 2 &&
           !layout.FixedBytes32Equal(
               domainReceipt.receiptCid, receipt.receiptCid),
           "compiler snapshot builder smoke: untyped graph domain survived")
    SnapshotBuilderSmokeGraphRelease(domainCsg)
    echo("compiler_snapshot_builder_semantic_domain_rejected=1")

    # Qualified names are semantic texts; removing them from the complete
    # universe must close the projection instead of guessing a name.
    var reducedTexts: str[]
    for textIndex in 0..<completeTexts.len:
        if completeTexts[textIndex] != "pkg/zeta_alpha_6::same" &&
           completeTexts[textIndex] != "pkg/alpha_beta::same":
            add(reducedTexts, share(completeTexts[textIndex]))
    var reducedTables: schema.CsgCompilerSnapshotTables
    assert(builder.CompilerSnapshotParserTablesBuildInto(
               sidecars, sourceRows, reducedTexts, completeSpans,
               predecessor, reducedTables, err),
           Fmt"compiler snapshot builder smoke: reduced build failed {err}")
    for sourceId in 0..<reducedTables.sources.documentCids.len:
        assert(sourceId < tables.sources.documentCids.len &&
               layout.FixedBytes32Equal(
                   reducedTables.sources.documentCids[sourceId],
                   tables.sources.documentCids[sourceId]),
               "compiler snapshot builder smoke: reduced source domain drift")
        reducedTables.sources.interfaceCids[sourceId] =
            tables.sources.interfaceCids[sourceId]
    # Bound to a `current: var ...` formal below, so it must be a mutable place.
    var reducedPrebuild =
        SnapshotBuilderSmokePrebuildFacts(reducedTables, csg)
    var reducedReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               reducedTables, csg, previous, reducedPrebuild, plan,
               reducedReceipt, err) &&
           reducedTables.symbols.symbolCids.len == 0,
           "compiler snapshot builder smoke: missing semantic text survived")
    SnapshotBuilderSmokeGraphRelease(csg)

    var secondCsg: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(0, secondCsg)
    # Bound to a `current: var ...` formal below, so it must be a mutable place.
    var secondPrebuild = SnapshotBuilderSmokePrebuildFacts(tables, secondCsg)
    for attackKind in 1..<4:
        var graphAttack: compiler_csg.CompilerCsg
        SnapshotBuilderSmokeGraphBuild(attackKind, graphAttack)
        var rejectedReceipt: builder.CompilerSnapshotGraphProjectionReceipt
        var attackTables = schema.CsgCompilerSnapshotTablesClone(attackBase)
        assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
                   attackTables, graphAttack, previous, secondPrebuild,
                   plan, rejectedReceipt, err) &&
               attackTables.symbols.symbolCids.len == 0 &&
               !layout.FixedBytes32Equal(
                   rejectedReceipt.receiptCid, receipt.receiptCid),
               "compiler snapshot builder smoke: node/edge attack survived")
        SnapshotBuilderSmokeGraphRelease(graphAttack)

    var graphCidAttack: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(4, graphCidAttack)
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               attackBase, graphCidAttack, secondPrebuild, finalizedReads,
               receipt, err),
           "compiler snapshot builder smoke: graph CID attack survived")
    SnapshotBuilderSmokeGraphRelease(graphCidAttack)

    var targetTextAttack: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(5, targetTextAttack)
    var targetReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    var targetTables = schema.CsgCompilerSnapshotTablesClone(attackBase)
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               targetTables, targetTextAttack, secondPrebuild, finalizedReads,
               receipt, err) &&
           !builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               targetTables, targetTextAttack, previous, secondPrebuild,
               plan, targetReceipt, err),
           "compiler snapshot builder smoke: target graph identity attack survived")
    SnapshotBuilderSmokeGraphRelease(targetTextAttack)

    var graphNodeJoinAttack: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(6, graphNodeJoinAttack)
    var graphNodeJoinReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    var graphNodeJoinTables = schema.CsgCompilerSnapshotTablesClone(attackBase)
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               graphNodeJoinTables, graphNodeJoinAttack, previous,
               secondPrebuild, plan, graphNodeJoinReceipt, err),
           "compiler snapshot builder smoke: function graph-node attack survived")
    SnapshotBuilderSmokeGraphRelease(graphNodeJoinAttack)
    var typedFunctionJoinAttack: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(8, typedFunctionJoinAttack)
    var typedFunctionJoinReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    var typedFunctionJoinTables =
        schema.CsgCompilerSnapshotTablesClone(attackBase)
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               typedFunctionJoinTables, typedFunctionJoinAttack,
               previous, secondPrebuild, plan,
               typedFunctionJoinReceipt, err),
           "compiler snapshot builder smoke: typed function graph-node attack survived")
    SnapshotBuilderSmokeGraphRelease(typedFunctionJoinAttack)
    var callGraphJoinAttack: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(7, callGraphJoinAttack)
    var callGraphJoinReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    var callGraphJoinTables = schema.CsgCompilerSnapshotTablesClone(attackBase)
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               callGraphJoinTables, callGraphJoinAttack, previous,
               secondPrebuild, plan, callGraphJoinReceipt, err),
           "compiler snapshot builder smoke: call graph-node attack survived")
    SnapshotBuilderSmokeGraphRelease(callGraphJoinAttack)
    var semanticSourceDomainAttack: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(10, semanticSourceDomainAttack)
    var semanticSourceDomainReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    var semanticSourceDomainTables =
        schema.CsgCompilerSnapshotTablesClone(attackBase)
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               semanticSourceDomainTables, semanticSourceDomainAttack,
               previous, secondPrebuild, plan,
               semanticSourceDomainReceipt, err) &&
           semanticSourceDomainTables.symbols.symbolCids.len == 0,
           "compiler snapshot builder smoke: physical/module source domain swap survived")
    SnapshotBuilderSmokeGraphRelease(semanticSourceDomainAttack)
    echo("compiler_snapshot_builder_semantic_source_domain_rejected=1")
    var missingTypeFactAttack: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(0, missingTypeFactAttack)
    arenamod.ArenaArrayInt32Set(
        missingTypeFactAttack.typedIr.arena,
        missingTypeFactAttack.typedIr.nodes2_resultTypeProofKinds,
        0,
        texpr.TypedExprSnapshotTypeProofNone)
    missingTypeFactAttack.typedIr.nodes2_resultTypeManagedFlags[0] = false
    missingTypeFactAttack.typedIr.nodes2_resultTypeSendFlags[0] = false
    missingTypeFactAttack.typedIr.nodes2_resultTypeSyncFlags[0] = false
    var missingTypeFactReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    var missingTypeFactTables =
        schema.CsgCompilerSnapshotTablesClone(attackBase)
    assert(builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               missingTypeFactTables, missingTypeFactAttack, previous,
               secondPrebuild, plan, missingTypeFactReceipt, err) &&
           missingTypeFactTables.types.typeCids.len == 0 &&
           missingTypeFactTables.typedNodes.typeIds[0] == -1 &&
           missingTypeFactReceipt.missingTypedNodeTypeIdCount == 4,
           "compiler snapshot builder smoke: coarse type proof became TypeId")
    SnapshotBuilderSmokeGraphRelease(missingTypeFactAttack)
    SnapshotBuilderSmokeGraphRelease(secondCsg)
    echo("compiler_snapshot_builder_typed_function_join=1")

    var tailCsg: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(0, tailCsg)
    var prebuildAttack =
        SnapshotBuilderSmokePrebuildFacts(attackBase, tailCsg)
    prebuildAttack.bodyContentCids[0] = SnapshotBuilderSmokeCid(99, 1)
    var prebuildAttackReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    var prebuildAttackTables =
        schema.CsgCompilerSnapshotTablesClone(attackBase)
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               prebuildAttackTables, tailCsg, previous, prebuildAttack,
               plan, prebuildAttackReceipt, err),
           "compiler snapshot builder smoke: prebuild tamper survived")
    var tailPrebuild =
        SnapshotBuilderSmokePrebuildFacts(attackBase, tailCsg)
    var parserFunctionAttack =
        schema.CsgCompilerSnapshotTablesClone(attackBase)
    parserFunctionAttack.parserSidecars.functionBodySpanIds[0] =
        parserFunctionAttack.parserSidecars.functionNameSpanIds[0]
    var parserFunctionAttackReceipt: builder.CompilerSnapshotGraphProjectionReceipt
    assert(!builder.CompilerSnapshotGraphFactsProduceAndProjectInto(
               parserFunctionAttack,
               tailCsg,
               previous,
               tailPrebuild,
               plan,
               parserFunctionAttackReceipt,
               err),
           "compiler snapshot builder smoke: parser function span attack survived")
    SnapshotBuilderSmokeGraphRelease(tailCsg)

    # Mutations of the committed projection must be killed by the same schema
    # validator and by the cargo root any consumer pins.
    var symbolSwap = schema.CsgCompilerSnapshotTablesClone(tables)
    let savedSymbolCid = symbolSwap.symbols.symbolCids[0]
    symbolSwap.symbols.symbolCids[0] = symbolSwap.symbols.symbolCids[1]
    symbolSwap.symbols.symbolCids[1] = savedSymbolCid
    assert(!schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               symbolSwap, err),
           "compiler snapshot builder smoke: symbol order mutation survived")
    var fragmentCsg: compiler_csg.CompilerCsg
    SnapshotBuilderSmokeGraphBuild(0, fragmentCsg)
    # Bound to a `current: var ...` formal below, so it must be a mutable place.
    var fragmentPrebuild =
        SnapshotBuilderSmokePrebuildFacts(attackBase, fragmentCsg)
    let attackedFunctionSymbol = tables.functions.symbolIds[0]
    let otherFunctionSymbol = tables.functions.symbolIds[1]
    var spanSwap = schema.CsgCompilerSnapshotTablesClone(tables)
    let otherParserFunctionRow =
        SnapshotBuilderSmokeExpectedParserFunctionRow(
            tables,
            1 - tables.symbols.sourceIds[attackedFunctionSymbol])
    spanSwap.symbols.declarationSpanIds[attackedFunctionSymbol] =
        tables.parserSidecars.functionDeclarationSpanIds[
            otherParserFunctionRow]
    assert(!schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               spanSwap, err),
           "compiler snapshot builder smoke: declaration span mutation survived")
    var nameTokenAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    nameTokenAttack.symbols.nameTokenIds[attackedFunctionSymbol] =
        nameTokenAttack.symbols.nameTokenIds[otherFunctionSymbol]
    assert(!schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               nameTokenAttack, err),
           "compiler snapshot builder smoke: name TokenId mutation survived")
    var ownerAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    ownerAttack.symbols.ownerSymbolIds[attackedFunctionSymbol] = -1
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               ownerAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: removed Function owner survived")
    var ownerRemapAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    ownerRemapAttack.symbols.ownerSymbolIds[attackedFunctionSymbol] =
        SnapshotBuilderSmokeSymbolForSourceKind(
            tables,
            1 - tables.symbols.sourceIds[attackedFunctionSymbol],
            schema.CsgCompilerSymbolModule)
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               ownerRemapAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: cross-module Function owner survived")
    let attackedModuleSymbol = SnapshotBuilderSmokeSymbolForSourceKind(
        tables,
        tables.symbols.sourceIds[attackedFunctionSymbol],
        schema.CsgCompilerSymbolModule)
    var moduleOwnerAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    moduleOwnerAttack.symbols.ownerSymbolIds[attackedModuleSymbol] =
        attackedFunctionSymbol
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               moduleOwnerAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: Module owner survived")
    var readAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    readAttack.readSet.observedValueCids[0] =
        SnapshotBuilderSmokeCid(88, 1)
    assert(!schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               readAttack, err),
           "compiler snapshot builder smoke: read-set mutation survived")
    var reverseReadAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    reverseReadAttack.readSet.reverseReaderFunctionIds[0] =
        1 - reverseReadAttack.readSet.reverseReaderFunctionIds[0]
    assert(!schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               reverseReadAttack, err),
           "compiler snapshot builder smoke: reverse read-set mutation survived")
    var interfaceAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    interfaceAttack.functions.interfaceCids[0] =
        interfaceAttack.functions.interfaceCids[1]
    assert(!schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               interfaceAttack, err),
           "compiler snapshot builder smoke: interface binding mutation survived")
    var fragmentAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    fragmentAttack.functions.fragmentCids[0].data[0] = uint8(
        Int32(fragmentAttack.functions.fragmentCids[0].data[0]) ^ 1)
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               fragmentAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: fragment CID mutation survived producer binding")
    var typedProducerAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    let savedTypedProducer =
        typedProducerAttack.typedNodes.typedIrNodeIndexes[0]
    typedProducerAttack.typedNodes.typedIrNodeIndexes[0] =
        typedProducerAttack.typedNodes.typedIrNodeIndexes[1]
    typedProducerAttack.typedNodes.typedIrNodeIndexes[1] = savedTypedProducer
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               typedProducerAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: typed producer identity attack survived")
    var typedOriginAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    let wrongSource = 1 - typedOriginAttack.symbols.sourceIds[
        typedOriginAttack.functions.symbolIds[0]]
    typedOriginAttack.typedNodes.originParserNodeIds[0] =
        SnapshotBuilderSmokeExpectedParserNode(tables, wrongSource, 0)
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               typedOriginAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: typed parser-origin attack survived")
    var syntheticSpanAttack =
        schema.CsgCompilerSnapshotTablesClone(tables)
    syntheticSpanAttack.typedNodes.spanIds[1] =
        syntheticSpanAttack.functions.bodySpanIds[0]
    syntheticSpanAttack.debugOps.spanIds[1] =
        syntheticSpanAttack.functions.bodySpanIds[0]
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               syntheticSpanAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: synthetic body-span fallback survived")
    var typeProofAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    typeProofAttack.typedNodes.typeIds[0] = 0
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               typeProofAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: typed type-proof attack survived")
    var debugOpAttack = schema.CsgCompilerSnapshotTablesClone(tables)
    debugOpAttack.debugOps.opKinds[0] =
        debugOpAttack.debugOps.opKinds[0] + 1
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               debugOpAttack, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: debug-op producer attack survived")
    var readProjectionDrift =
        schema.CsgCompilerSnapshotTablesClone(tables)
    let driftFunctionId = readProjectionDrift.readSet.readerFunctionIds[0]
    let currentTargetCid =
        readProjectionDrift.readSet.targetPortableKeyCids[0]
    var driftTargetId = readProjectionDrift.functions.symbolIds[0]
    if layout.FixedBytes32Equal(
           currentTargetCid,
           readProjectionDrift.symbols.symbolCids[
               readProjectionDrift.functions.symbolIds[0]]):
        driftTargetId = readProjectionDrift.functions.symbolIds[1]
    readProjectionDrift.readSet.targetPortableKeyCids[0] =
        readProjectionDrift.symbols.symbolCids[driftTargetId]
    readProjectionDrift.readSet.observedValueCids[0] =
        readProjectionDrift.symbols.interfaceCids[driftTargetId]
    var driftPreimage: layout.FixedBytes32
    assert(schema.CsgCompilerReadSetPreimageCidInto(
               readProjectionDrift.symbols.symbolCids[
                   readProjectionDrift.functions.symbolIds[driftFunctionId]],
               readProjectionDrift.readSet.targetDomainKinds,
               readProjectionDrift.readSet.targetPortableKeyCids,
               readProjectionDrift.readSet.observedValueCids,
               readProjectionDrift.functions.readStarts[driftFunctionId],
               readProjectionDrift.functions.readCounts[driftFunctionId],
               driftPreimage, err), err)
    readProjectionDrift.functions.readSetPreimageCids[driftFunctionId] =
        driftPreimage
    assert(schema.CsgCompilerReadSetReverseBuildInto(
               readProjectionDrift, err), err)
    assert(schema.CsgCompilerSnapshotSymbolFunctionProjectionTablesStrictValidateInto(
               readProjectionDrift, err), err)
    assert(!builder.CompilerSnapshotGraphProjectionReceiptStrictValidateInto(
               readProjectionDrift, fragmentCsg, fragmentPrebuild,
               finalizedReads, receipt, err),
           "compiler snapshot builder smoke: valid alternate read projection survived finalized binding")
    SnapshotBuilderSmokeGraphRelease(fragmentCsg)
    echo("compiler_snapshot_builder_semantic_tamper_rejected=1")
    echo("compiler_snapshot_builder_prebuild_join=1")
    echo("compiler_snapshot_builder_parser_function_join=1")
    echo("compiler_snapshot_builder_graph_missing_proof=1")
    echo("compiler_snapshot_builder_graph_tamper_rejected=1")

fn main() =
    var sidecars: parser_receipt.ParserCanonicalSourceSidecar[]
    var sourceRows: builder.CompilerSnapshotCanonicalSourceRow[]
    var completeTexts: str[]
    var completeSpans: builder.CompilerSnapshotCanonicalSpanInput[]
    SnapshotBuilderSmokeInputs(
        sidecars, sourceRows, completeTexts, completeSpans)
    let predecessor = SnapshotBuilderSmokeCid(21, 1)
    var tables = SnapshotBuilderSmokeBuild(
        sidecars, sourceRows, completeTexts, completeSpans, predecessor)
    SnapshotBuilderSmokeDeterminism(
        tables, sidecars, sourceRows, completeTexts, completeSpans, predecessor)
    SnapshotBuilderSmokeTamper(
        tables, sidecars, sourceRows, completeTexts, completeSpans, predecessor)
    SnapshotBuilderSmokeExactCallGraphProjection()
    tables.sources.interfaceCids[0] = SnapshotBuilderSmokeCid(11, 1)
    tables.sources.interfaceCids[1] = SnapshotBuilderSmokeCid(12, 1)
    SnapshotBuilderSmokeGraphProjection(
        tables, sidecars, sourceRows, completeTexts, completeSpans,
        predecessor)
    echo(Fmt"compiler_snapshot_builder_source_count={tables.sources.documentCids.len}")
    echo(Fmt"compiler_snapshot_builder_span_count={tables.spans.sourceIds.len}")
    echo(Fmt"compiler_snapshot_builder_node_count={tables.parserNodes.sourceIds.len}")
    echo(Fmt"compiler_snapshot_builder_token_count={tables.tokens.sourceIds.len}")
    echo("compiler_snapshot_builder_smoke: ok")
