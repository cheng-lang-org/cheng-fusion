# libp2p P3-prep 门禁: 签名 channel-head 本地原语闭环 (正典 §11.6 P3-prep)。
# exe run 非 census: 断言失败即 abort 非零, 末行 "ok" 才打印。照 cas_source_codec 模式。
#
# 结构层 (非 crypto, 现即生产可用, LIVE):
#   正向 = 构 head e1 → encode → decode 字段逐一等 + re-encode 字节精确 + channelId 绑 pubkey;
#          e2 (prev 链 e1.headCid + epoch 前进) 同; TOFU 首见 admit(e1) → admit(e2>e1) 前进。
#   负1(半) 伪造 channelId: channelId=sha256(pubA) 但 signerPubKey=pubB → decode binding 拒。
#   负2 回滚: TOFU admit(e2) 后 admit(e1) / admit(e2 相等) → Err (严格单调)。
#   负4 TOFU 换钥: 同 channelId 换 signer → Err (不覆盖)。
#
# 密码层 (真 ed25519 forgery-rejection, DEFAULT-ON LIVE):
#   正向 verify-true / 负1 验签半 (keyB 签冒充 keyA) / 负3 篡改 headCid → verify 拒。
#   —— ed25519 冷退化 (i32→i64 形参符号扩展, Bug D-1) 已修并回灌 stage3, verify 不再收伪造;
#      密码层默认执行, 断言失败即 abort 非零 (与结构层同处理, 无 gate 逃生)。

import std/system
import std/result
import std/os as os
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import std/crypto/sha512 as sha512
import std/crypto/ed25519/ref10 as ref10
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/tofu as tofu

# 合成 32B 公钥 (distinct byte 图样; 非 ed25519 派生 — 结构层只需 sha256 可辨的 distinct 字节)。
fn mkPub(seed: int32): Bytes =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed * 31 + i) & 255)
    return b

fn mkCid(seed: int32): layout.FixedBytes32 =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed * 17 + i + 3) & 255)
    let r = layout.FixedBytes32FromBytes(b)
    assert(!IsErr(r), " mkCid 32B")
    return Value(r)

fn mkSig(seed: int32): Bytes =
    var b = BytesAlloc(64)
    for i in 0..<64:
        BytesSet(b, i, (seed * 13 + i) & 255)
    return b

# 直接构记录 (结构层, 无 crypto): channelId 由 pub 自证派生, sig 为合成占位。
fn mkRecord(pub: Bytes, epoch: int64, headCid: layout.FixedBytes32, prevHeadCid: layout.FixedBytes32, sig: Bytes): head.ChannelHeadRecord =
    var rec: head.ChannelHeadRecord
    rec.channelId = head.ChannelIdForPubKey(pub)
    rec.epoch = epoch
    rec.headCid = headCid
    rec.prevHeadCid = prevHeadCid
    rec.signerPubKey = pub
    rec.sig = sig
    return rec

# 手工造真 ed25519 keypair (keyPairFromSeed conditional-let miscompile, 绕开; crypto 块专用)。
fn deriveKeypair(seedv: int32, priv: var Bytes, pub: var Bytes) =
    var seed = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(seed, i, (seedv + i) & 255)
    var digest = sha512.Sha512Digest(seed)
    BytesSet(digest, 0, BytesGet(digest, 0) & 248)
    BytesSet(digest, 31, (BytesGet(digest, 31) & 63) | 64)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, BytesSlice(digest, 0, 32))
    pub = ref10.geP3ToBytes(r)
    priv = BytesConcat(seed, pub)

# 密码层 gate: 真 sign + verify (ed25519 Bug D-1 已修, 全绿)。
fn runChannelHeadCryptoGate() =
    var privA: Bytes
    var pubA: Bytes
    deriveKeypair(7, privA, pubA)
    assert(BytesLen(privA) == 64, " gate: privA 64B")
    assert(BytesLen(pubA) == 32, " gate: pubA 32B")

    let cid = mkCid(10)
    let genesis = head.ChannelHeadGenesisPrev()
    var signRes = head.ChannelHeadSign(privA, int64(1), cid, genesis, pubA)
    assert(!IsErr(signRes), " gate: sign e1: " + Error(signRes))
    var rec = Value(signRes)

    # 正向 verify-true (真 ed25519)
    assert(head.ChannelHeadVerify(rec), " gate 正向: verify(valid) == true")

    # 负3 篡改 headCid 翻 1 字节 → verify 拒 (只有签名能抓; channelId/binding 仍合法)
    var tampered = rec
    var origCid = layout.FixedBytes32ToBytes(rec.headCid)
    var badCidBytes = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(badCidBytes, i, BytesGet(origCid, i))
    BytesSet(badCidBytes, 0, (BytesGet(badCidBytes, 0) ^ 0x01) & 255)
    var badCidRes = layout.FixedBytes32FromBytes(badCidBytes)
    assert(!IsErr(badCidRes), " gate: badCid 32B")
    tampered.headCid = Value(badCidRes)
    assert(!head.ChannelHeadVerify(tampered), " gate 负3: 篡改 headCid → verify 拒")

    # 负1 验签半: keyB 签却冒充 keyA (channelId/signerPubKey 换成 keyA, sig 由 keyB 造) → verify 拒
    var privB: Bytes
    var pubB: Bytes
    deriveKeypair(200, privB, pubB)
    var forgeSignRes = head.ChannelHeadSign(privB, int64(1), cid, genesis, pubB)
    assert(!IsErr(forgeSignRes), " gate: keyB sign")
    var forgeRec = Value(forgeSignRes)
    forgeRec.signerPubKey = pubA
    forgeRec.channelId = head.ChannelIdForPubKey(pubA)
    assert(!head.ChannelHeadVerify(forgeRec), " gate 负1: keyB 签冒充 keyA → verify 拒")

    echo(" channel_head crypto-gate PASS (真 ed25519 forgery-rejection)")

fn main(): int32 =
    let base = os.GetEnvDefault("TMPDIR", "/tmp") + "/cheng_channel_head_p3prep"
    let storeRoot = base + "/store"
    os.MkdirAll(base, 493)
    let trustPath = tofu.TofuTrustPath(storeRoot)
    if os.FileExists(trustPath):
        os.RemoveFile(trustPath)   # 确定性起点

    let pubA = mkPub(1)
    let pubB = mkPub(2)
    assert(!rawbytes.BytesEqual(pubA, pubB), " 合成 pubA != pubB (distinct)")

    # ---- 正向 e1: 构 → encode → decode 字段等 + re-encode 字节精确 + binding ----
    let cid1 = mkCid(10)
    let genesis = head.ChannelHeadGenesisPrev()
    let sig1 = mkSig(5)
    var rec1 = mkRecord(pubA, int64(1), cid1, genesis, sig1)

    var enc1Res = head.ChannelHeadEncode(rec1)
    assert(!IsErr(enc1Res), " e1 encode: " + Error(enc1Res))
    var wire1 = Value(enc1Res)
    assert(BytesLen(wire1) == 201, " e1 wire = 201B (固定长)")
    assert(BytesGet(wire1, 0) == 0x10, " e1 tag 0x10")

    var dec1Res = head.ChannelHeadDecode(wire1)
    assert(!IsErr(dec1Res), " e1 decode: " + Error(dec1Res))
    var rec1b = Value(dec1Res)
    assert(rec1b.epoch == int64(1), " e1 epoch=1")
    assert(layout.FixedBytes32Equal(rec1b.channelId, rec1.channelId), " e1 channelId 相等")
    assert(layout.FixedBytes32Equal(rec1b.headCid, cid1), " e1 headCid 相等")
    assert(layout.FixedBytes32Equal(rec1b.prevHeadCid, genesis), " e1 prev=genesis")
    assert(rawbytes.BytesEqual(rec1b.signerPubKey, pubA), " e1 pubkey 相等")
    assert(rawbytes.BytesEqual(rec1b.sig, sig1), " e1 sig 相等")
    let expectCid = head.ChannelIdForPubKey(pubA)
    assert(layout.FixedBytes32Equal(rec1b.channelId, expectCid), " e1 channelId==sha256(pubkey) 绑定")
    var re1Res = head.ChannelHeadEncode(rec1b)
    assert(!IsErr(re1Res), " e1 re-encode")
    assert(rawbytes.BytesEqual(wire1, Value(re1Res)), " e1 re-encode 字节逐字节精确")

    var adm1 = tofu.TofuAdmit(storeRoot, rec1.channelId, pubA, int64(1))
    assert(!IsErr(adm1), " TOFU 首见 admit(e1): " + Error(adm1))

    # ---- 正向 e2: prev 链 + epoch 前进 ----
    let cid2 = mkCid(20)
    let sig2 = mkSig(6)
    var rec2 = mkRecord(pubA, int64(2), cid2, rec1.headCid, sig2)
    assert(layout.FixedBytes32Equal(rec2.prevHeadCid, cid1), " e2 prev == e1.headCid (链式)")
    var enc2Res = head.ChannelHeadEncode(rec2)
    assert(!IsErr(enc2Res), " e2 encode")
    var dec2Res = head.ChannelHeadDecode(Value(enc2Res))
    assert(!IsErr(dec2Res), " e2 decode")
    var rec2b = Value(dec2Res)
    assert(rec2b.epoch == int64(2), " e2 epoch=2 > e1")

    var adm2 = tofu.TofuAdmit(storeRoot, rec2.channelId, pubA, int64(2))
    assert(!IsErr(adm2), " TOFU admit(e2) 前进: " + Error(adm2))
    var loadRes = tofu.TofuLoad(storeRoot)
    assert(!IsErr(loadRes), " TOFU load")
    let look = tofu.TofuLookup(Value(loadRes), layout.FixedBytes32Hex(rec1.channelId))
    assert(look.found, " TOFU lookup found")
    assert(look.epoch == int64(2), " TOFU 存 epoch 前进到 2")

    # ---- 负1 伪造 channelId (结构半, LIVE): channelId=sha256(pubA) 但 signerPubKey=pubB → decode 拒 ----
    var forge = mkRecord(pubA, int64(3), mkCid(30), genesis, mkSig(7))
    forge.signerPubKey = pubB   # 换钥但保留 pubA 的 channelId
    var forgeEncRes = head.ChannelHeadEncode(forge)
    assert(!IsErr(forgeEncRes), " forge encode (结构合法)")
    var forgeDecRes = head.ChannelHeadDecode(Value(forgeEncRes))
    assert(IsErr(forgeDecRes), " 负1 伪造: channelId!=sha256(signerPubKey) → decode 拒")

    # ---- 负2 回滚 (TOFU, LIVE): admit(e1<已存2) 拒; admit(e2==已存2) 也拒 (严格单调) ----
    var rollbackLo = tofu.TofuAdmit(storeRoot, rec1.channelId, pubA, int64(1))
    assert(IsErr(rollbackLo), " 负2 回滚: admit(epoch<已存) → Err")
    var rollbackEq = tofu.TofuAdmit(storeRoot, rec1.channelId, pubA, int64(2))
    assert(IsErr(rollbackEq), " 负2 回滚: admit(epoch==已存) → Err (严格单调)")

    # ---- 负4 TOFU 换钥 (LIVE): 同 channel 换 signer → Err (不覆盖) ----
    let pubC = mkPub(3)
    let channelC = head.ChannelIdForPubKey(pubC)
    var admC1 = tofu.TofuAdmit(storeRoot, channelC, pubC, int64(1))
    assert(!IsErr(admC1), " channelC 首见 admit")
    var admCswap = tofu.TofuAdmit(storeRoot, channelC, pubA, int64(2))
    assert(IsErr(admCswap), " 负4 TOFU 换钥: 同 channel 换 signer → Err")

    # ---- 编码层畸形穷举 (结构层, LIVE): 截断 / 错 tag / 尾残字节 一律 decode 硬拒 ----
    var truncated = BytesSlice(wire1, 0, 200)
    assert(BytesLen(truncated) == 200, " 截断 200B")
    assert(IsErr(head.ChannelHeadDecode(truncated)), " 畸形: 截断 200B → decode 拒 (线长非 201)")
    var trailing = BytesConcat(wire1, BytesAlloc(1))
    assert(BytesLen(trailing) == 202, " 尾残 202B")
    assert(IsErr(head.ChannelHeadDecode(trailing)), " 畸形: 尾残字节 202B → decode 拒 (线长非 201)")
    var badTag = BytesAlloc(201)
    for i in 0..<201:
        BytesSet(badTag, i, BytesGet(wire1, i))
    BytesSet(badTag, 0, 0x11)
    assert(IsErr(head.ChannelHeadDecode(badTag)), " 畸形: 错 tag 0x11 → decode 拒 (tag 不符)")
    # 隔离对照: 仅把 tag 改回 0x10 (其余 == wire1) → decode 应过, 证明只有 tag 差异触发拒绝
    BytesSet(badTag, 0, 0x10)
    var ctrlRes = head.ChannelHeadDecode(badTag)
    assert(!IsErr(ctrlRes), " 对照: tag 恢复 0x10 (其余同 wire1) → decode 过 (隔离 tag 变量)")

    # ---- 密码层 gate (真 ed25519 forgery-rejection, DEFAULT-ON LIVE; ed25519 冷退化已修 Bug D-1) ----
    runChannelHeadCryptoGate()

    echo(" channel_head_signing_smoke ok")
    return 0
