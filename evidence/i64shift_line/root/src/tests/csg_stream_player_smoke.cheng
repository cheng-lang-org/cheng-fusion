# CSG 场景流播放状态机 StreamPlayerQ 冒烟。
#
# 复用 csg_scene_stream_smoke 的 BytesBuilder 手工构造模式, 构造 4-chunk SSM1
# 夹具 (时间 ×10: [0,1000) kf / [1000,1500) / [2000,3000) / [4000,5000) kf,
# 间隙 1500..2000 与 3000..4000, 总时长 5000ms)。脚本化断言:
# Init→Play→Tick(500)×n posMs 线性推进、应取 chunk 序号随时间切换;
# SetRate(20) 推进翻倍 / SetRate(0) 定格 (暂停语义);
# Seek 落间隙中点吸附最近关键帧且 eofLatched 复位;
# EOF 三硬规则: 门闩置位→再 Tick pos 不动→Seek 回退复位可续播→二次 EOF 再判定;
# 预取窗口输出与 bufferedToMs 一致性; 错误契约显式 false。
import std/strings
import std/rawbytes
import cheng/game/assets/stream/manifest
import cheng/game/assets/stream/player

fn SpPutByte(b: var BytesBuilder, v: int32) =
    rawbytes.BytesBuilderAppendByte(b, v)

# u32 小端 4 字节。
fn SpPutU32(b: var BytesBuilder, v: int64) =
    rawbytes.BytesBuilderAppendByte(b, int32(v % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(256)) % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(65536)) % int64(256)))
    rawbytes.BytesBuilderAppendByte(b, int32((v / int64(16777216)) % int64(256)))

# i64 小端 8 字节 = 低位 u32 + 高位 u32。
fn SpPutI64(b: var BytesBuilder, v: int64) =
    var hi: int64
    hi = v / int64(4294967296)
    SpPutU32(b, v % int64(4294967296))
    SpPutU32(b, hi)

fn SpPutStr(b: var BytesBuilder, s: str) =
    for i in 0..<len(s):
        rawbytes.BytesBuilderAppendByte(b, Int32(s[i]))

# 64 字符小写 hex (数字) 内容 CID。
fn SpCid(seed: int32): str =
    var parts: str[]
    for i in 0..<64:
        add(parts, strings.IntToStr((seed + i) % 10))
    var out: str
    for k in 0..<parts.len:
        out = out + parts[k]
    return out

# 4 chunk, 时间 ×10: [0,1000) kf=1, [1000,1500) kf=0, [2000,3000) kf=0,
# [4000,5000) kf=1; 间隙 1500..2000 与 3000..4000; 总时长 5000ms。
fn SpBuildManifest(): rawbytes.Bytes =
    var b = rawbytes.BytesBuilderNew(0)
    SpPutStr(b, "SSM1")
    SpPutU32(b, int64(1))
    SpPutU32(b, int64(4))
    # chunk0: [0,1000) kf=1
    SpPutI64(b, int64(0))
    SpPutI64(b, int64(1000))
    SpPutByte(b, 1)
    SpPutU32(b, int64(64))
    SpPutStr(b, SpCid(0))
    SpPutI64(b, int64(8))
    SpPutI64(b, int64(0))
    # chunk1: [1000,1500) kf=0
    SpPutI64(b, int64(1000))
    SpPutI64(b, int64(500))
    SpPutByte(b, 0)
    SpPutU32(b, int64(64))
    SpPutStr(b, SpCid(1))
    SpPutI64(b, int64(8))
    SpPutI64(b, int64(0))
    # chunk2: [2000,3000) kf=0
    SpPutI64(b, int64(2000))
    SpPutI64(b, int64(1000))
    SpPutByte(b, 0)
    SpPutU32(b, int64(64))
    SpPutStr(b, SpCid(2))
    SpPutI64(b, int64(8))
    SpPutI64(b, int64(0))
    # chunk3: [4000,5000) kf=1
    SpPutI64(b, int64(4000))
    SpPutI64(b, int64(1000))
    SpPutByte(b, 1)
    SpPutU32(b, int64(64))
    SpPutStr(b, SpCid(3))
    SpPutI64(b, int64(8))
    SpPutI64(b, int64(0))
    # 末尾 audioTrackRef
    SpPutU32(b, int64(64))
    SpPutStr(b, SpCid(9))
    return rawbytes.BytesBuilderFinish(b)

@borrows
fn SpCheckPrefetch(got: int32[], wantCnt: int32, wantFlat: int32[],
                   wantOff: int32, label: str) =
    assert(got.len == wantCnt, Fmt"{label}: len got={got.len} want={wantCnt}")
    for k in 0..<wantCnt:
        assert(got[k] == wantFlat[wantOff + k],
            Fmt"{label}: member got={got[k]}")

fn main(): int32 =
    var bytes = SpBuildManifest()
    var m: manifest.StreamManifest
    assert(manifest.StreamManifestParse(bytes, m), "fixture manifest parses")
    rawbytes.BytesFree(bytes)
    assert(manifest.StreamManifestTotalDurationMs(m) == int64(5000),
        "fixture total duration 5000")
    echo("PASS build + parse 4-chunk fixture (total 5000ms)")

    # ---- 场景 A: Init→Play→Tick(500)×10 @1x, 窗口 1200ms。 ----
    var pa: player.StreamPlayerQ
    assert(player.PlayerInit(pa, int64(5000), int64(1200)), "init A ok")
    assert(pa.ok && !pa.playing && !pa.eofLatched, "init A flags")
    assert(pa.rateX10 == 10, "init A rate 1x")
    assert(pa.posMs == int64(0), "init A pos 0")
    assert(pa.bufferedToMs == int64(1200), "init A buffered = window")
    echo("PASS init state (pos 0, rate 1x, buffered 1200)")
    assert(player.PlayerPlay(pa), "play A ok")
    assert(pa.playing, "play A playing flag")
    echo("PASS play")

    # 每 tick 期望: pos 线性 +500; 应取 chunk 顺序态随时间切换 (间隙保持);
    # 预取 = 与 [pos, pos+1200) 相交的 chunk; 第 10 tick 到末端闩上 EOF。
    var expPos: int64[]
    var expBuf: int64[]
    var expFetch: int32[]
    var expCnt: int32[]
    var expOff: int32[]
    var expFlat: int32[]
    for i in 0..<10:
        add(expPos, int64(i + 1) * int64(500))
    add(expBuf, int64(1700))
    add(expBuf, int64(2200))
    add(expBuf, int64(2700))
    add(expBuf, int64(3200))
    add(expBuf, int64(3700))
    add(expBuf, int64(4200))
    add(expBuf, int64(4700))
    add(expBuf, int64(5000))
    add(expBuf, int64(5000))
    add(expBuf, int64(5000))
    add(expFetch, 0)
    add(expFetch, 1)
    add(expFetch, 1)
    add(expFetch, 2)
    add(expFetch, 2)
    add(expFetch, 2)
    add(expFetch, 2)
    add(expFetch, 3)
    add(expFetch, 3)
    add(expFetch, 3)
    add(expCnt, 2)
    add(expCnt, 2)
    add(expCnt, 1)
    add(expCnt, 1)
    add(expCnt, 1)
    add(expCnt, 1)
    add(expCnt, 1)
    add(expCnt, 1)
    add(expCnt, 1)
    add(expCnt, 0)
    add(expOff, 0)
    add(expOff, 2)
    add(expOff, 4)
    add(expOff, 5)
    add(expOff, 6)
    add(expOff, 7)
    add(expOff, 8)
    add(expOff, 9)
    add(expOff, 10)
    add(expOff, 11)
    add(expFlat, 0)
    add(expFlat, 1)
    add(expFlat, 1)
    add(expFlat, 2)
    add(expFlat, 2)
    add(expFlat, 2)
    add(expFlat, 2)
    add(expFlat, 3)
    add(expFlat, 3)
    add(expFlat, 3)
    add(expFlat, 3)

    var fetchA: int32
    var preA: int32[]
    for i in 0..<10:
        assert(player.PlayerTick(pa, int64(500), m, fetchA, preA),
            Fmt"tick {i} runs")
        assert(pa.posMs == expPos[i], Fmt"tick {i} pos got={pa.posMs}")
        assert(pa.bufferedToMs == expBuf[i],
            Fmt"tick {i} buffered got={pa.bufferedToMs}")
        assert(fetchA == expFetch[i], Fmt"tick {i} fetch got={fetchA}")
        SpCheckPrefetch(preA, expCnt[i], expFlat, expOff[i],
            Fmt"tick {i} prefetch")
        if i == 9:
            assert(pa.eofLatched, "tick 9 latches eof at duration")
        else:
            assert(!pa.eofLatched, Fmt"tick {i} no premature eof latch")
    echo("PASS linear ticks x10: pos linear, fetch switches 0->1->2->3")
    echo("PASS prefetch window matches bufferedToMs every tick")

    # ---- EOF 三硬规则 (协议规则 2/3)。 ----
    assert(player.PlayerTick(pa, int64(500), m, fetchA, preA),
        "tick after eof runs")
    assert(pa.posMs == int64(5000), "pos frozen by eof latch")
    assert(pa.eofLatched, "eof latch stays set")
    assert(preA.len == 0, "no prefetch past end")
    echo("PASS eof latched: further tick does not advance pos")
    assert(!player.PlayerPlay(pa), "play after eof rejected (must seek first)")
    echo("PASS play after eof rejected")
    assert(player.PlayerSetRate(pa, 20), "setRate after eof allowed")
    assert(player.PlayerTick(pa, int64(500), m, fetchA, preA),
        "tick after eof setRate runs")
    assert(pa.posMs == int64(5000), "setRate after eof does not advance")
    assert(player.PlayerSetRate(pa, 10), "restore rate 1x")
    echo("PASS setRate after eof produces no advance")
    assert(!player.PlayerSeek(pa, int64(6000)), "seek beyond duration rejected")
    assert(!player.PlayerSeek(pa, int64(-1)), "negative seek rejected")
    echo("PASS seek out-of-range rejected (clamp is host duty)")
    assert(player.PlayerSeek(pa, int64(1750)), "seek to gap midpoint ok")
    assert(pa.posMs == int64(1750), "pos corrected to seek target")
    assert(!pa.eofLatched, "eof latch reset by seek back")
    assert(pa.bufferedToMs == int64(2950), "buffered follows seek")
    echo("PASS seek into gap midpoint resets eof latch")
    assert(player.PlayerTick(pa, int64(0), m, fetchA, preA),
        "zero-dt tick runs")
    assert(fetchA == 0, Fmt"seek snap fetch got={fetchA} want=0")
    assert(pa.posMs == int64(1750), "zero-dt tick holds pos")
    assert(preA.len == 1 && preA[0] == 2, "prefetch after seek targets chunk2")
    echo("PASS seek lands nearest keyframe chunk (entry snap)")
    assert(player.PlayerPlay(pa), "play resumes after seek")
    assert(player.PlayerTick(pa, int64(500), m, fetchA, preA),
        "post-snap tick runs")
    assert(pa.posMs == int64(2250), "resume advances from seek point")
    assert(fetchA == 2, "sequential fetch after snap consumed")
    var expResume: int32[]
    add(expResume, 2)
    add(expResume, 2)
    add(expResume, 2)
    add(expResume, 3)
    add(expResume, 3)
    add(expResume, 3)
    for k in 0..<6:
        assert(player.PlayerTick(pa, int64(500), m, fetchA, preA),
            Fmt"resume tick {k} runs")
        assert(fetchA == expResume[k], Fmt"resume tick {k} fetch got={fetchA}")
    assert(pa.posMs == int64(5000), "resume reaches end")
    assert(pa.eofLatched, "second eof re-latched (self-detected)")
    echo("PASS latch reset allows resume to play and re-latch at second eof")
    assert(player.PlayerSeek(pa, int64(3500)), "seek to second gap midpoint")
    assert(!pa.eofLatched, "second seek resets latch again")
    assert(player.PlayerPlay(pa), "play after second seek")
    assert(player.PlayerTick(pa, int64(0), m, fetchA, preA),
        "second snap tick runs")
    assert(fetchA == 0, Fmt"second snap fetch got={fetchA} want=0")
    assert(pa.posMs == int64(3500), "second snap holds gap midpoint")
    echo("PASS second gap midpoint also snaps to nearest keyframe")

    # ---- 场景 B: 倍速语义。 ----
    var pb: player.StreamPlayerQ
    assert(player.PlayerInit(pb, int64(5000), int64(800)), "init B ok")
    assert(player.PlayerPlay(pb), "play B")
    assert(player.PlayerSetRate(pb, 20), "setRate 2x")
    assert(player.PlayerTick(pb, int64(500), m, fetchA, preA), "tick B1")
    assert(pb.posMs == int64(1000), "2x tick advances 1000")
    assert(player.PlayerTick(pb, int64(500), m, fetchA, preA), "tick B2")
    assert(pb.posMs == int64(2000), "2x ticks accumulate")
    assert(pb.bufferedToMs == int64(2800), "buffered follows 2x pos")
    echo("PASS setRate(20) doubles advance (500dt -> 1000pos)")
    assert(player.PlayerSetRate(pb, 0), "setRate 0 accepted")
    assert(player.PlayerTick(pb, int64(500), m, fetchA, preA), "frozen tick 1")
    assert(player.PlayerTick(pb, int64(500), m, fetchA, preA), "frozen tick 2")
    assert(pb.posMs == int64(2000), "rate 0 freezes pos (pause semantics)")
    assert(pb.playing, "rate 0 keeps playing flag, pos frozen")
    echo("PASS setRate(0) freezes pos (pause semantics)")
    assert(!player.PlayerSetRate(pb, 21), "rate > 2.0x rejected")
    assert(!player.PlayerSetRate(pb, 4), "rate < 0.5x rejected")
    assert(!player.PlayerSetRate(pb, -3), "negative rate rejected")
    assert(pb.rateX10 == 0, "rate unchanged after rejects")
    assert(player.PlayerSetRate(pb, 5), "0.5x boundary accepted")
    assert(player.PlayerSetRate(pb, 20), "2.0x boundary accepted")
    echo("PASS rate domain enforced ([5,20] plus 0 freeze, per protocol)")

    # ---- 场景 D: 预取窗口边界。 ----
    var pz: player.StreamPlayerQ
    assert(player.PlayerInit(pz, int64(5000), int64(0)), "init zero window")
    assert(pz.bufferedToMs == int64(0), "zero window buffered 0")
    assert(player.PlayerPlay(pz), "play pz")
    assert(player.PlayerTick(pz, int64(500), m, fetchA, preA), "tick pz")
    assert(pz.posMs == int64(500), "pz pos 500")
    assert(pz.bufferedToMs == pz.posMs, "zero window buffered == pos")
    assert(preA.len == 0, "zero window prefetch empty")
    echo("PASS zero buffer window: bufferedToMs=posMs, empty prefetch")
    var pf: player.StreamPlayerQ
    assert(player.PlayerInit(pf, int64(5000), int64(6000)), "init full window")
    assert(pf.bufferedToMs == int64(5000), "oversized window clamped")
    assert(player.PlayerPlay(pf), "play pf")
    assert(player.PlayerTick(pf, int64(500), m, fetchA, preA), "tick pf")
    assert(pf.bufferedToMs == int64(5000), "full window buffered at duration")
    assert(preA.len == 4, "full window prefetches all chunks")
    assert(preA[0] == 0 && preA[1] == 1 && preA[2] == 2 && preA[3] == 3,
        "full window prefetch order")
    echo("PASS oversized window clamped to duration, whole stream prefetched")

    # ---- 错误契约: 非法入参/状态显式 false, 无兜底。 ----
    var qx: player.StreamPlayerQ
    assert(!player.PlayerPlay(qx), "play on uninit rejected")
    assert(!player.PlayerPause(qx), "pause on uninit rejected")
    assert(!player.PlayerSetRate(qx, 10), "setRate on uninit rejected")
    assert(!player.PlayerSeek(qx, int64(0)), "seek on uninit rejected")
    assert(!player.PlayerTick(qx, int64(1), m, fetchA, preA),
        "tick on uninit rejected")
    assert(!player.PlayerInit(qx, int64(0), int64(10)), "zero duration rejected")
    assert(!player.PlayerInit(qx, int64(-5), int64(10)),
        "negative duration rejected")
    assert(!player.PlayerInit(qx, int64(5000), int64(-1)),
        "negative buffer window rejected")
    echo("PASS error contract: uninit player + illegal init all false")
    assert(!player.PlayerTick(pb, int64(-1), m, fetchA, preA),
        "negative dt rejected")
    assert(pb.posMs == int64(2000), "state intact after rejected tick")
    var pm: player.StreamPlayerQ
    assert(player.PlayerInit(pm, int64(4000), int64(100)),
        "init mismatched duration")
    assert(!player.PlayerTick(pm, int64(100), m, fetchA, preA),
        "manifest/player duration mismatch rejected")
    var bytes2 = SpBuildManifest()
    var trunc = rawbytes.BytesSlice(bytes2, 0, 20)
    var mbad: manifest.StreamManifest
    assert(!manifest.StreamManifestParse(trunc, mbad),
        "truncated manifest rejected")
    assert(!mbad.ok, "truncated manifest not ok")
    assert(!player.PlayerTick(pb, int64(500), mbad, fetchA, preA),
        "tick with unloaded manifest rejected")
    rawbytes.BytesFree(trunc)
    rawbytes.BytesFree(bytes2)
    echo("PASS tick rejects bad dt / duration mismatch / unloaded manifest")

    echo("csg_stream_player_smoke ALL PASS")
    return 0
