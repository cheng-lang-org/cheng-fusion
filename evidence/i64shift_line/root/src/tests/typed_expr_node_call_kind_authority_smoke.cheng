import std/cmdline
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

fn AppendIntrinsicNode(ir: var texpr.TypedExprIr,
                       nodeIndex: int32,
                       callKind: texpr.TypedExprCallKind) =
    var node: texpr.TypedExprIrNode
    node.nodeIndex = nodeIndex
    node.sourcePath = "typed_expr_node_call_kind_authority_smoke.cheng"
    node.functionName = "main"
    node.lineNumber = 1
    node.originParserNodeId = -1
    node.syntheticOriginKind =
        texpr.TypedExprSyntheticOriginRuntimeIntrinsic
    node.spanAuthorityKind = texpr.TypedExprSpanAuthorityNoSource
    node.opKind = texpr.TypedExprIrOpCallExpr
    node.resultType = "void"
    node.resultStructuralTypeId = -1
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    node.callKind = callKind
    node.callDeclarationIndex = -1
    texpr.TypedExprIrAppendNode(ir, node)

fn main() =
    let mode = cmdline.ReadFlagOrDefault("--mode", "positive")
    var ir: texpr.TypedExprIr
    ir.internPool = langintern.InternPoolNew()
    AppendIntrinsicNode(ir, 0, texpr.TypedExprCallBuiltin)
    AppendIntrinsicNode(ir, 1, texpr.TypedExprCallResultIntrinsic)
    AppendIntrinsicNode(ir, 2, texpr.TypedExprCallProjection)
    if mode == "strip-kind":
        ir.nodes2_callKinds[0] = texpr.TypedExprCallNone
    elif mode == "forge-target":
        ir.nodes2_callTargetIds[0] =
            langintern.Intern(ir.internPool, "assert")
        ir.nodes2_callTargetSourcePathIds[0] =
            langintern.Intern(ir.internPool, "forged-intrinsic-owner")
    elif mode == "noncall-kind":
        var node: texpr.TypedExprIrNode
        node.nodeIndex = 3
        node.sourcePath =
            "typed_expr_node_call_kind_authority_smoke.cheng"
        node.functionName = "main"
        node.lineNumber = 1
        node.originParserNodeId = -1
        node.syntheticOriginKind =
            texpr.TypedExprSyntheticOriginRuntimeIntrinsic
        node.spanAuthorityKind =
            texpr.TypedExprSpanAuthorityNoSource
        node.opKind = texpr.TypedExprIrOpI32Const
        node.resultType = "int32"
        node.resultStructuralTypeId = -1
        node.literalText = "0"
        node.paramSlot = -1
        node.operand0NodeIndex = -1
        node.operand1NodeIndex = -1
        node.operand2NodeIndex = -1
        node.callKind = texpr.TypedExprCallBuiltin
        node.callDeclarationIndex = -1
        texpr.TypedExprIrAppendNode(ir, node)
    elif mode != "positive":
        panic("typed expr node call kind authority: unknown mode")
    texpr.TypedExprIrValidateCallNodeAuthorityRange(ir, 0)
    if ir.nodes2_callKinds.len != 3 ||
       ir.nodes2_callKinds[0] != texpr.TypedExprCallBuiltin ||
       ir.nodes2_callKinds[1] !=
           texpr.TypedExprCallResultIntrinsic ||
       ir.nodes2_callKinds[2] != texpr.TypedExprCallProjection:
        panic("typed expr node call kind authority: projection drift")
    texpr.TypedExprIrReleasePayload(ir)
    echo("typed_expr_node_call_kind_authority_smoke ok")
