import cheng/core/csg_core/json_field as field

fn expect(cond: bool, code: int32): int32 =
    if !cond:
        return code
    return 0

fn expectFound(result: field.CsgCoreJsonFieldResult, expected: str, code: int32): int32 =
    if !result.found:
        return code
    if result.value != expected:
        return code
    return 0

fn expectMissing(result: field.CsgCoreJsonFieldResult, code: int32): int32 =
    if result.found:
        return code
    return 0

fn main(): int32 =
    let fact = "{\"kind\":\"csg.symbol\",\"id\":\"sym_1\",\"schema\":\"csg_core\",\"path\":\"main.cheng\",\"name\":\"Main\",\"code\":\"E001\",\"message\":\"ok\",\"reason\":\"unit\",\"original_text_hash\":\"sha256:abc\",\"impact_scope\":\"local\"}"
    if expectFound(field.CsgCoreJsonKind(fact), "csg.symbol", 1) != 0:
        return 1
    if expectFound(field.CsgCoreJsonId(fact), "sym_1", 2) != 0:
        return 2
    if expectFound(field.CsgCoreJsonSchema(fact), "csg_core", 3) != 0:
        return 3
    if expectFound(field.CsgCoreJsonPath(fact), "main.cheng", 4) != 0:
        return 4
    if expectFound(field.CsgCoreJsonName(fact), "Main", 5) != 0:
        return 5
    if expectFound(field.CsgCoreJsonCode(fact), "E001", 6) != 0:
        return 6
    if expectFound(field.CsgCoreJsonMessage(fact), "ok", 7) != 0:
        return 7
    if expectFound(field.CsgCoreJsonReason(fact), "unit", 8) != 0:
        return 8
    if expectFound(field.CsgCoreJsonOriginalTextHash(fact), "sha256:abc", 9) != 0:
        return 9
    if expectFound(field.CsgCoreJsonImpactScope(fact), "local", 10) != 0:
        return 10

    let missing = field.CsgCoreJsonTopStringField("{\"kind\":\"csg.module\"}", "id")
    if expectMissing(missing, 11) != 0:
        return 11

    let nonString = field.CsgCoreJsonTopStringField("{\"id\":7,\"kind\":\"csg.module\"}", "id")
    if expectMissing(nonString, 12) != 0:
        return 12

    let escaped = field.CsgCoreJsonMessage("{\"message\":\"a\\\"b\\\\c\\/d\\ne\\rf\\t\"}")
    if expectFound(escaped, "a\"b\\c/d\ne\rf\t", 13) != 0:
        return 13

    let nestedOnly = field.CsgCoreJsonId("{\"kind\":\"outer\",\"node\":{\"id\":\"nested\"}}")
    if expectMissing(nestedOnly, 14) != 0:
        return 14

    let nestedBeforeTop = field.CsgCoreJsonId("{\"node\":{\"id\":\"nested\"},\"id\":\"top\"}")
    if expectFound(nestedBeforeTop, "top", 15) != 0:
        return 15

    return expect(true, 16)
