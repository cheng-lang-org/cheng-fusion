import std/system

fn main(): int32 =
    var canonical: str
    if system.RuntimeHeldExecTerminalObservationProjectCanonicalInto(
           -1, -1, canonical):
        return 2
    var bindOwner: int32 = -1
    var permission0: int32
    var permission1: int32
    var permission2: int32
    var permission3: int32
    var observationOwner: int32 = -1
    var durableAppendOwner: int32 = -1
    var retireOwner: int32 = -1
    if system.RuntimeHeldExecTerminalObservationCommitDurableAppendInto(
           bindOwner,
           -1,
           permission0,
           permission1,
           permission2,
           permission3,
           observationOwner,
           "",
           "",
           "",
           durableAppendOwner):
        return 3
    if system.RuntimeHeldExecTerminalObservationAckInto(
           -1, observationOwner, durableAppendOwner, retireOwner):
        return 4
    if bindOwner != -1 || permission0 != 0 || permission1 != 0 ||
       permission2 != 0 || permission3 != 0 ||
       observationOwner != -1 || durableAppendOwner != -1 ||
       retireOwner != -1 ||
       canonical.len != 0:
        return 5
    return 0
