import std/os
import std/strformat
import std/strutils as strutil
import cheng/core/lang/parser

fn main(): int32 =
    let root = parser.ParserNormalizePath(os.GetCurrentDir())
    let sourceText = strutil.Join([
        "fn NotAnImport(): str = \"import cheng/core/lang/parser\"\n",
        "    # import cheng/core/lang/typed_expr\n",
        "let docs = \"\"\"\n",
        "import cheng/core/lang/typed_expr\n",
        "\"\"\"\n",
        "    import cheng/core/lang/parser as parserAlias # exact edge\n",
        "import cheng/core/[tooling/path, lang/intern]\n",
        "let tail = 1\n"
    ], "")
    var externalRoots: parser.ParserExternalPackageRoot[]
    var edges: parser.ImportEdge[]
    var err: str
    assert(parser.ParserReadImportEdgesWithExternalPackageRoots(
               root,
               root,
               externalRoots,
               "cheng/import_stream_owner",
               sourceText,
               edges,
               err),
           Fmt"parser streaming import edges failed {err}")
    assert(edges.len == 3 &&
           edges[0].ownerModulePath == "cheng/import_stream_owner" &&
           edges[0].targetModulePath == "cheng/core/lang/parser" &&
           edges[0].importAlias == "parserAlias" &&
           edges[0].resolved &&
           edges[1].targetModulePath == "cheng/core/tooling/path" &&
           edges[1].resolved &&
           edges[2].targetModulePath == "cheng/core/lang/intern" &&
           edges[2].resolved,
           "parser streaming import prefilter changed grammar")
    var normalizedSourceText = sourceText
    if parser.ParserSourceHasMultilineString(sourceText):
        assert(parser.ParserRewriteMultilineStringSourceText(
                   sourceText,
                   normalizedSourceText,
                   err),
               Fmt"parser multiline import normalization failed {err}")
    let lines = parser.ParserSplitChar(normalizedSourceText, '\n')
    var lineEdges: parser.ImportEdge[]
    assert(parser.ParserReadImportEdgesLinesWithExternalPackageRoots(
               root,
               root,
               externalRoots,
               "cheng/import_stream_owner",
               lines,
               lineEdges,
               err),
           Fmt"parser line import edges failed {err}")
    assert(lineEdges.len == edges.len,
           Fmt"parser streaming/line edge counts differ streaming={edges.len} lines={lineEdges.len}")
    for edgeIndex in 0..<edges.len:
        assert(lineEdges[edgeIndex].ownerModulePath ==
                   edges[edgeIndex].ownerModulePath &&
               lineEdges[edgeIndex].targetModulePath ==
                   edges[edgeIndex].targetModulePath &&
               lineEdges[edgeIndex].targetSourcePath ==
                   edges[edgeIndex].targetSourcePath &&
               lineEdges[edgeIndex].importAlias ==
                   edges[edgeIndex].importAlias &&
               lineEdges[edgeIndex].resolved == edges[edgeIndex].resolved,
               "parser streaming/line edge identity differs")
    var specs: parser.ParserImportSpec[]
    var lineSpecs: parser.ParserImportSpec[]
    assert(parser.ParserReadImportSpecs("cheng/import_stream_owner",
                                        sourceText,
                                        specs,
                                        err) &&
           parser.ParserReadImportSpecsLines("cheng/import_stream_owner",
                                             lines,
                                             lineSpecs,
                                             err),
           Fmt"parser streaming import specs failed {err}")
    assert(specs.len == 3 && lineSpecs.len == specs.len,
           "parser streaming import spec counts differ")
    for specIndex in 0..<specs.len:
        assert(lineSpecs[specIndex].ownerModulePath ==
                   specs[specIndex].ownerModulePath &&
               lineSpecs[specIndex].targetModulePath ==
                   specs[specIndex].targetModulePath &&
               lineSpecs[specIndex].importAlias == specs[specIndex].importAlias,
               "parser streaming/line import spec identity differs")
    echo("parser_import_edges_streaming_smoke ok")
    return 0
