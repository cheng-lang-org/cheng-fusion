import std/strutils as strutil

fn R24Join(a: str, b: str): str =
    var parts: str[]
    add(parts, a)
    add(parts, b)
    return strutil.Join(parts, "")

fn R24Payload(lineRaw: str, genericPos: int32): int32 =
    let keep = R24Join("Kx", lineRaw)
    let headRaw = R24Join("head-", lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Join("tag-", headRaw)
    else:
        head = headRaw
    return head.len * 1000 + keep[0]

fn main(): int32 =
    let a = R24Payload("abcdef", 1)
    if a != 15075:
        return 10
    let b = R24Payload("abcdef", 0)
    if b != 11075:
        return 11
    echo("r24 payload ok a=15075 b=11075")
    return 0
