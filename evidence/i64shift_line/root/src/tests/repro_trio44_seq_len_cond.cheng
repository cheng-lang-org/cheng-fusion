# repro: trio44 族 — len(seq 字段) 在 if/while 条件位的 EvalNode len 内征缺口。
# CALL 形 len(x)（非 .len FieldGet 形，后者已在前一波修好）落在 if/while
# 条件位时，node-eval len 内征只认 str/Bytes，seq 落回一个更弱的文本 fallback
# （误当 str 版 len 解析）→ 值错或 bail=44。覆盖三个位置：if 条件位、while
# 条件位、裸表达式位；含直接 seq 字段、嵌套 struct.field.seq 字段、按值传参
# （聚合槽拷贝）三种根形态。

type
    Bag =
        items: int32[]
        tag: int32

    Wrapper =
        bag: Bag
        label: int32

fn hasItems(b: var Bag): bool =
    if len(b.items) > 0:
        return true
    return false

fn countUpTo(b: var Bag): int32 =
    var n: int32
    while len(b.items) > n:
        n = n + 1
    return n

fn plainLen(b: var Bag): int32 =
    let n = len(b.items)
    return n

# 按值传参：Bag 整体拷贝进局部聚合槽（非 var 借用地址），验证「已抽取聚合
# 槽副本」场景下 len 字段偏移仍正确（复用 SeqRefForText 直读，不做二次
# 物化拷贝，故不存在偏移歧义）。
@borrows
fn plainLenByValue(b: Bag): int32 =
    if len(b.items) > 0:
        let n = len(b.items)
        return n
    return -1

# 嵌套字段路径：len(w.bag.items) 需要 SeqRefForText 的多段 dot 累加偏移。
fn nestedIf(w: var Wrapper): bool =
    if len(w.bag.items) >= 3:
        return true
    return false

fn nestedWhile(w: var Wrapper): int32 =
    var n: int32
    while len(w.bag.items) > n:
        n = n + 1
    return n

fn main(): int32 =
    var b: Bag
    b.items = []
    add(b.items, 10)
    add(b.items, 20)
    add(b.items, 30)
    b.tag = 7

    if !hasItems(b):
        return 1

    let n = countUpTo(b)
    if n != 3:
        return 2

    let p = plainLen(b)
    if p != 3:
        return 3

    let pv = plainLenByValue(b)
    if pv != 3:
        return 4

    var w: Wrapper
    w.bag = b
    w.label = 9

    if !nestedIf(w):
        return 5

    let wn = nestedWhile(w)
    if wn != 3:
        return 6

    # 边界: 空 seq 字段的 if/while 条件位不得误判非零。
    var empty: Bag
    empty.items = []
    empty.tag = 0
    if hasItems(empty):
        return 7
    let en = countUpTo(empty)
    if en != 0:
        return 8

    return 0
