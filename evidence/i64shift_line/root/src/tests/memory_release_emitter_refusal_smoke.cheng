# Proves the emitter refuses to write a receipt the gate would reject:
# a ledger row whose physical free count does not match its buffer count is a
# leak, and MemoryReleaseDriverReceiptCanonicalJson must panic instead of
# emitting.
import std/cmdline as cmdline
import cheng/core/tooling/memory_release_receipt as receipt

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let injection = cmdline.paramStr(1)
    var ledgerRows: receipt.MemoryReleaseLedgerRow[]
    var orcRows: receipt.MemoryReleaseOrcRow[]
    var components: str[]
    receipt.MemoryReleaseFillComponents("primary", components)
    for index in 0..<components.len:
        var row: receipt.MemoryReleaseLedgerRow
        row.pathKind = "success"
        row.component = components[index]
        row.entered = true
        row.receiptKind =
            receipt.MemoryReleaseComponentReceiptKind(components[index])
        row.producerOperation =
            receipt.MemoryReleaseComponentProducerOperation(components[index])
        row.allocated = int64(1)
        row.released = int64(1)
        row.live = int64(0)
        row.allocatedBytes = int64(64)
        row.releasedBytes = int64(64)
        row.liveBytes = int64(0)
        row.physicalBufferCount = int64(6)
        # One buffer was never freed: this is exactly the leak the gate exists
        # to catch, injected here on purpose.
        row.physicalFreeCount = injection == "physical_leak" ? int64(5) : int64(6)
        if injection == "ghost_component" && index == 4:
            # A component this path never entered claiming memory activity.
            row.entered = false
        row.storageReleased = true
        if components[index] != "primary":
            row.ledgerStorageReleased = true
            row.ledgerStorageReleasedSequenceCount = int64(6)
            row.ledgerStorageReleasedBufferCount = int64(6)
            row.ledgerStorageReleasedBytes = int64(784)
        add(ledgerRows, row)
    var orcRow: receipt.MemoryReleaseOrcRow
    orcRow.pathKind = "success"
    orcRow.iterations = int64(5000)
    orcRow.allocCount = int64(5000)
    orcRow.freeCount = int64(5000)
    orcRow.liveCount = injection == "orc_leak" ? int64(7) : int64(0)
    orcRow.retainCount = int64(5000)
    if injection == "orc_old_retain_equals_release":
        orcRow.releaseCount = int64(5000)
    else:
        orcRow.releaseCount = int64(10000)
    add(orcRows, orcRow)
    let document = receipt.MemoryReleaseDriverReceiptCanonicalJson(
        "x86_64-unknown-linux-gnu",
        "primary",
        "success",
        "1aea739921d49792c1eb579525370a77d0cbdc4ceb992b51a38e5386087d6dc9",
        "2dc8013d10c62158f98e442f2b2cef0620d8426fef53be60359a8e4240a59d07",
        "ba08b4f6feb18b91502ec785150214c0b48afcb85ac3af1f28e03d31b7ecb224",
        ledgerRows,
        orcRows)
    if injection == "none":
        echo(Fmt"EMITTER_ACCEPTED_ADMISSIBLE_ROWS len={document.len}")
        return 0
    echo(Fmt"EMITTER_DID_NOT_REFUSE injection={injection} len={document.len}")
    return 1
