# exact_def_derive_smoke — ExactDef 批 1 单元验证: 数据模型 + storage/sentinel +
# 规范推导器骨架。spec: docs/cheng-exact-def-rewrite-design.md §3.2/批 1。
#
# 合成 BodyIR 全部经真实构建路径构造 (coreir 构建/绑定/冻结 API +
# 推导器 + codec), 零 Mock。
#
# 模式 (argv[1], 缺省 unit):
#   unit         — 正路径全断言, 全绿输出 EXACT_DEF_DERIVE_UNIT_OK:
#                  ① 四 origin 定义臂落戳 (param/binding/callresult/temporary);
#                  ② borrow-view: destination UNKNOWN + source 已证 authority
#                     → 同值落戳;
#                  ③ local-copy: fresh 槽落 source 戳 + source 物理定义边;
#                  ④ field-borrow: 逐跳核对 (layoutChild CSR offset/width/TypeId);
#                  ⑤ sentinel: nominal UNKNOWN / 非 nominal 静态 storage 判定,
#                     fresh str 不误判;
#                  ⑥ storage 子句判词正路径 + 变异 (SEQUENCE 戳) 精确红回;
#                  ⑦ 侧车 seal/CID + backend2 BodyIR codec field19 往返恒等。
#   verdict-emit — storage 子句判词精确红: 戳值变异 SEQUENCE 后调 check,
#                  判词单行上 stderr (含 `def_storage=1 slot_storage=3`),
#                  进程 rc=2。
#
# 负例夹具来源 (批 1 固化口径): w3neg1 系源自
#   /Users/lbcheng/cheng-patches/slot-authority-20260825 (墙4 slot authority
#   mismatch 族, 2026-08-25), 原始件 readedge-freeze-20260825/receipts/
#   w3neg1_byval_borrow.cheng, 已固化进 _coldrepro/w3neg1_byval_borrow.cheng。
#   该负例的「同拒」门属批 2+ 验证器接线后执行, 本批单测覆盖同族判词的
#   精确红腿 (verdict-emit)。

import std/cmdline as cmdline
import std/result
import std/rawbytes
import std/os
import cheng/core/analysis/exact_def_derive as derive
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/ir/core_types as coreir
import cheng/core/backend2/backend2_frag_codec as fragcodec
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

const
    # 合成 TypeArena 行: 0=i32 1=str 2=seq<i32> 3=Table{offset,length}
    # 4=Face{data:seq, head:Table}。
    fixtureTypeI32 = 0
    fixtureTypeStr = 1
    fixtureTypeSeqI32 = 2
    fixtureTypeTable = 3
    fixtureTypeFace = 4
    fixtureTransportStart = 100

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

@borrows
fn smokeStrContains(text: str, sub: str): bool =
    let subLen = len(sub)
    if subLen <= 0:
        return true
    if len(text) < subLen:
        return false
    for start in 0..<len(text) - subLen + 1:
        var matched = true
        for offset in 0..<subLen:
            if text[start + offset] != sub[offset]:
                matched = false
                break
        if matched:
            return true
    return false

fn fixtureCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "abababababababababababababababababababababababababababababababab")
    if IsErr(parsed):
        panic(Error(parsed))
    return Value(parsed)

@borrows
fn buildWindow(): exactdef.BodyIrExactDefTypeArenaWindow =
    var window: exactdef.BodyIrExactDefTypeArenaWindow
    window.artifactCid = fixtureCid()
    for typeId in 0..<5:
        add(window.structuralKinds,
            Int32(typearena.TypedExprStructuralTypeInvalid))
        add(window.scalarKinds,
            Int32(typearena.TypedExprStructuralScalarInvalid))
        add(window.childTypeIds, -1)
        add(window.layoutChildStarts, 0)
        add(window.layoutChildCounts, 0)
        add(window.fixedLengths, 0)
        add(window.sizeBytes, 4)
        add(window.alignBytes, 4)
    # 0: i32 标量
    window.structuralKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralScalarInt32)
    window.sizeBytes[fixtureTypeI32] = 4
    window.alignBytes[fixtureTypeI32] = 4
    # 1: str 标量
    window.structuralKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralScalarStr)
    window.sizeBytes[fixtureTypeStr] = 24
    window.alignBytes[fixtureTypeStr] = 8
    # 2: seq<i32>
    window.structuralKinds[fixtureTypeSeqI32] =
        Int32(typearena.TypedExprStructuralTypeSequence)
    window.childTypeIds[fixtureTypeSeqI32] = fixtureTypeI32
    window.sizeBytes[fixtureTypeSeqI32] = 16
    window.alignBytes[fixtureTypeSeqI32] = 8
    # 3: Table{offset:i32@0/4, length:i32@4/4} → PLAIN 折叠
    window.structuralKinds[fixtureTypeTable] =
        Int32(typearena.TypedExprStructuralTypeObject)
    window.layoutChildStarts[fixtureTypeTable] = 0
    window.layoutChildCounts[fixtureTypeTable] = 2
    window.sizeBytes[fixtureTypeTable] = 8
    window.alignBytes[fixtureTypeTable] = 4
    add(window.layoutChildTypeIds, fixtureTypeI32)
    add(window.layoutChildOffsets, 0)
    add(window.layoutChildWidths, 4)
    add(window.layoutChildTypeIds, fixtureTypeI32)
    add(window.layoutChildOffsets, 4)
    add(window.layoutChildWidths, 4)
    # 4: Face{data:seq<i32>@0/16, head:Table@16/8} → OBJECT 折叠
    window.structuralKinds[fixtureTypeFace] =
        Int32(typearena.TypedExprStructuralTypeObject)
    window.layoutChildStarts[fixtureTypeFace] = 2
    window.layoutChildCounts[fixtureTypeFace] = 2
    window.sizeBytes[fixtureTypeFace] = 24
    window.alignBytes[fixtureTypeFace] = 8
    add(window.layoutChildTypeIds, fixtureTypeSeqI32)
    add(window.layoutChildOffsets, 0)
    add(window.layoutChildWidths, 16)
    add(window.layoutChildTypeIds, fixtureTypeTable)
    add(window.layoutChildOffsets, 16)
    add(window.layoutChildWidths, 8)
    smokeAssert(exactdef.BodyIrExactDefTypeArenaWindowShapeValid(window),
                "exact def smoke: window shape")
    return window

fn addBoundSlot(body: var coreir.BodyIR,
                name: str,
                typeKind: int32,
                typeId: int32,
                managedStorageKind: int32,
                sizeBytes: int32,
                alignBytes: int32): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body, slotId, fixtureCid(), typeId, managedStorageKind),
                "exact def smoke: slot TypeArena proof bind")
    return slotId

fn addUnboundSlot(body: var coreir.BodyIR,
                  name: str,
                  typeKind: int32,
                  sizeBytes: int32,
                  alignBytes: int32): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    return slotId

fn newDefOp(body: var coreir.BodyIR,
            kind: int32,
            target: int32,
            semanticRow: int32,
            ownership: coreir.OwnershipKind): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    op.valueDefSlot = target
    op.valueDefExprNodeIndex = semanticRow
    op.valueDefSemanticRow = semanticRow
    op.valueDefOwnership = ownership
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticRow
    return coreir.BodyIRAppendOp(body, op)

# 合成 body: 2 entry 形参 (str / Face) + 七定义 op + 1 调用 + 单块单 return。
# 语义行窗 100..106 与 transport 投影列一一对应。
fn buildBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "exact def smoke: TypeArena artifact bind")
    # 槽 0: 形参 str (序 0); 槽 1: 形参 Face (序 1)。
    let paramStr = addBoundSlot(
        body, "text", coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)
    body.localSlots[paramStr].stackOffset = -1
    let paramFace = addBoundSlot(
        body, "face", coreir.LocalAggregateTag, fixtureTypeFace,
        coreir.BodyManagedStorageManagedTag, 24, 8)
    body.localSlots[paramFace].stackOffset = -2
    coreir.BodyIRBindEntryParameterSlot(body, 0, paramStr)
    coreir.BodyIRBindEntryParameterSlot(body, 1, paramFace)
    # 槽 2..10。
    let tempStr = addBoundSlot(
        body, "tmp_str", coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)
    let tempSeq = addBoundSlot(
        body, "tmp_seq", coreir.LocalAggregateTag, fixtureTypeSeqI32,
        coreir.BodyManagedStorageManagedTag, 16, 8)
    let callStr = addBoundSlot(
        body, "call_str", coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)
    let copySeq = addBoundSlot(
        body, "copy_seq", coreir.LocalAggregateTag, fixtureTypeSeqI32,
        coreir.BodyManagedStorageManagedTag, 16, 8)
    let borrowStr = addBoundSlot(
        body, "borrow_str", coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)
    let fieldTable = addBoundSlot(
        body, "field_table", coreir.LocalAggregateTag, fixtureTypeTable,
        coreir.BodyManagedStorageManagedTag, 8, 4)
    # 槽 8..10: sentinel 腿 (未绑标量/未绑聚合/未绑 str), id 由构建序固定。
    let _ = addUnboundSlot(
        body, "plain_i32", coreir.LocalI32Tag, 4, 4)
    let _ = addUnboundSlot(
        body, "raw_aggregate", coreir.LocalAggregateTag, 8, 4)
    let _ = addUnboundSlot(
        body, "fresh_str", coreir.LocalStrTag, 24, 8)
    # entry ownership: 两形参 OwnMove, 其余 OwnInvalid。
    var ownershipKinds: int32[]
    for slotIndex in 0..<body.localSlots.len:
        add(ownershipKinds, Int32(coreir.OwnInvalid))
    ownershipKinds[paramStr] = Int32(coreir.OwnMove)
    ownershipKinds[paramFace] = Int32(coreir.OwnMove)
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, ownershipKinds)
    # o0: param 定义臂 (origin Parameter, type str)。
    let _ = newDefOp(
        body, coreir.BodyOpLoadLocalTag, paramStr, 100, coreir.OwnMove)
    # o1: temporary 定义臂 (seq)。
    let opTempSeq = newDefOp(
        body, coreir.BodyOpLoadConstTag, tempSeq, 101, coreir.OwnMove)
    add(body.ops[opTempSeq].operands, coreir.LocalAggregateTag)
    # o2: temporary 定义臂 (str)。
    let opTempStr = newDefOp(
        body, coreir.BodyOpLoadConstTag, tempStr, 102, coreir.OwnMove)
    add(body.ops[opTempStr].operands, coreir.LocalStrTag)
    # o3: callresult 定义臂 (str) — CallOp + Call op 镜像。
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "exact_def_fixture_make_str"
    call.resultSlot = callStr
    call.resultOwnership = coreir.OwnMove
    call.resultExprNodeIndex = 103
    call.resultValueDefinitionRow = 103
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId = 103
    let callIndex = body.callSequence.len
    add(body.callSequence, call)
    let opCall = newDefOp(
        body, coreir.BodyOpCallTag, callStr, 103, coreir.OwnMove)
    add(body.ops[opCall].operands, callIndex)
    # o4: binding/local-copy 臂: copySeq ← tempSeq。
    let opCopy = newDefOp(
        body, coreir.BodyOpCopyLocalTag, copySeq, 104, coreir.OwnMove)
    add(body.ops[opCopy].operands, tempSeq)
    # o5: borrow-view 臂: borrowStr ← paramStr (owner EntrySlot 域)。
    let opBorrow = newDefOp(
        body, coreir.BodyOpCopyLocalTag, borrowStr, 105,
        coreir.OwnBorrowShared)
    add(body.ops[opBorrow].operands, paramStr)
    body.ops[opBorrow].valueDefBorrowOwnerSemanticRow = 100
    body.ops[opBorrow].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainEntrySlotTag
    body.ops[opBorrow].valueDefBorrowOwnerDefinitionRow = paramStr
    # o6: field-borrow 臂: fieldTable ← paramFace.head @16/8。
    let opField = newDefOp(
        body, coreir.BodyOpFieldLoadTag, fieldTable, 106,
        coreir.OwnBorrowShared)
    add(body.ops[opField].operands, paramFace)
    add(body.ops[opField].operands, fieldTable)
    add(body.ops[opField].operands, 16)
    add(body.ops[opField].operands, 8)
    body.ops[opField].valueDefBorrowOwnerSemanticRow = 101
    body.ops[opField].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainEntrySlotTag
    body.ops[opField].valueDefBorrowOwnerDefinitionRow = paramFace
    # 单块 + return 终结符, 控制流冻结 (codec 前置形状)。
    let blockId = coreir.BodyIRAppendBlock(body, 0, body.ops.len, 0)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = tempStr
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    body.blocks[blockId].termIndex = termIndex
    coreir.BodyIRControlFlowBegin(body, 0)
    coreir.BodyIRControlFlowBindBlockScope(body, blockId, 0)
    var successors: int32[]
    var edgeKinds: int32[]
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)
    coreir.BodyIRControlFlowBindCallTarget(
        body, callIndex,
        coreir.BodyCallTargetDomainRuntimeIntrinsicTag, 0, fixtureCid())
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "exact def smoke: control flow seal")
    # transport 投影列 (LoweringOwnershipTransportSoA 的 int32 窗)。
    return body

fn buildTransportRows(): int32[] =
    var rows: int32[]
    for row in 0..<7:
        add(rows, fixtureTransportStart + row)
    return rows

fn buildTransportOriginKinds(): int32[] =
    var kinds: int32[]
    add(kinds, 1)   # 100 Parameter
    add(kinds, 4)   # 101 ManagedTemporary (seq)
    add(kinds, 4)   # 102 ManagedTemporary (str)
    add(kinds, 3)   # 103 CallResult
    add(kinds, 2)   # 104 BindingInitializer (local-copy)
    add(kinds, 2)   # 105 BindingInitializer (borrow-view)
    add(kinds, 4)   # 106 ManagedTemporary (field-borrow)
    return kinds

fn buildTransportExactTypeIds(): int32[] =
    var types: int32[]
    add(types, fixtureTypeStr)
    add(types, fixtureTypeSeqI32)
    add(types, fixtureTypeStr)
    add(types, fixtureTypeStr)
    add(types, fixtureTypeSeqI32)
    add(types, fixtureTypeStr)
    add(types, fixtureTypeTable)
    return types

@borrows
fn deriveFixture(body: var coreir.BodyIR,
                 window: exactdef.BodyIrExactDefTypeArenaWindow) =
    smokeAssert(derive.BodyIrExactDefDerive(
                    body,
                    fixtureTransportStart,
                    buildTransportRows(),
                    buildTransportOriginKinds(),
                    buildTransportExactTypeIds(),
                    window),
                "exact def smoke: derive rejected fixture")
    smokeAssert(body.exactDef.sealed, "exact def smoke: sidecar sealed")
    smokeAssert(!layout.FixedBytes32Equal(
                    body.exactDef.exactDefCid, layout.FixedBytes32()),
                "exact def smoke: exactDefCid frozen")
    smokeAssert(exactdef.BodyIrExactDefSidecarShapeValid(body),
                "exact def smoke: sidecar shape")

fn runUnit(): int32 =
    let window = buildWindow()
    var body = buildBody()
    deriveFixture(body, window)
    let opCount = body.ops.len
    smokeAssert(opCount == 7, "exact def smoke: op count")
    # ① 四 origin 定义臂。
    smokeAssert(body.exactDef.opPlaceKinds[0] ==
                    exactdef.BodyIrExactDefPlaceParamTag &&
                body.exactDef.opOriginIds[0] == 0 &&
                body.exactDef.opExactTypeIds[0] == fixtureTypeStr &&
                body.exactDef.opProducerFunctionRows[0] == 0,
                "exact def smoke: param arm")
    smokeAssert(body.exactDef.slotPlaceKinds[0] ==
                    exactdef.BodyIrExactDefPlaceParamTag &&
                body.exactDef.slotOriginIds[0] == 0 &&
                body.exactDef.slotStorageKinds[0] ==
                    exactdef.BodyIrExactDefStorageStrTag,
                "exact def smoke: param slot lanes")
    smokeAssert(body.exactDef.opPlaceKinds[1] ==
                    exactdef.BodyIrExactDefPlaceTemporaryTag &&
                body.exactDef.opOriginIds[1] == 1 &&
                body.exactDef.opExactTypeIds[1] == fixtureTypeSeqI32 &&
                body.exactDef.slotStorageKinds[3] ==
                    exactdef.BodyIrExactDefStorageSequenceTag,
                "exact def smoke: temporary arm (seq)")
    smokeAssert(body.exactDef.opPlaceKinds[2] ==
                    exactdef.BodyIrExactDefPlaceTemporaryTag &&
                body.exactDef.opOriginIds[2] == 2 &&
                body.exactDef.slotStorageKinds[2] ==
                    exactdef.BodyIrExactDefStorageStrTag,
                "exact def smoke: temporary arm (str)")
    smokeAssert(body.exactDef.opPlaceKinds[3] ==
                    exactdef.BodyIrExactDefPlaceTemporaryTag &&
                body.exactDef.opOriginIds[3] == 3 &&
                body.exactDef.opExactTypeIds[3] == fixtureTypeStr &&
                body.exactDef.slotStorageKinds[4] ==
                    exactdef.BodyIrExactDefStorageStrTag,
                "exact def smoke: callresult arm")
    # ③ local-copy 臂: fresh 槽落 source 戳 + source 物理定义边 = o1。
    smokeAssert(body.exactDef.opPlaceKinds[4] ==
                    exactdef.BodyIrExactDefPlaceStackLocalTag &&
                body.exactDef.opOriginIds[4] == 5 &&
                body.exactDef.opSourceDefOpRows[4] == 1 &&
                body.exactDef.slotStorageKinds[5] ==
                    exactdef.BodyIrExactDefStorageSequenceTag,
                "exact def smoke: local-copy arm")
    # ② borrow-view 臂: destination UNKNOWN → 同值 (STR) 落戳。
    smokeAssert(body.exactDef.opPlaceKinds[5] ==
                    exactdef.BodyIrExactDefPlaceBorrowProjectionTag &&
                body.exactDef.opOriginIds[5] == 0 &&
                body.exactDef.opSourceDefOpRows[5] == -1 &&
                body.exactDef.slotPlaceKinds[6] ==
                    exactdef.BodyIrExactDefPlaceBorrowProjectionTag &&
                body.exactDef.slotOriginIds[6] == 0 &&
                body.exactDef.slotStorageKinds[6] ==
                    exactdef.BodyIrExactDefStorageStrTag,
                "exact def smoke: borrow-view arm")
    # ④ field-borrow 臂: 逐跳核对过 (Face.head@16/8 → Table), PLAIN 折叠。
    smokeAssert(body.exactDef.opPlaceKinds[6] ==
                    exactdef.BodyIrExactDefPlaceBorrowProjectionTag &&
                body.exactDef.opOriginIds[6] == 1 &&
                body.exactDef.opExactTypeIds[6] == fixtureTypeTable &&
                body.exactDef.slotStorageKinds[7] ==
                    exactdef.BodyIrExactDefStoragePlainTag,
                "exact def smoke: field-borrow arm")
    smokeAssert(body.exactDef.slotStorageKinds[1] ==
                    exactdef.BodyIrExactDefStorageObjectTag,
                "exact def smoke: Face OBJECT fold")
    # ⑤ sentinel: nominal UNKNOWN (未绑聚合) / 非 nominal 静态 (i32) true;
    #    已证权威 (str 形参) 与 fresh str 载体不误判 false。
    smokeAssert(exactdef.BodyIrExactDefSlotIsSentinel(body, 8),
                "exact def smoke: sentinel scalar static lane")
    smokeAssert(exactdef.BodyIrExactDefSlotIsSentinel(body, 9),
                "exact def smoke: sentinel nominal unknown")
    smokeAssert(!exactdef.BodyIrExactDefSlotIsSentinel(body, 0),
                "exact def smoke: bound str not sentinel")
    smokeAssert(!exactdef.BodyIrExactDefSlotIsSentinel(body, 10),
                "exact def smoke: fresh str carrier not misjudged")
    # ⑥ storage 子句判词正路径: 干净定义通过; 戳值变异 SEQUENCE 精确红回。
    smokeAssert(derive.BodyIrExactDefSlotAuthorityStorageClauseCheck(
                    body, window, 5),
                "exact def smoke: storage clause positive")
    let cleanCid = body.exactDef.exactDefCid
    body.exactDef.slotStorageKinds[7] =
        exactdef.BodyIrExactDefStorageSequenceTag
    smokeAssert(!derive.BodyIrExactDefSlotAuthorityStorageClauseCheck(
                    body, window, 6),
                "exact def smoke: storage clause must reject mutated stamp")
    let verdictLine = exactdef.BodyIrExactDefSlotAuthorityMismatchLine(
        "derive", 0, 6, 7,
        body.localSlots[7].typeKind, body.localSlots[7].sizeBytes,
        body.localSlots[7].name,
        body.ops[6].kind, body.ops[6].target,
        body.ops[6].operands[0], body.ops[6].operands[1],
        body.ops[6].operands[2],
        body.exactDef.opSourceDefOpRows[6],
        body.exactDef.opReadADefOpRows[6],
        body.exactDef.opExactTypeIds[6],
        body.localSlots[7].typeArenaTypeId,
        body.exactDef.opPlaceKinds[6],
        body.exactDef.slotPlaceKinds[7],
        body.exactDef.opOriginIds[6],
        body.exactDef.slotOriginIds[7],
        exactdef.BodyIrExactDefStoragePlainTag,
        exactdef.BodyIrExactDefStorageSequenceTag)
    smokeAssert(smokeStrContains(
                    verdictLine,
                    "slot authority mismatch def_type=3 slot_type=3 def_place=4 slot_place=4 def_origin=1 slot_origin=1 def_storage=1 slot_storage=3"),
                "exact def smoke: verdict clause text exact")
    body.exactDef.slotStorageKinds[7] =
        exactdef.BodyIrExactDefStoragePlainTag
    smokeAssert(layout.FixedBytes32Equal(
                    body.exactDef.exactDefCid, cleanCid),
                "exact def smoke: cid untouched by lane poke (test-local)")
    # ⑦ codec field19 往返: 编→解→列逐等→再编逐字节等。
    var enc1 = fragcodec.Backend2BodyIrEncode(body)
    var cursor: int32
    var decoded = fragcodec.Backend2BodyIrDecode(enc1, cursor)
    smokeAssert(cursor == enc1.len, "exact def smoke: decode cursor")
    smokeAssert(decoded.exactDef.sealed &&
                decoded.exactDef.opPlaceKinds.len == opCount &&
                layout.FixedBytes32Equal(
                    decoded.exactDef.exactDefCid,
                    body.exactDef.exactDefCid),
                "exact def smoke: codec sidecar identity")
    for opIndex in 0..<opCount:
        smokeAssert(decoded.exactDef.opPlaceKinds[opIndex] ==
                        body.exactDef.opPlaceKinds[opIndex] &&
                    decoded.exactDef.opExactTypeIds[opIndex] ==
                        body.exactDef.opExactTypeIds[opIndex] &&
                    decoded.exactDef.opOriginIds[opIndex] ==
                        body.exactDef.opOriginIds[opIndex] &&
                    decoded.exactDef.opSourceDefOpRows[opIndex] ==
                        body.exactDef.opSourceDefOpRows[opIndex] &&
                    decoded.exactDef.opReadADefOpRows[opIndex] ==
                        body.exactDef.opReadADefOpRows[opIndex],
                    "exact def smoke: codec op lanes")
    for slotIndex in 0..<body.localSlots.len:
        smokeAssert(decoded.exactDef.slotPlaceKinds[slotIndex] ==
                        body.exactDef.slotPlaceKinds[slotIndex] &&
                    decoded.exactDef.slotOriginIds[slotIndex] ==
                        body.exactDef.slotOriginIds[slotIndex] &&
                    decoded.exactDef.slotStorageKinds[slotIndex] ==
                        body.exactDef.slotStorageKinds[slotIndex],
                    "exact def smoke: codec slot lanes")
    var enc2 = fragcodec.Backend2BodyIrEncode(decoded)
    smokeAssert(rawbytes.BytesEqual(enc1, enc2),
                "exact def smoke: codec byte round-trip")
    rawbytes.BytesFree(enc1)
    rawbytes.BytesFree(enc2)
    # 零漂移同基: 同 fixture 二次构建推导, 侧车 CID 逐等。
    var bodyAgain = buildBody()
    deriveFixture(bodyAgain, window)
    smokeAssert(layout.FixedBytes32Equal(
                    bodyAgain.exactDef.exactDefCid,
                    body.exactDef.exactDefCid),
                "exact def smoke: derive deterministic cid")
    os.WriteLine(os.Get_stdout(), "EXACT_DEF_DERIVE_UNIT_OK")
    return 0

fn runVerdictEmit(): int32 =
    let window = buildWindow()
    var body = buildBody()
    deriveFixture(body, window)
    # 戳值变异 SEQUENCE: PLAIN(1) 戳改 SEQUENCE(3) → 同 C op173 形精确红。
    body.exactDef.slotStorageKinds[7] =
        exactdef.BodyIrExactDefStorageSequenceTag
    if derive.BodyIrExactDefSlotAuthorityStorageClauseCheck(body, window, 6):
        return 1
    return 2

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var mode = "unit"
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "":
        mode = "unit"
    if mode == "unit":
        return runUnit()
    if mode == "verdict-emit":
        return runVerdictEmit()
    os.WriteLine(os.Get_stdout(), Fmt"unknown mode: {mode}")
    return 2
