import std/os
import std/result
import std/rawbytes
import std/strutils as strutil
import std/tls/x509
import cheng/quic/tls/policy
import cheng/apps/vpn_proxy/transport_tcp_tls_handshake as hs
import cheng/apps/vpn_proxy/transport_tcp_tls_record as rec

fn loadBytes(path: str): Result[Bytes] =
    let readRes: Result[Bytes] = os.ReadFileBytesResult(path)
    if IsErr(readRes):
        return Err[Bytes](strutil.Join(["read failed: ", path, ": ", ErrorText(readRes)], ""))
    if BytesLen(Value(readRes)) <= 0:
        return Err[Bytes](strutil.Join(["empty file: ", path], ""))
    return readRes

fn buildPolicy(certDer: Bytes, keyPk8: Bytes, rootDer: Bytes): policy.MsQuicTlsPolicy =
    var out: policy.MsQuicTlsPolicy
    policy.initMsQuicTlsPolicyInto(out)
    out.serverName = "localhost"
    out.certChain0 = certDer
    out.certChainCount = 1
    out.certPrivateKey = keyPk8
    out.certLeafKeyKind = x509.X509KeyEcdsaP256
    out.trustRoot0 = rootDer
    out.trustRootsCount = 1
    return out

fn main(): int32 =
    let certRes: Result[Bytes] = loadBytes("artifacts/vpn-proxy-local/transport.cert.der")
    if IsErr(certRes):
        echo(ErrorText(certRes))
        return 1
    let keyRes: Result[Bytes] = loadBytes("artifacts/vpn-proxy-local/transport.key.pk8")
    if IsErr(keyRes):
        echo(ErrorText(keyRes))
        return 2
    let rootRes: Result[Bytes] = loadBytes("artifacts/vpn-proxy-local/transport.root.der")
    if IsErr(rootRes):
        echo(ErrorText(rootRes))
        return 3

    let certDer: Bytes = Value(certRes)
    let keyPk8: Bytes = Value(keyRes)
    let rootDer: Bytes = Value(rootRes)
    let tlsPolicy: policy.MsQuicTlsPolicy = buildPolicy(certDer, keyPk8, rootDer)

    let clientHelloRes: Result[Bytes] = hs.VpnProxyTcpTlsForwardClientBuildHello("localhost", rootDer)
    if IsErr(clientHelloRes):
        echo(ErrorText(clientHelloRes))
        return 4
    let flightRes: Result[hs.VpnProxyTcpTlsServerFlight] = hs.VpnProxyTcpTlsForwardServerBuildFlight(Value(clientHelloRes),
                                                                                                      tlsPolicy)
    if IsErr(flightRes):
        echo(ErrorText(flightRes))
        return 5
    let flight: hs.VpnProxyTcpTlsServerFlight = Value(flightRes)
    let clientFinishedRes: Result[Bytes] = hs.VpnProxyTcpTlsForwardClientProcessServerFlight(flight.serverHelloRecord,
                                                                                             flight.encryptedHandshakeRecord)
    if IsErr(clientFinishedRes):
        echo(ErrorText(clientFinishedRes))
        return 6
    let serverFinishedRes: Result[bool] = hs.VpnProxyTcpTlsForwardServerProcessClientFinished(Value(clientFinishedRes))
    if IsErr(serverFinishedRes):
        echo(ErrorText(serverFinishedRes))
        return 7

    var clientSend: rec.VpnProxyTcpTlsRecordKeys = Value(hs.VpnProxyTcpTlsForwardClientAppSendKeys())
    var clientRecv: rec.VpnProxyTcpTlsRecordKeys = Value(hs.VpnProxyTcpTlsForwardClientAppRecvKeys())
    var serverSend: rec.VpnProxyTcpTlsRecordKeys = Value(hs.VpnProxyTcpTlsForwardServerAppSendKeys())
    var serverRecv: rec.VpnProxyTcpTlsRecordKeys = Value(hs.VpnProxyTcpTlsForwardServerAppRecvKeys())

    let ping: Bytes = BytesFromString("ping")
    let pong: Bytes = BytesFromString("pong")
    let c2sRes: Result[Bytes] = rec.VpnProxyTcpTlsRecordEncrypt(clientSend,
                                                                 rec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                 ping)
    if IsErr(c2sRes):
        echo(ErrorText(c2sRes))
        return 8
    let c2sPlainRes: Result[rec.VpnProxyTcpTlsRecordPlain] = rec.VpnProxyTcpTlsRecordDecrypt(serverRecv,
                                                                                              Value(c2sRes))
    if IsErr(c2sPlainRes):
        echo(ErrorText(c2sPlainRes))
        return 9
    if BytesToString(Value(c2sPlainRes).payload) != "ping":
        echo("client to server payload mismatch")
        return 10

    let s2cRes: Result[Bytes] = rec.VpnProxyTcpTlsRecordEncrypt(serverSend,
                                                                 rec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                 pong)
    if IsErr(s2cRes):
        echo(ErrorText(s2cRes))
        return 11
    let s2cPlainRes: Result[rec.VpnProxyTcpTlsRecordPlain] = rec.VpnProxyTcpTlsRecordDecrypt(clientRecv,
                                                                                              Value(s2cRes))
    if IsErr(s2cPlainRes):
        echo(ErrorText(s2cPlainRes))
        return 12
    if BytesToString(Value(s2cPlainRes).payload) != "pong":
        echo("server to client payload mismatch")
        return 13

    echo("vpn_proxy_tcp_tls_real_files_handshake_smoke ok")
    return 0
