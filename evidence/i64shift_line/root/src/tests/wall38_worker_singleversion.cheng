# wall38 前置墙最小探针 v6：单版本形（无早退，无条件末端赋值；镜像 emit-csg worker）。
type
    W38Plan = object
        text: str
        ok: bool

    W38Work = ref object
        plan: W38Plan
        err: str
        ok: bool

fn w38BuildPlanInto(channel: str, plan: var W38Plan, err: var str): bool =
    plan.text = channel
    plan.ok = true
    err = ""
    return true

fn w38Worker(raw: ptr) =
    var builtOk = false
    var outErr = ""
    var outPlan = W38Plan(text: "", ok: false)
    let work: W38Work = W38Work(raw)
    if work != nil:
        builtOk = w38BuildPlanInto("ch", outPlan, outErr)
    if work != nil:
        work.plan = outPlan
        work.err = outErr
        work.ok = builtOk

fn main(): int32 =
    return 0
