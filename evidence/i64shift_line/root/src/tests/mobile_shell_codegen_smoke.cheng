import std/monotimes
import std/os
import std/strings
import cheng/core/tooling/mobile_shell_codegen as mshell
import cheng/core/tooling/path as chengpath

fn main(): int32 =
    let root: str = os.GetCurrentDir()
    let stamp: str = int64ToStr(monotimes.MonoTimeNs(monotimes.GetMonoTime()))
    let outDir: str = Fmt"/tmp/cheng_mobile_shell_codegen_smoke_{stamp}"
    let madeOutDir: bool = mshell.MobileShellEnsureDir(outDir)
    assert(madeOutDir, "mobile shell smoke: out dir")
    let runtimeInputDir: str = os.JoinPath(outDir, "runtime_inputs")
    let madeRuntimeInputDir: bool = mshell.MobileShellEnsureDir(runtimeInputDir)
    assert(madeRuntimeInputDir, "mobile shell smoke: runtime input dir")
    let runtimeContractInput: str = os.JoinPath(runtimeInputDir, "native_gui_runtime_contract_v1.json")
    let runtimeBundleInput: str = os.JoinPath(runtimeInputDir, "native_gui_bundle_v1.json")
    let semanticInput: str = os.JoinPath(runtimeInputDir, "r2c_semantic_render_nodes.tsv")
    let sceneDataInput: str = os.JoinPath(runtimeInputDir, "unimaker_scene_data.bin")
    let glyphSdfPixelsInput: str = os.JoinPath(runtimeInputDir, "unimaker_glyph_sdf_pixels.bin")
    let computerUseManifestInput: str = os.JoinPath(runtimeInputDir, "unimaker_computer_use_manifest.json")
    let mediaVideoAssetName: str = "84dd8bc7d0d631777a799897eba47efa11eaf4e11be9cfa0b22bb4072e84a8ac.mp4"
    let mediaAssetInputDir: str = os.JoinPath(runtimeInputDir, "runtime/media/assets")
    let mediaVideoAssetInput: str = os.JoinPath(mediaAssetInputDir, mediaVideoAssetName)
    let truthInputDir: str = os.JoinPath(runtimeInputDir, "truth")
    let truthInputRgba: str = os.JoinPath(truthInputDir, "home_default.rgba")
    let truthInputMeta: str = os.JoinPath(truthInputDir, "home_default.meta.json")
    var fixtureError: str
    assert(mshell.MobileShellWriteTextExact(runtimeContractInput,
                                            "{\n  \"format\":\"native_gui_runtime_contract_v1\"\n}\n",
                                            fixtureError),
           "mobile shell smoke: runtime contract fixture")
    assert(mshell.MobileShellWriteTextExact(runtimeBundleInput,
                                            "{\n  \"format\":\"native_gui_bundle_v1\"\n}\n",
                                            fixtureError),
           "mobile shell smoke: runtime bundle fixture")
    assert(mshell.MobileShellEnsureDir(truthInputDir), "mobile shell smoke: truth input dir")
    assert(mshell.MobileShellEnsureDir(mediaAssetInputDir), "mobile shell smoke: media asset input dir")
    assert(mshell.MobileShellWriteTextExact(semanticInput,
                                            "node_1\thome_default\ttext\t48656c6c6f\t#root\tonClick\tapp/App.tsx\t/App",
                                            fixtureError),
           "mobile shell smoke: semantic fixture")
    assert(mshell.MobileShellWriteTextExact(glyphSdfPixelsInput, "GLYPH", fixtureError),
           "mobile shell smoke: glyph sdf pixels fixture")
    assert(mshell.MobileShellWriteTextExact(sceneDataInput, "SCENE", fixtureError),
           "mobile shell smoke: scene data fixture")
    assert(mshell.MobileShellWriteTextExact(computerUseManifestInput,
                                            "{\"schema\":\"unimaker.computer_use_manifest.v1\"}\n",
                                            fixtureError),
           "mobile shell smoke: computer-use manifest fixture")
    assert(mshell.MobileShellWriteTextExact(mediaVideoAssetInput, "MP4", fixtureError),
           "mobile shell smoke: media video payload fixture")
    assert(mshell.MobileShellWriteTextExact(truthInputRgba, "RGBA", fixtureError),
           "mobile shell smoke: truth rgba fixture")
    assert(mshell.MobileShellWriteTextExact(truthInputMeta,
                                            "{\n  \"width\": 1,\n  \"height\": 1\n}",
                                            fixtureError),
           "mobile shell smoke: truth meta fixture")
    var opts = mshell.MobileShellDefaultOptions(root)
    opts.outDir = outDir
    opts.appId = "org.cheng.smoke"
    opts.appName = "ChengSmoke"
    opts.libName = "cheng_smoke_app"
    opts.runtimeMode = "cheng_app_exports_v1"
    opts.runtimeContractPath = runtimeContractInput
    opts.runtimeBundlePath = runtimeBundleInput
    opts.routeState = "home_default"
    opts.emitAndroid = true
    opts.emitIos = true
    opts.emitHarmony = true
    var manifestPath: str
    var errorText: str
    let exportOk: bool = mshell.MobileShellExportResolved(opts,
                                                            manifestPath,
                                                            errorText)
    let errorPath: str = os.JoinPath(outDir, "mobile_shell_error.txt")
    if !exportOk:
        let _wroteError: bool = mshell.MobileShellWriteTextExact(errorPath, errorText, fixtureError)
        echo("mobile shell smoke: export failed")
        return 1
    assert(len(errorText) == 0, "mobile shell smoke: export empty error")

    var nativeAllOpts = mshell.MobileShellDefaultOptions(root)
    nativeAllOpts.outDir = Fmt"{outDir}_native_all"
    nativeAllOpts.appId = "org.cheng.smoke"
    nativeAllOpts.appName = "ChengSmoke"
    nativeAllOpts.libName = "cheng_smoke_app"
    nativeAllOpts.runtimeMode = "r2c_native_gui_v1"
    nativeAllOpts.runtimeContractPath = runtimeContractInput
    nativeAllOpts.runtimeBundlePath = runtimeBundleInput
    nativeAllOpts.routeState = "home_default"
    nativeAllOpts.emitAndroid = true
    nativeAllOpts.emitIos = true
    nativeAllOpts.emitHarmony = true
    var nativeAllManifestPath: str
    var nativeAllError: str
    assert(!mshell.MobileShellExportResolved(nativeAllOpts,
                                             nativeAllManifestPath,
                                             nativeAllError),
           "mobile shell smoke: native renderer all-platform export fails")
    assert(strings.StrContains(nativeAllError, "native scene renderer is implemented only for android"),
           "mobile shell smoke: native renderer unsupported platform error")
    assert(strings.StrContains(nativeAllError, "unsupported platforms: ios,harmony"),
           "mobile shell smoke: native renderer unsupported platform list")

    var nativeAndroidCmakeOpts = mshell.MobileShellDefaultOptions(root)
    nativeAndroidCmakeOpts.outDir = Fmt"{outDir}_native_android_cmake"
    nativeAndroidCmakeOpts.appId = "org.cheng.smoke"
    nativeAndroidCmakeOpts.appName = "ChengSmoke"
    nativeAndroidCmakeOpts.libName = "cheng_smoke_app"
    nativeAndroidCmakeOpts.runtimeMode = "r2c_native_gui_v1"
    nativeAndroidCmakeOpts.runtimeContractPath = runtimeContractInput
    nativeAndroidCmakeOpts.runtimeBundlePath = runtimeBundleInput
    nativeAndroidCmakeOpts.routeState = "home_default"
    nativeAndroidCmakeOpts.emitAndroid = true
    nativeAndroidCmakeOpts.emitIos = false
    nativeAndroidCmakeOpts.emitHarmony = false
    var nativeAndroidCmakeManifestPath: str
    var nativeAndroidCmakeError: str
    assert(!mshell.MobileShellExportResolved(nativeAndroidCmakeOpts,
                                             nativeAndroidCmakeManifestPath,
                                             nativeAndroidCmakeError),
           "mobile shell smoke: native renderer android cmake export fails")
    assert(strings.StrContains(nativeAndroidCmakeError, "requires --android-native-mode prebuilt"),
           "mobile shell smoke: native renderer android requires prebuilt")

    var nativeAndroidOpts = mshell.MobileShellDefaultOptions(root)
    let nativeAndroidOutDir: str = Fmt"{outDir}_native_android"
    nativeAndroidOpts.outDir = nativeAndroidOutDir
    nativeAndroidOpts.appId = "org.cheng.smoke"
    nativeAndroidOpts.appName = "ChengSmoke"
    nativeAndroidOpts.libName = "cheng_smoke_app"
    nativeAndroidOpts.runtimeMode = "r2c_native_gui_v1"
    nativeAndroidOpts.runtimeContractPath = runtimeContractInput
    nativeAndroidOpts.runtimeBundlePath = runtimeBundleInput
    nativeAndroidOpts.routeState = "home_default"
    nativeAndroidOpts.androidNativeMode = "prebuilt"
    nativeAndroidOpts.emitAndroid = true
    nativeAndroidOpts.emitIos = false
    nativeAndroidOpts.emitHarmony = false
    var nativeAndroidManifestPath: str
    var nativeAndroidError: str
    assert(mshell.MobileShellExportResolved(nativeAndroidOpts,
                                            nativeAndroidManifestPath,
                                            nativeAndroidError),
           "mobile shell smoke: native renderer android-only export")
    let nativeAndroidManifestText: str = os.ReadFile(nativeAndroidManifestPath)
    assert(strings.StrContains(nativeAndroidManifestText, "\"runtime_mode\":\"r2c_native_gui_v1\""),
           "mobile shell smoke: native android manifest runtime mode")
    assert(strings.StrContains(nativeAndroidManifestText, "\"native_scene_renderer_platforms\":[\"android\"]"),
           "mobile shell smoke: native android manifest renderer platform")
    assert(strings.StrContains(nativeAndroidManifestText, "\"native_scene_renderer_unsupported_platforms\":[]"),
           "mobile shell smoke: native android manifest no unsupported renderer platform")

    var nativeHarmonyExperimentalOpts = mshell.MobileShellDefaultOptions(root)
    let nativeHarmonyExperimentalOutDir: str = Fmt"{outDir}_native_harmony_experimental"
    nativeHarmonyExperimentalOpts.outDir = nativeHarmonyExperimentalOutDir
    nativeHarmonyExperimentalOpts.appId = "org.cheng.smoke"
    nativeHarmonyExperimentalOpts.appName = "ChengSmoke"
    nativeHarmonyExperimentalOpts.libName = "cheng_smoke_app"
    nativeHarmonyExperimentalOpts.runtimeMode = "r2c_native_gui_v1"
    nativeHarmonyExperimentalOpts.runtimeContractPath = runtimeContractInput
    nativeHarmonyExperimentalOpts.runtimeBundlePath = runtimeBundleInput
    nativeHarmonyExperimentalOpts.routeState = "home_default"
    nativeHarmonyExperimentalOpts.androidNativeMode = "prebuilt"
    nativeHarmonyExperimentalOpts.emitAndroid = true
    nativeHarmonyExperimentalOpts.emitIos = false
    nativeHarmonyExperimentalOpts.emitHarmony = true
    nativeHarmonyExperimentalOpts.harmonyNativeGuiExperimental = true
    nativeHarmonyExperimentalOpts.harmonyModName = "cheng_gui_host"
    nativeHarmonyExperimentalOpts.harmonyLibraryName = "cheng_gui_host"
    var nativeHarmonyExperimentalManifestPath: str
    var nativeHarmonyExperimentalError: str
    assert(mshell.MobileShellExportResolved(nativeHarmonyExperimentalOpts,
                                            nativeHarmonyExperimentalManifestPath,
                                            nativeHarmonyExperimentalError),
           "mobile shell smoke: native renderer harmony experimental export")
    let nativeHarmonyExperimentalManifestText: str = os.ReadFile(nativeHarmonyExperimentalManifestPath)
    assert(strings.StrContains(nativeHarmonyExperimentalManifestText, "\"runtime_mode\":\"r2c_native_gui_v1\""),
           "mobile shell smoke: native harmony experimental manifest runtime mode")
    let nativeHarmonyExperimentalCmakePath: str = os.JoinPath(nativeHarmonyExperimentalOutDir, "harmony/entry/src/main/cpp/CMakeLists.txt")
    let nativeHarmonyExperimentalGenPath: str = os.JoinPath(nativeHarmonyExperimentalOutDir, "harmony/entry/src/main/cpp/cheng_gui_host_gen.c")
    let nativeHarmonyExperimentalAdapterPath: str = os.JoinPath(nativeHarmonyExperimentalOutDir, "harmony/entry/src/main/cpp/cheng_gui_host_adapter.c")
    let nativeHarmonyExperimentalIndexPath: str = os.JoinPath(nativeHarmonyExperimentalOutDir, "harmony/entry/src/main/ets/pages/Index.ets")
    assert(os.FileExists(nativeHarmonyExperimentalCmakePath), "mobile shell smoke: harmony experimental cmake exists")
    # slice-8 接线 (#13): under harmonyNativeGuiExperimental, MobileShellWriteHarmony
    # now emits the three-file generator split (cheng_gui_host_gen.c +
    # cheng_gui_host_adapter.c) instead of the toy single-file monolith
    # cheng_gui_host.cpp; cheng_gui_entry.cpp (NAPI/XComponent module glue) stays
    # exclusively hand-authored and is never part of generator output (see
    # docs/harmony-host-codegen-migration-plan.md).
    assert(os.FileExists(nativeHarmonyExperimentalGenPath), "mobile shell smoke: harmony experimental gen.c exists (slice-8 wiring)")
    assert(os.FileExists(nativeHarmonyExperimentalAdapterPath), "mobile shell smoke: harmony experimental adapter.c exists (slice-8 wiring)")
    let nativeHarmonyExperimentalCmakeText: str = os.ReadFile(nativeHarmonyExperimentalCmakePath)
    let nativeHarmonyExperimentalGenText: str = os.ReadFile(nativeHarmonyExperimentalGenPath)
    let nativeHarmonyExperimentalAdapterText: str = os.ReadFile(nativeHarmonyExperimentalAdapterPath)
    let nativeHarmonyExperimentalIndexText: str = os.ReadFile(nativeHarmonyExperimentalIndexPath)
    # slice-8 wiring verify(a): the production MobileShellWriteHarmony entrypoint
    # must route the harmonyNativeGuiExperimental branch through
    # MobileShellHarmonyGuiHostCmakeText -- already proven byte-identical to
    # platform/harmony/ChengGuiDemo's checked-in CMakeLists.txt with default opts
    # by the slice-6 standalone assertion above -- instead of the toy single-file
    # MobileShellHarmonyCmake.
    let nativeHarmonyExperimentalCmakeRealPath: str = os.JoinPath(root, "platform/harmony/ChengGuiDemo/entry/src/main/cpp/CMakeLists.txt")
    let nativeHarmonyExperimentalCmakeRealText: str = os.ReadFile(nativeHarmonyExperimentalCmakeRealPath)
    assert(nativeHarmonyExperimentalCmakeText == nativeHarmonyExperimentalCmakeRealText,
           "mobile shell smoke: harmony experimental cmake byte-identical to platform/harmony/ChengGuiDemo (slice-8 wiring)")
    # slice-8 接线 (#13) 最终验收核心断言 (docs/harmony-m3-threefile-emit-spec.md
    # 切片4 action 第3点): 生成的 gen.c/adapter.c 必须与 platform/harmony/ChengGuiDemo
    # 里 checked-in 的手写文件逐字节相同。若不同, 说明手写侧后续又演进过而生成器
    # 没跟上 (drift), 需要用 tools/harmony_host_gen_gap_census.sh 摸清楚具体缺口
    # ——不允许在这里悄悄放宽断言掩盖 drift。
    let nativeHarmonyExperimentalGenRealPath: str = os.JoinPath(root, "platform/harmony/ChengGuiDemo/entry/src/main/cpp/cheng_gui_host_gen.c")
    let nativeHarmonyExperimentalGenRealText: str = os.ReadFile(nativeHarmonyExperimentalGenRealPath)
    assert(nativeHarmonyExperimentalGenText == nativeHarmonyExperimentalGenRealText,
           "mobile shell smoke: harmony gen.c byte-identical to checked-in cheng_gui_host_gen.c")
    let nativeHarmonyExperimentalAdapterRealPath: str = os.JoinPath(root, "platform/harmony/ChengGuiDemo/entry/src/main/cpp/cheng_gui_host_adapter.c")
    let nativeHarmonyExperimentalAdapterRealText: str = os.ReadFile(nativeHarmonyExperimentalAdapterRealPath)
    assert(nativeHarmonyExperimentalAdapterText == nativeHarmonyExperimentalAdapterRealText,
           "mobile shell smoke: harmony adapter.c byte-identical to checked-in cheng_gui_host_adapter.c")
    assert(strings.StrContains(nativeHarmonyExperimentalCmakeText, "target_link_libraries(cheng_gui_host PUBLIC"),
           "mobile shell smoke: harmony experimental cmake target_link_libraries name")
    assert(strings.StrContains(nativeHarmonyExperimentalIndexText, "import harmonyHost from 'libcheng_gui_host.so'"),
           "mobile shell smoke: harmony experimental index napi import follows libraryname (slice-6 residual)")
    assert(strings.StrContains(nativeHarmonyExperimentalIndexText, "libraryname: 'cheng_gui_host'"),
           "mobile shell smoke: harmony experimental index XComponent libraryname follows opts (slice-6 residual)")
    assert(strings.StrContains(nativeHarmonyExperimentalAdapterText, "static EGLSurface cheng_host_egl_window_surface(EGLDisplay dpy, EGLConfig cfg, CHENG_HOST_WINDOW w) {"),
           "mobile shell smoke: harmony experimental adapter.c OHOS window/EGL platform hook exported")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "int32_t cheng_mobile_host_read_glyph_sdf_pixel_asset(void* out, int32_t byteCount, int32_t expectedCrc32) {"),
           "mobile shell smoke: harmony experimental gen.c glyph sdf pixel asset reader exported")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "int32_t cheng_mobile_host_read_scene_data_asset(void* out, int32_t byteCount, int32_t expectedCrc32) {"),
           "mobile shell smoke: harmony experimental gen.c scene data asset reader exported")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "void cheng_mobile_host_trace_step(int32_t step) {"),
           "mobile shell smoke: harmony experimental gen.c trace step exported")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "rawfile crc mismatch rel=%s actual=%08x expected=%08x"),
           "mobile shell smoke: harmony experimental gen.c rawfile read enforces crc32 integrity check")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "rawfile length mismatch rel=%s actual=%ld expected=%d"),
           "mobile shell smoke: harmony experimental gen.c rawfile read enforces strict length match")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "cheng_harmony_read_asset_file_fallback(rel, out, byteCount, expectedCrc32)"),
           "mobile shell smoke: harmony experimental gen.c rawfile read has headless asset dir fallback")

    # slice-4: video-active OH_NativeVSync consumer (ChengVideoVSyncCallback/
    # cheng_video_vsync_engage/cheng_video_vsync_disengage) absorbed from
    # UNABSORBED vsync族 — generated text must reproduce the hand-written
    # platform/harmony/ChengGuiDemo cheng_gui_host_gen.c function bodies
    # byte-for-byte (checked by tools/harmony_host_gen_gap_census.sh GEN-EQUAL);
    # these StrContains checks are the always-on regression guard.
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "static void ChengVideoVSyncCallback(long long timestamp, void* data) {"),
           "mobile shell smoke: harmony experimental gen.c video vsync callback exported")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "static void cheng_video_vsync_engage(void) {"),
           "mobile shell smoke: harmony experimental gen.c video vsync engage exported")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "void cheng_video_vsync_disengage(void) {"),
           "mobile shell smoke: harmony experimental gen.c video vsync disengage exported")

    # wave9 absorption: cheng_resolve_exports (App export resolver) absorbed
    # from UNABSORBED其它族 — generated body must reproduce the hand-written
    # cheng_gui_host_gen.c:1385-1477 function minus the two dead lines
    # (`char lib_path[256];` + `(void)lib_path; (void)snprintf;`, an
    # Android-generator copy-paste leftover with zero effect on either compiled
    # output; declared 正当 diff in the wave9 absorption dossier, checked by
    # tools/harmony_host_gen_gap_census.sh GEN-DIFF diff_lines=2, not GEN-EQUAL).
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "static int cheng_resolve_exports(void) {"),
           "mobile shell smoke: harmony experimental gen.c app export resolver exported")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "if (dladdr((void*)&cheng_resolve_exports, &self_info) && self_info.dli_fname != NULL) {"),
           "mobile shell smoke: harmony experimental gen.c app export resolver self-dlopen via dladdr+RTLD_NOLOAD")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_handle = dlopen(NULL, RTLD_NOW | RTLD_GLOBAL);"),
           "mobile shell smoke: harmony experimental gen.c app export resolver dlopen(NULL) fallback")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_resume = (cheng_app_resume_fn)cheng_resolve_required_app_export(\"cheng_app_resume\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver required export resolution")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_debug_route_is_fullscreen_video = (cheng_app_debug_i32_at_fn)dlsym(s_app_handle, \"cheng_app_debug_route_is_fullscreen_video\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver optional export fail-safe dlsym")

    # wave9 phase B: 59 optional App exports lit up in cheng_resolve_exports
    # (dossier wf_568671a5-ebd) that scene_app_oh.o (2026-07-12 build) already
    # exports but resolve_exports never dlsym'd. One representative assertion
    # per family (A text-input/B computer_use/C m2/D distributed-nodes/E probe/
    # F video-state/G runtime-storage); with_preview and audio_es excluded.
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_clear_text_input_focus = (cheng_app_clear_text_input_focus_fn)dlsym(s_app_handle, \"cheng_app_clear_text_input_focus\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver phase B family A text-input")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_computer_use_media_selection_result_utf8 = (cheng_app_computer_use_media_selection_result_utf8_fn)dlsym(s_app_handle, \"cheng_app_computer_use_media_selection_result_with_preview_utf8\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver phase B family B computer_use")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_debug_m2_active_category_content = (cheng_app_debug_i32_fn)dlsym(s_app_handle, \"cheng_app_debug_m2_active_category_content\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver phase B family C m2 debug counters")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_nodes_update_utf8 = (cheng_app_nodes_update_utf8_fn)dlsym(s_app_handle, \"cheng_app_nodes_update_utf8\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver phase B family D distributed-nodes")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_debug_box_probe = (cheng_app_debug_probe3_fn)dlsym(s_app_handle, \"cheng_app_debug_box_probe\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver phase B family E probe (3-arg)")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_app_debug_state_is_video_playing = (cheng_app_debug_i32_fn)dlsym(s_app_handle, \"cheng_app_debug_state_is_video_playing\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver phase B family F video-state")
    assert(strings.StrContains(nativeHarmonyExperimentalGenText, "s_runtime_storage_dirty_value_utf8 = (cheng_mobile_host_runtime_storage_dirty_at_fn)dlsym(s_app_handle, \"cheng_mobile_host_runtime_storage_dirty_value_utf8\");"),
           "mobile shell smoke: harmony experimental gen.c app export resolver phase B family G runtime-storage")

    # slice-7 follow-up: MobileShellHarmonyAdapterContractText must reproduce
    # platform/harmony/ChengGuiDemo/entry/src/main/cpp/cheng_gui_host_adapter_contract.h
    # byte-for-byte (mirrors the slice-6 gui-host cmake byte-identical gate below),
    # so a generator edit that forgets to re-export into the checked-in header
    # goes red here instead of drifting silently.
    let nativeHarmonyExperimentalAdapterContractPath: str = os.JoinPath(nativeHarmonyExperimentalOutDir, "harmony/entry/src/main/cpp/cheng_gui_host_adapter_contract.h")
    assert(os.FileExists(nativeHarmonyExperimentalAdapterContractPath),
           "mobile shell smoke: harmony experimental adapter contract header exists")
    let nativeHarmonyExperimentalAdapterContractText: str = os.ReadFile(nativeHarmonyExperimentalAdapterContractPath)
    let adapterContractRealPath: str = os.JoinPath(root, "platform/harmony/ChengGuiDemo/entry/src/main/cpp/cheng_gui_host_adapter_contract.h")
    let adapterContractRealText: str = os.ReadFile(adapterContractRealPath)
    assert(nativeHarmonyExperimentalAdapterContractText == adapterContractRealText,
           "mobile shell smoke: harmony adapter contract header byte-identical to platform/harmony/ChengGuiDemo checked-in header")
    assert(strings.StrContains(nativeHarmonyExperimentalAdapterContractText, "GLUE — host.c defines (external linkage); adapter/App-generated glue calls."),
           "mobile shell smoke: harmony adapter contract header GLUE section banner")
    assert(strings.StrContains(nativeHarmonyExperimentalAdapterContractText, "typedef void (*cheng_gui_host_contract_cheng_app_set_window_fn)(uint64_t appId, uint64_t window, int width, int height, float density);"),
           "mobile shell smoke: harmony adapter contract header APP-EXPORT cheng_app_set_window typedef")
    assert(strings.StrContains(nativeHarmonyExperimentalAdapterContractText, "\"data-url\" | \"data-url-array-append\" | \"media-selection\" | \"qr-text\"."),
           "mobile shell smoke: harmony adapter contract header picker result_mode closed-set enumeration")

    # slice-8 first wave: MobileShellHarmonyGuiHostSharedHeaderText must reproduce
    # platform/harmony/ChengGuiDemo/entry/src/main/cpp/cheng_gui_host_shared.h
    # byte-for-byte (same discipline as the adapter contract header above), so the
    # declarations surface of the eventual cheng_gui_host_gen.c/cheng_gui_host_adapter.c
    # physical split (docs/harmony-host-codegen-migration-plan.md) stays honest ahead
    # of the function-body split landing in a follow-up wave.
    let nativeHarmonyExperimentalSharedHeaderPath: str = os.JoinPath(nativeHarmonyExperimentalOutDir, "harmony/entry/src/main/cpp/cheng_gui_host_shared.h")
    assert(os.FileExists(nativeHarmonyExperimentalSharedHeaderPath),
           "mobile shell smoke: harmony experimental shared header exists")
    let nativeHarmonyExperimentalSharedHeaderText: str = os.ReadFile(nativeHarmonyExperimentalSharedHeaderPath)
    let sharedHeaderRealPath: str = os.JoinPath(root, "platform/harmony/ChengGuiDemo/entry/src/main/cpp/cheng_gui_host_shared.h")
    let sharedHeaderRealText: str = os.ReadFile(sharedHeaderRealPath)
    assert(nativeHarmonyExperimentalSharedHeaderText == sharedHeaderRealText,
           "mobile shell smoke: harmony shared header byte-identical to platform/harmony/ChengGuiDemo checked-in header")
    assert(strings.StrContains(nativeHarmonyExperimentalSharedHeaderText, "#ifndef CHENG_GUI_HOST_SHARED_H"),
           "mobile shell smoke: harmony shared header include guard")
    assert(strings.StrContains(nativeHarmonyExperimentalSharedHeaderText, "#include \"cheng_gui_host_adapter_contract.h\""),
           "mobile shell smoke: harmony shared header pulls in the adapter contract header")

    let prebuiltAssetRoot: str = os.JoinPath(outDir, "prebuilt_asset_root")
    let prebuiltRuntimeRoot: str = os.JoinPath(prebuiltAssetRoot, "runtime")
    let prebuiltAppSoInput: str = os.JoinPath(prebuiltAssetRoot, "libcheng_smoke_app.so")
    let prebuiltSceneDataInput: str = os.JoinPath(prebuiltRuntimeRoot, "unimaker_scene_data.bin")
    let prebuiltGlyphSdfPixelsInput: str = os.JoinPath(prebuiltRuntimeRoot, "unimaker_glyph_sdf_pixels.bin")
    let prebuiltComputerUseManifestInput: str = os.JoinPath(prebuiltRuntimeRoot, "unimaker_computer_use_manifest.json")
    let prebuiltMediaAssetRoot: str = os.JoinPath(prebuiltRuntimeRoot, "media/assets")
