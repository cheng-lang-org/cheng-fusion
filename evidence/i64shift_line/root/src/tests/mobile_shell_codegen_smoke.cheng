    # slice-6: MobileShellHarmonyGuiHostCmakeText must reproduce
    # platform/harmony/ChengGuiDemo/entry/src/main/cpp/CMakeLists.txt byte-for-byte
    # with default opts (the three .so topology is parameterized, not re-authored).
    var guiHostCmakeOpts = mshell.MobileShellDefaultOptions(root)
    let guiHostCmakeDefaultText: str = mshell.MobileShellHarmonyGuiHostCmakeText(guiHostCmakeOpts)
    let guiHostCmakeRealPath: str = os.JoinPath(root, "platform/harmony/ChengGuiDemo/entry/src/main/cpp/CMakeLists.txt")
    let guiHostCmakeRealText: str = os.ReadFile(guiHostCmakeRealPath)
    assert(guiHostCmakeDefaultText == guiHostCmakeRealText,
           "mobile shell smoke: harmony gui-host cmake byte-identical to platform/harmony/ChengGuiDemo default")

    # mutation: harmonyGuiHostLibraryName must propagate to every target/reference
    # (main add_library/set_target_properties/target_include_directories/
    # target_link_libraries plus both isolated .so add_dependencies calls).
    guiHostCmakeOpts.harmonyGuiHostLibraryName = "cheng_gui_host_mut"
    let guiHostCmakeMutText: str = mshell.MobileShellHarmonyGuiHostCmakeText(guiHostCmakeOpts)
    assert(strings.StrContains(guiHostCmakeMutText, "add_library(cheng_gui_host_mut SHARED"),
           "mobile shell smoke: harmony gui-host cmake mutation add_library")
    assert(strings.StrContains(guiHostCmakeMutText, "set_target_properties(cheng_gui_host_mut PROPERTIES"),
           "mobile shell smoke: harmony gui-host cmake mutation set_target_properties")
    assert(strings.StrContains(guiHostCmakeMutText, "target_link_libraries(cheng_gui_host_mut PUBLIC"),
           "mobile shell smoke: harmony gui-host cmake mutation target_link_libraries")
    assert(strings.StrContains(guiHostCmakeMutText, "add_dependencies(cheng_gui_host_mut cheng_moq_harmony)"),
           "mobile shell smoke: harmony gui-host cmake mutation moq add_dependencies")
    assert(strings.StrContains(guiHostCmakeMutText, "add_dependencies(cheng_gui_host_mut cheng_feed_harmony)"),
           "mobile shell smoke: harmony gui-host cmake mutation feed add_dependencies")
    assert(!strings.StrContains(guiHostCmakeMutText, "cheng_gui_host SHARED"),
           "mobile shell smoke: harmony gui-host cmake mutation leaves no stale default library name")

    # opts-sourced prebuilt object list (ask ①) and link flags (ask ③).
    var guiHostCmakeParamOpts = mshell.MobileShellDefaultOptions(root)
    guiHostCmakeParamOpts.harmonyGuiHostPrebuiltObjects = ["scene_app_oh.o", "extra_provider.o"]
    guiHostCmakeParamOpts.harmonyGuiHostLinkFlags = "-Wl,--no-undefined"
    let guiHostCmakeParamText: str = mshell.MobileShellHarmonyGuiHostCmakeText(guiHostCmakeParamOpts)
    assert(strings.StrContains(guiHostCmakeParamText, "\"${CHENG_PREBUILT_DIR}/extra_provider.o\""),
           "mobile shell smoke: harmony gui-host cmake mutation prebuilt object list")
    assert(!strings.StrContains(guiHostCmakeParamText, "\"${CHENG_PREBUILT_DIR}/ps.o\""),
           "mobile shell smoke: harmony gui-host cmake mutation prebuilt object list replaces default")
    assert(strings.StrContains(guiHostCmakeParamText, "LINK_FLAGS \"-Wl,--no-undefined\""),
           "mobile shell smoke: harmony gui-host cmake mutation link flags")

    echo(" mobile_shell_codegen_smoke ok")
    return 0
