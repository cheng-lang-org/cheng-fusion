import std/os as os
import std/strings
import cheng/codex/std/http
import cheng/core/csg_asset/hyperliquid_source as hyper

fn probeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(): int32 =
    let response = http.HttpRequestWithTimeout("POST",
                                               hyper.HyperliquidAllMidsSourceUri,
                                               hyper.HyperliquidAllMidsRequestBody,
                                               "[\"Content-Type: application/json\"]",
                                               15)
    if !response.ok:
        if response.error.len > 0:
            return probeFail(strings.ConcatStr("hyperliquid http error: ", response.error))
        return probeFail("hyperliquid http error")
    if response.statusCode != 200:
        return probeFail(strings.ConcatStr("hyperliquid status: ", strings.IntToStr(response.statusCode)))
    if response.body.len <= 0:
        return probeFail("hyperliquid body empty")
    os.WriteLine(os.Get_stdout(), strings.ConcatStr("hyperliquid_body_len=", strings.IntToStr(response.body.len)))
    os.WriteLine(os.Get_stdout(), "vexa_hyperliquid_http_provider_probe ok")
    return 0
