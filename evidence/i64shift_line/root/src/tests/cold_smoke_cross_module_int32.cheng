import cheng/tests/cold_int32_module as m

fn main(): int32 =
    // Cross-module int32 parameter passing
    // This was unstable in cold path (findings.md line 696-740)
    let r1: int32 = m.addInts(1, 2)
    assert(r1 == 3, " cross int32: basic")

    let r2: int32 = m.checkMode(2)
    assert(r2 == 1, " cross int32: mode 2")

    let r3: int32 = m.checkMode(5)
    assert(r3 == 0, " cross int32: mode 5")

    echo(" cold_smoke_cross_module_int32 ok")
    return 0
