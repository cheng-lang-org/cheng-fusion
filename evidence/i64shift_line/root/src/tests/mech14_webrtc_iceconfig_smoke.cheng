import cheng/core/runtime/web_scene_runtime as scene
import std/strings

# Mechanism 14 (CHT_STRUCT_REF_TYPES / structBoxRefs, iceConfigRef family) — stage3 real
# compile+run KV round-trip smoke test for the hand-written WebSceneWebRtcIceConfigRecord JSON
# codec (WebSceneParseWebRtcIceConfigState / WebSceneEncodeWebRtcIceConfigState +
# WebSceneWebRtcTurnServerRecord / WebSceneWebRtcIceServerRecord nested codecs). Standalone file,
# does not touch the shared src/tests/web_scene_runtime_smoke.cheng (per CLAUDE.md §4b:6, do not
# perturb shared hot files with unrelated additions).

fn mech14CheckAbsentRoundTrip(): int32 =
    var record: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState("", record):
        echo("mech14 FAIL: empty-string parse must succeed (absent sentinel)")
        return 1
    if record.present:
        echo("mech14 FAIL: empty-string parse must decode to present=false")
        return 2
    let encoded = scene.WebSceneEncodeWebRtcIceConfigState(record)
    if encoded.len != 0:
        echo(Fmt"mech14 FAIL: absent record must encode back to empty string, got {encoded}")
        return 3
    return 0

// Builds every nested array element via a fresh LOCAL struct var + `add()` (never a direct
// `arr[i].field[j] = ...` double-indexed write) — matching EXACTLY how the production parser
// (WebSceneParseWebRtcIceServerArrayAt/WebSceneParseWebRtcTurnServerArrayAt) constructs elements
// (`var item: T; ...; add(out, item)`), and the only construction shape verified NOT to trip a
// pre-existing, out-of-scope backend gap in `arr[i].field[j] = value` two-level-indexed nested
// array-of-struct-with-array-field writes (bisected in isolation: `add(parentArr, localItem)`
// round-trips correctly; `parentArr[i].arrField[j] = v` SIGBUSes — unrelated to this mechanism's
// own codegen, never exercised by the real WebSceneParse*/WebSceneEncode* codec functions above).
fn mech14BuildFullRecord(out: var scene.WebSceneWebRtcIceConfigRecord) =
    out.present = true
    out.relayOnly = true
    setLen(out.stunUrls, 2)
    out.stunUrls[0] = "stun:stun.example.com:19302"
    out.stunUrls[1] = "stun:stun2.example.com:19302"
    setLen(out.turnServers, 0)
    var t0: scene.WebSceneWebRtcTurnServerRecord
    t0.url = "turn:turn1.example.com:3478"
    t0.username = "userA"
    t0.credential = "credA"
    add(out.turnServers, t0)
    var t1: scene.WebSceneWebRtcTurnServerRecord
    t1.url = "turn:turn2.example.com:3478"
    t1.username = "userB"
    t1.credential = "credB"
    add(out.turnServers, t1)
    setLen(out.iceServers, 0)
    var i0: scene.WebSceneWebRtcIceServerRecord
    setLen(i0.urls, 1)
    i0.urls[0] = "stun:stun.example.com:19302"
    i0.username = ""
    i0.credential = ""
    add(out.iceServers, i0)
    var i1: scene.WebSceneWebRtcIceServerRecord
    setLen(i1.urls, 2)
    i1.urls[0] = "turn:turn1.example.com:3478"
    i1.urls[1] = "turn:turn1b.example.com:3478"
    i1.username = "userA"
    i1.credential = "credA"
    add(out.iceServers, i1)
    out.expiresAtMsPresent = true
    out.expiresAtMs = int64(1752600000000)

fn mech14CheckFullRoundTrip(): int32 =
    var built: scene.WebSceneWebRtcIceConfigRecord
    mech14BuildFullRecord(built)
    let encoded = scene.WebSceneEncodeWebRtcIceConfigState(built)
    if encoded.len == 0:
        echo("mech14 FAIL: present record must not encode to empty string")
        return 10
    var decoded: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState(encoded, decoded):
        echo(Fmt"mech14 FAIL: round-trip parse failed for {encoded}")
        return 11
    if !decoded.present:
        echo("mech14 FAIL: round-tripped record must decode present=true")
        return 12
    if decoded.relayOnly != built.relayOnly:
        echo("mech14 FAIL: relayOnly mismatch")
        return 13
    if decoded.stunUrls.len != 2 || decoded.stunUrls[0] != built.stunUrls[0] || decoded.stunUrls[1] != built.stunUrls[1]:
        echo("mech14 FAIL: stunUrls mismatch")
        return 14
    if decoded.turnServers.len != 2:
        echo("mech14 FAIL: turnServers length mismatch")
        return 15
    if decoded.turnServers[0].url != built.turnServers[0].url || decoded.turnServers[0].username != built.turnServers[0].username || decoded.turnServers[0].credential != built.turnServers[0].credential:
        echo("mech14 FAIL: turnServers[0] field mismatch")
        return 16
    if decoded.turnServers[1].url != built.turnServers[1].url || decoded.turnServers[1].username != built.turnServers[1].username || decoded.turnServers[1].credential != built.turnServers[1].credential:
        echo("mech14 FAIL: turnServers[1] field mismatch")
        return 17
    if decoded.iceServers.len != 2:
        echo("mech14 FAIL: iceServers length mismatch")
        return 18
    if decoded.iceServers[0].urls.len != 1 || decoded.iceServers[0].urls[0] != built.iceServers[0].urls[0]:
        echo("mech14 FAIL: iceServers[0].urls mismatch (single-value regularization)")
        return 19
    if decoded.iceServers[0].username != "" || decoded.iceServers[0].credential != "":
        echo("mech14 FAIL: iceServers[0] optional fields must decode to empty string when absent")
        return 20
    if decoded.iceServers[1].urls.len != 2 || decoded.iceServers[1].urls[0] != built.iceServers[1].urls[0] || decoded.iceServers[1].urls[1] != built.iceServers[1].urls[1]:
        echo("mech14 FAIL: iceServers[1].urls mismatch (multi-value)")
        return 21
    if decoded.iceServers[1].username != built.iceServers[1].username || decoded.iceServers[1].credential != built.iceServers[1].credential:
        echo("mech14 FAIL: iceServers[1] optional fields mismatch")
        return 22
    if !decoded.expiresAtMsPresent:
        echo("mech14 FAIL: expiresAtMsPresent must round-trip true")
        return 23
    if decoded.expiresAtMs != built.expiresAtMs:
        echo(Fmt"mech14 FAIL: expiresAtMs mismatch, got {decoded.expiresAtMs}")
        return 24
    return 0

# expiresAtMs=0 is a real, legitimate value distinct from "field omitted" — same presence-bool
# discrimination mechanism 12 established for sdpMLineIndex. Verify 0 survives the round trip
# distinctly from expiresAtMsPresent=false (never conflated).
fn mech14CheckZeroExpiresAtMsIsNotAbsent(): int32 =
    var built: scene.WebSceneWebRtcIceConfigRecord
    mech14BuildFullRecord(built)
    built.expiresAtMsPresent = true
    built.expiresAtMs = int64(0)
    let encoded = scene.WebSceneEncodeWebRtcIceConfigState(built)
    var decoded: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState(encoded, decoded):
        echo("mech14 FAIL: round-trip parse failed for zero-expiresAtMs record")
        return 30
    if !decoded.expiresAtMsPresent:
        echo("mech14 FAIL: expiresAtMs=0 must still decode expiresAtMsPresent=true (not conflated with absent)")
        return 31
    if decoded.expiresAtMs != int64(0):
        echo("mech14 FAIL: expiresAtMs=0 must round-trip as exactly 0")
        return 32
    return 0

# Empty arrays (no STUN/TURN/ICE servers configured, still a genuinely PRESENT record — e.g. a
# relay-only config that hasn't resolved any servers yet) must round-trip losslessly, distinct
# from the whole-record-absent ("") sentinel.
fn mech14CheckEmptyArraysStillPresent(): int32 =
    var built: scene.WebSceneWebRtcIceConfigRecord
    built.present = true
    built.relayOnly = false
    setLen(built.stunUrls, 0)
    setLen(built.turnServers, 0)
    setLen(built.iceServers, 0)
    built.expiresAtMsPresent = false
    built.expiresAtMs = int64(0)
    let encoded = scene.WebSceneEncodeWebRtcIceConfigState(built)
    if encoded.len == 0:
        echo("mech14 FAIL: a present record with all-empty arrays must NOT encode to the absent sentinel")
        return 40
    var decoded: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState(encoded, decoded):
        echo(Fmt"mech14 FAIL: round-trip parse failed for empty-arrays record: {encoded}")
        return 41
    if !decoded.present || decoded.stunUrls.len != 0 || decoded.turnServers.len != 0 || decoded.iceServers.len != 0 || decoded.expiresAtMsPresent:
        echo("mech14 FAIL: empty-arrays record round-trip mismatch")
        return 42
    return 0

# Fail-fast: malformed JSON (unknown key) must be rejected, never silently coerced to a partial
# struct (mirrors every other exhaustive-key parser in web_scene_runtime.cheng).
fn mech14CheckUnknownKeyRejected(): int32 =
    var decoded: scene.WebSceneWebRtcIceConfigRecord
    let bogus = "{\"relayOnly\":false,\"stunUrls\":[],\"turnServers\":[],\"iceServers\":[],\"expiresAtMsPresent\":false,\"expiresAtMs\":0,\"bogusField\":1}"
    if scene.WebSceneParseWebRtcIceConfigState(bogus, decoded):
        echo("mech14 FAIL: unknown key must be rejected, not silently ignored")
        return 50
    return 0

fn main(): int32 =
    var status = mech14CheckAbsentRoundTrip()
    if status != 0:
        return status
    status = mech14CheckFullRoundTrip()
    if status != 0:
        return status
    status = mech14CheckZeroExpiresAtMsIsNotAbsent()
    if status != 0:
        return status
    status = mech14CheckEmptyArraysStillPresent()
    if status != 0:
        return status
    status = mech14CheckUnknownKeyRejected()
    if status != 0:
        return status
    echo("mech14 PASS")
    return 0
