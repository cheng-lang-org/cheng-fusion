fn WebSceneRuntimeSmokeSvgAtlasEncodesFilledTriangle(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "svg_triangle", 310, 1, route):
        return 9570
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 9571
    if !scene.WebSceneAddResource(graph, "svg_icon", "Play", "", "", "play-hash", 0, 0, 0):
        return 9572
    if !scene.WebSceneAddNode(graph, route, 310, 0, 2, "svg", "", 1):
        return 9573
    if !scene.WebSceneAddPaintOpAt(graph, route, 310, 0, 0, 0, scene.WebScenePaintSvgIcon, Int64(4294967295), 0, 15, 15, "Play", ""):
        return 9574
    if !scene.WebSceneAddPaintSvgTriangle(graph, route, 310, 0, 800, 500, 800, 1900, 1800, 1200):
        return 9575
    var svgAtlas: scene.WebSceneSvgDisplayListAtlas
    if !scene.WebSceneBuildSvgDisplayListAtlasFromPaintOps(graph, svgAtlas):
        return 9576
    if scene.WebSceneSvgDisplayListCount(svgAtlas) != 1:
        return 9577
    if scene.WebSceneSvgDisplayListPrimitiveCountAt(svgAtlas, 0) != 1:
        return 9578
    if scene.WebSceneSvgDisplayListPrimitiveKindAt(svgAtlas, 0, 0) != paint.PaintSvgPrimitiveTriangle:
        return 9579
    var svgEntryWords: int32[]
    var svgPrimitiveWords: int32[]
    if !scene.WebSceneEncodeSvgDisplayListHostBatch(svgAtlas, svgEntryWords, svgPrimitiveWords):
        return 9580
    if svgPrimitiveWords.len != scene.WebSceneSvgPrimitiveHostStrideI32:
        return 9581
    if svgPrimitiveWords[0] != paint.PaintSvgPrimitiveTriangle:
        return 9582
    if svgPrimitiveWords[1] != 800 || svgPrimitiveWords[2] != 500:
        return 9583
    if svgPrimitiveWords[3] != 800 || svgPrimitiveWords[4] != 1900:
        return 9584
