    if !scene.WebSceneSetStateValue(graph, "speechBusy", "false"):
        return 9511
    if !scene.WebSceneSetStateValue(graph, "speechSupported", "false"):
        return 9512
    if !scene.WebSceneSetStateValue(graph, "isAsiConversation", "false"):
        return 9513
    if !scene.WebSceneApplyEventEffect(graph, speechEffect, true):
        return 9514
    if scene.WebSceneStateValueForRef(graph, "speechHint") != "当前设备不支持录音":
        return 9515
    if !scene.WebSceneSetStateValue(graph, "speechHint", ""):
        return 9516
    if !scene.WebSceneSetStateValue(graph, "isAsiConversation", "true"):
        return 9517
    if !scene.WebSceneApplyEventEffect(graph, speechEffect, true):
        return 9518
    if scene.WebSceneStateValueForRef(graph, "speechHint") != "当前设备不支持麦克风 ASR":
        return 9519
    if !scene.WebSceneSetStateValue(graph, "speechSupported", "true"):
