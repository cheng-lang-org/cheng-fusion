# Faithful proxy of the generated __csg_scene_capture_location_for_segment writeback (see
# ts-csg/scripts/scene-runtime-smoke-source.mjs). The device/digest host RETURNS the fix string
# and the Cheng runtime does the state writeback, so this exercises the exact write sequence over
# the real scene module; `result` stands in for the host return (digest CHENG_FAKE_LOCATION →
# "ok:<lat>, <lon>", no fix → "err:<code>:<message>"). Returns 1 ok / -1 err / -2 bad refs.
fn WebSceneRuntimeSmokeApplyLocationCapture(graph: var scene.WebSceneGraph, segment: str, result: str): int32 =
    let prefix = "location_capture:"
    let mode = scene.WebSceneEffectPartAfterPrefix(segment, prefix, 0)
    let previewRef = scene.WebSceneEffectPartAfterPrefix(segment, prefix, 1)
    let statusRef = scene.WebSceneEffectPartAfterPrefix(segment, prefix, 2)
    let messageRef = scene.WebSceneEffectPartAfterPrefix(segment, prefix, 3)
    let openModalRef = scene.WebSceneEffectPartAfterPrefix(segment, prefix, 4)
    let nameRef = scene.WebSceneEffectPartAfterPrefix(segment, prefix, 5)
    if mode.len == 0 || previewRef.len == 0 || statusRef.len == 0 || messageRef.len == 0:
        return -2
    if openModalRef.len > 0:
        if !scene.WebSceneSetStateValue(graph, openModalRef, "true"):
            return -2
    if scene.WebSceneStrStartsWith(result, "ok:"):
        let label = strings.SliceBytes(result, 3, result.len - 3)
        if !scene.WebSceneSetStateValue(graph, previewRef, label):
            return -2
        if !scene.WebSceneSetStateValue(graph, statusRef, "ready"):
            return -2
        if !scene.WebSceneSetStateValue(graph, messageRef, ""):
            return -2
        if nameRef.len > 0:
            let existingName = scene.WebSceneTrimAsciiWhitespace(scene.WebSceneStateValueForRef(graph, nameRef))
            if existingName.len == 0:
                if !scene.WebSceneSetStateValue(graph, nameRef, label):
                    return -2
        return 1
    if scene.WebSceneStrStartsWith(result, "err:"):
        let code = scene.WebSceneEffectPartAfterPrefix(result, "err:", 0)
        let msg = scene.WebSceneEffectPartAfterPrefix(result, "err:", 1)
        if code.len > 0:
            if !scene.WebSceneSetStateValue(graph, statusRef, code):
                return -2
        if msg.len > 0:
            if !scene.WebSceneSetStateValue(graph, messageRef, msg):
                return -2
        return -1
    return 0

# Digest gate for the chat 定位弹窗 state→UI fix: the location_capture:chat command must land the
# GPS fix on locationPreview (the modal `{locationPreview || '等待定位'}` display source) — not on
# locationName — and fill locationName (fill-if-empty) so the send button ships the live coordinate.
fn WebSceneRuntimeSmokeChatLocationCaptureApply(): int32 =
    let segment = "location_capture:chat:locationPreview:locationFetching:locationHint:showLocationModal:locationName"

    # success, blank 备注: preview shows the coord AND name is filled with the send default.
    var g1: scene.WebSceneGraph
    scene.WebSceneGraphInit(g1)
    if WebSceneRuntimeSmokeApplyLocationCapture(g1, segment, "ok:31.230000, 121.470000") != 1:
        return 9101
    if scene.WebSceneStateValueForRef(g1, "locationPreview") != "31.230000, 121.470000":
        return 9102
    if scene.WebSceneStateValueForRef(g1, "locationName") != "31.230000, 121.470000":
        return 9103
    if scene.WebSceneStateValueForRef(g1, "showLocationModal") != "true":
        return 9104
    if scene.WebSceneStateValueForRef(g1, "locationFetching") != "ready":
        return 9105
    if scene.WebSceneStateValueForRef(g1, "locationHint") != "":
        return 9106

    # success, user-typed 备注: preview updates, the manual remark is never clobbered.
    var g2: scene.WebSceneGraph
    scene.WebSceneGraphInit(g2)
    if !scene.WebSceneSetStateValue(g2, "locationName", "我家"):
        return 9110
    if WebSceneRuntimeSmokeApplyLocationCapture(g2, segment, "ok:22.540000, 114.060000") != 1:
        return 9111
    if scene.WebSceneStateValueForRef(g2, "locationPreview") != "22.540000, 114.060000":
        return 9112
    if scene.WebSceneStateValueForRef(g2, "locationName") != "我家":
        return 9113

    # failure: preview stays blank (modal falls back to 等待定位), hint carries the CN message.
    var g3: scene.WebSceneGraph
    scene.WebSceneGraphInit(g3)
    if WebSceneRuntimeSmokeApplyLocationCapture(g3, segment, "err:unavailable:定位服务不可用，请检查 GPS 开关") != -1:
        return 9120
    if scene.WebSceneStateValueForRef(g3, "locationPreview") != "":
        return 9121
    if scene.WebSceneStateValueForRef(g3, "locationHint") != "定位服务不可用，请检查 GPS 开关":
        return 9122
    return 0

# Bazi 排盘 date inputs (`onChange={e => setYear(Number(e.target.value))}`) must lower to a
# state_delta carrying =e.target.value so the runtime treats the node as a focusable/IME text field.
# WebSceneNodeAcceptsTextInput → find_text_input_node uses exactly this predicate; the pre-fix
# generic `text_input:change` command failed it, leaving the inputs un-hittable (box_probe=0, no
# soft keyboard, adb text 不落地). Guards the materializer fix that strips the runtime-inert Number()
# cast wrapper.
fn WebSceneRuntimeSmokeBaziDateInputAcceptsTextInput(): int32 =
    var recognized: scene.WebSceneEventHandler
    recognized.eventName = "change"
    recognized.actionKind = "state_delta"
    recognized.stateRef = "year"
    recognized.effect = "set:year=e.target.value"
    if !scene.WebSceneEventHandlerAcceptsTextInput(recognized):
        return 9201

    var generic: scene.WebSceneEventHandler
    generic.eventName = "change"
    generic.actionKind = "command"
    generic.effect = "text_input:change"
    if scene.WebSceneEventHandlerAcceptsTextInput(generic):
        return 9202
    return 0

