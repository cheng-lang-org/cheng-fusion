# Per-value "selected" highlight (market category pill / message tab): a state
# CSS variant keyed on `selectedCategory === <value>` must track the selection,
# and the `__not:<value>` else rule must override a base that was baked to the
# highlighted branch once the selection moves to another item.
fn WebSceneRuntimeSmokeStateEqualityHighlightVariant(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "market", 100, 1, route):
        return 9600
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 9601
    # Base baked to the highlighted (purple) branch, modelling an initial
    # selectedCategory default that equals this pill.
    if !scene.WebSceneAddNode(graph, route, 100, 0, 2, "button", "", 1):
        return 9602
    if !scene.WebSceneAddStaticCssDeclaration(graph, route, 100, 0, "background-color", "0xFF9333EA", false):
        return 9603
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 0, "width", "80px"):
        return 9604
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 1, "height", "40px"):
        return 9605
    if !scene.WebSceneAddPaintOpAt(graph, route, 100, 0, 0, 0, scene.WebScenePaintFill, Int64(4278190080), 0, 80, 40, "", ""):
        return 9606
    if !scene.WebSceneAddCssVariantRule(graph, route, 100, 0, "bg-purple-600", "[data-csg-state-selectedCategory=\"hot\"]", "0,1,0", 100000000):
        return 9610
    if !scene.WebSceneAddCssVariantConditionFull(graph, route, 100, 0, 0, "state", "selectedCategory", "", "hot", "", ""):
        return 9611
    if !scene.WebSceneAddCssDeclaration(graph, route, 100, 0, 0, "background-color", "0xFF9333EA", false):
        return 9612
    if !scene.WebSceneAddCssVariantRule(graph, route, 100, 1, "bg-gray-100", "[data-csg-state-selectedCategory=\"__not:hot\"]", "0,1,0", 100000001):
        return 9620
    if !scene.WebSceneAddCssVariantConditionFull(graph, route, 100, 1, 0, "state", "selectedCategory", "", "__not:hot", "", ""):
        return 9621
    if !scene.WebSceneAddCssDeclaration(graph, route, 100, 1, 0, "background-color", "0xFFF3F4F6", false):
        return 9622
    if !scene.WebSceneSetActiveRouteByIndex(graph, route):
        return 9630
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 390, 844):
        return 9631
    let pillIndex = scene.WebSceneFindPaintOpIndex(graph, route, 100, 0)
    if pillIndex < 0:
        return 9632
    # selected == this pill -> highlighted (purple, from the equality rule).
    if !scene.WebSceneSetStateValue(graph, "selectedCategory", "hot"):
        return 9640
    if !scene.WebSceneApplyCssVariantRulesToPaintOps(graph, route):
        return 9641
    let colorHot = scene.WebScenePaintColorAt(graph, pillIndex)
    # selection moves away -> __not:hot rule overrides the baked purple.
    if !scene.WebSceneSetStateValue(graph, "selectedCategory", "rec"):
        return 9650
    if !scene.WebSceneApplyCssVariantRulesToPaintOps(graph, route):
        return 9651
    let colorRec = scene.WebScenePaintColorAt(graph, pillIndex)
    if colorRec == colorHot:
        return 9652
    # selection returns -> highlight restored (follows, not stuck on init).
    if !scene.WebSceneSetStateValue(graph, "selectedCategory", "hot"):
        return 9660
    if !scene.WebSceneApplyCssVariantRulesToPaintOps(graph, route):
        return 9661
    if scene.WebScenePaintColorAt(graph, pillIndex) != colorHot:
        return 9662
    return 0

fn WebSceneRuntimeSmokeResultJsonPathBinding(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "bazi", 100, 1, route):
        return 9700
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 9701
    if !scene.WebSceneAddNode(graph, route, 1, 0, 2, "div", "", 1):
        return 9702
    # Text nodes bound to dotted refs whose flat key holds a JSON object.
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 2, 1, 3, "", "", 1, "", "", "result.dayGan") != 0:
        return 9703
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 3, 1, 3, "", "", 1, "", "", "result.shiShen.yearGan") != 0:
        return 9704
    let dayGanPaintIndex = scene.WebScenePaintCount(graph)
    if !scene.WebSceneAddPaintOpAt(graph, route, 2, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", ""):
        return 9705
    let yearGanPaintIndex = scene.WebScenePaintCount(graph)
    if !scene.WebSceneAddPaintOpAt(graph, route, 3, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", ""):
        return 9706
    if !scene.WebSceneSetStateValue(graph, "year", "1990"):
        return 9707
    if !scene.WebSceneSetStateValue(graph, "month", "1"):
        return 9708
    if !scene.WebSceneSetStateValue(graph, "day", "1"):
        return 9709
    if !scene.WebSceneSetStateValue(graph, "hour", "0"):
        return 9710
    if !scene.WebSceneSetStateValue(graph, "minute", "0"):
        return 9711
    if !scene.WebSceneSetStateValue(graph, "gender", "男"):
        return 9712
    if !scene.WebSceneSetStateValue(graph, "timezone", "Asia/Shanghai"):
        return 9713
    if !scene.WebSceneSetStateValue(graph, "longitude", "116.4"):
        return 9714
    if !scene.WebSceneSetStateValue(graph, "useTrueSolarTime", "false"):
        return 9715
    if !scene.WebSceneSetStateValue(graph, "lateZiBoundary", "00:00"):
        return 9716
    let effect = "bazi_calculate:result:activeDayunIdx:year:month:day:hour:minute:gender:timezone:longitude:useTrueSolarTime:lateZiBoundary:2024"
    if !scene.WebSceneApplyEventEffect(graph, effect, true):
        return 9717
    # The whole 3KB JSON lands in the single flat `result` key.
    let resultJson = scene.WebSceneStateValueForRef(graph, "result")
    if resultJson.len == 0:
        return 9718
    # Expected leaf values pulled straight from the JSON payload (no hardcoding).
    var expectedDayGan: str
    if !scene.WebSceneJsonObjectStringField(resultJson, "dayGan", expectedDayGan):
        return 9719
    if expectedDayGan.len == 0:
        return 9720
    # JSON-path read resolves the dotted ref against the flat object (pull path).
    if scene.WebSceneStateValueForRef(graph, "result.dayGan") != expectedDayGan:
        return 9721
    # Two-level descent: result.shiShen.yearGan.
    var shiShenJson: str
    if !scene.WebSceneJsonObjectFieldRawValue(resultJson, "shiShen", shiShenJson):
        return 9722
    var expectedYearGan: str
    if !scene.WebSceneJsonObjectStringField(shiShenJson, "yearGan", expectedYearGan):
        return 9723
    if scene.WebSceneStateValueForRef(graph, "result.shiShen.yearGan") != expectedYearGan:
        return 9724
    # The effect write refreshed the bound text paint ops (push path).
    if scene.WebScenePaintTextAt(graph, dayGanPaintIndex) != expectedDayGan:
        return 9725
    if scene.WebScenePaintTextAt(graph, yearGanPaintIndex) != expectedYearGan:
        return 9726
    # A fresh JSON write re-refreshes the prefix-bound text.
    if !scene.WebSceneSetStateValue(graph, "result", "{\"dayGan\":\"戊\",\"shiShen\":{\"yearGan\":\"比肩\"}}"):
        return 9727
    if scene.WebSceneStateValueForRef(graph, "result.dayGan") != "戊":
        return 9728
    if scene.WebScenePaintTextAt(graph, dayGanPaintIndex) != "戊":
        return 9729
    if scene.WebScenePaintTextAt(graph, yearGanPaintIndex) != "比肩":
        return 9730
    # Exact flat key always wins over the JSON-path fallback.
    if !scene.WebSceneSetStateValue(graph, "result.dayGan", "OVERRIDE"):
        return 9731
    if scene.WebSceneStateValueForRef(graph, "result.dayGan") != "OVERRIDE":
        return 9732
    # Non-JSON head value -> path miss returns empty.
    if !scene.WebSceneSetStateValue(graph, "plain", "hello"):
        return 9733
    if scene.WebSceneStateValueForRef(graph, "plain.x") != "":
        return 9734
    # Missing head key -> empty.
    if scene.WebSceneStateValueForRef(graph, "nope.field") != "":
        return 9735
    # Present object but missing field -> empty.
    if scene.WebSceneStateValueForRef(graph, "result.doesNotExist") != "":
        return 9736
    return 0

fn main(): int32 =
    var status = WebSceneRuntimeSmokeRouteExpectedIndex()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeResourceTableIndexedSetters()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeSpacingShorthand()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeAxisOverflow()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeMasonryLayoutConstraints()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeVirtualizedMasonryModelConstraint()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeFlexInlineTextPaintBox()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeDisplayNonePaintIsNotRendered()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeEmptyLayerIsNotCachedOrMoved()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeInlineAbsolutePaintHasLayout()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeTruncateTextMaterializesVisibleRun()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokePlainCjkTextKeepsFullRun()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeNowrapTextUsesSingleLineLayout()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeNestedTextDoesNotInheritOuterEllipsis()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeDuplicateLayoutBoxSelectsFirstFlowBox()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeDuplicateLayoutBoxHitTestMatchesPaintBox()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeTextReflowExpiresStaleLineBoxes()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeAbsoluteChildDoesNotSetParentHeight()
    if status != 0:
        echo(Fmt"web_scene_runtime_smoke status={status}")
        return status
    status = WebSceneRuntimeSmokeInlineFlexStaysInTextLine()
    if status != 0:
