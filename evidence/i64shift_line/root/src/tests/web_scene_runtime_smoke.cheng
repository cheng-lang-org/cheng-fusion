    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 5231
    if !scene.WebSceneAddNode(graph, route, 1, 0, 2, "div", "", 1):
        return 5232
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 2, 1, 2, "div", "", 1, "visibleLocationAddress", "__truthy", "") != 0:
        return 5233
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 3, 2, 3, "", "", 1, "", "", "visibleLocationAddress") != 0:
        return 5234
    if !scene.WebSceneAddLayoutConstraint(graph, route, 1, 0, "width", "160px"):
