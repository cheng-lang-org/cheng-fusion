fn WebSceneRuntimeSmokeDuplicateLayoutBoxSelectsFirstFlowBox(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)
    if !layout.WebLayoutTreeAddStyle(tree, 3401, layout.WebLayoutDisplayBlock, 0, 0, 0, 0):
        return 1564
    if !layout.WebLayoutTreeAddStyle(tree, 3402, layout.WebLayoutDisplayBlock, 0, 0, 0, 0):
        return 1567
    layout.WebLayoutRecordBox(tree, 3401, 16, 121, 326, 20)
    layout.WebLayoutRecordBox(tree, 3402, 0, 0, 1, 1)
    layout.WebLayoutRecordBox(tree, 3401, 16, 80, 326, 20)
    let boxIndex = scene.WebSceneFindLayoutBoxIndex(tree, 3401)
    if boxIndex < 0:
        return 1565
    if layout.WebLayoutBoxYAt(tree, boxIndex) != 121:
        return 1566
    return 0

# Same duplicate-box tree as WebSceneRuntimeSmokeDuplicateLayoutBoxSelectsFirstFlowBox
# above, but this time checks the hit-test box list (graph.layoutBoxes), which is
# built by WebSceneRefreshRouteLayoutBoxes from the same tree. Before the fix, the
# stale box (y=80, never painted) was independently hit-testable alongside the
# real one (y=121) -- a tap landing in the stale box's rect would register a hit
# at a position paint never drew anything at. Must read y=121 exclusively,
# matching the paint-side assertion above.
fn WebSceneRuntimeSmokeDuplicateLayoutBoxHitTestMatchesPaintBox(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)
    if !layout.WebLayoutTreeAddStyle(tree, 3401, layout.WebLayoutDisplayBlock, 0, 0, 0, 0):
        return 89600
    if !layout.WebLayoutTreeAddStyle(tree, 3402, layout.WebLayoutDisplayBlock, 0, 0, 0, 0):
        return 89601
    layout.WebLayoutRecordBox(tree, 3401, 16, 121, 326, 20)
    layout.WebLayoutRecordBox(tree, 3402, 0, 0, 1, 1)
    layout.WebLayoutRecordBox(tree, 3401, 16, 80, 326, 20)
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "dup_hit", 3401, 1, route):
        return 89602
    if !scene.WebSceneRefreshRouteLayoutBoxes(graph, route, tree):
        return 89603
    var duplicateCount = 0
    for i in 0..<graph.layoutBoxes.len:
        if graph.layoutBoxes[i].nodeId == 3401:
            duplicateCount = duplicateCount + 1
            if graph.layoutBoxes[i].y != 121:
                return 89604
    if duplicateCount != 1:
        return 89605
    return 0

# Text-reflow expiry guard: a wrapped-text node's fragment run from an earlier
# layout pass must not coexist with its fragment run from a later pass on the
# same node. Pass 1 records 2 line fragments for nodeId 5501 (y=0, y=20), then
# an unrelated node's box is recorded in between (simulating other layout work
# between passes), then pass 2 (a reflow, e.g. after a width/content change)
# records 3 fresh line fragments for the SAME nodeId (y=100, y=120, y=140).
# graph.layoutBoxes must show exactly the pass-2 fragments (3, not 5) --
# keeping the old pass's fragments around as phantom hit-test targets would be
# the exact same class of bug as the block-node duplicate case above, just for
# inline/text nodes instead.
fn WebSceneRuntimeSmokeTextReflowExpiresStaleLineBoxes(): int32 =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)
    if !layout.WebLayoutTreeAddStyle(tree, 5501, layout.WebLayoutDisplayInline, 0, 0, 0, 0):
        return 89610
    if !layout.WebLayoutTreeAddStyle(tree, 5502, layout.WebLayoutDisplayBlock, 0, 0, 0, 0):
        return 89611
    # Pass 1: two wrapped-text line fragments.
    layout.WebLayoutRecordBox(tree, 5501, 0, 0, 50, 20)
    layout.WebLayoutRecordBox(tree, 5501, 0, 20, 30, 20)
    # Unrelated node's box recorded in between the two passes.
    layout.WebLayoutRecordBox(tree, 5502, 0, 40, 100, 10)
    # Pass 2 (reflow): three fresh wrapped-text line fragments for the same node.
    layout.WebLayoutRecordBox(tree, 5501, 0, 100, 40, 20)
    layout.WebLayoutRecordBox(tree, 5501, 0, 120, 45, 20)
    layout.WebLayoutRecordBox(tree, 5501, 0, 140, 15, 20)
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "reflow_hit", 5501, 1, route):
        return 89612
    if !scene.WebSceneRefreshRouteLayoutBoxes(graph, route, tree):
        return 89613
    var count = 0
    var sawStaleLine1 = false
    var sawStaleLine2 = false
    var sawFreshY100 = false
    var sawFreshY120 = false
    var sawFreshY140 = false
    for i in 0..<graph.layoutBoxes.len:
        if graph.layoutBoxes[i].nodeId == 5501:
            count = count + 1
            if graph.layoutBoxes[i].y == 0:
                sawStaleLine1 = true
            if graph.layoutBoxes[i].y == 20:
                sawStaleLine2 = true
            if graph.layoutBoxes[i].y == 100:
                sawFreshY100 = true
            if graph.layoutBoxes[i].y == 120:
                sawFreshY120 = true
            if graph.layoutBoxes[i].y == 140:
                sawFreshY140 = true
    if sawStaleLine1 || sawStaleLine2:
        echo("REGRESSION: stale pre-reflow line box still hit-testable")
        return 89614
    if !sawFreshY100 || !sawFreshY120 || !sawFreshY140:
        echo("REGRESSION: post-reflow line box missing from hit-test list")
        return 89615
    if count != 3:
        echo(Fmt"reflow line-box count actual {count}")
        return 89616
    return 0

