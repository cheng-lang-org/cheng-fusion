    if scene_csg.WebSceneAgentMediaEventStreamNextCursor(agentFullStream) != 9:
        return 2619
    if scene_csg.WebSceneAgentMediaEventResultStateCodeAt(agentFullStream, 8) != scene.WebSceneMediaPlaybackPublished:
        return 2620
    return 0

