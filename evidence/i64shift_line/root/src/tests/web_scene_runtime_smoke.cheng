    if !scene.WebSceneAddNode(graph, route, 101, 100, 2, "article", "", 1):
        return 7704
    if !scene.WebSceneAddNode(graph, route, 102, 100, 2, "article", "", 1):
        return 7705
    if !scene.WebSceneAddNode(graph, route, 103, 100, 2, "article", "", 1):
        return 7706
    if !scene.WebSceneAddNode(graph, route, 104, 100, 2, "article", "", 1):
        return 7707
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 0, "display", "masonry"):
        return 7708
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 1, "width", "100px"):
        return 7709
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 2, "gap", "10px"):
        return 7710
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 3, "data-csg-masonry-min-column-width", "40"):
        return 7711
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 4, "data-csg-masonry-min-columns", "2"):
        return 7712
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 5, "data-csg-masonry-max-columns", "3"):
        return 7713
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 6, "data-csg-masonry-estimated-item-height", "200"):
        return 7714
    if !scene.WebSceneAddLayoutConstraint(graph, route, 101, 0, "height", "50px"):
        return 7715
    if !scene.WebSceneAddLayoutConstraint(graph, route, 102, 0, "height", "20px"):
        return 7716
    if !scene.WebSceneAddLayoutConstraint(graph, route, 103, 0, "height", "30px"):
        return 7717
    if !scene.WebSceneAddLayoutConstraint(graph, route, 104, 0, "height", "10px"):
        return 7718
    var tree: layout.WebLayoutTree
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 100, 100, tree):
        echo(Fmt"masonry scene fail code={scene.WebSceneLastLayoutFailCode()} node={scene.WebSceneLastLayoutFailNodeId()} ordinal={scene.WebSceneLastLayoutFailOrdinal()}")
        return 7719
    let rootStyle = layout.WebLayoutFindStyleIndex(tree, 100)
    if rootStyle < 0:
        return 7720
    if tree.styles[rootStyle].display != layout.WebLayoutDisplayMasonry:
        return 7721
    if tree.styles[rootStyle].masonryMinColumnWidth != 40:
        return 7722
    if tree.styles[rootStyle].masonryMinColumns != 2:
        return 7723
    if tree.styles[rootStyle].masonryMaxColumns != 3:
        return 7724
    if tree.styles[rootStyle].masonryEstimatedItemHeight != 200:
        return 7725
    let rootBox = scene.WebSceneFindLayoutBoxIndex(tree, 100)
    let firstBox = scene.WebSceneFindLayoutBoxIndex(tree, 101)
    let secondBox = scene.WebSceneFindLayoutBoxIndex(tree, 102)
    let thirdBox = scene.WebSceneFindLayoutBoxIndex(tree, 103)
    let fourthBox = scene.WebSceneFindLayoutBoxIndex(tree, 104)
    if rootBox < 0 || firstBox < 0 || secondBox < 0 || thirdBox < 0 || fourthBox < 0:
        return 7726
    if layout.WebLayoutBoxXAt(tree, firstBox) != 0 || layout.WebLayoutBoxYAt(tree, firstBox) != 0:
        return 7727
    if layout.WebLayoutBoxXAt(tree, secondBox) != 55 || layout.WebLayoutBoxYAt(tree, secondBox) != 0:
        return 7728
    if layout.WebLayoutBoxXAt(tree, thirdBox) != 55 || layout.WebLayoutBoxYAt(tree, thirdBox) != 30:
        return 7729
    if layout.WebLayoutBoxXAt(tree, fourthBox) != 0 || layout.WebLayoutBoxYAt(tree, fourthBox) != 60:
        return 7730
    if layout.WebLayoutBoxHeightAt(tree, rootBox) != 70:
        echo(Fmt"masonry scene rootH={layout.WebLayoutBoxHeightAt(tree, rootBox)}")
        return 7731
    return 0

