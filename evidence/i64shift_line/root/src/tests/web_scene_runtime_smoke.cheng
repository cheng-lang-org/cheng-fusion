        return 96
    if !scene.WebSceneAddNode(graph, messages, 20, 0, 2, "div", "", 2):
        return 9
    if !scene.WebSceneAddNode(graph, messages, 21, 20, 3, "#text", "aa", 2):
        return 10
    if scene.WebSceneAddNode(graph, messages, 21, 20, 3, "#text", "重复", 2):
        return 11
    if scene.WebSceneNodeCount(graph) != 6:
        return 12
    if scene.WebSceneAddNode(graph, home, 99, 999, 2, "div", "", 1):
        return 72
    if scene.WebSceneAddNode(graph, home, 99, 0, 2, "div", "", 999):
        return 73

    if !scene.WebSceneAddLayoutConstraint(graph, home, 10, 0, "display", "flex"):
        return 44
    if !scene.WebSceneAddLayoutConstraint(graph, home, 10, 1, "padding-left", "16px"):
        return 45
    if scene.WebSceneAddLayoutConstraint(graph, home, 10, 1, "padding-right", "16px"):
        return 46
    if scene.WebSceneAddLayoutConstraint(graph, messages, 10, 2, "display", "block"):
        return 47
    if scene.WebSceneLayoutCount(graph) != 2:
        return 48
    if scene.WebSceneNodeLayoutCount(graph, home, 10) != 2:
        return 49
    if scene.WebSceneLayoutNodeAt(graph, 1) != 10:
        return 50
    if scene.WebSceneLayoutPropNameAt(graph, 1) != "padding-left":
        return 51
    if scene.WebSceneLayoutPropValueAt(graph, 1) != "16px":
        return 52
    return 0

fn WebSceneRuntimeSmokeSpacingShorthand(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "spacing", 100, 1, route):
        return 400
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 401
    if !scene.WebSceneAddNode(graph, route, 100, 0, 2, "div", "", 1):
        return 402
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 0, "padding", "8px 12px"):
        return 403
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 1, "margin", "1px 2px 3px"):
        return 404
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 2, "border-width", "4px 5px 6px 7px"):
        return 405
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 3, "margin-right", "-8px"):
        return 411
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 4, "min-height", "100%"):
        return 412
    var tree: layout.WebLayoutTree
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 120, 80, tree):
        return 406
    let styleIndex = layout.WebLayoutFindStyleIndex(tree, 100)
    if styleIndex < 0:
        return 407
    if tree.styles[styleIndex].paddingTop != 8 || tree.styles[styleIndex].paddingRight != 12 ||
       tree.styles[styleIndex].paddingBottom != 8 || tree.styles[styleIndex].paddingLeft != 12:
        return 408
    if tree.styles[styleIndex].marginTop != 1 || tree.styles[styleIndex].marginRight != -8 ||
       tree.styles[styleIndex].marginBottom != 3 || tree.styles[styleIndex].marginLeft != 2:
        return 409
    if tree.styles[styleIndex].borderTopWidth != 4 || tree.styles[styleIndex].borderRightWidth != 5 ||
       tree.styles[styleIndex].borderBottomWidth != 6 || tree.styles[styleIndex].borderLeftWidth != 7:
        return 410
    if tree.styles[styleIndex].minHeight != 80:
        return 413
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 5, "padding", "1px 2px 3px 4px"):
        return 414
    if !scene.WebSceneAddLayoutConstraint(graph, route, 100, 6, "margin", "1px 2px 3px 4px 5px"):
        return 415
    if scene.WebSceneBuildRouteLayoutTree(graph, route, 120, 80, tree):
        return 416
    if scene.WebSceneLastLayoutFailCode() != 106 || scene.WebSceneLastLayoutFailOrdinal() != 6:
        return 417
    return 0

fn WebSceneRuntimeSmokeAxisOverflow(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "axis_overflow", 200, 1, route):
        return 505
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 506
    if !scene.WebSceneAddNode(graph, route, 200, 0, 2, "div", "", 1):
        return 507
    if !scene.WebSceneAddNode(graph, route, 201, 200, 2, "div", "", 1):
        return 508
    if !scene.WebSceneAddLayoutConstraint(graph, route, 200, 0, "width", "100px"):
        return 509
    if !scene.WebSceneAddLayoutConstraint(graph, route, 200, 1, "height", "80px"):
        return 510
    if !scene.WebSceneAddLayoutConstraint(graph, route, 200, 2, "overflow-x", "hidden"):
        return 511
    if !scene.WebSceneAddLayoutConstraint(graph, route, 200, 3, "overflow-y", "auto"):
        return 512
    if !scene.WebSceneAddLayoutConstraint(graph, route, 201, 0, "width", "50px"):
        return 513
    if !scene.WebSceneAddLayoutConstraint(graph, route, 201, 1, "height", "20px"):
        return 514
    if !scene.WebSceneAddLayoutConstraint(graph, route, 201, 2, "overflow-x", "visible"):
        return 515
    if !scene.WebSceneAddLayoutConstraint(graph, route, 201, 3, "overflow-y", "auto"):
        return 516
    var tree: layout.WebLayoutTree
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 120, 90, tree):
        return 517
    let rootStyle = layout.WebLayoutFindStyleIndex(tree, 200)
    let childStyle = layout.WebLayoutFindStyleIndex(tree, 201)
    if rootStyle < 0 || childStyle < 0:
        return 518
    if tree.styles[rootStyle].overflowX != layout.WebLayoutOverflowHidden ||
       tree.styles[rootStyle].overflowY != layout.WebLayoutOverflowAuto:
        return 519
    if tree.styles[childStyle].overflowX != layout.WebLayoutOverflowVisible ||
       tree.styles[childStyle].overflowY != layout.WebLayoutOverflowAuto:
        return 520
    let rootBox = scene.WebSceneFindLayoutBoxIndex(tree, 200)
    let childBox = scene.WebSceneFindLayoutBoxIndex(tree, 201)
    if rootBox < 0 || childBox < 0:
        return 521
    if !tree.boxes[rootBox].clipContent:
        return 522
    if !tree.boxes[childBox].clipContent:
        return 523
    return 0

fn WebSceneRuntimeSmokeMasonryLayoutConstraints(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "masonry_home", 99, 1, route):
        return 7701
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
