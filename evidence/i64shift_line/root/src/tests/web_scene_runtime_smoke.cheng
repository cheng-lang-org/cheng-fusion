    if scene.WebSceneMediaSlotPlaybackState(graph, "truth.audio.slot.0.3") != scene.WebSceneMediaPlaybackPublished:
        return 2567
    receiptStatus = WebSceneRuntimeSmokeExpectMediaReceipt(graph,
                                                          17,
