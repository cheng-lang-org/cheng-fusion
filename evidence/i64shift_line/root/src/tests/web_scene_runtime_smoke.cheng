    var hostGpuBatch: int32[]
    if !scene.WebSceneEncodeGpuCommandHostBatch(atlasGpu, hostGpuBatch):
        return 234
    if hostGpuBatch.len != scene.WebSceneGpuCommandCount(atlasGpu) * scene.WebSceneGpuHostBatchStrideI32:
        return 235
    if hostGpuBatch[0] != scene.WebSceneGpuFillRect:
