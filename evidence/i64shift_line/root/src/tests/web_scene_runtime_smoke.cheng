    if scene.WebSceneMediaSlotPlaybackState(graph, "dom.intent.slot.0.3") != scene.WebSceneMediaPlaybackOpened:
        return 8788
    if scene.WebSceneDirtyCount(graph) != 1:
        return 8789
    return 0

fn WebSceneRuntimeSmokeProfileAddressGeneratedNodeCount(graph: var scene.WebSceneGraph): int32 =
    var count: int32
    for i in 0..<graph.props.len:
        if graph.props[i].propName == "data-csg-profile-address-generated-container":
            count = count + 1
    return count

fn WebSceneRuntimeSmokeProfileAddressHasText(graph: var scene.WebSceneGraph, value: str): bool =
    for i in 0..<graph.paintOps.len:
        if graph.paintOps[i].textContent == value:
            return true
    return false

fn WebSceneRuntimeSmokeProfileAddressHasEffect(graph: var scene.WebSceneGraph, value: str): bool =
    for i in 0..<graph.eventHandlers.len:
        if graph.eventHandlers[i].effect == value:
            return true
    return false

fn WebSceneRuntimeSmokeProfileAddressListRepeat(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var profile: int32
    if !scene.WebSceneAddRoute(graph, "tab_profile", 1, 1, profile):
        return 8780
    if !scene.WebSceneAddLayer(graph, profile, 1, "content", 0):
        return 8781
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, profile, 1, 0, 2, "div", "", 1, "", "", "") != 0:
        return 8782
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, profile, 2, 1, 2, "div", "", 1, "showAddresses", "true", "") != 0:
        return 8783
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, profile, 3, 2, 2, "div", "", 1, "", "", "") != 0:
        return 8784
    if !scene.WebSceneAddPropKnownLoadedNode(graph, profile, 3, 0, "data-csg-profile-address-list-ref", "addresses", "string"):
        return 8785
    if !scene.WebSceneAddPropKnownLoadedNode(graph, profile, 3, 1, "data-csg-profile-address-storage-key", "profile_addresses_v2", "string"):
        return 8786
    if !scene.WebSceneSetActiveRouteById(graph, "tab_profile"):
        return 8787
    if !scene.WebSceneSetStateValue(graph, "showAddresses", "true"):
        return 8788
    let emptyGenerated = WebSceneRuntimeSmokeProfileAddressGeneratedNodeCount(graph)
    if emptyGenerated <= 0:
        return 8789
    if !WebSceneRuntimeSmokeProfileAddressHasText(graph, "暂无收货地址"):
        return 8790
    let hydratedJson = "[{\"id\":\"addr_1\",\"receiver\":\"Alice\",\"phone\":\"111\",\"region\":\"CN\",\"detail\":\"Road 1\",\"tag\":\"家\",\"isDefault\":true}]"
    if !scene.WebSceneSetStorageValue(graph, "profile_addresses_v2", hydratedJson):
        return 8791
    if scene.WebSceneHydrateProfileAddressStorageBindings(graph, true) != 1:
        return 8792
    if scene.WebSceneStateValueForRef(graph, "addresses") != hydratedJson:
        return 8793
    if scene.WebSceneStorageDirtyCount(graph) != 0:
        return 8794
    let addressJson = "[{\"id\":\"addr_1\",\"receiver\":\"Alice\",\"phone\":\"111\",\"region\":\"CN\",\"detail\":\"Road 1\",\"tag\":\"家\",\"isDefault\":true},{\"id\":\"addr_2\",\"receiver\":\"Bob\",\"phone\":\"222\",\"region\":\"US\",\"detail\":\"Road 2\",\"tag\":\"公司\",\"isDefault\":false}]"
    if !scene.WebSceneSetStateValue(graph, "addresses", addressJson):
        return 8795
    let cardGenerated = WebSceneRuntimeSmokeProfileAddressGeneratedNodeCount(graph)
    if cardGenerated <= emptyGenerated:
        return 8796
    if !WebSceneRuntimeSmokeProfileAddressHasText(graph, "Alice  111  默认"):
        return 8797
    if !WebSceneRuntimeSmokeProfileAddressHasText(graph, "[公司] US Road 2"):
        return 8798
    if !WebSceneRuntimeSmokeProfileAddressHasEffect(graph, "profile_address_set_default:addresses:addr_2:profile_addresses_v2"):
        return 8799
    if !WebSceneRuntimeSmokeProfileAddressHasEffect(graph, "profile_address_delete:addresses:addr_1:profile_addresses_v2"):
        return 8800
    if !scene.WebSceneApplyEventEffect(graph, "profile_address_set_default:addresses:addr_2:profile_addresses_v2", true):
        return 8801
    let defaultJson = "[{\"id\":\"addr_1\",\"receiver\":\"Alice\",\"phone\":\"111\",\"region\":\"CN\",\"detail\":\"Road 1\",\"tag\":\"家\",\"isDefault\":false},{\"id\":\"addr_2\",\"receiver\":\"Bob\",\"phone\":\"222\",\"region\":\"US\",\"detail\":\"Road 2\",\"tag\":\"公司\",\"isDefault\":true}]"
    if scene.WebSceneStateValueForRef(graph, "addresses") != defaultJson:
        return 8802
    if scene.WebSceneStorageValueForKey(graph, "profile_addresses_v2") != defaultJson:
        return 8803
    if scene.WebSceneStorageDirtyCount(graph) != 1:
        return 8804
    if scene.WebSceneStorageDirtyKeyAt(graph, 0) != "profile_addresses_v2":
        return 8805
    if scene.WebSceneStorageDirtyValueAt(graph, 0) != defaultJson:
        return 8806
    if !scene.WebSceneApplyEventEffect(graph, "profile_address_delete:addresses:addr_2:profile_addresses_v2", true):
        return 8807
    let deleteJson = "[{\"id\":\"addr_1\",\"receiver\":\"Alice\",\"phone\":\"111\",\"region\":\"CN\",\"detail\":\"Road 1\",\"tag\":\"家\",\"isDefault\":true}]"
    if scene.WebSceneStateValueForRef(graph, "addresses") != deleteJson:
        return 8808
    if scene.WebSceneStorageValueForKey(graph, "profile_addresses_v2") != deleteJson:
        return 8809
    if !scene.WebSceneSetStateValue(graph, "addressDraft.receiver", "Cara"):
        return 8810
    if !scene.WebSceneSetStateValue(graph, "addressDraft.phone", "333"):
        return 8811
    if !scene.WebSceneSetStateValue(graph, "addressDraft.region", "JP"):
        return 8812
    if !scene.WebSceneSetStateValue(graph, "addressDraft.detail", "Road 3"):
        return 8813
    if !scene.WebSceneSetStateValue(graph, "addressDraft.tag", "朋友"):
        return 8814
    if !scene.WebSceneSetStateValue(graph, "addressDraft.isDefault", "false"):
        return 8815
    if !scene.WebSceneSetStateValue(graph, "editingAddressId", "false"):
        return 8816
    if !scene.WebSceneApplyEventEffect(graph, "profile_address_save:addresses:addressDraft:editingAddressId:showAddressEditor:addressError:请完整填写收货信息:profile_addresses_v2", true):
        return 8817
    let saveJson = "[{\"id\":\"addr_1\",\"receiver\":\"Alice\",\"phone\":\"111\",\"region\":\"CN\",\"detail\":\"Road 1\",\"tag\":\"家\",\"isDefault\":true},{\"id\":\"addr_2\",\"receiver\":\"Cara\",\"phone\":\"333\",\"region\":\"JP\",\"detail\":\"Road 3\",\"tag\":\"朋友\",\"isDefault\":false}]"
    if scene.WebSceneStateValueForRef(graph, "addresses") != saveJson:
        return 8818
    if scene.WebSceneStorageValueForKey(graph, "profile_addresses_v2") != saveJson:
        return 8819
    if scene.WebSceneStateValueForRef(graph, "addressDraft.receiver") != "":
        return 8820
    if scene.WebSceneStateValueForRef(graph, "showAddressEditor") != "false":
        return 8821
    if !scene.WebSceneApplyEventEffect(graph, "profile_address_edit:addresses:addressDraft:editingAddressId:showAddressEditor:addressError:addr_1", true):
        return 8822
    if scene.WebSceneStateValueForRef(graph, "editingAddressId") != "addr_1":
        return 8823
    if scene.WebSceneStateValueForRef(graph, "addressDraft.receiver") != "Alice":
        return 8824
    if scene.WebSceneStateValueForRef(graph, "addressDraft.tag") != "家":
        return 8825
    if scene.WebSceneStateValueForRef(graph, "showAddressEditor") != "true":
        return 8826
    return 0

fn WebSceneRuntimeSmokeChatRedPacketSendEffect(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneSetStateValue(graph, "messages", "[]"):
        return 8830
    if !scene.WebSceneSetStateValue(graph, "redPacketAmount", "12.3"):
        return 8831
    if !scene.WebSceneSetStateValue(graph, "redPacketMessage", "  生日快乐  "):
        return 8832
    if !scene.WebSceneSetStateValue(graph, "showRedPacketModal", "true"):
        return 8833
    if !scene.WebSceneSetStateValue(graph, "showMorePanel", "true"):
        return 8834
    let effect = "chat_red_packet_send:messages:redPacketAmount:redPacketMessage:showRedPacketModal:showMorePanel:恭喜发财，大吉大利"
    if !scene.WebSceneApplyEventEffect(graph, effect, true):
        return 8835
    let messages = scene.WebSceneStateValueForRef(graph, "messages")
    if !strings.StrContains(messages, "\"type\":\"redPacket\""):
        return 8836
    if !strings.StrContains(messages, "\"content\":\"生日快乐\""):
        return 8837
    if !strings.StrContains(messages, "\"redPacketAmount\":12.30"):
        return 8838
    if !strings.StrContains(messages, "\"redPacketMessage\":\"生日快乐\""):
        return 8839
    if !strings.StrContains(messages, "\"status\":\"pending\""):
        return 8840
    if scene.WebSceneStateValueForRef(graph, "redPacketAmount") != "":
        return 8841
    if scene.WebSceneStateValueForRef(graph, "redPacketMessage") != "恭喜发财，大吉大利":
        return 8842
    if scene.WebSceneStateValueForRef(graph, "showRedPacketModal") != "false":
        return 8843
    if scene.WebSceneStateValueForRef(graph, "showMorePanel") != "false":
        return 8844
    if scene.WebSceneStateValueForRef(graph, "messages.__nextId") != "2":
        return 8845

    if !scene.WebSceneSetStateValue(graph, "messages", "[]"):
        return 8846
    if !scene.WebSceneSetStateValue(graph, "redPacketAmount", "0"):
        return 8847
    if !scene.WebSceneSetStateValue(graph, "redPacketMessage", "不会发送"):
        return 8848
    if !scene.WebSceneSetStateValue(graph, "showRedPacketModal", "true"):
        return 8849
