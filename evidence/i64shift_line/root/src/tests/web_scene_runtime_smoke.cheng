fn WebSceneRuntimeSmokeExpectMediaReceipt(graph: var scene.WebSceneGraph,
                                          index: int32,
                                          actionKind: str,
                                          assetCid: str,
                                          kindCode: int32,
                                          playbackState: int32,
                                          trace: str,
                                          failCode: int32): int32 =
    if scene.WebSceneMediaReceiptActionKindAt(graph, index) != actionKind:
        return failCode
    if scene.WebSceneMediaReceiptActionKindCodeAt(graph, index) != scene.WebSceneMediaActionKindCode(actionKind):
        return failCode + 1
    if scene.WebSceneMediaReceiptStatusCodeAt(graph, index) != scene.WebSceneMediaReceiptOk:
        return failCode + 2
    if scene.WebSceneMediaReceiptPlaybackStateAt(graph, index) != playbackState:
        return failCode + 3
    if scene.WebSceneMediaReceiptAssetCidAt(graph, index) != assetCid:
        return failCode + 4
    if scene.WebSceneMediaReceiptKindCodeAt(graph, index) != kindCode:
        return failCode + 5
    if scene.WebSceneMediaReceiptTraceAt(graph, index) != trace:
        return failCode + 6
    return 0

