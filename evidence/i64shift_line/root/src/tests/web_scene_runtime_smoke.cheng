        return 7791
    let firstBox = scene.WebSceneFindLayoutBoxIndex(tree, 122)
    let secondBox = scene.WebSceneFindLayoutBoxIndex(tree, 123)
    if firstBox < 0 || secondBox < 0:
        return 7792
    if layout.WebLayoutBoxXAt(tree, firstBox) != 8 || layout.WebLayoutBoxWidthAt(tree, firstBox) != 179:
        echo(Fmt"virtualized masonry scene first x={layout.WebLayoutBoxXAt(tree, firstBox)} w={layout.WebLayoutBoxWidthAt(tree, firstBox)}")
        return 7793
    if layout.WebLayoutBoxXAt(tree, secondBox) != 203 || layout.WebLayoutBoxWidthAt(tree, secondBox) != 179:
        echo(Fmt"virtualized masonry scene second x={layout.WebLayoutBoxXAt(tree, secondBox)} w={layout.WebLayoutBoxWidthAt(tree, secondBox)}")
        return 7794
    return 0

