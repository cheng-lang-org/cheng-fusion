    var transitionFrame: scene.WebSceneCompositorFrame
    if !scene.WebSceneBuildCompositorFrameForRouteTransitionPlanWithFullAtlases(graph, transitionPlan, imageAtlas, svgAtlas, glyphAtlas, transitionFrame):
        return 787
    if scene.WebSceneCompositorLayerCount(transitionFrame) != 1:
        return 788
    if scene.WebSceneCompositorLayerTransitionActionAt(transitionFrame, 0) != scene.WebSceneLayerTransitionReuse:
        return 789
    if scene.WebSceneCompositorLayerCommandCountAt(transitionFrame, 0) != 0:
        return 790
    return 0

