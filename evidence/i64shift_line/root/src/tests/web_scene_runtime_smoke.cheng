    if !scene.WebSceneAddLayoutConstraint(graph, route, 2, 0, "height", "20px"):
        return 5236
    if !scene.WebSceneAddPaintOpAt(graph, route, 3, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", ""):
        return 5237
    var tree: layout.WebLayoutTree
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 160, 80, tree):
        return 5238
    if scene.WebSceneFindLayoutBoxIndex(tree, 2) >= 0:
        return 5239
    if !scene.WebSceneSetStateValue(graph, "visibleLocationAddress", "中国河南省三门峡市陕州区"):
        return 5240
    if scene.WebScenePaintTextAt(graph, 0) != "中国河南省三门峡市陕州区":
        return 5241
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 160, 80, tree):
        return 5242
    if scene.WebSceneFindLayoutBoxIndex(tree, 2) < 0:
        return 5243
    if scene.WebSceneFindLayoutBoxIndex(tree, 3) < 0:
        return 5244
    if !scene.WebSceneSetStateValue(graph, "visibleLocationAddress", ""):
        return 5245
    if scene.WebScenePaintTextAt(graph, 0) != "":
        return 5246
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 160, 80, tree):
        return 5247
    if scene.WebSceneFindLayoutBoxIndex(tree, 2) >= 0:
        return 5248
    return 0

fn WebSceneRuntimeSmokeStateConditionalBlockPushesInputLayout(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "state_conditional_block_pushes_input", 1, 1, route):
        return 5310
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 5311
    if !scene.WebSceneAddNode(graph, route, 1, 0, 2, "div", "", 1):
        return 5312
    if !scene.WebSceneAddNode(graph, route, 2, 1, 2, "div", "", 1):
        return 5313
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 3, 2, 2, "div", "", 1, "visibleLocationAddress", "__truthy", "") != 0:
        return 5314
    if !scene.WebSceneAddNode(graph, route, 4, 3, 2, "span", "", 1):
        return 5315
    if !scene.WebSceneAddNode(graph, route, 5, 4, 3, "", "已定位", 1):
        return 5316
    if !scene.WebSceneAddNode(graph, route, 6, 3, 2, "span", "", 1):
        return 5317
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 7, 6, 3, "", "", 1, "", "", "visibleLocationAddress") != 0:
        return 5318
    if !scene.WebSceneAddNode(graph, route, 8, 2, 2, "input", "", 1):
        return 5319
    if !scene.WebSceneAddLayoutConstraint(graph, route, 1, 0, "width", "390px"):
        return 5320
    if !scene.WebSceneAddLayoutConstraint(graph, route, 2, 0, "width", "390px"):
        return 5321
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 0, "display", "flex"):
        return 5322
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 1, "align-items", "center"):
        return 5323
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 2, "gap", "8px"):
        return 5324
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 3, "margin-bottom", "8px"):
        return 5325
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 4, "font-size", "12px"):
        return 5326
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 5, "line-height", "16px"):
        return 5327
    if !scene.WebSceneAddLayoutConstraint(graph, route, 4, 0, "display", "inline-flex"):
        return 5328
    if !scene.WebSceneAddLayoutConstraint(graph, route, 4, 1, "align-items", "center"):
        return 5329
    if !scene.WebSceneAddLayoutConstraint(graph, route, 4, 2, "padding-left", "8px"):
        return 5330
    if !scene.WebSceneAddLayoutConstraint(graph, route, 4, 3, "padding-right", "8px"):
        return 5331
    if !scene.WebSceneAddLayoutConstraint(graph, route, 4, 4, "padding-top", "4px"):
        return 5332
    if !scene.WebSceneAddLayoutConstraint(graph, route, 4, 5, "padding-bottom", "4px"):
        return 5333
    if !scene.WebSceneAddLayoutConstraint(graph, route, 8, 0, "width", "100%"):
        return 5334
    if !scene.WebSceneAddLayoutConstraint(graph, route, 8, 1, "height", "50px"):
        return 5335

    var tree: layout.WebLayoutTree
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 390, 120, tree):
        return 5336
    if scene.WebSceneFindLayoutBoxIndex(tree, 3) >= 0:
        return 5337
    let inputInitialBox = scene.WebSceneFindLayoutBoxIndex(tree, 8)
    if inputInitialBox < 0:
        return 5338
    if layout.WebLayoutBoxYAt(tree, inputInitialBox) != 0:
        return 5339
    if !scene.WebSceneSetStateValue(graph, "visibleLocationAddress", "中国河南省三门峡市陕州区"):
        return 5340
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 390, 120, tree):
        return 5341
    let rowBox = scene.WebSceneFindLayoutBoxIndex(tree, 3)
    let inputBox = scene.WebSceneFindLayoutBoxIndex(tree, 8)
    if rowBox < 0 || inputBox < 0:
        return 5342
    let expectedInputY = layout.WebLayoutBoxYAt(tree, rowBox) + layout.WebLayoutBoxHeightAt(tree, rowBox) + 8
    if layout.WebLayoutBoxYAt(tree, inputBox) != expectedInputY:
        echo(Fmt"state conditional block input actual rowY={layout.WebLayoutBoxYAt(tree, rowBox)} rowH={layout.WebLayoutBoxHeightAt(tree, rowBox)} inputY={layout.WebLayoutBoxYAt(tree, inputBox)} expected={expectedInputY}")
        return 5343
    return 0

fn WebSceneRuntimeSmokeBuildStateBoundTextGlyphGraph(graph: var scene.WebSceneGraph,
                                                     route: var int32): int32 =
    scene.WebSceneGraphInit(graph)
    route = -1
    if !scene.WebSceneAddRoute(graph, "state_bound_text_glyph", 1, 1, route):
        return 5250
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 5251
    let fontBytes = fontfixture.MakeWebFontSfntFixture()
    if !scene.WebSceneAddResource(graph, "font_subset", "font.0", "", "AA==", "state-font-hash", 2, 400, 0):
        return 5252
    if !scene.WebSceneSetResourceFontBytes(graph, "font_subset", "font.0", fontBytes):
        return 5253
    if !scene.WebSceneAddNode(graph, route, 1, 0, 2, "div", "", 1):
        return 5254
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 2, 1, 2, "div", "", 1, "visibleLocationAddress", "__truthy", "") != 0:
        return 5255
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 3, 2, 3, "", "", 1, "", "", "visibleLocationAddress") != 0:
        return 5256
    if !scene.WebSceneAddNode(graph, route, 5, 2, 3, "", "a", 1):
        return 5294
    if !scene.WebSceneAddNode(graph, route, 4, 1, 3, "", "A", 1):
        return 5286
    if !scene.WebSceneAddLayoutConstraint(graph, route, 1, 0, "width", "160px"):
        return 5257
    if !scene.WebSceneAddLayoutConstraint(graph, route, 2, 0, "height", "20px"):
        return 5258
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 0, "font-size", "12px"):
        return 5289
    if !scene.WebSceneAddLayoutConstraint(graph, route, 5, 0, "font-size", "12px"):
        return 5295
    if !scene.WebSceneAddPaintOpAt(graph, route, 3, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", ""):
        return 5259
    if !scene.WebSceneAddPaintOpAt(graph, route, 5, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", "a"):
        return 5296
    if !scene.WebSceneAddPaintOpAt(graph, route, 4, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", "A"):
        return 5287
    return 0

fn WebSceneRuntimeSmokeStateBoundTextGlyphRunRefresh(): int32 =
    var graph: scene.WebSceneGraph
    var route: int32
    var status = WebSceneRuntimeSmokeBuildStateBoundTextGlyphGraph(graph, route)
    if status != 0:
        return status
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
        return 5260
    var glyphAtlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneBuildGlyphAtlasFromPaintOps(graph, glyphAtlas):
        return 5261
    if scene.WebSceneGlyphAtlasRunCount(glyphAtlas) != 1:
        return 5262
    if scene.WebSceneGlyphAtlasGlyphCount(glyphAtlas) != 1:
        return 5264
    if !scene.WebSceneSetStateValue(graph, "visibleLocationAddress", "AA"):
        return 5290
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
        return 5291
    var dynamicStateCodepoints: int32[]
    add(dynamicStateCodepoints, 65)
    if !scene.WebSceneGlyphAtlasAppendStateTextGlyphInventoryCodepoints(graph, glyphAtlas, dynamicStateCodepoints):
        return 5292
    let stateInventoryGlyphCount = scene.WebSceneGlyphAtlasGlyphCount(glyphAtlas)
    if stateInventoryGlyphCount < 3:
        return 5293
    if stateInventoryGlyphCount > 3:
        return 5305
    var hasDynamicA = false
    var hasStaticHiddenA = false
    for glyphIndex in 0..<stateInventoryGlyphCount:
        let codepoint = scene.WebSceneGlyphAtlasGlyphCodepointAt(glyphAtlas, glyphIndex)
        if codepoint == 65:
            hasDynamicA = true
        if codepoint == 97:
            hasStaticHiddenA = true
    if !hasDynamicA || !hasStaticHiddenA:
        return 5306
    var glyphSdfAtlasBatch: int32[]
    if !scene.WebSceneEncodeGlyphSdfAtlasHostBatch(glyphAtlas, glyphSdfAtlasBatch):
        return 5265
    var glyphSdfGlyphBatch: int32[]
    var glyphSdfRunBatch: int32[]
    var glyphSdfRunGlyphBatch: int32[]
    if !scene.WebSceneEncodeGlyphSdfMetadataHostBatch(glyphAtlas, glyphSdfGlyphBatch, glyphSdfRunBatch, glyphSdfRunGlyphBatch):
        return 5266
    if glyphSdfRunBatch.len != scene.WebSceneGlyphSdfRunHostStrideI32:
        return 5267
    var glyphSdfPixels: uint8[]
    setLen(glyphSdfPixels, scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas))
    for pixelIndex in 0..<scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas):
        glyphSdfPixels[pixelIndex] = uint8(scene.WebSceneGlyphAtlasSdfPixelAt(glyphAtlas, pixelIndex))

    var loadGraph: scene.WebSceneGraph
    var loadRoute: int32
    status = WebSceneRuntimeSmokeBuildStateBoundTextGlyphGraph(loadGraph, loadRoute)
    if status != 0:
        return status
    var loadedGlyphAtlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneLoadPrecomputedGlyphSdfAtlasHostBatches(loadGraph, loadedGlyphAtlas, glyphSdfAtlasBatch, glyphSdfGlyphBatch, glyphSdfRunBatch, glyphSdfRunGlyphBatch, glyphSdfPixels):
        return 5268
    if scene.WebSceneGlyphAtlasGlyphCount(loadedGlyphAtlas) != 3:
        return 5269
    if scene.WebSceneGlyphAtlasRunCount(loadedGlyphAtlas) != 1:
        return 5270
    if scene.WebSceneGlyphAtlasRunIdForPaint(loadedGlyphAtlas, loadRoute, 3, 0) != -1:
        return 5271
    if scene.WebSceneGlyphAtlasRunIdForPaint(loadedGlyphAtlas, loadRoute, 5, 0) != -1:
        return 5297
    if scene.WebSceneGlyphAtlasRunIdForPaint(loadedGlyphAtlas, loadRoute, 4, 0) <= 0:
        return 5288
    if !scene.WebSceneSetStateValue(loadGraph, "visibleLocationAddress", "AA"):
        return 5272
    if !scene.WebSceneApplyRouteLayoutToPaintOps(loadGraph, loadRoute, 160, 80):
        return 5273
    if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(loadGraph, loadedGlyphAtlas, loadRoute):
        return 5274
    if scene.WebSceneGlyphAtlasRunCount(loadedGlyphAtlas) != 3:
        return 5275
    let runId = scene.WebSceneGlyphAtlasRunIdForPaint(loadedGlyphAtlas, loadRoute, 3, 0)
    if runId <= 0:
        return 5276
    let staticRunId = scene.WebSceneGlyphAtlasRunIdForPaint(loadedGlyphAtlas, loadRoute, 5, 0)
    if staticRunId <= 0:
        return 5298
    if scene.WebSceneGlyphAtlasRunGlyphCountForPaint(loadedGlyphAtlas, loadRoute, 3, 0) != 2:
        return 5277
    if scene.WebSceneGlyphAtlasRunGlyphCountForPaint(loadedGlyphAtlas, loadRoute, 5, 0) != 1:
        return 5299
    if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(loadGraph, loadedGlyphAtlas, loadRoute):
        return 5278
    if scene.WebSceneGlyphAtlasRunCount(loadedGlyphAtlas) != 3:
        return 5279
    var imageAtlas: scene.WebSceneImageAtlas
    if !scene.WebSceneBuildImageAtlasFromResources(loadGraph, imageAtlas):
        return 5280
    var svgAtlas: scene.WebSceneSvgDisplayListAtlas
    if !scene.WebSceneBuildSvgDisplayListAtlasFromPaintOps(loadGraph, svgAtlas):
        return 5281
    var gpu: scene.WebSceneGpuCommandBuffer
    if !scene.WebSceneBuildRouteLayerGpuCommandsWithFullAtlases(loadGraph, loadRoute, 1, imageAtlas, svgAtlas, loadedGlyphAtlas, gpu):
        return 5282
    if scene.WebSceneGpuCommandCount(gpu) != 3:
        return 5283
    var hasStateGlyphRun: bool
    var hasConditionalStaticGlyphRun: bool
    for commandIndex in 0..<scene.WebSceneGpuCommandCount(gpu):
        if scene.WebSceneGpuCommandKindAt(gpu, commandIndex) != scene.WebSceneGpuFillText:
            return 5284
        if scene.WebSceneGpuCommandGlyphRunIdAt(gpu, commandIndex) == runId:
            hasStateGlyphRun = true
        if scene.WebSceneGpuCommandGlyphRunIdAt(gpu, commandIndex) == staticRunId:
            hasConditionalStaticGlyphRun = true
    if !hasStateGlyphRun:
        return 5285
    if !hasConditionalStaticGlyphRun:
        return 5300
    return 0

# Device incremental-present gap: a state-bound text node whose runtime value
# carries a codepoint that was never pre-baked into the precomputed atlas
# (e.g. a geocoded address) produced no glyph run and therefore no draw command.
# The precomputed atlas ships with empty font faces, so the refresh could only
# reuse already-baked glyphs. Fix: hydrate real faces, then the run builder
# rasterizes the missing glyph on demand and the atlas grows for re-upload.
fn WebSceneRuntimeSmokeDynamicStateTextRasterizesGlyphOnMiss(): int32 =
    var graph: scene.WebSceneGraph
    var route: int32
    var status = WebSceneRuntimeSmokeBuildStateBoundTextGlyphGraph(graph, route)
    if status != 0:
        return status
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
        return 5400
    var glyphAtlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneBuildGlyphAtlasFromPaintOps(graph, glyphAtlas):
        return 5401
    # Only the static "A" is baked; the bound subtree is hidden while state empty.
    if scene.WebSceneGlyphAtlasGlyphCount(glyphAtlas) != 1:
        return 5402
    var atlasWords: int32[]
    if !scene.WebSceneEncodeGlyphSdfAtlasHostBatch(glyphAtlas, atlasWords):
        return 5403
    var glyphWords: int32[]
    var runWords: int32[]
    var runGlyphWords: int32[]
    if !scene.WebSceneEncodeGlyphSdfMetadataHostBatch(glyphAtlas, glyphWords, runWords, runGlyphWords):
        return 5404
    var pixels: uint8[]
    setLen(pixels, scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas))
    for pixelIndex in 0..<scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas):
        pixels[pixelIndex] = uint8(scene.WebSceneGlyphAtlasSdfPixelAt(glyphAtlas, pixelIndex))

    var loadGraph: scene.WebSceneGraph
    var loadRoute: int32
    status = WebSceneRuntimeSmokeBuildStateBoundTextGlyphGraph(loadGraph, loadRoute)
    if status != 0:
        return status
    var loadedAtlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneLoadPrecomputedGlyphSdfAtlasHostBatches(loadGraph, loadedAtlas, atlasWords, glyphWords, runWords, runGlyphWords, pixels):
        return 5405
    # 'a' (97) is supported by the font but absent from the precomputed atlas.
    if scene.WebSceneGlyphAtlasFindGlyphIndexForRequest(loadedAtlas, 97, 12, 400, layout.WebLayoutFontFamilySans, 0) >= 0:
        return 5406

    if !scene.WebSceneSetStateValue(loadGraph, "visibleLocationAddress", "a"):
        return 5407
    if !scene.WebSceneApplyRouteLayoutToPaintOps(loadGraph, loadRoute, 160, 80):
        return 5408

    # Empty faces (as shipped) cannot rasterize -> no run: the device symptom.
    scene.WebSceneGlyphAtlasDebugClear()
    if scene.WebSceneRefreshStateTextGlyphRunsForRoute(loadGraph, loadedAtlas, loadRoute):
        return 5409
    if scene.WebSceneGlyphAtlasRunIdForPaint(loadedAtlas, loadRoute, 3, 0) > 0:
        return 5410

    # Hydrate real font faces, then the refresh rasterizes the missing glyph.
    let pixelsBefore = scene.WebSceneGlyphAtlasSdfPixelCount(loadedAtlas)
    if !scene.WebSceneGlyphAtlasHydratePrecomputedFontFacesAndPackCursor(loadGraph, loadedAtlas):
        return 5411
    scene.WebSceneGlyphAtlasDebugClear()
    if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(loadGraph, loadedAtlas, loadRoute):
        return 5412
    let stateRunId = scene.WebSceneGlyphAtlasRunIdForPaint(loadedAtlas, loadRoute, 3, 0)
    if stateRunId <= 0:
        return 5413
    if scene.WebSceneGlyphAtlasFindGlyphIndexForRequest(loadedAtlas, 97, 12, 400, layout.WebLayoutFontFamilySans, 0) < 0:
        return 5414
    if scene.WebSceneGlyphAtlasSdfPixelCount(loadedAtlas) <= pixelsBefore:
        return 5415

    # The grown atlas re-encodes cleanly for the host re-upload path.
    var atlasWords2: int32[]
    if !scene.WebSceneEncodeGlyphSdfAtlasHostBatch(loadedAtlas, atlasWords2):
        return 5416
    var glyphWords2: int32[]
    var runWords2: int32[]
    var runGlyphWords2: int32[]
    if !scene.WebSceneEncodeGlyphSdfMetadataHostBatch(loadedAtlas, glyphWords2, runWords2, runGlyphWords2):
        return 5417

    # The dynamic text now yields a real GPU fill-text draw command.
    var imageAtlas: scene.WebSceneImageAtlas
    if !scene.WebSceneBuildImageAtlasFromResources(loadGraph, imageAtlas):
        return 5418
    var svgAtlas: scene.WebSceneSvgDisplayListAtlas
    if !scene.WebSceneBuildSvgDisplayListAtlasFromPaintOps(loadGraph, svgAtlas):
        return 5419
    var gpu: scene.WebSceneGpuCommandBuffer
    if !scene.WebSceneBuildRouteLayerGpuCommandsWithFullAtlases(loadGraph, loadRoute, 1, imageAtlas, svgAtlas, loadedAtlas, gpu):
        return 5420
    var hasStateGlyphDraw = false
    for commandIndex in 0..<scene.WebSceneGpuCommandCount(gpu):
        if scene.WebSceneGpuCommandKindAt(gpu, commandIndex) == scene.WebSceneGpuFillText:
            if scene.WebSceneGpuCommandGlyphRunIdAt(gpu, commandIndex) == stateRunId:
                hasStateGlyphDraw = true
    if !hasStateGlyphDraw:
        return 5421

    # Pixel-asset device mode: metadata loads without the pixel buffer in memory.
    # The atlas must adopt the shipped pixels before rasterizing, else growth would
    # blank the baked glyphs. This mirrors the production unimaker load path.
    var assetGraph: scene.WebSceneGraph
    var assetRoute: int32
    status = WebSceneRuntimeSmokeBuildStateBoundTextGlyphGraph(assetGraph, assetRoute)
    if status != 0:
        return status
    var assetAtlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneLoadPrecomputedGlyphSdfAtlasHostBatchesWithoutPixels(assetGraph, assetAtlas, atlasWords, glyphWords, runWords, runGlyphWords, pixels.len):
        return 5422
    # Loaded without pixels: the atlas reports the expected count but owns none yet.
    if scene.WebSceneGlyphAtlasSdfPixelAt(assetAtlas, 0) >= 0:
        return 5423
    if !scene.WebSceneGlyphAtlasAdoptSdfPixels(assetAtlas, pixels):
        return 5424
    if scene.WebSceneGlyphAtlasSdfPixelAt(assetAtlas, 0) < 0:
        return 5425
    if !scene.WebSceneGlyphAtlasHydratePrecomputedFontFacesAndPackCursor(assetGraph, assetAtlas):
        return 5426
    if !scene.WebSceneSetStateValue(assetGraph, "visibleLocationAddress", "a"):
        return 5427
    if !scene.WebSceneApplyRouteLayoutToPaintOps(assetGraph, assetRoute, 160, 80):
        return 5428
    let assetPixelsBefore = scene.WebSceneGlyphAtlasSdfPixelCount(assetAtlas)
    scene.WebSceneGlyphAtlasDebugClear()
    if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(assetGraph, assetAtlas, assetRoute):
        return 5429
    if scene.WebSceneGlyphAtlasRunIdForPaint(assetAtlas, assetRoute, 3, 0) <= 0:
        return 5430
    if scene.WebSceneGlyphAtlasSdfPixelCount(assetAtlas) <= assetPixelsBefore:
        return 5431
    # Baked "A" glyph pixels survived the adopt+grow (not zeroed). Node 4 carries
    # no font-size constraint, so the baked "A" was rasterized at the 16px default.
    let bakedGlyphIndex = scene.WebSceneGlyphAtlasFindGlyphIndexForRequest(assetAtlas, 65, 16, 400, layout.WebLayoutFontFamilySans, 0)
    if bakedGlyphIndex < 0:
        return 5432
    var bakedNonZero = false
    let bakedPixelCount = scene.WebSceneGlyphAtlasGlyphSdfPixelCountAt(assetAtlas, bakedGlyphIndex)
    for bakedPixelIndex in 0..<bakedPixelCount:
        if scene.WebSceneGlyphAtlasGlyphSdfPixelAt(assetAtlas, bakedGlyphIndex, bakedPixelIndex) > 0:
            bakedNonZero = true
    if !bakedNonZero:
        return 5433
    return 0

# Device feed-load churn: a state-bound title (m2) rebinds to a new value every
# frame while media streams in. Each rebind must reuse the node's single glyph
# run in place — never append a duplicate. The old bug leaked one stale run per
# rebind, growing atlas.runs/runGlyphs unbounded and re-uploading the whole glyph
# metadata batch every frame. This regression pins: (a) run count stays constant
# across many changed-value rebinds, (b) the node keeps a stable glyphRunId
# identity, and (c) a second refresh at the same state re-encodes a byte-identical
# metadata batch (second-frame upload delta ~ 0).
fn WebSceneRuntimeSmokeStateTextRebindIsIdempotent(): int32 =
    var graph: scene.WebSceneGraph
    var route: int32
    var status = WebSceneRuntimeSmokeBuildStateBoundTextGlyphGraph(graph, route)
    if status != 0:
        return status
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
        return 5450
    var atlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneBuildGlyphAtlasFromPaintOps(graph, atlas):
        return 5451
    # Hydrate real faces so the dynamic title can rasterize on demand each rebind.
    if !scene.WebSceneGlyphAtlasHydratePrecomputedFontFacesAndPackCursor(graph, atlas):
        return 5452

    # First bind establishes the node's single run.
    if !scene.WebSceneSetStateValue(graph, "visibleLocationAddress", "AA"):
        return 5453
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
        return 5454
    if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(graph, atlas, route):
        return 5455
    let baseRunCount = scene.WebSceneGlyphAtlasRunCount(atlas)
    if baseRunCount <= 0:
        return 5456
    let baseRunId = scene.WebSceneGlyphAtlasRunIdForPaint(atlas, route, 3, 0)
    if baseRunId <= 0:
        return 5457

    # Feed-load frames: the title value changes (and changes length) each frame.
    var values: str[]
    add(values, "AAA")
    add(values, "AAAA")
    add(values, "AAAAA")
    add(values, "AAAA")
    add(values, "AAA")
    var frame = 0
    while frame < values.len:
        if !scene.WebSceneSetStateValue(graph, "visibleLocationAddress", values[frame]):
            return 5458
        if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
            return 5459
        if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(graph, atlas, route):
            return 5460
        # No duplicate run leaked: total run count stays fixed across rebinds.
        if scene.WebSceneGlyphAtlasRunCount(atlas) != baseRunCount:
            return 5461
        # The node keeps one run and a stable identity for host-side reuse.
        if scene.WebSceneGlyphAtlasRunIdForPaint(atlas, route, 3, 0) != baseRunId:
            return 5462
        # The run's glyph count tracks the current text (was rebuilt, not stale).
        if scene.WebSceneGlyphAtlasRunGlyphCountForPaint(atlas, route, 3, 0) != scene.WebSceneGlyphAtlasTextCodepointCount(values[frame]):
            return 5463
        frame = frame + 1

    # Two refreshes at the SAME state re-encode a byte-identical metadata batch:
    # the second frame uploads nothing new.
    var glyphWordsA: int32[]
    var runWordsA: int32[]
    var runGlyphWordsA: int32[]
    if !scene.WebSceneEncodeGlyphSdfMetadataHostBatch(atlas, glyphWordsA, runWordsA, runGlyphWordsA):
        return 5464
    if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(graph, atlas, route):
        return 5465
    if scene.WebSceneGlyphAtlasRunCount(atlas) != baseRunCount:
        return 5466
    var glyphWordsB: int32[]
    var runWordsB: int32[]
    var runGlyphWordsB: int32[]
    if !scene.WebSceneEncodeGlyphSdfMetadataHostBatch(atlas, glyphWordsB, runWordsB, runGlyphWordsB):
        return 5467
    if runWordsA.len != runWordsB.len:
        return 5468
    if runGlyphWordsA.len != runGlyphWordsB.len:
        return 5469
    for i in 0..<runWordsA.len:
        if runWordsA[i] != runWordsB[i]:
            return 5470
    for i in 0..<runGlyphWordsA.len:
        if runGlyphWordsA[i] != runGlyphWordsB[i]:
            return 5471
    return 0

fn WebSceneRuntimeSmokeVisibleEmptyStateTextHasNoGlyphRun(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "visible_empty_state_text", 1, 1, route):
        return 5310
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 5311
    let fontBytes = fontfixture.MakeWebFontSfntFixture()
    if !scene.WebSceneAddResource(graph, "font_subset", "font.0", "", "AA==", "empty-state-font", 2, 400, 0):
        return 5312
    if !scene.WebSceneSetResourceFontBytes(graph, "font_subset", "font.0", fontBytes):
        return 5313
    if !scene.WebSceneAddNode(graph, route, 1, 0, 2, "div", "", 1):
        return 5314
    if scene.WebSceneAddNodeWithStateBindingsStatus(graph, route, 2, 1, 3, "", "", 1, "", "", "didText") != 0:
        return 5315
    if !scene.WebSceneAddLayoutConstraint(graph, route, 1, 0, "width", "160px"):
        return 5316
    if !scene.WebSceneAddLayoutConstraint(graph, route, 1, 1, "height", "40px"):
        return 5322
    if !scene.WebSceneAddPaintOpAt(graph, route, 2, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", ""):
        return 5317
    var glyphAtlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneBuildGlyphAtlasFromPaintOps(graph, glyphAtlas):
        return 5319
    if scene.WebSceneGlyphAtlasRunCount(glyphAtlas) != 0:
        return 5320
    if scene.WebSceneLastGlyphAtlasFailCode() != 0:
        return 5321
    return 0

# A route whose visible text carries a codepoint no packed face covers (傈, U+5088)
# used to abort WebSceneBuildGlyphAtlasFromPaintOps (fail 27) — the caller treated
# the false as "scene not ready" and skipped the entire route's GPU command build,
# freezing the whole page (logo included). The .notdef hardening substitutes a tofu
# box and keeps building, so the build succeeds, the box rasterizes visible pixels,
# and the route's GPU commands still carry both the text run and the sibling logo.
fn WebSceneRuntimeSmokeMissingGlyphDrawsNotdefAndContinues(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "missing_glyph_notdef", 1, 1, route):
        return 5450
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 5451
    let fontBytes = fontfixture.MakeWebFontSfntFixture()
    if !scene.WebSceneAddResource(graph, "font_subset", "font.0", "", "AA==", "notdef-font-hash", 2, 400, 0):
        return 5452
    if !scene.WebSceneSetResourceFontBytes(graph, "font_subset", "font.0", fontBytes):
        return 5453
    if !scene.WebSceneAddNode(graph, route, 1, 0, 2, "div", "", 1):
        return 5454
    # Sibling logo (a plain fill) — this is the "rest of the page" that must still
    # render even though the text node contains a missing glyph.
    if !scene.WebSceneAddNode(graph, route, 2, 1, 2, "div", "", 1):
        return 5455
    if !scene.WebSceneAddNode(graph, route, 3, 1, 3, "", "A傈", 1):
        return 5456
    if !scene.WebSceneAddLayoutConstraint(graph, route, 1, 0, "width", "160px"):
        return 5457
    if !scene.WebSceneAddLayoutConstraint(graph, route, 1, 1, "height", "80px"):
        return 5458
    if !scene.WebSceneAddLayoutConstraint(graph, route, 2, 0, "width", "40px"):
        return 5459
    if !scene.WebSceneAddLayoutConstraint(graph, route, 2, 1, "height", "40px"):
        return 5460
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 0, "font-size", "12px"):
        return 5461
    if !scene.WebSceneAddPaintOpAt(graph, route, 2, 0, 0, 0, scene.WebScenePaintFill, Int64(4294967295), 0, 40, 40, "", ""):
        return 5462
    if !scene.WebSceneAddPaintOpAt(graph, route, 3, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", "A傈"):
        return 5463
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
        return 5464
    var glyphAtlas: scene.WebSceneGlyphAtlas
    # De-wedge: the build no longer aborts on the missing 傈.
    if !scene.WebSceneBuildGlyphAtlasFromPaintOps(graph, glyphAtlas):
        return 5465
    if scene.WebSceneGlyphAtlasNotdefSubstitutionCount() != 1:
        return 5466
    if scene.WebSceneGlyphAtlasNotdefLastSubstitutedCodepoint() != 20616:
        return 5467
    # The box is a valid rendering, not an error — the fail latch stays clear.
    if scene.WebSceneLastGlyphAtlasFailCode() != 0:
        return 5468
    # The .notdef box rasterized real (non-zero) SDF pixels — it draws as tofu.
    let boxGlyphIndex = scene.WebSceneGlyphAtlasFindGlyphIndexForRequest(glyphAtlas, 20616, 12, 400, layout.WebLayoutFontFamilySans, 0)
    if boxGlyphIndex < 0:
        return 5469
    var boxNonZero = false
    let boxPixelCount = scene.WebSceneGlyphAtlasGlyphSdfPixelCountAt(glyphAtlas, boxGlyphIndex)
    for boxPixelIndex in 0..<boxPixelCount:
        if scene.WebSceneGlyphAtlasGlyphSdfPixelAt(glyphAtlas, boxGlyphIndex, boxPixelIndex) > 0:
            boxNonZero = true
    if !boxNonZero:
        return 5470
    # The whole route's GPU commands build (no freeze) and carry both the text run
    # (with the box) and the sibling logo fill — the rest of the page still renders.
    var imageAtlas: scene.WebSceneImageAtlas
    if !scene.WebSceneBuildImageAtlasFromResources(graph, imageAtlas):
        return 5471
    var svgAtlas: scene.WebSceneSvgDisplayListAtlas
    if !scene.WebSceneBuildSvgDisplayListAtlasFromPaintOps(graph, svgAtlas):
        return 5472
    var gpu: scene.WebSceneGpuCommandBuffer
    if !scene.WebSceneBuildRouteLayerGpuCommandsWithFullAtlases(graph, route, 1, imageAtlas, svgAtlas, glyphAtlas, gpu):
        return 5473
    if scene.WebSceneGpuCommandCount(gpu) <= 0:
        return 5474
    var hasText = false
    var hasSiblingFill = false
    for commandIndex in 0..<scene.WebSceneGpuCommandCount(gpu):
        let kind = scene.WebSceneGpuCommandKindAt(gpu, commandIndex)
        if kind == scene.WebSceneGpuFillText:
            hasText = true
        if kind == scene.WebSceneGpuFillRect:
            hasSiblingFill = true
    if !hasText:
        return 5475
    if !hasSiblingFill:
        return 5476
    return 0

# Runtime path: a state-bound text node whose value gains a missing codepoint used
# to make WebSceneRefreshStateTextGlyphRunsForRoute return false (fail 773/785) and
# wedge the whole route refresh. With the hardening the refresh substitutes a box,
# builds the run, and returns true — the substitution is counted exactly once.
fn WebSceneRuntimeSmokeMissingGlyphRefreshDrawsNotdefAndContinues(): int32 =
    var graph: scene.WebSceneGraph
    var route: int32
    var status = WebSceneRuntimeSmokeBuildStateBoundTextGlyphGraph(graph, route)
    if status != 0:
        return status
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
        return 5490
    var glyphAtlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneBuildGlyphAtlasFromPaintOps(graph, glyphAtlas):
        return 5491
    # State empty: only the always-visible "A" is baked, no substitution yet.
    if scene.WebSceneGlyphAtlasNotdefSubstitutionCount() != 0:
        return 5492
    if !scene.WebSceneSetStateValue(graph, "visibleLocationAddress", "傈"):
        return 5493
    if !scene.WebSceneApplyRouteLayoutToPaintOps(graph, route, 160, 80):
        return 5494
    scene.WebSceneGlyphAtlasDebugClear()
    # De-wedge: refresh no longer returns false on the missing 傈; it draws a box.
    if !scene.WebSceneRefreshStateTextGlyphRunsForRoute(graph, glyphAtlas, route):
        return 5495
    if scene.WebSceneGlyphAtlasNotdefSubstitutionCount() != 1:
        return 5496
    if scene.WebSceneGlyphAtlasNotdefLastSubstitutedCodepoint() != 20616:
        return 5497
    if scene.WebSceneLastGlyphAtlasFailCode() != 0:
        return 5498
    # The state text node now owns a real glyph run instead of being dropped.
    if scene.WebSceneGlyphAtlasRunIdForPaint(glyphAtlas, route, 3, 0) <= 0:
        return 5499
    # The refreshed .notdef box rasterized real (non-zero) SDF pixels — it draws as a
    # visible tofu box, matching the build path's guarantee (not a blank cell).
    let boxGlyphIndex = scene.WebSceneGlyphAtlasFindGlyphIndexForRequest(glyphAtlas, 20616, 12, 400, layout.WebLayoutFontFamilySans, 0)
    if boxGlyphIndex < 0:
        return 5500
    var boxNonZero = false
    let boxPixelCount = scene.WebSceneGlyphAtlasGlyphSdfPixelCountAt(glyphAtlas, boxGlyphIndex)
    for boxPixelIndex in 0..<boxPixelCount:
        if scene.WebSceneGlyphAtlasGlyphSdfPixelAt(glyphAtlas, boxGlyphIndex, boxPixelIndex) > 0:
            boxNonZero = true
    if !boxNonZero:
        return 5501
    return 0

# Multi-face missing-glyph regression. A run pinned to a NON-default face (weight 700)
# that then hits a truly-missing codepoint must synthesize its .notdef box on the run's
# own face, not the default face — otherwise the box lands in a different sdf atlas
# (orphan cross-atlas run, breaking the run's single-atlas invariant) and the
# substitution gets double-counted. Covers both the build path (AppendTextRun) and the
# refresh path (AppendExistingGlyphTextRun). Both faces are the same fixture bytes
# registered under weight 400 (default) and 700 (bold), so both cover 'A' but neither
# covers the CJK boxes (傈 U+5088 / 乙 U+4E59).
fn WebSceneRuntimeSmokeMissingGlyphMultiFacePinsRunFace(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    let fontBytes = fontfixture.MakeWebFontSfntFixture()
    # Default face: sans / weight 400 — this is what DefaultFontIndex resolves to.
    if !scene.WebSceneAddResource(graph, "font_subset", "font.default", "", "AA==", "notdef-mf-default", 2, 400, 0):
        return 5520
    if !scene.WebSceneSetResourceFontBytes(graph, "font_subset", "font.default", fontBytes):
        return 5521
    # Non-default face: sans / weight 700 — a weight-700 run pins here for 'A'.
    if !scene.WebSceneAddResource(graph, "font_subset", "font.bold", "", "AA==", "notdef-mf-bold", 2, 700, 0):
        return 5522
    if !scene.WebSceneSetResourceFontBytes(graph, "font_subset", "font.bold", fontBytes):
        return 5523
    var atlas: scene.WebSceneGlyphAtlas
    scene.WebSceneGlyphAtlasInit(atlas)
    scene.WebSceneGlyphAtlasDebugClear()
    if !scene.WebSceneGlyphAtlasAppendFontResources(graph, atlas):
        return 5524
    if scene.WebSceneGlyphAtlasFontCount(atlas) != 2:
        return 5525
    let defaultFontIndex = scene.WebSceneGlyphAtlasDefaultFontIndex(atlas)
    if defaultFontIndex < 0:
        return 5526
    let defaultSdfAtlasId = scene.WebSceneGlyphAtlasFontSdfAtlasIdAt(atlas, defaultFontIndex)
    if defaultSdfAtlasId <= 0:
        return 5527
    # --- Build path (AppendTextRun): weight-700 "A傈". 'A' pins the bold face; 傈 is
    #     truly missing on both faces, so it must box on the bold (run) face.
    var buildOp: scene.WebScenePaintOp
    buildOp.routeIndex = 0
    buildOp.nodeId = 91
    buildOp.ordinal = 0
    buildOp.opKind = scene.WebScenePaintText
    buildOp.fontSize = 12
    buildOp.fontWeight = 700
    buildOp.fontFamily = 0
    buildOp.textContent = "A傈"
    if !scene.WebSceneGlyphAtlasAppendTextRun(buildOp, atlas):
        return 5528
    # Exactly one substitution (傈), counted once (no double-count).
    if scene.WebSceneGlyphAtlasNotdefSubstitutionCount() != 1:
        return 5529
    if scene.WebSceneGlyphAtlasNotdefLastSubstitutedCodepoint() != 20616:
        return 5530
    if scene.WebSceneGlyphAtlasRunCount(atlas) != 1:
        return 5531
    let buildRunSdf = scene.WebSceneGlyphAtlasRunSdfAtlasIdAt(atlas, 0)
    # The run pinned the non-default (bold) face, not the default face.
    if buildRunSdf == defaultSdfAtlasId:
        return 5532
    # The 傈 box lives in the SAME sdf atlas as the run (no cross-atlas orphan box).
    if scene.WebSceneGlyphAtlasFindGlyphIndexAnyFontForSdfAtlas(atlas, 20616, 12, buildRunSdf) < 0:
        return 5533
    # And no orphan 傈 box was minted on the default face's atlas.
    if scene.WebSceneGlyphAtlasFindGlyphIndexAnyFontForSdfAtlas(atlas, 20616, 12, defaultSdfAtlasId) >= 0:
        return 5534
    # --- Refresh path (AppendExistingGlyphTextRun): a fresh run at weight 700 whose
    #     'A' resolves to the bold glyph baked above (pinning bold), then a NEW
    #     truly-missing codepoint (乙, never boxed yet) — must box once on the run's
    #     own face, not double-count via a redundant orphan on the default face.
    scene.WebSceneGlyphAtlasDebugClear()
    var refreshOp: scene.WebScenePaintOp
    refreshOp.routeIndex = 0
    refreshOp.nodeId = 92
    refreshOp.ordinal = 0
    refreshOp.opKind = scene.WebScenePaintText
    refreshOp.fontSize = 12
    refreshOp.fontWeight = 700
    refreshOp.fontFamily = 0
    refreshOp.textContent = "A乙"
    if !scene.WebSceneGlyphAtlasAppendExistingGlyphTextRun(refreshOp, atlas):
        return 5535
    # 乙 substituted exactly once (not twice) on the refresh path.
    if scene.WebSceneGlyphAtlasNotdefSubstitutionCount() != 1:
        return 5536
    if scene.WebSceneGlyphAtlasNotdefLastSubstitutedCodepoint() != 20057:
        return 5537
    if scene.WebSceneGlyphAtlasRunCount(atlas) != 2:
        return 5538
    let refreshRunSdf = scene.WebSceneGlyphAtlasRunSdfAtlasIdAt(atlas, 1)
    if refreshRunSdf == defaultSdfAtlasId:
        return 5539
    # 乙 box shares the run's atlas; no orphan copy landed on the default atlas.
    if scene.WebSceneGlyphAtlasFindGlyphIndexAnyFontForSdfAtlas(atlas, 20057, 12, refreshRunSdf) < 0:
        return 5540
    if scene.WebSceneGlyphAtlasFindGlyphIndexAnyFontForSdfAtlas(atlas, 20057, 12, defaultSdfAtlasId) >= 0:
        return 5541
    return 0

# Live consumer for the .notdef substitution counter — without a real reader the
# counter is a dead signal. The desktop standard scene (home_default + tab_messages
# production routes, static "AA"/"aa" text, all covered by the packed face) must build
# its glyph atlas with ZERO .notdef substitutions. This turns the counter into a gate:
# a coverage/face-selection regression that spuriously substitutes a covered glyph, or
# uncovered production text shipped without its font, trips this instead of silently
# drawing tofu. The only known true missing glyph (傈) is runtime GPS-only and never
# appears in the desktop scene, so count==0 is a safe, non-trivial invariant here.
fn WebSceneRuntimeSmokeStandardSceneHasNoNotdefSubstitution(): int32 =
    var graph: scene.WebSceneGraph
    var home: int32
    var messages: int32
    let status = WebSceneRuntimeSmokeBuildStandardGraph(graph, home, messages)
    if status != 0:
        return status
    var glyphAtlas: scene.WebSceneGlyphAtlas
    # WebSceneBuildGlyphAtlasFromPaintOps clears the counter on entry, so the count
    # below reflects exactly this production-scene build (no cross-test carry-over).
    if !scene.WebSceneBuildGlyphAtlasFromPaintOps(graph, glyphAtlas):
        return 5560
    if scene.WebSceneGlyphAtlasRunCount(glyphAtlas) != 2:
        return 5561
    if scene.WebSceneGlyphAtlasNotdefSubstitutionCount() != 0:
        return 5562
    return 0

fn WebSceneRuntimeSmokeCssPlaceholderTextPaint(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "css_placeholder_text", 1, 1, route):
        return 2400
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 2401
    if !scene.WebSceneAddNode(graph, route, 1, 0, 2, "input", "", 1):
        return 2402
    if !scene.WebSceneAddNode(graph, route, 2, 0, 2, "input", "", 1):
        return 2403
    if !scene.WebSceneAddProp(graph, route, 1, 0, "className", "placeholder:text-gray-300", "string"):
        return 2404
    if !scene.WebSceneAddProp(graph, route, 1, 1, "placeholder", "Title", "string"):
        return 2405
    if !scene.WebSceneAddProp(graph, route, 2, 0, "className", "placeholder:text-gray-300", "string"):
        return 2406
    if !scene.WebSceneAddProp(graph, route, 2, 1, "placeholder", "Hidden", "string"):
        return 2407
    if !scene.WebSceneAddProp(graph, route, 2, 2, "value", "already typed", "string"):
        return 2408
    if !scene.WebSceneAddPaintOpAt(graph, route, 1, 0, 4, 6, scene.WebScenePaintPlaceholderText, Int64(4278190080), 0, 80, 20, "", "Title"):
        return 2409
    if !scene.WebSceneAddPaintOpAt(graph, route, 2, 0, 4, 30, scene.WebScenePaintPlaceholderText, Int64(4278190080), 0, 80, 20, "", "Hidden"):
        return 2410
    if !scene.WebSceneAddCssVariantRule(graph, route, 1, 0, "placeholder:text-gray-300", ".placeholder\\:text-gray-300::placeholder", "0,2,0", 0):
        return 2411
    if !scene.WebSceneAddCssVariantCondition(graph, route, 1, 0, 0, "pseudo", "placeholder", "", ""):
        return 2412
    if !scene.WebSceneAddCssDeclaration(graph, route, 1, 0, 0, "color", "0xFFD1D5DB", false):
        return 2413
    if !scene.WebSceneAddCssVariantRule(graph, route, 2, 0, "placeholder:text-gray-300", ".placeholder\\:text-gray-300::placeholder", "0,2,0", 0):
        return 2414
    if !scene.WebSceneAddCssVariantCondition(graph, route, 2, 0, 0, "pseudo", "placeholder", "", ""):
        return 2415
    if !scene.WebSceneAddCssDeclaration(graph, route, 2, 0, 0, "color", "0xFFD1D5DB", false):
        return 2416
    if !scene.WebSceneApplyCssVariantRulesToPaintOps(graph, route):
        return 2417
    if scene.WebScenePaintKindAt(graph, 0) != scene.WebScenePaintPlaceholderText:
        return 2418
    if scene.WebScenePaintColorAt(graph, 0) != Int64(4291941851):
        return 2419
    if scene.WebScenePaintColorAt(graph, 1) != Int64(4278190080):
        return 2420
    var commands: scene.WebScenePaintCommandBuffer
    if !scene.WebSceneBuildRouteLayerPaintCommands(graph, route, 1, commands):
        return 2421
    if scene.WebScenePaintCommandCount(commands) != 1:
        return 2422
    if scene.WebScenePaintCommandKindAt(commands, 0) != paint.PaintOpKindFillText:
        return 2423
    if scene.WebScenePaintCommandTextAt(commands, 0) != "Title":
        return 2424
    return 0

