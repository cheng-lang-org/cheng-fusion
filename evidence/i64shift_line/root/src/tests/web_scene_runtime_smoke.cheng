    if hostGpuBatch[scene.WebSceneGpuHostBatchStrideI32 + 13] != homeGlyphRun:
        return 239
    if hostGpuBatch[scene.WebSceneGpuHostBatchStrideI32 + 15] != scene.WebSceneGpuCommandGlyphSdfAtlasIdAt(atlasGpu, 1):
        return 344

    if scene.WebSceneBuildRouteLayerPaintCommands(graph, home, 999, commands):
        return 85
    if !scene.WebSceneBuildRouteLayerPaintCommands(graph, home, 2, commands):
        return 98
    if scene.WebScenePaintCommandCount(commands) != 1:
        return 99
    if !scene.WebSceneLayerCacheMarkValid(graph, home, 2, commands):
