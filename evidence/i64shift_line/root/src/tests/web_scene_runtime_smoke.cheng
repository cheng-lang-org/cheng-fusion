    var atlasGpu: scene.WebSceneGpuCommandBuffer
    if !scene.WebSceneBuildRouteLayerGpuCommandsWithFullAtlases(graph, home, 1, imageAtlas, svgAtlas, glyphAtlas, atlasGpu):
        return 229
    if scene.WebSceneGpuCommandCount(atlasGpu) != 3:
