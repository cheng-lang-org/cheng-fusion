fn WebSceneRuntimeSmokeRouteExpectedIndex(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRouteExpectedIndex(graph, "expected_home", 10, 1, 0):
        return 7601
    if !scene.WebSceneAddRouteExpectedIndex(graph, "expected_messages", 20, 2, 1):
        return 7602
    if scene.WebSceneAddRouteExpectedIndex(graph, "expected_wrong", 30, 3, 3):
        return 7603
    if scene.WebSceneAddRouteExpectedIndex(graph, "expected_home", 30, 3, 2):
        return 7604
    if scene.WebSceneRouteCount(graph) != 2:
        return 7605
    if scene.WebSceneFindRouteIndex(graph, "expected_messages") != 1:
        return 7606
    return 0

fn WebSceneRuntimeSmokeBuildStandardGraph(graph: var scene.WebSceneGraph,
                                          home: var int32,
                                          messages: var int32): int32 =
    scene.WebSceneGraphInit(graph)
    home = -1
    messages = -1
    var status = WebSceneRuntimeSmokeInitRoutesLayers(graph, home, messages)
    if status != 0:
        return status
    status = WebSceneRuntimeSmokeAddResources(graph)
    if status != 0:
        return status
    status = WebSceneRuntimeSmokeAddNodesAndLayouts(graph, home, messages)
    if status != 0:
        return status
    status = WebSceneRuntimeSmokeAddPaintFacts(graph, home, messages)
    if status != 0:
        return status
    return 0

fn WebSceneRuntimeSmokeInitRoutesLayers(graph: var scene.WebSceneGraph,
                                        home: var int32,
                                        messages: var int32): int32 =
    if !scene.WebSceneAddRoute(graph, "home_default", 10, 1, home):
        return 1
    if !scene.WebSceneAddRoute(graph, "tab_messages", 20, 2, messages):
        return 2
    if home != 0 || messages != 1:
        return 3
    if scene.WebSceneRouteCount(graph) != 2:
        return 4
    if scene.WebSceneAddRoute(graph, "home_default", 30, 3, home):
        return 5

    if !scene.WebSceneAddLayer(graph, home, 1, "content", 0):
        return 37
    if !scene.WebSceneAddLayer(graph, home, 2, "fixed", 1):
        return 38
    if !scene.WebSceneAddLayer(graph, messages, 2, "content", 0):
        return 39
    if scene.WebSceneAddLayer(graph, home, 1, "content", 0):
        return 40
    if scene.WebSceneLayerCount(graph) != 3:
        return 41
    if scene.WebSceneLayerNameAt(graph, 1) != "fixed":
        return 42
    if scene.WebSceneLayerIdAt(graph, 2) != 2:
        return 43
    return 0

fn WebSceneRuntimeSmokeAddResources(graph: var scene.WebSceneGraph): int32 =
    if !scene.WebSceneAddResource(graph, "font_subset", "font.0", "", "AA==", "font-hash", 2, 400, 0):
        return 180
    let fontData = fontfixture.MakeWebFontSfntFixture()
    if !scene.WebSceneSetResourceFontBytes(graph, "font_subset", "font.0", fontData):
        return 347
    if !scene.WebSceneAddResource(graph, "svg_icon", "Plus", "lucide-static-icon", "", "plus-hash", 0, 0, 0):
        return 181
    if !scene.WebSceneAddResource(graph, "png_image_data", "image.probe", "", "data:image/png;base64,AA==", "image-hash", 26, 0, 0):
        return 182
    var resourcePixels: int32[]
    add(resourcePixels, int32(0xFF010203))
    add(resourcePixels, int32(0xFF040506))
    add(resourcePixels, int32(0xFF070809))
    add(resourcePixels, int32(0xFF0A0B0C))
    if !scene.WebSceneSetResourceRasterPixels(graph, "png_image_data", "image.probe", 2, 2, resourcePixels):
        return 193
    if scene.WebSceneSetResourceRasterPixels(graph, "png_image_data", "image.probe", 2, 3, resourcePixels):
        return 194
    if scene.WebSceneAddResource(graph, "svg_icon", "Plus", "lucide-static-icon", "", "plus-hash", 0, 0, 0):
        return 183
    if scene.WebSceneAddResource(graph, "", "bad", "", "", "", 0, 0, 0):
        return 184
    if scene.WebSceneResourceCount(graph) != 3:
        return 185
    if scene.WebSceneResourceKindAt(graph, 0) != "font_subset":
        return 186
    if scene.WebSceneResourceIdAt(graph, 1) != "Plus":
        return 187
    if scene.WebSceneResourceByteSizeAt(graph, 2) != 26:
        return 188
    if scene.WebSceneResourceFontWeightAt(graph, 0) != 400:
        return 189
    if scene.WebSceneResourceDataAt(graph, 2) != "data:image/png;base64,AA==":
        return 190
    if scene.WebSceneResourceWidthAt(graph, 2) != 2 || scene.WebSceneResourceHeightAt(graph, 2) != 2:
        return 195
    if scene.WebSceneResourcePixelCountAt(graph, 2) != 4:
        return 196
    if scene.WebSceneResourcePixelAt(graph, 2, 3) != int32(0xFF0A0B0C):
        return 197
    var atlas: scene.WebSceneImageAtlas
    if !scene.WebSceneBuildImageAtlasFromResources(graph, atlas):
        return 198
    if scene.WebSceneImageAtlasTextureCount(atlas) != 1:
        return 199
    if scene.WebSceneImageAtlasResourceIdAt(atlas, 0) != "image.probe":
        return 200
    if scene.WebSceneImageAtlasWidthAt(atlas, 0) != 2 || scene.WebSceneImageAtlasHeightAt(atlas, 0) != 2:
        return 201
    if scene.WebSceneImageAtlasPixelCountAt(atlas, 0) != 4:
        return 202
    if scene.WebSceneImageAtlasPixelAt(atlas, 0, 2) != int32(0xFF070809):
        return 203
    var imageEntryWords: int32[]
    var imagePixelWords: int32[]
    if !scene.WebSceneEncodeImageAtlasHostBatch(atlas, imageEntryWords, imagePixelWords):
        return 388
    if imageEntryWords.len != scene.WebSceneImageAtlasTextureCount(atlas) * scene.WebSceneImageAtlasHostStrideI32:
        return 389
    if imagePixelWords.len != 4:
        return 390
    if imageEntryWords[0] != scene.WebSceneImageAtlasTextureIdForResource(atlas, "image.probe"):
        return 391
    if imageEntryWords[1] != 2 || imageEntryWords[2] != 2:
        return 392
    if imageEntryWords[3] != 0 || imageEntryWords[4] != 4:
        return 393
    if imagePixelWords[2] != int32(0xFF070809):
        return 394
    return 0

fn WebSceneRuntimeSmokeResourceTableIndexedSetters(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    let hash = "f6f4688ff23d50c67053963c251fa0ce64a925cf283537cf066b1f362cb9b778"
    for i in 0..<24:
        let resourceId = Fmt"Icon{i}"
        let addStatus = scene.WebSceneAddResourceEntryStatus(graph, "svg_icon", resourceId)
        if addStatus != 0:
            return 7810 + i
        if scene.WebSceneResourceCount(graph) != i + 1:
            return 7840 + i
        if !scene.WebSceneSetResourceSourceAt(graph, i, "lucide-static-icon"):
            return 7870 + i
        if !scene.WebSceneSetResourceDataAt(graph, i, ""):
            return 7900 + i
        if !scene.WebSceneSetResourceHashAt(graph, i, hash):
            return 7930 + i
        if !scene.WebSceneSetResourceMetricsAt(graph, i, 0, 0, 0):
            return 7960 + i
    if scene.WebSceneResourceIdAt(graph, 21) != "Icon21":
        return 7991
    return 0

fn WebSceneRuntimeSmokeAddNodesAndLayouts(graph: var scene.WebSceneGraph,
