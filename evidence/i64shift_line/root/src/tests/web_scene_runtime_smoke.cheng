fn WebSceneRuntimeSmokeBuildFullAtlases(graph: var scene.WebSceneGraph,
                                        home: int32,
                                        imageAtlas: var scene.WebSceneImageAtlas,
                                        svgAtlas: var scene.WebSceneSvgDisplayListAtlas,
                                        glyphAtlas: var scene.WebSceneGlyphAtlas,
                                        plusDisplayList: var int32,
                                        homeGlyphRun: var int32,
                                        homeFontAtlas: var int32): int32 =
    if !scene.WebSceneBuildImageAtlasFromResources(graph, imageAtlas):
        return 198
    if !scene.WebSceneBuildSvgDisplayListAtlasFromPaintOps(graph, svgAtlas):
        return 223
    if scene.WebSceneSvgDisplayListCount(svgAtlas) != 1:
        return 224
    if scene.WebSceneSvgDisplayListResourceIdAt(svgAtlas, 0) != "Plus":
        return 225
    if scene.WebSceneSvgDisplayListPrimitiveCountAt(svgAtlas, 0) != 2:
        return 226
    if scene.WebSceneSvgDisplayListPrimitiveKindAt(svgAtlas, 0, 0) != paint.PaintSvgPrimitiveLine:
        return 227
    plusDisplayList = scene.WebSceneSvgDisplayListIdForResource(svgAtlas, "Plus")
    if plusDisplayList <= 0:
        return 228
    var svgEntryWords: int32[]
    var svgPrimitiveWords: int32[]
    if !scene.WebSceneEncodeSvgDisplayListHostBatch(svgAtlas, svgEntryWords, svgPrimitiveWords):
        return 379
    if svgEntryWords.len != scene.WebSceneSvgDisplayListCount(svgAtlas) * scene.WebSceneSvgDisplayListEntryHostStrideI32:
        return 380
    if svgPrimitiveWords.len != 2 * scene.WebSceneSvgPrimitiveHostStrideI32:
        return 381
    if svgEntryWords[0] != plusDisplayList:
        return 382
    if svgEntryWords[1] != 0:
        return 383
    if svgEntryWords[2] != 2:
        return 384
    if svgPrimitiveWords[0] != paint.PaintSvgPrimitiveLine:
        return 385
    if svgPrimitiveWords[1] != 1200 || svgPrimitiveWords[2] != 500:
        return 386
    if svgPrimitiveWords[3] != 1200 || svgPrimitiveWords[4] != 1900:
        return 387
    if !scene.WebSceneBuildGlyphAtlasFromPaintOps(graph, glyphAtlas):
        return 240
    if scene.WebSceneGlyphAtlasFontCount(glyphAtlas) != 1:
        return 241
    if scene.WebSceneGlyphAtlasRunCount(glyphAtlas) != 2:
        return 242
    if scene.WebSceneGlyphAtlasGlyphCount(glyphAtlas) != 2:
        return 243
    if scene.WebSceneGlyphAtlasHeight(glyphAtlas) <= 0:
        return 244
    if scene.WebSceneGlyphAtlasFontSdfAtlasIdAt(glyphAtlas, 0) <= 0:
        return 338
    if scene.WebSceneGlyphAtlasGlyphSdfAtlasIdAt(glyphAtlas, 0) <= 0:
        return 339
    if scene.WebSceneGlyphAtlasGlyphSdfSpreadPxAt(glyphAtlas, 0) != scene.WebSceneGlyphSdfSpreadPx:
        return 340
    if scene.WebSceneGlyphAtlasGlyphSdfPxRangeAt(glyphAtlas, 0) != scene.WebSceneGlyphSdfPxRange:
        return 341
    if scene.WebSceneGlyphAtlasGlyphFontGlyphIndexAt(glyphAtlas, 0) <= 0:
        return 348
    if scene.WebSceneGlyphAtlasGlyphSdfPixelCountAt(glyphAtlas, 0) <= 0:
        return 349
    if scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas) <= 0:
        return 350
    var glyphSdfHasInk = false
    for sdfIndex in 0..<scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas):
        let sdfPixel = scene.WebSceneGlyphAtlasSdfPixelAt(glyphAtlas, sdfIndex)
        if sdfPixel < 0 || sdfPixel > 255:
            return 351
        if sdfPixel > 0:
            glyphSdfHasInk = true
    if !glyphSdfHasInk:
        return 352
    if scene.WebSceneGlyphAtlasGlyphSdfPixelAt(glyphAtlas, 0, 0) < 0:
        return 353
    if scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas) != scene.WebSceneGlyphAtlasWidth(glyphAtlas) * scene.WebSceneGlyphAtlasHeight(glyphAtlas):
        return 363
    var glyphSdfAtlasBatch: int32[]
    if !scene.WebSceneEncodeGlyphSdfAtlasHostBatch(glyphAtlas, glyphSdfAtlasBatch):
        return 354
    if glyphSdfAtlasBatch.len != scene.WebSceneGlyphAtlasFontCount(glyphAtlas) * scene.WebSceneGlyphSdfAtlasHostStrideI32:
        return 355
    if glyphSdfAtlasBatch[0] != scene.WebSceneGlyphAtlasFontSdfAtlasIdAt(glyphAtlas, 0):
        return 356
    if glyphSdfAtlasBatch[1] != scene.WebSceneGlyphAtlasWidth(glyphAtlas):
        return 357
    if glyphSdfAtlasBatch[2] != scene.WebSceneGlyphAtlasHeight(glyphAtlas):
        return 358
    if glyphSdfAtlasBatch[4] != scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas):
        return 359
    if glyphSdfAtlasBatch[5] != scene.WebSceneGlyphAtlasFontIdAt(glyphAtlas, 0):
        return 360
    if glyphSdfAtlasBatch[6] != scene.WebSceneGlyphSdfSpreadPx:
        return 361
    if glyphSdfAtlasBatch[7] != scene.WebSceneGlyphSdfPxRange:
        return 362
    var glyphSdfGlyphBatch: int32[]
    var glyphSdfRunBatch: int32[]
    var glyphSdfRunGlyphBatch: int32[]
    if !scene.WebSceneEncodeGlyphSdfMetadataHostBatch(glyphAtlas, glyphSdfGlyphBatch, glyphSdfRunBatch, glyphSdfRunGlyphBatch):
        return 364
    if glyphSdfGlyphBatch.len != scene.WebSceneGlyphAtlasGlyphCount(glyphAtlas) * scene.WebSceneGlyphSdfGlyphHostStrideI32:
        return 365
    if glyphSdfRunBatch.len != scene.WebSceneGlyphAtlasRunCount(glyphAtlas) * scene.WebSceneGlyphSdfRunHostStrideI32:
        return 366
    if glyphSdfRunGlyphBatch.len != 4 * scene.WebSceneGlyphSdfRunGlyphHostStrideI32:
        return 367
    if glyphSdfGlyphBatch[0] != scene.WebSceneGlyphAtlasGlyphIdAt(glyphAtlas, 0):
        return 368
    if glyphSdfGlyphBatch[2] != scene.WebSceneGlyphAtlasGlyphAtlasXAt(glyphAtlas, 0):
        return 369
    if glyphSdfGlyphBatch[3] != scene.WebSceneGlyphAtlasGlyphAtlasYAt(glyphAtlas, 0):
        return 370
    if glyphSdfGlyphBatch[4] != scene.WebSceneGlyphAtlasGlyphWidthAt(glyphAtlas, 0):
        return 371
    if glyphSdfGlyphBatch[5] != scene.WebSceneGlyphAtlasGlyphHeightAt(glyphAtlas, 0):
        return 372
    if glyphSdfGlyphBatch[8] != scene.WebSceneGlyphAtlasGlyphSdfPixelStartAt(glyphAtlas, 0):
        return 373
    if glyphSdfRunBatch[0] != scene.WebSceneGlyphAtlasRunIdAt(glyphAtlas, 0):
        return 374
    if glyphSdfRunBatch[3] != scene.WebSceneGlyphAtlasRunGlyphStartAt(glyphAtlas, 0):
        return 375
    if glyphSdfRunBatch[4] != scene.WebSceneGlyphAtlasRunGlyphCountAt(glyphAtlas, 0):
        return 376
    if glyphSdfRunGlyphBatch[0] != scene.WebSceneGlyphAtlasRunGlyphIdAt(glyphAtlas, 0):
        return 377
    if glyphSdfRunGlyphBatch[1] != scene.WebSceneGlyphAtlasRunGlyphAdvanceAt(glyphAtlas, 0):
        return 378
    var glyphSdfPixels: uint8[]
    setLen(glyphSdfPixels, scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas))
    for pixelIndex in 0..<scene.WebSceneGlyphAtlasSdfPixelCount(glyphAtlas):
        glyphSdfPixels[pixelIndex] = uint8(scene.WebSceneGlyphAtlasSdfPixelAt(glyphAtlas, pixelIndex))
    var loadGraph: scene.WebSceneGraph
    var loadHome: int32
    var loadMessages: int32
    let loadStatus = WebSceneRuntimeSmokeBuildStandardGraph(loadGraph, loadHome, loadMessages)
    if loadStatus != 0:
        return loadStatus
    if !scene.WebSceneAddNode(loadGraph, loadHome, 9900, 10, 3, "", "ZZ", 1):
        return 388
    if !scene.WebSceneAddLayoutConstraint(loadGraph, loadHome, 9900, 0, "display", "none"):
        return 389
    if !scene.WebSceneAddPaintOpAt(loadGraph, loadHome, 9900, 0, 0, 0, scene.WebScenePaintText, Int64(4278190080), 0, 0, 0, "", "ZZ"):
        return 390
    var loadedGlyphAtlas: scene.WebSceneGlyphAtlas
    if !scene.WebSceneLoadPrecomputedGlyphSdfAtlasHostBatches(loadGraph, loadedGlyphAtlas, glyphSdfAtlasBatch, glyphSdfGlyphBatch, glyphSdfRunBatch, glyphSdfRunGlyphBatch, glyphSdfPixels):
        return 391
    if scene.WebSceneGlyphAtlasRunCount(loadedGlyphAtlas) != scene.WebSceneGlyphAtlasRunCount(glyphAtlas):
        return 392
    if scene.WebSceneGlyphAtlasRunIdForPaint(loadedGlyphAtlas, loadHome, 9900, 0) != -1:
        return 393
    homeGlyphRun = scene.WebSceneGlyphAtlasRunIdForPaint(glyphAtlas, home, 11, 0)
    if homeGlyphRun <= 0:
        return 245
    homeFontAtlas = scene.WebSceneGlyphAtlasRunFontAtlasIdForPaint(glyphAtlas, home, 11, 0)
    if homeFontAtlas <= 0:
        return 246
    if scene.WebSceneGlyphAtlasRunSdfAtlasIdForPaint(glyphAtlas, home, 11, 0) <= 0:
        return 342
    if scene.WebSceneGlyphAtlasRunGlyphCountForPaint(glyphAtlas, home, 11, 0) != 2:
        return 247
    return 0

