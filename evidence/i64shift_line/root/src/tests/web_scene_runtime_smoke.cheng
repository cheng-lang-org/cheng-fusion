fn WebSceneRuntimeSmokeStateConditionMatcherFormats(): int32 =
    # __eq_or:<sentinel>:<expected> — marketplace category filter (state=selectedCategory)
    if !scene.WebSceneStateValueMatchesCondition("全部", "__eq_or:全部:命理"):
        return 5700
    if !scene.WebSceneStateValueMatchesCondition("命理", "__eq_or:全部:命理"):
        return 5701
    if scene.WebSceneStateValueMatchesCondition("游戏", "__eq_or:全部:命理"):
        return 5702
    if scene.WebSceneStateConditionWitnessValue("__eq_or:全部:命理") != "命理":
        return 5703
    # __eq_any:<v1>|<v2>|... — empty-category set (state=selectedCategory)
    if !scene.WebSceneStateValueMatchesCondition("娱乐", "__eq_any:娱乐|工具|金融"):
        return 5704
    if !scene.WebSceneStateValueMatchesCondition("金融", "__eq_any:娱乐|工具|金融"):
        return 5705
    if scene.WebSceneStateValueMatchesCondition("全部", "__eq_any:娱乐|工具|金融"):
        return 5706
    if scene.WebSceneStateConditionWitnessValue("__eq_any:娱乐|工具|金融") != "娱乐":
        return 5707
    # __substr_of:<lowercased-text> — marketplace search filter (state=searchQuery)
    if !scene.WebSceneStateValueMatchesCondition("", "__substr_of:八字排盘专业四柱"):
        return 5708
    if !scene.WebSceneStateValueMatchesCondition("四柱", "__substr_of:八字排盘专业四柱"):
        return 5709
    if scene.WebSceneStateValueMatchesCondition("紫微", "__substr_of:八字排盘专业四柱"):
        return 5710
    if !scene.WebSceneStateValueMatchesCondition("ABC", "__substr_of:xyzabcdef"):
        return 5711
    if scene.WebSceneStateValueMatchesCondition("ABC", "__substr_of:xyzdef"):
        return 5712
    if scene.WebSceneStateConditionWitnessValue("__substr_of:xyzabcdef") != "":
        return 5713
    # __array_nonempty — publish button media gate (state=mediaFiles, a JSON-array string).
    # An empty array "[]" is a non-empty *string* but has zero items → must NOT pass; a garbage
    # or empty string must NOT pass; only a real top-level array with items passes.
    if scene.WebSceneStateValueMatchesCondition("[]", "__array_nonempty"):
        return 5714
    if !scene.WebSceneStateValueMatchesCondition("[\"a\"]", "__array_nonempty"):
        return 5715
    if !scene.WebSceneStateValueMatchesCondition("[{\"k\":1},{\"k\":2}]", "__array_nonempty"):
        return 5716
    if scene.WebSceneStateValueMatchesCondition("", "__array_nonempty"):
        return 5717
    if scene.WebSceneStateValueMatchesCondition("not-json", "__array_nonempty"):
        return 5718
    let arrayWitness = scene.WebSceneStateConditionWitnessValue("__array_nonempty")
    if !scene.WebSceneStateValueMatchesCondition(arrayWitness, "__array_nonempty"):
        return 5719
    # __array_length_lt:N / __array_length_gte:N — JSON-array item-count bounds
    # (React `images.length < 9` add-photo gate). An unset/empty state counts as
    # 0 items for both, matching the React initial `[]`.
    if !scene.WebSceneStateValueMatchesCondition("[]", "__array_length_lt:9"):
        return 5750
    if scene.WebSceneStateValueMatchesCondition("[\"a\",\"b\"]", "__array_length_lt:2"):
        return 5751
    if !scene.WebSceneStateValueMatchesCondition("", "__array_length_lt:1"):
        return 5752
    if !scene.WebSceneStateValueMatchesCondition("[\"a\"]", "__array_length_gte:1"):
        return 5753
    if scene.WebSceneStateValueMatchesCondition("[]", "__array_length_gte:1"):
        return 5754
    let arrayLtWitness = scene.WebSceneStateConditionWitnessValue("__array_length_lt:9")
    if !scene.WebSceneStateValueMatchesCondition(arrayLtWitness, "__array_length_lt:9"):
        return 5755
    let arrayGteWitness = scene.WebSceneStateConditionWitnessValue("__array_length_gte:3")
    if !scene.WebSceneStateValueMatchesCondition(arrayGteWitness, "__array_length_gte:3"):
        return 5756
    # __num_positive — trimmed decimal literal strictly greater than zero;
    # signs other than a leading '+', a second dot, or any letter must fail.
    if !scene.WebSceneStateValueMatchesCondition("9.9", "__num_positive"):
        return 5757
    if !scene.WebSceneStateValueMatchesCondition("1", "__num_positive"):
        return 5758
    if scene.WebSceneStateValueMatchesCondition("", "__num_positive"):
        return 5759
    if scene.WebSceneStateValueMatchesCondition("0", "__num_positive"):
        return 5760
    if scene.WebSceneStateValueMatchesCondition("-2", "__num_positive"):
        return 5761
    if scene.WebSceneStateValueMatchesCondition("abc", "__num_positive"):
        return 5762
    let numPositiveWitness = scene.WebSceneStateConditionWitnessValue("__num_positive")
    if numPositiveWitness != "1":
        return 5763
    if !scene.WebSceneStateValueMatchesCondition(numPositiveWitness, "__num_positive"):
        return 5764
    # whitespace-only trims to empty, so __num_positive must honestly fail.
    if scene.WebSceneStateValueMatchesCondition(" ", "__num_positive"):
        return 5765
    # __num_finite uses parseFloat-prefix semantics: "0" is finite even though it
    # is not positive — the decisive difference from __num_positive (already
    # asserted false at 5760). Garbage and overflow (1e999 -> non-finite) fail.
    if !scene.WebSceneStateValueMatchesCondition("0", "__num_finite"):
        return 5766
    if !scene.WebSceneStateValueMatchesCondition("1", "__num_finite"):
        return 5767
    if scene.WebSceneStateValueMatchesCondition("abc", "__num_finite"):
        return 5768
    if scene.WebSceneStateValueMatchesCondition("1e999", "__num_finite"):
        return 5769
    let numFiniteWitness = scene.WebSceneStateConditionWitnessValue("__num_finite")
    if numFiniteWitness != "1":
        return 5770
    if !scene.WebSceneStateValueMatchesCondition(numFiniteWitness, "__num_finite"):
        return 5771
    return 0

# End-to-end publish gate: the video publish pages front handlePublish with a guard chain matching
# `canPublish = title && hasRequiredMedia && publishNoticeOpen`.
# Tapping with an empty media array ("[]") must be a no-op (guard fails); seeding a real media entry
# is still blocked until the publish notice switch is opened.
fn WebSceneRuntimeSmokePublishMediaGuard(): int32 =
    var graph: scene.WebSceneGraph
    var home = -1
    var messages = -1
    let buildStatus = WebSceneRuntimeSmokeBuildStandardGraph(graph, home, messages)
    if buildStatus != 0:
        return buildStatus
    let publishEffect = "guard_state:title=__truthy;guard_state:mediaFiles=__array_nonempty;guard_state:publishNoticeOpen=__truthy;guard_state:isPublishing=__falsy;guard_state:isPreparingMedia=__falsy;external-publish:content"
    # Nothing seeded: title empty → guard chain fails → no publish arm.
    if scene.WebSceneEventEffectGuardsPass(graph, publishEffect):
        return 8950
    # Title filled but media still an empty array "[]": the media gate honestly holds (no-op).
    if !scene.WebSceneSetStateValue(graph, "title", "My Video"):
        return 8951
    if !scene.WebSceneSetStateValue(graph, "mediaFiles", "[]"):
        return 8952
    if scene.WebSceneEventEffectGuardsPass(graph, publishEffect):
        return 8953
    # A real media entry lands but publish notice is still closed → guard must still hold.
    if !scene.WebSceneSetStateValue(graph, "mediaFiles", "[\"clip.mp4\"]"):
        return 8954
    if scene.WebSceneEventEffectGuardsPass(graph, publishEffect):
        return 8955
    # Opening the publish notice switch now satisfies every conjunct.
    if !scene.WebSceneSetStateValue(graph, "publishNoticeOpen", "true"):
        return 8958
    if !scene.WebSceneEventEffectGuardsPass(graph, publishEffect):
        return 8959
    # isPublishing in flight must re-block even with title + media present.
    if !scene.WebSceneSetStateValue(graph, "isPublishing", "true"):
        return 8956
    if scene.WebSceneEventEffectGuardsPass(graph, publishEffect):
        return 8957
    if !scene.WebSceneSetStateValue(graph, "isPublishing", ""):
        return 8960
    if !scene.WebSceneSetStateValue(graph, "isPreparingMedia", "true"):
        return 8961
    if scene.WebSceneEventEffectGuardsPass(graph, publishEffect):
        return 8962
    return 0

# guard_any OR gate: `guard_any:a=p,b=p|c=p,d=p` allows the event when at least
# one `|`-group has every `,`-term satisfied. Both groups unsatisfied must block;
# a partially satisfied group must still block (AND inside a group); completing
# either group must unlock (OR across groups). Malformed bodies (empty body,
# empty group, term without '=') must block even when another group is satisfied.
fn WebSceneRuntimeSmokeGuardAnyOrGuard(): int32 =
    var graph: scene.WebSceneGraph
    var home = -1
    var messages = -1
    let buildStatus = WebSceneRuntimeSmokeBuildStandardGraph(graph, home, messages)
    if buildStatus != 0:
        return buildStatus
    let moderateEffect = "guard_any:vipLevel=__num_positive,vipActive=__truthy|adminMode=__truthy,auditPassed=true;external-moderate:content"
    # Nothing seeded: both OR groups fail → blocked.
    if scene.WebSceneEventEffectGuardsPass(graph, moderateEffect):
        return 5770
    # Partially satisfying the second group (adminMode only) keeps its AND unsatisfied.
    if !scene.WebSceneSetStateValue(graph, "adminMode", "true"):
        return 5771
    if scene.WebSceneEventEffectGuardsPass(graph, moderateEffect):
        return 5772
    # Completing the second group unlocks via OR even though the first still fails.
    if !scene.WebSceneSetStateValue(graph, "auditPassed", "true"):
        return 5773
    if !scene.WebSceneEventEffectGuardsPass(graph, moderateEffect):
        return 5774
    # Break the second group again, then satisfy the first group alone.
    if !scene.WebSceneSetStateValue(graph, "auditPassed", "false"):
        return 5775
    if scene.WebSceneEventEffectGuardsPass(graph, moderateEffect):
        return 5776
    if !scene.WebSceneSetStateValue(graph, "vipLevel", "2.5"):
        return 5777
    if !scene.WebSceneSetStateValue(graph, "vipActive", "true"):
        return 5778
    if !scene.WebSceneEventEffectGuardsPass(graph, moderateEffect):
        return 5779
    # Malformed guard_any bodies block even though adminMode=__truthy holds:
    # trailing empty group, term without '=', empty body.
    if scene.WebSceneEventEffectGuardsPass(graph, "guard_any:adminMode=__truthy|;external-moderate:content"):
        return 5780
    if scene.WebSceneEventEffectGuardsPass(graph, "guard_any:adminMode;external-moderate:content"):
        return 5781
    if scene.WebSceneEventEffectGuardsPass(graph, "guard_any:;external-moderate:content"):
        return 5782
    # A well-formed satisfied guard_any stays inert on the apply path (no state
    # mutation, no unknown-effect error).
    if scene.WebSceneApplyEventEffectSegment(graph, "guard_any:adminMode=__truthy", true) != 0:
        return 5783
    # guard_any composes with guard_state conjuncts in the same effect chain.
    let mixedEffect = "guard_state:adminMode=__truthy;guard_any:vipActive=__truthy|auditPassed=true;external-moderate:content"
    if !scene.WebSceneEventEffectGuardsPass(graph, mixedEffect):
        return 5784
    if !scene.WebSceneSetStateValue(graph, "adminMode", "false"):
        return 5785
    if scene.WebSceneEventEffectGuardsPass(graph, mixedEffect):
        return 5786
    return 0

# State-walk: apply an unquoted `set:` value (the canonical form the materializer
# now emits — `set:selectedCategory=游戏`, no source quotes) and confirm the
# __eq_or condition nodes flip visibility. A quoted set value ('游戏') would write
# "'游戏'" into the state table, never equal the condition's unquoted expected
# value, and this walk would catch the frozen list (0 flips).
fn WebSceneRuntimeSmokeStateSetConditionFlip(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "state_set_condition_flip", 1, 1, route):
        return 5730
    if !scene.WebSceneAddLayer(graph, route, 1, "content", 0):
        return 5731
    if !scene.WebSceneAddNode(graph, route, 1, 0, 2, "div", "", 1):
        return 5732
    if scene.WebSceneAddNodeWithStateConditionStatus(graph, route, 2, 1, 2, "div", "", 1, "selectedCategory", "__eq_or:全部:游戏") != 0:
        return 5733
    if scene.WebSceneAddNodeWithStateConditionStatus(graph, route, 3, 1, 2, "div", "", 1, "selectedCategory", "__eq_or:全部:命理") != 0:
        return 5734
    if !scene.WebSceneAddLayoutConstraint(graph, route, 1, 0, "width", "120px"):
        return 5735
    if !scene.WebSceneAddLayoutConstraint(graph, route, 2, 0, "height", "20px"):
        return 5736
    if !scene.WebSceneAddLayoutConstraint(graph, route, 3, 0, "height", "20px"):
        return 5737
    var tree: layout.WebLayoutTree
    if !scene.WebSceneSetStateValue(graph, "selectedCategory", "全部"):
        return 5738
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 120, 80, tree):
        return 5739
    if scene.WebSceneFindLayoutBoxIndex(tree, 2) < 0:
        return 5740
    if scene.WebSceneFindLayoutBoxIndex(tree, 3) < 0:
        return 5741
    if !scene.WebSceneSetStateValue(graph, "selectedCategory", "游戏"):
        return 5742
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 120, 80, tree):
        return 5743
    if scene.WebSceneFindLayoutBoxIndex(tree, 2) < 0:
        return 5744
    if scene.WebSceneFindLayoutBoxIndex(tree, 3) >= 0:
        return 5745
    if !scene.WebSceneSetStateValue(graph, "selectedCategory", "命理"):
        return 5746
    if !scene.WebSceneBuildRouteLayoutTree(graph, route, 120, 80, tree):
        return 5747
    if scene.WebSceneFindLayoutBoxIndex(tree, 2) >= 0:
        return 5748
    if scene.WebSceneFindLayoutBoxIndex(tree, 3) < 0:
        return 5749
    return 0

fn WebSceneRuntimeSmokeStateBoundTextLayout(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route = -1
    if !scene.WebSceneAddRoute(graph, "state_bound_text_layout", 1, 1, route):
