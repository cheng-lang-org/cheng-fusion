    if !scene.WebSceneLayerCacheMarkValid(graph, messages, 2, commands):
        return 119
    if scene.WebSceneLayerCacheCount(graph) != 3:
        return 120
    return 0

fn WebSceneRuntimeSmokeRouteDirtyDiff(): int32 =
    var graph: scene.WebSceneGraph
    var home = -1
    var messages = -1
    let buildStatus = WebSceneRuntimeSmokeBuildStandardGraph(graph, home, messages)
    if buildStatus != 0:
        return buildStatus
    let cacheStatus = WebSceneRuntimeSmokePrimeLayerCaches(graph, home, messages)
    if cacheStatus != 0:
        return cacheStatus

    if !scene.WebSceneAddRouteEdge(graph, home, 12, messages):
        return 13
    if scene.WebSceneAddRouteEdge(graph, home, 999, messages):
        return 75
    if scene.WebSceneFindRouteTargetForNode(graph, home, 12) != messages:
        return 14
    if !scene.WebSceneAddProp(graph, home, 12, 0, "onClick", "setTab('messages')", "event_handler"):
        return 491
    if !scene.WebSceneAddEventHandler(graph, home, 12, 0, 0, "onClick", "click", "setTab('messages')", "event_handler"):
        return 492
    if !scene.WebSceneAddHitTarget(graph, home, 12, 0, 0, "route", "tab_messages", "", messages, "Messages"):
        return 493
    if scene.WebSceneAddEventHandler(graph, home, 12, 0, 0, "onClick", "click", "setTab('messages')", "event_handler"):
        return 494
    if scene.WebSceneAddHitTarget(graph, home, 12, 0, 0, "route", "tab_messages", "", messages, "Messages"):
        return 495
    if scene.WebScenePropCount(graph) != 1:
        return 496
    if scene.WebSceneEventHandlerCount(graph) != 1:
        return 497
    if scene.WebSceneHitTargetCount(graph) != 1:
        return 498
    let eventIndex = scene.WebSceneFindEventHandlerForNode(graph, home, 12, "onClick")
    if eventIndex < 0:
        return 499
    if scene.WebSceneEventHandlerEventNameAt(graph, eventIndex) != "click":
        return 500
    if scene.WebSceneEventHandlerHandlerAt(graph, eventIndex) != "setTab('messages')":
        return 501
    let hitIndex = scene.WebSceneFindHitTargetForNode(graph, home, 12)
    if hitIndex < 0:
        return 502
    if scene.WebSceneHitTargetKindAt(graph, hitIndex) != "route":
        return 503
    if scene.WebSceneHitTargetRouteIndexAt(graph, hitIndex) != messages:
        return 504

    if !scene.WebSceneSetActiveRouteById(graph, "home_default"):
        return 15
    if scene.WebSceneActiveRouteIndex(graph) != home:
        return 16
    if scene.WebSceneVersion(graph) != 1:
        return 17
    if scene.WebSceneDirtyCount(graph) != 1:
        return 18
    if scene.WebSceneDirtyRouteAt(graph, 0) != home:
        return 19
    if scene.WebSceneDirtyNodeAt(graph, 0) != 10:
        return 20
    if scene.WebSceneDirtyReasonAt(graph, 0) != scene.WebSceneDirtyRoute:
        return 21
    if !scene.WebSceneInvalidateLayerCachesForDirtySpans(graph):
        return 121
    if scene.WebSceneLayerCacheValid(graph, home, 1):
        return 122
    if scene.WebSceneLayerCacheValid(graph, home, 2):
        return 123
    if !scene.WebSceneLayerCacheValid(graph, messages, 2):
        return 124
    if scene.WebSceneLayerCacheDirtyWidth(graph, home, 1) != 100:
        return 125
    if scene.WebSceneLayerCacheDirtyX(graph, home, 2) != 20 || scene.WebSceneLayerCacheDirtyWidth(graph, home, 2) != 12:
        return 126

    var commands: scene.WebScenePaintCommandBuffer
    if !scene.WebSceneBuildActiveRoutePaintCommands(graph, 1, commands):
        return 86
    if scene.WebScenePaintCommandCount(commands) != 3:
        return 87
    if !scene.WebSceneLayerCacheMarkValid(graph, home, 1, commands):
        return 127
    if !scene.WebSceneBuildRouteLayerPaintCommands(graph, home, 2, commands):
        return 128
    if !scene.WebSceneLayerCacheMarkValid(graph, home, 2, commands):
        return 129

    scene.WebSceneClearDirty(graph)
    if !scene.WebSceneApplyRouteEdge(graph, 12):
        return 22
    if scene.WebSceneActiveRouteIndex(graph) != messages:
        return 23
    if scene.WebSceneVersion(graph) != 2:
        return 24
    if scene.WebSceneDirtyCount(graph) != 2:
        return 25
    if scene.WebSceneDirtyRouteAt(graph, 0) != home:
        return 26
    if scene.WebSceneDirtyNodeAt(graph, 0) != 10:
        return 27
    if scene.WebSceneDirtyRouteAt(graph, 1) != messages:
        return 28
    if scene.WebSceneDirtyNodeAt(graph, 1) != 20:
        return 29
    if !scene.WebSceneInvalidateLayerCachesForDirtySpans(graph):
        return 130
    if scene.WebSceneLayerCacheValid(graph, home, 1):
        return 131
    if scene.WebSceneLayerCacheValid(graph, home, 2):
        return 132
    if scene.WebSceneLayerCacheValid(graph, messages, 2):
        return 133
    if scene.WebSceneLayerCacheDirtyX(graph, messages, 2) != 3:
        return 134
    if scene.WebSceneLayerCacheDirtyWidth(graph, messages, 2) != 16:
        return 135
    if !scene.WebSceneBuildDirtyPaintCommands(graph, 1, commands):
        return 88
    if scene.WebScenePaintCommandCount(commands) != 1:
        return 89
    if scene.WebScenePaintCommandTextAt(commands, 0) != "aa":
        return 90
    if !scene.WebSceneBuildRouteLayerPaintCommands(graph, messages, 2, commands):
        return 136
    if !scene.WebSceneLayerCacheMarkValid(graph, messages, 2, commands):
        return 156

    var stateGraph: scene.WebSceneGraph
    var stateHome = -1
    var stateMessages = -1
    let stateBuildStatus = WebSceneRuntimeSmokeBuildStandardGraph(stateGraph, stateHome, stateMessages)
    if stateBuildStatus != 0:
        return stateBuildStatus
    if !scene.WebSceneAddRouteEdge(stateGraph, stateHome, 12, stateMessages):
        return 512
    if !scene.WebSceneAddEventHandlerWithAction(stateGraph,
                                                stateHome,
                                                12,
                                                0,
                                                0,
                                                "onClick",
                                                "click",
                                                "() => setShowSearch(!showSearch)",
                                                "event_handler",
                                                "route",
                                                "showSearch",
                                                "route:tab_messages;toggle:showSearch"):
        return 513
    let stateEventIndex = scene.WebSceneFindEventHandlerForNode(stateGraph, stateHome, 12, "onClick")
    if stateEventIndex < 0:
        return 514
    if scene.WebSceneEventHandlerActionKindAt(stateGraph, stateEventIndex) != "route":
        return 515
    if scene.WebSceneEventHandlerStateRefAt(stateGraph, stateEventIndex) != "showSearch":
        return 516
    if scene.WebSceneEventHandlerEffectAt(stateGraph, stateEventIndex) != "route:tab_messages;toggle:showSearch":
        return 517
    if !scene.WebSceneSetActiveRouteByIndex(stateGraph, stateHome):
        return 518
    scene.WebSceneClearDirty(stateGraph)
    if !scene.WebSceneApplyRouteEdge(stateGraph, 12):
        return 519
    if scene.WebSceneActiveRouteIndex(stateGraph) != stateMessages:
        return 520
    if scene.WebSceneStateCount(stateGraph) != 1:
        return 521
    if scene.WebSceneStateValueForRef(stateGraph, "showSearch") != "true":
        return 522
    if !scene.WebSceneSetActiveRouteByIndex(stateGraph, stateHome):
        return 523
    if !scene.WebSceneApplyRouteEdge(stateGraph, 12):
        return 524
    if scene.WebSceneStateValueForRef(stateGraph, "showSearch") != "false":
        return 525
    if !scene.WebSceneSetActiveRouteByIndex(stateGraph, stateHome):
        return 526
    if !scene.WebSceneAddNode(stateGraph, stateHome, 30, 10, 4, "button", "", 1):
        return 527
    if !scene.WebSceneAddRouteEdge(stateGraph, stateHome, 30, stateMessages):
        return 528
    if !scene.WebSceneAddEventHandlerWithAction(stateGraph,
                                                stateHome,
                                                30,
                                                1,
                                                0,
                                                "onClick",
                                                "click",
                                                "handleConfirm",
                                                "event_handler",
                                                "route",
                                                "",
                                                "guard_state:selected=__truthy;route:tab_messages"):
        return 529
    if !scene.WebSceneApplyRouteEdge(stateGraph, 30):
        return 530
    if scene.WebSceneActiveRouteIndex(stateGraph) != stateHome:
        return 531
    if !scene.WebSceneSetStateValue(stateGraph, "selected", "zh-CN"):
        return 532
    if !scene.WebSceneApplyRouteEdge(stateGraph, 30):
        return 533
    if scene.WebSceneActiveRouteIndex(stateGraph) != stateMessages:
        return 534

    return 0

