        return 772

    var emptyCommands: scene.WebScenePaintCommandBuffer
    if !scene.WebSceneBuildRouteLayerPaintCommands(graph, target, 4, emptyCommands):
        return 773
    if scene.WebScenePaintCommandCount(emptyCommands) != 0:
        return 774
    if !scene.WebSceneLayerCacheMarkValid(graph, target, 4, emptyCommands):
        return 775
    if scene.WebSceneLayerCacheValid(graph, target, 4):
        return 776

    var imageAtlas: scene.WebSceneImageAtlas
