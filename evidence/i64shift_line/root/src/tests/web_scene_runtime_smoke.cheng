fn WebSceneRuntimeSmokePaintGpuHostBatch(): int32 =
    var graph: scene.WebSceneGraph
    var home = -1
    var messages = -1
    let buildStatus = WebSceneRuntimeSmokeBuildStandardGraph(graph, home, messages)
    if buildStatus != 0:
        return buildStatus

    var imageAtlas: scene.WebSceneImageAtlas
    var svgAtlas: scene.WebSceneSvgDisplayListAtlas
    var glyphAtlas: scene.WebSceneGlyphAtlas
    var plusDisplayList = 0
    var homeGlyphRun = 0
    var homeFontAtlas = 0
    let atlasStatus = WebSceneRuntimeSmokeBuildFullAtlases(graph, home, imageAtlas, svgAtlas, glyphAtlas, plusDisplayList, homeGlyphRun, homeFontAtlas)
    if atlasStatus != 0:
        return atlasStatus

    var commands: scene.WebScenePaintCommandBuffer
    if !scene.WebSceneBuildRouteLayerPaintCommands(graph, home, 1, commands):
        return 77
    if scene.WebScenePaintCommandCount(commands) != 3:
        return 78
    if scene.WebScenePaintCommandKindAt(commands, 0) != paint.PaintOpKindFillRect:
        return 79
    if scene.WebScenePaintCommandColorAt(commands, 0) != 11259375:
        return 80
    if scene.WebScenePaintCommandKindAt(commands, 1) != paint.PaintOpKindFillText:
        return 81
    if scene.WebScenePaintCommandTextAt(commands, 1) != "AA":
        return 82
    if scene.WebScenePaintCommandKindAt(commands, 2) != paint.PaintOpKindIcon:
        return 83
    if scene.WebScenePaintCommandIconKindAt(commands, 2) != paint.PaintIconKindSvg:
        return 84
    if scene.WebScenePaintCommandIconPrimitiveCountAt(commands, 2) != 2:
        return 106

    var bounds: scene.WebSceneRect
    if !scene.WebScenePaintCommandBounds(commands, bounds):
        return 107
    if scene.WebSceneRectEmpty(bounds):
        return 108
    if scene.WebSceneRectX(bounds) != 1 || scene.WebSceneRectY(bounds) != 2:
        return 109
    if scene.WebSceneRectWidth(bounds) != 100 || scene.WebSceneRectHeight(bounds) != 44:
        return 110
    if scene.WebScenePaintCommandRectWidthAt(commands, 1) != 16:
        return 111
    if !scene.WebSceneLayerCacheMarkValid(graph, home, 1, commands):
        return 112
    if !scene.WebSceneLayerCacheValid(graph, home, 1):
        return 113
    if scene.WebSceneLayerCacheCommandCount(graph, home, 1) != 3:
        return 114
    if scene.WebSceneLayerCachePaintBoundsWidth(graph, home, 1) != 100:
        return 115

    var gpu: scene.WebSceneGpuCommandBuffer
    if !scene.WebSceneBuildGpuCommandsFromPaintCommands(commands, gpu):
        return 157
    if scene.WebSceneGpuCommandCount(gpu) != 3:
        return 158
    if scene.WebSceneGpuCommandKindAt(gpu, 0) != scene.WebSceneGpuFillRect:
        return 159
    if scene.WebSceneGpuCommandKindAt(gpu, 1) != scene.WebSceneGpuFillText:
        return 160
    if scene.WebSceneGpuCommandTextAt(gpu, 1) != "AA":
        return 161
    if scene.WebSceneGpuCommandKindAt(gpu, 2) != scene.WebSceneGpuDrawIcon:
        return 162
    if scene.WebSceneGpuCommandIconPrimitiveCountAt(gpu, 2) != 2:
        return 163
    var invalidHostGpuBatch: int32[]
    if scene.WebSceneEncodeGpuCommandHostBatch(gpu, invalidHostGpuBatch):
