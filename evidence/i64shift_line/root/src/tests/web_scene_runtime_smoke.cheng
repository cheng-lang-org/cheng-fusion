    if scene.WebSceneMediaReceiptCount(graph) != 18:
        return 2568
    if scene.WebSceneMediaLifecycleEventCount(graph) != 9:
        return 2581
    if scene.WebSceneMediaLifecycleEventResultStateCodeAt(graph, 8) != scene.WebSceneMediaPlaybackPublished:
        return 2582
    if scene.WebSceneMediaLifecycleEventReceiptIndexAt(graph, 8) != 17:
        return 2583
    let agentFullStreamRes = scene_csg.WebSceneAgentMediaEventStreamFromCursor(graph,
                                                                              0,
                                                                              "agent.media.stream",
