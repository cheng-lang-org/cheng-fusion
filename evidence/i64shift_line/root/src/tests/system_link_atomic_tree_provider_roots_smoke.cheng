import cheng/core/backend/system_link_exec as sexec
import cheng/core/backend/system_link_exec_runtime as runtime
import std/os

fn HasRoot(roots: str[], expected: str): bool =
    for index in 0..<roots.len:
        if roots[index] == expected:
            return true
    return false

fn AssertRoots(roots: str[], expected: str[]) =
    for index in 0..<expected.len:
        assert(HasRoot(roots, expected[index]),
               Fmt" atomic tree provider roots smoke: missing {expected[index]}")

fn main(): int32 =
    var runtimePlan: sexec.SystemLinkExecPlan
    add(runtimePlan.objectPlan.providerModules, "runtime/program_support")
    add(runtimePlan.objectPlan.providerModules,
        "runtime/program_support_host_runtime")
    add(runtimePlan.objectPlan.providerModules,
        "runtime/core_runtime")
    var definitionMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var rootMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var runtimeProgramRoots: str[]
    var err: str
    assert(runtime.SystemLinkExecRuntimeProviderExportRootsInto(
               runtimePlan,
               "runtime/program_support",
               runtimeProgramRoots,
               definitionMetrics,
               rootMetrics,
               err),
           err)
    AssertRoots(runtimeProgramRoots, [
        "cheng_atomic_tree_begin_bridge",
        "cheng_atomic_tree_begin_child_from_verified_root_bridge",
        "cheng_atomic_tree_open_child_from_verified_root_bridge",
        "cheng_atomic_tree_verified_root_child_exists_bridge",
        "cheng_atomic_tree_open_verified_bridge",
        "cheng_atomic_tree_open_verified_exclusive_or_absent_bridge",
        "cheng_atomic_tree_begin_from_exclusive_absent_bridge",
        "cheng_atomic_tree_commit_exclusive_noreplace_and_open_verified_bridge",
        "cheng_atomic_tree_mkdir_bridge",
        "cheng_atomic_tree_write_exclusive_sync_bridge",
        "cheng_atomic_tree_write_exclusive_lease_sync_bridge",
        "cheng_atomic_tree_read_stable_bridge",
        "cheng_atomic_tree_verify_root_exact_bridge",
        "cheng_atomic_tree_commit_noreplace_bridge",
        "cheng_atomic_tree_abort_bridge",
        "cheng_atomic_tree_close_bridge"
    ])
    var runtimeHostRoots: str[]
    assert(runtime.SystemLinkExecRuntimeProviderExportRootsInto(
               runtimePlan,
               "runtime/program_support_host_runtime",
               runtimeHostRoots,
               definitionMetrics,
               rootMetrics,
               err),
           err)
    AssertRoots(runtimeHostRoots, [
        "cheng_host_openat",
        "cheng_host_mkdirat",
        "cheng_host_unlinkat",
        "cheng_host_fsync",
        "cheng_host_flock",
        "cheng_host_fstat_scalars",
        "cheng_host_dup_cloexec_runtime",
        "cheng_host_renameat_noreplace"
    ])
    var coreRuntimeRoots: str[]
    assert(runtime.SystemLinkExecRuntimeProviderExportRootsInto(
               runtimePlan,
               "runtime/core_runtime",
               coreRuntimeRoots,
               definitionMetrics,
               rootMetrics,
               err),
           err)
    AssertRoots(coreRuntimeRoots, [
        "cheng_native_csg_store_identity_registry_lock_bridge",
        "cheng_native_csg_store_identity_registry_unlock_bridge",
        "cheng_native_csg_store_identity_registry_epoch_bridge",
        "cheng_native_csg_store_identity_registry_wait_bridge",
        "cheng_native_csg_store_identity_registry_notify_all_bridge",
        "cheng_native_csg_transaction_authority_registry_lock_bridge",
        "cheng_native_csg_transaction_authority_registry_unlock_bridge",
        "cheng_native_csg_transaction_authority_registry_epoch_bridge",
        "cheng_native_csg_transaction_authority_registry_wait_bridge",
        "cheng_native_csg_transaction_authority_registry_notify_all_bridge",
        "cheng_native_csg_merkle_admission_registry_lock_bridge",
        "cheng_native_csg_merkle_admission_registry_unlock_bridge",
        "cheng_native_csg_merkle_admission_registry_epoch_bridge",
        "cheng_native_csg_merkle_admission_registry_wait_bridge",
        "cheng_native_csg_merkle_admission_registry_notify_all_bridge"
    ])
    var linuxPlan: sexec.SystemLinkExecPlan
    linuxPlan.systemLinkPlan.targetTriple =
        "aarch64-unknown-linux-gnu"
    add(linuxPlan.objectPlan.providerModules, "runtime/program_support")
    add(linuxPlan.objectPlan.providerModules,
        "runtime/program_support_host_runtime")
    var linuxDefinitionMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var linuxRootMetrics: runtime.SystemLinkExecRuntimeExactTextIndexMetrics
    var linuxHostRoots: str[]
    assert(runtime.SystemLinkExecRuntimeProviderExportRootsInto(
               linuxPlan,
               "runtime/program_support_host_runtime",
               linuxHostRoots,
               linuxDefinitionMetrics,
               linuxRootMetrics,
               err),
           err)
    assert(!HasRoot(linuxHostRoots, "cheng_host_flock"),
           "atomic tree provider roots smoke: aarch64 libc flock duplicate")
    let leaseRes = os.AtomicTreeOpenVerifiedExclusiveOrAbsent("/usr", "bin")
    assert(IsOk(leaseRes), Error(leaseRes))
    let lease = Value(leaseRes)
    assert(lease.kind == os.AtomicTreeExclusiveOpened,
           "atomic tree provider roots smoke: /usr/bin was not OPENED")
    assert(IsOk(os.AtomicTreeClose(lease.tree)),
           "atomic tree provider roots smoke: /usr/bin lease close failed")
    echo("system_link_atomic_tree_provider_roots_smoke ok")
    return 0
