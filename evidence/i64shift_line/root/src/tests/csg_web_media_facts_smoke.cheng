import std/system
import cheng/core/ir/csg_web_facts as facts

fn main(): int32 =
    var blockIndexes: int32[]
    blockIndexes = []
    add(blockIndexes, 0)

    var objects: facts.CsgWebMediaObjectDescriptor[]
    objects = []
    add(objects, facts.CsgWebMediaObjectDescriptor(
        objectIndex: 0,
        objectId: "object-0",
        objectCid: "object-cid",
        byteOffset: 0,
        byteLength: 12,
        sourceBlockBytes: 4,
        sourceBlockCount: 3,
        priority: 0
    ))

    var droplets: facts.CsgWebMediaDropletDescriptor[]
    droplets = []
    add(droplets, facts.CsgWebMediaDropletDescriptor(
        objectIndex: 0,
        dropletIndex: 0,
        kindCode: 1,
        key: "droplet-0",
        peerId: "peer-a",
        cid: "droplet-cid",
        degree: 1,
        blockIndexes: blockIndexes
    ))

    let asset = facts.CsgWebMediaAssetFact(
        kind: facts.CsgWebMediaAsset,
        id: "media.asset.1",
        assetCid: "asset-cid",
        bundleCid: "bundle-cid",
        mime: "video/mp4",
        kindCode: 1,
        durationMs: "1234567890123",
        codec: "avc1.640028",
        posterCid: "poster-cid",
        initSegmentCid: "init-cid",
        initSegmentByteLength: 12,
        keyframeIndex: "0:poster-cid,1:init-cid",
        transport: "moq",
        fecScheme: "lt_xor_v1:experimental",
        contentSignature: "sig-ed25519-proof",
        catalogCid: "catalog-cid",
        catalogKey: "catalog-key",
        rebuildTemplateCid: "template-cid",
        rebuildTemplateKey: "template-key",
        objectTargetBytes: 4096,
        sourceBlockBytes: 1024,
        objectCount: 1,
        dropletCount: 1,
        objects: objects,
        droplets: droplets
    )
    assert(asset.kind == facts.CsgWebMediaAsset, " csg web media facts: asset kind")
    assert(asset.kindCode == 1, " csg web media facts: video kind")
    assert(asset.objects.len == 1, " csg web media facts: object count")
    assert(asset.droplets.len == 1, " csg web media facts: droplet count")
    assert(asset.initSegmentByteLength == 12, " csg web media facts: init segment length")
    let assetGuard = "assetCid:asset-cid"

    let slot = facts.CsgWebMediaPlaybackSlotFact(
        kind: facts.CsgWebMediaPlaybackSlot,
        id: "media.slot.1",
        slotId: "slot-main",
        assetFact: asset.id,
        assetCid: asset.assetCid,
        manifestCid: "manifest-cid",
        nodeTemplate: "template.video",
        providerKind: "media-decode-provider",
        stateRef: "media.state.slot-main",
        decodeProvider: "MediaDecodeProvider",
        textureProvider: "TextureProvider",
        audioProvider: "AudioProvider",
        objectFit: "cover"
    )
    assert(slot.kind == facts.CsgWebMediaPlaybackSlot, " csg web media facts: slot kind")
    assert(slot.assetCid == asset.assetCid, " csg web media facts: slot asset")

    let action = facts.CsgWebMediaControlActionFact(
        kind: facts.CsgWebMediaControlAction,
        id: "media.action.play.1",
        slotId: slot.slotId,
        actionKind: "Play",
        payloadSchema: "none",
        dispatch: "event-queue",
        guard: assetGuard,
        trace: "media-control-action"
    )
    assert(action.kind == facts.CsgWebMediaControlAction, " csg web media facts: action kind")
    assert(action.slotId == slot.slotId, " csg web media facts: action slot")
    assert(action.dispatch == "event-queue", " csg web media facts: event queue")
    assert(action.guard == assetGuard, " csg web media facts: action guard")

    let controlReceipt = facts.CsgWebMediaControlReceiptFact(
        kind: facts.CsgWebMediaControlReceipt,
        id: "media.control.receipt.play.1",
        receiptCid: "control-play-receipt-cid",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        kindCode: asset.kindCode,
        actionKind: "Play",
        payloadSchema: "none",
        payload: "",
        dispatch: "event-queue",
        sourceStateCode: 1,
        resultStateCode: 2,
        statusCode: 1,
        guard: assetGuard,
        trace: "media-control-action"
    )
    assert(controlReceipt.kind == facts.CsgWebMediaControlReceipt,
        " csg web media facts: control receipt kind")
    assert(controlReceipt.receiptCid == "control-play-receipt-cid",
        " csg web media facts: control receipt cid")
    assert(controlReceipt.resultStateCode == 2,
        " csg web media facts: control receipt state")
    assert(controlReceipt.guard == assetGuard,
        " csg web media facts: control receipt guard")

    let openLifecycleEvent = facts.CsgWebMediaLifecycleEventFact(
        kind: facts.CsgWebMediaLifecycleEvent,
        id: "media.lifecycle.open.1",
        eventKind: "OpenAsset",
        eventCid: "open-event-cid",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        bundleCid: asset.bundleCid,
        manifestCid: slot.manifestCid,
        kindCode: asset.kindCode,
        payloadSchema: "unimaker.media.lifecycle.runtime.v1",
        payload: slot.manifestCid,
        transport: "moq",
        dispatch: "event-queue",
        guard: assetGuard,
        sourceStateCode: 0,
        resultStateCode: 1,
        statusCode: 1,
        objectCount: asset.objectCount,
        dropletCount: asset.dropletCount,
        trace: "media-lifecycle-event"
    )
    assert(openLifecycleEvent.kind == facts.CsgWebMediaLifecycleEvent,
        " csg web media facts: open lifecycle kind")
    assert(openLifecycleEvent.eventKind == "OpenAsset",
        " csg web media facts: open lifecycle event kind")
    assert(openLifecycleEvent.payload == slot.manifestCid,
        " csg web media facts: open lifecycle payload")
    assert(openLifecycleEvent.dropletCount == asset.dropletCount,
        " csg web media facts: open lifecycle droplet count")
    assert(openLifecycleEvent.guard == assetGuard,
        " csg web media facts: open lifecycle guard")

    let lifecycleEvent = facts.CsgWebMediaLifecycleEventFact(
        kind: facts.CsgWebMediaLifecycleEvent,
        id: "media.lifecycle.edit.1",
        eventKind: "EditAsset",
        eventCid: "event-cid",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        bundleCid: asset.bundleCid,
        manifestCid: slot.manifestCid,
        kindCode: asset.kindCode,
        payloadSchema: "unimaker.media.lifecycle.runtime.v1",
        payload: "trim=120..900",
        transport: "moq",
        dispatch: "event-queue",
        guard: assetGuard,
        sourceStateCode: 4,
        resultStateCode: 5,
        statusCode: 1,
        objectCount: asset.objectCount,
        dropletCount: asset.dropletCount,
        trace: "media-lifecycle-event"
    )
    assert(lifecycleEvent.kind == facts.CsgWebMediaLifecycleEvent,
        " csg web media facts: lifecycle kind")
    assert(lifecycleEvent.eventKind == "EditAsset",
        " csg web media facts: lifecycle event kind")
    assert(lifecycleEvent.assetCid == asset.assetCid,
        " csg web media facts: lifecycle asset")
    assert(lifecycleEvent.guard == assetGuard,
        " csg web media facts: lifecycle guard")

    let frameReceipt = facts.CsgWebMediaFrameReceiptFact(
        kind: facts.CsgWebMediaFrameReceipt,
        id: "media.frame.video.1",
        receiptKind: "Frame",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        manifestCid: slot.manifestCid,
        kindCode: asset.kindCode,
        firstFrameCid: "frame-cid",
        firstImageCid: "",
        firstAudioCid: "",
        audioDataCid: "",
        bytesReady: 12,
        initSegmentCid: "",
        initBytesReady: 0,
        sourceCode: 3,
        verified: true,
        textureProvider: slot.textureProvider,
        textureHandle: "42",
        textureReady: true,
        decodedWidth: 1920,
        decodedHeight: 1080,
        pixelFormat: 111,
        pixelBufferHandle: "0",
        audioProvider: "",
        sampleRateHz: 0,
        channelCount: 0,
        bitsPerSample: 0,
        pcmDataOffset: 0,
        pcmDataBytes: 0,
        startedAtMs: "1000",
        elapsedMs: "16",
        openToMediaMs: "26",
        trace: "platform-decode->surface-frame-receipt"
    )
    assert(frameReceipt.kind == facts.CsgWebMediaFrameReceipt,
        " csg web media facts: frame receipt kind")
    assert(frameReceipt.receiptKind == "Frame",
        " csg web media facts: frame receipt type")
    assert(frameReceipt.textureReady,
        " csg web media facts: frame texture ready")
    let frameReceiptIdentity = facts.CsgWebMediaReceiptIdentityFact(
        kind: facts.CsgWebMediaReceiptIdentity,
        id: "media.receipt.identity.video.1",
        receiptFactId: frameReceipt.id,
        receiptCid: "frame-video-receipt-cid",
        receiptKind: frameReceipt.receiptKind,
        slotId: frameReceipt.slotId,
        assetCid: frameReceipt.assetCid,
        manifestCid: frameReceipt.manifestCid,
        trace: frameReceipt.trace
    )
    assert(frameReceiptIdentity.kind == facts.CsgWebMediaReceiptIdentity,
        " csg web media facts: frame identity kind")
    assert(frameReceiptIdentity.receiptFactId == frameReceipt.id,
        " csg web media facts: frame identity link")

    let imageReceipt = facts.CsgWebMediaFrameReceiptFact(
        kind: facts.CsgWebMediaFrameReceipt,
        id: "media.frame.image.1",
        receiptKind: "Image",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        manifestCid: slot.manifestCid,
        kindCode: 2,
        firstFrameCid: "",
        firstImageCid: "image-cid",
        firstAudioCid: "",
        audioDataCid: "",
        bytesReady: 77,
        initSegmentCid: "",
        initBytesReady: 0,
        sourceCode: 4,
        verified: true,
        textureProvider: "surface-texture-provider",
        textureHandle: "0",
        textureReady: false,
        decodedWidth: 2,
        decodedHeight: 2,
        pixelFormat: 6,
        pixelBufferHandle: "0",
        audioProvider: "",
        sampleRateHz: 0,
        channelCount: 0,
        bitsPerSample: 8,
        pcmDataOffset: 0,
        pcmDataBytes: 0,
        startedAtMs: "0",
        elapsedMs: "0",
        openToMediaMs: "0",
        trace: "first-image->surface-texture-provider->image-receipt"
    )
    assert(!imageReceipt.textureReady,
        " csg web media facts: image texture pending")
    let imageReceiptIdentity = facts.CsgWebMediaReceiptIdentityFact(
        kind: facts.CsgWebMediaReceiptIdentity,
        id: "media.receipt.identity.image.1",
        receiptFactId: imageReceipt.id,
        receiptCid: "frame-image-receipt-cid",
        receiptKind: imageReceipt.receiptKind,
        slotId: imageReceipt.slotId,
        assetCid: imageReceipt.assetCid,
        manifestCid: imageReceipt.manifestCid,
        trace: imageReceipt.trace
    )
    assert(imageReceiptIdentity.receiptKind == "Image",
        " csg web media facts: image identity receipt kind")

    let audioReceipt = facts.CsgWebMediaFrameReceiptFact(
        kind: facts.CsgWebMediaFrameReceipt,
        id: "media.frame.audio.1",
        receiptKind: "Audio",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        manifestCid: slot.manifestCid,
        kindCode: 3,
        firstFrameCid: "",
        firstImageCid: "",
        firstAudioCid: "audio-init-cid",
        audioDataCid: "audio-data-cid",
        bytesReady: 52,
        initSegmentCid: "audio-init-cid",
        initBytesReady: 44,
        sourceCode: 4,
        verified: true,
        textureProvider: "",
        textureHandle: "0",
        textureReady: false,
        decodedWidth: 0,
        decodedHeight: 0,
        pixelFormat: 0,
        pixelBufferHandle: "0",
        audioProvider: "coreaudio-output-provider",
        sampleRateHz: 44100,
        channelCount: 1,
        bitsPerSample: 16,
        pcmDataOffset: 44,
        pcmDataBytes: 8,
        startedAtMs: "0",
        elapsedMs: "0",
        openToMediaMs: "0",
        trace: "first-audio->coreaudio-output-provider->audio-receipt"
    )
    assert(audioReceipt.pcmDataBytes == 8,
        " csg web media facts: audio pcm bytes")
    let audioReceiptIdentity = facts.CsgWebMediaReceiptIdentityFact(
        kind: facts.CsgWebMediaReceiptIdentity,
        id: "media.receipt.identity.audio.1",
        receiptFactId: audioReceipt.id,
        receiptCid: "frame-audio-receipt-cid",
        receiptKind: audioReceipt.receiptKind,
        slotId: audioReceipt.slotId,
        assetCid: audioReceipt.assetCid,
        manifestCid: audioReceipt.manifestCid,
        trace: audioReceipt.trace
    )
    assert(audioReceiptIdentity.receiptKind == "Audio",
        " csg web media facts: audio identity receipt kind")

    let deliveryReceipt = facts.CsgWebMediaDeliveryReceiptFact(
        kind: facts.CsgWebMediaDeliveryReceipt,
        id: "media.delivery.video.1",
        receiptCid: "delivery-video-receipt-cid",
        receiptKind: "RemoteFrame",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        bundleCid: asset.bundleCid,
        manifestCid: slot.manifestCid,
        kindCode: 1,
        transport: "moq",
        publishEventCid: "publish-event-cid",
        openEventCid: openLifecycleEvent.eventCid,
        firstMediaCid: "frame-cid",
        sourceCode: 2,
        announcedBytes: 512,
        transferredBytes: 12,
        bytesReady: 12,
        objectCount: asset.objectCount,
        dropletCount: asset.dropletCount,
        remoteFetchMs: "18",
        openToMediaMs: "26",
        budgetMs: "1000",
        statusCode: 1,
        verified: true,
        guard: assetGuard,
        trace: "open->remote-frame-delivery"
    )
    assert(deliveryReceipt.kind == facts.CsgWebMediaDeliveryReceipt,
        " csg web media facts: delivery receipt kind")
    assert(deliveryReceipt.receiptKind == "RemoteFrame",
        " csg web media facts: delivery receipt type")
    assert(deliveryReceipt.openEventCid == openLifecycleEvent.eventCid,
        " csg web media facts: delivery open cid")
    assert(deliveryReceipt.receiptCid == "delivery-video-receipt-cid",
        " csg web media facts: delivery receipt cid")
    assert(deliveryReceipt.remoteFetchMs == "18",
        " csg web media facts: delivery remote fetch")
    assert(deliveryReceipt.guard == assetGuard,
        " csg web media facts: delivery guard")

    let imageDeliveryReceipt = facts.CsgWebMediaDeliveryReceiptFact(
        kind: facts.CsgWebMediaDeliveryReceipt,
        id: "media.delivery.image.1",
        receiptCid: "delivery-image-receipt-cid",
        receiptKind: "RemoteImage",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        bundleCid: asset.bundleCid,
        manifestCid: slot.manifestCid,
        kindCode: 2,
        transport: "moq",
        publishEventCid: "publish-image-event-cid",
        openEventCid: openLifecycleEvent.eventCid,
        firstMediaCid: imageReceipt.firstImageCid,
        sourceCode: 4,
        announcedBytes: 512,
        transferredBytes: imageReceipt.bytesReady,
        bytesReady: imageReceipt.bytesReady,
        objectCount: asset.objectCount,
        dropletCount: asset.dropletCount,
        remoteFetchMs: "19",
        openToMediaMs: "20",
        budgetMs: "1000",
        statusCode: 1,
        verified: true,
        guard: assetGuard,
        trace: "open->remote-image-delivery"
    )
    assert(imageDeliveryReceipt.receiptKind == "RemoteImage",
        " csg web media facts: image delivery receipt type")
    assert(imageDeliveryReceipt.sourceCode == 4,
        " csg web media facts: image delivery source")
    assert(imageDeliveryReceipt.guard == assetGuard,
        " csg web media facts: image delivery guard")

    let audioDeliveryReceipt = facts.CsgWebMediaDeliveryReceiptFact(
        kind: facts.CsgWebMediaDeliveryReceipt,
        id: "media.delivery.audio.1",
        receiptCid: "delivery-audio-receipt-cid",
        receiptKind: "RemoteAudio",
        slotId: slot.slotId,
        assetCid: asset.assetCid,
        bundleCid: asset.bundleCid,
        manifestCid: slot.manifestCid,
        kindCode: 3,
        transport: "moq",
        publishEventCid: "publish-audio-event-cid",
        openEventCid: openLifecycleEvent.eventCid,
        firstMediaCid: audioReceipt.firstAudioCid,
        sourceCode: 4,
        announcedBytes: 512,
        transferredBytes: audioReceipt.bytesReady,
        bytesReady: audioReceipt.bytesReady,
        objectCount: asset.objectCount,
        dropletCount: asset.dropletCount,
        remoteFetchMs: "21",
        openToMediaMs: "22",
        budgetMs: "1000",
        statusCode: 1,
        verified: true,
        guard: assetGuard,
        trace: "open->remote-audio-delivery"
    )
    assert(audioDeliveryReceipt.receiptKind == "RemoteAudio",
        " csg web media facts: audio delivery receipt type")
    assert(audioDeliveryReceipt.sourceCode == 4,
        " csg web media facts: audio delivery source")
    assert(audioDeliveryReceipt.guard == assetGuard,
        " csg web media facts: audio delivery guard")

    echo(" csg_web_media_facts_smoke ok")
    return 0
