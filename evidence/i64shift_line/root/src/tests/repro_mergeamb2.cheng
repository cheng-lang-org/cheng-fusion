import std/result
import std/crypto/bigint as bigint

fn useVar(x: var bigint.BigInt): int32 =
    bigint.bigNormalize(x)
    return x.count

fn mkBig(flag: bool): result.Result[bigint.BigInt] =
    if flag:
        return result.Err[bigint.BigInt]("neg")
    return result.Ok[bigint.BigInt](bigint.bigFromInt(3))

@borrows
fn check(flag: bool, deep: bool): result.Result[int32] =
    let xRes: result.Result[bigint.BigInt] = mkBig(flag)
    if result.IsErr(xRes):
        return result.Err[int32](result.Error(xRes))
    var x: bigint.BigInt = result.Value(xRes)
    if deep:
        let c = useVar(x)
    return result.Ok[int32](x.count)

fn main(): int32 =
    let r = check(true, true)
    return 0
