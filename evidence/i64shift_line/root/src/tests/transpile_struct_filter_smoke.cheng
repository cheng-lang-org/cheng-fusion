import std/strings as strings



type
    DistributedContent =
        id: str
        postId: str
        taskId: str
        authorSeq: int64
        f_type: str
        publishCategory: str
        userId: str
        userName: str
        avatar: str
        title: str
        content: str
        media: str
        mediaItems: str[]
        tinyPreview: str
        coverMedia: str
        mediaAspectRatio: int64
        likes: int64
        comments: int64
        likePeerIds: str[]
        commentItems: DistributedContentComment[]
        timestamp: int64
        publishState: str
        moderationClass: str
        moderationDecision: str
        visibility: str
        homeEligible: bool
        distributionTags: str[]
        reasonCode: str
        retryCount: int64
        lastAttemptAt: int64
        publishedAt: int64
        tombstoned: bool
        viewerCanAccess: bool
        accessPolicy: str
        isDuplicate: bool
        locationHint: str
    DistributedContentComment =
        id: str
        peerId: str
        userName: str
        content: str
        timestamp: int64





fn pruneClearedContents(items: DistributedContent[]): DistributedContent[] =
    let __t1_src = items
    var __t2_filtered: DistributedContent[]
    var __t3_i = 0
    while __t3_i < __t1_src.len:
        let __t4_it = __t1_src[__t3_i]
        if shouldKeepContentByClearMarker(__t4_it):
            add(__t2_filtered, __t4_it)
        __t3_i = __t3_i + 1
    return __t2_filtered

fn shouldKeepContentByClearMarker(content: DistributedContent): bool =
    var marker = clearMarkerForPeer(content.userId)
    if (marker <= int64(0)):
        return true
    return (content.timestamp >= marker)

fn main(): int32 =
    var xs: DistributedContent[]
    let kept = pruneClearedContents(xs)
    return int32(kept.len)
