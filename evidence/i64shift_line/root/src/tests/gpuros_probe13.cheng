@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

fn HexNib(v: uint32) =
    let w = v
    if w < 10:
        IoSt8(268435456, 0, int32(48 + w))
    else:
        IoSt8(268435456, 0, int32(87 + w))

fn Hex32(v: uint32) =
    var div = uint32(268435456)
    while div > uint32(0):
        HexNib((v / div) & uint32(15))
        div = div / uint32(16)

fn main(): int32 =
    let prod = uint64(3) * uint64(4096)
    Hex32(uint32(prod))
    IoSt8(268435456, 0, 32)
    let b = uint64(268435712) + prod
    Hex32(uint32(b / uint64(4096)))
    IoSt8(268435456, 0, 10)
    return 0
