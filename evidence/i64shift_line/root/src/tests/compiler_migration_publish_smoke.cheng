import std/os
import std/result
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/tooling/compiler_publish_gate as cpub
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec
import std/strutils as strutil

fn main(): int32 =
    let workspaceRoot = chengpath.PathCurrentDir()
    let packageRoot = workspaceRoot
    let smokeLabel: str = os.GetEnvDefault("CHENG_SMOKE_LABEL", "host")
    let outDir: str = chengpath.PathJoin(workspaceRoot, strutil.Join(["artifacts/compiler_migration/", smokeLabel], ""))
    assert(chengpath.MkdirP(workspaceRoot, outDir), " compiler migration publish: mkdir")
    let currentSourcePath = chengpath.PathJoin(packageRoot, "src/tests/compiler_migration_fixture.cheng")
    let legacySourcePath = chengpath.PathJoin(packageRoot, "testdata/compiler_migration/compiler_migration_fixture_legacy.cheng")
    let outputPath = chengpath.PathJoin(outDir, "compiler_migration_publish_fixture")
    let req = creq.CompilerRequestNew(
        packageRoot,
        currentSourcePath,
        outputPath,
        "arm64-apple-darwin",
        creq.EmitExe,
        ""
    )
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err), " compiler migration publish: link plan")
    var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var entryModulePath: str
    assert(parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
               workspaceRoot,
               packageRoot,
               linkPlan.packageId,
               noExternalPackageRoots,
               currentSourcePath,
               entryModulePath),
           " compiler migration publish: exact entry identity")
    var migration: ccsg.CompilerLegacyMigration
    let migrationRes = ccsg.BuildCompilerLegacyMigrationInto(
        workspaceRoot,
        packageRoot,
        legacySourcePath,
        linkPlan.packageId,
        entryModulePath,
        migration)
    assert(IsOk(migrationRes), " compiler migration publish: build migration")
    let providers = [
        "runtime/compiler_runtime",
        "runtime/core_runtime",
        "runtime/debug_runtime",
        "runtime/program_support",
        "runtime/program_support_get_env_bridge",
        "runtime/program_support_host_runtime"
    ]
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceMake(migration, evidence)
    assert(IsOk(evidenceRes) &&
           ceq.CompilerMigrationEvidenceVerify(evidence),
           " compiler migration publish: evidence make")
    let canonicalOutputDigest = ccsg.CompileOutputDigest(
        outputPath,
        req.targetTriple,
        providers,
        migration.baselineArtifact.canonicalGraphCid)
    var baselineSemantic: sexec.CompileSemanticReceipt
    var migratedSemantic: sexec.CompileSemanticReceipt
    var semanticErr: str
    assert(sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
               migration.baselineArtifact.sourceIdentityReceipt,
               migration.baselineArtifact.canonicalGraphCid,
               canonicalOutputDigest,
               req.targetTriple,
               "stage3_local",
               providers,
               baselineSemantic,
               semanticErr),
           " compiler migration publish: baseline semantic receipt")
    assert(sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
               migration.migratedArtifact.sourceIdentityReceipt,
               migration.migratedArtifact.canonicalGraphCid,
               canonicalOutputDigest,
               req.targetTriple,
               "stage3_local",
               providers,
               migratedSemantic,
               semanticErr),
           " compiler migration publish: migrated semantic receipt")
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofMake(
        linkPlan.packageId,
        "stable",
        evidence,
        migration.baselineArtifact.canonicalGraphCid,
        migration.migratedArtifact.canonicalGraphCid,
        migration.baselineArtifact.exportSurface,
        migration.migratedArtifact.exportSurface,
        baselineSemantic,
        migratedSemantic,
        req.targetTriple,
        proof)
    assert(IsOk(proofRes), " compiler migration publish: proof make")
    assert(ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence),
           " compiler migration publish: proof passed")
    var decisionChannel = ""
    var decisionGate = 0
    var decisionChecked = 0
    var decisionPassed = 0
    var decisionPublish = 0
    var decisionProofCid = layout.FixedBytes32()
    let worldHeadCid = cworld.CompilerWorldHashText(
        "compiler_migration_publish_world",
        [linkPlan.packageId, "stable"])
    let decisionRes = cpub.CompilerPublishDecisionEvaluate("stable",
                                                             worldHeadCid,
                                                             true,
                                                             proof,
                                                             evidence,
                                                             decisionChannel,
                                                             decisionGate,
                                                             decisionChecked,
                                                             decisionPassed,
                                                             decisionPublish,
                                                             decisionProofCid)
    assert(IsOk(decisionRes), " compiler migration publish: decision")
    assert(decisionPublish != 0, " compiler migration publish: stable allowed")
    let proofReport = ceq.CompilerMigrationSemanticProofReport(proof)
    assert(chengpath.TextContains(proofReport, "equivalence_kind=canonical_semantic_identity"),
           " compiler migration publish: report kind")
    echo(" compiler_migration_publish_smoke ok")
    return 0
