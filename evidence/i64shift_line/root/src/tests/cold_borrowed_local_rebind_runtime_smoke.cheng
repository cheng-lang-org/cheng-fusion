import std/system as system

fn RebindBorrowedLocal(sourceText: var str): int32 =
    var localText = sourceText
    localText = "local"
    if localText != "local":
        return 1
    if sourceText != "first":
        return 2
    return 0

fn MergeManagedLocals(
    first: var str,
    second: var str,
    chooseFirst: bool
): int32 =
    var firstLocal = "entry-first"
    var secondLocal = "entry-second"
    var thirdLocal = "entry-third"
    if chooseFirst:
        firstLocal = "left-first"
        secondLocal = "left-second"
        thirdLocal = "left-third"
    else:
        firstLocal = "right-first"
        secondLocal = "right-second"
        thirdLocal = "right-third"
    if chooseFirst:
        if firstLocal != "left-first" ||
           secondLocal != "left-second" ||
           thirdLocal != "left-third":
            return 1
    else:
        if firstLocal != "right-first" ||
           secondLocal != "right-second" ||
           thirdLocal != "right-third":
            return 2
    if first != "first" || second != "second":
        return 3
    return 0

fn LoopManagedLocals(first: var str, second: var str): int32 =
    var firstLocal = "loop-entry-first"
    var secondLocal = "loop-entry-second"
    var thirdLocal = "loop-entry-third"
    var index: int32 = 0
    while index < 2:
        if index == 0:
            firstLocal = "loop-one-first"
            secondLocal = "loop-one-second"
            thirdLocal = "loop-one-third"
        else:
            firstLocal = "loop-two-first"
            secondLocal = "loop-two-second"
            thirdLocal = "loop-two-third"
        index = index + 1
    if firstLocal != "loop-two-first":
        return 1
    if secondLocal != "loop-two-second":
        return 2
    if thirdLocal != "loop-two-third":
        return 3
    if first != "first" || second != "second":
        return 4
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    system.memDiagReset()

    var first = system.NewStringCopy(system.StrDataPtr("first"), 5)
    var second = system.NewStringCopy(system.StrDataPtr("second"), 6)
    if system.memAllocCount() - allocBefore != 2:
        return 10
    if system.memFreeCount() != freeBefore:
        return 11
    if system.memLiveCount() - liveBefore != 2:
        return 12

    if RebindBorrowedLocal(first) != 0:
        return 20
    if system.memRetainCount() != 0 || system.memReleaseCount() != 0:
        return 25
    if MergeManagedLocals(first, second, true) != 0:
        return 21
    if MergeManagedLocals(first, second, false) != 0:
        return 22
    if LoopManagedLocals(first, second) != 0:
        return 23
    if first != "first" || second != "second":
        return 24

    first = ""
    second = ""
    let retainCount = system.memRetainCount()
    let releaseCount = system.memReleaseCount()
    if system.memAllocCount() - allocBefore != 2:
        return 30
    if system.memFreeCount() - freeBefore != 2:
        return 31
    if system.memLiveCount() != liveBefore:
        return 32
    if releaseCount - retainCount != 2:
        return 33
    echo("managed_cfg_orc_counts=1")
    return 0
