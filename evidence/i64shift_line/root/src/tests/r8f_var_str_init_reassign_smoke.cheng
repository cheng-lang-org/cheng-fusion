# R8-F miscompile 4b probe: var str initializer lost when reassigned in a branch.
# Expect: mode starts "init"; if cond false, mode stays "init".

fn classify(flag: bool): str =
    var mode = "init"
    if flag:
        mode = "active"
    return mode

fn main(): int32 =
    if classify(false) != "init":
        return 9
    if classify(true) != "active":
        return 8
    return 0
