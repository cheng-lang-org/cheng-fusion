import std/cmdline
import std/os

fn requiredFlag(name: str): str =
    var value: str
    assert(cmdline.readFlagValue(name, value) && value.len > 0,
           "terminal recovery lock smoke: required flag missing")
    return value

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let parent = requiredFlag("--parent")
    let finalName = requiredFlag("--final")
    let opened = os.AtomicTreeOpenVerifiedSharedOrAbsent(parent, finalName)
    assert(IsOk(opened), Error(opened))
    let lease = Value(opened)
    var priorOwner: int32 = -1
    var stableRow: int32 = -1
    for iteration in 0..<5000:
        var owner: int32
        var err: str
        assert(os.AtomicTreeTerminalRecoveryLockOwnerAcquireInto(
                   lease.tree, owner, err),
               err)
        let row = (owner - 1) % 4096
        if iteration == 0:
            stableRow = row
        else:
            assert(row == stableRow,
                   "terminal recovery lock smoke: binding row grew")
            assert(!os.AtomicTreeTerminalRecoveryLockOwnerRelease(
                       priorOwner),
                   "terminal recovery lock smoke: stale generation released")
        assert(os.AtomicTreeTerminalRecoveryLockOwnerRelease(owner),
               "terminal recovery lock smoke: current release failed")
        priorOwner = owner
    assert(!os.AtomicTreeTerminalRecoveryLockOwnerRelease(priorOwner),
           "terminal recovery lock smoke: released token reused")
    assert(IsOk(os.AtomicTreeClose(lease.tree)),
           "terminal recovery lock smoke: shared root close failed")
    echo("TERMINAL_RECOVERY_LOCK_STABLE_OWNER_OK")
    return 0
