# R8-F miscompile 4a probe: void fn with out="" + trailing if-str-eq + assign.
# Suspected: entire body silently dropped to empty (TypedExprAppendUnrepresented
# TopLevelBodyStatements / nested-body family). Check body statements survive.

fn render(out: var str, tag: str) =
    out = ""
    if tag == "a":
        out = "alpha"
    if tag == "b":
        out = "beta"

fn main(): int32 =
    var buf = "x"
    render(buf, "a")
    if buf != "alpha":
        return 1
    render(buf, "b")
    if buf != "beta":
        return 2
    render(buf, "z")
    if buf != "":
        return 3
    return 0
