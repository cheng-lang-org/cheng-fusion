import std/system
import std/os

fn main(): int32 =
    let tmpDir: str = os.GetEnv("TMPDIR")
    if len(tmpDir) <= 0:
        echo("SKIP: no TMPDIR")
        return 0

    let path: str = os.JoinPath(tmpDir, "cheng_cold_smoke_write_test2.bin")

    // Write bytes using writeFileResult (returns Result[bool])
    let content: str = "hello world test data"
    let writeRes: Result[bool] = os.writeFileResult(path, content)
    assert(IsOk(writeRes), " write: ok")
    assert(Value(writeRes), " write: true")

    // Verify file exists
    assert(os.FileExists(path), " file: exists")

    echo(" cold_smoke_write_file_bytes ok")
    return 0
