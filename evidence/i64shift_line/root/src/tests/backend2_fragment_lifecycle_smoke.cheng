import std/cmdline
import std/system as system
import cheng/core/backend2/backend2_types as b2t
import cheng/core/backend2/backend2_fragment_lifecycle as b2life

fn FragmentLifecycleOwnedText(value: str): str =
    return system.NewStringCopy(
        system.StrDataPtr(value), len(value))

fn FragmentLifecycleFixture(index: int32):
        b2t.FunctionFragment =
    var out: b2t.FunctionFragment
    out.funcEmitCid = FragmentLifecycleOwnedText(
        "1111111111111111111111111111111111111111111111111111111111111111")
    out.functionSymbol =
        FragmentLifecycleOwnedText("FragmentLifecycle")
    out.wordCount = 0
    add(out.relocTargetSymbols,
        FragmentLifecycleOwnedText("target"))
    add(out.refSymbols, FragmentLifecycleOwnedText("ref"))
    add(out.cstringLiterals,
        FragmentLifecycleOwnedText("literal"))
    add(out.cstringDataLabels,
        FragmentLifecycleOwnedText("literal_label"))
    add(out.cstringPayloadRawBytes, index & 255)
    add(out.cstringPayloadRawBytes, 0)
    add(out.cstringPayloadRawByteCounts, 2)
    add(out.dataRelocFnRelWordOffsets, index)
    add(out.dataRelocTargetLabels,
        FragmentLifecycleOwnedText("literal_label"))
    add(out.globalDataLabelsRaw,
        FragmentLifecycleOwnedText("global"))
    add(out.globalDataPayloadTexts,
        FragmentLifecycleOwnedText("zero:4"))
    add(out.globalDataPayloadByteCounts, 0)
    out.bodyIrPayload =
        FragmentLifecycleOwnedText("exact_body_ir_payload")
    out.contentCid = FragmentLifecycleOwnedText(
        "2222222222222222222222222222222222222222222222222222222222222222")
    return out

fn FragmentLifecycleOneCycle(index: int32) =
    var fragments: b2t.FunctionFragment[]
    add(fragments, FragmentLifecycleFixture(index))
    var fragmentBuilt: bool[]
    add(fragmentBuilt, true)
    var functionIrIndexes: int32[]
    add(functionIrIndexes, index)
    var lifecycle: b2life.Backend2FragmentLifecycle
    b2life.Backend2FragmentLifecycleBegin(
        lifecycle, fragments, fragmentBuilt, functionIrIndexes)
    b2life.Backend2FragmentLifecycleMoveToAssembler(lifecycle)
    var receipt: b2life.Backend2FragmentReleaseReceipt
    b2life.Backend2FragmentLifecycleReleaseWithReceipt(
        lifecycle,
        fragments,
        fragmentBuilt,
        functionIrIndexes,
        b2life.Backend2FragmentOutcomeAssembled,
        receipt)
    var err: str
    assert(
        b2life.Backend2FragmentReleaseReceiptConsumeStrictInto(
            lifecycle,
            fragments,
            fragmentBuilt,
            functionIrIndexes,
            receipt,
            err),
        err)
    assert(receipt.functionRowCount == 1 &&
           receipt.builtFunctionCount == 1 &&
           receipt.allocated == int64(1) &&
           receipt.released == int64(1) &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes == receipt.releasedBytes &&
           receipt.liveBytes == int64(0) &&
           receipt.ownerTransferCount == int64(1) &&
           receipt.releasedBufferCount > 0 &&
           receipt.releasedAuxiliaryBufferCount == 2 &&
           receipt.releasedAuxiliaryBytes > int64(0) &&
           receipt.releasedManagedStringValueCount > 0 &&
           receipt.releasedManagedStringBytes > int64(0) &&
           receipt.payloadStorageReleased &&
           receipt.auxiliaryStorageReleased &&
           receipt.ledgerStorageReleased &&
           fragments.len == 0 &&
           fragments.cap == 0 &&
           fragmentBuilt.len == 0 &&
           fragmentBuilt.cap == 0 &&
           functionIrIndexes.len == 0 &&
           functionIrIndexes.cap == 0,
           "backend2 fragment lifecycle: cycle receipt mismatch")

fn FragmentLifecycleNoLowerable() =
    var fragments: b2t.FunctionFragment[]
    var empty: b2t.FunctionFragment
    add(fragments, empty)
    var fragmentBuilt: bool[]
    add(fragmentBuilt, false)
    var functionIrIndexes: int32[]
    add(functionIrIndexes, 0)
    var lifecycle: b2life.Backend2FragmentLifecycle
    b2life.Backend2FragmentLifecycleBegin(
        lifecycle, fragments, fragmentBuilt, functionIrIndexes)
    var receipt: b2life.Backend2FragmentReleaseReceipt
    b2life.Backend2FragmentLifecycleReleaseWithReceipt(
        lifecycle,
        fragments,
        fragmentBuilt,
        functionIrIndexes,
        b2life.Backend2FragmentOutcomeNoLowerable,
        receipt)
    var err: str
    assert(
        b2life.Backend2FragmentReleaseReceiptConsumeStrictInto(
            lifecycle,
            fragments,
            fragmentBuilt,
            functionIrIndexes,
            receipt,
            err),
        err)
    assert(receipt.functionRowCount == 1 &&
           receipt.builtFunctionCount == 0 &&
           receipt.live == int64(0) &&
           receipt.liveBytes == int64(0) &&
           receipt.payloadStorageReleased &&
           receipt.auxiliaryStorageReleased &&
           receipt.ledgerStorageReleased,
           "backend2 fragment lifecycle: no-lowerable release mismatch")

fn FragmentLifecycleFailureOutcome(outcome: int32,
                                   moveToAssembler: bool) =
    var fragments: b2t.FunctionFragment[]
    add(fragments, FragmentLifecycleFixture(outcome))
    var fragmentBuilt: bool[]
    add(fragmentBuilt, true)
    var functionIrIndexes: int32[]
    add(functionIrIndexes, outcome)
    var lifecycle: b2life.Backend2FragmentLifecycle
    b2life.Backend2FragmentLifecycleBegin(
        lifecycle, fragments, fragmentBuilt, functionIrIndexes)
    if moveToAssembler:
        b2life.Backend2FragmentLifecycleMoveToAssembler(lifecycle)
    var receipt: b2life.Backend2FragmentReleaseReceipt
    b2life.Backend2FragmentLifecycleReleaseWithReceipt(
        lifecycle,
        fragments,
        fragmentBuilt,
        functionIrIndexes,
        outcome,
        receipt)
    var err: str
    assert(
        b2life.Backend2FragmentReleaseReceiptConsumeStrictInto(
            lifecycle,
            fragments,
            fragmentBuilt,
            functionIrIndexes,
            receipt,
            err),
        err)
    var expectedMoveCount: int64
    if moveToAssembler:
        expectedMoveCount = int64(1)
    assert(receipt.outcome == outcome &&
           receipt.live == int64(0) &&
           receipt.liveBytes == int64(0) &&
           receipt.ownerTransferCount == expectedMoveCount &&
           receipt.payloadStorageReleased &&
           receipt.auxiliaryStorageReleased &&
           receipt.ledgerStorageReleased,
           "backend2 fragment lifecycle: failure outcome mismatch")

fn FragmentLifecycleReceiptMutationRejected() =
    var fragments: b2t.FunctionFragment[]
    add(fragments, FragmentLifecycleFixture(17))
    var fragmentBuilt: bool[]
    add(fragmentBuilt, true)
    var functionIrIndexes: int32[]
    add(functionIrIndexes, 17)
    var lifecycle: b2life.Backend2FragmentLifecycle
    b2life.Backend2FragmentLifecycleBegin(
        lifecycle, fragments, fragmentBuilt, functionIrIndexes)
    b2life.Backend2FragmentLifecycleMoveToAssembler(lifecycle)
    var receipt: b2life.Backend2FragmentReleaseReceipt
    b2life.Backend2FragmentLifecycleReleaseWithReceipt(
        lifecycle,
        fragments,
        fragmentBuilt,
        functionIrIndexes,
        b2life.Backend2FragmentOutcomeAssembled,
        receipt)
    receipt.outcome = b2life.Backend2FragmentOutcomeAssemblerFailure
    var err: str
    let accepted =
        b2life.Backend2FragmentReleaseReceiptConsumeStrictInto(
            lifecycle,
            fragments,
            fragmentBuilt,
            functionIrIndexes,
            receipt,
            err)
    assert(!accepted && err != "",
        "backend2 fragment lifecycle: receipt mutation accepted")

fn FragmentLifecycleFailureMatrixCycle(index: int32) =
    let caseKind = index % 4
    var fragments: b2t.FunctionFragment[]
    var fragmentBuilt: bool[]
    var functionIrIndexes: int32[]
    var outcome = b2life.Backend2FragmentOutcomeWorkerFailure
    var moveToAssembler: bool
    if caseKind == 3:
        var empty: b2t.FunctionFragment
        add(fragments, empty)
        add(fragmentBuilt, false)
        add(functionIrIndexes, index)
        outcome = b2life.Backend2FragmentOutcomeNoLowerable
    else:
        add(fragments, FragmentLifecycleFixture(index))
        if caseKind == 0:
            # Partial worker payload: decoded storage exists but the row was
            # never committed as built.
            add(fragmentBuilt, false)
        else:
            add(fragmentBuilt, true)
            add(functionIrIndexes, index)
            moveToAssembler = true
            outcome =
                b2life.Backend2FragmentOutcomeAssemblerFailure
            if caseKind == 1:
                # Mid-assembler semantic admission failure is present before
                # owner minting, so failure finalization retains exact identity.
                fragments[0].contentCid =
                    FragmentLifecycleOwnedText("invalid_content_cid")
            else:
                # Nested payload failure exercises a real inner sequence owner.
                add(fragments[0].cstringPayloadRawBytes, 99)
    var lifecycle: b2life.Backend2FragmentLifecycle
    b2life.Backend2FragmentLifecycleBegin(
        lifecycle,
        fragments,
        fragmentBuilt,
        functionIrIndexes)
    if moveToAssembler:
        b2life.Backend2FragmentLifecycleMoveToAssembler(lifecycle)
    var receipt: b2life.Backend2FragmentReleaseReceipt
    var err: str
    assert(
        b2life.Backend2FragmentLifecycleFinalizeStrictInto(
            lifecycle,
            fragments,
            fragmentBuilt,
            functionIrIndexes,
            outcome,
            receipt,
            err),
        err)
    assert(receipt.live == int64(0) &&
           receipt.liveBytes == int64(0) &&
           receipt.payloadStorageReleased &&
           receipt.auxiliaryStorageReleased &&
           receipt.ledgerStorageReleased &&
           fragments.cap == 0 &&
           fragmentBuilt.cap == 0 &&
           functionIrIndexes.cap == 0,
           "backend2 fragment lifecycle: failure matrix unbalanced")

fn FragmentLifecycleIdentityMutation() =
    var fragments: b2t.FunctionFragment[]
    add(fragments, FragmentLifecycleFixture(7))
    var fragmentBuilt: bool[]
    add(fragmentBuilt, true)
    var functionIrIndexes: int32[]
    add(functionIrIndexes, 7)
    var lifecycle: b2life.Backend2FragmentLifecycle
    b2life.Backend2FragmentLifecycleBegin(
        lifecycle, fragments, fragmentBuilt, functionIrIndexes)
    fragments[0].bodyIrPayload = "tampered_after_owner_token"
    var receipt: b2life.Backend2FragmentReleaseReceipt
    b2life.Backend2FragmentLifecycleReleaseWithReceipt(
        lifecycle,
        fragments,
        fragmentBuilt,
        functionIrIndexes,
        b2life.Backend2FragmentOutcomeWorkerFailure,
        receipt)

fn main(): int32 =
    if cmdline.ParamCount() > 0 &&
       cmdline.ParamStr(1) == "--identity-mutation":
        FragmentLifecycleIdentityMutation()
        return 9
    for cycle in 0..<1000:
        FragmentLifecycleOneCycle(cycle)
        FragmentLifecycleFailureMatrixCycle(cycle)
    FragmentLifecycleNoLowerable()
    FragmentLifecycleFailureOutcome(
        b2life.Backend2FragmentOutcomeWorkerFailure, false)
    FragmentLifecycleFailureOutcome(
        b2life.Backend2FragmentOutcomeAssemblerFailure, true)
    FragmentLifecycleReceiptMutationRejected()
    echo("BACKEND2_FRAGMENT_LIFECYCLE_OK cycles=1000 failure_matrix=1000 ledger_live=0 ledger_live_bytes=0")
    return 0

main()
