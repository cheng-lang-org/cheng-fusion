import std/os
import std/strings as strings

fn assertFileHas(path: str, needle: str, label: str) =
    assert(os.FileExists(path), label)
    assert(os.FileSize(path) > int64(0), label)
    let text: str = os.ReadFile(path)
    assert(strings.StrContains(text, needle), label)

fn assertTextHas(text: str, needle: str, label: str) =
    assert(strings.StrContains(text, needle), label)

fn main(): int32 =
    let specText = os.ReadFile("docs/cheng-formal-spec.md")
    let typedText = os.ReadFile("src/core/lang/typed_expr.cheng")

    assertTextHas(specText,
                  "string_abi_contract.abi.str_direct_c_abi=forbidden",
                  " ffi str abi negative: spec direct forbidden")
    assertTextHas(specText,
                  "`str bridge` 合入条件",
                  " ffi str abi negative: spec bridge acceptance")
    assertTextHas(typedText,
                  "fn TypedExprValidateStrCAbiBridge",
                  " ffi str abi negative: validator exists")
    assertTextHas(typedText,
                  "TypedExprValidateStrCAbiBridge(source.sourcePath",
                  " ffi str abi negative: validator wired")
    assertTextHas(typedText,
                  "ZRPC/SABI violation",
                  " ffi str abi negative: diagnostic text")

    assertFileHas("tests/cheng/backend/fixtures/compile_fail_ffi_importc_str_direct_param.cheng",
                  "fn cPuts(text: str): int32",
                  " ffi str abi negative: importc param fixture")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_ffi_importc_str_direct_return.cheng",
                  "): str",
                  " ffi str abi negative: importc return fixture")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_ffi_exportc_str_direct_param.cheng",
                  "@exportc(\"cheng_export_bad_str_param\")",
                  " ffi str abi negative: exportc param fixture")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_ffi_exportc_str_direct_return.cheng",
                  "@exportc(\"cheng_export_bad_str_return\")",
                  " ffi str abi negative: exportc return fixture")
    assertFileHas("tests/cheng/backend/fixtures/hello_importc_puts.cheng",
                  "fn cPuts(s: cstring): int32",
                  " ffi str abi negative: puts migrated cstring")
    assertFileHas("tests/cheng/backend/fixtures/importc_var_str_i64_direct_return.cheng",
                  "): cstring",
                  " ffi str abi negative: raw return migrated cstring")

    echo(" ffi_str_abi_negative_smoke ok")
    return 0
