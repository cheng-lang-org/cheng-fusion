import std/system
import std/hashmaps as hashmaps

type
    ReproBox6 = ref object
        m: hashmaps.HashMapStrInt

fn reproTakePutback6(b: var ReproBox6) =
    var wrapper = b.m
    b.m = wrapper

fn main() =
    var b: ReproBox6 = new(ReproBox6)
    hashmaps.HashMapStrIntInitInPlace(b.m, 64)
    reproTakePutback6(b)
    echo("repro_orc_boxfield_c6 ok")
