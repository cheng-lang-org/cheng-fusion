import std/strings
import cheng/core/lang/intern as langintern

type
    ParserAliasOrigins =
        values: int32[]

    ParserAliasTree = ref object
        importOrigins: ParserAliasOrigins
        internPool: langintern.InternPool

fn ParserAliasAppend(values: var int32[]) =
    add(values, 7)

fn ParserAliasMutate(tree: var ParserAliasTree) =
    var origins = tree.importOrigins
    ParserAliasAppend(origins.values)

@borrows
@borrow_result
fn ParserAliasPrefixOrIdentity(text: str,
                                prefix: bool): str =
    if prefix:
        return strings.SliceBytes(text, 0, 1)
    return text

fn main(): int32 =
    var tree = new(ParserAliasTree)
    tree.internPool = langintern.InternPoolNew()
    langintern.InternPoolRelease(tree.internPool)
    if tree.internPool.ownerLifecycleState !=
       langintern.InternPoolOwnerReleased:
        return 10
    ParserAliasMutate(tree)
    if tree.importOrigins.values.len != 1 ||
       tree.importOrigins.values[0] != 7:
        return 11
    let source = "view"
    let prefix = ParserAliasPrefixOrIdentity(source, true)
    if prefix != "v":
        return 12
    return 0
