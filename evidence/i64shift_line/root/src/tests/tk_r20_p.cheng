fn R20F(i: int32): str =
    if i > 0:
        return "ok"
    return "neg"

fn R20G(): str =
    for p in 0..<3:
        let r: str = R20F(p)
        if r.len == 2:
            return r
    return "none"

fn main(): int32 =
    if R20G().len != 2:
        return 10
    echo("r20 p ok")
    return 0
