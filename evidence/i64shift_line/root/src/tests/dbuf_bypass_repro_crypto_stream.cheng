# D-v2 验收夹具 repro A: 复核员抓到的 crypto_stream.cheng 旁路缺陷同构复现。
# 用真实生产函数(msquicCryptoStreamAdd/Available/Consume)直接驱动，不是抽象类比。
#
# 旧旁路代码(直读/直写 GrowByteBuffer.data)在 D-v1 的 cap/len 语义下会:
#   ①Available() 把已分配容量当逻辑长度返回(读容量当长度 -> 静默污染)
#   ②Consume() 排空后直写 .data=emptyBytes() 不同步 .len -> 下次 Add 用旧
#     (更大的)len 去 memcpy 一个已经是 nil 的 .data.data -> SIGSEGV
# D-v2 迁移到 bytebuffer.ByteBufferLen/ByteBufferConsume 后两者都必须消失。

import std/result
import std/rawbytes
import cheng/quic/core/crypto_stream as cstream

fn main(): int32 =
    var stream: cstream.MsQuicCryptoStream = cstream.initMsQuicCryptoStream()

    let addRes1 = cstream.msquicCryptoStreamAdd(stream, 0, BytesFromString("abc"))
    assert(IsOk(addRes1), " dbuf_bypass_repro_crypto_stream: add1")

    let avail1: int32 = cstream.msquicCryptoStreamAvailable(stream)
    assert(avail1 == 3, " dbuf_bypass_repro_crypto_stream: avail1 must equal logical len=3, not allocated capacity")

    let got1: Bytes = cstream.msquicCryptoStreamConsume(stream, avail1)
    assert(BytesLen(got1) == 3, " dbuf_bypass_repro_crypto_stream: consume1 len must be exactly 3, no trailing zero-fill pollution")
    assert(BytesToString(got1) == "abc", " dbuf_bypass_repro_crypto_stream: consume1 content")

    # 缓冲区此刻已排空(len=0)。旧旁路代码会在这里留下 stale len，
    # 下一次 Add 会 memcpy 一个 nil 指针 -> SIGSEGV。
    let addRes2 = cstream.msquicCryptoStreamAdd(stream, 3, BytesFromString("defgh"))
    assert(IsOk(addRes2), " dbuf_bypass_repro_crypto_stream: add2 (post-drain, crash site under bypass)")

    let avail2: int32 = cstream.msquicCryptoStreamAvailable(stream)
    assert(avail2 == 5, " dbuf_bypass_repro_crypto_stream: avail2 must equal 5")

    let got2: Bytes = cstream.msquicCryptoStreamConsume(stream, avail2)
    assert(BytesLen(got2) == 5, " dbuf_bypass_repro_crypto_stream: consume2 len exact")
    assert(BytesToString(got2) == "defgh", " dbuf_bypass_repro_crypto_stream: consume2 content exact")

    echo(" dbuf_bypass_repro_crypto_stream ok")
    return 0
