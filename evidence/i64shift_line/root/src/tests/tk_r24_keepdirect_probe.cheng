fn R24Trim(raw: str): str =
    return raw

fn R24Tag(raw: str): str =
    if raw.len > 3:
        return "long"
    return "short"

fn R24KeepDirect(lineRaw: str, genericPos: int32): int32 =
    let keep = R24Tag(lineRaw)
    let headRaw = R24Trim(lineRaw)
    var head: str
    if genericPos > 0:
        head = R24Tag(headRaw)
    else:
        head = headRaw
    return head.len * 10 + keep.len

fn main(): int32 =
    let a = R24KeepDirect("abcdef", 1)
    if a != 44:
        return 10
    let b = R24KeepDirect("abcdef", 0)
    if b != 64:
        return 11
    let c = R24KeepDirect("ab", 1)
    if c != 55:
        return 12
    echo("r24 keepdirect ok a=44 b=64 c=55")
    return 0
