# Duck wiring divergence diagnosis: the microduck_ball_probe caseB
# wiring (15-link / 14-joint full MJCF assembly, both hip-roll hinge
# servos parked at 0) reportedly stands 2000 ticks on the real ball,
# while the duck_film wiring - loudly claimed "caseB verbatim" - falls
# at 59 ticks. This binary settles WHICH wiring item owns the split.
#
# Static wiring diff (settled by reading both sources, no runtime):
#   1. tick granularity: BOTH loops call BallServoRigidTick once per
#      tick, immediately before Physics3dStep (film FrameStep=24 only
#      gates the frame/camera snapshot, read-only). No difference.
#   2. ball injection: BOTH spawn the ball execution-side after the
#      assembly and before the servo Init and the first step. No
#      difference.
#   3. balance path: NEITHER wiring runs ExecutionInit / CsgBalance*;
#      both drive only ball_servo_rigid. No difference.
#   4. ground: BOTH use the implicit z = 0 plane (the film ground is
#      render-only). No difference.
#   5. Physics3dStep forceSource tag: provenance only (receipt field +
#      CID literal), no physics. Not a factor (still carried verbatim
#      per case below).
#   6. THE assembly: probe = mm.MicroduckModelBuild() - 15 capsules,
#      14 hinge servos (5 DoF per leg: yaw/roll/pitch/knee/ankle, the
#      roll servos parked at 0 with full hip tau); film =
#      mm.MicroduckAssemblyBuild() - 13 capsules, 12 hinge servos (the
#      two hip carriers fused into one hip-yoke body per side, roll DoF
#      gone). This file measures that factor alone, plus a
#      mechanism-attribution rung.
#
# Episode matrix (one buildKind x roll-tau factor per run, 1500 ticks
# each, servo 1:1 every tick, zero-velocity release, identical ball and
# root pose, fresh seed-911 world per run):
#   caseA  probe wiring verbatim        (15L/14J, rollTau = full hip)
#   caseB  film wiring verbatim         (13L/12J)
#   caseC  modeB': film loop + probe assembly (15L/14J) - the single
#          factor flip; also the corrected film wiring candidate
#   caseD  15L/14J with the two roll servo taus cut to 1 uNm - decides
#          whether the stabilizer is the roll servo torque itself or
#          the extra DoF / split-inertia structure
#
# Pose parity (factor "initial pose"): both assemblies built at the
# same root pose; every shared link (trunk, thighs, shins, feet, neck
# chain, head) compared spawn pose bit-for-bit; the fused yokes are the
# designed difference (mass-weighted fusion of the two carriers); the
# frozen servo ride offsets (torso-vs-ball at init) compared too.
#
# Pass contract: pose parity GREEN, caseA stands (baseline alive under
# the current engine), caseC = modeB' stands 1500 ticks armed, drift
# under 2 m, zero rejected steps. caseB/caseD are reported as data.
#
# Physics-loop discipline: the episode loops do scalar math only (no
# str construction, no echo, no allocation); trace samples buffer into
# preallocated arrays and echo after the loop.
import std/math as m
import std/strings as strings
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/constraints3d
import cheng/game/csg/joint_motor
import cheng/game/csg/numerics
import cheng/game/csg/ball_servo_rigid as bsr
import cheng/game/csg/microduck_model as mm

const
    # per-episode horizon (the modeB' acceptance: >= 1500 ticks)
    DiagTicks: int32 = 1500
    DiagRecordEvery: int32 = 100
    DiagRecordCount: int32 = 15
    DriftLimitM: float64 = 2.0
    # caseD mechanism rung: roll servo torque cut to 1 uNm (the setter
    # imposes no positivity bound; the parked goal stays 0)
    RollTauDisabledNm: float64 = 0.000001
    # real FIBA size-7 ball, the probe caseB constants verbatim
    BallCenterX: float64 = 0.0
    BallCenterY: float64 = 0.85
    BallCenterZ: float64 = 0.121
    BallRadiusM: float64 = 0.121
    BallMassKg: float64 = 0.62
    BallTopZ: float64 = 0.242
    DuckRootZ: float64 = 0.275364117885
    AngleNeutralTolRad: float64 = 0.001
    AnchorGapTolM: float64 = 0.001

type
    DiagReport =
        ok: bool
        bodies: int32
        cons: int32
        fallTick: int32
        disarmTick: int32
        armedEnd: int32
        rejected: int32
        firstRejectTick: int32
        driftMax: float64
        driftEnd: float64
        tiltMaxDeg: float64
        offX: float64
        offY: float64
        offZ: float64
        servoTicks: int32

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# Bisection acos on [-1, 1]: strictly-decreasing cos on [0, pi], fixed 60
# halvings (the probe's proven shape).
fn probeAcos(c: float64): float64 =
    var c2 = c
    if c2 > 1.0:
        c2 = 1.0
    if c2 < 0.0 - 1.0:
        c2 = 0.0 - 1.0
    var lo: float64 = 0.0
    var hi: float64 = m.Pi
    var i: int32 = 0
    while i < 60:
        let mid = (lo + hi) * 0.5
        if m.cosFloat(mid) > c2:
            lo = mid
        else:
            hi = mid
        i = i + 1
    return (lo + hi) * 0.5

# Tilt of a capsule pose's up direction against the vertical, degrees.
fn upTiltDeg(qx: float64, qy: float64): float64 =
    let upz = 1.0 - 2.0 * (qx * qx + qy * qy)
    return probeAcos(upz) * joint_motor.JointMotorDegPerRad

# Park the servo command and goal at the measured standing flexion so tick
# 0 commands no step change; returns the measured angle.
fn parkHingeServo(w: var World3d, ci: int32): float64 =
    let th0 = Constraints3dHingeAngle(w, ci)
    w.conCmd[ci] = th0
    w.conGoal[ci] = th0
    return th0

# One MJCF joint -> one hinge servo from the model table (the probe /
# film shared construction, byte-for-byte).
@borrows
fn stanceHinge(w: var World3d, mdl: mm.MicroduckModel, jointIdx: int32, refX: float64, refY: float64, refZ: float64, tauMax: float64, omegaRadS: float64): int32 =
    let jt = mdl.joints[jointIdx]
    let pl = mdl.links[jt.parentLink]
    let cl = mdl.links[jt.childLink]
    var anchAx: float64
    var anchAy: float64
    var anchAz: float64
    mm.MicroduckPointToLocal(pl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, pl.cx, pl.cy, pl.cz, anchAx, anchAy, anchAz)
    var axisAx: float64
    var axisAy: float64
    var axisAz: float64
    mm.MicroduckVecToLocal(pl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisAx, axisAy, axisAz)
    var anchBx: float64
    var anchBy: float64
    var anchBz: float64
    mm.MicroduckPointToLocal(cl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, cl.cx, cl.cy, cl.cz, anchBx, anchBy, anchBz)
    var axisBx: float64
    var axisBy: float64
    var axisBz: float64
    mm.MicroduckVecToLocal(cl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisBx, axisBy, axisBz)
    let ci = World3dAddHingeJoint(w, jt.parentLink, jt.childLink, world3d.World3dConHingeServo, anchAx, anchAy, anchAz, anchBx, anchBy, anchBz, axisAx, axisAy, axisAz, axisBx, axisBy, axisBz)
    var refAlX: float64
    var refAlY: float64
    var refAlZ: float64
    mm.MicroduckVecToLocal(pl.axisKind, refX, refY, refZ, refAlX, refAlY, refAlZ)
    var refBlX: float64
    var refBlY: float64
    var refBlZ: float64
    mm.MicroduckVecToLocal(cl.axisKind, refX, refY, refZ, refBlX, refBlY, refBlZ)
    World3dSetHingeRefs(w, ci, refAlX, refAlY, refAlZ, refBlX, refBlY, refBlZ)
    World3dSetHingeServo(w, ci, tauMax, omegaRadS, jt.minRad, jt.maxRad)
    if Constraints3dJointAnchorGap(w, ci) > AnchorGapTolM:
        panic("duck wiring diag: hinge pivot gap at " + jt.name)
    return ci

# The probe caseB assembly: 15 capsules, 14 hinge servos (hip rolls
# take rollTauMax - the caseD rung passes the cut value), every servo
# parked at its measured stance angle. The probe buildDuck, echoes
# stripped, th0 acceptance panics kept.
fn buildDuckFull(w: var World3d, rootX: float64, rootY: float64, rootZ: float64, rollTauMax: float64) =
    World3dReset(w, int64(911))
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if mdl.links.len != 15:
        panic("duck wiring diag: full link count")
    if mdl.joints.len != 14:
        panic("duck wiring diag: full joint count")
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > 0.000000001:
        panic("duck wiring diag: full total mass off the MJCF sum")
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, rootX, rootY, rootZ, 0.0)
        let slot = World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("duck wiring diag: full link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    let tauHip = mm.MicroduckTauMaxHipNm
    let tauKnee = mm.MicroduckTauMaxKneeNm
    let tauAnkle = mm.MicroduckTauMaxAnkleNm
    let tauNeck = mm.MicroduckTauMaxNeckNm
    let ciHipYawL = stanceHinge(w, mdl, mm.MicroduckJointHipYawL, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipRollL = stanceHinge(w, mdl, mm.MicroduckJointHipRollL, 0.0, 0.0, 0.0 - 1.0, rollTauMax, omegaRadS)
    let ciHipPitchL = stanceHinge(w, mdl, mm.MicroduckJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeL = stanceHinge(w, mdl, mm.MicroduckJointKneeL, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleL = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchL, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciHipYawR = stanceHinge(w, mdl, mm.MicroduckJointHipYawR, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipRollR = stanceHinge(w, mdl, mm.MicroduckJointHipRollR, 0.0, 0.0, 0.0 - 1.0, rollTauMax, omegaRadS)
    let ciHipPitchR = stanceHinge(w, mdl, mm.MicroduckJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeR = stanceHinge(w, mdl, mm.MicroduckJointKneeR, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleR = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchR, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciNeck = stanceHinge(w, mdl, mm.MicroduckJointNeckPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadPitch = stanceHinge(w, mdl, mm.MicroduckJointHeadPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadYaw = stanceHinge(w, mdl, mm.MicroduckJointHeadYaw, 0.0, 1.0, 0.0, tauNeck, omegaRadS)
    let ciHeadRoll = stanceHinge(w, mdl, mm.MicroduckJointHeadRoll, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let th = mm.MicroduckStanceHipRad
    let thHipL = parkHingeServo(w, ciHipPitchL)
    let thHipR = parkHingeServo(w, ciHipPitchR)
    let thKneeL = parkHingeServo(w, ciKneeL)
    let thKneeR = parkHingeServo(w, ciKneeR)
    let thAnkleL = parkHingeServo(w, ciAnkleL)
    let thAnkleR = parkHingeServo(w, ciAnkleR)
    let thNeck = parkHingeServo(w, ciNeck)
    parkHingeServo(w, ciHeadPitch)
    parkHingeServo(w, ciHeadYaw)
    parkHingeServo(w, ciHeadRoll)
    parkHingeServo(w, ciHipYawL)
    parkHingeServo(w, ciHipYawR)
    parkHingeServo(w, ciHipRollL)
    parkHingeServo(w, ciHipRollR)
    if numerics.CsgAbs(thHipL - th) > AngleNeutralTolRad:
        panic("duck wiring diag: hip pitch L th0 off the stance (full)")
    if numerics.CsgAbs(thHipR + th) > AngleNeutralTolRad:
        panic("duck wiring diag: hip pitch R th0 off the stance (full)")
    if numerics.CsgAbs(thAnkleL + th) > AngleNeutralTolRad:
        panic("duck wiring diag: ankle L th0 off the stance (full)")
    if numerics.CsgAbs(thAnkleR - th) > AngleNeutralTolRad:
        panic("duck wiring diag: ankle R th0 off the stance (full)")
    if numerics.CsgAbs(thKneeL) > AngleNeutralTolRad:
        panic("duck wiring diag: knee L th0 not neutral (full)")
    if numerics.CsgAbs(thKneeR) > AngleNeutralTolRad:
        panic("duck wiring diag: knee R th0 not neutral (full)")
    if numerics.CsgAbs(thNeck) > AngleNeutralTolRad:
        panic("duck wiring diag: neck th0 not neutral (full)")

# The film assembly: 13 capsules, 12 hinge servos (hip carriers fused
# into one yoke body per side, roll DoF gone). The duck_film buildDuck,
# echoes stripped, th0 acceptance panics kept.
fn buildDuckAssembly(w: var World3d, rootX: float64, rootY: float64, rootZ: float64) =
    World3dReset(w, int64(911))
    var mdl: mm.MicroduckModel = mm.MicroduckAssemblyBuild()
    if mdl.links.len != 13:
        panic("duck wiring diag: assembly link count")
    if mdl.joints.len != 12:
        panic("duck wiring diag: assembly joint count")
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > 0.000000001:
        panic("duck wiring diag: assembly total mass off the MJCF sum")
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, rootX, rootY, rootZ, 0.0)
        let slot = World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("duck wiring diag: assembly link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    let tauHip = mm.MicroduckTauMaxHipNm
    let tauKnee = mm.MicroduckTauMaxKneeNm
    let tauAnkle = mm.MicroduckTauMaxAnkleNm
    let tauNeck = mm.MicroduckTauMaxNeckNm
    let ciHipYawL = stanceHinge(w, mdl, mm.MicroduckAssemblyJointHipYawL, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipPitchL = stanceHinge(w, mdl, mm.MicroduckAssemblyJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeL = stanceHinge(w, mdl, mm.MicroduckAssemblyJointKneeL, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleL = stanceHinge(w, mdl, mm.MicroduckAssemblyJointAnkleL, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciHipYawR = stanceHinge(w, mdl, mm.MicroduckAssemblyJointHipYawR, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipPitchR = stanceHinge(w, mdl, mm.MicroduckAssemblyJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeR = stanceHinge(w, mdl, mm.MicroduckAssemblyJointKneeR, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleR = stanceHinge(w, mdl, mm.MicroduckAssemblyJointAnkleR, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciNeck = stanceHinge(w, mdl, mm.MicroduckAssemblyJointNeckPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadPitch = stanceHinge(w, mdl, mm.MicroduckAssemblyJointHeadPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadYaw = stanceHinge(w, mdl, mm.MicroduckAssemblyJointHeadYaw, 0.0, 1.0, 0.0, tauNeck, omegaRadS)
    let ciHeadRoll = stanceHinge(w, mdl, mm.MicroduckAssemblyJointHeadRoll, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let th = mm.MicroduckStanceHipRad
    let thHipL = parkHingeServo(w, ciHipPitchL)
    let thHipR = parkHingeServo(w, ciHipPitchR)
    let thKneeL = parkHingeServo(w, ciKneeL)
    let thKneeR = parkHingeServo(w, ciKneeR)
    let thAnkleL = parkHingeServo(w, ciAnkleL)
    let thAnkleR = parkHingeServo(w, ciAnkleR)
    let thNeck = parkHingeServo(w, ciNeck)
    parkHingeServo(w, ciHeadPitch)
    parkHingeServo(w, ciHeadYaw)
    parkHingeServo(w, ciHeadRoll)
    parkHingeServo(w, ciHipYawL)
    parkHingeServo(w, ciHipYawR)
    if numerics.CsgAbs(thHipL - th) > AngleNeutralTolRad:
        panic("duck wiring diag: hip pitch L th0 off the stance (assembly)")
    if numerics.CsgAbs(thHipR + th) > AngleNeutralTolRad:
        panic("duck wiring diag: hip pitch R th0 off the stance (assembly)")
    if numerics.CsgAbs(thAnkleL + th) > AngleNeutralTolRad:
        panic("duck wiring diag: ankle L th0 off the stance (assembly)")
    if numerics.CsgAbs(thAnkleR - th) > AngleNeutralTolRad:
        panic("duck wiring diag: ankle R th0 off the stance (assembly)")
    if numerics.CsgAbs(thKneeL) > AngleNeutralTolRad:
        panic("duck wiring diag: knee L th0 not neutral (assembly)")
    if numerics.CsgAbs(thKneeR) > AngleNeutralTolRad:
        panic("duck wiring diag: knee R th0 not neutral (assembly)")
    if numerics.CsgAbs(thNeck) > AngleNeutralTolRad:
        panic("duck wiring diag: neck th0 not neutral (assembly)")

# Factor "initial pose": both assemblies at the same root pose; every
# shared link compared bit-for-bit (the fused yokes are the designed
# difference), plus the frozen servo ride offsets and world populations.
fn poseParityCheck(): int32 =
    var wp: world3d.World3d
    var wf: world3d.World3d
    buildDuckFull(wp, BallCenterX, BallCenterY, DuckRootZ, mm.MicroduckTauMaxHipNm)
    buildDuckAssembly(wf, BallCenterX, BallCenterY, DuckRootZ)
    let ballP = World3dSpawnBody(wp, BallCenterX, BallCenterY, BallCenterZ, BallMassKg, BallRadiusM, world3d.World3dBodyBallRigid)
    let ballF = World3dSpawnBody(wf, BallCenterX, BallCenterY, BallCenterZ, BallMassKg, BallRadiusM, world3d.World3dBodyBallRigid)
    var stp: bsr.BallServoRigidState
    bsr.BallServoRigidStateInit(stp, wp, ballP, mm.MicroduckLinkTorso, mm.MicroduckLinkHead,
        bsr.BallServoRigidDefaultK, bsr.BallServoRigidDefaultC,
        bsr.BallServoRigidDefaultLinCapMps, bsr.BallServoRigidDefaultLinDampCapMps,
        bsr.BallServoRigidDefaultKAng, bsr.BallServoRigidDefaultCAng,
        bsr.BallServoRigidDefaultAngCapRadS, bsr.BallServoRigidDefaultAngDampCapRadS,
        bsr.BallServoRigidDefaultRampTicks)
    var stf: bsr.BallServoRigidState
    bsr.BallServoRigidStateInit(stf, wf, ballF, mm.MicroduckLinkTorso, mm.MicroduckAssemblyLinkHead,
        bsr.BallServoRigidDefaultK, bsr.BallServoRigidDefaultC,
        bsr.BallServoRigidDefaultLinCapMps, bsr.BallServoRigidDefaultLinDampCapMps,
        bsr.BallServoRigidDefaultKAng, bsr.BallServoRigidDefaultCAng,
        bsr.BallServoRigidDefaultAngCapRadS, bsr.BallServoRigidDefaultAngDampCapRadS,
        bsr.BallServoRigidDefaultRampTicks)
    # film slot -> probe slot for the shared links (-1 = the fused yoke,
    # no probe counterpart by design)
    var mapF: int32[]
    setLen(mapF, 13)
    mapF[0] = 0
    mapF[1] = 0 - 1
    mapF[2] = 3
    mapF[3] = 4
    mapF[4] = 5
    mapF[5] = 0 - 1
    mapF[6] = 8
    mapF[7] = 9
    mapF[8] = 10
    mapF[9] = 11
    mapF[10] = 12
    mapF[11] = 13
    mapF[12] = 14
    var maxPosMm: float64 = 0.0
    var maxQuat: float64 = 0.0
    var fi: int32 = 0
    while fi < 13:
        let pj = mapF[fi]
        if pj >= 0:
            let dx = numerics.CsgAbs(wf.bodyPx[fi] - wp.bodyPx[pj]) * 1000.0
            let dy = numerics.CsgAbs(wf.bodyPy[fi] - wp.bodyPy[pj]) * 1000.0
            let dz = numerics.CsgAbs(wf.bodyPz[fi] - wp.bodyPz[pj]) * 1000.0
            var dm = dx
            if dy > dm:
                dm = dy
            if dz > dm:
                dm = dz
            if dm > maxPosMm:
                maxPosMm = dm
            let dqw = numerics.CsgAbs(wf.bodyQuatW[fi] - wp.bodyQuatW[pj])
            let dqx = numerics.CsgAbs(wf.bodyQuatX[fi] - wp.bodyQuatX[pj])
            let dqy = numerics.CsgAbs(wf.bodyQuatY[fi] - wp.bodyQuatY[pj])
            let dqz = numerics.CsgAbs(wf.bodyQuatZ[fi] - wp.bodyQuatZ[pj])
            var dq = dqw
            if dqx > dq:
                dq = dqx
            if dqy > dq:
                dq = dqy
            if dqz > dq:
                dq = dqz
            if dq > maxQuat:
                maxQuat = dq
        fi = fi + 1
    let dOffX = numerics.CsgAbs(stf.offX - stp.offX) * 1000.0
    let dOffY = numerics.CsgAbs(stf.offY - stp.offY) * 1000.0
    let dOffZ = numerics.CsgAbs(stf.offZ - stp.offZ) * 1000.0
    echo("parity bodies probe=" + strings.IntToStr(wp.count) + " (15 duck + 1 ball) film=" + strings.IntToStr(wf.count) + " (13 duck + 1 ball) cons probe=" + strings.IntToStr(wp.conCount) + " film=" + strings.IntToStr(wf.conCount))
    echo("parity sharedLink maxPoseDiff_mm=" + fmtMm(maxPosMm) + " maxQuatDiff=" + fmtMm(maxQuat) + " offDiff_mm X=" + fmtMm(dOffX) + " Y=" + fmtMm(dOffY) + " Z=" + fmtMm(dOffZ) + " (yokes excluded: the designed fusion)")
    if wp.count != 16:
        echo("FAIL parity probe body count")
        return 1
    if wf.count != 14:
        echo("FAIL parity film body count")
        return 1
    if wp.conCount != 14:
        echo("FAIL parity probe constraint count")
        return 1
    if wf.conCount != 12:
        echo("FAIL parity film constraint count")
        return 1
    if maxPosMm > 0.001:
        echo("FAIL parity shared-link pose diff")
        return 1
    if maxQuat > 0.000000001:
        echo("FAIL parity shared-link quat diff")
        return 1
    if dOffX > 0.001:
        echo("FAIL parity servo offset X")
        return 1
    if dOffY > 0.001:
        echo("FAIL parity servo offset Y")
        return 1
    if dOffZ > 0.001:
        echo("FAIL parity servo offset Z")
        return 1
    echo("parity GREEN: identical release pose for every shared link; the only structural difference is the hip assembly itself")
    return 0

# One episode: fresh seed-911 world, buildKind 0 = probe assembly
# (rollTauMax parameterizes the roll servo torque), 1 = film assembly;
# ball injected execution-side; BallServoRigidStateInit at the release
# pose; BallServoRigidTick + Physics3dStep 1:1 every tick (BOTH source
# wirings - settled statically). Scalar-only loop; trace buffered.
@borrows
fn runEpisode(buildKind: int32, rollTauMax: float64, ticks: int32, tag: str, label: str): DiagReport =
    var rep: DiagReport
    rep.ok = false
    rep.bodies = 0
    rep.cons = 0
    rep.fallTick = 0 - 1
    rep.disarmTick = 0 - 1
    rep.armedEnd = 0
    rep.rejected = 0
    rep.firstRejectTick = 0 - 1
    rep.driftMax = 0.0
    rep.driftEnd = 0.0
    rep.tiltMaxDeg = 0.0
    rep.offX = 0.0
    rep.offY = 0.0
    rep.offZ = 0.0
    rep.servoTicks = 0
    var w: world3d.World3d
    if buildKind == 0:
        buildDuckFull(w, BallCenterX, BallCenterY, DuckRootZ, rollTauMax)
    else:
        buildDuckAssembly(w, BallCenterX, BallCenterY, DuckRootZ)
    rep.bodies = w.count
    rep.cons = w.conCount
    let ballSlot = World3dSpawnBody(w, BallCenterX, BallCenterY, BallCenterZ, BallMassKg, BallRadiusM, world3d.World3dBodyBallRigid)
    let torsoSlot: int32 = mm.MicroduckLinkTorso
    var headSlot: int32
    if buildKind == 0:
        headSlot = mm.MicroduckLinkHead
    else:
        headSlot = mm.MicroduckAssemblyLinkHead
    var st: bsr.BallServoRigidState
    bsr.BallServoRigidStateInit(st, w, ballSlot, torsoSlot, headSlot,
        bsr.BallServoRigidDefaultK, bsr.BallServoRigidDefaultC,
        bsr.BallServoRigidDefaultLinCapMps, bsr.BallServoRigidDefaultLinDampCapMps,
        bsr.BallServoRigidDefaultKAng, bsr.BallServoRigidDefaultCAng,
        bsr.BallServoRigidDefaultAngCapRadS, bsr.BallServoRigidDefaultAngDampCapRadS,
        bsr.BallServoRigidDefaultRampTicks)
    rep.offX = st.offX
    rep.offY = st.offY
    rep.offZ = st.offZ
    let ballX0: float64 = w.bodyPx[ballSlot]
    let ballY0: float64 = w.bodyPy[ballSlot]
    var recTick: int32[]
    var recTorsoZ: float64[]
    var recBallZ: float64[]
    var recDrift: float64[]
    var recTilt: float64[]
    var recArmed: int32[]
    setLen(recTick, DiagRecordCount)
    setLen(recTorsoZ, DiagRecordCount)
    setLen(recBallZ, DiagRecordCount)
    setLen(recDrift, DiagRecordCount)
    setLen(recTilt, DiagRecordCount)
    setLen(recArmed, DiagRecordCount)
    var rejected: int32 = 0
    var firstRejectTick: int32 = 0 - 1
    var fallTick: int32 = 0 - 1
    var disarmTick: int32 = 0 - 1
    var driftMax: float64 = 0.0
    var driftEnd: float64 = 0.0
    var minUpz: float64 = 1.0
    var ti: int32 = 0
    var i: int32 = 0
    while i < ticks:
        bsr.BallServoRigidTick(st, w)
        if st.armed == 0:
            if disarmTick < 0:
                disarmTick = i
        var r = physics3d.Physics3dStep(w, tag)
        if r.statusCode != physics3d.Physics3dStatusOk:
            if firstRejectTick < 0:
                firstRejectTick = i
            rejected = rejected + 1
        let dx = w.bodyPx[ballSlot] - ballX0
        let dy = w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        driftEnd = drift
        if drift > driftMax:
            driftMax = drift
        let tqx = w.bodyQuatX[torsoSlot]
        let tqy = w.bodyQuatY[torsoSlot]
        let upz = 1.0 - 2.0 * (tqx * tqx + tqy * tqy)
        if upz < minUpz:
            minUpz = upz
        if w.bodyPz[headSlot] < w.bodyPz[torsoSlot]:
            if fallTick < 0:
                fallTick = i
        if i % DiagRecordEvery == 0:
            if ti < DiagRecordCount:
                recTick[ti] = i
                recTorsoZ[ti] = w.bodyPz[torsoSlot]
                recBallZ[ti] = w.bodyPz[ballSlot]
                recDrift[ti] = drift
                recTilt[ti] = upTiltDeg(tqx, tqy)
                recArmed[ti] = st.armed
                ti = ti + 1
        i = i + 1
    var k: int32 = 0
    while k < ti:
        echo(label + " t=" + strings.IntToStr(recTick[k]) + " torsoZ_mm=" + fmtMm(recTorsoZ[k] * 1000.0) + " ballZ_mm=" + fmtMm(recBallZ[k] * 1000.0) + " drift_mm=" + fmtMm(recDrift[k] * 1000.0) + " tilt_deg=" + fmtMm(recTilt[k]) + " armed=" + strings.IntToStr(recArmed[k]))
        k = k + 1
    rep.ok = true
    rep.fallTick = fallTick
    rep.disarmTick = disarmTick
    rep.armedEnd = st.armed
    rep.rejected = rejected
    rep.firstRejectTick = firstRejectTick
    rep.driftMax = driftMax
    rep.driftEnd = driftEnd
    rep.tiltMaxDeg = probeAcos(minUpz) * joint_motor.JointMotorDegPerRad
    rep.servoTicks = st.tickCount
    return rep

fn echoSummary(label: str, rep: DiagReport) =
    echo(label + ": bodies=" + strings.IntToStr(rep.bodies) + " cons=" + strings.IntToStr(rep.cons) + " fallTick=" + strings.IntToStr(rep.fallTick) + " disarmTick=" + strings.IntToStr(rep.disarmTick) + " armedEnd=" + strings.IntToStr(rep.armedEnd) + " rejected=" + strings.IntToStr(rep.rejected) + " firstReject=" + strings.IntToStr(rep.firstRejectTick) + " driftMax_mm=" + fmtMm(rep.driftMax * 1000.0) + " driftEnd_mm=" + fmtMm(rep.driftEnd * 1000.0) + " tiltMax_deg=" + fmtMm(rep.tiltMaxDeg) + " off_mm=" + fmtMm(rep.offX * 1000.0) + "/" + fmtMm(rep.offY * 1000.0) + "/" + fmtMm(rep.offZ * 1000.0) + " servoTicks=" + strings.IntToStr(rep.servoTicks))

fn main(): int32 =
    echo("duck wiring diag: probe caseB (15L/14J, roll servos parked) vs duck_film (13L/12J, fused yokes) - " + strings.IntToStr(DiagTicks) + " ticks per episode, servo 1:1 per tick on BOTH sides")
    let par = poseParityCheck()
    let repA = runEpisode(0, mm.MicroduckTauMaxHipNm, DiagTicks, "probe:duckservo", "caseA")
    let repB = runEpisode(1, mm.MicroduckTauMaxHipNm, DiagTicks, "film:duckball", "caseB")
    let repC = runEpisode(0, mm.MicroduckTauMaxHipNm, DiagTicks, "film:duckball", "caseC")
    let repD = runEpisode(0, RollTauDisabledNm, DiagTicks, "diag:rollfree", "caseD")
    echo("--- summary (survival + drift per single-factor rung) ---")
    echoSummary("caseA probeWiring 15L14J rollTau=full", repA)
    echoSummary("caseB filmWiring 13L12J", repB)
    echoSummary("caseC modeB'=filmLoop+15L14J", repC)
    echoSummary("caseD 15L14J rollTau=1uNm", repD)
    echo("--- verdict ---")
    if par != 0:
        echo("FAIL duck wiring diag (pose parity RED)")
        return 1
    if repA.fallTick < 0:
        echo("verdict: caseA (probe wiring) STOOD " + strings.IntToStr(DiagTicks) + " ticks")
    else:
        echo("verdict: caseA (probe wiring) FELL at tick " + strings.IntToStr(repA.fallTick))
    if repB.fallTick < 0:
        echo("verdict: caseB (film wiring) STOOD " + strings.IntToStr(DiagTicks) + " ticks - the reported divergence does NOT reproduce")
    else:
        echo("verdict: caseB (film wiring) FELL at tick " + strings.IntToStr(repB.fallTick))
    if repC.fallTick < 0:
        echo("verdict: caseC (modeB': film loop + 15L/14J assembly) STOOD " + strings.IntToStr(DiagTicks) + " ticks")
    else:
        echo("verdict: caseC (modeB') FELL at tick " + strings.IntToStr(repC.fallTick))
    if repD.fallTick < 0:
        echo("verdict: caseD (15L/14J, roll tau cut to 1 uNm) STOOD - stabilizer is the extra DoF structure, not the roll torque")
    else:
        echo("verdict: caseD (15L/14J, roll tau cut to 1 uNm) FELL at tick " + strings.IntToStr(repD.fallTick) + " - the parked roll servo torque is the stabilizer")
    let baseOk = repA.ok && repA.fallTick < 0 && repA.armedEnd == 1 && repA.driftMax < DriftLimitM && repA.rejected == 0
    let modeBok = repC.ok && repC.fallTick < 0 && repC.armedEnd == 1 && repC.driftMax < DriftLimitM && repC.rejected == 0
    if !baseOk:
        echo("FAIL duck wiring diag (baseline caseA not standing under the current engine)")
        return 1
    if !modeBok:
        echo("FAIL duck wiring diag (modeB' caseC under the 1500-tick contract)")
        return 1
    echo("root cause: the hip ASSEMBLY variant is the divergence owner (single-factor flip caseB->caseC moves survival); all other wiring items (tick granularity, injection window, balance path, release pose, ground, step tag) are parity-identical")
    echo("PASS duck wiring diag")
    return 0
