# tests for slots mutex + power rails + publish envelope + app_v0 flow
import "src/mosaico/frame.cheng" as frame
import "src/mosaico/slots.cheng" as slots
import "src/mosaico/power.cheng" as power
import "src/mosaico/publish.cheng" as pub
import "src/mosaico/events.cheng" as events
import "src/mosaico/app_v0.cheng" as app

fn CaseSlotScanPlan(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = slots.BuildSlotScanPlan(buf, n, slots.SlotLeft)
    if n != 3:
        return 1
    if frame.FrameGet8(buf, n, 0) != 14 or frame.FrameGet8(buf, n, 1) != 0:
        return 2
    if frame.FrameGet8(buf, n, 2) != 0x50:
        return 4
    var b2: uint8[frame.FrameCap]
    var n2 = 0
    n2 = slots.BuildSlotScanPlan(b2, n2, slots.SlotRight)
    if frame.FrameGet8(b2, n2, 0) != 39 or frame.FrameGet8(b2, n2, 1) != 1:
        return 8
    if frame.FrameGet8(b2, n2, 2) != 0x51:
        return 16
    return 0

fn CaseWhitelist(): int32 =
    if slots.ModuleAllowed(slots.SlotLeft, slots.ModuleIdIdentityTag) != 1:
        return 1
    if slots.ModuleAllowed(slots.SlotLeft, slots.ModuleIdLedBadge) != 1:
        return 2
    if slots.ModuleAllowed(slots.SlotRight, slots.ModuleIdUnknown) != 0:
        return 4
    if slots.ModuleAllowed(slots.SlotRight, slots.ModuleIdLedBadge) != 0:
        return 8
    return 0

fn CaseMutex(): int32 =
    var c = slots.ClaimsInit()
    c = slots.ClaimCodecI2s(c)
    if (c & slots.ResCodecI2s) == 0:
        return 1
    c = slots.ClaimRightAudioModule(c)
    if (c & slots.ResCodecI2s) != 0:
        return 2
    if (c & slots.ResRightAudioModule) == 0:
        return 4
    let rc = slots.ClaimCodecI2s(c)
    if rc != slots.MutexErrConflict:
        return 8
    c = slots.ClaimDvpCamera(c)
    if (c & slots.ResDvpCamera) == 0:
        return 16
    return 0

fn CasePowerRamp(): int32 =
    var st = power.RailInitState()
    var goodSeen = 0
    var i = 0
    while i < power.RampSteps + power.RailSettleTicks + 5:
        let r = power.RailStep(st)
        st = power.RailStateOf(r)
        goodSeen = goodSeen + power.RailGoodOf(r)
        i = i + 1
    if goodSeen < power.RailSettleTicks:
        return 1
    if (st & 3) != power.PwrPhaseOn:
        return 2
    if power.SystemRailLevelFor(power.PwrPhaseOn) != 0:
        return 4
    return 0

fn CaseEnvelopeCrc(): int32 =
    var buf: uint8[frame.FrameCap]
    var n = 0
    n = pub.BuildEnvelope(buf, n, events.EvShake, 305419896, 1234567, 0)
    if n != pub.EnvelopeBytes:
        return 1
    if buf[0] != pub.MagicC or buf[1] != pub.MagicH or buf[2] != pub.MagicN or buf[3] != pub.MagicG:
        return 2
    if buf[4] != pub.EnvelopeVersion or buf[5] != events.EvShake:
        return 4
    let stored = frame.FrameGet16Le(buf, n, 18) | (frame.FrameGet16Le(buf, n, 20) << 16)
    var crc = 0xFFFFFFFF
    var i = 0
    while i < pub.CrcOffsetInEnvelope:
        crc = pub.Crc32Add(crc, buf[i])
        i = i + 1
    crc = crc ^ 0xFFFFFFFF
    if stored != crc:
        return 8
    # known answer: CRC32 of ASCII "123456789" == 0xCBF43926
    var k = 0xFFFFFFFF
    k = pub.Crc32Add(k, 49)
    k = pub.Crc32Add(k, 50)
    k = pub.Crc32Add(k, 51)
    k = pub.Crc32Add(k, 52)
    k = pub.Crc32Add(k, 53)
    k = pub.Crc32Add(k, 54)
    k = pub.Crc32Add(k, 55)
    k = pub.Crc32Add(k, 56)
    k = pub.Crc32Add(k, 57)
    k = k ^ 0xFFFFFFFF
    if k != -873774606:
        return 16
    return 0

fn CaseAppFlow(): int32 =
    var fails = 0
    var st = app.InitState()

    var r = app.Step(st, events.EvTimerTick)
    if app.ActionsOf(r) != app.ActShowIdentityPrint:
        fails = fails | 1
    st = app.NextStateOf(r)

    r = app.Step(st, events.EvButtonDown)
    if (app.ActionsOf(r) & app.ActStartRecorder) == 0:
        fails = fails | 2
    st = app.NextStateOf(r)

    r = app.Step(st, events.EvButtonUp)
    if (app.ActionsOf(r) & app.ActStopRecorderKeep) == 0:
        fails = fails | 4
    st = app.NextStateOf(r)

    r = app.Step(st, events.EvButtonUp)
    if (app.ActionsOf(r) & app.ActSendToUniMaker) != 0:
        fails = fails | 8

    r = app.Step(st, events.EvTouchTap)
    if (app.ActionsOf(r) & app.ActSendToUniMaker) == 0:
        fails = fails | 16
    st = app.NextStateOf(r)
    if st != app.StPublishing:
        fails = fails | 32

    var s2 = app.InitState()
    r = app.Step(s2, events.EvButtonDown)
    s2 = app.NextStateOf(r)
    r = app.Step(s2, events.EvButtonUp)
    s2 = app.NextStateOf(r)
    r = app.Step(s2, events.EvShake)
    if (app.ActionsOf(r) & app.ActCancelRecording) == 0:
        fails = fails | 64
    if (app.ActionsOf(r) & app.ActSendToUniMaker) != 0:
        fails = fails | 128

    return fails

fn main(): int32 =
    var fails = 0
    fails = fails | ((CaseSlotScanPlan() & 0x3F) << 0)
    fails = fails | ((CaseWhitelist() & 0x1F) << 6)
    fails = fails | ((CaseMutex() & 0x3F) << 11)
    fails = fails | ((CasePowerRamp() & 0xF) << 17)
    fails = fails | ((CaseEnvelopeCrc() & 0xFF) << 21)
    return fails