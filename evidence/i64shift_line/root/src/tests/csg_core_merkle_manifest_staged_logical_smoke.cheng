import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_artifacts
import cheng/core/csg_core/merkle_builder
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_manifest
import cheng/core/csg_core/merkle_manifest_verifier

const
    Standard: str = "csg_core::v1"
    BaseProfile: str = "csg_core"
    SourceId: str = "source:manifest-staged-logical"

@borrows
fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn makeSource(
        schemaFact: str,
        symbolFact: str,
        sourceCid: str):
        merkle_builder.CsgCoreMerkleBuilderSource =
    var out: merkle_builder.CsgCoreMerkleBuilderSource
    out.sourceId = strings.CloneStr(SourceId)
    out.sourceCid = strings.CloneStr(sourceCid)
    out.facts = [
        strings.CloneStr(schemaFact),
        strings.CloneStr(symbolFact)
    ]
    return out

@borrows
fn object(
        kind: str,
        index: int32,
        cid: str,
        bytes: rawbytes.Bytes):
        merkle_manifest_verifier.CsgCoreMerkleManifestObject =
    var out: merkle_manifest_verifier.CsgCoreMerkleManifestObject
    out.kind = strings.CloneStr(kind)
    out.index = index
    out.cid = strings.CloneStr(cid)
    out.bytes = bytes
    return out

@borrows
fn closureObjects(
        closure: merkle_builder.CsgCoreMerkleBuilderResult,
        canonicalCsgc: rawbytes.Bytes):
        merkle_manifest_verifier.CsgCoreMerkleManifestObject[] =
    var out: merkle_manifest_verifier.CsgCoreMerkleManifestObject[]
    add(out, object(
        merkle_manifest_verifier.CsgCoreMerkleManifestCanonicalCsgcObjectKind(),
        0, closure.manifest.csgcObjectCid, canonicalCsgc))
    for i in 0..<closure.partitions.len:
        add(out, object(
            merkle_manifest_verifier.CsgCoreMerkleManifestPartitionFactsObjectKind(),
            i, closure.partitions[i].cid, closure.partitions[i].bytes))
    for i in 0..<closure.memberships.len:
        add(out, object(
            merkle_manifest_verifier.CsgCoreMerkleManifestMembershipObjectKind(),
            i, closure.memberships[i].cid, closure.memberships[i].bytes))
    for i in 0..<closure.nodeSegments.len:
        add(out, object(
            merkle_manifest_verifier.CsgCoreMerkleManifestNodeObjectKind(),
            i,
            merkle_dag.CsgCoreMerkleNodeRecordCid(
                closure.nodeSegments[i].nodes[0]),
            closure.nodeSegments[i].bytes))
    for i in 0..<closure.dependencyCargo.consumerShards.len:
        add(out, object(
            merkle_manifest_verifier.CsgCoreMerkleManifestDependencyConsumerObjectKind(),
            i,
            closure.dependencyCargo.consumerShards[i].cid,
            closure.dependencyCargo.consumerShards[i].bytes))
    for i in 0..<closure.dependencyCargo.providerShards.len:
        add(out, object(
            merkle_manifest_verifier.CsgCoreMerkleManifestDependencyProviderObjectKind(),
            i,
            closure.dependencyCargo.providerShards[i].cid,
            closure.dependencyCargo.providerShards[i].bytes))
    add(out, object(
        merkle_manifest_verifier.CsgCoreMerkleManifestSummaryObjectKind(),
        0, closure.summary.cid, closure.summary.bytes))
    for i in 0..<closure.queryCargo.shards.len:
        add(out, object(
            merkle_manifest_verifier.CsgCoreMerkleManifestQueryShardObjectKind(),
            i,
            closure.queryCargo.shards[i].cid,
            closure.queryCargo.shards[i].bytes))
    return out

@borrows
fn verify(
        manifestCid: str,
        manifestBytes: rawbytes.Bytes,
        objects:
            merkle_manifest_verifier.CsgCoreMerkleManifestObject[]):
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedResult =
    var state: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    if merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
           manifestCid,
           manifestBytes,
           merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
           state):
        for i in 0..<objects.len:
            if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
                   state,
                   objects[i].kind,
                   objects[i].index,
                   objects[i].cid,
                   objects[i].bytes):
                break
    return merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
        state)

@borrows
fn byteMutationRejected(
        manifestCid: str,
        manifestBytes: rawbytes.Bytes,
        objects:
            merkle_manifest_verifier.CsgCoreMerkleManifestObject[],
        targetKind: str): bool =
    var state: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
           manifestCid,
           manifestBytes,
           merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
           state):
        return false
    var mutated = false
    for i in 0..<objects.len:
        var accepted = false
        if !mutated && objects[i].kind == targetKind:
            var bytes = rawbytes.BytesSlice(
                objects[i].bytes, 0, rawbytes.BytesLen(objects[i].bytes))
            let last = rawbytes.BytesLen(bytes) - 1
            rawbytes.BytesSet(
                bytes, last, rawbytes.BytesGet(bytes, last) ^ 1)
            accepted =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
                    state,
                    objects[i].kind,
                    objects[i].index,
                    objects[i].cid,
                    bytes)
            rawbytes.BytesFree(bytes)
            mutated = true
        else:
            accepted =
                merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
                    state,
                    objects[i].kind,
                    objects[i].index,
                    objects[i].cid,
                    objects[i].bytes)
        if !accepted:
            break
    let result =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            state)
    return mutated && !result.ok

@borrows
fn identityMutationsRejected(
        manifestCid: str,
        manifestBytes: rawbytes.Bytes,
        objects:
            merkle_manifest_verifier.CsgCoreMerkleManifestObject[],
        targetKind: str): bool =
    var target: int32 = -1
    for i in 0..<objects.len:
        if objects[i].kind == targetKind:
            target = i
            break
    if target < 0:
        return false
    var indexState: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
           manifestCid, manifestBytes,
           merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
           indexState):
        return false
    for i in 0..<(target + 1):
        let index = i == target ? objects[i].index + 1 : objects[i].index
        if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
               indexState, objects[i].kind, index,
               objects[i].cid, objects[i].bytes):
            break
    let indexResult =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            indexState)
    var cidState: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
           manifestCid, manifestBytes,
           merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
           cidState):
        return false
    for i in 0..<(target + 1):
        let cid = i == target ? manifestCid : objects[i].cid
        if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
               cidState, objects[i].kind, objects[i].index,
               cid, objects[i].bytes):
            break
    let cidResult =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            cidState)
    return !indexResult.ok && !cidResult.ok

@borrows
fn countLimitMutationRejected(
        manifestCid: str,
        manifestBytes: rawbytes.Bytes,
        objectCount: int32): bool =
    var limits =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits()
    limits.maxObjectCount = objectCount - 1
    var state: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    let begun =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
            manifestCid, manifestBytes, limits, state)
    let result =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            state)
    return !begun && !result.ok &&
        result.error == "merkle_manifest_staged_object_count_limit"

@borrows
fn sequenceMutationsRejected(
        manifestCid: str,
        manifestBytes: rawbytes.Bytes,
        objects:
            merkle_manifest_verifier.CsgCoreMerkleManifestObject[]): bool =
    var missingState: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
           manifestCid, manifestBytes,
           merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
           missingState):
        return false
    for i in 0..<(objects.len - 1):
        if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
               missingState, objects[i].kind, objects[i].index,
               objects[i].cid, objects[i].bytes):
            break
    let missing =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            missingState)
    var reorderState: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    let reorderBegun =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
            manifestCid, manifestBytes,
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
            reorderState)
    let reordered = reorderBegun &&
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
            reorderState,
            objects[1].kind,
            objects[1].index,
            objects[1].cid,
            objects[1].bytes)
    let reorder =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            reorderState)
    var duplicateState: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    let duplicateBegun =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
            manifestCid, manifestBytes,
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
            duplicateState)
    var duplicated = false
    if duplicateBegun:
        duplicated =
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
                duplicateState,
                objects[0].kind,
                objects[0].index,
                objects[0].cid,
                objects[0].bytes) &&
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
                duplicateState,
                objects[0].kind,
                objects[0].index,
                objects[0].cid,
                objects[0].bytes)
    let duplicate =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            duplicateState)
    var extraState: merkle_manifest_verifier.CsgCoreMerkleManifestStagedState
    let extraBegun =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedBeginLogical(
            manifestCid, manifestBytes,
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedDefaultLimits(),
            extraState)
    var extraAccepted = extraBegun
    if extraBegun:
        for i in 0..<objects.len:
            if !merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
                   extraState,
                   objects[i].kind,
                   objects[i].index,
                   objects[i].cid,
                   objects[i].bytes):
                extraAccepted = false
                break
    if extraAccepted:
        extraAccepted =
            merkle_manifest_verifier.CsgCoreMerkleManifestStagedConsumeObject(
                extraState,
                objects[0].kind,
                objects[0].index,
                objects[0].cid,
                objects[0].bytes)
    let extra =
        merkle_manifest_verifier.CsgCoreMerkleManifestStagedFinalizeLogical(
            extraState)
    return !missing.ok && !reordered && !reorder.ok &&
        !duplicated && !duplicate.ok &&
        !extraAccepted && !extra.ok

@borrows
fn dependencyInverseMutationRejected(
        closure: merkle_builder.CsgCoreMerkleBuilderResult,
        canonicalCsgc: rawbytes.Bytes): bool =
    var decodedConsumer: merkle_artifacts.CsgCoreMerkleDependencyShardResult
    var forgedConsumer: merkle_artifacts.CsgCoreMerkleDependencyShardResult
    var decodedSummary: merkle_artifacts.CsgCoreMerkleSummaryResult
    var forgedSummary: merkle_artifacts.CsgCoreMerkleSummaryResult
    var forgedManifest: merkle_manifest.CsgCoreMerkleManifestEncodeResult
    var rejected = false
    if closure.dependencyCargo.consumerShards.len == 1 &&
       closure.dependencyCargo.providerShards.len == 1:
        decodedConsumer =
            merkle_artifacts.CsgCoreMerkleDependencyShardDecode(
                closure.dependencyCargo.consumerShards[0].bytes)
        if decodedConsumer.ok && decodedConsumer.records.len == 1:
            var changedRecord = decodedConsumer.records[0]
            changedRecord.selector = "symbol:inverse-mutation"
            forgedConsumer =
                merkle_artifacts.CsgCoreMerkleDependencyShardEncode(
                    decodedConsumer.header,
                    [changedRecord])
            var decodedManifest =
                merkle_manifest.CsgCoreMerkleManifestDecode(
                    closure.manifestArtifact.bytes)
            if forgedConsumer.ok && decodedManifest.ok &&
               decodedManifest.manifest.dependencyConsumerShards.len == 1:
                var descriptor: merkle_manifest.CsgCoreMerkleShardDescriptor
                descriptor.shardKey =
                    strings.CloneStr(forgedConsumer.header.shardKey)
                descriptor.cid = strings.CloneStr(forgedConsumer.cid)
                descriptor.root = strings.CloneStr(forgedConsumer.shardRoot)
                descriptor.entryCount = forgedConsumer.entryCount
                decodedManifest.manifest.dependencyConsumerShards =
                    [descriptor]
                decodedManifest.manifest.dependencyConsumerRoot =
                    merkle_manifest.CsgCoreMerkleShardDescriptorRoot(
                        merkle_manifest.CsgCoreMerkleDependencyConsumerShardKind(),
                        decodedManifest.manifest.dependencyConsumerShards)
                decodedSummary =
                    merkle_artifacts.CsgCoreMerkleSummaryDecode(
                        closure.summary.bytes)
                if decodedSummary.ok:
                    var summaryHeader = decodedSummary.header
                    summaryHeader.dependencyConsumerRoot =
                        strings.CloneStr(
                            decodedManifest.manifest.dependencyConsumerRoot)
                    forgedSummary =
                        merkle_artifacts.CsgCoreMerkleSummaryEncode(
                            summaryHeader)
                    if forgedSummary.ok:
                        decodedManifest.manifest.summaryCid =
                            strings.CloneStr(forgedSummary.cid)
                        forgedManifest =
                            merkle_manifest.CsgCoreMerkleManifestEncode(
                                decodedManifest.manifest)
                        if forgedManifest.ok:
                            var forgedObjects =
                                closureObjects(closure, canonicalCsgc)
                            var consumerReplaced = false
                            var summaryReplaced = false
                            for i in 0..<forgedObjects.len:
                                var forgedObject = forgedObjects[i]
                                if forgedObject.kind ==
                                   merkle_manifest_verifier.CsgCoreMerkleManifestDependencyConsumerObjectKind():
                                    forgedObject.cid =
                                        strings.CloneStr(
                                            forgedConsumer.cid)
                                    forgedObject.bytes =
                                        forgedConsumer.bytes
                                    consumerReplaced = true
                                elif forgedObject.kind ==
                                     merkle_manifest_verifier.CsgCoreMerkleManifestSummaryObjectKind():
                                    forgedObject.cid =
                                        strings.CloneStr(
                                            forgedSummary.cid)
                                    forgedObject.bytes =
                                        forgedSummary.bytes
                                    summaryReplaced = true
                                forgedObjects[i] = forgedObject
                            if consumerReplaced && summaryReplaced:
                                let result = verify(
                                    forgedManifest.cid,
                                    forgedManifest.bytes,
                                    forgedObjects)
                                rejected = !result.ok &&
                                    result.error ==
                                        "merkle_manifest_staged_dependency_inverse_mismatch"
                decodedManifest.lines = []
    rawbytes.BytesFree(decodedConsumer.bytes)
    rawbytes.BytesFree(forgedConsumer.bytes)
    rawbytes.BytesFree(decodedSummary.bytes)
    rawbytes.BytesFree(forgedSummary.bytes)
    rawbytes.BytesFree(forgedManifest.bytes)
    return rejected

fn main(): int32 =
    let schemaFact =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let symbolFact =
        "{\"file\":\"pkg://cheng/manifest/staged.cheng\",\"id\":\"symbol:staged\",\"kind\":\"csg.symbol\",\"name\":\"staged\",\"symbol\":\"staged\",\"symbolKind\":\"fn\"}"
    let sourceDag = merkle_dag.CsgCoreMerkleBuild([
        strings.CloneStr(schemaFact), strings.CloneStr(symbolFact)])
    let symbolDag = merkle_dag.CsgCoreMerkleBuild([
        strings.CloneStr(symbolFact)])
    if !sourceDag.ok || !symbolDag.ok:
        return fail("manifest staged DAG fixture failed")
    let source = makeSource(
        schemaFact, symbolFact, sourceDag.subgraphCid)
    var dependency: merkle_artifacts.CsgCoreMerkleDependencyRecord
    dependency.consumerSource = strings.CloneStr(SourceId)
    dependency.providerSource = strings.CloneStr(SourceId)
    dependency.selector = "symbol:staged"
    dependency.providerSubgraphCid =
        strings.CloneStr(symbolDag.subgraphCid)
    var closure = merkle_builder.CsgCoreMerkleBuildClosure(
        Standard, [BaseProfile], [source], [dependency])
    if !closure.ok || !closure.admission.ok:
        let message = strings.CloneStr(closure.error)
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
        return fail(strings.ConcatStr(
            "manifest staged closure fixture failed: ", message))
    var canonical = csgc.CsgCoreCsgcEncodeCanonicalLines([
        strings.CloneStr(schemaFact), strings.CloneStr(symbolFact)])
    if !canonical.ok:
        merkle_builder.CsgCoreMerkleBuilderFree(closure)
        return fail("manifest staged canonical CSGC failed")
    let objects = closureObjects(closure, canonical.bytes)
    let first = verify(
        closure.manifestArtifact.cid,
        closure.manifestArtifact.bytes,
        objects)
    let second = verify(
        closure.manifestArtifact.cid,
        closure.manifestArtifact.bytes,
        objects)
    var failure: str
    if !first.ok || !second.ok ||
       first.totalHeapBounded || second.totalHeapBounded ||
       first.productionReady || second.productionReady ||
       first.logicalClosureReceiptCid.len == 0 ||
       first.logicalClosureReceiptCid != second.logicalClosureReceiptCid:
        failure = "manifest staged logical receipt mismatch"
    let kinds = [
        merkle_manifest_verifier.CsgCoreMerkleManifestCanonicalCsgcObjectKind(),
        merkle_manifest_verifier.CsgCoreMerkleManifestPartitionFactsObjectKind(),
        merkle_manifest_verifier.CsgCoreMerkleManifestMembershipObjectKind(),
        merkle_manifest_verifier.CsgCoreMerkleManifestNodeObjectKind(),
        merkle_manifest_verifier.CsgCoreMerkleManifestDependencyConsumerObjectKind(),
        merkle_manifest_verifier.CsgCoreMerkleManifestDependencyProviderObjectKind(),
        merkle_manifest_verifier.CsgCoreMerkleManifestSummaryObjectKind(),
        merkle_manifest_verifier.CsgCoreMerkleManifestQueryShardObjectKind()
    ]
    for i in 0..<kinds.len:
        if failure.len == 0 &&
           (!byteMutationRejected(
                closure.manifestArtifact.cid,
                closure.manifestArtifact.bytes,
                objects,
                kinds[i]) ||
            !identityMutationsRejected(
                closure.manifestArtifact.cid,
                closure.manifestArtifact.bytes,
                objects,
                kinds[i])):
            failure = strings.ConcatStr(
                "manifest staged kind mutation escaped: ", kinds[i])
    if failure.len == 0 &&
       !countLimitMutationRejected(
           closure.manifestArtifact.cid,
           closure.manifestArtifact.bytes,
           objects.len):
        failure = "manifest staged count mutation escaped"
    if failure.len == 0 &&
       !sequenceMutationsRejected(
           closure.manifestArtifact.cid,
           closure.manifestArtifact.bytes,
           objects):
        failure = "manifest staged sequence mutation escaped"
    if failure.len == 0 &&
       !dependencyInverseMutationRejected(
           closure, canonical.bytes):
        failure = "manifest staged dependency inverse mutation escaped"
    rawbytes.BytesFree(canonical.bytes)
    merkle_builder.CsgCoreMerkleBuilderFree(closure)
    if failure.len > 0:
        return fail(failure)
    os.WriteLine(
        os.Get_stdout(),
        "PASS csg_core_merkle_manifest_staged_logical")
    return 0
