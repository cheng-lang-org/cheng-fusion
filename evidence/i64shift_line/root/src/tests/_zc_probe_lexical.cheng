import std/system
import std/strings
import cheng/core/lang/parser as parser

# str[] 元素读取即清空(managed move-out)：读后元素变空串, cur 值正确。
fn collectD(outO: var str[]): int32 =
    var newO: str[]
    add(newO, parser.ParserOwnedText("/d.cheng"))
    var scanPos: int32
    while scanPos < 1:
        let cur = newO[scanPos]
        scanPos = scanPos + 1
        echo("D cur=" + cur)
    outO = newO
    return 0

# i32[] 元素读取按值拷贝：读后元素应保持原值。
fn collectI(outI: var int32[]): int32 =
    var newI: int32[]
    add(newI, 7)
    var scanPos: int32
    while scanPos < 1:
        let cur = newI[scanPos]
        scanPos = scanPos + 1
        echo("I cur=" + strings.IntToStr(cur))
    outI = newI
    return 0

fn main(): int32 =
    var oD: str[]
    let rcD = collectD(oD)
    echo("D: O[0]=" + oD[0])
    var oI: int32[]
    let rcI = collectI(oI)
    echo("I: O[0]=" + strings.IntToStr(oI[0]))
    return rcD + rcI
