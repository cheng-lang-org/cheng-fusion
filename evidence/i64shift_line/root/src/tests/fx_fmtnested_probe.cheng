import cheng/tests/fx_fmtnested_mod as fxm
import std/strutils as strutil

fn fxAppendLine(out: var str, piece: str) =
    out = piece

fn main(): int32 =
    var report: str
    fxAppendLine(report, Fmt"a={strutil.ToUpperAscii(fxm.FxModDeepTag())} b={fxm.FxModBoolToInt(fxm.FxModFlag())}")
    if len(report) >= 10:
        return 0
    return 1
