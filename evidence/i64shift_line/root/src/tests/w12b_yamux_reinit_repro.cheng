import std/os
import std/rawbytes
import cheng/tests/w12b_helper_mod as helper

type
    Holder =
        active: bool
        blob: helper.BigBlob
        initiator: bool
        buf: rawbytes.Bytes

fn resetHolder(h: var Holder, blob: helper.BigBlob, dirInput: int32) =
    h.active = true
    h.blob = blob
    h.initiator = helper.DirectionOfBlob(blob) == helper.Outbound
    h.buf = rawbytes.EmptyBytes()

fn main(): int32 =
    var h: Holder
    var blob: helper.BigBlob
    blob.tag = 7
    resetHolder(h, blob, 5)
    assert(h.active, "w12b: active must be true")
    assert(h.blob.tag == 7, "w12b: blob copy must carry tag")
    assert(h.initiator, "w12b: initiator must be true when blob.tag>0")
    assert(h.buf.len == 0, "w12b: EmptyBytes() must yield len==0")
    var h2: Holder
    var blob2: helper.BigBlob
    blob2.tag = -3
    resetHolder(h2, blob2, -3)
    assert(!h2.initiator, "w12b: initiator must be false when blob2.tag<=0")
    os.WriteLine(os.Get_stdout(), "w12b_yamux_reinit_repro: PASS")
    return 0
