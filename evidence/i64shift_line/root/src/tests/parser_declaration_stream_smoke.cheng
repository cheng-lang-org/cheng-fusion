                   forest.declarationSourceLocalRows,
                   row + 6) == row,
               "parser declaration stream smoke: row-domain remap drift")
    echo("parser_declaration_forest_remap=1")

    var sourceLocalTamper = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        sourceLocalTamper.arena,
        sourceLocalTamper.declarationSourceLocalRows,
        1,
        0)
    assert(!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               sourceLocalTamper, err),
           "parser declaration stream smoke: source-local tamper survived")
    var ownerTamper = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        ownerTamper.arena, ownerTamper.declarationOwnerRows, 2, 2)
    assert(!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               ownerTamper, err),
           "parser declaration stream smoke: owner cycle survived")
    var scopeTamper = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        scopeTamper.arena,
        scopeTamper.declarationLexicalScopeParentRows,
        1,
        1)
    assert(!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               scopeTamper, err),
           "parser declaration stream smoke: lexical scope cycle survived")
    assert(tree.declarationLexicalScopeCount > 1 &&
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeSpanStarts,
               0) == 0 &&
           arenamod.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeSpanEnds,
               0) == DeclarationSource().len,
           "parser declaration stream smoke: source lexical span drift")
    var scopeSpanDeletion = parser.ParserValueExprTreeClone(tree)
    scopeSpanDeletion.declarationLexicalScopeSpanEnds.len =
        scopeSpanDeletion.declarationLexicalScopeCount - 1
    assert(!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               scopeSpanDeletion, err),
           "parser declaration stream smoke: lexical span deletion survived")
    var scopeSpanExchange = parser.ParserValueExprTreeClone(tree)
    let sourceScopeEnd = arenamod.ArenaArrayInt32Get(
        scopeSpanExchange.arena,
        scopeSpanExchange.declarationLexicalScopeSpanEnds,
        0)
    let nestedScopeEnd = arenamod.ArenaArrayInt32Get(
        scopeSpanExchange.arena,
        scopeSpanExchange.declarationLexicalScopeSpanEnds,
        1)
    arenamod.ArenaArrayInt32Set(
        scopeSpanExchange.arena,
        scopeSpanExchange.declarationLexicalScopeSpanEnds,
        0,
        nestedScopeEnd)
    arenamod.ArenaArrayInt32Set(
        scopeSpanExchange.arena,
        scopeSpanExchange.declarationLexicalScopeSpanEnds,
        1,
        sourceScopeEnd)
    assert(!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               scopeSpanExchange, err),
           "parser declaration stream smoke: lexical span exchange survived")
    var scopeSpanOutOfRange = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        scopeSpanOutOfRange.arena,
        scopeSpanOutOfRange.declarationLexicalScopeSpanEnds,
        1,
        DeclarationSource().len + 1)
    assert(!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               scopeSpanOutOfRange, err),
           "parser declaration stream smoke: lexical span range survived")
    echo("parser_declaration_lexical_scope_spans_exact=1")
    echo("parser_declaration_lexical_scope_span_mutations=1")
    var typeTamper = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        typeTamper.arena,
        typeTamper.declarationTypeSyntaxRootIndexes,
        2,
        -1)
    assert(!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               typeTamper, err),
           "parser declaration stream smoke: type root tamper survived")
    var spanTamper = parser.ParserValueExprTreeClone(tree)
    arenamod.ArenaArrayInt32Set(
        spanTamper.arena, spanTamper.declarationNameSpanStarts, 0, 0)
    assert(!parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               spanTamper, err),
           "parser declaration stream smoke: name span tamper survived")
    echo("parser_declaration_tree_tampers_rejected=1")

    var declarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               DeclarationSource(), declarations, err) &&
           declarations.len == 1,
           Fmt"parser declaration stream smoke: declaration read {err}")
    var identities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    add(identities,
        parser_receipt.ParserNormalizedExprFunctionIdentityMake(
            0, 0, "/workspace/sample.cheng", "Sample", "Run", 4, 6))
    var sidecar: parser_receipt.ParserCanonicalSourceSidecar
    assert(parser_receipt.ParserCanonicalSourceSidecarBuildFromSourceInto(
               0,
               DeclarationSource(),
               false,
               identities,
               declarations,
               sidecar,
               err),
           Fmt"parser declaration stream smoke: sidecar build {err}")
    assert(sidecar.declarationKinds.len == 6 &&
           sidecar.functionIndexes.len == 1 &&
           sidecar.declarationFunctionRows[3] == 0 &&
           sidecar.declarationFunctionRows[4] == 0 &&
           sidecar.declarationFunctionRows[5] == 0 &&
           parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               sidecar, err),
           Fmt"parser declaration stream smoke: sidecar strict {err}")
    var bindingDeclarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               BindingBlockSource(), bindingDeclarations, err) &&
           bindingDeclarations.len == 1,
           Fmt"parser declaration stream smoke: binding sidecar declarations {err}")
    var bindingIdentities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    add(bindingIdentities,
        parser_receipt.ParserNormalizedExprFunctionIdentityMake(
            0,
            0,
            "/workspace/binding_block.cheng",
            "binding_block",
            "Run",
            6,
            11))
    var bindingSidecar: parser_receipt.ParserCanonicalSourceSidecar
    assert(parser_receipt.ParserCanonicalSourceSidecarBuildFromSourceInto(
               0,
               BindingBlockSource(),
               false,
               bindingIdentities,
               bindingDeclarations,
               bindingSidecar,
               err) &&
           parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               bindingSidecar, err),
           Fmt"parser declaration stream smoke: binding sidecar strict {err}")
    var exactBindingNode: int32 = -1
    for nodeRow in 0..<bindingSidecar.nodeKinds.len:
        if bindingSidecar.nodeBindingResolutionKinds[nodeRow] ==
               Int32(parser.ParserValueExprBindingResolutionPattern):
            exactBindingNode = nodeRow
            break
    assert(exactBindingNode >= 0 &&
           bindingSidecar.nodeKinds[exactBindingNode] ==
               Int32(parser.ParserValueExprIdentifier) &&
           bindingSidecar.nodeBindingDeclarationSourceLocalRows[
               exactBindingNode] >= 0 &&
           bindingSidecar.nodeBindingPatternSourceLocalRows[
               exactBindingNode] >= 0,
           "parser declaration stream smoke: parser binding edge missing")
    var strippedBindingSidecar =
        parser_receipt.ParserCanonicalSourceSidecarClone(
            bindingSidecar)
    strippedBindingSidecar.nodeBindingResolutionKinds[exactBindingNode] =
        Int32(parser.ParserValueExprBindingResolutionNone)
    assert(!parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               strippedBindingSidecar, err),
           "parser declaration stream smoke: stripped parser binding survived")
    var nonIdentifierBindingSidecar =
        parser_receipt.ParserCanonicalSourceSidecarClone(
            bindingSidecar)
    nonIdentifierBindingSidecar.nodeKinds[exactBindingNode] =
        Int32(parser.ParserValueExprCall)
    assert(!parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               nonIdentifierBindingSidecar, err),
           "parser declaration stream smoke: non-Identifier binding survived")
    echo("parser_binding_initializer_sidecar_token_identity=1")
    var typeDefaultDeclarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               TypeDefaultSource(), typeDefaultDeclarations, err) &&
           typeDefaultDeclarations.len == 0,
           Fmt"parser declaration stream smoke: type default declarations {err}")
    var typeDefaultIdentities: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    var typeDefaultSidecar: parser_receipt.ParserCanonicalSourceSidecar
    assert(parser_receipt.ParserCanonicalSourceSidecarBuildFromSourceInto(
               0,
               TypeDefaultSource(),
               false,
               typeDefaultIdentities,
               typeDefaultDeclarations,
               typeDefaultSidecar,
               err) &&
           parser_receipt.ParserCanonicalSourceSidecarStrictValidateInto(
               typeDefaultSidecar, err),
           Fmt"parser declaration stream smoke: type default sidecar strict {err}")
    var typeDefaultSidecarRoot: int32 = -1
    for row in 0..<typeDefaultSidecar.statementRootRoles.len:
        if typeDefaultSidecar.statementRootRoles[row] ==
               Int32(parser.ParserValueExprStatementTypeDefault):
            typeDefaultSidecarRoot = row
            break
    assert(typeDefaultSidecarRoot >= 0 &&
           typeDefaultSidecar.statementRootBindingDeclarationCounts[
               typeDefaultSidecarRoot] == 1,
           "parser declaration stream smoke: type default sidecar authority missing")
    var typeDefaultSidecarTamper =
        parser_receipt.ParserCanonicalSourceSidecarClone(
            typeDefaultSidecar)
    typeDefaultSidecarTamper.statementRootBindingDeclarationCounts[
        typeDefaultSidecarRoot] = 0
    assert(!parser_receipt.ParserCanonicalSourceSidecarSealInto(
               typeDefaultSidecarTamper, err),
           "parser declaration stream smoke: type default sidecar tamper survived")
    echo("parser_type_default_sidecar_authority=1")
    var coherentTamper =
        parser_receipt.ParserCanonicalSourceSidecarClone(sidecar)
    coherentTamper.declarationSourceLocalRows[1] = 0
    assert(!parser_receipt.ParserCanonicalSourceSidecarSealInto(
               coherentTamper, err),
           "parser declaration stream smoke: coherent CID tamper survived")
    echo("parser_declaration_sidecar_coherent_cid_tamper_rejected=1")

    parser.ParserValueExprTreeRelease(tree)
    parser.ParserValueExprTreeRelease(first)
    parser.ParserValueExprTreeRelease(second)
    parser.ParserValueExprTreeRelease(forest)
    parser.ParserValueExprTreeRelease(sourceLocalTamper)
    parser.ParserValueExprTreeRelease(ownerTamper)
    parser.ParserValueExprTreeRelease(scopeTamper)
    parser.ParserValueExprTreeRelease(typeTamper)
    parser.ParserValueExprTreeRelease(spanTamper)
    parser.ParserValueExprTreeRelease(shadowTree)
    parser.ParserValueExprTreeRelease(globalTree)
    parser.ParserValueExprTreeRelease(typeDefaultTree)
    parser.ParserValueExprTreeRelease(typeDefaultTamper)
    parser.ParserValueExprTreeRelease(annotationTree)
    parser.ParserValueExprTreeRelease(inlineAnnotationTree)
    parser.ParserValueExprTreeRelease(annotationClone)
    parser.ParserValueExprTreeRelease(annotationTamper)
    parser.ParserValueExprTreeRelease(invalidAnnotationTree)
    parser.ParserValueExprTreeRelease(patternTree)
    parser.ParserValueExprTreeRelease(duplicateTree)
    parser.ParserValueExprTreeRelease(patternFirst)
    parser.ParserValueExprTreeRelease(patternSecond)
    parser.ParserValueExprTreeRelease(patternForest)
    parser.ParserValueExprTreeRelease(patternTamper)
    parser.ParserValueExprTreeRelease(uppercaseBindingTree)
    parser.ParserValueExprTreeRelease(uppercaseCoverageTamper)
    parser.NormalizedExprLayerReset(uppercaseLayer)
    echo("parser_declaration_stream_smoke: ok")

main()
