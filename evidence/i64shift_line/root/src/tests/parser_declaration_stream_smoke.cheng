import std/strings as strings
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/parser as parser
import cheng/core/tooling/compiler_parser_receipt as parser_receipt

fn DeclarationSource(): str =
    return "module Sample\ntype Record =\n    field: int32\nfn Run(value: int32): int32 =\n    var local: int32 = value\n    return local\n"

fn ShadowSource(): str =
    return "fn Run(value: int32): int32 =\n    var local: int32 = value\n    if value:\n        var local: int32 = value\n    return local\n"

fn GlobalSource(): str =
    return "module Bound\nvar global: int32\nfn Run(): int32 =\n    return global\n"

fn PatternSource(): str =
    return "fn Run(xs: int32[]): int32 =\n    var (left, {right, named: nested}) = xs\n    for (index, value) in xs:\n        match value:\n            of Some(value):\n                return value\n            of None:\n                return 2\n            of _:\n                return 0\n            of 1:\n                return 1\n    return left\n"

fn PatternAnnotationSource(): str =
    return "fn Run(): int32 =\n    let (left, right): tuple[int32, int32] = (1, 2)\n    let third: int32 = 3\n    return left + right + third\n"

fn CaseEntrySource(): str =
    return "fn Select(value: int32): int32 =\n    case value:\n        of Some(inner), value + 1 if value:\n            return inner\n        of _:\n            return 0\n    return 0\n"

fn MatchArmSource(): str =
    return "fn Select(value: int32): int32 =\n    match value:\n        Some(inner) => return inner\n        _ => return 0\n    return 0\n"

fn CaseExpressionSource(): str =
    return "fn Select(value: int32): int32 =\n    return case value: of Some(inner): inner else: 0\n"

fn DuplicateCasePatternSource(): str =
    return "fn Select(value: int32): int32 =\n    case value:\n        of (same, same):\n            return same\n    return 0\n"

fn UppercaseBindingSource(): str =
    return "fn Run(): int32 =\n    let Shared = 5\n    var Mutable = 6\n    const Fixed = 7\n    return Shared + Mutable + Fixed\n"

fn DuplicatePatternSource(): str =
    return "fn Run(xs: int32[]): int32 =\n    var (same, same) = xs\n    return same\n"

fn ReusedRoutineBindingSource(): str =
    return "fn First(value: int32): int32 =\n    var digest: int32 = value\n    return digest\n\nfn Second(value: int32): int32 =\n    var digest: int32 = value\n    return digest\n"

fn BindingBlockSource(): str =
    return "const\n    first: int32 = 1\n    second = 2\nvar\n    globalValue: int32\nfn Run(): int32 =\n    var\n        local: int32 = first\n        other = second\n    let _ = local\n    return local + other\n"

fn GroupedBindingSource(): str =
    return "fn Encode(prefix: int32, ones: int32): int32 =\n    let immsValue = prefix | (ones - 1)\n    return immsValue\n"

fn EmptyBindingBlockSource(): str =
    return "const\nfn Run(): int32 =\n    return 0\n"

fn MissingBindingPatternSource(): str =
    return "var = 1\n"

fn ContextualBlockFieldSource(): str =
    return "type Valid =\n    block: int32\nfn Read(value: Valid): int32 =\n    var block = value\n    block.block = 1\n    return block.block\n"

fn ContextualObjectValueSource(): str =
    return "fn Read(object: int32): int32 =\n    let copy = object\n    return copy\n"

fn TypeDefaultSource(): str =
    return "type Config =\n    retries: int32 = -1\n    enabled: bool = true\n"

fn ReservedKeywordFieldSource(): str =
    return "type Invalid =\n    return: int32\n"

fn MultilineTernarySource(): str =
    return "fn Choose(flag: bool): int32 =\n    let value = flag ?\n                1 :\n                2\n    return value\n"

fn SequentialLoopScopeSource(): str =
    return "fn Sum(xs: int32[]): int32 =\n    var total: int32\n    for i in 0..<xs.len:\n        let partPtr = xs[i]\n        total = total + partPtr\n    for i in 0..<xs.len:\n        let partPtr = xs[i]\n        total = total + partPtr\n    return total\n"

fn AnnotationSource(): str =
    return "@profile(\"fast\"; [true, 2,], {\"key\": 3, enabled = false})\n@ffi_map(ptr = arg0, len: arg1)\n@weak @exportc(\"Decorated\")\nfn Decorated(arg0: int32, arg1: int32): int32 =\n    return arg0 + arg1\n"

fn AnnotationScalarSource(): str =
    return "@meta(name, block, object, 42, \"text\", 'x', true)\nfn Scalars(): int32 = 0\n"

fn ParseTree(): parser.ParserValueExprTree =
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(
               DeclarationSource(), tree, err),
           Fmt"parser declaration stream smoke: parse failed {err}")
    assert(parser.ParserValueExprTreeDeclarationsStrictValidateInto(tree, err),
           Fmt"parser declaration stream smoke: strict failed {err}")
    return tree

fn CountKind(tree: parser.ParserValueExprTree,
             kind: parser.ParserDeclarationKind): int32 =
    var count: int32
    for row in 0..<tree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               tree.arena, tree.declarationKinds, row) == Int32(kind):
            count = count + 1
    return count

fn main() =
    var err: str
    var tree = ParseTree()
    assert(tree.declarationCount == 6 &&
           CountKind(tree, parser.ParserDeclarationModule) == 1 &&
           CountKind(tree, parser.ParserDeclarationType) == 1 &&
           CountKind(tree, parser.ParserDeclarationFunction) == 1 &&
           CountKind(tree, parser.ParserDeclarationField) == 1 &&
           CountKind(tree, parser.ParserDeclarationParameter) == 1 &&
           CountKind(tree, parser.ParserDeclarationLocal) == 1,
           "parser declaration stream smoke: six-kind cardinality drift")
    echo("parser_declaration_each_kind_exactly_one=1")
    var shadowTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               ShadowSource(), shadowTree, err),
           Fmt"parser declaration stream smoke: shadow parse {err}")
    assert(CountKind(shadowTree, parser.ParserDeclarationModule) == 0 &&
           CountKind(shadowTree, parser.ParserDeclarationLocal) == 2,
           "parser declaration stream smoke: implicit module was fabricated")
    var firstLocalScope: int32 = -1
    var secondLocalScope: int32 = -1
    for row in 0..<shadowTree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               shadowTree.arena,
               shadowTree.declarationKinds,
               row) == Int32(parser.ParserDeclarationLocal):
            if firstLocalScope < 0:
                firstLocalScope = arenamod.ArenaArrayInt32Get(
                    shadowTree.arena,
                    shadowTree.declarationLexicalScopeRows,
                    row)
            else:
                secondLocalScope = arenamod.ArenaArrayInt32Get(
                    shadowTree.arena,
                    shadowTree.declarationLexicalScopeRows,
                    row)
    assert(firstLocalScope >= 0 && secondLocalScope > firstLocalScope &&
           arenamod.ArenaArrayInt32Get(
               shadowTree.arena,
               shadowTree.declarationLexicalScopeParentRows,
               secondLocalScope) == firstLocalScope,
           "parser declaration stream smoke: nested shadow scope collapsed")
    echo("parser_declaration_nested_shadow_scope=1")
    var globalTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               GlobalSource(), globalTree, err),
           Fmt"parser declaration stream smoke: global parse {err}")
    var globalBindingRow: int32 = -1
    for row in 0..<globalTree.declarationCount:
        if arenamod.ArenaArrayInt32Get(
               globalTree.arena,
               globalTree.declarationKinds,
               row) == Int32(parser.ParserDeclarationLocal) &&
           arenamod.ArenaArrayInt32Get(
               globalTree.arena,
               globalTree.declarationFunctionRows,
               row) == -1:
            globalBindingRow = row
    assert(globalBindingRow >= 0 &&
           arenamod.ArenaArrayInt32Get(
               globalTree.arena,
               globalTree.declarationOwnerRows,
               globalBindingRow) == 0,
           "parser declaration stream smoke: module binding domain drift")
    echo("parser_declaration_module_binding_function_row_minus_one=1")
    var typeDefaultTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               TypeDefaultSource(), typeDefaultTree, err) &&
           parser.ParserValueExprTreeDeclarationsStrictValidateInto(
               typeDefaultTree, err) &&
           parser.ParserValueExprTreeStatementRootsStrictValidateInto(
               typeDefaultTree, err),
           Fmt"parser declaration stream smoke: type default parse {err}")
    var typeDefaultRoot: int32 = -1
    var typeDefaultCount: int32
    for rootIndex in 0..<typeDefaultTree.statementRootCount:
        if parser.ParserValueExprStatementRootRoleAt(
               typeDefaultTree, rootIndex) !=
               parser.ParserValueExprStatementTypeDefault:
            continue
        let declarationStart =
            parser.ParserValueExprStatementRootBindingDeclarationStartAt(
                typeDefaultTree, rootIndex)
        assert(declarationStart >= 0 &&
               parser.ParserValueExprStatementRootBindingDeclarationCountAt(
                   typeDefaultTree, rootIndex) == 1 &&
               arenamod.ArenaArrayInt32Get(
                   typeDefaultTree.arena,
                   typeDefaultTree.declarationKinds,
                   declarationStart) ==
                   Int32(parser.ParserDeclarationField) &&
               parser.ParserValueExprStatementRootIsNonFunctionDeclarationValue(
                   typeDefaultTree, rootIndex),
               "parser declaration stream smoke: type default declaration authority missing")
        if typeDefaultRoot < 0:
            typeDefaultRoot = rootIndex
        typeDefaultCount = typeDefaultCount + 1
    assert(typeDefaultCount == 2 && typeDefaultRoot >= 0,
           Fmt"parser declaration stream smoke: type default root cardinality drift count={typeDefaultCount} roots={typeDefaultTree.statementRootCount}")
    var typeDefaultTamper =
        parser.ParserValueExprTreeClone(typeDefaultTree)
    arenamod.ArenaArrayInt32Set(
        typeDefaultTamper.arena,
        typeDefaultTamper.statementRootBindingDeclarationCounts,
        typeDefaultRoot,
        0)
    assert(!parser.ParserValueExprTreeStatementRootsStrictValidateInto(
               typeDefaultTamper, err),
           "parser declaration stream smoke: type default declaration tamper survived")
    echo("parser_type_default_declaration_authority=1")
    echo("parser_type_default_declaration_tamper_rejected=1")
    var annotationTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               AnnotationSource(), annotationTree, err) &&
           parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               annotationTree, err),
           Fmt"parser declaration stream smoke: annotation parse {err}")
    assert(annotationTree.annotationCount == 4 &&
           annotationTree.annotationArgRootCount == 6 &&
           annotationTree.annotationArgCount == 18 &&
           annotationTree.annotationArgChildCount == 12,
           "parser declaration stream smoke: annotation graph cardinality drift")
    let firstAnnotationTarget = arenamod.ArenaArrayInt32Get(
        annotationTree.arena,
        annotationTree.annotationTargetTokenIndexes,
        0)
    assert(firstAnnotationTarget >= 0 &&
           parser.ParserValueExprTokenKindAt(
               annotationTree,
               firstAnnotationTarget) == parser.ParserValueTokenFn,
           "parser declaration stream smoke: annotation target identity drift")
    for annotationRow in 1..<annotationTree.annotationCount:
        assert(firstAnnotationTarget == arenamod.ArenaArrayInt32Get(
                   annotationTree.arena,
                   annotationTree.annotationTargetTokenIndexes,
                   annotationRow),
               "parser declaration stream smoke: annotation chain target split")
    var inlineAnnotationTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               "@inline fn Inline(): int32 = 1\n",
               inlineAnnotationTree,
               err) &&
           inlineAnnotationTree.annotationCount == 1 &&
           CountKind(
               inlineAnnotationTree,
               parser.ParserDeclarationFunction) == 1 &&
           parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               inlineAnnotationTree,
               err),
           Fmt"parser declaration stream smoke: inline annotation target {err}")
    var annotationClone =
        parser.ParserValueExprTreeClone(annotationTree)
    assert(parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               annotationClone, err) &&
           annotationClone.annotationArgCount ==
               annotationTree.annotationArgCount,
           Fmt"parser declaration stream smoke: annotation clone {err}")
    var annotationTamper =
        parser.ParserValueExprTreeClone(annotationTree)
    arenamod.ArenaArrayInt32Set(
        annotationTamper.arena,
        annotationTamper.annotationTargetTokenIndexes,
        0,
        -1)
    assert(!parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               annotationTamper, err),
           "parser declaration stream smoke: annotation target tamper survived")
    var invalidAnnotationTree: parser.ParserValueExprTree
    assert(!parser.ParserValueExprReadTreeFromText(
               "@profile(1,)\nfn Run(): int32 = 0\n",
               invalidAnnotationTree,
               err),
           "parser declaration stream smoke: top-level trailing annotation separator survived")
    assert(!parser.ParserValueExprReadTreeFromText(
               "@profile({1})\nfn Run(): int32 = 0\n",
               invalidAnnotationTree,
               err),
           "parser declaration stream smoke: non-entry dictionary child survived")
    assert(!parser.ParserValueExprReadTreeFromText(
               "@profile\n",
               invalidAnnotationTree,
               err),
           "parser declaration stream smoke: dangling annotation survived")
    var emptyNestedAnnotationTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               "@meta() @nested([], {}, ['x',], {\"key\": true, enabled = false,})\nfn EmptyNested(): int32 = 0\n",
               emptyNestedAnnotationTree,
               err) &&
           emptyNestedAnnotationTree.annotationCount == 2 &&
           parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               emptyNestedAnnotationTree,
               err),
           Fmt"parser declaration stream smoke: empty/nested annotation parse {err}")
    var sawCharacterArg = false
    var separatorNode: int32 = -1
    for argRow in 0..<emptyNestedAnnotationTree.annotationArgCount:
        let argKind = parser.ParserAnnotationArgKind(
            arenamod.ArenaArrayInt32Get(
                emptyNestedAnnotationTree.arena,
                emptyNestedAnnotationTree.annotationArgKinds,
                argRow))
        if argKind == parser.ParserAnnotationArgCharacter:
            sawCharacterArg = true
        if argKind == parser.ParserAnnotationArgKeyValue &&
           separatorNode < 0:
            separatorNode = argRow
    assert(sawCharacterArg && separatorNode >= 0,
           "parser declaration stream smoke: annotation scalar/entry coverage missing")
    var separatorTamper =
        parser.ParserValueExprTreeClone(emptyNestedAnnotationTree)
    arenamod.ArenaArrayInt32Set(
        separatorTamper.arena,
        separatorTamper.annotationArgSeparatorTokenIndexes,
        separatorNode,
        -1)
    assert(!parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               separatorTamper, err) &&
           strings.StrContains(err, "key/value shape invalid"),
           "parser declaration stream smoke: annotation separator tamper survived")
    assert(!parser.ParserValueExprReadTreeFromText(
               "@meta([1; 2])\nfn Invalid(): int32 = 0\n",
               invalidAnnotationTree,
               err),
           "parser declaration stream smoke: list semicolon survived")
    assert(!parser.ParserValueExprReadTreeFromText(
               "@meta([1,,])\nfn Invalid(): int32 = 0\n",
               invalidAnnotationTree,
               err),
           "parser declaration stream smoke: double trailing comma survived")
    assert(!parser.ParserValueExprReadTreeFromText(
               "@meta({'x': 1})\nfn Invalid(): int32 = 0\n",
               invalidAnnotationTree,
               err),
           "parser declaration stream smoke: character dictionary key survived")
    var scalarAnnotationTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               AnnotationScalarSource(),
               scalarAnnotationTree,
               err) &&
           parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               scalarAnnotationTree,
               err) &&
           scalarAnnotationTree.annotationCount == 1 &&
           scalarAnnotationTree.annotationArgCount == 7 &&
           scalarAnnotationTree.annotationArgRootCount == 7 &&
           scalarAnnotationTree.annotationArgChildCount == 0,
           Fmt"parser declaration stream smoke: annotation scalar parse {err}")
    var scalarKindsSeen: bool[]
    setLen(
        scalarKindsSeen,
        Int32(parser.ParserAnnotationArgKeyValue) + 1)
    var scalarStringRow: int32 = -1
    var scalarStringToken: int32 = -1
    for row in 0..<scalarAnnotationTree.annotationArgCount:
        let scalarKind = parser.ParserAnnotationArgKind(
            arenamod.ArenaArrayInt32Get(
                scalarAnnotationTree.arena,
                scalarAnnotationTree.annotationArgKinds,
                row))
        let scalarToken = arenamod.ArenaArrayInt32Get(
            scalarAnnotationTree.arena,
            scalarAnnotationTree.annotationArgTokenIndexes,
            row)
        scalarKindsSeen[Int32(scalarKind)] = true
        assert(parser.ParserAnnotationArgScalarTokenKindMatches(
                   scalarKind,
                   parser.ParserValueExprTokenKindAt(
                       scalarAnnotationTree, scalarToken)) &&
               arenamod.ArenaArrayInt32Get(
                   scalarAnnotationTree.arena,
                   scalarAnnotationTree.annotationArgOwnerRows,
                   row) == 0 &&
               arenamod.ArenaArrayInt32Get(
                   scalarAnnotationTree.arena,
                   scalarAnnotationTree.annotationArgSpanStarts,
                   row) ==
                   parser.ParserValueExprTokenStartAt(
                       scalarAnnotationTree, scalarToken) &&
               arenamod.ArenaArrayInt32Get(
                   scalarAnnotationTree.arena,
                   scalarAnnotationTree.annotationArgSpanEnds,
                   row) ==
                   parser.ParserValueExprTokenEndAt(
                       scalarAnnotationTree, scalarToken),
               "parser declaration stream smoke: annotation scalar identity drift")
        if scalarKind == parser.ParserAnnotationArgString:
            scalarStringRow = row
            scalarStringToken = scalarToken
    for scalarKind in Int32(parser.ParserAnnotationArgIdentifier)..
            Int32(parser.ParserAnnotationArgBoolean):
        assert(scalarKindsSeen[scalarKind],
               "parser declaration stream smoke: annotation scalar family missing")
    assert(scalarStringRow >= 0 && scalarStringToken >= 0,
           "parser declaration stream smoke: annotation string row missing")
    var scalarKindTamper =
        parser.ParserValueExprTreeClone(scalarAnnotationTree)
    arenamod.ArenaArrayInt32Set(
        scalarKindTamper.arena,
        scalarKindTamper.annotationArgKinds,
        scalarStringRow,
        Int32(parser.ParserAnnotationArgNumber))
    assert(!parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               scalarKindTamper,
               err) &&
           strings.StrContains(err, "scalar token identity invalid"),
           "parser declaration stream smoke: annotation scalar kind tamper survived")
    var scalarSpanTamper =
        parser.ParserValueExprTreeClone(scalarAnnotationTree)
    let scalarSpanEnd = arenamod.ArenaArrayInt32Get(
        scalarSpanTamper.arena,
        scalarSpanTamper.annotationArgSpanEnds,
        scalarStringRow)
    arenamod.ArenaArrayInt32Set(
        scalarSpanTamper.arena,
        scalarSpanTamper.annotationArgSpanEnds,
        scalarStringRow,
        scalarSpanEnd + 1)
    assert(!parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               scalarSpanTamper,
               err) &&
           strings.StrContains(err, "scalar token identity invalid"),
           "parser declaration stream smoke: annotation scalar span tamper survived")
    var scalarSourceTamper =
        parser.ParserValueExprTreeClone(scalarAnnotationTree)
    let scalarSourceId = parser.ParserValueExprTokenSourceIdAt(
        scalarSourceTamper, scalarStringToken)
    arenamod.ArenaArrayInt32Set(
        scalarSourceTamper.arena,
        scalarSourceTamper.tokenSourceTextIds,
        scalarStringToken,
        scalarSourceId + 1)
    assert(!parser.ParserValueExprTreeAnnotationsStrictValidateInto(
               scalarSourceTamper,
               err) &&
           strings.StrContains(err, "scalar token identity invalid"),
           "parser declaration stream smoke: annotation scalar source tamper survived")
    echo("parser_annotation_scalar_identity=1")
    echo("parser_annotation_scalar_mutations_rejected=1")
    echo("parser_annotation_scalar_token_source_span_mutations=1")
    var annotationDeclarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               AnnotationSource(),
               annotationDeclarations,
               err) &&
           annotationDeclarations.len == 1 &&
           annotationDeclarations[0].explicitExportName == "Decorated" &&
           annotationDeclarations[0].ffiMapPtrArg == 0 &&
           annotationDeclarations[0].ffiMapLenArg == 1 &&
           annotationDeclarations[0].weak &&
           parser.ParserNormalizedFunctionAnnotationFlags(
               annotationDeclarations[0]) ==
               parser.ParserFunctionAnnotationWeak,
           Fmt"parser declaration stream smoke: structured annotation consumer {err}")
    var invalidAnnotationDeclarations: parser.NormalizedFunctionDecl[]
    assert(!parser.ParserReadNormalizedFunctionDecls(
               "@ffi_map(ptr = arg0)\nfn Invalid(value: int32): int32 = value\n",
               invalidAnnotationDeclarations,
               err),
           "parser declaration stream smoke: malformed known annotation survived")
    assert(!parser.ParserReadNormalizedFunctionDecls(
               "@not_registered([1, {key: true}])\nfn Invalid(): int32 = 0\n",
               invalidAnnotationDeclarations,
               err) &&
           strings.StrContains(err, "unregistered @not_registered"),
           "parser declaration stream smoke: unregistered annotation survived admission")
    assert(!parser.ParserReadNormalizedFunctionDecls(
               "@weak(1)\nfn Invalid(): int32 = 0\n",
               invalidAnnotationDeclarations,
               err) &&
           strings.StrContains(err, "invalid @weak"),
           "parser declaration stream smoke: weak payload survived admission")
    assert(!parser.ParserReadNormalizedFunctionDecls(
               "@weak @weak\nfn Invalid(): int32 = 0\n",
               invalidAnnotationDeclarations,
               err) &&
           strings.StrContains(err, "invalid @weak"),
           "parser declaration stream smoke: duplicate weak survived admission")
    var markerDeclarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               "@borrows\nfn Borrowing(value: var int32): int32 = value\n@escapes\nfn Escaping(value: var int32): int32 = value\n@trusted_abi\n@no_alloc\n@interrupt_handler\n@keep_export_binding\nfn DriverMarker(): int32 = 0\n",
               markerDeclarations,
               err) &&
           markerDeclarations.len == 3 &&
           markerDeclarations[0].borrows &&
           !markerDeclarations[0].escapes &&
           markerDeclarations[1].escapes &&
           !markerDeclarations[1].borrows &&
           markerDeclarations[2].trustedAbi &&
           markerDeclarations[2].noAlloc &&
           markerDeclarations[2].interruptHandler &&
           markerDeclarations[2].keepExportBinding &&
           parser.ParserNormalizedFunctionAnnotationFlags(
               markerDeclarations[0]) ==
               parser.ParserFunctionAnnotationBorrows &&
           parser.ParserNormalizedFunctionAnnotationFlags(
               markerDeclarations[1]) ==
               parser.ParserFunctionAnnotationEscapes &&
           parser.ParserNormalizedFunctionAnnotationFlags(
               markerDeclarations[2]) ==
               (parser.ParserFunctionAnnotationTrustedAbi |
                parser.ParserFunctionAnnotationNoAlloc |
                parser.ParserFunctionAnnotationInterruptHandler |
                parser.ParserFunctionAnnotationKeepExportBinding) &&
           parser.ParserNormalizedFunctionAnnotationFlagsValid(
               parser.ParserNormalizedFunctionAnnotationFlags(
                   markerDeclarations[2])) &&
           !parser.ParserNormalizedFunctionAnnotationFlagsValid(
               parser.ParserFunctionAnnotationBorrows |
               parser.ParserFunctionAnnotationEscapes) &&
           !parser.ParserNormalizedFunctionAnnotationFlagsValid(256),
           Fmt"parser declaration stream smoke: fixed marker projection {err}")
    assert(!parser.ParserReadNormalizedFunctionDecls(
               "@borrows @escapes\nfn Invalid(value: var int32): int32 = value\n",
               invalidAnnotationDeclarations,
               err),
           "parser declaration stream smoke: contradictory borrow contract survived")
    assert(!parser.ParserReadNormalizedFunctionDecls(
               "@weak\ntype Invalid = int32\n",
               invalidAnnotationDeclarations,
               err) &&
           strings.StrContains(err, "function target missing for @weak"),
           "parser declaration stream smoke: weak non-function target survived")
    var annotationStringForgeryDeclarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               "@exportc(\"@weak @profile @keep_export_binding @trusted_abi @no_alloc @interrupt_handler @borrows @escapes\")\nfn StringCarrier(): int32 = 0\n",
               annotationStringForgeryDeclarations,
               err) &&
           annotationStringForgeryDeclarations.len == 1 &&
           parser.ParserNormalizedFunctionAnnotationFlags(
               annotationStringForgeryDeclarations[0]) == 0,
           "parser declaration stream smoke: annotation string forged function flags")
    var generalTargetDeclarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               "@profile(\"type_only\"; [true, 2], {mode: fast})\ntype Profiled = int32\n",
               generalTargetDeclarations,
               err) &&
           generalTargetDeclarations.len == 0,
           Fmt"parser declaration stream smoke: general annotation target narrowed {err}")
    echo("parser_annotation_recursive_soa=1")
    echo("parser_annotation_empty_nested_trailing=1")
    echo("parser_annotation_separator_mutation=1")
    echo("parser_annotation_chain_and_inline_target=1")
    echo("parser_annotation_structured_known_consumer=1")
    echo("parser_annotation_fixed_markers_structured=1")
    echo("parser_function_annotation_string_forgery_rejected=1")
    echo("parser_annotation_unregistered_hard_fail=1")
    echo("parser_annotation_target_and_tamper=1")
    var patternTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               PatternSource(), patternTree, err) &&
           parser.ParserValueExprTreePatternsStrictValidateInto(
               patternTree, err),
           Fmt"parser declaration stream smoke: pattern parse {err}")
    var patternBindingCount: int32
    var wildcardCount: int32
    var literalCount: int32
    var constructorCount: int32
    var outerValueScope: int32 = -1
    var innerValueScope: int32 = -1
    for row in 0..<patternTree.patternCount:
        let kind = arenamod.ArenaArrayInt32Get(
            patternTree.arena, patternTree.patternKinds, row)
        if kind == Int32(parser.ParserPatternBinding):
            patternBindingCount = patternBindingCount + 1
            let nameToken = arenamod.ArenaArrayInt32Get(
                patternTree.arena,
                patternTree.patternNameTokenIndexes,
                row)
            if parser.ParserValueExprTokenText(patternTree, nameToken) ==
                   "value":
                let scope = arenamod.ArenaArrayInt32Get(
                    patternTree.arena,
                    patternTree.patternOwnerLexicalScopeRows,
                    row)
                if outerValueScope < 0:
                    outerValueScope = scope
                else:
                    innerValueScope = scope
        elif kind == Int32(parser.ParserPatternWildcard):
            wildcardCount = wildcardCount + 1
        elif kind == Int32(parser.ParserPatternLiteral):
            literalCount = literalCount + 1
        elif kind == Int32(parser.ParserPatternConstructor):
            constructorCount = constructorCount + 1
    assert(patternBindingCount == 6 && wildcardCount == 1 &&
           literalCount == 2 && constructorCount == 1 &&
           CountKind(patternTree, parser.ParserDeclarationLocal) == 6 &&
           outerValueScope >= 0 && innerValueScope > outerValueScope,
           "parser declaration stream smoke: pattern binding cardinality drift")
    echo("parser_match_variant_constructor_context_preserved=1")
    var caseEntryTree: parser.ParserValueExprTree
    assert(parser.ParserValueExprReadTreeFromText(
               CaseEntrySource(), caseEntryTree, err) &&
           parser.ParserValueExprTreePatternsStrictValidateInto(
               caseEntryTree, err) &&
