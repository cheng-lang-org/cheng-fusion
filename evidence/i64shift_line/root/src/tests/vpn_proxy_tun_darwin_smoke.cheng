import std/strutils as strutil
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn

fn main(): int32 =
    let command: str = vpn.VpnProxyTunDarwinConfigureCommand("utun9",
                                                             "198.18.0.2",
                                                             1400,
                                                             "203.0.113.10")
    assert(strutil.Contains(command, "ifconfig"), " tun darwin command ifconfig")
    assert(strutil.Contains(command, "utun9"), " tun darwin command ifname")
    assert(strutil.Contains(command, "198.18.0.2"), " tun darwin command address")
    assert(strutil.Contains(command, "mtu 1400"), " tun darwin command mtu")
    assert(strutil.Contains(command, "route -n add -host"), " tun darwin command host route")
    assert(strutil.Contains(command, "203.0.113.10"), " tun darwin command exit host")
    assert(strutil.Contains(command, "0.0.0.0/1"), " tun darwin command first split route")
    assert(strutil.Contains(command, "128.0.0.0/1"), " tun darwin command second split route")

    let cleanup: str = vpn.VpnProxyTunDarwinCleanupCommand("utun9")
    assert(strutil.Contains(cleanup, "route -n delete -net 0.0.0.0/1"),
           " tun darwin cleanup first split route")
    assert(strutil.Contains(cleanup, "route -n delete -net 128.0.0.0/1"),
           " tun darwin cleanup second split route")
    assert(strutil.Contains(cleanup, "ifconfig 'utun9' down"),
           " tun darwin cleanup ifconfig down")

    echo(" vpn_proxy_tun_darwin_smoke ok")
    return 0
