type
    PlainBranchValue =
        id: int32
        opStart: int32
        opCount: int32
        termIndex: int32

fn main(): int32 =
    var values: PlainBranchValue[]
    for index in 0..<2:
        var value: PlainBranchValue
        value.id = index
        value.opStart = index + 10
        if index == 0:
            value.opCount = 20
            add(values, value)
            continue
        value.opCount = 30
        add(values, value)

    if values.len != 2: return 1
    if values[0].id != 0: return 2
    if values[0].opStart != 10: return 3
    if values[0].opCount != 20: return 4
    if values[1].id != 1: return 5
    if values[1].opStart != 11: return 6
    if values[1].opCount != 30: return 7
    return 0
