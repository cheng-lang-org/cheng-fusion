import std/system
import std/rawmem_support as rawmem_support

const
    probeHandleSlotMod: uint64 = 4294967296

@importc("cheng_ffi_raw_new_i32")
fn cheng_ffi_raw_new_i32(value: int32): ptr

@importc("cheng_ffi_raw_get_i32")
fn cheng_ffi_raw_get_i32(p: ptr): int32

@importc("cheng_ffi_raw_release_i32")
fn cheng_ffi_raw_release_i32(p: ptr): int32

@importc("cheng_malloc")
fn cheng_malloc(size: int32): ptr

@importc("cheng_tcp_buffer_handle_register_bridge")
fn cheng_tcp_buffer_handle_register_bridge(raw: ptr): uint64

@importc("cheng_tcp_buffer_handle_lease_acquire_bridge")
fn cheng_tcp_buffer_handle_lease_acquire_bridge(
    handle: uint64,
    outPayload: ptr,
    outBorrowGeneration: ptr): int32

@importc("cheng_tcp_buffer_handle_lease_release_bridge")
fn cheng_tcp_buffer_handle_lease_release_bridge(
    handle: uint64,
    borrowGeneration: uint64): int32

@importc("cheng_tcp_buffer_handle_retire_take_bridge")
fn cheng_tcp_buffer_handle_retire_take_bridge(
    handle: uint64,
    outPayload: ptr): int32

@importc("cheng_tcp_buffer_handle_release_raw_bridge")
fn cheng_tcp_buffer_handle_release_raw_bridge(handle: uint64): int32

fn handleSlot(handle: uint64): uint64 =
    return handle % probeHandleSlotMod

fn handleGeneration(handle: uint64): uint64 =
    return handle / probeHandleSlotMod

fn main(): int32 =
    let allocBefore: int64 = memAllocCount()
    let freeBefore: int64 = memFreeCount()
    let liveBefore: int64 = memLiveCount()

    let raw0: ptr = cheng_ffi_raw_new_i32(40)
    assert(raw0 != nil, " ffi handle generation reuse: raw0 alloc")
    let handle0: uint64 = cheng_tcp_buffer_handle_register_bridge(raw0)
    assert(handle0 != uint64(0), " ffi handle generation reuse: handle0 create")
    assert(cheng_tcp_buffer_handle_register_bridge(raw0) == uint64(0),
           " ffi handle generation reuse: duplicate payload rejected")
    var aliasedOutput: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               handle0, &aliasedOutput, &aliasedOutput) == -1,
           " ffi handle generation reuse: overlapping outputs rejected")
    let outputStorage: ptr = cheng_malloc(32)
    assert(outputStorage != nil,
           " ffi handle generation reuse: misaligned output storage")
    let misalignedPayload = rawmem_support.RawmemPtrAdd(outputStorage, 1)
    let alignedGeneration = rawmem_support.RawmemPtrAdd(outputStorage, 16)
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               handle0, misalignedPayload, alignedGeneration) == -1,
           " ffi handle generation reuse: misaligned output rejected")
    memReleaseAtomic(outputStorage)
    var resolved0: ptr
    var borrowGeneration0: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               handle0, &resolved0, &borrowGeneration0) == 0,
           " ffi handle generation reuse: handle0 lease acquire")
    assert(resolved0 == raw0, " ffi handle generation reuse: handle0 resolve")
    assert(borrowGeneration0 != uint64(0),
           " ffi handle generation reuse: handle0 borrow generation")
    assert(cheng_ffi_raw_get_i32(resolved0) == 40, " ffi handle generation reuse: handle0 value")
    var busyResolved: ptr
    var busyBorrowGeneration: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               handle0, &busyResolved, &busyBorrowGeneration) == -2,
           " ffi handle generation reuse: second lease busy")
    assert(busyResolved == nil && busyBorrowGeneration == uint64(0),
           " ffi handle generation reuse: busy lease has no payload")
    var busyRetired: ptr
    assert(cheng_tcp_buffer_handle_retire_take_bridge(
               handle0, &busyRetired) == -2,
           " ffi handle generation reuse: retire while leased busy")
    assert(busyRetired == nil,
           " ffi handle generation reuse: busy retire has no payload")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               handle0, borrowGeneration0 + uint64(1)) == -1,
           " ffi handle generation reuse: wrong borrow generation rejected")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               handle0, borrowGeneration0) == 0,
           " ffi handle generation reuse: handle0 lease release")
    let slot0: uint64 = handleSlot(handle0)
    let generation0: uint64 = handleGeneration(handle0)
    assert(slot0 != uint64(0), " ffi handle generation reuse: handle0 slot")
    assert(generation0 != uint64(0), " ffi handle generation reuse: handle0 generation")

    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               handle0, borrowGeneration0) == -1,
           " ffi handle generation reuse: double lease release rejected")
    var retired0: ptr
    assert(cheng_tcp_buffer_handle_retire_take_bridge(handle0, &retired0) == 0,
           " ffi handle generation reuse: handle0 retire take")
    assert(retired0 == raw0,
           " ffi handle generation reuse: handle0 retire payload")
    assert(cheng_ffi_raw_release_i32(retired0) == 0,
           " ffi handle generation reuse: handle0 payload release")

    let raw1: ptr = cheng_ffi_raw_new_i32(7)
    assert(raw1 != nil, " ffi handle generation reuse: raw1 alloc")
    let handle1: uint64 = cheng_tcp_buffer_handle_register_bridge(raw1)
    assert(handle1 != uint64(0), " ffi handle generation reuse: handle1 create")
    assert(handle1 != handle0, " ffi handle generation reuse: handle changes after release")
    var resolved1: ptr
    var borrowGeneration1: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               handle1, &resolved1, &borrowGeneration1) == 0,
           " ffi handle generation reuse: handle1 lease acquire")
    assert(resolved1 == raw1, " ffi handle generation reuse: handle1 resolve")
    assert(cheng_ffi_raw_get_i32(resolved1) == 7, " ffi handle generation reuse: handle1 value")
    assert(borrowGeneration1 > borrowGeneration0,
           " ffi handle generation reuse: borrow generation monotonic across reuse")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               handle1, borrowGeneration0) == -1,
           " ffi handle generation reuse: stale borrow token rejected")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               handle1, borrowGeneration1) == 0,
           " ffi handle generation reuse: handle1 lease release")
    let slot1: uint64 = handleSlot(handle1)
    let generation1: uint64 = handleGeneration(handle1)
    assert(slot1 == slot0, " ffi handle generation reuse: slot reused")
    assert(generation1 == generation0 + uint64(1),
           " ffi handle generation reuse: generation bumped")

    assert(cheng_tcp_buffer_handle_release_raw_bridge(handle1) == 0,
           " ffi handle generation reuse: handle1 release")

    let allocDelta: int64 = memAllocCount() - allocBefore
    let freeDelta: int64 = memFreeCount() - freeBefore
    let liveDelta: int64 = memLiveCount() - liveBefore
    assert(allocDelta == freeDelta, " ffi handle generation reuse: alloc/free balanced")
    assert(liveDelta == 0, " ffi handle generation reuse: live delta zero")

    echo(" ffi_handle_generation_reuse_smoke ok")
    return 0
