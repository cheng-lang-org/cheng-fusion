import std/os
import cheng/std/bytes_layout as layout

type
    ColdNestedFixed32Inner =
        cid: layout.FixedBytes32

    ColdNestedFixed32Outer =
        inner: ColdNestedFixed32Inner

fn main() =
    var outer: ColdNestedFixed32Outer
    outer.inner.cid.data[0] = uint8(7)
    assert(layout.FixedBytes32Equal(outer.inner.cid, outer.inner.cid),
           "nested FixedBytes32 field read changed type")
    assert(Int32(outer.inner.cid.data[0]) == 7,
           "nested FixedBytes32 field read changed bytes")
    os.WriteLine(os.Get_stdout(), "cold_nested_fixed32_field_read_smoke: ok")
