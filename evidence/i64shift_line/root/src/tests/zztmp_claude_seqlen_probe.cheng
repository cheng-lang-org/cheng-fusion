import std/cmdline as cmdline
import std/system as system
import std/seqs
import cheng/core/lang/parser
import cheng/core/lang/intern as langintern
import cheng/core/ir/phase_arena as phase
import cheng/std/bytes_layout as layout

fn ProbeFillProfile(p: var parser.NormalizedExprCallProfile) =
    p.sourcePath = "/x/a.cheng"
    p.ownerModulePath = "pkg"
    p.text = "l1\nl2\nl3\n"
    add(p.lines, "l1")
    add(p.lines, "l2")
    add(p.lines, "l3")

# shape2: var-param seq + var-param elem (the AppendMove shape)
fn ProbeShape2(profiles: var parser.NormalizedExprCallProfile[],
               profile: var parser.NormalizedExprCallProfile) =
    add(profiles, profile)

# shape3: var-param seq + local elem
fn ProbeShape3(profiles: var parser.NormalizedExprCallProfile[]) =
    var p: parser.NormalizedExprCallProfile
    ProbeFillProfile(p)
    add(profiles, p)

# shape4: local seq + var-param elem
fn ProbeShape4(profile: var parser.NormalizedExprCallProfile): int32 =
    var profiles: parser.NormalizedExprCallProfile[]
    add(profiles, profile)
    return profiles[0].lines.len

type
    ProbeWork =
        payloadMovedToOut: bool
        activeText: str
        activeProfile: parser.NormalizedExprCallProfile
        orderedSources: str[]
        exprCallProfiles: parser.NormalizedExprCallProfile[]
        profileLineCounts: int32[]
        lineInternPool: langintern.InternPool
        lineInternPoolActive: bool
        lineStore: phase.PhaseArenaStore
        lineStoreActive: bool
        lineArena: phase.PhaseArenaHandle
        profileLineIdColumns: phase.PhaseArenaRef[]
        profileLineIdCounts: int32[]

fn ProbeNewlineCount(text: str): int32 =
    var count: int32
    for i in 0..<text.len:
        if text[i] == '\n':
            count = count + 1
    return count

fn ProbeLineArenaInitInto(work: var ProbeWork) =
    var totalNewlines: int32
    totalNewlines = totalNewlines + ProbeNewlineCount(work.activeText)
    totalNewlines = totalNewlines + work.orderedSources.len
    let payloadBytes = totalNewlines * 4 + 4
    let rowBudget = work.orderedSources.len + 8
    phase.PhaseArenaStoreInit(work.lineStore, 1, payloadBytes, rowBudget)
    work.lineArena = phase.PhaseArenaStoreOpenArena(work.lineStore,
                                                    1,
                                                    payloadBytes,
                                                    rowBudget)
    work.lineStoreActive = true
    work.lineInternPool = langintern.InternPoolNew()
    work.lineInternPoolActive = true

fn ProbeProfileAppendMove(profiles: var parser.NormalizedExprCallProfile[],
                          profile: var parser.NormalizedExprCallProfile) =
    add(profiles, profile)
    profile = parser.NormalizedExprCallProfile()

fn ProbeProfileLinesInternIntoArena(work: var ProbeWork,
                                    profileIndex: int32) =
    let lineCount = work.exprCallProfiles[profileIndex].lines.len
    var column: phase.PhaseArenaRef
    if lineCount > 0:
        column = phase.PhaseArenaStoreReserveI32Column(work.lineStore,
                                                       work.lineArena,
                                                       lineCount)
        for li in 0..<lineCount:
            let internId = langintern.Intern(work.lineInternPool,
                                             work.exprCallProfiles[profileIndex].lines[li])
            phase.PhaseArenaStoreI32ColumnSet(work.lineStore,
                                              work.lineArena,
                                              column,
                                              li,
                                              internId)
        var profileLines = work.exprCallProfiles[profileIndex].lines
        work.exprCallProfiles[profileIndex].lines = []
        seqs.freeSeqStrRelease(profileLines)
    add(work.profileLineIdColumns, column)
    add(work.profileLineIdCounts, lineCount)

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    # shape1: local seq + local elem
    var s1: parser.NormalizedExprCallProfile[]
    var p1: parser.NormalizedExprCallProfile
    ProbeFillProfile(p1)
    add(s1, p1)
    echo(Fmt"shape1={s1[0].lines.len}")
    # shape2
    var s2: parser.NormalizedExprCallProfile[]
    var p2: parser.NormalizedExprCallProfile
    ProbeFillProfile(p2)
    ProbeShape2(s2, p2)
    echo(Fmt"shape2={s2[0].lines.len}")
    # shape3
    var s3: parser.NormalizedExprCallProfile[]
    ProbeShape3(s3)
    echo(Fmt"shape3={s3[0].lines.len}")
    # shape4
    var p4: parser.NormalizedExprCallProfile
    ProbeFillProfile(p4)
    let n4 = ProbeShape4(p4)
    echo(Fmt"shape4={n4}")
    # transcription: the exact CompilerCsg append-move + intern-into-arena flow
    var work: ProbeWork
    work.activeText = "l1\nl2\nl3\n"
    add(work.orderedSources, "/x/a.cheng")
    ProbeLineArenaInitInto(work)
    ProbeFillProfile(work.activeProfile)
    let activeProfileLineCount = work.activeProfile.lines.len
    ProbeProfileAppendMove(work.exprCallProfiles, work.activeProfile)
    ProbeProfileLinesInternIntoArena(work,
                                     work.exprCallProfiles.len - 1)
    add(work.profileLineCounts, activeProfileLineCount)
    echo(Fmt"internCount={work.profileLineIdCounts[0]}")
    if s1[0].lines.len == 3 && s2[0].lines.len == 3 &&
       s3[0].lines.len == 3 && n4 == 3 &&
       work.profileLineIdCounts[0] == 3 &&
       work.profileLineCounts[0] == 3:
        echo("PROBE_OK")
        return 0
    echo("PROBE_BAD")
    return 1
