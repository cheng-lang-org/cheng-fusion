    assert(len(hfW4RawFact) > 0, " distributed inference smoke: hf w4 raw fact built")
    assert(hfW4DistributedMetalOut.accepted,
        " distributed inference smoke: hf w4 metal quantized accepted")
    assert(hfW4DistributedMetalOut.receipt.outputHash == Value(hfW4OracleHash),
        " distributed inference smoke: hf w4 metal quantized output hash")
    assert(hfW4DistributedMetalOut.receipt.kvPageTableHash == hfW4Plan.kvReceipt.pageTableHash &&
           hfW4DistributedMetalOut.receipt.kvShardReceiptHash == hfW4Plan.kvShardReceipts.receiptSetHash,
        " distributed inference smoke: hf w4 metal quantized kv receipt")
    assert(traceFactsContain(hfW4DistributedMetalOut.traceFacts, "distributed_execution_stage=hf_glm_moe"),
        " distributed inference smoke: hf w4 metal quantized stage fact")
    assert(traceFactsContain(hfW4DistributedMetalOut.traceFacts, "distributed_execution_device=metal_quantized"),
        " distributed inference smoke: hf w4 metal quantized device fact")
    assert(traceFactsContain(hfW4DistributedMetalOut.traceFacts, hfW4RawFact),
        " distributed inference smoke: hf w4 metal quantized raw fact")

    let badElapsedRes = engine.DistributedExecuteAllGatherLmHeadMetal(
        plan,
        peers,
        envelopes,
        activationStore,
        evidenceFixture.evidence,
        weightFixture.store,
        metal,
        int64(0)
    )
    assert(IsErr(badElapsedRes), " distributed inference smoke: executed elapsed hard fail")

    let missingTransportRes = engine.DistributedExecuteAllGatherLmHeadMetal(
        plan,
        peers,
        [envelope0],
        activationStore,
        evidenceFixture.evidence,
        weightFixture.store,
        metal,
        int64(123456)
    )
    assert(IsErr(missingTransportRes), " distributed inference smoke: executed transport hard fail")

    let badWeightStoreRes = engine.DistributedExecuteAllGatherLmHeadMetal(
        plan,
        peers,
        envelopes,
        activationStore,
        evidenceFixture.evidence,
        payloadHashDriftStore,
        metal,
        int64(123456)
    )
    assert(IsErr(badWeightStoreRes), " distributed inference smoke: executed weight store hard fail")

    let badActivationStoreRes = engine.DistributedExecuteAllGatherLmHeadMetal(
        plan,
        peers,
        envelopes,
        activationPayloadHashDriftStore,
        evidenceFixture.evidence,
        weightFixture.store,
        metal,
        int64(123456)
    )
    assert(IsErr(badActivationStoreRes), " distributed inference smoke: executed activation store hard fail")

    let badRouteSetSource = moe.MoeRoutePlanClone(share(routePlanMaster))
    var badRouteSet = moe.MoeRoutePlanSetFromSingle(0, badRouteSetSource)
    badRouteSet.routeSetHash = badRouteSet.routeSetHash + int64(1)
    let partitionCopy8 = pp.ParallelPartitionPlanClone(share(partition))
    var kernelsCopy7 = [
        kir.KernelIrGemmProgram(2, 4, 4, kir.KernelDtypeFp16, 1000),
        kir.KernelIrRmsNormProgram(4, kir.KernelDtypeFp16, 1000, 1)
    ]
    let routePlanCopy5d = moe.MoeRoutePlanClone(share(routePlanMaster))
    let routeSetDriftPlan = engine.DistributedBuildPlanWithRouteSet(
        "cid:engine:distributed-route-set-drift",
        anchoredGraph,
        weightFixture.bindings,
        partitionCopy8,
        kernelsCopy7,
        kvFixture.receipt,
        kvFixture.stateHash,
        routePlanCopy5d,
        badRouteSet,
        activationShards
    )
    assert(IsErr(engine.DistributedValidatePlan(routeSetDriftPlan, peers)),
        " distributed inference smoke: route set hash drift")

    let partitionCopy9 = pp.ParallelPartitionPlanClone(share(partition))
    var kernelsCopy8 = [
        kir.KernelIrGemmProgram(2, 4, 4, kir.KernelDtypeFp16, 1000),
        kir.KernelIrRmsNormProgram(4, kir.KernelDtypeFp16, 1000, 1)
    ]
    let routePlanCopy5e = moe.MoeRoutePlanClone(share(routePlanMaster))
    let gapPlan = engine.DistributedBuildPlan(
        "cid:engine:distributed-fixture",
        anchoredGraph,
        weightFixture.bindings,
        partitionCopy9,
        kernelsCopy8,
        kvFixture.receipt,
        kvFixture.stateHash,
        routePlanCopy5e,
        [activationShards[0]]
    )
    assert(IsErr(engine.DistributedValidatePlan(gapPlan, peers)),
        " distributed inference smoke: activation coverage gap hard fail")

    let overlapShards = [
        activationShards[0],
        engine.DistributedActivationShard(
            shardName: "hidden:tokens:overlap",
            peerId: activationShards[1].peerId,
            schema: activationShards[1].schema,
            tokenStart: 0,
            tokenCount: activationShards[1].tokenCount,
            featureStart: activationShards[1].featureStart,
            featureCount: activationShards[1].featureCount,
            shardHash: activationShards[1].shardHash
        )
    ]
    let partitionCopy10 = pp.ParallelPartitionPlanClone(share(partition))
    var kernelsCopy9 = [
        kir.KernelIrGemmProgram(2, 4, 4, kir.KernelDtypeFp16, 1000),
        kir.KernelIrRmsNormProgram(4, kir.KernelDtypeFp16, 1000, 1)
    ]
    let routePlanCopy5f = moe.MoeRoutePlanClone(share(routePlanMaster))
    let overlapPlan = engine.DistributedBuildPlan(
        "cid:engine:distributed-fixture",
        anchoredGraph,
        weightFixture.bindings,
        partitionCopy10,
        kernelsCopy9,
        kvFixture.receipt,
        kvFixture.stateHash,
        routePlanCopy5f,
        overlapShards
    )
    assert(IsErr(engine.DistributedValidatePlan(overlapPlan, peers)),
        " distributed inference smoke: activation coverage overlap hard fail")

    let offlinePeers = [
        engine.DistributedInferencePeer(peerId: "peer:a", deviceCapabilityHash: "cap:metal:a", online: true, tensorShardBudget: 4, expertShardBudget: 1),
        engine.DistributedInferencePeer(peerId: "peer:b", deviceCapabilityHash: "cap:metal:b", online: false, tensorShardBudget: 4, expertShardBudget: 1)
    ]
    assert(IsErr(engine.DistributedValidatePlan(plan, offlinePeers)),
        " distributed inference smoke: offline peer hard fail")

    let lowBudgetPeers = [
        engine.DistributedInferencePeer(peerId: "peer:a", deviceCapabilityHash: "cap:metal:a", online: true, tensorShardBudget: 0, expertShardBudget: 1),
        engine.DistributedInferencePeer(peerId: "peer:b", deviceCapabilityHash: "cap:metal:b", online: true, tensorShardBudget: 4, expertShardBudget: 1)
    ]
    assert(IsErr(engine.DistributedValidatePlan(plan, lowBudgetPeers)),
        " distributed inference smoke: tensor budget hard fail")

    var missingDeviceWeightPlan = distributedFixturePlanFresh(anchoredGraph, weightFixture.bindings, partition, kvFixture.receipt, kvFixture.stateHash, routePlanMaster, activationShards)
    missingDeviceWeightPlan.deviceWeightBindingHash = int64(0)
    missingDeviceWeightPlan.engineHash = engine.DistributedPlanHash(missingDeviceWeightPlan)
    assert(IsErr(engine.DistributedValidatePlan(missingDeviceWeightPlan, peers)),
           " distributed inference smoke: missing device weight binding hard fail")
    var driftPlan = distributedFixturePlanFresh(anchoredGraph, weightFixture.bindings, partition, kvFixture.receipt, kvFixture.stateHash, routePlanMaster, activationShards)
    driftPlan.activationShards[0].shardHash = int64(333)
    assert(IsErr(engine.DistributedValidatePlan(driftPlan, peers)),
        " distributed inference smoke: activation hash drift")
    var weightDriftPlan = distributedFixturePlanFresh(anchoredGraph, weightFixture.bindings, partition, kvFixture.receipt, kvFixture.stateHash, routePlanMaster, activationShards)
    weightDriftPlan.weightBindings.bindingHash = weightDriftPlan.weightBindings.bindingHash + int64(1)
    assert(IsErr(engine.DistributedValidatePlan(weightDriftPlan, peers)),
        " distributed inference smoke: weight binding hash drift")
    var kvStateDriftPlan = distributedFixturePlanFresh(anchoredGraph, weightFixture.bindings, partition, kvFixture.receipt, kvFixture.stateHash, routePlanMaster, activationShards)
    kvStateDriftPlan.kvStateHash = int64(0)
    kvStateDriftPlan.engineHash = engine.DistributedPlanHash(kvStateDriftPlan)
    assert(IsErr(engine.DistributedValidatePlan(kvStateDriftPlan, peers)),
        " distributed inference smoke: kv state hash drift")
    var kvShardSetDriftPlan = distributedFixturePlanFresh(anchoredGraph, weightFixture.bindings, partition, kvFixture.receipt, kvFixture.stateHash, routePlanMaster, activationShards)
    kvShardSetDriftPlan.kvShardReceipts.receiptSetHash = kvShardSetDriftPlan.kvShardReceipts.receiptSetHash + int64(1)
    kvShardSetDriftPlan.engineHash = engine.DistributedPlanHash(kvShardSetDriftPlan)
    assert(IsErr(engine.DistributedValidatePlan(kvShardSetDriftPlan, peers)),
        " distributed inference smoke: kv shard receipt set drift")
    var duplicateActivationPlan = distributedFixturePlanFresh(anchoredGraph, weightFixture.bindings, partition, kvFixture.receipt, kvFixture.stateHash, routePlanMaster, activationShards)
    duplicateActivationPlan.activationShards[1].shardName = duplicateActivationPlan.activationShards[0].shardName
    duplicateActivationPlan.engineHash = engine.DistributedPlanHash(duplicateActivationPlan)
    assert(IsErr(engine.DistributedValidatePlan(duplicateActivationPlan, peers)),
        " distributed inference smoke: duplicate activation hard fail")
    var activationBoundsPlan = distributedFixturePlanFresh(anchoredGraph, weightFixture.bindings, partition, kvFixture.receipt, kvFixture.stateHash, routePlanMaster, activationShards)
    activationBoundsPlan.activationShards[1].featureCount = 5
    activationBoundsPlan.engineHash = engine.DistributedPlanHash(activationBoundsPlan)
    assert(IsErr(engine.DistributedValidatePlan(activationBoundsPlan, peers)),
        " distributed inference smoke: activation bounds hard fail")

    echo(" distributed_inference_engine_smoke ok")
    return 0
