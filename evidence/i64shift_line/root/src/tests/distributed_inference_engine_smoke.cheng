@borrows
fn buildActivationEvidenceFixture(plan: engine.DistributedInferencePlan,
                                  peers: engine.DistributedInferencePeer[],
                                  envelopes: activation_transport.ActivationEnvelope[],
                                  activationStore: activation_transport.ActivationTensorStore,
                                  payloads: activation_transport.ActivationTensorPayload[]): ActivationEvidenceFixture =
    let requests = buildShardRequestSet(plan, peers, payloads)
    var receiptsRaw: engine.DistributedShardExecutionReceipt[]
    var responsesRaw: engine.DistributedShardDispatchResponse[]
    var framesRaw: engine.DistributedShardTransportFrame[]
    for i in 0..<requests.requests.len:
        let request = requests.requests[i]
        let executed = engine.DistributedPeerExecuteActivationDispatch(
            plan,
            peers,
            request,
            payloads[i].tensor,
            int64(1000 + i)
        )
        if IsErr(executed):
            echo(Error(executed))
        assert(IsOk(executed), " distributed inference smoke: peer execute activation")
        let peerResult = Value(executed)
        let receiptValue = peerResult.receipt
        add(receiptsRaw, engine.DistributedShardExecutionReceipt(
            schema: strings.CloneStr(receiptValue.schema),
            enginePlanHash: receiptValue.enginePlanHash,
            peerId: strings.CloneStr(receiptValue.peerId),
            deviceCapabilityHash: strings.CloneStr(receiptValue.deviceCapabilityHash),
            shardName: strings.CloneStr(receiptValue.shardName),
            kernelHash: receiptValue.kernelHash,
            inputHash: receiptValue.inputHash,
            outputPayloadHash: receiptValue.outputPayloadHash,
            elapsedNs: receiptValue.elapsedNs,
            status: strings.CloneStr(receiptValue.status),
            receiptHash: receiptValue.receiptHash
        ))
        let responseRaw = peerResult.response
        add(responsesRaw, engine.DistributedShardDispatchResponse(
            schema: strings.CloneStr(responseRaw.schema),
            requestHash: responseRaw.requestHash,
            enginePlanHash: responseRaw.enginePlanHash,
            peerId: strings.CloneStr(responseRaw.peerId),
            deviceCapabilityHash: strings.CloneStr(responseRaw.deviceCapabilityHash),
            shardName: strings.CloneStr(responseRaw.shardName),
            payloadHash: responseRaw.payloadHash,
            receiptHash: responseRaw.receiptHash,
            elapsedNs: responseRaw.elapsedNs,
            responseHash: responseRaw.responseHash
        ))
        let requestFrame = engine.DistributedShardTransportRequestFrameBuild(
            request,
            uint64(i * 2),
            int64(7000 + i * 2)
        )
        assert(IsOk(requestFrame), " distributed inference smoke: request transport frame")
        add(framesRaw, Value(requestFrame))
        let responseFrame = engine.DistributedShardTransportResponseFrameBuild(
            request,
            peerResult.response,
            envelopes[i],
            uint64(i * 2 + 1),
            int64(7000 + i * 2 + 1)
        )
        assert(IsOk(responseFrame), " distributed inference smoke: response transport frame")
        add(framesRaw, Value(responseFrame))
    let receipts = engine.DistributedShardExecutionReceiptSetBuild(plan.engineHash, receiptsRaw)
    let responses = engine.DistributedShardDispatchResponseSetBuild(plan.engineHash, responsesRaw)
    let frames = engine.DistributedShardTransportFrameSetBuild(plan.engineHash, framesRaw)
    let draft = engine.DistributedActivationEvidenceBuild(plan.engineHash, cloneDispatchRequestSet(requests), cloneDispatchResponseSet(responses), cloneExecutionReceiptSet(receipts), cloneTransportFrameSet(frames))
    let evidenceRes = engine.DistributedActivationEvidenceSeal(envelopes, activationStore, draft)
    assert(IsOk(evidenceRes), " distributed inference smoke: activation evidence seal")
    return ActivationEvidenceFixture(
        requests: requests,
        responses: responses,
        receipts: receipts,
        frames: frames,
        evidence: Value(evidenceRes)
    )

fn main(): int32 =
    let graph = mg.ModelGraphBuildTinyGlmMoeFixture("cid:model:distributed-glm-moe")
    assert(IsOk(mg.ModelGraphValidate(graph)), " distributed inference smoke: graph")

    let peersText: str[] = ["peer:a", "peer:b"]
    let peers = [
        engine.DistributedInferencePeer(peerId: "peer:a", deviceCapabilityHash: "cap:metal:a", online: true, tensorShardBudget: 4, expertShardBudget: 1),
        engine.DistributedInferencePeer(peerId: "peer:b", deviceCapabilityHash: "cap:metal:b", online: true, tensorShardBudget: 4, expertShardBudget: 1)
    ]
    let partition = buildPartition(peersText)
    let weightFixture = buildWeightFixture(graph)
    let anchoredGraph = weightFixture.graph
    let tokenIds = makeTensor([2], 1, [0, 1])
    let kernels = [
        kir.KernelIrGemmProgram(2, 4, 4, kir.KernelDtypeFp16, 1000),
        kir.KernelIrRmsNormProgram(4, kir.KernelDtypeFp16, 1000, 1)
    ]
    let kvFixture = buildKvFixture()
    let routeTokenIds = makeTensor([2], 1, [0, 1])
    let routeRes = exec.ModelExecutorBuildTinyRoutePlan(
        anchoredGraph,
        weightFixture.bindings,
        weightFixture.store,
        routeTokenIds,
        2
    )
    assert(IsOk(routeRes), " distributed inference smoke: route")
    let routePlan = Value(routeRes)
    let activationFixture = buildActivationFixture()
    let activationShards = activationFixture.shards
    let kvReceiptPageTableHash = kvFixture.receipt.pageTableHash
    let partitionCopy1 = pp.ParallelPartitionPlanClone(share(partition))
    let partitionPlanHashSnapshot = partitionCopy1.planHash
    let activationShardCountSnapshot = activationShards.len
    let activationShard0PeerId = strings.CloneStr(activationShards[0].peerId)
    let partitionCopy2 = pp.ParallelPartitionPlanClone(share(partition))
    let routePlanMaster = moe.MoeRoutePlanClone(share(routePlan))
    let plan = engine.DistributedBuildPlan(
        "cid:engine:distributed-fixture",
        anchoredGraph,
        weightFixture.bindings,
        partitionCopy2,
        kernels,
        kvFixture.receipt,
        kvFixture.stateHash,
        routePlan,
        activationShards
    )
