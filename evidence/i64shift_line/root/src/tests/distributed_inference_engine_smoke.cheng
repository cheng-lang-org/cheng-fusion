type
    WeightFixture =
        graph: mg.ModelGraph
        bindings: wb.WeightBindingSet
        store: ws.WeightTensorStore

    ActivationFixture =
        shards: engine.DistributedActivationShard[]
        payloads: activation_transport.ActivationTensorPayload[]

    ActivationEvidenceFixture =
        requests: engine.DistributedShardDispatchRequestSet
        responses: engine.DistributedShardDispatchResponseSet
        receipts: engine.DistributedShardExecutionReceiptSet
        frames: engine.DistributedShardTransportFrameSet
        evidence: engine.DistributedActivationEvidence

    KvFixture =
        cache: pkv.PagedKVCache
        seq: pkv.PagedKVSequence
        receipt: pkv.PagedKVReceipt
        stateHash: int64

fn makeTensor(shape: int32[], scale: int32, data: int32[]): infer.TensorQ =
    var out: infer.TensorQ
    let res = infer.TensorFromDataFill(out, shape, scale, data)
    assert(IsOk(res), " distributed inference smoke: tensor")
    return out

fn buildKvFixture(): KvFixture =
    let cacheRes = pkv.PagedKVInit(2, 4, 4, 1000, 1000)
    assert(IsOk(cacheRes), " distributed inference smoke: kv init")
    var cache = Value(cacheRes)
    var seq = pkv.PagedKVSequenceInit(9)
    let appendRes = pkv.PagedKVAppendToken(
        cache,
        seq,
        makeTensor([4], 1000, [1000, 0, 0, 0]),
        makeTensor([4], 1000, [0, 1000, 0, 0])
    )
    assert(IsOk(appendRes), " distributed inference smoke: kv append")
    let layerState = exec.ModelExecutorKvLayerStateBuild(0, cache, seq)
    assert(IsOk(layerState), " distributed inference smoke: kv layer state")
    let stateSet = exec.ModelExecutorKvStateSetBuild([Value(layerState)])
    assert(IsOk(exec.ModelExecutorValidateKvStateSet(stateSet)), " distributed inference smoke: kv state set")
    return KvFixture(cache: cache, seq: seq, receipt: pkv.PagedKVReceiptFor(seq), stateHash: stateSet.stateSetHash)

@borrows
fn buildPartition(peers: str[]): pp.InferencePartitionPlan =
    return buildPartitionForHeads(1, peers)

@borrows
fn buildPartitionForHeads(headCount: int32, peers: str[]): pp.InferencePartitionPlan =
    var headPeers: str[]
    var expertPeers: str[]
    for i in 0..<peers.len:
        add(headPeers, strings.CloneStr(peers[i]))
        add(expertPeers, strings.CloneStr(peers[i]))
    let planRes = pp.ParallelBuildTensorHeadPlan("cid:partition:distributed-fixture", headCount, headPeers)
    assert(IsOk(planRes), " distributed inference smoke: tensor plan")
    var plan = Value(planRes)
    let expertRes = pp.ParallelAttachExpertPlan(plan, 2, expertPeers, "cid:expert:distributed:")
    assert(IsOk(expertRes), " distributed inference smoke: expert plan")
    assert(IsOk(pp.ParallelValidatePlan(plan)), " distributed inference smoke: partition validate")
    return plan

fn glm52KernelSet(): kir.KernelProgram[] =
    return [
        kir.KernelIrGemmProgram(2, 4, 4, kir.KernelDtypeFp16, 1000),
        kir.KernelIrRmsNormProgram(4, kir.KernelDtypeFp16, 1000, 1)
    ]

fn hfKernelSet(): kir.KernelProgram[] =
    return [
        kir.KernelIrLinearOutInInt4WeightProgram(1, 8, 8, kir.KernelDtypeFp16, 1000, 1000),
        kir.KernelIrRmsNormProgram(8, kir.KernelDtypeFp16, 1000, 1)
    ]

fn peerIdPair(): str[] =
    return ["peer:a", "peer:b"]

fn abPeersFresh(): engine.DistributedInferencePeer[] =
    return [
        engine.DistributedInferencePeer(peerId: "peer:a", deviceCapabilityHash: "cap:metal:a", online: true, tensorShardBudget: 4, expertShardBudget: 1),
        engine.DistributedInferencePeer(peerId: "peer:b", deviceCapabilityHash: "cap:metal:b", online: true, tensorShardBudget: 4, expertShardBudget: 1)
    ]

@borrows
fn distributedFixturePlanFresh(graph: mg.ModelGraph,
                               bindings: wb.WeightBindingSet,
                               partition: pp.InferencePartitionPlan,
                               kvReceipt: pkv.PagedKVReceipt,
                               kvStateHash: int64,
                               routePlan: moe.MoeRoutePlan,
                               shards: engine.DistributedActivationShard[]): engine.DistributedInferencePlan =
    var kernels = [
        kir.KernelIrGemmProgram(2, 4, 4, kir.KernelDtypeFp16, 1000),
        kir.KernelIrRmsNormProgram(4, kir.KernelDtypeFp16, 1000, 1)
    ]
    return engine.DistributedBuildPlan(
        "cid:engine:distributed-fixture",
        graph,
        bindings,
        pp.ParallelPartitionPlanClone(share(partition)),
        kernels,
        kvReceipt,
        kvStateHash,
        moe.MoeRoutePlanClone(share(routePlan)),
        shards
    )

@borrows
fn glm52DepinManifestFresh(plan: engine.DistributedInferencePlan,
                           kvEvidenceHash: int64,
                           requestSetHash: int64,
                           frameSetHash: int64,
                           evidenceHash: int64): depmanifest.DepinDistributedInferenceManifest =
    return depmanifest.DepinBuildDistributedManifestFromPlanFacts(
        plan.modelGraph.modelCid,
        plan.partitionPlan,
        plan.kernelPrograms,
        plan.deviceWeightBindingHash,
        plan.kvReceipt,
        plan.kvStateHash,
        plan.kvShardReceipts.receiptSetHash,
        kvEvidenceHash,
        plan.specDecodePlan.planHash,
        plan.routePlanSet,
        requestSetHash,
        frameSetHash,
        evidenceHash,
        int64(765446)
    )

@borrows
fn glm52DepinReceiptClone(receipt: depinspec.DepinSpecDecodeCertifiedReceipt): depinspec.DepinSpecDecodeCertifiedReceipt =
    return depinspec.DepinSpecDecodeCertifiedReceipt(
        schema: strings.CloneStr(receipt.schema),
        sessionId: strings.CloneStr(receipt.sessionId),
        requestId: strings.CloneStr(receipt.requestId),
        modelCid: strings.CloneStr(receipt.modelCid),
        manifestHash: receipt.manifestHash,
        enginePlanHash: receipt.enginePlanHash,
        draftEnginePlanHash: receipt.draftEnginePlanHash,
        specDecodePlanHash: receipt.specDecodePlanHash,
        draftWindow: receipt.draftWindow,
        draftTokenCount: receipt.draftTokenCount,
        mtpLayerCount: receipt.mtpLayerCount,
        contextTokenHash: receipt.contextTokenHash,
        draftTokenHash: receipt.draftTokenHash,
        draftLogitsHash: receipt.draftLogitsHash,
        draftKvStateHash: receipt.draftKvStateHash,
        draftReceiptHash: receipt.draftReceiptHash,
        draftHash: receipt.draftHash,
        verifyHash: receipt.verifyHash,
        verifyOutputTokenHash: receipt.verifyOutputTokenHash,
        verifyReceiptHash: receipt.verifyReceiptHash,
        acceptedPrefixLen: receipt.acceptedPrefixLen,
        rollbackFrom: receipt.rollbackFrom,
        mismatch: receipt.mismatch,
        receiptHash: receipt.receiptHash
    )

@borrows
fn glm52DepinSessionFresh(plan: engine.DistributedInferencePlan,
                          preferredPeers: str[]): depmanifest.DepinInferenceSession =
    var session: depmanifest.DepinInferenceSession
    session.sessionId = "sid:glm52:mtp:certified"
    session.request = depmanifest.DepinInferenceRequest(
        requestId: "req:glm52:mtp:certified",
        modelCid: plan.modelGraph.modelCid,
        promptRef: "prompt:glm52:mtp",
        layerCids: ["cid:layer:glm52:0"],
        preferredPeers: preferredPeers,
        riskLevel: "base"
    )
    session.config = depmanifest.DepinInferenceConfig(
        hiddenStateFrameBytes: 8192,
        stageTimeoutMs: 30000,
        specDraftWindow: plan.specDecodePlan.draftWindow,
        auditBaseBps: 100,
        auditHighRiskBps: 1000,
        mmapReadonlyPreferred: true
    )
    session.started = true
    return session

@borrows
fn glm52MtpPlanFresh(cid: str,
                     graph: mg.ModelGraph,
                     bindings: wb.WeightBindingSet,
                     partition: pp.InferencePartitionPlan,
                     kvReceipt: pkv.PagedKVReceipt,
                     kvStateHash: int64,
                     specPlan: engine.DistributedSpecDecodePlan,
                     routePlan: moe.MoeRoutePlan,
                     routeSet: moe.MoeRoutePlanSet,
                     shards: engine.DistributedActivationShard[]): engine.DistributedInferencePlan =
    return engine.DistributedBuildPlanWithRouteSetAndSpecDecode(
        cid,
        graph,
        bindings,
        pp.ParallelPartitionPlanClone(share(partition)),
        glm52KernelSet(),
        kvReceipt,
        kvStateHash,
        engine.DistributedSpecDecodePlanClone(share(specPlan)),
        moe.MoeRoutePlanClone(share(routePlan)),
        routeSet,
        shards
    )

fn makeWeightTensor(weight: mg.ModelWeightShard, ordinal: int32): infer.TensorQ =
    let countRes = mg.ModelGraphTensorElementCount(weight.shape)
    assert(IsOk(countRes), " distributed inference smoke: weight tensor shape")
    let elemCount = int32(Value(countRes))
    assert(elemCount > 0, " distributed inference smoke: weight tensor element count")
    var data: int32[]
    for i in 0..<elemCount:
        add(data, 100 + ordinal * 10 + i)
    return makeTensor(weight.shape, 1000, data)

fn makePackedInt4Tensor(shape: int32[], scale: int32, values: int32[]): kir.KernelPackedInt4Tensor =
    let countRes = infer.TensorElementCount(shape)
    assert(IsOk(countRes), " distributed inference smoke: packed int4 shape")
    assert(Value(countRes) == values.len, " distributed inference smoke: packed int4 count")
    let byteCount = values.len / 2 + values.len % 2
    var bytes = rawbytes.BytesAlloc(byteCount)
    assert(byteCount == 0 || bytes.data != nil, " distributed inference smoke: packed int4 allocation")
    for i in 0..<values.len:
        assert(values[i] >= -8 && values[i] <= 7, " distributed inference smoke: packed int4 range")
        var nibble = values[i]
        if nibble < 0:
            nibble = nibble + 16
        let byteIndex = i / 2
        let oldByte = rawbytes.BytesGet(bytes, byteIndex)
        if i % 2 == 0:
            rawbytes.BytesSet(bytes, byteIndex, (oldByte & 240) | (nibble & 15))
        else:
            rawbytes.BytesSet(bytes, byteIndex, (oldByte & 15) | ((nibble & 15) << 4))
    return kir.KernelPackedInt4Tensor(shape: shape, scale: scale, packed: bytes)

fn makePackedInt4Weight(weight: mg.ModelWeightShard, ordinal: int32): kir.KernelPackedInt4Tensor =
    let countRes = mg.ModelGraphTensorElementCount(weight.shape)
    assert(IsOk(countRes), " distributed inference smoke: packed int4 weight count")
    assert(Value(countRes) <= int64(2147483647), " distributed inference smoke: packed int4 weight range")
    let elemCount = int32(Value(countRes))
    var values: int32[]
    for i in 0..<elemCount:
        add(values, ((i + ordinal) % 5) - 2)
    return makePackedInt4Tensor(weight.shape, 1000, values)

@borrows
fn makePackedInt4DecodedWeightTensor(packed: kir.KernelPackedInt4Tensor): infer.TensorQ =
    let countRes = infer.TensorElementCount(packed.shape)
    assert(IsOk(countRes), " distributed inference smoke: packed int4 decoded count")
    var data: int32[]
    for i in 0..<Value(countRes):
        add(data, kir.KernelIrPackedInt4ValueAtUnchecked(packed, i))
    return makeTensor(packed.shape, packed.scale, data)

fn makeW4Afp8RawWeight(weight: mg.ModelWeightShard, ordinal: int32): rawbytes.Bytes =
    let countRes = mg.ModelGraphTensorElementCount(weight.shape)
    assert(IsOk(countRes), " distributed inference smoke: w4afp8 raw count")
    assert(Value(countRes) <= int64(2147483647), " distributed inference smoke: w4afp8 raw range")
    let elemCount = int32(Value(countRes))
    var bytes = rawbytes.BytesAlloc(elemCount)
    assert(elemCount == 0 || bytes.data != nil, " distributed inference smoke: w4afp8 raw allocation")
    for i in 0..<elemCount:
        var raw = ((i + ordinal) % 5) - 2
        if raw < 0:
            raw = raw + 256
        rawbytes.BytesSet(bytes, i, raw)
    return bytes

fn makeW4Afp8DecodedWeightTensor(shape: int32[], scale: int32, raw: rawbytes.Bytes): infer.TensorQ =
    var shapeForTensor: int32[]
    var shapeForCount: int32[]
    for i in 0..<shape.len:
        add(shapeForTensor, shape[i])
        add(shapeForCount, shape[i])
    let rawTensor = kir.KernelW4Afp8Tensor(shape: shapeForTensor, scale: scale, rawI8: raw)
    assert(IsOk(kir.KernelIrW4Afp8TensorValidate(rawTensor)), " distributed inference smoke: w4afp8 raw tensor")
    let countRes = infer.TensorElementCount(shapeForCount)
    assert(IsOk(countRes), " distributed inference smoke: w4afp8 decoded count")
    var data: int32[]
    for i in 0..<Value(countRes):
        add(data, kir.KernelIrW4Afp8ValueAtUnchecked(rawTensor, i))
    return makeTensor(shape, scale, data)

fn hfGraphWithSingleW4Afp8Weight(graph: mg.ModelGraph, tensorName: str): mg.ModelGraph =
    var weights: mg.ModelWeightShard[]
    var replaced: bool
    for i in 0..<graph.weights.len:
        var weight = graph.weights[i]
        if weight.tensorName == tensorName:
            let sizeBytes = mg.ModelGraphExpectedTensorBytes(kir.KernelDtypeInt8, weight.shape)
            assert(IsOk(sizeBytes), " distributed inference smoke: w4afp8 size")
            weight.dtype = kir.KernelDtypeInt8
            weight.quantScheme = mg.ModelQuantSchemeW4Afp8
            weight.sizeBytes = Value(sizeBytes)
            weight.expectedPayloadHash = int64(0)
            replaced = true
            add(weights, weight)
            let scaleName = ws.WeightSafetensorsW4Afp8ScaleTensorName(weight.tensorName)
            assert(IsOk(scaleName), " distributed inference smoke: w4afp8 scale name")
            var scaleShape: int32[]
            add(scaleShape, weight.shape[0])
            add(weights, mg.ModelWeightShard(
                modelCid: graph.modelCid,
                shardCid: strutil.Join([strings.CloneStr(weight.shardCid), strings.CloneStr(":scale-inv")], ""),
                tensorName: Value(scaleName),
                dtype: kir.KernelDtypeFp8E4M3,
                quantScheme: mg.ModelQuantSchemeNone,
                shape: scaleShape,
                sizeBytes: int64(weight.shape[0]),
                expectedPayloadHash: int64(0)
            ))
            let inputScaleName = ws.WeightSafetensorsW4Afp8InputScaleTensorName(weight.tensorName)
            assert(IsOk(inputScaleName), " distributed inference smoke: w4afp8 input scale name")
            var inputScaleShape: int32[]
            add(inputScaleShape, 1)
            add(weights, mg.ModelWeightShard(
                modelCid: graph.modelCid,
                shardCid: strutil.Join([strings.CloneStr(weight.shardCid), strings.CloneStr(":input-scale")], ""),
                tensorName: Value(inputScaleName),
                dtype: kir.KernelDtypeFp8E4M3,
                quantScheme: mg.ModelQuantSchemeNone,
                shape: inputScaleShape,
                sizeBytes: int64(1),
                expectedPayloadHash: int64(0)
            ))
        else:
            add(weights, weight)
    assert(replaced, " distributed inference smoke: w4afp8 replacement")
    var out = graph
    out.weights = weights
    out.graphHash = mg.ModelGraphHash(out)
    assert(IsOk(mg.ModelGraphValidate(out)), " distributed inference smoke: w4afp8 graph validate")
    return out

@borrows
fn weightShardPath(graph: mg.ModelGraph, ordinal: int32, suffix: str): str =
    var parts: str[]
    add(parts, strings.CloneStr("/tmp/cheng_distributed_inference_weight_"))
    add(parts, strings.Int64ToStr(graph.graphHash))
    add(parts, strings.CloneStr("_"))
    add(parts, strings.IntToStr(ordinal))
    add(parts, strings.CloneStr(suffix))
    add(parts, strings.CloneStr(".cwi1"))
    return strutil.Join(parts, "")

@borrows
fn copyShardPaths(paths: str[]): str[] =
    var out: str[]
    for i in 0..<paths.len:
        add(out, strings.CloneStr(paths[i]))
    return out

fn copyTensorShards(shards: pp.TensorParallelShard[]): pp.TensorParallelShard[] =
    var out: pp.TensorParallelShard[]
    for i in 0..<shards.len:
        var shard = shards[i]
        add(out, shard)
    return out

fn copyExpertShards(shards: pp.ExpertParallelShard[]): pp.ExpertParallelShard[] =
    var out: pp.ExpertParallelShard[]
    for i in 0..<shards.len:
        var shard = shards[i]
        add(out, shard)
    return out

fn copyActivationShards(shards: engine.DistributedActivationShard[]): engine.DistributedActivationShard[] =
    var out: engine.DistributedActivationShard[]
    for i in 0..<shards.len:
        var shard = shards[i]
        add(out, shard)
    return out

fn buildWeightFixture(graph: mg.ModelGraph): WeightFixture =
    var payloads: ws.WeightTensorPayload[]
    var bindings: wb.WeightShardBinding[]
    var shardPaths: str[]
    for i in 0..<graph.weights.len:
        var peerId = "peer:a"
        if i % 2 == 1:
            peerId = "peer:b"
        let tensor = makeWeightTensor(graph.weights[i], i)
        let payloadRes = ws.WeightTensorPayloadBuild(
            strings.CloneStr(graph.weights[i].modelCid),
            strings.CloneStr(graph.weights[i].tensorName),
            strings.CloneStr(graph.weights[i].shardCid),
            strings.CloneStr(graph.weights[i].dtype),
            strings.CloneStr(graph.weights[i].quantScheme),
            strings.CloneStr(peerId),
            tensor
        )
        assert(IsOk(payloadRes), " distributed inference smoke: weight payload")
        let payload = Value(payloadRes)
        let payloadHashValue = payload.payloadHash
        add(bindings, wb.WeightShardBinding(
            modelCid: strings.CloneStr(graph.weights[i].modelCid),
            tensorName: strings.CloneStr(graph.weights[i].tensorName),
            shardCid: strings.CloneStr(graph.weights[i].shardCid),
            dtype: strings.CloneStr(graph.weights[i].dtype),
            quantScheme: strings.CloneStr(graph.weights[i].quantScheme),
            sizeBytes: graph.weights[i].sizeBytes,
            peerId: strings.CloneStr(peerId),
            payloadHash: payloadHashValue
        ))
        let shardPath = weightShardPath(graph, i, "")
        if os.FileExists(shardPath):
            assert(os.RemoveFile(shardPath), " distributed inference smoke: remove old shard")
        let writeShard = ws.WeightTensorPayloadWriteMaterializedShardFile(shardPath, payload)
        assert(IsOk(writeShard), " distributed inference smoke: write weight shard")
        add(shardPaths, shardPath)
        add(payloads, payload)
    let set = wb.WeightBindingBuildSet(graph.modelCid, bindings)
    assert(IsOk(wb.WeightBindingValidate(set, graph)), " distributed inference smoke: weight bindings")
    let loadStore = ws.WeightTensorStoreLoadMaterializedShardFiles(graph.modelCid, set, shardPaths)
    assert(IsOk(loadStore), " distributed inference smoke: load materialized weight shards")
    let store = Value(loadStore)
    assert(IsOk(ws.WeightTensorValidateStore(store, set, graph)), " distributed inference smoke: weight store")
    var payloadHashes: int64[]
    for i in 0..<store.payloads.len:
        add(payloadHashes, store.payloads[i].payloadHash)
    let boundGraphRes = mg.ModelGraphBindExpectedWeightPayloadHashes(graph, payloadHashes)
    assert(IsOk(boundGraphRes), " distributed inference smoke: bind weight anchors")
    let boundGraph = Value(boundGraphRes)
    assert(IsOk(wb.WeightBindingValidate(set, boundGraph)), " distributed inference smoke: anchored weight bindings")
    assert(IsOk(ws.WeightTensorValidateStore(store, set, boundGraph)), " distributed inference smoke: anchored weight store")
    let badMagicPath = weightShardPath(graph, 0, "_bad_magic")
    let badMagicBytesRes = ws.WeightTensorMaterializedShardBytes(payloads[0].tensor)
    assert(IsOk(badMagicBytesRes), " distributed inference smoke: bad magic bytes")
    var badMagicBytes = Value(badMagicBytesRes)
    rawbytes.BytesSet(badMagicBytes, 0, 0)
    let badMagicWrite = os.WriteFileBytesResult(badMagicPath, badMagicBytes)
    assert(IsOk(badMagicWrite), " distributed inference smoke: bad magic write")
    var badMagicPaths = copyShardPaths(shardPaths)
    badMagicPaths[0] = badMagicPath
    assert(IsErr(ws.WeightTensorStoreLoadMaterializedShardFiles(graph.modelCid, set, badMagicPaths)),
        " distributed inference smoke: bad magic shard hard fail")
    var driftData: int32[]
    for i in 0..<payloads[0].tensor.data.len:
        var value = payloads[0].tensor.data[i]
        if i == 0:
            value = value + 1
        add(driftData, value)
    let driftTensor = makeTensor(payloads[0].tensor.shape, payloads[0].tensor.scale, driftData)
    let driftBytesRes = ws.WeightTensorMaterializedShardBytes(driftTensor)
    assert(IsOk(driftBytesRes), " distributed inference smoke: drift bytes")
    let driftPath = weightShardPath(graph, 0, "_payload_drift")
    var driftBytes = Value(driftBytesRes)
    let driftWrite = os.WriteFileBytesResult(driftPath, driftBytes)
    assert(IsOk(driftWrite), " distributed inference smoke: drift write")
    var driftPaths = copyShardPaths(shardPaths)
    driftPaths[0] = driftPath
    assert(IsErr(ws.WeightTensorStoreLoadMaterializedShardFiles(graph.modelCid, set, driftPaths)),
        " distributed inference smoke: drift shard hard fail")
    return WeightFixture(graph: boundGraph, bindings: set, store: store)

fn buildHfPackedInt4WeightFixture(graph: mg.ModelGraph): WeightFixture =
    var payloads: ws.WeightTensorPayload[]
    var bindings: wb.WeightShardBinding[]
    for i in 0..<graph.weights.len:
        var peerId = "peer:a"
        if i % 2 == 1:
            peerId = "peer:b"
        if strutil.Contains(graph.weights[i].tensorName, ".experts.0."):
            peerId = "peer:a"
        elif strutil.Contains(graph.weights[i].tensorName, ".experts.1."):
            peerId = "peer:b"
        var payload: ws.WeightTensorPayload
        if graph.weights[i].dtype == kir.KernelDtypeInt8 &&
           graph.weights[i].quantScheme == mg.ModelQuantSchemeW4Afp8:
            let raw = makeW4Afp8RawWeight(graph.weights[i], i)
            let tensor = makeW4Afp8DecodedWeightTensor(graph.weights[i].shape, 1000, raw)
            let payloadRes = ws.WeightTensorPayloadBuildWithW4Afp8Raw(
                strings.CloneStr(graph.weights[i].modelCid),
                strings.CloneStr(graph.weights[i].tensorName),
                strings.CloneStr(graph.weights[i].shardCid),
                strings.CloneStr(graph.weights[i].dtype),
                strings.CloneStr(graph.weights[i].quantScheme),
                strings.CloneStr(peerId),
                tensor,
                raw
            )
            assert(IsOk(payloadRes), " distributed inference smoke: hf w4afp8 payload")
            payload = Value(payloadRes)
        elif graph.weights[i].dtype == kir.KernelDtypeInt4 &&
           graph.weights[i].quantScheme == mg.ModelQuantSchemeSymmetricInt4:
            let packed = makePackedInt4Weight(graph.weights[i], i)
            let tensor = makePackedInt4DecodedWeightTensor(packed)
            let payloadRes = ws.WeightTensorPayloadBuildWithPackedInt4(
                strings.CloneStr(graph.weights[i].modelCid),
                strings.CloneStr(graph.weights[i].tensorName),
                strings.CloneStr(graph.weights[i].shardCid),
                strings.CloneStr(graph.weights[i].dtype),
                strings.CloneStr(graph.weights[i].quantScheme),
                strings.CloneStr(peerId),
                tensor,
                true,
                packed
            )
            assert(IsOk(payloadRes), " distributed inference smoke: hf packed int4 payload")
            payload = Value(payloadRes)
        else:
            let tensor = makeWeightTensor(graph.weights[i], i)
            let payloadRes = ws.WeightTensorPayloadBuild(
                strings.CloneStr(graph.weights[i].modelCid),
                strings.CloneStr(graph.weights[i].tensorName),
                strings.CloneStr(graph.weights[i].shardCid),
                strings.CloneStr(graph.weights[i].dtype),
                strings.CloneStr(graph.weights[i].quantScheme),
                strings.CloneStr(peerId),
                tensor
            )
            assert(IsOk(payloadRes), " distributed inference smoke: hf payload")
            payload = Value(payloadRes)
        let payloadHashValue = payload.payloadHash
        add(payloads, payload)
        add(bindings, wb.WeightShardBinding(
            modelCid: strings.CloneStr(graph.weights[i].modelCid),
            tensorName: strings.CloneStr(graph.weights[i].tensorName),
            shardCid: strings.CloneStr(graph.weights[i].shardCid),
            dtype: strings.CloneStr(graph.weights[i].dtype),
            quantScheme: strings.CloneStr(graph.weights[i].quantScheme),
            sizeBytes: graph.weights[i].sizeBytes,
            peerId: strings.CloneStr(peerId),
            payloadHash: payloadHashValue
        ))
    let set = wb.WeightBindingBuildSet(graph.modelCid, bindings)
    var hashes: int64[]
    for i in 0..<payloads.len:
        add(hashes, payloads[i].payloadHash)
    let store = ws.WeightTensorStoreBuild(graph.modelCid, payloads)
    let boundGraphRes = mg.ModelGraphBindExpectedWeightPayloadHashes(graph, hashes)
    assert(IsOk(boundGraphRes), " distributed inference smoke: hf bind weight anchors")
    let boundGraph = Value(boundGraphRes)
    assert(IsOk(wb.WeightBindingValidate(set, boundGraph)), " distributed inference smoke: hf binding validate")
    assert(IsOk(ws.WeightTensorValidateStore(store, set, boundGraph)), " distributed inference smoke: hf store validate")
    return WeightFixture(graph: boundGraph, bindings: set, store: store)

fn buildPayloadHashDriftStore(store: ws.WeightTensorStore): ws.WeightTensorStore =
    var payloads: ws.WeightTensorPayload[]
    for i in 0..<store.payloads.len:
        var payload = store.payloads[i]
        if i == 0:
            payload.payloadHash = payload.payloadHash + int64(1)
        add(payloads, payload)
    return ws.WeightTensorStoreBuild(store.modelCid, payloads)

fn buildWeightPeerDriftBindings(set: wb.WeightBindingSet): wb.WeightBindingSet =
    var bindings: wb.WeightShardBinding[]
    for i in 0..<set.bindings.len:
        var binding = set.bindings[i]
        if i == 0:
            binding.peerId = "peer:missing"
        add(bindings, binding)
    return wb.WeightBindingBuildSet(set.modelCid, bindings)

fn buildExpertWeightPeerDriftBindings(set: wb.WeightBindingSet): wb.WeightBindingSet =
    var bindings: wb.WeightShardBinding[]
    var changed: bool
    for i in 0..<set.bindings.len:
        var binding = set.bindings[i]
        if !changed && strutil.Contains(binding.tensorName, ".experts.0."):
            binding.peerId = "peer:b"
            changed = true
        add(bindings, binding)
    assert(changed, " distributed inference smoke: expert drift binding target")
    return wb.WeightBindingBuildSet(set.modelCid, bindings)

fn buildActivationFixture(): ActivationFixture =
    let payload0Res = activation_transport.ActivationTensorPayloadBuild(
        "peer:a",
        "peer:b",
        "hidden:tokens:0",
        0,
        1,
        0,
        4,
        makeTensor([1, 4], 1000, [101, 102, 103, 104])
    )
    assert(IsOk(payload0Res), " distributed inference smoke: activation payload0")
    let payload0 = Value(payload0Res)
    let payload1Res = activation_transport.ActivationTensorPayloadBuild(
        "peer:a",
        "peer:b",
        "hidden:tokens:1",
        1,
        1,
        0,
        4,
        makeTensor([1, 4], 1000, [201, 202, 203, 204])
    )
    assert(IsOk(payload1Res), " distributed inference smoke: activation payload1")
    let payload1 = Value(payload1Res)
    let shards = [
        engine.DistributedActivationShard(shardName: payload0.shardName, peerId: payload0.sourcePeerId, schema: engine.DistributedInferenceActivationSchema, tokenStart: payload0.tokenStart, tokenCount: payload0.tokenCount, featureStart: payload0.featureStart, featureCount: payload0.featureCount, shardHash: payload0.payloadHash),
        engine.DistributedActivationShard(shardName: payload1.shardName, peerId: payload1.sourcePeerId, schema: engine.DistributedInferenceActivationSchema, tokenStart: payload1.tokenStart, tokenCount: payload1.tokenCount, featureStart: payload1.featureStart, featureCount: payload1.featureCount, shardHash: payload1.payloadHash)
    ]
    return ActivationFixture(shards: shards, payloads: [payload0, payload1])

fn buildFullHiddenActivationFixtureForTokens(tokenCount: int32): ActivationFixture =
    assert(tokenCount > 0, " distributed inference smoke: full hidden activation token count")
    var payloads: activation_transport.ActivationTensorPayload[]
    var shards: engine.DistributedActivationShard[]
    for tokenIndex in 0..<tokenCount:
        let base = 101 + tokenIndex * 100
        let payloadRes = activation_transport.ActivationTensorPayloadBuild(
            "peer:a",
            "peer:b",
            strutil.Join(["hidden:full:token:", strings.IntToStr(tokenIndex)], ""),
            tokenIndex,
            1,
            0,
            4,
            makeTensor([1, 4], 1000, [base, base + 1, base + 2, base + 3])
        )
        assert(IsOk(payloadRes), " distributed inference smoke: full hidden activation payload")
        let payload = Value(payloadRes)
        let shardNameV = strings.CloneStr(payload.shardName)
        let sourcePeerV = strings.CloneStr(payload.sourcePeerId)
        let tokenStartV = payload.tokenStart
        let tokenCountV = payload.tokenCount
        let featureStartV = payload.featureStart
        let featureCountV = payload.featureCount
        let payloadHashV = payload.payloadHash
        add(payloads, payload)
        add(shards, engine.DistributedActivationShard(
            shardName: shardNameV,
            peerId: sourcePeerV,
            schema: engine.DistributedInferenceActivationSchema,
            tokenStart: tokenStartV,
            tokenCount: tokenCountV,
            featureStart: featureStartV,
            featureCount: featureCountV,
            shardHash: payloadHashV
        ))
    return ActivationFixture(shards: shards, payloads: payloads)

fn buildHfActivationFixtureForTokens(tokenCount: int32): ActivationFixture =
    assert(tokenCount > 0, " distributed inference smoke: hf activation token count")
    var data0: int32[]
    var data1: int32[]
    for tokenIndex in 0..<tokenCount:
        let base0 = 11 + tokenIndex * 10
        let base1 = 15 + tokenIndex * 10
        add(data0, base0)
        add(data0, base0 + 1)
        add(data0, base0 + 2)
        add(data0, base0 + 3)
        add(data1, base1)
        add(data1, base1 + 1)
        add(data1, base1 + 2)
        add(data1, base1 + 3)
    let payload0Res = activation_transport.ActivationTensorPayloadBuild(
        "peer:a",
        "peer:b",
        strutil.Join(["hf:hidden:feature:0:t", strings.IntToStr(tokenCount)], ""),
        0,
        tokenCount,
        0,
        4,
        makeTensor([tokenCount, 4], 1000, data0)
    )
    assert(IsOk(payload0Res), " distributed inference smoke: hf activation payload0")
    let payload0 = Value(payload0Res)
    let payload1Res = activation_transport.ActivationTensorPayloadBuild(
        "peer:b",
        "peer:a",
        strutil.Join(["hf:hidden:feature:1:t", strings.IntToStr(tokenCount)], ""),
        0,
        tokenCount,
        4,
        4,
        makeTensor([tokenCount, 4], 1000, data1)
    )
    assert(IsOk(payload1Res), " distributed inference smoke: hf activation payload1")
    let payload1 = Value(payload1Res)
    let shards = [
        engine.DistributedActivationShard(shardName: payload0.shardName, peerId: payload0.sourcePeerId, schema: engine.DistributedInferenceActivationSchema, tokenStart: payload0.tokenStart, tokenCount: payload0.tokenCount, featureStart: payload0.featureStart, featureCount: payload0.featureCount, shardHash: payload0.payloadHash),
        engine.DistributedActivationShard(shardName: payload1.shardName, peerId: payload1.sourcePeerId, schema: engine.DistributedInferenceActivationSchema, tokenStart: payload1.tokenStart, tokenCount: payload1.tokenCount, featureStart: payload1.featureStart, featureCount: payload1.featureCount, shardHash: payload1.payloadHash)
    ]
    return ActivationFixture(shards: shards, payloads: [payload0, payload1])

fn buildHfActivationFixture(): ActivationFixture =
    return buildHfActivationFixtureForTokens(1)

@borrows
fn buildActivationEnvelopes(plan: engine.DistributedInferencePlan,
                            payloads: activation_transport.ActivationTensorPayload[]): activation_transport.ActivationEnvelope[] =
    var out: activation_transport.ActivationEnvelope[]
    var prevHash: int64 = int64(0)
    for i in 0..<payloads.len:
        let envelope = activation_transport.ActivationTransportBuildEnvelope(
            plan.engineHash,
            payloads[i].sourcePeerId,
            payloads[i].targetPeerId,
            payloads[i].shardName,
            uint64(i),
            payloads[i].tokenStart,
            payloads[i].tokenCount,
            payloads[i].featureStart,
            payloads[i].featureCount,
            payloads[i].payloadHash,
            prevHash
        )
        let envelopeHashV = envelope.envelopeHash
        add(out, envelope)
        prevHash = envelopeHashV
    return out

fn hfDistributedConfig(): str =
    return "{\"model_type\":\"glm5_moe\",\"vocab_size\":16,\"hidden_size\":8,\"num_hidden_layers\":1,\"num_attention_heads\":2,\"num_key_value_heads\":2,\"head_dim\":4,\"moe_intermediate_size\":12,\"num_experts\":2,\"num_experts_per_tok\":2,\"tie_word_embeddings\":false}"

fn hfDistributedTwoLayerConfig(): str =
    return "{\"model_type\":\"glm5_moe\",\"vocab_size\":16,\"hidden_size\":8,\"num_hidden_layers\":2,\"num_attention_heads\":2,\"num_key_value_heads\":2,\"head_dim\":4,\"moe_intermediate_size\":12,\"num_experts\":2,\"num_experts_per_tok\":2,\"tie_word_embeddings\":false}"

@borrows
fn buildActivationPayloadHashDriftStore(store: activation_transport.ActivationTensorStore): activation_transport.ActivationTensorStore =
    var payloads: activation_transport.ActivationTensorPayload[]
    for i in 0..<store.payloads.len:
        var payload = store.payloads[i]
        var driftHash = payload.payloadHash
        if i == 0:
            driftHash = driftHash + int64(1)
        let tensorCloneRes = infer.TensorClone(payload.tensor)
        add(payloads, activation_transport.ActivationTensorPayload(
            sourcePeerId: strings.CloneStr(payload.sourcePeerId),
            targetPeerId: strings.CloneStr(payload.targetPeerId),
            shardName: strings.CloneStr(payload.shardName),
            tokenStart: payload.tokenStart,
            tokenCount: payload.tokenCount,
            featureStart: payload.featureStart,
            featureCount: payload.featureCount,
            payloadHash: driftHash,
            tensor: tensorCloneRes
        ))
    return activation_transport.ActivationTensorStoreBuild(store.enginePlanHash, payloads)

@borrows
fn assertTensorExact(tensor: infer.TensorQ, shape: int32[], expected: int32[], label: str) =
    assert(tensor.shape.len == shape.len, label)
    for i in 0..<shape.len:
        assert(tensor.shape[i] == shape[i], label)
    assert(tensor.data.len == expected.len, label)
    for i in 0..<expected.len:
        assert(tensor.data[i] == expected[i], label)

@borrows
fn peerCapability(peers: engine.DistributedInferencePeer[], peerId: str): str =
    for i in 0..<peers.len:
        if peers[i].peerId == peerId:
            return peers[i].deviceCapabilityHash
    assert(false, " distributed inference smoke: peer capability")
    return ""

@borrows
fn traceFactsContain(facts: str[], fact: str): bool =
    for i in 0..<facts.len:
        if facts[i] == fact:
            return true
    return false

@borrows
fn buildShardRequestSet(plan: engine.DistributedInferencePlan,
                        peers: engine.DistributedInferencePeer[],
                        payloads: activation_transport.ActivationTensorPayload[]): engine.DistributedShardDispatchRequestSet =
    var requests: engine.DistributedShardDispatchRequest[]
    let kernelHash: int64 = plan.kernelPrograms[0].kernelHash
    for i in 0..<payloads.len:
        let inputHash = engine.DistributedShardDispatchExpectedInputHash(
            plan,
            plan.activationShards[i],
            kernelHash
        )
        assert(IsOk(inputHash), " distributed inference smoke: shard input hash")
        let draft = engine.DistributedShardDispatchRequest(
            schema: "",
            enginePlanHash: plan.engineHash,
            coordinatorPeerId: "peer:coordinator",
            peerId: strings.CloneStr(payloads[i].sourcePeerId),
            targetPeerId: strings.CloneStr(payloads[i].targetPeerId),
            deviceCapabilityHash: peerCapability(peers, payloads[i].sourcePeerId),
            shardName: strings.CloneStr(payloads[i].shardName),
            kernelHash: kernelHash,
            inputHash: Value(inputHash),
            expectedOutputPayloadHash: payloads[i].payloadHash,
            tokenStart: payloads[i].tokenStart,
            tokenCount: payloads[i].tokenCount,
            featureStart: payloads[i].featureStart,
            featureCount: payloads[i].featureCount,
            requestHash: int64(0)
        )
        add(requests, engine.DistributedShardDispatchRequestBuild(draft))
    return engine.DistributedShardDispatchRequestSetBuild(plan.engineHash, requests)

fn buildShardReceiptSet(plan: engine.DistributedInferencePlan,
                        peers: engine.DistributedInferencePeer[],
                        requests: engine.DistributedShardDispatchRequestSet,
                        payloads: activation_transport.ActivationTensorPayload[]): engine.DistributedShardExecutionReceiptSet =
    var receipts: engine.DistributedShardExecutionReceipt[]
    for i in 0..<requests.requests.len:
        let request = requests.requests[i]
        let executed = engine.DistributedPeerExecuteActivationDispatch(
            plan,
            peers,
            request,
            payloads[i].tensor,
            int64(1000 + i)
        )
        if IsErr(executed):
            echo(Error(executed))
        assert(IsOk(executed), " distributed inference smoke: peer execute activation")
        let executedValue = Value(executed)
        add(receipts, engine.DistributedShardExecutionReceipt(
            schema: strings.CloneStr(executedValue.receipt.schema),
            enginePlanHash: executedValue.receipt.enginePlanHash,
            peerId: strings.CloneStr(executedValue.receipt.peerId),
            deviceCapabilityHash: strings.CloneStr(executedValue.receipt.deviceCapabilityHash),
            shardName: strings.CloneStr(executedValue.receipt.shardName),
            kernelHash: executedValue.receipt.kernelHash,
            inputHash: executedValue.receipt.inputHash,
            outputPayloadHash: executedValue.receipt.outputPayloadHash,
            elapsedNs: executedValue.receipt.elapsedNs,
            status: strings.CloneStr(executedValue.receipt.status),
            receiptHash: executedValue.receipt.receiptHash
        ))
    return engine.DistributedShardExecutionReceiptSetBuild(plan.engineHash, receipts)

fn buildShardResponseSet(plan: engine.DistributedInferencePlan,
                         peers: engine.DistributedInferencePeer[],
                         requests: engine.DistributedShardDispatchRequestSet,
                         payloads: activation_transport.ActivationTensorPayload[]): engine.DistributedShardDispatchResponseSet =
    var responses: engine.DistributedShardDispatchResponse[]
    for i in 0..<requests.requests.len:
        let request = requests.requests[i]
        let executed = engine.DistributedPeerExecuteActivationDispatch(
            plan,
            peers,
            request,
            payloads[i].tensor,
            int64(1000 + i)
        )
        assert(IsOk(executed), " distributed inference smoke: peer execute response")
        let responseValue = Value(executed).response
        add(responses, engine.DistributedShardDispatchResponse(
            schema: strings.CloneStr(responseValue.schema),
            requestHash: responseValue.requestHash,
            enginePlanHash: responseValue.enginePlanHash,
            peerId: strings.CloneStr(responseValue.peerId),
            deviceCapabilityHash: strings.CloneStr(responseValue.deviceCapabilityHash),
            shardName: strings.CloneStr(responseValue.shardName),
            payloadHash: responseValue.payloadHash,
            receiptHash: responseValue.receiptHash,
            elapsedNs: responseValue.elapsedNs,
            responseHash: responseValue.responseHash
        ))
    return engine.DistributedShardDispatchResponseSetBuild(plan.engineHash, responses)

@borrows
fn cloneDispatchRequestSet(source: engine.DistributedShardDispatchRequestSet): engine.DistributedShardDispatchRequestSet =
    var requests: engine.DistributedShardDispatchRequest[]
    for i in 0..<source.requests.len:
        add(requests, engine.DistributedShardDispatchRequest(
            schema: strings.CloneStr(source.requests[i].schema),
            enginePlanHash: source.requests[i].enginePlanHash,
            coordinatorPeerId: strings.CloneStr(source.requests[i].coordinatorPeerId),
            peerId: strings.CloneStr(source.requests[i].peerId),
            targetPeerId: strings.CloneStr(source.requests[i].targetPeerId),
            deviceCapabilityHash: strings.CloneStr(source.requests[i].deviceCapabilityHash),
            shardName: strings.CloneStr(source.requests[i].shardName),
            kernelHash: source.requests[i].kernelHash,
            inputHash: source.requests[i].inputHash,
            expectedOutputPayloadHash: source.requests[i].expectedOutputPayloadHash,
            tokenStart: source.requests[i].tokenStart,
            tokenCount: source.requests[i].tokenCount,
            featureStart: source.requests[i].featureStart,
            featureCount: source.requests[i].featureCount,
            requestHash: source.requests[i].requestHash
        ))
    return engine.DistributedShardDispatchRequestSet(
        schema: strings.CloneStr(source.schema),
        enginePlanHash: source.enginePlanHash,
        requests: requests,
        requestSetHash: source.requestSetHash
    )

