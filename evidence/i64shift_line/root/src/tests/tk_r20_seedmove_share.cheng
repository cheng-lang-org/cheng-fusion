type R20Seed = object
    endColumnNumber: int32
    surfaceText: str

fn R20Text(n: int32): str =
    if n > 0:
        return "continue"
    return "break"

fn R20Append(limit: int32, seeds: var R20Seed[]) =
    var searchStart: int32
    while searchStart < limit:
        let surfaceText = R20Text(searchStart)
        var seed: R20Seed
        seed.endColumnNumber = searchStart + surfaceText.len
        seed.surfaceText = share(surfaceText)
        add(seeds, seed)
        searchStart = searchStart + surfaceText.len

fn main(): int32 =
    var seeds: R20Seed[]
    R20Append(3, seeds)
    echo("r20 seedmove share ok")
    return 0
