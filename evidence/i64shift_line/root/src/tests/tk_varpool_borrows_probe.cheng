module tk_varpool_borrows_probe

import cheng/core/lang/intern as langintern

fn Touch(pool: var langintern.InternPool): int32 =
    let r = langintern.LookupIntern(pool, 0)
    if IsOk(r):
        return len(Value(r))
    return 0

fn main(): int32 =
    var p: langintern.InternPool
    return Touch(p)

main()
