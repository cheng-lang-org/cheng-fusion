# lsp_completion_ranking_smoke.cheng -- test completion ranking, filtering, and limiting.
# Verifies LspCompletionScore returns correct scores:
#   - exact prefix match > substring match
#   - shorter name > longer name (same match type)
#   - no match returns 0
#   - empty prefix matches all
# Also verifies sorting (descending by score) and limiting (max 100).

import cheng/core/tooling/lsp_server as server
import cheng/core/tooling/lsp_protocol as lsp

# --- Test LspCompletionScore ---

fn TestExactMatchScoresHigher(): int32 =
    let exact: int32 = server.LspCompletionScore("myFunc", "my")
    let partial: int32 = server.LspCompletionScore("notmyFunc", "my")
    if exact <= 0: return 1
    if partial <= 0: return 2
    if exact <= partial: return 3
    return 0

fn TestNoMatchReturnsZero(): int32 =
    if server.LspCompletionScore("hello", "xyz") != 0: return 4
    return 0

fn TestShorterNameScoresHigher(): int32 =
    let short: int32 = server.LspCompletionScore("cat", "c")
    let long: int32 = server.LspCompletionScore("caterpillar", "c")
    if short <= 0 || long <= 0: return 5
    if short <= long: return 6
    return 0

fn TestEmptyPrefixMatchesAll(): int32 =
    if server.LspCompletionScore("anything", "") <= 0: return 7
    return 0

fn TestSubstringMatch(): int32 =
    let score: int32 = server.LspCompletionScore("longName", "Name")
    if score <= 0: return 8
    return 0

# --- Test LspSortCompletions ---

fn TestSortByScoreDescending(): int32 =
    var items: server.ScoredCompletion[]
    var a: server.ScoredCompletion
    a.score = 100
    a.item = lsp.LspMakeCompletionItem("a", lsp.CikFunction, "", "", "a", "a", "a")
    add(items, a)
    var b: server.ScoredCompletion
    b.score = 200
    b.item = lsp.LspMakeCompletionItem("b", lsp.CikFunction, "", "", "b", "b", "b")
    add(items, b)
    var c: server.ScoredCompletion
    c.score = 50
    c.item = lsp.LspMakeCompletionItem("c", lsp.CikFunction, "", "", "c", "c", "c")
    add(items, c)

    server.LspSortCompletions(items)

    if items.len != 3: return 9
    if items[0].score != 200: return 10
    if items[1].score != 100: return 11
    if items[2].score != 50: return 12
    if items[0].item.label != "b": return 13
    if items[1].item.label != "a": return 14
    if items[2].item.label != "c": return 15
    return 0

fn TestStableSort(): int32 =
    var items: server.ScoredCompletion[]
    var a: server.ScoredCompletion
    a.score = 100
    a.item = lsp.LspMakeCompletionItem("first", lsp.CikFunction, "", "", "", "", "")
    add(items, a)
    var b: server.ScoredCompletion
    b.score = 100
    b.item = lsp.LspMakeCompletionItem("second", lsp.CikFunction, "", "", "", "", "")
    add(items, b)
    var c: server.ScoredCompletion
    c.score = 100
    c.item = lsp.LspMakeCompletionItem("third", lsp.CikFunction, "", "", "", "", "")
    add(items, c)

    server.LspSortCompletions(items)

    if items.len != 3: return 16
    # Same score = preserve original order (stable)
    if items[0].item.label != "first": return 17
    if items[1].item.label != "second": return 18
    if items[2].item.label != "third": return 19
    return 0

fn main(): int32 =
    var result: int32

    result = TestExactMatchScoresHigher()
    if result != 0: return result

    result = TestNoMatchReturnsZero()
    if result != 0: return result

    result = TestShorterNameScoresHigher()
    if result != 0: return result

    result = TestEmptyPrefixMatchesAll()
    if result != 0: return result

    result = TestSubstringMatch()
    if result != 0: return result

    result = TestSortByScoreDescending()
    if result != 0: return result

    result = TestStableSort()
    if result != 0: return result

    return 0
