# Pure-Cheng native MoQ-over-QUIC 秒发秒开 core for HarmonyOS (HongMeng).
#
# Single-process in-process publish (serve a fountain segment over a QUIC stream)
# + open (dial + fetch + integrity-verify), timed. This is the transport 秒发秒开
# (no decode/GUI) packaged as a NAPI-callable @exportc entry for a Harmony HAP,
# mirroring the device-verified Android two-process MoQ smoke. The publisher
# (listener datapath) and subscriber (client datapath) coexist in one process —
# the exact listener+client topology the datapath id-collision fix enables.

import std/result
import std/rawbytes
import std/strutils as strutil
import std/times as times
import cheng/quic/connection as qconn
import cheng/quic/msquicruntime as qruntime
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream

fn chengMoqHarmonyBuildSegment(n: int32): rawbytes.Bytes =
    var b = rawbytes.BytesAlloc(n)
    var i: int32 = 0
    while i < n:
        rawbytes.BytesSet(b, i, (i * 31 + 7) & 255)
        i = i + 1
    return b

fn chengMoqHarmonyBytesEq(left: rawbytes.Bytes, right: rawbytes.Bytes): bool =
    if rawbytes.BytesLen(left) != rawbytes.BytesLen(right):
        return false
    var i: int32 = 0
    let n = rawbytes.BytesLen(left)
    while i < n:
        if rawbytes.BytesGet(left, i) != rawbytes.BytesGet(right, i):
            return false
        i = i + 1
    return true

fn chengMoqHarmonyReadAll(reader: var moqstream.Libp2pMoqSegmentStreamReader,
                          chunkBytes: int32): Result[rawbytes.Bytes] =
    var out: rawbytes.Bytes = rawbytes.EmptyBytes()
    while !reader.closed:
        let readRes = moqstream.Libp2pMoqSegmentStreamRead(reader, chunkBytes)
        if IsErr(readRes):
            return Err[rawbytes.Bytes](Error(readRes))
        let chunk = Value(readRes)
        if rawbytes.BytesLen(chunk) <= 0:
            return Ok[rawbytes.Bytes](out)
        out = rawbytes.BytesConcat(out, chunk)
    return Ok[rawbytes.Bytes](out)

# Run one publish+open cycle of a `segmentBytes`-sized segment over a real QUIC
# transport pair, integrity-verify the fetched bytes against the source, and
# return the fetch latency in milliseconds. Negative = failure step code.
fn chengMoqHarmonyRunOnce(segmentLen: int32): int64 =
    let segment = chengMoqHarmonyBuildSegment(segmentLen)
    let segmentKey = "harmony-seg-1"

    var settings = qruntime.initMsQuicSettings()
    settings.allowDatagram = true

    var listener = qtransport.InitMsQuicTransport()
    if IsErr(qtransport.setMsQuicTransportSettings(listener, settings)):
        return -11
    if IsErr(quic_transport.Libp2pQuicConfigureTls(listener)):
        return -12
    let listenAddrRes = quic_transport.Libp2pQuicAddrFromHostPort("127.0.0.1", 0)
    if IsErr(listenAddrRes):
        return -13
    qtransport.start(listener, Value(listenAddrRes))

    var client = qtransport.InitMsQuicTransport()
    if IsErr(qtransport.setMsQuicTransportSettings(client, settings)):
        return -14
    if IsErr(quic_transport.Libp2pQuicConfigureTls(client)):
        return -15

    let startMs = times.MonotimeMs()
    let dialRes = qtransport.dial(client, listener.listenAddr)
    if IsErr(dialRes):
        return -16
    var clientLegacy = Value(dialRes)
    let acceptRes = qtransport.accept(listener)
    if IsErr(acceptRes):
        return -17
    var serverLegacy = Value(acceptRes)

    let streamPairRes = qconn.newNativeConnectionPairForStreams(clientLegacy.localAddr,
                                                                clientLegacy.remoteAddr,
                                                                serverLegacy.localAddr,
                                                                serverLegacy.remoteAddr,
                                                                4, 4, 4, 4)
    if IsErr(streamPairRes):
        return -18
    var clientStream = Value(streamPairRes).outbound
    var serverStream = Value(streamPairRes).inbound

    if IsErr(moqstream.Libp2pMoqSegmentStreamClientSendNegotiate(client, clientStream)):
        return -19
    if IsErr(moqstream.Libp2pMoqSegmentStreamServerNegotiate(listener, serverStream)):
        return -20
    if IsErr(moqstream.Libp2pMoqSegmentStreamClientReadNegotiateAck(client, clientStream)):
        return -21

    var request: moqstream.Libp2pMoqSegmentStreamRequest
    request.streamId = "harmony-video-first-frame"
    request.segmentKey = segmentKey
    request.offsetBytes = 0
    request.lengthBytes = rawbytes.BytesLen(segment)
    request.readChunkBytes = 257

    var reader: moqstream.Libp2pMoqSegmentStreamReader
    if IsErr(moqstream.Libp2pMoqSegmentStreamClientOpen(reader, clientStream, request)):
        return -22
    let serverServeRes = moqstream.Libp2pMoqSegmentStreamServerHandleRequestedRange(serverStream, segment)
    if IsErr(serverServeRes):
        return -23
    let readRes = chengMoqHarmonyReadAll(reader, 193)
    if IsErr(readRes):
        return -24
    let remoteBytes = Value(readRes)
    let fetchMs = times.MonotimeMs() - startMs

    moqstream.Libp2pMoqSegmentStreamClose(reader)
    qconn.ConnClose(serverStream)
    qconn.ConnClose(serverLegacy)
    qconn.ConnClose(clientLegacy)
    qtransport.Stop(listener)
    qtransport.Stop(client)

    if !chengMoqHarmonyBytesEq(remoteBytes, segment):
        return -2
    return fetchMs

# NAPI seam for the Harmony HAP: returns fetch latency ms (>=0) or a negative
# failure step code. The HAP's ArkTS UI shows this as the 秒开 result.
@exportc("cheng_moq_harmony_run")
fn chengMoqHarmonyRunExport(): int64 =
    return chengMoqHarmonyRunOnce(15610)

# Cross-device diagnostic: do a REAL QUIC dial to a remote publisher (the Android
# device on the LAN) and classify the exact failure so we learn why the in-app
# dial fails on OHOS. Returns 1 on dial success, or a negative class code.
fn chengMoqHarmonyDialRemoteOnce(host: str, port: int32): int64 =
    var client = qtransport.InitMsQuicTransport()
    var conn: qconn.Connection
    let dialRes = quic_transport.Libp2pQuicDialOneShotClientNamed(client, conn, host, port, "localhost")
    if IsErr(dialRes):
        let e: str = Error(dialRes)
        qtransport.Stop(client)
        if strutil.Contains(e, "bind lost"):
            return int64(0 - 1)
        if strutil.Contains(e, "datapath bind"):
            return int64(0 - 2)
        if strutil.Contains(e, "side"):
            return int64(0 - 3)
        if strutil.Contains(e, "session"):
            return int64(0 - 4)
        if strutil.Contains(e, "recv"):
            return int64(0 - 5)
        if strutil.Contains(e, "send"):
            return int64(0 - 6)
        if strutil.Contains(e, "timeout"):
            return int64(0 - 7)
        if strutil.Contains(e, "handshake"):
            return int64(0 - 8)
        if strutil.Contains(e, "active"):
            return int64(0 - 9)
        if strutil.Contains(e, "socket"):
            return int64(0 - 11)
        if strutil.Contains(e, "perm") || strutil.Contains(e, "EPERM"):
            return int64(0 - 12)
        var elen: int32 = e.len
        if elen > 200:
            elen = 200
        return int64(0 - (1000 + elen))
    qconn.ConnClose(conn)
    qtransport.Stop(client)
    return int64(1)

@exportc("cheng_moq_harmony_dial_remote")
fn chengMoqHarmonyDialRemoteExport(): int64 =
    return chengMoqHarmonyDialRemoteOnce("192.168.1.3", 38000)

# Desktop/standalone runner (ignored by the HAP --emit:obj link, which uses the
# @exportc entry). Validates the in-process pub+fetch transport + id-collision
# fix before OHOS packaging.
fn main(): int32 =
    let ms = chengMoqHarmonyRunOnce(15610)
    if ms < int64(0):
        echo(strutil.Join([" cheng_moq_harmony FAIL code=", IntToStr(int32(ms))], ""))
        return 1
    echo(strutil.Join([" cheng_moq_harmony ok fetch_ms=", IntToStr(int32(ms)), " bytes=15610 integrity-verified 秒发秒开"], ""))
    return 0
