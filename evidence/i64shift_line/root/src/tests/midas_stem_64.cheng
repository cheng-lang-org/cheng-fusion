    add(xq, -992)
    add(xq, -992)
    add(xq, -992)
    add(xq, -992)
    add(xq, -992)
    var out: int32[]
    for oc in 0..<32:
        for oy in 0..<32:
            for ox in 0..<32:
                var sum: int64
                var first: bool = true
                for ic in 0..<3:
                    for ky in 0..<3:
                        let iy: int32 = oy * 2 + ky
                        if iy < 64:
                            for kx in 0..<3:
                                let ix: int32 = ox * 2 + kx
                                if ix < 64:
                                    let term: int64 = int64(xq[(ic * 64 + iy) * 64 + ix]) * int64(wq[(oc * 27 + ic * 9) + ky * 3 + kx])
                                    if first:
                                        sum = term
                                        first = false
                                    else:
                                        sum = sum + term
                var r: int32 = int32(sum / 1000 + int64(bq[oc]))
                if r < 0:
                    r = 0
                if r > 6000:
                    r = 6000
                add(out, r)
    assert(out.len == 32768, "len")
    var total: int64
    var ssq: int64
    var cs: int64
    var seen: bool = false
    for ii in 0..<out.len:
        let v: int64 = int64(out[ii])
        if seen:
            total = total + v
            ssq = ssq + v * v
            cs = cs + v * int64(ii % 7 + 1)
        else:
            total = v
            ssq = v * v
            cs = v
            seen = true
    echo(Fmt"stem32 sum={total} sumsq={ssq} csum={cs}")
    return 0
