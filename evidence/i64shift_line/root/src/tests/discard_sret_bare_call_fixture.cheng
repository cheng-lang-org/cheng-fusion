var sideEffectCounter: int32

fn makeLabel(n: int32): str =
    sideEffectCounter = sideEffectCounter + n
    return "label"

fn runDiscards(): int32 =
    makeLabel(3)
    makeLabel(4)
    return sideEffectCounter

fn main(): int32 =
    let total = runDiscards()
    if total == 7:
        echo("discard_sret_bare_call_fixture ok")
        return 0
    return total
