import std/monotimes as monotimes
import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_dag

const
    FactCount = 50000
    KindCount = 5

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn factKind(index: int32): str =
    let selector = index % KindCount
    if selector == 0:
        return "csg.call"
    if selector == 1:
        return "csg.data"
    if selector == 2:
        return "csg.function"
    if selector == 3:
        return "csg.module"
    return "csg.symbol"

fn buildFacts(): str[] =
    var facts: str[]
    for i in 0..<FactCount:
        let ordinal = strings.IntToStr(i)
        let id = strings.ConcatStr("fact-", ordinal)
        let name = strings.ConcatStr("asset-", ordinal)
        let prefix = strings.ConcatStr(
            strings.ConcatStr("{\"id\":\"", id),
            strings.ConcatStr("\",\"kind\":\"", factKind(i)))
        let middle = strings.ConcatStr(
            strings.ConcatStr(prefix, "\",\"name\":\""),
            name)
        add(
            facts,
            strings.ConcatStr(
                strings.ConcatStr(middle, "\",\"ordinal\":"),
                strings.ConcatStr(ordinal, "}")))
    return facts

@borrows
fn factsAreCanonical(facts: str[]): bool =
    for i in 0..<facts.len:
        var error: str
        let canonicalFact =
            merkle_dag.CsgCoreMerkleCanonicalFact(
                facts[i], error)
        if error.len > 0 || canonicalFact != facts[i]:
            return false
    return true

@borrows
fn bytesEqual(left: rawbytes.Bytes, right: rawbytes.Bytes): bool =
    let length = rawbytes.BytesLen(left)
    if length != rawbytes.BytesLen(right):
        return false
    for i in 0..<length:
        if rawbytes.BytesGet(left, i) !=
           rawbytes.BytesGet(right, i):
            return false
    return true

@borrows
fn linesEqual(left: str[], right: str[]): bool =
    if left.len != right.len:
        return false
    for i in 0..<left.len:
        if left[i] != right[i]:
            return false
    return true

fn main(): int32 =
    let standard = "csg_core::v1"
    let profiles = ["csg_core"]
    let schemaNamespace = "csg_core::v1"
    let schemaCid =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    let facts = buildFacts()
    if facts.len != FactCount:
        return fail("csgc_encoder_memory_fact_count_mismatch")
    if !factsAreCanonical(facts):
        return fail("csgc_encoder_memory_noncanonical_fact")

    let inputDag = merkle_dag.CsgCoreMerkleBuildBound(
        facts,
        standard,
        profiles,
        schemaNamespace,
        schemaCid)
    if !inputDag.ok || inputDag.factCount != FactCount ||
       inputDag.entryKeys.len != FactCount ||
       inputDag.factsRoot.len != 71:
        return fail("csgc_encoder_memory_distinct_facts_failed")

    let encodeStartedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let first = csgc.CsgCoreCsgcEncodeCanonicalLines(facts)
    let firstEncodeElapsedMs =
        (monotimes.MonoTimeNs(monotimes.GetMonoTime()) -
         encodeStartedNs) / 1000000
    if !first.ok || first.factCount != FactCount:
        return fail("csgc_encoder_memory_first_encode_failed")

    let second = csgc.CsgCoreCsgcEncodeCanonicalLines(facts)
    if !second.ok || second.factCount != FactCount ||
       !bytesEqual(first.bytes, second.bytes):
        return fail("csgc_encoder_memory_repeat_bytes_mismatch")
    rawbytes.BytesFree(second.bytes)

    let decodeStartedNs =
        monotimes.MonoTimeNs(monotimes.GetMonoTime())
    let decoded = csgc.CsgCoreCsgcDecodeLines(first.bytes)
    let decodeElapsedMs =
        (monotimes.MonoTimeNs(monotimes.GetMonoTime()) -
         decodeStartedNs) / 1000000
    if !decoded.ok || decoded.factCount != FactCount ||
       decoded.lines.len != FactCount:
        return fail("csgc_encoder_memory_decode_failed")

    let decodedDag = merkle_dag.CsgCoreMerkleBuildBound(
        decoded.lines,
        standard,
        profiles,
        schemaNamespace,
        schemaCid)
    if !decodedDag.ok ||
       decodedDag.factsRoot != inputDag.factsRoot:
        return fail("csgc_encoder_memory_facts_root_mismatch")

    let physical = merkle_dag.CsgCoreMerklePhysicalOrder(facts)
    if !physical.ok ||
       !linesEqual(physical.canonicalLines, decoded.lines):
        return fail("csgc_encoder_memory_roundtrip_bytes_changed")

    let csgcBytes = rawbytes.BytesLen(first.bytes)
    if csgcBytes <= 64:
        return fail("csgc_encoder_memory_size_invalid")
    os.WriteLine(
        os.Get_stdout(),
        Fmt"csgc_encoder_memory fact_count={FactCount} kind_count={KindCount} csgc_bytes={csgcBytes} encode_runs=2 byte_identical=true facts_root={inputDag.factsRoot} encode_ms={firstEncodeElapsedMs} decode_ms={decodeElapsedMs}")
    rawbytes.BytesFree(first.bytes)
    return 0
