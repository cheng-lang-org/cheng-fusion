import std/cmdline
import std/os
import std/result
import std/strings
import std/strutils as strutil
import std/crypto/hash256
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

@borrows
fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

@borrows
fn CidEvidenceRead(path: str,
                   out: var str): Result[bool] =
    let readRes = os.ReadFileResult(path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    out = Value(readRes)
    if out == "":
        return Err[bool](CidEvidenceJoin([
            "CID evidence: empty mirror plan predecessor: ",
            strings.CloneStr(path)]))
    return Ok[bool](true)

@borrows
fn CidEvidenceCheckAndWrite(
        actual: str,
        expectedPath: str,
        workRoot: str,
        label: str,
        role: str): Result[bool] =
    var expected = ""
    let expectedRes = CidEvidenceRead(expectedPath, expected)
    if IsErr(expectedRes):
        return Err[bool](Error(expectedRes))
    if actual != expected:
        return Err[bool](CidEvidenceJoin([
            "CID evidence: full plan/migration mismatch: ",
            strings.CloneStr(label),
            "/",
            strings.CloneStr(role)]))
    os.WriteFile(
        chengpath.PathJoin(
            workRoot,
            CidEvidenceJoin([
                "mirror-plan-",
                strings.CloneStr(label),
                "-",
                strings.CloneStr(role),
                ".kv"])),
        actual)
    return Ok[bool](true)

@borrows
fn CidEvidenceReportValueInto(
        reportText: str,
        key: str,
        out: var str,
        err: var str): bool =
    let prefix = CidEvidenceJoin([strings.CloneStr(key), "="])
    let lines = strutil.Split(reportText, '\n')
    var found = false
    for lineIndex in 0..<lines.len:
        let line = lines[lineIndex]
        if !strutil.StartsWith(line, prefix):
            continue
        if found || line.len <= prefix.len:
            err = CidEvidenceJoin([
                "CID evidence: invalid candidate report field: ",
                strings.CloneStr(key)])
            return false
        out = strings.CloneStr(strings.SliceBytes(
            line, prefix.len, line.len - prefix.len))
        found = true
    if !found:
        err = CidEvidenceJoin([
            "CID evidence: missing candidate report field: ",
            strings.CloneStr(key)])
        return false
    err = ""
    return true

@borrows
fn CidEvidenceReportExpect(
        reportText: str,
        key: str,
        expected: str,
        err: var str): bool =
    var actual: str
    if !CidEvidenceReportValueInto(share(reportText), key, actual, err):
        return false
    if actual != expected:
        err = CidEvidenceJoin([
            "CID evidence: candidate report binding mismatch: ",
            strings.CloneStr(key)])
        return false
    err = ""
    return true

@borrows
fn CidEvidenceReportFixed32Into(
        reportText: str,
        key: str,
        out: var layout.FixedBytes32,
        err: var str): bool =
    var value: str
    if !CidEvidenceReportValueInto(reportText, key, value, err):
        return false
    let parsed = layout.FixedBytes32FromHex(value)
    if IsErr(parsed):
        err = CidEvidenceJoin([
            "CID evidence: invalid candidate report fixed32: ",
            strings.CloneStr(key)])
        return false
    out = Value(parsed)
    err = ""
    return true

@borrows
fn CidEvidencePlanBinding(
        workspaceRoot: str,
        outputPath: str,
        compileReportPath: str,
        expectedCsgPath: str,
        expectedSemanticPath: str,
        expectedSurfacePath: str,
        workRoot: str,
        label: str): Result[bool] =
    let ownedWorkspaceRoot = strings.CloneStr(workspaceRoot)
    let sourcePath = chengpath.PathJoin(
        strings.CloneStr(ownedWorkspaceRoot), "src/main.cheng")
    let request = creq.CompilerRequestNew(
        strings.CloneStr(ownedWorkspaceRoot),
        sourcePath,
        strings.CloneStr(outputPath),
        "x86_64-unknown-linux-gnu",
        creq.EmitExe,
        "")
    var err = ""
    var plan: slplan.SystemLinkPlanStub
    if !slplan.BuildSystemLinkPlanStub(
            strings.CloneStr(ownedWorkspaceRoot), request, plan, err):
        return Err[bool](err)
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(plan)
    if IsErr(sourceBundleRes):
        return Err[bool](Error(sourceBundleRes))
    if plan.sourceBundleEntrySourceIndex < 0 ||
       plan.sourceBundleEntrySourceIndex >= plan.ownerModulePaths.len:
        return Err[bool]("CID evidence: mirror plan entry source index")
    var sourceIdentityReceipt: ccsg.PortableSourceIdentityReceipt
    if !ccsg.PortableSourceIdentityReceiptMakeInto(
            plan.sourceClosurePaths.len,
            plan.importEdges.len,
            plan.unresolvedImportCount,
            plan.packageId,
            plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
            plan.sourceBundleCidValue,
            plan.sourceBundleEntrySourceCid,
            plan.sourceBundleImportGraphCid,
            sourceIdentityReceipt,
            err):
        return Err[bool](err)
    if !layout.FixedBytes32Equal(
            Value(sourceBundleRes), sourceIdentityReceipt.sourceBundleCid):
        return Err[bool]("CID evidence: mirror plan source bundle receipt")
    var providers: str[]
    if !sexec.SystemLinkExecCanonicalProviderSetInto(
            plan.providerModules, providers, err):
        return Err[bool](err)
    let symbolVisibility = strings.CloneStr(plan.symbolVisibility)
    var compilerCsg: ccsg.CompilerCsg
    var consumedPlan = plan
    if !ccsg.BuildCompilerCsgConsumePortableReceiptInto(
            compilerCsg, err, consumedPlan, sourceIdentityReceipt):
        return Err[bool](err)
    let canonicalOutputDigest = sexec.SystemLinkExecCanonicalOutputDigest(
        creq.EmitExe,
        symbolVisibility,
        request.targetTriple,
        providers,
        compilerCsg.canonicalGraphCid)
    var semanticReceipt: sexec.CompileSemanticReceipt
    if !sexec.SystemLinkExecCompileSemanticReceiptMakeInto(
            compilerCsg.sourceIdentityReceipt,
            compilerCsg,
            canonicalOutputDigest,
            request.targetTriple,
            "stage3_local",
            providers,
            semanticReceipt,
            err):
        return Err[bool](err)
    let sourceToCsgBindingSeal =
        sexec.SystemLinkExecSourceToCsgBindingSeal(
            compilerCsg.sourceIdentityReceipt.receiptCid,
            compilerCsg.canonicalGraphCid,
            semanticReceipt.receiptCid)
    let reportReadRes = os.ReadFileResult(strings.CloneStr(compileReportPath))
    if IsErr(reportReadRes):
        return Err[bool](Error(reportReadRes))
    let reportText = Value(reportReadRes)
    if !CidEvidenceReportExpect(
            reportText, "target", request.targetTriple, err) ||
       !CidEvidenceReportExpect(reportText, "emit", "exe", err) ||
       !CidEvidenceReportExpect(
            reportText,
            "source_bundle_cid",
            layout.FixedBytes32Hex(
                compilerCsg.sourceIdentityReceipt.sourceBundleCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "source_identity_receipt_cid",
            layout.FixedBytes32Hex(
                compilerCsg.sourceIdentityReceipt.receiptCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "canonical_compiler_csg_cid",
            layout.FixedBytes32Hex(compilerCsg.canonicalGraphCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "semantic_receipt_cid",
            layout.FixedBytes32Hex(semanticReceipt.receiptCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "source_to_csg_binding_seal",
            layout.FixedBytes32Hex(sourceToCsgBindingSeal),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_source_identity_receipt_cid",
            layout.FixedBytes32Hex(
                compilerCsg.sourceIdentityReceipt.receiptCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_semantic_receipt_cid",
            layout.FixedBytes32Hex(semanticReceipt.receiptCid),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_canonical_output_digest",
            layout.FixedBytes32Hex(canonicalOutputDigest),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_target",
            request.targetTriple,
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_bootstrap_stage",
            "stage3_local",
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_runtime_provider_count",
            strings.IntToStr(providers.len),
            err):
        return Err[bool](err)
    for providerIndex in 0..<providers.len:
        if !CidEvidenceReportExpect(
                reportText,
                CidEvidenceJoin([
                    "compile_receipt_runtime_provider.",
                    strings.IntToStr(providerIndex)]),
                providers[providerIndex],
                err):
            return Err[bool](err)
    let outputRes = os.ReadFileBytesResult(strings.CloneStr(outputPath))
    if IsErr(outputRes):
        return Err[bool](Error(outputRes))
    var outputBytes = Value(outputRes)
    let outputSha256 = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(outputBytes))
    if !CidEvidenceReportExpect(
            reportText,
            "output_sha256",
            layout.FixedBytes32Hex(outputSha256),
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_output_digest",
            layout.FixedBytes32Hex(outputSha256),
            err):
        return Err[bool](err)
    var worldHeadCid: layout.FixedBytes32
    if !CidEvidenceReportFixed32Into(
            reportText,
            "compile_receipt_world_head_cid",
            worldHeadCid,
            err):
        return Err[bool](err)
    var compileReceipt: ccsg.CompileReceipt
    if !ccsg.CompileReceiptMakeInto(
            worldHeadCid,
            compilerCsg.sourceIdentityReceipt.receiptCid,
            semanticReceipt.receiptCid,
            request.targetTriple,
            outputSha256,
            canonicalOutputDigest,
            "stage3_local",
            providers,
            compileReceipt,
            err) ||
       !CidEvidenceReportExpect(
            reportText,
            "compile_receipt_cid",
            layout.FixedBytes32Hex(compileReceipt.receiptCid),
            err):
        return Err[bool](err)
    var exportSurface: ccsg.CsgExportSurface
    ccsg.CompilerExportSurfaceFromCsgInto(compilerCsg, exportSurface)
    let csgRes = CidEvidenceCheckAndWrite(
        ccsg.CompilerCsgCanonicalSidecarReport(compilerCsg),
        strings.CloneStr(expectedCsgPath),
        strings.CloneStr(workRoot),
        strings.CloneStr(label),
        "csg")
    if IsErr(csgRes):
        return Err[bool](Error(csgRes))
    let semanticRes = CidEvidenceCheckAndWrite(
        sexec.SystemLinkExecCompileSemanticReceiptReport(
            semanticReceipt),
        strings.CloneStr(expectedSemanticPath),
        strings.CloneStr(workRoot),
        strings.CloneStr(label),
        "semantic")
    if IsErr(semanticRes):
        return Err[bool](Error(semanticRes))
    let surfaceRes = CidEvidenceCheckAndWrite(
        ccsg.CompilerExportSurfaceReport(exportSurface),
        strings.CloneStr(expectedSurfacePath),
        strings.CloneStr(workRoot),
        strings.CloneStr(label),
        "surface")
    if IsErr(surfaceRes):
        return Err[bool](Error(surfaceRes))
    ccsg.CompilerCsgReleaseBackendInputPayload(compilerCsg)
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var artifactRoot = ""
    var evidencePrefix = ""
    var workspaceRoot = ""
    var planOutput = ""
    var expectedCsg = ""
    var expectedSemantic = ""
    var expectedSurface = ""
    var bindingLabel = ""
    var compileReport = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix) ||
       !cmdline.readFlagValue("--workspace-root", workspaceRoot) ||
       !cmdline.readFlagValue("--plan-output", planOutput) ||
       !cmdline.readFlagValue("--expected-csg", expectedCsg) ||
       !cmdline.readFlagValue("--expected-semantic", expectedSemantic) ||
       !cmdline.readFlagValue("--expected-surface", expectedSurface) ||
       !cmdline.readFlagValue("--binding-label", bindingLabel) ||
       !cmdline.readFlagValue("--compile-report", compileReport) ||
       caseId != "mirror-atomic-install" || artifactRoot == "" ||
       evidencePrefix == "" || workspaceRoot == "" ||
       planOutput == "" || expectedCsg == "" ||
       expectedSemantic == "" || expectedSurface == "" ||
       bindingLabel == "" || compileReport == "":
        os.WriteLine(os.Get_stderr(),
                     "CID evidence: invalid mirror plan flags")
        return 2
    let result = CidEvidencePlanBinding(
        workspaceRoot,
        planOutput,
        compileReport,
        expectedCsg,
        expectedSemantic,
        expectedSurface,
        chengpath.PathParentDir(artifactRoot),
        bindingLabel)
    if IsErr(result):
        os.WriteLine(os.Get_stderr(), Error(result))
        return 1
    return 0
