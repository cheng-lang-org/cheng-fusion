# tier1-only: exact Tier1 shape from the ORC repro, nothing else held.
import std/system
import std/os
import std/rawbytes
import std/result
import std/strings as strings
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_bridge_fs as bfs
import std/bytes_layout as layout

type
    Tagged =
        value: layout.FixedBytes32

fn MissingPath(): str =
    return "/tmp/orc_repro_does_not_exist.bin"

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn Tier1(path: str): Result[bool] =
    let r = os.ReadFileBytesResult(path)
    if !r.ok:
        return Err[bool](r.err.msg)
    return Ok[bool](true)

fn main(): int32 =
    let t1 = Tier1(MissingPath())
    if t1.ok:
        echo("unexpected ok")
    else:
        echo("err propagated")
    echo("exit now")
    return 0
