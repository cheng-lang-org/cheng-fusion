# ORC runtime repro: MediaAssetBuildManifest on the real hgs asset succeeds
# (objects=90 droplets=5930) but teardown then dies with
#   cheng_orc_release_failure code=registry_miss operation=normal_release
#   detail=wrong_object_or_owner
# released ptr = a real heap allocation not found in the global mem registry.
#
# Established facts (2026-08-15, strict stage3 AND videogate-green, current src):
#  - build itself completes; the panic fires when the manifest/droplet str fields
#    (built by moqFountainObjectWorker threads) are released on the main thread.
#  - NOT a concurrency race: forcing thread.PoolNew(1) still crashes.
#  - NOT the manifest wire path: this repro never serializes the wire.
#  - Isolated probes (struct/str field by-value passes, ctor arg moves,
#    BytesFromString view chains) all pass — only the full fountain build trips it.
#  - lldb: panic <- cheng_mem_release with x0 = heap ptr absent from the registry.
#
# Run: build with any recent cheng, then execute with cwd = repo root.
import std/result
import std/os as os
import std/strutils as strutil
import cheng/moq/media_asset_manifest as media

fn main(): int32 =
    let posterRes = os.ReadFileBytesResult("src/tests/real_media_assets/hgs_poster.jpg")
    if IsErr(posterRes):
        os.WriteLine(os.Get_stderr(), "repro poster read failed")
        return 1
    let fileRes = os.ReadFileBytesResult("src/tests/real_media_assets/hgs_faststart.mp4")
    if IsErr(fileRes):
        os.WriteLine(os.Get_stderr(), "repro file read failed")
        return 1
    var buildReq: media.MediaAssetBuildRequest
    buildReq.blob = Value(fileRes)
    buildReq.ownerPeerId = "publisher-alpha"
    buildReq.remotePeersCsv = "subscriber-bravo"
    buildReq.mime = "video/mp4"
    buildReq.kindCode = media.MediaAssetKindVideo
    buildReq.durationMs = int64(22500)
    buildReq.codec = "h264/aac"
    buildReq.posterCid = media.MediaAssetSha256Hex(Value(posterRes))
    buildReq.initSegmentCid = "repro-init-cid"
    buildReq.initSegmentByteLength = 32
    buildReq.keyframeIndex = "mp4:mdat=1:first=1"
    buildReq.contentSignature = "repro-v1"
    buildReq.objectTargetBytes = 65536
    buildReq.sourceBlockBytes = 1024
    buildReq.repairDropletCount = 2
    let m = media.MediaAssetBuildManifest(buildReq)
    if IsErr(m):
        os.WriteLine(os.Get_stderr(), strutil.Join(["repro build err: ", Error(m)], ""))
        return 1
    let man = Value(m)
    os.WriteLine(os.Get_stderr(), strutil.Join(["repro build ok objects=", IntToStr(man.objects.len), " droplets=", IntToStr(man.droplets.len)], ""))
    return 0
