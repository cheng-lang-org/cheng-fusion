type
    R12Request =
        outputPath: str
        providerObjectPaths: str[]
        providerCanonicalPaths: str[]

fn R12Collect(n: int32, out: var str[]): bool =
    out = []
    for i in 0..<n:
        add(out, Fmt"canon_{i}")
    return true

fn R12Link(req: R12Request): int32 =
    return req.providerCanonicalPaths.len

fn R12Run(n: int32): int32 =
    var providerCanonicalPaths: str[]
    if !R12Collect(n, providerCanonicalPaths):
        return -1
    var request: R12Request
    request.outputPath = "out.exe"
    request.providerCanonicalPaths = share(providerCanonicalPaths)
    let linkedCount = R12Link(request)
    if linkedCount != providerCanonicalPaths.len:
        return -2
    return linkedCount

fn main(): int32 =
    let n = R12Run(3)
    if n != 3:
        return 10
    echo(Fmt"r12_seq ok n={n}")
    return 0
