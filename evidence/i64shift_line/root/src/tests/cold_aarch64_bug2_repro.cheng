# BUG#2 reproduction: tail `return <no-arg call>` after an if-branch.
# Mirrors program_support_backend.cheng cheng_safe_write_stream exactly:
#   fn cheng_safe_write_stream(stream: ptr): ptr =
#       if cheng_stream_looks_safe(stream):
#           return stream
#       return get_stdout()
# where get_stdout() returns a cached global ptr (fopen result).
#
# New test-only file; does not modify any existing main-workspace source.

@importc("repro_libc_fopen")
fn repro_libc_fopen(path: cstring, mode: cstring): ptr

var repro_stdio_out: ptr = nil

@exportc("repro_get_stdout")
fn repro_get_stdout(): ptr =
    if repro_stdio_out != nil:
        return repro_stdio_out
    repro_stdio_out = repro_libc_fopen("/dev/stdout", "w")
    return repro_stdio_out

@exportc("repro_stream_looks_safe")
fn repro_stream_looks_safe(stream: ptr): bool =
    if stream == nil:
        return false
    return uint64(stream) >= uint64(0x100000000)

@exportc("repro_safe_write_stream")
fn repro_safe_write_stream(stream: ptr): ptr =
    if repro_stream_looks_safe(stream):
        return stream
    return repro_get_stdout()

fn main(): int32 =
    return 0
