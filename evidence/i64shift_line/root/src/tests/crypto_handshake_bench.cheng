import std/crypto/ecnist as ecnist
import std/crypto/curve25519 as c25519
import std/crypto/bigint as bigint
import std/result
import std/rawbytes
import std/system
import std/strings
import std/strutils as strutil
import std/times as times

fn hexVal(c: int32): int32 =
    if c >= int32('0') && c <= int32('9'):
        return c - int32('0')
    if c >= int32('a') && c <= int32('f'):
        return c - int32('a') + 10
    if c >= int32('A') && c <= int32('F'):
        return c - int32('A') + 10
    return 0

fn bytesFromHex(h: str): Bytes =
    let n: int32 = strings.Len(h) / 2
    var b: Bytes = BytesAlloc(n)
    var i: int32
    while i < n:
        BytesSet(b, i, hexVal(int32(h[i * 2])) * 16 + hexVal(int32(h[i * 2 + 1])))
        i = i + 1
    return b

fn main(): int32 =
    # P-256 generator-based public key (valid on-curve point).
    let pkHex: str = "046B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C2964FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F5"
    var pk: Bytes = bytesFromHex(pkHex)
    var pubFixed: ecnist.EcPointFixed
    let parseRes: Result[bool] = ecnist.EcdsaParsePublicKeyPointFixedBytes(pk, true, pubFixed)
    if IsErr(parseRes):
        echo("parse pubkey failed")
        return 1
    # 32-byte message hash + 64-byte signature (r||s), non-zero so the verifier
    # runs the full u1*G + u2*Q scalar-mult path (result is "invalid", timing only).
    var msg: Bytes = BytesAlloc(32)
    var sig: Bytes = BytesAlloc(64)
    var k: int32
    while k < 32:
        BytesSet(msg, k, (k * 7 + 3) & 255)
        k = k + 1
    var s: int32
    while s < 64:
        BytesSet(sig, s, (s * 11 + 5) & 255)
        s = s + 1

    let N: int32 = 100

    # --- (1) full P-256 ECDSA verify ---
    var t0: int64 = times.MonotimeNs()
    var i1: int32
    var acc1: int32
    while i1 < N:
        let ok: bool = ecnist.ecdsaVerifyFixedPointSignatureBytes(pubFixed, msg, sig)
        if ok:
            acc1 = acc1 + 1
        i1 = i1 + 1
    var t1: int64 = times.MonotimeNs()
    echo(strutil.Join(["ECDSA-P256-verify: ", IntToStr(int32((t1 - t0) / int64(N) / int64(1000))), " us/op  (", IntToStr(N), " ops)"], ""))

    # --- (2) X25519 scalar mult (public-from-private) ---
    var priv: Bytes = BytesAlloc(32)
    var p: int32
    while p < 32:
        BytesSet(priv, p, (p * 13 + 1) & 255)
        p = p + 1
    t0 = times.MonotimeNs()
    var i2: int32
    var acc2: int32
    while i2 < N:
        let pubRes: Result[Bytes] = c25519.curve25519PublicFromPrivate(priv)
        if IsOk(pubRes):
            acc2 = acc2 + 1
        i2 = i2 + 1
    t1 = times.MonotimeNs()
    echo(strutil.Join(["X25519-scalarmult:  ", IntToStr(int32((t1 - t0) / int64(N) / int64(1000))), " us/op"], ""))

    # --- (3) bigint modular inverse (P-256 prime field) ---
    let pPrimeRes: Result[bigint.BigInt] = bigint.bigFromBytes(bytesFromHex("FFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF"))
    let aRes: Result[bigint.BigInt] = bigint.bigFromBytes(bytesFromHex("6B17D1F2E12C4247F8BCE6E563A440F277037D812DEB33A0F4A13945D898C296"))
    if IsOk(pPrimeRes) && IsOk(aRes):
        let pPrime: bigint.BigInt = Value(pPrimeRes)
        let aVal: bigint.BigInt = Value(aRes)
        t0 = times.MonotimeNs()
        var i3: int32
        var acc3: int32
        while i3 < N:
            let invRes: Result[bigint.BigInt] = bigint.bigModInvOddBinary(aVal, pPrime)
            if IsOk(invRes):
                acc3 = acc3 + 1
            i3 = i3 + 1
        t1 = times.MonotimeNs()
        echo(strutil.Join(["bigModInv-256:      ", IntToStr(int32((t1 - t0) / int64(N) / int64(1000))), " us/op"], ""))
        # --- (4) bigint modular multiply ---
        let bRes: Result[bigint.BigInt] = bigint.bigFromBytes(bytesFromHex("FE342E2FE1A7F9B8EE7EB4A7C0F9E162BCE33576B315ECECBB6406837BF51F50"))
        if IsOk(bRes):
            let bVal: bigint.BigInt = Value(bRes)
            t0 = times.MonotimeNs()
            var i4: int32
            var acc4: int32
            while i4 < N * 10:
                let mRes: Result[bigint.BigInt] = bigint.bigModMul(aVal, bVal, pPrime)
                if IsOk(mRes):
                    acc4 = acc4 + 1
                i4 = i4 + 1
            t1 = times.MonotimeNs()
            echo(strutil.Join(["bigModMul-256:      ", IntToStr(int32((t1 - t0) / int64(N * 10) / int64(1000))), " us/op  acc=", IntToStr(acc1 + acc2 + acc3 + acc4 & 0xFF)], ""))
    return 0
