import std/system as system

type
    ColdManagedOwnerSession = ref object
        value: int32

    ColdManagedOwnerIr =
        session: ColdManagedOwnerSession

    ColdManagedOwnerWork =
        ir: ColdManagedOwnerIr

fn ColdManagedOwnerAttach(ir: var ColdManagedOwnerIr) =
    var session = new(ColdManagedOwnerSession)
    session.value = 7
    ir.session = session

fn main(): int32 =
    var work: ColdManagedOwnerWork
    ColdManagedOwnerAttach(work.ir)
    if work.ir.session == nil:
        return 1
    let ownerCount = system.memRefCount(work.ir.session)
    if ownerCount != 1:
        return 20 + ownerCount
    if work.ir.session.value != 7:
        return 2
    return 0
