type
    Pair =
        first: int32
        second: int32

    Wrap =
        inner: Pair
        tag: int32

fn localCopy(): int32 =
    var src: Pair
    src.first = 7
    src.second = 9
    let dst = src
    if dst.first != 7:
        return 3
    if dst.second != 9:
        return 4
    return 0

fn fieldPathCopy(): int32 =
    var w: Wrap
    w.inner.first = 100
    w.inner.second = 200
    w.tag = 5
    let p = w.inner
    if p.first != 100:
        return 5
    if p.second != 200:
        return 6
    return 0

fn assignLocalCopy(): int32 =
    var src: Pair
    src.first = 71
    src.second = 82
    var out: Pair
    out.first = 0
    out.second = 0
    out = src
    if out.first != 71:
        return 7
    if out.second != 82:
        return 8
    return 0

fn seqIndexCopy(): int32 =
    var items: Pair[]
    items = []
    var a: Pair
    a.first = 11
    a.second = 22
    add(items, a)
    var b: Pair
    b.first = 33
    b.second = 44
    add(items, b)
    let picked = items[1]
    if picked.first != 33:
        return 1
    if picked.second != 44:
        return 2
    let first = items[0]
    if first.first != 11:
        return 9
    if first.second != 22:
        return 10
    return 0

fn seqIndexAssign(): int32 =
    var items: Pair[]
    items = []
    var a: Pair
    a.first = 71
    a.second = 82
    add(items, a)
    var out: Pair
    out.first = 0
    out.second = 0
    out = items[0]
    if out.first != 71:
        return 13
    if out.second != 82:
        return 14
    return 0

fn runAll(): int32 =
    let r2 = localCopy()
    if r2 != 0:
        return r2
    let r3 = fieldPathCopy()
    if r3 != 0:
        return r3
    let r4 = assignLocalCopy()
    if r4 != 0:
        return r4
    let r5 = seqIndexCopy()
    if r5 != 0:
        return 100 + r5
    let r6 = seqIndexAssign()
    if r6 != 0:
        return 200 + r6
    return 0
