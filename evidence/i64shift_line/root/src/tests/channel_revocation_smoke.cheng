# libp2p P3 收尾片: 签名撤销记录闭环 (codec + 授权 + store admit + 新鲜度, 正典 §11.6 P3)。
# exe run 非 census: 断言失败即 abort 非零, 末行 "ok" 才打印。crypto 断言 DEFAULT-ON (无 env 逃生)。
#
# 正路径: 根钥自撤 (A=channelId, B=rootPub, signer=rootPub) → 真 ed25519 签 → verify-true →
#   RevocationVerify 授权过 (selfRoot) → encode 169B/tag 0x20 → decode 字段等 → store admit →
#   AuthzRevocationExists == true (sticky 存在性)。
# 负路径矩阵 (每条独立 rejectReason, 先证红):
#   - encode 拒非 32B signerPubKey
#   - decode 拒 线长非 169 / tag 非 0x20
#   - RevocationVerify 拒 签名篡改 (sig 翻字节)
#   - RevocationVerify 拒 无撤销权 (signer 非 A 根钥且无 recovery pin, 双否)
#   - store admit 新鲜度: epoch 回退 (低 epoch 重放) 拒 + 相等 epoch 拒 (严格单调)

import std/system
import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import std/crypto/sha512 as sha512
import std/crypto/ed25519/ref10 as ref10
import std/os as os
import std/strings as strings
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/authz_codec as authz
import cheng/libp2p/protocols/cas_source/channel_head/authz_store as store

# 手工造真 ed25519 keypair (keyPairFromSeed conditional-let miscompile, 绕开)。
fn deriveKeypair(seedv: int32, priv: var Bytes, pub: var Bytes) =
    var seed = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(seed, i, (seedv + i) & 255)
    var digest = sha512.Sha512Digest(seed)
    BytesSet(digest, 0, BytesGet(digest, 0) & 248)
    BytesSet(digest, 31, (BytesGet(digest, 31) & 63) | 64)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, BytesSlice(digest, 0, 32))
    pub = ref10.geP3ToBytes(r)
    priv = BytesConcat(seed, pub)

fn pubFixed(pub: Bytes): layout.FixedBytes32 =
    let r = layout.FixedBytes32FromBytes(pub)
    assert(!IsErr(r), " pubFixed 32B")
    return Value(r)

fn main(): int32 =
    let base = os.GetEnvDefault("TMPDIR", "/tmp") + "/cheng_channel_revocation_p3"
    let storeRoot = base + "/store"
    os.MkdirAll(base, 493)

    var rootPriv: Bytes
    var rootPub: Bytes
    deriveKeypair(31, rootPriv, rootPub)
    let channelId = head.ChannelIdForPubKey(rootPub)
    let rootPubFixed = pubFixed(rootPub)

    # 确定性起点: 清该 (channel,target) 的撤销 wire (sticky 库跨重跑残留)
    let cidHex = layout.FixedBytes32Hex(channelId)
    let tgtHex = rawbytes.BytesToHex(rootPub)
    let revPath = store.AuthzRevocationPath(storeRoot, cidHex, tgtHex)
    if os.FileExists(revPath):
        let _rm = os.RemoveFile(revPath)

    # ---- 正路径: 根钥自撤 ----
    var signRes = authz.AuthzRecordSign(authz.AuthzTagRevoke, rootPriv, channelId, rootPubFixed, int64(5), rootPub)
    assert(!IsErr(signRes), " 自撤 sign: " + Error(signRes))
    var rec = Value(signRes)
    assert(authz.AuthzRecordVerifySig(rec), " 自撤 verify-true")

    var zero: layout.FixedBytes32
    var authRes = authz.RevocationVerify(rec, false, zero)
    assert(!IsErr(authRes), " 自撤授权 (selfRoot): " + Error(authRes))

    var encRes = authz.AuthzRecordEncode(rec)
    assert(!IsErr(encRes), " 撤销 encode: " + Error(encRes))
    var wire = Value(encRes)
    assert(BytesLen(wire) == 169, " 撤销 wire = 169B")
    assert(BytesGet(wire, 0) == 0x20, " 撤销 tag 0x20")
    var decRes = authz.AuthzRecordDecode(wire, authz.AuthzTagRevoke)
    assert(!IsErr(decRes), " 撤销 decode: " + Error(decRes))
    var recb = Value(decRes)
    assert(recb.epoch == int64(5), " 撤销 decode epoch=5")
    assert(layout.FixedBytes32Equal(recb.a, channelId), " 撤销 decode A==channelId")
    assert(layout.FixedBytes32Equal(recb.b, rootPubFixed), " 撤销 decode B==rootPub")
    assert(rawbytes.BytesEqual(recb.signerPubKey, rootPub), " 撤销 decode signer==rootPub")
    var re = authz.AuthzRecordEncode(recb)
    assert(!IsErr(re), " 撤销 re-encode")
    assert(rawbytes.BytesEqual(wire, Value(re)), " 撤销 re-encode 字节逐字节精确")

    # ---- 正路径: store admit → 存在性 sticky ----
    assert(!store.AuthzRevocationExists(storeRoot, channelId, rootPub), " admit 前: 撤销集无该 (channel,target)")
    var admitRes = store.AuthzRevocationAdmit(storeRoot, rec)
    assert(!IsErr(admitRes), " 撤销 admit: " + Error(admitRes))
    assert(store.AuthzRevocationExists(storeRoot, channelId, rootPub), " admit 后: 撤销集有该 (channel,target) [先取撤销判据]")

    # ---- 负: encode 拒非 32B signerPubKey ----
    var badSigner = authz.AuthzRecordClone(rec)
    badSigner.signerPubKey = BytesAlloc(31)
    assert(IsErr(authz.AuthzRecordEncode(badSigner)), " 负: encode 拒 31B signerPubKey")

    # ---- 负: decode 拒 线长非 169 / tag 非 0x20 ----
    assert(IsErr(authz.AuthzRecordDecode(BytesSlice(wire, 0, 168), authz.AuthzTagRevoke)), " 负: decode 拒 168B 截断 (线长非 169)")
    var badTag = BytesAlloc(169)
    for i in 0..<169:
        BytesSet(badTag, i, BytesGet(wire, i))
    BytesSet(badTag, 0, 0x31)   # 冒充 rotation tag
    assert(IsErr(authz.AuthzRecordDecode(badTag, authz.AuthzTagRevoke)), " 负: decode 拒 tag 非 0x20")
    # 隔离对照: tag 恢复 0x20 → decode 过 (只 tag 变量触发拒绝)
    BytesSet(badTag, 0, 0x20)
    assert(!IsErr(authz.AuthzRecordDecode(badTag, authz.AuthzTagRevoke)), " 对照: tag 恢复 0x20 → decode 过")

    # ---- 负: RevocationVerify 拒 签名篡改 ----
    var tampered = authz.AuthzRecordClone(rec)
    var tamperSig = BytesAlloc(64)
    for i in 0..<64:
        BytesSet(tamperSig, i, BytesGet(rec.sig, i))
    BytesSet(tamperSig, 0, (BytesGet(tamperSig, 0) ^ 0x01) & 255)
    tampered.sig = tamperSig
    var tamperAuth = authz.RevocationVerify(tampered, false, zero)
    assert(IsErr(tamperAuth), " 负: RevocationVerify 拒 签名篡改")
    assert(Error(tamperAuth) == "revoke: 签名不匹配规范字节", " 负: 篡改 rejectReason 精确")

    # ---- 负: 无撤销权 (signer 非 A 根钥, 无 recovery pin, 双否) ----
    var otherPriv: Bytes
    var otherPub: Bytes
    deriveKeypair(99, otherPriv, otherPub)
    # A 仍是 rootPub 的 channelId, 但由 otherPub 真签 (sig 验得过) → selfRoot/recovery 双否
    var forgeSign = authz.AuthzRecordSign(authz.AuthzTagRevoke, otherPriv, channelId, rootPubFixed, int64(1), otherPub)
    assert(!IsErr(forgeSign), " 越权撤销 sign (sig 本身合法)")
    var forgeRec = Value(forgeSign)
    assert(authz.AuthzRecordVerifySig(forgeRec), " 越权撤销: sig 验得过 (但无权)")
    var noAuthRes = authz.RevocationVerify(forgeRec, false, zero)
    assert(IsErr(noAuthRes), " 负: RevocationVerify 拒 无撤销权 (双否)")
    assert(Error(noAuthRes) == "revoke: signer 对 channel 无撤销权", " 负: 无撤销权 rejectReason 精确")

    # ---- 负: store admit 新鲜度 (epoch 回退/相等拒) ----
    # 已 admit epoch=5; 现造 epoch=3 (低) → stale 拒
    var lowSign = authz.AuthzRecordSign(authz.AuthzTagRevoke, rootPriv, channelId, rootPubFixed, int64(3), rootPub)
    assert(!IsErr(lowSign), " 低 epoch sign")
    var lowAdmit = store.AuthzRevocationAdmit(storeRoot, Value(lowSign))
    assert(IsErr(lowAdmit), " 负: admit epoch=3 < 已存 5 → stale 拒")
    # epoch=5 相等 → 也拒 (严格单调)
    var eqAdmit = store.AuthzRevocationAdmit(storeRoot, rec)
    assert(IsErr(eqAdmit), " 负: admit epoch=5 == 已存 5 → stale 拒 (严格单调)")
    # epoch=7 (高) → 过 (新鲜前进)
    var hiSign = authz.AuthzRecordSign(authz.AuthzTagRevoke, rootPriv, channelId, rootPubFixed, int64(7), rootPub)
    assert(!IsErr(hiSign), " 高 epoch sign")
    var hiAdmit = store.AuthzRevocationAdmit(storeRoot, Value(hiSign))
    assert(!IsErr(hiAdmit), " 正: admit epoch=7 > 已存 5 → 前进过: " + Error(hiAdmit))

    echo(" channel_revocation_smoke ok")
    return 0
