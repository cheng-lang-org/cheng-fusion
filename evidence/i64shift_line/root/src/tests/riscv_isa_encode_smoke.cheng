import std/rawbytes
import std/strformat
import cheng/core/backend/riscv64_encode as rv
import cheng/core/backend/elf_riscv64_writer as elf64
import cheng/core/backend/elf_riscv32_writer as elf32
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/target_matrix as tmat

# Spec field extractors (unprivileged ISA bit layout). These numbers come
# from the RISC-V instruction formats, not from the encoder source.
@borrows
fn specOpcode(word: uint32): uint32 =
    return word & uint32(127)

@borrows
fn specRd(word: uint32): int32 =
    return int32((word >> 7) & uint32(31))

@borrows
fn specFunct3(word: uint32): uint32 =
    return (word >> 12) & uint32(7)

@borrows
fn specRs1(word: uint32): int32 =
    return int32((word >> 15) & uint32(31))

@borrows
fn specRs2(word: uint32): int32 =
    return int32((word >> 20) & uint32(31))

@borrows
fn specFunct7(word: uint32): uint32 =
    return (word >> 25) & uint32(127)

@borrows
fn specIImm(word: uint32): int32 =
    let raw = int32((word >> 20) & uint32(4095))
    if (raw & 2048) != 0:
        return raw - 4096
    return raw

@borrows
fn specSImm(word: uint32): int32 =
    let lo = int32((word >> 7) & uint32(31))
    let hi = int32((word >> 25) & uint32(127))
    let raw = lo | (hi << 5)
    if (raw & 2048) != 0:
        return raw - 4096
    return raw

@borrows
fn specBImm(word: uint32): int32 =
    let imm12 = int32((word >> 31) & uint32(1))
    let imm10to5 = int32((word >> 25) & uint32(63))
    let imm4to1 = int32((word >> 8) & uint32(15))
    let imm11 = int32((word >> 7) & uint32(1))
    let raw = (imm4to1 << 1) | (imm10to5 << 5) | (imm11 << 11) | (imm12 << 12)
    if (raw & 4096) != 0:
        return raw - 8192
    return raw

@borrows
fn specJImm(word: uint32): int32 =
    let imm20 = int32((word >> 31) & uint32(1))
    let imm10to1 = int32((word >> 21) & uint32(1023))
    let imm11 = int32((word >> 20) & uint32(1))
    let imm19to12 = int32((word >> 12) & uint32(255))
    let raw = (imm10to1 << 1) | (imm11 << 11) | (imm19to12 << 12) | (imm20 << 20)
    if (raw & 1048576) != 0:
        return raw - 2097152
    return raw

@borrows
fn specFpFmt(word: uint32): uint32 =
    return (word >> 25) & uint32(3)

@borrows
fn u8At(buf: rawbytes.Bytes, off: int32): int32 =
    return rawbytes.BytesGet(buf, off) & 255

@borrows
fn u16le(buf: rawbytes.Bytes, off: int32): int32 =
    return u8At(buf, off) | (u8At(buf, off + 1) << 8)

@borrows
fn u32le(buf: rawbytes.Bytes, off: int32): int32 =
    return u8At(buf, off) | (u8At(buf, off + 1) << 8) | (u8At(buf, off + 2) << 16) | (u8At(buf, off + 3) << 24)

@borrows
fn expectWord(label: str, word: uint32, opcode: uint32, funct3: uint32, rd: int32, rs1: int32, rs2: int32) =
    assert(specOpcode(word) == opcode, label)
    assert(specFunct3(word) == funct3, label)
    assert(specRd(word) == rd, label)
    assert(specRs1(word) == rs1, label)
    if rs2 >= 0:
        assert(specRs2(word) == rs2, label)

@borrows
fn buildText(words: uint32[]): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(16)
    for i in 0..<words.len:
        obuf.ObjectBufferWriteU32LE(out, uint64(words[i]))
    return obuf.ObjectBufferTakeBytes(out)

fn buildMainSyms(): osym.ObjectSymbolTable =
    var out = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(out, "main", 0, int64(0), int64(12), true) == 0,
           " riscv isa encode: symbol")
    return out

fn main(): int32 =
    let xlen64 = 64
    let xlen32 = 32
    let rd = 10
    let rs1 = 11
    let rs2 = 12

    # Spec opcodes (unprivileged ISA): OP-IMM=0010011, OP=0110011,
    # LOAD=0000011, STORE=0100011, BRANCH=1100011, JALR=1100111,
    # JAL=1101111, LUI=0110111. Compared after reconstructing fields
    # from the word; not imported from the encoder.
    let specOpImm = uint32(19)
    let specOp = uint32(51)
    let specLoad = uint32(3)
    let specStore = uint32(35)
    let specBranch = uint32(99)
    let specJalr = uint32(103)
    let specJal = uint32(111)
    let specLui = uint32(55)

    let addi = rv.rv64EncAddi(rd, rs1, 42)
    expectWord("addi", addi, specOpImm, uint32(0), rd, rs1, -1)
    assert(specIImm(addi) == 42, "addi imm")
    echo(Fmt"recon addi opcode={specOpcode(addi)} funct3={specFunct3(addi)} rd={specRd(addi)} rs1={specRs1(addi)} imm={specIImm(addi)}")

    let addiNeg = rv.rv64EncAddi(rd, rs1, 0 - 1)
    expectWord("addi-1", addiNeg, specOpImm, uint32(0), rd, rs1, -1)
    assert(specIImm(addiNeg) == 0 - 1, "addi negative imm")

    let addw = rv.rv64EncAdd(rd, rs1, rs2)
    expectWord("add", addw, specOp, uint32(0), rd, rs1, rs2)
    assert(specFunct7(addw) == uint32(0), "add funct7")
    echo(Fmt"recon add opcode={specOpcode(addw)} funct3={specFunct3(addw)} funct7={specFunct7(addw)} rd={specRd(addw)} rs1={specRs1(addw)} rs2={specRs2(addw)}")

    let subw = rv.rv64EncSub(rd, rs1, rs2)
    expectWord("sub", subw, specOp, uint32(0), rd, rs1, rs2)
    assert(specFunct7(subw) == uint32(32), "sub funct7")
    echo(Fmt"recon sub opcode={specOpcode(subw)} funct7={specFunct7(subw)}")

    let ld = rv.rv64EncLd(rd, rs1, 16)
    expectWord("ld", ld, specLoad, uint32(3), rd, rs1, -1)
    assert(specIImm(ld) == 16, "ld imm")
    echo(Fmt"recon ld opcode={specOpcode(ld)} funct3={specFunct3(ld)} rd={specRd(ld)} rs1={specRs1(ld)} imm={specIImm(ld)}")

    let sd = rv.rv64EncSd(rs2, rs1, 48)
    assert(specOpcode(sd) == specStore, "sd opcode")
    assert(specFunct3(sd) == uint32(3), "sd funct3")
    assert(specRs1(sd) == rs1, "sd rs1")
    assert(specRs2(sd) == rs2, "sd rs2")
    assert(specSImm(sd) == 48, "sd imm")
    echo(Fmt"recon sd opcode={specOpcode(sd)} funct3={specFunct3(sd)} rs1={specRs1(sd)} rs2={specRs2(sd)} imm={specSImm(sd)}")

    let lw = rv.rv64EncLw(rd, rs1, 8)
    expectWord("lw", lw, specLoad, uint32(2), rd, rs1, -1)
    assert(specIImm(lw) == 8, "lw imm")

    let sw = rv.rv64EncSw(rs2, rs1, 12)
    assert(specOpcode(sw) == specStore, "sw opcode")
    assert(specFunct3(sw) == uint32(2), "sw funct3")
    assert(specRs1(sw) == rs1, "sw rs1")
    assert(specRs2(sw) == rs2, "sw rs2")
    assert(specSImm(sw) == 12, "sw imm")

    let lui = rv.rv64EncLui(rd, 1)
    assert(specOpcode(lui) == specLui, "lui opcode")
    assert(specRd(lui) == rd, "lui rd")
    echo(Fmt"recon lui opcode={specOpcode(lui)} rd={specRd(lui)}")

    let jalRes = rv.rv64EncJal(1, int64(2048))
    assert(jalRes.ok, jalRes.err.msg)
    let jal = jalRes.value
    assert(specOpcode(jal) == specJal, "jal opcode")
    assert(specRd(jal) == 1, "jal rd")
    assert(specJImm(jal) == 2048, "jal imm")
    echo(Fmt"recon jal opcode={specOpcode(jal)} rd={specRd(jal)} imm={specJImm(jal)}")

    let jalr = rv.rv64EncJalr(0, 1, 0)
    expectWord("jalr", jalr, specJalr, uint32(0), 0, 1, -1)
    assert(specIImm(jalr) == 0, "jalr imm")
    echo(Fmt"recon jalr opcode={specOpcode(jalr)} funct3={specFunct3(jalr)} rd={specRd(jalr)} rs1={specRs1(jalr)}")

    let beqRes = rv.rv64EncBeq(rs1, rs2, int64(2048))
    assert(beqRes.ok, beqRes.err.msg)
    let beq = beqRes.value
    assert(specOpcode(beq) == specBranch, "beq opcode")
    assert(specFunct3(beq) == uint32(0), "beq funct3")
    assert(specRs1(beq) == rs1, "beq rs1")
    assert(specRs2(beq) == rs2, "beq rs2")
    assert(specBImm(beq) == 2048, "beq imm")
    echo(Fmt"recon beq opcode={specOpcode(beq)} funct3={specFunct3(beq)} rs1={specRs1(beq)} rs2={specRs2(beq)} imm={specBImm(beq)}")

    let addi64 = rv.RvEncAddiForXlen(xlen64, rd, rs1, 42)
    assert(addi64.ok, addi64.err.msg)
    assert(addi64.value == addi, "addi xlen64")
    let addi32 = rv.RvEncAddiForXlen(xlen32, rd, rs1, 42)
    assert(addi32.ok, addi32.err.msg)
    assert(addi32.value == addi, "addi xlen32")

    let add32 = rv.RvEncAddForXlen(xlen32, rd, rs1, rs2)
    assert(add32.ok, add32.err.msg)
    let sub32 = rv.RvEncSubForXlen(xlen32, rd, rs1, rs2)
    assert(sub32.ok, sub32.err.msg)
    let lw32 = rv.RvEncLwForXlen(xlen32, rd, rs1, 8)
    assert(lw32.ok, lw32.err.msg)
    let sw32 = rv.RvEncSwForXlen(xlen32, rs2, rs1, 12)
    assert(sw32.ok, sw32.err.msg)
    let jal32 = rv.RvEncJalForXlen(xlen32, 1, int64(8))
    assert(jal32.ok, jal32.err.msg)
    let jalr32 = rv.RvEncJalrForXlen(xlen32, 0, 1, 0)
    assert(jalr32.ok, jalr32.err.msg)
    let beq32 = rv.RvEncBeqForXlen(xlen32, rs1, rs2, int64(8))
    assert(beq32.ok, beq32.err.msg)
    let fadds = rv.RvEncFaddSForXlen(xlen32, 0, 1, 2)
    assert(fadds.ok, fadds.err.msg)
    assert(specOpcode(fadds.value) == uint32(0x53), "fadd.s opcode")
    assert(specFpFmt(fadds.value) == uint32(0), "fadd.s fmt=S")

    let ld32 = rv.RvEncLdForXlen(xlen32, rd, rs1, 16)
    assert(!ld32.ok, "ld must be rejected on XLEN=32")
    echo("reject xlen32 ld")
    let sd32 = rv.RvEncSdForXlen(xlen32, rs2, rs1, 24)
    assert(!sd32.ok, "sd must be rejected on XLEN=32")
    echo("reject xlen32 sd")
    let addiw32 = rv.RvEncAddiwForXlen(xlen32, rd, rs1, 1)
    assert(!addiw32.ok, "addiw / OP-IMM-32 must be rejected on XLEN=32")
    echo("reject xlen32 addiw")
    let addw32 = rv.RvEncAddwForXlen(xlen32, rd, rs1, rs2)
    assert(!addw32.ok, "addw / OP-32 must be rejected on XLEN=32")
    echo("reject xlen32 addw")
    let faddd32 = rv.RvEncFaddDForXlen(xlen32, 0, 1, 2)
    assert(!faddd32.ok, "fadd.d / fmt=D must be rejected on XLEN=32")
    echo("reject xlen32 fadd.d")

    let ld64 = rv.RvEncLdForXlen(xlen64, rd, rs1, 16)
    assert(ld64.ok, ld64.err.msg)
    assert(ld64.value == ld, "ld xlen64")
    let addiw64 = rv.RvEncAddiwForXlen(xlen64, rd, rs1, 1)
    assert(addiw64.ok, addiw64.err.msg)
    assert(specOpcode(addiw64.value) == uint32(0x1B), "addiw opcode")
    let addw64 = rv.RvEncAddwForXlen(xlen64, rd, rs1, rs2)
    assert(addw64.ok, addw64.err.msg)
    assert(specOpcode(addw64.value) == uint32(0x3B), "addw opcode")
    let faddd64 = rv.RvEncFaddDForXlen(xlen64, 0, 1, 2)
    assert(faddd64.ok, faddd64.err.msg)
    assert(specOpcode(faddd64.value) == uint32(0x53), "fadd.d opcode")
    assert(specFpFmt(faddd64.value) == uint32(1), "fadd.d fmt=D")

    assert(tmat.TargetIsLinuxRv64("riscv64-unknown-linux-gnu"), "triple rv64")
    assert(tmat.TargetIsEsp32S31("riscv32-esp32s31-none-elf"), "triple s31")
    assert(tmat.TargetIsEsp32S31("esp32s31"), "alias s31")
    assert(tmat.TargetIsElfObject("riscv32-esp32s31-none-elf"), "s31 elf")
    assert(tmat.TargetPrimaryObjectFormat("riscv32-esp32s31-none-elf") == "elf", "s31 format")
    assert(rv.RvIsaEsp32S31Xlen() == 32, "s31 xlen")

    var words64: uint32[]
    add(words64, addi)
    add(words64, addw)
    add(words64, jalr)
    var text64 = buildText(words64)
    defer:
        rawbytes.BytesFree(text64)
    var syms64 = buildMainSyms()
    var relocs64 = orel.ObjectRelocsInit()
    let obj64Res = elf64.ElfRv64TextObjectBytes(text64, syms64, relocs64)
    assert(obj64Res.ok, obj64Res.err.msg)
    var obj64 = obj64Res.value
    defer:
        rawbytes.BytesFree(obj64)
    assert(u8At(obj64, 0) == 0x7F, "elf64 mag0")
    assert(u8At(obj64, 1) == 69, "elf64 mag1")
    assert(u8At(obj64, 2) == 76, "elf64 mag2")
    assert(u8At(obj64, 3) == 70, "elf64 mag3")
    assert(u8At(obj64, 4) == 2, "elf64 class")
    assert(u8At(obj64, 5) == 1, "elf64 data")
    assert(u16le(obj64, 18) == 243, "elf64 em_riscv")

    var words32: uint32[]
    add(words32, addi32.value)
    add(words32, add32.value)
    add(words32, beq32.value)
    add(words32, jalr32.value)
    var text32 = buildText(words32)
    defer:
        rawbytes.BytesFree(text32)
    var i = 0
    while i + 4 <= rawbytes.BytesLen(text32):
        let insn = uint32(u32le(text32, i))
        let op = specOpcode(insn)
        let f3 = specFunct3(insn)
        if op == uint32(0x03) || op == uint32(0x23):
            assert(f3 != uint32(3), "rv32 text must not contain ld/sd")
        assert(op != uint32(0x1B), "rv32 text must not contain OP-IMM-32")
        assert(op != uint32(0x3B), "rv32 text must not contain OP-32")
        if op == uint32(0x53):
            assert(specFpFmt(insn) != uint32(1), "rv32 text must not contain fmt=D")
        i = i + 4
    var syms32 = buildMainSyms()
    var relocs32 = orel.ObjectRelocsInit()
    let obj32Res = elf32.ElfRv32TextObjectBytes(text32, syms32, relocs32)
    assert(obj32Res.ok, obj32Res.err.msg)
    var obj32 = obj32Res.value
    defer:
        rawbytes.BytesFree(obj32)
    assert(u8At(obj32, 0) == 0x7F, "elf32 mag0")
    assert(u8At(obj32, 1) == 69, "elf32 mag1")
    assert(u8At(obj32, 2) == 76, "elf32 mag2")
    assert(u8At(obj32, 3) == 70, "elf32 mag3")
    assert(u8At(obj32, 4) == 1, "elf32 class")
    assert(u8At(obj32, 5) == 1, "elf32 data")
    assert(u16le(obj32, 18) == 243, "elf32 em_riscv")
    # ELF32 e_flags at offset 36: RVC | single-float ABI (psABI).
    assert(u32le(obj32, 36) == (1 | 2), "elf32 e_flags rvc|single")

    echo("riscv_isa_encode_smoke=pass")
    return 0
