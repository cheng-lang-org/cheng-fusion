import std/atomic
import std/cmdline
import std/os
import std/rawbytes
import std/result
import std/strings
import std/system
import std/thread
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/merkle_store_codec

const
    FixtureCidA: str =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    FixtureCidB: str =
        "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    FixtureCidC: str =
        "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    FixtureCidD: str =
        "sha256:4444444444444444444444444444444444444444444444444444444444444444"
    FixtureCidE: str =
        "sha256:5555555555555555555555555555555555555555555555555555555555555555"
    FixtureBundleCid: str =
        "sha256:516e205491fc174dafe5867a9f3bec79709de6a58af97d202699195fe514dc06"
    FixtureOutputCid: str =
        "sha256:dacd9e21e830a7637c28a434e9183e3f37831cfb3b87c22fac6a89c6a9efc0db"
    FixturePlanDomain: str =
        "csg_core.production.system_link.plan_evidence.v1"
    FixtureRecordDomain: str =
        "cheng.runtime.held_exec.terminal_journal.record.v1"
    FixtureProjectedDomain: str =
        "cheng.runtime.held_exec.terminal_observation.projected_canonical.v1"

var
    raceReady: atomic.I32
    raceGo: atomic.I32
    raceResult0: atomic.I32
    raceResult1: atomic.I32
    raceDurable0: atomic.I32
    raceDurable1: atomic.I32
    raceSession: int32
    raceObservationOwner: int32
    raceBindOwner: int32
    racePermission0: int32
    racePermission1: int32
    racePermission2: int32
    racePermission3: int32
    raceProjectedCid: str
    raceRecordCanonical: str
    raceRecordReceiptCid: str

type
    FixtureTerminalJournalRecord =
        phase: int32
        decision: int32
        sessionCid: layout.FixedBytes32
        predecessorReceipt: layout.FixedBytes32
        claimReceipt: layout.FixedBytes32
        terminalReceipt: layout.FixedBytes32
        evidenceA: layout.FixedBytes32
        evidenceB: layout.FixedBytes32
        outputBytes: uint64
        workloadExitCode: int32
        childPid: int32
        childUid: uint32
        childGid: uint32
        receipt: layout.FixedBytes32
        observationCanonical: str

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn atomicIncrement(cell: atomic.I32) =
    let _ = atomic.AddI32(cell, 1)

fn raceCommit(worker: int32) =
    atomicIncrement(raceReady)
    while atomic.LoadI32(raceGo) == 0:
        thread.Yield()
    var bindOwner = raceBindOwner
    var permission0 = racePermission0
    var permission1 = racePermission1
    var permission2 = racePermission2
    var permission3 = racePermission3
    var durableAppendOwner: int32 = -1
    let committed =
        system.RuntimeHeldExecTerminalObservationCommitDurableAppendInto(
            bindOwner,
            raceSession,
            permission0,
            permission1,
            permission2,
            permission3,
            raceObservationOwner,
            raceProjectedCid,
            raceRecordCanonical,
            raceRecordReceiptCid,
            durableAppendOwner)
    if worker == 0:
        atomic.StoreI32(raceResult0, committed ? 1 : 0)
        atomic.StoreI32(raceDurable0, durableAppendOwner)
    else:
        atomic.StoreI32(raceResult1, committed ? 1 : 0)
        atomic.StoreI32(raceDurable1, durableAppendOwner)

fn raceCommit0() =
    raceCommit(0)

fn raceCommit1() =
    raceCommit(1)

fn requiredFlag(name: str): str =
    var value: str
    if !cmdline.readFlagValue(strings.CloneStr(name), value) ||
       value.len == 0:
        panic(strings.ConcatStr("missing required flag: ", name))
    return value

@borrows
fn cidDigest(cid: str): layout.FixedBytes32 =
    if cid.len != 71:
        panic("fixture CID length")
    let parsed = layout.FixedBytes32FromHex(
        strings.CloneStrRange(cid, 7, 64))
    if result.IsErr(parsed):
        panic("fixture CID parse")
    return result.Value(parsed)

fn cidFromDigest(digest: layout.FixedBytes32): str =
    return strings.ConcatStr("sha256:", layout.FixedBytes32Hex(digest))

@borrows
fn textU64(value: str, offset: int32): uint64 =
    if offset < 0 || offset > value.len - 8:
        panic("fixture u64 offset")
    var out: uint64
    for byteIndex in 0..<8:
        out = out |
            (uint64(value[offset + byteIndex]) << uint64(byteIndex * 8))
    return out

@borrows
fn textDigest(value: str, offset: int32): layout.FixedBytes32 =
    if offset < 0 || offset > value.len - 32:
        panic("fixture digest offset")
    var out: layout.FixedBytes32
    for byteIndex in 0..<32:
        out.data[byteIndex] = uint8(value[offset + byteIndex])
    return out

fn putU32(bytes: var rawbytes.Bytes, offset: int32, value: uint32) =
    for byteIndex in 0..<4:
        rawbytes.BytesSet(
            bytes,
            offset + byteIndex,
            int32((value >> uint32(byteIndex * 8)) & uint32(255)))

fn putU64(bytes: var rawbytes.Bytes, offset: int32, value: uint64) =
    for byteIndex in 0..<8:
        rawbytes.BytesSet(
            bytes,
            offset + byteIndex,
            int32((value >> uint64(byteIndex * 8)) & uint64(255)))

fn putDigest(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: layout.FixedBytes32) =
    for byteIndex in 0..<32:
        rawbytes.BytesSet(
            bytes, offset + byteIndex, int32(value.data[byteIndex]))

@borrows
fn encodeRecord(record: FixtureTerminalJournalRecord): rawbytes.Bytes =
    var bytes = rawbytes.BytesAlloc(512)
    rawbytes.BytesSet(bytes, 0, int32('C'))
    rawbytes.BytesSet(bytes, 1, int32('T'))
    rawbytes.BytesSet(bytes, 2, int32('J'))
    rawbytes.BytesSet(bytes, 3, int32('R'))
    putU32(bytes, 4, uint32(1))
    putU32(bytes, 8, uint32(record.phase))
    putU32(bytes, 12, uint32(record.decision))
    putDigest(bytes, 16, record.sessionCid)
    putDigest(bytes, 48, record.predecessorReceipt)
    putDigest(bytes, 80, record.claimReceipt)
    putDigest(bytes, 112, record.terminalReceipt)
    putDigest(bytes, 144, record.evidenceA)
    putDigest(bytes, 176, record.evidenceB)
    putU64(bytes, 208, record.outputBytes)
    putU32(bytes, 216, uint32(record.workloadExitCode))
    putU32(bytes, 220, uint32(record.childPid))
    putU32(bytes, 224, record.childUid)
    putU32(bytes, 228, record.childGid)
    putDigest(bytes, 232, record.receipt)
    if record.observationCanonical.len == 224:
        for byteIndex in 0..<224:
            rawbytes.BytesSet(
                bytes,
                264 + byteIndex,
                int32(record.observationCanonical[byteIndex]))
    return bytes

# This is the same complete CTJR RecordFinalize operation used by production:
# clear [232,264), hash the full 512-byte canonical including byteCount, then
# materialize the exact digest back into the receipt slot.
fn RecordFinalize(
        record: var FixtureTerminalJournalRecord): rawbytes.Bytes =
    record.receipt = layout.FixedBytes32()
    var unsignedBytes = encodeRecord(record)
    let receiptCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            FixtureRecordDomain, unsignedBytes)
    rawbytes.BytesFree(unsignedBytes)
    record.receipt = cidDigest(receiptCid)
    return encodeRecord(record)

fn buildPlanEvidenceInto(outBytes: var str, outCid: var str) =
    var bytes = rawbytes.BytesAlloc(643)
    rawbytes.BytesSet(bytes, 0, int32('C'))
    rawbytes.BytesSet(bytes, 1, int32('S'))
    rawbytes.BytesSet(bytes, 2, int32('P'))
    rawbytes.BytesSet(bytes, 3, int32('1'))
    for fieldIndex in 0..<9:
        for byteIndex in 0..<71:
            rawbytes.BytesSet(
                bytes,
                4 + fieldIndex * 71 + byteIndex,
                int32(FixtureCidA[byteIndex]))
    outCid = merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
        FixturePlanDomain, bytes)
    outBytes = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)

fn childMain(outputPath: str): int32 =
    let childOwner = system.RuntimeHeldExecChildCapsuleRoleOwner()
    if childOwner <= 0:
        return fail("child capsule owner missing")
    var bundleBytes: str
    let bundle = system.RuntimeHeldExecChildTakeBundleBytesInto(bundleBytes)
    if bundle.status != 1 || bundleBytes != "fixture-bundle" ||
       system.RuntimeHeldExecBundleDigestCid(bundle) != FixtureBundleCid:
        return fail("child bundle import failed")
    var planBytes: str
    var planCid: str
    buildPlanEvidenceInto(planBytes, planCid)
    var planReceiptCid: str
    var err: str
    if !system.RuntimeHeldExecChildBindPlanReceiptInto(
           planBytes, planCid, planReceiptCid, err):
        return fail(strings.ConcatStr("child plan bind failed: ", err))
    if !system.RuntimeHeldExecChildPublishOutputInto(
           FixtureOutputCid,
           FixtureCidB,
           "fixture-compile-receipt",
           outputPath,
           err):
        return fail(strings.ConcatStr("child output publish failed: ", err))
    var terminalReceiptCid: str
    if !system.RuntimeHeldExecChildFinishInto(
           childOwner, 0, FixtureCidC, terminalReceiptCid, err):
        return fail(strings.ConcatStr("child finish failed: ", err))
    if terminalReceiptCid.len != 71:
        return fail("child terminal receipt missing")
    return 0

fn openRoleTreeInto(
        parent: str,
        outTree: var os.AtomicTree,
        outRoleOwner: var int32,
        outExitPermission0: var int32,
        outExitPermission1: var int32,
        outExitPermission2: var int32,
        outExitPermission3: var int32,
        outReapPermission0: var int32,
        outReapPermission1: var int32,
        outReapPermission2: var int32,
        outReapPermission3: var int32,
        err: var str): bool =
    let openResult = os.AtomicTreeOpenVerifiedExclusiveOrAbsent(
        parent, "terminal-root")
    if result.IsErr(openResult):
        err = result.Error(openResult)
        return false
    let exclusive = result.Value(openResult)
    var absent = exclusive.tree
    if exclusive.kind != os.AtomicTreeExclusiveAbsent:
        if result.IsErr(os.AtomicTreeClose(absent)):
            panic("fixture existing exclusive root close failed")
        err = "fixture role root already exists"
        return false
    let beginResult = os.AtomicTreeBeginFromExclusiveAbsent(
        absent, "terminal-stage")
    if result.IsErr(beginResult):
        if absent != uint64(0) && result.IsErr(os.AtomicTreeClose(absent)):
            panic("fixture absent root close failed")
        err = result.Error(beginResult)
        return false
    if absent != uint64(0):
        panic("fixture absent root was not consumed")
    var transaction = result.Value(beginResult)
    var empty = rawbytes.EmptyBytes()
    if result.IsErr(os.AtomicTreeWriteExclusiveLeaseSync(
           transaction, "finished-upload.bin", empty)):
        if result.IsErr(os.AtomicTreeAbort(transaction)):
            panic("fixture finished inode abort failed")
        err = "fixture finished inode create"
        return false
    var decision = rawbytes.BytesAlloc(768)
    let decisionWrite = os.AtomicTreeWriteExclusiveLeaseSync(
        transaction, "decision-mirror.bin", decision)
    rawbytes.BytesFree(decision)
    if result.IsErr(decisionWrite):
        if result.IsErr(os.AtomicTreeAbort(transaction)):
            panic("fixture decision inode abort failed")
        err = "fixture decision inode create"
        return false
    let committed =
        os.AtomicTreeCommitExclusiveNoReplaceAndOpenVerified(transaction)
    if result.IsErr(committed):
        if transaction != uint64(0) &&
           result.IsErr(os.AtomicTreeAbort(transaction)):
            panic("fixture role tree commit abort failed")
        err = result.Error(committed)
        return false
    if transaction != uint64(0):
        panic("fixture role transaction was not consumed")
    outTree = result.Value(committed)
    let roleOpened = os.AtomicTreeOpenTerminalCapsuleRoleOwnerInto(
        outTree,
        outRoleOwner,
        outExitPermission0,
        outExitPermission1,
        outExitPermission2,
        outExitPermission3,
        outReapPermission0,
        outReapPermission1,
        outReapPermission2,
        outReapPermission3,
        err)
    if !roleOpened:
        if outRoleOwner > 0 &&
           !os.AtomicTreeTerminalCapsuleRoleOwnerAbort(outRoleOwner):
            panic("fixture partial capsule role owner abort failed")
        if result.IsErr(os.AtomicTreeClose(outTree)):
            panic("fixture role root close after open failure")
        outTree = uint64(0)
        return false
    return true

@borrows
fn buildRecord(
        phase: int32,
        decision: int32,
        sessionCid: str,
        predecessorCid: str,
        evidenceBCid: str,
        projectedCanonical: str,
        outputBytes: uint64,
        workloadExitCode: int32):
        FixtureTerminalJournalRecord =
    var projectedBytes = rawbytes.BytesFromString(projectedCanonical)
    let evidenceDomain = phase == 5 ?
        "cheng.runtime.held_exec.exit_observation.canonical.v1" :
        "cheng.runtime.held_exec.reap_observation.canonical.v1"
    let evidenceACid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            evidenceDomain, projectedBytes)
    var record: FixtureTerminalJournalRecord
    record.phase = phase
    record.decision = decision
    record.sessionCid = cidDigest(sessionCid)
    record.predecessorReceipt = cidDigest(predecessorCid)
    record.claimReceipt = textDigest(projectedCanonical, 88)
    record.terminalReceipt = textDigest(projectedCanonical, 152)
    record.evidenceA = cidDigest(evidenceACid)
    record.evidenceB = cidDigest(evidenceBCid)
    record.outputBytes = outputBytes
    record.workloadExitCode = workloadExitCode
    record.childPid = int32(textU64(projectedCanonical, 24))
    record.childUid = uint32(textU64(projectedCanonical, 32))
    record.childGid = uint32(textU64(projectedCanonical, 40))
    record.observationCanonical = strings.CloneStr(projectedCanonical)
    return record

fn finalizedRecordInto(
        record: var FixtureTerminalJournalRecord,
        outCanonical: var str,
        outReceiptCid: var str): bool =
    var bytes = RecordFinalize(record)
    if rawbytes.BytesLen(bytes) != 512:
        rawbytes.BytesFree(bytes)
        return false
    outCanonical = rawbytes.BytesToString(bytes)
    outReceiptCid = cidFromDigest(record.receipt)
    rawbytes.BytesFree(bytes)
    return outCanonical.len == 512 && outReceiptCid.len == 71

@borrows
fn rejectedMutation(
        mutation: int32,
        phase: int32,
        session: int32,
        bindOwner: var int32,
        permission0: var int32,
        permission1: var int32,
        permission2: var int32,
        permission3: var int32,
        observationOwner: int32,
        projectedCanonical: str,
        projectedCid: str,
        sessionCid: str,
        predecessorCid: str,
        evidenceBCid: str,
        outputBytes: uint64): bool =
    var record = buildRecord(
        phase,
        1,
        sessionCid,
        predecessorCid,
        evidenceBCid,
        projectedCanonical,
        outputBytes,
        0)
    if mutation == 0:
        record.sessionCid = cidDigest(FixtureCidD)
    elif mutation == 1:
        record.predecessorReceipt = cidDigest(FixtureCidD)
    elif mutation == 2:
        record.evidenceB = cidDigest(FixtureCidD)
    elif mutation == 3:
        record.outputBytes = outputBytes + uint64(1)
    elif mutation == 4:
        record.workloadExitCode = 1
    else:
        return false
    var canonical: str
    var receiptCid: str
    if !finalizedRecordInto(record, canonical, receiptCid):
        return false
    var durableAppendOwner: int32 = -1
    if system.RuntimeHeldExecTerminalObservationCommitDurableAppendInto(
           bindOwner,
           session,
           permission0,
           permission1,
           permission2,
           permission3,
           observationOwner,
           projectedCid,
           canonical,
           receiptCid,
           durableAppendOwner):
        return false
    return bindOwner > 0 &&
        (permission0 != 0 || permission1 != 0 ||
         permission2 != 0 || permission3 != 0) &&
        durableAppendOwner == -1

fn main(): int32 =
    # Must be the first operation: child CLAIM binds the untouched argv and
    # inherited credentialed channel before any managed fixture work.
    let heldImport = system.RuntimeHeldExecChildImport()
    if heldImport < 0:
        return fail("held-exec child import failed")
    let outputPath = requiredFlag("--output")
    if heldImport == 1:
        return childMain(outputPath)
    let parent = requiredFlag("--parent")

    var roleTree: os.AtomicTree
    var roleOwner: int32 = -1
    var exitPermission0: int32
    var exitPermission1: int32
    var exitPermission2: int32
    var exitPermission3: int32
    var reapPermission0: int32
    var reapPermission1: int32
    var reapPermission2: int32
    var reapPermission3: int32
    var err: str
    if !openRoleTreeInto(
           parent,
           roleTree,
           roleOwner,
           exitPermission0,
           exitPermission1,
           exitPermission2,
           exitPermission3,
           reapPermission0,
           reapPermission1,
           reapPermission2,
           reapPermission3,
           err):
        return fail(strings.ConcatStr("role tree failed: ", err))
    if (exitPermission0 == reapPermission0 &&
        exitPermission1 == reapPermission1 &&
        exitPermission2 == reapPermission2 &&
        exitPermission3 == reapPermission3):
        return fail("phase permissions aliased")
    var bundleOwner = system.RuntimeHeldExecParentSealBundleOwner(
        "fixture-bundle", FixtureBundleCid)
    if bundleOwner <= 0 ||
       !system.runtimeHeldExecTerminalCapsuleRoleBindBundleOwner(
           roleOwner, bundleOwner) || bundleOwner != -1:
        return fail("bundle role bind failed")

    var retainedFd: int32 = -1
    if !os.ProcessRegistryOpenReadOnlyFd(
           "/usr/libexec/cheng/csg-core-native",
           retainedFd,
           err):
        return fail(strings.ConcatStr("retained binary failed: ", err))
    let claim = system.RuntimeHeldExecParentBeginClaim(retainedFd, outputPath)
    let retainedClosed = os.CloseFdRaw(retainedFd) == 0
    if claim.status != 1 || claim.session <= 0 || !retainedClosed:
        return fail(strings.ConcatStr(
            "parent claim failed status=",
            strings.ConcatStr(
                strings.IntToStr(claim.status),
                strings.ConcatStr(
                    " error=",
                    strings.ConcatStr(
                        strings.IntToStr(claim.errorCode),
                        strings.ConcatStr(
                            " session=",
                            strings.ConcatStr(
                                strings.IntToStr(claim.session),
                                strings.ConcatStr(
                                    " retained_closed=",
                                    retainedClosed ? "1" : "0"))))))))
    let activated = system.RuntimeHeldExecParentActivateCapsuleOwner(
        claim.session, FixtureCidA, roleOwner)
    if activated.status != 1:
        return fail("parent activate failed")
    if system.RuntimeHeldExecParentFinishCapsuleOwner(
           claim.session, roleOwner, outputPath) != roleOwner:
        return fail("parent finish failed")
    var compileCanonical: str
    var finishedCanonical: str
    if !system.RuntimeHeldExecFinishedCompileReceiptExportCanonicalInto(
           roleOwner, compileCanonical) ||
       !system.RuntimeHeldExecFinishedProofExportCanonicalInto(
           roleOwner, finishedCanonical):
        return fail("parent finished projection failed")
    let decision = system.RuntimeHeldExecTerminalTransportSendDecision(
        roleOwner)
    if decision.status != 1:
        return fail("parent decision send failed")

    let exitObservationOwner =
        system.RuntimeHeldExecParentTerminalObserveExit(claim.session)
    var exitCanonical: str
    if exitObservationOwner <= 0 ||
       !system.RuntimeHeldExecTerminalObservationProjectCanonicalInto(
           claim.session, exitObservationOwner, exitCanonical):
        return fail("exit observation projection failed")
    var exitBytes = rawbytes.BytesFromString(exitCanonical)
    let exitProjectedCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            FixtureProjectedDomain, exitBytes)
    let outputBytes = uint64(14)
    var exitBindOwner: int32 = -1
    var exitCommit0: int32
    var exitCommit1: int32
    var exitCommit2: int32
    var exitCommit3: int32
    let copiedExitPermission0 = exitPermission0
    let copiedExitPermission1 = exitPermission1
    let copiedExitPermission2 = exitPermission2
    let copiedExitPermission3 = exitPermission3
    if !system.RuntimeHeldExecTerminalObservationBindDurablePrefixInto(
           roleOwner,
           claim.session,
           1,
           exitPermission0,
           exitPermission1,
           exitPermission2,
           exitPermission3,
           FixtureCidA,
           FixtureCidB,
           FixtureCidC,
           exitBindOwner,
           exitCommit0,
           exitCommit1,
           exitCommit2,
           exitCommit3):
        return fail("exit Bind failed")
    var replayExit0 = copiedExitPermission0
    var replayExit1 = copiedExitPermission1
    var replayExit2 = copiedExitPermission2
    var replayExit3 = copiedExitPermission3
    var replayBindOwner: int32 = -1
    var replayCommit0: int32
    var replayCommit1: int32
    var replayCommit2: int32
    var replayCommit3: int32
    if system.RuntimeHeldExecTerminalObservationBindDurablePrefixInto(
           roleOwner,
           claim.session,
           1,
           replayExit0,
           replayExit1,
           replayExit2,
           replayExit3,
           FixtureCidA,
           FixtureCidB,
           FixtureCidC,
           replayBindOwner,
           replayCommit0,
           replayCommit1,
           replayCommit2,
           replayCommit3):
        return fail("exit Bind replay accepted")
    for mutation in 0..<5:
        if !rejectedMutation(
               mutation,
               5,
               claim.session,
               exitBindOwner,
               exitCommit0,
               exitCommit1,
               exitCommit2,
               exitCommit3,
               exitObservationOwner,
               exitCanonical,
               exitProjectedCid,
               FixtureCidA,
               FixtureCidB,
               FixtureCidC,
               outputBytes):
            return fail("exit full-rehash mutation accepted")

    var exitRecord = buildRecord(
        5,
        1,
        FixtureCidA,
        FixtureCidB,
        FixtureCidC,
        exitCanonical,
        outputBytes,
        0)
    var exitRecordCanonical: str
    var exitRecordReceiptCid: str
    if !finalizedRecordInto(
           exitRecord, exitRecordCanonical, exitRecordReceiptCid):
        return fail("exit record finalize failed")
    raceReady = atomic.NewI32(0)
    raceGo = atomic.NewI32(0)
    raceResult0 = atomic.NewI32(-1)
    raceResult1 = atomic.NewI32(-1)
    raceDurable0 = atomic.NewI32(-1)
    raceDurable1 = atomic.NewI32(-1)
    raceSession = claim.session
    raceObservationOwner = exitObservationOwner
    raceBindOwner = exitBindOwner
    racePermission0 = exitCommit0
    racePermission1 = exitCommit1
    racePermission2 = exitCommit2
    racePermission3 = exitCommit3
    raceProjectedCid = strings.CloneStr(exitProjectedCid)
    raceRecordCanonical = strings.CloneStr(exitRecordCanonical)
    raceRecordReceiptCid = strings.CloneStr(exitRecordReceiptCid)
    let worker0 = thread.StartFn(raceCommit0)
    let worker1 = thread.StartFn(raceCommit1)
    while atomic.LoadI32(raceReady) != 2:
        thread.Yield()
    atomic.StoreI32(raceGo, 1)
    if !thread.JoinThread(worker0) || !thread.JoinThread(worker1):
        return fail("concurrent Commit join failed")
    let exitSuccessCount = atomic.LoadI32(raceResult0) +
        atomic.LoadI32(raceResult1)
    if exitSuccessCount != 1:
        return fail("concurrent Commit did not have exactly one winner")
    var exitDurableAppendOwner =
        atomic.LoadI32(raceResult0) == 1 ?
            atomic.LoadI32(raceDurable0) : atomic.LoadI32(raceDurable1)
    var movedExitObservation = exitObservationOwner
    var exitRetireOwner: int32 = -1
    if !system.RuntimeHeldExecTerminalObservationAckInto(
           claim.session,
           movedExitObservation,
           exitDurableAppendOwner,
           exitRetireOwner) || exitRetireOwner != -1:
        return fail("exit Ack failed")
    var duplicateRetireOwner: int32 = -1
    if system.RuntimeHeldExecTerminalObservationAckInto(
           claim.session,
           movedExitObservation,
           exitDurableAppendOwner,
           duplicateRetireOwner):
        return fail("exit double Ack accepted")

    let reapObservationOwner =
        system.RuntimeHeldExecParentTerminalReap(claim.session)
    var reapCanonical: str
    if reapObservationOwner <= 0 ||
       !system.RuntimeHeldExecTerminalObservationProjectCanonicalInto(
           claim.session, reapObservationOwner, reapCanonical):
        return fail("reap observation projection failed")
    var reapBytes = rawbytes.BytesFromString(reapCanonical)
    let reapProjectedCid =
        merkle_store_codec.CsgCoreMerkleStoreDomainBytesCid(
            FixtureProjectedDomain, reapBytes)
    let reapEvidenceBCid = cidFromDigest(exitRecord.evidenceA)
    var reapBindOwner: int32 = -1
    var reapCommit0: int32
    var reapCommit1: int32
    var reapCommit2: int32
    var reapCommit3: int32
    let copiedReapPermission0 = reapPermission0
    let copiedReapPermission1 = reapPermission1
    let copiedReapPermission2 = reapPermission2
    let copiedReapPermission3 = reapPermission3
    if !system.RuntimeHeldExecTerminalObservationBindDurablePrefixInto(
           roleOwner,
           claim.session,
           2,
           reapPermission0,
           reapPermission1,
           reapPermission2,
           reapPermission3,
           FixtureCidA,
           exitRecordReceiptCid,
           reapEvidenceBCid,
           reapBindOwner,
           reapCommit0,
           reapCommit1,
           reapCommit2,
           reapCommit3):
        return fail("reap Bind failed")
    var replayReap0 = copiedReapPermission0
    var replayReap1 = copiedReapPermission1
    var replayReap2 = copiedReapPermission2
    var replayReap3 = copiedReapPermission3
    if system.RuntimeHeldExecTerminalObservationBindDurablePrefixInto(
           roleOwner,
           claim.session,
           2,
           replayReap0,
           replayReap1,
           replayReap2,
           replayReap3,
           FixtureCidA,
           exitRecordReceiptCid,
           reapEvidenceBCid,
           replayBindOwner,
           replayCommit0,
           replayCommit1,
           replayCommit2,
           replayCommit3):
        return fail("reap Bind replay accepted")
    for mutation in 0..<5:
        if !rejectedMutation(
               mutation,
               6,
               claim.session,
               reapBindOwner,
               reapCommit0,
               reapCommit1,
               reapCommit2,
               reapCommit3,
               reapObservationOwner,
               reapCanonical,
               reapProjectedCid,
               FixtureCidA,
               exitRecordReceiptCid,
               reapEvidenceBCid,
               outputBytes):
            return fail("reap full-rehash mutation accepted")
    var reapRecord = buildRecord(
        6,
        1,
        FixtureCidA,
        exitRecordReceiptCid,
        reapEvidenceBCid,
        reapCanonical,
        outputBytes,
        0)
    var reapRecordCanonical: str
    var reapRecordReceiptCid: str
    if !finalizedRecordInto(
           reapRecord, reapRecordCanonical, reapRecordReceiptCid):
        return fail("reap record finalize failed")
    var reapDurableAppendOwner: int32 = -1
    if !system.RuntimeHeldExecTerminalObservationCommitDurableAppendInto(
           reapBindOwner,
           claim.session,
           reapCommit0,
           reapCommit1,
           reapCommit2,
           reapCommit3,
           reapObservationOwner,
           reapProjectedCid,
           reapRecordCanonical,
           reapRecordReceiptCid,
           reapDurableAppendOwner):
        return fail("reap Commit failed")
    var movedReapObservation = reapObservationOwner
    var retireOwner: int32 = -1
    if !system.RuntimeHeldExecTerminalObservationAckInto(
           claim.session,
           movedReapObservation,
           reapDurableAppendOwner,
           retireOwner) || retireOwner <= 0:
        return fail("reap Ack failed")
    var closeReadyOwner: int32 = -1
    if !system.RuntimeHeldExecTerminalRetireInto(
           retireOwner, closeReadyOwner) ||
       !system.RuntimeHeldExecTerminalCloseReadyConsume(closeReadyOwner):
        return fail("reap retire/CloseReady consume failed")
    if result.IsErr(os.AtomicTreeClose(roleTree)):
        return fail("role tree close failed")
    os.WriteLine(
        os.Get_stdout(),
        "PUBLIC_BIND_COMMIT_ACK_OK mutations=10 concurrent_winners=1 phases=2")
    return 0
