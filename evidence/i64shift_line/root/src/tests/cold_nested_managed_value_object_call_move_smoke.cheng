import std/system

type
    ColdManagedMoveLeaf = ref object
        value: int32

    ColdManagedMoveInner =
        leaf: ColdManagedMoveLeaf

    ColdManagedMoveOuter =
        inner: ColdManagedMoveInner

fn ColdManagedMoveMakeOuter(value: int32): ColdManagedMoveOuter =
    var out: ColdManagedMoveOuter
    out.inner.leaf = new(ColdManagedMoveLeaf)
    out.inner.leaf.value = value
    return out

fn ColdManagedMoveCallResultRefCount(): int32 =
    var moved = ColdManagedMoveMakeOuter(41)
    if moved.inner.leaf == nil || moved.inner.leaf.value != 41:
        return -1
    return memRefCount(moved.inner.leaf)

fn main(): int32 =
    let ownerCount = ColdManagedMoveCallResultRefCount()
    if ownerCount != 1:
        return 10 + ownerCount
    echo("cold_nested_managed_value_object_call_move_smoke: ok")
    return 0
