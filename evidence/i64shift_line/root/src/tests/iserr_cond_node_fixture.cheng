import std/result

fn classify(flag: int32): int32 =
    var r: Result[str]
    r = Ok[str]("payload")
    if flag == 0:
        r = Err[str]("boom")
    if IsErr(r):
        return 1
    return 2

fn main(): int32 =
    var bad: int32
    bad = 0
    if classify(1) == 1:
        bad = bad + 10
    if classify(0) == 2:
        bad = bad + 20
    if bad == 0:
        echo("iserr_cond_node_fixture ok")
    return bad
