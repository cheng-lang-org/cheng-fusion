import cheng/core/runtime/web_scene_runtime as scene

fn main(): int32 =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var source = -1
    var target = -1
    if !scene.WebSceneAddRoute(graph, "source", 100, 1, source):
        return 1
    if !scene.WebSceneAddRoute(graph, "target", 200, 1, target):
        return 2
    if !scene.WebSceneAddLayer(graph, source, 1, "chrome", 0):
        return 3
    if !scene.WebSceneAddLayer(graph, source, 3, "legacy", 2):
        return 4
    if !scene.WebSceneAddLayer(graph, target, 5, "chrome", 0):
        return 5
    if !scene.WebSceneAddLayer(graph, target, 6, "content", 1):
        return 6
    if !scene.WebSceneAddNode(graph, source, 100, 0, 2, "header", "", 1):
        return 7
    if !scene.WebSceneAddNode(graph, source, 300, 0, 2, "aside", "", 3):
        return 8
    if !scene.WebSceneAddNode(graph, target, 200, 0, 2, "header", "", 5):
        return 9
    if !scene.WebSceneAddNode(graph, target, 201, 0, 2, "main", "", 6):
        return 10
    if !scene.WebSceneAddPaintOpAt(graph, source, 100, 0, 0, 0, scene.WebScenePaintFill, Int64(1122867), 0, 320, 40, "", ""):
        return 11
    if !scene.WebSceneAddPaintOpAt(graph, source, 300, 0, 0, 40, scene.WebScenePaintFill, Int64(3355443), 0, 320, 40, "", ""):
        return 12
    if !scene.WebSceneAddPaintOpAt(graph, target, 200, 0, 0, 0, scene.WebScenePaintFill, Int64(1122867), 0, 320, 40, "", ""):
        return 13
    if !scene.WebSceneAddPaintOpAt(graph, target, 201, 0, 0, 40, scene.WebScenePaintFill, Int64(7833753), 0, 320, 280, "", ""):
        return 14

    var commands: scene.WebScenePaintCommandBuffer
    if !scene.WebSceneBuildRouteLayerPaintCommands(graph, source, 1, commands):
        return 15
    if !scene.WebSceneLayerCacheMarkValid(graph, source, 1, commands):
        return 16
    if !scene.WebSceneBuildRouteLayerPaintCommands(graph, source, 3, commands):
        return 17
    if !scene.WebSceneLayerCacheMarkValid(graph, source, 3, commands):
        return 18

    var plan: scene.WebSceneLayerTransitionPlan
    if !scene.WebSceneBuildRouteTransitionPlan(graph, source, target, plan):
        return 19
    var transitionFrame: scene.WebSceneCompositorFrame
    if !scene.WebSceneBuildCompositorFrameForRouteTransitionPlan(graph, plan, transitionFrame):
        return 20
    if scene.WebSceneCompositorLayerCount(transitionFrame) != 3:
        return 21
    if scene.WebSceneCompositorGpuCommandCount(transitionFrame) != 1:
        return 22

    var gpuFromFrame: scene.WebSceneGpuCommandBuffer
    if !scene.WebSceneBuildGpuCommandsFromCompositorFrame(transitionFrame, gpuFromFrame):
        return 23
    if scene.WebSceneGpuCommandCount(gpuFromFrame) != 1:
        return 24
    if scene.WebSceneGpuCommandLayerAt(gpuFromFrame, 0) != 6:
        return 25

    var layerBatch: int32[]
    var commandBatch: int32[]
    if !scene.WebSceneEncodeGpuCommandHostBatch(gpuFromFrame, commandBatch):
        return 47
    if commandBatch.len != scene.WebSceneGpuHostBatchStrideI32:
        return 48
    let transitionAction0 = scene.WebSceneCompositorLayerTransitionActionAt(transitionFrame, 0)
    let transitionAction1 = scene.WebSceneCompositorLayerTransitionActionAt(transitionFrame, 1)
    let transitionAction2 = scene.WebSceneCompositorLayerTransitionActionAt(transitionFrame, 2)
    if transitionAction0 != scene.WebSceneLayerTransitionReuse:
        return 49
    if transitionAction1 != scene.WebSceneLayerTransitionReplace:
        return 50
    if transitionAction2 != scene.WebSceneLayerTransitionDrop:
        return 51
    if scene.WebSceneCompositorFrameRouteAt(transitionFrame) != target:
        return 72
    if scene.WebSceneCompositorLayerRouteAt(transitionFrame, 0) != target || scene.WebSceneCompositorLayerIdAt(transitionFrame, 0) != 5:
        return 58
    if scene.WebSceneCompositorLayerRouteAt(transitionFrame, 1) != target || scene.WebSceneCompositorLayerIdAt(transitionFrame, 1) != 6:
        return 59
    if scene.WebSceneCompositorLayerRouteAt(transitionFrame, 2) != source || scene.WebSceneCompositorLayerIdAt(transitionFrame, 2) != 3:
        return 60
    if scene.WebSceneCompositorLayerCacheRouteAt(transitionFrame, 0) < 0 || scene.WebSceneCompositorLayerCacheLayerAt(transitionFrame, 0) <= 0:
        return 52
    if scene.WebSceneCompositorLayerCacheRouteAt(transitionFrame, 1) < 0 || scene.WebSceneCompositorLayerCacheLayerAt(transitionFrame, 1) <= 0:
        return 53
    if scene.WebSceneCompositorLayerCacheRouteAt(transitionFrame, 2) < 0 || scene.WebSceneCompositorLayerCacheLayerAt(transitionFrame, 2) <= 0:
        return 54
    if scene.WebSceneCompositorLayerCommandStartAt(transitionFrame, 0) != 0 || scene.WebSceneCompositorLayerCommandCountAt(transitionFrame, 0) != 0:
        return 55
    if scene.WebSceneCompositorLayerCommandStartAt(transitionFrame, 1) != 0 || scene.WebSceneCompositorLayerCommandCountAt(transitionFrame, 1) != 1:
        return 56
    if scene.WebSceneCompositorLayerCommandStartAt(transitionFrame, 2) != 1 || scene.WebSceneCompositorLayerCommandCountAt(transitionFrame, 2) != 0:
        return 57
    if scene.WebSceneCompositorLayerDirtyWidthAt(transitionFrame, 0) < 0 || scene.WebSceneCompositorLayerDirtyHeightAt(transitionFrame, 0) < 0:
        return 61
    if scene.WebSceneCompositorLayerDirtyWidthAt(transitionFrame, 1) < 0 || scene.WebSceneCompositorLayerDirtyHeightAt(transitionFrame, 1) < 0:
        return 62
    if scene.WebSceneCompositorLayerDirtyWidthAt(transitionFrame, 2) < 0 || scene.WebSceneCompositorLayerDirtyHeightAt(transitionFrame, 2) < 0:
        return 63
    if !scene.WebSceneEncodeCompositorFrameCommandsHostBatch(transitionFrame, commandBatch):
        return 65
    if commandBatch.len != scene.WebSceneGpuHostBatchStrideI32:
        return 66

    if !scene.WebSceneEncodeCompositorFrameHostBatch(transitionFrame, layerBatch, commandBatch):
        if layerBatch.len == 0:
            if commandBatch.len == scene.WebSceneGpuHostBatchStrideI32:
                return 73
            if commandBatch.len != 0:
                return 74
            return 69
        if layerBatch.len == scene.WebSceneCompositorHostLayerStrideI32:
            return 70
        if layerBatch.len == scene.WebSceneCompositorHostLayerStrideI32 * 2:
            return 71
        if layerBatch.len != scene.WebSceneCompositorHostLayerStrideI32 * 3:
            return 67
        if commandBatch.len != scene.WebSceneGpuHostBatchStrideI32:
            return 68
        return 26
    if layerBatch.len != scene.WebSceneCompositorHostLayerStrideI32 * 3:
        return 27
    if commandBatch.len != scene.WebSceneGpuHostBatchStrideI32:
        return 28
    if layerBatch[0] != scene.WebSceneLayerTransitionReuse:
        return 29
    if layerBatch[2] != 5 || layerBatch[3] != source || layerBatch[4] != 1:
        return 30
    let replaceBase = scene.WebSceneCompositorHostLayerStrideI32
    if layerBatch[replaceBase] != scene.WebSceneLayerTransitionReplace:
        return 31
    if layerBatch[replaceBase + 2] != 6 || layerBatch[replaceBase + 15] != 0 || layerBatch[replaceBase + 16] != 1:
        return 32

    var moveGraph: scene.WebSceneGraph
    scene.WebSceneGraphInit(moveGraph)
    var moveRoute = -1
    if !scene.WebSceneAddRoute(moveGraph, "move", 10, 1, moveRoute):
        return 33
    if !scene.WebSceneAddLayer(moveGraph, moveRoute, 1, "fixed", 0):
        return 34
    if !scene.WebSceneAddNode(moveGraph, moveRoute, 10, 0, 2, "nav", "", 1):
        return 35
    if !scene.WebSceneAddPaintOpAt(moveGraph, moveRoute, 10, 0, 10, 20, scene.WebScenePaintFill, Int64(123), 0, 50, 60, "", ""):
        return 36
    if !scene.WebSceneBuildRouteLayerPaintCommands(moveGraph, moveRoute, 1, commands):
        return 37
    if !scene.WebSceneLayerCacheMarkValid(moveGraph, moveRoute, 1, commands):
        return 38
    scene.WebSceneClearDirty(moveGraph)
    if !scene.WebSceneSetLayerOffset(moveGraph, moveRoute, 1, 0, -42):
        return 39
    if !scene.WebSceneInvalidateLayerCachesForDirtySpans(moveGraph):
        return 40
    var moveFrame: scene.WebSceneCompositorFrame
    if !scene.WebSceneBuildCompositorFrameForDirtySpan(moveGraph, 0, moveFrame):
        return 41
    if scene.WebSceneCompositorLayerTransitionActionAt(moveFrame, 0) != 0:
        return 64
    if !scene.WebSceneEncodeCompositorFrameHostBatch(moveFrame, layerBatch, commandBatch):
        return 42
    if layerBatch.len != scene.WebSceneCompositorHostLayerStrideI32:
        return 43
    if commandBatch.len != scene.WebSceneGpuHostBatchStrideI32:
        return 44
    if layerBatch[0] != 0 || layerBatch[2] != 1:
        return 45
    if layerBatch[7] != -42 || layerBatch[9] != -42 || layerBatch[16] != 1:
        return 46

    echo("web_scene_compositor_host_batch_smoke ok")
    return 0
