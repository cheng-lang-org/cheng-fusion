# W4 driver: pure-logic RFC 9002 reliability event simulation (no real
# network, no internal clock — the simulator owns time and feeds the module
# event interface QuicOnPacketSent / QuicOnAckFrame / QuicOnTimeout /
# QuicLossNextTimer with explicit timestamps).
#
# Judged here:
#  a. RFC 9002 Appendix A state-machine transition reachability: every
#     QuicT* id counted >= 1 across units + scenarios (Lost / Timeout / ACK
#     convergence paths), counts printed per id.
#  b. >= 6 scenarios (clean / 1% random loss / 5% random loss / burst loss
#     window / RTT step / zero-read backpressure), each reporting throughput,
#     retransmit rate, convergence time.
#  c. Invariants checked after every simulated event batch: packet numbers
#     never reused (monotonic assign + ring-slot guard), flow-control credit
#     never negative (gate + assertion), cwnd never decreases outside a loss
#     round.
#  d. Clean-run completion time within 5% of the closed-form newreno pipe
#     model (pure-logic overhead criterion: the recovery layer must not cost
#     the pipe anything measurable).
#
# ACK frames are always generated by recovery_ack and re-decoded through the
# W3a codec (frames_codec) before they enter QuicOnAckFrame — the W3a
# alignment runs inside every scenario, not just in units. Any failure
# exits non-zero.

import std/os
import std/rawbytes
import std/strings as strings
import cheng/quic/pure/frames_varint as quicvarint
import cheng/quic/pure/frames_codec as quicframe
import cheng/quic/pure/recovery_ack as rack
import cheng/quic/pure/recovery_loss as rloss
import cheng/quic/pure/recovery_cc as rcc
import cheng/quic/pure/recovery_fc as rfc

var gFails: int32

@borrows
fn fail(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("FAIL ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))
    gFails = gFails + 1

@borrows
fn pass(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))

fn minI64(a: int64, b: int64): int64 =
    if a < b:
        return a
    return b

fn maxI64(a: int64, b: int64): int64 =
    if a > b:
        return a
    return b

# ---------------- simulator state (module globals; re-inited per run) -------

var gLoss: rloss.QuicLossState
var gCc: rcc.QuicCc
var gFc: rfc.QuicFc
var gPeerSet: rack.QuicAckSet
var gPeerFc: rfc.QuicFc

# network knobs
var gPropUs: int64
var gProp2Us: int64
var gStepAtUs: int64
var gLossPct: int64
var gBurstStartUs: int64
var gBurstEndUs: int64
var gBackpressure: bool
var gAckDelayUs: int64
var gTargetBytes: int64
var gCapUs: int64
var gRng: int64

# time + counters
var gSimNow: int64
var gAckDue: int64
var gPn: int64
var gSentPkts: int64
var gRetransPkts: int64
var gProbePkts: int64
var gDelivered: int64
var gFreshOffset: int64
var gStalled: bool
var gCwndPrev: int64
var gLossRoundHadCC: bool
var gPersistentEvents: int64

# payload map by pn slot (pn < PayCap by construction, asserted)
const
    PayCap: int32 = 8192
    RqCap: int32 = 8192
    ArrCap: int32 = 8192
    MaxPacket: int64 = 1200

var gPayOff: int64[PayCap]
var gPaySize: int64[PayCap]
var gPayStream: int64[PayCap]

# retransmission queue of payload byte ranges (stream 0 in scenarios)
var gRqOff: int64[RqCap]
var gRqSize: int64[RqCap]
var gRqHead: int32
var gRqTail: int32

# pending arrivals, append-time ordered (one-way delay never decreases
# within a run; asserted at append)
var gArrPn: int64[ArrCap]
var gArrT: int64[ArrCap]
var gArrHead: int32
var gArrCount: int32

# accumulated Appendix-A transition coverage across units + scenarios (the
# modules re-init their own counters per unit, so the driver accumulates)
var gCovLoss: int64[22]
var gCovCc: int64[22]

fn rndPos(): int64 =
    gRng = gRng ^ (gRng << 13)
    gRng = gRng ^ quicvarint.QuicLshr64(gRng, 7)
    gRng = gRng ^ (gRng << 17)
    return gRng

fn resetSim(propUs: int64, lossPct: int64, burstStartUs: int64, burstEndUs: int64,
            stepAtUs: int64, prop2Us: int64, backpressure: bool, targetBytes: int64,
            fcWindow: int64) =
    rloss.QuicLossInit(gLoss)
    rcc.QuicCcInit(gCc)
    rfc.QuicFcInit(gFc, fcWindow, fcWindow, fcWindow)
    rfc.QuicFcInit(gPeerFc, fcWindow, fcWindow, fcWindow)
    rack.QuicAckSetInit(gPeerSet)
    gPropUs = propUs
    gProp2Us = prop2Us
    gStepAtUs = stepAtUs
    gLossPct = lossPct
    gBurstStartUs = burstStartUs
    gBurstEndUs = burstEndUs
    gBackpressure = backpressure
    gAckDelayUs = 8000
    gTargetBytes = targetBytes
    gCapUs = 60000000
    gSimNow = 0
    gAckDue = 0
    gPn = 0 - 1
    gSentPkts = 0
    gRetransPkts = 0
    gProbePkts = 0
    gDelivered = 0
    gFreshOffset = 0
    gStalled = false
    gCwndPrev = gCc.cwnd
    gLossRoundHadCC = false
    gPersistentEvents = 0
    gRqHead = 0
    gRqTail = 0
    gArrHead = 0
    gArrCount = 0
    var i: int32
    while i < PayCap:
        gPaySize[i] = 0 - 1
        i = i + 1

fn curProp(): int64 =
    if gSimNow >= gStepAtUs:
        return gProp2Us
    return gPropUs

fn decideLost(): bool =
    if gSimNow >= gBurstStartUs && gSimNow < gBurstEndUs:
        return true
    if gLossPct > 0:
        # logical shift first: int64 % keeps the sign, and a negative
        # remainder would read as "lost" (the 50%-loss bug)
        let r: int64 = quicvarint.QuicLshr64(rndPos(), 1) % 100
        if r < gLossPct:
            return true
    return false

fn appendArrival(pn: int64) =
    let t: int64 = gSimNow + curProp()
    if gArrCount >= ArrCap:
        fail("arrcap", "arrival list exhausted")
        return
    if gArrCount > gArrHead:
        let prev: int64 = gArrT[gArrCount - 1]
        if t < prev:
            fail("arrorder", "arrival times not monotonic")
            return
    gArrPn[gArrCount] = pn
    gArrT[gArrCount] = t
    gArrCount = gArrCount + 1

# Sends one packet of `size` payload bytes at stream 0 now. Records payload
# at the pn slot; retransmissions overwrite their slot with the same offset.
# Decides wire loss and schedules the arrival. bytesInFlight is charged at
# least one 1200B packet (a zero-payload probe is still ack-eliciting).
fn wireSend(pn: int64, size: int64, off: int64, stream: int64, isProbe: bool): bool =
    if pn >= int64(PayCap):
        fail("pncap", strings.Int64ToStr(pn))
        return false
    let slot: int32 = int32(pn)
    let rc: int32 = rloss.QuicOnPacketSent(gLoss, pn, size, true,
        isProbe, gSimNow)
    if rc != 0:
        fail("sent", strings.concatStr("QuicOnPacketSent rc=", strings.IntToStr(rc)))
        return false
    gPayOff[slot] = off
    gPaySize[slot] = size
    gPayStream[slot] = stream
    gSentPkts = gSentPkts + 1
    if isProbe:
        gProbePkts = gProbePkts + 1
    let lost: bool = decideLost()
    if !lost:
        appendArrival(pn)
    return true

fn pushRq(off: int64, size: int64) =
    if size <= 0:
        return
    if gRqTail >= RqCap:
        fail("rqcap", "retransmit queue exhausted")
        return
    gRqOff[gRqTail] = off
    gRqSize[gRqTail] = size
    gRqTail = gRqTail + 1

# Recovery declared losses -> requeue their payloads and apply the CC reset
# at most once per round.
fn drainLost() =
    var i: int32
    while i < gLoss.lastLostCount:
        let slot: int32 = int32(gLoss.lostPns[i] % int64(PayCap))
        pushRq(gPayOff[slot], gPaySize[slot])
        i = i + 1
    if gLoss.lastLostCount > 0:
        gLossRoundHadCC = true
        if gLoss.lastLostPersistent:
            gPersistentEvents = gPersistentEvents + 1
        rcc.QuicCcOnPacketsLost(gCc, gLoss.lastLostPersistent, gSimNow, gLoss.smoothRtt)
    gLoss.lastLostCount = 0

# Congestion window allows, flow control allows, fresh bytes remain.
fn sendOneFresh(): bool =
    let remaining: int64 = gTargetBytes - gFreshOffset
    if remaining <= 0:
        return false
    let n: int64 = minI64(MaxPacket, remaining)
    if gCc.cwnd - gLoss.bytesInFlight < n:
        return false
    if !rfc.QuicFcAllowSend(gFc, 0, n):
        return false
    if !rfc.QuicFcOnSent(gFc, 0, n):
        fail("fcsent", "OnSent refused after AllowSend")
        return false
    gPn = gPn + 1
    let off: int64 = gFreshOffset
    gFreshOffset = gFreshOffset + n
    if !wireSend(gPn, n, off, 0, false):
        gPn = gPn - 1
        gFreshOffset = off
        return false
    return true

fn sendOneRetrans(): bool =
    if gRqHead >= gRqTail:
        return false
    let n: int64 = gRqSize[gRqHead]
    if gCc.cwnd - gLoss.bytesInFlight < n:
        return false
    let off: int64 = gRqOff[gRqHead]
    gRqHead = gRqHead + 1
    gPn = gPn + 1
    gRetransPkts = gRetransPkts + 1
    if !wireSend(gPn, n, off, 0, false):
        gPn = gPn - 1
        gRetransPkts = gRetransPkts - 1
        gRqHead = gRqHead - 1
        return false
    return true

# PTO probe (RFC 9002 Section 7.5): recovery probes are not blocked by the
# congestion window. Requeued payload first, then fresh data (flow-control
# credit still applies to fresh bytes), else an ack-eliciting PING-sized
# packet (no payload, no flow-control charge).
fn sendProbeRetrans(): bool =
    if gRqHead >= gRqTail:
        return false
    let n: int64 = gRqSize[gRqHead]
    let off: int64 = gRqOff[gRqHead]
    gRqHead = gRqHead + 1
    gPn = gPn + 1
    gRetransPkts = gRetransPkts + 1
    if !wireSend(gPn, n, off, 0, true):
        gPn = gPn - 1
        gRetransPkts = gRetransPkts - 1
        gRqHead = gRqHead - 1
        return false
    return true

fn sendOneProbe(): bool =
    if sendProbeRetrans():
        gProbePkts = gProbePkts + 1
        return true
    let remaining: int64 = gTargetBytes - gFreshOffset
    if remaining > 0 && rfc.QuicFcAllowSend(gFc, 0, MaxPacket):
        if rfc.QuicFcOnSent(gFc, 0, MaxPacket):
            let off: int64 = gFreshOffset
            gFreshOffset = gFreshOffset + MaxPacket
            gPn = gPn + 1
            gProbePkts = gProbePkts + 1
            if !wireSend(gPn, MaxPacket, off, 0, true):
                gPn = gPn - 1
                gFreshOffset = off
                return false
            return true
    gPn = gPn + 1
    gProbePkts = gProbePkts + 1
    return wireSend(gPn, 0, 0, 0, true)

fn drainSends() =
    var progressed: bool = true
    while progressed:
        progressed = false
        if sendOneRetrans():
            progressed = true
        if sendOneFresh():
            progressed = true

# Peer receives one data packet: accumulates the ack set, consumes payload,
# may top up the sender's flow control (MAX_DATA / MAX_STREAM_DATA through
# real 0x10/0x11 frames via the W3a codec), schedules a deferred ack.
fn peerReceive(pn: int64) =
    let slot: int32 = int32(pn % int64(PayCap))
    let size: int64 = gPaySize[slot]
    rack.QuicAckSetAdd(gPeerSet, pn)
    if !gBackpressure && size > 0:
        rfc.QuicFcOnDeliveredConn(gPeerFc, size)
        rfc.QuicFcOnDeliveredStream(gPeerFc, 0, size)
        if rfc.QuicFcConnUpdateNeeded(gPeerFc):
            var bb: BytesBuilder = BytesBuilderNew(32)
            var f: quicframe.QuicFrame = quicframe.QuicFrameZero()
            f.ftype = quicframe.QuicFrameMaxData
            f.maximum = rfc.QuicFcConnProposeMax(gPeerFc)
            let wr: int32 = quicframe.QuicFrameAppend(bb, EmptyBytes(), f)
            if wr > 0:
                let buf: Bytes = BytesBuilderFinish(bb)
                var d: quicframe.QuicFrame = quicframe.QuicFrameZero()
                let nx: int32 = quicframe.QuicFrameDecodeAt(buf, 0, d)
                if nx != buf.len || d.ftype != quicframe.QuicFrameMaxData:
                    fail("maxdata-wire", "frame did not round-trip")
                else:
                    rfc.QuicFcOnMaxData(gFc, d.maximum)
        if rfc.QuicFcStreamUpdateNeeded(gPeerFc, 0):
            var bb2: BytesBuilder = BytesBuilderNew(32)
            var f2: quicframe.QuicFrame = quicframe.QuicFrameZero()
            f2.ftype = quicframe.QuicFrameMaxStreamData
            f2.streamId = 0
            f2.maximum = rfc.QuicFcStreamProposeMax(gPeerFc, 0)
            let wr2: int32 = quicframe.QuicFrameAppend(bb2, EmptyBytes(), f2)
            if wr2 > 0:
                let buf2: Bytes = BytesBuilderFinish(bb2)
                var d2: quicframe.QuicFrame = quicframe.QuicFrameZero()
                let nx2: int32 = quicframe.QuicFrameDecodeAt(buf2, 0, d2)
                if nx2 != buf2.len || d2.ftype != quicframe.QuicFrameMaxStreamData:
                    fail("maxstreamdata-wire", "frame did not round-trip")
                else:
                    rfc.QuicFcOnMaxStreamData(gFc, 0, d2.maximum)
    if gAckDue == 0:
        gAckDue = gSimNow + gAckDelayUs

# Peer ack fires: generate the ACK frame with recovery_ack, decode it with
# the W3a codec, feed the scalars into QuicOnAckFrame.
fn peerFireAck() =
    if gAckDue == 0 || gAckDue > gSimNow:
        return
    gAckDue = 0
    var bb: BytesBuilder = BytesBuilderNew(1024)
    let n: int32 = rack.QuicAckFrameAppend(gPeerSet, bb, 0)
    if n <= 0:
        return
    let buf: Bytes = BytesBuilderFinish(bb)
    var f: quicframe.QuicFrame = quicframe.QuicFrameZero()
    let nx: int32 = quicframe.QuicFrameDecodeAt(buf, 0, f)
    if nx != buf.len || f.ftype != quicframe.QuicFrameAck:
        fail("ack-wire", "generated ACK did not round-trip through W3a codec")
        return
    let na: int32 = rloss.QuicOnAckFrame(gLoss, f.largestAck, f.firstAckRange,
        buf, f.rangesOff, f.ackRangeCount, gSimNow)
    if na < 0:
        fail("ackframe", strings.concatStr("QuicOnAckFrame rc=", strings.IntToStr(na)))
        return
    gDelivered = gDelivered + gLoss.lastAckedBytes
    rcc.QuicCcOnAckedBytes(gCc, gLoss.lastAckedBytes)
    drainLost()

fn fireTimer() =
    if gLoss.timerKind == rloss.QuicTimerNone:
        return
    if gLoss.timerDeadline > gSimNow:
        return
    rloss.QuicOnTimeout(gLoss, gSimNow)
    drainLost()
    let probes: int32 = rloss.QuicLossTakeProbes(gLoss)
    var i: int32
    while i < probes:
        sendOneProbe()
        i = i + 1

fn checkInvariants() =
    if gFc.maxData - gFc.dataSent < 0:
        fail("inv-conn-credit", "connection credit went negative")
    if gFc.streamCount > 0 && gFc.streamMax[0] - gFc.streamSent[0] < 0:
        fail("inv-stream-credit", "stream credit went negative")
    if gCc.cwnd < gCwndPrev && !gLossRoundHadCC:
        fail("inv-cwnd", strings.concatStr("cwnd dropped without loss round: ",
            strings.concatStr(strings.Int64ToStr(gCwndPrev),
            strings.concatStr(" -> ", strings.Int64ToStr(gCc.cwnd)))))
    gCwndPrev = gCc.cwnd
    gLossRoundHadCC = false

fn nextEventT(): int64 =
    var t: int64 = 0 - 1
    if gArrHead < gArrCount:
        t = gArrT[gArrHead]
    if gAckDue != 0 && (t < 0 || gAckDue < t):
        t = gAckDue
    if gLoss.timerKind != rloss.QuicTimerNone:
        if t < 0 || gLoss.timerDeadline < t:
            t = gLoss.timerDeadline
    return t

# One event-simulation run to completion (or an accepted flow-control stall).
@borrows
fn runScenario(tag: str, allowStall: bool): bool =
    var ok: bool = true
    while gDelivered < gTargetBytes:
        drainSends()
        let t: int64 = nextEventT()
        if t < 0 || t > gCapUs:
            gStalled = true
            if !allowStall:
                fail(tag, strings.concatStr("event exhaustion at t=",
                    strings.concatStr(strings.Int64ToStr(gSimNow),
                    strings.concatStr(" delivered=", strings.Int64ToStr(gDelivered)))))
                ok = false
            if gLoss.bytesInFlight != 0:
                fail(tag, strings.concatStr("ended with unacked bytes in flight=",
                    strings.Int64ToStr(gLoss.bytesInFlight)))
                ok = false
            break
        gSimNow = t
        while gArrHead < gArrCount && gArrT[gArrHead] <= gSimNow:
            peerReceive(gArrPn[gArrHead])
            gArrHead = gArrHead + 1
        peerFireAck()
        fireTimer()
        checkInvariants()
    if gFails != 0:
        ok = false
    let tputBps: int64 = gDelivered * 1000000 / maxI64(gSimNow, 1)
    let rtxPermil: int64 = gRetransPkts * 1000 / maxI64(gSentPkts, 1)
    var stalledNum: int64 = 0
    if gStalled:
        stalledNum = 1
    let p1: str = strings.concatStr(tag, strings.concatStr(": tput_Bps=",
        strings.Int64ToStr(tputBps)))
    let p2: str = strings.concatStr(p1, strings.concatStr(" rtx_permil=",
        strings.Int64ToStr(rtxPermil)))
    let p3: str = strings.concatStr(p2, strings.concatStr(" conv_ms=",
        strings.Int64ToStr(gSimNow / 1000)))
    let p4: str = strings.concatStr(p3, strings.concatStr(" delivered=",
        strings.Int64ToStr(gDelivered)))
    let p5: str = strings.concatStr(p4, strings.concatStr(" sent=",
        strings.Int64ToStr(gSentPkts)))
    let p6: str = strings.concatStr(p5, strings.concatStr(" retrans=",
        strings.Int64ToStr(gRetransPkts)))
    let p7: str = strings.concatStr(p6, strings.concatStr(" probes=",
        strings.Int64ToStr(gProbePkts)))
    let p8: str = strings.concatStr(p7, strings.concatStr(" pto=",
        strings.Int64ToStr(gLoss.ptoExpiries)))
    let p9: str = strings.concatStr(p8, strings.concatStr(" persistent=",
        strings.Int64ToStr(gPersistentEvents)))
    let p10: str = strings.concatStr(p9, strings.concatStr(" stalled=",
        strings.Int64ToStr(stalledNum)))
    os.WriteLine(os.Get_stdout(), strings.concatStr("SCENARIO ",
        strings.concatStr(p10, strings.concatStr(" cwnd_end=",
        strings.Int64ToStr(gCc.cwnd)))))
    return ok

# ---------------- unit sequences ---------------------------------------------

# Fires an ACK frame covering exactly [pnLow, pnHigh] (one range) through
# the generate -> W3a-decode -> QuicOnAckFrame pipeline.
fn peerAddAndFireAt(pnLow: int64, pnHigh: int64, nowUs: int64): int32 =
    rack.QuicAckSetInit(gPeerSet)
    rack.QuicAckSetAddRange(gPeerSet, pnLow, pnHigh)
    var bb: BytesBuilder = BytesBuilderNew(128)
    let n: int32 = rack.QuicAckFrameAppend(gPeerSet, bb, 0)
    if n <= 0:
        fail("unit-ackgen", "frame append returned no bytes")
        return 0 - 99
    let buf: Bytes = BytesBuilderFinish(bb)
    var f: quicframe.QuicFrame = quicframe.QuicFrameZero()
    let nx: int32 = quicframe.QuicFrameDecodeAt(buf, 0, f)
    if nx != buf.len || f.ftype != quicframe.QuicFrameAck:
        fail("unit-ackgen", "decode failed")
        return 0 - 99
    return rloss.QuicOnAckFrame(gLoss, f.largestAck, f.firstAckRange, buf,
        f.rangesOff, f.ackRangeCount, nowUs)

fn unitAckBasics() =
    rloss.QuicLossInit(gLoss)
    rcc.QuicCcInit(gCc)
    if rloss.QuicOnPacketSent(gLoss, 0, 1200, true, false, 0) != 0:
        fail("u1", "send failed")
        return
    if gLoss.timerKind != rloss.QuicTimerPto:
        fail("u1", "timer not armed for PTO after send")
        return
    if gLoss.timerDeadline != 1024000:
        fail("u1", strings.concatStr("pto deadline ", strings.Int64ToStr(gLoss.timerDeadline)))
        return
    let na: int32 = peerAddAndFireAt(0, 0, 20000)
    if na != 1:
        fail("u1", strings.concatStr("newly acked ", strings.IntToStr(na)))
        return
    if !gLoss.hasRttSample || gLoss.smoothRtt != 20000:
        fail("u1", "first RTT sample wrong")
        return
    if gLoss.timerKind != rloss.QuicTimerNone:
        fail("u1", "timer not cancelled when nothing in flight")
        return
    rcc.QuicCcOnAckedBytes(gCc, gLoss.lastAckedBytes)
    if gCc.cwnd != 13200:
        fail("u1", strings.concatStr("slow start cwnd ", strings.Int64ToStr(gCc.cwnd)))
        return
    pass("u1", "sent->ack->rtt-first->timer-cancel->slow-start")
    let samplesBefore: int64 = gLoss.rttSamples
    let nd: int32 = peerAddAndFireAt(0, 0, 25000)
    if nd != 0 || gLoss.rttSamples != samplesBefore:
        fail("u2", "dup ack produced state change")
        return
    pass("u2", "duplicate ack is a no-op")
    let nu: int32 = peerAddAndFireAt(9, 9, 26000)
    if nu != 0:
        fail("u3", "unknown range acked something")
        return
    if gLoss.largestAcked != 9:
        fail("u3", "largest acked not advanced")
        return
    pass("u3", "unknown packet-number ack ignored")

fn unitWindowAndTimeLoss() =
    rloss.QuicLossInit(gLoss)
    rcc.QuicCcInit(gCc)
    var i: int64
    while i < 5:
        if rloss.QuicOnPacketSent(gLoss, i, 1200, true, false, 0) != 0:
            fail("u4", "send failed")
            return
        i = i + 1
    # ack only pn 4: p0 lost by packet-number window (4-0 > 3), p1..p3 spared
    let na: int32 = peerAddAndFireAt(4, 4, 20000)
    if na != 1:
        fail("u4", "pn4 not acked")
        return
    if gLoss.lastLostCount != 1 || gLoss.lostPns[0] != 0:
        fail("u4", "window loss did not hit exactly pn0")
        return
    rcc.QuicCcOnPacketsLost(gCc, gLoss.lastLostPersistent, gSimNow, gLoss.smoothRtt)
    if gCc.cwnd != 6000 || gCc.ssthresh != 6000:
        fail("u4", strings.concatStr("cc after loss cwnd=", strings.Int64ToStr(gCc.cwnd)))
        return
    pass("u4", "pn-window loss (pn0), newreno ssthresh=cwnd/2=6000")
    # p1..p3 (diff <= 3, spared by window) share sent time 0, so they cross
    # the time threshold together when the loss timer fires
    if gLoss.timerKind != rloss.QuicTimerLoss:
        fail("u5", "loss timer not armed")
        return
    rloss.QuicOnTimeout(gLoss, gLoss.timerDeadline)
    if gLoss.lastLostCount != 3 || gLoss.lostPns[0] != 1 || gLoss.lostPns[1] != 2 || gLoss.lostPns[2] != 3:
        fail("u5", "timeout-loss did not hit exactly pn1..pn3")
        return
    if gLoss.trans[rloss.QuicTtimeoutLoss] < 1:
        fail("u5", "timeout-loss transition not counted")
        return
    if gLoss.bytesInFlight != 0 || gLoss.timerKind != rloss.QuicTimerNone:
        fail("u5", "state did not drain after timeout-loss")
        return
    pass("u5", "time-threshold loss via loss-timer expiry (pn1..pn3)")
    # spurious: a late ack of a packet the recovery already declared lost
    let ns: int32 = peerAddAndFireAt(1, 1, 25000)
    if ns != 0 || gLoss.spuriousAcks != 1:
        fail("u6", strings.concatStr("spurious count ", strings.Int64ToStr(gLoss.spuriousAcks)))
        return
    pass("u6", "late ack of a lost packet counted spurious, no double debit")

fn unitPtoBackoff() =
    rloss.QuicLossInit(gLoss)
    rcc.QuicCcInit(gCc)
    if rloss.QuicOnPacketSent(gLoss, 0, 1200, true, false, 0) != 0:
        fail("u7", "send failed")
        return
    if gLoss.timerKind != rloss.QuicTimerPto:
        fail("u7", "no PTO armed")
        return
    rloss.QuicOnTimeout(gLoss, 1024000)
    if gLoss.ptoCount != 1 || gLoss.probesPending != 2:
        fail("u7", "first PTO expiry wrong")
        return
    if rloss.QuicLossTakeProbes(gLoss) != 2:
        fail("u7", "probe take wrong")
        return
    var p: int64 = 1
    while p < 4:
        if rloss.QuicOnPacketSent(gLoss, p, 1200, true, true, 1024000) != 0:
            fail("u7", "probe send failed")
            return
        p = p + 1
    let d2: int64 = gLoss.timerDeadline
    if d2 != 1024000 + 2048000:
        fail("u7", strings.concatStr("backoff deadline ", strings.Int64ToStr(d2)))
        return
    rloss.QuicOnTimeout(gLoss, d2)
    if gLoss.ptoCount != 2:
        fail("u7", "second expiry did not double backoff")
        return
    rloss.QuicLossTakeProbes(gLoss)
    # convergence: ack everything (p0 data + p1..p3 probes)
    let na: int32 = peerAddAndFireAt(0, 3, 4000000)
    if na != 4:
        fail("u7", strings.concatStr("convergence acked ", strings.IntToStr(na)))
        return
    if gLoss.ptoCount != 0 || gLoss.timerKind != rloss.QuicTimerNone:
        fail("u7", "pto not reset / timer not cancelled after convergence")
        return
    pass("u7", "PTO expiry, probe pair, doubling backoff, reset on ack")

fn unitPersistent() =
    rloss.QuicLossInit(gLoss)
    rcc.QuicCcInit(gCc)
    # 8 packets spaced 200 ms; ack pn0 and pn7 only -> pn1..pn6 lost, the 1 s
    # window below pn7's send time is fully lost -> persistent congestion
    var i: int64
    while i < 8:
        if rloss.QuicOnPacketSent(gLoss, i, 1200, true, false, i * 200000) != 0:
            fail("u8", "send failed")
            return
        i = i + 1
    rack.QuicAckSetInit(gPeerSet)
    rack.QuicAckSetAdd(gPeerSet, 0)
    rack.QuicAckSetAdd(gPeerSet, 7)
    var bb: BytesBuilder = BytesBuilderNew(128)
    let n: int32 = rack.QuicAckFrameAppend(gPeerSet, bb, 0)
    if n <= 0:
        fail("u8", "ack gen failed")
        return
    let buf: Bytes = BytesBuilderFinish(bb)
    var f: quicframe.QuicFrame = quicframe.QuicFrameZero()
    if quicframe.QuicFrameDecodeAt(buf, 0, f) != buf.len:
        fail("u8", "ack decode failed")
        return
    let na: int32 = rloss.QuicOnAckFrame(gLoss, f.largestAck, f.firstAckRange,
        buf, f.rangesOff, f.ackRangeCount, 1500000)
    if na != 2:
        fail("u8", strings.concatStr("acked ", strings.IntToStr(na)))
        return
    if !gLoss.lastLostPersistent:
        fail("u8", "persistent congestion not confirmed")
        return
    if gLoss.lastLostCount != 6:
        fail("u8", strings.concatStr("lost count ", strings.IntToStr(gLoss.lastLostCount)))
        return
    rcc.QuicCcOnPacketsLost(gCc, gLoss.lastLostPersistent, gSimNow, gLoss.smoothRtt)
    if gCc.cwnd != 2400:
        fail("u8", strings.concatStr("post-persistent cwnd ", strings.Int64ToStr(gCc.cwnd)))
        return
    pass("u8", "persistent congestion: 1s window fully lost, cwnd=min")

fn unitCongestionAvoidance() =
    # continues from unitWindowAndTimeLoss state: cwnd=6000, ssthresh=6000
    if rloss.QuicOnPacketSent(gLoss, 6, 1200, true, false, 40000) != 0:
        fail("u9", "send failed")
        return
    if rloss.QuicOnPacketSent(gLoss, 7, 1200, true, false, 40000) != 0:
        fail("u9", "send failed")
        return
    let na: int32 = peerAddAndFireAt(6, 7, 60000)
    if na != 2:
        fail("u9", "ca acks missing")
        return
    rcc.QuicCcOnAckedBytes(gCc, gLoss.lastAckedBytes)
    if gCc.cwnd != 6480:
        fail("u9", strings.concatStr("ca cwnd ", strings.Int64ToStr(gCc.cwnd)))
        return
    pass("u9", "congestion avoidance: 2 packets x 1440000/cwnd=480")

fn unitFlowControl() =
    rfc.QuicFcInit(gFc, 65536, 65536, 65536)
    rfc.QuicFcInit(gPeerFc, 0, 0, 65536)
    if !rfc.QuicFcAllowSend(gFc, 0, 1200):
        fail("u10", "initial credit refused")
        return
    if !rfc.QuicFcOnSent(gFc, 0, 1200):
        fail("u10", "initial deduct refused")
        return
    if rfc.QuicFcCreditConn(gFc) != 64336:
        fail("u10", "conn credit wrong")
        return
    if rfc.QuicFcAllowSend(gFc, 0, 70000):
        fail("u10", "over-credit allowed")
        return
    if rfc.QuicFcOnSent(gFc, 0, 70000):
        fail("u10", "over-credit deducted (credit would go negative)")
        return
    if rfc.QuicFcCreditConn(gFc) != 64336:
        fail("u10", "refused deduct mutated state")
        return
    rfc.QuicFcOnMaxData(gFc, 131072)
    # conn credit 129872, but stream-0 credit is 64336: 64000 fits both
    if !rfc.QuicFcAllowSend(gFc, 0, 64000):
        fail("u10", "top-up not honored")
        return
    if rfc.QuicFcAllowSend(gFc, 0, 64337):
        fail("u10", "stream over-credit allowed after conn top-up")
        return
    rfc.QuicFcOnMaxStreamData(gFc, 1, 4096)
    if !rfc.QuicFcAllowSend(gFc, 1, 4096):
        fail("u10", "stream top-up not honored")
        return
    if rfc.QuicFcAllowSend(gFc, 1, 4097):
        fail("u10", "stream over-credit allowed")
        return
    if rfc.QuicFcOnMaxStreamData(gFc, 1, 2048):
        fail("u10", "window shrink accepted")
        return
    # receive side: consumption drives the top-up proposal
    rfc.QuicFcOnDeliveredConn(gPeerFc, 60000)
    if !rfc.QuicFcConnUpdateNeeded(gPeerFc):
        fail("u10", "update needed not detected")
        return
    if rfc.QuicFcConnProposeMax(gPeerFc) != 125536:
        fail("u10", "proposal wrong")
        return
    pass("u10", "credit gate, refusal, top-up, stream window, hysteresis")

fn unitAckSetCodec() =
    var s: rack.QuicAckSet
    rack.QuicAckSetInit(s)
    rack.QuicAckSetAdd(s, 0)
    rack.QuicAckSetAdd(s, 5)
    rack.QuicAckSetAdd(s, 3)
    rack.QuicAckSetAdd(s, 4)
    rack.QuicAckSetAdd(s, 9)
    rack.QuicAckSetAdd(s, 10)
    rack.QuicAckSetAddRange(s, 200, 299)
    rack.QuicAckSetAdd(s, 63)
    rack.QuicAckSetAdd(s, 64)
    rack.QuicAckSetAdd(s, 100)
    if s.count != 6 || s.rangesDropped != 0:
        fail("u11", strings.concatStr("set shape count=", strings.IntToStr(s.count)))
        return
    if s.largestSeen != 299 || !rack.QuicAckSetContains(s, 299) || rack.QuicAckSetContains(s, 199):
        fail("u11", "largest/contains wrong")
        return
    var bb: BytesBuilder = BytesBuilderNew(256)
    let n: int32 = rack.QuicAckFrameAppend(s, bb, 12345)
    if n <= 0:
        fail("u11", "gen failed")
        return
    let buf: Bytes = BytesBuilderFinish(bb)
    var b2: BytesBuilder = BytesBuilderNew(256)
    var f: quicframe.QuicFrame = quicframe.QuicFrameZero()
    let nx: int32 = quicframe.QuicFrameDecodeAt(buf, 0, f)
    if nx != buf.len || f.ftype != quicframe.QuicFrameAck:
        fail("u11", "W3a decode failed")
        return
    if f.largestAck != 299 || f.ackDelay != 12345 || f.ackRangeCount != 5 || f.firstAckRange != 99:
        fail("u11", strings.concatStr("decoded scalars wrong largest=", strings.Int64ToStr(f.largestAck)))
        return
    let wr: int32 = quicframe.QuicFrameAppend(b2, buf, f)
    if wr < 0:
        fail("u11", "re-encode failed")
        return
    let buf2: Bytes = BytesBuilderFinish(b2)
    if !BytesEqual(buf, buf2):
        fail("u11", "re-encode not byte-identical")
        return
    # rebuild a set from the decoded frame scalars and compare coverage
    var s2: rack.QuicAckSet
    rack.QuicAckSetInit(s2)
    rack.QuicAckSetAddRange(s2, f.largestAck - f.firstAckRange, f.largestAck)
    var prevLow: int64 = f.largestAck - f.firstAckRange
    var off: int32 = f.rangesOff
    var k: int64
    while k < f.ackRangeCount:
        let pr: rack.QuicAckPairRead = rack.QuicAckReadPairAt(buf, off)
        if !pr.ok:
            fail("u11", "pair read failed")
            return
        off = pr.nextOff
        let hi: int64 = prevLow - pr.gap - 1
        rack.QuicAckSetAddRange(s2, hi - pr.rangeLen, hi)
        prevLow = hi
        k = k + 1
    if rack.QuicAckSetCovered(s2) != rack.QuicAckSetCovered(s):
        fail("u11", "coverage mismatch after codec round-trip")
        return
    pass("u11", "set->frame->W3a decode->set coverage equal; re-encode byte-identical")
    # negative: malformed frames into QuicOnAckFrame
    rloss.QuicLossInit(gLoss)
    let r1: int32 = rloss.QuicOnAckFrame(gLoss, 10, 11, EmptyBytes(), 0 - 1, 0, 0)
    if r1 != 0 - 2:
        fail("u11", strings.concatStr("firstRange>largest rc=", strings.IntToStr(r1)))
        return
    let r2: int32 = rloss.QuicOnAckFrame(gLoss, 10, 0, EmptyBytes(), 0 - 1, 500, 0)
    if r2 != 0 - 3:
        fail("u11", strings.concatStr("extra range cap rc=", strings.IntToStr(r2)))
        return
    pass("u11", "malformed ACK frames rejected with exact codes")

# ---------------- scenarios + coverage + ideal pipe ---------------------------

fn idealPipeTimeUs(): int64 =
    var delivered: int64 = 0
    var cwnd: int64 = 12000
    var t: int64 = 0
    let cadence: int64 = gPropUs + gAckDelayUs
    while delivered < gTargetBytes:
        delivered = delivered + minI64(cwnd, gTargetBytes - delivered)
        t = t + cadence
        cwnd = cwnd + cwnd
    return t

fn accumCoverage() =
    var i: int32
    while i < 22:
        gCovLoss[i] = gCovLoss[i] + gLoss.trans[i]
        gCovCc[i] = gCovCc[i] + gCc.trans[i]
        i = i + 1

fn printAccumCoverage() =
    var i: int32
    while i < 22:
        os.WriteLine(os.Get_stdout(), strings.concatStr("COV t",
            strings.concatStr(strings.IntToStr(i), strings.concatStr("=",
            strings.Int64ToStr(gCovLoss[i] + gCovCc[i])))))
        i = i + 1

fn checkCoverage() =
    var i: int32
    while i < 22:
        if gCovLoss[i] + gCovCc[i] < 1:
            fail("coverage", strings.concatStr("transition t",
                strings.concatStr(strings.IntToStr(i), " never reached")))
            return
        i = i + 1
    pass("coverage", "all 22 Appendix-A transition ids reached >= 1 time")

fn scenarioClean() =
    resetSim(10000, 0, 0 - 1, 0 - 1, 0 - 1, 10000, false, 2000000, 16777216)
    let ok: bool = runScenario("clean", false)
    if !ok:
        return
    if gDelivered != 2000000:
        fail("clean", "not fully delivered")
        return
    if gRetransPkts != 0 || gProbePkts != 0 || gLoss.lostPackets != 0:
        fail("clean", "spurious recovery activity in loss-free run")
        return
    let ideal: int64 = idealPipeTimeUs()
    if gSimNow > ideal * 105 / 100 || gSimNow < ideal * 90 / 100:
        fail("clean-ideal", strings.concatStr("sim_t=",
            strings.concatStr(strings.Int64ToStr(gSimNow),
            strings.concatStr(" ideal_t=", strings.Int64ToStr(ideal)))))
        return
    pass("clean-ideal", strings.concatStr("sim_t=",
        strings.concatStr(strings.Int64ToStr(gSimNow),
        strings.concatStr(" ideal_t=", strings.Int64ToStr(ideal)))))

fn scenarioRandomLoss(pct: int64, tag: str) =
    resetSim(10000, pct, 0 - 1, 0 - 1, 0 - 1, 10000, false, 2000000, 16777216)
    let ok: bool = runScenario(tag, false)
    if !ok:
        return
    if gDelivered != 2000000:
        fail(tag, "not fully delivered")
        return
    if gRetransPkts == 0:
        fail(tag, "losses happened but no retransmission")
        return
    pass(tag, "delivered with recovery")

fn scenarioBurst() =
    resetSim(10000, 0, 60000, 1260000, 0 - 1, 10000, false, 2000000, 16777216)
    let ok: bool = runScenario("burst_1p2s", false)
    if !ok:
        return
    if gDelivered != 2000000:
        fail("burst_1p2s", "not fully delivered")
        return
    if gPersistentEvents == 0:
        fail("burst_1p2s", "burst window did not confirm persistent congestion")
        return
    pass("burst_1p2s", "burst loss recovered via persistent-congestion reset")

fn scenarioRttStep() =
    resetSim(10000, 0, 0 - 1, 0 - 1, 100000, 40000, false, 2000000, 16777216)
    let ok: bool = runScenario("rtt_step", false)
    if !ok:
        return
    if gDelivered != 2000000:
        fail("rtt_step", "not fully delivered")
        return
    if gLoss.latestRtt != 48000 || gLoss.minRtt != 18000:
        fail("rtt_step", strings.concatStr("latest=", strings.Int64ToStr(gLoss.latestRtt)))
        return
    if gLoss.smoothRtt <= 18000 || gLoss.smoothRtt > 48000:
        fail("rtt_step", strings.concatStr("smooth=", strings.Int64ToStr(gLoss.smoothRtt)))
        return
    pass("rtt_step", "rtt estimator tracked the 4x step (min kept, latest exact)")

fn scenarioBackpressure() =
    resetSim(10000, 0, 0 - 1, 0 - 1, 0 - 1, 10000, true, 2000000, 65536)
    let ok: bool = runScenario("zero_read", true)
    if !ok:
        return
    if !gStalled:
        fail("zero_read", "run did not stall against the initial credit")
        return
    if gDelivered < 60000:
        fail("zero_read", strings.concatStr("stalled too early ", strings.Int64ToStr(gDelivered)))
        return
    if gDelivered > 65536:
        fail("zero_read", "delivered beyond the announced credit")
        return
    if gLoss.bytesInFlight != 0:
        fail("zero_read", "stall left bytes in flight unacked")
        return
    pass("zero_read", "sender stalled exactly at the initial credit window")

fn main(): int32 =
    gRng = 0x5deece66d
    unitAckBasics()
    accumCoverage()
    unitWindowAndTimeLoss()
    accumCoverage()
    unitCongestionAvoidance()
    accumCoverage()
    unitPtoBackoff()
    accumCoverage()
    unitPersistent()
    accumCoverage()
    unitFlowControl()
    unitAckSetCodec()
    accumCoverage()
    scenarioClean()
    accumCoverage()
    scenarioRandomLoss(1, "loss_1pct")
    accumCoverage()
    scenarioRandomLoss(5, "loss_5pct")
    accumCoverage()
    scenarioBurst()
    accumCoverage()
    scenarioRttStep()
    accumCoverage()
    scenarioBackpressure()
    accumCoverage()
    printAccumCoverage()
    checkCoverage()
    if gFails != 0:
        os.WriteLine(os.Get_stdout(), strings.concatStr("W4-RECON RESULT: FAIL count=",
            strings.IntToStr(gFails)))
        return 1
    os.WriteLine(os.Get_stdout(), "W4-RECON RESULT: PASS")
    return 0
