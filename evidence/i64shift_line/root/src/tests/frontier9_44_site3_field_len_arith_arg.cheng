type Buf =
    data: int32[]
    tag: int32

fn take(n: int32): int32 =
    return n

# 触发形态: 实参 b.data.len + k = 字段.len 算术和, 作 take 的实参。
fn probe(b: Buf, k: int32): int32 =
    return take(b.data.len + k)

fn main(): int32 =
    var b: Buf
    return probe(b, 1)
