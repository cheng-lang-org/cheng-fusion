import std/rawbytes
import cheng/core/backend/elf_riscv64_writer as elf64
import cheng/core/backend/elf_riscv32_writer as elf32
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/native_object_emission_plan as nativeplan

@borrows
fn u8At(bytes: rawbytes.Bytes, offset: int32): uint64 =
    return uint64(rawbytes.BytesGet(bytes, offset) & 255)

@borrows
fn u16le(bytes: rawbytes.Bytes, offset: int32): uint64 =
    return u8At(bytes, offset) |
        (u8At(bytes, offset + 1) << 8)

@borrows
fn u32le(bytes: rawbytes.Bytes, offset: int32): uint64 =
    return u8At(bytes, offset) |
        (u8At(bytes, offset + 1) << 8) |
        (u8At(bytes, offset + 2) << 16) |
        (u8At(bytes, offset + 3) << 24)

@borrows
fn u64le(bytes: rawbytes.Bytes, offset: int32): uint64 =
    return u32le(bytes, offset) |
        (u32le(bytes, offset + 4) << 32)

@borrows
fn elf64RelaOffset(bytes: rawbytes.Bytes): int32 =
    let sectionHeaderOffset = int32(u64le(bytes, 40))
    let sectionHeaderSize = int32(u16le(bytes, 58))
    let sectionCount = int32(u16le(bytes, 60))
    for i in 0..<sectionCount:
        let headerOffset = sectionHeaderOffset + i * sectionHeaderSize
        if u32le(bytes, headerOffset + 4) == uint64(4):
            return int32(u64le(bytes, headerOffset + 24))
    return -1

@borrows
fn elf32RelaOffset(bytes: rawbytes.Bytes): int32 =
    let sectionHeaderOffset = int32(u32le(bytes, 32))
    let sectionHeaderSize = int32(u16le(bytes, 46))
    let sectionCount = int32(u16le(bytes, 48))
    for i in 0..<sectionCount:
        let headerOffset = sectionHeaderOffset + i * sectionHeaderSize
        if u32le(bytes, headerOffset + 4) == uint64(4):
            return int32(u32le(bytes, headerOffset + 16))
    return -1

@borrows
fn elf64SectionOffset(bytes: rawbytes.Bytes,
                      sectionType: uint64): int32 =
    let sectionHeaderOffset = int32(u64le(bytes, 40))
    let sectionHeaderSize = int32(u16le(bytes, 58))
    let sectionCount = int32(u16le(bytes, 60))
    for i in 0..<sectionCount:
        let headerOffset = sectionHeaderOffset + i * sectionHeaderSize
        if u32le(bytes, headerOffset + 4) == sectionType:
            return int32(u64le(bytes, headerOffset + 24))
    return -1

@borrows
fn elf64SectionInfo(bytes: rawbytes.Bytes,
                    sectionType: uint64): int32 =
    let sectionHeaderOffset = int32(u64le(bytes, 40))
    let sectionHeaderSize = int32(u16le(bytes, 58))
    let sectionCount = int32(u16le(bytes, 60))
    for i in 0..<sectionCount:
        let headerOffset = sectionHeaderOffset + i * sectionHeaderSize
        if u32le(bytes, headerOffset + 4) == sectionType:
            return int32(u32le(bytes, headerOffset + 44))
    return -1

@borrows
fn elf32SectionOffset(bytes: rawbytes.Bytes,
                      sectionType: uint64): int32 =
    let sectionHeaderOffset = int32(u32le(bytes, 32))
    let sectionHeaderSize = int32(u16le(bytes, 46))
    let sectionCount = int32(u16le(bytes, 48))
    for i in 0..<sectionCount:
        let headerOffset = sectionHeaderOffset + i * sectionHeaderSize
        if u32le(bytes, headerOffset + 4) == sectionType:
            return int32(u32le(bytes, headerOffset + 16))
    return -1

@borrows
fn elf32SectionInfo(bytes: rawbytes.Bytes,
                    sectionType: uint64): int32 =
    let sectionHeaderOffset = int32(u32le(bytes, 32))
    let sectionHeaderSize = int32(u16le(bytes, 46))
    let sectionCount = int32(u16le(bytes, 48))
    for i in 0..<sectionCount:
        let headerOffset = sectionHeaderOffset + i * sectionHeaderSize
        if u32le(bytes, headerOffset + 4) == sectionType:
            return int32(u32le(bytes, headerOffset + 28))
    return -1

fn buildText(): rawbytes.Bytes =
    var text = rawbytes.BytesAlloc(32)
    for i in 0..<32:
        rawbytes.BytesSet(text, i, 0)
    return text

fn buildSymbols(): osym.ObjectSymbolTable =
    var symbols = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               symbols, "entry", 0, int64(0), int64(32), true) == 0,
           " relocation contract: entry symbol")
    assert(osym.ObjectSymbolsAddUndefined(
               symbols, "callee", true) == 1,
           " relocation contract: callee symbol")
    return symbols

fn buildSymbolsWithLocalData(): osym.ObjectSymbolTable =
    var symbols = buildSymbols()
    assert(osym.ObjectSymbolsAddDefined(
               symbols, "local_data", 1, int64(0), int64(4), false) == 2,
           " relocation contract: local data symbol")
    return symbols

fn planAccepts(targetTriple: str,
               kind: orel.ObjectRelocKind,
               pcRelative: bool): bool =
    var plan: nativeplan.NativeObjectEmissionPlan
    plan.targetTriple = targetTriple
    plan.objectFormat = "elf"
    plan.actualBackendKind = "primary"
    plan.entrySymbol = "entry"
    plan.entryFunctionSymbol = "entry"
    plan.text = buildText()
    plan.symbols = buildSymbols()
    let _ = orel.ObjectRelocsAdd(
        plan.relocs, 0, int64(0), 1, kind, int64(0), pcRelative)
    var err: str
    let accepted =
        nativeplan.NativeObjectEmissionPlanValidateInto(plan, err)
    nativeplan.NativeObjectEmissionPlanRelease(plan)
    return accepted

@borrows
fn checkElf64(text: rawbytes.Bytes,
              symbols: osym.ObjectSymbolTable) =
    var relocs = orel.ObjectRelocsInit()
    assert(orel.ObjectRelocsAdd(
               relocs, 0, int64(0), 1, orel.ObjectRelocAbs32,
               int64(0x01020304), false) == 0,
           " relocation contract: elf64 abs32")
    assert(orel.ObjectRelocsAdd(
               relocs, 0, int64(8), 1, orel.ObjectRelocAbs64,
               int64(0x11223344), false) == 1,
           " relocation contract: elf64 abs64")
    assert(orel.ObjectRelocsAdd(
               relocs, 0, int64(16), 1, orel.ObjectRelocRiscvCall,
               int64(0x00556677), true) == 2,
           " relocation contract: elf64 RISC-V call")
    let built = elf64.ElfRv64TextObjectBytes(text, symbols, relocs)
    assert(built.ok, built.err.msg)
    var bytes = built.value
    defer:
        rawbytes.BytesFree(bytes)
    let rela = elf64RelaOffset(bytes)
    assert(rela >= 0, " relocation contract: elf64 .rela.text")
    assert(u64le(bytes, rela) == uint64(0),
           " relocation contract: elf64 abs32 offset bytes")
    assert(u32le(bytes, rela + 8) == uint64(1),
           " relocation contract: elf64 R_RISCV_32 type bytes")
    assert(u32le(bytes, rela + 12) == uint64(2),
           " relocation contract: elf64 abs32 symbol bytes")
    assert(u64le(bytes, rela + 16) == uint64(0x01020304),
           " relocation contract: elf64 abs32 addend bytes")
    let abs64 = rela + 24
    assert(u64le(bytes, abs64) == uint64(8),
           " relocation contract: elf64 abs64 offset bytes")
    assert(u32le(bytes, abs64 + 8) == uint64(2),
           " relocation contract: elf64 R_RISCV_64 type bytes")
    assert(u32le(bytes, abs64 + 12) == uint64(2),
           " relocation contract: elf64 abs64 symbol bytes")
    assert(u64le(bytes, abs64 + 16) == uint64(0x11223344),
           " relocation contract: elf64 abs64 addend bytes")
    let call = rela + 48
    assert(u64le(bytes, call) == uint64(16),
           " relocation contract: elf64 call offset bytes")
    assert(u32le(bytes, call + 8) == uint64(18),
           " relocation contract: elf64 R_RISCV_CALL type bytes")
    assert(u32le(bytes, call + 12) == uint64(2),
           " relocation contract: elf64 call symbol bytes")
    assert(u64le(bytes, call + 16) == uint64(0x00556677),
           " relocation contract: elf64 call addend bytes")

@borrows
fn checkElf32(text: rawbytes.Bytes,
              symbols: osym.ObjectSymbolTable) =
    var relocs = orel.ObjectRelocsInit()
    assert(orel.ObjectRelocsAdd(
               relocs, 0, int64(0), 1, orel.ObjectRelocAbs32,
               int64(0x01020304), false) == 0,
           " relocation contract: elf32 abs32")
    assert(orel.ObjectRelocsAdd(
               relocs, 0, int64(8), 1, orel.ObjectRelocRiscvCall,
               int64(0x00556677), true) == 1,
           " relocation contract: elf32 RISC-V call")
    let built = elf32.ElfRv32TextObjectBytes(text, symbols, relocs)
    assert(built.ok, built.err.msg)
    var bytes = built.value
    defer:
        rawbytes.BytesFree(bytes)
    let rela = elf32RelaOffset(bytes)
    assert(rela >= 0, " relocation contract: elf32 .rela.text")
    assert(u32le(bytes, rela) == uint64(0),
           " relocation contract: elf32 abs32 offset bytes")
    assert(u32le(bytes, rela + 4) == uint64(0x0201),
           " relocation contract: elf32 abs32 info bytes")
    assert(u32le(bytes, rela + 8) == uint64(0x01020304),
           " relocation contract: elf32 abs32 addend bytes")
    let call = rela + 12
    assert(u32le(bytes, call) == uint64(8),
           " relocation contract: elf32 call offset bytes")
    assert(u32le(bytes, call + 4) == uint64(0x0212),
           " relocation contract: elf32 call info bytes")
    assert(u32le(bytes, call + 8) == uint64(0x00556677),
           " relocation contract: elf32 call addend bytes")

@borrows
fn checkRejectedMutations(text: rawbytes.Bytes,
                          symbols: osym.ObjectSymbolTable) =
    var branch = orel.ObjectRelocsInit()
    let _ = orel.ObjectRelocsAdd(
        branch, 0, int64(0), 1, orel.ObjectRelocBranch26,
        int64(0), true)
    let branch64 = elf64.ElfRv64TextObjectBytes(text, symbols, branch)
    assert(!branch64.ok,
           " relocation contract: elf64 Branch26 must not become R_RISCV_CALL")
    let branch32 = elf32.ElfRv32TextObjectBytes(text, symbols, branch)
    assert(!branch32.ok,
           " relocation contract: elf32 Branch26 must not become R_RISCV_CALL")

    var abs64 = orel.ObjectRelocsInit()
    let _ = orel.ObjectRelocsAdd(
        abs64, 0, int64(0), 1, orel.ObjectRelocAbs64,
        int64(0), false)
    let abs64Rv32 = elf32.ElfRv32TextObjectBytes(text, symbols, abs64)
    assert(!abs64Rv32.ok,
           " relocation contract: RV32 Abs64 must hard-fail")

    var missing = orel.ObjectRelocsInit()
    let _ = orel.ObjectRelocsAdd(
        missing, 0, int64(0), 7, orel.ObjectRelocRiscvCall,
        int64(0), true)
    let missing64 = elf64.ElfRv64TextObjectBytes(text, symbols, missing)
    assert(!missing64.ok,
           " relocation contract: elf64 missing relocation symbol")
    let missing32 = elf32.ElfRv32TextObjectBytes(text, symbols, missing)
    assert(!missing32.ok,
           " relocation contract: elf32 missing relocation symbol")

@borrows
fn checkLocalSymbolPrefixAndRelocMap(text: rawbytes.Bytes) =
    var data = rawbytes.BytesAlloc(4)
    defer:
        rawbytes.BytesFree(data)
    for i in 0..<4:
        rawbytes.BytesSet(data, i, i + 1)
    var symbols = buildSymbolsWithLocalData()
    var relocs = orel.ObjectRelocsInit()
    let _ = orel.ObjectRelocsAdd(
        relocs, 0, int64(0), 1,
        orel.ObjectRelocRiscvCall, int64(0), true)

    let built64 = elf64.ElfRv64TextDataObjectBytes(
        text, data, symbols, relocs)
    assert(built64.ok, built64.err.msg)
    var bytes64 = built64.value
    defer:
        rawbytes.BytesFree(bytes64)
    let sym64 = elf64SectionOffset(bytes64, uint64(2))
    let rela64 = elf64SectionOffset(bytes64, uint64(4))
    assert(sym64 >= 0 && rela64 >= 0,
           " relocation contract: elf64 local symtab sections")
    assert(elf64SectionInfo(bytes64, uint64(2)) == 2,
           " relocation contract: elf64 first global index")
    assert(u8At(bytes64, sym64 + 24 + 4) == uint64(1),
           " relocation contract: elf64 local data STT_OBJECT prefix")
    assert(u8At(bytes64, sym64 + 48 + 4) == uint64(0x12),
           " relocation contract: elf64 global function follows local")
    assert(u32le(bytes64, rela64 + 12) == uint64(3),
           " relocation contract: elf64 relocation source-index map")

    let built32 = elf32.ElfRv32TextDataObjectBytes(
        text, data, symbols, relocs)
    assert(built32.ok, built32.err.msg)
    var bytes32 = built32.value
    defer:
        rawbytes.BytesFree(bytes32)
    let sym32 = elf32SectionOffset(bytes32, uint64(2))
    let rela32 = elf32SectionOffset(bytes32, uint64(4))
    assert(sym32 >= 0 && rela32 >= 0,
           " relocation contract: elf32 local symtab sections")
    assert(elf32SectionInfo(bytes32, uint64(2)) == 2,
           " relocation contract: elf32 first global index")
    assert(u8At(bytes32, sym32 + 16 + 12) == uint64(1),
           " relocation contract: elf32 local data STT_OBJECT prefix")
    assert(u8At(bytes32, sym32 + 32 + 12) == uint64(0x12),
           " relocation contract: elf32 global function follows local")
    assert((u32le(bytes32, rela32 + 4) >> 8) == uint64(3),
           " relocation contract: elf32 relocation source-index map")

fn main(): int32 =
    assert(orel.ObjectRelocKindCode(orel.ObjectRelocRiscvCall) == 7,
           " relocation contract: stable RISC-V call kind code")
    var text = buildText()
    defer:
        rawbytes.BytesFree(text)
    var symbols = buildSymbols()
    checkElf64(text, symbols)
    checkElf32(text, symbols)
    checkRejectedMutations(text, symbols)
    checkLocalSymbolPrefixAndRelocMap(text)
    assert(planAccepts(
               "riscv64-unknown-linux-gnu",
               orel.ObjectRelocRiscvCall,
               true),
           " relocation contract: RV64 plan accepts RISC-V call")
    assert(planAccepts(
               "riscv64-unknown-linux-gnu",
               orel.ObjectRelocAbs64,
               false),
           " relocation contract: RV64 plan accepts Abs64")
    assert(!planAccepts(
               "riscv64-unknown-linux-gnu",
               orel.ObjectRelocBranch26,
               true),
           " relocation contract: RV64 plan rejects Branch26")
    assert(!planAccepts(
               "riscv32-esp32s31-none-elf",
               orel.ObjectRelocAbs64,
               false),
           " relocation contract: RV32 plan rejects Abs64")
    echo("riscv_object_relocation_writer_contract=pass exact_rela=7 rejected=7 plan_accept=2 local_prefix=2")
    return 0
