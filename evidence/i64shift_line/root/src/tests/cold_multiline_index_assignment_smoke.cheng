type
    MultilineIndexState = ref object
        counts: int32[]

fn checkedAdd(a: int32, b: int32): int32 =
    return a + b

fn storeContextCount(state: MultilineIndexState, base: int32, value: int32) =
    state.counts[
        checkedAdd(base, 1)] =
        value

fn main(): int32 =
    var values: int32[]
    setLen(values, 2)
    values[0] =
        4
    values[1] =
        values[0] + 3
    if values[0] != 4 || values[1] != 7:
        return 1
    let state = new(MultilineIndexState)
    setLen(state.counts, 2)
    storeContextCount(state, 0, 9)
    if state.counts[1] != 9:
        return 2
    return 0
