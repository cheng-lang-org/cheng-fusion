# regalloc blast-radius shield fixture (axis-W 阶段1 反向零迁移门).
# Multi-block body with cbr count = 3 (>2). The residency gate returns the EMPTY
# set for the whole function when multiBlock && cbr>2 (x86_64_body_emit 2150),
# so K=1 and K=2 emit byte-identical code: no resident is ever selected, R8/R9
# stay untouched. This is the blast-radius shield — proves K=2 does NOT leak into
# high-branch-density bodies. (k2/k4/k5 share this shield family.)
# Pure scalar + branch + return (no assert/echo) for x86_64 emit maturity.

fn blastShield(n: int32): int32 =
    var r: int32
    if n == 1:
        r = r + 10
    elif n == 2:
        r = r + 20
    elif n == 3:
        r = r + 30
    else:
        r = r + 40
    return r

fn main(): int32 =
    if blastShield(1) != 10:
        return 1
    if blastShield(2) != 20:
        return 2
    if blastShield(3) != 30:
        return 3
    if blastShield(9) != 40:
        return 4
    return 0
