import std/result
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn

fn main(): int32 =
    var table: vpn.VpnProxyUdpSessionTable
    vpn.VpnProxyUdpSessionTableInit(table)

    let firstRes: Result[int64] = vpn.VpnProxyUdpSessionForAddress(table, "1.1.1.1:53")
    assert(IsOk(firstRes), " vpn proxy udp session first")
    assert(Value(firstRes) == int64(1), " vpn proxy udp session first id")

    let againRes: Result[int64] = vpn.VpnProxyUdpSessionForAddress(table, "1.1.1.1:53")
    assert(IsOk(againRes), " vpn proxy udp session repeat")
    assert(Value(againRes) == int64(1), " vpn proxy udp session repeat id")

    let secondRes: Result[int64] = vpn.VpnProxyUdpSessionForAddress(table, "8.8.8.8:53")
    assert(IsOk(secondRes), " vpn proxy udp session second")
    assert(Value(secondRes) == int64(2), " vpn proxy udp session second id")
    assert(vpn.VpnProxyUdpSessionContainsId(table, int64(1)), " vpn proxy udp session contains first")
    assert(vpn.VpnProxyUdpSessionContainsId(table, int64(2)), " vpn proxy udp session contains second")
    assert(!vpn.VpnProxyUdpSessionContainsId(table, int64(3)), " vpn proxy udp session rejects unknown id")

    let knownRes: Result[int64] = vpn.VpnProxyUdpSessionForKnownAddress(table, "8.8.8.8:53")
    assert(IsOk(knownRes), " vpn proxy udp session known")
    assert(Value(knownRes) == int64(2), " vpn proxy udp session known id")
    let missingRes: Result[int64] = vpn.VpnProxyUdpSessionForKnownAddress(table, "9.9.9.9:53")
    assert(IsErr(missingRes), " vpn proxy udp session missing")

    echo(" vpn_proxy_udp_session_smoke ok")
    return 0
