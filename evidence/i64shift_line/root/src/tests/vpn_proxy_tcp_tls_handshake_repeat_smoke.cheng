import std/result
import std/rawbytes
import std/strutils as strutil
import cheng/quic/tls/test_pki as testpki
import cheng/quic/tls/policy as policy
import cheng/apps/vpn_proxy/transport_tcp_tls_handshake as hs
import cheng/apps/vpn_proxy/transport_tcp_tls_record as rec

fn runOnce(iter: int32): int32 =
    let tlsPolicy: policy.MsQuicTlsPolicy = testpki.msquicMakeLocalhostTransportTlsPolicy()
    let clientHelloRes: Result[Bytes] = hs.VpnProxyTcpTlsForwardClientBuildHello("localhost",
                                                                                 tlsPolicy.trustRoot0)
    if IsErr(clientHelloRes):
        echo(strutil.Join(["iter ", IntToStr(iter), " client hello err: ", ErrorText(clientHelloRes)], ""))
        return 1
    let serverFlightRes: Result[hs.VpnProxyTcpTlsServerFlight] = hs.VpnProxyTcpTlsForwardServerBuildFlight(Value(clientHelloRes),
                                                                                                           tlsPolicy)
    if IsErr(serverFlightRes):
        echo(strutil.Join(["iter ", IntToStr(iter), " server flight err: ", ErrorText(serverFlightRes)], ""))
        return 1
    let serverFlight: hs.VpnProxyTcpTlsServerFlight = Value(serverFlightRes)
    let clientFinishedRes: Result[Bytes] = hs.VpnProxyTcpTlsForwardClientProcessServerFlight(serverFlight.serverHelloRecord,
                                                                                             serverFlight.encryptedHandshakeRecord)
    if IsErr(clientFinishedRes):
        echo(strutil.Join(["iter ", IntToStr(iter), " client process flight err: ", ErrorText(clientFinishedRes)], ""))
        return 1
    let serverFinishRes: Result[bool] = hs.VpnProxyTcpTlsForwardServerProcessClientFinished(Value(clientFinishedRes))
    if IsErr(serverFinishRes):
        echo(strutil.Join(["iter ", IntToStr(iter), " server finished err: ", ErrorText(serverFinishRes)], ""))
        return 1
    let clientSendRes: Result[rec.VpnProxyTcpTlsRecordKeys] = hs.VpnProxyTcpTlsForwardClientAppSendKeys()
    if IsErr(clientSendRes):
        echo(strutil.Join(["iter ", IntToStr(iter), " client app send keys err: ", ErrorText(clientSendRes)], ""))
        return 1
    let serverRecvRes: Result[rec.VpnProxyTcpTlsRecordKeys] = hs.VpnProxyTcpTlsForwardServerAppRecvKeys()
    if IsErr(serverRecvRes):
        echo(strutil.Join(["iter ", IntToStr(iter), " server app recv keys err: ", ErrorText(serverRecvRes)], ""))
        return 1
    var clientSend: rec.VpnProxyTcpTlsRecordKeys = Value(clientSendRes)
    var serverRecv: rec.VpnProxyTcpTlsRecordKeys = Value(serverRecvRes)
    let appPayload: Bytes = BytesFromString("tcp-tls-forward app frame")
    let appRecordRes: Result[Bytes] = rec.VpnProxyTcpTlsRecordEncrypt(clientSend,
                                                                      rec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                      appPayload)
    if IsErr(appRecordRes):
        echo(strutil.Join(["iter ", IntToStr(iter), " app encrypt err: ", ErrorText(appRecordRes)], ""))
        return 1
    let appPlainRes: Result[rec.VpnProxyTcpTlsRecordPlain] = rec.VpnProxyTcpTlsRecordDecrypt(serverRecv,
                                                                                             Value(appRecordRes))
    if IsErr(appPlainRes):
        echo(strutil.Join(["iter ", IntToStr(iter), " app decrypt err: ", ErrorText(appPlainRes)], ""))
        return 1
    if !BytesEqual(Value(appPlainRes).payload, appPayload):
        echo(strutil.Join(["iter ", IntToStr(iter), " app payload mismatch"], ""))
        return 1
    echo(strutil.Join(["iter ", IntToStr(iter), " ok"], ""))
    return 0

fn main(): int32 =
    var failures: int32
    for i in 0..<4:
        let rc: int32 = runOnce(i)
        if rc != 0:
            failures = failures + 1
    if failures > 0:
        echo(strutil.Join(["vpn_proxy_tcp_tls_handshake_repeat_smoke FAILED iters=", IntToStr(failures)], ""))
        return 1
    echo(" vpn_proxy_tcp_tls_handshake_repeat_smoke ok")
    return 0
