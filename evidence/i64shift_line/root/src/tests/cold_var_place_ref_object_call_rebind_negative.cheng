type
    ColdVarPlaceCallRebindCell =
        value: int32

    ColdVarPlaceCallRebindInner = ref object
        cell: ColdVarPlaceCallRebindCell

    ColdVarPlaceCallRebindOuter = ref object
        inner: ColdVarPlaceCallRebindInner

fn ColdVarPlaceCallRebindReplace(
        out: var ColdVarPlaceCallRebindOuter) =
    out.inner = new(ColdVarPlaceCallRebindInner)

fn ColdVarPlaceCallRebindWrite(
        cell: var ColdVarPlaceCallRebindCell) =
    cell.value = 71

fn ColdVarPlaceCallRebindMutate(
        out: var ColdVarPlaceCallRebindOuter) =
    var inner = out.inner
    ColdVarPlaceCallRebindReplace(out)
    ColdVarPlaceCallRebindWrite(inner.cell)

fn main(): int32 =
    var out = new(ColdVarPlaceCallRebindOuter)
    out.inner = new(ColdVarPlaceCallRebindInner)
    ColdVarPlaceCallRebindMutate(out)
    return 0
