import cheng/moq/media_asset_manifest as media

@importc("cheng_monotime_ns")
fn mediaLifecycleClockProbeMonoTimeNs(): int64

fn main(): int32 =
    let t0 = mediaLifecycleClockProbeMonoTimeNs() / 1000000
    let t1 = mediaLifecycleClockProbeMonoTimeNs() / 1000000
    var receipt: media.MediaIngestReceipt
    media.MediaIngestReceiptStamp(receipt, t0, t1)
    echo(Fmt" media_lifecycle_clock_probe monotime_start={t0} monotime_complete={t1} elapsed={receipt.elapsedMs}")
    assert(t0 > int64(0), " media lifecycle clock: monotime ms")
    assert(t1 >= t0, " media lifecycle clock: monotime order")
    assert(receipt.startedAtMs == t0, " media lifecycle clock: receipt start")
    assert(receipt.completedAtMs == t1, " media lifecycle clock: receipt complete")
    assert(receipt.elapsedMs == t1 - t0, " media lifecycle clock: receipt elapsed")
    return 0
