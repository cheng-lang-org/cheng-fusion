# Android device probe for the MoQ publisher ingest pipeline.
#
# The publisher's stdout/stderr logging via get_stdout/get_stderr -> fopen("/dev/stdout")
# is unreliable inside /data/local/tmp on Android (the /proc/self/fd reopen fails), so
# on-device failures show up only as an exit code with no log. This probe runs the exact
# same ingest steps and writes a structured outcome to --out-path (a regular file, which
# the file-handle bridge handles fine) so we can see which stage fails.
#
# New test-only file; does not modify any existing main-workspace source.

import std/result
import std/rawbytes
import std/os
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/moq/media_asset_manifest as media

fn probeWrite(outPath: str, line: str) =
    let _ = os.WriteFileResult(outPath, line)

fn main(): int32 =
    var outPathRaw: str
    let hasOut: bool = cmdline.ReadFirstFlagValue("--out-path", outPathRaw)
    let outPath: str = if hasOut: outPathRaw else: "/data/local/tmp/moq/probe.txt"

    var mp4PathRaw: str
    let _h1: bool = cmdline.ReadFirstFlagValue("--mp4", mp4PathRaw)
    let mp4Path: str = mp4PathRaw
    var posterPathRaw: str
    let _h2: bool = cmdline.ReadFirstFlagValue("--poster", posterPathRaw)
    let posterPath: str = posterPathRaw

    var log: str = "probe start\n"
    probeWrite(outPath, log)

    # Stage 1: poster read
    let posterRes: Result[rawbytes.Bytes] = os.ReadFileBytesResult(posterPath)
    if IsErr(posterRes):
        log = strutil.Join([log, "FAIL poster_read: ", Error(posterRes), "\n"], "")
        probeWrite(outPath, log)
        return 11
    log = strutil.Join([log, "ok poster_read bytes=", IntToStr(rawbytes.BytesLen(Value(posterRes))), "\n"], "")
    probeWrite(outPath, log)

    # Stage 2: ingest video file pin
    var index = media.MediaLocalIndexInit()
    var fileReq: media.MediaVideoFileIngestRequest
    fileReq.sourcePath = mp4Path
    fileReq.ownerPeerId = "publisher-alpha"
    fileReq.remotePeersCsv = "subscriber-bravo"
    fileReq.mime = "video/mp4"
    fileReq.durationMs = int64(22000)
    fileReq.codec = "h264/aac"
    fileReq.posterBytes = Value(posterRes)
    fileReq.contentSignature = "network-milestone-moq-publisher-v1"
    fileReq.objectTargetBytes = 4096
    fileReq.sourceBlockBytes = 1024
    fileReq.repairDropletCount = 2
    let ingestRes = media.MediaIngestVideoFilePin(index, fileReq)
    if IsErr(ingestRes):
        log = strutil.Join([log, "FAIL ingest: ", Error(ingestRes), "\n"], "")
        probeWrite(outPath, log)
        return 12
    let ingest = Value(ingestRes)
    log = strutil.Join([log, "ok ingest asset_cid=", ingest.assetCid, "\n"], "")
    probeWrite(outPath, log)

    # Stage 3: manifest lookup
    let manifestRes = media.MediaLocalIndexFind(index, ingest.assetCid)
    if IsErr(manifestRes):
        log = strutil.Join([log, "FAIL manifest: ", Error(manifestRes), "\n"], "")
        probeWrite(outPath, log)
        return 13
    let manifest = Value(manifestRes)
    log = strutil.Join([log, "ok manifest objects=", IntToStr(manifest.objects.len), "\n"], "")
    probeWrite(outPath, log)

    # Stage 4: QUIC listener bind on 127.0.0.1:0
    var listener = qtransport.InitMsQuicTransport()
    let startRes = quic_transport.Libp2pQuicStartListenerNamed(listener, "127.0.0.1", 0, "localhost")
    if IsErr(startRes):
        log = strutil.Join([log, "FAIL listener_start: ", Error(startRes), "\n"], "")
        probeWrite(outPath, log)
        return 14
    let boundPort: int32 = Value(startRes)
    log = strutil.Join([log, "ok listener_start bound_port=", IntToStr(boundPort), "\n"], "")
    probeWrite(outPath, log)

    qtransport.Stop(listener)
    log = strutil.Join([log, "ALL_OK\n"], "")
    probeWrite(outPath, log)
    return 0
