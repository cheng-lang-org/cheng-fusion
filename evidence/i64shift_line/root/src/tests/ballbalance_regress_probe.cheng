# Ballbalance regression probe (post-Q2): the point-mass figure standing
# on the REAL-spec ball. Same assembly/injection/servo wiring as
# src/tests/ball_balance_probe.cheng (case B configuration: ball-frame
# servo with the frozen defaults, no execution-side roll resist, no
# trim), re-grounded for the real ball:
#   ball r = 0.121 m, m = 0.62 kg (real ball), center (0, 0.85, r)
#   resting on the ground plane. The frozen ballbalance scene hangs the
#   figure for the 0.35 m ball (foot centers z = 2*0.35 + 0.06 = 0.76);
#   the real ball puts the foot centers at z = 2*0.121 + 0.06 = 0.302,
#   so the whole scene (parts AND station anchors) is translated down by
#   0.458 m before validation — every relative quantity (joint rests,
#   station leashes, pelvis/foot offsets) is preserved exactly.
#
# Q2 load-aware rolling resistance anchors (docs/campaigns/
# 2026-09-06-csg-semantic-physical-world-video/findings.md, 2026-09-13):
# the resistance lives in physics3dBallRollingContact (engine level), so
# a no-resistance control arm CANNOT run inside this probe — the Q2
# report data is the control anchor instead:
#   - pre-Q2: an unloaded ball in pure roll ran 73 m (never stopped); the
#     ridden 0.35 m ball drifted equally far under the same servo family
#     (case B baseline creep: 11487 mm at tick 14300).
#   - Q2 rigid_ball_probe case D: a loaded pure-rolling ball decays to
#     205.8 mm/s (analytic 0.5 - Crr*g*1 s with Crr = 0.03); the unloaded
#     control never moves (excess = 0 gate, bit-identical trajectory).
# Contract under test on the real ball: ball drift < 2 m at tick 2000
# (the resistance-effectiveness band), zero rejected physics steps,
# upright ratio 100%. If the point-mass servo cannot hold the real ball,
# the data is reported as-is — a real-spec point-mass ball-stand datum.
#
# Sampling per 50 ticks: pelvis z / ball center z / drift / ball wy wx /
# ball speed / roll slip / CoM-over-ball error / head-below-pelvis. The
# trace arrays are preallocated before the physics loop and index-written
# inside it: zero str work, zero echo, zero allocation inside the loop.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/csg/numerics
import cheng/game/contacts3d
import cheng/game/world3d
import cheng/game/physics3d
import std/strings as strings
import std/math as m

const
    ProbeTotalTicks = 14300
    ProbeRecordEvery = 50
    ProbePrintEvery = 200
    # 14300 / 50 samples, preallocated
    ProbeSampleCount = 286
    ProbeDriftPassM = 2.0
    ProbeDriftCheckTick = 2000
    ProbePelvis = 0
    ProbeChest = 1
    ProbeHead = 2
    # real ball specs
    ProbeBallRadiusM = 0.121
    ProbeBallMassKg = 0.62
    # re-grounding drop: frozen feet z 0.76 (2*0.35 + 0.06) -> real-ball
    # feet z 0.302 (2*0.121 + 0.06)
    ProbeStanceDropM = 0.458
    ProbeAnchorEndTick = 100

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

fn reportRow(t: int32,
             pz: float64,
             bz: float64,
             drift: float64,
             wy: float64,
             wx: float64,
             bspd: float64,
             slip: float64,
             comErr: float64,
             fall: int32) =
    echo("ball t=" + strings.IntToStr(t)
        + " pelvis_z_mm=" + fmtMm(pz * 1000.0)
        + " ball_z_mm=" + fmtMm(bz * 1000.0)
        + " drift_mm=" + fmtMm(drift * 1000.0)
        + " wy_mrad=" + fmtMm(wy * 1000.0)
        + " wx_mrad=" + fmtMm(wx * 1000.0)
        + " bspd_mms=" + fmtMm(bspd * 1000.0)
        + " slip_mm=" + fmtMm(slip * 1000.0)
        + " com_err_mm=" + fmtMm(comErr * 1000.0)
        + " head_below=" + strings.IntToStr(fall))

# Mass-weighted figure CoM horizontal distance to the ball center
# (read-only metric, the ball-top balance property).
@borrows
fn comErrOverBall(st: execution.CsgExecutionState, ballSlot: int32): float64 =
    var mSum: float64 = 0.0
    var comX: float64 = 0.0
    var comY: float64 = 0.0
    var pi: int32 = 0
    while pi < st.mpPartCount:
        let slot: int32 = st.mpPartSlot[pi]
        let mass: float64 = 1.0 / st.w.bodyInvMass[slot]
        mSum = mSum + mass
        comX = comX + mass * st.w.bodyPx[slot]
        comY = comY + mass * st.w.bodyPy[slot]
        pi = pi + 1
    comX = comX / mSum
    comY = comY / mSum
    let ex = comX - st.w.bodyPx[ballSlot]
    let ey = comY - st.w.bodyPy[ballSlot]
    return numerics.CsgSqrt(ex * ex + ey * ey)

fn main(): int32 =
    # self-collision on: the figure-ball pair resolves through
    # Contacts3dResolveBodyPairs (same as the precedent probe)
    contacts3d.Contacts3dSelfCollisionSet(1)
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildBallBalanceScene()
    # re-ground the frozen scene for the real ball: parts and station
    # anchors both drop by ProbeStanceDropM, all relative geometry is
    # preserved bit-for-bit
    var i: int32 = 0
    while i < facts.partKind.len:
        facts.partZ[i] = facts.partZ[i] - ProbeStanceDropM
        i = i + 1
    i = 0
    while i < facts.stepPart.len:
        facts.stepZ[i] = facts.stepZ[i] - ProbeStanceDropM
        i = i + 1
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL ballbalance regress facts validation status=" + strings.IntToStr(verdict.statusCode))
        return 1
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL ballbalance regress materialize")
        return 1
    # execution-side real-ball injection: solid sphere resting on the
    # ground plane under the figure, spawned before execution init so
    # the balance controller and every tick see it
    let ballSlot: int32 = world3d.World3dSpawnBody(w,
        producer.CsgBallBalanceBallCenterX,
        producer.CsgBallBalanceBallCenterY,
        ProbeBallRadiusM,
        ProbeBallMassKg,
        ProbeBallRadiusM,
        world3d.World3dBodyBallRigid)
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    # case B servo wiring with the frozen defaults, real-ball radius;
    # the engine-level Q2 rolling resistance needs no opt-in (it runs
    # inside physics3dBallRollingContact for every BallRigid body)
    execution.CsgBalanceSetBallMode(st,
        ballSlot,
        ProbeBallRadiusM,
        execution.CsgBalanceBallGain,
        execution.CsgBalanceBallFootGain,
        execution.CsgBalanceBallDamp,
        execution.CsgBalanceBallTorsoCapMps,
        execution.CsgBalanceBallCorrCapMps)
    let pelvisSlot: int32 = mp.partSlot[ProbePelvis]
    let chestSlot: int32 = mp.partSlot[ProbeChest]
    let headSlot: int32 = mp.partSlot[ProbeHead]
    let ballX0: float64 = st.w.bodyPx[ballSlot]
    let ballY0: float64 = st.w.bodyPy[ballSlot]
    let pelvisX0: float64 = st.w.bodyPx[pelvisSlot]
    let pelvisY0: float64 = st.w.bodyPy[pelvisSlot]
    # preallocated trace (zero allocation inside the physics loop)
    var recTick: int32[]
    var recPelvisZ: float64[]
    var recBallZ: float64[]
    var recDrift: float64[]
    var recWy: float64[]
    var recWx: float64[]
    var recBallSpd: float64[]
    var recSlip: float64[]
    var recComErr: float64[]
    var recFall: int32[]
    setLen(recTick, ProbeSampleCount)
    setLen(recPelvisZ, ProbeSampleCount)
    setLen(recBallZ, ProbeSampleCount)
    setLen(recDrift, ProbeSampleCount)
    setLen(recWy, ProbeSampleCount)
    setLen(recWx, ProbeSampleCount)
    setLen(recBallSpd, ProbeSampleCount)
    setLen(recSlip, ProbeSampleCount)
    setLen(recComErr, ProbeSampleCount)
    setLen(recFall, ProbeSampleCount)
    var rejected: int32 = 0
    var fallTick: int32 = -1
    var uprightTicks: int32 = 0
    var driftMax: float64 = 0.0
    var driftCheck: float64 = 0.0
    var comErrCheck: float64 = 0.0
    # torso z stability window opens at release (the anchored hang is not
    # a balance state)
    var pelvisZMin: float64 = st.w.bodyPz[pelvisSlot]
    var pelvisZMax: float64 = st.w.bodyPz[pelvisSlot]
    var chestZMin: float64 = st.w.bodyPz[chestSlot]
    var chestZMax: float64 = st.w.bodyPz[chestSlot]
    var tick: int32 = 0
    while tick < ProbeTotalTicks:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            rejected = rejected + 1
        let dx = st.w.bodyPx[ballSlot] - ballX0
        let dy = st.w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        if drift > driftMax:
            driftMax = drift
        if tick == ProbeDriftCheckTick:
            driftCheck = drift
            comErrCheck = comErrOverBall(st, ballSlot)
        var fallFlag: int32 = 0
        if st.w.bodyPz[headSlot] < st.w.bodyPz[pelvisSlot]:
            fallFlag = 1
            if fallTick < 0:
                fallTick = tick
        else:
            uprightTicks = uprightTicks + 1
        if tick >= ProbeAnchorEndTick:
            let pz = st.w.bodyPz[pelvisSlot]
            let cz = st.w.bodyPz[chestSlot]
            if pz < pelvisZMin:
                pelvisZMin = pz
            if pz > pelvisZMax:
                pelvisZMax = pz
            if cz < chestZMin:
                chestZMin = cz
            if cz > chestZMax:
                chestZMax = cz
        if tick % ProbeRecordEvery == 0:
            let si: int32 = tick / ProbeRecordEvery
            let bvx = st.w.bodyVx[ballSlot]
            let bvy = st.w.bodyVy[ballSlot]
            let slipX = bvx - st.w.bodyAngVy[ballSlot] * ProbeBallRadiusM
            let slipY = bvy + st.w.bodyAngVx[ballSlot] * ProbeBallRadiusM
            recTick[si] = tick
            recPelvisZ[si] = st.w.bodyPz[pelvisSlot]
            recBallZ[si] = st.w.bodyPz[ballSlot]
            recDrift[si] = drift
            recWy[si] = st.w.bodyAngVy[ballSlot]
            recWx[si] = st.w.bodyAngVx[ballSlot]
            recBallSpd[si] = numerics.CsgSqrt(bvx * bvx + bvy * bvy)
            recSlip[si] = numerics.CsgSqrt(slipX * slipX + slipY * slipY)
            recComErr[si] = comErrOverBall(st, ballSlot)
            recFall[si] = fallFlag
        tick = tick + 1
    # buffered trace out (physics loop is done)
    var k: int32 = 0
    while k < ProbeSampleCount:
        if recTick[k] % ProbePrintEvery == 0 || recFall[k] == 1 || k == ProbeSampleCount - 1:
            reportRow(recTick[k], recPelvisZ[k], recBallZ[k], recDrift[k], recWy[k], recWx[k], recBallSpd[k], recSlip[k], recComErr[k], recFall[k])
        k = k + 1
    let driftEnd = recDrift[ProbeSampleCount - 1]
    let comErrEnd = recComErr[ProbeSampleCount - 1]
    let ballSpdEnd = recBallSpd[ProbeSampleCount - 1]
    let slipEnd = recSlip[ProbeSampleCount - 1]
    let pdx = st.w.bodyPx[pelvisSlot] - pelvisX0
    let pdy = st.w.bodyPy[pelvisSlot] - pelvisY0
    let pelvisDriftEnd = numerics.CsgSqrt(pdx * pdx + pdy * pdy)
    let uprightPct: int32 = uprightTicks * 100 / ProbeTotalTicks
    let pelvisZRange = pelvisZMax - pelvisZMin
    let chestZRange = chestZMax - chestZMin
    var metrics: str = "drift@" + strings.IntToStr(ProbeDriftCheckTick) + "=" + fmtMm(driftCheck * 1000.0)
    metrics = metrics + "mm drift_max=" + fmtMm(driftMax * 1000.0)
    metrics = metrics + "mm drift_end=" + fmtMm(driftEnd * 1000.0)
    metrics = metrics + "mm com_err@" + strings.IntToStr(ProbeDriftCheckTick) + "=" + fmtMm(comErrCheck * 1000.0)
    metrics = metrics + "mm com_err_end=" + fmtMm(comErrEnd * 1000.0)
    metrics = metrics + "mm ball_spd_end=" + fmtMm(ballSpdEnd * 1000.0)
    metrics = metrics + "mm_s slip_end=" + fmtMm(slipEnd * 1000.0)
    metrics = metrics + "mm upright=" + strings.IntToStr(uprightPct)
    metrics = metrics + "% fell_tick=" + strings.IntToStr(fallTick)
    metrics = metrics + " rejected=" + strings.IntToStr(rejected)
    metrics = metrics + " pelvis_z_range_mm=" + fmtMm(pelvisZRange * 1000.0)
    metrics = metrics + " chest_z_range_mm=" + fmtMm(chestZRange * 1000.0)
    metrics = metrics + " pelvis_drift_end=" + fmtMm(pelvisDriftEnd * 1000.0) + "mm"
    var ok: bool = true
    if rejected != 0:
        echo("FAIL ballbalance regress physics rejections")
        ok = false
    if fallTick >= 0:
        echo("DATA ballbalance regress figure fell at tick " + strings.IntToStr(fallTick))
        ok = false
    if uprightPct != 100:
        echo("DATA ballbalance regress upright ratio " + strings.IntToStr(uprightPct) + "%")
        ok = false
    if driftCheck >= ProbeDriftPassM:
        echo("DATA ballbalance regress drift " + fmtMm(driftCheck * 1000.0) + " mm at tick " + strings.IntToStr(ProbeDriftCheckTick))
        ok = false
    if ok:
        echo("PASS ballbalance regress probe (" + metrics + ")")
    else:
        echo("DATA ballbalance regress probe (" + metrics + ")")
    return 0
