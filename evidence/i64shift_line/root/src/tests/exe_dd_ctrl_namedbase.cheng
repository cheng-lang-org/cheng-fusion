# exe_dd_triage 臂3（对照臂 B）：与臂1 唯一差异 = BytesToString 结果先绑定到
# 命名局部 tmp 再取视图（视图仍在，基座是作用域级 owned 局部，不在语句末释放）。
# 臂1 毒、臂3 好 ⇒ 毒化主体=表达式临时（owned 8MB str）的语句末释放，
# 而非 SliceBytes 本身或 wrapper trampoline。
import std/rawbytes
import std/strings

const kReplyText: str = "HELLO-REPLY-FROM-CALLEE"

fn fill_reply(b: var rawbytes.Bytes, cap: int32): int32 =
    if len(kReplyText) + 1 > cap:
        return -2
    var i: int32
    while i < len(kReplyText):
        rawbytes.BytesSet(b, i, Int32(kReplyText[i]))
        i = i + 1
    rawbytes.BytesSet(b, len(kReplyText), 0)
    return len(kReplyText)

fn main(): int32 =
    var cap: int32 = 8388608
    var outBytes = rawbytes.BytesAlloc(cap)
    let rc = fill_reply(outBytes, cap)
    var tmp = rawbytes.BytesToString(outBytes)
    var text = strings.SliceBytes(tmp, 0, rc)
    rawbytes.BytesFree(outBytes)
    let firstI: int32 = Int32(text[0])
    return firstI
