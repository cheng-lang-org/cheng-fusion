import std/system
import std/hashmaps
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/core_types as coreir
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

type
    FullRhsZero =
        low: int32
        high: int64

    FullRhsBox =
        checksum: int64
        zero: FullRhsZero
        values: int64[]

    FullRhsLookup =
        left: int32[]
        right: int32[]

    fullRhsFrozenScopeSoA =
        starts: int32[]
        counts: int32[]

    FullRhsProjection = ref object
        scopes: fullRhsFrozenScopeSoA
        signatures: fullRhsFrozenScopeSoA

fn fullRhsI32(value: int32): int32 =
    return value + 1

fn fullRhsI64(value: int64): int64 =
    return value * int64(17) + int64(3)

fn fullRhsPositive(value: int32): bool =
    return value > 0

fn fullRhsCapacity(values: var int32[]): int64 =
    return Int64(values.cap)

fn fullRhsCertificate(kind: int32,
                      index: int32,
                      value: int64): int64 =
    return (Int64(kind) << int64(48)) ^
           (Int64(index) << int64(32)) ^ value

fn fullRhsConditionAndArgLink(values: int32[]): int32 =
    assert(fullRhsPositive(values[0]) &&
           fullRhsI32(values[1]) >= 3,
           "primary full rhs tree: logical ArgLink")
    if !fullRhsPositive(values[2]):
        return 1
    return 0

fn fullRhsBoolArgLink(live: bool[], index: int32): bool =
    var journal: bool[]
    add(journal, index < live.len && live[index])
    return journal[0]

fn fullRhsArithmeticReturn(left: int64,
                           right: int64): int64 =
    return fullRhsI64(left) + fullRhsI64(right)

fn fullRhsMultiCallReturn(lookup: var FullRhsLookup): int64 =
    return fullRhsCapacity(lookup.left) +
           fullRhsCapacity(lookup.right) - int64(4)

fn fullRhsArithmeticStores(box: var FullRhsBox,
                           left: int64,
                           right: int64): int64 =
    var local: int64
    local = fullRhsI64(left) ^ fullRhsI64(right)
    box.checksum = box.checksum ^
        fullRhsCertificate(1, 0, box.values[0]) ^
        fullRhsCertificate(2, 0, fullRhsI64(box.values[0]))
    return local

fn fullRhsAggregateZero(box: var FullRhsBox): int32 =
    box.zero = FullRhsZero()
    return box.zero.low

fn fullRhsAggregateZeroRef(projection: FullRhsProjection) =
    projection.scopes = fullRhsFrozenScopeSoA()
    projection.signatures = fullRhsFrozenScopeSoA()

fn fullRhsUnsignedCondition(states: uint8[],
                            bucketCapacity: int32): int32 =
    let value = uint32(states[0]) |
                (uint32(states[1]) << uint32(8)) |
                (uint32(states[2]) << uint32(16)) |
                (uint32(states[3]) << uint32(24))
    if value >= uint32(bucketCapacity):
        return 1
    return 0

fn fullRhsAddNode(ir: var texpr.TypedExprIr,
                  kind: texpr.TypedExprIrOpKind,
                  resultType: str,
                  literalText: str): int32 =
    var node: texpr.TypedExprIrNode
    node.resultStructuralTypeId = -1
    node.sourcePath = "/tmp/primary_full_rhs_tree_realizer_smoke.cheng"
    node.functionName = "fullRhsNodeEvalAtomicity"
    node.lineNumber = 91
    node.opKind = kind
    node.resultType = resultType
    node.surfaceText = literalText
    node.literalText = literalText
    node.paramSlot = -1
    node.operand0NodeIndex = -1
    node.operand1NodeIndex = -1
    node.operand2NodeIndex = -1
    return texpr.TypedExprIrAddNode(ir, node)

fn fullRhsNodeEvalAtomicity() =
    var typedIr: texpr.TypedExprIr
    typedIr.internPool = langintern.InternPoolNew()
    typedIr.buildIndex = texpr.TypedExprBuildIndexNew(16)
    let nodeIndex = fullRhsAddNode(typedIr,
                                   texpr.TypedExprIrOpI32Const,
                                   "int32",
                                   "7")
    var typedFn: texpr.TypedExprIrFunction
    typedFn.sourcePath = "/tmp/primary_full_rhs_tree_realizer_smoke.cheng"
    typedFn.functionName = "fullRhsNodeEvalAtomicity"
    typedFn.returnType = "int32"
    typedFn.returnNodeIndex = -1
    var irFunction: lower.PrimaryObjectIrFunction
    var bodyIR = coreir.BodyIRNew()
    var slotNames: str[]
    let mismatchSlot = pobj.PrimaryBodyIrFindOrCreateSlotSized(bodyIR,
                                                                slotNames,
                                                                Fmt"#nev{nodeIndex}",
                                                                coreir.LocalAggregateTag,
                                                                1,
                                                                1)
    assert(mismatchSlot >= 0, "primary full rhs tree: mismatch slot")
    let baselineMismatchKind = bodyIR.localSlots[mismatchSlot].typeKind
    let baselineMismatchSize = bodyIR.localSlots[mismatchSlot].sizeBytes
    let baselineMismatchAlign = bodyIR.localSlots[mismatchSlot].alignBytes
    let baselineOps = bodyIR.ops.len
    let baselineCalls = bodyIR.callSequence.len
    let baselineSlots = bodyIR.localSlots.len
    let baselineBlocks = bodyIR.blocks.len
    let baselineTerms = bodyIR.terms.len
    let baselineStrings = bodyIR.cstringLiterals.len
    let baselineNames = slotNames.len
    var varI32ParamNames: str[]
    var lowering: lower.LoweringPlanStub
    var callOrdinal: int32
    var currentBlockStart = bodyIR.ops.len
    var resultSlot: int32
    var receipt: pobj.PrimaryBodyIrNodeBoolChainTransactionReceipt
    let outcome = pobj.PrimaryBodyIrEvalNodeToExpectedSlotTransactional(
        bodyIR,
        slotNames,
        varI32ParamNames,
        lowering,
        typedIr,
        typedFn,
        irFunction,
        nodeIndex,
        coreir.LocalI32Tag,
        8,
        true,
        callOrdinal,
        currentBlockStart,
        resultSlot,
        receipt)
    assert(outcome == pobj.PrimaryBodyIrNodeBoolChainClaimedFailed &&
           resultSlot == -1,
           "primary full rhs tree: mismatched EvalNode hard fails")
    assert(receipt.rollbackCount == 1 &&
           receipt.commitCount == 0 &&
           receipt.poisonCount == 1 &&
           receipt.preRollbackOpDelta > 0 &&
           receipt.preRollbackCallDelta == 0 &&
           receipt.prefixSlotMutationCount > 0,
           "primary full rhs tree: non-call EvalNode rollback receipt")
    assert(bodyIR.ops.len == baselineOps + 1 &&
           bodyIR.callSequence.len == baselineCalls &&
           bodyIR.localSlots.len == baselineSlots &&
           bodyIR.blocks.len == baselineBlocks &&
           bodyIR.terms.len == baselineTerms &&
           bodyIR.cstringLiterals.len == baselineStrings &&
           slotNames.len == baselineNames &&
           bodyIR.localSlots[mismatchSlot].typeKind == baselineMismatchKind &&
           bodyIR.localSlots[mismatchSlot].sizeBytes == baselineMismatchSize &&
           bodyIR.localSlots[mismatchSlot].alignBytes == baselineMismatchAlign &&
           callOrdinal == 0 &&
           currentBlockStart == baselineOps,
           "primary full rhs tree: EvalNode rollback restores full BodyIR")
    let poison = bodyIR.ops[bodyIR.ops.len - 1]
    assert(poison.kind == coreir.BodyOpInvalidTag &&
           poison.operands.len == 3 &&
           poison.operands[1] == 6101,
           "primary full rhs tree: rollback leaves one poison")

fn fullRhsNodeEvalStringAtomicity() =
    var typedIr: texpr.TypedExprIr
    typedIr.internPool = langintern.InternPoolNew()
    typedIr.buildIndex = texpr.TypedExprBuildIndexNew(16)
    let nodeIndex = fullRhsAddNode(typedIr,
                                   texpr.TypedExprIrOpStrLit,
                                   "str",
                                   "\"rollback\"")
    var typedFn: texpr.TypedExprIrFunction
    typedFn.sourcePath = "/tmp/primary_full_rhs_tree_realizer_smoke.cheng"
    typedFn.functionName = "fullRhsNodeEvalStringAtomicity"
    typedFn.returnType = "str"
    typedFn.returnNodeIndex = -1
    var irFunction: lower.PrimaryObjectIrFunction
    var bodyIR = coreir.BodyIRNew()
    var slotNames: str[]
    var varI32ParamNames: str[]
    var lowering: lower.LoweringPlanStub
    var callOrdinal = int32(9)
    var currentBlockStart = bodyIR.ops.len
    var resultSlot: int32
    var receipt: pobj.PrimaryBodyIrNodeBoolChainTransactionReceipt
    let outcome = pobj.PrimaryBodyIrEvalNodeToExpectedSlotTransactional(
        bodyIR,
        slotNames,
        varI32ParamNames,
        lowering,
        typedIr,
        typedFn,
        irFunction,
        nodeIndex,
        coreir.LocalStrTag,
        32,
        true,
        callOrdinal,
        currentBlockStart,
        resultSlot,
        receipt)
    assert(outcome == pobj.PrimaryBodyIrNodeBoolChainClaimedFailed &&
           resultSlot == -1 &&
           receipt.rollbackCount == 1 &&
           receipt.commitCount == 0 &&
           receipt.poisonCount == 1 &&
           receipt.preRollbackOpDelta > 0 &&
           receipt.preRollbackCallDelta > 0 &&
           receipt.preRollbackSlotDelta > 0 &&
           receipt.preRollbackCStringDelta > 0 &&
           receipt.preRollbackSlotNameDelta > 0,
           "primary full rhs tree: string EvalNode rollback receipt")
    assert(bodyIR.ops.len == 1 &&
           bodyIR.ops[0].kind == coreir.BodyOpInvalidTag &&
           bodyIR.callSequence.len == 0 &&
           bodyIR.localSlots.len == 0 &&
           bodyIR.blocks.len == 0 &&
           bodyIR.terms.len == 0 &&
           bodyIR.cstringLiterals.len == 0 &&
           slotNames.len == 0 &&
           irFunction.callArgCounts.len == 0 &&
           irFunction.callTargets.len == 0 &&
           irFunction.callTargetSourcePaths.len == 0 &&
           irFunction.callTargetImportcFlags.len == 0 &&
           irFunction.callImportcSymbols.len == 0 &&
           callOrdinal == 9 &&
           currentBlockStart == 0,
           "primary full rhs tree: string transaction restores every surface")

fn main(): int32 =
    fullRhsNodeEvalAtomicity()
    fullRhsNodeEvalStringAtomicity()
    var values: int32[]
    add(values, 1)
    add(values, 2)
    add(values, 0)
    assert(fullRhsConditionAndArgLink(values) == 1,
           "primary full rhs tree: condition result")

    var live: bool[]
    add(live, true)
    assert(fullRhsBoolArgLink(live, 0),
           "primary full rhs tree: bool ArgLink")

    var box: FullRhsBox
    box.checksum = int64(11)
    add(box.values, int64(5))
    add(box.values, int64(8))
    let stored = fullRhsArithmeticStores(box, int64(2), int64(4))
    assert(stored == (fullRhsI64(int64(2)) ^ fullRhsI64(int64(4))),
           "primary full rhs tree: local xor store")
    assert(fullRhsArithmeticReturn(int64(2), int64(4)) ==
           fullRhsI64(int64(2)) + fullRhsI64(int64(4)),
           "primary full rhs tree: arithmetic return")

    var lookup: FullRhsLookup
    add(lookup.left, 1)
    add(lookup.right, 2)
    assert(fullRhsMultiCallReturn(lookup) >= int64(0),
           "primary full rhs tree: multi-call return")
    assert(fullRhsAggregateZero(box) == 0,
           "primary full rhs tree: aggregate zero")
    let projection: FullRhsProjection = new(FullRhsProjection)
    fullRhsAggregateZeroRef(projection)
    assert(projection.scopes.starts.len == 0 && projection.signatures.counts.len == 0,
           "primary full rhs tree: ref aggregate zero")

    var states: uint8[]
    add(states, uint8(4))
    add(states, uint8(0))
    add(states, uint8(0))
    add(states, uint8(0))
    assert(fullRhsUnsignedCondition(states, 4) == 1,
           "primary full rhs tree: unsigned compare")
    return 0
