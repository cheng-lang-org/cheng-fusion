import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/relfacts

type
    RelfactsTestBinding =
        standard: str
        profiles: str[]
        schemaNamespace: str
        schemaCid: str

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn testBinding(profiles: str[]): RelfactsTestBinding =
    var out: RelfactsTestBinding
    out.standard = "csg_core::v1"
    out.profiles = profiles
    out.schemaNamespace = "csg_core::v1"
    out.schemaCid =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    return out

@borrows
fn matchesAt(text: str, needle: str, start: int32): bool =
    if start < 0 ||
       needle.len == 0 ||
       start > text.len - needle.len:
        return false
    for i in 0..<needle.len:
        if text[start + i] != needle[i]:
            return false
    return true

@borrows
fn replaceFirst(
        text: str,
        needle: str,
        replacement: str): str =
    if needle.len == 0 || needle.len > text.len:
        return ""
    for start in 0..<(text.len - needle.len + 1):
        if matchesAt(text, needle, start):
            let prefix = strings.CloneStrRange(
                text, 0, start)
            let suffixStart = start + needle.len
            let suffix = strings.CloneStrRange(
                text,
                suffixStart,
                text.len - suffixStart)
            return strings.ConcatStr(
                strings.ConcatStr(prefix, replacement),
                suffix)
    return ""

@borrows
fn dropLastRecord(text: str): str =
    if text.len < 3 || text[text.len - 1] != '\n':
        return ""
    for distance in 2..<text.len:
        let index = text.len - distance
        if text[index] == '\n':
            return strings.CloneStrRange(
                text, 0, index + 1)
    return ""

@borrows
fn replayTransition(
        text: str,
        beforeFacts: str[],
        afterFacts: str[],
        beforeBinding: RelfactsTestBinding,
        afterBinding: RelfactsTestBinding):
        relfacts.CsgCoreRelfactsReplayResult =
    return relfacts.CsgCoreRelfactsReplayCanonicalTransition(
        text,
        beforeFacts,
        afterFacts,
        beforeBinding.standard,
        beforeBinding.profiles,
        beforeBinding.schemaNamespace,
        beforeBinding.schemaCid,
        afterBinding.standard,
        afterBinding.profiles,
        afterBinding.schemaNamespace,
        afterBinding.schemaCid)

@borrows
fn expectReplayError(
        text: str,
        beforeFacts: str[],
        afterFacts: str[],
        beforeBinding: RelfactsTestBinding,
        afterBinding: RelfactsTestBinding,
        expectedPrefix: str): bool =
    os.WriteLine(os.Get_stderr(), "s3_repeated")
    let replay = replayTransition(
        text,
        beforeFacts,
        afterFacts,
        beforeBinding,
        afterBinding)
    return !replay.ok &&
        strings.HasPrefix(replay.error, expectedPrefix)

@borrows
fn encodeTransition(
        beforeFacts: str[],
        afterFacts: str[],
        beforeBinding: RelfactsTestBinding,
        afterBinding: RelfactsTestBinding):
        relfacts.CsgCoreRelfactsEncodeResult =
    return relfacts.CsgCoreRelfactsEncodeCanonicalTransition(
        beforeFacts,
        afterFacts,
        beforeBinding.standard,
        beforeBinding.profiles,
        beforeBinding.schemaNamespace,
        beforeBinding.schemaCid,
        afterBinding.standard,
        afterBinding.profiles,
        afterBinding.schemaNamespace,
        afterBinding.schemaCid)

fn main(): int32 =
    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleOld =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let moduleNew =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:bbb\"}"
    let symbol =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let webAction =
        "{\"action\":\"submit\",\"id\":\"web_submit\",\"kind\":\"csg.web.control_surface\"}"
    let coreBinding = testBinding(["csg_core"])
    let webBinding = testBinding([
        "csg_core",
        "csg_dialect::web"
    ])
    let beforeFacts = [strings.CloneStr(schema), strings.CloneStr(moduleOld), strings.CloneStr(symbol)]
    let afterFacts = [strings.CloneStr(schema), strings.CloneStr(moduleNew), strings.CloneStr(symbol)]
    let beforeDag =
        merkle_dag.CsgCoreMerkleBuildCanonicalBound(
            beforeFacts,
            coreBinding.standard,
            coreBinding.profiles,
            coreBinding.schemaNamespace,
            coreBinding.schemaCid)
    let afterDag =
        merkle_dag.CsgCoreMerkleBuildCanonicalBound(
            afterFacts,
            coreBinding.standard,
            coreBinding.profiles,
            coreBinding.schemaNamespace,
            coreBinding.schemaCid)
    if !beforeDag.ok || !afterDag.ok:
        return fail("relfacts test Merkle roots failed")

    os.WriteLine(os.Get_stderr(), "s1_dags")
    let transition = encodeTransition(
        beforeFacts,
        afterFacts,
        coreBinding,
        coreBinding)
    if !transition.ok ||
       !transition.replay.verifiedAgainstBeforeFacts ||
       !transition.replay.verifiedAgainstAfterFacts ||
       transition.replay.transitionKind !=
           relfacts.CsgCoreRelfactsTransitionKind() ||
       transition.replay.eventCount != 2 ||
       transition.replay.assertCount != 1 ||
       transition.replay.retractCount != 1 ||
       transition.replay.beforeFactCount != 3 ||
       transition.replay.afterFactCount != 3 ||
       transition.replay.beforeFactsRoot != beforeDag.factsRoot ||
       transition.replay.afterFactsRoot != afterDag.factsRoot:
        return fail(strings.ConcatStr(
            "relfacts true delta failed: ",
            transition.error))
    if transition.text.len == 0 ||
       transition.text[transition.text.len - 1] != '\n':
        return fail("relfacts canonical final newline missing")

    os.WriteLine(os.Get_stderr(), "s2_transition")
    let repeated = encodeTransition(
        [strings.CloneStr(symbol), strings.CloneStr(moduleOld), strings.CloneStr(schema)],
        [strings.CloneStr(symbol), strings.CloneStr(moduleNew), strings.CloneStr(schema)],
        coreBinding,
        coreBinding)
    if !repeated.ok ||
       repeated.text != transition.text ||
       repeated.replay.beforeFactsRoot !=
           transition.replay.beforeFactsRoot ||
       repeated.replay.afterFactsRoot !=
           transition.replay.afterFactsRoot:
        return fail(
            "relfacts transition changed with input order")

    let replay = replayTransition(
        transition.text,
        beforeFacts,
        afterFacts,
        coreBinding,
        coreBinding)
    if !replay.ok ||
       !replay.verifiedAgainstBeforeFacts ||
       !replay.verifiedAgainstAfterFacts ||
       replay.beforeDagRootCid != beforeDag.dagRootCid ||
       replay.afterDagRootCid != afterDag.dagRootCid ||
       replay.beforeSubgraphCid != beforeDag.subgraphCid ||
       replay.afterSubgraphCid != afterDag.subgraphCid:
        return fail(strings.ConcatStr(
            "relfacts canonical Merkle replay failed: ",
            replay.error))

    os.WriteLine(os.Get_stderr(), "s4_replay")
    let direct = relfacts.CsgCoreRelfactsEncode(
        [
            relfacts.CsgCoreRelfactsRetractOperation(strings.CloneStr(moduleOld)),
            relfacts.CsgCoreRelfactsAssertOperation(strings.CloneStr(moduleNew))
        ],
        beforeFacts,
        afterFacts,
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid,
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid)
    if !direct.ok || direct.text != transition.text:
        return fail("relfacts direct canonical delta diverged")

    os.WriteLine(os.Get_stderr(), "s5_direct")
    let explicitEmptyBefore = encodeTransition(
        [],
        afterFacts,
        coreBinding,
        coreBinding)
    if !explicitEmptyBefore.ok ||
       explicitEmptyBefore.replay.eventCount != 3 ||
       explicitEmptyBefore.replay.assertCount != 3 ||
       explicitEmptyBefore.replay.retractCount != 0 ||
       explicitEmptyBefore.replay.beforeFactCount != 0 ||
       explicitEmptyBefore.replay.afterFactsRoot !=
           afterDag.factsRoot:
        return fail(
            "relfacts explicit empty-before transition failed")

    os.WriteLine(os.Get_stderr(), "s6_emptybefore")
    let unchanged = encodeTransition(
        beforeFacts,
        beforeFacts,
        coreBinding,
        coreBinding)
    if !unchanged.ok ||
       unchanged.replay.eventCount != 0 ||
       unchanged.replay.assertCount != 0 ||
       unchanged.replay.retractCount != 0 ||
       unchanged.replay.beforeFactsRoot !=
           unchanged.replay.afterFactsRoot:
        return fail("relfacts unchanged keys emitted events")

    os.WriteLine(os.Get_stderr(), "s7_unchanged")
    let bindingOnly = encodeTransition(
        beforeFacts,
        beforeFacts,
        coreBinding,
        webBinding)
    if bindingOnly.ok ||
       bindingOnly.error !=
           "relfacts_encode_replay_failed relfacts_binding_only_transition_forbidden":
        return fail(
            "relfacts binding-only transition was not rejected")

    os.WriteLine(os.Get_stderr(), "s8_bindingonly")
    let webFacts = [strings.CloneStr(schema), strings.CloneStr(moduleOld), strings.CloneStr(symbol), strings.CloneStr(webAction)]
    let webDag =
        merkle_dag.CsgCoreMerkleBuildCanonicalBound(
            webFacts,
            webBinding.standard,
            webBinding.profiles,
            webBinding.schemaNamespace,
            webBinding.schemaCid)
    let crossProfile = encodeTransition(
        beforeFacts,
        webFacts,
        coreBinding,
        webBinding)
    if !webDag.ok ||
       !crossProfile.ok ||
       crossProfile.replay.eventCount != 1 ||
       crossProfile.replay.assertCount != 1 ||
       crossProfile.replay.retractCount != 0 ||
       crossProfile.replay.beforeFactsRoot != beforeDag.factsRoot ||
       crossProfile.replay.afterFactsRoot != webDag.factsRoot ||
       crossProfile.replay.beforeFactsRoot ==
           crossProfile.replay.afterFactsRoot:
        return fail("relfacts cross-profile add failed")
    let reverseProfile = encodeTransition(
        webFacts,
        beforeFacts,
        webBinding,
        coreBinding)
    if !reverseProfile.ok ||
       reverseProfile.replay.eventCount != 1 ||
       reverseProfile.replay.assertCount != 0 ||
       reverseProfile.replay.retractCount != 1 ||
       reverseProfile.replay.beforeFactsRoot != webDag.factsRoot ||
       reverseProfile.replay.afterFactsRoot != beforeDag.factsRoot:
        return fail("relfacts cross-profile delete failed")
    if !expectReplayError(
           crossProfile.text,
           [],
           webFacts,
           webBinding,
           webBinding,
           "relfacts_before_fact_count_mismatch"):
        return fail(
            "relfacts cross-profile wrong before state passed")
    if !expectReplayError(
           crossProfile.text,
           beforeFacts,
           webFacts,
           webBinding,
           webBinding,
           "relfacts_before_facts_root_mismatch"):
        return fail(
            "relfacts cross-profile wrong before profile passed")
    if !expectReplayError(
           crossProfile.text,
           beforeFacts,
           webFacts,
           coreBinding,
           coreBinding,
           "relfacts_after_facts_root_mismatch"):
        return fail(
            "relfacts cross-profile wrong after profile passed")

    os.WriteLine(os.Get_stderr(), "s9_crossprofile")
    let noncanonical = encodeTransition(
        [],
        ["{ \"kind\":\"csg.module\",\"id\":\"bad\"}"],
        coreBinding,
        coreBinding)
    if noncanonical.ok ||
       noncanonical.error !=
           "relfacts_after_facts_noncanonical":
        return fail(
            "relfacts noncanonical transition was not rejected")
    let duplicateKey = encodeTransition(
        [strings.CloneStr(moduleOld), strings.CloneStr(moduleNew)],
        afterFacts,
        coreBinding,
        coreBinding)
    if duplicateKey.ok:
        return fail(
            "relfacts duplicate transition key was not rejected")

    let duplicateAssert = relfacts.CsgCoreRelfactsEncode(
        [
            relfacts.CsgCoreRelfactsAssertOperation(strings.CloneStr(schema)),
            relfacts.CsgCoreRelfactsAssertOperation(strings.CloneStr(schema))
        ],
        [],
        [strings.CloneStr(schema)],
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid,
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid)
    if duplicateAssert.ok ||
       !strings.HasPrefix(
           duplicateAssert.error,
           "relfacts_encode_replay_failed relfacts_event_count_mismatch"):
        return fail("duplicate Assert was not rejected")
    let missingRetract = relfacts.CsgCoreRelfactsEncode(
        [relfacts.CsgCoreRelfactsRetractOperation(strings.CloneStr(schema))],
        [],
        [],
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid,
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid)
    if missingRetract.ok ||
       !strings.HasPrefix(
           missingRetract.error,
           "relfacts_encode_replay_failed relfacts_event_count_mismatch"):
        return fail("missing Retract was not rejected")
    let mismatchedRetract = relfacts.CsgCoreRelfactsEncode(
        [relfacts.CsgCoreRelfactsRetractOperation(strings.CloneStr(moduleNew))],
        [strings.CloneStr(moduleOld)],
        [strings.CloneStr(moduleOld)],
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid,
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid)
    if mismatchedRetract.ok ||
       !strings.HasPrefix(
           mismatchedRetract.error,
           "relfacts_encode_replay_failed relfacts_event_count_mismatch"):
        return fail("mismatched Retract was not rejected")
    let wrongOrder = relfacts.CsgCoreRelfactsEncode(
        [
            relfacts.CsgCoreRelfactsAssertOperation(strings.CloneStr(moduleNew)),
            relfacts.CsgCoreRelfactsRetractOperation(strings.CloneStr(moduleOld))
        ],
        beforeFacts,
        afterFacts,
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid,
        coreBinding.standard,
        coreBinding.profiles,
        coreBinding.schemaNamespace,
        coreBinding.schemaCid)
    if wrongOrder.ok ||
       !strings.HasPrefix(
           wrongOrder.error,
           "relfacts_encode_replay_failed relfacts_event 0 relfacts_deterministic_diff_mismatch"):
        return fail(
            "noncanonical diff order was not rejected")

    os.WriteLine(os.Get_stderr(), "s10_negatives1")
    let badSchema = replaceFirst(
        transition.text,
        "\"schema\":\"csg_relfacts::v1\"",
        "\"schema\":\"csg_relfacts::x1\"")
    if badSchema.len == 0 ||
       !expectReplayError(
           badSchema,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_schema_mismatch"):
        return fail("schema mismatch was not rejected")
    let badTransitionKind = replaceFirst(
        transition.text,
        "\"transition_kind\":\"canonical_delta\"",
        "\"transition_kind\":\"snapshot_plus_delta\"")
    if badTransitionKind.len == 0 ||
       !expectReplayError(
           badTransitionKind,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_transition_kind_mismatch"):
        return fail(
            "non-delta transition kind was not rejected")
    let badBeforeRoot = replaceFirst(
        transition.text,
        beforeDag.factsRoot,
        "sha256:2111111111111111111111111111111111111111111111111111111111111111")
    if badBeforeRoot.len == 0 ||
       !expectReplayError(
           badBeforeRoot,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_before_facts_root_mismatch"):
        return fail("before root mismatch was not rejected")
    let badAfterRoot = replaceFirst(
        transition.text,
        afterDag.factsRoot,
        "sha256:3111111111111111111111111111111111111111111111111111111111111111")
    if badAfterRoot.len == 0 ||
       !expectReplayError(
           badAfterRoot,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_after_facts_root_mismatch"):
        return fail("after root mismatch was not rejected")
    let badHash = replaceFirst(
        transition.text,
        "\"fact_hash\":\"sha256:",
        "\"fact_hash\":\"sha257:")
    if badHash.len == 0 ||
       !expectReplayError(
           badHash,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_event 0 relfacts_fact_hash_mismatch"):
        return fail("fact hash mismatch was not rejected")
    let badKey = replaceFirst(
        transition.text,
        "\"fact_key\":\"",
        "\"fact_key\":\"tampered-")
    if badKey.len == 0 ||
       !expectReplayError(
           badKey,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_event 0 relfacts_fact_key_mismatch"):
        return fail("fact key mismatch was not rejected")
    let badOperation = replaceFirst(
        transition.text,
        "\"op\":\"Retract\",\"ordinal\":0",
        "\"op\":\"Upsert\",\"ordinal\":0")
    if badOperation.len == 0 ||
       !expectReplayError(
           badOperation,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_event 0 relfacts_operation_invalid"):
        return fail("unknown operation was not rejected")
    let badOrdinal = replaceFirst(
        transition.text, "\"ordinal\":1", "\"ordinal\":0")
    if badOrdinal.len == 0 ||
       !expectReplayError(
           badOrdinal,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_event 1 relfacts_ordinal_mismatch"):
        return fail("ordinal mismatch was not rejected")

    os.WriteLine(os.Get_stderr(), "s11_tampers")
    let nonCanonicalRecord = replaceFirst(
        transition.text,
        "{\"after_fact_count\":",
        "{ \"after_fact_count\":")
    if nonCanonicalRecord.len == 0 ||
       !expectReplayError(
           nonCanonicalRecord,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_record_noncanonical"):
        return fail("noncanonical record was not rejected")
    let crlf = replaceFirst(transition.text, "\n", "\r\n")
    if crlf.len == 0 ||
       !expectReplayError(
           crlf,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_cr_forbidden"):
        return fail("CRLF sidecar was not rejected")
    let truncated = strings.CloneStrRange(
        transition.text, 0, transition.text.len - 1)
    if !expectReplayError(
           truncated,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_final_newline_missing"):
        return fail("truncated sidecar was not rejected")
    let completeRecordTruncated = dropLastRecord(
        transition.text)
    if completeRecordTruncated.len == 0 ||
       !expectReplayError(
           completeRecordTruncated,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_event_count_mismatch"):
        return fail(
            "complete-record truncation was not rejected")

    os.WriteLine(os.Get_stderr(), "s12_records")
    var invalidBytes = rawbytes.BytesAlloc(transition.text.len)
    rawbytes.BytesCopyInto(
        invalidBytes,
        0,
        rawbytes.BytesFromString(transition.text))
    rawbytes.BytesSet(invalidBytes, 1, 255)
    let invalidUtf8 = rawbytes.BytesToString(invalidBytes)
    rawbytes.BytesFree(invalidBytes)
    if !expectReplayError(
           invalidUtf8,
           beforeFacts,
           afterFacts,
           coreBinding,
           coreBinding,
           "relfacts_record_invalid invalid_utf8"):
        return fail("invalid UTF-8 sidecar was not rejected")

    os.WriteLine(os.Get_stderr(), "s13_invalidutf8")
    os.WriteLine(
        os.Get_stdout(),
        strings.ConcatStr(
            strings.ConcatStr(
                "csg_relfacts_sidecar_ok before_root=",
                replay.beforeFactsRoot),
            strings.ConcatStr(
                strings.ConcatStr(
                    " after_root=", replay.afterFactsRoot),
                " events=2 before_count=3 after_count=3")))
    return 0
