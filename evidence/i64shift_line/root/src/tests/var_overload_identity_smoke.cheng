type
    VarOverloadBox =
        value: int32

fn varOverloadSelect(box: VarOverloadBox): int32 =
    return 11

fn varOverloadSelect(box: var VarOverloadBox): int32 =
    box.value = 22
    return 22

fn varOverloadValueForward(box: VarOverloadBox): int32 =
    return varOverloadSelect(box)

fn varOverloadRefForward(box: var VarOverloadBox): int32 =
    return varOverloadSelect(box)

fn main(): int32 =
    var box: VarOverloadBox
    box.value = 1
    if varOverloadValueForward(box) != 11:
        return 1
    if box.value != 1:
        return 2
    if varOverloadRefForward(box) != 22:
        return 3
    if box.value != 22:
        return 4
    echo("var_overload_identity_smoke ok")
    return 0
