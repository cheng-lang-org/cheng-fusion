# R 接线算子冒烟: LayerNorm / BilinearResize2dNchw / ConcatChannelsNchw
# (kernel 补齐三类, 返回式 API, errOut var str 传递错误)。
# 真值: python 手算, 十进制定点 scale=1000 (值 = data/1000)。
import std/cmdline
import std/result
import std/strings
import std/rawbytes
import cheng/inference/kernel

fn approxQ(a: int32, b: int32, tol: int32): bool =
    var d = a - b
    if d < 0:
        d = 0 - d
    return d <= tol

fn main(): int32 =
    var err: str

    # ---- LayerNorm: [1,4] 值 0.1,0.2,0.3,0.4 @1000, gamma=1.0
    var lnIn: TensorQ
    lnIn.shape = []
    add(lnIn.shape, 1)
    add(lnIn.shape, 4)
    lnIn.scale = 1000
    var lnData: int32[]
    add(lnData, 100)
    add(lnData, 200)
    add(lnData, 300)
    add(lnData, 400)
    assert(!IsErr(TensorFromDataFill(lnIn, lnIn.shape, 1000, lnData)), "ln in fill")
    var gamma: TensorQ
    gamma.shape = []
    add(gamma.shape, 4)
    gamma.scale = 1000
    var gData: int32[]
    add(gData, 1000)
    add(gData, 1000)
    add(gData, 1000)
    add(gData, 1000)
    assert(!IsErr(TensorFromDataFill(gamma, gamma.shape, 1000, gData)), "gamma fill")
    var beta: TensorQ
    beta.scale = 1000
    var lnOut: TensorQ
    let lnRes = kernel.LayerNormFill(lnOut, lnIn, gamma, beta)
    assert(!IsErr(lnRes), Fmt"layernorm: {err}")
    assert(approxQ(lnOut.data[0], -1351, 20), Fmt"ln[0]={lnOut.data[0]}")
    assert(approxQ(lnOut.data[1], -450, 20), Fmt"ln[1]={lnOut.data[1]}")
    assert(approxQ(lnOut.data[2], 450, 20), Fmt"ln[2]={lnOut.data[2]}")
    assert(approxQ(lnOut.data[3], 1351, 20), Fmt"ln[3]={lnOut.data[3]}")

    # ---- BilinearResize2d: [1,1,2,2] 值 1,2,3,4 @1000 -> [1,1,4,4]
    var biIn: TensorQ
    biIn.shape = []
    add(biIn.shape, 1)
    add(biIn.shape, 1)
    add(biIn.shape, 2)
    add(biIn.shape, 2)
    biIn.scale = 1000
    var biData: int32[]
    add(biData, 1000)
    add(biData, 2000)
    add(biData, 3000)
    add(biData, 4000)
    assert(!IsErr(TensorFromDataFill(biIn, biIn.shape, 1000, biData)), "bi in fill")
    var biOut: TensorQ
    let biRes = kernel.BilinearResize2dNchwFill(biOut, biIn, 4, 4)
    assert(!IsErr(biRes), Fmt"bilinear: {err}")
    assert(biOut.data[0] == 1000, Fmt"bi[0]={biOut.data[0]}")
    assert(approxQ(biOut.data[1], 1250, 2), Fmt"bi[1]={biOut.data[1]}")
    assert(approxQ(biOut.data[5], 1750, 2), Fmt"bi[5]={biOut.data[5]}")
    assert(biOut.data[15] == 4000, Fmt"bi[15]={biOut.data[15]}")

    # ---- ConcatChannels: 5.0 + 7.0 -> [5,7]
    var ca: TensorQ
    ca.shape = []
    add(ca.shape, 1)
    add(ca.shape, 1)
    add(ca.shape, 1)
    add(ca.shape, 1)
    ca.scale = 1000
    var caData: int32[]
    add(caData, 5000)
    assert(!IsErr(TensorFromDataFill(ca, ca.shape, 1000, caData)), "ca fill")
    var cb: TensorQ
    cb.shape = []
    add(cb.shape, 1)
    add(cb.shape, 1)
    add(cb.shape, 1)
    add(cb.shape, 1)
    cb.scale = 1000
    var cbData: int32[]
    add(cbData, 7000)
    assert(!IsErr(TensorFromDataFill(cb, cb.shape, 1000, cbData)), "cb fill")
    var ccOut: TensorQ
    let ccRes = kernel.ConcatChannelsNchwFill(ccOut, ca, cb)
    assert(!IsErr(ccRes), Fmt"concat: {err}")
    assert(ccOut.shape[1] == 2, "concat channels")
    assert(ccOut.data[0] == 5000, "concat[0]")
    assert(ccOut.data[1] == 7000, "concat[1]")

    echo("csg_inference_ops_smoke PASS")
    return 0
