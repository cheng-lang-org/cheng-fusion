# libp2p P5-S2 门禁: 变长签名 provider-set 快照 codec 闭环 (设计 Part 1a + 3a①②)。
# exe run 非 census: 断言失败即 abort 非零, 末行 "ok" 才打印 (照 channel_head_signing_smoke 模式)。
#
# 结构层 (LIVE): 构记录 → sign → encode → decode 字段逐一等 + entry 往返恒等 + 0-entry 最小线;
#   畸形 (截断 / 错 tag / 跨型混淆 head→provider) 一律 decode 硬拒。
# 密码层 (真 ed25519 forgery-rejection, DEFAULT-ON LIVE): 正向 sign→verify true;
#   篡改 sig 一字节 → verify 拒; 篡改线体 epoch 字节 → 重解 verify 拒。

import std/system
import std/result
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import std/crypto/sha512 as sha512
import std/crypto/ed25519/ref10 as ref10
import cheng/libp2p/protocols/cas_source/channel_head/provider_set_codec as pset
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head

# 手工造真 ed25519 keypair (keyPairFromSeed conditional-let miscompile, 绕开)。
fn deriveKeypair(seedv: int32, priv: var Bytes, pub: var Bytes) =
    var seed = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(seed, i, (seedv + i) & 255)
    var digest = sha512.Sha512Digest(seed)
    BytesSet(digest, 0, BytesGet(digest, 0) & 248)
    BytesSet(digest, 31, (BytesGet(digest, 31) & 63) | 64)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, BytesSlice(digest, 0, 32))
    pub = ref10.geP3ToBytes(r)
    priv = BytesConcat(seed, pub)

fn mkCid(seed: int32): layout.FixedBytes32 =
    var b = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(b, i, (seed * 17 + i + 3) & 255)
    let r = layout.FixedBytes32FromBytes(b)
    assert(!IsErr(r), " mkCid 32B")
    return Value(r)

fn mkEntry(seed: int32, endpoint: str): pset.ProviderSetEntry =
    var e: pset.ProviderSetEntry
    e.channelId = mkCid(seed)
    e.endpoint = endpoint
    return e

fn main(): int32 =
    var privA: Bytes
    var pubA: Bytes
    deriveKeypair(11, privA, pubA)
    assert(BytesLen(privA) == 64, " privA 64B")
    assert(BytesLen(pubA) == 32, " pubA 32B")

    # ---- 构 2-entry 记录 → sign → encode → decode 往返恒等 ----
    var entries: pset.ProviderSetEntry[]
    add(entries, mkEntry(10, "127.0.0.1:7001"))
    add(entries, mkEntry(20, "10.0.0.2:9002"))
    var signRes = pset.ProviderSetSign(privA, pubA, int64(7), entries)
    assert(!IsErr(signRes), " sign: " + Error(signRes))
    var rec = Value(signRes)
    assert(BytesLen(rec.sig) == 64, " sig 64B")

    # 正向 verify-true (真 ed25519)
    assert(pset.ProviderSetVerify(rec), " 正向: verify(valid) == true")

    var encRes = pset.ProviderSetEncode(rec)
    assert(!IsErr(encRes), " encode: " + Error(encRes))
    var wire = Value(encRes)
    assert(BytesGet(wire, 0) == 0x50, " tag 0x50")
    # 线长 = 1+32+8+4 + 2*(32+2+len) + 64 = 109 + 2*(34) + (14+13) = 109+68+27 = 204
    assert(BytesLen(wire) == 204, " wire 长 = 204 (2 entry, endpoint 14+13B)")

    var decRes = pset.ProviderSetDecode(wire)
    assert(!IsErr(decRes), " decode: " + Error(decRes))
    var dec = Value(decRes)
    assert(dec.epoch == int64(7), " decode epoch=7")
    assert(rawbytes.BytesEqual(dec.signerPubKey, pubA), " decode signer 相等")
    assert(rawbytes.BytesEqual(dec.sig, rec.sig), " decode sig 相等")
    assert(dec.entries.len == 2, " decode entryCount=2")
    assert(layout.FixedBytes32Equal(dec.entries[0].channelId, entries[0].channelId), " entry0 channelId 相等")
    assert(dec.entries[0].endpoint == "127.0.0.1:7001", " entry0 endpoint 相等")
    assert(layout.FixedBytes32Equal(dec.entries[1].channelId, entries[1].channelId), " entry1 channelId 相等")
    assert(dec.entries[1].endpoint == "10.0.0.2:9002", " entry1 endpoint 相等")
    # 解回记录再验签 (往返后签名仍闭合)
    assert(pset.ProviderSetVerify(dec), " 往返后 verify(decoded) == true")
    # re-encode 字节逐字节精确
    var reRes = pset.ProviderSetEncode(dec)
    assert(!IsErr(reRes), " re-encode")
    assert(rawbytes.BytesEqual(wire, Value(reRes)), " re-encode 字节逐字节精确")

    # ---- 0-entry 最小线 (109B) 往返 ----
    var emptyEntries: pset.ProviderSetEntry[]
    var sign0 = pset.ProviderSetSign(privA, pubA, int64(3), emptyEntries)
    assert(!IsErr(sign0), " sign 0-entry")
    var enc0 = pset.ProviderSetEncode(Value(sign0))
    assert(!IsErr(enc0), " encode 0-entry")
    assert(BytesLen(Value(enc0)) == 109, " 0-entry wire = 109B (最小线)")
    var dec0 = pset.ProviderSetDecode(Value(enc0))
    assert(!IsErr(dec0), " decode 0-entry")
    assert(Value(dec0).entries.len == 0, " 0-entry decode entryCount=0")
    assert(pset.ProviderSetVerify(Value(dec0)), " 0-entry verify true")

    # ---- 密码层负1: 篡改 sig 一字节 → verify 拒 ----
    var tamperSig = rec
    var badSig = BytesAlloc(64)
    for i in 0..<64:
        BytesSet(badSig, i, BytesGet(rec.sig, i))
    BytesSet(badSig, 10, (BytesGet(badSig, 10) ^ 0x01) & 255)
    tamperSig.sig = badSig
    assert(!pset.ProviderSetVerify(tamperSig), " 负1: 篡改 sig 一字节 → verify 拒")

    # ---- 密码层负2: 篡改线体 epoch 字节 (off 33..40) → 重解 verify 拒 ----
    var badWire = BytesAlloc(BytesLen(wire))
    for i in 0..<BytesLen(wire):
        BytesSet(badWire, i, BytesGet(wire, i))
    BytesSet(badWire, 40, (BytesGet(badWire, 40) ^ 0x01) & 255)   # epoch 末字节翻转
    var badDecRes = pset.ProviderSetDecode(badWire)
    assert(!IsErr(badDecRes), " 篡改 epoch 线体仍结构合法 (decode 过)")
    assert(Value(badDecRes).epoch != int64(7), " 篡改后 epoch != 7")
    assert(!pset.ProviderSetVerify(Value(badDecRes)), " 负2: 篡改线体 epoch → verify 拒")

    # ---- 结构层负3: 截断 → decode 硬拒 (线长不足) ----
    var truncated = BytesSlice(wire, 0, 108)
    assert(IsErr(pset.ProviderSetDecode(truncated)), " 负3: 截断 108B → decode 拒 (线长不足)")

    # ---- 结构层负4: 错 tag → decode 硬拒 ----
    var badTag = BytesAlloc(BytesLen(wire))
    for i in 0..<BytesLen(wire):
        BytesSet(badTag, i, BytesGet(wire, i))
    BytesSet(badTag, 0, 0x10)
    assert(IsErr(pset.ProviderSetDecode(badTag)), " 负4: 错 tag 0x10 → decode 拒 (跨型混淆)")

    # ---- 结构层负5: 跨型混淆 (真 head 201B 记录喂 provider-set decode) → 硬拒 ----
    var hrec: head.ChannelHeadRecord
    hrec.channelId = head.ChannelIdForPubKey(pubA)
    hrec.epoch = int64(1)
    hrec.headCid = mkCid(30)
    hrec.prevHeadCid = head.ChannelHeadGenesisPrev()
    hrec.signerPubKey = pubA
    var hsig = BytesAlloc(64)
    hrec.sig = hsig
    var hencRes = head.ChannelHeadEncode(hrec)
    assert(!IsErr(hencRes), " head encode (跨型素材)")
    var hwire = Value(hencRes)
    assert(BytesGet(hwire, 0) == 0x10, " head wire tag 0x10")
    assert(IsErr(pset.ProviderSetDecode(hwire)), " 负5: head 记录喂 provider-set decode → 硬拒 (tag 0x10 != 0x50)")

    # ---- entryCount 膨胀攻击: 手改 entryCount 为巨大值但线体不足 → decode 硬拒 (越界) ----
    var infl = BytesAlloc(BytesLen(wire))
    for i in 0..<BytesLen(wire):
        BytesSet(infl, i, BytesGet(wire, i))
    BytesSet(infl, 41, 0x7F)   # entryCount 高字节拉爆
    assert(IsErr(pset.ProviderSetDecode(infl)), " 负6: entryCount 膨胀 → decode 拒 (entry 越界)")

    echo(" provider_set crypto-gate PASS (真 ed25519 forgery-rejection + 跨型混淆拒)")
    echo(" provider_set_codec_smoke ok")
    return 0
