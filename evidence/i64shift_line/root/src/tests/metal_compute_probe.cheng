# Metal compute probe (G-stage scout): dispatch a minimal vector-add compute
# kernel on the default GPU device straight from a pure-cheng program, using
# the same @importc objc_msgSend bridge pattern as
# src/core/runtime/core_runtime_provider_darwin.cheng.
# All ObjC/Metal calls stay in the bridge section; the result assertion is
# pure cheng. PASS prints "PASS metal compute probe" (rc 0); every failure
# prints its exact stage and returns a distinct nonzero rc.

import std/strings as strings

type
    Int32Ptr = int32 *
    ProbeMetalSize =
        width: uint64
        height: uint64
        depth: uint64

# ---- bridge section: ObjC/Metal boundary ----
@importc("MTLCreateSystemDefaultDevice")
fn probe_mtl_create_system_default_device(): ptr
@importc("objc_getClass")
fn probe_objc_get_class(name: ptr): ptr
@importc("sel_registerName")
fn probe_sel_register_name(name: ptr): ptr
@importc("objc_autoreleasePoolPush")
fn probe_objc_autorelease_pool_push(): ptr
@importc("objc_autoreleasePoolPop")
fn probe_objc_autorelease_pool_pop(pool: ptr)
@importc("objc_msgSend")
fn probe_msg_send0(receiver: ptr, sel: ptr): ptr
@importc("objc_msgSend")
fn probe_msg_send_u64_return(receiver: ptr, sel: ptr): uint64
@importc("objc_msgSend")
fn probe_msg_send_ptr(receiver: ptr, sel: ptr, a0: ptr): ptr
@importc("objc_msgSend")
fn probe_msg_send_ptr_ptr(receiver: ptr, sel: ptr, a0: ptr, a1: ptr): ptr
@importc("objc_msgSend")
fn probe_msg_send_ptr_ptr_ptr(receiver: ptr, sel: ptr, a0: ptr, a1: ptr, a2: ptr): ptr
@importc("objc_msgSend")
fn probe_msg_send_ptr_u64_u64(receiver: ptr, sel: ptr, a0: ptr, a1: uint64, a2: uint64): ptr
@importc("objc_msgSend")
fn probe_msg_send_u64_u64(receiver: ptr, sel: ptr, a0: uint64, a1: uint64): ptr
@importc("objc_msgSend")
fn probe_msg_send_set_buffer(receiver: ptr, sel: ptr, buffer: ptr, offset: ptr, index: ptr)
@importc("objc_msgSend")
fn probe_msg_send_set_pipeline(receiver: ptr, sel: ptr, pipeline: ptr)
@importc("objc_msgSend")
fn probe_msg_send_void0(receiver: ptr, sel: ptr)
@importc("objc_msgSend")
fn probe_msg_send_dispatch_threads(receiver: ptr, sel: ptr, grid: ProbeMetalSize, group: ProbeMetalSize)
@importc("malloc")
fn probe_libc_malloc(size: int64): ptr
@importc("free")
fn probe_libc_free(p: ptr)

const
    ProbeElemCount: int32 = 4
    ProbeBytes: int32 = 16
    ProbeMsl = "kernel void add(device const int* a, device const int* b, device int* c, uint id [[thread_position_in_grid]]) { c[id] = a[id] + b[id]; }"

fn probe_ptr_plus(base: ptr, off: int32): ptr =
    if base == nil:
        return nil
    return ptr(uint64(base) + uint64(off))

fn probe_nsstring(cstr: ptr): ptr =
    if cstr == nil:
        return nil
    let nsStringClass: ptr = probe_objc_get_class("NSString")
    if nsStringClass == nil:
        return nil
    let selUtf8: ptr = probe_sel_register_name("stringWithUTF8String:")
    if selUtf8 == nil:
        return nil
    return probe_msg_send_ptr(nsStringClass, selUtf8, cstr)

fn probe_release(obj: ptr) =
    if obj == nil:
        return
    let selRelease: ptr = probe_sel_register_name("release")
    if selRelease == nil:
        return
    let _ = probe_msg_send0(obj, selRelease)
# ---- end bridge section ----

fn main(): int32 =
    var aHost: int32[4] = [2, 3, 5, 7]
    var bHost: int32[4] = [10, 20, 30, 40]
    var pool: ptr = probe_objc_autorelease_pool_push()
    var queue: ptr
    var library: ptr
    var functionObj: ptr
    var pipeline: ptr
    var bufferA: ptr
    var bufferB: ptr
    var bufferC: ptr
    var hostA: ptr
    var hostB: ptr
    let device: ptr = probe_mtl_create_system_default_device()
    if device == nil:
        echo("FAIL stage=device")
        return 2
    queue = probe_msg_send0(device, probe_sel_register_name("newCommandQueue"))
    if queue == nil:
        echo("FAIL stage=queue")
        return 3
    let fnName: str = "add"
    let mslSource: str = ProbeMsl
    let mslString: ptr = probe_nsstring(mslSource.data)
    if mslString == nil:
        echo("FAIL stage=msl-nsstring")
        return 4
    var libraryError: ptr
    library = probe_msg_send_ptr_ptr_ptr(device, probe_sel_register_name("newLibraryWithSource:options:error:"), mslString, nil, ptr(&libraryError))
    if library == nil:
        echo("FAIL stage=library-compile")
        return 5
    let nameString: ptr = probe_nsstring(fnName.data)
    if nameString == nil:
        echo("FAIL stage=fn-nsstring")
        return 6
    functionObj = probe_msg_send_ptr(library, probe_sel_register_name("newFunctionWithName:"), nameString)
    if functionObj == nil:
        echo("FAIL stage=function")
        return 7
    var pipelineError: ptr
    pipeline = probe_msg_send_ptr_ptr(device, probe_sel_register_name("newComputePipelineStateWithFunction:error:"), functionObj, ptr(&pipelineError))
    if pipeline == nil:
        echo("FAIL stage=pipeline")
        return 8
    hostA = probe_libc_malloc(int64(ProbeBytes))
    hostB = probe_libc_malloc(int64(ProbeBytes))
    if hostA == nil || hostB == nil:
        echo("FAIL stage=host-mem")
        return 9
    var i: int32 = 0
    while i < ProbeElemCount:
        *(Int32Ptr(probe_ptr_plus(hostA, i * 4))) = aHost[i]
        *(Int32Ptr(probe_ptr_plus(hostB, i * 4))) = bHost[i]
        i = i + 1
    bufferA = probe_msg_send_ptr_u64_u64(device, probe_sel_register_name("newBufferWithBytes:length:options:"), hostA, uint64(ProbeBytes), uint64(0))
    bufferB = probe_msg_send_ptr_u64_u64(device, probe_sel_register_name("newBufferWithBytes:length:options:"), hostB, uint64(ProbeBytes), uint64(0))
    bufferC = probe_msg_send_u64_u64(device, probe_sel_register_name("newBufferWithLength:options:"), uint64(ProbeBytes), uint64(0))
    if bufferA == nil || bufferB == nil || bufferC == nil:
        echo("FAIL stage=buffer")
        return 10
    let commandBuffer: ptr = probe_msg_send0(queue, probe_sel_register_name("commandBuffer"))
    if commandBuffer == nil:
        echo("FAIL stage=command-buffer")
        return 11
    let encoder: ptr = probe_msg_send0(commandBuffer, probe_sel_register_name("computeCommandEncoder"))
    if encoder == nil:
        echo("FAIL stage=encoder")
        return 12
    probe_msg_send_set_pipeline(encoder, probe_sel_register_name("setComputePipelineState:"), pipeline)
    let selSetBuffer: ptr = probe_sel_register_name("setBuffer:offset:atIndex:")
    probe_msg_send_set_buffer(encoder, selSetBuffer, bufferA, ptr(uint64(0)), ptr(uint64(0)))
    probe_msg_send_set_buffer(encoder, selSetBuffer, bufferB, ptr(uint64(0)), ptr(uint64(1)))
    probe_msg_send_set_buffer(encoder, selSetBuffer, bufferC, ptr(uint64(0)), ptr(uint64(2)))
    let grid = ProbeMetalSize(width: uint64(ProbeElemCount), height: uint64(1), depth: uint64(1))
    let group = ProbeMetalSize(width: uint64(ProbeElemCount), height: uint64(1), depth: uint64(1))
    probe_msg_send_dispatch_threads(encoder, probe_sel_register_name("dispatchThreads:threadsPerThreadgroup:"), grid, group)
    probe_msg_send_void0(encoder, probe_sel_register_name("endEncoding"))
    probe_msg_send_void0(commandBuffer, probe_sel_register_name("commit"))
    probe_msg_send_void0(commandBuffer, probe_sel_register_name("waitUntilCompleted"))
    let status: uint64 = probe_msg_send_u64_return(commandBuffer, probe_sel_register_name("status"))
    if status != uint64(4):
        echo("FAIL stage=gpu-status code=" + strings.IntToStr(int32(status)))
        return 13
    let contents: ptr = probe_msg_send0(bufferC, probe_sel_register_name("contents"))
    if contents == nil:
        echo("FAIL stage=contents")
        return 14
    var j: int32 = 0
    while j < ProbeElemCount:
        let got: int32 = *(Int32Ptr(probe_ptr_plus(contents, j * 4)))
        let want: int32 = aHost[j] + bHost[j]
        if got != want:
            echo("FAIL stage=assert index=" + strings.IntToStr(j) + " got=" + strings.IntToStr(got) + " want=" + strings.IntToStr(want))
            return 15
        j = j + 1
    probe_release(bufferC)
    probe_release(bufferB)
    probe_release(bufferA)
    probe_release(pipeline)
    probe_release(functionObj)
    probe_release(library)
    probe_release(queue)
    probe_libc_free(hostB)
    probe_libc_free(hostA)
    if pool != nil:
        probe_objc_autorelease_pool_pop(pool)
    echo("PASS metal compute probe")
    return 0
