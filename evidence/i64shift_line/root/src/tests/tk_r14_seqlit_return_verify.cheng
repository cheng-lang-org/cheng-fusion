fn R14PhaseNames(): str[] =
    return ["system_link_plan",
            "compiler_csg",
            "lowering_plan"]

fn main(): int32 =
    let names = R14PhaseNames()
    if names.len != 3:
        return 10
    if names[0] != "system_link_plan":
        return 11
    if names[1] != "compiler_csg":
        return 12
    if names[2] != "lowering_plan":
        return 13
    echo(Fmt"r14_seqlit_return ok n={names.len} first={names[0]} last={names[2]}")
    return 0
