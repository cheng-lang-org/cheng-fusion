import std/system

fn TkR16MutKindText(kind: int32): str =
    if kind == 1:
        return "TkR16PatternBinding"
    if kind == 2:
        return "TkR16PatternWildcard"
    panic("tk_r16: invalid pattern kind")

fn main(): int32 =
    let a = TkR16MutKindText(1)
    if a != "TkR16PatternWildcard":
        return 24
    echo(Fmt"tk_r16 mutant ok a={a}")
    return 0
