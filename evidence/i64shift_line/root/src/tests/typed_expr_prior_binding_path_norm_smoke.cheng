import std/result
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/intern as langintern

fn appendDeclStatement(ir: var texpr.TypedExprIr,
                        sourcePath: str,
                        functionName: str,
                        lineNumber: int32,
                        bindingName: str,
                        resultType: str) =
    var stmt: texpr.TypedExprIrStatement
    stmt.sourcePath = sourcePath
    stmt.functionName = functionName
    stmt.lineNumber = lineNumber
    stmt.bindingName = bindingName
    stmt.resultType = resultType
    stmt.kind = texpr.TypedExprIrStmtLocalDecl
    stmt.statementIndex = ir.statements2_statementIndexs.len
    stmt.assignLvalueNodeIndex = -1
    texpr.TypedExprIrAppendStatement(ir, stmt)
    texpr.TypedExprStatementFunctionIndexRegister(ir, ir.statements2_statementIndexs.len - 1)

fn main(): int32 =
    var ir: texpr.TypedExprIr
    ir.internPool = langintern.InternPoolNew()
    # 同一逻辑源, 写入时raw路径带"./"前缀, 查询时不带 -- 词法上等价
    # (TypedExprLexicalSourcePath 会把 "./" 段吃掉), 但朴素字符串 != 会误判
    # 成"跨源", 导致同源合法回退查找被拒(回归: patch 前该场景本就能查到)。
    appendDeclStatement(ir, "./fixtures/same.cheng", "SameSrc", 10, "v", "int32")
    let typeQueryNoPrefix = texpr.TypedExprIrPriorBindingType(ir, "fixtures/same.cheng", "SameSrc", 11, "v")
    if typeQueryNoPrefix != "int32":
        return 1
    return 0
