import std/result
import std/strformat
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower
import cheng/core/lang/intern as langintern
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/runtime/arena as arenamod
import cheng/core/tooling/compiler_csg as ccsg

fn semanticSourcePath(): str =
    return "/work/pkg/semantic_overload.cheng"

fn semanticModulePath(): str =
    return "pkg/semantic_overload"

fn semanticContext(): texpr.TypedExprSourceContext =
    var externalRoots: parser.ParserExternalPackageRoot[]
    let source = texpr.TypedExprSourceTextNewWithPackageFacts(
        "/work",
        "/work/pkg",
        "pkg://semantic-identity",
        "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        externalRoots,
        semanticSourcePath(),
        "fn Pick(value: int32): int32 = value\nfn Pick(value: str): str = value\n")
    var context: texpr.TypedExprSourceContext
    var err: str
    assert(texpr.TypedExprBuildSourceContext(source, context, err),
           Fmt"semantic identity smoke: context build failed {err}")
    return context

fn appendTypedFunction(plan: var lower.LoweringPlanStub,
                       line: int32,
                       returnType: str) =
    var fnIr: texpr.TypedExprIrFunction
    fnIr.sourcePath = semanticSourcePath()
    fnIr.functionName = "Pick"
    fnIr.signatureLineNumber = line
    fnIr.endLineNumber = line
    fnIr.bodyLineNumber = line
    fnIr.returnType = returnType
    fnIr.returnNodeIndex = -1
    texpr.TypedExprIrAppendFunction(plan.typedIr, fnIr)

fn initPlan(plan: var lower.LoweringPlanStub,
            reverseTypedOrder: bool) =
    lower.LoweringPlanReleaseAllPayload(plan)
    plan.workspaceRoot = "/work"
    plan.packageRoot = "/work/pkg"
    var context = semanticContext()
    var contexts: texpr.TypedExprSourceContext[]
    texpr.TypedExprSourceContextAppendMove(contexts, context)
    plan.typedIr.buildIndex = texpr.TypedExprBuildIndexForContexts(contexts, 16)
    plan.typedIr.buildIndexGeneration = plan.typedIr.buildIndex.buildGeneration
    plan.typedIr.internPool = langintern.InternPoolNew()
    if reverseTypedOrder:
        appendTypedFunction(plan, 2, "str")
        appendTypedFunction(plan, 1, "int32")
    else:
        appendTypedFunction(plan, 1, "int32")
        appendTypedFunction(plan, 2, "str")
    let _ = langintern.Intern(plan.typedIr.internPool, "pick_i32")
    var identityErr: str
    assert(lower.LoweringBuildTypedFunctionIdentityIndex(plan, identityErr),
           Fmt"semantic identity smoke: identity index build failed {identityErr}")

fn semanticNode(line: int32): ccsg.CompilerCsgNode =
    var node: ccsg.CompilerCsgNode
    node.nodeKind = ccsg.CompilerCsgNodeKindSymbol
    node.modulePath = semanticModulePath()
    node.factText = "Pick"
    node.semanticSource = semanticModulePath()
    node.semanticDeclarationLineIndex = line
    node.semanticSignatureComplete = 1
    if line == 1:
        node.symbolText = "pkg/semantic_overload::Pick(int32)"
        node.semanticParamTypeJoin = "int32"
        node.semanticReturnType = "int32"
        node.exportedFlag = 1
        node.exportSymbolName = "pick_i32"
        node.entryFlag = 1
        node.callConv = 11
        node.resultLayoutKind = 101
    else:
        node.symbolText = "pkg/semantic_overload::Pick(str)"
        node.semanticParamTypeJoin = "str"
        node.semanticReturnType = "str"
        node.exportedFlag = 0
        node.exportSymbolName = ""
        node.entryFlag = 0
        node.callConv = 22
        node.resultLayoutKind = 202
    return node

fn rowAtLine(plan: lower.LoweringPlanStub, line: int32): int32 =
    var found: int32 = -1
    for rowIndex in 0..<plan.functionSemanticDeclarationLineIndexes.len:
        if plan.functionSemanticDeclarationLineIndexes[rowIndex] != line:
            continue
        assert(found < 0,
               Fmt"semantic identity smoke: duplicate plan row line={line}")
        found = rowIndex
    return found

fn assertNodeAttributes(plan: var lower.LoweringPlanStub,
                        node: ccsg.CompilerCsgNode) =
    let rowIndex = rowAtLine(plan, node.semanticDeclarationLineIndex)
    assert(rowIndex >= 0,
           Fmt"semantic identity smoke: row missing line={node.semanticDeclarationLineIndex}")
    assert(plan.functionSourcePaths[rowIndex] == semanticSourcePath() &&
           plan.functionNames[rowIndex] == node.factText &&
           plan.functionSymbolTexts[rowIndex] == node.symbolText &&
           plan.functionSemanticSources[rowIndex] == node.semanticSource &&
           plan.functionSemanticParamTypeJoins[rowIndex] == node.semanticParamTypeJoin &&
           plan.functionSemanticReturnTypes[rowIndex] == node.semanticReturnType &&
           plan.functionSemanticSignatureCompletes[rowIndex] == 1 &&
           plan.functionExportedFlags[rowIndex] == node.exportedFlag &&
           plan.functionExportSymbolNames[rowIndex] == node.exportSymbolName &&
           plan.functionEntryFlags[rowIndex] == node.entryFlag &&
           plan.functionCallConvs[rowIndex] == node.callConv &&
           plan.functionResultLayoutKinds[rowIndex] == node.resultLayoutKind &&
           plan.functionSignatureLineNumbers[rowIndex] == node.semanticDeclarationLineIndex,
           Fmt"semantic identity smoke: attributes crossed line={node.semanticDeclarationLineIndex}")
    let typedIndex = plan.functionTypedIrIndexes[rowIndex]
    assert(typedIndex >= 0 &&
           typedIndex < plan.typedIr.functions2_signatureLineNumbers.len &&
           arenamod.ArenaArrayInt32Get(plan.typedIr.arena,
                                       plan.typedIr.functions2_signatureLineNumbers,
                                       typedIndex) == node.semanticDeclarationLineIndex,
           Fmt"semantic identity smoke: typed index crossed line={node.semanticDeclarationLineIndex}")

fn runOrderCase(reverseNodes: bool,
                reverseTypedOrder: bool) =
    var plan: lower.LoweringPlanStub
    initPlan(plan, reverseTypedOrder)
    var claimed: bool[]
    setLen(claimed, plan.typedIr.functions2_functionNameIds.len)
    let intNode = semanticNode(1)
    let strNode = semanticNode(2)
    var err: str
    if reverseNodes:
        assert(lower.LoweringAppendCompilerCsgSemanticFunctionRow(
                   plan, strNode, semanticSourcePath(), claimed, err),
               Fmt"semantic identity smoke: str bind failed {err}")
        assert(lower.LoweringAppendCompilerCsgSemanticFunctionRow(
                   plan, intNode, semanticSourcePath(), claimed, err),
               Fmt"semantic identity smoke: int bind failed {err}")
    else:
        assert(lower.LoweringAppendCompilerCsgSemanticFunctionRow(
                   plan, intNode, semanticSourcePath(), claimed, err),
               Fmt"semantic identity smoke: int bind failed {err}")
        assert(lower.LoweringAppendCompilerCsgSemanticFunctionRow(
                   plan, strNode, semanticSourcePath(), claimed, err),
               Fmt"semantic identity smoke: str bind failed {err}")
    assert(lower.LoweringValidateFunctionSemanticIdentityRows(plan, err),
           Fmt"semantic identity smoke: row validation failed {err}")
    assertNodeAttributes(plan, intNode)
    assertNodeAttributes(plan, strNode)
    lower.LoweringPlanReleaseAllPayload(plan)

fn runMissingIdentityCase() =
    var plan: lower.LoweringPlanStub
    initPlan(plan, false)
    var claimed: bool[]
    setLen(claimed, plan.typedIr.functions2_functionNameIds.len)
    var node = semanticNode(1)
    node.semanticDeclarationLineIndex = 99
    var err: str
    assert(!lower.LoweringAppendCompilerCsgSemanticFunctionRow(
               plan, node, semanticSourcePath(), claimed, err) &&
           strutil.Contains(err, "match count") &&
           plan.functionNames.len == 0,
           Fmt"semantic identity smoke: missing identity accepted {err}")
    lower.LoweringPlanReleaseAllPayload(plan)

fn runAmbiguousTypedIdentityCase() =
    var plan: lower.LoweringPlanStub
    initPlan(plan, false)
    appendTypedFunction(plan, 1, "int32")
    var err: str
    assert(!lower.LoweringBuildTypedFunctionIdentityIndex(plan, err) &&
           strutil.Contains(err, "duplicate typed ir semantic identity") &&
           lower.LoweringTypedFunctionIdentityIndexRetainedItemCount(plan) == 0,
           Fmt"semantic identity smoke: ambiguous typed identity accepted {err}")
    lower.LoweringPlanReleaseAllPayload(plan)

fn runDuplicateCsgIdentityCase() =
    var plan: lower.LoweringPlanStub
    initPlan(plan, false)
    var claimed: bool[]
    setLen(claimed, plan.typedIr.functions2_functionNameIds.len)
    let node = semanticNode(1)
    var err: str
    assert(lower.LoweringAppendCompilerCsgSemanticFunctionRow(
               plan, node, semanticSourcePath(), claimed, err),
           Fmt"semantic identity smoke: duplicate setup failed {err}")
    err = ""
    assert(!lower.LoweringAppendCompilerCsgSemanticFunctionRow(
               plan, node, semanticSourcePath(), claimed, err) &&
           strutil.Contains(err, "duplicate compiler csg semantic identity") &&
           plan.functionNames.len == 1,
           Fmt"semantic identity smoke: duplicate csg identity accepted {err}")
    lower.LoweringPlanReleaseAllPayload(plan)

fn runSignatureDriftCases() =
    var paramPlan: lower.LoweringPlanStub
    initPlan(paramPlan, false)
    var paramClaimed: bool[]
    setLen(paramClaimed, paramPlan.typedIr.functions2_functionNameIds.len)
    var paramNode = semanticNode(1)
    paramNode.semanticParamTypeJoin = "uint64"
    var err: str
    assert(!lower.LoweringAppendCompilerCsgSemanticFunctionRow(
               paramPlan, paramNode, semanticSourcePath(), paramClaimed, err) &&
           strutil.Contains(err, "parameter identity not unique") &&
           paramPlan.functionNames.len == 0,
           Fmt"semantic identity smoke: parameter drift accepted {err}")
    lower.LoweringPlanReleaseAllPayload(paramPlan)

    var returnPlan: lower.LoweringPlanStub
    initPlan(returnPlan, true)
    var returnClaimed: bool[]
    setLen(returnClaimed, returnPlan.typedIr.functions2_functionNameIds.len)
    var returnNode = semanticNode(2)
    returnNode.semanticReturnType = "uint64"
    err = ""
    assert(!lower.LoweringAppendCompilerCsgSemanticFunctionRow(
               returnPlan, returnNode, semanticSourcePath(), returnClaimed, err) &&
           strutil.Contains(err, "return type drift") &&
           returnPlan.functionNames.len == 0,
           Fmt"semantic identity smoke: return drift accepted {err}")
    lower.LoweringPlanReleaseAllPayload(returnPlan)

fn runLargeIdentityIndexProbe() =
    let functionCount: int32 = 4096
    let sourcePath = "/work/pkg/semantic_identity_scale.cheng"
    var plan: lower.LoweringPlanStub
    plan.workspaceRoot = "/work"
    plan.typedIr.internPool = langintern.InternPoolNew()
    for functionIndex in 0..<functionCount:
        var fnIr: texpr.TypedExprIrFunction
        fnIr.sourcePath = sourcePath
        fnIr.functionName = Fmt"IdentityProbe{functionIndex}"
        fnIr.signatureLineNumber = functionIndex + 1
        fnIr.endLineNumber = functionIndex + 1
        fnIr.bodyLineNumber = functionIndex + 1
        fnIr.returnType = "int32"
        fnIr.returnNodeIndex = -1
        texpr.TypedExprIrAppendFunction(plan.typedIr, fnIr)
    var err: str
    assert(lower.LoweringBuildTypedFunctionIdentityIndex(plan, err),
           Fmt"semantic identity smoke: large index build failed {err}")
    assert(plan.typedFunctionIdentityBuildFunctionCount == functionCount &&
           plan.typedFunctionIdentityBuildBucketVisitCount <= functionCount * 8 &&
           lower.LoweringTypedFunctionIdentityIndexRetainedItemCount(plan) > 0 &&
           lower.LoweringTypedFunctionIdentityIndexCapacityEstimateBytes(plan) > Int64(0),
           Fmt"semantic identity smoke: large index build complexity functions={plan.typedFunctionIdentityBuildFunctionCount} visits={plan.typedFunctionIdentityBuildBucketVisitCount}")
    for functionIndex in 0..<functionCount:
        var typedSourcePath: str
        var typedFunctionIndex: int32
        err = ""
        assert(lower.LoweringTypedIrExactSemanticIdentityIndex(
                   plan,
                   sourcePath,
                   Fmt"IdentityProbe{functionIndex}",
                   functionIndex + 1,
                   typedSourcePath,
                   typedFunctionIndex,
                   err) &&
               typedSourcePath == sourcePath &&
               typedFunctionIndex == functionIndex,
               Fmt"semantic identity smoke: large lookup failed index={functionIndex} actual={typedFunctionIndex} err={err}")
    assert(plan.typedFunctionIdentityLookupCount == functionCount &&
           plan.typedFunctionIdentityLookupBucketVisitCount <= functionCount * 8,
           Fmt"semantic identity smoke: lookup complexity count={plan.typedFunctionIdentityLookupCount} visits={plan.typedFunctionIdentityLookupBucketVisitCount} max={plan.typedFunctionIdentityLookupMaxBucketVisitCount}")
    lower.LoweringPlanReleaseTypedFunctionIdentityIndexPayload(plan)
    assert(lower.LoweringTypedFunctionIdentityIndexRetainedItemCount(plan) == 0 &&
           lower.LoweringTypedFunctionIdentityIndexCapacityEstimateBytes(plan) == Int64(0) &&
           plan.typedFunctionIdentityBuildFunctionCount == functionCount &&
           plan.typedFunctionIdentityLookupCount == functionCount,
           " semantic identity smoke: identity index release lost counters or retained capacity")
    lower.LoweringPlanReleaseAllPayload(plan)

fn main(): int32 =
    runOrderCase(false, true)
    runOrderCase(true, false)
    runMissingIdentityCase()
    runAmbiguousTypedIdentityCase()
    runDuplicateCsgIdentityCase()
    runSignatureDriftCases()
    runLargeIdentityIndexProbe()
    echo("compiler_csg_lowering_semantic_identity_smoke=ok")
    return 0
