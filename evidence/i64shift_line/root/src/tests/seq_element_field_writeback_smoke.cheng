import std/system

type
    Item =
        value: int32
        tail: int32

fn chooseIndex(seed: int32): int32 =
    if seed > 0: return 1
    return 0

fn main(): int32 =
    var items: Item[]
    add(items, Item(value: 1, tail: 2))
    add(items, Item(value: 3, tail: 4))

    let i: int32 = chooseIndex(9)
    items[i].value = 42

    assert(items[0].value == 1, " seq element field writeback: other element value preserved")
    assert(items[0].tail == 2, " seq element field writeback: other element tail preserved")
    assert(items[1].value == 42, " seq element field writeback: dynamic element value")
    assert(items[1].tail == 4, " seq element field writeback: dynamic element tail preserved")
    echo(" seq_element_field_writeback_smoke ok")
    return 0
