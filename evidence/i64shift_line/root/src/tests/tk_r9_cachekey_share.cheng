type
    R9Task =
        cacheKey: str
        cacheObjectPath: str
        cacheReportPath: str
        cacheBindingPath: str

fn R9CacheKey(index: int32): str =
    return Fmt"provider{index}key"

fn R9Join(dir: str, name: str): str =
    return Fmt"{dir}/{name}"

fn R9Build(tasks: var R9Task[]): bool =
    tasks = []
    for i in 0..<2:
        let cacheKey = R9CacheKey(int32(i))
        var task: R9Task
        task.cacheKey = share(cacheKey)
        task.cacheObjectPath = R9Join("cachedir", Fmt"{cacheKey}.o")
        task.cacheReportPath = R9Join("cachedir", Fmt"{cacheKey}.report.txt")
        task.cacheBindingPath = R9Join("cachedir", Fmt"{cacheKey}.binding.txt")
        add(tasks, task)
    return true

fn main(): int32 =
    var tasks: R9Task[]
    if !R9Build(tasks):
        return 10
    if tasks.len != 2:
        return 11
    if tasks[0].cacheKey != "provider0key":
        return 12
    if tasks[1].cacheObjectPath != "cachedir/provider1key.o":
        return 13
    if tasks[1].cacheBindingPath != "cachedir/provider1key.binding.txt":
        return 14
    echo(Fmt"r9_cachekey ok key={tasks[0].cacheKey} obj={tasks[1].cacheObjectPath} bind={tasks[1].cacheBindingPath}")
    return 0
