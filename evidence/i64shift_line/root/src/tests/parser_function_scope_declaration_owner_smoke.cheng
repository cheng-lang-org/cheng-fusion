import cheng/core/lang/parser as parser
import cheng/core/runtime/arena as arena

fn main() =
    let source =
        "fn main() int32 =\n    echo(\"hello\")\n    return 0\n"
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(
               "parser_function_scope_declaration_owner.cheng",
               source,
               layer,
               err),
           Fmt"parser function scope owner: parse failed {err}")
    assert(layer.scopes.len == 2,
           "parser function scope owner: scope cardinality")
    let tree = layer.valueExprTree
    let scope = layer.scopes[1]
    let declarationRow = scope.ownerDeclarationRow
    assert(scope.parentScopeId == 0 &&
           scope.kind == parser.NormalizedScopeIndentedSuite &&
           scope.ownerStatementOrdinal == -1 &&
           scope.ownerStatementRow == -1 &&
           !scope.moduleRootAnchor &&
           declarationRow >= 0 &&
           declarationRow < tree.declarationCount,
           "parser function scope owner: exclusive declaration authority")
    let declarationKind = arena.ArenaArrayInt32Get(
        tree.arena, tree.declarationKinds, declarationRow)
    let declarationNameToken = arena.ArenaArrayInt32Get(
        tree.arena, tree.declarationNameTokenIndexes, declarationRow)
    let suiteScopeRow = arena.ArenaArrayInt32Get(
        tree.arena,
        tree.declarationSuiteLexicalScopeRows,
        declarationRow)
    assert(declarationKind == Int32(parser.ParserDeclarationFunction) &&
           scope.anchorTokenIndex == declarationNameToken &&
           suiteScopeRow >= 0 &&
           arena.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeKinds,
               suiteScopeRow) ==
               Int32(parser.ParserDeclarationLexicalScopeFunction) &&
           arena.ArenaArrayInt32Get(
               tree.arena,
               tree.declarationLexicalScopeOwnerDeclarationRows,
               suiteScopeRow) == declarationRow,
           "parser function scope owner: parser row join")
    for exprIndex in 0..<layer.exprs.len:
        assert(layer.exprs[exprIndex].lineNumber > 0,
               Fmt"parser function scope owner: expression line row={exprIndex}")
    parser.NormalizedExprLayerReset(layer)
    echo("parser_function_scope_declaration_owner=PASS")
