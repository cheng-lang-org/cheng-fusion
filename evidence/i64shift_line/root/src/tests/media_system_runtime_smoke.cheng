        " media system runtime: audio output attach rejects wrong provider")
    let audioWrongStatusRes = media.MediaAudioReceiptAttachOutput(audioFirstForCsg,
                                                                  audioSession,
                                                                  audioSession.audioProvider,
                                                                  0,
                                                                  media.MediaPlaybackStatePlaying,
                                                                  audioFirst.sampleRateHz,
                                                                  audioFirst.channelCount,
                                                                  audioFirst.bitsPerSample,
                                                                  audioFirst.pcmDataOffset,
                                                                  audioFirst.pcmDataBytes,
                                                                  "android-audiotrack:wrong-status")
