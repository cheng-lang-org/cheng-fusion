        " media system runtime: audio remote open kind")
    assert(audioOpenEvent.manifestCid == audioIngest.manifestCid,
        " media system runtime: audio remote open manifest")
    let imageFirstAudioRes = media.MediaFirstAudioFromPinnedSession(index, imageSession)
    assert(IsErr(imageFirstAudioRes), " media system runtime: image first audio rejected")
    let audioFirstImageRes = media.MediaFirstImageFromPinnedSession(index, audioSession)
    assert(IsErr(audioFirstImageRes), " media system runtime: audio first image rejected")
    var shareAudioRequest = media.MediaControlRequest(
        slotId: audioSession.slotId,
        actionKind: "ShareAsset",
        payload: audioIngest.assetCid,
        guard: strutil.Join(["assetCid:", audioSession.assetCid], ""),
        trace: "typed-action:ShareAsset"
