    assert(play.dispatch == session.eventQueue, " media system runtime: play dispatch")
    assert(play.stateCode == media.MediaPlaybackStatePlaying, " media system runtime: playing state")
    assert(len(play.receiptCid) > 0, " media system runtime: play receipt cid")
    assert(strutil.Contains(play.trace, "typed-action:Play"), " media system runtime: play trace")
