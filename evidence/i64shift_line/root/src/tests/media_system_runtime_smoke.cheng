    assert(edit.kindCode == media.MediaAssetKindVideo, " media system runtime: edit receipt kind")
    assert(edit.stateCode == media.MediaPlaybackStateEdited, " media system runtime: edited state")
    assert(edit.payload == "trim=120..900", " media system runtime: edit payload")
    assert(edit.previousStateCode == media.MediaPlaybackStateSeeked,
