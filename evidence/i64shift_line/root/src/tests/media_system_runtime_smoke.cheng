import std/rawbytes
import std/strutils as strutil
import cheng/core/ir/csg_web_facts as facts
import cheng/moq/media_csg_web_projection as media_csg
import cheng/moq/media_asset_manifest as media

fn makeTinyPngBytes(): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(68)
    rawbytes.BytesSet(out, 0, 137)
    rawbytes.BytesSet(out, 1, 80)
    rawbytes.BytesSet(out, 2, 78)
    rawbytes.BytesSet(out, 3, 71)
    rawbytes.BytesSet(out, 4, 13)
    rawbytes.BytesSet(out, 5, 10)
    rawbytes.BytesSet(out, 6, 26)
    rawbytes.BytesSet(out, 7, 10)
    rawbytes.BytesSet(out, 8, 0)
    rawbytes.BytesSet(out, 9, 0)
    rawbytes.BytesSet(out, 10, 0)
    rawbytes.BytesSet(out, 11, 13)
    rawbytes.BytesSet(out, 12, 73)
    rawbytes.BytesSet(out, 13, 72)
    rawbytes.BytesSet(out, 14, 68)
    rawbytes.BytesSet(out, 15, 82)
    rawbytes.BytesSet(out, 16, 0)
    rawbytes.BytesSet(out, 17, 0)
    rawbytes.BytesSet(out, 18, 0)
    rawbytes.BytesSet(out, 19, 1)
    rawbytes.BytesSet(out, 20, 0)
    rawbytes.BytesSet(out, 21, 0)
    rawbytes.BytesSet(out, 22, 0)
    rawbytes.BytesSet(out, 23, 1)
    rawbytes.BytesSet(out, 24, 8)
    rawbytes.BytesSet(out, 25, 4)
    rawbytes.BytesSet(out, 26, 0)
    rawbytes.BytesSet(out, 27, 0)
    rawbytes.BytesSet(out, 28, 0)
    rawbytes.BytesSet(out, 29, 181)
    rawbytes.BytesSet(out, 30, 28)
    rawbytes.BytesSet(out, 31, 12)
    rawbytes.BytesSet(out, 32, 2)
    rawbytes.BytesSet(out, 33, 0)
    rawbytes.BytesSet(out, 34, 0)
    rawbytes.BytesSet(out, 35, 0)
    rawbytes.BytesSet(out, 36, 11)
    rawbytes.BytesSet(out, 37, 73)
    rawbytes.BytesSet(out, 38, 68)
    rawbytes.BytesSet(out, 39, 65)
    rawbytes.BytesSet(out, 40, 84)
    rawbytes.BytesSet(out, 41, 120)
    rawbytes.BytesSet(out, 42, 218)
    rawbytes.BytesSet(out, 43, 99)
    rawbytes.BytesSet(out, 44, 252)
    rawbytes.BytesSet(out, 45, 255)
    rawbytes.BytesSet(out, 46, 31)
    rawbytes.BytesSet(out, 47, 0)
    rawbytes.BytesSet(out, 48, 3)
    rawbytes.BytesSet(out, 49, 3)
    rawbytes.BytesSet(out, 50, 2)
    rawbytes.BytesSet(out, 51, 0)
    rawbytes.BytesSet(out, 52, 239)
    rawbytes.BytesSet(out, 53, 191)
    rawbytes.BytesSet(out, 54, 167)
    rawbytes.BytesSet(out, 55, 219)
    rawbytes.BytesSet(out, 56, 0)
    rawbytes.BytesSet(out, 57, 0)
    rawbytes.BytesSet(out, 58, 0)
    rawbytes.BytesSet(out, 59, 0)
    rawbytes.BytesSet(out, 60, 73)
    rawbytes.BytesSet(out, 61, 69)
    rawbytes.BytesSet(out, 62, 78)
    rawbytes.BytesSet(out, 63, 68)
    rawbytes.BytesSet(out, 64, 174)
    rawbytes.BytesSet(out, 65, 66)
    rawbytes.BytesSet(out, 66, 96)
    rawbytes.BytesSet(out, 67, 130)
    return out

fn setU16LE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, value & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 8) & 255)

fn setU32LE(buf: var rawbytes.Bytes, offset: int32, value: int32) =
    rawbytes.BytesSet(buf, offset, value & 255)
    rawbytes.BytesSet(buf, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(buf, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(buf, offset + 3, (value >> 24) & 255)

fn makeTinyWavBytes(): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(52)
    rawbytes.BytesSet(out, 0, 82)
    rawbytes.BytesSet(out, 1, 73)
    rawbytes.BytesSet(out, 2, 70)
    rawbytes.BytesSet(out, 3, 70)
    setU32LE(out, 4, 44)
    rawbytes.BytesSet(out, 8, 87)
    rawbytes.BytesSet(out, 9, 65)
    rawbytes.BytesSet(out, 10, 86)
    rawbytes.BytesSet(out, 11, 69)
    rawbytes.BytesSet(out, 12, 102)
    rawbytes.BytesSet(out, 13, 109)
    rawbytes.BytesSet(out, 14, 116)
    rawbytes.BytesSet(out, 15, 32)
    setU32LE(out, 16, 16)
    setU16LE(out, 20, 1)
    setU16LE(out, 22, 1)
    setU32LE(out, 24, 44100)
    setU32LE(out, 28, 88200)
    setU16LE(out, 32, 2)
    setU16LE(out, 34, 16)
    rawbytes.BytesSet(out, 36, 100)
    rawbytes.BytesSet(out, 37, 97)
    rawbytes.BytesSet(out, 38, 116)
    rawbytes.BytesSet(out, 39, 97)
    setU32LE(out, 40, 8)
    rawbytes.BytesSet(out, 44, 0)
    rawbytes.BytesSet(out, 45, 0)
    rawbytes.BytesSet(out, 46, 16)
    rawbytes.BytesSet(out, 47, 0)
    rawbytes.BytesSet(out, 48, 32)
    rawbytes.BytesSet(out, 49, 0)
    rawbytes.BytesSet(out, 50, 48)
    rawbytes.BytesSet(out, 51, 0)
    return out

fn makeVideoIngestRequest(signature: str): media.MediaIngestRequest =
    var req: media.MediaIngestRequest
    req.sourcePath = "/imports/video/sample.mp4"
    req.blob = rawbytes.BytesFromString("init-segment-keyframe-zero|sample-video-body")
    req.ownerPeerId = "peer-alpha"
    req.remotePeersCsv = "peer-bravo,peer-charlie"
    req.mime = "video/mp4"
    req.kindCode = media.MediaAssetKindVideo
    req.durationMs = int64(33000)
    req.codec = "h264/aac"
    req.posterBytes = rawbytes.BytesFromString("poster-first-frame")
    req.initSegmentBytes = rawbytes.BytesFromString("init-segment-keyframe-zero")
    req.keyframeIndex = "0:0"
    req.contentSignature = signature
    req.objectTargetBytes = 32
    req.sourceBlockBytes = 8
    req.repairDropletCount = 2
    return req

fn makeImageIngestRequest(signature: str): media.MediaIngestRequest =
    var req: media.MediaIngestRequest
    req.sourcePath = "/imports/image/sample.png"
    req.blob = makeTinyPngBytes()
    req.ownerPeerId = "peer-alpha"
    req.remotePeersCsv = "peer-bravo,peer-charlie"
    req.mime = "image/png"
    req.kindCode = media.MediaAssetKindImage
    req.codec = "png"
    req.posterBytes = rawbytes.BytesFromString("png-preview")
    req.initSegmentBytes = rawbytes.BytesFromString("png-metadata")
    req.keyframeIndex = "image:single-frame"
    req.contentSignature = signature
    req.objectTargetBytes = 16
    req.sourceBlockBytes = 8
    req.repairDropletCount = 2
    return req

fn makeAudioIngestRequest(signature: str): media.MediaIngestRequest =
    var req: media.MediaIngestRequest
    req.sourcePath = "/imports/music/sample.wav"
    req.blob = makeTinyWavBytes()
    req.ownerPeerId = "peer-alpha"
    req.remotePeersCsv = "peer-bravo,peer-charlie"
    req.mime = "audio/wav"
    req.kindCode = media.MediaAssetKindAudio
    req.durationMs = int64(120000)
    req.codec = "pcm_s16le"
    req.posterBytes = rawbytes.BytesFromString("album-cover")
    req.initSegmentBytes = rawbytes.BytesSlice(req.blob, 0, 44)
    req.keyframeIndex = "audio:wav:pcm:0"
    req.contentSignature = signature
    req.objectTargetBytes = 64
    req.sourceBlockBytes = 8
    req.repairDropletCount = 2
    return req

fn main(): int32 =
    var index = media.MediaLocalIndexInit()
    var lifecycleQueue = media.MediaLifecycleEventQueueInit()
    let req = makeVideoIngestRequest("test-signature-provided-by-caller")
    let ingestRes = media.MediaIngestPin(index, req)
    assert(IsOk(ingestRes), " media system runtime: ingest pin")
    let ingest = Value(ingestRes)
    assert(ingest.schema == media.MediaAssetLifecycleSchema, " media system runtime: schema")
    assert(ingest.objectCount > 0, " media system runtime: object count")
    assert(ingest.dropletCount > ingest.objectCount, " media system runtime: fec droplets")
    assert(strutil.Contains(ingest.immutableIdentity, ingest.assetCid),
        " media system runtime: identity asset cid")
    assert(strutil.Contains(ingest.immutableIdentity, ingest.bundleCid),
        " media system runtime: identity bundle cid")
    assert(strutil.Contains(ingest.immutableIdentity, ingest.manifestCid),
        " media system runtime: identity manifest cid")
    assert(ingest.trace == "ingest->manifest->cid", " media system runtime: ingest trace")
    let recordRes = media.MediaLocalIndexFindAssetRecord(index, ingest.assetCid)
    assert(IsOk(recordRes), " media system runtime: pinned asset record")
    assert(media.MediaAssetSha256Hex(Value(recordRes).assetBytes) == ingest.assetCid,
        " media system runtime: pinned asset bytes cid")

    let pinnedManifestRes = media.MediaLocalIndexFind(index, ingest.assetCid)
    assert(IsOk(pinnedManifestRes), " media system runtime: pinned manifest")
    var manifest = Value(pinnedManifestRes)
    assert(manifest.assetCid == ingest.assetCid, " media system runtime: manifest asset")
    assert(manifest.posterCid == ingest.posterCid, " media system runtime: poster cid")
    assert(manifest.initSegmentByteLength == rawbytes.BytesLen(req.initSegmentBytes),
        " media system runtime: manifest init segment length")
    var manifestForCsg = manifest
    let assetFactRes = media_csg.MediaManifestToCsgWebAssetFact(manifestForCsg,
                                                               "media.asset.runtime")
    assert(IsOk(assetFactRes), " media system runtime: csg asset fact")
    let assetFact = Value(assetFactRes)
    assert(assetFact.kind == facts.CsgWebMediaAsset, " media system runtime: csg asset kind")
    assert(assetFact.assetCid == ingest.assetCid, " media system runtime: csg asset cid")
    assert(assetFact.objectCount == ingest.objectCount, " media system runtime: csg object count")
    assert(assetFact.dropletCount == ingest.dropletCount, " media system runtime: csg droplet count")
    assert(assetFact.initSegmentByteLength == rawbytes.BytesLen(req.initSegmentBytes),
        " media system runtime: csg init segment length")

    let publishRes = media.MediaPublish(index, ingest.assetCid)
    assert(IsOk(publishRes), " media system runtime: publish")
    let publish = Value(publishRes)
    assert(publish.assetCid == ingest.assetCid, " media system runtime: publish asset")
    assert(publish.manifestCid == ingest.manifestCid, " media system runtime: publish manifest")
    assert(publish.transport == media.MediaAssetTransportMoq, " media system runtime: publish transport")
    assert(publish.initSegmentByteLength == manifest.initSegmentByteLength,
        " media system runtime: publish init segment length")

    let remotePublishOpenRes = media.MediaOpenPinned(index,
                                                     ingest.assetCid,
                                                     "slot-publish-announcement",
                                                     "platform-codec-provider",
                                                     "surface-texture-provider",
                                                     "audio-provider")
    assert(IsOk(remotePublishOpenRes), " media system runtime: publish announcement open")
    var remotePublishSession = Value(remotePublishOpenRes)
    var remotePublishRequest = media.MediaControlRequest(
        slotId: remotePublishSession.slotId,
        actionKind: "PublishAsset",
        payload: ingest.assetCid,
        guard: strutil.Join(["assetCid:", remotePublishSession.assetCid], ""),
        trace: "typed-action:PublishAsset"
    )
    let remotePublishControlRes = media.MediaControl(remotePublishSession,
                                                     remotePublishRequest)
    assert(IsOk(remotePublishControlRes), " media system runtime: publish announcement control")
    var remotePublishControl = Value(remotePublishControlRes)
    let remotePublishControlEnqueueRes = media.MediaLifecycleEventQueueEnqueueControl(lifecycleQueue,
                                                                                      remotePublishControl)
    assert(IsOk(remotePublishControlEnqueueRes),
        " media system runtime: publish announcement control queued")
    let remotePublishEventRes = media.MediaPublishEventFromControl(index,
                                                                   remotePublishSession,
                                                                   remotePublishControl,
                                                                   media.MediaAssetLifecycleSchema)
    assert(IsOk(remotePublishEventRes), " media system runtime: publish announcement event")
    var remotePublishEvent = Value(remotePublishEventRes)
    assert(remotePublishEvent.assetCid == ingest.assetCid,
        " media system runtime: publish announcement asset")
    assert(remotePublishEvent.eventCid == media.MediaPublishEventCanonicalCid(remotePublishEvent),
        " media system runtime: publish announcement canonical cid")

    let missingPublishRes = media.MediaPublish(index, "missing-asset-cid")
    assert(IsErr(missingPublishRes), " media system runtime: missing asset rejected")

    var remoteIndex = media.MediaLocalIndexInit()
    var remoteManifest = manifest
    let remoteMissingOpenRes = media.MediaOpenPinned(remoteIndex,
                                                     ingest.assetCid,
                                                     "slot-remote-announced",
                                                     "platform-codec-provider",
                                                     "surface-texture-provider",
                                                     "audio-provider")
    assert(IsErr(remoteMissingOpenRes),
        " media system runtime: remote open requires announced manifest")
    let remoteOpenRes = media.MediaOpenAnnouncedManifest(remoteIndex,
                                                         remoteManifest,
                                                         "slot-remote-announced",
                                                         "platform-codec-provider",
                                                         "surface-texture-provider",
                                                         "audio-provider")
    assert(IsOk(remoteOpenRes), " media system runtime: remote announced open")
    var remoteSession = Value(remoteOpenRes)
    media.MediaPlaybackSessionStampOpen(remoteSession, int64(100), int64(118))
    assert(remoteSession.assetCid == ingest.assetCid,
        " media system runtime: remote announced asset")
    assert(remoteSession.manifestCid == ingest.manifestCid,
        " media system runtime: remote announced manifest")
    assert(remoteSession.stateCode == media.MediaPlaybackStateOpened,
        " media system runtime: remote announced opened")
    let remoteFullAssetRes = media.MediaLocalIndexFindAssetRecord(remoteIndex,
                                                                  ingest.assetCid)
    assert(IsErr(remoteFullAssetRes),
        " media system runtime: remote announced open must not require full asset pin")
    let remoteFrameRes = media.MediaFirstFrame(remoteSession,
                                               remoteManifest,
                                               rawbytes.BytesSlice(req.initSegmentBytes, 0, remoteManifest.initSegmentByteLength),
                                               media.MediaAssetFirstFrameSourceInitSegment)
    assert(IsOk(remoteFrameRes), " media system runtime: remote init first frame")
    var remoteFrame = Value(remoteFrameRes)
    media.MediaFrameReceiptStamp(remoteFrame, int64(120), int64(136), remoteSession.openedAtMs)
    assert(remoteFrame.firstFrameCid == ingest.initSegmentCid,
        " media system runtime: remote init frame cid")
    assert(remoteFrame.verified,
        " media system runtime: remote init frame verified")
    let openEventRes = media.MediaOpenEventFromSession(remoteManifest,
                                                       remoteSession,
                                                       media.MediaAssetLifecycleSchema,
                                                       "manifest-announced")
    assert(IsOk(openEventRes), " media system runtime: remote open event")
    let openEvent = Value(openEventRes)
    assert(openEvent.assetCid == ingest.assetCid,
        " media system runtime: remote open event asset")
    assert(openEvent.manifestCid == ingest.manifestCid,
        " media system runtime: remote open event manifest")
    assert(openEvent.transport == media.MediaAssetTransportMoq,
        " media system runtime: remote open event transport")
    assert(openEvent.announcedBytes == publish.announcedBytes,
        " media system runtime: remote open event announced bytes")
    assert(openEvent.objectCount == ingest.objectCount,
        " media system runtime: remote open event object count")
    assert(openEvent.dropletCount == ingest.dropletCount,
        " media system runtime: remote open event droplet count")
    assert(openEvent.resultStateCode == media.MediaPlaybackStateOpened,
        " media system runtime: remote open event result state")
    var openEventForCanonical = openEvent
    assert(openEvent.eventCid == media.MediaOpenEventCanonicalCid(openEventForCanonical),
        " media system runtime: remote open event canonical cid")
    let openEnqueueRes = media.MediaLifecycleEventQueueEnqueueOpen(lifecycleQueue,
                                                                   openEvent)
    assert(IsOk(openEnqueueRes), " media system runtime: remote open queued")
    let duplicateOpenEnqueueRes = media.MediaLifecycleEventQueueEnqueueOpen(lifecycleQueue,
                                                                            openEvent)
    assert(IsErr(duplicateOpenEnqueueRes),
        " media system runtime: duplicate open rejected")
    var missingOpenTraceEvent = openEvent
    missingOpenTraceEvent.eventCid = "missing-open-trace-event"
    missingOpenTraceEvent.trace = ""
    let missingOpenTraceEnqueueRes = media.MediaLifecycleEventQueueEnqueueOpen(lifecycleQueue,
                                                                               missingOpenTraceEvent)
    assert(IsErr(missingOpenTraceEnqueueRes),
        " media system runtime: missing open event trace rejected")
    var tamperedOpenEvent = openEvent
    tamperedOpenEvent.objectCount = tamperedOpenEvent.objectCount + 1
    let tamperedOpenEnqueueRes = media.MediaLifecycleEventQueueEnqueueOpen(lifecycleQueue,
                                                                           tamperedOpenEvent)
    assert(IsErr(tamperedOpenEnqueueRes),
        " media system runtime: tampered open event cid rejected")
    var openEventForCsg = openEvent
    let openLifecycleFactRes = media_csg.MediaOpenEventToCsgWebLifecycleEventFact(openEventForCsg,
                                                                                 "media.lifecycle.open.runtime")
    assert(IsOk(openLifecycleFactRes),
        " media system runtime: csg open lifecycle fact")
    let openLifecycleFact = Value(openLifecycleFactRes)
    assert(openLifecycleFact.kind == facts.CsgWebMediaLifecycleEvent,
        " media system runtime: csg open lifecycle kind")
    assert(openLifecycleFact.eventKind == "OpenAsset",
        " media system runtime: csg open lifecycle event")
    assert(openLifecycleFact.eventCid == openEvent.eventCid,
        " media system runtime: csg open lifecycle cid")
    assert(openLifecycleFact.payload == ingest.manifestCid,
        " media system runtime: csg open lifecycle payload")
    assert(openLifecycleFact.objectCount == ingest.objectCount,
        " media system runtime: csg open lifecycle object count")
    let deliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(remotePublishEvent,
                                                                          openEvent,
                                                                          remoteManifest,
                                                                          remoteFrame,
                                                                          remoteFrame.bytesReady,
                                                                          int64(42))
    assert(IsOk(deliveryRes), " media system runtime: remote delivery receipt")
    var delivery = Value(deliveryRes)
    assert(delivery.receiptKind == "RemoteFrame",
        " media system runtime: remote delivery kind")
    assert(delivery.publishEventCid == remotePublishEvent.eventCid,
        " media system runtime: remote delivery publish cid")
    assert(delivery.openEventCid == openEvent.eventCid,
        " media system runtime: remote delivery open cid")
    assert(delivery.firstMediaCid == ingest.initSegmentCid,
        " media system runtime: remote delivery media cid")
    assert(delivery.transferredBytes == remoteFrame.bytesReady,
        " media system runtime: remote delivery bytes")
    assert(delivery.remoteFetchMs == int64(42),
        " media system runtime: remote delivery fetch ms")
    assert(delivery.openToMediaMs == remoteFrame.openToFrameMs,
        " media system runtime: remote delivery open to media")
    let deliveryEnqueueRes = media.MediaLifecycleEventQueueEnqueueDelivery(lifecycleQueue,
                                                                           delivery)
    assert(IsOk(deliveryEnqueueRes), " media system runtime: remote delivery queued")
    let duplicateDeliveryEnqueueRes = media.MediaLifecycleEventQueueEnqueueDelivery(lifecycleQueue,
                                                                                    delivery)
    assert(IsErr(duplicateDeliveryEnqueueRes),
        " media system runtime: duplicate delivery rejected")
    var tamperedDeliveryForQueue = delivery
    tamperedDeliveryForQueue.mediaBytesReady = tamperedDeliveryForQueue.mediaBytesReady + 1
    let tamperedDeliveryEnqueueRes = media.MediaLifecycleEventQueueEnqueueDelivery(lifecycleQueue,
                                                                                   tamperedDeliveryForQueue)
    assert(IsErr(tamperedDeliveryEnqueueRes),
        " media system runtime: tampered delivery receipt rejected")
    var tamperedOpenForDelivery = openEvent
    tamperedOpenForDelivery.dropletCount = tamperedOpenForDelivery.dropletCount + 1
    let tamperedOpenDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(remotePublishEvent,
                                                                                       tamperedOpenForDelivery,
                                                                                       remoteManifest,
                                                                                       remoteFrame,
                                                                                       remoteFrame.bytesReady,
                                                                                       int64(42))
    assert(IsErr(tamperedOpenDeliveryRes),
        " media system runtime: delivery rejects tampered open cid")
    var tamperedPublishForDelivery = remotePublishEvent
    tamperedPublishForDelivery.objectCount = tamperedPublishForDelivery.objectCount + 1
    let tamperedPublishDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(tamperedPublishForDelivery,
                                                                                          openEvent,
                                                                                          remoteManifest,
                                                                                          remoteFrame,
                                                                                          remoteFrame.bytesReady,
                                                                                          int64(42))
    assert(IsErr(tamperedPublishDeliveryRes),
        " media system runtime: delivery rejects tampered publish cid")
    var deliveryForCsg = delivery
    let deliveryFactRes = media_csg.MediaDeliveryReceiptToCsgWebDeliveryReceiptFact(deliveryForCsg,
                                                                                   "media.delivery.remote.runtime")
    assert(IsOk(deliveryFactRes),
        " media system runtime: csg remote delivery receipt")
    let deliveryFact = Value(deliveryFactRes)
    assert(deliveryFact.kind == facts.CsgWebMediaDeliveryReceipt,
        " media system runtime: csg remote delivery kind")
    assert(deliveryFact.receiptKind == "RemoteFrame",
        " media system runtime: csg remote delivery type")
    assert(deliveryFact.receiptCid == delivery.receiptCid,
        " media system runtime: csg remote delivery receipt cid")
    assert(deliveryFact.firstMediaCid == ingest.initSegmentCid,
        " media system runtime: csg remote delivery media cid")
    assert(deliveryFact.remoteFetchMs == "42",
        " media system runtime: csg remote delivery fetch")
    let slowDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(remotePublishEvent,
                                                                              openEvent,
                                                                              remoteManifest,
                                                                              remoteFrame,
                                                                              remoteFrame.bytesReady,
                                                                              int64(1001))
    assert(IsErr(slowDeliveryRes),
        " media system runtime: slow remote delivery rejected")
    let wrongBytesDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(remotePublishEvent,
                                                                                    openEvent,
                                                                                    remoteManifest,
                                                                                    remoteFrame,
                                                                                    remoteFrame.bytesReady + 1,
                                                                                    int64(42))
    assert(IsErr(wrongBytesDeliveryRes),
        " media system runtime: wrong delivery bytes rejected")
    var wrongManifestForDelivery = remoteManifest
    wrongManifestForDelivery.initSegmentByteLength = wrongManifestForDelivery.initSegmentByteLength + 1
    let wrongManifestDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(remotePublishEvent,
                                                                                       openEvent,
                                                                                       wrongManifestForDelivery,
                                                                                       remoteFrame,
                                                                                       remoteFrame.bytesReady,
                                                                                       int64(42))
    assert(IsErr(wrongManifestDeliveryRes),
        " media system runtime: delivery rejects manifest cid drift")
    var wrongFrameForDelivery = remoteFrame
    wrongFrameForDelivery.firstFrameCid = remoteManifest.assetCid
    let wrongFrameCidDeliveryRes = media.MediaRemoteFrameDeliveryReceiptFromPublishOpen(remotePublishEvent,
                                                                                       openEvent,
                                                                                       remoteManifest,
                                                                                       wrongFrameForDelivery,
                                                                                       wrongFrameForDelivery.bytesReady,
                                                                                       int64(42))
    assert(IsErr(wrongFrameCidDeliveryRes),
        " media system runtime: delivery rejects wrong first frame cid")
    let badOpenPayloadSchemaRes = media.MediaOpenEventFromSession(remoteManifest,
                                                                  remoteSession,
                                                                  "",
                                                                  "manifest-announced")
    assert(IsErr(badOpenPayloadSchemaRes),
        " media system runtime: bad open payload schema rejected")
    let badOpenGuardRes = media.MediaOpenEventFromSession(remoteManifest,
                                                          remoteSession,
                                                          media.MediaAssetLifecycleSchema,
                                                          "")
    assert(IsErr(badOpenGuardRes),
        " media system runtime: bad open guard rejected")

    let duplicateRes = media.MediaIngestPin(index, makeVideoIngestRequest("different-signature-same-asset"))
    assert(IsErr(duplicateRes), " media system runtime: duplicate asset manifest rejected")

    let openWithoutProvider = media.MediaOpenPinned(index,
                                                    ingest.assetCid,
                                                    "slot-main",
                                                    "",
                                                    "surface-texture-provider",
                                                    "audio-provider")
    assert(IsErr(openWithoutProvider), " media system runtime: missing provider rejected")

    let openRes = media.MediaOpenPinned(index,
                                        ingest.assetCid,
                                        "slot-main",
                                        "platform-codec-provider",
                                        "surface-texture-provider",
                                        "audio-provider")
    assert(IsOk(openRes), " media system runtime: open")
    var session = Value(openRes)
    assert(session.stateCode == media.MediaPlaybackStateOpened, " media system runtime: opened state")
    assert(session.eventQueue == "cheng-media-event-queue", " media system runtime: event queue")
    assert(session.providerKind == "media-decode-provider", " media system runtime: provider kind")
    var sessionForCsg = session
    let slotFactRes = media_csg.MediaSessionToCsgWebPlaybackSlotFact(sessionForCsg,
                                                                    assetFact.id,
                                                                    "template.video.player",
                                                                    "media.state.slot-main")
    assert(IsOk(slotFactRes), " media system runtime: csg slot fact")
    let slotFact = Value(slotFactRes)
    assert(slotFact.kind == facts.CsgWebMediaPlaybackSlot, " media system runtime: csg slot kind")
    assert(slotFact.assetCid == session.assetCid, " media system runtime: csg slot asset")
    assert(slotFact.decodeProvider == session.decodeProvider, " media system runtime: csg slot decode")

    let frameRes = media.MediaFirstFrame(session,
                                         manifest,
                                         req.posterBytes,
                                         media.MediaAssetFirstFrameSourcePoster)
    assert(IsOk(frameRes), " media system runtime: first frame")
    let frame = Value(frameRes)
    assert(frame.verified, " media system runtime: frame verified")
