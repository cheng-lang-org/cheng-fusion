    assert(Value(audioOutputIdentityFactRes).receiptCid == audioOutput.receiptCid,
        " media system runtime: csg audio output identity cid")
    let audioWrongProviderRes = media.MediaAudioReceiptAttachOutput(audioFirstForCsg,
