    let shareAudioControlEnqueueRes = media.MediaLifecycleEventQueueEnqueueControl(lifecycleQueue,
                                                                                   shareAudioReceipt)
    assert(IsOk(shareAudioControlEnqueueRes),
        " media system runtime: audio share control queued")
    var audioEditRequest = media.MediaControlRequest(
        slotId: audioSession.slotId,
