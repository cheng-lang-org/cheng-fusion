    let audioOutputIdentityFactRes = media_csg.MediaAudioReceiptToCsgWebReceiptIdentityFact(audioOutputForCsg,
                                                                                            audioOutputFact.id,
                                                                                            "media.receipt.identity.first-audio.output.runtime")
