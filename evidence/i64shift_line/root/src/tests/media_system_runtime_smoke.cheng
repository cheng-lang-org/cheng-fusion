    let audioOutput = Value(audioOutputRes)
    assert(audioOutput.outputReady,
        " media system runtime: audio output ready")
    assert(audioOutput.outputStatusCode == media.MediaAudioOutputStatusReady,
        " media system runtime: audio output status ready")
    assert(audioOutput.outputStateCode == media.MediaPlaybackStatePlaying,
        " media system runtime: audio output state playing")
    assert(audioOutput.outputPcmBytes == audioFirst.pcmDataBytes,
        " media system runtime: audio output pcm bytes")
    assert(audioOutput.receiptCid != audioFirst.receiptCid,
        " media system runtime: audio output receipt cid changes")
    assert(strutil.Contains(audioOutput.trace, "audio-output-ready"),
        " media system runtime: audio output trace")
    var audioOutputForCsg = audioOutput
    let audioOutputFactRes = media_csg.MediaAudioReceiptToCsgWebFrameReceiptFact(audioOutputForCsg,
                                                                                "media.first-audio.output.runtime")
    assert(IsOk(audioOutputFactRes), " media system runtime: csg audio output receipt")
    let audioOutputFact = Value(audioOutputFactRes)
    assert(strutil.Contains(audioOutputFact.trace, "audio-output-ready"),
