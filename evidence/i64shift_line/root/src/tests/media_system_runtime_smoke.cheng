                                                                               "media.first-audio.runtime")
    assert(IsOk(audioFirstFactRes), " media system runtime: csg audio first receipt")
    let audioFirstFact = Value(audioFirstFactRes)
    assert(audioFirstFact.receiptKind == "Audio",
        " media system runtime: csg audio first receipt kind")
    assert(audioFirstFact.audioDataCid == audioFirst.audioDataCid,
        " media system runtime: csg audio data cid")
    assert(audioFirstFact.pcmDataBytes == audioFirst.pcmDataBytes,
        " media system runtime: csg audio pcm bytes")
    let audioFirstIdentityFactRes = media_csg.MediaAudioReceiptToCsgWebReceiptIdentityFact(audioFirstForCsg,
                                                                                           audioFirstFact.id,
                                                                                           "media.receipt.identity.first-audio.runtime")
    assert(IsOk(audioFirstIdentityFactRes), " media system runtime: csg audio first identity")
    assert(Value(audioFirstIdentityFactRes).receiptCid == audioFirst.receiptCid,
        " media system runtime: csg audio first identity cid")
    let audioOutputRes = media.MediaAudioReceiptAttachOutput(audioFirstForCsg,
                                                             audioSession,
                                                             audioSession.audioProvider,
                                                             media.MediaAudioOutputStatusReady,
                                                             media.MediaPlaybackStatePlaying,
                                                             audioFirst.sampleRateHz,
                                                             audioFirst.channelCount,
                                                             audioFirst.bitsPerSample,
                                                             audioFirst.pcmDataOffset,
                                                             audioFirst.pcmDataBytes,
                                                             "android-audiotrack:first-packet")
