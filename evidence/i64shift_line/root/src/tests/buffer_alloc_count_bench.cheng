import std/buffer

fn main(): int32 =
    var buf: buffer.GrowByteBuffer = buffer.NewByteBuffer()
    var i: int32
    for i in 0..<20000:
        buffer.AppendByte(buf, 65)
    assert(buffer.ByteBufferLen(buf) == 20000, " buffer_alloc_count_bench: len")
    echo(" buffer_alloc_count_bench ok")
    return 0
