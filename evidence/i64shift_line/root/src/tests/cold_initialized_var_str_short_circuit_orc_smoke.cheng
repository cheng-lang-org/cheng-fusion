import std/strutils as strutil
import std/strings as strings
import std/system as system

type
    FocusedSourceIndex =
        workspaceRoot: str

@borrows
fn Normalize(
    input: str,
    out: var str,
    err: var str
): bool =
    if input == "reject":
        err = strutil.Join(["normalize", "-failed"], "")
        return false
    out = strutil.Join([strings.CloneStr(input), "/normalized"], "")
    err = ""
    return true

fn ReadOnlyOrOwner(
    value: var str,
    ownerKey: var str,
    err: var str
): bool =
    var expected = strutil.Join(["owner=", strings.CloneStr(value)], "")
    if ownerKey != expected:
        err = strutil.Join(["owner", "-mismatch"], "")
        return false
    err = ""
    return true

fn FocusedOwnerKey(workspaceRoot: var str): str =
    return strutil.Join(
        ["owner=", strings.CloneStr(workspaceRoot)], "")

fn BuildFocusedSourceIndex(source: str): bool =
    var index: FocusedSourceIndex
    var err = ""
    var workspaceRoot = ""
    if source != "" &&
       !Normalize(source, workspaceRoot, err):
        return false
    var indexField = share(workspaceRoot)
    index.workspaceRoot = share(indexField)
    var ownerKey = FocusedOwnerKey(workspaceRoot)
    if workspaceRoot != "" &&
       !ReadOnlyOrOwner(
           workspaceRoot,
           ownerKey,
           err):
        return false
    return workspaceRoot == indexField &&
           workspaceRoot == index.workspaceRoot

fn RunFocusedPaths(): int32 =
    if !BuildFocusedSourceIndex("workspace"):
        return 1
    if BuildFocusedSourceIndex("reject"):
        return 2
    if !BuildFocusedSourceIndex(""):
        return 3
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()
    let pathResult = RunFocusedPaths()
    if pathResult != 0:
        return pathResult
    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0):
        return 4
    if allocDelta != freeDelta:
        echo(Fmt"cold_initialized_var_str_short_circuit_orc alloc={allocDelta} free={freeDelta} retain={retainDelta} release={releaseDelta}")
        return 5
    if system.memLiveCount() != liveBefore:
        return 6
    if releaseDelta != retainDelta + freeDelta:
        return 7
    return 0
