import std/os
import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/parser
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_parser_receipt as parser_receipt
import cheng/core/tooling/compiler_world as cworld

fn main() =
    assert(ccsg.CompilerCsgPortableSourceIdentityReceiptWireByteLength == 204,
           "portable receipt smoke: source receipt wire size drift")
    assert(ccsg.CompilerCsgTransitionReceiptWireByteLength == 160,
           "portable receipt smoke: transition receipt wire size drift")
    assert(parser_receipt.PortableParserReceiptWireByteLength == 136,
           "portable receipt smoke: portable parser receipt wire size drift")
    assert(ccsg.CompilerCsgTransitionReceiptPortable == false,
           "portable receipt smoke: transition portable was forced true")

    var importEdges: parser.ImportEdge[]
    var importGraphCid: layout.FixedBytes32
    var err = ""
    let sourceBundleCid =
        ccsg.CompilerCsgPortableSourcePackageIdCid("cid/smoke/bundle")
    let entrySourceCid =
        cworld.CompilerWorldSourceRawBytesCid("")
    assert(cworld.CompilerWorldPortableImportGraphCidInto("cid/smoke",
                                                           importEdges,
                                                           0,
                                                           importGraphCid,
                                                           err),
           err)
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    assert(ccsg.PortableSourceIdentityReceiptMakeInto(
               1,
               0,
               0,
               "cid/smoke",
               "main",
               sourceBundleCid,
               entrySourceCid,
               importGraphCid,
               sourceReceipt,
               err),
           err)
    assert(ccsg.PortableSourceIdentityReceiptStrictValidateInto(
               sourceReceipt,
               err),
           err)
    var invalidModuleReceipt: ccsg.PortableSourceIdentityReceipt
    assert(!ccsg.PortableSourceIdentityReceiptMakeInto(
                1,
                0,
                0,
                "cid/smoke",
                "main//bad",
                sourceBundleCid,
                entrySourceCid,
                importGraphCid,
                invalidModuleReceipt,
                err),
           "portable receipt smoke: invalid module path accepted")

    var mutated = sourceReceipt
    mutated.sourceSnapshotCount = 2
    assert(!ccsg.PortableSourceIdentityReceiptStrictValidateInto(mutated,
                                                                  err),
           "portable receipt smoke: mutated source receipt validated")

    let parserReceiptCid =
        ccsg.CompilerCsgPortableSourcePackageIdCid("cid/smoke/parser")
    let compilerCsgCid =
        ccsg.CompilerCsgPortableSourcePackageIdCid("cid/smoke/csg")
    let canonicalCompilerCsgCid =
        ccsg.CompilerCsgPortableSourcePackageIdCid("cid/smoke/canonical")
    var transition: ccsg.CompilerCsgTransitionReceipt
    err = ""
    assert(ccsg.CompilerCsgTransitionReceiptMakeInto(
               sourceReceipt,
               parserReceiptCid,
               compilerCsgCid,
               canonicalCompilerCsgCid,
               transition,
               err),
           err)
    var portableParser: parser_receipt.PortableParserReceipt
    err = ""
    assert(parser_receipt.PortableParserReceiptMakeInto(
               sourceReceipt.receiptCid,
               1,
               0,
               sourceBundleCid,
               entrySourceCid,
               portableParser,
               err),
           err)
    assert(parser_receipt.PortableParserReceiptStrictValidateInto(
               portableParser, err),
           err)
    var zeroPortable: parser_receipt.PortableParserReceipt
    assert(!parser_receipt.PortableParserReceiptMakeInto(
                layout.FixedBytes32(),
                1,
                0,
                sourceBundleCid,
                entrySourceCid,
                zeroPortable,
                err),
           "portable receipt smoke: zero source identity root accepted")
    err = ""
    assert(!ccsg.CompilerCsgTransitionReceiptPortableFromEvidence(
                transition,
                portableParser,
                sourceReceipt,
                err) &&
           err == " compiler csg: transition still binds local parser receipt cid",
           err)
    var csg: ccsg.CompilerCsg
    assert(!ccsg.CompilerCsgTransitionReceiptStrictValidateInto(
                transition,
                sourceReceipt,
                csg,
                err) && err != "",
           "portable receipt smoke: unwired artifact passed transition validate")

    ccsg.PortableSourceIdentityReceiptMoveInto(csg.sourceIdentityReceipt,
                                                sourceReceipt)
    assert(layout.FixedBytes32Equal(sourceReceipt.receiptCid,
                                    layout.FixedBytes32()),
           "portable receipt smoke: move did not clear source receipt")
    assert(!ccsg.PortableSourceIdentityReceiptStrictValidateInto(sourceReceipt,
                                                                  err),
           "portable receipt smoke: second consume receipt remained valid")
    var providers: str[]
    add(providers, "runtime/core")
    add(providers, "runtime/os")
    var finalReceipt: ccsg.CompileReceipt
    err = ""
    assert(ccsg.CompileReceiptMakeInto(
               parserReceiptCid,
               csg.sourceIdentityReceipt.receiptCid,
               canonicalCompilerCsgCid,
               "arm64-apple-darwin",
               compilerCsgCid,
               canonicalCompilerCsgCid,
               "GEN3",
               providers,
               finalReceipt,
               err),
           err)
    assert(ccsg.CompileReceiptStrictValidateInto(finalReceipt, err), err)
    let finalReceiptReport = ccsg.CompileReceiptReport(finalReceipt)
    assert(!strutil.Contains(finalReceiptReport, "compiler_csg_cid=") &&
           strutil.Contains(finalReceiptReport, "output_raw_sha256=") &&
           strutil.Contains(finalReceiptReport, "canonical_output_sha256="),
           "portable receipt smoke: v3 report leaked legacy/local fields")
    var parsedFinalReceipt: ccsg.CompileReceipt
    let parsedFinalReceiptRes =
        ccsg.CompileReceiptFromReportText(finalReceiptReport,
                                          parsedFinalReceipt)
    assert(!IsErr(parsedFinalReceiptRes), Error(parsedFinalReceiptRes))
    assert(ccsg.CompileReceiptEquivalent(finalReceipt, parsedFinalReceipt),
           "portable receipt smoke: v3 report roundtrip drift")
    var rejectedFinalReceipt: ccsg.CompileReceipt
    assert(IsErr(ccsg.CompileReceiptFromReportText(
                     strutil.Join([finalReceiptReport, "\nextra=1"], ""),
                     rejectedFinalReceipt)),
           "portable receipt smoke: v3 reader accepted extra field")
    var contaminatedFinalReceipt = finalReceipt
    contaminatedFinalReceipt.outputDigest =
        ccsg.CompilerCsgPortableSourcePackageIdCid("cid/smoke/local-csg")
    assert(!ccsg.CompileReceiptStrictValidateInto(contaminatedFinalReceipt,
                                                     err),
           "portable receipt smoke: v3 accepted tampered output identity")
    var unsortedProviders: str[]
    add(unsortedProviders, "runtime/os")
    add(unsortedProviders, "runtime/core")
    var unsortedFinalReceipt: ccsg.CompileReceipt
    assert(!ccsg.CompileReceiptMakeInto(
                parserReceiptCid,
                csg.sourceIdentityReceipt.receiptCid,
                canonicalCompilerCsgCid,
                "arm64-apple-darwin",
                compilerCsgCid,
                canonicalCompilerCsgCid,
                "GEN3",
                unsortedProviders,
                unsortedFinalReceipt,
                err),
           "portable receipt smoke: v3 accepted unordered providers")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_portable_identity_receipt_smoke: ok")
