import tests/cold_exact_unique_borrow_nested_cfg_merge_types as nested_merge

@borrows
fn ColdNestedMergeWriteValues(
        values: var int32[]): bool =
    values[0] = 37
    return true

fn main(): int32 =
    var root: nested_merge.ColdNestedMergeRoot
    setLen(root.leaf.values, 1)
    var replacement: nested_merge.ColdNestedMergeRoot
    setLen(replacement.leaf.values, 1)
    replacement.marker = 11
    var valid = true
    if valid:
        root = replacement
    if valid:
        valid = ColdNestedMergeWriteValues(
            root.leaf.values)
    if !valid || root.marker != 11 ||
       root.leaf.values[0] != 37:
        return 1
    return 0
