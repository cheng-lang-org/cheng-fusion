import cheng/core/ir/phase_arena as phase

fn borrowStoreTwice(first: var phase.PhaseArenaStore,
                    second: var phase.PhaseArenaStore): int64 =
    return phase.PhaseArenaStoreRetainedBytes(first) +
           phase.PhaseArenaStoreRetainedBytes(second)

fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 32, 1)
    return int32(borrowStoreTwice(store, store))
