import cheng/core/backend/host_pool_runtime as hpool
import cheng/core/backend2/backend2_pipeline as pipeline
import std/rawbytes

fn writeExact(fd: int32,
              bytes: var rawbytes.Bytes,
              offset: int32,
              count: int32): bool =
    var written: int32
    while written < count:
        let n = hpool.HostPoolWriteBytes(
            fd, bytes, offset + written, count - written)
        if n <= 0:
            return false
        written = written + int32(n)
    return true

fn readExact(fd: int32,
             bytes: var rawbytes.Bytes,
             offset: int32,
             count: int32): bool =
    var received: int32
    while received < count:
        let n = hpool.HostPoolReadBytes(
            fd, bytes, offset + received, count - received)
        if n <= 0:
            return false
        received = received + int32(n)
    return true

fn main(): int32 =
    var pipeFds: int32[2]
    if hpool.HostPoolPipe(pipeFds) != 0:
        return 1
    let readFd = pipeFds[0]
    let writeFd = pipeFds[1]
    let pid = hpool.HostPoolFork()
    if pid < 0:
        let _closeRead = hpool.HostPoolClose(readFd)
        let _closeWrite = hpool.HostPoolClose(writeFd)
        return 2
    if pid == 0:
        let _closeRead = hpool.HostPoolClose(readFd)
        var frame = rawbytes.BytesAlloc(6)
        if rawbytes.BytesLen(frame) != 6:
            hpool.HostPoolExitImmediate(10)
            return 10
        rawbytes.BytesSet(frame, 0, 0x55)
        rawbytes.BytesSet(frame, 1, 0x00)
        rawbytes.BytesSet(frame, 2, 0x7f)
        rawbytes.BytesSet(frame, 3, 0xff)
        rawbytes.BytesSet(frame, 4, 0x41)
        rawbytes.BytesSet(frame, 5, 0xaa)
        if !writeExact(writeFd, frame, 1, 4):
            rawbytes.BytesFree(frame)
            let _closeWrite = hpool.HostPoolClose(writeFd)
            hpool.HostPoolExitImmediate(11)
            return 11
        rawbytes.BytesFree(frame)
        if hpool.HostPoolClose(writeFd) != 0:
            hpool.HostPoolExitImmediate(12)
            return 12
        hpool.HostPoolExitImmediate(0)
        return 13

    let _closeWrite = hpool.HostPoolClose(writeFd)
    var frame = rawbytes.BytesAlloc(8)
    if rawbytes.BytesLen(frame) != 8:
        let _closeRead = hpool.HostPoolClose(readFd)
        var allocFailureStatus: int32
        let _reaped = hpool.HostPoolWaitpid(pid, allocFailureStatus, 0)
        rawbytes.BytesFree(frame)
        return 3
    for i in 0..<8:
        rawbytes.BytesSet(frame, i, 0x5a)
    let received = readExact(readFd, frame, 2, 4)
    let closeRc = hpool.HostPoolClose(readFd)
    var status: int32
    let reaped = hpool.HostPoolWaitpid(pid, status, 0)
    let valid = received && closeRc == 0 && reaped == pid && status == 0 &&
                rawbytes.BytesGet(frame, 0) == 0x5a &&
                rawbytes.BytesGet(frame, 1) == 0x5a &&
                rawbytes.BytesGet(frame, 2) == 0x00 &&
                rawbytes.BytesGet(frame, 3) == 0x7f &&
                rawbytes.BytesGet(frame, 4) == 0xff &&
                rawbytes.BytesGet(frame, 5) == 0x41 &&
                rawbytes.BytesGet(frame, 6) == 0x5a &&
                rawbytes.BytesGet(frame, 7) == 0x5a
    rawbytes.BytesFree(frame)
    if !valid:
        return 4
    if !pipeline.Backend2PoolMalformedFrameReapContract():
        return 6
    if !pipeline.Backend2PoolBatchReceiveAtomicityContract():
        return 5
    return 0
