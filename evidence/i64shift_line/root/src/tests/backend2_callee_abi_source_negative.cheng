import cheng/core/backend/lowering_plan as lower
import cheng/core/backend2/backend2_pipeline as pipeline

fn main(): int32 =
    var lowering: lower.LoweringPlanStub
    var caller: lower.PrimaryObjectIrFunction
    caller.functionName = "caller"
    add(caller.callTargets, "ordinary_callee")
    add(caller.callTargetSourcePaths, "")
    add(caller.callTargetImportcFlags, false)
    add(caller.callImportcSymbols, "")
    let _ = pipeline.Backend2CalleeAbiViewsForFunction(lowering, caller)
    echo("BACKEND2_CALLEE_ABI_SOURCE_NOT_CAUGHT")
    return 1

main()
