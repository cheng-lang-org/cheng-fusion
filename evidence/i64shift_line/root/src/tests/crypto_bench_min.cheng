# Minimal crypto benchmark (isolation build): AES-GCM bulk + SHA-256.
import std/crypto/aesgcm
import std/crypto/sha256
import std/rawbytes
import std/strings
import std/os

@importc("cheng_monotime_ns")
fn monoNs(): int64

const benchRecordBytes = 16384
const benchRecordsPerRound = 64
const benchRounds = 6

fn benchFillRandom(buf: rawbytes.Bytes) =
    var i: int32 = 0
    var seed: int32 = 123456789
    while i < rawbytes.BytesLen(buf):
        seed = (seed * 1103515245 + 12345) & 2147483647
        rawbytes.BytesSet(buf, i, (seed >> 16) & 255)
        i = i + 1

fn benchPrint(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn benchReport(name: str, dtNs: int64) =
    let totalBytes: int64 = int64(benchRecordBytes) * int64(benchRecordsPerRound) * int64(benchRounds)
    var clamped: int64 = dtNs
    if clamped < 1:
        clamped = 1
    let ms: int64 = clamped / int64(1000000)
    let rateK: int64 = (totalBytes * int64(1000000)) / clamped
    benchPrint(name)
    benchPrint(strings.Int64ToStr(ms))
    benchPrint(strings.Int64ToStr(rateK))

fn main(): int32 =
    var keyData: rawbytes.Bytes = rawbytes.BytesAlloc(32)
    benchFillRandom(keyData)
    var nonceBuf: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    benchFillRandom(nonceBuf)
    var tagBuf: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    var aad: rawbytes.Bytes = rawbytes.EmptyBytes()
    var bigBuf: rawbytes.Bytes = rawbytes.BytesAlloc(benchRecordBytes * benchRecordsPerRound)
    benchFillRandom(bigBuf)

    var keyRes: Result[aesgcm.AesGcmKey] = aesgcm.intoAesGcmKey(keyData)
    var key: aesgcm.AesGcmKey = Value(keyRes)
    let t0: int64 = monoNs()
    var r: int32 = 0
    while r < benchRounds:
        let enc: Result[bool] = aesgcm.aesGcmEncryptRaw(key.rounds, key.roundKeys, nonceBuf, tagBuf, bigBuf, aad)
        r = r + 1
    benchReport("AESGCM_bulk_1MB", monoNs() - t0)

    # AESGCM correctness gate: AEAD encrypt->decrypt must roundtrip the
    # plaintext exactly (exercises the HW-seam block path both directions).
    var gcmNonce: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    benchFillRandom(gcmNonce)
    var gcmTag: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    var gcmData: rawbytes.Bytes = rawbytes.BytesAlloc(benchRecordBytes * benchRecordsPerRound)
    benchFillRandom(gcmData)
    var gcmCopy: rawbytes.Bytes = rawbytes.BytesAlloc(benchRecordBytes * benchRecordsPerRound)
    benchFillRandom(gcmCopy)
    let gcmEnc: Result[bool] = aesgcm.aesGcmEncryptRaw(key.rounds, key.roundKeys, gcmNonce, gcmTag, gcmData, aad)
    let gcmDec: Result[bool] = aesgcm.aesGcmDecryptRaw(key.rounds, key.roundKeys, gcmNonce, gcmTag, gcmData, aad)
    var gcmOk: bool = Value(gcmEnc) && Value(gcmDec)
    var gi: int32 = 0
    while gi < rawbytes.BytesLen(gcmData):
        if BytesGet(gcmData, gi) != BytesGet(gcmCopy, gi):
            gcmOk = false
        gi = gi + 1
    benchPrint("AESGCM_roundtrip")
    if gcmOk:
        benchPrint("GCM_ROUNDTRIP_PASS")
    else:
        benchPrint("GCM_ROUNDTRIP_FAIL")
    rawbytes.BytesFree(gcmData)
    rawbytes.BytesFree(gcmCopy)

    let t3: int64 = monoNs()
    r = 0
    while r < benchRounds:
        var digest: rawbytes.Bytes = sha256.Sha256Digest(bigBuf)
        rawbytes.BytesFree(digest)
        r = r + 1
    benchReport("SHA256_1MB", monoNs() - t3)

    # Known-answer gate: SHA256 of "abc" must equal the published digest.
    var katInput: rawbytes.Bytes = rawbytes.BytesFromString("abc")
    var katDigest: rawbytes.Bytes = sha256.Sha256Digest(katInput)
    var katHex: str = rawbytes.BytesToHex(katDigest)
    var katOk: bool = katHex == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
    benchPrint("SHA256_KAT_abc")
    benchPrint(katHex)
    if katOk:
        benchPrint("KAT_PASS")
    else:
        benchPrint("KAT_FAIL")
    if katOk:
        return 0
    return 9
