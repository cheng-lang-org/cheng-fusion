import std/strings
import std/strutils as strutil

type
    Probe =
        a: int32
        b: int32
        c: int32
        arr1: int32[4]
        arr2: int32[4]
        arr3: int32[4]
        arr4: int32[4]

fn main(): int32 =
    var p: Probe
    p.a = 10
    p.b = 20
    p.c = 30
    p.arr1[0] = 100
    p.arr1[1] = 101
    p.arr1[2] = 102
    p.arr1[3] = 103
    p.arr2[0] = 200
    p.arr2[1] = 201
    p.arr2[2] = 202
    p.arr2[3] = 203
    p.arr3[0] = 300
    p.arr3[1] = 301
    p.arr3[2] = 302
    p.arr3[3] = 303
    p.arr4[0] = 400
    p.arr4[1] = 401
    p.arr4[2] = 402
    p.arr4[3] = 403

    # Read-back to verify
    var ok: bool = true
    if p.a != 10: echo("FAIL a"); ok = false
    if p.b != 20: echo("FAIL b"); ok = false
    if p.c != 30: echo("FAIL c"); ok = false
    if p.arr1[0] != 100: echo("FAIL arr1[0]"); ok = false
    if p.arr1[1] != 101: echo("FAIL arr1[1]"); ok = false
    if p.arr1[2] != 102: echo("FAIL arr1[2]"); ok = false
    if p.arr1[3] != 103: echo("FAIL arr1[3]"); ok = false
    if p.arr2[0] != 200: echo("FAIL arr2[0]"); ok = false
    if p.arr2[1] != 201: echo("FAIL arr2[1]"); ok = false
    if p.arr2[2] != 202: echo("FAIL arr2[2]"); ok = false
    if p.arr2[3] != 203: echo("FAIL arr2[3]"); ok = false
    if p.arr3[0] != 300: echo("FAIL arr3[0]"); ok = false
    if p.arr3[1] != 301: echo("FAIL arr3[1]"); ok = false
    if p.arr3[2] != 302: echo("FAIL arr3[2]"); ok = false
    if p.arr3[3] != 303: echo("FAIL arr3[3]"); ok = false
    if p.arr4[0] != 400: echo("FAIL arr4[0]"); ok = false
    if p.arr4[1] != 401: echo("FAIL arr4[1]"); ok = false
    if p.arr4[2] != 402: echo("FAIL arr4[2]"); ok = false
    if p.arr4[3] != 403: echo("FAIL arr4[3]"); ok = false

    # Probe overlap: does arr2[0] overlap with arr1[N-1]?
    if p.arr2[0] == p.arr1[3] || p.arr2[0] == p.arr1[2]:
        echo("OVERLAP DETECTED: arr2[0] overlaps arr1")
        ok = false

    # Probe overlap: does arr4[0] overlap with arr1?
    if p.arr4[0] == 100:
        echo("OVERLAP DETECTED: arr4[0] reads arr1[0]")
        ok = false

    if ok:
        echo("probe ok")
        return 0
    else:
        echo("probe FAILED")
        return 1
