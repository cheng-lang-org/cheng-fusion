import std/seqs

var codexGlobalStrings: str[]

fn codexGlobalPop() =
    let depth = codexGlobalStrings.len
    if depth > 0:
        setLen(codexGlobalStrings, depth - 1)

fn main(): int32 =
    add(codexGlobalStrings, "left")
    add(codexGlobalStrings, "right")
    codexGlobalPop()
    if codexGlobalStrings.len != 1 ||
       codexGlobalStrings[0] != "left":
        return 11
    return 0
