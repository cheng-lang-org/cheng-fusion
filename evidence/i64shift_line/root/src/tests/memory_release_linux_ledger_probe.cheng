import std/cmdline as cmdline
import std/system
import cheng/core/tooling/lifetime_ledger as ledger

fn probeScope(useExactReserve: bool,
              outAlloc: var int64, outFree: var int64,
              outSeq: var int32, outBuf: var int32, outBytes: var int64) =
    let a = system.memAllocCount()
    let f = system.memFreeCount()
    var observed: ledger.LifetimeLedger
    ledger.LifetimeLedgerInit(observed)
    if useExactReserve:
        ledger.LifetimeLedgerReserveExact(observed, 1, 2, 2, 2)
    let category = ledger.LifetimeLedgerRegisterCategory(observed, "owned_payload")
    let producer = ledger.LifetimeLedgerRegisterOwner(observed, "producer")
    let consumer = ledger.LifetimeLedgerRegisterOwner(observed, "consumer")
    for index in 0..<2:
        let objectId = ledger.LifetimeLedgerReserveObject(observed, category, int64(64) + int64(index) * int64(8))
        ledger.LifetimeLedgerOwn(observed, objectId, producer)
        let borrowId = ledger.LifetimeLedgerBorrow(observed, objectId, consumer)
        ledger.LifetimeLedgerReturnBorrow(observed, objectId, borrowId, consumer)
        ledger.LifetimeLedgerMove(observed, objectId, producer, consumer)
        ledger.LifetimeLedgerRelease(observed, objectId, consumer)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, producer)
    ledger.LifetimeLedgerAssertOwnerClosed(observed, consumer)
    ledger.LifetimeLedgerAssertClosed(observed)
    var metrics: ledger.LifetimeLedgerMetrics
    ledger.LifetimeLedgerReadTotalMetrics(observed, metrics)
    let storage = ledger.LifetimeLedgerReleaseStorage(observed)
    outSeq = storage.releasedSequenceCount
    outBuf = storage.releasedSequenceBufferCount
    outBytes = storage.releasedSequenceCapacityBytes
    outAlloc = system.memAllocCount() - a
    outFree = system.memFreeCount() - f

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var a: int64 = int64(0)
    var f: int64 = int64(0)
    var s: int32 = 0
    var b: int32 = 0
    var by: int64 = int64(0)
    probeScope(false, a, f, s, b, by)
    echo(Fmt"grow_path alloc_delta={a} free_delta={f} seq={s} buf={b} bytes={by}")
    var a2: int64 = int64(0)
    var f2: int64 = int64(0)
    var s2: int32 = 0
    var b2: int32 = 0
    var by2: int64 = int64(0)
    probeScope(true, a2, f2, s2, b2, by2)
    echo(Fmt"exact_reserve alloc_delta={a2} free_delta={f2} seq={s2} buf={b2} bytes={by2}")
    return 0
