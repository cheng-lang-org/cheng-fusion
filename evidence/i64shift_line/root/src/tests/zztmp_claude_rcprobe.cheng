import std/cmdline as cmdline
import std/system as system

type
    RcProbeCtx =
        tag: int32
        note: str
    RcProbeRef = ref
        tag: int32

fn probeCtxSeqRc(items: var RcProbeCtx[]): int32 =
    if items.len <= 0:
        return -2
    let buffer = system.chengSeqHdrBufferGet(&items)
    if buffer == nil:
        return -1
    return system.memRefCount(buffer)

fn probeStrSeqRc(items: var str[]): int32 =
    if items.len <= 0:
        return -2
    let buffer = system.chengSeqHdrBufferGet(&items)
    if buffer == nil:
        return -1
    return system.memRefCount(buffer)

fn probeI32SeqRc(items: var int32[]): int32 =
    if items.len <= 0:
        return -2
    let buffer = system.chengSeqHdrBufferGet(&items)
    if buffer == nil:
        return -1
    return system.memRefCount(buffer)

fn reportRc(label: str, rc: int32) =
    if rc == 1:
        echo(label)
        echo("rc_ok")
    elif rc == 0:
        echo(label)
        echo("rc_zero")
    elif rc == -1:
        echo(label)
        echo("rc_buffer_nil")
    else:
        echo(label)
        echo("rc_other")

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    echo("start")

    # 1. opaque seq grow (struct elements) — the sourceContexts shape
    var ctxs: RcProbeCtx[]
    var i = 0
    while i < 5:
        var c: RcProbeCtx
        c.tag = int32(i)
        c.note = "ctx"
        add(ctxs, c)
        i = i + 1
    reportRc("opaque_seq", probeCtxSeqRc(ctxs))

    # 2. str seq grow
    var names: str[]
    i = 0
    while i < 5:
        add(names, "name")
        i = i + 1
    reportRc("str_seq", probeStrSeqRc(names))

    # 3. setLen grow path
    var nums: int32[]
    setLen(nums, 8)
    reportRc("setlen_seq", probeI32SeqRc(nums))

    # 4. new(T) managed ref
    let marker = new(RcProbeRef)
    reportRc("new_ref", system.memRefCount(marker))

    echo("done")
    return 0
