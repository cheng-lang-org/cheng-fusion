module cold_linkerless_fibonacci

fn fib(n: int32): int32 =
    if n <= 1:
        return n
    let a = fib(n - 1)
    let b = fib(n - 2)
    return a + b

fn test_fib_0(): int32 =
    let r = fib(0)
    if r != 0:
        return 1
    return 0

fn test_fib_1(): int32 =
    let r = fib(1)
    if r != 1:
        return 1
    return 0

fn test_fib_5(): int32 =
    let r = fib(5)
    if r != 5:
        return 1
    return 0

fn test_fib_10(): int32 =
    let r = fib(10)
    if r != 55:
        return 1
    return 0

fn main(): int32 =
    let r1 = test_fib_0()
    if r1 != 0:
        return r1
    let r2 = test_fib_1()
    if r2 != 0:
        return 10 + r2
    let r3 = test_fib_5()
    if r3 != 0:
        return 20 + r3
    let r4 = test_fib_10()
    if r4 != 0:
        return 30 + r4
    return 0

main()
