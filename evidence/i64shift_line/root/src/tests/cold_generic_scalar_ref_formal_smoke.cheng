type ColdGenericScalarRefAlias = int32

fn ColdGenericScalarRefAdvance[T](value: var T, delta: T) =
    value = value + delta

fn ColdNominalScalarRefAdvance(
        value: var ColdGenericScalarRefAlias,
        delta: ColdGenericScalarRefAlias) =
    value = value + delta

fn main(): int32 =
    var builtinValue: int32 = 40
    ColdGenericScalarRefAdvance[int32](builtinValue, 1)
    ColdGenericScalarRefAdvance[int32](builtinValue, 1)
    if builtinValue != 42:
        return 1
    var nominalValue: ColdGenericScalarRefAlias = 40
    ColdNominalScalarRefAdvance(nominalValue, 2)
    if nominalValue != 42:
        return 2
    return 0

main()
