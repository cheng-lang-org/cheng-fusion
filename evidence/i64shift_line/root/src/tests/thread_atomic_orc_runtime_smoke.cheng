import std/atomic
import std/async_rt as async
import std/system
import std/thread

@importc("write")
fn linuxWrite(fd: int32, raw: ptr, count: int32): int32

@importc("cheng_runtime_heap_new")
fn runtimeHeapNew(size: int32): ptr

type
    AtomicWorkerCtx = ref object
        counter: atomic.I32

    OrcWorkerCtx = ref object
        raw: ptr
        done: atomic.I32

fn AtomicIncrement(cell: atomic.I32) =
    var done = false
    while !done:
        let current = atomic.LoadI32(cell)
        done = atomic.CasI32(cell, current, current + 1)

fn ThreadAtomicWorker(raw: ptr) =
    let ctx: AtomicWorkerCtx = AtomicWorkerCtx(raw)
    AtomicIncrement(ctx.counter)

fn ThreadOrcWorker(rawCtx: ptr) =
    let ctx: OrcWorkerCtx = OrcWorkerCtx(rawCtx)
    for _ in 0..<1000:
        memRetainAtomic(ctx.raw)
        memReleaseAtomic(ctx.raw)
    AtomicIncrement(ctx.done)

fn WaitAtomicAtLeast(cell: atomic.I32,
                     expected: int32): bool =
    var spins: int32
    while spins < 20000000:
        if atomic.LoadI32(cell) >= expected:
            return true
        spins = spins + 1
        thread.Yield()
    return false

fn main(): int32 =
    if thread.Parallelism() <= 1:
        return 11

    let threadAtomicCounter = atomic.NewI32(0)
    let threadOrcDone = atomic.NewI32(0)
    if threadAtomicCounter == nil || threadOrcDone == nil:
        return 12
    let atomicCtx = new(AtomicWorkerCtx)
    if atomicCtx == nil:
        return 12
    atomicCtx.counter = threadAtomicCounter
    let threadAtomicCounterRaw: ptr = &atomicCtx.counter

    async.SpawnPtr(&ThreadAtomicWorker, threadAtomicCounterRaw)
    let _ = thread.SpawnPtr(&ThreadAtomicWorker, threadAtomicCounterRaw)
    let _ = thread.SpawnPtr(&ThreadAtomicWorker, threadAtomicCounterRaw)
    let _ = thread.SpawnPtr(&ThreadAtomicWorker, threadAtomicCounterRaw)
    if !WaitAtomicAtLeast(threadAtomicCounter, 4):
        return 13

    let threadOrcRaw: ptr = runtimeHeapNew(16)
    if threadOrcRaw == nil:
        return 14
    if memRefCountAtomic(threadOrcRaw) != 1:
        return 15

    let orcCtx = new(OrcWorkerCtx)
    if orcCtx == nil:
        return 20
    orcCtx.raw = threadOrcRaw
    orcCtx.done = threadOrcDone
    let orcCtxRaw: ptr = &orcCtx.raw
    let _ = thread.SpawnPtr(&ThreadOrcWorker, orcCtxRaw)
    let _ = thread.SpawnPtr(&ThreadOrcWorker, orcCtxRaw)
    let _ = thread.SpawnPtr(&ThreadOrcWorker, orcCtxRaw)
    let _ = thread.SpawnPtr(&ThreadOrcWorker, orcCtxRaw)
    if !WaitAtomicAtLeast(threadOrcDone, 4):
        return 16
    if memRefCountAtomic(threadOrcRaw) != 1:
        return 17

    memReleaseAtomic(threadOrcRaw)
    let _ = linuxWrite(1, " thread_atomic_orc_runtime_smoke ok\n", 36)
    return 0
