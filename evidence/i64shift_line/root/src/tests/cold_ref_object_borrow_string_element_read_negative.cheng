type
    ColdRefObjectBorrowStringElementOuter = ref object
        text: str

fn ColdRefObjectBorrowStringElementWrite(
        text: var str) =
    text = "changed"

fn ColdRefObjectBorrowStringElementMutate(
        out: var ColdRefObjectBorrowStringElementOuter) =
    var text = out.text
    let forbiddenCharacter = out.text[0]
    ColdRefObjectBorrowStringElementWrite(text)
    if forbiddenCharacter == 'x':
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowStringElementOuter)
    out.text = "initial"
    ColdRefObjectBorrowStringElementMutate(out)
    return 0
