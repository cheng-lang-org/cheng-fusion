import std/result
import cheng/inference/moe_router as moe

fn main(): int32 =
    let scores: int32[] = [
        90, 20, 10,
        30, 80, 70,
        50, 50, 10
    ]
    let planRes = moe.MoeRouteTop2(scores, 3, 3, 3)
    assert(IsOk(planRes), " moe router smoke: route")
    let plan = Value(planRes)
    assert(IsOk(moe.MoeValidateRoutePlan(plan)), " moe router smoke: validate")
    assert(plan.choices[0].expert0 == 0 && plan.choices[0].expert1 == 1,
        " moe router smoke: token0")
    assert(plan.choices[1].expert0 == 1 && plan.choices[1].expert1 == 2,
        " moe router smoke: token1")
    assert(plan.choices[2].expert0 == 0 && plan.choices[2].expert1 == 1,
        " moe router smoke: tie lower expert first")
    assert(plan.expertLoads[0] == 2, " moe router smoke: load0")
    assert(plan.expertLoads[1] == 3, " moe router smoke: load1")
    assert(plan.expertLoads[2] == 1, " moe router smoke: load2")

    let combinedRes = moe.MoeCombineExpertScalars(plan, [100, 10, 1])
    assert(IsOk(combinedRes), " moe router smoke: combine")
    let combined = Value(combinedRes)
    assert(combined[0] == 110 && combined[1] == 11 && combined[2] == 110,
        " moe router smoke: combine values")

    let overflowRes = moe.MoeRouteTop2(scores, 3, 3, 1)
    assert(IsErr(overflowRes), " moe router smoke: overflow hard fail")

    let set = moe.MoeRoutePlanSetBuild([
        moe.MoeLayerRoutePlan(layerIndex: 0, routePlan: plan),
        moe.MoeLayerRoutePlan(layerIndex: 1, routePlan: plan)
    ])
    assert(IsOk(moe.MoeValidateRoutePlanSet(set)) &&
           moe.MoeRoutePlanSetContainsRoute(set, plan.routeHash),
           " moe router smoke: route set")
    var badSet = set
    badSet.layerRoutes[1].layerIndex = 3
    badSet.routeSetHash = moe.MoeRoutePlanSetHash(badSet)
    assert(IsErr(moe.MoeValidateRoutePlanSet(badSet)),
        " moe router smoke: route set order hard fail")
    var badExpertPlan = plan
    badExpertPlan.choices[0].expert0 = 3
    badExpertPlan.routeHash = moe.MoeRouteHash(badExpertPlan)
    assert(IsErr(moe.MoeValidateRoutePlan(badExpertPlan)),
        " moe router smoke: expert bounds hard fail")
    let freshPlanRes = moe.MoeRouteTop2(scores, 3, 3, 3)
    assert(IsOk(freshPlanRes), " moe router smoke: fresh route")
    var badLoadPlan = Value(freshPlanRes)
    badLoadPlan.expertLoads[0] = badLoadPlan.expertLoads[0] + 1
    badLoadPlan.routeHash = moe.MoeRouteHash(badLoadPlan)
    assert(IsErr(moe.MoeValidateRoutePlan(badLoadPlan)),
        " moe router smoke: load mismatch hard fail")
    let freshTokenPlanRes = moe.MoeRouteTop2(scores, 3, 3, 3)
    assert(IsOk(freshTokenPlanRes), " moe router smoke: fresh token route")
    var badTokenPlan = Value(freshTokenPlanRes)
    badTokenPlan.choices[1].tokenIndex = 0
    badTokenPlan.routeHash = moe.MoeRouteHash(badTokenPlan)
    assert(IsErr(moe.MoeValidateRoutePlan(badTokenPlan)),
        " moe router smoke: token order hard fail")

    echo(" moe_router_smoke ok")
    return 0
