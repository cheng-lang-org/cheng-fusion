import std/strutils as strutil
import cheng/core/lang/typed_expr as texpr

fn MigrationSource(): str =
    return "proc main(): int32 =\n    if false:\n        return 1\n    else if true:\n        return 0\n    return 2\n"

fn SourceText(migrationSourceSyntax: bool): texpr.TypedExprSourceText =
    var out: texpr.TypedExprSourceText
    out.sourcePath = "/workspace/src/main.cheng"
    out.text = MigrationSource()
    out.textLoaded = true
    out.snapshotOnly = true
    out.migrationSourceSyntax = migrationSourceSyntax
    return out

fn main(): int32 =
    var ordinarySource = SourceText(false)
    var ordinaryContext: texpr.TypedExprSourceContext
    var err = ""
    assert(!texpr.TypedExprBuildSourceContext(
                ordinarySource, ordinaryContext, err),
           "typed expr migration syntax: ordinary context admitted proc")
    assert(strutil.Contains(err, "unsupported top-level function alias 'proc'"),
           Fmt"typed expr migration syntax: ordinary diagnostic drift {err}")
    texpr.TypedExprClearSourceContextAllFields(ordinaryContext)

    var migrationSource = SourceText(true)
    var migrationContext: texpr.TypedExprSourceContext
    err = ""
    assert(texpr.TypedExprBuildSourceContext(
               migrationSource, migrationContext, err),
           Fmt"typed expr migration syntax: migration context rejected {err}")
    assert(migrationContext.scopes.len == 1 &&
           migrationContext.scopes[0].name == "main" &&
           migrationContext.scopes[0].startLine == 1,
           "typed expr migration syntax: canonical function scope drift")
    texpr.TypedExprClearSourceContextAllFields(migrationContext)
    echo("TYPED_EXPR_MIGRATION_SOURCE_SYNTAX_OK")
    return 0
