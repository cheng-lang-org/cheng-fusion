import std/system as system

type ColdManagedExactFixedArrayNestedStrOwner =
    matrix: str[2][2]

fn ColdManagedExactFixedArrayNestedStrNew(value: str): str =
    return system.NewStringCopy(
        system.StrDataPtr(value), value.len)

fn ColdManagedExactFixedArrayNestedStrExercise(): int32 =
    var owner: ColdManagedExactFixedArrayNestedStrOwner
    owner.matrix[0][0] = ColdManagedExactFixedArrayNestedStrNew("a0")
    owner.matrix[0][1] = ColdManagedExactFixedArrayNestedStrNew("a1")
    owner.matrix[1][0] = ColdManagedExactFixedArrayNestedStrNew("b0")
    owner.matrix[1][1] = ColdManagedExactFixedArrayNestedStrNew("b1")

    owner.matrix[0][1] = owner.matrix[0][1]
    owner.matrix[1][0] = ColdManagedExactFixedArrayNestedStrNew("b2")
    owner.matrix[1][1] = ""

    if owner.matrix[0][0] != "a0" ||
       owner.matrix[0][1] != "a1" ||
       owner.matrix[1][0] != "b2" ||
       len(owner.matrix[1][1]) != 0:
        return 1
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactFixedArrayNestedStrExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        return 2
    if system.memLiveCount() != liveBefore:
        return 3
    if releaseDelta != retainDelta + freeDelta:
        return 4
    echo("cold_managed_exact_fixed_array_nested_str=PASS")
    return 0
