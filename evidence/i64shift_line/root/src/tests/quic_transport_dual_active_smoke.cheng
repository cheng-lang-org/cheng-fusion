import std/system
import std/result
import std/rawbytes
import cheng/libp2p/core/types
import cheng/libp2p/core/multistream
import cheng/libp2p/transports/quic_transport
import cheng/quic/connection as qconn
import cheng/quic/msquictransport_native as qtransport

# True dual-active QUIC smoke: a single process opens TWO concurrently-active
# connections (modelling a video stream + an audio stream) to one listener that
# serves both at once, then interleaves writes/reads on the two connections and
# asserts each connection sees ONLY its own payload (no slot cross-talk). This is
# the dual-active judge (not serial reuse): both connections are live at the same
# time and must land on different native slots.

fn quicDualBytesEqual(left: Bytes, right: Bytes): bool =
    if BytesLen(left) != BytesLen(right):
        return false
    for i in 0..<BytesLen(left):
        if BytesGet(left, i) != BytesGet(right, i):
            return false
    return true

fn quicDualSelect(clientT: var qtransport.MsQuicTransport,
                  clientConn: var qconn.Connection,
                  listener: var qtransport.MsQuicTransport,
                  serverConn: var qconn.Connection): Result[bool] =
    let selectBytes = multistream.Libp2pMultistreamSelectBytes(types.Libp2pProtocolBftProposal)
    let cw = quic_transport.Libp2pQuicWriteExact(clientT, clientConn, selectBytes)
    if IsErr(cw):
        return Err[bool](Error(cw))
    let sr = quic_transport.Libp2pQuicReadExact(listener, serverConn, BytesLen(selectBytes))
    if IsErr(sr):
        return Err[bool](Error(sr))
    if !multistream.Libp2pMultistreamAccepts(Value(sr), types.Libp2pProtocolBftProposal):
        return Err[bool](" dual: select request mismatch")
    let sw = quic_transport.Libp2pQuicWriteExact(listener, serverConn, selectBytes)
    if IsErr(sw):
        return Err[bool](Error(sw))
    let cr = quic_transport.Libp2pQuicReadExact(clientT, clientConn, BytesLen(selectBytes))
    if IsErr(cr):
        return Err[bool](Error(cr))
    if !multistream.Libp2pMultistreamAccepts(Value(cr), types.Libp2pProtocolBftProposal):
        return Err[bool](" dual: select response mismatch")
    return Ok[bool](true)

fn main(): int32 =
    var listener = qtransport.InitMsQuicTransport()
    let startRes = quic_transport.Libp2pQuicStartListener(listener, "127.0.0.1", 0)
    assert(IsOk(startRes), " dual: start listener")
    let port = Value(startRes)
    assert(port > 0, " dual: bound port")

    # --- Dial connection A (video) while leaving it open ---
    var clientA = qtransport.InitMsQuicTransport()
    var connA: qconn.Connection
    let dialA = quic_transport.Libp2pQuicDialClient(clientA, connA, "127.0.0.1", port)
    assert(IsOk(dialA), " dual: dial A")
    let acceptA = qtransport.accept(listener)
    assert(IsOk(acceptA), " dual: accept A")
    var serverA = Value(acceptA)
    let selA = quicDualSelect(clientA, connA, listener, serverA)
    assert(IsOk(selA), " dual: select A")

    # --- Dial connection B (audio) WITHOUT closing A: both now live ---
    var clientB = qtransport.InitMsQuicTransport()
    var connB: qconn.Connection
    let dialB = quic_transport.Libp2pQuicDialClient(clientB, connB, "127.0.0.1", port)
    assert(IsOk(dialB), " dual: dial B (second concurrent connection)")
    let acceptB = qtransport.accept(listener)
    assert(IsOk(acceptB), " dual: accept B")
    var serverB = Value(acceptB)
    let selB = quicDualSelect(clientB, connB, listener, serverB)
    assert(IsOk(selB), " dual: select B")

    # Both connections must have landed on DIFFERENT native pipes (slots).
    assert(connA.pipeIdx != connB.pipeIdx, " dual: A and B share a pipe (not dual-active)")

    # --- Interleave application traffic on A and B; payloads are distinct ---
    let payA = BytesFromString("VIDEO-FRAME-AAAAAAAA")
    let payB = BytesFromString("AUDIO-CHUNK-BBBBBBBB")

    # client A -> server A, then client B -> server B (interleaved)
    let waR = quic_transport.Libp2pQuicWriteExact(clientA, connA, payA)
    assert(IsOk(waR), " dual: write A->serverA")
    let wbR = quic_transport.Libp2pQuicWriteExact(clientB, connB, payB)
    assert(IsOk(wbR), " dual: write B->serverB")

    let raR = quic_transport.Libp2pQuicReadExact(listener, serverA, BytesLen(payA))
    assert(IsOk(raR), " dual: read serverA")
    assert(quicDualBytesEqual(Value(raR), payA), " dual: serverA got wrong payload (cross-talk)")

    let rbR = quic_transport.Libp2pQuicReadExact(listener, serverB, BytesLen(payB))
    assert(IsOk(rbR), " dual: read serverB")
    assert(quicDualBytesEqual(Value(rbR), payB), " dual: serverB got wrong payload (cross-talk)")

    # server B -> client B, then server A -> client A (reverse interleave)
    let payA2 = BytesFromString("VIDEO-ACK-11111111")
    let payB2 = BytesFromString("AUDIO-ACK-22222222")
    let wb2 = quic_transport.Libp2pQuicWriteExact(listener, serverB, payB2)
    assert(IsOk(wb2), " dual: write serverB->B")
    let wa2 = quic_transport.Libp2pQuicWriteExact(listener, serverA, payA2)
    assert(IsOk(wa2), " dual: write serverA->A")

    let rb2 = quic_transport.Libp2pQuicReadExact(clientB, connB, BytesLen(payB2))
    assert(IsOk(rb2), " dual: read clientB")
    assert(quicDualBytesEqual(Value(rb2), payB2), " dual: clientB got wrong payload (cross-talk)")

    let ra2 = quic_transport.Libp2pQuicReadExact(clientA, connA, BytesLen(payA2))
    assert(IsOk(ra2), " dual: read clientA")
    assert(quicDualBytesEqual(Value(ra2), payA2), " dual: clientA got wrong payload (cross-talk)")

    qconn.ConnClose(serverA)
    qconn.ConnClose(serverB)
    qconn.ConnClose(connA)
    qconn.ConnClose(connB)
    qtransport.Stop(listener)
    echo(" quic_transport_dual_active_smoke ok")
    return 0
