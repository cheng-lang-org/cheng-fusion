import std/strutils as strutil
import cheng/core/lang/parser

fn FixtureText(): str =
    var lines: str[]
    add(lines, "type")
    add(lines, "    CtorRow =")
    add(lines, "        left: int32")
    add(lines, "        right: int32")
    add(lines, "    Pair =")
    add(lines, "        left: int32")
    add(lines, "        right: int32")
    add(lines, "    Inner =")
    add(lines, "        value: int32")
    add(lines, "    Outer =")
    add(lines, "        left: int32")
    add(lines, "        inner: Inner")
    add(lines, "        right: int32")
    add(lines, "")
    add(lines, "fn Touch(value: int32): int32 = value + 1")
    add(lines, "")
    add(lines, "fn Named(left: int32, right: int32): int32 =")
    add(lines, "    return left * 10 + right")
    add(lines, "")
    add(lines, "fn Pair(left: int32, right: int32): int32 =")
    add(lines, "    return left * 100 + right")
    add(lines, "")
    add(lines, "fn Build(): int32 =")
    add(lines, "    let paren = CtorRow(left: Touch(1), right: Touch(2))")
    add(lines, "    let braced = CtorRow { left: Touch(3), right: Touch(4) }")
    add(lines, "    let nested = Outer(")
    add(lines, "        left: Touch(5),")
    add(lines, "        inner: Inner(value: Touch(6)),")
    add(lines, "        right: Touch(7),")
    add(lines, "    )")
    add(lines, "    let named = Named(8, 9)")
    add(lines, "    let sameNameCtor = Pair(left: Touch(10), right: Touch(11))")
    add(lines, "    let sameNameCall = Pair(Touch(12), Touch(13))")
    add(lines, "    let plain = Touch(14)")
    add(lines, "    return paren.left + braced.right + nested.inner.value + sameNameCtor.left + named + sameNameCall + plain")
    return strutil.Join(lines, "\n")

fn main(): int32 =
    var layer: parser.NormalizedExprLayer
    var err: str
    if !parser.ParserReadNormalizedExprLayerFromText("/work/pkg/main.cheng",
                                                     FixtureText(),
                                                     layer,
                                                     err):
        echo(err)
        return 1
    for i in 0..<layer.exprs.len:
        let expr = layer.exprs[i]
        if expr.kind != parser.NormalizedExprCall:
            continue
        echo(strutil.Join(["callee=", expr.callCallee,
                           " line=", IntToStr(expr.lineNumber),
                           " end=", IntToStr(expr.endLineNumber),
                           " argc=", IntToStr(expr.callArgCount),
                           " args=", expr.callArgsText], ""))
    parser.NormalizedExprLayerReset(layer)
    return 0
