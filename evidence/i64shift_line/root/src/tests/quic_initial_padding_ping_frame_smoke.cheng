# Repro + regression guard for QUIC interop gap 1 (task #40): the server-side
# Initial-packet frame loop (msquicNativeProcessServerInitialDirect) used to
# decode every frame unconditionally as a 5-field CRYPTO-shaped tuple with no
# dispatch on frame type. RFC 9000 §14.1 requires a client to pad its Initial
# datagram with PADDING (type 0x00, RFC 9000 §19.3) up to 1200 bytes; PING
# (type 0x01, §19.2) is also legal there. Both carry no fields at all. Before
# the fix, walking either of those into the CRYPTO-shaped decoder ran past the
# buffer and rejected an otherwise perfectly valid Initial packet outright --
# exactly what an independent QUIC client's real (padded) Initial triggered.
#
# This builds this codebase's own real ClientHello CRYPTO frame (proving the
# TLS content itself is fine), appends a PING frame and then a real PADDING
# run to pad the payload to a size representative of a real 1200-byte
# datagram, and feeds it straight into the frame loop.

import std/strutils as strutil
import std/result
import std/rawbytes
import cheng/quic/native_runtime as qnative
import cheng/quic/tls/policy as qpolicy
import cheng/quic/tls/handshake13
import cheng/quic/core/packet_header_model

fn smokePolicy(): qpolicy.MsQuicTlsPolicy =
    var out: qpolicy.MsQuicTlsPolicy
    out.serverName = "localhost"
    return out

fn freshServerInitialHeader(): packet_header_model.QuicPacketHeaderDecoded =
    var out: packet_header_model.QuicPacketHeaderDecoded
    out.header.longHeader = true
    out.header.packetType = packet_header_model.QuicPacketInitial
    out.header.packetNumber = 1
    return out

fn main(): int32 =
    qnative.msquicNativeResetSession()
    let policy: qpolicy.MsQuicTlsPolicy = smokePolicy()
    qnative.msquicNativeSetClientPolicyCache(policy)

    # Real CRYPTO frame carrying a real ClientHello (this codebase's own
    # frame encoding -- "existing support", unchanged by this fix).
    let cryptoRes: Result[rawbytes.Bytes] = qnative.msquicNativeDebugBuildClientHelloPayload()
    if IsErr(cryptoRes):
        panic(ErrorText(cryptoRes))
    let cryptoFrame: rawbytes.Bytes = Value(cryptoRes)
    assert(BytesLen(cryptoFrame) > 0, "client hello crypto frame built")

    # One PING frame (type 0x01, no fields) right after it.
    let pingFrame: rawbytes.Bytes = BytesAlloc(1)
    BytesSet(pingFrame, 0, 1)

    # PADDING (type 0x00, no fields) filling the rest of a realistic
    # 1200-byte Initial datagram (minus a conservative long-header budget).
    let targetPayloadLen: int32 = 1170
    let paddingLen: int32 = targetPayloadLen - BytesLen(cryptoFrame) - BytesLen(pingFrame)
    assert(paddingLen > 0, "padding budget positive")
    let padding: rawbytes.Bytes = BytesAlloc(paddingLen)

    let payload: rawbytes.Bytes = BytesConcat3(cryptoFrame, pingFrame, padding)
    assert(BytesLen(payload) == targetPayloadLen, "padded initial payload sized to target")

    qnative.msquicNativeResetServerHandshake(false)
    let headerDec: packet_header_model.QuicPacketHeaderDecoded = freshServerInitialHeader()
    let ok: bool = qnative.msquicNativeProcessServerInitialDirect(headerDec, payload)

    # The frame loop itself must have succeeded regardless of whatever happens
    # afterwards trying to send a server flight (which needs a cert chain this
    # unit test never sets up) -- that is the gap-1 fix's exact scope. Before
    # the fix this was false because msquicNativeServerClientKeyShareGroup()
    # was never reached: the loop errored out on the PING/PADDING bytes
    # before finishing.
    let keyShareGroup: int32 = qnative.msquicNativeServerClientKeyShareGroup()
    assert(keyShareGroup > 0, "real ClientHello crypto data survived trailing PING+PADDING")

    if ! ok:
        # Only acceptable post-loop failure is the (unrelated to this fix)
        # missing-cert-chain flight-send error; the frame loop's own error
        # strings must never appear here again.
        assert(!strutil.Contains(qnative.msquicNativeResultErrorScratch, "frame"), qnative.msquicNativeResultErrorScratch)

    echo(" quic_initial_padding_ping_frame_smoke ok")
    return 0
