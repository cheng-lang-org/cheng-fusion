import cheng/core/runtime/web_scene_runtime as scene
import cheng/core/runtime/web_paint_runtime as paint
import cheng/core/runtime/web_layout_runtime as layout
import std/strutils as strutil
import std/strings as strings
import std/times as times

# Micro-benchmark + mutation-invalidation correctness repro for three
# frame-path optimizations in web_scene_runtime.cheng:
#   A. WebSceneInvalidateLayerCachesForDirtySpans no longer rebuilds the
#      graph-wide paintOp/paintShadow/paintGradient range index once per
#      layer per dirty span (it rebuilds it once for the whole batch).
#   B. WebSceneGlyphAtlasAppendExistingGlyphTextRun's per-character glyph
#      lookup (fixed fontAtlasId+fontSize within one run) is memoized
#      instead of rescanning the whole atlas.glyphs per character.
#   C. WebSceneAppendPaintCommand's SVG icon primitive collection uses a
#      (nodeId)-range index instead of scanning all paintSvgPrimitives.
#   D. WebSceneFindLayoutBoxIndex delegates to WebLayoutFindBestBoxIndex,
#      replacing one full layout-box scan per painted node with an indexed
#      lookup while preserving the first-visible/first-match rule.
#   E. Interaction indexes survive paint/state dirtiness and rebuild only
#      when route/event topology actually changes.
# This file only calls entry points whose *signature* is unchanged by the
# optimizations (WebSceneInvalidateLayerCachesForDirtySpans,
# WebSceneRebuildPaintCommandRangeIndexes, WebSceneAppendPaintCommand,
# WebSceneGlyphAtlasAppendExistingGlyphTextRun) so the same source compiles
# unmodified against both the baseline tree and the optimized tree.

fn BuildBenchARoute(graph: var scene.WebSceneGraph, routeIndex: var int32, layerCount: int32, nodesPerLayer: int32): bool =
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRoute(graph, "bench_a_route", 1, 1, routeIndex):
        echo("BuildBenchARoute: AddRoute failed")
        return false
    var layerId = 1
    while layerId <= layerCount:
        if !scene.WebSceneAddLayer(graph, routeIndex, layerId, Fmt"layer{layerId}", layerId - 1):
            echo(strutil.Join(["BuildBenchARoute: AddLayer failed layerId=", IntToStr(layerId)], ""))
            return false
        layerId = layerId + 1
    if !scene.WebSceneAddNode(graph, routeIndex, 1, 0, 2, "div", "", 1):
        echo("BuildBenchARoute: AddNode root failed")
        return false
    var nodeId = 2
    layerId = 1
    while layerId <= layerCount:
        var n = 0
        while n < nodesPerLayer:
            if !scene.WebSceneAddNode(graph, routeIndex, nodeId, 1, 2, "div", "", layerId):
                echo(strutil.Join(["BuildBenchARoute: AddNode failed nodeId=", IntToStr(nodeId)], ""))
                return false
            if !scene.WebSceneAddPaintOpAt(graph, routeIndex, nodeId, 0, 0, 0, scene.WebScenePaintFill, Int64(4278190080), 0, 10, 10, "", ""):
                echo(strutil.Join(["BuildBenchARoute: AddPaintOpAt failed nodeId=", IntToStr(nodeId)], ""))
                return false
            nodeId = nodeId + 1
            n = n + 1
        layerId = layerId + 1
    layerId = 1
    while layerId <= layerCount:
        if !scene.WebSceneEnsureLayerCache(graph, routeIndex, layerId):
            echo(strutil.Join(["BuildBenchARoute: EnsureLayerCache failed layerId=", IntToStr(layerId)], ""))
            return false
        layerId = layerId + 1
    return true

fn QueueRouteDirtySpans(graph: var scene.WebSceneGraph, routeIndex: int32, spanCount: int32) =
    var i = 0
    while i < spanCount:
        var span: scene.WebSceneDirtySpan
        span.routeIndex = routeIndex
        span.nodeId = 0
        span.layerId = 0
        span.reason = scene.WebSceneDirtyRoute
        add(graph.dirtySpans, span)
        i = i + 1

fn BenchA(iterations: int32, layerCount: int32, nodesPerLayer: int32, spansPerBatch: int32): int64 =
    var graph: scene.WebSceneGraph
    var routeIndex = -1
    if !BuildBenchARoute(graph, routeIndex, layerCount, nodesPerLayer):
        echo("BenchA setup failed")
        return -1
    QueueRouteDirtySpans(graph, routeIndex, spansPerBatch)
    let t0 = times.MonotimeNs()
    var i = 0
    while i < iterations:
        if !scene.WebSceneInvalidateLayerCachesForDirtySpans(graph):
            echo("BenchA invalidate failed")
            return -1
        i = i + 1
    let t1 = times.MonotimeNs()
    return t1 - t0

fn BuildBenchBAtlas(atlas: var scene.WebSceneGlyphAtlas, decoyGlyphCount: int32, realCodepointCount: int32): bool =
    scene.WebSceneGlyphAtlasInit(atlas)
    atlas.atlasWidth = 512
    atlas.atlasHeight = 512
    # Decoy entries: a different (fontAtlasId, fontSize) pair interleaved
    # throughout, so the real entries are not clustered at one end of the
    # array (matches production: thousands of glyphs across many
    # font/size combos share one flat atlas.glyphs array).
    var i = 0
    var realInserted = 0
    while i < decoyGlyphCount + realCodepointCount:
        var g: scene.WebSceneGlyphAtlasGlyphEntry
        if i % 5 == 0 && realInserted < realCodepointCount:
            g.glyphId = i + 1
            g.fontAtlasId = 101
            g.sdfAtlasId = 1001
            g.codepoint = 32 + realInserted
            g.fontSize = 14
            g.advance = 8
            g.width = 10
            g.height = 10
            g.sdfPixelStart = 0
            g.sdfPixelCount = 100
            realInserted = realInserted + 1
        else:
            g.glyphId = i + 1
            g.fontAtlasId = 202
            g.sdfAtlasId = 2002
            g.codepoint = 1000 + i
            g.fontSize = 16
            g.advance = 9
            g.width = 11
            g.height = 11
            g.sdfPixelStart = 0
            g.sdfPixelCount = 100
        add(atlas.glyphs, g)
        i = i + 1
    return realInserted == realCodepointCount

fn BenchB(iterations: int32, decoyGlyphCount: int32, realCodepointCount: int32, textLen: int32): int64 =
    var atlas: scene.WebSceneGlyphAtlas
    if !BuildBenchBAtlas(atlas, decoyGlyphCount, realCodepointCount):
        echo("BenchB setup failed")
        return -1
    # Seed a resolved prior run so the loop hits the run.fontAtlasId fast
    # path (the memoized call) for every character, matching the
    # production "text already rendered once, state changed, rebuild"
    # path WebSceneRefreshStateTextGlyphRunsForRoute drives.
    var seedRun: scene.WebSceneGlyphRun
    seedRun.routeIndex = 0
    seedRun.nodeId = 55
    seedRun.ordinal = 0
    seedRun.fontAtlasId = 101
    seedRun.sdfAtlasId = 1001
    seedRun.glyphCount = 1
    add(atlas.runs, seedRun)
    var text = ""
    var i = 0
    while i < textLen:
        let cp = 32 + (i % realCodepointCount)
        text = strutil.Join([text, strings.CharToStr(char(cp))], "")
        i = i + 1
    var sceneOp: scene.WebScenePaintOp
    sceneOp.routeIndex = 0
    sceneOp.nodeId = 55
    sceneOp.ordinal = 0
    sceneOp.opKind = scene.WebScenePaintText
    sceneOp.fontSize = 14
    sceneOp.textContent = text
    let t0 = times.MonotimeNs()
    var iter = 0
    while iter < iterations:
        setLen(atlas.runs, 1)
        setLen(atlas.runGlyphs, 0)
        if !scene.WebSceneGlyphAtlasAppendExistingGlyphTextRun(sceneOp, atlas):
            echo("BenchB append failed")
            return -1
        iter = iter + 1
    let t1 = times.MonotimeNs()
    return t1 - t0

fn BuildBenchCGraph(graph: var scene.WebSceneGraph, routeIndex: var int32, iconCount: int32, primitivesPerIcon: int32): bool =
    scene.WebSceneGraphInit(graph)
    if !scene.WebSceneAddRoute(graph, "bench_c_route", 1, 1, routeIndex):
        return false
    if !scene.WebSceneAddLayer(graph, routeIndex, 1, "content", 0):
        return false
    if !scene.WebSceneAddNode(graph, routeIndex, 1, 0, 2, "div", "", 1):
        return false
    var nodeId = 2
    var i = 0
    while i < iconCount:
        if !scene.WebSceneAddNode(graph, routeIndex, nodeId, 1, 2, "svg", "", 1):
            return false
        if !scene.WebSceneAddPaintOpAt(graph, routeIndex, nodeId, 0, 0, 0, scene.WebScenePaintSvgIcon, Int64(4278190080), 0, 16, 16, "icon", ""):
            return false
        var p = 0
        while p < primitivesPerIcon:
            if !scene.WebSceneAddPaintSvgLineKnownPaintOp(graph, routeIndex, nodeId, 0, p, p, p + 1, p + 1):
                return false
            p = p + 1
        nodeId = nodeId + 1
        i = i + 1
    return true

fn BenchC(iterations: int32, iconCount: int32, primitivesPerIcon: int32): int64 =
    var graph: scene.WebSceneGraph
    var routeIndex = -1
    if !BuildBenchCGraph(graph, routeIndex, iconCount, primitivesPerIcon):
        echo("BenchC setup failed")
        return -1
    if !scene.WebSceneRebuildPaintCommandRangeIndexes(graph):
        echo("BenchC index rebuild failed")
        return -1
    let t0 = times.MonotimeNs()
    var iter = 0
    while iter < iterations:
        var nodeId = 2
        var i = 0
        while i < iconCount:
            var ops: paint.PaintOp[]
            let paintOpIndex = scene.WebSceneFindPaintOpIndex(graph, routeIndex, nodeId, 0)
            if paintOpIndex < 0:
                echo("BenchC paint op not found")
                return -1
            let sceneOp = graph.paintOps[paintOpIndex]
            if !scene.WebSceneAppendPaintCommand(graph, sceneOp, ops):
                echo("BenchC append failed")
                return -1
            if ops.len != 1 || ops[0].icon.primitives.len != primitivesPerIcon:
                echo("BenchC correctness mismatch")
                return -1
            nodeId = nodeId + 1
            i = i + 1
        iter = iter + 1
    let t1 = times.MonotimeNs()
    return t1 - t0

fn BaselineFindBestLayoutBoxIndex(tree: var layout.WebLayoutTree, nodeId: int32): int32 =
    var firstMatch: int32 = -1
    var i: int32
    while i < tree.boxes.len:
        if tree.boxes[i].nodeId == nodeId:
            if firstMatch < 0:
                firstMatch = i
            if tree.boxes[i].visible && tree.boxes[i].width > 0 && tree.boxes[i].height > 0:
                return i
        i = i + 1
    return firstMatch

fn BuildBenchDTree(tree: var layout.WebLayoutTree, boxCount: int32): bool =
    layout.WebLayoutTreeInit(tree)
    var i: int32
    while i < boxCount:
        var box: layout.WebLayoutBox
        box.nodeId = i + 1
        box.width = 10
        box.height = 10
        box.visible = true
        add(tree.boxes, box)
        i = i + 1
    return layout.WebLayoutRebuildBoxIndexes(tree)

fn CheckBenchDIndexSemantics(): bool =
    var tree: layout.WebLayoutTree
    layout.WebLayoutTreeInit(tree)
    var hidden: layout.WebLayoutBox
    hidden.nodeId = 7
    hidden.width = 10
    hidden.height = 10
    hidden.visible = false
    add(tree.boxes, hidden)
    var visible: layout.WebLayoutBox
    visible.nodeId = 7
    visible.width = 10
    visible.height = 10
    visible.visible = true
    add(tree.boxes, visible)
    var hiddenOnly: layout.WebLayoutBox
    hiddenOnly.nodeId = 8
    hiddenOnly.width = 10
    hiddenOnly.height = 10
    hiddenOnly.visible = false
    add(tree.boxes, hiddenOnly)
    if !layout.WebLayoutRebuildBoxIndexes(tree):
        return false
    if layout.WebLayoutFindBestBoxIndex(tree, 7) != 1:
        return false
    if layout.WebLayoutFindBestBoxIndex(tree, 8) != 2:
        return false
    if layout.WebLayoutFindBestBoxIndex(tree, 99) != -1:
        return false
    var appended: layout.WebLayoutBox
    appended.nodeId = 9
    appended.width = 10
    appended.height = 10
    appended.visible = true
    add(tree.boxes, appended)
    return layout.WebLayoutFindBestBoxIndex(tree, 9) == 3

fn BenchDLinear(tree: var layout.WebLayoutTree, iterations: int32): int64 =
    let t0 = times.MonotimeNs()
    var checksum: int64
    var iter: int32
    while iter < iterations:
        var nodeId = 1
        while nodeId <= tree.boxes.len:
            checksum = checksum + int64(BaselineFindBestLayoutBoxIndex(tree, nodeId))
            nodeId = nodeId + 1
        iter = iter + 1
    let t1 = times.MonotimeNs()
    let expected = int64(iterations) * int64(tree.boxes.len) * int64(tree.boxes.len - 1) / int64(2)
    if checksum != expected:
        return -1
    return t1 - t0

fn BenchDIndexed(tree: var layout.WebLayoutTree, iterations: int32): int64 =
    if !layout.WebLayoutRebuildBoxIndexes(tree):
        return -1
    let t0 = times.MonotimeNs()
    var checksum: int64
    var iter: int32
    while iter < iterations:
        var nodeId = 1
        while nodeId <= tree.boxes.len:
            checksum = checksum + int64(layout.WebLayoutFindBestBoxIndex(tree, nodeId))
            nodeId = nodeId + 1
        iter = iter + 1
    let t1 = times.MonotimeNs()
    let expected = int64(iterations) * int64(tree.boxes.len) * int64(tree.boxes.len - 1) / int64(2)
    if checksum != expected:
        return -1
    return t1 - t0

fn CheckBenchEInteractionIndexInvalidation(): bool =
    var graph: scene.WebSceneGraph
    scene.WebSceneGraphInit(graph)
    var route0 = -1
    var route1 = -1
    var route2 = -1
    if !scene.WebSceneAddRoute(graph, "bench_e_0", 1, 1, route0):
        return false
    if !scene.WebSceneAddRoute(graph, "bench_e_1", 10, 10, route1):
        return false
    if !scene.WebSceneAddRoute(graph, "bench_e_2", 20, 20, route2):
        return false
    if !scene.WebSceneAddLayer(graph, route0, 1, "route0", 0):
        return false
    if !scene.WebSceneAddLayer(graph, route1, 101, "route1", 0):
        return false
    if !scene.WebSceneAddLayer(graph, route2, 201, "route2", 0):
        return false
    if !scene.WebSceneAddStateRouteDependency(graph, "stateA", route0):
        return false
    if !scene.WebSceneAddStateRouteDependency(graph, "stateB", route1):
        return false
    if !scene.WebSceneAddStateRouteDependency(graph, "shared", route0):
        return false
    if !scene.WebSceneAddStateRouteDependency(graph, "shared", route2):
        return false
    if !scene.WebSceneSetStateValue(graph, "stateA", "one"):
        return false
    if scene.WebSceneRouteStateVersion(graph, route0) != 1 ||
       scene.WebSceneRouteStateVersion(graph, route1) != 0 ||
       scene.WebSceneRouteStateVersion(graph, route2) != 0:
        return false
    if !scene.WebSceneSetStateValue(graph, "stateA", "one"):
        return false
    if scene.WebSceneRouteStateVersion(graph, route0) != 1:
        return false
    if !scene.WebSceneSetStateValue(graph, "shared", "yes"):
        return false
    if scene.WebSceneRouteStateVersion(graph, route0) != 2 ||
       scene.WebSceneRouteStateVersion(graph, route1) != 0 ||
       scene.WebSceneRouteStateVersion(graph, route2) != 1:
        return false
    if !scene.WebSceneAddNode(graph, route0, 1, 0, 2, "div", "", 1):
        return false
    if !scene.WebSceneAddNode(graph, route0, 2, 1, 2, "button", "first", 1):
        return false
    if !scene.WebSceneAddNode(graph, route0, 3, 1, 2, "button", "second", 1):
        return false
    if !scene.WebSceneAddNode(graph, route1, 10, 0, 2, "div", "", 101):
        return false
    if !scene.WebSceneAddNode(graph, route2, 20, 0, 2, "div", "", 201):
        return false
    if !scene.WebSceneAddRouteEdge(graph, route0, 2, route1):
        return false
    if scene.WebSceneFindRouteTargetForNode(graph, route0, 2) != route1:
        return false
    let stableIndexVersion = graph.interactionVersion
    let stableIndexCount = graph.interactionRouteIds.len
    if !scene.WebSceneSetNodeInteractionState(graph, route0, 2, false, true, false):
        return false
    if scene.WebSceneFindRouteTargetForNode(graph, route0, 2) != route1:
        return false
    if graph.interactionVersion != stableIndexVersion || graph.interactionRouteIds.len != stableIndexCount:
        return false
    if !scene.WebSceneAddRouteEdge(graph, route0, 3, route2):
        return false
    if scene.WebSceneFindRouteTargetForNode(graph, route0, 3) != route2:
        return false
    return graph.interactionRouteIds.len == stableIndexCount + 1

fn ReportNsPerOp(label: str, totalNs: int64, ops: int32) =
    if ops <= 0:
        echo(strutil.Join([label, ": no ops"], ""))
        return
    let perOp = totalNs / int64(ops)
    let totalMs = totalNs / int64(1000000)
    echo(strutil.Join([label, ": total_ms=", IntToStr(int32(totalMs)), " ops=", IntToStr(ops), " ns_per_op=", IntToStr(int32(perOp))], ""))

fn main(): int32 =
    # -------- Bench A: dirty-span batch route-wide paint-index rebuild --------
    let aNs = BenchA(1000, 8, 40, 6)
    if aNs < 0:
        return 1
    ReportNsPerOp("BenchA(WebSceneInvalidateLayerCachesForDirtySpans, layers=8, nodes/layer=40, spans=6)", aNs, 1000)

    # -------- Bench B: text-run glyph lookup memo --------
    let bNs = BenchB(1000, 3000, 95, 300)
    if bNs < 0:
        return 1
    ReportNsPerOp("BenchB(WebSceneGlyphAtlasAppendExistingGlyphTextRun, glyphs=3095, text_len=300)", bNs, 1000)

    # -------- Bench C: SVG primitive node-range index --------
    let cNs = BenchC(1000, 60, 8)
    if cNs < 0:
        return 1
    ReportNsPerOp("BenchC(WebSceneAppendPaintCommand svg icon, icons=60, primitives/icon=8)", cNs, 1000 * 60)

    # -------- Bench D: layout-box full scan -> indexed lookup --------
    if !CheckBenchDIndexSemantics():
        echo("BenchD correctness mismatch")
        return 1
    var dTree: layout.WebLayoutTree
    if !BuildBenchDTree(dTree, 1000):
        echo("BenchD setup failed")
        return 1
    let dLinearNs = BenchDLinear(dTree, 100)
    let dIndexedNs = BenchDIndexed(dTree, 100)
    if dLinearNs < 0 || dIndexedNs < 0:
        return 1
    ReportNsPerOp("BenchD baseline linear layout-box lookup (boxes=1000)", dLinearNs, 100 * 1000)
    ReportNsPerOp("BenchD indexed layout-box lookup (boxes=1000)", dIndexedNs, 100 * 1000)

    # -------- Bench E: topology-scoped interaction-index invalidation --------
    if !CheckBenchEInteractionIndexInvalidation():
        echo("BenchE interaction index invalidation mismatch")
        return 1

    return 0
