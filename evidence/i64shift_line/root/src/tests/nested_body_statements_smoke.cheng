# Regression: statements inside nested control bodies must enter typed IR.
# A while body containing a nested if previously lost the entire loop body
# (assigns before/inside/after the nested if) and compiled as a dead loop.
fn main(): int32 =
    var i: int32
    var a: int32
    var b: int32
    var c: int32
    while i < 4:
        a = a + 1
        if a == 2:
            b = b + 10
        c = c + 100
        i = i + 1
    if a != 4:
        return 1
    if b != 10:
        return 2
    if c != 400:
        return 3
    var outer: int32
    var inner: int32
    var total: int32
    while outer < 3:
        inner = 0
        while inner < 2:
            total = total + 1
            inner = inner + 1
        outer = outer + 1
    if total != 6:
        return 4
    var flag: int32
    var steps: int32
    var k: int32
    flag = flag + 1
    if flag > 0:
        while k < 5:
            steps = steps + 2
            k = k + 1
    if steps != 10:
        return 5
    var x: int32
    var y: int32
    var z: int32
    var w: int32
    while x < 2:
        w = 0
        while w < 3:
            if w == 1:
                y = y + 7
            z = z + 1
            w = w + 1
        x = x + 1
    if y != 14:
        return 6
    if z != 6:
        return 7
    return 0
