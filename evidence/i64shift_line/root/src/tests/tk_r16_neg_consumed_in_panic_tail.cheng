import std/system

type
    TkR16NegBox =
        tag: str
        n: int32

fn TkR16NegConsumed(kind: int32, out: var TkR16NegBox): str =
    if kind == 1:
        let s = "TkR16Moved"
        out.tag = s
        return s
    panic("tk_r16 neg: invalid kind")

fn main(): int32 =
    var box: TkR16NegBox
    box.n = 1
    let s = TkR16NegConsumed(1, box)
    echo(Fmt"tk_r16_neg_consumed {s}")
    return 0
