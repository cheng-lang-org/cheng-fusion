# Game tick replay determinism:
#   1. two independent runtimes fed the identical seed world + typed input
#      script produce the identical per-tick receipt CID sequence (the
#      receipt CID is SHA-256 over the canonical tick preimage, which
#      chains world CIDs and the physics step receipt CID);
#   2. receipt tampering is rejected by GameTickReceiptValid.
import cheng/game/ecs
import cheng/game/runtime

const ReplayTicks = 8

# 当前契约: 托管结构体赋值是 move(消费源), 借用源的显式共享走 Fmt 拷贝。
# 篡改用例需要对同一已提交回执做三次独立副本, 故用借用版字段克隆。
@borrows
fn cloneReceipt(src: runtime.GameTickReceipt): runtime.GameTickReceipt =
    var out: runtime.GameTickReceipt
    out.schema = Fmt"{src.schema}"
    out.tick = src.tick
    out.fixedDtMs = src.fixedDtMs
    out.sourceWorldCid = Fmt"{src.sourceWorldCid}"
    out.resultWorldCid = Fmt"{src.resultWorldCid}"
    out.inputCount = src.inputCount
    out.physicsContactCount = src.physicsContactCount
    out.statusCode = src.statusCode
    out.physicsReceiptCid = Fmt"{src.physicsReceiptCid}"
    out.receiptCid = Fmt"{src.receiptCid}"
    out.trace = Fmt"{src.trace}"
    return out

fn populateWorld(world: var ecs.EcsWorld) =
    ecs.EcsWorldReset(world)
    let player = ecs.EcsWorldSpawn(world, 0, 0, 1, "cid:player")
    let wall = ecs.EcsWorldSpawn(world, 900, 0, 1, "cid:wall")
    assert(ecs.EcsWorldSetAabbCollider(world, player, 500, 500), "game tick replay: player collider")
    assert(ecs.EcsWorldSetAabbCollider(world, wall, 500, 500), "game tick replay: wall collider")

fn runReplay(rt: var runtime.GameRuntime, cids: var str[]): runtime.GameTickReceipt =
    var world: ecs.EcsWorld
    populateWorld(world)
    runtime.GameRuntimeReset(rt, world, 16)
    let input = runtime.GameMakeMoveInput(0, 1, 100, 0, "entity:1")
    assert(runtime.GameRuntimeEnqueue(rt, input), "game tick replay: enqueue")
    var first: runtime.GameTickReceipt
    var tick: int32
    while tick < ReplayTicks:
        let receipt = runtime.GameRuntimeTick(rt)
        assert(runtime.GameTickReceiptValid(receipt), "game tick replay: per-tick receipt valid")
        add(cids, Fmt"{receipt.receiptCid}")
        if tick == 0:
            first = receipt
        tick = tick + 1
    return first

fn main(): int32 =
    var rtA: runtime.GameRuntime
    var rtB: runtime.GameRuntime
    var cidsA: str[]
    var cidsB: str[]
    let first = runReplay(rtA, cidsA)
    let second = runReplay(rtB, cidsB)
    assert(cidsA.len == ReplayTicks, "game tick replay: cid sequence length")
    for i in 0..<cidsA.len:
        assert(cidsA[i].len == 64, "game tick replay: cid is sha256 hex")
        assert(cidsA[i] == cidsB[i], "game tick replay: cid sequence deterministic")
    assert(first.receiptCid == second.receiptCid, "game tick replay: first receipt cid deterministic")
    assert(first.resultWorldCid == second.resultWorldCid, "game tick replay: result world cid deterministic")
    assert(first.physicsReceiptCid.len == 64, "game tick replay: physics receipt cid chained")
    assert(first.inputCount == 1, "game tick replay: input count")
    assert(first.physicsContactCount == 1, "game tick replay: contact count")
    var tamperedContacts = cloneReceipt(first)
    tamperedContacts.physicsContactCount = tamperedContacts.physicsContactCount + 1
    assert(!runtime.GameTickReceiptValid(tamperedContacts), "game tick replay: tampered contact count rejected")
    var tamperedPhysics = cloneReceipt(first)
    tamperedPhysics.physicsReceiptCid = Fmt"{first.sourceWorldCid}"
    assert(!runtime.GameTickReceiptValid(tamperedPhysics), "game tick replay: tampered physics chain rejected")
    var tamperedCid = cloneReceipt(first)
    tamperedCid.receiptCid = Fmt"{first.sourceWorldCid}"
    assert(!runtime.GameTickReceiptValid(tamperedCid), "game tick replay: forged receipt cid rejected")
    return 0
