import std/strings

fn compareAndReuse(valueRaw: str): bool =
    let value = strings.CloneStr(valueRaw)
    if value == "":
        return false
    return value == "cheng"

fn main(): int32 =
    assert(compareAndReuse("cheng"), "owned str compare/reuse positive")
    assert(!compareAndReuse(""), "owned str compare/reuse empty")
    return 0
