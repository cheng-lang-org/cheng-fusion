# #139 regression (涓流无界 + pthread_join 无超时, S8 上界论证 区制 C): the two new
# drain-loop guards in WebSceneMediaOrchestrateFetchAll (host-teardown cancel flag +
# whole-fetch cumulative deadline, web_scene_media_orchestrator.cheng). No network, no
# publisher: the guards fire BEFORE any read is issued, so a reader whose conn is a
# zero value (never dereferenced on the guard paths) still exercises them.
#
#   step1: cancel preset -> an in-range fetch returns Err mentioning "cancelled"
#          (loud abort, not a hang, not silent Ok).
#   step2: after WebSceneMediaFetchCancelClear, an already-complete range
#          (expectedBytes <= bytesRead) still returns Ok immediately — the guards did
#          not change the trivial-completion contract.
#   step3: cancel set again + an already-CLOSED reader with a nonzero range -> the
#          drain loop never runs, fetch completes Ok — cancel aborts an in-flight
#          trickling drain only, never the normal completed path.
#   step4: the bridge delegate (what the cheng_scene_media_fetch_cancel_set scene
#          wrapper calls) drives the SAME flag: set via media_bridge, the fetch aborts
#          with the same Err — proves the host-facing wiring reaches the guard.
#
# The 60s cumulative deadline itself is the same check→free→Err shape at the same loop
# position (one source line away, review-verified); it cannot be exercised here without
# a real 60s wall-clock wait. Any failure prints a reason and exits nonzero; success
# prints "FETCH_CANCEL_GUARD_OK".

import std/os
import std/result
import std/strutils as strutil
import cheng/core/runtime/web_scene_media_orchestrator as orchestrator
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/libp2p/protocols/media/moq_segment_stream as moqstream

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

fn main(): int32 =
    # step1: cancel preset -> loud Err before any read.
    orchestrator.WebSceneMediaFetchCancelSet(1)
    var r1: moqstream.Libp2pMoqSegmentStreamReader
    r1.expectedBytes = 100
    r1.bytesRead = 0
    r1.closed = false
    let res1 = orchestrator.WebSceneMediaOrchestrateFetchAll(r1, 262144)
    if !IsErr(res1):
        return fail("step1: cancel preset fetch returned Ok, want Err(cancelled)")
    if !strutil.Contains(Error(res1), "cancelled"):
        return fail(strutil.Join(["step1: Err text lacks 'cancelled': ", Error(res1)], ""))
    os.WriteLine(os.Get_stdout(), "step1_cancel_aborts_fetch_ok")

    # step2: Clear re-arms; trivial-completion contract unchanged.
    orchestrator.WebSceneMediaFetchCancelClear()
    var r2: moqstream.Libp2pMoqSegmentStreamReader
    r2.expectedBytes = 0
    r2.bytesRead = 0
    r2.closed = false
    let res2 = orchestrator.WebSceneMediaOrchestrateFetchAll(r2, 262144)
    if IsErr(res2):
        return fail(strutil.Join(["step2: empty-range fetch Err after Clear: ", Error(res2)], ""))
    os.WriteLine(os.Get_stdout(), "step2_clear_rearms_ok")

    # step3: cancel set + already-closed reader -> normal completion, cancel must not
    # poison the completed path.
    orchestrator.WebSceneMediaFetchCancelSet(1)
    var r3: moqstream.Libp2pMoqSegmentStreamReader
    r3.expectedBytes = 100
    r3.bytesRead = 100
    r3.closed = true
    let res3 = orchestrator.WebSceneMediaOrchestrateFetchAll(r3, 262144)
    if IsErr(res3):
        return fail(strutil.Join(["step3: closed-reader fetch Err under cancel: ", Error(res3)], ""))
    orchestrator.WebSceneMediaFetchCancelClear()
    os.WriteLine(os.Get_stdout(), "step3_cancel_spares_completed_ok")

    # step4: bridge delegate (the scene wrapper's call target) drives the same flag.
    media_bridge.WebSceneMediaFetchCancelSet(1)
    var r4: moqstream.Libp2pMoqSegmentStreamReader
    r4.expectedBytes = 100
    r4.bytesRead = 0
    r4.closed = false
    let res4 = orchestrator.WebSceneMediaOrchestrateFetchAll(r4, 262144)
    if !IsErr(res4) || !strutil.Contains(Error(res4), "cancelled"):
        return fail("step4: bridge-delegate cancel did not abort the fetch")
    orchestrator.WebSceneMediaFetchCancelClear()
    os.WriteLine(os.Get_stdout(), "step4_bridge_delegate_ok")

    os.WriteLine(os.Get_stdout(), "FETCH_CANCEL_GUARD_OK")
    return 0
