module cold_linkerless_full_smoke

type Point =
    x: int32
    y: int32

fn makePoint(x: int32, y: int32): Point =
    var p: Point
    p.x = x
    p.y = y
    return p

fn addPoints(a: Point, b: Point): Point =
    var r: Point
    r.x = a.x + b.x
    r.y = a.y + b.y
    return r

fn test_object(): int32 =
    let p1 = makePoint(10, 20)
    let p2 = makePoint(5, 7)
    let p3 = addPoints(p1, p2)
    if p3.x != 15:
        return 1
    if p3.y != 27:
        return 2
    return 0

fn test_string(): int32 =
    let s = "hello"
    if strings.Len(s) != 5:
        return 3
    if s == "world":
        return 4
    return 0

fn test_while(): int32 =
    var i: int32
    var sum: int32
    while i < 10:
        sum = sum + i
        i = i + 1
    if sum != 45:
        return 5
    return 0

fn test_if_else(x: int32): int32 =
    if x > 0:
        return x
    else:
        return 0 - x

fn test_call_chain(x: int32): int32 =
    let a = test_if_else(x)
    let b = test_if_else(0 - x)
    return a + b

fn main(): int32 =
    let r1 = test_object()
    if r1 != 0:
        return r1
    let r2 = test_string()
    if r2 != 0:
        return r2
    let r3 = test_while()
    if r3 != 0:
        return r3
    if test_if_else(5) != 5:
        return 10
    if test_if_else(-3) != 3:
        return 11
    if test_call_chain(7) != 14:
        return 12
    return 0

main()
