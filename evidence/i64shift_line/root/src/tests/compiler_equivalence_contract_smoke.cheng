import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/tooling/compiler_publish_gate as cpub
import cheng/core/lang/parser
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

fn main(): int32 =
    let root = chengpath.PathCurrentDir()
    let packageId = "cheng"
    let canonicalSourcePath = chengpath.PathJoin(
        root,
        "src/tests/compiler_migration_fixture_canonical_plan.cheng")
    let legacySourcePath = chengpath.PathJoin(
        root,
        "src/tests/compiler_migration_fixture_legacy_input.txt")
    var noExternalPackageRoots: parser.ParserExternalPackageRoot[]
    var entryModulePath: str
    assert(parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
               root,
               root,
               packageId,
               noExternalPackageRoots,
               canonicalSourcePath,
               entryModulePath),
           " compiler equivalence: exact legacy entry identity")
    let req = creq.CompilerRequestNew(
        root,
        canonicalSourcePath,
        "/tmp/compiler_equivalence_contract.out",
        "arm64-apple-darwin",
        creq.EmitExe,
        "")
    var linkPlan: slplan.SystemLinkPlanStub
    var linkPlanErr: str
    assert(slplan.BuildSystemLinkPlanStub(root,
                                          req,
                                          linkPlan,
                                          linkPlanErr),
           " compiler equivalence: real legacy baseline plan")
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(linkPlan)
    assert(IsOk(sourceBundleRes),
           " compiler equivalence: baseline source bundle")
    let sourceBundleEntryIndex = linkPlan.sourceBundleEntrySourceIndex
    let sourceBundleEntryModulePath =
        linkPlan.ownerModulePaths[sourceBundleEntryIndex]
    var baselineSourceReceipt: ccsg.PortableSourceIdentityReceipt
    var baselineReceiptErr: str
    assert(ccsg.PortableSourceIdentityReceiptMakeInto(
               linkPlan.sourceClosurePaths.len,
               linkPlan.importEdges.len,
               linkPlan.unresolvedImportCount,
               linkPlan.packageId,
               sourceBundleEntryModulePath,
               linkPlan.sourceBundleCidValue,
               linkPlan.sourceBundleEntrySourceCid,
               linkPlan.sourceBundleImportGraphCid,
               baselineSourceReceipt,
               baselineReceiptErr),
           " compiler equivalence: baseline portable receipt")
    var consumedLinkPlan: slplan.SystemLinkPlanStub
    assert(slplan.BuildSystemLinkPlanStub(root,
                                          req,
                                          consumedLinkPlan,
                                          linkPlanErr),
           " compiler equivalence: independent consume plan")
    var baselineCsg: ccsg.CompilerCsg
    var baselineCsgErr: str
    assert(ccsg.BuildCompilerCsgConsumePortableReceiptInto(
               baselineCsg,
               baselineCsgErr,
               consumedLinkPlan,
               baselineSourceReceipt),
           " compiler equivalence: baseline csg")
    var migration: ccsg.CompilerLegacyMigration
    let migrationRes = ccsg.BuildCompilerLegacyMigrationInto(
        root,
        root,
        legacySourcePath,
        packageId,
        entryModulePath,
        migration)
    if IsErr(migrationRes):
        echo(Error(migrationRes))
    assert(IsOk(migrationRes),
           " compiler equivalence: real migration")
    assert(migration.unitCount == 1 && migration.appliedRuleCount > 0,
           " compiler equivalence: real byte-changing migration")
    assert(!layout.FixedBytes32Equal(
               baselineCsg.sourceIdentityReceipt.receiptCid,
               migration.migratedArtifact.sourceIdentityReceipt.receiptCid),
           " compiler equivalence: source receipts must differ")
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceMake(
        migration,
        evidence)
    if IsErr(evidenceRes):
        echo(Error(evidenceRes))
    assert(IsOk(evidenceRes) &&
           ceq.CompilerMigrationEvidenceVerify(evidence),
           " compiler equivalence: dual source evidence")
    var migratedSemantic: sexec.CompileSemanticReceipt
    var baselineSemantic: sexec.CompileSemanticReceipt
    var semanticErr: str
    let canonicalOutputDigest = ccsg.CompileOutputDigest(
        req.outputPath,
        req.targetTriple,
        linkPlan.providerModules,
        baselineCsg.canonicalGraphCid)
    assert(sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
               migration.baselineArtifact.sourceIdentityReceipt,
               migration.baselineArtifact.canonicalGraphCid,
               canonicalOutputDigest,
               req.targetTriple,
               "stage3_local",
               linkPlan.providerModules,
               baselineSemantic,
               semanticErr),
           " compiler equivalence: baseline semantic receipt")
    assert(sexec.SystemLinkExecCompileSemanticReceiptFromCanonicalCsgMakeInto(
               migration.migratedArtifact.sourceIdentityReceipt,
               migration.migratedArtifact.canonicalGraphCid,
               canonicalOutputDigest,
               req.targetTriple,
               "stage3_local",
               linkPlan.providerModules,
               migratedSemantic,
               semanticErr),
           " compiler equivalence: migrated semantic receipt")
    assert(!layout.FixedBytes32Equal(baselineSemantic.receiptCid,
                                     migratedSemantic.receiptCid) &&
           layout.FixedBytes32Equal(
               baselineSemantic.canonicalCompilerCsgCid,
               migratedSemantic.canonicalCompilerCsgCid),
           " compiler equivalence: dual receipts bind one semantic graph")
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofMake(
        packageId,
        "stable",
        evidence,
        migration.baselineArtifact.canonicalGraphCid,
        migration.migratedArtifact.canonicalGraphCid,
        migration.baselineArtifact.exportSurface,
        migration.migratedArtifact.exportSurface,
        baselineSemantic,
        migratedSemantic,
        req.targetTriple,
        proof)
    assert(IsOk(proofRes) && proof.graphEquivalent == 1 &&
           proof.exportSurfaceCompatible == 1 &&
           proof.semanticEquivalent == 1 &&
           ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence),
           " compiler equivalence: real byte change semantic fixed point")

    var baselineByteMutation =
        ccsg.CompilerLegacyMigrationDeepCloneDiagnostic(migration)
    baselineByteMutation.units[0].legacyText = strutil.Join([
        baselineByteMutation.units[0].legacyText,
        "\n"
    ], "")
    var mutatedLegacyReceipt: ccsg.PortableSourceIdentityReceipt
    var unchangedMigratedReceipt: ccsg.PortableSourceIdentityReceipt
    assert(IsOk(ceq.CompilerMigrationSourceReceiptsFromMigrationInto(
                    baselineByteMutation,
                    mutatedLegacyReceipt,
                    unchangedMigratedReceipt)),
           " compiler equivalence: recompute mutated baseline receipt")
    baselineByteMutation.baselineArtifact.sourceIdentityReceipt =
        mutatedLegacyReceipt
    assert(ceq.CompilerMigrationSourceReceiptEqual(
               unchangedMigratedReceipt,
               migration.migratedArtifact.sourceIdentityReceipt),
           " compiler equivalence: baseline mutation changed migrated side")
    var mutatedEvidence: ceq.CompilerMigrationEvidence
    assert(IsOk(ceq.CompilerMigrationEvidenceMake(
                    baselineByteMutation,
                    mutatedEvidence)) &&
           ceq.CompilerMigrationEvidenceVerify(mutatedEvidence) &&
           !ceq.CompilerMigrationSemanticProofPassedStable(
                proof,
                mutatedEvidence),
           " compiler equivalence: recomputed baseline mutation reused old proof")

    let evidenceText = ceq.CompilerMigrationEvidenceReport(evidence)
    var parsedEvidence: ceq.CompilerMigrationEvidence
    assert(IsOk(ceq.CompilerMigrationEvidenceFromReportText(
                    evidenceText,
                    parsedEvidence)),
           " compiler equivalence: evidence exact parse")
    assert(IsErr(ceq.CompilerMigrationEvidenceFromReportText(
                    strutil.Join([evidenceText, "\n"], ""),
                    parsedEvidence)),
           " compiler equivalence: evidence trailing byte rejected")
    assert(IsErr(ceq.CompilerMigrationEvidenceFromReportText(
                    strutil.Join([evidenceText, "\nversion=3"], ""),
                    parsedEvidence)),
           " compiler equivalence: evidence duplicate rejected")
    let originalLegacyLength = evidence.legacyRawByteLengths[0]
    evidence.legacyRawByteLengths[0] = originalLegacyLength + 1
    assert(!ceq.CompilerMigrationEvidenceVerify(evidence),
           " compiler equivalence: raw length mutation")
    evidence.legacyRawByteLengths[0] = originalLegacyLength
    let originalModulePath = evidence.orderedModulePaths[0]
    evidence.orderedModulePaths[0] = "../escape"
    assert(!ceq.CompilerMigrationEvidenceVerify(evidence),
           " compiler equivalence: path mutation")
    evidence.orderedModulePaths[0] = originalModulePath
    let legacyReceipt = evidence.legacySourceIdentityReceipt
    evidence.legacySourceIdentityReceipt =
        evidence.migratedSourceIdentityReceipt
    evidence.evidenceCid = ceq.CompilerMigrationEvidenceCid(evidence)
    assert(!ceq.CompilerMigrationEvidenceVerify(evidence),
           " compiler equivalence: cross-side source receipt exchange")
    evidence.legacySourceIdentityReceipt = legacyReceipt
    evidence.evidenceCid = ceq.CompilerMigrationEvidenceCid(evidence)
    assert(ceq.CompilerMigrationEvidenceVerify(evidence),
           " compiler equivalence: evidence restored")

    let proofText = ceq.CompilerMigrationSemanticProofReport(proof)
    var parsedProof: ceq.CompilerMigrationSemanticProof
    assert(IsOk(ceq.CompilerMigrationSemanticProofFromReportText(
                    proofText,
                    parsedProof)) &&
           ceq.CompilerMigrationSemanticProofPassedStable(parsedProof,
                                                          parsedEvidence),
           " compiler equivalence: proof exact parse and pair")
    assert(IsErr(ceq.CompilerMigrationSemanticProofFromReportText(
                    strutil.Join([proofText, "\nunknown=1"], ""),
                    parsedProof)),
           " compiler equivalence: proof unknown field rejected")

    var semanticSwap = proof
    semanticSwap.baselineSemanticSourceIdentityReceiptCid =
        evidence.legacySourceIdentityReceipt.receiptCid
    semanticSwap.baselineSemanticReceiptCid =
        sexec.SystemLinkExecCompileSemanticReceiptCid(
            ceq.CompilerMigrationSemanticProofSemanticReceipt(
                semanticSwap.baselineSemanticSourceIdentityReceiptCid,
                semanticSwap.baselineSemanticCompilerCsgCid,
                semanticSwap.baselineSemanticOutputDigest,
                semanticSwap.baselineSemanticTargetTripleCid,
                semanticSwap.baselineSemanticBootstrapStageCid,
                semanticSwap.baselineSemanticProviderSetCid,
                layout.FixedBytes32()))
    semanticSwap.proofCid = ceq.CompilerMigrationSemanticProofCid(semanticSwap)
    assert(!ceq.CompilerMigrationSemanticProofVerify(semanticSwap),
           " compiler equivalence: legacy source cannot masquerade as published fixed point")

    var semanticMismatch = proof
    semanticMismatch.migratedSemanticOutputDigest =
        proof.migratedSemanticProviderSetCid
    semanticMismatch.migratedSemanticReceiptCid =
        sexec.SystemLinkExecCompileSemanticReceiptCid(
            ceq.CompilerMigrationSemanticProofSemanticReceipt(
                semanticMismatch.migratedSemanticSourceIdentityReceiptCid,
                semanticMismatch.migratedSemanticCompilerCsgCid,
                semanticMismatch.migratedSemanticOutputDigest,
                semanticMismatch.migratedSemanticTargetTripleCid,
                semanticMismatch.migratedSemanticBootstrapStageCid,
                semanticMismatch.migratedSemanticProviderSetCid,
                layout.FixedBytes32()))
    semanticMismatch.semanticEquivalent = 0
    semanticMismatch.equivalenceLabel = "incompatible"
    semanticMismatch.proofCid = ceq.CompilerMigrationSemanticProofCid(
        semanticMismatch)
    assert(ceq.CompilerMigrationSemanticProofVerify(semanticMismatch) &&
           !ceq.CompilerMigrationSemanticProofPassedStable(
                semanticMismatch,
                evidence),
           " compiler equivalence: semantic component mismatch blocks stable")

    var channel = ""
    var stableRequired: int32
    var checked: int32
    var passed: int32
    var allowed: int32
    var proofCid: layout.FixedBytes32
    assert(IsOk(cpub.CompilerPublishDecisionEvaluate(
                    "stable",
                    proof.migratedGraphCid,
                    true,
                    proof,
                    evidence,
                    channel,
                    stableRequired,
                    checked,
                    passed,
                    allowed,
                    proofCid)) && allowed == 1,
           " compiler equivalence: stable publish allows exact pair")
    echo(" compiler_equivalence_contract_smoke ok")
    return 0
