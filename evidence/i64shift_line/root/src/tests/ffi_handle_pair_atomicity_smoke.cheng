import std/system as system

@importc("cheng_ffi_raw_new_i32")
fn cheng_ffi_raw_new_i32(value: int32): ptr

@importc("cheng_ffi_raw_release_i32")
fn cheng_ffi_raw_release_i32(p: ptr): int32

@importc("cheng_tcp_buffer_handle_register_bridge")
fn cheng_tcp_buffer_handle_register_bridge(raw: ptr): uint64

@importc("cheng_tcp_buffer_handle_lease_acquire_bridge")
fn cheng_tcp_buffer_handle_lease_acquire_bridge(
    handle: uint64,
    outPayload: ptr,
    outBorrowGeneration: ptr): int32

@importc("cheng_tcp_buffer_handle_lease_release_bridge")
fn cheng_tcp_buffer_handle_lease_release_bridge(
    handle: uint64,
    borrowGeneration: uint64): int32

@importc("cheng_tcp_buffer_handle_retire_take_bridge")
fn cheng_tcp_buffer_handle_retire_take_bridge(
    handle: uint64,
    outPayload: ptr): int32

@importc("cheng_buffer_handle_from_raw_bridge")
fn cheng_buffer_handle_from_raw_bridge(data: ptr, n: int32): uint64

@importc("cheng_buffer_handle_release_bridge")
fn cheng_buffer_handle_release_bridge(handle: uint64): int32

@importc("cheng_tcp_loopback_request_response_handle_bridge")
fn cheng_tcp_loopback_request_response_handle_bridge(
    protocolText: cstring,
    requestHandle: uint64,
    responseHandle: uint64): uint64

fn retireRaw(handle: uint64, expected: ptr) =
    var retired: ptr
    assert(cheng_tcp_buffer_handle_retire_take_bridge(handle, &retired) == 0,
           " ffi handle pair atomicity: retire raw handle")
    assert(retired == expected,
           " ffi handle pair atomicity: exact retired payload")
    assert(cheng_ffi_raw_release_i32(retired) == 0,
           " ffi handle pair atomicity: release retired payload")

fn main(): int32 =
    let firstRaw = cheng_ffi_raw_new_i32(11)
    let secondRaw = cheng_ffi_raw_new_i32(22)
    assert(firstRaw != nil && secondRaw != nil,
           " ffi handle pair atomicity: raw allocations")
    let firstHandle = cheng_tcp_buffer_handle_register_bridge(firstRaw)
    let secondHandle = cheng_tcp_buffer_handle_register_bridge(secondRaw)
    assert(firstHandle != uint64(0) && secondHandle != uint64(0),
           " ffi handle pair atomicity: raw registrations")

    var firstBaselinePayload: ptr
    var firstBaselineToken: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               firstHandle, &firstBaselinePayload, &firstBaselineToken) == 0,
           " ffi handle pair atomicity: first baseline acquire")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               firstHandle, firstBaselineToken) == 0,
           " ffi handle pair atomicity: first baseline release")

    var secondBusyPayload: ptr
    var secondBusyToken: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               secondHandle, &secondBusyPayload, &secondBusyToken) == 0,
           " ffi handle pair atomicity: hold second lease")
    let busyPairResult = cheng_tcp_loopback_request_response_handle_bridge(
        system.strToCStringTemp(""), firstHandle, secondHandle)
    assert(busyPairResult == uint64(0),
           " ffi handle pair atomicity: second busy rejects pair")

    var firstAfterBusyPayload: ptr
    var firstAfterBusyToken: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               firstHandle, &firstAfterBusyPayload, &firstAfterBusyToken) == 0,
           " ffi handle pair atomicity: first remains available")
    assert(firstAfterBusyPayload == firstRaw,
           " ffi handle pair atomicity: first payload unchanged")
    assert(firstAfterBusyToken == firstBaselineToken + uint64(1),
           " ffi handle pair atomicity: failed pair does not advance first token")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               firstHandle, firstAfterBusyToken) == 0,
           " ffi handle pair atomicity: first release after failed pair")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               secondHandle, secondBusyToken) == 0,
           " ffi handle pair atomicity: second original token remains valid")
    retireRaw(firstHandle, firstRaw)
    retireRaw(secondHandle, secondRaw)

    let sameHandle = cheng_buffer_handle_from_raw_bridge(
        ptr(system.strToCStringTemp("x")), 1)
    assert(sameHandle != uint64(0),
           " ffi handle pair atomicity: same-handle buffer registration")
    var sameBaselinePayload: ptr
    var sameBaselineToken: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               sameHandle, &sameBaselinePayload, &sameBaselineToken) == 0,
           " ffi handle pair atomicity: same-handle baseline acquire")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               sameHandle, sameBaselineToken) == 0,
           " ffi handle pair atomicity: same-handle baseline release")

    let samePairResult = cheng_tcp_loopback_request_response_handle_bridge(
        system.strToCStringTemp(""), sameHandle, sameHandle)
    assert(samePairResult != uint64(0),
           " ffi handle pair atomicity: same handle pair succeeds")
    assert(cheng_buffer_handle_release_bridge(samePairResult) == 0,
           " ffi handle pair atomicity: release pair result")

    var sameAfterPayload: ptr
    var sameAfterToken: uint64
    assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
               sameHandle, &sameAfterPayload, &sameAfterToken) == 0,
           " ffi handle pair atomicity: same handle available after pair")
    assert(sameAfterPayload == sameBaselinePayload,
           " ffi handle pair atomicity: same handle payload stable")
    assert(sameAfterToken == sameBaselineToken + uint64(2),
           " ffi handle pair atomicity: pair consumes exactly one lease")
    assert(cheng_tcp_buffer_handle_lease_release_bridge(
               sameHandle, sameAfterToken) == 0,
           " ffi handle pair atomicity: same handle final lease release")
    assert(cheng_buffer_handle_release_bridge(sameHandle) == 0,
           " ffi handle pair atomicity: same handle release")

    echo(" ffi_handle_pair_atomicity_smoke ok")
    return 0
