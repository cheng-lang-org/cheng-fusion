type
    ColdAggregateGenericNegativeBox[T] =
        value: T

    ColdAggregateGenericNegativeHolder =
        boxed: ColdAggregateGenericNegativeBox[int32]

fn main(): int32 =
    var wrong: ColdAggregateGenericNegativeBox[int64]
    wrong.value = 233
    var holder: ColdAggregateGenericNegativeHolder
    holder.boxed = wrong
    return 0
