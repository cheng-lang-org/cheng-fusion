import std/os
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_cargo as cargo
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/tooling/compiler_execution_stage_receipt as execution
import cheng/core/tooling/semantic_snapshot as snapshot
import cheng/core/tooling/semantic_snapshot_production as production

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn MakeFailureFacts(
        sourceVersion: int64,
        worldHeadCid: layout.FixedBytes32,
        compilerExecutionCid: layout.FixedBytes32,
        documentCid: layout.FixedBytes32,
        contentCid: layout.FixedBytes32):
        cargo.CsgCompilerSnapshotFailureFacts =
    var facts: cargo.CsgCompilerSnapshotFailureFacts
    facts.schemaVersion = schema.CsgCompilerSnapshotSchemaVersionLatest
    facts.semanticEpoch = sourceVersion
    facts.sourceVersion = sourceVersion
    facts.worldHeadCid = worldHeadCid
    facts.compilerExecutionCid = compilerExecutionCid
    facts.sourceIdentityKind =
        cargo.CsgCompilerSnapshotFailureSourceIdentityCanonicalFacts
    facts.completedStageBitmap =
        cargo.CsgCompilerSnapshotFailureStageSourceEvent
    facts.missingFactBitmap = 1
    add(facts.sourceDocumentCids, documentCid)
    add(facts.sourceContentPresent, true)
    add(facts.sourceContentCids, contentCid)
    add(facts.sourceModulePaths, "pkg/main")
    add(facts.sourceProducerIndexes, 0)
    add(facts.diagnosticSourceIds, 0)
    add(facts.diagnosticStartBytes, 0)
    add(facts.diagnosticEndBytes, 1)
    add(facts.diagnosticStartLines, 0)
    add(facts.diagnosticStartColumns, 0)
    add(facts.diagnosticEndLines, 0)
    add(facts.diagnosticEndColumns, 1)
    add(facts.diagnosticProducerKinds,
        cargo.CsgCompilerSnapshotFailureDiagnosticSourceAdmission)
    add(facts.diagnosticSeverities,
        schema.CsgCompilerDiagnosticSeverityError)
    add(facts.diagnosticCodes, "CHENG-SNAPSHOT-SOURCE-ADMISSION")
    add(facts.diagnosticMessages, "missing exact semantic snapshot facts")
    facts.sourceBundleCid =
        cargo.CsgCompilerSnapshotFailureCanonicalSourceBundleCid(facts)
    facts.sourceIdentityReceiptCid =
        cargo.CsgCompilerSnapshotFailureCanonicalSourceIdentityReceiptCid(
            facts)
    return facts

fn main() =
    var err: str
    let workspaceSessionCid =
        TestCid("semantic-snapshot-rejection/workspace")
    let worldHeadCid = TestCid("semantic-snapshot-rejection/world")
    let documentCid = TestCid("semantic-snapshot-rejection/document")
    let executionResult = execution.CompilerExecutionIdentityMake(
        "semantic-snapshot-rejection",
        TestCid("semantic-snapshot-rejection/execution-source-bundle"),
        TestCid("semantic-snapshot-rejection/materializer"),
        TestCid("semantic-snapshot-rejection/grammar"),
        TestCid("semantic-snapshot-rejection/compiler-source-closure"),
        TestCid("semantic-snapshot-rejection/driver"),
        TestCid("semantic-snapshot-rejection/toolchain"),
        TestCid("semantic-snapshot-rejection/command"),
        "arm64-apple-darwin")
    assert(IsOk(executionResult), "rejection smoke: execution identity")
    let compilerExecution = Value(executionResult)
    var eventState: snapshot.WorkspaceSourceEventState
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               workspaceSessionCid, eventState, err), err)
    var store: production.SemanticSnapshotProductionStore
    assert(production.SemanticSnapshotProductionStoreInitInto(
               workspaceSessionCid, store, err), err)

    var sourceVersion: int64
    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               eventState, store, snapshot.SemanticSourceEventOpen,
               documentCid, int64(1), sourceVersion, err), err)
    var firstFacts = MakeFailureFacts(
        sourceVersion, worldHeadCid, compilerExecution.executionRaw32,
        documentCid, TestCid("semantic-snapshot-rejection/content/1"))
    var rejectedIndex: int32
    var unprovedPortableFacts =
        cargo.CsgCompilerSnapshotFailureFactsClone(firstFacts)
    unprovedPortableFacts.sourceIdentityKind =
        cargo.CsgCompilerSnapshotFailureSourceIdentityPortableReceipt
    assert(!production.SemanticSnapshotProductionRejectCanonicalFailureInto(
                eventState, store, worldHeadCid, compilerExecution,
                unprovedPortableFacts, rejectedIndex, err) &&
           store.core.states.len == 0,
           "rejection smoke: unproved portable source receipt accepted")
    assert(production.SemanticSnapshotProductionRejectCanonicalFailureInto(
               eventState, store, worldHeadCid, compilerExecution,
               firstFacts, rejectedIndex, err), err)
    assert(rejectedIndex == 0 && store.core.candidateIndex == -1 &&
           store.core.states.len == 1 &&
           store.core.states[0] == snapshot.SemanticSnapshotStateRejected &&
           store.payloadIndexesBySnapshot[0] == -1 &&
           store.rejectionSnapshotIndexes.len == 1 &&
           store.rejectionStates[0] ==
               production.SemanticSnapshotProductionRejectionCommitted,
           "rejection smoke: accepted version did not terminate rejected")
    assert(production.SemanticSnapshotProductionStoreStrictValidateInto(
               store, err), err)
    var diagnostics: production.SemanticSnapshotProductionRejectedDiagnostics
    assert(production.SemanticSnapshotProductionCurrentRejectedDiagnosticsInto(
               store, diagnostics, err), err)
    assert(diagnostics.sourceVersion == sourceVersion &&
           diagnostics.facts.diagnosticMessages.len == 1 &&
           diagnostics.facts.diagnosticMessages[0] ==
               "missing exact semantic snapshot facts" &&
           layout.FixedBytes32Equal(
               diagnostics.factsRootCid,
               store.rejectionFactsRootCids[0]),
           "rejection smoke: diagnostic projection lost exact cargo facts")

    let originalByte = rawbytes.BytesGet(store.rejectionCsgcBytes[0], 0)
    rawbytes.BytesSet(store.rejectionCsgcBytes[0], 0, originalByte ^ 1)
    assert(!production.SemanticSnapshotProductionStoreStrictValidateInto(
                store, err),
           "rejection smoke: mutated CSGC bytes accepted")
    assert(!production.SemanticSnapshotProductionCurrentRejectedDiagnosticsInto(
                store, diagnostics, err),
           "rejection smoke: diagnostics read mutated CSGC bytes")
    rawbytes.BytesSet(store.rejectionCsgcBytes[0], 0, originalByte)
    assert(production.SemanticSnapshotProductionStoreStrictValidateInto(
               store, err), err)

    let originalMissingFactBitmap =
        store.rejectionFacts[0].missingFactBitmap
    store.rejectionFacts[0].missingFactBitmap = 0
    assert(!production.SemanticSnapshotProductionStoreStrictValidateInto(
                store, err),
           "rejection smoke: invalid missing-fact bitmap accepted")
    assert(!production.SemanticSnapshotProductionCurrentRejectedDiagnosticsInto(
                store, diagnostics, err),
           "rejection smoke: diagnostics read facts detached from CSGC")
    store.rejectionFacts[0].missingFactBitmap = originalMissingFactBitmap
    let originalDiagnosticMessage =
        store.rejectionFacts[0].diagnosticMessages[0]
    store.rejectionFacts[0].diagnosticMessages[0] =
        "different valid diagnostic"
    assert(!production.SemanticSnapshotProductionCurrentRejectedDiagnosticsInto(
                store, diagnostics, err),
           "rejection smoke: diagnostics read valid facts detached from CSGC")
    store.rejectionFacts[0].diagnosticMessages[0] =
        originalDiagnosticMessage
    let originalCompletedStageBitmap =
        store.rejectionFacts[0].completedStageBitmap
    store.rejectionFacts[0].completedStageBitmap = 1 | 4
    assert(!production.SemanticSnapshotProductionStoreStrictValidateInto(
                store, err),
           "rejection smoke: completed parser stage without receipt accepted")
    store.rejectionFacts[0].completedStageBitmap =
        originalCompletedStageBitmap
    let originalDiagnosticRoot = store.rejectionDiagnosticRootCids[0]
    store.rejectionDiagnosticRootCids[0] =
        TestCid("semantic-snapshot-rejection/forged-diagnostic-root")
    assert(!production.SemanticSnapshotProductionStoreStrictValidateInto(
                store, err),
           "rejection smoke: forged diagnostic root accepted")
    store.rejectionDiagnosticRootCids[0] = originalDiagnosticRoot
    let originalBindingReceiptCid =
        store.rejectionBindings[0].bindingReceiptCid
    store.rejectionBindings[0].bindingReceiptCid =
        TestCid("semantic-snapshot-rejection/forged-binding-receipt")
    assert(!production.SemanticSnapshotProductionCurrentRejectedDiagnosticsInto(
                store, diagnostics, err),
           "rejection smoke: diagnostics read forged binding receipt")
    store.rejectionBindings[0].bindingReceiptCid =
        originalBindingReceiptCid
    assert(production.SemanticSnapshotProductionStoreStrictValidateInto(
               store, err), err)

    store.rejectionSnapshotIndexes[0] = 1
    var tamperedSourceVersion: int64
    assert(!production.SemanticSnapshotProductionAcceptSourceEventInto(
                eventState, store, snapshot.SemanticSourceEventChange,
                documentCid, int64(2), tamperedSourceVersion, err) &&
           eventState.lastAcceptedSourceVersion == int64(1) &&
           store.core.currentSourceVersion == int64(1) &&
           store.core.states.len == 1,
           "rejection smoke: source event accepted a forged rejection map")
    store.rejectionSnapshotIndexes[0] = 0

    assert(production.SemanticSnapshotProductionAcceptSourceEventInto(
               eventState, store, snapshot.SemanticSourceEventChange,
               documentCid, int64(2), sourceVersion, err), err)
    var secondFacts = MakeFailureFacts(
        sourceVersion, worldHeadCid, compilerExecution.executionRaw32,
        documentCid, TestCid("semantic-snapshot-rejection/content/2"))
    secondFacts.sourceIdentityKind =
        cargo.CsgCompilerSnapshotFailureSourceIdentityPortableReceipt
    assert(production.SemanticSnapshotProductionRejectPortableFailureInto(
               eventState, store, worldHeadCid, compilerExecution,
               secondFacts, rejectedIndex, err), err)
    assert(sourceVersion == int64(2) && rejectedIndex == 1 &&
           store.core.candidateIndex == -1 &&
           store.core.states.len == 2 &&
           store.core.states[0] == snapshot.SemanticSnapshotStateRejected &&
           store.core.states[1] == snapshot.SemanticSnapshotStateRejected &&
           store.rejectionSnapshotIndexes.len == 2 &&
           store.rejectionStates[0] ==
               production.SemanticSnapshotProductionRejectionCommitted &&
           store.rejectionStates[1] ==
               production.SemanticSnapshotProductionRejectionCommitted,
           "rejection smoke: accepted versions are not synchronously terminal")
    assert(production.SemanticSnapshotProductionStoreStrictValidateInto(
               store, err), err)
    assert(production.SemanticSnapshotProductionCurrentRejectedDiagnosticsInto(
               store, diagnostics, err) &&
           diagnostics.sourceVersion == int64(2), err)
    let staleFactsRootValidation =
        cargo.CsgCompilerSnapshotFailureCargoVerify(
            store.rejectionCsgcBytes[1],
            store.rejectionFactsRootCids[0])
    assert(!layout.FixedBytes32Equal(
               store.rejectionFactsRootCids[0],
               store.rejectionFactsRootCids[1]) &&
           !staleFactsRootValidation.ok,
           "rejection smoke: current cargo accepted stale facts root")
    assert(production.SemanticSnapshotProductionStoreReleaseInto(store, err),
           err)
    os.WriteLine(os.Get_stdout(), "semantic_snapshot_rejection_smoke: ok")
