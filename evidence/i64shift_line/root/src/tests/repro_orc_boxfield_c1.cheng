import std/system
import std/hashmaps as hashmaps

type
    ReproBox = ref object
        m: hashmaps.HashMapStrInt

fn main() =
    var b: ReproBox = new(ReproBox)
    hashmaps.HashMapStrIntInitInPlace(b.m, 64)
    hashmaps.HashMapStrIntPut(b.m, "alpha", 0)
    # take aggregate (struct with managed seq members) out of ref field,
    # store fresh empty struct, then write back — mirrors internPoolDetachIndex
    var w = b.m
    b.m = hashmaps.HashMapStrInt()
    b.m = w
    var found: bool
    let got = hashmaps.HashMapStrIntGetMutEx(b.m, "alpha", found)
    assert(found && got == 0, "repro C1: field take/writeback roundtrip")
    echo("repro_orc_boxfield_c1 ok")
