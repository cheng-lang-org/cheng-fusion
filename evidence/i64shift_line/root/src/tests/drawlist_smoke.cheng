# drawlist smoke test — direct @importc, no module import

@importc("cheng_drawlist_new")
fn dlNew(capacity: int32): ptr

@importc("cheng_drawlist_free")
fn dlFree(list: ptr)

@importc("cheng_drawlist_count")
fn dlCount(list: ptr): int32

@importc("cheng_drawlist_push_rect")
fn dlPushRect(list: ptr, x: int32, y: int32, w: int32, h: int32, r: int32, g: int32, b: int32, a: int32)

@importc("cheng_drawlist_push_border")
fn dlPushBorder(list: ptr, x: int32, y: int32, w: int32, h: int32, r: int32, g: int32, b: int32, a: int32, borderWidth: int32, radius: int32)

@importc("cheng_drawlist_clear")
fn dlClear(list: ptr)

fn main(): int32 =
    var list = dlNew(256)
    var cnt = dlCount(list)
    if cnt != 0:
        dlFree(list)
        return 1

    dlPushRect(list, 10, 10, 100, 80, 255, 0, 0, 255)
    dlPushRect(list, 120, 10, 100, 80, 0, 255, 0, 255)
    dlPushRect(list, 230, 10, 100, 80, 0, 0, 255, 255)

    cnt = dlCount(list)
    if cnt != 3:
        dlFree(list)
        return 2

    dlPushBorder(list, 10, 100, 330, 60, 0, 0, 0, 255, 2, 4)
    cnt = dlCount(list)
    if cnt != 4:
        dlFree(list)
        return 3

    dlClear(list)
    cnt = dlCount(list)
    if cnt != 0:
        dlFree(list)
        return 4

    dlFree(list)
    return 0
