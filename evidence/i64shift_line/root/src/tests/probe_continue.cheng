# PHASEB-RECENSUS probe_continue: continue skips to next loop iteration
fn main(): int32 =
  var i: int32
  var kept: int32
  while i < 6:
    i = i + 1
    if i == 2:
      continue
    if i == 4:
      continue
    kept = kept + 1
  if kept == 4:
    echo("probe_continue=pass")
    return 0
  echo("probe_continue=fail")
  return 101
