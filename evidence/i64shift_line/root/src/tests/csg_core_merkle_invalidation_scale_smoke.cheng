import std/monotimes as monotimes
import std/os as os
import std/strings
import cheng/core/csg_core/merkle_invalidation

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn sourceId(index: int32): str =
    return strings.ConcatStr(
        "scale-source-",
        strings.IntToStr(index))

@borrows
fn edge(
        consumer: str,
        provider: str,
        cid: str):
        merkle_invalidation.CsgCoreMerkleDependencyEdge =
    var out: merkle_invalidation.CsgCoreMerkleDependencyEdge
    out.consumerSource = strings.CloneStr(consumer)
    out.providerSource = strings.CloneStr(provider)
    out.selector = "symbol:scale-chain"
    out.providerSubgraphCid =
        strings.CloneStr(cid)
    return out

fn main(): int32 =
    let sourceCount: int32 = 8192
    let cid = "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    var forwardSources: str[]
    var reverseSources: str[]
    for i in 0..<sourceCount:
        add(forwardSources, sourceId(i))
        add(
            reverseSources,
            sourceId(sourceCount - i - 1))

    var forwardEdges: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    var reverseEdges: merkle_invalidation.CsgCoreMerkleDependencyEdge[]
    for offset in 1..<sourceCount:
        let forwardConsumer = sourceId(offset)
        let forwardProvider = sourceId(offset - 1)
        add(
            forwardEdges,
            edge(
                forwardConsumer,
                forwardProvider,
                cid))

        let reverseIndex = sourceCount - offset
        let reverseConsumer = sourceId(reverseIndex)
        let reverseProvider =
            sourceId(reverseIndex - 1)
        add(
            reverseEdges,
            edge(
                reverseConsumer,
                reverseProvider,
                cid))

    let forwardStartedNs =
        monotimes.MonoTimeNs(
            monotimes.GetMonoTime())
    let forward =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            forwardSources,
            forwardEdges,
            ["scale-source-0"])
    let forwardElapsedMs =
        (monotimes.MonoTimeNs(
             monotimes.GetMonoTime()) -
         forwardStartedNs) / 1000000
    if !forward.ok:
        return fail(
            strings.ConcatStr(
                "forward scale invalidation failed: ",
                forward.error))

    let reverseStartedNs =
        monotimes.MonoTimeNs(
            monotimes.GetMonoTime())
    let reverse =
        merkle_invalidation.CsgCoreMerkleInvalidationBuild(
            reverseSources,
            reverseEdges,
            ["scale-source-0"])
    let reverseElapsedMs =
        (monotimes.MonoTimeNs(
             monotimes.GetMonoTime()) -
         reverseStartedNs) / 1000000
    if !reverse.ok:
        return fail(
            strings.ConcatStr(
                "reverse scale invalidation failed: ",
                reverse.error))

    if forward.dependencyCount != sourceCount - 1 ||
       reverse.dependencyCount != sourceCount - 1 ||
       forward.changedSources.len != 1 ||
       reverse.changedSources.len != 1 ||
       forward.invalidatedSources.len != sourceCount ||
       reverse.invalidatedSources.len != sourceCount ||
       forward.untouchedSources.len != 0 ||
       reverse.untouchedSources.len != 0:
        return fail("scale invalidation cardinality mismatch")
    if forward.dependencyRoot != reverse.dependencyRoot ||
       forward.invalidationRoot != reverse.invalidationRoot:
        return fail("reverse input changed scale roots")
    if forward.dependencyRoot !=
           "sha256:f55ed6532c6fa24ada77dbcee78ef4acd298dd2612a2758f48e8247d97883455" ||
       forward.invalidationRoot !=
           "sha256:3761497e548de782894db38f42cb17c9a11ea77b8d635bacb62a9734a0b3f80c":
        return fail("scale root fixed point mismatch")
    for i in 0..<sourceCount:
        if forward.invalidatedSources[i] !=
           reverse.invalidatedSources[i]:
            return fail(
                "reverse input changed sorted invalidation output")

    os.WriteLine(
        os.Get_stdout(),
        forward.dependencyRoot)
    os.WriteLine(
        os.Get_stdout(),
        forward.invalidationRoot)
    os.WriteLine(
        os.Get_stdout(),
        Fmt"csg_core_merkle_invalidation_scale_smoke ok sources={sourceCount} edges={sourceCount - 1} forward_ms={forwardElapsedMs} reverse_ms={reverseElapsedMs}")
    return 0
