import std/os

importc fn cheng_udp_ipv4_sockaddr_byte_bridge(index: int32): int32

fn main(): int32 =
    let value: int32 = cheng_udp_ipv4_sockaddr_byte_bridge(1)
    if os.UdpPlatformUseLenFieldBridge() == 0:
        assert(value == 0, " udp sockaddr b1: linux family")
    else:
        assert(value == 2, " udp sockaddr b1: bsd family")
    echo(" udp_sockaddr_b1_smoke ok")
    return 0
