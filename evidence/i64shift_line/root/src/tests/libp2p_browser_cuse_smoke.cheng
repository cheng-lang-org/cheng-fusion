import std/system
import std/strings
import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/csg_action_authority as auth
import cheng/apps/libp2p_browser/compile_render as compile
import cheng/apps/libp2p_browser/session as sess
import cheng/apps/libp2p_browser/computer_use_session as cuse

fn fail(code: int32, msg: str): int32 =
    echo(msg)
    return code

# CLB4 夹具: box0 button(btnOk) box1 input(text, q) box2 select(s, 三选项)
# box3 input(text, disabled) box4 input(number, n)。CTL 行给出 captureId 3..7。
fn fixtureWithFlags(): str =
    # CTL 行统一附在盒区之后(盒区=连续 10 行×count, 与真实捕获一致);
    # 逐盒内插会错位解析——JS 侧已修, 夹具必须同构。
    var s: str = "CLB4\n400 600 5 1\n"
    s = strings.ConcatStr(s, "4 10 20 120 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nbutton\n\nbutton\nbtnOk\nGo\nGo\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 70 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ntext\n\ntext\nq\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "6 10 120 180 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nselect\n\nselect-one\ns\n\n\nsans-serif\n\n0\ta\tAlpha%0A0\tb\tBeta%0A1\tc\tGamma\n")
    s = strings.ConcatStr(s, "1 10 170 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\ntext\n\ntext\nfrozen\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "1 10 220 200 32 -1 -16777216 14 1 -16777216 2 400 0 0 0 0 0 0 0 400 600\nnumber\n\nnumber\nn\n\n\nsans-serif\n\n\n")
    s = strings.ConcatStr(s, "CTL|0|3|0|button|Go\n")
    s = strings.ConcatStr(s, "CTL|1|4|0||Quantity\n")
    s = strings.ConcatStr(s, "CTL|2|5|0||Choose\n")
    s = strings.ConcatStr(s, "CTL|3|6|1||Frozen\n")
    s = strings.ConcatStr(s, "CTL|4|7|0||Count\n")
    return s

fn main(): int32 =
    let src = fixtureWithFlags()
    var session = sess.BrowserSessionInit("cuse-peer", 400, 600)
    if !sess.BrowserSessionOnPageSnapshot(session, "https://ex.test/cuse", src):
        echo(session.lastError)
        return fail(1, "cuse session snapshot")
    var err: str = ""
    # 未知 captureId hard-fail
    if cuse.BrowserCuseAction(session, 99, "Click", "", "", false, err) != -1:
        return fail(2, "no control must fail")
    if err != "cuse_e_no_control":
        return fail(3, "no control err")
    # disabled 拒绝
    if cuse.BrowserCuseAction(session, 6, "SetText", "x", "", false, err) != -2:
        return fail(4, "disabled must fail")
    if err != "cuse_e_disabled":
        return fail(5, "disabled err")
    # 未知动作类型: admit 拒绝(-3)
    if cuse.BrowserCuseAction(session, 3, "Smash", "", "", false, err) != -3:
        return fail(6, "bad kind must fail")
    if err != "computer_use_e_action_kind":
        return fail(7, "bad kind err")
    # 确认门: external-publish 未确认拒绝; 08 布尔面收紧后确认类动作即便
    # confirmed=true 也拒绝并指向凭证入口, 唯一通路是凭证入口
    if cuse.BrowserCuseAction(session, 3, "Click", "", "external-publish", false, err) != -3:
        return fail(8, "confirmation gate must fail")
    if err != "computer_use_e_confirmation_required":
        return fail(9, "confirmation err")
    if cuse.BrowserCuseAction(session, 3, "Click", "", "external-publish", true, err) != -7:
        echo(err)
        return fail(10, "confirmed bool face must reject confirm-class action")
    if err != "cuse_e_confirmation_credential_required":
        return fail(10, "bool face must point to credential entry")
    if session.applyReady:
        return fail(10, "rejected bool face must not leave apply")
    # 凭证入口: 提名凭证行精确消费后放行 (状态变化经 apply 通道可查)
    if !auth.CsgActionAuthorityGrantConfirm("Click", ""):
        return fail(10, "grant click confirm credential")
    let credRow = auth.CsgActionAuthorityLastGrantedRow()
    if credRow < 0:
        return fail(10, "granted credential handle")
    if cuse.BrowserCuseActionWithCredential(session, 3, "Click", "", "external-publish", credRow, err) != 0:
        echo(err)
        return fail(10, "credential click must pass")
    if !session.applyReady || session.applyCtlId != 3 || session.applyAction != "Click":
        return fail(11, "apply click channel")
    # 类型矩阵: button 不能 SetText; 文本框不能 Click
    if cuse.BrowserCuseAction(session, 3, "SetText", "x", "", false, err) != -4:
        return fail(12, "button settext must fail")
    if cuse.BrowserCuseAction(session, 4, "Click", "", "", false, err) != -4:
        return fail(13, "input click must fail")
    # SetNumber: 非数字拒绝, 数字更新值+override
    if cuse.BrowserCuseAction(session, 7, "SetNumber", "abc", "", false, err) != -6:
        return fail(14, "setnumber alpha must fail")
    if cuse.BrowserCuseAction(session, 7, "SetNumber", "42", "", false, err) != 0:
        echo(err)
        return fail(15, "setnumber must pass")
    var foundN = false
    var wi: int32 = 0
    while wi < session.widgets.len:
        if session.widgets[wi].ctlId == 7:
            if session.widgets[wi].value != "42":
                return fail(16, "setnumber value")
            foundN = true
        wi = wi + 1
    if !foundN:
        return fail(17, "number widget")
    if session.applyCtlId != 7 || session.applyAction != "SetNumber" || session.applyValue != "42":
        return fail(18, "apply setnumber channel")
    # SetText: 值与 override 更新
    if cuse.BrowserCuseAction(session, 4, "SetText", "hello", "", false, err) != 0:
        echo(err)
        return fail(19, "settext must pass")
    var qVal: str = ""
    wi = 0
    while wi < session.widgets.len:
        if session.widgets[wi].ctlId == 4:
            qVal = strings.ConcatStr(session.widgets[wi].value, "")
        wi = wi + 1
    if qVal != "hello":
        return fail(20, "settext value")
    var ovFound = false
    var oi: int32 = 0
    while oi < session.overrideFields.len:
        if session.overrideFields[oi] == "q" && session.overrideValues[oi] == "hello":
            ovFound = true
        oi = oi + 1
    if !ovFound:
        return fail(21, "settext override")
    # Select: 不在 options 的目标拒绝, label 命中写 value
    if cuse.BrowserCuseAction(session, 5, "Select", "zzz", "", false, err) != -5:
        return fail(22, "select missing must fail")
    if cuse.BrowserCuseAction(session, 5, "Select", "Beta", "", false, err) != 0:
        echo(err)
        return fail(23, "select label must pass")
    var sVal: str = ""
    wi = 0
    while wi < session.widgets.len:
        if session.widgets[wi].ctlId == 5:
            sVal = strings.ConcatStr(session.widgets[wi].value, "")
        wi = wi + 1
    if sVal != "b":
        echo(sVal)
        return fail(24, "select maps label to value")
    if session.applyCtlId != 5 || session.applyAction != "Select" || session.applyValue != "b":
        return fail(25, "apply select channel")
    # disabled 位在 SetText 通道同样拒绝(前面已证)且不产生 apply 残留
    if cuse.BrowserCuseAction(session, 6, "SetText", "y", "", false, err) != -2:
        return fail(26, "disabled settext must fail")
    if session.applyReady:
        return fail(27, "failed action must not leave apply")
    echo("libp2p_browser_cuse_smoke ok")
    return 0
