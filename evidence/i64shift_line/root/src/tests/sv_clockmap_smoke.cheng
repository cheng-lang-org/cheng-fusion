import cheng/game/assets/semantic_video/clockmap

# T3 流时钟映射 smoke（设计 docs/csg-semantic-video-core-design.md §3.3）：
# 正常映射、整除换算、不整除拒绝、段序跳跃拒绝、新世代后旧世代查询拒绝、
# 不确定度超限拒绝、段边界（恰在段起点 / 下一 segStart 前）。

fn main(): int32 =
    var table: clockmap.SvClockMapTable

    # 0. 空表：任何世代都不存在。
    var miss = clockmap.SvClockMapLookup(table, 7, 1000, 100)
    assert(!miss.ok && miss.error == "svcm_generation_unknown",
        " svcm empty table")

    # 1. 世代7 段0：src [1000,2000) → 会话 [5000,...)，速率 1/1，不确定度 100bp。
    var added = clockmap.SvClockMapAddSegment(table, 7, 0, 1000, 5000, 1, 1, 100)
    assert(added.ok, "" + added.error)

    # 2. 世代7 段1：src [2000,3000) → 会话 [7000,...)，速率 3/2，不确定度 50bp。
    added = clockmap.SvClockMapAddSegment(table, 7, 1, 2000, 7000, 3, 2, 50)
    assert(added.ok, "" + added.error)

    # 3. 正常映射（段0 内，1/1 整除）。
    var hit = clockmap.SvClockMapLookup(table, 7, 1500, 100)
    assert(hit.ok, "" + hit.error)
    assert(hit.sessionTick == 5500, " svcm normal mapping tick")

    # 4. 整除换算：段1 内 delta=4，4*3/2=6 → 7006。
    hit = clockmap.SvClockMapLookup(table, 7, 2004, 100)
    assert(hit.ok, "" + hit.error)
    assert(hit.sessionTick == 7006, " svcm rate 3/2 tick")

    # 5. 不整除拒绝：delta=3，3*3=9 不被 2 整除。
    miss = clockmap.SvClockMapLookup(table, 7, 2003, 100)
    assert(!miss.ok && miss.error == "svcm_not_divisible",
        " svcm not divisible")

    # 6. 不确定度超限拒绝：段1 50bp > 请求上限 10bp。
    miss = clockmap.SvClockMapLookup(table, 7, 2000, 10)
    assert(!miss.ok && miss.error == "svcm_clock_uncertainty",
        " svcm uncertainty over limit")

    # 7. 不确定度恰等于上限放行；且恰在段1 起点（左闭，delta=0）。
    hit = clockmap.SvClockMapLookup(table, 7, 2000, 50)
    assert(hit.ok, "" + hit.error)
    assert(hit.sessionTick == 7000, " svcm seg1 boundary start")

    # 8. 下一 segStart 之前：1999 落在段0。
    hit = clockmap.SvClockMapLookup(table, 7, 1999, 100)
    assert(hit.ok, "" + hit.error)
    assert(hit.sessionTick == 5999, " svcm before next seg start")

    # 9. 恰在段0 起点；首段之前拒绝（右开由换算路径覆盖）。
    hit = clockmap.SvClockMapLookup(table, 7, 1000, 100)
    assert(hit.ok, "" + hit.error)
    assert(hit.sessionTick == 5000, " svcm seg0 boundary start")
    miss = clockmap.SvClockMapLookup(table, 7, 999, 100)
    assert(!miss.ok && miss.error == "svcm_src_tick_before_first",
        " svcm before first seg")

    # 10. 段序跳跃拒绝：世代7 下一段必须是 2。
    var jumped = clockmap.SvClockMapAddSegment(table, 7, 5, 3000, 9000, 1, 1, 0)
    assert(!jumped.ok && jumped.error == "svcm_seg_seq_gap",
        " svcm seg seq gap")

    # 11. 合法续段（半速 1/2）及其整除/不整除换算。
    added = clockmap.SvClockMapAddSegment(table, 7, 2, 3000, 9000, 1, 2, 0)
    assert(added.ok, "" + added.error)
    hit = clockmap.SvClockMapLookup(table, 7, 3004, 100)
    assert(hit.ok, "" + hit.error)
    assert(hit.sessionTick == 9002, " svcm rate 1/2 tick")
    miss = clockmap.SvClockMapLookup(table, 7, 3003, 100)
    assert(!miss.ok && miss.error == "svcm_not_divisible",
        " svcm rate 1/2 not divisible")

    # 12. 新世代首段 segSeq 必须 = 0。
    var badNewGen = clockmap.SvClockMapAddSegment(table, 9, 1, 9000, 100, 1, 1, 0)
    assert(!badNewGen.ok && badNewGen.error == "svcm_generation_first_seg_seq",
        " svcm new gen first seg seq")

    # 13. 断时钟 → 新世代9（src 9000 → 会话 100）；旧世代查询立即拒绝。
    added = clockmap.SvClockMapAddSegment(table, 9, 0, 9000, 100, 1, 1, 0)
    assert(added.ok, "" + added.error)
    miss = clockmap.SvClockMapLookup(table, 7, 1500, 1000)
    assert(!miss.ok && miss.error == "svcm_generation_retired",
        " svcm retired generation")
    miss = clockmap.SvClockMapLookup(table, 42, 0, 1000)
    assert(!miss.ok && miss.error == "svcm_generation_unknown",
        " svcm unknown generation")

    # 14. 旧世代禁止再追加；新世代正常换算。
    var staleAdd = clockmap.SvClockMapAddSegment(table, 7, 3, 4000, 9500, 1, 1, 0)
    assert(!staleAdd.ok && staleAdd.error == "svcm_generation_retired",
        " svcm stale add")
    hit = clockmap.SvClockMapLookup(table, 9, 9004, 100)
    assert(hit.ok, "" + hit.error)
    assert(hit.sessionTick == 104, " svcm new generation tick")

    # 15. 换算加法溢出拒绝：世代11 起点 src=0，会话 9e18，delta 5e17 超过
    # int64 余量（上限 9223372036854775807）。
    var maxI64: int64 = 9223372036854775807
    var hugeBase: int64 = maxI64 - 223372036854775807
    added = clockmap.SvClockMapAddSegment(table, 11, 0, 0, hugeBase, 1, 1, 0)
    assert(added.ok, "" + added.error)
    miss = clockmap.SvClockMapLookup(table, 11, 500000000000000000, 100)
    assert(!miss.ok && miss.error == "svcm_tick_overflow",
        " svcm tick overflow")

    echo(" sv_clockmap_smoke ok")
    return 0
