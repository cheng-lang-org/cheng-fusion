import std/strings
import std/strformat
import std/strutils as strutil
import cheng/core/tooling/backend_driver_main as driver_main
import cheng/core/tooling/backend_driver_dispatch_min as dispatch_min

type
    DryCompileTheoryReportFields =
        keys: str[]
        values: str[]

fn parseReport(text: str,
               fields: var DryCompileTheoryReportFields): bool =
    fields.keys = []
    fields.values = []
    if len(text) <= 0 || text[0] == '\n' || text[len(text) - 1] == '\n':
        return false
    if strings.StrContains(text, "\r"):
        return false
    let lines = strutil.Split(text, '\n')
    for lineIndex in 0..<lines.len:
        let line = lines[lineIndex]
        if len(line) <= 0:
            return false
        let parts = strutil.Split(line, '=')
        if parts.len != 2 || len(parts[0]) <= 0 || len(parts[1]) <= 0:
            return false
        for keyIndex in 0..<fields.keys.len:
            if fields.keys[keyIndex] == parts[0]:
                return false
        add(fields.keys, parts[0])
        add(fields.values, parts[1])
    return fields.keys.len == fields.values.len && fields.keys.len > 0

fn reportValue(fields: DryCompileTheoryReportFields,
               key: str,
               value: var str): bool =
    value = ""
    for index in 0..<fields.keys.len:
        if fields.keys[index] == key:
            value = fields.values[index]
            return true
    return false

fn assertReportValue(fields: DryCompileTheoryReportFields,
                     key: str,
                     expected: str) =
    var actual: str
    assert(reportValue(fields, key, actual),
           Fmt"missing report key {key}")
    assert(actual == expected,
           Fmt"report value mismatch key={key} expected={expected} actual={actual}")

fn assertPrefixEqual(left: DryCompileTheoryReportFields,
                     right: DryCompileTheoryReportFields,
                     prefix: str) =
    var leftCount: int32
    var rightCount: int32
    for leftIndex in 0..<left.keys.len:
        if strutil.StartsWith(left.keys[leftIndex], prefix):
            leftCount = leftCount + 1
            var rightValue: str
            assert(reportValue(right, left.keys[leftIndex], rightValue),
                   Fmt"right report missing key {left.keys[leftIndex]}")
            assert(rightValue == left.values[leftIndex],
                   Fmt"report mismatch key={left.keys[leftIndex]} left={left.values[leftIndex]} right={rightValue}")
    for rightIndex in 0..<right.keys.len:
        if strutil.StartsWith(right.keys[rightIndex], prefix):
            rightCount = rightCount + 1
            var leftValue: str
            assert(reportValue(left, right.keys[rightIndex], leftValue),
                   Fmt"left report missing key {right.keys[rightIndex]}")
            assert(leftValue == right.values[rightIndex],
                   Fmt"report mismatch key={right.keys[rightIndex]} left={leftValue} right={right.values[rightIndex]}")
    assert(leftCount > 0 && leftCount == rightCount,
           "report prefixes must have the same non-empty key set")

fn assertReportMissing(fields: DryCompileTheoryReportFields,
                       key: str) =
    var value: str
    assert(!reportValue(fields, key, value),
           Fmt"forbidden report key {key}")

fn assertCheckedTypedFactFailures() =
    var mainModel: driver_main.BackendDriverTypedFactMemoryModel
    var dispatchModel: dispatch_min.BackendDriverDispatchMinTypedFactMemoryModel
    var reason: str
    assert(!driver_main.BackendDriverTypedFactMemoryModelTryBuild(int64(-1),
                                                                  mainModel,
                                                                  reason) &&
           reason == "negative_fact_count",
           "main must reject negative fact count")
    assert(!dispatch_min.BackendDriverDispatchMinTypedFactMemoryModelTryBuild(
               int64(-1),
               dispatchModel,
               reason) &&
           reason == "negative_fact_count",
           "dispatch_min must reject negative fact count")
    let maxInt64: int64 = 9223372036854775807
    assert(!driver_main.BackendDriverTypedFactMemoryModelTryBuild(maxInt64,
                                                                  mainModel,
                                                                  reason) &&
           reason == "physical_storage_overflow",
           "main must reject fact storage multiplication overflow")
    assert(!dispatch_min.BackendDriverDispatchMinTypedFactMemoryModelTryBuild(
               maxInt64,
               dispatchModel,
               reason) &&
           reason == "physical_storage_overflow",
           "dispatch_min must reject fact storage multiplication overflow")

fn assertCheckedFullRssFailures() =
    var mainModel: driver_main.BackendDriverFullRssMemoryModel
    var dispatchModel: dispatch_min.BackendDriverDispatchMinFullRssMemoryModel
    var reason: str
    assert(!driver_main.BackendDriverFullRssMemoryModelTryBuild(
               int64(-1),
               int64(0), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), mainModel, reason) &&
           reason == "rss_source_text_negative",
           "main full RSS model must reject negative inputs")
    assert(!dispatch_min.BackendDriverDispatchMinFullRssMemoryModelTryBuild(
               int64(-1),
               int64(0), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), dispatchModel, reason) &&
           reason == "rss_source_text_negative",
           "dispatch full RSS model must reject negative inputs")
    let maxInt64: int64 = 9223372036854775807
    assert(!driver_main.BackendDriverFullRssMemoryModelTryBuild(
               maxInt64,
               int64(1), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), mainModel, reason) &&
           reason == "rss_csg_phase_overflow",
           "main full RSS model must reject phase addition overflow")
    assert(!dispatch_min.BackendDriverDispatchMinFullRssMemoryModelTryBuild(
               maxInt64,
               int64(1), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), int64(0), int64(0), int64(0),
               int64(0), int64(0), dispatchModel, reason) &&
           reason == "rss_csg_phase_overflow",
           "dispatch full RSS model must reject phase addition overflow")

fn assertCheckedFullReportFailures() =
    var mainReport = "unchanged"
    var dispatchReport = "unchanged"
    var reason: str
    assert(!driver_main.BackendDriverAppendFullTheoryReport(
               mainReport,
               int64(-1), int64(1), int64(1), 0,
               int64(1), int64(1), int64(1), int64(0), int64(1), int64(1),
               int64(1), int64(4096), 1, 1, 1,
               int64(1073741824), int64(1073741824), reason) &&
           reason == "source_files_negative" && mainReport == "unchanged",
           "main append must reject negative input without partial report")
    assert(!dispatch_min.BackendDriverDispatchMinAppendFullTheoryReport(
               dispatchReport,
               int64(-1), int64(1), int64(1), 0,
               int64(1), int64(1), int64(1), int64(0), int64(1), int64(1),
               int64(1), int64(4096), 1, 1, 1,
               int64(1073741824), int64(1073741824), reason) &&
           reason == "source_files_negative" && dispatchReport == "unchanged",
           "dispatch append must reject negative input without partial report")
    let maxInt64: int64 = 9223372036854775807
    assert(!driver_main.BackendDriverAppendFullTheoryReport(
               mainReport,
               int64(1), maxInt64, int64(1), 0,
               int64(1), int64(1), int64(1), int64(0), int64(1), int64(1),
               int64(1), int64(4096), 1, 1, 1,
               int64(1073741824), int64(1073741824), reason) &&
           reason == "csg_expr_lines_overflow" && mainReport == "unchanged",
           "main append must reject full-model multiplication overflow")
    assert(!dispatch_min.BackendDriverDispatchMinAppendFullTheoryReport(
               dispatchReport,
               int64(1), maxInt64, int64(1), 0,
               int64(1), int64(1), int64(1), int64(0), int64(1), int64(1),
               int64(1), int64(4096), 1, 1, 1,
               int64(1073741824), int64(1073741824), reason) &&
           reason == "csg_expr_lines_overflow" && dispatchReport == "unchanged",
           "dispatch append must reject full-model multiplication overflow")
    assert(!driver_main.BackendDriverAppendFullTheoryReport(
               mainReport,
               int64(1), int64(1), int64(1), 0,
               int64(1), int64(1), int64(1), int64(0), int64(1), int64(1),
               int64(1), int64(4096), 2, 1, 2,
               int64(1073741824), int64(1073741824), reason) &&
           reason == "effective_jobs_mismatch" && mainReport == "unchanged",
           "main append must reject inconsistent hardware-only effective jobs")
    assert(!dispatch_min.BackendDriverDispatchMinAppendFullTheoryReport(
               dispatchReport,
               int64(1), int64(1), int64(1), 0,
               int64(1), int64(1), int64(1), int64(0), int64(1), int64(1),
               int64(1), int64(4096), 2, 1, 2,
               int64(1073741824), int64(1073741824), reason) &&
           reason == "effective_jobs_mismatch" && dispatchReport == "unchanged",
           "dispatch append must reject inconsistent hardware-only effective jobs")

fn assertAllocatorClassifiedBranch() =
    var mainModel: driver_main.BackendDriverFullRssMemoryModel
    var dispatchModel: dispatch_min.BackendDriverDispatchMinFullRssMemoryModel
    var reason: str
    assert(driver_main.BackendDriverFullRssMemoryModelTryBuild(
               int64(1), int64(1), int64(1), int64(1), int64(1), int64(1),
               int64(1), int64(0), int64(0), int64(1), int64(100000),
               int64(100000), int64(0), mainModel, reason),
           Fmt"main allocator branch build failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssMemoryModelTryBuild(
               int64(1), int64(1), int64(1), int64(1), int64(1), int64(1),
               int64(1), int64(0), int64(0), int64(1), int64(100000),
               int64(100000), int64(0), dispatchModel, reason),
           Fmt"dispatch allocator branch build failed reason={reason}")
    let mainTyped = driver_main.BackendDriverTypedFactMemoryModelBuild(int64(1))
    let dispatchTyped = dispatch_min.BackendDriverDispatchMinTypedFactMemoryModelBuild(int64(1))
    let mainReport = driver_main.BackendDriverFullRssMemoryModelReport(mainModel,
                                                                       mainTyped)
    let dispatchReport = dispatch_min.BackendDriverDispatchMinFullRssMemoryModelReport(
        dispatchModel,
        dispatchTyped)
    assert(mainReport == dispatchReport,
           "allocator classified branch reports must be identical")
    var fields: DryCompileTheoryReportFields
    assert(parseReport(mainReport, fields),
           "allocator classified branch report must parse")
    assertReportValue(fields,
                      "full_compile_theory_rss_capacity_bytes",
                      "2")
    assertReportValue(fields,
                      "full_compile_theory_rss_orc_bytes",
                      "11200000")
    assertReportValue(fields,
                      "full_compile_theory_rss_arena_bytes",
                      "1")
    assertReportValue(fields,
                      "full_compile_theory_rss_allocator_classified_sum_bytes",
                      "11200003")
    assertReportValue(fields,
                      "full_compile_theory_rss_allocator_modeled_bytes",
                      "11200003")
    assertReportValue(fields,
                      "full_compile_theory_rss_allocator_gap_bytes",
                      "0")
    assertReportValue(fields,
                      "full_compile_theory_rss_modeled_peak_estimate_bytes",
                      "11200008")

fn assertClosedFormParallelMemoryLimit() =
    var mainRss: driver_main.BackendDriverFullRssMemoryModel
    var dispatchRss: dispatch_min.BackendDriverDispatchMinFullRssMemoryModel
    var reason: str
    assert(driver_main.BackendDriverFullRssMemoryModelTryBuild(
               int64(1), int64(1), int64(1), int64(1), int64(1),
               int64(100), int64(1), int64(0), int64(0), int64(1),
               int64(1), int64(1), int64(1073741824),
               mainRss, reason),
           Fmt"main parallel fixture RSS build failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssMemoryModelTryBuild(
               int64(1), int64(1), int64(1), int64(1), int64(1),
               int64(100), int64(1), int64(0), int64(0), int64(1),
               int64(1), int64(1), int64(1073741824),
               dispatchRss, reason),
           Fmt"dispatch parallel fixture RSS build failed reason={reason}")
    assert(mainRss.modeledGuardEstimateBytes ==
           dispatchRss.modeledGuardEstimateBytes,
           "parallel fixture RSS guard parity")
    let tightLimit = mainRss.modeledGuardEstimateBytes
    var mainParallel: driver_main.BackendDriverFullRssParallelMemoryModel
    var dispatchParallel: dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModel
    assert(driver_main.BackendDriverFullRssParallelMemoryModelTryBuild(
               mainRss,
               int64(8),
               int64(8),
               tightLimit,
               mainParallel,
               reason),
           Fmt"main tight parallel model failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModelTryBuild(
               dispatchRss,
               int64(8),
               int64(8),
               tightLimit,
               dispatchParallel,
               reason),
           Fmt"dispatch tight parallel model failed reason={reason}")
    assert(mainParallel.guardScaleNumerator == int64(3) &&
           mainParallel.guardScaleDenominator == int64(1),
           "parallel guard scale must be exact 3/1")
    assert(mainParallel.sourcePerWorkerBytes == int64(0) &&
           mainParallel.typedIrPerWorkerBytes == int64(0),
           "source and typed IR phases must stay serial")
    assert(mainParallel.loweringPerWorkerBytes == int64(300),
           "parallel lowering per-worker bytes must consume full modeled phase increment")
    assert(mainParallel.loweringFixedBytes +
           mainParallel.loweringPerWorkerBytes == tightLimit,
           "tight limit must admit exactly one lowering worker")
    assert(mainParallel.memoryLimitedMaxJobs == int64(1) &&
           mainParallel.effectiveJobs == int64(1),
           "tight limit must cap requested jobs at one")
    assert(driver_main.BackendDriverFullRssParallelMemoryModelReport(
               mainParallel) ==
           dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModelReport(
               dispatchParallel),
           "parallel memory reports must have exact main/dispatch parity")
    var rejectedMain: driver_main.BackendDriverFullRssParallelMemoryModel
    assert(!driver_main.BackendDriverFullRssParallelMemoryModelTryBuild(
               mainRss,
               int64(8),
               int64(8),
               tightLimit - int64(1),
               rejectedMain,
               reason) &&
           reason ==
               "rss_parallel_lowering_one_worker_exceeds_memory_limit",
           "parallel memory model must reject a one-byte-tight underflow")
    let eightWorkerLimit =
        tightLimit + mainParallel.loweringPerWorkerBytes * int64(7)
    var expandedMain: driver_main.BackendDriverFullRssParallelMemoryModel
    var expandedDispatch: dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModel
    assert(driver_main.BackendDriverFullRssParallelMemoryModelTryBuild(
               mainRss,
               int64(16),
               int64(8),
               eightWorkerLimit,
               expandedMain,
               reason),
           Fmt"main expanded parallel model failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModelTryBuild(
               dispatchRss,
               int64(16),
               int64(8),
               eightWorkerLimit,
               expandedDispatch,
               reason),
           Fmt"dispatch expanded parallel model failed reason={reason}")
    assert(expandedMain.memoryLimitedMaxJobs == int64(8) &&
           expandedMain.effectiveJobs == int64(8),
           "expanded limit must cap by hardware without a jobs sweep")
    assert(driver_main.BackendDriverFullRssParallelMemoryModelReport(
               expandedMain) ==
           dispatch_min.BackendDriverDispatchMinFullRssParallelMemoryModelReport(
               expandedDispatch),
           "expanded parallel report parity")

fn main(): int32 =
    assertCheckedTypedFactFailures()
    assertCheckedFullRssFailures()
    assertCheckedFullReportFailures()
    assertAllocatorClassifiedBranch()
    assertClosedFormParallelMemoryLimit()
    let factCount = int64(7)
    let mainModel = driver_main.BackendDriverTypedFactMemoryModelBuild(factCount)
    let dispatchModel = dispatch_min.BackendDriverDispatchMinTypedFactMemoryModelBuild(factCount)
    let mainReport = driver_main.BackendDriverTypedFactMemoryModelReport(mainModel)
    let dispatchReport = dispatch_min.BackendDriverDispatchMinTypedFactMemoryModelReport(dispatchModel)
    assert(mainReport == dispatchReport,
           "main and dispatch_min typed-fact memory reports must be identical")
    var typedFields: DryCompileTheoryReportFields
    assert(parseReport(mainReport, typedFields),
           "typed-fact report must have unique keys and exact newline boundaries")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_physical_column_count",
                      "41")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_physical_int32_column_count",
                      "26")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_physical_u8_column_count",
                      "15")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_int32_scalar_bytes",
                      "4")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_u8_scalar_bytes",
                      "1")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_physical_row_bytes",
                      "119")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_storage_model",
                      "mixed_width_presized_soa")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_intern_payload_model",
                      "excluded_unmodeled_separate_owner")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_fact_allocator_overhead_model",
                      "excluded_global_allocator_gap")
    assertReportValue(typedFields,
                      "full_compile_theory_rss_typed_facts_bytes",
                      "833")
    assert(!strings.StrContains(mainReport,
                                "full_compile_theory_rss_typed_facts_bytes=896"),
           "legacy uniform-int32 row formula must fail")

    var mainFullReport: str
    var dispatchFullReport: str
    var reason: str
    assert(driver_main.BackendDriverAppendFullTheoryReport(
               mainFullReport,
               int64(1), int64(1), int64(1), 0,
               int64(1), int64(1), int64(1), int64(0), int64(1), int64(1),
               int64(1), int64(4096), 1, 1, 1,
               int64(1073741824), int64(1073741824), reason),
           Fmt"main full report failed reason={reason}")
    assert(dispatch_min.BackendDriverDispatchMinAppendFullTheoryReport(
               dispatchFullReport,
               int64(1), int64(1), int64(1), 0,
               int64(1), int64(1), int64(1), int64(0), int64(1), int64(1),
               int64(1), int64(4096), 1, 1, 1,
               int64(1073741824), int64(1073741824), reason),
           Fmt"dispatch full report failed reason={reason}")
    assert(mainFullReport == dispatchFullReport,
           "main and dispatch full reports must have exact key/value parity")
    var mainFields: DryCompileTheoryReportFields
    var dispatchFields: DryCompileTheoryReportFields
    assert(parseReport(mainFullReport, mainFields),
           "main full report must have unique keys and exact newline boundaries")
    assert(parseReport(dispatchFullReport, dispatchFields),
           "dispatch full report must have unique keys and exact newline boundaries")
    assertPrefixEqual(mainFields, dispatchFields, "full_compile_theory_")
    assertReportValue(mainFields,
                      "full_compile_theory_scope",
                      "non_exhaustive_modeled_compile_estimate_without_codegen_execution")
    assertReportValue(dispatchFields,
                      "full_compile_theory_scope",
                      "non_exhaustive_modeled_compile_estimate_without_codegen_execution")
    assertReportValue(mainFields,
                      "full_compile_theory_bound_status",
                      "not_proven_upper_bound")
    assertReportValue(dispatchFields,
                      "full_compile_theory_bound_status",
                      "not_proven_upper_bound")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_modeled_structured_peak_bytes",
                      "56980")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_modeled_retention_model",
                      "phase_lifetime_max_with_explicit_release")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_legacy_retained_cumulative_estimate_bytes",
                      "63652")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_proven_upper_bound_status",
                      "not_proven")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_component_coverage",
                      "non_exhaustive")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_unmodeled_components",
                      "typed_fact_intern_payload,other_string_and_intern_pools,allocator_runtime_metadata,process_runtime_baseline,thread_stacks,device_allocations,linker_allocations,codegen_provider_allocations")
    assertReportValue(mainFields,
                      "full_compile_theory_phase_csg_nodes",
                      "120")
    assertReportValue(mainFields,
                      "full_compile_theory_phase_csg_edges",
                      "242")
    assertReportValue(mainFields,
                      "full_compile_theory_phase_csg_facts",
                      "398")
    assertReportValue(mainFields,
                      "full_compile_theory_phase_typed_ir_funcs",
                      "2")
    assertReportValue(mainFields,
                      "full_compile_theory_phase_typed_ir_statements",
                      "3")
    assertReportValue(mainFields,
                      "full_compile_theory_phase_lowering_body_ir_ops",
                      "14")
    assertReportValue(mainFields,
                      "full_compile_theory_phase_primary_instruction_words",
                      "60")
    assertReportValue(mainFields,
                      "full_compile_theory_phase_primary_object_bytes",
                      "4480")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_typed_facts_bytes",
                      "47362")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_capacity_bytes",
                      "14245")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_orc_bytes",
                      "160")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_arena_bytes",
                      "2234")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_allocator_classified_sum_bytes",
                      "16639")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_allocator_heuristic_estimate_bytes",
                      "4222794")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_allocator_modeled_bytes",
                      "4222794")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_allocator_gap_bytes",
                      "4206155")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_modeled_peak_estimate_bytes",
                      "4279774")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_modeled_budget_estimate_bytes",
                      "25336764")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_modeled_guard_estimate_bytes",
                      "92445628")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_parallel_model",
                      "closed_form_phase_fixed_plus_per_worker")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_memory_limit_bytes",
                      "1073741824")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_parallel_guard_scale_numerator",
                      "3")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_parallel_guard_scale_denominator",
                      "1")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_phase_source_per_worker_bytes",
                      "0")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_phase_csg_per_worker_bytes",
                      "0")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_phase_typed_ir_per_worker_bytes",
                      "0")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_phase_provider_per_worker_bytes",
                      "0")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_memory_limited_max_jobs",
                      "1")
    assertReportValue(mainFields,
                      "full_compile_theory_rss_memory_limited_effective_jobs",
                      "1")
    assertReportValue(mainFields,
                      "full_compile_theory_time_effective_jobs",
                      "1")
    assertReportMissing(mainFields,
                        "full_compile_theory_rss_lower_bound_bytes")
    assertReportMissing(mainFields,
                        "full_compile_theory_rss_budget_upper_bound_bytes")
    assertReportMissing(mainFields,
                        "full_compile_theory_rss_guard_recommended_bytes")
    assert(!strings.StrContains(mainFullReport,
                                "full_compile_theory_rss_typed_facts_bytes=12736") &&
           !strings.StrContains(dispatchFullReport,
                                "full_compile_theory_rss_typed_facts_bytes=12736"),
           "both full-theory entries must reject the legacy 398 * 32 bytes")
    echo("cheng dry_compile_typed_fact_memory_model_smoke ok")
    return 0
