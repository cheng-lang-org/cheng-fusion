import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/core/tooling/compiler_world as cworld

fn CompilerWorldSourceRawStreamByte(index: int32): int32 =
    return (index * 53 + 19) & 255

fn CompilerWorldSourceRawStreamCase(byteCount: int32) =
    var payload = BytesAlloc(byteCount)
    for index in 0..<byteCount:
        BytesSet(payload, index, CompilerWorldSourceRawStreamByte(index))

    var oldPreimage = layout.ByteBufInit(byteCount + 96)
    cworld.CompilerWorldAppendText(
        oldPreimage,
        "cheng.compiler.source_raw_bytes")
    cworld.CompilerWorldAppendU32BE(oldPreimage, byteCount)
    layout.ByteBufAppendBytes(oldPreimage, payload)
    let expected = cworld.CompilerWorldBufCid(oldPreimage)

    let fromBytes = cworld.CompilerWorldSourceRawBytesCidFromBytes(payload)
    assert(layout.FixedBytes32Equal(expected, fromBytes),
           " compiler world raw stream: byte preimage changed")
    if byteCount == 0:
        assert(layout.FixedBytes32Hex(fromBytes) ==
               "91a7a1856deffb140e3fdc5f2316366f4e38e32fbbbb14f12892c98c05a11bd9",
               " compiler world raw stream: empty framing KAT changed")
    let payloadText = rawbytes.BytesToString(payload)
    let fromText = cworld.CompilerWorldSourceRawBytesCid(payloadText)
    assert(layout.FixedBytes32Equal(expected, fromText),
           " compiler world raw stream: text preimage changed")
    BytesFree(payload)

fn main(): int32 =
    CompilerWorldSourceRawStreamCase(0)
    CompilerWorldSourceRawStreamCase(1)
    CompilerWorldSourceRawStreamCase(55)
    CompilerWorldSourceRawStreamCase(56)
    CompilerWorldSourceRawStreamCase(64)
    CompilerWorldSourceRawStreamCase(65)
    CompilerWorldSourceRawStreamCase(4097)
    echo("compiler_world_source_raw_stream_fixed_point_smoke ok")
    return 0
