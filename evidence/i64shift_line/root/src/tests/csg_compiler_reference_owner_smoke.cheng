import std/os
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/compiler_snapshot_cargo as cargo
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/backend/compiler_facts as facts
import cheng/tests/semantic_snapshot_incremental_plan_smoke as fixture

fn ReferenceOwnerSymbolForSource(
        tables: schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        symbolKind: int32): int32 =
    for symbolId in 0..<tables.symbols.symbolCids.len:
        if tables.symbols.sourceIds[symbolId] == sourceId &&
           tables.symbols.symbolKinds[symbolId] == symbolKind:
            return symbolId
    assert(false, "missing fixture Symbol kind for source")
    return -1

fn ReferenceOwnerFunctionForSymbol(
        tables: schema.CsgCompilerSnapshotTables,
        symbolId: int32): int32 =
    for functionId in 0..<tables.functions.symbolIds.len:
        if tables.functions.symbolIds[functionId] == symbolId:
            return functionId
    assert(false, "missing fixture FunctionId for SymbolId")
    return -1

fn ReferenceOwnerSpanForSource(
        tables: schema.CsgCompilerSnapshotTables,
        sourceId: int32): int32 =
    for spanId in 0..<tables.spans.sourceIds.len:
        if tables.spans.sourceIds[spanId] == sourceId:
            return spanId
    assert(false, "missing fixture span for source")
    return -1

fn ReferenceOwnerSetSingle(
        tables: var schema.CsgCompilerSnapshotTables,
        sourceId: int32,
        spanId: int32,
        ownerFunctionId: int32,
        ownerSymbolId: int32,
        targetSymbolId: int32,
        referenceKind: int32) =
    tables.references.sourceIds = [sourceId]
    tables.references.spanIds = [spanId]
    tables.references.ownerFunctionIds = [ownerFunctionId]
    tables.references.ownerSymbolIds = [ownerSymbolId]
    tables.references.targetSymbolIds = [targetSymbolId]
    tables.references.referenceKinds = [referenceKind]
    tables.references.bindingTypedNodeIds = [-1]

fn main() =
    var err: str
    var tables = fixture.BuildPreviousTables()
    let source0FunctionSymbol = ReferenceOwnerSymbolForSource(
        tables, 0, schema.CsgCompilerSymbolFunction)
    let source1FunctionSymbol = ReferenceOwnerSymbolForSource(
        tables, 1, schema.CsgCompilerSymbolFunction)
    let source0ModuleSymbol = ReferenceOwnerSymbolForSource(
        tables, 0, schema.CsgCompilerSymbolModule)
    let source0FunctionId = ReferenceOwnerFunctionForSymbol(
        tables, source0FunctionSymbol)
    let source1FunctionId = ReferenceOwnerFunctionForSymbol(
        tables, source1FunctionSymbol)
    let source0Span = ReferenceOwnerSpanForSource(tables, 0)

    ReferenceOwnerSetSingle(
        tables, 0, source0Span, source0FunctionId,
        source0FunctionSymbol, source1FunctionSymbol,
        schema.CsgCompilerReferenceRead)
    assert(schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err),
           err)
    let crossModuleFact =
        facts.CompilerFactSnapshotFillReference(tables, 0, int64(17))
    assert(crossModuleFact.kind == facts.FactKindReference &&
           crossModuleFact.sourceVersion == int64(17) &&
           crossModuleFact.referenceFact.ownerFunctionId ==
               source0FunctionId &&
           crossModuleFact.referenceFact.ownerSymbolId ==
               source0FunctionSymbol &&
           crossModuleFact.referenceFact.targetSymbolId ==
               source1FunctionSymbol &&
           crossModuleFact.referenceFact.sourceId == 0 &&
           layout.FixedBytes32Equal(
               crossModuleFact.referenceFact.ownerSymbolCid,
               tables.symbols.symbolCids[source0FunctionSymbol]) &&
           layout.FixedBytes32Equal(
               crossModuleFact.referenceFact.targetSymbolCid,
               tables.symbols.symbolCids[source1FunctionSymbol]),
           "cross-module CompilerFact lost exact owner or target identity")
    var functionOwnerCargo = cargo.CsgCompilerSnapshotCargoBuild(tables)
    assert(functionOwnerCargo.ok, functionOwnerCargo.error)

    var ownerCidAttack = fixture.BuildPreviousTables()
    let ownerCidAttackFunction = ReferenceOwnerSymbolForSource(
        ownerCidAttack, 0, schema.CsgCompilerSymbolFunction)
    let ownerCidAttackTarget = ReferenceOwnerSymbolForSource(
        ownerCidAttack, 1, schema.CsgCompilerSymbolFunction)
    ReferenceOwnerSetSingle(
        ownerCidAttack, 0, source0Span,
        ReferenceOwnerFunctionForSymbol(
            ownerCidAttack, ownerCidAttackFunction),
        ownerCidAttackFunction, ownerCidAttackTarget,
        schema.CsgCompilerReferenceRead)
    ownerCidAttack.symbols.symbolCids[ownerCidAttackFunction] =
        layout.FixedBytes32()
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(
               ownerCidAttack, err),
           "reference owner SymbolCid tamper accepted")
    var ownerCidAttackCargo =
        cargo.CsgCompilerSnapshotCargoBuild(ownerCidAttack)
    assert(!ownerCidAttackCargo.ok,
           "reference owner SymbolCid tamper published cargo")
    cargo.CsgCompilerSnapshotCargoRelease(ownerCidAttackCargo)

    tables = fixture.BuildPreviousTables()
    ReferenceOwnerSetSingle(
        tables, 0, source0Span, -1, source0ModuleSymbol,
        source0ModuleSymbol, schema.CsgCompilerReferenceImport)
    assert(schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err),
           err)
    let moduleOwnerFact =
        facts.CompilerFactSnapshotFillReference(tables, 0, int64(18))
    assert(moduleOwnerFact.referenceFact.ownerFunctionId == -1 &&
           moduleOwnerFact.referenceFact.ownerSymbolId ==
               source0ModuleSymbol &&
           layout.FixedBytes32Equal(
               moduleOwnerFact.referenceFact.ownerSymbolCid,
               tables.symbols.symbolCids[source0ModuleSymbol]),
           "Module-owned CompilerFact indexed a Function owner")
    var moduleOwnerCargo = cargo.CsgCompilerSnapshotCargoBuild(tables)
    assert(moduleOwnerCargo.ok, moduleOwnerCargo.error)
    let oldIdentityResult = cargo.CsgCompilerSnapshotCargoVerify(
        moduleOwnerCargo.csgcBytes, functionOwnerCargo.factsRootCid)
    assert(!oldIdentityResult.ok,
           "recomputed owner cargo accepted the old facts identity")

    tables = fixture.BuildPreviousTables()
    ReferenceOwnerSetSingle(
        tables, 0, source0Span, source1FunctionId,
        source1FunctionSymbol, source0FunctionSymbol,
        schema.CsgCompilerReferenceRead)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err),
           "cross-source reference owner accepted")

    tables = fixture.BuildPreviousTables()
    ReferenceOwnerSetSingle(
        tables, 0, source0Span, source0FunctionId,
        source0ModuleSymbol, source0FunctionSymbol,
        schema.CsgCompilerReferenceRead)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err),
           "FunctionId and owner Symbol split accepted")

    tables = fixture.BuildPreviousTables()
    ReferenceOwnerSetSingle(
        tables, 0, source0Span, source0FunctionId,
        source0FunctionSymbol, source0FunctionSymbol,
        schema.CsgCompilerReferenceType)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err),
           "Type reference target kind attack accepted")

    tables = fixture.BuildPreviousTables()
    ReferenceOwnerSetSingle(
        tables, 0, source0Span, source0FunctionId,
        source0FunctionSymbol, source0FunctionSymbol,
        schema.CsgCompilerReferenceImport)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err),
           "Import reference target kind attack accepted")

    tables = fixture.BuildPreviousTables()
    ReferenceOwnerSetSingle(
        tables, 0, source0Span, source0FunctionId,
        source0FunctionSymbol, source0ModuleSymbol,
        schema.CsgCompilerReferenceCall)
    assert(!schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err),
           "Call reference target kind attack accepted")

    cargo.CsgCompilerSnapshotCargoRelease(functionOwnerCargo)
    cargo.CsgCompilerSnapshotCargoRelease(moduleOwnerCargo)
    os.WriteLine(os.Get_stdout(), "csg_compiler_reference_owner_smoke: ok")
