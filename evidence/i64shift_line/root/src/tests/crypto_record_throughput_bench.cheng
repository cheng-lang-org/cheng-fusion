import std/system
import std/result
import std/rawbytes
import std/strings as strutil
import std/monotimes as mono
import std/crypto/aesgcm
import std/crypto/chacha20poly1305 as chacha

const
    RecordSize = 16384
    Iters = 200

fn fillSeq(b: Bytes) =
    for i in 0..<BytesLen(b):
        BytesSet(b, i, i & 255)

fn reportLine(name: str, totalNs: int64) =
    let perRecordUs: int64 = totalNs / int64(Iters) / int64(1000)
    let totalBytes: int64 = int64(RecordSize) * int64(Iters)
    # KiB/s = totalBytes * 1e9 / 1024 / totalNs
    var kibps: int64
    if totalNs > int64(0):
        kibps = (totalBytes * int64(1000000000) / int64(1024)) / totalNs
    echo(strutil.Join([name,
                       " total_ms=", strutil.Int64ToStr(totalNs / int64(1000000)),
                       " per_record_us=", strutil.Int64ToStr(perRecordUs),
                       " throughput_kibps=", strutil.Int64ToStr(kibps)], ""))

fn main(): int32 =
    let aad: Bytes = BytesAlloc(5)
    fillSeq(aad)
    let nonce: Bytes = BytesAlloc(12)
    fillSeq(nonce)

    # --- AES-128-GCM (software, cached round keys) ---
    let aesKeyBytes: Bytes = BytesAlloc(16)
    fillSeq(aesKeyBytes)
    let aesKeyRes: Result[aesgcm.AesGcmKey] = aesgcm.intoAesGcmKey(aesKeyBytes)
    if IsErr(aesKeyRes):
        echo(ErrorText(aesKeyRes))
        return 1
    let aesKey: aesgcm.AesGcmKey = Value(aesKeyRes)
    let aesData: Bytes = BytesAlloc(RecordSize)
    fillSeq(aesData)
    let aesStart: mono.MonoTime = mono.GetMonoTime()
    for i in 0..<Iters:
        var tagB: Bytes
        let encRes: Result[bool] = aesgcm.aesGcmEncryptRaw(aesKey.rounds,
                                                           aesKey.roundKeys,
                                                           nonce,
                                                           tagB,
                                                           aesData,
                                                           aad)
        if IsErr(encRes):
            echo(ErrorText(encRes))
            return 1
        BytesFree(tagB)
    let aesEnd: mono.MonoTime = mono.GetMonoTime()
    let aesNs: int64 = mono.MonoTimeNs(aesEnd) - mono.MonoTimeNs(aesStart)

    # --- ChaCha20-Poly1305 (software) ---
    let ccKeyBytes: Bytes = BytesAlloc(32)
    fillSeq(ccKeyBytes)
    let ccKeyRes: Result[chacha.ChaChaPolyKey] = chacha.intoChaChaPolyKey(ccKeyBytes)
    if IsErr(ccKeyRes):
        echo(ErrorText(ccKeyRes))
        return 1
    let ccNonceRes: Result[chacha.ChaChaPolyNonce] = chacha.intoChaChaPolyNonce(nonce)
    if IsErr(ccNonceRes):
        echo(ErrorText(ccNonceRes))
        return 1
    let ccKey: chacha.ChaChaPolyKey = Value(ccKeyRes)
    let ccNonce: chacha.ChaChaPolyNonce = Value(ccNonceRes)
    let ccData: Bytes = BytesAlloc(RecordSize)
    fillSeq(ccData)
    let ccStart: mono.MonoTime = mono.GetMonoTime()
    for i in 0..<Iters:
        var tag: chacha.ChaChaPolyTag
        let encRes2: Result[bool] = chacha.encrypt(ccKey, ccNonce, tag, ccData, aad)
        if IsErr(encRes2):
            echo(ErrorText(encRes2))
            return 1
        BytesFree(tag.data)
    let ccEnd: mono.MonoTime = mono.GetMonoTime()
    let ccNs: int64 = mono.MonoTimeNs(ccEnd) - mono.MonoTimeNs(ccStart)

    echo(strutil.Join(["record_size=", strutil.IntToStr(RecordSize),
                       " iters=", strutil.IntToStr(Iters)], ""))
    reportLine("aesgcm", aesNs)
    reportLine("chacha20poly1305", ccNs)
    return 0
