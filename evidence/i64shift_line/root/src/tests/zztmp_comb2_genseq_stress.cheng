fn GenericSeqRead[T](vals: T[], i: int32, out: var T): bool =
    out = vals[i]
    return true

fn main(): int32 =
    var vals: str[]
    setLen(vals, 4)
    vals[1] = "value-17"
    vals[2] = "value-23-longer-heap-string"
    var out: str
    var rounds = 0
    while rounds < 2000:
        if !GenericSeqRead[str](share(vals), 1, out):
            return 41
        if !GenericSeqRead[str](share(vals), 2, out):
            return 43
        rounds = rounds + 1
    if out != "value-23-longer-heap-string":
        return 44
    echo(out)
    var ints: int32[]
    setLen(ints, 3)
    ints[2] = 777
    var iout: int32
    rounds = 0
    while rounds < 2000:
        if !GenericSeqRead[int32](share(ints), 2, iout):
            return 45
        rounds = rounds + 1
    if iout != 777:
        return 46
    echo(Fmt"iout={iout}")
    return 0
