type InitDict =
    bubbles: int32
    cancelable: int32

fn Ctor(eventInit: var InitDict): bool =
    if eventInit.bubbles != -1:
        return true
    if eventInit.cancelable != -1:
        return true
    return false

fn main(): int32 =
    var d: InitDict
    d.bubbles = 1
    let ok = Ctor(d)
    if ok:
        return 0
    return 1
