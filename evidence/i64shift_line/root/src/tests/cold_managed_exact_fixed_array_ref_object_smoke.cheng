import std/system as system

type
    ColdManagedExactFixedArrayRefLeaf = ref object
        label: str

    ColdManagedExactFixedArrayRefOwner =
        leaves: ColdManagedExactFixedArrayRefLeaf[2]

fn ColdManagedExactFixedArrayRefNew(value: str): ColdManagedExactFixedArrayRefLeaf =
    var leaf = new(ColdManagedExactFixedArrayRefLeaf)
    leaf.label = system.NewStringCopy(
        system.StrDataPtr(value), value.len)
    return leaf

fn ColdManagedExactFixedArrayRefObjectExercise(): int32 =
    var owner: ColdManagedExactFixedArrayRefOwner
    if owner.leaves[0] != nil || owner.leaves[1] != nil:
        return 1

    owner.leaves[0] = ColdManagedExactFixedArrayRefNew("left")
    owner.leaves[1] = ColdManagedExactFixedArrayRefNew("right")
    owner.leaves[0] = owner.leaves[0]
    owner.leaves[0] = ColdManagedExactFixedArrayRefNew("new-left")
    owner.leaves[1] = nil

    if owner.leaves[0] == nil ||
       owner.leaves[0].label != "new-left" ||
       owner.leaves[1] != nil:
        return 2
    owner.leaves[0] = nil
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactFixedArrayRefObjectExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        return 2
    if system.memLiveCount() != liveBefore:
        return 3
    if releaseDelta != retainDelta + freeDelta:
        return 4
    echo("cold_managed_exact_fixed_array_ref_object=PASS")
    return 0
