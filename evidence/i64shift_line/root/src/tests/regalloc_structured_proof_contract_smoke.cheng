import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_cfg as cfg
import cheng/core/backend/regalloc_single_pass as alloc

fn proofHash(): str =
    return "3333333333333333333333333333333333333333333333333333333333333333"

fn emptyProofHash(): str =
    return "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"

fn ackAction(plan: var alloc.RegallocSinglePassValuePlan,
             action: alloc.RegallocValueAction,
             ticket: alloc.RegallocValueActionTicket,
             emittedByteStart: int32): bool =
    if alloc.RegallocSinglePassValueActionBindingKind(action.kind) ==
       alloc.RegallocValueBindingStructural:
        return alloc.RegallocSinglePassValuePlanAck(
            plan, ticket, 0, 0, emptyProofHash())
    return alloc.RegallocSinglePassValuePlanAck(
        plan, ticket, emittedByteStart, 4, proofHash())

fn makeArgSlot(id: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "abi_arg"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = -1
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn buildTenArgCall(includeAbiSizes: bool): ir.BodyIR =
    var body = ir.BodyIRNew()
    for slotIndex in 0..<10:
        add(body.localSlots, makeArgSlot(slotIndex))
    var call: ir.CallOp
    call.targetSymbol = "ten_arg_target"
    call.resultSlot = -1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    for argIndex in 0..<10:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        var abiSize = 4
        if argIndex == 8:
            abiSize = 1
        if includeAbiSizes:
            add(call.argAbiSizes, abiSize)
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = -1
    add(op.operands, 0)
    add(body.ops, op)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildPlan(body: var ir.BodyIR): alloc.RegallocSinglePassValuePlan =
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    return alloc.RegallocSinglePassValuePlanBuildDecoded(body, constraints)

fn appendVoidCall(body: var ir.BodyIR, argSlot: int32) =
    var call: ir.CallOp
    call.targetSymbol = "sparse_arg_target"
    call.resultSlot = -1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    if argSlot >= 0:
        add(call.argSlots, argSlot)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = -1
    add(op.operands, body.callSequence.len - 1)
    add(body.ops, op)

fn buildSparseArgCalls(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeArgSlot(0))
    appendVoidCall(body, -1)
    appendVoidCall(body, -1)
    appendVoidCall(body, 0)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 3, termIndex)
    return body

fn checkAbiFactsAndActions(): int32 =
    var body = buildTenArgCall(true)
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    if !table.valid || !analysis.valid || !plan.valid:
        return 11
    var fact8: bool
    var fact9: bool
    for factIndex in 0..<table.facts.len:
        let fact = table.facts[factIndex]
        if fact.fixedKind != access.BodyIrAccessFixedCallArg:
            continue
        if fact.fixedOrdinal == 8:
            fact8 = fact.callOrdinal == 0 && fact.abiSizeBytes == 1 &&
                    fact.abiSizeExplicit &&
                    fact.outgoingStackArgIndex == 0 &&
                    fact.outgoingStackByteOffset == 0 &&
                    fact.outgoingStackByteWidth == 1 &&
                    fact.outgoingStackFrameBytes == 16
        elif fact.fixedOrdinal == 9:
            fact9 = fact.callOrdinal == 0 && fact.abiSizeBytes == 4 &&
                    fact.abiSizeExplicit &&
                    fact.outgoingStackArgIndex == 1 &&
                    fact.outgoingStackByteOffset == 4 &&
                    fact.outgoingStackByteWidth == 4 &&
                    fact.outgoingStackFrameBytes == 16
    if !fact8 || !fact9:
        return 12
    var action8: bool
    var action9: bool
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.kind != alloc.RegallocValueActionStoreStackArg:
            continue
        if action.fixedOrdinal == 8:
            action8 = action.callOrdinal == 0 &&
                      action.abiSizeBytes == 1 &&
                      action.outgoingStackArgIndex == 0 &&
                      action.outgoingStackByteOffset == 0 &&
                      action.outgoingStackByteWidth == 1 &&
                      action.outgoingStackFrameBytes == 16
        elif action.fixedOrdinal == 9:
            action9 = action.callOrdinal == 0 &&
                      action.abiSizeBytes == 4 &&
                      action.outgoingStackArgIndex == 1 &&
                      action.outgoingStackByteOffset == 4 &&
                      action.outgoingStackByteWidth == 4 &&
                      action.outgoingStackFrameBytes == 16
    if !action8 || !action9:
        return 13
    var inferredBody = buildTenArgCall(false)
    var inferredPlan = buildPlan(inferredBody)
    if !inferredPlan.valid:
        return 14
    var inferredStackArg: bool
    for actionIndex in 0..<inferredPlan.actions.len:
        let action = inferredPlan.actions[actionIndex]
        if action.kind == alloc.RegallocValueActionStoreStackArg &&
           action.fixedOrdinal == 8:
            inferredStackArg = !action.abiSizeExplicit &&
                               action.abiSizeBytes == 4 &&
                               action.outgoingStackByteOffset == 0 &&
                               action.outgoingStackByteWidth == 4 &&
                               action.outgoingStackFrameBytes == 16
    if !inferredStackArg:
        return 15
    var sparseBody = buildSparseArgCalls()
    var sparsePlan = buildPlan(sparseBody)
    if !sparsePlan.valid || sparsePlan.callCount != 3 ||
       sparsePlan.callArgCounts.len != 3 ||
       sparsePlan.callArgCounts[0] != 0 ||
       sparsePlan.callArgCounts[1] != 0 ||
       sparsePlan.callArgCounts[2] != 1:
        return 16
    var sparseArg: bool
    var clobberCount: int32
    for actionIndex in 0..<sparsePlan.actions.len:
        let action = sparsePlan.actions[actionIndex]
        if action.kind == alloc.RegallocValueActionCallClobber:
            clobberCount = clobberCount + 1
        if action.fixedKind == access.BodyIrAccessFixedCallArg &&
           action.callOrdinal == 2 && action.fixedOrdinal == 0:
            sparseArg = true
    if !sparseArg || clobberCount != 3:
        return 17
    return 0

fn checkMissingActionAtFails(): int32 =
    var body = buildTenArgCall(true)
    var plan = buildPlan(body)
    if !plan.valid || !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, "missing_action_at", 100, 64):
        return 21
    var ticket: alloc.RegallocValueActionTicket
    ticket.valid = true
    ticket.consumerOrdinal = 0
    ticket.kind = plan.actions[0].kind
    ticket.placement = plan.actions[0].placement
    ticket.position = plan.actions[0].position
    ticket.factIndex = plan.actions[0].factIndex
    ticket.valueId = plan.actions[0].valueId
    ticket.fixedOrdinal = plan.actions[0].fixedOrdinal
    if alloc.RegallocSinglePassValuePlanAck(
           plan, ticket, 100, 4, proofHash()) || plan.valid:
        return 22
    return 0

fn checkDeadConsumerFails(): int32 =
    var body = buildTenArgCall(true)
    var plan = buildPlan(body)
    if !plan.valid || !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, "dead_consumer", 200, 64):
        return 31
    var action: alloc.RegallocValueAction
    var ticket: alloc.RegallocValueActionTicket
    if !alloc.RegallocSinglePassValuePlanActionAt(
           plan, 0, action, ticket):
        return 32
    if alloc.RegallocSinglePassValuePlanFinalize(plan) || plan.valid ||
       plan.errorCode != alloc.RegallocValuePlanErrorUnacknowledged:
        return 33
    var sealPlan = buildPlan(body)
    if !sealPlan.valid ||
       !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           sealPlan, "premature_seal", 264, 64):
        return 34
    var sealAction: alloc.RegallocValueAction
    var sealTicket: alloc.RegallocValueActionTicket
    if !alloc.RegallocSinglePassValuePlanActionAt(
           sealPlan, 0, sealAction, sealTicket):
        return 35
    if alloc.RegallocSinglePassValuePlanSealEmissionSymbol(
           sealPlan, proofHash()) || sealPlan.valid ||
       sealPlan.errorCode != alloc.RegallocValuePlanErrorUnacknowledged:
        return 36
    return 0

fn checkForgedTicketFails(): int32 =
    var body = buildTenArgCall(true)
    var plan = buildPlan(body)
    if !plan.valid || !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, "forged_ticket", 300, 64):
        return 41
    var action: alloc.RegallocValueAction
    var ticket: alloc.RegallocValueActionTicket
    if !alloc.RegallocSinglePassValuePlanActionAt(
           plan, 0, action, ticket):
        return 42
    ticket.actionSnapshot.encodedValue =
        ticket.actionSnapshot.encodedValue + 1
    if alloc.RegallocSinglePassValuePlanAck(
           plan, ticket, 300, 4, proofHash()) || plan.valid ||
       plan.errorCode != alloc.RegallocValuePlanErrorActionNotIssued:
        return 43
    var ownerPlan = buildPlan(body)
    var foreignPlan = buildPlan(body)
    if !ownerPlan.valid || !foreignPlan.valid ||
       !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           ownerPlan, "ticket_owner_a", 320, 64) ||
       !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           foreignPlan, "ticket_owner_b", 384, 64):
        return 44
    var ownerAction: alloc.RegallocValueAction
    var ownerTicket: alloc.RegallocValueActionTicket
    var foreignAction: alloc.RegallocValueAction
    var foreignTicket: alloc.RegallocValueActionTicket
    if !alloc.RegallocSinglePassValuePlanActionAt(
           ownerPlan, 0, ownerAction, ownerTicket) ||
       !alloc.RegallocSinglePassValuePlanActionAt(
           foreignPlan, 0, foreignAction, foreignTicket):
        return 45
    if ackAction(foreignPlan, foreignAction, ownerTicket, 384) ||
       foreignPlan.valid ||
       foreignPlan.errorCode !=
           alloc.RegallocValuePlanErrorActionNotIssued:
        return 46
    return 0

fn checkSemanticRootTamperFails(): int32 =
    var body = buildTenArgCall(true)
    var plan = buildPlan(body)
    if !plan.valid || plan.callArgCounts.len != 1:
        return 47
    plan.callArgCounts[0] = plan.callArgCounts[0] + 1
    if alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, "tampered_semantic", 4480, 4096) || plan.valid ||
       plan.errorCode != alloc.RegallocValuePlanErrorSemanticRoot:
        return 48
    return 0

fn checkBindingKinds(): int32 =
    var body = buildTenArgCall(true)
    var machinePlan = buildPlan(body)
    if !machinePlan.valid ||
       !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           machinePlan, "machine_zero", 704, 4096):
        return 71
    var machineAction: alloc.RegallocValueAction
    var machineTicket: alloc.RegallocValueActionTicket
    if !alloc.RegallocSinglePassValuePlanActionAt(
           machinePlan, 0, machineAction, machineTicket) ||
       alloc.RegallocSinglePassValueActionBindingKind(
           machineAction.kind) != alloc.RegallocValueBindingMachine:
        return 72
    if alloc.RegallocSinglePassValuePlanAck(
           machinePlan, machineTicket, 0, 0, emptyProofHash()) ||
       machinePlan.valid ||
       machinePlan.errorCode != alloc.RegallocValuePlanErrorEmissionShape:
        return 73

    var structuralPlan = buildPlan(body)
    if !structuralPlan.valid ||
       !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           structuralPlan, "structural_bytes", 4800, 4096):
        return 74
    var sawStructural: bool
    for ordinal in 0..<structuralPlan.actions.len:
        var action: alloc.RegallocValueAction
        var ticket: alloc.RegallocValueActionTicket
        if !alloc.RegallocSinglePassValuePlanActionAt(
               structuralPlan, ordinal, action, ticket):
            return 75
        if alloc.RegallocSinglePassValueActionBindingKind(action.kind) ==
           alloc.RegallocValueBindingStructural:
            sawStructural = true
            if alloc.RegallocSinglePassValuePlanAck(
                   structuralPlan, ticket,
                   4800 + ordinal * 4, 4, proofHash()) ||
               structuralPlan.valid ||
               structuralPlan.errorCode !=
                   alloc.RegallocValuePlanErrorEmissionShape:
                return 76
            break
        if !ackAction(structuralPlan, action, ticket,
                      4800 + ordinal * 4):
            return 77
    if !sawStructural:
        return 78
    return 0

fn checkByteRangeFails(): int32 =
    var body = buildTenArgCall(true)
    var plan = buildPlan(body)
    if !plan.valid || !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, "bad_range", 400, 16):
        return 51
    var action: alloc.RegallocValueAction
    var ticket: alloc.RegallocValueActionTicket
    if !alloc.RegallocSinglePassValuePlanActionAt(
           plan, 0, action, ticket):
        return 52
    if alloc.RegallocSinglePassValuePlanAck(
           plan, ticket, 416, 4, proofHash()) || plan.valid ||
       plan.errorCode != alloc.RegallocValuePlanErrorEmissionShape:
        return 53
    return 0

fn checkOverlappingEvidenceFails(): int32 =
    var body = buildTenArgCall(true)
    var plan = buildPlan(body)
    if !plan.valid || plan.actions.len < 2 ||
       !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, "overlap", 448, 64):
        return 54
    var action0: alloc.RegallocValueAction
    var ticket0: alloc.RegallocValueActionTicket
    if !alloc.RegallocSinglePassValuePlanActionAt(
           plan, 0, action0, ticket0) ||
       !alloc.RegallocSinglePassValuePlanAck(
           plan, ticket0, 448, 4, proofHash()):
        return 55
    var action1: alloc.RegallocValueAction
    var ticket1: alloc.RegallocValueActionTicket
    if !alloc.RegallocSinglePassValuePlanActionAt(
           plan, 1, action1, ticket1):
        return 56
    if alloc.RegallocSinglePassValuePlanAck(
           plan, ticket1, 448, 4, proofHash()) || plan.valid ||
       plan.errorCode != alloc.RegallocValuePlanErrorEmissionShape:
        return 57
    return 0

fn checkReceipt(): int32 =
    var body = buildTenArgCall(true)
    var plan = buildPlan(body)
    if !plan.valid || plan.constraints.registerUniverse.len != 31 ||
       plan.constraints.fixedSretReg != 8 ||
       plan.constraints.fixedArgRegs.len != 8:
        return 61
    if !alloc.RegallocSinglePassValuePlanBeginEmissionSymbol(
           plan, "proved_symbol", 500, 4096):
        return 61
    for ordinal in 0..<plan.actions.len:
        var action: alloc.RegallocValueAction
        var ticket: alloc.RegallocValueActionTicket
        let emittedByteStart = 500 + ordinal * 4
        if !alloc.RegallocSinglePassValuePlanActionAt(
               plan, ordinal, action, ticket) ||
           !ackAction(plan, action, ticket, emittedByteStart):
            return 62
    if !alloc.RegallocSinglePassValuePlanSealEmissionSymbol(
           plan, proofHash()) ||
       !alloc.RegallocSinglePassValuePlanFinalize(plan):
        return 63
    var receipt: alloc.RegallocValueEmissionReceipt
    if !alloc.RegallocSinglePassValuePlanReceipt(plan, receipt) ||
       !receipt.valid || receipt.symbolName != "proved_symbol" ||
       receipt.symbolByteStart != 500 || receipt.symbolByteLength != 4096 ||
       receipt.symbolBytesSha256 != proofHash() ||
       receipt.actionCount != plan.actions.len ||
       receipt.actionEmissions.len != plan.actions.len ||
       len(receipt.frozenSemanticSha256) != 64 ||
       len(receipt.actionSemanticRootSha256) != 64 ||
       len(receipt.actionBindingRootSha256) != 64 ||
       len(receipt.receiptSha256) != 64 ||
       receipt.frozenSemanticSha256 != plan.frozenSemanticSha256 ||
       receipt.actionSemanticRootSha256 !=
           plan.actionSemanticRootSha256 ||
       receipt.actionBindingRootSha256 !=
           plan.actionBindingRootSha256 ||
       receipt.receiptSha256 != plan.sealedReceiptSha256:
        return 64
    for ordinal in 0..<receipt.actionEmissions.len:
        let emission = receipt.actionEmissions[ordinal]
        let bindingKind =
            alloc.RegallocSinglePassValueActionBindingKind(
                plan.actions[ordinal].kind)
        if emission.consumerOrdinal != ordinal ||
           emission.actionKind != plan.actions[ordinal].kind ||
           emission.actionPosition != plan.actions[ordinal].position ||
           emission.bindingKind != bindingKind ||
           emission.ownerPlanSha256 != plan.frozenSemanticSha256 ||
           len(emission.actionSemanticSha256) != 64 ||
           len(emission.bindingSha256) != 64:
            return 65
        if bindingKind == alloc.RegallocValueBindingStructural:
            if emission.emittedByteStart != 0 ||
               emission.emittedByteLength != 0 ||
               emission.emittedBytesSha256 != emptyProofHash():
                return 66
        elif emission.emittedByteStart != 500 + ordinal * 4 ||
             emission.emittedByteLength != 4 ||
             emission.emittedBytesSha256 != proofHash():
            return 67
    return 0

fn main(): int32 =
    let abiCode = checkAbiFactsAndActions()
    if abiCode != 0:
        return abiCode
    let missingCode = checkMissingActionAtFails()
    if missingCode != 0:
        return missingCode
    let deadCode = checkDeadConsumerFails()
    if deadCode != 0:
        return deadCode
    let forgedCode = checkForgedTicketFails()
    if forgedCode != 0:
        return forgedCode
    let semanticCode = checkSemanticRootTamperFails()
    if semanticCode != 0:
        return semanticCode
    let rangeCode = checkByteRangeFails()
    if rangeCode != 0:
        return rangeCode
    let overlapCode = checkOverlappingEvidenceFails()
    if overlapCode != 0:
        return overlapCode
    let bindingCode = checkBindingKinds()
    if bindingCode != 0:
        return bindingCode
    return checkReceipt()
