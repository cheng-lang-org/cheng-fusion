import std/seqs

type
    ColdExactReleaseInner =
        values: str[]
        counts: int32[]
        preserved: str[]

    ColdExactReleaseOwner = ref object
        inner: ColdExactReleaseInner
        texts: str[]

fn ColdExactReleaseInnerStorage(
        owner: var ColdExactReleaseOwner): int32 =
    seqs.freeSeqStrRelease(owner.inner.values)
    seqs.chengSeqFreeTyped(owner.inner.counts)
    if owner.inner.values.len != 0 ||
       owner.inner.values.cap != 0 ||
       owner.inner.counts.len != 0 ||
       owner.inner.counts.cap != 0:
        return 11
    if owner.inner.preserved.len != 1 ||
       owner.inner.preserved[0] != "preserved":
        return 12
    seqs.freeSeqStrRelease(owner.inner.preserved)
    return 0

fn ColdExactReleaseOwned(
        owner: var ColdExactReleaseOwner): int32 =
    let innerStatus = ColdExactReleaseInnerStorage(owner)
    if innerStatus != 0:
        return innerStatus
    seqs.freeSeqStrRelease(owner.texts)
    if owner.texts.len != 0 ||
       owner.texts.cap != 0:
        return 13
    return 0

fn main(): int32 =
    var owner = new(ColdExactReleaseOwner)
    add(owner.inner.values, "nested")
    add(owner.inner.counts, 7)
    add(owner.inner.preserved, "preserved")
    add(owner.texts, "root")
    return ColdExactReleaseOwned(owner)
