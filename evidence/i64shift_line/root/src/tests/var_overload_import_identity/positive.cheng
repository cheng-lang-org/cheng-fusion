import src/tests/var_overload_import_identity/overloads
import src/tests/var_overload_import_identity/overloads as mirror

fn main(): int32 =
    var valueBox: overloads.OverloadBox
    valueBox.value = 7
    if overloads.OverloadValueLiteral(valueBox) != 1101:
        return 1
    if valueBox.value != 7:
        return 2

    if overloads.OverloadVarLiteral(valueBox) != 2202:
        return 3
    if valueBox.value != 2202:
        return 4

    var directBox: overloads.OverloadBox
    directBox.value = 13
    let typedKey: str = "typed-key"
    if overloads.OverloadSelect(directBox, typedKey) != 1101:
        return 5
    if directBox.value != 13:
        return 6
    if mirror.OverloadSelect(directBox, "literal-key") != 1101:
        return 7
    if directBox.value != 13:
        return 8

    var aliasBox: mirror.OverloadBox
    aliasBox.value = 17
    if mirror.OverloadVarLiteral(aliasBox) != 2202:
        return 9
    if aliasBox.value != 2202:
        return 10

    var bareBox: overloads.OverloadBox
    bareBox.value = 19
    if OverloadSelect(bareBox, "bare-literal") != 1101:
        return 11
    if bareBox.value != 19:
        return 12

    if overloads.ExactId[int32](31) != 31:
        return 13
    if mirror.ExactId[int32](37) != 37:
        return 14

    echo("var_overload_import_identity_positive ok")
    return 0
