type
    OverloadBox =
        value: int32

fn OverloadSelect(box: OverloadBox, key: str): int32 =
    if len(key) == 0:
        return -1
    return 1101

fn OverloadSelect(box: var OverloadBox, key: str): int32 =
    if len(key) == 0:
        return -1
    box.value = 2202
    return 2202

fn OverloadValueLiteral(box: OverloadBox): int32 =
    return OverloadSelect(box, "value-literal")

fn OverloadVarLiteral(box: var OverloadBox): int32 =
    return OverloadSelect(box, "var-literal")

fn ExactId[T](value: T): T =
    return value
