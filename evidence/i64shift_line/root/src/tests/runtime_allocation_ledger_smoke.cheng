import std/system as system
import std/rawbytes as rawbytes
import cheng/core/runtime/arena as arenamod

fn LedgerCidNonZero(value: system.RuntimeAllocationLedgerCid): bool =
    return value.word0 != uint64(0) || value.word1 != uint64(0) ||
           value.word2 != uint64(0) || value.word3 != uint64(0)

fn LedgerCidEqual(
        left: system.RuntimeAllocationLedgerCid,
        right: system.RuntimeAllocationLedgerCid): bool =
    return left.word0 == right.word0 && left.word1 == right.word1 &&
           left.word2 == right.word2 && left.word3 == right.word3

fn LedgerGoldenReceiptWire(): system.RuntimeAllocationLedgerReceiptWire =
    var wire: system.RuntimeAllocationLedgerReceiptWire
    wire.abiMagic = uint64(0x43484c4452435054)
    wire.abiByteSize = uint64(384)
    wire.complete = 1
    wire.closed = 1
    wire.operation = 8
    wire.rawManagedPointerAbaProven = 1
    wire.recursiveLockProven = 1
    wire.capabilityGeneration = uint64(1)
    wire.allocationId = uint64(2)
    wire.ownerGeneration = uint64(3)
    wire.allocationGeneration = uint64(4)
    wire.slabId = uint64(5)
    wire.slabGeneration = uint64(6)
    wire.slabBackingBytes = uint64(7)
    wire.backingDeltaBytes = uint64(8)
    wire.reallocOverlapUsableBytes = uint64(9)
    wire.requestedPayloadBytes = uint64(10)
    wire.usablePayloadBytes = uint64(11)
    wire.headerBytes = uint64(12)
    wire.backingBytes = uint64(13)
    wire.alignmentBytes = uint64(14)
    wire.layout0 = uint64(15)
    wire.layout1 = uint64(16)
    wire.layout2 = uint64(17)
    wire.layout3 = uint64(18)
    wire.ownerDomain0 = uint64(19)
    wire.ownerDomain1 = uint64(20)
    wire.ownerDomain2 = uint64(21)
    wire.ownerDomain3 = uint64(22)
    wire.eventChain0 = uint64(23)
    wire.eventChain1 = uint64(24)
    wire.eventChain2 = uint64(25)
    wire.eventChain3 = uint64(26)
    wire.backingLimit = uint64(27)
    wire.controlPlaneBackingBytes = uint64(28)
    wire.liveBackingBytes = uint64(29)
    wire.peakBackingBytes = uint64(30)
    wire.liveMappedVirtualBytes = uint64(31)
    wire.peakMappedVirtualBytes = uint64(32)
    wire.liveAllocationCount = uint64(33)
    wire.peakAllocationCount = uint64(34)
    wire.liveMappingCount = uint64(35)
    wire.liveHandleCount = uint64(36)
    wire.peakHandleCount = uint64(37)
    wire.eventIndex = uint64(38)
    return wire

fn main(): int32 =
    let goldenWire = LedgerGoldenReceiptWire()
    var goldenCid: system.RuntimeAllocationLedgerCid
    assert(system.RuntimeAllocationLedgerReceiptCidRecompute(
               goldenWire, goldenCid),
           " allocation ledger: independent receipt cid recompute")
    assert(goldenCid.word0 ==
               ((uint64(0xc5b27d6b) << uint64(32)) |
                uint64(0x0a5a30ee)) &&
           goldenCid.word1 ==
               ((uint64(0xf43fa282) << uint64(32)) |
                uint64(0xe106b581)) &&
           goldenCid.word2 ==
               ((uint64(0xc8efe857) << uint64(32)) |
                uint64(0x6c44827e)) &&
           goldenCid.word3 ==
               ((uint64(0x169e3340) << uint64(32)) |
                uint64(0x65428b3b)),
           " allocation ledger: independent receipt cid golden")
    var rootOnlyMutation = goldenWire
    rootOnlyMutation.receipt0 = uint64(1)
    var rootOnlyCid: system.RuntimeAllocationLedgerCid
    assert(system.RuntimeAllocationLedgerReceiptCidRecompute(
               rootOnlyMutation, rootOnlyCid) &&
           LedgerCidEqual(rootOnlyCid, goldenCid),
           " allocation ledger: receipt root excluded from preimage")
    var eventMutation = goldenWire
    eventMutation.eventIndex = uint64(39)
    var eventMutationCid: system.RuntimeAllocationLedgerCid
    assert(system.RuntimeAllocationLedgerReceiptCidRecompute(
               eventMutation, eventMutationCid) &&
           !LedgerCidEqual(eventMutationCid, goldenCid),
           " allocation ledger: receipt field mutation changes cid")

    assert(system.RuntimeAllocationLedgerSupported(),
           " allocation ledger: main provider unsupported")
    let opened = system.RuntimeAllocationLedgerBegin(
        "cheng.runtime.allocation_ledger.smoke",
        uint64(268435456))
    assert(opened.ok, opened.error)

    let initial = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(initial.ok && !initial.receipt.complete &&
           initial.receipt.active &&
           !initial.receipt.closed,
           " allocation ledger: initial receipt")
    assert(initial.receipt.operation ==
               system.RuntimeAllocationLedgerOpBegin &&
           initial.receipt.controlPlaneBackingBytes > uint64(0) &&
           initial.receipt.liveBackingBytes ==
               initial.receipt.controlPlaneBackingBytes &&
           initial.receipt.peakBackingBytes ==
               initial.receipt.controlPlaneBackingBytes,
           " allocation ledger: fixed control plane")
    assert(LedgerCidNonZero(initial.receipt.allocatorLayoutCid) &&
           LedgerCidNonZero(initial.receipt.ownerDomainCid) &&
           LedgerCidNonZero(initial.receipt.eventChainCid) &&
           initial.receipt.capabilityGeneration ==
               opened.owner.generation &&
           initial.receipt.backingLimit == uint64(268435456) &&
           initial.receipt.liveHandleCount == uint64(0) &&
           initial.receipt.peakHandleCount == uint64(0) &&
           !initial.receipt.rawManagedPointerAbaProven &&
           !initial.receipt.recursiveLockProven &&
           LedgerCidNonZero(initial.receipt.receiptCid),
           " allocation ledger: initial cid")
    let initialRepeat =
        system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(initialRepeat.ok &&
           initialRepeat.receipt.eventIndex == initial.receipt.eventIndex &&
           LedgerCidEqual(
               initialRepeat.receipt.receiptCid,
               initial.receipt.receiptCid),
           " allocation ledger: receipt recompute has no observer event")
    let nested = system.RuntimeAllocationLedgerBegin(
        "cheng.runtime.allocation_ledger.nested",
        uint64(268435456))
    assert(!nested.ok &&
           nested.error ==
               "allocation_ledger_process_owner_already_active",
           " allocation ledger: process owner exclusivity")

    var tinyA = rawbytes.BytesAlloc(1)
    let tinyFirst = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(tinyFirst.ok && tinyFirst.receipt.storageKind ==
               system.RuntimeAllocationLedgerStorageSlab &&
           tinyFirst.receipt.slabId != uint64(0) &&
           tinyFirst.receipt.slabGeneration != uint64(0) &&
           tinyFirst.receipt.slabBackingBytes == uint64(65536) &&
           tinyFirst.receipt.backingBytes == uint64(0) &&
           tinyFirst.receipt.backingDeltaBytes == uint64(65536) &&
           tinyFirst.receipt.headerBytes == uint64(32),
           " allocation ledger: first tiny slab allocation")
    var tinyB = rawbytes.BytesAlloc(1)
    let tinyReuse = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(tinyReuse.ok &&
           tinyReuse.receipt.slabId == tinyFirst.receipt.slabId &&
           tinyReuse.receipt.slabGeneration ==
               tinyFirst.receipt.slabGeneration &&
           tinyReuse.receipt.backingDeltaBytes == uint64(0) &&
           tinyReuse.receipt.liveBackingBytes ==
               tinyFirst.receipt.liveBackingBytes,
           " allocation ledger: slab backing charged once")
    rawbytes.BytesFree(tinyB)
    rawbytes.BytesFree(tinyA)

    var bytes = rawbytes.BytesAlloc(4096)
    let allocated = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(allocated.ok && allocated.receipt.operation ==
               system.RuntimeAllocationLedgerOpMalloc &&
           allocated.receipt.requestedPayloadBytes == uint64(4096) &&
           allocated.receipt.usablePayloadBytes >= uint64(4096) &&
           allocated.receipt.headerBytes == uint64(32) &&
           allocated.receipt.slabBackingBytes == uint64(65536) &&
           allocated.receipt.backingBytes == uint64(0) &&
           allocated.receipt.alignmentBytes == uint64(16) &&
           allocated.receipt.liveAllocationCount == uint64(1),
           " allocation ledger: exact malloc receipt")

    var arena = arenamod.ArenaInit(64)
    let arenaInitial = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(arenaInitial.ok && arenaInitial.receipt.operation ==
               system.RuntimeAllocationLedgerOpMalloc &&
           arenaInitial.receipt.liveAllocationCount == uint64(2),
           " allocation ledger: arena malloc")
    let region = arenamod.ArenaAlloc(arena, 4096)
    assert(region.len == 4096,
           " allocation ledger: arena allocation")
    let resized = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(resized.ok && resized.receipt.operation ==
               system.RuntimeAllocationLedgerOpRealloc &&
           resized.receipt.liveAllocationCount == uint64(2) &&
           resized.receipt.peakAllocationCount >
               resized.receipt.liveAllocationCount &&
           resized.receipt.reallocOverlapUsableBytes > uint64(0),
           " allocation ledger: realloc overlap peak")
    arenamod.ArenaRelease(arena)
    rawbytes.BytesFree(bytes)
    let drained = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(drained.ok && drained.receipt.operation ==
               system.RuntimeAllocationLedgerOpFree &&
           drained.receipt.liveAllocationCount == uint64(0) &&
           drained.receipt.liveBackingBytes ==
               drained.receipt.controlPlaneBackingBytes &&
           drained.receipt.liveMappedVirtualBytes == uint64(0) &&
           drained.receipt.liveMappingCount == uint64(0),
           " allocation ledger: drained owner")

    let closed = system.RuntimeAllocationLedgerClose(opened.owner)
    assert(closed.ok &&
           closed.receipt.complete &&
           !closed.receipt.active &&
           closed.receipt.closed && closed.receipt.operation ==
               system.RuntimeAllocationLedgerOpClose &&
           closed.receipt.capabilityGeneration ==
               opened.owner.generation &&
           closed.receipt.liveHandleCount == uint64(0) &&
           closed.receipt.peakHandleCount == uint64(0) &&
           closed.receipt.liveBackingBytes ==
               closed.receipt.controlPlaneBackingBytes &&
           LedgerCidNonZero(closed.receipt.ownerDomainCid) &&
           LedgerCidNonZero(closed.receipt.eventChainCid) &&
           closed.receipt.rawManagedPointerAbaProven &&
           closed.receipt.recursiveLockProven &&
           LedgerCidNonZero(closed.receipt.receiptCid),
           " allocation ledger: close receipt")
    let stale = system.RuntimeAllocationLedgerSnapshot(opened.owner)
    assert(!stale.ok &&
           stale.error == "allocation_ledger_stale_owner_generation",
           " allocation ledger: closed owner is stale")
    return 0
