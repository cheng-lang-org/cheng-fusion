import std/os
import std/strings

fn main(): int32 =
    let root = os.GetCurrentDir()
    let sourcePath = os.JoinPath(root, "src/libp2p/mobile_ffi/unimaker_compat_ffi.cheng")
    let sourceText = os.ReadFile(sourcePath)

    assert(strings.StrContains(sourceText, "socialPublishMetadataTopic = \"unimaker/social/publish/v1\""),
           " unimaker mobile publish broadcast: metadata topic")
    assert(strings.StrContains(sourceText, "fn publish") &&
           strings.StrContains(sourceText, "SocialMetadata") &&
           strings.StrContains(sourceText, "handle: int64, taskJson: str): int32"),
           " unimaker mobile publish broadcast: helper exists")
    assert(strings.StrContains(sourceText, "libp2p_") &&
           strings.StrContains(sourceText, "pubsub_") &&
           strings.StrContains(sourceText, "_publish"),
           " unimaker mobile publish broadcast: uses pubsub publish")
    assert(strings.StrContains(sourceText, "let publishRc: int32 = publish") &&
           strings.StrContains(sourceText, "SocialMetadata") &&
           strings.StrContains(sourceText, "handle, taskJson)"),
           " unimaker mobile publish broadcast: enqueue calls metadata publish")
    assert(strings.StrContains(sourceText, "if publishRc != resultOk:"),
           " unimaker mobile publish broadcast: publish failure hard fails")
    assert(strings.StrContains(sourceText, "metadata_broadcast_failed"),
           " unimaker mobile publish broadcast: failure is observable")
    assert(strings.StrContains(sourceText, "publishState") &&
           strings.StrContains(sourceText, "published"),
           " unimaker mobile publish broadcast: successful state is published")
    assert(strings.StrContains(sourceText, "publishContentIds: str[]") &&
           strings.StrContains(sourceText, "node.publishContentIds = []"),
           " unimaker mobile publish broadcast: content id index exists")
    assert(strings.StrContains(sourceText, "fn storePublishTask(node: var NodeRuntime, taskId: str, contentId: str, taskJson: str)") &&
           strings.StrContains(sourceText, "add(node.publishContentIds, contentId)") &&
           strings.StrContains(sourceText, "node.publishContentIds = nextContentIds"),
           " unimaker mobile publish broadcast: content id stored with task")
    assert(strings.StrContains(sourceText, "if i < len(node.publishContentIds) && node.publishContentIds[i] == target:") &&
           strings.StrContains(sourceText, "storePublishTask(*node, taskId, contentId, taskJson)"),
           " unimaker mobile publish broadcast: content detail can resolve content id")
    assert(strings.StrContains(sourceText, "fn storeReceivedSocialPublishMetadata") &&
           strings.StrContains(sourceText, "json.ParseJsonSafe") &&
           strings.StrContains(sourceText, "JsonTryGetStr(parsed.value, \"taskId\", taskId)") &&
           strings.StrContains(sourceText, "JsonTryGetStr(parsed.value, \"contentId\", contentId)"),
           " unimaker mobile publish broadcast: received metadata uses structured json")
    assert(strings.StrContains(sourceText, "findPublishTaskJson(node, taskId)") &&
           strings.StrContains(sourceText, "findPublishTaskJson(node, contentId)"),
           " unimaker mobile publish broadcast: received metadata dedupes")
    assert(strings.StrContains(sourceText, "fn social_feed_snapshot_cstr(handle: int64, channelPtr: void*, cursorPtr: void*, limit: int32): cstring") &&
           strings.StrContains(sourceText, "let _ = drainInboundGossipMessages(*node)\n    let feedText: str = feedSnapshotJson(*node)"),
           " unimaker mobile publish broadcast: social feed snapshot drains inbound metadata before serializing")
    assert(strings.StrContains(sourceText, "social_publish_subscribe_cstr") &&
           strings.StrContains(sourceText, "um_hostGossipsubSubscribe(socialPublishMetadataTopic)") &&
           strings.StrContains(sourceText, "social.publish.subscribe"),
           " unimaker mobile publish broadcast: publish metadata topic subscribed")
    assert(strings.StrContains(sourceText, "social_publish_receive_metadata_cstr") &&
           strings.StrContains(sourceText, "storeReceivedSocialPublishMetadata(*node, payloadJson)") &&
           strings.StrContains(sourceText, "social.publish.receive"),
           " unimaker mobile publish broadcast: received metadata stored")
    assert(!strings.StrContains(sourceText, ",\"publishState\":\"queued\""),
           " unimaker mobile publish broadcast: no queued fake success")
    assert(strings.StrContains(sourceText, "social.publish.broadcast"),
           " unimaker mobile publish broadcast: event is broadcast")

    echo(" unimaker_mobile_publish_broadcast_contract_smoke ok")
    return 0
