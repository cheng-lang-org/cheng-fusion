import std/cmdline as cmdline
import std/os as os
import std/os_host_process as hostos
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as primary
import cheng/core/ir/core_types as ir
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/std/bytes_layout as layout

fn deferTransport(): lower.LoweringDeferScopeTransportSoA =
    var transport: lower.LoweringDeferScopeTransportSoA
    transport.typedFunctionIndex = 0
    transport.sourceStatementStart = 0
    transport.sourceStatementCount = 2
    transport.sourceScopeStart = 0
    transport.sourceScopeCount = 3
    transport.scopeIds = [0, 1, 2]
    transport.scopeParentIds = [-1, 0, 1]
    transport.scopeKinds = [
        parser.NormalizedScopeRoot,
        parser.NormalizedScopeIndentedSuite,
        parser.NormalizedScopeDeferSuite]
    transport.scopeOwnerStatementOrdinals = [-1, -1, 2]
    transport.scopeLexicalOrdinals = [0, 0, 0]
    transport.scopeStartLineNumbers = [1, 2, 3]
    transport.scopeStartColumnNumbers = [1, 5, 9]
    transport.scopeEndLineNumbers = [6, 5, 4]
    transport.scopeEndColumnNumbers = [20, 20, 20]
    transport.statementIndexes = [0, 1]
    transport.statementKinds = [
        texpr.TypedExprIrStmtDefer,
        texpr.TypedExprIrStmtLocalDecl]
    transport.statementLineNumbers = [3, 4]
    transport.statementColumnNumbers = [5, 9]
    transport.statementEndLineNumbers = [3, 4]
    transport.statementEndColumnNumbers = [20, 20]
    transport.statementLexicalScopeIds = [1, 2]
    transport.statementSuiteScopeIds = [2, -1]
    transport.statementOrdinals = [2, 3]
    transport.statementLexicalOrdinals = [0, 0]
    transport.statementDeferOwnerStatementOrdinals = [-1, 2]
    transport.complete = true
    return transport

fn deferHeader(): lower.PrimaryObjectIrStatement =
    var stmt: lower.PrimaryObjectIrStatement
    stmt.statementIndex = 0
    stmt.lexicalScopeId = 1
    stmt.suiteScopeId = 2
    stmt.statementOrdinal = 2
    stmt.lexicalOrdinal = 0
    stmt.deferOwnerStatementOrdinal = -1
    stmt.kind = texpr.TypedExprIrStmtDefer
    return stmt

fn runDetachedActionProducerPositive() =
    let transport = deferTransport()
    var bodyIR = ir.BodyIRNew()
    let typeArenaCid = layout.FixedBytes32FromHex(
        "7171717171717171717171717171717171717171717171717171717171717171")
    assert(typeArenaCid.ok &&
           ir.BodyIRBindTypeArenaArtifactCid(
               bodyIR, typeArenaCid.value),
           "detached action TypeArena CID")
    lower.LoweringBodyIrControlBegin(bodyIR, transport, 0)
    var currentBlockStart: int32
    var skipTermIndex: int32
    primary.PrimaryBodyIrControlBeginDeferAction(
        bodyIR,
        transport,
        deferHeader(),
        currentBlockStart,
        skipTermIndex)
    primary.PrimaryBodyIrControlFinishDeferAction(
        bodyIR, 2, skipTermIndex, currentBlockStart)
    var continuationReturn: ir.BodyTerm
    continuationReturn.kind = ir.BodyTermReturnTag
    continuationReturn.resultSlot = -1
    continuationReturn.lhsSlot = -1
    continuationReturn.rhsSlot = -1
    continuationReturn.trueBlock = -1
    continuationReturn.falseBlock = -1
    let continuationTermIndex =
        ir.BodyIRAppendTerm(bodyIR, continuationReturn)
    let _ = ir.BodyIRAppendBlock(
        bodyIR, currentBlockStart, 0, continuationTermIndex)
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, 1)
    var breakTerms: int32[]
    var continueTerms: int32[]
    var loopBackTerms: int32[]
    lower.LoweringBodyIrControlSeal(
        bodyIR,
        transport,
        breakTerms,
        continueTerms,
        loopBackTerms)
    let actionCid =
        ir.BodyIRControlFlowDeferActionCid(bodyIR, 0)
    assert(ir.BodyIRControlFlowShapeValid(bodyIR) &&
           bodyIR.deferDeclarationScopeIds.len == 1 &&
           bodyIR.deferFunctionRows[0] == 0 &&
           bodyIR.deferStatementRows[0] == 0 &&
           layout.FixedBytes32Equal(
               bodyIR.deferActionCids[0], actionCid) &&
           ir.BodyIRTypeArenaArtifactCidValid(actionCid) &&
           bodyIR.deferActivationRows.len == 1 &&
           bodyIR.deferActivationRows[0] == 0 &&
           bodyIR.terms[skipTermIndex].trueBlock == 2,
           "detached action producer shape")

fn runDetachedActionProducerMissingNegative() =
    let transport = deferTransport()
    var bodyIR = ir.BodyIRNew()
    let typeArenaCid = layout.FixedBytes32FromHex(
        "7171717171717171717171717171717171717171717171717171717171717171")
    assert(typeArenaCid.ok &&
           ir.BodyIRBindTypeArenaArtifactCid(
               bodyIR, typeArenaCid.value),
           "missing detached action TypeArena CID")
    lower.LoweringBodyIrControlBegin(bodyIR, transport, 0)
    var returnTerm: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(returnTerm)
    returnTerm.kind = ir.BodyTermReturnTag
    let returnTermIndex =
        ir.BodyIRAppendTerm(bodyIR, returnTerm)
    let _ = ir.BodyIRAppendBlock(
        bodyIR, 0, 0, returnTermIndex)
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, 1)
    var breakTerms: int32[]
    var continueTerms: int32[]
    var loopBackTerms: int32[]
    lower.LoweringBodyIrControlSeal(
        bodyIR,
        transport,
        breakTerms,
        continueTerms,
        loopBackTerms)

fn runDetachedActionBlockMissingNegative() =
    let transport = deferTransport()
    var bodyIR = ir.BodyIRNew()
    let typeArenaCid = layout.FixedBytes32FromHex(
        "7171717171717171717171717171717171717171717171717171717171717171")
    assert(typeArenaCid.ok &&
           ir.BodyIRBindTypeArenaArtifactCid(
               bodyIR, typeArenaCid.value),
           "detached action block TypeArena CID")
    lower.LoweringBodyIrControlBegin(bodyIR, transport, 0)
    var returnTerm: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(returnTerm)
    returnTerm.kind = ir.BodyTermReturnTag
    let returnTermIndex =
        ir.BodyIRAppendTerm(bodyIR, returnTerm)
    let declarationBlockId =
        ir.BodyIRAppendBlock(bodyIR, 0, 0, returnTermIndex)
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, 1)
    let _ = lower.LoweringBodyIrControlBindDeferAction(
        bodyIR, transport, 0, declarationBlockId, 0)
    var breakTerms: int32[]
    var continueTerms: int32[]
    var loopBackTerms: int32[]
    lower.LoweringBodyIrControlSeal(
        bodyIR,
        transport,
        breakTerms,
        continueTerms,
        loopBackTerms)

fn runForbiddenActionNegative(
        kind: texpr.TypedExprIrStatementKind) =
    var stmt: lower.PrimaryObjectIrStatement
    stmt.statementIndex = 1
    stmt.lexicalScopeId = 2
    stmt.statementOrdinal = 3
    stmt.lexicalOrdinal = 0
    stmt.deferOwnerStatementOrdinal = 2
    stmt.kind = kind
    primary.PrimaryBodyIrControlValidateDeferActionStatement(
        deferTransport(), stmt, 2, 2)

fn runMissingCallTargetTypedFunctionIndexNegative() =
    var lowering: lower.LoweringPlanStub
    lowering.snapshotCallIdByTypedIrNodeIndex = [0]
    lowering.snapshotCallTargetTypedFunctionIndexes = [-1]
    var bodyIR = ir.BodyIRNew()
    lower.LoweringBodyIrControlBegin(
        bodyIR, deferTransport(), 0)
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    add(bodyIR.callSequence, call)
    primary.PrimaryBodyIrControlBindCanonicalCallTarget(
        bodyIR, lowering, 0, 0)

fn requireHardFail(mode: str, diagnostic: str) =
    let result = hostos.ExecFileCapture(cmdline.ParamStr(0),
                                         [mode],
                                         [],
                                         "",
                                         true,
                                         60)
    assert(os.ExecCmdResultExitCode(result) != 0 &&
           strutil.Contains(os.ExecCmdResultOutput(result),
                            diagnostic),
           "detached action hard-fail")

fn main(): int32 =
    let mode = cmdline.ParamStr(1)
    if mode == "nested-defer":
        runForbiddenActionNegative(texpr.TypedExprIrStmtDefer)
        return 91
    if mode == "defer-return":
        runForbiddenActionNegative(texpr.TypedExprIrStmtReturn)
        return 92
    if mode == "defer-break":
        runForbiddenActionNegative(texpr.TypedExprIrStmtBreak)
        return 93
    if mode == "defer-continue":
        runForbiddenActionNegative(texpr.TypedExprIrStmtContinue)
        return 94
    if mode == "missing-call-target-typed-index":
        runMissingCallTargetTypedFunctionIndexNegative()
        return 95
    if mode == "missing-defer-producer":
        runDetachedActionProducerMissingNegative()
        return 96
    if mode == "missing-defer-action-block":
        runDetachedActionBlockMissingNegative()
        return 97
    let flags: int32[] = [0, 1]
    var internalBody = ir.BodyIRNew()
    internalBody.entryIsCAbi = true
    var exportedBody = ir.BodyIRNew()
    var missingBody = ir.BodyIRNew()
    missingBody.entryIsCAbi = true
    if !primary.PrimaryBodyIrApplyEntryAbiProvenance(internalBody, flags, 0) ||
       internalBody.entryIsCAbi:
        return 1
    if !primary.PrimaryBodyIrApplyEntryAbiProvenance(exportedBody, flags, 1) ||
       !exportedBody.entryIsCAbi:
        return 2
    if primary.PrimaryBodyIrApplyEntryAbiProvenance(missingBody, flags, 2) ||
       !missingBody.entryIsCAbi:
        return 3
    runDetachedActionProducerPositive()
    requireHardFail("nested-defer", "forbidden defer action exit")
    requireHardFail("defer-return", "forbidden defer action exit")
    requireHardFail("defer-break", "forbidden defer action exit")
    requireHardFail("defer-continue", "forbidden defer action exit")
    requireHardFail("missing-call-target-typed-index",
                    "canonical call target identity missing")
    requireHardFail("missing-defer-producer",
                    "detached defer action producer missing")
    requireHardFail("missing-defer-action-block",
                    "detached defer action producer missing")
    echo("primary_body_ir_entry_origin_contract_smoke ok")
    return 0
