import cheng/core/lang/parser

const FixturePath = "/fixture/parser_explicit_generic_call.cheng"

fn countGenericValueCalls(layer: var parser.NormalizedExprLayer): int32 =
    var count: int32
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.kind == parser.NormalizedExprCall &&
           expr.callCallee == "genericValue" &&
           expr.callArgsText == "p" && expr.callArgCount == 1:
            count = count + 1
    return count

fn main(): int32 =
    assert(parser.ParserCallOpenParenAfterName("f[uint8](x)", 1) == 8,
           "explicit generic call parenthesis")
    assert(parser.ParserCallOpenParenAfterName("f[Result[uint8]](x)", 1) == 16,
           "nested explicit generic call parenthesis")
    assert(parser.ParserCallOpenParenAfterName("f[](x)", 1) == -1,
           "empty explicit generic argument must fail")

    let sourceText = "fn genericValue(p: ptr): T =\n    var out: T\n    return out\n\nfn Probe(p: ptr): uint8 =\n    return genericValue[uint8](p)\n"
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(FixturePath,
                                                         sourceText,
                                                         layer,
                                                         err),
           err)
    assert(countGenericValueCalls(layer) == 1,
           "explicit generic call must have one canonical call fact")
    assert(parser.ParserMaxQualifiedCallDepth(
               "fn Probe(p: ptr): uint8 =\n    return pkg.genericValue[uint8](p)\n") == 1,
           "qualified explicit generic call depth")
    parser.NormalizedExprLayerReset(layer)
    echo("parser_explicit_generic_call_contract_smoke ok")
    return 0
