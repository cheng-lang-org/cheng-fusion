import std/system
import std/hashmaps as hashmaps

type
    ReproBox3 = ref object
        m: hashmaps.HashMapStrInt

@borrows
fn reproDetach3(b: ReproBox3, index: var hashmaps.HashMapStrInt) =
    var wrapper = b.m
    b.m = hashmaps.HashMapStrInt()
    var keys = wrapper.keys
    wrapper.keys = []
    index.keys = keys
    var vals = wrapper.vals
    wrapper.vals = []
    index.vals = vals
    var hashes = wrapper.hashes
    wrapper.hashes = []
    index.hashes = hashes
    var states = wrapper.states
    wrapper.states = []
    index.states = states
    index.mask = wrapper.mask
    index.used = wrapper.used

@borrows
fn reproRoundtrip3(b: ReproBox3) =
    var index: hashmaps.HashMapStrInt
    reproDetach3(b, index)
    b.m = index

fn main() =
    var b: ReproBox3 = new(ReproBox3)
    hashmaps.HashMapStrIntInitInPlace(b.m, 64)
    reproRoundtrip3(b)
    echo("repro_orc_boxfield_c3 ok")
