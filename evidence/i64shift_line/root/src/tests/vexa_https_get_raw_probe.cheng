import std/os as os
import std/strings

@importc("calloc")
fn httpsGetRawProbeCalloc(count: int64, size: int64): ptr

@importc("memcpy")
fn httpsGetRawProbeMemcpy(dst: ptr, src: ptr, count: int64): ptr

@importc("strlen")
fn httpsGetRawProbeStrlen(raw: ptr): int64

@importc("cheng_http_request_with_timeout")
fn httpsGetRawProbeHttpRequestWithTimeout(method: cstring,
                                          url: cstring,
                                          body: cstring,
                                          headers: cstring,
                                          timeoutSeconds: int32): cstring

fn httpsGetRawProbeCString(text: str): cstring =
    let raw = httpsGetRawProbeCalloc(int64(text.len) + int64(1), int64(1))
    if raw == nil:
        return cstring(nil)
    if text.len > 0:
        httpsGetRawProbeMemcpy(raw, text.data, int64(text.len))
    return cstring(raw)

fn main(): int32 =
    let out = httpsGetRawProbeHttpRequestWithTimeout(httpsGetRawProbeCString("GET"),
                                                     httpsGetRawProbeCString("https://example.com/"),
                                                     httpsGetRawProbeCString(""),
                                                     httpsGetRawProbeCString(""),
                                                     15)
    if ptr(out) == nil:
        os.WriteLine(os.Get_stderr(), "https get response nil")
        return 1
    let n = int32(httpsGetRawProbeStrlen(ptr(out)))
    if n <= 0:
        os.WriteLine(os.Get_stderr(), "https get response empty")
        return 1
    os.WriteLine(os.Get_stdout(), strings.ConcatStr("https_get_response_len=", strings.IntToStr(n)))
    os.WriteLine(os.Get_stdout(), "vexa_https_get_raw_probe ok")
    return 0
