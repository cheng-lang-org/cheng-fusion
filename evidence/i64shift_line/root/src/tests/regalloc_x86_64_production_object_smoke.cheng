import cheng/core/backend/elf_x86_64_writer as elf
import cheng/core/backend/object_relocs as relocs
import cheng/core/backend/object_symbols as symbols
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/std/bytes_layout as layout
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/core/backend/regalloc_aarch64_adapter as rega64
import cheng/core/backend/regalloc_x86_64_adapter as x8664adapter

fn x8664ProductionObjectBody(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "7777777777777777777777777777777777777777777777777777777777777777")
    assert(parsed.ok, " x86_64 object: TypeArena CID fixture invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " x86_64 object: TypeArena CID binding failed")
    var slot: ir.LocalSlot
    slot.id = 0
    slot.name = "result"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    var resultSlot = slot
    resultSlot.id = 1
    resultSlot.name = "call_result"
    resultSlot.stackOffset = 24
    add(body.localSlots, resultSlot)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 42)
    add(body.ops, op)
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "cheng_x8664_callee"
    call.targetSourcePath = "src/tests/cheng_x8664_callee.cheng"
    call.resultSlot = 1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, 0)
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 1
    add(callOp.operands, 0)
    add(body.ops, callOp)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 1
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    return body

fn x8664ProductionDirectSretBody(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "9999999999999999999999999999999999999999999999999999999999999999")
    assert(parsed.ok, " x86_64 sret object: TypeArena CID fixture invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " x86_64 sret object: TypeArena CID binding failed")
    for slotIndex in 0..<6:
        var param: ir.LocalSlot
        param.id = slotIndex
        param.name = "arg"
        param.typeKind = ir.LocalI32Tag
        param.stackOffset = 0 - 1 - slotIndex
        param.sizeBytes = 4
        param.alignBytes = 4
        ir.BodyIRApplyLocalSlotDefaultProof(param)
        add(body.localSlots, param)
    var result: ir.LocalSlot
    result.id = 6
    result.name = "result"
    result.typeKind = ir.LocalAggregateTag
    result.stackOffset = 16
    result.sizeBytes = 16
    result.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(result)
    add(body.localSlots, result)
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "cheng_x8664_sret_callee"
    call.targetSourcePath =
        "src/tests/cheng_x8664_sret_callee.cheng"
    call.resultSlot = 6
    call.resultPassKind = ir.BodyCallPassSretResultTag
    call.relocWordOffset = -1
    for argIndex in 0..<6:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 6
    add(callOp.operands, 0)
    add(body.ops, callOp)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 6
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn x8664ProductionForwardEntrySretBody(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    assert(parsed.ok,
           " x86_64 forward sret object: TypeArena CID fixture invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " x86_64 forward sret object: TypeArena CID binding failed")
    body.entryIsCAbi = true
    for slotIndex in 0..<2:
        var param: ir.LocalSlot
        param.id = slotIndex
        param.name = "forward_arg"
        param.typeKind = ir.LocalPtrTag
        param.stackOffset = 0 - 1 - slotIndex
        param.sizeBytes = 8
        param.alignBytes = 8
        ir.BodyIRApplyLocalSlotDefaultProof(param)
        add(body.localSlots, param)
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "cheng_call_ptr_sret_agg1_raw"
    call.resultSlot = -1
    call.resultExprNodeIndex = -1
    call.resultPassKind =
        ir.BodyCallPassForwardEntrySretTag
    call.relocWordOffset = -1
    for argIndex in 0..<2:
        add(call.argSlots, argIndex)
        add(call.argPassKinds,
            ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 8)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = -1
    add(callOp.operands, 0)
    add(body.ops, callOp)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn x8664ProductionWordsBytes(words: var int32[]): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(words.len * 4)
    if rawbytes.BytesLen(out) != words.len * 4:
        return out
    for wordIndex in 0..<words.len:
        let word = uint32(words[wordIndex])
        let byteStart = wordIndex * 4
        rawbytes.BytesSet(
            out, byteStart, int32(word & uint32(255)))
        rawbytes.BytesSet(
            out, byteStart + 1,
            int32((word >> uint32(8)) & uint32(255)))
        rawbytes.BytesSet(
            out, byteStart + 2,
            int32((word >> uint32(16)) & uint32(255)))
        rawbytes.BytesSet(
            out, byteStart + 3,
            int32((word >> uint32(24)) & uint32(255)))
    return out

fn x8664ProductionHasCallR11(bytes: rawbytes.Bytes): bool =
    let byteCount = rawbytes.BytesLen(bytes)
    if byteCount < 3:
        return false
    for byteIndex in 0..<(byteCount - 2):
        if rawbytes.BytesGet(bytes, byteIndex) == 0x41 &&
           rawbytes.BytesGet(bytes, byteIndex + 1) == 0xFF &&
           rawbytes.BytesGet(bytes, byteIndex + 2) == 0xD3:
            return true
    return false

fn x8664ProductionObjectU16(
        bytes: rawbytes.Bytes,
        offset: int32): int32 =
    return rawbytes.BytesGet(bytes, offset) |
           (rawbytes.BytesGet(bytes, offset + 1) << 8)

fn x8664ProductionObjectU32(
        bytes: rawbytes.Bytes,
        offset: int32): int64 =
    var out: int64
    for byteIndex in 0..<4:
        out = out |
              (int64(rawbytes.BytesGet(
                   bytes, offset + byteIndex)) <<
               int64(byteIndex * 8))
    return out

fn x8664ProductionObjectU64(
        bytes: rawbytes.Bytes,
        offset: int32): int64 =
    var out: int64
    for byteIndex in 0..<8:
        out = out |
              (int64(rawbytes.BytesGet(
                   bytes, offset + byteIndex)) <<
               int64(byteIndex * 8))
    return out

fn x8664ProductionCallFragmentIndex(
        emission: var emitter.RegallocProductionFunctionEmission):
        int32 =
    var found: int32 = -1
    for fragmentIndex in 0..<emission.recipes.machineFragments.len:
        let fragment =
            emission.recipes.machineFragments[fragmentIndex]
        if (fragment.effectMask &
                contract.RegallocA64EffectCall) == 0:
            continue
        if found >= 0:
            return -2
        found = fragmentIndex
    return found

fn x8664ProductionCallActionsError(
        body: var ir.BodyIR,
        emission: var emitter.RegallocProductionFunctionEmission):
        int32 =
    var table = access.BodyIrAccessDecode(body)
    if !table.valid:
        return 1
    var callActionIndex: int32 = -1
    var argActionCount: int32
    var resultActionCount: int32
    for actionIndex in 0..<emission.plan.actions.len:
        let action = emission.plan.actions[actionIndex]
        if action.kind ==
               alloc.RegallocValueActionCallClobber:
            if callActionIndex >= 0:
                return 2
            callActionIndex = actionIndex
            if action.factIndex < 0 ||
               action.factIndex >= table.facts.len:
                return 3
            let fact = table.facts[action.factIndex]
            if action.callOrdinal != 0 ||
               action.opIndex != 1 ||
               fact.kind != access.BodyIrAccessFactClobber ||
               fact.clobberKind !=
                   access.BodyIrAccessClobberCallAbi ||
               fact.callOrdinal != action.callOrdinal ||
               fact.siteKind != access.BodyIrAccessSiteOp ||
               fact.siteIndex != action.opIndex:
                return 4
        elif action.kind == alloc.RegallocValueActionMoveFixed &&
             action.fixedKind ==
                 access.BodyIrAccessFixedCallArg:
            argActionCount = argActionCount + 1
            if action.callOrdinal != 0 ||
               action.fixedOrdinal != 0 ||
               action.targetReg !=
                   emission.plan.constraints.fixedArgRegs[0]:
                return 5
        elif action.kind ==
                 alloc.RegallocValueActionBindFixedResult:
            resultActionCount = resultActionCount + 1
            if action.opIndex != 1 ||
               action.fixedKind !=
                   access.BodyIrAccessFixedCallResult ||
               action.sourceReg !=
                   emission.plan.constraints.fixedResultReg:
                return 6
    let fragmentIndex = x8664ProductionCallFragmentIndex(emission)
    if callActionIndex < 0 || argActionCount != 1 ||
       resultActionCount != 1 || fragmentIndex < 0:
        return 7
    let fragment =
        emission.recipes.machineFragments[fragmentIndex]
    if fragment.ownerKind !=
           contract.RegallocA64FragmentOwnerAction ||
       fragment.actionConsumerOrdinal != callActionIndex ||
       fragment.relocs.len != 1 ||
       fragment.writtenRegs.len !=
           emission.plan.constraints.callClobberRegs.len:
        return 8
    for regIndex in 0..<fragment.writtenRegs.len:
        if fragment.writtenRegs[regIndex] !=
               emission.plan.constraints.callClobberRegs[regIndex]:
            return 9
    return 0

fn x8664ProductionLedgerMutationRejected(
        metadata: var artifacts.RegallocProductionLedgerMetadata,
        mutationKind: int32): bool =
    var mutatedMetadata = metadata
    var mutationBody = x8664ProductionObjectBody()
    var mutationCallTargets: str[]
    add(mutationCallTargets, "cheng_x8664_callee_exact")
    var mutationDataTargets: str[]
    var mutatedEmission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        mutationBody, "cheng_x8664_object", 0,
        mutationCallTargets, mutationDataTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !mutatedEmission.valid:
        return false
    let callFragmentIndex =
        x8664ProductionCallFragmentIndex(mutatedEmission)
    if callFragmentIndex < 0 ||
       mutatedEmission.recipes.functionRelocs.len != 1 ||
       mutatedEmission.recipes.machineFragments[
           callFragmentIndex].relocs.len != 1:
        return false
    if mutationKind == 1:
        mutatedEmission.recipes.functionRelocs = []
        mutatedEmission.recipes.machineFragments[
            callFragmentIndex].relocs = []
    elif mutationKind == 2:
        mutatedMetadata.target =
            artifacts.RegallocProductionTargetA64Darwin
    elif mutationKind == 3:
        mutatedEmission.recipes.functionRelocs[0].targetSymbol =
            "cheng_x8664_callee_swapped"
        mutatedEmission.recipes.machineFragments[
            callFragmentIndex].relocs[0].targetSymbol =
                "cheng_x8664_callee_swapped"
    elif mutationKind == 4:
        mutatedEmission.recipes.functionRelocs[0].byteOffset =
            mutatedEmission.recipes.functionRelocs[0].byteOffset + 1
        mutatedEmission.recipes.machineFragments[
            callFragmentIndex].relocs[0].byteOffset =
                mutatedEmission.recipes.machineFragments[
                    callFragmentIndex].relocs[0].byteOffset + 1
    elif mutationKind == 5:
        mutatedEmission.recipes.functionRelocs[0].kind =
            contract.RegallocA64RelocCall26
        mutatedEmission.recipes.machineFragments[
            callFragmentIndex].relocs[0].kind =
                contract.RegallocA64RelocCall26
    elif mutationKind == 6:
        mutatedEmission.recipes.machineFragments[
            callFragmentIndex].actionConsumerOrdinal = -1
    else:
        return false
    var mutatedRow: artifacts.RegallocProductionLedgerFunction
    mutatedRow.plan = mutatedEmission.plan
    mutatedRow.recipes = mutatedEmission.recipes
    mutatedRow.receipt = mutatedEmission.receipt
    var mutatedRows: artifacts.RegallocProductionLedgerFunction[]
    add(mutatedRows, mutatedRow)
    let mutatedLedger =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            mutatedMetadata, mutatedRows)
    return !mutatedLedger.valid

fn x8664ProductionSretLedgerMutationRejected(
        metadata: var artifacts.RegallocProductionLedgerMetadata,
        mutationKind: int32): bool =
    var body = x8664ProductionDirectSretBody()
    var callTargets: str[]
    add(callTargets, "cheng_x8664_sret_callee_exact")
    var noTargets: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        body, "cheng_x8664_sret_object", 0,
        callTargets, noTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid:
        return false
    var addressAction: int32 = -1
    var stackAction: int32 = -1
    for actionIndex in 0..<emission.plan.actions.len:
        let action = emission.plan.actions[actionIndex]
        if action.kind ==
               alloc.RegallocValueActionAddressFixed:
            addressAction = actionIndex
        elif action.kind ==
                 alloc.RegallocValueActionStoreStackArg:
            stackAction = actionIndex
    var addressFragment: int32 = -1
    var stackFragment: int32 = -1
    for fragmentIndex in 0..<
            emission.recipes.machineFragments.len:
        let consumer =
            emission.recipes.machineFragments[
                fragmentIndex].actionConsumerOrdinal
        if consumer == addressAction:
            addressFragment = fragmentIndex
        elif consumer == stackAction:
            stackFragment = fragmentIndex
    if addressAction < 0 || stackAction < 0 ||
       addressFragment < 0 || stackFragment < 0:
        return false
    if mutationKind == 1:
        var kept: contract.RegallocA64MachineFragment[]
        for fragmentIndex in 0..<
                emission.recipes.machineFragments.len:
            if fragmentIndex != stackFragment:
                add(kept,
                    emission.recipes.machineFragments[
                        fragmentIndex])
        emission.recipes.machineFragments = kept
    elif mutationKind == 2:
        emission.recipes.machineFragments[
            addressFragment].actionConsumerOrdinal = stackAction
        emission.recipes.machineFragments[
            stackFragment].actionConsumerOrdinal = addressAction
    elif mutationKind == 3:
        emission.recipes.machineFragments[
            stackFragment].actionConsumerOrdinal = addressAction
    else:
        return false
    var row: artifacts.RegallocProductionLedgerFunction
    row.plan = emission.plan
    row.recipes = emission.recipes
    row.receipt = emission.receipt
    var rows: artifacts.RegallocProductionLedgerFunction[]
    add(rows, row)
    let ledger =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            metadata, rows)
    return !ledger.valid

fn x8664ProductionForwardSretMutationRejected(
        metadata: var artifacts.RegallocProductionLedgerMetadata,
        mutationKind: int32): bool =
    var body = x8664ProductionForwardEntrySretBody()
    var callTargets: str[]
    add(callTargets, "")
    var noTargets: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        body, "cheng_x8664_forward_sret_object", 0,
        callTargets, noTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid:
        return false
    var forwardActionIndex: int32 = -1
    var callFragmentIndex: int32 = -1
    for actionIndex in 0..<emission.plan.actions.len:
        let action = emission.plan.actions[actionIndex]
        if action.kind ==
               alloc.RegallocValueActionSretForward:
            if forwardActionIndex >= 0:
                return false
            forwardActionIndex = actionIndex
        elif action.kind ==
                 alloc.RegallocValueActionCallClobber:
            if action.fragmentOrdinal < 0 ||
               callFragmentIndex >= 0:
                return false
            callFragmentIndex = action.fragmentOrdinal
    if forwardActionIndex < 0 ||
       callFragmentIndex < 0 ||
       callFragmentIndex >=
           emission.recipes.machineFragments.len:
        return false
    if mutationKind == 1:
        var kept: alloc.RegallocValueAction[]
        for actionIndex in 0..<emission.plan.actions.len:
            if actionIndex != forwardActionIndex:
                add(kept, emission.plan.actions[actionIndex])
        emission.plan.actions = kept
    elif mutationKind == 2:
        var swapped =
            emission.plan.actions[forwardActionIndex]
        swapped.fixedKind =
            access.BodyIrAccessFixedSretResult
        emission.plan.actions[forwardActionIndex] = swapped
    elif mutationKind == 3:
        add(emission.recipes.machineFragments,
            emission.recipes.machineFragments[
                callFragmentIndex])
    else:
        return false
    var row: artifacts.RegallocProductionLedgerFunction
    row.plan = emission.plan
    row.recipes = emission.recipes
    row.receipt = emission.receipt
    var rows: artifacts.RegallocProductionLedgerFunction[]
    add(rows, row)
    let ledger =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            metadata, rows)
    return !ledger.valid

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister() ||
       !x8664adapter.RegallocX64CodegenUnitRegister():
        return 90
    var body = x8664ProductionObjectBody()
    var callTargets: str[]
    add(callTargets, "cheng_x8664_callee_exact")
    var noTargets: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        body, "cheng_x8664_object", 0,
        callTargets, noTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid:
        if emission.errorCode ==
               emitter.RegallocProductionEmitRecipeInvalid:
            if emission.errorDetail >= 0 &&
               emission.errorDetail < emission.plan.actions.len:
                return 100 +
                       emission.plan.actions[
                           emission.errorDetail].kind
            return 100 + emission.errorDetail
        return 20 + emission.errorCode
    if !emission.receipt.valid ||
       emission.recipes.functionWords.len <= 0 ||
       emission.recipes.functionRelocs.len != 1:
        return 1
    let callActionsError =
        x8664ProductionCallActionsError(body, emission)
    if callActionsError != 0:
        return 100 + callActionsError
    let callReloc = emission.recipes.functionRelocs[0]
    if callReloc.kind != contract.RegallocMachineRelocPcRel32 ||
       callReloc.callOrdinal != 0 ||
       callReloc.opIndex != 1 ||
       callReloc.subIndex != -1 ||
       callReloc.byteOffset <= 0 ||
       callReloc.wordIndex != callReloc.byteOffset / 4 ||
       callReloc.targetSymbol != "cheng_x8664_callee_exact":
        return 7
    var text = x8664ProductionWordsBytes(
        emission.recipes.functionWords)
    defer:
        rawbytes.BytesFree(text)
    if rawbytes.BytesLen(text) !=
           emission.recipes.functionWords.len * 4:
        return 2
    if callReloc.byteOffset <= 0 ||
       rawbytes.BytesGet(text, callReloc.byteOffset - 1) != 0xE8:
        return 13
    for immediateByte in 0..<4:
        if rawbytes.BytesGet(
               text, callReloc.byteOffset + immediateByte) != 0:
            return 14
    var objectSymbols = symbols.ObjectSymbolsInit()
    let symbolIndex = symbols.ObjectSymbolsAddDefined(
        objectSymbols, "cheng_x8664_object", 0, int64(0),
        int64(rawbytes.BytesLen(text)), true)
    if symbolIndex != 0:
        return 3
    let calleeSymbolIndex = symbols.ObjectSymbolsAddUndefined(
        objectSymbols, "cheng_x8664_callee_exact", true)
    if calleeSymbolIndex != 1:
        return 8
    var objectRelocs = relocs.ObjectRelocsInit()
    let objectRelocIndex = relocs.ObjectRelocsAdd(
        objectRelocs, 0, int64(callReloc.byteOffset),
        calleeSymbolIndex, relocs.ObjectRelocPcRel32,
        int64(0), true)
    if objectRelocIndex != 0:
        return 9
    let objectResult = elf.ElfX64TextObjectBytes(
        text, objectSymbols, objectRelocs)
    if !objectResult.ok:
        return 4
    var objectBytes = objectResult.value
    defer:
        rawbytes.BytesFree(objectBytes)
    if rawbytes.BytesLen(objectBytes) <= rawbytes.BytesLen(text) ||
       rawbytes.BytesGet(objectBytes, 0) != 0x7F ||
       rawbytes.BytesGet(objectBytes, 1) != 69 ||
       rawbytes.BytesGet(objectBytes, 2) != 76 ||
       rawbytes.BytesGet(objectBytes, 3) != 70 ||
       rawbytes.BytesGet(objectBytes, 4) != 2 ||
       rawbytes.BytesGet(objectBytes, 5) != 1 ||
       rawbytes.BytesGet(objectBytes, 18) != 62 ||
       rawbytes.BytesGet(objectBytes, 19) != 0:
        return 5
    let sectionHeaderOffset = int32(
        x8664ProductionObjectU64(objectBytes, 40))
    let sectionHeaderSize =
        x8664ProductionObjectU16(objectBytes, 58)
    let sectionCount =
        x8664ProductionObjectU16(objectBytes, 60)
    var relaOffset: int32 = -1
    var relaSize: int64
    var relaEntrySize: int64
    var symbolTableSize: int64
    for sectionIndex in 0..<sectionCount:
        let sectionOffset =
            sectionHeaderOffset + sectionIndex * sectionHeaderSize
        let sectionType = x8664ProductionObjectU32(
            objectBytes, sectionOffset + 4)
        if sectionType == int64(4):
            relaOffset = int32(x8664ProductionObjectU64(
                objectBytes, sectionOffset + 24))
            relaSize = x8664ProductionObjectU64(
                objectBytes, sectionOffset + 32)
            relaEntrySize = x8664ProductionObjectU64(
                objectBytes, sectionOffset + 56)
        elif sectionType == int64(2):
            symbolTableSize = x8664ProductionObjectU64(
                objectBytes, sectionOffset + 32)
    if sectionHeaderOffset <= 0 || sectionHeaderSize != 64 ||
       sectionCount <= 0 || relaOffset < 0 ||
       relaSize != int64(24) ||
       relaEntrySize != int64(24) ||
       symbolTableSize != int64(72) ||
       x8664ProductionObjectU64(objectBytes, relaOffset) !=
           int64(callReloc.byteOffset) ||
       x8664ProductionObjectU32(objectBytes, relaOffset + 8) !=
           int64(2) ||
       x8664ProductionObjectU32(objectBytes, relaOffset + 12) !=
           int64(2):
        return 10
    for addendByte in 0..<8:
        var expected = 255
        if addendByte == 0:
            expected = 252
        if rawbytes.BytesGet(
               objectBytes, relaOffset + 16 + addendByte) !=
               expected:
            return 11
    let objectPayload = rawbytes.BytesToString(objectBytes)
    if !strutil.Contains(
           objectPayload, "cheng_x8664_object") ||
       !strutil.Contains(
           objectPayload, "cheng_x8664_callee_exact"):
        return 12
    let objectSha256 = strings.Sha256(
        objectPayload)
    var metadata: artifacts.RegallocProductionLedgerMetadata
    metadata.fixtureSourceSha256 =
        "8888888888888888888888888888888888888888888888888888888888888888"
    metadata.outputObjectSha256 = objectSha256
    metadata.target = artifacts.RegallocProductionTargetX64Linux
    var row: artifacts.RegallocProductionLedgerFunction
    row.plan = emission.plan
    row.recipes = emission.recipes
    row.receipt = emission.receipt
    var rows: artifacts.RegallocProductionLedgerFunction[]
    add(rows, row)
    let ledger =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            metadata, rows)
    if !ledger.valid:
        return 60 + ledger.errorCode
    if len(ledger.payloadSha256) != 64 ||
       !artifacts.RegallocProductionActionEmissionLedgerMatches(
           metadata, rows, ledger.payload) ||
       !strutil.Contains(
           ledger.payload,
           "target=x86_64-unknown-linux-gnu\n") ||
       !strutil.Contains(
           ledger.payload,
           strutil.Join([
               "output_object_sha256=", objectSha256, "\n"
           ], "")) ||
       !strutil.Contains(
           ledger.payload, "ack_kind=machine_emitted\n"):
        return 80
    for mutationKind in 1..<7:
        if !x8664ProductionLedgerMutationRejected(
               metadata, mutationKind):
            return 80 + mutationKind
    var sretBody = x8664ProductionDirectSretBody()
    var sretCallTargets: str[]
    add(sretCallTargets, "cheng_x8664_sret_callee_exact")
    var sretEmission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        sretBody, "cheng_x8664_sret_object", 0,
        sretCallTargets, noTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !sretEmission.valid ||
       !sretEmission.receipt.valid ||
       sretEmission.recipes.functionRelocs.len != 1 ||
       !sretEmission.recipes.hasSretReturn ||
       sretEmission.recipes.returnBufferSaveOffset >= 0 ||
       sretEmission.recipes.outgoingStackBytes != 16:
        return 90
    var addressCount: int32
    var bindCount: int32
    var stackCount: int32
    var returnCount: int32
    for actionIndex in 0..<sretEmission.plan.actions.len:
        let action = sretEmission.plan.actions[actionIndex]
        if action.kind ==
               alloc.RegallocValueActionAddressFixed:
            addressCount = addressCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionBindSretResult:
            bindCount = bindCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionStoreStackArg:
            stackCount = stackCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionStoreSretReturn:
            returnCount = returnCount + 1
    if addressCount != 1 || bindCount != 1 ||
       stackCount != 1 || returnCount != 1:
        return 91
    var sretText =
        x8664ProductionWordsBytes(sretEmission.recipes.functionWords)
    defer:
        rawbytes.BytesFree(sretText)
    var sretSymbols = symbols.ObjectSymbolsInit()
    let sretSymbolIndex = symbols.ObjectSymbolsAddDefined(
        sretSymbols, "cheng_x8664_sret_object", 0, int64(0),
        int64(rawbytes.BytesLen(sretText)), true)
    let sretCalleeIndex = symbols.ObjectSymbolsAddUndefined(
        sretSymbols, "cheng_x8664_sret_callee_exact", true)
    if sretSymbolIndex != 0 || sretCalleeIndex != 1:
        return 92
    let sretReloc = sretEmission.recipes.functionRelocs[0]
    var sretRelocs = relocs.ObjectRelocsInit()
    if relocs.ObjectRelocsAdd(
           sretRelocs, 0, int64(sretReloc.byteOffset),
           sretCalleeIndex, relocs.ObjectRelocPcRel32,
           int64(0), true) != 0:
        return 93
    let sretObjectResult = elf.ElfX64TextObjectBytes(
        sretText, sretSymbols, sretRelocs)
    if !sretObjectResult.ok:
        return 94
    var sretObjectBytes = sretObjectResult.value
    defer:
        rawbytes.BytesFree(sretObjectBytes)
    if rawbytes.BytesLen(sretObjectBytes) <=
           rawbytes.BytesLen(sretText) ||
       rawbytes.BytesGet(sretObjectBytes, 0) != 0x7F ||
       rawbytes.BytesGet(sretObjectBytes, 18) != 62:
        return 95
    var sretMetadata: artifacts.RegallocProductionLedgerMetadata
    sretMetadata.fixtureSourceSha256 =
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    sretMetadata.outputObjectSha256 = strings.Sha256(
        rawbytes.BytesToString(sretObjectBytes))
    sretMetadata.target =
        artifacts.RegallocProductionTargetX64Linux
    var sretRow: artifacts.RegallocProductionLedgerFunction
    sretRow.plan = sretEmission.plan
    sretRow.recipes = sretEmission.recipes
    sretRow.receipt = sretEmission.receipt
    var sretRows: artifacts.RegallocProductionLedgerFunction[]
    add(sretRows, sretRow)
    let sretLedger =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            sretMetadata, sretRows)
    if !sretLedger.valid:
        return 96
    if !artifacts.RegallocProductionActionEmissionLedgerMatches(
           sretMetadata, sretRows, sretLedger.payload):
        return 100
    if !strutil.Contains(
           sretLedger.payload,
           "kind=outgoing_stack_arg_store\n"):
        return 102
    if !strutil.Contains(
           sretLedger.payload, "kind=sret_return_store\n") ||
       !strutil.Contains(
           sretLedger.payload, "role=sret_pointer\n"):
        return 103
    for mutationKind in 1..<4:
        if !x8664ProductionSretLedgerMutationRejected(
               sretMetadata, mutationKind):
            return 96 + mutationKind
    var forwardBody =
        x8664ProductionForwardEntrySretBody()
    var forwardCallTargets: str[]
    add(forwardCallTargets, "")
    var forwardEmission =
        emitter.RegallocProductionEmitFunction(
            artifacts.RegallocProductionTargetX64Linux,
            forwardBody,
            "cheng_x8664_forward_sret_object", 0,
            forwardCallTargets, noTargets,
            0, artifacts.RegallocProductionFunctionKindNormal)
    if !forwardEmission.valid ||
       !forwardEmission.receipt.valid ||
       forwardEmission.recipes.functionWords.len <= 0 ||
       forwardEmission.recipes.functionRelocs.len != 0 ||
       !forwardEmission.recipes.hasSretReturn ||
       forwardEmission.recipes.returnBufferSaveOffset >= 0 ||
       forwardEmission.recipes.abiIngressRegs.len != 3 ||
       forwardEmission.recipes.abiIngressRegs[0] != 7 ||
       forwardEmission.recipes.abiIngressRegs[1] != 6 ||
       forwardEmission.recipes.abiIngressRegs[2] != 2:
        return 110
    var forwardCount: int32
    var forwardLoadCount: int32
    var forwardCallCount: int32
    for actionIndex in 0..<forwardEmission.plan.actions.len:
        let action =
            forwardEmission.plan.actions[actionIndex]
        let actionEmission =
            forwardEmission.receipt.actionEmissions[actionIndex]
        if action.kind ==
               alloc.RegallocValueActionSretForward:
            if action.callOrdinal != 0 ||
               action.fixedKind !=
                   access.BodyIrAccessFixedSretForward ||
               action.passKind !=
                   ir.BodyCallPassForwardEntrySretTag ||
               action.semanticRegister != 7 ||
               actionEmission.bindingKind !=
                   alloc.RegallocValueBindingStructural ||
               actionEmission.emittedByteLength != 0 ||
               actionEmission.emittedBytesSha256 !=
                   alloc.RegallocValueEmptySha256:
                return 111
            forwardCount = forwardCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionLoadFixed:
            if action.callOrdinal != 0 ||
               action.fixedKind !=
                   access.BodyIrAccessFixedCallArg ||
               action.fixedOrdinal != forwardLoadCount ||
               action.targetReg !=
                   forwardEmission.plan.constraints.fixedArgRegs[
                       forwardLoadCount + 1] ||
               action.sourceLocation !=
                   alloc.RegallocValueLocationStack ||
               actionEmission.bindingKind !=
                   alloc.RegallocValueBindingMachine ||
               actionEmission.emittedByteLength <= 0:
                return 112
            forwardLoadCount = forwardLoadCount + 1
        elif action.kind ==
                 alloc.RegallocValueActionCallClobber:
            if action.callOrdinal != 0 ||
               action.fragmentOrdinal < 0 ||
               action.fragmentOrdinal >=
                   forwardEmission.recipes.machineFragments.len:
                return 113
            let fragment =
                forwardEmission.recipes.machineFragments[
                    action.fragmentOrdinal]
            if fragment.actionConsumerOrdinal != actionIndex ||
               fragment.relocs.len != 0 ||
               (fragment.effectMask &
                    contract.RegallocA64EffectCall) == 0 ||
               actionEmission.emittedByteLength <= 0:
                return 114
            forwardCallCount =
                forwardCallCount + 1
    if forwardCount != 1 ||
       forwardLoadCount != 2 ||
       forwardCallCount != 1:
        return 115
    var forwardText =
        x8664ProductionWordsBytes(
            forwardEmission.recipes.functionWords)
    defer:
        rawbytes.BytesFree(forwardText)
    if !x8664ProductionHasCallR11(forwardText):
        return 116
    var forwardSymbols = symbols.ObjectSymbolsInit()
    if symbols.ObjectSymbolsAddDefined(
           forwardSymbols,
           "cheng_x8664_forward_sret_object",
           0, int64(0),
           int64(rawbytes.BytesLen(forwardText)),
           true) != 0:
        return 117
    var forwardRelocs = relocs.ObjectRelocsInit()
    let forwardObjectResult = elf.ElfX64TextObjectBytes(
        forwardText, forwardSymbols, forwardRelocs)
    if !forwardObjectResult.ok:
        return 118
    var forwardObjectBytes = forwardObjectResult.value
    defer:
        rawbytes.BytesFree(forwardObjectBytes)
    if rawbytes.BytesLen(forwardObjectBytes) <=
           rawbytes.BytesLen(forwardText) ||
       rawbytes.BytesGet(forwardObjectBytes, 0) != 0x7F ||
       rawbytes.BytesGet(forwardObjectBytes, 18) != 62:
        return 119
    var forwardMetadata: artifacts.RegallocProductionLedgerMetadata
    forwardMetadata.fixtureSourceSha256 =
        "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    forwardMetadata.outputObjectSha256 = strings.Sha256(
        rawbytes.BytesToString(forwardObjectBytes))
    forwardMetadata.target =
        artifacts.RegallocProductionTargetX64Linux
    var forwardRow: artifacts.RegallocProductionLedgerFunction
    forwardRow.plan = forwardEmission.plan
    forwardRow.recipes = forwardEmission.recipes
    forwardRow.receipt = forwardEmission.receipt
    var forwardRows: artifacts.RegallocProductionLedgerFunction[]
    add(forwardRows, forwardRow)
    let forwardLedger =
        artifacts.RegallocProductionActionEmissionLedgerSerialize(
            forwardMetadata, forwardRows)
    if !forwardLedger.valid ||
       !artifacts.RegallocProductionActionEmissionLedgerMatches(
           forwardMetadata, forwardRows,
           forwardLedger.payload) ||
       !strutil.Contains(
           forwardLedger.payload,
           "kind=sret_forward\n") ||
       !strutil.Contains(
           forwardLedger.payload,
           "role=sret_pointer\n"):
        return 120
    for mutationKind in 1..<4:
        if !x8664ProductionForwardSretMutationRejected(
               forwardMetadata, mutationKind):
            return 120 + mutationKind
    return 0
