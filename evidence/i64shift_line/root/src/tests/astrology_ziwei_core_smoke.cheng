import std/system
import std/strutils as strutil
import cheng/apps/astrology/astrology_ziwei_core as ziwei

fn main(): int32 =
    var resultJson: str
    let ok = ziwei.AstrologyZiweiBuildResultJson(1990,
                                                  1,
                                                  1,
                                                  0,
                                                  "男",
                                                  "solar",
                                                  0,
                                                  "Asia/Shanghai",
                                                  116400,
                                                  true,
                                                  false,
                                                  "00:00",
                                                  resultJson)
    assert(ok, " ziwei core: default chart builds")
    assert(strutil.Contains(resultJson, "\"yearGanZhi\":\"己巳\""), " ziwei core: year ganzhi")
    assert(strutil.Contains(resultJson, "\"wuxingJu\":\"水二局\""), " ziwei core: wuxing ju")
    assert(strutil.Contains(resultJson, "\"juNumber\":2"), " ziwei core: ju number")
    assert(strutil.Contains(resultJson, "\"mingZhu\":\"巨门\""), " ziwei core: ming zhu")
    assert(strutil.Contains(resultJson, "\"shenZhu\":\"天机\""), " ziwei core: shen zhu")
    assert(strutil.Contains(resultJson, "\"shenGongIdx\":0"), " ziwei core: shen gong")
    assert(strutil.Contains(resultJson, "\"name\":\"命宫\",\"dizhi\":\"丑\",\"tiangan\":\"丁\""), " ziwei core: ming gong palace")
    assert(strutil.Contains(resultJson, "\"name\":\"天府\",\"brightness\":\"旺\",\"siHua\":null"), " ziwei core: main star brightness")
    assert(strutil.Contains(resultJson, "\"name\":\"武曲\",\"brightness\":\"得\",\"siHua\":\"化禄\""), " ziwei core: sihua star")
    assert(strutil.Contains(resultJson, "\"siHua\":[\"武曲化禄\"]"), " ziwei core: palace sihua")
    assert(strutil.Contains(resultJson, "\"input\":{\"calendar\":\"solar\",\"year\":1990,\"month\":1,\"day\":1,\"hour\":23"), " ziwei core: input echo")
    return 0
