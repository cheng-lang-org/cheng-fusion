import std/system

fn TkR16PatternKindText(kind: int32): str =
    if kind == 1:
        return "TkR16PatternBinding"
    if kind == 2:
        return "TkR16PatternWildcard"
    if kind == 3:
        return "TkR16PatternLiteral"
    panic("tk_r16: invalid pattern kind")

fn TkR16PatternKindWidth(kind: int32): int32 =
    if kind == 1:
        return 19
    if kind == 2:
        return 20
    panic("tk_r16: invalid pattern width kind")

fn main(): int32 =
    let a = TkR16PatternKindText(1)
    let b = TkR16PatternKindText(2)
    let c = TkR16PatternKindText(3)
    if a != "TkR16PatternBinding":
        return 10
    if b != "TkR16PatternWildcard":
        return 11
    if c != "TkR16PatternLiteral":
        return 12
    if a.len != 19:
        return 13
    if b.len != 20:
        return 14
    if TkR16PatternKindWidth(1) != 19:
        return 15
    if TkR16PatternKindWidth(2) != 20:
        return 16
    echo(Fmt"tk_r16_panic_tail ok a={a} b={b} c={c} w={TkR16PatternKindWidth(1)}")
    return 0
