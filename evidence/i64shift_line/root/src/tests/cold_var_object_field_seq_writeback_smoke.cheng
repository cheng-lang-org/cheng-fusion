type
    Holder =
        items: int32[]

fn writeAt(items: var int32[], index: int32, value: int32) =
    items[index] = value

fn main(): int32 =
    var holder: Holder
    add(holder.items, 0)
    add(holder.items, 0)
    writeAt(holder.items, 1, 42)
    if holder.items[1] != 42:
        return 1
    return 0
