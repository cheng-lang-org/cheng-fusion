import cheng/core/runtime/web_scene_runtime as scene
import std/strings

# Mechanism 14 adversarial review (codec-fidelity lens) — stage3 real compile+run regression lock
# for WebSceneWebRtcIceConfigRecord's hand-written JSON codec, targeting exactly the cases the
# implementer's own src/tests/mech14_webrtc_iceconfig_smoke.cheng does NOT cover: special
# characters/URLs, optional-field omitted-key vs explicit-empty-key collapse, mixed empty/multi
# nested arrays in the SAME record, and fail-closed rejection of malformed input at the NESTED
# level (not just the top level, which the implementer's own smoke test already covers).
#
# Standalone file, does not touch the shared src/tests/web_scene_runtime_smoke.cheng or the
# implementer's own mech14_webrtc_iceconfig_smoke.cheng (per CLAUDE.md §4b:6, do not perturb
# shared/adjacent files with unrelated additions).

fn mech14AdvSpecialCharsRoundTrip(): int32 =
    var record: scene.WebSceneWebRtcIceConfigRecord
    record.present = true
    record.relayOnly = false
    setLen(record.stunUrls, 1)
    record.stunUrls[0] = "stun:中文.example.com"
    setLen(record.turnServers, 0)
    var t0: scene.WebSceneWebRtcTurnServerRecord
    t0.url = "turn:x.example.com/path?a=\"quoted\"&b=back\\slash&c=line1\nline2&d=tab\ttab"
    t0.username = "user_中文_😀"
    t0.credential = "pass/word"
    add(record.turnServers, t0)
    setLen(record.iceServers, 0)
    record.expiresAtMsPresent = false
    record.expiresAtMs = int64(0)

    let encoded = scene.WebSceneEncodeWebRtcIceConfigState(record)
    var decoded: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState(encoded, decoded):
        echo(Fmt"mech14adv FAIL: special-char round trip parse failed: {encoded}")
        return 1
    if decoded.stunUrls[0] != record.stunUrls[0]:
        echo("mech14adv FAIL: unicode stunUrls mismatch")
        return 2
    if decoded.turnServers[0].url != record.turnServers[0].url:
        echo("mech14adv FAIL: quote/backslash/newline/tab url mismatch")
        return 3
    if decoded.turnServers[0].username != record.turnServers[0].username:
        echo("mech14adv FAIL: unicode+emoji username mismatch")
        return 4
    if decoded.turnServers[0].credential != record.turnServers[0].credential:
        echo("mech14adv FAIL: forward-slash credential mismatch")
        return 5
    return 0

# Real host bridges may legitimately omit optional JSON keys entirely (rather than emitting an
# explicit empty string) for a minimal entry. Both forms must decode to the SAME in-memory value —
# never crash, never silently produce a different result depending on which JSON shape arrives.
fn mech14AdvOptionalOmittedVsExplicitEmptyCollapse(): int32 =
    let raw = "{\"relayOnly\":true,\"stunUrls\":[],\"turnServers\":[],\"iceServers\":[{\"urls\":[\"stun:a\"]},{\"urls\":[\"stun:b\"],\"username\":\"\",\"credential\":\"\"}],\"expiresAtMsPresent\":false,\"expiresAtMs\":0}"
    var decoded: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState(raw, decoded):
        echo("mech14adv FAIL: parse of omitted-optional-key JSON must succeed")
        return 10
    if decoded.iceServers.len != 2:
        echo("mech14adv FAIL: iceServers length")
        return 11
    if decoded.iceServers[0].username != "" || decoded.iceServers[0].credential != "":
        echo("mech14adv FAIL: omitted-key entry must decode to empty string")
        return 12
    if decoded.iceServers[1].username != "" || decoded.iceServers[1].credential != "":
        echo("mech14adv FAIL: explicit-empty-key entry must decode to empty string")
        return 13
    # second-pass idempotency: re-encoding always re-emits all 3 iceServer keys (no separate
    # presence tracking for username/credential) — verify no data loss on a second round trip.
    let reEncoded = scene.WebSceneEncodeWebRtcIceConfigState(decoded)
    var decoded2: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState(reEncoded, decoded2):
        echo("mech14adv FAIL: second-pass parse of re-encoded JSON must succeed")
        return 14
    if decoded2.iceServers[0].username != "" || decoded2.iceServers[1].credential != "":
        echo("mech14adv FAIL: second-pass round trip lost data")
        return 15
    return 0

# Mixed nested emptiness within the SAME record (one array empty, a sibling array non-empty) must
# never corrupt the sibling's parse position/content — proves setLen(x,0)-style empty arrays don't
# leave the parser's cursor in a bad state for whatever comes after them.
fn mech14AdvMixedEmptyNonEmptySiblingArrays(): int32 =
    var a: scene.WebSceneWebRtcIceConfigRecord
    a.present = true
    a.relayOnly = false
    setLen(a.stunUrls, 0)
    setLen(a.turnServers, 0)
    setLen(a.iceServers, 0)
    var ai0: scene.WebSceneWebRtcIceServerRecord
    setLen(ai0.urls, 1)
    ai0.urls[0] = "stun:a0"
    ai0.username = "ua0"
    ai0.credential = "ca0"
    add(a.iceServers, ai0)
    var ai1: scene.WebSceneWebRtcIceServerRecord
    setLen(ai1.urls, 1)
    ai1.urls[0] = "stun:a1"
    ai1.username = "ua1"
    ai1.credential = "ca1"
    add(a.iceServers, ai1)
    a.expiresAtMsPresent = false
    a.expiresAtMs = int64(0)
    let encA = scene.WebSceneEncodeWebRtcIceConfigState(a)
    var decA: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState(encA, decA):
        echo("mech14adv FAIL A parse")
        return 20
    if decA.turnServers.len != 0 || decA.iceServers.len != 2:
        echo(Fmt"mech14adv FAIL A shape: turnServers.len={decA.turnServers.len} iceServers.len={decA.iceServers.len}")
        return 21
    if decA.iceServers[0].urls[0] != "stun:a0" || decA.iceServers[1].urls[0] != "stun:a1":
        echo("mech14adv FAIL A: content corrupted after empty-sibling-array parse")
        return 22

    var b: scene.WebSceneWebRtcIceConfigRecord
    b.present = true
    b.relayOnly = true
    setLen(b.stunUrls, 0)
    setLen(b.turnServers, 0)
    setLen(b.iceServers, 0)
    var bt0: scene.WebSceneWebRtcTurnServerRecord
    bt0.url = "turn:b0"
    bt0.username = "ub0"
    bt0.credential = "cb0"
    add(b.turnServers, bt0)
    var bt1: scene.WebSceneWebRtcTurnServerRecord
    bt1.url = "turn:b1"
    bt1.username = "ub1"
    bt1.credential = "cb1"
    add(b.turnServers, bt1)
    b.expiresAtMsPresent = false
    b.expiresAtMs = int64(0)
    let encB = scene.WebSceneEncodeWebRtcIceConfigState(b)
    var decB: scene.WebSceneWebRtcIceConfigRecord
    if !scene.WebSceneParseWebRtcIceConfigState(encB, decB):
        echo("mech14adv FAIL B parse")
        return 23
    if decB.iceServers.len != 0 || decB.turnServers.len != 2:
        echo(Fmt"mech14adv FAIL B shape: iceServers.len={decB.iceServers.len} turnServers.len={decB.turnServers.len}")
        return 24
    if decB.turnServers[0].url != "turn:b0" || decB.turnServers[1].url != "turn:b1":
        echo("mech14adv FAIL B: content corrupted")
        return 25
    return 0

# Fail-closed at the NESTED level, not just the top level (the implementer's own smoke test only
# exercises an unknown top-level key — mirrors the SAME exhaustive-key/no-duplicate discipline one
# level deeper, where a silent-tolerance bug would be just as capable of masking a real, dropped
# field as at the top level).
fn mech14AdvNestedFailClosed(): int32 =
    let dupNested = "{\"relayOnly\":false,\"stunUrls\":[],\"turnServers\":[{\"url\":\"x\",\"url\":\"y\",\"username\":\"u\",\"credential\":\"c\"}],\"iceServers\":[],\"expiresAtMsPresent\":false,\"expiresAtMs\":0}"
    var decDup: scene.WebSceneWebRtcIceConfigRecord
    if scene.WebSceneParseWebRtcIceConfigState(dupNested, decDup):
        echo("mech14adv FAIL: nested duplicate 'url' key must be rejected")
        return 30

    let unknownNested = "{\"relayOnly\":false,\"stunUrls\":[],\"turnServers\":[{\"url\":\"x\",\"username\":\"u\",\"credential\":\"c\",\"extra\":1}],\"iceServers\":[],\"expiresAtMsPresent\":false,\"expiresAtMs\":0}"
    var decUnk: scene.WebSceneWebRtcIceConfigRecord
    if scene.WebSceneParseWebRtcIceConfigState(unknownNested, decUnk):
        echo("mech14adv FAIL: nested unknown key in turnServer must be rejected")
        return 31

    # `urls` is the sole audited-mandatory field on RTCIceServer (username/credential are TS
    # optional) — an iceServer entry missing it entirely must fail closed, not decode to an empty
    # urls array (which would silently misrepresent "no URLs" vs "malformed input").
    let missingUrls = "{\"relayOnly\":false,\"stunUrls\":[],\"turnServers\":[],\"iceServers\":[{\"username\":\"u\",\"credential\":\"c\"}],\"expiresAtMsPresent\":false,\"expiresAtMs\":0}"
    var decMissing: scene.WebSceneWebRtcIceConfigRecord
    if scene.WebSceneParseWebRtcIceConfigState(missingUrls, decMissing):
        echo("mech14adv FAIL: iceServer entry missing mandatory 'urls' key must be rejected")
        return 32
    return 0

fn main(): int32 =
    var status = mech14AdvSpecialCharsRoundTrip()
    if status != 0:
        return status
    status = mech14AdvOptionalOmittedVsExplicitEmptyCollapse()
    if status != 0:
        return status
    status = mech14AdvMixedEmptyNonEmptySiblingArrays()
    if status != 0:
        return status
    status = mech14AdvNestedFailClosed()
    if status != 0:
        return status
    echo("mech14adv PASS")
    return 0
