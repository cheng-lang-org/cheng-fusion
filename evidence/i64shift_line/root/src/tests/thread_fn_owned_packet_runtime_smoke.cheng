import std/os
import std/thread

const
    threadFnOwnedPacketJoinedIterations: int32 = 256
    threadFnOwnedPacketConcurrentWorkers: int32 = 8
    threadFnOwnedPacketSpawnedIterations: int32 = 256

var
    threadFnOwnedPacketJoinedCount: int32
    threadFnOwnedPacketSpawnedCount: int32

fn threadFnOwnedPacketCountJoined(): int32 =
    os.CsgCurrentHeadLeaseRegistryLock()
    let count = threadFnOwnedPacketJoinedCount
    os.CsgCurrentHeadLeaseRegistryUnlock()
    return count

fn threadFnOwnedPacketCountSpawned(): int32 =
    os.CsgCurrentHeadLeaseRegistryLock()
    let count = threadFnOwnedPacketSpawnedCount
    os.CsgCurrentHeadLeaseRegistryUnlock()
    return count

fn threadFnOwnedPacketJoinedWorker() =
    os.CsgCurrentHeadLeaseRegistryLock()
    threadFnOwnedPacketJoinedCount = threadFnOwnedPacketJoinedCount + 1
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()

fn threadFnOwnedPacketSpawnedWorker() =
    os.CsgCurrentHeadLeaseRegistryLock()
    threadFnOwnedPacketSpawnedCount = threadFnOwnedPacketSpawnedCount + 1
    os.CsgCurrentHeadLeaseRegistryNotifyAll()
    os.CsgCurrentHeadLeaseRegistryUnlock()

fn threadFnOwnedPacketWaitSpawned(expected: int32) =
    while threadFnOwnedPacketCountSpawned() < expected:
        os.CsgCurrentHeadLeaseRegistryLock()
        if threadFnOwnedPacketSpawnedCount < expected:
            let observedEpoch = os.CsgCurrentHeadLeaseRegistryEpoch()
            os.CsgCurrentHeadLeaseRegistryUnlock()
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)
        else:
            os.CsgCurrentHeadLeaseRegistryUnlock()

fn main(): int32 =
    for iteration in 0..<threadFnOwnedPacketJoinedIterations:
        let worker = thread.StartFn(threadFnOwnedPacketJoinedWorker)
        if !thread.JoinThread(worker):
            return 2
    if threadFnOwnedPacketCountJoined() !=
           threadFnOwnedPacketJoinedIterations:
        return 3

    var concurrent: thread.Thread[]
    for workerIndex in 0..<threadFnOwnedPacketConcurrentWorkers:
        add(concurrent, thread.StartFn(threadFnOwnedPacketJoinedWorker))
    for workerIndex in 0..<threadFnOwnedPacketConcurrentWorkers:
        if !thread.JoinThread(concurrent[workerIndex]):
            return 4
    if threadFnOwnedPacketCountJoined() !=
           threadFnOwnedPacketJoinedIterations +
               threadFnOwnedPacketConcurrentWorkers:
        return 5

    for iteration in 0..<threadFnOwnedPacketSpawnedIterations:
        if !thread.Spawn(threadFnOwnedPacketSpawnedWorker):
            return 6
    threadFnOwnedPacketWaitSpawned(
        threadFnOwnedPacketSpawnedIterations)
    if threadFnOwnedPacketCountSpawned() !=
           threadFnOwnedPacketSpawnedIterations:
        return 7

    os.WriteLine(
        os.Get_stdout(), "THREAD_FN_OWNED_PACKET_RUNTIME_OK")
    return 0
