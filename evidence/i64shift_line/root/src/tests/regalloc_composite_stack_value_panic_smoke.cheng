import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_cfg as cfg
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_aarch64_adapter as adapter
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/aarch64_encode as a64

fn makeSlot(id: int32,
            typeKind: int32,
            stackOffset: int32,
            sizeBytes: int32,
            alignBytes: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "composite_panic"
    slot.typeKind = typeKind
    slot.stackOffset = stackOffset
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn buildBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots,
        makeSlot(0, ir.LocalAggregateTag, -1, 64, 8))
    add(body.localSlots,
        makeSlot(1, ir.LocalI32Tag, 16, 4, 4))
    add(body.localSlots,
        makeSlot(2, ir.LocalStrTag, 24, 24, 8))

    var isOk: ir.BodyOp
    isOk.kind = ir.BodyOpResultProjectTag
    isOk.target = 1
    add(isOk.operands, ir.BodyResultProjectIsOkTag)
    add(isOk.operands, 0)
    add(body.ops, isOk)

    var message: ir.BodyOp
    message.kind = ir.BodyOpResultProjectTag
    message.target = 2
    add(message.operands, ir.BodyResultProjectErrorStrTag)
    add(message.operands, 0)
    add(message.operands, ir.ResultStrErrMsgOffset)
    add(message.operands, 24)
    add(body.ops, message)

    var panicCall: ir.CallOp
    panicCall.targetSymbol = "Panic"
    panicCall.resultSlot = -1
    panicCall.resultPassKind = ir.BodyCallPassStackValueTag
    panicCall.relocWordOffset = -1
    add(panicCall.argSlots, 2)
    add(panicCall.argPassKinds, ir.BodyCallPassStackValueTag)
    add(body.callSequence, panicCall)

    var guard: ir.BodyOp
    guard.kind = ir.BodyOpResultPanicGuardTag
    guard.target = -1
    add(guard.operands, 1)
    add(guard.operands, 0)
    add(body.ops, guard)

    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 3, termIndex)
    return body

fn regListContains(regs: var int32[], reg: int32): bool =
    for index in 0..<regs.len:
        if regs[index] == reg:
            return true
    return false

fn actionFragmentEffect(
        prepared: var contract.RegallocA64FunctionRecipes,
        actionIndex: int32): int32 =
    var found: int32 = -1
    for fragmentIndex in 0..<prepared.machineFragments.len:
        let fragment = prepared.machineFragments[fragmentIndex]
        if fragment.ownerKind !=
               contract.RegallocA64FragmentOwnerAction ||
           fragment.actionConsumerOrdinal != actionIndex:
            continue
        if found >= 0:
            return -2
        found = fragment.effectMask
    return found

fn verifyFacts(body: var ir.BodyIR,
               table: var access.BodyIrAccessTable): bool =
    if !table.valid || table.opFactCounts.len != 3 ||
       table.opFactCounts[0] != 3 ||
       table.opFactCounts[1] != 3 ||
       table.opFactCounts[2] != 5 ||
       table.callFactCounts.len != 1 || table.callFactCounts[0] != 4:
        return false
    let start = table.opFactStarts[2]
    let condition = table.facts[start]
    let address = table.facts[start + 1]
    let argument = table.facts[start + 2]
    let memory = table.facts[start + 3]
    let clobber = table.facts[start + 4]
    return condition.kind == access.BodyIrAccessFactUse &&
           condition.slotIndex == 1 &&
           address.kind == access.BodyIrAccessFactAddress &&
           address.slotIndex == 2 && address.fixedOrdinal == 0 &&
           address.passKind == ir.BodyCallPassStackValueTag &&
           address.addressEscapes && address.addressOwnerSlot == 2 &&
           address.addressByteOffset == 0 &&
           address.addressByteLength == 24 &&
           address.abiSizeBytes == 8 && !address.abiSizeExplicit &&
           access.BodyIrAccessAddressFactIsValid(body, address) &&
           argument.kind == access.BodyIrAccessFactUse &&
           argument.slotIndex == 2 && argument.addressEscapes &&
           argument.fixedKind == access.BodyIrAccessFixedCallArg &&
           argument.fixedOrdinal == 0 && argument.abiSizeBytes == 8 &&
           !argument.abiSizeExplicit &&
           memory.kind == access.BodyIrAccessFactMemory &&
           memory.memoryEffect == access.BodyIrAccessMemoryCallReadWrite &&
           clobber.kind == access.BodyIrAccessFactClobber &&
           clobber.clobberKind == access.BodyIrAccessClobberCallAbi

fn buildLargeTargetCopyBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots,
        makeSlot(0, ir.LocalStrTag, -1, 24, 8))
    add(body.localSlots,
        makeSlot(1, ir.LocalStrTag, 40016, 24, 8))
    var copy: ir.BodyOp
    copy.kind = ir.BodyOpCopyLocalTag
    copy.target = 1
    add(copy.operands, 0)
    add(body.ops, copy)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn verifyLargeTargetCopyRematerializes(): bool =
    var body = buildLargeTargetCopyBody()
    var table = access.BodyIrAccessDecode(body)
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    if !table.valid || !analysis.valid || !plan.valid:
        return false
    var copyAction: int32 = -1
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.opIndex == 0 &&
           action.kind == alloc.RegallocValueActionStoreHome:
            if copyAction >= 0:
                return false
            copyAction = actionIndex
    if copyAction < 0:
        return false
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid || !prepared.opRecipes[0].ownedByAction ||
       prepared.opRecipes[0].words.len != 0:
        return false
    let recipe = prepared.recipes[copyAction]
    let effects = contract.RegallocA64EffectSpLoad |
                  contract.RegallocA64EffectSpStore |
                  contract.RegallocA64EffectX16 |
                  contract.RegallocA64EffectX17
    if !recipe.producerWritesMemoryOnly ||
       recipe.effectMask != effects || recipe.relocs.len != 0 ||
       actionFragmentEffect(prepared, copyAction) != effects:
        return false
    var wordIndex: int32
    for chunkIndex in 0..<3:
        let byteOffset = chunkIndex * 8
        if wordIndex > recipe.words.len - 2 ||
           recipe.words[wordIndex] != Value(a64.A64EncLdrImm(
               true, a64.A64X17, a64.A64SP,
               int64(prepared.localStackOffsets[0]))) ||
           recipe.words[wordIndex + 1] != Value(a64.A64EncLdrImm(
               true, a64.A64X16, a64.A64X17,
               int64(byteOffset))):
            return false
        wordIndex = wordIndex + 2
        var remaining = prepared.localStackOffsets[1] + byteOffset
        var baseReg = a64.A64SP
        while remaining > 0:
            var step = remaining
            if step > 4095:
                step = 4095
            if wordIndex >= recipe.words.len ||
               recipe.words[wordIndex] != Value(a64.A64EncAddImm(
                   true, a64.A64X17, baseReg, step)):
                return false
            wordIndex = wordIndex + 1
            baseReg = a64.A64X17
            remaining = remaining - step
        if wordIndex >= recipe.words.len ||
           recipe.words[wordIndex] != Value(a64.A64EncStrImm(
               true, a64.A64X16, a64.A64X17, int64(0))):
            return false
        wordIndex = wordIndex + 1
    return wordIndex == recipe.words.len

fn main(): int32 =
    var body = buildBody()
    var table = access.BodyIrAccessDecode(body)
    if !verifyFacts(body, table):
        return 11
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    if !analysis.valid:
        return 12
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuild(
        body, table, analysis, constraints)
    if !plan.valid || !plan.frozen ||
       !alloc.RegallocSinglePassValuePlanValidate(plan):
        return 13

    var projectAction: int32 = -1
    var addressAction: int32 = -1
    var duplicateFixedLoad: bool
    for actionIndex in 0..<plan.actions.len:
        let action = plan.actions[actionIndex]
        if action.opIndex == 1 &&
           action.kind == alloc.RegallocValueActionStoreHome:
            if projectAction >= 0:
                return 14
            projectAction = actionIndex
        if action.opIndex == 2 &&
           action.kind == alloc.RegallocValueActionAddressFixed:
            if addressAction >= 0:
                return 14
            addressAction = actionIndex
        if action.opIndex == 2 && action.fixedOrdinal == 0 &&
           action.kind == alloc.RegallocValueActionLoadFixed:
            duplicateFixedLoad = true
    if projectAction < 0 || addressAction < 0 || duplicateFixedLoad:
        return 14
    let address = plan.actions[addressAction]
    if address.sourceLocation != alloc.RegallocValueLocationAddress ||
       address.targetLocation != alloc.RegallocValueLocationRegister ||
       address.targetReg != a64.A64X0 || address.encodedValue != 2 ||
       address.passKind != ir.BodyCallPassStackValueTag ||
       address.abiSizeBytes != 8 || address.abiSizeExplicit:
        return 15

    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid:
        return 16
    if !prepared.opRecipes[1].ownedByAction ||
       prepared.opRecipes[1].words.len != 0:
        return 20
    let project = prepared.recipes[projectAction]
    let projectEffects = contract.RegallocA64EffectSpLoad |
                         contract.RegallocA64EffectSpStore |
                         contract.RegallocA64EffectX16 |
                         contract.RegallocA64EffectX17
    if !project.producerWritesMemoryOnly ||
       project.effectMask != projectEffects ||
       project.writtenRegs.len != 2 ||
       !regListContains(project.writtenRegs, a64.A64X16) ||
       !regListContains(project.writtenRegs, a64.A64X17) ||
       project.relocs.len != 0 || project.words.len != 7 ||
       actionFragmentEffect(prepared, projectAction) != projectEffects:
        return 17
    if project.words[0] != Value(a64.A64EncLdrImm(
           true, a64.A64X17, a64.A64SP,
           int64(prepared.localStackOffsets[0]))):
        return 18
    for chunkIndex in 0..<3:
        let sourceByteOffset = ir.ResultStrErrMsgOffset + chunkIndex * 8
        let targetByteOffset = chunkIndex * 8
        let targetStoreOffset =
            prepared.localStackOffsets[2] + targetByteOffset
        let wordIndex = 1 + chunkIndex * 2
        if project.words[wordIndex] != Value(a64.A64EncLdrImm(
               true, a64.A64X16, a64.A64X17,
               int64(sourceByteOffset))) ||
           project.words[wordIndex + 1] != Value(a64.A64EncStrImm(
               true, a64.A64X16, a64.A64SP,
               int64(targetStoreOffset))):
            return 18

    let addressRecipe = prepared.recipes[addressAction]
    if addressRecipe.effectMask != 0 ||
       addressRecipe.writtenRegs.len != 1 ||
       addressRecipe.writtenRegs[0] != a64.A64X0 ||
       addressRecipe.relocs.len != 0 || addressRecipe.words.len != 1 ||
       addressRecipe.words[0] != Value(a64.A64EncAddImm(
           true, a64.A64X0, a64.A64SP,
           prepared.localStackOffsets[2])) ||
       actionFragmentEffect(prepared, addressAction) != 0:
        return 19
    if !verifyLargeTargetCopyRematerializes():
        return 21
    return 0
