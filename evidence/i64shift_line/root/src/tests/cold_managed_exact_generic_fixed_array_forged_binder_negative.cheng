fn main(): int32 =
    var left: ColdManagedExactGenericFixedArrayForgedLeft[ColdManagedExactGenericFixedArrayForgedLeaf]
    var right: ColdManagedExactGenericFixedArrayForgedRight[ColdManagedExactGenericFixedArrayForgedLeaf]
