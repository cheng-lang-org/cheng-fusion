type
    ColdManagedExactGenericFixedArrayForgedLeaf =
        label: str

    ColdManagedExactGenericFixedArrayForgedLeft[T] =
        leaves: T[2]

    ColdManagedExactGenericFixedArrayForgedRight[T] =
