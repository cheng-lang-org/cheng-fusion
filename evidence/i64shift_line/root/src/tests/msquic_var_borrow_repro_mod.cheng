# Regression fixture module for the msquic body-missing walls (2026-07-23).
# Wall A: passing a module-level var array element of an imported struct type
# to a `var T` param must be accepted (canonical implicit borrow) — cold used
# to reject with `arg[0] param_kind=9 ... actual_kind=1 actual_size=4`.
# Wall B: `store.flows[slot] = flow` indexed field assignment through a var
# struct param with an imported element type must compile — the driver used
# to reject with `indexed field assignment unsupported indexed field kind`.

import std/rawbytes

const probeMaxQ: int32 = 4

type ProbeFlow =
    credit: int64
    limit: int64

type ProbeSent =
    pn: int64
    sentLen: int32

type ProbeConn =
    slot: int32
    tag: int64
    queuedFrameKinds: int64[probeMaxQ]
    queuedPayloads: rawbytes.Bytes[probeMaxQ]
    sentPackets: ProbeSent[probeMaxQ]

type ProbeStore =
    flows: ProbeFlow[8]

fn ProbeConnHasQueued(impl: var ProbeConn): bool =
    return impl.slot > 0

fn ProbeStoreSetFlow(store: var ProbeStore, slot: int32, flow: ProbeFlow) =
    store.flows[slot] = flow
