import std/cmdline
import std/os
import std/rawbytes

fn RequireParent(): str =
    var parent: str
    assert(cmdline.readFlagValue("--parent", parent) && len(parent) > 0,
           "atomic tree root exact smoke: --parent is required")
    return parent

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    let parent = RequireParent()
    let beginRes = os.AtomicTreeBegin(parent,
                                      "txn-root-exact",
                                      "root-exact-installed")
    assert(IsOk(beginRes), Error(beginRes))
    let tree = Value(beginRes)
    assert(IsOk(os.AtomicTreeMkdir(tree, "objects/deep")),
           "atomic tree root exact smoke: category setup")
    var nested = rawbytes.BytesFromString("nested canonical object")
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(
               tree, "objects/deep/object.csgc", nested)),
           "atomic tree root exact smoke: nested object setup")
    var identity = rawbytes.BytesFromString("root identity")
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(
               tree, "store.identity.csgc", identity)),
           "atomic tree root exact smoke: identity setup")

    assert(IsOk(os.AtomicTreeVerifyRootExact(
               tree,
               ["objects"],
               ["store.identity.csgc"])),
           "atomic tree root exact smoke: nested category rejected")
    assert(IsErr(os.AtomicTreeVerifyExact(
               tree,
               ["objects"],
               ["store.identity.csgc"])),
           "atomic tree root exact smoke: recursive oracle did not see nested entries")
    assert(IsErr(os.AtomicTreeVerifyRootExact(
               tree,
               ["objects", "objects/deep"],
               ["store.identity.csgc"])),
           "atomic tree root exact smoke: nested expected directory accepted")
    assert(IsErr(os.AtomicTreeVerifyRootExact(
               tree,
               [],
               ["objects"])),
           "atomic tree root exact smoke: root type swap accepted")

    var extra = rawbytes.BytesFromString("extra root")
    assert(IsOk(os.AtomicTreeWriteExclusiveSync(tree, "extra", extra)),
           "atomic tree root exact smoke: extra root setup")
    assert(IsErr(os.AtomicTreeVerifyRootExact(
               tree,
               ["objects"],
               ["store.identity.csgc"])),
           "atomic tree root exact smoke: extra root accepted")
    assert(IsOk(os.AtomicTreeAbort(tree)),
           "atomic tree root exact smoke: abort")
    echo("atomic_tree_root_exact_smoke ok")
    return 0
