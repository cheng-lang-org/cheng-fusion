import cheng/core/runtime/web_runtime as web
import cheng/core/runtime/web_react_runtime as react

fn expectText(document: var web.WebDocument, nodeId: int32, expected: str): bool =
    var text: str
    if !web.WebDocumentNodeTextContent(document, nodeId, text):
        return false
    return text == expected

fn expectAttr(document: var web.WebDocument, nodeId: int32, name: str, expected: str): bool =
    var value: str
    if !web.WebDocumentGetAttribute(document, nodeId, name, value):
        return false
    return value == expected

fn testState(runtime: var react.ReactRuntime): int32 =
    var initial: react.ReactValue
    react.Int32Value(initial, 1)
    var state: react.ReactState
    if !react.UseState(runtime, initial, state):
        return 1
    if state.slot != 0:
        return 2
    if state.valueKind != react.ReactValueKindInt32 || state.valueInt32 != 1:
        return 3
    var next: react.ReactValue
    react.Int32Value(next, 2)
    if !react.SetState(runtime, state.slot, next):
        return 4
    if react.ReactRuntimePendingStateCount(runtime) != 1:
        return 85
    if runtime.stateInt32s[state.slot] != 1:
        return 86
    var nextLatest: react.ReactValue
    react.Int32Value(nextLatest, 3)
    if !react.SetState(runtime, state.slot, nextLatest):
        return 87
    if react.ReactRuntimePendingStateCount(runtime) != 2:
        return 88
    if runtime.stateInt32s[state.slot] != 1:
        return 89
    react.ReactRuntimeBeginRender(runtime)
    if react.ReactRuntimePendingStateCount(runtime) != 0:
        return 90
    var ignoredInitial: react.ReactValue
    react.Int32Value(ignoredInitial, 100)
    var rerendered: react.ReactState
    if !react.useState(runtime, ignoredInitial, rerendered):
        return 5
    if rerendered.slot != 0:
        return 6
    if rerendered.valueInt32 != 3:
        return 7
    if react.ReactRuntimeStateCount(runtime) != 1:
        return 8
    react.ReactRuntimeBeginRender(runtime)
    var refState: react.ReactState
    if !react.useState(runtime, ignoredInitial, refState):
        return 81
    if refState.slot != 0 || refState.valueInt32 != 3:
        return 82
    var refInitial: react.ReactValue
    react.StringValue(refInitial, "first")
    var refValue: react.ReactRef
    if !react.UseRef(runtime, refInitial, refValue):
        return 73
    if refValue.slot != 1:
        return 74
    if refValue.valueKind != react.ReactValueKindString || refValue.valueString != "first":
        return 75
    var refNext: react.ReactValue
    react.StringValue(refNext, "second")
    if react.SetState(runtime, refValue.slot, refNext):
        return 91
    if react.ReactRuntimePendingStateCount(runtime) != 0:
        return 92
    if !react.SetRefCurrent(runtime, refValue.slot, refNext):
        return 76
    react.ReactRuntimeBeginRender(runtime)
    var ignoredRefInitial: react.ReactValue
    react.StringValue(ignoredRefInitial, "ignored")
    var rerenderedRefState: react.ReactState
    if !react.useState(runtime, ignoredInitial, rerenderedRefState):
        return 83
    if rerenderedRefState.slot != 0 || rerenderedRefState.valueInt32 != 3:
        return 84
    var rerenderedRef: react.ReactRef
    if !react.useRef(runtime, ignoredRefInitial, rerenderedRef):
        return 77
    if rerenderedRef.slot != 1:
        return 78
    if rerenderedRef.valueString != "second":
        return 79
    return 0

fn testElements(runtime: var react.ReactRuntime,
                root: var react.ReactElement): int32 =
    var titleText: react.ReactElement
    if !react.CreateText(runtime, "Title", titleText):
        return 35
    var runText: react.ReactElement
    if !react.CreateText(runtime, "Run", runText):
        return 36

    // h1 with role=heading
    var h1Children: react.ReactElement[]
    var h1Child: react.ReactElement
    h1Child.elementId = titleText.elementId
    add(h1Children, h1Child)
    var h1Props: react.ReactProp[]
    var h1Role: react.ReactProp
    react.Attribute(h1Role, "role", "heading")
    add(h1Props, h1Role)
    var h1: react.ReactElement
    h1.elementId = react.ReactRuntimeAppendElement(runtime, react.ReactElementKindHost, "h1", "", h1Props, h1Children)

    // button with data-id=run, class=primary
    var btnChildren: react.ReactElement[]
    var btnChild: react.ReactElement
    btnChild.elementId = runText.elementId
    add(btnChildren, btnChild)
    var btnProps: react.ReactProp[]
    var btnId: react.ReactProp
    react.Attribute(btnId, "data-id", "run")
    add(btnProps, btnId)
    var btnCls: react.ReactProp
    react.Attribute(btnCls, "className", "primary")
    add(btnProps, btnCls)
    var btn: react.ReactElement
    btn.elementId = react.ReactRuntimeAppendElement(runtime, react.ReactElementKindHost, "button", "", btnProps, btnChildren)

    // section with data-testid=root, htmlFor=main-label
    var rootChildren: react.ReactElement[]
    var rootChild1: react.ReactElement
    rootChild1.elementId = h1.elementId
    add(rootChildren, rootChild1)
    var rootChild2: react.ReactElement
    rootChild2.elementId = btn.elementId
    add(rootChildren, rootChild2)
    var rootProps: react.ReactProp[]
    var rootTestId: react.ReactProp
    react.Attribute(rootTestId, "data-testid", "root")
    add(rootProps, rootTestId)
    var rootFor: react.ReactProp
    react.Attribute(rootFor, "htmlFor", "main-label")
    add(rootProps, rootFor)
    root.elementId = react.ReactRuntimeAppendElement(runtime, react.ReactElementKindHost, "section", "", rootProps, rootChildren)

    var eventProp: react.ReactProp
    react.Attribute(eventProp, "onClick", "handler")
    if react.ReactPropStatus(eventProp) != react.ReactStatusUnsupportedPropValue:
        return 40
    var badEventProps: react.ReactProp[]
    add(badEventProps, eventProp)
    var badEventElement: react.ReactElement
    if react.CreateElement(runtime, "button", badEventProps, [], badEventElement):
        return 37
    return 0

fn testReconcile(runtime: var react.ReactRuntime, root: var react.ReactElement, document: var web.WebDocument): int32 =
    let docNode = web.WebDocumentCreateDocumentNode(document)
    var rootNode = 0
    if !react.Reconcile(runtime, document, root, rootNode):
        return 11
    if rootNode == 0:
        return 12
    if !web.WebDocumentAppendChild(document, docNode, rootNode):
        return 13

    // section, h1, button, Title text, Run text + document node = 6
    if web.WebDocumentNodeCount(document) != 6:
        return 14

    // Check attributes
    if !expectAttr(document, rootNode, "data-testid", "root"):
        return 15
    // htmlFor maps to "for" in DOM
    if !expectAttr(document, rootNode, "for", "main-label"):
        return 38

    // Check mutation count: 6 createNode + 5 setAttribute + 5 appendChild = 16
    // createNode: #document, section, h1, titleText, button, runText
    // setAttribute: section.data-testid, section.for, h1.role, button.data-id, button.class
    // appendChild: doc->section, section->h1, h1->title, section->button, button->run
    if web.WebDocumentMutationCount(document) != 16:
        return 39

    let h1Node = web.WebDocumentChildAt(document, rootNode, 0)
    if !expectAttr(document, h1Node, "role", "heading"):
        return 16
    let h1Text = web.WebDocumentChildAt(document, h1Node, 0)
    if !expectText(document, h1Text, "Title"):
        return 17

    let buttonNode = web.WebDocumentChildAt(document, rootNode, 1)
    if !expectAttr(document, buttonNode, "data-id", "run"):
        return 18
    // className maps to "class" in DOM
    if !expectAttr(document, buttonNode, "class", "primary"):
        return 19
    let buttonText = web.WebDocumentChildAt(document, buttonNode, 0)
    if !expectText(document, buttonText, "Run"):
        return 20

    return 0

fn testReconcileReRender(runtime: var react.ReactRuntime, prevRoot: var react.ReactElement, document: var web.WebDocument): int32 =
    // Start new render frame
    react.ReactRuntimeBeginRender(runtime)

    // Build new element tree: same structure, changed attributes
    var titleText2: react.ReactElement
    if !react.CreateText(runtime, "Title2", titleText2):
        return 41

    var h1Props2: react.ReactProp[]
    var h1Role2: react.ReactProp
    react.Attribute(h1Role2, "role", "title")
    add(h1Props2, h1Role2)
    var h1Children2: react.ReactElement[]
    add(h1Children2, titleText2)
    var h12: react.ReactElement
    h12.elementId = react.ReactRuntimeAppendElement(runtime, react.ReactElementKindHost, "h1", "", h1Props2, h1Children2)

    var runText2: react.ReactElement
    if !react.CreateText(runtime, "Run2", runText2):
        return 42

    var btnProps2: react.ReactProp[]
    var btnId2: react.ReactProp
    react.Attribute(btnId2, "data-id", "run2")
    add(btnProps2, btnId2)
    var btnChildren2: react.ReactElement[]
    add(btnChildren2, runText2)
    var btn2: react.ReactElement
    btn2.elementId = react.ReactRuntimeAppendElement(runtime, react.ReactElementKindHost, "button", "", btnProps2, btnChildren2)

    var rootChildren2: react.ReactElement[]
    add(rootChildren2, h12)
    add(rootChildren2, btn2)
    var rootProps2: react.ReactProp[]
    var rootTestId2: react.ReactProp
    react.Attribute(rootTestId2, "data-testid", "root2")
    add(rootProps2, rootTestId2)
    var root2: react.ReactElement
    root2.elementId = react.ReactRuntimeAppendElement(runtime, react.ReactElementKindHost, "section", "", rootProps2, rootChildren2)

    // Reconcile with diff (prevRootElementId != 0 triggers diff path)
    // The diff updates the existing root node's children in place.
    var rootNode = 0
    if !react.Reconcile(runtime, document, root2, rootNode):
        return 43
    if rootNode == 0:
        return 44

    // Verify updated attribute values
    if !expectAttr(document, rootNode, "data-testid", "root2"):
        return 46
    let h1Node = web.WebDocumentChildAt(document, rootNode, 0)
    if !expectAttr(document, h1Node, "role", "title"):
        return 47
    let h1Text = web.WebDocumentChildAt(document, h1Node, 0)
    if !expectText(document, h1Text, "Title2"):
        return 48
    let btnNode = web.WebDocumentChildAt(document, rootNode, 1)
    if !expectAttr(document, btnNode, "data-id", "run2"):
        return 49
    let btnText = web.WebDocumentChildAt(document, btnNode, 0)
    if !expectText(document, btnText, "Run2"):
        return 50

    return 0

fn testKeyedChildReorder(): int32 =
    var runtime: react.ReactRuntime
    react.ReactRuntimeInit(runtime)
    react.ReactRuntimeBeginRender(runtime)
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)

    var alphaText: react.ReactElement
    if !react.CreateText(runtime, "Alpha", alphaText):
        return 160
    var alphaProps: react.ReactProp[]
    var alphaKey: react.ReactProp
    react.Attribute(alphaKey, "key", "a")
    add(alphaProps, alphaKey)
    var alphaChildren: react.ReactElement[]
    add(alphaChildren, alphaText)
    var alphaLi: react.ReactElement
    if !react.CreateElement(runtime, "li", alphaProps, alphaChildren, alphaLi):
        return 161

    var betaText: react.ReactElement
    if !react.CreateText(runtime, "Beta", betaText):
        return 162
    var betaProps: react.ReactProp[]
    var betaKey: react.ReactProp
    react.Attribute(betaKey, "key", "b")
    add(betaProps, betaKey)
    var betaChildren: react.ReactElement[]
    add(betaChildren, betaText)
    var betaLi: react.ReactElement
    if !react.CreateElement(runtime, "li", betaProps, betaChildren, betaLi):
        return 163

    var rootProps: react.ReactProp[]
    var rootChildren: react.ReactElement[]
    add(rootChildren, alphaLi)
    add(rootChildren, betaLi)
    var root: react.ReactElement
    if !react.CreateElement(runtime, "ul", rootProps, rootChildren, root):
        return 164
    var rootNode: int32
    if !react.Reconcile(runtime, document, root, rootNode):
        return 165
    if !web.WebDocumentAppendChild(document, docNode, rootNode):
        return 166
    let alphaNode = web.WebDocumentChildAt(document, rootNode, 0)
    let betaNode = web.WebDocumentChildAt(document, rootNode, 1)
    if alphaNode == 0 || betaNode == 0:
        return 167
    let alphaTextNode = web.WebDocumentChildAt(document, alphaNode, 0)
    let betaTextNode = web.WebDocumentChildAt(document, betaNode, 0)
    if alphaTextNode == 0 || betaTextNode == 0:
        return 168

    react.ReactRuntimeBeginRender(runtime)
    var betaText2: react.ReactElement
    if !react.CreateText(runtime, "Beta2", betaText2):
        return 169
    var betaProps2: react.ReactProp[]
    var betaKey2: react.ReactProp
    react.Attribute(betaKey2, "key", "b")
    add(betaProps2, betaKey2)
    var betaChildren2: react.ReactElement[]
    add(betaChildren2, betaText2)
    var betaLi2: react.ReactElement
    if !react.CreateElement(runtime, "li", betaProps2, betaChildren2, betaLi2):
        return 170

    var alphaText2: react.ReactElement
    if !react.CreateText(runtime, "Alpha2", alphaText2):
        return 171
    var alphaProps2: react.ReactProp[]
    var alphaKey2: react.ReactProp
    react.Attribute(alphaKey2, "key", "a")
    add(alphaProps2, alphaKey2)
    var alphaChildren2: react.ReactElement[]
    add(alphaChildren2, alphaText2)
    var alphaLi2: react.ReactElement
    if !react.CreateElement(runtime, "li", alphaProps2, alphaChildren2, alphaLi2):
        return 172

    var rootChildren2: react.ReactElement[]
    add(rootChildren2, betaLi2)
    add(rootChildren2, alphaLi2)
    var root2: react.ReactElement
    if !react.CreateElement(runtime, "ul", rootProps, rootChildren2, root2):
        return 173
    var rootNode2: int32
    if !react.Reconcile(runtime, document, root2, rootNode2):
        return 174
    if rootNode2 != rootNode:
        return 175
    if web.WebDocumentNodeCount(document) != 6:
        return 176

    let firstAfter = web.WebDocumentChildAt(document, rootNode2, 0)
    let secondAfter = web.WebDocumentChildAt(document, rootNode2, 1)
    if firstAfter != betaNode:
        return 177
    if secondAfter != alphaNode:
        return 178
    if web.WebDocumentChildAt(document, firstAfter, 0) != betaTextNode:
        return 179
    if web.WebDocumentChildAt(document, secondAfter, 0) != alphaTextNode:
        return 180
    if !expectText(document, betaTextNode, "Beta2"):
        return 181
    if !expectText(document, alphaTextNode, "Alpha2"):
        return 182
    return 0

// ─────────────────────────────────────────────
// Component function definitions
// ─────────────────────────────────────────────

fn SimpleComp(runtime: var react.ReactRuntime, props: react.ReactProp[]): react.ReactElement =
    var text: react.ReactElement
    if !react.CreateText(runtime, "Hello", text):
        var err: react.ReactElement
        err.elementId = 0
        return err
    var divProps: react.ReactProp[]
    var divChildren: react.ReactElement[]
    add(divChildren, text)
    var div: react.ReactElement
    if !react.CreateElement(runtime, "div", divProps, divChildren, div):
        var err: react.ReactElement
        err.elementId = 0
        return err
    return div

fn StatefulComp(runtime: var react.ReactRuntime, props: react.ReactProp[]): react.ReactElement =
    var initial: react.ReactValue
    react.Int32Value(initial, 42)
    var state: react.ReactState
    if !react.useState(runtime, initial, state):
        var err: react.ReactElement
        err.elementId = 0
        return err
    var text: react.ReactElement
    if !react.CreateText(runtime, "Stateful", text):
        var err: react.ReactElement
        err.elementId = 0
        return err
    var divProps: react.ReactProp[]
    var divChildren: react.ReactElement[]
    add(divChildren, text)
    var div: react.ReactElement
    if !react.CreateElement(runtime, "div", divProps, divChildren, div):
        var err: react.ReactElement
        err.elementId = 0
        return err
    return div

fn MultiInstanceComp(runtime: var react.ReactRuntime, props: react.ReactProp[]): react.ReactElement =
    var initial: react.ReactValue
    react.Int32Value(initial, 100)
    var state: react.ReactState
    if !react.useState(runtime, initial, state):
        var err: react.ReactElement
        err.elementId = 0
        return err
    var text: react.ReactElement
    if !react.CreateText(runtime, "Instance", text):
        var err: react.ReactElement
        err.elementId = 0
        return err
    var divProps: react.ReactProp[]
    var divChildren: react.ReactElement[]
    add(divChildren, text)
    var div: react.ReactElement
    if !react.CreateElement(runtime, "div", divProps, divChildren, div):
        var err: react.ReactElement
        err.elementId = 0
        return err
    return div

// ─────────────────────────────────────────────
// Component tests
// ─────────────────────────────────────────────

fn testComponentSimple(runtime: var react.ReactRuntime, document: var web.WebDocument): int32 =
    react.ReactRuntimeBeginRender(runtime)

    var base: int32
    base = react.ReactRuntimeBeginComponentRender(runtime)
    var emptyCompProps: react.ReactProp[]
    let child = SimpleComp(runtime, emptyCompProps)
    if !react.ReactRuntimeEndComponentScope(runtime):
        return 51
    if child.elementId == 0:
        return 52

    var comp: react.ReactElement
    var compProps: react.ReactProp[]
    var compChildren: react.ReactElement[]
    add(compChildren, child)
    if !react.CreateComponent(runtime, 1, compProps, compChildren, base, comp):
        return 53

    let compIdx = comp.elementId - 1
    if runtime.elementKinds[compIdx] != react.ReactElementKindComponent:
        return 54

    var rootProps: react.ReactProp[]
    var rootChildren: react.ReactElement[]
    add(rootChildren, comp)
    var root: react.ReactElement
    if !react.CreateElement(runtime, "section", rootProps, rootChildren, root):
        return 55

    let docNode = web.WebDocumentCreateDocumentNode(document)
    var rootNode: int32
    if !react.Reconcile(runtime, document, root, rootNode):
        return 56
    if rootNode == 0:
        return 57

    // section > div > "Hello"
    let sectionNode = web.WebDocumentChildAt(document, rootNode, 0)
    if sectionNode == 0:
        return 58
    let divNode = web.WebDocumentChildAt(document, sectionNode, 0)
    if divNode == 0:
        return 59
    if !expectText(document, divNode, "Hello"):
        return 60

    if !web.WebDocumentAppendChild(document, docNode, rootNode):
        return 61

    // 1 document + 1 section + 1 div + 1 text + 1 component placeholder = 5 nodes
    // Component has no DOM node, so the total is 4: doc, section, div, text
    if web.WebDocumentNodeCount(document) != 4:
        return 62
    return 0

fn testComponentWithState(runtime: var react.ReactRuntime, document: var web.WebDocument): int32 =
    // Test 1: Basic useState on fresh runtime
    react.ReactRuntimeBeginRender(runtime)
    var i1: react.ReactValue
    react.Int32Value(i1, 10)
    var s1: react.ReactState
    if !react.useState(runtime, i1, s1):
        return 70

    // Test 2: Replicate BeginComponentRender logic manually
    react.ReactRuntimeBeginRender(runtime)
    add(runtime.hookCursorStack, runtime.hookCursor)  // same as BeginComponentRender
    let base = runtime.stateKinds.len                  // same as BeginComponentRender
    runtime.hookCursor = base                           // same as BeginComponentRender

    var i2: react.ReactValue
    react.Int32Value(i2, 42)
    var s2: react.ReactState
    if !react.useState(runtime, i2, s2):
        return 71

    // Restore cursor (same as EndComponentScope)
    runtime.hookCursor = runtime.hookCursorStack[runtime.hookCursorStack.len - 1]
    var newStack: int32[]
    for i in 0..<runtime.hookCursorStack.len - 1:
        add(newStack, runtime.hookCursorStack[i])
    runtime.hookCursorStack = newStack

    if s2.valueInt32 != 42:
        return 72

    // Test 3: Try BeginComponentRender directly
    react.ReactRuntimeBeginRender(runtime)
    var base3: int32
    base3 = react.ReactRuntimeBeginComponentRender(runtime)

    var i3: react.ReactValue
    react.Int32Value(i3, 99)
    var s3: react.ReactState
    if !react.useState(runtime, i3, s3):
        return 74

    if !react.ReactRuntimeEndComponentScope(runtime):
        return 75

    if s3.valueInt32 != 99:
        return 76

    // Verify elements and reconcile still work
    var text: react.ReactElement
    if !react.CreateText(runtime, "test", text):
        return 77
    var rootProps: react.ReactProp[]
    var rootChildren: react.ReactElement[]
    add(rootChildren, text)
    var root: react.ReactElement
    if !react.CreateElement(runtime, "div", rootProps, rootChildren, root):
        return 78
    let docNode = web.WebDocumentCreateDocumentNode(document)
    var rootNode: int32
    if !react.Reconcile(runtime, document, root, rootNode):
        return 79

    return 0

fn testComponentMultipleInstances(runtime: var react.ReactRuntime, document: var web.WebDocument): int32 =
    // First render - two instances
    react.ReactRuntimeBeginRender(runtime)

    var base1: int32
    base1 = react.ReactRuntimeBeginComponentRender(runtime)
    var emptyProps: react.ReactProp[]
    let child1 = MultiInstanceComp(runtime, emptyProps)
    if !react.ReactRuntimeEndComponentScope(runtime):
        return 91
    if child1.elementId == 0:
        return 92

    var base2: int32
    base2 = react.ReactRuntimeBeginComponentRender(runtime)
    let child2 = MultiInstanceComp(runtime, emptyProps)
    if !react.ReactRuntimeEndComponentScope(runtime):
        return 94
    if child2.elementId == 0:
        return 95

    // Each MultiInstanceComp uses 1 useState, so base1=0, base2=1
    if base1 != 0 || base2 != 1:
        return 96

    var comp1: react.ReactElement
    var comp1Props: react.ReactProp[]
    var comp1Children: react.ReactElement[]
    add(comp1Children, child1)
    if !react.CreateComponent(runtime, 3, comp1Props, comp1Children, base1, comp1):
        return 97

    var comp2: react.ReactElement
    var comp2Props: react.ReactProp[]
    var comp2Children: react.ReactElement[]
    add(comp2Children, child2)
    if !react.CreateComponent(runtime, 3, comp2Props, comp2Children, base2, comp2):
        return 98

    var rootProps: react.ReactProp[]
    var rootChildren: react.ReactElement[]
    add(rootChildren, comp1)
    add(rootChildren, comp2)
    var root: react.ReactElement
    if !react.CreateElement(runtime, "div", rootProps, rootChildren, root):
        return 99

    let docNode = web.WebDocumentCreateDocumentNode(document)
    var rootNode: int32
    if !react.Reconcile(runtime, document, root, rootNode):
        return 100

    // Set different states for each instance
    var val1: react.ReactValue
    react.Int32Value(val1, 200)
    if !react.SetState(runtime, base1, val1):
        return 101

    var val2: react.ReactValue
    react.Int32Value(val2, 300)
    if !react.SetState(runtime, base2, val2):
        return 102

    // Re-render both instances
    react.ReactRuntimeBeginRender(runtime)

    if !react.ReactRuntimeBeginComponentScope(runtime, comp1.elementId):
        return 103
    let newChild1 = MultiInstanceComp(runtime, emptyProps)
    if !react.ReactRuntimeEndComponentScope(runtime):
        return 104
    if newChild1.elementId == 0:
        return 105

    if !react.ReactRuntimeBeginComponentScope(runtime, comp2.elementId):
        return 106
    let newChild2 = MultiInstanceComp(runtime, emptyProps)
    if !react.ReactRuntimeEndComponentScope(runtime):
        return 107
    if newChild2.elementId == 0:
        return 108

    var ncomp1: react.ReactElement
    var ncomp1Props: react.ReactProp[]
    var ncomp1Children: react.ReactElement[]
    add(ncomp1Children, newChild1)
    if !react.CreateComponent(runtime, 3, ncomp1Props, ncomp1Children, base1, ncomp1):
        return 109

    var ncomp2: react.ReactElement
    var ncomp2Props: react.ReactProp[]
    var ncomp2Children: react.ReactElement[]
    add(ncomp2Children, newChild2)
    if !react.CreateComponent(runtime, 3, ncomp2Props, ncomp2Children, base2, ncomp2):
        return 110

    var nrootProps: react.ReactProp[]
    var nrootChildren: react.ReactElement[]
    add(nrootChildren, ncomp1)
    add(nrootChildren, ncomp2)
    var nroot: react.ReactElement
    if !react.CreateElement(runtime, "div", nrootProps, nrootChildren, nroot):
        return 111

    var nrootNode: int32
    if !react.Reconcile(runtime, document, nroot, nrootNode):
        return 112

    // Verify instance 1 state = 200
    react.ReactRuntimeBeginRender(runtime)
    if !react.ReactRuntimeBeginComponentScope(runtime, ncomp1.elementId):
        return 113
    var ck1: react.ReactValue
    react.Int32Value(ck1, 0)
    var recv1: react.ReactState
    if !react.useState(runtime, ck1, recv1):
        return 114
    if !react.ReactRuntimeEndComponentScope(runtime):
        return 115
    if recv1.valueInt32 != 200:
        return 116

    // Verify instance 2 state = 300
    if !react.ReactRuntimeBeginComponentScope(runtime, ncomp2.elementId):
        return 117
    var ck2: react.ReactValue
    react.Int32Value(ck2, 0)
    var recv2: react.ReactState
    if !react.useState(runtime, ck2, recv2):
        return 118
    if !react.ReactRuntimeEndComponentScope(runtime):
        return 119
    if recv2.valueInt32 != 300:
        return 120

    return 0

// ─────────────────────────────────────────────
// Event delegation tests
// ─────────────────────────────────────────────

fn testEventRegistration(runtime: var react.ReactRuntime, document: var web.WebDocument): int32 =
    var onClickProp: react.ReactProp
    var handlerVal: react.ReactValue
    react.Int32Value(handlerVal, 42)
    react.AttributeValue(onClickProp, "onClick", handlerVal)

    var btnProps: react.ReactProp[]
    add(btnProps, onClickProp)
    var btn: react.ReactElement
    if !react.CreateElement(runtime, "button", btnProps, [], btn):
        return 130

    let docNode = web.WebDocumentCreateDocumentNode(document)
    var rootNode: int32
    if !react.Reconcile(runtime, document, btn, rootNode):
        return 131
    if rootNode == 0:
        return 132
    if web.WebDocumentListenerCount(document) != 1:
        return 133
    if web.WebDocumentListenerNodeAt(document, 0) != rootNode:
        return 134
    var eventType: str
    if !web.WebDocumentListenerEventTypeAt(document, 0, eventType):
        return 135
    if eventType != "click":
        return 136
    if web.WebDocumentListenerHandlerAt(document, 0) != 42:
        return 137

    return 0

fn testEventDispatchBubble(runtime: var react.ReactRuntime, document: var web.WebDocument): int32 =
    // Create parent div with onClick and child button with onClick
    var parentClick: react.ReactProp
    var parentVal: react.ReactValue
    react.Int32Value(parentVal, 10)
    react.AttributeValue(parentClick, "onClick", parentVal)

    var childClick: react.ReactProp
    var childVal: react.ReactValue
    react.Int32Value(childVal, 20)
    react.AttributeValue(childClick, "onClick", childVal)

    var parentProps: react.ReactProp[]
    add(parentProps, parentClick)

    var childProps: react.ReactProp[]
    add(childProps, childClick)

    var btn: react.ReactElement
    if !react.CreateElement(runtime, "button", childProps, [], btn):
        return 140

    var parentChildren: react.ReactElement[]
    add(parentChildren, btn)
    var parent: react.ReactElement
    if !react.CreateElement(runtime, "div", parentProps, parentChildren, parent):
        return 141

    let docNode = web.WebDocumentCreateDocumentNode(document)
    var parentNode: int32
    if !react.Reconcile(runtime, document, parent, parentNode):
        return 142

    let btnNode = web.WebDocumentChildAt(document, parentNode, 0)
    if btnNode == 0:
        return 143

    // Dispatch click event on button
    let dispatched = web.WebDocumentDispatchEvent(document, btnNode, "click")
    if dispatched == 0:
        return 144

    // React onClick registers a bubble listener: target button, then parent bubble.
    if web.WebDocumentDispatchTraceCount(document) != 2:
        return 145

    if web.WebDocumentDispatchTraceNodeAt(document, 0) != btnNode:
        return 146
    if web.WebDocumentDispatchTraceHandlerAt(document, 0) != 20:
        return 147
    if web.WebDocumentDispatchTracePhaseAt(document, 0) != web.WebEventPhaseTarget:
        return 148

    if web.WebDocumentDispatchTraceNodeAt(document, 1) != parentNode:
        return 149
    if web.WebDocumentDispatchTraceHandlerAt(document, 1) != 10:
        return 150
    if web.WebDocumentDispatchTracePhaseAt(document, 1) != web.WebEventPhaseBubble:
        return 151

    return 0

fn runReactBasicSmoke(): int32 =
    var runtime: react.ReactRuntime
    react.ReactRuntimeInit(runtime)
    react.ReactRuntimeBeginRender(runtime)
    let r1 = testState(runtime)
    if r1 != 0:
        return r1
    var root: react.ReactElement
    let r2 = testElements(runtime, root)
    if r2 != 0:
        return r2
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let r3 = testReconcile(runtime, root, document)
    if r3 != 0:
        return r3
    let r4 = testReconcileReRender(runtime, root, document)
    if r4 != 0:
        return r4
    let rKey = testKeyedChildReorder()
    if rKey != 0:
        return rKey
    return 0

fn runReactComponentSmoke(): int32 =
    var compRuntime: react.ReactRuntime
    react.ReactRuntimeInit(compRuntime)
    var compDoc: web.WebDocument
    web.WebDocumentInit(compDoc)
    let r5 = testComponentSimple(compRuntime, compDoc)
    if r5 != 0:
        return r5

    var stateRuntime: react.ReactRuntime
    react.ReactRuntimeInit(stateRuntime)
    var stateDoc: web.WebDocument
    web.WebDocumentInit(stateDoc)
    let r6 = testComponentWithState(stateRuntime, stateDoc)
    if r6 != 0:
        return r6

    var multiRuntime: react.ReactRuntime
    react.ReactRuntimeInit(multiRuntime)
    var multiDoc: web.WebDocument
    web.WebDocumentInit(multiDoc)
    let r7 = testComponentMultipleInstances(multiRuntime, multiDoc)
    if r7 != 0:
        return r7
    return 0

fn runReactEventSmoke(): int32 =
    var eventRuntime: react.ReactRuntime
    react.ReactRuntimeInit(eventRuntime)
    var eventDoc: web.WebDocument
    web.WebDocumentInit(eventDoc)
    let r8 = testEventRegistration(eventRuntime, eventDoc)
    if r8 != 0:
        return r8

    var bubbleRuntime: react.ReactRuntime
    react.ReactRuntimeInit(bubbleRuntime)
    var bubbleDoc: web.WebDocument
    web.WebDocumentInit(bubbleDoc)
    let r9 = testEventDispatchBubble(bubbleRuntime, bubbleDoc)
    if r9 != 0:
        return r9
    return 0

fn main(): int32 =
    var code = runReactBasicSmoke()
    if code != 0:
        echo(Fmt"FAIL runReactBasicSmoke: {code}")
        return code
    code = runReactComponentSmoke()
    if code != 0:
        echo(Fmt"FAIL runReactComponentSmoke: {code}")
        return code
    code = runReactEventSmoke()
    if code != 0:
        echo(Fmt"FAIL runReactEventSmoke: {code}")
        return code
    echo(" web_react_runtime_smoke ok")
    return 0
