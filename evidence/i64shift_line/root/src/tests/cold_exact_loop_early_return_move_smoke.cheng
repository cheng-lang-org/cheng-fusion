fn ColdExactLoopEarlyReturnMove(consume: bool): int32 =
    var rows: str[]
    var current: str = "seed"
    var step: int32 = 0
    while step < 3:
        if consume && step == 1:
            add(rows, current)
            return rows.len # COLD_EXACT_EARLY_RETURN
        if step == 0:
            current = "next"
        if current.len == 0:
            return -1
        step = step + 1
    return current.len

fn main(): int32 =
    if ColdExactLoopEarlyReturnMove(true) != 1:
        return 1
    if ColdExactLoopEarlyReturnMove(false) != 4:
        return 2
    return 0
