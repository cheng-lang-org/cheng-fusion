# E2 incremental-edit equivalence checks:
#   1. checkpoint fidelity: a run resumed from a mid-film checkpoint lands
#      on the exact same world state as a straight-through run
#   2. edit propagation: a semantic fact change (wall friction) changes the
#      final world state, and the edited run stays deterministic
import cheng/game/csg/schema
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/world3d
import std/strings as strings

@borrows
fn runTicks(st: var execution.CsgExecutionState, facts: schema.CsgWorldFacts, ticks: int32) =
    var i: int32 = 0
    while i < ticks:
        let _r = execution.CsgExecutionTick(st, facts)
        i = i + 1

# semantic edit under test: rope segment length (changes the climb geometry)
@borrows
fn runAndCid(segLenMilli: int32, ticks: int32): str =
    var f: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    f.rope.segmentLenM = float64(segLenMilli) / 1000.0
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(f, w, mp, err):
        panic("E2: materialize failed")
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, f, w, mp.partSlot, mp.ropeNodeSlot)
    runTicks(st, f, ticks)
    return Fmt"{World3dCid(st.w)}"

@borrows
fn checkpointCase(): str =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildClimbScene()
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        return "materialize failed"
    var straight: execution.CsgExecutionState
    execution.CsgExecutionInit(straight, facts, w, mp.partSlot, mp.ropeNodeSlot)
    runTicks(straight, facts, 2400)
    let straightCid: str = Fmt"{World3dCid(straight.w)}"

    var staged: execution.CsgExecutionState
    execution.CsgExecutionInit(staged, facts, w, mp.partSlot, mp.ropeNodeSlot)
    runTicks(staged, facts, 1200)
    let snap: execution.CsgExecutionState = execution.CsgExecutionSnapshot(staged)
    runTicks(staged, facts, 1200)
    let resumedCid: str = Fmt"{World3dCid(staged.w)}"

    let snapCid: str = Fmt"{World3dCid(snap.w)}"
    if straightCid == snapCid:
        return "impossible equality at checkpoint"
    if resumedCid != straightCid:
        return "resumed diverged from straight-through"
    return "OK " + straightCid

fn main(): int32 =
    let case1 = checkpointCase()
    echo("checkpoint: " + case1)
    if !strings.HasPrefix(case1, "OK"):
        echo("FAIL E2 checkpoint fidelity")
        return 1
    let base = runAndCid(800, 2400)
    let edited = runAndCid(200, 2400)
    let edited2 = runAndCid(200, 2400)
    if base == edited:
        echo("FAIL E2 edit propagation: rope length edit absorbed")
        return 1
    if edited != edited2:
        echo("FAIL E2 edited-run determinism")
        return 1
    echo("edit propagation OK")
    echo("PASS csg world incremental check")
    return 0
