import std/os
import std/result
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/core/lang/parser
import cheng/core/tooling/compiler_world as cworld
import cheng/std/bytes_layout as layout

fn AssertSingleSourceCidProtocol() =
    let root = parser.ParserNormalizePath(os.GetCurrentDir())
    let packageId = "cheng/source-identity-exact-single"
    let entryModule = "cheng/source-identity-exact-single/main"
    let sourceForRead = chengpath.PathAbsolute(
        root,
        "src/tests/compiler_world_source_identity_exact_smoke.cheng")
    let sourceText = os.ReadFile(sourceForRead)
    let sourceForSingle = "src/tests/compiler_world_source_identity_exact_smoke.cheng"
    let sourceForExists = chengpath.PathAbsolute(
        root,
        "src/tests/compiler_world_source_identity_exact_smoke.cheng")
    assert(os.FileExists(sourceForExists),
           "exact source identity: focused source unavailable through os")
    let directSingleCid = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        packageId,
        [entryModule],
        [sourceText])
    assert(IsOk(directSingleCid),
           "exact source identity: canonical module CID primitive failed")
    var canonicalRelativeSource: str
    assert(cworld.CompilerWorldCanonicalSourcePathInto(sourceForSingle,
                                                        canonicalRelativeSource),
           "exact source identity: single-source canonicalization failed")
    assert(canonicalRelativeSource == sourceForExists,
           "exact source identity: single-source canonicalization changed path")
    assert(os.FileExists(canonicalRelativeSource),
           "exact source identity: canonicalized single source unavailable")
    var singleCid: layout.FixedBytes32
    assert(cworld.CompilerWorldSourceBundleCidSingleModuleSourceInto(
               packageId,
               entryModule,
               sourceForSingle,
               singleCid),
           "exact source identity: package-bound module wrapper failed")
    assert(layout.FixedBytes32Equal(singleCid, Value(directSingleCid)),
           "exact source identity: package-bound wrapper retained physical path")
    var foreignModuleCid: layout.FixedBytes32
    assert(!cworld.CompilerWorldSourceBundleCidSingleModuleSourceInto(
                packageId,
                "cheng/foreign-owner/main",
                sourceForSingle,
                foreignModuleCid),
           "exact source identity: package-bound wrapper accepted foreign module owner")

    let zeroSourceForCleanup = "/tmp/compiler_world_source_identity_exact_zero.cheng"
    let missingSourceForCleanup = "/tmp/compiler_world_source_identity_exact_missing.cheng"
    if os.FileExists(zeroSourceForCleanup):
        assert(os.RemoveFile("/tmp/compiler_world_source_identity_exact_zero.cheng"),
               "exact source identity: stale zero source cleanup")
    if os.FileExists(missingSourceForCleanup):
        assert(os.RemoveFile("/tmp/compiler_world_source_identity_exact_missing.cheng"),
               "exact source identity: stale missing source cleanup")
    os.WriteFile("/tmp/compiler_world_source_identity_exact_zero.cheng", "")
    assert(os.FileExists("/tmp/compiler_world_source_identity_exact_zero.cheng"),
           "exact source identity: zero-byte source creation")
    var zeroCid: layout.FixedBytes32
    let zeroSourceForSingle = "/tmp/compiler_world_source_identity_exact_zero.cheng"
    assert(cworld.CompilerWorldSourceBundleCidSingleModuleSourceInto(
               "cheng/source-identity-exact-zero",
               "cheng/source-identity-exact-zero/main",
               zeroSourceForSingle,
               zeroCid),
           "exact source identity: zero-byte source rejected")
    let directZeroCid = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        "cheng/source-identity-exact-zero",
        ["cheng/source-identity-exact-zero/main"],
        [""])
    assert(IsOk(directZeroCid) &&
           layout.FixedBytes32Equal(zeroCid, Value(directZeroCid)),
           "exact source identity: zero-byte wrapper differs from kind-aware CID")
    var missingCid: layout.FixedBytes32
    assert(!cworld.CompilerWorldSourceBundleCidSingleModuleSourceInto(
                "cheng/source-identity-exact-missing",
                "cheng/source-identity-exact-missing/main",
                "/tmp/compiler_world_source_identity_exact_missing.cheng",
                missingCid),
           "exact source identity: missing source accepted as zero bytes")
    assert(os.RemoveFile("/tmp/compiler_world_source_identity_exact_zero.cheng"),
           "exact source identity: zero source cleanup")

fn AssertPureImportSpecs() =
    var specs: parser.ParserImportSpec[]
    var err: str
    let sourceText = strutil.Join([
        "import no/such/module as ghost\n",
        "import cheng/core/[lang/parser, tooling/path]\n"
    ], "")
    assert(parser.ParserReadImportSpecs("cheng/exact_import_owner",
                                        sourceText,
                                        specs,
                                        err),
           Fmt"exact source identity: pure import specs failed {err}")
    assert(specs.len == 3 &&
           specs[0].ownerModulePath == "cheng/exact_import_owner" &&
           specs[0].targetModulePath == "no/such/module" &&
           specs[0].importAlias == "ghost" &&
           specs[1].targetModulePath == "cheng/core/lang/parser" &&
           specs[1].importAlias == "" &&
           specs[2].targetModulePath == "cheng/core/tooling/path" &&
           specs[2].importAlias == "",
           "exact source identity: pure import specs changed grouped/as grammar")
    assert(!parser.ParserReadImportSpecs(
                "cheng/exact_import_owner",
                "import cheng/core/[lang/parser] as grouped\n",
                specs,
                err),
           "exact source identity: grouped import alias accepted")
    assert(!parser.ParserReadImportSpecs(
                "cheng/exact_import_owner",
                "import cheng/core/[ , ]\n",
                specs,
                err),
           "exact source identity: empty grouped import accepted")

fn ExactIdentityCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(seed)
    return out

fn AssertManifestReverseSort() =
    var reverseEntries = [
        cworld.CompilerUniverseManifestEntryMake(
            "cheng/zeta", ExactIdentityCid(1), ExactIdentityCid(2),
            ExactIdentityCid(3), ExactIdentityCid(4)),
        cworld.CompilerUniverseManifestEntryMake(
            "cheng/gamma", ExactIdentityCid(5), ExactIdentityCid(6),
            ExactIdentityCid(7), ExactIdentityCid(8)),
        cworld.CompilerUniverseManifestEntryMake(
            "cheng/beta", ExactIdentityCid(9), ExactIdentityCid(10),
            ExactIdentityCid(11), ExactIdentityCid(12)),
        cworld.CompilerUniverseManifestEntryMake(
            "cheng/alpha", ExactIdentityCid(13), ExactIdentityCid(14),
            ExactIdentityCid(15), ExactIdentityCid(16))
    ]
    let manifestRes = cworld.CompilerUniverseManifestMake(
        "stable",
        reverseEntries,
        ExactIdentityCid(20))
    assert(IsOk(manifestRes),
           "exact source identity: reverse manifest rejected")
    let manifest = Value(manifestRes)
    assert(manifest.entries.len == 4 &&
           manifest.entries[0].packageId == "cheng/alpha" &&
           manifest.entries[1].packageId == "cheng/beta" &&
           manifest.entries[2].packageId == "cheng/gamma" &&
           manifest.entries[3].packageId == "cheng/zeta",
           "exact source identity: reverse manifest sort is not total")
    let report = cworld.CompilerUniverseManifestReport(manifest)
    var parsed: cworld.CompilerUniverseManifest
    let parsedRes = cworld.CompilerUniverseManifestFromReportText(report,
                                                                  parsed)
    assert(IsOk(parsedRes) && Value(parsedRes) &&
           layout.FixedBytes32Equal(parsed.manifestCid,
                                    manifest.manifestCid) &&
           layout.FixedBytes32Equal(
               parsed.entries[0].managedMirrorBundleCid,
               manifest.entries[0].managedMirrorBundleCid),
           "exact source identity: manifest report roundtrip drift")
    let manifestExtraField = strutil.Join([report,
                                           "\nunknown_field=1"], "")
    assert(IsErr(cworld.CompilerUniverseManifestFromReportText(
                     manifestExtraField,
                     parsed)),
           "exact source identity: manifest accepted extra field")
    let manifestFieldOrder = strutil.Replace(
        report,
        "channel=stable\nentry_count=4\n",
        "entry_count=4\nchannel=stable\n")
    assert(IsErr(cworld.CompilerUniverseManifestFromReportText(
                     manifestFieldOrder,
                     parsed)),
           "exact source identity: manifest accepted reordered fields")
    let manifestLeadingZero = strutil.Replace(report,
                                               "entry_count=4",
                                               "entry_count=04")
    assert(IsErr(cworld.CompilerUniverseManifestFromReportText(
                     manifestLeadingZero,
                     parsed)),
           "exact source identity: manifest accepted leading-zero count")
    let manifestDuplicatePackage = strutil.Replace(report,
                                                    "cheng/beta",
                                                    "cheng/alpha")
    assert(IsErr(cworld.CompilerUniverseManifestFromReportText(
                     manifestDuplicatePackage,
                     parsed)),
           "exact source identity: manifest accepted duplicate package")
    let zeroCidHex = layout.FixedBytes32Hex(layout.FixedBytes32())
    let manifestMissingProof = strutil.Replace(
        report,
        layout.FixedBytes32Hex(ExactIdentityCid(15)),
        zeroCidHex)
    assert(IsErr(cworld.CompilerUniverseManifestFromReportText(
                     manifestMissingProof,
                     parsed)),
           "exact source identity: manifest accepted mirror without proof")
    let manifestMissingMirror = strutil.Replace(
        report,
        layout.FixedBytes32Hex(ExactIdentityCid(16)),
        zeroCidHex)
    assert(IsErr(cworld.CompilerUniverseManifestFromReportText(
                     manifestMissingMirror,
                     parsed)),
           "exact source identity: manifest accepted proof without mirror")
    let manifestMissingDependencyReceipt = strutil.Replace(
        report,
        layout.FixedBytes32Hex(ExactIdentityCid(20)),
        zeroCidHex)
    assert(IsErr(cworld.CompilerUniverseManifestFromReportText(
                     manifestMissingDependencyReceipt,
                     parsed)),
           "exact source identity: manifest accepted mirrors without dependency receipt")
    assert(IsErr(cworld.CompilerUniverseManifestMake("stable",
                                                      reverseEntries)),
           "exact source identity: managed mirrors without aggregate receipt accepted")
    var unmanagedEntries = [
        cworld.CompilerUniverseManifestEntryMake(
            "cheng/unmanaged",
            ExactIdentityCid(24),
            ExactIdentityCid(25),
            layout.FixedBytes32())
    ]
    assert(IsErr(cworld.CompilerUniverseManifestMake(
                     "stable",
                     unmanagedEntries,
                     ExactIdentityCid(26))),
           "exact source identity: aggregate receipt without managed mirror accepted")
    let unmanagedManifestRes = cworld.CompilerUniverseManifestMake(
        "stable",
        unmanagedEntries,
        layout.FixedBytes32())
    assert(IsOk(unmanagedManifestRes),
           "exact source identity: unmanaged manifest fixture rejected")
    let unmanagedReport = cworld.CompilerUniverseManifestReport(
        Value(unmanagedManifestRes))
    let unexpectedDependencyReceipt = strutil.Replace(
        unmanagedReport,
        strutil.Join(["managed_dependency_receipt_cid=", zeroCidHex], ""),
        strutil.Join([
            "managed_dependency_receipt_cid=",
            layout.FixedBytes32Hex(ExactIdentityCid(26))
        ], ""))
    assert(IsErr(cworld.CompilerUniverseManifestFromReportText(
                     unexpectedDependencyReceipt,
                     parsed)),
           "exact source identity: manifest accepted dependency receipt without mirror")
    var incompletePair = [
        cworld.CompilerUniverseManifestEntryMake(
            "cheng/incomplete",
            ExactIdentityCid(17),
            ExactIdentityCid(18),
            ExactIdentityCid(19))
    ]
    assert(IsErr(cworld.CompilerUniverseManifestMake("stable",
                                                      incompletePair)),
           "exact source identity: stable proof without mirror accepted")

fn AssertWorldRoundtrip() =
    var extras: cworld.CompilerUniverseManifestEntry[]
    let universeRes =
        cworld.CompilerLocalUniverseBuildForChannelWithManifestEntries(
            "stable",
            ExactIdentityCid(21),
            ExactIdentityCid(22),
            ExactIdentityCid(23),
            layout.FixedBytes32(),
            extras)
    assert(IsOk(universeRes),
           "exact source identity: world build rejected")
    let universe = Value(universeRes)
    var err: str
    assert(cworld.CompilerPackageSnapshotStrictValidateInto(
               universe.compilerSnapshot,
               err) &&
           cworld.CompilerUniverseManifestStrictValidateInto(
               universe.manifest,
               err) &&
           cworld.CompilerWorldHeadStrictValidateInto(
               universe.worldHead,
               err) &&
           cworld.CompilerLocalUniverseStrictValidateInto(universe,
                                                           err),
           Fmt"exact source identity: world strict validation failed {err}")
    assert(universe.manifest.entries[0].packageId == "cheng/compiler",
           "exact source identity: compiler manifest entry order changed")
    var coordinatedManifestTamper =
        cworld.CompilerWorldOwnLocalUniverse(universe)
    coordinatedManifestTamper.manifest.entries[0].snapshotCid =
        ExactIdentityCid(40)
    coordinatedManifestTamper.manifest.manifestCid =
        cworld.CompilerWorldHashUniverseManifest(
            coordinatedManifestTamper.manifest.channel,
            coordinatedManifestTamper.manifest.managedDependencyReceiptCid,
            coordinatedManifestTamper.manifest.entries)
    coordinatedManifestTamper.worldHead.manifestRootCid =
        coordinatedManifestTamper.manifest.manifestCid
    coordinatedManifestTamper.worldHead.headCid =
        cworld.CompilerWorldHashHead(
            coordinatedManifestTamper.worldHead.universeId,
            coordinatedManifestTamper.worldHead.channel,
            coordinatedManifestTamper.worldHead.headEpoch,
            coordinatedManifestTamper.worldHead.prevHeadCid,
            coordinatedManifestTamper.worldHead.manifestRootCid,
            coordinatedManifestTamper.worldHead.csgRootCid,
            coordinatedManifestTamper.worldHead.compilerPkgCid,
            coordinatedManifestTamper.worldHead.stdPkgCid,
            coordinatedManifestTamper.worldHead.runtimePkgCid,
            coordinatedManifestTamper.worldHead.signature)
    assert(cworld.CompilerUniverseManifestStrictValidateInto(
               coordinatedManifestTamper.manifest,
               err) &&
           cworld.CompilerWorldHeadStrictValidateInto(
               coordinatedManifestTamper.worldHead,
               err),
           Fmt"exact source identity: coordinated mutation fixture is not self-consistent {err}")
    assert(!cworld.CompilerLocalUniverseStrictValidateInto(
                coordinatedManifestTamper,
                err) &&
           strutil.Contains(err, "manifest/package snapshot mismatch"),
           "exact source identity: coordinated manifest/head mutation bypassed package binding")

    var coordinatedDepsTamper = cworld.CompilerWorldOwnLocalUniverse(universe)
    coordinatedDepsTamper.compilerSnapshot.depsManifestCid =
        ExactIdentityCid(41)
    coordinatedDepsTamper.compilerSnapshot.snapshotCid =
        cworld.CompilerWorldHashPackageSnapshot(
            coordinatedDepsTamper.compilerSnapshot.packageId,
            coordinatedDepsTamper.compilerSnapshot.channel,
            coordinatedDepsTamper.compilerSnapshot.sourceBundleCid,
            coordinatedDepsTamper.compilerSnapshot.csgRootCid,
            coordinatedDepsTamper.compilerSnapshot.exportSurfaceCid,
            coordinatedDepsTamper.compilerSnapshot.syntaxSurfaceCid,
            coordinatedDepsTamper.compilerSnapshot.depsManifestCid,
            coordinatedDepsTamper.compilerSnapshot.migrationProofCid,
            coordinatedDepsTamper.compilerSnapshot.signature)
    coordinatedDepsTamper.manifest.entries[0].snapshotCid =
        coordinatedDepsTamper.compilerSnapshot.snapshotCid
    coordinatedDepsTamper.manifest.manifestCid =
        cworld.CompilerWorldHashUniverseManifest(
            coordinatedDepsTamper.manifest.channel,
            coordinatedDepsTamper.manifest.managedDependencyReceiptCid,
            coordinatedDepsTamper.manifest.entries)
    coordinatedDepsTamper.worldHead.manifestRootCid =
        coordinatedDepsTamper.manifest.manifestCid
    coordinatedDepsTamper.worldHead.compilerPkgCid =
        coordinatedDepsTamper.compilerSnapshot.snapshotCid
    coordinatedDepsTamper.worldHead.headCid = cworld.CompilerWorldHashHead(
        coordinatedDepsTamper.worldHead.universeId,
        coordinatedDepsTamper.worldHead.channel,
        coordinatedDepsTamper.worldHead.headEpoch,
        coordinatedDepsTamper.worldHead.prevHeadCid,
        coordinatedDepsTamper.worldHead.manifestRootCid,
        coordinatedDepsTamper.worldHead.csgRootCid,
        coordinatedDepsTamper.worldHead.compilerPkgCid,
        coordinatedDepsTamper.worldHead.stdPkgCid,
        coordinatedDepsTamper.worldHead.runtimePkgCid,
        coordinatedDepsTamper.worldHead.signature)
    assert(cworld.CompilerPackageSnapshotStrictValidateInto(
               coordinatedDepsTamper.compilerSnapshot,
               err) &&
           cworld.CompilerUniverseManifestStrictValidateInto(
               coordinatedDepsTamper.manifest,
               err) &&
           cworld.CompilerWorldHeadStrictValidateInto(
               coordinatedDepsTamper.worldHead,
               err),
           Fmt"exact source identity: coordinated deps fixture is not self-consistent {err}")
    assert(!cworld.CompilerLocalUniverseStrictValidateInto(
                coordinatedDepsTamper,
                err) &&
           strutil.Contains(err, "dependency manifest mismatch"),
           "exact source identity: coordinated dependency hash mutation bypassed closure binding")
    let snapshotReport = cworld.CompilerPackageSnapshotReport(
        universe.compilerSnapshot)
    var parsedSnapshot: cworld.CompilerPackageSnapshot
    let snapshotParse = cworld.CompilerPackageSnapshotFromReportText(
        snapshotReport,
        parsedSnapshot)
    assert(IsOk(snapshotParse) && Value(snapshotParse) &&
           layout.FixedBytes32Equal(parsedSnapshot.snapshotCid,
                                    universe.compilerSnapshot.snapshotCid),
           "exact source identity: package snapshot report roundtrip drift")
    assert(IsErr(cworld.CompilerPackageSnapshotFromReportText(
                     strutil.Join([snapshotReport,
                                   "\nunknown_field=1"], ""),
                     parsedSnapshot)),
           "exact source identity: package snapshot accepted extra field")
    let reorderedSnapshotReport = strutil.Replace(
        snapshotReport,
        "package_id=cheng/compiler\nchannel=stable\n",
        "channel=stable\npackage_id=cheng/compiler\n")
    assert(IsErr(cworld.CompilerPackageSnapshotFromReportText(
                     reorderedSnapshotReport,
                     parsedSnapshot)),
           "exact source identity: package snapshot accepted reordered fields")
    let leadingZeroSnapshotReport = strutil.Replace(
        snapshotReport,
        "package_id=cheng/compiler",
        "schema_generation=02\npackage_id=cheng/compiler")
    assert(IsErr(cworld.CompilerPackageSnapshotFromReportText(
                     leadingZeroSnapshotReport,
                     parsedSnapshot)),
           "exact source identity: package snapshot accepted legacy generation field")
    let oldSnapshotReport = strutil.Join(
        ["schema_generation=1\n", snapshotReport],
        "")
    assert(IsErr(cworld.CompilerPackageSnapshotFromReportText(
                     oldSnapshotReport,
                     parsedSnapshot)),
           "exact source identity: package snapshot accepted legacy schema metadata")
    let headReport = cworld.CompilerWorldHeadReport(universe.worldHead)
    var parsedHead: cworld.CompilerWorldHead
    let headParse = cworld.CompilerWorldHeadFromReportText(headReport,
                                                           parsedHead)
    assert(IsOk(headParse) && Value(headParse) &&
           layout.FixedBytes32Equal(parsedHead.headCid,
                                    universe.worldHead.headCid),
           "exact source identity: world head report roundtrip drift")
    assert(IsErr(cworld.CompilerWorldHeadFromReportText(
                     strutil.Join([headReport,
                                   "\nunknown_field=1"], ""),
                     parsedHead)),
           "exact source identity: world head accepted extra field")
    let reorderedHeadReport = strutil.Replace(
        headReport,
        "universe_id=cheng/compiler_universe\nchannel=stable\n",
        "channel=stable\nuniverse_id=cheng/compiler_universe\n")
    assert(IsErr(cworld.CompilerWorldHeadFromReportText(reorderedHeadReport,
                                                        parsedHead)),
           "exact source identity: world head accepted reordered fields")
    let leadingZeroHeadReport = strutil.Replace(headReport,
                                                 "head_epoch=1",
                                                 "head_epoch=01")
    assert(IsErr(cworld.CompilerWorldHeadFromReportText(leadingZeroHeadReport,
                                                        parsedHead)),
           "exact source identity: world head accepted leading-zero epoch")
    let oldHeadReport = strutil.Join(
        ["schema_generation=1\n", headReport],
        "")
    assert(IsErr(cworld.CompilerWorldHeadFromReportText(oldHeadReport,
                                                        parsedHead)),
           "exact source identity: world head accepted legacy schema metadata")
    let lockText = cworld.CompilerLockText(universe)
    let lockRes = cworld.CompilerLockSnapshotFromText(lockText,
                                                       "/tmp/exact.lock")
    assert(IsOk(lockRes) &&
           IsOk(cworld.CompilerWorldVerifyLock(universe, Value(lockRes))),
           "exact source identity: lock roundtrip drift")
    assert(IsErr(cworld.CompilerWorldVerifyLock(coordinatedManifestTamper,
                                                Value(lockRes))),
           "exact source identity: lock verification accepted coordinated manifest/head mutation")
    assert(IsErr(cworld.CompilerWorldVerifyLock(coordinatedDepsTamper,
                                                Value(lockRes))),
           "exact source identity: lock verification accepted coordinated dependency rehash")
    let oldLockText = strutil.Join(
        ["schema_generation = \"1\"\n", lockText],
        "")
    assert(IsErr(cworld.CompilerLockSnapshotFromText(oldLockText,
                                                      "/tmp/exact.lock")),
           "exact source identity: lock accepted legacy schema metadata")
    assert(IsErr(cworld.CompilerLockSnapshotFromText(
                     strutil.Join([lockText,
                                   "unknown_field = \"1\"\n"], ""),
                     "/tmp/exact.lock")),
           "exact source identity: lock accepted extra field")
    let reorderedLockText = strutil.Replace(
        lockText,
        strutil.Join([
            "channel = \"stable\"\nworld_head_cid = \"",
            layout.FixedBytes32Hex(universe.worldHead.headCid),
            "\"\n"
        ], ""),
        strutil.Join([
            "world_head_cid = \"",
            layout.FixedBytes32Hex(universe.worldHead.headCid),
            "\"\nchannel = \"stable\"\n"
        ], ""))
    assert(IsErr(cworld.CompilerLockSnapshotFromText(reorderedLockText,
                                                      "/tmp/exact.lock")),
           "exact source identity: lock accepted reordered fields")
    let leadingZeroLockText = strutil.Replace(lockText,
                                               "entry_count = \"3\"",
                                               "entry_count = \"03\"")
    assert(IsErr(cworld.CompilerLockSnapshotFromText(leadingZeroLockText,
                                                      "/tmp/exact.lock")),
           "exact source identity: lock accepted leading-zero count")
    let duplicateLockPackageText = strutil.Replace(
        lockText,
        "entry[1].package_id = \"cheng/runtime\"",
        "entry[1].package_id = \"cheng/compiler\"")
    assert(IsErr(cworld.CompilerLockSnapshotFromText(
                     duplicateLockPackageText,
                     "/tmp/exact.lock")),
           "exact source identity: lock accepted duplicate package")
    let unexpectedLockDependencyReceipt = strutil.Replace(
        lockText,
        strutil.Join([
            "managed_dependency_receipt_cid = \"",
            layout.FixedBytes32Hex(layout.FixedBytes32()),
            "\""
        ], ""),
        strutil.Join([
            "managed_dependency_receipt_cid = \"",
            layout.FixedBytes32Hex(ExactIdentityCid(30)),
            "\""
        ], ""))
    assert(IsErr(cworld.CompilerLockSnapshotFromText(
                     unexpectedLockDependencyReceipt,
                     "/tmp/exact.lock")),
           "exact source identity: lock accepted dependency receipt without mirror")
    let unorderedLockText = strutil.Replace(lockText,
                                            "cheng/compiler",
                                            "zz/compiler")
    assert(IsErr(cworld.CompilerLockSnapshotFromText(unorderedLockText,
                                                      "/tmp/exact.lock")),
           "exact source identity: unordered lock accepted")

    var managedEntries = [
        cworld.CompilerUniverseManifestEntryMake(
            "cheng/compiler",
            ExactIdentityCid(31),
            ExactIdentityCid(32),
            ExactIdentityCid(33),
            ExactIdentityCid(34))
    ]
    let managedUniverseRes =
        cworld.CompilerLocalUniverseBuildForChannelWithManifestEntries(
            "stable",
            ExactIdentityCid(21),
            ExactIdentityCid(22),
            ExactIdentityCid(23),
            ExactIdentityCid(33),
            ExactIdentityCid(35),
            managedEntries)
    assert(IsOk(managedUniverseRes),
           "exact source identity: managed world fixture rejected")
    let managedUniverse = Value(managedUniverseRes)
    let managedLockText = cworld.CompilerLockText(managedUniverse)
    let managedLockRes = cworld.CompilerLockSnapshotFromText(
        managedLockText,
        "/tmp/managed-exact.lock")
    assert(IsOk(managedLockRes) &&
           IsOk(cworld.CompilerWorldVerifyLock(managedUniverse,
                                                Value(managedLockRes))),
           "exact source identity: managed lock roundtrip drift")
    let managedMissingProof = strutil.Replace(
        managedLockText,
        layout.FixedBytes32Hex(ExactIdentityCid(33)),
        layout.FixedBytes32Hex(layout.FixedBytes32()))
    assert(IsErr(cworld.CompilerLockSnapshotFromText(
                     managedMissingProof,
                     "/tmp/managed-exact.lock")),
           "exact source identity: lock accepted mirror without proof")
    let managedMissingMirror = strutil.Replace(
        managedLockText,
        layout.FixedBytes32Hex(ExactIdentityCid(34)),
        layout.FixedBytes32Hex(layout.FixedBytes32()))
    assert(IsErr(cworld.CompilerLockSnapshotFromText(
                     managedMissingMirror,
                     "/tmp/managed-exact.lock")),
           "exact source identity: lock accepted proof without mirror")
    let managedMissingReceipt = strutil.Replace(
        managedLockText,
        layout.FixedBytes32Hex(ExactIdentityCid(35)),
        layout.FixedBytes32Hex(layout.FixedBytes32()))
    assert(IsErr(cworld.CompilerLockSnapshotFromText(
                     managedMissingReceipt,
                     "/tmp/managed-exact.lock")),
           "exact source identity: lock accepted mirror without dependency receipt")
    let managedProofTamper = strutil.Replace(
        managedLockText,
        layout.FixedBytes32Hex(ExactIdentityCid(33)),
        layout.FixedBytes32Hex(ExactIdentityCid(36)))
    let managedProofTamperRes = cworld.CompilerLockSnapshotFromText(
        managedProofTamper,
        "/tmp/managed-exact.lock")
    assert(IsOk(managedProofTamperRes) &&
           IsErr(cworld.CompilerWorldVerifyLock(
               managedUniverse,
               Value(managedProofTamperRes))),
           "exact source identity: lock verification accepted proof mutation")
    let managedMirrorTamper = strutil.Replace(
        managedLockText,
        layout.FixedBytes32Hex(ExactIdentityCid(34)),
        layout.FixedBytes32Hex(ExactIdentityCid(37)))
    let managedMirrorTamperRes = cworld.CompilerLockSnapshotFromText(
        managedMirrorTamper,
        "/tmp/managed-exact.lock")
    assert(IsOk(managedMirrorTamperRes) &&
           IsErr(cworld.CompilerWorldVerifyLock(
               managedUniverse,
               Value(managedMirrorTamperRes))),
           "exact source identity: lock verification accepted mirror mutation")
    let managedReceiptTamper = strutil.Replace(
        managedLockText,
        layout.FixedBytes32Hex(ExactIdentityCid(35)),
        layout.FixedBytes32Hex(ExactIdentityCid(38)))
    let managedReceiptTamperRes = cworld.CompilerLockSnapshotFromText(
        managedReceiptTamper,
        "/tmp/managed-exact.lock")
    assert(IsOk(managedReceiptTamperRes) &&
           IsErr(cworld.CompilerWorldVerifyLock(
               managedUniverse,
               Value(managedReceiptTamperRes))),
           "exact source identity: lock verification accepted dependency receipt mutation")

fn main(): int32 =
    AssertSingleSourceCidProtocol()
    AssertPureImportSpecs()
    AssertManifestReverseSort()
    AssertWorldRoundtrip()
    let root = parser.ParserNormalizePath(os.GetCurrentDir())
    let codexRoot = chengpath.PathAbsolute(root, "codex")
    let rustRoot = chengpath.PathAbsolute(root, "rust-csg-core")
    let codexSource = chengpath.PathAbsolute(
        codexRoot,
        "src/shared/item.cheng")
    let rustSource = chengpath.PathAbsolute(
        rustRoot,
        "src/shared/item.cheng")
    var rootsAB: parser.ParserExternalPackageRoot[]
    add(rootsAB,
        parser.ParserExternalPackageRootCertifiedNew("cheng/codex",
                                                      "cheng/codex",
                                                      codexRoot))
    add(rootsAB,
        parser.ParserExternalPackageRootCertifiedNew("cheng/rust-csg-core",
                                                      "cheng/rust-csg-core",
                                                      rustRoot))
    var rootsBA: parser.ParserExternalPackageRoot[]
    add(rootsBA,
        parser.ParserExternalPackageRootCertifiedNew("cheng/rust-csg-core",
                                                      "cheng/rust-csg-core",
                                                      rustRoot))
    add(rootsBA,
        parser.ParserExternalPackageRootCertifiedNew("cheng/codex",
                                                      "cheng/codex",
                                                      codexRoot))

    var modulePath: str
    assert(parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsAB,
               codexSource,
               modulePath) &&
           modulePath == "cheng/codex/shared/item",
           "exact source identity: codex root")
    assert(parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsBA,
               rustSource,
               modulePath) &&
           modulePath == "cheng/rust-csg-core/shared/item",
           "exact source identity: external root order")

    var sourcePaths = [codexSource, rustSource]
    var identitiesAB: str[]
    var identitiesBA: str[]
    assert(cworld.CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsAB,
               sourcePaths,
               identitiesAB) &&
           cworld.CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsBA,
               sourcePaths,
               identitiesBA) &&
           identitiesAB.len == 2 && identitiesBA.len == 2 &&
           identitiesAB[0] == "cheng/codex/shared/item" &&
           identitiesAB[1] == "cheng/rust-csg-core/shared/item" &&
           identitiesBA[0] == identitiesAB[0] &&
           identitiesBA[1] == identitiesAB[1],
           "exact source identity: same relative paths remain distinct and order independent")

    var noExternalRoots: parser.ParserExternalPackageRoot[]
    let cwdOnlyStd = chengpath.PathAbsolute(root,
                                             "src/std/cwd_identity_alias.cheng")
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                codexRoot,
                codexRoot,
                "cheng/codex",
                noExternalRoots,
                cwdOnlyStd,
                modulePath),
           "exact source identity: CWD builtin alias accepted")
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                rootsAB,
                "/outside/other/shared/item.cheng",
                modulePath),
           "exact source identity: outside-root basename fallback accepted")
    var outsideIdentityPaths: str[]
    assert(!cworld.CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                rootsAB,
                ["/outside/other/shared/item.cheng"],
                outsideIdentityPaths),
           "exact source identity: Cworld accepted outside-root basename fallback")
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                rootsAB,
                chengpath.PathAbsolute(codexRoot,
                                       "src/shared/item.cheng.mutated"),
                modulePath),
           "exact source identity: mutated extension accepted")
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                rootsAB,
                strutil.Join([codexRoot,
                              "/src/../../../outside/shared/item.cheng"],
                             ""),
                modulePath),
           "exact source identity: path traversal escaped owner")
    assert(parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsAB,
               strutil.Join([codexRoot,
                             "/src/shared/nested/../item.cheng"],
                            ""),
               modulePath) &&
           modulePath == "cheng/codex/shared/item",
           "exact source identity: lexical normalization")

    var aliasRoots: parser.ParserExternalPackageRoot[]
    add(aliasRoots,
        parser.ParserExternalPackageRootCertifiedNew("cheng/codex",
                                                      "cheng/codex",
                                                      codexRoot))
    add(aliasRoots,
        parser.ParserExternalPackageRootCertifiedNew("codex",
                                                      "cheng/codex",
                                                      codexRoot))
    assert(parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                aliasRoots,
                codexSource,
                modulePath) &&
           modulePath == "cheng/codex/shared/item",
           "exact source identity: certified bare alias changed canonical owner")
    var aliasRootsReversed: parser.ParserExternalPackageRoot[]
    add(aliasRootsReversed,
        parser.ParserExternalPackageRootCertifiedNew("codex",
                                                      "cheng/codex",
                                                      codexRoot))
    add(aliasRootsReversed,
        parser.ParserExternalPackageRootCertifiedNew("cheng/codex",
                                                      "cheng/codex",
                                                      codexRoot))
    assert(parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                aliasRootsReversed,
                codexSource,
                modulePath) &&
           modulePath == "cheng/codex/shared/item",
           "exact source identity: certified alias canonicalization depends on root order")
    var aliasIdentityForward: str[]
    var aliasIdentityReverse: str[]
    var codexSourceOnly = [codexSource]
    assert(cworld.CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               aliasRoots,
               codexSourceOnly,
               aliasIdentityForward) &&
           cworld.CompilerWorldSourceBundleIdentityPathsWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               aliasRootsReversed,
               codexSourceOnly,
               aliasIdentityReverse) &&
           aliasIdentityForward.len == 1 && aliasIdentityReverse.len == 1 &&
           aliasIdentityForward[0] == "cheng/codex/shared/item" &&
           aliasIdentityReverse[0] == aliasIdentityForward[0],
           "exact source identity: certified alias order changed Cworld identity")

    var inverseCanonicalModule: str
    var inverseSourcePath: str
    assert(parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsAB,
               "cheng/codex/shared/item",
               inverseCanonicalModule,
               inverseSourcePath) &&
           inverseCanonicalModule == "cheng/codex/shared/item" &&
           inverseSourcePath == codexSource,
           "exact source identity: canonical module inverse")
    assert(parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               aliasRoots,
               "codex/shared/item",
               inverseCanonicalModule,
               inverseSourcePath) &&
           inverseCanonicalModule == "cheng/codex/shared/item" &&
           inverseSourcePath == codexSource,
           "exact source identity: certified alias inverse")
    assert(parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               aliasRootsReversed,
               "codex/shared/item",
               inverseCanonicalModule,
               inverseSourcePath) &&
           inverseCanonicalModule == "cheng/codex/shared/item" &&
           inverseSourcePath == codexSource,
           "exact source identity: alias inverse depends on root order")
    assert(parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsAB,
               "std/bytes_layout",
               inverseCanonicalModule,
               inverseSourcePath) &&
           inverseCanonicalModule == "std/bytes_layout" &&
           inverseSourcePath == chengpath.PathAbsolute(
               root,
               "src/std/bytes_layout.cheng"),
           "exact source identity: std inverse provenance")
    assert(parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsAB,
               "cheng/std/bytes_layout",
               inverseCanonicalModule,
               inverseSourcePath) &&
           inverseCanonicalModule == "std/bytes_layout" &&
           inverseSourcePath == chengpath.PathAbsolute(
               root,
               "src/std/bytes_layout.cheng"),
           "exact source identity: compatibility std inverse provenance")
    assert(parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsAB,
               "runtime/mobile",
               inverseCanonicalModule,
               inverseSourcePath) &&
           inverseCanonicalModule == "runtime/mobile" &&
           inverseSourcePath == chengpath.PathAbsolute(
               root,
               "src/runtime/mobile.cheng"),
           "exact source identity: runtime inverse provenance")
    assert(parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               rootsAB,
               "cheng/runtime/mobile",
               inverseCanonicalModule,
               inverseSourcePath) &&
           inverseCanonicalModule == "runtime/mobile" &&
           inverseSourcePath == chengpath.PathAbsolute(
               root,
               "src/runtime/mobile.cheng"),
           "exact source identity: compatibility runtime inverse provenance")
    assert(!parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                aliasRoots,
                "codex/./shared/item",
                inverseCanonicalModule,
                inverseSourcePath),
           "exact source identity: inverse accepted dot segment")
    assert(!parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                aliasRoots,
                "codex//shared/item",
                inverseCanonicalModule,
                inverseSourcePath),
           "exact source identity: inverse accepted empty module segment")
    assert(!parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                aliasRoots,
                "codex/shared item",
                inverseCanonicalModule,
                inverseSourcePath),
           "exact source identity: inverse accepted module whitespace")
    assert(!parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                aliasRoots,
                "pkg://cheng/codex/shared/item",
                inverseCanonicalModule,
                inverseSourcePath),
           "exact source identity: inverse accepted pkg URI")
    assert(!parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                aliasRoots,
                "codex",
                inverseCanonicalModule,
                inverseSourcePath),
           "exact source identity: inverse accepted owner without source relative path")
    var forgedAliasRoots: parser.ParserExternalPackageRoot[]
    add(forgedAliasRoots,
        parser.ParserExternalPackageRootCertifiedNew("unrelated",
                                                      "cheng/codex",
                                                      codexRoot))
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                forgedAliasRoots,
                codexSource,
                modulePath),
           "exact source identity: unrelated import alias accepted as certificate")
    var uncertifiedRoots: parser.ParserExternalPackageRoot[]
    add(uncertifiedRoots,
        parser.ParserExternalPackageRootNew("cheng/codex", codexRoot))
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                uncertifiedRoots,
                codexSource,
                modulePath),
           "exact source identity: import-only root accepted without canonical certificate")
    assert(!parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                uncertifiedRoots,
                "cheng/codex/shared/item",
                inverseCanonicalModule,
                inverseSourcePath),
           "exact source identity: inverse accepted import-only root")
    var duplicateCanonicalRoots: parser.ParserExternalPackageRoot[]
    add(duplicateCanonicalRoots,
        parser.ParserExternalPackageRootCertifiedNew("codex",
                                                      "cheng/codex",
                                                      codexRoot))
    add(duplicateCanonicalRoots,
        parser.ParserExternalPackageRootCertifiedNew("codex",
                                                      "cheng/codex",
                                                      rustRoot))
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                duplicateCanonicalRoots,
                codexSource,
                modulePath),
           "exact source identity: canonical package id accepted two physical roots")
    var conflictingOwnerRoots: parser.ParserExternalPackageRoot[]
    add(conflictingOwnerRoots,
        parser.ParserExternalPackageRootCertifiedNew("codex",
                                                      "cheng/codex",
                                                      codexRoot))
    add(conflictingOwnerRoots,
        parser.ParserExternalPackageRootCertifiedNew("other",
                                                      "cheng/other",
                                                      codexRoot))
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                conflictingOwnerRoots,
                codexSource,
                modulePath),
           "exact source identity: physical root accepted conflicting certified owners")

    var builtinAliasCollisionRoots: parser.ParserExternalPackageRoot[]
    add(builtinAliasCollisionRoots,
        parser.ParserExternalPackageRootCertifiedNew("std",
                                                      "cheng/std",
                                                      codexRoot))
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                builtinAliasCollisionRoots,
                codexSource,
                modulePath),
           "exact source identity: forward accepted certified std owner forgery")
    assert(!parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                builtinAliasCollisionRoots,
                "std/shared/item",
                inverseCanonicalModule,
                inverseSourcePath),
           "exact source identity: inverse accepted ambiguous builtin alias owner")
    var builtinRuntimeCollisionRoots: parser.ParserExternalPackageRoot[]
    add(builtinRuntimeCollisionRoots,
        parser.ParserExternalPackageRootCertifiedNew("runtime",
                                                      "cheng/runtime",
                                                      codexRoot))
    assert(!parser.ParserSourcePathToModulePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                builtinRuntimeCollisionRoots,
                codexSource,
                modulePath),
           "exact source identity: forward accepted certified runtime owner forgery")
    assert(!parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
                root,
                root,
                "cheng",
                builtinRuntimeCollisionRoots,
                "runtime/shared/item",
                inverseCanonicalModule,
                inverseSourcePath),
           "exact source identity: inverse accepted runtime owner forgery")

    let upperChannel =
        "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    let lowerChannel =
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    let upperChannelRoot = parser.ParserExternalPackageRootCertifiedNewWithChannel(
        "codex",
        "cheng/codex",
        codexRoot,
        upperChannel)
    assert(upperChannelRoot.channel == lowerChannel,
           "exact source identity: certified channel is not lowercase canonical")
    var mixedCaseChannelRoots: parser.ParserExternalPackageRoot[]
    add(mixedCaseChannelRoots, upperChannelRoot)
    add(mixedCaseChannelRoots,
        parser.ParserExternalPackageRootCertifiedNewWithChannel(
            "cheng/codex",
            "cheng/codex",
            codexRoot,
            lowerChannel))
    assert(parser.ParserModulePathToSourcePathExactWithExternalPackageRootsInto(
               root,
               root,
               "cheng",
               mixedCaseChannelRoots,
               "codex/shared/item",
               inverseCanonicalModule,
               inverseSourcePath) &&
           inverseCanonicalModule == "cheng/codex/shared/item" &&
           inverseSourcePath == codexSource,
           "exact source identity: channel case split one certified owner")

    var sourceTexts = ["", "fn Value(): int32 = 7"]
    let cidAB = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        "cheng/source-identity-exact-smoke",
        identitiesAB,
        sourceTexts)
    var reverseIdentities = [identitiesAB[1], identitiesAB[0]]
    var reverseTexts = [sourceTexts[1], sourceTexts[0]]
    let cidBA = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        "cheng/source-identity-exact-smoke",
        reverseIdentities,
        reverseTexts)
    assert(IsOk(cidAB) && IsOk(cidBA) &&
           layout.FixedBytes32Equal(Value(cidAB), Value(cidBA)),
           "exact source identity: empty source or pair order changed CID")

    var mutatedIdentities = ["cheng/codex/shared/item_mutated",
                             identitiesAB[1]]
    let mutatedCid = cworld.CompilerWorldSourceBundleCidFromIdentityTexts(
        "cheng/source-identity-exact-smoke",
        mutatedIdentities,
        sourceTexts)
    assert(IsOk(mutatedCid) &&
           !layout.FixedBytes32Equal(Value(cidAB), Value(mutatedCid)),
           "exact source identity: module mutation preserved CID")
    var invalidKindCid: layout.FixedBytes32
    assert(!cworld.CompilerWorldSourceBundleCidFromIdentityTextsInto(
                "cheng/source-identity-exact-smoke",
                identitiesAB,
                [sourceTexts[0]],
                invalidKindCid),
           "exact source identity: split identity/text columns accepted")
    assert(!cworld.CompilerWorldSourceBundleCidFromIdentityTextsInto(
                "pkg://cheng/source-identity-exact-smoke",
                identitiesAB,
                sourceTexts,
                invalidKindCid),
           "exact source identity: noncanonical package URI accepted")
    assert(!cworld.CompilerWorldSourceBundleCidFromIdentityTextsInto(
                " cheng/source-identity-exact-smoke ",
                identitiesAB,
                sourceTexts,
                invalidKindCid),
           "exact source identity: padded package id accepted")
    assert(!cworld.CompilerWorldSourceBundleCidFromIdentityTextsInto(
                "cheng/source-identity-exact-smoke",
                ["cheng/codex/./shared/item"],
                [""],
                invalidKindCid),
           "exact source identity: module dot segment accepted by CID primitive")
    assert(!cworld.CompilerWorldSourceBundleCidFromIdentityTextsInto(
                "cheng/source-identity-exact-smoke",
                ["cheng/codex//shared/item"],
                [""],
                invalidKindCid),
           "exact source identity: module empty segment accepted by CID primitive")
    assert(!cworld.CompilerWorldSourceBundleCidFromIdentityTextsInto(
                "cheng/source-identity-exact-smoke",
                ["cheng/codex/shared item"],
                [""],
                invalidKindCid),
           "exact source identity: module whitespace accepted by CID primitive")
    assert(!cworld.CompilerWorldSourceBundleCidFromIdentityTextsInto(
                "cheng/source-identity-exact-smoke",
                ["src/shared/item.cheng"],
                [""],
                invalidKindCid),
           "exact source identity: relative source path accepted as module identity")
    assert(!cworld.CompilerWorldSourceBundleCidFromIdentityTextsInto(
                "cheng/source-identity-exact-smoke",
                ["/tmp/source/../shared/item.cheng"],
                [""],
                invalidKindCid),
           "exact source identity: source path accepted as module identity")

    echo(" compiler_world_source_identity_exact_smoke ok")
    return 0
