import std/strings
import std/strutils as strutil

@borrows
fn cloneStrSequenceLiteralAppend(out: var str,
                                 key: str,
                                 value: str) =
    let ownedKey = strings.CloneStr(key)
    let ownedValue = strings.CloneStr(value)
    let suffix = strutil.Join([ownedKey, "=", ownedValue, "\n"], "")
    let prefix = strings.CloneStr(out)
    out = strings.ConcatStr(prefix, suffix)

fn main(): int32 =
    var line: str
    cloneStrSequenceLiteralAppend(line, "alpha", "beta")
    if line != "alpha=beta\n":
        return 1
    return 0
