# shape: two-level nested FIXED-SIZE array, tail field scalar, constant indices.
# Grid.rows[0].cols[1].a = v (Row.cols is a fixed-size array, not a dynamic seq)
type
    Col =
        a: int32
        b: int32

type
    Row =
        cols: Col[4]

type
    Grid =
        rows: Row[4]

fn main(): int32 =
    var g: Grid
    g.rows[0].cols[0].a = 1
    g.rows[0].cols[0].b = 11
    g.rows[0].cols[1].a = 2
    g.rows[0].cols[1].b = 22
    g.rows[1].cols[0].a = 3
    g.rows[1].cols[0].b = 33
    g.rows[1].cols[1].a = 4
    g.rows[1].cols[1].b = 44

    g.rows[0].cols[1].a = 999

    if g.rows[0].cols[1].a != 999:
        return 1
    if g.rows[0].cols[1].b != 22:
        return 2
    if g.rows[0].cols[0].a != 1:
        return 3
    if g.rows[1].cols[0].a != 3:
        return 4
    if g.rows[1].cols[1].a != 4:
        return 5
    return 0
