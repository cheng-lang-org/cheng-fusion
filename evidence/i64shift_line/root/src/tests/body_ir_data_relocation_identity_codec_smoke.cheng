import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend2/backend2_frag_codec as codec
import cheng/core/ir/body_ir_lifecycle as lifecycle
import cheng/core/ir/core_types as coreir
import cheng/std/bytes_layout as layout
import std/os as os
import std/rawbytes as rawbytes
import std/result

fn cidFromHex(text: str): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(text)
    assert(IsOk(parsed), "data relocation identity: CID parse")
    return Value(parsed)

fn globalCid(): layout.FixedBytes32 =
    return cidFromHex(
        "4141414141414141414141414141414141414141414141414141414141414141")

fn functionCid(): layout.FixedBytes32 =
    return cidFromHex(
        "4242424242424242424242424242424242424242424242424242424242424242")

fn fragmentCid(): layout.FixedBytes32 =
    return cidFromHex(
        "4343434343434343434343434343434343434343434343434343434343434343")

fn typeArenaCid(): layout.FixedBytes32 =
    return cidFromHex(
        "4444444444444444444444444444444444444444444444444444444444444444")

fn appendSlot(body: var coreir.BodyIR,
              slotId: int32,
              placeKind: int32) =
    var slot: coreir.LocalSlot
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.id = slotId
    slot.typeKind = coreir.LocalI64Tag
    slot.placeKind = placeKind
    slot.sizeBytes = 8
    slot.alignBytes = 8
    add(body.localSlots, slot)

fn appendCString(body: var coreir.BodyIR,
                 literalRow: int32,
                 text: str,
                 label: str) =
    var literal: coreir.CStringLiteralEntry
    literal.id = literalRow
    literal.text = text
    literal.dataLabel = label
    add(body.cstringLiterals, literal)

fn buildBody(): coreir.BodyIR =
    var body = coreir.BodyIRNew()
    assert(coreir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid()),
           "data relocation identity: TypeArena bind")
    appendSlot(body, 0, coreir.BodyPlaceStackValueTag)
    appendSlot(body, 1, coreir.BodyPlaceGlobalAddressTag)
    appendSlot(body, 2, coreir.BodyPlaceGlobalAddressTag)
    appendCString(body, 0, "alpha", "legacy_alpha_label")
    appendCString(body, 1, "\xe4\xb8\xad", "legacy_utf8_label")
    coreir.BodyIRDataRelocationIdentitySync(body)
    coreir.BodyIRBindLocalAddressTarget(
        body, 1, coreir.BodyDataRelocTargetDomainTypedGlobalTag,
        37, globalCid())
    coreir.BodyIRBindLocalAddressTarget(
        body, 2, coreir.BodyDataRelocTargetDomainFunctionTag,
        19, functionCid())
    coreir.BodyIRBindCStringTarget(body, 0, fragmentCid())
    coreir.BodyIRBindCStringTarget(body, 1, fragmentCid())
    coreir.BodyIRSealDataRelocationIdentity(body)
    assert(coreir.BodyIRDataRelocationIdentityStrictValidate(body),
           "data relocation identity: source strict validation")
    return body

fn dataIdentityTagOffset(encoded: rawbytes.Bytes): int32 =
    # Fields 1/2/4/5 are empty and local names are empty in this fixture.
    # Walk field 6 by its encoded lengths so identity never depends on text.
    var cursor: int32 = 8 + 8 + 8 + 8 + 3 * 56 + 8 + 8
    assert(codec.Backend2CodecReadU32(encoded, cursor) == 6,
           "data relocation identity: tag 6 missing")
    let literalCount = codec.Backend2CodecReadU32(encoded, cursor)
    for _ in 0..<literalCount:
        let _ = codec.Backend2CodecReadU32(encoded, cursor)
        let textBytes = codec.Backend2CodecReadU32(encoded, cursor)
        cursor = cursor + textBytes
        let labelBytes = codec.Backend2CodecReadU32(encoded, cursor)
        cursor = cursor + labelBytes
    let offset = cursor
    assert(codec.Backend2CodecReadU32(encoded, cursor) == 18,
           "data relocation identity: tag 18 missing")
    return offset

@borrows
fn primaryPrevalidateMutationsReject(
        encoded: rawbytes.Bytes,
        tagOffset: int32) =
    assert(primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(encoded),
           "data relocation identity: primary rejected canonical payload")

    var oldMagic = rawbytes.BytesSlice(encoded, 0, encoded.len)
    codec.Backend2CodecPutU32(oldMagic, 0, 0x42424955)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(oldMagic),
           "data relocation identity: primary accepted old magic")
    rawbytes.BytesFree(oldMagic)

    var unsealed = rawbytes.BytesSlice(encoded, 0, encoded.len)
    codec.Backend2CodecPutU32(unsealed, tagOffset + 4, 0)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(unsealed),
           "data relocation identity: primary accepted unsealed targets")
    rawbytes.BytesFree(unsealed)

    var missingLocalRow = rawbytes.BytesSlice(encoded, 0, encoded.len)
    codec.Backend2CodecPutU32(missingLocalRow, tagOffset + 32, -1)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(
               missingLocalRow),
           "data relocation identity: primary accepted missing local row")
    rawbytes.BytesFree(missingLocalRow)

    var wrongCStringRow = rawbytes.BytesSlice(encoded, 0, encoded.len)
    codec.Backend2CodecPutU32(wrongCStringRow, tagOffset + 148, 0)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(
               wrongCStringRow),
           "data relocation identity: primary accepted wrong cstring row")
    rawbytes.BytesFree(wrongCStringRow)

    var zeroCStringOwner = rawbytes.BytesSlice(encoded, 0, encoded.len)
    for offset in 188..<220:
        rawbytes.BytesSet(zeroCStringOwner, tagOffset + offset, 0)
    assert(!primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(
               zeroCStringOwner),
           "data relocation identity: primary accepted zero cstring owner")
    rawbytes.BytesFree(zeroCStringOwner)

fn main(): int32 =
    var body = buildBody()
    let negativeMode = os.GetEnv("CHENG_DATA_RELOC_IDENTITY_NEGATIVE")
    if negativeMode == "local_shape":
        setLen(body.localAddressTargetRows, 2)
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: local shape mutation accepted")
    if negativeMode == "nonaddress_bound":
        body.localAddressTargetDomainKinds[0] =
            coreir.BodyDataRelocTargetDomainTypedGlobalTag
        body.localAddressTargetRows[0] = 1
        body.localAddressTargetCids[0] = globalCid()
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: non-address target accepted")
    if negativeMode == "local_missing":
        body.localAddressTargetDomainKinds[1] =
            coreir.BodyDataRelocTargetDomainInvalidTag
        body.localAddressTargetRows[1] = -1
        body.localAddressTargetCids[1] = layout.FixedBytes32()
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: missing local target accepted")
    if negativeMode == "local_domain":
        body.localAddressTargetDomainKinds[1] = 99
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: invalid local domain accepted")
    if negativeMode == "local_row":
        body.localAddressTargetRows[1] = -1
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: invalid local row accepted")
    if negativeMode == "local_cid":
        body.localAddressTargetCids[1] = layout.FixedBytes32()
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: zero local CID accepted")
    if negativeMode == "cstring_shape":
        setLen(body.cstringTargetRows, 1)
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: CString shape mutation accepted")
    if negativeMode == "cstring_row":
        body.cstringTargetRows[1] = 0
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: wrong CString row accepted")
    if negativeMode == "cstring_id":
        body.cstringLiterals[1].id = 7
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: wrong literal identity accepted")
    if negativeMode == "cstring_cid":
        body.cstringOwnerFunctionFragmentCids[1] =
            layout.FixedBytes32()
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: zero owner CID accepted")
    if negativeMode == "unsealed_nonempty":
        body.dataRelocationIdentitySealed = false
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: unsealed payload accepted")
    if negativeMode == "unsealed_absent":
        body.dataRelocationIdentitySealed = false
        body.localAddressTargetDomainKinds = []
        body.localAddressTargetRows = []
        body.localAddressTargetCids = []
        body.cstringTargetRows = []
        body.cstringOwnerFunctionFragmentCids = []
        let _ = codec.Backend2BodyIrEncode(body)
        panic("data relocation identity: absent target identity accepted")
    if negativeMode == "rebind":
        body.dataRelocationIdentitySealed = false
        coreir.BodyIRBindLocalAddressTarget(
            body, 1, coreir.BodyDataRelocTargetDomainTypedGlobalTag,
            38, globalCid())
        panic("data relocation identity: rebound target accepted")
    var encoded = codec.Backend2BodyIrEncode(body)
    if negativeMode == "old_magic":
        codec.Backend2CodecPutU32(encoded, 0, 0x42424955)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, cursor)
        panic("data relocation identity: old codec magic accepted")
    if negativeMode == "field_count":
        codec.Backend2CodecPutU32(encoded, 4, 17)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, cursor)
        panic("data relocation identity: old field count accepted")
    let tagOffset = dataIdentityTagOffset(encoded)
    primaryPrevalidateMutationsReject(encoded, tagOffset)
    if negativeMode == "wire_tag":
        codec.Backend2CodecPutU32(encoded, tagOffset, 11)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, cursor)
        panic("data relocation identity: missing tag 18 accepted")
    if negativeMode == "wire_cstring_row":
        let cstringRowsFirstValueOffset = tagOffset + 144
        codec.Backend2CodecPutU32(
            encoded, cstringRowsFirstValueOffset + 4, 0)
        var cursor: int32
        let _ = codec.Backend2BodyIrDecode(encoded, cursor)
        panic("data relocation identity: wire CString row mutation accepted")
    var cursor: int32
    var decoded = codec.Backend2BodyIrDecode(encoded, cursor)
    var reencoded = codec.Backend2BodyIrEncode(decoded)
    assert(cursor == encoded.len &&
           rawbytes.BytesEqual(encoded, reencoded) &&
           coreir.BodyIRDataRelocationIdentityStrictValidate(decoded) &&
           decoded.localAddressTargetDomainKinds[1] ==
               coreir.BodyDataRelocTargetDomainTypedGlobalTag &&
           decoded.localAddressTargetRows[1] == 37 &&
           layout.FixedBytes32Equal(
               decoded.localAddressTargetCids[1], globalCid()) &&
           decoded.localAddressTargetDomainKinds[2] ==
               coreir.BodyDataRelocTargetDomainFunctionTag &&
           decoded.localAddressTargetRows[2] == 19 &&
           decoded.cstringTargetRows[1] == 1 &&
           layout.FixedBytes32Equal(
               decoded.cstringOwnerFunctionFragmentCids[1],
               fragmentCid()),
           "data relocation identity: byte round-trip")
    let retained = lifecycle.BodyIrPayloadRetained(decoded)
    assert(retained.physicalBufferCount > 0 &&
           retained.retainedBytes > int64(0),
           "data relocation identity: lifecycle retained")
    let releaseReceipt = lifecycle.BodyIrPayloadRelease(decoded)
    assert(releaseReceipt.storageReleased &&
           lifecycle.BodyIrPayloadIsReleased(decoded),
           "data relocation identity: lifecycle release")
    rawbytes.BytesFree(reencoded)
    rawbytes.BytesFree(encoded)
    os.WriteLine(
        os.Get_stdout(),
        "body_ir_data_relocation_identity ok local_rows=3 cstring_rows=2 byte_exact=1 lifecycle=1")
    return 0
