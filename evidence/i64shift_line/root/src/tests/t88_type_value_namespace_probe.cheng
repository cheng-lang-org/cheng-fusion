# T88 namespace probe: named-field syntax must retain its formal object
# constructor meaning even when the value namespace contains the same name.

type
    Pair =
        left: int32
        right: int32

fn Pair(left: int32, right: int32): int32 =
    return left * 100 + right

fn Named(left: int32, right: int32): int32 =
    return left * 10 + right

fn main(): int32 =
    let namedFields = Pair(left: 3, right: 4)
    let positionalCall = Pair(5, 6)
    let namedCall = Named(left: 7, right: 8)
    if namedFields.left != 3 || namedFields.right != 4:
        return 1
    if positionalCall != 506:
        return 2
    if namedCall != 78:
        return 3
    return 0
