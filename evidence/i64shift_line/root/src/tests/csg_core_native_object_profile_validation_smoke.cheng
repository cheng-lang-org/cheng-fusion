import std/os as os
import std/strings
import std/strutils as strutil
import cheng/core/csg_core/native_object_profile_validation as profile

const
    SchemaFact: str =
        "{\"features\":[\"native_object_emission_plan_replay\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    EmptySha256: str =
        "sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    FourZeroSha256: str =
        "sha256:df3f619804a92fdb4057192dc43dd748ea778adc52bc498ce80524c014b81119"
    EightZeroSha256: str =
        "sha256:af5570f5a1810b7af78caf4bc70a660f0df51e42baf91d4de5b2328de0e83dfc"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn baseManifest(textByteCount: int32,
                textSha256: str,
                relocationCount: int32): str =
    return Fmt"{{\"actualBackendKind\":\"primary\",\"complete\":true,\"dataByteCount\":0,\"dataChunkCount\":0,\"dataSha256\":\"{EmptySha256}\",\"debugAbbrevByteCount\":0,\"debugAbbrevChunkCount\":0,\"debugAbbrevSha256\":\"{EmptySha256}\",\"debugInfoByteCount\":0,\"debugInfoChunkCount\":0,\"debugInfoSha256\":\"{EmptySha256}\",\"debugLineByteCount\":0,\"debugLineChunkCount\":0,\"debugLineSha256\":\"{EmptySha256}\",\"debugRelocationCount\":0,\"debugSourceReceiptCid\":null,\"debugValid\":false,\"entryFunctionSymbol\":\"main\",\"entrySymbol\":\"_main\",\"id\":\"native-object-emission-plan\",\"kind\":\"csg_dialect::native::object_emission_plan\",\"objectFormat\":\"macho\",\"relocationCount\":{relocationCount},\"symbolCount\":1,\"targetTriple\":\"arm64-apple-darwin\",\"textByteCount\":{textByteCount},\"textChunkCount\":1,\"textSha256\":\"{textSha256}\"}}"

fn symbolFact(global: bool): str =
    let globalText = global ? "true" : "false"
    return Fmt"{{\"global\":{globalText},\"id\":\"native-object-symbol-0\",\"kind\":\"csg_dialect::native::object_symbol\",\"name\":\"main\",\"offset\":0,\"ordinal\":0,\"sectionIndex\":0,\"size\":4,\"undefined\":false}}"

fn validLines(): str[] =
    return [
        SchemaFact,
        baseManifest(4, FourZeroSha256, 0),
        "{\"byteCount\":4,\"id\":\"native-object-section-text-0\",\"kind\":\"csg_dialect::native::object_section_chunk\",\"offset\":0,\"ordinal\":0,\"payloadBase64\":\"AAAAAA==\",\"section\":\"text\"}",
        symbolFact(true)
    ]

@borrows
fn expectReject(lines: str[],
                expected: str,
                label: str): int32 =
    let checked =
        profile.CsgCoreNativeObjectProfileValidate(lines)
    if checked.ok:
        return fail(strings.ConcatStr(label, ": accepted"))
    if checked.error != expected:
        os.WriteLine(os.Get_stderr(), checked.error)
        return fail(strings.ConcatStr(label, ": wrong error"))
    return 0

fn main(): int32 =
    let valid = validLines()
    let accepted =
        profile.CsgCoreNativeObjectProfileValidate(valid)
    if !accepted.ok || len(accepted.error) != 0:
        os.WriteLine(os.Get_stderr(), accepted.error)
        return fail("valid native object facts rejected")

    var hashTamper = validLines()
    hashTamper[2] = strutil.Replace(
        hashTamper[2], "AAAAAA==", "AQAAAA==")
    if expectReject(
           hashTamper,
           "native_object_profile_section_hash_mismatch",
           "payload hash tamper") != 0:
        return 1

    var extraField = validLines()
    extraField[3] =
        "{\"extra\":0,\"global\":true,\"id\":\"native-object-symbol-0\",\"kind\":\"csg_dialect::native::object_symbol\",\"name\":\"main\",\"offset\":0,\"ordinal\":0,\"sectionIndex\":0,\"size\":4,\"undefined\":false}"
    if expectReject(
           extraField,
           "native_object_profile_symbol_ordinal_invalid",
           "extra field") != 0:
        return 1

    var ordinalHole = validLines()
    ordinalHole[2] =
        "{\"byteCount\":4,\"id\":\"native-object-section-text-1\",\"kind\":\"csg_dialect::native::object_section_chunk\",\"offset\":0,\"ordinal\":1,\"payloadBase64\":\"AAAAAA==\",\"section\":\"text\"}"
    if expectReject(
           ordinalHole,
           "native_object_profile_section_chunk_closure_invalid",
           "ordinal hole") != 0:
        return 1

    let duplicateRelocation = [
        SchemaFact,
        baseManifest(8, EightZeroSha256, 2),
        "{\"byteCount\":8,\"id\":\"native-object-section-text-0\",\"kind\":\"csg_dialect::native::object_section_chunk\",\"offset\":0,\"ordinal\":0,\"payloadBase64\":\"AAAAAAAAAAA=\",\"section\":\"text\"}",
        symbolFact(true),
        "{\"addend\":0,\"id\":\"native-object-relocation-0\",\"kind\":\"csg_dialect::native::object_relocation\",\"offset\":0,\"ordinal\":0,\"pcRelative\":false,\"relocationKind\":1,\"sectionIndex\":0,\"symbolIndex\":0}",
        "{\"addend\":0,\"id\":\"native-object-relocation-1\",\"kind\":\"csg_dialect::native::object_relocation\",\"offset\":0,\"ordinal\":1,\"pcRelative\":false,\"relocationKind\":1,\"sectionIndex\":0,\"symbolIndex\":0}"
    ]
    if expectReject(
           duplicateRelocation,
           "native_object_profile_relocation_duplicate",
           "duplicate reloc") != 0:
        return 1

    var localEntry = validLines()
    localEntry[3] = symbolFact(false)
    if expectReject(
           localEntry,
           "native_object_profile_entry_function_missing",
           "local entry") != 0:
        return 1

    os.WriteLine(
        os.Get_stdout(),
        "csg_core_native_object_profile_validation_smoke ok")
    return 0
