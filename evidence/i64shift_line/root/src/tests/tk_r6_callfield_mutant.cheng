type
    R6MutBundle =
        cacheMode: str
        count: int32

fn R6MutCacheMode(): str =
    return "content"

fn R6MutFill(out: var R6MutBundle) =
    out = R6MutBundle()
    out.cacheMode = R6MutCacheMode()
    out.count = 3

fn main(): int32 =
    var bundle: R6MutBundle
    R6MutFill(bundle)
    if bundle.cacheMode != "WRONG":
        return 10
    return 0
