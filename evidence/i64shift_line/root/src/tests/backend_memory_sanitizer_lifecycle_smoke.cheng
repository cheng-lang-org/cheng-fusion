import cheng/core/backend2/backend2_assembler_lifecycle as b2life

const BackendMemorySanitizerCycles: int32 = 5000

type
    BackendMemorySanitizerTotals =
        cycles: int32
        allocated: int64
        released: int64
        allocatedBytes: int64
        releasedBytes: int64
        releasedPhysicalBufferCount: int64
        releasedPhysicalBytes: int64

fn BackendMemorySanitizerAccumulate(
        totals: var BackendMemorySanitizerTotals,
        receipt: b2life.Backend2AssemblerTempReleaseReceipt,
        expectedOutcome: int32) =
    assert(receipt.outcome == expectedOutcome,
           "backend sanitizer lifecycle: outcome mismatch")
    assert(receipt.allocated == receipt.released &&
           receipt.live == int64(0) &&
           receipt.allocatedBytes == receipt.releasedBytes &&
           receipt.liveBytes == int64(0),
           "backend sanitizer lifecycle: ledger mismatch")
    assert(receipt.rowStorageReleased &&
           receipt.aggregateStorageReleased &&
           receipt.allSymbolStorageReleased &&
           receipt.workerStorageReleased &&
           receipt.workerEndpointsClosedAndReaped &&
           receipt.ledgerStorageReleased &&
           receipt.ledgerStorageReleasedBufferCount > 0 &&
           receipt.ledgerStorageReleasedBytes > int64(0) &&
           receipt.releasedPhysicalBufferCount > 0 &&
           receipt.releasedPhysicalBytes > int64(0),
           "backend sanitizer lifecycle: physical release mismatch")
    totals.cycles = totals.cycles + 1
    totals.allocated = totals.allocated + receipt.allocated
    totals.released = totals.released + receipt.released
    totals.allocatedBytes =
        totals.allocatedBytes + receipt.allocatedBytes
    totals.releasedBytes =
        totals.releasedBytes + receipt.releasedBytes
    totals.releasedPhysicalBufferCount =
        totals.releasedPhysicalBufferCount +
            int64(receipt.releasedPhysicalBufferCount)
    totals.releasedPhysicalBytes =
        totals.releasedPhysicalBytes +
            receipt.releasedPhysicalBytes

fn BackendMemorySanitizerFinalize(
        state: var b2life.Backend2AssemblerTempLifecycle,
        outcome: int32,
        totals: var BackendMemorySanitizerTotals) =
    var receipt: b2life.Backend2AssemblerTempReleaseReceipt
    var err: str
    assert(
        b2life.Backend2AssemblerTempLifecycleFinalizeStrictInto(
            state, outcome, receipt, err),
        err)
    BackendMemorySanitizerAccumulate(
        totals, receipt, outcome)

fn BackendMemorySanitizerSuccessCycle(
        cycle: int32,
        totals: var BackendMemorySanitizerTotals) =
    var state: b2life.Backend2AssemblerTempLifecycle
    b2life.Backend2AssemblerTempLifecycleBeginInvocation(state)
    b2life.Backend2AssemblerLifecycleAppendAllSymbolName(
        state, Fmt"_san_success_function_{cycle}")
    b2life.Backend2AssemblerLifecycleAppendAllSymbolName(
        state, Fmt"_san_success_callee_{cycle}")
    b2life.Backend2AssemblerLifecycleAppendWorkerEndpoint(
        state, cycle + 1, cycle + 10001)
    b2life.Backend2AssemblerLifecycleAppendWorkerEndpoint(
        state, cycle + 20001, cycle + 30001)
    b2life.Backend2AssemblerLifecycleBindWorkerArrays(state)
    b2life.Backend2AssemblerLifecycleMoveWorkerArraysToReceiver(
        state)
    b2life.Backend2AssemblerLifecycleReleaseWorkerArrays(
        state, true)
    b2life.Backend2AssemblerLifecycleMoveAllSymbolsToAssembler(
        state)
    BackendMemorySanitizerFinalize(
        state,
        b2life.Backend2AssemblerTempOutcomeSuccess,
        totals)

fn BackendMemorySanitizerFailureCycle(
        cycle: int32,
        totals: var BackendMemorySanitizerTotals) =
    var state: b2life.Backend2AssemblerTempLifecycle
    b2life.Backend2AssemblerTempLifecycleBeginInvocation(state)
    b2life.Backend2AssemblerLifecycleAppendAllSymbolName(
        state, Fmt"_san_failure_function_{cycle}")
    b2life.Backend2AssemblerLifecycleAppendWorkerEndpoint(
        state, cycle + 1, cycle + 10001)
    b2life.Backend2AssemblerLifecycleBindWorkerArrays(state)
    b2life.Backend2AssemblerLifecycleReleaseWorkerArrays(
        state, true)
    BackendMemorySanitizerFinalize(
        state,
        b2life.Backend2AssemblerTempOutcomeFailure,
        totals)

fn BackendMemorySanitizerRun(mode: str) =
    var totals: BackendMemorySanitizerTotals
    for cycle in 0..<BackendMemorySanitizerCycles:
        if mode == "success":
            BackendMemorySanitizerSuccessCycle(
                cycle, totals)
        elif mode == "failure":
            BackendMemorySanitizerFailureCycle(
                cycle, totals)
        else:
            panic("backend sanitizer lifecycle: invalid mode")
    assert(totals.cycles == BackendMemorySanitizerCycles &&
           totals.allocated == totals.released &&
           totals.allocatedBytes == totals.releasedBytes &&
           totals.releasedPhysicalBufferCount > int64(0) &&
           totals.releasedPhysicalBytes > int64(0),
           "backend sanitizer lifecycle: aggregate receipt mismatch")
    echo(Fmt"backend_memory_sanitizer_lifecycle path={mode} cycles={totals.cycles} ledger_live=0 ledger_live_bytes=0 allocated={totals.allocated} released={totals.released} allocated_bytes={totals.allocatedBytes} released_bytes={totals.releasedBytes} physical_buffers_released={totals.releasedPhysicalBufferCount} physical_bytes_released={totals.releasedPhysicalBytes} alloc_free_balanced=1")

fn main(): int32 =
    BackendMemorySanitizerRun("success")
    BackendMemorySanitizerRun("failure")
    return 0
