import std/cmdline as cmdline
import std/system

@importc("cheng_runtime_heap_new")
fn runtimeHeapNew(size: int32): ptr

@importc("cheng_atomic_store_i32")
fn atomicStoreI32(raw: ptr, value: int32)

fn releaseSelected(raw: ptr, atomicRelease: bool) =
    if atomicRelease:
        memReleaseAtomic(raw)
        return
    memRelease(raw)

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var mode: str
    if !cmdline.readFlagValue("--mode", mode):
        return 90
    let atomicRelease =
        mode == "atomic_underflow" ||
        mode == "atomic_registry_miss" ||
        mode == "atomic_double_release" ||
        mode == "atomic_wrong_object"

    if mode == "normal_underflow" || mode == "atomic_underflow":
        let raw = runtimeHeapNew(16)
        if raw == nil:
            return 91
        atomicStoreI32(SystemPtrAdd(raw, -8), 0)
        releaseSelected(raw, atomicRelease)
        return 92

    if mode == "normal_registry_miss" ||
       mode == "atomic_registry_miss":
        var foreignValue: int32 = 7
        releaseSelected(&foreignValue, atomicRelease)
        return 93

    if mode == "normal_double_release" ||
       mode == "atomic_double_release":
        let raw = runtimeHeapNew(16)
        if raw == nil:
            return 94
        releaseSelected(raw, atomicRelease)
        releaseSelected(raw, atomicRelease)
        return 95

    if mode == "normal_wrong_object" ||
       mode == "atomic_wrong_object":
        let raw = runtimeHeapNew(16)
        if raw == nil:
            return 96
        releaseSelected(SystemPtrAdd(raw, 1), atomicRelease)
        return 97

    return 98
