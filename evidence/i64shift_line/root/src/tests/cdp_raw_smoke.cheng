# cdp_raw_smoke.cheng - Direct CDP test, no oracle wrapper
import cheng/core/runtime/cdp_client as cdp
import std/strings

fn main(): int32 =
    var conn = cdp.cdpTcpConnect(9222)
    if !cdp.cdpIsAlive(conn):
        return 1
    var pagesJson = cdp.cdpDiscoverPages(conn)
    cdp.cdpDisconnect(conn)
    if strings.len(pagesJson) <= 0:
        return 2
    
    # Extract first ws URL
    var wsUrl = cdp.cdpExtractFirstWsUrl(pagesJson)
    if strings.len(wsUrl) <= 0:
        return 3
    
    # Connect and upgrade
    var wsConn = cdp.cdpTcpConnect(9222)
    if !cdp.cdpIsAlive(wsConn):
        return 4
    if !cdp.cdpWebSocketUpgrade(wsConn, wsUrl):
        cdp.cdpDisconnect(wsConn)
        return 5
    
    # Get document
    var docJson: str
    if !cdp.cdpGetDocument(wsConn, docJson):
        cdp.cdpDisconnect(wsConn)
        return 6
    cdp.cdpDisconnect(wsConn)
    
    if strings.len(docJson) > 0:
        return 0
    return 7
