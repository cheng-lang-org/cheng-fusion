type
    ColdRefObjectBorrowSequenceHeaderRemovedOuter = ref object
        values: int32[]

fn ColdRefObjectBorrowSequenceHeaderRemovedWrite(
        values: var int32[]) =
    add(values, 17)

fn ColdRefObjectBorrowSequenceHeaderRemovedMutate(
        out: var ColdRefObjectBorrowSequenceHeaderRemovedOuter) =
    var values = out.values
    let forbiddenLength = 1
    ColdRefObjectBorrowSequenceHeaderRemovedWrite(values)
    if forbiddenLength == 0:
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowSequenceHeaderRemovedOuter)
    ColdRefObjectBorrowSequenceHeaderRemovedMutate(out)
    return 0
