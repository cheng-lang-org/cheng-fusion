# peephole_r3_redgreen.cheng — wdfs_line 刀红绿夹具（动态验证阶梯②）
#
# 形状依据（BodyIR dump 实证）：
#   while 环的空闘块编号在 ret/exit 块之后（dump: header=5,body=6,ret=7,latch=8）
#   → [header..last] 吞进 ret 块 → cold_a64_loop_term_allowed 见 RET 即拒
#   → plan 必不成立 → peephole 永不命中（阴性对照 arm，while 版保留）。
#   for/range 环无空闘块尾随 → plan 成立 → AND+INDEX_DYNAMIC 相邻且 tmp 单读
#   → peephole 命中。
#
# 红（未打 wdfs_peephole_r3_clobber.patch）：mask 31 != arr_len-1=63 → bounds 不省略
#   → `codegen_mov_i32_const(code, R3, 64)` 每轮把迭代子 R3（regs[0]=CBR term_value）
#   写成数组长度 → i2 变 65 → cond 假 → 环只跑一轮 → sum=4（红，rc=1）。
# 绿（打刀后）：R2 作 bounds scratch → sum=3040（rc=0）。
# elided arm（mask==N-1）走省略臂，证明省略路径不受刀影响。

import std/strings

fn scan32(): int32 =
    var arr: int32[64]
    for i in 0..<64:
        arr[i] = i * 3 + 1
    var sum: int32
    for i2 in 0..<64:
        sum = sum + arr[i2 & 31]
    return sum

fn scan_while_negative_control(): int32 =
    var arr: int32[64]
    var i: int32
    while i < 64:
        arr[i] = i * 3 + 1
        i = i + 1
    var sum: int32
    var i2: int32
    while i2 < 64:
        sum = sum + arr[i2 & 31]
        i2 = i2 + 1
    return sum

fn scan_elided(): int32 =
    var arr: int32[64]
    for i in 0..<64:
        arr[i] = i
    var sum: int32
    for i2 in 0..<64:
        sum = sum + arr[i2 & 63]
    return sum

fn main(): int32 =
    let s1: int32 = scan32()
    echo("scan32 sum=" + strings.Int64ToStr(int64(s1)))
    if s1 != 3040:
        return 1
    let sw: int32 = scan_while_negative_control()
    echo("scan_while sum=" + strings.Int64ToStr(int64(sw)))
    if sw != 3040:
        return 3
    let s2: int32 = scan_elided()
    if s2 != 2016:
        return 2
    echo("peephole_r3_redgreen ok")
    return 0
