import cheng/core/backend/native_object_emission_plan as native
import cheng/core/backend/object_relocs as reloc
import cheng/core/backend/object_symbols as symbol
import std/rawbytes
import std/os

fn buildPlan(plan: var native.NativeObjectEmissionPlan,
             relocCount: int32,
             duplicateLast: bool) =
    plan.targetTriple = "riscv64-unknown-linux-gnu"
    plan.objectFormat = "elf"
    plan.actualBackendKind = "primary"
    plan.entrySymbol = "entry"
    plan.entryFunctionSymbol = "entry"
    plan.text = rawbytes.BytesAlloc(relocCount * 4)
    assert(symbol.ObjectSymbolsAddDefined(
               plan.symbols, "entry", 0, int64(0),
               int64(relocCount * 4), true) == 0,
           "linear reloc entry")
    assert(symbol.ObjectSymbolsAddUndefined(
               plan.symbols, "callee", true) == 1,
           "linear reloc target")
    for relocIndex in 0..<relocCount:
        var offset = relocIndex * 4
        if duplicateLast && relocIndex == relocCount - 1:
            offset = 0
        let _ = reloc.ObjectRelocsAdd(
            plan.relocs, 0, int64(offset), 1,
            reloc.ObjectRelocAbs32, int64(0), false)

fn main(): int32 =
    var seen: int32[]
    assert(native.NativeObjectEmissionByteOffsetBitsetInit(100, seen) &&
           seen.len == 4,
           "bitset init")
    assert(native.NativeObjectEmissionByteOffsetBitsetMark(
               seen, 100, int64(30)) &&
           native.NativeObjectEmissionByteOffsetBitsetMark(
               seen, 100, int64(31)) &&
           native.NativeObjectEmissionByteOffsetBitsetMark(
               seen, 100, int64(62)) &&
           !native.NativeObjectEmissionByteOffsetBitsetMark(
               seen, 100, int64(31)),
           "bitset boundary")
    assert(native.NativeObjectEmissionByteOffsetBitsetInit(100, seen) &&
           native.NativeObjectEmissionByteOffsetBitsetMark(
               seen, 100, int64(31)),
           "bitset reset")

    var positive: native.NativeObjectEmissionPlan
    buildPlan(positive, 4096, false)
    var positiveErr: str
    assert(native.NativeObjectEmissionPlanValidateInto(
               positive, positiveErr),
           positiveErr)
    native.NativeObjectEmissionPlanRelease(positive)

    var duplicate: native.NativeObjectEmissionPlan
    buildPlan(duplicate, 2, true)
    var duplicateErr: str
    assert(!native.NativeObjectEmissionPlanValidateInto(
               duplicate, duplicateErr) &&
           duplicateErr ==
               "native object emission plan: duplicate relocation",
           "duplicate reloc rejection")
    native.NativeObjectEmissionPlanRelease(duplicate)

    os.WriteLine(
        os.GetStdout(),
        "native_object_reloc_linear_smoke=pass relocs=4096 mutations=4")
    return 0
