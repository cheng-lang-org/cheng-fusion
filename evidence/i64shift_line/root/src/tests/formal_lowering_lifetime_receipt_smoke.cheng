    assert(
        resolvedCallTargetProjectionOwnerReceipt(false),
        "formal lowering resolved-call target projection owner: positive")
    assert(runLifecycle(
               false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false),
           "formal lowering lifetime receipt: positive")
    os.WriteLine(
        os.GetStdout(),
        "formal_lowering_lifetime_receipt_smoke ok")
    return 0
