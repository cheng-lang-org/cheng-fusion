fn populateCanonicalSnapshotProjectionAllocator(
        plan: var lower.LoweringPlanStub) =
    lower.LoweringCanonicalSnapshotProjectionSetDomains(plan, 40, 40)
    for row in 0..<40:
        lower.LoweringCanonicalSnapshotProjectionAppendCallRow(
            plan,
            row,
            row,
            row,
            row)
        lower.LoweringCanonicalSnapshotProjectionAppendValueDefinitionRow(
            plan,
            row)

fn populateTypeArenaOwnerProofAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringTypeArenaOwnerProofAppendFunctionRow(
            plan,
            row,
            row % 2)
        lower.LoweringTypeArenaOwnerProofAppendGlobalRow(
            plan,
            row + 40,
            row % 2)

fn populateSemanticDebugProjectionAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringSemanticDebugProjectionAppendFunctionId(
            plan,
            row)
        lower.LoweringSemanticDebugProjectionAppendNodeRow(
            plan,
            row + 40,
            row + 80)

fn populatePrimaryObjectIrCallTargetAllocator(
        fnIr: var lower.PrimaryObjectIrFunction,
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
            fnIr,
            row,
            Fmt"tracked_target_{row}",
            Fmt"/tracked/source_{row}.cheng",
            row + 1,
            false,
            row,
            "",
            Fmt"arg_type_{row}")
    let indirectStart = fnIr.callTargets.len
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 2, "cheng_call_ptr_i32_raw", "/tracked/indirect.cheng",
        90, false, -1, "", "int64,int32")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 2, "tracked_after_indirect", "/tracked/indirect.cheng",
        91, false, 91, "", "int64,int32")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 2, "cheng_call_ptr_void_raw", "/tracked/indirect.cheng",
        92, false, -1, "", "int64,int32")
    if os.GetEnv("CHENG_FORMAL_LOWERING_LIFETIME_NEGATIVE") ==
           "call-target-shape":
        add(fnIr.callArgCounts, 1)
    lower.LoweringRemoveIndirectCallIntrinsicTargetsFromIndex(
        fnIr, indirectStart)
    if fnIr.callTargets.len != 41:
        panic("formal lowering call target fixture: indirect rebuild mismatch")
    let indirectRebuildPeakBytes =
        fnIr.callTargetAllocatorLedger.peakLiveCapacityBytes
    lower.LoweringPrimaryObjectIrCallTargetClear(fnIr)
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 1, "len", "/tracked/builtin.cheng",
        93, false, -1, "", "str")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 1, "range", "/tracked/builtin.cheng",
        94, false, -1, "", "int32")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 1, "bytesLen", "/tracked/builtin.cheng",
        95, false, -1, "", "str")
    lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
        fnIr, 1, "sizeof", "/tracked/builtin.cheng",
        96, false, -1, "", "int32")
    var sourceTexts: texpr.TypedExprSourceText[]
    lower.LoweringRemoveBuiltinCallTargets(fnIr, plan, sourceTexts)
    if fnIr.callTargets.len != 0:
        panic("formal lowering call target fixture: builtin rebuild mismatch")
    if fnIr.callTargetAllocatorLedger.peakLiveCapacityBytes <
           indirectRebuildPeakBytes:
        panic("formal lowering call target fixture: rebuild peak regressed")
    for row in 0..<40:
        lower.LoweringPrimaryObjectIrCallTargetAppendExactRow(
            fnIr,
            row,
            Fmt"terminal_target_{row}",
            Fmt"/terminal/source_{row}.cheng",
            row + 100,
            false,
            row,
            "",
            Fmt"terminal_type_{row}")
    if !lower.LoweringPrimaryObjectIrCallTargetShapeComplete(fnIr) ||
       fnIr.callTargets.len != 40:
        panic("formal lowering call target fixture: rebuild shape mismatch")

fn buildTrackedPlan(): lower.LoweringPlanStub =
    var out: lower.LoweringPlanStub
    var fnIr: lower.PrimaryObjectIrFunction
    populatePrimaryObjectIrCallTargetAllocator(fnIr, out)
    populateTypedFunctionReferenceAllocator(out)
    populateTypedFunctionIndexAllocator(out)
    populateTypedFunctionIdentityAllocator(out)
    lower.LoweringBuildResolvedCallFactIndex(out)
    populateResolvedCallFactAllocator(out)
    lower.LoweringPlanReleaseImportGraphPayload(out)
    lower.LoweringImportGraphAllocatorBegin(out)
    populateImportGraphAllocator(out)
    lower.LoweringBuildImportEdgeIndex(out)
    populateImportEdgeIndexAllocator(out)
    populateImportOwnerIndexAllocator(out)
    populateQualifiedImportResolveCacheAllocator(out)
    populateUnqualifiedImportResolveCacheAllocator(out)
    lower.LoweringPlanReleaseModuleSourceIndexPayload(out)
    lower.LoweringModuleSourceIndexAllocatorBegin(out)
    populateModuleSourceIndexAllocator(out)
    lower.LoweringPlanReleaseFnPtrFieldCallPayload(out)
    lower.LoweringFnPtrFieldCallAllocatorBegin(out)
    populateFnPtrFieldCallAllocator(out)
    lower.LoweringPlanReleaseTypeArenaOwnerProofPayload(out)
    lower.LoweringTypeArenaOwnerProofAllocatorBegin(out)
    populateTypeArenaOwnerProofAllocator(out)
    lower.LoweringPlanReleaseSemanticIdentityPayload(out)
    lower.LoweringFunctionSemanticIdentityAllocatorBegin(out)
    populateFunctionSemanticIdentityAllocator(out)
    lower.LoweringPlanReleaseFunctionRuntimeIdentityPayload(out)
    lower.LoweringFunctionRuntimeIdentityAllocatorBegin(out)
    populateFunctionRuntimeIdentityAllocator(out)
    lower.LoweringPlanReleaseFunctionEmissionMetadataPayload(out)
    lower.LoweringFunctionEmissionMetadataAllocatorBegin(out)
    populateFunctionEmissionMetadataAllocator(out)
    lower.LoweringPlanReleaseCanonicalSnapshotProjectionPayload(out)
    lower.LoweringCanonicalSnapshotProjectionAllocatorBegin(out)
    populateCanonicalSnapshotProjectionAllocator(out)
    lower.LoweringPlanReleaseSemanticDebugPayload(out)
    lower.LoweringSemanticDebugProjectionAllocatorBegin(out)
    populateSemanticDebugProjectionAllocator(out)
    fnIr.deferScopeTransport = nonEmptyDeferScopeTransport()
    fnIr.ownershipTransport = nonEmptyOwnershipTransport()
    fnIr.signatureLineNumber = 101
    fnIr.bodyLineNumber = 102
    add(out.primaryObjectIr.functions, fnIr)
    lower.LoweringPlanCapturePrimaryObjectLineRows(out)
    return out

fn resolvedCallTargetProjectionOwnerReceipt(
        mutateReceipt: bool): bool =
    var zeroPlan: lower.LoweringPlanStub
    lower.LoweringResolvedCallTargetProjectionBegin(zeroPlan, 0)
    if lower.LoweringResolvedCallTargetProjectionCapacity(zeroPlan) != 0:
        return false
    lower.LoweringResolvedCallTargetProjectionMoveToPlan(zeroPlan)
    let zeroRetainedBeforeRelease =
        lower.LoweringResolvedCallTargetProjectionRetainedBytes(zeroPlan)
    lower.LoweringResolvedCallTargetProjectionRelease(zeroPlan)
    var zeroReceipt: lower.LoweringResolvedCallTargetProjectionReceipt
    lower.LoweringResolvedCallTargetProjectionReceiptInto(
        zeroPlan, zeroReceipt)
    if !lower.LoweringResolvedCallTargetProjectionReceiptClosed(
           zeroReceipt) ||
       zeroReceipt.allocated != int64(0) ||
       zeroReceipt.released != int64(0) ||
       zeroReceipt.physicalFreeCount != 0 ||
       zeroRetainedBeforeRelease !=
           zeroReceipt.ledgerStorageReleasedBytes ||
       !lower.LoweringResolvedCallTargetProjectionReceiptConsumeStrict(
           zeroPlan, zeroReceipt):
        return false

    var plan: lower.LoweringPlanStub
    lower.LoweringResolvedCallTargetProjectionBegin(plan, 3)
    let reservedCapacity =
        lower.LoweringResolvedCallTargetProjectionCapacity(plan)
    if reservedCapacity < 3:
        return false
    lower.LoweringResolvedCallTargetProjectionAppend(plan, 7)
    if lower.LoweringResolvedCallTargetProjectionCapacity(plan) !=
           reservedCapacity:
        return false
    lower.LoweringResolvedCallTargetProjectionAppend(plan, -1)
    if lower.LoweringResolvedCallTargetProjectionCapacity(plan) !=
           reservedCapacity:
        return false
    lower.LoweringResolvedCallTargetProjectionAppend(plan, 11)
    if lower.LoweringResolvedCallTargetProjectionCapacity(plan) !=
           reservedCapacity:
        return false
    lower.LoweringResolvedCallTargetProjectionMoveToPlan(plan)
    let retainedBeforeRelease =
        lower.LoweringResolvedCallTargetProjectionRetainedBytes(plan)
    lower.LoweringResolvedCallTargetProjectionRelease(plan)
    var receipt: lower.LoweringResolvedCallTargetProjectionReceipt
    lower.LoweringResolvedCallTargetProjectionReceiptInto(
        plan, receipt)
    if mutateReceipt:
        receipt.releasedBytes = receipt.releasedBytes - int64(1)
    if !lower.LoweringResolvedCallTargetProjectionReceiptConsumeStrict(
           plan, receipt):
        panic(
            "lowering resolved-call target projection: receipt mismatch")
    if !receipt.begun ||
       !receipt.movedToPlan ||
       receipt.expectedItemCount != 3 ||
       receipt.reservedCapacity != reservedCapacity ||
       receipt.retainedBufferCount != 1 ||
       receipt.physicalFreeCount != 1 ||
       receipt.physicalFreedBytes != receipt.retainedBytes ||
       retainedBeforeRelease !=
           receipt.retainedBytes +
               receipt.ledgerStorageReleasedBytes ||
       receipt.allocated != int64(1) ||
       receipt.released != int64(1) ||
       receipt.live != int64(0) ||
       receipt.allocatedBytes != receipt.retainedBytes ||
       receipt.releasedBytes != receipt.retainedBytes ||
       receipt.liveBytes != int64(0) ||
       receipt.ownerTransferCount != int64(1) ||
       !receipt.ledgerStorageReleased ||
       !receipt.storageReleased ||
       !lower.LoweringResolvedCallTargetProjectionReceiptClosed(receipt):
        return false

    var failedPlan: lower.LoweringPlanStub
    lower.LoweringResolvedCallTargetProjectionBegin(failedPlan, 3)
    let failedReservedCapacity =
        lower.LoweringResolvedCallTargetProjectionCapacity(failedPlan)
    lower.LoweringResolvedCallTargetProjectionAppend(failedPlan, -1)
    if lower.LoweringResolvedCallTargetProjectionCapacity(failedPlan) !=
           failedReservedCapacity:
        return false
    let failedRetainedBeforeRelease =
        lower.LoweringResolvedCallTargetProjectionRetainedBytes(failedPlan)
    lower.LoweringResolvedCallTargetProjectionRelease(failedPlan)
    var failedReceipt: lower.LoweringResolvedCallTargetProjectionReceipt
    lower.LoweringResolvedCallTargetProjectionReceiptInto(
        failedPlan, failedReceipt)
    if failedReceipt.movedToPlan ||
       failedReceipt.ownerTransferCount != int64(0) ||
       failedReceipt.physicalFreeCount != 1 ||
       failedRetainedBeforeRelease !=
           failedReceipt.retainedBytes +
               failedReceipt.ledgerStorageReleasedBytes ||
       failedReceipt.allocated != int64(1) ||
       failedReceipt.released != int64(1) ||
       failedReceipt.live != int64(0) ||
       !lower.LoweringResolvedCallTargetProjectionReceiptClosed(
           failedReceipt) ||
       !lower.LoweringResolvedCallTargetProjectionReceiptConsumeStrict(
           failedPlan, failedReceipt):
        return false
    os.WriteLine(
        os.GetStdout(),
        Fmt"resolved_call_target_projection_owner_allocated={receipt.allocated} released={receipt.released} live={receipt.live} transfer={receipt.ownerTransferCount} physical_free={receipt.physicalFreeCount} ledger_bytes={receipt.ledgerStorageReleasedBytes} total_pre_bytes={retainedBeforeRelease} ledger_storage_released={receipt.ledgerStorageReleased} first_add_failure_released={failedReceipt.released}")
    return true

fn runLifecycle(
        mutateReleaseReceipt: bool,
        mutateAllocatorReceipt: bool,
        mutateDeferAllocatorReceipt: bool,
        mutateReferenceAllocatorReceipt: bool,
        mutateTypedFunctionIndexAllocatorReceipt: bool,
        mutateDuplicateFlagsAllocatorReceipt: bool,
        mutateIdentityAllocatorReceipt: bool,
        mutateResolvedCallFactAllocatorReceipt: bool,
        mutateImportOwnerIndexAllocatorReceipt: bool,
        mutateImportEdgeIndexAllocatorReceipt: bool,
        mutateQualifiedImportResolveCacheAllocatorReceipt: bool,
        mutateUnqualifiedImportResolveCacheAllocatorReceipt: bool,
        mutateModuleSourceIndexAllocatorReceipt: bool,
        mutateFnPtrFieldCallAllocatorReceipt: bool,
        mutateFunctionSemanticIdentityAllocatorReceipt: bool,
        mutateFunctionRuntimeIdentityAllocatorReceipt: bool,
        mutateFunctionEmissionMetadataAllocatorReceipt: bool,
        mutateExportRootIndexAllocatorReceipt: bool,
        mutateCanonicalSnapshotProjectionAllocatorReceipt: bool): bool =
    let mutateTypeArenaOwnerProofAllocatorReceipt =
        os.GetEnv("CHENG_FORMAL_LOWERING_LIFETIME_NEGATIVE") ==
            "type-arena-owner-proof-allocator-bytes"
    let mutateImportGraphAllocatorReceipt =
        os.GetEnv("CHENG_FORMAL_LOWERING_LIFETIME_NEGATIVE") ==
            "import-graph-allocator-bytes"
    let mutateSemanticDebugProjectionAllocatorReceipt =
        os.GetEnv("CHENG_FORMAL_LOWERING_LIFETIME_NEGATIVE") ==
            "semantic-debug-projection-allocator-bytes"
    let mutateCallTargetAllocatorReceipt =
        os.GetEnv("CHENG_FORMAL_LOWERING_LIFETIME_NEGATIVE") ==
            "call-target-allocator-bytes"
    var duplicateFn: lower.PrimaryObjectIrFunction
    for row in 0..<40:
        var intrinsic: lower.PrimaryObjectIrStatement
        intrinsic.kind = texpr.TypedExprIrStmtResultIntrinsic
        intrinsic.sourcePath = Fmt"/duplicate/{row}"
        intrinsic.lineNumber = row + 1
        intrinsic.callCallee = Fmt"intrinsic_{row}"
        intrinsic.callTarget = Fmt"intrinsic_target_{row}"
        intrinsic.callArgsText = Fmt"arg_{row}"
        add(duplicateFn.statements, intrinsic)
        var callStatement: lower.PrimaryObjectIrStatement
        callStatement.kind = texpr.TypedExprIrStmtCall
        callStatement.sourcePath = Fmt"/duplicate/{row}"
        callStatement.lineNumber = row + 1
        callStatement.callCallee = Fmt"call_{row}"
        callStatement.callTarget = Fmt"call_target_{row}"
        callStatement.callArgsText = Fmt"arg_{row}"
        add(duplicateFn.statements, callStatement)
    var duplicateOwner =
        lower.LoweringComputeStatementCallTargetDuplicateFlags(duplicateFn)
    let duplicateFlagCount = duplicateOwner.flags.len
    lower.LoweringPrimaryObjectIrFunctionReleasePayload(duplicateFn)
    var duplicateAllocatorReceipt: lower.LoweringSequenceAllocatorReceipt
    lower.LoweringStatementCallTargetDuplicateFlagsOwnerReleaseWithAllocatorReceipt(
        duplicateOwner,
        duplicateAllocatorReceipt)
    if mutateDuplicateFlagsAllocatorReceipt:
        duplicateAllocatorReceipt.allocatedCapacityBytes =
            duplicateAllocatorReceipt.allocatedCapacityBytes - int64(1)
    if !lower.LoweringSequenceAllocatorReceiptClosed(
           duplicateAllocatorReceipt):
        panic("lowering duplicate flags allocator: receipt mismatch")
    var plan = buildTrackedPlan()
    var exportRootIndex: lower.LoweringExportRootIndex
    var exportRootIndexErr: str
    if !lower.LoweringBuildExportRootIndex(
           plan, exportRootIndex, exportRootIndexErr):
        return false
    if lower.LoweringExportRootIndexLookup(
           exportRootIndex, "runtime_export_0") != 0:
        return false
    let exportRootIndexBufferCount =
        lower.LoweringExportRootIndexAllocatorPhysicalBufferCount(
            exportRootIndex)
    let exportRootIndexBytes =
        lower.LoweringExportRootIndexAllocatorCapacityBytes(exportRootIndex)
    lower.LoweringExportRootIndexReleasePayload(exportRootIndex)
    var exportRootIndexAllocatorReceipt =
        exportRootIndex.allocatorReceipt
    if mutateExportRootIndexAllocatorReceipt:
        exportRootIndexAllocatorReceipt.allocatedCapacityBytes =
            exportRootIndexAllocatorReceipt.allocatedCapacityBytes - int64(1)
    if !lower.LoweringSequenceAllocatorReceiptClosed(
           exportRootIndexAllocatorReceipt):
        panic("lowering export root index allocator: receipt mismatch")
    lower.LoweringPlanLifecycleReleaseTrackingBegin(plan)
    let deferBufferCount =
        lower.LoweringPlanDeferScopeTransportPhysicalBufferCount(plan)
    let deferBytes =
        lower.LoweringPlanDeferScopeTransportCapacityBytes(plan)
    let ownershipBufferCount =
        lower.LoweringPlanOwnershipTransportPhysicalBufferCount(plan)
    let ownershipBytes =
        lower.LoweringPlanOwnershipTransportCapacityBytes(plan)
    let callTargetBufferCount =
        lower.LoweringPlanPrimaryObjectIrCallTargetAllocatorPhysicalBufferCount(
            plan)
    let callTargetBytes =
        lower.LoweringPlanPrimaryObjectIrCallTargetAllocatorCapacityBytes(plan)
    let referenceBufferCount =
        lower.LoweringTypedFunctionReferenceAllocatorPhysicalBufferCount(plan)
    let referenceBytes =
        lower.LoweringTypedFunctionReferenceAllocatorCapacityBytes(plan)
    let typedFunctionIndexBufferCount =
        lower.LoweringTypedFunctionIndexAllocatorPhysicalBufferCount(plan)
    let typedFunctionIndexBytes =
        lower.LoweringTypedFunctionIndexAllocatorCapacityBytes(plan)
    let typedFunctionIdentityBufferCount =
        lower.LoweringTypedFunctionIdentityAllocatorPhysicalBufferCount(plan)
    let typedFunctionIdentityBytes =
        lower.LoweringTypedFunctionIdentityAllocatorCapacityBytes(plan)
    let resolvedCallFactBufferCount =
        lower.LoweringResolvedCallFactAllocatorPhysicalBufferCount(plan)
    let resolvedCallFactBytes =
        lower.LoweringResolvedCallFactAllocatorCapacityBytes(plan)
    let importGraphBufferCount =
        lower.LoweringImportGraphAllocatorPhysicalBufferCount(plan)
    let importGraphBytes =
        lower.LoweringImportGraphAllocatorCapacityBytes(plan)
    let importEdgeIndexBufferCount =
        lower.LoweringImportEdgeIndexAllocatorPhysicalBufferCount(plan)
    let importEdgeIndexBytes =
        lower.LoweringImportEdgeIndexAllocatorCapacityBytes(plan)
    let importOwnerIndexBufferCount =
        lower.LoweringImportOwnerIndexAllocatorPhysicalBufferCount(plan)
    let importOwnerIndexBytes =
        lower.LoweringImportOwnerIndexAllocatorCapacityBytes(plan)
    let qualifiedImportResolveCacheBufferCount =
        lower.LoweringQualifiedImportResolveCacheAllocatorPhysicalBufferCount(
            plan)
    let qualifiedImportResolveCacheBytes =
        lower.LoweringQualifiedImportResolveCacheAllocatorCapacityBytes(plan)
    let unqualifiedImportResolveCacheBufferCount =
        lower.LoweringUnqualifiedImportResolveCacheAllocatorPhysicalBufferCount(
            plan)
    let unqualifiedImportResolveCacheBytes =
        lower.LoweringUnqualifiedImportResolveCacheAllocatorCapacityBytes(plan)
    let moduleSourceIndexBufferCount =
        lower.LoweringModuleSourceIndexAllocatorPhysicalBufferCount(plan)
    let moduleSourceIndexBytes =
        lower.LoweringModuleSourceIndexAllocatorCapacityBytes(plan)
    let fnPtrFieldCallBufferCount =
        lower.LoweringFnPtrFieldCallAllocatorPhysicalBufferCount(plan)
    let fnPtrFieldCallBytes =
        lower.LoweringFnPtrFieldCallAllocatorCapacityBytes(plan)
    let typeArenaOwnerProofBufferCount =
        lower.LoweringTypeArenaOwnerProofAllocatorPhysicalBufferCount(plan)
    let typeArenaOwnerProofBytes =
        lower.LoweringTypeArenaOwnerProofAllocatorCapacityBytes(plan)
    let functionSemanticIdentityBufferCount =
        lower.LoweringFunctionSemanticIdentityAllocatorPhysicalBufferCount(plan)
    let functionSemanticIdentityBytes =
        lower.LoweringFunctionSemanticIdentityAllocatorCapacityBytes(plan)
    let functionRuntimeIdentityBufferCount =
        lower.LoweringFunctionRuntimeIdentityAllocatorPhysicalBufferCount(plan)
    let functionRuntimeIdentityBytes =
        lower.LoweringFunctionRuntimeIdentityAllocatorCapacityBytes(plan)
    let functionEmissionMetadataBufferCount =
        lower.LoweringFunctionEmissionMetadataAllocatorPhysicalBufferCount(plan)
    let functionEmissionMetadataBytes =
        lower.LoweringFunctionEmissionMetadataAllocatorCapacityBytes(plan)
    let canonicalSnapshotProjectionBufferCount =
        lower.LoweringCanonicalSnapshotProjectionAllocatorPhysicalBufferCount(
            plan)
    let canonicalSnapshotProjectionBytes =
        lower.LoweringCanonicalSnapshotProjectionAllocatorCapacityBytes(plan)
    let semanticDebugProjectionBufferCount =
        lower.LoweringSemanticDebugProjectionAllocatorPhysicalBufferCount(
            plan)
    let semanticDebugProjectionBytes =
        lower.LoweringSemanticDebugProjectionAllocatorCapacityBytes(plan)
    let initialBufferCount =
        lower.LoweringPlanLifecycleTrackedPhysicalBufferCount(plan)
    let initialBytes =
        lower.LoweringPlanLifecycleTrackedRetainedBytes(plan)
    if deferBufferCount != 20 ||
       ownershipBufferCount != 14 ||
       callTargetBufferCount != 8 ||
       referenceBufferCount != 21 ||
       typedFunctionIndexBufferCount != 12 ||
       typedFunctionIdentityBufferCount != 9 ||
       resolvedCallFactBufferCount != 8 ||
       importGraphBufferCount != 1 ||
       importEdgeIndexBufferCount != 5 ||
       importOwnerIndexBufferCount != 4 ||
       qualifiedImportResolveCacheBufferCount != 5 ||
       unqualifiedImportResolveCacheBufferCount != 5 ||
       moduleSourceIndexBufferCount != 4 ||
       fnPtrFieldCallBufferCount != 5 ||
       typeArenaOwnerProofBufferCount != 4 ||
       functionSemanticIdentityBufferCount != 6 ||
       functionRuntimeIdentityBufferCount != 6 ||
       functionEmissionMetadataBufferCount != 5 ||
       canonicalSnapshotProjectionBufferCount != 7 ||
       semanticDebugProjectionBufferCount != 3 ||
       initialBufferCount !=
           deferBufferCount + ownershipBufferCount ||
       initialBytes != deferBytes + ownershipBytes ||
       initialBytes <= int64(0) ||
       referenceBytes <= int64(0) ||
       typedFunctionIndexBytes <= int64(0) ||
       typedFunctionIdentityBytes <= int64(0) ||
       resolvedCallFactBytes <= int64(0) ||
       importGraphBytes <= int64(0) ||
       importEdgeIndexBytes <= int64(0) ||
       importOwnerIndexBytes <= int64(0) ||
       qualifiedImportResolveCacheBytes <= int64(0) ||
       unqualifiedImportResolveCacheBytes <= int64(0) ||
       moduleSourceIndexBytes <= int64(0) ||
       fnPtrFieldCallBytes <= int64(0) ||
       typeArenaOwnerProofBytes <= int64(0) ||
       functionSemanticIdentityBytes <= int64(0) ||
       functionRuntimeIdentityBytes <= int64(0) ||
       functionEmissionMetadataBytes <= int64(0) ||
       canonicalSnapshotProjectionBytes <= int64(0) ||
       semanticDebugProjectionBytes <= int64(0) ||
       callTargetBytes <= int64(0):
        return false

    var state: lifecycle.CompilerPayloadLifecycle
    lifecycle.CompilerPayloadLifecycleBegin(
        state,
        lifecycle.CompilerPayloadKindLowering,
        initialBytes,
        initialBufferCount)

    lower.LoweringPlanReleasePrePrimaryObjectPayload(plan)
    lifecycle.CompilerPayloadLifecycleBorrowForConsumer(state)
    lifecycle.CompilerPayloadLifecycleReturnConsumerBorrow(state)
    lifecycle.CompilerPayloadLifecycleMoveToConsumer(state)

    var handoffReleasedBufferCount: int32
    var handoffReleasedBytes: int64
    lower.LoweringPlanReleaseAfterPrimaryObjectPlanWithReceipt(
        plan,
        handoffReleasedBufferCount,
        handoffReleasedBytes)

    var releaseReceipt: lower.LoweringPlanReleaseReceipt
    lower.LoweringPlanReleaseWithReceipt(plan, releaseReceipt)
    if mutateAllocatorReceipt:
        releaseReceipt.ownershipTransportAllocator.allocatedCapacityBytes =
            releaseReceipt.ownershipTransportAllocator.allocatedCapacityBytes -
                int64(1)
    if mutateDeferAllocatorReceipt:
        releaseReceipt.deferScopeTransportAllocator.allocatedCapacityBytes =
            releaseReceipt.deferScopeTransportAllocator.allocatedCapacityBytes -
