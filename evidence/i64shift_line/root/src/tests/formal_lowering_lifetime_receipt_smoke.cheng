        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringQualifiedImportResolveCacheAppendBucket(plan, -1)
        lower.LoweringQualifiedImportResolveCacheAppendRow(
            plan,
            Fmt"/qualified/source{row}",
            Fmt"qualifier{row}",
            Fmt"/qualified/target{row}",
            -1)

fn populateUnqualifiedImportResolveCacheAllocator(
        plan: var lower.LoweringPlanStub) =
