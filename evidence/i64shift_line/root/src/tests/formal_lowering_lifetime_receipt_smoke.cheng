    if mutateTypeArenaOwnerProofAllocatorReceipt:
        releaseReceipt.typeArenaOwnerProofAllocator.allocatedCapacityBytes =
            releaseReceipt.typeArenaOwnerProofAllocator.allocatedCapacityBytes -
                int64(1)
    var releaseErr: str
    if !lower.LoweringPlanReleaseReceiptConsumeStrictInto(
           plan, releaseReceipt, releaseErr):
        panic(releaseErr)
    if mutateReleaseReceipt:
        releaseReceipt.lifecycleReleasedBytes =
            releaseReceipt.lifecycleReleasedBytes - int64(1)

    var receipt: lifecycle.CompilerPayloadLifecycleReceipt
    lowerlife.LoweringPayloadLifecycleEndWithReleaseReceipt(
        state,
        releaseReceipt,
        lifecycle.CompilerPayloadOutcomeSuccess,
        receipt)
    if !mutateReleaseReceipt &&
