import std/os
import std/strformat
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/lowering_payload_lifecycle as lowerlife
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/tooling/compiler_payload_lifecycle as lifecycle

fn nonEmptyDeferScopeTransport():
        lower.LoweringDeferScopeTransportSoA =
    var out: lower.LoweringDeferScopeTransportSoA
    out.typedFunctionIndex = 0
    out.sourceScopeStart = 0
    out.sourceScopeCount = 40
    out.sourceStatementStart = 0
    out.sourceStatementCount = 40
    for row in 0..<40:
        var scopeKind = parser.NormalizedScopeIndentedSuite
        if row == 0:
            scopeKind = parser.NormalizedScopeRoot
        lower.LoweringDeferScopeTransportAppendScopeExactRow(
            out,
            row,
            row - 1,
            scopeKind,
            -1,
            row,
            row + 1,
            1,
            row + 1,
            2)
        lower.LoweringDeferScopeTransportAppendStatementExactRow(
            out,
            row,
            texpr.TypedExprIrStmtLocalDecl,
            row + 1,
            1,
            row + 1,
            2,
            row,
            -1,
            row,
            row,
            -1)
    out.complete = true
    return out

fn nonEmptyOwnershipTransport(): lower.LoweringOwnershipTransportSoA =
    var out: lower.LoweringOwnershipTransportSoA
    out.typedFunctionIndex = 0
    out.sourceValueDefinitionStart = 0
    out.sourceValueDefinitionCount = 40
    for row in 0..<40:
        lower.LoweringOwnershipTransportAppendExactRow(
            out,
            row,
            row,
            int32(texpr.TypedExprValueDefinitionOriginBindingInitializer),
            row,
            row,
            row,
            row,
            row,
            1,
            texpr.TypedExprExprOwned,
            -1,
            texpr.TypedExprSnapshotTypeProofManagedValue,
            true,
            texpr.TypedExprIrOpCallExpr,
            row)
    out.complete = true
    return out

fn populateTypedFunctionReferenceAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringTypedFunctionReferenceAppendSourceBucket(plan, -1)
        lower.LoweringTypedFunctionReferenceAppendAliasGlobalBuckets(plan, -1)
        lower.LoweringTypedFunctionReferenceAppendSourceRow(
            plan,
            Fmt"/src/{row}",
            -1)
        lower.LoweringTypedFunctionReferenceAppendAliasEntry(
            plan,
            -1,
            row,
            Fmt"alias{row}",
            -1,
            -1)
        lower.LoweringTypedFunctionReferenceAppendAliasCandidate(
            plan,
            -1,
            row)
        lower.LoweringTypedFunctionReferenceAppendGlobalEntry(
            plan,
            -1,
            Fmt"global{row}",
            -1,
            -1)
        lower.LoweringTypedFunctionReferenceAppendGlobalCandidate(
            plan,
            -1,
            row,
            row)
    lower.LoweringTypedFunctionReferenceSetFlagDomain(plan, 40)

fn populateTypedFunctionIndexAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringTypedFunctionIndexAppendSourceBuckets(plan, -1)
        lower.LoweringTypedFunctionIndexAppendFunctionBucket(plan, -1)
        lower.LoweringTypedFunctionIndexAppendSourceRow(
            plan,
            Fmt"/index/{row}",
            -1)
        lower.LoweringTypedFunctionIndexAppendAbsoluteSuffixRow(
            plan,
            -1,
            Fmt"index/{row}",
            row)
        lower.LoweringTypedFunctionIndexAppendEntryRow(
            plan,
            -1,
            row,
            Fmt"fn{row}",
            row)

fn populateTypedFunctionIdentityAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringTypedFunctionIdentityAppendBuckets(plan, -1)
        lower.LoweringTypedFunctionIdentityAppendSourceRow(
            plan,
            Fmt"/identity/{row}",
            -1)
        lower.LoweringTypedFunctionIdentityAppendEntryRow(
            plan,
            -1,
            row,
            row,
            row + 1,
            row)

fn populateResolvedCallFactAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringResolvedCallFactAppendSourceBucket(plan, -1)
        lower.LoweringResolvedCallFactAppendLookupBucket(plan, -1)
        lower.LoweringResolvedCallFactAppendSourceRow(
            plan,
            Fmt"/resolved/{row}",
            -1)
        lower.LoweringResolvedCallFactAppendEntryRow(
            plan,
            -1,
            row,
            row + 1,
            row)

fn populateImportOwnerIndexAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringImportOwnerIndexAppendBucket(plan, -1)
        lower.LoweringImportOwnerIndexAppendRow(
            plan,
            Fmt"pkg/module{row}",
            row,
            -1)

fn populateImportEdgeIndexAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        lower.LoweringImportEdgeIndexAppendBucket(plan, -1)
        lower.LoweringImportEdgeIndexAppendRow(
            plan,
            Fmt"pkg/owner{row}",
            Fmt"qualifier{row}",
            row,
            -1)

fn populateImportGraphAllocator(
        plan: var lower.LoweringPlanStub) =
    for row in 0..<40:
        var edge: parser.ImportEdge
        edge.ownerModulePath = Fmt"pkg/owner{row}"
        edge.targetModulePath = Fmt"pkg/target{row}"
        edge.targetSourcePath = Fmt"/pkg/target{row}.cheng"
        edge.importAlias = Fmt"alias{row}"
        edge.qualifier = Fmt"qualifier{row}"
        edge.resolved = true
        lower.LoweringImportGraphAppendEdge(plan, edge)

