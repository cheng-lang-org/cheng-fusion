type
    ColdRefObjectUnrelatedCell =
        value: int32

    ColdRefObjectUnrelatedInner = ref object
        cell: ColdRefObjectUnrelatedCell

    ColdRefObjectUnrelatedOuter = ref object
        inner: ColdRefObjectUnrelatedInner

fn ColdRefObjectUnrelatedWrite(
        cell: var ColdRefObjectUnrelatedCell) =
    cell.value = 97

fn ColdRefObjectUnrelatedMutate(
        out: var ColdRefObjectUnrelatedOuter): bool =
    var inner = out.inner
    let unrelated = 41 + 2
    ColdRefObjectUnrelatedWrite(inner.cell)
    return unrelated == 43

fn main(): int32 =
    var out = new(ColdRefObjectUnrelatedOuter)
    out.inner = new(ColdRefObjectUnrelatedInner)
    if !ColdRefObjectUnrelatedMutate(out):
        return 1
    if out.inner.cell.value != 97:
        return 2
    return 0
