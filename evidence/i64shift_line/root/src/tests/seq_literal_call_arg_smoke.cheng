import std/strutils as strutil

fn JoinTwo(a: str, b: str): str =
    return strutil.Join([a, b], "")

fn JoinThree(a: str, b: str, c: str): str =
    return strutil.Join([a, b, c], "-")

fn main(): int32 =
    let lit = strutil.Join(["foo", "bar"], "")
    if lit != "foobar":
        return 1
    let param = JoinTwo("hel", "lo")
    if param != "hello":
        return 2
    let three = JoinThree("a", "b", "c")
    if three != "a-b-c":
        return 3
    let sep = strutil.Join(["x", "y", "z"], ",")
    if sep != "x,y,z":
        return 4
    let mixed = strutil.Join([JoinTwo("p", "q"), "r"], "")
    if mixed != "pqr":
        return 5
    return 0
