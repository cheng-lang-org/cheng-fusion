import std/system as system

type
    T = ref object
        label: str

    ColdManagedExactGenericFixedArrayRefOwner[U] =
        leaves: U[2]

fn ColdManagedExactGenericFixedArrayRefOpen[T](
        owner: var ColdManagedExactGenericFixedArrayRefOwner[T]): int32 =
    return 0

fn ColdManagedExactGenericFixedArrayRefNew(value: str): T =
    var leaf = new(T)
    leaf.label = system.NewStringCopy(
        system.StrDataPtr(value), value.len)
    return leaf

fn ColdManagedExactGenericFixedArrayRefExercise(): int32 =
    var owner: ColdManagedExactGenericFixedArrayRefOwner[T]
    if ColdManagedExactGenericFixedArrayRefOpen[T](owner) != 0:
        return 1
    if owner.leaves[0] != nil || owner.leaves[1] != nil:
        return 2

    owner.leaves[0] =
        ColdManagedExactGenericFixedArrayRefNew("left")
    owner.leaves[1] =
        ColdManagedExactGenericFixedArrayRefNew("right")
    owner.leaves[0] = owner.leaves[0]
    owner.leaves[0] =
        ColdManagedExactGenericFixedArrayRefNew("new-left")
    owner.leaves[1] = nil

    if owner.leaves[0] == nil ||
       owner.leaves[0].label != "new-left" ||
       owner.leaves[1] != nil:
        return 3
    owner.leaves[0] = nil
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactGenericFixedArrayRefExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        return 2
    if system.memLiveCount() != liveBefore:
        return 3
    if releaseDelta != retainDelta + freeDelta:
        return 4
    echo("cold_managed_exact_generic_fixed_array_ref_object=PASS")
    return 0
