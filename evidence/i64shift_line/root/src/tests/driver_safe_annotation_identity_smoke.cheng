import std/strings as strings
import cheng/core/backend/driver_safe_contract as driver_safe
import cheng/core/backend/system_link_plan as slplan

fn Plan(): slplan.SystemLinkPlanStub =
    var plan: slplan.SystemLinkPlanStub
    plan.targetTriple = "arm64-apple-darwin"
    return plan

fn TrustedSource(): str =
    return "@profile(\"driver_safe\")\n@trusted_abi\nfn BuildAddress(): int32 =\n    let value = TrustedPhysAddr(1)\n    return value\n"

fn SubstringSource(): str =
    return "@profile(\"driver_safe\")\n@exportc(\"@trusted_abi\")\nfn BuildAddress(): int32 =\n    let value = TrustedPhysAddr(1)\n    return value\n"

fn ProfileSubstringSource(): str =
    return "@exportc(\"@profile(\\\"driver_safe\\\")\")\nfn DisabledByStructure(): int32 =\n    let value = TrustedPhysAddr(1)\n    return value\n"

fn UnknownSource(): str =
    return "@profile(\"driver_safe\")\n@not_registered\nfn Unknown(): int32 = 0\n"

fn DuplicateTrustedSource(): str =
    return "@profile(\"driver_safe\")\n@trusted_abi\n@trusted_abi\nfn Duplicate(): int32 = 0\n"

fn WrongTrustedTargetSource(): str =
    return "@profile(\"driver_safe\")\n@trusted_abi\nlet NotARoutine = 1\n"

fn MultilinePointerSource(): str =
    return "@profile(\"driver_safe\")\nfn Exposed(\n    value: ptr[int32]\n): int32 =\n    return 0\n"

fn MultilineTrustedPointerSource(): str =
    return "@profile(\"driver_safe\")\n@trusted_abi\nfn Exposed(\n    value: ptr[int32]\n): int32 =\n    return 0\n"

fn DisabledSource(): str =
    return "fn Disabled(): int32 = 0\n"

fn DriverSafeReleaseMatrixOnce(): bool =
    var trustedResult: driver_safe.DriverSafeContractResult
    if !driver_safe.DriverSafeContractCheckEntry(
           "/workspace",
           Plan(),
           "/workspace/trusted.cheng",
           TrustedSource(),
           trustedResult):
        return false

    var multilineResult: driver_safe.DriverSafeContractResult
    if driver_safe.DriverSafeContractCheckEntry(
           "/workspace",
           Plan(),
           "/workspace/multiline.cheng",
           MultilinePointerSource(),
           multilineResult) ||
       multilineResult.publicPointerViolations != 1:
        return false

    var disabledResult: driver_safe.DriverSafeContractResult
    if !driver_safe.DriverSafeContractCheckEntry(
           "/workspace",
           Plan(),
           "/workspace/disabled.cheng",
           DisabledSource(),
           disabledResult) ||
       disabledResult.enabled:
        return false

    var invalidResult: driver_safe.DriverSafeContractResult
    if driver_safe.DriverSafeContractCheckEntry(
           "/workspace",
           Plan(),
           "/workspace/invalid.cheng",
           UnknownSource(),
           invalidResult):
        return false
    return true

fn main() =
    var trustedResult: driver_safe.DriverSafeContractResult
    assert(driver_safe.DriverSafeContractCheckEntry(
               "/workspace",
               Plan(),
               "/workspace/trusted.cheng",
               TrustedSource(),
               trustedResult) &&
           trustedResult.enabled &&
           trustedResult.trustedAbiViolations == 0,
           Fmt"driver_safe annotation identity: structured trusted target failed {trustedResult.firstError}")

    var substringResult: driver_safe.DriverSafeContractResult
    assert(!driver_safe.DriverSafeContractCheckEntry(
               "/workspace",
               Plan(),
               "/workspace/substring.cheng",
               SubstringSource(),
               substringResult) &&
           substringResult.enabled &&
           substringResult.trustedAbiViolations == 1,
           "driver_safe annotation identity: annotation string forged trusted target")

    var profileSubstringResult: driver_safe.DriverSafeContractResult
    assert(driver_safe.DriverSafeContractCheckEntry(
               "/workspace",
               Plan(),
               "/workspace/profile_substring.cheng",
               ProfileSubstringSource(),
               profileSubstringResult) &&
           !profileSubstringResult.enabled,
           "driver_safe annotation identity: annotation string forged profile admission")

    var unknownResult: driver_safe.DriverSafeContractResult
    assert(!driver_safe.DriverSafeContractCheckEntry(
               "/workspace",
               Plan(),
               "/workspace/unknown.cheng",
               UnknownSource(),
               unknownResult) &&
           strings.StrContains(
               unknownResult.firstError,
               "unregistered @not_registered"),
           "driver_safe annotation identity: unknown annotation survived")

    var duplicateResult: driver_safe.DriverSafeContractResult
    assert(!driver_safe.DriverSafeContractCheckEntry(
               "/workspace",
               Plan(),
               "/workspace/duplicate.cheng",
               DuplicateTrustedSource(),
               duplicateResult) &&
           strings.StrContains(
               duplicateResult.firstError,
               "invalid @trusted_abi"),
           "driver_safe annotation identity: duplicate trusted capability survived")

    var wrongTargetResult: driver_safe.DriverSafeContractResult
    assert(!driver_safe.DriverSafeContractCheckEntry(
               "/workspace",
               Plan(),
               "/workspace/wrong_target.cheng",
               WrongTrustedTargetSource(),
               wrongTargetResult) &&
           strings.StrContains(
               wrongTargetResult.firstError,
               "function target missing for @trusted_abi"),
           "driver_safe annotation identity: non-routine trusted target survived")

    var multilineResult: driver_safe.DriverSafeContractResult
    assert(!driver_safe.DriverSafeContractCheckEntry(
               "/workspace",
               Plan(),
               "/workspace/multiline.cheng",
               MultilinePointerSource(),
               multilineResult) &&
           multilineResult.publicPointerViolations == 1,
           "driver_safe annotation identity: multiline pointer surface survived")

    var multilineTrustedResult: driver_safe.DriverSafeContractResult
    assert(driver_safe.DriverSafeContractCheckEntry(
               "/workspace",
               Plan(),
               "/workspace/multiline_trusted.cheng",
               MultilineTrustedPointerSource(),
               multilineTrustedResult) &&
           multilineTrustedResult.publicPointerViolations == 0,
           "driver_safe annotation identity: multiline trusted span lost flags")

    var annotationIndex: driver_safe.DriverSafeAnnotationIndex
    var annotationIndexErr: str
    assert(driver_safe.DriverSafeContractBuildAnnotationIndexInto(
               MultilinePointerSource(),
               annotationIndex,
               annotationIndexErr),
           "driver_safe annotation identity: index build failed")
    assert(!driver_safe.DriverSafeAnnotationIndexStorageReleased(
               annotationIndex),
           "driver_safe annotation identity: live index reported released")
    var annotationReleaseReceipt: driver_safe.DriverSafeAnnotationIndexReleaseReceipt
    driver_safe.DriverSafeAnnotationIndexReleaseInto(
        annotationIndex,
        annotationReleaseReceipt)
    assert(annotationReleaseReceipt.allocatedBufferCount == 7 &&
           annotationReleaseReceipt.physicalFreeCount >= int64(7) &&
           annotationReleaseReceipt.liveBufferCount == 0 &&
           annotationReleaseReceipt.retainedBytesBefore > int64(0) &&
           annotationReleaseReceipt.retainedBytesAfter == int64(0) &&
           annotationReleaseReceipt.storageReleased &&
           driver_safe.DriverSafeAnnotationIndexStorageReleased(
               annotationIndex),
           "driver_safe annotation identity: index release incomplete")

    var invalidAnnotationIndex: driver_safe.DriverSafeAnnotationIndex
    var invalidAnnotationErr: str
    assert(!driver_safe.DriverSafeContractBuildAnnotationIndexInto(
               UnknownSource(),
               invalidAnnotationIndex,
               invalidAnnotationErr) &&
           driver_safe.DriverSafeAnnotationIndexStorageReleased(
               invalidAnnotationIndex),
           "driver_safe annotation identity: failed index retained storage")

    for iteration in 0..<500:
        assert(DriverSafeReleaseMatrixOnce(),
               "driver_safe annotation identity: release matrix failed")

    echo("driver_safe_annotation_structured_target=1")
    echo("driver_safe_annotation_string_forgery_rejected=1")
    echo("driver_safe_profile_string_forgery_rejected=1")
    echo("driver_safe_annotation_unregistered_rejected=1")
    echo("driver_safe_annotation_duplicate_rejected=1")
    echo("driver_safe_annotation_wrong_target_rejected=1")
    echo("driver_safe_multiline_signature_span_rejected=1")
    echo("driver_safe_multiline_trusted_flags_preserved=1")
    echo("driver_safe_annotation_index_release=1")
    echo("driver_safe_annotation_index_alloc_free_balanced=1")
    echo("driver_safe_annotation_identity_smoke: ok")
