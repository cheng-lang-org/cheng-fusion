fn ColdGenericSequenceLength[T](values: T[]): int32 =
    return values.len

fn ColdGenericSequenceLengthByRef[T](values: var T[]): int32 =
    return values.len

fn main(): int32 =
    var borrowedValues: int32[]
    if ColdGenericSequenceLengthByRef[int32](borrowedValues) != 0:
        return 1

    var ownedValues: int32[]
    if ColdGenericSequenceLength[int32](ownedValues) != 0:
        return 2
    return 0

main()
