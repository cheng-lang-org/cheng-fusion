# exact_def_call_authority_smoke — ExactDef 批 5 单元验证: var-out 分类
# 器五物理形态 + 调用权威三族 + 墙3 store 爬升 + seal root 校验 + 程序
# 契约推导。spec: docs/cheng-exact-def-rewrite-design.md §4 批 5 +
# docs/cheng-exact-def-batch5-authority-spec.md (§6 五写回形重证要点)。
#
# 合成 BodyIR 全部经真实构建路径构造 (coreir 构建/绑定/冻结 API + 批 1
# derive + 批 2 freeze + 批 3/4 既有相位 + 批 5 相位), 零 Mock; var-out
# 版本行的 MV place 车道经夹具戳 poke 注入 (批 3/4 夹具同法: 戳 poke 只
# 用于把「写回版本行」注入校验面 — 生产 lowering 物化发戳属批 6 锚点;
# 判词本身全部由被测层发射)。相位级入口
# (ExactDefCallAuthorityPhaseValidateInto) 是分类器校验面 — 批 2
# reissue 循环 4 对 MV 行的 [reissuefail] 车道属生产组合域, 夹具相位
# 直驱不经过 (批 6 lowering 发戳时同行解锚, 模块头锚定)。
#
# 模式 (argv[1], 缺省 unit):
#   unit                       — 正例全绿 (rc=0):
#     P1 CopyLocal 写回 (≈C LOCAL_ADDR 载体形);
#     P2 FieldStore 投影写回 (≈C projection 载体形);
#     P3 sret forward (≈C forwarded COPY_I64 形, PARAM+BU 载体);
#     P4 out 直写 (≈C var_array_local 形, 值编码 CSR 四列同源);
#     P5 投影 publication (≈C 第五分类两行组发布组);
#     P6 调用权威: 全局臂 + W8 owned 实参绿;
#     P7 墙3: BU ref 形参基座 FieldStore 绿 (帧自有/PARAM 终态);
#     P8 契约推导: OWNED/STATIC/FORMAL/GLOBAL 四行 + seal;
#     P9 @borrow_result var root 臂 (契约合取+三载体形全证);
#     P10 新组合入口 (批 2→批 4→批 5→批 3) owned merge 体全绿;
#     ⑪ 判词文本断言 (index structure 八字段/authority 九字段/
#        memory-version-broken/contract reject 构建器逐字)。
#   verdict-index-structure    — MV 行无调用 → 八字段 + memory
#     version is broken。
#   verdict-authority          — formal 非 var 车道 → 九字段 +
#     memory version is broken。
#   verdict-global             — 全局实参 consume 已置 →
#     `call var global source is not live unique authority`。
#   verdict-shared-carrier     — BS 实参无借用根权威 →
#     `call var shared-borrow authority is not exact`。
#   verdict-shared             — BS 实根权威+活性全过 → 无条件
#     `borrowed managed local cannot bind a rebindable var formal`。
#   verdict-projection         — BU 投影实参 consume 已触 →
#     `call var projection root is not a live mutable place`。
#   verdict-unique             — owned 实参调用前已 consume →
#     `call var unique-borrow authority is not exact`。
#   verdict-overlap            — 双 var 实参同槽 →
#     `overlapping places cannot bind multiple var formals in one call`。
#   verdict-indexed-store      — BU str 形参基座 (非 ref 族) →
#     `indexed element field store lacks exact unique base authority`。
#   verdict-borrow-root        — root 臂 source[call]!=carrier →
#     `@borrow_result var root call authority is not exact`。
#   verdict-contract-owned     — OWNED 带借用根元数据 →
#     `owned result carries borrow-root metadata`。
#   verdict-contract-snapshot  — 快照窗缺 →
#     `borrow-result comparison snapshot is missing`。
#   verdict-contract-readonly  — FORMAL 根未证 read-only →
#     `formal borrow root is not read-only`。
#   verdict-contract-recompute — 推导≠快照 →
#     `serialized borrow-result five-tuple does not recompute`。
#
# 负例基线: 判词逐字对齐 C (cold_parser.c:25744/26408/29053/29094/
# 29102/29110/29227/29279/83166, cheng_cold.c:68841/103310); 字段值随
# IR 代次漂移, 门禁按 md5 钉死本树基板。

import std/cmdline as cmdline
import std/result
import std/os
import cheng/core/analysis/exact_def_derive as derive
import cheng/core/analysis/exact_def_freeze as freeze
import cheng/core/analysis/exact_def_identity as identity
import cheng/core/analysis/exact_def_merge as exactdefmerge
import cheng/core/analysis/exact_def_call_authority as callauthority
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

const
    # 合成 TypeArena 行: 0=i32 1=str 2=i64 3=i32[4] 4=rec{str}
    # 5=ref rec 6=recP{i32,i32} (批 4 夹具同布局)。
    fixtureTypeI32 = 0
    fixtureTypeStr = 1
    fixtureTypeI64 = 2
    fixtureTypeArr4 = 3
    fixtureTypeRec = 4
    fixtureTypeRefObj = 5
    fixtureTypeRecP = 6
    fixtureTransportStart = 100

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

@borrows
fn smokeStrContains(text: str, sub: str): bool =
    let subLen = len(sub)
    if subLen <= 0:
        return true
    if len(text) < subLen:
        return false
    for start in 0..<len(text) - subLen + 1:
        var matched = true
        for offset in 0..<subLen:
            if text[start + offset] != sub[offset]:
                matched = false
                break
        if matched:
            return true
    return false

fn fixtureCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd")
    if IsErr(parsed):
        panic(Error(parsed))
    return Value(parsed)

@borrows
fn buildWindow(): exactdef.BodyIrExactDefTypeArenaWindow =
    var window: exactdef.BodyIrExactDefTypeArenaWindow
    window.artifactCid = fixtureCid()
    for typeId in 0..<7:
        add(window.structuralKinds,
            Int32(typearena.TypedExprStructuralTypeInvalid))
        add(window.scalarKinds,
            Int32(typearena.TypedExprStructuralScalarInvalid))
        add(window.childTypeIds, -1)
        add(window.layoutChildStarts, 0)
        add(window.layoutChildCounts, 0)
        add(window.fixedLengths, 0)
        add(window.sizeBytes, 4)
        add(window.alignBytes, 4)
    window.structuralKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralScalarInt32)
    window.sizeBytes[fixtureTypeI32] = 4
    window.alignBytes[fixtureTypeI32] = 4
    window.structuralKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralScalarStr)
    window.sizeBytes[fixtureTypeStr] = 24
    window.alignBytes[fixtureTypeStr] = 8
    window.structuralKinds[fixtureTypeI64] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI64] =
        Int32(typearena.TypedExprStructuralScalarInt64)
    window.sizeBytes[fixtureTypeI64] = 8
    window.alignBytes[fixtureTypeI64] = 8
    window.structuralKinds[fixtureTypeArr4] =
        Int32(typearena.TypedExprStructuralTypeFixedArray)
    window.childTypeIds[fixtureTypeArr4] = fixtureTypeI32
    window.fixedLengths[fixtureTypeArr4] = 4
    window.sizeBytes[fixtureTypeArr4] = 16
    window.alignBytes[fixtureTypeArr4] = 4
    # rec{str}: Object 一托管字段 → OBJECT storage; 字段跳证据 (str@0
    # 宽 24) 供 derive field-borrow 臂逐跳核对。
    window.structuralKinds[fixtureTypeRec] =
        Int32(typearena.TypedExprStructuralTypeObject)
    window.layoutChildStarts[fixtureTypeRec] = 0
    window.layoutChildCounts[fixtureTypeRec] = 1
    add(window.layoutChildTypeIds, fixtureTypeStr)
    add(window.layoutChildOffsets, 0)
    add(window.layoutChildWidths, 24)
    window.sizeBytes[fixtureTypeRec] = 24
    window.alignBytes[fixtureTypeRec] = 8
    # recP{i32,i32}: Object 全 PLAIN 字段 → PLAIN storage。
    window.structuralKinds[fixtureTypeRecP] =
        Int32(typearena.TypedExprStructuralTypeObject)
    window.layoutChildStarts[fixtureTypeRecP] = 1
    window.layoutChildCounts[fixtureTypeRecP] = 2
    add(window.layoutChildTypeIds, fixtureTypeI32)
    add(window.layoutChildTypeIds, fixtureTypeI32)
    add(window.layoutChildOffsets, 0)
    add(window.layoutChildOffsets, 4)
    add(window.layoutChildWidths, 4)
    add(window.layoutChildWidths, 4)
    window.sizeBytes[fixtureTypeRecP] = 8
    window.alignBytes[fixtureTypeRecP] = 4
    # ref rec: RefObject → child=rec。
    window.structuralKinds[fixtureTypeRefObj] =
        Int32(typearena.TypedExprStructuralTypeRefObject)
    window.childTypeIds[fixtureTypeRefObj] = fixtureTypeRec
    window.sizeBytes[fixtureTypeRefObj] = 8
    window.alignBytes[fixtureTypeRefObj] = 8
    smokeAssert(exactdef.BodyIrExactDefTypeArenaWindowShapeValid(window),
                "authority smoke: window shape")
    return window

fn bindTypeFacts(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeI32,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt32),
                    -1, 0, 4, 4),
                "authority smoke: type fact i32")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeStr,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarStr),
                    -1, 0, 24, 8),
                "authority smoke: type fact str")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeI64,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt64),
                    -1, 0, 8, 8),
                "authority smoke: type fact i64")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeArr4,
                    Int32(typearena.TypedExprStructuralTypeFixedArray),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    fixtureTypeI32, 4, 16, 4),
                "authority smoke: type fact arr4")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRec,
                    Int32(typearena.TypedExprStructuralTypeObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    -1, 0, 24, 8),
                "authority smoke: type fact rec")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRefObj,
                    Int32(typearena.TypedExprStructuralTypeRefObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    fixtureTypeRec, 0, 8, 8),
                "authority smoke: type fact ref rec")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRecP,
                    Int32(typearena.TypedExprStructuralTypeObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    -1, 0, 8, 4),
                "authority smoke: type fact recP")

fn addBoundSlot(body: var coreir.BodyIR,
                name: str,
                typeKind: int32,
                typeId: int32,
                managedStorageKind: int32,
                sizeBytes: int32,
                alignBytes: int32): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body, slotId, fixtureCid(), typeId,
                    managedStorageKind),
                "authority smoke: slot TypeArena proof bind")
    return slotId

fn addStrSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)

fn addI32Slot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalI32Tag, fixtureTypeI32,
        coreir.BodyManagedStorageUnmanagedTag, 4, 4)

fn addI64Slot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalI64Tag, fixtureTypeI64,
        coreir.BodyManagedStorageUnmanagedTag, 8, 8)

fn addArr4Slot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeArr4,
        coreir.BodyManagedStorageUnmanagedTag, 16, 4)

fn addRecSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeRec,
        coreir.BodyManagedStorageManagedTag, 24, 8)

fn addRefObjSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeRefObj,
        coreir.BodyManagedStorageManagedTag, 8, 8)

fn newDefOp(body: var coreir.BodyIR,
            kind: int32,
            target: int32,
            semanticRow: int32,
            ownership: coreir.OwnershipKind): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    op.valueDefSlot = target
    op.valueDefExprNodeIndex = semanticRow
    op.valueDefSemanticRow = semanticRow
    op.valueDefOwnership = ownership
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticRow
    return coreir.BodyIRAppendOp(body, op)

fn newBareOp(body: var coreir.BodyIR, kind: int32, target: int32): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    return coreir.BodyIRAppendOp(body, op)

# 结构 source 边 (BodyDefinitionDomainBodyOpTag 物理定义边)。
fn setOpSource(body: var coreir.BodyIR, opRow: int32, sourceRow: int32) =
    body.ops[opRow].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opRow].sourceDefinitionRow = sourceRow

# 调用行 (无托管结果; 实参逐add)。
fn appendCall(body: var coreir.BodyIR,
              argSlots: int32[],
              argPassKinds: int32[]): int32 =
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "authority_callee"
    call.resultSlot = -1
    for argIndex in 0..<argSlots.len:
        add(call.argSlots, argSlots[argIndex])
        add(call.argPassKinds, argPassKinds[argIndex])
    let callOrdinal = body.callSequence.len
    add(body.callSequence, call)
    coreir.BodyIRControlFlowBindCallTarget(
        body, callOrdinal, coreir.BodyCallTargetDomainFunctionTag, 0,
        fixtureCid())
    let callOp = newBareOp(body, coreir.BodyOpCallTag, -1)
    add(body.ops[callOp].operands, callOrdinal)
    return callOp

fn buildTransportRows(count: int32): int32[] =
    var rows: int32[]
    for row in 0..<count:
        add(rows, fixtureTransportStart + row)
    return rows

fn appendBlock(body: var coreir.BodyIR,
               opStart: int32,
               opCount: int32,
               termIndex: int32): int32 =
    let blockId = coreir.BodyIRAppendBlock(body, opStart, opCount, 0)
    body.blocks[blockId].termIndex = termIndex
    return blockId

fn newRetTerm(body: var coreir.BodyIR,
              resultSlot: int32,
              sourceDef: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    if sourceDef >= 0:
        term.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        term.sourceDefinitionRow = sourceDef
    return coreir.BodyIRAppendTerm(body, term)

fn newBrTerm(body: var coreir.BodyIR, targetBlock: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermBrTag
    term.trueBlock = targetBlock
    term.falseBlock = -1
    return coreir.BodyIRAppendTerm(body, term)

fn bindSuccessors(body: var coreir.BodyIR,
                  termIndex: int32,
                  successors: int32[],
                  edgeKinds: int32[]) =
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)

fn beginControl(body: var coreir.BodyIR, blockCount: int32) =
    for blockId in 0..<blockCount:
        coreir.BodyIRControlFlowBindBlockScope(body, blockId, 0)

fn sealControlFlow(body: var coreir.BodyIR) =
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "authority smoke: control flow seal")

# 单块骨架收尾 (RET term + 块/后继/seal)。
fn sealSingleBlock(body: var coreir.BodyIR,
                   resultSlot: int32,
                   sourceDef: int32) =
    let term = newRetTerm(body, resultSlot, sourceDef)
    let _ = appendBlock(body, 0, body.ops.len, term)
    beginControl(body, 1)
    var succ: int32[]
    var kinds: int32[]
    bindSuccessors(body, term, succ, kinds)
    sealControlFlow(body)

@borrows
fn deriveFixture(body: var coreir.BodyIR,
                 originKinds: int32[],
                 exactTypeIds: int32[],
                 window: exactdef.BodyIrExactDefTypeArenaWindow) =
    smokeAssert(derive.BodyIrExactDefDerive(
                    body,
                    fixtureTransportStart,
                    buildTransportRows(originKinds.len),
                    originKinds,
                    exactTypeIds,
                    window),
                "authority smoke: derive rejected fixture")
    smokeAssert(body.exactDef.sealed, "authority smoke: sidecar sealed")

fn validatePhase(body: var coreir.BodyIR): bool =
    var emptyContract: exactdef.ExactProgramContract
    var emptyCalleeRows: int32[]
    return callauthority.ExactDefCallAuthorityPhaseValidateInto(
        body, freeze.ExactDefFreezeProductionLimits(), "freeze",
        emptyContract, emptyCalleeRows)

fn emptyComposedContract(): exactdef.ExactProgramContract =
    var contract: exactdef.ExactProgramContract
    return contract

fn emptyComposedCalleeRows(): int32[] =
    var rows: int32[]
    return rows

fn beginBody(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "authority smoke: TypeArena artifact bind")
    coreir.BodyIRControlFlowBegin(body, 0)
    bindTypeFacts(body)

# ---- 正例腿构建器 (五写回形态 + 三族 + 墙3 + 契约 + root 臂) ----

# P1 CopyLocal 写回 (≈C LOCAL_ADDR 载体形): 调用后 CopyLocal 写回 var
# cell; 载体 (调用前当前定义) 帧自有归约; CSR 地址实参 sentinel 车道。
fn buildCopyLocalWritebackBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    beginBody(body)
    let cell = addStrSlot(body, "cell")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cell, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(cell))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    let _ = appendCall(body, argSlots, passKinds)
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, cell, 101, coreir.OwnMove)
    add(body.ops[o2].operands, cell)
    sealSingleBlock(body, cell, o2)
    return body

fn copyLocalTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 2)   # 100 cell BindingInitializer
    add(originKinds, 2)   # 101 write-back
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

fn runPositiveCopyLocal(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    copyLocalTransport(originKinds, exactTypeIds)
    var body = buildCopyLocalWritebackBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[2] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    if !validatePhase(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P1 CopyLocal writeback: OK")
    return 0

# P2 FieldStore 投影写回 (≈C projection 载体形): 投影槽身份绑定
# formal (BU+投影槽 place), 根 cell 活性, 同根诱饵槽非权威。
fn buildProjectionWritebackBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    beginBody(body)
    let rec = addRecSlot(body, "rec")
    let fld = addStrSlot(body, "fld")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, rec, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalAggregateTag)
    let o1 = newDefOp(
        body, coreir.BodyOpFieldLoadTag, fld, 101, coreir.OwnBorrowUnique)
    add(body.ops[o1].operands, rec)
    add(body.ops[o1].operands, fld)
    add(body.ops[o1].operands, 0)
    add(body.ops[o1].operands, 24)
    body.ops[o1].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[o1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[o1].valueDefBorrowOwnerDefinitionRow = o0
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(fld))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    let _ = appendCall(body, argSlots, passKinds)
    let o3 = newDefOp(
        body, coreir.BodyOpFieldStoreTag, fld, 102, coreir.OwnBorrowUnique)
    add(body.ops[o3].operands, fld)
    add(body.ops[o3].operands, rec)
    sealSingleBlock(body, fld, o3)
    return body

fn projectionTransport(originKinds: var int32[],
                       exactTypeIds: var int32[]) =
    add(originKinds, 2)   # 100 rec BindingInitializer
    add(originKinds, 2)   # 101 fld 投影定义
    add(originKinds, 2)   # 102 投影写回
    add(exactTypeIds, fixtureTypeRec)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

fn runPositiveProjectionWriteback(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    projectionTransport(originKinds, exactTypeIds)
    var body = buildProjectionWritebackBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceBorrowProjectionTag
    body.exactDef.opPlaceKinds[3] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    body.exactDef.slotPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceBorrowProjectionTag
    if !validatePhase(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P2 FieldStore projection writeback: OK")
    return 0

# P3 sret forward (≈C forwarded COPY_I64 形): 载体=PARAM+BU+定义边
# (不可变借用定义); consume 空析取; source==carrier。
fn buildSretForwardBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    beginBody(body)
    let p = addRefObjSlot(body, "p")
    add(body.entryParameterSlotIds, p)
    let o0 = newDefOp(
        body, coreir.BodyOpLoadLocalTag, p, 100, coreir.OwnBorrowUnique)
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(p))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    let _ = appendCall(body, argSlots, passKinds)
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, p, 101, coreir.OwnBorrowUnique)
    add(body.ops[o2].operands, p)
    setOpSource(body, o2, o0)
    sealSingleBlock(body, p, o2)
    return body

fn sretTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 1)   # 100 p Parameter
    add(originKinds, 1)   # 101 write-back (同 PARAM 车道, 夹具戳后 MV)
    add(exactTypeIds, fixtureTypeRefObj)
    add(exactTypeIds, fixtureTypeRefObj)

fn runPositiveSretForward(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    sretTransport(originKinds, exactTypeIds)
    var body = buildSretForwardBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[2] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    if !validatePhase(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P3 sret forward: OK")
    return 0

# P4 out 直写 (≈C var_array_local 形): 帧驻定长数组直传, 值编码实参
# CSR 四列==数组本地当前定义四列, 无地址载体行。
fn buildOutDirectBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    beginBody(body)
    let arr = addArr4Slot(body, "arr")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, arr, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalAggregateTag)
    var argSlots: int32[]
    add(argSlots, arr)
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassByAddressAggregateTag)
    let _ = appendCall(body, argSlots, passKinds)
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, arr, 101, coreir.OwnPlain)
    add(body.ops[o2].operands, arr)
    sealSingleBlock(body, arr, o2)
    return body

fn outDirectTransport(originKinds: var int32[],
                      exactTypeIds: var int32[]) =
    add(originKinds, 2)   # 100 arr BindingInitializer
    add(originKinds, 2)   # 101 write-back
    add(exactTypeIds, fixtureTypeArr4)
    add(exactTypeIds, fixtureTypeArr4)

fn runPositiveOutDirect(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    outDirectTransport(originKinds, exactTypeIds)
    var body = buildOutDirectBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[2] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    if !validatePhase(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P4 out direct fixed array: OK")
    return 0

# P5 投影 publication (≈C 第五分类两行组): 投影槽 post-call 定义 + 根
# cell post-call 定义发布组 (同调用同形参, 根行物理居后, source 互指)。
fn buildPublicationBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    beginBody(body)
    let rec = addRecSlot(body, "rec")
    let fld = addStrSlot(body, "fld")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, rec, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalAggregateTag)
    let o1 = newDefOp(
        body, coreir.BodyOpFieldLoadTag, fld, 101, coreir.OwnBorrowUnique)
    add(body.ops[o1].operands, rec)
    add(body.ops[o1].operands, fld)
    add(body.ops[o1].operands, 0)
    add(body.ops[o1].operands, 24)
    body.ops[o1].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[o1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[o1].valueDefBorrowOwnerDefinitionRow = o0
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(fld))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    let _ = appendCall(body, argSlots, passKinds)
    let o3 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, fld, 102, coreir.OwnMove)
    add(body.ops[o3].operands, fld)
    let o4 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, rec, 103, coreir.OwnBorrowUnique)
    add(body.ops[o4].operands, rec)
    setOpSource(body, o4, o3)
    sealSingleBlock(body, rec, o4)
    return body

fn publicationTransport(originKinds: var int32[],
                        exactTypeIds: var int32[]) =
    add(originKinds, 2)   # 100 rec
    add(originKinds, 2)   # 101 fld 投影定义
    add(originKinds, 2)   # 102 投影槽发布行
    add(originKinds, 2)   # 103 根 cell 发布行
    add(exactTypeIds, fixtureTypeRec)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeRec)

fn runPositivePublication(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    publicationTransport(originKinds, exactTypeIds)
    var body = buildPublicationBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceBorrowProjectionTag
    body.exactDef.opPlaceKinds[3] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    body.exactDef.opPlaceKinds[4] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    if !validatePhase(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P5 projection publication group: OK")
    return 0

# P6 调用权威: 全局臂 (GlobalLoad+GLOBAL+SHARED+consume==0+live) +
# W8 owned 实参 (帧自有) 双绿。
fn buildFamilyBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    beginBody(body)
    let gAddr = addI64Slot(body, "g_addr")
    body.localSlots[gAddr].placeKind = coreir.BodyPlaceGlobalAddressTag
    let gR = addI64Slot(body, "g_r")
    let cell = addStrSlot(body, "cell")
    let o0 = newDefOp(
        body, coreir.BodyOpGlobalLoadTag, gR, 100, coreir.OwnBorrowShared)
    add(body.ops[o0].operands, gAddr)
    let o1 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cell, 101, coreir.OwnMove)
    add(body.ops[o1].operands, coreir.LocalStrTag)
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(gR))
    add(argSlots, coreir.CallArgSlotAddress(cell))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    let _ = appendCall(body, argSlots, passKinds)
    sealSingleBlock(body, cell, o1)
    return body

fn familyTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 g remat (TEMPORARY 车道, 夹具戳 Global)
    add(originKinds, 2)   # 101 cell
    add(exactTypeIds, fixtureTypeI64)
    add(exactTypeIds, fixtureTypeStr)

fn runPositiveFamily(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    familyTransport(originKinds, exactTypeIds)
    var body = buildFamilyBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[0] =
        exactdef.BodyIrExactDefPlaceGlobalTag
    body.exactDef.opOriginIds[0] = 0
    if !validatePhase(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P6 global+unique var authority: OK")
    return 0

# P7 墙3: BU ref 形参基座 FieldStore (PARAM+BU 终态, 定义边全证)。
fn buildStoreBaseBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    beginBody(body)
    let q = addRefObjSlot(body, "q")
    add(body.entryParameterSlotIds, q)
    let o0 = newDefOp(
        body, coreir.BodyOpLoadLocalTag, q, 100, coreir.OwnBorrowUnique)
    let o1 = newDefOp(
        body, coreir.BodyOpFieldStoreTag, q, 101, coreir.OwnMove)
    add(body.ops[o1].operands, q)
    add(body.ops[o1].operands, q)
    sealSingleBlock(body, q, o1)
    return body

fn storeBaseTransport(originKinds: var int32[],
                      exactTypeIds: var int32[]) =
    add(originKinds, 1)   # 100 q Parameter
    add(originKinds, 1)   # 101 field store (同 PARAM 车道)
    add(exactTypeIds, fixtureTypeRefObj)
    add(exactTypeIds, fixtureTypeRefObj)

fn runPositiveStoreBase(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    storeBaseTransport(originKinds, exactTypeIds)
    var body = buildStoreBaseBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !validatePhase(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P7 indexed store unique base: OK")
    return 0

# P8 契约推导: OWNED/STATIC/FORMAL/GLOBAL 四行 + 快照恒等 + seal。
fn runPositiveContract(): int32 =
    var contract: exactdef.ExactProgramContract
    var resultExprClasses: int32[]
    add(resultExprClasses, 1)   # fn0 Owned
    add(resultExprClasses, 2)   # fn1 Borrowed (static)
    add(resultExprClasses, 2)   # fn2 Borrowed (formal)
    add(resultExprClasses, 2)   # fn3 Borrowed (global)
    var formalCounts: int32[]
    add(formalCounts, 0)
    add(formalCounts, 0)
    add(formalCounts, 3)
    add(formalCounts, 0)
    var returnExactTypeIds: int32[]
    add(returnExactTypeIds, -1)
    add(returnExactTypeIds, 1)
    add(returnExactTypeIds, 5)
    add(returnExactTypeIds, 1)
    var globalTypeIds: int32[]
    add(globalTypeIds, 1)
    var retStarts: int32[]
    add(retStarts, 0)
    add(retStarts, 0)
    add(retStarts, 1)
    add(retStarts, 2)
    var retCounts: int32[]
    add(retCounts, 0)
    add(retCounts, 1)
    add(retCounts, 1)
    add(retCounts, 1)
    var retRootDomains: int32[]
    add(retRootDomains, 0)    # fn1 RET static
    add(retRootDomains, 1)    # fn2 RET formal
    add(retRootDomains, 2)    # fn3 RET global
    var retRootRows: int32[]
    add(retRootRows, -1)
    add(retRootRows, 1)
    add(retRootRows, 0)
    var retRootTypeIds: int32[]
    add(retRootTypeIds, -1)
    add(retRootTypeIds, 5)
    add(retRootTypeIds, 1)
    var retFormalTypeIds: int32[]
    add(retFormalTypeIds, -1)
    add(retFormalTypeIds, 5)
    add(retFormalTypeIds, -1)
    var formalRootsReadOnly: bool[]
    add(formalRootsReadOnly, false)
    add(formalRootsReadOnly, false)
    add(formalRootsReadOnly, true)
    add(formalRootsReadOnly, false)
    var expectRootKinds: int32[]
    add(expectRootKinds, exactdef.BodyIrExactDefContractRootUnknownTag)
    add(expectRootKinds, exactdef.BodyIrExactDefContractRootStaticTag)
    add(expectRootKinds, exactdef.BodyIrExactDefContractRootFormalTag)
    add(expectRootKinds, exactdef.BodyIrExactDefContractRootGlobalTag)
    var expectFormalIndexs: int32[]
    add(expectFormalIndexs, -1)
    add(expectFormalIndexs, -1)
    add(expectFormalIndexs, 1)
    add(expectFormalIndexs, -1)
    var expectFormalMasks: int32[]
    add(expectFormalMasks, 0)
    add(expectFormalMasks, 0)
    add(expectFormalMasks, 2)
    add(expectFormalMasks, 0)
    var expectGlobalRows: int32[]
    add(expectGlobalRows, -1)
    add(expectGlobalRows, -1)
    add(expectGlobalRows, -1)
    add(expectGlobalRows, 0)
    var expectReadOnlyProofs: int32[]
    add(expectReadOnlyProofs,
        exactdef.BodyIrExactDefContractReadOnlyUnknownTag)
    add(expectReadOnlyProofs,
        exactdef.BodyIrExactDefContractReadOnlyUnknownTag)
    add(expectReadOnlyProofs,
        exactdef.BodyIrExactDefContractReadOnlyProvenTag)
    add(expectReadOnlyProofs,
        exactdef.BodyIrExactDefContractReadOnlyUnknownTag)
    callauthority.ExactDefCallAuthorityProgramContractDerive(
        contract, "freeze", 4,
        resultExprClasses, formalCounts, returnExactTypeIds,
        globalTypeIds, retStarts, retCounts, retRootDomains,
        retRootRows, retRootTypeIds, retFormalTypeIds,
        formalRootsReadOnly, expectRootKinds, expectFormalIndexs,
        expectFormalMasks, expectGlobalRows, expectReadOnlyProofs)
    smokeAssert(contract.sealed, "authority smoke: contract sealed")
    smokeAssert(callauthority.ExactDefCallAuthorityContractShapeValid(
                    contract),
                "authority smoke: contract shape")
    smokeAssert(contract.rootKinds.len == 4 &&
                contract.rootKinds[2] ==
                    exactdef.BodyIrExactDefContractRootFormalTag &&
                contract.formalMasks[2] == 2 &&
                contract.formalIndexs[2] == 1 &&
                contract.readOnlyProofs[2] ==
                    exactdef.BodyIrExactDefContractReadOnlyProvenTag &&
                contract.globalRows[3] == 0,
                "authority smoke: contract columns")
    os.WriteLine(os.Get_stdout(), "P8 program contract derive: OK")
    return 0

# P9 @borrow_result var root 臂: 契约合取 (FORMAL singleton PROVEN) +
# forwarded var param 载体形 + source[call]==carrier 全证。
fn runPositiveBorrowResultRoot(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    sretTransport(originKinds, exactTypeIds)
    var body = buildSretForwardBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    # 调用 source 边钉载体 (C source[call]==carrier 同构)。
    setOpSource(body, 1, 0)
    var dom = freeze.ExactDefFreezeDominatorsBuild(body)
    var workspace = freeze.ExactDefFreezeIdentityWorkspaceAcquire(body)
    if !callauthority.ExactDefCallAuthorityBorrowResultVarRootCallValid(
           body, dom, workspace,
           freeze.ExactDefFreezeProductionLimits(), 1, 0,
           exactdef.BodyIrExactDefContractRootFormalTag, 0, 1, -1,
           exactdef.BodyIrExactDefContractReadOnlyProvenTag):
        return 1
    os.WriteLine(os.Get_stdout(), "P9 borrow-result var root: OK")
    return 0

# P10 新组合入口 (批 2→批 4→批 5→批 3) owned merge 体全绿 (批 4 正
# 例①同形体, 证明组合序端到端不回红)。
fn buildMergeComposedBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    beginBody(body)
    let cond = addI32Slot(body, "cond")
    let armA = addStrSlot(body, "arm_a")
    let staging = addStrSlot(body, "staging")
    let dst = addStrSlot(body, "merged")
    let armB = addStrSlot(body, "arm_b")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    var term0: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term0)
    term0.kind = coreir.BodyTermCbrTag
    term0.conditionKind = coreir.LocalI32Tag
    term0.lhsSlot = cond
    term0.rhsSlot = -1
    term0.trueBlock = 1
    term0.falseBlock = 3
    let term0Id = coreir.BodyIRAppendTerm(body, term0)
    let o1 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armA, 101, coreir.OwnMove)
    add(body.ops[o1].operands, coreir.LocalStrTag)
    let term1 = newBrTerm(body, 2)
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 102, coreir.OwnMove)
    add(body.ops[o2].operands, armA)
    setOpSource(body, o2, o1)
    let term1e = newBrTerm(body, 5)
    let o3 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armB, 103, coreir.OwnMove)
    add(body.ops[o3].operands, coreir.LocalStrTag)
    let term2 = newBrTerm(body, 4)
    let o4 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 104, coreir.OwnMove)
    add(body.ops[o4].operands, armB)
    setOpSource(body, o4, o3)
    let term2e = newBrTerm(body, 5)
    let o5 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, dst, 105, coreir.OwnMove)
    add(body.ops[o5].operands, staging)
    setOpSource(body, o5, o2)
    let term3 = newRetTerm(body, dst, o5)
    let _ = appendBlock(body, 0, 1, term0Id)
    let _ = appendBlock(body, 1, 1, term1)
    let _ = appendBlock(body, 2, 1, term1e)
    let _ = appendBlock(body, 3, 1, term2)
    let _ = appendBlock(body, 4, 1, term2e)
    let _ = appendBlock(body, 5, 1, term3)
    beginControl(body, 6)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 3)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0Id, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ1e: int32[]
    add(succ1e, 5)
    var kind1e: int32[]
    add(kind1e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1e, succ1e, kind1e)
    var succ2: int32[]
    add(succ2, 4)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ2e: int32[]
    add(succ2e, 5)
    var kind2e: int32[]
    add(kind2e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2e, succ2e, kind2e)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

fn mergeComposedTransport(originKinds: var int32[],
                          exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 cond
    add(originKinds, 4)   # 101 armA
    add(originKinds, 2)   # 102 input1
    add(originKinds, 4)   # 103 armB
    add(originKinds, 2)   # 104 input2
    add(originKinds, 2)   # 105 merge
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

fn runPositiveComposed(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    mergeComposedTransport(originKinds, exactTypeIds)
    var body = buildMergeComposedBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !callauthority.ExactDefCallAuthorityValidateInto(
           body, freeze.ExactDefFreezeProductionLimits(),
           emptyComposedContract(), emptyComposedCalleeRows()):
        return 1
    os.WriteLine(os.Get_stdout(), "P10 composed freeze-merge-authority-identity: OK")
    return 0

# ---- ⑪ 判词文本断言 (构建器逐字, 批 2-4 同例) ----

fn runVerdictTextAsserts(): int32 =
    let indexLine = callauthority.ExactDefCallAuthorityTestIndexStructureLine(
        12, 11, 10, 16, 15, 21, 0, -1)
    if !smokeStrContains(
           indexLine,
           "call var-out definition index structure mismatch definition=12 call=11 carrier=10 slot=16 ckind=15 cdst=21 ca=0 csrc=-1"):
        return 1
    let authorityLine = callauthority.ExactDefCallAuthorityTestMismatchLine(
        12, 9, 3, 0, 16, 4, 2, 1, 0)
    if !smokeStrContains(
           authorityLine,
           "call var-out definition authority mismatch definition=12 source=9 call_arg=3 formal=0 value_slot=16 exact_type=4 storage=2 sentinel=1 source_match=0"):
        return 1
    let brokenLine =
        callauthority.ExactDefCallAuthorityTestMemoryVersionBrokenLine(
            "freeze", 0, 12, 11, 0, 10)
    if !smokeStrContains(
           brokenLine,
           "cheng_cold: exact identity schema [freeze] fn=0 op row=12 call memory version is broken call=11 formal=0 carrier=10"):
        return 1
    let rejectLine = callauthority.ExactDefCallAuthorityTestContractRejectLine(
        "freeze", 7, "formal borrow root is not read-only")
    if !smokeStrContains(
           rejectLine,
           "cheng_cold: FunctionContractAdmission [freeze] row=7 reject: formal borrow root is not read-only"):
        return 1
    return 0

fn runUnit(): int32 =
    if runPositiveCopyLocal() != 0:
        return 1
    if runPositiveProjectionWriteback() != 0:
        return 1
    if runPositiveSretForward() != 0:
        return 1
    if runPositiveOutDirect() != 0:
        return 1
    if runPositivePublication() != 0:
        return 1
    if runPositiveFamily() != 0:
        return 1
    if runPositiveStoreBase() != 0:
        return 1
    if runPositiveContract() != 0:
        return 1
    if runPositiveBorrowResultRoot() != 0:
        return 1
    if runPositiveComposed() != 0:
        return 1
    if runVerdictTextAsserts() != 0:
        return 1
    os.WriteLine(os.Get_stdout(), "EXACT_DEF_CALL_AUTHORITY_UNIT_OK")
    return 0

# ---- 负例腿 ----

# N1: MV 行无调用 (载体/调用回收失败) → 八字段 index structure +
# memory version is broken。
fn runVerdictIndexStructure(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    copyLocalTransport(originKinds, exactTypeIds)
    var body: coreir.BodyIR
    beginBody(body)
    let cell = addStrSlot(body, "cell")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cell, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    let o1 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, cell, 101, coreir.OwnMove)
    add(body.ops[o1].operands, cell)
    sealSingleBlock(body, cell, o1)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    if validatePhase(body):
        return 1
    return 2

# N2: formal 非 var 车道 (passKind=StackValue) → 九字段 authority
# mismatch + memory version is broken。
fn runVerdictAuthority(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    copyLocalTransport(originKinds, exactTypeIds)
    var body: coreir.BodyIR
    beginBody(body)
    let cell = addStrSlot(body, "cell")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cell, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(cell))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassStackValueTag)
    let _ = appendCall(body, argSlots, passKinds)
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, cell, 101, coreir.OwnMove)
    add(body.ops[o2].operands, cell)
    sealSingleBlock(body, cell, o2)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[2] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    if validatePhase(body):
        return 1
    return 2

# N3: 全局实参 consume 已置 → global source is not live unique。
fn runVerdictGlobal(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    familyTransport(originKinds, exactTypeIds)
    var body = buildFamilyBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[0] =
        exactdef.BodyIrExactDefPlaceGlobalTag
    body.exactDef.opOriginIds[0] = 0
    body.ops[0].valueDefConsumeOpIndexPlusOne = 5
    if validatePhase(body):
        return 1
    return 2

# N4: BS 实参无借用根权威 (SHARED_COPY 车道+origin 在界, 借用根三
# 元缺) → shared-borrow authority is not exact (第一判词, 载体检)。
fn runVerdictSharedCarrier(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    add(originKinds, 2)   # 100 g
    add(originKinds, 2)   # 101 gB 借用
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    var body: coreir.BodyIR
    beginBody(body)
    let g = addStrSlot(body, "g")
    let gB = addStrSlot(body, "g_b")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, g, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    let o1 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, gB, 101, coreir.OwnBorrowShared)
    add(body.ops[o1].operands, g)
    setOpSource(body, o1, o0)
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(gB))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    let _ = appendCall(body, argSlots, passKinds)
    sealSingleBlock(body, gB, o1)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    # SHARED_COPY 车道 (seal 扫描 origin 终态合法) + 借用根三元缺
    # (shared 臂根权威检查的对象)。
    body.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceSharedCopyTag
    body.exactDef.opOriginIds[1] = 0
    if validatePhase(body):
        return 1
    return 2

# N5: BS 实参根权威+活性全过 → 无条件第二判词 (分流器非放行)。
fn runVerdictShared(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    add(originKinds, 2)   # 100 g
    add(originKinds, 2)   # 101 gB 借用
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    var body: coreir.BodyIR
    beginBody(body)
    let g = addStrSlot(body, "g")
    let gB = addStrSlot(body, "g_b")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, g, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    let o1 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, gB, 101, coreir.OwnBorrowShared)
    add(body.ops[o1].operands, g)
    setOpSource(body, o1, o0)
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(gB))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    let _ = appendCall(body, argSlots, passKinds)
    sealSingleBlock(body, gB, o1)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.ops[1].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[1].valueDefBorrowOwnerDefinitionRow = 0
    if validatePhase(body):
        return 1
    return 2

# N6: BU 投影实参 consume 已触 → projection root is not a live
# mutable place。
fn runVerdictProjection(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    projectionTransport(originKinds, exactTypeIds)
    var body = buildProjectionWritebackBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceBorrowProjectionTag
    body.exactDef.opPlaceKinds[3] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    body.exactDef.slotPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceBorrowProjectionTag
    body.ops[1].valueDefConsumeOpIndexPlusOne = 2
    if validatePhase(body):
        return 1
    return 2

# N7: owned 实参调用前已 consume → unique-borrow authority is not
# exact。
fn runVerdictUnique(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    add(originKinds, 2)   # 100 cell
    add(originKinds, 2)   # 101 sink (consume cell)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    var body: coreir.BodyIR
    beginBody(body)
    let cell = addStrSlot(body, "cell")
    let sink = addStrSlot(body, "sink")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cell, 100, coreir.OwnMove)
    add(body.ops[o0].operands, coreir.LocalStrTag)
    let o1 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, sink, 101, coreir.OwnMove)
    add(body.ops[o1].operands, cell)
    setOpSource(body, o1, o0)
    var argSlots: int32[]
    add(argSlots, coreir.CallArgSlotAddress(cell))
    var passKinds: int32[]
    add(passKinds, coreir.BodyCallPassParamAddressTag)
    let _ = appendCall(body, argSlots, passKinds)
    sealSingleBlock(body, sink, o1)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validatePhase(body):
        return 1
    return 2

