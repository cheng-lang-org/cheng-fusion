    var expectFormalIndexs: int32[]
    add(expectFormalIndexs, -1)
    var expectFormalMasks: int32[]
    add(expectFormalMasks, 0)
    var expectGlobalRows: int32[]
    add(expectGlobalRows, -1)
    var expectReadOnlyProofs: int32[]
    add(expectReadOnlyProofs,
        exactdef.BodyIrExactDefContractReadOnlyUnknownTag)
    callauthority.ExactDefCallAuthorityProgramContractDerive(
        contract, "freeze", 1,
        resultExprClasses, formalCounts, returnExactTypeIds,
        globalTypeIds, retStarts, retCounts, retRootDomains,
        retRootRows, retRootTypeIds, retFormalTypeIds,
        formalRootsReadOnly, expectRootKinds, expectFormalIndexs,
        expectFormalMasks, expectGlobalRows, expectReadOnlyProofs)
    return 1

# N22: result 表达式类越域 (99) → result ownership summary is
# invalid。
fn runVerdictContractSummary(): int32 =
    var contract: exactdef.ExactProgramContract
    var resultExprClasses: int32[]
    add(resultExprClasses, 99)
    var formalCounts: int32[]
    add(formalCounts, 0)
    var returnExactTypeIds: int32[]
    add(returnExactTypeIds, -1)
    var globalTypeIds: int32[]
    var retStarts: int32[]
    add(retStarts, 0)
    var retCounts: int32[]
    add(retCounts, 0)
    var retRootDomains: int32[]
    var retRootRows: int32[]
    var retRootTypeIds: int32[]
    var retFormalTypeIds: int32[]
    var formalRootsReadOnly: bool[]
    add(formalRootsReadOnly, false)
    var expectRootKinds: int32[]
    add(expectRootKinds, exactdef.BodyIrExactDefContractRootUnknownTag)
    var expectFormalIndexs: int32[]
    add(expectFormalIndexs, -1)
    var expectFormalMasks: int32[]
    add(expectFormalMasks, 0)
    var expectGlobalRows: int32[]
    add(expectGlobalRows, -1)
    var expectReadOnlyProofs: int32[]
    add(expectReadOnlyProofs,
        exactdef.BodyIrExactDefContractReadOnlyUnknownTag)
    callauthority.ExactDefCallAuthorityProgramContractDerive(
        contract, "freeze", 1,
        resultExprClasses, formalCounts, returnExactTypeIds,
        globalTypeIds, retStarts, retCounts, retRootDomains,
        retRootRows, retRootTypeIds, retFormalTypeIds,
        formalRootsReadOnly, expectRootKinds, expectFormalIndexs,
        expectFormalMasks, expectGlobalRows, expectReadOnlyProofs)
    return 1

# ---- seal 接线腿 (生产契约表经键车道送达 var root 臂) ----

# 共享体: P9 root 臂形 (sret forward + source[call]==carrier 戳)。
fn buildWiredRootBody(): coreir.BodyIR =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    sretTransport(originKinds, exactTypeIds)
    var body = buildSretForwardBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    setOpSource(body, 1, 0)
    return body

fn buildWiredContract(rootKind: int32,
                      formalIndex: int32,
                      formalMask: int32,
                      globalRow: int32,
                      readOnlyProof: int32): exactdef.ExactProgramContract =
    var contract: exactdef.ExactProgramContract
    add(contract.rootKinds, rootKind)
    add(contract.formalIndexs, formalIndex)
    add(contract.formalMasks, formalMask)
    add(contract.globalRows, globalRow)
    add(contract.readOnlyProofs, readOnlyProof)
    callauthority.ExactDefCallAuthorityContractSealInto(contract)
    smokeAssert(contract.sealed, "authority smoke: wired contract sealed")
    return contract

# 正例: 契约表 FORMAL singleton PROVEN 经 calleeRows 送达 → var root
# 臂触发全证 → 相位绿 (W8 臂按 C 28858-28863 continue 不进入)。
fn runVerdictWiredRoot(): int32 =
    var body = buildWiredRootBody()
    var contract = buildWiredContract(
        exactdef.BodyIrExactDefContractRootFormalTag, 0, 1, -1,
        exactdef.BodyIrExactDefContractReadOnlyProvenTag)
    var calleeRows: int32[]
    add(calleeRows, 0)
    if !callauthority.ExactDefCallAuthorityPhaseValidateInto(
           body, freeze.ExactDefFreezeProductionLimits(), "freeze",
           contract, calleeRows):
        return 1
    os.WriteLine(os.Get_stdout(), "P11 wired contract var root: OK")
    return 0

# 共享负例体: N6 BU 投影实参 (consume 已触) — 投影臂判词面; var
# root 臂触发与否决定判词族走向。
fn buildWiredProjectionBody(): coreir.BodyIR =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    projectionTransport(originKinds, exactTypeIds)
    var body = buildProjectionWritebackBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceBorrowProjectionTag
    body.exactDef.opPlaceKinds[3] =
        exactdef.BodyIrExactDefPlaceMemoryVersionTag
    body.exactDef.slotPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceBorrowProjectionTag
    body.ops[1].valueDefConsumeOpIndexPlusOne = 2
    return body

# 负例 (契约缺表): canonical empty 契约 + 空窗 → 臂停用, 投影臂合取
# 仍全量适用 (批 5 REPORT §5 非降级口径) → 同族判词。
fn runVerdictContractMissing(): int32 =
    var body = buildWiredProjectionBody()
    var contract: exactdef.ExactProgramContract
    var calleeRows: int32[]
    if callauthority.ExactDefCallAuthorityPhaseValidateInto(
           body, freeze.ExactDefFreezeProductionLimits(), "freeze",
           contract, calleeRows):
        return 1
    return 0

# 负例 (五元组漂移): formalMask 漂到形参 1 (调用绑形参 0) → 合取不
# 成立 → 臂不误触, 落投影臂同族判词。
fn runVerdictContractDrift(): int32 =
    var body = buildWiredProjectionBody()
    var contract = buildWiredContract(
        exactdef.BodyIrExactDefContractRootFormalTag, 0, 2, -1,
        exactdef.BodyIrExactDefContractReadOnlyProvenTag)
    var calleeRows: int32[]
    add(calleeRows, 0)
    if callauthority.ExactDefCallAuthorityPhaseValidateInto(
           body, freeze.ExactDefFreezeProductionLimits(), "freeze",
           contract, calleeRows):
        return 1
    return 0

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var mode = "unit"
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "":
        mode = "unit"
    if mode == "unit":
        return runUnit()
    if mode == "verdict-index-structure":
        return runVerdictIndexStructure()
    if mode == "verdict-authority":
        return runVerdictAuthority()
    if mode == "verdict-global":
        return runVerdictGlobal()
    if mode == "verdict-shared-carrier":
        return runVerdictSharedCarrier()
    if mode == "verdict-shared":
        return runVerdictShared()
    if mode == "verdict-projection":
        return runVerdictProjection()
    if mode == "verdict-unique":
        return runVerdictUnique()
    if mode == "verdict-overlap":
        return runVerdictOverlap()
    if mode == "verdict-indexed-store":
        return runVerdictIndexedStore()
    if mode == "verdict-borrow-root":
        return runVerdictBorrowRoot()
    if mode == "verdict-contract-owned":
        return runVerdictContractOwned()
    if mode == "verdict-contract-snapshot":
        return runVerdictContractSnapshot()
    if mode == "verdict-contract-readonly":
        return runVerdictContractReadonly()
    if mode == "verdict-contract-recompute":
        return runVerdictContractRecompute()
    if mode == "verdict-contract-cfg":
        return runVerdictContractCfg()
    if mode == "verdict-contract-no-ret":
        return runVerdictContractNoRet()
    if mode == "verdict-contract-sentinel-nil":
        return runVerdictContractSentinelNil()
    if mode == "verdict-contract-root-domain":
        return runVerdictContractRootDomain()
    if mode == "verdict-contract-root-missing":
        return runVerdictContractRootMissing()
    if mode == "verdict-contract-formal-id":
        return runVerdictContractFormalId()
    if mode == "verdict-contract-global-id":
        return runVerdictContractGlobalId()
    if mode == "verdict-contract-summary":
        return runVerdictContractSummary()
    if mode == "verdict-wired-root":
        return runVerdictWiredRoot()
    if mode == "verdict-contract-missing":
        return runVerdictContractMissing()
    if mode == "verdict-contract-drift":
        return runVerdictContractDrift()
    os.WriteLine(os.Get_stdout(), Fmt"unknown mode: {mode}")
    return 2
