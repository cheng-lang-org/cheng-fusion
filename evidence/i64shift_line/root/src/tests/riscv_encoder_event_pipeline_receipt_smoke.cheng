import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_production_encoder_events as events
import cheng/core/backend/regalloc_riscv_adapter as riscvadapter
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend2/backend2_assembler_lifecycle as b2temps
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import std/strings
import std/strutils as strutil
import cheng/core/backend/regalloc_aarch64_adapter as rega64

fn receiptFixtureCid(label: str): layout.FixedBytes32 =
    # Structural receipt fixture only. Production source authority is not
    # synthesized here and remains required from CompilerCSG.
    var bytes = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(bytes, int32(label[index]))
    let out = hash256.Sha256Fixed(layout.ByteBufView(bytes))
    layout.ByteBufFree(bytes)
    return out

fn integerReturnBody(): ir.BodyIR =
    let typeArenaCid = receiptFixtureCid("event_pipeline_type_arena_fixture")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, typeArenaCid),
           "event pipeline type arena")
    var slot: ir.LocalSlot
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.id = 0
    slot.name = "result"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16
    slot.sizeBytes = 4
    slot.alignBytes = 4
    add(body.localSlots, slot)
    var entryOwnership: int32[]
    add(entryOwnership, int32(ir.OwnInvalid))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(body, entryOwnership)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 42)
    let _ = ir.BodyIRAppendOp(body, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let blockIndex = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    ir.BodyIRControlFlowBegin(body, 0)
    ir.BodyIRControlFlowBindBlockScope(body, blockIndex, 0)
    var successors: int32[]
    var edgeKinds: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)
    ir.BodyIRControlFlowSeal(body)
    return body

@borrows
fn fragmentEventLanesValid(
        recipes: var contract.RegallocA64FunctionRecipes): bool =
    if !events.RegallocProductionEncoderEventStrictValidate(
           recipes.encoderEvents) ||
       recipes.encoderEvents.kinds.len != recipes.functionWords.len ||
       recipes.encoderEvents.retainedBytes !=
           int64(recipes.encoderEvents.reservedRowCount) * int64(44):
        return false
    for fragmentIndex in 0..<recipes.machineFragments.len:
        let fragment = recipes.machineFragments[fragmentIndex]
        if fragment.encoderEventStart != fragment.wordStart ||
           fragment.encoderEventCount != fragment.wordCount:
            return false
    return true

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister() ||
       !riscvadapter.RegallocRiscvCodegenUnitRegister():
        return 90
    let encoderSourceCid =
        receiptFixtureCid("event_pipeline_encoder_source_fixture")
    let metadataHash = layout.FixedBytes32Hex(
        receiptFixtureCid("event_pipeline_metadata_fixture"))

    # This is the exact compatibility API still used by primary/backend2.
    # RISC must remain red until CompilerCSG source authority is connected.
    var expectedRedBody = integerReturnBody()
    var expectedRedCallTargets: str[]
    var expectedRedDataTargets: str[]
    let expectedRed = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetRv64Linux,
        expectedRedBody, "event_authority_expected_red", 0,
        expectedRedCallTargets, expectedRedDataTargets, 0,
        artifacts.RegallocProductionFunctionKindNormal)
    assert(!expectedRed.valid &&
           expectedRed.errorCode ==
               emitter.RegallocProductionEmitRecipeInvalid,
           "event production caller authority expected red")

    var nonRiscBody = integerReturnBody()
    var nonRiscCallTargets: str[]
    var nonRiscDataTargets: str[]
    var nonRiscEmission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetA64Darwin,
        nonRiscBody, "event_non_risc_empty", 0,
        nonRiscCallTargets, nonRiscDataTargets, 0,
        artifacts.RegallocProductionFunctionKindNormal)
    assert(nonRiscEmission.valid &&
           events.RegallocProductionEncoderEventTableCanonicalEmpty(
               nonRiscEmission.recipes.encoderEvents),
           "event non-risc canonical empty")
    for fragmentIndex in 0..<
            nonRiscEmission.recipes.machineFragments.len:
        assert(nonRiscEmission.recipes.machineFragments[
                   fragmentIndex].encoderEventStart == -1 &&
               nonRiscEmission.recipes.machineFragments[
                   fragmentIndex].encoderEventCount == 0,
               "event non-risc fragment lane empty")

    var snapshotBody = integerReturnBody()
    var constraints = alloc.RegallocTargetConstraintsRv64()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        snapshotBody, constraints)
    assert(plan.valid && alloc.RegallocSinglePassValuePlanValidate(plan),
           "event snapshot plan")
    var recipes =
        riscvadapter.RegallocRiscvPrepareFunctionActionRecipesWithEncoderAuthority(
            snapshotBody, plan, 64, 73, encoderSourceCid)
    assert(recipes.valid && fragmentEventLanesValid(recipes),
           "event snapshot recipes")
    assert(artifacts.RegallocProductionBindMachineRecipe(plan, recipes),
           "event snapshot plan bind")
    let eventRoot = layout.FixedBytes32Hex(recipes.encoderEvents.orderedRoot)
    assert(plan.riscvEncoderEventCount == recipes.functionWords.len &&
           plan.riscvEncoderEventRootSha256 == eventRoot,
           "event snapshot plan receipt")

    var snapshotRow: artifacts.RegallocProductionSnapshotFunction
    snapshotRow.symbol = "event_snapshot"
    snapshotRow.functionIrIndex = 0
    snapshotRow.functionKind =
        artifacts.RegallocProductionFunctionKindNormal
    snapshotRow.bodyIrSha256 = plan.bodyIrIngressSha256
    snapshotRow.recipeOrigin =
        artifacts.RegallocProductionRecipeOriginBodyIrAdapter
    snapshotRow.plan = plan
    snapshotRow.recipes = recipes
    var snapshotRows: artifacts.RegallocProductionSnapshotFunction[]
    add(snapshotRows, snapshotRow)
    var snapshotMetadata: artifacts.RegallocProductionSnapshotMetadata
    snapshotMetadata.fixtureSourceSha256 = strings.CloneStr(metadataHash)
    snapshotMetadata.sourceManifestSha256 = strings.CloneStr(metadataHash)
    snapshotMetadata.driverSha256 = strings.CloneStr(metadataHash)
    snapshotMetadata.target =
        artifacts.RegallocProductionTargetRv64Linux
    let snapshot = artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
        snapshotMetadata, snapshotRows)
    assert(snapshot.valid &&
           strutil.Contains(
               snapshot.payload, "riscv_encoder_source_row=73\n") &&
           strutil.Contains(
               snapshot.payload,
               strutil.Join(["riscv_encoder_event_root_sha256=",
                             share(eventRoot), "\n"], "")) &&
           strutil.Contains(
               snapshot.payload,
               "riscv_encoder_reserved_row_count=") &&
           strutil.Contains(
               snapshot.payload,
               "riscv_encoder_retained_bytes=") &&
           !strutil.Contains(
               snapshot.payload,
               "riscv_encoder_event.0.row=") &&
           strutil.Contains(
               snapshot.payload, "encoder_event_start="),
           "event frozen artifact")
    var laneBody = integerReturnBody()
    var lanePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        laneBody, constraints)
    var laneRecipes =
        riscvadapter.RegallocRiscvPrepareFunctionActionRecipesWithEncoderAuthority(
            laneBody, lanePlan, 64, 73, encoderSourceCid)
    assert(laneRecipes.valid &&
           artifacts.RegallocProductionBindMachineRecipe(
               lanePlan, laneRecipes),
           "event lane mutation fixture")
    var laneFragment = laneRecipes.machineFragments[0]
    laneFragment.encoderEventCount = laneFragment.encoderEventCount + 1
    laneRecipes.machineFragments[0] = laneFragment
    var laneRow: artifacts.RegallocProductionSnapshotFunction
    laneRow.symbol = "event_lane_mutation"
    laneRow.functionIrIndex = 0
    laneRow.functionKind =
        artifacts.RegallocProductionFunctionKindNormal
    laneRow.bodyIrSha256 = lanePlan.bodyIrIngressSha256
    laneRow.recipeOrigin =
        artifacts.RegallocProductionRecipeOriginBodyIrAdapter
    laneRow.plan = lanePlan
    laneRow.recipes = laneRecipes
    var laneRows: artifacts.RegallocProductionSnapshotFunction[]
    add(laneRows, laneRow)
    var laneMetadata: artifacts.RegallocProductionSnapshotMetadata
    laneMetadata.fixtureSourceSha256 = strings.CloneStr(metadataHash)
    laneMetadata.sourceManifestSha256 = strings.CloneStr(metadataHash)
    laneMetadata.driverSha256 = strings.CloneStr(metadataHash)
    laneMetadata.target =
        artifacts.RegallocProductionTargetRv64Linux
    assert(!artifacts.RegallocProductionFrozenPlanSnapshotSerialize(
                laneMetadata, laneRows).valid,
           "event fragment lane mutation")

    var emissionBody = integerReturnBody()
    var noCallTargets: str[]
    var noDataTargets: str[]
    var emission = emitter.RegallocProductionEmitFunctionWithEncoderAuthority(
        artifacts.RegallocProductionTargetRv64Linux,
        emissionBody, "event_ledger", 0,
        noCallTargets, noDataTargets, 1,
        artifacts.RegallocProductionFunctionKindNormal,
        73, encoderSourceCid)
    assert(emission.valid && fragmentEventLanesValid(emission.recipes),
           "event final emission")
    assert(emission.receipt.riscvEncoderEventCount ==
               emission.recipes.functionWords.len &&
           emission.receipt.riscvEncoderEventRootSha256 ==
               layout.FixedBytes32Hex(
                   emission.recipes.encoderEvents.orderedRoot),
           "event final receipt")
    var ledgerRow: artifacts.RegallocProductionLedgerFunction
    ledgerRow.plan = emission.plan
    ledgerRow.recipes = emission.recipes
    ledgerRow.receipt = emission.receipt
    var ledgerRows: artifacts.RegallocProductionLedgerFunction[]
    add(ledgerRows, ledgerRow)
    var ledgerMetadata: artifacts.RegallocProductionLedgerMetadata
    ledgerMetadata.fixtureSourceSha256 = strings.CloneStr(metadataHash)
    ledgerMetadata.outputObjectSha256 = strings.CloneStr(metadataHash)
    ledgerMetadata.target =
        artifacts.RegallocProductionTargetRv64Linux
    let ledger = artifacts.RegallocProductionActionEmissionLedgerSerialize(
        ledgerMetadata, ledgerRows)
    assert(ledger.valid &&
           strutil.Contains(
               ledger.payload, "riscv_encoder_source_row=73\n") &&
           strutil.Contains(
               ledger.payload,
               "riscv_encoder_event_root_sha256="),
           "event final ledger")
    var badEmissionBody = integerReturnBody()
    var badEmission =
        emitter.RegallocProductionEmitFunctionWithEncoderAuthority(
            artifacts.RegallocProductionTargetRv64Linux,
            badEmissionBody, "event_bad_receipt", 0,
            noCallTargets, noDataTargets, 2,
            artifacts.RegallocProductionFunctionKindNormal,
            73, encoderSourceCid)
    assert(badEmission.valid, "event bad receipt fixture")
    badEmission.receipt.riscvEncoderEventCount =
        badEmission.receipt.riscvEncoderEventCount - 1
    var badLedgerRow: artifacts.RegallocProductionLedgerFunction
    badLedgerRow.plan = badEmission.plan
    badLedgerRow.recipes = badEmission.recipes
    badLedgerRow.receipt = badEmission.receipt
    var badLedgerRows: artifacts.RegallocProductionLedgerFunction[]
    add(badLedgerRows, badLedgerRow)
    var badLedgerMetadata: artifacts.RegallocProductionLedgerMetadata
    badLedgerMetadata.fixtureSourceSha256 = strings.CloneStr(metadataHash)
    badLedgerMetadata.outputObjectSha256 = strings.CloneStr(metadataHash)
    badLedgerMetadata.target =
        artifacts.RegallocProductionTargetRv64Linux
    assert(!artifacts.RegallocProductionActionEmissionLedgerSerialize(
                badLedgerMetadata, badLedgerRows).valid,
           "event final receipt mutation")

    var lifecycleBody = integerReturnBody()
    var lifecycleEmission =
        emitter.RegallocProductionEmitFunctionWithEncoderAuthority(
            artifacts.RegallocProductionTargetRv64Linux,
            lifecycleBody, "event_backend2_lifecycle", 0,
            noCallTargets, noDataTargets, 3,
            artifacts.RegallocProductionFunctionKindNormal,
            73, encoderSourceCid)
    assert(lifecycleEmission.valid &&
           fragmentEventLanesValid(lifecycleEmission.recipes),
           "event backend2 lifecycle fixture")
    b2temps.Backend2AssemblerEmissionRelease(lifecycleEmission)
    assert(b2temps.Backend2AssemblerEmissionStorageReleased(
               lifecycleEmission) &&
           events.RegallocProductionEncoderEventTableCanonicalEmpty(
               lifecycleEmission.recipes.encoderEvents),
           "event backend2 seven-column release")

    echo("riscv_encoder_event_pipeline_receipt_smoke=pass")
    return 0
