import std/atomic

var
    tkR4ProbeNewCount: atomic.I32

fn TkR4ProbeNewSet() =
    tkR4ProbeNewCount = atomic.NewI32(5)

fn main(): int32 =
    TkR4ProbeNewSet()
    if tkR4ProbeNewCount == nil:
        return 11
    if atomic.LoadI32(tkR4ProbeNewCount) != 5:
        return 12
    echo("tk_r4_probe_refglobal_new ok")
    return 0
