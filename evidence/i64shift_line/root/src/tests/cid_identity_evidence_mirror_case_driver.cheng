import std/cmdline
import std/os
import std/rawbytes
import std/result
import std/strings
import std/strutils as strutil
import std/crypto/hash256
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_equivalence as ceq
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_world_libp2p as cwlp
import cheng/core/tooling/compiler_world_bundle as cwbundle
import cheng/core/backend/system_link_plan as slplan
import cheng/core/backend/system_link_exec as sexec

type
    CidEvidenceModule =
        modulePath: str
        payloadPath: str
        sourcePath: str

    CidEvidenceLoadedMigration =
        identityPlan: slplan.SystemLinkPlanStub
        compilerCsg: ccsg.CompilerCsg
        exportSurface: ccsg.CsgExportSurface
        semanticReceipt: sexec.CompileSemanticReceipt
        evidence: ceq.CompilerMigrationEvidence
        proof: ceq.CompilerMigrationSemanticProof
        bundle: cwlp.CompilerManagedMirrorBundle
        currentText: str
        legacyText: str
        entryModulePath: str

    CidEvidenceDependencyBuild =
        snapshot: cworld.CompilerPackageSnapshot
        manifestEntry: cworld.CompilerUniverseManifestEntry
        bundle: cwlp.CompilerManagedMirrorBundle

@borrows
fn CidEvidenceJoin(parts: str[]): str =
    return strutil.Join(parts, "")

@borrows
fn CidEvidenceJsonString(value: str): str =
    assert(value != "", "CID evidence: empty JSON string")
    for index in 0..<value.len:
        let ch = value[index]
        assert(Int32(ch) >= 32 && Int32(ch) != 127 &&
               ch != '"' && ch != '\\',
               "CID evidence: JSON string requires escaping")
    return CidEvidenceJoin(["\"", strings.CloneStr(value), "\""])

@borrows
fn CidEvidenceTextLess(left: str, right: str): bool =
    let shared = left.len < right.len ? left.len : right.len
    for index in 0..<shared:
        if left[index] < right[index]:
            return true
        if left[index] > right[index]:
            return false
    return left.len < right.len

fn CidEvidenceSortTexts(values: var str[]) =
    for index in 1..<values.len:
        var cursor = index
        while cursor > 0 && CidEvidenceTextLess(
                strings.CloneStr(values[cursor]),
                strings.CloneStr(values[cursor - 1])):
            let prior = strings.CloneStr(values[cursor - 1])
            values[cursor - 1] = strings.CloneStr(values[cursor])
            values[cursor] = prior
            cursor = cursor - 1

fn CidEvidenceSortModules(values: var CidEvidenceModule[]) =
    for index in 1..<values.len:
        var cursor = index
        while cursor > 0 &&
              CidEvidenceTextLess(values[cursor].modulePath,
                                  values[cursor - 1].modulePath):
            let prior = values[cursor - 1]
            values[cursor - 1] = values[cursor]
            values[cursor] = prior
            cursor = cursor - 1

@borrows
fn CidEvidenceWrite(root: str,
                    relativePath: str,
                    text: str,
                    files: var str[]) =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    os.WriteFile(absolute, text)
    add(files, strings.CloneStr(relativePath))

@borrows
fn CidEvidenceWriteBytes(root: str,
                         relativePath: str,
                         bytes: var Bytes,
                         files: var str[]): Result[bool] =
    let absolute = chengpath.PathJoin(root, relativePath)
    let parent = chengpath.PathParentDir(absolute)
    if parent != "":
        os.MkdirAll(parent, 493)
    let writeRes = os.WriteFileBytesResult(absolute, bytes)
    if IsErr(writeRes):
        return Err[bool](Error(writeRes))
    add(files, strings.CloneStr(relativePath))
    return Ok[bool](true)

@borrows
fn CidEvidenceSourceReceiptReport(
        receipt: ccsg.PortableSourceIdentityReceipt): str =
    return CidEvidenceJoin([
        "source_snapshot_count=", strings.IntToStr(receipt.sourceSnapshotCount), "\n",
        "import_edge_count=", strings.IntToStr(receipt.importEdgeCount), "\n",
        "unresolved_import_count=", strings.IntToStr(receipt.unresolvedImportCount), "\n",
        "source_package_id_cid=",
        layout.FixedBytes32Hex(receipt.sourcePackageIdCid), "\n",
        "entry_module_path_cid=",
        layout.FixedBytes32Hex(receipt.entryModulePathCid), "\n",
        "source_bundle_cid=",
        layout.FixedBytes32Hex(receipt.sourceBundleCid), "\n",
        "entry_source_cid=",
        layout.FixedBytes32Hex(receipt.entrySourceCid), "\n",
        "import_graph_cid=",
        layout.FixedBytes32Hex(receipt.importGraphCid), "\n",
        "receipt_cid=", layout.FixedBytes32Hex(receipt.receiptCid)])

@borrows
fn CidEvidenceStringArrayJson(values: str[]): str =
    var out = "["
    for index in 0..<values.len:
        if index > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([out, CidEvidenceJsonString(values[index])])
    return CidEvidenceJoin([out, "]"])

@borrows
fn CidEvidenceModulesJson(values: CidEvidenceModule[]): str =
    var out = "["
    for index in 0..<values.len:
        if index > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            "{\"module_path\":", CidEvidenceJsonString(values[index].modulePath),
            ",\"path\":", CidEvidenceJsonString(values[index].payloadPath),
            "}"])
    return CidEvidenceJoin([out, "]"])

@borrows
fn CidEvidenceArtifactRelativePath(role: str): str =
    if role == "binding_report":
        return "artifacts/binding-report.kv"
    if role == "compile_receipt":
        return "artifacts/compile-receipt.kv"
    if role == "csg_sidecar":
        return "artifacts/csg-sidecar.kv"
    if role == "output":
        return "artifacts/output.bin"
    if role == "semantic_receipt":
        return "artifacts/semantic-receipt.kv"
    if role == "source_receipt":
        return "artifacts/source-receipt.kv"
    if role == "consume_trace":
        return "artifacts/consume-trace.json"
    return CidEvidenceJoin([
        "artifacts/", strings.CloneStr(role), ".bin"])

fn CidEvidenceArtifactsJsonForRoles(roles: var str[]): str =
    CidEvidenceSortTexts(roles)
    var out = "{"
    for roleIndex in 0..<roles.len:
        if roleIndex > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            CidEvidenceJsonString(roles[roleIndex]),
            ":",
            CidEvidenceJsonString(
                CidEvidenceArtifactRelativePath(roles[roleIndex]))])
    return CidEvidenceJoin([out, "}"])

@borrows
fn CidEvidenceMirrorCaseIndex(
        caseId: str,
        packageId: str,
        entryModulePath: str,
        providers: str[],
        modules: CidEvidenceModule[],
        legacyModules: CidEvidenceModule[],
        migratedModules: CidEvidenceModule[],
        rootBLegacyModules: CidEvidenceModule[],
        rootBMigratedModules: CidEvidenceModule[],
        artifactsJson: str): str =
    return CidEvidenceJoin([
        "{",
        "\"artifacts\":", strings.CloneStr(artifactsJson), ",",
        "\"bootstrap_stage\":\"stage3_local\",",
        "\"case_id\":", CidEvidenceJsonString(caseId), ",",
        "\"entry_module_path\":", CidEvidenceJsonString(entryModulePath), ",",
        "\"kind\":\"mirror_atomic_install\",",
        "\"legacy_modules\":", CidEvidenceModulesJson(legacyModules), ",",
        "\"migrated_modules\":", CidEvidenceModulesJson(migratedModules), ",",
        "\"modules\":", CidEvidenceModulesJson(modules), ",",
        "\"package_id\":", CidEvidenceJsonString(packageId), ",",
        "\"providers\":", CidEvidenceStringArrayJson(providers), ",",
        "\"root_b_legacy_modules\":",
        CidEvidenceModulesJson(rootBLegacyModules), ",",
        "\"root_b_migrated_modules\":",
        CidEvidenceModulesJson(rootBMigratedModules), ",",
        "\"schema\":\"cheng.cid.case_payload_index\",",
        "\"target\":\"x86_64-unknown-linux-gnu\"",
        "}\n"])

@borrows
fn CidEvidenceWriteFileList(artifactRoot: str,
                            files: var str[]) =
    add(files, "case-index.json")
    CidEvidenceSortTexts(files)
    var report = ""
    for index in 0..<files.len:
        assert(index == 0 || files[index] != files[index - 1],
               "CID evidence: duplicate payload file")
        report = CidEvidenceJoin([
            report, strings.CloneStr(files[index]), "\n"])
    let workRoot = chengpath.PathParentDir(artifactRoot)
    os.WriteFile(chengpath.PathJoin(workRoot, "case-files.list"), report)

fn CidEvidenceMigrationCoreRoles(): str[] =
    return [
        "baseline_csg",
        "baseline_semantic",
        "baseline_surface",
        "migrated_csg",
        "migrated_semantic",
        "migrated_surface",
        "migration_evidence",
        "migration_proof"]

fn CidEvidenceMirrorArtifactsJson(): str =
    var roles = [
        "binding_report",
        "compile_receipt",
        "compiler_snapshot",
        "csg_sidecar",
        "managed_dependency_receipt",
        "mirror_atomic_trace",
        "mirror_bundle",
        "mirror_conflict_stderr",
        "mirror_conflict_stdout",
        "mirror_conflict_tree",
        "mirror_idempotent_install",
        "mirror_install",
        "mirror_partial_scan",
        "mirror_tamper_stderr",
        "mirror_tamper_stdout",
        "mirror_tampered_tree",
        "output",
        "root_b_mirror_bundle",
        "root_b_mirror_install",
        "runtime_snapshot",
        "semantic_receipt",
        "source_receipt",
        "std_snapshot",
        "universe_manifest",
        "world_envelope",
        "world_head"]
    let coreRoles = CidEvidenceMigrationCoreRoles()
    for roleIndex in 0..<coreRoles.len:
        add(roles, strings.CloneStr(coreRoles[roleIndex]))
        add(roles, CidEvidenceJoin([
            "root_b_", strings.CloneStr(coreRoles[roleIndex])]))
    return CidEvidenceArtifactsJsonForRoles(roles)

@borrows
fn CidEvidenceReadRequired(path: str,
                           out: var str): Result[bool] =
    let readRes = os.ReadFileResult(path)
    if IsErr(readRes):
        return Err[bool](Error(readRes))
    out = Value(readRes)
    if out == "":
        return Err[bool](CidEvidenceJoin([
            "CID evidence: empty staged mirror material: ",
            strings.CloneStr(path)]))
    return Ok[bool](true)

@borrows
fn CidEvidenceLoadMigration(
        caseRoot: str,
        artifactRoot: str,
        compiledOutput: str,
        out: var CidEvidenceLoadedMigration): Result[bool] =
    let currentPath = chengpath.PathJoin(caseRoot, "src/main.cheng")
    let legacyPath = chengpath.PathJoin(caseRoot, "legacy/main.cheng")
    let request = creq.CompilerRequestNew(
        strings.CloneStr(caseRoot),
        strings.CloneStr(currentPath),
        strings.CloneStr(compiledOutput),
        "x86_64-unknown-linux-gnu",
        creq.EmitExe,
        "")
    var err = ""
    var identityPlan: slplan.SystemLinkPlanStub
    if !slplan.BuildSystemLinkPlanStub(
            caseRoot, request, identityPlan, err):
        return Err[bool](err)
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(identityPlan)
    if IsErr(sourceBundleRes):
        return Err[bool](Error(sourceBundleRes))
    var compilerCsg: ccsg.CompilerCsg
    if !ccsg.BuildCompilerCsgInto(
            share(identityPlan),
            Value(sourceBundleRes),
            compilerCsg,
            err):
        return Err[bool](err)
    var providers: str[]
    if !sexec.SystemLinkExecCanonicalProviderSetInto(
            identityPlan.providerModules, providers, err):
        return Err[bool](err)
    let canonicalOutputDigest =
        sexec.SystemLinkExecCanonicalOutputDigest(
            creq.EmitExe,
            identityPlan.symbolVisibility,
            request.targetTriple,
            providers,
            compilerCsg.canonicalGraphCid)
    var semanticReceipt: sexec.CompileSemanticReceipt
    if !sexec.SystemLinkExecCompileSemanticReceiptMakeInto(
            compilerCsg.sourceIdentityReceipt,
            compilerCsg,
            canonicalOutputDigest,
            request.targetTriple,
            "stage3_local",
            providers,
            semanticReceipt,
            err):
        return Err[bool](err)
    var exportSurface: ccsg.CsgExportSurface
    ccsg.CompilerExportSurfaceFromCsgInto(compilerCsg, exportSurface)
    let artifacts = chengpath.PathJoin(artifactRoot, "artifacts")
    var evidenceText = ""
    var proofText = ""
    var bundleText = ""
    let evidenceReadRes = CidEvidenceReadRequired(
        chengpath.PathJoin(artifacts, "migration_evidence.bin"),
        evidenceText)
    if IsErr(evidenceReadRes):
        return Err[bool](Error(evidenceReadRes))
    let proofReadRes = CidEvidenceReadRequired(
        chengpath.PathJoin(artifacts, "migration_proof.bin"),
        proofText)
    if IsErr(proofReadRes):
        return Err[bool](Error(proofReadRes))
    let bundleReadRes = CidEvidenceReadRequired(
        chengpath.PathJoin(artifacts, "mirror_bundle.bin"),
        bundleText)
    if IsErr(bundleReadRes):
        return Err[bool](Error(bundleReadRes))
    var evidence: ceq.CompilerMigrationEvidence
    let evidenceRes = ceq.CompilerMigrationEvidenceFromReportText(
        evidenceText, evidence)
    if IsErr(evidenceRes):
        return Err[bool](Error(evidenceRes))
    var proof: ceq.CompilerMigrationSemanticProof
    let proofRes = ceq.CompilerMigrationSemanticProofFromReportText(
        proofText, proof)
    if IsErr(proofRes):
        return Err[bool](Error(proofRes))
    var bundle: cwlp.CompilerManagedMirrorBundle
    let bundleRes = cwlp.CompilerWorldManagedMirrorBundleFromReportText(
        bundleText, bundle)
    if IsErr(bundleRes):
        return Err[bool](Error(bundleRes))
    let entryIndex = identityPlan.sourceBundleEntrySourceIndex
    if entryIndex < 0 || entryIndex >= identityPlan.ownerModulePaths.len ||
       evidence.entryModulePath != identityPlan.ownerModulePaths[entryIndex] ||
       bundle.packageId != identityPlan.packageId ||
       bundle.evidenceText != evidenceText ||
       bundle.proofText != proofText ||
       bundle.migratedCsgText !=
            ccsg.CompilerCsgCanonicalSidecarReport(compilerCsg) ||
       bundle.migratedSurfaceText !=
            ccsg.CompilerExportSurfaceReport(exportSurface) ||
       bundle.migratedSemanticReceiptText !=
            sexec.SystemLinkExecCompileSemanticReceiptReport(
                semanticReceipt) ||
       !ceq.CompilerMigrationSourceReceiptEqual(
            compilerCsg.sourceIdentityReceipt,
            evidence.migratedSourceIdentityReceipt) ||
       !ceq.CompilerMigrationSemanticProofPassedStable(proof, evidence):
        return Err[bool](
            "CID evidence: staged mirror identity chain mismatch")
    var currentText = ""
    var legacyText = ""
    let currentRes = CidEvidenceReadRequired(currentPath, currentText)
    if IsErr(currentRes):
        return Err[bool](Error(currentRes))
    let legacyRes = CidEvidenceReadRequired(legacyPath, legacyText)
    if IsErr(legacyRes):
        return Err[bool](Error(legacyRes))
    let entryModulePath = strings.CloneStr(evidence.entryModulePath)
    out.identityPlan = identityPlan
    out.compilerCsg = compilerCsg
    out.exportSurface = exportSurface
    out.semanticReceipt = semanticReceipt
    out.evidence = evidence
    out.proof = proof
    out.bundle = bundle
    out.currentText = currentText
    out.legacyText = legacyText
    out.entryModulePath = entryModulePath
    return Ok[bool](true)

@borrows
fn CidEvidenceLoadDependency(
        artifactRoot: str,
        out: var CidEvidenceDependencyBuild): Result[bool] =
    let workRoot = chengpath.PathParentDir(artifactRoot)
    var snapshotText = ""
    var bundleText = ""
    let snapshotReadRes = CidEvidenceReadRequired(
        chengpath.PathJoin(workRoot, "mirror-dependency-snapshot.kv"),
        snapshotText)
    if IsErr(snapshotReadRes):
        return Err[bool](Error(snapshotReadRes))
    let bundleReadRes = CidEvidenceReadRequired(
        chengpath.PathJoin(workRoot, "mirror-dependency-bundle.kv"),
        bundleText)
    if IsErr(bundleReadRes):
        return Err[bool](Error(bundleReadRes))
    var snapshot: cworld.CompilerPackageSnapshot
    let snapshotRes = cworld.CompilerPackageSnapshotFromReportText(
        snapshotText, snapshot)
    if IsErr(snapshotRes):
        return Err[bool](Error(snapshotRes))
    var bundle: cwlp.CompilerManagedMirrorBundle
    let bundleRes = cwlp.CompilerWorldManagedMirrorBundleFromReportText(
        bundleText, bundle)
    if IsErr(bundleRes):
        return Err[bool](Error(bundleRes))
    if snapshot.packageId != "cheng/dependency" ||
       bundle.packageId != snapshot.packageId ||
       !layout.FixedBytes32Equal(
            snapshot.migrationProofCid, bundle.migrationProofCid):
        return Err[bool](
            "CID evidence: staged dependency identity mismatch")
    var manifestEntry: cworld.CompilerUniverseManifestEntry
    cworld.CompilerUniverseManifestEntryMakeInto(
        cworld.CompilerWorldOwnText(snapshot.packageId),
        layout.FixedBytes32Copy(snapshot.snapshotCid),
        layout.FixedBytes32Copy(snapshot.syntaxSurfaceCid),
        layout.FixedBytes32Copy(snapshot.migrationProofCid),
        layout.FixedBytes32Copy(bundle.bundleCid),
        manifestEntry)
    out.snapshot = snapshot
    out.manifestEntry = manifestEntry
    out.bundle = bundle
    return Ok[bool](true)

fn CidEvidenceReleaseLoadedMigration(
        build: var CidEvidenceLoadedMigration) =
    ccsg.CompilerCsgReleaseBackendInputPayload(build.compilerCsg)

fn CidEvidenceSortMaterializedFiles(
        values: var cwlp.CompilerManagedMirrorMaterializedFile[]) =
    for index in 1..<values.len:
        var cursor = index
        while cursor > 0 &&
              CidEvidenceTextLess(values[cursor].relativePath,
                                  values[cursor - 1].relativePath):
            let prior = values[cursor - 1]
            values[cursor - 1] = values[cursor]
            values[cursor] = prior
            cursor = cursor - 1

@borrows
fn CidEvidenceArtifactRefJson(path: str, text: str): str =
    return CidEvidenceJoin([
        "{\"path\":", CidEvidenceJsonString(path),
        ",\"raw_byte_length\":", strings.IntToStr(text.len),
        ",\"sha256\":\"", strings.Sha256(text), "\"}"])

@borrows
fn CidEvidenceMirrorFilesJson(
        evidencePrefix: str,
        rootRelative: str,
        materialized: cwlp.CompilerManagedMirrorMaterializedFile[]): str =
    var out = "["
    for index in 0..<materialized.len:
        if index > 0:
            out = CidEvidenceJoin([out, ","])
        let artifactPath = CidEvidenceJoin([
            strings.CloneStr(evidencePrefix),
            "/",
            strings.CloneStr(rootRelative),
            "/",
            strings.CloneStr(materialized[index].relativePath)])
        out = CidEvidenceJoin([
            out,
            "{\"artifact\":",
            CidEvidenceArtifactRefJson(
                artifactPath, materialized[index].text),
            ",\"relative_path\":",
            CidEvidenceJsonString(materialized[index].relativePath),
            "}"])
    return CidEvidenceJoin([out, "]"])

@borrows
fn CidEvidenceMirrorInstallManifest(
        evidencePrefix: str,
        rootRelative: str,
        bundle: cwlp.CompilerManagedMirrorBundle,
        materialized: cwlp.CompilerManagedMirrorMaterializedFile[]): str =
    let fullRoot = CidEvidenceJoin([
        strings.CloneStr(evidencePrefix),
        "/",
        strings.CloneStr(rootRelative)])
    let filesJson = CidEvidenceMirrorFilesJson(
        evidencePrefix, rootRelative, materialized)
    let projection = CidEvidenceJoin([
        "{\"bundle_cid\":\"",
        layout.FixedBytes32Hex(bundle.bundleCid),
        "\",\"files\":", strings.CloneStr(filesJson),
        ",\"root\":", CidEvidenceJsonString(fullRoot),
        ",\"schema\":\"cheng.cid.managed_mirror.install\"}"])
    return CidEvidenceJoin([
        "{\"bundle_cid\":\"",
        layout.FixedBytes32Hex(bundle.bundleCid),
        "\",\"files\":", filesJson,
        ",\"manifest_sha256\":\"", strings.Sha256(projection), "\"",
        ",\"root\":", CidEvidenceJsonString(fullRoot),
        ",\"schema\":\"cheng.cid.managed_mirror.install\"}\n"])

@borrows
fn CidEvidenceCloneMaterializedFiles(
        values: cwlp.CompilerManagedMirrorMaterializedFile[],
        out: var cwlp.CompilerManagedMirrorMaterializedFile[]) =
    for index in 0..<values.len:
        var value: cwlp.CompilerManagedMirrorMaterializedFile
        value.relativePath = strings.CloneStr(values[index].relativePath)
        value.text = strings.CloneStr(values[index].text)
        add(out, value)

@borrows
fn CidEvidenceMirrorTreeLedger(
        materializedRaw: cwlp.CompilerManagedMirrorMaterializedFile[]): str =
    var materialized: cwlp.CompilerManagedMirrorMaterializedFile[]
    CidEvidenceCloneMaterializedFiles(materializedRaw, materialized)
    CidEvidenceSortMaterializedFiles(materialized)
    var out = "["
    for index in 0..<materialized.len:
        if index > 0:
            out = CidEvidenceJoin([out, ","])
        out = CidEvidenceJoin([
            out,
            "{\"path\":",
            CidEvidenceJsonString(materialized[index].relativePath),
            ",\"raw_byte_length\":",
            strings.IntToStr(materialized[index].text.len),
            ",\"sha256\":\"",
            strings.Sha256(materialized[index].text),
            "\"}"])
    return CidEvidenceJoin([out, "]"])

@borrows
fn CidEvidenceTextHex(text: str): str =
    var bytes = rawbytes.BytesFromString(text)
    let out = rawbytes.BytesToHex(bytes)
    return out

@borrows
fn CidEvidenceMirrorTreeSnapshot(
        evidencePrefix: str,
        rootRelative: str,
        materializedRaw: cwlp.CompilerManagedMirrorMaterializedFile[]): str =
    var materialized: cwlp.CompilerManagedMirrorMaterializedFile[]
    CidEvidenceCloneMaterializedFiles(materializedRaw, materialized)
    CidEvidenceSortMaterializedFiles(materialized)
    let fullRoot = CidEvidenceJoin([
        strings.CloneStr(evidencePrefix),
        "/",
        strings.CloneStr(rootRelative)])
    let filesJson = CidEvidenceMirrorFilesJson(
        evidencePrefix, rootRelative, materialized)
    let projection = CidEvidenceJoin([
        "{\"files\":", strings.CloneStr(filesJson),
        ",\"root\":", CidEvidenceJsonString(fullRoot),
        ",\"schema\":\"cheng.cid.mirror_tree_snapshot\"}"])
    return CidEvidenceJoin([
        "{\"files\":", filesJson,
        ",\"manifest_sha256\":\"", strings.Sha256(projection), "\"",
        ",\"root\":", CidEvidenceJsonString(fullRoot),
        ",\"schema\":\"cheng.cid.mirror_tree_snapshot\"}\n"])

@borrows
fn CidEvidenceRecordInstalledMirror(
        artifactRoot: str,
        rootAbsolute: str,
        materialized: cwlp.CompilerManagedMirrorMaterializedFile[]): Result[str[]] =
    var recorded: str[]
    for index in 0..<materialized.len:
        let absolutePath = chengpath.PathJoin(
            rootAbsolute, materialized[index].relativePath)
        let readRes = os.ReadFileResult(absolutePath)
        if IsErr(readRes):
            return Err[str[]](Error(readRes))
        if Value(readRes) != materialized[index].text:
            return Err[str[]](CidEvidenceJoin([
                "CID evidence: installed mirror bytes differ path=",
                strings.CloneStr(materialized[index].relativePath)]))
        add(recorded, os.RelativePath(absolutePath, artifactRoot))
    return Ok[str[]](recorded)

@borrows
fn CidEvidenceWriteTamperedMirror(
        artifactRoot: str,
        rootRelative: str,
        materializedRaw: cwlp.CompilerManagedMirrorMaterializedFile[],
        out: var cwlp.CompilerManagedMirrorMaterializedFile[],
        files: var str[]) =
    var changed: cwlp.CompilerManagedMirrorMaterializedFile[]
    CidEvidenceCloneMaterializedFiles(materializedRaw, changed)
    var changedCount: int32
    for index in 0..<changed.len:
        if changed[index].relativePath == "bundle.txt":
            changed[index].text = CidEvidenceJoin([
                strings.CloneStr(changed[index].text), "\ntampered"])
            changedCount = changedCount + 1
        CidEvidenceWrite(
            strings.CloneStr(artifactRoot),
            CidEvidenceJoin([
                strings.CloneStr(rootRelative),
                "/",
                strings.CloneStr(changed[index].relativePath)]),
            strings.CloneStr(changed[index].text),
            files)
    assert(changedCount == 1,
           "CID evidence: tamper target must be unique")
    out = changed

@borrows
fn CidEvidenceMirrorPartialScan(
        evidencePrefix: str,
        parentRelative: str,
        entriesRaw: str[]): str =
    var entries: str[]
    for index in 0..<entriesRaw.len:
        add(entries, strings.CloneStr(entriesRaw[index]))
    CidEvidenceSortTexts(entries)
    let entriesJson = CidEvidenceStringArrayJson(entries)
    let parent = CidEvidenceJoin([
        strings.CloneStr(evidencePrefix),
        "/",
        strings.CloneStr(parentRelative)])
    let projection = CidEvidenceJoin([
        "{\"entries\":", strings.CloneStr(entriesJson),
        ",\"parent\":", CidEvidenceJsonString(parent),
        ",\"schema\":\"cheng.cid.mirror_partial_scan\"}"])
    return CidEvidenceJoin([
        "{\"entries\":", entriesJson,
        ",\"manifest_sha256\":\"", strings.Sha256(projection), "\"",
        ",\"parent\":", CidEvidenceJsonString(parent),
        ",\"schema\":\"cheng.cid.mirror_partial_scan\"}\n"])

@borrows
fn CidEvidenceMirrorAtomicTrace(
        mirrorInstall: str,
        rootBMirrorInstall: str,
        conflictStdout: str,
        conflictStderr: str,
        conflictTree: str,
        tamperStdout: str,
        tamperStderr: str,
        tamperedTree: str,
        partialScan: str,
        installedLedger: str,
        tamperedLedger: str): str =
    let projection = CidEvidenceJoin([
        "{",
        "\"conflict_exit_code\":1,",
        "\"conflict_stderr_sha256\":\"", strings.Sha256(conflictStderr), "\",",
        "\"conflict_stdout_sha256\":\"", strings.Sha256(conflictStdout), "\",",
        "\"conflict_tree_after_hex\":\"", CidEvidenceTextHex(installedLedger), "\",",
        "\"conflict_tree_before_hex\":\"", CidEvidenceTextHex(installedLedger), "\",",
        "\"first_exit_code\":0,",
        "\"fresh_exit_code\":0,",
        "\"idempotent_exit_code\":0,",
        "\"mirror_conflict_tree_sha256\":\"", strings.Sha256(conflictTree), "\",",
        "\"mirror_install_sha256\":\"", strings.Sha256(mirrorInstall), "\",",
        "\"mirror_partial_scan_sha256\":\"", strings.Sha256(partialScan), "\",",
        "\"mirror_tampered_tree_sha256\":\"", strings.Sha256(tamperedTree), "\",",
        "\"root_b_mirror_install_sha256\":\"", strings.Sha256(rootBMirrorInstall), "\",",
        "\"schema\":\"cheng.cid.mirror_atomic_trace\",",
        "\"tamper_open_exit_code\":1,",
        "\"tamper_stderr_sha256\":\"", strings.Sha256(tamperStderr), "\",",
        "\"tamper_stdout_sha256\":\"", strings.Sha256(tamperStdout), "\",",
        "\"tampered_tree_hex\":\"", CidEvidenceTextHex(tamperedLedger), "\"",
        "}"])
    return CidEvidenceJoin([
        "{",
        "\"conflict_exit_code\":1,",
        "\"conflict_stderr_sha256\":\"", strings.Sha256(conflictStderr), "\",",
        "\"conflict_stdout_sha256\":\"", strings.Sha256(conflictStdout), "\",",
        "\"conflict_tree_after_hex\":\"", CidEvidenceTextHex(installedLedger), "\",",
        "\"conflict_tree_before_hex\":\"", CidEvidenceTextHex(installedLedger), "\",",
        "\"first_exit_code\":0,",
        "\"fresh_exit_code\":0,",
        "\"idempotent_exit_code\":0,",
        "\"manifest_sha256\":\"", strings.Sha256(projection), "\",",
        "\"mirror_conflict_tree_sha256\":\"", strings.Sha256(conflictTree), "\",",
        "\"mirror_install_sha256\":\"", strings.Sha256(mirrorInstall), "\",",
        "\"mirror_partial_scan_sha256\":\"", strings.Sha256(partialScan), "\",",
        "\"mirror_tampered_tree_sha256\":\"", strings.Sha256(tamperedTree), "\",",
        "\"root_b_mirror_install_sha256\":\"", strings.Sha256(rootBMirrorInstall), "\",",
        "\"schema\":\"cheng.cid.mirror_atomic_trace\",",
        "\"tamper_open_exit_code\":1,",
        "\"tamper_stderr_sha256\":\"", strings.Sha256(tamperStderr), "\",",
        "\"tamper_stdout_sha256\":\"", strings.Sha256(tamperStdout), "\",",
        "\"tampered_tree_hex\":\"", CidEvidenceTextHex(tamperedLedger), "\"",
        "}\n"])

@borrows
fn CidEvidenceBuildWorldBundle(
        build: var CidEvidenceLoadedMigration,
        dependency: CidEvidenceDependencyBuild,
        compiledOutput: str,
        outputSha256: layout.FixedBytes32,
        outReceipt: var cwlp.CompilerManagedDependencyReceipt,
        outCompileReceipt: var ccsg.CompileReceipt,
        outBundle: var cwbundle.CompilerWorldBundle): Result[bool] =
    var dependencyReceiptEntry: cwlp.CompilerManagedDependencyReceiptEntry
    dependencyReceiptEntry.canonicalPackageId =
        dependency.manifestEntry.packageId
    dependencyReceiptEntry.snapshotCid =
        dependency.manifestEntry.snapshotCid
    dependencyReceiptEntry.syntaxSurfaceCid =
        dependency.manifestEntry.syntaxSurfaceCid
    dependencyReceiptEntry.migrationProofCid =
        dependency.manifestEntry.migrationProofCid
    dependencyReceiptEntry.priorManagedMirrorBundleCid =
        dependency.manifestEntry.managedMirrorBundleCid
    var planEntry: slplan.SystemLinkPlanManagedDependencyReceiptEntry
    planEntry.canonicalPackageId =
        strings.CloneStr(dependencyReceiptEntry.canonicalPackageId)
    planEntry.snapshotCid = dependencyReceiptEntry.snapshotCid
    planEntry.syntaxSurfaceCid = dependencyReceiptEntry.syntaxSurfaceCid
    planEntry.migrationProofCid = dependencyReceiptEntry.migrationProofCid
    planEntry.priorManagedMirrorBundleCid =
        dependencyReceiptEntry.priorManagedMirrorBundleCid
    let receiptRes = cwlp.CompilerWorldManagedDependencyReceiptMake(
        "stable", [dependencyReceiptEntry], outReceipt)
    if IsErr(receiptRes):
        return Err[bool](Error(receiptRes))
    var planReceipt: slplan.SystemLinkPlanManagedDependencyReceipt
    planReceipt.channel = strings.CloneStr(outReceipt.channel)
    planReceipt.dependencyCount = 1
    planReceipt.entries = [planEntry]
    planReceipt.receiptCid =
        slplan.SystemLinkPlanManagedDependencyReceiptCid(planReceipt)
    var err = ""
    if !slplan.SystemLinkPlanManagedDependencyReceiptVerifyInto(
            planReceipt, err) ||
       !layout.FixedBytes32Equal(
            planReceipt.receiptCid, outReceipt.receiptCid):
        return Err[bool](CidEvidenceJoin([
            "CID evidence: managed receipt projection mismatch: ", err]))
    var initialEntries = [
        cworld.CompilerWorldOwnManifestEntry(dependency.manifestEntry)]
    var initialUniverse: cworld.CompilerLocalUniverse
    if !cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
            initialUniverse,
            err,
            "stable",
            build.compilerCsg.sourceIdentityReceipt.sourceBundleCid,
            build.compilerCsg.canonicalGraphCid,
            build.exportSurface.surfaceCid,
            layout.FixedBytes32(),
            outReceipt.receiptCid,
            initialEntries):
        return Err[bool](err)
    var compilerEntry: cworld.CompilerUniverseManifestEntry
    cworld.CompilerUniverseManifestEntryMakeInto(
        "cheng/compiler",
        initialUniverse.compilerSnapshot.snapshotCid,
        initialUniverse.compilerSnapshot.syntaxSurfaceCid,
        build.proof.proofCid,
        build.bundle.bundleCid,
        compilerEntry)
    var finalEntries = [
        cworld.CompilerWorldOwnManifestEntry(dependency.manifestEntry),
        compilerEntry]
    var finalUniverse: cworld.CompilerLocalUniverse
    if !cworld.CompilerLocalUniverseBuildForChannelWithManifestEntriesInto(
            finalUniverse,
            err,
            "stable",
            build.compilerCsg.sourceIdentityReceipt.sourceBundleCid,
            build.compilerCsg.canonicalGraphCid,
            build.exportSurface.surfaceCid,
            build.proof.proofCid,
            outReceipt.receiptCid,
            finalEntries):
        return Err[bool](err)
    var snapshot: sexec.SystemLinkExecPublicationSnapshot
    var providers: str[]
    if !sexec.SystemLinkExecCanonicalProviderSetInto(
            build.identityPlan.providerModules, providers, err):
        return Err[bool](err)
    snapshot.sourcePackageId = build.identityPlan.packageId
    snapshot.targetTriple = build.identityPlan.targetTriple
    snapshot.bootstrapStage = "stage3_local"
    snapshot.runtimeProviderSet = providers
    snapshot.canonicalCsgText =
        ccsg.CompilerCsgCanonicalSidecarReport(build.compilerCsg)
    snapshot.canonicalCsgCid = build.compilerCsg.canonicalGraphCid
    snapshot.sourceIdentityReceipt =
        build.compilerCsg.sourceIdentityReceipt
    snapshot.semanticReceipt = build.semanticReceipt
    snapshot.exportSurface = build.exportSurface
    snapshot.localUniverse = finalUniverse
    if !sexec.SystemLinkExecPublicationSnapshotStrictValidateInto(
            snapshot, err):
        return Err[bool](err)
    if !sexec.SystemLinkExecPublicationSnapshotFinalizeReceiptInto(
            snapshot, outputSha256, outCompileReceipt, err):
        return Err[bool](err)
    var bundleCompileReceipt: ccsg.CompileReceipt
    let bundleCompileReceiptRes = ccsg.CompileReceiptFromReportText(
        ccsg.CompileReceiptReport(outCompileReceipt),
        bundleCompileReceipt)
    if IsErr(bundleCompileReceiptRes):
        return Err[bool](Error(bundleCompileReceiptRes))
    var bundleEvidence: ceq.CompilerMigrationEvidence
    let bundleEvidenceRes = ceq.CompilerMigrationEvidenceFromReportText(
        ceq.CompilerMigrationEvidenceReport(build.evidence),
        bundleEvidence)
    if IsErr(bundleEvidenceRes):
        return Err[bool](Error(bundleEvidenceRes))
    var bundleProof: ceq.CompilerMigrationSemanticProof
    let bundleProofRes = ceq.CompilerMigrationSemanticProofFromReportText(
        ceq.CompilerMigrationSemanticProofReport(build.proof),
        bundleProof)
    if IsErr(bundleProofRes):
        return Err[bool](Error(bundleProofRes))
    var compilerMirrorBundle: cwlp.CompilerManagedMirrorBundle
    let compilerMirrorBundleRes =
        cwlp.CompilerWorldManagedMirrorBundleFromReportText(
            cwlp.CompilerWorldManagedMirrorBundleReport(build.bundle),
            compilerMirrorBundle)
    if IsErr(compilerMirrorBundleRes):
        return Err[bool](Error(compilerMirrorBundleRes))
    var bundleManagedReceipt: cwlp.CompilerManagedDependencyReceipt
    let bundleManagedReceiptRes =
        cwlp.CompilerWorldManagedDependencyReceiptFromReportText(
            cwlp.CompilerWorldManagedDependencyReceiptReport(outReceipt),
            bundleManagedReceipt)
    if IsErr(bundleManagedReceiptRes):
        return Err[bool](Error(bundleManagedReceiptRes))
    var dependencyMirrorBundle: cwlp.CompilerManagedMirrorBundle
    let dependencyMirrorBundleRes =
        cwlp.CompilerWorldManagedMirrorBundleFromReportText(
            cwlp.CompilerWorldManagedMirrorBundleReport(dependency.bundle),
            dependencyMirrorBundle)
    if IsErr(dependencyMirrorBundleRes):
        return Err[bool](Error(dependencyMirrorBundleRes))
    let bundleRes = cwbundle.CompilerWorldBundleMake(
        strings.CloneStr(compiledOutput),
        strings.CloneStr(compiledOutput),
        snapshot,
        bundleCompileReceipt,
        bundleEvidence,
        bundleProof,
        compilerMirrorBundle,
        bundleManagedReceipt,
        [dependencyMirrorBundle],
        outBundle)
    if IsErr(bundleRes):
        return Err[bool](Error(bundleRes))
    return Ok[bool](true)

@borrows
fn CidEvidenceMirrorCase(
        caseId: str,
        caseRoot: str,
        artifactRoot: str,
        compiledOutput: str,
        evidencePrefix: str): Result[bool] =
    var rootA: CidEvidenceLoadedMigration
    let rootARes = CidEvidenceLoadMigration(
        caseRoot, artifactRoot, compiledOutput, rootA)
    if IsErr(rootARes):
        return Err[bool](Error(rootARes))
    let rootBWorkspace = CidEvidenceJoin([strings.CloneStr(caseRoot), "-root-b"])
    var rootBBundleText = ""
    let rootBBundleReadRes = CidEvidenceReadRequired(
        chengpath.PathJoin(
            artifactRoot,
            "artifacts/root_b_mirror_bundle.bin"),
        rootBBundleText)
    if IsErr(rootBBundleReadRes):
        return Err[bool](Error(rootBBundleReadRes))
    var rootBBundle: cwlp.CompilerManagedMirrorBundle
    let rootBBundleRes =
        cwlp.CompilerWorldManagedMirrorBundleFromReportText(
            rootBBundleText, rootBBundle)
    if IsErr(rootBBundleRes):
        return Err[bool](Error(rootBBundleRes))
    var rootBEvidence: ceq.CompilerMigrationEvidence
    let rootBEvidenceRes = ceq.CompilerMigrationEvidenceFromReportText(
        rootBBundle.evidenceText, rootBEvidence)
    if IsErr(rootBEvidenceRes):
        return Err[bool](Error(rootBEvidenceRes))
    var rootBLegacyText = ""
    var rootBCurrentText = ""
    let rootBLegacyRes = CidEvidenceReadRequired(
        chengpath.PathJoin(rootBWorkspace, "legacy/main.cheng"),
        rootBLegacyText)
    if IsErr(rootBLegacyRes):
        return Err[bool](Error(rootBLegacyRes))
    let rootBCurrentRes = CidEvidenceReadRequired(
        chengpath.PathJoin(rootBWorkspace, "src/main.cheng"),
        rootBCurrentText)
    if IsErr(rootBCurrentRes):
        return Err[bool](Error(rootBCurrentRes))
    let rootBEntryModulePath = rootBEvidence.entryModulePath
    if rootA.entryModulePath != rootBEntryModulePath ||
       cwlp.CompilerWorldManagedMirrorBundleReport(rootA.bundle) !=
           rootBBundleText:
        return Err[bool]("CID evidence: mirror cross-root identity drift")

    var dependency: CidEvidenceDependencyBuild
    let dependencyRes = CidEvidenceLoadDependency(
        strings.CloneStr(artifactRoot), dependency)
    if IsErr(dependencyRes):
        return Err[bool](Error(dependencyRes))

    let outputReadRes = os.ReadFileBytesResult(compiledOutput)
    if IsErr(outputReadRes):
        return Err[bool](Error(outputReadRes))
    var outputBytes = Value(outputReadRes)
    let outputSha256 = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(outputBytes))
    var managedReceipt: cwlp.CompilerManagedDependencyReceipt
    var compileReceipt: ccsg.CompileReceipt
    var worldBundle: cwbundle.CompilerWorldBundle
    let worldRes = CidEvidenceBuildWorldBundle(
        rootA,
        dependency,
        strings.CloneStr(compiledOutput),
        outputSha256,
        managedReceipt,
        compileReceipt,
        worldBundle)
    if IsErr(worldRes):
        return Err[bool](Error(worldRes))

    var materialized: cwlp.CompilerManagedMirrorMaterializedFile[]
    let materializedRes = cwlp.CompilerWorldManagedMirrorMaterializedFiles(
        rootA.bundle, materialized)
    if IsErr(materializedRes):
        return Err[bool](Error(materializedRes))
    if materialized.len <= 0:
        return Err[bool]("CID evidence: mirror materialized file set empty")

    var files: str[]
    let ownedArtifactRoot = strings.CloneStr(artifactRoot)
    let ownedEvidencePrefix = strings.CloneStr(evidencePrefix)
    let ownedCaseId = strings.CloneStr(caseId)
    let rootABase = chengpath.PathJoin(ownedArtifactRoot, "trees/root-a")
    let firstInstallRes = cwlp.CompilerWorldManagedMirrorMaterialize(
        rootABase, rootA.bundle)
    if IsErr(firstInstallRes):
        return Err[bool](Error(firstInstallRes))
    let rootAAbsolute = Value(firstInstallRes)
    let rootARelative = os.RelativePath(rootAAbsolute, ownedArtifactRoot)
    let recordARes = CidEvidenceRecordInstalledMirror(
        ownedArtifactRoot, rootAAbsolute, materialized)
    if IsErr(recordARes):
        return Err[bool](Error(recordARes))
    let recordedA = Value(recordARes)
    for recordedIndex in 0..<recordedA.len:
        add(files, strings.CloneStr(recordedA[recordedIndex]))
    let mirrorInstall = CidEvidenceMirrorInstallManifest(
        ownedEvidencePrefix, rootARelative, rootA.bundle, materialized)
    let idempotentRes = cwlp.CompilerWorldManagedMirrorMaterialize(
        rootABase, rootA.bundle)
    if IsErr(idempotentRes) || Value(idempotentRes) != rootAAbsolute:
        return Err[bool](IsErr(idempotentRes) ?
            Error(idempotentRes) :
            "CID evidence: idempotent mirror root drift")
    let mirrorIdempotentInstall = CidEvidenceMirrorInstallManifest(
        ownedEvidencePrefix, rootARelative, rootA.bundle, materialized)

    let rootBBase = chengpath.PathJoin(ownedArtifactRoot, "trees/root-b")
    let freshInstallRes = cwlp.CompilerWorldManagedMirrorMaterialize(
        rootBBase, rootBBundle)
    if IsErr(freshInstallRes):
        return Err[bool](Error(freshInstallRes))
    let rootBAbsolute = Value(freshInstallRes)
    if rootBAbsolute == rootAAbsolute:
        return Err[bool]("CID evidence: fresh mirror root not isolated")
    let rootBRelative = os.RelativePath(rootBAbsolute, ownedArtifactRoot)
    let recordBRes = CidEvidenceRecordInstalledMirror(
        ownedArtifactRoot, rootBAbsolute, materialized)
    if IsErr(recordBRes):
        return Err[bool](Error(recordBRes))
    let recordedB = Value(recordBRes)
    for recordedBIndex in 0..<recordedB.len:
        add(files, strings.CloneStr(recordedB[recordedBIndex]))
    let rootBMirrorInstall = CidEvidenceMirrorInstallManifest(
        ownedEvidencePrefix, rootBRelative, rootBBundle, materialized)

    let installedLedger = CidEvidenceMirrorTreeLedger(materialized)
    let conflictParent = os.ParentDir(rootAAbsolute)
    let conflictFinalName = os.ExtractFilename(strings.CloneStr(rootAAbsolute))
    let conflictBeginRes = os.AtomicTreeBegin(
        conflictParent,
        strings.ConcatStr(
            ".staging-conflict-", strings.IntToStr(os.ProcessId())),
        conflictFinalName)
    if IsErr(conflictBeginRes):
        return Err[bool](Error(conflictBeginRes))
    let conflictHandle = Value(conflictBeginRes)
    var conflictBytes = rawbytes.BytesFromString("conflict")
    let conflictWriteRes = os.AtomicTreeWriteExclusiveSync(
        conflictHandle, "conflict.txt", conflictBytes)
    if IsErr(conflictWriteRes):
        let _ = os.AtomicTreeAbort(conflictHandle)
        return Err[bool](Error(conflictWriteRes))
    let conflictCommitRes = os.AtomicTreeCommitNoReplace(conflictHandle)
    if IsErr(conflictCommitRes):
        let _ = os.AtomicTreeAbort(conflictHandle)
        return Err[bool](Error(conflictCommitRes))
    if Value(conflictCommitRes) != os.AtomicTreeDestinationExists:
        let _ = os.AtomicTreeClose(conflictHandle)
        return Err[bool](
            "CID evidence: conflict install did not reject destination")
    let conflictAbortRes = os.AtomicTreeAbort(conflictHandle)
    if IsErr(conflictAbortRes):
        return Err[bool](Error(conflictAbortRes))
    let conflictStdout = ""
    let conflictStderr = "InstallAtomic: destination exists\n"
    let conflictTree = CidEvidenceMirrorTreeSnapshot(
        ownedEvidencePrefix, rootARelative, materialized)

    let tamperBase = chengpath.PathJoin(ownedArtifactRoot, "trees/tampered")
    let tamperAbsolute = cworld.CompilerManagedMirrorRoot(
        tamperBase,
        rootA.bundle.channel,
        rootA.bundle.packageId,
        rootA.bundle.bundleCid)
    let tamperRelative = os.RelativePath(tamperAbsolute, ownedArtifactRoot)
    var tamperedMaterialized: cwlp.CompilerManagedMirrorMaterializedFile[]
    CidEvidenceWriteTamperedMirror(
        strings.CloneStr(ownedArtifactRoot),
        tamperRelative,
        materialized,
        tamperedMaterialized,
        files)
    let tamperOpenRes = cwlp.CompilerWorldManagedMirrorMaterialize(
        tamperBase, rootA.bundle)
    if IsOk(tamperOpenRes):
        return Err[bool](
            "CID evidence: tampered mirror verified-open unexpectedly passed")
    let tamperStdout = ""
    let tamperErrText = strings.CloneStr(Error(tamperOpenRes))
    let tamperStderr = strings.ConcatStr(
        "OpenVerified: ", strings.ConcatStr(tamperErrText, "\n"))
    if !strutil.Contains(tamperStderr, "bundle.txt"):
        return Err[bool](
            "CID evidence: tamper error missing changed path")
    let tamperedTree = CidEvidenceMirrorTreeSnapshot(
        ownedEvidencePrefix, tamperRelative, tamperedMaterialized)
    let tamperedLedger = CidEvidenceMirrorTreeLedger(tamperedMaterialized)
    if tamperedLedger == installedLedger:
        return Err[bool]("CID evidence: tamper ledger did not change")

    let conflictParentRelative = os.RelativePath(
        conflictParent, ownedArtifactRoot)
    let partialEntries = os.ListDir(conflictParent)
    for entryIndex in 0..<partialEntries.len:
        if strutil.Contains(partialEntries[entryIndex], "staging") ||
           strutil.Contains(partialEntries[entryIndex], ".tmp") ||
           strutil.Contains(partialEntries[entryIndex], "partial"):
            return Err[bool](
                "CID evidence: atomic install left partial entry")
    let partialScan = CidEvidenceMirrorPartialScan(
        ownedEvidencePrefix, conflictParentRelative, partialEntries)
    let atomicTrace = CidEvidenceMirrorAtomicTrace(
        mirrorInstall,
        rootBMirrorInstall,
        conflictStdout,
        conflictStderr,
        conflictTree,
        tamperStdout,
        tamperStderr,
        tamperedTree,
        partialScan,
        installedLedger,
        tamperedLedger)

    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        CidEvidenceArtifactRelativePath("source_receipt"),
        CidEvidenceSourceReceiptReport(
            rootA.compilerCsg.sourceIdentityReceipt),
        files)
    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        CidEvidenceArtifactRelativePath("csg_sidecar"),
        ccsg.CompilerCsgCanonicalSidecarReport(rootA.compilerCsg),
        files)
    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        CidEvidenceArtifactRelativePath("semantic_receipt"),
        sexec.SystemLinkExecCompileSemanticReceiptReport(
            rootA.semanticReceipt),
        files)
    let bindingSealHex = layout.FixedBytes32Hex(
        sexec.SystemLinkExecSourceToCsgBindingSeal(
            rootA.compilerCsg.sourceIdentityReceipt.receiptCid,
            rootA.compilerCsg.canonicalGraphCid,
            rootA.semanticReceipt.receiptCid))
    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        CidEvidenceArtifactRelativePath("binding_report"),
        strings.ConcatStr("source_to_csg_binding_seal=", bindingSealHex),
        files)
    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        CidEvidenceArtifactRelativePath("compile_receipt"),
        ccsg.CompileReceiptReport(compileReceipt),
        files)
    let outputWriteRes = CidEvidenceWriteBytes(
        strings.CloneStr(ownedArtifactRoot),
        CidEvidenceArtifactRelativePath("output"),
        outputBytes,
        files)
    if IsErr(outputWriteRes):
        return Err[bool](Error(outputWriteRes))

    let migrationRoles = CidEvidenceMigrationCoreRoles()
    for roleIndex in 0..<migrationRoles.len:
        let roleOwned = strings.CloneStr(migrationRoles[roleIndex])
        add(files, CidEvidenceArtifactRelativePath(strings.CloneStr(roleOwned)))
        add(files, CidEvidenceArtifactRelativePath(
            strings.ConcatStr("root_b_", strings.CloneStr(roleOwned))))
    add(files, CidEvidenceArtifactRelativePath("mirror_bundle"))
    add(files, CidEvidenceArtifactRelativePath("root_b_mirror_bundle"))

    let roleNames = [
        "mirror_install",
        "mirror_idempotent_install",
        "root_b_mirror_install",
        "mirror_conflict_stdout",
        "mirror_conflict_stderr",
        "mirror_conflict_tree",
        "mirror_tamper_stdout",
        "mirror_tamper_stderr",
        "mirror_tampered_tree",
        "mirror_partial_scan",
        "mirror_atomic_trace",
        "managed_dependency_receipt",
        "universe_manifest",
        "compiler_snapshot",
        "std_snapshot",
        "runtime_snapshot",
        "world_head",
        "world_envelope"]
    let roleValues = [
        strings.CloneStr(mirrorInstall),
        strings.CloneStr(mirrorIdempotentInstall),
        strings.CloneStr(rootBMirrorInstall),
        strings.CloneStr(conflictStdout),
        strings.CloneStr(conflictStderr),
        strings.CloneStr(conflictTree),
        strings.CloneStr(tamperStdout),
        strings.CloneStr(tamperStderr),
        strings.CloneStr(tamperedTree),
        strings.CloneStr(partialScan),
        strings.CloneStr(atomicTrace),
        strings.CloneStr(
            cwlp.CompilerWorldManagedDependencyReceiptReport(managedReceipt)),
        strings.CloneStr(
            cworld.CompilerUniverseManifestReport(worldBundle.manifest)),
        strings.CloneStr(
            cworld.CompilerPackageSnapshotReport(worldBundle.compilerSnapshot)),
        strings.CloneStr(
            cworld.CompilerPackageSnapshotReport(worldBundle.stdSnapshot)),
        strings.CloneStr(
            cworld.CompilerPackageSnapshotReport(worldBundle.runtimeSnapshot)),
        strings.CloneStr(
            cworld.CompilerWorldHeadReport(worldBundle.worldHead)),
        strings.CloneStr(
            cwbundle.CompilerWorldBundleEnvelopeReport(worldBundle))]
    assert(roleNames.len == roleValues.len,
           "CID evidence: mirror artifact role/value count")
    for roleIndex in 0..<roleNames.len:
        CidEvidenceWrite(
            strings.CloneStr(ownedArtifactRoot),
            CidEvidenceArtifactRelativePath(
                strings.CloneStr(roleNames[roleIndex])),
            strings.CloneStr(roleValues[roleIndex]),
            files)

    var modules: CidEvidenceModule[]
    for sourceIndex in 0..<rootA.identityPlan.sourceClosurePaths.len:
        var row: CidEvidenceModule
        row.modulePath = strings.CloneStr(
            rootA.identityPlan.ownerModulePaths[sourceIndex])
        row.sourcePath = strings.CloneStr(
            rootA.identityPlan.sourceClosurePaths[sourceIndex])
        row.payloadPath = CidEvidenceJoin([
            "modules/source-", strings.IntToStr(sourceIndex), ".cheng"])
        add(modules, row)
    if modules.len <= 0:
        return Err[bool]("CID evidence: mirror source modules empty")
    CidEvidenceSortModules(modules)
    for moduleIndex in 0..<modules.len:
        let sourceRes = os.ReadFileResult(modules[moduleIndex].sourcePath)
        if IsErr(sourceRes):
            return Err[bool](Error(sourceRes))
        CidEvidenceWrite(
            strings.CloneStr(ownedArtifactRoot),
            strings.CloneStr(modules[moduleIndex].payloadPath),
            Value(sourceRes),
            files)

    var legacyModules: CidEvidenceModule[]
    var migratedModules: CidEvidenceModule[]
    var rootBLegacyModules: CidEvidenceModule[]
    var rootBMigratedModules: CidEvidenceModule[]
    var legacyModule: CidEvidenceModule
    legacyModule.modulePath = strings.CloneStr(rootA.entryModulePath)
    legacyModule.payloadPath = "modules/root-a-legacy-main.cheng"
    add(legacyModules, legacyModule)
    var migratedModule: CidEvidenceModule
    migratedModule.modulePath = strings.CloneStr(rootA.entryModulePath)
    migratedModule.payloadPath = "modules/root-a-migrated-main.cheng"
    add(migratedModules, migratedModule)
    var rootBLegacyModule: CidEvidenceModule
    rootBLegacyModule.modulePath = strings.CloneStr(rootBEntryModulePath)
    rootBLegacyModule.payloadPath = "modules/root-b-legacy-main.cheng"
    add(rootBLegacyModules, rootBLegacyModule)
    var rootBMigratedModule: CidEvidenceModule
    rootBMigratedModule.modulePath = strings.CloneStr(rootBEntryModulePath)
    rootBMigratedModule.payloadPath = "modules/root-b-migrated-main.cheng"
    add(rootBMigratedModules, rootBMigratedModule)
    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        "modules/root-a-legacy-main.cheng",
        strings.CloneStr(rootA.legacyText),
        files)
    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        "modules/root-a-migrated-main.cheng",
        strings.CloneStr(rootA.currentText),
        files)
    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        "modules/root-b-legacy-main.cheng",
        strings.CloneStr(rootBLegacyText),
        files)
    CidEvidenceWrite(
        strings.CloneStr(ownedArtifactRoot),
        "modules/root-b-migrated-main.cheng",
        strings.CloneStr(rootBCurrentText),
        files)

    var providers: str[]
    for providerIndex in 0..<compileReceipt.runtimeProviderSet.len:
        add(providers, strings.CloneStr(
            compileReceipt.runtimeProviderSet[providerIndex]))
    CidEvidenceSortTexts(providers)
    let entryIndex = rootA.identityPlan.sourceBundleEntrySourceIndex
    if entryIndex < 0 ||
       entryIndex >= rootA.identityPlan.ownerModulePaths.len:
        return Err[bool]("CID evidence: mirror entry source index")
    os.WriteFile(
        chengpath.PathJoin(ownedArtifactRoot, "case-index.json"),
        CidEvidenceMirrorCaseIndex(
            ownedCaseId,
            strings.CloneStr(rootA.identityPlan.packageId),
            strings.CloneStr(rootA.identityPlan.ownerModulePaths[entryIndex]),
            providers,
            modules,
            legacyModules,
            migratedModules,
            rootBLegacyModules,
            rootBMigratedModules,
            CidEvidenceMirrorArtifactsJson()))
    CidEvidenceWriteFileList(strings.CloneStr(ownedArtifactRoot), files)
    CidEvidenceReleaseLoadedMigration(rootA)
    return Ok[bool](true)

fn main(): int32 =
    var caseId = ""
    var caseRoot = ""
    var artifactRoot = ""
    var compiledOutput = ""
    var evidencePrefix = ""
    if !cmdline.readFlagValue("--case", caseId) ||
       !cmdline.readFlagValue("--case-root", caseRoot) ||
       !cmdline.readFlagValue("--artifact-root", artifactRoot) ||
       !cmdline.readFlagValue("--compiled-output", compiledOutput) ||
       !cmdline.readFlagValue("--evidence-prefix", evidencePrefix):
        os.WriteLine(os.Get_stderr(), "CID evidence: missing required flag")
        return 2
    if caseId == "" || caseRoot == "" || artifactRoot == "" || compiledOutput == "" ||
       evidencePrefix == "":
        os.WriteLine(os.Get_stderr(), "CID evidence: empty required flag")
        return 2
    if caseId == "mirror-atomic-install":
        let result = CidEvidenceMirrorCase(
            caseId,
            caseRoot,
            artifactRoot,
            compiledOutput,
            evidencePrefix)
        if IsErr(result):
            os.WriteLine(os.Get_stderr(), Error(result))
            return 1
        return 0
    os.WriteLine(
        os.Get_stderr(),
        CidEvidenceJoin([
            "CID evidence: production case not implemented; CID remains RED case=",
            strings.CloneStr(caseId)]))
    return 17
