# Control-flow shape of ParserValueExprProduceStatementEvents:
# many loop-carried locals, continue arms, and rebound lineEnd.
fn helper(a: int32, b: int32): int32 =
    return a + b

fn loopMany(n: int32): int32 =
    var cursor: int32
    var typeCol: int32
    var typeEntry: int32
    var activeRoot: int32
    var activeScope: int32
    var activeStart: int32
    var routineCol: int32
    var routineEntry: int32
    var bindCol: int32
    var bindEntry: int32
    var bindCount: int32
    var pendingStart: int32
    var pendingCount: int32
    var regionStart: int32
    var regionEnd: int32
    cursor = 0
    typeCol = -1
    typeEntry = -1
    activeRoot = -1
    activeScope = -1
    activeStart = -1
    routineCol = -1
    routineEntry = -1
    bindCol = -1
    bindEntry = -1
    bindCount = 0
    pendingStart = -1
    pendingCount = 0
    regionStart = -1
    regionEnd = -1
    while cursor < n:
        var lineEnd: int32
        lineEnd = cursor + 1
        let lineCol = cursor - (cursor / 7) * 7
        let firstKind = cursor - (cursor / 11) * 11
        var boundStart: int32
        var boundCount: int32
        boundStart = -1
        boundCount = 0
        if firstKind != 3 && pendingCount > 0:
            boundStart = pendingStart
            boundCount = pendingCount
            pendingStart = -1
            pendingCount = 0
        if typeCol >= 0 && lineCol <= typeCol:
            typeCol = -1
            typeEntry = -1
            activeRoot = -1
            activeScope = -1
            activeStart = -1
            regionStart = -1
            regionEnd = -1
        if routineCol >= 0 && lineCol <= routineCol:
            routineCol = -1
            routineEntry = -1
        if bindCol >= 0 && lineCol <= bindCol:
            if bindCount <= 0:
                return -1
            bindCol = -1
            bindEntry = -1
            bindCount = 0
        if (firstKind == 0 || firstKind == 1) && cursor + 1 == lineEnd:
            bindCol = lineCol
            bindEntry = -1
            bindCount = 0
            cursor = lineEnd
            continue
        if bindCol >= 0:
            if bindEntry < 0:
                bindEntry = lineCol
            if lineCol != bindEntry:
                return -2
            bindCount = bindCount + 1
            cursor = lineEnd
            continue
        if firstKind == 2 && cursor + 1 == lineEnd:
            typeCol = lineCol
            typeEntry = -1
            activeRoot = -1
            cursor = lineEnd
            continue
        if firstKind == 2:
            let prev = activeRoot
            var declRoot: int32
            declRoot = helper(cursor, lineCol)
            activeRoot = declRoot
            cursor = helper(lineEnd, prev)
            continue
        if firstKind == 4 && cursor + 1 == lineEnd:
            routineCol = lineCol
            routineEntry = -1
            cursor = lineEnd
            continue
        if firstKind == 4:
            lineEnd = helper(lineEnd, 1)
        if typeCol >= 0:
            if typeEntry < 0:
                typeEntry = lineCol
            if lineCol == typeEntry:
                activeRoot = helper(cursor, typeCol)
                if regionStart < 0:
                    regionStart = cursor
                regionEnd = lineEnd
                cursor = lineEnd
                continue
        if routineCol >= 0:
            if routineEntry < 0:
                routineEntry = lineCol
            if lineCol == routineEntry:
                cursor = helper(lineEnd, boundCount)
                continue
        if firstKind == 3:
            if pendingCount == 0:
                pendingStart = cursor
            pendingCount = pendingCount + 1
        cursor = lineEnd
    if bindCol >= 0 && bindCount <= 0:
        return -3
    if pendingCount != 0:
        return -4
    return cursor + activeRoot + regionEnd

fn main(): int32 =
    let v = loopMany(40)
    if v < 0:
        return 1
    return 0
