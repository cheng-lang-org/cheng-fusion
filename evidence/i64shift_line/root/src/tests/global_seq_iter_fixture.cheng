var GlobalSeqIterPaths: str[]

fn GlobalSeqIterScannedIndex(target: str): int32 =
    for i in 0..<GlobalSeqIterPaths.len:
        if GlobalSeqIterPaths[i] != target:
            continue
        return i
    return -1

fn GlobalSeqIterSum(): int32 =
    var total: int32
    for i in 0..<GlobalSeqIterPaths.len:
        total = total + int32(1)
    return total

fn main(): int32 =
    add(GlobalSeqIterPaths, "alpha")
    add(GlobalSeqIterPaths, "beta")
    add(GlobalSeqIterPaths, "gamma")
    let idx = GlobalSeqIterScannedIndex("beta")
    let count = GlobalSeqIterSum()
    if idx != 1:
        return 11
    if count != 3:
        return 12
    return 0
