import cheng/core/csg_core/csgc_authority

fn main(): int32 =
    let forged =
        csgc_authority.
            CsgCoreCsgcUpstreamTrustAnchorReadCurrentHead(
                "/tmp/attacker-csg-store",
                "self-signed")
    return csgc_authority.
        CsgCoreCsgcUpstreamTrustAnchorError(forged).len
