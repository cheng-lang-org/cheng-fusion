fn appendDigit(out: var int32, digit: int32) =
    out = out * 10 + digit

fn runDefers(out: var int32, early: bool) =
    defer:
        if true:
            appendDigit(out, 1)
    defer:
        appendDigit(out, 2)
    if early:
        return
    appendDigit(out, 9)

fn returnSnapshot(out: var int32): int32 =
    var value = 7
    defer:
        appendDigit(out, 3)
        value = 9
    return value

fn deferAfterGuard(out: var int32, stop: bool) =
    if stop:
        return
    defer:
        appendDigit(out, 4)
    appendDigit(out, 9)

fn managedDeferLocal(out: var str) =
    defer:
        let local = Fmt"managed"
        if local != "managed":
            out = Fmt"bad"
        else:
            out = local

fn main(): int32 =
    var normal: int32
    runDefers(normal, false)
    if normal != 921:
        return 1

    var early: int32
    runDefers(early, true)
    if early != 21:
        return 2

    var snapshotTrace: int32
    if returnSnapshot(snapshotTrace) != 7:
        return 3
    if snapshotTrace != 3:
        return 4

    var stopped: int32
    deferAfterGuard(stopped, true)
    if stopped != 0:
        return 5
    var activated: int32
    deferAfterGuard(activated, false)
    if activated != 94:
        return 6
    var managed = Fmt""
    managedDeferLocal(managed)
    if managed != "managed":
        return 7
    return 0

