module cold_linkerless_nested_if

fn classify(x: int32): int32 =
    if x < 0:
        if x < -10:
            if x < -100:
                return 1
            elif x < -50:
                return 2
            else:
                return 3
        elif x == 0:
            return 4
        else:
            if x == -5:
                return 5
            else:
                return 6
    elif x == 0:
        return 7
    else:
        if x > 100:
            return 8
        elif x > 50:
            return 9
        else:
            if x == 10:
                return 10
            elif x == 20:
                return 11
            else:
                return 12

fn main(): int32 =
    var result: int32
    if classify(-200) != 1: result = 1
    if classify(-75) != 2: result = 2
    if classify(-30) != 3: result = 3
    if classify(0) != 7: result = 4
    if classify(-5) != 5: result = 5
    if classify(-3) != 6: result = 6
    if classify(200) != 8: result = 7
    if classify(75) != 9: result = 8
    if classify(10) != 10: result = 9
    if classify(20) != 11: result = 10
    if classify(30) != 12: result = 11
    return result

main()
