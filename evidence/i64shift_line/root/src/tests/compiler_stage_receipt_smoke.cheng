import std/os
import std/rawbytes as rawbytes
import std/result
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/tooling/compiler_stage_receipt as stageReceipt

fn StageReceiptSmokeDigest(text: str): layout.FixedBytes32 =
    let view = rawbytes.BytesFromString(text)
    return hash256.Sha256Fixed(layout.ByteSpanFromBytes(view))

fn StageReceiptSmokeCountKeys(): str[] =
    var out: str[]
    add(out, "artifact_bytes")
    add(out, "node_count")
    return out

fn StageReceiptSmokeCountValues(nodeCount: int64): int64[] =
    var out: int64[]
    add(out, Int64(4096))
    add(out, nodeCount)
    return out

fn StageReceiptSmokeMake(stageKind: str,
                          laneKind: str,
                          producerIdentity: str,
                          predecessor: layout.FixedBytes32,
                          artifact: layout.FixedBytes32,
                          nodeCount: int64): stageReceipt.CompilerStageReceipt =
    let madeRes = stageReceipt.CompilerStageReceiptMake(
        stageKind,
        laneKind,
        producerIdentity,
        predecessor,
        artifact,
        StageReceiptSmokeCountKeys(),
        StageReceiptSmokeCountValues(nodeCount))
    assert(IsOk(madeRes), "compiler stage receipt smoke: make")
    return Value(madeRes)

fn StageReceiptSmokePositiveAndMutations() =
    let predecessor = StageReceiptSmokeDigest("stage-receipt-predecessor-a")
    let predecessorB = StageReceiptSmokeDigest("stage-receipt-predecessor-b")
    let artifact = StageReceiptSmokeDigest("stage-receipt-artifact-a")
    let artifactB = StageReceiptSmokeDigest("stage-receipt-artifact-b")
    let base = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifact,
        Int64(17))
    let repeated = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifact,
        Int64(17))
    assert(layout.FixedBytes32Equal(base.receiptRaw32, repeated.receiptRaw32),
           "compiler stage receipt smoke: non-deterministic receipt")
    # Independent Python/struct.pack oracle for the documented frame order:
    # u32be(length) || payload for every field and numeric payload.
    assert(layout.FixedBytes32Hex(base.receiptRaw32) ==
           "b576ec45c06f8e5bc571a40e78633c257b02f04581c3f6099871bad76e6e4924",
           "compiler stage receipt smoke: canonical golden mismatch")
    let verifyRes = stageReceipt.CompilerStageReceiptVerify(base)
    assert(IsOk(verifyRes) && Value(verifyRes),
           "compiler stage receipt smoke: typed verify")

    let predecessorMutation = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessorB,
        artifact,
        Int64(17))
    assert(!layout.FixedBytes32Equal(base.receiptRaw32,
                                     predecessorMutation.receiptRaw32),
           "compiler stage receipt smoke: predecessor mutation survived")
    let artifactMutation = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifactB,
        Int64(17))
    assert(!layout.FixedBytes32Equal(base.receiptRaw32,
                                     artifactMutation.receiptRaw32),
           "compiler stage receipt smoke: artifact mutation survived")
    let countMutation = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifact,
        Int64(18))
    assert(!layout.FixedBytes32Equal(base.receiptRaw32,
                                     countMutation.receiptRaw32),
           "compiler stage receipt smoke: count mutation survived")
    var countKeyMutationKeys: str[]
    add(countKeyMutationKeys, "artifact_bytes")
    add(countKeyMutationKeys, "operation_count")
    let countKeyMutationRes = stageReceipt.CompilerStageReceiptMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifact,
        countKeyMutationKeys,
        StageReceiptSmokeCountValues(Int64(17)))
    assert(IsOk(countKeyMutationRes) &&
           !layout.FixedBytes32Equal(base.receiptRaw32,
                                     Value(countKeyMutationRes).receiptRaw32),
           "compiler stage receipt smoke: count key mutation survived")
    let highCountA = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifact,
        Int64(4294967296))
    let highCountB = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifact,
        Int64(4294967297))
    assert(!layout.FixedBytes32Equal(highCountA.receiptRaw32,
                                     highCountB.receiptRaw32),
           "compiler stage receipt smoke: int64 count high bits lost")
    let producerIdentityMutation = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-b",
        predecessor,
        artifact,
        Int64(17))
    assert(!layout.FixedBytes32Equal(base.receiptRaw32,
                                     producerIdentityMutation.receiptRaw32),
           "compiler stage receipt smoke: producer mutation survived")
    let stageMutation = StageReceiptSmokeMake(
        stageReceipt.CompilerStageReceiptStageCsg,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifact,
        Int64(17))
    assert(!layout.FixedBytes32Equal(base.receiptRaw32,
                                     stageMutation.receiptRaw32),
           "compiler stage receipt smoke: stage mutation survived")

    var laneMutation = base
    laneMutation.laneKind = stageReceipt.CompilerStageReceiptLanePrimary
    assert(IsErr(stageReceipt.CompilerStageReceiptVerify(laneMutation)),
           "compiler stage receipt smoke: lane mutation survived")
    var invalidStageMutation = base
    invalidStageMutation.stageKind = "unknown_stage"
    assert(IsErr(stageReceipt.CompilerStageReceiptVerify(invalidStageMutation)),
           "compiler stage receipt smoke: invalid stage mutation survived")
    var zeroPredecessorMutation = base
    zeroPredecessorMutation.predecessorRaw32 = layout.FixedBytes32()
    assert(IsErr(stageReceipt.CompilerStageReceiptVerify(
                     zeroPredecessorMutation)),
           "compiler stage receipt smoke: zero predecessor mutation survived")
    var zeroArtifactMutation = base
    zeroArtifactMutation.artifactRaw32 = layout.FixedBytes32()
    assert(IsErr(stageReceipt.CompilerStageReceiptVerify(
                     zeroArtifactMutation)),
           "compiler stage receipt smoke: zero artifact mutation survived")
    var invalidProducerIdentityMutation = base
    invalidProducerIdentityMutation.producerIdentity = " stage-producer-a"
    assert(IsErr(stageReceipt.CompilerStageReceiptVerify(
                     invalidProducerIdentityMutation)),
           "compiler stage receipt smoke: producer identity mutation survived")
    var receiptMutation = base
    receiptMutation.receiptRaw32 = stageMutation.receiptRaw32
    assert(IsErr(stageReceipt.CompilerStageReceiptVerify(receiptMutation)),
           "compiler stage receipt smoke: receipt mutation survived")

    var callerKeys = StageReceiptSmokeCountKeys()
    var callerValues = StageReceiptSmokeCountValues(Int64(17))
    let copiedRes = stageReceipt.CompilerStageReceiptMake(
        stageReceipt.CompilerStageReceiptStageTypedExpr,
        stageReceipt.CompilerStageReceiptLaneShared,
        "stage-producer-a",
        predecessor,
        artifact,
        callerKeys,
        callerValues)
    assert(IsOk(copiedRes),
           "compiler stage receipt smoke: copied count make")
    callerKeys[0] = "mutated_key"
    callerValues[0] = Int64(8192)
    assert(Value(copiedRes).countKeys[0] == "artifact_bytes" &&
           Value(copiedRes).countValues[0] == Int64(4096),
           "compiler stage receipt smoke: caller count alias survived")
    assert(IsOk(stageReceipt.CompilerStageReceiptVerify(Value(copiedRes))),
           "compiler stage receipt smoke: copied count verify")

    var predecessorRaw = layout.FixedBytes32ToBytes(predecessor)
    var artifactRaw = layout.FixedBytes32ToBytes(artifact)
    var receiptRaw = layout.FixedBytes32ToBytes(base.receiptRaw32)
    let rawVerifyRes = stageReceipt.CompilerStageReceiptVerifyEnvelopeRaw(
        base.stageKind,
        base.laneKind,
        base.producerIdentity,
        predecessorRaw,
        artifactRaw,
        base.countKeys,
        base.countValues,
        receiptRaw)
    assert(IsOk(rawVerifyRes) && Value(rawVerifyRes),
           "compiler stage receipt smoke: raw verify")
    var wrongReceiptRaw = layout.FixedBytes32ToBytes(stageMutation.receiptRaw32)
    assert(IsErr(stageReceipt.CompilerStageReceiptVerifyEnvelopeRaw(
                     base.stageKind,
                     base.laneKind,
                     base.producerIdentity,
                     predecessorRaw,
                     artifactRaw,
                     base.countKeys,
                     base.countValues,
                     wrongReceiptRaw)),
           "compiler stage receipt smoke: wrong receipt raw survived")
    rawbytes.BytesFree(predecessorRaw)
    rawbytes.BytesFree(artifactRaw)
    rawbytes.BytesFree(receiptRaw)
    rawbytes.BytesFree(wrongReceiptRaw)

fn StageReceiptSmokeStrictRejects() =
    let predecessor = StageReceiptSmokeDigest("stage-receipt-predecessor")
    let artifact = StageReceiptSmokeDigest("stage-receipt-artifact")
    let keys = StageReceiptSmokeCountKeys()
    let values = StageReceiptSmokeCountValues(Int64(9))
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     "",
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessor,
                     artifact,
                     keys,
                     values)),
           "compiler stage receipt smoke: empty stage survived")
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     "unknown_stage",
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessor,
                     artifact,
                     keys,
                     values)),
           "compiler stage receipt smoke: invalid stage survived")
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     "unknown_lane",
                     "producer-a",
                     predecessor,
                     artifact,
                     keys,
                     values)),
           "compiler stage receipt smoke: invalid lane survived")
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLanePrimary,
                     "producer-a",
                     predecessor,
                     artifact,
                     keys,
                     values)),
           "compiler stage receipt smoke: stage lane mismatch survived")
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "",
                     predecessor,
                     artifact,
                     keys,
                     values)),
           "compiler stage receipt smoke: empty producer survived")
    var invalidProducerIdentities: str[]
    add(invalidProducerIdentities, " stage-producer-a")
    add(invalidProducerIdentities, "stage-producer-a ")
    add(invalidProducerIdentities, "stage\tproducer")
    add(invalidProducerIdentities, "stage\nproducer")
    add(invalidProducerIdentities, "stage\x7fproducer")
    for index in 0..<invalidProducerIdentities.len:
        assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                         stageReceipt.CompilerStageReceiptStageTypedExpr,
                         stageReceipt.CompilerStageReceiptLaneShared,
                         invalidProducerIdentities[index],
                         predecessor,
                         artifact,
                         keys,
                         values)),
               "compiler stage receipt smoke: invalid producer identity survived")
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "stage-producer-a",
                     layout.FixedBytes32(),
                     artifact,
                     keys,
                     values)),
           "compiler stage receipt smoke: zero predecessor survived")
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "stage-producer-a",
                     predecessor,
                     layout.FixedBytes32(),
                     keys,
                     values)),
           "compiler stage receipt smoke: zero artifact survived")

    var emptyKeys: str[]
    var emptyValues: int64[]
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessor,
                     artifact,
                     emptyKeys,
                     emptyValues)),
           "compiler stage receipt smoke: missing counts survived")
    var oneValue: int64[]
    add(oneValue, Int64(1))
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessor,
                     artifact,
                     keys,
                     oneValue)),
           "compiler stage receipt smoke: count column mismatch survived")
    var duplicateKeys: str[]
    add(duplicateKeys, "node_count")
    add(duplicateKeys, "node_count")
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessor,
                     artifact,
                     duplicateKeys,
                     values)),
           "compiler stage receipt smoke: duplicate count key survived")
    var emptyCountKey: str[]
    add(emptyCountKey, "")
    var emptyCountKeyValue: int64[]
    add(emptyCountKeyValue, Int64(1))
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessor,
                     artifact,
                     emptyCountKey,
                     emptyCountKeyValue)),
           "compiler stage receipt smoke: empty count key survived")
    var malformedCountKeys: str[]
    add(malformedCountKeys, "Upper_count")
    add(malformedCountKeys, "_node_count")
    add(malformedCountKeys, "9node_count")
    add(malformedCountKeys, "node__count")
    add(malformedCountKeys, "node_count_")
    add(malformedCountKeys, "node-count")
    for malformedIndex in 0..<malformedCountKeys.len:
        var malformedCountKey: str[]
        add(malformedCountKey, malformedCountKeys[malformedIndex])
        assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                         stageReceipt.CompilerStageReceiptStageTypedExpr,
                         stageReceipt.CompilerStageReceiptLaneShared,
                         "producer-a",
                         predecessor,
                         artifact,
                         malformedCountKey,
                         emptyCountKeyValue)),
               "compiler stage receipt smoke: malformed lower_snake count key survived")
    var unsortedKeys: str[]
    add(unsortedKeys, "node_count")
    add(unsortedKeys, "artifact_bytes")
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessor,
                     artifact,
                     unsortedKeys,
                     values)),
           "compiler stage receipt smoke: non-canonical order survived")
    var negativeValues = StageReceiptSmokeCountValues(Int64(-1))
    assert(IsErr(stageReceipt.CompilerStageReceiptMake(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessor,
                     artifact,
                     keys,
                     negativeValues)),
           "compiler stage receipt smoke: negative count survived")

    var predecessorRaw = layout.FixedBytes32ToBytes(predecessor)
    var artifactRaw = layout.FixedBytes32ToBytes(artifact)
    var shortRaw = rawbytes.BytesAlloc(31)
    var longRaw = rawbytes.BytesAlloc(33)
    assert(IsErr(stageReceipt.CompilerStageReceiptMakeRaw(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     shortRaw,
                     artifactRaw,
                     keys,
                     values)),
           "compiler stage receipt smoke: short predecessor survived")
    assert(IsErr(stageReceipt.CompilerStageReceiptMakeRaw(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessorRaw,
                     longRaw,
                     keys,
                     values)),
           "compiler stage receipt smoke: long artifact survived")
    assert(IsErr(stageReceipt.CompilerStageReceiptVerifyEnvelopeRaw(
                     stageReceipt.CompilerStageReceiptStageTypedExpr,
                     stageReceipt.CompilerStageReceiptLaneShared,
                     "producer-a",
                     predecessorRaw,
                     artifactRaw,
                     keys,
                     values,
                     shortRaw)),
           "compiler stage receipt smoke: short receipt survived")
    rawbytes.BytesFree(predecessorRaw)
    rawbytes.BytesFree(artifactRaw)
    rawbytes.BytesFree(shortRaw)
    rawbytes.BytesFree(longRaw)

fn StageReceiptSmokeAllKinds() =
    # parser is encoded as the independent prerequisite.  The following seven
    # entries retain Fusion's exact source-bound protocol order.
    var stageKinds: str[]
    add(stageKinds, stageReceipt.CompilerStageReceiptStageParser)
    add(stageKinds, stageReceipt.CompilerStageReceiptStageTypedExpr)
    add(stageKinds, stageReceipt.CompilerStageReceiptStageCsg)
    add(stageKinds, stageReceipt.CompilerStageReceiptStageLowering)
    add(stageKinds, stageReceipt.CompilerStageReceiptStagePrimary)
    add(stageKinds, stageReceipt.CompilerStageReceiptStagePrimaryRegalloc)
    add(stageKinds, stageReceipt.CompilerStageReceiptStageBackend2)
    add(stageKinds, stageReceipt.CompilerStageReceiptStageBackend2Regalloc)
    var laneKinds: str[]
    add(laneKinds, stageReceipt.CompilerStageReceiptLaneShared)
    add(laneKinds, stageReceipt.CompilerStageReceiptLaneShared)
    add(laneKinds, stageReceipt.CompilerStageReceiptLaneShared)
    add(laneKinds, stageReceipt.CompilerStageReceiptLaneShared)
    add(laneKinds, stageReceipt.CompilerStageReceiptLanePrimary)
    add(laneKinds, stageReceipt.CompilerStageReceiptLanePrimary)
    add(laneKinds, stageReceipt.CompilerStageReceiptLaneBackend2)
    add(laneKinds, stageReceipt.CompilerStageReceiptLaneBackend2)
    assert(stageKinds.len == 8 && laneKinds.len == stageKinds.len,
           "compiler stage receipt smoke: stage kind inventory")
    var predecessor = StageReceiptSmokeDigest("stage-receipt-chain-root")
    for index in 0..<stageKinds.len:
        let artifact = StageReceiptSmokeDigest(
            Fmt"stage-receipt-envelope-fixture-{stageKinds[index]}")
        let receipt = StageReceiptSmokeMake(stageKinds[index],
                                             laneKinds[index],
                                             "stage-producer-a",
                                             predecessor,
                                             artifact,
                                             Int64(index + 1))
        let verifyRes = stageReceipt.CompilerStageReceiptVerify(receipt)
        assert(IsOk(verifyRes) && Value(verifyRes),
               "compiler stage receipt smoke: stage kind verify")
        predecessor = receipt.receiptRaw32

fn main(): int32 =
    StageReceiptSmokePositiveAndMutations()
    StageReceiptSmokeStrictRejects()
    StageReceiptSmokeAllKinds()
    os.WriteLine(os.Get_stdout(),
                 "COMPILER_STAGE_RECEIPT_OK parser_prerequisite=1 seven_stage=7")
    return 0
