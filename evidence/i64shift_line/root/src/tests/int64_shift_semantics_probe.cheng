# int64 移位语义对拍探针：确认冷后端下哪些移位构造可靠。
import std/system
import std/result
import std/rawbytes
import std/strutils as strutil
import std/crypto/sha384 as sha384m

fn u64hex(v: int64): str =
    var tmp: Bytes = BytesAlloc(8)
    sha384m.sha384SetU64BE(tmp, 0, uint64(v))
    return BytesToHex(tmp)

fn main(): int32 =
    let v: int64 = sha384m.sha384U64FromBytes(0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01)
    let n: int32 = 8
    let s: int32 = 56
    echo(strutil.Join(["fixed_shl56=", u64hex(v << 56)], ""))
    echo(strutil.Join(["var_shl_s56=", u64hex(v << s)], ""))
    echo(strutil.Join(["var_shl_64minusn=", u64hex(v << (64 - n))], ""))
    echo(strutil.Join(["signed_shr8=", u64hex(v >> n)], ""))
    let u: uint64 = uint64(v)
    let un: uint64 = uint64(n)
    echo(strutil.Join(["uint_shr8=", u64hex(int64(u >> un))], ""))
    echo(strutil.Join(["or_term=", u64hex((v >> n) | (v << (64 - n)))], ""))
    let right: int64 = v >> n
    let left: int64 = v << (64 - n)
    echo(strutil.Join(["split_or=", u64hex(right | left)], ""))
    echo(strutil.Join(["split_xor=", u64hex(right ^ left)], ""))
    let s2: int32 = 64 - n
    let left2: int64 = v << s2
    echo(strutil.Join(["split_s2_or=", u64hex(right | left2)], ""))
    echo(strutil.Join(["right_alone=", u64hex(right)], ""))
    echo(strutil.Join(["left_alone=", u64hex(left)], ""))
    let pos: int64 = int64(1)
    echo(strutil.Join(["pos_shl56=", u64hex(pos << s)], ""))
    echo(strutil.Join(["pos_shl_64minusn=", u64hex(pos << (64 - n))], ""))
    let uv: uint64 = uint64(v)
    let un: uint64 = uint64(n)
    echo(strutil.Join(["u_shr=", u64hex(int64(uv >> un))], ""))
    echo(strutil.Join(["u_shl56=", u64hex(int64(uv << uint64(56)))], ""))
    echo(strutil.Join(["u_shl64minusn=", u64hex(int64(uv << (uint64(64) - un)))], ""))
    echo(strutil.Join(["u_or=", u64hex(int64((uv >> un) | (uv << (uint64(64) - un))))], ""))
    echo(strutil.Join(["u_xor=", u64hex(int64((uv >> un) ^ (uv << (uint64(64) - un))))], ""))
    let hiMask: int64 = (int64(1) << (64 - n)) - 1
    let right: int64 = (v >> n) & hiMask
    echo(strutil.Join(["fix_himask=", u64hex(hiMask)], ""))
    echo(strutil.Join(["fix_right=", u64hex(right)], ""))
    echo(strutil.Join(["fix_xor=", u64hex(right ^ (v << (64 - n)))], ""))
    return 0
