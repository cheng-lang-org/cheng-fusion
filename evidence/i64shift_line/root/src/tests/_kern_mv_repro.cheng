type
    Session =
        sealCount: int32

    Batch =
        session: Session
        staged: int32[]
        active: bool
        reusableIndex: int32

fn closeRound(batch: var Batch) =
    batch.active = false

fn prepare(): Session =
    var s: Session
    s.sealCount = 3
    return s

fn cloneSeq(n: int32): int32[] =
    var o: int32[]
    setLen(o, n)
    return o

fn beginQueries(lookup: var int32, probe: var int32) =
    lookup = 11
    probe = 7

fn build(useFallback: bool): bool =
    var nb = new(Batch)
    nb.session = prepare()
    nb.active = true
    nb.reusableIndex = -1
    var queryLookupCount: int32
    var queryProbeCount: int32
    beginQueries(queryLookupCount, queryProbeCount)
    nb.staged = cloneSeq(queryLookupCount)
    if useFallback:
        closeRound(nb)
        nb.session = prepare()
        return false
    closeRound(nb)
    return true

fn main(): int32 =
    if build(false):
        return 0
    return 1
