import cheng/core/backend/system_link_exec_runtime as runtime

fn main(): int32 =
    assert(!runtime.SystemLinkExecRuntimeGLineFactsValid(-1, 0) &&
           !runtime.SystemLinkExecRuntimeGLineFactsValid(0, -1),
           " system link runtime g-line: invalid facts accepted")
    let providerReady =
        runtime.SystemLinkExecRuntimeGLineState(2, 1, false)
    let objectReady =
        runtime.SystemLinkExecRuntimeGLineState(0, 0, true)
    let bothReady =
        runtime.SystemLinkExecRuntimeGLineState(2, 1, true)
    let emptyBlocked =
        runtime.SystemLinkExecRuntimeGLineState(0, 0, false)
    assert(runtime.SystemLinkExecRuntimeGLineStatusText(providerReady) ==
               "ready" &&
           runtime.SystemLinkExecRuntimeGLineBlockerText(providerReady) == "" &&
           runtime.SystemLinkExecRuntimeGLineStatusText(objectReady) ==
               "ready" &&
           runtime.SystemLinkExecRuntimeGLineBlockerText(objectReady) == "" &&
           runtime.SystemLinkExecRuntimeGLineStatusText(bothReady) ==
               runtime.SystemLinkExecRuntimeGLineStatusText(providerReady) &&
           runtime.SystemLinkExecRuntimeGLineBlockerText(bothReady) ==
               runtime.SystemLinkExecRuntimeGLineBlockerText(objectReady) &&
           runtime.SystemLinkExecRuntimeGLineStatusText(emptyBlocked) ==
               "blocked" &&
           runtime.SystemLinkExecRuntimeGLineBlockerText(emptyBlocked) ==
               "provider_hot_path_not_covered",
           " system link runtime g-line: branch state drift")
    let firstBlockedStatus =
        runtime.SystemLinkExecRuntimeGLineStatusText(emptyBlocked)
    let secondBlockedStatus =
        runtime.SystemLinkExecRuntimeGLineStatusText(emptyBlocked)
    assert(firstBlockedStatus == secondBlockedStatus &&
           firstBlockedStatus == "blocked",
           " system link runtime g-line: second projection consume drift")
    echo("system_link_exec_runtime_gline_ownership_smoke=ok")
    return 0
