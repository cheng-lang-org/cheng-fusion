# Walk smoke (F-a): the standing figure executes six scripted shuffling
# steps along the wall (+x). Assertions: every footstep completes, zero
# rejected physics steps, the pelvis advances at least 0.5 m, the figure
# stays upright (chest above pelvis) and the double run is
# byte-deterministic.
import cheng/game/csg/schema
import cheng/game/csg/validation
import cheng/game/csg/producer
import cheng/game/csg/materializer
import cheng/game/csg/execution
import cheng/game/world3d
import cheng/game/physics3d
import std/strings as strings

const
    WalkTicks = 2400
    WalkSteps = 6

fn QuantAdvMm(v: float64): int64 =
    let mm: int32 = int32(v * 1000.0)
    let wide: int64 = mm
    return wide

# Runs one full walk; returns the execution chain CID, or "" on failure
# (the failure reason is echoed before returning).
fn runWalk(): str =
    var facts: schema.CsgWorldFacts = producer.CsgProducerBuildWalkScene()
    var verdict = validation.CsgValidateFacts(facts)
    if verdict.statusCode != validation.CsgValidOk:
        echo("FAIL walk facts validation")
        echo("status=" + strings.IntToStr(verdict.statusCode))
        echo("detail=" + strings.IntToStr(verdict.detailIndex))
        return ""
    var w: world3d.World3d
    var mp: materializer.CsgMaterializerMapping
    var err: str = ""
    if !materializer.CsgMaterialize(facts, w, mp, err):
        echo("FAIL walk materialize")
        return ""
    var st: execution.CsgExecutionState
    execution.CsgExecutionInit(st, facts, w, mp.partSlot, mp.ropeNodeSlot)
    let pelvisSlot = mp.partSlot[0]
    let chestSlot = mp.partSlot[1]
    let startX = st.w.bodyPx[pelvisSlot]
    var tick: int32 = 0
    while tick < WalkTicks:
        var receipt = execution.CsgExecutionTick(st, facts)
        if receipt.statusCode != physics3d.Physics3dStatusOk:
            echo("FAIL walk step rejected")
            echo("tick=" + strings.Int64ToStr(receipt.tick))
            echo("status=" + strings.IntToStr(receipt.statusCode))
            return ""
        tick = tick + 1
    var doneSteps: int32 = 0
    var s: int32 = 0
    while s < WalkSteps:
        if st.footDone[s] == 2:
            doneSteps = doneSteps + 1
        s = s + 1
    if doneSteps != WalkSteps:
        echo("FAIL footsteps completed")
        echo("done=" + strings.IntToStr(doneSteps))
        return ""
    let advX = st.w.bodyPx[pelvisSlot] - startX
    let mm: int64 = QuantAdvMm(advX)
    if advX < 0.5:
        echo("FAIL pelvis advance")
        echo("mm=" + strings.Int64ToStr(mm))
        return ""
    if st.w.bodyPz[chestSlot] < st.w.bodyPz[pelvisSlot]:
        echo("FAIL upright chest below pelvis")
        return ""
    if st.rejectedCount != 0:
        echo("FAIL rejections")
        echo("n=" + strings.IntToStr(st.rejectedCount))
        return ""
    echo("walk ok advance_mm=" + strings.Int64ToStr(mm))
    return Fmt"{st.chainCid}"

fn main(): int32 =
    let chainA = runWalk()
    if chainA == "":
        return 1
    let chainB = runWalk()
    if chainB == "":
        return 1
    if chainA != chainB:
        echo("FAIL walk double-run chain diverged")
        return 1
    echo("PASS csg_world_walk_smoke")
    return 0
