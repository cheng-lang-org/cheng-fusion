import std/atomic
import std/thread

const
    handleSlotMod: uint64 = 4294967296
    raceIterations: int32 = 64

@importc("cheng_ffi_raw_new_i32")
fn cheng_ffi_raw_new_i32(value: int32): ptr

@importc("cheng_host_pipe_runtime")
fn cheng_host_pipe_runtime(fds: ptr): int32

@importc("cheng_host_read_runtime")
fn cheng_host_read_runtime(fd: int32, data: ptr, count: int32): int64

@importc("cheng_host_write_runtime")
fn cheng_host_write_runtime(fd: int32, data: ptr, count: int32): int64

@importc("cheng_host_close")
fn cheng_host_close(fd: int32): int32

@importc("cheng_ffi_raw_release_i32")
fn cheng_ffi_raw_release_i32(p: ptr): int32

@importc("cheng_tcp_buffer_handle_register_bridge")
fn cheng_tcp_buffer_handle_register_bridge(raw: ptr): uint64

@importc("cheng_tcp_buffer_handle_lease_acquire_bridge")
fn cheng_tcp_buffer_handle_lease_acquire_bridge(
    handle: uint64,
    outPayload: ptr,
    outBorrowGeneration: ptr): int32

@importc("cheng_tcp_buffer_handle_lease_release_bridge")
fn cheng_tcp_buffer_handle_lease_release_bridge(
    handle: uint64,
    borrowGeneration: uint64): int32

@importc("cheng_tcp_buffer_handle_retire_take_bridge")
fn cheng_tcp_buffer_handle_retire_take_bridge(
    handle: uint64,
    outPayload: ptr): int32

type
    AcquireCtx = ref object
        handle: uint64
        readyWriteFd: int32
        startReadFd: int32
        rc: atomic.I32
        payload: ptr
        borrowGeneration: uint64

    RetireCtx = ref object
        handle: uint64
        readyWriteFd: int32
        startReadFd: int32
        rc: atomic.I32
        payload: ptr

fn handleSlot(handle: uint64): uint64 =
    return handle % handleSlotMod

fn handleGeneration(handle: uint64): uint64 =
    return handle / handleSlotMod

fn raceGateWrite(fd: int32) =
    var token: uint8 = uint8(1)
    assert(cheng_host_write_runtime(fd, &token, 1) == int64(1),
           " ffi handle race: event write")

fn raceGateRead(fd: int32) =
    var token: uint8
    assert(cheng_host_read_runtime(fd, &token, 1) == int64(1) &&
           token == uint8(1),
           " ffi handle race: event read")

fn raceGateArriveAndWait(readyWriteFd: int32, startReadFd: int32) =
    raceGateWrite(readyWriteFd)
    raceGateRead(startReadFd)

fn AcquireWorker(raw: ptr) =
    let ctx: AcquireCtx = AcquireCtx(raw)
    raceGateArriveAndWait(ctx.readyWriteFd, ctx.startReadFd)
    var payload: ptr
    var borrowGeneration: uint64
    let rc = cheng_tcp_buffer_handle_lease_acquire_bridge(
        ctx.handle, &payload, &borrowGeneration)
    ctx.payload = payload
    ctx.borrowGeneration = borrowGeneration
    atomic.StoreI32(ctx.rc, rc)

fn RetireWorker(raw: ptr) =
    let ctx: RetireCtx = RetireCtx(raw)
    raceGateArriveAndWait(ctx.readyWriteFd, ctx.startReadFd)
    var payload: ptr
    let rc = cheng_tcp_buffer_handle_retire_take_bridge(
        ctx.handle, &payload)
    ctx.payload = payload
    atomic.StoreI32(ctx.rc, rc)

fn main(): int32 =
    var previousHandle: uint64
    var previousToken: uint64
    var previousSlot: uint64
    var previousGeneration: uint64

    for iteration in 0..<raceIterations:
        let raw = cheng_ffi_raw_new_i32(iteration)
        assert(raw != nil, " ffi handle race: payload allocation")
        let handle = cheng_tcp_buffer_handle_register_bridge(raw)
        assert(handle != uint64(0), " ffi handle race: registration")

        var warmPayload: ptr
        var warmToken: uint64
        assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
                   handle, &warmPayload, &warmToken) == 0,
               " ffi handle race: warm acquire")
        assert(warmPayload == raw && warmToken != uint64(0),
               " ffi handle race: warm capability")
        if iteration > 0:
            assert(handleSlot(handle) == previousSlot,
                   " ffi handle race: slot reused")
            assert(handleGeneration(handle) == previousGeneration + uint64(1),
                   " ffi handle race: handle generation advanced")
            assert(warmToken > previousToken,
                   " ffi handle race: borrow token advanced")
            assert(cheng_tcp_buffer_handle_lease_release_bridge(
                       handle, previousToken) == -1,
                   " ffi handle race: stale token rejected after reuse")
            var stalePayload: ptr
            var staleToken: uint64
            assert(cheng_tcp_buffer_handle_lease_acquire_bridge(
                       previousHandle, &stalePayload, &staleToken) == -1,
                   " ffi handle race: stale handle rejected after reuse")
            assert(stalePayload == nil && staleToken == uint64(0),
                   " ffi handle race: stale acquire has no capability")
        assert(cheng_tcp_buffer_handle_lease_release_bridge(
                   handle, warmToken) == 0,
               " ffi handle race: warm release")

        let acquireRc = atomic.NewI32(-99)
        let retireRc = atomic.NewI32(-99)
        assert(acquireRc != nil && retireRc != nil,
               " ffi handle race: result cells")
        let acquireCtx = new(AcquireCtx)
        let retireCtx = new(RetireCtx)
        assert(acquireCtx != nil && retireCtx != nil,
               " ffi handle race: worker contexts")
        acquireCtx.handle = handle
        acquireCtx.rc = acquireRc
        retireCtx.handle = handle
        retireCtx.rc = retireRc

        var readyPipe: int32[2]
        var startPipe: int32[2]
        assert(cheng_host_pipe_runtime(&readyPipe[0]) == 0 &&
               cheng_host_pipe_runtime(&startPipe[0]) == 0,
               " ffi handle race: event pipes")
        acquireCtx.readyWriteFd = readyPipe[1]
        acquireCtx.startReadFd = startPipe[0]
        retireCtx.readyWriteFd = readyPipe[1]
        retireCtx.startReadFd = startPipe[0]

        var acquireThread: thread.Thread
        var retireThread: thread.Thread
        if (iteration & 1) == 0:
            acquireThread = thread.StartPtr(&AcquireWorker, &acquireCtx.handle)
            retireThread = thread.StartPtr(&RetireWorker, &retireCtx.handle)
        else:
            retireThread = thread.StartPtr(&RetireWorker, &retireCtx.handle)
            acquireThread = thread.StartPtr(&AcquireWorker, &acquireCtx.handle)
        raceGateRead(readyPipe[0])
        raceGateRead(readyPipe[0])
        raceGateWrite(startPipe[1])
        raceGateWrite(startPipe[1])
        assert(thread.JoinThread(acquireThread),
               " ffi handle race: acquire worker joined")
        assert(thread.JoinThread(retireThread),
               " ffi handle race: retire worker joined")
        assert(cheng_host_close(readyPipe[0]) == 0 &&
               cheng_host_close(readyPipe[1]) == 0 &&
               cheng_host_close(startPipe[0]) == 0 &&
               cheng_host_close(startPipe[1]) == 0,
               " ffi handle race: event pipes closed")

        let acquireResult = atomic.LoadI32(acquireRc)
        let retireResult = atomic.LoadI32(retireRc)
        let acquireWon = acquireResult == 0 && retireResult == -2
        let retireWon = acquireResult == -1 && retireResult == 0
        assert(acquireWon || retireWon,
               " ffi handle race: exactly one legal interleaving")

        var lastToken = warmToken
        if acquireWon:
            assert(acquireCtx.payload == raw &&
                   acquireCtx.borrowGeneration > warmToken,
                   " ffi handle race: acquire winner capability")
            assert(retireCtx.payload == nil,
                   " ffi handle race: busy retire has no payload")
            assert(cheng_tcp_buffer_handle_lease_release_bridge(
                       handle, acquireCtx.borrowGeneration) == 0,
                   " ffi handle race: release winner capability")
            var retiredAfterRelease: ptr
            assert(cheng_tcp_buffer_handle_retire_take_bridge(
                       handle, &retiredAfterRelease) == 0,
                   " ffi handle race: retire after release")
            assert(retiredAfterRelease == raw,
                   " ffi handle race: retire after release payload")
            assert(cheng_ffi_raw_release_i32(retiredAfterRelease) == 0,
                   " ffi handle race: acquire winner payload release")
            lastToken = acquireCtx.borrowGeneration
        else:
            assert(acquireCtx.payload == nil &&
                   acquireCtx.borrowGeneration == uint64(0),
                   " ffi handle race: stale acquire has no payload")
            assert(retireCtx.payload == raw,
                   " ffi handle race: retire winner payload")
            assert(cheng_ffi_raw_release_i32(retireCtx.payload) == 0,
                   " ffi handle race: retire winner payload release")

        previousHandle = handle
        previousToken = lastToken
        previousSlot = handleSlot(handle)
        previousGeneration = handleGeneration(handle)

    echo(" ffi_handle_acquire_retire_race_smoke ok")
    return 0
