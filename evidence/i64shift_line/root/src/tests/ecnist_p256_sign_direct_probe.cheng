import std/system
import std/result
import std/strutils as strutil
import std/crypto/bigint
import std/crypto/ecnist
import std/crypto/p256_fixed as pfix

fn fixedPrivateScalarOne(): Bytes =
    let out: Bytes = BytesAlloc(32)
    BytesSet(out, 31, 1)
    return out

fn main(): int32 =
    echo("ecnist p256 sign direct: start")
    let priv: Bytes = fixedPrivateScalarOne()
    var d: bigint.BigInt
    let parseRes: Result[bool] = ecnist.ecdsaParsePrivateScalarBytes(priv, d)
    if IsErr(parseRes):
        echo(strutil.Join(["ecnist p256 sign direct: parse err=", Error(parseRes)], ""))
        return 1
    echo("ecnist p256 sign direct: parse ok")
    let two: bigint.BigInt = bigint.bigFromInt(2)
    let pConst: bigint.BigInt = ecnist.p256ConstP()
    echo("ecnist p256 sign direct: p const ok")
    let nConst: bigint.BigInt = ecnist.p256ConstN()
    echo("ecnist p256 sign direct: n const ok")
    let pMinus2Res: Result[bigint.BigInt] = bigint.bigSub(pConst, two)
    if IsErr(pMinus2Res):
        echo(strutil.Join(["ecnist p256 sign direct: p minus2 err=", Error(pMinus2Res)], ""))
        return 1
    echo("ecnist p256 sign direct: p minus2 ok")
    var pMinus2Big: bigint.BigInt = Value(pMinus2Res)
    let pMinus2FixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(pMinus2Big)
    if IsErr(pMinus2FixedRes):
        echo(strutil.Join(["ecnist p256 sign direct: p minus2 fixed err=", Error(pMinus2FixedRes)], ""))
        return 1
    echo("ecnist p256 sign direct: p minus2 fixed ok")
    let nMinus2Res: Result[bigint.BigInt] = bigint.bigSub(nConst, two)
    if IsErr(nMinus2Res):
        echo(strutil.Join(["ecnist p256 sign direct: n minus2 err=", Error(nMinus2Res)], ""))
        return 1
    echo("ecnist p256 sign direct: n minus2 ok")
    var nMinus2Big: bigint.BigInt = Value(nMinus2Res)
    let nMinus2FixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(nMinus2Big)
    if IsErr(nMinus2FixedRes):
        echo(strutil.Join(["ecnist p256 sign direct: n minus2 fixed err=", Error(nMinus2FixedRes)], ""))
        return 1
    echo("ecnist p256 sign direct: n minus2 fixed ok")
    var bBig: bigint.BigInt = ecnist.p256ConstB()
    let bFixedRes: Result[pfix.P256Fixed] = pfix.p256FixedFromBigInt(bBig)
    if IsErr(bFixedRes):
        echo(strutil.Join(["ecnist p256 sign direct: b fixed err=", Error(bFixedRes)], ""))
        return 1
    echo("ecnist p256 sign direct: b fixed ok")
    let bMontRes: Result[pfix.P256Fixed] = ecnist.p256FieldFixedToMont(Value(bFixedRes))
    if IsErr(bMontRes):
        echo(strutil.Join(["ecnist p256 sign direct: b mont err=", Error(bMontRes)], ""))
        return 1
    echo("ecnist p256 sign direct: b mont ok")
    let fixedInitRes: Result[bool] = ecnist.p256EnsureFixedInit()
    if IsErr(fixedInitRes):
        echo(strutil.Join(["ecnist p256 sign direct: fixed init err=", Error(fixedInitRes)], ""))
        return 1
    echo("ecnist p256 sign direct: fixed init ok")
    let pointRes: Result[ecnist.EcPointFixed] = ecnist.pointMulGeneratorFixed(d)
    if IsErr(pointRes):
        echo(strutil.Join(["ecnist p256 sign direct: point err=", Error(pointRes)], ""))
        return 1
    echo("ecnist p256 sign direct: pub ok")
    let pubBytes: Bytes = ecnist.ecdsaPublicPointFixedToBytes(Value(pointRes))
    let msg: Bytes = BytesFromString("cheng tls13 ecdsa certificate verify direct probe")
    var gy: bigint.BigInt
    ecnist.p256ConstGyInto(gy)
    if bigint.bigIsZero(gy):
        echo("ecnist p256 sign direct: gy zero")
        return 1
    echo("ecnist p256 sign direct: gy ok")
    let gy2Res: Result[bigint.BigInt] = ecnist.p256ModAdd(gy, gy)
    if IsErr(gy2Res):
        echo(strutil.Join(["ecnist p256 sign direct: gy2 err=", Error(gy2Res)], ""))
        return 1
    if bigint.bigIsZero(Value(gy2Res)):
        echo("ecnist p256 sign direct: gy2 zero")
        return 1
    echo("ecnist p256 sign direct: gy2 ok")
    var gx: bigint.BigInt
    ecnist.p256ConstGxInto(gx)
    let oneJac: bigint.BigInt = bigint.bigFromInt(1)
    let oneModRes: Result[bigint.BigInt] = ecnist.p256Mod(oneJac)
    if IsErr(oneModRes):
        echo(strutil.Join(["ecnist p256 sign direct: one mod err=", Error(oneModRes)], ""))
        return 1
    if bigint.bigIsZero(Value(oneModRes)):
        echo("ecnist p256 sign direct: one mod zero")
        return 1
    echo("ecnist p256 sign direct: one mod ok")
    let oneInvRes: Result[bigint.BigInt] = ecnist.p256ModInv(oneJac)
    if IsErr(oneInvRes):
        echo(strutil.Join(["ecnist p256 sign direct: one inv err=", Error(oneInvRes)], ""))
        return 1
    if bigint.bigIsZero(Value(oneInvRes)):
        echo("ecnist p256 sign direct: one inv zero")
        return 1
    echo("ecnist p256 sign direct: one inv ok")
    let oneBig: bigint.BigInt = bigint.bigFromInt(1)
    let rOneRes: Result[bigint.BigInt] = ecnist.pointMulGeneratorR(oneBig)
    if IsErr(rOneRes):
        echo(strutil.Join(["ecnist p256 sign direct: r one err=", Error(rOneRes)], ""))
        return 1
    echo("ecnist p256 sign direct: r one ok")
    var base: ecnist.EcPoint
    ecnist.pointSetCoordsInto(base, gx, gy)
    let dblRes: Result[ecnist.EcPoint] = ecnist.pointDouble(base)
    if IsErr(dblRes):
        echo(strutil.Join(["ecnist p256 sign direct: double g err=", Error(dblRes)], ""))
    else:
        echo("ecnist p256 sign direct: double g ok")
    let twoBig: bigint.BigInt = bigint.bigFromInt(2)
    let rTwoRes: Result[bigint.BigInt] = ecnist.pointMulGeneratorR(twoBig)
    if IsErr(rTwoRes):
        echo(strutil.Join(["ecnist p256 sign direct: r two err=", Error(rTwoRes)], ""))
        return 1
    echo("ecnist p256 sign direct: r two ok")
    let threeBig: bigint.BigInt = bigint.bigFromInt(3)
    let rThreeRes: Result[bigint.BigInt] = ecnist.pointMulGeneratorR(threeBig)
    if IsErr(rThreeRes):
        echo(strutil.Join(["ecnist p256 sign direct: r three err=", Error(rThreeRes)], ""))
        return 1
    echo("ecnist p256 sign direct: r three ok")
    let fourBig: bigint.BigInt = bigint.bigFromInt(4)
    let rFourRes: Result[bigint.BigInt] = ecnist.pointMulGeneratorR(fourBig)
    if IsErr(rFourRes):
        echo(strutil.Join(["ecnist p256 sign direct: r four err=", Error(rFourRes)], ""))
        return 1
    echo("ecnist p256 sign direct: r four ok")
    let sevenBig: bigint.BigInt = bigint.bigFromInt(7)
    let rSevenRes: Result[bigint.BigInt] = ecnist.pointMulGeneratorR(sevenBig)
    if IsErr(rSevenRes):
        echo(strutil.Join(["ecnist p256 sign direct: r seven err=", Error(rSevenRes)], ""))
        return 1
    echo("ecnist p256 sign direct: r seven ok")
    let sixteenBig: bigint.BigInt = bigint.bigFromInt(16)
    let rSixteenRes: Result[bigint.BigInt] = ecnist.pointMulGeneratorR(sixteenBig)
    if IsErr(rSixteenRes):
        echo(strutil.Join(["ecnist p256 sign direct: r sixteen err=", Error(rSixteenRes)], ""))
        return 1
    echo("ecnist p256 sign direct: r sixteen ok")
    let smallWideBig: bigint.BigInt = bigint.bigFromInt(255)
    let rSmallWideRes: Result[bigint.BigInt] = ecnist.pointMulGeneratorR(smallWideBig)
    if IsErr(rSmallWideRes):
        echo(strutil.Join(["ecnist p256 sign direct: r 255 err=", Error(rSmallWideRes)], ""))
        return 1
    echo("ecnist p256 sign direct: r 255 ok")
    let kRes: Result[bigint.BigInt] = ecnist.p256DeterministicK(d, msg)
    if IsErr(kRes):
        echo(strutil.Join(["ecnist p256 sign direct: k err=", Error(kRes)], ""))
        return 1
    echo("ecnist p256 sign direct: k ok")
    let rRes: Result[bigint.BigInt] = ecnist.pointMulGeneratorR(Value(kRes))
    if IsErr(rRes):
        echo(strutil.Join(["ecnist p256 sign direct: r err=", Error(rRes)], ""))
        return 1
    echo("ecnist p256 sign direct: r ok")
    let kInvRes: Result[bigint.BigInt] = ecnist.nModInv(Value(kRes))
    if IsErr(kInvRes):
        echo(strutil.Join(["ecnist p256 sign direct: kinv err=", Error(kInvRes)], ""))
        return 1
    echo("ecnist p256 sign direct: kinv ok")
    let sigRes: Result[Bytes] = ecnist.ecdsaSignBytes(priv, msg)
    if IsErr(sigRes):
        echo(strutil.Join(["ecnist p256 sign direct: sign err=", Error(sigRes)], ""))
        return 1
    echo("ecnist p256 sign direct: sign ok")
    if BytesLen(pubBytes) != 65:
        echo("ecnist p256 sign direct: pub length failed")
        return 1
    echo("ecnist_p256_sign_direct_probe ok")
    return 0
