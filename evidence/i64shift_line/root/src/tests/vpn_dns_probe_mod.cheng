import std/seqs
import std/strutils as strutil

fn modAppendStr(seqInst: var str[], val: str) =
    seqs.Add(seqInst, val)

fn ModAddViaWrapper(): int32 =
    var out: str[]
    modAppendStr(out, "abc")
    modAppendStr(out, "def")
    return out.len

fn ModAddLit(): int32 =
    var out: str[]
    seqs.Add(out, "abc")
    return out.len

fn ModSplitWsLen(s: str): int32 =
    let fields: str[] = strutil.SplitWhitespace(s)
    return fields.len
