import std/strings
import std/result

type PA =
    host: str
    port: int32
    isV6: bool

@borrows
fn seg3(text: str, start: int32, c0: int32, c1: int32, c2: int32): bool =
    return false

@borrows
fn segLen(text: str, start: int32): int32 =
    return 2

@borrows
fn parsePort(text: str): result.Result[int32] =
    return result.Ok[int32](3)

@borrows
fn parse(text: str): result.Result[PA] =
    var offset: int32 = 1
    var isV6: bool
    if seg3(text, offset, 1, 2, 3):
        isV6 = false
    elif seg3(text, offset, 4, 5, 6):
        isV6 = true
    else:
        return result.Err[PA]("bad")
    offset = offset + 4
    let hostLen: int32 = segLen(text, offset)
    if hostLen <= 0:
        return result.Err[PA]("bad")
    let host: str = strings.CloneStrRange(text, offset, hostLen)
    offset = offset + hostLen + 1
    if !seg3(text, offset, 7, 8, 9):
        return result.Err[PA]("bad")
    return result.Ok[PA](PA(host: host, port: 3, isV6: isV6))

fn main(): int32 =
    let r = parse("abc")
    return 0
