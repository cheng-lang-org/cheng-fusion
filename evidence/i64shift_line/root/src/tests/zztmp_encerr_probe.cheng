import std/os as os
import std/strings
import cheng/core/csg_core/merkle_dag as merkle_dag

fn show(line: str): int32 =
    var err: str
    let canon = merkle_dag.CsgCoreMerkleCanonicalFact(line, err)
    if err.len > 0:
        os.WriteLine(os.Get_stdout(), strings.ConcatStr("ERR=", err))
        return 1
    if canon != line:
        os.WriteLine(os.Get_stdout(), strings.ConcatStr("DIFF in=", line))
        os.WriteLine(os.Get_stdout(), strings.ConcatStr("    canon=", canon))
        return 1
    os.WriteLine(os.Get_stdout(), "same")
    return 0

fn main(): int32 =
    var rc = 0
    rc = rc + show("{\"id\":\"a\",\"kind\":\"csg.symbol\",\"name\":\"A\"}")
    rc = rc + show("{\"id\":\"b\",\"kind\":\"csg.symbol\",\"name\":\"B\",\"rank\":2}")
    rc = rc + show("{\"id\":\"c\",\"kind\":\"csg.module\",\"name\":\"C\",\"members\":[\"a\",\"b\"]}")
    return rc
