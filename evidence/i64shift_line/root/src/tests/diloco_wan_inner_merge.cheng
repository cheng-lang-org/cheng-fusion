# D8 compute slice without SHA-NI / QUIC / artifact CID.
# Inner SGD and token-weighted merge only; blobs are packed i32 files.

import std/result
import std/os
import std/cmdline as cmdline
import std/times as times
import std/rawbytes as rawbytes
import std/strings as strings
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner
import cheng/DiLoCo/train/outer_merge as outer

const
    SmokeIn: int32 = 4
    SmokeOut: int32 = 2
    SmokeInnerSteps: int32 = 4
    SmokeLrNum: int32 = 1
    SmokeLrDen: int32 = 2
    SmokeSamples: int32 = 3

fn die(msg: str): int32 =
    echo(msg)
    return 1

fn fillShardA(xs: var int32[], ys: var int32[]) =
    xs = []
    ys = []
    for s in 0..<SmokeSamples:
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(xs, 0)
        add(ys, 1000)
        add(ys, 0)

fn fillShardB(xs: var int32[], ys: var int32[]) =
    xs = []
    ys = []
    for s in 0..<SmokeSamples:
        add(xs, 0)
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(ys, 0)
        add(ys, 1000)

fn writePacked(path: str, values: int32[]): Result[bool] =
    var packed = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(packed, values)
    if IsErr(packRes):
        return Err[bool](Error(packRes))
    let wr = os.WriteFileBytesResult(path, packed)
    if IsErr(wr):
        return Err[bool](Error(wr))
    return Ok[bool](true)

fn readPacked(path: str): Result[int32[]] =
    if !os.FileExists(path):
        return Err[int32[]]("diloco_wan_inner_merge: missing pack")
    var readRes: Result[rawbytes.Bytes] = os.ReadFileBytesResult(path)
    if IsErr(readRes):
        return Err[int32[]]("diloco_wan_inner_merge: read pack")
    var values: int32[]
    let unpackRes = codec.DiLoCoTrainUnpackI32Fill(values, Value(readRes))
    if IsErr(unpackRes):
        return Err[int32[]](Error(unpackRes))
    return Ok[int32[]](values)

fn runInner(shard: str, outPath: str): int32 =
    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, SmokeOut, SmokeIn)
    if IsErr(zeroRes):
        return die(Error(zeroRes))
    var xs: int32[]
    var ys: int32[]
    if shard == "A":
        fillShardA(xs, ys)
    elif shard == "B":
        fillShardB(xs, ys)
    else:
        return die("diloco_wan_inner_merge: shard")
    var w: int32[]
    var d: int32[]
    let t0 = times.MonotimeMs()
    let innerRes = inner.DiLoCoInnerSgdLinearFill(w, d, zeros, xs, ys, SmokeSamples, SmokeInnerSteps,
                                                   SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    let innerMs = times.MonotimeMs() - t0
    if IsErr(innerRes):
        return die(Error(innerRes))
    let wr = writePacked(outPath, d)
    if IsErr(wr):
        return die(Error(wr))
    echo(strings.ConcatStr("diloco_wan_inner inner_ms=", strings.IntToStr(int32(innerMs))))
    echo("diloco_wan_inner ok")
    return 0

fn runMerge(deltaAPath: str, deltaBPath: str, mergedPath: str, replayPath: str): int32 =
    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, SmokeOut, SmokeIn)
    if IsErr(zeroRes):
        return die(Error(zeroRes))
    let dARes = readPacked(deltaAPath)
    if IsErr(dARes):
        return die(Error(dARes))
    let dBRes = readPacked(deltaBPath)
    if IsErr(dBRes):
        return die(Error(dBRes))
    let dA = Value(dARes)
    let dB = Value(dBRes)
    if dA.len != dB.len || dA.len != zeros.len:
        return die("diloco_wan_inner_merge: rank")
    var flat: int32[]
    for p in 0..<dA.len:
        add(flat, dA[p])
    for p in 0..<dB.len:
        add(flat, dB[p])
    var tokenCounts: int32[]
    let tokens: int32 = SmokeSamples * SmokeInnerSteps
    add(tokenCounts, tokens)
    add(tokenCounts, tokens)
    let t0 = times.MonotimeMs()
    var merged: int32[]
    let mergeRes = outer.DiLoCoOuterWeightedDeltaFill(merged, zeros, flat, tokenCounts, 2)
    let outerMs = times.MonotimeMs() - t0
    if IsErr(mergeRes):
        return die(Error(mergeRes))
    var replayed: int32[]
    let replayRes = outer.DiLoCoOuterWeightedDeltaFill(replayed, zeros, flat, tokenCounts, 2)
    if IsErr(replayRes):
        return die(Error(replayRes))
    if replayed.len != merged.len:
        return die("diloco_wan_inner_merge: replay len")
    for p in 0..<merged.len:
        if replayed[p] != merged[p]:
            return die("diloco_wan_inner_merge: replay mismatch")
    let wr = writePacked(mergedPath, merged)
    if IsErr(wr):
        return die(Error(wr))
    let wr2 = writePacked(replayPath, replayed)
    if IsErr(wr2):
        return die(Error(wr2))
    echo(strings.ConcatStr("diloco_wan_merge outer_ms=", strings.IntToStr(int32(outerMs))))
    echo("diloco_wan_merge ok")
    return 0

fn main(): int32 =
    var role: str
    if !cmdline.ReadFirstFlagValue("--role", role):
        return die("diloco_wan_inner_merge: --role missing")
    if role == "inner-a":
        var outPath: str
        if !cmdline.ReadFirstFlagValue("--out", outPath):
            return die("diloco_wan_inner_merge: --out missing")
        return runInner("A", outPath)
    if role == "inner-b":
        var outPath: str
        if !cmdline.ReadFirstFlagValue("--out", outPath):
            return die("diloco_wan_inner_merge: --out missing")
        return runInner("B", outPath)
    if role == "merge":
        var deltaA: str
        var deltaB: str
        var merged: str
        var replay: str
        if !cmdline.ReadFirstFlagValue("--delta-a", deltaA):
            return die("diloco_wan_inner_merge: --delta-a missing")
        if !cmdline.ReadFirstFlagValue("--delta-b", deltaB):
            return die("diloco_wan_inner_merge: --delta-b missing")
        if !cmdline.ReadFirstFlagValue("--merged", merged):
            return die("diloco_wan_inner_merge: --merged missing")
        if !cmdline.ReadFirstFlagValue("--replay", replay):
            return die("diloco_wan_inner_merge: --replay missing")
        return runMerge(deltaA, deltaB, merged, replay)
    return die("diloco_wan_inner_merge: unknown role")
