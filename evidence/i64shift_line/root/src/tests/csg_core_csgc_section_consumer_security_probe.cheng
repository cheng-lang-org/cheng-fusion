import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc

@borrows
fn cloneBytes(bytes: rawbytes.Bytes): rawbytes.Bytes =
    var copy = rawbytes.BytesAlloc(rawbytes.BytesLen(bytes))
    rawbytes.BytesCopyInto(copy, 0, bytes)
    return copy

fn red(name: str): int32 =
    os.WriteLine(
        os.Get_stderr(),
        strings.ConcatStr(
            strings.ConcatStr(
                "csgc_section_consumer_red[", name),
            "]"))
    return 1

fn main(): int32 =
    let callFact =
        "{\"id\":\"call-1\",\"kind\":\"csg.call\",\"name\":\"target\"}"
    let symbolFact =
        "{\"id\":\"sym-1\",\"kind\":\"csg.symbol\",\"name\":\"sibling\"}"
    let encoded = csgc.CsgCoreCsgcEncodeCanonicalLines(
        [symbolFact, callFact])
    if !encoded.ok || encoded.headerSize != 64 ||
       encoded.flags != 0:
        return red("versionless_header")
    let directory =
        csgc.CsgCoreCsgcParseSectionDirectory(encoded.bytes)
    if !directory.ok || directory.sectionTags.len != 3:
        return red("section_directory")

    let rawAbsent = csgc.CsgCoreCsgcDecodeFactKindClaimed(
        encoded.bytes, "csg.type")
    if !rawAbsent.ok || rawAbsent.found ||
       rawAbsent.claimedDirectoryCid !=
           encoded.claimedDirectoryCid:
        return red("claimed_missing_kind")

    # Claimed absence intentionally skips unrelated payloads. Only the
    # authority module may promote this local result into production evidence.
    var corruptDictionary = cloneBytes(encoded.bytes)
    let dictionaryByte =
        64 + directory.sectionOffsets[0] + 4
    rawbytes.BytesSet(
        corruptDictionary,
        dictionaryByte,
        (rawbytes.BytesGet(corruptDictionary, dictionaryByte) ^ 1) & 255)
    let absent = csgc.CsgCoreCsgcDecodeFactKindClaimed(
        corruptDictionary, "csg.type")
    if !absent.ok || absent.found:
        return red("claimed_absence_touched_payload")

    # A claimed target decode may ignore siblings. Its result remains local and
    # cannot cross the production boundary without a typed authority.
    var corruptSibling = cloneBytes(encoded.bytes)
    let siblingByte = 64 + directory.sectionOffsets[2] + 4
    rawbytes.BytesSet(
        corruptSibling,
        siblingByte,
        (rawbytes.BytesGet(corruptSibling, siblingByte) ^ 1) & 255)
    let target = csgc.CsgCoreCsgcDecodeFactKindClaimed(
        corruptSibling, "csg.call")
    if !target.ok || !target.found || target.lines.len != 1:
        return red("claimed_target_touched_sibling")

    # Directory iteration exposes only a claim; changing directory bytes does
    # not create a typed authority. The first digest starts at byte 86.
    var forgedDirectory = cloneBytes(encoded.bytes)
    rawbytes.BytesSet(
        forgedDirectory,
        86,
        (rawbytes.BytesGet(forgedDirectory, 86) ^ 1) & 255)
    let forged =
        csgc.CsgCoreCsgcParseSectionDirectory(forgedDirectory)
    if !forged.ok:
        return red("claimed_directory_parse")
    var iterator = csgc.CsgCoreCsgcSectionIteratorInit()
    let view = csgc.CsgCoreCsgcSectionIteratorNext(
        forged, iterator)
    if !view.ok || view.claimedCid.len != 71:
        return red("claimed_iterator")

    os.WriteLine(
        os.Get_stdout(),
        "csg_core_csgc_section_consumer_security_probe ok")
    return 0
