import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import cheng/core/backend/regalloc_x86_64_adapter as x8664adapter

fn cfgBodyNew(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "8888888888888888888888888888888888888888888888888888888888888888")
    assert(parsed.ok, " x86 cfg: TypeArena CID invalid")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " x86 cfg: TypeArena CID bind failed")
    return body

fn cfgI32Slot(id: int32, paramOrdinal: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "v"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + id * 8
    if paramOrdinal >= 0:
        slot.stackOffset = -1 - paramOrdinal
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn cfgConst(body: var ir.BodyIR, target: int32, value: int32) =
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpLoadConstTag
    op.target = target
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, value)
    add(body.ops, op)

fn cfgCmp(body: var ir.BodyIR,
          target: int32,
          lhs: int32,
          rhs: int32) =
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCmpTag
    op.target = target
    add(op.operands, ir.BodyCondI32EqTag)
    add(op.operands, lhs)
    add(op.operands, rhs)
    add(body.ops, op)

fn cfgBr(body: var ir.BodyIR, target: int32): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermBrTag
    term.trueBlock = target
    return ir.BodyIRAppendTerm(body, term)

fn cfgCbr(body: var ir.BodyIR,
          conditionSlot: int32,
          trueBlock: int32,
          falseBlock: int32): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermCbrTag
    term.conditionKind = ir.BodyCondLocalNonZeroTag
    term.resultSlot = conditionSlot
    term.lhsSlot = conditionSlot
    term.rhsSlot = -1
    term.trueBlock = trueBlock
    term.falseBlock = falseBlock
    return ir.BodyIRAppendTerm(body, term)

fn cfgReturn(body: var ir.BodyIR, slotIndex: int32): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    return ir.BodyIRAppendTerm(body, term)

fn cfgLoopBody(): ir.BodyIR =
    var body = cfgBodyNew()
    add(body.localSlots, cfgI32Slot(0, 0))
    let entryTerm = cfgBr(body, 1)
    let loopTerm = cfgCbr(body, 0, 1, 2)
    let returnTerm = cfgReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, loopTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, returnTerm)
    return body

fn cfgCriticalDiamondBody(): ir.BodyIR =
    var body = cfgBodyNew()
    add(body.localSlots, cfgI32Slot(0, 0))
    add(body.localSlots, cfgI32Slot(1, 1))
    let entryTerm = cfgCbr(body, 0, 2, 1)
    let sideTerm = cfgBr(body, 2)
    let joinTerm = cfgReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, sideTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, joinTerm)
    return body

fn cfgParallelCycleBody(): ir.BodyIR =
    var body = cfgBodyNew()
    add(body.localSlots, cfgI32Slot(0, -1))
    add(body.localSlots, cfgI32Slot(1, -1))
    add(body.localSlots, cfgI32Slot(2, 0))
    add(body.localSlots, cfgI32Slot(3, -1))
    cfgConst(body, 1, 1)
    cfgConst(body, 0, 2)
    cfgConst(body, 0, 3)
    cfgConst(body, 1, 4)
    cfgCmp(body, 3, 0, 1)
    let entryTerm = cfgCbr(body, 2, 1, 2)
    let changedTerm = cfgBr(body, 3)
    let unchangedTerm = cfgBr(body, 3)
    let joinTerm = cfgReturn(body, 3)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, changedTerm)
    let _ = ir.BodyIRAppendBlock(body, 2, 2, unchangedTerm)
    let _ = ir.BodyIRAppendBlock(body, 4, 1, joinTerm)
    return body

fn cfgEmit(body: var ir.BodyIR, symbol: str):
        emitter.RegallocProductionFunctionEmission =
    var noTargets: str[]
    return emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetX64Linux,
        body, symbol, 0, noTargets, noTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)

fn cfgLedgerValid(
        emission: var emitter.RegallocProductionFunctionEmission): bool =
    var metadata: artifacts.RegallocProductionLedgerMetadata
    metadata.fixtureSourceSha256 =
        "1111111111111111111111111111111111111111111111111111111111111111"
    metadata.outputObjectSha256 =
        "2222222222222222222222222222222222222222222222222222222222222222"
    metadata.target =
        artifacts.RegallocProductionTargetX64Linux
    var row: artifacts.RegallocProductionLedgerFunction
    row.plan = emission.plan
    row.recipes = emission.recipes
    row.receipt = emission.receipt
    var rows: artifacts.RegallocProductionLedgerFunction[]
    add(rows, row)
    return artifacts.RegallocProductionActionEmissionLedgerSerialize(
               metadata, rows).valid

fn cfgFindTermFragment(
        emission: var emitter.RegallocProductionFunctionEmission,
        termIndex: int32): int32 =
    for fragmentIndex in 0..<
            emission.recipes.machineFragments.len:
        let fragment =
            emission.recipes.machineFragments[fragmentIndex]
        if fragment.ownerKind ==
               contract.RegallocA64FragmentOwnerTerm &&
           fragment.siteIndex == termIndex:
            return fragmentIndex
    return -1

fn cfgLoopCheck(): int32 =
    var body = cfgLoopBody()
    var emission = cfgEmit(body, "cheng_x8664_cfg_loop")
    if !emission.valid:
        echo(Fmt"loop emission invalid error={emission.errorCode} plan={emission.plan.errorCode} detail={emission.plan.errorDetail} recipe={emission.recipes.errorCode} recipe_detail={emission.recipes.errorDetail}")
        return 1
    if !cfgLedgerValid(emission):
        return 5
    if emission.recipes.blockEmissionOrder.len != 3:
        return 6
    let entryFragmentIndex = cfgFindTermFragment(emission, 0)
    let loopFragmentIndex = cfgFindTermFragment(emission, 1)
    if entryFragmentIndex < 0 || loopFragmentIndex < 0:
        return 2
    let entry =
        emission.recipes.machineFragments[entryFragmentIndex]
    let loop =
        emission.recipes.machineFragments[loopFragmentIndex]
    if entry.branchByteOffsets.len != 1 ||
       entry.branchTargetByteOffsets.len != 1 ||
       entry.branchTargetByteOffsets[0] <=
           entry.branchByteOffsets[0] ||
       loop.branchByteOffsets.len != 2 ||
       loop.branchTargetByteOffsets.len != 2:
        return 3
    var sawBackward: bool
    var sawForward: bool
    for branchIndex in 0..<loop.branchByteOffsets.len:
        if loop.branchTargetByteOffsets[branchIndex] <
               loop.branchByteOffsets[branchIndex]:
            sawBackward = true
        if loop.branchTargetByteOffsets[branchIndex] >
               loop.branchByteOffsets[branchIndex]:
            sawForward = true
    if !sawBackward || !sawForward:
        return 4
    return 0

fn cfgCriticalCheck(): int32 =
    var body = cfgCriticalDiamondBody()
    var emission = cfgEmit(body, "cheng_x8664_cfg_critical")
    if !emission.valid || !cfgLedgerValid(emission):
        return 1
    var criticalEdge: int32 = -1
    for actionIndex in 0..<emission.plan.actions.len:
        let action = emission.plan.actions[actionIndex]
        if action.kind ==
               alloc.RegallocValueActionEdgeParallelCopy &&
           action.sourceBlock == 0 &&
           action.targetBlock == 2:
            if !action.requiresEdgeSplit:
                return 2
            criticalEdge = action.edgeIndex
    if criticalEdge < 0 ||
       criticalEdge >= emission.recipes.edgeSplitWordStarts.len ||
       emission.recipes.edgeSplitWordStarts[criticalEdge] < 0:
        return 3
    var sawEdgeAction: bool
    var sawTrampoline: bool
    for fragmentIndex in 0..<
            emission.recipes.machineFragments.len:
        let fragment =
            emission.recipes.machineFragments[fragmentIndex]
        if fragment.edgeIndex != criticalEdge:
            continue
        if fragment.ownerKind ==
               contract.RegallocA64FragmentOwnerEdge &&
           fragment.actionConsumerOrdinal >= 0 &&
           fragment.requiresEdgeSplit:
            sawEdgeAction = true
        if fragment.ownerKind ==
               contract.RegallocA64FragmentOwnerEdgeTrampoline &&
           fragment.branchByteOffsets.len == 1 &&
           fragment.branchTargetByteOffsets.len == 1 &&
           fragment.targetBlock == 2:
            sawTrampoline = true
    if !sawEdgeAction || !sawTrampoline:
        return 4
    return 0

fn cfgCycleCheck(): int32 =
    var body = cfgParallelCycleBody()
    var emission = cfgEmit(body, "cheng_x8664_cfg_cycle")
    if !emission.valid || !cfgLedgerValid(emission) ||
       emission.plan.constraints.parallelCopyScratchReg != 11:
        return 1
    var saveAction: int32 = -1
    var restoreAction: int32 = -1
    for actionIndex in 0..<emission.plan.actions.len:
        let action = emission.plan.actions[actionIndex]
        if action.kind ==
               alloc.RegallocValueActionParallelScratchSave:
            if action.targetReg != 11 || action.scratchReg != 11:
                return 2
            saveAction = actionIndex
        if action.kind ==
               alloc.RegallocValueActionParallelScratchRestore:
            if action.sourceReg != 11 || action.scratchReg != 11 ||
               action.relatedActionOrdinal != saveAction:
                return 3
            restoreAction = actionIndex
    if saveAction < 0 || restoreAction < 0:
        return 4
    var saveFragment: bool
    var restoreFragment: bool
    for fragmentIndex in 0..<
            emission.recipes.machineFragments.len:
        let fragment =
            emission.recipes.machineFragments[fragmentIndex]
        if fragment.actionConsumerOrdinal != saveAction &&
           fragment.actionConsumerOrdinal != restoreAction:
            continue
        if fragment.ownerKind !=
               contract.RegallocA64FragmentOwnerEdge ||
           fragment.writtenRegs.len != 1:
            return 5
        if fragment.actionConsumerOrdinal == saveAction:
            if fragment.writtenRegs[0] != 11:
                return 6
            saveFragment = true
        else:
            restoreFragment = true
    if !saveFragment || !restoreFragment:
        return 7
    return 0

fn cfgMutationRejected(mutationKind: int32): bool =
    var body = cfgCriticalDiamondBody()
    var emission = cfgEmit(body, "cheng_x8664_cfg_mutation")
    if !emission.valid:
        return false
    var firstBranchFragment: int32 = -1
    var firstActionFragment: int32 = -1
    var secondActionFragment: int32 = -1
    for fragmentIndex in 0..<
            emission.recipes.machineFragments.len:
        let fragment =
            emission.recipes.machineFragments[fragmentIndex]
        if firstBranchFragment < 0 &&
           fragment.branchByteOffsets.len > 0:
            firstBranchFragment = fragmentIndex
        if fragment.actionConsumerOrdinal >= 0:
            if firstActionFragment < 0:
                firstActionFragment = fragmentIndex
            elif secondActionFragment < 0:
                secondActionFragment = fragmentIndex
    if firstBranchFragment < 0 ||
       firstActionFragment < 0 ||
       secondActionFragment < 0:
        return false
    if mutationKind == 1:
        emission.recipes.machineFragments[
            firstBranchFragment].branchByteOffsets = []
    elif mutationKind == 2:
        let oldTarget =
            emission.recipes.machineFragments[
                firstBranchFragment].branchTargetByteOffsets[0]
        var swappedTarget =
            emission.recipes.blockWordStarts[0] * 4
        if swappedTarget == oldTarget:
            swappedTarget =
                emission.recipes.blockWordStarts[1] * 4
        emission.recipes.machineFragments[
            firstBranchFragment].branchTargetByteOffsets[0] =
                swappedTarget
        emission.recipes.machineFragments[
            firstBranchFragment].branchTargetWordStarts[0] =
                swappedTarget / 4
    elif mutationKind == 3:
        emission.recipes.machineFragments[
            secondActionFragment].actionConsumerOrdinal =
                emission.recipes.machineFragments[
                    firstActionFragment].actionConsumerOrdinal
    else:
        return false
    return !cfgLedgerValid(emission)

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !x8664adapter.RegallocX64CodegenUnitRegister():
        return 90
    let loopCode = cfgLoopCheck()
    if loopCode != 0:
        return 10 + loopCode
    let criticalCode = cfgCriticalCheck()
    if criticalCode != 0:
        return 20 + criticalCode
    let cycleCode = cfgCycleCheck()
    if cycleCode != 0:
        return 30 + cycleCode
    for mutationKind in 1..<4:
        if !cfgMutationRejected(mutationKind):
            return 40 + mutationKind
    return 0
