import std/system as system

# [repro] Which managed locals survive the call that owned them?
#
# Every delta is taken ACROSS the call, in `main`.  The first version of this
# probe read the live count *inside* each worker, before its local left scope,
# so every case reported "+1 because the value is still alive".  That is not a
# leak measurement, and the conclusion drawn from it was wrong.
#
# Exit code packs one base-8 digit per worker: digit0 seq via add, digit1 seq
# with an explicit `= []`, digit2 array-literal local, digit3 local str,
# digit4 local `new` object.  0 = every buffer was released by its owner.

type ScopeProbeRef = ref object
    marker: int32

var scopeProbeSink: int32

fn WorkerSeqImplicit(): int32 =
    var a: int32[]
    add(a, 1)
    add(a, 2)
    return a.len + a[0] + a[1]

fn WorkerSeqExplicit(): int32 =
    var a: int32[]
    add(a, 1)
    add(a, 2)
    let observed = a.len + a[0] + a[1]
    a = []
    return observed

fn WorkerSeqLiteral(): int32 =
    let d: int32[] = [7, 8, 9]
    return d.len + d[0] + d[2]

fn WorkerStr(seed: int32): int32 =
    let s: str = Fmt"local-{Int32(seed)}-payload"
    return s.len

fn WorkerRefObject(): int32 =
    var r = new(ScopeProbeRef)
    r.marker = 5
    return r.marker

fn Digit(value: int64, weight: int64): int64 =
    if value < 0:
        return 7 * weight
    if value > 6:
        return 6 * weight
    return value * weight

fn main(): int32 =
    var acc: int32
    let before0 = system.MemLiveAllocations()
    acc = acc + WorkerSeqImplicit()
    let delta0 = system.MemLiveAllocations() - before0
    let before1 = system.MemLiveAllocations()
    acc = acc + WorkerSeqExplicit()
    let delta1 = system.MemLiveAllocations() - before1
    let before2 = system.MemLiveAllocations()
    acc = acc + WorkerSeqLiteral()
    let delta2 = system.MemLiveAllocations() - before2
    let before3 = system.MemLiveAllocations()
    acc = acc + WorkerStr(acc + 7)
    let delta3 = system.MemLiveAllocations() - before3
    let before4 = system.MemLiveAllocations()
    acc = acc + WorkerRefObject()
    let delta4 = system.MemLiveAllocations() - before4
    scopeProbeSink = acc
    if acc <= 0:
        return 99
    let packed = Digit(delta0, 1) +
                 Digit(delta1, 8) +
                 Digit(delta2, 64) +
                 Digit(delta3, 512) +
                 Digit(delta4, 4096)
    return int32(packed)
