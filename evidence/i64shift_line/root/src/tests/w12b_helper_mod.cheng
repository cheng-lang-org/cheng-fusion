type
    Direction = enum
        Inbound = 0
        Outbound = 1

    BigBlob =
        tag: int32
        pad: int32[1578]

fn DirectionOf(x: int32): int32 =
    if x > 0:
        return 1
    return 0

fn DirectionOfBlob(b: BigBlob): Direction =
    if b.tag > 0:
        return Outbound
    return Inbound
