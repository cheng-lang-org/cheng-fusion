import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr as typed_expr
import cheng/core/lang/typed_expr_frag_codec as fragment_codec
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/tooling/semantic_snapshot_incremental_plan as incremental

fn ExactCid(seed: int32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    out.data[0] = uint8(seed)
    return out

fn CanonicalFragmentPayload(): str =
    var fragment: fragment_codec.TypedExprIrFunctionFragment
    fragment.sourcePath = "pkg/attack.cheng"
    fragment.functionName = "attack"
    fragment.signatureLineNumber = 1
    fragment.endLineNumber = 1
    fragment.bodyLineNumber = 1
    fragment.returnType = "int32"
    fragment.resultExprClass = int32(typed_expr.TypedExprExprOwned)
    fragment.returnNodeIndex = -1
    fragment.valueDefinitionTypeArenaArtifactCid =
        layout.FixedBytes32Hex(layout.FixedBytes32())
    fragment.scopeStart = 0
    fragment.scopeCount = 1
    fragment.scopes.scopeIds = [0]
    fragment.scopes.parentScopeIds = [-1]
    fragment.scopes.kinds = [int32(parser.NormalizedScopeRoot)]
    fragment.scopes.ownerStatementOrdinals = [-1]
    fragment.scopes.lexicalOrdinals = [0]
    fragment.scopes.startLineNumbers = [1]
    fragment.scopes.startColumnNumbers = [1]
    fragment.scopes.endLineNumbers = [1]
    fragment.scopes.endColumnNumbers = [1]
    var encoded =
        fragment_codec.TypedExprIrFunctionFragmentEncode(fragment)
    let out = rawbytes.BytesToString(encoded)
    rawbytes.BytesFree(encoded)
    return out

# Appends one byte and recomputes the codec checksum.  Hash/key/cache envelope
# validation therefore succeeds; only strict decoder EOF validation can reject.
fn CoordinatedTrailingPayload(): str =
    let canonicalText = CanonicalFragmentPayload()
    let canonical = rawbytes.BytesFromString(canonicalText)
    let envelopePrefixSize = 8
    let bodyStart = envelopePrefixSize + layout.FixedBytes32Size
    assert(rawbytes.BytesLen(canonical) > bodyStart,
           " fragment registry attack: codec payload too short")
    let header = rawbytes.BytesSliceView(
        canonical, 0, envelopePrefixSize)
    let body = rawbytes.BytesSliceView(
        canonical, bodyStart, rawbytes.BytesLen(canonical) - bodyStart)
    var bodyBuilder = rawbytes.BytesBuilderNew(
        rawbytes.BytesLen(body) + 1)
    rawbytes.BytesBuilderAppend(bodyBuilder, body)
    rawbytes.BytesBuilderAppendByte(bodyBuilder, 127)
    var attackedBody = rawbytes.BytesBuilderFinish(bodyBuilder)
    let digest = hash256.Sha256Fixed(
        layout.ByteSpanFromBytes(attackedBody))
    var digestBytes = layout.FixedBytes32ToBytes(digest)
    var payloadBuilder = rawbytes.BytesBuilderNew(
        bodyStart + rawbytes.BytesLen(attackedBody))
    rawbytes.BytesBuilderAppend(payloadBuilder, header)
    rawbytes.BytesBuilderAppend(payloadBuilder, digestBytes)
    rawbytes.BytesBuilderAppend(payloadBuilder, attackedBody)
    var attacked = rawbytes.BytesBuilderFinish(payloadBuilder)
    let out = rawbytes.BytesToString(attacked)
    rawbytes.BytesFree(attacked)
    rawbytes.BytesFree(digestBytes)
    rawbytes.BytesFree(attackedBody)
    return out

fn main() =
    let functionSymbolCid = ExactCid(10)
    var exactReadSetCid: layout.FixedBytes32
    var err: str
    assert(incremental.SemanticSnapshotExactReadSetCidInto(
               functionSymbolCid,
               [schema.CsgCompilerReadDomainSymbolInterface],
               [ExactCid(30)], [ExactCid(40)], exactReadSetCid, err), err)
    var cache: incremental.SemanticSnapshotFunctionFragmentCache
    assert(incremental.SemanticSnapshotFunctionFragmentCacheAppendInto(
               cache, functionSymbolCid,
               schema.CsgCompilerSourceContentCid("attack-source"),
               ExactCid(50), exactReadSetCid, ExactCid(200),
               ExactCid(201), ExactCid(202),
               CoordinatedTrailingPayload(), err), err)
    assert(incremental.SemanticSnapshotFunctionFragmentCacheSealInto(
               cache, err), err)
    var workspaceOwner: incremental.SemanticSnapshotWorkspaceFunctionFragmentOwner
    assert(incremental.SemanticSnapshotWorkspaceFunctionFragmentOwnerInitInto(
               ExactCid(209), ExactCid(200), ExactCid(201),
               ExactCid(202), cache.cacheCid, cache,
               workspaceOwner, err), err)
    var current: incremental.SemanticSnapshotIncrementalPrebuildFacts
    current.sourceVersion = int64(7)
    current.factsCid = ExactCid(203)
    current.symbolCids = [functionSymbolCid]
    current.functionSymbolIds = [0]
    current.bodyContentCids = [
        schema.CsgCompilerSourceContentCid("attack-source")]
    current.functionInterfaceCids = [ExactCid(50)]
    var finalized: incremental.SemanticSnapshotIncrementalFinalizedReadSet
    finalized.previousCsgRootCid = ExactCid(204)
    finalized.sourceVersion = current.sourceVersion
    finalized.factsCid = current.factsCid
    finalized.planCid = ExactCid(205)
    finalized.readStarts = [0]
    finalized.readCounts = [1]
    finalized.readSetPreimageCids = [exactReadSetCid]
    finalized.readSet.readerFunctionIds = [0]
    finalized.readSet.targetDomainKinds = [
        schema.CsgCompilerReadDomainSymbolInterface]
    finalized.readSet.targetPortableKeyCids = [ExactCid(30)]
    finalized.readSet.observedValueCids = [ExactCid(40)]
    finalized.readSet.reverseIndexCid = ExactCid(206)
    finalized.readSet.reverseTargetDomainKinds =
        finalized.readSet.targetDomainKinds
    finalized.readSet.reverseTargetPortableKeyCids =
        finalized.readSet.targetPortableKeyCids
    finalized.readSet.reverseStarts = [0]
    finalized.readSet.reverseCounts = [1]
    finalized.readSet.reverseReaderFunctionIds = [0]
    finalized.readSet.reverseObservedValueCids = [ExactCid(40)]
    finalized.readSet.reverseForwardRowIds = [0]
    finalized.reverseIndexOwner.receiptCid = ExactCid(207)
    finalized.receiptCid =
        incremental.SemanticSnapshotIncrementalFinalizedReadSetReceiptCid(
            finalized)
    var input: incremental.SemanticSnapshotFunctionFragmentAdmissionInput
    assert(incremental.SemanticSnapshotFunctionFragmentAdmissionInputMakeInto(
               current, finalized, 0, input, err), err)
    var registry: incremental.SemanticSnapshotDecodedFunctionFragmentRegistry
    assert(incremental.SemanticSnapshotDecodedFunctionFragmentRegistryInitInto(
               ExactCid(210), 1, current.sourceVersion, current.factsCid,
               finalized.receiptCid,
               workspaceOwner, registry, err), err)
    var admission: incremental.SemanticSnapshotFunctionFragmentAdmission
    let accepted =
        incremental.SemanticSnapshotDecodedFunctionFragmentRegistryVisitInto(
            current, finalized,
            workspaceOwner, registry, input, admission, err)
    assert(!accepted,
           " fragment registry attack: coordinated trailing bytes accepted")
