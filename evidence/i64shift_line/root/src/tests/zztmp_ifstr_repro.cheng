import std/os as os
import std/strings

@borrows
fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn mutate(lines: str[]): str[] =
    var out: str[]
    for i in 0..<lines.len:
        let nibbleAt = 3
        let replacement =
            if lines[i][nibbleAt] == '0':
                "1"
            else:
                "0"
        let changed = cat(
            cat(
                strings.CloneStrRange(lines[i], 0, nibbleAt),
                replacement),
            strings.CloneStrRange(
                lines[i],
                nibbleAt + 1,
                lines[i].len - nibbleAt - 1))
        add(out, changed)
    return out

fn main(): int32 =
    var input: str[]
    add(input, strings.CloneStr("abcdef"))
    let result = mutate(input)
    os.WriteLine(os.Get_stdout(), result[0])
    os.WriteLine(os.Get_stdout(), "p22 ok")
    return 0
