import cheng/core/runtime/js_runtime as jsrt

fn main(): int32 =
    var array: jsrt.JsArray
    if !jsrt.JsArrayInit(array, 1):
        echo("FAIL init array")
        return 1
    if jsrt.JsArrayPushInt32Length(array, 1) != 1:
        echo("FAIL first push")
        return 2
    if jsrt.JsArrayCapacity(array) != 1:
        echo("FAIL initial capacity")
        return 3
    if jsrt.JsArrayPushInt32Length(array, 2) != 2:
        echo("FAIL second push")
        return 4
    if jsrt.JsArrayLength(array) != 2:
        echo("FAIL length")
        return 5
    if jsrt.JsArrayCapacity(array) < 2:
        echo("FAIL grown capacity")
        return 6
    var value: int32
    if !jsrt.JsArrayGetInt32(array, 1, value):
        echo("FAIL get value")
        return 7
    if value != 2:
        echo("FAIL value")
        return 8
    if !jsrt.JsArrayEveryTruthy(array):
        echo("FAIL every truthy int32")
        return 9
    if !jsrt.JsArraySomeTruthy(array):
        echo("FAIL some truthy int32")
        return 10
    if jsrt.JsArrayPushInt32Length(array, 0) != 3:
        echo("FAIL zero push")
        return 11
    if jsrt.JsArrayEveryTruthy(array):
        echo("FAIL every truthy zero")
        return 12
    var values: jsrt.JsArray
    if !jsrt.JsArrayInit(values, 3):
        echo("FAIL init js values")
        return 13
    var emptyText: jsrt.JsValue
    jsrt.JsValueInitString(emptyText, "")
    if !jsrt.JsArrayPushJsValue(values, emptyText):
        echo("FAIL push empty string")
        return 14
    var readyText: jsrt.JsValue
    jsrt.JsValueInitString(readyText, "ready")
    if !jsrt.JsArrayPushJsValue(values, readyText):
        echo("FAIL push ready string")
        return 15
    if jsrt.JsArrayEveryTruthy(values):
        echo("FAIL every truthy js values")
        return 16
    if !jsrt.JsArraySomeTruthy(values):
        echo("FAIL some truthy js values")
        return 17
    echo(" js_runtime_array_push_assertions=init/push/grow/get/truthy")
    echo(" js_runtime_array_push_smoke ok")
    return 0
