import std/system
import std/result
import std/strings
import std/strutils as strutil

type
    StringBox =
        text: str
        items: str[]

    BoolBox =
        ok: bool

    DefaultBox =
        host: str = "127.0.0.1"
        port: int32 = 4187
        enabled: bool = true

fn localConcat(left: str, right: str): str =
    return strings.ConcatStr(left, right)

fn localResultText(): Result[str] =
    return Ok[str](localConcat("res", "ult"))

fn localStringBox(): StringBox =
    var out: StringBox
    out.text = "box"
    add(out.items, "one")
    add(out.items, "two")
    return out

fn localBoxText(box: StringBox): str =
    return box.text

fn localBoxItemCount(box: StringBox): int32 =
    return box.items.len

fn localBoolFalse(): BoolBox =
    var out: BoolBox
    out.ok = false
    return out

fn localDefaultBox(): DefaultBox =
    var out: DefaultBox
    return out

fn main(): int32 =
    let concat = strings.ConcatStr("hello", "-cheng")
    assert(concat == "hello-cheng", "cold direct string: ConcatStr")

    let viaFunction = localConcat("local", "-return")
    assert(viaFunction == "local-return", "cold direct string: local str return")

    let resultText = Value(localResultText())
    assert(resultText == "result", "cold direct string: Result[str]")
    let boolBox = localBoolFalse()
    assert(boolBox.ok == false, "cold direct string: bool false field")
    var defaultBox: DefaultBox
    assert(defaultBox.host == "127.0.0.1", "cold direct string: default str field")
    assert(defaultBox.port == 4187, "cold direct string: default int field")
    assert(defaultBox.enabled, "cold direct string: default bool field")
    let defaultCall = DefaultBox()
    assert(defaultCall.port == 4187, "cold direct string: default type call")
    let returnedDefault = localDefaultBox()
    assert(returnedDefault.host == "127.0.0.1", "cold direct string: default return")
    let errText: Result[str] = Err[str]("missing")
    assert(errText.ok == false, "cold direct string: Result[str] err field")
    assert(IsErr(errText), "cold direct string: Result[str] err")
    assert(!IsOk(errText), "cold direct string: Result[str] not ok")
    assert(Error(errText) == "missing", "cold direct string: Result[str] error text")

    let box = localStringBox()
    assert(box.text == "box", "cold direct string: object str return")
    assert(box.items.len == 2, "cold direct string: object seq return")
    assert(box.items[1] == "two", "cold direct string: object seq item return")
    assert(localBoxText(box) == "box", "cold direct string: object str param")
    assert(localBoxItemCount(box) == 2, "cold direct string: object seq param")

    let fmt = Fmt"{concat}:ok"
    assert(fmt == "hello-cheng:ok", "cold direct string: Fmt")

    let joined = strutil.Join(["one", "two", "three"], "|")
    assert(joined == "one|two|three", "cold direct string: Join")

    let nested = strings.ConcatStr(Fmt"{joined}:", strutil.Join(["a", "b"], ""))
    assert(nested == "one|two|three:ab", "cold direct string: nested")

    echo("cold_direct_string_format_smoke ok")
    return 0
