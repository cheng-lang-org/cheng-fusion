# exact_def_merge_smoke — ExactDef 批 4 单元验证: CFG merge batch +
# 借用合并权威。spec: docs/cheng-exact-def-rewrite-design.md §4 批 4 +
# docs/cheng-exact-def-batch4-merge-spec.md (规格 §4 九条空间不变量
# 逐条正负例)。
#
# 合成 BodyIR 全部经真实构建路径构造 (coreir 构建/绑定/冻结 API +
# 批 1 derive (内含批 4 merge derive 臂钩子) + 批 2 freeze + 批 4
# merge 校验 + 批 3 identity), 零 Mock; 若干负例腿经夹具戳 poke 构造
# seal 后漂移 (批 3 夹具同法: 戳 poke 只用于把「外部腐败」注入校验
# 面, 判词本身全部由被测层发射)。
#
# 夹具 merge 空间形 (与 C cold_parser.c 最终形逐块对应):
#   b0: cond 定义, CBR → b1/b2
#   b1: 臂1 定义 (原始前驱) → BR → b1e (边块: input1 拷贝居末行) → b3
#   b2: 臂2 定义 (原始前驱) → BR → b2e (边块: input2 拷贝居末行) → b3
#   b3 (join): merge 定义行居块首 (CopyLocal dst←staging), RET 消费。
# loop 形: b0 (preheader 定义+entry 拷贝) → b1 (header=join, merge 行
# dst==entry_slot, CBR → b2/b3), b2 (回边定义+拷贝) → b1, b3 RET。
#
# 模式 (argv[1], 缺省 unit):
#   unit                       — 正例全绿 (rc=0):
#     ① if/else join 双输入 merge owned (双 MOVE str);
#     ② 借用 merge (双 BORROW_SHARED str, borrowed merge 登记表);
#     ③ preserve unique (双 BU 同根, merge BU);
#     ④ loop join entry_slot 复用 (destination_override=entry_slot);
#     ⑤ ref normalize 臂 (ref object 臂 normalize 为值借用);
#     ⑥ 双 UNKNOWN→PLAIN (storage 门直驱, 与批门同实现);
#     ⑦ global shadow 同 GlobalDef 行不收请求 (首红样例形态转绿:
#        lattice 汇合不收 Ambiguous + 全流水线绿);
#     ⑧ 混合 owned+borrowed lift (借用臂 retain 提升, phi lift 表);
#     ⑨ loop 借用→owned 提升事件 (entry 借用臂 lift, 提升门绿);
#     ⑩ 判词文本断言 (29 值 mismatch/21 字段 CFG merge broken 构建器)。
#   verdict-mismatch           — 臂 exact type 族不合 → 29 值
#     `managed CFG merge batch definition mismatch` + `definitions
#     are invalid`。
#   verdict-global-mismatch    — 首红样例对照形: 双 GLOBAL_ADDR 形
#     (GlobalLoad) 臂类型不合 → 同族 mismatch (first_op_kind=
#     GlobalLoad)。
#   verdict-global-sentinel-mixed-type — 根 A 负例矩阵边界腿:
#     同源 mixed-type (-1/有类型) 对被 same-shadow 通道吸收
#     (rc=1); 真 -1/有类型拒绝的活体证明在 C 侧多行值 if。
#   verdict-global-sentinel-origins — 根 A 负例: 双 -1 双 GLOBAL
#     借用但 origin 不同 → 族门 mismatch。
#   verdict-global-sentinel-place — 根 A 负例: 臂2 place 非 GLOBAL
#     → 族门 mismatch。
#   verdict-global-sentinel-ownership — 根 A 负例: ownership 不对称
#     (BS/MOVE) → 族门 mismatch。
#   verdict-global-sentinel-producer — 根 A 负例: 臂2 非 GlobalLoad
#     生产者 → 族门 mismatch。
#   verdict-ownership          — 臂定义 own 非四值 (poke) →
#     `managed CFG merge batch ownership is invalid`。
#   verdict-source-slots       — 臂槽 kind/size 不合 →
#     `managed CFG merge batch source slots differ`。
#   verdict-storage            — 臂 storage 不合 (poke) → 7 字段
#     fprintf + `managed CFG merge batch storage identities differ`。
#   verdict-edge-staging       — input copy 非块末行 →
#     `managed CFG merge batch edge staging failed`。
#   verdict-plan-drift         — owned 计划输入 own 借用 (poke) →
#     `managed CFG merge batch plan ownership drifted`。
#   verdict-destination        — loop override 槽 size 不合 (poke) →
#     `managed CFG merge batch destination is invalid`。
#   verdict-physical-source    — merge 行 readA 戳非自环 (poke) →
#     ([sdbg]) + `managed CFG merge physical source set is invalid`。
#   verdict-borrowed-roots     — BU merge 双源根不同 (poke) →
#     `unique borrowed merge roots are not identical`。
#   verdict-borrowed-twice     — 同一 phi 行重复登记 →
#     `borrowed merge pair was recorded twice`。
#   verdict-lift-ownership     — 分支形 lift retain 形状破 (poke) →
#     全字段 fprintf + `borrowed phi lift ownership is invalid`。
#   verdict-loop-promotion     — loop entry 借用臂 lift 形状破
#     (poke) → `loop borrowed merge promotion state is invalid`。
#
# 负例基线: 判词逐字对齐 C (cold_parser.c:64371-64950/63143-63549/
# 63613-63669/63759-63844, cheng_cold.c:69392-69551); 字段值随 IR 代
# 次漂移, 门禁按 md5 钉死本树基板。

import std/cmdline as cmdline
import std/result
import std/os
import cheng/core/analysis/exact_def_derive as derive
import cheng/core/analysis/exact_def_freeze as freeze
import cheng/core/analysis/exact_def_identity as identity
import cheng/core/analysis/exact_def_merge as exactdefmerge
import cheng/core/ir/body_ir_exact_def as exactdef
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

const
    # 合成 TypeArena 行: 0=i32 1=str 2=i64 3=i32[4] 4=rec{str}
    # 5=ref rec 6=recP{i32,i32}。
    fixtureTypeI32 = 0
    fixtureTypeStr = 1
    fixtureTypeI64 = 2
    fixtureTypeArr4 = 3
    fixtureTypeRec = 4
    fixtureTypeRefObj = 5
    fixtureTypeRecP = 6
    fixtureTransportStart = 100

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

@borrows
fn smokeStrContains(text: str, sub: str): bool =
    let subLen = len(sub)
    if subLen <= 0:
        return true
    if len(text) < subLen:
        return false
    for start in 0..<len(text) - subLen + 1:
        var matched = true
        for offset in 0..<subLen:
            if text[start + offset] != sub[offset]:
                matched = false
                break
        if matched:
            return true
    return false

fn fixtureCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd")
    if IsErr(parsed):
        panic(Error(parsed))
    return Value(parsed)

@borrows
fn buildWindow(): exactdef.BodyIrExactDefTypeArenaWindow =
    var window: exactdef.BodyIrExactDefTypeArenaWindow
    window.artifactCid = fixtureCid()
    for typeId in 0..<7:
        add(window.structuralKinds,
            Int32(typearena.TypedExprStructuralTypeInvalid))
        add(window.scalarKinds,
            Int32(typearena.TypedExprStructuralScalarInvalid))
        add(window.childTypeIds, -1)
        add(window.layoutChildStarts, 0)
        add(window.layoutChildCounts, 0)
        add(window.fixedLengths, 0)
        add(window.sizeBytes, 4)
        add(window.alignBytes, 4)
    window.structuralKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI32] =
        Int32(typearena.TypedExprStructuralScalarInt32)
    window.sizeBytes[fixtureTypeI32] = 4
    window.alignBytes[fixtureTypeI32] = 4
    window.structuralKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeStr] =
        Int32(typearena.TypedExprStructuralScalarStr)
    window.sizeBytes[fixtureTypeStr] = 24
    window.alignBytes[fixtureTypeStr] = 8
    window.structuralKinds[fixtureTypeI64] =
        Int32(typearena.TypedExprStructuralTypeScalar)
    window.scalarKinds[fixtureTypeI64] =
        Int32(typearena.TypedExprStructuralScalarInt64)
    window.sizeBytes[fixtureTypeI64] = 8
    window.alignBytes[fixtureTypeI64] = 8
    window.structuralKinds[fixtureTypeArr4] =
        Int32(typearena.TypedExprStructuralTypeFixedArray)
    window.childTypeIds[fixtureTypeArr4] = fixtureTypeI32
    window.fixedLengths[fixtureTypeArr4] = 4
    window.sizeBytes[fixtureTypeArr4] = 16
    window.alignBytes[fixtureTypeArr4] = 4
    # rec{str}: Object 一托管字段 → OBJECT storage。
    window.structuralKinds[fixtureTypeRec] =
        Int32(typearena.TypedExprStructuralTypeObject)
    window.layoutChildStarts[fixtureTypeRec] = 0
    window.layoutChildCounts[fixtureTypeRec] = 1
    add(window.layoutChildTypeIds, fixtureTypeStr)
    add(window.layoutChildOffsets, 0)
    add(window.layoutChildWidths, 24)
    window.sizeBytes[fixtureTypeRec] = 24
    window.alignBytes[fixtureTypeRec] = 8
    # recP{i32,i32}: Object 全 PLAIN 字段 → PLAIN storage (Object 形
    # 独立性恒不证, 批 3 真空裁定)。
    window.structuralKinds[fixtureTypeRecP] =
        Int32(typearena.TypedExprStructuralTypeObject)
    window.layoutChildStarts[fixtureTypeRecP] = 1
    window.layoutChildCounts[fixtureTypeRecP] = 2
    add(window.layoutChildTypeIds, fixtureTypeI32)
    add(window.layoutChildTypeIds, fixtureTypeI32)
    add(window.layoutChildOffsets, 0)
    add(window.layoutChildOffsets, 4)
    add(window.layoutChildWidths, 4)
    add(window.layoutChildWidths, 4)
    window.sizeBytes[fixtureTypeRecP] = 8
    window.alignBytes[fixtureTypeRecP] = 4
    # ref rec: RefObject → child=rec。
    window.structuralKinds[fixtureTypeRefObj] =
        Int32(typearena.TypedExprStructuralTypeRefObject)
    window.childTypeIds[fixtureTypeRefObj] = fixtureTypeRec
    window.sizeBytes[fixtureTypeRefObj] = 8
    window.alignBytes[fixtureTypeRefObj] = 8
    smokeAssert(exactdef.BodyIrExactDefTypeArenaWindowShapeValid(window),
                "merge smoke: window shape")
    return window

fn bindTypeFacts(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeI32,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt32),
                    -1, 0, 4, 4),
                "merge smoke: type fact i32")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeStr,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarStr),
                    -1, 0, 24, 8),
                "merge smoke: type fact str")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeI64,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt64),
                    -1, 0, 8, 8),
                "merge smoke: type fact i64")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeArr4,
                    Int32(typearena.TypedExprStructuralTypeFixedArray),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    fixtureTypeI32, 4, 16, 4),
                "merge smoke: type fact arr4")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRec,
                    Int32(typearena.TypedExprStructuralTypeObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    -1, 0, 24, 8),
                "merge smoke: type fact rec")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRefObj,
                    Int32(typearena.TypedExprStructuralTypeRefObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    fixtureTypeRec, 0, 8, 8),
                "merge smoke: type fact ref rec")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body, fixtureCid(), fixtureTypeRecP,
                    Int32(typearena.TypedExprStructuralTypeObject),
                    Int32(typearena.TypedExprStructuralScalarInvalid),
                    -1, 0, 8, 4),
                "merge smoke: type fact recP")

fn addBoundSlot(body: var coreir.BodyIR,
                name: str,
                typeKind: int32,
                typeId: int32,
                managedStorageKind: int32,
                sizeBytes: int32,
                alignBytes: int32): int32 =
    var slot: coreir.LocalSlot
    let slotId = body.localSlots.len
    slot.id = slotId
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body, slotId, fixtureCid(), typeId,
                    managedStorageKind),
                "merge smoke: slot TypeArena proof bind")
    return slotId

fn addStrSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalStrTag, fixtureTypeStr,
        coreir.BodyManagedStorageManagedTag, 24, 8)

fn addI32Slot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalI32Tag, fixtureTypeI32,
        coreir.BodyManagedStorageUnmanagedTag, 4, 4)

fn addI64Slot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalI64Tag, fixtureTypeI64,
        coreir.BodyManagedStorageUnmanagedTag, 8, 8)

fn addRecSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeRec,
        coreir.BodyManagedStorageManagedTag, 24, 8)

fn addRefObjSlot(body: var coreir.BodyIR, name: str): int32 =
    return addBoundSlot(
        body, name, coreir.LocalAggregateTag, fixtureTypeRefObj,
        coreir.BodyManagedStorageManagedTag, 8, 8)

fn newDefOp(body: var coreir.BodyIR,
            kind: int32,
            target: int32,
            semanticRow: int32,
            ownership: coreir.OwnershipKind): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    op.valueDefSlot = target
    op.valueDefExprNodeIndex = semanticRow
    op.valueDefSemanticRow = semanticRow
    op.valueDefOwnership = ownership
    op.valueDefOriginKind = coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticRow
    return coreir.BodyIRAppendOp(body, op)

fn newBareOp(body: var coreir.BodyIR, kind: int32, target: int32): int32 =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = kind
    op.target = target
    return coreir.BodyIRAppendOp(body, op)

# 结构 source 边 (BodyDefinitionDomainBodyOpTag 物理定义边)。
fn setOpSource(body: var coreir.BodyIR, opRow: int32, sourceRow: int32) =
    body.ops[opRow].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[opRow].sourceDefinitionRow = sourceRow

fn buildTransportRows(count: int32): int32[] =
    var rows: int32[]
    for row in 0..<count:
        add(rows, fixtureTransportStart + row)
    return rows

fn appendBlock(body: var coreir.BodyIR,
               opStart: int32,
               opCount: int32,
               termIndex: int32): int32 =
    let blockId = coreir.BodyIRAppendBlock(body, opStart, opCount, 0)
    body.blocks[blockId].termIndex = termIndex
    return blockId

fn appendTerm(body: var coreir.BodyIR, term: coreir.BodyTerm): int32 =
    return coreir.BodyIRAppendTerm(body, term)

fn newRetTerm(body: var coreir.BodyIR,
              resultSlot: int32,
              sourceDef: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    term.resultSlot = resultSlot
    if sourceDef >= 0:
        term.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        term.sourceDefinitionRow = sourceDef
    return appendTerm(body, term)

fn newBrTerm(body: var coreir.BodyIR, targetBlock: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermBrTag
    term.trueBlock = targetBlock
    term.falseBlock = -1
    return appendTerm(body, term)

fn newCbrTerm(body: var coreir.BodyIR,
              conditionSlot: int32,
              trueBlock: int32,
              falseBlock: int32): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermCbrTag
    term.conditionKind = coreir.LocalI32Tag
    term.lhsSlot = conditionSlot
    term.rhsSlot = -1
    term.trueBlock = trueBlock
    term.falseBlock = falseBlock
    return appendTerm(body, term)

fn bindSuccessors(body: var coreir.BodyIR,
                  termIndex: int32,
                  successors: int32[],
                  edgeKinds: int32[]) =
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)

fn beginControl(body: var coreir.BodyIR, blockCount: int32) =
    coreir.BodyIRControlFlowBegin(body, 0)
    for blockId in 0..<blockCount:
        coreir.BodyIRControlFlowBindBlockScope(body, blockId, 0)

fn sealControlFlow(body: var coreir.BodyIR) =
    coreir.BodyIRControlFlowSeal(body)
    smokeAssert(coreir.BodyIRControlFlowShapeValid(body),
                "merge smoke: control flow seal")

@borrows
fn deriveFixture(body: var coreir.BodyIR,
                 originKinds: int32[],
                 exactTypeIds: int32[],
                 window: exactdef.BodyIrExactDefTypeArenaWindow) =
    smokeAssert(derive.BodyIrExactDefDerive(
                    body,
                    fixtureTransportStart,
                    buildTransportRows(originKinds.len),
                    originKinds,
                    exactTypeIds,
                    window),
                "merge smoke: derive rejected fixture")
    smokeAssert(body.exactDef.sealed, "merge smoke: sidecar sealed")

fn validateComposed(body: var coreir.BodyIR): bool =
    return identity.ExactDefIdentityValidateInto(
        body, freeze.ExactDefFreezeProductionLimits())

fn validateMergeOnly(body: var coreir.BodyIR): bool =
    return exactdefmerge.ExactDefMergeValidateInto(
        body, freeze.ExactDefFreezeProductionLimits())

# ---- 夹具骨架 (branch 形, 边块分离; 旋钮逐腿变异) ----

type MergeFixtureKnobs =
    armBTypeId: int32          # 臂2 槽 TypeId
    armBTypeKind: int32        # 臂2 槽 typeKind
    armBSize: int32
    ownA: coreir.OwnershipKind
    ownB: coreir.OwnershipKind
    ownEA: coreir.OwnershipKind
    ownEB: coreir.OwnershipKind
    ownM: coreir.OwnershipKind
    armDefKind: int32          # 臂定义 op kind (LoadConst/GlobalLoad)
    trailingBareRow: bool      # input1 后追加裸行 (非块末行负例)
    allI64: bool               # 全槽 i64 (GlobalLoad 族负例)

fn baseKnobs(): MergeFixtureKnobs =
    var knobs: MergeFixtureKnobs
    knobs.armBTypeId = fixtureTypeStr
    knobs.armBTypeKind = coreir.LocalStrTag
    knobs.armBSize = 24
    knobs.ownA = coreir.OwnMove
    knobs.ownB = coreir.OwnMove
    knobs.ownEA = coreir.OwnMove
    knobs.ownEB = coreir.OwnMove
    knobs.ownM = coreir.OwnMove
    knobs.armDefKind = coreir.BodyOpLoadConstTag
    knobs.trailingBareRow = false
    knobs.allI64 = false
    return knobs

fn branchTransport(originKinds: var int32[], exactTypeIds: var int32[],
                   armBTypeId: int32) =
    add(originKinds, 4)   # 100 cond ManagedTemporary
    add(originKinds, 4)   # 101 臂1
    add(originKinds, 2)   # 102 input1 BindingInitializer
    add(originKinds, 4)   # 103 臂2
    add(originKinds, 2)   # 104 input2
    add(originKinds, 2)   # 105 merge
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, armBTypeId)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

# 骨架修正版: 块区间精确 (trailingBareRow 时 b1e 两行)。
fn buildBranchMergeBodyExact(knobs: MergeFixtureKnobs): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "merge smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let cond = addI32Slot(body, "cond")
    var armA = addStrSlot(body, "arm_a")
    var staging = addStrSlot(body, "staging")
    var dst = addStrSlot(body, "merged")
    var armATypeKind = coreir.LocalStrTag
    var armBLocalTypeId = knobs.armBTypeId
    if knobs.allI64:
        armA = addI64Slot(body, "arm_a")
        staging = addI64Slot(body, "staging")
        dst = addI64Slot(body, "merged")
        armATypeKind = coreir.LocalI64Tag
        armBLocalTypeId = fixtureTypeI64
    let armB = addBoundSlot(
        body, "arm_b", knobs.armBTypeKind, armBLocalTypeId,
        coreir.BodyManagedStorageManagedTag, knobs.armBSize, 8)
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    let term0 = newCbrTerm(body, cond, 1, 3)
    let o1 = newDefOp(body, knobs.armDefKind, armA, 101, knobs.ownA)
    if knobs.armDefKind == coreir.BodyOpLoadConstTag:
        add(body.ops[o1].operands, armATypeKind)
    else:
        add(body.ops[o1].operands, 7)
    let term1 = newBrTerm(body, 2)
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 102, knobs.ownEA)
    add(body.ops[o2].operands, armA)
    setOpSource(body, o2, o1)
    var b1eCount: int32 = 1
    if knobs.trailingBareRow:
        let _ = newBareOp(body, coreir.BodyOpStoreLocalTag, cond)
        b1eCount = 2
    let term1e = newBrTerm(body, 5)
    let o3 = newDefOp(body, knobs.armDefKind, armB, 103, knobs.ownB)
    if knobs.armDefKind == coreir.BodyOpLoadConstTag:
        add(body.ops[o3].operands, knobs.armBTypeKind)
    else:
        add(body.ops[o3].operands, 7)
    let term2 = newBrTerm(body, 4)
    let o4 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 104, knobs.ownEB)
    add(body.ops[o4].operands, armB)
    setOpSource(body, o4, o3)
    let term2e = newBrTerm(body, 5)
    let o5 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, dst, 105, knobs.ownM)
    add(body.ops[o5].operands, staging)
    setOpSource(body, o5, o2)
    let term3 = newRetTerm(body, dst, o5)
    var cursor: int32
    let _ = appendBlock(body, cursor, 1, term0)
    cursor = cursor + 1
    let _ = appendBlock(body, cursor, 1, term1)
    cursor = cursor + 1
    let _ = appendBlock(body, cursor, b1eCount, term1e)
    cursor = cursor + b1eCount
    let _ = appendBlock(body, cursor, 1, term2)
    cursor = cursor + 1
    let _ = appendBlock(body, cursor, 1, term2e)
    cursor = cursor + 1
    let _ = appendBlock(body, cursor, 1, term3)
    beginControl(body, 6)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 3)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ1e: int32[]
    add(succ1e, 5)
    var kind1e: int32[]
    add(kind1e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1e, succ1e, kind1e)
    var succ2: int32[]
    add(succ2, 4)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ2e: int32[]
    add(succ2e, 5)
    var kind2e: int32[]
    add(kind2e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2e, succ2e, kind2e)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

# ---- 正例腿构建器 ----

# ① 双 MOVE owned merge。
fn runPositiveOwned(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var body = buildBranchMergeBodyExact(baseKnobs())
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P1 owned merge: OK")
    return 0

# ② 双 BORROW_SHARED 借用 merge (borrowed merge 登记表)。
fn runPositiveBorrowed(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var knobs = baseKnobs()
    knobs.ownA = coreir.OwnBorrowShared
    knobs.ownB = coreir.OwnBorrowShared
    knobs.ownEA = coreir.OwnBorrowShared
    knobs.ownEB = coreir.OwnBorrowShared
    knobs.ownM = coreir.OwnBorrowShared
    var body = buildBranchMergeBodyExact(knobs)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    # 臂定义借用根冻结三列在界 (批 3 TEMPORARY 臂根权威; 域 BodyOp)。
    body.ops[1].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[1].valueDefBorrowOwnerDefinitionRow = 1
    body.ops[3].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[3].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[3].valueDefBorrowOwnerDefinitionRow = 1
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P2 borrowed merge: OK")
    return 0

# ③ preserve unique (双 BU 同根, merge BU; borrowed 登记 unique 门)。
fn runPositivePreserveUnique(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var knobs = baseKnobs()
    knobs.ownA = coreir.OwnBorrowUnique
    knobs.ownB = coreir.OwnBorrowUnique
    knobs.ownEA = coreir.OwnBorrowUnique
    knobs.ownEB = coreir.OwnBorrowUnique
    knobs.ownM = coreir.OwnBorrowUnique
    var body = buildBranchMergeBodyExact(knobs)
    # 双臂定义借用根冻结三列同值 (规格 §3: 根相等=三列逐值相等);
    # BU 行不触发 derive borrow-view 臂 (该臂仅 OwnBorrowShared),
    # 故戳可在 derive 前落, derive 内臂的 preserve 判定即得见。
    body.ops[1].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[1].valueDefBorrowOwnerDefinitionRow = 1
    body.ops[3].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[3].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[3].valueDefBorrowOwnerDefinitionRow = 1
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P3 preserve unique borrow: OK")
    return 0

# ④ loop join entry_slot 复用 (destination_override=entry_slot)。
fn buildLoopMergeBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "merge smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let cond = addI32Slot(body, "cond")
    let entryS = addStrSlot(body, "entry_s")
    let staging = addStrSlot(body, "staging")
    let armB = addStrSlot(body, "arm_b")
    # C 物理布局: preheader/condition/body 先行, 边块与 merge 块在
    # loop close 时创建 — merge 行 op 序居双输入拷贝之后 (规格 §2.2
    # 形状门 89307-89312 的空间形)。
    let t0 = addStrSlot(body, "t0")
    # b0 (preheader): 常量源 + entry 定义 (CopyLocal, STACK_LOCAL
    # 车道 — 与 merge 行同 slot 车道)。
    let o1c = newDefOp(
        body, coreir.BodyOpLoadConstTag, t0, 100, coreir.OwnMove)
    add(body.ops[o1c].operands, coreir.LocalStrTag)
    let o1 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, entryS, 101, coreir.OwnMove)
    add(body.ops[o1].operands, t0)
    setOpSource(body, o1, o1c)
    body.ops[o1c].valueDefConsumeOpIndexPlusOne = o1 + 1
    let term0 = newBrTerm(body, 3)
    # b1 (condition): cond 定义, CBR → b2/b4。
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 102, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    let term1 = newCbrTerm(body, cond, 2, 6)
    # b2 (loop body): 回边定义。
    let o4 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armB, 103, coreir.OwnMove)
    add(body.ops[o4].operands, coreir.LocalStrTag)
    let term2 = newBrTerm(body, 4)
    # b0e (entry 边块): entry input 拷贝 (居末行)。
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 104, coreir.OwnMove)
    add(body.ops[o2].operands, entryS)
    setOpSource(body, o2, o1)
    let term0e = newBrTerm(body, 5)
    # b2e (backedge 边块): 回边 input 拷贝 (居末行)。
    let o5 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 105, coreir.OwnMove)
    add(body.ops[o5].operands, armB)
    setOpSource(body, o5, o4)
    let term2e = newBrTerm(body, 5)
    # b3 (merge 块): merge 行 dst==entry_slot, BR → b1 (回边)。
    let o3 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, entryS, 106, coreir.OwnMove)
    add(body.ops[o3].operands, staging)
    setOpSource(body, o3, o2)
    let term3 = newBrTerm(body, 1)
    # b4 (exit): RET。
    let term4 = newRetTerm(body, entryS, o3)
    let _ = appendBlock(body, 0, 2, term0)      # b0 preheader
    let _ = appendBlock(body, 2, 1, term1)      # b1 condition
    let _ = appendBlock(body, 3, 1, term2)      # b2 loop body
    let _ = appendBlock(body, 4, 1, term0e)     # b0e entry edge
    let _ = appendBlock(body, 5, 1, term2e)     # b2e backedge edge
    let _ = appendBlock(body, 6, 1, term3)      # b3 merge block
    let _ = appendBlock(body, 7, 0, term4)      # b4 exit
    beginControl(body, 7)
    var succ0: int32[]
    add(succ0, 3)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    add(succ1, 6)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    add(succ2, 4)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ0e: int32[]
    add(succ0e, 5)
    var kind0e: int32[]
    add(kind0e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0e, succ0e, kind0e)
    var succ2e: int32[]
    add(succ2e, 5)
    var kind2e: int32[]
    add(kind2e, coreir.BodyControlEdgeLoopBack)
    bindSuccessors(body, term2e, succ2e, kind2e)
    var succ3: int32[]
    add(succ3, 1)
    var kind3: int32[]
    add(kind3, coreir.BodyControlEdgeLoopBack)
    bindSuccessors(body, term3, succ3, kind3)
    var succ4: int32[]
    var kind4: int32[]
    bindSuccessors(body, term4, succ4, kind4)
    sealControlFlow(body)
    return body

fn loopTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 t0 常量源 (TEMPORARY 车道)
    add(originKinds, 2)   # 101 entry def (STACK_LOCAL 车道)
    add(originKinds, 4)   # 102 cond
    add(originKinds, 4)   # 103 backedge def
    add(originKinds, 2)   # 104 entry input
    add(originKinds, 2)   # 105 backedge input
    add(originKinds, 2)   # 106 merge
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

fn runPositiveLoop(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    loopTransport(originKinds, exactTypeIds)
    var body = buildLoopMergeBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P4 loop entry_slot merge: OK")
    return 0

# ⑤ ref normalize 臂 (ref object 臂 normalize 为值借用进 merge)。
fn buildNormalizeBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "merge smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let cond = addI32Slot(body, "cond")
    let armRef = addRefObjSlot(body, "arm_ref")
    let valTmp = addRecSlot(body, "val_tmp")
    let armB = addRecSlot(body, "arm_b")
    let staging = addRecSlot(body, "staging")
    let dst = addRecSlot(body, "merged")
    # b0: cond + CBR。
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    let term0 = newCbrTerm(body, cond, 1, 3)
    # b1: ref 臂定义 (own BS)。
    let o1 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armRef, 101,
        coreir.OwnBorrowShared)
    add(body.ops[o1].operands, coreir.LocalAggregateTag)
    let term1 = newBrTerm(body, 2)
    # b1e: 值借用 (边内 normalize 源) + input1 (居末行)。
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, valTmp, 102,
        coreir.OwnBorrowShared)
    add(body.ops[o2].operands, armRef)
    body.ops[o2].valueDefBorrowOwnerSemanticRow = 101
    body.ops[o2].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[o2].valueDefBorrowOwnerDefinitionRow = o1
    let o3 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 103,
        coreir.OwnBorrowShared)
    add(body.ops[o3].operands, valTmp)
    setOpSource(body, o3, o2)
    let term1e = newBrTerm(body, 5)
    # b2: 值臂定义 (own BS) — 双借用 merge。
    let o4 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armB, 104,
        coreir.OwnBorrowShared)
    add(body.ops[o4].operands, coreir.LocalAggregateTag)
    let term2 = newBrTerm(body, 4)
    # b2e: input2 (居末行)。
    let o5 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 105,
        coreir.OwnBorrowShared)
    add(body.ops[o5].operands, armB)
    setOpSource(body, o5, o4)
    let term2e = newBrTerm(body, 5)
    # b3 (join): merge 行 (own BS)。
    let o6 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, dst, 106,
        coreir.OwnBorrowShared)
    add(body.ops[o6].operands, staging)
    setOpSource(body, o6, o3)
    let term3 = newRetTerm(body, dst, o6)
    let _ = appendBlock(body, 0, 1, term0)     # b0
    let _ = appendBlock(body, 1, 1, term1)     # b1
    let _ = appendBlock(body, 2, 2, term1e)    # b1e (值借用+input1)
    let _ = appendBlock(body, 4, 1, term2)     # b2
    let _ = appendBlock(body, 5, 1, term2e)    # b2e
    let _ = appendBlock(body, 6, 1, term3)     # b3 (join)
    beginControl(body, 6)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 3)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ1e: int32[]
    add(succ1e, 5)
    var kind1e: int32[]
    add(kind1e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1e, succ1e, kind1e)
    var succ2: int32[]
    add(succ2, 4)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ2e: int32[]
    add(succ2e, 5)
    var kind2e: int32[]
    add(kind2e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2e, succ2e, kind2e)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

fn normalizeTransport(originKinds: var int32[],
                      exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 cond
    add(originKinds, 4)   # 101 ref def
    add(originKinds, 2)   # 102 value borrow
    add(originKinds, 2)   # 103 input1
    add(originKinds, 4)   # 104 value arm def
    add(originKinds, 2)   # 105 input2
    add(originKinds, 2)   # 106 merge
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeRefObj)
    add(exactTypeIds, fixtureTypeRec)
    add(exactTypeIds, fixtureTypeRec)
    add(exactTypeIds, fixtureTypeRec)
    add(exactTypeIds, fixtureTypeRec)
    add(exactTypeIds, fixtureTypeRec)

fn runPositiveNormalize(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    normalizeTransport(originKinds, exactTypeIds)
    var body = buildNormalizeBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    # 双臂定义借用根冻结三列在界 (批 3 TEMPORARY 臂根权威)。
    body.ops[1].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[1].valueDefBorrowOwnerDefinitionRow = 1
    body.ops[4].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[4].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[4].valueDefBorrowOwnerDefinitionRow = 1
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P5 ref normalize merge: OK")
    return 0

# ⑥ 双 UNKNOWN→PLAIN (owned merge 绿 + storage 门直驱: 双臂
#    recorded UNKNOWN → 门按 PLAIN 收, cold_parser.c:64421-64423
#    镜像条款的可执行证明)。
fn runPositiveUnknownPlain(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var body = buildBranchMergeBodyExact(baseKnobs())
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if !validateComposed(body):
        return 1
    body.exactDef.slotStorageKinds[1] =
        exactdef.BodyIrExactDefStorageUnknownTag
    body.exactDef.slotStorageKinds[4] =
        exactdef.BodyIrExactDefStorageUnknownTag
    let storage = exactdefmerge.ExactDefMergeTestPlanStorageGate(
        body, 1, 4, 1, "merged", coreir.LocalStrTag)
    if storage != exactdef.BodyIrExactDefStoragePlainTag:
        return 1
    os.WriteLine(os.Get_stdout(), "P6 double UNKNOWN to PLAIN: OK")
    return 0

# ⑦ global shadow 同 GlobalDef 行 (首红样例形态转绿):
#    双臂同槽 GlobalLoad remat 同 origin → lattice 汇合不收
#    Ambiguous (不收请求); 异 origin → Ambiguous (请求形)。
fn buildGlobalShadowBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "merge smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let cond = addI32Slot(body, "cond")
    let gR1 = addI64Slot(body, "g_r1")
    let gR2 = addI64Slot(body, "g_r2")
    let out = addI64Slot(body, "out_v")
    let out2 = addI64Slot(body, "out2_v")
    let gBase = addI64Slot(body, "g_base")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    let o0g = newDefOp(
        body, coreir.BodyOpGlobalLoadTag, gBase, 101,
        coreir.OwnBorrowShared)
    add(body.ops[o0g].operands, 7)
    let term0 = newCbrTerm(body, cond, 1, 2)
    let o1 = newDefOp(
        body, coreir.BodyOpGlobalLoadTag, gR1, 102,
        coreir.OwnBorrowShared)
    add(body.ops[o1].operands, 7)
    let o1u = newDefOp(
        body, coreir.BodyOpCopyLocalTag, out, 103,
        coreir.OwnBorrowShared)
    add(body.ops[o1u].operands, gR1)
    setOpSource(body, o1u, o1)
    let term1 = newBrTerm(body, 3)
    let o2 = newDefOp(
        body, coreir.BodyOpGlobalLoadTag, gR2, 104,
        coreir.OwnBorrowShared)
    add(body.ops[o2].operands, 7)
    let o2u = newDefOp(
        body, coreir.BodyOpCopyLocalTag, out, 105,
        coreir.OwnBorrowShared)
    add(body.ops[o2u].operands, gR2)
    setOpSource(body, o2u, o2)
    let term2 = newBrTerm(body, 3)
    let o3 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, out2, 106,
        coreir.OwnBorrowShared)
    add(body.ops[o3].operands, gBase)
    setOpSource(body, o3, o0g)
    let term3 = newRetTerm(body, out2, o3)
    let _ = appendBlock(body, 0, 2, term0)     # b0
    let _ = appendBlock(body, 2, 2, term1)     # b1
    let _ = appendBlock(body, 4, 2, term2)     # b2
    let _ = appendBlock(body, 6, 1, term3)     # b3 (join)
    beginControl(body, 4)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 2)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 3)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    add(succ2, 3)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

fn globalShadowTransport(originKinds: var int32[],
                         exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 cond
    add(originKinds, 4)   # 101 g_base baseline
    add(originKinds, 4)   # 102 g remat arm1 (单定义 TEMPORARY 车道)
    add(originKinds, 2)   # 103 out arm1
    add(originKinds, 4)   # 104 g remat arm2
    add(originKinds, 2)   # 105 out arm2
    add(originKinds, 2)   # 106 out2 baseline read
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeI64)
    add(exactTypeIds, fixtureTypeI64)
    add(exactTypeIds, fixtureTypeI64)
    add(exactTypeIds, fixtureTypeI64)
    add(exactTypeIds, fixtureTypeI64)
    add(exactTypeIds, fixtureTypeI64)

fn buildGlobalShadowSameSlotBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "merge smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let cond = addI32Slot(body, "cond")
    let g = addI64Slot(body, "g_same")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    let term0 = newCbrTerm(body, cond, 1, 2)
    let o1 = newDefOp(
        body, coreir.BodyOpGlobalLoadTag, g, 101,
        coreir.OwnBorrowShared)
    add(body.ops[o1].operands, 7)
    let term1 = newBrTerm(body, 3)
    let o2 = newDefOp(
        body, coreir.BodyOpGlobalLoadTag, g, 102,
        coreir.OwnBorrowShared)
    add(body.ops[o2].operands, 7)
    let term2 = newBrTerm(body, 3)
    let term3 = newRetTerm(body, cond, -1)
    let _ = appendBlock(body, 0, 1, term0)     # b0
    let _ = appendBlock(body, 1, 1, term1)     # b1
    let _ = appendBlock(body, 2, 1, term2)     # b2
    let _ = appendBlock(body, 3, 0, term3)     # b3 (join)
    beginControl(body, 4)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 2)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 3)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    add(succ2, 3)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

fn sameSlotTransport(originKinds: var int32[],
                     exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 cond
    add(originKinds, 2)   # 101 g remat arm1 (STACK_LOCAL 车道)
    add(originKinds, 2)   # 102 g remat arm2
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeI64)
    add(exactTypeIds, fixtureTypeI64)

fn runPositiveGlobalShadow(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    globalShadowTransport(originKinds, exactTypeIds)
    var body = buildGlobalShadowBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    for opRow in 1..<body.ops.len:
        body.ops[opRow].valueDefBorrowOwnerSemanticRow = 9001
        body.ops[opRow].valueDefBorrowOwnerDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        body.ops[opRow].valueDefBorrowOwnerDefinitionRow = 1
    if !validateComposed(body):
        return 1
    # 同槽合成形: 双臂同槽 GlobalLoad remat → lattice 出口断言
    # is_global 同定义汇合 (规格 §5 四条件戳 GLOBAL place+同 origin)。
    var originKindsB: int32[]
    var exactTypeIdsB: int32[]
    sameSlotTransport(originKindsB, exactTypeIdsB)
    var bodyB = buildGlobalShadowSameSlotBody()
    deriveFixture(bodyB, originKindsB, exactTypeIdsB, buildWindow())
    bodyB.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceGlobalTag
    bodyB.exactDef.opOriginIds[1] = 7
    bodyB.exactDef.opPlaceKinds[2] =
        exactdef.BodyIrExactDefPlaceGlobalTag
    bodyB.exactDef.opOriginIds[2] = 7
    let collapsed = exactdefmerge.ExactDefMergeTestJoinEntryStateForFixture(
        bodyB, 3, 1)
    if collapsed != 1:
        return 1
    bodyB.exactDef.opOriginIds[2] = 8
    let ambiguous = exactdefmerge.ExactDefMergeTestJoinEntryStateForFixture(
        bodyB, 3, 1)
    if ambiguous != -2:
        return 1
    os.WriteLine(os.Get_stdout(), "P7 global shadow no-request: OK")
    return 0

# ⑧ 混合 owned+borrowed lift (借用臂 retain 提升进 owned merge)。
# 布局: o0 cond | o1 臂1(MOVE) | o2 input1 | o3 臂2 | o3b lift 行 |
# o4 input2 | o5 merge。run-1 (derive 内臂): o3 MOVE, o3b 借用投影
# 形 (owner=o3) → owned merge 绿; run-2 (夹具戳): o3 借用, o3b
# SHARED_COPY retain → 混合 lift 绿。
fn buildLiftBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "merge smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let cond = addI32Slot(body, "cond")
    let armA = addStrSlot(body, "arm_a")
    let armB = addStrSlot(body, "arm_b")
    let liftS = addStrSlot(body, "lift_s")
    let staging = addStrSlot(body, "staging")
    let dst = addStrSlot(body, "merged")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    let term0 = newCbrTerm(body, cond, 1, 3)
    let o1 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armA, 101, coreir.OwnMove)
    add(body.ops[o1].operands, coreir.LocalStrTag)
    let term1 = newBrTerm(body, 2)
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 102, coreir.OwnMove)
    add(body.ops[o2].operands, armA)
    setOpSource(body, o2, o1)
    let term1e = newBrTerm(body, 5)
    let o3 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armB, 103, coreir.OwnMove)
    add(body.ops[o3].operands, coreir.LocalStrTag)
    let term2 = newBrTerm(body, 4)
    let o3b = newDefOp(
        body, coreir.BodyOpCopyLocalTag, liftS, 104,
        coreir.OwnBorrowShared)
    add(body.ops[o3b].operands, armB)
    body.ops[o3b].valueDefBorrowOwnerSemanticRow = 103
    body.ops[o3b].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[o3b].valueDefBorrowOwnerDefinitionRow = o3
    let o4 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 105, coreir.OwnMove)
    add(body.ops[o4].operands, liftS)
    setOpSource(body, o4, o3b)
    let term2e = newBrTerm(body, 5)
    let o5 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, dst, 106, coreir.OwnMove)
    add(body.ops[o5].operands, staging)
    setOpSource(body, o5, o2)
    let term3 = newRetTerm(body, dst, o5)
    let _ = appendBlock(body, 0, 1, term0)     # b0
    let _ = appendBlock(body, 1, 1, term1)     # b1
    let _ = appendBlock(body, 2, 1, term1e)    # b1e
    let _ = appendBlock(body, 3, 1, term2)     # b2
    let _ = appendBlock(body, 4, 2, term2e)    # b2e (lift+input2)
    let _ = appendBlock(body, 6, 1, term3)     # b3 (join)
    beginControl(body, 6)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 3)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ1e: int32[]
    add(succ1e, 5)
    var kind1e: int32[]
    add(kind1e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1e, succ1e, kind1e)
    var succ2: int32[]
    add(succ2, 4)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ2e: int32[]
    add(succ2e, 5)
    var kind2e: int32[]
    add(kind2e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2e, succ2e, kind2e)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

fn liftTransport(originKinds: var int32[], exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 cond
    add(originKinds, 4)   # 101 armA
    add(originKinds, 2)   # 102 input1
    add(originKinds, 4)   # 103 armB
    add(originKinds, 2)   # 104 lift row (run-1 借用投影形)
    add(originKinds, 2)   # 105 input2
    add(originKinds, 2)   # 106 merge
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

fn pokeLiftLanes(body: var coreir.BodyIR) =
    body.ops[3].valueDefOwnership = coreir.OwnBorrowShared
    body.ops[3].valueDefBorrowOwnerSemanticRow = 103
    body.ops[3].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[3].valueDefBorrowOwnerDefinitionRow = 1
    body.ops[4].valueDefOwnership = coreir.OwnMove
    body.exactDef.opPlaceKinds[4] =
        exactdef.BodyIrExactDefPlaceSharedCopyTag
    body.exactDef.opOriginIds[4] = 3
    body.exactDef.slotPlaceKinds[3] =
        exactdef.BodyIrExactDefPlaceSharedCopyTag
    body.exactDef.slotOriginIds[3] = 3
    body.ops[4].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    body.ops[4].sourceDefinitionRow = -1
    body.ops[4].valueDefConsumeOpIndexPlusOne = 6

fn runPositiveMixedLift(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    liftTransport(originKinds, exactTypeIds)
    var body = buildLiftBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    pokeLiftLanes(body)
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P8 mixed owned+borrowed lift: OK")
    return 0

# ⑨ loop 借用→owned 提升事件 (entry 借用臂 lift, destination=
# entry_slot 的 loop 形)。
fn buildLoopLiftBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "merge smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let cond = addI32Slot(body, "cond")
    let entryS = addStrSlot(body, "entry_s")
    let liftS = addStrSlot(body, "lift_s")
    let staging = addStrSlot(body, "staging")
    let armB = addStrSlot(body, "arm_b")
    # C 物理布局 (同 P4): merge 行 op 序居双输入拷贝之后。
    let t0 = addStrSlot(body, "t0")
    # b0 (preheader): 常量源 (借用) + entry 定义 (CopyLocal,
    # STACK_LOCAL 车道 — 与 merge 行同 slot 车道)。
    let o1c = newDefOp(
        body, coreir.BodyOpLoadConstTag, t0, 100,
        coreir.OwnBorrowShared)
    add(body.ops[o1c].operands, coreir.LocalStrTag)
    let o1 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, entryS, 101, coreir.OwnMove)
    add(body.ops[o1].operands, t0)
    setOpSource(body, o1, o1c)
    body.ops[o1c].valueDefConsumeOpIndexPlusOne = o1 + 1
    let term0 = newBrTerm(body, 3)
    # b1 (condition): cond 定义, CBR → b2/b4。
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 102, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    let term1 = newCbrTerm(body, cond, 2, 6)
    # b2 (loop body): 回边定义 (owned)。
    let o4 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armB, 103, coreir.OwnMove)
    add(body.ops[o4].operands, coreir.LocalStrTag)
    let term2 = newBrTerm(body, 4)
    # b0e (entry 边块): lift retain 行 + entry input 拷贝 (居末行)。
    let o1b = newDefOp(
        body, coreir.BodyOpCopyLocalTag, liftS, 104,
        coreir.OwnBorrowShared)
    add(body.ops[o1b].operands, entryS)
    body.ops[o1b].valueDefBorrowOwnerSemanticRow = 101
    body.ops[o1b].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[o1b].valueDefBorrowOwnerDefinitionRow = o1
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 105, coreir.OwnMove)
    add(body.ops[o2].operands, liftS)
    setOpSource(body, o2, o1b)
    let term0e = newBrTerm(body, 5)
    # b2e (backedge 边块): 回边 input 拷贝 (居末行)。
    let o5 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 106, coreir.OwnMove)
    add(body.ops[o5].operands, armB)
    setOpSource(body, o5, o4)
    let term2e = newBrTerm(body, 5)
    # b3 (merge 块): merge 行 dst==entry_slot, BR → b1 (回边)。
    let o3 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, entryS, 107, coreir.OwnMove)
    add(body.ops[o3].operands, staging)
    setOpSource(body, o3, o2)
    let term3 = newBrTerm(body, 1)
    # b4 (exit): RET。
    let term4 = newRetTerm(body, entryS, o3)
    let _ = appendBlock(body, 0, 2, term0)      # b0 preheader
    let _ = appendBlock(body, 2, 1, term1)      # b1 condition
    let _ = appendBlock(body, 3, 1, term2)      # b2 loop body
    let _ = appendBlock(body, 4, 2, term0e)     # b0e (lift+entry input)
    let _ = appendBlock(body, 6, 1, term2e)     # b2e backedge edge
    let _ = appendBlock(body, 7, 1, term3)      # b3 merge block
    let _ = appendBlock(body, 8, 0, term4)      # b4 exit
    beginControl(body, 7)
    var succ0: int32[]
    add(succ0, 3)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    add(succ1, 6)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ2: int32[]
    add(succ2, 4)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ0e: int32[]
    add(succ0e, 5)
    var kind0e: int32[]
    add(kind0e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0e, succ0e, kind0e)
    var succ2e: int32[]
    add(succ2e, 5)
    var kind2e: int32[]
    add(kind2e, coreir.BodyControlEdgeLoopBack)
    bindSuccessors(body, term2e, succ2e, kind2e)
    var succ3: int32[]
    add(succ3, 1)
    var kind3: int32[]
    add(kind3, coreir.BodyControlEdgeLoopBack)
    bindSuccessors(body, term3, succ3, kind3)
    var succ4: int32[]
    var kind4: int32[]
    bindSuccessors(body, term4, succ4, kind4)
    sealControlFlow(body)
    return body

fn loopLiftTransport(originKinds: var int32[],
                     exactTypeIds: var int32[]) =
    add(originKinds, 4)   # 100 t0 常量源 (TEMPORARY 车道)
    add(originKinds, 2)   # 101 entry def (STACK_LOCAL 车道)
    add(originKinds, 4)   # 102 cond
    add(originKinds, 4)   # 103 backedge def
    add(originKinds, 2)   # 104 lift row (run-1 借用投影形)
    add(originKinds, 2)   # 105 entry input
    add(originKinds, 2)   # 106 backedge input
    add(originKinds, 2)   # 107 merge
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeI32)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)
    add(exactTypeIds, fixtureTypeStr)

fn pokeLoopLiftLanes(body: var coreir.BodyIR) =
    body.ops[0].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[0].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[0].valueDefBorrowOwnerDefinitionRow = 1
    body.ops[1].valueDefOwnership = coreir.OwnBorrowShared
    body.ops[1].valueDefBorrowOwnerSemanticRow = 101
    body.ops[1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[1].valueDefBorrowOwnerDefinitionRow = 1
    body.ops[4].valueDefOwnership = coreir.OwnMove
    body.exactDef.opPlaceKinds[4] =
        exactdef.BodyIrExactDefPlaceSharedCopyTag
    body.exactDef.opOriginIds[4] = 1
    body.exactDef.slotPlaceKinds[2] =
        exactdef.BodyIrExactDefPlaceSharedCopyTag
    body.exactDef.slotOriginIds[2] = 1
    body.ops[4].sourceDefinitionDomain =
        coreir.BodyDefinitionDomainInvalidTag
    body.ops[4].sourceDefinitionRow = -1
    body.ops[4].valueDefConsumeOpIndexPlusOne = 6

fn runPositiveLoopPromotion(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    loopLiftTransport(originKinds, exactTypeIds)
    var body = buildLoopLiftBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    pokeLoopLiftLanes(body)
    if !validateComposed(body):
        return 1
    os.WriteLine(os.Get_stdout(), "P9 loop borrow-to-owned promotion: OK")
    return 0

# ---- ⑩ 判词文本断言 (构建器逐字, 批 2 腿⑥同例) ----

fn runVerdictTextAsserts(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var body = buildBranchMergeBodyExact(baseKnobs())
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    let mismatch = exactdefmerge.ExactDefMergeTestMismatchLine(
        body, 0, 1, "merged", 1, 3, 2, 4, 5, 0, 2, 1, 1)
    if !smokeStrContains(
           mismatch,
           "managed CFG merge batch definition mismatch body=0 request=0/1 local=merged first_def=1 second_def=3 first_pred=2 second_pred=4 merge_block=5 first_term=0 second_term=2 first_reaches=1 second_reaches=1 first_slot=1 second_slot=4 first_kind=3 second_kind=3 first_type=1 second_type=1 first_place=1 second_place=1 first_ownership=2 second_ownership=2 first_origin=1 second_origin=3 first_op_kind=1 second_op_kind=1 first_fn=0 second_fn=0 body_fn=0"):
        return 1
    let broken = exactdefmerge.ExactDefMergeTestCfgMergeBrokenLine(
        "freeze", 0, 5, 5, 2, 2, 4, 2, 2, 4, 4, 3, 3, 3, 6, 6, 1, 1,
        1, 1, 2, 2)
    if !smokeStrContains(
           broken,
           "managed CFG merge definition is broken merge_block=5 predecessor_count=2 first_pred=2 second_pred=4 source=2 source_block=2 second=4 second_block=4 operand=3 source_slot=3 second_slot=3 first_consume=6 second_consume=6 first_current=1 second_current=1 first_consume_valid=1 second_consume_valid=1 ownership=2 expected=2"):
        return 1
    return 0

fn runUnit(): int32 =
    if runPositiveOwned() != 0:
        return 1
    if runPositiveBorrowed() != 0:
        return 1
    if runPositivePreserveUnique() != 0:
        return 1
    if runPositiveLoop() != 0:
        return 1
    if runPositiveNormalize() != 0:
        return 1
    if runPositiveUnknownPlain() != 0:
        return 1
    if runPositiveGlobalShadow() != 0:
        return 1
    if runPositiveMixedLift() != 0:
        return 1
    if runPositiveLoopPromotion() != 0:
        return 1
    if runVerdictTextAsserts() != 0:
        return 1
    os.WriteLine(os.Get_stdout(), "EXACT_DEF_MERGE_UNIT_OK")
    return 0

# ---- 负例腿 ----

# N1: 臂 exact type 族不合 → 29 值 mismatch + definitions invalid。
fn runVerdictMismatch(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var body = buildBranchMergeBodyExact(baseKnobs())
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    # 臂2 recorded exact type 漂移 → 族不合 (13 合取第 12 条)。
    body.exactDef.opExactTypeIds[3] = fixtureTypeI64
    if validateMergeOnly(body):
        return 1
    return 2

# N-global: 首红样例对照形 — 双 GlobalLoad 臂类型不合 → 同族
# mismatch (first_op_kind=GlobalLoad)。
fn runVerdictGlobalMismatch(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    for index in 0..<6:
        if index == 0:
            add(originKinds, 4)
        elif index == 1 || index == 3:
            add(originKinds, 4)
        else:
            add(originKinds, 2)
    add(exactTypeIds, fixtureTypeI32)
    for index in 0..<5:
        add(exactTypeIds, fixtureTypeI64)
    var knobs = baseKnobs()
    knobs.armDefKind = coreir.BodyOpGlobalLoadTag
    knobs.allI64 = true
    knobs.armBTypeKind = coreir.LocalI64Tag
    knobs.armBSize = 8
    knobs.ownA = coreir.OwnBorrowShared
    knobs.ownB = coreir.OwnBorrowShared
    knobs.ownEA = coreir.OwnBorrowShared
    knobs.ownEB = coreir.OwnBorrowShared
    knobs.ownM = coreir.OwnBorrowShared
    var body = buildBranchMergeBodyExact(knobs)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    # 首红样例形态: 双 GLOBAL_ADDR 形 recorded type 双 -1 →
    # exact_type_family_matches 假 (13 合取致死条, 规格 §5 对照)。
    body.exactDef.opExactTypeIds[1] = -1
    body.exactDef.opExactTypeIds[3] = -1
    if validateMergeOnly(body):
        return 1
    return 2

# ---- 根 A sentinel 族 (typedexpr-cfg-roots-20260826): 族门只放行
#      「双 -1+同源 GLOBAL 借用 phi」的负例矩阵。同源 GLOBAL 对在
#      walk 内先被批 4 same-shadow 通道吸收 (1669 continue, 通道合取
#      ⊂ sentinel 合取 ⇒ 族门对正例形不可达, 见任务报告); 下列腿
#      构造通道不吸收的变体, 全部必须在族门死 (rc=2), 证明 sentinel
#      放宽没有放大到任何其它形状。mixed-type 同源对被通道吸收
#      (同 GlobalDef 行即同定义, TypeId 差异不产生两个值) — rc=1
#      记录该边界; 真 -1/有类型拒绝的活体证明在 C 侧多行值 if
#      (typed 臂居 then, fixed-array 全局居 else → 64698 mismatch)。 ----

fn buildGlobalSentinelBase(): coreir.BodyIR =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    for index in 0..<6:
        if index == 0:
            add(originKinds, 4)
        elif index == 1 || index == 3:
            add(originKinds, 4)
        else:
            add(originKinds, 2)
    add(exactTypeIds, fixtureTypeI32)
    for index in 0..<5:
        add(exactTypeIds, fixtureTypeI64)
    var knobs = baseKnobs()
    knobs.armDefKind = coreir.BodyOpGlobalLoadTag
    knobs.allI64 = true
    knobs.armBTypeKind = coreir.LocalI64Tag
    knobs.armBSize = 8
    knobs.ownA = coreir.OwnBorrowShared
    knobs.ownB = coreir.OwnBorrowShared
    knobs.ownEA = coreir.OwnBorrowShared
    knobs.ownEB = coreir.OwnBorrowShared
    knobs.ownM = coreir.OwnBorrowShared
    var body = buildBranchMergeBodyExact(knobs)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    return body

# 双臂借用根冻结三列 (借用 merge 通道在界; 根相等=三列逐值相等)。
fn pokeGlobalSentinelBorrowRoots(body: var coreir.BodyIR) =
    body.ops[1].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[1].valueDefBorrowOwnerDefinitionRow = 1
    body.ops[3].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[3].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[3].valueDefBorrowOwnerDefinitionRow = 3

# Ng0: mixed-type 同源对 — 通道吸收 (同 GlobalDef 行即同定义),
# mergeOnly 真 (rc=1)。边界记录腿, 非放行。
fn runVerdictGlobalSentinelMixedType(): int32 =
    var body = buildGlobalSentinelBase()
    body.exactDef.opExactTypeIds[1] = -1
    body.exactDef.opPlaceKinds[1] =
        exactdef.BodyIrExactDefPlaceGlobalTag
    body.exactDef.opPlaceKinds[3] =
        exactdef.BodyIrExactDefPlaceGlobalTag
    body.exactDef.opOriginIds[1] = 7
    body.exactDef.opOriginIds[3] = 7
    pokeGlobalSentinelBorrowRoots(body)
    if validateMergeOnly(body):
        return 1
    return 2

