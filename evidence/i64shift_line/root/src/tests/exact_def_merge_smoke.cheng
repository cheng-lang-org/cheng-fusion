    body.exactDef.opReadADefOpRows[5] = 2
    if validateMergeOnly(body):
        return 1
    return 2

# N9: BU merge 双源根不同 (poke) → unique borrowed merge roots are
# not identical (登记表全门直驱, 与批门同实现)。
fn runVerdictBorrowedRoots(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var knobs = baseKnobs()
    knobs.ownA = coreir.OwnBorrowUnique
    knobs.ownB = coreir.OwnBorrowUnique
    knobs.ownEA = coreir.OwnBorrowUnique
    knobs.ownEB = coreir.OwnBorrowUnique
    knobs.ownM = coreir.OwnBorrowUnique
    var body = buildBranchMergeBodyExact(knobs)
    # derive 前双根同值 (preserve 成立, run-1 BU merge 绿), derive
    # 后异化臂2 根 → 登记表 unique 门证根不同。
    body.ops[1].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[1].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[1].valueDefBorrowOwnerDefinitionRow = 1
    body.ops[3].valueDefBorrowOwnerSemanticRow = 9001
    body.ops[3].valueDefBorrowOwnerDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    body.ops[3].valueDefBorrowOwnerDefinitionRow = 1
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.ops[3].valueDefBorrowOwnerSemanticRow = 9002
    var workspace: exactdefmerge.ExactDefMergeWorkspace
    var reachState: int32[]
    setLen(reachState, body.blocks.len)
    var dom = freeze.ExactDefFreezeDominatorsBuild(body)
    setLen(workspace.opBlockIds, body.ops.len)
    for block in 0..<body.blocks.len:
        let start = body.blocks[block].opStart
        let count = body.blocks[block].opCount
        for op in start..<start + count:
            workspace.opBlockIds[op] = block
    exactdefmerge.ExactDefMergeRegisterBorrowedMergeInputs(
        body, dom, workspace, reachState, 2, 1, 2, 1, 1, 4, 3, 4, 3, 3,
        5, 5)
    return 1

# N10: 同一 phi 行重复登记 → borrowed merge pair was recorded twice。
fn runVerdictBorrowedTwice(): int32 =
    var workspace: exactdefmerge.ExactDefMergeWorkspace
    exactdefmerge.ExactDefMergeTestBorrowedMergeAppend(
        workspace, 2, 1, 2, 1, 1, 4, 3, 4, 3, 3, 5)
    exactdefmerge.ExactDefMergeTestBorrowedMergeAppend(
        workspace, 2, 1, 2, 1, 1, 4, 3, 4, 3, 3, 5)
    return 1

# N-lift: 分支形 lift retain 形状破 (consume 戳 poke 为 0) → 全字段
# fprintf + borrowed phi lift ownership is invalid。
fn runVerdictLiftOwnership(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    liftTransport(originKinds, exactTypeIds)
    var body = buildLiftBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    pokeLiftLanes(body)
    body.ops[4].valueDefConsumeOpIndexPlusOne = 0
    if validateMergeOnly(body):
        return 1
    return 2

# N-promo: loop entry 借用臂 lift 形状破 → loop borrowed merge
# promotion state is invalid。
fn runVerdictLoopPromotion(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    loopLiftTransport(originKinds, exactTypeIds)
    var body = buildLoopLiftBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    pokeLoopLiftLanes(body)
    body.ops[4].valueDefConsumeOpIndexPlusOne = 0
    if validateMergeOnly(body):
        return 1
    return 2

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var mode = "unit"
    if cmdline.ParamCount() >= 1:
        mode = cmdline.ParamStr(1)
    if mode == "":
        mode = "unit"
    if mode == "unit":
        return runUnit()
    if mode == "verdict-mismatch":
        return runVerdictMismatch()
    if mode == "verdict-global-mismatch":
        return runVerdictGlobalMismatch()
    if mode == "verdict-global-sentinel-mixed-type":
        return runVerdictGlobalSentinelMixedType()
    if mode == "verdict-global-sentinel-origins":
        return runVerdictGlobalSentinelOrigins()
    if mode == "verdict-global-sentinel-place":
        return runVerdictGlobalSentinelPlace()
    if mode == "verdict-global-sentinel-ownership":
        return runVerdictGlobalSentinelOwnership()
    if mode == "verdict-global-sentinel-producer":
        return runVerdictGlobalSentinelProducer()
    if mode == "verdict-ownership":
        return runVerdictOwnership()
    if mode == "verdict-source-slots":
        return runVerdictSourceSlots()
    if mode == "verdict-storage":
        return runVerdictStorage()
    if mode == "verdict-edge-staging":
        return runVerdictEdgeStaging()
    if mode == "verdict-edge-staging-gap":
        return runVerdictEdgeStagingGap()
    if mode == "verdict-plan-drift":
        return runVerdictPlanDrift()
    if mode == "verdict-destination":
        return runVerdictDestination()
    if mode == "verdict-physical-source":
        return runVerdictPhysicalSource()
    if mode == "verdict-borrowed-roots":
        return runVerdictBorrowedRoots()
    if mode == "verdict-borrowed-twice":
        return runVerdictBorrowedTwice()
    if mode == "verdict-lift-ownership":
        return runVerdictLiftOwnership()
    if mode == "verdict-loop-promotion":
        return runVerdictLoopPromotion()
    os.WriteLine(os.Get_stdout(), Fmt"unknown mode: {mode}")
    return 2
