    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var body = buildBranchMergeBodyExact(baseKnobs())
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    body.ops[4].valueDefOwnership = coreir.OwnBorrowShared
    if validateMergeOnly(body):
