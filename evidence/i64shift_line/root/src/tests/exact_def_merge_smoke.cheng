# N5: input copy 非块末行 → edge staging failed。
fn runVerdictEdgeStaging(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var knobs = baseKnobs()
    knobs.trailingBareRow = true
    var body = buildBranchMergeBodyExact(knobs)
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validateComposed(body):
        return 1
    return 2

# N5b: merge 区间不连续 (双请求, 区间被普通 op 穿插) → edge
# staging failed。
fn buildTwoLocalGapBody(): coreir.BodyIR =
    var body: coreir.BodyIR
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(body, fixtureCid()),
                "merge smoke: TypeArena artifact bind")
    bindTypeFacts(body)
    let cond = addI32Slot(body, "cond")
    let armA = addStrSlot(body, "arm_a")
    let armB = addStrSlot(body, "arm_b")
    let staging = addStrSlot(body, "staging")
    let dst = addStrSlot(body, "merged")
    let armC = addStrSlot(body, "arm_c")
    let armD = addStrSlot(body, "arm_d")
    let staging2 = addStrSlot(body, "staging2")
    let dst2 = addStrSlot(body, "merged2")
    let o0 = newDefOp(
        body, coreir.BodyOpLoadConstTag, cond, 100, coreir.OwnPlain)
    add(body.ops[o0].operands, coreir.LocalI32Tag)
    let term0 = newCbrTerm(body, cond, 1, 3)
    let o1 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armA, 101, coreir.OwnMove)
    add(body.ops[o1].operands, coreir.LocalStrTag)
    let o1c = newDefOp(
        body, coreir.BodyOpLoadConstTag, armC, 102, coreir.OwnMove)
    add(body.ops[o1c].operands, coreir.LocalStrTag)
    let term1 = newBrTerm(body, 2)
    let o2 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 103, coreir.OwnMove)
    add(body.ops[o2].operands, armA)
    setOpSource(body, o2, o1)
    let o2c = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging2, 104, coreir.OwnMove)
    add(body.ops[o2c].operands, armC)
    setOpSource(body, o2c, o1c)
    let term1e = newBrTerm(body, 5)
    let o3 = newDefOp(
        body, coreir.BodyOpLoadConstTag, armB, 105, coreir.OwnMove)
    add(body.ops[o3].operands, coreir.LocalStrTag)
    let o3c = newDefOp(
        body, coreir.BodyOpLoadConstTag, armD, 106, coreir.OwnMove)
    add(body.ops[o3c].operands, coreir.LocalStrTag)
    let term2 = newBrTerm(body, 4)
    let o4 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging, 107, coreir.OwnMove)
    add(body.ops[o4].operands, armB)
    setOpSource(body, o4, o3)
    let o4c = newDefOp(
        body, coreir.BodyOpCopyLocalTag, staging2, 108, coreir.OwnMove)
    add(body.ops[o4c].operands, armD)
    setOpSource(body, o4c, o3c)
    let term2e = newBrTerm(body, 5)
    # join: merge1, 裸行穿插, merge2 → 区间不连续。
    let o5 = newDefOp(
        body, coreir.BodyOpCopyLocalTag, dst, 109, coreir.OwnMove)
    add(body.ops[o5].operands, staging)
    setOpSource(body, o5, o2)
    let _ = newBareOp(body, coreir.BodyOpStoreLocalTag, cond)
    let o5b = newDefOp(
        body, coreir.BodyOpCopyLocalTag, dst2, 110, coreir.OwnMove)
    add(body.ops[o5b].operands, staging2)
    setOpSource(body, o5b, o2c)
    let term3 = newRetTerm(body, dst, o5)
    let _ = appendBlock(body, 0, 1, term0)     # b0
    let _ = appendBlock(body, 1, 2, term1)     # b1
    let _ = appendBlock(body, 3, 2, term1e)    # b1e (input1a/input1b)
    let _ = appendBlock(body, 5, 2, term2)     # b2
    let _ = appendBlock(body, 7, 2, term2e)    # b2e (input2a/input2b)
    let _ = appendBlock(body, 9, 3, term3)     # b3 (join)
    beginControl(body, 6)
    var succ0: int32[]
    add(succ0, 1)
    add(succ0, 3)
    var kind0: int32[]
    add(kind0, coreir.BodyControlEdgeNormal)
    add(kind0, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term0, succ0, kind0)
    var succ1: int32[]
    add(succ1, 2)
    var kind1: int32[]
    add(kind1, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1, succ1, kind1)
    var succ1e: int32[]
    add(succ1e, 5)
    var kind1e: int32[]
    add(kind1e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term1e, succ1e, kind1e)
    var succ2: int32[]
    add(succ2, 4)
    var kind2: int32[]
    add(kind2, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2, succ2, kind2)
    var succ2e: int32[]
    add(succ2e, 5)
    var kind2e: int32[]
    add(kind2e, coreir.BodyControlEdgeNormal)
    bindSuccessors(body, term2e, succ2e, kind2e)
    var succ3: int32[]
    var kind3: int32[]
    bindSuccessors(body, term3, succ3, kind3)
    sealControlFlow(body)
    return body

fn twoLocalGapTransport(originKinds: var int32[],
                        exactTypeIds: var int32[]) =
    for index in 0..<11:
        if index == 0:
            add(originKinds, 4)
        elif index == 1 || index == 2 || index == 5 || index == 6:
            add(originKinds, 4)
        else:
            add(originKinds, 2)
    add(exactTypeIds, fixtureTypeI32)
    for index in 0..<10:
        add(exactTypeIds, fixtureTypeStr)

fn runVerdictEdgeStagingGap(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    twoLocalGapTransport(originKinds, exactTypeIds)
    var body = buildTwoLocalGapBody()
    deriveFixture(body, originKinds, exactTypeIds, buildWindow())
    if validateComposed(body):
        return 1
    return 2

# N6: owned 计划输入 own 借用 (poke) → plan ownership drifted。
fn runVerdictPlanDrift(): int32 =
