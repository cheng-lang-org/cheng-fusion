# N8: merge 行 readA 戳非自环 (poke) → ([sdbg]) + physical source
# set is invalid。
fn runVerdictPhysicalSource(): int32 =
    var originKinds: int32[]
    var exactTypeIds: int32[]
    branchTransport(originKinds, exactTypeIds, fixtureTypeStr)
    var body = buildBranchMergeBodyExact(baseKnobs())
