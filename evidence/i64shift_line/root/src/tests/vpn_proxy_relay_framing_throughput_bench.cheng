# Self-contained end-to-end relay-framing CPU throughput harness.
#
# Drives the REAL send/recv hot-path functions with no sockets, so the number is a
# pure-CPU throughput (the loopback CPU ceiling the framing workflow described: RTT~0,
# window never the limit, so MB/s here == relay CPU cost per byte). Exercises exactly
# the framing levers:
#   - rank1  VpnProxyTcpTlsForwardBuildDataFrameInto  (DATA frame build)
#   - record VpnProxyTcpTlsRecordEncryptInto/DecryptInto (AEAD seal/open + framing)
#   - rank2  VpnProxyBytesAppend into pendingWrite      (the O(n^2) write-queue concat)
# Each batch queues BatchFrames frames before draining, matching the relay's
# write high-water (~262144 B ~= 17 x 15KB frames) so the rank2 O(n^2) is exposed.
import std/result
import std/rawbytes
import std/strings as strutil
import std/monotimes as mono
import cheng/apps/vpn_proxy/transport_tcp_tls_record as tlsrec
import cheng/apps/vpn_proxy/transport_tcp_tls_forward as ttf
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn

const
    PayloadLen = 15360
    TotalMiB = 48
    BatchFrames = 16
    CipherChacha = 3

fn fillSeq(b: Bytes) =
    for i in 0..<BytesLen(b):
        BytesSet(b, i, i & 255)

fn recordTotalLen(buf: Bytes, offset: int32): int32 =
    # TLS record = 5-byte header; bytes 3..4 are the big-endian ciphertext+tag length.
    let hi: int32 = BytesGet(buf, offset + 3) & 255
    let lo: int32 = BytesGet(buf, offset + 4) & 255
    return 5 + ((hi << 8) | lo)

fn main(): int32 =
    let key: Bytes = BytesAlloc(32)
    fillSeq(key)
    let iv: Bytes = BytesAlloc(12)
    fillSeq(iv)
    var sendKeys: tlsrec.VpnProxyTcpTlsRecordKeys
    let skRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordInitKeysForCipherCodeInto(CipherChacha, key, iv, sendKeys)
    if IsErr(skRes):
        echo(ErrorText(skRes))
        return 1
    var recvKeys: tlsrec.VpnProxyTcpTlsRecordKeys
    let rkRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordInitKeysForCipherCodeInto(CipherChacha, key, iv, recvKeys)
    if IsErr(rkRes):
        echo(ErrorText(rkRes))
        return 1

    let payload: Bytes = BytesAlloc(PayloadLen)
    fillSeq(payload)
    let appType: int32 = tlsrec.VpnProxyTcpTlsRecordContentTypeApplicationData()

    let totalBytes: int64 = int64(TotalMiB) * int64(1048576)
    var sent: int64 = 0
    var recvBytes: int64 = 0
    var sid: int32 = 1

    let start: mono.MonoTime = mono.GetMonoTime()
    while sent < totalBytes:
        var pendingWrite: Bytes = vpn.VpnProxyEmptyBytes()
        var f: int32
        while f < BatchFrames:
            var frameWire: Bytes
            let bRes: int32 = ttf.VpnProxyTcpTlsForwardBuildDataFrameInto(sid, payload, frameWire)
            if bRes <= 0:
                echo("frame build failed")
                return 1
            var record: Bytes
            let eRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordEncryptInto(sendKeys, appType, frameWire, record)
            if IsErr(eRes):
                echo(ErrorText(eRes))
                return 1
            pendingWrite = vpn.VpnProxyBytesConcat(pendingWrite, record)
            BytesFree(frameWire)
            BytesFree(record)
            sent = sent + int64(PayloadLen)
            f = f + 1
        # Drain: parse each record back out and decrypt (recv hot path).
        var offset: int32
        let total: int32 = BytesLen(pendingWrite)
        while offset < total:
            let recLen: int32 = recordTotalLen(pendingWrite, offset)
            let record: Bytes = BytesSlice(pendingWrite, offset, recLen)
            var plain: tlsrec.VpnProxyTcpTlsRecordPlain
            let dRes: Result[bool] = tlsrec.VpnProxyTcpTlsRecordDecryptInto(recvKeys, record, plain)
            if IsErr(dRes):
                echo(ErrorText(dRes))
                return 1
            recvBytes = recvBytes + int64(BytesLen(plain.payload))
            BytesFree(plain.payload)
            BytesFree(record)
            offset = offset + recLen
        BytesFree(pendingWrite)

    let endT: mono.MonoTime = mono.GetMonoTime()
    let ns: int64 = mono.MonoTimeNs(endT) - mono.MonoTimeNs(start)
    var mibps: int64
    if ns > int64(0):
        mibps = (sent * int64(1000000000) / int64(1048576)) / ns
    echo(strutil.Join(["relay_framing_roundtrip cipher=chacha20poly1305",
                       " payload=", strutil.IntToStr(PayloadLen),
                       " batch=", strutil.IntToStr(BatchFrames),
                       " sent_mib=", strutil.Int64ToStr(sent / int64(1048576)),
                       " recv_mib=", strutil.Int64ToStr(recvBytes / int64(1048576)),
                       " total_ms=", strutil.Int64ToStr(ns / int64(1000000)),
                       " throughput_mibps=", strutil.Int64ToStr(mibps)], ""))
    return 0
