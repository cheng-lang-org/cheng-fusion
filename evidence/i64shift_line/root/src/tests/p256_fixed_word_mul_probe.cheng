import std/system
import std/crypto/p256_fixed as pfix

fn lowWord(v: uint64): uint64 =
    return v - ((v >> uint64(32)) << uint64(32))

fn main(argc: int32, argv: ptr): int32 =
    argc
    argv
    let wordBase: uint64 = uint64(1) << uint64(32)
    let maxWord: uint64 = wordBase - uint64(1)
    let maxLimb: int32 = int32(uint32(0xffffffff))
    let maxFromLimb: uint64 = pfix.P256FixedWordToBitsU64(maxLimb)
    assert(maxFromLimb == maxWord, "p256_fixed_word_mul_probe: max limb")

    let prod: pfix.P256FixedMulWordProduct = pfix.p256FixedMulWord32(maxFromLimb, maxFromLimb)
    assert(prod.loWord == uint64(1), "p256_fixed_word_mul_probe: max mul lo")
    assert(prod.hiWord == wordBase - uint64(2), "p256_fixed_word_mul_probe: max mul hi")

    let nearMax: uint64 = wordBase - uint64(2)
    let prod2: pfix.P256FixedMulWordProduct = pfix.p256FixedMulWord32(nearMax, maxWord)
    assert(prod2.loWord == uint64(2), "p256_fixed_word_mul_probe: near max mul lo")
    assert(prod2.hiWord == wordBase - uint64(3), "p256_fixed_word_mul_probe: near max mul hi")

    echo(" p256_fixed_word_mul_probe ok")
    return 0
