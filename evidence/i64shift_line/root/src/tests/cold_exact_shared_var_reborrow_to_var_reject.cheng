fn ColdExactSharedVarRejectSet(value: var str) =
    value = "invalid"

fn ColdExactSharedVarRejectRun(source: var str): int32 =
    let borrowed = source
    var alias = borrowed
    ColdExactSharedVarRejectSet(alias)
    return 0

fn main(): int32 =
    var owner = "owner"
    return ColdExactSharedVarRejectRun(owner)
