import std/json
import std/os

fn main() =
    var root =
        json.jsonObjectLit([
            json.jsonField(
                "child",
                json.jsonObjectLit([
                    json.jsonField("name", "alpha"),
                    json.jsonField(
                        "nested",
                        json.jsonObjectLit([
                            json.jsonField("name", "inner")])),
                    json.jsonField(
                        "items",
                        json.jsonArrayLit([
                            json.jsonObjectLit([
                                json.jsonField(
                                    "deep", "value")])]))]))])
    var child = json.JsonGetField(root, "child")
    root = json.NewJNull()

    var firstNested = json.JsonGetField(child, "nested")
    firstNested.ovalues[0] = json.NewJString("mutated")
    var secondNested = json.JsonGetField(child, "nested")
    var firstNameNode = json.JsonGetField(firstNested, "name")
    var secondNameNode = json.JsonGetField(secondNested, "name")
    let firstName = json.GetStr(firstNameNode)
    let secondName = json.GetStr(secondNameNode)
    firstNameNode = json.NewJNull()
    secondNameNode = json.NewJNull()
    assert(firstName == "mutated" && secondName == "inner",
           "json owned value: repeated field query shared child owner")

    var missing = json.JsonGetField(child, "missing")
    assert(missing.kind == json.JNull,
           "json owned value: missing field is not JNull")

    var items = json.JsonGetField(child, "items")
    assert(items.kind == json.JArray && items.a.len == 1,
           "json owned value: nested array shape")
    var deepNode = json.JsonGetField(items.a[0], "deep")
    items = json.NewJNull()
    let deep = json.GetStr(deepNode)
    deepNode = json.NewJNull()
    assert(deep == "value",
           "json owned value: nested array child did not own storage")

    var tryName: str
    assert(json.JsonTryGetStr(child, "name", tryName),
           "json owned value: TryGetStr failed")
    var nameNode = json.JsonGetField(child, "name")
    let directName = json.GetStr(nameNode)
    nameNode = json.NewJNull()
    child = json.NewJNull()
    assert(tryName == "alpha" && directName == "alpha" &&
           firstName == "mutated" && secondName == "inner" &&
           deep == "value",
           "json owned value: parent release invalidated child")

    os.WriteLine(
        os.Get_stdout(),
        "json_owned_value_semantics_smoke: ok")
