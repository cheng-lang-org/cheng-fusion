# 纯 Cheng RSI 递归端到端冒烟 (提案 §5 步7 独立验收文件)。
# 判定 (全部真实断言, 全过即静默 rc=0; 任一项不过即 assert 失败):
#   1) CLI 用冻结载具真编译 rc=0 (argv 直排, 无 shell);
#   2) 三轮真实 run rc=0: 轮1 = M0 后继 A 准入 (meta 拒); 轮2 = 平分拒 +
#      一次前瞻 meta_accepted 收下 M1; 轮3 = 换上的 M1 真实产生后继并被
#      编译运行评价, 走到该轮版本判词 —— 这就是 M0->M1->后继消费链;
#   3) 事件链: meta_accepted 在位; meta 之前轮1 有 version_accepted;
#      meta 之后有 trial_evaluated 与该轮版本判词 (非自报, 是账本行);
#   4) verify 腿 rc=0 (哈希链 + CSG 重放 + 在位版本对拍);
#   5) 在位版本严格 v3 可读, 代数 >= 2, 改进器策略 >= 1 (M1 真在位);
#      CSG 图含 meta 版本事实且其后仍有候选事实, 重放 rc 通过;
#   6) 私产全清 (账本文件 + CLI 产物 + 目录), 不留跨任务残留。
# 调用口径: run 用 max-generations=3 / max-candidates=4 / meta=1 ——
# v4 31 格空间实测 meta 窗 (gate 判词 55 附注): C=4 在 G2 出 meta_accepted,
# C=3/C=6 该轨迹平分拒; 换上新 M1 的后继消费发生在 meta 之后的轮 (故 G=3)。
# 这不是调参凑绿: 窗口由门禁实测给定, 断言只查消费链是否真实走通。
# 用法: rsi_recursive_e2e [--root <repoRoot>] [--compiler <path>]
#       缺省 root = cwd, compiler = <root>/artifacts/bootstrap/cheng.stage3。
# 失败时保留 <root>/artifacts/rsi_e2e_<pid>/ 作诊断证据; 通过即清。
# C 车头坑规避: var-out 函数无返回值; 外呼一律 Fmt 拷贝; argv 字面量直排。
import std/cmdline as cmdline
import std/os as os
import std/strings as strings
import std/strutils as strutil
import cheng/rsi/types as types
import cheng/rsi/store as store
import cheng/rsi/csg_layer as csg
import cheng/rsi/compiler as compiler
import cheng/rsi/execution as execution

# needle 在 hay 中 from 起的首次下标; 未命中 = -1 (手扫: Split 后只做索引
# 扫描 + CloneStrRange 切片, 见 store 行级解析纪律)。
fn e2eIndexOfFrom(hay: str, needle: str, from: int32): int32 =
    let n = len(hay)
    let m = len(needle)
    if n <= 0 || m <= 0 || from < 0:
        return -1
    var i = from
    while i + m <= n:
        let slice = strings.CloneStrRange(Fmt"{hay}", i, m)
        if slice == needle:
            return i
        i = i + 1
    return -1

# 删目录内直接子文件后 rmdir (不信任吞错误的删除返回值: 只删文件, 目录
# 清空由调用点的 DirExists 复查兜底)。
fn e2eClearDir(dir: str) =
    let listing = os.ListDir(Fmt"{dir}")
    for i in 0..<listing.len:
        let entry = Fmt"{listing[i]}"
        let name = Fmt"{os.ExtractFilename(entry)}"
        if len(name) <= 0 || name == "." || name == "..":
            continue
        let path = strutil.Join([Fmt"{dir}", Fmt"{name}"], "/")
        let _rm = os.RemoveFile(Fmt"{path}")
    os.RemoveDir(Fmt"{dir}")

fn main(): int32 =
    var rootArg: str
    let rootGiven = cmdline.readFlagValue("--root", rootArg)
    var root: str
    if rootGiven && len(rootArg) > 0:
        root = strings.CloneStr(Fmt"{rootArg}")
    else:
        root = os.GetCurrentDir()
    var compArg: str
    let compGiven = cmdline.readFlagValue("--compiler", compArg)
    let rootOk = os.DirExists(Fmt"{root}")
    assert(rootOk, "rsi e2e: repo root must exist")
    var compilerPath: str
    if compGiven && len(compArg) > 0:
        compilerPath = strings.CloneStr(Fmt"{compArg}")
    else:
        compilerPath = strutil.Join([Fmt"{root}",
                                     "artifacts/bootstrap/cheng.stage3"], "/")
    assert(os.FileExists(Fmt"{compilerPath}"), "rsi e2e: frozen carrier must exist")

    # 私有场地 (pid 唯一), 不触碰 artifacts/rsi 生产谱系与他线私账。
    let pidText = strings.IntToStr(os.ProcessId())
    let scratchRoot = strutil.Join([Fmt"{root}",
                                    Fmt"artifacts/rsi_e2e_{pidText}"], "/")
    let storeDir = strutil.Join([Fmt"{scratchRoot}", "store"], "/")
    let cliBin = strutil.Join([Fmt"{scratchRoot}", "rsi_cli"], "/")
    let cliSrc = strutil.Join([Fmt"{root}", "src/apps/rsi/main.cheng"], "/")
    os.MkdirAll(Fmt"{storeDir}", 493)
    assert(os.DirExists(Fmt"{storeDir}"), "rsi e2e: private store dir created")

    # 1) CLI 真编译 (冻结载具; 与 rsi_gate 同 flags)。
    let crc = compiler.RsiCompileCheng(Fmt"{compilerPath}", Fmt"{root}",
                                       Fmt"{cliSrc}", Fmt"{cliBin}", 900,
                                       ["CHENG_ENTRY_CACHE=0",
                                        "CHENG_NO_CACHE=1",
                                        "CHENG_STRICT_NO_CACHE=1"])
    assert(crc == 0, "rsi e2e: CLI compile rc must be 0")
    assert(os.FileExists(Fmt"{cliBin}"), "rsi e2e: CLI binary present")

    # 2) 两轮真实 run (改进器与候选都是真编译真运行的独立进程)。
    var runOut: str
    var runRc: int32 = 0
    execution.RsiRunCapture(Fmt"{cliBin}",
        ["run",
         Fmt"--root:{root}",
         Fmt"--compiler:{compilerPath}",
         Fmt"--store-dir:{storeDir}",
         "--max-generations:3",
         "--max-candidates:4",
         "--meta:1"], [], Fmt"{root}", 3600, runOut, runRc)
    assert(runRc == 0, "rsi e2e: three-round run rc must be 0")

    # 3) 事件链: 轮1 M0 后继准入 -> meta_accepted (M0->M1) -> meta 之后
    #    M1 后继被真编译运行评价并走到该轮版本判词。
    let eventsPath = strutil.Join([Fmt"{storeDir}", "events.log"], "/")
    let eventsText = os.ReadFile(Fmt"{eventsPath}")
    let evLen = len(eventsText)
    assert(evLen > 0, "rsi e2e: events log written")
    let metaIdx = e2eIndexOfFrom(Fmt"{eventsText}", "event=meta_accepted", 0)
    assert(metaIdx >= 0, "rsi e2e: one-step lookahead accepted M0->M1")
    # 3b) 前瞻预算配对账本接线 (批次九): meta_accepted 行必须带两臂开销与
    #     子预算。本轨迹无 LLM 提案源且 --max-candidates:4, 故两臂各 =
    #     1 次改进器 + 4 次后继候选 = 5 (同起点同预算对照的真实回执;
    #     账本不全时该事件不可能出现 —— 对照无效一律拒收)。
    let metaLineEnd = e2eIndexOfFrom(Fmt"{eventsText}", "\n", metaIdx)
    assert(metaLineEnd > metaIdx, "rsi e2e: meta_accepted line terminated")
    let metaLine = strings.CloneStrRange(Fmt"{eventsText}", metaIdx,
                                         metaLineEnd - metaIdx)
    assert(e2eIndexOfFrom(Fmt"{metaLine}", "per_arm_units=5 ", 0) > 0, "rsi e2e: meta receipt records per-arm sub-budget 5")
    assert(e2eIndexOfFrom(Fmt"{metaLine}", "parent_units=5 ", 0) > 0, "rsi e2e: meta receipt charges parent arm 5")
    assert(e2eIndexOfFrom(Fmt"{metaLine}", "candidate_units=5", 0) > 0, "rsi e2e: meta receipt charges look-ahead arm 5")
    let preAcc = e2eIndexOfFrom(Fmt"{eventsText}", "event=version_accepted", 0)
    assert(preAcc >= 0 && preAcc < metaIdx, "rsi e2e: M0 successor accepted before meta swap")
    let postTrial = e2eIndexOfFrom(Fmt"{eventsText}", "event=trial_evaluated",
                                   metaIdx + 1)
    assert(postTrial > metaIdx, "rsi e2e: post-meta round really evaluated M1 successors")
    let postAcc = e2eIndexOfFrom(Fmt"{eventsText}", "event=version_accepted",
                                 metaIdx + 1)
    let postRej = e2eIndexOfFrom(Fmt"{eventsText}", "event=version_rejected",
                                 metaIdx + 1)
    let hasPostVerdict = (postAcc > metaIdx) || (postRej > metaIdx)
    assert(hasPostVerdict, "rsi e2e: post-meta round reached a version verdict")

    # 4) verify 腿: 哈希链 + CSG 重放 + current.txt 对拍。
    var verifyOut: str
    var verifyRc: int32 = 0
    execution.RsiRunCapture(Fmt"{cliBin}",
                            ["verify",
                             Fmt"--root:{root}",
                             Fmt"--store-dir:{storeDir}"], [], Fmt"{root}",
                            120, verifyOut, verifyRc)
    assert(verifyRc == 0, "rsi e2e: verify leg rc must be 0")

    # 5) 在位版本 + 事实图: M1 真在位, 其后继真入图。
    var vOk: int32 = 0
    var vGen: int32 = 0
    var vM: int32 = 0
    var vD0S: int32 = 0
    var vD0P: int32 = 0
    var vD0Sc: int64 = 0
    var vD1S: int32 = 0
    var vD1P: int32 = 0
    var vD1Sc: int64 = 0
    var vD2S: int32 = 0
    var vD2P: int32 = 0
    var vD2Sc: int64 = 0
    var vScore: int64 = 0
    var vFactsRoot: str
    store.RsiStoreLoadVersionDualInto(Fmt"{storeDir}", vOk, vGen, vM, vD0S,
                                      vD0P, vD0Sc, vD1S, vD1P, vD1Sc, vD2S,
                                      vD2P, vD2Sc, vScore, vFactsRoot)
    assert(vOk == 1, "rsi e2e: incumbent version is strict v3 readable")
    assert(vGen >= 2, "rsi e2e: at least two accepted generations")
    assert(vM >= 1, "rsi e2e: improver generation advanced (M1 in place)")
    let factsPath = strutil.Join([Fmt"{storeDir}", "rsi.facts.jsonl"], "/")
    let factsText = os.ReadFile(Fmt"{factsPath}")
    let metaFact = e2eIndexOfFrom(Fmt"{factsText}", "\"change\":\"meta\"", 0)
    assert(metaFact >= 0, "rsi e2e: meta version fact present in csg graph")
    let postCand = e2eIndexOfFrom(Fmt"{factsText}",
                                  "\"kind\":\"csg.rsi.candidate\"",
                                  metaFact + 1)
    assert(postCand > metaFact, "rsi e2e: post-meta candidate facts in csg graph")
    var replayOk: int32 = 0
    var replayGen: int32 = 0
    var replayScore: int64 = 0
    var replayRoot: str
    csg.RsiCsgReplayInto(Fmt"{factsPath}", replayOk, replayGen, replayScore,
                         replayRoot)
    assert(replayOk == 1 && replayGen >= 2, "rsi e2e: csg replay accepts chain")

    # 6) 清场: 私产 (账本/CLI/目录) 全清并复查。
    let _c1 = os.RemoveFile(Fmt"{eventsPath}")
    let _c2 = os.RemoveFile(Fmt"{factsPath}")
    let _c3 = os.RemoveFile(Fmt"{storeDir}/current.txt")
    let _c4 = os.RemoveFile(Fmt"{storeDir}/current.txt.tmp")
    let _c5 = os.RemoveFile(Fmt"{cliBin}")
    e2eClearDir(Fmt"{storeDir}")
    e2eClearDir(Fmt"{scratchRoot}")
    let scratchGone = !os.DirExists(Fmt"{scratchRoot}")
    assert(scratchGone, "rsi e2e: private scratch removed")

    return 0
