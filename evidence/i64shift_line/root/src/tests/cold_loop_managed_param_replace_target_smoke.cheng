import std/strings

@borrows
fn writeStep(error: var str): bool =
    error = strings.CloneStr("step")
    return true

@borrows
fn runLoop(error: var str): bool =
    for i in 0..<2:
        if i == 1:
            error = "boom"
            return false
        if !writeStep(error):
            return false
    return true

@borrows
fn runVersionLoop(error: var str): bool =
    for i in 0..<2:
        if !writeStep(error):
            return false
        if i == 1:
            error = "boom"
            return false
    return true

fn main(): int32 =
    var directError: str
    if runLoop(directError):
        return 1
    if directError != "boom":
        return 2
    var versionError: str
    if runVersionLoop(versionError):
        return 3
    return versionError == "boom" ? 0 : 4
