type
    ColdRefObjectBorrowReadCell =
        value: int32

    ColdRefObjectBorrowReadInner = ref object
        cell: ColdRefObjectBorrowReadCell

    ColdRefObjectBorrowReadOuter = ref object
        inner: ColdRefObjectBorrowReadInner

fn ColdRefObjectBorrowReadWrite(
        cell: var ColdRefObjectBorrowReadCell) =
    cell.value = 83

fn ColdRefObjectBorrowReadMutate(
        out: var ColdRefObjectBorrowReadOuter) =
    var inner = out.inner
    let forbiddenRead = out.inner.cell.value
    ColdRefObjectBorrowReadWrite(inner.cell)
    if forbiddenRead == 0:
        return

fn main(): int32 =
    var out = new(ColdRefObjectBorrowReadOuter)
    out.inner = new(ColdRefObjectBorrowReadInner)
    ColdRefObjectBorrowReadMutate(out)
    return 0
