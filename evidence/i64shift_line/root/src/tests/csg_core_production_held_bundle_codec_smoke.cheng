import std/os
import std/strings
import cheng/core/runtime/production_held_exec_provider as provider

const
    cid1: str =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    cid2: str =
        "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    cid5: str =
        "sha256:5555555555555555555555555555555555555555555555555555555555555555"
    cid6: str =
        "sha256:6666666666666666666666666666666666666666666666666666666666666666"
    cid7: str =
        "sha256:7777777777777777777777777777777777777777777777777777777777777777"
    cid8: str =
        "sha256:8888888888888888888888888888888888888888888888888888888888888888"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn validPreExecInput(): provider.CsgCoreProductionPreExecInput =
    var out: provider.CsgCoreProductionPreExecInput
    out.schemaVersion =
        provider.CsgCoreProductionPreExecInputSchemaVersion
    out.semanticCommand =
        provider.CsgCoreProductionPreExecInputCommandSystemLinkExec
    out.packageSourceRootIdentityCid = cid1
    out.canonicalModulePath = "app/main"
    out.outputRole =
        provider.CsgCoreProductionPreExecInputOutputBuildArtifact
    out.targetTriple = "x86_64-unknown-linux-gnu"
    out.emitKind = provider.CsgCoreProductionPreExecInputEmitExe
    out.reportRole = provider.CsgCoreProductionPreExecInputReportExactFunction
    out.symbolVisibility =
        provider.CsgCoreProductionPreExecInputVisibilityPublic
    out.browserBridgeObjectCid = cid2
    add(out.exportRootSymbols, "Main")
    add(out.exportRootSymbols, "ChengEntry")
    add(out.providerObjectCids, cid5)
    add(out.providerObjectCids, cid6)
    out.runtimeProviderBundleCid = cid7
    out.compileMode =
        provider.CsgCoreProductionPreExecInputCompileModeProduction
    out.backendKind = provider.CsgCoreProductionPreExecInputBackendPrimary
    out.jobCount = 4
    out.exactFunctionRequest.canonicalModulePath = "app/main"
    out.exactFunctionRequest.symbolSelector = "Main"
    out.compilerRequestCid = cid8
    return out

fn main(): int32 =
    let input = validPreExecInput()
    var envelope: str
    var envelopeCid: str
    var err: str
    if !provider.CsgCoreProductionPreExecInputEncodeInto(
           input, envelope, envelopeCid, err):
        return fail(strings.ConcatStr("typed encode failed: ", err))
    if envelope.len <= 17 * 12 || envelopeCid.len != 71:
        return fail("typed envelope identity missing")
    var decoded: provider.CsgCoreProductionPreExecInput
    var decodedCid: str
    if !provider.CsgCoreProductionPreExecInputDecodeStrictInto(
           envelope, decoded, decodedCid, err):
        return fail(strings.ConcatStr("typed decode failed: ", err))
    if decodedCid != envelopeCid ||
       decoded.schemaVersion != input.schemaVersion ||
       decoded.semanticCommand != input.semanticCommand ||
       decoded.packageSourceRootIdentityCid !=
           input.packageSourceRootIdentityCid ||
       decoded.canonicalModulePath != input.canonicalModulePath ||
       decoded.outputRole != input.outputRole ||
       decoded.targetTriple != input.targetTriple ||
       decoded.emitKind != input.emitKind ||
       decoded.reportRole != input.reportRole ||
       decoded.symbolVisibility != input.symbolVisibility ||
       decoded.browserBridgeObjectCid != input.browserBridgeObjectCid ||
       decoded.exportRootSymbols != input.exportRootSymbols ||
       decoded.providerObjectCids != input.providerObjectCids ||
       decoded.runtimeProviderBundleCid != input.runtimeProviderBundleCid ||
       decoded.compilerRequestCid != input.compilerRequestCid ||
       decoded.compileMode != input.compileMode ||
       decoded.backendKind != input.backendKind ||
       decoded.jobCount != input.jobCount ||
       decoded.exactFunctionRequest.canonicalModulePath !=
           input.exactFunctionRequest.canonicalModulePath ||
       decoded.exactFunctionRequest.symbolSelector !=
           input.exactFunctionRequest.symbolSelector:
        return fail("typed field bytes drifted")
    var reencoded: str
    var reencodedCid: str
    if !provider.CsgCoreProductionPreExecInputEncodeInto(
           decoded, reencoded, reencodedCid, err) ||
       reencoded != envelope || reencodedCid != envelopeCid:
        return fail("typed re-encode is not byte canonical")

    # Cargo 1 begins after the outer u32 tag + u64 length. Replacing only its
    # repeated schema-version must be rejected by the public typed decoder.
    let wrongVersion = strings.ConcatStr(
        strings.SliceBytes(envelope, 0, 12),
        strings.ConcatStr(
            "\x03\x00\x00\x00",
            strings.SliceBytes(envelope, 16, envelope.len - 16)))
    if provider.CsgCoreProductionPreExecInputDecodeStrictInto(
           wrongVersion, decoded, decodedCid, err):
        return fail("wrong typed cargo schema version decoded")

    var invalid = validPreExecInput()
    invalid.canonicalModulePath = "/host/private/main.cheng"
    if provider.CsgCoreProductionPreExecInputEncodeInto(
           invalid, reencoded, reencodedCid, err):
        return fail("host path entered portable module identity")
    invalid = validPreExecInput()
    invalid.targetTriple = "X86_64-unknown-linux-gnu"
    if provider.CsgCoreProductionPreExecInputEncodeInto(
           invalid, reencoded, reencodedCid, err):
        return fail("noncanonical target triple encoded")
    invalid = validPreExecInput()
    invalid.jobCount = 0
    if provider.CsgCoreProductionPreExecInputEncodeInto(
           invalid, reencoded, reencodedCid, err):
        return fail("zero job count encoded")
    invalid = validPreExecInput()
    invalid.reportRole = provider.CsgCoreProductionPreExecInputReportCompile
    if provider.CsgCoreProductionPreExecInputEncodeInto(
           invalid, reencoded, reencodedCid, err):
        return fail("exact declaration escaped non-exact report role")

    var absent = validPreExecInput()
    absent.reportRole = provider.CsgCoreProductionPreExecInputReportAbsent
    absent.browserBridgeObjectCid = ""
    absent.runtimeProviderBundleCid = ""
    absent.exactFunctionRequest =
        provider.CsgCoreProductionPreExecExactFunctionRequest()
    if !provider.CsgCoreProductionPreExecInputEncodeInto(
           absent, reencoded, reencodedCid, err) ||
       !provider.CsgCoreProductionPreExecInputDecodeStrictInto(
           reencoded, decoded, decodedCid, err) ||
       decoded.browserBridgeObjectCid.len != 0 ||
       decoded.runtimeProviderBundleCid.len != 0 ||
       decoded.exactFunctionRequest.canonicalModulePath.len != 0 ||
       decoded.exactFunctionRequest.symbolSelector.len != 0:
        return fail("explicit optional absence drifted")

    os.WriteLine(
        os.Get_stdout(),
        "csg_core_production_pre_exec_input_codec_smoke ok")
    return 0
