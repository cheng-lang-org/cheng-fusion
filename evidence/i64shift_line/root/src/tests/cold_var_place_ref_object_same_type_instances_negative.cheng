type
    ColdVarPlaceInstanceCell =
        value: int32

    ColdVarPlaceInstanceInner = ref object
        cell: ColdVarPlaceInstanceCell

    ColdVarPlaceInstanceOuter = ref object
        first: ColdVarPlaceInstanceInner
        second: ColdVarPlaceInstanceInner

fn ColdVarPlaceInstanceWrite(
        first: var ColdVarPlaceInstanceCell,
        second: var ColdVarPlaceInstanceCell) =
    first.value = 61
    second.value = 67

fn ColdVarPlaceInstanceMutate(
        out: var ColdVarPlaceInstanceOuter) =
    var first = out.first
    var second = out.second
    ColdVarPlaceInstanceWrite(
        first.cell,
        second.cell)

fn main(): int32 =
    var out = new(ColdVarPlaceInstanceOuter)
    out.first = new(ColdVarPlaceInstanceInner)
    out.second = new(ColdVarPlaceInstanceInner)
    ColdVarPlaceInstanceMutate(out)
    return 0
