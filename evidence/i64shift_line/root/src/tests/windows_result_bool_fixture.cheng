import std/strutils as strutil
import std/result

type
    FakeAddr =
        data0: int64
        data1: int64
        lenv: int32
        family: int32
        isV6: bool
        host: str
        port: int32
    FakeHandle =
        fd: int32
        addr: FakeAddr

fn innerOpenStream(isV6: bool): Result[int32] =
    if !isV6:
        return Ok[int32](44)
    return Err[int32]("ipv6 path taken")

fn fakeListen(host: str, port: int32, isV6: bool = false): Result[FakeHandle] =
    let openRes: Result[int32] = innerOpenStream(isV6)
    if IsErr(openRes):
        return Err[FakeHandle](Error(openRes))
    var out: FakeHandle
    out.fd = Value(openRes)
    out.addr.port = port
    out.addr.host = host
    return Ok[FakeHandle](out)

fn FakeListenPublic(host: str, port: int32, isV6: bool = false): Result[FakeHandle] =
    return fakeListen(host, port, isV6)

fn main(): int32 =
    let r: Result[FakeHandle] = FakeListenPublic("127.0.0.1", 0, false)
    if IsErr(r):
        puts(strutil.Join(["FakeListen(false) ERR=", ErrorText(r)], ""))
    else:
        puts(strutil.Join(["FakeListen(false) ok fd=", IntToStr(Value(r).fd)], ""))
    let r6: Result[FakeHandle] = FakeListenPublic("::1", 0, true)
    if IsErr(r6):
        puts(strutil.Join(["FakeListen(true) ERR=", ErrorText(r6)], ""))
    else:
        puts(strutil.Join(["FakeListen(true) ok fd=", IntToStr(Value(r6).fd)], ""))
    return 0
