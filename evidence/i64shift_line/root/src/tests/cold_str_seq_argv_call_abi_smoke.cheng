import std/cmdline as cmdline

fn CollectArgvForStrSeqAbiSmoke(startIndex: int32,
                                 count: int32): str[] =
    var out: str[]
    if startIndex > count:
        return out
    for i in startIndex..count:
        add(out, cmdline.ParamStr(i))
    return out

fn PickArgvForStrSeqAbiSmoke(args: str[],
                              index: int32): str =
    if index < 0 || index >= args.len:
        return "<missing>"
    return args[index]

fn main(argc: int32, argv: str*): int32 =
    argc
    argv
    cmdline.CaptureCmdLine(argc, argv)
    let args = CollectArgvForStrSeqAbiSmoke(1, cmdline.ParamCount() - 1)
    if args.len != 3:
        return 10
    if PickArgvForStrSeqAbiSmoke(args, 0) != "alpha":
        return 11
    if PickArgvForStrSeqAbiSmoke(args, 1) != "--beta":
        return 12
    if PickArgvForStrSeqAbiSmoke(args, 2) != "gamma":
        return 13
    return 77
