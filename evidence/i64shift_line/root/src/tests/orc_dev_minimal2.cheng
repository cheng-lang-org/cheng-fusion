# minimal probe 2: ReadFileBytesResult + Err propagation shape
import std/os
import std/system
import std/rawbytes
import std/result

fn Tier1(path: str): Result[bool] =
    let r = os.ReadFileBytesResult(path)
    if !r.ok:
        return Err[bool](r.err.msg)
    return Ok[bool](true)

fn main(): int32 =
    let t1 = Tier1("/tmp/orc_dev_missing.bin")
    if t1.ok:
        echo("unexpected ok")
    else:
        echo("err propagated")
    return 0
