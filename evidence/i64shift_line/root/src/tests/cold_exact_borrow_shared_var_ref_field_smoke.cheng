type
    ColdExactCell = ref object
        value: int32

    ColdExactCellBox = ref object
        cell: ColdExactCell

@borrows
fn ColdExactReadCell(cell: ColdExactCell): int32 =
    return cell.value

@borrows
fn ColdExactWriteCell(cell: ColdExactCell, value: int32) =
    cell.value = value

fn ColdExactNewCell(value: int32): ColdExactCell =
    let cell = new(ColdExactCell)
    cell.value = value
    return cell

@borrows
fn ColdExactStringLen(text: str): int32 =
    return len(text)

fn main(): int32 =
    let box = new(ColdExactCellBox)
    let initial = new(ColdExactCell)
    initial.value = 7
    box.cell = initial
    var tailCell = box.cell
    if ColdExactReadCell(tailCell) != 7:
        return 11
    ColdExactWriteCell(tailCell, 9)
    if ColdExactReadCell(tailCell) != 9:
        return 12
    var mutableCell = box.cell
    ColdExactWriteCell(mutableCell, 13)
    if ColdExactReadCell(mutableCell) != 13:
        return 13
    if ColdExactReadCell(ColdExactNewCell(17)) != 17:
        return 14
    let text = "borrow"
    if ColdExactStringLen(text) != 6 ||
       ColdExactStringLen(text) != 6:
        return 15
    if ColdExactStringLen("view") != 4:
        return 16
    return 0
