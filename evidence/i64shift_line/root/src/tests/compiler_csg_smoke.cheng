import std/os
import std/result
import cheng/std/bytes_layout as layout
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_world as cworld
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/intern as langintern
import std/strutils as strutil

fn reportFieldValue(report: str, key: str): str =
    let taggedReport = strutil.Join(["\n", report], "")
    let needle = strutil.Join(["\n", key, "="], "")
    let fieldPos = parser.ParserFindText(taggedReport, needle)
    if fieldPos < 0:
        return ""
    let valueStart = fieldPos + needle.len
    let tail = chengpath.TextSlice(taggedReport, valueStart, taggedReport.len - valueStart)
    let newlinePos = parser.ParserFindText(tail, "\n")
    if newlinePos < 0:
        return tail
    return chengpath.TextSlice(tail, 0, newlinePos)

fn reportFieldPositive(report: str, key: str): bool =
    let value = reportFieldValue(report, key)
    return value != "" && value != "0"

fn assertReportCount(report: str,
                     key: str,
                     expected: int32,
                     label: str) =
    assert(reportFieldValue(report, key) == IntToStr(expected),
           strutil.Join([label, " ", key], ""))

fn assertLoweringAggregateReport(report: str,
                                 rules: texpr.TypedExprLoweringRule[],
                                 label: str) =
    assertReportCount(report, "lowering_rule_count", rules.len, label)
    assertReportCount(report, "lowering_rule_unique_shape_count", texpr.TypedExprLoweringRuleUniqueShapeCount(rules), label)
    assertReportCount(report, "lowering_rule_unique_key_count", texpr.TypedExprLoweringRuleUniqueKeyCount(rules), label)
    assertReportCount(report, "lowering_rule_arg_value_count", texpr.TypedExprLoweringRuleCountArgPassKind(rules, texpr.TypedExprArgPassValue), label)
    assertReportCount(report, "lowering_rule_arg_address_count", texpr.TypedExprLoweringRuleCountArgPassKind(rules, texpr.TypedExprArgPassAddress), label)
    assertReportCount(report, "lowering_rule_arg_call_result_address_count", texpr.TypedExprLoweringRuleCountArgPassKind(rules, texpr.TypedExprArgPassCallResultAddress), label)
    assertReportCount(report, "lowering_rule_result_reg_count", texpr.TypedExprLoweringRuleCountResultPassKind(rules, texpr.TypedExprResultPassReg), label)
    assertReportCount(report, "lowering_rule_result_local_address_count", texpr.TypedExprLoweringRuleCountResultPassKind(rules, texpr.TypedExprResultPassLocalAddress), label)
    assertReportCount(report, "lowering_rule_result_sret_count", texpr.TypedExprLoweringRuleCountResultPassKind(rules, texpr.TypedExprResultPassSret), label)
    assertReportCount(report, "lowering_rule_materialize_register_count", texpr.TypedExprLoweringRuleCountMaterializeKind(rules, texpr.TypedExprMaterializeRegister), label)
    assertReportCount(report, "lowering_rule_materialize_local_slot_count", texpr.TypedExprLoweringRuleCountMaterializeKind(rules, texpr.TypedExprMaterializeLocalSlot), label)
    assertReportCount(report, "lowering_rule_materialize_call_result_local_count", texpr.TypedExprLoweringRuleCountMaterializeKind(rules, texpr.TypedExprMaterializeCallResultLocal), label)
    assertReportCount(report, "lowering_rule_materialize_dest_address_count", texpr.TypedExprLoweringRuleCountMaterializeKind(rules, texpr.TypedExprMaterializeDestAddress), label)
    assertReportCount(report, "lowering_rule_copy_scalar_store_count", texpr.TypedExprLoweringRuleCountCopyKind(rules, texpr.TypedExprCopyScalarStore), label)
    assertReportCount(report, "lowering_rule_copy_region_copy_count", texpr.TypedExprLoweringRuleCountCopyKind(rules, texpr.TypedExprCopyRegionCopy), label)
    assertReportCount(report, "lowering_rule_import_import_buffer_count", texpr.TypedExprLoweringRuleCountImportKind(rules, texpr.TypedExprImportImportBuffer), label)
    assertReportCount(report, "lowering_rule_import_builtin_address_slot_count", texpr.TypedExprLoweringRuleCountImportKind(rules, texpr.TypedExprImportBuiltinAddressSlot), label)
    assertReportCount(report, "lowering_rule_import_i32_value_slot_count", texpr.TypedExprLoweringRuleCountImportKind(rules, texpr.TypedExprImportI32ValueSlot), label)
    assertReportCount(report, "lowering_rule_import_i32_address_slot_count", texpr.TypedExprLoweringRuleCountImportKind(rules, texpr.TypedExprImportI32AddressSlot), label)
    assertReportCount(report, "lowering_rule_type_call_none_count", texpr.TypedExprLoweringRuleCountTypeCallKind(rules, texpr.TypedExprTypeCallNone), label)
    assertReportCount(report, "lowering_rule_type_call_default_init_count", texpr.TypedExprLoweringRuleCountTypeCallKind(rules, texpr.TypedExprTypeCallDefaultInit), label)
    assertReportCount(report, "lowering_rule_type_call_constructor_count", texpr.TypedExprLoweringRuleCountTypeCallKind(rules, texpr.TypedExprTypeCallConstructor), label)
    assertReportCount(report, "lowering_rule_return_root_count", texpr.TypedExprLoweringRuleReturnRootCount(rules), label)
    assert(reportFieldValue(report, "lowering_rule_report_mode") == "summary",
           strutil.Join([label, " report mode"], ""))
    assert(reportFieldValue(report, "lowering_rule_entries_materialized") == "0",
           strutil.Join([label, " entries materialized"], ""))
    assert(!chengpath.TextContains(report, "lowering_rule_entry["),
           strutil.Join([label, " no materialized entries"], ""))

fn assertCallReasonReportField(report: str,
                               layer: parser.NormalizedExprLayer,
                               reason: parser.NormalizedExprCallReason,
                               label: str) =
    let reportKey = ccsg.CompilerCsgCallReasonReportKey(reason)
    assert(reportKey != "", strutil.Join([label, " report key"], ""))
    assert(reportFieldValue(report, reportKey) ==
           IntToStr(parser.NormalizedExprLayerCallReasonCountExact(layer, reason)),
           label)

fn assertTypedCallFactsMatchLayer(facts: var ccsg.TypedExprFactTable,
                                  layer: parser.NormalizedExprLayer,
                                  label: str) =
    assert(texpr.TypedExprTypeCallDefaultInitCount(facts) ==
           parser.NormalizedExprLayerDefaultInitCount(layer),
           strutil.Join([label, " typed default init count"], ""))
    assert(texpr.TypedExprTypeCallConstructorCount(facts) ==
           parser.NormalizedExprLayerConstructorCount(layer),
           strutil.Join([label, " typed constructor count"], ""))
    assert(texpr.TypedExprFactCountCallResolved(facts) ==
           parser.NormalizedExprLayerCallResolvedCount(layer),
           strutil.Join([label, " typed resolved call count"], ""))
    assert(texpr.TypedExprFactCountCallUnresolved(facts) ==
           parser.NormalizedExprLayerCallUnresolvedCount(layer),
           strutil.Join([label, " typed unresolved call count"], ""))
    assert(texpr.TypedExprFactCountSurfaceCallKindFromParser(facts, parser.NormalizedExprSurfaceCallLocal) ==
           parser.NormalizedExprLayerCallKindCountExact(layer, parser.NormalizedExprSurfaceCallLocal),
           strutil.Join([label, " typed local call kind count"], ""))
    assert(texpr.TypedExprFactCountSurfaceCallKindFromParser(facts, parser.NormalizedExprSurfaceCallExternal) ==
           parser.NormalizedExprLayerCallKindCountExact(layer, parser.NormalizedExprSurfaceCallExternal),
           strutil.Join([label, " typed external call kind count"], ""))
    assert(texpr.TypedExprFactCountSurfaceCallKindFromParser(facts, parser.NormalizedExprSurfaceCallImportc) ==
           parser.NormalizedExprLayerCallKindCountExact(layer, parser.NormalizedExprSurfaceCallImportc),
           strutil.Join([label, " typed importc call kind count"], ""))
    assert(texpr.TypedExprFactCountSurfaceCallKindFromParser(facts, parser.NormalizedExprSurfaceCallMember) ==
           parser.NormalizedExprLayerCallKindCountExact(layer, parser.NormalizedExprSurfaceCallMember),
           strutil.Join([label, " typed member call kind count"], ""))
    assert(texpr.TypedExprFactCountCallTargetImportc(facts) ==
           parser.NormalizedExprLayerCallTargetImportcCount(layer),
           strutil.Join([label, " typed importc target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonUnknownQualifiedTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonUnknownQualifiedTarget),
           strutil.Join([label, " typed unknown qualified target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonShadowedQualifiedTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonShadowedQualifiedTarget),
           strutil.Join([label, " typed shadowed qualified target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonAmbiguousExternalTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonAmbiguousExternalTarget),
           strutil.Join([label, " typed ambiguous external target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonAmbiguousQualifiedTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonAmbiguousQualifiedTarget),
           strutil.Join([label, " typed ambiguous qualified target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonUnknownExternalTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonUnknownExternalTarget),
           strutil.Join([label, " typed unknown external target count"], ""))
    assert(texpr.TypedExprFactCountCallReasonFromParser(facts, parser.NormalizedExprCallReasonUnknownCallTarget) ==
           parser.NormalizedExprLayerCallReasonCountExact(layer, parser.NormalizedExprCallReasonUnknownCallTarget),
           strutil.Join([label, " typed unknown call target count"], ""))

fn buildLinkPlan(workspaceRoot: str,
                 packageRoot: str,
                 sourcePath: str,
                 outputPath: str,
                 emitKind: int32): slplan.SystemLinkPlanStub =
    let req = creq.CompilerRequestNew(
        packageRoot,
        sourcePath,
        outputPath,
        "arm64-apple-darwin",
        emitKind,
        ""
    )
    var linkPlan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(workspaceRoot, req, linkPlan, err), " compiler csg: link plan")
    return linkPlan

fn buildCompilerCsg(linkPlan: slplan.SystemLinkPlanStub,
                    label: str): ccsg.CompilerCsg =
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(linkPlan)
    assert(IsOk(sourceBundleRes), strutil.Join([label, " source bundle"], ""))
    let csgRes = ccsg.BuildCompilerCsg(linkPlan, Value(sourceBundleRes))
    assert(IsOk(csgRes), strutil.Join([label, " compiler csg"], ""))
    return ccsg.CompilerCsgClone(Value(csgRes))

fn buildOracleLayer(workspaceRoot: str,
                    packageRoot: str,
                    linkPlan: slplan.SystemLinkPlanStub,
                    label: str): parser.NormalizedExprLayer =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    var oracleLayer: parser.NormalizedExprLayer
    var parseErr = ""
    assert(parser.ParserReadNormalizedExprLayerForSourceClosureWithExternalPackageRoots(workspaceRoot,
                                                                                        packageRoot,
                                                                                        externalPackageRoots,
                                                                                        linkPlan.sourceClosurePaths,
                                                                                        oracleLayer,
                                                                                        parseErr),
           strutil.Join([label, " oracle layer ", parseErr], ""))
    return oracleLayer

fn buildOracleFacts(workspaceRoot: str,
                    packageRoot: str,
                    linkPlan: slplan.SystemLinkPlanStub,
                    oracleLayer: var parser.NormalizedExprLayer,
                    metadataContexts: var texpr.TypedExprSourceContext[],
                    label: str): ccsg.TypedExprFactTable =
    let externalPackageRoots = slplan.SystemLinkPlanExternalPackageRoots(linkPlan)
    var sourceTexts: texpr.TypedExprSourceText[]
    metadataContexts = []
    for i in 0..<linkPlan.sourceClosurePaths.len:
        let sourcePath = linkPlan.sourceClosurePaths[i]
        let sourceText = chengpath.ReadTextFile("", sourcePath)
        let typedSource = texpr.TypedExprSourceTextNewWithExternalPackageRoots(workspaceRoot,
                                                                                packageRoot,
                                                                                externalPackageRoots,
                                                                                sourcePath,
                                                                                sourceText)
        add(sourceTexts, typedSource)
        var metadataContext: texpr.TypedExprSourceContext
        var contextErr = ""
        assert(texpr.TypedExprBuildSourceContext(typedSource, metadataContext, contextErr),
               strutil.Join([label, " metadata context ", contextErr], ""))
        add(metadataContexts, metadataContext)
    assert(sourceTexts.len == linkPlan.sourceClosurePaths.len,
           strutil.Join([label, " source closure"], ""))
    assert(metadataContexts.len == linkPlan.sourceClosurePaths.len,
           strutil.Join([label, " metadata contexts"], ""))
    oracleLayer = buildOracleLayer(workspaceRoot, packageRoot, linkPlan, label)
    var factsLayer = parser.NormalizedExprLayerClone(oracleLayer)
    var facts: ccsg.TypedExprFactTable
    var factsErr = ""
    assert(texpr.TypedExprBuildFactsWithMetadataContexts(sourceTexts,
                                                         factsLayer,
                                                         metadataContexts,
                                                         facts,
                                                         factsErr),
           strutil.Join([label, " facts ", factsErr], ""))
    for i in 0..<sourceTexts.len:
        texpr.TypedExprClearSourceTextAllFields(sourceTexts[i])
    return facts

fn assertInternText(pool: langintern.InternPool,
                    id: langintern.InternId,
                    expected: str,
                    label: str) =
    let valueRes: Result[str] = langintern.LookupIntern(pool, id)
    assert(IsOk(valueRes), strutil.Join([label, " intern lookup"], ""))
    assert(Value(valueRes) == expected, label)

fn assertResolvedCallsMatchOracle(table: ccsg.CompilerCsgSemanticResolvedCallTable,
                                  facts: var ccsg.TypedExprFactTable,
                                  label: str) =
    let rowCount = table.sourcePathIds.len
    assert(table.internPool != nil, strutil.Join([label, " intern pool"], ""))
    assert(table.sourceIndexes.len == rowCount, strutil.Join([label, " source indexes"], ""))
    assert(table.originParserNodeIds.len == rowCount,
           strutil.Join([label, " parser origins"], ""))
    assert(table.lineNumbers.len == rowCount, strutil.Join([label, " lines"], ""))
    assert(table.callQualifierIds.len == rowCount, strutil.Join([label, " qualifiers"], ""))
    assert(table.callCalleeIds.len == rowCount, strutil.Join([label, " callees"], ""))
    assert(table.callTargetIds.len == rowCount, strutil.Join([label, " targets"], ""))
    assert(table.callTargetSourcePathIds.len == rowCount, strutil.Join([label, " target sources"], ""))
    assert(table.callTargetImportcFlags.len == rowCount, strutil.Join([label, " importc flags"], ""))
    assert(table.callArgCounts.len == rowCount, strutil.Join([label, " arg counts"], ""))
    assert(table.callArgsTextIds.len == rowCount, strutil.Join([label, " args text"], ""))
    assert(table.returnRootFlags.len == rowCount, strutil.Join([label, " return roots"], ""))
    var rowIndex: int32
    for i in 0..<facts.count:
        let fact = texpr.TypedExprFactAt(facts, i)
        if fact.lineNumber <= 0 || !fact.callResolved || fact.callTarget == "":
            continue
        assert(rowIndex < rowCount, strutil.Join([label, " missing row"], ""))
        assert(table.sourceIndexes[rowIndex] >= 0, strutil.Join([label, " source index"], ""))
        assert(table.originParserNodeIds[rowIndex] ==
                   fact.valueExprCallNodeIndex,
               strutil.Join([label, " parser origin"], ""))
        assert(table.lineNumbers[rowIndex] == fact.lineNumber, strutil.Join([label, " line"], ""))
        assertInternText(table.internPool, table.sourcePathIds[rowIndex], fact.sourcePath, strutil.Join([label, " source"], ""))
        assertInternText(table.internPool, table.callQualifierIds[rowIndex], fact.callQualifier, strutil.Join([label, " qualifier"], ""))
        assertInternText(table.internPool, table.callCalleeIds[rowIndex], fact.callCallee, strutil.Join([label, " callee"], ""))
        assertInternText(table.internPool, table.callTargetIds[rowIndex], fact.callTarget, strutil.Join([label, " target"], ""))
        assertInternText(table.internPool, table.callTargetSourcePathIds[rowIndex], fact.callTargetSourcePath, strutil.Join([label, " target source"], ""))
        assert(table.callTargetImportcFlags[rowIndex] == fact.callTargetImportc, strutil.Join([label, " importc"], ""))
        assert(table.callArgCounts[rowIndex] == fact.callArgCount, strutil.Join([label, " arg count"], ""))
        assertInternText(table.internPool, table.callArgsTextIds[rowIndex], fact.callArgsText, strutil.Join([label, " args"], ""))
        assert(table.returnRootFlags[rowIndex] == fact.returnRoot, strutil.Join([label, " return root"], ""))
        rowIndex = rowIndex + 1
    assert(rowIndex == rowCount, strutil.Join([label, " row count"], ""))

fn byteBufBytesEqual(lhs: layout.ByteBuf,
                     rhs: layout.ByteBuf): bool =
    let lhsBytes = layout.ByteBufToBytes(lhs)
    let rhsBytes = layout.ByteBufToBytes(rhs)
    if len(lhsBytes) != len(rhsBytes):
        return false
    for i in 0..<len(lhsBytes):
        if lhsBytes[i] != rhsBytes[i]:
            return false
    return true

fn findCallExpr(layer: parser.NormalizedExprLayer,
                sourcePath: str,
                lineNumber: int32): parser.NormalizedExpr =
    for i in 0..<layer.exprs.len:
        if layer.exprs[i].kind != parser.NormalizedExprCall:
            continue
        if layer.exprs[i].sourcePath != sourcePath:
            continue
        if layer.exprs[i].lineNumber != lineNumber:
            continue
        var cloned: NormalizedExpr
    parser.NormalizedExprCloneInto(layer.exprs[i], cloned)
    return cloned
    var missing: parser.NormalizedExpr
    return missing

fn findTypedFact(facts: ccsg.TypedExprFactTable,
                 sourcePath: str,
                 lineNumber: int32): ccsg.TypedExprFact =
    for i in 0..<facts.count:
        let factRow = texpr.TypedExprFactAt(facts, i)
        if factRow.sourcePath != sourcePath:
            continue
        if factRow.lineNumber != lineNumber:
            continue
        return factRow
    var missing: ccsg.TypedExprFact
    return missing

fn main(): int32 =
    let workspaceRoot: str = chengpath.PathCurrentDir()
    let packageRoot: str = workspaceRoot
    let smokeLabel: str = os.GetEnvDefault("CHENG_SMOKE_LABEL", "host")
    let outDir: str = chengpath.PathJoin(workspaceRoot, strutil.Join(["artifacts/compiler_csg/", smokeLabel], ""))
    assert(chengpath.MkdirP(workspaceRoot, outDir), " compiler csg: mkdir")
    let sourcePath: str = chengpath.PathJoin(packageRoot, "src/tests/program_selfhost_smoke.cheng")
    let outputPath: str = chengpath.PathJoin(outDir, "program_selfhost_smoke")
    let csgLinkPlan = buildLinkPlan(workspaceRoot,
                                    packageRoot,
                                    sourcePath,
                                    outputPath,
                                    creq.EmitExe)
    let csg = buildCompilerCsg(csgLinkPlan, " compiler csg: program")
    var csgOracleLayer: parser.NormalizedExprLayer
    var csgMetadataContexts: texpr.TypedExprSourceContext[]
    var csgOracleFacts = buildOracleFacts(workspaceRoot,
                                          packageRoot,
                                          csgLinkPlan,
                                          csgOracleLayer,
                                          csgMetadataContexts,
                                          " compiler csg: program oracle")
    assert(csg.nodeCount > 0, " compiler csg: node count")
    assert(csg.edgeCount > 0, " compiler csg: edge count")
    assert(csg.typedExprFacts.count == 0,
           " compiler csg: legacy typed facts released")
    assert(csg.typedExprFactCountSnapshot == csgOracleFacts.count,
           " compiler csg: typed expr fact count")
    assert(csgOracleFacts.count == parser.NormalizedExprLayerExprCount(csgOracleLayer),
           " compiler csg: typed expr fact vs layer count")
    assert(csg.semanticGraph.typedFactTable.sourceIndexes.len == csgOracleFacts.count,
           " compiler csg: typed expr fact count")
    assert(texpr.TypedExprFactExprId(csgOracleFacts, 0) != "", " compiler csg: typed expr id")
    assertResolvedCallsMatchOracle(csg.semanticGraph.resolvedCallTable,
                                   csgOracleFacts,
                                   " compiler csg: program resolved calls")
    let surface = ccsg.CompilerExportSurfaceFromCsg(csg)
    assert(surface.exportedSymbolCount > 0, " compiler csg: export count")
    assert(csgOracleLayer.sourceCount > 0, " compiler csg: expr surface count")
    assert(parser.NormalizedExprLayerTryCount(csgOracleLayer) >= 0, " compiler csg: try count")
    assert(csgOracleLayer.questionResidualCount == 0, " compiler csg: question normalized")
    assert(csg.semanticGraph.typedFactTable.summary.lowerLocalAddressCount ==
           texpr.TypedExprLowerLocalAddressCount(csgOracleFacts),
           " compiler csg: lowering mode count")
    assert(csg.semanticGraph.typedFactTable.summary.lowerLocalAddressCount > 0,
           " compiler csg: lowering mode present")

    let typedFixturePath: str = chengpath.PathJoin(packageRoot, "src/tests/typed_expr_fact_fixture.cheng")
    let typedOutputPath: str = chengpath.PathJoin(outDir, "typed_expr_fact_fixture")
    let typedLinkPlan = buildLinkPlan(workspaceRoot,
                                      packageRoot,
                                      typedFixturePath,
                                      typedOutputPath,
                                      creq.EmitShared)
    let typedCsg = buildCompilerCsg(typedLinkPlan, " compiler csg: typed fixture")
    var typedOracleLayer: parser.NormalizedExprLayer
    var typedMetadataContexts: texpr.TypedExprSourceContext[]
    var typedOracleFacts = buildOracleFacts(workspaceRoot,
                                            packageRoot,
                                            typedLinkPlan,
                                            typedOracleLayer,
                                            typedMetadataContexts,
                                            " compiler csg: typed fixture oracle")
    assert(typedCsg.typedExprFacts.count == 0,
           " compiler csg: typed fixture legacy facts released")
    assert(typedCsg.typedExprFactCountSnapshot == typedOracleFacts.count,
           " compiler csg: typed fixture fact snapshot")
    assert(typedCsg.semanticGraph.typedFactTable.sourceIndexes.len == typedOracleFacts.count,
           " compiler csg: typed fixture fact count")
    assertResolvedCallsMatchOracle(typedCsg.semanticGraph.resolvedCallTable,
                                   typedOracleFacts,
                                   " compiler csg: typed fixture resolved calls")
    var typedFixtureFacts = texpr.TypedExprFactsForSource(typedOracleFacts, typedFixturePath)
    let typedFixtureRules = texpr.TypedExprLoweringRulesFromFacts(typedFixtureFacts)
    let actualTypedRules = texpr.TypedExprLoweringRulesFromFacts(typedOracleFacts)
    let typedReport = ccsg.CompilerCsgReport(typedCsg)
    assert(reportFieldValue(typedReport, "egraph_active_contract") == "canonical_csg_equivalence",
           " compiler csg: active egraph contract")
    assert(reportFieldValue(typedReport, "egraph_equivalence_surface") == "canonical_graph_cid",
           " compiler csg: egraph canonical surface")
    assert(reportFieldValue(typedReport, "uir_egraph_status") == "available",
           " compiler csg: uir egraph available")
    let aliasExternalExpr = findCallExpr(typedOracleLayer, typedFixturePath, 29)
    var loweringErr = ""
    var actualTypedValidateLayer = parser.NormalizedExprLayerClone(typedOracleLayer)
    var actualTypedValidateFacts = typedOracleFacts
    assert(texpr.TypedExprFactsValidateCallResolution(actualTypedValidateLayer,
                                                        typedMetadataContexts,
                                                        actualTypedValidateFacts,
                                                        loweringErr),
           " compiler csg: actual typed fixture call resolution validate")
    assert(texpr.TypedExprLoweringRulesValidate(actualTypedRules, loweringErr),
           " compiler csg: actual typed fixture lowering rules validate")
    assert(typedFixtureFacts.count > 0, " compiler csg: typed fixture fact slice")
    assert(aliasExternalExpr.exprId != "", " compiler csg: typed fixture alias external expr")
    var legacyCompatBuf = layout.ByteBufInit(128)
    var streamedCompatBuf = layout.ByteBufInit(128)
    ccsg.CompilerCsgAppendText(legacyCompatBuf, ccsg.CompilerCsgExprCompatDetail(aliasExternalExpr))
    ccsg.CompilerCsgAppendExprCompatDetail(streamedCompatBuf, aliasExternalExpr)
    assert(byteBufBytesEqual(legacyCompatBuf, streamedCompatBuf),
           " compiler csg: streamed compat detail bytes")
    assertTypedCallFactsMatchLayer(typedOracleFacts, typedOracleLayer, " compiler csg: typed fixture")
    var typedValidateLayer = parser.NormalizedExprLayerClone(typedOracleLayer)
    var typedValidateFacts = typedOracleFacts
    assert(texpr.TypedExprFactsValidateCallResolution(typedValidateLayer,
                                                       typedMetadataContexts,
                                                       typedValidateFacts,
                                                       loweringErr),
           " compiler csg: typed fixture call resolution validate")
    assert(texpr.TypedExprLoweringRulesValidate(typedFixtureRules, loweringErr),
           " compiler csg: typed fixture lowering rules validate")
    assert(typedFixtureRules.len == typedFixtureFacts.count,
           " compiler csg: typed fixture lowering rule count")
    assert(texpr.TypedExprLoweringRuleUniqueShapeCount(typedFixtureRules) > 0,
           " compiler csg: typed fixture lowering rule shape count")
    assert(texpr.TypedExprLoweringRuleUniqueShapeCount(typedFixtureRules) ==
           texpr.TypedExprLoweringRuleUniqueKeyCount(typedFixtureRules),
           " compiler csg: typed fixture lowering rule key count")
    assert(texpr.TypedExprAbiPolymorphicCount(typedFixtureFacts) == 0,
           " compiler csg: typed fixture no abi polymorphic")
    assert(texpr.TypedExprLowerDeferredCount(typedFixtureFacts) == 0,
           " compiler csg: typed fixture no deferred lowering")
    assert(texpr.TypedExprPlaceLocalCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture local place count")
    assert(texpr.TypedExprLowerSretCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture sret count")
    assert(texpr.TypedExprCallBuiltinCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture builtin call kind")
    assert(texpr.TypedExprCallResultIntrinsicCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture result intrinsic call kind")
    assert(texpr.TypedExprCallProjectionCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture projection call kind")
    assert(parser.NormalizedExprLayerHasConstructorExpr(typedOracleLayer, 61),
           " compiler csg: typed fixture constructor expr")
    let constructorFact = findTypedFact(typedFixtureFacts, typedFixturePath, 61)
    assert(constructorFact.kind == parser.NormalizedExprConstructor,
           " compiler csg: typed fixture constructor fact kind")
    assert(constructorFact.typeCallKind == texpr.TypedExprTypeCallConstructor,
           " compiler csg: typed fixture constructor type call kind")
    assert(constructorFact.typeText == "TypedDefaultWrap",
           " compiler csg: typed fixture constructor fact type")
    assert(!constructorFact.callPrefixStyle,
           " compiler csg: typed fixture constructor call prefix")
    assert(constructorFact.callArgCount == 1,
           " compiler csg: typed fixture constructor arg count")
    assert(constructorFact.callArgsText == "count: payload.len",
           " compiler csg: typed fixture constructor args text")
    let stringifyPrefixFact = findTypedFact(typedFixtureFacts, typedFixturePath, 69)
    assert(stringifyPrefixFact.kind == parser.NormalizedExprCall,
           " compiler csg: typed fixture stringify prefix kind")
    assert(stringifyPrefixFact.callKind == texpr.TypedExprCallBuiltin,
           " compiler csg: typed fixture stringify prefix call kind")
    assert(stringifyPrefixFact.callResolved,
           " compiler csg: typed fixture stringify prefix resolved")
    assert(stringifyPrefixFact.callPrefixStyle,
           " compiler csg: typed fixture stringify prefix style")
    assert(stringifyPrefixFact.callArgCount == 1,
           " compiler csg: typed fixture stringify prefix arg count")
    assert(stringifyPrefixFact.callArgsText == "built",
           " compiler csg: typed fixture stringify prefix args text")
    assert(stringifyPrefixFact.typeText == "str",
           " compiler csg: typed fixture stringify prefix type")
    let stringifyParenFact = findTypedFact(typedFixtureFacts, typedFixturePath, 70)
    assert(stringifyParenFact.kind == parser.NormalizedExprCall,
           " compiler csg: typed fixture stringify paren kind")
    assert(stringifyParenFact.callKind == texpr.TypedExprCallBuiltin,
           " compiler csg: typed fixture stringify paren call kind")
    assert(stringifyParenFact.callResolved,
           " compiler csg: typed fixture stringify paren resolved")
    assert(!stringifyParenFact.callPrefixStyle,
           " compiler csg: typed fixture stringify paren style")
    assert(stringifyParenFact.callArgCount == 1,
           " compiler csg: typed fixture stringify paren arg count")
    assert(stringifyParenFact.callArgsText == "built",
           " compiler csg: typed fixture stringify paren args text")
    assert(stringifyParenFact.typeText == "str",
           " compiler csg: typed fixture stringify paren type")
    let constructorRules = texpr.TypedExprLoweringRulesFromFacts(typedOracleFacts)
    var sawConstructorRule = false
    for i in 0..<constructorRules.len:
        if constructorRules[i].sourcePath == typedFixturePath &&
           constructorRules[i].lineNumber == 61 &&
           constructorRules[i].typeCallKind == texpr.TypedExprTypeCallConstructor:
            assert(constructorRules[i].callArgCount == 1,
                   " compiler csg: typed fixture constructor rule arg count")
            assert(constructorRules[i].callArgsText == "count: payload.len",
                   " compiler csg: typed fixture constructor rule args text")
            sawConstructorRule = true
    assert(sawConstructorRule, " compiler csg: typed fixture constructor lowering rule")
    var badTypeCallFacts = texpr.TypedExprFactTableClone(typedOracleFacts)
    var corruptedTypeCallFact = false
    for i in 0..<badTypeCallFacts.count:
        var badFactRow = texpr.TypedExprFactAt(badTypeCallFacts, i)
        if badFactRow.sourcePath == typedFixturePath &&
           badFactRow.lineNumber == 61 &&
           badFactRow.kind == parser.NormalizedExprConstructor:
            badFactRow.abiClass = texpr.TypedExprAbiPolymorphic
            badFactRow.valueKind = texpr.TypedExprValuePolymorphic
            badFactRow.loweringMode = texpr.TypedExprLowerDeferred
            badFactRow.returnKind = texpr.TypedExprReturnDeferred
            texpr.TypedExprFactTableSet(badTypeCallFacts, i, badFactRow)
            corruptedTypeCallFact = true
    assert(corruptedTypeCallFact, " compiler csg: corrupt constructor fact")
    loweringErr = ""
    var badTypeCallLayer = parser.NormalizedExprLayerClone(typedOracleLayer)
    assert(!texpr.TypedExprFactsValidateCallResolution(badTypeCallLayer,
                                                       typedMetadataContexts,
                                                       badTypeCallFacts,
                                                       loweringErr),
           " compiler csg: reject invalid constructor fact lowering")
    assert(chengpath.TextContains(loweringErr, "type-call fact"),
           " compiler csg: invalid constructor fact error")
    var badTypeCallRules = texpr.TypedExprLoweringRulesClone(constructorRules)
    var corruptedTypeCallRule = false
    for i in 0..<badTypeCallRules.len:
        if badTypeCallRules[i].sourcePath == typedFixturePath &&
           badTypeCallRules[i].lineNumber == 61 &&
           badTypeCallRules[i].typeCallKind == texpr.TypedExprTypeCallConstructor:
            badTypeCallRules[i].copyKind = texpr.TypedExprCopyScalarStore
            corruptedTypeCallRule = true
    assert(corruptedTypeCallRule, " compiler csg: corrupt constructor rule")
    loweringErr = ""
    assert(!texpr.TypedExprLoweringRulesValidate(badTypeCallRules, loweringErr),
           " compiler csg: reject invalid constructor lowering rule")
    assert(chengpath.TextContains(loweringErr, "type-call rule"),
           " compiler csg: invalid constructor rule error")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleLayer, parser.NormalizedExprSurfaceCallExternal, 29),
           " compiler csg: typed fixture alias external call")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleLayer, parser.NormalizedExprSurfaceCallExternal, 30),
           " compiler csg: typed fixture module stem external call")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleLayer, parser.NormalizedExprSurfaceCallExternal, 31),
           " compiler csg: typed fixture nested qualified external call")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleLayer, parser.NormalizedExprSurfaceCallExternal, 33),
           " compiler csg: typed fixture alias importc external call")
    assert(parser.NormalizedExprLayerHasCallExpr(typedOracleLayer, parser.NormalizedExprSurfaceCallExternal, 34),
           " compiler csg: typed fixture nested importc external call")
    var sawAliasImportBuffer = false
    var sawNestedImportBuffer = false
    var sawDefaultInitFact = false
    for i in 0..<typedFixtureFacts.count:
        let fixtureFactRow = texpr.TypedExprFactAt(typedFixtureFacts, i)
        if fixtureFactRow.lineNumber == 33 &&
           texpr.TypedExprFactUsesImportBuffer(fixtureFactRow):
            sawAliasImportBuffer = true
        if fixtureFactRow.lineNumber == 34 &&
           texpr.TypedExprFactUsesImportBuffer(fixtureFactRow):
            sawNestedImportBuffer = true
        if fixtureFactRow.lineNumber == 57 &&
           fixtureFactRow.kind == parser.NormalizedExprDefaultInit:
            assert(fixtureFactRow.typeCallKind == texpr.TypedExprTypeCallDefaultInit,
                   " compiler csg: typed fixture default init type call kind")
            assert(fixtureFactRow.abiClass == texpr.TypedExprAbiComposite,
                   " compiler csg: typed fixture default init abi")
            assert(fixtureFactRow.placeKind != texpr.TypedExprPlaceCallResult,
                   " compiler csg: typed fixture default init place")
            assert(fixtureFactRow.loweringMode == texpr.TypedExprLowerLocalAddress,
                   " compiler csg: typed fixture default init lowering")
            assert(fixtureFactRow.returnKind == texpr.TypedExprReturnCompositeLocal,
                   " compiler csg: typed fixture default init return")
            sawDefaultInitFact = true
    assert(sawAliasImportBuffer, " compiler csg: typed fixture alias importc uses import buffer")
    assert(sawNestedImportBuffer, " compiler csg: typed fixture nested importc uses import buffer")
    assert(sawDefaultInitFact, " compiler csg: typed fixture saw default init fact")
    assert(texpr.TypedExprLowerImportBufferCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture import buffer lowering")
    assert(texpr.TypedExprReturnRegCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture reg return kind")
    assert(texpr.TypedExprReturnCompositeLocalCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture composite local return kind")
    assert(texpr.TypedExprReturnSretCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture sret return kind")
    assert(texpr.TypedExprReturnImportBufferCount(typedFixtureFacts) > 0,
           " compiler csg: typed fixture import buffer return kind")
    assert(reportFieldValue(typedReport, "expr_surface_call_count") ==
           IntToStr(parser.NormalizedExprLayerCallCount(typedOracleLayer)),
           " compiler csg: typed fixture report call count")
    assert(reportFieldValue(typedReport, "expr_surface_default_init_count") ==
           IntToStr(parser.NormalizedExprLayerDefaultInitCount(typedOracleLayer)),
           " compiler csg: typed fixture report default init count")
    assert(reportFieldValue(typedReport, "expr_surface_call_resolved_count") ==
           IntToStr(parser.NormalizedExprLayerCallResolvedCount(typedOracleLayer)),
           " compiler csg: typed fixture report resolved call count")
    assert(reportFieldValue(typedReport, "expr_surface_call_unresolved_count") ==
           IntToStr(parser.NormalizedExprLayerCallUnresolvedCount(typedOracleLayer)),
           " compiler csg: typed fixture report unresolved call count")
    assert(reportFieldValue(typedReport, "expr_surface_call_local_kind_count") ==
           IntToStr(parser.NormalizedExprLayerCallKindCountExact(typedOracleLayer, parser.NormalizedExprSurfaceCallLocal)),
           " compiler csg: typed fixture report local call kind count")
    assert(reportFieldValue(typedReport, "expr_surface_call_external_kind_count") ==
           IntToStr(parser.NormalizedExprLayerCallKindCountExact(typedOracleLayer, parser.NormalizedExprSurfaceCallExternal)),
           " compiler csg: typed fixture report external call kind count")
    assert(reportFieldValue(typedReport, "expr_surface_call_importc_kind_count") ==
           IntToStr(parser.NormalizedExprLayerCallKindCountExact(typedOracleLayer, parser.NormalizedExprSurfaceCallImportc)),
           " compiler csg: typed fixture report importc call kind count")
    assert(reportFieldValue(typedReport, "expr_surface_call_member_kind_count") ==
           IntToStr(parser.NormalizedExprLayerCallKindCountExact(typedOracleLayer, parser.NormalizedExprSurfaceCallMember)),
           " compiler csg: typed fixture report member call kind count")
    assert(reportFieldValue(typedReport, "expr_surface_call_target_importc_count") ==
           IntToStr(parser.NormalizedExprLayerCallTargetImportcCount(typedOracleLayer)),
           " compiler csg: typed fixture report importc target count")
    assert(reportFieldValue(typedReport, "expr_surface_constructor_count") ==
           IntToStr(parser.NormalizedExprLayerConstructorCount(typedOracleLayer)),
           " compiler csg: typed fixture report constructor count")
    assert(reportFieldValue(typedReport, "typed_expr_type_call_default_init_count") ==
           IntToStr(parser.NormalizedExprLayerDefaultInitCount(typedOracleLayer)),
           " compiler csg: typed fixture report typed default init count")
    assert(reportFieldValue(typedReport, "typed_expr_type_call_constructor_count") ==
           IntToStr(parser.NormalizedExprLayerConstructorCount(typedOracleLayer)),
           " compiler csg: typed fixture report typed constructor count")
    assert(reportFieldValue(typedReport, "lowering_rule_type_call_default_init_count") ==
           IntToStr(parser.NormalizedExprLayerDefaultInitCount(typedOracleLayer)),
           " compiler csg: typed fixture report lowering default init count")
    assert(reportFieldValue(typedReport, "lowering_rule_type_call_constructor_count") ==
           IntToStr(parser.NormalizedExprLayerConstructorCount(typedOracleLayer)),
           " compiler csg: typed fixture report lowering constructor count")
    assertCallReasonReportField(typedReport,
                                typedOracleLayer,
                                parser.NormalizedExprCallReasonUnknownQualifiedTarget,
                                " compiler csg: typed fixture report unknown qualified target count")
    assertCallReasonReportField(typedReport,
                                typedOracleLayer,
                                parser.NormalizedExprCallReasonShadowedQualifiedTarget,
                                " compiler csg: typed fixture report shadowed qualified target count")
    assertCallReasonReportField(typedReport,
                                typedOracleLayer,
                                parser.NormalizedExprCallReasonAmbiguousExternalTarget,
                                " compiler csg: typed fixture report ambiguous external target count")
    assertCallReasonReportField(typedReport,
                                typedOracleLayer,
                                parser.NormalizedExprCallReasonAmbiguousQualifiedTarget,
                                " compiler csg: typed fixture report ambiguous qualified target count")
    assertCallReasonReportField(typedReport,
                                typedOracleLayer,
                                parser.NormalizedExprCallReasonUnknownExternalTarget,
                                " compiler csg: typed fixture report unknown external target count")
    assertCallReasonReportField(typedReport,
                                typedOracleLayer,
                                parser.NormalizedExprCallReasonUnknownCallTarget,
                                " compiler csg: typed fixture report unknown call target count")
    assert(reportFieldPositive(typedReport, "lowering_rule_arg_address_count"),
           " compiler csg: typed fixture address arg rule")
    assert(reportFieldPositive(typedReport, "lowering_rule_result_sret_count"),
           " compiler csg: typed fixture sret result rule")
    assert(reportFieldPositive(typedReport, "lowering_rule_materialize_dest_address_count"),
           " compiler csg: typed fixture dest address materialize rule")
    assert(reportFieldPositive(typedReport, "lowering_rule_copy_region_copy_count"),
           " compiler csg: typed fixture region copy rule")
    assert(reportFieldPositive(typedReport, "lowering_rule_import_builtin_address_slot_count"),
           " compiler csg: typed fixture builtin address import rule")
    assert(reportFieldPositive(typedReport, "lowering_rule_import_import_buffer_count"),
           " compiler csg: typed fixture import buffer import rule")
    assert(reportFieldValue(typedReport, "lowering_rule_unique_key_count") ==
           reportFieldValue(typedReport, "lowering_rule_unique_shape_count"),
           " compiler csg: typed fixture report unique key count")
    assert(chengpath.TextContains(typedReport, texpr.TypedExprFactsReportText(typedOracleFacts)),
           " compiler csg: typed fixture complete typed aggregates")
    assertLoweringAggregateReport(typedReport,
                                  actualTypedRules,
                                  " compiler csg: typed fixture complete lowering aggregates")

    echo(" compiler_csg_smoke ok")
    return 0
