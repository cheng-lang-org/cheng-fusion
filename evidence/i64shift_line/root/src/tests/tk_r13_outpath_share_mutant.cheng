type
    R13Request =
        targetTriple: str
        outputPath: str

fn R13Remove(path: str): bool =
    return path.len > 0

fn R13Make(dir: str, name: str): str =
    return Fmt"{dir}/{name}"

fn R13Link(request: R13Request, seen: var str): bool =
    seen = request.outputPath
    return request.outputPath.len > 0

fn R13Run(seenOut: var str, localOut: var str): int32 =
    let outputPath = R13Make("outdir", "app.exe")
    var request: R13Request
    request.targetTriple = "arm64-apple-darwin"
    request.outputPath = share(outputPath)
    var seen: str
    if !R13Link(request, seen):
        return 10
    if !R13Remove(outputPath):
        return 11
    seenOut = seen
    localOut = outputPath
    return 0

fn main(): int32 =
    var seen: str
    var local: str
    let code = R13Run(seen, local)
    if code != 0:
        return code
    if seen != "outdir/WRONG.exe":
        return 12
    if local != "outdir/app.exe":
        return 13
    if local.len != 14:
        return 14
    echo(Fmt"r13_outpath ok seen={seen} local={local}")
    return 0
