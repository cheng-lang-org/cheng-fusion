# w16-arrfield: `structField[idx] = wholeAggregateValue` (fixed-size array
# field, no `.subField` suffix) write-side round-trip repro.
#
# Root cause fixed: the array FIELD's own total byte size (element_size *
# dim_count) was silently mis-resolved down to a SINGLE ELEMENT's size
# whenever the array dimension was a computed const (`const N = A * B`, the
# shape used throughout src/quic/core/connection_impl.cheng, e.g.
# `msQuicConnImplSentPacketStoreCapacity = msQuicConnImplSlotCount *
# msQuicMaxSentPackets`). Two independent, compounding gaps:
#   1. typed_expr.cheng TypedExprIrFixedArrayTypeParts only accepted a
#      digit-literal or a single-hop named-const dimension text, never an
#      arithmetic expression — so a struct field declared
#      `arr: Elem[computedConst]` registered its OWN size as sizeof(Elem)
#      (one element) instead of sizeof(Elem)*dimCount in the struct field
#      layout table (ir.typeFieldSizeBytes).
#   2. primary_object_plan.cheng's indexed-fixed-array-field-store path
#      (`assignLookupIsIndexed` branch of PrimaryBodyIrAppendI32Assign)
#      reused stmt.assignFieldSizeBytes (which, correctly BY DESIGN, sizes
#      the single INDEXED ELEMENT for the scalar byteCount gate earlier in
#      the function) as if it were the array FIELD's own byte size when
#      sizing the field_seq local staging buffer, the FieldLoad-in copy
#      width, and the FieldStore writeback width. Even after gap 1 is
#      fixed, this path never re-queried the field's own size, so it kept
#      using the element-sized value.
# Combined effect: the field_seq staging buffer was allocated/loaded/written
# back at exactly ONE element's size. Index 0 happened to alias correctly by
# coincidence (writeback range covers element 0); any other index wrote past
# the undersized local buffer (stack corruption / SIGSEGV) and the writeback
# silently dropped every element but 0 back into the real struct field.
#
# Coverage in this file: root = local var, root = `var` parameter (called
# with a local aggregate argument), root = global (accessed directly, no
# var-param call-argument hop); index = constant / variable / function-call
# result; 24-byte aggregate element (int32 + int64 + int32, hits the
# dedicated elemSize==24 LocalAggregateTag IndexedStore branch already used
# by pushCopy, commit 0eaed21e8) and an 8-int32-field (32-byte) element
# hitting the generic "elemSize % 8 == 0" IndexedStore fallback.
#
# Deliberately NOT exercised here (separate, pre-existing, out-of-scope
# defects surfaced during isolation, unrelated to array-field sizing —
# each independently confirmed via disassembly/lldb to reproduce with NO
# array indexing involved at all, so none is a consequence of this patch):
#   - An aggregate constructor whose field list mixes plain scalar-literal
#     fields with one function-call-valued field (e.g. `Rec(active: -1,
#     ..., data: rawbytes.emptyBytes(), ...)`) leaves every field garbage,
#     confirmed with a bare local-variable constructor + field read, zero
#     arrays/indexing/globals involved. This is why the real target
#     (`MsQuicSentPacket`, which carries `data: rawbytes.Bytes`) needs its
#     own separate fix before an end-to-end value repro against it is
#     possible; this file therefore uses pure-scalar element structs.
#   - `return globalOrParam.arrayField[idx]` / `.subField` via a `return`
#     statement whose root is a bare GLOBAL identifier sometimes resolves to
#     a degenerate empty/uninitialized read. Reads here use
#     `root.arrayField[idx].subField` as a plain (non-return) expression,
#     confirmed correct for every root kind exercised.
#   - Passing a GLOBAL variable by name as the actual argument to a `var T`
#     call parameter (`f(gGlobal, ...)` where `fn f(store: var T, ...)`)
#     computes a garbage/uninitialized local address instead of the
#     global's real address — confirmed via disassembly to reproduce
#     identically for a plain SCALAR field element store, i.e. unrelated to
#     aggregate values or array-field sizing. All `var T` writer functions
#     below are therefore invoked with LOCAL aggregate arguments (which
#     correctly compute `&local`), and the global-root scenario writes
#     directly on the global with no var-param hop. This is also why the
#     real target (`msquicConnImplSetSentPacketAtStore` calling
#     `msquicConnImplStoreSetSentPacket(msquicConnImplStore, ...)`) needs a
#     separate fix for the full call chain, on top of this one.
#   - `if root.arrayField[idx].subField != x: return N` used repeatedly in
#     direct sequence (re-deriving the same indexed-element address across
#     multiple branch statements) reads a wrong value starting at the
#     SECOND such `if`, independent of array-field sizing (confirmed with
#     zero writes involved: it reproduces on read-only code once two such
#     `if`-conditioned reads follow each other). Every check function below
#     therefore reads each field into a `let` local immediately after the
#     writes (a plain sequential statement, confirmed correct) and only
#     branches on the already-materialized locals afterward.
#   - `let x: int32 = namedConst - literal` (a computed-const minus a
#     literal, used as a plain scalar expression, nothing to do with
#     arrays) evaluates to garbage — confirmed to reproduce byte-identically
#     against an unmodified HEAD checkout (this patch not applied), so it is
#     pre-existing and unrelated. `storeCapacity`'s only appearances below
#     are therefore either array-dimension positions (which this patch
#     fixes) or copied into a `let` from a literal.
import std/os

const
    slotCount = 2
    perSlot = 4
    storeCapacity = slotCount * perSlot

type
    Rec24 =
        active: int32
        number: int64
        length: int32

    RecStore24 =
        head: int32
        recs: Rec24[storeCapacity]

var
    gRecStore24: RecStore24

fn recIdx(slot: int32, idx: int32): int32 =
    return slot * perSlot + idx

# --- root = `var` parameter (called with a LOCAL aggregate argument) and
#     root = local var (same setter, applied to a purely-local RecStore24) ---

fn rec24StoreSet(store: var RecStore24, idx: int32, value: Rec24) =
    store.recs[idx] = value

fn paramAndLocalRootCheck(): int32 =
    var localStore: RecStore24
    var s0: Rec24 = Rec24(active: -1, number: -1, length: -1)
    var s1: Rec24 = Rec24(active: 111, number: 222222222, length: 33)
    var s6: Rec24 = Rec24(active: -33, number: -44444444, length: -55)
    # constant index, function-call-result index, variable index
    rec24StoreSet(localStore, 0, s0)
    rec24StoreSet(localStore, recIdx(0, 1), s1)
    var idx6: int32 = recIdx(1, 2)
    rec24StoreSet(localStore, idx6, s6)

    let a0: int32 = localStore.recs[0].active
    let n0: int64 = localStore.recs[0].number
    let l0: int32 = localStore.recs[0].length
    let a1: int32 = localStore.recs[1].active
    let n1: int64 = localStore.recs[1].number
    let l1: int32 = localStore.recs[1].length
    let a6: int32 = localStore.recs[6].active
    let n6: int64 = localStore.recs[6].number
    let l6: int32 = localStore.recs[6].length

    if a0 != -1:
        return 1
    if n0 != -1:
        return 1
    if l0 != -1:
        return 1
    if a1 != 111:
        return 2
    if n1 != 222222222:
        return 2
    if l1 != 33:
        return 2
    if a6 != -33:
        return 3
    if n6 != -44444444:
        return 3
    if l6 != -55:
        return 3
    return 0

# --- root = global (direct access, no var-param call-argument hop) ---

fn rec24SetAt(idx: int32, value: Rec24) =
    gRecStore24.recs[idx] = value

fn globalRootCheck(): int32 =
    var sentinelA: Rec24 = Rec24(active: -1, number: -1, length: -1)
    var sentinelB: Rec24 = Rec24(active: -2, number: -2, length: -2)
    var r1: Rec24 = Rec24(active: 11, number: 111111111, length: 22)

    rec24SetAt(0, sentinelA)
    rec24SetAt(recIdx(1, 2), sentinelB)
    rec24SetAt(1, r1)

    let sixIdx: int32 = recIdx(1, 2)
    let a0: int32 = gRecStore24.recs[0].active
    let n0: int64 = gRecStore24.recs[0].number
    let l0: int32 = gRecStore24.recs[0].length
    let a1: int32 = gRecStore24.recs[1].active
    let n1: int64 = gRecStore24.recs[1].number
    let l1: int32 = gRecStore24.recs[1].length
    let a6: int32 = gRecStore24.recs[sixIdx].active
    let n6: int64 = gRecStore24.recs[sixIdx].number
    let l6: int32 = gRecStore24.recs[sixIdx].length

    if a0 != -1:
        return 1
    if n0 != -1:
        return 1
    if l0 != -1:
        return 1
    if a1 != 11:
        return 2
    if n1 != 111111111:
        return 2
    if l1 != 22:
        return 2
    if a6 != -2:
        return 3
    if n6 != -2:
        return 3
    if l6 != -2:
        return 3
    return 0

# --- elemSize=32 (8 int32 fields), generic "elemSize % 8 == 0" IndexedStore
#     fallback, distinct from the elemSize==24 dedicated branch above ---

type
    Wide =
        f0: int32
        f1: int32
        f2: int32
        f3: int32
        f4: int32
        f5: int32
        f6: int32
        f7: int32

    WideStore =
        items: Wide[storeCapacity]

fn wideStoreSet(store: var WideStore, idx: int32, value: Wide) =
    store.items[idx] = value

fn wideRootCheck(): int32 =
    var localStore: WideStore
    var w0: Wide = Wide(f0: 1, f1: 2, f2: 3, f3: 4, f4: 5, f5: 6, f6: 7, f7: 8)
    var w7: Wide = Wide(f0: -1, f1: -2, f2: -3, f3: -4, f4: -5, f5: -6, f6: -7, f7: -8)
    let lastIdx: int32 = 7
    wideStoreSet(localStore, 0, w0)
    wideStoreSet(localStore, lastIdx, w7)
    let f0first: int32 = localStore.items[0].f0
    let f7first: int32 = localStore.items[0].f7
    let f0last: int32 = localStore.items[lastIdx].f0
    let f7last: int32 = localStore.items[lastIdx].f7
    let f0mid: int32 = localStore.items[1].f0
    let f7mid: int32 = localStore.items[1].f7

    if f0first != 1:
        return 1
    if f7first != 8:
        return 1
    if f0last != -1:
        return 2
    if f7last != -8:
        return 2
    # element 0's neighbor must be untouched by the write to the last index
    if f0mid != 0:
        return 3
    if f7mid != 0:
        return 3
    return 0

fn main(): int32 =
    let r1 = paramAndLocalRootCheck()
    if r1 != 0:
        os.WriteLine(os.GetStderr(), Fmt"FAIL paramAndLocalRootCheck code={r1}")
        return 10 + r1
    let r2 = globalRootCheck()
    if r2 != 0:
        os.WriteLine(os.GetStderr(), Fmt"FAIL globalRootCheck code={r2}")
        return 20 + r2
    let r3 = wideRootCheck()
    if r3 != 0:
        os.WriteLine(os.GetStderr(), Fmt"FAIL wideRootCheck code={r3}")
        return 30 + r3
    os.WriteLine(os.GetStdout(), "OK")
    return 0
