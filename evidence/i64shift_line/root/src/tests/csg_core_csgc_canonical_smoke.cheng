import std/os as os
import std/rawbytes
import std/strings
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_dag

const
    CsgcHeaderSize: int32 = 64
    CsgcSectionDigestDomain: str = "csg_core.csgc.section"

type
    TestVarintRead =
        ok: bool
        value: int32
        nextOffset: int32

    TestSectionEntryOffsets =
        ok: bool
        payloadOffsetField: int32
        payloadLengthField: int32
        itemCountField: int32
        digestField: int32

@borrows
fn smokeFail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn expect(condition: bool, message: str): int32 =
    if !condition:
        return smokeFail(message)
    return 0

@borrows
fn containsLine(lines: str[], expected: str): bool =
    for i in 0..<lines.len:
        if lines[i] == expected:
            return true
    return false

@borrows
fn cloneBytes(bytes: rawbytes.Bytes): rawbytes.Bytes =
    var copy = rawbytes.BytesAlloc(rawbytes.BytesLen(bytes))
    rawbytes.BytesCopyInto(copy, 0, bytes)
    return copy

fn writeU32Le(
        bytes: var rawbytes.Bytes,
        offset: int32,
        value: int32) =
    rawbytes.BytesSet(bytes, offset, value & 255)
    rawbytes.BytesSet(
        bytes, offset + 1, (value >> 8) & 255)
    rawbytes.BytesSet(
        bytes, offset + 2, (value >> 16) & 255)
    rawbytes.BytesSet(
        bytes, offset + 3, (value >> 24) & 255)

@borrows
fn readU32Le(
        bytes: rawbytes.Bytes,
        offset: int32): int32 =
    if offset < 0 ||
       offset > rawbytes.BytesLen(bytes) - 4:
        return -1
    return (
        (rawbytes.BytesGet(bytes, offset) & 255) |
        ((rawbytes.BytesGet(bytes, offset + 1) & 255) << 8) |
        ((rawbytes.BytesGet(bytes, offset + 2) & 255) << 16) |
        ((rawbytes.BytesGet(bytes, offset + 3) & 255) << 24))

@borrows
fn readVarint(
        bytes: rawbytes.Bytes,
        offset: int32): TestVarintRead =
    var out: TestVarintRead
    var cursor = offset
    var value: int32
    var shift: int32
    while cursor < rawbytes.BytesLen(bytes):
        if shift > 28:
            return out
        let item =
            rawbytes.BytesGet(bytes, cursor) & 255
        value = value | ((item & 127) << shift)
        cursor = cursor + 1
        if (item & 128) == 0:
            out.ok = true
            out.value = value
            out.nextOffset = cursor
            return out
        shift = shift + 7
    return out

@borrows
fn sectionEntryOffsets(
        bytes: rawbytes.Bytes,
        targetIndex: int32): TestSectionEntryOffsets =
    var out: TestSectionEntryOffsets
    if rawbytes.BytesLen(bytes) < CsgcHeaderSize + 8:
        return out
    let directorySize = readU32Le(bytes, CsgcHeaderSize)
    let sectionCount = readU32Le(bytes, CsgcHeaderSize + 4)
    if directorySize < 8 || sectionCount < 1 ||
       targetIndex < 0 || targetIndex >= sectionCount ||
       directorySize > rawbytes.BytesLen(bytes) - CsgcHeaderSize:
        return out
    let directoryEnd = CsgcHeaderSize + directorySize
    var cursor = CsgcHeaderSize + 8
    for sectionIndex in 0..<sectionCount:
        if cursor >= directoryEnd:
            return out
        cursor = cursor + 1
        let kindLength = readVarint(bytes, cursor)
        if !kindLength.ok || kindLength.value < 0 ||
           kindLength.nextOffset > directoryEnd - kindLength.value:
            return out
        cursor = kindLength.nextOffset + kindLength.value
        if cursor > directoryEnd - 44:
            return out
        if sectionIndex == targetIndex:
            out.ok = true
            out.payloadOffsetField = cursor
            out.payloadLengthField = cursor + 4
            out.itemCountField = cursor + 8
            out.digestField = cursor + 12
            return out
        cursor = cursor + 44
    return out

fn appendU32(buf: var layout.ByteBuf, value: int32) =
    layout.ByteBufAppendByte(buf, value & 255)
    layout.ByteBufAppendByte(buf, (value >> 8) & 255)
    layout.ByteBufAppendByte(buf, (value >> 16) & 255)
    layout.ByteBufAppendByte(buf, (value >> 24) & 255)

@borrows
fn appendText(buf: var layout.ByteBuf, value: str) =
    appendU32(buf, value.len)
    let valueBytes = rawbytes.BytesFromString(value)
    layout.ByteBufAppendBytes(buf, valueBytes)

fn refreshSectionDigest(
        bytes: var rawbytes.Bytes,
        sectionIndex: int32): bool =
    let directory =
        csgc.CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok || sectionIndex < 0 ||
       sectionIndex >= directory.sectionTags.len:
        return false
    let entry = sectionEntryOffsets(bytes, sectionIndex)
    if !entry.ok:
        return false
    var prefix = layout.ByteBufInit(
        96 + directory.sectionKinds[sectionIndex].len)
    appendText(prefix, CsgcSectionDigestDomain)
    layout.ByteBufAppendByte(
        prefix, directory.sectionTags[sectionIndex])
    appendText(prefix, directory.sectionKinds[sectionIndex])
    appendU32(prefix, directory.sectionItemCounts[sectionIndex])
    appendU32(prefix, directory.sectionLengths[sectionIndex])
    let allBytes = layout.ByteSpanFromBytes(bytes)
    let payload = layout.ByteSpanSlice(
        allBytes,
        CsgcHeaderSize + directory.sectionOffsets[sectionIndex],
        directory.sectionLengths[sectionIndex])
    let digest = hash256.Sha256FixedTwo(
        layout.ByteBufView(prefix), payload)
    layout.ByteBufFree(prefix)
    var digestBytes = layout.FixedBytes32ToBytes(digest)
    rawbytes.BytesCopyInto(bytes, entry.digestField, digestBytes)
    return true

@borrows
fn bodyFactCountOffset(
        bytes: rawbytes.Bytes): int32 =
    let directory =
        csgc.CsgCoreCsgcParseSectionDirectory(bytes)
    if !directory.ok || directory.sectionOffsets.len < 2:
        return -1
    return CsgcHeaderSize + directory.sectionOffsets[1]

@borrows
fn rowEnd(
        bytes: rawbytes.Bytes,
        offset: int32): int32 =
    let tokenCount = readVarint(bytes, offset)
    if !tokenCount.ok || tokenCount.value < 0:
        return -1
    var cursor = tokenCount.nextOffset
    for i in 0..<tokenCount.value:
        if cursor >= rawbytes.BytesLen(bytes):
            return -1
        let tag =
            rawbytes.BytesGet(bytes, cursor) & 255
        cursor = cursor + 1
        let payload = readVarint(bytes, cursor)
        if !payload.ok || payload.value < 0:
            return -1
        cursor = payload.nextOffset
        if tag == 2:
            if cursor >
                   rawbytes.BytesLen(bytes) - payload.value:
                return -1
            cursor = cursor + payload.value
        elif tag != 1:
            return -1
    return cursor

@borrows
fn expectDecodeError(
        bytes: rawbytes.Bytes,
        expected: str,
        label: str): int32 =
    let decoded = csgc.CsgCoreCsgcDecodeLines(bytes)
    if decoded.ok:
        return smokeFail(
            strings.ConcatStr(label, ": malformed cargo accepted"))
    if !strutil.StartsWith(decoded.error, expected):
        os.WriteLine(os.Get_stderr(), decoded.error)
        return smokeFail(
            strings.ConcatStr(label, ": wrong error"))
    return 0

@borrows
fn expectEncodeError(
        lines: str[],
        expected: str,
        label: str): int32 =
    let encoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if encoded.ok:
        return smokeFail(
            strings.ConcatStr(
                label, ": non-canonical input accepted"))
    if !strutil.StartsWith(encoded.error, expected):
        os.WriteLine(os.Get_stderr(), encoded.error)
        return smokeFail(
            strings.ConcatStr(label, ": wrong encode error"))
    return 0

fn main(): int32 =
    let factA =
        "{\"id\":\"a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"unknown\":{\"enabled\":true,\"rank\":1}}"
    let factB =
        "{\"id\":\"b\",\"kind\":\"csg.symbol\",\"name\":\"B\"}"
    let canonicalA =
        "{\"id\":\"a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"unknown\":{\"enabled\":true,\"rank\":1}}"

    let firstLines = [
        strings.CloneStr(factA),
        strings.CloneStr(factB)
    ]
    let permutedLines = [
        strings.CloneStr(factB),
        strings.CloneStr(factA)
    ]
    let first =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            firstLines)
    let permuted =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            permutedLines)
    if expect(first.ok && permuted.ok,
              "canonical CSGC encode failed") != 0:
        return 1
    if expect(
           rawbytes.BytesEqual(first.bytes, permuted.bytes),
           "fact permutation changed CSGC bytes") != 0:
        return 1
    if expectEncodeError(
           ["{\"kind\":\"x\",\"id\":\"a\"}"],
           "csgc_non_canonical_fact_line",
           "non-canonical field order") != 0:
        return 1
    if expectEncodeError(
           ["{\"id\":\"a\", \"kind\":\"x\"}"],
           "csgc_non_canonical_fact_line",
           "non-canonical whitespace") != 0:
        return 1
    if expectEncodeError(
           [""],
           "csgc_empty_fact_line",
           "empty fact line") != 0:
        return 1
    let firstRoot =
        merkle_dag.CsgCoreMerkleBuild(firstLines)
    let permutedRoot =
        merkle_dag.CsgCoreMerkleBuild(permutedLines)
    if expect(
           firstRoot.ok &&
           permutedRoot.ok &&
           firstRoot.factsRoot.len == 0 &&
           permutedRoot.factsRoot.len == 0 &&
           firstRoot.dagRootCid ==
               permutedRoot.dagRootCid &&
           firstRoot.subgraphCid ==
               permutedRoot.subgraphCid,
           "fact permutation changed physical Merkle CIDs") != 0:
        return 1
    let schemaFact =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    var schemaHashError: str
    let schemaHash =
        merkle_dag.CsgCoreMerkleFactHash(
            schemaFact, schemaHashError)
    let schemaCid =
        strings.ConcatStr(
            "sha256:", layout.FixedBytes32Hex(schemaHash))
    let boundFirst =
        merkle_dag.CsgCoreMerkleBuildBound(
            [
                strings.CloneStr(schemaFact),
                strings.CloneStr(factA),
                strings.CloneStr(factB)
            ],
            "csg_core::v1",
            ["csg_core"],
            "csg_core::v1",
            schemaCid)
    let boundPermuted =
        merkle_dag.CsgCoreMerkleBuildBound(
            [
                strings.CloneStr(factB),
                strings.CloneStr(schemaFact),
                strings.CloneStr(factA)
            ],
            "csg_core::v1",
            ["csg_core"],
            "csg_core::v1",
            schemaCid)
    if expect(
           schemaHashError.len == 0 &&
           boundFirst.ok &&
           boundPermuted.ok &&
           boundFirst.factsRoot.len == 71 &&
           boundFirst.factsRoot ==
               boundPermuted.factsRoot,
           "fact permutation changed bound facts_root") != 0:
        return 1

    let prefix = rawbytes.BytesSlice(first.bytes, 0, 8)
    if expect(rawbytes.BytesToHex(prefix) == "4353474340000000",
           "CSGC header prefix mismatch") != 0:
        return 1

    let decoded =
        csgc.CsgCoreCsgcDecodeLines(first.bytes)
    if expect(decoded.ok, "canonical CSGC decode failed") != 0:
        return 1
    if expect(decoded.lines.len == 2 && containsLine(decoded.lines, canonicalA),
           "unknown JSON fields were not preserved") != 0:
        return 1

    var oldMagic = cloneBytes(first.bytes)
    rawbytes.BytesSet(oldMagic, 0, 71)
    if expectDecodeError(
           oldMagic, "bad_magic", "legacy GSGC") != 0:
        return 1

    let truncatedHeader =
        rawbytes.BytesSlice(first.bytes, 0, 63)
    if expectDecodeError(
           truncatedHeader,
           "truncated_header",
           "truncated header") != 0:
        return 1

    var badHeaderSize = cloneBytes(first.bytes)
    rawbytes.BytesSet(badHeaderSize, 4, 63)
    rawbytes.BytesSet(badHeaderSize, 5, 0)
    if expectDecodeError(
           badHeaderSize,
           "unsupported_header_size",
           "header size") != 0:
        return 1

    var badFlags = cloneBytes(first.bytes)
    rawbytes.BytesSet(badFlags, 6, 1)
    if expectDecodeError(
           badFlags,
           "unsupported_csgc_flags",
           "header flags") != 0:
        return 1

    var compressed = cloneBytes(first.bytes)
    writeU32Le(compressed, 12, 1)
    if expectDecodeError(
           compressed,
           "compressed_body_unsupported",
           "compressed body") != 0:
        return 1

    var mismatchedCount = cloneBytes(first.bytes)
    writeU32Le(mismatchedCount, 8, 3)
    if expectDecodeError(
           mismatchedCount,
           "fact_count_mismatch",
           "header fact count") != 0:
        return 1

    for reservedOffset in 20..<64:
        var reserved = cloneBytes(first.bytes)
        rawbytes.BytesSet(
            reserved, reservedOffset, 1)
        if expectDecodeError(
               reserved,
               "nonzero_reserved_header",
               "reserved header") != 0:
            return 1

    let truncated =
        rawbytes.BytesSlice(
            first.bytes, 0,
            rawbytes.BytesLen(first.bytes) - 1)
    if expectDecodeError(
           truncated,
           "truncated_body_size_mismatch",
           "truncated cargo") != 0:
        return 1

    var externalTrailing = rawbytes.BytesAlloc(
        rawbytes.BytesLen(first.bytes) + 1)
    rawbytes.BytesCopyInto(externalTrailing, 0, first.bytes)
    if expectDecodeError(
           externalTrailing,
           "trailing_bytes",
           "external trailing cargo") != 0:
        return 1

    var trailing =
        rawbytes.BytesAlloc(
            rawbytes.BytesLen(first.bytes) + 1)
    rawbytes.BytesCopyInto(trailing, 0, first.bytes)
    writeU32Le(
        trailing, 16,
        rawbytes.BytesLen(trailing) - 64)
    if expectDecodeError(
           trailing, "trailing_bytes", "trailing cargo") != 0:
        return 1

    let single =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            ["{\"id\":\"a\",\"kind\":\"x\"}"])
    if expect(single.ok, "single fact encode failed") != 0:
        return 1

    let firstDirectory =
        csgc.CsgCoreCsgcParseSectionDirectory(first.bytes)
    let firstCountOffset =
        bodyFactCountOffset(first.bytes)
    let firstRowStart = firstCountOffset + 4
    let firstRowEnd = rowEnd(
        first.bytes, firstRowStart)
    let secondRowEnd = rowEnd(
        first.bytes, firstRowEnd)
    if expect(
           firstDirectory.ok &&
           firstCountOffset == CsgcHeaderSize +
               firstDirectory.sectionOffsets[1] &&
           firstRowEnd > firstRowStart &&
           secondRowEnd == rawbytes.BytesLen(first.bytes),
           "canonical row boundaries invalid") != 0:
        return 1
    var swappedRows =
        rawbytes.BytesAlloc(
            rawbytes.BytesLen(first.bytes))
    rawbytes.BytesCopyRangeInto(
        swappedRows, 0,
        first.bytes, 0, firstRowStart)
    let secondRowLength =
        secondRowEnd - firstRowEnd
    rawbytes.BytesCopyRangeInto(
        swappedRows, firstRowStart,
        first.bytes, firstRowEnd,
        secondRowLength)
    let firstRowLength =
        firstRowEnd - firstRowStart
    rawbytes.BytesCopyRangeInto(
        swappedRows,
        firstRowStart + secondRowLength,
        first.bytes, firstRowStart,
        firstRowLength)
    if !refreshSectionDigest(swappedRows, 1):
        return smokeFail("fact ordering digest refresh failed")
    if expectDecodeError(
           swappedRows,
           "non_canonical_csgc",
           "fact ordering") != 0:
        return 1

    let singleDirectory =
        csgc.CsgCoreCsgcParseSectionDirectory(single.bytes)
    let singleCountOffset =
        bodyFactCountOffset(single.bytes)
    let singleRowStart = singleCountOffset + 4
    let singleRowEnd = rowEnd(
        single.bytes, singleRowStart)
    if expect(
           singleDirectory.ok &&
           singleCountOffset == CsgcHeaderSize +
               singleDirectory.sectionOffsets[1] &&
           singleRowEnd == rawbytes.BytesLen(single.bytes),
           "single row boundaries invalid") != 0:
        return 1
    let singleTokenCount =
        readVarint(single.bytes, singleRowStart)
    if expect(
           singleTokenCount.ok &&
           singleTokenCount.value > 0 &&
           singleTokenCount.nextOffset <
               rawbytes.BytesLen(single.bytes),
           "single token boundary invalid") != 0:
        return 1
    var unknownTokenTag = cloneBytes(single.bytes)
    rawbytes.BytesSet(
        unknownTokenTag,
        singleTokenCount.nextOffset,
        3)
    if !refreshSectionDigest(unknownTokenTag, 1):
        return smokeFail("token tag digest refresh failed")
    if expectDecodeError(
           unknownTokenTag,
           "unsupported_token_tag",
           "unknown token tag") != 0:
        return 1
    let singleRowLength =
        singleRowEnd - singleRowStart
    var duplicateFact =
        rawbytes.BytesAlloc(
            rawbytes.BytesLen(single.bytes) +
            singleRowLength)
    rawbytes.BytesCopyInto(
        duplicateFact, 0, single.bytes)
    rawbytes.BytesCopyRangeInto(
        duplicateFact,
        rawbytes.BytesLen(single.bytes),
        single.bytes, singleRowStart,
        singleRowLength)
    writeU32Le(duplicateFact, 8, 2)
    writeU32Le(duplicateFact, singleCountOffset, 2)
    let duplicateFactEntry =
        sectionEntryOffsets(duplicateFact, 1)
    if !duplicateFactEntry.ok:
        return smokeFail("duplicate fact section entry missing")
    if !singleDirectory.ok:
        return smokeFail("single fact directory invalid")
    writeU32Le(
        duplicateFact,
        duplicateFactEntry.payloadLengthField,
        singleDirectory.sectionLengths[1] + singleRowLength)
    writeU32Le(
        duplicateFact,
        duplicateFactEntry.itemCountField,
        2)
    writeU32Le(
        duplicateFact, 16,
        rawbytes.BytesLen(duplicateFact) - 64)
    if !refreshSectionDigest(duplicateFact, 1):
        return smokeFail("duplicate fact digest refresh failed")
    if expectDecodeError(
           duplicateFact,
           "non_canonical_facts csgc_physical_order_failed merkle_duplicate_fact_key",
           "duplicate fact key") != 0:
        return 1

    let dictionaryInsertOffset =
        CsgcHeaderSize +
        singleDirectory.sectionOffsets[0] +
        singleDirectory.sectionLengths[0]
    var extraDictionary = rawbytes.BytesAlloc(
        rawbytes.BytesLen(single.bytes) + 3)
    rawbytes.BytesCopyRangeInto(
        extraDictionary, 0,
        single.bytes, 0, dictionaryInsertOffset)
    rawbytes.BytesSet(extraDictionary, dictionaryInsertOffset, 2)
    rawbytes.BytesSet(extraDictionary, dictionaryInsertOffset + 1, 120)
    rawbytes.BytesSet(extraDictionary, dictionaryInsertOffset + 2, 120)
    rawbytes.BytesCopyRangeInto(
        extraDictionary, dictionaryInsertOffset + 3,
        single.bytes, dictionaryInsertOffset,
        rawbytes.BytesLen(single.bytes) - dictionaryInsertOffset)
    let extraDictionaryEntry =
        sectionEntryOffsets(extraDictionary, 0)
    let shiftedFactEntry =
        sectionEntryOffsets(extraDictionary, 1)
    if !extraDictionaryEntry.ok || !shiftedFactEntry.ok:
        return smokeFail("dictionary section entries missing")
    writeU32Le(
        extraDictionary,
        CsgcHeaderSize + singleDirectory.sectionOffsets[0],
        1)
    writeU32Le(
        extraDictionary,
        extraDictionaryEntry.payloadLengthField,
        singleDirectory.sectionLengths[0] + 3)
    writeU32Le(
        extraDictionary,
        extraDictionaryEntry.itemCountField,
        1)
    writeU32Le(
        extraDictionary,
        shiftedFactEntry.payloadOffsetField,
        singleDirectory.sectionOffsets[1] + 3)
    writeU32Le(
        extraDictionary, 16,
        rawbytes.BytesLen(extraDictionary) - 64)
    if !refreshSectionDigest(extraDictionary, 0) ||
       !refreshSectionDigest(extraDictionary, 1):
        return smokeFail("extra dictionary digest refresh failed")
    if expectDecodeError(
           extraDictionary,
           "non_canonical_dictionary",
           "extra dictionary entry") != 0:
        return 1

    var invalidUtf8 = cloneBytes(single.bytes)
    let firstTokenTagOffset = singleTokenCount.nextOffset
    let firstTokenLength =
        readVarint(single.bytes, firstTokenTagOffset + 1)
    if rawbytes.BytesGet(single.bytes, firstTokenTagOffset) != 2 ||
       !firstTokenLength.ok || firstTokenLength.value <= 0:
        return smokeFail("inline UTF-8 token missing")
    rawbytes.BytesSet(
        invalidUtf8, firstTokenLength.nextOffset, 255)
    if !refreshSectionDigest(invalidUtf8, 1):
        return smokeFail("invalid UTF-8 digest refresh failed")
    if expectDecodeError(
           invalidUtf8, "invalid_utf8", "invalid UTF-8") != 0:
        return 1

    var nonMinimal =
        rawbytes.BytesAlloc(
            rawbytes.BytesLen(single.bytes) + 1)
    rawbytes.BytesCopyRangeInto(
        nonMinimal, 0,
        single.bytes, 0, singleRowStart)
    rawbytes.BytesSet(
        nonMinimal, singleRowStart,
        singleTokenCount.value | 128)
    rawbytes.BytesSet(nonMinimal, singleRowStart + 1, 0)
    rawbytes.BytesCopyRangeInto(
        nonMinimal, singleRowStart + 2,
        single.bytes, singleTokenCount.nextOffset,
        rawbytes.BytesLen(single.bytes) -
            singleTokenCount.nextOffset)
    let nonMinimalEntry =
        sectionEntryOffsets(nonMinimal, 1)
    if !nonMinimalEntry.ok:
        return smokeFail("non-minimal section entry missing")
    writeU32Le(
        nonMinimal,
        nonMinimalEntry.payloadLengthField,
        singleDirectory.sectionLengths[1] + 1)
    writeU32Le(
        nonMinimal, 16,
        rawbytes.BytesLen(nonMinimal) - 64)
    if !refreshSectionDigest(nonMinimal, 1):
        return smokeFail("non-minimal digest refresh failed")
    if expectDecodeError(
           nonMinimal,
           "truncated_token_count non_canonical_varint",
           "non-minimal varint") != 0:
        return 1

    let dictionaryCargo =
        csgc.CsgCoreCsgcEncodeCanonicalLines([
            "{\"aa\":\"v\",\"bb\":\"w\",\"id\":\"a\",\"kind\":\"x\"}",
            "{\"aa\":\"v\",\"bb\":\"w\",\"id\":\"b\",\"kind\":\"x\"}"
        ])
    if expect(
           dictionaryCargo.ok,
           "dictionary cargo encode failed") != 0:
        return 1
    var duplicateDictionary =
        cloneBytes(dictionaryCargo.bytes)
    let dictionaryDirectory =
        csgc.CsgCoreCsgcParseSectionDirectory(
            duplicateDictionary)
    if !dictionaryDirectory.ok ||
       dictionaryDirectory.sectionItemCounts[0] < 2:
        return smokeFail("duplicate dictionary source invalid")
    let dictionaryStart = CsgcHeaderSize +
        dictionaryDirectory.sectionOffsets[0] + 4
    let firstDictionaryLength =
        readVarint(duplicateDictionary, dictionaryStart)
    let secondDictionaryLength = readVarint(
        duplicateDictionary,
        firstDictionaryLength.nextOffset +
            firstDictionaryLength.value)
    if !firstDictionaryLength.ok ||
       !secondDictionaryLength.ok ||
       firstDictionaryLength.value != secondDictionaryLength.value:
        return smokeFail("equal-size dictionary entries missing")
    rawbytes.BytesCopyRangeInto(
        duplicateDictionary,
        secondDictionaryLength.nextOffset,
        duplicateDictionary,
        firstDictionaryLength.nextOffset,
        firstDictionaryLength.value)
    if !refreshSectionDigest(duplicateDictionary, 0):
        return smokeFail("duplicate dictionary digest refresh failed")
    if expectDecodeError(
           duplicateDictionary,
           "duplicate_dictionary_entry",
           "duplicate dictionary") != 0:
        return 1

    os.WriteLine(
        os.Get_stdout(),
        "csg_core_csgc_canonical_smoke ok")
    return 0
