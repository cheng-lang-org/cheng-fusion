import std/result
import std/rawbytes
import cheng/apps/vpn_proxy/transport_tcp_tls_record as rec

fn smokeBytes(count: int32, base: int32): Bytes =
    var out: Bytes = BytesAlloc(count)
    for i in 0..<count:
        BytesSet(out, i, (base + i) & 255)
    return out

fn main(): int32 =
    let hello: Bytes = BytesFromString("client-hello")
    let plainRes: Result[Bytes] = rec.VpnProxyTcpTlsRecordBuildPlain(rec.VpnProxyTcpTlsRecordContentTypeHandshake(),
                                                                     hello)
    assert(!IsErr(plainRes), " tcp-tls-record plain build")
    let plainParseRes: Result[rec.VpnProxyTcpTlsRecordPlain] = rec.VpnProxyTcpTlsRecordParsePlain(Value(plainRes))
    assert(!IsErr(plainParseRes), " tcp-tls-record plain parse")
    assert(Value(plainParseRes).contentType == rec.VpnProxyTcpTlsRecordContentTypeHandshake(),
           " tcp-tls-record plain content type")
    assert(BytesEqual(Value(plainParseRes).payload, hello), " tcp-tls-record plain payload")

    let key: Bytes = smokeBytes(16, 7)
    let iv: Bytes = smokeBytes(12, 33)
    let sendKeysRes: Result[rec.VpnProxyTcpTlsRecordKeys] = rec.VpnProxyTcpTlsRecordInitKeys(key, iv)
    assert(!IsErr(sendKeysRes), " tcp-tls-record send keys")
    let recvKeysRes: Result[rec.VpnProxyTcpTlsRecordKeys] = rec.VpnProxyTcpTlsRecordInitKeys(key, iv)
    assert(!IsErr(recvKeysRes), " tcp-tls-record recv keys")
    var sendKeys: rec.VpnProxyTcpTlsRecordKeys = Value(sendKeysRes)
    var recvKeys: rec.VpnProxyTcpTlsRecordKeys = Value(recvKeysRes)
    let payload: Bytes = BytesFromString("encrypted-forward-frame")
    let encRes: Result[Bytes] = rec.VpnProxyTcpTlsRecordEncrypt(sendKeys,
                                                                rec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
                                                                payload)
    assert(!IsErr(encRes), " tcp-tls-record encrypt")
    let decRes: Result[rec.VpnProxyTcpTlsRecordPlain] = rec.VpnProxyTcpTlsRecordDecrypt(recvKeys, Value(encRes))
    assert(!IsErr(decRes), " tcp-tls-record decrypt")
    assert(Value(decRes).contentType == rec.VpnProxyTcpTlsRecordContentTypeApplicationData(),
           " tcp-tls-record encrypted content type")
    assert(BytesEqual(Value(decRes).payload, payload), " tcp-tls-record encrypted payload")
    assert(sendKeys.seq == int64(1), " tcp-tls-record send seq")
    assert(recvKeys.seq == int64(1), " tcp-tls-record recv seq")

    var tampered: Bytes = BytesSlice(Value(encRes), 0, BytesLen(Value(encRes)))
    BytesSet(tampered, BytesLen(tampered) - 1, BytesGet(tampered, BytesLen(tampered) - 1) ^ 1)
    let recvKeys2Res: Result[rec.VpnProxyTcpTlsRecordKeys] = rec.VpnProxyTcpTlsRecordInitKeys(key, iv)
    assert(!IsErr(recvKeys2Res), " tcp-tls-record tamper keys")
    var recvKeys2: rec.VpnProxyTcpTlsRecordKeys = Value(recvKeys2Res)
    let badRes: Result[rec.VpnProxyTcpTlsRecordPlain] = rec.VpnProxyTcpTlsRecordDecrypt(recvKeys2, tampered)
    assert(IsErr(badRes), " tcp-tls-record tamper reject")

    echo(" vpn_proxy_tcp_tls_record_smoke ok")
    return 0
