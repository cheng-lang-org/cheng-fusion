import cheng/core/lang/typed_expr as texpr
import cheng/core/ir/core_types as coreir

fn AddOther(kinds: var texpr.TypedExprIrStatementKind[],
            other: coreir.BodyOpKind) =
    add(kinds, other)

fn main(): int32 =
    var kinds: texpr.TypedExprIrStatementKind[]
    AddOther(kinds, coreir.BodyOpReturn)
    return 0
