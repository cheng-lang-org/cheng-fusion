module tk_varformal_borrow_probe

type Holder =
    items: str[]

fn SortTwo(values: var str[]) =
    if values.len > 1 && values[0] > values[1]:
        let tmp = values[0]
        values[0] = values[1]
        values[1] = tmp

fn main(): int32 =
    var h: Holder
    h.items = ["b", "a"]
    var view = h.items
    SortTwo(view)
    if h.items[0] != "a" || h.items[1] != "b":
        return 1
    if view[0] != "a" || view[1] != "b":
        return 2
    return 0

main()
