fn AddPair(left: int32, right: int32): int32 =
    return left + right

fn Keep(value: int64): int64 =
    return value

fn Choose(flag: bool): int64 =
    return flag ? Int64(42) :
        Int64(0)

fn main(): int32 =
    let nested: int64 = Int64(AddPair(
                                  20,
                                  22))
    let startsOnNextLine: int64 = Int64(
        AddPair(
            19,
            23))
    let ternaryCallArg: int64 = Keep(nested == Int64(42) ?
                                         Int64(42) : Int64(0))
    let multilineTernary: int64 = nested == Int64(42) ?
        Int64(42) :
        Int64(0)
    let alignedTernary: int64 =
        nested == Int64(42) ? Int64(42) :
        Int64(0)
    let returnTernary = Choose(true)
    if nested != Int64(42):
        return 1
    if startsOnNextLine != Int64(42):
        return 2
    if ternaryCallArg != Int64(42):
        return 3
    if multilineTernary != Int64(42):
        return 4
    if returnTernary != Int64(42):
        return 5
    if alignedTernary != Int64(42):
        return 6
    return 0

main()
