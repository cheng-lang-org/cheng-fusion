import cheng/core/backend/primary_object_plan as pobj
import cheng/core/backend/direct_object_emit as direct
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256

fn testCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(64)
    for i in 0..<len(label):
        layout.ByteBufAppendByte(buf, int32(label[i]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn main(): int32 =
    var plan: pobj.PrimaryObjectPlan
    plan.actualBackendKind = "primary"
    plan.targetTriple = "riscv64-unknown-linux-gnu"
    add(plan.itemIds, 100000)
    add(plan.symbolNames, "辅助函数")
    add(plan.symbolTypedFunctionIndexes, 7)
    add(plan.symbolNameIds, 42)
    add(plan.symbolRoles, pobj.PrimaryObjectSymbolRoleTypedName)
    add(plan.symbolInterfaceCids, testCid("function-interface"))
    plan.symbolNameInternPoolDomainCid = testCid("pool-domain")
    plan.symbolLoweringIdentityReceiptCid = testCid("lowering-identity")
    plan.symbolIdentityReceiptCid =
        pobj.PrimaryObjectPlanSymbolIdentityReceiptCid(plan)

    var err: str
    assert(pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(plan, err),
           err)

    plan.symbolNameIds[0] = 43
    assert(!pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(plan, err),
           "InternId mutation must invalidate the immutable receipt")
    plan.symbolNameIds[0] = 42
    plan.symbolIdentityReceiptCid =
        pobj.PrimaryObjectPlanSymbolIdentityReceiptCid(plan)
    assert(pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(plan, err),
           err)

    plan.symbolNames[0] = "任意UTF-8名字"
    assert(!pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(plan, err),
           "UTF-8 byte mutation must invalidate the immutable receipt")
    plan.symbolIdentityReceiptCid =
        pobj.PrimaryObjectPlanSymbolIdentityReceiptCid(plan)
    assert(pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(plan, err),
           err)

    plan.symbolRoles[0] = pobj.PrimaryObjectSymbolRoleSyntheticEntryBridge
    plan.symbolTypedFunctionIndexes[0] = 7
    plan.symbolNameIds[0] = 42
    plan.symbolIdentityReceiptCid =
        pobj.PrimaryObjectPlanSymbolIdentityReceiptCid(plan)
    assert(!pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(plan, err),
           "synthetic entry must not carry TypedExpr or InternId identity")

    plan.symbolRoles[0] = pobj.PrimaryObjectSymbolRoleTypedName
    plan.symbolIdentityReceiptCid =
        pobj.PrimaryObjectPlanSymbolIdentityReceiptCid(plan)
    assert(pobj.PrimaryObjectPlanSymbolIdentityStrictValidateInto(plan, err),
           err)
    let incompleteObject = direct.DirectObjectEmitValidatePlanObject(plan)
    assert(!incompleteObject.ok,
           "incomplete object shape must hard-fail after identity admission")

    echo("primary_exact_symbol_identity_smoke=pass")
    echo(layout.FixedBytes32Hex(plan.symbolNameInternPoolDomainCid))
    return 0
