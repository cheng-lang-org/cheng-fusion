type Color = enum
  Red
  Green
  Blue

fn pick(c: Color): int32 =
  case c
  of Red:
    return 1
  of Green:
    return 2
  of Blue:
    return 3
  else:
    return 9

fn main(): int32 =
  let a: int32 = pick(Color.Red)
  let b: int32 = pick(Color.Green)
  let c: int32 = pick(Color.Blue)
  if a == 1:
    if b == 2:
      if c == 3:
        echo("t_match=pass")
        return 0
  echo("t_match=fail")
  return 101
