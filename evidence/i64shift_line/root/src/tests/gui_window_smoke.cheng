import std/gui as gui

fn main(): int32 =
    gui.Log("Cheng GUI starting")
    gui.Init()
    var win = gui.CreateWindow("Cheng Native Window", 800, 600)
    gui.ShowWindow(win)

    var counter: int32
    while counter < 180:
        gui.ProcessFrame()
        gui.SleepMs(16)
        counter = counter + 1

    gui.CloseWindow(win)
    gui.Log("Cheng GUI done")
    return 0
