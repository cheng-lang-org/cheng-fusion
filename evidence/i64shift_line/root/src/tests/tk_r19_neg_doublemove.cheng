fn R19Trim(raw: str): str =
    return raw

fn R19NegDouble(lineRaw: str): int32 =
    let line = R19Trim(lineRaw)
    var a: str
    var b: str
    a = line
    b = line
    return a.len + b.len

fn main(): int32 =
    let n = R19NegDouble("abcdef")
    if n != 12:
        return 10
    echo("neg2 reached")
    return 0
