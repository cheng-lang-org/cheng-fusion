type
    ColdGlobalFe =
        v0: int64
        v1: int64
        v2: int64
        v3: int64
        v4: int64
        v5: int64
        v6: int64
        v7: int64
        v8: int64
        v9: int64

var ColdGlobalA: ColdGlobalFe
var ColdGlobalReady: bool

fn ColdGlobalInit(out: var ColdGlobalFe, base: int64) =
    out.v0 = base
    out.v1 = base + int64(1)
    out.v2 = base + int64(2)
    out.v3 = base + int64(3)
    out.v4 = base + int64(4)
    out.v5 = base + int64(5)
    out.v6 = base + int64(6)
    out.v7 = base + int64(7)
    out.v8 = base + int64(8)
    out.v9 = base + int64(9)

fn ColdGlobalEnsure() =
    if ColdGlobalReady:
        return
    ColdGlobalInit(ColdGlobalA, int64(30))
    ColdGlobalReady = true

fn ColdGlobalReadValue(f: ColdGlobalFe): int32 =
    return int32(f.v0 + f.v9)

fn ColdGlobalReadThroughVar(f: ColdGlobalFe): int32 =
    return ColdGlobalReadVar(f)

fn ColdGlobalReadVar(f: var ColdGlobalFe): int32 =
    return int32(f.v1 + f.v8)

fn main(): int32 =
    ColdGlobalEnsure()
    if int32(ColdGlobalA.v0) != 30:
        return 1
    if int32(ColdGlobalA.v9) != 39:
        return 2
    if ColdGlobalReadValue(ColdGlobalA) != 69:
        return 3
    if ColdGlobalReadThroughVar(ColdGlobalA) != 69:
        return 4
    var local: ColdGlobalFe
    ColdGlobalInit(local, int64(50))
    if ColdGlobalReadValue(local) != 109:
        return 5
    if ColdGlobalReadThroughVar(local) != 109:
        return 6
    return 0
