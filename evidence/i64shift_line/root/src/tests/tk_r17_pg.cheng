# R17 probe G: return a MANAGED (str-bearing) value-struct global
import std/system

type
    R17Managed =
        tag: str
        n: int32

var tkR17GG: R17Managed

fn TkR17RetManagedGlobal(): R17Managed =
    return tkR17GG

fn main(): int32 =
    let v = TkR17RetManagedGlobal()
    if v.n != 0:
        return 10
    echo("tk_r17_pg ok")
    return 0
