module cold_global_ref_object_borrow_smoke

import std/atomic

var sharedState: atomic.I32

fn TryClaimSharedState(): bool =
    if sharedState == nil:
        return false
    return atomic.CasI32(sharedState, 0, 1)

fn main(): int32 =
    sharedState = atomic.NewI32(0)
    if !TryClaimSharedState():
        return 1
    atomic.StoreI32(sharedState, 0)
    return 0
