import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_access as access
import cheng/core/ir/body_ir_cfg as cfg
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_aarch64_adapter as adapter
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/aarch64_encode as a64

fn wordsEndWith(words: var int32[], suffix: var int32[]): bool =
    if suffix.len <= 0 || suffix.len > words.len:
        return false
    let start = words.len - suffix.len
    for index in 0..<suffix.len:
        if words[start + index] != suffix[index]:
            return false
    return true

fn makeI32Slot(id: int32, isParam: bool): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "v"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + id * 8
    if isParam:
        slot.stackOffset = 0 - 1 - id
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makeAggregateSlot(id: int32, isParam: bool): ir.LocalSlot =
    var slot = makeI32Slot(id, isParam)
    slot.typeKind = ir.LocalAggregateTag
    slot.stackOffset = 16 + id * 16
    if isParam:
        slot.stackOffset = 0 - 1 - id
    slot.sizeBytes = 16
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makeWideAggregateSlot(id: int32): ir.LocalSlot =
    var slot = makeAggregateSlot(id, false)
    slot.sizeBytes = 24
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makePtrSlot(id: int32, isParam: bool): ir.LocalSlot =
    var slot = makeI32Slot(id, isParam)
    slot.typeKind = ir.LocalPtrTag
    slot.sizeBytes = 8
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makeStrSlot(id: int32, isParam: bool): ir.LocalSlot =
    var slot = makeI32Slot(id, isParam)
    slot.typeKind = ir.LocalStrTag
    slot.sizeBytes = 24
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn appendCopy(body: var ir.BodyIR, target: int32, source: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpCopyLocalTag
    op.target = target
    add(op.operands, source)
    add(body.ops, op)

fn appendVoidReturn(body: var ir.BodyIR): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    return ir.BodyIRAppendTerm(body, term)

fn appendBr(body: var ir.BodyIR, target: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermBrTag
    term.trueBlock = target
    return ir.BodyIRAppendTerm(body, term)

fn appendCbr(body: var ir.BodyIR,
             conditionSlot: int32,
             trueBlock: int32,
             falseBlock: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermCbrTag
    term.conditionKind = ir.BodyCondLocalNonZeroTag
    term.resultSlot = conditionSlot
    term.lhsSlot = conditionSlot
    term.rhsSlot = -1
    term.trueBlock = trueBlock
    term.falseBlock = falseBlock
    return ir.BodyIRAppendTerm(body, term)

fn appendCall(body: var ir.BodyIR,
              targetSymbol: str,
              resultSlot: int32,
              argSlots: var int32[]) =
    var call: ir.CallOp
    call.targetSymbol = targetSymbol
    call.resultSlot = resultSlot
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    for argIndex in 0..<argSlots.len:
        add(call.argSlots, argSlots[argIndex])
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = resultSlot
    add(op.operands, body.callSequence.len - 1)
    add(body.ops, op)

fn callerOnlyConstraints(): alloc.RegallocTargetConstraints =
    var out = alloc.RegallocTargetConstraintsInit()
    for reg in 0..<10:
        add(out.registerUniverse, reg)
    add(out.registerUniverse, 16)
    add(out.allocatableCallerRegs, 9)
    for reg in 0..<9:
        add(out.reservedRegs, reg)
    add(out.reservedRegs, 16)
    for reg in 0..<10:
        add(out.callClobberRegs, reg)
    for reg in 0..<8:
        add(out.fixedArgRegs, reg)
    out.fixedResultReg = 0
    out.fixedSretReg = 8
    out.fixedReturnReg = 0
    out.parallelCopyScratchReg = 16
    add(out.gprTypeKinds, ir.LocalI32Tag)
    add(out.gprTypeKinds, ir.LocalI64Tag)
    add(out.gprTypeKinds, ir.LocalPtrTag)
    return out

fn zeroAllocConstraints(): alloc.RegallocTargetConstraints =
    var out = alloc.RegallocTargetConstraintsInit()
    for reg in 0..<9:
        add(out.registerUniverse, reg)
    add(out.registerUniverse, 16)
    for reg in 0..<9:
        add(out.reservedRegs, reg)
    add(out.reservedRegs, 16)
    for reg in 0..<9:
        add(out.callClobberRegs, reg)
    for reg in 0..<8:
        add(out.fixedArgRegs, reg)
    out.fixedResultReg = 0
    out.fixedSretReg = 8
    out.fixedReturnReg = 0
    out.parallelCopyScratchReg = 16
    add(out.gprTypeKinds, ir.LocalI32Tag)
    add(out.gprTypeKinds, ir.LocalI64Tag)
    add(out.gprTypeKinds, ir.LocalPtrTag)
    return out

fn appendReturn(body: var ir.BodyIR, slotIndex: int32): int32 =
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, ir.LocalI32Tag)
    return ir.BodyIRAppendTerm(body, term)

fn buildDirectCallBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, false))
    var call: ir.CallOp
    call.targetSymbol = "adapter_real_callee"
    call.resultSlot = 1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, 0)
    add(call.argPassKinds, ir.BodyCallPassStackValueTag)
    add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = 1
    add(op.operands, 0)
    add(body.ops, op)
    let termIndex = appendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildConstBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, false))
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 70000)
    add(body.ops, op)
    let termIndex = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildPressureBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, true))
    add(body.localSlots, makeI32Slot(2, false))
    add(body.localSlots, makeI32Slot(3, false))
    appendCopy(body, 2, 1)
    appendCopy(body, 3, 2)
    let termIndex = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    return body

fn buildCoalescedCopyBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, false))
    appendCopy(body, 1, 0)
    let termIndex = appendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildCrossCallBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, false))
    var noArgs: int32[]
    appendCall(body, "cross_call", 1, noArgs)
    let termIndex = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildStackResultBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, false))
    var noArgs: int32[]
    appendCall(body, "stack_result", 0, noArgs)
    let termIndex = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildStackArgBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    var args: int32[]
    for slotIndex in 0..<9:
        add(body.localSlots, makeI32Slot(slotIndex, true))
        add(args, slotIndex)
    appendCall(body, "nine_args", -1, args)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildSretCallBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeAggregateSlot(0, false))
    var call: ir.CallOp
    call.targetSymbol = "make_aggregate"
    call.resultSlot = 0
    call.resultPassKind = ir.BodyCallPassSretResultTag
    call.relocWordOffset = -1
    add(body.callSequence, call)
    var op: ir.BodyOp
    op.kind = ir.BodyOpCallTag
    op.target = 0
    add(op.operands, 0)
    add(body.ops, op)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildSretReturnBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeAggregateSlot(0, true))
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, termIndex)
    return body

fn appendWideFieldStore(body: var ir.BodyIR,
                        valueSlot: int32,
                        byteOffset: int32) =
    var store: ir.BodyOp
    store.kind = ir.BodyOpFieldStoreTag
    store.target = 0
    add(store.operands, 0)
    add(store.operands, valueSlot)
    add(store.operands, byteOffset)
    add(store.operands, 4)
    add(body.ops, store)

fn buildWideAggregateInitBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeWideAggregateSlot(0))
    for fieldIndex in 0..<6:
        var fieldSlot = makeI32Slot(fieldIndex + 1, true)
        fieldSlot.stackOffset = 0 - 1 - fieldIndex
        add(body.localSlots, fieldSlot)
        appendWideFieldStore(body, fieldIndex + 1, fieldIndex * 4)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 6, termIndex)
    return body

fn buildIndexedAggregateInitBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeWideAggregateSlot(0))
    var valueSlot = makeI32Slot(1, true)
    valueSlot.stackOffset = -1
    add(body.localSlots, valueSlot)
    var indexSlot = makeI32Slot(2, true)
    indexSlot.stackOffset = -2
    add(body.localSlots, indexSlot)
    var store: ir.BodyOp
    store.kind = ir.BodyOpIndexedStoreTag
    store.target = 0
    add(store.operands, 0)
    add(store.operands, 1)
    add(store.operands, 2)
    add(store.operands, 4)
    add(body.ops, store)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 0
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn makeWideAggregateParamSlot(id: int32,
                              ordinal: int32): ir.LocalSlot =
    var slot = makeWideAggregateSlot(id)
    slot.stackOffset = 0 - 1 - ordinal
    slot.placeKind = ir.BodyPlaceParamAddressTag
    slot.auxValue = ir.LocalStrTag
    return slot

fn appendIndexedStore(body: var ir.BodyIR,
                      baseSlot: int32,
                      valueSlot: int32,
                      indexSlot: int32) =
    var store: ir.BodyOp
    store.kind = ir.BodyOpIndexedStoreTag
    store.target = baseSlot
    add(store.operands, baseSlot)
    add(store.operands, valueSlot)
    add(store.operands, indexSlot)
    add(store.operands, 4)
    add(body.ops, store)

fn appendFieldLoad(body: var ir.BodyIR,
                   baseSlot: int32,
                   targetSlot: int32,
                   byteOffset: int32) =
    var load: ir.BodyOp
    load.kind = ir.BodyOpFieldLoadTag
    load.target = targetSlot
    add(load.operands, baseSlot)
    add(load.operands, targetSlot)
    add(load.operands, byteOffset)
    add(load.operands, 4)
    add(body.ops, load)

fn appendIndexedLoad(body: var ir.BodyIR,
                     baseSlot: int32,
                     targetSlot: int32,
                     indexSlot: int32) =
    var load: ir.BodyOp
    load.kind = ir.BodyOpIndexedLoadTag
    load.target = targetSlot
    add(load.operands, baseSlot)
    add(load.operands, targetSlot)
    add(load.operands, indexSlot)
    add(load.operands, 4)
    add(body.ops, load)

fn appendI32Eq(body: var ir.BodyIR,
               targetSlot: int32,
               lhsSlot: int32,
               rhsSlot: int32) =
    var compare: ir.BodyOp
    compare.kind = ir.BodyOpCmpTag
    compare.target = targetSlot
    add(compare.operands, ir.BodyCondI32EqTag)
    add(compare.operands, lhsSlot)
    add(compare.operands, rhsSlot)
    add(body.ops, compare)

fn buildAggregateParamMemoryBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeWideAggregateParamSlot(0, 0))
    var valueSlot = makeI32Slot(1, true)
    valueSlot.stackOffset = -2
    add(body.localSlots, valueSlot)
    var indexSlot = makeI32Slot(2, true)
    indexSlot.stackOffset = -3
    add(body.localSlots, indexSlot)
    add(body.localSlots, makeI32Slot(3, false))
    add(body.localSlots, makeI32Slot(4, false))
    add(body.localSlots, makeI32Slot(5, false))
    appendWideFieldStore(body, 1, 0)
    appendIndexedStore(body, 0, 1, 2)
    appendFieldLoad(body, 0, 3, 4)
    appendIndexedLoad(body, 0, 4, 2)
    appendI32Eq(body, 5, 3, 4)
    let termIndex = appendReturn(body, 5)
    let _ = ir.BodyIRAppendBlock(body, 0, 5, termIndex)
    return body

fn buildDynamicSeqIndexedBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeWideAggregateParamSlot(0, 0))
    var valueSlot = makeI32Slot(1, true)
    valueSlot.stackOffset = -2
    add(body.localSlots, valueSlot)
    var indexSlot = makeI32Slot(2, true)
    indexSlot.stackOffset = -3
    add(body.localSlots, indexSlot)
    add(body.localSlots, makeI32Slot(3, false))
    add(body.localSlots, makeI32Slot(4, false))
    var store: ir.BodyOp
    store.kind = ir.BodyOpIndexedStoreTag
    store.target = 0
    add(store.operands, 0)
    add(store.operands, 1)
    add(store.operands, 2)
    add(store.operands, 4)
    add(store.operands, 1)
    add(body.ops, store)
    var load: ir.BodyOp
    load.kind = ir.BodyOpIndexedLoadTag
    load.target = 3
    add(load.operands, 0)
    add(load.operands, 3)
    add(load.operands, 2)
    add(load.operands, 4)
    add(load.operands, 1)
    add(body.ops, load)
    appendI32Eq(body, 4, 1, 3)
    let termIndex = appendReturn(body, 4)
    let _ = ir.BodyIRAppendBlock(body, 0, 3, termIndex)
    return body

fn buildLocalStrFieldLoadBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeStrSlot(0, true))
    add(body.localSlots, makeStrSlot(1, false))
    add(body.localSlots, makeI32Slot(2, false))
    appendCopy(body, 1, 0)
    appendFieldLoad(body, 1, 2, 8)
    let termIndex = appendReturn(body, 2)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    return body

fn buildGlobalAggregateMemoryBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    var global = makeWideAggregateSlot(0)
    global.name = "adapter_global_aggregate"
    global.placeKind = ir.BodyPlaceGlobalAddressTag
    add(body.localSlots, global)
    var valueSlot = makeI32Slot(1, true)
    valueSlot.stackOffset = -1
    add(body.localSlots, valueSlot)
    var indexSlot = makeI32Slot(2, true)
    indexSlot.stackOffset = -2
    add(body.localSlots, indexSlot)
    add(body.localSlots, makeI32Slot(3, false))
    add(body.localSlots, makeI32Slot(4, false))
    add(body.localSlots, makeI32Slot(5, false))
    appendWideFieldStore(body, 1, 0)
    appendIndexedStore(body, 0, 1, 2)
    appendFieldLoad(body, 0, 3, 4)
    appendIndexedLoad(body, 0, 4, 2)
    appendI32Eq(body, 5, 3, 4)
    let termIndex = appendReturn(body, 5)
    let _ = ir.BodyIRAppendBlock(body, 0, 5, termIndex)
    return body

fn buildBorrowAggregateFieldLoadBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeWideAggregateSlot(0))
    var borrow = makeWideAggregateSlot(1)
    borrow.placeKind = ir.BodyPlaceBorrowAddressTag
    borrow.auxValue = 0
    borrow.stackOffset = body.localSlots[0].stackOffset
    add(body.localSlots, borrow)
    add(body.localSlots, makeI32Slot(2, false))
    var call: ir.CallOp
    call.targetSymbol = "make_borrowed_aggregate"
    call.resultSlot = 1
    call.resultPassKind = ir.BodyCallPassSretResultTag
    call.relocWordOffset = -1
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 1
    add(callOp.operands, 0)
    add(body.ops, callOp)
    appendFieldLoad(body, 1, 2, 4)
    let termIndex = appendReturn(body, 2)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    return body

fn buildEdgeBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    add(body.localSlots, makeI32Slot(1, true))
    let entryTerm = appendCbr(body, 0, 2, 1)
    let sideTerm = appendBr(body, 2)
    let joinTerm = appendReturn(body, 1)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, sideTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, joinTerm)
    return body

fn buildDeadBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, false))
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 7)
    add(body.ops, op)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildAddressHomeBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, false))
    add(body.localSlots, makeI32Slot(1, false))
    var constOp: ir.BodyOp
    constOp.kind = ir.BodyOpLoadConstTag
    constOp.target = 0
    add(constOp.operands, ir.LocalI32Tag)
    add(constOp.operands, 9)
    add(body.ops, constOp)
    var call: ir.CallOp
    call.targetSymbol = "mutate_home"
    call.resultSlot = -1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, ir.CallArgSlotAddress(0))
    add(call.argPassKinds, ir.BodyCallPassParamAddressTag)
    add(call.argAbiSizes, 8)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    callOp.kind = ir.BodyOpCallTag
    callOp.target = -1
    add(callOp.operands, 0)
    add(body.ops, callOp)
    appendCopy(body, 1, 0)
    let termIndex = appendReturn(body, 0)
    let _ = ir.BodyIRAppendBlock(body, 0, 3, termIndex)
    return body

fn buildParallelCycleBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, false))
    add(body.localSlots, makeI32Slot(1, false))
    var conditionSlot = makeI32Slot(2, false)
    conditionSlot.stackOffset = -1
    add(body.localSlots, conditionSlot)
    add(body.localSlots, makeI32Slot(3, false))
    var leftOne: ir.BodyOp
    leftOne.kind = ir.BodyOpLoadConstTag
    leftOne.target = 1
    add(leftOne.operands, ir.LocalI32Tag)
    add(leftOne.operands, 1)
    add(body.ops, leftOne)
    var leftZero: ir.BodyOp
    leftZero.kind = ir.BodyOpLoadConstTag
    leftZero.target = 0
    add(leftZero.operands, ir.LocalI32Tag)
    add(leftZero.operands, 2)
    add(body.ops, leftZero)
    var rightZero: ir.BodyOp
    rightZero.kind = ir.BodyOpLoadConstTag
    rightZero.target = 0
    add(rightZero.operands, ir.LocalI32Tag)
    add(rightZero.operands, 3)
    add(body.ops, rightZero)
    var rightOne: ir.BodyOp
    rightOne.kind = ir.BodyOpLoadConstTag
    rightOne.target = 1
    add(rightOne.operands, ir.LocalI32Tag)
    add(rightOne.operands, 4)
    add(body.ops, rightOne)
    var cmp: ir.BodyOp
    cmp.kind = ir.BodyOpCmpTag
    cmp.target = 3
    add(cmp.operands, ir.BodyCondI32EqTag)
    add(cmp.operands, 0)
    add(cmp.operands, 1)
    add(body.ops, cmp)
    let entryTerm = appendCbr(body, 2, 1, 2)
    let changedTerm = appendBr(body, 3)
    let unchangedTerm = appendBr(body, 3)
    let joinTerm = appendReturn(body, 3)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, changedTerm)
    let _ = ir.BodyIRAppendBlock(body, 2, 2, unchangedTerm)
    let _ = ir.BodyIRAppendBlock(body, 4, 1, joinTerm)
    return body

fn buildNoDefStoreAndLegacyControlBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makePtrSlot(0, true))
    add(body.localSlots, makeI32Slot(1, true))
    var globalSlot = makeI32Slot(2, false)
    globalSlot.name = "adapter_global_i32"
    globalSlot.placeKind = ir.BodyPlaceGlobalAddressTag
    add(body.localSlots, globalSlot)
    var indexed: ir.BodyOp
    indexed.kind = ir.BodyOpIndexedStoreTag
    indexed.target = 0
    add(indexed.operands, 0)
    add(indexed.operands, 1)
    add(body.ops, indexed)
    var field: ir.BodyOp
    field.kind = ir.BodyOpFieldStoreTag
    field.target = 0
    add(field.operands, 0)
    add(field.operands, 1)
    add(field.operands, 4)
    add(field.operands, 4)
    add(body.ops, field)
    var globalStore: ir.BodyOp
    globalStore.kind = ir.BodyOpGlobalStoreTag
    globalStore.target = 1
    add(globalStore.operands, 2)
    add(body.ops, globalStore)
    var branch: ir.BodyOp
    branch.kind = ir.BodyOpBranchTag
    branch.target = -1
    add(branch.operands,
        ir.BodyBranchIfLocalLeZeroReturnI32ConstTag)
    add(branch.operands, 1)
    add(branch.operands, 42)
    add(body.ops, branch)
    var legacyReturn: ir.BodyOp
    legacyReturn.kind = ir.BodyOpReturnTag
    legacyReturn.target = 1
    add(legacyReturn.operands, ir.LocalI32Tag)
    add(body.ops, legacyReturn)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 5, termIndex)
    return body

fn buildUnreachableGuardBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, true))
    var panicCall: ir.CallOp
    panicCall.targetSymbol = "unreachable_panic"
    panicCall.resultSlot = -1
    panicCall.resultPassKind = ir.BodyCallPassStackValueTag
    panicCall.relocWordOffset = -1
    add(body.callSequence, panicCall)
    var guard: ir.BodyOp
    guard.kind = ir.BodyOpResultPanicGuardTag
    guard.target = -1
    add(guard.operands, 0)
    add(guard.operands, 0)
    add(body.ops, guard)
    let liveReturn = appendVoidReturn(body)
    let deadReturn = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, liveReturn)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, deadReturn)
    return body

fn buildStrEqBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeStrSlot(0, true))
    add(body.localSlots, makeStrSlot(1, true))
    add(body.localSlots, makeI32Slot(2, false))
    var op: ir.BodyOp
    op.kind = ir.BodyOpStrEqTag
    op.target = 2
    add(op.operands, 0)
    add(op.operands, 1)
    add(body.ops, op)
    let termIndex = appendReturn(body, 2)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildDualEdgeCopyCbrBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    add(body.localSlots, makeI32Slot(0, false))
    add(body.localSlots, makeI32Slot(1, false))
    var conditionSlot = makeI32Slot(2, false)
    conditionSlot.stackOffset = -1
    add(body.localSlots, conditionSlot)
    add(body.localSlots, makeI32Slot(3, false))
    add(body.localSlots, makeI32Slot(4, false))
    var leftOne: ir.BodyOp
    leftOne.kind = ir.BodyOpLoadConstTag
    leftOne.target = 1
    add(leftOne.operands, ir.LocalI32Tag)
    add(leftOne.operands, 1)
    add(body.ops, leftOne)
    var leftZero: ir.BodyOp
    leftZero.kind = ir.BodyOpLoadConstTag
    leftZero.target = 0
    add(leftZero.operands, ir.LocalI32Tag)
    add(leftZero.operands, 2)
    add(body.ops, leftZero)
    var rightZero: ir.BodyOp
    rightZero.kind = ir.BodyOpLoadConstTag
    rightZero.target = 0
    add(rightZero.operands, ir.LocalI32Tag)
    add(rightZero.operands, 3)
    add(body.ops, rightZero)
    var rightOne: ir.BodyOp
    rightOne.kind = ir.BodyOpLoadConstTag
    rightOne.target = 1
    add(rightOne.operands, ir.LocalI32Tag)
    add(rightOne.operands, 4)
    add(body.ops, rightOne)
    var trueCmp: ir.BodyOp
    trueCmp.kind = ir.BodyOpCmpTag
    trueCmp.target = 3
    add(trueCmp.operands, ir.BodyCondI32EqTag)
    add(trueCmp.operands, 0)
    add(trueCmp.operands, 1)
    add(body.ops, trueCmp)
    var falseCmp: ir.BodyOp
    falseCmp.kind = ir.BodyOpCmpTag
    falseCmp.target = 4
    add(falseCmp.operands, ir.BodyCondI32NeTag)
    add(falseCmp.operands, 0)
    add(falseCmp.operands, 1)
    add(body.ops, falseCmp)
    let entryTerm = appendCbr(body, 2, 1, 2)
    let leftTerm = appendCbr(body, 2, 3, 4)
    let rightTerm = appendCbr(body, 2, 3, 4)
    let trueTerm = appendReturn(body, 3)
    let falseTerm = appendReturn(body, 4)
    let _ = ir.BodyIRAppendBlock(body, 0, 0, entryTerm)
    let _ = ir.BodyIRAppendBlock(body, 0, 2, leftTerm)
    let _ = ir.BodyIRAppendBlock(body, 2, 2, rightTerm)
    let _ = ir.BodyIRAppendBlock(body, 4, 1, trueTerm)
    let _ = ir.BodyIRAppendBlock(body, 5, 1, falseTerm)
    return body

fn opFactKindCount(table: var access.BodyIrAccessTable,
                   opIndex: int32,
                   kind: int32): int32 =
    if opIndex < 0 || opIndex >= table.opFactStarts.len ||
       opIndex >= table.opFactCounts.len:
        return -1
    let start = table.opFactStarts[opIndex]
    let count = table.opFactCounts[opIndex]
    if start < 0 || count < 0 || start > table.facts.len - count:
        return -1
    var out: int32
    for factIndex in start..<(start + count):
        if table.facts[factIndex].kind == kind:
            out = out + 1
    return out

fn opFactOperandCount(table: var access.BodyIrAccessTable,
                      opIndex: int32,
                      kind: int32,
                      operandIndex: int32): int32 =
    if opIndex < 0 || opIndex >= table.opFactStarts.len ||
       opIndex >= table.opFactCounts.len:
        return -1
    let start = table.opFactStarts[opIndex]
    let count = table.opFactCounts[opIndex]
    if start < 0 || count < 0 || start > table.facts.len - count:
        return -1
    var out: int32
    for factIndex in start..<(start + count):
        let fact = table.facts[factIndex]
        if fact.kind == kind && fact.operandIndex == operandIndex:
            out = out + 1
    return out

fn opFactMemoryCount(table: var access.BodyIrAccessTable,
                     opIndex: int32,
                     memoryEffect: int32): int32 =
    if opIndex < 0 || opIndex >= table.opFactStarts.len ||
       opIndex >= table.opFactCounts.len:
        return -1
    let start = table.opFactStarts[opIndex]
    let count = table.opFactCounts[opIndex]
    if start < 0 || count < 0 || start > table.facts.len - count:
        return -1
    var out: int32
    for factIndex in start..<(start + count):
        let fact = table.facts[factIndex]
        if fact.kind == access.BodyIrAccessFactMemory &&
           fact.memoryEffect == memoryEffect:
            out = out + 1
    return out

fn opOperandReg(table: var access.BodyIrAccessTable,
                plan: var alloc.RegallocSinglePassValuePlan,
                opIndex: int32,
                operandIndex: int32): int32 =
    if opIndex < 0 || opIndex >= table.opFactStarts.len ||
       opIndex >= table.opFactCounts.len:
        return -1
    let start = table.opFactStarts[opIndex]
    let count = table.opFactCounts[opIndex]
    if start < 0 || count < 0 || start > table.facts.len - count:
        return -1
    for factIndex in start..<(start + count):
        let fact = table.facts[factIndex]
        if fact.kind == access.BodyIrAccessFactUse &&
           fact.operandIndex == operandIndex &&
           factIndex < plan.operandRegByFact.len:
            return plan.operandRegByFact[factIndex]
    return -1

fn producerRecipeIndex(
        plan: var alloc.RegallocSinglePassValuePlan,
        prepared: var contract.RegallocA64FunctionRecipes,
        opIndex: int32,
        opKind: int32): int32 =
    var found: int32 = -1
    for actionIndex in 0..<prepared.recipes.len:
        if actionIndex >= plan.actions.len:
            return -2
        let recipe = prepared.recipes[actionIndex]
        if plan.actions[actionIndex].opIndex != opIndex ||
           recipe.producerOpKind != opKind || !recipe.ownsBodyOp:
            continue
        if found >= 0:
            return -2
        found = actionIndex
    return found

fn actionFragmentEffect(
        prepared: var contract.RegallocA64FunctionRecipes,
        actionIndex: int32): int32 =
    var found: int32 = -1
    for fragmentIndex in 0..<prepared.machineFragments.len:
        let fragment = prepared.machineFragments[fragmentIndex]
        if fragment.actionConsumerOrdinal != actionIndex:
            continue
        if fragment.ownerKind !=
               contract.RegallocA64FragmentOwnerAction:
            continue
        if found >= 0:
            return -2
        found = fragment.effectMask
    return found

fn opFragmentEffect(
        prepared: var contract.RegallocA64FunctionRecipes,
        opIndex: int32): int32 =
    var found: int32 = -1
    for fragmentIndex in 0..<prepared.machineFragments.len:
        let fragment = prepared.machineFragments[fragmentIndex]
        if fragment.ownerKind != contract.RegallocA64FragmentOwnerOp ||
           fragment.siteIndex != opIndex:
            continue
        if found >= 0:
            return -2
        found = fragment.effectMask
    return found

fn regListContains(regs: int32[], reg: int32): bool =
    for index in 0..<regs.len:
        if regs[index] == reg:
            return true
    return false

fn actionDataRelocPairExact(
        recipe: contract.RegallocA64ActionRecipe,
        symbol: str): bool =
    return recipe.relocs.len == 2 &&
           recipe.relocs[0].kind ==
               contract.RegallocA64RelocPage21 &&
           recipe.relocs[0].wordIndex == 0 &&
           recipe.relocs[0].callOrdinal == -1 &&
           recipe.relocs[0].targetSymbol == symbol &&
           recipe.relocs[1].kind ==
               contract.RegallocA64RelocPageOff12 &&
           recipe.relocs[1].wordIndex == 1 &&
           recipe.relocs[1].callOrdinal == -1 &&
           recipe.relocs[1].targetSymbol == symbol

fn siteDataRelocPairExact(
        recipe: contract.RegallocA64SiteRecipe,
        symbol: str): bool =
    return recipe.relocs.len == 2 &&
           recipe.relocs[0].kind ==
               contract.RegallocA64RelocPage21 &&
           recipe.relocs[0].wordIndex == 0 &&
           recipe.relocs[0].callOrdinal == -1 &&
           recipe.relocs[0].targetSymbol == symbol &&
           recipe.relocs[1].kind ==
               contract.RegallocA64RelocPageOff12 &&
           recipe.relocs[1].wordIndex == 1 &&
           recipe.relocs[1].callOrdinal == -1 &&
           recipe.relocs[1].targetSymbol == symbol

fn verifyFieldScalarBaseRejected(): int32 =
    let invalidKinds = [
        ir.LocalI32Tag,
        ir.LocalI64Tag,
        ir.LocalF64Tag,
    ]
    for kindIndex in 0..<invalidKinds.len:
        var body = ir.BodyIRNew()
        var base = makeI32Slot(0, true)
        base.typeKind = invalidKinds[kindIndex]
        if base.typeKind != ir.LocalI32Tag:
            base.sizeBytes = 8
            base.alignBytes = 8
        ir.BodyIRApplyLocalSlotDefaultProof(base)
        add(body.localSlots, base)
        add(body.localSlots, makeI32Slot(1, false))
        appendFieldLoad(body, 0, 1, 0)
        let termIndex = appendReturn(body, 1)
        let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
        let table = access.BodyIrAccessDecode(body)
        if table.valid ||
           table.errorCode != access.BodyIrAccessErrorOperandShape ||
           table.errorSiteKind != access.BodyIrAccessSiteOp ||
           table.errorSiteIndex != 0 ||
           table.errorDetail != invalidKinds[kindIndex]:
            return 176 + kindIndex
    return 0

fn verifyWideAggregateFieldStores(): int32 =
    var body = buildWideAggregateInitBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid:
        return 179
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    if !analysis.valid:
        return 180
    for opIndex in 0..<body.ops.len:
        if table.opFactCounts[opIndex] != 3 ||
           opFactOperandCount(table, opIndex,
                              access.BodyIrAccessFactUse, 0) != 0 ||
           opFactOperandCount(table, opIndex,
                              access.BodyIrAccessFactUse, 1) != 1 ||
           opFactKindCount(table, opIndex,
                           access.BodyIrAccessFactDef) != 1 ||
           opFactMemoryCount(table, opIndex,
                             access.BodyIrAccessMemoryLocalWrite) != 1:
            return 181
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid || !alloc.RegallocSinglePassValuePlanValidate(plan):
        return 182
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid || !prepared.hasSretReturn:
        return 183
    for opIndex in 0..<body.ops.len:
        let actionIndex = producerRecipeIndex(
            plan, prepared, opIndex, ir.BodyOpFieldStoreTag)
        let sourceReg = opOperandReg(table, plan, opIndex, 1)
        if actionIndex < 0 || sourceReg < 0 ||
           !prepared.opRecipes[opIndex].ownedByAction ||
           prepared.opRecipes[opIndex].words.len != 0:
            return 184
        let recipe = prepared.recipes[actionIndex]
        if !recipe.valid || !recipe.ownsBodyOp ||
           !recipe.producerWritesMemoryOnly ||
           recipe.bindingKind != alloc.RegallocValueBindingMachine ||
           recipe.effectMask !=
               (contract.RegallocA64EffectSpStore |
                contract.RegallocA64EffectX17) ||
           recipe.writtenRegs.len != 1 ||
           recipe.writtenRegs[0] != a64.A64X17 ||
           recipe.relocs.len != 0 || recipe.words.len != 2 ||
           recipe.words[0] != Value(a64.A64EncAddImm(
               true, a64.A64X17, a64.A64SP,
               prepared.localStackOffsets[0])) ||
           recipe.words[1] != Value(a64.A64EncStrImm(
               false, sourceReg, a64.A64X17,
               int64(body.ops[opIndex].operands[2]))) ||
           actionFragmentEffect(prepared, actionIndex) !=
               (contract.RegallocA64EffectSpStore |
                contract.RegallocA64EffectX17):
            return 185
    return 0

fn verifyIndexedAggregateStore(): int32 =
    var body = buildIndexedAggregateInitBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid || table.opFactCounts.len != 1 ||
       table.opFactCounts[0] != 4 ||
       opFactOperandCount(table, 0,
                          access.BodyIrAccessFactUse, 0) != 0 ||
       opFactOperandCount(table, 0,
                          access.BodyIrAccessFactUse, 1) != 1 ||
       opFactOperandCount(table, 0,
                          access.BodyIrAccessFactUse, 2) != 1 ||
       opFactKindCount(table, 0, access.BodyIrAccessFactDef) != 1 ||
       opFactMemoryCount(table, 0,
                         access.BodyIrAccessMemoryLocalWrite) != 1:
        return 186
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    if !analysis.valid:
        return 187
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 188
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    let actionIndex = producerRecipeIndex(
        plan, prepared, 0, ir.BodyOpIndexedStoreTag)
    let sourceReg = opOperandReg(table, plan, 0, 1)
    let indexReg = opOperandReg(table, plan, 0, 2)
    if !prepared.valid || !prepared.hasSretReturn ||
       actionIndex < 0 || sourceReg < 0 || indexReg < 0 ||
       !prepared.opRecipes[0].ownedByAction ||
       prepared.opRecipes[0].words.len != 0:
        return 189
    let recipe = prepared.recipes[actionIndex]
    let scratchEffects = contract.RegallocA64EffectSpStore |
                         contract.RegallocA64EffectX16 |
                         contract.RegallocA64EffectX17
    if !recipe.valid || !recipe.ownsBodyOp ||
       !recipe.producerWritesMemoryOnly ||
       recipe.effectMask != scratchEffects ||
       recipe.writtenRegs.len != 2 ||
       recipe.writtenRegs[0] != a64.A64X16 ||
       recipe.writtenRegs[1] != a64.A64X17 ||
       recipe.relocs.len != 0 || recipe.words.len != 4 ||
       recipe.words[0] != Value(a64.A64EncAddImm(
           true, a64.A64X17, a64.A64SP,
           prepared.localStackOffsets[0])) ||
       recipe.words[1] != a64.A64EncMovz(
           true, a64.A64X16, 4, 0) ||
       recipe.words[2] != a64.A64EncMadd(
           true, a64.A64X17, indexReg,
           a64.A64X16, a64.A64X17) ||
       recipe.words[3] != Value(a64.A64EncStrImm(
           false, sourceReg, a64.A64X17, int64(0))) ||
       actionFragmentEffect(prepared, actionIndex) != scratchEffects:
        return 190
    return 0

fn verifyAggregateParamMemory(): int32 =
    var body = buildAggregateParamMemoryBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid:
        return 191
    let expectedFactCounts = [3, 4, 3, 4]
    for opIndex in 0..<4:
        let isStore = opIndex < 2
        var expectedMemory = access.BodyIrAccessMemoryIndirectRead
        var expectedDefCount: int32 = 1
        if isStore:
            expectedMemory = access.BodyIrAccessMemoryIndirectWrite
            expectedDefCount = 0
        if table.opFactCounts[opIndex] !=
               expectedFactCounts[opIndex] ||
           opFactOperandCount(table, opIndex,
                              access.BodyIrAccessFactUse, 0) != 1 ||
           opFactMemoryCount(table, opIndex, expectedMemory) != 1 ||
           opFactKindCount(table, opIndex,
                           access.BodyIrAccessFactDef) != expectedDefCount:
            return 192
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    if !analysis.valid:
        return 193
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 194
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid || prepared.opRecipes.len != body.ops.len ||
       prepared.localStackOffsets[0] < 0:
        return 195
    let baseHome = prepared.localStackOffsets[0]
    let sourceReg = opOperandReg(table, plan, 0, 1)
    let storeIndexReg = opOperandReg(table, plan, 1, 2)
    let expectedBaseLoad = Value(a64.A64EncLdrImm(
        true, a64.A64X17, a64.A64SP, int64(baseHome)))
    let fieldStore = prepared.opRecipes[0]
    let fieldStoreEffects = contract.RegallocA64EffectSpLoad |
                            contract.RegallocA64EffectX17
    if sourceReg < 0 || fieldStore.ownedByAction ||
       fieldStore.machineOwnerKind !=
           contract.RegallocA64SiteOwnerOp ||
       fieldStore.effectMask != fieldStoreEffects ||
       fieldStore.writtenRegs.len != 1 ||
       fieldStore.writtenRegs[0] != a64.A64X17 ||
       fieldStore.relocs.len != 0 || fieldStore.words.len != 2 ||
       fieldStore.words[0] != expectedBaseLoad ||
       fieldStore.words[1] != Value(a64.A64EncStrImm(
           false, sourceReg, a64.A64X17, int64(0))) ||
       opFragmentEffect(prepared, 0) != fieldStoreEffects:
        return 196
    let indexedStore = prepared.opRecipes[1]
    let indexedStoreEffects = fieldStoreEffects |
                              contract.RegallocA64EffectX16
    if storeIndexReg < 0 || indexedStore.ownedByAction ||
       indexedStore.machineOwnerKind !=
           contract.RegallocA64SiteOwnerOp ||
       indexedStore.effectMask != indexedStoreEffects ||
       indexedStore.writtenRegs.len != 2 ||
       indexedStore.writtenRegs[0] != a64.A64X16 ||
       indexedStore.writtenRegs[1] != a64.A64X17 ||
       indexedStore.relocs.len != 0 || indexedStore.words.len != 4 ||
       indexedStore.words[0] != expectedBaseLoad ||
       indexedStore.words[1] !=
           a64.A64EncMovz(true, a64.A64X16, 4, 0) ||
       indexedStore.words[2] != a64.A64EncMadd(
           true, a64.A64X17, storeIndexReg,
           a64.A64X16, a64.A64X17) ||
       indexedStore.words[3] != Value(a64.A64EncStrImm(
           false, sourceReg, a64.A64X17, int64(0))) ||
       opFragmentEffect(prepared, 1) != indexedStoreEffects:
        return 197
    for opIndex in 2..<4:
        let opKind = body.ops[opIndex].kind
        let actionIndex = producerRecipeIndex(
            plan, prepared, opIndex, opKind)
        if actionIndex < 0 ||
           !prepared.opRecipes[opIndex].ownedByAction ||
           prepared.opRecipes[opIndex].words.len != 0:
            return 198
        let recipe = prepared.recipes[actionIndex]
        let targetReg = plan.actions[actionIndex].targetReg
        var expectedEffects = fieldStoreEffects
        var expectedWords: int32 = 2
        var expectedWrittenRegs: int32 = 2
        if opIndex == 3:
            expectedEffects = indexedStoreEffects
            expectedWords = 4
            expectedWrittenRegs = 3
        if targetReg < 0 || targetReg == a64.A64X16 ||
           targetReg == a64.A64X17 || !recipe.ownsBodyOp ||
           recipe.producerWritesMemoryOnly ||
           recipe.effectMask != expectedEffects ||
           recipe.writtenRegs.len != expectedWrittenRegs ||
           !regListContains(recipe.writtenRegs, targetReg) ||
           !regListContains(recipe.writtenRegs, a64.A64X17) ||
           (opIndex == 3 &&
            !regListContains(recipe.writtenRegs, a64.A64X16)) ||
           recipe.relocs.len != 0 ||
           recipe.words.len != expectedWords ||
           recipe.words[0] != expectedBaseLoad ||
           actionFragmentEffect(prepared, actionIndex) != expectedEffects:
            return 199
        if opIndex == 2:
            if recipe.words[1] != Value(a64.A64EncLdrImm(
                   false, targetReg, a64.A64X17, int64(4))):
                return 200
        else:
            let indexReg = opOperandReg(table, plan, opIndex, 2)
            if indexReg < 0 ||
               recipe.words[1] != a64.A64EncMovz(
                   true, a64.A64X16, 4, 0) ||
               recipe.words[2] != a64.A64EncMadd(
                   true, a64.A64X17, indexReg,
                   a64.A64X16, a64.A64X17) ||
               recipe.words[3] != Value(a64.A64EncLdrImm(
                   false, targetReg, a64.A64X17, int64(0))):
                return 201
    return 0

fn verifyLocalStrFieldLoad(): int32 =
    var body = buildLocalStrFieldLoadBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid || table.opFactCounts.len != 2 ||
       table.opFactCounts[1] != 3 ||
       opFactOperandCount(table, 1,
                          access.BodyIrAccessFactUse, 0) != 1 ||
       opFactKindCount(table, 1, access.BodyIrAccessFactDef) != 1 ||
       opFactMemoryCount(table, 1,
                         access.BodyIrAccessMemoryLocalRead) != 1:
        return 202
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    if !analysis.valid:
        return 203
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 204
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    let copyActionIndex = producerRecipeIndex(
        plan, prepared, 0, ir.BodyOpCopyLocalTag)
    let actionIndex = producerRecipeIndex(
        plan, prepared, 1, ir.BodyOpFieldLoadTag)
    if !prepared.valid || copyActionIndex < 0 || actionIndex < 0 ||
       !prepared.opRecipes[0].ownedByAction ||
       prepared.opRecipes[0].words.len != 0 ||
       !prepared.opRecipes[1].ownedByAction ||
       prepared.opRecipes[1].words.len != 0:
        return 205
    let copyRecipe = prepared.recipes[copyActionIndex]
    let copyEffects = contract.RegallocA64EffectSpLoad |
                      contract.RegallocA64EffectSpStore |
                      contract.RegallocA64EffectX16 |
                      contract.RegallocA64EffectX17
    if !copyRecipe.producerWritesMemoryOnly ||
       copyRecipe.effectMask != copyEffects ||
       copyRecipe.writtenRegs.len != 2 ||
       !regListContains(copyRecipe.writtenRegs, a64.A64X16) ||
       !regListContains(copyRecipe.writtenRegs, a64.A64X17) ||
       copyRecipe.relocs.len != 0 || copyRecipe.words.len != 7 ||
       actionFragmentEffect(prepared, copyActionIndex) != copyEffects:
        return 205
    if copyRecipe.words[0] != Value(a64.A64EncLdrImm(
           true, a64.A64X17, a64.A64SP,
           int64(prepared.localStackOffsets[0]))):
        return 205
    for chunkIndex in 0..<3:
        let byteOffset = chunkIndex * 8
        let wordIndex = 1 + chunkIndex * 2
        if copyRecipe.words[wordIndex] != Value(a64.A64EncLdrImm(
               true, a64.A64X16, a64.A64X17,
               int64(byteOffset))) ||
           copyRecipe.words[wordIndex + 1] != Value(a64.A64EncStrImm(
               true, a64.A64X16, a64.A64SP,
               int64(prepared.localStackOffsets[1] + byteOffset))):
            return 205
    let recipe = prepared.recipes[actionIndex]
    let targetReg = plan.actions[actionIndex].targetReg
    let effects = contract.RegallocA64EffectSpLoad |
                  contract.RegallocA64EffectX17
    if targetReg < 0 || recipe.effectMask != effects ||
       recipe.writtenRegs.len != 2 ||
       !regListContains(recipe.writtenRegs, targetReg) ||
       !regListContains(recipe.writtenRegs, a64.A64X17) ||
       recipe.relocs.len != 0 || recipe.words.len != 2 ||
       recipe.words[0] != Value(a64.A64EncAddImm(
           true, a64.A64X17, a64.A64SP,
           prepared.localStackOffsets[1])) ||
       recipe.words[1] != Value(a64.A64EncLdrImm(
           false, targetReg, a64.A64X17, int64(8))) ||
       actionFragmentEffect(prepared, actionIndex) != effects:
        return 206
    return 0

fn functionGlobalRelocsExact(
        prepared: var contract.RegallocA64FunctionRecipes,
        symbol: str): bool =
    if prepared.functionRelocs.len != 8:
        return false
    for opIndex in 0..<4:
        var pageWord: int32 = -1
        var pageOffWord: int32 = -1
        var count: int32
        for relocIndex in 0..<prepared.functionRelocs.len:
            let reloc = prepared.functionRelocs[relocIndex]
            if reloc.opIndex != opIndex:
                continue
            count = count + 1
            if reloc.subIndex != 0 || reloc.callOrdinal != -1 ||
               reloc.targetSymbol != symbol:
                return false
            if reloc.kind == contract.RegallocA64RelocPage21:
                pageWord = reloc.wordIndex
            elif reloc.kind ==
                 contract.RegallocA64RelocPageOff12:
                pageOffWord = reloc.wordIndex
            else:
                return false
        if count != 2 || pageWord < 0 || pageOffWord != pageWord + 1:
            return false
    return true

fn verifyGlobalAggregateMemory(): int32 =
    var body = buildGlobalAggregateMemoryBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid:
        return 207
    let expectedFactCounts = [3, 4, 3, 4]
    for opIndex in 0..<4:
        let isStore = opIndex < 2
        var expectedMemory = access.BodyIrAccessMemoryGlobalRead
        var expectedDefCount: int32 = 1
        if isStore:
            expectedMemory = access.BodyIrAccessMemoryGlobalWrite
            expectedDefCount = 0
        if table.opFactCounts[opIndex] !=
               expectedFactCounts[opIndex] ||
           opFactOperandCount(table, opIndex,
                              access.BodyIrAccessFactFixed, 0) != 1 ||
           opFactOperandCount(table, opIndex,
                              access.BodyIrAccessFactUse, 0) != 0 ||
           opFactMemoryCount(table, opIndex, expectedMemory) != 1 ||
           opFactKindCount(table, opIndex,
                           access.BodyIrAccessFactDef) != expectedDefCount:
            return 208
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    if !analysis.valid:
        return 209
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 210
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    let symbol = body.localSlots[0].name
    if !prepared.valid || !functionGlobalRelocsExact(prepared, symbol):
        return 211
    let sourceReg = opOperandReg(table, plan, 0, 1)
    let storeIndexReg = opOperandReg(table, plan, 1, 2)
    let addressWord = a64.A64EncAdrp(a64.A64X17)
    let addressAdd = Value(a64.A64EncAddImm(
        true, a64.A64X17, a64.A64X17, 0))
    let fieldStore = prepared.opRecipes[0]
    if sourceReg < 0 || fieldStore.ownedByAction ||
       !siteDataRelocPairExact(fieldStore, symbol) ||
       fieldStore.effectMask != contract.RegallocA64EffectX17 ||
       fieldStore.writtenRegs.len != 1 ||
       fieldStore.writtenRegs[0] != a64.A64X17 ||
       fieldStore.words.len != 3 ||
       fieldStore.words[0] != addressWord ||
       fieldStore.words[1] != addressAdd ||
       fieldStore.words[2] != Value(a64.A64EncStrImm(
           false, sourceReg, a64.A64X17, int64(0))) ||
       opFragmentEffect(prepared, 0) !=
           contract.RegallocA64EffectX17:
        return 212
    let scratchEffects = contract.RegallocA64EffectX16 |
                         contract.RegallocA64EffectX17
    let indexedStore = prepared.opRecipes[1]
    if storeIndexReg < 0 || indexedStore.ownedByAction ||
       !siteDataRelocPairExact(indexedStore, symbol) ||
       indexedStore.effectMask != scratchEffects ||
       indexedStore.writtenRegs.len != 2 ||
       indexedStore.writtenRegs[0] != a64.A64X16 ||
       indexedStore.writtenRegs[1] != a64.A64X17 ||
       indexedStore.words.len != 5 ||
       indexedStore.words[0] != addressWord ||
       indexedStore.words[1] != addressAdd ||
       indexedStore.words[2] !=
           a64.A64EncMovz(true, a64.A64X16, 4, 0) ||
       indexedStore.words[3] != a64.A64EncMadd(
           true, a64.A64X17, storeIndexReg,
           a64.A64X16, a64.A64X17) ||
       indexedStore.words[4] != Value(a64.A64EncStrImm(
           false, sourceReg, a64.A64X17, int64(0))) ||
       opFragmentEffect(prepared, 1) != scratchEffects:
        return 213
    for opIndex in 2..<4:
        let actionIndex = producerRecipeIndex(
            plan, prepared, opIndex, body.ops[opIndex].kind)
        if actionIndex < 0 ||
           !prepared.opRecipes[opIndex].ownedByAction:
            return 214
        let recipe = prepared.recipes[actionIndex]
        let targetReg = plan.actions[actionIndex].targetReg
        var expectedEffects = contract.RegallocA64EffectX17
        var expectedWords: int32 = 3
        if opIndex == 3:
            expectedEffects = scratchEffects
            expectedWords = 5
        if targetReg < 0 || !actionDataRelocPairExact(recipe, symbol) ||
           recipe.effectMask != expectedEffects ||
           recipe.words.len != expectedWords ||
           recipe.words[0] != addressWord ||
           recipe.words[1] != addressAdd ||
           actionFragmentEffect(prepared, actionIndex) != expectedEffects:
            return 215
        if opIndex == 2:
            if recipe.words[2] != Value(a64.A64EncLdrImm(
                   false, targetReg, a64.A64X17, int64(4))):
                return 216
        else:
            let indexReg = opOperandReg(table, plan, opIndex, 2)
            if indexReg < 0 ||
               recipe.words[2] != a64.A64EncMovz(
                   true, a64.A64X16, 4, 0) ||
               recipe.words[3] != a64.A64EncMadd(
                   true, a64.A64X17, indexReg,
                   a64.A64X16, a64.A64X17) ||
               recipe.words[4] != Value(a64.A64EncLdrImm(
                   false, targetReg, a64.A64X17, int64(0))):
                return 217
    return 0

fn verifyBorrowAggregateFieldLoad(): int32 =
    var body = buildBorrowAggregateFieldLoadBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid || table.opFactCounts.len != 2 ||
       table.opFactCounts[1] != 3 ||
       opFactOperandCount(table, 1,
                          access.BodyIrAccessFactUse, 0) != 1 ||
       opFactMemoryCount(table, 1,
                         access.BodyIrAccessMemoryIndirectRead) != 1 ||
       opFactKindCount(table, 1, access.BodyIrAccessFactDef) != 1:
        return 218
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    if !analysis.valid:
        return 219
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 220
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    let actionIndex = producerRecipeIndex(
        plan, prepared, 1, ir.BodyOpFieldLoadTag)
    if !prepared.valid || actionIndex < 0 ||
       prepared.recipes.len != plan.actions.len:
        return 221
    let recipe = prepared.recipes[actionIndex]
    let targetReg = plan.actions[actionIndex].targetReg
    let effects = contract.RegallocA64EffectSpLoad |
                  contract.RegallocA64EffectX17
    if targetReg < 0 || recipe.effectMask != effects ||
       recipe.words.len != 2 ||
       recipe.words[0] != Value(a64.A64EncAddImm(
           true, a64.A64X17, a64.A64SP,
           prepared.localStackOffsets[0])) ||
       recipe.words[1] != Value(a64.A64EncLdrImm(
           false, targetReg, a64.A64X17, int64(4))) ||
       actionFragmentEffect(prepared, actionIndex) != effects:
        return 222
    return 0

fn verifyDynamicSeqIndexedOrder(): int32 =
    var body = buildDynamicSeqIndexedBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid || table.opFactCounts.len != 3 ||
       table.opFactCounts[0] != 5 ||
       table.opFactCounts[1] != 5:
        return 223
    if opFactOperandCount(table, 0,
                          access.BodyIrAccessFactUse, 0) != 1 ||
       opFactOperandCount(table, 0,
                          access.BodyIrAccessFactUse, 1) != 1 ||
       opFactOperandCount(table, 0,
                          access.BodyIrAccessFactUse, 2) != 1 ||
       opFactKindCount(table, 0, access.BodyIrAccessFactDef) != 0 ||
       opFactMemoryCount(table, 0,
                         access.BodyIrAccessMemoryIndirectRead) != 1 ||
       opFactMemoryCount(table, 0,
                         access.BodyIrAccessMemoryIndirectWrite) != 1 ||
       opFactOperandCount(table, 1,
                          access.BodyIrAccessFactUse, 0) != 1 ||
       opFactOperandCount(table, 1,
                          access.BodyIrAccessFactUse, 2) != 1 ||
       opFactKindCount(table, 1, access.BodyIrAccessFactDef) != 1 ||
       opFactMemoryCount(table, 1,
                         access.BodyIrAccessMemoryIndirectRead) != 2:
        return 224
    var analysis = cfg.BodyIrCfgAnalyze(body, table)
    if !analysis.valid:
        return 225
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 226
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid:
        return 227
    let effects = contract.RegallocA64EffectSpLoad |
                  contract.RegallocA64EffectX16 |
                  contract.RegallocA64EffectX17
    let baseLoad = Value(a64.A64EncLdrImm(
        true, a64.A64X17, a64.A64SP,
        int64(prepared.localStackOffsets[0])))
    let bufferLoad = Value(a64.A64EncLdrImm(
        true, a64.A64X17, a64.A64X17, int64(8)))
    let sourceReg = opOperandReg(table, plan, 0, 1)
    let storeIndexReg = opOperandReg(table, plan, 0, 2)
    let store = prepared.opRecipes[0]
    if sourceReg < 0 || storeIndexReg < 0 || store.ownedByAction ||
       store.effectMask != effects || store.words.len != 5 ||
       store.words[0] != baseLoad || store.words[1] != bufferLoad ||
       store.words[2] != a64.A64EncMovz(
           true, a64.A64X16, 4, 0) ||
       store.words[3] != a64.A64EncMadd(
           true, a64.A64X17, storeIndexReg,
           a64.A64X16, a64.A64X17) ||
       store.words[4] != Value(a64.A64EncStrImm(
           false, sourceReg, a64.A64X17, int64(0))) ||
       opFragmentEffect(prepared, 0) != effects:
        return 228
    let actionIndex = producerRecipeIndex(
        plan, prepared, 1, ir.BodyOpIndexedLoadTag)
    if actionIndex < 0:
        return 229
    let load = prepared.recipes[actionIndex]
    let targetReg = plan.actions[actionIndex].targetReg
    let loadIndexReg = opOperandReg(table, plan, 1, 2)
    if targetReg < 0 || loadIndexReg < 0 ||
       load.effectMask != effects || load.words.len != 5 ||
       load.words[0] != baseLoad || load.words[1] != bufferLoad ||
       load.words[2] != a64.A64EncMovz(
           true, a64.A64X16, 4, 0) ||
       load.words[3] != a64.A64EncMadd(
           true, a64.A64X17, loadIndexReg,
           a64.A64X16, a64.A64X17) ||
       load.words[4] != Value(a64.A64EncLdrImm(
           false, targetReg, a64.A64X17, int64(0))) ||
       actionFragmentEffect(prepared, actionIndex) != effects:
        return 230
    return 0

fn verifyPtrStoreControl(): int32 =
    var body = buildNoDefStoreAndLegacyControlBody()
    var table = access.BodyIrAccessDecode(body)
    if !table.valid:
        return 231
    for opIndex in 0..<2:
        if table.opFactCounts[opIndex] != 3 ||
           opFactOperandCount(table, opIndex,
                              access.BodyIrAccessFactUse, 0) != 1 ||
           opFactOperandCount(table, opIndex,
                              access.BodyIrAccessFactUse, 1) != 1 ||
           opFactKindCount(table, opIndex,
                           access.BodyIrAccessFactDef) != 0 ||
           opFactMemoryCount(table, opIndex,
                             access.BodyIrAccessMemoryIndirectWrite) != 1:
            return 232
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 233
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid:
        return 234
    for opIndex in 0..<2:
        let baseReg = opOperandReg(table, plan, opIndex, 0)
        let sourceReg = opOperandReg(table, plan, opIndex, 1)
        let recipe = prepared.opRecipes[opIndex]
        var byteOffset: int32
        if opIndex != 0:
            byteOffset = 4
        if baseReg < 0 || sourceReg < 0 || recipe.ownedByAction ||
           recipe.effectMask != 0 || recipe.writtenRegs.len != 0 ||
           recipe.words.len != 1 ||
           recipe.words[0] != Value(a64.A64EncStrImm(
               false, sourceReg, baseReg,
               int64(byteOffset))) ||
           opFragmentEffect(prepared, opIndex) != 0:
            return 235
    return 0

fn verifyKindTables(): int32 =
    for kind in 1..<20:
        if !adapter.RegallocA64BodyOpKindKnown(kind):
            return 10 + kind
    if adapter.RegallocA64BodyOpKindKnown(0) ||
       adapter.RegallocA64BodyOpKindKnown(20):
        return 30
    var machineCount: int32
    var structuralCount: int32
    for kind in 101..<130:
        if adapter.RegallocA64ActionKindMachine(kind):
            machineCount = machineCount + 1
        elif adapter.RegallocA64ActionKindStructural(kind):
            structuralCount = structuralCount + 1
        else:
            return 31
    if machineCount != 20 || structuralCount != 9:
        return 32
    return 0

fn verifyRecipes(body: var ir.BodyIR,
                 plan: var alloc.RegallocSinglePassValuePlan,
                 seen: var bool[],
                 requireProducer: bool,
                 requireCall: bool): int32 =
    let prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid:
        return 100 + prepared.errorDetail
    if prepared.recipes.len != plan.actions.len ||
       prepared.opRecipes.len != body.ops.len ||
       prepared.termRecipes.len != body.terms.len ||
       prepared.frameBytes <= 0 || prepared.prologueWords.len <= 0 ||
       prepared.epilogueWords.len <= 0 ||
       prepared.localStackOffsets.len != body.localSlots.len ||
       prepared.functionWords.len <= 0 ||
       prepared.blockEmissionOrder.len != prepared.reachableBlockCount ||
       prepared.blockWordStarts.len != body.blocks.len ||
       prepared.opWordStarts.len != body.ops.len ||
       prepared.termWordStarts.len != body.terms.len:
        return 40
    var observedBodyStorageStart: int32 = -1
    for slotIndex in 0..<body.localSlots.len:
        let slot = body.localSlots[slotIndex]
        if slot.stackOffset >= 0:
            let localOffset = prepared.localStackOffsets[slotIndex]
            let storageStart = localOffset - slot.stackOffset + 16
            if localOffset < prepared.bodyRegionStart ||
               localOffset + slot.sizeBytes > prepared.frameBytes ||
               storageStart < prepared.bodyRegionStart ||
               (observedBodyStorageStart >= 0 &&
                storageStart != observedBodyStorageStart):
                return 41
            observedBodyStorageStart = storageStart
        else:
            let paramIndex = 0 - 1 - slot.stackOffset
            if paramIndex < 8:
                if paramIndex >= prepared.parameterHomeOffsets.len:
                    return 42
                let homeOffset =
                    prepared.parameterHomeOffsets[paramIndex]
                let localOffset =
                    prepared.localStackOffsets[slotIndex]
                if (homeOffset >= 0 && localOffset != homeOffset) ||
                   (homeOffset < 0 && localOffset != -1 &&
                    (localOffset < prepared.bodyRegionStart ||
                     localOffset + 8 > prepared.frameBytes)):
                    return 42
            if paramIndex >= 8 &&
               prepared.localStackOffsets[slotIndex] <
                   prepared.frameBytes:
                return 43
    for wordIndex in 0..<prepared.prologueWords.len:
        if prepared.prologueWords[wordIndex] == 0 ||
           prepared.prologueWords[wordIndex] == a64.A64EncNop():
            return 44
    for wordIndex in 0..<prepared.epilogueWords.len:
        if prepared.epilogueWords[wordIndex] == 0 ||
           prepared.epilogueWords[wordIndex] == a64.A64EncNop():
            return 45
    if prepared.abiIngressRegs.len != prepared.abiIngressOffsets.len ||
       prepared.abiIngressRegs.len !=
           prepared.abiIngressWordIndices.len ||
       prepared.abiIngressRegs.len !=
           prepared.abiIngressWordCounts.len ||
       prepared.abiIngressRegs.len !=
           prepared.abiIngressParamOrdinals.len ||
       prepared.abiIngressRegs.len !=
           prepared.abiIngressValueIds.len ||
       prepared.abiIngressRegs.len !=
           prepared.abiIngressWidths.len:
        return 33
    var expectedSret: bool
    var sawIngressX8: bool
    for actionIndex in 0..<plan.actions.len:
        if plan.actions[actionIndex].kind ==
           alloc.RegallocValueActionStoreSretReturn:
            expectedSret = true
    for ingressIndex in 0..<prepared.abiIngressRegs.len:
        let reg = prepared.abiIngressRegs[ingressIndex]
        let stackOffset = prepared.abiIngressOffsets[ingressIndex]
        let paramOrdinal =
            prepared.abiIngressParamOrdinals[ingressIndex]
        let valueId = prepared.abiIngressValueIds[ingressIndex]
        let width = prepared.abiIngressWidths[ingressIndex]
        let wordIndex = prepared.abiIngressWordIndices[ingressIndex]
        let wordCount = prepared.abiIngressWordCounts[ingressIndex]
        if wordIndex < 0 || wordCount <= 0 ||
           wordIndex > prepared.prologueWords.len - wordCount ||
           stackOffset < prepared.paramSaveOffset ||
           prepared.prologueWords[wordIndex] != Value(a64.A64EncStrImm(
               width == 8, reg, a64.A64SP, int64(stackOffset))):
            return 34
        for priorIndex in 0..<ingressIndex:
            if prepared.abiIngressRegs[priorIndex] == reg ||
               prepared.abiIngressOffsets[priorIndex] == stackOffset:
                return 35
        if reg == a64.A64X8:
            sawIngressX8 = true
            if stackOffset != prepared.returnBufferSaveOffset ||
               paramOrdinal != -1 || valueId != -1 || width != 8:
                return 36
        else:
            if reg < 0 || reg >= 8 || paramOrdinal != reg ||
               paramOrdinal >= prepared.parameterHomeOffsets.len ||
               stackOffset !=
                   prepared.parameterHomeOffsets[paramOrdinal] ||
               valueId != prepared.parameterValueIds[paramOrdinal] ||
               width != prepared.parameterWidths[paramOrdinal]:
                return 37
    if prepared.hasSretReturn != expectedSret ||
       sawIngressX8 != expectedSret ||
       (!expectedSret && prepared.returnBufferSaveOffset != -1):
        return 38
    let functionCount =
        adapter.RegallocA64FunctionRecipeWordCount(prepared)
    if functionCount != prepared.functionWords.len:
        return 46
    var functionFill: int32[]
    for _ in 0..<(functionCount + 2):
        add(functionFill, -1)
    if adapter.RegallocA64FunctionRecipeFill(
           prepared, functionFill, 1) != functionCount + 1 ||
       functionFill[0] != -1 ||
       functionFill[functionCount + 1] != -1:
        return 47
    for wordIndex in 0..<functionCount:
        if functionFill[wordIndex + 1] !=
               prepared.functionWords[wordIndex] ||
           prepared.functionWords[wordIndex] == 0 ||
           prepared.functionWords[wordIndex] == a64.A64EncNop():
            return 48
    var expectedRelocCount: int32
    for recipeIndex in 0..<prepared.recipes.len:
        let recipe = prepared.recipes[recipeIndex]
        expectedRelocCount = expectedRelocCount + recipe.relocs.len
        for relocIndex in 0..<recipe.relocs.len:
            let localReloc = recipe.relocs[relocIndex]
            if prepared.actionWordStarts[recipeIndex] < 0 ||
               localReloc.wordIndex < 0 ||
               localReloc.wordIndex >= recipe.words.len:
                return 120
            let absoluteWord =
                prepared.actionWordStarts[recipeIndex] +
                localReloc.wordIndex
            var matchCount: int32
            for functionRelocIndex in 0..<prepared.functionRelocs.len:
                let functionReloc =
                    prepared.functionRelocs[functionRelocIndex]
                if functionReloc.kind == localReloc.kind &&
                   functionReloc.wordIndex == absoluteWord &&
                   functionReloc.callOrdinal == localReloc.callOrdinal &&
                   functionReloc.targetSymbol == localReloc.targetSymbol:
                    matchCount = matchCount + 1
            if matchCount != 1:
                return 121
    for opIndex in 0..<prepared.opRecipes.len:
        let recipe = prepared.opRecipes[opIndex]
        expectedRelocCount = expectedRelocCount + recipe.relocs.len
        for relocIndex in 0..<recipe.relocs.len:
            let localReloc = recipe.relocs[relocIndex]
            if prepared.opWordStarts[opIndex] < 0 ||
               localReloc.wordIndex < 0 ||
               localReloc.wordIndex >= recipe.words.len:
                return 122
            let absoluteWord = prepared.opWordStarts[opIndex] +
                               localReloc.wordIndex
            var matchCount: int32
            for functionRelocIndex in 0..<prepared.functionRelocs.len:
                let functionReloc =
                    prepared.functionRelocs[functionRelocIndex]
                if functionReloc.kind == localReloc.kind &&
                   functionReloc.wordIndex == absoluteWord &&
                   functionReloc.callOrdinal == localReloc.callOrdinal &&
                   functionReloc.targetSymbol == localReloc.targetSymbol:
                    matchCount = matchCount + 1
            if matchCount != 1:
                return 123
    for termIndex in 0..<prepared.termRecipes.len:
        let recipe = prepared.termRecipes[termIndex]
        expectedRelocCount = expectedRelocCount + recipe.relocs.len
        for relocIndex in 0..<recipe.relocs.len:
            let localReloc = recipe.relocs[relocIndex]
            if prepared.termWordStarts[termIndex] < 0 ||
               localReloc.wordIndex < 0 ||
               localReloc.wordIndex >= recipe.words.len:
                return 124
            let absoluteWord = prepared.termWordStarts[termIndex] +
                               localReloc.wordIndex
            var matchCount: int32
            for functionRelocIndex in 0..<prepared.functionRelocs.len:
                let functionReloc =
                    prepared.functionRelocs[functionRelocIndex]
                if functionReloc.kind == localReloc.kind &&
                   functionReloc.wordIndex == absoluteWord &&
                   functionReloc.callOrdinal == localReloc.callOrdinal &&
                   functionReloc.targetSymbol == localReloc.targetSymbol:
                    matchCount = matchCount + 1
            if matchCount != 1:
                return 125
    if prepared.functionRelocs.len != expectedRelocCount:
        return 126
    for relocIndex in 0..<prepared.functionRelocs.len:
        let reloc = prepared.functionRelocs[relocIndex]
        if reloc.wordIndex < 0 ||
           reloc.wordIndex >= prepared.functionWords.len ||
           len(reloc.targetSymbol) <= 0:
            return 127
    var priorFragmentEnd: int32 = -1
    var actionFragmentSeen: bool[]
    for _ in 0..<plan.actions.len:
        add(actionFragmentSeen, false)
    var opFragmentSeen: bool[]
    var opFrameEpilogueSeen: bool[]
    for _ in 0..<body.ops.len:
        add(opFragmentSeen, false)
        add(opFrameEpilogueSeen, false)
    var termFragmentSeen: bool[]
    var termFrameEpilogueSeen: bool[]
    for _ in 0..<body.terms.len:
        add(termFragmentSeen, false)
        add(termFrameEpilogueSeen, false)
    var edgeTrampolineSeen: bool[]
    for _ in 0..<plan.edgeSourceBlocks.len:
        add(edgeTrampolineSeen, false)
    var ingressFragmentSeen: bool[]
    for _ in 0..<prepared.abiIngressRegs.len:
        add(ingressFragmentSeen, false)
    var framePrologueSeen: bool
    for fragmentIndex in 0..<prepared.machineFragments.len:
        let fragment = prepared.machineFragments[fragmentIndex]
        if fragment.wordStart < 0 || fragment.wordCount <= 0 ||
           fragment.wordStart >
               prepared.functionWords.len - fragment.wordCount ||
           fragment.wordStart < priorFragmentEnd ||
           fragment.effectMask < 0 || fragment.effectMask > 31:
            return 98
        priorFragmentEnd = fragment.wordStart + fragment.wordCount
        for regIndex in 0..<fragment.writtenRegs.len:
            if fragment.writtenRegs[regIndex] < 0 ||
               fragment.writtenRegs[regIndex] > a64.A64SP ||
               (regIndex > 0 &&
                fragment.writtenRegs[regIndex - 1] >=
                    fragment.writtenRegs[regIndex]):
                return 99
        for relocIndex in 0..<fragment.relocs.len:
            if fragment.relocs[relocIndex].wordIndex <
                   fragment.wordStart ||
               fragment.relocs[relocIndex].wordIndex >=
                   fragment.wordStart + fragment.wordCount:
                return 100
        if fragment.ownerKind ==
           contract.RegallocA64FragmentOwnerAction:
            let actionIndex = fragment.actionConsumerOrdinal
            if actionIndex < 0 || actionIndex >= plan.actions.len ||
               actionFragmentSeen[actionIndex] ||
               fragment.ownerOrdinal != actionIndex ||
               fragment.wordStart !=
                   prepared.actionWordStarts[actionIndex] ||
               fragment.wordCount !=
                   prepared.actionWordCounts[actionIndex] ||
               fragment.effectMask !=
                   prepared.recipes[actionIndex].effectMask ||
               fragment.writtenRegs.len !=
                   prepared.recipes[actionIndex].writtenRegs.len:
                return 101
            for regIndex in 0..<fragment.writtenRegs.len:
                if fragment.writtenRegs[regIndex] !=
                   prepared.recipes[actionIndex].writtenRegs[regIndex]:
                    return 132
            if plan.actions[actionIndex].placement ==
                   alloc.RegallocValuePlacementEdge &&
               (fragment.edgeIndex < 0 ||
                fragment.edgeIndex >= plan.edgeSourceBlocks.len ||
                fragment.blockIndex < 0 ||
                fragment.blockIndex >= body.blocks.len ||
                fragment.siteKind != access.BodyIrAccessSiteTerm ||
                fragment.blockIndex !=
                    plan.edgeSourceBlocks[fragment.edgeIndex] ||
                fragment.siteIndex != body.blocks[
                    fragment.blockIndex].termIndex):
                return 133
            actionFragmentSeen[actionIndex] = true
        elif fragment.ownerKind ==
             contract.RegallocA64FragmentOwnerOp:
            let opIndex = fragment.siteIndex
            if opIndex < 0 || opIndex >= body.ops.len ||
               opIndex >= prepared.opRecipes.len ||
               opIndex >= prepared.opWordCounts.len:
                return 102
            var expectedWordCount = prepared.opWordCounts[opIndex]
            if wordsEndWith(prepared.opRecipes[opIndex].words,
                            prepared.epilogueWords):
                expectedWordCount = expectedWordCount -
                                    prepared.epilogueWords.len
            if opFragmentSeen[opIndex] ||
               fragment.wordStart != prepared.opWordStarts[opIndex] ||
               expectedWordCount <= 0 ||
               fragment.wordCount != expectedWordCount:
                return 102
            let opRecipe = prepared.opRecipes[opIndex]
            if fragment.branchWordIndices.len !=
                   opRecipe.branchWordIndices.len ||
               fragment.branchTargetBlocks.len !=
                   opRecipe.branchTargetBlocks.len ||
               fragment.branchTargetWordStarts.len !=
                   opRecipe.branchTargetBlocks.len:
                return 140
            for branchIndex in 0..<opRecipe.branchWordIndices.len:
                if fragment.branchWordIndices[branchIndex] !=
                       fragment.wordStart +
                           opRecipe.branchWordIndices[branchIndex] ||
                   fragment.branchTargetBlocks[branchIndex] !=
                       opRecipe.branchTargetBlocks[branchIndex] ||
                   (opRecipe.branchTargetBlocks[branchIndex] < 0 &&
                    fragment.branchTargetWordStarts[branchIndex] !=
                        prepared.opWordStarts[opIndex] +
                            prepared.opWordCounts[opIndex]):
                    return 141
            opFragmentSeen[opIndex] = true
        elif fragment.ownerKind ==
             contract.RegallocA64FragmentOwnerTerm:
            let termIndex = fragment.siteIndex
            if termIndex < 0 || termIndex >= body.terms.len ||
               termIndex >= prepared.termRecipes.len ||
               termIndex >= prepared.termWordCounts.len:
                return 103
            var expectedWordCount = prepared.termWordCounts[termIndex]
            if wordsEndWith(prepared.termRecipes[termIndex].words,
                            prepared.epilogueWords):
                expectedWordCount = expectedWordCount -
                                    prepared.epilogueWords.len
            if termFragmentSeen[termIndex] ||
               fragment.wordStart !=
                   prepared.termWordStarts[termIndex] ||
               expectedWordCount <= 0 ||
               fragment.wordCount != expectedWordCount:
                return 103
            termFragmentSeen[termIndex] = true
        elif fragment.ownerKind ==
             contract.RegallocA64FragmentOwnerEdge:
            let edgeIndex = fragment.edgeIndex
            let actionIndex = fragment.actionConsumerOrdinal
            if edgeIndex < 0 || edgeIndex >= edgeTrampolineSeen.len ||
               actionIndex < 0 || actionIndex >= plan.actions.len ||
               actionFragmentSeen[actionIndex] ||
               fragment.ownerOrdinal != actionIndex ||
               plan.actions[actionIndex].kind !=
                   alloc.RegallocValueActionEdgeParallelCopy ||
               plan.actions[actionIndex].edgeIndex != edgeIndex ||
               fragment.wordStart !=
                   prepared.actionWordStarts[actionIndex] ||
               fragment.wordCount !=
                   prepared.actionWordCounts[actionIndex] ||
               fragment.trampolineWordStart != -1 ||
               fragment.trampolineTargetBlock != -1 ||
               fragment.trampolineTargetWordStart != -1 ||
               fragment.siteKind != access.BodyIrAccessSiteTerm ||
               fragment.blockIndex !=
                   plan.edgeSourceBlocks[edgeIndex] ||
               fragment.blockIndex < 0 ||
               fragment.blockIndex >= body.blocks.len ||
               fragment.siteIndex != body.blocks[
                   fragment.blockIndex].termIndex:
                return 104
            actionFragmentSeen[actionIndex] = true
        elif fragment.ownerKind ==
             contract.RegallocA64FragmentOwnerEdgeTrampoline:
            let edgeIndex = fragment.edgeIndex
            if edgeIndex < 0 || edgeIndex >= edgeTrampolineSeen.len ||
               edgeTrampolineSeen[edgeIndex] ||
               fragment.ownerOrdinal != edgeIndex ||
               fragment.actionConsumerOrdinal != -1 ||
               fragment.wordCount != 1 ||
               fragment.trampolineWordStart !=
                   prepared.edgeSplitWordStarts[edgeIndex] ||
               fragment.trampolineTargetBlock !=
                   plan.edgeTargetBlocks[edgeIndex] ||
               fragment.trampolineTargetWordStart !=
                   prepared.blockWordStarts[
                       plan.edgeTargetBlocks[edgeIndex]] ||
               fragment.branchWordIndices.len != 1 ||
               fragment.branchWordIndices[0] != fragment.wordStart ||
               fragment.siteKind != access.BodyIrAccessSiteTerm ||
               fragment.blockIndex !=
                   plan.edgeSourceBlocks[edgeIndex] ||
               fragment.blockIndex < 0 ||
               fragment.blockIndex >= body.blocks.len ||
               fragment.siteIndex != body.blocks[
                   fragment.blockIndex].termIndex:
                return 104
            edgeTrampolineSeen[edgeIndex] = true
        elif fragment.ownerKind ==
             contract.RegallocA64FragmentOwnerAbiIngress:
            let ingressIndex = fragment.ingressIndex
            if ingressIndex < 0 ||
               ingressIndex >= ingressFragmentSeen.len ||
               ingressFragmentSeen[ingressIndex] ||
               fragment.wordStart !=
                   prepared.abiIngressWordIndices[ingressIndex] ||
               fragment.wordCount !=
                   prepared.abiIngressWordCounts[ingressIndex]:
                return 105
            ingressFragmentSeen[ingressIndex] = true
        elif fragment.ownerKind ==
             contract.RegallocA64FragmentOwnerFramePrologue:
            var expectedWordCount = prepared.prologueWords.len
            if prepared.abiIngressWordIndices.len > 0:
                expectedWordCount = prepared.abiIngressWordIndices[0]
            if framePrologueSeen ||
               fragment.siteKind != access.BodyIrAccessSiteEntry ||
               fragment.wordStart != 0 ||
               fragment.wordCount != expectedWordCount:
                return 134
            framePrologueSeen = true
        elif fragment.ownerKind ==
             contract.RegallocA64FragmentOwnerFrameEpilogue:
            if fragment.wordCount != prepared.epilogueWords.len:
                return 135
            if fragment.siteKind == access.BodyIrAccessSiteOp:
                let opIndex = fragment.siteIndex
                if opIndex < 0 || opIndex >= prepared.opRecipes.len ||
                   opFrameEpilogueSeen[opIndex] ||
                   !wordsEndWith(prepared.opRecipes[opIndex].words,
                                 prepared.epilogueWords) ||
                   fragment.wordStart != prepared.opWordStarts[opIndex] +
                       prepared.opWordCounts[opIndex] -
                       prepared.epilogueWords.len:
                    return 136
                opFrameEpilogueSeen[opIndex] = true
            elif fragment.siteKind == access.BodyIrAccessSiteTerm:
                let termIndex = fragment.siteIndex
                if termIndex < 0 ||
                   termIndex >= prepared.termRecipes.len ||
                   termFrameEpilogueSeen[termIndex] ||
                   !wordsEndWith(prepared.termRecipes[termIndex].words,
                                 prepared.epilogueWords) ||
                   fragment.wordStart !=
                       prepared.termWordStarts[termIndex] +
                       prepared.termWordCounts[termIndex] -
                       prepared.epilogueWords.len:
                    return 137
                termFrameEpilogueSeen[termIndex] = true
            else:
                return 138
        else:
            return 106
    for actionIndex in 0..<plan.actions.len:
        let machine = prepared.recipes[actionIndex].words.len > 0
        if actionFragmentSeen[actionIndex] != machine:
            return 107
    for opIndex in 0..<prepared.opRecipes.len:
        let machine = prepared.opRecipes[opIndex].machineOwnerKind ==
                      contract.RegallocA64SiteOwnerOp
        let ownsEpilogue = machine &&
            wordsEndWith(prepared.opRecipes[opIndex].words,
                         prepared.epilogueWords)
        var epilogueWordCount: int32
        if ownsEpilogue:
            epilogueWordCount = prepared.epilogueWords.len
        let ownsPrefix = machine &&
            prepared.opRecipes[opIndex].words.len >
                epilogueWordCount
        if opFragmentSeen[opIndex] != ownsPrefix ||
           opFrameEpilogueSeen[opIndex] != ownsEpilogue:
            return 108
    for termIndex in 0..<prepared.termRecipes.len:
        let machine = prepared.termRecipes[termIndex].machineOwnerKind ==
                      contract.RegallocA64SiteOwnerTerm
        let ownsEpilogue = machine &&
            wordsEndWith(prepared.termRecipes[termIndex].words,
                         prepared.epilogueWords)
        var epilogueWordCount: int32
        if ownsEpilogue:
            epilogueWordCount = prepared.epilogueWords.len
        let ownsPrefix = machine &&
            prepared.termRecipes[termIndex].words.len >
                epilogueWordCount
        if termFragmentSeen[termIndex] != ownsPrefix ||
           termFrameEpilogueSeen[termIndex] != ownsEpilogue:
            return 109
    for edgeIndex in 0..<prepared.edgeSplitWordStarts.len:
        if edgeTrampolineSeen[edgeIndex] !=
           (prepared.edgeSplitWordStarts[edgeIndex] >= 0):
            return 110
    for ingressIndex in 0..<ingressFragmentSeen.len:
        if !ingressFragmentSeen[ingressIndex]:
            return 111
    if !framePrologueSeen:
        return 139
    var priorBlockPosition: int32 = -1
    for scheduleIndex in 0..<prepared.blockEmissionOrder.len:
        let blockIndex = prepared.blockEmissionOrder[scheduleIndex]
        if blockIndex < 0 || blockIndex >= body.blocks.len ||
           blockIndex >= plan.blockEntryPositions.len ||
           plan.blockEntryPositions[blockIndex] < priorBlockPosition:
            return 49
        priorBlockPosition = plan.blockEntryPositions[blockIndex]
    for opIndex in 0..<prepared.opRecipes.len:
        let site = prepared.opRecipes[opIndex]
        let siteCount = adapter.RegallocA64SiteRecipeWordCount(site)
        if !site.reachable:
            if siteCount != 0 || prepared.opWordStarts[opIndex] != -1:
                return 59
            continue
        if siteCount < 0 ||
           (site.ownedByAction && siteCount != 0) ||
           (!site.ownedByAction && siteCount <= 0) ||
           (site.ownedByAction && site.machineOwnerKind !=
                contract.RegallocA64SiteOwnerNone) ||
           (!site.ownedByAction && site.machineOwnerKind !=
                contract.RegallocA64SiteOwnerOp) ||
           site.effectMask < 0 || site.effectMask > 31 ||
           (site.effectMask & 7) !=
               adapter.RegallocA64WordsSpMemoryCallEffectMask(
                   site.words) ||
           prepared.opWordCounts[opIndex] != siteCount:
            return 59
        if prepared.opWordStarts[opIndex] < 0 ||
           prepared.opWordStarts[opIndex] >
               prepared.functionWords.len - siteCount:
            return 128
        for wordIndex in 0..<siteCount:
            if prepared.functionWords[
                   prepared.opWordStarts[opIndex] + wordIndex] !=
               site.words[wordIndex]:
                return 129
        var siteFill: int32[]
        for _ in 0..<(siteCount + 2):
            add(siteFill, -1)
        if adapter.RegallocA64SiteRecipeFill(
               site, siteFill, 1) != siteCount + 1 ||
           siteFill[0] != -1 || siteFill[siteCount + 1] != -1:
            return 74
        for wordIndex in 0..<siteCount:
            if siteFill[wordIndex + 1] != site.words[wordIndex] ||
               site.words[wordIndex] == 0 ||
               site.words[wordIndex] == a64.A64EncNop():
                return 75
    for termIndex in 0..<prepared.termRecipes.len:
        let site = prepared.termRecipes[termIndex]
        let siteCount = adapter.RegallocA64SiteRecipeWordCount(site)
        if !site.reachable:
            if siteCount != 0 || prepared.termWordStarts[termIndex] != -1:
                return 76
            continue
        if siteCount <= 0 ||
           termIndex >= prepared.termWordStarts.len ||
           prepared.termWordStarts[termIndex] < 0 ||
           site.machineOwnerKind !=
               contract.RegallocA64SiteOwnerTerm ||
           site.effectMask < 0 || site.effectMask > 31 ||
           (site.effectMask & 7) !=
               adapter.RegallocA64WordsSpMemoryCallEffectMask(
                   site.words) ||
           prepared.termWordCounts[termIndex] != siteCount:
            return 76
        if prepared.termWordStarts[termIndex] >
           prepared.functionWords.len - siteCount:
            return 130
        for wordIndex in 0..<siteCount:
            if prepared.functionWords[
                   prepared.termWordStarts[termIndex] + wordIndex] !=
               site.words[wordIndex]:
                return 131
        for branchIndex in 0..<site.branchWordIndices.len:
            let wordIndex = site.branchWordIndices[branchIndex]
            if wordIndex < 0 || wordIndex >= site.words.len ||
               site.words[wordIndex] == a64.A64EncBPlaceholder():
                return 77
        if site.irKind == ir.BodyTermReturnTag:
            if site.words[site.words.len - 1] != a64.A64EncRet():
                return 118
        elif site.irKind == ir.BodyTermBrTag ||
             site.irKind == ir.BodyTermCbrTag:
            if site.branchWordIndices.len <= 0 ||
               site.branchWordIndices[site.branchWordIndices.len - 1] !=
                   site.words.len - 1 ||
               site.branchConditionCodes[
                   site.branchConditionCodes.len - 1] != -1:
                # The final explicit B prevents physical fallthrough into the
                # source-adjacent trampoline of a different outgoing edge.
                return 119
    for edgeIndex in 0..<prepared.edgeSplitWordStarts.len:
        let splitStart = prepared.edgeSplitWordStarts[edgeIndex]
        if splitStart < 0:
            continue
        if edgeIndex >= plan.edgeSourceBlocks.len ||
           edgeIndex >= plan.edgeTargetBlocks.len:
            return 86
        let sourceBlock = plan.edgeSourceBlocks[edgeIndex]
        let targetBlock = plan.edgeTargetBlocks[edgeIndex]
        if sourceBlock < 0 || sourceBlock >= body.blocks.len ||
           targetBlock < 0 || targetBlock >= body.blocks.len:
            return 87
        let termIndex = body.blocks[sourceBlock].termIndex
        let termSite = prepared.termRecipes[termIndex]
        var sawRedirect: bool
        for branchIndex in 0..<termSite.branchWordIndices.len:
            if termSite.branchTargetBlocks[branchIndex] != targetBlock:
                continue
            let localWord = termSite.branchWordIndices[branchIndex]
            let absoluteWord = prepared.termWordStarts[termIndex] +
                               localWord
            let delta = splitStart - absoluteWord
            var expectedWord: int32
            if termSite.branchConditionCodes[branchIndex] >= 0:
                expectedWord = Value(a64.A64EncBCond(
                    int64(delta),
                    termSite.branchConditionCodes[branchIndex]))
            else:
                expectedWord = Value(a64.A64EncBImm(int64(delta)))
            if termSite.words[localWord] != expectedWord ||
               prepared.functionWords[absoluteWord] != expectedWord:
                return 88
            sawRedirect = true
        if !sawRedirect:
            return 89
        var trampolineBranch = splitStart
        for actionIndex in 0..<plan.actions.len:
            if plan.actions[actionIndex].placement ==
                   alloc.RegallocValuePlacementEdge &&
               plan.actions[actionIndex].edgeIndex == edgeIndex:
                let actionEnd = prepared.actionWordStarts[actionIndex] +
                                prepared.actionWordCounts[actionIndex]
                if actionEnd > trampolineBranch:
                    trampolineBranch = actionEnd
        if trampolineBranch < 0 ||
           trampolineBranch >= prepared.functionWords.len ||
           prepared.functionWords[trampolineBranch] != Value(a64.A64EncBImm(
               int64(prepared.blockWordStarts[targetBlock] -
                     trampolineBranch))):
            return 90
    var sawProducer: bool
    var sawCall: bool
    var priorActionStart: int32 = -1
    var priorMachineActionEnd: int32 = -1
    for recipeIndex in 0..<prepared.recipes.len:
        let recipe = prepared.recipes[recipeIndex]
        if recipe.actionKind >= 101 && recipe.actionKind <= 128:
            seen[recipe.actionKind - 101] = true
        let count = adapter.RegallocA64ActionRecipeWordCount(recipe)
        if count < 0:
            return 50
        if prepared.actionWordStarts[recipeIndex] < priorActionStart:
            return 112
        priorActionStart = prepared.actionWordStarts[recipeIndex]
        if recipe.bindingKind == alloc.RegallocValueBindingStructural:
            if count != 0 || recipe.relocs.len != 0 ||
               recipe.effectMask != 0:
                return 51
            continue
        if count <= 0:
            return 52
        if prepared.actionWordStarts[recipeIndex] <
           priorMachineActionEnd:
            return 113
        priorMachineActionEnd =
            prepared.actionWordStarts[recipeIndex] + count
        if recipe.effectMask < 0 || recipe.effectMask > 31 ||
           (recipe.effectMask & 7) !=
               adapter.RegallocA64WordsSpMemoryCallEffectMask(
                   recipe.words):
            return 93
        if recipeIndex >= prepared.actionWordStarts.len ||
           recipeIndex >= prepared.actionWordCounts.len ||
           prepared.actionWordStarts[recipeIndex] < 0 ||
           prepared.actionWordCounts[recipeIndex] != count ||
           prepared.actionWordStarts[recipeIndex] >
               prepared.functionWords.len - count:
            return 78
        for wordIndex in 0..<count:
            if prepared.functionWords[
                   prepared.actionWordStarts[recipeIndex] + wordIndex] !=
               recipe.words[wordIndex]:
                return 79
        var filled: int32[]
        for _ in 0..<(count + 2):
            add(filled, -1)
        let end = adapter.RegallocA64ActionRecipeFill(
            recipe, filled, 1)
        if end != count + 1 || filled[0] != -1 ||
           filled[count + 1] != -1:
            return 53
        for wordIndex in 0..<count:
            if filled[wordIndex + 1] != recipe.words[wordIndex] ||
               recipe.words[wordIndex] == 0 ||
               recipe.words[wordIndex] == a64.A64EncNop():
                return 54
        if recipe.actionKind == alloc.RegallocValueActionBindDef ||
           recipe.actionKind == alloc.RegallocValueActionStoreDef ||
           recipe.actionKind == alloc.RegallocValueActionStoreHome:
            if !recipe.ownsBodyOp || recipe.producerOpKind <= 0:
                return 55
            sawProducer = true
        if recipe.actionKind == alloc.RegallocValueActionCallClobber:
            if !recipe.ownsBodyOp || !recipe.ownsCall ||
               recipe.relocs.len != 1 ||
               recipe.relocs[0].kind !=
                   contract.RegallocA64RelocCall26 ||
               recipe.words[recipe.relocs[0].wordIndex] !=
                   a64.A64EncBlPlaceholder():
                return 56
            sawCall = true
    if requireProducer && !sawProducer:
        return 57
    if requireCall && !sawCall:
        return 58
    return 0

fn main(): int32 =
    let kindCode = verifyKindTables()
    if kindCode != 0:
        return kindCode
    let scalarFieldCode = verifyFieldScalarBaseRejected()
    if scalarFieldCode != 0:
        return scalarFieldCode
    let wideAggregateCode = verifyWideAggregateFieldStores()
    if wideAggregateCode != 0:
        return wideAggregateCode
    let indexedAggregateCode = verifyIndexedAggregateStore()
    if indexedAggregateCode != 0:
        return indexedAggregateCode
    let aggregateParamCode = verifyAggregateParamMemory()
    if aggregateParamCode != 0:
        return aggregateParamCode
    let localStrCode = verifyLocalStrFieldLoad()
    if localStrCode != 0:
        return localStrCode
    let globalAggregateCode = verifyGlobalAggregateMemory()
    if globalAggregateCode != 0:
        return globalAggregateCode
    let borrowAggregateCode = verifyBorrowAggregateFieldLoad()
    if borrowAggregateCode != 0:
        return borrowAggregateCode
    let dynamicSeqCode = verifyDynamicSeqIndexedOrder()
    if dynamicSeqCode != 0:
        return dynamicSeqCode
    let ptrControlCode = verifyPtrStoreControl()
    if ptrControlCode != 0:
        return ptrControlCode
    var seen: bool[]
    for _ in 0..<28:
        add(seen, false)
    var constBody = buildConstBody()
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var constPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        constBody, constraints)
    if !constPlan.valid:
        return 60
    let constCode = verifyRecipes(constBody, constPlan, seen, true, false)
    if constCode != 0:
        return constCode
    var callBody = buildDirectCallBody()
    var callConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var callPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        callBody, callConstraints)
    if !callPlan.valid:
        return 61
    let callCode = verifyRecipes(callBody, callPlan, seen, false, true)
    if callCode != 0:
        return callCode
    var coalescedBody = buildCoalescedCopyBody()
    var coalescedConstraints = callerOnlyConstraints()
    var coalescedPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        coalescedBody, coalescedConstraints)
    if !coalescedPlan.valid:
        return 175
    let coalescedCode = verifyRecipes(
        coalescedBody, coalescedPlan, seen, false, false)
    if coalescedCode != 0:
        return coalescedCode
    var pressureBody = buildPressureBody()
    var pressureConstraints = callerOnlyConstraints()
    var pressurePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        pressureBody, pressureConstraints)
    if !pressurePlan.valid:
        return 62
    let pressureCode = verifyRecipes(
        pressureBody, pressurePlan, seen, true, false)
    if pressureCode != 0:
        return pressureCode
    var crossBody = buildCrossCallBody()
    var crossConstraints = callerOnlyConstraints()
    var crossPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        crossBody, crossConstraints)
    if !crossPlan.valid:
        return 63
    let crossCode = verifyRecipes(
        crossBody, crossPlan, seen, false, true)
    if crossCode != 0:
        return crossCode
    var stackResultBody = buildStackResultBody()
    var stackResultConstraints = zeroAllocConstraints()
    var stackResultPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        stackResultBody, stackResultConstraints)
    if !stackResultPlan.valid:
        return 64
    let stackResultCode = verifyRecipes(
        stackResultBody, stackResultPlan, seen, false, true)
    if stackResultCode != 0:
        return stackResultCode
    var stackArgBody = buildStackArgBody()
    var stackArgConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var stackArgPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        stackArgBody, stackArgConstraints)
    if !stackArgPlan.valid:
        return 65
    let stackArgCode = verifyRecipes(
        stackArgBody, stackArgPlan, seen, false, true)
    if stackArgCode != 0:
        return stackArgCode
    var sretCallBody = buildSretCallBody()
    var sretCallConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var sretCallPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        sretCallBody, sretCallConstraints)
    if !sretCallPlan.valid:
        return 66
    let sretCallCode = verifyRecipes(
        sretCallBody, sretCallPlan, seen, false, true)
    if sretCallCode != 0:
        return sretCallCode
    var sretReturnBody = buildSretReturnBody()
    var sretReturnConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var sretReturnPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        sretReturnBody, sretReturnConstraints)
    if !sretReturnPlan.valid:
        return 67
    let sretReturnCode = verifyRecipes(
        sretReturnBody, sretReturnPlan, seen, false, false)
    if sretReturnCode != 0:
        return sretReturnCode
    var edgeBody = buildEdgeBody()
    var edgeConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var edgePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        edgeBody, edgeConstraints)
    if !edgePlan.valid:
        return 68
    let edgeCode = verifyRecipes(
        edgeBody, edgePlan, seen, false, false)
    if edgeCode != 0:
        return edgeCode
    var deadBody = buildDeadBody()
    var deadConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var deadPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        deadBody, deadConstraints)
    if !deadPlan.valid:
        return 69
    let deadCode = verifyRecipes(
        deadBody, deadPlan, seen, false, false)
    if deadCode != 0:
        return deadCode
    var addressHomeBody = buildAddressHomeBody()
    var addressHomeConstraints =
        alloc.RegallocTargetConstraintsA64Darwin()
    var addressHomePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        addressHomeBody, addressHomeConstraints)
    if !addressHomePlan.valid:
        return 70
    let addressHomeCode = verifyRecipes(
        addressHomeBody, addressHomePlan, seen, true, true)
    if addressHomeCode != 0:
        return addressHomeCode
    var cycleBody = buildParallelCycleBody()
    var cycleConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var cyclePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        cycleBody, cycleConstraints)
    if !cyclePlan.valid:
        return 71
    let cycleCode = verifyRecipes(
        cycleBody, cyclePlan, seen, true, false)
    if cycleCode != 0:
        return cycleCode
    let cyclePrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            cycleBody, cyclePlan)
    if !cyclePrepared.valid:
        return 72
    var sawTermReturn: bool
    var sawTermBr: bool
    var sawTermCbr: bool
    for termIndex in 0..<cyclePrepared.termRecipes.len:
        let termKind = cyclePrepared.termRecipes[termIndex].irKind
        if termKind == ir.BodyTermReturnTag:
            sawTermReturn = true
        elif termKind == ir.BodyTermBrTag:
            sawTermBr = true
        elif termKind == ir.BodyTermCbrTag:
            sawTermCbr = true
    if !sawTermReturn || !sawTermBr || !sawTermCbr:
        return 73
    var siteBody = buildNoDefStoreAndLegacyControlBody()
    var siteConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var sitePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        siteBody, siteConstraints)
    if !sitePlan.valid:
        return 174
    let siteCode = verifyRecipes(
        siteBody, sitePlan, seen, false, false)
    if siteCode != 0:
        return siteCode
    let sitePrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            siteBody, sitePlan)
    if !sitePrepared.valid || sitePrepared.opRecipes.len != 5:
        return 75
    let expectedSiteKinds = [
        ir.BodyOpIndexedStoreTag,
        ir.BodyOpFieldStoreTag,
        ir.BodyOpGlobalStoreTag,
        ir.BodyOpBranchTag,
        ir.BodyOpReturnTag,
    ]
    for opIndex in 0..<expectedSiteKinds.len:
        let site = sitePrepared.opRecipes[opIndex]
        if site.irKind != expectedSiteKinds[opIndex] ||
           site.ownedByAction || site.words.len <= 0:
            return 76
    if sitePrepared.opRecipes[2].relocs.len != 2 ||
       sitePrepared.opRecipes[2].relocs[0].kind !=
           contract.RegallocA64RelocPage21 ||
       sitePrepared.opRecipes[2].relocs[1].kind !=
           contract.RegallocA64RelocPageOff12:
        return 77
    var unreachableBody = buildUnreachableGuardBody()
    var unreachableConstraints =
        alloc.RegallocTargetConstraintsA64Darwin()
    var unreachablePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        unreachableBody, unreachableConstraints)
    if !unreachablePlan.valid:
        return 91
    let unreachablePrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            unreachableBody, unreachablePlan)
    if !unreachablePrepared.valid ||
       unreachablePrepared.reachableBlockCount != 1 ||
       unreachablePrepared.blockEmissionOrder.len != 1 ||
       unreachablePrepared.blockEmissionOrder[0] != 0 ||
       unreachablePrepared.blockWordStarts[1] != -1 ||
       unreachablePrepared.opRecipes.len != 1 ||
       unreachablePrepared.opRecipes[0].reachable ||
       unreachablePrepared.opRecipes[0].words.len != 0 ||
       unreachablePrepared.opWordStarts[0] != -1 ||
       unreachablePrepared.termRecipes[1].reachable ||
       unreachablePrepared.termWordStarts[1] != -1:
        return 92
    var strEqBody = buildStrEqBody()
    var strEqConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var strEqPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        strEqBody, strEqConstraints)
    if !strEqPlan.valid:
        return 94
    let strEqPrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            strEqBody, strEqPlan)
    if !strEqPrepared.valid:
        return 95
    var sawStrEqOwner: bool
    for recipeIndex in 0..<strEqPrepared.recipes.len:
        let recipe = strEqPrepared.recipes[recipeIndex]
        if recipe.producerOpKind != ir.BodyOpStrEqTag:
            continue
        var sawX7: bool
        var sawX8: bool
        var sawX16: bool
        var sawX17: bool
        for regIndex in 0..<recipe.writtenRegs.len:
            let reg = recipe.writtenRegs[regIndex]
            if reg == a64.A64X7:
                sawX7 = true
            elif reg == a64.A64X8:
                sawX8 = true
            elif reg == a64.A64X16:
                sawX16 = true
            elif reg == a64.A64X17:
                sawX17 = true
        if !sawX7 || !sawX8 || !sawX16 || !sawX17 ||
           (recipe.effectMask &
                (contract.RegallocA64EffectX16 |
                 contract.RegallocA64EffectX17)) !=
                (contract.RegallocA64EffectX16 |
                 contract.RegallocA64EffectX17):
            return 96
        sawStrEqOwner = true
    if !sawStrEqOwner:
        return 97
    var dualEdgeBody = buildDualEdgeCopyCbrBody()
    var dualEdgeConstraints =
        alloc.RegallocTargetConstraintsA64Darwin()
    var dualEdgePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        dualEdgeBody, dualEdgeConstraints)
    if !dualEdgePlan.valid:
        return 114
    let dualEdgeCode = verifyRecipes(
        dualEdgeBody, dualEdgePlan, seen, true, false)
    if dualEdgeCode != 0:
        return dualEdgeCode
    let dualEdgePrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            dualEdgeBody, dualEdgePlan)
    if !dualEdgePrepared.valid:
        return 115
    var sawDualSplitCbr: bool
    for blockIndex in 0..<dualEdgeBody.blocks.len:
        let termIndex = dualEdgeBody.blocks[blockIndex].termIndex
        if dualEdgeBody.terms[termIndex].kind != ir.BodyTermCbrTag:
            continue
        var splitCount: int32
        var trueSplit: int32 = -1
        var falseSplit: int32 = -1
        for edgeIndex in 0..<dualEdgePlan.edgeSourceBlocks.len:
            if dualEdgePlan.edgeSourceBlocks[edgeIndex] != blockIndex ||
               dualEdgePrepared.edgeSplitWordStarts[edgeIndex] < 0:
                continue
            splitCount = splitCount + 1
            if dualEdgePlan.edgeTargetBlocks[edgeIndex] ==
               dualEdgeBody.terms[termIndex].trueBlock:
                trueSplit = dualEdgePrepared.edgeSplitWordStarts[edgeIndex]
            if dualEdgePlan.edgeTargetBlocks[edgeIndex] ==
               dualEdgeBody.terms[termIndex].falseBlock:
                falseSplit = dualEdgePrepared.edgeSplitWordStarts[edgeIndex]
        if splitCount == 2:
            if trueSplit < 0 || falseSplit < 0 ||
               trueSplit == falseSplit:
                return 116
            sawDualSplitCbr = true
    if !sawDualSplitCbr:
        return 117
    var badFrameBody = buildConstBody()
    var badFrameConstraints = alloc.RegallocTargetConstraintsA64Darwin()
    var badFramePlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        badFrameBody, badFrameConstraints)
    if !badFramePlan.valid:
        return 78
    badFrameBody.localSlots[0].stackOffset = 0
    let badFrameRecipes =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            badFrameBody, badFramePlan)
    if badFrameRecipes.valid ||
       badFrameRecipes.errorCode !=
           contract.RegallocA64RecipeErrorPlan:
        return 79
    for kindIndex in 0..<28:
        let kind = 101 + kindIndex
        if !seen[kindIndex]:
            return 80 + kindIndex
    return 0
