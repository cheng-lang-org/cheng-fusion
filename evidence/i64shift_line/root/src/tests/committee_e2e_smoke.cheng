# committee e2e smoke: four validators independently order a 100-event
# DAG view (different insertion orders per validator), agree on one linear
# sequence, sign it, and produce a finality certificate that a third party
# WITHOUT any DAG view can verify. Tampered certificates are rejected.

import std/os
import std/system
import std/rawbytes
import std/strutils as strutil
import std/crypto/sha512 as sha512
import cheng/std/bytes_layout as layout
import cheng/chain/dag_ordering as dord
import cheng/chain/committee_vote as cvt
import cheng/chain/finality_certificate as fcert

fn CidTag(b: int32, salt: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    BytesSet(raw, 1, salt)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

# Build the same 100-event graph with a validator-specific insertion order:
# the walk position pos maps to event j = (pos * 7 + shift) mod 100; edges
# are fixed: parentA = event j-1 (j>0), parentB = event j-7 (j>6).
fn BuildView(shift: int32): dord.DagOrderView =
    var view = dord.DagOrderView()
    let zeroCid = layout.FixedBytes32()
    var pos: int32 = 0
    while pos < 100:
        let j: int32 = (pos * 7 + shift) % 100
        # cid depends only on the event identity j: all validators must see
        # byte-identical events, differing only in insertion order.
        let cid = CidTag(j, 0)
        var pa = zeroCid
        var hasA: bool = false
        var pb = zeroCid
        var hasB: bool = false
        if j > 0:
            pa = CidTag(j - 1, shift)
            hasA = true
        if j > 6:
            pb = CidTag(j - 7, shift)
            hasB = true
        # tick encodes j so tie-break stays deterministic per depth
        dord.DagOrderPush(view, cid, pa, hasA, pb, hasB, 1, Int64(j), 0)
        pos = pos + 1
    return view

fn ProposalHashFromSeq(seq: layout.FixedBytes32[]): layout.FixedBytes32 =
    let total: int32 = seq.len * 32
    var buf = BytesAlloc(total)
    var i: int32
    while i < seq.len:
        let b = layout.FixedBytes32ToBytes(seq[i])
        var k: int32
        while k < 32:
            BytesSet(buf, i * 32 + k, BytesGet(b, k))
            k = k + 1
        i = i + 1
    let d = sha512.Sha512Digest(buf)
    BytesFree(buf)
    let res = layout.FixedBytes32FromBytes(BytesSlice(d, 0, 32))
    return res.value

@borrows
fn VotesToPks(votes: cvt.SignedVote[]): Bytes[] =
    var outP: Bytes[]
    var i: int32
    while i < votes.len:
        add(outP, votes[i].voterPk)
        i = i + 1
    return outP

@borrows
fn VotesToSigs(votes: cvt.SignedVote[]): Bytes[] =
    var outS: Bytes[]
    var i: int32
    while i < votes.len:
        add(outS, votes[i].sig)
        i = i + 1
    return outS

@borrows
fn CloneOwnedBytes(src: Bytes): Bytes =
    var out = BytesAlloc(src.len)
    var k: int32
    while k < src.len:
        BytesSet(out, k, BytesGet(src, k))
        k = k + 1
    return out

fn main(): int32 =
    var rc: int32 = 0
    let epoch: int32 = 9
    let round: int32 = 41

    let sk0 = BytesFromHex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
    let sk1 = BytesFromHex("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
    let sk2 = BytesFromHex("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7")
    let sk3 = BytesFromHex("3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c")

    # force all four into the committee: each holds the full stake weight
    var v0 = cvt.CommitteeDraw(sk0, 100, 100, epoch, round)
    var v1 = cvt.CommitteeDraw(sk1, 100, 100, epoch, round)
    var v2 = cvt.CommitteeDraw(sk2, 100, 100, epoch, round)
    var v3 = cvt.CommitteeDraw(sk3, 100, 100, epoch, round)
    if !v0.ok or !v1.ok or !v2.ok or !v3.ok:
        os.WriteLine(os.Get_stderr(), "validator draw failed")
        return 1

    var members: cvt.CommitteeMember[]
    add(members, v0.value)
    add(members, v1.value)
    add(members, v2.value)
    add(members, v3.value)

    # each validator orders its own insertion-ordered view of the same graph
    var views: dord.DagOrderView[]
    add(views, BuildView(0))
    add(views, BuildView(13))
    add(views, BuildView(29))
    add(views, BuildView(61))

    var proposals: layout.FixedBytes32[]
    var vi: int32
    while vi < views.len:
        var seq: layout.FixedBytes32[]
        let orc: int32 = dord.DagOrderCommitSequence(views[vi], seq)
        if orc != 0:
            os.WriteLine(os.Get_stderr(), "ordering errored")
            rc = rc + 1
        if seq.len != 100:
            os.WriteLine(os.Get_stderr(), strutil.Join(["seq len wrong for validator ", IntToStr(vi)], ""))
            rc = rc + 1
        add(proposals, ProposalHashFromSeq(seq))
        vi = vi + 1

    # consensus: all four proposal hashes identical despite different insertions
    if proposals.len == 4:
        var mi: int32 = 1
        while mi < 4:
            if !layout.FixedBytes32Equal(proposals[0], proposals[mi]):
                os.WriteLine(os.Get_stderr(), strutil.Join(["validator ", IntToStr(mi), " diverged"], ""))
                rc = rc + 1
            mi = mi + 1

    # every validator signs the common proposal
    var votes: cvt.SignedVote[]
    var pks: Bytes[]
    vi = 0
    while vi < members.len:
        let vres = cvt.CommitteeSignVote(members[vi], proposals[0])
        if vres.ok:
            add(votes, vres.value)
            add(pks, CloneOwnedBytes(members[vi].pk))
        vi = vi + 1
    if votes.len != 4:
        os.WriteLine(os.Get_stderr(), "not all validators signed")
        rc = rc + 1

    # certificate assembly and light-client verification (no DAG needed)
    let certRes = fcert.FcertCreate(proposals[0], epoch, round,
                                    VotesToPks(votes), VotesToSigs(votes))
    if !certRes.ok:
        os.WriteLine(os.Get_stderr(), "cert create failed")
        rc = rc + 1
    else:
        let vf = fcert.FcertVerify(certRes.value, pks, 1)
        if !vf.ok:
            os.WriteLine(os.Get_stderr(), "light client rejected valid certificate")
            rc = rc + 1

        # tamper: a different proposal hash invalidates EVERY signature
        # (signatures cover the hash), so quorum collapses to zero.
        var bad = certRes.value
        bad.proposalHash = CidTag(99, 99)
        let vfBad = fcert.FcertVerify(bad, pks, 1)
        if vfBad.ok:
            os.WriteLine(os.Get_stderr(), "tampered certificate accepted")
            rc = rc + 1

    if rc == 0:
        echo("committee_e2e_smoke ok")
    return rc
