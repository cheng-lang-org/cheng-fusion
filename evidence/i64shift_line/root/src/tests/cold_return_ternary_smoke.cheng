module cold_return_ternary_smoke

fn nestedThen(): int32 =
    return true ? (false ? 7 : 11) : 13

fn nestedElse(): int32 =
    return false ? 17 : (true ? 19 : 23)

fn plainThen(): int32 =
    return true ? 29 : 31

fn plainElse(): int32 =
    return false ? 37 : 41

fn main(): int32 =
    if nestedThen() != 11:
        return 1
    if nestedElse() != 19:
        return 2
    if plainThen() != 29:
        return 3
    if plainElse() != 41:
        return 4
    return 0

main()
