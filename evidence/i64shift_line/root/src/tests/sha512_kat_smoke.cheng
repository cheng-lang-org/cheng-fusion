# SHA-512 known-answer tests.
# Oracle: python3 hashlib.sha512.
# Inputs: empty, "abc", pattern bytes (i & 255) of length 111/112/128/129
# (length-padding and block boundaries), and 1000 LCG pseudo-random bytes
# (seed 42, x = (x * 1103515245 + 12345) mod 2^31, byte = (x >> 16) & 255).

import std/system
import std/strings
import std/rawbytes
import std/crypto/sha512

fn patternBytes(n: int32): Bytes =
    let out: Bytes = BytesAlloc(n)
    var i: int32
    while i < n:
        BytesSet(out, i, i & 255)
        i = i + 1
    return out

fn lcgBytes(n: int32): Bytes =
    let out: Bytes = BytesAlloc(n)
    var x: int64 = 42
    var i: int32
    while i < n:
        x = (x * 1103515245 + 12345) % 2147483648
        BytesSet(out, i, int32((x >> 16) & 255))
        i = i + 1
    return out

fn checkKat(label: str, got: Bytes, expectedHex: str): bool =
    let gotHex: str = BytesToHex(got)
    if streq(gotHex, expectedHex):
        return true
    echo("sha512 KAT mismatch at input:")
    echo(label)
    echo("got:")
    echo(gotHex)
    echo("expected:")
    echo(expectedHex)
    return false

fn main(): int32 =
    var pass: int32
    let abcMsg: Bytes = BytesAlloc(3)
    BytesSet(abcMsg, 0, 97)
    BytesSet(abcMsg, 1, 98)
    BytesSet(abcMsg, 2, 99)
    if !checkKat("empty", Sha512Digest(BytesAlloc(0)), "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e"):
        return 1
    pass = pass + 1
    if !checkKat("abc", Sha512Digest(abcMsg), "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f"):
        return 1
    pass = pass + 1
    if !checkKat("len111", Sha512Digest(patternBytes(111)), "a1a111449b198d9b1f538bad7f3fc1022b3a5b1a5e90a0bc860de8512746cbc31599e6c834de3a3235327af0b51ff57bf7acf1974a73014d9c3953812edc7c8d"):
        return 1
    pass = pass + 1
    if !checkKat("len112", Sha512Digest(patternBytes(112)), "c5fbd731d19d2ae1180f001be72c2c1aaba1d7b094b3748880e24593b8e117a750e11c1bd867cc2f96dace8c8b74abd2d5c4f236be444e77d30d1916174070b9"):
        return 1
    pass = pass + 1
    if !checkKat("len128", Sha512Digest(patternBytes(128)), "1dffd5e3adb71d45d2245939665521ae001a317a03720a45732ba1900ca3b8351fc5c9b4ca513eba6f80bc7b1d1fdad4abd13491cb824d61b08d8c0e1561b3f7"):
        return 1
    pass = pass + 1
    if !checkKat("len129", Sha512Digest(patternBytes(129)), "1d9da57fbbdab09afb3506ab2d223d06109d65c1c8ad197f50138f714bc4c3f2fe5787922639c680acad1c651f955990425954ce2cba0c5cc83f2667d878eb0f"):
        return 1
    pass = pass + 1
    if !checkKat("lcg1000", Sha512Digest(lcgBytes(1000)), "2c81c80e7e80c39abf67baf2d27055b9fa33cce6dd87f7d708d0cd6df6138ab2d3c64d33cbbcea6bec93b21c8c1bb23d9624166ae84f1d223fba8fb3e4985cad"):
        return 1
    pass = pass + 1
    echo(Fmt" sha512_kat_smoke ok: {strings.IntToStr(pass)}/7 KATs passed")
    return 0
