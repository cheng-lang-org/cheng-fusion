import std/os as os
import std/rawbytes
import std/system

# 域G OS 原语动态负正例。测试侧只用裸 libc 构造初始管道；接收后的
# descriptor 从不跨 host 边界，只通过 production nativeRecvOwner 操作。

@importc("pipe")
fn libc_pipe(fds: ptr): int32
@importc("write")
fn libc_write(fd: int32, buf: ptr, count: int32): int64
@importc("read")
fn libc_read(fd: int32, buf: ptr, count: int32): int64
@importc("lseek")
fn libc_lseek(fd: int32, offset: int64, whence: int32): int64
@importc("cheng_host_darwin_recv_fd_vector_runtime")
fn hostDarwinRecvVectorOwner(
    socketFd: int32,
    payload: ptr,
    payloadBytes: int32): int32
@importc("cheng_host_terminal_activate_receive_owner_status")
fn hostReceiveOwnerStatus(owner: int32): int32
@importc("cheng_host_terminal_activate_receive_owner_bind")
fn hostReceiveOwnerBind(owner: int32): int32
@importc("cheng_host_terminal_activate_receive_owner_read")
fn hostReceiveOwnerRead(
    owner: int32,
    role: int32,
    buffer: ptr,
    byteCount: int32): int64
@importc("cheng_host_terminal_activate_receive_owner_close_role")
fn hostReceiveOwnerCloseRole(owner: int32, role: int32): int32
@importc("cheng_host_terminal_activate_receive_owner_abort")
fn hostReceiveOwnerAbort(owner: int32): int32

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(): int32 =
    var unameBuf: os.OsUtsname
    let _u = os.UnameRaw(unameBuf)
    let isDarwin = unameBuf.data[0] == uint8(68)

    let dotPath = system.strToCStringTemp(".")
    let dirFd = os.OpenFdRaw(dotPath, 0, 0)
    if dirFd < 0:
        return fail("open . failed")
    if os.ProcessRegistryAnonTmpFile(-1) >= 0 ||
       os.ProcessRegistryAnonTmpFile(99999) >= 0:
        return fail("anon tmpfile accepted invalid dirFd")
    let anonFd = os.ProcessRegistryAnonTmpFile(dirFd)
    if anonFd < 0:
        let _dirClose = os.CloseFdRaw(dirFd)
        return fail("anon tmpfile create failed")
    var probeByte: uint8[1]
    probeByte[0] = uint8(65)
    if libc_write(anonFd, ptr(&probeByte), 1) != int64(1) ||
       libc_lseek(anonFd, int64(0), 0) != int64(0):
        return fail("anon tmpfile write/seek failed")
    var readByte: uint8[1]
    if libc_read(anonFd, ptr(&readByte), 1) != int64(1) ||
       readByte[0] != uint8(65):
        return fail("anon tmpfile readback drifted")
    let _anonClose = os.CloseFdRaw(anonFd)
    let _dirClose2 = os.CloseFdRaw(dirFd)
    os.WriteLine(os.Get_stdout(), "anon tmpfile ok")

    if !isDarwin:
        os.WriteLine(os.Get_stdout(), "darwin native owner cases skipped")
        return 0

    var sockA: int32 = -1
    var sockB: int32 = -1
    if !os.ProcessRegistrySocketpair(1, 1, 0, sockA, sockB):
        return fail("socketpair failed")
    var pipeA: int32[2]
    var pipeB: int32[2]
    var pipeC: int32[2]
    if libc_pipe(ptr(&pipeA)) != 0 ||
       libc_pipe(ptr(&pipeB)) != 0 ||
       libc_pipe(ptr(&pipeC)) != 0:
        return fail("pipe failed")
    probeByte[0] = uint8(65)
    if libc_write(pipeA[1], ptr(&probeByte), 1) != int64(1):
        return fail("pipe prime failed")

    let payload = rawbytes.BytesFromString("vector-payload-0001")
    let payloadLen = rawbytes.BytesLen(payload)
    if os.ProcessRegistryDarwinSendFdVector3(
           sockA, payload, pipeA[0], pipeB[0], pipeC[0]) != payloadLen:
        return fail("3-role vector send failed")
    var recvBuf = rawbytes.BytesAlloc(payloadLen)
    let owner = hostDarwinRecvVectorOwner(
        sockB, rawbytes.BytesDataPtr(recvBuf), payloadLen)
    if owner <= 0 || hostReceiveOwnerStatus(owner) != 1 ||
       hostReceiveOwnerBind(owner) != 1:
        return fail("native receive owner bind failed")
    readByte[0] = uint8(0)
    if hostReceiveOwnerRead(owner, 1, ptr(&readByte), 1) != int64(1) ||
       readByte[0] != uint8(65):
        return fail("native receive owner role read failed")
    if hostReceiveOwnerCloseRole(owner, 1) != 1 ||
       hostReceiveOwnerCloseRole(owner, 2) != 1 ||
       hostReceiveOwnerCloseRole(owner, 3) != 1 ||
       hostReceiveOwnerAbort(owner) != 1:
        return fail("native receive owner close failed")
    os.WriteLine(os.Get_stdout(), "native receive owner exact3 ok")

    let barePayload = rawbytes.BytesFromString("bare-no-rights-0000")
    let bareLen = rawbytes.BytesLen(barePayload)
    if libc_write(
           sockA,
           rawbytes.BytesDataPtr(barePayload),
           bareLen) != int64(bareLen):
        return fail("bare datagram send failed")
    let rejectedOwner = hostDarwinRecvVectorOwner(
        sockB, rawbytes.BytesDataPtr(recvBuf), payloadLen)
    if rejectedOwner <= 0 || hostReceiveOwnerStatus(rejectedOwner) != 0 ||
       hostReceiveOwnerAbort(rejectedOwner) != 1:
        return fail("rights-less owner rejection failed")
    os.WriteLine(os.Get_stdout(), "rights-less owner rejected")

    for pipeIndex in 0..<2:
        let _closeA = os.CloseFdRaw(pipeA[pipeIndex])
        let _closeB = os.CloseFdRaw(pipeB[pipeIndex])
        let _closeC = os.CloseFdRaw(pipeC[pipeIndex])
    rawbytes.BytesFree(recvBuf)
    let _sockCloseA = os.CloseFdRaw(sockA)
    let _sockCloseB = os.CloseFdRaw(sockB)
    os.WriteLine(os.Get_stdout(), "csg_core_domain_g_os_primitives_smoke ok")
    return 0
