type
    ColdExactManagedPaths =
        entryPath: str
        sourcePath: str

fn ColdExactManagedFieldShareReuse(): int32 =
    var requestSourcePath = "source-a"
    var parsed: ColdExactManagedPaths
    parsed.entryPath = share(requestSourcePath)
    parsed.sourcePath = share(requestSourcePath)
    if requestSourcePath != "source-a":
        return 11
    if parsed.entryPath != requestSourcePath:
        return 12
    if parsed.sourcePath != requestSourcePath:
        return 13
    requestSourcePath = "source-b"
    if parsed.entryPath != "source-a" ||
       parsed.sourcePath != "source-a":
        return 14
    return 0

fn main(): int32 =
    return ColdExactManagedFieldShareReuse()
