import std/result
import std/rawbytes
import std/crypto/rand
import std/crypto/sha512
import std/crypto/chacha20poly1305

fn main(): int32 =
    let entropyRes: Result[Bytes] = rand.systemRandomBytes(64)
    if IsErr(entropyRes):
        echo(ErrorText(entropyRes))
        return 1
    let entropy: Bytes = Value(entropyRes)
    if BytesLen(entropy) != 64:
        echo("crypto_randombytes_smoke entropy len")
        return 1
    echo("crypto_randombytes_smoke entropy ok")

    let digest: Bytes = sha512.Sha512Digest(entropy)
    if BytesLen(digest) != 64:
        echo("crypto_randombytes_smoke sha512 len")
        return 1
    echo("crypto_randombytes_smoke sha512 ok")

    let key: Bytes = BytesSlice(digest, 0, 32)
    let nonce: Bytes = BytesSlice(digest, 32, 12)
    let block: Bytes = chacha20poly1305.Chacha20Block(key, 1, nonce)
    if BytesLen(block) != 64:
        echo("crypto_randombytes_smoke chacha block len")
        return 1
    echo("crypto_randombytes_smoke chacha ok")

    let autoRandomRes: Result[Bytes] = rand.RandomBytes(2)
    if IsErr(autoRandomRes):
        echo(ErrorText(autoRandomRes))
        return 1
    let autoRandomBytes: Bytes = Value(autoRandomRes)
    if BytesLen(autoRandomBytes) != 2:
        echo("crypto_randombytes_smoke auto random len")
        return 1
    echo("crypto_randombytes_smoke auto random ok")

    if !rand.SetRandomSeed(entropy):
        echo("crypto_randombytes_smoke seed failed")
        return 1
    echo("crypto_randombytes_smoke seed ok")

    let randomRes: Result[Bytes] = rand.RandomBytes(2)
    if IsErr(randomRes):
        echo(ErrorText(randomRes))
        return 1
    let randomBytes: Bytes = Value(randomRes)
    if BytesLen(randomBytes) != 2:
        echo("crypto_randombytes_smoke random len")
        return 1
    echo("crypto_randombytes_smoke ok")
    return 0
