# w15 isNullText (bail=8548) 语言边界定谳 repro。
# 验证改写后 (len(text)<=0) 与原始意图 (str 空/非空判定) 在所有真实
# str 构造路径下值语义等价：空串字面量/非空字面量/默认初始化/切片清空/拼接非空。
import std/os
import std/system
import std/strings as strings

@borrows
fn isNullText(text: str): bool =
    return len(text) <= 0

fn main(): int32 =
    var failCount: int32

    # 1. 空字面量 -> true
    if !isNullText(""):
        os.WriteLine(os.Get_stderr(), "FAIL case1 empty literal")
        failCount = failCount + 1

    # 2. 非空字面量 -> false
    if isNullText("hello"):
        os.WriteLine(os.Get_stderr(), "FAIL case2 nonempty literal")
        failCount = failCount + 1

    # 3. 省略初始化默认值 -> true (spec: str 省略初始化默认 "")
    var uninit: str
    if !isNullText(uninit):
        os.WriteLine(os.Get_stderr(), "FAIL case3 default-init str")
        failCount = failCount + 1

    # 4. 切成 0 长度 -> true
    let sliced: str = strings.sliceBytes("hello", 0, 0)
    if !isNullText(sliced):
        os.WriteLine(os.Get_stderr(), "FAIL case4 sliced-to-empty")
        failCount = failCount + 1

    # 5. 拼接后非空 -> false
    let joined: str = strings.concatStr("a", "b")
    if isNullText(joined):
        os.WriteLine(os.Get_stderr(), "FAIL case5 concatStr nonempty")
        failCount = failCount + 1

    if failCount == 0:
        os.WriteLine(os.Get_stdout(), "ALL_PASS")
        return 0
    os.WriteLine(os.Get_stdout(), "FAILURES")
    return 1
