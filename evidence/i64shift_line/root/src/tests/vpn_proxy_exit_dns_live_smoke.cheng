import std/result
import std/net/transports/tcp_syscall as tcp
import cheng/apps/vpn_proxy/vpn_proxy_exit_dns as exitdns

fn main(): int32 =
    let configureRes: Result[bool] = exitdns.VpnProxyExitDnsConfigureFromSystem("")
    if IsErr(configureRes):
        echo(ErrorText(configureRes))
        return 1
    let resolvedRes: Result[str] = exitdns.VpnProxyExitDnsResolveIpv4("www.google.com")
    if IsErr(resolvedRes):
        echo(ErrorText(resolvedRes))
        return 1
    let ipText: str = Value(resolvedRes)
    if !exitdns.VpnProxyExitDnsHostIsIpv4Literal(ipText):
        echo("vpn_proxy_exit_dns_live_smoke invalid resolved ip")
        return 1
    let connectRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4Timeout(ipText, 443, 5000)
    if IsErr(connectRes):
        echo(ErrorText(connectRes))
        return 1
    var conn: tcp.TcpConnectionHandle = Value(connectRes)
    tcp.TcpClose(conn)
    echo("vpn_proxy_exit_dns_live_smoke ok")
    return 0
