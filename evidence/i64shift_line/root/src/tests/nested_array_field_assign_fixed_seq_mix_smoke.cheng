# M5: two-level mixed -- outer FIXED array, inner DYNAMIC seq, tail scalar, const idx.
type
    Col =
        a: int32
        b: int32

type
    Row =
        cols: Col[]

type
    Grid =
        rows: Row[4]

fn main(): int32 =
    var g: Grid
    var c00: Col
    c00.a = 1
    add(g.rows[0].cols, c00)
    var c01: Col
    c01.a = 2
    add(g.rows[0].cols, c01)
    var c10: Col
    c10.a = 3
    add(g.rows[1].cols, c10)

    g.rows[0].cols[1].a = 999

    if g.rows[0].cols[1].a != 999:
        return 1
    if g.rows[0].cols[0].a != 1:
        return 2
    if g.rows[1].cols[0].a != 3:
        return 3
    return 0
