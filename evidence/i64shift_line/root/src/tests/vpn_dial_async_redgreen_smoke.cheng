# N-A 拨号异步化 红绿判据夹具(修复前后两树均可编译):
# 红(修复前): VpnProxyTunTcpEnsureRemoteOpen 在主循环线程内联冷拨 —— 池
#   miss 时 connect+TLS+AUTH 串行 3 轮退避, 调用线程被阻塞 ≥1s(本夹具用
#   127.0.0.1:1 拒连保确定性: 3 轮 = 400ms+800ms 硬退避)。
# 绿(修复后): 冷拨整体出循环 —— 调用立即以 pending 形态返回(<300ms),
#   拨号在后台 dial 线程执行, 数据面调用线程零阻塞。
# 判据: dt < 300ms 且流未被标记 remoteOpen。修复前此夹具必然超时判负(rc=21),
# 修复后通过(rc=0) —— 一只夹具同时充当红证与绿证。
import std/strings
import std/strutils
import std/result
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn
import cheng/apps/vpn_proxy/vpn_proxy_config as config
import cheng/apps/vpn_proxy/vpn_proxy_routing as routing

fn main(): int32 =
    var cfg: config.VpnProxyExitConfig
    cfg.name = strings.CloneStr("na")
    cfg.transport = strings.CloneStr("tcp-tls-forward")
    cfg.host = strings.CloneStr("127.0.0.1")
    cfg.port = 1
    cfg.serverName = strings.CloneStr("na.invalid")
    cfg.authority = strings.CloneStr("na.invalid")
    cfg.auth = strings.CloneStr("na-auth")
    var states: routing.VpnProxyExitState[]
    states = []
    add(states, routing.VpnProxyInitExitStateWithClientCertificate(cfg, false))
    var identity: vpn.VpnProxyLoadedIdentity
    var link: vpn.VpnProxyTunTcpLink
    link.open = true
    link.remoteOpen = false
    link.sessionKey = 4242
    link.targetHost = strings.CloneStr("target.invalid")
    link.targetPort = 443
    let t0: int64 = vpn.VpnProxyMonoNowMs()
    let res: Result[bool] = vpn.VpnProxyTunTcpEnsureRemoteOpen(states, identity, link)
    let dt: int64 = vpn.VpnProxyMonoNowMs() - t0
    if vpn.VpnProxyMonoNowMs() < int64(0):
        return 10
    echo(strutil.Join(["REDGREEN dt_ms=", strings.Int64ToStr(dt), " resErr=", strings.Int64ToStr(int64(int32(IsErr(res)))), " remoteOpen=", strings.Int64ToStr(int64(int32(link.remoteOpen)))], ""))
    if dt >= int64(300):
        echo("RED: ensure blocked the caller (inline cold dial)")
        return 21
    if link.remoteOpen:
        echo("unexpected: remoteOpen set on pending path")
        return 22
    # 编译可达性: 拉起 RunTunOnFd 全体(含 [dial-job] 收获段)过编译审计。
    # fd=-1 在入口卫语句即返回, 不起线程不开 TUN。
    var opts: vpn.VpnProxyCliOptions
    var tunRes: Result[bool] = vpn.VpnProxyRunTunOnFd(states, identity, opts, -1, 0, strings.CloneStr("rg"))
    if IsOk(tunRes):
        echo("unexpected: RunTunOnFd(-1) returned ok")
        return 23
    echo("GREEN: ensure returned pending without blocking the caller")
    return 0
