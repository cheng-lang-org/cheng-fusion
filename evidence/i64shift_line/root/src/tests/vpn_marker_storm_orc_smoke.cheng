# ORCU 家族归因夹具: vpnTunLastRelayError 单槽多线程写竞态(在库先例,
# 与 M:964 [nborc] 注释同族——"线程 A 写槽释放旧串时线程 B 正借读")。
# 三线程并发 VpnProxyPoolMarker(全部在库符号, 与 N-A 补丁无关):
# 期望(有竞态): 间歇性 ORCMISS / refcount_underflow(rc!=0)。
import std/strings
import std/thread
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn

fn stormEntry(raw: ptr) =
    var i: int32 = 0
    while i < 4000:
        vpn.VpnProxyPoolMarker(strings.CloneStr("storm"))
        i = i + 1

fn main(): int32 =
    let gen: uint64 = uint64(7)
    let w1 = thread.StartPtr(&stormEntry, ptr(gen))
    let w2 = thread.StartPtr(&stormEntry, ptr(gen))
    var i: int32 = 0
    while i < 4000:
        vpn.VpnProxyPoolMarker(strings.CloneStr("storm-main"))
        i = i + 1
    if w1 != nil:
        let _ = thread.JoinThread(w1)
    if w2 != nil:
        let _ = thread.JoinThread(w2)
    echo("marker storm done")
    return 0
