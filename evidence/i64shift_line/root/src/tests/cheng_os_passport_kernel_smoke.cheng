import "src/cheng_os/passport/kernel.cheng" as ker
import "src/cheng_os/passport/syscall.cheng" as sys
import "src/cheng_os/passport/effect.cheng" as eff

fn main(): int32 =
    var fails = 0
    var st = ker.InitState()
    if st != ker.StIdle:
        fails = fails | 1

    var r = ker.Step(st, sys.SysTick)
    if (ker.ActionsOf(r) & ker.ActShowIdentity) == 0:
        fails = fails | 2
    st = ker.NextStateOf(r)
    if st != ker.StIdle:
        fails = fails | 4

    r = ker.Step(st, sys.SysKey1Down)
    if (ker.ActionsOf(r) & ker.ActStartRec) == 0:
        fails = fails | 8
    st = ker.NextStateOf(r)
    if st != ker.StIntentArmed:
        fails = fails | 16

    r = ker.Step(st, sys.SysVoiceEnd)
    if (ker.ActionsOf(r) & ker.ActShowConfirm) == 0:
        fails = fails | 32
    st = ker.NextStateOf(r)
    if st != ker.StConfirming:
        fails = fails | 64

    r = ker.Step(st, sys.SysKey2Down)
    if (ker.ActionsOf(r) & ker.ActEmitConfirm) != 0:
        fails = fails | 128
    if (ker.ActionsOf(r) & ker.ActCancel) == 0:
        fails = fails | 256
    st = ker.NextStateOf(r)
    if st != ker.StIdle:
        fails = fails | 512

    r = ker.Step(st, sys.SysKey1Down)
    st = ker.NextStateOf(r)
    r = ker.Step(st, sys.SysKey1Up)
    st = ker.NextStateOf(r)
    r = ker.Step(st, sys.SysNfcTap)
    if (ker.ActionsOf(r) & ker.ActEmitConfirm) == 0:
        fails = fails | 1024
    st = ker.NextStateOf(r)
    if st != ker.StExecWait:
        fails = fails | 2048

    r = ker.StepCommand(st, eff.EffReceipt)
    if (ker.ActionsOf(r) & ker.ActShowReceipt) == 0:
        fails = fails | 4096
    if (ker.ActionsOf(r) & ker.ActTone) == 0:
        fails = fails | 8192
    st = ker.NextStateOf(r)
    if st != ker.StReceiptShown:
        fails = fails | 16384

    var idle = ker.InitState()
    r = ker.StepCommand(idle, eff.EffConfirmPrompt)
    if ker.NextStateOf(r) != ker.StConfirming:
        fails = fails | 32768
    if (ker.ActionsOf(r) & ker.ActShowConfirm) == 0:
        fails = fails | 65536

    r = ker.StepCommand(ker.StIdle, eff.EffReceipt)
    if (ker.ActionsOf(r) & ker.ActShowReceipt) != 0:
        fails = fails | 131072

    return fails
