import cheng/core/lang/intern as langintern

type
    IdBox[T] =
        ids: langintern.InternId[]
        tag: T

fn main(): int32 =
    var box: IdBox[int32]
    let ids: langintern.InternId[] = [1, 2, 3]
    box.ids = ids
    box.tag = 7
    if box.ids.len != 3:
        return 11
    return box.ids[0] + box.ids[1] + box.ids[2] + box.tag - 13

main()
