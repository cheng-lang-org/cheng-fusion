fn coldScalarRefCfgMergeRead(limit: int32, cursor: var int32): int32 =
  while cursor < limit:
    let current = cursor
    cursor = cursor + 1
    if current == 3:
      return current
  return -1

fn main(): int32 =
  var cursor = 0
  let value = coldScalarRefCfgMergeRead(8, cursor)
  if value != 3:
    return 1
  if cursor != 4:
    return 2
  return 0
