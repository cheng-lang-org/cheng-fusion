# UIR E-Graph rewrite compile smoke test:
# 1. Import the UIR E-Graph rewrite engine (transitively compiles uir_types + uir_core_types)
# 2. Call a simple standalone function to verify the module links and runs
# 3. This proves the UIR E-Graph pipeline compiles in the backend driver build
import cheng/core/backend/uir_egraph_rewrite as uirewrite

fn main(): int32 =
    let ruleCount = uirewrite.uirEGraphRuleCount()
    if ruleCount <= 0:
        return 1
    return 0
