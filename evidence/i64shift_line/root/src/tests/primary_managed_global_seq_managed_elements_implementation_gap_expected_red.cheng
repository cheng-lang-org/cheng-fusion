type
    ManagedRow =
        label: str
        code: int32

    ManagedSeqOwner =
        labels: str[]
        rows: ManagedRow[]

var managedLabelsGlobal: str[]
var managedRowsGlobal: ManagedRow[]

fn makeLabels(seed: int32): str[] =
    var values: str[]
    add(values, Fmt"managed-label-{seed}")
    add(values, Fmt"managed-label-{seed + 1}")
    return values

fn makeRows(seed: int32): ManagedRow[] =
    var values: ManagedRow[]
    var first: ManagedRow
    first.label = Fmt"managed-row-{seed}"
    first.code = seed
    add(values, first)
    var second: ManagedRow
    second.label = Fmt"managed-row-{seed + 1}"
    second.code = seed + 1
    add(values, second)
    return values

fn labelsMatch(seed: int32): bool =
    let first = Fmt"managed-label-{seed}"
    let second = Fmt"managed-label-{seed + 1}"
    return managedLabelsGlobal.len == 2 &&
           managedLabelsGlobal[0] == first &&
           managedLabelsGlobal[1] == second

fn rowsMatch(seed: int32): bool =
    let first = Fmt"managed-row-{seed}"
    let second = Fmt"managed-row-{seed + 1}"
    return managedRowsGlobal.len == 2 &&
           managedRowsGlobal[0].label == first &&
           managedRowsGlobal[0].code == seed &&
           managedRowsGlobal[1].label == second &&
           managedRowsGlobal[1].code == seed + 1

fn installBorrowedManagedElements(seed: int32): int32 =
    var owner: ManagedSeqOwner
    owner.labels = makeLabels(seed)
    owner.rows = makeRows(seed)
    managedLabelsGlobal = owner.labels
    managedRowsGlobal = owner.rows
    owner.labels = makeLabels(seed + 1000)
    owner.rows = makeRows(seed + 1000)
    if !labelsMatch(seed) || !rowsMatch(seed):
        return 1
    return 0

fn main(): int32 =
    # Both stores are legal Cheng.  They remain RED only while recursive
    # element retain/drop descriptors are missing; the final oracle is GREEN.
    managedLabelsGlobal = makeLabels(10)
    managedRowsGlobal = makeRows(10)
    if !labelsMatch(10) || !rowsMatch(10):
        return 1

    let borrowedRc = installBorrowedManagedElements(20)
    if borrowedRc != 0:
        return 2
    if !labelsMatch(20) || !rowsMatch(20):
        return 3

    managedLabelsGlobal = managedLabelsGlobal
    managedRowsGlobal = managedRowsGlobal
    if !labelsMatch(20) || !rowsMatch(20):
        return 4

    managedLabelsGlobal = []
    managedRowsGlobal = []
    if managedLabelsGlobal.len != 0 || managedRowsGlobal.len != 0:
        return 5
    return 0
