# Real transmit proof: moment-COMMENT request frame over a real QUIC loopback
# connection (the same msquicTransportWrite -> pipeWrite -> msquicNativePipeWrite
# STREAM-frame path the device uses). Mirrors the moment-like loopback smoke; the
# only difference is the protocol id (/unimaker/moment-comment/1.0.0) and the
# two-length-prefix [postIdLen][postId][commentLen][comment] frame.
#
# Proves WebSceneSocialBuildCommentFrameExport REALLY transmits bytes (not a stub):
# the client builds + writes the comment frame, the server reads it back over QUIC
# and parses postId + comment. If any byte failed to transmit/decrypt, the reads
# time out and the harness panics.

import std/system
import std/result
import std/os
import std/rawbytes
import std/strings as strings
import cheng/libp2p/core/types as types
import cheng/libp2p/core/multiaddr as multiaddr
import cheng/libp2p/transports/quic_transport as quic_transport
import cheng/core/runtime/web_scene_social_send as social

fn logLine(s: str) =
    os.WriteLine(os.Get_stdout(), s)

fn logInt(label: str, n: int32) =
    os.WriteLine(os.Get_stdout(), strings.ConcatStr(label, strings.IntToStr(n)))

fn main(): int32 =
    var listenAddr: types.Libp2pMultiaddr
    multiaddr.Libp2pMultiaddrFillQuic(listenAddr, "127.0.0.1", 0)
    var pair: quic_transport.Libp2pQuicLoopbackPair
    let openRes = quic_transport.Libp2pQuicLoopbackOpenInto(pair, listenAddr)
    if IsErr(openRes):
        panic(ErrorText(openRes))
    logLine("loopback open ok")

    # --- client: negotiate moment-comment protocol (real select bytes out the socket) ---
    let protocol: int32 = types.Libp2pProtocolSocialMomentComment
    let selRes = quic_transport.Libp2pQuicLoopbackSelectProtocol(pair, protocol)
    if IsErr(selRes):
        panic(ErrorText(selRes))
    logLine("negotiate ok (real select transmitted + echoed)")

    # --- client: build + transmit the comment frame (REAL bytes out) ---
    let frame = social.WebSceneSocialBuildCommentFrameExport("post-abc123", "first")
    let frameLen: int32 = rawbytes.BytesLen(frame)
    let wRes = quic_transport.Libp2pQuicLoopbackWriteClient(pair, frame)
    if IsErr(wRes):
        panic(ErrorText(wRes))
    if Value(wRes) != frameLen:
        panic("short frame write")
    logInt("frame transmitted bytes=", Value(wRes))

    # --- server: read the frame back over QUIC, parse postId + comment ---
    let lenRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, 4)
    if IsErr(lenRes):
        panic(ErrorText(lenRes))
    let lenBytes = Value(lenRes)
    let idLen: int32 = (rawbytes.BytesGet(lenBytes, 0) << 24) |
                       (rawbytes.BytesGet(lenBytes, 1) << 16) |
                       (rawbytes.BytesGet(lenBytes, 2) << 8) |
                       rawbytes.BytesGet(lenBytes, 3)
    let idBodyRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, idLen)
    if IsErr(idBodyRes):
        panic(ErrorText(idBodyRes))
    let postId: str = rawbytes.BytesToString(Value(idBodyRes))
    logLine(strings.ConcatStr("server received postId=", postId))

    let cLenRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, 4)
    if IsErr(cLenRes):
        panic(ErrorText(cLenRes))
    let cLenBytes = Value(cLenRes)
    let cLen: int32 = (rawbytes.BytesGet(cLenBytes, 0) << 24) |
                      (rawbytes.BytesGet(cLenBytes, 1) << 16) |
                      (rawbytes.BytesGet(cLenBytes, 2) << 8) |
                      rawbytes.BytesGet(cLenBytes, 3)
    let cBodyRes = quic_transport.Libp2pQuicLoopbackReadServer(pair, cLen)
    if IsErr(cBodyRes):
        panic(ErrorText(cBodyRes))
    let comment: str = rawbytes.BytesToString(Value(cBodyRes))
    logLine(strings.ConcatStr("server received comment=", comment))

    quic_transport.Libp2pQuicLoopbackClose(pair)
    if postId == "post-abc123" && comment == "first":
        logLine("MOMENT_COMMENT_REAL_TRANSMIT_OK")
    else:
        logLine("MOMENT_COMMENT_MISMATCH")
    return 0
