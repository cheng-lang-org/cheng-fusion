import std/result
import std/strings

# A is mutually exclusive with B/C, but B and C execute on the same path.
# A canonical cp1 representative must never hide the B -> C double consume.
fn ColdOkResultThreeConsumer(selectFirst: bool): Result[str] =
    let owned = strings.CloneStr("three-consumer-owned")
    if selectFirst:
        return Ok[str](owned)
    let second = Ok[str](owned)
    if IsErr(second):
        return second
    return Ok[str](owned)

fn main(): int32 =
    let result = ColdOkResultThreeConsumer(false)
    if IsErr(result):
        return 1
    return 0
