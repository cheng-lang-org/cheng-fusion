# libp2p P3 收尾片: 撤销新鲜度网络腿 — 应答方 (A) 服务端 exe (正典 §11.6 P3)。
# A 真两进程之一: 派生根钥 + 被撤钥 → 各签一份 v1 自证 head 存库 → 对被撤钥造一份自撤销记录
# 存库 (channel_revocations/<Crev>/<revokedPub>) → 真 bind + AcceptTimed, 统一分发 HEAD/WANT/REVOKE。
# A 对自库负责 (撤销 wire 原样透传), 全部验签/授权/新鲜度在客户端 B。
#
# 用法: --port 0 --ready-path <f> --store-root <dir> --root-seed N --revoked-seed M
#       --source-content <s> [--serve-count N] [--wait-ms W]

import std/system
import std/result
import std/cmdline as cmdline
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import std/crypto/sha512 as sha512
import std/crypto/ed25519/ref10 as ref10
import cheng/libp2p/cas_store as cas
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/protocols/cas_source/channel_head/head_store as headstore
import cheng/libp2p/protocols/cas_source/channel_head/authz_codec as authz
import cheng/libp2p/protocols/cas_source/channel_head/authz_store as authzstore
import cheng/libp2p/host/host_quic as hq
import std/strutils as strutil

fn deriveKeypair(seedv: int32, priv: var Bytes, pub: var Bytes) =
    var seed = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(seed, i, (seedv + i) & 255)
    var digest = sha512.Sha512Digest(seed)
    BytesSet(digest, 0, BytesGet(digest, 0) & 248)
    BytesSet(digest, 31, (BytesGet(digest, 31) & 63) | 64)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, BytesSlice(digest, 0, 32))
    pub = ref10.geP3ToBytes(r)
    priv = BytesConcat(seed, pub)

fn storeHead(storeRoot: str, priv: Bytes, pub: Bytes, headCid: layout.FixedBytes32, epoch: int64) =
    let genesis = head.ChannelHeadGenesisPrev()
    var signRes = head.ChannelHeadSign(priv, epoch, headCid, genesis, pub)
    assert(signRes.ok, " server: sign head: " + Error(signRes))
    var putRes = headstore.ChannelHeadStorePut(storeRoot, signRes.value)
    assert(putRes.ok, " server: head store put: " + Error(putRes))

fn main(): int32 =
    let port = cmdline.ReadInt32FlagOrDefault("--port", 0)
    let readyPath = cmdline.ReadFlagOrDefault("--ready-path", "")
    let storeRoot = cmdline.ReadFlagOrDefault("--store-root", "")
    let rootSeed = cmdline.ReadInt32FlagOrDefault("--root-seed", 31)
    let revokedSeed = cmdline.ReadInt32FlagOrDefault("--revoked-seed", 47)
    let sourceContent = cmdline.ReadFlagOrDefault("--source-content", "")
    let serveCount = cmdline.ReadInt32FlagOrDefault("--serve-count", 4)
    let waitMs = cmdline.ReadInt32FlagOrDefault("--wait-ms", 4000)
    assert(readyPath != "", " server: --ready-path required")
    assert(storeRoot != "", " server: --store-root required")
    assert(sourceContent != "", " server: --source-content required")

    var rootPriv: Bytes
    var rootPub: Bytes
    deriveKeypair(rootSeed, rootPriv, rootPub)
    let channelC = head.ChannelIdForPubKey(rootPub)

    var revokedPriv: Bytes
    var revokedPub: Bytes
    deriveKeypair(revokedSeed, revokedPriv, revokedPub)
    let channelRev = head.ChannelIdForPubKey(revokedPub)

    # 源进 A 的 CAS (headCid = 内容 sha256)。
    let ingestRes = cas.CasStoreIngest(storeRoot, sourceContent)
    assert(ingestRes.ok, " server: cas ingest: " + Error(ingestRes))
    let headCid = cas.CasContentCid(sourceContent)

    # 两条 v1 自证 head 存库 (C 与 Crev 各一)。
    storeHead(storeRoot, rootPriv, rootPub, headCid, int64(1))
    storeHead(storeRoot, revokedPriv, revokedPub, headCid, int64(1))

    # 被撤钥自撤销记录存库 (A=Crev, B=revokedPub, signer=revokedPub; selfRoot 授权)。
    let revokedPubFixed = layout.FixedBytes32FromBytes(revokedPub).value
    var revSign = authz.AuthzRecordSign(authz.AuthzTagRevoke, revokedPriv, channelRev, revokedPubFixed, int64(1), revokedPub)
    assert(revSign.ok, " server: revoke sign: " + Error(revSign))
    var revAdmit = authzstore.AuthzRevocationAdmit(storeRoot, revSign.value)
    assert(revAdmit.ok, " server: revoke admit: " + Error(revAdmit))

    echo(strutil.Join([" cas_revoke server channel_c=", layout.FixedBytes32Hex(channelC),
                       " channel_rev=", layout.FixedBytes32Hex(channelRev),
                       " root_pub=", rawbytes.BytesToHex(rootPub),
                       " revoked_pub=", rawbytes.BytesToHex(revokedPub)], ""))

    let serveRes = hq.Libp2pHostQuicServeCasUnified("127.0.0.1",
                                                     port,
                                                     "localhost",
                                                     storeRoot,
                                                     readyPath,
                                                     serveCount,
                                                     waitMs)
    assert(serveRes.ok, " server: serve: " + Error(serveRes))
    echo(strutil.Join([" cas_revoke_server ok served=", IntToStr(serveRes.value)], ""))
    return 0
