import std/os
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_schema as schema

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn BuildBindingSnapshot(): schema.CsgCompilerSnapshotTables =
    var out: schema.CsgCompilerSnapshotTables
    out.sources.documentCids = [TestCid("binding/source")]
    out.texts = ["Fn", "p", "shadow"]
    out.spans.sourceIds = [0, 0, 0, 0, 0, 0]
    out.tokens.valueTextIds = [0, 1, 2, 2, 0, 1]
    out.parserSidecars.sourceIds = [0]
    out.parserSidecars.producerSourceIndexes = [0]
    out.parserSidecars.declarationProducerSourceIds =
        [0, 0, 0, 0, 0, 0]
    out.parserSidecars.declarationSourceLocalRows =
        [0, 1, 2, 3, 4, 5]
    out.parserSidecars.declarationKinds = [
        schema.CsgCompilerParserDeclarationFunction,
        schema.CsgCompilerParserDeclarationParameter,
        schema.CsgCompilerParserDeclarationLocal,
        schema.CsgCompilerParserDeclarationLocal,
        schema.CsgCompilerParserDeclarationFunction,
        schema.CsgCompilerParserDeclarationParameter]
    out.parserSidecars.declarationFunctionRows = [0, 0, 0, 0, 1, 1]
    out.parserSidecars.declarationNameTokenIds = [0, 1, 2, 3, 4, 5]
    out.parserSidecars.declarationNameSpanIds = [0, 1, 2, 3, 4, 5]
    out.parserSidecars.declarationSpanIds = [0, 1, 0, 0, 4, 5]
    out.parserSidecars.patternProducerSourceIds = [0, 0]
    out.parserSidecars.patternSourceLocalRows = [0, 1]
    out.parserSidecars.patternKinds = [1, 1]
    out.parserSidecars.patternBindingDeclarationIds = [2, 3]
    out.parserSidecars.functionIndexes = [0, 1]
    out.parserSidecars.functionBodySpanIds = [0, 1]
    out.parserSidecars.normalizedExprFunctionIndexes = [0, 0]
    out.parserSidecars.normalizedExprParserNodeIds = [0, 1]
    out.parserSidecars.normalizedExprStatementRoles = [
        schema.CsgCompilerParserStatementBindingInitializer,
        schema.CsgCompilerParserStatementBindingInitializer]
    out.parserSidecars.statementRootNodeIds = [0, 1]
    out.parserSidecars.statementRootRoles = [
        schema.CsgCompilerParserStatementBindingInitializer,
        schema.CsgCompilerParserStatementBindingInitializer]
    out.parserSidecars.statementRootBindingDeclarationStarts = [2, 3]
    out.parserSidecars.statementRootBindingDeclarationCounts = [1, 1]
    out.parserNodes.sourceIds = [0, 0, 0, 0, 0]
    out.parserNodes.producerNodeIds = [0, 1, 2, 3, 4]
    out.parserNodes.kinds = [
        schema.CsgCompilerParserValueExprIdentifier,
        schema.CsgCompilerParserValueExprIdentifier,
        schema.CsgCompilerParserValueExprIdentifier,
        schema.CsgCompilerParserValueExprIdentifier,
        schema.CsgCompilerParserValueExprIdentifier]
    out.parserNodes.bindingResolutionKinds = [
        schema.CsgCompilerParserBindingResolutionNone,
        schema.CsgCompilerParserBindingResolutionNone,
        schema.CsgCompilerParserBindingResolutionPattern,
        schema.CsgCompilerParserBindingResolutionPattern,
        schema.CsgCompilerParserBindingResolutionParameter]
    out.parserNodes.bindingDeclarationSourceLocalRows =
        [-1, -1, 2, 3, 1]
    out.parserNodes.bindingPatternSourceLocalRows =
        [-1, -1, 0, 1, -1]
    out.functions.symbolIds = [0, 1]
    out.functions.typedFunctionIndexes = [0, 1]
    out.functions.bodySpanIds = [0, 1]
    out.functions.valueDefinitionStarts = [0, 3]
    out.functions.valueDefinitionCounts = [3, 0]
    out.functions.valueDefinitionGroupStarts = [0, 2]
    out.functions.valueDefinitionGroupCounts = [2, 0]
    out.symbols.sourceIds = [0, 0, 0, 0, 0, 0]
    out.symbols.symbolKinds = [
        schema.CsgCompilerSymbolFunction,
        schema.CsgCompilerSymbolFunction,
        schema.CsgCompilerSymbolParameter,
        schema.CsgCompilerSymbolLocal,
        schema.CsgCompilerSymbolLocal,
        schema.CsgCompilerSymbolParameter]
    out.symbols.ownerSymbolIds = [-1, -1, 0, 0, 0, 1]
    out.symbols.nameTokenIds = [0, 4, 1, 2, 3, 5]
    out.symbols.nameSpanIds = [0, 4, 1, 2, 3, 5]
    out.symbols.declarationSpanIds = [0, 4, 1, 0, 0, 5]
    out.symbols.typeIds = [0, 0, 0, 0, 0, 0]
    out.types.typeCids = [TestCid("binding/type")]
    out.types.producerTypeArenaIds = [0]
    out.types.managedFlags = [false]
    out.typedNodes.functionIds = [0, 0, 0, 0, 0]
    out.typedNodes.opKinds = [
        schema.CsgCompilerTypedOpCallExpr,
        schema.CsgCompilerTypedOpCallExpr,
        schema.CsgCompilerTypedOpLocalRef,
        schema.CsgCompilerTypedOpLocalRef,
        schema.CsgCompilerTypedOpParamRef]
    out.typedNodes.typedIrNodeIndexes = [0, 1, 2, 3, 4]
    out.typedNodes.bindingProducerSourceIndexes =
        [-1, -1, 0, 0, 0]
    out.typedNodes.bindingParserSourceLocalNodeRows =
        [-1, -1, 2, 3, 4]
    out.typedNodes.bindingDeclarationSourceLocalRows =
        [-1, -1, 2, 3, 1]
    out.typedNodes.bindingPatternSourceLocalRows =
        [-1, -1, 0, 1, -1]
    out.typedNodes.bindingValueDefinitionRows =
        [-1, -1, 0, 1, 2]
    out.typedNodes.producedValueDefinitionRows =
        [0, 1, -1, -1, 2]
    out.typedNodes.ownerStatementIds = [0, 1, 0, 1, -1]
    out.typedNodes.originParserNodeIds = [0, 1, 2, 3, 4]
    out.typedNodes.spanIds = [0, 1, 2, 3, 4]
    out.typedNodes.typeIds = [0, 0, 0, 0, 0]
    out.typedNodes.ownershipKinds = [
        schema.CsgCompilerOwnershipUnmanaged,
        schema.CsgCompilerOwnershipUnmanaged,
        schema.CsgCompilerOwnershipUnmanaged,
        schema.CsgCompilerOwnershipUnmanaged,
        schema.CsgCompilerOwnershipUnmanaged]
    out.typedNodes.operand0NodeIds = [-1, -1, -1, -1, -1]
    out.typedNodes.operand1NodeIds = [-1, -1, -1, -1, -1]
    out.typedNodes.operand2NodeIds = [-1, -1, -1, -1, -1]
    out.typedStatements.typedIrStatementIndexes = [0, 1]
    out.typedStatements.functionIds = [0, 0]
    out.typedStatements.rootStarts = [0, 2]
    out.typedStatements.rootCounts = [2, 2]
    out.typedStatements.rootTypedNodeIds = [0, 2, 1, 3]
    out.valueDefinitions.originKinds = [
        schema.CsgCompilerValueDefinitionOriginBindingInitializer,
        schema.CsgCompilerValueDefinitionOriginBindingInitializer,
        schema.CsgCompilerValueDefinitionOriginParameter]
    out.valueDefinitions.groupRows = [0, 1, -1]
    out.valueDefinitions.producerSourceIndexes = [0, 0, 0]
    out.valueDefinitions.sourceLocalNodeIndexes = [0, 1, -1]
    out.valueDefinitions.declarationSourceLocalRows = [2, 3, 1]
    out.valueDefinitions.patternSourceLocalRows = [0, 1, -1]
    out.valueDefinitions.functionIds = [0, 0, 0]
    out.valueDefinitions.definingTypedNodeIds = [0, 1, 4]
    out.valueDefinitions.typeIds = [0, 0, 0]
    out.valueDefinitions.ownershipKinds = [
        schema.CsgCompilerOwnershipUnmanaged,
        schema.CsgCompilerOwnershipUnmanaged,
        schema.CsgCompilerOwnershipUnmanaged]
    out.valueDefinitions.proofKinds = [1, 1, 1]
    out.valueDefinitionGroups.producerSourceIndexes = [0, 0]
    out.valueDefinitionGroups.parserProducerSourceIndexes = [0, 0]
    out.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes =
        [0, 1]
    out.valueDefinitionGroups.bindingOffsets = [0, 0]
    out.valueDefinitionGroups.bindingCounts = [1, 1]
    out.valueDefinitionGroups.functionIds = [0, 0]
    out.valueDefinitionGroups.declarationSourceLocalRows = [2, 3]
    out.valueDefinitionGroups.patternSourceLocalRows = [0, 1]
    out.valueDefinitionGroups.definitionRows = [0, 1]
    out.valueDefinitionGroups.consumedFlags = [1, 1]
    return out

fn SwapPair(values: var int32[]) =
    let first = values[0]
    values[0] = values[1]
    values[1] = first

fn main() =
    var err: str
    let valid = BuildBindingSnapshot()
    assert(
        schema.CsgCompilerTypedStatementOwnerAuthorityStrictValidateInto(
            valid, err),
        err)
    assert(
        schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            valid, err),
        err)

    var crossFunction =
        schema.CsgCompilerSnapshotTablesClone(valid)
    crossFunction.typedNodes.functionIds[4] = 1
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            crossFunction, err),
        "same-source cross-function ParamRef forgery accepted")

    var crossFunctionLocal =
        schema.CsgCompilerSnapshotTablesClone(valid)
    crossFunctionLocal.typedNodes.functionIds[2] = 1
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            crossFunctionLocal, err),
        "same-source cross-function LocalRef forgery accepted")

    var stripped =
        schema.CsgCompilerSnapshotTablesClone(valid)
    for nodeRow in [2, 4]:
        stripped.typedNodes.bindingProducerSourceIndexes[nodeRow] = -1
        stripped.typedNodes.bindingParserSourceLocalNodeRows[nodeRow] = -1
        stripped.typedNodes.bindingDeclarationSourceLocalRows[nodeRow] = -1
        stripped.typedNodes.bindingPatternSourceLocalRows[nodeRow] = -1
        stripped.typedNodes.bindingValueDefinitionRows[nodeRow] = -1
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            stripped, err),
        "source-backed binding identity stripping accepted")

    var nonReferenceForge =
        schema.CsgCompilerSnapshotTablesClone(valid)
    nonReferenceForge.typedNodes.bindingProducerSourceIndexes[0] = 0
    nonReferenceForge.typedNodes.bindingParserSourceLocalNodeRows[0] = 2
    nonReferenceForge.typedNodes.bindingDeclarationSourceLocalRows[0] = 2
    nonReferenceForge.typedNodes.bindingPatternSourceLocalRows[0] = 0
    nonReferenceForge.typedNodes.bindingValueDefinitionRows[0] = 0
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            nonReferenceForge, err),
        "non-reference binding identity forgery accepted")

    var definitionForge =
        schema.CsgCompilerSnapshotTablesClone(valid)
    definitionForge.typedNodes.bindingValueDefinitionRows[2] = 1
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            definitionForge, err),
        "LocalRef value-definition forgery accepted")

    var fullTupleForge =
        schema.CsgCompilerSnapshotTablesClone(valid)
    fullTupleForge.typedNodes.bindingDeclarationSourceLocalRows[2] = 3
    fullTupleForge.typedNodes.bindingPatternSourceLocalRows[2] = 1
    fullTupleForge.typedNodes.bindingValueDefinitionRows[2] = 1
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            fullTupleForge, err),
        "same-function complete LocalRef target forgery accepted")

    var strippedParserAuthority =
        schema.CsgCompilerSnapshotTablesClone(valid)
    strippedParserAuthority.parserNodes.bindingResolutionKinds[2] =
        schema.CsgCompilerParserBindingResolutionNone
    strippedParserAuthority.parserNodes.bindingDeclarationSourceLocalRows[
        2] = -1
    strippedParserAuthority.parserNodes.bindingPatternSourceLocalRows[2] =
        -1
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            strippedParserAuthority, err),
        "parser-authored LocalRef authority stripping accepted")

    var parserTargetForge =
        schema.CsgCompilerSnapshotTablesClone(valid)
    parserTargetForge.parserNodes.bindingDeclarationSourceLocalRows[2] = 3
    parserTargetForge.parserNodes.bindingPatternSourceLocalRows[2] = 1
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            parserTargetForge, err),
        "parser/typed LocalRef target disagreement accepted")

    var reordered =
        schema.CsgCompilerSnapshotTablesClone(valid)
    SwapPair(reordered.valueDefinitions.groupRows)
    SwapPair(reordered.valueDefinitions.producerSourceIndexes)
    SwapPair(reordered.valueDefinitions.declarationSourceLocalRows)
    SwapPair(reordered.valueDefinitions.patternSourceLocalRows)
    SwapPair(reordered.valueDefinitions.functionIds)
    SwapPair(reordered.valueDefinitions.definingTypedNodeIds)
    SwapPair(reordered.valueDefinitions.typeIds)
    SwapPair(reordered.valueDefinitions.ownershipKinds)
    SwapPair(reordered.valueDefinitions.proofKinds)
    SwapPair(reordered.valueDefinitionGroups.producerSourceIndexes)
    SwapPair(
        reordered.valueDefinitionGroups.parserProducerSourceIndexes)
    SwapPair(
        reordered.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes)
    SwapPair(reordered.valueDefinitionGroups.bindingOffsets)
    SwapPair(reordered.valueDefinitionGroups.bindingCounts)
    SwapPair(reordered.valueDefinitionGroups.functionIds)
    SwapPair(
        reordered.valueDefinitionGroups.declarationSourceLocalRows)
    SwapPair(reordered.valueDefinitionGroups.patternSourceLocalRows)
    SwapPair(reordered.valueDefinitionGroups.definitionRows)
    SwapPair(reordered.valueDefinitionGroups.consumedFlags)
    reordered.valueDefinitions.groupRows = [0, 1]
    reordered.valueDefinitionGroups.definitionRows = [0, 1]
    reordered.typedNodes.bindingValueDefinitionRows[2] = 1
    reordered.typedNodes.bindingValueDefinitionRows[3] = 0
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            reordered, err),
        "synchronized value-definition/group reorder accepted")

    var reorderedWithSortedRoots =
        schema.CsgCompilerSnapshotTablesClone(reordered)
    reorderedWithSortedRoots.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes =
        [0, 1]
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            reorderedWithSortedRoots, err),
        "reordered group escaped through rewritten initializer order")

    var mergedRoots =
        schema.CsgCompilerSnapshotTablesClone(valid)
    mergedRoots.valueDefinitionGroups.initializerRootSourceLocalNodeIndexes =
        [0, 0]
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            mergedRoots, err),
        "single-root merge escaped value-definition group CSR")

    var bindingCountForge =
        schema.CsgCompilerSnapshotTablesClone(valid)
    bindingCountForge.valueDefinitionGroups.bindingCounts[0] = 2
    assert(
        !schema.CsgCompilerTypedNodeBindingAuthorityStrictValidateInto(
            bindingCountForge, err),
        "PatternBinding declaration count forgery accepted")

    var firstBindingReference =
        schema.CsgCompilerSnapshotTablesClone(valid)
    firstBindingReference.references.sourceIds = [0]
    firstBindingReference.references.spanIds = [2]
    firstBindingReference.references.ownerFunctionIds = [0]
    firstBindingReference.references.ownerSymbolIds = [0]
    firstBindingReference.references.targetSymbolIds = [3]
    firstBindingReference.references.referenceKinds = [
        schema.CsgCompilerReferenceRead]
    firstBindingReference.references.bindingTypedNodeIds = [2]
    assert(
        schema.CsgCompilerBindingReferenceTargetStrictValidateInto(
            firstBindingReference, 0, err),
        err)

    var referenceKindForge =
        schema.CsgCompilerSnapshotTablesClone(firstBindingReference)
    referenceKindForge.references.referenceKinds[0] =
        schema.CsgCompilerReferenceWrite
    assert(
        !schema.CsgCompilerBindingReferenceTargetStrictValidateInto(
            referenceKindForge, 0, err),
        "LocalRef producer accepted a forged Write reference")

    var synchronizedTargetForge =
        schema.CsgCompilerSnapshotTablesClone(firstBindingReference)
    synchronizedTargetForge.references.targetSymbolIds[0] = 4
    assert(
        !schema.CsgCompilerBindingReferenceTargetStrictValidateInto(
            synchronizedTargetForge, 0, err),
        "same-name LocalRef target substitution survived reference validation")

    var secondBindingReference =
        schema.CsgCompilerSnapshotTablesClone(valid)
    secondBindingReference.references.sourceIds = [0]
    secondBindingReference.references.spanIds = [3]
    secondBindingReference.references.ownerFunctionIds = [0]
    secondBindingReference.references.ownerSymbolIds = [0]
    secondBindingReference.references.targetSymbolIds = [4]
    secondBindingReference.references.referenceKinds = [
        schema.CsgCompilerReferenceRead]
    secondBindingReference.references.bindingTypedNodeIds = [3]
    assert(
        schema.CsgCompilerBindingReferenceTargetStrictValidateInto(
            secondBindingReference, 0, err),
        "same-statement second binding failed exact reference validation")

    var parameterReference =
        schema.CsgCompilerSnapshotTablesClone(valid)
    parameterReference.references.sourceIds = [0]
    parameterReference.references.spanIds = [4]
    parameterReference.references.ownerFunctionIds = [0]
    parameterReference.references.ownerSymbolIds = [0]
    parameterReference.references.targetSymbolIds = [2]
    parameterReference.references.referenceKinds = [
        schema.CsgCompilerReferenceRead]
    parameterReference.references.bindingTypedNodeIds = [4]
    assert(
        schema.CsgCompilerBindingReferenceTargetStrictValidateInto(
            parameterReference, 0, err),
        err)
    parameterReference.references.targetSymbolIds[0] = 5
    assert(
        !schema.CsgCompilerBindingReferenceTargetStrictValidateInto(
            parameterReference, 0, err),
        "same-source cross-function ParamRef target survived reference validation")

    var completeReferences =
        schema.CsgCompilerSnapshotTablesClone(valid)
    completeReferences.references.sourceIds = [0, 0, 0]
    completeReferences.references.spanIds = [4, 2, 3]
    completeReferences.references.ownerFunctionIds = [0, 0, 0]
    completeReferences.references.ownerSymbolIds = [0, 0, 0]
    completeReferences.references.targetSymbolIds = [2, 3, 4]
    completeReferences.references.referenceKinds = [
        schema.CsgCompilerReferenceRead,
        schema.CsgCompilerReferenceRead,
        schema.CsgCompilerReferenceRead]
    completeReferences.references.bindingTypedNodeIds = [4, 2, 3]
    assert(
        schema.CsgCompilerBindingReferencesStrictValidateInto(
            completeReferences, err),
        err)

    var strippedReferenceIdentity =
        schema.CsgCompilerSnapshotTablesClone(completeReferences)
    strippedReferenceIdentity.references.bindingTypedNodeIds = [4, 2]
    assert(
        !schema.CsgCompilerBindingReferencesStrictValidateInto(
            strippedReferenceIdentity, err),
        "binding TypedNode identity column stripping accepted")

    var deletedBindingReference =
        schema.CsgCompilerSnapshotTablesClone(completeReferences)
    deletedBindingReference.references.sourceIds = [0, 0]
    deletedBindingReference.references.spanIds = [4, 2]
    deletedBindingReference.references.ownerFunctionIds = [0, 0]
    deletedBindingReference.references.ownerSymbolIds = [0, 0]
    deletedBindingReference.references.targetSymbolIds = [2, 3]
    deletedBindingReference.references.referenceKinds = [
        schema.CsgCompilerReferenceRead,
        schema.CsgCompilerReferenceRead]
    deletedBindingReference.references.bindingTypedNodeIds = [4, 2]
    assert(
        !schema.CsgCompilerBindingReferencesStrictValidateInto(
            deletedBindingReference, err),
        "complete binding Reference row deletion accepted")

    var duplicateReferenceIdentity =
        schema.CsgCompilerSnapshotTablesClone(completeReferences)
    duplicateReferenceIdentity.references.bindingTypedNodeIds = [4, 2, 2]
    assert(
        !schema.CsgCompilerBindingReferencesStrictValidateInto(
            duplicateReferenceIdentity, err),
        "duplicate binding TypedNode identity accepted")

    var swappedReferenceIdentity =
        schema.CsgCompilerSnapshotTablesClone(completeReferences)
    swappedReferenceIdentity.references.bindingTypedNodeIds = [4, 3, 2]
    assert(
        !schema.CsgCompilerBindingReferencesStrictValidateInto(
            swappedReferenceIdentity, err),
        "same-name multi-binding TypedNode substitution accepted")

    os.WriteLine(
        os.Get_stdout(), "csg_compiler_binding_identity_smoke: ok")
