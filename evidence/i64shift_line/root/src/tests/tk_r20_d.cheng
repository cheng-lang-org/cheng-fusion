fn R20Find(line: str, start: int32): int32 =
    if start < line.len:
        return start
    return -1

fn R20Append(lineRaw: str): int32 =
    var total: int32
    var searchStart: int32
    while searchStart < lineRaw.len:
        let breakPos = R20Find(lineRaw, searchStart)
        var tokenStart = -1
        var surfaceText = "break"
        if breakPos >= 0:
            tokenStart = breakPos
        else:
            tokenStart = breakPos
            surfaceText = "continue"
        if tokenStart < 0:
            return total
        total = total + surfaceText.len
        searchStart = searchStart + 1
    return total

fn main(): int32 =
    let n = R20Append("break")
    if n != 25:
        return 10
    echo("r20 ok")
    return 0
