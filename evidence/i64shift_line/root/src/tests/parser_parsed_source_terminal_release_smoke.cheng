import std/cmdline as cmdline
import cheng/core/lang/parser as parser

fn main(argc: int32, argv: str*): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    assert(cmdline.ParamCount() == 3,
           "parsed source terminal release: expected package root and source")
    let packageRoot = cmdline.ParamStr(1)
    let sourcePath = cmdline.ParamStr(2)
    var parsed: parser.ParsedSourceStub
    var parseErr: str
    assert(parser.ParseOrdinarySourceStub(
               packageRoot, sourcePath, parsed, parseErr),
           "parsed source terminal release: parse failed")
    assert(parsed.ownerModulePaths.len > 0,
           "parsed source terminal release: owner module paths missing")
    assert(parsed.orderedClosureSourcePaths.len > 0,
           "parsed source terminal release: closure source paths missing")
    assert(parsed.importEdges.len > 0,
           "parsed source terminal release: import edges missing")
    assert(parsed.importEdges[0].ownerModulePath != "" &&
           parsed.importEdges[0].targetModulePath != "" &&
           parsed.importEdges[0].targetSourcePath != "",
           "parsed source terminal release: import edge text missing")
    let expectedBufferCount =
        parser.ParsedSourceStubPhysicalBufferCount(parsed)
    let expectedTextCount =
        parser.ParsedSourceStubManagedTextCount(parsed)
    let expectedBytes =
        parser.ParsedSourceStubRetainedBytes(parsed)
    assert(expectedBufferCount > 0,
           "parsed source terminal release: no physical buffers")
    assert(expectedTextCount > 0,
           "parsed source terminal release: no managed text")
    assert(expectedBytes > int64(0),
           "parsed source terminal release: no retained bytes")
    var receipt: parser.ParsedSourceStubTerminalReleaseReceipt
    parser.ParsedSourceStubTerminalReleaseWithReceipt(parsed, receipt)
    assert(receipt.releasedBufferCount == expectedBufferCount,
           "parsed source terminal release: buffer receipt mismatch")
    assert(receipt.releasedTextCount == expectedTextCount,
           "parsed source terminal release: text receipt mismatch")
    assert(receipt.releasedBytes == expectedBytes,
           "parsed source terminal release: byte receipt mismatch")
    assert(receipt.normalizedExprLayer.storageReleased,
           "parsed source terminal release: normalized layer retained")
    assert(receipt.storageReleased,
           "parsed source terminal release: source storage retained")
    var emptyReceipt: parser.ParsedSourceStubTerminalReleaseReceipt
    parser.ParsedSourceStubTerminalReleaseWithReceipt(
        parsed, emptyReceipt)
    assert(emptyReceipt.releasedBufferCount == 0,
           "parsed source terminal release: second buffer release")
    assert(emptyReceipt.releasedTextCount == 0,
           "parsed source terminal release: second text release")
    assert(emptyReceipt.releasedBytes == int64(0),
           "parsed source terminal release: second byte release")
    assert(emptyReceipt.storageReleased,
           "parsed source terminal release: second release retained storage")
    echo(Fmt"parsed_source_stub_terminal_release=1 released_buffers={receipt.releasedBufferCount} released_texts={receipt.releasedTextCount} released_bytes={receipt.releasedBytes} live_buffers=0 live_texts=0 live_bytes=0 storage_released=1 second_release_buffers=0 second_release_texts=0 second_release_bytes=0")
    return 0
