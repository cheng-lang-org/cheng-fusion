import std/system
import std/seqs
import std/strings

type
    FlatBox = ref object
        k: str[]
        v: int32[]
        h: uint64[]
        s: uint8[]

@borrows
fn flatInit(b: FlatBox) =
    var k: str[]
    seqs.setLen(k, 8)
    var v: int32[]
    seqs.setLen(v, 8)
    var h: uint64[]
    seqs.setLen(h, 8)
    var s: uint8[]
    seqs.setLen(s, 40)
    for i in 0..<8:
        k[i] = ""
        v[i] = 0
        h[i] = uint64(0)
    for i in 0..<s.len:
        s[i] = uint8(0)
    b.k = k
    b.v = v
    b.h = h
    b.s = s

@borrows
fn flatPut(b: FlatBox, text: str, id: int32) =
    var k = b.k
    b.k = []
    var v = b.v
    b.v = []
    var h = b.h
    b.h = []
    var s = b.s
    b.s = []
    k[3] = strings.CloneStr(text)
    v[3] = id
    h[3] = uint64(12345)
    s[3] = uint8(1)
    s[8] = uint8(3)
    b.k = k
    b.v = v
    b.h = h
    b.s = s

fn main() =
    var b: FlatBox = new(FlatBox)
    flatInit(b)
    flatPut(b, "alpha", 7)
    assert(b.v[3] == 7, "flat d1: value")
    echo("repro_flatcols_d1 ok")
