# AES-128-GCM bulk benchmark (isolation build): the 16-byte key selects
# rounds==10 in aes.aesEncryptBlockInto, which routes through
# aesEncryptBlockHwHost -> cheng_crypto_aes_block_enc128. On an arm64 compiler
# whose backend carries the AES recognizer strings (baked from current source)
# the seam call inlines to the 33-word AESE/AESMC kernel; older compilers
# fall back to the scalar body (correct, slow). This bench exists so the
# hardware-speed measurement is one command once the compiler pipeline bakes.
# Baseline (stage3 8.16, scalar fallback): AESGCM128_bulk_1MB ~3.6MB/s.
# C reference on the same machine (CommonCrypto CCCrypt AES-128-ECB): 13080MB/s.
import std/crypto/aesgcm
import std/rawbytes
import std/strings
import std/os

@importc("cheng_monotime_ns")
fn monoNs(): int64

const benchRecordBytes = 16384
const benchRecordsPerRound = 64
const benchRounds = 6

fn benchFillRandom(buf: rawbytes.Bytes) =
    var i: int32 = 0
    var seed: int32 = 123456789
    while i < rawbytes.BytesLen(buf):
        seed = (seed * 1103515245 + 12345) & 2147483647
        rawbytes.BytesSet(buf, i, (seed >> 16) & 255)
        i = i + 1

fn benchPrint(text: str) =
    os.WriteLine(os.Get_stdout(), text)

fn benchReport(name: str, dtNs: int64) =
    let totalBytes: int64 = int64(benchRecordBytes) * int64(benchRecordsPerRound) * int64(benchRounds)
    var clamped: int64 = dtNs
    if clamped < 1:
        clamped = 1
    let ms: int64 = clamped / int64(1000000)
    let rateK: int64 = (totalBytes * int64(1000000)) / clamped
    benchPrint(name)
    benchPrint(strings.Int64ToStr(ms))
    benchPrint(strings.Int64ToStr(rateK))

fn main(): int32 =
    var keyData: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    benchFillRandom(keyData)
    var nonceBuf: rawbytes.Bytes = rawbytes.BytesAlloc(12)
    benchFillRandom(nonceBuf)
    var tagBuf: rawbytes.Bytes = rawbytes.BytesAlloc(16)
    var aad: rawbytes.Bytes = rawbytes.EmptyBytes()
    var bigBuf: rawbytes.Bytes = rawbytes.BytesAlloc(benchRecordBytes * benchRecordsPerRound)
    benchFillRandom(bigBuf)

    var keyRes: Result[aesgcm.AesGcmKey] = aesgcm.intoAesGcmKey(keyData)
    var key: aesgcm.AesGcmKey = Value(keyRes)
    let t0: int64 = monoNs()
    var r: int32 = 0
    while r < benchRounds:
        let enc: Result[bool] = aesgcm.aesGcmEncryptRaw(key.rounds, key.roundKeys, nonceBuf, tagBuf, bigBuf, aad)
        r = r + 1
    benchReport("AESGCM128_bulk_1MB", monoNs() - t0)

    var gcmData: rawbytes.Bytes = rawbytes.BytesAlloc(benchRecordBytes * benchRecordsPerRound)
    benchFillRandom(gcmData)
    var gcmCopy: rawbytes.Bytes = rawbytes.BytesAlloc(benchRecordBytes * benchRecordsPerRound)
    benchFillRandom(gcmCopy)
    let gcmEnc: Result[bool] = aesgcm.aesGcmEncryptRaw(key.rounds, key.roundKeys, nonceBuf, tagBuf, gcmData, aad)
    if IsErr(gcmEnc):
        benchPrint("ENC_ERR")
        benchPrint(ErrorText(gcmEnc))
    let gcmDec: Result[bool] = aesgcm.aesGcmDecryptRaw(key.rounds, key.roundKeys, nonceBuf, tagBuf, gcmData, aad)
    if IsErr(gcmDec):
        benchPrint("DEC_ERR")
        benchPrint(ErrorText(gcmDec))
    var gcmOk: bool = Value(gcmEnc) && Value(gcmDec)
    var gi: int32 = 0
    while gi < rawbytes.BytesLen(gcmData):
        if BytesGet(gcmData, gi) != BytesGet(gcmCopy, gi):
            gcmOk = false
        gi = gi + 1
    benchPrint("AESGCM128_roundtrip")
    if gcmOk:
        benchPrint("GCM128_ROUNDTRIP_PASS")
    else:
        benchPrint("GCM128_ROUNDTRIP_FAIL")
    rawbytes.BytesFree(gcmData)
    rawbytes.BytesFree(gcmCopy)
    rawbytes.BytesFree(bigBuf)
    rawbytes.BytesFree(keyData)
    rawbytes.BytesFree(nonceBuf)
    rawbytes.BytesFree(tagBuf)
    return 0
