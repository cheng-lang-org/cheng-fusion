import std/strutils as strutil
import std/result
import std/net/transports/win_bool_probe as probe

fn main(): int32 =
    let s: str = probe.ProbeSmallRet("127.0.0.1", 0, false)
    puts(strutil.Join(["xmod small false=", s], ""))

    let r: Result[probe.ProbeBig] = probe.ProbeBigRet("127.0.0.1", 0, false)
    if IsErr(r):
        puts(strutil.Join(["xmod big false ERR=", ErrorText(r)], ""))
    else:
        puts(strutil.Join(["xmod big false ok note=", Value(r).note], ""))

    let r2: Result[probe.ProbeBig] = probe.ProbeNoDefault("127.0.0.1", 0, false)
    if IsErr(r2):
        puts(strutil.Join(["xmod nodefault false ERR=", ErrorText(r2)], ""))
    else:
        puts(strutil.Join(["xmod nodefault false ok note=", Value(r2).note], ""))

    let r3: Result[probe.ProbeBig] = probe.ProbeI32Default("127.0.0.1", 0, 0)
    if IsErr(r3):
        puts(strutil.Join(["xmod i32default 0 ERR=", ErrorText(r3)], ""))
    else:
        puts(strutil.Join(["xmod i32default 0 ok note=", Value(r3).note], ""))
    return 0
