fn R25Fill(dest: var str, code: int32): bool =
    if code == 1:
        dest = "boom"
        return false
    return true

fn R25Core(n: int32): int32 =
    var e = ""
    var i = 0
    var stable = false
    while !stable:
        e = ""
        if !R25Fill(e, i):
            return e.len
        i = i + 1
        if i >= n:
            stable = true
    return 0

fn main(): int32 =
    if R25Core(3) != 4:
        return 10
    echo("x1 ok")
    return 0
