import std/os
import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/backend/system_link_plan as slplan
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/runtime/arena as arenamod
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr

fn ProvenanceWritePackage(root: str, entryText: str) =
    let sourceDir = Fmt"{root}/src"
    os.MkdirAll(sourceDir, 493)
    os.WriteFile(
        Fmt"{root}/cheng-package.toml",
        "package_id = \"pkg://cheng/compiler_csg_parser_provenance\"\n")
    os.WriteFile(Fmt"{sourceDir}/main.cheng", entryText)
    os.WriteFile(
        Fmt"{sourceDir}/helper.cheng",
        "type\n    ManagedForeign =\n        value: str\n\nfn Helper(): int32 =\n    return 7\n\n@borrows\nfn BorrowManaged(value: str, marker: int32): int32 =\n    return marker + 1\n\n@escapes\nfn EscapeForeign(value: str): int32 =\n    return 2\n\nfn EscapeLiteralOwner(): int32 =\n    return EscapeForeign(\"helper-literal\")\n")

fn ProvenanceBuild(root: str,
                   entryText: str,
                   out: var ccsg.CompilerCsg) =
    ProvenanceWritePackage(root, entryText)
    let entryPath = Fmt"{root}/src/main.cheng"
    let baseRequest = creq.CompilerRequestNew(
        root,
        entryPath,
        Fmt"{root}/out.o",
        "arm64-apple-darwin",
        creq.EmitObj,
        "")
    let request = creq.CompilerRequestWithExportRootSymbols(
        baseRequest, ["Root"])
    var plan: slplan.SystemLinkPlanStub
    var err = ""
    assert(slplan.BuildSystemLinkPlanStub(root, request, plan, err), err)
    let sourceBundle = slplan.SystemLinkPlanSourceBundleCid(plan)
    assert(IsOk(sourceBundle),
           " compiler csg parser provenance: source bundle unavailable")
    assert(ccsg.BuildCompilerCsgInto(plan, Value(sourceBundle), out, err), err)
    assert(ccsg.CompilerCsgParserDeclarationProvenanceStrictValidateInto(
               out, err), err)

fn ProvenanceReject(csg: var ccsg.CompilerCsg, label: str) =
    var err = ""
    assert(!ccsg.CompilerCsgParserDeclarationProvenanceStrictValidateInto(
                csg, err),
           Fmt" compiler csg parser provenance: accepted {label}")
    ccsg.CompilerCsgTerminalRelease(csg)

fn ProvenanceTypedIrReject(csg: var ccsg.CompilerCsg, label: str) =
    var err = ""
    assert(!texpr.TypedExprValueDefinitionAuthorityStrictValidateInto(
                csg.typedIr, err),
           Fmt" compiler csg parser provenance: accepted {label}")
    ccsg.CompilerCsgTerminalRelease(csg)

fn ProvenanceManagedTemporaryMutations(root: var str) =
    let text = strutil.Join(
        ["import cheng/compiler_csg_parser_provenance/helper as helper\n\n",
         "type\n",
         "    ManagedInner =\n",
         "        value: str\n\n",
         "fn MakeManaged(): str =\n",
         "    return \"managed\"\n\n",
         "@escapes\n",
         "fn EscapeManaged(value: str): int32 =\n",
         "    return 5\n\n",
         "@escapes\n",
         "fn EscapeInner(value: ManagedInner): int32 =\n",
         "    return 6\n\n",
         "fn Root(): int32 =\n",
         "    let callResult = EscapeManaged(MakeManaged())\n",
         "    let managedTemporary = EscapeManaged(\"literal\")\n",
         "    let constructorResult = EscapeInner(ManagedInner(value: \"constructor\"))\n",
         "    let helperTemporary = helper.EscapeLiteralOwner()\n",
         "    return callResult + managedTemporary + constructorResult + helperTemporary\n"],
        "")
    var csg: ccsg.CompilerCsg
    ProvenanceBuild(root, text, csg)
    let functions = csg.semanticGraph.reachableFunctionTable
    var escapeManagedFunction: int32 = -1
    var escapeInnerFunction: int32 = -1
    var escapeForeignFunction: int32 = -1
    for functionIndex in 0..<functions.functionNames.len:
        if functions.functionNames[functionIndex] ==
               "EscapeManaged":
            escapeManagedFunction = functionIndex
        elif functions.functionNames[functionIndex] ==
                 "EscapeInner":
            escapeInnerFunction = functionIndex
        elif functions.functionNames[functionIndex] ==
                 "EscapeForeign":
            escapeForeignFunction = functionIndex
    assert(escapeManagedFunction >= 0,
           " compiler csg call ownership: managed temporary target missing")
    assert(escapeInnerFunction >= 0,
           " compiler csg call ownership: constructor target missing")
    assert(escapeForeignFunction >= 0,
           " compiler csg call ownership: managed temporary targets missing")
    let calls = csg.semanticGraph.resolvedCallTable
    var callResultEffect: int32 = -1
    var managedTemporaryEffect: int32 = -1
    var constructorEffect: int32 = -1
    var helperTemporaryEffect: int32 = -1
    for callRow in 0..<calls.sourceIndexes.len:
        let effectRow = calls.ownershipEffectStarts[callRow]
        if effectRow < 0:
            continue
        if calls.ownershipEffectCounts[callRow] != 1:
            continue
        if calls.targetFunctionIndexes[callRow] ==
               escapeManagedFunction:
            if calls.ownershipEffectValueDefinitionOriginKinds[
                   effectRow] ==
                   Int32(
                       texpr.TypedExprValueDefinitionOriginCallResult):
                callResultEffect = effectRow
            elif calls.ownershipEffectValueDefinitionOriginKinds[
                     effectRow] ==
                     Int32(
                         texpr.TypedExprValueDefinitionOriginManagedTemporary):
                managedTemporaryEffect = effectRow
        elif calls.targetFunctionIndexes[callRow] ==
                 escapeInnerFunction:
            constructorEffect = effectRow
        elif calls.targetFunctionIndexes[callRow] ==
                 escapeForeignFunction:
            helperTemporaryEffect = effectRow
    assert(callResultEffect >= 0,
           " compiler csg call ownership: call-result effect missing")
    assert(managedTemporaryEffect >= 0,
           " compiler csg call ownership: managed temporary effect missing")
    assert(constructorEffect >= 0,
           " compiler csg call ownership: constructor effect missing")
    assert(helperTemporaryEffect >= 0,
           " compiler csg call ownership: managed temporary effects missing")
    assert(calls.ownershipEffectValueDefinitionOriginKinds[
               callResultEffect] ==
               Int32(texpr.TypedExprValueDefinitionOriginCallResult),
           " compiler csg call ownership: call-result origin missing")
    assert(calls.ownershipEffectValueDefinitionOriginKinds[
               managedTemporaryEffect] ==
               Int32(
                   texpr.TypedExprValueDefinitionOriginManagedTemporary),
           " compiler csg call ownership: managed temporary origin missing")
    assert(calls.ownershipEffectValueDefinitionOriginKinds[
               constructorEffect] ==
               Int32(texpr.TypedExprValueDefinitionOriginCallResult),
           " compiler csg call ownership: constructor origin missing")
    assert(calls.ownershipEffectValueDefinitionOriginKinds[
               helperTemporaryEffect] ==
               Int32(
                   texpr.TypedExprValueDefinitionOriginManagedTemporary),
           " compiler csg call ownership: helper temporary origin missing")
    assert(calls.ownershipEffectValueDefinitionTypedFunctionIndexes[
               managedTemporaryEffect] !=
               calls.ownershipEffectValueDefinitionTypedFunctionIndexes[
                   helperTemporaryEffect],
           " compiler csg call ownership: temporary owner collapsed")
    assert(calls.ownershipEffectValueDefinitionProducerSourceIndexes[
               managedTemporaryEffect] !=
               calls.ownershipEffectValueDefinitionProducerSourceIndexes[
                   helperTemporaryEffect],
           " compiler csg call ownership: temporary source collapsed")
    assert(calls.ownershipEffectValueDefinitionSourceLocalNodeIndexes[
               managedTemporaryEffect] >= 0,
           " compiler csg call ownership: temporary parser node missing")
    assert(calls.ownershipEffectValueDefinitionDeclarationSourceLocalRows[
               managedTemporaryEffect] == -1,
           " compiler csg call ownership: temporary declaration fabricated")
    assert(calls.ownershipEffectValueDefinitionDefiningNodeIndexes[
               managedTemporaryEffect] ==
               calls.ownershipEffectValueNodeIndexes[
                   managedTemporaryEffect],
           " compiler csg call ownership: temporary defining node drift")
    assert(calls.ownershipEffectValueDefinitionRows[
               managedTemporaryEffect] !=
               calls.ownershipEffectValueDefinitionRows[
                   callResultEffect],
           " compiler csg call ownership: temporary row collapsed")
    assert(calls.ownershipEffectValueDefinitionDefiningNodeIndexes[
               managedTemporaryEffect] !=
               calls.ownershipEffectValueDefinitionDefiningNodeIndexes[
                   callResultEffect],
           " compiler csg call ownership: temporary node collapsed")
    assert(calls.ownershipEffectValueDefinitionExactTypeIds[
               managedTemporaryEffect] !=
               calls.ownershipEffectValueDefinitionExactTypeIds[
                   constructorEffect],
           " compiler csg call ownership: temporary type collapsed")
    let helperTemporaryNode =
        calls.ownershipEffectValueDefinitionDefiningNodeIndexes[
            helperTemporaryEffect]
    let temporaryDefiningNode =
        calls.ownershipEffectValueDefinitionDefiningNodeIndexes[
            managedTemporaryEffect]
    let helperTemporaryOwnerStatement =
        texpr.TypedExprIrNodeOwnerStatementIndexAt(
            csg.typedIr, helperTemporaryNode)
    assert(texpr.TypedExprIrNodeOwnerStatementIndexAt(
               csg.typedIr, temporaryDefiningNode) >= 0 &&
           helperTemporaryOwnerStatement >= 0 &&
           texpr.TypedExprIrNodeOwnerStatementIndexAt(
               csg.typedIr, temporaryDefiningNode) !=
               helperTemporaryOwnerStatement,
           " compiler csg call ownership: temporary statement owner collapsed")

    var missingManagedTemporary =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    missingManagedTemporary.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionOriginKinds[
            managedTemporaryEffect] =
            Int32(texpr.TypedExprValueDefinitionOriginInvalid)
    ProvenanceReject(missingManagedTemporary,
                     "missing managed temporary value-definition")

    var exchangedTemporaryDefinitionRows =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    let temporaryDefinitionRow =
        exchangedTemporaryDefinitionRows.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionRows[
                managedTemporaryEffect]
    exchangedTemporaryDefinitionRows.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionRows[
            managedTemporaryEffect] =
            exchangedTemporaryDefinitionRows.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionRows[
                    callResultEffect]
    exchangedTemporaryDefinitionRows.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionRows[
            callResultEffect] =
            temporaryDefinitionRow
    ProvenanceReject(exchangedTemporaryDefinitionRows,
                     "exchanged temporary value-definition rows")

    var exchangedTemporaryOwners =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    let temporaryOwner =
        exchangedTemporaryOwners.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionTypedFunctionIndexes[
                managedTemporaryEffect]
    exchangedTemporaryOwners.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionTypedFunctionIndexes[
            managedTemporaryEffect] =
            exchangedTemporaryOwners.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionTypedFunctionIndexes[
                    helperTemporaryEffect]
    exchangedTemporaryOwners.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionTypedFunctionIndexes[
            helperTemporaryEffect] =
            temporaryOwner
    ProvenanceReject(exchangedTemporaryOwners,
                     "exchanged temporary typed function owners")

    var exchangedTemporaryTypes =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    let temporaryType =
        exchangedTemporaryTypes.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionExactTypeIds[
                managedTemporaryEffect]
    exchangedTemporaryTypes.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionExactTypeIds[
            managedTemporaryEffect] =
            exchangedTemporaryTypes.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionExactTypeIds[
                    constructorEffect]
    exchangedTemporaryTypes.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionExactTypeIds[
            constructorEffect] =
            temporaryType
    ProvenanceReject(exchangedTemporaryTypes,
                     "exchanged temporary exact TypeIds")

    var exchangedTemporarySources =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    let temporarySource =
        exchangedTemporarySources.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionProducerSourceIndexes[
                managedTemporaryEffect]
    exchangedTemporarySources.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionProducerSourceIndexes[
            managedTemporaryEffect] =
            exchangedTemporarySources.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionProducerSourceIndexes[
                    helperTemporaryEffect]
    exchangedTemporarySources.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionProducerSourceIndexes[
            helperTemporaryEffect] =
            temporarySource
    ProvenanceReject(exchangedTemporarySources,
                     "exchanged temporary producer sources")

    var exchangedTemporaryNodes =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    let temporaryNode =
        exchangedTemporaryNodes.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionDefiningNodeIndexes[
                managedTemporaryEffect]
    exchangedTemporaryNodes.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionDefiningNodeIndexes[
            managedTemporaryEffect] =
            exchangedTemporaryNodes.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionDefiningNodeIndexes[
                    callResultEffect]
    exchangedTemporaryNodes.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionDefiningNodeIndexes[
            callResultEffect] =
            temporaryNode
    ProvenanceReject(exchangedTemporaryNodes,
                     "exchanged temporary defining nodes")

    var exchangedCallResultOrigins =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    let temporaryOrigin =
        exchangedCallResultOrigins.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionOriginKinds[
                managedTemporaryEffect]
    exchangedCallResultOrigins.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionOriginKinds[
            managedTemporaryEffect] =
            exchangedCallResultOrigins.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionOriginKinds[
                    callResultEffect]
    exchangedCallResultOrigins.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionOriginKinds[
            callResultEffect] =
            temporaryOrigin
    ProvenanceReject(exchangedCallResultOrigins,
                     "exchanged managed temporary/call-result origins")

    var wrongTemporaryOwnership =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    wrongTemporaryOwnership.semanticGraph.resolvedCallTable.ownershipEffectValueDefinitionOwnerships[
            managedTemporaryEffect] =
            Int32(texpr.TypedExprExprBorrowed)
    ProvenanceReject(wrongTemporaryOwnership,
                     "wrong managed temporary ownership")

    var wrongTemporaryOrigin =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    arenamod.ArenaArrayInt32Set(
        wrongTemporaryOrigin.typedIr.arena,
        wrongTemporaryOrigin.typedIr.valueDefinitions_originKinds,
        temporaryDefinitionRow,
        Int32(texpr.TypedExprValueDefinitionOriginCallResult))
    ProvenanceTypedIrReject(wrongTemporaryOrigin,
                           "wrong managed temporary origin")

    var wrongTemporaryOp =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    wrongTemporaryOp.typedIr.nodes2_opKinds[temporaryNode] =
        texpr.TypedExprIrOpBoolLit
    ProvenanceTypedIrReject(wrongTemporaryOp,
                           "wrong managed temporary producer op")

    var fabricatedTemporaryBinding =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    arenamod.ArenaArrayInt32Set(
        fabricatedTemporaryBinding.typedIr.arena,
        fabricatedTemporaryBinding.typedIr.
            valueDefinitions_declarationSourceLocalRows,
        temporaryDefinitionRow,
        0)
    arenamod.ArenaArrayInt32Set(
        fabricatedTemporaryBinding.typedIr.arena,
        fabricatedTemporaryBinding.typedIr.
            valueDefinitions_patternSourceLocalRows,
        temporaryDefinitionRow,
        0)
    arenamod.ArenaArrayInt32Set(
        fabricatedTemporaryBinding.typedIr.arena,
        fabricatedTemporaryBinding.typedIr.valueDefinitions_groupRows,
        temporaryDefinitionRow,
        0)
    ProvenanceTypedIrReject(
        fabricatedTemporaryBinding,
        "fabricated managed temporary declaration/pattern/group")

    var missingTemporaryStatementOwner =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    arenamod.ArenaArrayInt32Set(
        missingTemporaryStatementOwner.typedIr.arena,
        missingTemporaryStatementOwner.typedIr.
            nodes2_ownerStatementIndexes,
        temporaryDefiningNode,
        -1)
    ProvenanceTypedIrReject(
        missingTemporaryStatementOwner,
        "missing managed temporary statement owner")

    var foreignTemporaryStatementOwner =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    arenamod.ArenaArrayInt32Set(
        foreignTemporaryStatementOwner.typedIr.arena,
        foreignTemporaryStatementOwner.typedIr.
            nodes2_ownerStatementIndexes,
        temporaryDefiningNode,
        helperTemporaryOwnerStatement)
    ProvenanceTypedIrReject(
        foreignTemporaryStatementOwner,
        "foreign managed temporary statement owner")

    ccsg.CompilerCsgTerminalRelease(csg)

fn main(): int32 =
    var root = os.GetEnvDefault(
        "CHENG_CSG_PROVENANCE_WORK",
        "/tmp/compiler-csg-parser-declaration-provenance")
    let firstText = strutil.Join(
        ["import cheng/compiler_csg_parser_provenance/helper as helper\n\n",
         "@importc(\"CAbs\")\n",
         "fn CAbs(value: int32): int32\n\n",
         "fn Resolve(value: int32): int32 =\n",
         "    return value\n\n",
         "fn Resolve(value: str): str =\n",
         "    return value\n\n",
         "type\n",
         "    ManagedInner =\n",
         "        value: str\n",
         "    ManagedOuter =\n",
         "        inner: ManagedInner\n\n",
         "fn MakeManaged(): str =\n",
         "    return \"managed\"\n\n",
         "@borrows\n",
         "fn BorrowManaged(value: str, marker: int32): int32 =\n",
         "    return marker\n\n",
         "fn VarBorrow(value: var str): int32 =\n",
         "    return 3\n\n",
         "@escapes\n",
         "fn EscapeManaged(value: str): int32 =\n",
         "    return 5\n\n",
         "@compiler_top_level(export_name=\"Kept\")\n",
         "@keep_export_binding\n",
         "fn Kept(): int32 =\n",
         "    return 11\n\n",
         "@compiler_top_level(export_name=\"Dropped\")\n",
         "fn Dropped(): int32 =\n",
         "    return 13\n\n",
         "fn Root(): int32 =\n",
         "    let value = helper.Helper()\n",
         "    let managed = MakeManaged()\n",
         "    let outer = ManagedOuter(inner: ManagedInner(value: \"nested\"))\n",
         "    let foreign = helper.ManagedForeign(value: \"foreign\")\n",
         "    let values = [\"indexed\"]\n",
         "    let borrowed = BorrowManaged(managed, 9)\n",
         "    let fieldBorrowed = BorrowManaged(outer.inner.value, 11)\n",
         "    let foreignBorrowed = BorrowManaged(foreign.value, 13)\n",
         "    let indexBorrowed = BorrowManaged(values[0], 12)\n",
         "    let varBorrowed = VarBorrow(managed)\n",
         "    let helperBorrowed = helper.BorrowManaged(managed, 10)\n",
         "    let escaped = EscapeManaged(MakeManaged())\n",
         "    return CAbs(value) + borrowed + fieldBorrowed + foreignBorrowed + indexBorrowed + varBorrowed + helperBorrowed + escaped\n"], "")
    var first: ccsg.CompilerCsg
    ProvenanceBuild(root, firstText, first)

    var resolveRows: int32[]
    var rootRow: int32 = -1
    var helperRow: int32 = -1
    var keptRow: int32 = -1
    var droppedRow: int32 = -1
    var borrowManagedRows: int32[]
    var borrowManagedRow: int32 = -1
    var helperBorrowManagedRow: int32 = -1
    var varBorrowRow: int32 = -1
    var escapeManagedRow: int32 = -1
    let table = first.semanticGraph.reachableFunctionTable
    for functionIndex in 0..<table.functionNames.len:
        if table.functionNames[functionIndex] == "Resolve":
            add(resolveRows, functionIndex)
        elif table.functionNames[functionIndex] == "Root":
            rootRow = functionIndex
        elif table.functionNames[functionIndex] == "Helper":
            helperRow = functionIndex
        elif table.functionNames[functionIndex] == "Kept":
            keptRow = functionIndex
        elif table.functionNames[functionIndex] == "Dropped":
            droppedRow = functionIndex
        elif table.functionNames[functionIndex] == "BorrowManaged":
            add(borrowManagedRows, functionIndex)
        elif table.functionNames[functionIndex] == "VarBorrow":
            varBorrowRow = functionIndex
        elif table.functionNames[functionIndex] == "EscapeManaged":
            escapeManagedRow = functionIndex
    assert(resolveRows.len == 2 && rootRow >= 0 && helperRow >= 0,
           " compiler csg parser provenance: overload/source rows missing")
    for functionIndex in borrowManagedRows:
        if table.producerSourceIndexes[functionIndex] ==
               table.producerSourceIndexes[rootRow]:
            borrowManagedRow = functionIndex
        elif table.producerSourceIndexes[functionIndex] ==
                 table.producerSourceIndexes[helperRow]:
            helperBorrowManagedRow = functionIndex
    assert(keptRow >= 0 && droppedRow >= 0 &&
           borrowManagedRow >= 0 &&
           helperBorrowManagedRow >= 0 &&
           varBorrowRow >= 0 && escapeManagedRow >= 0 &&
           table.reachable[keptRow] &&
           !table.reachable[droppedRow] &&
           !layout.FixedBytes32Equal(
               table.keepExportBindingCids[keptRow],
               layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               table.keepExportBindingCids[droppedRow],
               layout.FixedBytes32()),
           " compiler csg parser provenance: keep-export binding plan not consumed")
    let left = resolveRows[0]
    let right = resolveRows[1]
    assert(table.producerSourceIndexes[left] ==
               table.producerSourceIndexes[right] &&
           table.producerDeclarationIndexes[left] !=
               table.producerDeclarationIndexes[right] &&
           table.graphNodeIds[left] != table.graphNodeIds[right] &&
           !layout.FixedBytes32Equal(
               table.functionNameProofCids[left], layout.FixedBytes32()) &&
           layout.FixedBytes32Equal(
               table.functionNameProofCids[left],
               table.functionNameProofCids[right]),
           " compiler csg parser provenance: overload identity collapsed")
    var duplicateDecl = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    duplicateDecl.semanticGraph.reachableFunctionTable.
        producerDeclarationIndexes[right] =
            duplicateDecl.semanticGraph.reachableFunctionTable.
                producerDeclarationIndexes[left]
    ProvenanceReject(duplicateDecl, "duplicate producer declaration")

    var exchangedGraph = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let leftGraph = exchangedGraph.semanticGraph.reachableFunctionTable.
        graphNodeIds[left]
    exchangedGraph.semanticGraph.reachableFunctionTable.graphNodeIds[left] =
        exchangedGraph.semanticGraph.reachableFunctionTable.graphNodeIds[right]
    exchangedGraph.semanticGraph.reachableFunctionTable.graphNodeIds[right] =
        leftGraph
    ProvenanceReject(exchangedGraph, "exchanged graph nodes")

    var missingProof = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    missingProof.semanticGraph.reachableFunctionTable.
        functionNameProofCids[left] = layout.FixedBytes32()
    ProvenanceReject(missingProof, "zero name proof")

    var exchangedParser = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let producerSource = table.producerSourceIndexes[left]
    var leftSidecarRow: int32 = -1
    var rightSidecarRow: int32 = -1
    var keptSidecarRow: int32 = -1
    var droppedSidecarRow: int32 = -1
    let sidecar = exchangedParser.parserNormalizedExprReceipt.
        sourceSidecars[producerSource]
    for sidecarRow in 0..<sidecar.functionIndexes.len:
        if sidecar.functionIndexes[sidecarRow] == left:
            leftSidecarRow = sidecarRow
        elif sidecar.functionIndexes[sidecarRow] == right:
            rightSidecarRow = sidecarRow
        elif sidecar.functionIndexes[sidecarRow] == keptRow:
            keptSidecarRow = sidecarRow
        elif sidecar.functionIndexes[sidecarRow] == droppedRow:
            droppedSidecarRow = sidecarRow
    assert(leftSidecarRow >= 0 && rightSidecarRow >= 0 &&
           keptSidecarRow >= 0 && droppedSidecarRow >= 0 &&
           (sidecar.functionAnnotationFlags[keptSidecarRow] &
                parser.ParserFunctionAnnotationKeepExportBinding) != 0 &&
           sidecar.functionAnnotationFlags[droppedSidecarRow] == 0,
           " compiler csg parser provenance: overload sidecar rows missing")
    exchangedParser.parserNormalizedExprReceipt.sourceSidecars[
        producerSource].functionIndexes[leftSidecarRow] = right
    exchangedParser.parserNormalizedExprReceipt.sourceSidecars[
        producerSource].functionIndexes[rightSidecarRow] = left
    ProvenanceReject(exchangedParser, "exchanged parser function rows")

    var missingFunctionRow =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    missingFunctionRow.parserNormalizedExprReceipt.sourceSidecars[
        producerSource].functionIndexes[keptSidecarRow] = -1
    ProvenanceReject(missingFunctionRow,
                     "missing keep-export Function row")

    var missingDeclarationHeader =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    missingDeclarationHeader.semanticGraph.reachableFunctionTable.
        functionDeclarationHeaderCids[keptRow] =
            layout.FixedBytes32()
    ProvenanceReject(missingDeclarationHeader,
                     "missing keep-export declaration header CID")

    var exchangedDeclarationPaths =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let leftDeclarationPath =
        exchangedDeclarationPaths.semanticGraph.reachableFunctionTable.
            functionDeclarationPathCids[left]
    exchangedDeclarationPaths.semanticGraph.reachableFunctionTable.
        functionDeclarationPathCids[left] =
            exchangedDeclarationPaths.semanticGraph.reachableFunctionTable.
                functionDeclarationPathCids[right]
    exchangedDeclarationPaths.semanticGraph.reachableFunctionTable.
        functionDeclarationPathCids[right] = leftDeclarationPath
    ProvenanceReject(exchangedDeclarationPaths,
                     "exchanged declaration path CIDs")

    var missingKeepExportCid =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    missingKeepExportCid.semanticGraph.reachableFunctionTable.
        keepExportBindingCids[keptRow] = layout.FixedBytes32()
    ProvenanceReject(missingKeepExportCid,
                     "missing keep-export CID")

    var exchangedKeepExportCids =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let keptBindingCid =
        exchangedKeepExportCids.semanticGraph.reachableFunctionTable.
            keepExportBindingCids[keptRow]
    exchangedKeepExportCids.semanticGraph.reachableFunctionTable.
        keepExportBindingCids[keptRow] =
            exchangedKeepExportCids.semanticGraph.reachableFunctionTable.
                keepExportBindingCids[droppedRow]
    exchangedKeepExportCids.semanticGraph.reachableFunctionTable.
        keepExportBindingCids[droppedRow] = keptBindingCid
    ProvenanceReject(exchangedKeepExportCids,
                     "exchanged keep-export CIDs")

    var missingKeepExportFlag =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    missingKeepExportFlag.semanticGraph.reachableFunctionTable.
        functionAnnotationFlags[keptRow] = 0
    ProvenanceReject(missingKeepExportFlag,
                     "missing keep-export annotation flag")

    var exchangedKeepExportFlags =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    exchangedKeepExportFlags.semanticGraph.reachableFunctionTable.
        functionAnnotationFlags[keptRow] = 0
    exchangedKeepExportFlags.semanticGraph.reachableFunctionTable.
        functionAnnotationFlags[droppedRow] =
            parser.ParserFunctionAnnotationKeepExportBinding
    ProvenanceReject(exchangedKeepExportFlags,
                     "exchanged keep-export annotation flags")

    var missingExportBinding =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let keptGraphNodeId =
        missingExportBinding.semanticGraph.reachableFunctionTable.
            graphNodeIds[keptRow]
    var removedExportBinding = false
    for nodeIndex in 0..<missingExportBinding.nodes.len:
        if missingExportBinding.nodes[nodeIndex].nodeId !=
               keptGraphNodeId:
            continue
        missingExportBinding.nodes[nodeIndex].exportNameExplicit = 0
        removedExportBinding = true
        break
    assert(removedExportBinding,
           " compiler csg parser provenance: keep-export graph node missing")
    ProvenanceReject(missingExportBinding,
                     "missing keep-export target binding")

    var wrongSourceMap = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongSourceMap.semanticGraph.reachableFunctionTable.sourceIndex[rootRow] =
        wrongSourceMap.semanticGraph.reachableFunctionTable.sourceIndex[
            helperRow]
    ProvenanceReject(wrongSourceMap, "producer/canonical source remap")

    var wrongCallProducer = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    var callFunctionRow: int32 = -1
    let callKindCount =
        wrongCallProducer.typedIr.buildIndex.callDeclarationKinds.len
    for rowIndex in 0..<callKindCount:
        if wrongCallProducer.typedIr.buildIndex.callDeclarationKinds[
               rowIndex] ==
               texpr.TypedExprCallDeclarationFunction:
            callFunctionRow = rowIndex
            break
    assert(callFunctionRow >= 0 &&
           wrongCallProducer.parserNormalizedExprReceipt.sourceSidecars.len > 1,
           " compiler csg parser provenance: call producer row missing")
    wrongCallProducer.typedIr.buildIndex.callDeclarationProducerSourceIndexes[
        callFunctionRow] =
        (wrongCallProducer.typedIr.buildIndex.callDeclarationProducerSourceIndexes[
             callFunctionRow] + 1) %
            wrongCallProducer.parserNormalizedExprReceipt.sourceSidecars.len
    ProvenanceReject(wrongCallProducer, "call declaration producer source")

    var wrongCallDeclarationOrdinal =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongCallDeclarationOrdinal.typedIr.buildIndex.callDeclarationProducerDeclarationOrdinals[
        callFunctionRow] =
        wrongCallDeclarationOrdinal.parserNormalizedExprReceipt.sourceSidecars[
            wrongCallDeclarationOrdinal.typedIr.buildIndex.callDeclarationProducerSourceIndexes[
                callFunctionRow]].declarationKinds.len
    ProvenanceReject(wrongCallDeclarationOrdinal,
                     "call declaration producer declaration ordinal")

    var wrongCallFunctionRow =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongCallFunctionRow.typedIr.buildIndex.callDeclarationProducerFunctionRows[
        callFunctionRow] =
        wrongCallFunctionRow.parserNormalizedExprReceipt.sourceSidecars[
            wrongCallFunctionRow.typedIr.buildIndex.callDeclarationProducerSourceIndexes[
                callFunctionRow]].functionIndexes.len
    ProvenanceReject(wrongCallFunctionRow,
                     "call declaration producer Function row")

    var importcCallRow: int32 = -1
    var sameSourceFunctionRow: int32 = -1
    let exactCallCount =
        first.typedIr.buildIndex.callDeclarationKinds.len
    for rowIndex in 0..<exactCallCount:
        if first.typedIr.buildIndex.callDeclarationKinds[rowIndex] ==
               texpr.TypedExprCallDeclarationImportc:
            importcCallRow = rowIndex
            break
    assert(importcCallRow >= 0 &&
           first.typedIr.buildIndex.callDeclarationProducerDeclarationOrdinals[
               importcCallRow] >= 0 &&
           first.typedIr.buildIndex.callDeclarationProducerFunctionRows[
               importcCallRow] == -1,
           " compiler csg parser provenance: importc producer ordinal missing")
    for rowIndex in 0..<exactCallCount:
        if first.typedIr.buildIndex.callDeclarationKinds[rowIndex] ==
               texpr.TypedExprCallDeclarationFunction &&
           first.typedIr.buildIndex.callDeclarationProducerSourceIndexes[
               rowIndex] ==
               first.typedIr.buildIndex.callDeclarationProducerSourceIndexes[
                   importcCallRow]:
            sameSourceFunctionRow = rowIndex
            break
    assert(sameSourceFunctionRow >= 0,
           " compiler csg parser provenance: same-source function missing")
    var wrongImportcOrdinal = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongImportcOrdinal.typedIr.buildIndex.callDeclarationProducerDeclarationOrdinals[
        importcCallRow] =
        wrongImportcOrdinal.typedIr.buildIndex.callDeclarationProducerDeclarationOrdinals[
            sameSourceFunctionRow]
    ProvenanceReject(wrongImportcOrdinal,
                     "importc executable-subset declaration ordinal")

    assert(first.semanticGraph.resolvedCallTable.sourceIndexes.len > 0,
           " compiler csg parser provenance: resolved-call target missing")
    var wrongResolvedTarget = ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongResolvedTarget.semanticGraph.resolvedCallTable.
        targetParserSourceLocalDeclarationRows[0] =
            wrongResolvedTarget.semanticGraph.resolvedCallTable.
                targetParserSourceLocalDeclarationRows[0] + 1
    ProvenanceReject(wrongResolvedTarget,
                     "resolved-call parser source-local declaration row")

    let ownershipCalls = first.semanticGraph.resolvedCallTable
    var localBorrowCallRows: int32[]
    var borrowCallRow: int32 = -1
    var fieldBorrowCallRow: int32 = -1
    var foreignFieldBorrowCallRow: int32 = -1
    var indexBorrowCallRow: int32 = -1
    var helperBorrowCallRow: int32 = -1
    var varBorrowCallRow: int32 = -1
    var escapeCallRow: int32 = -1
    for callRow in 0..<ownershipCalls.sourceIndexes.len:
        if ownershipCalls.targetFunctionIndexes[callRow] ==
               borrowManagedRow:
            add(localBorrowCallRows, callRow)
        elif ownershipCalls.targetFunctionIndexes[callRow] ==
                 helperBorrowManagedRow:
            helperBorrowCallRow = callRow
        elif ownershipCalls.targetFunctionIndexes[callRow] ==
                 varBorrowRow:
            varBorrowCallRow = callRow
        elif ownershipCalls.targetFunctionIndexes[callRow] ==
                 escapeManagedRow:
            escapeCallRow = callRow
    for callRow in localBorrowCallRows:
        let effectRow =
            ownershipCalls.ownershipEffectStarts[callRow]
        let projectionCount =
            ownershipCalls.ownershipProjection.effectCounts[
                effectRow]
        if projectionCount == 0:
            borrowCallRow = callRow
        elif projectionCount == 2:
            fieldBorrowCallRow = callRow
        elif projectionCount == 1:
            let projectionStart =
                ownershipCalls.ownershipProjection.effectStarts[
                    effectRow]
            if ownershipCalls.ownershipProjection.hopOpKinds[
                   projectionStart] ==
                   Int32(texpr.TypedExprIrOpIndexGet):
                indexBorrowCallRow = callRow
            elif ownershipCalls.ownershipProjection.hopFieldProducerSourceIndexes[
                     projectionStart] !=
                 ownershipCalls.ownershipProjection.hopOwnerProducerSourceIndexes[
                     projectionStart]:
                foreignFieldBorrowCallRow = callRow
    assert(borrowCallRow >= 0 && fieldBorrowCallRow >= 0 &&
           foreignFieldBorrowCallRow >= 0 &&
           indexBorrowCallRow >= 0 && helperBorrowCallRow >= 0 &&
           varBorrowCallRow >= 0 && escapeCallRow >= 0,
           " compiler csg call ownership: annotated calls missing")
    let borrowEffect =
        ownershipCalls.ownershipEffectStarts[borrowCallRow]
    let escapeEffect =
        ownershipCalls.ownershipEffectStarts[escapeCallRow]
    let varBorrowEffect =
        ownershipCalls.ownershipEffectStarts[varBorrowCallRow]
    let fieldBorrowEffect =
        ownershipCalls.ownershipEffectStarts[fieldBorrowCallRow]
    let indexBorrowEffect =
        ownershipCalls.ownershipEffectStarts[indexBorrowCallRow]
    let foreignFieldBorrowEffect =
        ownershipCalls.ownershipEffectStarts[
            foreignFieldBorrowCallRow]
    assert(ownershipCalls.callArgCounts[borrowCallRow] == 2 &&
           ownershipCalls.ownershipEffectCounts[borrowCallRow] == 1 &&
           ownershipCalls.ownershipEffectCounts[varBorrowCallRow] == 1 &&
           ownershipCalls.ownershipEffectCounts[fieldBorrowCallRow] == 1 &&
           ownershipCalls.ownershipEffectCounts[indexBorrowCallRow] == 1 &&
           ownershipCalls.ownershipEffectCounts[escapeCallRow] == 1 &&
           borrowEffect >= 0 && escapeEffect >= 0 &&
           ownershipCalls.ownershipEffectValueNodeOwnerships[
               borrowEffect] ==
               Int32(texpr.TypedExprExprBorrowed) &&
           ownershipCalls.ownershipEffectValueDefinitionOwnerships[
               borrowEffect] ==
               Int32(texpr.TypedExprExprOwned) &&
           ownershipCalls.ownershipEffectValueNodeOwnerships[
               escapeEffect] ==
               Int32(texpr.TypedExprExprOwned) &&
           ownershipCalls.ownershipEffectValueDefinitionOwnerships[
               escapeEffect] ==
               Int32(texpr.TypedExprExprOwned) &&
           ownershipCalls.ownershipEffectKinds[borrowEffect] ==
               ccsg.CompilerCsgCallOwnershipEffectBorrow &&
           ownershipCalls.ownershipEffectKinds[varBorrowEffect] ==
               ccsg.CompilerCsgCallOwnershipEffectBorrow &&
           ownershipCalls.ownershipProjection.effectCounts[
               fieldBorrowEffect] == 2 &&
           ownershipCalls.ownershipProjection.effectCounts[
               indexBorrowEffect] == 1 &&
           ownershipCalls.ownershipEffectKinds[escapeEffect] ==
               ccsg.CompilerCsgCallOwnershipEffectEscape,
           " compiler csg call ownership: view/definition or unmanaged filtering drift")
    let borrowArgumentStart =
        ownershipCalls.callArgumentStarts[borrowCallRow]
    let varBorrowArgument =
        ownershipCalls.callArgumentStarts[varBorrowCallRow]
    assert(ownershipCalls.callArgumentBindingIds.len > 0 &&
           ownershipCalls.callArgumentTargetParameterMutableFlags[
               varBorrowArgument] &&
           !ownershipCalls.callArgumentTargetParameterMutableFlags[
               borrowArgumentStart] &&
           ownershipCalls.ownershipEffectCallArgumentRows[
               varBorrowEffect] == varBorrowArgument,
           " compiler csg call ownership: exact var parameter binding missing")
    let fieldHopStart =
        ownershipCalls.ownershipProjection.effectStarts[
            fieldBorrowEffect]
    let indexHopStart =
        ownershipCalls.ownershipProjection.effectStarts[
            indexBorrowEffect]
    let foreignFieldHop =
        ownershipCalls.ownershipProjection.effectStarts[
            foreignFieldBorrowEffect]
    assert(ownershipCalls.ownershipProjection.hopOpKinds[
               fieldHopStart] ==
               Int32(texpr.TypedExprIrOpFieldGet) &&
           ownershipCalls.ownershipProjection.hopOpKinds[
               fieldHopStart + 1] ==
               Int32(texpr.TypedExprIrOpFieldGet) &&
           ownershipCalls.ownershipProjection.hopOpKinds[
               indexHopStart] ==
               Int32(texpr.TypedExprIrOpIndexGet) &&
           ownershipCalls.ownershipProjection.hopIndexNodeIndexes[
               indexHopStart] >= 0 &&
           ownershipCalls.ownershipProjection.hopFieldProducerSourceIndexes[
               foreignFieldHop] !=
               ownershipCalls.ownershipProjection.hopOwnerProducerSourceIndexes[
                   foreignFieldHop],
           " compiler csg call ownership: FieldGet/IndexGet exact projection missing")

    var exchangedParameterRows =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let firstParameterRow =
        exchangedParameterRows.semanticGraph.resolvedCallTable.
            callArgumentTargetParameterDeclarationRows[
                borrowArgumentStart]
    exchangedParameterRows.semanticGraph.resolvedCallTable.
        callArgumentTargetParameterDeclarationRows[
            borrowArgumentStart] =
            exchangedParameterRows.semanticGraph.resolvedCallTable.
                callArgumentTargetParameterDeclarationRows[
                    borrowArgumentStart + 1]
    exchangedParameterRows.semanticGraph.resolvedCallTable.
        callArgumentTargetParameterDeclarationRows[
            borrowArgumentStart + 1] = firstParameterRow
    ProvenanceReject(exchangedParameterRows,
                     "exchanged exact target parameter rows")

    var flippedParameterMutable =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    flippedParameterMutable.semanticGraph.resolvedCallTable.
        callArgumentTargetParameterMutableFlags[
            varBorrowArgument] = false
    ProvenanceReject(flippedParameterMutable,
                     "flipped exact parameter mutable flag")

    var exchangedArgumentOrdinals =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let firstArgumentOrdinal =
        exchangedArgumentOrdinals.semanticGraph.resolvedCallTable.
            callArgumentOrdinals[borrowArgumentStart]
    exchangedArgumentOrdinals.semanticGraph.resolvedCallTable.
        callArgumentOrdinals[borrowArgumentStart] =
            exchangedArgumentOrdinals.semanticGraph.resolvedCallTable.
                callArgumentOrdinals[borrowArgumentStart + 1]
    exchangedArgumentOrdinals.semanticGraph.resolvedCallTable.
        callArgumentOrdinals[borrowArgumentStart + 1] =
            firstArgumentOrdinal
    ProvenanceReject(exchangedArgumentOrdinals,
                     "exchanged call argument ordinals")

    var exchangedArgLinks =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let firstArgLink =
        exchangedArgLinks.semanticGraph.resolvedCallTable.
            callArgumentArgLinkNodeIndexes[borrowArgumentStart]
    exchangedArgLinks.semanticGraph.resolvedCallTable.
        callArgumentArgLinkNodeIndexes[borrowArgumentStart] =
            exchangedArgLinks.semanticGraph.resolvedCallTable.
                callArgumentArgLinkNodeIndexes[
                    borrowArgumentStart + 1]
    exchangedArgLinks.semanticGraph.resolvedCallTable.
        callArgumentArgLinkNodeIndexes[borrowArgumentStart + 1] =
            firstArgLink
    ProvenanceReject(exchangedArgLinks,
                     "exchanged call argument ArgLink rows")

    var exchangedSameNameCrossModuleTarget =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let localBorrowTarget =
        exchangedSameNameCrossModuleTarget.semanticGraph.
            resolvedCallTable.targetFunctionIndexes[borrowCallRow]
    exchangedSameNameCrossModuleTarget.semanticGraph.resolvedCallTable.
        targetFunctionIndexes[borrowCallRow] =
            exchangedSameNameCrossModuleTarget.semanticGraph.
                resolvedCallTable.targetFunctionIndexes[
                    helperBorrowCallRow]
    exchangedSameNameCrossModuleTarget.semanticGraph.resolvedCallTable.
        targetFunctionIndexes[helperBorrowCallRow] =
            localBorrowTarget
    ProvenanceReject(exchangedSameNameCrossModuleTarget,
                     "same-name cross-module target swap")

    var exchangedProjectionRoots =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let fieldRootDefinition =
        exchangedProjectionRoots.semanticGraph.resolvedCallTable.
            ownershipEffectValueDefinitionRows[fieldBorrowEffect]
    exchangedProjectionRoots.semanticGraph.resolvedCallTable.
        ownershipEffectValueDefinitionRows[fieldBorrowEffect] =
            exchangedProjectionRoots.semanticGraph.resolvedCallTable.
                ownershipEffectValueDefinitionRows[indexBorrowEffect]
    exchangedProjectionRoots.semanticGraph.resolvedCallTable.
        ownershipEffectValueDefinitionRows[indexBorrowEffect] =
            fieldRootDefinition
    ProvenanceReject(exchangedProjectionRoots,
                     "exchanged projection root value-definitions")

    var deletedIntermediateProjectionHop =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    deletedIntermediateProjectionHop.semanticGraph.resolvedCallTable.
        ownershipProjection.effectCounts[fieldBorrowEffect] = 1
    ProvenanceReject(deletedIntermediateProjectionHop,
                     "deleted intermediate projection hop")

    var exchangedIntermediateProjectionHops =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let firstProjectionNode =
        exchangedIntermediateProjectionHops.semanticGraph.
            resolvedCallTable.ownershipProjection.
                hopNodeIndexes[fieldHopStart]
    exchangedIntermediateProjectionHops.semanticGraph.resolvedCallTable.
        ownershipProjection.hopNodeIndexes[fieldHopStart] =
            exchangedIntermediateProjectionHops.semanticGraph.
                resolvedCallTable.ownershipProjection.
                    hopNodeIndexes[fieldHopStart + 1]
    exchangedIntermediateProjectionHops.semanticGraph.resolvedCallTable.
        ownershipProjection.hopNodeIndexes[fieldHopStart + 1] =
            firstProjectionNode
    ProvenanceReject(exchangedIntermediateProjectionHops,
                     "exchanged intermediate projection hops")

    var exchangedProjectionOperand0 =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let firstProjectionOperand0 =
        exchangedProjectionOperand0.semanticGraph.resolvedCallTable.
            ownershipProjection.hopOperand0NodeIndexes[
                fieldHopStart]
    exchangedProjectionOperand0.semanticGraph.resolvedCallTable.
        ownershipProjection.hopOperand0NodeIndexes[fieldHopStart] =
            exchangedProjectionOperand0.semanticGraph.resolvedCallTable.
                ownershipProjection.hopOperand0NodeIndexes[
                    fieldHopStart + 1]
    exchangedProjectionOperand0.semanticGraph.resolvedCallTable.
        ownershipProjection.hopOperand0NodeIndexes[
            fieldHopStart + 1] = firstProjectionOperand0
    ProvenanceReject(exchangedProjectionOperand0,
                     "exchanged projection operand0 edges")

    var exchangedProjectionTypes =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let firstProjectionType =
        exchangedProjectionTypes.semanticGraph.resolvedCallTable.
            ownershipProjection.hopExactTypeIds[fieldHopStart]
    exchangedProjectionTypes.semanticGraph.resolvedCallTable.
        ownershipProjection.hopExactTypeIds[fieldHopStart] =
            exchangedProjectionTypes.semanticGraph.resolvedCallTable.
                ownershipProjection.hopExactTypeIds[
                    fieldHopStart + 1]
    exchangedProjectionTypes.semanticGraph.resolvedCallTable.
        ownershipProjection.hopExactTypeIds[fieldHopStart + 1] =
            firstProjectionType
    ProvenanceReject(exchangedProjectionTypes,
                     "exchanged projection exact TypeIds")

    var exchangedProjectionOwners =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let projectionFunctionOwner =
        exchangedProjectionOwners.semanticGraph.resolvedCallTable.
            ownershipProjection.
                hopOwnerDeclarationSourceLocalRows[
                    foreignFieldHop]
    exchangedProjectionOwners.semanticGraph.resolvedCallTable.
        ownershipProjection.hopOwnerDeclarationSourceLocalRows[
            foreignFieldHop] =
            exchangedProjectionOwners.semanticGraph.resolvedCallTable.
                ownershipProjection.
                    hopFieldOwnerDeclarationSourceLocalRows[
                        foreignFieldHop]
    exchangedProjectionOwners.semanticGraph.resolvedCallTable.
        ownershipProjection.
            hopFieldOwnerDeclarationSourceLocalRows[
                foreignFieldHop] = projectionFunctionOwner
    ProvenanceReject(exchangedProjectionOwners,
                     "exchanged projection owner identities")

    var exchangedProjectionSources =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let projectionCallerSource =
        exchangedProjectionSources.semanticGraph.resolvedCallTable.
            ownershipProjection.hopOwnerProducerSourceIndexes[
                foreignFieldHop]
    exchangedProjectionSources.semanticGraph.resolvedCallTable.
        ownershipProjection.hopOwnerProducerSourceIndexes[
            foreignFieldHop] =
            exchangedProjectionSources.semanticGraph.resolvedCallTable.
                ownershipProjection.hopFieldProducerSourceIndexes[
                    foreignFieldHop]
    exchangedProjectionSources.semanticGraph.resolvedCallTable.
        ownershipProjection.hopFieldProducerSourceIndexes[
            foreignFieldHop] = projectionCallerSource
    ProvenanceReject(exchangedProjectionSources,
                     "exchanged projection producer sources")

    var deletedOwnershipEffect =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    setLen(deletedOwnershipEffect.semanticGraph.resolvedCallTable.
               ownershipEffectCids,
           deletedOwnershipEffect.semanticGraph.resolvedCallTable.
               ownershipEffectCids.len - 1)
    ProvenanceReject(deletedOwnershipEffect,
                     "deleted call ownership effect")

    var exchangedViewOwnership =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let borrowViewOwnership =
        exchangedViewOwnership.semanticGraph.resolvedCallTable.
            ownershipEffectValueNodeOwnerships[borrowEffect]
    exchangedViewOwnership.semanticGraph.resolvedCallTable.
            ownershipEffectValueNodeOwnerships[borrowEffect] =
            exchangedViewOwnership.semanticGraph.resolvedCallTable.
                ownershipEffectValueNodeOwnerships[escapeEffect]
    exchangedViewOwnership.semanticGraph.resolvedCallTable.
        ownershipEffectValueNodeOwnerships[escapeEffect] =
            borrowViewOwnership
    ProvenanceReject(exchangedViewOwnership,
                     "exchanged argument-view ownership")

    var wrongDefinitionOwnership =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    wrongDefinitionOwnership.semanticGraph.resolvedCallTable.
        ownershipEffectValueDefinitionOwnerships[borrowEffect] =
            Int32(texpr.TypedExprExprBorrowed)
    ProvenanceReject(wrongDefinitionOwnership,
                     "wrong value-definition ownership")

    var definitionBoundary =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    definitionBoundary.semanticGraph.resolvedCallTable.
        ownershipEffectValueDefinitionRows[borrowEffect] =
            texpr.TypedExprValueDefinitionAuthorityCount(
                definitionBoundary.typedIr)
    ProvenanceReject(definitionBoundary,
                     "value-definition row boundary")

    var missingCallEffectCount =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    missingCallEffectCount.semanticGraph.resolvedCallTable.
        ownershipEffectCounts[borrowCallRow] = 0
    ProvenanceReject(missingCallEffectCount,
                     "missing call ownership effect count")

    var exchangedEffectKinds =
        ccsg.CompilerCsgDeepCloneDiagnostic(first)
    let borrowEffectKind =
        exchangedEffectKinds.semanticGraph.resolvedCallTable.
            ownershipEffectKinds[borrowEffect]
    exchangedEffectKinds.semanticGraph.resolvedCallTable.
            ownershipEffectKinds[borrowEffect] =
            exchangedEffectKinds.semanticGraph.resolvedCallTable.
                ownershipEffectKinds[escapeEffect]
    exchangedEffectKinds.semanticGraph.resolvedCallTable.
        ownershipEffectKinds[escapeEffect] = borrowEffectKind
    ProvenanceReject(exchangedEffectKinds,
                     "exchanged call ownership effect kinds")

    let firstLeftDeclaration = table.producerDeclarationIndexes[left]
    let firstRightDeclaration = table.producerDeclarationIndexes[right]
    let firstLeftProof = table.functionNameProofCids[left]
    let firstRightProof = table.functionNameProofCids[right]
    let secondText = strutil.Join(
        ["import cheng/compiler_csg_parser_provenance/helper as helper\n\n\n",
         "@importc(\"CAbs\")\n",
         "fn CAbs(value: int32): int32\n\n",
         "fn Resolve(value: int32): int32 =\n",
         "    return value + 0\n\n\n",
         "fn Resolve(value: str): str =\n",
         "    return value\n\n",
         "fn Root(): int32 =\n",
         "    let value = helper.Helper()\n",
         "    return CAbs(value)\n"], "")
    var second: ccsg.CompilerCsg
    ProvenanceBuild(root, secondText, second)
    var stableProofCount: int32
    let secondTable = second.semanticGraph.reachableFunctionTable
    for functionIndex in 0..<secondTable.functionNames.len:
        if secondTable.functionNames[functionIndex] != "Resolve":
            continue
        let declarationIndex =
            secondTable.producerDeclarationIndexes[functionIndex]
        if declarationIndex == firstLeftDeclaration &&
           layout.FixedBytes32Equal(
               secondTable.functionNameProofCids[functionIndex],
               firstLeftProof):
            stableProofCount = stableProofCount + 1
        elif declarationIndex == firstRightDeclaration &&
             layout.FixedBytes32Equal(
                 secondTable.functionNameProofCids[functionIndex],
                 firstRightProof):
            stableProofCount = stableProofCount + 1
    assert(stableProofCount == 2,
           " compiler csg parser provenance: body/line movement changed name proof")

    ProvenanceManagedTemporaryMutations(root)
    ccsg.CompilerCsgTerminalRelease(first)
    ccsg.CompilerCsgTerminalRelease(second)
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_parser_provenance_overloads=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_parser_provenance_tamper=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_parser_provenance_source_mapping=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_parser_provenance_call_producer_tamper=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_parser_provenance_call_declaration_ordinal_tamper=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_parser_provenance_importc_ordinal_tamper=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_parser_provenance_resolved_target_tamper=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_parser_provenance_name_proof_stable=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_keep_export_binding_behavior=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_keep_export_binding_identity_mutations=9")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_call_ownership_behavior=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_call_ownership_identity_mutations=31")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_call_ownership_unclosed_red_count=1")
    return 0
