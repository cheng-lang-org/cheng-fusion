import cheng/core/ir/core_types as ir
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/lang/parser as parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout
import cheng/core/backend/regalloc_aarch64_adapter as rega64

fn bindExactTypeArena(body: var ir.BodyIR) =
    let source = "type Backend2CanonicalScalar = int32\n"
    var tree: parser.ParserValueExprTree
    var authority: typearena.TypedExprTypeResolutionAuthority
    var arena: typearena.TypedExprTypeArena
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err) &&
           typearena.TypedExprTypeResolutionAuthorityBuildSameSourceInto(
               tree, authority, err) &&
           typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err) &&
           typearena.TypedExprTypeArenaComplete(arena) &&
           typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           "regalloc data reloc exact TypeArena fixture")
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, arena.artifactRaw32),
           "regalloc data reloc TypeArena bind")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)

fn makeSlot(id: int32,
            typeKind: int32,
            sizeBytes: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "v"
    slot.typeKind = typeKind
    slot.stackOffset = 16 + id * 32
    slot.sizeBytes = sizeBytes
    slot.alignBytes = sizeBytes >= 8 ? 8 : 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makeGlobalSlot(id: int32,
                  name: str,
                  typeKind: int32,
                  sizeBytes: int32): ir.LocalSlot =
    var slot = makeSlot(id, typeKind, sizeBytes)
    slot.name = name
    slot.placeKind = ir.BodyPlaceGlobalAddressTag
    return slot

fn makeParamSlot(id: int32,
                 paramIndex: int32,
                 typeKind: int32,
                 sizeBytes: int32): ir.LocalSlot =
    var slot = makeSlot(id, typeKind, sizeBytes)
    slot.stackOffset = 0 - 1 - paramIndex
    return slot

fn appendI32Return(body: var ir.BodyIR, slotIndex: int32): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, ir.LocalI32Tag)
    return ir.BodyIRAppendTerm(body, term)

fn appendVoidReturn(body: var ir.BodyIR): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    return ir.BodyIRAppendTerm(body, term)

fn buildScalarGlobalBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    bindExactTypeArena(body)
    add(body.localSlots,
        makeGlobalSlot(0, "source/path::raw_scalar",
                       ir.LocalI32Tag, 4))
    add(body.localSlots, makeParamSlot(1, 0, ir.LocalI32Tag, 4))
    add(body.localSlots, makeSlot(2, ir.LocalI32Tag, 4))
    add(body.localSlots, makeSlot(3, ir.LocalI32Tag, 4))
    var store: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(store)
    store.kind = ir.BodyOpGlobalStoreTag
    store.target = 1
    add(store.operands, 0)
    add(body.ops, store)
    var liveLoad: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(liveLoad)
    liveLoad.kind = ir.BodyOpGlobalLoadTag
    liveLoad.target = 2
    add(liveLoad.operands, 0)
    add(body.ops, liveLoad)
    var deadLoad: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(deadLoad)
    deadLoad.kind = ir.BodyOpGlobalLoadTag
    deadLoad.target = 3
    add(deadLoad.operands, 0)
    add(body.ops, deadLoad)
    let termIndex = appendI32Return(body, 2)
    let _ = ir.BodyIRAppendBlock(body, 0, 3, termIndex)
    return body

fn appendFieldStore(body: var ir.BodyIR,
                    baseSlot: int32,
                    valueSlot: int32,
                    byteOffset: int32) =
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpFieldStoreTag
    op.target = baseSlot
    add(op.operands, baseSlot)
    add(op.operands, valueSlot)
    add(op.operands, byteOffset)
    add(op.operands, 4)
    add(body.ops, op)

fn appendFieldLoad(body: var ir.BodyIR,
                   baseSlot: int32,
                   targetSlot: int32,
                   byteOffset: int32) =
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpFieldLoadTag
    op.target = targetSlot
    add(op.operands, baseSlot)
    add(op.operands, targetSlot)
    add(op.operands, byteOffset)
    add(op.operands, 4)
    add(body.ops, op)

fn appendIndexedStore(body: var ir.BodyIR,
                      baseSlot: int32,
                      valueSlot: int32,
                      indexSlot: int32) =
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpIndexedStoreTag
    op.target = baseSlot
    add(op.operands, baseSlot)
    add(op.operands, valueSlot)
    add(op.operands, indexSlot)
    add(op.operands, 4)
    add(body.ops, op)

fn appendIndexedLoad(body: var ir.BodyIR,
                     baseSlot: int32,
                     targetSlot: int32,
                     indexSlot: int32) =
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpIndexedLoadTag
    op.target = targetSlot
    add(op.operands, baseSlot)
    add(op.operands, targetSlot)
    add(op.operands, indexSlot)
    add(op.operands, 4)
    add(body.ops, op)

fn buildAggregateGlobalBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    bindExactTypeArena(body)
    add(body.localSlots,
        makeGlobalSlot(0, "source/path::raw_aggregate",
                       ir.LocalAggregateTag, 24))
    add(body.localSlots, makeParamSlot(1, 0, ir.LocalI32Tag, 4))
    add(body.localSlots, makeParamSlot(2, 1, ir.LocalI32Tag, 4))
    for slotIndex in 3..<8:
        add(body.localSlots,
            makeSlot(slotIndex, ir.LocalI32Tag, 4))
    appendFieldStore(body, 0, 1, 0)
    appendIndexedStore(body, 0, 1, 2)
    appendFieldLoad(body, 0, 3, 4)
    appendFieldLoad(body, 0, 4, 8)
    appendIndexedLoad(body, 0, 5, 2)
    appendIndexedLoad(body, 0, 6, 2)
    var compare: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(compare)
    compare.kind = ir.BodyOpCmpTag
    compare.target = 7
    add(compare.operands, ir.BodyCondI32EqTag)
    add(compare.operands, 3)
    add(compare.operands, 5)
    add(body.ops, compare)
    let termIndex = appendI32Return(body, 7)
    let _ = ir.BodyIRAppendBlock(body, 0, 7, termIndex)
    return body

fn buildFixedAddressCallBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    bindExactTypeArena(body)
    add(body.localSlots,
        makeGlobalSlot(0, "source/path::raw_address",
                       ir.LocalI64Tag, 8))
    let literalId = ir.BodyIRAppendCStringLiteral(body, "payload", "")
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "surface_target"
    call.resultSlot = -1
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    add(call.argSlots, 0)
    add(call.argPassKinds, ir.BodyCallPassGlobalAddressTag)
    add(call.argAbiSizes, 8)
    for _ in 1..<9:
        add(call.argSlots, ir.CallArgSlotCString(literalId))
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 8)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = -1
    add(callOp.operands, 0)
    add(body.ops, callOp)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn dataPageCount(
        emission: var emitter.RegallocProductionFunctionEmission,
        opIndex: int32,
        targetSymbol: str): int32 =
    var count: int32
    for relocIndex in 0..<emission.recipes.functionRelocs.len:
        let reloc = emission.recipes.functionRelocs[relocIndex]
        if reloc.kind == contract.RegallocA64RelocPage21 &&
           reloc.opIndex == opIndex &&
           reloc.targetSymbol == targetSymbol:
            count = count + 1
    return count

fn dataPairStreamValid(
        emission: var emitter.RegallocProductionFunctionEmission): bool =
    for relocIndex in 0..<emission.recipes.functionRelocs.len:
        let reloc = emission.recipes.functionRelocs[relocIndex]
        if reloc.kind == contract.RegallocA64RelocPage21:
            if relocIndex + 1 >= emission.recipes.functionRelocs.len:
                return false
            let pageOff =
                emission.recipes.functionRelocs[relocIndex + 1]
            if pageOff.kind != contract.RegallocA64RelocPageOff12 ||
               pageOff.wordIndex != reloc.wordIndex + 1 ||
               pageOff.opIndex != reloc.opIndex ||
               pageOff.subIndex != reloc.subIndex ||
               pageOff.targetSymbol != reloc.targetSymbol:
                return false
        elif reloc.kind == contract.RegallocA64RelocPageOff12:
            if relocIndex <= 0 ||
               emission.recipes.functionRelocs[relocIndex - 1].kind !=
                   contract.RegallocA64RelocPage21:
                return false
        elif reloc.kind != contract.RegallocA64RelocCall26:
            return false
    return true

fn frozenRowsMatchEmission(
        body: var ir.BodyIR,
        emission: var emitter.RegallocProductionFunctionEmission,
        callTarget: str): bool =
    var state: pobj.PrimaryObjectPlanPhaseState
    state.streamedFillFailedIndex = -1
    let itemId: int32 = 700001
    let functionBase: int32 = 4096
    add(state.itemIds, itemId)
    add(state.functionWordOffsets, functionBase)
    if callTarget != "":
        add(state.relocSourceItemIds, itemId)
        add(state.relocWordOffsets, -1)
        add(state.relocTargetSymbols, callTarget)
        add(state.relocTargetDomainKinds,
            ir.BodyCallTargetDomainInvalidTag)
        add(state.relocTargetRows, -1)
        add(state.relocTargetInterfaceCids,
            layout.FixedBytes32())
        add(state.relocCallOrdinal, 0)
    var resolvedCallTargets: str[]
    if !pobj.PrimaryObjectPlanRecordRegallocProductionRelocs(
           state, 0, body, 0, 0, emission, resolvedCallTargets):
        return false
    if state.dataRelocSourceItemIds.len !=
           state.dataRelocWordOffsets.len ||
       state.dataRelocWordOffsets.len !=
           state.dataRelocPredictedKey.len ||
       state.dataRelocPredictedKey.len !=
           state.dataRelocOpIndex.len ||
       state.dataRelocOpIndex.len != state.dataRelocSubIndex.len ||
       state.dataRelocSubIndex.len !=
           state.dataRelocTargetSymbols.len:
        return false
    var dataOrdinal: int32
    for relocIndex in 0..<emission.recipes.functionRelocs.len:
        let reloc = emission.recipes.functionRelocs[relocIndex]
        if reloc.kind != contract.RegallocA64RelocPage21:
            continue
        if dataOrdinal >= state.dataRelocWordOffsets.len ||
           state.dataRelocSourceItemIds[dataOrdinal] != itemId ||
           state.dataRelocWordOffsets[dataOrdinal] !=
               functionBase + reloc.wordIndex ||
           state.dataRelocPredictedKey[dataOrdinal] !=
               functionBase + reloc.wordIndex ||
           state.dataRelocOpIndex[dataOrdinal] != reloc.opIndex ||
           state.dataRelocSubIndex[dataOrdinal] != reloc.subIndex ||
           state.dataRelocTargetSymbols[dataOrdinal] !=
               reloc.targetSymbol:
            return false
        dataOrdinal = dataOrdinal + 1
    return dataOrdinal == state.dataRelocWordOffsets.len

fn verifyScalarCanonicalAndDead(): int32 =
    var body = buildScalarGlobalBody()
    var noCallTargets: str[]
    var noDataTargets: str[]
    var missing = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_scalar_owner", 0, noCallTargets, noDataTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if missing.valid ||
       missing.errorCode != emitter.RegallocProductionEmitDataTargetInvalid:
        return 1
    var shortTargets: str[]
    add(shortTargets, "_canonical_scalar")
    var shortMap = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_scalar_owner", 0, noCallTargets, shortTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if shortMap.valid ||
       shortMap.errorCode != emitter.RegallocProductionEmitDataTargetInvalid:
        return 2
    var invalidTargets: str[]
    add(invalidTargets, "_canonical_scalar")
    add(invalidTargets, "_must_be_empty")
    add(invalidTargets, "")
    add(invalidTargets, "")
    var invalidMap = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_scalar_owner", 0, noCallTargets, invalidTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if invalidMap.valid ||
       invalidMap.errorCode != emitter.RegallocProductionEmitDataTargetInvalid:
        return 3
    var targets: str[]
    add(targets, "_canonical_scalar")
    add(targets, "")
    add(targets, "")
    add(targets, "")
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_scalar_owner", 0, noCallTargets, targets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid:
        return 100 + emission.errorCode
    if !emission.receipt.valid:
        return 5
    if !dataPairStreamValid(emission):
        return 6
    if !frozenRowsMatchEmission(body, emission, ""):
        return 7
    if body.localSlots[0].name != "source/path::raw_scalar":
        return 8
    if dataPageCount(emission, 0, "_canonical_scalar") != 1:
        return 9
    if dataPageCount(emission, 1, "_canonical_scalar") != 1:
        return 10
    if dataPageCount(emission, 2, "_canonical_scalar") != 0:
        return 11
    var malformedPair = emission
    for relocIndex in 0..<malformedPair.relocs.len:
        if malformedPair.relocs[relocIndex].kind ==
               contract.RegallocA64RelocPageOff12:
            malformedPair.relocs[relocIndex].callOrdinal = 0
            break
    if frozenRowsMatchEmission(body, malformedPair, ""):
        return 12
    return 0

fn verifyAggregateLiveAndDead(): int32 =
    var body = buildAggregateGlobalBody()
    var noCallTargets: str[]
    var targets: str[]
    add(targets, "_canonical_aggregate")
    for _ in 1..<body.localSlots.len:
        add(targets, "")
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_aggregate_owner", 128, noCallTargets, targets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid || !emission.receipt.valid ||
       !dataPairStreamValid(emission) ||
       !frozenRowsMatchEmission(body, emission, ""):
        return 10 + emission.errorCode
    if dataPageCount(emission, 0, "_canonical_aggregate") != 1 ||
       dataPageCount(emission, 1, "_canonical_aggregate") != 1 ||
       dataPageCount(emission, 2, "_canonical_aggregate") != 1 ||
       dataPageCount(emission, 3, "_canonical_aggregate") != 0 ||
       dataPageCount(emission, 4, "_canonical_aggregate") != 1 ||
       dataPageCount(emission, 5, "_canonical_aggregate") != 0:
        return 20
    return 0

fn verifyPrimaryResolvedDataTargets(): int32 =
    var body = ir.BodyIRNew()
    bindExactTypeArena(body)
    add(body.localSlots,
        makeGlobalSlot(0, "source/path::raw_mapping",
                       ir.LocalI32Tag, 4))
    add(body.localSlots,
        makeGlobalSlot(1, "__cheng_function_address#1",
                       ir.LocalPtrTag, 8))
    add(body.localSlots, makeSlot(2, ir.LocalI32Tag, 4))
    var allSymbolNames: str[]
    add(allSymbolNames, "_function_zero")
    add(allSymbolNames, "_function_one")
    var resolved: str[]
    if !pobj.PrimaryObjectPlanRegallocResolvedDataTargets(
           body, "arm64-apple-darwin", allSymbolNames, resolved) ||
       resolved.len != body.localSlots.len ||
       resolved[0] != pobj.PrimaryGlobalDataLabel(
           "arm64-apple-darwin", "source/path::raw_mapping") ||
       resolved[1] != "_function_one" || resolved[2] != "":
        return 70
    body.localSlots[1].name = "__cheng_function_address#2"
    if pobj.PrimaryObjectPlanRegallocResolvedDataTargets(
           body, "arm64-apple-darwin", allSymbolNames, resolved):
        return 71
    return 0

fn verifyFixedAddressAndCString(): int32 =
    var body = buildFixedAddressCallBody()
    var callTargets: str[]
    add(callTargets, "_canonical_callee")
    var dataTargets: str[]
    add(dataTargets, "_canonical_address")
    var emission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        body, "_fixed_address_owner", 512,
        callTargets, dataTargets,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !emission.valid || !emission.receipt.valid ||
       !dataPairStreamValid(emission) ||
       !frozenRowsMatchEmission(body, emission,
                                "_canonical_callee") ||
       body.localSlots[0].name != "source/path::raw_address" ||
       body.cstringLiterals.len != 1 ||
       body.cstringLiterals[0].dataLabel != "":
        return 30 + emission.errorCode
    let cstringTarget =
        "_fixed_address_owner__cheng_cstring_0"
    var pageOrdinal: int32
    var callCount: int32
    var globalCount: int32
    var cstringCount: int32
    for relocIndex in 0..<emission.recipes.functionRelocs.len:
        let reloc = emission.recipes.functionRelocs[relocIndex]
        if reloc.kind == contract.RegallocA64RelocCall26:
            if reloc.callOrdinal != 0 ||
               reloc.targetSymbol != "_canonical_callee":
                return 40
            callCount = callCount + 1
        elif reloc.kind == contract.RegallocA64RelocPage21:
            if reloc.opIndex != 0 || reloc.subIndex != pageOrdinal:
                return 41
            pageOrdinal = pageOrdinal + 1
            if reloc.targetSymbol == "_canonical_address":
                globalCount = globalCount + 1
            elif reloc.targetSymbol == cstringTarget:
                cstringCount = cstringCount + 1
            else:
                return 42
    if callCount != 1 || pageOrdinal != 9 ||
       globalCount != 1 || cstringCount != 8:
        return 43
    return 0

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !rega64.RegallocA64CodegenUnitRegister():
        return 90
    let scalarCode = verifyScalarCanonicalAndDead()
    if scalarCode != 0:
        return scalarCode
    let aggregateCode = verifyAggregateLiveAndDead()
    if aggregateCode != 0:
        return aggregateCode
    let mappingCode = verifyPrimaryResolvedDataTargets()
    if mappingCode != 0:
        return mappingCode
    return verifyFixedAddressAndCString()
