# libp2p CAS fetch-on-miss e2e — "直调 WithFetch 构件" 驱动 (真 UDP QUIC fetcher fn-value)。
#
# 这是 e2e 门的 B 侧: 空库 + lock 记录 modulePath=cid + blob 缺 → 调
# CasResolveDependencyPathWithFetch(..., fetcher)。fetcher 是【顶层命名函数】作 fn-value 传入,
# 其体走真 UDP QUIC (Libp2pHostQuicFetchCasSource) 向 CHENG_CAS_PEER 拉源 → 返回字节 →
# 库内 CasAdmitFetchedBytes 自校验 + ingest → CasResolveDependencyPath 物化。全链无 mock。
#
# 与 net_cas_cli pull 的区别: pull 是【显式命名函数直调】fetch+admit; 本驱动经【WithFetch 构件
# 的 fetcher(cidHex) fn-value 间接调用】触发 —— 正是 parser miss-hook 集成后自动跑的那条路径,
# 也是 cold-parser fn-value 修复解锁的 driver-gated 行。故本驱动是集成前唯一能端到端压这条路的门。
#
# 环境: CHENG_CAS_ROOT=空库目录, CHENG_CAS_PEER=host:port (A 服务端 ephemeral 端口)。
# 参数: --module <modulePath> --cid <cidHex>。
# 生产纪律: peer 缺/cid 非法/fetch 失败/admission 失败/物化失败 = 硬错非零, 绝不静默。

import std/system
import std/cmdline as cmdline
import std/result
import std/os as os
import std/rawbytes as rawbytes
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/libp2p/cas_store as cas
import cheng/libp2p/protocols/cas_source/codec as codec
import cheng/libp2p/host/host_quic as hq

# ★ 顶层命名 fetcher (CasSourceFetcher 契约: fn(cidHex: str): Result[Bytes])。
# 只吃 cidHex; peer 从 CHENG_CAS_PEER 环境读 (fn-value 签名不可加参)。
fn e2eQuicFetcher(cidHex: str): Result[Bytes] =
    let peer = os.GetEnvDefault("CHENG_CAS_PEER", "")
    if peer == "":
        return Err[Bytes]("fetcher: CHENG_CAS_PEER 未设 (host:port)")
    let parts = strutil.Split(peer, ':')
    if parts.len != 2:
        return Err[Bytes]("fetcher: CHENG_CAS_PEER 须 host:port: " + peer)
    let host = parts[0]
    var port: int32 = 0
    if !cmdline.ParseInt32(parts[1], port):
        return Err[Bytes]("fetcher: peer 端口非法: " + parts[1])
    if port <= 0:
        return Err[Bytes]("fetcher: peer 端口须 > 0: " + IntToStr(port))
    var cidRes: Result[layout.FixedBytes32] = layout.FixedBytes32FromHex(cidHex)
    if IsErr(cidRes):
        return Err[Bytes]("fetcher: cidHex 非法: " + cidHex)
    let cid = Value(cidRes)
    var wantCids: layout.FixedBytes32[]
    add(wantCids, cid)
    var outBlocks: codec.CasSourceBlockEntry[]
    var fetchRes: Result[int32] = hq.Libp2pHostQuicFetchCasSource(host, port, "localhost", wantCids, outBlocks)
    if IsErr(fetchRes):
        return Err[Bytes]("fetcher: QUIC fetch 失败: " + Error(fetchRes))
    if Value(fetchRes) != 1 || outBlocks.len != 1:
        return Err[Bytes]("fetcher: 期望恰好 1 块, 实得 " + IntToStr(outBlocks.len))
    return Ok[Bytes](outBlocks[0].data)

fn main(): int32 =
    let storeRoot = os.GetEnvDefault("CHENG_CAS_ROOT", "")
    let modulePath = cmdline.ReadFlagOrDefault("--module", "")
    let cidHex = cmdline.ReadFlagOrDefault("--cid", "")
    if storeRoot == "":
        os.WriteLine(os.Get_stderr(), "driver: CHENG_CAS_ROOT 未设")
        return 2
    if modulePath == "":
        os.WriteLine(os.Get_stderr(), "driver: --module 必填")
        return 2
    if cidHex == "":
        os.WriteLine(os.Get_stderr(), "driver: --cid 必填")
        return 2

    # 记 lock (modulePath=cid, 幂等)。blob 在不在由 WithFetch 内部 CasStoreHas 决定:
    # 缺 → fetcher(cidHex) 真拉源; 在 → 直接从 cache 物化 (幂等复用, 无网络)。
    # "是否真为 miss" 的前置由调用方 shell 断言 (库空 blob 缺), 驱动只负责 WithFetch + 后置。
    var recRes: Result[bool] = cas.CasLockRecord(storeRoot, modulePath, cidHex)
    if IsErr(recRes):
        os.WriteLine(os.Get_stderr(), "driver: lock record 失败: " + Error(recRes))
        return 1

    # ★ WithFetch 构件: fetcher 顶层函数名作 fn-value 传入; 库内 fetcher(cidHex) 间接调用触发真拉源。
    var fetcher: cas.CasSourceFetcher = e2eQuicFetcher
    var res: Result[str] = cas.CasResolveDependencyPathWithFetch(storeRoot, modulePath, "/nonexistent", fetcher)
    if IsErr(res):
        os.WriteLine(os.Get_stderr(), "driver: WithFetch 失败 (硬错): " + Error(res))
        return 1
    let matPath = Value(res)

    # 后置断言: blob 已 admit 落库, 物化字节 sha == cid (内容寻址闭环)。
    if !cas.CasStoreHas(storeRoot, cidHex):
        os.WriteLine(os.Get_stderr(), "driver: 后置失败 (fetch 后 blob 仍缺)")
        return 1
    var getRes: Result[Bytes] = cas.CasStoreGet(storeRoot, cidHex)
    if IsErr(getRes):
        os.WriteLine(os.Get_stderr(), "driver: store 读回/重校验失败: " + Error(getRes))
        return 1
    echo("MATERIALIZED=" + matPath)
    echo("driver: fetch-on-miss ok cid=" + cidHex + " bytes=" + IntToStr(BytesLen(Value(getRes))))
    return 0
