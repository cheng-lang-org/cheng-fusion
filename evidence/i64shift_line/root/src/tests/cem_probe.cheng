# cem probe — minimal CEM smoke: dim=2 quadratic bowl (targets 1.5 / -0.5,
# known optimum score = ProbeScoreScale), pop=12, elite=3, 5 generations,
# serial evaluation. Asserts the optimizer moves in the converging direction
# (final best strictly above the first generation's best and above the
# threshold) and that two runs under the same seed are bit-identical.
#
# Shares the environment-interface contract with
# src/apps/policy_tuner/main.cheng: score(params, seed) -> float64, bigger is
# better, episode seed = baseSeed + episodeIdx.
import std/math
import std/strings

const
    ProbeDim = 2
    ProbePop = 12
    ProbeElite = 3
    ProbeGens = 5
    ProbeScoreScale = 100.0
    ProbePass = 90.0
    ProbeSeed = 42

fn ProbeTarget(d: int32): float64 =
    if d == 0:
        return 1.5
    return -0.5

fn ProbeWeight(d: int32): float64 =
    if d == 0:
        return 1.0
    return 3.0

fn ProbeScore(params: float64[], seed: int64): float64 =
    let _seed = seed
    var q: float64
    var d: int32
    for d in 0..<ProbeDim:
        let diff: float64 = params[d] - ProbeTarget(d)
        q = q + ProbeWeight(d) * diff * diff
    return ProbeScoreScale / (1.0 + q)

# Seeded xorshift64 PRNG, local to the probe (matches policy_tuner's Rng64).
type
    Rng64 = object
        state: uint64

fn RngSeed(seed: int64): Rng64 =
    var r: Rng64
    r.state = uint64(seed)
    assert(seed != int64(0), "cem probe: xorshift64 seed must be nonzero")
    return r

fn RngNext(r: var Rng64): uint64 =
    var x: uint64 = r.state
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    r.state = x
    return x

fn RngUnit(r: var Rng64): float64 =
    let val: uint64 = RngNext(r)
    let hi: uint64 = val >> 11
    return float64(int64(hi)) / 9007199254740992.0

fn StdNormal(rng: var Rng64): float64 =
    let u1: float64 = 1.0 - RngUnit(rng)
    let u2: float64 = RngUnit(rng)
    let radius: float64 = Sqrt(-2.0 * Ln(u1))
    let twoPi: float64 = 2.0 * (355.0 / 113.0)
    return radius * Cos(twoPi * u2)

fn FmtF64(v: float64): str =
    var neg: bool
    neg = false
    var x: float64
    x = v
    if x < 0.0:
        neg = true
        x = 0.0 - x
    let scaled: int64 = int64(x * 1000.0 + 0.5)
    let ip: int64 = scaled / 1000
    let fp: int64 = scaled - ip * 1000
    var out: str
    out = strings.Int64ToStr(ip) + "."
    if fp < 10:
        out = out + "00" + strings.Int64ToStr(fp)
    else:
        if fp < 100:
            out = out + "0" + strings.Int64ToStr(fp)
        else:
            out = out + strings.Int64ToStr(fp)
    if neg:
        return "-" + out
    return out

# One CEM run; bestParams receives the winning vector. Returns the best score.
fn ProbeTrain(baseSeed: int64, bestParams: var float64[]): float64 =
    var mean: float64[]
    setLen(mean, ProbeDim)
    var std: float64[]
    setLen(std, ProbeDim)
    var cand: float64[]
    setLen(cand, ProbePop * ProbeDim)
    var scores: float64[]
    setLen(scores, ProbePop)
    var taken: int32[]
    setLen(taken, ProbePop)
    var eliteIdx: int32[]
    setLen(eliteIdx, ProbeElite)
    let initStd: float64 = 2.0
    let stdFloor: float64 = 1.0 / 1000.0
    var d: int32
    for d in 0..<ProbeDim:
        mean[d] = 0.0
        std[d] = initStd
    var rng: Rng64
    rng = RngSeed(baseSeed)
    var firstGenBest: float64
    var globalBest: float64
    globalBest = -ProbeScoreScale
    var globalBestIdx: int32
    var gen: int32
    var genBest: float64
    var genBestIdx: int32
    for gen in 0..<ProbeGens:
        var i: int32
        for i in 0..<ProbePop:
            let base: int32 = i * ProbeDim
            var sd: int32
            for sd in 0..<ProbeDim:
                cand[base + sd] = mean[sd] + std[sd] * StdNormal(rng)
        var i2: int32
        for i2 in 0..<ProbePop:
            var row: float64[]
            setLen(row, ProbeDim)
            var pd: int32
            for pd in 0..<ProbeDim:
                row[pd] = cand[i2 * ProbeDim + pd]
            scores[i2] = ProbeScore(row, baseSeed + int64(i2))
        genBest = scores[0]
        genBestIdx = 0
        var i3: int32
        for i3 in 0..<ProbePop:
            if scores[i3] > genBest:
                genBest = scores[i3]
                genBestIdx = i3
        if gen == 0:
            firstGenBest = genBest
        if genBest > globalBest:
            globalBest = genBest
            globalBestIdx = genBestIdx
        var t: int32
        for t in 0..<ProbePop:
            taken[t] = 0
        var e: int32
        for e in 0..<ProbeElite:
            var bestI: int32
            bestI = -1
            var bestS: float64
            var j: int32
            for j in 0..<ProbePop:
                if taken[j] == 0:
                    if bestI < 0:
                        bestI = j
                        bestS = scores[j]
                    else:
                        if scores[j] > bestS:
                            bestI = j
                            bestS = scores[j]
            taken[bestI] = 1
            eliteIdx[e] = bestI
        var ud: int32
        for ud in 0..<ProbeDim:
            var mAcc: float64
            var vAcc: float64
            var e2: int32
            for e2 in 0..<ProbeElite:
                mAcc = mAcc + cand[eliteIdx[e2] * ProbeDim + ud]
            let newMean: float64 = mAcc / float64(ProbeElite)
            var e3: int32
            for e3 in 0..<ProbeElite:
                let diff: float64 = cand[eliteIdx[e3] * ProbeDim + ud] - newMean
                vAcc = vAcc + diff * diff
            let newStd: float64 = Sqrt(vAcc / float64(ProbeElite))
            mean[ud] = newMean
            if newStd < stdFloor:
                std[ud] = stdFloor
            else:
                std[ud] = newStd
        echo("gen " + strings.IntToStr(gen) + " best=" + FmtF64(genBest))
    echo("direction firstGenBest=" + FmtF64(firstGenBest) + " finalBest=" + FmtF64(globalBest))
    assert(globalBest > firstGenBest, "cem probe: best score did not improve")
    assert(globalBest > ProbePass, "cem probe: best score below convergence threshold")
    var bd: int32
    for bd in 0..<ProbeDim:
        bestParams[bd] = cand[globalBestIdx * ProbeDim + bd]
    return globalBest

fn main(): int32 =
    var bestA: float64[]
    setLen(bestA, ProbeDim)
    var bestB: float64[]
    setLen(bestB, ProbeDim)
    let scoreA: float64 = ProbeTrain(int64(ProbeSeed), bestA)
    let scoreB: float64 = ProbeTrain(int64(ProbeSeed), bestB)
    assert(scoreA == scoreB, "cem probe: same-seed runs diverge")
    assert(bestA[0] == bestB[0] and bestA[1] == bestB[1],
           "cem probe: same-seed params diverge")
    echo("determinism=bitwise-identical runs=2 score=" + FmtF64(scoreA))
    echo("PASS cem probe")
    return 0
