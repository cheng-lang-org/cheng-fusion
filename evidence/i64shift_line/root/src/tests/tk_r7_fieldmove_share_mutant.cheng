type
    R7Bundle =
        compilerPath: str
        count: int32

fn R7CurrentCompiler(): str =
    return "compiler-path"

fn R7Fill(out: var R7Bundle): bool =
    out = R7Bundle()
    let currentCompilerPath = R7CurrentCompiler()
    out.compilerPath = share(currentCompilerPath)
    if len(currentCompilerPath) <= 0:
        return false
    out.count = int32(len(currentCompilerPath))
    return true

fn main(): int32 =
    var bundle: R7Bundle
    if !R7Fill(bundle):
        return 10
    if bundle.compilerPath != "WRONG":
        return 11
    if bundle.count != 13:
        return 12
    echo(Fmt"r7_fieldmove_reuse ok path={bundle.compilerPath} count={bundle.count}")
    return 0
