import std/rawbytes
import cheng/core/backend/direct_object_emit as direct
import cheng/core/backend/primary_object_plan as pobj

fn appendLabel(plan: var pobj.PrimaryObjectPlan,
               label: str,
               payload: str,
               rawByteCount: int32) =
    add(plan.dataLabels, label)
    add(plan.dataPayloadTexts, payload)
    add(plan.dataPayloadRawByteCounts, rawByteCount)

fn main(): int32 =
    var plan: pobj.PrimaryObjectPlan
    appendLabel(plan, "raw-first", "-", 3)
    appendLabel(plan, "zero-middle", "zero:4", 0)
    appendLabel(plan, "raw-second", "-", 2)
    appendLabel(plan, "hex-last", "hex:0a0b", 0)
    add(plan.dataPayloadRawBytes, 1)
    add(plan.dataPayloadRawBytes, 2)
    add(plan.dataPayloadRawBytes, 3)
    add(plan.dataPayloadRawBytes, 254)
    add(plan.dataPayloadRawBytes, 255)

    let byteCount = direct.DirectObjectEmitPlanDataByteCount(plan, 0)
    if byteCount != 12:
        return 1
    var first = direct.DirectObjectEmitPlanData(plan, 0)
    var second: Bytes
    direct.DirectObjectEmitPlanDataInto(plan, 0, second)
    if BytesLen(first) != byteCount ||
       BytesLen(second) != byteCount ||
       !BytesEqual(first, second):
        BytesFree(first)
        BytesFree(second)
        return 2
    let expected = [1, 2, 3, 0, 0, 0, 0, 0, 254, 255, 10, 11]
    for byteIndex in 0..<expected.len:
        if BytesGet(first, byteIndex) != expected[byteIndex]:
            BytesFree(first)
            BytesFree(second)
            return 3
    BytesFree(first)
    BytesFree(second)
    echo("direct_object_data_linear_smoke=PASS")
    return 0
