import std/os as os
import std/strings
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/relfacts

type
    ProbeBinding =
        standard: str
        profiles: str[]
        schemaNamespace: str
        schemaCid: str

@borrows
fn mkBinding(profiles: str[]): ProbeBinding =
    var out: ProbeBinding
    out.standard = "csg_core::v1"
    out.profiles = profiles
    out.schemaNamespace = "csg_core::v1"
    out.schemaCid =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    return out

@borrows
fn replayViaWrapper(
        text: str,
        beforeFacts: str[],
        afterFacts: str[],
        beforeBinding: ProbeBinding,
        afterBinding: ProbeBinding):
        relfacts.CsgCoreRelfactsReplayResult =
    return relfacts.CsgCoreRelfactsReplayCanonicalTransition(
        text,
        beforeFacts,
        afterFacts,
        beforeBinding.standard,
        beforeBinding.profiles,
        beforeBinding.schemaNamespace,
        beforeBinding.schemaCid,
        afterBinding.standard,
        afterBinding.profiles,
        afterBinding.schemaNamespace,
        afterBinding.schemaCid)

fn main(): int32 =
    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleOld =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let moduleNew =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:bbb\"}"
    let symbol =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let beforeFacts = [strings.CloneStr(schema), strings.CloneStr(moduleOld), strings.CloneStr(symbol)]
    let afterFacts = [strings.CloneStr(schema), strings.CloneStr(moduleNew), strings.CloneStr(symbol)]
    let binding = mkBinding(["csg_core"])
    let beforeDag =
        merkle_dag.CsgCoreMerkleBuildCanonicalBound(
            beforeFacts,
            binding.standard,
            binding.profiles,
            binding.schemaNamespace,
            binding.schemaCid)
    if !beforeDag.ok:
        return 1
    let transition = relfacts.CsgCoreRelfactsEncodeCanonicalTransition(
        beforeFacts,
        afterFacts,
        binding.standard,
        binding.profiles,
        binding.schemaNamespace,
        binding.schemaCid,
        binding.standard,
        binding.profiles,
        binding.schemaNamespace,
        binding.schemaCid)
    if !transition.ok:
        os.WriteLine(os.Get_stderr(), transition.error)
        return 1
    os.WriteLine(os.Get_stderr(), "p2_encoded")
    let replay = replayViaWrapper(
        transition.text,
        beforeFacts,
        afterFacts,
        binding,
        binding)
    os.WriteLine(os.Get_stderr(), "p2_replayed")
    if !replay.ok:
        os.WriteLine(os.Get_stderr(), replay.error)
        return 1
    if replay.beforeDagRootCid != beforeDag.dagRootCid:
        return 1
    os.WriteLine(os.Get_stdout(), "replay2 ok")
    return 0
