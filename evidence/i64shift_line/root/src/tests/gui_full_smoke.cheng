fn main(): int32 =
    gui.Log("Cheng GUI init")
    gui.Init()
    var win: int32 = gui.CreateWindow("Cheng Web App", 800, 600)
    gui.ShowWindow(win)

    var runtime: react.ReactRuntime
    react.ReactRuntimeInit(runtime)

    var root0: react.ReactElement = __csg_root_0(runtime)

    var document: web.WebDocument
    web.WebDocumentInit(document)
    let documentNode = web.WebDocumentCreateDocumentNode(document)
    var node0 = 0
    if !react.Reconcile(runtime, document, root0, node0):
        return 1
    if node0 == 0:
        return 2
    if !web.WebDocumentAppendChild(document, documentNode, node0):
        return 3
    gui.Log("csg_web_materializer ok")

    var frame: int32
    while frame < 600:
        gui.ProcessFrame()
        var event: int32 = gui.PollEvent()
        if event != 0:
            var evType: int32 = gui.NextEvent()
            if evType == gui.EVENT_QUIT:
                break
            gui.ConsumeEvent()
        gui.SleepMs(16)
        frame = frame + 1

    gui.CloseWindow(win)
    gui.Quit()
    return 0
