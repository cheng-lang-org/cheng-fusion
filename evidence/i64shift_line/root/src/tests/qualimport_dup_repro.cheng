import std/system
import cheng/tests/qualimport_dup/rec_mod as tlsrec
import cheng/tests/qualimport_dup/hs_mod as hs

# Mirrors the VPN cold regression: this entry imports the shared record module
# under alias `tlsrec`, while hs_mod imported the SAME module under alias `rec`.
# The struct field is declared `tlsrec.RecKeys`; the assigned value is typed
# `rec.RecKeys` (hs.makeKeys's return). Cold registered two ObjectDefs for the
# one underlying type (one per alias) -> field-store identity check died with
# "aggregate field store type mismatch" and dropped the function body.
type
    ForwardLink =
        sendKeys: tlsrec.RecKeys

fn main(): int32 =
    var link: ForwardLink
    link.sendKeys = hs.makeKeys()
    if link.sendKeys.a == 11 && link.sendKeys.d == 44:
        echo("qualimport_dup_repro ok cross_alias_store=correct")
        return 0
    echo("qualimport_dup_repro FAIL wrong_values")
    return 2
