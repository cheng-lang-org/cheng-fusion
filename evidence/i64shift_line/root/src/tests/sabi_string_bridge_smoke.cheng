import std/os
import std/strings as strings

@borrows
fn assertTextHas(text: str, needle: str, label: str) =
    assert(strings.StrContains(text, needle), label)

fn assertFileHas(path: str, needle: str, label: str) =
    assert(os.FileExists(path), label)
    assert(os.FileSize(path) > int64(0), label)
    let text: str = os.ReadFile(path)
    assertTextHas(text, needle, label)

fn main(): int32 =
    let specText = os.ReadFile("docs/cheng-formal-spec.md")
    let proposalText = os.ReadFile("openspec/proposals/str-abi-bridge-contract.md")
    let parserText = os.ReadFile("src/core/lang/parser.cheng")
    let typedText = os.ReadFile("src/core/lang/typed_expr.cheng")
    let coldText = os.ReadFile("bootstrap/cold_parser.c")

    assertTextHas(specText,
                  "string_abi_contract.schema=canonical",
                  "sabi: spec marker")
    assertTextHas(specText,
                  "string_abi_contract.abi.ffi_map_str=forbidden",
                  "sabi: ffi_map str forbidden marker")
    assertTextHas(proposalText,
                  "SABI String ABI Bridge Contract",
                  "sabi: proposal title")

    assertTextHas(parserText,
                  "abiInternal: bool",
                  "sabi: parser abi_internal field")
    assertTextHas(parserText,
                  "ffiOwnedResultPresent: bool",
                  "sabi: parser owned result presence field")
    assertTextHas(parserText,
                  "fn ParserNormalizedAnnotationKnownFunctionName",
                  "sabi: structured annotation registry")
    assertTextHas(parserText,
                  "fn ParserNormalizedAnnotationExactKeyIdentifierInto",
                  "sabi: structured owned result argument")
    assertTextHas(parserText,
                  "fn ParserApplyNormalizedFunctionAnnotationsInto",
                  "sabi: structured function annotation consumer")
    assert(!strings.StrContains(
               parserText,
               "fn ParserParseFfiOwnedResultFreeAnnotation"),
           "sabi: text annotation parser removed")

    assertTextHas(typedText,
                  "fn TypedExprTypeContainsSabiBoundary",
                  "sabi: typed boundary helper")
    assertTextHas(typedText,
                  "ZRPC/SABI violation",
                  "sabi: typed diagnostic")
    assert(!strings.StrContains(typedText, "TypedExprSourceAllowsInternalCAbiStr"),
           "sabi: typed path whitelist removed")

    assertTextHas(coldText,
                  "cold_type_contains_sabi_boundary",
                  "sabi: cold boundary helper")
    assertTextHas(coldText,
                  "cold_find_fn_attr_value",
                  "sabi: cold owned result attr parser")
    assert(!strings.StrContains(coldText, "cold_str_c_abi_path_is_internal"),
           "sabi: cold path whitelist removed")

    assertFileHas("tests/cheng/backend/fixtures/compile_fail_sabi_ffi_map_str.cheng",
                  "@ffi_map(ptr = arg0, len = arg1)",
                  "sabi: ffi_map str negative")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_sabi_owned_cstring_no_free.cheng",
                  "fn getErrorMessage(): owned_cstring",
                  "sabi: owned cstring no free negative")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_sabi_boundary_plain_fn.cheng",
                  "text: utf8_view",
                  "sabi: plain boundary negative")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_sabi_boundary_global.cheng",
                  "badText: bytes_view",
                  "sabi: boundary global negative")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_sabi_boundary_object.cheng",
                  "text: utf8_view",
                  "sabi: boundary object negative")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_sabi_view_return.cheng",
                  "): utf8_view",
                  "sabi: view return negative")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_sabi_owned_cstring_param.cheng",
                  "text: owned_cstring",
                  "sabi: owned cstring param negative")
    assertFileHas("tests/cheng/backend/fixtures/compile_fail_sabi_cstring_inner_nul.cheng",
                  "bad\\0text",
                  "sabi: cstring inner nul negative")

    assertFileHas("tests/cheng/backend/fixtures/sabi/sabi_utf8_view_smoke.cheng",
                  "text: utf8_view",
                  "sabi: utf8_view positive")
    assertFileHas("tests/cheng/backend/fixtures/sabi/sabi_bytes_view_smoke.cheng",
                  "data: bytes_view",
                  "sabi: bytes_view positive")
    assertFileHas("tests/cheng/backend/fixtures/sabi/sabi_cstring_smoke.cheng",
                  "text: cstring",
                  "sabi: cstring positive")
    assertFileHas("tests/cheng/backend/fixtures/sabi/sabi_owned_cstring_free_smoke.cheng",
                  "@ffi_owned_result(free = SabiFree)",
                  "sabi: owned_cstring free positive")
    assertFileHas("tests/cheng/backend/fixtures/sabi/sabi_abi_internal_smoke.cheng",
                  "@abi_internal",
                  "sabi: abi_internal positive")

    echo(" sabi_string_bridge_smoke ok")
    return 0
