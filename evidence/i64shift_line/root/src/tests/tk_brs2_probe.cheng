module tk_brs2_probe

import std/bytes_layout as layout
import std/rawbytes

fn Caller(bytes: rawbytes.Bytes): int32 =
    let span = layout.ByteSpanFromBytes(bytes)
    return span.len

fn main(): int32 =
    var b = rawbytes.BytesFromString("abcd")
    let span2 = layout.ByteSpanFromBytes(b)
    if span2.len != 4:
        return 3
    return Caller(b)

main()
