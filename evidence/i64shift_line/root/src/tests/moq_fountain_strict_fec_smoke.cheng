import std/rawbytes
import cheng/moq/moq_fountain as moq

fn moqStrictBytesEq(left: rawbytes.Bytes, right: rawbytes.Bytes): bool =
    if rawbytes.BytesLen(left) != rawbytes.BytesLen(right):
        return false
    var i: int32
    for i in i..<rawbytes.BytesLen(left):
        if rawbytes.BytesGet(left, i) != rawbytes.BytesGet(right, i):
            return false
    return true

fn moqStrictWire(blob: rawbytes.Bytes,
                 built: moq.MoqFountainBuildResult,
                 droplets: moq.MoqFountainDroplet[]): str =
    blob
    return moq.MoqFountainBuildWireFromParts(built.ownerPeerId,
                                             built.mimeType,
                                             built.bundleCid,
                                             built.blobCid,
                                             built.blobByteLen,
                                             built.objectTargetBytes,
                                             built.sourceBlockBytes,
                                             built.remoteAckPeerIds,
                                             built.objects,
                                             droplets)

fn main(): int32 =
    let blob = rawbytes.BytesFromString("abcdefghijkl")
    let buildRes = moq.MoqFountainBuild(blob,
                                        "peer-alpha",
                                        "peer-bravo,peer-charlie,peer-delta",
                                        "video/mp4",
                                        64,
                                        4,
                                        4)
    assert(IsOk(buildRes), " moq strict fec: build")
    let built = Value(buildRes)
    assert(built.objects.len == 1, " moq strict fec: one object")
    assert(built.objects[0].sourceBlockCount == 3, " moq strict fec: source count")
    assert(built.droplets.len >= 7, " moq strict fec: source plus repair")

    let fullWire = moq.MoqFountainBuildResultToWire(built)
    let fullRebuildRes = moq.MoqFountainRebuildFromWireStrict(fullWire)
    assert(IsOk(fullRebuildRes), " moq strict fec: full rebuild")
    assert(moqStrictBytesEq(Value(fullRebuildRes).blob, blob), " moq strict fec: full bytes")

    var shuffled: moq.MoqFountainDroplet[]
    shuffled = []
    var rev: int32 = built.droplets.len - 1
    while rev >= 0:
        add(shuffled, built.droplets[rev])
        rev = rev - 1
    let shuffledWire = moqStrictWire(blob, built, shuffled)
    let shuffledRes = moq.MoqFountainRebuildFromWireStrict(shuffledWire)
    if IsErr(shuffledRes):
        echo(Error(shuffledRes))
    assert(IsOk(shuffledRes), " moq strict fec: shuffled rebuild")
    assert(moqStrictBytesEq(Value(shuffledRes).blob, blob), " moq strict fec: shuffled bytes")

    var sourceOnly: moq.MoqFountainDroplet[]
    sourceOnly = []
    add(sourceOnly, built.droplets[0])
    add(sourceOnly, built.droplets[1])
    add(sourceOnly, built.droplets[2])
    let sourceOnlyWire = moqStrictWire(blob, built, sourceOnly)
    let sourceOnlyRes = moq.MoqFountainRebuildFromWireStrict(sourceOnlyWire)
    assert(IsOk(sourceOnlyRes), " moq strict fec: source-only loss tolerated")
    assert(moqStrictBytesEq(Value(sourceOnlyRes).blob, blob), " moq strict fec: source-only bytes")

    var insufficient: moq.MoqFountainDroplet[]
    insufficient = []
    add(insufficient, built.droplets[0])
    add(insufficient, built.droplets[1])
    let insufficientWire = moqStrictWire(blob, built, insufficient)
    let insufficientRes = moq.MoqFountainRebuildFromWireStrict(insufficientWire)
    assert(IsErr(insufficientRes), " moq strict fec: insufficient droplets rejected")

    var duplicate: moq.MoqFountainDroplet[]
    duplicate = []
    var di: int32
    for di in di..<built.droplets.len:
        add(duplicate, built.droplets[di])
    add(duplicate, built.droplets[0])
    let duplicateWire = moqStrictWire(blob, built, duplicate)
    let duplicateRes = moq.MoqFountainRebuildFromWireStrict(duplicateWire)
    assert(IsErr(duplicateRes), " moq strict fec: duplicate droplet rejected")

    var corrupt: moq.MoqFountainDroplet[]
    corrupt = []
    di = 0
    for di in di..<built.droplets.len:
        var item = built.droplets[di]
        if di == 0:
            let copied = rawbytes.BytesSlice(item.payload, 0, rawbytes.BytesLen(item.payload))
            let first = rawbytes.BytesGet(copied, 0)
            rawbytes.BytesSet(copied, 0, first ^ 1)
            item.payload = copied
        add(corrupt, item)
    let corruptWire = moqStrictWire(blob, built, corrupt)
    let corruptRes = moq.MoqFountainRebuildFromWireStrict(corruptWire)
    assert(IsErr(corruptRes), " moq strict fec: corrupt payload rejected")

    echo(" moq_fountain_strict_fec_smoke ok")
    return 0
