import std/os
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/tooling/semantic_snapshot as snapshot

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn MakeIdentity(tag: str): snapshot.PortableSemanticSnapshotIdentity =
    var out: snapshot.PortableSemanticSnapshotIdentity
    var err = ""
    assert(snapshot.PortableSemanticSnapshotIdentityMakeInto(
               TestCid(tag + "/source-receipt"),
               TestCid(tag + "/world"),
               TestCid(tag + "/compiler"),
               TestCid(tag + "/source-bundle"),
               TestCid(tag + "/csg-root"),
               out,
               err),
           err)
    return out

@borrows
fn MakeValidation(
        tag: str,
        binding: snapshot.LocalSourceVersionBinding,
        identity: snapshot.PortableSemanticSnapshotIdentity):
        snapshot.SemanticSnapshotValidationReceipt =
    var out: snapshot.SemanticSnapshotValidationReceipt
    var err = ""
    assert(snapshot.SemanticSnapshotValidationReceiptMakeInto(
               binding, identity,
               TestCid(tag + "/parser"),
               TestCid(tag + "/type"),
               TestCid(tag + "/ownership"),
               TestCid(tag + "/call"),
               TestCid(tag + "/layout"),
               TestCid(tag + "/dependency"),
               TestCid(tag + "/read-set"),
               TestCid(tag + "/reachability"),
               TestCid(tag + "/lifecycle"),
               TestCid(tag + "/query-index-root"),
               out, err),
           err)
    return out

fn AssertPortableIdentityFieldMutationKills(
        identity: var snapshot.PortableSemanticSnapshotIdentity) =
    var err = ""
    let worldHeadCid = identity.worldHeadCid
    identity.worldHeadCid = TestCid("semantic-snapshot/mutated-world")
    assert(!snapshot.PortableSemanticSnapshotIdentityStrictValidateInto(
                identity, err),
           " semantic snapshot smoke: mutated worldHeadCid validated")
    identity.worldHeadCid = worldHeadCid
    let compilerCid = identity.compilerCid
    identity.compilerCid = TestCid("semantic-snapshot/mutated-compiler")
    assert(!snapshot.PortableSemanticSnapshotIdentityStrictValidateInto(
                identity, err),
           " semantic snapshot smoke: mutated compilerCid validated")
    identity.compilerCid = compilerCid
    let sourceBundleCid = identity.sourceBundleCid
    identity.sourceBundleCid = TestCid("semantic-snapshot/mutated-source-bundle")
    assert(!snapshot.PortableSemanticSnapshotIdentityStrictValidateInto(
                identity, err),
           " semantic snapshot smoke: mutated sourceBundleCid validated")
    identity.sourceBundleCid = sourceBundleCid
    let csgRootCid = identity.csgRootCid
    identity.csgRootCid = TestCid("semantic-snapshot/mutated-csg")
    assert(!snapshot.PortableSemanticSnapshotIdentityStrictValidateInto(
                identity, err),
           " semantic snapshot smoke: mutated csgRootCid validated")
    identity.csgRootCid = csgRootCid

@borrows
fn AssertBindingFieldMutationKills(
        binding: var snapshot.LocalSourceVersionBinding,
        identity: snapshot.PortableSemanticSnapshotIdentity) =
    var err = ""
    let worldHeadCid = binding.worldHeadCid
    binding.worldHeadCid = TestCid("semantic-snapshot/mutated-binding-world")
    assert(!snapshot.LocalSourceVersionBindingStrictValidateInto(
                binding, identity, err),
           " semantic snapshot smoke: mutated binding worldHeadCid validated")
    binding.worldHeadCid = worldHeadCid
    let compilerCid = binding.compilerCid
    binding.compilerCid = TestCid("semantic-snapshot/mutated-binding-compiler")
    assert(!snapshot.LocalSourceVersionBindingStrictValidateInto(
                binding, identity, err),
           " semantic snapshot smoke: mutated binding compilerCid validated")
    binding.compilerCid = compilerCid
    let sourceBundleCid = binding.sourceBundleCid
    binding.sourceBundleCid =
        TestCid("semantic-snapshot/mutated-binding-source-bundle")
    assert(!snapshot.LocalSourceVersionBindingStrictValidateInto(
                binding, identity, err),
           " semantic snapshot smoke: mutated binding sourceBundleCid validated")
    binding.sourceBundleCid = sourceBundleCid
    let csgRootCid = binding.csgRootCid
    binding.csgRootCid = TestCid("semantic-snapshot/mutated-binding-csg")
    assert(!snapshot.LocalSourceVersionBindingStrictValidateInto(
                binding, identity, err),
           " semantic snapshot smoke: mutated binding csgRootCid validated")
    binding.csgRootCid = csgRootCid

fn AssertSameContentAndSessionIdentityContracts() =
    let sharedIdentity = MakeIdentity("semantic-snapshot/shared-content")
    let documentCid = TestCid("semantic-snapshot/shared-document")
    var err = ""

    var firstEvents: snapshot.WorkspaceSourceEventState
    var firstStore: snapshot.SemanticSnapshotStore
    let firstSessionCid = TestCid("semantic-snapshot/first-session")
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               firstSessionCid, firstEvents, err),
           err)
    assert(snapshot.SemanticSnapshotStoreInitInto(
               firstSessionCid, firstStore, err),
           err)

    var acceptedSourceVersion: int64
    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
               firstEvents, firstStore, snapshot.SemanticSourceEventOpen,
               documentCid, int64(1), acceptedSourceVersion, err),
           err)
    var openBinding: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               firstEvents, sharedIdentity, openBinding, err),
           err)
    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
               firstEvents, firstStore, snapshot.SemanticSourceEventChange,
               documentCid, int64(2), acceptedSourceVersion, err),
           err)
    var sameContentChangeBinding: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               firstEvents, sharedIdentity, sameContentChangeBinding, err),
           err)
    assert(openBinding.semanticSnapshotCid ==
               sameContentChangeBinding.semanticSnapshotCid &&
           openBinding.sourceVersion == 1 &&
           sameContentChangeBinding.sourceVersion == 2 &&
           openBinding.bindingReceiptCid !=
               sameContentChangeBinding.bindingReceiptCid,
           " semantic snapshot smoke: same-content event identity collapsed")

    var secondEvents: snapshot.WorkspaceSourceEventState
    var secondStore: snapshot.SemanticSnapshotStore
    let secondSessionCid = TestCid("semantic-snapshot/second-session")
    assert(snapshot.WorkspaceSourceEventStateInitInto(
               secondSessionCid, secondEvents, err),
           err)
    assert(snapshot.SemanticSnapshotStoreInitInto(
               secondSessionCid, secondStore, err),
           err)
    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
               secondEvents, secondStore, snapshot.SemanticSourceEventOpen,
               documentCid, int64(1), acceptedSourceVersion, err),
           err)
    var secondSessionBinding: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               secondEvents, sharedIdentity, secondSessionBinding, err),
           err)
    assert(openBinding.semanticSnapshotCid ==
               secondSessionBinding.semanticSnapshotCid &&
           openBinding.sourceVersion == secondSessionBinding.sourceVersion &&
           openBinding.workspaceSessionCid !=
               secondSessionBinding.workspaceSessionCid &&
           openBinding.bindingReceiptCid !=
               secondSessionBinding.bindingReceiptCid,
           " semantic snapshot smoke: workspace session identity collapsed")

fn main() =
    AssertSameContentAndSessionIdentityContracts()
    let sessionCid = TestCid("semantic-snapshot/session")
    let documentCid = TestCid("semantic-snapshot/main.cheng")
    var events: snapshot.WorkspaceSourceEventState
    var store: snapshot.SemanticSnapshotStore
    var err = ""
    assert(snapshot.WorkspaceSourceEventStateInitInto(sessionCid, events, err), err)
    assert(snapshot.SemanticSnapshotStoreInitInto(sessionCid, store, err), err)

    var sourceVersion: int64
    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
               events, store, snapshot.SemanticSourceEventOpen, documentCid,
               int64(10), sourceVersion, err),
           err)
    assert(sourceVersion == 1, " semantic snapshot smoke: first source version")
    assert(!snapshot.WorkspaceSourceEventAcceptInto(
                events, snapshot.SemanticSourceEventOpen, documentCid,
                int64(10), sourceVersion, err),
           " semantic snapshot smoke: duplicate open accepted")
    assert(!snapshot.WorkspaceSourceEventAcceptInto(
                events, snapshot.SemanticSourceEventChange, documentCid,
                int64(9), sourceVersion, err),
           " semantic snapshot smoke: regressing client version accepted")
    assert(!snapshot.WorkspaceSourceEventAcceptInto(
                events, snapshot.SemanticSourceEventChange, documentCid,
                int64(12), sourceVersion, err),
           " semantic snapshot smoke: skipped client version accepted")

    var identity1 = MakeIdentity("semantic-snapshot/epoch/1")
    AssertPortableIdentityFieldMutationKills(identity1)
    var binding1: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               events, identity1, binding1, err),
           err)
    AssertBindingFieldMutationKills(binding1, identity1)

    var candidate1: int32
    assert(snapshot.SemanticSnapshotStoreBeginCandidateInto(
               store, binding1, identity1, candidate1, err),
           err)
    var blockedPin: snapshot.SemanticSnapshotPin
    assert(!snapshot.SemanticSnapshotStorePinCurrentInto(store, blockedPin, err),
           " semantic snapshot smoke: building candidate leaked old query")
    let validation1 =
        MakeValidation("semantic-snapshot/epoch/1", binding1, identity1)
    var mutatedValidation =
        MakeValidation("semantic-snapshot/epoch/1", binding1, identity1)
    mutatedValidation.ownershipRootCid = TestCid("semantic-snapshot/bad-ownership")
    assert(!snapshot.SemanticSnapshotStoreValidateCandidateInto(
                store, binding1, identity1, mutatedValidation, err),
           " semantic snapshot smoke: mutated validation accepted")
    assert(store.states[candidate1] == snapshot.SemanticSnapshotStateBuilding &&
           store.publishedIndex == -1 &&
           store.validationReceiptCids[candidate1] == layout.FixedBytes32(),
           " semantic snapshot smoke: failed validation mutated candidate")
    mutatedValidation =
        MakeValidation("semantic-snapshot/epoch/1", binding1, identity1)
    mutatedValidation.queryIndexRootCid =
        TestCid("semantic-snapshot/bad-query-index-root")
    assert(!snapshot.SemanticSnapshotStoreValidateCandidateInto(
                store, binding1, identity1, mutatedValidation, err),
           " semantic snapshot smoke: mutated query index root accepted")
    assert(snapshot.SemanticSnapshotStoreValidateCandidateInto(
               store, binding1, identity1, validation1, err),
           err)
    var published1: int32
    snapshot.SemanticSnapshotStoreCommitCandidateInto(store, published1)
    assert(published1 == candidate1,
           " semantic snapshot smoke: first publish index")
    let publishedCsgRoot = store.csgRootCids[published1]
    store.csgRootCids[published1] = TestCid("semantic-snapshot/store-root-mutation")
    assert(!snapshot.SemanticSnapshotStoreStrictValidateInto(store, err),
           " semantic snapshot smoke: mutated store identity validated")
    store.csgRootCids[published1] = publishedCsgRoot
    assert(snapshot.SemanticSnapshotStoreStrictValidateInto(store, err), err)
    var oldPin: snapshot.SemanticSnapshotPin
    assert(snapshot.SemanticSnapshotStorePinCurrentInto(store, oldPin, err), err)
    assert(!snapshot.SemanticSnapshotStorePinCurrentInto(store, oldPin, err),
           " semantic snapshot smoke: active pin overwritten")
    assert(store.borrowCounts[published1] == 1,
           " semantic snapshot smoke: rejected double pin changed borrow count")

    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
               events, store, snapshot.SemanticSourceEventChange, documentCid,
               int64(11), sourceVersion, err),
           err)
    assert(sourceVersion == 2, " semantic snapshot smoke: second source version")
    assert(!snapshot.SemanticSnapshotStorePinCurrentInto(store, blockedPin, err),
           " semantic snapshot smoke: stale published snapshot queried")
    let predecessorBorrowCount = store.borrowCounts[published1]
    var predecessorPin: snapshot.SemanticSnapshotPin
    assert(!snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
                store, int64(1), predecessorPin, err) &&
           store.borrowCounts[published1] == predecessorBorrowCount &&
           !predecessorPin.active,
           " semantic snapshot smoke: wrong current predecessor pin mutated")
    assert(!snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
                store, sourceVersion, oldPin, err) &&
           store.borrowCounts[published1] == predecessorBorrowCount,
           " semantic snapshot smoke: active predecessor output mutated")
    store.publishedIndex = -1
    assert(!snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           store.borrowCounts[published1] == predecessorBorrowCount &&
           !predecessorPin.active,
           " semantic snapshot smoke: predecessor index attack pinned")
    store.publishedIndex = published1
    let predecessorSourceVersion = store.sourceVersions[published1]
    store.sourceVersions[published1] = sourceVersion
    assert(!snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           store.borrowCounts[published1] == predecessorBorrowCount &&
           !predecessorPin.active,
           " semantic snapshot smoke: predecessor version attack pinned")
    store.sourceVersions[published1] = predecessorSourceVersion
    let predecessorCsgRoot = store.csgRootCids[published1]
    store.csgRootCids[published1] =
        TestCid("semantic-snapshot/predecessor-csg-attack")
    assert(!snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           store.borrowCounts[published1] == predecessorBorrowCount &&
           !predecessorPin.active,
           " semantic snapshot smoke: predecessor CSG attack pinned")
    store.csgRootCids[published1] = predecessorCsgRoot
    let predecessorValidationCid =
        store.validationReceiptCids[published1]
    store.validationReceiptCids[published1] = layout.FixedBytes32()
    assert(!snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           store.borrowCounts[published1] == predecessorBorrowCount &&
           !predecessorPin.active,
           " semantic snapshot smoke: predecessor validation attack pinned")
    store.validationReceiptCids[published1] = predecessorValidationCid
    store.borrowCounts[published1] = 2147483647
    assert(!snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
                store, sourceVersion, predecessorPin, err) &&
           store.borrowCounts[published1] == 2147483647 &&
           !predecessorPin.active,
           " semantic snapshot smoke: predecessor borrow overflow mutated")
    store.borrowCounts[published1] = predecessorBorrowCount
    assert(snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
               store, sourceVersion, predecessorPin, err), err)
    assert(predecessorPin.sourceVersion == int64(1) &&
           predecessorPin.snapshotIndex == published1 &&
           store.borrowCounts[published1] ==
               predecessorBorrowCount + 1,
           " semantic snapshot smoke: predecessor pin identity split")

    let identity2 = MakeIdentity("semantic-snapshot/epoch/2")
    var binding2: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               events, identity2, binding2, err),
           err)
    var candidate2: int32
    assert(snapshot.SemanticSnapshotStoreBeginCandidateInto(
               store, binding2, identity2, candidate2, err),
           err)
    var candidateBlockedPredecessorPin: snapshot.SemanticSnapshotPin
    assert(!snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
                store, sourceVersion, candidateBlockedPredecessorPin, err) &&
           !candidateBlockedPredecessorPin.active &&
           store.borrowCounts[published1] ==
               predecessorBorrowCount + 1,
           " semantic snapshot smoke: candidate-time predecessor pin mutated")

    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
               events, store, snapshot.SemanticSourceEventChange, documentCid,
               int64(12), sourceVersion, err),
           err)
    assert(store.states[candidate2] == snapshot.SemanticSnapshotStateCancelled,
           " semantic snapshot smoke: superseded candidate not cancelled")

    let identity3 = MakeIdentity("semantic-snapshot/epoch/3")
    var binding3: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               events, identity3, binding3, err),
           err)
    var candidate3: int32
    assert(snapshot.SemanticSnapshotStoreBeginCandidateInto(
               store, binding3, identity3, candidate3, err),
           err)
    var failure3: snapshot.SemanticSnapshotFailureReceipt
    assert(snapshot.SemanticSnapshotFailureReceiptMakeInto(
               binding3, identity3, 7,
               TestCid("semantic-snapshot/epoch/3/diagnostic"),
               failure3, err),
           err)
    var badFailure: snapshot.SemanticSnapshotFailureReceipt
    assert(snapshot.SemanticSnapshotFailureReceiptMakeInto(
               binding3, identity3, 7,
               TestCid("semantic-snapshot/epoch/3/diagnostic"),
               badFailure, err),
           err)
    badFailure.reasonCode = 8
    var failureStage: snapshot.SemanticSnapshotCandidateFailureStage
    assert(!snapshot.SemanticSnapshotStoreStageCandidateFailureInto(
                store, binding3, identity3, badFailure, failureStage, err),
           " semantic snapshot smoke: mutated failure receipt accepted")
    assert(store.states[candidate3] == snapshot.SemanticSnapshotStateBuilding &&
           store.failureReceiptCids[candidate3] == layout.FixedBytes32() &&
           !failureStage.active,
           " semantic snapshot smoke: failed rejection stage mutated candidate")
    assert(snapshot.SemanticSnapshotStoreStageCandidateFailureInto(
               store, binding3, identity3, failure3, failureStage, err),
           err)
    assert(snapshot.SemanticSnapshotStoreStrictValidateInto(store, err), err)
    var rejected3: int32
    snapshot.SemanticSnapshotStoreCommitRejectedCandidateInto(
        store, failureStage, rejected3)
    assert(rejected3 == candidate3,
           " semantic snapshot smoke: rejected candidate index")
    assert(store.states[candidate3] == snapshot.SemanticSnapshotStateRejected,
           " semantic snapshot smoke: candidate not rejected")
    assert(!snapshot.SemanticSnapshotStorePinCurrentInto(store, blockedPin, err),
           " semantic snapshot smoke: rejected version fell back to old snapshot")
    assert(snapshot.SemanticSnapshotStoreReleasePinInto(
               store, predecessorPin, err), err)
    assert(store.states[published1] ==
               snapshot.SemanticSnapshotStatePublished &&
           store.borrowCounts[published1] == predecessorBorrowCount,
           " semantic snapshot smoke: published predecessor release drift")
    var gapPredecessorPin: snapshot.SemanticSnapshotPin
    assert(snapshot.SemanticSnapshotStorePinPublishedPredecessorInto(
               store, sourceVersion, gapPredecessorPin, err), err)
    assert(gapPredecessorPin.sourceVersion == int64(1) &&
           sourceVersion == int64(3),
           " semantic snapshot smoke: cancelled/rejected gap predecessor split")

    var candidateReplacement: int32
    assert(snapshot.SemanticSnapshotStoreBeginCandidateInto(
               store, binding3, identity3,
               candidateReplacement, err),
           err)
    let validation3 = MakeValidation(
        "semantic-snapshot/epoch/3/replacement", binding3, identity3)
    assert(snapshot.SemanticSnapshotStoreValidateCandidateInto(
               store, binding3, identity3, validation3, err),
           err)
    var published3: int32
    snapshot.SemanticSnapshotStoreCommitCandidateInto(store, published3)
    assert(store.states[published1] == snapshot.SemanticSnapshotStateRetired,
           " semantic snapshot smoke: borrowed old snapshot not retired")
    assert(snapshot.SemanticSnapshotStoreReleasePinInto(
               store, gapPredecessorPin, err), err)
    assert(store.states[published1] ==
               snapshot.SemanticSnapshotStateRetired &&
           store.borrowCounts[published1] == 1,
           " semantic snapshot smoke: predecessor release skipped active borrow")
    assert(snapshot.SemanticSnapshotStoreReleasePinInto(store, oldPin, err), err)
    assert(store.states[published1] == snapshot.SemanticSnapshotStateReleased,
           " semantic snapshot smoke: returned old borrow not released")
    assert(!snapshot.SemanticSnapshotStoreReleasePinInto(store, oldPin, err),
           " semantic snapshot smoke: double pin release accepted")

    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
               events, store, snapshot.SemanticSourceEventClose, documentCid,
               int64(-1), sourceVersion, err),
           err)
    assert(!snapshot.SemanticSnapshotAcceptSourceEventInto(
                events, store, snapshot.SemanticSourceEventClose, documentCid,
                int64(-1), sourceVersion, err),
           " semantic snapshot smoke: duplicate close accepted")
    let closedSourceVersion = events.lastAcceptedSourceVersion
    assert(!snapshot.SemanticSnapshotAcceptSourceEventInto(
                events, store, snapshot.SemanticSourceEventOpen, documentCid,
                int64(12), sourceVersion, err),
           " semantic snapshot smoke: stale reopen version accepted")
    assert(events.lastAcceptedSourceVersion == closedSourceVersion &&
           store.currentSourceVersion == closedSourceVersion,
           " semantic snapshot smoke: stale reopen mutated state")
    assert(snapshot.SemanticSnapshotAcceptSourceEventInto(
               events, store, snapshot.SemanticSourceEventOpen, documentCid,
               int64(13), sourceVersion, err),
           err)
    assert(sourceVersion == closedSourceVersion + int64(1),
           " semantic snapshot smoke: exact reopen source version drift")
    assert(snapshot.SemanticSnapshotStoreStrictValidateInto(store, err), err)
    os.WriteLine(os.Get_stdout(), "semantic_snapshot_core_smoke: ok")
