import std/os
import std/result
import cheng/core/analysis/managed_lvalue_replace as replace
import cheng/core/ir/body_ir_access as bodyaccess
import cheng/core/ir/core_types as coreir
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

fn fixedCid(text: str): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(text)
    if IsErr(parsed):
        panic(Error(parsed))
    return Value(parsed)

fn typeArenaCid(): layout.FixedBytes32 =
    return fixedCid(
        "3131313131313131313131313131313131313131313131313131313131313131")

fn producerCid(): layout.FixedBytes32 =
    return fixedCid(
        "4242424242424242424242424242424242424242424242424242424242424242")

fn mutatedRuntimeCid(): layout.FixedBytes32 =
    return fixedCid(
        "6464646464646464646464646464646464646464646464646464646464646464")

fn planRuntimeCid(replaceMode: int32,
                  targetKind: int32): layout.FixedBytes32 =
    if replaceMode == replace.ManagedLvalueReplaceSelfAliasNoOp:
        return layout.FixedBytes32()
    var targetPassKind = coreir.BodyCallPassBorrowAddressTag
    if targetKind == replace.ManagedLvalueTargetGlobal:
        targetPassKind = coreir.BodyCallPassGlobalAddressTag
    if replaceMode == replace.ManagedLvalueReplaceMove:
        return replace.ManagedLvalueReplaceRuntimeSemanticCid(
            typeArenaCid(),
            7,
            coreir.ManagedStoreStrMoveTag,
            24,
            8,
            targetPassKind,
            8,
            coreir.BodyCallPassParamAddressTag,
            8)
    return replace.ManagedLvalueReplaceRuntimeSemanticCid(
        typeArenaCid(),
        7,
        coreir.ManagedStoreStrRetainTag,
        24,
        8,
        targetPassKind,
        8,
        coreir.BodyCallPassParamAddressTag,
        8)

fn bindManagedStrTypeFact(body: var coreir.BodyIR) =
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body,
                    typeArenaCid(),
                    7,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarStr),
                    -1,
                    0,
                    24,
                    8),
                "managed lvalue replace smoke: exact str TypeId fact")

fn addManagedSlot(body: var coreir.BodyIR,
                  name: str,
                  typeKind: int32,
                  typeId: int32,
                  sizeBytes: int32,
                  alignBytes: int32,
                  placeKind: int32,
                  parentSlot: int32): int32 =
    var slot: coreir.LocalSlot
    slot.id = body.localSlots.len
    slot.name = name
    slot.typeKind = typeKind
    slot.stackOffset = slot.id * 64
    slot.sizeBytes = sizeBytes
    slot.alignBytes = alignBytes
    coreir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = placeKind
    slot.auxValue = parentSlot
    let slotId = slot.id
    add(body.localSlots, slot)
    smokeAssert(coreir.BodyIRBindLocalSlotTypeArenaProof(
                    body,
                    slotId,
                    typeArenaCid(),
                    typeId,
                    coreir.BodyManagedStorageManagedTag),
                "managed lvalue replace smoke: slot proof bind")
    return slotId

fn bindBorrowAddressOffset(
        body: var coreir.BodyIR,
        slotId: int32,
        ownerSlotId: int32,
        byteOffset: int32) =
    smokeAssert(slotId >= 0 &&
                slotId < body.localSlots.len &&
                ownerSlotId >= 0 &&
                ownerSlotId < body.localSlots.len &&
                body.localSlots[slotId].placeKind ==
                    coreir.BodyPlaceBorrowAddressTag &&
                body.localSlots[slotId].auxValue == ownerSlotId &&
                byteOffset >= 0 &&
                byteOffset <=
                    body.localSlots[ownerSlotId].sizeBytes -
                    body.localSlots[slotId].sizeBytes,
                "managed lvalue replace smoke: borrow address range")
    body.localSlots[slotId].stackOffset =
        body.localSlots[ownerSlotId].stackOffset + byteOffset

fn appendManagedDefinition(
        body: var coreir.BodyIR,
        slot: int32,
        semanticRow: int32,
        ownership: coreir.OwnershipKind,
        borrowOwnerDefinitionRow: int32): int32 =
    var borrowOwnerSemanticRow: int32 = -1
    var borrowOwnerDomain =
        coreir.BodyDefinitionDomainInvalidTag
    if ownership == coreir.OwnBorrowShared:
        smokeAssert(
            borrowOwnerDefinitionRow >= 0 &&
            borrowOwnerDefinitionRow < body.ops.len &&
            body.ops[borrowOwnerDefinitionRow].valueDefOwnership ==
                coreir.OwnMove,
            "managed lvalue replace smoke: borrowed owner missing")
        borrowOwnerSemanticRow =
            body.ops[borrowOwnerDefinitionRow].valueDefSemanticRow
        borrowOwnerDomain =
            coreir.BodyDefinitionDomainBodyOpTag
    else:
        smokeAssert(borrowOwnerDefinitionRow == -1,
                    "managed lvalue replace smoke: owned borrow owner")
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "fixture_managed_definition"
    call.resultSlot = slot
    call.resultPassKind = coreir.BodyCallPassSretResultTag
    call.resultOwnership = ownership
    call.resultExprNodeIndex = semanticRow
    call.resultValueDefinitionRow = semanticRow
    call.resultBorrowOwnerValueDefinitionRow =
        borrowOwnerSemanticRow
    call.resultBorrowOwnerDefinitionDomain =
        borrowOwnerDomain
    call.resultBorrowOwnerDefinitionRow =
        borrowOwnerDefinitionRow
    call.resultDefinitionOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    call.resultDefinitionOriginId = semanticRow
    let callOrdinal = body.callSequence.len
    add(body.callSequence, call)

    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    op.target = slot
    op.valueDefSlot = slot
    op.valueDefExprNodeIndex = semanticRow
    op.valueDefSemanticRow = semanticRow
    op.valueDefOwnership = ownership
    op.valueDefBorrowOwnerSemanticRow =
        borrowOwnerSemanticRow
    op.valueDefBorrowOwnerDefinitionDomain =
        borrowOwnerDomain
    op.valueDefBorrowOwnerDefinitionRow =
        borrowOwnerDefinitionRow
    op.valueDefOriginKind =
        coreir.BodyDefinitionOriginTypedExprTag
    op.valueDefOriginId = semanticRow
    add(op.operands, callOrdinal)
    return coreir.BodyIRAppendOp(body, op)

fn appendManagedReplaceCall(
        body: var coreir.BodyIR,
        targetSlot: int32,
        sourceSlot: int32,
        sourceDefinition: int32,
        managedStoreKind: int32,
        targetPassKind: int32): int32 =
    let consumesSource =
        managedStoreKind == coreir.ManagedStoreStrMoveTag ||
        managedStoreKind == coreir.ManagedStoreSeqMoveTag
    let consumeActionRow = body.ops.len
    var call: coreir.CallOp
    coreir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "fixture_atomic_managed_replace"
    call.managedStoreKind = managedStoreKind
    if targetPassKind == coreir.BodyCallPassGlobalAddressTag:
        add(call.argSlots, targetSlot)
    else:
        add(call.argSlots, coreir.CallArgSlotAddress(targetSlot))
    add(call.argPassKinds, targetPassKind)
    add(call.argAbiSizes, 8)
    add(call.argSlots, coreir.CallArgSlotAddress(sourceSlot))
    add(call.argPassKinds, coreir.BodyCallPassParamAddressTag)
    add(call.argAbiSizes, 8)
    call.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    call.sourceDefinitionRow = sourceDefinition
    if consumesSource:
        call.consumeActionRow = consumeActionRow
    let callOrdinal = body.callSequence.len
    add(body.callSequence, call)

    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpCallTag
    add(op.operands, callOrdinal)
    op.sourceDefinitionDomain =
        coreir.BodyDefinitionDomainBodyOpTag
    op.sourceDefinitionRow = sourceDefinition
    if consumesSource:
        op.consumeActionRow = consumeActionRow
        body.ops[sourceDefinition].valueDefConsumeOpIndexPlusOne =
            body.ops.len + 1
        body.ops[sourceDefinition].consumeActionRow =
            consumeActionRow
    return coreir.BodyIRAppendOp(body, op)

fn appendRawGlobalManagedStore(
        body: var coreir.BodyIR,
        targetSlot: int32,
        sourceSlot: int32) =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpGlobalStoreTag
    op.target = sourceSlot
    add(op.operands, targetSlot)
    let _ = coreir.BodyIRAppendOp(body, op)

fn appendRawFieldManagedStore(
        body: var coreir.BodyIR,
        targetSlot: int32,
        sourceSlot: int32) =
    var op: coreir.BodyOp
    coreir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = coreir.BodyOpFieldStoreTag
    add(op.operands, targetSlot)
    add(op.operands, sourceSlot)
    let _ = coreir.BodyIRAppendOp(body, op)

fn freezeEntryOwnership(body: var coreir.BodyIR) =
    var ownershipKinds: int32[]
    for _ in 0..<body.localSlots.len:
        add(ownershipKinds, int32(coreir.OwnInvalid))
    coreir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, ownershipKinds)

fn requireAccessValid(body: var coreir.BodyIR) =
    var access = bodyaccess.BodyIrAccessDecode(body)
    if bodyaccess.BodyIrAccessTableIsValid(access):
        return
    echo(Fmt"managed lvalue replace access error code={access.errorCode} site={access.errorSiteKind}:{access.errorSiteIndex} detail={access.errorDetail} facts={access.facts.len}")
    if access.errorSiteKind == bodyaccess.BodyIrAccessSiteOp &&
       access.errorSiteIndex >= 0 &&
       access.errorSiteIndex < body.ops.len:
        let op = body.ops[access.errorSiteIndex]
        echo(Fmt"managed lvalue replace access op kind={op.kind} target={op.target} value_slot={op.valueDefSlot} expr={op.valueDefExprNodeIndex} semantic={op.valueDefSemanticRow} ownership={int32(op.valueDefOwnership)} origin={op.valueDefOriginKind}:{op.valueDefOriginId} source={op.sourceDefinitionDomain}:{op.sourceDefinitionRow} consume={op.valueDefConsumeOpIndexPlusOne}:{op.consumeActionRow} operands={op.operands.len}")
        if op.sourceDefinitionDomain ==
               coreir.BodyDefinitionDomainBodyOpTag &&
           op.sourceDefinitionRow >= 0 &&
           op.sourceDefinitionRow < body.ops.len:
            let sourceOp = body.ops[op.sourceDefinitionRow]
            echo(Fmt"managed lvalue replace access source op row={op.sourceDefinitionRow} slot={sourceOp.valueDefSlot} ownership={int32(sourceOp.valueDefOwnership)} consume={sourceOp.valueDefConsumeOpIndexPlusOne}:{sourceOp.consumeActionRow}")
        if op.operands.len == 1 &&
           op.operands[0] >= 0 &&
           op.operands[0] < body.callSequence.len:
            let call = body.callSequence[op.operands[0]]
            echo(Fmt"managed lvalue replace access call ordinal={op.operands[0]} result={call.resultSlot} pass={call.resultPassKind} ownership={int32(call.resultOwnership)} expr={call.resultExprNodeIndex} semantic={call.resultValueDefinitionRow} origin={call.resultDefinitionOriginKind}:{call.resultDefinitionOriginId} source={call.sourceDefinitionDomain}:{call.sourceDefinitionRow} consume={call.consumeActionRow} managed_store={call.managedStoreKind}")
            if op.sourceDefinitionDomain ==
                   coreir.BodyDefinitionDomainBodyOpTag &&
               op.sourceDefinitionRow >= 0 &&
               op.sourceDefinitionRow < body.ops.len:
                let sourceOp = body.ops[op.sourceDefinitionRow]
                echo(Fmt"managed lvalue replace access retain predicates kind={(call.managedStoreKind == coreir.ManagedStoreStrRetainTag || call.managedStoreKind == coreir.ManagedStoreSeqRetainTag)} ownership={int32(sourceOp.valueDefOwnership) == int32(coreir.OwnBorrowShared)} call_consume={call.consumeActionRow == -1} op_consume={op.consumeActionRow == -1}")
            for argIndex in 0..<call.argSlots.len:
                let argSlot = call.argSlots[argIndex]
                echo(Fmt"managed lvalue replace access arg ordinal={argIndex} raw={argSlot} address={coreir.CallArgSlotIsAddress(argSlot)} decoded={coreir.CallArgSlotAddressId(argSlot)} pass={call.argPassKinds[argIndex]}")
    panic("managed lvalue replace smoke: BodyIR access invalid")

fn finishBody(body: var coreir.BodyIR,
              functionRow: int32,
              runtimeFunctionRow: int32,
              runtimeCallOrdinal: int32,
              returnSlot: int32,
              returnDefinition: int32) =
    freezeEntryOwnership(body)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    if returnSlot >= 0 || returnDefinition >= 0:
        smokeAssert(returnSlot >= 0 &&
                    returnSlot < body.localSlots.len &&
                    returnDefinition >= 0 &&
                    returnDefinition < body.ops.len,
                    "managed lvalue replace smoke: return edge")
        term.resultSlot = returnSlot
        term.sourceDefinitionDomain =
            coreir.BodyDefinitionDomainBodyOpTag
        term.sourceDefinitionRow = returnDefinition
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(
        body, 0, body.ops.len, termIndex)
    coreir.BodyIRControlFlowBegin(body, functionRow)
    coreir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    var successorBlockIds: int32[]
    var edgeKinds: int32[]
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successorBlockIds, edgeKinds)
    for callOrdinal in 0..<body.callSequence.len:
        if callOrdinal == runtimeCallOrdinal:
            smokeAssert(runtimeFunctionRow == -1,
                "managed lvalue replace smoke: runtime has no Cheng function row")
            let call = body.callSequence[callOrdinal]
            smokeAssert(call.argSlots.len == 2 &&
                        call.argPassKinds.len == 2 &&
                        call.argAbiSizes.len == 2,
                "managed lvalue replace smoke: runtime ABI tuple")
            var targetSlot = call.argSlots[0]
            if call.argPassKinds[0] !=
                   coreir.BodyCallPassGlobalAddressTag:
                targetSlot = coreir.CallArgSlotAddressId(
                    call.argSlots[0])
            var sourceSlot = call.argSlots[1]
            if call.argPassKinds[1] !=
                   coreir.BodyCallPassGlobalAddressTag:
                sourceSlot = coreir.CallArgSlotAddressId(
                    call.argSlots[1])
            smokeAssert(targetSlot >= 0 &&
                        targetSlot < body.localSlots.len &&
                        sourceSlot >= 0 &&
                        sourceSlot < body.localSlots.len,
                "managed lvalue replace smoke: runtime slot tuple")
            let target = body.localSlots[targetSlot]
            coreir.BodyIRControlFlowBindCallTarget(
                body,
                callOrdinal,
                coreir.BodyCallTargetDomainRuntimeIntrinsicTag,
                call.managedStoreKind,
                replace.ManagedLvalueReplaceRuntimeSemanticCid(
                    body.typeArenaArtifactCid,
                    target.typeArenaTypeId,
                    call.managedStoreKind,
                    target.sizeBytes,
                    target.alignBytes,
                    call.argPassKinds[0],
                    call.argAbiSizes[0],
                    call.argPassKinds[1],
                    call.argAbiSizes[1]))
        else:
            coreir.BodyIRControlFlowBindCallTarget(
                body,
                callOrdinal,
                coreir.BodyCallTargetDomainFunctionTag,
                91,
                producerCid())
    coreir.BodyIRControlFlowSeal(body)

fn appendPlanRow(
        plan: var replace.ManagedLvalueReplacePlan,
        targetKind: int32,
        replaceMode: int32,
        targetLvalueRow: int32,
        sourceLvalueRow: int32,
        rootStorageRow: int32,
        rootDefinitionDomain: int32,
        rootDefinitionRow: int32,
        targetSlot: int32,
        sourceDefinition: int32,
        sourceSlot: int32,
        semanticRow: int32,
        replaceOp: int32,
        consumeActionRow: int32,
        runtimeFunctionRow: int32,
        pathKinds: var int32[],
        pathParentDefinitionDomains: var int32[],
        pathParentDefinitionRows: var int32[],
        pathMemberRows: var int32[],
        pathResultTypeIds: var int32[],
        pathByteOffsets: var int32[],
        pathByteWidths: var int32[]) =
    let runtimeIdentity = planRuntimeCid(replaceMode, targetKind)
    let _ = replace.ManagedLvalueReplacePlanAppendExact(
        plan,
        targetKind,
        replaceMode,
        targetLvalueRow,
        sourceLvalueRow,
        rootStorageRow,
        rootDefinitionDomain,
        rootDefinitionRow,
        targetSlot,
        7,
        coreir.BodyDefinitionDomainBodyOpTag,
        sourceDefinition,
        sourceSlot,
        semanticRow,
        replaceOp,
        consumeActionRow,
        runtimeFunctionRow,
        runtimeIdentity,
        pathKinds,
        pathParentDefinitionDomains,
        pathParentDefinitionRows,
        pathMemberRows,
        pathResultTypeIds,
        pathByteOffsets,
        pathByteWidths)

fn runProductionGlobalMove() =
    var body = coreir.BodyIRNew()
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(
                    body, typeArenaCid()),
                "managed lvalue replace production smoke: body CID bind")
    coreir.BodyIRControlFlowBegin(body, 45)
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body,
                    typeArenaCid(),
                    11,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarInt32),
                    -1,
                    0,
                    4,
                    4),
                "managed lvalue replace production smoke: high TypeId fact")
    smokeAssert(coreir.BodyIRBindCanonicalTypeFact(
                    body,
                    typeArenaCid(),
                    7,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarStr),
                    -1,
                    0,
                    24,
                    8),
                "managed lvalue replace production smoke: TypeId fact")
    smokeAssert(body.typeFactTypeIds.len == 2 &&
                body.typeFactTypeIds[0] == 7 &&
                body.typeFactTypeIds[1] == 11 &&
                !coreir.BodyIRBindCanonicalTypeFact(
                    body,
                    typeArenaCid(),
                    7,
                    Int32(typearena.TypedExprStructuralTypeScalar),
                    Int32(typearena.TypedExprStructuralScalarStr),
                    -1,
                    0,
                    16,
                    8),
                "managed lvalue replace production smoke: sorted exact facts")
    let target = addManagedSlot(
        body, "production_global", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceGlobalAddressTag, 0)
    let source = addManagedSlot(
        body, "production_source", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceStackValueTag, 0)
    let sourceDefinition = appendManagedDefinition(
        body, source, 1001, coreir.OwnMove, -1)
    coreir.BodyIRControlFlowBindCallTarget(
        body, 0, coreir.BodyCallTargetDomainFunctionTag,
        91, producerCid())
    var callOrdinal: int32 = 1
    let action =
        replace.ManagedLvalueReplaceProductionBuildGlobalAction(
            body, target, source, 1001)
    smokeAssert(
        replace.ManagedLvalueReplaceProductionAppendGlobal(
            body, action, callOrdinal),
        "managed lvalue replace production smoke: append")
    smokeAssert(callOrdinal == 2 &&
                body.callTargetDomainKinds[1] ==
                    coreir.BodyCallTargetDomainRuntimeIntrinsicTag &&
                body.callTargetRows[1] ==
                    coreir.ManagedStoreStrMoveTag &&
                layout.FixedBytes32Equal(
                    body.callTargetInterfaceCids[1],
                    replace.ManagedLvalueReplaceRuntimeSemanticCid(
                        typeArenaCid(),
                        7,
                        coreir.ManagedStoreStrMoveTag,
                        24,
                        8,
                        coreir.BodyCallPassGlobalAddressTag,
                        8,
                    coreir.BodyCallPassParamAddressTag,
                    8)),
                "managed lvalue replace production smoke: runtime identity")
    freezeEntryOwnership(body)
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    let termIndex = coreir.BodyIRAppendTerm(body, term)
    let _ = coreir.BodyIRAppendBlock(
        body, 0, body.ops.len, termIndex)
    coreir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    var successorBlockIds: int32[]
    var edgeKinds: int32[]
    coreir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successorBlockIds, edgeKinds)
    coreir.BodyIRControlFlowSeal(body)
    requireAccessValid(body)
    let report =
        replace.ManagedLvalueReplaceProductionVerify(body)
    let sourceConsumeOpIndexPlusOne =
        body.ops[sourceDefinition].valueDefConsumeOpIndexPlusOne
    smokeAssert(report.valid &&
                report.replaceCount == 1 &&
                report.moveCount == 1 &&
                report.sourceConsumeCount == 1 &&
                report.rawManagedStoreCount == 0 &&
                sourceConsumeOpIndexPlusOne == 2,
                "managed lvalue replace production smoke: receipt")

@borrows
fn runGlobalMove(mutation: str) =
    var body = coreir.BodyIRNew()
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(
                    body, typeArenaCid()),
                "managed lvalue replace smoke: body CID bind")
    bindManagedStrTypeFact(body)
    let target = addManagedSlot(
        body, "global", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceGlobalAddressTag, 0)
    let source = addManagedSlot(
        body, "source", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceStackValueTag, 0)
    let sourceDefinition = appendManagedDefinition(
        body, source, 501, coreir.OwnMove, -1)
    let replaceOp = appendManagedReplaceCall(
        body,
        target,
        source,
        sourceDefinition,
        coreir.ManagedStoreStrMoveTag,
        coreir.BodyCallPassGlobalAddressTag)
    if mutation == "raw-store":
        appendRawGlobalManagedStore(body, target, source)
    finishBody(body, 41, -1, 1, -1, -1)

    var plan: replace.ManagedLvalueReplacePlan
    replace.ManagedLvalueReplacePlanPrepare(
        plan, 41, typeArenaCid())
    var pathKinds: int32[]
    var pathParentDefinitionDomains: int32[]
    var pathParentDefinitionRows: int32[]
    var pathMemberRows: int32[]
    var pathResultTypeIds: int32[]
    var pathByteOffsets: int32[]
    var pathByteWidths: int32[]
    appendPlanRow(
        plan,
        replace.ManagedLvalueTargetGlobal,
        replace.ManagedLvalueReplaceMove,
        1001,
        2001,
        target,
        coreir.BodyDefinitionDomainInvalidTag,
        -1,
        target,
        sourceDefinition,
        source,
        501,
        replaceOp,
        replaceOp,
        -1,
        pathKinds,
        pathParentDefinitionDomains,
        pathParentDefinitionRows,
        pathMemberRows,
        pathResultTypeIds,
        pathByteOffsets,
        pathByteWidths)
    if mutation == "duplicate-receipt":
        appendPlanRow(
            plan,
            replace.ManagedLvalueTargetGlobal,
            replace.ManagedLvalueReplaceMove,
            1002,
            2001,
            target,
            coreir.BodyDefinitionDomainInvalidTag,
            -1,
            target,
            sourceDefinition,
            source,
            501,
            replaceOp,
            replaceOp,
            -1,
            pathKinds,
            pathParentDefinitionDomains,
            pathParentDefinitionRows,
            pathMemberRows,
            pathResultTypeIds,
            pathByteOffsets,
            pathByteWidths)
    replace.ManagedLvalueReplacePlanSeal(plan)
    if mutation == "fingerprint":
        plan.targetTypeIds[0] = 8
    elif mutation == "consume":
        body.ops[sourceDefinition].valueDefConsumeOpIndexPlusOne = 0
    elif mutation == "action-row":
        body.callSequence[1].consumeActionRow = replaceOp + 1
    elif mutation == "runtime-cid":
        body.callTargetInterfaceCids[1] = mutatedRuntimeCid()
    elif mutation == "abi-size":
        body.callSequence[1].argAbiSizes[1] = 4
    elif mutation == "type-layout":
        body.localSlots[target].sizeBytes = 16
        body.localSlots[source].sizeBytes = 16
    elif mutation == "source-pass":
        body.callSequence[1].argSlots[1] = source
        body.callSequence[1].argPassKinds[1] =
            coreir.BodyCallPassStackValueTag
    elif mutation == "target-pass":
        body.callSequence[1].argSlots[0] =
            coreir.CallArgSlotAddress(target)
        body.callSequence[1].argPassKinds[0] =
            coreir.BodyCallPassBorrowAddressTag
    elif mutation == "op-value-def":
        body.ops[replaceOp].valueDefSlot = source
    if mutation == "":
        requireAccessValid(body)
    let report = replace.ManagedLvalueReplaceAdmit(body, plan)
    smokeAssert(report.valid &&
                report.replaceCount == 1 &&
                report.moveCount == 1 &&
                report.sourceConsumeCount == 1 &&
                report.oldCaptureBeforeNewCount == 1 &&
                report.oldDropReleaseCount == 1 &&
                report.rawManagedStoreCount == 0,
                "managed lvalue replace smoke: global move receipt")

@borrows
fn runFieldBorrowLift(mutation: str) =
    var body = coreir.BodyIRNew()
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(
                    body, typeArenaCid()),
                "managed lvalue replace smoke: body CID bind")
    bindManagedStrTypeFact(body)
    let parent = addManagedSlot(
        body, "owner", coreir.LocalAggregateTag, 11, 64, 8,
        coreir.BodyPlaceStackValueTag, 0)
    let parentDefinition = appendManagedDefinition(
        body, parent, 601, coreir.OwnMove, -1)
    let target = addManagedSlot(
        body, "owner.field", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceBorrowAddressTag, parent)
    bindBorrowAddressOffset(body, target, parent, 8)
    let source = addManagedSlot(
        body, "borrowed", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceStackValueTag, 0)
    let sourceDefinition = appendManagedDefinition(
        body, source, 602, coreir.OwnBorrowShared,
        parentDefinition)
    let replaceOp = appendManagedReplaceCall(
        body,
        target,
        source,
        sourceDefinition,
        coreir.ManagedStoreStrRetainTag,
        coreir.BodyCallPassBorrowAddressTag)
    if mutation == "raw-field-store":
        appendRawFieldManagedStore(body, target, source)
    finishBody(
        body, 42, -1, 2, parent, parentDefinition)

    var plan: replace.ManagedLvalueReplacePlan
    replace.ManagedLvalueReplacePlanPrepare(
        plan, 42, typeArenaCid())
    var pathKinds: int32[]
    var pathParentDefinitionDomains: int32[]
    var pathParentDefinitionRows: int32[]
    var pathMemberRows: int32[]
    var pathResultTypeIds: int32[]
    var pathByteOffsets: int32[]
    var pathByteWidths: int32[]
    add(pathKinds, replace.ManagedLvaluePathField)
    var pathParentDefinition = parentDefinition
    if mutation == "projection-root":
        pathParentDefinition = sourceDefinition
    add(pathParentDefinitionDomains,
        coreir.BodyDefinitionDomainBodyOpTag)
    add(pathParentDefinitionRows, pathParentDefinition)
    add(pathMemberRows, 17)
    add(pathResultTypeIds, 7)
    var pathByteOffset: int32 = 8
    if mutation == "layout-range":
        pathByteOffset = 48
    add(pathByteOffsets, pathByteOffset)
    add(pathByteWidths, 24)
    appendPlanRow(
        plan,
        replace.ManagedLvalueTargetField,
        replace.ManagedLvalueReplaceBorrowLift,
        1002,
        2002,
        -1,
        coreir.BodyDefinitionDomainBodyOpTag,
        parentDefinition,
        target,
        sourceDefinition,
        source,
        602,
        replaceOp,
        -1,
        -1,
        pathKinds,
        pathParentDefinitionDomains,
        pathParentDefinitionRows,
        pathMemberRows,
        pathResultTypeIds,
        pathByteOffsets,
        pathByteWidths)
    if mutation == "orphan-path":
        plan.pathStarts[0] = 1
    replace.ManagedLvalueReplacePlanSeal(plan)
    if mutation == "borrow-consume":
        body.ops[sourceDefinition].valueDefConsumeOpIndexPlusOne =
            replaceOp + 1
    if mutation == "":
        requireAccessValid(body)
    let report = replace.ManagedLvalueReplaceAdmit(body, plan)
    smokeAssert(report.valid &&
                report.replaceCount == 1 &&
                report.borrowLiftCount == 1 &&
                report.sourceConsumeCount == 0 &&
                report.oldCaptureBeforeNewCount == 1 &&
                report.oldDropReleaseCount == 1,
                "managed lvalue replace smoke: field borrow lift receipt")

fn runIndexedMove() =
    var body = coreir.BodyIRNew()
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(
                    body, typeArenaCid()),
                "managed lvalue replace smoke: body CID bind")
    bindManagedStrTypeFact(body)
    let parent = addManagedSlot(
        body, "items", coreir.LocalAggregateTag, 12, 64, 8,
        coreir.BodyPlaceStackValueTag, 0)
    let parentDefinition = appendManagedDefinition(
        body, parent, 801, coreir.OwnMove, -1)
    let target = addManagedSlot(
        body, "items[index]", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceBorrowAddressTag, parent)
    bindBorrowAddressOffset(body, target, parent, 0)
    let source = addManagedSlot(
        body, "next", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceStackValueTag, 0)
    let sourceDefinition = appendManagedDefinition(
        body, source, 802, coreir.OwnMove, -1)
    let replaceOp = appendManagedReplaceCall(
        body,
        target,
        source,
        sourceDefinition,
        coreir.ManagedStoreStrMoveTag,
        coreir.BodyCallPassBorrowAddressTag)
    finishBody(
        body, 43, -1, 2, parent, parentDefinition)

    var plan: replace.ManagedLvalueReplacePlan
    replace.ManagedLvalueReplacePlanPrepare(
        plan, 43, typeArenaCid())
    var pathKinds: int32[]
    var pathParentDefinitionDomains: int32[]
    var pathParentDefinitionRows: int32[]
    var pathMemberRows: int32[]
    var pathResultTypeIds: int32[]
    var pathByteOffsets: int32[]
    var pathByteWidths: int32[]
    add(pathKinds, replace.ManagedLvaluePathIndexed)
    add(pathParentDefinitionDomains,
        coreir.BodyDefinitionDomainBodyOpTag)
    add(pathParentDefinitionRows, parentDefinition)
    add(pathMemberRows, 23)
    add(pathResultTypeIds, 7)
    add(pathByteOffsets, 0)
    add(pathByteWidths, 24)
    appendPlanRow(
        plan,
        replace.ManagedLvalueTargetIndexed,
        replace.ManagedLvalueReplaceMove,
        1003,
        2003,
        -1,
        coreir.BodyDefinitionDomainBodyOpTag,
        parentDefinition,
        target,
        sourceDefinition,
        source,
        802,
        replaceOp,
        replaceOp,
        -1,
        pathKinds,
        pathParentDefinitionDomains,
        pathParentDefinitionRows,
        pathMemberRows,
        pathResultTypeIds,
        pathByteOffsets,
        pathByteWidths)
    replace.ManagedLvalueReplacePlanSeal(plan)
    requireAccessValid(body)
    let report = replace.ManagedLvalueReplaceAdmit(body, plan)
    smokeAssert(report.valid &&
                report.replaceCount == 1 &&
                report.moveCount == 1,
                "managed lvalue replace smoke: indexed move receipt")

@borrows
fn runSelfAliasNoOp(mutation: str) =
    var body = coreir.BodyIRNew()
    smokeAssert(coreir.BodyIRBindTypeArenaArtifactCid(
                    body, typeArenaCid()),
                "managed lvalue replace smoke: body CID bind")
    bindManagedStrTypeFact(body)
    let target = addManagedSlot(
        body, "self_global", coreir.LocalStrTag, 7, 24, 8,
        coreir.BodyPlaceGlobalAddressTag, 0)
    let sourceDefinition = appendManagedDefinition(
        body, target, 901, coreir.OwnMove, -1)
    finishBody(
        body, 44, -1, -1, target, sourceDefinition)

    var plan: replace.ManagedLvalueReplacePlan
    replace.ManagedLvalueReplacePlanPrepare(
        plan, 44, typeArenaCid())
    var pathKinds: int32[]
    var pathParentDefinitionDomains: int32[]
    var pathParentDefinitionRows: int32[]
    var pathMemberRows: int32[]
    var pathResultTypeIds: int32[]
    var pathByteOffsets: int32[]
    var pathByteWidths: int32[]
    var sourceSlot = target
    if mutation == "self-slot":
        sourceSlot = target + 1
    appendPlanRow(
        plan,
        replace.ManagedLvalueTargetGlobal,
        replace.ManagedLvalueReplaceSelfAliasNoOp,
        1004,
        1004,
        target,
        coreir.BodyDefinitionDomainInvalidTag,
        -1,
        target,
        sourceDefinition,
        sourceSlot,
        901,
        -1,
        -1,
        -1,
        pathKinds,
        pathParentDefinitionDomains,
        pathParentDefinitionRows,
        pathMemberRows,
        pathResultTypeIds,
        pathByteOffsets,
        pathByteWidths)
    replace.ManagedLvalueReplacePlanSeal(plan)
    let report = replace.ManagedLvalueReplaceAdmit(body, plan)
    smokeAssert(report.valid &&
                report.replaceCount == 0 &&
                report.selfAliasNoOpCount == 1 &&
                report.oldDropReleaseCount == 0,
                "managed lvalue replace smoke: self alias no-op receipt")

fn main(): int32 =
    let mutation = os.GetEnv(
        "CHENG_MANAGED_LVALUE_REPLACE_MUTATION")
    if mutation == "borrow-consume" ||
       mutation == "raw-field-store" ||
       mutation == "projection-root" ||
       mutation == "layout-range" ||
       mutation == "orphan-path":
        runFieldBorrowLift(mutation)
        return 0
    if mutation == "self-slot":
        runSelfAliasNoOp(mutation)
        return 0
    runGlobalMove(mutation)
    if mutation != "":
        return 0
    runFieldBorrowLift("")
    runIndexedMove()
    runSelfAliasNoOp("")
    runProductionGlobalMove()
    echo("managed_lvalue_replace_contract_smoke ok")
    return 0
