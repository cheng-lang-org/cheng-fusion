type Tbl =
    offset: int32
    length: int32

type Face =
    data: int32[]
    head: Tbl
    cmap: Tbl
    loaded: bool

fn initEmpty(f: var Face) =
    f.loaded = false

@borrows
fn findTable(buf: int32[], c0: char, outTable: var Tbl): bool =
    outTable.offset = 1
    outTable.length = 2
    return buf.len > 0

@borrows
fn contains(f: var Face, t: Tbl, off: int32): bool =
    return off < t.length

@borrows
fn probe(f: var Face, data: int32[]): bool =
    initEmpty(f)
    if data.len < 4:
        return false
    f.data = data
    f.loaded = true
    if !findTable(f.data, 'a', f.head):
        return false
    if !contains(f, f.head, 1):
        return false
    return true

fn main(): int32 =
    var f: Face
    var d: int32[]
    d = [1, 2, 3, 4]
    if probe(f, d):
        return 1
    return 0
