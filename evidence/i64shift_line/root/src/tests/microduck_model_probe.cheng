# Microduck real-parameter model probe: Build -> Valid -> real-data
# assertions -> round-trip conversions. Contract (task M6, 1:1 port):
#   - link count 15 (trunk + 2x5 leg chain + 4-body neck chain), joint
#     count 14 (5 per leg + neck_pitch/head_pitch/head_yaw/head_roll),
#     exactly the official MJCF tree;
#   - total mass exactly the MJCF inertial sum 0.7443611 kg, inside the
#     real band [0.7, 0.8] (the old 1.2 kg estimate and the brief's
#     0.48 kg figure both mismatch the official file - the head shell is
#     0.172649 kg = 23.2% of the duck, not 36%);
#   - whole-duck COM equals the real mass-weighted COM (bilateral
#     symmetry |comX| < 1e-4, comY/comZ at the derived real values);
#   - real diaginertia recorded per link, positive; the head shell's
#     fore-aft moment dominates its vertical one (long heavy shell);
#   - capsule moments agree with the spawn shape (rod-like limbs);
#   - angle -> distance -> angle round trip over the REAL bone lengths
#     (hip pitch anchor -> knee anchor -> ankle anchor), error < 1e-9 deg;
#   - spawn/anchor conversions compose root yaw exactly; the stance spawn
#     puts the foot plate bottoms on the sole plane;
#   - validator rejects corrupted models (mass band, limit order, anchor
#     continuity, inertia consistency).
import std/math as m
import std/strings as strings
import cheng/game/csg/numerics
import cheng/game/csg/joint_motor
import cheng/game/csg/microduck_model as mm

const
    ProbeMassTol: float64 = 0.000000001
    ProbeRoundTripTolDeg: float64 = 0.000000001
    ProbeGeoTol: float64 = 0.000000001
    ProbeYawTol: float64 = 0.0000001
    ProbeComTol: float64 = 0.000001
    ProbeRealMassTol: float64 = 0.000000000001
    # Real whole-duck COM (mass-weighted real per-body COMs, root frame).
    RealComY: float64 = 0.000159574
    RealComZ: float64 = 0.126063055

@borrows
fn checkModelTables(mdl: mm.MicroduckModel): bool =
    if mdl.links.len != 15:
        echo("FAIL expected 15 links")
        echo(strings.IntToStr(mdl.links.len))
        return false
    if mdl.joints.len != 14:
        echo("FAIL expected 14 joints")
        echo(strings.IntToStr(mdl.joints.len))
        return false
    if mdl.totalMass < mm.MicroduckMassMinKg:
        echo("FAIL total mass below band")
        return false
    if mdl.totalMass > mm.MicroduckMassMaxKg:
        echo("FAIL total mass above band")
        return false
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > ProbeMassTol:
        echo("FAIL total mass off the MJCF inertial sum")
        return false
    if numerics.CsgAbs(mdl.links[mm.MicroduckLinkTorso].mass - 0.264385) > ProbeRealMassTol:
        echo("FAIL trunk mass off MJCF")
        return false
    if numerics.CsgAbs(mdl.links[mm.MicroduckLinkHead].mass - 0.172649) > ProbeRealMassTol:
        echo("FAIL head shell mass off MJCF")
        return false
    let headShare = mdl.links[mm.MicroduckLinkHead].mass / mdl.totalMass
    if headShare < 0.22:
        echo("FAIL head mass share below the real band")
        return false
    if headShare > 0.25:
        echo("FAIL head mass share above the real band")
        return false
    # Real bilateral near-symmetry: the real COM sits 0.156 mm off the
    # symmetry plane (head shell COM is 1.45 mm off-center in the MJCF).
    if numerics.CsgAbs(mdl.comX) > 0.0005:
        echo("FAIL com x off the real symmetry band")
        return false
    if numerics.CsgAbs(mdl.comY - RealComY) > ProbeComTol:
        echo("FAIL com y off the real value")
        return false
    if numerics.CsgAbs(mdl.comZ - RealComZ) > ProbeComTol:
        echo("FAIL com z off the real value")
        return false
    echo("links=" + strings.IntToStr(mdl.links.len))
    echo("joints=" + strings.IntToStr(mdl.joints.len))
    echo("totalMass_x1000=" + strings.Int64ToStr(numerics.CsgQuantMm(mdl.totalMass)))
    echo("headShare_x1000=" + strings.Int64ToStr(numerics.CsgQuantMm(headShare)))
    return true

@borrows
fn checkInertiaShape(mdl: mm.MicroduckModel): bool =
    # Real diaginertia recorded everywhere (validator checks positivity);
    # here: the head shell's fore-aft real moment dominates its vertical
    # one (long 78 mm shell), and the capsule moments of the rod-like
    # limbs stay transverse-dominant.
    let head = mdl.links[mm.MicroduckLinkHead]
    if head.mjcfIxx <= 0.0001:
        echo("FAIL head shell real inertia too small")
        return false
    if head.mjcfIxx <= head.mjcfIzz:
        echo("FAIL head shell fore-aft moment not dominant")
        return false
    # Vertical head barrel: near-equal principal moments (shape gap: the
    # MJCF head-roll frame forbids a forward capsule, see the model
    # header); the real fore-aft dominance lives in mjcfIxx above.
    let headRatio = head.iTv / head.iAx
    if headRatio < 0.6:
        echo("FAIL head capsule ratio off")
        return false
    if headRatio > 2.2:
        echo("FAIL head capsule ratio off")
        return false
    var i: int32 = 0
    while i < mdl.links.len:
        if mdl.links[i].iTv <= 0.0:
            echo("FAIL nonpositive transverse inertia")
            return false
        if mdl.links[i].iAx <= 0.0:
            echo("FAIL nonpositive axial inertia")
            return false
        let isLimb = i == mm.MicroduckLinkThighL || i == mm.MicroduckLinkShinL || i == mm.MicroduckLinkThighR || i == mm.MicroduckLinkShinR
        if isLimb:
            if mdl.links[i].iTv < 2.0 * mdl.links[i].iAx:
                echo("FAIL limb inertia not rod-like")
                return false
        i = i + 1
    return true

# Real bone lengths from the joint table: hip pitch anchor -> knee
# anchor -> ankle anchor (the servo two-bone chain).
@borrows
fn realBoneLengths(mdl: mm.MicroduckModel, l1: var float64, l2: var float64) =
    let jh = mdl.joints[mm.MicroduckJointHipPitchL]
    let jk = mdl.joints[mm.MicroduckJointKneeL]
    let ja = mdl.joints[mm.MicroduckJointAnklePitchL]
    let dx1 = jk.anchorX - jh.anchorX
    let dy1 = jk.anchorY - jh.anchorY
    let dz1 = jk.anchorZ - jh.anchorZ
    l1 = numerics.CsgSqrt(dx1 * dx1 + dy1 * dy1 + dz1 * dz1)
    let dx2 = ja.anchorX - jk.anchorX
    let dy2 = ja.anchorY - jk.anchorY
    let dz2 = ja.anchorZ - jk.anchorZ
    l2 = numerics.CsgSqrt(dx2 * dx2 + dy2 * dy2 + dz2 * dz2)

@borrows
fn checkAngleRoundTrip(mdl: mm.MicroduckModel): bool =
    var l1: float64
    var l2: float64
    realBoneLengths(mdl, l1, l2)
    # Real duck bones: 42.2 mm thigh, 49.4 mm shin (MJCF anchors).
    if numerics.CsgAbs(l1 - 0.042190079) > ProbeComTol:
        echo("FAIL thigh bone length off the MJCF value")
        return false
    if numerics.CsgAbs(l2 - 0.049396390) > ProbeComTol:
        echo("FAIL shin bone length off the MJCF value")
        return false
    var sweep: int32 = 0
    while sweep <= 12:
        let angleDeg = float64(sweep) * 15.0
        let dist = joint_motor.JointMotorAngleToDist(l1, l2, angleDeg)
        let back = joint_motor.JointMotorDistToAngle(l1, l2, dist)
        let err = numerics.CsgAbs(back - angleDeg)
        if err > ProbeRoundTripTolDeg:
            echo("FAIL angle round trip error")
            echo(strings.IntToStr(sweep))
            return false
        sweep = sweep + 1
    let dEnd = joint_motor.JointMotorAngleToDist(l1, l2, 180.0)
    let aEnd = joint_motor.JointMotorDistToAngle(l1, l2, dEnd)
    if numerics.CsgAbs(aEnd - 180.0) > ProbeRoundTripTolDeg:
        echo("FAIL fold boundary round trip")
        return false
    return true

@borrows
fn checkConversions(mdl: mm.MicroduckModel): bool =
    # Torso at identity root: spawn center = model center, upright quat.
    let torso = mm.MicroduckLinkSpawnCapsule(mdl, mm.MicroduckLinkTorso, 1.0, 2.0, 0.5, 0.0)
    if numerics.CsgAbs(torso.px - 1.0 - mdl.links[mm.MicroduckLinkTorso].cx) > ProbeGeoTol:
        echo("FAIL torso spawn x")
        return false
    if numerics.CsgAbs(torso.qw - 1.0) > ProbeGeoTol:
        echo("FAIL torso spawn quat")
        return false
    if numerics.CsgAbs(torso.mass - mdl.links[mm.MicroduckLinkTorso].mass) > 0.0:
        echo("FAIL torso spawn mass")
        return false
    # Head spawn quat: vertical frame (shape gap, see the model header)
    # = identity.
    let head = mm.MicroduckLinkSpawnCapsule(mdl, mm.MicroduckLinkHead, 0.0, 0.0, 0.0, 0.0)
    if numerics.CsgAbs(head.qw - 1.0) > ProbeGeoTol:
        echo("FAIL head spawn quat w")
        return false
    if numerics.CsgAbs(head.qx) > ProbeGeoTol:
        echo("FAIL head spawn quat x")
        return false
    # Hip yaw anchor world at yaw 0 vs yaw 90: the real lateral offset
    # rotates exactly (root-frame anchor composes with the parent
    # center; the hip yaw is a trunk child in the MJCF tree).
    var ax0: float64
    var ay0: float64
    var az0: float64
    mm.MicroduckJointAnchorWorld(mdl, mm.MicroduckJointHipYawL, 1.0, 2.0, 0.5, 0.0, ax0, ay0, az0)
    var ax90: float64
    var ay90: float64
    var az90: float64
    mm.MicroduckJointAnchorWorld(mdl, mm.MicroduckJointHipYawL, 1.0, 2.0, 0.5, 90.0, ax90, ay90, az90)
    let pl = mdl.links[mm.MicroduckLinkTorso]
    let jt = mdl.joints[mm.MicroduckJointHipYawL]
    let expectX = 1.0 + pl.cx + jt.anchorX
    let expectZ = 0.5 + pl.cz + jt.anchorZ
    if numerics.CsgAbs(ax0 - expectX) > ProbeGeoTol:
        echo("FAIL hip anchor x yaw0")
        return false
    if numerics.CsgAbs(az0 - expectZ) > ProbeGeoTol:
        echo("FAIL hip anchor z yaw0")
        return false
    # (x, y) -> (-y, x) under the +90 deg root yaw, then + root.
    let expectX90 = 1.0 - (pl.cy + jt.anchorY)
    let expectY90 = 2.0 + (pl.cx + jt.anchorX)
    if numerics.CsgAbs(ax90 - expectX90) > ProbeYawTol:
        echo("FAIL hip anchor x yaw90")
        return false
    if numerics.CsgAbs(ay90 - expectY90) > ProbeYawTol:
        echo("FAIL hip anchor y yaw90")
        return false
    if numerics.CsgAbs(az90 - expectZ) > ProbeGeoTol:
        echo("FAIL hip anchor z yaw90")
        return false
    # Stance spawn: the foot plate bottoms land on the sole plane and the
    # FK'd pose stays a unit quaternion.
    let foot = mm.MicroduckLinkSpawnCapsuleStance(mdl, mm.MicroduckLinkFootL, 0.0, 0.0, mm.MicroduckStanceRootZLift, 0.0)
    let bottomErr = foot.pz - foot.radius
    if numerics.CsgAbs(bottomErr) > ProbeComTol:
        echo("FAIL stance foot plate off the sole plane")
        return false
    let qn = numerics.CsgSqrt(foot.qw * foot.qw + foot.qx * foot.qx + foot.qy * foot.qy + foot.qz * foot.qz)
    if numerics.CsgAbs(qn - 1.0) > ProbeGeoTol:
        echo("FAIL stance quat not unit")
        return false
    let thigh = mm.MicroduckLinkSpawnCapsuleStance(mdl, mm.MicroduckLinkThighL, 0.0, 0.0, mm.MicroduckStanceRootZLift, 0.0)
    # The hip pitch pivot (= the thigh body origin, the joint anchor) is
    # on the rotation axis: the thigh spawn keeps its distance to the
    # pivot exactly (pivot world = root + anchor; the root lift shifts
    # pivot and spawn alike).
    let jtH = mdl.joints[mm.MicroduckJointHipPitchL]
    let dx = thigh.px - jtH.anchorX
    let dy = thigh.py - jtH.anchorY
    let dz = thigh.pz - (mm.MicroduckStanceRootZLift + jtH.anchorZ)
    let dStance = numerics.CsgSqrt(dx * dx + dy * dy + dz * dz)
    let ex = mdl.links[mm.MicroduckLinkThighL].cx - jtH.anchorX
    let ey = mdl.links[mm.MicroduckLinkThighL].cy - jtH.anchorY
    let ez = mdl.links[mm.MicroduckLinkThighL].cz - jtH.anchorZ
    let dZero = numerics.CsgSqrt(ex * ex + ey * ey + ez * ez)
    if numerics.CsgAbs(dStance - dZero) > ProbeGeoTol:
        echo("FAIL stance thigh moved off the hip pivot sphere")
        return false
    return true

fn makeSynthModel(minRad: float64, maxRad: float64, anchorZ: float64): mm.MicroduckModel =
    # Fresh minimal two-link model per case: anchor must equal the child
    # body origin for the good case; cases corrupt one field each.
    var m2: mm.MicroduckModel
    setLen(m2.links, 0)
    setLen(m2.joints, 0)
    let la = mm.MicroduckMakeLink("base", 0.4, 0.02, 0.03, mm.MicroduckAxisVertical,
                                  0.0, 0.0, 0.05, 0.000001, 0.000001, 0.000001,
                                  0.0, 0.0, 0.02)
    add(m2.links, la)
    let lb = mm.MicroduckMakeLink("boom", 0.34, 0.02, 0.03, mm.MicroduckAxisVertical,
                                  0.0, 0.0, 0.13, 0.000001, 0.000001, 0.000001,
                                  0.0, 0.0, 0.16)
    add(m2.links, lb)
    let jg = mm.MicroduckMakeJoint("pin", 0, 1, 0.0, 0.0, anchorZ, 1.0, 0.0, 0.0,
                                   minRad, maxRad, 100.0, 0.5, 0.0, 0.0)
    add(m2.joints, jg)
    m2.totalMass = 0.74
    m2.comX = 0.0
    m2.comY = 0.0
    m2.comZ = (0.4 * 0.05 + 0.34 * 0.13) / 0.74
    return m2

fn checkValidatorRejects(): bool =
    # Minimal well-formed two-link model must pass.
    let good = makeSynthModel(0.0 - 0.1745, 0.1745, 0.16)
    if !mm.MicroduckModelValid(good):
        echo("FAIL validator rejected well-formed model")
        return false
    # Corrupt mass band -> reject.
    let bad = makeSynthModel(0.0 - 0.1745, 0.1745, 0.16)
    var badMass = bad
    badMass.totalMass = 5.0
    if mm.MicroduckModelValid(badMass):
        echo("FAIL validator accepted mass out of band")
        return false
    # Corrupt limits order -> reject.
    let badLimits = makeSynthModel(0.1745, 0.1745, 0.16)
    if mm.MicroduckModelValid(badLimits):
        echo("FAIL validator accepted degenerate limits")
        return false
    # Break the MuJoCo anchor == child origin continuity -> reject.
    let badAnchor = makeSynthModel(0.0 - 0.1745, 0.1745, 0.5)
    if mm.MicroduckModelValid(badAnchor):
        echo("FAIL validator accepted discontinuous anchor")
        return false
    # Break the capsule inertia consistency -> reject.
    let badInertia = makeSynthModel(0.0 - 0.1745, 0.1745, 0.16)
    var badIv = badInertia
    badIv.links[0].iTv = badIv.links[0].iTv * 1.01
    if mm.MicroduckModelValid(badIv):
        echo("FAIL validator accepted inconsistent inertia")
        return false
    return true

fn runProbe(): bool =
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if !checkModelTables(mdl):
        return false
    if !mm.MicroduckModelValid(mdl):
        echo("FAIL model invalid")
        return false
    if !checkInertiaShape(mdl):
        return false
    if !checkAngleRoundTrip(mdl):
        return false
    if !checkConversions(mdl):
        return false
    if !checkValidatorRejects():
        return false
    echo("PASS microduck model probe")
    return true

fn main(): int32 =
    if !runProbe():
        return 1
    return 0
