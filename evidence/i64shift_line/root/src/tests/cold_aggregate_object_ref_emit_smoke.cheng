import cheng/tests/cold_aggregate_field_store_left as left

type
    ColdAggregateObjectRefEmitHolder =
        inlineValue: left.AggregateIdentity
        borrowedValue: var left.AggregateIdentity

fn ColdAggregateObjectRefEmitStore(holder: var ColdAggregateObjectRefEmitHolder,
                                   payload: var left.AggregateIdentity) =
    holder.inlineValue = payload
    holder.borrowedValue = payload

fn main(): int32 =
    var payload = left.AggregateIdentity(label: "emit", values: [1, 1, 2, 3])
    var holder: ColdAggregateObjectRefEmitHolder
    ColdAggregateObjectRefEmitStore(holder, payload)
    return 0
