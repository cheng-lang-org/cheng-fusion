# micro diagnosis for disclosure helpers

import std/os
import std/system
import cheng/apps/rwad/rwad_disclosure as dsc

fn main(): int32 =
    let n = dsc.DscI64(Int64(500))
    os.WriteLine(os.Get_stderr(), "i64=[" + n + "] len=" + dsc.DscI64(Int64(dsc.DebugLen(n))))
    let c1 = dsc.DscContains("hello", "ell")
    if c1:
        os.WriteLine(os.Get_stderr(), "contains=1")
    else:
        os.WriteLine(os.Get_stderr(), "contains=0")
    return 0
