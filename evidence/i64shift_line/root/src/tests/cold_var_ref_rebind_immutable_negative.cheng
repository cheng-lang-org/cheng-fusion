type
    ColdVarRefImmutableCell = ref object
        value: int32

fn ColdVarRefImmutableRebind(
        target: var ColdVarRefImmutableCell,
        replacement: ColdVarRefImmutableCell) =
    target = replacement

fn main(): int32 =
    let target = new(ColdVarRefImmutableCell)
    let replacement = new(ColdVarRefImmutableCell)
    ColdVarRefImmutableRebind(target, replacement)
    return 0
