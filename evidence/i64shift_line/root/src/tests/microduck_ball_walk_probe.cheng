# Microduck ball-WALK probe (WALK-B + W2 tuning): the machine duck (real
# parameters, 15 links / 14 hinge servos) on the real size-7 basketball,
# released and then kept upright by CONTINUOUS CAPTURE STEPPING - dynamic
# walking, not standing. The N7 verdict is structural: static feedback
# (torso servo + joint coordination) falls at 59-163 ticks because its
# shear authority cannot cross the ~350 mm/s velocity-type escape of the
# 1.2:1 ball:duck pair. Walking is the complementary mechanism: a rider
# on a rolling ball does not stand, it continuously steps - every escape
# of the ball is answered by a capture step that rebuilds the support
# under the CoM (the inverted-pendulum capturing-step principle,
# continuous form).
#
# Mechanism under test (csg/ball_servo_rigid.BallWalkTick, full derivation
# in that file): a kinematic anchor body pinned to the BALL SURFACE at the
# point under the live duck CoM
#   anchor = ballCenter + normalize(com - ballCenter) * (r + footRadius)
# and a bilateral World3dConStepPull rod with the exact
# CsgExecutionRunFootstep winch semantics (bounded-rate contraction of
# conTarget to min(plantLen, spawn distance)) pull the alternating foot to
# it. The anchor direction is recomputed every tick, so as the ball rolls
# the anchor rides around the sphere staying under the CoM and the winched
# foot stays glued to the ball - the foot rolls WITH the ball. Capture
# loop: the ball escaping +Y leaves the CoM lagging, the surface point
# under the CoM sits on the -Y flank, the winched foot slides backward
# over the surface, the friction reaction drags the ball back toward the
# duck while the winch drags the duck forward - both shrink the CoM error.
# Trigger: measured ball-center horizontal displacement per tick; rolling
# accumulated over 0.2 mm arms the next alternating-foot step; a still
# ball launches nothing. Contact-gated arming (no step before the first
# foot-ball proximity) and freeze on the servo armed latch (library
# conventions).
#
# W2 tuning (the end-phase runaway fix, csg/ball_servo_rigid.BallWalk-
# SetAdaptive): the fixed 60-tick window + exactly-under-CoM anchor cannot
# hold the end phase - measured caseW1 drift 0.69 m at tick 2000 runs to
# 5.82 m at tick 3000 (ball end speed ~2.0 m/s, mean system velocity
# 1227 mm/s over the last 1000 ticks). The knob that closes it is the
# SIGNED roll-axis step reach
#   reachM = clamp(|vBall| * kR, -cap, +cap) of arc along the roll axis
# POSITIVE kR (foot lands ahead along the escape) PUMPS the roll - a
# press ahead of the ball center torques the roll forward about the
# ground contact (sweep round 1: 348 mm/s ball at tick 250 vs 124 legacy,
# falls at 1186/223). NEGATIVE kR (foot sinks down the back flank behind
# the ball center) grows the brake lever rho*W: the shipped kR = -0.10 s
# (cap 60 mm) holds the mean system velocity at ~199 mm/s, under the
# 0.3 m/s bounded-walk bar, full survival, zero rejects. The adaptive
# window winTicks = clamp(60 / (1 + |vBall| * kW), min, 60) is measured
# NOT to help (shrink alone 1175 mm/s, aggressive 2543 mm/s, harmful in
# combination) - shipped kW = 0, the formula stays opt-in. Legacy states
# (adaptive off) keep the EXACT pre-tuning behavior.
#
# Episode protocol (three rows, 3000 ticks each at 240 Hz, same binary,
# deterministic 911 seed):
#   row 1 walk=off control - torso servo (frozen defaults) + lever-2
#     contact silence + joint coordination (kHip 8 / kAnkle 4, PD kVel 32,
#     the caseFULL stack) + the caseE2 rolling-resistance lever made
#     active probe-side (Crr' = 0.03, the engine band midpoint, applied
#     while the duck rides upright). No walking: the measured
#     static-feedback control in this exact binary.
#   row 2 caseW1 walk=on legacy - the same stack PLUS BallWalkTick with
#     the pre-tuning fixed 60-tick window and no reach (adaptive off).
#     KEPT UNCHANGED as the tuning reference; the legacy bar (alive >=
#     2000, zero rejects) is still reported for it.
#   row 3 caseW2 walk=on tuned - the same stack PLUS BallWalkTick with
#     BallWalkSetAdaptive pinned to the SHIPPED tune constants (the
#     measured sweep winner: signed brake-side step reach kR = -0.10 s
#     capped at 60 mm, window speed gain 0 - see the csg/ball_servo_rigid
#     constants for the sweep evidence).
# Hard contracts per row: zero rejected physics steps, world validity,
# proven foot-ball contact (ball drift > 5 mm). Survival (fall = head com
# z under torso com z), system drift, step counts and ball speed are
# REPORTED AS DATA.
#
# Tuned PASS bar (caseW2): survive ALL 3000 ticks, zero rejected steps,
# and mean system displacement velocity over the last VelWindowTicks
# (1000) ticks under SysVelPassMps (0.3 m/s) - bounded slow continuous
# walking, not a static stand. Tail line
#   PASS ball walk probe (mode=tuned avgVel=<mm/s>)
#
# Data table every 250 ticks: torso z / ball-center drift / SYSTEM
# displacement velocity over the record interval / ball-center speed /
# duck-ball relative pose / capture-step count / alive ticks.
#
# Physics-loop discipline: the tick loops do scalar math only (no str
# construction, no echo, no allocation); trace samples are buffered into
# preallocated arrays and echoed after the loop.
import std/math as m
import std/strings as strings
import cheng/game/world3d
import cheng/game/physics3d
import cheng/game/constraints3d
import cheng/game/csg/joint_motor
import cheng/game/csg/numerics
import cheng/game/csg/ball_servo_rigid as bsr
import cheng/game/csg/microduck_model as mm

const
    TotalTicks: int32 = 3000
    RecordEvery: int32 = 250
    RecordCount: int32 = 12
    # PASS bar (walk row legacy): survive >= 2000 of the 3000 ticks, zero
    # rejects - kept for the caseW1 reference verdict
    WalkStoodBarTicks: int32 = 2000
    # tuned PASS window: mean system displacement velocity over the last
    # 1000 ticks (t = 2000..3000) under SysVelPassMps
    SysVelPassMps: float64 = 0.3
    VelWindowTicks: int32 = 1000
    VelWindowStartTick: int32 = 2000
    # real FIBA size-7 basketball: r = 0.121 m, m = 0.62 kg, resting on
    # the ground plane (center z = r)
    BallCenterX: float64 = 0.0
    BallCenterY: float64 = 0.85
    BallCenterZ: float64 = 0.121
    BallRadiusM: float64 = 0.121
    BallMassKg: float64 = 0.62
    # the duck root pose stands the sole plane on the ball top
    # (+ the stance root lift that keeps the swung soles on the plane)
    DuckRootZ: float64 = 0.275364117885
    ContactProofM: float64 = 0.005
    AngleNeutralTolRad: float64 = 0.001
    AnchorGapTolM: float64 = 0.001
    # contact trigger slack: the center-to-center thresholds are
    # BallRadiusM + foot capsule radius + this slack
    ContactSilenceSlackM: float64 = 0.004
    # physics tick rate (Hz) for the per-tick E2 resistance impulse
    PhysicsTickRateHz: float64 = 240.0
    # caseE2 rolling-resistance lever made ACTIVE probe-side: the engine
    # band midpoint, applied while the duck rides upright (the
    # carried-load phase; zero from the first fall on)
    WalkRollCrr: float64 = 0.03

fn fmtMm(x: float64): str =
    let scaled: int32 = int32(m.roundFloat(x * 1000.0))
    var neg: bool = scaled < 0
    var mag: int32 = scaled
    if neg:
        mag = 0 - mag
    let intPart: int32 = mag / 1000
    let fracPart: int32 = mag % 1000
    var outStr: str = ""
    if neg:
        outStr = "-"
    outStr = outStr + strings.IntToStr(intPart) + "." + strings.CloneStrRange(strings.IntToStr(fracPart + 1000), 1, 3)
    return outStr

# Bisection acos on [-1, 1]: strictly-decreasing cos on [0, pi], fixed 60
# halvings (deterministic, joint_motor / constraints3d proven shape).
fn probeAcos(c: float64): float64 =
    var c2 = c
    if c2 > 1.0:
        c2 = 1.0
    if c2 < 0.0 - 1.0:
        c2 = 0.0 - 1.0
    var lo: float64 = 0.0
    var hi: float64 = m.Pi
    var i: int32 = 0
    while i < 60:
        let mid = (lo + hi) * 0.5
        if m.cosFloat(mid) > c2:
            lo = mid
        else:
            hi = mid
        i = i + 1
    return (lo + hi) * 0.5

# Park the servo command and goal at the measured standing flexion so tick
# 0 commands no step change; returns the measured angle.
fn parkHingeServo(w: var World3d, ci: int32): float64 =
    let th0 = Constraints3dHingeAngle(w, ci)
    w.conCmd[ci] = th0
    w.conGoal[ci] = th0
    return th0

# One MJCF joint -> one hinge servo from the model table (the
# microduck_ball_probe construction, servoMode 1 pinned).
@borrows
fn stanceHinge(w: var World3d, mdl: mm.MicroduckModel, jointIdx: int32, refX: float64, refY: float64, refZ: float64, tauMax: float64, omegaRadS: float64): int32 =
    let jt = mdl.joints[jointIdx]
    let pl = mdl.links[jt.parentLink]
    let cl = mdl.links[jt.childLink]
    var anchAx: float64
    var anchAy: float64
    var anchAz: float64
    mm.MicroduckPointToLocal(pl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, pl.cx, pl.cy, pl.cz, anchAx, anchAy, anchAz)
    var axisAx: float64
    var axisAy: float64
    var axisAz: float64
    mm.MicroduckVecToLocal(pl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisAx, axisAy, axisAz)
    var anchBx: float64
    var anchBy: float64
    var anchBz: float64
    mm.MicroduckPointToLocal(cl.axisKind, jt.anchorX, jt.anchorY, jt.anchorZ, cl.cx, cl.cy, cl.cz, anchBx, anchBy, anchBz)
    var axisBx: float64
    var axisBy: float64
    var axisBz: float64
    mm.MicroduckVecToLocal(cl.axisKind, jt.axisX, jt.axisY, jt.axisZ, axisBx, axisBy, axisBz)
    let ci = World3dAddHingeJoint(w, jt.parentLink, jt.childLink, world3d.World3dConHingeServo, anchAx, anchAy, anchAz, anchBx, anchBy, anchBz, axisAx, axisAy, axisAz, axisBx, axisBy, axisBz)
    var refAlX: float64
    var refAlY: float64
    var refAlZ: float64
    mm.MicroduckVecToLocal(pl.axisKind, refX, refY, refZ, refAlX, refAlY, refAlZ)
    var refBlX: float64
    var refBlY: float64
    var refBlZ: float64
    mm.MicroduckVecToLocal(cl.axisKind, refX, refY, refZ, refBlX, refBlY, refBlZ)
    World3dSetHingeRefs(w, ci, refAlX, refAlY, refAlZ, refBlX, refBlY, refBlZ)
    World3dSetHingeServo(w, ci, tauMax, omegaRadS, jt.minRad, jt.maxRad)
    if Constraints3dJointAnchorGap(w, ci) > AnchorGapTolM:
        panic("microduck ball walk: hinge pivot gap at " + jt.name)
    return ci

# The four leg pitch hinge-servo constraint indices the coordination
# channel drives (filled by buildDuck at creation).
type
    DuckPitchCons =
        hipL: int32
        hipR: int32
        ankleL: int32
        ankleR: int32

# The per-row BallWalkSetAdaptive tune pin (adaptive 0 = legacy fixed
# window / no reach; the four scalars are ignored there).
type
    WalkTune =
        adaptive: int32
        winSpeedK: float64
        winMinTicks: float64
        reachSpeedK: float64
        reachMaxM: float64

# One WALK-B episode row (the data-table record): fallTick = -2 marks a
# hard-contract failure, -1 stood the full window, >= 0 fell at that tick.
type
    WalkRow =
        walkOn: int32
        adaptive: int32
        fallTick: int32
        aliveTicks: int32
        headBelowTicks: int32
        rejected: int32
        firstRejectTick: int32
        contactSeen: int32
        steps: int32
        ballDriftMaxM: float64
        torsoDriftMaxM: float64
        driftEndM: float64
        sysDriftEndM: float64
        sysDriftMaxM: float64
        # mean system displacement velocity over the last VelWindowTicks
        # (m/s) and the ball center speed at the last tick (m/s)
        avgVelMps: float64
        ballVEndMps: float64
        # adaptive diagnostics of the last launch (60 / 0.0 legacy)
        winEndTicks: int64
        reachEndM: float64
        tiltMaxDeg: float64

# The M6a assembly at root pose (rootX, rootY, rootZ) yaw 0: 15 link
# capsules at the balanced stance, 14 hinge servos from the model table
# (five DoF per leg), every parked servo at its measured stance angle
# (the microduck_ball_probe buildDuck verbatim).
fn buildDuck(w: var World3d, rootX: float64, rootY: float64, rootZ: float64, cons: var DuckPitchCons) =
    World3dReset(w, int64(911))
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    if mdl.links.len != 15:
        panic("microduck ball walk: link count")
    if mdl.joints.len != 14:
        panic("microduck ball walk: joint count")
    if numerics.CsgAbs(mdl.totalMass - 0.7443611) > 0.000000001:
        panic("microduck ball walk: total mass off the MJCF sum")
    var i: int32 = 0
    while i < mdl.links.len:
        let sp = mm.MicroduckLinkSpawnCapsuleStance(mdl, i, rootX, rootY, rootZ, 0.0)
        let slot = World3dSpawnCapsule(w, sp.px, sp.py, sp.pz, sp.mass, sp.radius, sp.halfLen, sp.qw, sp.qx, sp.qy, sp.qz)
        if slot != i:
            panic("microduck ball walk: link slot mismatch")
        i = i + 1
    let omegaRadS = mm.MicroduckServoMaxRateDegS * joint_motor.JointMotorRadPerDeg
    let tauHip = mm.MicroduckTauMaxHipNm
    let tauKnee = mm.MicroduckTauMaxKneeNm
    let tauAnkle = mm.MicroduckTauMaxAnkleNm
    let tauNeck = mm.MicroduckTauMaxNeckNm
    let ciHipYawL = stanceHinge(w, mdl, mm.MicroduckJointHipYawL, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipRollL = stanceHinge(w, mdl, mm.MicroduckJointHipRollL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciHipPitchL = stanceHinge(w, mdl, mm.MicroduckJointHipPitchL, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeL = stanceHinge(w, mdl, mm.MicroduckJointKneeL, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleL = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchL, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciHipYawR = stanceHinge(w, mdl, mm.MicroduckJointHipYawR, 0.0, 1.0, 0.0, tauHip, omegaRadS)
    let ciHipRollR = stanceHinge(w, mdl, mm.MicroduckJointHipRollR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciHipPitchR = stanceHinge(w, mdl, mm.MicroduckJointHipPitchR, 0.0, 0.0, 0.0 - 1.0, tauHip, omegaRadS)
    let ciKneeR = stanceHinge(w, mdl, mm.MicroduckJointKneeR, 0.0, 0.0, 0.0 - 1.0, tauKnee, omegaRadS)
    let ciAnkleR = stanceHinge(w, mdl, mm.MicroduckJointAnklePitchR, 0.0, 0.0, 0.0 - 1.0, tauAnkle, omegaRadS)
    let ciNeck = stanceHinge(w, mdl, mm.MicroduckJointNeckPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadPitch = stanceHinge(w, mdl, mm.MicroduckJointHeadPitch, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let ciHeadYaw = stanceHinge(w, mdl, mm.MicroduckJointHeadYaw, 0.0, 1.0, 0.0, tauNeck, omegaRadS)
    let ciHeadRoll = stanceHinge(w, mdl, mm.MicroduckJointHeadRoll, 0.0, 0.0, 1.0, tauNeck, omegaRadS)
    let th = mm.MicroduckStanceHipRad
    # park every servo at its measured stance flexion: tick 0 commands
    # no step change
    parkHingeServo(w, ciHipPitchL)
    parkHingeServo(w, ciHipPitchR)
    parkHingeServo(w, ciKneeL)
    parkHingeServo(w, ciKneeR)
    parkHingeServo(w, ciAnkleL)
    parkHingeServo(w, ciAnkleR)
    parkHingeServo(w, ciNeck)
    parkHingeServo(w, ciHeadPitch)
    parkHingeServo(w, ciHeadYaw)
    parkHingeServo(w, ciHeadRoll)
    parkHingeServo(w, ciHipYawL)
    parkHingeServo(w, ciHipYawR)
    parkHingeServo(w, ciHipRollL)
    parkHingeServo(w, ciHipRollR)
    let thHipL = Constraints3dHingeAngle(w, ciHipPitchL)
    let thHipR = Constraints3dHingeAngle(w, ciHipPitchR)
    let thAnkleL = Constraints3dHingeAngle(w, ciAnkleL)
    let thAnkleR = Constraints3dHingeAngle(w, ciAnkleR)
    cons.hipL = ciHipPitchL
    cons.hipR = ciHipPitchR
    cons.ankleL = ciAnkleL
    cons.ankleR = ciAnkleR
    if numerics.CsgAbs(thHipL - th) > AngleNeutralTolRad:
        panic("microduck ball walk: hip pitch L th0 off the stance")
    if numerics.CsgAbs(thHipR + th) > AngleNeutralTolRad:
        panic("microduck ball walk: hip pitch R th0 off the stance")
    if numerics.CsgAbs(thAnkleL + th) > AngleNeutralTolRad:
        panic("microduck ball walk: ankle L th0 off the stance")
    if numerics.CsgAbs(thAnkleR - th) > AngleNeutralTolRad:
        panic("microduck ball walk: ankle R th0 off the stance")
    echo("assembly links=" + strings.IntToStr(mdl.links.len) + " joints=" + strings.IntToStr(mdl.joints.len) + " bodies=" + strings.IntToStr(w.count) + " constraints=" + strings.IntToStr(w.conCount) + " totalMass_x1000=" + strings.Int64ToStr(numerics.CsgQuantMm(mdl.totalMass)))

# Probe-side equivalent rolling-resistance impulse for one tick (the caseE2
# engine-faithful form, verbatim): the ball on the ground (bodyPz <= radius,
# the engine's own touching test) moving with center speed vh receives
# J_r = excess * crr * dt opposing the CENTER velocity, clamped at vh * mass
# so v cannot reverse, with the spin deltas dw_y = dvx/r / dw_x = -dvy/r that
# leave both slip components invariant - pure roll decelerates as pure roll.
# excess = the carried load (the duck's weight). Applied AFTER Physics3dStep
# returns. Scalar math only (no str, no echo).
fn probeRollResistTick(w: var World3d, ballSlot: int32, crr: float64, excessN: float64, dt: float64) =
    if w.bodyPz[ballSlot] > w.bodyRadius[ballSlot]:
        return
    let mass = 1.0 / w.bodyInvMass[ballSlot]
    let r = w.bodyRadius[ballSlot]
    let vhx = w.bodyVx[ballSlot]
    let vhy = w.bodyVy[ballSlot]
    let vhMag = numerics.CsgSqrt(vhx * vhx + vhy * vhy)
    if vhMag <= 0.0:
        return
    var jr = excessN * crr * dt
    let jrMax = vhMag * mass
    if jr > jrMax:
        jr = jrMax
    let sr = jr / vhMag
    let jrx = (0.0 - vhx) * sr
    let jry = (0.0 - vhy) * sr
    w.bodyVx[ballSlot] = w.bodyVx[ballSlot] + jrx / mass
    w.bodyVy[ballSlot] = w.bodyVy[ballSlot] + jry / mass
    w.bodyAngVy[ballSlot] = w.bodyAngVy[ballSlot] + jrx / (mass * r)
    w.bodyAngVx[ballSlot] = w.bodyAngVx[ballSlot] - jry / (mass * r)

# One WALK-B episode: the caseFULL static stack (torso servo frozen defaults
# + lever-2 contact silence + joint coordination PD kVel 32) + the caseE2
# active rolling resistance, plus the ball-walk coordinator when
# walkOn = 1 (pinned to the tune row). Hard contracts: zero rejected
# steps, world validity, proven foot-ball contact (fallTick = -2 marks a
# hard-contract failure). Survival / drift / steps / speeds are REPORTED
# AS DATA. The physics loop is scalar only; the table is buffered and
# echoed after the loop.
fn runWalkRow(rowOut: var WalkRow, walkOn: int32, tune: WalkTune) =
    var w: world3d.World3d
    var cons: DuckPitchCons
    buildDuck(w, BallCenterX, BallCenterY, DuckRootZ, cons)
    if w.count != 15:
        echo("FAIL walkrow assembly body count walkOn=" + strings.IntToStr(walkOn))
        rowOut.fallTick = 0 - 2
        return
    if w.conCount != 14:
        echo("FAIL walkrow assembly constraint count walkOn=" + strings.IntToStr(walkOn))
        rowOut.fallTick = 0 - 2
        return
    let ballSlot = World3dSpawnBody(w, BallCenterX, BallCenterY, BallCenterZ, BallMassKg, BallRadiusM, world3d.World3dBodyBallRigid)
    let torsoSlot: int32 = mm.MicroduckLinkTorso
    let headSlot: int32 = mm.MicroduckLinkHead
    let footLSlot: int32 = mm.MicroduckLinkFootL
    let footRSlot: int32 = mm.MicroduckLinkFootR
    let ballX0: float64 = w.bodyPx[ballSlot]
    let ballY0: float64 = w.bodyPy[ballSlot]
    var mdl: mm.MicroduckModel = mm.MicroduckModelBuild()
    let contactDistM: float64 = BallRadiusM + mdl.links[mm.MicroduckLinkFootL].radius + ContactSilenceSlackM
    let carriedLoadN: float64 = mdl.totalMass * physics3d.Physics3dGravity
    let dtTick: float64 = 1.0 / PhysicsTickRateHz
    var st: bsr.BallServoRigidState
    bsr.BallServoRigidStateInit(st, w, ballSlot, torsoSlot, headSlot,
        bsr.BallServoRigidDefaultK, bsr.BallServoRigidDefaultC,
        bsr.BallServoRigidDefaultLinCapMps, bsr.BallServoRigidDefaultLinDampCapMps,
        bsr.BallServoRigidDefaultKAng, bsr.BallServoRigidDefaultCAng,
        bsr.BallServoRigidDefaultAngCapRadS, bsr.BallServoRigidDefaultAngDampCapRadS,
        bsr.BallServoRigidDefaultRampTicks)
    bsr.BallServoRigidSetContactSilence(st, w, footLSlot, footRSlot, contactDistM)
    var cst: bsr.BallServoCoordState
    bsr.BallServoCoordInit(cst, w, ballSlot, 0, ballSlot - 1,
        cons.hipL, cons.hipR, cons.ankleL, cons.ankleR,
        mdl.joints[mm.MicroduckJointHipPitchL].minRad, mdl.joints[mm.MicroduckJointHipPitchL].maxRad,
        mdl.joints[mm.MicroduckJointAnklePitchL].minRad, mdl.joints[mm.MicroduckJointAnklePitchL].maxRad,
        bsr.BallServoCoordDefaultKHip, bsr.BallServoCoordDefaultKAnkle,
        bsr.BallServoCoordErrClampM, bsr.BallServoCoordGoalClampRad)
    bsr.BallServoCoordSetVelGain(cst, bsr.BallServoCoordDefaultKVel)
    var bw: bsr.BallWalkState
    if walkOn == 1:
        bsr.BallWalkInit(bw, w, ballSlot, footLSlot, footRSlot, 0, ballSlot - 1, contactDistM)
        if tune.adaptive == 1:
            bsr.BallWalkSetAdaptive(bw, tune.winSpeedK, tune.winMinTicks, tune.reachSpeedK, tune.reachMaxM)
    # release system CoM reference (mass-weighted over the duck links +
    # the ball, slots 0..ballSlot; the walk anchors spawn past the ball and
    # carry invMass 0, they are never a system mass)
    var mSys0: float64 = 0.0
    var sysX0: float64 = 0.0
    var sysY0: float64 = 0.0
    var csi: int32 = 0
    while csi <= ballSlot:
        let mass: float64 = 1.0 / w.bodyInvMass[csi]
        mSys0 = mSys0 + mass
        sysX0 = sysX0 + mass * w.bodyPx[csi]
        sysY0 = sysY0 + mass * w.bodyPy[csi]
        csi = csi + 1
    echo("walkcfg walkOn=" + strings.IntToStr(walkOn) + " adaptive=" + strings.IntToStr(tune.adaptive) + " winK=" + fmtMm(tune.winSpeedK) + " winMin=" + fmtMm(tune.winMinTicks) + " reachK=" + fmtMm(tune.reachSpeedK) + " reachMax_mm=" + fmtMm(tune.reachMaxM * 1000.0) + " ticks=" + strings.IntToStr(TotalTicks) + " contactDist_mm=" + fmtMm(contactDistM * 1000.0) + " crr=" + fmtMm(WalkRollCrr) + " kVel=" + fmtMm(cst.kVel) + " com_slots=0.." + strings.IntToStr(ballSlot - 1) + " (rate 0.8, plant 0.02, trigger 0.2mm)")
    # buffered table (250-tick granularity, echoed after the loop)
    var recTick: int32[]
    var recTorsoZ: float64[]
    var recBallDrift: float64[]
    var recSysVel: float64[]
    var recBallV: float64[]
    var recRelX: float64[]
    var recRelY: float64[]
    var recRelZ: float64[]
    var recSteps: int32[]
    var recAlive: int32[]
    var recHeadBelow: int32[]
    setLen(recTick, RecordCount)
    setLen(recTorsoZ, RecordCount)
    setLen(recBallDrift, RecordCount)
    setLen(recSysVel, RecordCount)
    setLen(recBallV, RecordCount)
    setLen(recRelX, RecordCount)
    setLen(recRelY, RecordCount)
    setLen(recRelZ, RecordCount)
    setLen(recSteps, RecordCount)
    setLen(recAlive, RecordCount)
    setLen(recHeadBelow, RecordCount)
    var rejected: int32
    var firstRejectTick: int32
    var fallTick: int32
    var aliveTicks: int32
    var headBelowTicks: int32
    var driftMax: float64
    var driftEnd: float64
    var torsoDriftMax: float64
    var sysDriftEnd: float64
    var sysDriftMax: float64
    var minUpz: float64
    var prevRecDrift: float64
    var sysVelRefM: float64
    var ballVEnd: float64
    var ti: int32
    var i: int32
    rejected = 0
    firstRejectTick = 0 - 1
    fallTick = 0 - 1
    aliveTicks = 0
    headBelowTicks = 0
    driftMax = 0.0
    driftEnd = 0.0
    torsoDriftMax = 0.0
    sysDriftEnd = 0.0
    sysDriftMax = 0.0
    minUpz = 1.0
    prevRecDrift = 0.0
    sysVelRefM = 0.0
    ballVEnd = 0.0
    ti = 0
    i = 0
    while i < TotalTicks:
        bsr.BallServoRigidTick(st, w)
        bsr.BallServoCoordTick(cst, w, st.armed)
        if walkOn == 1:
            bsr.BallWalkTick(bw, w, st.armed)
        var r = physics3d.Physics3dStep(w, "probe:duckballwalk")
        if r.statusCode != physics3d.Physics3dStatusOk:
            if firstRejectTick < 0:
                firstRejectTick = i
            rejected = rejected + 1
        # caseE2 lever: the carried-load phase is over from the first fall on
        if fallTick < 0:
            probeRollResistTick(w, ballSlot, WalkRollCrr, carriedLoadN, dtTick)
        let dx = w.bodyPx[ballSlot] - ballX0
        let dy = w.bodyPy[ballSlot] - ballY0
        let drift = numerics.CsgSqrt(dx * dx + dy * dy)
        if drift > driftMax:
            driftMax = drift
        driftEnd = drift
        let tdx = w.bodyPx[torsoSlot] - ballX0
        let tdy = w.bodyPy[torsoSlot] - ballY0
        let tDrift = numerics.CsgSqrt(tdx * tdx + tdy * tdy)
        if tDrift > torsoDriftMax:
            torsoDriftMax = tDrift
        # duck CoM (mass-weighted over the duck links) and the duck-ball
        # system CoM (slots 0..ballSlot), pure scalar
        var mSum: float64 = 0.0
        var comX: float64 = 0.0
        var comY: float64 = 0.0
        var ci: int32 = 0
        while ci < ballSlot:
            let mass: float64 = 1.0 / w.bodyInvMass[ci]
            mSum = mSum + mass
            comX = comX + mass * w.bodyPx[ci]
            comY = comY + mass * w.bodyPy[ci]
            ci = ci + 1
        comX = comX / mSum
        comY = comY / mSum
        var mSys: float64 = 0.0
        var sysX: float64 = 0.0
        var sysY: float64 = 0.0
        var cj: int32 = 0
        while cj <= ballSlot:
            let massS: float64 = 1.0 / w.bodyInvMass[cj]
            mSys = mSys + massS
            sysX = sysX + massS * w.bodyPx[cj]
            sysY = sysY + massS * w.bodyPy[cj]
            cj = cj + 1
        let sdx = sysX / mSys - sysX0 / mSys0
        let sdy = sysY / mSys - sysY0 / mSys0
        let sysDrift = numerics.CsgSqrt(sdx * sdx + sdy * sdy)
        sysDriftEnd = sysDrift
        if sysDrift > sysDriftMax:
            sysDriftMax = sysDrift
        if i == VelWindowStartTick:
            sysVelRefM = sysDrift
        let bvx = w.bodyVx[ballSlot]
        let bvy = w.bodyVy[ballSlot]
        ballVEnd = numerics.CsgSqrt(bvx * bvx + bvy * bvy)
        let tqx = w.bodyQuatX[torsoSlot]
        let tqy = w.bodyQuatY[torsoSlot]
        let upz = 1.0 - 2.0 * (tqx * tqx + tqy * tqy)
        if upz < minUpz:
            minUpz = upz
        var headBelow: int32 = 0
        if w.bodyPz[headSlot] < w.bodyPz[torsoSlot]:
            headBelow = 1
            headBelowTicks = headBelowTicks + 1
            if fallTick < 0:
                fallTick = i
        # survival: ticks BEFORE the first fall only (the probe convention -
        # the post-topple wreck's head-up oscillation is not survival)
        if fallTick < 0:
            aliveTicks = aliveTicks + 1
        if i % RecordEvery == 0:
            if ti < RecordCount:
                let velMmS: float64 = (drift - prevRecDrift) * 1000.0 * PhysicsTickRateHz / float64(RecordEvery)
                recTick[ti] = i
                recTorsoZ[ti] = w.bodyPz[torsoSlot]
                recBallDrift[ti] = drift
                recSysVel[ti] = velMmS
                recBallV[ti] = ballVEnd * 1000.0
                recRelX[ti] = comX - w.bodyPx[ballSlot]
                recRelY[ti] = comY - w.bodyPy[ballSlot]
                recRelZ[ti] = w.bodyPz[torsoSlot] - w.bodyPz[ballSlot]
                recSteps[ti] = bw.stepCount
                recAlive[ti] = aliveTicks
                recHeadBelow[ti] = headBelow
                prevRecDrift = drift
                ti = ti + 1
        i = i + 1
    # buffered table out (physics loop is done)
    var k: int32 = 0
    while k < ti:
        echo("ballwalk t=" + strings.IntToStr(recTick[k]) + " walkOn=" + strings.IntToStr(walkOn) + " adaptive=" + strings.IntToStr(tune.adaptive) + " torsoZ_mm=" + fmtMm(recTorsoZ[k] * 1000.0) + " ballDrift_mm=" + fmtMm(recBallDrift[k] * 1000.0) + " sysVel_mm_s=" + fmtMm(recSysVel[k]) + " ballV_mm_s=" + fmtMm(recBallV[k]) + " relX_mm=" + fmtMm(recRelX[k] * 1000.0) + " relY_mm=" + fmtMm(recRelY[k] * 1000.0) + " relZ_mm=" + fmtMm(recRelZ[k] * 1000.0) + " steps=" + strings.IntToStr(recSteps[k]) + " alive=" + strings.IntToStr(recAlive[k]) + " headBelow=" + strings.IntToStr(recHeadBelow[k]))
        k = k + 1
    let tiltMax = probeAcos(minUpz) * joint_motor.JointMotorDegPerRad
    let avgVelMps: float64 = (sysDriftEnd - sysVelRefM) * PhysicsTickRateHz / float64(VelWindowTicks)
    rowOut.walkOn = walkOn
    rowOut.adaptive = tune.adaptive
    rowOut.fallTick = fallTick
    rowOut.aliveTicks = aliveTicks
    rowOut.headBelowTicks = headBelowTicks
    rowOut.rejected = rejected
    rowOut.firstRejectTick = firstRejectTick
    rowOut.contactSeen = st.contactSeen
    rowOut.steps = bw.stepCount
    rowOut.ballDriftMaxM = driftMax
    rowOut.torsoDriftMaxM = torsoDriftMax
    rowOut.driftEndM = driftEnd
    rowOut.sysDriftEndM = sysDriftEnd
    rowOut.sysDriftMaxM = sysDriftMax
    rowOut.avgVelMps = avgVelMps
    rowOut.ballVEndMps = ballVEnd
    rowOut.winEndTicks = bw.lastWindowTicks
    rowOut.reachEndM = bw.lastReachM
    rowOut.tiltMaxDeg = tiltMax
    echo("walkrow walkOn=" + strings.IntToStr(walkOn) + " adaptive=" + strings.IntToStr(tune.adaptive) + " fall_tick=" + strings.IntToStr(fallTick) + " alive_ticks=" + strings.IntToStr(aliveTicks) + " headBelow_ticks=" + strings.IntToStr(headBelowTicks) + " steps=" + strings.IntToStr(bw.stepCount) + " contact_seen=" + strings.IntToStr(st.contactSeen) + " ballDrift_max_mm=" + fmtMm(driftMax * 1000.0) + " ballDrift_end_mm=" + fmtMm(driftEnd * 1000.0) + " torsoDrift_max_mm=" + fmtMm(torsoDriftMax * 1000.0) + " sysDrift_end_mm=" + fmtMm(sysDriftEnd * 1000.0) + " sysDrift_max_mm=" + fmtMm(sysDriftMax * 1000.0) + " avgVel_mm_s=" + fmtMm(avgVelMps * 1000.0) + " ballV_end_mm_s=" + fmtMm(ballVEnd * 1000.0) + " winEnd_ticks=" + strings.Int64ToStr(bw.lastWindowTicks) + " reachEnd_mm=" + fmtMm(bw.lastReachM * 1000.0) + " tilt_max_deg=" + fmtMm(tiltMax) + " rejected=" + strings.IntToStr(rejected) + " firstRejectTick=" + strings.IntToStr(firstRejectTick) + " armed_end=" + strings.IntToStr(st.armed))
    if !World3dValid(w):
        echo("FAIL walkrow world validity walkOn=" + strings.IntToStr(walkOn))
        rowOut.fallTick = 0 - 2
        return
    if rejected != 0:
        echo("FAIL walkrow rejected steps at " + strings.IntToStr(firstRejectTick) + " walkOn=" + strings.IntToStr(walkOn))
        rowOut.fallTick = 0 - 2
        return
    if driftMax <= ContactProofM:
        echo("FAIL walkrow no foot-ball contact walkOn=" + strings.IntToStr(walkOn) + " (drift_mm=" + fmtMm(driftMax * 1000.0) + ")")
        rowOut.fallTick = 0 - 2
        return

# The shipped adaptive tune rides the BRAKE side of the roll axis
# (negative kR): the sweep evidence and the constant comments live in
# csg/ball_servo_rigid.cheng (BallWalkReachSpeedK / BallWalkWindowSpeedK).

fn legacyTune(): WalkTune =
    var t: WalkTune
    t.adaptive = 0
    t.winSpeedK = 0.0
    t.winMinTicks = float64(bsr.BallWalkWindowTicks)
    t.reachSpeedK = 0.0
    t.reachMaxM = 0.0
    return t

# The shipped tune (the csg/ball_servo_rigid constants, the measured
# sweep winner) pinned explicitly so the row config is visible in the
# walkcfg echo.
fn shippedTune(): WalkTune =
    var t: WalkTune
    t.adaptive = 1
    t.winSpeedK = bsr.BallWalkWindowSpeedK
    t.winMinTicks = bsr.BallWalkWindowMinTicks
    t.reachSpeedK = bsr.BallWalkReachSpeedK
    t.reachMaxM = bsr.BallWalkReachMaxM
    return t

fn main(): int32 =
    var rowCtl: WalkRow
    runWalkRow(rowCtl, 0, legacyTune())
    if rowCtl.fallTick == 0 - 2:
        echo("FAIL ball walk probe hard contract (control row above)")
        return 1
    var rowW1: WalkRow
    runWalkRow(rowW1, 1, legacyTune())
    if rowW1.fallTick == 0 - 2:
        echo("FAIL ball walk probe hard contract (caseW1 row above)")
        return 1
    var rowW2: WalkRow
    runWalkRow(rowW2, 1, shippedTune())
    if rowW2.fallTick == 0 - 2:
        echo("FAIL ball walk probe hard contract (caseW2 row above)")
        return 1
    # legacy verdict (the pre-tuning bar, kept as the caseW1 reference)
    var legacyMode: str = "dynamic"
    if rowW1.steps == 0:
        legacyMode = "static"
    var legacyVerdict: str = "FAIL"
    if rowW1.aliveTicks >= WalkStoodBarTicks:
        legacyVerdict = "PASS"
    echo("walktable walk_off alive=" + strings.IntToStr(rowCtl.aliveTicks) + " sysDrift_end_mm=" + fmtMm(rowCtl.sysDriftEndM * 1000.0) + " | caseW1 alive=" + strings.IntToStr(rowW1.aliveTicks) + " steps=" + strings.IntToStr(rowW1.steps) + " avgVel_mm_s=" + fmtMm(rowW1.avgVelMps * 1000.0) + " sysDrift_end_mm=" + fmtMm(rowW1.sysDriftEndM * 1000.0) + " legacyVerdict=" + legacyVerdict + " (mode=" + legacyMode + " bar=" + strings.IntToStr(WalkStoodBarTicks) + ")" + " | caseW2 alive=" + strings.IntToStr(rowW2.aliveTicks) + " steps=" + strings.IntToStr(rowW2.steps) + " avgVel_mm_s=" + fmtMm(rowW2.avgVelMps * 1000.0) + " sysDrift_end_mm=" + fmtMm(rowW2.sysDriftEndM * 1000.0) + " winEnd=" + strings.Int64ToStr(rowW2.winEndTicks) + " reachEnd_mm=" + fmtMm(rowW2.reachEndM * 1000.0))
    # tuned verdict (the caseW2 contract): full survival, zero rejects,
    # mean system velocity over the last VelWindowTicks under the bar
    var tunedOk: bool = rowW2.aliveTicks >= TotalTicks
    if rowW2.rejected != 0:
        tunedOk = false
    if rowW2.avgVelMps >= SysVelPassMps:
        tunedOk = false
    if tunedOk:
        echo("PASS ball walk probe (mode=tuned avgVel=" + fmtMm(rowW2.avgVelMps * 1000.0) + ")")
        return 0
    echo("FAIL ball walk probe (mode=tuned avgVel=" + fmtMm(rowW2.avgVelMps * 1000.0) + " alive=" + strings.IntToStr(rowW2.aliveTicks) + " steps=" + strings.IntToStr(rowW2.steps) + " rejected=" + strings.IntToStr(rowW2.rejected) + " sysDriftEnd_mm=" + fmtMm(rowW2.sysDriftEndM * 1000.0) + ")")
    return 1
