import cheng/core/ir/phase_arena as phase

fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 1, 32, 1)
    var arena = phase.PhaseArenaStoreOpenArena(store, 1, 32, 1)
    let staleArena = arena
    let region = phase.PhaseArenaStoreAllocRef(store, arena, 8)
    phase.PhaseArenaStoreCloseArena(store, arena)
    return phase.PhaseArenaStoreGetByte(store, staleArena, region, 0)
