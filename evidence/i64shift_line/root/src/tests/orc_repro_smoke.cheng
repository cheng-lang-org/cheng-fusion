# minimal ORC repro candidate C: cross-Result managed err.msg propagation

import std/os
import std/system
import std/rawbytes
import std/result
import cheng/std/bytes_layout as layout

fn Probe(path: str): Result[bool] =
    let r = os.ReadFileBytesResult(path)
    if !r.ok:
        return Err[bool](r.err.msg)
    if r.value.len < 10:
        return Err[bool]("too short")
    return Ok[bool](true)

fn main(): int32 =
    let miss = Probe("/tmp/orc_missing_file.bin")
    if !miss.ok:
        os.WriteLine(os.Get_stderr(), miss.err.msg)
    var buf = BytesAlloc(48)
    BytesSet(buf, 0, 1)
    let w = os.WriteFileBytesResult("/tmp/orc_c.bin", buf)
    if !w.ok:
        return 1
    let okCall = Probe("/tmp/orc_c.bin")
    if !okCall.ok:
        return 1
    echo("orc_c ok")
    return 0
