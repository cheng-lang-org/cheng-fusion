import std/os
import std/result
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/compiler_request as creq
import cheng/core/tooling/compiler_csg as ccsg
import cheng/core/tooling/compiler_parser_receipt as parser_receipt
import cheng/core/tooling/compiler_snapshot_builder as builder
import cheng/core/backend/system_link_plan as slplan
import cheng/core/lang/parser as parser
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/core/runtime/arena as arenamod

fn main(): int32 =
    let root = chengpath.PathCurrentDir()
    let sourcePath = chengpath.PathJoin(
        root, "src/tests/compiler_csg_type_arena_package_fixture.cheng")
    let outputPath = chengpath.PathJoin(
        root, "artifacts/compiler_csg/type_arena_production_smoke")
    let baseRequest = creq.CompilerRequestNew(
        root,
        sourcePath,
        outputPath,
        "arm64-apple-darwin",
        creq.EmitObj,
        "")
    let request = creq.CompilerRequestWithExportRootSymbols(
        baseRequest, ["Main", "ReadLeft", "ReadRight"])
    var plan: slplan.SystemLinkPlanStub
    var err: str
    assert(slplan.BuildSystemLinkPlanStub(root, request, plan, err), err)
    let sourceBundleRes = slplan.SystemLinkPlanSourceBundleCid(plan)
    assert(IsOk(sourceBundleRes),
           " compiler csg TypeArena: source bundle unavailable")
    var sourceReceipt: ccsg.PortableSourceIdentityReceipt
    assert(ccsg.PortableSourceIdentityReceiptMakeInto(
               plan.sourceClosurePaths.len,
               plan.importEdges.len,
               plan.unresolvedImportCount,
               plan.packageId,
               plan.ownerModulePaths[plan.sourceBundleEntrySourceIndex],
               plan.sourceBundleCidValue,
               plan.sourceBundleEntrySourceCid,
               plan.sourceBundleImportGraphCid,
               sourceReceipt,
               err), err)
    var csg: ccsg.CompilerCsg
    assert(ccsg.BuildCompilerCsgConsumePortableReceiptInto(
               csg, err, plan, sourceReceipt), err)
    assert(csg.typeArena != nil &&
           csg.typeArenaMissingResolutionAuthorityCount == 0 &&
           csg.typeArena.producerSourceCount == csg.sourceSnapshotCount &&
           !layout.FixedBytes32Equal(
               csg.typeArena.artifactRaw32, layout.FixedBytes32()) &&
           typearena.TypedExprTypeArenaStrictValidateInto(
               csg.typeArena, err),
           err)
    var typeArenaPresent: bool
    assert(builder.CompilerSnapshotProductionTypeArenaBindingStrictValidateInto(
               csg, typeArenaPresent, err) && typeArenaPresent,
           err)
    let valueDefinitionCount =
        texpr.TypedExprValueDefinitionAuthorityCount(csg.typedIr)
    assert(valueDefinitionCount == 3 &&
           csg.typedIr.valueDefinitionTypeArenaBound &&
           layout.FixedBytes32Equal(
               csg.typedIr.valueDefinitionTypeArenaArtifactCid,
               csg.typeArena.artifactRaw32) &&
           ccsg.CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
               csg, err),
           err)
    var inferredDefinitionCount: int32
    var literalDefinitionCount: int32
    var callDefinitionCount: int32
    var projectionDefinitionCount: int32
    for definitionRow in 0..<valueDefinitionCount:
        let producerSourceIndex =
            texpr.TypedExprValueDefinitionProducerSourceIndexAt(
                csg.typedIr, definitionRow)
        let declarationSourceLocalRow =
            texpr.TypedExprValueDefinitionDeclarationSourceLocalRowAt(
                csg.typedIr, definitionRow)
        let sidecar =
            csg.parserNormalizedExprReceipt.sourceSidecars[
                producerSourceIndex]
        if sidecar.declarationTypeSyntaxRootIds[
               declarationSourceLocalRow] == -1:
            inferredDefinitionCount = inferredDefinitionCount + 1
        let definingNodeIndex =
            texpr.TypedExprValueDefinitionDefiningTypedNodeIndexAt(
                csg.typedIr, definitionRow)
        let exactTypeId =
            texpr.TypedExprValueDefinitionExactTypeIdAt(
                csg.typedIr, definitionRow)
        assert(exactTypeId ==
                   texpr.TypedExprIrNodeStructuralTypeIdAt(
                       csg.typedIr, definingNodeIndex),
               " compiler csg TypeArena: producer node/value TypeId split")
        let opKind = csg.typedIr.nodes2_opKinds[definingNodeIndex]
        if opKind == texpr.TypedExprIrOpI32Const:
            literalDefinitionCount = literalDefinitionCount + 1
        elif opKind == texpr.TypedExprIrOpCallExpr:
            callDefinitionCount = callDefinitionCount + 1
        elif opKind == texpr.TypedExprIrOpIndexGet:
            projectionDefinitionCount =
                projectionDefinitionCount + 1
    assert(inferredDefinitionCount == 3 &&
           literalDefinitionCount == 1 &&
           callDefinitionCount == 1 &&
           projectionDefinitionCount == 1,
           " compiler csg TypeArena: inferred literal/call/projection coverage missing")
    assert(csg.typeArena.symbolCount == 2 &&
           csg.typeArena.resolutionCount == 2,
           " compiler csg TypeArena: exact cross-module Box SymbolIds were not retained")
    var sameSourceKindLeft: int32 = -1
    var sameSourceKindRight: int32 = -1
    for leftRow in 0..<csg.typeArena.typeSyntaxCount:
        let leftSource = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxProducerSourceIndexes,
            leftRow)
        let leftKind = arenamod.ArenaArrayInt32Get(
            csg.typeArena.arena,
            csg.typeArena.typeSyntaxParserKinds,
            leftRow)
        for rightRow in leftRow + 1..<csg.typeArena.typeSyntaxCount:
            if arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxProducerSourceIndexes,
                   rightRow) == leftSource &&
               arenamod.ArenaArrayInt32Get(
                   csg.typeArena.arena,
                   csg.typeArena.typeSyntaxParserKinds,
                   rightRow) == leftKind:
                sameSourceKindLeft = leftRow
                sameSourceKindRight = rightRow
                break
        if sameSourceKindLeft >= 0:
            break
    assert(sameSourceKindLeft >= 0 &&
           sameSourceKindRight >= 0,
           " compiler csg TypeArena: same-source same-kind TypeSyntax pair missing")
    var localRowExchange =
        typearena.TypedExprTypeArenaClone(csg.typeArena)
    let savedLeftLocalRow = arenamod.ArenaArrayInt32Get(
        localRowExchange.arena,
        localRowExchange.typeSyntaxSourceLocalRows,
        sameSourceKindLeft)
    let savedRightLocalRow = arenamod.ArenaArrayInt32Get(
        localRowExchange.arena,
        localRowExchange.typeSyntaxSourceLocalRows,
        sameSourceKindRight)
    arenamod.ArenaArrayInt32Set(
        localRowExchange.arena,
        localRowExchange.typeSyntaxSourceLocalRows,
        sameSourceKindLeft,
        savedRightLocalRow)
    arenamod.ArenaArrayInt32Set(
        localRowExchange.arena,
        localRowExchange.typeSyntaxSourceLocalRows,
        sameSourceKindRight,
        savedLeftLocalRow)
    localRowExchange.artifactRaw32 =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(
            localRowExchange)
    assert(!typearena.TypedExprTypeArenaStrictValidateInto(
                localRowExchange, err),
           " compiler csg TypeArena: same-source same-kind local-row exchange survived")
    typearena.TypedExprTypeArenaRelease(localRowExchange)
    var clone = ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    assert(clone.typeArena != nil &&
           layout.FixedBytes32Equal(
               clone.typeArena.artifactRaw32,
               csg.typeArena.artifactRaw32) &&
           typearena.TypedExprTypeArenaStrictValidateInto(
               clone.typeArena, err),
           err)
    clone.typeArena.artifactRaw32 = layout.FixedBytes32()
    assert(!builder.CompilerSnapshotProductionTypeArenaBindingStrictValidateInto(
                clone, typeArenaPresent, err),
           " compiler csg TypeArena: cloned arena tamper accepted")
    ccsg.CompilerCsgTerminalRelease(clone)
    assert(clone.typeArena == nil,
           " compiler csg TypeArena: clone release failed")
    var missingValueType = ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    arenamod.ArenaArrayInt32Set(
        missingValueType.typedIr.arena,
        missingValueType.typedIr.valueDefinitions_exactTypeIds,
        0,
        -1)
    assert(!ccsg.CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
                missingValueType, err),
           " compiler csg TypeArena: missing value-definition TypeId accepted")
    ccsg.CompilerCsgTerminalRelease(missingValueType)
    var wrongValueType = ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    arenamod.ArenaArrayInt32Set(
        wrongValueType.typedIr.arena,
        wrongValueType.typedIr.valueDefinitions_exactTypeIds,
        0,
        wrongValueType.typeArena.typeCount)
    assert(!ccsg.CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
                wrongValueType, err),
           " compiler csg TypeArena: wrong value-definition TypeId accepted")
    ccsg.CompilerCsgTerminalRelease(wrongValueType)
    var sameFlagsDifferentType =
        ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    let expectedStructuralTypeId =
        texpr.TypedExprValueDefinitionExactTypeIdAt(
            sameFlagsDifferentType.typedIr, 0)
    var sameFlagsDifferentStructuralTypeId: int32 = -1
    for typeId in 0..<sameFlagsDifferentType.typeArena.typeCount:
        if typeId != expectedStructuralTypeId &&
           typearena.TypedExprTypeArenaManagedAt(
               sameFlagsDifferentType.typeArena, typeId) ==
               typearena.TypedExprTypeArenaManagedAt(
                   sameFlagsDifferentType.typeArena,
                   expectedStructuralTypeId) &&
           typearena.TypedExprTypeArenaSendAt(
               sameFlagsDifferentType.typeArena, typeId) ==
               typearena.TypedExprTypeArenaSendAt(
                   sameFlagsDifferentType.typeArena,
                   expectedStructuralTypeId) &&
           typearena.TypedExprTypeArenaSyncAt(
               sameFlagsDifferentType.typeArena, typeId) ==
               typearena.TypedExprTypeArenaSyncAt(
                   sameFlagsDifferentType.typeArena,
                   expectedStructuralTypeId):
            sameFlagsDifferentStructuralTypeId = typeId
            break
    assert(sameFlagsDifferentStructuralTypeId >= 0,
           " compiler csg TypeArena: same-flags structural mutation unavailable")
    arenamod.ArenaArrayInt32Set(
        sameFlagsDifferentType.typedIr.arena,
        sameFlagsDifferentType.typedIr.valueDefinitions_exactTypeIds,
        0,
        sameFlagsDifferentStructuralTypeId)
    assert(!ccsg.CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
                sameFlagsDifferentType, err),
           " compiler csg TypeArena: same-flags different structural TypeId accepted")
    ccsg.CompilerCsgTerminalRelease(sameFlagsDifferentType)
    var textSubstitution = ccsg.CompilerCsgDeepCloneDiagnostic(csg)
    let expectedExactTypeId =
        texpr.TypedExprValueDefinitionExactTypeIdAt(
            textSubstitution.typedIr, 0)
    var textInternId = langintern.Intern(
        textSubstitution.typedIr.internPool,
        "__value_definition_text_identity__")
    if textInternId == expectedExactTypeId:
        textInternId = langintern.Intern(
            textSubstitution.typedIr.internPool,
            "__value_definition_text_identity_second__")
    arenamod.ArenaArrayInt32Set(
        textSubstitution.typedIr.arena,
        textSubstitution.typedIr.valueDefinitions_exactTypeIds,
        0,
        textInternId)
    assert(!ccsg.CompilerCsgTypedIrValueDefinitionTypeArenaStrictValidateInto(
                textSubstitution, err),
           " compiler csg TypeArena: intern text substituted for exact TypeId")
    ccsg.CompilerCsgTerminalRelease(textSubstitution)
    let savedLayoutOutput =
        csg.layoutDiagnosticCompletions.outputArtifactCids[0]
    csg.layoutDiagnosticCompletions.outputArtifactCids[
        0] = layout.FixedBytes32()
    assert(!ccsg.CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
               csg, err),
           " compiler csg diagnostic: layout output mutation survived")
    csg.layoutDiagnosticCompletions.outputArtifactCids[
        0] = savedLayoutOutput
    add(csg.layoutDiagnosticCompletions.diagnosticSourceIds, 0)
    assert(!ccsg.CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
               csg, err),
           " compiler csg diagnostic: partial layout row survived")
    csg.layoutDiagnosticCompletions.diagnosticSourceIds = []
    var exactLayoutNodeId: int32 = -1
    for nodeId in 0..<csg.typedIr.nodes2_nodeIndexs.len:
        let fieldSize = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_fieldSizeBytes,
            nodeId)
        let fieldAlign = arenamod.ArenaArrayInt32Get(
            csg.typedIr.arena,
            csg.typedIr.nodes2_fieldAlignBytes,
            nodeId)
        if fieldSize > 0 && fieldAlign > 0:
            exactLayoutNodeId = nodeId
            break
    assert(exactLayoutNodeId >= 0,
           " compiler csg diagnostic: exact layout authority row missing")
    let savedFieldOffset = arenamod.ArenaArrayInt32Get(
        csg.typedIr.arena,
        csg.typedIr.nodes2_fieldOffsetBytes,
        exactLayoutNodeId)
    arenamod.ArenaArrayInt32Set(
        csg.typedIr.arena,
        csg.typedIr.nodes2_fieldOffsetBytes,
        exactLayoutNodeId,
        savedFieldOffset + 1)
    assert(!ccsg.CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
               csg, err),
           " compiler csg diagnostic: exact layout coordinate mutation survived")
    arenamod.ArenaArrayInt32Set(
        csg.typedIr.arena,
        csg.typedIr.nodes2_fieldOffsetBytes,
        exactLayoutNodeId,
        savedFieldOffset)
    assert(csg.layoutDiagnosticCompletions.exactLayoutSourceRowIndexes.len > 0,
           " compiler csg diagnostic: exact layout source CSR missing")
    let savedExactLayoutSourceRow =
        csg.layoutDiagnosticCompletions.exactLayoutSourceRowIndexes[0]
    csg.layoutDiagnosticCompletions.exactLayoutSourceRowIndexes[0] =
        csg.layoutDiagnosticCompletions.exactLayoutSourceIds.len
    assert(!ccsg.CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
               csg, err),
           " compiler csg diagnostic: exact layout source CSR mutation survived")
    csg.layoutDiagnosticCompletions.exactLayoutSourceRowIndexes[0] =
        savedExactLayoutSourceRow
    var leftBoxLayoutRow: int32 = -1
    var rightBoxLayoutRow: int32 = -1
    for layoutRow in 0..<
            csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds.len:
        let typeId =
            csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[
                layoutRow]
        if typeId < 0:
            continue
        let symbolId =
            typearena.TypedExprTypeArenaSymbolIdAt(
                csg.typeArena, typeId)
        if symbolId == 0:
            leftBoxLayoutRow = layoutRow
        elif symbolId == 1:
            rightBoxLayoutRow = layoutRow
    assert(leftBoxLayoutRow >= 0 &&
           rightBoxLayoutRow >= 0 &&
           csg.layoutDiagnosticCompletions.exactLayoutSourceIds[
               leftBoxLayoutRow] !=
               csg.layoutDiagnosticCompletions.exactLayoutSourceIds[
                   rightBoxLayoutRow] &&
           csg.layoutDiagnosticCompletions.exactLayoutSizeBytes[
               leftBoxLayoutRow] ==
               csg.layoutDiagnosticCompletions.exactLayoutSizeBytes[
                   rightBoxLayoutRow] &&
           csg.layoutDiagnosticCompletions.exactLayoutAlignBytes[
               leftBoxLayoutRow] ==
               csg.layoutDiagnosticCompletions.exactLayoutAlignBytes[
                   rightBoxLayoutRow] &&
           csg.layoutDiagnosticCompletions.exactLayoutFieldCounts[
               leftBoxLayoutRow] ==
               csg.layoutDiagnosticCompletions.exactLayoutFieldCounts[
                   rightBoxLayoutRow],
           " compiler csg diagnostic: cross-source same-name layout domain missing")
    let savedRightBoxTypeId =
        csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[
            rightBoxLayoutRow]
    csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[
        rightBoxLayoutRow] =
        csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[
            leftBoxLayoutRow]
    assert(!ccsg.CompilerCsgLayoutDiagnosticCompletionStrictValidateInto(
               csg, err),
           " compiler csg diagnostic: cross-source same-name TypeId substitution survived")
    csg.layoutDiagnosticCompletions.exactLayoutTypeArenaIds[
        rightBoxLayoutRow] = savedRightBoxTypeId
    let identitySourcePath = "/virtual/exact-layout-reorder.cheng"
    let identitySourceText =
        "type\n    First =\n        firstValue: int32\n\n    Second =\n        secondValue: int64\n"
    var identitySourcePaths: str[]
    var identityOwnerModulePaths: str[]
    var identityImportEdges: parser.ImportEdge[]
    add(identitySourcePaths, share(identitySourcePath))
    add(identityOwnerModulePaths, "tests/exact-layout-reorder")
    let identityAccumulatorRes =
        parser_receipt.ParserNormalizedExprReceiptAccumulatorInit(
            plan.sourceBundleCidValue,
            identitySourcePaths,
            identityOwnerModulePaths,
            identityImportEdges,
            0)
    assert(IsOk(identityAccumulatorRes),
           " compiler csg exact layout: identity accumulator missing")
    var identityAccumulator = Value(identityAccumulatorRes)
    var identityFunctions: parser_receipt.ParserNormalizedExprFunctionIdentity[]
    var identityDeclarations: parser.NormalizedFunctionDecl[]
    assert(parser.ParserReadNormalizedFunctionDecls(
               identitySourceText, identityDeclarations, err), err)
    let identityObserveRes =
        parser_receipt.ParserNormalizedExprReceiptObserveSourceText(
            identityAccumulator,
            0,
            identitySourceText,
            false,
            identityFunctions,
            identityDeclarations)
    assert(IsOk(identityObserveRes),
           " compiler csg exact layout: identity parser observation failed")
    var identityReachable: bool[]
    let identityReceiptRes =
        parser_receipt.ParserNormalizedExprReceiptFinalize(
            identityAccumulator, identityReachable)
    assert(IsOk(identityReceiptRes),
           " compiler csg exact layout: identity parser receipt missing")
    let identityReceipt = Value(identityReceiptRes)
    assert(identityReceipt.sourceSidecars.len == 1,
           " compiler csg exact layout: identity sidecar missing")
    let identitySource = texpr.TypedExprSourceTextNew(
        root,
        root,
        identitySourcePath,
        identitySourceText)
    var declaredReordered: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildSourceContext(
               identitySource, declaredReordered, err), err)
    assert(declaredReordered.declaredTypes.len == 2,
           " compiler csg exact layout: declared reorder domain missing")
    let firstDeclaredType = declaredReordered.declaredTypes[0]
    declaredReordered.declaredTypes[0] =
        declaredReordered.declaredTypes[1]
    declaredReordered.declaredTypes[1] = firstDeclaredType
    assert(!ccsg.CompilerCsgBindMetadataExactLayoutParserIdentities(
               declaredReordered,
               identityReceipt.sourceSidecars[0],
               identitySourceText,
               0,
               1,
               err),
           " compiler csg exact layout: same-source declared type reorder survived")
    texpr.TypedExprClearSourceContextAllFields(declaredReordered)
    var fieldsReordered: texpr.TypedExprSourceContext
    assert(texpr.TypedExprBuildSourceContext(
               identitySource, fieldsReordered, err), err)
    assert(fieldsReordered.typeFields.len == 2,
           " compiler csg exact layout: field reorder domain missing")
    let firstField = fieldsReordered.typeFields[0]
    fieldsReordered.typeFields[0] = fieldsReordered.typeFields[1]
    fieldsReordered.typeFields[1] = firstField
    assert(!ccsg.CompilerCsgBindMetadataExactLayoutParserIdentities(
               fieldsReordered,
               identityReceipt.sourceSidecars[0],
               identitySourceText,
               0,
               1,
               err),
           " compiler csg exact layout: same-source field reorder survived")
    texpr.TypedExprClearSourceContextAllFields(fieldsReordered)
    ccsg.CompilerCsgTerminalRelease(csg)
    assert(csg.typeArena == nil,
           " compiler csg TypeArena: terminal release failed")
    let missingSourcePath = chengpath.PathJoin(
        root,
        "src/tests/compiler_csg_type_arena_missing_nominal_fixture.cheng")
    let missingOutputPath = chengpath.PathJoin(
        root, "artifacts/compiler_csg/type_arena_missing_nominal_smoke")
    let missingBaseRequest = creq.CompilerRequestNew(
        root,
        missingSourcePath,
        missingOutputPath,
        "arm64-apple-darwin",
        creq.EmitObj,
        "")
    let missingRequest = creq.CompilerRequestWithExportRootSymbols(
        missingBaseRequest, ["main"])
    var missingPlan: slplan.SystemLinkPlanStub
    assert(slplan.BuildSystemLinkPlanStub(
               root, missingRequest, missingPlan, err), err)
    let missingBundleRes =
        slplan.SystemLinkPlanSourceBundleCid(missingPlan)
    assert(IsOk(missingBundleRes),
           " compiler csg TypeArena: missing-authority source bundle unavailable")
    var missingSourceReceipt: ccsg.PortableSourceIdentityReceipt
    assert(ccsg.PortableSourceIdentityReceiptMakeInto(
               missingPlan.sourceClosurePaths.len,
               missingPlan.importEdges.len,
               missingPlan.unresolvedImportCount,
               missingPlan.packageId,
               missingPlan.ownerModulePaths[
                   missingPlan.sourceBundleEntrySourceIndex],
               missingPlan.sourceBundleCidValue,
               missingPlan.sourceBundleEntrySourceCid,
               missingPlan.sourceBundleImportGraphCid,
               missingSourceReceipt,
               err), err)
    var missingCsg: ccsg.CompilerCsg
    assert(!ccsg.BuildCompilerCsgConsumePortableReceiptInto(
                missingCsg, err, missingPlan, missingSourceReceipt) &&
           missingCsg.typeArena == nil &&
           missingCsg.typeArenaMissingResolutionAuthorityCount == 0 &&
           strutil.Contains(err, "TypeArena resolution authority failed"),
           Fmt" compiler csg TypeArena: unresolved nominal did not hard-fail {err}")
    assert(!builder.CompilerSnapshotProductionTypeArenaBindingStrictValidateInto(
                missingCsg, typeArenaPresent, err),
           " compiler csg TypeArena: missing arena entered builder")
    ccsg.CompilerCsgTerminalRelease(missingCsg)
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_type_arena_production=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_value_definition_exact_type_bridge=1")
    os.WriteLine(os.Get_stdout(),
                 "compiler_csg_value_definition_type_mutations_rejected=1")
    return 0
