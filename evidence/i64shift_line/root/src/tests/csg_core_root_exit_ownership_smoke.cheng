import std/os as os
import cheng/core/csg_core/validator as csg

fn main(): int32 =
    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleFact =
        "{\"id\":\"mod_main\",\"kind\":\"csg.module\",\"path\":\"main.ts\",\"sha256\":\"sha256:abc\"}"
    let root =
        csg.CsgCoreFactsRootFromCanonicalLines(
            [schema, moduleFact])
    os.WriteLine(os.Get_stdout(), root)
    return 0
