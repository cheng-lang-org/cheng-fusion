import std/os as os
import std/rawbytes
import std/strings
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/merkle_store_codec

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(): int32 =
    let controlQuoted =
        merkle_store_codec.CsgCoreMerkleStoreJsonString(
            "a\x00\x08\x0c\n\r\t\"\\z")
    if controlQuoted !=
       "\"a\\u0000\\b\\f\\n\\r\\t\\\"\\\\z\"":
        return fail(
            "store codec did not use canonical control-byte quoting")
    var parsed: int32
    if !merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "2147483647", parsed) ||
       parsed != 2147483647 ||
       !merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "-2147483648", parsed) ||
       parsed != -2147483647 - 1 ||
       !merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "0", parsed) ||
       parsed != 0:
        return fail("bounded int32 parser rejected a boundary")
    if merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "2147483648", parsed) ||
       merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "-2147483649", parsed) ||
       merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "-0", parsed) ||
       merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "+1", parsed) ||
       merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "01", parsed) ||
       merkle_store_codec.CsgCoreMerkleStoreParseInt32(
           "999999999999999999999999999999999999", parsed):
        return fail("bounded int32 parser accepted non-canonical input")
    let schema = "{\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\",\"features\":[\"core-facts\"]}"
    let moduleA = "{\"kind\":\"csg.module\",\"id\":\"mod_a\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let symbolA = "{\"kind\":\"csg.symbol\",\"id\":\"sym_a\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    let symbolB = "{\"kind\":\"csg.symbol\",\"id\":\"sym_b\",\"name\":\"B\",\"symbolKind\":\"fn\"}"
    let dag = merkle_dag.CsgCoreMerkleBuild(
        [schema, moduleA, symbolA, symbolB])
    if !dag.ok:
        return fail("node segment DAG build failed")

    var nodes: merkle_dag.CsgCoreMerkleNodeRecord[]
    for nodeIndex in 0..<dag.nodeKinds.len:
        var nodeError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, nodeIndex, nodeError)
        if nodeError.len > 0:
            return fail("node projection failed")
        add(nodes, node)

    let encoded =
        merkle_store_codec.CsgCoreMerkleNodeSegmentEncode(
            nodes)
    if !encoded.ok ||
       encoded.nodeCount != 7 ||
       encoded.cid !=
           "sha256:78bbd3a4f7781403e07096dff456ed3dc5b4fa5f7dfaf46bdb2276670dc40d04":
        return fail(strings.ConcatStr(
            "node segment encode failed: ",
            encoded.error))
    let decoded =
        merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(
            encoded.bytes)
    if !decoded.ok ||
       decoded.cid != encoded.cid ||
       decoded.nodeCount != encoded.nodeCount ||
       decoded.byteCount !=
           rawbytes.BytesLen(decoded.bytes) ||
       !rawbytes.BytesEqual(
           decoded.bytes, encoded.bytes):
        return fail(strings.ConcatStr(
            "node segment decode failed: ",
            decoded.error))
    let reencoded =
        merkle_store_codec.CsgCoreMerkleNodeSegmentEncode(
            decoded.nodes)
    if !reencoded.ok ||
       reencoded.cid != encoded.cid ||
       !rawbytes.BytesEqual(
           encoded.bytes, reencoded.bytes):
        return fail("node segment roundtrip mismatch")

    var reversed: merkle_dag.CsgCoreMerkleNodeRecord[]
    var reverseIndex = dag.nodeKinds.len - 1
    while reverseIndex >= 0:
        var nodeError: str
        let node =
            merkle_dag.CsgCoreMerkleDagNodeRecord(
                dag, reverseIndex, nodeError)
        if nodeError.len > 0:
            return fail("reverse node projection failed")
        add(reversed, node)
        reverseIndex = reverseIndex - 1
    let reordered =
        merkle_store_codec.CsgCoreMerkleNodeSegmentEncode(
            reversed)
    if !reordered.ok ||
       reordered.cid != encoded.cid ||
       !rawbytes.BytesEqual(
           reordered.bytes, encoded.bytes):
        return fail("node segment input order changed bytes")
    if reordered.lines.len != encoded.lines.len ||
       reordered.nodes.len != encoded.nodes.len:
        return fail(
            "node segment canonical projection count changed")
    for i in 0..<encoded.lines.len:
        if reordered.lines[i] != encoded.lines[i] ||
           merkle_dag.CsgCoreMerkleNodeRecordCid(
               reordered.nodes[i]) !=
           merkle_dag.CsgCoreMerkleNodeRecordCid(
               encoded.nodes[i]):
            return fail(
                "node segment canonical projection changed")

    let duplicate =
        merkle_store_codec.CsgCoreMerkleNodeSegmentEncode(
            [nodes[0], nodes[0]])
    if duplicate.ok ||
       !strings.StrContains(
           duplicate.error, "duplicate"):
        return fail("duplicate node identity accepted")

    let firstLine = encoded.lines[0]
    let extraLine =
        strings.ConcatStr(
            strings.CloneStrRange(
                firstLine, 0, firstLine.len - 1),
            ",\"unexpected\":\"x\"}")
    var extraNode: merkle_dag.CsgCoreMerkleNodeRecord
    var extraError: str
    if merkle_store_codec.CsgCoreMerkleNodeRecordDecode(
           extraLine, extraNode, extraError) ||
       !strings.StrContains(
           extraError, "non_canonical"):
        return fail("node segment extra field accepted")

    var tampered =
        rawbytes.BytesAlloc(
            rawbytes.BytesLen(encoded.bytes))
    rawbytes.BytesCopyInto(
        tampered, 0, encoded.bytes)
    let last = rawbytes.BytesLen(tampered) - 1
    rawbytes.BytesSet(
        tampered,
        last,
        rawbytes.BytesGet(tampered, last) ^ 1)
    let tamperedDecoded =
        merkle_store_codec.CsgCoreMerkleNodeSegmentDecode(
            tampered)
    rawbytes.BytesFree(tampered)
    if tamperedDecoded.ok:
        return fail("tampered node segment accepted")

    os.WriteLine(os.Get_stdout(), encoded.cid)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_store_codec_smoke ok")
    rawbytes.BytesFree(reordered.bytes)
    rawbytes.BytesFree(reencoded.bytes)
    rawbytes.BytesFree(decoded.bytes)
    rawbytes.BytesFree(encoded.bytes)
    return 0
