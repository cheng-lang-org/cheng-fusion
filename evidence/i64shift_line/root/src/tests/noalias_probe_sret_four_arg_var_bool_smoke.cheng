type
    ProbeReport =
        a: int32
        b: int32
        c: int32
        d: int32
        e: int32
        f: int32

fn ProbeSretFourArg(a: int32,
                    b: int32,
                    c: int32,
                    out: var bool): ProbeReport =
    out = a == 1 && b == 2 && c == 3
    var report: ProbeReport
    report.a = 77
    report.f = 9
    return report

fn main(): int32 =
    var ok = false
    let report = ProbeSretFourArg(1, 2, 3, ok)
    if !ok:
        return 66
    if report.f != 9:
        return 67
    return report.a
