import cheng/core/backend/lowering_plan as lower
import cheng/tests/noalias_finalize_stage_probe_lib as probe
import cheng/tests/noalias_lowering_param_probe_lib as lowerprobe

fn main(): int32 =
    var fnIr: lower.PrimaryObjectIrFunction
    fnIr.functionName = "NoAliasLoweringParamProbe"
    fnIr.bodyKind = "statement_sequence"
    fnIr.bodyIR = probe.ProbeForwardBody(true)
    lowerprobe.ProbeTouchLoweringFn(fnIr)
    if !fnIr.bodyIrNoAliasApplied:
        return 71
    if fnIr.bodyIrNoAliasLocalCount != 2:
        return 72
    if fnIr.bodyIrNoAliasForwardRewriteCount != 2:
        return 73
    return 77
