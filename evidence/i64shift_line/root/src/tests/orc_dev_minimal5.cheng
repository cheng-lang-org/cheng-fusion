# minimal probe 5: BfsApplyFile call, no Err propagation in caller
import std/system
import std/rawbytes
import std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_bridge_fs as bfs

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var st = ssm.SsmInit()
    let r = bfs.BfsApplyFile(st, "/tmp/orc_dev_missing5.bin", Tag(80), Int64(100), Int64(10))
    echo("called")
    return 0
