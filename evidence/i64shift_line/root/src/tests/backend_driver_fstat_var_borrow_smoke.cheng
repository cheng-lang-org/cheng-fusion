import std/cmdline
import std/fs
import std/result
import cheng/core/tooling/backend_driver_dispatch_min as dispatch

type
    BackendDriverFstatVarBorrowProbeIdentity =
        size: int64
        mode: int32
        device: uint64
        inode: uint64
        mtimeSec: int64
        mtimeNsec: int64
        ctimeSec: int64
        ctimeNsec: int64
        changeVersion: uint64

fn BackendDriverFstatVarBorrowDigestIsLowerHex(value: str): bool =
    if value.len != 64:
        return false
    for i in 0..<value.len:
        let c = value[i]
        if !((c >= '0' && c <= '9') ||
             (c >= 'a' && c <= 'f')):
            return false
    return true

fn main(): int32 =
    let executablePathRes = fs.Realpath(cmdline.ProgramName())
    if IsErr(executablePathRes):
        return 2
    let executablePath = Value(executablePathRes)
    let executableFd = dispatch.BackendDriverDispatchMinOpenReadBridge(
        strToCStringTemp(share(executablePath)), int32(0), int32(0))
    if executableFd < 0:
        return 3

    var probe: BackendDriverFstatVarBorrowProbeIdentity
    probe.size = int64(-1)
    probe.mode = int32(-1)
    probe.device = uint64(9223372036854775807)
    probe.inode = uint64(9223372036854775807)
    probe.mtimeSec = int64(-1)
    probe.mtimeNsec = int64(-1)
    probe.ctimeSec = int64(-1)
    probe.ctimeNsec = int64(-1)
    probe.changeVersion = uint64(9223372036854775807)
    let fstatRc =
        dispatch.BackendDriverDispatchMinHostFstatIdentityBridge(
            executableFd,
            probe.size,
            probe.mode,
            probe.device,
            probe.inode,
            probe.mtimeSec,
            probe.mtimeNsec,
            probe.ctimeSec,
            probe.ctimeNsec,
            probe.changeVersion)
    let closeRc =
        dispatch.BackendDriverDispatchMinCloseBridge(executableFd)
    if fstatRc != 0 || closeRc != 0:
        return 4
    if probe.size <= 0 ||
       (probe.mode & int32(61440)) != int32(32768) ||
       probe.device == uint64(0) ||
       probe.device == uint64(9223372036854775807) ||
       probe.inode == uint64(0) ||
       probe.inode == uint64(9223372036854775807) ||
       probe.mtimeSec <= int64(0) ||
       probe.mtimeNsec < int64(0) ||
       probe.mtimeNsec >= int64(1000000000) ||
       probe.ctimeSec <= int64(0) ||
       probe.ctimeNsec < int64(0) ||
       probe.ctimeNsec >= int64(1000000000) ||
       probe.changeVersion == uint64(9223372036854775807):
        return 5

    var digest: str
    if !dispatch.BackendDriverDispatchMinReadStablePinnedFileSha256Hex(
            "", executablePath, digest):
        return 6
    if !BackendDriverFstatVarBorrowDigestIsLowerHex(digest):
        return 7
    echo("BACKEND_DRIVER_FSTAT_VAR_BORROW_OK")
    return 0
