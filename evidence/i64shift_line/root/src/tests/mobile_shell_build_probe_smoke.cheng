import std/os
import std/strings
import std/strutils as strutil
import cheng/core/tooling/path as chengpath
import cheng/core/tooling/mobile_shell_codegen as mshell

fn MobileShellAssertExportcNoPtr(sourceText: str) =
    let lines = strutil.Split(sourceText, '\n')
    for i in 0..<lines.len:
        if !strings.StrContains(lines[i], "@exportc("):
            continue
        var signature = ""
        for j in (i + 1)..<lines.len:
            let trimmed = chengpath.PathTrim(lines[j])
            if len(trimmed) <= 0:
                continue
            signature = strutil.Join([signature, " ", trimmed], "")
            if strings.StrContains(trimmed, "="):
                break
            if j - i > 8:
                break
        assert(!strings.StrContains(signature, " ptr"),
               " mobile_shell_build_probe_smoke: exportc ptr surface")
        assert(!strings.StrContains(signature, ":ptr"),
               " mobile_shell_build_probe_smoke: exportc ptr compact surface")
        assert(!strings.StrContains(signature, "):ptr"),
               " mobile_shell_build_probe_smoke: exportc ptr return surface")

fn MobileShellAssertMobileCapiBridgeSurface(root: str) =
    let mobileCapiPath = "src/mobile/mobile_capi.cheng"
    let mobileCapiText = chengpath.ReadTextFile(root, mobileCapiPath)
    assert(len(mobileCapiText) > 0,
           " mobile_shell_build_probe_smoke: mobile capi source")
    MobileShellAssertExportcNoPtr(mobileCapiText)
    assert(!strings.StrContains(mobileCapiText, "fn mobileCapiTextCString"),
           " mobile_shell_build_probe_smoke: local text cstring wrapper removed")
    assert(!strings.StrContains(mobileCapiText, "fn mobileCapiCopyRawText"),
           " mobile_shell_build_probe_smoke: local raw copy wrapper removed")
    assert(!strings.StrContains(mobileCapiText, "mobileCapiTextCString("),
           " mobile_shell_build_probe_smoke: local text cstring calls removed")
    assert(!strings.StrContains(mobileCapiText, "mobileCapiCopyRawText("),
           " mobile_shell_build_probe_smoke: local raw copy calls removed")
    assert(!strings.StrContains(mobileCapiText, "mobileCapiCopyRawTextLen("),
           " mobile_shell_build_probe_smoke: local raw copy len calls removed")
    assert(strings.StrContains(mobileCapiText, "bridge.InternalMobileBridgeTextCString"),
           " mobile_shell_build_probe_smoke: internal bridge text cstring")
    assert(strings.StrContains(mobileCapiText, "bridge.InternalMobileBridgeCopyRawText"),
           " mobile_shell_build_probe_smoke: internal bridge raw copy")
    assert(strings.StrContains(mobileCapiText, "bridge.InternalMobileBridgeBufferHandleCopy(rawData, textLen)"),
           " mobile_shell_build_probe_smoke: text buffer handle copy bridge")
    assert(strings.StrContains(mobileCapiText, "bridge.InternalMobileBridgeBufferHandleCopy(payloadData, payloadLen)"),
           " mobile_shell_build_probe_smoke: bytes buffer handle copy bridge")
    assert(!strings.StrContains(mobileCapiText, "bytesFree(snapshot)"),
           " mobile_shell_build_probe_smoke: no freed snapshot handle")
    assert(!strings.StrContains(mobileCapiText, "while i < payloadLen"),
           " mobile_shell_build_probe_smoke: no payload while copy")
    assert(!strings.StrContains(mobileCapiText, "InternalMobileBridgeBufferHandle(snapshotData"),
           " mobile_shell_build_probe_smoke: no raw snapshot handle")

fn main(): int32 =
    let root: str = os.GetCurrentDir()
    MobileShellAssertMobileCapiBridgeSurface(root)
    let mobileShellCodegenText: str = chengpath.ReadTextFile(root, "src/core/tooling/mobile_shell_codegen.cheng")
    assert(strings.StrContains(mobileShellCodegenText, "libEGL.so"),
           " mobile_shell_build_probe_smoke: prebuilt links egl")
    assert(strings.StrContains(mobileShellCodegenText, "libGLESv3.so"),
           " mobile_shell_build_probe_smoke: prebuilt links gles3")
    assert(strings.StrContains(mobileShellCodegenText, "libmediandk.so"),
           " mobile_shell_build_probe_smoke: prebuilt links media ndk")
    assert(strings.StrContains(mobileShellCodegenText, "libm.so"),
           " mobile_shell_build_probe_smoke: prebuilt links libm")
    assert(strings.StrContains(mobileShellCodegenText, "cheng_resolve_required_app_export(\"cheng_app_pause\")"),
           " mobile_shell_build_probe_smoke: android host requires app pause export")
    assert(strings.StrContains(mobileShellCodegenText, "cheng_app_text_input_utf8_fn"),
           " mobile_shell_build_probe_smoke: android host text input bridge")
    assert(strings.StrContains(mobileShellCodegenText, "textInput.addTextChangedListener(object : TextWatcher"),
           " mobile_shell_build_probe_smoke: android activity text watcher")
    assert(strings.StrContains(mobileShellCodegenText, "throw IllegalStateException(\"cheng native runtime create failed\")"),
           " mobile_shell_build_probe_smoke: android activity hard-fails null native runtime")
    let outDir: str = chengpath.PathAbsolute(root, "artifacts/mobile_shell_build_probe_smoke")
    assert(chengpath.MkdirP(root, outDir), " mobile_shell_build_probe_smoke: mkdir")
    var output: str
    var errorText: str
    let rc: int32 = mshell.MobileShellRun(root,
                                               [
                                                   "build-probe",
                                                   "--platform:none",
                                                   Fmt"--out-dir:{outDir}"
                                               ],
                                           output,
                                           errorText)
    assert(rc == 0, " mobile_shell_build_probe_smoke: verify rc")
    assert(len(errorText) == 0, " mobile_shell_build_probe_smoke: empty error")
    assert(strings.StrContains(output, "mobile-shell build-probe ok"),
           " mobile_shell_build_probe_smoke: build probe output")
    let summaryPath: str = chengpath.PathJoin(outDir, "mobile_shell_build_probe.summary.env")
    let summaryText: str = chengpath.ReadTextFile(root, summaryPath)
    assert(strings.StrContains(summaryText, "format=mobile_shell_build_probe_summary_v1"),
           " mobile_shell_build_probe_smoke: summary format")
    assert(strings.StrContains(summaryText, "runtime_mode=cheng_app_exports_v1"),
           " mobile_shell_build_probe_smoke: summary runtime mode")
    assert(strings.StrContains(summaryText, "host_render_abi=cheng_mobile_host_render_v1"),
           " mobile_shell_build_probe_smoke: summary host render abi")
    assert(strings.StrContains(summaryText, "host_render_exports=cheng_mobile_host_present,cheng_mobile_host_present_gpu_commands,cheng_mobile_host_present_compositor_frame,cheng_mobile_host_present_media_surface_commands,cheng_mobile_host_prepare_media_surface_texture,cheng_mobile_host_register_media_surface_texture,cheng_mobile_host_upload_image_atlas,cheng_mobile_host_upload_svg_display_list_atlas,cheng_mobile_host_upload_glyph_sdf_atlas,cheng_mobile_host_upload_glyph_sdf_atlas_bytes,cheng_mobile_host_set_ink_fade,cheng_mobile_host_upload_ink_field,cheng_mobile_host_present_overlay_refresh,cheng_mobile_host_begin_offscreen_capture,cheng_mobile_host_read_offscreen_pixels"),
           " mobile_shell_build_probe_smoke: summary host render exports")
    assert(strings.StrContains(summaryText, "android_host_render_abi_bound=0"),
           " mobile_shell_build_probe_smoke: summary android not selected")
    assert(strings.StrContains(summaryText, "android_host_capture_abi_bound=0"),
           " mobile_shell_build_probe_smoke: summary android capture not selected")
    assert(strings.StrContains(summaryText, "android_native_scene_renderer_supported=0"),
           " mobile_shell_build_probe_smoke: summary android renderer not selected")
    assert(strings.StrContains(summaryText, "android_native_scene_capture_supported=0"),
           " mobile_shell_build_probe_smoke: summary android capture unsupported")
    assert(strings.StrContains(summaryText, "android_native_scene_renderer_backend=not_selected"),
           " mobile_shell_build_probe_smoke: summary android backend not selected")
    assert(strings.StrContains(summaryText, "ios_host_render_abi_bound=0"),
           " mobile_shell_build_probe_smoke: summary ios host renderer unsupported")
    assert(strings.StrContains(summaryText, "ios_native_scene_renderer_supported=0"),
           " mobile_shell_build_probe_smoke: summary ios renderer unsupported")
    assert(strings.StrContains(summaryText, "harmony_host_render_abi_bound=0"),
           " mobile_shell_build_probe_smoke: summary harmony host renderer unsupported")
    assert(strings.StrContains(summaryText, "harmony_native_scene_renderer_supported=0"),
           " mobile_shell_build_probe_smoke: summary harmony renderer unsupported")

    let androidSummaryPath: str = chengpath.PathJoin(outDir, "android_selected_build_probe.summary.env")
    assert(mshell.MobileShellWriteBuildProbeSummary(androidSummaryPath,
                                                    true,
                                                    false,
                                                    false,
                                                    "r2c_native_gui_v1"),
           " mobile_shell_build_probe_smoke: android selected summary write")
    let androidSummaryText: str = chengpath.ReadTextFile(root, androidSummaryPath)
    assert(strings.StrContains(androidSummaryText, "runtime_mode=r2c_native_gui_v1"),
           " mobile_shell_build_probe_smoke: android summary native runtime")
    assert(strings.StrContains(androidSummaryText, "android_host_render_abi_bound=1"),
           " mobile_shell_build_probe_smoke: android summary host render bound")
    assert(strings.StrContains(androidSummaryText, "android_host_capture_abi_bound=1"),
           " mobile_shell_build_probe_smoke: android summary host capture bound")
    assert(strings.StrContains(androidSummaryText, "android_native_scene_renderer_supported=1"),
           " mobile_shell_build_probe_smoke: android summary native renderer supported")
    assert(strings.StrContains(androidSummaryText, "android_native_scene_renderer_backend=egl_gles3"),
           " mobile_shell_build_probe_smoke: android summary gles backend")
    assert(strings.StrContains(androidSummaryText, "android_native_scene_renderer_surface=ANativeWindow"),
           " mobile_shell_build_probe_smoke: android summary native surface")
    assert(strings.StrContains(androidSummaryText, "android_native_scene_capture_supported=1"),
           " mobile_shell_build_probe_smoke: android summary native capture supported")
    assert(strings.StrContains(androidSummaryText, "android_native_scene_capture_backend=egl_pbuffer_gles3"),
           " mobile_shell_build_probe_smoke: android summary capture pbuffer backend")
    assert(strings.StrContains(androidSummaryText, "android_native_scene_capture_output=rgba_top_left"),
           " mobile_shell_build_probe_smoke: android summary capture rgba output")
    assert(strings.StrContains(androidSummaryText, "ios_native_scene_renderer_supported=0"),
           " mobile_shell_build_probe_smoke: android summary ios unsupported")
    assert(strings.StrContains(androidSummaryText, "harmony_native_scene_renderer_supported=0"),
           " mobile_shell_build_probe_smoke: android summary harmony unsupported")

    var nativeAndroidCmakeOutput: str
    var nativeAndroidCmakeError: str
    let nativeAndroidCmakeRc: int32 = mshell.MobileShellRun(root,
                                                            [
                                                                "build-probe",
                                                                "--platform:android",
                                                                "--runtime-mode:r2c_native_gui_v1",
                                                                "--route-state:home_default",
                                                                Fmt"--out-dir:{outDir}_native_android_cmake"
                                                            ],
                                                            nativeAndroidCmakeOutput,
                                                            nativeAndroidCmakeError)
    assert(nativeAndroidCmakeRc == 1, " mobile_shell_build_probe_smoke: native android cmake rc")
    assert(strings.StrContains(nativeAndroidCmakeError, "requires --android-native-mode prebuilt"),
           " mobile_shell_build_probe_smoke: native android requires prebuilt")

    var nativeOutput: str
    var nativeErrorText: str
    let nativeRc: int32 = mshell.MobileShellRun(root,
                                                [
                                                    "build-probe",
                                                    "--platform:all",
                                                    "--runtime-mode:r2c_native_gui_v1",
                                                    "--route-state:home_default",
                                                    Fmt"--out-dir:{outDir}_native_all"
                                                ],
                                                nativeOutput,
                                                nativeErrorText)
    assert(nativeRc == 1, " mobile_shell_build_probe_smoke: native all-platform rc")
    assert(strings.StrContains(nativeErrorText, "native scene renderer is implemented only for android"),
           " mobile_shell_build_probe_smoke: native all-platform renderer error")
    assert(strings.StrContains(nativeErrorText, "unsupported platforms: ios,harmony"),
           " mobile_shell_build_probe_smoke: native all-platform unsupported list")
    echo(output)
    echo("verify-mobile-shell-build-probe: ok")
    echo(" mobile_shell_build_probe_smoke ok")
    return 0
