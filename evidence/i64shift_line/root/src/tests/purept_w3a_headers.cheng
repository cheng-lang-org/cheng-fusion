# W3a headers driver: RFC 9001 A.2/A.3 unprotected Initial headers parsed
# field-by-field, A.5 short header, Appendix A.2/A.3 packet-number encoding
# examples, Version Negotiation encode/parse round-trip, 32 Initial-header
# encode->parse->re-encode round-trips, and header negatives. Exits non-zero
# on any mismatch.

import std/os
import std/rawbytes
import std/strings as strings
import cheng/quic/pure/frames_varint as quicvarint
import cheng/quic/pure/frames_header as quichdr

var gFails: int32

@borrows
fn fail3(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("FAIL ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))
    gFails = gFails + 1

@borrows
fn pass3(tag: str, detail: str) =
    os.WriteLine(os.Get_stdout(), strings.concatStr("PASS ", strings.concatStr(tag,
        strings.concatStr(": ", detail))))

@borrows
fn checkLongHeader(tag: str, hexIn: str, wantPtype: int32, wantVersion: int64,
                   wantDcidHex: str, wantScidHex: str, wantTokenLen: int32,
                   wantLength: int64, wantPnLen: int32, wantPnHex: str,
                   wantPnValue: int64): bool =
    let buf: Bytes = BytesFromHex(hexIn)
    var h: quichdr.QuicHeader = quichdr.QuicHeaderZero()
    let r: int32 = quichdr.QuicHeaderParse(buf, h)
    if r < 0:
        fail3(tag, strings.concatStr("parse err ", strings.IntToStr(r)))
        return false
    if !h.isLong:
        fail3(tag, "not flagged long")
        return false
    if h.ptype != wantPtype:
        fail3(tag, strings.concatStr("ptype ", strings.IntToStr(h.ptype)))
        return false
    if h.version != wantVersion:
        fail3(tag, strings.concatStr("version ", strings.Int64ToStr(h.version)))
        return false
    let dcid: Bytes = BytesSliceView(buf, h.dcidOff, h.dcidLen)
    if !BytesEqual(dcid, BytesFromHex(wantDcidHex)):
        fail3(tag, strings.concatStr("dcid ", BytesToHex(dcid)))
        return false
    let scid: Bytes = BytesSliceView(buf, h.scidOff, h.scidLen)
    if !BytesEqual(scid, BytesFromHex(wantScidHex)):
        fail3(tag, strings.concatStr("scid ", BytesToHex(scid)))
        return false
    if h.tokenLen != wantTokenLen:
        fail3(tag, strings.concatStr("tokenLen ", strings.IntToStr(h.tokenLen)))
        return false
    if h.length != wantLength:
        fail3(tag, strings.concatStr("length ", strings.Int64ToStr(h.length)))
        return false
    if h.pnLen != wantPnLen:
        fail3(tag, strings.concatStr("pnLen ", strings.IntToStr(h.pnLen)))
        return false
    let pnRaw: Bytes = BytesSliceView(buf, h.pnOff, h.pnLen)
    if !BytesEqual(pnRaw, BytesFromHex(wantPnHex)):
        fail3(tag, strings.concatStr("pn raw ", BytesToHex(pnRaw)))
        return false
    let pnValue: int64 = quichdr.QuicHeaderPnRead(buf, h)
    if pnValue != wantPnValue:
        fail3(tag, strings.concatStr("pn value ", strings.Int64ToStr(pnValue)))
        return false
    if h.payloadOff != h.pnOff + h.pnLen:
        fail3(tag, "payload offset mismatch")
        return false
    pass3(tag, strings.concatStr(strings.concatStr("ptype=", strings.IntToStr(h.ptype)),
        strings.concatStr(strings.concatStr(" ver=", strings.Int64ToStr(h.version)),
        strings.concatStr(strings.concatStr(" len=", strings.Int64ToStr(h.length)),
        strings.concatStr(strings.concatStr(" pnLen=", strings.IntToStr(h.pnLen)),
        strings.concatStr(" pn=", strings.Int64ToStr(pnValue)))))))
    return true

fn initialRoundTrip(dcidLen: int32, tokenLen: int32, pnLen: int32): bool =
    var pool: Bytes = BytesAlloc(64)
    var i: int32
    while i < dcidLen:
        BytesSet(pool, i, 16 + i)
        i = i + 1
    i = 0
    while i < tokenLen:
        BytesSet(pool, 24 + i, 200 + i)
        i = i + 1
    let dcid: Bytes = BytesSliceView(pool, 0, dcidLen)
    let token: Bytes = BytesSliceView(pool, 24, tokenLen)
    var b1: BytesBuilder = BytesBuilderNew(128)
    # Length = PN + payload (4 bytes); no auth tag in this plaintext round-trip
    var ok: bool = true
    if quichdr.QuicInitialHeaderAppend(b1, quichdr.QuicVersion1, dcid,
            EmptyBytes(), token, pnLen) < 0:
        ok = false
    if ok && quichdr.QuicInitialLengthPnAppend(b1, 4, 7, pnLen) < 0:
        ok = false
    if ok:
        BytesBuilderAppendByte(b1, 0x01)
        BytesBuilderAppendByte(b1, 0xde)
        BytesBuilderAppendByte(b1, 0xad)
        BytesBuilderAppendByte(b1, 0xbe)
    var wire: Bytes = BytesBuilderFinish(b1)
    var wire2: Bytes = EmptyBytes()
    var h: quichdr.QuicHeader = quichdr.QuicHeaderZero()
    if ok && quichdr.QuicHeaderParse(wire, h) < 0:
        ok = false
    if ok:
        if h.ptype != quichdr.QuicPktTypeInitial || h.version != quichdr.QuicVersion1:
            ok = false
        if h.dcidLen != dcidLen || h.tokenLen != tokenLen || h.pnLen != pnLen:
            ok = false
        if h.length != int64(4 + pnLen):
            ok = false
        if quichdr.QuicHeaderPnRead(wire, h) != 7:
            ok = false
    if ok:
        # re-encode from the decoded record; require byte identity
        var b2: BytesBuilder = BytesBuilderNew(128)
        let dcid2: Bytes = BytesSliceView(wire, h.dcidOff, h.dcidLen)
        let token2: Bytes = BytesSliceView(wire, h.tokenOff, h.tokenLen)
        if quichdr.QuicInitialHeaderAppend(b2, h.version, dcid2, EmptyBytes(),
                token2, h.pnLen) < 0:
            ok = false
        if ok && quichdr.QuicInitialLengthPnAppend(b2, int32(h.length) - h.pnLen,
                7, h.pnLen) < 0:
            ok = false
        if ok:
            BytesBuilderAppend(b2, BytesSliceView(wire, h.payloadOff, 4))
            wire2 = BytesBuilderFinish(b2)
            if !BytesEqual(wire, wire2):
                ok = false
        else:
            BytesBuilderFree(b2)
    BytesFree(wire)
    if wire2.len > 0:
        BytesFree(wire2)
    BytesFree(pool)
    return ok

fn main(): int32 =
    # ---- (a) RFC 9001 A.2 client Initial unprotected header ----
    let a2: bool = checkLongHeader("a2_client_header",
        "c300000001088394c8f03e5157080000449e00000002",
        quichdr.QuicPktTypeInitial, 1,
        "8394c8f03e515708", "", 0, 1182, 4, "00000002", 2)
    # ---- (a) RFC 9001 A.3 server Initial unprotected header ----
    let a3: bool = checkLongHeader("a3_server_header",
        "c1000000010008f067a5502a4262b50040750001",
        quichdr.QuicPktTypeInitial, 1,
        "", "f067a5502a4262b5", 0, 117, 2, "0001", 1)
    if !a2:
        fail3("a2_client_header", "failed")
    if !a3:
        fail3("a3_server_header", "failed")

    # ---- A.5 short header (plaintext-layer parse, protected bits raw) ----
    let short: Bytes = BytesFromHex("4200bff401")
    var hs: quichdr.QuicHeader = quichdr.QuicHeaderZero()
    let rs: int32 = quichdr.QuicShortHeaderParse(short, 0, hs)
    if rs < 0:
        fail3("a5_short_header", strings.concatStr("parse err ", strings.IntToStr(rs)))
    else:
        let pnV: int64 = quichdr.QuicHeaderPnRead(short, hs)
        if hs.isLong || hs.ptype != -1 || hs.pnLen != 3 || hs.pnOff != 1 || hs.payloadOff != 4:
            fail3("a5_short_header", "field mismatch")
        else:
            if pnV != 0xbff4:
                fail3("a5_short_header", strings.concatStr("pn ", strings.Int64ToStr(pnV)))
            else:
                pass3("a5_short_header", "spin=0 kp=0 reserved=0 pnLen=3 pn=0xbff4 payload=PING")

    # ---- packet number encoding, Appendix A.2 examples ----
    let pn1: int32 = quichdr.QuicPnEncodeSize(0xac5c02, 0xabe8b3, true)
    let pn2: int32 = quichdr.QuicPnEncodeSize(0xace8fe, 0xabe8b3, true)
    if pn1 != 2 || pn2 != 3:
        fail3("pn_encode_size_a2", strings.concatStr(strings.IntToStr(pn1),
            strings.concatStr("/", strings.IntToStr(pn2))))
    else:
        pass3("pn_encode_size_a2", "0xac5c02->2B, 0xace8fe->3B (29519/65611 outstanding)")
    # Initial before any ACK: full packet number, no truncation
    let pn3: int32 = quichdr.QuicPnFullSize(2)
    if pn3 != 1:
        fail3("pn_full_size", strings.IntToStr(pn3))
    else:
        pass3("pn_full_size", "pn=2 -> 1 byte full-width minimum")

    # ---- packet number decoding, Appendix A.3 example ----
    let dec: int64 = quichdr.QuicPnDecode(0xa82f30ea, 0x9b32, 16)
    if dec != 0xa82f9b32:
        fail3("pn_decode_a3", strings.Int64ToStr(dec))
    else:
        pass3("pn_decode_a3", "largest=0xa82f30ea trunc16=0x9b32 -> 0xa82f9b32")

    # ---- Version Negotiation round-trip ----
    var bvn: BytesBuilder = BytesBuilderNew(64)
    let vlist: Bytes = BytesFromHex("00000001ff000020")
    let dvn: Bytes = BytesFromHex("00112233445566778899aabbccddeeff0011223344")
    let svn: Bytes = BytesFromHex("0a0b0c")
    let vwr: int32 = quichdr.QuicVnAppend(bvn, dvn, svn, vlist)
    if vwr < 0:
        fail3("vn_roundtrip", strings.concatStr("encode err ", strings.IntToStr(vwr)))
    else:
        let vnBuf: Bytes = BytesBuilderFinish(bvn)
        var hvn: quichdr.QuicHeader = quichdr.QuicHeaderZero()
        let rvn: int32 = quichdr.QuicHeaderParse(vnBuf, hvn)
        if rvn < 0 || !hvn.isVn || hvn.versionsCount != 2 || hvn.version != 0:
            fail3("vn_roundtrip", strings.concatStr("parse err ", strings.IntToStr(rvn)))
        else:
            let v0: int64 = quichdr.QuicHeaderVersionAt(vnBuf, hvn.versionsOff)
            let v1: int64 = quichdr.QuicHeaderVersionAt(vnBuf, hvn.versionsOff + 4)
            if v0 != 1 || v1 != 0xff000020 || hvn.dcidLen != 21 || hvn.scidLen != 3:
                fail3("vn_roundtrip", strings.concatStr(strings.concatStr("v0=",
                    strings.Int64ToStr(v0)),
                    strings.concatStr(strings.concatStr(" v1=", strings.Int64ToStr(v1)),
                    strings.concatStr(strings.concatStr(" dcil=", strings.IntToStr(hvn.dcidLen)),
                    strings.concatStr(" scil=", strings.IntToStr(hvn.scidLen))))))
            else:
                pass3("vn_roundtrip", "versions=[0x1,0xff000020] dcid=21B scid=3B")

    # ---- Initial header round-trips: 4 CID lens x 2 token lens x 4 PN lens ----
    var rtOk: int32
    var dc: int32
    while dc < 4:
        var tk: int32
        while tk < 2:
            var pl: int32
            while pl < 4:
                if initialRoundTrip(dc, tk, pl + 1):
                    rtOk = rtOk + 1
                pl = pl + 1
            tk = tk + 1
        dc = dc + 1
    if rtOk != 32:
        fail3("initial_roundtrips", strings.concatStr(strings.IntToStr(rtOk), "/32"))
    else:
        pass3("initial_roundtrips", "32/32 encode->parse->re-encode byte-identical")

    # ---- negatives ----
    var h: quichdr.QuicHeader = quichdr.QuicHeaderZero()
    # 1 fixed bit clear on short header (RFC 7983 guard): byte0 0x00
    let n1: int32 = quichdr.QuicShortHeaderParse(BytesFromHex("00000000"), 0, h)
    if n1 != -2:
        fail3("neg_h1_fixed_bit", strings.IntToStr(n1))
    # 2 fixed bit clear on long header: byte0 0x80, version 1
    let n2: int32 = quichdr.QuicHeaderParse(BytesFromHex("8000000001"), h)
    if n2 != -2:
        fail3("neg_h2_long_fixed_bit", strings.IntToStr(n2))
    # 3 long header DCID length 21
    let n3: int32 = quichdr.QuicHeaderParse(BytesFromHex("c30000000115"), h)
    if n3 != -4:
        fail3("neg_h3_dcid21", strings.IntToStr(n3))
    # 4 Initial token length beyond buffer
    let n4: int32 = quichdr.QuicHeaderParsePacket(BytesFromHex("c300000001000040ff"), h)
    if n4 != -1:
        fail3("neg_h4_token_overrun", strings.IntToStr(n4))
    # 5 Length field beyond buffer end: datagram walker must refuse
    let n5: int32 = quichdr.QuicHeaderParsePacket(BytesFromHex("c30000000100004077"), h)
    if n5 != -1:
        fail3("neg_h5_length_overrun", strings.IntToStr(n5))
    # 6 VN with version list not multiple of 4
    let n6: int32 = quichdr.QuicHeaderParse(BytesFromHex("c0000000000000030102"), h)
    if n6 != -5:
        fail3("neg_h6_vn_align", strings.IntToStr(n6))
    # 7 short header truncated before PN
    let n7: int32 = quichdr.QuicShortHeaderParse(BytesFromHex("42"), 0, h)
    if n7 != -1:
        fail3("neg_h7_short_trunc", strings.IntToStr(n7))
    # 8 Retry type: packet-protection scope, parsed module refuses (-6)
    let n8: int32 = quichdr.QuicHeaderParse(BytesFromHex("f30000000100000000000000000000000000000000000000"), h)
    if n8 != -6:
        fail3("neg_h8_retry_scope", strings.IntToStr(n8))
    pass3("negatives", "8 header negatives rejected with exact codes")

    if gFails != 0:
        os.WriteLine(os.Get_stdout(), strings.concatStr("W3A-HEADERS RESULT: FAIL count=",
            strings.IntToStr(gFails)))
        return 1
    os.WriteLine(os.Get_stdout(), "W3A-HEADERS RESULT: PASS")
    return 0
