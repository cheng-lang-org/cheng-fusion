# bridge fs shell smoke: export a batch frame to disk, apply it into a
# fresh state (golden round-trip), then prove tamper/drift/truncation are
# all loudly refused.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/chain/rwad_bridge_contract as brg
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_bridge_fs as bfs

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0

    var entries: brg.BridgeEntry[]
    var eA: brg.BridgeEntry
    eA.accountCid = Tag(70)
    eA.amount = Int64(1234)
    add(entries, eA)
    var eB: brg.BridgeEntry
    eB.accountCid = Tag(71)
    eB.amount = Int64(4321)
    add(entries, eB)
    let root = brg.BridgeBatchRoot(entries)
    if !root.ok:
        return 1

    # rebuild the same batch: BridgeBatchRoot consumed the first array
    var entries2: brg.BridgeEntry[]
    var fA: brg.BridgeEntry
    fA.accountCid = Tag(70)
    fA.amount = Int64(1234)
    add(entries2, fA)
    var fB: brg.BridgeEntry
    fB.accountCid = Tag(71)
    fB.amount = Int64(4321)
    add(entries2, fB)

    let path: str = "/tmp/bfs_golden.bin"
    let exp = bfs.BfsExportFile(entries2, root.value, path)
    if !exp.ok:
        os.WriteLine(os.Get_stderr(), "die-export")
        rc = 99
        return rc

    # golden round-trip: apply into a fresh state, balances must match
    var st = ssm.SsmInit()
    let apply = bfs.BfsApplyFile(st, path, Tag(80), Int64(100), Int64(10))
    if !apply.ok:
        os.WriteLine(os.Get_stderr(), "die-apply")
        rc = 99
        return rc
    if ssm.SsmBalanceOf(st, eA.accountCid) != 1234:
        os.WriteLine(os.Get_stderr(), "golden balance A wrong")
        rc = rc + 1
    if ssm.SsmBalanceOf(st, eB.accountCid) != 4321:
        os.WriteLine(os.Get_stderr(), "golden balance B wrong")
        rc = rc + 1
    # duplicate apply must fail on batch id
    let dup = bfs.BfsApplyFile(st, path, Tag(80), Int64(200), Int64(10))
    if dup.ok:
        os.WriteLine(os.Get_stderr(), "duplicate apply accepted")
        rc = rc + 1

    # tamper: flip one byte inside an entry amount -> root mismatch
    let raw = os.ReadFileBytesResult(path)
    if !raw.ok:
        return 1
    var buf: Bytes = raw.value
    let origByte: int32 = BytesGet(buf, 47)
    BytesSet(buf, 47, (origByte + 1) % 256)
    let tpath: str = "/tmp/bfs_tamper.bin"
    let tw = os.WriteFileBytesResult(tpath, buf)
    if !tw.ok:
        return 1
    var st2 = ssm.SsmInit()
    let tampered = bfs.BfsApplyFile(st2, tpath, Tag(81), Int64(100), Int64(10))
    if tampered.ok:
        os.WriteLine(os.Get_stderr(), "tampered file accepted")
        rc = rc + 1

    # truncation: cut the root off the end
    var short = BytesAlloc(buf.len - 32)
    var i: int32
    while i < buf.len - 32:
        BytesSet(short, i, BytesGet(buf, i))
        i = i + 1
    let spath: str = "/tmp/bfs_short.bin"
    let sw = os.WriteFileBytesResult(spath, short)
    if !sw.ok:
        return 1
    var st3 = ssm.SsmInit()
    let truncated = bfs.BfsApplyFile(st3, spath, Tag(82), Int64(100), Int64(10))
    if truncated.ok:
        os.WriteLine(os.Get_stderr(), "truncated file accepted")
        rc = rc + 1

    # missing file must be refused loudly
    var st4 = ssm.SsmInit()
    let missing = bfs.BfsApplyFile(st4, "/tmp/bfs_does_not_exist.bin", Tag(83), Int64(100), Int64(10))
    if missing.ok:
        os.WriteLine(os.Get_stderr(), "missing file accepted")
        rc = rc + 1
    if rc == 0:
        echo("bridge_fs_smoke ok")
    return rc
