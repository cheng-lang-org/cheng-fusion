import std/result
import std/os
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner
import cheng/DiLoCo/train/outer_merge as outer
import cheng/DiLoCo/tests/support

const
    SmokeIn: int32 = 4
    SmokeOut: int32 = 2
    SmokeInnerSteps: int32 = 8
    SmokeShardBytes: int32 = 64
    SmokeLrNum: int32 = 1
    SmokeLrDen: int32 = 2

fn die(msg: str): int32 =
    echo(msg)
    return 1

@borrows
fn putParams(store: var astore.DiLoCoArtifactStore,
             jobBundleCid: layout.FixedBytes32,
             values: int32[]): Result[core.DiLoCoArtifactRef] =
    var packed = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(packed, values)
    if IsErr(packRes):
        return Err[core.DiLoCoArtifactRef](Error(packRes))
    var ref = core.DiLoCoArtifactRef()
    let putRes = astore.DiLoCoArtifactStorePutFill(ref, store, jobBundleCid, packed, SmokeShardBytes)
    if IsErr(putRes):
        return Err[core.DiLoCoArtifactRef](Error(putRes))
    return Ok[core.DiLoCoArtifactRef](ref)

@borrows
fn loadParams(store: astore.DiLoCoArtifactStore,
              artifactRef: core.DiLoCoArtifactRef): Result[int32[]] =
    var bytes = rawbytes.EmptyBytes()
    let getRes = astore.DiLoCoArtifactStoreGetFill(bytes, store, artifactRef)
    if IsErr(getRes):
        return Err[int32[]](Error(getRes))
    var values: int32[]
    let unpackRes = codec.DiLoCoTrainUnpackI32Fill(values, bytes)
    if IsErr(unpackRes):
        return Err[int32[]](Error(unpackRes))
    return Ok[int32[]](values)

fn main(): int32 =
    let tmpRoot = os.GetEnvDefault("CHENG_TASK_TMPDIR", "")
    if tmpRoot == "":
        return die("diloco_train_infer_loop_smoke: CHENG_TASK_TMPDIR missing")
    let storeDir = tmpRoot + "/diloco-artifacts"
    var store = astore.DiLoCoArtifactStore()
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, storeDir)
    if IsErr(initRes):
        return die(Error(initRes))

    let jobBundleCid = support.DiLoCoTestJobBundleCid("train-infer-loop")
    var leaderPeer: types.Libp2pPeerId
    leaderPeer.value = support.DiLoCoTestJobBundleCid("train-infer-leader")
    var workerPeer: types.Libp2pPeerId
    workerPeer.value = support.DiLoCoTestJobBundleCid("train-infer-worker")
    if types.Libp2pPeerIdEqual(leaderPeer, workerPeer):
        return die("diloco_train_infer_loop_smoke: peer ids collided")

    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, SmokeOut, SmokeIn)
    if IsErr(zeroRes):
        return die(Error(zeroRes))
    let modelPut = putParams(store, jobBundleCid, zeros)
    if IsErr(modelPut):
        return die(Error(modelPut))
    let optPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optPut):
        return die(Error(optPut))

    var state = core.DiLoCoStateInit("diloco.train.infer")
    var openedJob = core.DiLoCoJob()
    var genesis = core.DiLoCoGlobalVersion()
    let openRes = core.DiLoCoOpenJobFill(openedJob,
                                           genesis,
                                           state,
                                           jobBundleCid,
                                           2,
                                           SmokeInnerSteps,
                                           60,
                                           Value(modelPut),
                                           Value(optPut))
    if IsErr(openRes):
        return die(Error(openRes))

    var cohort = core.DiLoCoCohort()
    let joinL = core.DiLoCoJoinCohortFill(cohort, state, jobBundleCid, leaderPeer)
    if IsErr(joinL):
        return die(Error(joinL))
    let joinW = core.DiLoCoJoinCohortFill(cohort, state, jobBundleCid, workerPeer)
    if IsErr(joinW):
        return die(Error(joinW))
    if cohort.fixedMemberCount != 2 || !state.jobs[0].sealed:
        return die("diloco_train_infer_loop_smoke: cohort not sealed after joins")

    var leaderLease = core.DiLoCoLease()
    var workerLease = core.DiLoCoLease()
    let ll = core.DiLoCoFetchLeaseFill(leaderLease, state, jobBundleCid, leaderPeer)
    if IsErr(ll):
        return die(Error(ll))
    let wl = core.DiLoCoFetchLeaseFill(workerLease, state, jobBundleCid, workerPeer)
    if IsErr(wl):
        return die(Error(wl))
    if leaderLease.innerStepBudget != SmokeInnerSteps:
        return die("diloco_train_infer_loop_smoke: lease budget")

    var baseW: int32[]
    let baseLoad = loadParams(store, genesis.modelRef)
    if IsErr(baseLoad):
        return die(Error(baseLoad))
    baseW = Value(baseLoad)

    var heldX: int32[]
    add(heldX, 1000)
    add(heldX, 0)
    add(heldX, 0)
    add(heldX, 0)
    add(heldX, 0)
    add(heldX, 1000)
    add(heldX, 0)
    add(heldX, 0)
    var heldY: int32[]
    add(heldY, 1000)
    add(heldY, 0)
    add(heldY, 0)
    add(heldY, 1000)
    let mse0Res = inner.DiLoCoLinearMseSum(baseW, heldX, heldY, 2, SmokeOut, SmokeIn)
    if IsErr(mse0Res):
        return die(Error(mse0Res))
    let mse0 = Value(mse0Res)

    var xsA: int32[]
    var ysA: int32[]
    for s in 0..<3:
        add(xsA, 1000)
        add(xsA, 0)
        add(xsA, 0)
        add(xsA, 0)
        add(ysA, 1000)
        add(ysA, 0)
    var xsB: int32[]
    var ysB: int32[]
    for s in 0..<3:
        add(xsB, 0)
        add(xsB, 1000)
        add(xsB, 0)
        add(xsB, 0)
        add(ysB, 0)
        add(ysB, 1000)

    var wA: int32[]
    var dA: int32[]
    let innerA = inner.DiLoCoInnerSgdLinearFill(wA, dA, baseW, xsA, ysA, 3, SmokeInnerSteps, SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    if IsErr(innerA):
        return die(Error(innerA))
    var wB: int32[]
    var dB: int32[]
    let innerB = inner.DiLoCoInnerSgdLinearFill(wB, dB, baseW, xsB, ysB, 3, SmokeInnerSteps, SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    if IsErr(innerB):
        return die(Error(innerB))

    var barrier = core.DiLoCoBarrier()
    let bA = core.DiLoCoReportInnerStepDoneFill(barrier, state, jobBundleCid, leaderPeer)
    if IsErr(bA):
        return die(Error(bA))
    let bB = core.DiLoCoReportInnerStepDoneFill(barrier, state, jobBundleCid, workerPeer)
    if IsErr(bB):
        return die(Error(bB))
    if !barrier.sealed:
        return die("diloco_train_infer_loop_smoke: barrier not sealed")

    let deltaAPut = putParams(store, jobBundleCid, dA)
    if IsErr(deltaAPut):
        return die(Error(deltaAPut))
    let deltaBPut = putParams(store, jobBundleCid, dB)
    if IsErr(deltaBPut):
        return die(Error(deltaBPut))
    let optAPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optAPut):
        return die(Error(optAPut))
    let optBPut = putParams(store, jobBundleCid, zeros)
    if IsErr(optBPut):
        return die(Error(optBPut))

    let tokensA: int32 = 3 * SmokeInnerSteps
    let tokensB: int32 = 3 * SmokeInnerSteps
    var deltaRecA = core.DiLoCoOuterDelta()
    let subA = core.DiLoCoSubmitOuterDeltaFill(deltaRecA,
                                                 state,
                                                 jobBundleCid,
                                                 leaderLease.baseVersionCid,
                                                 leaderLease.outerStep,
                                                 leaderPeer,
                                                 Value(deltaAPut),
                                                 Value(optAPut),
                                                 3,
                                                 tokensA,
                                                 SmokeInnerSteps,
                                                 tokensA,
                                                 1)
    if IsErr(subA):
        return die(Error(subA))
    var deltaRecB = core.DiLoCoOuterDelta()
    let subB = core.DiLoCoSubmitOuterDeltaFill(deltaRecB,
                                                 state,
                                                 jobBundleCid,
                                                 workerLease.baseVersionCid,
                                                 workerLease.outerStep,
                                                 workerPeer,
                                                 Value(deltaBPut),
                                                 Value(optBPut),
                                                 3,
                                                 tokensB,
                                                 SmokeInnerSteps,
                                                 tokensB,
                                                 1)
    if IsErr(subB):
        return die(Error(subB))

    var commit = core.DiLoCoMergeCommit()
    var version = core.DiLoCoGlobalVersion()
    let mergeRes = outer.DiLoCoOuterMergeAndPublishFill(commit,
                                                          version,
                                                          store,
                                                          state,
                                                          jobBundleCid,
                                                          leaderPeer,
                                                          SmokeShardBytes)
    if IsErr(mergeRes):
        return die(Error(mergeRes))
    let resolvable = astore.DiLoCoArtifactStoreRefResolvable(store, version.modelRef)
    if IsErr(resolvable):
        return die(Error(resolvable))

    let mergedLoad = loadParams(store, version.modelRef)
    if IsErr(mergedLoad):
        return die(Error(mergedLoad))
    let mse1Res = inner.DiLoCoLinearMseSum(Value(mergedLoad), heldX, heldY, 2, SmokeOut, SmokeIn)
    if IsErr(mse1Res):
        return die(Error(mse1Res))
    let mse1 = Value(mse1Res)
    if mse1 >= mse0:
        echo("diloco_train_infer_loop_smoke: mse did not fall")
        return 1
    if version.committedOuterStep != 1:
        return die("diloco_train_infer_loop_smoke: outer step")
    echo("diloco_train_infer_loop_smoke ok")
    return 0
