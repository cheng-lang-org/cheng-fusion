import std/os
import std/strformat
import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower

fn main(): int32 =
    let rowCount: int32 = 4096
    let elementBytes = int64(sizeof(str))
    var owner: lower.LoweringReportPartsOwner
    var expectedAllocationEvents: int64
    var expectedAllocatedBytes: int64
    var expectedReleasedBytes: int64
    var expectedPeakBytes: int64
    for row in 0..<rowCount:
        let beforeCapacity = owner.parts.cap
        lower.LoweringReportPartsAppendText(owner, "x")
        let afterCapacity = owner.parts.cap
        if afterCapacity < beforeCapacity || owner.parts.len != row + 1:
            panic("lowering sequence linear allocator: append shape drift")
        if afterCapacity > beforeCapacity:
            expectedAllocationEvents = expectedAllocationEvents + int64(1)
            expectedAllocatedBytes =
                expectedAllocatedBytes + int64(afterCapacity) * elementBytes
            if beforeCapacity > 0:
                expectedReleasedBytes =
                    expectedReleasedBytes +
                    int64(beforeCapacity) * elementBytes
            let liveBytes = int64(afterCapacity) * elementBytes
            if liveBytes > expectedPeakBytes:
                expectedPeakBytes = liveBytes
    let joined = strutil.Join(owner.parts, "")
    if joined.len != rowCount || owner.parts.len != rowCount:
        panic("lowering sequence linear allocator: payload drift")
    let terminalBytes = int64(owner.parts.cap) * elementBytes
    if expectedAllocationEvents <= int64(0) ||
       owner.allocatorLedger.allocationEventCount !=
           expectedAllocationEvents ||
       owner.allocatorLedger.releaseEventCount !=
           expectedAllocationEvents - int64(1) ||
       owner.allocatorLedger.allocatedCapacityBytes !=
           expectedAllocatedBytes ||
       owner.allocatorLedger.releasedCapacityBytes !=
           expectedReleasedBytes ||
       owner.allocatorLedger.liveAllocationCount != int64(1) ||
       owner.allocatorLedger.liveCapacityBytes != terminalBytes ||
       owner.allocatorLedger.peakLiveCapacityBytes != expectedPeakBytes ||
       expectedPeakBytes != terminalBytes:
        panic("lowering sequence linear allocator: live ledger drift")
    var receipt: lower.LoweringSequenceAllocatorReceipt
    lower.LoweringReportPartsReleaseWithReceipt(owner, receipt)
    if receipt.allocationEventCount != expectedAllocationEvents ||
       receipt.releaseEventCount != expectedAllocationEvents ||
       receipt.allocatedCapacityBytes != expectedAllocatedBytes ||
       receipt.releasedCapacityBytes != expectedAllocatedBytes ||
       receipt.terminalRetainedBufferCount != 1 ||
       receipt.terminalRetainedBytes != terminalBytes ||
       receipt.terminalReleasedBufferCount != 1 ||
       receipt.terminalReleasedBytes != terminalBytes ||
       receipt.liveAllocationCount != int64(0) ||
       receipt.liveCapacityBytes != int64(0) ||
       !lower.LoweringSequenceAllocatorReceiptClosed(receipt) ||
       !lower.LoweringReportPartsReceiptConsumeStrict(owner, receipt):
        panic("lowering sequence linear allocator: terminal ledger drift")
    let forbiddenCloneElements =
        int64(rowCount) * int64(rowCount - 1) / int64(2)
    os.WriteLine(
        os.GetStdout(),
        Fmt"lowering_sequence_linear_allocator_smoke ok rows={rowCount} element_bytes={elementBytes} allocation_events={expectedAllocationEvents} allocated_bytes={expectedAllocatedBytes} peak_live_bytes={expectedPeakBytes} terminal_bytes={terminalBytes} forbidden_clone_elements={forbiddenCloneElements}")
    return 0
