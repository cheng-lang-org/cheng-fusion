import std/cmdline as cmdline
import std/os as os
import std/rawbytes
import std/result
import std/strings
import std/system
import cheng/core/csg_core/csgc
import cheng/core/csg_core/json_canonical as canonical
import cheng/core/csg_core/json_field as field
import cheng/core/csg_core/merkle_cargo
import cheng/core/csg_core/merkle_dag

const
    ReplayProofQueryKey: str = "id:sym_a"
    ReplayStandard: str = "csg_core::v1"
    ReplaySchemaNamespace: str = "csg_core::v1"
    ReplaySchemaCid: str =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    BaseSchema: str =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    BaseSymbolA: str =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A\",\"symbolKind\":\"fn\"}"
    ReplacedSymbolA: str =
        "{\"id\":\"sym_a\",\"kind\":\"csg.symbol\",\"name\":\"A2\",\"symbolKind\":\"fn\"}"
    InsertedSymbolB: str =
        "{\"id\":\"sym_b\",\"kind\":\"csg.symbol\",\"name\":\"B\",\"symbolKind\":\"fn\"}"
    NoncanonicalSymbolA: str =
        "{ \"id\" : \"sym_a\", \"kind\" : \"csg.symbol\", \"name\" : \"A2\", \"symbolKind\" : \"fn\" }"

type
    ReplayPatch =
        id: str
        ordinal: int32
        operation: str
        targetKey: str
        fact: str
        beforeFactsRoot: str
        afterFactsRoot: str

    ReplayResult =
        ok: bool
        error: str
        finalFactsRoot: str
        finalCsgc: rawbytes.Bytes
        proofCargo: rawbytes.Bytes
        proofCid: str

@borrows
fn cat(a: str, b: str): str =
    return strings.ConcatStr(a, b)

@borrows
fn appendText(out: var str, part: str) =
    out = cat(out, part)

@borrows
fn quote(text: str): str =
    return canonical.CsgCoreJsonQuote(text)

@borrows
fn cloneBytes(bytes: rawbytes.Bytes): rawbytes.Bytes =
    var copy = rawbytes.BytesAlloc(rawbytes.BytesLen(bytes))
    rawbytes.BytesCopyInto(copy, 0, bytes)
    return copy

@borrows
fn replayFail(message: str): ReplayResult =
    var out: ReplayResult
    out.error = strings.CloneStr(message)
    return out

@borrows
fn readStringField(
        line: str,
        name: str,
        out: var str): bool =
    let value =
        field.CsgCoreJsonTopStringField(line, name)
    if !value.found:
        return false
    out = strings.CloneStr(value.value)
    return true

@borrows
fn parseOrdinal(text: str, out: var int32): bool =
    if text.len == 0 || text.len > 8:
        return false
    var value: int32
    for i in 0..<text.len:
        let digit = int32(text[i]) - int32('0')
        if digit < 0 || digit > 9 ||
           value > (2147483647 - digit) / 10:
            return false
        value = value * 10 + digit
    if text != strings.IntToStr(value):
        return false
    out = value
    return true

fn ordinalId(ordinal: int32): str =
    let raw = strings.IntToStr(ordinal)
    if ordinal < 0 || raw.len > 8:
        return ""
    var zeros: str
    for _ in 0..<(8 - raw.len):
        zeros = cat(zeros, "0")
    return cat("patch:", cat(zeros, raw))

@borrows
fn patchLineExactShape(
        id: str,
        ordinalText: str,
        operation: str,
        targetKey: str,
        fact: str,
        beforeFactsRoot: str,
        afterFactsRoot: str,
        includeExtraField: bool): str =
    var out: str = "{\"after_facts_root\":"
    appendText(out, quote(afterFactsRoot))
    appendText(out, ",\"before_facts_root\":")
    appendText(out, quote(beforeFactsRoot))
    appendText(out, ",\"fact\":")
    appendText(out, quote(fact))
    appendText(out, ",\"id\":")
    appendText(out, quote(id))
    appendText(out, ",\"kind\":\"csg.incremental.patch\"")
    appendText(out, ",\"operation\":")
    appendText(out, quote(operation))
    appendText(out, ",\"ordinal\":")
    appendText(out, quote(ordinalText))
    appendText(out, ",\"target_key\":")
    appendText(out, quote(targetKey))
    if includeExtraField:
        appendText(out, ",\"z\":\"x\"")
    appendText(out, "}")
    return out

@borrows
fn patchLine(
        id: str,
        ordinal: int32,
        operation: str,
        targetKey: str,
        fact: str,
        beforeFactsRoot: str,
        afterFactsRoot: str): str =
    return patchLineExactShape(
        id,
        strings.IntToStr(ordinal),
        operation,
        targetKey,
        fact,
        beforeFactsRoot,
        afterFactsRoot,
        false)

@borrows
fn parsePatch(line: str, out: var ReplayPatch): bool =
    var kind: str
    var ordinalText: str
    if !readStringField(line, "kind", kind) ||
       kind != "csg.incremental.patch" ||
       !readStringField(line, "id", out.id) ||
       !readStringField(line, "ordinal", ordinalText) ||
       !parseOrdinal(ordinalText, out.ordinal) ||
       !readStringField(line, "operation", out.operation) ||
       !readStringField(line, "target_key", out.targetKey) ||
       !readStringField(line, "fact", out.fact) ||
       !readStringField(
           line, "before_facts_root", out.beforeFactsRoot) ||
       !readStringField(
           line, "after_facts_root", out.afterFactsRoot):
        return false
    let canonicalRecord =
        patchLine(
            out.id,
            out.ordinal,
            out.operation,
            out.targetKey,
            out.fact,
            out.beforeFactsRoot,
            out.afterFactsRoot)
    if canonicalRecord != line:
        return false
    return true

@borrows
fn factAt(facts: str[], wantedKey: str): int32 =
    for i in 0..<facts.len:
        var keyError: str
        let key =
            merkle_dag.CsgCoreMerkleFactKey(
                facts[i], keyError)
        if keyError.len > 0:
            return -2
        if key == wantedKey:
            return i
    return -1

@borrows
fn boundDag(facts: str[]): merkle_dag.CsgCoreMerkleDag =
    return merkle_dag.CsgCoreMerkleBuildBound(
        facts,
        ReplayStandard,
        ["csg_core"],
        ReplaySchemaNamespace,
        ReplaySchemaCid)

@borrows
fn canonicalCargoMatches(
        bytes: rawbytes.Bytes,
        lines: str[]): bool =
    var reencoded =
        csgc.CsgCoreCsgcEncodeCanonicalLines(lines)
    if !reencoded.ok:
        return false
    let equal = rawbytes.BytesEqual(bytes, reencoded.bytes)
    rawbytes.BytesFree(reencoded.bytes)
    return equal

@borrows
fn replayCanonicalSequence(
        baseBytes: rawbytes.Bytes,
        patchBytes: rawbytes.Bytes): ReplayResult =
    let baseDecoded = csgc.CsgCoreCsgcDecodeLines(baseBytes)
    if !baseDecoded.ok ||
       !canonicalCargoMatches(baseBytes, baseDecoded.lines):
        return replayFail("incremental_base_csgc_noncanonical")
    var patchesDecoded = csgc.CsgCoreCsgcDecodeLines(patchBytes)
    if !patchesDecoded.ok || patchesDecoded.lines.len == 0 ||
       !canonicalCargoMatches(patchBytes, patchesDecoded.lines):
        return replayFail("incremental_patch_csgc_noncanonical")
    for sortI in 0..<patchesDecoded.lines.len:
        for sortJ in (sortI + 1)..<patchesDecoded.lines.len:
            var leftPatch: ReplayPatch
            var rightPatch: ReplayPatch
            if !parsePatch(patchesDecoded.lines[sortI], leftPatch) ||
               !parsePatch(patchesDecoded.lines[sortJ], rightPatch):
                return replayFail("incremental_patch_record_invalid")
            if leftPatch.ordinal > rightPatch.ordinal:
                let swapped = strings.CloneStr(patchesDecoded.lines[sortI])
                patchesDecoded.lines[sortI] =
                    strings.CloneStr(patchesDecoded.lines[sortJ])
                patchesDecoded.lines[sortJ] = swapped

    var facts: str[]
    for i in 0..<baseDecoded.lines.len:
        add(facts, strings.CloneStr(baseDecoded.lines[i]))
    let baseDag = boundDag(facts)
    if !baseDag.ok:
        return replayFail(cat(
            "incremental_base_invalid ", baseDag.error))
    let baseFactsRoot = strings.CloneStr(baseDag.factsRoot)
    var currentFactsRoot = strings.CloneStr(baseFactsRoot)

    for i in 0..<patchesDecoded.lines.len:
        var patch: ReplayPatch
        if !parsePatch(patchesDecoded.lines[i], patch):
            return replayFail("incremental_patch_record_invalid")
        if patch.ordinal != i:
            return replayFail("incremental_patch_ordinal_gap_or_reorder")
        if patch.id != ordinalId(i):
            return replayFail("incremental_patch_id_not_canonical")
        if patch.beforeFactsRoot != currentFactsRoot:
            return replayFail("incremental_patch_root_chain_gap")

        let existingAt = factAt(facts, patch.targetKey)
        if existingAt == -2:
            return replayFail("incremental_base_fact_key_invalid")
        if patch.operation == "insert":
            if existingAt >= 0:
                return replayFail("incremental_insert_target_exists")
        elif patch.operation == "replace":
            if existingAt < 0:
                return replayFail("incremental_replace_target_missing")
        elif patch.operation == "delete":
            if existingAt < 0 || patch.fact.len != 0:
                return replayFail("incremental_delete_record_invalid")
        else:
            return replayFail("incremental_patch_operation_invalid")

        if patch.operation != "delete":
            var canonicalError: str
            let canonicalFact =
                merkle_dag.CsgCoreMerkleCanonicalFact(
                    patch.fact, canonicalError)
            if canonicalError.len > 0 ||
               canonicalFact != patch.fact:
                return replayFail(
                    "incremental_patch_fact_noncanonical")
            var keyError: str
            let actualKey =
                merkle_dag.CsgCoreMerkleFactKey(
                    patch.fact, keyError)
            if keyError.len > 0 ||
               actualKey != patch.targetKey:
                return replayFail(
                    "incremental_patch_target_key_mismatch")

        if patch.operation == "insert":
            add(facts, strings.CloneStr(patch.fact))
        elif patch.operation == "replace":
            facts[existingAt] = strings.CloneStr(patch.fact)
        else:
            remove(facts, existingAt)

        let nextDag = boundDag(facts)
        if !nextDag.ok ||
           nextDag.factsRoot != patch.afterFactsRoot:
            return replayFail(
                "incremental_patch_after_root_mismatch")
        currentFactsRoot = strings.CloneStr(nextDag.factsRoot)

    var finalCsgc =
        csgc.CsgCoreCsgcEncodeCanonicalLines(facts)
    if !finalCsgc.ok:
        return replayFail(cat(
            "incremental_final_csgc_encode ", finalCsgc.error))
    let finalDecoded =
        csgc.CsgCoreCsgcDecodeLines(finalCsgc.bytes)
    if !finalDecoded.ok ||
       !canonicalCargoMatches(finalCsgc.bytes, finalDecoded.lines):
        rawbytes.BytesFree(finalCsgc.bytes)
        return replayFail(
            "incremental_final_csgc_readback_noncanonical")

    let finalDag = boundDag(finalDecoded.lines)
    if !finalDag.ok || finalDag.factsRoot != currentFactsRoot:
        rawbytes.BytesFree(finalCsgc.bytes)
        return replayFail(
            "incremental_final_dag_root_mismatch")
    let proof =
        merkle_dag.CsgCoreMerkleProveKey(
            finalDag, ReplayProofQueryKey)
    let verified =
        merkle_dag.CsgCoreMerkleVerifyProof(
            proof, currentFactsRoot)
    if !proof.ok || !verified.ok || !verified.exists:
        rawbytes.BytesFree(finalCsgc.bytes)
        return replayFail(
            "incremental_final_merkle_proof_invalid")
    var proofCargo =
        merkle_cargo.CsgCoreMerkleProofEncodeCsgc(
            proof, currentFactsRoot)
    if !proofCargo.ok:
        rawbytes.BytesFree(finalCsgc.bytes)
        return replayFail(cat(
            "incremental_proof_cargo_encode ", proofCargo.error))
    let proofDecoded =
        merkle_cargo.CsgCoreMerkleProofDecodeCsgc(
            proofCargo.bytes, currentFactsRoot)
    let decodedVerified =
        merkle_dag.CsgCoreMerkleVerifyProof(
            proofDecoded.proof, currentFactsRoot)
    if !proofDecoded.ok || !decodedVerified.ok ||
       !decodedVerified.exists ||
       proofDecoded.cid != proofCargo.cid ||
       proofDecoded.proof.queryKey != ReplayProofQueryKey:
        rawbytes.BytesFree(finalCsgc.bytes)
        rawbytes.BytesFree(proofCargo.bytes)
        return replayFail(
            "incremental_proof_cargo_trusted_readback_invalid")

    var out: ReplayResult
    out.ok = true
    out.finalFactsRoot = currentFactsRoot
    out.finalCsgc = finalCsgc.bytes
    out.proofCargo = proofCargo.bytes
    out.proofCid = strings.CloneStr(proofCargo.cid)
    return out

@borrows
fn writeBytes(path: str, bytes: rawbytes.Bytes): bool =
    var owned = cloneBytes(bytes)
    let written = os.WriteFileBytesResult(path, owned)
    let ok = result.IsOk(written)
    rawbytes.BytesFree(owned)
    return ok

@borrows
fn writeConformanceOutputsNonAtomic(
        replay: ReplayResult,
        csgcPath: str,
        factsRootPath: str,
        proofPath: str,
        proofCidPath: str): bool =
    if !replay.ok:
        return false
    if !writeBytes(csgcPath, replay.finalCsgc):
        return false
    let rootWritten = os.WriteFileResult(
        factsRootPath, cat(replay.finalFactsRoot, "\n"))
    if result.IsErr(rootWritten):
        return false
    if !writeBytes(proofPath, replay.proofCargo):
        return false
    let proofCidWritten = os.WriteFileResult(
        proofCidPath, cat(replay.proofCid, "\n"))
    return result.IsOk(proofCidWritten)

@borrows
fn prepareFixture(
        caseName: str,
        basePath: str,
        patchPath: str): int32 =
    let baseFacts = [
        strings.CloneStr(BaseSchema),
        strings.CloneStr(BaseSymbolA)
    ]
    let firstFacts = [
        strings.CloneStr(BaseSchema),
        strings.CloneStr(ReplacedSymbolA)
    ]
    let finalFacts = [
        strings.CloneStr(BaseSchema),
        strings.CloneStr(ReplacedSymbolA),
        strings.CloneStr(InsertedSymbolB)
    ]
    let baseDag = boundDag(baseFacts)
    let firstDag = boundDag(firstFacts)
    let finalDag = boundDag(finalFacts)
    if !baseDag.ok || !firstDag.ok || !finalDag.ok:
        return 1
    var baseCargo =
        csgc.CsgCoreCsgcEncodeCanonicalLines(baseFacts)
    if !baseCargo.ok:
        return 1

    var firstOrdinal: int32
    var secondOrdinal: int32 = 1
    if caseName == "unordered":
        firstOrdinal = 1
        secondOrdinal = 0
    elif caseName == "duplicate":
        secondOrdinal = 0
    elif caseName == "gap":
        secondOrdinal = 2
    elif caseName != "canonical" &&
         caseName != "noncanonical" &&
         caseName != "leadingzero" &&
         caseName != "extrafield":
        rawbytes.BytesFree(baseCargo.bytes)
        return 1
    let firstFact =
        if caseName == "noncanonical":
            NoncanonicalSymbolA
        else:
            ReplacedSymbolA
    let firstPatch =
        if caseName == "leadingzero":
            patchLineExactShape(
                ordinalId(0),
                "00",
                "replace",
                "id:sym_a",
                firstFact,
                baseDag.factsRoot,
                firstDag.factsRoot,
                false)
        elif caseName == "extrafield":
            patchLineExactShape(
                ordinalId(0),
                "0",
                "replace",
                "id:sym_a",
                firstFact,
                baseDag.factsRoot,
                firstDag.factsRoot,
                true)
        else:
            patchLine(
                ordinalId(0),
                firstOrdinal,
                "replace",
                "id:sym_a",
                firstFact,
                baseDag.factsRoot,
                firstDag.factsRoot)
    let patches = [
        firstPatch,
        patchLine(
            ordinalId(1),
            secondOrdinal,
            "insert",
            "id:sym_b",
            InsertedSymbolB,
            firstDag.factsRoot,
            finalDag.factsRoot)
    ]
    var patchCargo =
        csgc.CsgCoreCsgcEncodeCanonicalLines(patches)
    if !patchCargo.ok:
        rawbytes.BytesFree(baseCargo.bytes)
        return 1
    let baseWritten = writeBytes(basePath, baseCargo.bytes)
    let patchWritten = writeBytes(patchPath, patchCargo.bytes)
    rawbytes.BytesFree(baseCargo.bytes)
    rawbytes.BytesFree(patchCargo.bytes)
    if !baseWritten || !patchWritten:
        return 1
    return 0

fn replayFixture(
        basePath: str,
        patchPath: str,
        csgcPath: str,
        factsRootPath: str,
        proofPath: str,
        proofCidPath: str): int32 =
    let baseRead = os.ReadFileBytesResult(basePath)
    if result.IsErr(baseRead):
        return 1
    var baseBytes = result.Value(baseRead)
    let patchRead = os.ReadFileBytesResult(patchPath)
    if result.IsErr(patchRead):
        rawbytes.BytesFree(baseBytes)
        return 1
    var patchBytes = result.Value(patchRead)
    var replay = replayCanonicalSequence(baseBytes, patchBytes)
    rawbytes.BytesFree(baseBytes)
    rawbytes.BytesFree(patchBytes)
    if !replay.ok:
        os.WriteLine(os.Get_stderr(), replay.error)
        return 1
    let written = writeConformanceOutputsNonAtomic(
        replay,
        csgcPath,
        factsRootPath,
        proofPath,
        proofCidPath)
    rawbytes.BytesFree(replay.finalCsgc)
    rawbytes.BytesFree(replay.proofCargo)
    if !written:
        return 1
    os.WriteLine(
        os.Get_stdout(),
        cat(
            "incremental_cross_process_replay_ok facts_root=",
            replay.finalFactsRoot))
    system.exit(0)
    return 0

fn main(): int32 =
    if cmdline.ParamCount() == 5 &&
       cmdline.ParamStr(1) == "prepare":
        return prepareFixture(
            cmdline.ParamStr(2),
            cmdline.ParamStr(3),
            cmdline.ParamStr(4))
    if cmdline.ParamCount() == 8 &&
       cmdline.ParamStr(1) == "replay":
        return replayFixture(
            cmdline.ParamStr(2),
            cmdline.ParamStr(3),
            cmdline.ParamStr(4),
            cmdline.ParamStr(5),
            cmdline.ParamStr(6),
            cmdline.ParamStr(7))
    os.WriteLine(
        os.Get_stderr(),
        "usage: fixture prepare CASE BASE PATCH | replay BASE PATCH CSGC ROOT PROOF PROOF_CID")
    return 2
