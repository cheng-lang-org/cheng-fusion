import std/system

@importc("cheng_malloc")
fn cheng_malloc(size: int32): ptr

@importc("cheng_tcp_buffer_handle_register_bridge")
fn cheng_tcp_buffer_handle_register_bridge(raw: ptr): uint64

fn main(): int32 =
    let payload = cheng_malloc(32)
    if payload == nil:
        return 2
    let handle = cheng_tcp_buffer_handle_register_bridge(payload)
    if handle == uint64(0):
        return 3
    memReleaseAtomic(payload)
    return 0
