import std/system as system

type
    TkR3Ident =
        size: int64
        mode: int32
        inode: uint64

fn TkR3Fill(seed: int64, out: var TkR3Ident): bool =
    if seed < int64(0):
        return false
    var next: TkR3Ident
    next.size = seed
    next.mode = int32(33188)
    next.inode = uint64(9007199254740993)
    out = next
    return true

fn main(): int32 =
    var got: TkR3Ident
    let ok = TkR3Fill(int64(-31), got)
    if ok:
        return 1
    let ok2 = TkR3Fill(int64(4207), got)
    if !ok2:
        return 2
    os.WriteLine(os.Get_stdout(),
        strings.ConcatStr(
            strings.Int64ToStr(got.size),
            strings.ConcatStr("/",
                strings.ConcatStr(
                    strings.Int64ToStr(int64(got.mode)),
                    strings.ConcatStr("/",
                        strings.Int64ToStr(int64(got.inode)))))))
    return 0
