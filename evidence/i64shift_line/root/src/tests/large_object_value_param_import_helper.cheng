type
    LargeImportFe =
        v0: int64
        v1: int64
        v2: int64
        v3: int64
        v4: int64
        v5: int64
        v6: int64
        v7: int64
        v8: int64
        v9: int64

    LargeImportGeP3 =
        x: LargeImportFe
        y: LargeImportFe
        z: LargeImportFe
        t: LargeImportFe

fn LargeImportReadY0(p: LargeImportGeP3): int32 =
    return int32(p.y.v0)

fn LargeImportCopy(p: LargeImportGeP3): LargeImportGeP3 =
    return p

fn LargeImportReadPair(f, g: LargeImportFe): int32 =
    return int32(f.v0 + g.v0)

fn LargeImportFillFe(out: var LargeImportFe, value: int64) =
    out.v0 = value
    out.v1 = value + int64(1)

fn LargeImportGetFe0(f: var LargeImportFe): int64 =
    return f.v0

fn LargeImportReadValueParamThroughVar(f: LargeImportFe): int32 =
    return int32(LargeImportGetFe0(f))
