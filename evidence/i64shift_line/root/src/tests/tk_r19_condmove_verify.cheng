fn R19Trim(raw: str): str =
    return raw

fn R19Tag(raw: str): str =
    if raw.len > 3:
        return "long"
    return "short"

fn R19Core(lineRaw: str, useTag: int32): int32 =
    let line = R19Trim(lineRaw)
    var tail: str
    if useTag > 0:
        tail = R19Tag(line)
    else:
        tail = line
    let n = tail.len
    if n <= 0:
        return 0
    let left = R19Trim(tail)
    if left == "long":
        return 100 + n
    if left == "abcdef":
        return 200 + n
    return 900

fn main(): int32 =
    let live = R19Core("abcdef", 1)
    if live != 104:
        return 10
    let moved = R19Core("abcdef", 0)
    if moved != 206:
        return 11
    let liveShort = R19Core("ab", 1)
    if liveShort != 900:
        return 12
    echo("tk_r19_condmove ok live=104 moved=206")
    return 0
