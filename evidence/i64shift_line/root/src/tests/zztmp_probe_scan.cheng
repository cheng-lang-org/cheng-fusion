import cheng/core/csg_core/json_canonical as jc
import cheng/core/csg_core/jsonl
import std/os
import std/strings
import std/result

@borrows
fn csgScanReport(lineNo: int32, original: str, canonicalText: str) =
    os.WriteLine(os.Get_stderr(), strings.ConcatStr("LINE ", strings.IntToStr(lineNo)))
    os.WriteLine(os.Get_stderr(), strings.ConcatStr("len_in=", strings.IntToStr(original.len)))
    os.WriteLine(os.Get_stderr(), strings.ConcatStr("len_canon=", strings.IntToStr(canonicalText.len)))
    var at: int32 = -1
    var limit = original.len
    if canonicalText.len < limit:
        limit = canonicalText.len
    for i in 0..<limit:
        if original[i] != canonicalText[i]:
            at = i
            break
    if at < 0:
        at = limit
    var start = at - 30
    if start < 0:
        start = 0
    os.WriteLine(os.Get_stderr(), strings.ConcatStr("at=", strings.IntToStr(at)))
    os.WriteLine(os.Get_stderr(), strings.ConcatStr("IN> ", strings.SliceBytes(original, start, original.len - start)))
    os.WriteLine(os.Get_stderr(), strings.ConcatStr("CA> ", strings.SliceBytes(canonicalText, start, canonicalText.len - start)))

fn main(argc: int32, argv: str*): int32 =
    let readResult = os.ReadFileResult("/tmp/all-facts-raw.jsonl")
    if result.IsErr(readResult):
        os.WriteLine(os.Get_stderr(), "read failed")
        return 30
    let text = result.Value(readResult)
    let lines = jsonl.CsgCoreJsonlSplitLines(text)
    var badCount: int32 = 0
    for i in 0..<lines.len:
        if lines[i].len == 0:
            continue
        let canon = jc.CsgCoreJsonCanonicalize(lines[i])
        if !canon.ok:
            badCount = badCount + 1
            if badCount <= 10:
                os.WriteLine(os.Get_stderr(), strings.ConcatStr(strings.ConcatStr("LINE ", strings.IntToStr(i + 1)), " PARSE_FAIL"))
                os.WriteLine(os.Get_stderr(), canon.error)
            continue
        if canon.value != lines[i]:
            badCount = badCount + 1
            if badCount <= 10:
                csgScanReport(i + 1, lines[i], canon.value)
    os.WriteLine(os.Get_stderr(), strings.ConcatStr("BAD_TOTAL=", strings.IntToStr(badCount)))
    return 10
