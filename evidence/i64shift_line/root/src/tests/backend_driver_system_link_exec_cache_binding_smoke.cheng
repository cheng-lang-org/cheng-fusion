import std/os
import std/strings
import std/os_host_process as hostprocess
import std/strutils as strutil
import cheng/core/tooling/path as chengpath

# backend_driver system_link_exec cache binding smoke -- RETIRED face.
#
# The system_link_exec cache store/restore/binding face is physically
# retired from the backend driver (production capability switch, domains
# D+F wave).  The only honest production shape for an argv-driven
# `system-link-exec` run without a live held-exec admission is HARD_RED
# rc=2 with zero artifacts, matching the retirement assertion wired in
# backend_driver_main.cheng.

fn main(): int32 =
    let root: str = os.GetCurrentDir()
    var driver: str = os.JoinPath(root, "artifacts/backend_driver/cheng")
    let explicitDriver = strutil.Strip(os.GetEnv("CHENG_SMOKE_COMPILER"))
    if len(explicitDriver) > 0:
        driver = chengpath.PathAbsolute(root, explicitDriver)
    assert(os.FileExists(driver),
           "backend driver cache binding: backend driver exists")

    let outPath =
        "/tmp/backend_driver_system_link_exec_cache_binding_smoke.out"
    let reportPath =
        "/tmp/backend_driver_system_link_exec_cache_binding_smoke.report.txt"
    if os.FileExists(outPath):
        os.RemoveFile(outPath)
    if os.FileExists(reportPath):
        os.RemoveFile(reportPath)

    var maxRssBytes = os.GetEnv("CHENG_PROCESS_MAX_RSS_BYTES")
    if len(maxRssBytes) <= 0:
        maxRssBytes = "8589934592"
    let retiredRun = hostprocess.ExecFileCapture(
        driver,
        [
            "system-link-exec",
            Fmt"--root:{root}",
            "--in:src/tests/ordinary_zero_exit_fixture.cheng",
            "--emit:exe",
            "--target:arm64-apple-darwin",
            Fmt"--out:{outPath}",
            Fmt"--report-out:{reportPath}"],
        [
            "CHENG_ENABLE_SYSTEM_LINK_EXEC_CACHE=1",
            Fmt"CHENG_PROCESS_MAX_RSS_BYTES={maxRssBytes}"],
        root,
        true,
        120)
    assert(retiredRun.exitCode == 2,
           "backend driver cache binding: retired system-link-exec path did not HARD_RED")
    assert(strings.StrContains(
               retiredRun.output,
               "HARD_RED:production_held_exec_launcher_required"),
           "backend driver cache binding: retired system-link-exec path missing held-exec HARD_RED")
    assert(!os.FileExists(outPath),
           "backend driver cache binding: retired system-link-exec path produced exe")
    assert(!os.FileExists(reportPath),
           "backend driver cache binding: retired system-link-exec path produced report")

    echo("backend_driver_system_link_exec_cache_binding_smoke ok")
    return 0
