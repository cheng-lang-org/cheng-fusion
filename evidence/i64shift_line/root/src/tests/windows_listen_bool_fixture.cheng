import std/strutils as strutil
import std/result
import std/net/transports/tcp_syscall as tcp

fn boolText(v: bool): str =
    if v:
        return "true"
    return "false"

fn sinkBool(isV6: bool): str =
    if !isV6:
        return "took-v4"
    return "took-v6"

fn forwardDefault(host: str, port: int32, isV6: bool = false): str =
    return boolText(isV6)

fn forwardTwoHop(host: str, port: int32, isV6: bool = false): str =
    return sinkBool(isV6)

fn innerOpen(isV6: bool): str =
    if !isV6:
        return "v4-open"
    return "v6-open"

fn midListen(host: str, port: int32, isV6: bool = false): str =
    let r: str = innerOpen(isV6)
    return r

fn pubListen(host: str, port: int32, isV6: bool = false): str =
    return midListen(host, port, isV6)

type
    BigResult =
        tag: int32
        a: int64
        b: int64
        c: int64
        note: str

fn sretListen(host: str, port: int32, isV6: bool = false): BigResult =
    var out: BigResult
    out.tag = 0
    out.note = innerOpen(isV6)
    return out

fn main(): int32 =
    puts(strutil.Join(["explicit-false via default fn=", forwardDefault("127.0.0.1", 0, false)], ""))
    puts(strutil.Join(["two-hop false=", forwardTwoHop("127.0.0.1", 0, false)], ""))
    puts(strutil.Join(["two-hop true=", forwardTwoHop("127.0.0.1", 0, true)], ""))
    puts(strutil.Join(["three-hop false=", pubListen("127.0.0.1", 0, false)], ""))
    puts(strutil.Join(["three-hop true=", pubListen("127.0.0.1", 0, true)], ""))
    let sf: BigResult = sretListen("127.0.0.1", 0, false)
    puts(strutil.Join(["sret-ret false=", sf.note], ""))
    let st: BigResult = sretListen("127.0.0.1", 0, true)
    puts(strutil.Join(["sret-ret true=", st.note], ""))

    let r4: Result[tcp.TcpListenerHandle] = tcp.TcpListen4("127.0.0.1", 0)
    if IsErr(r4):
        puts(strutil.Join(["TcpListen4 err=", ErrorText(r4)], ""))
    else:
        var h4 = Value(r4)
        puts(strutil.Join(["TcpListen4 ok port=", IntToStr(h4.addr.port)], ""))
        tcp.TcpListenerClose(h4)

    let rg: Result[tcp.TcpListenerHandle] = tcp.TcpListen("127.0.0.1", 0, false)
    if IsErr(rg):
        puts(strutil.Join(["TcpListen(false) err=", ErrorText(rg)], ""))
    else:
        var hg = Value(rg)
        puts(strutil.Join(["TcpListen(false) ok port=", IntToStr(hg.addr.port)], ""))
        tcp.TcpListenerClose(hg)
    return 0
