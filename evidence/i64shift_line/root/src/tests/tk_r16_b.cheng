import std/system

fn TkR16KindTextB(kind: int32): str =
    if kind == 1:
        return "AlphaKind"
    if kind == 2:
        return "BetaKind"
    panic("tk_r16: invalid kind")

fn main(): int32 =
    let t = TkR16KindTextB(2)
    if t != "BetaKind":
        return 10
    echo(Fmt"tk_r16_b ok t={t}")
    return 0
