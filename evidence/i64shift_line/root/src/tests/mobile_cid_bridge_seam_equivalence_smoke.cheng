# Mobile CID bridge SABI golden smoke (task #71 root fix).
#
# Cross-checks the real production mobile CID bridge -- program_support_backend.cheng
# cheng_sha256_hex_bridge / cheng_sha256_word_bridge, the exact symbols
# src/mobile/mobile_capi_bridge_internal.cheng InternalMobileBridgeSha256Hex now
# imports for MobileCapiHashSeed -- against the independently-implemented
# std/crypto/sha256.cheng production path (via std/crypto/hash256.Sha256Fixed, the
# same function src/mobile/mobile_capi.cheng MobileCapiSha256HexBytes already uses
# for objectCid/blobCid). This calls the REAL @exportc bridge symbols directly
# through the new (ptr,len:int64)->buffer / (ptr,len:int64,idx)->int64 contract (no
# standalone reimplementation standing in for it). FIPS 180-4 vectors are
# hardcoded (published constants, not computed) for empty/"abc".
import std/system
import std/rawbytes
import std/strformat
import std/strings
import std/crypto/hash256
import std/bytes_layout as layout

importc fn cheng_sha256_hex_bridge(textRaw: ptr, textLen: int64, outHex: ptr): int32
importc fn cheng_sha256_word_bridge(textRaw: ptr, textLen: int64, wordIndex: int32): int64

@borrows
fn bridgeHexOf(text: str): str =
    let outBuf: Bytes = BytesAlloc(64)
    let n = cheng_sha256_hex_bridge(StrDataPtr(text), int64(len(text)), outBuf.data)
    if n != 64:
        return ""
    return BytesToString(outBuf)

@borrows
fn bridgeWordOf(text: str, wordIndex: int32): int64 =
    return cheng_sha256_word_bridge(StrDataPtr(text), int64(len(text)), wordIndex)

fn buildBytes(n: int32): Bytes =
    var b: Bytes = BytesAlloc(n)
    var i: int32
    for i in 0..<n:
        BytesSet(b, i, (i * 37 + 11) % 256)
    return b

fn stdHexOf(b: Bytes): str =
    let digest = hash256.Sha256Fixed(layout.byteSpanFromBytes(b))
    return layout.FixedBytes32Hex(digest)

fn stdWordOf(b: Bytes, wordIndex: int32): int64 =
    let digest = hash256.Sha256Fixed(layout.byteSpanFromBytes(b))
    let base = wordIndex * 8
    var out: uint64 = uint64(0)
    var i: int32
    for i in 0..<8:
        out = (out << uint64(8)) | uint64(digest.data[base + i])
    return int64(out)

fn checkLen(n: int32): bool =
    let buf = buildBytes(n)
    let text = BytesToString(buf)
    let bridgeHex = bridgeHexOf(text)
    let stdHex = stdHexOf(buf)
    var ok = true
    if bridgeHex != stdHex:
        echo(Fmt"HEX MISMATCH len={n} bridge={bridgeHex} std={stdHex}")
        ok = false
    var w: int32
    for w in 0..<4:
        let bridgeWord = bridgeWordOf(text, w)
        let stdWord = stdWordOf(buf, w)
        if bridgeWord != stdWord:
            echo(Fmt"WORD MISMATCH len={n} word={w} bridge={strings.Int64ToStr(bridgeWord)} std={strings.Int64ToStr(stdWord)}")
            ok = false
    if ok:
        echo(Fmt"OK len={n} {bridgeHex}")
    return ok

fn checkFixedVector(text: str, expectedHex: str, label: str): bool =
    let bridgeHex = bridgeHexOf(text)
    if bridgeHex != expectedHex:
        echo(Fmt"FIPS MISMATCH {label} bridge={bridgeHex} expected={expectedHex}")
        return false
    echo(Fmt"FIPS OK {label} {bridgeHex}")
    return true

fn main(): int32 =
    var allOk = true
    if !checkFixedVector("",
                          "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
                          "empty"):
        allOk = false
    if !checkFixedVector("abc",
                          "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad",
                          "abc"):
        allOk = false
    var lens: int32[16]
    lens[0] = 0
    lens[1] = 1
    lens[2] = 55
    lens[3] = 56
    lens[4] = 57
    lens[5] = 63
    lens[6] = 64
    lens[7] = 65
    lens[8] = 127
    lens[9] = 128
    lens[10] = 129
    lens[11] = 191
    lens[12] = 192
    lens[13] = 200
    lens[14] = 255
    lens[15] = 1000
    var i: int32
    for i in 0..<16:
        if !checkLen(lens[i]):
            allOk = false
    if allOk:
        echo("mobile_cid_bridge_seam_equivalence_smoke all ok")
        return 0
    echo("mobile_cid_bridge_seam_equivalence_smoke FAIL")
    return 1
