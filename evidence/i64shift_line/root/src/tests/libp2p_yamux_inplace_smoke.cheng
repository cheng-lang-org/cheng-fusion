# Yamux/mplex muxer + memory transport in-place state smoke.
# Guards the whole-struct-copy -> in-place (var-param) rewrite of
# yamux.cheng / muxer.cheng / memorytransport.cheng / wstransport.cheng:
# stream open/accept + frame write/read + close/reset + muxer slot reuse
# must behave identically before and after the rewrite.
#
# 2026-07-09 toolchain status: NOT yet runnable end-to-end.
# - pure backend driver: muxer/yamux closure hits preexisting nested
#   indexed-aggregate fill gaps (plan_not_ready, 41-missing family).
# - stage3 cold backend: preexisting "indexed field assignment value too
#   large" in muxerResetStreamInState blocks compile (before AND after).
# Runs as the runtime gate once either backend gap closes. The rewrite's
# introduced forms are runtime-verified by libp2p_memorytransport_state_smoke
# (green via stage3) plus pure-driver form fixtures (see findings).

import cheng/libp2p/utils/result
import cheng/libp2p/utils/bytes
import cheng/libp2p/multiaddress
import cheng/libp2p/transports/memorytransport
import cheng/libp2p/stream/connection
import cheng/libp2p/muxers/muxer

fn runYamuxDataPath(): Result[bool] =
    let addrRes: Result[MultiAddress] = parseMultiAddress("/memory/77")
    if IsErr(addrRes):
        return Err[bool](Error(addrRes))
    let addr = Value(addrRes)
    var listener = initMemoryTransport()
    start(listener, addr)
    var dialer = initMemoryTransport()
    let outConnRes: Result[Connection] = dial(dialer, addr)
    if IsErr(outConnRes):
        return Err[bool]("yamux smoke: dial failed: " + Error(outConnRes))
    let inConnRes: Result[Connection] = accept(listener)
    if IsErr(inConnRes):
        return Err[bool]("yamux smoke: accept failed: " + Error(inConnRes))
    let outMuxRes: Result[Muxer] = newMuxerWithKind(Value(outConnRes), muxerKindYamux)
    if IsErr(outMuxRes):
        return Err[bool]("yamux smoke: outbound muxer failed: " + Error(outMuxRes))
    let inMuxRes: Result[Muxer] = newMuxerWithKind(Value(inConnRes), muxerKindYamux)
    if IsErr(inMuxRes):
        return Err[bool]("yamux smoke: inbound muxer failed: " + Error(inMuxRes))
    var outMux = Value(outMuxRes)
    var inMux = Value(inMuxRes)
    if ! isOpen(outMux) || ! isOpen(inMux):
        return Err[bool]("yamux smoke: muxer ! open")
    let outStreamRes: Result[Stream] = openStream(outMux)
    if IsErr(outStreamRes):
        return Err[bool]("yamux smoke: openStream failed: " + Error(outStreamRes))
    var outStream = Value(outStreamRes)
    let inStreamRes: Result[Stream] = acceptStream(inMux)
    if IsErr(inStreamRes):
        return Err[bool]("yamux smoke: acceptStream failed: " + Error(inStreamRes))
    var inStream = Value(inStreamRes)
    if ! streamIsOpen(outStream) || ! streamIsOpen(inStream):
        return Err[bool]("yamux smoke: stream ! open")
    let payload: Bytes = BytesFromString("hello yamux in-place")
    let writeRes: Result[int32] = streamWrite(outStream, payload)
    if IsErr(writeRes):
        return Err[bool]("yamux smoke: write failed: " + Error(writeRes))
    if Value(writeRes) != BytesLen(payload):
        return Err[bool]("yamux smoke: short write")
    let readRes: Result[Bytes] = streamRead(inStream, BytesLen(payload))
    if IsErr(readRes):
        return Err[bool]("yamux smoke: read failed: " + Error(readRes))
    if ! BytesEqual(Value(readRes), payload):
        return Err[bool]("yamux smoke: payload mismatch")
    let backPayload: Bytes = BytesFromString("pong")
    let backWriteRes: Result[int32] = streamWrite(inStream, backPayload)
    if IsErr(backWriteRes):
        return Err[bool]("yamux smoke: back write failed: " + Error(backWriteRes))
    let backReadRes: Result[Bytes] = streamRead(outStream, BytesLen(backPayload))
    if IsErr(backReadRes):
        return Err[bool]("yamux smoke: back read failed: " + Error(backReadRes))
    if ! BytesEqual(Value(backReadRes), backPayload):
        return Err[bool]("yamux smoke: back payload mismatch")
    let closeRes: Result[bool] = closeStream(outStream)
    if IsErr(closeRes):
        return Err[bool]("yamux smoke: closeStream failed: " + Error(closeRes))
    let inCloseRes: Result[bool] = closeStream(inStream)
    if IsErr(inCloseRes):
        return Err[bool]("yamux smoke: inbound closeStream failed: " + Error(inCloseRes))
    if streamIsOpen(outStream):
        return Err[bool]("yamux smoke: outbound stream still open after close")
    # Second stream on the same muxer pair exercises stream-slot reuse.
    let outStream2Res: Result[Stream] = openStream(outMux)
    if IsErr(outStream2Res):
        return Err[bool]("yamux smoke: second openStream failed: " + Error(outStream2Res))
    var outStream2 = Value(outStream2Res)
    let inStream2Res: Result[Stream] = acceptStream(inMux)
    if IsErr(inStream2Res):
        return Err[bool]("yamux smoke: second acceptStream failed: " + Error(inStream2Res))
    var inStream2 = Value(inStream2Res)
    let payload2: Bytes = BytesFromString("second stream")
    let write2Res: Result[int32] = streamWrite(outStream2, payload2)
    if IsErr(write2Res):
        return Err[bool]("yamux smoke: second write failed: " + Error(write2Res))
    let read2Res: Result[Bytes] = streamRead(inStream2, BytesLen(payload2))
    if IsErr(read2Res):
        return Err[bool]("yamux smoke: second read failed: " + Error(read2Res))
    if ! BytesEqual(Value(read2Res), payload2):
        return Err[bool]("yamux smoke: second payload mismatch")
    let resetRes: Result[bool] = resetStream(outStream2)
    if IsErr(resetRes):
        return Err[bool]("yamux smoke: resetStream failed: " + Error(resetRes))
    if streamIsOpen(outStream2):
        return Err[bool]("yamux smoke: stream still open after reset")
    closeMuxer(outMux)
    closeMuxer(inMux)
    if isOpen(outMux):
        return Err[bool]("yamux smoke: outbound muxer still open after close")
    stop(listener)
    return Ok[bool](true)

fn runMuxerSlotReuse(): Result[bool] =
    # Close then re-create muxers so the state-table reuse path
    # (reinit of a previously used slot) is exercised.
    let pairRes: Result[ConnectionPair] = newConnectionPair(emptyMultiAddress(), emptyMultiAddress(), emptyMultiAddress(), emptyMultiAddress())
    if IsErr(pairRes):
        return Err[bool](Error(pairRes))
    let pair = Value(pairRes)
    let firstRes: Result[Muxer] = newMuxerWithKind(pair.outbound, muxerKindYamux)
    if IsErr(firstRes):
        return Err[bool]("reuse smoke: first muxer failed: " + Error(firstRes))
    var first = Value(firstRes)
    let firstId: int32 = first.id
    closeMuxer(first)
    let pair2Res: Result[ConnectionPair] = newConnectionPair(emptyMultiAddress(), emptyMultiAddress(), emptyMultiAddress(), emptyMultiAddress())
    if IsErr(pair2Res):
        return Err[bool](Error(pair2Res))
    let pair2 = Value(pair2Res)
    let secondRes: Result[Muxer] = newMuxerWithKind(pair2.outbound, muxerKindYamux)
    if IsErr(secondRes):
        return Err[bool]("reuse smoke: second muxer failed: " + Error(secondRes))
    var second = Value(secondRes)
    if second.id != firstId:
        return Err[bool]("reuse smoke: slot not reused")
    if ! isOpen(second):
        return Err[bool]("reuse smoke: reused muxer ! open")
    let streamRes: Result[Stream] = openStream(second)
    if IsErr(streamRes):
        return Err[bool]("reuse smoke: openStream on reused slot failed: " + Error(streamRes))
    closeMuxer(second)
    return Ok[bool](true)

fn main(): int32 =
    let dataRes: Result[bool] = runYamuxDataPath()
    if IsErr(dataRes):
        echo("libp2p yamux inplace smoke failed: " + Error(dataRes))
        return 1
    let reuseRes: Result[bool] = runMuxerSlotReuse()
    if IsErr(reuseRes):
        echo("libp2p muxer reuse smoke failed: " + Error(reuseRes))
        return 1
    echo("libp2p yamux inplace smoke ok")
    return 0
