import std/system
import std/hashmaps as hashmaps

type
    ReproBox2 = ref object
        m: hashmaps.HashMapStrInt

@borrows
fn reproDetach(b: ReproBox2, index: var hashmaps.HashMapStrInt) =
    var wrapper = b.m
    b.m = hashmaps.HashMapStrInt()
    var keys = wrapper.keys
    wrapper.keys = []
    index.keys = keys
    var vals = wrapper.vals
    wrapper.vals = []
    index.vals = vals
    var hashes = wrapper.hashes
    wrapper.hashes = []
    index.hashes = hashes
    var states = wrapper.states
    wrapper.states = []
    index.states = states
    index.mask = wrapper.mask
    index.used = wrapper.used

@borrows
fn reproIntern(b: ReproBox2, text: str): int32 =
    let ownedText = strings.CloneStr(text)
    var index: hashmaps.HashMapStrInt
    reproDetach(b, index)
    hashmaps.HashMapStrIntPut(index, ownedText, 7)
    b.m = index
    return 7

fn main() =
    var b: ReproBox2 = new(ReproBox2)
    hashmaps.HashMapStrIntInitInPlace(b.m, 64)
    let got = reproIntern(b, "alpha")
    assert(got == 7, "repro C2: id")
    echo("repro_orc_boxfield_c2 ok")
