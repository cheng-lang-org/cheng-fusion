# SUPERSEDED theater algorithms removed (2026-07-17 skeptic).
# True-path entry: declares_type_real_path_smoke.cheng
# This file is a thin alias that drives the same shipped pobj APIs so
# existing references to *equiv* keep working.

import std/os
import std/strings as strings
import std/strutils as strutil
import std/monotimes as mono
import cheng/core/tooling/path as chengpath
import cheng/core/backend/primary_object_plan as pobj

fn fixtureAbsPath(): str =
    let root = chengpath.PathCurrentDir()
    return chengpath.PathJoin(root, "src/tests/declares_type_index_fixture.cheng")

fn main(): int32 =
    let path = fixtureAbsPath()
    let text = os.ReadFile(path)
    assert(text != "", "fixture must exist on disk")
    assert(strutil.Contains(text, "DeclaresFixtureAlpha"), "fixture content")

    pobj.PrimaryBodyIrResetLookupCaches()

    assert(pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "DeclaresFixtureAlpha"),
           "shipped DeclaresType hit Alpha")
    assert(pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "DeclaresFixtureBeta"),
           "shipped DeclaresType hit Beta")
    assert(pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "DeclaresFixtureGamma"),
           "shipped DeclaresType hit Gamma")
    assert(!pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "NoSuchTypeAtAll"),
           "shipped DeclaresType miss")
    assert(!pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "declaresFixtureFiller0"),
           "fn name is not a type decl")

    assert(pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "DeclaresFixtureAlpha"),
           "second-pass Alpha")
    assert(!pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "NoSuchTypeAtAll"),
           "second-pass miss")

    var targets: str[]
    pobj.PrimaryBodyIrSourceOwnImportTargets(path, targets)
    assert(targets.len >= 1, "OwnImportTargets must surface import lines")
    pobj.PrimaryBodyIrSourceOwnImportTargets(path, targets)
    assert(targets.len >= 1, "OwnImportTargets second call")

    pobj.PrimaryBodyIrResetLookupCaches()
    assert(pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "DeclaresFixtureBeta"),
           "after ResetLookupCaches still hits")
    assert(!pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "GhostType"),
           "after reset still misses")

    pobj.PrimaryBodyIrResetLookupCaches()
    let warm = pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "DeclaresFixtureAlpha")
    assert(warm, "warmup")
    let rounds = 2000
    var sink: int32 = 0
    let t0 = mono.GetMonoTime()
    for r in 0..<rounds:
        if pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "DeclaresFixtureAlpha"):
            sink = sink + 1
        if pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "DeclaresFixtureBeta"):
            sink = sink + 1
        if pobj.PrimaryBodyIrSourceModuleDeclaresType(path, "NoSuchTypeAtAll"):
            sink = sink + 1
    let t1 = mono.GetMonoTime()
    let wallMs = int32((mono.MonoTimeNs(t1) - mono.MonoTimeNs(t0)) / 1000000)
    assert(sink == rounds * 2, "sink must count only real hits from shipped API")
    echo("declares_index_equiv ok")
    echo("declares_type_real_path_smoke ok")
    echo("shipped_declares_queries=" + strings.IntToStr(rounds * 3))
    echo("shipped_declares_wall_ms=" + strings.IntToStr(wallMs))
    echo("shipped_declares_sink=" + strings.IntToStr(sink))
    echo("fixture_path=" + path)
    return 0
