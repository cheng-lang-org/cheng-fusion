import std/buffer
import std/rawbytes

fn main(): int32 =
    var buf = buffer.NewByteBuffer()
    buffer.AppendText(buf, "parser:")
    buffer.AppendText(buf, "first")

    let first = buffer.FinishString(buf)
    assert(first == "parser:first", "parser buffer finish string: first content")
    assert(buffer.ByteBufferLen(buf) == 0, "parser buffer finish string: consumed len")
    assert(rawbytes.BytesLen(buffer.ToBytes(buf)) == 0, "parser buffer finish string: empty view")

    buffer.AppendText(buf, "second")
    let second = buffer.FinishString(buf)
    assert(second == "second", "parser buffer finish string: reuse content")
    assert(first == "parser:first", "parser buffer finish string: returned text owns bytes")
    assert(buffer.ByteBufferLen(buf) == 0, "parser buffer finish string: reuse consumed len")

    let empty = buffer.FinishString(buf)
    assert(empty == "", "parser buffer finish string: empty content")
    assert(buffer.ByteBufferLen(buf) == 0, "parser buffer finish string: empty consumed len")

    echo("parser_buffer_finish_string_smoke ok")
    return 0
