# wall38 前置墙最小探针：worker 形（ptr 参数 cast ref + var staged + var-out 回写）。
# 镜像 backend_driver_dispatch_min.cheng:6865-6890 的 staging 结构（无 panic 依赖版）。
type
    W38Plan = object
        text: str
        ok: bool

    W38Work = ref object
        plan: W38Plan
        err: str
        ok: bool

fn w38BuildPlanInto(channel: str, plan: var W38Plan, err: var str): bool =
    plan.text = channel
    plan.ok = true
    err = ""
    return true

fn w38Worker(raw: ptr) =
    if raw == nil:
        return
    let work: W38Work = W38Work(raw)
    var queryPlan: W38Plan = work.plan
    if !w38BuildPlanInto("ch", queryPlan, work.err):
        work.ok = false
        return
    work.plan = queryPlan
    work.ok = true

fn main(): int32 =
    return 0
