import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/core_types as coreir
import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr
import cheng/std/bytes_layout as layout

fn smokeAssert(condition: bool, message: str) =
    if !condition:
        panic(message)

fn deferTransport(): lower.LoweringDeferScopeTransportSoA =
    var transport: lower.LoweringDeferScopeTransportSoA
    transport.typedFunctionIndex = 0
    transport.sourceStatementStart = 700
    transport.sourceStatementCount = 1
    transport.sourceScopeStart = 0
    transport.sourceScopeCount = 3
    transport.scopeIds = [0, 1, 2]
    transport.scopeParentIds = [-1, 0, 1]
    transport.scopeKinds = [
        parser.NormalizedScopeRoot,
        parser.NormalizedScopeIndentedSuite,
        parser.NormalizedScopeDeferSuite]
    transport.scopeOwnerStatementOrdinals = [-1, -1, 31]
    transport.scopeLexicalOrdinals = [0, 0, 0]
    transport.scopeStartLineNumbers = [1, 2, 3]
    transport.scopeStartColumnNumbers = [1, 5, 9]
    transport.scopeEndLineNumbers = [6, 5, 4]
    transport.scopeEndColumnNumbers = [20, 20, 20]
    transport.statementIndexes = [700]
    transport.statementKinds = [texpr.TypedExprIrStmtDefer]
    transport.statementLineNumbers = [3]
    transport.statementColumnNumbers = [5]
    transport.statementEndLineNumbers = [3]
    transport.statementEndColumnNumbers = [20]
    transport.statementLexicalScopeIds = [1]
    transport.statementSuiteScopeIds = [2]
    transport.statementOrdinals = [31]
    transport.statementLexicalOrdinals = [4]
    transport.statementDeferOwnerStatementOrdinals = [-1]
    transport.complete = true
    return transport

fn appendReturn(bodyIR: var coreir.BodyIR): int32 =
    var term: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = coreir.BodyTermReturnTag
    return coreir.BodyIRAppendTerm(bodyIR, term)

fn main(): int32 =
    let transport = deferTransport()
    var bodyIR = coreir.BodyIRNew()
    let typeArenaCid = layout.FixedBytes32FromHex(
        "7171717171717171717171717171717171717171717171717171717171717171")
    smokeAssert(
        typeArenaCid.ok &&
        coreir.BodyIRBindTypeArenaArtifactCid(
            bodyIR, typeArenaCid.value),
        "lowering detached defer: TypeArena CID")
    lower.LoweringBodyIrControlBegin(bodyIR, transport, 0)

    var skip: coreir.BodyTerm
    coreir.BodyIRApplyBodyTermDefaultProof(skip)
    skip.kind = coreir.BodyTermBrTag
    skip.trueBlock = 2
    let skipTermIndex = coreir.BodyIRAppendTerm(bodyIR, skip)
    let declarationBlockId =
        coreir.BodyIRAppendBlock(bodyIR, 0, 0, skipTermIndex)
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, 1)
    let deferId =
        lower.LoweringBodyIrControlBindDeferAction(
            bodyIR, transport, 700, declarationBlockId, 0)

    let actionReturnTermIndex = appendReturn(bodyIR)
    let actionBlockId =
        coreir.BodyIRAppendBlock(
            bodyIR, 0, 0, actionReturnTermIndex)
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, 2)
    let continuationReturnTermIndex = appendReturn(bodyIR)
    let continuationBlockId =
        coreir.BodyIRAppendBlock(
            bodyIR, 0, 0, continuationReturnTermIndex)
    lower.LoweringBodyIrControlBindNewBlocks(bodyIR, 1)

    var breakTerms: int32[]
    var continueTerms: int32[]
    var loopBackTerms: int32[]
    lower.LoweringBodyIrControlSeal(
        bodyIR,
        transport,
        breakTerms,
        continueTerms,
        loopBackTerms)
    let actionCid =
        coreir.BodyIRControlFlowDeferActionCid(
            bodyIR, deferId)
    smokeAssert(
        deferId == 0 &&
        actionBlockId == 1 &&
        continuationBlockId == 2 &&
        bodyIR.deferFunctionRows[0] == 0 &&
        bodyIR.deferStatementRows[0] == 700 &&
        bodyIR.deferLexicalOrdinals[0] == 4 &&
        bodyIR.deferActivationRows.len == 1 &&
        bodyIR.deferActivationRows[0] == 0 &&
        coreir.BodyIRTypeArenaArtifactCidValid(actionCid) &&
        layout.FixedBytes32Equal(
            actionCid, bodyIR.deferActionCids[0]) &&
        coreir.BodyIRControlFlowShapeValid(bodyIR),
        "lowering detached defer: production receipt")
    echo(
        "lowering_detached_defer_production_smoke ok defer=1 activation=1 action_cid=1")
    return 0
