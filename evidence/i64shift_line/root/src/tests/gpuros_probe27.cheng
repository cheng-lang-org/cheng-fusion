@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt16Ptr = uint16 *
    IoUInt32Ptr = uint32 *
    IoUInt64Ptr = uint64 *
    GpuDev =
        base: uint64
        availIdx: int32
        usedSeen: int32

const RegStatusC: uint64 = 0x070
const StFeat: uint32 = 8

@trusted_abi
fn IoLd32(base: uint64, offset: uint64): int32 =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoSt32(base: uint64, offset: uint64, value: uint32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamLd32(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoRamSt32(base: uint64, byteOffset: int32, value: uint32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt32Ptr(addr)) = value

@trusted_abi
fn IoRamSt16(base: uint64, byteOffset: int32, value: int32) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt16Ptr(addr)) = uint16(value & 65535)

@trusted_abi
fn IoRamLd16(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt16Ptr(addr)))

fn HexNib(v: int32) =
    let w = v
    if w < 10:
        IoSt32(268435456, 0, uint32(48 + w))
    else:
        IoSt32(268435456, 0, uint32(87 + w))

fn Hex32(v: int32) =
    var div = 268435456
    while div > 0:
        HexNib((v / div) & 15)
        div = div / 16

fn Sep() =
    IoSt32(268435456, 0, uint32(32))

fn GpuKick(st: var GpuDev, respLo: uint32, respHi: uint32,
           cmdLen: uint32): int32 =
    IoRamSt32(2183135232, 0, uint32(2183159808))
    IoRamSt32(2183135232, 4, uint32(0))
    IoRamSt32(2183135232, 8, cmdLen)
    IoRamSt16(2183135232, 12, 1)
    IoRamSt16(2183135232, 14, 1)
    IoRamSt32(2183135232, 16, respLo)
    IoRamSt32(2183135232, 20, uint32(0))
    IoRamSt32(2183135232, 24, uint32(32))
    IoRamSt16(2183135232, 28, 2)
    IoRamSt16(2183135232, 30, 0)
    IoRamSt16(2183136256, 4 + 2 * (st.availIdx & 63), 0)
    st.availIdx = st.availIdx + 1
    IoRamSt16(2183136256, 2, st.availIdx)
    IoSt32(st.base, uint64(0x050), uint32(0))
    var spins = 0
    var out = int32(0)
    while spins < 20000000:
        let usedIdx = IoRamLd16(2183140354, 2)
        if usedIdx != (st.usedSeen & 65535):
            st.usedSeen = st.usedSeen + 1
            out = IoRamLd32(respLo, 0)
            spins = 20000000
        spins = spins + 1
    return out

fn main(): int32 =
    var st: GpuDev
    st.base = uint64(268468224)
    st.availIdx = 0
    st.usedSeen = 0
    IoSt32(st.base, RegStatusC, uint32(0))
    let st0 = IoLd32(st.base, RegStatusC)
    let nv0 = st0 | StFeat
    IoSt32(st.base, RegStatusC, nv0)
    IoSt32(st.base, uint64(0x028), uint32(4096))
    IoSt32(st.base, uint64(0x030), uint32(0))
    IoSt32(st.base, uint64(0x038), uint32(64))
    IoSt32(st.base, uint64(0x03C), uint32(4096))
    IoSt32(st.base, uint64(0x040), uint32(532992))

    let c1 = GpuKick(st, uint32(2183163904), uint32(0), uint32(40))
    Hex32(c1)
    Sep()
    let c2 = GpuKick(st, uint32(2183164928), uint32(0), uint32(40))
    Hex32(c2)
    Sep()
    let c3 = GpuKick(st, uint32(2183165952), uint32(0), uint32(40))
    Hex32(c3)
    Sep()
    let c4 = GpuKick(st, uint32(2183166976), uint32(0), uint32(40))
    Hex32(c4)
    Sep()
    let c5 = GpuKick(st, uint32(2183168000), uint32(0), uint32(40))
    Hex32(c5)
    IoSt32(268435456, 0, uint32(10))
    return 0
