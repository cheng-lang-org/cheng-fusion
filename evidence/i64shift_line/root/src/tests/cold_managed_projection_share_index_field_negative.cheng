import std/system

type ColdManagedProjectionShareReloc =
    targetSymbol: str

fn main(): int32 =
    var reloc: ColdManagedProjectionShareReloc
    reloc.targetSymbol = IntToStr(42)
    var relocs: ColdManagedProjectionShareReloc[]
    add(relocs, reloc)
    let copiedName = share(relocs[0].targetSymbol)
    if copiedName != "42":
        return 1
    return 0
