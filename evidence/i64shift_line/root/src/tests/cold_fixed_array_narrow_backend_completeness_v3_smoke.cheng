# #133 v3 regression lock: five independent decision-point gaps left after
# v2 (which synced the *width* of the per-op array-element STORE/DYNAMIC
# codegen on arm64, but missed several sibling decision points and the
# element *sign*). Each numbered section below pins one gap; see
# fix_verdict.md's decision-point matrix for the exact source locations.
type
    NestedInner =
        n: uint16[3]
        b: bool[3]
        s8: int8[3]
    NestedOuter =
        nested: NestedInner
    SignedFields =
        s8: int8[3]
        s16: int16[3]

var gU16: uint16[3]
var gI16: int16[3]
var gBool: bool[3]

fn main(): int32 =
    # 1) gap(1): multi-hop field-chain narrow array element WRITE
    #    (o.nested.arr[i] = v). parse_seq_index_ref_from_spans's additive
    #    scalar-int32 bypass only recognized element_size==4; uint16/int16/
    #    bool regressed to a hard die from v1 onward (pristine could
    #    compile them via the generic 4-byte fallback), int8/uint8/char
    #    were never supported even pre-#133 (both populations now fixed).
    var o: NestedOuter
    o.nested.n[0] = 65535
    o.nested.n[1] = 258
    if o.nested.n[0] != 65535: return 1
    if o.nested.n[1] != 258: return 2
    o.nested.b[0] = true
    o.nested.b[1] = false
    if o.nested.b[0] != true: return 3
    if o.nested.b[1] != false: return 4
    o.nested.s8[0] = -22
    if o.nested.s8[0] != -22: return 5

    # 2) gap(2): module-level (global) fixed narrow-scalar array element
    #    WRITE. The module-level-global write branch's `scalar_element`
    #    eligibility check is a THIRD, independent copy of the same
    #    element_size gate (distinct from parse_postfix's two read
    #    branches) and never got size==2 added -- regressed to
    #    "unsupported index assignment target" from v1 onward.
    gU16[0] = 65535
    gU16[1] = 258
    if gU16[0] != 65535: return 10
    if gU16[1] != 258: return 11
    gI16[0] = -22
    if gI16[0] != -22: return 12
    gBool[0] = true
    if gBool[0] != true: return 13

    # 3) sixth decision point found auditing the same family: fixed
    #    multi-dim nested array store (`grid[i][j] = v`), a SEPARATE
    #    scalar_element gate from gap(2)'s global-write branch.
    var grid: uint16[2][2]
    grid[0][0] = 1000
    grid[1][1] = 2000
    if grid[0][0] != 1000: return 20
    if grid[1][1] != 2000: return 21

    # 4) gap(3): int8[N]/int16[N] negative-value round-trip. elem_width==1
    #    routed int8[N] through the same LDRB (zero-extend) as bool[N]/
    #    uint8[N]; elem_width==2 routed int16[N] through the same LDRH
    #    (zero-extend) as uint16[N]. Constant index, dynamic index, and
    #    struct-field forms, plus the masked-index loop peephole.
    var a8: int8[3]
    a8[0] = -22
    a8[1] = -1
    if a8[0] != -22: return 30
    if a8[1] != -1: return 31
    var b8: int8[3]
    for i in 0..<3:
        b8[i] = 0 - i - 1
    for i in 0..<3:
        if b8[i] != 0 - i - 1: return 32 + i
    var a16: int16[3]
    a16[0] = -22
    a16[1] = 30000
    if a16[0] != -22: return 40
    if a16[1] != 30000: return 41
    var b16: int16[3]
    for j in 0..<3:
        b16[j] = 0 - (j + 1) * 100
    for j in 0..<3:
        if b16[j] != 0 - (j + 1) * 100: return 42 + j
    var sf: SignedFields
    sf.s8[0] = -22
    sf.s16[0] = -22
    sf.s16[1] = -30000
    if sf.s8[0] != -22: return 50
    if sf.s16[0] != -22: return 51
    if sf.s16[1] != -30000: return 52
    for k in 0..<3:
        sf.s16[k] = 0 - (k + 1) * 100 - 100
    for k in 0..<3:
        if sf.s16[k] != 0 - (k + 1) * 100 - 100: return 53 + k
    var m8: int8[4]
    m8[0] = -1
    m8[1] = -2
    m8[2] = -3
    m8[3] = -4
    var sum: int32 = 0
    for i in 0..<8:
        let idx = i & 3
        sum = sum + int32(m8[idx])
    if sum != -20: return 60

    # 5) uint8[N] repeated-constant-index-write pre-existing defect (v2
    #    fixed it as an undisclosed side effect of the structural-predicate
    #    migration on arm64; explicitly locked here so it cannot silently
    #    regress).
    var u: uint8[4]
    u[0] = 250
    u[1] = 10
    if u[0] != 250: return 70
    if u[1] != 10: return 71

    return 0
