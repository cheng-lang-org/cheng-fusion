import std/os
import std/strings
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/tooling/semantic_snapshot as snapshot
import cheng/core/tooling/semantic_snapshot_query_projection as projection
import cheng/core/tooling/semantic_snapshot_declaration_identity as declaration
import cheng/core/tooling/compiler_world as cworld

const LargeDocumentCount: int32 = 2048

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn SequentialCid(value: int32): layout.FixedBytes32 =
    assert(value > 0, "lsp immutable query index: invalid sequential CID")
    var out: layout.FixedBytes32
    out.data[28] = uint8((value >> 24) & 255)
    out.data[29] = uint8((value >> 16) & 255)
    out.data[30] = uint8((value >> 8) & 255)
    out.data[31] = uint8(value & 255)
    return out

fn MakeExactTables(): schema.CsgCompilerSnapshotTables =
    var tables: schema.CsgCompilerSnapshotTables
    var err: str
    var sourceA: layout.FixedBytes32
    var sourceB: layout.FixedBytes32
    assert(cworld.CompilerWorldDocumentCidInto(
               "pkg", "pkg/alpha", sourceA, err), err)
    assert(cworld.CompilerWorldDocumentCidInto(
               "pkg", "pkg/beta", sourceB, err), err)
    tables.sources.documentCids = [sourceA, sourceB]
    tables.sources.modulePathTextIds = [2, 3]

    # name A, declaration A, name B, declaration B
    tables.spans.sourceIds = [0, 0, 1, 1]
    tables.spans.startBytes = [3, 0, 13, 10]
    tables.spans.endBytes = [8, 9, 17, 18]
    tables.spans.startLines = [0, 0, 0, 0]
    tables.spans.startColumns = [3, 0, 3, 0]
    tables.spans.endLines = [0, 0, 0, 0]
    tables.spans.endColumns = [8, 9, 7, 8]

    tables.texts = ["Alpha", "Beta",
                    "pkg/alpha", "pkg/beta",
                    "pkg/beta::Beta", "pkg/alpha::Alpha"]
    tables.tokens.sourceIds = [0, 1]
    tables.tokens.sourceLocalRows = [0, 0]
    tables.tokens.lexicalParentTokenIds = [-1, -1]
    tables.tokens.spanIds = [0, 2]
    tables.tokens.kinds = [1, 1]
    tables.tokens.valueTextIds = [0, 1]

    # Deliberately store symbols and references in the opposite source order.
    # The immutable CSR must retain exact canonical row identities.
    tables.symbols.symbolCids = [
        TestCid("lsp-index/symbol-beta"),
        TestCid("lsp-index/module-beta"),
        TestCid("lsp-index/symbol-alpha"),
        TestCid("lsp-index/module-alpha")]
    tables.symbols.declIds = [-1, -1, -1, -1]
    tables.symbols.declKeyCids = [
        layout.FixedBytes32(), layout.FixedBytes32(),
        layout.FixedBytes32(), layout.FixedBytes32()]
    tables.symbols.sourceIds = [1, 1, 0, 0]
    tables.symbols.nameTextIds = [1, 3, 0, 2]
    tables.symbols.nameSpanIds = [2, -1, 0, -1]
    tables.symbols.nameTokenIds = [1, -1, 0, -1]
    tables.symbols.qualifiedNameTextIds = [4, 3, 5, 2]
    tables.symbols.declarationSpanIds = [3, -1, 1, -1]
    tables.symbols.ownerSymbolIds = [1, -1, 3, -1]
    tables.symbols.symbolKinds = [
        schema.CsgCompilerSymbolFunction,
        schema.CsgCompilerSymbolModule,
        schema.CsgCompilerSymbolFunction,
        schema.CsgCompilerSymbolModule]
    tables.symbols.functionIds = [0, -1, 1, -1]
    tables.symbols.externFunctionIds = [-1, -1, -1, -1]
    tables.functions.symbolIds = [0, 2]
    tables.symbols.typeIds = [1, -1, 0, -1]
    tables.types.typeCids = [TestCid("lsp-index/type-alpha"),
                             TestCid("lsp-index/type-beta")]
    tables.types.producerTypeArenaIds = [-1, -1]
    var candidates: declaration.SemanticSnapshotDeclarationCandidateStore
    declaration.SemanticSnapshotDeclarationCandidateStoreInitInto(candidates)
    var moduleA: int32
    var moduleB: int32
    var functionA: int32
    var functionB: int32
    let proofA = TestCid("lsp-index/name-proof-alpha")
    let proofB = TestCid("lsp-index/name-proof-beta")
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               candidates, "pkg", "pkg/alpha", sourceA, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/alpha", sourceA, sourceA, layout.FixedBytes32(),
               0, 0, moduleA, err), err)
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               candidates, "pkg", "pkg/alpha", sourceA, "", moduleA,
               declaration.SemanticSnapshotDeclarationKindFunction,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               "Alpha", proofA, tables.types.typeCids[0],
               layout.FixedBytes32(), 0, 9, functionA, err), err)
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               candidates, "pkg", "pkg/beta", sourceB, "", -1,
               declaration.SemanticSnapshotDeclarationKindModule,
               declaration.SemanticSnapshotDeclarationNameSurfaceModulePath,
               "pkg/beta", sourceB, sourceB, layout.FixedBytes32(),
               0, 0, moduleB, err), err)
    assert(declaration.SemanticSnapshotDeclarationCandidateAppendInto(
               candidates, "pkg", "pkg/beta", sourceB, "", moduleB,
               declaration.SemanticSnapshotDeclarationKindFunction,
               declaration.SemanticSnapshotDeclarationNameSurfaceIdentifier,
               "Beta", proofB, tables.types.typeCids[1],
               layout.FixedBytes32(), 10, 18, functionB, err), err)
    var mapping: declaration.SemanticSnapshotDeclarationMappingReceipt
    assert(declaration.SemanticSnapshotDeclarationTableSealInto(
               candidates, tables.declarations, mapping, err), err)
    tables.symbols.declIds = [
        mapping.producerCandidateToDeclIds[functionB],
        mapping.producerCandidateToDeclIds[moduleB],
        mapping.producerCandidateToDeclIds[functionA],
        mapping.producerCandidateToDeclIds[moduleA]]
    tables.symbols.declKeyCids = [
        tables.declarations.declKeyCids[tables.symbols.declIds[0]],
        tables.declarations.declKeyCids[tables.symbols.declIds[1]],
        tables.declarations.declKeyCids[tables.symbols.declIds[2]],
        tables.declarations.declKeyCids[tables.symbols.declIds[3]]]
    tables.symbols.symbolCids = tables.symbols.declKeyCids
    tables.symbols.interfaceCids = [
        TestCid("lsp-index/interface-beta"),
        TestCid("lsp-index/interface-module-beta"),
        TestCid("lsp-index/interface-alpha"),
        TestCid("lsp-index/interface-module-alpha")]
    tables.symbols.declarationHeaderCids = [
        TestCid("lsp-index/header-beta"),
        TestCid("lsp-index/header-module-beta"),
        TestCid("lsp-index/header-alpha"),
        TestCid("lsp-index/header-module-alpha")]
    tables.symbols.declarationPathCids = [
        TestCid("lsp-index/path-beta"),
        TestCid("lsp-index/path-module-beta"),
        TestCid("lsp-index/path-alpha"),
        TestCid("lsp-index/path-module-alpha")]
    tables.symbols.exportedFlags = [true, true, true, true]
    tables.symbols.genericConstraintStarts = [0, 0, 0, 0]
    tables.symbols.genericConstraintCounts = [0, 0, 0, 0]
    tables.references.sourceIds = [1, 0]
    tables.references.spanIds = [2, 0]
    tables.references.ownerFunctionIds = [0, 1]
    tables.references.ownerSymbolIds = [0, 2]
    tables.references.targetSymbolIds = [2, 0]
    tables.references.referenceKinds = [
        schema.CsgCompilerReferenceRead,
        schema.CsgCompilerReferenceRead]
    tables.references.bindingTypedNodeIds = [-1, -1]
    return tables

fn MakeExactIndex(
    tables: schema.CsgCompilerSnapshotTables,
    sourceVersion: int64,
    csgRootCid: layout.FixedBytes32): projection.SemanticSnapshotQueryIndex =
    var index: projection.SemanticSnapshotQueryIndex
    var err: str
    assert(projection.SemanticSnapshotQueryIndexBuildInto(
               tables, sourceVersion, csgRootCid, index, err), err)
    return index

fn AssertRejected(ok: bool, err: str, label: str) =
    assert(!ok && len(err) > 0,
           Fmt"lsp immutable query index: {label} attack accepted")

fn AssertI32Sequence(actual: int32[], expected: int32[], label: str) =
    assert(actual.len == expected.len, label)
    for index in 0..<actual.len:
        assert(actual[index] == expected[index], label)

fn AssertLargeProjection() =
    var err: str
    let workspaceSessionCid = TestCid("lsp-index/large-workspace")
    let csgRootCid = TestCid("lsp-index/large-csg-root")
    var identity: snapshot.PortableSemanticSnapshotIdentity
    assert(snapshot.PortableSemanticSnapshotIdentityMakeInto(
               TestCid("lsp-index/large-source-identity"),
               TestCid("lsp-index/large-world-head"),
               TestCid("lsp-index/large-compiler"),
               TestCid("lsp-index/large-source-bundle"),
               csgRootCid, identity, err), err)
    var tables: schema.CsgCompilerSnapshotTables
    var documents: projection.SemanticSnapshotSourceDocument[]
    let contentText = "fn Main(): int32 = 0\n"
    let contentCid = schema.CsgCompilerSourceContentCid(contentText)
    for row in 0..<LargeDocumentCount:
        let documentCid = SequentialCid(row + 1)
        add(tables.sources.documentCids, documentCid)
        add(tables.sources.contentCids, contentCid)
        var document: projection.SemanticSnapshotSourceDocument
        document.uri = Fmt"file:///large/{row}.cheng"
        document.documentCid = documentCid
        document.contentCid = contentCid
        document.text = share(contentText)
        document.clientVersion = int64(row)
        document.open = true
        add(documents, document)
    var eventState: snapshot.WorkspaceSourceEventState
    eventState.workspaceSessionCid = workspaceSessionCid
    eventState.nextSourceVersion = int64(LargeDocumentCount) + int64(1)
    eventState.lastAcceptedSourceVersion = int64(LargeDocumentCount)
    for eventRow in 0..<LargeDocumentCount:
        let documentRow = LargeDocumentCount - 1 - eventRow
        add(eventState.documentCids, SequentialCid(documentRow + 1))
        add(eventState.clientVersions, int64(documentRow))
        add(eventState.documentOpenStates, 1)
        add(eventState.documentLastEventSourceVersions,
            int64(eventRow) + int64(1))
        add(eventState.documentLastEventKinds,
            snapshot.SemanticSourceEventOpen)
    var binding: snapshot.LocalSourceVersionBinding
    assert(snapshot.LocalSourceVersionBindingMakeInto(
               eventState, identity, binding, err), err)
    var largeProjection: projection.SemanticSnapshotQueryProjection
    assert(projection.SemanticSnapshotQueryProjectionBuildInto(
               tables, binding, identity, documents,
               largeProjection, err), err)
    assert(largeProjection.documents.len == LargeDocumentCount &&
           largeProjection.queryIndex.referenceStartsBySource.len ==
               LargeDocumentCount &&
           largeProjection.queryIndex.symbolStartsBySource.len ==
               LargeDocumentCount,
           "lsp immutable query index: large projection row count drift")
    assert(projection.SemanticSnapshotQueryProjectionStrictValidateInto(
               largeProjection, tables, binding, identity, err), err)
    largeProjection.documents[LargeDocumentCount - 1].uri =
        largeProjection.documents[0].uri
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryProjectionStrictValidateInto(
            largeProjection, tables, binding, identity, err),
        err, "large duplicate URI")

fn main() =
    let sourceVersion = int64(17)
    let csgRootCid = TestCid("lsp-index/csg-root")
    var err: str
    var index: projection.SemanticSnapshotQueryIndex
    var tables = MakeExactTables()
    assert(projection.SemanticSnapshotQueryIndexBuildInto(
               tables, sourceVersion, csgRootCid, index, err), err)
    assert(index.sourceVersion == sourceVersion &&
           layout.FixedBytes32Equal(index.csgRootCid, csgRootCid) &&
           !layout.FixedBytes32Equal(index.rootCid, layout.FixedBytes32()) &&
           !layout.FixedBytes32Equal(index.indexCid, layout.FixedBytes32()),
           "lsp immutable query index: identity projection drift")
    AssertI32Sequence(
        index.referenceStartsBySource, [0, 1],
        "lsp immutable query index: reference starts drift")
    AssertI32Sequence(
        index.referenceCountsBySource, [1, 1],
        "lsp immutable query index: reference counts drift")
    AssertI32Sequence(
        index.referenceRowIdsBySource, [1, 0],
        "lsp immutable query index: reference rows drift")
    AssertI32Sequence(
        index.symbolStartsBySource, [0, 2],
        "lsp immutable query index: symbol starts drift")
    AssertI32Sequence(
        index.symbolCountsBySource, [2, 2],
        "lsp immutable query index: symbol counts drift")
    AssertI32Sequence(
        index.symbolRowIdsBySource, [2, 3, 0, 1],
        "lsp immutable query index: symbol rows drift")
    AssertI32Sequence(
        index.merkleLevelStarts, [0, 2],
        "lsp immutable query index: Merkle starts drift")
    AssertI32Sequence(
        index.merkleLevelCounts, [2, 1],
        "lsp immutable query index: Merkle counts drift")
    assert(index.sourceLeafCids.len == 2 &&
           index.merkleNodeCids.len == 3 &&
           layout.FixedBytes32Equal(
               index.sourceLeafCids[0], index.merkleNodeCids[0]) &&
           layout.FixedBytes32Equal(
               index.sourceLeafCids[1], index.merkleNodeCids[1]),
           "lsp immutable query index: Merkle leaf projection drift")
    AssertI32Sequence(
        index.symbolNameSpanIds, [2, -1, 0, -1],
        "lsp immutable query index: name spans drift")
    AssertI32Sequence(
        index.symbolNameTokenIds, [1, -1, 0, -1],
        "lsp immutable query index: name tokens drift")
    AssertI32Sequence(
        index.symbolDeclIds, tables.symbols.declIds,
        "lsp immutable query index: SymbolId/DeclId rows drift")
    assert(layout.FixedBytes32Equal(
               index.declarationTableCid,
               tables.declarations.tableCid) &&
           layout.FixedBytes32Equal(
               index.symbolDeclKeyCids[0],
               tables.symbols.declKeyCids[0]) &&
           layout.FixedBytes32Equal(
               index.symbolDeclKeyCids[3],
               tables.symbols.declKeyCids[3]) &&
           index.symbolDeclarationRowCids.len ==
               tables.symbols.symbolCids.len &&
           layout.FixedBytes32Equal(
               index.symbolDeclarationRowCids[0],
               projection.SemanticSnapshotQueryDeclarationRowCid(
                   tables.declarations, tables.symbols.declIds[0])) &&
           layout.FixedBytes32Equal(
               index.symbolDeclarationRowCids[3],
               projection.SemanticSnapshotQueryDeclarationRowCid(
                   tables.declarations, tables.symbols.declIds[3])),
           "lsp immutable query index: declaration authority drift")
    assert(projection.SemanticSnapshotQueryIndexStrictValidateInto(
               index, tables, sourceVersion, csgRootCid, err), err)
    assert(projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
               index, tables, sourceVersion, csgRootCid, 0,
               tables.sources.documentCids[0], index.rootCid, err), err)
    assert(projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
               index, tables, sourceVersion, csgRootCid, 1,
               tables.sources.documentCids[1], index.rootCid, err), err)

    var deletedRow = MakeExactIndex(tables, sourceVersion, csgRootCid)
    deletedRow.referenceCountsBySource[0] = 0
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            deletedRow, tables, sourceVersion, csgRootCid, 0,
            tables.sources.documentCids[0], index.rootCid, err),
        err, "current source deleted row")

    var countTampered = MakeExactIndex(tables, sourceVersion, csgRootCid)
    countTampered.symbolCountsBySource[0] = 1
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            countTampered, tables, sourceVersion, csgRootCid, 0,
            tables.sources.documentCids[0], index.rootCid, err),
        err, "current source count")

    var rowTampered = MakeExactIndex(tables, sourceVersion, csgRootCid)
    rowTampered.referenceRowIdsBySource[0] = 0
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            rowTampered, tables, sourceVersion, csgRootCid, 0,
            tables.sources.documentCids[0], index.rootCid, err),
        err, "current source row")

    var targetTables = MakeExactTables()
    var targetReferences = targetTables.references
    targetReferences.targetSymbolIds[1] = 2
    targetTables.references = targetReferences
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            index, targetTables, sourceVersion, csgRootCid, 0,
            targetTables.sources.documentCids[0], index.rootCid, err),
        err, "current source target")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        targetTables.declarations)

    var siblingTampered = index
    siblingTampered.merkleNodeCids[1] =
        TestCid("lsp-index/tampered-sibling")
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            siblingTampered, tables, sourceVersion, csgRootCid, 0,
            tables.sources.documentCids[0], index.rootCid, err),
        err, "current source sibling")

    var rootTampered = index
    rootTampered.rootCid = TestCid("lsp-index/tampered-root")
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            rootTampered, tables, sourceVersion, csgRootCid, 0,
            tables.sources.documentCids[0], index.rootCid, err),
        err, "current source root")

    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            index, tables, sourceVersion, csgRootCid, 0,
            tables.sources.documentCids[0],
            TestCid("lsp-index/tampered-validation-root"), err),
        err, "current source validation root")

    var localIndexCidTampered = index
    localIndexCidTampered.indexCid =
        TestCid("lsp-index/tampered-local-index-cid")
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexCurrentSourceStrictValidateInto(
            localIndexCidTampered, tables, sourceVersion, csgRootCid, 0,
            tables.sources.documentCids[0], index.rootCid, err),
        err, "current source index CID")

    var nameSpanTables = MakeExactTables()
    nameSpanTables.symbols.nameSpanIds[0] = 0
    var rejectedIndex: projection.SemanticSnapshotQueryIndex
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexBuildInto(
            nameSpanTables, sourceVersion, csgRootCid, rejectedIndex, err),
        err, "nameSpan")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        nameSpanTables.declarations)

    var sourceTables = MakeExactTables()
    sourceTables.symbols.sourceIds[0] = 0
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexBuildInto(
            sourceTables, sourceVersion, csgRootCid, rejectedIndex, err),
        err, "source")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        sourceTables.declarations)

    var tokenTables = MakeExactTables()
    tokenTables.tokens.valueTextIds[1] = 0
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexBuildInto(
            tokenTables, sourceVersion, csgRootCid, rejectedIndex, err),
        err, "token")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        tokenTables.declarations)

    var implicitModuleCoordinateTables = MakeExactTables()
    implicitModuleCoordinateTables.symbols.nameSpanIds[1] = 2
    implicitModuleCoordinateTables.symbols.nameTokenIds[1] = 1
    implicitModuleCoordinateTables.symbols.declarationSpanIds[1] = 3
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexBuildInto(
            implicitModuleCoordinateTables, sourceVersion, csgRootCid,
            rejectedIndex, err),
        err, "implicit module borrowed function coordinate")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        implicitModuleCoordinateTables.declarations)

    var moduleOwnerTables = MakeExactTables()
    moduleOwnerTables.symbols.ownerSymbolIds[1] = 0
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexBuildInto(
            moduleOwnerTables, sourceVersion, csgRootCid,
            rejectedIndex, err),
        err, "module owner")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        moduleOwnerTables.declarations)

    var functionOwnerTables = MakeExactTables()
    functionOwnerTables.symbols.ownerSymbolIds[0] = -1
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexBuildInto(
            functionOwnerTables, sourceVersion, csgRootCid,
            rejectedIndex, err),
        err, "function owner")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        functionOwnerTables.declarations)

    var symbolKindTables = MakeExactTables()
    symbolKindTables.symbols.symbolKinds[0] =
        schema.CsgCompilerSymbolType
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexBuildInto(
            symbolKindTables, sourceVersion, csgRootCid,
            rejectedIndex, err),
        err, "Symbol/declaration kind")
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        symbolKindTables.declarations)

    var cidTampered = index
    cidTampered.indexCid = TestCid("lsp-index/tampered-index-cid")
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexStrictValidateInto(
            cidTampered, tables, sourceVersion, csgRootCid, err),
        err, "CID")

    var declarationRowTampered = index
    declarationRowTampered.symbolDeclarationRowCids[0] =
        TestCid("lsp-index/tampered-declaration-row")
    err = ""
    AssertRejected(
        projection.SemanticSnapshotQueryIndexStrictValidateInto(
            declarationRowTampered, tables, sourceVersion, csgRootCid, err),
        err, "declaration row CID")

    AssertLargeProjection()
    declaration.SemanticSnapshotDeclarationTableReleaseInto(
        tables.declarations)
    os.WriteLine(os.Get_stdout(),
                 Fmt"lsp_immutable_query_index_smoke: ok large_documents={LargeDocumentCount}")
