import cheng/core/lang/parser
import cheng/core/lang/typed_expr as texpr

fn LineColumnExpr(sourcePath: str,
                  lineNumber: int32,
                  columnNumber: int32): parser.NormalizedExpr =
    var expr: parser.NormalizedExpr
    expr.sourcePath = sourcePath
    expr.lineNumber = lineNumber
    expr.columnNumber = columnNumber
    return expr

fn main(): int32 =
    var ctx: texpr.TypedExprSourceContext
    add(ctx.lines, "return outer(inner())")
    add(ctx.lines, "value")
    texpr.TypedExprPrepareSourceExprLineColumns(ctx)
    assert(ctx.exprLineColumnHeads.len == 2,
           "typed expr line-column SoA: head count")
    assert(ctx.exprLineColumnValues.len == 0 &&
           ctx.exprLineColumnNext.len == 0,
           "typed expr line-column SoA: initial flat columns")

    var layer: parser.NormalizedExprLayer
    add(layer.exprs, LineColumnExpr("line-column-smoke", 1, 8))
    add(layer.exprs, LineColumnExpr("line-column-smoke", 1, 14))
    add(layer.exprs, LineColumnExpr("line-column-smoke", 1, 14))
    add(layer.exprs, LineColumnExpr("line-column-smoke", 2, 3))
    var err = ""
    assert(texpr.TypedExprPopulateSourceExprLineColumnsForRange(ctx,
                                                                layer,
                                                                0,
                                                                layer.exprs.len,
                                                                err),
           Fmt"typed expr line-column SoA: populate failed {err}")
    assert(ctx.exprLineColumnValues.len == 3 &&
           ctx.exprLineColumnNext.len == 3,
           "typed expr line-column SoA: duplicate column was retained")
    assert(texpr.TypedExprFirstExprColumnAfter(ctx, 1, 0) == 8,
           "typed expr line-column SoA: first column")
    assert(texpr.TypedExprFirstExprColumnAfter(ctx, 1, 9) == 14,
           "typed expr line-column SoA: threshold column")
    assert(texpr.TypedExprFirstExprColumnAfter(ctx, 1, 15) == -1,
           "typed expr line-column SoA: missing threshold column")
    assert(texpr.TypedExprFirstExprColumnAfter(ctx, 2, 0) == 3,
           "typed expr line-column SoA: second line")

    texpr.TypedExprClearSourceExprLineColumnsForRange(ctx,
                                                      layer,
                                                      0,
                                                      layer.exprs.len)
    assert(ctx.exprLineColumnHeads[0] == -1 &&
           ctx.exprLineColumnHeads[1] == -1,
           "typed expr line-column SoA: touched heads not reset")
    assert(ctx.exprLineColumnValues.len == 0 &&
           ctx.exprLineColumnNext.len == 0,
           "typed expr line-column SoA: flat scratch not reset")

    err = ""
    assert(texpr.TypedExprPopulateSourceExprLineColumnsForRange(ctx,
                                                                layer,
                                                                0,
                                                                layer.exprs.len,
                                                                err),
           Fmt"typed expr line-column SoA: repopulate failed {err}")
    assert(texpr.TypedExprFirstExprColumnAfter(ctx, 1, 9) == 14,
           "typed expr line-column SoA: reset changed semantics")
    return 0
