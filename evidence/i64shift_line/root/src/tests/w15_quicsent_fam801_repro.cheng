# wave15-quicsent-fam801 repro: msquicConnImplSentPacketAtStore(801 failCode=3)
# — `return root.arrayField[callExpr]` (whole aggregate array element as the
# return value, index is itself a function call). Mirrors the real target
# exactly:
#   fn msquicConnImplSentPacketAtStore(slot: int32, idx: int32): MsQuicSentPacket =
#       return msquicConnImplStore.sentPacketStore[msquicConnImplSentStoreIdx(slot, idx)]
#
# Pre-patch: AppendAggregateConstructorToSlot only recognizes `Type(...)` /
# `Type{...}` constructor syntax; an index-read expression matches neither
# (no top-level call-paren, no top-level brace) and fails with failCode=3,
# surfacing as bail=801 detail1=-253 ((-1<<8)|3) — ZC_NOT_READY, plan not
# ready. Fixed by PrimaryBodyIrAppendReturnFieldArrayIndexedElemValue, a new
# narrow branch tried before AppendReturnAggregateConstructor in the
# return-statement dispatch (primary_object_plan.cheng).
#
# NOTE (separate, pre-existing, OUT OF SCOPE defect): `arrayField[idx] = v`
# (whole-aggregate value assigned to an array-indexed field, no `.subField`
# suffix) is a SILENT miscompile independent of this patch — confirmed by an
# isolated repro (gStore.recStore[0] = r0; read back garbage, no bail at
# all). This fixture therefore populates gStore through the already-correct
# PER-FIELD write path (`arrayField[idx].subField = v`) to decouple the
# verified read-side fix from that unrelated write-side defect.
import std/rawbytes
import std/os
import std/strings

const
    slotCount = 2
    perSlot = 4
    storeCapacity = slotCount * perSlot

type
    Rec =
        active: int32
        number: int64
        payload: rawbytes.Bytes
        length: int32

    Store =
        recStore: Rec[storeCapacity]

var
    gStore: Store

fn storeIdx(slot: int32, idx: int32): int32 =
    return slot * perSlot + idx

# The shape under test: whole-aggregate return of an array-of-aggregate field
# element, indexed by a call expression.
fn recAtStore(slot: int32, idx: int32): Rec =
    return gStore.recStore[storeIdx(slot, idx)]

fn setPayloadAt(idx: int32, b: rawbytes.Bytes) =
    gStore.recStore[idx].payload = b

fn main(): int32 =
    var p1: rawbytes.Bytes = rawbytes.BytesAlloc(5)
    rawbytes.BytesSet(p1, 0, 1)
    rawbytes.BytesSet(p1, 1, 2)
    rawbytes.BytesSet(p1, 2, 3)
    rawbytes.BytesSet(p1, 3, 4)
    rawbytes.BytesSet(p1, 4, 5)

    gStore.recStore[0].active = 0
    gStore.recStore[0].number = 0
    gStore.recStore[0].length = 0

    gStore.recStore[1].active = 11
    gStore.recStore[1].number = 111
    gStore.recStore[1].length = 22
    setPayloadAt(1, p1)

    gStore.recStore[4].active = 33
    gStore.recStore[4].number = 333
    gStore.recStore[4].length = 44

    let got0 = recAtStore(0, 0)
    let got1 = recAtStore(0, 1)
    let got2 = recAtStore(1, 0)

    if got0.active != 0 || got0.number != 0 || got0.length != 0:
        os.WriteLine(os.GetStderr(), "FAIL got0")
        return 1
    if got1.active != 11 || got1.number != 111 || got1.length != 22:
        os.WriteLine(os.GetStderr(), "FAIL got1_scalar")
        return 2
    if rawbytes.BytesLen(got1.payload) != 5:
        os.WriteLine(os.GetStderr(), "FAIL got1_payload_len")
        return 3
    if rawbytes.BytesGet(got1.payload, 0) != 1 || rawbytes.BytesGet(got1.payload, 4) != 5:
        os.WriteLine(os.GetStderr(), "FAIL got1_payload_bytes")
        return 4
    if got2.active != 33 || got2.number != 333 || got2.length != 44:
        os.WriteLine(os.GetStderr(), "FAIL got2")
        return 5
    os.WriteLine(os.GetStdout(), "OK")
    return 0
