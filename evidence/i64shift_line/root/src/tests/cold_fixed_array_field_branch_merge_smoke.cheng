import std/os
import cheng/std/bytes_layout as layout

fn branchByte(chooseFirst: bool): int32 =
    var value: layout.FixedBytes32
    if chooseFirst:
        value.data[0] = uint8(17)
    else:
        value.data[0] = uint8(29)
    return Int32(value.data[0])

fn loopByte(): int32 =
    var value: layout.FixedBytes32
    for index in 0..<32:
        value.data[index] = uint8(index)
    return Int32(value.data[31])

fn main() =
    assert(branchByte(true) == 17,
           "fixed-array first branch lost its value")
    assert(branchByte(false) == 29,
           "fixed-array second branch lost its value")
    assert(loopByte() == 31,
           "fixed-array loop-carried version lost its value")
    os.WriteLine(
        os.Get_stdout(),
        "cold_fixed_array_field_branch_merge_smoke: ok")
