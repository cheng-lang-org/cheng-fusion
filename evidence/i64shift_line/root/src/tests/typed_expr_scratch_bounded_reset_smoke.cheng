import std/system
import std/hashmaps
import std/hashsets
import std/cmdline
import std/os
import std/strutils as strutil
import std/os_host_process as hostos
import cheng/core/lang/intern as langintern
import cheng/core/lang/typed_expr as texpr

@importc("cheng_mm_alloc_count")
fn ownerMmAllocCount(): int64

@importc("cheng_mm_free_count")
fn ownerMmFreeCount(): int64

@importc("cheng_mm_live_count")
fn ownerMmLiveCount(): int64

@importc("cheng_mm_foreign_free_count")
fn ownerMmForeignFreeCount(): int64

type
    HardFailReceipt =
        provider: str
        caseName: str
        failureKind: str
        exitCode: int32
        signalCode: int32
        output: str

    RuntimeOwnerCounters =
        allocationCount: int64
        freeCount: int64
        liveCount: int64
        foreignFreeCount: int64

fn ReadRuntimeOwnerCounters(): RuntimeOwnerCounters =
    var out: RuntimeOwnerCounters
    out.allocationCount = ownerMmAllocCount()
    out.freeCount = ownerMmFreeCount()
    out.liveCount = ownerMmLiveCount()
    out.foreignFreeCount = ownerMmForeignFreeCount()
    return out

fn AssertMapStorageCleared(m: hashmaps.HashMapStrInt,
                           context: str) =
    assert(m.used == 0, context)
    assert(m.cacheKeyPtr0 == nil && m.cacheKeyLen0 == 0 &&
           m.cachePack0 == uint64(0) && m.cacheSlot0 == -1 &&
           m.cacheVal0 == 0 && m.cacheKeyPtr1 == nil &&
           m.cacheKeyLen1 == 0 && m.cachePack1 == uint64(0) &&
           m.cacheSlot1 == -1 && m.cacheVal1 == 0,
           context)
    for slot in 0..<m.keys.len:
        assert(m.keys[slot] == "" && m.vals[slot] == 0 &&
               m.hashes[slot] == uint64(0) &&
               m.states[slot] == uint8(0),
               context)
    for stateIndex in m.keys.len..<m.states.len:
        assert(m.states[stateIndex] == uint8(0), context)

fn AssertInternIndexStorageCleared(pool: langintern.InternPool,
                                   context: str) =
    assert(pool.indexUsed == 0, context)
    for slot in 0..<pool.indexVals.len:
        assert(pool.indexVals[slot] == 0 &&
               pool.indexStates[slot] == 0 &&
               pool.indexOccupied[slot] == 0,
               context)

fn AssertMapRetainedLedger(m: hashmaps.HashMapStrInt,
                            context: str) =
    let report = hashmaps.HashMapStrIntRetainedBytes(m)
    let sequenceHeaders = Int64(4) * Int64(16)
    let inlineFields = Int64(80)
    let keyBytes = Int64(m.keys.cap) * Int64(24)
    let valueBytes = Int64(m.vals.cap) * Int64(4)
    let hashBytes = Int64(m.hashes.cap) * Int64(8)
    let stateBytes = Int64(m.states.cap)
    assert(report.sequenceHeaderBytes == sequenceHeaders &&
           report.inlineFieldBytes == inlineFields &&
           report.keySlotBytes == keyBytes &&
           report.valueSlotBytes == valueBytes &&
           report.hashSlotBytes == hashBytes &&
           report.stateAndOccupiedSlotBytes == stateBytes &&
           report.totalBytes == sequenceHeaders + inlineFields +
                                keyBytes + valueBytes +
                                hashBytes + stateBytes,
           context)

fn AssertInternRetainedLedger(pool: var langintern.InternPool,
                               context: str) =
    let report = langintern.InternPoolRetainedBytes(pool)
    let indexColumnBytes = Int64(3) * Int64(16) +
                           Int64(pool.indexVals.cap) * Int64(4) +
                           Int64(pool.indexStates.cap) * Int64(4) +
                           Int64(pool.indexOccupied.cap) * Int64(4)
    assert(report.textSequenceHeaderBytes == Int64(16) &&
           report.poolInlineFieldBytes == Int64(168) &&
           report.textSlotBytes == Int64(pool.texts.cap) * Int64(24) &&
           report.indexBytes == indexColumnBytes &&
           report.structuredBytes == Int64(16) + Int64(168) +
                                       Int64(pool.texts.cap) * Int64(24) +
                                       indexColumnBytes &&
           report.logicalPayloadBytes ==
               langintern.InternPoolLogicalPayloadBytes(pool),
           context)

fn MapOccupiedClearContract() =
    var m = hashmaps.HashMapStrIntInit(8)
    let largeCount: int32 = 4096
    for i in 0..<largeCount:
        hashmaps.HashMapStrIntPut(m, Fmt"map-key-{i}", i + 1)
    let largeCapacity = m.keys.len
    assert(largeCapacity > largeCount &&
           m.states.len == largeCapacity * 5,
           "hashmap clear: grown structural storage")
    for i in 0..<largeCount:
        var found: bool
        assert(hashmaps.HashMapStrIntGetMutEx(m, Fmt"map-key-{i}", found) ==
                   i + 1 && found,
               "hashmap clear: grow preserved value")
    assert(m.cacheSlot0 >= 0 || m.cacheSlot1 >= 0,
           "hashmap clear: fixture populated lookup cache")
    let usedBeforeUpdate = m.used
    let updateIndex = largeCount / 2
    hashmaps.HashMapStrIntPut(m, Fmt"map-key-{updateIndex}", 99001)
    assert(m.used == usedBeforeUpdate,
           "hashmap clear: update does not duplicate occupied slot")
    AssertMapRetainedLedger(m, "hashmap clear: large retained ledger")

    var largeClear: hashmaps.HashMapStrIntClearProbe
    hashmaps.HashMapStrIntClearWithProbe(m, largeClear)
    assert(largeClear.occupiedTailReadCount == Int64(largeCount) &&
           largeClear.bucketReadCount == Int64(largeCount) &&
           largeClear.occupiedSlotVisitCount == Int64(largeCount),
           "hashmap clear: large visit count equals used")
    AssertMapStorageCleared(m, "hashmap clear: large old owners removed")

    let smallCount: int32 = 8
    for round in 0..<32:
        for i in 0..<smallCount:
            hashmaps.HashMapStrIntPut(m, Fmt"small-{round}-{i}", i + 11)
        assert(m.keys.len == largeCapacity,
               "hashmap clear: direct map retains capacity")
        var smallClear: hashmaps.HashMapStrIntClearProbe
        hashmaps.HashMapStrIntClearWithProbe(m, smallClear)
        assert(smallClear.occupiedTailReadCount == Int64(smallCount) &&
               smallClear.bucketReadCount == Int64(smallCount) &&
               smallClear.occupiedSlotVisitCount == Int64(smallCount),
               "hashmap clear: small visit count independent of capacity")
        AssertMapStorageCleared(m,
                                "hashmap clear: small old owners removed")

    var inserted: bool
    let first = hashmaps.HashMapStrIntGetOrInsertEx(m, "inserted", 77,
                                                    inserted)
    assert(first == 77 && !inserted,
           "hashmap clear: get-or-insert records occupied slot")
    let second = hashmaps.HashMapStrIntGetOrInsertEx(m, "inserted", 88,
                                                     inserted)
    assert(second == 77 && inserted,
           "hashmap clear: get-or-insert preserves existing value")
    var insertClear: hashmaps.HashMapStrIntClearProbe
    hashmaps.HashMapStrIntClearWithProbe(m, insertClear)
    assert(insertClear.occupiedTailReadCount == Int64(1) &&
           insertClear.bucketReadCount == Int64(1) &&
           insertClear.occupiedSlotVisitCount == Int64(1),
           "hashmap clear: get-or-insert clear visit")
    AssertMapRetainedLedger(m, "hashmap clear: final retained ledger")

fn MapOccupiedGrowContract() =
    let largeCapacity: int32 = 65536
    let smallUsed: int32 = 8
    var m = hashmaps.HashMapStrIntInit(largeCapacity)
    for i in 0..<smallUsed:
        hashmaps.HashMapStrIntPut(m, Fmt"grow-small-{i}", i + 100)
    assert(m.keys.len == largeCapacity && m.used == smallUsed,
           "hashmap grow: large-capacity small-used fixture")
    var probe: hashmaps.HashMapStrIntGrowProbe
    hashmaps.HashMapStrIntGrowWithProbe(m, probe)
    assert(probe.sourceCapacity == largeCapacity &&
           probe.destinationCapacity == largeCapacity * 2 &&
           probe.sourceUsed == smallUsed &&
           probe.occupiedTailReadCount == Int64(smallUsed) &&
           probe.sourceBucketReadCount == Int64(smallUsed) &&
           probe.rehashedEntryCount == Int64(smallUsed),
           "hashmap grow: actual source reads are exactly O(used)")
    for i in 0..<smallUsed:
        var found: bool
        assert(hashmaps.HashMapStrIntGetMutEx(m, Fmt"grow-small-{i}", found) ==
                   i + 100 && found,
               "hashmap grow: rehash preserves entries")
    hashmaps.HashMapStrIntClear(m)

fn WriteOccupiedSlot(m: var hashmaps.HashMapStrInt,
                     occupiedIndex: int32,
                     slot: int32) =
    let offset = m.keys.len + occupiedIndex * 4
    let value = uint32(slot)
    m.states[offset] = uint8(value & uint32(255))
    m.states[offset + 1] = uint8((value >> uint32(8)) & uint32(255))
    m.states[offset + 2] = uint8((value >> uint32(16)) & uint32(255))
    m.states[offset + 3] = uint8((value >> uint32(24)) & uint32(255))

fn HashCollisionFullKeyContract() =
    var m = hashmaps.HashMapStrIntInit(8)
    let right = "collision-right"
    let left = "collision-leftx"
    assert(left.len == right.len && left != right,
           "hash collision: equal-length distinct fixture")
    let forcedHash = hashmaps.HashMapHash64Str(right)
    let firstSlot = int32(forcedHash & m.mask)
    let secondSlot = (firstSlot + 1) & int32(m.mask)
    m.keys[firstSlot] = left
    m.vals[firstSlot] = 11
    m.hashes[firstSlot] = forcedHash
    m.states[firstSlot] = uint8(1)
    m.keys[secondSlot] = right
    m.vals[secondSlot] = 22
    m.hashes[secondSlot] = forcedHash
    m.states[secondSlot] = uint8(1)
    WriteOccupiedSlot(m, 0, firstSlot)
    WriteOccupiedSlot(m, 1, secondSlot)
    m.used = 2
    var found: bool
    assert(hashmaps.HashMapStrIntGetMutEx(m, right, found) == 22 && found,
           "hash collision: full key comparison reaches second key")
    hashmaps.HashMapStrIntClear(m)

fn HashSetWholeMapMoveContract() =
    var values = hashsets.HashSetStrInit(8)
    assert(values.map.keys.len == values.map.hashes.len &&
           values.map.states.len == values.map.keys.len * 5,
           "hashset init: complete map storage moved")
    hashsets.HashSetStrAdd(values, "whole-map")
    assert(hashsets.HashSetStrHas(values, "whole-map"),
           "hashset init: moved hash column supports lookup")
    hashsets.HashSetStrClear(values)
    AssertMapStorageCleared(values.map,
                            "hashset init: moved map clears completely")

fn EmitHardFailChildMarker(caseName: str) =
    let stderrFile = os.Get_stderr()
    os.WriteLine(stderrFile,
                 Fmt"hard_fail_provider=std/os_host_process.ExecFileCapture case={caseName}")
    let _flushResult = os.C_fflush(stderrFile)

fn OccupiedTailDuplicateHardFailChild(): int32 =
    EmitHardFailChildMarker("occupied-duplicate")
    var m = hashmaps.HashMapStrIntInit(8)
    hashmaps.HashMapStrIntPut(m, "duplicate", 1)
    let slot = hashmaps.HashMapStrIntFindSlot(m, "duplicate", false)
    WriteOccupiedSlot(m, 1, slot)
    m.used = 2
    hashmaps.HashMapStrIntClear(m)
    return 3

fn OccupiedTailCorruptHardFailChild(): int32 =
    EmitHardFailChildMarker("occupied-corrupt")
    var m = hashmaps.HashMapStrIntInit(8)
    hashmaps.HashMapStrIntPut(m, "corrupt", 1)
    WriteOccupiedSlot(m, 0, m.keys.len)
    hashmaps.HashMapStrIntClear(m)
    return 3

fn OccupiedTailStorageHardFailChild(): int32 =
    EmitHardFailChildMarker("occupied-short")
    var m = hashmaps.HashMapStrIntInit(8)
    hashmaps.HashMapStrIntPut(m, "short-tail", 1)
    setLen(m.states, m.states.len - 1)
    hashmaps.HashMapStrIntClear(m)
    return 3

fn InternUseAfterReleaseHardFailChild(): int32 =
    EmitHardFailChildMarker("intern-uaf")
    var pool = langintern.InternPoolNew()
    langintern.Intern(pool, "owned-before-release")
    langintern.InternPoolRelease(pool)
    langintern.Intern(pool, "must-not-revive")
    return 3

fn ClassifyHardFail(caseName: str,
                    exitCode: int32,
                    output: str): HardFailReceipt =
    var out: HardFailReceipt
    out.provider = "std/os_host_process.ExecFileCapture"
    out.caseName = caseName
    out.exitCode = exitCode
    out.output = output
    if exitCode == 0:
        out.failureKind = "normal_return"
    elif exitCode >= 128 && exitCode <= 255:
        out.failureKind = "signal"
        out.signalCode = exitCode - 128
    elif exitCode > 0:
        out.failureKind = "deterministic_nonzero"
    else:
        out.failureKind = "provider_error"
    return out

fn RequireHardFail(mode: str, messagePart: str) =
    let selfPath = cmdline.ParamStr(0)
    let result = hostos.ExecFileCapture(selfPath, [mode], [], "", true, 60)
    let receipt = ClassifyHardFail(mode,
                                   os.ExecCmdResultExitCode(result),
                                   os.ExecCmdResultOutput(result))
    assert(receipt.provider == "std/os_host_process.ExecFileCapture" &&
           strutil.Contains(receipt.output,
                            Fmt"hard_fail_provider={receipt.provider}") &&
           strutil.Contains(receipt.output, Fmt"case={mode}"),
           "hard fail: provider/case receipt missing")
    assert(receipt.failureKind != "normal_return" &&
           receipt.failureKind != "provider_error",
           "hard fail: child did not fail deterministically")
    assert(strutil.Contains(receipt.output, messagePart),
           "hard fail: deterministic failure reason mismatch")
    if receipt.failureKind == "signal":
        assert(receipt.failureKind == "signal" && receipt.signalCode > 0,
               "hard fail: signal classification mismatch")
    echo(Fmt"hard_fail_provider={receipt.provider} case={receipt.caseName} kind={receipt.failureKind} exit_code={receipt.exitCode} signal={receipt.signalCode}")

fn OccupiedTailHardFailContract() =
    RequireHardFail("occupied-duplicate", "occupied slot state mismatch")
    RequireHardFail("occupied-corrupt", "occupied slot corrupt")
    RequireHardFail("occupied-short", "clear storage invariant failed")
    RequireHardFail("intern-uaf", "intern: pool already released")

fn AssertInternReleased(pool: langintern.InternPool,
                        context: str) =
    assert(pool.indexVals.len == 0 && pool.indexVals.cap == 0 &&
           pool.indexStates.len == 0 && pool.indexStates.cap == 0 &&
           pool.indexOccupied.len == 0 && pool.indexOccupied.cap == 0 &&
           pool.indexMask == uint64(0) && pool.indexUsed == 0 &&
           pool.texts.len == 0 && pool.texts.cap == 0 &&
           pool.emptyId == langintern.InvalidInternId() &&
           langintern.InternPoolLogicalPayloadBytes(pool) == Int64(0),
           context)

fn AssertFourLiveOwnerIds(receipt: langintern.InternPoolOwnerReceipt,
                          context: str) =
    assert(receipt.lifecycleState == langintern.InternPoolOwnerActive &&
           receipt.liveCount == Int64(4) &&
           receipt.allocationCount - receipt.freeCount == Int64(4) &&
           receipt.nextAllocationId == receipt.allocationCount + Int64(1),
           context)
    let textId = receipt.textsAllocationId
    let valsId = receipt.indexValsAllocationId
    let hashesId = receipt.indexOccupiedAllocationId
    let statesId = receipt.indexStatesAllocationId
    assert(textId > Int64(0) &&
           valsId > Int64(0) && hashesId > Int64(0) &&
           statesId > Int64(0) &&
           textId != valsId &&
           textId != hashesId && textId != statesId &&
           valsId != hashesId &&
           valsId != statesId && hashesId != statesId,
           context)

fn AssertOwnerTerminalRelease(
        before: langintern.InternPoolOwnerReceipt,
        after: langintern.InternPoolOwnerReceipt,
        context: str) =
    AssertFourLiveOwnerIds(before, context)
    assert(after.lifecycleState == langintern.InternPoolOwnerReleased &&
           after.allocationCount == before.allocationCount &&
           after.freeCount == before.freeCount + before.liveCount &&
           after.freeCount == after.allocationCount &&
           after.liveCount == Int64(0) &&
           after.nextAllocationId == before.nextAllocationId &&
           after.textsAllocationId == Int64(0) &&
           after.indexValsAllocationId == Int64(0) &&
           after.indexOccupiedAllocationId == Int64(0) &&
           after.indexStatesAllocationId == Int64(0) &&
           after.textsLastFreedAllocationId == before.textsAllocationId &&
           after.indexValsLastFreedAllocationId ==
               before.indexValsAllocationId &&
           after.indexOccupiedLastFreedAllocationId ==
               before.indexOccupiedAllocationId &&
           after.indexStatesLastFreedAllocationId ==
               before.indexStatesAllocationId,
           context)

fn AssertOwnerReceiptEqual(left: langintern.InternPoolOwnerReceipt,
                           right: langintern.InternPoolOwnerReceipt,
                           context: str) =
    assert(left.lifecycleState == right.lifecycleState &&
           left.nextAllocationId == right.nextAllocationId &&
           left.allocationCount == right.allocationCount &&
           left.freeCount == right.freeCount &&
           left.liveCount == right.liveCount &&
           left.textsAllocationId == right.textsAllocationId &&
           left.textsLastFreedAllocationId ==
               right.textsLastFreedAllocationId &&
           left.indexValsAllocationId == right.indexValsAllocationId &&
           left.indexValsLastFreedAllocationId ==
               right.indexValsLastFreedAllocationId &&
           left.indexOccupiedAllocationId ==
               right.indexOccupiedAllocationId &&
           left.indexOccupiedLastFreedAllocationId ==
               right.indexOccupiedLastFreedAllocationId &&
           left.indexStatesAllocationId ==
               right.indexStatesAllocationId &&
           left.indexStatesLastFreedAllocationId ==
               right.indexStatesLastFreedAllocationId,
           context)

fn AssertRuntimePhysicalRelease(before: RuntimeOwnerCounters,
                                after: RuntimeOwnerCounters,
                                expectedOwnerFrees: int64,
                                context: str) =
    assert(expectedOwnerFrees > Int64(0) &&
           after.allocationCount == before.allocationCount &&
           after.freeCount - before.freeCount >= expectedOwnerFrees &&
           before.liveCount - after.liveCount >= expectedOwnerFrees &&
           after.foreignFreeCount == before.foreignFreeCount,
           context)

fn InternCapacityBoundaryContract(entryCount: int32,
                                  expectedTextCapacityLimit: int32) =
    var pool = langintern.InternPoolNew()
    for i in 0..<entryCount:
        langintern.Intern(pool, Fmt"boundary-{entryCount}-{i}")
    var probe: langintern.InternPoolResetProbe
    langintern.InternPoolResetBoundedWithProbe(pool, entryCount, probe)
    assert(probe.indexOccupiedTailReadCount == Int64(entryCount) &&
           probe.indexBucketReadCount == Int64(entryCount) &&
           probe.indexOccupiedSlotVisitCount == Int64(entryCount) &&
           probe.textSlotVisitCount == Int64(entryCount) &&
           probe.retainedTextCapacityLimit == expectedTextCapacityLimit &&
           probe.indexStateCapacityAfter <=
               probe.retainedIndexStateCapacityLimit &&
           probe.indexRetainedBytesAfter <= probe.retainedIndexByteLimit,
           "intern reset: 64/65 capacity boundary")
    langintern.Intern(pool, "release-owner")
    let beforeRelease = langintern.InternPoolOwnerReceiptRead(pool)
    langintern.InternPoolRelease(pool)
    let afterRelease = langintern.InternPoolOwnerReceiptRead(pool)
    AssertOwnerTerminalRelease(beforeRelease,
                               afterRelease,
                               "intern reset: boundary terminal owner release")
    langintern.InternPoolRelease(pool)
    let afterSecondRelease = langintern.InternPoolOwnerReceiptRead(pool)
    AssertOwnerReceiptEqual(afterRelease,
                            afterSecondRelease,
                            "intern reset: boundary second release is no-op")
    AssertInternReleased(pool,
                         "intern reset: boundary double release is empty")

fn InternStateCapacityGateContract(retainedEntryLimit: int32) =
    var pool = langintern.InternPoolNew()
    for i in 0..<8:
        langintern.Intern(pool, Fmt"state-cap-{i}")
    reserve(pool.indexStates, 65536)
    let keyCapacityBefore = pool.indexVals.len
    var probe: langintern.InternPoolResetProbe
    langintern.InternPoolResetBoundedWithProbe(pool,
                                               retainedEntryLimit,
                                               probe)
    assert(keyCapacityBefore <= probe.retainedIndexCapacityLimit &&
           probe.indexStateCapacityBefore >
               probe.retainedIndexStateCapacityLimit &&
           probe.indexRetainedBytesBefore > probe.retainedIndexByteLimit &&
           probe.indexRebuilt &&
           probe.indexStateCapacityAfter <=
               probe.retainedIndexStateCapacityLimit &&
           probe.indexRetainedBytesAfter <= probe.retainedIndexByteLimit,
           "intern reset: states cap and total bytes trigger rebuild")
    langintern.InternPoolRelease(pool)

fn InternBoundedRetentionContract() =
    var pool = langintern.InternPoolNew()
    let largeCount: int32 = 4096
    for i in 0..<largeCount:
        assert(langintern.Intern(pool, Fmt"intern-key-{i}") == i,
               "intern reset: deterministic large id")
    let largeIndexCapacity = pool.indexVals.len
    let largeTextCapacity = pool.texts.cap
    AssertInternRetainedLedger(pool, "intern reset: large retained ledger")

    let retainedEntryLimit =
        texpr.TypedExprFactTableScratchRetainedInternEntryLimit()
    assert(retainedEntryLimit == 512,
           "intern reset: structural retained entry limit")
    assert(hashmaps.HashMapStrIntStateCapacityForBucketCapacity(1024) ==
               8192 &&
           hashmaps.HashMapStrIntRetainedByteLimitForBucketCapacity(1024) ==
               Int64(45200),
           "intern reset: arm64 retained-byte ABI contract")
    var cloned = langintern.InternPoolClone(pool)
    assert(langintern.InternPoolCount(cloned) == largeCount &&
           langintern.FindInternId(cloned, "intern-key-4095") ==
               largeCount - 1,
           "intern reset: clone rebuilt occupied index")
    var cloneReset: langintern.InternPoolResetProbe
    langintern.InternPoolResetBoundedWithProbe(cloned,
                                               retainedEntryLimit,
                                               cloneReset)
    assert(cloneReset.indexOccupiedTailReadCount == Int64(largeCount) &&
           cloneReset.indexBucketReadCount == Int64(largeCount) &&
           cloneReset.indexOccupiedSlotVisitCount == Int64(largeCount) &&
           cloneReset.textSlotVisitCount == Int64(largeCount),
           "intern reset: cloned index clears every occupied slot")
    langintern.InternPoolRelease(cloned)

    let ownersBeforeLargeReset =
        langintern.InternPoolOwnerReceiptRead(pool)
    AssertFourLiveOwnerIds(ownersBeforeLargeReset,
                           "intern reset: four live owners before rebuild")
    var largeReset: langintern.InternPoolResetProbe
    langintern.InternPoolResetBoundedWithProbe(pool,
                                               retainedEntryLimit,
                                               largeReset)
    assert(largeReset.indexOccupiedTailReadCount == Int64(largeCount) &&
           largeReset.indexBucketReadCount == Int64(largeCount) &&
           largeReset.indexOccupiedSlotVisitCount == Int64(largeCount) &&
           largeReset.textSlotVisitCount == Int64(largeCount) &&
           largeReset.retainedIndexCapacityLimit == 1024 &&
           largeReset.retainedIndexStateCapacityLimit == 8192 &&
           largeReset.retainedTextCapacityLimit == 512 &&
           largeReset.indexCapacityBefore == largeIndexCapacity &&
           largeReset.textCapacityBefore == largeTextCapacity &&
           largeReset.indexRebuilt && largeReset.textStorageReleased &&
           largeReset.indexCapacityAfter <=
               largeReset.retainedIndexCapacityLimit &&
           largeReset.indexStateCapacityAfter <=
               largeReset.retainedIndexStateCapacityLimit &&
           largeReset.indexRetainedBytesAfter <=
               largeReset.retainedIndexByteLimit &&
           largeReset.textCapacityAfter <=
               largeReset.retainedTextCapacityLimit,
           "intern reset: 4096 bounded release contract")
    let ownersAfterLargeReset =
        langintern.InternPoolOwnerReceiptRead(pool)
    assert(ownersAfterLargeReset.lifecycleState ==
               langintern.InternPoolOwnerActive &&
           ownersAfterLargeReset.freeCount ==
               ownersBeforeLargeReset.freeCount + Int64(4) &&
           ownersAfterLargeReset.allocationCount ==
               ownersBeforeLargeReset.allocationCount + Int64(3) &&
           ownersAfterLargeReset.liveCount == Int64(3) &&
           ownersAfterLargeReset.textsAllocationId == Int64(0) &&
           ownersAfterLargeReset.textsLastFreedAllocationId ==
               ownersBeforeLargeReset.textsAllocationId &&
           ownersAfterLargeReset.indexValsLastFreedAllocationId ==
               ownersBeforeLargeReset.indexValsAllocationId &&
           ownersAfterLargeReset.indexOccupiedLastFreedAllocationId ==
               ownersBeforeLargeReset.indexOccupiedAllocationId &&
           ownersAfterLargeReset.indexStatesLastFreedAllocationId ==
               ownersBeforeLargeReset.indexStatesAllocationId &&
           ownersAfterLargeReset.indexValsAllocationId > Int64(0) &&
           ownersAfterLargeReset.indexOccupiedAllocationId > Int64(0) &&
           ownersAfterLargeReset.indexStatesAllocationId > Int64(0),
           "intern reset: old physical owners freed and index owners replaced")
    assert(langintern.InternPoolCount(pool) == 0 &&
           langintern.InternPoolLogicalPayloadBytes(pool) == Int64(0) &&
           langintern.FindInternId(pool, "intern-key-0") ==
               langintern.InvalidInternId(),
           "intern reset: old key invisible")
    AssertInternIndexStorageCleared(pool,
                                    "intern reset: old index owners removed")

    let smallCount: int32 = 8
    for i in 0..<smallCount:
        assert(langintern.Intern(pool, Fmt"fresh-{i}") == i,
               "intern reset: ids restart at zero")
    var smallReset: langintern.InternPoolResetProbe
    langintern.InternPoolResetBoundedWithProbe(pool,
                                               retainedEntryLimit,
                                               smallReset)
    assert(smallReset.indexOccupiedTailReadCount == Int64(smallCount) &&
           smallReset.indexBucketReadCount == Int64(smallCount) &&
           smallReset.indexOccupiedSlotVisitCount == Int64(smallCount) &&
           smallReset.textSlotVisitCount == Int64(smallCount) &&
           !smallReset.indexRebuilt && !smallReset.textStorageReleased,
           "intern reset: 8-entry reset visits current used only")
    assert(langintern.Intern(pool, "after-small-reset") == 0,
           "intern reset: repeated slice id restarts at zero")
    AssertInternRetainedLedger(pool, "intern reset: bounded retained ledger")
    let ownersBeforeTerminal = langintern.InternPoolOwnerReceiptRead(pool)
    let runtimeBeforeTerminal = ReadRuntimeOwnerCounters()
    langintern.InternPoolRelease(pool)
    let runtimeAfterTerminal = ReadRuntimeOwnerCounters()
    let ownersAfterTerminal = langintern.InternPoolOwnerReceiptRead(pool)
    AssertOwnerTerminalRelease(ownersBeforeTerminal,
                               ownersAfterTerminal,
                               "intern reset: terminal owner release")
    AssertRuntimePhysicalRelease(runtimeBeforeTerminal,
                                 runtimeAfterTerminal,
                                 ownersBeforeTerminal.liveCount,
                                 "intern reset: allocator released every owner")
    langintern.InternPoolRelease(pool)
    let ownersAfterSecondTerminal =
        langintern.InternPoolOwnerReceiptRead(pool)
    AssertOwnerReceiptEqual(ownersAfterTerminal,
                            ownersAfterSecondTerminal,
                            "intern reset: terminal second release is no-op")
    AssertInternReleased(pool,
                         "intern reset: release clears all structural owners")

fn TypedExprProductionResetContract() =
    var table: texpr.TypedExprFactTable
    let largeCount: int32 = 4096
    for i in 0..<largeCount:
        var fact: texpr.TypedExprFact
        fact.exprId = Fmt"expr-{i}"
        texpr.TypedExprFactTableAppendHandBuilt(table, fact)
    assert(table.arena.capacityBytes >
               texpr.TypedExprFactTableScratchRetainedArenaBytes(),
           "typed expr reset: fixture grew arena")
    var resetProbe: texpr.TypedExprFactTableResetProbe
    texpr.TypedExprFactTableResetWithProbe(table, resetProbe)
    assert(resetProbe.arenaStorageReleased &&
           resetProbe.arenaCapacityAfter == 0 &&
           resetProbe.internReset.indexOccupiedTailReadCount ==
               Int64(largeCount) &&
           resetProbe.internReset.indexBucketReadCount ==
               Int64(largeCount) &&
           resetProbe.internReset.indexOccupiedSlotVisitCount ==
               Int64(largeCount) &&
           resetProbe.internReset.textSlotVisitCount ==
               Int64(largeCount + 1) &&
           resetProbe.internReset.indexRebuilt &&
           resetProbe.internReset.textStorageReleased &&
           texpr.TypedExprFactTableCount(table) == 0,
           "typed expr reset: production bounded reset")
    assert(langintern.Intern(table.internPool, "new-slice") == 0,
           "typed expr reset: production ids restart at zero")
    texpr.TypedExprFactTableRelease(table)

fn main(): int32 =
    let mode = cmdline.ParamStr(1)
    if mode == "occupied-duplicate":
        return OccupiedTailDuplicateHardFailChild()
    if mode == "occupied-corrupt":
        return OccupiedTailCorruptHardFailChild()
    if mode == "occupied-short":
        return OccupiedTailStorageHardFailChild()
    if mode == "intern-uaf":
        return InternUseAfterReleaseHardFailChild()
    MapOccupiedClearContract()
    MapOccupiedGrowContract()
    HashCollisionFullKeyContract()
    HashSetWholeMapMoveContract()
    OccupiedTailHardFailContract()
    InternCapacityBoundaryContract(64, 64)
    InternCapacityBoundaryContract(65, 128)
    InternBoundedRetentionContract()
    InternStateCapacityGateContract(512)
    TypedExprProductionResetContract()
    echo("typed_expr_scratch_bounded_reset_smoke ok")
    return 0
