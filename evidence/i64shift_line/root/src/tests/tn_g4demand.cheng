import std/rawbytes
import cheng/core/csg_core/merkle_query

fn main(): int32 =
    var expected: merkle_query.CsgCoreMerkleQueryExpectedBinding
    var bytes = rawbytes.EmptyBytes()
    let verified = merkle_query.CsgCoreMerkleQueryReportVerify(
        bytes, "cid", expected)
    rawbytes.BytesFree(bytes)
    if verified.ok:
        return 0
    return 7
