import std/strings
import cheng/core/backend/object_plan as objplan
import cheng/core/backend/native_link_plan as nplan

fn ObjectPlanReleaseFixture(
        suffix: str): objplan.ObjectPlanStub =
    var plan: objplan.ObjectPlanStub
    plan.workspaceRoot = Fmt"/workspace/{suffix}"
    plan.packageRoot = Fmt"/workspace/{suffix}/package"
    plan.packageId = Fmt"cheng/release/{suffix}"
    plan.entryPath = Fmt"/workspace/{suffix}/main.cheng"
    plan.outputPath = Fmt"/workspace/{suffix}/main"
    plan.targetTriple = "arm64-apple-darwin"
    plan.primaryObjectPath =
        Fmt"/workspace/{suffix}/main.primary.o"
    plan.browserBridgeObjectPath =
        Fmt"/workspace/{suffix}/browser.o"
    plan.linuxNolibcSupportEnabled = true
    plan.linuxNolibcRuntimeSourcePath =
        Fmt"/workspace/{suffix}/runtime.cheng"
    plan.linuxNolibcRuntimeObjectPath =
        Fmt"/workspace/{suffix}/runtime.o"
    plan.linuxNolibcStartupSourcePath =
        Fmt"/workspace/{suffix}/startup.cheng"
    plan.linuxNolibcStartupObjectPath =
        Fmt"/workspace/{suffix}/startup.o"
    plan.providerModules = [
        Fmt"runtime/{suffix}",
        Fmt"support/{suffix}"]
    plan.providerSourcePaths = [
        Fmt"/workspace/{suffix}/provider.cheng"]
    plan.providerObjectPaths = [
        Fmt"/workspace/{suffix}/provider.o"]
    plan.linkInputPaths = [
        plan.primaryObjectPath,
        plan.providerObjectPaths[0]]
    plan.loweredFunctionSymbols = [
        Fmt"_ChengMain{suffix}",
        Fmt"_ChengHelper{suffix}"]
    plan.entrySymbol = Fmt"_ChengMain{suffix}"
    plan.missingReasons = [Fmt"fixture-{suffix}"]
    plan.pipelineStage = "object_plan_release_fixture"
    return plan

fn NativeLinkPlanReleaseFixture(
        suffix: str): nplan.NativeLinkPlanStub =
    var plan: nplan.NativeLinkPlanStub
    plan.targetTriple = "arm64-apple-darwin"
    plan.outputPath = Fmt"/workspace/{suffix}/main"
    plan.objectFormat = "macho64"
    plan.linkerProgram = "/usr/bin/ld"
    plan.linkerFlavor = "darwin_ld"
    plan.outputKind = nplan.NativeOutputExecutable
    plan.entrySymbol = Fmt"_ChengMain{suffix}"
    plan.primaryObjectPath =
        Fmt"/workspace/{suffix}/main.primary.o"
    plan.browserBridgeObjectPath =
        Fmt"/workspace/{suffix}/browser.o"
    plan.programObjectPaths = [
        plan.primaryObjectPath,
        plan.browserBridgeObjectPath]
    plan.providerObjectPaths = [
        Fmt"/workspace/{suffix}/provider.o"]
    plan.linkInputPaths = [
        plan.programObjectPaths[0],
        plan.programObjectPaths[1],
        plan.providerObjectPaths[0]]
    plan.missingReasons = [Fmt"fixture-{suffix}"]
    plan.pipelineStage = "native_link_plan_release_fixture"
    return plan

fn ObjectPlanReleaseReceiptMutationsRejected(): bool =
    var left = ObjectPlanReleaseFixture("object-left")
    var right = ObjectPlanReleaseFixture("object-right")
    var leftReceipt: objplan.ObjectPlanReleaseReceipt
    var rightReceipt: objplan.ObjectPlanReleaseReceipt
    objplan.ObjectPlanReleaseWithReceipt(left, leftReceipt)
    objplan.ObjectPlanReleaseWithReceipt(right, rightReceipt)
    var err: str
    if objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
           left, rightReceipt, err):
        return false
    var missingColumnReceipt = leftReceipt
    missingColumnReceipt.releasedOwnedStorageColumnCount =
        missingColumnReceipt.releasedOwnedStorageColumnCount - 1
    if objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
           left, missingColumnReceipt, err):
        return false
    var wrongBytesReceipt = leftReceipt
    wrongBytesReceipt.releasedBytes =
        wrongBytesReceipt.releasedBytes + int64(1)
    if objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
           left, wrongBytesReceipt, err):
        return false
    var wrongTokenReceipt = leftReceipt
    wrongTokenReceipt.ownerToken.data[0] =
        uint8(Int32(wrongTokenReceipt.ownerToken.data[0]) ^ 1)
    if objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
           left, wrongTokenReceipt, err):
        return false
    if !objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
           left, leftReceipt, err):
        return false
    if objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
           left, leftReceipt, err):
        return false
    return objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
        right, rightReceipt, err)

fn NativeLinkPlanReleaseReceiptMutationsRejected(): bool =
    var left = NativeLinkPlanReleaseFixture("native-left")
    var right = NativeLinkPlanReleaseFixture("native-right")
    var leftReceipt: nplan.NativeLinkPlanReleaseReceipt
    var rightReceipt: nplan.NativeLinkPlanReleaseReceipt
    nplan.NativeLinkPlanReleaseWithReceipt(left, leftReceipt)
    nplan.NativeLinkPlanReleaseWithReceipt(right, rightReceipt)
    var err: str
    if nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
           left, rightReceipt, err):
        return false
    var missingColumnReceipt = leftReceipt
    missingColumnReceipt.releasedOwnedStorageColumnCount =
        missingColumnReceipt.releasedOwnedStorageColumnCount - 1
    if nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
           left, missingColumnReceipt, err):
        return false
    var wrongBytesReceipt = leftReceipt
    wrongBytesReceipt.releasedBytes =
        wrongBytesReceipt.releasedBytes + int64(1)
    if nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
           left, wrongBytesReceipt, err):
        return false
    var wrongTokenReceipt = leftReceipt
    wrongTokenReceipt.ownerToken.data[0] =
        uint8(Int32(wrongTokenReceipt.ownerToken.data[0]) ^ 1)
    if nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
           left, wrongTokenReceipt, err):
        return false
    if !nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
           left, leftReceipt, err):
        return false
    if nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
           left, leftReceipt, err):
        return false
    return nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
        right, rightReceipt, err)

fn main() =
    var allocatedBufferCount: int64
    var releasedBufferCount: int64
    var allocatedBytes: int64
    var releasedBytes: int64
    for iteration in 0..<1000:
        let suffix = strings.IntToStr(iteration)
        var objectPlan = ObjectPlanReleaseFixture(suffix)
        var nativePlan = NativeLinkPlanReleaseFixture(suffix)
        let objectBuffers =
            objplan.ObjectPlanRetainedBufferCount(objectPlan)
        let objectBytes =
            objplan.ObjectPlanRetainedBytes(objectPlan)
        let nativeBuffers =
            nplan.NativeLinkPlanRetainedBufferCount(nativePlan)
        let nativeBytes =
            nplan.NativeLinkPlanRetainedBytes(nativePlan)
        assert(objectBuffers > 0 &&
               nativeBuffers > 0 &&
               objectBytes > int64(0) &&
               nativeBytes > int64(0),
               "object/native release smoke: fixture storage missing")
        allocatedBufferCount =
            allocatedBufferCount +
            int64(objectBuffers) +
            int64(nativeBuffers)
        allocatedBytes =
            allocatedBytes + objectBytes + nativeBytes
        var objectReceipt: objplan.ObjectPlanReleaseReceipt
        objplan.ObjectPlanReleaseWithReceipt(
            objectPlan, objectReceipt)
        var nativeReceipt: nplan.NativeLinkPlanReleaseReceipt
        nplan.NativeLinkPlanReleaseWithReceipt(
            nativePlan, nativeReceipt)
        assert(objectReceipt.storageReleased &&
               objectReceipt.releasedOwnedStorageColumnCount ==
                   objplan.ObjectPlanOwnedStorageColumnCount &&
               objectReceipt.releasedBufferCount == objectBuffers &&
               objectReceipt.releasedBytes == objectBytes &&
               objplan.ObjectPlanStorageReleased(objectPlan) &&
               objplan.ObjectPlanRetainedBufferCount(objectPlan) == 0 &&
               objplan.ObjectPlanRetainedBytes(objectPlan) == int64(0),
               "object/native release smoke: object receipt mismatch")
        assert(nativeReceipt.storageReleased &&
               nativeReceipt.releasedOwnedStorageColumnCount ==
                   nplan.NativeLinkPlanOwnedStorageColumnCount &&
               nativeReceipt.releasedBufferCount == nativeBuffers &&
               nativeReceipt.releasedBytes == nativeBytes &&
               nplan.NativeLinkPlanStorageReleased(nativePlan) &&
               nplan.NativeLinkPlanRetainedBufferCount(nativePlan) == 0 &&
               nplan.NativeLinkPlanRetainedBytes(nativePlan) == int64(0),
               "object/native release smoke: native receipt mismatch")
        var objectErr: str
        assert(
            objplan.ObjectPlanReleaseReceiptConsumeStrictInto(
                objectPlan, objectReceipt, objectErr),
            objectErr)
        var nativeErr: str
        assert(
            nplan.NativeLinkPlanReleaseReceiptConsumeStrictInto(
                nativePlan, nativeReceipt, nativeErr),
            nativeErr)
        releasedBufferCount =
            releasedBufferCount +
            int64(objectReceipt.releasedBufferCount) +
            int64(nativeReceipt.releasedBufferCount)
        releasedBytes =
            releasedBytes +
            objectReceipt.releasedBytes +
            nativeReceipt.releasedBytes
    assert(allocatedBufferCount == releasedBufferCount &&
           allocatedBytes == releasedBytes,
           "object/native release smoke: alloc/release mismatch")
    assert(ObjectPlanReleaseReceiptMutationsRejected(),
           "object/native release smoke: object mutation accepted")
    assert(NativeLinkPlanReleaseReceiptMutationsRejected(),
           "object/native release smoke: native mutation accepted")
    echo("object_native_link_plan_release_iterations=1000")
    echo("object_native_link_plan_release_alloc_eq_release=1")
    echo("object_native_link_plan_release_live=0")
    echo("object_native_link_plan_release_mutations_rejected=1")
