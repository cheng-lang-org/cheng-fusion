# D2/D3 verify 补齐 smoke (独立于 diloco_train_infer_loop_smoke, 只增不改):
#   (a) 同种子两跑 delta 哈希一致 (双仓独立落盘)
#   (b) 内步预算 0 / 负学习率 / 空批 -> Err
#   (c) D3 quorum: 缺一份工人 delta -> 合并 Err
#   (d) 伪造页: 提交后篡改磁盘上 delta 字节 -> 合并经工件仓漂移检测 Err

import std/result
import std/os
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import cheng/libp2p/core/types
import cheng/DiLoCo/core/diloco as core
import cheng/DiLoCo/artifact/store as astore
import cheng/DiLoCo/train/codec as codec
import cheng/DiLoCo/train/inner_step as inner
import cheng/DiLoCo/train/outer_merge as outer
import cheng/DiLoCo/tests/support

const
    SmokeIn: int32 = 4
    SmokeOut: int32 = 2
    SmokeInnerSteps: int32 = 8
    SmokeShardBytes: int32 = 64
    SmokeLrNum: int32 = 1
    SmokeLrDen: int32 = 2

fn die(msg: str): int32 =
    echo(msg)
    return 1

@borrows
fn freshStore(storeDir: str): Result[astore.DiLoCoArtifactStore] =
    var store = astore.DiLoCoArtifactStore()
    if os.DirExists(storeDir):
        os.RemoveDir(storeDir)
    let initRes = astore.DiLoCoArtifactStoreInitFill(store, storeDir)
    if IsErr(initRes):
        return Err[astore.DiLoCoArtifactStore](Error(initRes))
    return Ok[astore.DiLoCoArtifactStore](store)

@borrows
fn putParams(store: var astore.DiLoCoArtifactStore,
             jobBundleCid: layout.FixedBytes32,
             values: int32[]): Result[core.DiLoCoArtifactRef] =
    var packed = rawbytes.EmptyBytes()
    let packRes = codec.DiLoCoTrainPackI32Fill(packed, values)
    if IsErr(packRes):
        return Err[core.DiLoCoArtifactRef](Error(packRes))
    var artifactRef = core.DiLoCoArtifactRef()
    let putRes = astore.DiLoCoArtifactStorePutFill(artifactRef, store, jobBundleCid, packed, SmokeShardBytes)
    if IsErr(putRes):
        return Err[core.DiLoCoArtifactRef](Error(putRes))
    return Ok[core.DiLoCoArtifactRef](artifactRef)

@borrows
fn makeBatchA(xs: var int32[], ys: var int32[]) =
    for s in 0..<3:
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(xs, 0)
        add(ys, 1000)
        add(ys, 0)

@borrows
fn makeBatchB(xs: var int32[], ys: var int32[]) =
    for s in 0..<3:
        add(xs, 0)
        add(xs, 1000)
        add(xs, 0)
        add(xs, 0)
        add(ys, 0)
        add(ys, 1000)

@borrows
fn wireCohort(state: var core.DiLoCoState,
              store: var astore.DiLoCoArtifactStore,
              modelPut: core.DiLoCoArtifactRef,
              optPut: core.DiLoCoArtifactRef,
              jobBundleCid: layout.FixedBytes32,
              leaderPeer: types.Libp2pPeerId,
              workerPeer: types.Libp2pPeerId,
              leaderLeaseOut: var core.DiLoCoLease,
              workerLeaseOut: var core.DiLoCoLease): Result[bool] =
    var openedJob = core.DiLoCoJob()
    var genesis = core.DiLoCoGlobalVersion()
    let openRes = core.DiLoCoOpenJobFill(openedJob,
                                           genesis,
                                           state,
                                           jobBundleCid,
                                           2,
                                           SmokeInnerSteps,
                                           60,
                                           modelPut,
                                           optPut)
    if IsErr(openRes):
        return Err[bool](Error(openRes))
    var cohort = core.DiLoCoCohort()
    let joinL = core.DiLoCoJoinCohortFill(cohort, state, jobBundleCid, leaderPeer)
    if IsErr(joinL):
        return Err[bool](Error(joinL))
    let joinW = core.DiLoCoJoinCohortFill(cohort, state, jobBundleCid, workerPeer)
    if IsErr(joinW):
        return Err[bool](Error(joinW))
    let ll = core.DiLoCoFetchLeaseFill(leaderLeaseOut, state, jobBundleCid, leaderPeer)
    if IsErr(ll):
        return Err[bool](Error(ll))
    let wl = core.DiLoCoFetchLeaseFill(workerLeaseOut, state, jobBundleCid, workerPeer)
    if IsErr(wl):
        return Err[bool](Error(wl))
    var barrier = core.DiLoCoBarrier()
    let bA = core.DiLoCoReportInnerStepDoneFill(barrier, state, jobBundleCid, leaderPeer)
    if IsErr(bA):
        return Err[bool](Error(bA))
    let bB = core.DiLoCoReportInnerStepDoneFill(barrier, state, jobBundleCid, workerPeer)
    if IsErr(bB):
        return Err[bool](Error(bB))
    return Ok[bool](true)

fn main(): int32 =
    let tmpRoot = os.GetEnvDefault("CHENG_TASK_TMPDIR", "")
    if tmpRoot == "":
        return die("diloco_inner_negative_smoke: CHENG_TASK_TMPDIR missing")

    # ---- (a) 同种子两跑: 双仓独立落盘, delta blobCid 必须一致 ----
    let detDirA = tmpRoot + "/diloco-neg-det-a"
    let detDirB = tmpRoot + "/diloco-neg-det-b"
    var storeA = astore.DiLoCoArtifactStore()
    var storeB = astore.DiLoCoArtifactStore()
    let initA = freshStore(detDirA)
    assert(IsOk(initA), " diloco inner negative smoke: init store A")
    storeA = Value(initA)
    let initB = freshStore(detDirB)
    assert(IsOk(initB), " diloco inner negative smoke: init store B")
    storeB = Value(initB)
    let jobDet = support.DiLoCoTestJobBundleCid("neg-det")
    var zeros: int32[]
    let zeroRes = inner.DiLoCoLinearZerosFill(zeros, SmokeOut, SmokeIn)
    assert(IsOk(zeroRes), " diloco inner negative smoke: zeros")
    let basePutA = putParams(storeA, jobDet, zeros)
    assert(IsOk(basePutA), " diloco inner negative smoke: base put A")
    let basePutB = putParams(storeB, jobDet, zeros)
    assert(IsOk(basePutB), " diloco inner negative smoke: base put B")
    var xsDet: int32[]
    var ysDet: int32[]
    makeBatchA(xsDet, ysDet)
    var wDetA: int32[]
    var dDetA: int32[]
    let runA = inner.DiLoCoInnerSgdLinearFill(wDetA, dDetA, zeros, xsDet, ysDet, 3, SmokeInnerSteps, SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    assert(IsOk(runA), " diloco inner negative smoke: det run A")
    var wDetB: int32[]
    var dDetB: int32[]
    let runB = inner.DiLoCoInnerSgdLinearFill(wDetB, dDetB, zeros, xsDet, ysDet, 3, SmokeInnerSteps, SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    assert(IsOk(runB), " diloco inner negative smoke: det run B")
    let deltaPutA = putParams(storeA, jobDet, dDetA)
    assert(IsOk(deltaPutA), " diloco inner negative smoke: delta put A")
    let deltaPutB = putParams(storeB, jobDet, dDetB)
    assert(IsOk(deltaPutB), " diloco inner negative smoke: delta put B")
    let deltaRefA = Value(deltaPutA)
    let deltaRefB = Value(deltaPutB)
    assert(layout.FixedBytes32Equal(deltaRefA.blobCid, deltaRefB.blobCid),
        " diloco inner negative smoke: deterministic delta cid")

    # ---- (b) 预算 0 / 负学习率 / 空批 -> Err ----
    var wNeg: int32[]
    var dNeg: int32[]
    let zeroBudget = inner.DiLoCoInnerSgdLinearFill(wNeg, dNeg, zeros, xsDet, ysDet, 3, 0, SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    assert(IsErr(zeroBudget), " diloco inner negative smoke: zero budget must fail")
    let negLr = inner.DiLoCoInnerSgdLinearFill(wNeg, dNeg, zeros, xsDet, ysDet, 3, SmokeInnerSteps, SmokeOut, SmokeIn, -1, SmokeLrDen)
    assert(IsErr(negLr), " diloco inner negative smoke: negative lr must fail")
    var emptyXs: int32[]
    var emptyYs: int32[]
    let emptyBatch = inner.DiLoCoInnerSgdLinearFill(wNeg, dNeg, zeros, emptyXs, emptyYs, 0, SmokeInnerSteps, SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    assert(IsErr(emptyBatch), " diloco inner negative smoke: empty batch must fail")

    # ---- (c) D3 quorum: 缺一份工人 delta -> 合并 Err ----
    let quorumDir = tmpRoot + "/diloco-neg-quorum"
    var storeQ = astore.DiLoCoArtifactStore()
    let initQ = freshStore(quorumDir)
    assert(IsOk(initQ), " diloco inner negative smoke: init quorum store")
    storeQ = Value(initQ)
    let jobQ = support.DiLoCoTestJobBundleCid("neg-quorum")
    let basePutQ = putParams(storeQ, jobQ, zeros)
    assert(IsOk(basePutQ), " diloco inner negative smoke: quorum base put")
    let optPutQ = putParams(storeQ, jobQ, zeros)
    assert(IsOk(optPutQ), " diloco inner negative smoke: quorum opt put")
    var stateQ = core.DiLoCoStateInit("diloco.neg.quorum")
    var leaderQ: types.Libp2pPeerId
    leaderQ.value = support.DiLoCoTestJobBundleCid("neg-quorum-leader")
    var workerQ: types.Libp2pPeerId
    workerQ.value = support.DiLoCoTestJobBundleCid("neg-quorum-worker")
    var leaseQ1 = core.DiLoCoLease()
    var leaseQ2 = core.DiLoCoLease()
    let wireRes = wireCohort(stateQ, storeQ, Value(basePutQ), Value(optPutQ), jobQ, leaderQ, workerQ, leaseQ1, leaseQ2)
    assert(IsOk(wireRes), " diloco inner negative smoke: wire cohort")

    var wQ1: int32[]
    var dQ1: int32[]
    var xsQ1: int32[]
    var ysQ1: int32[]
    makeBatchA(xsQ1, ysQ1)
    let innerQ1 = inner.DiLoCoInnerSgdLinearFill(wQ1, dQ1, zeros, xsQ1, ysQ1, 3, SmokeInnerSteps, SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    assert(IsOk(innerQ1), " diloco inner negative smoke: quorum inner 1")
    let dQ1Put = putParams(storeQ, jobQ, dQ1)
    assert(IsOk(dQ1Put), " diloco inner negative smoke: quorum delta put 1")
    let oQ1Put = putParams(storeQ, jobQ, zeros)
    assert(IsOk(oQ1Put), " diloco inner negative smoke: quorum opt put 1")
    let tokensQ: int32 = 3 * SmokeInnerSteps
    var recQ1 = core.DiLoCoOuterDelta()
    let subQ1 = core.DiLoCoSubmitOuterDeltaFill(recQ1,
                                                  stateQ,
                                                  jobQ,
                                                  leaseQ1.baseVersionCid,
                                                  leaseQ1.outerStep,
                                                  leaderQ,
                                                  Value(dQ1Put),
                                                  Value(oQ1Put),
                                                  3,
                                                  tokensQ,
                                                  SmokeInnerSteps,
                                                  tokensQ,
                                                  1)
    assert(IsOk(subQ1), " diloco inner negative smoke: quorum submit 1")

    var commitQ = core.DiLoCoMergeCommit()
    var versionQ = core.DiLoCoGlobalVersion()
    let mergeMissing = outer.DiLoCoOuterMergeAndPublishFill(commitQ,
                                                              versionQ,
                                                              storeQ,
                                                              stateQ,
                                                              jobQ,
                                                              leaderQ,
                                                              SmokeShardBytes)
    assert(IsErr(mergeMissing), " diloco inner negative smoke: missing worker delta must fail merge")

    # ---- (d) 伪造页: 两 delta 齐 -> 篡改 worker 页 -> 合并 Err (工件仓漂移传导) ----
    var wQ2: int32[]
    var dQ2: int32[]
    var xsQ2: int32[]
    var ysQ2: int32[]
    makeBatchB(xsQ2, ysQ2)
    let innerQ2 = inner.DiLoCoInnerSgdLinearFill(wQ2, dQ2, zeros, xsQ2, ysQ2, 3, SmokeInnerSteps, SmokeOut, SmokeIn, SmokeLrNum, SmokeLrDen)
    assert(IsOk(innerQ2), " diloco inner negative smoke: quorum inner 2")
    let dQ2Put = putParams(storeQ, jobQ, dQ2)
    assert(IsOk(dQ2Put), " diloco inner negative smoke: quorum delta put 2")
    let oQ2Put = putParams(storeQ, jobQ, zeros)
    assert(IsOk(oQ2Put), " diloco inner negative smoke: quorum opt put 2")
    var recQ2 = core.DiLoCoOuterDelta()
    let subQ2 = core.DiLoCoSubmitOuterDeltaFill(recQ2,
                                                  stateQ,
                                                  jobQ,
                                                  leaseQ2.baseVersionCid,
                                                  leaseQ2.outerStep,
                                                  workerQ,
                                                  Value(dQ2Put),
                                                  Value(oQ2Put),
                                                  3,
                                                  tokensQ,
                                                  SmokeInnerSteps,
                                                  tokensQ,
                                                  1)
    assert(IsOk(subQ2), " diloco inner negative smoke: quorum submit 2")

    let victimRef = Value(dQ2Put)
    let victimPath = astore.DiLoCoArtifactStoreBlobPath(quorumDir, victimRef.blobCid)
    var victimBytes = rawbytes.EmptyBytes()
    let victimRead = os.ReadFileBytesResult(victimPath)
    assert(IsOk(victimRead), " diloco inner negative smoke: victim read")
    var tampered = Value(victimRead)
    rawbytes.BytesSet(tampered, 4, (rawbytes.BytesGet(tampered, 4) + 1) % 256)
    let tamperWrite = os.WriteFileBytesResult(victimPath, tampered)
    assert(IsOk(tamperWrite), " diloco inner negative smoke: tamper write")

    var commitF = core.DiLoCoMergeCommit()
    var versionF = core.DiLoCoGlobalVersion()
    let mergeForged = outer.DiLoCoOuterMergeAndPublishFill(commitF,
                                                             versionF,
                                                             storeQ,
                                                             stateQ,
                                                             jobQ,
                                                             leaderQ,
                                                             SmokeShardBytes)
    assert(IsErr(mergeForged), " diloco inner negative smoke: forged page must fail merge")

    echo(" diloco_inner_negative_smoke ok")
    return 0
