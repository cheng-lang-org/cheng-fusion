# Aggregated regression smoke for the 2026-06-12 cold backend miscompile
# family (findings.md). Covers members #1-#4 and #7; #6 (empty global seq
# scan+add) lives in src/libp2p/tests/cold_seq_empty_scan_add_probe.cheng;
# #5 (unknown struct field read must be a compile error) is the negative
# fixture src/tests/cold_unknown_field_read_negative.cheng.
#
# Expected: exit 0 and print "cold_miscompile_regression_smoke ok".

var
    g32: int32[]
    g64: int64[]

# member #7: global scalar seq element writes inside leaf functions with
# parameter index/value (was silently dropped: empty fn body emitted).
fn put32(i: int32, v: int32): int32 =
    g32[i] = v
    return 0

fn put64(i: int32, v: int64): int32 =
    g64[i] = v
    return 0

fn checkMod(): int32 =
    # member #1: int64 % must keep the full 64-bit dividend.
    var d: int64 = 5000000000
    let r1: int64 = d % 7
    if r1 != 2:
        return 11
    var dn: int64 = 0 - 5000000000
    let r2: int64 = dn % 7
    if r2 != -2:
        return 12
    # member #2: literal 2147483648 (2^31) as modulus.
    var x: int64 = 1103527590
    let r3: int64 = (x * 1103515245 + 12345) % 2147483648
    if r3 != 377401575:
        return 13
    return 0

fn checkShift(): int32 =
    # member #3: uint64 >> must be a logical shift (spec 1.3.2).
    var a: uint64 = 0
    a = a - 1
    a = a >> 1
    let lo: uint64 = a & 255
    if lo != 255:
        return 21
    let hi: uint64 = (a >> 56) & 255
    if hi != 127:
        return 22
    var b: uint64 = 0
    b = b - 1
    if (b >> 63) != 1:
        return 23
    return 0

fn checkHex(): int32 =
    # member #4: bit63-set int64 hex literal byte decomposition.
    var x: int64 = 0x800000008000808B
    if (x & 255) != 139:
        return 31
    if ((x >> 8) & 255) != 128:
        return 32
    if ((x >> 16) & 255) != 0:
        return 33
    if ((x >> 24) & 255) != 128:
        return 34
    if ((x >> 32) & 255) != 0:
        return 35
    if ((x >> 56) & 255) != 128:
        return 36
    # member #4 sibling: 32-bit-range bit31-set hex literals are unsigned
    # values; promotion into int64 contexts must zero-extend.
    let masked: int64 = x & 0xFFFFFFFF
    if masked != 0x8000808B:
        return 37
    var m: int64 = 0xFFFFFFFF
    if m != 4294967295:
        return 38
    var n: int64 = 0x80000000
    if n != 2147483648:
        return 39
    return 0

fn checkGlobalSeq(): int32 =
    # member #7: writes through leaf helpers, then verify values and that
    # neighbors are not polluted (int64 element writes corrupted adjacents).
    setLen(g32, 4)
    setLen(g64, 4)
    let w1: int32 = put32(2, 77)
    let w2: int32 = put64(1, 5000000077)
    if w1 + w2 != 0:
        return 41
    if g32[2] != 77:
        return 42
    if g32[0] != 0 || g32[1] != 0 || g32[3] != 0:
        return 43
    if g64[1] != 5000000077:
        return 44
    if g64[0] != 0 || g64[2] != 0 || g64[3] != 0:
        return 45
    return 0

fn main(): int32 =
    let m: int32 = checkMod()
    if m != 0:
        return m
    let s: int32 = checkShift()
    if s != 0:
        return s
    let h: int32 = checkHex()
    if h != 0:
        return h
    let q: int32 = checkGlobalSeq()
    if q != 0:
        return q
    echo("cold_miscompile_regression_smoke ok")
    return 0
