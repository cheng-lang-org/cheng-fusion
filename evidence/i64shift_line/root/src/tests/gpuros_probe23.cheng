@profile("driver_safe")

type
    IoUInt8Ptr = uint8 *
    IoUInt32Ptr = uint32 *
    IoUInt64Ptr = uint64 *

@trusted_abi
fn IoRamSt64(base: uint64, byteOffset: int32, value: uint64) =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    *(IoUInt64Ptr(addr)) = value

@trusted_abi
fn IoRamLd32(base: uint64, byteOffset: int32): int32 =
    let b = base
    let o = byteOffset
    let addr = ptr(b + uint64(o))
    return int32(*(IoUInt32Ptr(addr)))

@trusted_abi
fn IoSt8(base: uint64, offset: uint64, value: int32) =
    let b = base
    let o = offset
    let addr = ptr(b + o)
    *(IoUInt8Ptr(addr)) = uint8(value & 255)

fn HexNib(v: int32) =
    let w = v
    if w < 10:
        IoSt8(268435456, 0, int32(48 + w))
    else:
        IoSt8(268435456, 0, int32(87 + w))

fn Hex32(v: int32) =
    var div = 268435456
    while div > 0:
        HexNib((v / div) & 15)
        div = div / 16

fn Sep() =
    IoSt8(268435456, 0, 32)

fn main(): int32 =
    let v = uint64(305419896 * 4 + 5)
    IoRamSt64(2183135232, 0, v)
    let lo = IoRamLd32(2183135232, 0)
    let hi = IoRamLd32(2183135232, 4)
    Hex32(lo)
    Sep()
    Hex32(hi)
    IoSt8(268435456, 0, 10)
    return 0
