# minimal probe 8: @borrows param passthrough. If the compiler materializes
# a @borrows str param as an owned bit-copy and drops it at exit while the
# caller also drops the source, this exits with a double release.
import std/system
import std/result
import std/strings as strings

@borrows
fn EchoMsg(msg: str): str =
    return msg

fn main(): int32 =
    let owned = strings.CloneStr("passthrough probe message")
    let echoed = EchoMsg(owned)
    echo(echoed)
    echo("done")
    return 0
