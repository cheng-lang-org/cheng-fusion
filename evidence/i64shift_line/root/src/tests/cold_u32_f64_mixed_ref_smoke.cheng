# Regression lock for cold defect #144 site 2: cold_materialize_i32_ref must
# propagate the by-ref slot's "uint32" marker onto the dereferenced value so
# a subsequent float64 promotion zero-extends values >= 2^31.
# probe receives a `var uint32` (by-ref) param; correct n*0.5 = 1500000003.5.
fn probe(n: var uint32): int32 =
    let f: float64 = 0.5
    if n * f == 1500000003.5:
        if n + f == 3000000007.5:
            if n - f == 3000000006.5:
                return 0
            return 3
        return 2
    return 1

fn main(): int32 =
    var v: uint32 = uint32(3000000007)
    return probe(v)
