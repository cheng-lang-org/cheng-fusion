import std/system as system

type
    T =
        label: str

    ColdManagedExactGenericFixedArrayValueOwner[U] =
        leaves: U[2]

fn ColdManagedExactGenericFixedArrayValueOpen[T](
        owner: var ColdManagedExactGenericFixedArrayValueOwner[T]): int32 =
    return 0

fn ColdManagedExactGenericFixedArrayValueNew(value: str): str =
    return system.NewStringCopy(
        system.StrDataPtr(value), value.len)

fn ColdManagedExactGenericFixedArrayValueExercise(): int32 =
    var owner: ColdManagedExactGenericFixedArrayValueOwner[T]
    if ColdManagedExactGenericFixedArrayValueOpen[T](owner) != 0:
        return 1
    owner.leaves[0].label =
        ColdManagedExactGenericFixedArrayValueNew("left")
    owner.leaves[1].label =
        ColdManagedExactGenericFixedArrayValueNew("right")

    owner.leaves[0] = owner.leaves[0]
    var replacement: T
    replacement.label =
        ColdManagedExactGenericFixedArrayValueNew("new-left")
    owner.leaves[0] = replacement
    owner.leaves[1] = T()

    if owner.leaves[0].label != "new-left" ||
       len(owner.leaves[1].label) != 0:
        return 2
    return 0

fn main(): int32 =
    let allocBefore = system.memAllocCount()
    let freeBefore = system.memFreeCount()
    let liveBefore = system.memLiveCount()
    let retainBefore = system.memRetainCount()
    let releaseBefore = system.memReleaseCount()

    if ColdManagedExactGenericFixedArrayValueExercise() != 0:
        return 1

    let allocDelta = system.memAllocCount() - allocBefore
    let freeDelta = system.memFreeCount() - freeBefore
    let retainDelta = system.memRetainCount() - retainBefore
    let releaseDelta = system.memReleaseCount() - releaseBefore
    if allocDelta <= int64(0) || allocDelta != freeDelta:
        return 2
    if system.memLiveCount() != liveBefore:
        return 3
    if releaseDelta != retainDelta + freeDelta:
        return 4
    echo("cold_managed_exact_generic_fixed_array_value_object=PASS")
    return 0
