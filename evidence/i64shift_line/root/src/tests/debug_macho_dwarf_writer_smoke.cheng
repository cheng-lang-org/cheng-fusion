import std/cmdline as cmdline
import std/strings
import std/os
import std/rawbytes
import cheng/core/backend/debug_facts as debug
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/object_buffer as obuf
import cheng/core/backend/object_symbols as osym
import cheng/core/backend/object_relocs as orel
import cheng/core/backend/direct_object_emit as direct
import cheng/core/backend/direct_object_debug_sections as debugsections
import cheng/core/backend/macho_object_writer as macho
import cheng/core/backend/macho_debug_section_evidence as machoevidence
import cheng/core/backend/primary_object_plan as primary
import cheng/tests/debug_emission_receipt_smoke as fixture
import cheng/tests/debug_section_plan_receipt_smoke as support
import cheng/tests/debug_section_plan_backend_consumption_smoke as plansupport

fn BuildText(): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(8)
    obuf.ObjectBufferWriteU32LE(out, uint64(0xd503201f))
    obuf.ObjectBufferWriteU32LE(out, uint64(0xd65f03c0))
    return obuf.ObjectBufferToBytes(out)

fn BuildData(): rawbytes.Bytes =
    var out = obuf.ObjectBufferInit(8)
    obuf.ObjectBufferWriteU64LE(out, uint64(0x1020304050607080))
    return obuf.ObjectBufferToBytes(out)

fn BuildSymbols(): osym.ObjectSymbolTable =
    var out = osym.ObjectSymbolsInit()
    assert(osym.ObjectSymbolsAddDefined(
               out, "_Main", 0, int64(0), int64(8), true) == 0,
           "debug Mach-O writer: exact symbol build failed")
    return out

@borrows
fn CloneBytes(value: rawbytes.Bytes): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(rawbytes.BytesLen(value))

@borrows
fn PlanCopyForAttack(plan: primary.PrimaryObjectPlan): primary.PrimaryObjectPlan =
    var out = plan
    return out


@borrows
fn AssertObjectAttackRejected(
        objectBytes: rawbytes.Bytes,
        sections: debugsections.DirectObjectDebugSections,
        symbols: osym.ObjectSymbolTable,
        label: str) =
    var parsed: machoevidence.MachODebugSectionEvidence
    var err: str
    assert(!machoevidence.MachODebugSectionEvidenceBuildInto(
               objectBytes, sections, symbols, parsed, err), label)

@borrows
fn BuildConsumedPlan(
        backendKind: str,
        outputPath: str,
        lowering: lower.LoweringPlanStub,
        facts: debug.DebugFactBundle): primary.PrimaryObjectPlan =
    var err: str
    var planEvidence = support.MakeEvidence(facts)
    planEvidence.backendKind = strings.CloneStr(backendKind)
    var out = plansupport.MakePrimaryPlan(planEvidence, backendKind)
    out.targetTriple = "arm64-apple-darwin"
    out.objectFormat = "macho"
    out.outputPath = outputPath
    assert(primary.PrimaryObjectPlanConsumeDebugSectionPlanReceiptInto(
               lowering, out, err), err)
    return out

fn main() =
    assert(cmdline.ParamCount() == 3,
           "debug Mach-O writer: expected primary/backend2 output paths")
    var err: str
    var facts: debug.DebugFactBundle
    support.BuildFacts("macho-dwarf-writer", facts)
    var lowering: lower.LoweringPlanStub
    let retainedBody = fixture.BuildBody(facts, lowering)
    let binding = support.MakeBindingReceipt(facts, lowering)
    assert(lower.LoweringPlanBindPublishedDebugBindingReceiptInto(
               lowering, binding, err), err)

    var text = BuildText()
    var data = BuildData()
    var symbols = BuildSymbols()
    var relocs = orel.ObjectRelocsInit()

    var primaryPlan = BuildConsumedPlan(
        "primary", cmdline.ParamStr(1), lowering, facts)
    var primaryWrite: direct.DirectObjectEmitResult
    var primaryWriteErr: str
    if !direct.DirectObjectEmitWriteObjectForFormat(
        "/", primaryPlan, "macho", text, data, symbols, relocs,
        primaryWrite, primaryWriteErr):
        panic(primaryWriteErr)
    assert(primaryWrite.relocCount == 4,
           "debug Mach-O writer: primary relocation count mismatch")

    var sections: debugsections.DirectObjectDebugSections
    assert(debugsections.DirectObjectDebugSectionsBuildInto(
               primaryPlan.debugSectionPlanReceipt,
               symbols, sections, err), err)
    let objectBytesResult = macho.MachOTextDataDebugObjectBytes(
        text, data, symbols, relocs, sections)
    assert(objectBytesResult.ok, objectBytesResult.err.msg)
    let objectBytes = objectBytesResult.value
    var parsed: machoevidence.MachODebugSectionEvidence
    assert(machoevidence.MachODebugSectionEvidenceBuildInto(
               objectBytes, sections, symbols, parsed, err), err)

    let lineSectionHeader = 32 + 72 +
                            (parsed.lineSectionIndex - 1) * 80
    var sectionNameAttack = CloneBytes(objectBytes)
    rawbytes.BytesSet(sectionNameAttack, lineSectionHeader, int32('X'))
    AssertObjectAttackRejected(
        sectionNameAttack, sections, symbols,
        "debug Mach-O writer: section-name attack accepted")

    var relocationCountAttack = CloneBytes(objectBytes)
    for index in 0..<4:
        rawbytes.BytesSet(
            relocationCountAttack, lineSectionHeader + 60 + index, 0)
    AssertObjectAttackRejected(
        relocationCountAttack, sections, symbols,
        "debug Mach-O writer: deleted relocation table accepted")

    var relocationOffsetAttack = CloneBytes(objectBytes)
    rawbytes.BytesSet(
        relocationOffsetAttack, parsed.lineRelocationFileOffset,
        rawbytes.BytesGet(
            relocationOffsetAttack, parsed.lineRelocationFileOffset) + 1)
    AssertObjectAttackRejected(
        relocationOffsetAttack, sections, symbols,
        "debug Mach-O writer: relocation offset attack accepted")

    var relocationSymbolAttack = CloneBytes(objectBytes)
    rawbytes.BytesSet(
        relocationSymbolAttack, parsed.lineRelocationFileOffset + 4, 1)
    AssertObjectAttackRejected(
        relocationSymbolAttack, sections, symbols,
        "debug Mach-O writer: relocation symbol attack accepted")

    var inlineAddressAttack = CloneBytes(objectBytes)
    let firstLineAddress = parsed.lineFileOffset +
                           sections.relocations[0].sectionByteOffset
    rawbytes.BytesSet(inlineAddressAttack, firstLineAddress, 1)
    AssertObjectAttackRejected(
        inlineAddressAttack, sections, symbols,
        "debug Mach-O writer: inline addend attack accepted")

    var backend2Plan = BuildConsumedPlan(
        "backend2", cmdline.ParamStr(2), lowering, facts)
    var backend2Write: direct.DirectObjectEmitResult
    var backend2WriteErr: str
    if !direct.DirectObjectEmitWriteObjectForFormat(
        "/", backend2Plan, "macho", text, data, symbols, relocs,
        backend2Write, backend2WriteErr):
        panic(backend2WriteErr)
    assert(backend2Write.relocCount == 4,
           "debug Mach-O writer: backend2 relocation count mismatch")

    var elfPlan = PlanCopyForAttack(primaryPlan)
    elfPlan.objectFormat = "elf"
    var elfWrite: direct.DirectObjectEmitResult
    var elfWriteErr: str
    let elfFailed = !direct.DirectObjectEmitWriteObjectForFormat(
        "/", elfPlan, "elf", text, data, symbols, relocs,
        elfWrite, elfWriteErr)
    assert(elfFailed &&
           elfWriteErr ==
               " direct object emit: ELF/COFF debug sections not implemented",
           "debug Mach-O writer: ELF silently dropped debug sections")
    var coffPlan = PlanCopyForAttack(primaryPlan)
    coffPlan.objectFormat = "coff"
    var coffWrite: direct.DirectObjectEmitResult
    var coffWriteErr: str
    let coffFailed = !direct.DirectObjectEmitWriteObjectForFormat(
        "/", coffPlan, "coff", text, data, symbols, relocs,
        coffWrite, coffWriteErr)
    assert(coffFailed &&
           coffWriteErr ==
               " direct object emit: ELF/COFF debug sections not implemented",
           "debug Mach-O writer: COFF silently dropped debug sections")
    os.WriteLine(os.Get_stdout(), "debug_macho_dwarf_writer_smoke=pass")
