import cheng/tests/cold_typed_const_global_lib

fn main(): int32 =
    if TypedGlobalF64() != -10.0:
        return 1
    if TypedGlobalF32() != float32(1):
        return 2
    if TypedGlobalI64() != 4294967297:
        return 3
    if TypedHexI64() != 4294967295:
        return 10
    if TypedShiftI32() != 1048576:
        return 11
    if TypedShiftI64() != 4294967296:
        return 12
    if TypedUint32Max() != uint32(4294967295):
        return 13
    if TypedCharSlash() != '/':
        return 14
    if TypedPrecedence() != 7:
        return 15
    TypedGlobalSetF64(3.25)
    TypedGlobalSetF32(float32(2))
    TypedGlobalSetI64(9)
    if TypedGlobalF64() != 3.25:
        return 4
    if TypedGlobalF32() != float32(2):
        return 5
    if TypedGlobalI64() != 9:
        return 6
    TypedGlobalReset()
    if TypedGlobalF64() != -10.0:
        return 7
    if TypedGlobalF32() != float32(1):
        return 8
    if TypedGlobalI64() != 4294967297:
        return 9
    return 0
