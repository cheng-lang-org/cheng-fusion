import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/riscv64_encode as rv
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import cheng/core/backend/regalloc_riscv_adapter as riscvadapter

fn riscvCallIdentityBody(): ir.BodyIR =
    let parsed = layout.FixedBytes32FromHex(
        "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc")
    assert(parsed.ok, " call identity CID")
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindTypeArenaArtifactCid(body, parsed.value),
           " call identity bind")
    for slotIndex in 0..<3:
        var slot: ir.LocalSlot
        ir.BodyIRApplyLocalSlotDefaultProof(slot)
        slot.id = slotIndex
        slot.name = "call_value"
        slot.typeKind = ir.LocalI32Tag
        slot.stackOffset = 16 + slotIndex * 8
        slot.sizeBytes = 4
        slot.alignBytes = 4
        add(body.localSlots, slot)
    var entryOwnershipKinds: int32[]
    for _ in 0..<body.localSlots.len:
        add(entryOwnershipKinds, int32(ir.OwnInvalid))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, entryOwnershipKinds)
    for argIndex in 0..<2:
        var valueOp: ir.BodyOp
        ir.BodyIRApplyBodyOpDefaultProof(valueOp)
        valueOp.kind = ir.BodyOpLoadConstTag
        valueOp.target = argIndex
        add(valueOp.operands, ir.LocalI32Tag)
        add(valueOp.operands, 40 + argIndex)
        let _ = ir.BodyIRAppendOp(body, valueOp)
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "non_authoritative_surface_spelling"
    call.targetSourcePath = "src/tests/riscv_exact_target.cheng"
    call.resultSlot = 2
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.semanticCallExprNodeIndex = 71
    call.relocWordOffset = -1
    for argIndex in 0..<2:
        add(call.argSlots, argIndex)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 4)
    add(body.callSequence, call)
    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 2
    add(callOp.operands, 0)
    let _ = ir.BodyIRAppendOp(body, callOp)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = 2
    add(term.operands, ir.LocalI32Tag)
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let blockIndex = ir.BodyIRAppendBlock(
        body, 0, body.ops.len, termIndex)
    ir.BodyIRControlFlowBegin(body, 9)
    ir.BodyIRControlFlowBindBlockScope(body, blockIndex, 0)
    var noSuccessors: int32[]
    var noEdges: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, noSuccessors, noEdges)
    ir.BodyIRControlFlowBindCallTarget(
        body, 0, ir.BodyCallTargetDomainFunctionTag, 17,
        parsed.value)
    ir.BodyIRControlFlowSeal(body)
    return body

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !riscvadapter.RegallocRiscvCodegenUnitRegister():
        return 90
    var body = riscvCallIdentityBody()
    var callTargets: str[]
    add(callTargets, "exact_materialized_callee")
    var dataTargets: str[]
    var emission = emitter.RegallocProductionEmitFunction(
        artifacts.RegallocProductionTargetRv64Linux,
        body, "caller", 0, callTargets, dataTargets,
        9, artifacts.RegallocProductionFunctionKindNormal)
    assert(emission.valid, " call identity emission")
    assert(emission.recipes.machineXlen == 64 &&
           emission.recipes.functionRelocs.len == 1,
           " call identity xlen and count")
    let functionReloc = emission.recipes.functionRelocs[0]
    assert(functionReloc.kind ==
               contract.RegallocMachineRelocRiscvCall &&
           functionReloc.targetDomain ==
               body.callTargetDomainKinds[0] &&
           functionReloc.targetRow == body.callTargetRows[0] &&
           layout.FixedBytes32Equal(
               functionReloc.targetInterfaceCid,
               body.callTargetInterfaceCids[0]) &&
           functionReloc.targetSymbol ==
               "exact_materialized_callee" &&
           body.callSequence[0].targetSymbol ==
               "non_authoritative_surface_spelling",
           " call identity projection")
    let expectedAuipc = int32(int64(rv.rv64EncAuipc(1, 0)))
    let expectedJalr = rv.RvEncJalrForXlen(64, 1, 1, 0)
    assert(expectedJalr.ok &&
           emission.recipes.functionWords[
               functionReloc.wordIndex] == expectedAuipc &&
           emission.recipes.functionWords[
               functionReloc.wordIndex + 1] ==
               int32(int64(expectedJalr.value)),
           " call identity shipped encoder pair")

    var recipeIndex: int32 = -1
    for index in 0..<emission.recipes.recipes.len:
        if emission.recipes.recipes[index].relocs.len == 1 &&
           emission.recipes.recipes[index].relocs[0].kind ==
               contract.RegallocMachineRelocRiscvCall:
            recipeIndex = index
    var fragmentIndex: int32 = -1
    for index in 0..<emission.recipes.machineFragments.len:
        if emission.recipes.machineFragments[index].relocs.len == 1 &&
           emission.recipes.machineFragments[index].relocs[0].kind ==
               contract.RegallocMachineRelocRiscvCall:
            fragmentIndex = index
    assert(recipeIndex >= 0 && fragmentIndex >= 0,
           " call identity copies")
    let recipeReloc = emission.recipes.recipes[recipeIndex].relocs[0]
    let fragmentReloc =
        emission.recipes.machineFragments[fragmentIndex].relocs[0]
    assert(recipeReloc.targetDomain == functionReloc.targetDomain &&
           recipeReloc.targetRow == functionReloc.targetRow &&
           layout.FixedBytes32Equal(
               recipeReloc.targetInterfaceCid,
               functionReloc.targetInterfaceCid) &&
           fragmentReloc.targetDomain == functionReloc.targetDomain &&
           fragmentReloc.targetRow == functionReloc.targetRow &&
           layout.FixedBytes32Equal(
               fragmentReloc.targetInterfaceCid,
               functionReloc.targetInterfaceCid),
           " call identity three copies")
    assert(emitter.RegallocProductionEmissionRelocsMatchBodyIr(
               artifacts.RegallocProductionTargetRv64Linux,
               body, callTargets, emission.recipes),
           " call identity body projection")

    let consistentRow = emission.recipes.functionRelocs[0].targetRow
    emission.recipes.functionRelocs[0].targetRow = consistentRow + 1
    emission.recipes.recipes[recipeIndex].relocs[0].targetRow =
        consistentRow + 1
    emission.recipes.machineFragments[fragmentIndex].relocs[0].targetRow =
        consistentRow + 1
    assert(artifacts.RegallocProductionMachineRecipeProofBuild(
               emission.plan, emission.recipes).valid &&
           !emitter.RegallocProductionEmissionRelocsMatchBodyIr(
               artifacts.RegallocProductionTargetRv64Linux,
               body, callTargets, emission.recipes),
           " call identity consistent row mutation")
    emission.recipes.functionRelocs[0].targetRow = consistentRow
    emission.recipes.recipes[recipeIndex].relocs[0].targetRow = consistentRow
    emission.recipes.machineFragments[fragmentIndex].relocs[0].targetRow =
        consistentRow

    let consistentCidByte =
        emission.recipes.functionRelocs[0].targetInterfaceCid.data[0]
    let mutatedCidByte = uint8(Int32(consistentCidByte) ^ 1)
    emission.recipes.functionRelocs[0].targetInterfaceCid.data[0] =
        mutatedCidByte
    emission.recipes.recipes[
        recipeIndex].relocs[0].targetInterfaceCid.data[0] = mutatedCidByte
    emission.recipes.machineFragments[
        fragmentIndex].relocs[0].targetInterfaceCid.data[0] = mutatedCidByte
    assert(artifacts.RegallocProductionMachineRecipeProofBuild(
               emission.plan, emission.recipes).valid &&
           !emitter.RegallocProductionEmissionRelocsMatchBodyIr(
               artifacts.RegallocProductionTargetRv64Linux,
               body, callTargets, emission.recipes),
           " call identity consistent CID mutation")
    emission.recipes.functionRelocs[0].targetInterfaceCid.data[0] =
        consistentCidByte
    emission.recipes.recipes[
        recipeIndex].relocs[0].targetInterfaceCid.data[0] = consistentCidByte
    emission.recipes.machineFragments[
        fragmentIndex].relocs[0].targetInterfaceCid.data[0] =
            consistentCidByte

    let domain = emission.recipes.functionRelocs[0].targetDomain
    emission.recipes.functionRelocs[0].targetDomain = domain + 1
    assert(!artifacts.RegallocProductionMachineRecipeProofBuild(
               emission.plan, emission.recipes).valid,
           " call identity domain mutation")
    emission.recipes.functionRelocs[0].targetDomain = domain
    let row = emission.recipes.functionRelocs[0].targetRow
    emission.recipes.functionRelocs[0].targetRow = row + 1
    assert(!artifacts.RegallocProductionMachineRecipeProofBuild(
               emission.plan, emission.recipes).valid,
           " call identity row mutation")
    emission.recipes.functionRelocs[0].targetRow = row
    let cidByte =
        emission.recipes.functionRelocs[0].targetInterfaceCid.data[0]
    emission.recipes.functionRelocs[0].targetInterfaceCid.data[0] =
        uint8(Int32(cidByte) ^ 1)
    assert(!artifacts.RegallocProductionMachineRecipeProofBuild(
               emission.plan, emission.recipes).valid,
           " call identity CID mutation")
    emission.recipes.functionRelocs[0].targetInterfaceCid.data[0] = cidByte
    emission.recipes.functionRelocs[0].targetSymbol = "wrong_payload"
    assert(!artifacts.RegallocProductionMachineRecipeProofBuild(
               emission.plan, emission.recipes).valid,
           " call identity payload mutation")
    emission.recipes.functionRelocs[0].targetSymbol =
        "exact_materialized_callee"
    emission.recipes.functionRelocs[0].targetSymbol = "wrong_payload"
    emission.recipes.recipes[recipeIndex].relocs[0].targetSymbol =
        "wrong_payload"
    emission.recipes.machineFragments[
        fragmentIndex].relocs[0].targetSymbol = "wrong_payload"
    assert(!emitter.RegallocProductionEmissionRelocsMatchBodyIr(
               artifacts.RegallocProductionTargetRv64Linux,
               body, callTargets, emission.recipes),
           " call identity full payload projection mutation")
    emission.recipes.functionRelocs[0].targetSymbol =
        "exact_materialized_callee"
    emission.recipes.recipes[recipeIndex].relocs[0].targetSymbol =
        "exact_materialized_callee"
    emission.recipes.machineFragments[
        fragmentIndex].relocs[0].targetSymbol =
            "exact_materialized_callee"

    emission.recipes.functionRelocs[0].kind =
        contract.RegallocA64RelocPage21
    emission.recipes.functionRelocs[0].callOrdinal = -1
    emission.recipes.functionRelocs[0].subIndex = 0
    emission.recipes.recipes[recipeIndex].relocs[0].kind =
        contract.RegallocA64RelocPage21
    emission.recipes.recipes[recipeIndex].relocs[0].callOrdinal = -1
    emission.recipes.recipes[recipeIndex].relocs[0].subIndex = 0
    emission.recipes.machineFragments[fragmentIndex].relocs[0].kind =
        contract.RegallocA64RelocPage21
    emission.recipes.machineFragments[
        fragmentIndex].relocs[0].callOrdinal = -1
    emission.recipes.machineFragments[fragmentIndex].relocs[0].subIndex = 0
    assert(!artifacts.RegallocProductionMachineRecipeProofBuild(
               emission.plan, emission.recipes).valid,
           " non-call identity sentinel mutation")
    echo("riscv_call_identity_receipt_smoke=pass")
    return 0
