import cheng/tests/cold_aggregate_field_store_left as left
import cheng/tests/cold_aggregate_field_store_right as right

type
    ColdAggregateQualifiedConstructorNegative =
        payload: left.AggregateIdentity

fn main(): int32 =
    let holder = ColdAggregateQualifiedConstructorNegative(
        payload: right.AggregateIdentity(label: "wrong", values: [1, 2, 3, 4]))
    if holder.payload.label == "wrong":
        return 0
    return 1
