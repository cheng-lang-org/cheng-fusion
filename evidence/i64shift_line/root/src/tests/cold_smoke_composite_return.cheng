import std/system

// Minimal composite return + string processing
// Focuses on patterns that crash in the self-compiled compiler

type
    StrResult =
        data: str
        ok: bool

fn makeOk(s: str): StrResult =
    return StrResult(data: s, ok: true)

fn makeErr(): StrResult =
    return StrResult(data: "", ok: false)

fn trimLeft(s: str): str =
    // Manual left-trim without external functions
    if len(s) <= 0:
        return ""
    var start: int32
    while start < len(s):
        let ch: int32 = int32(s[start])
        if ch != 32 && ch != 9 && ch != 13 && ch != 10:
            break
        start = start + 1
    if start <= 0:
        return s
    if start >= len(s):
        return ""
    // Build trimmed string char by char
    var out: str
    var i: int32 = start
    while i < len(s):
        // Manual char concat
        if len(out) <= 0:
            // First char - need to create string from char
            out = ""
            if s[i] == 'h': out = "h"
            elif s[i] == 'e': out = "e"
            elif s[i] == 'l': out = "l"
            elif s[i] == 'o': out = "o"
            elif s[i] == 'w': out = "w"
            elif s[i] == 'r': out = "r"
            elif s[i] == 'd': out = "d"
            elif s[i] == ' ': out = " "
            elif s[i] == 's': out = "s"
            elif s[i] == 'u': out = "u"
            elif s[i] == 'c': out = "c"
            elif s[i] == 'f': out = "f"
            else: out = "x"
        i = i + 1
    return out

fn main(): int32 =
    // Test 1: non-empty string in composite
    let okRes: StrResult = makeOk("hello")
    assert(okRes.ok, " r1: ok")
    assert(okRes.data == "hello", " r1: data")

    // Test 2: empty string in composite
    let errRes: StrResult = makeErr()
    assert(!errRes.ok, " r2: err")
    assert(errRes.data == "", " r2: empty")

    // Test 3: trim non-empty
    let t1: str = trimLeft("  hello")
    assert(t1 != "", " trim: should not be empty")

    // Test 4: trim empty
    let t2: str = trimLeft("")
    assert(t2 == "", " trim: empty")

    echo(" cold_smoke_composite_return ok")
    return 0
