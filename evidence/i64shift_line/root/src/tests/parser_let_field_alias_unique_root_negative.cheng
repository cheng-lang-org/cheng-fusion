type
    ParserAliasNegativeOrigins =
        values: int32[]

    ParserAliasNegativeTree = ref object
        importOrigins: ParserAliasNegativeOrigins

fn ParserAliasNegativeAppend(values: var int32[]) =
    add(values, 7)

fn ParserAliasNegativeMutate(tree: var ParserAliasNegativeTree) =
    let origins = tree.importOrigins
    ParserAliasNegativeAppend(origins.values)

fn main(): int32 =
    var tree = new(ParserAliasNegativeTree)
    ParserAliasNegativeMutate(tree)
    return 0
