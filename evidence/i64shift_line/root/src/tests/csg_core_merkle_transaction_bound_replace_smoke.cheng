import std/os
import std/rawbytes
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_admission as admission
import cheng/core/csg_core/merkle_transaction_operation as operation

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn main(): int32 =
    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let beforeModule =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    let afterModule =
        "{\"id\":\"mod_a\",\"kind\":\"csg.module\",\"path\":\"a.cheng\",\"sha256\":\"sha256:bbb\"}"
    var beforeFacts = [
        strings.CloneStr(schema),
        strings.CloneStr(beforeModule)]
    var issued = admission.CsgCoreMerkleSealBeforeAuthority(
        beforeFacts, afterModule, "id:mod_a")
    var encoded =
        operation.CsgCoreMerkleTransactionOperationBuildSealedReplace(
            issued.candidate)
    if !issued.ok || !issued.candidate.replay.ok || !encoded.ok ||
       issued.candidate.replay.canonicalFact != afterModule ||
       issued.candidate.replay.nodes.len !=
           issued.candidate.proof.splitBits.len + 1 ||
       issued.candidate.replay.rebuiltNodeCount !=
           int64(issued.candidate.replay.nodes.len) ||
       encoded.operation.beforeFact != beforeModule ||
       encoded.operation.afterFact != afterModule ||
       encoded.operation.fact != encoded.operation.afterFact ||
       encoded.operation.beforeFactsRoot !=
           issued.candidate.beforeFactsRoot ||
       encoded.operation.afterFactsRoot !=
           issued.candidate.replay.afterFactsRoot ||
       encoded.operation.afterDagRootCid !=
           issued.candidate.replay.afterDagRootCid ||
       encoded.operation.beforeProfileSetCid !=
           encoded.operation.afterProfileSetCid:
        return fail("sealed module replace did not match replay")
    var decoded =
        operation.CsgCoreMerkleTransactionOperationDecode(encoded.bytes)
    if !decoded.ok || decoded.cid != encoded.cid ||
       !rawbytes.BytesEqual(decoded.bytes, encoded.bytes) ||
       decoded.operation.beforeFact != beforeModule ||
       decoded.operation.afterFact != afterModule ||
       decoded.operation.afterFactsRoot !=
           issued.candidate.replay.afterFactsRoot:
        return fail("sealed operation did not decode byte-exactly")

    var permutedBefore = [
        strings.CloneStr(beforeModule),
        strings.CloneStr(schema)]
    var permuted = admission.CsgCoreMerkleSealBeforeAuthority(
        permutedBefore, afterModule, "id:mod_a")
    var permutedEncoded =
        operation.CsgCoreMerkleTransactionOperationBuildSealedReplace(
            permuted.candidate)
    if !permuted.ok || !permutedEncoded.ok ||
       permuted.candidate.beforeFactsRoot !=
           issued.candidate.beforeFactsRoot ||
       permuted.candidate.beforeDagRootCid !=
           issued.candidate.beforeDagRootCid ||
       permuted.candidate.beforeCsgcDirectoryCid !=
           issued.candidate.beforeCsgcDirectoryCid ||
       permuted.candidate.beforeCsgcObjectCid !=
           issued.candidate.beforeCsgcObjectCid ||
       permuted.candidate.replay.afterFactsRoot !=
           issued.candidate.replay.afterFactsRoot ||
       !rawbytes.BytesEqual(permutedEncoded.bytes, encoded.bytes) ||
       !rawbytes.BytesEqual(
           permutedEncoded.proofBytes, encoded.proofBytes):
        return fail("sealed replace was not byte-unique")

    let nonCanonicalModule =
        "{\"kind\":\"csg.module\",\"id\":\"mod_a\",\"path\":\"a.cheng\",\"sha256\":\"sha256:aaa\"}"
    var nonCanonicalBefore = [
        strings.CloneStr(schema),
        strings.CloneStr(nonCanonicalModule)]
    let nonCanonical = admission.CsgCoreMerkleSealBeforeAuthority(
        nonCanonicalBefore, afterModule, "id:mod_a")
    if nonCanonical.ok ||
       !strings.StrContains(nonCanonical.error, "admission_failed"):
        return fail("non-canonical before CSGC was sealed")
    var incompleteBefore = [strings.CloneStr(beforeModule)]
    let incomplete = admission.CsgCoreMerkleSealBeforeAuthority(
        incompleteBefore, afterModule, "id:mod_a")
    if incomplete.ok ||
       !strings.StrContains(incomplete.error, "admission_failed"):
        return fail("incomplete before CSGC was sealed")

    var beforeCsgc = csgc.CsgCoreCsgcEncodeCanonicalLines(beforeFacts)
    var reversedBeforeCsgc =
        csgc.CsgCoreCsgcEncodeCanonicalLines(permutedBefore)
    if !beforeCsgc.ok || !reversedBeforeCsgc.ok ||
       !rawbytes.BytesEqual(beforeCsgc.bytes, reversedBeforeCsgc.bytes) ||
       beforeCsgc.claimedDirectoryCid !=
           issued.candidate.beforeCsgcDirectoryCid:
        return fail("same facts did not produce unique CSGC bytes")

    let crossKind =
        "{\"file\":\"pkg://cheng/main.cheng\",\"id\":\"mod_a\",\"kind\":\"csg.symbol\",\"name\":\"main\",\"symbol\":\"main\",\"symbolKind\":\"fn\"}"
    let crossKindResult = admission.CsgCoreMerkleSealBeforeAuthority(
        beforeFacts, crossKind, "id:mod_a")
    if crossKindResult.ok ||
       !strings.StrContains(crossKindResult.error, "kind_mismatch"):
        return fail("cross-kind same-id replace was sealed")

    var legacy = operation.CsgCoreMerkleTransactionOperationBuild(
        operation.CsgCoreMerkleTransactionReplaceKind(),
        issued.candidate.proof,
        issued.candidate.beforeFactsRoot,
        issued.candidate.proof.profiles,
        afterModule)
    if legacy.ok || legacy.error !=
       "merkle_transaction_operation_legacy_build_disabled":
        return fail("legacy operation builder was not disabled")
    var proofOnly =
        operation.CsgCoreMerkleTransactionOperationBuildReplaceBound(
            issued.candidate.proof,
            issued.candidate.beforeFactsRoot,
            beforeModule,
            afterModule)
    if proofOnly.ok || proofOnly.error !=
       "merkle_transaction_operation_requires_admitted_delta":
        return fail("proof-only bound builder was not disabled")

    var live = issued.live
    issued.live = admission.CsgCoreMerkleSealedBeforeLiveToken()
    let terminal = admission.CsgCoreMerkleSealedBeforeLivePoison(live)
    var permutedLive = permuted.live
    permuted.live = admission.CsgCoreMerkleSealedBeforeLiveToken()
    let permutedTerminal =
        admission.CsgCoreMerkleSealedBeforeLivePoison(permutedLive)
    if !terminal.ok || !terminal.poisoned ||
       !permutedTerminal.ok || !permutedTerminal.poisoned:
        return fail("sealed test authority was not terminal")

    rawbytes.BytesFree(encoded.bytes)
    rawbytes.BytesFree(encoded.proofBytes)
    rawbytes.BytesFree(decoded.bytes)
    rawbytes.BytesFree(permutedEncoded.bytes)
    rawbytes.BytesFree(permutedEncoded.proofBytes)
    rawbytes.BytesFree(beforeCsgc.bytes)
    rawbytes.BytesFree(reversedBeforeCsgc.bytes)
    os.WriteLine(
        os.Get_stdout(),
        "csg_core_merkle_transaction_bound_replace_smoke ok")
    return 0
