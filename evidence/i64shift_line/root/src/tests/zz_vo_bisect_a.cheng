import std/rawbytes
import std/result

const
    tmpMaxMessages: int32 = 8

type
    TmpItem =
        kind: int32
        body: Bytes
        raw: Bytes

    TmpList =
        count: int32
        items: TmpItem[8]

fn tmpItemFresh(): TmpItem =
    var out: TmpItem
    out.kind = 0
    out.body = emptyBytes()
    out.raw = emptyBytes()
    return out

fn tmpListInto(out: var TmpList) =
    for i in 0..<8:
        out.items[i] = tmpItemFresh()
    out.count = 0

@borrows
fn tmpItemCopyInto(out: var TmpItem,
                   src: TmpItem) =
    out.kind = src.kind
    out.body = BytesSlice(src.body, 0, BytesLen(src.body))
    out.raw = BytesSlice(src.raw, 0, BytesLen(src.raw))

@borrows
fn tmpListAdd(messages: var TmpList,
              msg: var TmpItem
): Result[bool] =
    let countNow: int32 = messages.count
    if countNow >= tmpMaxMessages:
        return Err[bool]("tls13: handshake message buffer full")
    let idx: int32 = countNow
    tmpItemCopyInto(messages.items[idx], msg)
    messages.count = countNow + 1
    return Ok[bool](true)
