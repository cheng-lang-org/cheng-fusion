import std/system

type
    ManagedSequenceRow =
        value: int32

fn main(): int32 =
    var ints: int32[]
    add(ints, 7)
    if memRefCount(ints.buffer) != 1:
        return 1

    var texts: str[]
    add(texts, "managed")
    if memRefCount(texts.buffer) != 1:
        return 2

    var row: ManagedSequenceRow
    row.value = 9
    var rows: ManagedSequenceRow[]
    add(rows, row)
    if memRefCount(rows.buffer) != 1:
        return 3

    var resized: int32[]
    setLen(resized, 8)
    if memRefCount(resized.buffer) != 1:
        return 4
    return 0
