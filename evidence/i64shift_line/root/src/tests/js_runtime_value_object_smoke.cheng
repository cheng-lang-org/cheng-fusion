import cheng/core/runtime/js_runtime as jsrt

fn runJsValuePrimitiveSmoke(): int32 =
    var undefinedValue: jsrt.JsValue
    jsrt.JsValueInitUndefined(undefinedValue)
    if !jsrt.JsValueIsUndefined(undefinedValue):
        return 1

    var intValue: jsrt.JsValue
    jsrt.JsValueInitInt32(intValue, 42)
    if !jsrt.JsValueIsInt32(intValue):
        return 2
    if jsrt.JsValueInt32(intValue) != 42:
        return 3

    var stringValue: jsrt.JsValue
    jsrt.JsValueInitString(stringValue, "ok")
    if !jsrt.JsValueIsString(stringValue):
        return 4
    if jsrt.JsValueString(stringValue) != "ok":
        return 5

    return 0

fn runJsStringRegexSmoke(): int32 =
    var normalized: str
    if !jsrt.JsStringReplaceAsciiClassRegex("speech error!", "[^a-z0-9]+", "_", normalized):
        return 10
    if normalized != "speech_error_":
        return 11

    if !jsrt.JsStringReplaceAsciiClassRegex("alpha   beta\tgamma", "\\s+", " ", normalized):
        return 12
    if normalized != "alpha beta gamma":
        return 13

    if !jsrt.JsStringReplaceAsciiClassRegex("a1-b2", "\\D", "", normalized):
        return 14
    if normalized != "12":
        return 15

    var parts: jsrt.JsArray
    if !jsrt.JsStringSplitAsciiClassRegex("v1.2-3", "[^0-9]+", parts):
        return 16
    if jsrt.JsArrayLength(parts) != 4:
        return 17
    var part: jsrt.JsValue
    if !jsrt.JsArrayGetJsValue(parts, 0, part):
        return 18
    if !jsrt.JsValueIsString(part) || jsrt.JsValueString(part) != "":
        return 19
    if !jsrt.JsArrayGetJsValue(parts, 3, part):
        return 20
    if !jsrt.JsValueIsString(part) || jsrt.JsValueString(part) != "3":
        return 21

    return 0

fn main(): int32 =
    var code = runJsValuePrimitiveSmoke()
    if code != 0:
        echo(Fmt"FAIL runJsValuePrimitiveSmoke: {code}")
        return code
    code = runJsStringRegexSmoke()
    if code != 0:
        echo(Fmt"FAIL runJsStringRegexSmoke: {code}")
        return code
    echo(" js_runtime_value_object_assertions=primitive/string_regex")
    echo(" js_runtime_value_object_smoke ok")
    return 0
