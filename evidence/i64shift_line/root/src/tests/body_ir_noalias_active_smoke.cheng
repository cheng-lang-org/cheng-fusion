import std/strutils as strutil
import cheng/core/backend/lowering_plan as lower
import cheng/core/backend/primary_object_plan as pobj
import cheng/core/ir/core_types as ir
import cheng/core/ir/body_ir_egraph as egraph
import cheng/core/lang/typed_expr as texpr

fn check(cond: bool, code: int32) =
    assert(cond, Fmt" smoke contract check failed {code}")

fn addI32Slot(bodyIR: var ir.BodyIR,
              name: str): int32 =
    var slot: ir.LocalSlot
    slot.id = bodyIR.localSlots.len
    slot.name = name
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + slot.id * 8
    slot.sizeBytes = 4
    slot.alignBytes = 4
    slot.noAlias = true
    add(bodyIR.localSlots, slot)
    return slot.id

fn addI32MayAliasSlot(bodyIR: var ir.BodyIR,
                      name: str): int32 =
    var slot: ir.LocalSlot
    slot.id = bodyIR.localSlots.len
    slot.name = name
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + slot.id * 8
    slot.sizeBytes = 4
    slot.alignBytes = 4
    slot.noAlias = false
    add(bodyIR.localSlots, slot)
    return slot.id

fn buildForwardBody(): ir.BodyIR =
    var bodyIR = ir.BodyIRNew()
    let a = addI32Slot(bodyIR, "a")
    let b = addI32Slot(bodyIR, "b")
    let c = addI32Slot(bodyIR, "c")

    var loadB: ir.BodyOp
    loadB.kind = ir.BodyOpLoadLocalTag
    loadB.target = b
    add(loadB.operands, a)
    add(bodyIR.ops, loadB)

    var copyC: ir.BodyOp
    copyC.kind = ir.BodyOpCopyLocalTag
    copyC.target = c
    add(copyC.operands, b)
    add(bodyIR.ops, copyC)

    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = c
    let termIndex = ir.BodyIRAppendTerm(bodyIR, term)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 2, termIndex)
    return bodyIR

fn appendLoadConst(bodyIR: var ir.BodyIR,
                   target: int32,
                   value: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadConstTag
    op.target = target
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, value)
    add(bodyIR.ops, op)

fn appendI32Add(bodyIR: var ir.BodyIR,
                 target: int32,
                 lhs: int32,
                 rhs: int32) =
    var op: ir.BodyOp
    op.kind = ir.BodyOpBinOpTag
    op.target = target
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, int32(texpr.TypedExprIrOpI32Add))
    add(op.operands, lhs)
    add(op.operands, rhs)
    add(bodyIR.ops, op)

fn collectEGraphSnapshotText(bodyIR: ir.BodyIR): str =
    var rows: str[]
    for opIndex in 0..<bodyIR.ops.len:
        let op = bodyIR.ops[opIndex]
        let count = op.operands.len
        var op0: int32
        var op1: int32
        var op2: int32
        var op3: int32
        var op4: int32
        var op5: int32
        var op6: int32
        var op7: int32
        if count >= 1:
            op0 = op.operands[0]
        if count >= 2:
            op1 = op.operands[1]
        if count >= 3:
            op2 = op.operands[2]
        if count >= 4:
            op3 = op.operands[3]
        if count >= 5:
            op4 = op.operands[4]
        if count >= 6:
            op5 = op.operands[5]
        if count >= 7:
            op6 = op.operands[6]
        if count >= 8:
            op7 = op.operands[7]
        add(rows, Fmt"{op.kind},{op.target},{count},{op0},{op1},{op2},{op3},{op4},{op5},{op6},{op7};")
    return strutil.Join(rows, "")

fn buildEGraphCandidateBody(): ir.BodyIR =
    var bodyIR = ir.BodyIRNew()
    var slotNames: str[]
    let value = pobj.PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                     slotNames,
                                                     "value",
                                                     ir.LocalI32Tag,
                                                     41)
    let zero = pobj.PrimaryBodyIrLocalInitConstSlot(bodyIR,
                                                    slotNames,
                                                    "zero",
                                                    ir.LocalI32Tag,
                                                    0)
    let sum = pobj.PrimaryBodyIrFindOrCreateSlot(bodyIR,
                                                 slotNames,
                                                 "sum",
                                                 ir.LocalI32Tag)
    appendI32Add(bodyIR, sum, value, zero)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = sum
    let termIndex = ir.BodyIRAppendTerm(bodyIR, term)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 3, termIndex)
    return bodyIR

fn buildEGraphLoadSkipBody(): ir.BodyIR =
    var bodyIR = ir.BodyIRNew()
    let a = addI32Slot(bodyIR, "a")
    let b = addI32Slot(bodyIR, "b")
    var loadB: ir.BodyOp
    loadB.kind = ir.BodyOpLoadLocalTag
    loadB.target = b
    add(loadB.operands, a)
    add(bodyIR.ops, loadB)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = b
    let termIndex = ir.BodyIRAppendTerm(bodyIR, term)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 1, termIndex)
    return bodyIR

fn buildEGraphEscapedSkipBody(): ir.BodyIR =
    var bodyIR = ir.BodyIRNew()
    let escaped = addI32Slot(bodyIR, "escaped")
    bodyIR.localSlots[escaped].escapeKind = 2
    appendLoadConst(bodyIR, escaped, 7)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = escaped
    let termIndex = ir.BodyIRAppendTerm(bodyIR, term)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 1, termIndex)
    return bodyIR

fn buildEGraphMayAliasSkipBody(): ir.BodyIR =
    var bodyIR = ir.BodyIRNew()
    let value = addI32MayAliasSlot(bodyIR, "value")
    let zero = addI32MayAliasSlot(bodyIR, "zero")
    let sum = addI32MayAliasSlot(bodyIR, "sum")
    appendLoadConst(bodyIR, value, 41)
    appendLoadConst(bodyIR, zero, 0)
    appendI32Add(bodyIR, sum, value, zero)
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = sum
    let termIndex = ir.BodyIRAppendTerm(bodyIR, term)
    let _ = ir.BodyIRAppendBlock(bodyIR, 0, 3, termIndex)
    return bodyIR

fn main(): int32 =
    var fnIr: lower.PrimaryObjectIrFunction
    fnIr.functionName = "NoAliasActiveFixture"
    fnIr.bodyKind = "statement_sequence"
    fnIr.bodyIR = buildForwardBody()

    lower.LoweringFinalizeBodyIrNoAlias(fnIr)

    check(fnIr.bodyIrNoAliasApplied, 11)
    check(fnIr.bodyIrNoAliasLocalCount == 2, 12)
    check(fnIr.bodyIrNoAliasForwardRewriteCount == 2, 13)
    check(fnIr.bodyIR.ops[1].operands[0] == 0, 14)
    check(fnIr.bodyIR.terms[0].resultSlot == 0, 15)
    var activeIr: lower.PrimaryObjectIr
    add(activeIr.functions, fnIr)
    let report = lower.LoweringPrimaryObjectIrReportText(activeIr)
    check(strutil.Contains(report, "primary_object_ir_noalias_applied_flags=1"), 16)
    check(strutil.Contains(report, "primary_object_ir_noalias_local_counts=2"), 17)
    check(strutil.Contains(report, "primary_object_ir_noalias_forward_rewrite_counts=2"), 18)
    var brokenFn: lower.PrimaryObjectIrFunction
    brokenFn.functionName = "NoAliasBrokenFixture"
    brokenFn.bodyKind = "statement_sequence"
    var brokenBody = buildForwardBody()
    brokenBody.localSlots = []
    brokenFn.bodyIR = brokenBody
    lower.LoweringFinalizeBodyIrNoAlias(brokenFn)
    check(!brokenFn.bodyIrNoAliasApplied, 19)
    check(brokenFn.bodyKind == "body_ir_dod_soa_contract_invalid", 20)
    var egraphCandidate = buildEGraphCandidateBody()
    if egraphCandidate.ops[0].operands.len < 2:
        return 240
    var egraphCandidateFlat = ir.BodyIRFlattenSoA(egraphCandidate)
    if egraphCandidateFlat.opOperandCounts[0] < 2:
        return 241
    let directSnapshotText = collectEGraphSnapshotText(egraphCandidate)
    let directEGraphResult = egraph.BodyIrEgraphPassWithSnapshotTextResult(egraphCandidate,
                                                                           directSnapshotText)
    if !directEGraphResult.applied:
        if directEGraphResult.skipped:
            if directEGraphResult.blockCount <= 0:
                return 245
            if directEGraphResult.skippedBlockCount > 0:
                if directEGraphResult.blockedReason == "unsupported_load_const":
                    return 246
                if directEGraphResult.blockedReason == "unsupported_binop":
                    return 247
                return 248
            return 242
        if directEGraphResult.hardFail:
            return 243
        return 244
    var egraphHotCandidate = buildEGraphCandidateBody()
    let egraphHot = pobj.PrimaryBodyIrHotPathApply(egraphHotCandidate)
    if !egraphHot.eGraphApplied:
        if egraphHot.eGraphHardFail:
            return 211
        if egraphHot.eGraphSkipped:
            if egraphHot.eGraphBlockCount <= 0:
                return 221
            if egraphHot.eGraphSkippedBlockCount > 0:
                if egraphHot.eGraphReason == "ptr_local":
                    return 224
                if egraphHot.eGraphReason == "escaped_mutable_local":
                    return 225
                if egraphHot.eGraphReason == "load":
                    return 226
                if egraphHot.eGraphReason == "store":
                    return 227
                if egraphHot.eGraphReason == "unsupported_op":
                    return 228
                if egraphHot.eGraphReason == "unsupported_load_const":
                    return 230
                if egraphHot.eGraphReason == "unsupported_binop":
                    return 231
                if egraphHot.eGraphReason == "unsupported_cmp":
                    return 232
                if egraphHot.eGraphReason == "no_pure_integer_ops":
                    return 229
                return 223
            if egraphHot.eGraphCandidateBlockCount <= 0:
                return 222
            return 212
        if egraphHot.eGraphRuleHitCount <= 0:
            return 213
    check(egraphHot.eGraphApplied, 21)
    check(egraphHot.eGraphChangedBlockCount == 1, 22)
    check(egraphHot.eGraphRuleHitCount > 0, 23)
    check(egraphHot.bodyIR.terms[0].resultSlot == 0, 24)
    check(egraphHot.bodyIR.ops.len < 3, 25)
    check(egraphHot.eGraphClassCount > 0, 251)
    check(egraphHot.eGraphRoundCount > 0, 252)
    check(egraphHot.eGraphExtractedCount > 0, 253)
    check(egraphHot.eGraphMs >= 0, 254)
    var egraphLoadSkipBody = buildEGraphLoadSkipBody()
    let egraphLoadSkip = pobj.PrimaryBodyIrHotPathApply(egraphLoadSkipBody)
    check(!egraphLoadSkip.eGraphApplied, 26)
    check(egraphLoadSkip.eGraphSkipped, 27)
    check(egraphLoadSkip.eGraphSkippedBlockCount == 1, 28)
    check(egraphLoadSkip.eGraphReason == "load", 29)
    var egraphEscapedSkipBody = buildEGraphEscapedSkipBody()
    let egraphEscapedSkip = pobj.PrimaryBodyIrHotPathApply(egraphEscapedSkipBody)
    check(!egraphEscapedSkip.eGraphApplied, 30)
    check(egraphEscapedSkip.eGraphSkipped, 31)
    check(egraphEscapedSkip.eGraphReason == "escaped_mutable_local", 32)
    var egraphMayAliasSkipBody = buildEGraphMayAliasSkipBody()
    let egraphMayAliasSkip = pobj.PrimaryBodyIrHotPathApply(egraphMayAliasSkipBody)
    check(!egraphMayAliasSkip.eGraphApplied, 321)
    check(egraphMayAliasSkip.eGraphSkipped, 322)
    check(egraphMayAliasSkip.eGraphReason == "may_alias_local", 323)
    var plan: pobj.PrimaryObjectPlan
    plan.bodyIRNoAliasFunctionCount = 1
    plan.bodyIRNoAliasAppliedFunctionCount = 1
    plan.bodyIRNoAliasLocalCount = 2
    plan.bodyIRNoAliasForwardRewriteCount = 2
    plan.bodyIRNoAliasDodSoAAllOk = true
    plan.bodyIRPhaseArenaResetCount = 3
    plan.bodyIRPhaseArenaPeakBytes = int64(128)
    plan.bodyIRPhaseArenaSpillCount = 0
    plan.bodyIREGraphFunctionCount = 1
    plan.bodyIREGraphAppliedFunctionCount = 1
    plan.bodyIREGraphBlockCount = egraphHot.eGraphBlockCount
    plan.bodyIREGraphCandidateBlockCount = egraphHot.eGraphCandidateBlockCount
    plan.bodyIREGraphChangedBlockCount = egraphHot.eGraphChangedBlockCount
    plan.bodyIREGraphClassCount = egraphHot.eGraphClassCount
    plan.bodyIREGraphRoundCount = egraphHot.eGraphRoundCount
    plan.bodyIREGraphRuleHitCount = egraphHot.eGraphRuleHitCount
    plan.bodyIREGraphExtractedCount = egraphHot.eGraphExtractedCount
    plan.bodyIREGraphOpDelta = egraphHot.eGraphOpDelta
    plan.bodyIREGraphMs = egraphHot.eGraphMs
    plan.bodyIREGraphReason = "load"
    let primaryReport = pobj.PrimaryObjectPlanBodyIrEGraphReport(plan)
    check(strutil.Contains(primaryReport, "primary_object_body_ir_egraph_applied_function_count=1"), 33)
    check(strutil.Contains(primaryReport, "primary_object_body_ir_egraph_changed_block_count=1"), 34)
    check(strutil.Contains(primaryReport, "primary_object_body_ir_egraph_reason=load"), 35)
    check(strutil.Contains(primaryReport, "primary_object_body_ir_egraph_class_count="), 36)
    check(strutil.Contains(primaryReport, "primary_object_body_ir_egraph_round_count="), 37)
    check(strutil.Contains(primaryReport, "primary_object_body_ir_egraph_extracted_count="), 38)
    check(strutil.Contains(primaryReport, "primary_object_body_ir_egraph_ms="), 39)
    check(strutil.Contains(primaryReport, "egraph_classes="), 40)
    check(strutil.Contains(primaryReport, "egraph_rounds="), 41)
    check(strutil.Contains(primaryReport, "rule_hits="), 42)
    check(strutil.Contains(primaryReport, "extracted="), 43)
    check(strutil.Contains(primaryReport, "op_delta="), 44)
    check(strutil.Contains(primaryReport, "egraph_ms="), 45)
    let fullPrimaryReport = pobj.PrimaryObjectPlanReport(plan)
    check(strutil.Contains(fullPrimaryReport, "primary_object_body_ir_flat_soa_emit_function_count=0"), 46)
    check(strutil.Contains(fullPrimaryReport, "body_ir_phase_arena_peak_bytes=128"), 47)
    check(strutil.Contains(fullPrimaryReport, "body_ir_phase_arena_reset_count=3"), 48)
    check(strutil.Contains(fullPrimaryReport, "body_ir_phase_arena_spill_count=0"), 49)
    check(strutil.Contains(fullPrimaryReport, "phase_arena_peak_bytes=128"), 50)
    echo(" body_ir_noalias_active_smoke ok")
    return 0
