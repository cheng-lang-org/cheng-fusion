import cheng/core/ir/core_types as ir
import cheng/tests/noalias_finalize_stage_probe_lib as probe

fn ProbeAssignBodyIr(out: var ir.BodyIR, src: ir.BodyIR) =
    out = src
    return

fn main(): int32 =
    var bodyIR = ir.BodyIRNew()
    let src = probe.ProbeForwardBody(true)
    ProbeAssignBodyIr(bodyIR, src)
    return 77
