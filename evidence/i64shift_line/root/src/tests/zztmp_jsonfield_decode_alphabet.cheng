import std/rawbytes
import std/strings
import cheng/std/bytes_layout as layout
import cheng/core/csg_core/json_field as field

fn expectBytes(bs: int32[]): str =
    var buf = layout.ByteBufInit(bs.len)
    for i in 0..<bs.len:
        layout.ByteBufAppendByte(buf, bs[i])
    var bytes = layout.ByteBufToBytes(buf)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    layout.ByteBufFree(buf)
    return out

fn expectFound(json: str, expected: str, code: int32): int32 =
    let result = field.CsgCoreJsonTopStringField(json, "m")
    if !result.found:
        return code
    if result.value != expected:
        return code + 100
    return 0

fn expectMissing(json: str, code: int32): int32 =
    let result = field.CsgCoreJsonTopStringField(json, "m")
    if result.found:
        return code
    return 0

fn main(): int32 =
    var rc = expectFound("{\"m\":\"a\\bc\"}", expectBytes([97, 8, 99]), 1)
    if rc != 0:
        return rc
    rc = expectFound("{\"m\":\"a\\fc\"}", expectBytes([97, 12, 99]), 2)
    if rc != 0:
        return rc
    rc = expectFound(
        "{\"m\":\"\\u001f\\u000b\\u0000end\"}",
        expectBytes([31, 11, 0, 101, 110, 100]), 3)
    if rc != 0:
        return rc
    rc = expectFound(
        "{\"m\":\"q\\\"w\\\\e\\/r\\bt\\nu\\fv\\rx\\u001fy\"}",
        expectBytes([113, 34, 119, 92, 101, 47, 114, 8, 116,
                     10, 117, 12, 118, 13, 120, 31, 121]), 4)
    if rc != 0:
        return rc
    rc = expectFound("{\"m\":\"\"}", "", 5)
    if rc != 0:
        return rc
    rc = expectFound("{\"m\":\"aéz\"}", "aéz", 6)
    if rc != 0:
        return rc

    rc = expectMissing("{\"m\":\"a\\u0041b\"}", 7)
    if rc != 0:
        return rc
    rc = expectMissing("{\"m\":\"a\\u0008b\"}", 8)
    if rc != 0:
        return rc
    rc = expectMissing("{\"m\":\"a\\u00x1b\"}", 9)
    if rc != 0:
        return rc
    rc = expectMissing("{\"m\":\"a\\u0100b\"}", 10)
    if rc != 0:
        return rc
    rc = expectMissing("{\"m\":\"a\\u001Fb\"}", 11)
    if rc != 0:
        return rc
    rc = expectMissing("{\"m\":\"a\\qb\"}", 12)
    if rc != 0:
        return rc

    var rawBuf = layout.ByteBufInit(16)
    layout.ByteBufAppendByte(rawBuf, 123)
    layout.ByteBufAppendByte(rawBuf, 34)
    layout.ByteBufAppendByte(rawBuf, 109)
    layout.ByteBufAppendByte(rawBuf, 34)
    layout.ByteBufAppendByte(rawBuf, 58)
    layout.ByteBufAppendByte(rawBuf, 34)
    layout.ByteBufAppendByte(rawBuf, 97)
    layout.ByteBufAppendByte(rawBuf, 1)
    layout.ByteBufAppendByte(rawBuf, 98)
    layout.ByteBufAppendByte(rawBuf, 34)
    layout.ByteBufAppendByte(rawBuf, 125)
    var rawBytes = layout.ByteBufToBytes(rawBuf)
    let rawControlJson = rawbytes.BytesToString(rawBytes)
    rawbytes.BytesFree(rawBytes)
    layout.ByteBufFree(rawBuf)
    rc = expectMissing(rawControlJson, 13)
    if rc != 0:
        return rc
    return 0
