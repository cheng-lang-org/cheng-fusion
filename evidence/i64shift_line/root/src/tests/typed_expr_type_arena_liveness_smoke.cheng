import cheng/core/lang/parser
import cheng/core/lang/typed_expr_type_arena as typearena
import cheng/std/bytes_layout as layout

fn main(): int32 =
    let source =
        "type ScalarAlias = int32\ntype TupleAlias = tuple[left: int32, right: str]\ntype FunctionAlias = fn(value: int32): bool\ntype Record =\n    id: int32\n    label: str\ntype Kind = enum\n    Alpha\n    Beta\n"
    var tree: parser.ParserValueExprTree
    var err: str
    assert(parser.ParserValueExprReadTreeFromText(source, tree, err),
           Fmt"typed expr type arena liveness: parse failed {err}")
    let authority = typearena.TypedExprTypeResolutionAuthorityEmpty()
    var arena: typearena.TypedExprTypeArena
    assert(typearena.TypedExprTypeArenaBuildFromParserTreeInto(
               tree, authority, arena, err),
           Fmt"typed expr type arena liveness: build failed {err}")
    assert(tree != nil && arena != nil,
           "typed expr type arena liveness: owner was consumed")
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena liveness: first validation failed {err}")
    let firstCid =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(arena)
    assert(typearena.TypedExprTypeArenaTypeCount(arena) > 0,
           "typed expr type arena liveness: type rows missing")
    assert(typearena.TypedExprTypeArenaStrictValidateInto(arena, err),
           Fmt"typed expr type arena liveness: second validation failed {err}")
    let secondCid =
        typearena.TypedExprTypeArenaArtifactCidForCurrentState(arena)
    assert(layout.FixedBytes32Equal(firstCid, secondCid),
           "typed expr type arena liveness: repeated CID drift")
    typearena.TypedExprTypeArenaRelease(arena)
    parser.ParserValueExprTreeRelease(tree)
    echo("typed_expr_type_arena_liveness_smoke: ok")
    return 0
