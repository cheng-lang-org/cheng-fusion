type
    PostfixInner =
        values: int32[2]
    PostfixOuter =
        inner: PostfixInner

fn KeepPostfixValue(value: int32): int32 =
    return value

fn PostfixIndex(left: int32, right: int32): int32 =
    return left + right

fn main(): int32 =
    var outer: PostfixOuter
    outer.inner.values[
        0
    ] = 41
    outer.inner.values[
        1
    ] = 1
    let value = KeepPostfixValue(
        outer
            .inner
            .values[
                PostfixIndex(
                    0,
                    0
                )
            ]
    )
    if value != 41:
        return 1
    let second = KeepPostfixValue(
        outer.inner.values[
            PostfixIndex(0, 1)
        ]
    )
    if second != 1:
        return 2
    return 0

main()
