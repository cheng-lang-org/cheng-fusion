import std/strings
import std/os
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256
import cheng/core/csg_core/compiler_snapshot_schema as schema
import cheng/core/csg_core/compiler_snapshot_cargo as cargo
import cheng/core/tooling/compiler_world
import cheng/core/tooling/semantic_snapshot_debug_binding as binding
import cheng/core/backend/semantic_snapshot_debug_binding_receipt as bindingreceipt
import cheng/core/backend/debug_facts as debug
import cheng/core/backend/debug_emission_plan_evidence as evidence
import cheng/core/backend/debug_section_plan_receipt as planreceipt
import cheng/core/backend/debug_section_plan_consumer as consumer
import cheng/core/backend/lowering_plan as lower
import cheng/core/ir/core_types as coreir
import cheng/tests/debug_emission_receipt_smoke as fixture

fn TestCid(label: str): layout.FixedBytes32 =
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn TestSha256(label: str): str =
    return layout.FixedBytes32Hex(TestCid(label))

@borrows
fn MakeBindingReceipt(
        facts: debug.DebugFactBundle,
        lowering: lower.LoweringPlanStub):
        bindingreceipt.SemanticSnapshotDebugBindingReceipt =
    var out: bindingreceipt.SemanticSnapshotDebugBindingReceipt
    out.sourceVersion = facts.sourceVersion
    out.snapshotIndex = 0
    out.payloadIndex = 0
    out.predecessorReceiptCid = facts.predecessorReceiptCid
    out.bindingReceiptCid = facts.bindingReceiptCid
    out.semanticSnapshotCid = facts.semanticSnapshotCid
    out.worldHeadCid = facts.worldHeadCid
    out.compilerCid = facts.compilerCid
    out.sourceBundleCid = facts.sourceBundleCid
    out.csgRootCid = facts.csgRootCid
    out.validationReceiptCid = facts.validationReceiptCid
    out.declarationTableCid = facts.declarationTableCid
    out.declarationIdentityCid = facts.declarationIdentityCid
    out.compilerFactProjectionCid = TestCid("plan/compiler-projection")
    out.debugFactProjectionCid = facts.projectionCid
    out.loweringBridgeRootCid =
        lower.LoweringPlanSemanticDebugBridgeRoot(lowering)
    out.typedFunctionCount = facts.functionCount
    out.typedNodeCount = facts.typedNodeCount
    out.receiptCid =
        bindingreceipt.SemanticSnapshotDebugBindingReceiptCid(out)
    return out

@borrows
fn MakeEvidence(facts: debug.DebugFactBundle):
        evidence.DebugEmissionPlanEvidence =
    assert(facts.functionCount == 1 && facts.debugOpCount == 1,
           "debug section plan smoke: fixture shape")
    var out: evidence.DebugEmissionPlanEvidence
    out.backendKind = "primary"
    out.symbolNames = ["_Main"]
    out.functionWordOffsets = [0]
    out.functionWordCounts = [2]
    out.frozenSnapshotPayloads = ["frozen"]
    out.emissionLedgerPayloads = ["ledger"]
    out.bodyIrSha256s = [TestSha256("plan/body")]
    out.symbolByteStarts = [0]
    out.symbolByteLengths = [8]
    out.symbolBytesSha256s = [TestSha256("plan/symbol")]
    out.planSha256s = [TestSha256("plan/regalloc")]
    out.actionSemanticRootSha256s = [TestSha256("plan/action-semantic")]
    out.actionBindingRootSha256s = [TestSha256("plan/action-binding")]
    out.machineFragmentRootSha256s = [TestSha256("plan/machine")]
    out.abiIngressRootSha256s = [TestSha256("plan/abi")]
    add(out.debugProvenanceBound, true)
    out.debugFunctionIds = [0]
    out.debugProvenanceSha256s = [TestSha256("plan/provenance")]
    out.debugMachineFragmentRootSha256s = [""]
    out.debugFragmentStarts = [0]
    out.debugFragmentCounts = [2]
    out.fragmentFunctionIndexes = [0, 0]
    out.fragmentDebugOpIds = [0, -1]
    out.fragmentSyntheticKinds = [
        coreir.BodyDebugSyntheticNone,
        coreir.BodyDebugSyntheticCleanup]
    out.fragmentSiteKinds = [0, 0]
    out.fragmentSiteIndexes = [0, 1]
    out.fragmentMachineOwnerKinds = [0, 0]
    out.fragmentMachineOwnerOrdinals = [0, 1]
    out.fragmentActionConsumerOrdinals = [0, 1]
    out.fragmentTextByteStarts = [0, 4]
    out.fragmentByteLengths = [4, 4]
    out.fragmentBytesSha256s = [
        TestSha256("plan/fragment-0"),
        TestSha256("plan/fragment-1")]
    out.debugMachineFragmentRootSha256s[0] =
        evidence.DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
            out, 0)
    return out

fn BuildFacts(label: str, out: var debug.DebugFactBundle) =
    var err: str
    let predecessor = TestCid(strings.ConcatStr("plan/predecessor/", label))
    var documentCid: layout.FixedBytes32
    assert(compiler_world.CompilerWorldDocumentCidInto(
               "pkg", "pkg/main", documentCid, err), err)
    var tables = fixture.BuildSnapshot(predecessor, documentCid)
    assert(schema.CsgCompilerSnapshotTablesStrictValidateInto(tables, err), err)
    var canonical = cargo.CsgCompilerSnapshotCargoBuild(tables)
    assert(canonical.ok, canonical.error)
    fixture.BuildDebugFacts(
        tables, predecessor, documentCid, canonical, out)
    assert(debug.DebugFactBundleStrictValidateInto(out, err), err)

fn main() =
    var err: str
    var facts: debug.DebugFactBundle
    BuildFacts("snapshot-a", facts)
    var lowering: lower.LoweringPlanStub
    let retainedBody = fixture.BuildBody(facts, lowering)
    let debugBinding = MakeBindingReceipt(facts, lowering)
    let plan = MakeEvidence(facts)
    assert(lower.LoweringPlanBindPublishedDebugBindingReceiptInto(
               lowering, debugBinding, err) &&
           lower.LoweringPlanPublishedDebugBindingReceiptStrictValidateInto(
               lowering, err), err)
    var receipt: planreceipt.DebugSectionPlanReceipt
    assert(planreceipt.DebugSectionPlanReceiptBuildInto(
               debugBinding, facts, plan, receipt, err), err)
    assert(planreceipt.DebugSectionPlanReceiptStrictValidateInto(
               receipt, debugBinding, facts, plan, err), err)
    assert(receipt.sourceIds.len == 1 &&
           receipt.sourceIds[0] == 0 &&
           receipt.sourceModulePaths.len == 1 &&
           receipt.sourceModulePaths[0] == "pkg/main" &&
           receipt.sourceDocumentCids.len == 1 &&
           layout.FixedBytes32Equal(
               receipt.sourceDocumentCids[0],
               facts.facts[0].functionFact.documentCid) &&
           receipt.functionNames.len == 1 &&
           receipt.functionNames[0] == "Main",
           "debug section plan smoke: canonical source projection mismatch")

    var primaryConsumption: consumer.DebugSectionPlanConsumption
    assert(consumer.DebugSectionPlanConsumptionBuildInto(
               lowering, plan, primaryConsumption, err) &&
           primaryConsumption.valid &&
           primaryConsumption.sectionPlanReceipt.backendKind == "primary" &&
           bindingreceipt.SemanticSnapshotDebugBindingReceiptEqual(
               primaryConsumption.bindingReceipt, debugBinding), err)
    var backend2Evidence = plan
    backend2Evidence.backendKind = "backend2"
    var backend2Consumption: consumer.DebugSectionPlanConsumption
    assert(consumer.DebugSectionPlanConsumptionBuildInto(
               lowering, backend2Evidence, backend2Consumption, err) &&
           backend2Consumption.valid &&
           backend2Consumption.sectionPlanReceipt.backendKind == "backend2" &&
           layout.FixedBytes32Equal(
               primaryConsumption.sectionPlanReceipt.debugBindingReceiptCid,
               backend2Consumption.sectionPlanReceipt.debugBindingReceiptCid),
           "debug section plan smoke: primary/backend2 binding split")
    var immutableAttack = primaryConsumption
    immutableAttack.bindingReceipt.semanticSnapshotCid =
        TestCid("plan/foreign-stored-snapshot")
    assert(!consumer.DebugSectionPlanConsumptionStrictValidateInto(
               immutableAttack, lowering, plan, err),
           "debug section plan smoke: immutable plan binding mutation accepted")

    var forgedValid: planreceipt.DebugSectionPlanReceipt
    forgedValid.valid = true
    assert(!planreceipt.DebugSectionPlanReceiptStrictValidateInto(
               forgedValid, debugBinding, facts, plan, err),
           "debug section plan smoke: forged-valid receipt accepted")

    var declAttack = receipt
    declAttack.rows[0].functionDeclId = declAttack.rows[0].functionDeclId + 1
    assert(!planreceipt.DebugSectionPlanReceiptStrictValidateInto(
               declAttack, debugBinding, facts, plan, err),
           "debug section plan smoke: DeclId mutation accepted")

    var symbolAttack = receipt
    symbolAttack.rows[0].functionSymbolId =
        symbolAttack.rows[0].functionSymbolId + 1
    assert(!planreceipt.DebugSectionPlanReceiptStrictValidateInto(
               symbolAttack, debugBinding, facts, plan, err),
           "debug section plan smoke: SymbolId mutation accepted")

    var sourcePathAttack = receipt
    sourcePathAttack.sourceModulePaths[0] = "pkg/foreign"
    sourcePathAttack.receiptCid =
        planreceipt.debugSectionPlanReceiptCid(sourcePathAttack)
    assert(!planreceipt.DebugSectionPlanReceiptStrictValidateInto(
               sourcePathAttack, debugBinding, facts, plan, err),
           "debug section plan smoke: source path mutation accepted")

    var sourceDocumentAttack = receipt
    sourceDocumentAttack.sourceDocumentCids[0] =
        TestCid("plan/foreign-document")
    sourceDocumentAttack.receiptCid =
        planreceipt.debugSectionPlanReceiptCid(sourceDocumentAttack)
    assert(!planreceipt.DebugSectionPlanReceiptStrictValidateInto(
               sourceDocumentAttack, debugBinding, facts, plan, err),
           "debug section plan smoke: source document CID mutation accepted")

    var functionNameAttack = receipt
    functionNameAttack.functionNames[0] = "Foreign"
    functionNameAttack.receiptCid =
        planreceipt.debugSectionPlanReceiptCid(functionNameAttack)
    assert(!planreceipt.DebugSectionPlanReceiptStrictValidateInto(
               functionNameAttack, debugBinding, facts, plan, err),
           "debug section plan smoke: function name mutation accepted")

    var overlapPlan = plan
    overlapPlan.fragmentTextByteStarts[1] = 2
    overlapPlan.debugMachineFragmentRootSha256s[0] =
        evidence.DebugEmissionPlanEvidenceDebugMachineFragmentRootSha256(
            overlapPlan, 0)
    var rejectedReceipt: planreceipt.DebugSectionPlanReceipt
    assert(!planreceipt.DebugSectionPlanReceiptBuildInto(
               debugBinding, facts, overlapPlan, rejectedReceipt, err),
           "debug section plan smoke: overlapping PC fragment accepted")

    var fragmentHashAttack = receipt
    fragmentHashAttack.rows[0].plannedBytesSha256 =
        TestSha256("plan/foreign-fragment")
    assert(!planreceipt.DebugSectionPlanReceiptStrictValidateInto(
               fragmentHashAttack, debugBinding, facts, plan, err),
           "debug section plan smoke: fragment hash mutation accepted")

    var foreignFacts: debug.DebugFactBundle
    BuildFacts("snapshot-b", foreignFacts)
    assert(!planreceipt.DebugSectionPlanReceiptBuildInto(
               debugBinding, foreignFacts, plan,
               rejectedReceipt, err),
           "debug section plan smoke: different snapshot accepted")
    os.WriteLine(os.Get_stdout(), "debug_section_plan_receipt_smoke=pass")
