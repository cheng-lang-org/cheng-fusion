# ML-DSA (FIPS 204) polynomial math self-checks (no external oracle, all
# mathematical properties):
#   1. INTT(NTT(f)) == f and add/sub identity for 3 LCG-random polynomials;
#      zeta sanity 1753^256 == q - 1.
#   2. INTT(NTT(f) .* NTT(g)) == schoolbook negacyclic convolution mod
#      (x^256 + 1, q) for 3 random pairs (independent int64 schoolbook).
#   3. Power2Round: r == r1*2^13 + r0 exactly with range checks; Decompose:
#      (r1*2*gamma2 + r0) mod q == r with HighBits/LowBits range checks,
#      10000 LCG points + boundary points, both gamma2 values.
#   4. Hint roundtrip: UseHint(MakeHint(z, r), r) == HighBits(r + z) for
#      5000 sampled (r, z) with |centered z| <= gamma2, both gamma2 values.
#   5. SimpleBitPack/BitPack roundtrip identity for every deployed bit
#      width: b in {15, 43, 1023}; (a, b) in {(2,2), (4,4), (4095,4096),
#      (2^17-1, 2^17), (2^19-1, 2^19)}.
#   6. Sampling domains: RejNTTPoly < q; RejBoundedPoly centered in
#      [-eta, eta]; ExpandMask centered in [-gamma1+1, gamma1].

import std/system
import std/strings
import std/rawbytes
import std/crypto/mldsa_poly as mldsa

# LCG state update uses "& 2147483647" (== mod 2^31 for non-negative x):
# the literal 2147483648 does not fit int32 and "% 2147483648" miscompiles
# (known bit31 literal defect family, findings.md 2026-06-12). Two draws
# are combined into 24 bits because q needs 23.
fn lcgStep(x: int64): int64 =
    return (x * 1103515245 + 12345) & 2147483647

fn lcgPoly(seed: int64, modulus: int32): int32[] =
    var x: int64 = seed
    var f: int32[]
    setLen(f, 256)
    for i in 0..<256:
        x = lcgStep(x)
        let hi: int64 = (x >> 7) & 4095
        x = lcgStep(x)
        let lo: int64 = (x >> 7) & 4095
        f[i] = int32(((hi << 12) | lo) % int64(modulus))
    return f

fn polyCheckEqual(label: str, got: int32[], expected: int32[]): bool =
    for i in 0..<256:
        if got[i] != expected[i]:
            echo(Fmt"mldsa_poly mismatch [{label}] first diff at index {i}: got {got[i]} expected {expected[i]}")
            return false
    return true

# Independent modular multiplication oracle using only int32 arithmetic:
# b is split into 8-bit chunks so every product and dividend stays below
# 2^31 (int64 % truncates dividends >= 2^32 to their low 32 bits, probe
# 2026-06-12, so the module-independent path must avoid int64 entirely).
fn mulModChunked(u: int32, v: int32): int32 =
    var t: int32 = (u * ((v >> 16) & 255)) % 8380417
    t = (t * 256) % 8380417
    t = (t + u * ((v >> 8) & 255)) % 8380417
    t = (t * 256) % 8380417
    t = (t + u * (v & 255)) % 8380417
    return t

# Schoolbook multiplication in Z_q[x]/(x^256 + 1): x^256 == -1. Independent
# of the module: its own int32-chunked modular arithmetic.
fn schoolbookMul(f: int32[], g: int32[]): int32[] =
    var h: int32[]
    setLen(h, 256)
    for i in 0..<256:
        for j in 0..<256:
            let p: int32 = mulModChunked(f[i], g[j])
            let k: int32 = i + j
            if k < 256:
                h[k] = (h[k] + p) % 8380417
            else:
                h[k - 256] = (h[k - 256] - p + 8380417) % 8380417
    return h

fn testNttRoundtrip(): bool =
    # zeta sanity: 1753 must be a 512th root of unity, i.e. 1753^256 == q-1.
    var zp: int32 = 1
    for i in 0..<256:
        zp = mldsa.MldsaMulMod(zp, 1753)
    if zp != 8380416:
        echo(Fmt"mldsa_poly zeta sanity failed: 1753^256 mod q = {zp} expected 8380416")
        return false
    var seed: int64 = 1
    while seed <= 3:
        let f: int32[] = lcgPoly(seed, 8380417)
        let back: int32[] = mldsa.MldsaIntt(mldsa.MldsaNtt(f))
        if !polyCheckEqual(Fmt"ntt-intt seed={seed}", back, f):
            return false
        let h: int32[] = lcgPoly(seed + 50, 8380417)
        if !polyCheckEqual(Fmt"add-sub seed={seed}", mldsa.MldsaPolySub(mldsa.MldsaPolyAdd(f, h), h), f):
            return false
        seed = seed + 1
    return true

fn testNttMultiply(): bool =
    var seed: int64 = 11
    while seed <= 13:
        let f: int32[] = lcgPoly(seed, 8380417)
        let g: int32[] = lcgPoly(seed + 100, 8380417)
        let want: int32[] = schoolbookMul(f, g)
        let got: int32[] = mldsa.MldsaIntt(mldsa.MldsaMultiplyNtts(mldsa.MldsaNtt(f), mldsa.MldsaNtt(g)))
        if !polyCheckEqual(Fmt"ntt-mul seed={seed}", got, want):
            return false
        seed = seed + 1
    return true

fn checkPower2Round(r: int32): bool =
    let r1: int32 = mldsa.MldsaPower2RoundHigh(r)
    let r0: int32 = mldsa.MldsaPower2RoundLow(r)
    if r1 * 8192 + r0 != r:
        echo(Fmt"mldsa_poly power2round identity failed: r={r} r1={r1} r0={r0}")
        return false
    if r1 < 0 || r1 > 1023:
        echo(Fmt"mldsa_poly power2round r1 out of range: r={r} r1={r1}")
        return false
    if r0 < 0 - 4095 || r0 > 4096:
        echo(Fmt"mldsa_poly power2round r0 out of range: r={r} r0={r0}")
        return false
    return true

fn checkDecompose(r: int32, gamma2: int32): bool =
    let m: int32 = 8380416 / (2 * gamma2)
    let r1: int32 = mldsa.MldsaHighBits(r, gamma2)
    let r0: int32 = mldsa.MldsaLowBits(r, gamma2)
    if (r1 * 2 * gamma2 + r0 + 8380417) % 8380417 != r:
        echo(Fmt"mldsa_poly decompose identity failed: gamma2={gamma2} r={r} r1={r1} r0={r0}")
        return false
    if r1 < 0 || r1 >= m:
        echo(Fmt"mldsa_poly highbits out of range: gamma2={gamma2} r={r} r1={r1}")
        return false
    if r0 < 0 - gamma2 || r0 > gamma2:
        echo(Fmt"mldsa_poly lowbits out of range: gamma2={gamma2} r={r} r0={r0}")
        return false
    return true

fn decomposeEdgePoints(gamma2: int32): int32[] =
    var pts: int32[]
    setLen(pts, 21)
    pts[0] = 0
    pts[1] = 1
    pts[2] = 2
    pts[3] = 4095
    pts[4] = 4096
    pts[5] = 4097
    pts[6] = 8191
    pts[7] = 8192
    pts[8] = 8193
    pts[9] = gamma2 - 1
    pts[10] = gamma2
    pts[11] = gamma2 + 1
    pts[12] = 2 * gamma2 - 1
    pts[13] = 2 * gamma2
    pts[14] = 2 * gamma2 + 1
    pts[15] = 8380416
    pts[16] = 8380415
    pts[17] = 8380416 - gamma2
    pts[18] = 8380416 - gamma2 + 1
    pts[19] = 8380416 - 2 * gamma2
    pts[20] = 8380417 - 4096
    return pts

fn testPower2RoundDecompose(): bool =
    var gamma2: int32 = 95232
    while gamma2 <= 261888:
        let edges: int32[] = decomposeEdgePoints(gamma2)
        for e in 0..<21:
            if !checkPower2Round(edges[e]):
                return false
            if !checkDecompose(edges[e], gamma2):
                return false
        var x: int64 = 77
        var n: int32
        while n < 10000:
            x = lcgStep(x)
            let hi: int64 = (x >> 7) & 4095
            x = lcgStep(x)
            let lo: int64 = (x >> 7) & 4095
            let r: int32 = int32(((hi << 12) | lo) % int64(8380417))
            if !checkPower2Round(r):
                return false
            if !checkDecompose(r, gamma2):
                return false
            n = n + 1
        gamma2 = gamma2 + 166656
    return true

fn testHintRoundtrip(): bool =
    var gamma2: int32 = 95232
    while gamma2 <= 261888:
        let m: int32 = 8380416 / (2 * gamma2)
        var x: int64 = 99
        var n: int32
        while n < 5000:
            x = lcgStep(x)
            let hi: int64 = (x >> 7) & 4095
            x = lcgStep(x)
            let lo: int64 = (x >> 7) & 4095
            let r: int32 = int32(((hi << 12) | lo) % int64(8380417))
            x = lcgStep(x)
            let hi2: int64 = (x >> 7) & 4095
            x = lcgStep(x)
            let lo2: int64 = (x >> 7) & 4095
            # centered z in [-gamma2, gamma2], stored canonical mod q
            let zc: int32 = int32(((hi2 << 12) | lo2) % int64(2 * gamma2 + 1)) - gamma2
            let z: int32 = mldsa.MldsaCanonical(zc)
            let h: int32 = mldsa.MldsaMakeHint(z, r, gamma2)
            if h != 0 && h != 1:
                echo(Fmt"mldsa_poly makehint out of range: gamma2={gamma2} r={r} z={zc} h={h}")
                return false
            let want: int32 = mldsa.MldsaHighBits(mldsa.MldsaAddMod(r, z), gamma2)
            let got: int32 = mldsa.MldsaUseHint(h, r, gamma2)
            if got != want:
                echo(Fmt"mldsa_poly hint roundtrip failed: gamma2={gamma2} r={r} z={zc} h={h} got={got} want={want}")
                return false
            if got < 0 || got >= m:
                echo(Fmt"mldsa_poly usehint out of range: gamma2={gamma2} r={r} got={got}")
                return false
            n = n + 1
        gamma2 = gamma2 + 166656
    return true

fn testSimpleBitPackOne(seed: int64, b: int32): bool =
    let f: int32[] = lcgPoly(seed, b + 1)
    let packed: Bytes = mldsa.MldsaSimpleBitPack(f, b)
    let back: int32[] = mldsa.MldsaSimpleBitUnpack(packed, b)
    return polyCheckEqual(Fmt"simple-bitpack b={b}", back, f)

fn testBitPackOne(seed: int64, a: int32, b: int32): bool =
    # centered values in [-a, b], stored canonical mod q
    let raw: int32[] = lcgPoly(seed, a + b + 1)
    var f: int32[]
    setLen(f, 256)
    for i in 0..<256:
        f[i] = mldsa.MldsaCanonical(raw[i] - a)
    let packed: Bytes = mldsa.MldsaBitPack(f, a, b)
    if BytesLen(packed) == 0:
        echo(Fmt"mldsa_poly bitpack empty output: a={a} b={b}")
        return false
    let back: int32[] = mldsa.MldsaBitUnpack(packed, a, b)
    return polyCheckEqual(Fmt"bitpack a={a} b={b}", back, f)

fn testBitPackRoundtrip(): bool =
    # SimpleBitPack widths in deployment: w1 (b=43 and b=15), t1 (b=1023).
    if !testSimpleBitPackOne(21, 15):
        return false
    if !testSimpleBitPackOne(22, 43):
        return false
    if !testSimpleBitPackOne(23, 1023):
        return false
    # BitPack widths in deployment: s1/s2 (eta), t0 (2^12), z (gamma1).
    if !testBitPackOne(31, 2, 2):
        return false
    if !testBitPackOne(32, 4, 4):
        return false
    if !testBitPackOne(33, 4095, 4096):
        return false
    if !testBitPackOne(34, 131071, 131072):
        return false
    if !testBitPackOne(35, 524287, 524288):
        return false
    return true

fn makeSeed(len: int32, salt: int32): Bytes =
    let seed: Bytes = BytesAlloc(len)
    for i in 0..<len:
        BytesSet(seed, i, (i * 7 + salt) & 255)
    return seed

fn testSampling(): bool =
    # RejNTTPoly: 34-byte XOF input (rho || s || r shape).
    let a: int32[] = mldsa.MldsaRejNttPoly(makeSeed(34, 1))
    if a.len != 256:
        echo(Fmt"mldsa_poly rejntt length wrong: {a.len}")
        return false
    for j in 0..<256:
        if a[j] < 0 || a[j] >= 8380417:
            echo(Fmt"mldsa_poly rejntt coefficient out of range at {j}: {a[j]}")
            return false
    # RejBoundedPoly: 66-byte XOF input, eta = 2 and eta = 4.
    var eta: int32 = 2
    while eta <= 4:
        let s: int32[] = mldsa.MldsaRejBoundedPoly(makeSeed(66, 3), eta)
        for j in 0..<256:
            let v: int32 = mldsa.MldsaCentered(s[j])
            if v < 0 - eta || v > eta:
                echo(Fmt"mldsa_poly rejbounded eta={eta} coefficient out of range at {j}: {v}")
                return false
        eta = eta + 2
    # ExpandMask: gamma1 = 2^17 and 2^19, centered range [-gamma1+1, gamma1].
    var gamma1: int32 = 131072
    while gamma1 <= 524288:
        let y: int32[] = mldsa.MldsaExpandMaskPoly(makeSeed(66, 5), gamma1)
        for j in 0..<256:
            let v: int32 = mldsa.MldsaCentered(y[j])
            if v < 1 - gamma1 || v > gamma1:
                echo(Fmt"mldsa_poly expandmask gamma1={gamma1} coefficient out of range at {j}: {v}")
                return false
        gamma1 = gamma1 * 4
    return true

fn main(): int32 =
    if !testNttRoundtrip():
        return 1
    if !testNttMultiply():
        return 1
    if !testPower2RoundDecompose():
        return 1
    if !testHintRoundtrip():
        return 1
    if !testBitPackRoundtrip():
        return 1
    if !testSampling():
        return 1
    echo(" mldsa_poly_smoke ok: ntt-roundtrip(3)+zeta ntt-mul(3) power2round+decompose(2x10000+edges) hint-roundtrip(2x5000) bitpack(simple 15/43/1023, signed 2/4/4096/2^17/2^19) sampling(rejntt+rejbounded2,4+expandmask17,19) all passed")
    return 0
