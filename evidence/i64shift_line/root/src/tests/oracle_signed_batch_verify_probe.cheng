import std/os as os
import std/strutils as strutil
import cheng/std/bytes_layout as layout
import cheng/oracle/oracle_plane as oracle_plane
import cheng/tests/oracle_smoke_support as support

fn main(): int32 =
    for slot in 1..<8:
        var batch = support.oracleSmokeBatch(int64(30), slot)
        let pubKey = support.oracleSmokePubKey(slot)
        let verifyRes = oracle_plane.OracleSignedBatchVerify(batch, layout.FixedBytes65ToBytes(pubKey))
        if !verifyRes.ok:
            os.WriteLine(os.Get_stdout(), strutil.Join(["slot ", IntToStr(slot), " failed: ", verifyRes.err.msg], ""))
            return 1
        os.WriteLine(os.Get_stdout(), strutil.Join(["slot ", IntToStr(slot), " ok"], ""))
    os.WriteLine(os.Get_stdout(), "oracle_signed_batch_verify_probe ok")
    return 0
