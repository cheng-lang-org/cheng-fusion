import std/cmdline as cmdline
import std/os
import std/strings
import cheng/core/tooling/path as chengpath

@abi_internal
@importc("driver_c_read_flag_raw_ptr_bridge")
fn ReportPathBridgeProbeReadFlagRawPtrBridge(keyData: ptr,
                                             keyLen: int32,
                                             defaultData: ptr,
                                             defaultLen: int32): ptr

@abi_internal
@importc("driver_c_read_flag_raw_len_bridge")
fn ReportPathBridgeProbeReadFlagRawLenBridge(keyData: ptr,
                                             keyLen: int32,
                                             defaultData: ptr,
                                             defaultLen: int32): int32

fn ReportPathBridgeProbeWriteErr(text: str) =
    os.WriteLine(os.Get_stderr(), text)

fn ReportPathBridgeProbeBoolText(value: bool): str =
    if value:
        return "1"
    return "0"

@borrows
fn ReportPathBridgeProbeByteText(text: str, index: int32): str =
    if index < 0 || index >= len(text):
        return "-1"
    return IntToStr(Int32(text[index]))

@borrows
fn ReportPathBridgeProbeDiagLine(name: str, text: str): str =
    let n = len(text)
    let lastIndex = n - 1
    return name + "=" + text + "\n" +
           name + "_len=" + IntToStr(n) + "\n" +
           name + "_b0=" + ReportPathBridgeProbeByteText(text, 0) + "\n" +
           name + "_blast=" + ReportPathBridgeProbeByteText(text, lastIndex) + "\n"

@borrows
fn ReportPathBridgeProbeRawFlagValue(key: str, defaultValue: str): str =
    let raw = ReportPathBridgeProbeReadFlagRawPtrBridge(StrDataPtr(key),
                                                        len(key),
                                                        StrDataPtr(defaultValue),
                                                        len(defaultValue))
    let rawLen = ReportPathBridgeProbeReadFlagRawLenBridge(StrDataPtr(key),
                                                           len(key),
                                                           StrDataPtr(defaultValue),
                                                           len(defaultValue))
    if raw == nil || rawLen <= 0:
        return ""
    return NewStringCopy(raw, rawLen)

@borrows
fn ReportPathBridgeProbeRawFlagLen(key: str, defaultValue: str): int32 =
    return ReportPathBridgeProbeReadFlagRawLenBridge(StrDataPtr(key),
                                                     len(key),
                                                     StrDataPtr(defaultValue),
                                                     len(defaultValue))

fn ReportPathBridgeProbeFlagDiag(key: str,
                                 label: str): str =
    var cmdValue: str
    let cmdFound = cmdline.ReadFirstFlagValue(key, cmdValue)
    let rawValue = ReportPathBridgeProbeRawFlagValue(key, "")
    let rawLen = ReportPathBridgeProbeRawFlagLen(key, "")
    var dropValue: str
    var sliceValue: str
    let inlinePrefix = key + ":"
    let count = cmdline.ParamCount()
    for i in 1..count:
        let arg = cmdline.ParamStr(i)
        if strings.HasPrefix(arg, inlinePrefix):
            dropValue = strings.DropPrefix(arg, inlinePrefix)
            sliceValue = strings.SliceBytes(arg, len(inlinePrefix), len(arg) - len(inlinePrefix))
            break
    var out = ""
    out = out + label + "_cmd_found=" + ReportPathBridgeProbeBoolText(cmdFound) + "\n"
    out = out + label + "_raw_len_bridge=" + IntToStr(rawLen) + "\n"
    out = out + ReportPathBridgeProbeDiagLine(label + "_cmd", cmdValue)
    out = out + ReportPathBridgeProbeDiagLine(label + "_raw", rawValue)
    out = out + ReportPathBridgeProbeDiagLine(label + "_drop_prefix", dropValue)
    out = out + ReportPathBridgeProbeDiagLine(label + "_slice_bytes", sliceValue)
    return out

fn ReportPathBridgeProbeArgDiag(): str =
    var out = ""
    let count = cmdline.ParamCount()
    out = out + "param_count=" + IntToStr(count) + "\n"
    for i in 0..count:
        let arg = cmdline.ParamStr(i)
        out = out + ReportPathBridgeProbeDiagLine("arg_" + IntToStr(i), arg)
    return out

fn main(argc: int32, argv: ptr): int32 =
    cmdline.CaptureCmdLine(argc, argv)
    var reportPath: str
    if !cmdline.ReadFirstFlagValue("--report-out", reportPath):
        ReportPathBridgeProbeWriteErr("report_path_bridge_probe: missing --report-out")
        return 2
    if len(reportPath) <= 0:
        ReportPathBridgeProbeWriteErr("report_path_bridge_probe: empty --report-out")
        return 2
    let root = os.GetCurrentDir()
    let writePath = reportPath + ".write_text"
    let handlePath = reportPath + ".handle_text"
    let hostWritePath = reportPath + ".host_write_text"
    let hostHandlePath = reportPath + ".host_handle_text"
    let writeAbsolute = chengpath.PathAbsolute(strings.CloneStr(root), writePath)
    let directJoin = chengpath.PathJoin(strings.CloneStr(root), writePath)
    let directHost = chengpath.PathHostFilePath(directJoin)
    let directParent = chengpath.PathParentDir(directHost)
    let writeParent = chengpath.PathParentDir(writeAbsolute)
    ReportPathBridgeProbeWriteErr("probe_root=" + root)
    ReportPathBridgeProbeWriteErr("probe_report_out=" + reportPath)
    ReportPathBridgeProbeWriteErr("probe_direct_join=" + directJoin)
    ReportPathBridgeProbeWriteErr("probe_direct_host=" + directHost)
    ReportPathBridgeProbeWriteErr("probe_direct_parent=" + directParent)
    ReportPathBridgeProbeWriteErr("probe_write_absolute=" + writeAbsolute)
    ReportPathBridgeProbeWriteErr("probe_write_parent=" + writeParent)
    ReportPathBridgeProbeWriteErr("probe_parent_exists_before=" + ReportPathBridgeProbeBoolText(chengpath.PathDirExists(writeParent)))
    let diag = "probe=report_path_bridge\n" +
               ReportPathBridgeProbeArgDiag() +
               ReportPathBridgeProbeFlagDiag("--emit", "emit") +
               ReportPathBridgeProbeFlagDiag("--report-out", "report_out") +
               ReportPathBridgeProbeFlagDiag("--space-value", "space_value")
    let writeBody = diag + "method=WriteTextFile\nreport_out=" + reportPath + "\n"
    let handleBody = diag + "method=WriteTextFileWithHandle\nreport_out=" + reportPath + "\n"
    let hostWriteBody = diag + "method=WriteTextFileHostBridge\nreport_out=" + reportPath + "\n"
    let hostHandleBody = diag + "method=WriteTextFileWithHandleHostBridge\nreport_out=" + reportPath + "\n"
    let writeOk = chengpath.WriteTextFile(strings.CloneStr(root), writePath, writeBody)
    if !writeOk:
        ReportPathBridgeProbeWriteErr("probe_parent_exists_after=" + ReportPathBridgeProbeBoolText(chengpath.PathDirExists(writeParent)))
        ReportPathBridgeProbeWriteErr("probe_write_exists_after=" + ReportPathBridgeProbeBoolText(chengpath.PathFileExists(writeAbsolute)))
        ReportPathBridgeProbeWriteErr("report_path_bridge_probe: WriteTextFile failed: " + writePath)
    let handleOk = chengpath.WriteTextFileWithHandle(strings.CloneStr(root), strings.CloneStr(handlePath), handleBody)
    if !handleOk:
        ReportPathBridgeProbeWriteErr("report_path_bridge_probe: WriteTextFileWithHandle failed: " + handlePath)
    let hostWriteOk = chengpath.WriteTextFileHostBridge(strings.CloneStr(root), hostWritePath, hostWriteBody)
    if !hostWriteOk:
        ReportPathBridgeProbeWriteErr("report_path_bridge_probe: WriteTextFileHostBridge failed: " + hostWritePath)
    let hostHandleOk = chengpath.WriteTextFileWithHandleHostBridge(strings.CloneStr(root), strings.CloneStr(hostHandlePath), hostHandleBody)
    if !hostHandleOk:
        ReportPathBridgeProbeWriteErr("report_path_bridge_probe: WriteTextFileWithHandleHostBridge failed: " + hostHandlePath)
    if !writeOk:
        return 3
    if !handleOk:
        return 4
    if !hostWriteOk:
        return 5
    if !hostHandleOk:
        return 6
    let summary = diag +
                  "write_text_exists=" + ReportPathBridgeProbeBoolText(chengpath.PathFileExists(chengpath.PathAbsolute(strings.CloneStr(root), writePath))) + "\n" +
                  "handle_text_exists=" + ReportPathBridgeProbeBoolText(chengpath.PathFileExists(chengpath.PathAbsolute(strings.CloneStr(root), handlePath))) + "\n"
    if !chengpath.WriteTextFile(strings.CloneStr(root), reportPath, summary):
        ReportPathBridgeProbeWriteErr("report_path_bridge_probe: summary write failed: " + reportPath)
        return 5
    return 0
