# Runtime verification for web_scene_media_block_cache.cheng (S4: GOP 粒度内容寻址块缓存,
# 磁盘持久化). No network, no device — pure filesystem round-trip against a real rootDir
# passed by the caller (no platform cache path is guessed/hardcoded by the library or by
# this test).
#
# Two independent OS processes drive this file (not one process pretending twice):
#   --mode put            process #1: writes a deterministic payload, then asserts:
#                            1. round-trip: Put(cid, 240, payload) then Get(cid, 240) returns
#                               the exact same bytes;
#                            2. cold miss: Get(cid, 480) (never Put) returns Err, not a
#                               silently empty/garbage Ok;
#                            3. directory isolation: a second, distinct rootDir never sees
#                               the first root's data and vice versa — two Init() calls
#                               against two different rootDirs do not interfere.
#   --mode verify-persist  process #2 (fresh exec, no memory shared with process #1):
#                            re-Init()s against the SAME rootDir and Gets (cid, 240) again —
#                            proves the earlier write is genuinely persisted to disk, not an
#                            in-process cache artifact.
#
# The expected payload bytes are not passed between the two processes — both recompute the
# identical deterministic byte pattern from the same generator function, so process #2's
# assertion is a real independent check against what's actually on disk.

import std/os
import std/result
import std/rawbytes
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_block_cache as blockcache

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

# Deterministic non-trivial byte pattern (not all-zero, not printable-ASCII-only) so a
# byte-exact comparison actually exercises binary safety.
fn buildPayload(): Bytes =
    let n: int32 = 240
    var out: Bytes = BytesAlloc(n)
    var i: int32
    while i < n:
        BytesSet(out, i, (i * 37 + 11) % 256)
        i = i + 1
    return out

fn bytesEqualExact(a: Bytes, b: Bytes): bool =
    if BytesLen(a) != BytesLen(b):
        return false
    var i: int32
    while i < BytesLen(a):
        if BytesGet(a, i) != BytesGet(b, i):
            return false
        i = i + 1
    return true

fn runPut(root: str, root2: str, assetCid: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    os.WriteLine(os.Get_stdout(), "step1_init_root_ok")

    # Cold miss: never-Put key must return Err, not a silent empty/garbage Ok.
    var missRes: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGet(assetCid, 480)
    if IsOk(missRes):
        return fail("cold miss (assetCid, 480) returned Ok — must be Err, not silently empty/garbage data")
    os.WriteLine(os.Get_stdout(), "step2_cold_miss_err_ok")

    let payload: Bytes = buildPayload()
    if !blockcache.WebSceneMediaBlockCachePut(assetCid, 240, payload):
        return fail("Put(assetCid, 240, payload) returned false")
    os.WriteLine(os.Get_stdout(), "step3_put_ok")

    var getRes: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGet(assetCid, 240)
    if IsErr(getRes):
        return fail(strutil.Join(["Get(assetCid, 240) after Put returned Err: ", Error(getRes)], ""))
    let gotBytes: Bytes = Value(getRes)
    if !bytesEqualExact(gotBytes, payload):
        return fail("round-trip mismatch: Get(assetCid, 240) bytes != Put payload bytes")
    os.WriteLine(os.Get_stdout(), "step4_roundtrip_bytes_ok")

    # Directory isolation: a second, distinct rootDir must not see root's data, and writing
    # into it must not leak back into root.
    if !blockcache.WebSceneMediaBlockCacheInit(root2):
        return fail(strutil.Join(["Init(root2) failed: ", root2], ""))
    var crossRes: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGet(assetCid, 240)
    if IsOk(crossRes):
        return fail("Get(assetCid, 240) under root2 unexpectedly hit — root/root2 are not isolated")
    os.WriteLine(os.Get_stdout(), "step5a_root2_miss_ok")

    var payload2: Bytes = BytesAlloc(16)
    var j: int32
    while j < 16:
        BytesSet(payload2, j, (j * 5 + 3) % 256)
        j = j + 1
    if !blockcache.WebSceneMediaBlockCachePut(assetCid, 240, payload2):
        return fail("Put under root2 returned false")
    var root2GetRes: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGet(assetCid, 240)
    if IsErr(root2GetRes):
        return fail("Get under root2 after its own Put returned Err")
    if !bytesEqualExact(Value(root2GetRes), payload2):
        return fail("root2 round-trip mismatch")
    os.WriteLine(os.Get_stdout(), "step5b_root2_own_roundtrip_ok")

    # Switch back to root — it must still hold the ORIGINAL payload, unaffected by root2.
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["re-Init(root) failed: ", root], ""))
    var backRes: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGet(assetCid, 240)
    if IsErr(backRes):
        return fail("Get(assetCid, 240) under root after switching back returned Err")
    if !bytesEqualExact(Value(backRes), payload):
        return fail("root data corrupted/overwritten by root2 activity — isolation violated")
    os.WriteLine(os.Get_stdout(), "step5c_root_unaffected_by_root2_ok")

    os.WriteLine(os.Get_stdout(), "PUT_OK")
    return 0

fn runVerifyPersist(root: str, assetCid: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed in fresh process: ", root], ""))
    os.WriteLine(os.Get_stdout(), "step1_fresh_process_init_ok")

    var getRes: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGet(assetCid, 240)
    if IsErr(getRes):
        return fail(strutil.Join(["Get(assetCid, 240) in fresh process returned Err — not persisted: ", Error(getRes)], ""))
    let expected: Bytes = buildPayload()
    if !bytesEqualExact(Value(getRes), expected):
        return fail("fresh-process Get bytes != expected deterministic payload — persisted content wrong")
    os.WriteLine(os.Get_stdout(), "step2_cross_process_roundtrip_ok")

    os.WriteLine(os.Get_stdout(), "VERIFY_PERSIST_OK")
    return 0

fn main(): int32 =
    var rootRaw: str
    let hasRoot: bool = cmdline.ReadFirstFlagValue("--root", rootRaw)
    if !hasRoot:
        return fail("missing --root")
    var assetCidRaw: str
    let hasAssetCid: bool = cmdline.ReadFirstFlagValue("--asset-cid", assetCidRaw)
    if !hasAssetCid:
        return fail("missing --asset-cid")
    var modeRaw: str
    let hasMode: bool = cmdline.ReadFirstFlagValue("--mode", modeRaw)
    let mode: str = if hasMode: modeRaw else: "put"

    if mode == "verify-persist":
        return runVerifyPersist(rootRaw, assetCidRaw)

    var root2Raw: str
    let hasRoot2: bool = cmdline.ReadFirstFlagValue("--root2", root2Raw)
    if !hasRoot2:
        return fail("missing --root2 (required for --mode put)")
    return runPut(rootRaw, root2Raw, assetCidRaw)
