# Char-literal paren continuation fixture:
# `if piece == '(':` followed by a sibling statement and then
# `elif piece == ')':` previously fed ParserLineNeedsContinuation a '('
# from inside the '(' char literal, faking an unclosed paren. The parser
# then joined the if-body, the sibling assign, and the elif header into one
# logical line, so the `return i` statement's surfaceText spanned three
# source lines. That surface carried a ')' (from the elif's ')' char
# literal), tripping HasCallSurface and routing the return to the 801
# zero-op bail -> the whole function cold-fell-back (WCZ).
# Fix: ParserLineNeedsContinuation now skips char literals like it already
# skipped string literals, so the parens inside '(' / ')' no longer count.

fn FindOpenParen(rhs: str): int32 =
    var parenDepth: int32
    for i in 0..<rhs.len:
        let piece = rhs[i]
        if piece == '(':
            if parenDepth == 0:
                return i
            parenDepth = parenDepth + 1
        elif piece == ')':
            parenDepth = parenDepth - 1
        elif piece == '[':
            parenDepth = parenDepth + 1
        elif piece == ']':
            parenDepth = parenDepth - 1
    return -1

fn main(): int32 =
    if FindOpenParen("ab(cd") != 2:
        return 1
    if FindOpenParen("abcd") != -1:
        return 2
    if FindOpenParen("(xy") != 0:
        return 3
    if FindOpenParen("[a](b") != 3:
        return 4
    return 0
