# bridge contract smoke: merkle-sum aggregation, order independence,
# apply validation, and schema fingerprint stability.

import std/os
import std/system
import std/rawbytes
import cheng/std/bytes_layout as layout
import cheng/chain/rwad_bridge_contract as brg

fn Acct(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0

    # batch: alice +50, bob -20, carol -30; net zero across accounts
    var entries: brg.BridgeEntry[]
    var e1: brg.BridgeEntry
    e1.accountCid = Acct(1)
    e1.amount = Int64(50)
    add(entries, e1)
    var e2: brg.BridgeEntry
    e2.accountCid = Acct(2)
    e2.amount = Int64(-20)
    add(entries, e2)
    var e3: brg.BridgeEntry
    e3.accountCid = Acct(3)
    e3.amount = Int64(-30)
    add(entries, e3)

    let rootA = brg.BridgeBatchRoot(entries)
    if !rootA.ok:
        os.WriteLine(os.Get_stderr(), "root computation failed")
        return 1

    # same batch, shuffled and with duplicates that must aggregate away
    var shuffled: brg.BridgeEntry[]
    var s1: brg.BridgeEntry
    s1.accountCid = Acct(3)
    s1.amount = Int64(-10)
    add(shuffled, s1)
    var s2: brg.BridgeEntry
    s2.accountCid = Acct(1)
    s2.amount = Int64(25)
    add(shuffled, s2)
    var s3: brg.BridgeEntry
    s3.accountCid = Acct(2)
    s3.amount = Int64(-20)
    add(shuffled, s3)
    var s4: brg.BridgeEntry
    s4.accountCid = Acct(1)
    s4.amount = Int64(25)
    add(shuffled, s4)
    var s5: brg.BridgeEntry
    s5.accountCid = Acct(3)
    s5.amount = Int64(-20)
    add(shuffled, s5)

    let rootB = brg.BridgeBatchRoot(shuffled)
    if !rootB.ok:
        os.WriteLine(os.Get_stderr(), "shuffled root failed")
        rc = rc + 1
    else:
        if !layout.FixedBytes32Equal(rootA.value, rootB.value):
            os.WriteLine(os.Get_stderr(), "aggregation not order-independent")
            rc = rc + 1

    # single entry batch differs from multi-entry batch
    var solo: brg.BridgeEntry[]
    add(solo, e1)
    let rootSolo = brg.BridgeBatchRoot(solo)
    if !rootSolo.ok or layout.FixedBytes32Equal(rootSolo.value, rootA.value):
        os.WriteLine(os.Get_stderr(), "solo batch collided with full batch")
        rc = rc + 1

    # empty batch rejected loudly
    var none_: brg.BridgeEntry[]
    let rootEmpty = brg.BridgeBatchRoot(none_)
    if rootEmpty.ok:
        os.WriteLine(os.Get_stderr(), "empty batch accepted")
        rc = rc + 1

    # --- apply path ---
    var okReceipt: brg.BridgeReceipt
    okReceipt.batchId = BytesFromString("batch-0007")
    okReceipt.txHash = Acct(9)
    okReceipt.chainRoot = rootA.value
    okReceipt.statusFinalized = true
    let applyOk = brg.BridgeApplyCheck(rootA.value, okReceipt)
    if !applyOk.ok:
        os.WriteLine(os.Get_stderr(), "valid receipt rejected")
        rc = rc + 1

    # unfinalized receipt must fail loudly
    var pendingReceipt: brg.BridgeReceipt
    pendingReceipt.batchId = BytesFromString("batch-0008")
    pendingReceipt.txHash = Acct(9)
    pendingReceipt.chainRoot = rootA.value
    pendingReceipt.statusFinalized = false
    let applyPending = brg.BridgeApplyCheck(rootA.value, pendingReceipt)
    if applyPending.ok:
        os.WriteLine(os.Get_stderr(), "unfinalized receipt accepted")
        rc = rc + 1

    # root drift must fail loudly (storage-side tamper simulation)
    var driftedReceipt: brg.BridgeReceipt
    driftedReceipt.batchId = BytesFromString("batch-0009")
    driftedReceipt.txHash = Acct(9)
    driftedReceipt.chainRoot = rootSolo.value
    driftedReceipt.statusFinalized = true
    let applyDrift = brg.BridgeApplyCheck(rootA.value, driftedReceipt)
    if applyDrift.ok:
        os.WriteLine(os.Get_stderr(), "drifted root accepted")
        rc = rc + 1

    # fingerprint stable within a process and non-empty
    let fp1 = brg.BridgeContractFingerprint()
    let fp2 = brg.BridgeContractFingerprint()
    if !layout.FixedBytes32Equal(fp1, fp2):
        os.WriteLine(os.Get_stderr(), "fingerprint unstable")
        rc = rc + 1

    if rc == 0:
        echo("bridge_contract_smoke ok")
    return rc
