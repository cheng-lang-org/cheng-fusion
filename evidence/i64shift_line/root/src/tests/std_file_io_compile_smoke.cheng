# std file/process IO compile smoke: write/read helpers and streams surface

import std/system
import std/os as os
import std/rawbytes as rawbytes
import std/result
import std/streams as streams

fn main(): int32 =
    var tmpPath: str = "artifacts/std_file_io_compile_smoke.tmp"
    var outText: str
    let _ = os.ReadFileInto(tmpPath, outText)
    os.WriteFile(tmpPath, "cheng-file")
    var textRes: Result[str] = os.ReadFileResult(tmpPath)
    if result.IsErr(textRes):
        return 1
    if result.Value(textRes) != "cheng-file":
        return 1
    var writeRes: Result[bool] = os.WriteFileResult(tmpPath, "cheng-file-result")
    if result.IsErr(writeRes):
        return 1
    var writtenTextRes: Result[str] = os.ReadFileResult(tmpPath)
    if result.IsErr(writtenTextRes):
        return 1
    if result.Value(writtenTextRes) != "cheng-file-result":
        return 1
    var payloadBytes: rawbytes.Bytes = rawbytes.BytesFromString("abc")
    var bytesWriteErr: str
    if ! os.WriteFileBytesStatus(tmpPath, payloadBytes, bytesWriteErr):
        return 1
    var bytesReadRes: Result[rawbytes.Bytes] = os.ReadFileBytesResult(tmpPath)
    if result.IsErr(bytesReadRes):
        return 1
    let bytesValue: rawbytes.Bytes = result.Value(bytesReadRes)
    if rawbytes.BytesLen(bytesValue) != 3:
        return 1
    if rawbytes.BytesGet(bytesValue, 0) != 97:
        return 1
    var handleOpenRes: Result[os.FileHandle] = os.OpenFileResult(tmpPath, Read)
    if result.IsErr(handleOpenRes):
        return 1
    let handle: os.FileHandle = result.Value(handleOpenRes)
    var handleReadRes: Result[rawbytes.Bytes] = os.ReadAllBytesResult(handle)
    if result.IsErr(handleReadRes):
        return 1
    var handleCloseRes: Result[bool] = os.CloseFileResult(handle)
    if result.IsErr(handleCloseRes):
        return 1
    let stream: streams.Stream = streams.NewFileStream(tmpPath, fmWrite)
    if ! streams.IsNil(stream):
        streams.Close(stream)
    return 0
