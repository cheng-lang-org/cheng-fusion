import std/os as os
import std/strings
import std/system
import cheng/core/csg_core/csgc_authority
import cheng/core/csg_core/merkle_store
import cheng/core/runtime/production_held_exec_provider as provider
import cheng/core/runtime/production_held_exec_terminal_guardian as terminal_guardian

const
    rootIdentityCid: str =
        "sha256:1111111111111111111111111111111111111111111111111111111111111111"
    sourceClosureCid: str =
        "sha256:2222222222222222222222222222222222222222222222222222222222222222"
    executableCid: str =
        "sha256:3333333333333333333333333333333333333333333333333333333333333333"
    compilerRequestCid: str =
        "sha256:8888888888888888888888888888888888888888888888888888888888888888"

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

fn fixturePreExecInput(): provider.CsgCoreProductionPreExecInput =
    var out: provider.CsgCoreProductionPreExecInput
    out.schemaVersion =
        provider.CsgCoreProductionPreExecInputSchemaVersion
    out.semanticCommand =
        provider.CsgCoreProductionPreExecInputCommandSystemLinkExec
    out.packageSourceRootIdentityCid = rootIdentityCid
    out.canonicalModulePath = "fixture/main"
    out.outputRole =
        provider.CsgCoreProductionPreExecInputOutputBuildArtifact
    out.targetTriple = "x86_64-unknown-linux-gnu"
    out.emitKind = provider.CsgCoreProductionPreExecInputEmitExe
    out.reportRole = provider.CsgCoreProductionPreExecInputReportAbsent
    out.symbolVisibility =
        provider.CsgCoreProductionPreExecInputVisibilityPublic
    out.compileMode =
        provider.CsgCoreProductionPreExecInputCompileModeProduction
    out.backendKind = provider.CsgCoreProductionPreExecInputBackendPrimary
    out.jobCount = 1
    out.compilerRequestCid = compilerRequestCid
    return out

fn issuePreExecOwner(
        outHandle: var provider.CsgCoreProductionPreExecInputOwnerHandle,
        outReceipt: var provider.CsgCoreProductionPreExecInputOwnerReceipt,
        outActivationBytes: var str,
        outActivationCid: var str,
        outEnvelopeCid: var str,
    err: var str): bool =
    var envelope: str
    var input = fixturePreExecInput()
    if !provider.CsgCoreProductionPreExecInputEncodeInto(
           input, envelope, outEnvelopeCid, err):
        return false
    if !provider.CsgCoreProductionPreExecInputOwnerIssueInto(
           envelope,
           sourceClosureCid,
           executableCid,
           outHandle,
           outReceipt,
           err):
        return false
    if !provider.CsgCoreProductionPreExecActivationBundleEncodeInto(
           envelope,
           outReceipt,
           outActivationBytes,
           outActivationCid,
           err):
        var abortErr: str
        if !provider.CsgCoreProductionPreExecInputOwnerAbortInto(
               outHandle, abortErr):
            panic(strings.ConcatStr(
                "activation encode owner abort failed: ", abortErr))
        return false
    return true

fn abortPreExecOwner(
        owner: var provider.CsgCoreProductionPreExecInputOwnerHandle) =
    if owner.handleRow >= 0:
        var err: str
        if !provider.CsgCoreProductionPreExecInputOwnerAbortInto(
               owner, err):
            panic(strings.ConcatStr(
                "pre-exec owner abort failed: ", err))

fn abortBundleOwner(owner: var int32) =
    if owner > 0:
        if !system.RuntimeHeldExecBundleOwnerAbort(owner):
            panic("held bundle owner abort failed")
        owner = -1

fn closeRootOwner(owner: var int32) =
    if owner > 0:
        var err: str
        if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
               owner, err):
            panic(strings.ConcatStr("root owner close failed: ", err))
        owner = -1

fn abortAdmittedOwner(owner: var int32) =
    if owner > 0:
        var err: str
        if !merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
               owner, err):
            panic(strings.ConcatStr("admitted owner abort failed: ", err))

fn cleanupUnadmitted(
        preExecOwner:
            var provider.CsgCoreProductionPreExecInputOwnerHandle,
        rootOwner: var int32,
        bundleOwner: var int32) =
    abortBundleOwner(bundleOwner)
    closeRootOwner(rootOwner)
    abortPreExecOwner(preExecOwner)

fn issueRootOwner(
        outRootOwner: var int32,
        outRootBindingCid: var str,
        err: var str): bool =
    outRootOwner = -1
    outRootBindingCid = ""
    let policy = csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    if !policy.admitted:
        err = strings.ConcatStr("production store policy rejected: ",
            policy.error)
        return false
    var headLease: merkle_store.CsgCoreMerkleStoreCurrentHeadLease
    if !merkle_store.CsgCoreMerkleStoreAcquireCurrentHeadSharedLease(
           policy.parentPath,
           policy.storeName,
           headLease,
           err):
        return false
    if !merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseVerifyFence(
           headLease):
        merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseRelease(headLease)
        err = "production HEAD lease fence rejected"
        return false
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerIssueInto(
           headLease, policy.policyCid, outRootOwner, err):
        merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseRelease(headLease)
        return false
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerCurrentBindingCidInto(
           outRootOwner, outRootBindingCid, err):
        closeRootOwner(outRootOwner)
        return false
    return true

fn issueFixtureOwners(
        outPreExecOwner:
            var provider.CsgCoreProductionPreExecInputOwnerHandle,
        outReceipt: var provider.CsgCoreProductionPreExecInputOwnerReceipt,
        outActivationBytes: var str,
        outActivationCid: var str,
        outEnvelopeCid: var str,
        outRootOwner: var int32,
        outRootBindingCid: var str,
        outBundleOwner: var int32,
        err: var str): bool =
    outRootOwner = -1
    outBundleOwner = -1
    if !issuePreExecOwner(
           outPreExecOwner,
           outReceipt,
           outActivationBytes,
           outActivationCid,
           outEnvelopeCid,
           err):
        return false
    if !issueRootOwner(outRootOwner, outRootBindingCid, err):
        abortPreExecOwner(outPreExecOwner)
        return false
    outBundleOwner = system.RuntimeHeldExecParentSealBundleOwner(
        outActivationBytes, outActivationCid)
    if outBundleOwner <= 0:
        closeRootOwner(outRootOwner)
        abortPreExecOwner(outPreExecOwner)
        err = "held bundle owner seal rejected"
        return false
    return true

fn main(): int32 =
    var processEntrySession: system.RuntimeAllocationLedgerSessionCapability
    if !system.RuntimeAllocationLedgerSessionOwnerBegin(
           uint64(1073741824), processEntrySession):
        panic("fixture process-entry session owner begin failed")
    var preflightCloseOwner: int32 = -1
    if !provider.CsgCoreProductionAdmittedInputAuthorityInitializeBeforeFork(
           processEntrySession,
           preflightCloseOwner):
        panic("fixture process-entry session owner move failed")
    if processEntrySession.handle != uint64(0) ||
       processEntrySession.generation != uint64(0) ||
       processEntrySession.nonce0 != uint64(0) ||
       processEntrySession.nonce1 != uint64(0):
        panic("fixture process-entry session move did not clear source")
    if !provider.CsgCoreProductionAdmittedInputAuthorityReady():
        panic("fixture process-entry session owner was not published")
    os.WriteLine(
        os.Get_stdout(),
        "process_entry_session_move=pass")
    var issuedHeld: provider.CsgCoreProductionHeldExecReceipt
    var heldErr: str
    if provider.CsgCoreProductionHeldExecProviderIssueInto(
           issuedHeld, heldErr):
        return fail("un-armed provider issued held-exec authority")
    if heldErr !=
           "HARD_RED:production_held_exec_launcher_owned_retained_fd_source_unavailable":
        return fail("un-armed provider lost owned_retained_fd HARD_RED")

    var entryErr: str
    var entryHandle: provider.CsgCoreProductionPreExecInputChildHandle
    if provider.CsgCoreProductionPreExecInputChildTakeAndImportInto(
           entryHandle, entryErr):
        return fail("child receive succeeded without runtime ACTIVATE")
    if entryErr !=
           "HARD_RED:production_admitted_input_held_bundle_delivery_not_wired":
        return fail("child receive lost bundle-delivery HARD_RED")

    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianInitializeBeforeLoop():
        return fail("production terminal registry initialization rejected")

    var envelope: str
    var envelopeCid: str
    var encodeErr: str
    var fixtureInput = fixturePreExecInput()
    if !provider.CsgCoreProductionPreExecInputEncodeInto(
           fixtureInput, envelope, envelopeCid, encodeErr):
        return fail(strings.ConcatStr("fixture encode failed: ", encodeErr))
    var invalidOwner: provider.CsgCoreProductionPreExecInputOwnerHandle
    var invalidReceipt: provider.CsgCoreProductionPreExecInputOwnerReceipt
    var invalidErr: str
    if provider.CsgCoreProductionPreExecInputOwnerIssueInto(
           envelope,
           envelopeCid,
           executableCid,
           invalidOwner,
           invalidReceipt,
           invalidErr):
        return fail("aliased envelope/source identity issued owner")

    # A bad producer row must leave all three caller-owned identities intact.
    var failedPreExecOwner: provider.CsgCoreProductionPreExecInputOwnerHandle
    var failedReceipt: provider.CsgCoreProductionPreExecInputOwnerReceipt
    var failedActivationBytes: str
    var failedActivationCid: str
    var failedEnvelopeCid: str
    var failedRootOwner: int32
    var failedRootBindingCid: str
    var failedBundleOwner: int32
    var failedErr: str
    if !issueFixtureOwners(
           failedPreExecOwner,
           failedReceipt,
           failedActivationBytes,
           failedActivationCid,
           failedEnvelopeCid,
           failedRootOwner,
           failedRootBindingCid,
           failedBundleOwner,
           failedErr):
        return fail(strings.ConcatStr(
            "failure fixture owner issue rejected: ", failedErr))
    let expectedPreExecRow = failedPreExecOwner.handleRow
    let expectedRootOwner = failedRootOwner
    let expectedBundleOwner = failedBundleOwner
    var driftedPreExecRow = expectedPreExecRow + 1
    var rejectedAdmittedOwner: int32
    var rejectedHeldBundleCid: str
    if provider.CsgCoreProductionHeldExecProviderIssueAdmittedInputInto(
           preflightCloseOwner,
           driftedPreExecRow,
           failedRootOwner,
           failedBundleOwner,
           failedRootBindingCid,
           failedActivationBytes,
           rejectedAdmittedOwner,
           rejectedHeldBundleCid,
           failedErr):
        panic("drifted producer row issued admitted owner")
    if driftedPreExecRow != expectedPreExecRow + 1 ||
       failedPreExecOwner.handleRow != expectedPreExecRow ||
       failedRootOwner != expectedRootOwner ||
       failedBundleOwner != expectedBundleOwner ||
       rejectedAdmittedOwner != -1 || rejectedHeldBundleCid.len != 0:
        cleanupUnadmitted(
            failedPreExecOwner, failedRootOwner, failedBundleOwner)
        return fail("failed ISSUE mutated caller-owned identities")
    cleanupUnadmitted(
        failedPreExecOwner, failedRootOwner, failedBundleOwner)

    # The real ISSUE moves producer/root/bundle owners.  This focused runtime
    # stops at the pre-claim abort authority because the durable journal body
    # remains an explicit compiler HARD_RED; static gates below own the exact
    # guardian -> durable CLAIM -> ACTIVATE/FINISH/FINALIZE reachability proof.
    var livePreExecOwner: provider.CsgCoreProductionPreExecInputOwnerHandle
    var liveReceipt: provider.CsgCoreProductionPreExecInputOwnerReceipt
    var liveActivationBytes: str
    var liveActivationCid: str
    var liveEnvelopeCid: str
    var liveRootOwner: int32
    var liveRootBindingCid: str
    var liveBundleOwner: int32
    var liveErr: str
    if !issueFixtureOwners(
           livePreExecOwner,
           liveReceipt,
           liveActivationBytes,
           liveActivationCid,
           liveEnvelopeCid,
           liveRootOwner,
           liveRootBindingCid,
           liveBundleOwner,
           liveErr):
        return fail(strings.ConcatStr(
            "live fixture owner issue rejected: ", liveErr))
    var liveAdmittedOwner: int32
    var liveHeldBundleCid: str
    if !provider.CsgCoreProductionHeldExecProviderIssueAdmittedInputInto(
           preflightCloseOwner,
           livePreExecOwner.handleRow,
           liveRootOwner,
           liveBundleOwner,
           liveRootBindingCid,
           liveActivationBytes,
           liveAdmittedOwner,
           liveHeldBundleCid,
           liveErr):
        cleanupUnadmitted(
            livePreExecOwner, liveRootOwner, liveBundleOwner)
        return fail(strings.ConcatStr("live ISSUE rejected: ", liveErr))
    if livePreExecOwner.handleRow != -1 || liveRootOwner != -1 ||
       liveBundleOwner != -1 || preflightCloseOwner != -1 ||
       liveAdmittedOwner <= 0 ||
       liveHeldBundleCid != liveActivationCid ||
       provider.CsgCoreProductionAdmittedInputStateCurrent() !=
           provider.CsgCoreProductionAdmittedInputStateIssued:
        abortAdmittedOwner(liveAdmittedOwner)
        return fail("live ISSUE did not atomically move/publish owners")
    let staleAdmittedOwner = liveAdmittedOwner
    if !merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
           liveAdmittedOwner, liveErr):
        panic("live admitted owner abort failed")
    if liveAdmittedOwner != -1 || liveErr.len != 0 ||
       provider.CsgCoreProductionAdmittedInputStateCurrent() !=
           provider.CsgCoreProductionAdmittedInputStateAborted:
        return fail("abort authority did not atomically consume owner")
    var staleReplay = staleAdmittedOwner
    var staleErr: str
    if merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
           staleReplay, staleErr) || staleReplay != staleAdmittedOwner:
        return fail("stale admitted row was reauthorized")

    # Reusing the private slot must publish a new append-only row.  Aborting
    # the new owner once makes both copies permanently stale.
    var nextPreExecOwner: provider.CsgCoreProductionPreExecInputOwnerHandle
    var nextReceipt: provider.CsgCoreProductionPreExecInputOwnerReceipt
    var nextActivationBytes: str
    var nextActivationCid: str
    var nextEnvelopeCid: str
    var nextRootOwner: int32
    var nextRootBindingCid: str
    var nextBundleOwner: int32
    var nextErr: str
    if !issueFixtureOwners(
           nextPreExecOwner,
           nextReceipt,
           nextActivationBytes,
           nextActivationCid,
           nextEnvelopeCid,
           nextRootOwner,
           nextRootBindingCid,
           nextBundleOwner,
           nextErr):
        return fail(strings.ConcatStr(
            "next fixture owner issue rejected: ", nextErr))
    var nextAdmittedOwner: int32
    var nextHeldBundleCid: str
    if !provider.CsgCoreProductionHeldExecProviderIssueAdmittedInputInto(
           preflightCloseOwner,
           nextPreExecOwner.handleRow,
           nextRootOwner,
           nextBundleOwner,
           nextRootBindingCid,
           nextActivationBytes,
           nextAdmittedOwner,
           nextHeldBundleCid,
           nextErr):
        cleanupUnadmitted(
            nextPreExecOwner, nextRootOwner, nextBundleOwner)
        return fail(strings.ConcatStr("next ISSUE rejected: ", nextErr))
    if nextAdmittedOwner <= staleAdmittedOwner ||
       nextHeldBundleCid != nextActivationCid:
        abortAdmittedOwner(nextAdmittedOwner)
        return fail("reused slot did not publish append-only identity")
    let nextStaleOwner = nextAdmittedOwner
    if !merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
           nextAdmittedOwner, nextErr) || nextAdmittedOwner != -1:
        panic("new admitted owner abort failed")
    var nextReplay = nextStaleOwner
    if merkle_store.ProductionAdmittedClaimAuthorityAbortInto(
           nextReplay, nextErr) || nextReplay != nextStaleOwner:
        return fail("single-consumed owner copy was reauthorized")

    os.WriteLine(
        os.Get_stdout(),
        "csg_core_production_admitted_input_preclaim_smoke ok")
    os.WriteLine(
        os.Get_stdout(),
        "root_bundle_owner_failure_atomicity=pass")
    os.WriteLine(
        os.Get_stdout(),
        "admitted_owner_single_consume_stale_row=pass")
    os.WriteLine(
        os.Get_stdout(),
        "durable_terminal_journal_dynamic_status=HARD_RED")
    return 0
