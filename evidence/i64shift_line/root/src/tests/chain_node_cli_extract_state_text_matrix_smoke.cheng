import cheng/apps/chain_node/chain_node_cli_core as cli

fn main(): int32 =
    var nodeId: str
    var payloadHex: str

    # M1: full valid triple, trailing newline (loop path: phase0 ok -> phase1 ok -> phase2 ok)
    nodeId = ""
    payloadHex = ""
    assert(cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nnode_id=abc\npayload_hex=deadbeef\n", nodeId, payloadHex),
           " M1: valid triple should succeed")
    assert(nodeId == "abc", " M1: nodeId mismatch")
    assert(payloadHex == "deadbeef", " M1: payloadHex mismatch")

    # M2: valid triple, no trailing newline (tail path: elif phase==2 branch)
    nodeId = ""
    payloadHex = ""
    assert(cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nnode_id=abc\npayload_hex=deadbeef", nodeId, payloadHex),
           " M2: valid triple w/o trailing nl should succeed")
    assert(nodeId == "abc", " M2: nodeId mismatch")
    assert(payloadHex == "deadbeef", " M2: payloadHex mismatch")

    # M3: bad magic within loop (phase0 if-branch: line != magic -> false)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("not-the-magic\nnode_id=abc\npayload_hex=deadbeef\n", nodeId, payloadHex),
           " M3: bad magic should fail")

    # M4: malformed node_id line, prefix mismatch w/ sufficient length (phase1 if-branch)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nwrongprefix=abc\npayload_hex=deadbeef\n", nodeId, payloadHex),
           " M4: bad node_id prefix should fail")

    # M4b: malformed node_id line, insufficient length (phase1 if-branch, len<=8 short-circuit)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nnode_id\npayload_hex=deadbeef\n", nodeId, payloadHex),
           " M4b: short node_id line should fail")

    # M5: malformed payload_hex line (phase2 if-branch)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nnode_id=abc\nwrongprefixxxx=deadbeef\n", nodeId, payloadHex),
           " M5: bad payload_hex prefix should fail")

    # M6: extra non-empty line after phase3 complete, within loop (final fallthrough return false)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nnode_id=abc\npayload_hex=deadbeef\nextra_line\n", nodeId, payloadHex),
           " M6: trailing extra line after phase3 should fail")

    # M7: blank line skipped mid-stream, still succeeds (len(line)<=0 continue branch)
    nodeId = ""
    payloadHex = ""
    assert(cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\n\nnode_id=abc\npayload_hex=deadbeef\n", nodeId, payloadHex),
           " M7: blank line mid-stream should still succeed")
    assert(nodeId == "abc", " M7: nodeId mismatch")
    assert(payloadHex == "deadbeef", " M7: payloadHex mismatch")

    # M8: empty text (phase never advances, end-of-function phase!=3 check)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("", nodeId, payloadHex),
           " M8: empty text should fail")

    # M9: only magic line, stream ends mid-phase (phase!=3 at function end)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\n", nodeId, payloadHex),
           " M9: magic-only text should fail")

    # M10: tail path bad magic, no newline at all (tail if phase==0 branch)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("short-nomagic", nodeId, payloadHex),
           " M10: tail-path bad magic should fail")

    # M11: tail path bad node_id, magic via loop, no trailing nl (tail elif phase==1 branch)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nbadnodeline", nodeId, payloadHex),
           " M11: tail-path bad node_id should fail")

    # M12: tail path bad payload_hex, magic+node_id via loop, no trailing nl (tail elif phase==2 branch)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nnode_id=abc\nbadpayloadline", nodeId, payloadHex),
           " M12: tail-path bad payload_hex should fail")

    # M13: tail path else-branch, full triple via loop plus trailing unterminated extra text (phase==3 already)
    nodeId = ""
    payloadHex = ""
    assert(!cli.ChainNodeCliExtractStateText("cheng.chain_node.state.v1\nnode_id=abc\npayload_hex=deadbeef\nextra_no_newline", nodeId, payloadHex),
           " M13: tail-path else branch (phase already 3) should fail")

    echo(" chain_node_cli_extract_state_text_matrix_smoke ok")
    return 0
