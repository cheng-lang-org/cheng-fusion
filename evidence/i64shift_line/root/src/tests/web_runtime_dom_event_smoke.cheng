import cheng/core/runtime/web_runtime as web

fn WebRuntimeDomEventDocumentSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let button = web.WebDocumentCreateElement(document, "button")
    let label = web.WebDocumentCreateText(document, "Run")

    if web.WebDocumentNodeCount(document) != 4:
        return 1
    if web.WebDocumentMutationCount(document) != 4:
        return 37
    if web.WebDocumentMutationKindAt(document, 3) != web.WebMutationKindCreateNode:
        return 38
    var mutationName: str
    if !web.WebDocumentMutationNameAt(document, 3, mutationName):
        return 39
    if mutationName != "#text":
        return 40
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 2
    if !web.WebDocumentAppendChild(document, root, button):
        return 3
    if !web.WebDocumentAppendChild(document, button, label):
        return 4
    if web.WebDocumentAppendChild(document, label, label):
        return 5
    if web.WebDocumentAppendChild(document, root, label):
        return 6
    if web.WebDocumentAppendChild(document, label, docNode):
        return 7
    if web.WebDocumentChildCount(document, root) != 1:
        return 8
    if web.WebDocumentChildAt(document, root, 0) != button:
        return 9

    var tagName: str
    if !web.WebDocumentNodeTagName(document, button, tagName):
        return 10
    if tagName != "button":
        return 11
    var textContent: str
    if !web.WebDocumentNodeTextContent(document, label, textContent):
        return 12
    if textContent != "Run":
        return 13
    if !web.WebDocumentSetAttribute(document, button, "id", "run"):
        return 14
    if !web.WebDocumentSetAttribute(document, button, "role", "button"):
        return 15
    if web.WebDocumentGetElementById(document, "run") != button:
        return 150
    if web.WebDocumentGetElementById(document, "missing") != 0:
        return 151
    if web.WebDocumentMutationCount(document) != 9:
        return 41
    if web.WebDocumentMutationKindAt(document, 8) != web.WebMutationKindSetAttribute:
        return 42
    var mutationValue: str
    if !web.WebDocumentMutationValueAt(document, 8, mutationValue):
        return 43
    if mutationValue != "button":
        return 44
    var attr: str
    if !web.WebDocumentGetAttribute(document, button, "role", attr):
        return 16
    if attr != "button":
        return 17
    if web.WebDocumentSetAttribute(document, label, "id", "bad"):
        return 18
    if web.WebDocumentMutationCount(document) != 9:
        return 45

    if !web.WebDocumentAddEventListener(document, root, "click", 10, true, false):
        return 19
    if !web.WebDocumentAddEventListener(document, button, "click", 20, false, false):
        return 20
    if !web.WebDocumentAddEventListener(document, button, "click", 40, false, true):
        return 21
    if !web.WebDocumentAddEventListener(document, root, "click", 30, false, false):
        return 22

    if web.WebDocumentDispatchEvent(document, button, "click") != 4:
        return 23
    if web.WebDocumentDispatchTraceCount(document) != 4:
        return 24
    if web.WebDocumentDispatchTraceHandlerAt(document, 0) != 10:
        return 25
    if web.WebDocumentDispatchTracePhaseAt(document, 0) != web.WebEventPhaseCapture:
        return 26
    if web.WebDocumentDispatchTraceHandlerAt(document, 1) != 20:
        return 27
    if web.WebDocumentDispatchTracePhaseAt(document, 1) != web.WebEventPhaseTarget:
        return 28
    if web.WebDocumentDispatchTraceHandlerAt(document, 2) != 40:
        return 29
    if web.WebDocumentDispatchTraceHandlerAt(document, 3) != 30:
        return 30
    if web.WebDocumentDispatchTracePhaseAt(document, 3) != web.WebEventPhaseBubble:
        return 31

    if web.WebDocumentDispatchEvent(document, button, "click") != 3:
        return 32
    if web.WebDocumentDispatchTraceCount(document) != 3:
        return 33
    if web.WebDocumentDispatchTraceHandlerAt(document, 0) != 10:
        return 34
    if web.WebDocumentDispatchTraceHandlerAt(document, 1) != 20:
        return 35
    if web.WebDocumentDispatchTraceHandlerAt(document, 2) != 30:
        return 36
    return 0

fn WebRuntimeDomEventStorageSmoke(): int32 =
    var storage: web.WebStorage
    web.WebStorageInit(storage)
    if web.WebStorageLength(storage) != 0:
        return 46
    var stored: str
    if web.WebStorageGetItem(storage, "theme", stored):
        return 47
    if stored != "":
        return 48
    if !web.WebStorageSetItem(storage, "theme", "dark"):
        return 49
    if web.WebStorageLength(storage) != 1:
        return 50
    if !web.WebStorageGetItem(storage, "theme", stored):
        return 51
    if stored != "dark":
        return 52
    if !web.WebStorageSetItem(storage, "theme", "light"):
        return 53
    if web.WebStorageLength(storage) != 1:
        return 54
    if !web.WebStorageGetItem(storage, "theme", stored):
        return 55
    if stored != "light":
        return 56
    if web.WebStorageRemoveItem(storage, "missing"):
        return 57
    if !web.WebStorageRemoveItem(storage, "theme"):
        return 58
    if web.WebStorageLength(storage) != 0:
        return 59
    if !web.WebStorageSetItem(storage, "token", "abc"):
        return 60
    web.WebStorageClear(storage)
    if web.WebStorageLength(storage) != 0:
        return 61

    var window: web.WebWindow
    web.WebWindowInit(window)
    if web.WebWindowScrollY(window) != 0:
        return 520
    if !web.WebWindowSetScroll(window, 3, 21):
        return 521
    if web.WebWindowScrollX(window) != 3:
        return 522
    if web.WebWindowScrollY(window) != 21:
        return 523
    if web.WebWindowInnerWidth(window) != 1024:
        return 524
    if !web.WebWindowSetViewport(window, 100, 100):
        return 525
    if web.WebWindowInnerWidth(window) != 100:
        return 553
    if web.WebWindowInnerHeight(window) != 100:
        return 526
    if web.WebWindowScrollY(window) != 21:
        return 554
    var intersectionDocument: web.WebDocument
    web.WebDocumentInit(intersectionDocument)
    let intersectionRoot = web.WebDocumentCreateDocumentNode(intersectionDocument)
    let observedNode = web.WebDocumentCreateElement(intersectionDocument, "section")
    if !web.WebDocumentAppendChild(intersectionDocument, intersectionRoot, observedNode):
        return 527
    web.WebDocumentSetBoundingRect(intersectionDocument, observedNode, 10, 30, 20, 20)
    var observedX: int32
    var observedY: int32
    var observedW: int32
    var observedH: int32
    if !web.WebDocumentGetBoundingClientRect(intersectionDocument, observedNode, observedX, observedY, observedW, observedH):
        return 551
    if observedW != 20 || observedH != 20:
        return 552
    var observer: web.WebIntersectionObserver
    if !web.WebIntersectionObserverInit(observer, 501, 150):
        return 528
    if web.WebIntersectionObserverThresholdPermille(observer) != 150:
        return 549
    if !web.WebIntersectionObserverObserve(observer, intersectionDocument, window, observedNode):
        return 529
    if web.WebIntersectionObserverObservedCount(observer) != 1:
        return 530
    if web.WebIntersectionObserverRecordCount(observer) != 1:
        return 531
    if web.WebIntersectionObserverRecordRatioPermille(observer, 0) < 150:
        return 550
    if !web.WebIntersectionObserverRecordIsIntersecting(observer, 0):
        return 532
    if web.WebIntersectionObserverRecordTarget(observer, 0) != observedNode:
        return 533
    if web.WebWindowDispatchTraceHandlerAt(window, web.WebWindowDispatchTraceCount(window) - 1) != 501:
        return 534
    var intersectionRecords: web.WebIntersectionObserverEntry[]
    if web.WebIntersectionObserverTakeRecords(observer, intersectionRecords) != 1:
        return 535
    if web.WebIntersectionObserverRecordCount(observer) != 0:
        return 536
    if !web.WebWindowSetScroll(window, 0, 200):
        return 537
    if web.WebIntersectionObserverEvaluate(observer, intersectionDocument, window) != 1:
        return 538
    if web.WebIntersectionObserverRecordIsIntersecting(observer, 0):
        return 539
    web.WebIntersectionObserverDisconnect(observer)
    if web.WebIntersectionObserverObservedCount(observer) != 0:
        return 540
    var mediaQuery: web.WebMediaQueryList
    if !web.WebWindowMatchMediaList(window, "(min-width: 768px)", mediaQuery):
        return 541
    if !mediaQuery.matches:
        return 542
    if !web.WebMediaQueryListAddEventListener(mediaQuery, "change", 401):
        return 543
    if !web.WebMediaQueryListAddListener(mediaQuery, 402):
        return 544
    if web.WebMediaQueryListListenerCount(mediaQuery) != 2:
        return 545
    if !web.WebMediaQueryListRemoveEventListener(mediaQuery, "change", 401):
        return 546
    if !web.WebMediaQueryListRemoveListener(mediaQuery, 402):
        return 547
    if web.WebMediaQueryListListenerCount(mediaQuery) != 0:
        return 548
    if web.WebWindowLocalStorageLength(window) != 0:
        return 62
    if !web.WebWindowLocalStorageSetItem(window, "window-key", "window-value"):
        return 63
    if web.WebWindowLocalStorageLength(window) != 1:
        return 64
    if !web.WebWindowLocalStorageGetItem(window, "window-key", stored):
        return 65
    if stored != "window-value":
        return 66
    if web.WebWindowLocalStorageRemoveItem(window, "missing"):
        return 67
    if !web.WebWindowLocalStorageRemoveItem(window, "window-key"):
        return 68
    if web.WebWindowLocalStorageLength(window) != 0:
        return 69
    if !web.WebWindowLocalStorageSetItem(window, "clear-key", "clear-value"):
        return 70
    web.WebWindowLocalStorageClear(window)
    if web.WebWindowLocalStorageLength(window) != 0:
        return 71
    if !web.WebWindowAddEventListener(window, "resize", 90, false, false):
        return 152
    if !web.WebWindowAddEventListener(window, "resize", 91, true, true):
        return 153
    if web.WebWindowDispatchEvent(window, "resize") != 2:
        return 154
    if web.WebWindowDispatchTraceCount(window) != 2:
        return 155
    if web.WebWindowDispatchTraceHandlerAt(window, 0) != 90:
        return 156
    if web.WebWindowDispatchTraceHandlerAt(window, 1) != 91:
        return 157
    if web.WebWindowDispatchTracePhaseAt(window, 1) != web.WebEventPhaseTarget:
        return 158
    if web.WebWindowDispatchEvent(window, "resize") != 1:
        return 159
    if !web.WebWindowRemoveEventListener(window, "resize", 90, false):
        return 160
    if web.WebWindowDispatchEvent(window, "resize") != 0:
        return 161
    return 0

fn WebRuntimeDomEventObjectSmoke(): int32 =
    var document: web.WebDocument
    web.WebDocumentInit(document)
    let docNode = web.WebDocumentCreateDocumentNode(document)
    let root = web.WebDocumentCreateElement(document, "div")
    let button = web.WebDocumentCreateElement(document, "button")
    if !web.WebDocumentAppendChild(document, docNode, root):
        return 170
    if !web.WebDocumentAppendChild(document, root, button):
        return 171
    if !web.WebDocumentAddEventListener(document, root, "click", 101, true, false):
        return 172
    if !web.WebDocumentAddEventListener(document, button, "click", 102, false, false):
        return 173
    if !web.WebDocumentAddEventListener(document, root, "click", 103, false, false):
        return 174

    var click: web.WebEvent
    if !web.WebEventNew("click", click):
        return 175
    if click.type != "click":
        return 176
    if click.bubbles:
        return 177
    if click.cancelable:
        return 178
    if !web.WebDispatchEvent(document, button, click):
        return 179
    if click.target != button:
        return 180
    if click.currentTarget != 0:
        return 181
    if click.eventPhase != 0:
        return 182
    if web.WebDocumentDispatchTraceCount(document) != 2:
        return 183
    if web.WebDocumentDispatchTraceHandlerAt(document, 0) != 101:
        return 184
    if web.WebDocumentDispatchTracePhaseAt(document, 0) != web.WebEventPhaseCapture:
        return 185
    if web.WebDocumentDispatchTraceHandlerAt(document, 1) != 102:
        return 186
    if web.WebDocumentDispatchTracePhaseAt(document, 1) != web.WebEventPhaseTarget:
        return 187

    var bubble: web.WebEvent
    if !web.WebEventNewWithOptions("click", true, true, bubble):
        return 188
    if !bubble.bubbles:
        return 189
    if !bubble.cancelable:
        return 190
    if !web.WebDispatchEvent(document, button, bubble):
        return 191
    if web.WebDocumentDispatchTraceCount(document) != 3:
        return 192
    if web.WebDocumentDispatchTraceHandlerAt(document, 0) != 101:
        return 193
    if web.WebDocumentDispatchTraceHandlerAt(document, 1) != 102:
        return 194
    if web.WebDocumentDispatchTraceHandlerAt(document, 2) != 103:
        return 195
    if web.WebDocumentDispatchTracePhaseAt(document, 2) != web.WebEventPhaseBubble:
        return 196

    if !web.WebDocumentAddEventListener(document, docNode, "ready", 104, false, false):
        return 197
    var ready: web.WebEvent
    if !web.WebEventNew("ready", ready):
        return 198
    if !web.WebDocumentDispatchEventObject(document, ready):
        return 199
    if web.WebDocumentDispatchTraceCount(document) != 1:
        return 200
    if web.WebDocumentDispatchTraceHandlerAt(document, 0) != 104:
        return 201
    if ready.target != docNode:
        return 202

    var window: web.WebWindow
    web.WebWindowInit(window)
    if !web.WebWindowAddEventListener(window, "resize", 201, false, false):
        return 203
    if !web.WebWindowAddEventListener(window, "resize", 202, false, true):
        return 204
    var resize: web.WebEvent
    if !web.WebEventNew("resize", resize):
        return 205
    if !web.WebWindowDispatchEventObject(window, resize):
        return 206
    if web.WebWindowDispatchTraceCount(window) != 2:
        return 207
    if web.WebWindowDispatchTraceHandlerAt(window, 0) != 201:
        return 208
    if web.WebWindowDispatchTraceHandlerAt(window, 1) != 202:
        return 209
    if resize.eventPhase != 0:
        return 210
    if !web.WebWindowDispatchEventObject(window, resize):
        return 211
    if web.WebWindowDispatchTraceCount(window) != 1:
        return 212
    return 0

