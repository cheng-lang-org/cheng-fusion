fn WebRuntimeDomEventBodyDatasetSmoke(): int32 =
    var rootDocument: web.WebDocument
    web.WebDocumentInit(rootDocument)
    var documentElement: int32
    if !web.WebDocumentEnsureDocumentElement(rootDocument, documentElement):
        return 524
    if documentElement == 0:
        return 525
    var documentElementTag: str
    if !web.WebDocumentNodeTagName(rootDocument, documentElement, documentElementTag):
        return 526
    if documentElementTag != "html":
        return 527
    let documentElementParent = web.WebDocumentParentOf(rootDocument, documentElement)
    if web.WebDocumentNodeKind(rootDocument, documentElementParent) != web.WebNodeKindDocument:
        return 528
    var secondDocumentElement: int32
    if !web.WebDocumentEnsureDocumentElement(rootDocument, secondDocumentElement):
        return 529
    if secondDocumentElement != documentElement:
        return 530

    var bodyDocument: web.WebDocument
    web.WebDocumentInit(bodyDocument)
    var bodyNode: int32
    if !web.WebDocumentEnsureBody(bodyDocument, bodyNode):
        return 72
    if bodyNode == 0:
        return 73
    if web.WebDocumentNodeCount(bodyDocument) != 2:
        return 74
    if web.WebDocumentMutationCount(bodyDocument) != 3:
        return 75
    var bodyTagName: str
    if !web.WebDocumentNodeTagName(bodyDocument, bodyNode, bodyTagName):
        return 76
    if bodyTagName != "body":
        return 77
    let bodyParentNode = web.WebDocumentParentOf(bodyDocument, bodyNode)
    if bodyParentNode == 0:
        return 78
    if web.WebDocumentNodeKind(bodyDocument, bodyParentNode) != web.WebNodeKindDocument:
        return 83
    if web.WebDocumentChildAt(bodyDocument, bodyParentNode, 0) != bodyNode:
        return 84
    var secondBodyNode: int32
    if !web.WebDocumentEnsureBody(bodyDocument, secondBodyNode):
        return 79
    if secondBodyNode != bodyNode:
        return 80
    if web.WebDocumentNodeCount(bodyDocument) != 2:
        return 81
    if web.WebDocumentMutationCount(bodyDocument) != 3:
        return 82

    var manualBodyDocument: web.WebDocument
    web.WebDocumentInit(manualBodyDocument)
    let manualDocNode = web.WebDocumentCreateDocumentNode(manualBodyDocument)
    let manualBodyNode = web.WebDocumentCreateElement(manualBodyDocument, "body")
    if !web.WebDocumentAppendChild(manualBodyDocument, manualDocNode, manualBodyNode):
        return 85
    var ensuredManualBodyNode: int32
    if !web.WebDocumentEnsureBody(manualBodyDocument, ensuredManualBodyNode):
        return 86
    if ensuredManualBodyNode != manualBodyNode:
        return 87
    if web.WebDocumentMutationCount(manualBodyDocument) != 3:
        return 88
    if !web.WebDocumentRemoveChild(manualBodyDocument, manualDocNode, manualBodyNode):
        return 89
    var recreatedBodyNode: int32
    if !web.WebDocumentEnsureBody(manualBodyDocument, recreatedBodyNode):
        return 90
    if recreatedBodyNode == manualBodyNode:
        return 91
    if web.WebDocumentParentOf(manualBodyDocument, recreatedBodyNode) != manualDocNode:
        return 92
    if !web.WebDocumentSetDatasetValue(manualBodyDocument, recreatedBodyNode, "composerSubmits", "2"):
        return 93
    var dataAttr: str
    if !web.WebDocumentGetAttribute(manualBodyDocument, recreatedBodyNode, "data-composer-submits", dataAttr):
        return 94
    if dataAttr != "2":
        return 95
    var datasetValue: str
    if !web.WebDocumentGetDatasetValue(manualBodyDocument, recreatedBodyNode, "composerSubmits", datasetValue):
        return 96
    if datasetValue != "2":
        return 97
    if !web.WebDocumentSetDatasetValue(manualBodyDocument, recreatedBodyNode, "astrologyReady", "1"):
        return 98
    if !web.WebDocumentGetAttribute(manualBodyDocument, recreatedBodyNode, "data-astrology-ready", dataAttr):
        return 99
    if dataAttr != "1":
        return 100
    if web.WebDocumentSetDatasetValue(manualBodyDocument, recreatedBodyNode, "bad-name", "x"):
        return 101
    return 0

fn WebRuntimeDomEventOpsSmoke(): int32 =
    var opsDocument: web.WebDocument
    web.WebDocumentInit(opsDocument)
    let opsDoc = web.WebDocumentCreateDocumentNode(opsDocument)
    let opsRoot = web.WebDocumentCreateElement(opsDocument, "section")
    let opsChild = web.WebDocumentCreateElement(opsDocument, "article")
    let opsOther = web.WebDocumentCreateElement(opsDocument, "span")
    let opsReplacement = web.WebDocumentCreateElement(opsDocument, "p")
    if !web.WebDocumentAppendChild(opsDocument, opsDoc, opsRoot):
        return 102
    if !web.WebDocumentAppendChild(opsDocument, opsRoot, opsChild):
        return 103
    if !web.WebDocumentContains(opsDocument, opsRoot, opsChild):
        return 104
    if !web.WebDocumentContains(opsDocument, opsChild, opsChild):
        return 105
    if web.WebDocumentContains(opsDocument, opsChild, opsRoot):
        return 106
    if !web.WebDocumentInsertBefore(opsDocument, opsRoot, opsOther, opsChild):
        return 107
    if web.WebDocumentChildAt(opsDocument, opsRoot, 0) != opsOther:
        return 108
    if !web.WebDocumentReplaceChild(opsDocument, opsRoot, opsReplacement, opsChild):
        return 162
    if web.WebDocumentChildAt(opsDocument, opsRoot, 1) != opsReplacement:
        return 163
    if web.WebDocumentParentOf(opsDocument, opsChild) != 0:
        return 164
    if !web.WebDocumentRemoveNode(opsDocument, opsOther):
        return 109
    if web.WebDocumentParentOf(opsDocument, opsOther) != 0:
        return 110
    if !web.WebDocumentSetAttribute(opsDocument, opsReplacement, "data-check", "ok"):
        return 111
    if !web.WebDocumentHasAttribute(opsDocument, opsReplacement, "data-check"):
        return 112
    if !web.WebDocumentRemoveAttribute(opsDocument, opsReplacement, "data-check"):
        return 113
    if web.WebDocumentHasAttribute(opsDocument, opsReplacement, "data-check"):
        return 114
    if web.WebDocumentRemoveAttribute(opsDocument, opsReplacement, "data-check"):
        return 115
    return 0

fn WebRuntimeDomEventDocumentStateSmoke(): int32 =
    var stateDocument: web.WebDocument
    web.WebDocumentInit(stateDocument)
    var visibility: str
    if !web.WebDocumentVisibilityState(stateDocument, visibility):
        return 116
    if visibility != "visible":
        return 117
    if web.WebDocumentHidden(stateDocument):
        return 118
    var headNode: int32
    if !web.WebDocumentEnsureHead(stateDocument, headNode):
        return 119
    if headNode == 0:
        return 120
    var headTag: str
    if !web.WebDocumentNodeTagName(stateDocument, headNode, headTag):
        return 121
    if headTag != "head":
        return 122
    var secondHead: int32
    if !web.WebDocumentEnsureHead(stateDocument, secondHead):
        return 123
    if secondHead != headNode:
        return 124
    if !web.WebDocumentSetVisibility(stateDocument, true, "hidden"):
        return 125
    if !web.WebDocumentHidden(stateDocument):
        return 126
    if !web.WebDocumentVisibilityState(stateDocument, visibility):
        return 127
    if visibility != "hidden":
        return 128
    if web.WebDocumentSetVisibility(stateDocument, true, "bad"):
        return 129
    return 0

fn WebRuntimeDomEventTextCodecSmoke(): int32 =
    var encoder: web.WebTextEncoder
    web.WebTextEncoderInit(encoder)
    var encoded: int32[]
    if !web.WebTextEncoderEncode(encoder, "hello", encoded):
        return 130
    if encoded.len != 5:
        return 131
    if encoded[0] != int32('h') || encoded[4] != int32('o'):
        return 132
    var decoder: web.WebTextDecoder
    web.WebTextDecoderInit(decoder)
    var decoded: str
    var invalid: int32[]
    add(invalid, 256)
    if web.WebTextDecoderDecode(decoder, invalid, decoded):
        return 133
    if decoded != "":
        return 134
    let standaloneEncoded = web.WebTextEncoderEncodeString("ok")
    if standaloneEncoded.len != 2:
        return 135
    return 0

fn main(): int32 =
    var code = WebRuntimeDomEventDocumentSmoke()
    if code != 0:
        echo(Fmt"FAIL WebRuntimeDomEventDocumentSmoke: {code}")
        return code
    code = WebRuntimeDomEventStorageSmoke()
    if code != 0:
        echo(Fmt"FAIL WebRuntimeDomEventStorageSmoke: {code}")
        return code
    code = WebRuntimeDomEventObjectSmoke()
    if code != 0:
        echo(Fmt"FAIL WebRuntimeDomEventObjectSmoke: {code}")
        return code
    code = WebRuntimeDomEventFocusSmoke()
    if code != 0:
        echo(Fmt"FAIL WebRuntimeDomEventFocusSmoke: {code}")
        return code
    code = WebRuntimeDomEventBodyDatasetSmoke()
    if code != 0:
        echo(Fmt"FAIL WebRuntimeDomEventBodyDatasetSmoke: {code}")
        return code
    code = WebRuntimeDomEventOpsSmoke()
    if code != 0:
        echo(Fmt"FAIL WebRuntimeDomEventOpsSmoke: {code}")
        return code
    code = WebRuntimeDomEventDocumentStateSmoke()
    if code != 0:
        echo(Fmt"FAIL WebRuntimeDomEventDocumentStateSmoke: {code}")
        return code
    code = WebRuntimeDomEventTextCodecSmoke()
    if code != 0:
        echo(Fmt"FAIL WebRuntimeDomEventTextCodecSmoke: {code}")
        return code
    echo(" web_runtime_dom_event_smoke ok")
    return 0
