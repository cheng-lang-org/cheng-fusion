iginal ? 'translate-x-5' : 'translate-x-0'}`} />\n                                        </button>\n                                    </div>\n                                    {isOriginal && (\n                                        <div className=\"mt-3 rounded-xl bg-purple-50 px-3 py-2 text-xs leading-5 text-purple-900\">\n                                            <div>{originalTexts.onBody}</div>\n                                            <div className=\"mt-1 text-purple-700\">{originalTexts.proofHint}</div>\n                                            <div className=\"mt-2 font-semibold\">{originalTexts.confirm}</div>\n                                        </div>\n                                    )}\n                                </div>\n                            )}\n                            {contentKind === 'movie' && (\n                                <div className=\"border-t border-gray-100 px-4 py-3\">\n                                    <div className=\"flex items-center justify-between gap-3\">\n                                        <div>\n                                            <div className=\"text-sm font-semibold text-gray-700\">{movieTexts.distributionTitle}</div>\n                                            <div className=\"mt-1 text-xs leading-5 text-gray-500\">{movieTexts.distributionOff}</div>\n                                        </div>\n                                        <button\n                                            type=\"button\"\n                                            onClick={() => setHasDistributionRights(!hasDistributionRights)}\n                                            className={`relative h-6 w-11 shrink-0 rounded-full transition-colors duration-200 ${hasDistributionRights ? 'bg-purple-500' : 'bg-gray-300'}`}\n                                        >\n                                            <span className={`absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transitio