'border-gray-200 bg-gray-50 text-gray-800'}\n                                        ${isNewEnergy && !char && !isSelected ? 'border-dashed border-green-300 bg-green-50' : ''}\n                                    `}\n                                    onClick={(e) => {\n                                        e.stopPropagation();\n                                        if (isNewEnergy) {\n                                            onNewEnergyChange(!isNewEnergyVehicle);\n                                            return;\n                                        }\n                                        setActiveIndex(i);\n                                    }}\n                                >\n                                    <span className=\"font-semibold text-lg\">{char}</span>\n                                    {isNewEnergy && !char && !isSelected && <span className=\"text-[9px] text-green-400\">新能源</span>}\n                                </div>\n                            );\n                        })}\n                    </div>\n\n                    <div className=\"p-2 space-y-2\">\n                        {showProvinces ? (\n                            // Provinces Keyboard\n                            <div className=\"grid grid-cols-9 gap-1.5\">\n                                {PROVINCES.map((prov) => (\n                                    <button\n                                        key={prov}\n                                        className=\"h-10 bg-white rounded shadow-sm text-gray-800 font-medium active:bg-gray-200 transition-colors\"\n                                        onClick={(e) => { e.stopPropagation(); handleKeyClick(prov); }}\n                                    >\n                                        {prov}\n                                    </button>\n                                ))}\n                            </div>\n                        ) : (\n                            // Alphanumeric Keyboard\n                            <div className=\"flex flex-col gap-2\">\n                                {ALPHANUMERIC_KEYBOARD.map((row, i) => (\n                                    <div key={i} className={`flex justify-center gap-1.5 ${i === 3 ? 'px-8 pr-16 relative' : ''}`}>\n                                        {row.map((char) => {\n                                            const isIorO = char === 'I' || char === 'O';\n                                            const disabled = activeIndex === 1 && (char >= '0' && char <= '9'); // 2nd char must be letter\n                                            return (\n                                                <button\n                                                    key={char}\n                                                    disabled={disabled || (activeIndex !== 0 && activeIndex !== 1 && isIorO)} // Generally I/O not allowed besides city code? Actually I/O generally not allowed in plates except in some special cases, let's just make it simple\n                                                    className={`h-11 flex-1 min-w-[28px] max-w-[40px] rounded shadow-sm font-medium transition-colors\n                                                        ${disabled ? 'bg-gray-200 text-gray-400 opacity-50' : 'bg-white text-gray-800 active:bg-gray-200'}\n                                                    `}\n                                                    onClick={(e) => { e.stopPropagation(); handleKeyClick(char); }}\n                                                >\n                                                    {char}\n                                                </button>\n                                            );\n                                        })}\n                                        {i === 3 && (\n                                            <button\n                                                className=\"absolute right-0 top-0 bottom-0 w-14 bg-gray-300 rounded shadow-sm flex items-center justify-center active:bg-gray-400 transition-colors\"\n                                                onClick={(e) => { e.stopPropagation(); handleDelete(); }}\n                                            >\n                                                <Delete size={20} className=\"text-gray-700\" />\n                                            </button>\n                                        )}\n                                    </div>\n                                ))}\n                            </div>\n                        )}\n                    </div>\n                </div>\n            )}", __csgElement2727):
