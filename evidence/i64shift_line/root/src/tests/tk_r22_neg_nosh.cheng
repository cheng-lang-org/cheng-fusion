type
    R22EdgeV =
        targetModulePath: str
        targetSourcePath: str
        targetSourcePathLen: int32
        targetSourcePathFirstCode: int32
        targetSourcePathLastCode: int32

fn R22MakePathV(root: str, modulePath: str): str =
    return Fmt"{root}/{modulePath}.cheng"

fn R22AppendV(edges: var R22EdgeV[], root: str, modulePath: str): bool =
    var sourcePath = ""
    if modulePath == "":
        return false
    sourcePath = R22MakePathV(root, modulePath)
    var edge: R22EdgeV
    edge.targetModulePath = modulePath
    edge.targetSourcePath = sourcePath
    edge.targetSourcePathLen = sourcePath.len
    edge.targetSourcePathFirstCode = Int32(sourcePath[0])
    edge.targetSourcePathLastCode = Int32(sourcePath[sourcePath.len - 1])
    add(edges, edge)
    return true

fn main(): int32 =
    var edges: R22EdgeV[]
    if R22AppendV(edges, "src", ""):
        return 10
    if !R22AppendV(edges, "src", "core/lang/parser"):
        return 11
    if !R22AppendV(edges, "src", "a"):
        return 12
    if edges.len != 2:
        return 13
    if edges[0].targetSourcePath != "src/core/lang/parser.cheng":
        return 14
    if edges[0].targetSourcePathLen != 26:
        return 15
    if edges[0].targetSourcePathFirstCode != 115:
        return 16
    if edges[0].targetSourcePathLastCode != 103:
        return 17
    if edges[1].targetSourcePath != "src/a.cheng":
        return 18
    if edges[1].targetSourcePathLen != 11:
        return 19
    if edges[1].targetModulePath != "a":
        return 20
    let width = edges[0].targetSourcePathLen + edges[1].targetSourcePathLen
    if width != 37:
        return 21
    echo("tk_r22_neg ok n=2 first=src/core/lang/parser.cheng second=src/a.cheng width=37")
    return 0
