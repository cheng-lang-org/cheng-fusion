# Runtime verification for S7b (docs/video-seek-scrub-blueprint.md §S7, audio-parallel of
# S5-A/f6eb23a7e — 音频ES预取写盘 + 游标序贯推进), added to
# web_scene_media_network_bridge.cheng (WebSceneMediaAudioEsPrefetchTick + a pause gate on
# WebSceneMediaAvPrefetch). Real QUIC client against a real media_moq_publisher_main process
# serving the real maitian ES fixture — no mocked network, no faked cache, no python at
# test-run time.
#
# Audio ES has NO GOP/keyframe structure (every ADTS AU decodes independently), so
# WebSceneMediaAudioEsPrefetchTick scans FIXED webSceneMediaEsBatchFrames(=96)-frame blocks
# instead of keyframe-aligned GOPs — the oracle below is independent-of-this-binary python3
# struct.unpack of the real maitian.aidx (sr=48000 ch=2 count=259, same ground truth
# media_moq_audio_es_index_cursor_seek_check_main.cheng already verified) plus a direct
# byte-slice of the real maitian.aac at the offsets/lengths that parse produced — computed
# ONCE this session, hardcoded here as literals (mirrors media_moq_es_prefetch_tick_check_main
# .cheng's hardcoded gopIdx/gopLen oracle arrays), never re-derived by this Cheng binary:
#   block 0   (frames   0.. 95): byte[    0,  50108)  len= 50108
#   block 96  (frames  96..191): byte[50108,  99932)  len= 49824
#   block 192 (frames 192..258): byte[99932, 134675)  len= 34743  (last partial block, 67
#                                                                   frames not 96 — count=259)
#
# Three独立 OS processes drive this file via --mode, so the S4 audio-block-cache writes from
# one process are read back by a genuinely separate process (mirrors
# media_moq_es_prefetch_tick_check_main.cheng's --mode split and
# media_moq_block_cache_roundtrip_check_main.cheng's cross-process pattern):
#   --mode fill    Opens a fresh audio+video ES session (order matters: audio ES's own
#                   one-shot announce dial must complete and close BEFORE video ES's
#                   persistent dial opens, or the reference publisher's single-threaded
#                   serial accept loop stalls the second dial — verified this session).
#                   Calls WebSceneMediaAudioEsPrefetchTick(1) five times from the initial
#                   cursor (frame 0) and asserts:
#                     1. calls 1-3 each return 1 (one block fetched+cached each) and the
#                        pump cursor lands at 96, then 192, then 258 (clamped: frame count
#                        259 means frame 258 is the last valid index, AdvanceCursor's own
#                        end-of-stream clamp — never 259) — "cursor 序贯推进".
#                     2. each of the 3 cached blocks' bytes, read back via
#                        WebSceneMediaBlockCacheGetAudio, match the independent oracle
#                        EXACTLY (full byte-for-byte compare against a direct slice of the
#                        real maitian.aac read straight off disk — not merely a length
#                        check).
#                     3. calls 4-5 (window already fully cached — cursor's own block is
#                        block 192, already cached by call 3) ALSO return 1 (window
#                        processed, all hits) with the cursor unmoved at 258 — the
#                        SAME-process half of the "already-cached block, zero network"
#                        plateau check; the CALLER (shell harness driving this binary,
#                        which owns the publisher's stderr log) asserts the publisher's own
#                        "served moq-aframe" line count is EXACTLY 3 after all five calls —
#                        not 5 — proving calls 4-5 issued no network request at all.
#   --mode resume-replay   A SEPARATE process, SEPARATE connection, SAME --root (the disk
#                   cache --mode fill just populated). Opens fresh audio+video ES (pump
#                   cursor starts back at 0 in this new process) and makes ONE
#                   WebSceneMediaAudioEsPrefetchTick(3) call covering all three blocks in
#                   one window. Asserts rc==1, cursor lands at 258 (same deterministic
#                   terminus as --mode fill), and all three blocks' bytes still match the
#                   oracle exactly, read back by THIS process from disk written by the
#                   OTHER process. The CALLER asserts this invocation's slice of the
#                   publisher's log shows ZERO "served moq-aframe" lines — a real
#                   cross-process cache hit, zero network (verify② + the plateau
#                   methodology f6eb23a7e's replay-cached mode established).
#   --mode pause    A SEPARATE process, SEPARATE connection, its OWN empty --root. Opens
#                   fresh audio+video ES, records WebSceneMediaEsDialedPort(), then:
#                     1. WebSceneMediaEsSetPaused(true); WebSceneMediaAvPrefetch(0,0) must
#                        return 0 (the new pause gate — both ES sessions are open, so a 0
#                        here can only be the pause check, not the pre-existing
#                        "not open" gate); WebSceneMediaAudioEsPrefetchTick(1) must return
#                        4; the pump cursor must stay 0 and block 0 must stay an
#                        independent cache miss (Get returns Err) — paused really did zero
#                        I/O and zero disk writes.
#                     2. WebSceneMediaEsSetPaused(false); WebSceneMediaAudioEsPrefetchTick(1)
#                        now actually fetches (rc==1), the cursor advances to 96, block 0
#                        becomes a real cache hit matching the oracle byte length, and
#                        WebSceneMediaEsDialedPort() is UNCHANGED from the value recorded
#                        right after open — no redial happened between pause and resume (no
#                        API call in this test's own code path could have redialed it
#                        either — the reuse is structural, not merely observed).
#
# ★ Honest scope note: WebSceneMediaAudioEsFrameFetch's cache-miss path is DELIBERATELY left
# ungated by this slice — its video-side equivalent (WebSceneMediaEsFrameFetch) has no pause
# gate either (read directly off :977 this session), so gating audio only would be a NEW
# asymmetry between the two media types for the exact same call shape, not a fix. This test
# does not assert AudioEsFrameFetch returns any "gate code" while paused; that would be
# testing behavior this slice intentionally did not add.
#
# Any failure prints a reason and exits nonzero; success prints "<MODE>_OK" and exits 0.

import std/os
import std/rawbytes
import std/strutils as strutil
import std/cmdline as cmdline
import cheng/core/runtime/web_scene_media_network_bridge as media_bridge
import cheng/core/runtime/web_scene_media_block_cache as blockcache

fn fail(msg: str): int32 =
    os.WriteLine(os.Get_stdout(), strutil.Join(["FAIL: ", msg], ""))
    return 1

# Independent python3 oracle for real maitian.aidx/maitian.aac (see header comment) —
# webSceneMediaEsBatchFrames(=96)-aligned fixed blocks, NOT GOPs. Plain if/elif lookups
# (not global array vars: module-level `var x: int32[] = [...]` initializers do not run
# on this compiler — verified this session, len() reads back 0 — local-scope array
# literals inside a function body work fine, which is what every OTHER oracle array in
# this file below uses).
fn oracleBlockStartAt(idx: int32): int32 =
    if idx == 0: return 0
    if idx == 1: return 96
    return 192

fn oracleBlockOffAt(idx: int32): int32 =
    if idx == 0: return 0
    if idx == 1: return 50108
    return 99932

fn oracleBlockLenAt(idx: int32): int32 =
    if idx == 0: return 50108
    if idx == 1: return 49824
    return 34743

let oracleFrameCount: int32 = 259
let oracleSampleRate: int32 = 48000
let oracleChannels: int32 = 2

fn bytesEqualSlice(cached: Bytes, sourceFull: Bytes, srcOff: int32, wantLen: int32): bool =
    if BytesLen(cached) != wantLen:
        return false
    var i: int32 = 0
    while i < wantLen:
        if rawbytes.BytesGet(cached, i) != rawbytes.BytesGet(sourceFull, srcOff + i):
            return false
        i = i + 1
    return true

# Shared open sequence: audio ES's own one-shot announce/aidx dial must complete (and
# close) BEFORE video ES's persistent dial starts, or the reference publisher's
# single-threaded serial accept loop stalls the second dial while the first (video's
# persistent) connection is still held open — verified this session against a real
# media_moq_publisher_main. Returns the assetCid on success, "" on failure (having
# already printed a FAIL line).
fn openBoth(host: str, port: int32): str =
    if !media_bridge.WebSceneMediaAudioEsOpen(host, port):
        fail(strutil.Join(["audio_es_open failed: ", media_bridge.WebSceneMediaAudioEsLastError()], ""))
        return ""
    if media_bridge.WebSceneMediaAudioEsFrameCount() != oracleFrameCount:
        fail(strutil.Join(["audio frame count mismatch: got=", IntToStr(media_bridge.WebSceneMediaAudioEsFrameCount()),
                            " want=", IntToStr(oracleFrameCount), " (independent oracle)"], ""))
        return ""
    if media_bridge.WebSceneMediaAudioSampleRate() != oracleSampleRate:
        fail(strutil.Join(["audio sample rate mismatch: got=", IntToStr(media_bridge.WebSceneMediaAudioSampleRate())], ""))
        return ""
    if media_bridge.WebSceneMediaAudioChannels() != oracleChannels:
        fail(strutil.Join(["audio channel count mismatch: got=", IntToStr(media_bridge.WebSceneMediaAudioChannels())], ""))
        return ""
    if !media_bridge.WebSceneMediaEsOpen(host, port):
        fail(strutil.Join(["video_es_open failed: ", media_bridge.WebSceneMediaEsLastError()], ""))
        return ""
    let assetCid: str = media_bridge.WebSceneMediaEsAssetCid()
    if assetCid.len == 0:
        fail("asset_cid empty after video open")
        return ""
    return assetCid

fn assertBlockMatchesOracle(assetCid: str, aacBytes: Bytes, idx: int32): bool =
    let blockStart: int32 = oracleBlockStartAt(idx)
    let blockOff: int32 = oracleBlockOffAt(idx)
    let blockLen: int32 = oracleBlockLenAt(idx)
    let getRes: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGetAudio(assetCid, blockStart)
    if IsErr(getRes):
        fail(strutil.Join(["block ", IntToStr(blockStart), " cache Get returned Err: ", Error(getRes)], ""))
        return false
    if !bytesEqualSlice(Value(getRes), aacBytes, blockOff, blockLen):
        fail(strutil.Join(["block ", IntToStr(blockStart), " bytes do not match independent oracle (offset=",
                            IntToStr(blockOff), " len=", IntToStr(blockLen), ")"], ""))
        return false
    return true

fn runFill(host: str, port: int32, root: str, aacPath: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    let aacRes: Result[Bytes] = os.ReadFileBytesResult(aacPath)
    if IsErr(aacRes):
        return fail(strutil.Join(["failed reading --aac ", aacPath, ": ", Error(aacRes)], ""))
    let aacBytes: Bytes = Value(aacRes)

    let assetCid: str = openBoth(host, port)
    if assetCid.len == 0:
        return 1
    os.WriteLine(os.Get_stdout(), strutil.Join(["step1_open_ok assetCid=", assetCid], ""))

    var expectedCursor: int32[] = [96, 192, 258]
    var i: int32 = 0
    while i < 3:
        let rc: int32 = media_bridge.WebSceneMediaAudioEsPrefetchTick(1)
        if rc != 1:
            return fail(strutil.Join(["fill tick", IntToStr(i), " rc=", IntToStr(rc), " want=1 err=",
                                       media_bridge.WebSceneMediaAudioEsLastError()], ""))
        let cursor: int32 = media_bridge.WebSceneMediaAudioEsPumpCursor()
        if cursor != expectedCursor[i]:
            return fail(strutil.Join(["fill tick", IntToStr(i), " cursor=", IntToStr(cursor),
                                       " want=", IntToStr(expectedCursor[i])], ""))
        if !assertBlockMatchesOracle(assetCid, aacBytes, i):
            return 1
        i = i + 1
    os.WriteLine(os.Get_stdout(), "step2_three_blocks_fetched_cursor_advanced_bytes_match_oracle_ok")

    # Calls 4-5: the cursor's own block (192) is already cached — these must still return
    # 1 (window processed, all-hit) and must NOT move the cursor past the clamped end.
    var j: int32 = 0
    while j < 2:
        let rc2: int32 = media_bridge.WebSceneMediaAudioEsPrefetchTick(1)
        if rc2 != 1:
            return fail(strutil.Join(["plateau tick", IntToStr(j), " rc=", IntToStr(rc2), " want=1"], ""))
        if media_bridge.WebSceneMediaAudioEsPumpCursor() != 258:
            return fail(strutil.Join(["plateau tick", IntToStr(j), " cursor moved: got=",
                                       IntToStr(media_bridge.WebSceneMediaAudioEsPumpCursor()), " want=258"], ""))
        j = j + 1
    os.WriteLine(os.Get_stdout(), "step3_plateau_ticks_no_cursor_move_ok")

    os.WriteLine(os.Get_stdout(), "FILL_OK")
    return 0

fn runResumeReplay(host: str, port: int32, root: str, aacPath: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    let aacRes: Result[Bytes] = os.ReadFileBytesResult(aacPath)
    if IsErr(aacRes):
        return fail(strutil.Join(["failed reading --aac ", aacPath, ": ", Error(aacRes)], ""))
    let aacBytes: Bytes = Value(aacRes)

    let assetCid: str = openBoth(host, port)
    if assetCid.len == 0:
        return 1
    if media_bridge.WebSceneMediaAudioEsPumpCursor() != 0:
        return fail("fresh process pump cursor != 0 before replay")
    os.WriteLine(os.Get_stdout(), "step1_reopen_fresh_cursor_zero_ok")

    let rc: int32 = media_bridge.WebSceneMediaAudioEsPrefetchTick(3)
    if rc != 1:
        return fail(strutil.Join(["replay PrefetchTick(3) rc=", IntToStr(rc), " want=1 err=",
                                   media_bridge.WebSceneMediaAudioEsLastError()], ""))
    if media_bridge.WebSceneMediaAudioEsPumpCursor() != 258:
        return fail(strutil.Join(["replay cursor=", IntToStr(media_bridge.WebSceneMediaAudioEsPumpCursor()), " want=258"], ""))
    os.WriteLine(os.Get_stdout(), "step2_single_call_covers_full_window_ok")

    var i: int32 = 0
    while i < 3:
        if !assertBlockMatchesOracle(assetCid, aacBytes, i):
            return 1
        i = i + 1
    os.WriteLine(os.Get_stdout(), "step3_cross_process_disk_bytes_match_oracle_ok")

    os.WriteLine(os.Get_stdout(), "RESUME_REPLAY_OK")
    return 0

fn runPause(host: str, port: int32, root: str): int32 =
    if !blockcache.WebSceneMediaBlockCacheInit(root):
        return fail(strutil.Join(["Init(root) failed: ", root], ""))
    let assetCid: str = openBoth(host, port)
    if assetCid.len == 0:
        return 1
    let dialedPortAfterOpen: int32 = media_bridge.WebSceneMediaEsDialedPort()
    os.WriteLine(os.Get_stdout(), "step1_open_ok")

    media_bridge.WebSceneMediaEsSetPaused(true)
    if !media_bridge.WebSceneMediaEsPaused():
        return fail("SetPaused(true) did not flip Paused()")
    let avRc: int32 = media_bridge.WebSceneMediaAvPrefetch(0, 0)
    if avRc != 0:
        return fail(strutil.Join(["paused AvPrefetch rc=", IntToStr(avRc), " want=0"], ""))
    let tickRc: int32 = media_bridge.WebSceneMediaAudioEsPrefetchTick(1)
    if tickRc != 4:
        return fail(strutil.Join(["paused PrefetchTick rc=", IntToStr(tickRc), " want=4"], ""))
    if media_bridge.WebSceneMediaAudioEsPumpCursor() != 0:
        return fail(strutil.Join(["paused PrefetchTick moved cursor: got=",
                                   IntToStr(media_bridge.WebSceneMediaAudioEsPumpCursor()), " want=0"], ""))
    let missDuringPause: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGetAudio(assetCid, 0)
    if IsOk(missDuringPause):
        return fail("paused PrefetchTick wrote cache for block 0 — should have been a no-op")
    os.WriteLine(os.Get_stdout(), "step2_paused_zero_io_gate_codes_ok")

    media_bridge.WebSceneMediaEsSetPaused(false)
    if media_bridge.WebSceneMediaEsPaused():
        return fail("SetPaused(false) did not flip Paused() back")
    let resumeRc: int32 = media_bridge.WebSceneMediaAudioEsPrefetchTick(1)
    if resumeRc != 1:
        return fail(strutil.Join(["resume PrefetchTick rc=", IntToStr(resumeRc), " want=1 err=",
                                   media_bridge.WebSceneMediaAudioEsLastError()], ""))
    if media_bridge.WebSceneMediaAudioEsPumpCursor() != 96:
        return fail(strutil.Join(["resume cursor=", IntToStr(media_bridge.WebSceneMediaAudioEsPumpCursor()), " want=96"], ""))
    let hitAfterResume: Result[Bytes] = blockcache.WebSceneMediaBlockCacheGetAudio(assetCid, 0)
    if IsErr(hitAfterResume):
        return fail("resume PrefetchTick did not cache block 0")
    if BytesLen(Value(hitAfterResume)) != oracleBlockLenAt(0):
        return fail(strutil.Join(["resume block0 len=", IntToStr(BytesLen(Value(hitAfterResume))),
                                   " want=", IntToStr(oracleBlockLenAt(0))], ""))
    if media_bridge.WebSceneMediaEsDialedPort() != dialedPortAfterOpen:
        return fail(strutil.Join(["resume redialed a different port: got=", IntToStr(media_bridge.WebSceneMediaEsDialedPort()),
                                   " want=", IntToStr(dialedPortAfterOpen)], ""))
    os.WriteLine(os.Get_stdout(), "step3_resume_fetches_same_connection_ok")

    os.WriteLine(os.Get_stdout(), "PAUSE_OK")
    return 0

fn main(): int32 =
    var hostRaw: str
    let hasHost: bool = cmdline.ReadFirstFlagValue("--host", hostRaw)
    let host: str = if hasHost: hostRaw else: "127.0.0.1"
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 38000)
    var rootRaw: str
    let hasRoot: bool = cmdline.ReadFirstFlagValue("--root", rootRaw)
    if !hasRoot:
        return fail("missing --root")
    var aacRaw: str
    let hasAac: bool = cmdline.ReadFirstFlagValue("--aac", aacRaw)
    var modeRaw: str
    let hasMode: bool = cmdline.ReadFirstFlagValue("--mode", modeRaw)
    let mode: str = if hasMode: modeRaw else: "fill"

    if mode == "fill":
        if !hasAac:
            return fail("missing --aac <path to real maitian.aac> for --mode fill")
        return runFill(host, port, rootRaw, aacRaw)
    if mode == "resume-replay":
        if !hasAac:
            return fail("missing --aac <path to real maitian.aac> for --mode resume-replay")
        return runResumeReplay(host, port, rootRaw, aacRaw)
    if mode == "pause":
        return runPause(host, port, rootRaw)
    return fail(strutil.Join(["unknown --mode: ", mode], ""))
