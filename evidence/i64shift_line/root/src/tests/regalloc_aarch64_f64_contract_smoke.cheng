import cheng/core/ir/core_types as ir
import cheng/core/backend/regalloc_single_pass as alloc
import cheng/core/backend/regalloc_aarch64_adapter as adapter
import cheng/core/backend/codegen_contract as contract
import cheng/core/backend/aarch64_encode as a64
import cheng/core/backend/regalloc_production_emitter as emitter
import cheng/core/backend/regalloc_production_artifacts as artifacts
import cheng/core/ir/body_ir_access as access
import cheng/core/lang/typed_expr as texpr

fn newBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    body.typeArenaArtifactCid.data[0] = uint8(1)
    return body

fn makeF64Slot(id: int32, isParam: bool): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "f"
    slot.typeKind = ir.LocalF64Tag
    slot.stackOffset = 16 + id * 8
    if isParam:
        slot.stackOffset = 0 - 1 - id
    slot.sizeBytes = 8
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makeI32Slot(id: int32): ir.LocalSlot =
    var slot: ir.LocalSlot
    slot.id = id
    slot.name = "i"
    slot.typeKind = ir.LocalI32Tag
    slot.stackOffset = 16 + id * 8
    slot.sizeBytes = 4
    slot.alignBytes = 4
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn appendReturn(body: var ir.BodyIR,
                slotIndex: int32,
                typeKind: int32): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = slotIndex
    add(term.operands, typeKind)
    return ir.BodyIRAppendTerm(body, term)

fn appendVoidReturn(body: var ir.BodyIR): int32 =
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    return ir.BodyIRAppendTerm(body, term)

fn producerRecipeIndex(
        plan: var alloc.RegallocSinglePassValuePlan,
        prepared: var contract.RegallocA64FunctionRecipes,
        opIndex: int32,
        opKind: int32): int32 =
    var found: int32 = -1
    for actionIndex in 0..<prepared.recipes.len:
        if actionIndex >= plan.actions.len:
            return -2
        let recipe = prepared.recipes[actionIndex]
        if plan.actions[actionIndex].opIndex != opIndex ||
           recipe.producerOpKind != opKind || !recipe.ownsBodyOp:
            continue
        if found >= 0:
            return -2
        found = actionIndex
    return found

fn wordsContain(words: var int32[], target: int32): bool =
    for wordIndex in 0..<words.len:
        if words[wordIndex] == target:
            return true
    return false

fn decodeUnsignedMemory(word: int32,
                        load: var bool,
                        width: var int32,
                        rt: var int32,
                        rn: var int32,
                        byteOffset: var int32): bool =
    let bits = uint32(word)
    let opcode = bits & uint32(0xffc00000)
    if opcode == uint32(0xf9000000) ||
       opcode == uint32(0xf9400000):
        width = 8
    elif opcode == uint32(0xb9000000) ||
         opcode == uint32(0xb9400000):
        width = 4
    else:
        return false
    load = opcode == uint32(0xf9400000) ||
           opcode == uint32(0xb9400000)
    rt = int32(bits & uint32(31))
    rn = int32((bits >> uint32(5)) & uint32(31))
    byteOffset = int32(
        (bits >> uint32(10)) & uint32(4095)) * width
    return true

fn decodeCsetCondition(word: int32,
                       rd: var int32,
                       cond: var int32): bool =
    let bits = uint32(word)
    if (bits & uint32(0xffff0fe0)) != uint32(0x1a9f07e0):
        return false
    let inverted = int32(
        (bits >> uint32(12)) & uint32(15))
    cond = inverted ^ 1
    if cond < 0 || cond > 13:
        return false
    rd = int32(bits & uint32(31))
    return true

fn decodeFcmpD(word: int32,
               rn: var int32,
               rm: var int32): bool =
    let bits = uint32(word)
    if (bits & uint32(0xffe0fc1f)) != uint32(0x1e602000):
        return false
    rn = int32((bits >> uint32(5)) & uint32(31))
    rm = int32((bits >> uint32(16)) & uint32(31))
    return true

fn wordsContainDecodedFcmp(words: var int32[],
                           expectedRn: int32,
                           expectedRm: int32): bool =
    var found: int32
    for wordIndex in 0..<words.len:
        var rn: int32
        var rm: int32
        if decodeFcmpD(words[wordIndex], rn, rm) &&
           rn == expectedRn && rm == expectedRm:
            found = found + 1
    return found == 1

fn wordsDecodedCsetCondition(words: var int32[],
                             expectedCond: int32): bool =
    var found: int32
    for wordIndex in 0..<words.len:
        var rd: int32
        var cond: int32
        if decodeCsetCondition(words[wordIndex], rd, cond):
            if cond != expectedCond || rd < 0 || rd >= 31:
                return false
            found = found + 1
    return found == 1

fn independentCondHolds(cond: int32,
                        n: bool,
                        z: bool,
                        c: bool,
                        v: bool): bool =
    if cond == 0:
        return z
    if cond == 1:
        return !z
    if cond == 2:
        return c
    if cond == 3:
        return !c
    if cond == 4:
        return n
    if cond == 5:
        return !n
    if cond == 6:
        return v
    if cond == 7:
        return !v
    if cond == 8:
        return c && !z
    if cond == 9:
        return !c || z
    if cond == 10:
        return n == v
    if cond == 11:
        return n != v
    if cond == 12:
        return !z && n == v
    if cond == 13:
        return z || n != v
    return false

fn verifyIngressF64(
        recipes: var contract.RegallocA64FunctionRecipes,
        slotIndex: int32,
        paramOrdinal: int32): bool =
    if slotIndex < 0 || slotIndex >= recipes.localStackOffsets.len ||
       paramOrdinal < 0 ||
       paramOrdinal >= recipes.parameterHomeOffsets.len:
        return false
    let homeOffset = recipes.parameterHomeOffsets[paramOrdinal]
    if homeOffset < 0 || recipes.localStackOffsets[slotIndex] != homeOffset:
        return false
    var found: int32
    for ingressIndex in 0..<recipes.abiIngressParamOrdinals.len:
        if recipes.abiIngressParamOrdinals[ingressIndex] != paramOrdinal:
            continue
        if ingressIndex >= recipes.abiIngressOffsets.len ||
           ingressIndex >= recipes.abiIngressRegs.len ||
           ingressIndex >= recipes.abiIngressWidths.len ||
           ingressIndex >= recipes.abiIngressWordIndices.len ||
           ingressIndex >= recipes.abiIngressWordCounts.len ||
           recipes.abiIngressOffsets[ingressIndex] != homeOffset ||
           recipes.abiIngressRegs[ingressIndex] != paramOrdinal ||
           recipes.abiIngressWidths[ingressIndex] != 8 ||
           recipes.abiIngressWordCounts[ingressIndex] != 1:
            return false
        let wordIndex = recipes.abiIngressWordIndices[ingressIndex]
        if wordIndex < 0 || wordIndex >= recipes.prologueWords.len ||
           wordIndex >= recipes.functionWords.len ||
           recipes.prologueWords[wordIndex] !=
               recipes.functionWords[wordIndex]:
            return false
        var isLoad: bool
        var width: int32
        var rt: int32
        var rn: int32
        var byteOffset: int32
        if !decodeUnsignedMemory(
               recipes.functionWords[wordIndex],
               isLoad, width, rt, rn, byteOffset) ||
           isLoad || width != recipes.abiIngressWidths[ingressIndex] ||
           width != 8 || rt != paramOrdinal || rn != 31 ||
           byteOffset != homeOffset:
            return false
        found = found + 1
    return found == 1

fn buildF64BinBody(opKind: int32): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeF64Slot(0, true))
    add(body.localSlots, makeF64Slot(1, true))
    add(body.localSlots, makeF64Slot(2, false))
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpBinOpTag
    op.target = 2
    add(op.operands, ir.LocalF64Tag)
    add(op.operands, opKind)
    add(op.operands, 0)
    add(op.operands, 1)
    add(body.ops, op)
    let termIndex = appendReturn(body, 2, ir.LocalF64Tag)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn f64OpWord(opKind: int32): int32 =
    if opKind == int32(texpr.TypedExprIrOpF64Add):
        return a64.A64EncFaddD(16, 16, 17)
    if opKind == int32(texpr.TypedExprIrOpF64Sub):
        return a64.A64EncFsubD(16, 16, 17)
    if opKind == int32(texpr.TypedExprIrOpF64Mul):
        return a64.A64EncFmulD(16, 16, 17)
    if opKind == int32(texpr.TypedExprIrOpF64Div):
        return a64.A64EncFdivD(16, 16, 17)
    return 0

fn verifyF64Bin(opKind: int32): int32 =
    var body = buildF64BinBody(opKind)
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 1
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid || prepared.parameterHomeOffsets.len != 2 ||
       prepared.localStackOffsets.len != 3:
        return 2
    for paramIndex in 0..<2:
        if !verifyIngressF64(prepared, paramIndex, paramIndex):
            return 3
    let recipeIndex = producerRecipeIndex(
        plan, prepared, 0, ir.BodyOpBinOpTag)
    if recipeIndex < 0:
        return 7
    var words = prepared.recipes[recipeIndex].words
    let opWord = f64OpWord(opKind)
    if opWord == 0 ||
       !wordsContain(words, a64.A64EncFmovDx(16, a64.A64X16)) ||
       !wordsContain(words, a64.A64EncFmovDx(17, a64.A64X17)) ||
       !wordsContain(words, opWord) ||
       !wordsContain(words, a64.A64EncFmovXd(a64.A64X16, 16)):
        return 8
    if prepared.termRecipes.len != 1 ||
       prepared.termRecipes[0].words.len <= 0 ||
       prepared.termRecipes[0].words[0] !=
           a64.A64EncFmovDx(0, a64.A64X0):
        return 9
    return 0

fn buildF64CmpBody(cond: int32): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeF64Slot(0, true))
    add(body.localSlots, makeF64Slot(1, true))
    add(body.localSlots, makeI32Slot(2))
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCmpTag
    op.target = 2
    add(op.operands, cond)
    add(op.operands, 0)
    add(op.operands, 1)
    add(body.ops, op)
    let termIndex = appendReturn(body, 2, ir.LocalI32Tag)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn verifyF64Cmp(cond: int32, expectedCond: int32): int32 =
    var body = buildF64CmpBody(cond)
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 1
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid:
        return 2
    let recipeIndex = producerRecipeIndex(
        plan, prepared, 0, ir.BodyOpCmpTag)
    if recipeIndex < 0:
        return 3
    var words = prepared.recipes[recipeIndex].words
    if !wordsContain(words, a64.A64EncFmovDx(16, a64.A64X16)) ||
       !wordsContain(words, a64.A64EncFmovDx(17, a64.A64X17)) ||
       !wordsContainDecodedFcmp(words, 16, 17) ||
       !wordsDecodedCsetCondition(words, expectedCond):
        return 4
    return 0

fn buildF64CbrBody(cond: int32): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeF64Slot(0, true))
    add(body.localSlots, makeF64Slot(1, true))
    var cbr: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(cbr)
    cbr.kind = ir.BodyTermCbrTag
    cbr.conditionKind = cond
    cbr.resultSlot = 0
    cbr.lhsSlot = 0
    cbr.rhsSlot = 1
    cbr.trueBlock = 1
    cbr.falseBlock = 2
    let cbrIndex = ir.BodyIRAppendTerm(body, cbr)
    let trueIndex = appendVoidReturn(body)
    let falseIndex = appendVoidReturn(body)
    let _b0 = ir.BodyIRAppendBlock(body, 0, 0, cbrIndex)
    let _b1 = ir.BodyIRAppendBlock(body, 0, 0, trueIndex)
    let _b2 = ir.BodyIRAppendBlock(body, 0, 0, falseIndex)
    return body

fn verifyF64Cbr(cond: int32, expectedCond: int32): int32 =
    var body = buildF64CbrBody(cond)
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 1
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid || prepared.termRecipes.len != 3:
        return 2
    var recipe = prepared.termRecipes[0]
    if recipe.branchConditionCodes.len != 2 ||
       recipe.branchConditionCodes[0] != expectedCond ||
       recipe.branchConditionCodes[1] != -1 ||
       !wordsContainDecodedFcmp(recipe.words, 16, 17):
        return 3
    return 0

fn buildF64CallBody(importc: bool,
                    withArg: bool): ir.BodyIR =
    var body = newBody()
    var resultSlot: int32 = -1
    if withArg:
        add(body.localSlots, makeF64Slot(0, true))
    else:
        add(body.localSlots, makeF64Slot(0, false))
        resultSlot = 0
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "f64_callee"
    call.targetIsImportc = importc
    call.resultSlot = resultSlot
    call.resultPassKind = ir.BodyCallPassStackValueTag
    call.relocWordOffset = -1
    if withArg:
        add(call.argSlots, 0)
        add(call.argPassKinds, ir.BodyCallPassStackValueTag)
        add(call.argAbiSizes, 8)
    add(body.callSequence, call)
    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    op.target = resultSlot
    add(op.operands, 0)
    add(body.ops, op)
    var termIndex: int32
    if resultSlot >= 0:
        termIndex = appendReturn(body, resultSlot, ir.LocalF64Tag)
    else:
        termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn verifyF64CallBoundaries(): int32 =
    var body = buildF64CallBody(false, false)
    var constraints = alloc.RegallocTargetConstraintsA64Darwin()
    var plan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        body, constraints)
    if !plan.valid:
        return 1
    var prepared = adapter.RegallocA64PrepareFunctionActionRecipes(
        body, plan)
    if !prepared.valid:
        return 2
    var callRecipe: int32 = -1
    for recipeIndex in 0..<prepared.recipes.len:
        if prepared.recipes[recipeIndex].ownsCall:
            if callRecipe >= 0:
                return 3
            callRecipe = recipeIndex
    if callRecipe < 0 || prepared.recipes[callRecipe].relocs.len != 1:
        return 4
    let callWord = prepared.recipes[callRecipe].relocs[0].wordIndex
    if callWord < 0 ||
       callWord + 1 >= prepared.recipes[callRecipe].words.len ||
       prepared.recipes[callRecipe].words[callWord + 1] !=
           a64.A64EncFmovXd(a64.A64X0, 0):
        return 5
    var importResultBody = buildF64CallBody(true, false)
    var importResultConstraints =
        alloc.RegallocTargetConstraintsA64Darwin()
    var importResultPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        importResultBody, importResultConstraints)
    if !importResultPlan.valid:
        return 6
    var importResultPrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            importResultBody, importResultPlan)
    if importResultPrepared.valid:
        return 7
    var importArgBody = buildF64CallBody(true, true)
    var importArgConstraints =
        alloc.RegallocTargetConstraintsA64Darwin()
    var importArgPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        importArgBody, importArgConstraints)
    if !importArgPlan.valid:
        return 8
    var importArgPrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            importArgBody, importArgPlan)
    if importArgPrepared.valid:
        return 9
    return 0

const
    F64StoreDestinationLocal = 1
    F64StoreDestinationGlobal = 2
    F64StoreDestinationField = 3
    F64StoreDestinationIndex = 4

fn makeF64ParamSlot(id: int32,
                    paramOrdinal: int32): ir.LocalSlot =
    var slot = makeF64Slot(id, false)
    slot.stackOffset = 0 - 1 - paramOrdinal
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makePtrParamSlot(id: int32,
                    paramOrdinal: int32): ir.LocalSlot =
    var slot = makeI32Slot(id)
    slot.typeKind = ir.LocalPtrTag
    slot.stackOffset = 0 - 1 - paramOrdinal
    slot.sizeBytes = 8
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makeI32ParamSlot(id: int32,
                    paramOrdinal: int32): ir.LocalSlot =
    var slot = makeI32Slot(id)
    slot.stackOffset = 0 - 1 - paramOrdinal
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    return slot

fn makeAggregateParamSlot(id: int32,
                          paramOrdinal: int32): ir.LocalSlot =
    var slot = makeF64Slot(id, false)
    slot.typeKind = ir.LocalAggregateTag
    slot.stackOffset = 0 - 1 - paramOrdinal
    slot.sizeBytes = 64
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = ir.BodyPlaceParamAddressTag
    return slot

fn makeF64GlobalSlot(id: int32): ir.LocalSlot =
    var slot = makeF64Slot(id, false)
    slot.name = "f64_global_word"
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = ir.BodyPlaceGlobalAddressTag
    return slot

fn buildF64LocalStoreBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeF64ParamSlot(0, 0))
    add(body.localSlots, makeF64Slot(1, false))
    var copy: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(copy)
    copy.kind = ir.BodyOpStoreLocalTag
    copy.target = 1
    add(copy.operands, 0)
    add(body.ops, copy)
    let termIndex = appendReturn(body, 1, ir.LocalF64Tag)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildF64GlobalStoreBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeF64GlobalSlot(0))
    add(body.localSlots, makeF64ParamSlot(1, 0))
    var store: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(store)
    store.kind = ir.BodyOpGlobalStoreTag
    store.target = 1
    add(store.operands, 0)
    add(body.ops, store)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildF64FieldStoreBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makePtrParamSlot(0, 0))
    add(body.localSlots, makeF64ParamSlot(1, 1))
    var store: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(store)
    store.kind = ir.BodyOpFieldStoreTag
    store.target = 0
    add(store.operands, 0)
    add(store.operands, 1)
    add(store.operands, 8)
    add(store.operands, 8)
    add(body.ops, store)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn buildF64IndexedStoreBody(): ir.BodyIR =
    var body = newBody()
    add(body.localSlots, makeAggregateParamSlot(0, 0))
    add(body.localSlots, makeF64ParamSlot(1, 1))
    add(body.localSlots, makeI32ParamSlot(2, 2))
    var store: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(store)
    store.kind = ir.BodyOpIndexedStoreTag
    store.target = 0
    add(store.operands, 0)
    add(store.operands, 1)
    add(store.operands, 2)
    add(store.operands, 8)
    add(body.ops, store)
    let termIndex = appendVoidReturn(body)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    return body

fn decodeMov64(word: int32,
               rd: var int32,
               rm: var int32): bool =
    let bits = uint32(word)
    if (bits & uint32(0xffe0ffe0)) != uint32(0xaa0003e0):
        return false
    rd = int32(bits & uint32(31))
    rm = int32((bits >> uint32(16)) & uint32(31))
    return true

fn emissionWordOwnedByOp(
        emission: var emitter.RegallocProductionFunctionEmission,
        wordIndex: int32,
        opIndex: int32): bool =
    for fragmentIndex in 0..<emission.recipes.machineFragments.len:
        let fragment = emission.recipes.machineFragments[fragmentIndex]
        if fragment.siteKind != access.BodyIrAccessSiteOp ||
           fragment.siteIndex != opIndex ||
           (fragment.ownerKind !=
                contract.RegallocA64FragmentOwnerAction &&
            fragment.ownerKind !=
                contract.RegallocA64FragmentOwnerOp):
            continue
        if wordIndex >= fragment.wordStart &&
           wordIndex < fragment.wordStart + fragment.wordCount:
            return true
    return false

fn verifyF64StoreWords(
        emission: var emitter.RegallocProductionFunctionEmission,
        sourceSlot: int32,
        sourceParamOrdinal: int32,
        destinationKind: int32,
        destinationOffset: int32): bool =
    if !emission.valid || !verifyIngressF64(
           emission.recipes, sourceSlot, sourceParamOrdinal) ||
       sourceSlot < 0 ||
       sourceSlot >= emission.recipes.localStackOffsets.len:
        return false
    let sourceOffset = emission.recipes.localStackOffsets[sourceSlot]
    var tainted: bool[32]
    var sourceLoadCount: int32
    var destinationStoreCount: int32
    for wordIndex in 0..<emission.recipes.functionWords.len:
        if !emissionWordOwnedByOp(emission, wordIndex, 0):
            continue
        var isLoad: bool
        var width: int32
        var rt: int32
        var rn: int32
        var byteOffset: int32
        if decodeUnsignedMemory(
               emission.recipes.functionWords[wordIndex],
               isLoad, width, rt, rn, byteOffset):
            if width != 8:
                continue
            if isLoad:
                tainted[rt] = rn == 31 && byteOffset == sourceOffset
                if tainted[rt]:
                    sourceLoadCount = sourceLoadCount + 1
                continue
            var destination = false
            if destinationKind == F64StoreDestinationLocal:
                destination = rn == 31 &&
                              byteOffset == destinationOffset
            elif destinationKind == F64StoreDestinationGlobal:
                destination = rn == 17 && byteOffset == 0
            elif destinationKind == F64StoreDestinationField:
                destination = rn != 31 &&
                              byteOffset == destinationOffset
            elif destinationKind == F64StoreDestinationIndex:
                destination = rn == 17 && byteOffset == 0
            if destination:
                if rt < 0 || rt >= 32 || !tainted[rt]:
                    return false
                destinationStoreCount = destinationStoreCount + 1
            continue
        var rd: int32
        var rm: int32
        if decodeMov64(
               emission.recipes.functionWords[wordIndex], rd, rm):
            tainted[rd] = tainted[rm]
    return sourceLoadCount > 0 && destinationStoreCount == 1

fn verifyF64StoreContracts(): int32 =
    var noCalls: str[]
    var noData: str[]
    var localBody = buildF64LocalStoreBody()
    var localEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        localBody, "f64_local_store", 0, noCalls, noData,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !localEmission.valid ||
       localEmission.recipes.functionRelocs.len != 0 ||
       localEmission.recipes.localStackOffsets.len != 2 ||
       !verifyF64StoreWords(
           localEmission, 0, 0,
           F64StoreDestinationLocal,
           localEmission.recipes.localStackOffsets[1]):
        return 1

    var globalBody = buildF64GlobalStoreBody()
    var globalData: str[]
    add(globalData, "resolved_f64_global_word")
    add(globalData, "")
    var globalEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        globalBody, "f64_global_store", 0, noCalls, globalData,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !globalEmission.valid:
        return 10 + globalEmission.errorCode
    if globalEmission.recipes.functionRelocs.len != 2:
        return 3
    if globalEmission.recipes.functionRelocs[0].kind !=
           contract.RegallocA64RelocPage21 ||
       globalEmission.recipes.functionRelocs[1].kind !=
           contract.RegallocA64RelocPageOff12 ||
       globalEmission.recipes.functionRelocs[1].wordIndex !=
           globalEmission.recipes.functionRelocs[0].wordIndex + 1 ||
       globalEmission.recipes.functionRelocs[0].targetSymbol !=
           "resolved_f64_global_word" ||
       globalEmission.recipes.functionRelocs[1].targetSymbol !=
           "resolved_f64_global_word":
        return 4
    if !verifyF64StoreWords(
           globalEmission, 1, 0,
           F64StoreDestinationGlobal, 0):
        return 5

    var fieldBody = buildF64FieldStoreBody()
    var fieldEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        fieldBody, "f64_field_store", 0, noCalls, noData,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !fieldEmission.valid ||
       fieldEmission.recipes.functionRelocs.len != 0 ||
       !verifyF64StoreWords(
           fieldEmission, 1, 1,
           F64StoreDestinationField, 8):
        return 6

    var indexedBody = buildF64IndexedStoreBody()
    var indexedEmission = emitter.RegallocProductionEmitFunction(
        "arm64-apple-darwin",
        indexedBody, "f64_indexed_store", 0, noCalls, noData,
        0, artifacts.RegallocProductionFunctionKindNormal)
    if !indexedEmission.valid:
        return 20 + indexedEmission.errorCode
    if indexedEmission.recipes.functionRelocs.len != 0:
        return 8
    if !verifyF64StoreWords(
           indexedEmission, 1, 1,
           F64StoreDestinationIndex, 0):
        return 9
    return 0

fn verifyNaNConditionTruth(): int32 =
    var conditions: int32[] = [0, 1, 4, 9, 12, 10]
    var expected: int32[] = [0, 1, 0, 0, 0, 0]
    # ARM FCMP unordered writes NZCV=0011. Evaluate the architectural
    # condition table directly instead of asking the production encoder.
    for index in 0..<conditions.len:
        let actual = independentCondHolds(
            conditions[index], false, false, true, true)
        if actual != (expected[index] != 0):
            return index + 1
    return 0

fn verifyF64ExportEntryBoundary(): int32 =
    var argBody = buildF64BinBody(
        int32(texpr.TypedExprIrOpF64Add))
    argBody.entryIsCAbi = true
    if adapter.RegallocA64EntryAbiSupported(argBody):
        return 1
    var argConstraints =
        alloc.RegallocTargetConstraintsA64Darwin()
    var argPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        argBody, argConstraints)
    var argPrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            argBody, argPlan)
    if argPrepared.valid:
        return 2

    var returnBody = buildF64CallBody(false, false)
    returnBody.entryIsCAbi = true
    if !adapter.RegallocA64EntryAbiSupported(returnBody):
        return 3
    var returnConstraints =
        alloc.RegallocTargetConstraintsA64Darwin()
    var returnPlan = alloc.RegallocSinglePassValuePlanBuildDecoded(
        returnBody, returnConstraints)
    var returnPrepared =
        adapter.RegallocA64PrepareFunctionActionRecipes(
            returnBody, returnPlan)
    if !returnPrepared.valid:
        return 4
    return 0

fn main(): int32 =
    # B1: codegen unit composition root (dispatch fails closed without registration)
    if !adapter.RegallocA64CodegenUnitRegister():
        return 90
    let addCode = verifyF64Bin(int32(texpr.TypedExprIrOpF64Add))
    if addCode != 0:
        return 10 + addCode
    let subCode = verifyF64Bin(int32(texpr.TypedExprIrOpF64Sub))
    if subCode != 0:
        return 20 + subCode
    let mulCode = verifyF64Bin(int32(texpr.TypedExprIrOpF64Mul))
    if mulCode != 0:
        return 30 + mulCode
    let divCode = verifyF64Bin(int32(texpr.TypedExprIrOpF64Div))
    if divCode != 0:
        return 40 + divCode
    var conds: int32[] = [
        ir.BodyCondF64EqTag, ir.BodyCondF64NeTag,
        ir.BodyCondF64LtTag, ir.BodyCondF64LeTag,
        ir.BodyCondF64GtTag, ir.BodyCondF64GeTag]
    var expected: int32[] = [0, 1, 4, 9, 12, 10]
    for condIndex in 0..<conds.len:
        let cmpCode = verifyF64Cmp(
            conds[condIndex], expected[condIndex])
        if cmpCode != 0:
            return 60 + condIndex * 5 + cmpCode
        let cbrCode = verifyF64Cbr(
            conds[condIndex], expected[condIndex])
        if cbrCode != 0:
            return 100 + condIndex * 5 + cbrCode
    let callCode = verifyF64CallBoundaries()
    if callCode != 0:
        return 150 + callCode
    let exportCode = verifyF64ExportEntryBoundary()
    if exportCode != 0:
        return 170 + exportCode
    let nanCode = verifyNaNConditionTruth()
    if nanCode != 0:
        return 180 + nanCode
    let storeCode = verifyF64StoreContracts()
    if storeCode != 0:
        return 190 + storeCode
    return 0
