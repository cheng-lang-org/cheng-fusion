# disclosure feed smoke: deterministic rendering, exact figures, and the
# closure line flipping on a broken ledger.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_settlement as ssm
import cheng/apps/rwad/rwad_disclosure as dsc

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    var st = ssm.SsmInit()
    let a1 = Tag(20)
    let a2 = Tag(21)
    let c1 = ssm.SsmCredit(st, a1, Int64(500))
    if !c1.ok:
        return 1
    let c2 = ssm.SsmCredit(st, a2, Int64(300))
    if !c2.ok:
        return 1
    let l1 = ssm.SsmEscrowLock(st, Tag(30), a1, Int64(200), Int64(9999))
    if !l1.ok:
        return 1

    let r1 = dsc.DisclosureRender(st, "cycle-7")
    if !r1.ok:
        return 1
    let text1: str = r1.value
    # determinism: identical state renders byte-identical output
    let r2 = dsc.DisclosureRender(st, "cycle-7")
    if !r2.ok:
        return 1
    if text1 != r2.value:
        os.WriteLine(os.Get_stderr(), "render not deterministic")
        rc = rc + 1

    # exact facts present
    let hasA1 = dsc.DscContains(text1, "balance|")
    if !hasA1:
        os.WriteLine(os.Get_stderr(), "no balance lines")
        rc = rc + 1
    let hasLabel = dsc.DscContains(text1, "disclosure|cycle-7")
    if !hasLabel:
        os.WriteLine(os.Get_stderr(), "label line missing")
        rc = rc + 1
    let hasBurn = dsc.DscContains(text1, "pool|burn|0")
    if !hasBurn:
        os.WriteLine(os.Get_stderr(), "burn pool line wrong")
        rc = rc + 1
    let hasOut = dsc.DscContains(text1, "escrow|outstanding|200")
    if !hasOut:
        os.WriteLine(os.Get_stderr(), "outstanding line wrong (expect 200)")
        rc = rc + 1

    # closure: credited 800 == balances 600 + pools 0 + outstanding 200
    let cl1: str = dsc.DisclosureClosureLine(st, Int64(800))
    let closedOk = dsc.DscContains(cl1, "audit|closed|1|credited=800")
    if !closedOk:
        os.WriteLine(os.Get_stderr(), "closure should hold at 800")
        rc = rc + 1
    let cl2: str = dsc.DisclosureClosureLine(st, Int64(801))
    let closedBad = dsc.DscContains(cl2, "audit|closed|0|credited=801")
    if !closedBad:
        os.WriteLine(os.Get_stderr(), "closure should break at 801")
        rc = rc + 1

    # slash changes pools and outstanding; both move in the render
    let sl = ssm.SsmEscrowSlashWithSplit(st, Tag(30), Int64(100), a2)
    if !sl.ok:
        return 1
    let r3 = dsc.DisclosureRender(st, "cycle-8")
    if !r3.ok:
        return 1
    let hasReward = dsc.DscContains(r3.value, "escrow|outstanding|100")
    if !hasReward:
        os.WriteLine(os.Get_stderr(), "outstanding after slash wrong (expect 100)")
        rc = rc + 1
    let hasSafety = dsc.DscContains(r3.value, "pool|safety|95")
    if !hasSafety:
        os.WriteLine(os.Get_stderr(), "safety after slash wrong (expect 95)")
        rc = rc + 1

    if rc == 0:
        echo("disclosure_smoke ok")
    return rc
