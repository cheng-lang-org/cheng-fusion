import std/cmdline
import std/strformat
import std/rawbytes as rawbytes
import cheng/core/backend/object_symbols as osym

fn exactName(index: int32): str =
    return Fmt"任意符号_λ_shared_prefix_{index}"

fn exactBytes1(a: int32): str =
    var bytes = rawbytes.BytesAlloc(1)
    rawbytes.BytesSet(bytes, 0, a)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return out

fn exactBytes2(a: int32, b: int32): str =
    var bytes = rawbytes.BytesAlloc(2)
    rawbytes.BytesSet(bytes, 0, a)
    rawbytes.BytesSet(bytes, 1, b)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return out

fn exactBytes3(a: int32, b: int32, c: int32): str =
    var bytes = rawbytes.BytesAlloc(3)
    rawbytes.BytesSet(bytes, 0, a)
    rawbytes.BytesSet(bytes, 1, b)
    rawbytes.BytesSet(bytes, 2, c)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return out

fn exactBytes4(a: int32, b: int32, c: int32, d: int32): str =
    var bytes = rawbytes.BytesAlloc(4)
    rawbytes.BytesSet(bytes, 0, a)
    rawbytes.BytesSet(bytes, 1, b)
    rawbytes.BytesSet(bytes, 2, c)
    rawbytes.BytesSet(bytes, 3, d)
    let out = rawbytes.BytesToString(bytes)
    rawbytes.BytesFree(bytes)
    return out

fn main(): int32 =
    var symbols = osym.ObjectSymbolsInit()
    let count: int32 = 4096
    for symbolRow in 0..<count:
        let name = exactName(symbolRow)
        let added = osym.ObjectSymbolsAddDefined(
            symbols, name, 0, int64(symbolRow) * int64(4), int64(4), true)
        assert(added == symbolRow, "exact trie append row")
    let mode = cmdline.ParamCount() > 1 ? cmdline.ParamStr(1) : "positive"
    if mode == "root-shape":
        symbols.trieByteValues[0] = 0
        assert(osym.ObjectSymbolsFind(symbols, exactName(0)) == -2,
               "corrupt root accepted")
    if mode == "terminal-row":
        var terminalNodeRow: int32 = -1
        for nodeRow in 0..<symbols.trieSymbolRows.len:
            if symbols.trieSymbolRows[nodeRow] == 2048:
                terminalNodeRow = nodeRow
        assert(terminalNodeRow >= 0, "terminal mutation row missing")
        symbols.trieSymbolRows[terminalNodeRow] = count
        assert(osym.ObjectSymbolsFind(symbols, exactName(2048)) == -2,
               "corrupt terminal accepted")
    if mode == "duplicate-edge":
        var duplicateParentRow: int32 = -1
        for parentRow in 0..<symbols.trieFirstChildRows.len:
            let firstChildRow = symbols.trieFirstChildRows[parentRow]
            if firstChildRow >= 0 &&
               symbols.trieNextSiblingRows[firstChildRow] >= 0:
                duplicateParentRow = parentRow
                break
        assert(duplicateParentRow >= 0,
               "duplicate edge mutation parent missing")
        let firstChildRow = symbols.trieFirstChildRows[duplicateParentRow]
        let secondChildRow = symbols.trieNextSiblingRows[firstChildRow]
        symbols.trieByteValues[secondChildRow] =
            symbols.trieByteValues[firstChildRow]
        assert(osym.ObjectSymbolsExactIndexValid(symbols),
               "object symbols: duplicate exact trie edge rejected")
    assert(mode == "positive", "unknown exact trie mode")
    assert(osym.ObjectSymbolsExactIndexValid(symbols),
           "exact trie full validation")
    var reverseRow = count - 1
    while reverseRow >= 0:
        let name = exactName(reverseRow)
        assert(osym.ObjectSymbolsFind(symbols, name) == reverseRow,
               "exact trie reverse lookup")
        reverseRow = reverseRow - 1
    let duplicateName = exactName(2048)
    assert(osym.ObjectSymbolsAddDefined(
               symbols, duplicateName, 0, int64(8192), int64(4), true) ==
           2048,
           "exact trie duplicate row")
    assert(osym.ObjectSymbolsAddUndefined(
               symbols, exactName(2048), true) == -1,
           "defined symbol cannot become undefined")
    assert(osym.ObjectSymbolsFind(
               symbols, "任意符号_λ_shared_prefix_missing") == -1,
           "exact trie missing lookup")
    assert(osym.ObjectSymbolsAddUndefined(
               symbols, exactBytes2(0xc0, 0xaf), true) == -1,
           "UTF-8 overlong encoding accepted")
    assert(osym.ObjectSymbolsAddDefined(
               symbols, exactBytes3(0xed, 0xa0, 0x80),
               0, int64(0), int64(0), true) == -1,
           "UTF-8 surrogate accepted")
    assert(osym.ObjectSymbolsAddUndefined(
               symbols, exactBytes4(0xf4, 0x90, 0x80, 0x80), true) == -1,
           "UTF-8 code point above U+10FFFF accepted")
    assert(osym.ObjectSymbolsAddUndefined(
               symbols, exactBytes2(0xe2, 0x82), true) == -1,
           "UTF-8 truncated sequence accepted")
    assert(osym.ObjectSymbolsAddUndefined(
               symbols, exactBytes1(0x80), true) == -1,
           "UTF-8 isolated continuation accepted")
    assert(osym.ObjectSymbolsAddUndefined(
               symbols, exactBytes1(0), true) == -1,
           "ELF symbol embedded NUL accepted")
    assert(osym.ObjectSymbolsCount(symbols) == count,
           "invalid UTF-8 mutated object symbol rows")
    echo(Fmt"object_symbol_exact_trie=PASS rows={osym.ObjectSymbolsCount(symbols)} utf8_negative_count=6")
    return 0
