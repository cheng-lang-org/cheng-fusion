fn main(): int32 =
  var v: int32 = 1
  var steps: int32
  while v < 100:
    v = v * 2
    steps = steps + 1
  var hits: int32
  var n: int32
  while true:
    n = n + 1
    if n == 4:
      break
    hits = hits + 10
  if v == 128:
    if steps == 7:
      if hits == 30:
        echo("t_while=pass")
        return 0
  echo("t_while=fail")
  return 101
