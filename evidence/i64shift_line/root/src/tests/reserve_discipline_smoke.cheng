# reserve discipline smoke: unbacked mint ban, credit cap with boundary,
# TTL freeze blocking spend, monotone snapshot binding, conservation.

import std/os
import std/system
import cheng/std/bytes_layout as layout
import cheng/apps/rwad/rwad_reserve as rsv

fn Tag(b: int32): layout.FixedBytes32 =
    var raw = BytesAlloc(32)
    BytesSet(raw, 0, b)
    let res = layout.FixedBytes32FromBytes(raw)
    return res.value

fn main(): int32 =
    var rc: int32 = 0
    var book: rsv.ReserveBook
    let initRes = rsv.ResInit(book, Tag(1), Int64(10000), 500, Int64(604800000))
    if !initRes.ok:
        os.WriteLine(os.Get_stderr(), "init failed")
        return 1

    # wrong proof rejected
    let badMint = rsv.ResMint(book, Int64(100), Tag(99))
    if badMint.ok:
        os.WriteLine(os.Get_stderr(), "wrong proof mint accepted")
        rc = rc + 1

    # correct proof mints up to reserve
    let mint = rsv.ResMint(book, Int64(10000), Tag(1))
    if !mint.ok:
        os.WriteLine(os.Get_stderr(), "backed mint rejected")
        rc = rc + 1

    # one more unit would exceed the reserve: loud ban
    let overMint = rsv.ResMint(book, Int64(1), Tag(1))
    if overMint.ok:
        os.WriteLine(os.Get_stderr(), "unbacked mint accepted")
        rc = rc + 1

    var lines: rsv.CreditLine[]
    # cap is 5% of 10000 = 500
    let c1 = rsv.ResIssueCredit(book.mintedSupply, book.creditCapBp, lines, Tag(10), Int64(400), Int64(1000))
    if !c1.ok:
        os.WriteLine(os.Get_stderr(), "credit 400 rejected")
        rc = rc + 1
    let c2 = rsv.ResIssueCredit(book.mintedSupply, book.creditCapBp, lines, Tag(11), Int64(200), Int64(1100))
    if c2.ok:
        os.WriteLine(os.Get_stderr(), "credit over cap accepted")
        rc = rc + 1
    let c3 = rsv.ResIssueCredit(book.mintedSupply, book.creditCapBp, lines, Tag(12), Int64(100), Int64(1200))
    if !c3.ok:
        os.WriteLine(os.Get_stderr(), "boundary credit 500 rejected")
        rc = rc + 1

    # outstanding at cap boundary
    let outNow: int64 = rsv.CreditOutstanding(lines)
    if outNow != 500:
        os.WriteLine(os.Get_stderr(), "outstanding not at cap boundary")
        rc = rc + 1

    # freeze expired: account 10 issued at 1000, ttl 7d; jump past ttl
    let frozen = rsv.ResFreezeExpired(lines, Int64(604800000), Int64(1000) + Int64(604800001))
    if frozen < 1:
        os.WriteLine(os.Get_stderr(), "no line frozen past ttl")
        rc = rc + 1
    let guardA = rsv.ResGuardSpend(lines, Tag(10))
    if guardA.ok:
        os.WriteLine(os.Get_stderr(), "frozen account allowed to spend")
        rc = rc + 1
    let guardB = rsv.ResGuardSpend(lines, Tag(12))
    if !guardB.ok:
        os.WriteLine(os.Get_stderr(), "unfrozen account blocked")
        rc = rc + 1

    # snapshot monotonicity and verification
    let s1 = rsv.ResSnapshotBind(book, Tag(21), Int64(200))
    if !s1.ok:
        os.WriteLine(os.Get_stderr(), "first snapshot bind failed")
        rc = rc + 1
    let s2 = rsv.ResSnapshotBind(book, Tag(22), Int64(100))
    if s2.ok:
        os.WriteLine(os.Get_stderr(), "non-monotone snapshot accepted")
        rc = rc + 1
    let vBad = rsv.ResSnapshotVerify(book, Tag(23))
    if vBad.ok:
        os.WriteLine(os.Get_stderr(), "wrong snapshot verified")
        rc = rc + 1
    let vOk = rsv.ResSnapshotVerify(book, Tag(21))
    if !vOk.ok:
        os.WriteLine(os.Get_stderr(), "correct snapshot rejected")
        rc = rc + 1

    # conservation: supply == reserve, outstanding <= cap
    if book.mintedSupply != book.reserveAmount:
        os.WriteLine(os.Get_stderr(), "supply reserve identity broken")
        rc = rc + 1
    let outFinal: int64 = rsv.CreditOutstanding(lines)
    if outFinal * 10000 > book.mintedSupply * Int64(book.creditCapBp):
        os.WriteLine(os.Get_stderr(), "outstanding above cap at end")
        rc = rc + 1

    if rc == 0:
        echo("reserve_discipline_smoke ok")
    return rc
