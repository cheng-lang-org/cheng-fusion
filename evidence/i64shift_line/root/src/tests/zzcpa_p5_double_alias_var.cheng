type
    A1 = int32
    A2 = A1

fn Take(xs: A2[]): int32 =
    return xs.len

fn Bump(xs: var A2[]): int32 =
    add(xs, 9)
    return xs.len

fn main(): int32 =
    var xs: A2[]
    add(xs, 5)
    add(xs, 6)
    let before = Take(xs)
    if before != 2:
        return 51
    let after = Bump(xs)
    if after != 3:
        return 52
    return xs[0] + xs[1] + xs[2] - 20

main()
