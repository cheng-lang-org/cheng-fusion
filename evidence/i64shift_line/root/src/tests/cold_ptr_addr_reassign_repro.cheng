# Repro for the publisher SIGSEGV: a nil-initialized ptr local, conditionally
# reassigned to the ADDRESS OF A LOCAL (`p = &s`). The existing
# cold_opaque_local_reassign_smoke only covers reassignment from a CALL RESULT
# (block = helper()); this covers `p = &local`, the exact pattern at
# core_runtime_provider_linux.cheng:1243-1249 (timeoutPtr = &timeout).
# If miscompiled, the store of &s lands in the wrong slot, so p reads back as
# nil even after the assignment -> waitlike(1) returns 0 -> main returns 42.
type
    TwoWords =
        a: int64
        b: int64

fn waitlike(useit: int32): uint64 =
    var s: TwoWords
    s.a = int64(111)
    s.b = int64(222)
    var p: ptr = nil
    if useit != 0:
        p = &s
    return uint64(p)

fn main(): int32 =
    # nil branch: p stays nil
    if waitlike(0) != uint64(0):
        return 1
    # addr branch: after p = &s, p must be non-nil (the real stack address)
    if waitlike(1) == uint64(0):
        return 42
    return 0
