# lsp_document_symbols_smoke.cheng -- test DocumentSymbol and SymbolInformation types,
# hierarchy construction, and factory helpers. Uses standalone type definitions
# that mirror the protocol types (no lsp_protocol import needed for standalone test).
#
# Protocol-only constructors; production symbols come from pinned canonical CSG.
# Hierarchy: functions are children of module, locals are children of functions.

import std/strings

# --- Minimal types mirroring LSP protocol ---

type
    TestPosition =
        line: int32
        character: int32

    TestRange =
        start: TestPosition
        end: TestPosition

    TestLocation =
        uri: str
        range: TestRange

    TestSymbolKind = enum
        TskFile = 1
        TskModule = 2
        TskNamespace = 3
        TskPackage = 4
        TskClass = 5
        TskMethod = 6
        TskProperty = 7
        TskField = 8
        TskConstructor = 9
        TskEnum = 10
        TskInterface = 11
        TskFunction = 12
        TskVariable = 13
        TskConstant = 14
        TskString = 15
        TskNumber = 16
        TskBoolean = 17
        TskArray = 18
        TskObject = 19
        TskKey = 20
        TskNull = 21
        TskEnumMember = 22
        TskStruct = 23
        TskEvent = 24
        TskOperator = 25
        TskTypeParameter = 26

    TestDocumentSymbol =
        name: str
        kind: TestSymbolKind
        range: TestRange
        selectionRange: TestRange
        children: TestDocumentSymbol[]

    TestSymbolInformation =
        name: str
        kind: TestSymbolKind
        location: TestLocation

# --- Factory functions ---

fn TestMakePosition(line: int32, character: int32): TestPosition =
    var out: TestPosition
    out.line = line
    out.character = character
    return out

fn TestMakeRange(startLine: int32, startChar: int32,
                  endLine: int32, endChar: int32): TestRange =
    var out: TestRange
    out.start = TestMakePosition(startLine, startChar)
    out.end = TestMakePosition(endLine, endChar)
    return out

fn TestMakeLocation(uri: str, range: TestRange): TestLocation =
    var out: TestLocation
    out.uri = uri
    out.range = range
    return out

fn TestMakeDocumentSymbol(name: str, kind: TestSymbolKind,
                           range: TestRange,
                           selectionRange: TestRange,
                           children: TestDocumentSymbol[]): TestDocumentSymbol =
    var out: TestDocumentSymbol
    out.name = name
    out.kind = kind
    out.range = range
    out.selectionRange = selectionRange
    out.children = children
    return out

fn TestMakeSymbolInformation(name: str, kind: TestSymbolKind,
                              location: TestLocation): TestSymbolInformation =
    var out: TestSymbolInformation
    out.name = name
    out.kind = kind
    out.location = location
    return out

# --- Iconic kind mapping (mirrors protocol) ---

fn TestFactKindToSymbolKind(factType: int32): TestSymbolKind =
    if factType == 0:     # FskModule
        return TskModule
    if factType == 1:     # FskFunction
        return TskFunction
    if factType == 2:     # FskType
        return TskStruct
    if factType == 3:     # FskConst
        return TskConstant
    if factType == 4:     # FskVariable
        return TskVariable
    if factType == 5:     # FskField
        return TskField
    if factType == 6:     # FskParam
        return TskVariable
    return TskObject

# ====================
# Test cases
# ====================

fn TestDocumentSymbolConstruction() =
    let range: TestRange = TestMakeRange(0, 0, 5, 20)
    let selRange: TestRange = TestMakeRange(0, 0, 0, 10)

    var emptyChildren: TestDocumentSymbol[]
    let ds: TestDocumentSymbol = TestMakeDocumentSymbol("myFunc",
        TskFunction, range, selRange, emptyChildren)

    assert(ds.name == "myFunc", "doc sym: name should be 'myFunc'")
    assert(int32(ds.kind) == int32(TskFunction), "doc sym: kind should be TskFunction")
    assert(ds.range.start.line == 0, "doc sym: range start line")
    assert(ds.range.end.line == 5, "doc sym: range end line")
    assert(ds.selectionRange.start.character == 0, "doc sym: sel range start char")
    assert(ds.children.len == 0, "doc sym: empty children")

fn TestSymbolInformationConstruction() =
    let uri: str = "file:///test.cheng"
    let range: TestRange = TestMakeRange(1, 0, 1, 8)
    let loc: TestLocation = TestMakeLocation(uri, range)
    let si: TestSymbolInformation = TestMakeSymbolInformation("MAX", TskConstant, loc)

    assert(si.name == "MAX", "sym info: name should be 'MAX'")
    assert(int32(si.kind) == int32(TskConstant), "sym info: kind should be TskConstant")
    assert(si.location.uri == "file:///test.cheng", "sym info: location uri")
    assert(si.location.range.start.line == 1, "sym info: location range start line")
    assert(si.location.range.end.character == 8, "sym info: location range end char")

fn TestDocumentSymbolHierarchy() =
    # Build: module -> function -> variable (3 levels)
    let modRange: TestRange = TestMakeRange(0, 0, 20, 1)
    let fnRange: TestRange = TestMakeRange(5, 0, 15, 1)
    let varRange: TestRange = TestMakeRange(6, 4, 6, 12)

    var emptyVars: TestDocumentSymbol[]
    let varDs: TestDocumentSymbol = TestMakeDocumentSymbol("count",
        TskVariable, varRange, varRange, emptyVars)

    var fnChildren: TestDocumentSymbol[]
    add(fnChildren, varDs)
    let fnDs: TestDocumentSymbol = TestMakeDocumentSymbol("run",
        TskFunction, fnRange, fnRange, fnChildren)

    var modChildren: TestDocumentSymbol[]
    add(modChildren, fnDs)
    let modDs: TestDocumentSymbol = TestMakeDocumentSymbol("myModule",
        TskModule, modRange, modRange, modChildren)

    assert(modDs.name == "myModule", "hierarchy: module name")
    assert(modDs.children.len == 1, "hierarchy: module should have 1 child")
    assert(modDs.children[0].name == "run", "hierarchy: child function name")
    assert(modDs.children[0].children.len == 1, "hierarchy: function should have 1 child")
    assert(modDs.children[0].children[0].name == "count", "hierarchy: var name")

fn TestDocumentSymbolWithMultipleChildren() =
    let fnRange: TestRange = TestMakeRange(2, 0, 8, 1)
    let p1Range: TestRange = TestMakeRange(2, 3, 2, 8)
    let p2Range: TestRange = TestMakeRange(2, 10, 2, 15)
    let vRange: TestRange = TestMakeRange(5, 4, 5, 10)

    var empty: TestDocumentSymbol[]
    let param1: TestDocumentSymbol = TestMakeDocumentSymbol("x",
        TskVariable, p1Range, p1Range, empty)
    let param2: TestDocumentSymbol = TestMakeDocumentSymbol("y",
        TskVariable, p2Range, p2Range, empty)
    let local: TestDocumentSymbol = TestMakeDocumentSymbol("temp",
        TskVariable, vRange, vRange, empty)

    var children: TestDocumentSymbol[]
    add(children, param1)
    add(children, param2)
    add(children, local)
    let fnDs: TestDocumentSymbol = TestMakeDocumentSymbol("add",
        TskFunction, fnRange, fnRange, children)

    assert(fnDs.children.len == 3, "multi child: should have 3 children")
    assert(fnDs.children[0].name == "x", "multi child: first param")
    assert(fnDs.children[1].name == "y", "multi child: second param")
    assert(fnDs.children[2].name == "temp", "multi child: local var")

fn TestSymbolKindMapping() =
    # Test that fact kind ints map to correct SymbolKind values.
    # Compare against known enum constant values via int32 cast.
    assert(int32(TestFactKindToSymbolKind(0)) == int32(TskModule), "kind map: 0 -> TskModule")
    assert(int32(TestFactKindToSymbolKind(1)) == int32(TskFunction), "kind map: 1 -> TskFunction")
    assert(int32(TestFactKindToSymbolKind(2)) == int32(TskStruct), "kind map: 2 -> TskStruct")
    assert(int32(TestFactKindToSymbolKind(3)) == int32(TskConstant), "kind map: 3 -> TskConstant")
    assert(int32(TestFactKindToSymbolKind(4)) == int32(TskVariable), "kind map: 4 -> TskVariable")

fn TestSymbolInformationList() =
    # Build a list of SymbolInformation entries (simulating workspace/symbol response)
    var symbols: TestSymbolInformation[]

    let loc1: TestLocation = TestMakeLocation("file:///a.cheng",
        TestMakeRange(0, 0, 0, 5))
    let si1: TestSymbolInformation = TestMakeSymbolInformation("hello", TskFunction, loc1)
    add(symbols, si1)

    let loc2: TestLocation = TestMakeLocation("file:///b.cheng",
        TestMakeRange(3, 0, 3, 6))
    let si2: TestSymbolInformation = TestMakeSymbolInformation("world", TskFunction, loc2)
    add(symbols, si2)

    let loc3: TestLocation = TestMakeLocation("file:///a.cheng",
        TestMakeRange(5, 0, 5, 4))
    let si3: TestSymbolInformation = TestMakeSymbolInformation("MAX", TskConstant, loc3)
    add(symbols, si3)

    assert(symbols.len == 3, "sym info list: should have 3 entries")
    assert(symbols[0].name == "hello", "sym info list: first entry name")
    assert(symbols[0].kind == TskFunction, "sym info list: first entry kind")
    assert(symbols[1].location.uri == "file:///b.cheng", "sym info list: second entry uri")
    assert(symbols[2].name == "MAX", "sym info list: third entry name")

fn TestWorkspaceSymbolQuery() =
    # Simulate workspace/symbol query filtering
    var allSymbols: TestSymbolInformation[]

    let loc1: TestLocation = TestMakeLocation("f1", TestMakeRange(0, 0, 0, 5))
    let s1 = TestMakeSymbolInformation("helloWorld", TskFunction, loc1)
    add(allSymbols, s1)

    let loc2: TestLocation = TestMakeLocation("f2", TestMakeRange(0, 0, 0, 5))
    let s2 = TestMakeSymbolInformation("goodbyeWorld", TskFunction, loc2)
    add(allSymbols, s2)

    let loc3: TestLocation = TestMakeLocation("f3", TestMakeRange(0, 0, 0, 3))
    let s3 = TestMakeSymbolInformation("MAX_VALUE", TskConstant, loc3)
    add(allSymbols, s3)

    # Filter by "hello"
    var filtered: TestSymbolInformation[]
    for i in 0..<allSymbols.len:
        if strings.StrContains(allSymbols[i].name, "hello"):
            add(filtered, allSymbols[i])

    assert(filtered.len == 1, "workspace query: 'hello' should match 1")
    assert(filtered[0].name == "helloWorld", "workspace query: matched name")

    # Filter by "World"
    var filtered2: TestSymbolInformation[]
    for i in 0..<allSymbols.len:
        if strings.StrContains(allSymbols[i].name, "World"):
            add(filtered2, allSymbols[i])

    assert(filtered2.len == 2, "workspace query: 'World' should match 2")

    # Empty query matches all
    var filtered3: TestSymbolInformation[]
    for i in 0..<allSymbols.len:
        if strings.Len("") > 0 && !strings.StrContains(allSymbols[i].name, ""):
            continue
        add(filtered3, allSymbols[i])

    assert(filtered3.len == 3, "workspace query: empty query matches all")

fn main(): int32 =
    TestDocumentSymbolConstruction()
    TestSymbolInformationConstruction()
    TestDocumentSymbolHierarchy()
    TestDocumentSymbolWithMultipleChildren()
    TestSymbolKindMapping()
    TestSymbolInformationList()
    TestWorkspaceSymbolQuery()
    return 0
