# w3 probe: var-param managed seq field restage idiom (real crash shape:
# third restage = seq of int32, unmanaged elements, buffer managed)
type Holder = object
    indexes: int[]

@borrows
fn restage(h: var Holder, extra: int) =
    var local = h.indexes
    h.indexes = []
    h.indexes = local

fn main(): int32 =
    var h: Holder
    h.indexes = [7, 9]
    restage(h, 1)
    restage(h, 2)
    if h.indexes.len == 2:
        echo("w3probe=pass")
        return 0
    echo("w3probe=mismatch")
    return 3
