# lbm2d determinism + behavior gate: same seed -> identical fingerprints;
# ink spreads (wet cells grow then dry), deposit emerges, mass stays bounded.
import std/system
import cheng/game/lbm2d

fn makeConfig(): lbm2d.Lbm2dConfig =
    var cfg: lbm2d.Lbm2dConfig
    cfg.ambientWater = lbm2d.Lbm2dQ
    cfg.evapNum = 22
    cfg.evapDen = 1000
    cfg.dryThreshold = lbm2d.Lbm2dQ / 10
    cfg.depositNum = 6
    cfg.depositDen = 100
    cfg.pigmentDiffNum = 9
    cfg.pigmentDiffDen = 100
    cfg.fiberDragMax = 90
    cfg.sinkForceQ8 = 10
    return cfg

fn runOnce(seed: int32, ticks: int32, peakWetOut: var int32, depositOut: var int32): int32 =
    var cfg = makeConfig()
    var world = lbm2d.Lbm2dInit(96, 208, seed, cfg)
    lbm2d.Lbm2dInjectInk(world, 48, 60, lbm2d.Lbm2dQ * 3, lbm2d.Lbm2dQ * 2, 0, 40)
    var rolling = 7
    var peakWet = 0
    var t = 0
    while t < ticks:
        if t < 12:
            lbm2d.Lbm2dInjectInk(world, 48, 60, lbm2d.Lbm2dQ, lbm2d.Lbm2dQ / 2, 0, 36)
        let receipt = lbm2d.Lbm2dStep(world, cfg)
        lbm2d.Lbm2dRequireValid(receipt)
        rolling = rolling * 31 + receipt.receiptFingerprint
        if rolling < 0:
            rolling = 0 - rolling
        if receipt.wetCells > peakWet:
            peakWet = receipt.wetCells
        t = t + 1
    peakWetOut = peakWet
    var depositTotal = 0
    var i = 0
    while i < 96 * 208:
        depositTotal = depositTotal + world.deposit[i]
        i = i + 1
    depositOut = depositTotal
    return rolling

fn main(): int32 =
    var peakA: int32
    var depA: int32
    let fpA = runOnce(52, 120, peakA, depA)
    var peakB: int32
    var depB: int32
    let fpB = runOnce(52, 120, peakB, depB)
    var peakC: int32
    var depC: int32
    let fpC = runOnce(53, 120, peakC, depC)
    if fpA != fpB:
        return 1
    if peakA != peakB || depA != depB:
        return 2
    if fpA == fpC:
        return 3
    if peakA < 8:
        return 4
    if depA <= 0:
        return 5
    return 0
