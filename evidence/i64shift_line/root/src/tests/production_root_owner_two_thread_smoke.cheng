import std/atomic
import std/os
import std/thread
import cheng/core/csg_core/csgc_authority
import cheng/core/csg_core/merkle_store
import cheng/core/runtime/production_held_exec_terminal_guardian as terminal_guardian

var productionThreadPhase: atomic.I32
var productionThreadResultA: atomic.I32
var productionThreadResultB: atomic.I32

fn productionThreadSignal(phase: int32) =
    atomic.StoreI32(productionThreadPhase, phase)
    os.CsgCurrentHeadLeaseRegistryNotifyAll()

fn productionThreadWait(expected: int32) =
    while atomic.LoadI32(productionThreadPhase) < expected:
        let observedEpoch = os.CsgCurrentHeadLeaseRegistryEpoch()
        if atomic.LoadI32(productionThreadPhase) < expected:
            os.CsgCurrentHeadLeaseRegistryWait(observedEpoch)

fn productionThreadIssueAndHold() =
    let policy = csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    if !policy.admitted:
        atomic.StoreI32(productionThreadResultA, 11)
        productionThreadSignal(1)
        return
    var lease: merkle_store.CsgCoreMerkleStoreCurrentHeadLease
    var err: str
    if !merkle_store.CsgCoreMerkleStoreAcquireCurrentHeadSharedLease(
           policy.parentPath, policy.storeName, lease, err):
        atomic.StoreI32(productionThreadResultA, 12)
        productionThreadSignal(1)
        return
    var rootOwner: int32
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerIssueInto(
           lease, policy.policyCid, rootOwner, err):
        merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseRelease(lease)
        atomic.StoreI32(productionThreadResultA, 13)
        productionThreadSignal(1)
        return
    productionThreadSignal(1)
    productionThreadWait(2)
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
           rootOwner, err):
        atomic.StoreI32(productionThreadResultA, 14)
        return
    atomic.StoreI32(productionThreadResultA, 1)

fn productionThreadIssueAfterHeld() =
    productionThreadWait(1)
    let policy = csgc_authority.CsgCoreCsgcProductionPolicyIssue()
    if !policy.admitted:
        atomic.StoreI32(productionThreadResultB, 21)
        productionThreadSignal(2)
        return
    var lease: merkle_store.CsgCoreMerkleStoreCurrentHeadLease
    var err: str
    if !merkle_store.CsgCoreMerkleStoreAcquireCurrentHeadSharedLease(
           policy.parentPath, policy.storeName, lease, err):
        atomic.StoreI32(productionThreadResultB, 22)
        productionThreadSignal(2)
        return
    productionThreadSignal(2)
    var rootOwner: int32
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerIssueInto(
           lease, policy.policyCid, rootOwner, err):
        merkle_store.CsgCoreMerkleStoreCurrentHeadLeaseRelease(lease)
        atomic.StoreI32(productionThreadResultB, 23)
        return
    if !merkle_store.CsgCoreMerkleStoreTerminalJournalRootOwnerCloseInto(
           rootOwner, err):
        atomic.StoreI32(productionThreadResultB, 24)
        return
    atomic.StoreI32(productionThreadResultB, 1)

fn main(): int32 =
    if !terminal_guardian.CsgCoreProductionHeldExecTerminalGuardianInitializeBeforeLoop():
        return 31
    productionThreadPhase = atomic.NewI32(0)
    productionThreadResultA = atomic.NewI32(0)
    productionThreadResultB = atomic.NewI32(0)
    if productionThreadPhase == nil ||
       productionThreadResultA == nil ||
       productionThreadResultB == nil:
        return 32
    let workerA = thread.StartFn(productionThreadIssueAndHold)
    let workerB = thread.StartFn(productionThreadIssueAfterHeld)
    if !thread.JoinThread(workerA) || !thread.JoinThread(workerB):
        return 33
    if atomic.LoadI32(productionThreadResultA) != 1:
        return atomic.LoadI32(productionThreadResultA)
    if atomic.LoadI32(productionThreadResultB) != 1:
        return atomic.LoadI32(productionThreadResultB)
    os.WriteLine(os.Get_stdout(), "PRODUCTION_ROOT_OWNER_TWO_THREAD_OK")
    return 0
