import std/cmdline as cmdline
import std/os
import std/rawbytes
import std/rawmem_support
import std/result
import std/strutils as strutil
import std/net/transports/tcp_syscall as tcp
import cheng/quic/tls/test_pki as testpki
import cheng/core/tooling/host_ops as hostops
import cheng/core/tooling/path as chengpath
import cheng/apps/vpn_proxy/vpn_proxy_listen as listen
import cheng/apps/vpn_proxy/vpn_proxy_main as vpn
import cheng/apps/vpn_proxy/vpn_proxy_host_cli as hostcli
import cheng/apps/vpn_proxy/vpn_proxy_routing as routing

const
    vpnProxyDialerTcpArtifactRel = "artifacts/vpn_proxy_dialer_proxy_tcp_smoke"
    vpnProxyDialerTcpAuth = "cheng-hy2-tun-local-shared-token-2026"
    vpnProxyDialerTcpAuthority = "localhost"
    vpnProxyDialerTcpTargetHost = "127.0.0.1"
    vpnProxyDialerTcpRequestText = "vpn-proxy-dialer-proxy-request"
    vpnProxyDialerTcpResponseBytes = 393216

fn vpnProxyDialerTcpBytesEq(left: Bytes, right: Bytes): bool =
    if BytesLen(left) != BytesLen(right):
        return false
    for i in 0..<BytesLen(left):
        if BytesGet(left, i) != BytesGet(right, i):
            return false
    return true

fn vpnProxyDialerTcpArtifactDir(root: str): str =
    return chengpath.PathAbsolute(root, vpnProxyDialerTcpArtifactRel)

fn vpnProxyDialerTcpPath(root: str, name: str): str =
    return chengpath.PathAbsolute(root, strutil.Join([vpnProxyDialerTcpArtifactRel, "/", name], ""))

fn vpnProxyDialerTcpReadyPath(root: str, name: str): str =
    return vpnProxyDialerTcpPath(root, strutil.Join([name, ".ready"], ""))

fn vpnProxyDialerTcpLogPath(root: str, name: str): str =
    return vpnProxyDialerTcpPath(root, strutil.Join([name, ".log"], ""))

fn vpnProxyDialerTcpParsePort(textRaw: str): Result[int32] =
    let text: str = strutil.Strip(textRaw)
    if len(text) <= 0:
        return Err[int32](" vpn proxy dialer tcp: empty port text")
    var value: int32
    for i in 0..<len(text):
        let ch = text[i]
        if ch < '0' || ch > '9':
            return Err[int32](" vpn proxy dialer tcp: invalid port text")
        value = value * 10 + (int32(ch) - int32('0'))
    if value <= 0:
        return Err[int32](" vpn proxy dialer tcp: invalid port")
    return Ok[int32](value)

fn vpnProxyDialerTcpRemoveFile(path: str) =
    if os.FileExists(path):
        let _ = os.RemoveFile(path)

fn vpnProxyDialerTcpWriteBytes(path: str, data: Bytes): bool =
    let parent: str = os.ParentDir(path)
    if len(parent) > 0:
        if !chengpath.MkdirP("", parent):
            return false
    let total: int32 = BytesLen(data)
    var payload: rawbytes.Bytes = rawbytes.BytesView(data.data, total)
    var writeRes: Result[bool] = os.WriteFileBytesResult(path, payload)
    if IsErr(writeRes):
        return false
    return os.FileExists(path) && os.FileSize(path) == int64(total)

fn vpnProxyDialerTcpWriteMaterials(root: str): Result[bool] =
    let artifactDir: str = vpnProxyDialerTcpArtifactDir(root)
    if !chengpath.MkdirP(root, artifactDir):
        return Err[bool](" vpn proxy dialer tcp: mkdir failed")
    let rootPath: str = vpnProxyDialerTcpPath(root, "transport.root.der")
    let certPath: str = vpnProxyDialerTcpPath(root, "transport.cert.der")
    let keyPath: str = vpnProxyDialerTcpPath(root, "transport.key.pk8")
    var trustRoot: Bytes
    testpki.msquicLocalhostTransportTrustRootDerInto(trustRoot)
    if BytesLen(trustRoot) <= 0:
        return Err[bool](" vpn proxy dialer tcp: trust root bytes empty")
    if !vpnProxyDialerTcpWriteBytes(rootPath, trustRoot):
        return Err[bool](" vpn proxy dialer tcp: write trust root failed")
    var certDer: Bytes
    testpki.msquicLocalhostTransportCertDerInto(certDer)
    if BytesLen(certDer) <= 0:
        return Err[bool](" vpn proxy dialer tcp: cert bytes empty")
    if !vpnProxyDialerTcpWriteBytes(certPath, certDer):
        return Err[bool](" vpn proxy dialer tcp: write cert failed")
    var keyPk8: Bytes
    testpki.msquicLocalhostTransportKeyPkcs8DerInto(keyPk8)
    if BytesLen(keyPk8) <= 0:
        return Err[bool](" vpn proxy dialer tcp: key bytes empty")
    if !vpnProxyDialerTcpWriteBytes(keyPath, keyPk8):
        return Err[bool](" vpn proxy dialer tcp: write key failed")
    return Ok[bool](true)

fn vpnProxyDialerTcpExitConfigText(): str =
    var out = ""
    out = strutil.Join([out, "{\"server\":{"], "")
    out = strutil.Join([out, "\"listen\":\"127.0.0.1:0\","], "")
    out = strutil.Join([out, "\"cert_der\":\"transport.cert.der\","], "")
    out = strutil.Join([out, "\"key_pk8_der\":\"transport.key.pk8\","], "")
    out = strutil.Join([out, "\"trust_root_der\":\"transport.root.der\","], "")
    out = strutil.Join([out, "\"expected_auth\":\"", vpnProxyDialerTcpAuth, "\","], "")
    out = strutil.Join([out, "\"expected_authority\":\"", vpnProxyDialerTcpAuthority, "\","], "")
    out = strutil.Join([out, "\"cc_rx_text\":\"auto\""], "")
    out = strutil.Join([out, "}}"], "")
    return out

fn vpnProxyDialerTcpLocalConfigText(frontPort: int32, finalPort: int32): str =
    var out = ""
    out = strutil.Join([out, "{\"client\":{"], "")
    out = strutil.Join([out, "\"listen\":\"127.0.0.1:0\","], "")
    out = strutil.Join([out, "\"cert_der\":\"transport.cert.der\","], "")
    out = strutil.Join([out, "\"key_pk8_der\":\"transport.key.pk8\","], "")
    out = strutil.Join([out, "\"trust_root_der\":\"transport.root.der\""], "")
    out = strutil.Join([out, "},\"exits\":[{"], "")
    out = strutil.Join([out, "\"name\":\"final-clean\","], "")
    out = strutil.Join([out, "\"transport\":\"tcp-tls-forward\","], "")
    out = strutil.Join([out, "\"host\":\"127.0.0.1\","], "")
    out = strutil.Join([out, "\"port\":", IntToStr(finalPort), ","], "")
    out = strutil.Join([out, "\"server_name\":\"localhost\","], "")
    out = strutil.Join([out, "\"authority\":\"", vpnProxyDialerTcpAuthority, "\","], "")
    out = strutil.Join([out, "\"auth\":\"", vpnProxyDialerTcpAuth, "\","], "")
    out = strutil.Join([out, "\"dialer_proxy\":\"front-edge\","], "")
    out = strutil.Join([out, "\"cc_rx\":1"], "")
    out = strutil.Join([out, "},{"], "")
    out = strutil.Join([out, "\"name\":\"front-edge\","], "")
    out = strutil.Join([out, "\"transport\":\"tcp-tls-forward\","], "")
    out = strutil.Join([out, "\"host\":\"127.0.0.1\","], "")
    out = strutil.Join([out, "\"port\":", IntToStr(frontPort), ","], "")
    out = strutil.Join([out, "\"server_name\":\"localhost\","], "")
    out = strutil.Join([out, "\"authority\":\"", vpnProxyDialerTcpAuthority, "\","], "")
    out = strutil.Join([out, "\"auth\":\"", vpnProxyDialerTcpAuth, "\","], "")
    out = strutil.Join([out, "\"cc_rx\":1"], "")
    out = strutil.Join([out, "}]}"], "")
    return out

fn vpnProxyDialerTcpWaitReadyPort(root: str,
                                  readyPath: str,
                                  proc: var hostops.SpawnedProcess,
                                  portOut: var int32): Result[bool] =
    portOut = 0
    for attempt in 0..<500:
        if chengpath.FileExistsNonEmpty(root, readyPath):
            let textRaw: str = chengpath.ReadTextFile("", readyPath)
            let parseRes: Result[int32] = vpnProxyDialerTcpParsePort(textRaw)
            if IsOk(parseRes):
                portOut = Value(parseRes)
                return Ok[bool](true)
        if !hostops.SpawnedProcessRunning(proc):
            return Err[bool](strutil.Join([" vpn proxy dialer tcp: process exited before ready: ", proc.output], ""))
        if attempt + 1 < 500:
            os.SleepMs(10)
    return Err[bool](" vpn proxy dialer tcp: ready timeout")

fn vpnProxyDialerTcpReadExact(conn: var tcp.TcpConnectionHandle, count: int32): Result[Bytes] =
    let out: Bytes = BytesAlloc(count)
    var filled: int32
    while filled < count:
        let readyRes: Result[bool] = tcp.TcpConnectionWaitReadable(conn, 30000)
        if IsErr(readyRes):
            return Err[Bytes](ErrorText(readyRes))
        if !Value(readyRes):
            return Err[Bytes](strutil.Join([" vpn proxy dialer tcp: read timeout filled=",
                                            IntToStr(filled),
                                            "/",
                                            IntToStr(count)], ""))
        let dstPtr: ptr = rawmem_support.RawmemPtrAdd(out.data, filled)
        let readRes: Result[int32] = tcp.TcpRecvRaw(conn, dstPtr, count - filled)
        if IsErr(readRes):
            return Err[Bytes](ErrorText(readRes))
        let got: int32 = Value(readRes)
        if got <= 0:
            return Err[Bytes](strutil.Join([" vpn proxy dialer tcp: unexpected eof filled=",
                                            IntToStr(filled),
                                            "/",
                                            IntToStr(count)], ""))
        filled = filled + got
    return Ok[Bytes](out)

fn vpnProxyDialerTcpWriteAll(conn: var tcp.TcpConnectionHandle, data: var Bytes): Result[int32] =
    var written: int32
    while written < BytesLen(data):
        let ptrNow: ptr = rawmem_support.RawmemPtrAdd(data.data, written)
        let sendRes: Result[int32] = tcp.TcpSendRaw(conn, ptrNow, BytesLen(data) - written)
        if IsErr(sendRes):
            return Err[int32](ErrorText(sendRes))
        let sent: int32 = Value(sendRes)
        if sent <= 0:
            return Err[int32](" vpn proxy dialer tcp: write closed")
        written = written + sent
    return Ok[int32](written)

fn vpnProxyDialerTcpTargetRequest(): Bytes =
    return BytesFromString(vpnProxyDialerTcpRequestText)

fn vpnProxyDialerTcpTargetResponse(): Bytes =
    var out: Bytes = BytesAlloc(vpnProxyDialerTcpResponseBytes)
    for i in 0..<vpnProxyDialerTcpResponseBytes:
        BytesSet(out, i, (i * 31 + 7) & 255)
    return out

fn vpnProxyDialerTcpTestBytes(values: int32[]): Bytes =
    var out: Bytes = BytesAlloc(values.len)
    for i in 0..<values.len:
        BytesSet(out, i, values[i])
    return out

fn vpnProxyDialerTcpSocksMethodWireInto(out: var Bytes) =
    out = BytesAlloc(3)
    BytesSet(out, 0, 5)
    BytesSet(out, 1, 1)
    BytesSet(out, 2, 0)

fn vpnProxyDialerTcpSocksConnectWireInto(targetPort: int32, out: var Bytes) =
    out = BytesAlloc(10)
    BytesSet(out, 0, 5)
    BytesSet(out, 1, 1)
    BytesSet(out, 2, 0)
    BytesSet(out, 3, 1)
    BytesSet(out, 4, 127)
    BytesSet(out, 5, 0)
    BytesSet(out, 6, 0)
    BytesSet(out, 7, 1)
    BytesSet(out, 8, (targetPort / 256) & 255)
    BytesSet(out, 9, targetPort & 255)

fn vpnProxyDialerTcpRunClient(localPort: int32, targetPort: int32): Result[bool] =
    let connectRes: Result[tcp.TcpConnectionHandle] = tcp.TcpConnect4Timeout("127.0.0.1", localPort, 3000)
    if IsErr(connectRes):
        return Err[bool](ErrorText(connectRes))
    var conn = Value(connectRes)
    var methodWire: Bytes
    vpnProxyDialerTcpSocksMethodWireInto(methodWire)
    let methodWriteRes: Result[int32] = vpnProxyDialerTcpWriteAll(conn, methodWire)
    if IsErr(methodWriteRes):
        tcp.TcpClose(conn)
        return Err[bool](ErrorText(methodWriteRes))
    let methodReplyRes: Result[Bytes] = vpnProxyDialerTcpReadExact(conn, 2)
    if IsErr(methodReplyRes):
        tcp.TcpClose(conn)
        return Err[bool](strutil.Join([" vpn proxy dialer tcp: client method reply: ", ErrorText(methodReplyRes)], ""))
    if !vpnProxyDialerTcpBytesEq(Value(methodReplyRes), vpnProxyDialerTcpTestBytes([5, 0])):
        tcp.TcpClose(conn)
        return Err[bool](" vpn proxy dialer tcp: method reply invalid")
    var connectWire: Bytes
    vpnProxyDialerTcpSocksConnectWireInto(targetPort, connectWire)
    let connectWriteRes: Result[int32] = vpnProxyDialerTcpWriteAll(conn, connectWire)
    if IsErr(connectWriteRes):
        tcp.TcpClose(conn)
        return Err[bool](ErrorText(connectWriteRes))
    let connectReplyRes: Result[Bytes] = vpnProxyDialerTcpReadExact(conn, 10)
    if IsErr(connectReplyRes):
        tcp.TcpClose(conn)
        return Err[bool](strutil.Join([" vpn proxy dialer tcp: client connect reply: ", ErrorText(connectReplyRes)], ""))
    let connectReply: Bytes = Value(connectReplyRes)
    if BytesLen(connectReply) != 10 || BytesGet(connectReply, 0) != 5 || BytesGet(connectReply, 1) != 0:
        tcp.TcpClose(conn)
        return Err[bool](" vpn proxy dialer tcp: connect reply invalid")
    var request: Bytes = vpnProxyDialerTcpTargetRequest()
    let requestWriteRes: Result[int32] = vpnProxyDialerTcpWriteAll(conn, request)
    if IsErr(requestWriteRes):
        tcp.TcpClose(conn)
        return Err[bool](ErrorText(requestWriteRes))
    let responseRes: Result[Bytes] = vpnProxyDialerTcpReadExact(conn, vpnProxyDialerTcpResponseBytes)
    if IsErr(responseRes):
        tcp.TcpClose(conn)
        return Err[bool](strutil.Join([" vpn proxy dialer tcp: client target response: ", ErrorText(responseRes)], ""))
    tcp.TcpClose(conn)
    if !vpnProxyDialerTcpBytesEq(Value(responseRes), vpnProxyDialerTcpTargetResponse()):
        return Err[bool](" vpn proxy dialer tcp: response payload mismatch")
    return Ok[bool](true)

fn vpnProxyDialerTcpWaitRunOk(root: str,
                              proc: var hostops.SpawnedProcess,
                              logPath: str,
                              label: str): Result[bool] =
    let run: hostops.LoggedRun = hostops.SpawnedProcessWaitLogged(root, proc, 20, logPath)
    if !hostops.LoggedRunOk(run):
        return Err[bool](strutil.Join([" vpn proxy dialer tcp: ", label, " failed: ", run.output], ""))
    return Ok[bool](true)

fn vpnProxyDialerTcpAppendLog(out: var str, root: str, logPath: str, label: str) =
    out = strutil.Join([out, "\n["], "")
    out = strutil.Join([out, label], "")
    out = strutil.Join([out, "]\n"], "")
    if chengpath.FileExistsNonEmpty(root, logPath):
        out = strutil.Join([out, chengpath.ReadTextFile("", logPath)], "")
        return
    out = strutil.Join([out, "<empty>"], "")

fn vpnProxyDialerTcpWriteFailure(root: str,
                                 message: str,
                                 targetLog: str,
                                 localLog: str,
                                 frontLog: str,
                                 finalLog: str) =
    var out: str = message
    vpnProxyDialerTcpAppendLog(out, root, targetLog, "target")
    vpnProxyDialerTcpAppendLog(out, root, localLog, "local")
    vpnProxyDialerTcpAppendLog(out, root, frontLog, "front")
    vpnProxyDialerTcpAppendLog(out, root, finalLog, "final")
    os.WriteLine(os.Get_stderr(), out)

fn vpnProxyDialerTcpKillAndFinalize(root: str,
                                    proc: var hostops.SpawnedProcess,
                                    logPath: str) =
    hostops.SpawnedProcessKill(proc)
    let _ = hostops.SpawnedProcessFinalize(root, proc, logPath, 124)

fn vpnProxyDialerTcpRunDefault(): int32 =
    let root: str = os.GetCurrentDir()
    let selfPath: str = cmdline.ProgramName()
    assert(len(selfPath) > 0, " vpn proxy dialer tcp: self path")
    let materialRes: Result[bool] = vpnProxyDialerTcpWriteMaterials(root)
    if IsErr(materialRes):
        os.WriteLine(os.Get_stderr(), ErrorText(materialRes))
        return 1

    let targetReady: str = vpnProxyDialerTcpReadyPath(root, "target")
    let targetLog: str = vpnProxyDialerTcpLogPath(root, "target")
    let frontReady: str = vpnProxyDialerTcpReadyPath(root, "front")
    let frontLog: str = vpnProxyDialerTcpLogPath(root, "front")
    let finalReady: str = vpnProxyDialerTcpReadyPath(root, "final")
    let finalLog: str = vpnProxyDialerTcpLogPath(root, "final")
    let localReady: str = vpnProxyDialerTcpReadyPath(root, "local")
    let localLog: str = vpnProxyDialerTcpLogPath(root, "local")
    let client1Log: str = vpnProxyDialerTcpLogPath(root, "client1")
    let client2Log: str = vpnProxyDialerTcpLogPath(root, "client2")
    let frontConfigPath: str = vpnProxyDialerTcpPath(root, "front.config.json")
    let finalConfigPath: str = vpnProxyDialerTcpPath(root, "final.config.json")
    let localConfigPath: str = vpnProxyDialerTcpPath(root, "local.config.json")

    vpnProxyDialerTcpRemoveFile(targetReady)
    vpnProxyDialerTcpRemoveFile(targetLog)
    vpnProxyDialerTcpRemoveFile(frontReady)
    vpnProxyDialerTcpRemoveFile(frontLog)
    vpnProxyDialerTcpRemoveFile(finalReady)
    vpnProxyDialerTcpRemoveFile(finalLog)
    vpnProxyDialerTcpRemoveFile(localReady)
    vpnProxyDialerTcpRemoveFile(localLog)
    vpnProxyDialerTcpRemoveFile(client1Log)
    vpnProxyDialerTcpRemoveFile(client2Log)

    assert(chengpath.WriteTextFile("", frontConfigPath, vpnProxyDialerTcpExitConfigText()),
           " vpn proxy dialer tcp: write front config")
    assert(chengpath.WriteTextFile("", finalConfigPath, vpnProxyDialerTcpExitConfigText()),
           " vpn proxy dialer tcp: write final config")

    let targetSpawnRes = hostops.SpawnFile(root,
                                           "vpn_proxy_dialer_tcp_target",
                                           selfPath,
                                           ["--role:target",
                                            "--port:0",
                                            strutil.Join(["--ready-path:", targetReady], ""),
                                            "--accept-count:2"],
                                           [],
                                           root)
    if IsErr(targetSpawnRes):
        os.WriteLine(os.Get_stderr(), Error(targetSpawnRes))
        return 1
    var targetProc = Value(targetSpawnRes)

    var targetPort: int32
    let targetReadyRes = vpnProxyDialerTcpWaitReadyPort(root, targetReady, targetProc, targetPort)
    if IsErr(targetReadyRes):
        hostops.SpawnedProcessKill(targetProc)
        os.WriteLine(os.Get_stderr(), ErrorText(targetReadyRes))
        return 1

    let finalSpawnRes = hostops.SpawnFile(root,
                                          "vpn_proxy_dialer_tcp_final",
                                          selfPath,
                                          ["--role:proxy-exit",
                                           strutil.Join(["--config:", finalConfigPath], ""),
                                           strutil.Join(["--ready-path:", finalReady], ""),
                                           "--accept-count:3"],
                                          [],
                                          root)
    if IsErr(finalSpawnRes):
        hostops.SpawnedProcessKill(targetProc)
        os.WriteLine(os.Get_stderr(), Error(finalSpawnRes))
        return 1
    var finalProc = Value(finalSpawnRes)

    var finalPort: int32
    let finalReadyRes = vpnProxyDialerTcpWaitReadyPort(root, finalReady, finalProc, finalPort)
    if IsErr(finalReadyRes):
        hostops.SpawnedProcessKill(finalProc)
        hostops.SpawnedProcessKill(targetProc)
        os.WriteLine(os.Get_stderr(), ErrorText(finalReadyRes))
        return 1

    let frontSpawnRes = hostops.SpawnFile(root,
                                          "vpn_proxy_dialer_tcp_front",
                                          selfPath,
                                          ["--role:proxy-exit",
                                           strutil.Join(["--config:", frontConfigPath], ""),
                                           strutil.Join(["--ready-path:", frontReady], ""),
                                           "--accept-count:3"],
                                          [],
                                          root)
    if IsErr(frontSpawnRes):
        hostops.SpawnedProcessKill(finalProc)
        hostops.SpawnedProcessKill(targetProc)
        os.WriteLine(os.Get_stderr(), Error(frontSpawnRes))
        return 1
    var frontProc = Value(frontSpawnRes)

    var frontPort: int32
    let frontReadyRes = vpnProxyDialerTcpWaitReadyPort(root, frontReady, frontProc, frontPort)
    if IsErr(frontReadyRes):
        hostops.SpawnedProcessKill(frontProc)
        hostops.SpawnedProcessKill(finalProc)
        hostops.SpawnedProcessKill(targetProc)
        os.WriteLine(os.Get_stderr(), ErrorText(frontReadyRes))
        return 1

    assert(chengpath.WriteTextFile("", localConfigPath, vpnProxyDialerTcpLocalConfigText(frontPort, finalPort)),
           " vpn proxy dialer tcp: write local config")
    let routeConfigRes: Result[vpn.VpnProxyConfig] = vpn.VpnProxyLoadConfig(localConfigPath)
    assert(!IsErr(routeConfigRes), " vpn proxy dialer tcp: load local config")
    let routeConfig: vpn.VpnProxyConfig = Value(routeConfigRes)
    var routeStates: vpn.VpnProxyExitState[] = routing.VpnProxyInitExitStates(routeConfig.exits)
    var finalState: vpn.VpnProxyExitState = routeStates[0]
    finalState.healthy = true
    finalState.ewmaMs = 100
    routeStates[0] = finalState
    var frontState: vpn.VpnProxyExitState = routeStates[1]
    frontState.healthy = true
    frontState.ewmaMs = 1
    routeStates[1] = frontState
    let selectedExit: int32 = vpn.VpnProxyBestHealthyExitForTransport(routeStates,
                                                                      "tcp-tls-forward",
                                                                      -1)
    assert(selectedExit == 0, " vpn proxy dialer tcp: final exit selection")
    let statusRc: int32 = vpn.VpnProxyStatusProbeExitChild(root,
                                                           ["--config",
                                                            localConfigPath,
                                                            "--exit-index",
                                                            "0",
                                                            "--probe-timeout-ms",
                                                            "3000"])
    if statusRc != 0:
        vpnProxyDialerTcpKillAndFinalize(root, frontProc, frontLog)
        vpnProxyDialerTcpKillAndFinalize(root, finalProc, finalLog)
        vpnProxyDialerTcpKillAndFinalize(root, targetProc, targetLog)
        vpnProxyDialerTcpWriteFailure(root,
                                      strutil.Join([" vpn proxy dialer tcp: dialer status rc=", IntToStr(statusRc)], ""),
                                      targetLog,
                                      localLog,
                                      frontLog,
                                      finalLog)
        return 1

    let localSpawnRes = hostops.SpawnFile(root,
                                          "vpn_proxy_dialer_tcp_local",
                                          selfPath,
                                          ["--role:proxy-local",
                                           strutil.Join(["--config:", localConfigPath], ""),
                                           strutil.Join(["--ready-path:", localReady], ""),
                                           "--accept-count:2",
                                           "--probe-timeout-ms:500"],
                                          [],
                                          root)
    if IsErr(localSpawnRes):
        hostops.SpawnedProcessKill(frontProc)
        hostops.SpawnedProcessKill(finalProc)
        hostops.SpawnedProcessKill(targetProc)
        os.WriteLine(os.Get_stderr(), Error(localSpawnRes))
        return 1
    var localProc = Value(localSpawnRes)

    var localPort: int32
    let localReadyRes = vpnProxyDialerTcpWaitReadyPort(root, localReady, localProc, localPort)
    if IsErr(localReadyRes):
        hostops.SpawnedProcessKill(localProc)
        hostops.SpawnedProcessKill(frontProc)
        hostops.SpawnedProcessKill(finalProc)
        hostops.SpawnedProcessKill(targetProc)
        os.WriteLine(os.Get_stderr(), ErrorText(localReadyRes))
        return 1

    let client1SpawnRes = hostops.SpawnFile(root,
                                            "vpn_proxy_dialer_tcp_client1",
                                            selfPath,
                                            ["--role:client",
                                             strutil.Join(["--local-port:", IntToStr(localPort)], ""),
                                             strutil.Join(["--target-port:", IntToStr(targetPort)], "")],
                                            [],
                                            root)
    if IsErr(client1SpawnRes):
        vpnProxyDialerTcpKillAndFinalize(root, localProc, localLog)
        vpnProxyDialerTcpKillAndFinalize(root, frontProc, frontLog)
        vpnProxyDialerTcpKillAndFinalize(root, finalProc, finalLog)
        vpnProxyDialerTcpKillAndFinalize(root, targetProc, targetLog)
        vpnProxyDialerTcpWriteFailure(root, Error(client1SpawnRes), targetLog, localLog, frontLog, finalLog)
        return 1
    var client1Proc = Value(client1SpawnRes)
    let client2SpawnRes = hostops.SpawnFile(root,
                                            "vpn_proxy_dialer_tcp_client2",
                                            selfPath,
                                            ["--role:client",
                                             strutil.Join(["--local-port:", IntToStr(localPort)], ""),
                                             strutil.Join(["--target-port:", IntToStr(targetPort)], "")],
                                            [],
                                            root)
    if IsErr(client2SpawnRes):
        vpnProxyDialerTcpKillAndFinalize(root, client1Proc, client1Log)
        vpnProxyDialerTcpKillAndFinalize(root, localProc, localLog)
        vpnProxyDialerTcpKillAndFinalize(root, frontProc, frontLog)
        vpnProxyDialerTcpKillAndFinalize(root, finalProc, finalLog)
        vpnProxyDialerTcpKillAndFinalize(root, targetProc, targetLog)
        vpnProxyDialerTcpWriteFailure(root, Error(client2SpawnRes), targetLog, localLog, frontLog, finalLog)
        return 1
    var client2Proc = Value(client2SpawnRes)
    let client1WaitRes: Result[bool] = vpnProxyDialerTcpWaitRunOk(root, client1Proc, client1Log, "client1")
    let client2WaitRes: Result[bool] = vpnProxyDialerTcpWaitRunOk(root, client2Proc, client2Log, "client2")
    if IsErr(client1WaitRes) || IsErr(client2WaitRes):
        vpnProxyDialerTcpKillAndFinalize(root, localProc, localLog)
        vpnProxyDialerTcpKillAndFinalize(root, frontProc, frontLog)
        vpnProxyDialerTcpKillAndFinalize(root, finalProc, finalLog)
        vpnProxyDialerTcpKillAndFinalize(root, targetProc, targetLog)
        var errText: str
        if IsErr(client1WaitRes):
            errText = ErrorText(client1WaitRes)
        if IsErr(client2WaitRes):
            if len(errText) > 0:
                errText = strutil.Join([errText, "\n"], "")
            errText = strutil.Join([errText, ErrorText(client2WaitRes)], "")
        vpnProxyDialerTcpWriteFailure(root, errText, targetLog, localLog, frontLog, finalLog)
        return 1

    let targetWaitRes: Result[bool] = vpnProxyDialerTcpWaitRunOk(root, targetProc, targetLog, "target")
    if IsErr(targetWaitRes):
        vpnProxyDialerTcpKillAndFinalize(root, localProc, localLog)
        vpnProxyDialerTcpKillAndFinalize(root, frontProc, frontLog)
        vpnProxyDialerTcpKillAndFinalize(root, finalProc, finalLog)
        vpnProxyDialerTcpWriteFailure(root, ErrorText(targetWaitRes), targetLog, localLog, frontLog, finalLog)
        return 1
    let localWaitRes: Result[bool] = vpnProxyDialerTcpWaitRunOk(root, localProc, localLog, "local")
    if IsErr(localWaitRes):
        vpnProxyDialerTcpKillAndFinalize(root, frontProc, frontLog)
        vpnProxyDialerTcpKillAndFinalize(root, finalProc, finalLog)
        vpnProxyDialerTcpWriteFailure(root, ErrorText(localWaitRes), targetLog, localLog, frontLog, finalLog)
        return 1
    let frontWaitRes: Result[bool] = vpnProxyDialerTcpWaitRunOk(root, frontProc, frontLog, "front")
    if IsErr(frontWaitRes):
        vpnProxyDialerTcpKillAndFinalize(root, finalProc, finalLog)
        vpnProxyDialerTcpWriteFailure(root, ErrorText(frontWaitRes), targetLog, localLog, frontLog, finalLog)
        return 1
    let finalWaitRes: Result[bool] = vpnProxyDialerTcpWaitRunOk(root, finalProc, finalLog, "final")
    if IsErr(finalWaitRes):
        vpnProxyDialerTcpWriteFailure(root, ErrorText(finalWaitRes), targetLog, localLog, frontLog, finalLog)
        return 1

    echo(" vpn_proxy_dialer_proxy_tcp_smoke ok")
    return 0

fn vpnProxyDialerTcpRunTarget(): int32 =
    let port: int32 = cmdline.ReadInt32FlagOrDefault("--port", 0)
    let readyPath: str = cmdline.ReadFlagOrDefault("--ready-path", "")
    var acceptCount: int32 = cmdline.ReadInt32FlagOrDefault("--accept-count", 1)
    if acceptCount <= 0:
        acceptCount = 1
    var listener: tcp.TcpListenerHandle
    let listenRes: Result[bool] = tcp.TcpListen4Fill(vpnProxyDialerTcpTargetHost, port, listener)
    if IsErr(listenRes):
        os.WriteLine(os.Get_stderr(), ErrorText(listenRes))
        return 1
    if len(readyPath) > 0:
        if !chengpath.WriteTextFile("", readyPath, IntToStr(listener.addr.port)):
            tcp.TcpListenerClose(listener)
            os.WriteLine(os.Get_stderr(), " vpn proxy dialer tcp: write target ready failed")
            return 1
    for _ in 0..<acceptCount:
        var conn: tcp.TcpConnectionHandle
        if !tcp.TcpAcceptInto(listener, conn):
            tcp.TcpListenerClose(listener)
            os.WriteLine(os.Get_stderr(), " vpn proxy dialer tcp: target accept failed")
            return 1
        let requestRes: Result[Bytes] = vpnProxyDialerTcpReadExact(conn, len(vpnProxyDialerTcpRequestText))
        if IsErr(requestRes):
            tcp.TcpClose(conn)
            tcp.TcpListenerClose(listener)
            os.WriteLine(os.Get_stderr(), ErrorText(requestRes))
            return 1
        if !vpnProxyDialerTcpBytesEq(Value(requestRes), vpnProxyDialerTcpTargetRequest()):
            tcp.TcpClose(conn)
            tcp.TcpListenerClose(listener)
            os.WriteLine(os.Get_stderr(), " vpn proxy dialer tcp: target request mismatch")
            return 1
        var response: Bytes = vpnProxyDialerTcpTargetResponse()
        let sendRes: Result[int32] = vpnProxyDialerTcpWriteAll(conn, response)
        if IsErr(sendRes):
            tcp.TcpClose(conn)
            tcp.TcpListenerClose(listener)
            os.WriteLine(os.Get_stderr(), ErrorText(sendRes))
            return 1
        tcp.TcpClose(conn)
    tcp.TcpListenerClose(listener)
    echo(" vpn_proxy_dialer_proxy_tcp_smoke target ok")
    return 0

fn vpnProxyDialerTcpRunProxyExitRole(): int32 =
    let configPath: str = cmdline.ReadFlagOrDefault("--config", "")
    let readyPath: str = cmdline.ReadFlagOrDefault("--ready-path", "")
    let acceptCount: int32 = cmdline.ReadInt32FlagOrDefault("--accept-count", 0)
    let configRes = vpn.VpnProxyLoadConfig(configPath)
    if IsErr(configRes):
        os.WriteLine(os.Get_stderr(), ErrorText(configRes))
        return 1
    var config = Value(configRes)
    let identityRes = vpn.VpnProxyLoadIdentity(config.configDir, config.server, false)
    if IsErr(identityRes):
        os.WriteLine(os.Get_stderr(), ErrorText(identityRes))
        return 1
    var identity = Value(identityRes)
    if identity.certs.len <= 0 || identity.trustRoots.len <= 0 || identity.privateKey.len <= 0:
        os.WriteLine(os.Get_stderr(), " vpn proxy dialer tcp: server identity incomplete")
        return 1
    let leafKindRes = vpn.VpnProxyLoadLeafKeyKind(identity.certs[0])
    if IsErr(leafKindRes):
        os.WriteLine(os.Get_stderr(), ErrorText(leafKindRes))
        return 1
    identity.leafKeyKind = Value(leafKindRes)
    let listenParsedRes: Result[listen.VpnProxyListenAddress] = listen.VpnProxyParseListenAddress(config.server.listen)
    if IsErr(listenParsedRes):
        os.WriteLine(os.Get_stderr(), ErrorText(listenParsedRes))
        return 1
    let listenParsed: listen.VpnProxyListenAddress = Value(listenParsedRes)
    return vpn.VpnProxyExitRunLoop(readyPath,
                                   acceptCount,
                                   config,
                                   identity,
                                   listenParsed.host,
                                   listenParsed.port)

fn vpnProxyDialerTcpRunProxyLocalRole(): int32 =
    let root: str = os.GetCurrentDir()
    let configPath: str = cmdline.ReadFlagOrDefault("--config", "")
    let readyPath: str = cmdline.ReadFlagOrDefault("--ready-path", "")
    let acceptCount: int32 = cmdline.ReadInt32FlagOrDefault("--accept-count", 0)
    let probeTimeoutMs: int32 = cmdline.ReadInt32FlagOrDefault("--probe-timeout-ms", 1000)
    var args: str[]
    args = ["local",
            strutil.Join(["--config:", configPath], ""),
            strutil.Join(["--ready-path:", readyPath], ""),
            strutil.Join(["--accept-count:", IntToStr(acceptCount)], ""),
            strutil.Join(["--probe-timeout-ms:", IntToStr(probeTimeoutMs)], "")]
    return hostcli.VpnProxyMain(root, args)

fn vpnProxyDialerTcpRunClientRole(): int32 =
    let localPort: int32 = cmdline.ReadInt32FlagOrDefault("--local-port", 0)
    let targetPort: int32 = cmdline.ReadInt32FlagOrDefault("--target-port", 0)
    if localPort <= 0 || targetPort <= 0:
        os.WriteLine(os.Get_stderr(), " vpn proxy dialer tcp: client ports required")
        return 1
    let res: Result[bool] = vpnProxyDialerTcpRunClient(localPort, targetPort)
    if IsErr(res):
        os.WriteLine(os.Get_stderr(), ErrorText(res))
        return 1
    echo(" vpn_proxy_dialer_proxy_tcp_smoke client ok")
    return 0

fn main(): int32 =
    let role: str = cmdline.ReadFlagOrDefault("--role", "")
    if role == "target":
        return vpnProxyDialerTcpRunTarget()
    if role == "proxy-exit":
        return vpnProxyDialerTcpRunProxyExitRole()
    if role == "proxy-local":
        return vpnProxyDialerTcpRunProxyLocalRole()
    if role == "client":
        return vpnProxyDialerTcpRunClientRole()
    return vpnProxyDialerTcpRunDefault()
