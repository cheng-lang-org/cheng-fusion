import cheng/core/lang/parser

fn main(): int32 =
    let source =
        "fn Inner(value: int32): int32 =\n    return value + 1\n\nfn Outer(left: int32, right: int32): int32 =\n    return left + right\n\nfn Probe(): int32 =\n    return Outer(Inner(1), 2)\n"
    var layer: parser.NormalizedExprLayer
    var err: str
    assert(parser.ParserReadNormalizedExprLayerFromText(
               "/workspace/nested_call_statement.cheng",
               source,
               layer,
               err),
           err)
    var outerCallBound = false
    var innerCallUnbound = false
    var returnRootBound = false
    for exprIndex in 0..<layer.exprs.len:
        let expr = layer.exprs[exprIndex]
        if expr.kind == parser.NormalizedExprCall &&
           expr.callCallee == "Outer":
            outerCallBound = expr.valueExprCallNodeIndex >= 0 &&
                             expr.valueExprRootNodeIndex ==
                                 expr.valueExprCallNodeIndex &&
                             expr.valueExprStatementRole ==
                                 parser.ParserValueExprStatementReturnValue
        if expr.kind == parser.NormalizedExprCall &&
           expr.callCallee == "Inner":
            innerCallUnbound = expr.valueExprCallNodeIndex >= 0 &&
                               expr.valueExprRootNodeIndex == -1 &&
                               expr.valueExprStatementRole ==
                                   parser.ParserValueExprStatementInvalid
        if expr.kind == parser.NormalizedExprReturn &&
           expr.lineNumber == 8:
            returnRootBound = expr.valueExprRootNodeIndex >= 0 &&
                              expr.valueExprCallNodeIndex ==
                                  expr.valueExprRootNodeIndex &&
                              parser.ParserValueExprNodeKindAt(
                                  layer.valueExprTree,
                                  expr.valueExprRootNodeIndex) ==
                                  parser.ParserValueExprCall
    assert(outerCallBound,
           "parser nested call statement: outer root call not bound")
    assert(innerCallUnbound,
           "parser nested call statement: inner call stole statement root")
    assert(returnRootBound,
           "parser nested call statement: return root not bound")
    parser.NormalizedExprLayerReset(layer)
    echo("parser_nested_call_statement_identity_smoke ok")
    return 0
