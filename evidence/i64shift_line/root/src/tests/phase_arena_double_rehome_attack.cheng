import cheng/core/ir/phase_arena as phase

fn main(): int32 =
    var store: phase.PhaseArenaStore
    phase.PhaseArenaStoreInit(store, 2, 64, 3)
    let source = phase.PhaseArenaStoreOpenArena(store, 1, 32, 1)
    let survivorArena = phase.PhaseArenaStoreOpenArena(store, 2, 32, 2)
    var region = phase.PhaseArenaStoreAllocRef(store, source, 8)
    var replayedIdentity = region
    let first = phase.PhaseArenaStoreRehome(
        store, source, region, survivorArena)
    phase.PhaseArenaStoreGetByte(store, survivorArena, first, 0)
    let duplicate = phase.PhaseArenaStoreRehome(
        store, source, replayedIdentity, survivorArena)
    return phase.PhaseArenaStoreGetByte(
        store, survivorArena, duplicate, 0)
