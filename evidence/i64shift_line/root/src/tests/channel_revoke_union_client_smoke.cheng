# libp2p P5-S1 件3: 撤销并集 (safety UNION) — 请求方 (B) 客户端 exe。
# 真三进程之客户端: 空库从两个 bootstrap peer (A/B) 拉撤销状态并聚合 (Libp2pHostQuicFetchRevocationUnion)。
# 核心断言 = §2d #4: 仅一个 bootstrap 服务撤销、另一个回 miss → 仍硬拒 (撤销并集, 任一命中即胜, 非多数)。
#
# 拓扑 (两 channel_revoke_server_smoke 实例, --revoked-seed 各异):
#   A(port-a): 撤销 seed=revoked-seed 的钥 (channelRev, revokedPub)。
#   B(port-b): 撤销 seed=other 的钥 → 对 (channelRev,revokedPub) 回 miss。
# 客户端确定性同源派生 (与 server deriveKeypair 同算法), 无需捕获 server stdout。
#
# 用法: --port-a <A> --port-b <B> --store-root <B dir> --revoked-seed V --clean-seed C
#
# 三子断言:
#   ① 并集命中 (miss-first): peers=[B,A] 查 (channelRev,revokedPub) → B miss → A found → revoked=true。
#      证: 一个 peer 回 miss 绝不放行, 后位 peer 持撤销经并集浮现 → 硬拒。
#   ② 干净 (both-miss): peers=[A,B] 查 (channelClean,cleanPub) [两 server 皆未撤] → 皆 miss → revoked=false。
#   ③ fail-closed (零确定性 miss): peers=[非法 host:port] → 无任一 miss → 硬 Err (不当 miss 放行)。

import std/system
import std/result
import std/cmdline as cmdline
import std/rawbytes as rawbytes
import cheng/std/bytes_layout as layout
import std/crypto/sha512 as sha512
import std/crypto/ed25519/ref10 as ref10
import cheng/libp2p/protocols/cas_source/channel_head/head_codec as head
import cheng/libp2p/host/host_quic as hq
import std/strutils as strutil

fn deriveKeypair(seedv: int32, priv: var Bytes, pub: var Bytes) =
    var seed = BytesAlloc(32)
    for i in 0..<32:
        BytesSet(seed, i, (seedv + i) & 255)
    var digest = sha512.Sha512Digest(seed)
    BytesSet(digest, 0, BytesGet(digest, 0) & 248)
    BytesSet(digest, 31, (BytesGet(digest, 31) & 63) | 64)
    var r: ref10.GeP3
    ref10.geScalarMultBase(r, BytesSlice(digest, 0, 32))
    pub = ref10.geP3ToBytes(r)
    priv = BytesConcat(seed, pub)

fn main(): int32 =
    let portA = cmdline.ReadInt32FlagOrDefault("--port-a", -1)
    let portB = cmdline.ReadInt32FlagOrDefault("--port-b", -1)
    let storeRoot = cmdline.ReadFlagOrDefault("--store-root", "")
    let revokedSeed = cmdline.ReadInt32FlagOrDefault("--revoked-seed", 47)
    let cleanSeed = cmdline.ReadInt32FlagOrDefault("--clean-seed", 200)
    assert(portA > 0, " union client: --port-a required")
    assert(portB > 0, " union client: --port-b required")
    assert(storeRoot != "", " union client: --store-root required")

    var revokedPriv: Bytes
    var revokedPub: Bytes
    deriveKeypair(revokedSeed, revokedPriv, revokedPub)
    let channelRev = head.ChannelIdForPubKey(revokedPub)
    let revokedPubFixed = layout.FixedBytes32FromBytes(revokedPub).value

    var cleanPriv: Bytes
    var cleanPub: Bytes
    deriveKeypair(cleanSeed, cleanPriv, cleanPub)
    let channelClean = head.ChannelIdForPubKey(cleanPub)
    let cleanPubFixed = layout.FixedBytes32FromBytes(cleanPub).value

    let peerA = strutil.Join(["127.0.0.1:", IntToStr(portA)], "")
    let peerB = strutil.Join(["127.0.0.1:", IntToStr(portB)], "")

    # ---- ① 并集命中 (miss-first): peers=[B,A], B 回 miss, A 持撤销 → 并集 revoked=true ----
    var peers1: str[]
    add(peers1, peerB)
    add(peers1, peerA)
    var revoked1 = false
    let res1 = hq.Libp2pHostQuicFetchRevocationUnion(peers1, "localhost", storeRoot, channelRev, revokedPubFixed, revoked1)
    assert(res1.ok, " ① 并集查询: " + Error(res1))
    assert(revoked1, " ① 并集命中: 前位 B miss 后位 A 持撤销 → revoked=true (任一命中即硬拒, 非多数)")
    echo(strutil.Join([" union client ① UNION-HIT ok (miss-first B → A 撤销浮现) target=", rawbytes.BytesToHex(revokedPub)], ""))

    # ---- ② 干净 (both-miss): peers=[A,B] 查两 server 皆未撤的钥 → 皆 miss → revoked=false ----
    var peers2: str[]
    add(peers2, peerA)
    add(peers2, peerB)
    var revoked2 = false
    let res2 = hq.Libp2pHostQuicFetchRevocationUnion(peers2, "localhost", storeRoot, channelClean, cleanPubFixed, revoked2)
    assert(res2.ok, " ② 干净查询: " + Error(res2))
    assert(!revoked2, " ② both-miss: 两 server 皆无该撤销 → revoked=false (≥1 确定性 miss 放行)")
    echo(" union client ② BOTH-MISS ok (无撤销 → 放行)")

    # ---- ③ fail-closed: 全部 peer 非法/不可达 (零确定性 miss) → 硬 Err, 绝不当 miss 放行 ----
    var peers3: str[]
    add(peers3, "not-a-hostport")
    add(peers3, "127.0.0.1:0")
    var revoked3 = false
    let res3 = hq.Libp2pHostQuicFetchRevocationUnion(peers3, "localhost", storeRoot, channelRev, revokedPubFixed, revoked3)
    assert(IsErr(res3), " ③ fail-closed: 零确定性 miss 必硬 Err (取不到撤销状态 != 无撤销)")
    assert(!revoked3, " ③ fail-closed: outRevoked 保持 false (硬错非放行)")
    echo(strutil.Join([" union client ③ FAIL-CLOSED ok (零确定性 miss → 硬拒) err=[", Error(res3), "]"], ""))

    echo(" channel_revoke_union_client ok")
    return 0
