import std/os as os
import std/strings
import cheng/core/csg_core/csgc
import cheng/core/csg_core/merkle_dag
import cheng/core/csg_core/validator as csg

fn fail(message: str): int32 =
    os.WriteLine(os.Get_stderr(), message)
    return 1

@borrows
fn factPair(left: str, right: str): str[] =
    var lines: str[]
    add(lines, strings.CloneStr(left))
    add(lines, strings.CloneStr(right))
    return lines

fn main(): int32 =
    let schema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core\"}"
    let moduleFact =
        "{\"id\":\"module:main\",\"kind\":\"csg.module\",\"path\":\"main.fixture\",\"sha256\":\"fixture-sha256\"}"
    let admitted =
        csg.CsgCoreProductionAdmitFactLines(
            factPair(schema, moduleFact))
    if !admitted.valid || !admitted.complete:
        return fail("complete facts were rejected")

    let unsupported =
        "{\"code\":\"unsupported_test\",\"id\":\"u1\",\"kind\":\"csg.unsupported\",\"message\":\"unsupported\"}"
    let unsupportedAdmission =
        csg.CsgCoreProductionAdmitFactLines(
            factPair(schema, unsupported))
    if unsupportedAdmission.valid || unsupportedAdmission.complete || unsupportedAdmission.unsupportedCount != 1:
        return fail("unsupported facts crossed production admission")

    let tombstone =
        "{\"id\":\"t1\",\"impact_scope\":\"dead_code_or_unreachable\",\"kind\":\"csg_core::tombstone\",\"original_text_hash\":\"sha256:test\",\"reason\":\"unsupported_test\",\"schema\":\"csg_core\"}"
    let tombstoneSandbox =
        csg.CsgCoreValidateFactLines(
            factPair(schema, tombstone),
            csg.CsgCoreModeSandbox)
    if !tombstoneSandbox.valid || tombstoneSandbox.complete || tombstoneSandbox.tombstoneCount != 1:
        return fail("sandbox tombstone isolation is invalid")
    let tombstoneAdmission =
        csg.CsgCoreProductionAdmitFactLines(
            factPair(schema, tombstone))
    if tombstoneAdmission.valid || tombstoneAdmission.complete:
        return fail("tombstone crossed production admission")

    let unsupportedCargo =
        csgc.CsgCoreCsgcEncodeCanonicalLines(
            factPair(schema, unsupported))
    if !unsupportedCargo.ok:
        return fail("unsupported diagnostic cargo encode failed")
    let decoded =
        csgc.CsgCoreCsgcDecodeLines(
            unsupportedCargo.bytes)
    if !decoded.ok:
        return fail("unsupported diagnostic cargo decode failed")
    let decodedAdmission =
        csg.CsgCoreProductionAdmitFactLines(
            decoded.lines)
    if decodedAdmission.valid || decodedAdmission.complete || decodedAdmission.unsupportedCount != 1:
        return fail("decoded unsupported cargo crossed admission")

    let badSchema =
        "{\"features\":[\"core-facts\"],\"kind\":\"csg.core.schema\",\"schema\":\"csg_core::v1\"}"
    let badSchemaAdmission =
        csg.CsgCoreProductionAdmitFactLines(
            factPair(badSchema, moduleFact))
    if badSchemaAdmission.valid || badSchemaAdmission.complete:
        return fail("schema mismatch crossed admission")

    let incrementalModule =
        csg.CsgCoreProductionAdmitIncrementalFact(
            moduleFact, ["csg_core"])
    if incrementalModule.valid || incrementalModule.complete:
        return fail("single-fact incremental input crossed admission")

    let incrementalCoreInFinance =
        csg.CsgCoreProductionAdmitIncrementalFact(
            moduleFact, ["csg_core", "csg_dialect::finance"])
    if incrementalCoreInFinance.valid ||
       incrementalCoreInFinance.complete:
        return fail("profile list substituted for admitted schema authority")

    let nonCanonicalModule =
        "{\"kind\":\"csg.module\",\"id\":\"module:main\",\"path\":\"main.fixture\",\"sha256\":\"fixture-sha256\"}"
    let nonCanonicalBatch =
        csg.CsgCoreProductionAdmitFactLines(
            factPair(schema, nonCanonicalModule))
    if nonCanonicalBatch.valid ||
       nonCanonicalBatch.complete ||
       nonCanonicalBatch.factCount != 0 ||
       nonCanonicalBatch.factsRoot.len != 0:
        return fail("non-canonical batch fact crossed admission before root")
    var nonCanonicalDag: merkle_dag.CsgCoreMerkleDag
    let nonCanonicalBatchWithDag =
        csg.CsgCoreProductionAdmitFactLinesWithDag(
            factPair(schema, nonCanonicalModule),
            nonCanonicalDag)
    if nonCanonicalBatchWithDag.valid ||
       nonCanonicalBatchWithDag.complete ||
       nonCanonicalBatchWithDag.factCount != 0 ||
       nonCanonicalBatchWithDag.factsRoot.len != 0 ||
       nonCanonicalDag.ok ||
       nonCanonicalDag.factsRoot.len != 0:
        return fail("non-canonical batch fact produced a DAG root")
    var reusedDag: merkle_dag.CsgCoreMerkleDag
    let admittedIntoReusedDag =
        csg.CsgCoreProductionAdmitFactLinesWithDag(
            factPair(schema, moduleFact),
            reusedDag)
    if !admittedIntoReusedDag.valid ||
       !admittedIntoReusedDag.complete ||
       !reusedDag.ok ||
       reusedDag.factsRoot.len == 0:
        return fail("valid DAG reuse fixture did not gain authority")
    let rejectedIntoReusedDag =
        csg.CsgCoreProductionAdmitFactLinesWithDag(
            factPair(schema, nonCanonicalModule),
            reusedDag)
    if rejectedIntoReusedDag.valid ||
       rejectedIntoReusedDag.complete ||
       reusedDag.ok ||
       reusedDag.factCount != 0 ||
       reusedDag.factsRoot.len != 0 ||
       reusedDag.entryKeys.len != 0 ||
       reusedDag.nodeHashes.len != 0:
        return fail("rejected input retained stale DAG authority")
    let nonCanonicalIncremental =
        csg.CsgCoreProductionAdmitIncrementalFact(
            nonCanonicalModule, ["csg_core"])
    if nonCanonicalIncremental.valid ||
       nonCanonicalIncremental.complete:
        return fail("non-canonical incremental fact crossed admission")

    let incompleteModule =
        "{\"id\":\"module:main\",\"kind\":\"csg.module\",\"path\":\"main.fixture\"}"
    let incompleteIncremental =
        csg.CsgCoreProductionAdmitIncrementalFact(
            incompleteModule, ["csg_core"])
    if incompleteIncremental.valid ||
       incompleteIncremental.complete:
        return fail("incomplete incremental fact crossed admission")

    let schemaIncremental =
        csg.CsgCoreProductionAdmitIncrementalFact(
            schema, ["csg_core"])
    if schemaIncremental.valid ||
       schemaIncremental.complete:
        return fail("incremental schema mutation crossed admission")

    let unsupportedIncremental =
        csg.CsgCoreProductionAdmitIncrementalFact(
            unsupported, ["csg_core"])
    if unsupportedIncremental.valid ||
       unsupportedIncremental.complete ||
       unsupportedIncremental.unsupportedCount != 1:
        return fail("incremental unsupported fact crossed admission")

    let tombstoneIncremental =
        csg.CsgCoreProductionAdmitIncrementalFact(
            tombstone, ["csg_core"])
    if tombstoneIncremental.valid ||
       tombstoneIncremental.complete ||
       tombstoneIncremental.tombstoneCount != 1:
        return fail("incremental tombstone crossed admission")

    let runtimeRequirement =
        "{\"id\":\"runtime:node\",\"kind\":\"csg.runtime_requirement\",\"name\":\"node\",\"requirementKind\":\"host_runtime\",\"runtime\":\"node\",\"source\":\"fixture\"}"
    let runtimeIncremental =
        csg.CsgCoreProductionAdmitIncrementalFact(
            runtimeRequirement, ["csg_core"])
    if runtimeIncremental.valid ||
       runtimeIncremental.complete:
        return fail("unresolved runtime requirement crossed admission")

    let compilerFact =
        "{\"kind\":\"csg_dialect::cheng_compiler::texts\",\"texts\":[]}"
    let compilerIncremental =
        csg.CsgCoreProductionAdmitIncrementalFact(
            compilerFact,
            ["csg_core", "csg_dialect::cheng_compiler"])
    if compilerIncremental.valid ||
       compilerIncremental.complete:
        return fail("partial compiler closure crossed admission")

    let typedAction =
        "{\"actionKind\":\"internal_payment\",\"aiGenerated\":false,\"amount\":25,\"asset\":\"USDC\",\"chainId\":8453,\"controlSurfaceId\":\"unimaker.pay.transfer\",\"id\":\"action_1\",\"kind\":\"csg_dialect::finance::typed_action\",\"payloadSchemaHash\":\"sha256:schema\",\"recipientAddress\":\"0xbob\",\"recipientIdentity\":\"did:unimaker:bob\",\"sourceKind\":\"typed_action\",\"uiDisplayHash\":\"sha256:ui\",\"userAuthorized\":true,\"userId\":\"user_alice\",\"userIntentHash\":\"sha256:intent\",\"visualClickPath\":false}"
    let mismatchedProfile =
        csg.CsgCoreProductionAdmitIncrementalFact(
            typedAction, ["csg_core", "csg_dialect::vexa"])
    if mismatchedProfile.valid ||
       mismatchedProfile.complete:
        return fail("mismatched incremental profile crossed admission")

    let unknownProfile =
        csg.CsgCoreProductionAdmitIncrementalFact(
            moduleFact, ["csg_core", "csg_dialect::unknown"])
    if unknownProfile.valid ||
       unknownProfile.complete:
        return fail("unknown incremental profile crossed admission")

    os.WriteLine(
        os.Get_stdout(),
        "csg_core_production_admission_smoke ok")
    return 0
