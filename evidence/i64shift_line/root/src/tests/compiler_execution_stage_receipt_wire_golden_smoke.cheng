import std/os
import std/rawbytes as rawbytes
import std/result
import std/strformat
import std/strings
import cheng/core/tooling/compiler_execution_stage_receipt as execution_receipt
import cheng/core/tooling/compiler_execution_stage_receipt_wire as receiptwire
import cheng/std/bytes_layout as layout

fn GoldenFixedBytes32Copy(
        value: layout.FixedBytes32): layout.FixedBytes32 =
    var out: layout.FixedBytes32
    for index in 0..<layout.FixedBytes32Size:
        out.data[index] = value.data[index]
    return out

fn GoldenOwnedBytesFromText(text: str): rawbytes.Bytes =
    var out = rawbytes.BytesAlloc(text.len)
    assert(rawbytes.BytesLen(out) == text.len,
           " execution stage receipt golden: bytes allocation")
    for index in 0..<text.len:
        rawbytes.BytesSet(out, index, Int32(text[index]) & 255)
    return out

fn GoldenObservedRaw32(text: str): layout.FixedBytes32 =
    var observed = GoldenOwnedBytesFromText(text)
    defer:
        rawbytes.BytesFree(observed)
    let result = execution_receipt.CompilerExecutionIdentityObservedRaw32(observed)
    assert(IsOk(result),
           " execution stage receipt golden: observed raw32")
    return Value(result)

fn GoldenIdentity(): execution_receipt.CompilerExecutionIdentity =
    let result = execution_receipt.CompilerExecutionIdentityMake(
        "bounded.case.validator.0001",
        GoldenObservedRaw32("{\"rawSourceFiles\":[\"case.cheng\"]}\n"),
        GoldenObservedRaw32("export const materializer = 'exact';\n"),
        GoldenObservedRaw32(
            "{\"required\":966,\"schema\":\"cheng_grammar_obligation_contract\"}\n"),
        GoldenObservedRaw32("schema=compiler_source_closure\n"),
        GoldenObservedRaw32("exact current-source driver bytes\n"),
        GoldenObservedRaw32("schema=private_toolchain\n"),
        GoldenObservedRaw32(
            "target=arm64-apple-darwin\nBACKEND_JOBS=1\n"),
        "arm64-apple-darwin")
    assert(IsOk(result),
           " execution stage receipt golden: identity")
    return Value(result)

fn GoldenProducerSource(stageKind: str, ordinal: int32): str =
    return Fmt"module {stageKind}\nfn Produce{ordinal}(): int32 =\n    return {ordinal}\n"

fn GoldenSidecar(stageKind: str): str =
    return Fmt"{stageKind}:canonical semantic sidecar bytes\n"

fn GoldenArtifactBytes(stageKind: str, ordinal: int32): rawbytes.Bytes =
    assert(ordinal >= 1 && ordinal <= 7,
           " execution stage receipt golden: artifact ordinal")
    let prefix = Fmt"{stageKind}:canonical real artifact bytes"
    var out = rawbytes.BytesAlloc(prefix.len + 2)
    assert(rawbytes.BytesLen(out) == prefix.len + 2,
           " execution stage receipt golden: artifact allocation")
    for index in 0..<prefix.len:
        rawbytes.BytesSet(out, index, Int32(prefix[index]) & 255)
    rawbytes.BytesSet(out, prefix.len, 0)
    rawbytes.BytesSet(out, prefix.len + 1, 48 + ordinal)
    return out

fn GoldenBuildSeven(
        identity: execution_receipt.CompilerExecutionIdentity,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        receipts: var execution_receipt.ExecutionStageReceipt[]) =
    let stageKinds = [
        execution_receipt.ExecutionStageReceiptStageTypedExpr,
        execution_receipt.ExecutionStageReceiptStageCsg,
        execution_receipt.ExecutionStageReceiptStageLowering,
        execution_receipt.ExecutionStageReceiptStagePrimary,
        execution_receipt.ExecutionStageReceiptStagePrimaryRegalloc,
        execution_receipt.ExecutionStageReceiptStageBackend2,
        execution_receipt.ExecutionStageReceiptStageBackend2Regalloc]
    let laneKinds = [
        execution_receipt.ExecutionStageReceiptLaneShared,
        execution_receipt.ExecutionStageReceiptLaneShared,
        execution_receipt.ExecutionStageReceiptLaneShared,
        execution_receipt.ExecutionStageReceiptLanePrimary,
        execution_receipt.ExecutionStageReceiptLanePrimary,
        execution_receipt.ExecutionStageReceiptLaneBackend2,
        execution_receipt.ExecutionStageReceiptLaneBackend2]
    let predecessorKinds = [
        execution_receipt.ExecutionStageReceiptStageParser,
        execution_receipt.ExecutionStageReceiptStageTypedExpr,
        execution_receipt.ExecutionStageReceiptStageCsg,
        execution_receipt.ExecutionStageReceiptStageLowering,
        execution_receipt.ExecutionStageReceiptStagePrimary,
        execution_receipt.ExecutionStageReceiptStageLowering,
        execution_receipt.ExecutionStageReceiptStageBackend2]
    let predecessorIndexes = [-1, 0, 1, 2, 3, 2, 5]
    let expectedReceiptRaw32s = [
        "cc572b2bd1eb27456a19b650bad11543535743adb73febdc534d3b58c7a943e0",
        "b43f64fc35ba47cf26ede919f4970c74a5667798b651a9739b306d584def4b4a",
        "7ba37a57120f8c622fdaa72b16816132f5c480cf1681739a262b6445fef5e284",
        "aea96b549de65e3de11c1b53c906dee2f2c8c804f5430cefd24daff43a04bcd4",
        "ab2c728f86abc28f3736c55f09d6492ef14f1381dfccba321bb837f32191ae90",
        "56cfba46aa4805e71983cefcf7ccb8d96b939237adab79be6345f038ea24349c",
        "ac51ff7348ad523ed7590724cac3b7dc1ae4970b37e49613f80d80a8d23977f9"]
    for index in 0..<stageKinds.len:
        let ordinal = index + 1
        let stageKind = stageKinds[index]
        var predecessorReceiptRaw32 = parserReceiptRaw32
        var inputSemanticRaw32 = parserSemanticRaw32
        let predecessorIndex = predecessorIndexes[index]
        if predecessorIndex >= 0:
            predecessorReceiptRaw32 =
                GoldenFixedBytes32Copy(
                    receipts[predecessorIndex].receiptRaw32)
            inputSemanticRaw32 =
                GoldenFixedBytes32Copy(
                    receipts[predecessorIndex].outputSemanticRaw32)

        var producerSourceBytes = GoldenOwnedBytesFromText(
            GoldenProducerSource(stageKind, ordinal))
        var sidecarBytes = GoldenOwnedBytesFromText(
            GoldenSidecar(stageKind))
        var artifactBytes = GoldenArtifactBytes(stageKind, ordinal)
        let result = execution_receipt.ExecutionStageReceiptMakeObserved(
            identity,
            stageKind,
            laneKinds[index],
            producerSourceBytes,
            predecessorKinds[index],
            predecessorReceiptRaw32,
            inputSemanticRaw32,
            Fmt"stages/0{ordinal}-{stageKind}/semantic.sidecar.bin",
            sidecarBytes,
            Fmt"stages/0{ordinal}-{stageKind}/artifact.bin",
            artifactBytes)
        rawbytes.BytesFree(producerSourceBytes)
        rawbytes.BytesFree(sidecarBytes)
        rawbytes.BytesFree(artifactBytes)
        assert(IsOk(result),
               Fmt" execution stage receipt golden: stage {ordinal}")
        let receipt = Value(result)
        assert(layout.FixedBytes32Hex(receipt.receiptRaw32) ==
                   expectedReceiptRaw32s[index],
               Fmt" execution stage receipt golden: stage {ordinal} root")
        add(receipts, receipt)

fn GoldenObserveSeven(
        identity: execution_receipt.CompilerExecutionIdentity,
        parserReceiptRaw32: layout.FixedBytes32,
        parserSemanticRaw32: layout.FixedBytes32,
        receipts: execution_receipt.ExecutionStageReceipt[]): layout.FixedBytes32 =
    let initResult = execution_receipt.CompilerSevenStageReceiptValidatorInit(
        identity, parserReceiptRaw32, parserSemanticRaw32)
    assert(IsOk(initResult),
           " execution stage receipt golden: validator init")
    var validator = Value(initResult)
    for index in 0..<receipts.len:
        let ordinal = index + 1
        let stageKind = receipts[index].stageKind
        var producerSourceBytes = GoldenOwnedBytesFromText(
            GoldenProducerSource(stageKind, ordinal))
        var sidecarBytes = GoldenOwnedBytesFromText(
            GoldenSidecar(stageKind))
        var artifactBytes = GoldenArtifactBytes(stageKind, ordinal)
        let result = execution_receipt.CompilerSevenStageReceiptValidatorObserve(
            validator,
            identity,
            receipts[index],
            producerSourceBytes,
            sidecarBytes,
            artifactBytes)
        rawbytes.BytesFree(producerSourceBytes)
        rawbytes.BytesFree(sidecarBytes)
        rawbytes.BytesFree(artifactBytes)
        assert(IsOk(result),
               Fmt" execution stage receipt golden: observe {ordinal}")
    let rootResult =
        execution_receipt.CompilerSevenStageReceiptValidatorFinalize(validator)
    assert(IsOk(rootResult),
           " execution stage receipt golden: validator finalize")
    return Value(rootResult)

fn main(): int32 =
    let identity = GoldenIdentity()
    assert(layout.FixedBytes32Hex(identity.executionRaw32) ==
               "d19f410fe0f3de1c6fb6d3129b94c77737b148f3c0e7adb53b011e3fa11deda1",
           " execution stage receipt golden: execution root")
    let parserReceiptRaw32 =
        GoldenObservedRaw32("parser-receipt:exact-trace")
    let parserSemanticRaw32 =
        GoldenObservedRaw32("parser-semantic:exact-trace")
    var receipts: execution_receipt.ExecutionStageReceipt[]
    GoldenBuildSeven(identity,
                     parserReceiptRaw32,
                     parserSemanticRaw32,
                     receipts)
    assert(receipts.len == 7,
           " execution stage receipt golden: exactly seven stages")
    let sevenStageRootRaw32 = GoldenObserveSeven(identity,
                                                 parserReceiptRaw32,
                                                 parserSemanticRaw32,
                                                 receipts)
    assert(layout.FixedBytes32Hex(sevenStageRootRaw32) ==
               "49010897bd87514a8ea188e45d5fe2b3d6b5e84177f1b905e72f6f3f03565b42",
           " execution stage receipt golden: seven-stage root")

    let observedPaths = receiptwire.CompilerExecutionObservedPathsMake(
        "identity/source-bundle.json",
        "identity/materializer.ts",
        "identity/grammar-obligation-contract.json",
        "identity/compiler-source-closure.rec",
        "identity/cheng",
        "identity/toolchain.manifest",
        "identity/command.manifest")
    var producerSourcePaths = [
        "producers/typed_expr.cheng",
        "producers/csg.cheng",
        "producers/lowering.cheng",
        "producers/primary.cheng",
        "producers/primary_regalloc.cheng",
        "producers/backend2.cheng",
        "producers/backend2_regalloc.cheng"]
    let wireResult =
        receiptwire.CompilerExecutionStageBundleCanonicalJson(
            identity,
            observedPaths,
            parserReceiptRaw32,
            parserSemanticRaw32,
            receipts,
            producerSourcePaths,
            sevenStageRootRaw32)
    assert(IsOk(wireResult),
           " execution stage receipt golden: canonical wire")
    let wire = Value(wireResult)
    assert(wire.len > 1 && wire[wire.len - 1] == '\n' &&
               wire[wire.len - 2] != '\n',
           " execution stage receipt golden: exactly one LF")
    assert(strings.StrContains(
               wire,
               "\"receiptSha256\":\"d7835d06a452e5f5bde88414a53b82e42aa5ef4756e95d1d51ba895d292ea649\""),
           " execution stage receipt golden: payload root")
    assert(layout.FixedBytes32Hex(GoldenObservedRaw32(wire)) ==
               "2a39b4ed5679166551ac0225c35407c675579d1f7e6a7d1b570b9c26c3ce4713",
           " execution stage receipt golden: final JSON+LF root")

    os.WriteLine(os.GetStdout(),
                 "COMPILER_EXECUTION_STAGE_RECEIPT_WIRE_GOLDEN_OK")
    return 0
