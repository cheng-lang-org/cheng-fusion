import std/rawbytes as rawbytes
import cheng/core/backend/primary_object_plan as primary
import cheng/core/backend2/backend2_frag_codec as codec
import cheng/core/ir/core_types as ir
import cheng/std/bytes_layout as layout
import cheng/std/crypto/hash256 as hash256
import std/result

fn prevalidateTypeArenaArtifactCid(): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(
        "7777777777777777777777777777777777777777777777777777777777777777")
    assert(IsOk(parsed), "primary lower-pool TypeArena CID fixture")
    return Value(parsed)

@borrows
fn prevalidateFixtureCid(label: str): layout.FixedBytes32 =
    assert(label != "", "primary lower-pool fixture CID label")
    var buf = layout.ByteBufInit(label.len)
    for index in 0..<label.len:
        layout.ByteBufAppendByte(buf, Int32(label[index]) & 255)
    let out = hash256.Sha256Fixed(layout.ByteBufView(buf))
    layout.ByteBufFree(buf)
    return out

fn rejectsByteMutation(body: var ir.BodyIR,
                       offset: int32,
                       value: int32): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    if offset < 0 || offset >= payload.len:
        rawbytes.BytesFree(payload)
        return false
    rawbytes.BytesSet(payload, offset, value)
    let rejected = !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    return rejected

fn rejectsWordMutation(body: var ir.BodyIR,
                       offset: int32,
                       value: int32): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    if offset < 0 || offset > payload.len - 4:
        rawbytes.BytesFree(payload)
        return false
    codec.Backend2CodecPutU32(payload, offset, value)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    return rejected

fn rejectsZeroedRange(body: var ir.BodyIR,
                      offset: int32,
                      count: int32): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    if offset < 0 || count <= 0 || offset > payload.len - count:
        rawbytes.BytesFree(payload)
        return false
    for index in 0..<count:
        rawbytes.BytesSet(payload, offset + index, 0)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    return rejected

fn rejectsTruncationAt(body: var ir.BodyIR,
                       truncatedLength: int32): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    if truncatedLength < 0 || truncatedLength >= payload.len:
        rawbytes.BytesFree(payload)
        return false
    let truncated = rawbytes.BytesSliceView(
        payload, 0, truncatedLength)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(truncated)
    rawbytes.BytesFree(payload)
    return rejected

fn rejectsOldHeader(body: var ir.BodyIR): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    var oldPayload = rawbytes.BytesAlloc(payload.len + 4)
    rawbytes.BytesCopyRangeInto(oldPayload, 0, payload, 0, 4)
    codec.Backend2CodecPutU32(oldPayload, 4, 5)
    rawbytes.BytesCopyRangeInto(oldPayload, 8, payload, 4, payload.len - 4)
    let rejected = !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(oldPayload)
    rawbytes.BytesFree(payload)
    rawbytes.BytesFree(oldPayload)
    return rejected

fn rejectsOldMagic(body: var ir.BodyIR): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    codec.Backend2CodecPutU32(payload, 0, 0x42424955)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    return rejected

fn rejectsLengthDrift(body: var ir.BodyIR): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    let truncated = rawbytes.BytesSliceView(payload, 0, payload.len - 1)
    var trailing = rawbytes.BytesAlloc(payload.len + 1)
    rawbytes.BytesCopyRangeInto(trailing, 0, payload, 0, payload.len)
    rawbytes.BytesSet(trailing, payload.len, 0x5a)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(truncated) &&
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(trailing)
    rawbytes.BytesFree(payload)
    rawbytes.BytesFree(trailing)
    return rejected

fn rejectsWordDeletion(body: var ir.BodyIR, offset: int32): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    if offset < 0 || offset > payload.len - 4:
        rawbytes.BytesFree(payload)
        return false
    var deleted = rawbytes.BytesAlloc(payload.len - 4)
    rawbytes.BytesCopyRangeInto(
        deleted, 0, payload, 0, offset)
    rawbytes.BytesCopyRangeInto(
        deleted, offset, payload, offset + 4,
        payload.len - offset - 4)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(deleted)
    rawbytes.BytesFree(payload)
    rawbytes.BytesFree(deleted)
    return rejected

fn rejectsWordInsertion(body: var ir.BodyIR, offset: int32): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    if offset < 0 || offset > payload.len:
        rawbytes.BytesFree(payload)
        return false
    var inserted = rawbytes.BytesAlloc(payload.len + 4)
    rawbytes.BytesCopyRangeInto(
        inserted, 0, payload, 0, offset)
    codec.Backend2CodecPutU32(inserted, offset, 0)
    rawbytes.BytesCopyRangeInto(
        inserted, offset + 4, payload, offset,
        payload.len - offset)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(inserted)
    rawbytes.BytesFree(payload)
    rawbytes.BytesFree(inserted)
    return rejected

fn rejectsManualConsumeTagSwap(
        body: var ir.BodyIR,
        manualConsumeTagOffset: int32): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    let typeArenaTagOffset = payload.len - 36
    if manualConsumeTagOffset < 0 ||
       manualConsumeTagOffset > payload.len - 4 ||
       typeArenaTagOffset < 0 ||
       typeArenaTagOffset > payload.len - 4:
        rawbytes.BytesFree(payload)
        return false
    codec.Backend2CodecPutU32(
        payload, manualConsumeTagOffset, 11)
    codec.Backend2CodecPutU32(
        payload, typeArenaTagOffset, 14)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    return rejected

fn manualConsumeCid(hexValue: str): layout.FixedBytes32 =
    let parsed = layout.FixedBytes32FromHex(hexValue)
    assert(IsOk(parsed), "primary lower-pool manual-consume CID")
    return Value(parsed)

fn appendManualConsumeParameterSlot(
        body: var ir.BodyIR,
        name: str,
        placeKind: int32,
        ownership: ir.OwnershipKind): int32 =
    var slot: ir.LocalSlot
    slot.id = body.localSlots.len
    slot.name = name
    slot.typeKind = ir.LocalAggregateTag
    slot.stackOffset = -1 - slot.id
    slot.sizeBytes = 24
    slot.alignBytes = 8
    ir.BodyIRApplyLocalSlotDefaultProof(slot)
    slot.placeKind = placeKind
    slot.ownership = ownership
    let slotId = slot.id
    add(body.localSlots, slot)
    assert(ir.BodyIRBindLocalSlotTypeArenaProof(
               body,
               slotId,
               manualConsumeCid(
                   "1111111111111111111111111111111111111111111111111111111111111111"),
               7,
               ir.BodyManagedStorageManagedTag),
           "primary lower-pool manual-consume slot proof")
    return slotId

fn manualConsumeBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    assert(ir.BodyIRBindCanonicalTypeFact(
               body,
               manualConsumeCid(
                   "1111111111111111111111111111111111111111111111111111111111111111"),
               3, 4, 0, 7, 0, 8, 8),
           "primary lower-pool manual-consume target type")
    assert(ir.BodyIRBindCanonicalTypeFact(
               body,
               manualConsumeCid(
                   "1111111111111111111111111111111111111111111111111111111111111111"),
               7, 1, 10, -1, 0, 24, 8),
           "primary lower-pool manual-consume source type")
    let targetSlot = appendManualConsumeParameterSlot(
        body,
        "manual_consume_target",
        ir.BodyPlaceParamAddressTag,
        ir.OwnBorrowUnique)
    let sourceSlot = appendManualConsumeParameterSlot(
        body,
        "manual_consume_source",
        ir.BodyPlaceStackValueTag,
        ir.OwnMove)
    var entryOwnershipKinds: int32[]
    add(entryOwnershipKinds, int32(ir.OwnBorrowUnique))
    add(entryOwnershipKinds, int32(ir.OwnMove))
    ir.BodyIRFreezeEntryDefinitionOwnershipKinds(
        body, entryOwnershipKinds)

    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "manual_consume_fixture"
    call.semanticCallExprNodeIndex = 303
    add(call.argSlots, ir.CallArgSlotAddress(targetSlot))
    add(call.argPassKinds, ir.BodyCallPassBorrowAddressTag)
    add(call.argAbiSizes, 8)
    add(call.argSlots, ir.CallArgSlotAddress(sourceSlot))
    add(call.argPassKinds, ir.BodyCallPassParamAddressTag)
    add(call.argAbiSizes, 8)
    add(body.callSequence, call)

    var op: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(op)
    op.kind = ir.BodyOpCallTag
    add(op.operands, 0)
    let _opIndex = ir.BodyIRAppendOp(body, op)
    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _blockIndex = ir.BodyIRAppendBlock(
        body, 0, 1, termIndex)

    ir.BodyIRControlFlowBegin(body, 101)
    ir.BodyIRControlFlowBindBlockScope(body, 0, 0)
    var successors: int32[]
    var edgeKinds: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, successors, edgeKinds)
    ir.BodyIRControlFlowBindCallTarget(
        body,
        0,
        ir.BodyCallTargetDomainFunctionTag,
        202,
        manualConsumeCid(
            "2222222222222222222222222222222222222222222222222222222222222222"))
    ir.BodyIRControlFlowSeal(body)

    ir.BodyIRManualConsumeBindFunction(
        body,
        101,
        0,
        1,
        targetSlot,
        sourceSlot,
        3,
        7,
        manualConsumeCid(
            "3333333333333333333333333333333333333333333333333333333333333333"),
        manualConsumeCid(
            "4444444444444444444444444444444444444444444444444444444444444444"))
    var effect: ir.BodyIRManualConsumeCallEffect
    effect.callOrdinal = 0
    effect.snapshotCallId = 404
    effect.targetArgumentOrdinal = 0
    effect.sourceArgumentOrdinal = 1
    effect.targetPlaceSlotId = targetSlot
    effect.targetOwnerSlotId = targetSlot
    effect.sourcePlaceSlotId = sourceSlot
    effect.targetArgumentBindingCid = manualConsumeCid(
        "5555555555555555555555555555555555555555555555555555555555555555")
    effect.sourceArgumentBindingCid = manualConsumeCid(
        "6666666666666666666666666666666666666666666666666666666666666666")
    effect.targetProjectionCid = manualConsumeCid(
        "7777777777777777777777777777777777777777777777777777777777777777")
    effect.sourceProjectionCid = manualConsumeCid(
        "8888888888888888888888888888888888888888888888888888888888888888")
    effect.targetDefinitionDomain =
        ir.BodyDefinitionDomainEntrySlotTag
    effect.targetDefinitionRow = targetSlot
    effect.sourceDefinitionDomain =
        ir.BodyDefinitionDomainEntrySlotTag
    effect.sourceDefinitionRow = sourceSlot
    effect.targetTypeArenaTypeId = 3
    effect.sourceTypeArenaTypeId = 7
    effect.postDefinitionDomain =
        ir.BodyDefinitionDomainManualConsumePostCallTag
    effect.postDefinitionRow = 0
    effect.effectCid = manualConsumeCid(
        "9999999999999999999999999999999999999999999999999999999999999999")
    effect.linearTokenCid = manualConsumeCid(
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
    effect.bridgeCid = manualConsumeCid(
        "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb")
    ir.BodyIRManualConsumeAppendCall(body, effect)
    ir.BodyIRManualConsumeSeal(body)
    return body

fn nonemptyManualConsumePrevalidate(): bool =
    var body = manualConsumeBody()
    var payload = codec.Backend2BodyIrEncode(body)
    # Manual consume is followed by entry ownership, canonical-empty FFI,
    # canonical-empty field17 cleanup authority and the TypeArena tail.
    let manualConsumeTagOffset = payload.len - 1456
    var cursor = manualConsumeTagOffset
    let exactTag =
        codec.Backend2CodecReadU32(payload, cursor) == 14
    let valid =
        primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    if !exactTag || !valid:
        return false
    return rejectsByteMutation(body, 4, 17) &&
           rejectsByteMutation(body, manualConsumeTagOffset, 11) &&
           rejectsByteMutation(
               body, manualConsumeTagOffset + 104, 2) &&
           rejectsWordMutation(body, manualConsumeTagOffset + 116, 405) &&
           rejectsByteMutation(body, manualConsumeTagOffset + 444, 0) &&
           rejectsByteMutation(body, manualConsumeTagOffset + 508, 14) &&
           rejectsByteMutation(body, manualConsumeTagOffset + 512, 0) &&
           rejectsWordMutation(body, manualConsumeTagOffset + 516, 1) &&
           rejectsWordMutation(
               body, manualConsumeTagOffset + 520, int32(ir.OwnMove)) &&
           rejectsByteMutation(body, manualConsumeTagOffset + 528, 15) &&
           rejectsWordMutation(body, manualConsumeTagOffset + 532, 1) &&
           rejectsWordMutation(body, manualConsumeTagOffset + 536, 101) &&
           rejectsByteMutation(body, manualConsumeTagOffset + 540, 1) &&
           rejectsWordMutation(body, manualConsumeTagOffset + 636, 1) &&
           rejectsByteMutation(body, manualConsumeTagOffset + 776, 1) &&
           rejectsByteMutation(body, manualConsumeTagOffset + 808, 16) &&
           rejectsWordMutation(body, manualConsumeTagOffset + 812, 1) &&
           rejectsByteMutation(body, manualConsumeTagOffset + 816, 1) &&
           rejectsWordDeletion(body, manualConsumeTagOffset) &&
           rejectsWordInsertion(body, manualConsumeTagOffset + 508) &&
           rejectsManualConsumeTagSwap(
               body, manualConsumeTagOffset)

fn requiredDebugPrevalidate(): bool =
    var body = ir.BodyIRNew()
    if !ir.BodyIRBindTypeArenaArtifactCid(
           body,
           prevalidateTypeArenaArtifactCid()):
        return false
    if !ir.BodyIRDebugProvenanceBegin(body, 7) ||
       !ir.BodyIRDebugProvenanceSetExact(body, 11):
        return false
    var op: ir.BodyOp
    op.kind = ir.BodyOpLoadConstTag
    op.target = 0
    add(op.operands, ir.LocalI32Tag)
    add(op.operands, 1)
    let _ = ir.BodyIRAppendOp(body, op)
    if !ir.BodyIRDebugProvenanceSetSynthetic(
           body, ir.BodyDebugSyntheticControlFlow):
        return false
    var term: ir.BodyTerm
    term.kind = ir.BodyTermReturnTag
    term.resultSlot = -1
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let _ = ir.BodyIRAppendBlock(body, 0, 1, termIndex)
    var payload = codec.Backend2BodyIrEncode(body)
    let payloadLen = payload.len
    let valid = primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    if !valid:
        echo("required_debug_valid_failed")
        return false
    # Exact field offsets in this fixture: field18 canonical-empty data
    # identity adds 28 bytes before field7; field8 complete/function are at
    # 212/216, field9 row at 228, field10 synthetic kind at 248.
    if payloadLen != 1428 ||
       !rejectsByteMutation(body, 212, 0):
        echo("required_debug_complete_attack_failed")
        return false
    if !rejectsWordMutation(body, 216, -1):
        echo("required_debug_function_attack_failed")
        return false
    if !rejectsWordMutation(body, 228, -1):
        echo("required_debug_op_attack_failed")
        return false
    if !rejectsWordMutation(body, 248, 0):
        echo("required_debug_term_attack_failed")
        return false
    return true

fn nonemptyFfiHandleBody(): ir.BodyIR =
    var body = ir.BodyIRNew()
    let typeArenaCid = prevalidateTypeArenaArtifactCid()
    let interfaceCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.interface")
    assert(ir.BodyIRBindCanonicalTypeFact(
               body, typeArenaCid, 7, 1, 10, -1, 0, 4, 4),
           "primary lower-pool ffi handle scalar type")

    var resultSlot: ir.LocalSlot
    ir.BodyIRApplyLocalSlotDefaultProof(resultSlot)
    resultSlot.id = 0
    resultSlot.name = "ffi_handle_result"
    resultSlot.typeKind = ir.LocalI32Tag
    resultSlot.stackOffset = -4
    resultSlot.sizeBytes = 4
    resultSlot.alignBytes = 4
    add(body.localSlots, resultSlot)
    assert(ir.BodyIRBindLocalSlotTypeArenaProof(
               body, 0, typeArenaCid, 7,
               ir.BodyManagedStorageUnmanagedTag),
           "primary lower-pool ffi handle result type proof")

    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "ffi_handle_new"
    call.targetSourcePath = "ffi/handle.cheng"
    call.resultSlot = 0
    call.resultOwnership = ir.OwnPlain
    call.resultExprNodeIndex = 41
    call.semanticCallExprNodeIndex = 41
    call.targetIsImportc = true
    add(body.callSequence, call)

    var prefixOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(prefixOp)
    prefixOp.kind = ir.BodyOpLoadConstTag
    prefixOp.target = 0
    add(prefixOp.operands, ir.LocalI32Tag)
    add(prefixOp.operands, 0)
    let prefixBodyOpRow = ir.BodyIRAppendOp(body, prefixOp)
    assert(prefixBodyOpRow == 0,
           "primary lower-pool ffi handle prefix BodyOp row")

    var callOp: ir.BodyOp
    ir.BodyIRApplyBodyOpDefaultProof(callOp)
    callOp.kind = ir.BodyOpCallTag
    callOp.target = 0
    add(callOp.operands, 0)
    let callBodyOpRow = ir.BodyIRAppendOp(body, callOp)
    assert(callBodyOpRow == 1,
           "primary lower-pool ffi handle exact call BodyOp row")

    var term: ir.BodyTerm
    ir.BodyIRApplyBodyTermDefaultProof(term)
    term.kind = ir.BodyTermReturnTag
    let termIndex = ir.BodyIRAppendTerm(body, term)
    let blockId = ir.BodyIRAppendBlock(body, 0, 2, termIndex)
    ir.BodyIRControlFlowBegin(body, 17)
    ir.BodyIRControlFlowBindBlockScope(body, blockId, 0)
    var noSuccessors: int32[]
    var noEdgeKinds: int32[]
    ir.BodyIRControlFlowBindTermSuccessors(
        body, termIndex, noSuccessors, noEdgeKinds)
    ir.BodyIRControlFlowBindCallTarget(
        body, 0, ir.BodyCallTargetDomainExternFunctionTag, 3,
        interfaceCid)
    ir.BodyIRControlFlowSeal(body)

    ir.BodyIRExternFfiHandleCapabilityBegin(
        body,
        17,
        prevalidateFixtureCid("cheng.test.primary.ffi_handle.snapshot"),
        prevalidateFixtureCid("cheng.test.primary.ffi_handle.cargo"),
        prevalidateFixtureCid("cheng.test.primary.ffi_handle.lowering"))
    assert(body.controlFlowSealed &&
           ir.BodyIRUniqueCallBodyOpRow(body, 0) == callBodyOpRow,
           "primary lower-pool ffi handle sealed unique Call BodyOp")
    var callCapability: ir.BodyIRExternFfiHandleCallCapability
    callCapability.callOrdinal = 0
    callCapability.semanticCapabilityCallRow = 0
    callCapability.resolvedCallRow = 0
    callCapability.snapshotCallId = 0
    callCapability.semanticContractRow = 0
    callCapability.snapshotContractRow = 0
    callCapability.semanticEffectStart = 0
    callCapability.effectCount = 1
    callCapability.callCapabilityCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.call_capability")
    callCapability.contractCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.contract")
    callCapability.interfaceCid = interfaceCid
    callCapability.callBridgeCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.call_bridge")
    ir.BodyIRExternFfiHandleCapabilityAppendCall(body, callCapability)
    assert(body.externFfiHandleCapabilities.callBodyOpRows.len == 1 &&
           body.externFfiHandleCapabilities.callBodyOpRows[0] ==
               callBodyOpRow,
           "primary lower-pool ffi handle API-bound Call BodyOp row")

    var effectCapability: ir.BodyIRExternFfiHandleEffectCapability
    effectCapability.semanticCapabilityEffectRow = 0
    effectCapability.contractEffectRow = 0
    effectCapability.snapshotEffectRow = 0
    effectCapability.snapshotEffectContractRow = 0
    effectCapability.effectKind =
        ir.BodyExternFfiHandleEffectProduceTag
    effectCapability.targetKind =
        ir.BodyExternFfiHandleTargetResultTag
    effectCapability.argumentSlotId = 0
    effectCapability.argumentValueNodeIndex = 41
    effectCapability.valueDefinitionRow = 0
    effectCapability.generationRootValueDefinitionRow = 0
    effectCapability.exactTypeId = 7
    effectCapability.carrierKind =
        ir.BodyExternFfiHandleCarrierUInt32Tag
    effectCapability.typeCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.type")
    effectCapability.generationCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.generation")
    effectCapability.definitionLineageCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.definition_lineage")
    effectCapability.effectCapabilityCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.effect_capability")
    effectCapability.contractEffectCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.contract_effect")
    effectCapability.effectBridgeCid = prevalidateFixtureCid(
        "cheng.test.primary.ffi_handle.effect_bridge")
    ir.BodyIRExternFfiHandleCapabilityAppendEffect(
        body, effectCapability)
    ir.BodyIRExternFfiHandleCapabilitySeal(body)
    assert(ir.BodyIRExternFfiHandleCapabilitySidecarShapeValid(body),
           "primary lower-pool ffi handle source sidecar")
    return body

fn rejectsWrongFfiHandleCallBodyOpRow(): bool =
    var body = nonemptyFfiHandleBody()
    var payload = codec.Backend2BodyIrEncode(body)
    # One-call/one-effect field16 is followed by the canonical-empty field17
    # cleanup authority and the 36-byte TypeArena tail.
    let ffiHandleTagOffset = payload.len - 1376
    let canonicalCallBodyOpRow =
        ir.BodyIRUniqueCallBodyOpRow(body, 0)
    let exactColumnOrder =
        canonicalCallBodyOpRow == 1 &&
        codec.Backend2CodecReadU32(payload, ffiHandleTagOffset) == 16 &&
        codec.Backend2CodecReadU32(
            payload, ffiHandleTagOffset + 108) == 1 &&
        codec.Backend2CodecReadU32(
            payload, ffiHandleTagOffset + 112) == 0 &&
        codec.Backend2CodecReadU32(
            payload, ffiHandleTagOffset + 116) == 1 &&
        codec.Backend2CodecReadU32(
            payload, ffiHandleTagOffset + 120) ==
                canonicalCallBodyOpRow
    let valid =
        primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    codec.Backend2CodecPutU32(
        payload, ffiHandleTagOffset + 120, 0)
    let rejected =
        !primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    var recovered = codec.Backend2BodyIrEncode(body)
    let recoveredValid =
        primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(recovered) &&
        codec.Backend2CodecReadU32(
            recovered, ffiHandleTagOffset + 120) ==
                canonicalCallBodyOpRow
    rawbytes.BytesFree(recovered)
    return exactColumnOrder && valid && rejected && recoveredValid

fn cleanupAuthorityColumnPrevalidate(body: var ir.BodyIR): bool =
    var payload = codec.Backend2BodyIrEncode(body)
    # Canonical-empty field17 occupies tag(4) + fixed/column bytes(608),
    # followed by tag11 + the 32-byte TypeArena CID.
    let tagOffset = payload.len - 648
    let exactTail =
        tagOffset >= 0 &&
        codec.Backend2CodecReadU32(payload, tagOffset) == 17 &&
        codec.Backend2CodecReadU32(payload, tagOffset + 612) == 11 &&
        primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    rawbytes.BytesFree(payload)
    if !exactTail:
        return false

    # Intent has 47 columns, Schedule has 27, Replay has 3. Every canonical
    # empty count is attacked independently, so a reordered or omitted raw
    # column cannot reach the decoder.
    var columnCountOffsets: int32[]
    for column in 0..<47:
        add(columnCountOffsets, 192 + column * 4)
    for column in 0..<27:
        add(columnCountOffsets, 452 + column * 4)
    for column in 0..<3:
        add(columnCountOffsets, 600 + column * 4)
    if columnCountOffsets.len != 77:
        return false
    for countOffset in columnCountOffsets:
        if !rejectsWordMutation(body, tagOffset + countOffset, 1):
            return false

    # Schedule columns 18..23 are unitEffectStarts/unitEffectCounts followed
    # by semantic/domain/physical/role. They precede payload/placement and the
    # projected slot value column at 24..26.
    if columnCountOffsets[47 + 18] != 524 ||
       columnCountOffsets[47 + 19] != 528 ||
       columnCountOffsets[47 + 20] != 532 ||
       columnCountOffsets[47 + 21] != 536 ||
       columnCountOffsets[47 + 22] != 540 ||
       columnCountOffsets[47 + 23] != 544 ||
       columnCountOffsets[47 + 24] != 548 ||
       columnCountOffsets[47 + 25] != 552 ||
       columnCountOffsets[47 + 26] != 556 ||
       !rejectsWordMutation(body, tagOffset + 524, 2147483647) ||
       !rejectsWordInsertion(body, tagOffset + 524) ||
       !rejectsWordDeletion(body, tagOffset + 524):
        return false

    # Partial authority states and root shapes are invalid. No state/root
    # repair is deferred to Backend2BodyIrDecode.
    if !rejectsWordMutation(body, tagOffset, 16) ||
       !rejectsByteMutation(body, tagOffset + 4, 1) ||
       !rejectsWordMutation(body, tagOffset + 36, 1) ||
       !rejectsWordMutation(body, tagOffset + 40, 1) ||
       !rejectsByteMutation(body, tagOffset + 44, 1) ||
       !rejectsByteMutation(body, tagOffset + 76, 1) ||
       !rejectsByteMutation(body, tagOffset + 108, 1) ||
       !rejectsByteMutation(body, tagOffset + 140, 1) ||
       !rejectsWordMutation(body, tagOffset + 380, 1) ||
       !rejectsWordMutation(body, tagOffset + 384, 1) ||
       !rejectsByteMutation(body, tagOffset + 388, 1) ||
       !rejectsByteMutation(body, tagOffset + 420, 1) ||
       !rejectsWordMutation(body, tagOffset + 560, 1) ||
       !rejectsWordMutation(body, tagOffset + 564, 1) ||
       !rejectsByteMutation(body, tagOffset + 568, 1):
        return false

    return rejectsTruncationAt(body, tagOffset + 35) &&
           rejectsTruncationAt(body, tagOffset + 75) &&
           rejectsTruncationAt(body, tagOffset + 419) &&
           rejectsTruncationAt(body, tagOffset + 599) &&
           rejectsTruncationAt(body, tagOffset + 611) &&
           rejectsTruncationAt(body, tagOffset + 647)

fn main(): int32 =
    var body = ir.BodyIRNew()
    if !ir.BodyIRBindTypeArenaArtifactCid(
           body,
           prevalidateTypeArenaArtifactCid()):
        return 1
    var call: ir.CallOp
    ir.BodyIRApplyCallOpDefaultProof(call)
    call.targetSymbol = "f"
    call.targetSourcePath = "/x"
    call.resultOwnership = ir.OwnMove
    call.resultExprNodeIndex = 17
    call.semanticCallExprNodeIndex = 19
    call.managedStoreKind = ir.ManagedStoreStrMoveTag
    call.relocWordOffset = -1
    call.targetIsImportc = true
    call.wholeCallF64FromIntRescue = true
    call.inlineF64FromIntUnsigned = true
    let callFlagBase = 96 + len(call.targetSymbol) +
        len(call.targetSourcePath)
    add(body.callSequence, call)
    var cstringEntry: ir.CStringLiteralEntry
    cstringEntry.id = 0
    cstringEntry.text = "c"
    cstringEntry.dataLabel = "d"
    add(body.cstringLiterals, cstringEntry)
    ir.BodyIRBindCStringTarget(
        body, 0,
        prevalidateFixtureCid(
            "cheng.test.primary.cstring.owner_fragment"))
    ir.BodyIRSealDataRelocationIdentity(body)
    body.entryIsCAbi = true

    var payload = codec.Backend2BodyIrEncode(body)
    let encodedLen = payload.len
    let valid = primary.PrimaryLowerPoolBodyIrPayloadPrevalidate(payload)
    let callEncodedBytes = 4 + len(call.targetSymbol) +
        4 + len(call.targetSourcePath) + 4 + 4 + 4 + 80
    let cstringEncodedBytes = 4 + 4 + len(cstringEntry.text) +
        4 + len(cstringEntry.dataLabel)
    let dataIdentityTagOffset = 8 + 8 + 8 + callEncodedBytes +
        8 + 8 + 8 + 8 + cstringEncodedBytes
    let exactDataIdentityTag =
        codec.Backend2CodecReadU32(payload, dataIdentityTagOffset) == 18
    rawbytes.BytesFree(payload)
    if !valid || encodedLen <= 648:
        return 1

    # CallOp has eleven result/definition/store/reloc scalars before the importc
    # flag. The unique format starts directly with magic + fieldCount.
    # Latest-only BodyIR schema: fieldCount=18. The old fieldCount=17
    # must be rejected rather than entering a compatibility decoder.
    let cleanupAuthorityTagOffset = encodedLen - 648
    let ffiHandleTagOffset = cleanupAuthorityTagOffset - 280
    let manualConsumeTagOffset = ffiHandleTagOffset - 236
    if !exactDataIdentityTag ||
       !rejectsByteMutation(body, 4, 17) ||
       !rejectsByteMutation(body, 8, 6) ||
       !rejectsByteMutation(body, callFlagBase, 2) ||
       !rejectsByteMutation(body, callFlagBase + 8, 2) ||
       !rejectsByteMutation(body, callFlagBase + 12, 2) ||
       !rejectsByteMutation(body, callFlagBase + 57, 2) ||
       !rejectsWordMutation(body, dataIdentityTagOffset, 17) ||
       !rejectsWordMutation(body, dataIdentityTagOffset + 4, 0) ||
       !rejectsWordMutation(body, dataIdentityTagOffset + 24, 1) ||
       !rejectsZeroedRange(body, dataIdentityTagOffset + 32, 32) ||
       !rejectsByteMutation(body, manualConsumeTagOffset - 8, 6) ||
       !rejectsByteMutation(body, manualConsumeTagOffset - 4, 2) ||
       !rejectsByteMutation(body, manualConsumeTagOffset, 13) ||
       !rejectsByteMutation(body, manualConsumeTagOffset + 4, 2) ||
       !rejectsByteMutation(body, manualConsumeTagOffset + 8, 1) ||
       !rejectsByteMutation(body, manualConsumeTagOffset + 192, 1) ||
       !rejectsByteMutation(body, ffiHandleTagOffset, 15) ||
       !rejectsWordMutation(body, ffiHandleTagOffset + 4, 1) ||
       !rejectsWordMutation(body, ffiHandleTagOffset + 8, 0) ||
       !rejectsByteMutation(body, ffiHandleTagOffset + 12, 1) ||
       !rejectsWordMutation(body, ffiHandleTagOffset + 108, 1) ||
       !rejectsByteMutation(body, ffiHandleTagOffset + 248, 1) ||
       !rejectsByteMutation(body, cleanupAuthorityTagOffset, 16) ||
       !rejectsWordMutation(body, cleanupAuthorityTagOffset + 36, 1) ||
       !rejectsByteMutation(body, cleanupAuthorityTagOffset + 44, 1) ||
       !rejectsWordMutation(body, cleanupAuthorityTagOffset + 560, 1) ||
       !rejectsOldMagic(body) ||
       !rejectsOldHeader(body) ||
       !rejectsLengthDrift(body) ||
       !nonemptyManualConsumePrevalidate() ||
       !rejectsWrongFfiHandleCallBodyOpRow() ||
       !cleanupAuthorityColumnPrevalidate(body) ||
       !requiredDebugPrevalidate():
        return 2
    echo("primary_lower_pool_bodyir_prevalidate_smoke ok")
    return 0
